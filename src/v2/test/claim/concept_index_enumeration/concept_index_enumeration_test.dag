module v2.test.claim.concept_index_enumeration

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

type ConceptIndexWitnessRecord {
  alpha: String
  beta: Bool
}

type ConceptIndexWitnessRecordPerturb {
  alpha: String
  beta: Int
}

type ConceptIndexWitnessCoproduct =
  | NullaryArm
  | NamedFieldArm { alpha: String, beta: Bool }

data concept_index_enumeration_pool_note: String = "The pool root is this witness family's OWN directory, so the parse-only pool is exactly the file declaring the subjects it asserts on. That is what keeps the cost derived from what the witness proves rather than from unrelated corpus growth (operator ruling 2026-08-04): the former root src/v2/test/claim parsed all 638 files beneath it and grew with every module anyone added anywhere, which is what pushed witness_coproduct_arms_parse_only to 6065ms thread-CPU against the 5000ms fast-lane budget (PR #7756, CI run 31017039134) and rehomed it to test/claim/long/. The types below are declared once and read by BOTH mechanisms — concept_decl_facts_live reads the loaded module registry, concept_decl_facts parses this directory — so the live and parse-only witnesses share one declaration instead of forking it."

data concept_index_enumeration_pool_roots: List<String> = ["src/v2/test/claim/concept_index_enumeration"]

fn idx() -> List<v2.std.concept_index.QualifiedConcept> {
  enumerate_concepts()
}

fn parse_only_idx() -> List<v2.std.concept_index.QualifiedConcept> {
  enumerate_concepts_in(pool_roots: concept_index_enumeration_pool_roots)
}

fn idx_has_qn(target: String) -> Bool {
  fold(idx(), init: false, f: fn(acc, qc) { acc || (qc.qualified_name == target) })
}

fn parse_only_idx_has_qn(target: String) -> Bool {
  fold(parse_only_idx(), init: false, f: fn(acc, qc) { acc || (qc.qualified_name == target) })
}

fn fields_contains(fields: List<v2.std.concept_index.FieldRef>, fname: String, tname: String) -> Bool {
  fold(fields, init: false, f: fn(acc, fr) { acc || ((fr.field == fname) && (fr.type_name == tname)) })
}

fn concept_matches(
  target_qn: String,
  short_name: String,
  field_count: Int,
  check: fn(List<FieldRef>) -> Bool
) -> Bool {
  fold(idx(), init: false, f: fn(acc, qc) {
    if qc.qualified_name == target_qn {
      acc
        || ((qc.concept.name == short_name)
            && (qc.concept.fields.length() == field_count)
            && check(qc.concept.fields))
    } else {
      acc
    }
  })
}

fn parse_only_concept_matches(
  target_qn: String,
  short_name: String,
  field_count: Int,
  check: fn(List<FieldRef>) -> Bool
) -> Bool {
  fold(parse_only_idx(), init: false, f: fn(acc, qc) {
    if qc.qualified_name == target_qn {
      acc
        || ((qc.concept.name == short_name)
            && (qc.concept.fields.length() == field_count)
            && check(qc.concept.fields))
    } else {
      acc
    }
  })
}

test fn witness_enumeration_nonempty() -> Bool {
  idx().length() > 0
}

test fn witness_fieldref_self_projection() -> Bool {
  concept_matches(
    target_qn: "v2.std.concept_index.FieldRef",
    short_name: "FieldRef",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "field", tname: "String")
        && fields_contains(fields: fields, fname: "type_name", tname: "String")
    }
  )
}

test fn witness_qualified_concept_self_projection() -> Bool {
  concept_matches(
    target_qn: "v2.std.concept_index.QualifiedConcept",
    short_name: "QualifiedConcept",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "qualified_name", tname: "String")
        && fields_contains(fields: fields, fname: "concept", tname: "ConceptStruct")
    }
  )
}

test fn witness_local_record_enumerated() -> Bool {
  concept_matches(
    target_qn: "v2.test.claim.concept_index_enumeration.ConceptIndexWitnessRecord",
    short_name: "ConceptIndexWitnessRecord",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "alpha", tname: "String")
        && fields_contains(fields: fields, fname: "beta", tname: "Bool")
    }
  )
}

test fn witness_absent_concept_is_false() -> Bool {
  (idx_has_qn(target: "v2.std.concept_index.NoSuchConceptZZZ") == false)
    && (idx_has_qn(target: "std.concept_index.FieldRef") == false)
}

test fn witness_parse_only_extract_reflects_canonical_field_types() -> Bool {
  parse_only_concept_matches(
    target_qn: "v2.test.claim.concept_index_enumeration.ConceptIndexWitnessRecord",
    short_name: "ConceptIndexWitnessRecord",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "alpha", tname: "String")
        && fields_contains(fields: fields, fname: "beta", tname: "Bool")
    }
  )
}

test fn witness_parse_only_extract_reflects_perturbed_field_type() -> Bool {
  parse_only_concept_matches(
    target_qn: "v2.test.claim.concept_index_enumeration.ConceptIndexWitnessRecordPerturb",
    short_name: "ConceptIndexWitnessRecordPerturb",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "alpha", tname: "String")
        && fields_contains(fields: fields, fname: "beta", tname: "Int")
    }
  )
}

test fn witness_parse_only_extract_stale_field_type_red_on_canonical() -> Bool {
  !parse_only_concept_matches(
    target_qn: "v2.test.claim.concept_index_enumeration.ConceptIndexWitnessRecord",
    short_name: "ConceptIndexWitnessRecord",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "beta", tname: "Int")
    }
  )
}

test fn witness_parse_only_extract_nonempty_in_scoped_pool() -> Bool {
  parse_only_idx().length() > 0
    && parse_only_idx_has_qn(
      target: "v2.test.claim.concept_index_enumeration.ConceptIndexWitnessRecord"
    )
}

test fn witness_coproduct_arms_live() -> Bool {
  concept_matches(
    target_qn: "v2.test.claim.concept_index_enumeration.ConceptIndexWitnessCoproduct",
    short_name: "ConceptIndexWitnessCoproduct",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "NullaryArm", tname: "coproduct_nullary_payload")
        && fields_contains(
          fields: fields,
          fname: "NamedFieldArm",
          tname: "{ alpha: String, beta: Bool }"
        )
    }
  )
}

test fn witness_coproduct_arms_parse_only() -> Bool {
  parse_only_concept_matches(
    target_qn: "v2.test.claim.concept_index_enumeration.ConceptIndexWitnessCoproduct",
    short_name: "ConceptIndexWitnessCoproduct",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "NullaryArm", tname: "coproduct_nullary_payload")
        && fields_contains(
          fields: fields,
          fname: "NamedFieldArm",
          tname: "{ alpha: String, beta: Bool }"
        )
    }
  )
}
