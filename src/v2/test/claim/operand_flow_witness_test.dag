module v2.test.claim.operand_flow_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data operand_flow_shared_node: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^operand_flow_shared } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data operand_flow_consumer_a_node: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^operand_flow_consumer_a } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data operand_flow_consumer_b_node: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^operand_flow_consumer_b } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data operand_flow_shared_hash: std.content_hash.ContentHash = std.content_hash.Fnv1a64(v2.std.node.content_hash(n: operand_flow_shared_node))

data operand_flow_edge_a: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: operand_flow_shared_node,
  dependent: operand_flow_consumer_a_node,
  kind: v2.std.dependency.DataDependsOn,
  usage_site: operand_flow_consumer_a_node
}

data operand_flow_edge_b: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: operand_flow_shared_node,
  dependent: operand_flow_consumer_b_node,
  kind: v2.std.dependency.DataDependsOn,
  usage_site: operand_flow_consumer_b_node
}

data operand_flow_edge_non_data: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: operand_flow_shared_node,
  dependent: operand_flow_consumer_a_node,
  kind: v2.std.dependency.BarrierBefore,
  usage_site: operand_flow_consumer_a_node
}

data operand_flow_settled_artifact: v2.workflow.realization_runner.NodeKeyedGraphArtifact = v2.workflow.realization_runner.NodeKeyedGraphArtifact {
  rows: [
    v2.workflow.realization_runner.NodeKeyedGraphRow {
      content_hash: operand_flow_shared_hash,
      encoded_length: std.measure.byte_size(count: 9),
      child_refs: []
    }
  ],
  entries: []
}

data operand_flow_missing_row_artifact: v2.workflow.realization_runner.NodeKeyedGraphArtifact = v2.workflow.realization_runner.NodeKeyedGraphArtifact {
  rows: [],
  entries: []
}

test fn witness_operand_root_resolves_data_depends_on() -> Bool {
  match v2.workflow.operand_flow.operand_root(edge: operand_flow_edge_a) {
    v2.workflow.operand_flow.OperandRoot { root: root } => root == operand_flow_shared_node
    v2.workflow.operand_flow.OperandRootUnresolved { edge: _ } => false
  }
}

test fn witness_operand_root_refuses_non_data_kind() -> Bool {
  match v2.workflow.operand_flow.operand_root(edge: operand_flow_edge_non_data) {
    v2.workflow.operand_flow.OperandRootUnresolved { edge: edge } => edge == operand_flow_edge_non_data
    v2.workflow.operand_flow.OperandRoot { root: _ } => false
  }
}

test fn witness_shared_operand_consumers_agree() -> Bool {
  match v2.workflow.operand_flow.operand_flow_for_edge(artifact: operand_flow_settled_artifact, edge: operand_flow_edge_a) {
    v2.workflow.operand_flow.OperandFlow { edge: _, operand: operand_a, footprint: footprint_a } =>
      match v2.workflow.operand_flow.operand_flow_for_edge(artifact: operand_flow_settled_artifact, edge: operand_flow_edge_b) {
        v2.workflow.operand_flow.OperandFlow { edge: _, operand: operand_b, footprint: footprint_b } =>
          (operand_a == operand_b)
            && (operand_a == operand_flow_shared_hash)
            && (std.measure.byte_size_count(b: footprint_a) == std.measure.byte_size_count(b: footprint_b))
        v2.workflow.operand_flow.OperandFlowRefused { edge: _, cause: _ } => false
      }
    v2.workflow.operand_flow.OperandFlowRefused { edge: _, cause: _ } => false
  }
}

test fn witness_non_data_edge_refuses_typed() -> Bool {
  match v2.workflow.operand_flow.operand_flow_for_edge(artifact: operand_flow_settled_artifact, edge: operand_flow_edge_non_data) {
    v2.workflow.operand_flow.OperandFlowRefused { edge: _, cause: v2.workflow.operand_flow.OperandFlowNoOperand { edge: _ } } => true
    v2.workflow.operand_flow.OperandFlowRefused { edge: _, cause: _ } => false
    v2.workflow.operand_flow.OperandFlow { edge: _, operand: _, footprint: _ } => false
  }
}

test fn witness_missing_row_refuses_typed() -> Bool {
  match v2.workflow.operand_flow.operand_flow_for_edge(artifact: operand_flow_missing_row_artifact, edge: operand_flow_edge_a) {
    v2.workflow.operand_flow.OperandFlowRefused { edge: _, cause: v2.workflow.operand_flow.OperandFlowFootprintMissingRow { missing: missing } } =>
      missing == operand_flow_shared_hash
    v2.workflow.operand_flow.OperandFlowRefused { edge: _, cause: _ } => false
    v2.workflow.operand_flow.OperandFlow { edge: _, operand: _, footprint: _ } => false
  }
}

test fn witness_operand_flows_is_total_over_edges() -> Bool {
  let rows = v2.workflow.operand_flow.operand_flows(
    artifact: operand_flow_settled_artifact,
    edges: [operand_flow_edge_a, operand_flow_edge_b, operand_flow_edge_non_data]
  )
  v2.std.algebra.length(xs: rows) == 3
}

