module v2.test.claim.operand_flow_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data operand_flow_shared_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^operand_flow_shared } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data operand_flow_consumer_a_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^operand_flow_consumer_a } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data operand_flow_consumer_b_node: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^operand_flow_consumer_b } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data operand_flow_shared_hash: std.content_hash.ContentHash = content_hash(n: operand_flow_shared_node)

data operand_flow_edge_a: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: operand_flow_shared_node,
  dependent: operand_flow_consumer_a_node,
  kind: DataDependsOn,
  usage_site: operand_flow_consumer_a_node
}

data operand_flow_edge_b: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: operand_flow_shared_node,
  dependent: operand_flow_consumer_b_node,
  kind: DataDependsOn,
  usage_site: operand_flow_consumer_b_node
}

data operand_flow_edge_non_data: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: operand_flow_shared_node,
  dependent: operand_flow_consumer_a_node,
  kind: BarrierBefore,
  usage_site: operand_flow_consumer_a_node
}

data operand_flow_settled_artifact: v2.workflow.realization_runner.NodeKeyedGraphArtifact = v2.workflow.realization_runner.NodeKeyedGraphArtifact {
  rows: [
    v2.workflow.realization_runner.NodeKeyedGraphRow {
      content_hash: operand_flow_shared_hash,
      encoded_length: byte_size(count: 9),
      child_refs: []
    }
  ],
  entries: []
}

data operand_flow_missing_row_artifact: v2.workflow.realization_runner.NodeKeyedGraphArtifact = v2.workflow.realization_runner.NodeKeyedGraphArtifact {
  rows: [],
  entries: []
}

test fn witness_operand_root_resolves_data_depends_on() -> Bool {
  match operand_root(edge: operand_flow_edge_a) {
    OperandRoot { root: root } => root == operand_flow_shared_node
    OperandRootUnresolved { edge: _ } => false
  }
}

test fn witness_operand_root_refuses_non_data_kind() -> Bool {
  match operand_root(edge: operand_flow_edge_non_data) {
    OperandRootUnresolved { edge: edge } => edge == operand_flow_edge_non_data
    OperandRoot { root: _ } => false
  }
}

test fn witness_shared_operand_consumers_agree() -> Bool {
  match operand_flow_for_edge(artifact: operand_flow_settled_artifact, edge: operand_flow_edge_a) {
    OperandFlow { edge: _, operand: operand_a, footprint: footprint_a } =>
      match operand_flow_for_edge(artifact: operand_flow_settled_artifact, edge: operand_flow_edge_b) {
        OperandFlow { edge: _, operand: operand_b, footprint: footprint_b } =>
          (operand_a == operand_b)
            && (operand_a == operand_flow_shared_hash)
            && (byte_size_count(b: footprint_a) == byte_size_count(b: footprint_b))
        OperandFlowRefused { edge: _, cause: _ } => false
      }
    OperandFlowRefused { edge: _, cause: _ } => false
  }
}

test fn witness_non_data_edge_refuses_typed() -> Bool {
  match operand_flow_for_edge(artifact: operand_flow_settled_artifact, edge: operand_flow_edge_non_data) {
    OperandFlowRefused { edge: _, cause: OperandFlowNoOperand { edge: _ } } => true
    OperandFlowRefused { edge: _, cause: _ } => false
    OperandFlow { edge: _, operand: _, footprint: _ } => false
  }
}

test fn witness_missing_row_refuses_typed() -> Bool {
  match operand_flow_for_edge(artifact: operand_flow_missing_row_artifact, edge: operand_flow_edge_a) {
    OperandFlowRefused { edge: _, cause: OperandFlowFootprintMissingRow { missing: missing } } =>
      missing == operand_flow_shared_hash
    OperandFlowRefused { edge: _, cause: _ } => false
    OperandFlow { edge: _, operand: _, footprint: _ } => false
  }
}

test fn witness_operand_flows_is_total_over_edges() -> Bool {
  let rows = operand_flows(
    artifact: operand_flow_settled_artifact,
    edges: [operand_flow_edge_a, operand_flow_edge_b, operand_flow_edge_non_data]
  )
  length(xs: rows) == 3
}

