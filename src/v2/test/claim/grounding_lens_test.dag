module v2.test.claim.grounding_lens


import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.text { String }
import v2.std.concept_index {
  ConceptDecl,
  ConceptStruct,
  FieldRef,
  QualifiedConcept
}
import v2.lens.grounding {
  GroundingWorklistEntry,
  candidates_over_decls,
  name_coincides
}



fn witness_coincide_caseinsensitive() -> Bool {
  name_coincides(field: "URL", concept_name: "url")
}

fn witness_coincide_headnoun() -> Bool {
  name_coincides(field: "base_url", concept_name: "Url")
}

fn witness_coincide_whole() -> Bool {
  name_coincides(field: "content_hash", concept_name: "ContentHash")
}

fn witness_coincide_negative() -> Bool {
  !name_coincides(field: "note", concept_name: "Url")
}

fn type_atom(sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn field_edge(field: Symbol, type_sym: Symbol) -> Edge {
  Edge {
    label: Named { name: field },
    target: type_atom(sym: type_sym)
  }
}

fn record_type(fields: List<Edge>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fields,
    occurrence_id: SyntheticOccurrence
  }
}

fn concept_decl(qn: String, nm: String, node: Node) -> ConceptDecl {
  ConceptDecl { qualified_name: qn, name: nm, node: node }
}

fn fixture_decls() -> List<ConceptDecl> {
  [
    concept_decl(
      qn: "demo.Url",
      nm: "Url",
      node: record_type(fields: [
        field_edge(field: ^scheme, type_sym: ^UriScheme),
        field_edge(field: ^host, type_sym: ^NonEmptyStr)
      ])
    ),
    concept_decl(
      qn: "demo.Id",
      nm: "Id",
      node: record_type(fields: [field_edge(field: ^raw, type_sym: ^String)])
    ),
    concept_decl(
      qn: "demo.Endpoint",
      nm: "Endpoint",
      node: record_type(fields: [
        field_edge(field: ^base_url, type_sym: ^String),
        field_edge(field: ^timeout, type_sym: ^Int)
      ])
    ),
    concept_decl(
      qn: "demo.Widget",
      nm: "Widget",
      node: record_type(fields: [field_edge(field: ^id, type_sym: ^String)])
    ),
    concept_decl(
      qn: "demo.Note",
      nm: "Note",
      node: record_type(fields: [field_edge(field: ^body, type_sym: ^String)])
    ),
    concept_decl(
      qn: "v2.std.FieldRef",
      nm: "FieldRef",
      node: record_type(fields: [field_edge(field: ^field, type_sym: ^String)])
    ),
    concept_decl(
      qn: "v2.std.Field",
      nm: "Field",
      node: record_type(fields: [field_edge(field: ^name, type_sym: ^String)])
    )
  ]
}

fn has_candidate(cands: List<GroundingWorklistEntry>, enclosing: String, field: String) -> Bool {
  fold(cands, init: false, f: fn(acc, c) {
    acc || ((c.enclosing == enclosing) && (c.field == field))
  })
}

fn candidate_structure(cands: List<GroundingWorklistEntry>, enclosing: String, field: String) -> String {
  fold(cands, init: "", f: fn(acc, c) {
    if (c.enclosing == enclosing) && (c.field == field) { c.target_structure } else { acc }
  })
}

fn candidate_coincides_with(cands: List<GroundingWorklistEntry>, enclosing: String, field: String) -> String {
  fold(cands, init: "", f: fn(acc, c) {
    if (c.enclosing == enclosing) && (c.field == field) { c.coincides_with } else { acc }
  })
}

fn witness_decide_flags_nickname() -> Bool {
  has_candidate(cands: candidates_over_decls(decls: fixture_decls()), enclosing: "Endpoint", field: "base_url")
}

fn witness_decide_clears_nonbare() -> Bool {
  !has_candidate(cands: candidates_over_decls(decls: fixture_decls()), enclosing: "Endpoint", field: "timeout")
}

fn witness_decide_clears_clean_RED() -> Bool {
  !has_candidate(cands: candidates_over_decls(decls: fixture_decls()), enclosing: "Note", field: "body")
}

fn witness_role_word_flows_to_judge() -> Bool {
  has_candidate(cands: candidates_over_decls(decls: fixture_decls()), enclosing: "Widget", field: "id")
}

fn witness_meta_field_coincidence_flows_to_judge() -> Bool {
  has_candidate(cands: candidates_over_decls(decls: fixture_decls()), enclosing: "FieldRef", field: "field")
}

fn witness_enrich_target_structure() -> Bool {
  let s = candidate_structure(
    cands: candidates_over_decls(decls: fixture_decls()),
    enclosing: "Endpoint",
    field: "base_url"
  )
  s == "scheme: UriScheme, host: NonEmptyStr"
}

fn witness_coincides_with_qualified_name() -> Bool {
  candidate_coincides_with(
    cands: candidates_over_decls(decls: fixture_decls()),
    enclosing: "Endpoint",
    field: "base_url"
  ) == "demo.Url"
}

test fn grounding_lens_fixture_witnesses() -> Bool {
  witness_coincide_caseinsensitive()
    && witness_coincide_headnoun()
    && witness_coincide_whole()
    && witness_coincide_negative()
    && witness_decide_flags_nickname()
    && witness_decide_clears_nonbare()
    && witness_decide_clears_clean_RED()
    && witness_role_word_flows_to_judge()
    && witness_meta_field_coincidence_flows_to_judge()
    && witness_enrich_target_structure()
    && witness_coincides_with_qualified_name()
}
