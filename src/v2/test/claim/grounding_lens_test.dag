module v2.test.claim.grounding_lens


import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.concept_index {
  ConceptStruct,
  FieldRef,
  QualifiedConcept
}
import v2.lens.grounding {
  GroundingWorklistEntry,
  candidates_over_index,
  compute_layer_excluded,
  is_layer_inversion,
  is_meta_self_coincidence,
  name_coincides
}



fn witness_coincide_caseinsensitive() -> Bool {
  name_coincides(field: "URL", concept_name: "url")
}

fn witness_coincide_headnoun() -> Bool {
  name_coincides(field: "base_url", concept_name: "Url")
}

fn witness_coincide_whole() -> Bool {
  name_coincides(field: "content_hash", concept_name: "ContentHash")
}

fn witness_coincide_negative() -> Bool {
  !name_coincides(field: "note", concept_name: "Url")
}



fn fr(f: String, t: String) -> FieldRef {
  FieldRef { field: f, type_name: t }
}

fn qc(qn: String, nm: String, fs: List<FieldRef>) -> QualifiedConcept {
  QualifiedConcept { qualified_name: qn, concept: ConceptStruct { name: nm, fields: fs } }
}

fn fixture_idx() -> List<QualifiedConcept> {
  [
    qc(qn: "demo.Url", nm: "Url", fs: [fr(f: "scheme", t: "UriScheme"), fr(f: "host", t: "NonEmptyStr")]),
    qc(qn: "demo.Id", nm: "Id", fs: [fr(f: "raw", t: "String")]),
    qc(qn: "demo.Endpoint", nm: "Endpoint", fs: [fr(f: "base_url", t: "String"), fr(f: "timeout", t: "Int")]),
    qc(qn: "demo.Widget", nm: "Widget", fs: [fr(f: "id", t: "String")]),
    qc(qn: "demo.Note", nm: "Note", fs: [fr(f: "body", t: "String")]),
    qc(qn: "v2.std.FieldRef", nm: "FieldRef", fs: [fr(f: "field", t: "String")]),
    qc(qn: "v2.std.Field", nm: "Field", fs: [fr(f: "name", t: "String")])
  ]
}

fn layer_inversion_fixture() -> List<QualifiedConcept> {
  [
    qc(qn: "v2.std.Foo", nm: "Foo", fs: [fr(f: "url", t: "String")]),
    qc(
      qn: "extdeps.http.Url",
      nm: "Url",
      fs: [fr(f: "scheme", t: "UriScheme"), fr(f: "host", t: "NonEmptyStr")]
    )
  ]
}

fn has_candidate(cands: List<GroundingWorklistEntry>, enclosing: String, field: String) -> Bool {
  fold(cands, init: false, f: fn(acc, c) {
    acc || ((c.enclosing == enclosing) && (c.field == field))
  })
}

fn candidate_structure(cands: List<GroundingWorklistEntry>, enclosing: String, field: String) -> String {
  fold(cands, init: "", f: fn(acc, c) {
    if (c.enclosing == enclosing) && (c.field == field) { c.target_structure } else { acc }
  })
}

fn candidate_coincides_with(cands: List<GroundingWorklistEntry>, enclosing: String, field: String) -> String {
  fold(cands, init: "", f: fn(acc, c) {
    if (c.enclosing == enclosing) && (c.field == field) { c.coincides_with } else { acc }
  })
}

fn witness_decide_flags_nickname() -> Bool {
  has_candidate(cands: candidates_over_index(idx: fixture_idx()), enclosing: "Endpoint", field: "base_url")
}

fn witness_decide_clears_nonbare() -> Bool {
  !has_candidate(cands: candidates_over_index(idx: fixture_idx()), enclosing: "Endpoint", field: "timeout")
}

fn witness_decide_clears_clean_RED() -> Bool {
  !has_candidate(cands: candidates_over_index(idx: fixture_idx()), enclosing: "Note", field: "body")
}

fn witness_role_word_flows_to_judge() -> Bool {
  has_candidate(cands: candidates_over_index(idx: fixture_idx()), enclosing: "Widget", field: "id")
}

fn witness_meta_self_coincidence_excluded() -> Bool {
  compute_layer_excluded(
    field: "field",
    enclosing_qn: "v2.std.FieldRef",
    matched: qc(qn: "v2.std.Field", nm: "Field", fs: [])
  )
}

fn witness_layer_excludes_meta_field() -> Bool {
  !has_candidate(cands: candidates_over_index(idx: fixture_idx()), enclosing: "FieldRef", field: "field")
}

fn witness_layer_excludes_inversion() -> Bool {
  !has_candidate(cands: candidates_over_index(idx: layer_inversion_fixture()), enclosing: "Foo", field: "url")
}

fn witness_layer_inversion_predicate() -> Bool {
  is_layer_inversion(enclosing_qn: "v2.std.Foo", matched_qn: "extdeps.http.Url")
}

fn witness_enrich_target_structure() -> Bool {
  let s = candidate_structure(
    cands: candidates_over_index(idx: fixture_idx()),
    enclosing: "Endpoint",
    field: "base_url"
  )
  s == "scheme: UriScheme, host: NonEmptyStr"
}

fn witness_coincides_with_qualified_name() -> Bool {
  candidate_coincides_with(
    cands: candidates_over_index(idx: fixture_idx()),
    enclosing: "Endpoint",
    field: "base_url"
  ) == "demo.Url"
}

test fn grounding_lens_fixture_witnesses() -> Bool {
  witness_coincide_caseinsensitive()
    && witness_coincide_headnoun()
    && witness_coincide_whole()
    && witness_coincide_negative()
    && witness_decide_flags_nickname()
    && witness_decide_clears_nonbare()
    && witness_decide_clears_clean_RED()
    && witness_role_word_flows_to_judge()
    && witness_meta_self_coincidence_excluded()
    && witness_layer_excludes_meta_field()
    && witness_layer_excludes_inversion()
    && witness_layer_inversion_predicate()
    && witness_enrich_target_structure()
    && witness_coincides_with_qualified_name()
}
