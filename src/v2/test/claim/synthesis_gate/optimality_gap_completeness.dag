module v2.test.synthesis_gate.optimality_gap_completeness

import v2.lens.synthesis {
  DecisionTree,
  InformationTheoretic,
  synthesis_lens,
  synthesis_lens_diagnostics
}
import v2.std.algebra { Empty, fold_list, is_empty, list_append, non_empty }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.report { Report }
import v2.test.lens_synthesis.synthesis_gap_polynomial {
  synthesis_gap_poly_input
}
import v2.test.synthesis_gate.subject_technique_roster {
  SynthesisSubjectRow,
  synthesis_subject_row_add,
  synthesis_subject_rows
}
import v2.test.synthesis_gate.synthesis_subject_body_supply {
  synthesis_arrow_body_for_row
}

fn synthesis_row_acquired(row: SynthesisSubjectRow) -> Bool {
  match synthesis_arrow_body_for_row(row: row) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn synthesis_real_rows_all_acquired() -> Bool {
  fold_list(
    xs: synthesis_subject_rows,
    empty: true,
    cons: fn(acc, row) {
      acc && synthesis_row_acquired(row: row)
    }
  )
}

fn synthesis_row_reports(row: SynthesisSubjectRow) -> List<Report> {
  match synthesis_arrow_body_for_row(row: row) {
    Accepted { value: body, diagnostics: _ } =>
      synthesis_lens(n: body, declared_technique: row.declared_technique)
    Rejected { diagnostics: _ } => Empty
  }
}

fn synthesis_corpus_reports() -> List<Report> {
  fold_list(
    xs: synthesis_subject_rows,
    empty: Empty,
    cons: fn(acc, row) {
      list_append(left: acc, right: synthesis_row_reports(row: row))
    }
  )
}

fn synthesis_real_corpus_optimal() -> Bool {
  synthesis_real_rows_all_acquired() && is_empty(xs: synthesis_corpus_reports())
}

fn synthesis_real_information_theoretic_no_technique() -> Bool {
  match synthesis_arrow_body_for_row(row: synthesis_subject_row_add) {
    Accepted { value: body, diagnostics: _ } =>
      non_empty(synthesis_lens_diagnostics(n: body, declared_technique: InformationTheoretic))
    Rejected { diagnostics: _ } => false
  }
}

fn synthesis_synthetic_gap_fires() -> Bool {
  non_empty(synthesis_lens(n: synthesis_gap_poly_input, declared_technique: DecisionTree))
}

fn synthesis_optimality_family_gate() -> Bool {
  if is_empty(xs: synthesis_subject_rows) {
    false
  } else {
    synthesis_real_corpus_optimal()
      && synthesis_real_information_theoretic_no_technique()
      && synthesis_synthetic_gap_fires()
  }
}
