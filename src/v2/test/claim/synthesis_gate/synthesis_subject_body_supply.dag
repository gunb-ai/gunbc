module v2.test.synthesis_gate.synthesis_subject_body_supply

import v2.std.diagnostic { Outcome, bind_outcome }
import v2.std.node { Node }
import v2.std.node_query { find_arrow_body_child }
import v2.test.synthesis_gate.subject_technique_roster {
  SynthesisSubjectRow
}

fn synthesis_arrow_body_for_row(row: SynthesisSubjectRow) -> Outcome<Node> {
  bind_outcome(
    o: row.subject_producer(),
    f: fn(arrow) {
      find_arrow_body_child(root: arrow)
    }
  )
}
