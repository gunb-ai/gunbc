test fn body_lowering_descent_evidence_strict_holds() -> Bool {
  body_lower_descent_evidence() == Strict
}

test fn body_lowering_descent_termination_proof_holds() -> Bool {
  body_lower_descent_termination_proof() == structural_node_size_termination_proof()
}

test fn body_lowering_descent_budget_refusal_holds() -> Bool {
  witness_descent_budget_exhaustion_refuses()
    && witness_descent_budget_positive_not_exhausted()
    && witness_descent_fn_decl_optional_chain_refuses()
    && witness_descent_domain_param_list_refuses()
    && witness_descent_return_type_fn_captured_refuses()
    && witness_descent_collect_param_edges_refuses()
    && witness_descent_try_infix_transform_refuses()
    && witness_descent_operand_ref_optional_refuses()
    && witness_descent_match_capture_heads_spine_refuses()
    && witness_descent_extract_comma_list_arm_head_refuses()
}
