module v2.test.claim.falsifier_lane_plan_agreement_test


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data falsifier_lane_plan_agreement_note: String = "The live half of the lane-attribution wall: these rows run against the REAL falsifier plan, not a fixture, so they red if the schedule and the component attribution ever stop being projections of one enrollment list. That is a weaker claim than it looks and deliberately so — since gunbc_falsifier_ordinary_batches and gunbc_falsifier_planned_components both fold gunbc_falsifier_lane_batches, agreement is true BY CONSTRUCTION and these rows cannot fail while that shape holds. They are the regression control for the shape itself (DESIGN section 4b, meta-obligation 4: the discriminating control stays enrolled after the climb so the higher rung stays real). Reintroducing a second hand-authored lane table, or appending a batch outside the roster, breaks them immediately — which is the only failure mode the construction leaves open. Fixture-grain algebra for the join and the routing arms lives in dag/test/claim/falsifier_lane_witness_test.dag; this file exists separately because it reaches the plan module and the two grains cannot share one live-tree stamp."

test fn falsifier_schedule_and_attribution_agree_on_the_live_plan() -> Bool {
  length(xs: gunbc_falsifier_ordinary_batches()) == length(xs: gunbc_falsifier_planned_components())
}

test fn falsifier_planned_components_are_dense_one_based() -> Bool {
  let indices = falsifier_planned_indices(planned: gunbc_falsifier_planned_components())
  fold_list(
    xs: indices,
    empty: true,
    cons: fn(acc, i) { acc && (i >= 1) && (i <= length(xs: indices)) }
  ) && (length(xs: indices) == length(xs: gunbc_falsifier_planned_components()))
}

data falsifier_enrolled_subset_note: String = "Every planned component corresponds to an ENROLLED row, in roster order. This is what makes the index a sound join key against a receipt: the executor numbers the batches it actually ran, so an unenrolled lane must consume no index rather than leaving a hole. witness_planned_components_skip_unenrolled_and_renumber proves the renumbering on a fixture where a middle lane is disabled; this row proves the same property holds of the live roster whatever its current enrollment happens to be."

test fn falsifier_planned_components_track_enrolled_rows_in_order() -> Bool {
  let enrolled_lanes = list_map(
    xs: filter(xs: gunbc_falsifier_lane_batches(), predicate: fn(row) { row.enrolled }),
    f: fn(row) { row.lane }
  )
  let planned_lanes = list_map(
    xs: gunbc_falsifier_planned_components(),
    f: fn(c) { c.lane }
  )
  (length(xs: enrolled_lanes) == length(xs: planned_lanes))
    && fold_list(
         xs: gunbc_falsifier_planned_components(),
         empty: true,
         cons: fn(acc, c) {
           acc && match list_at_optional(xs: enrolled_lanes, index: c.index - 1) {
             Present { value: l } => falsifier_lane_eq(left: l, right: c.lane)
             Absent => false
           }
         }
       )
}
