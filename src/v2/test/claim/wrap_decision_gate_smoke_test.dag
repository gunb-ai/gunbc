module v2.test.claim.wrap_decision_gate_smoke


test fn wrap_decision_gate_smoke_bundle_absent_inapplicable() -> Bool {
  let target = v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    },
    lex: VoidLexRules,
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: std.algebra.Empty,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
  match wrap_decision_gate(
    target: target,
    source_carrier: target_carrier_diagnostics_node(),
    use_site: OwnershipAtFunctionReturn
  ) {
    Accepted { value: WrapGateInapplicable, diagnostics: _ } => true
    _ => false
  }
}
