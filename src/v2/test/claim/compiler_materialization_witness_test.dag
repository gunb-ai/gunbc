module v2.test.claim.compiler_materialization_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data compiler_materialization_witness_note: String = "Green-by-execution receipt that v2 ParseTable and cached_stage memoization flows through the governed carrier door (std.realization.Memoize verdict consumed; non-std.realization.Memoize refuses store). Ladder + catalog projection witnesses unchanged. RED: plural RefusedScopeTooNarrow / RefusedNoProvider; governed-store refusal when Recompute; bypass insert on non-std.realization.Memoize carrier. reconcile-as-lookup-path is the next increment."

test fn compiler_materialization_ladder_holds() -> Bool {
  v2_compiler_materialization_ladder_holds()
}

test fn parse_table_memo_provider_preserves_catalog_retention() -> Bool {
  parse_table_memo_retention_preserved()
    && (parse_table_memo_provider_id() == extdeps.realization.parse_table_memo.parse_table_memo_id)
}

test fn compile_stage_memo_provider_preserves_catalog_retention() -> Bool {
  compile_stage_memo_retention_preserved()
    && (compile_stage_memo_provider_id() == extdeps.realization.compile_stage_memo.compile_stage_memo_id)
}

test fn parse_table_carrier_inhabits_realization() -> Bool {
  let step = parse_table_realized_step()
  (step.materialization == std.realization.Memoize)
    && (step.placement == std.realization.LocalInProcess)
    && (parse_table_memo_materialization() == std.realization.Memoize)
}

test fn compile_stage_carrier_inhabits_realization() -> Bool {
  let step = compile_stage_realized_step()
  (step.materialization == std.realization.Memoize)
    && (step.placement == std.realization.LocalInProcess)
    && (compile_stage_memo_materialization() == std.realization.Memoize)
    && (cached_stage_realization().provider_id == extdeps.realization.compile_stage_memo.compile_stage_memo_id)
}

test fn parse_table_empty_uses_catalog_identity() -> Bool {
  parse_table_carrier_grounded_on_catalog()
}

test fn single_site_demands_are_accepted_single_recompute() -> Bool {
  parse_table_memo_verdict_is_single_recompute()
    && compile_stage_memo_verdict_is_single_recompute()
}

test fn parse_table_memo_plural_reds_without_provider() -> Bool {
  !parse_table_memo_plural_holds_with_provider()
    && (parse_table_memo_plural_scope_too_narrow_count() == 1)
    && !parse_table_memo_plural_holds_without_provider()
    && (parse_table_memo_plural_refused_without_provider_count() == 1)
}
