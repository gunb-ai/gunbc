module v2.test.claim.compiler_materialization_witness

import v2.std.live_tree { LiveTreeDisposition }
import std.realization { LocalInProcess, Recompute }
import v2.std.diagnostic { Accepted, Rejected }
import v2.compiler.materialization_carriers {
  cached_stage_realization,
  compile_stage_memo_plural_holds_without_provider,
  compile_stage_memo_plural_holds_with_provider,
  compile_stage_memo_plural_refused_without_provider_count,
  compile_stage_memo_plural_scope_too_narrow_count,
  compile_stage_memo_provider_id,
  compile_stage_memo_retention_preserved,
  compile_stage_memo_verdict_is_single_recompute,
  compile_stage_realized_step,
  discharged_scope_admits_store,
  refused_scope_is_not_admitted,
  unruled_identity_is_not_admitted,
  v2_compiler_materialization_ladder_holds
}
import extdeps.realization.compile_stage_memo { compile_stage_memo_id }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Green-by-execution receipt that v2 cached_stage memoization flows through the governed carrier
// door, that the materialization the door consumes is the one the ladder ADMITTED for that
// demand's identity rather than a literal standing beside it, and that an admission the ladder did
// not green is REFUSED rather than re-encoded as an operational materialization. RED: plural
// RefusedScopeTooNarrow / RefusedNoProvider; an identity with no verdict being admitted; a refused
// verdict admitted as permission. (The parse-table demand and its claims were deleted with the
// parse memo carrier, operator ruling R2, 2026-10-08.) reconcile-as-lookup-path is the next
// increment.

test fn compiler_materialization_ladder_holds() -> Bool {
  v2_compiler_materialization_ladder_holds()
}

test fn compile_stage_memo_provider_preserves_catalog_retention() -> Bool {
  compile_stage_memo_retention_preserved()
    && (compile_stage_memo_provider_id() == compile_stage_memo_id)
}

// Recompute, not Memoize, and the change is a correction rather than a regression: the
// compile-stage lookup is resolve_cache_miss, which returns Miss unconditionally, so the
// governed door has been taking the recompute path on every compile regardless of what the
// literal said. The literal was the only thing claiming otherwise.
test fn compile_stage_carrier_inhabits_realization() -> Bool {
  match compile_stage_realized_step() {
    Rejected { diagnostics: _ } => false
    Accepted { value: step, diagnostics: _ } =>
      match cached_stage_realization() {
        Rejected { diagnostics: _ } => false
        Accepted { value: realization, diagnostics: _ } =>
          (step.materialization == Recompute)
            && (step.placement == LocalInProcess)
            && (realization.materialization == Recompute)
            && (realization.provider_id == compile_stage_memo_id)
      }
  }
}

test fn compile_stage_demand_is_accepted_single_recompute() -> Bool {
  compile_stage_memo_verdict_is_single_recompute()
}

// The fail-closed arm, by execution: an identity carrying no verdict yields no admitted
// decision, and the door REFUSES rather than handing back an operational materialization.
test fn an_unruled_identity_is_not_admitted() -> Bool {
  unruled_identity_is_not_admitted()
}

// Review 69770's finding, as a discriminating pair. A REFUSED identity must not permit the
// store: ladder_verdict_prescribes answers Memoize for five of the six Refused arms, so a door
// that read the bare prescription would take an unmet obligation as permission. The negative
// is RefusedScopeTooNarrow against the very provider that admits the single-process demand, and
// the positive is that same provider admitting a store for that same identity when it recurs
// inside the provider's scope -- so the negative cannot pass by the admission having been broken
// for everything.
// STRENGTHENED past "refuses the store": the previous form asked only whether the store was
// permitted, which a refusal and an admitted Recompute both answer false, so it could not tell
// a preserved refusal from one re-encoded as recomputation -- and that was the defect.
test fn a_refused_identity_is_not_admitted() -> Bool {
  refused_scope_is_not_admitted()
    && discharged_scope_admits_store()
}

test fn compile_stage_memo_plural_reds_without_provider() -> Bool {
  !compile_stage_memo_plural_holds_with_provider()
    && (compile_stage_memo_plural_scope_too_narrow_count() == 1)
    && !compile_stage_memo_plural_holds_without_provider()
    && (compile_stage_memo_plural_refused_without_provider_count() == 1)
}
