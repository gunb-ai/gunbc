module v2.test.claim.cross_tree_real_ingest_activation

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.program_assembly {
  ProgramAssemblyFoldFailed,
  ProgramAssemblyFoldOk,
  program_assembly_fold_ingest
}
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootIngest,
  source_root_set_from_ingest
}
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.algebra { Cons, Empty }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DslTree, V2Tree }
import v2.std.cross_tree.resolution {
  CrossTreeEdgeDecision,
  EdgeCrossAdmitted,
  EdgeCrossAmbiguous,
  EdgeCrossDenied,
  EdgeNormalResolution,
  cross_tree_edge_decision
}
import v2.std.logic { Bool }
import v2.std.qualified_name { QnCons, QnEmpty, QualifiedName }

data ct_real_v2_subject_source: Medium<String> = Medium {
  carried: "module v2.ct_real_subject\n",
  fidelity: Lossless
}

data ct_real_dsl_target_source: Medium<String> = Medium {
  carried: "module ct_real_target\n",
  fidelity: Lossless
}

data ct_real_v2_subject_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^ct_real_v2_subject_artifact,
  file_path: "src/v2/ct_real_subject.dag"
}

data ct_real_dsl_target_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^ct_real_dsl_target_artifact,
  file_path: "dsl/ct_real_target.dag"
}

data ct_real_v2_to_dsl_subject_read: DagSourceReadWitness = DagSourceReadWitness {
  source: ct_real_v2_subject_source,
  artifact: ct_real_v2_subject_artifact,
  compilation_unit: ^ct_real_subject_cu,
  source_root: V2Tree
}

data ct_real_v2_to_dsl_target_read: DagSourceReadWitness = DagSourceReadWitness {
  source: ct_real_dsl_target_source,
  artifact: ct_real_dsl_target_artifact,
  compilation_unit: ^ct_real_target_cu,
  source_root: DslTree
}

data ct_real_v2_to_dsl_ingest: SourceRootIngest = Cons {
  head: ct_real_v2_to_dsl_subject_read,
  tail: Cons { head: ct_real_v2_to_dsl_target_read, tail: Empty }
}

data ct_real_dsl_to_v2_subject_read: DagSourceReadWitness = DagSourceReadWitness {
  source: ct_real_v2_subject_source,
  artifact: ct_real_v2_subject_artifact,
  compilation_unit: ^ct_real_subject_cu,
  source_root: DslTree
}

data ct_real_dsl_to_v2_target_read: DagSourceReadWitness = DagSourceReadWitness {
  source: ct_real_dsl_target_source,
  artifact: ct_real_dsl_target_artifact,
  compilation_unit: ^ct_real_target_cu,
  source_root: V2Tree
}

data ct_real_dsl_to_v2_ingest: SourceRootIngest = Cons {
  head: ct_real_dsl_to_v2_subject_read,
  tail: Cons { head: ct_real_dsl_to_v2_target_read, tail: Empty }
}

fn ct_real_subject_qn() -> QualifiedName {
  QnCons { head: ^v2, tail: QnCons { head: ^ct_real_subject, tail: QnEmpty } }
}

fn ct_real_target_qn() -> QualifiedName {
  QnCons { head: ^ct_real_target, tail: QnEmpty }
}

fn ct_real_edge_decision(ingest: SourceRootIngest) -> CrossTreeEdgeDecision {
  match program_assembly_fold_ingest(ingest: ingest, lm: dag_language_model_wave1()) {
    ProgramAssemblyFoldFailed { diagnostics: _ } => EdgeCrossAmbiguous
    ProgramAssemblyFoldOk { roots: _, index: idx } =>
      cross_tree_edge_decision(
        index: idx,
        from_qn: ct_real_subject_qn(),
        to_qn: ct_real_target_qn(),
        active_roots: source_root_set_from_ingest(ingest: ingest)
      )
  }
}

fn cross_tree_real_ingest_v2_to_dsl_admitted_holds() -> Bool {
  match ct_real_edge_decision(ingest: ct_real_v2_to_dsl_ingest) {
    EdgeCrossAdmitted => true
    EdgeCrossDenied => false
    EdgeNormalResolution => false
    EdgeCrossAmbiguous => false
  }
}

fn cross_tree_real_ingest_dsl_to_v2_denied_holds() -> Bool {
  match ct_real_edge_decision(ingest: ct_real_dsl_to_v2_ingest) {
    EdgeCrossDenied => true
    EdgeCrossAdmitted => false
    EdgeNormalResolution => false
    EdgeCrossAmbiguous => false
  }
}

test fn cross_tree_real_ingest_activation_witnesses() -> Bool {
  cross_tree_real_ingest_v2_to_dsl_admitted_holds()
    && cross_tree_real_ingest_dsl_to_v2_denied_holds()
}
