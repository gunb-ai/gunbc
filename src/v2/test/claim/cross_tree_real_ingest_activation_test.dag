// Scope: §5 de-fork ACTIVATION arbiter — grounded cross-tree admission DERIVED FROM HOST TAGS.
//
// name_resolve_cross_tree_resolution_test proves resolve_with_admission_grounded admits v2→dsl
// GIVEN a HAND-BUILT grounded index (source_root_index_insert). This witness closes the
// remaining leg by execution: it feeds a HOST-TAGGED SourceRootIngest (each DagSourceReadWitness
// carries its source_root) through the REAL grounding machinery — program_assembly_fold_ingest
// builds the QualifiedName→SourceRootRef index, source_root_set_from_ingest builds the active
// source-root set — and then runs the REAL per-edge admission decision cross_tree_edge_decision
// (the exact fn admit_import_entry calls). NOTHING about fundamentality is supplied: the index
// and active-root set come only from the source_root tags, and MoreFundamental/LessFundamental
// is derived by tree_fundamentality_order. This is the by-execution proof that the source_root
// carrier (#5473/#5486) is CONSUMED on the real compile path, not merely carried.
//
// GREEN: a V2Tree-tagged subject importing a DslTree-tagged target → EdgeCrossAdmitted
//        (tree_fundamentality_order(V2,Dsl)=MoreFundamental + layer direction compiler→std).
// RED:   reverse only the source_root tags (DslTree subject importing a V2Tree target) → the
//        SAME machinery yields EdgeCrossDenied (LessFundamental). Flip either tag and the
//        witness goes the wrong way — the discriminating oracle. Asserting the exact decision
//        variant (not a Bool proxy) keeps the RED leg from passing for a wrong reason.
//
// Enrolled in CI via _test.dag naming convention (floor discovery auto-enroll).

module v2.test.claim.cross_tree_real_ingest_activation

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.program_assembly {
  ProgramAssemblyFoldFailed,
  ProgramAssemblyFoldOk,
  program_assembly_fold_ingest
}
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootIngest,
  source_root_set_from_ingest
}
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.algebra { Cons, Empty }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DslTree, V2Tree }
import v2.std.cross_tree.resolution {
  CrossTreeEdgeDecision,
  EdgeCrossAdmitted,
  EdgeCrossAmbiguous,
  EdgeCrossDenied,
  EdgeNormalResolution,
  cross_tree_edge_decision
}
import v2.std.logic { Bool }
import v2.std.qualified_name { QnCons, QnEmpty, QualifiedName }


// ── Real module source text (parsed by the wave1 LM, the real-compile language model) ──
// Bare modules: program_assembly_fold_ingest only needs each to parse and project its module
// QualifiedName so the (QN → source_root) index binding is built; the import edge under test is
// carried by the QNs below, exactly as admit_import_entry consults them.
data ct_real_v2_subject_source: Medium<String> = Medium {
  carried: "module v2.ct_real_subject\n",
  fidelity: Lossless
}

data ct_real_dsl_target_source: Medium<String> = Medium {
  carried: "module ct_real_target\n",
  fidelity: Lossless
}


// ── Artifacts (filesystem provenance the host attaches at ingest) ──
data ct_real_v2_subject_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^ct_real_v2_subject_artifact,
  file_path: "src/v2/ct_real_subject.dag"
}

data ct_real_dsl_target_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^ct_real_dsl_target_artifact,
  file_path: "dsl/ct_real_target.dag"
}


// ── GREEN ingest: V2Tree subject + DslTree target (host filesystem truth) ──
data ct_real_v2_to_dsl_subject_read: DagSourceReadWitness = DagSourceReadWitness {
  source: ct_real_v2_subject_source,
  artifact: ct_real_v2_subject_artifact,
  compilation_unit: ^ct_real_subject_cu,
  source_root: V2Tree
}

data ct_real_v2_to_dsl_target_read: DagSourceReadWitness = DagSourceReadWitness {
  source: ct_real_dsl_target_source,
  artifact: ct_real_dsl_target_artifact,
  compilation_unit: ^ct_real_target_cu,
  source_root: DslTree
}

data ct_real_v2_to_dsl_ingest: SourceRootIngest = Cons {
  head: ct_real_v2_to_dsl_subject_read,
  tail: Cons { head: ct_real_v2_to_dsl_target_read, tail: Empty }
}


// ── RED ingest: tags reversed — DslTree subject + V2Tree target (same source modules) ──
data ct_real_dsl_to_v2_subject_read: DagSourceReadWitness = DagSourceReadWitness {
  source: ct_real_v2_subject_source,
  artifact: ct_real_v2_subject_artifact,
  compilation_unit: ^ct_real_subject_cu,
  source_root: DslTree
}

data ct_real_dsl_to_v2_target_read: DagSourceReadWitness = DagSourceReadWitness {
  source: ct_real_dsl_target_source,
  artifact: ct_real_dsl_target_artifact,
  compilation_unit: ^ct_real_target_cu,
  source_root: V2Tree
}

data ct_real_dsl_to_v2_ingest: SourceRootIngest = Cons {
  head: ct_real_dsl_to_v2_subject_read,
  tail: Cons { head: ct_real_dsl_to_v2_target_read, tail: Empty }
}


// ── The two module QualifiedNames the import edge runs between ──
fn ct_real_subject_qn() -> QualifiedName {
  QnCons { head: ^v2, tail: QnCons { head: ^ct_real_subject, tail: QnEmpty } }
}

fn ct_real_target_qn() -> QualifiedName {
  QnCons { head: ^ct_real_target, tail: QnEmpty }
}


// Run the REAL grounding machinery: build the index from the ingest's host tags, build the
// active-root set from the same tags, then take the real per-edge admission decision for the
// v2-subject → dsl-target import. A parse failure surfaces as EdgeCrossAmbiguous (a distinct,
// non-admitted variant) so a broken witness can never masquerade as GREEN.
fn ct_real_edge_decision(ingest: SourceRootIngest) -> CrossTreeEdgeDecision {
  match program_assembly_fold_ingest(ingest: ingest, lm: dag_language_model_wave1()) {
    ProgramAssemblyFoldFailed { diagnostics: _ } => EdgeCrossAmbiguous
    ProgramAssemblyFoldOk { roots: _, index: idx } =>
      cross_tree_edge_decision(
        index: idx,
        from_qn: ct_real_subject_qn(),
        to_qn: ct_real_target_qn(),
        active_roots: source_root_set_from_ingest(ingest: ingest)
      )
  }
}


// ── Witnesses (assert the exact decision variant) ──

fn cross_tree_real_ingest_v2_to_dsl_admitted_holds() -> Bool {
  match ct_real_edge_decision(ingest: ct_real_v2_to_dsl_ingest) {
    EdgeCrossAdmitted => true
    EdgeCrossDenied => false
    EdgeNormalResolution => false
    EdgeCrossAmbiguous => false
  }
}

fn cross_tree_real_ingest_dsl_to_v2_denied_holds() -> Bool {
  match ct_real_edge_decision(ingest: ct_real_dsl_to_v2_ingest) {
    EdgeCrossDenied => true
    EdgeCrossAdmitted => false
    EdgeNormalResolution => false
    EdgeCrossAmbiguous => false
  }
}


test fn cross_tree_real_ingest_activation_witnesses() -> Bool {
  cross_tree_real_ingest_v2_to_dsl_admitted_holds()
    && cross_tree_real_ingest_dsl_to_v2_denied_holds()
}
