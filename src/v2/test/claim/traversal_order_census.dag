module v2.test.claim.traversal_order_census

import std.types { Bool, List }
import std.algebra { fold_list, length, string_contains }
import v2.std.integer { Int }
import v2.std.text { String }
import v2.compiler.traversal_order_census {
  TraversalCensusReport,
  TraversalFnFact,
  TraversalMention,
  traversal_census_exit,
  traversal_census_join
}
import v2.compiler.traversal_order_roster {
  AdmittedFusedRealization,
  SiteCall,
  SiteChildrenRead,
  SiteValueReference,
  StructuralEnumeration,
  TraversalDisposition,
  TraversalSiteKind,
  TraversalPlanDischarge,
  TraversalSiteKey,
  TraversalStage
}

// These claims SUPPLY FACTS to the census's own pure reduction (traversal_census_join), the same function
// the instrument's real route calls, so each control is the production join and not a restatement of it.
// The real route (detection over resolved trees) is exercised by `gunbc test
// //gunbc/instruments:traversal-order-census`; the claims here pin what the join does with what
// detection hands it.

data stages: List<TraversalStage> = [
  TraversalStage { stage: "s", root: "m.root", modules: ["m"] },
  TraversalStage { stage: "h", root: "h.pos", modules: ["h"] }
]

data seeds: List<String> = ["std.algebra.fold_list"]

fn mention(callee: String, kind: TraversalSiteKind, path: List<Int>, shape: String, fed: Bool) -> TraversalMention {
  TraversalMention { callee: callee, kind: kind, path: path, shape: shape, fed: fed }
}

fn root_fact(mentions: List<TraversalMention>) -> TraversalFnFact {
  TraversalFnFact { function: "m.root", module: "m", mentions: mentions }
}

fn key(path: List<Int>, shape: String) -> TraversalSiteKey {
  TraversalSiteKey { function: "m.root", path: path, callee: "std.algebra.fold_list", kind: SiteCall, shape: shape }
}

fn structural_row(path: List<Int>, shape: String) -> TraversalDisposition {
  TraversalDisposition { key: key(path: path, shape: shape), class: StructuralEnumeration { builds: "an index" } }
}

fn fold_call(path: List<Int>, shape: String) -> TraversalMention {
  mention(callee: "std.algebra.fold_list", kind: SiteCall, path: path, shape: shape, fed: false)
}

// The helper stage's own fact: it reads children, so it is itself a primitive and a site.
data helper_fact: TraversalFnFact = TraversalFnFact {
  function: "h.pos",
  module: "h",
  mentions: [mention(callee: "children", kind: SiteChildrenRead, path: [0], shape: "c", fed: false)]
}

fn join(facts: List<TraversalFnFact>, rows: List<TraversalDisposition>, discharges: List<String>) -> TraversalCensusReport {
  traversal_census_join(stages: stages, facts: facts, rows: rows, seeds: seeds, discharges: discharges)
}

fn count_class(r: TraversalCensusReport, word: String) -> Int {
  fold_list(xs: r.results, empty: 0, cons: fn(n, x) { if x.class_word == word { n + 1 } else { n } })
}

fn has_cause(r: TraversalCensusReport, cause: String) -> Bool {
  fold_list(xs: r.results, empty: false, cons: fn(any, x) { any || x.cause == cause })
}

fn has_refusal(r: TraversalCensusReport, prefix: String) -> Bool {
  fold_list(xs: r.refusals, empty: false, cons: fn(any, x) { any || string_contains(s: x, pattern: prefix) })
}

// 1. A detected site with no row is Unresolved (positive control for the whole instrument).
test fn an_unclassified_direct_traversal_is_unresolved_holds() -> Bool {
  let r = join(facts: [root_fact(mentions: [fold_call(path: [0], shape: "a")]), helper_fact], rows: [], discharges: [])
  count_class(r: r, word: "unresolved") >= 1 && has_cause(r: r, cause: "no_row") && traversal_census_exit(report: r) == 1
}

// 2. The same site with a row is classified, and the census holds.
test fn a_classified_traversal_holds_when_every_site_has_its_row() -> Bool {
  let rows = [
    structural_row(path: [0], shape: "a"),
    TraversalDisposition { key: TraversalSiteKey { function: "h.pos", path: [0], callee: "children", kind: SiteChildrenRead, shape: "c" }, class: StructuralEnumeration { builds: "child list" } }
  ]
  let r = join(facts: [root_fact(mentions: [fold_call(path: [0], shape: "a")]), helper_fact], rows: rows, discharges: [])
  count_class(r: r, word: "structural") == 2 && count_class(r: r, word: "unresolved") == 0 && traversal_census_exit(report: r) == 0
}

// 3. A row whose site is gone is a stale-row refusal (negative control).
test fn a_row_with_no_detected_site_is_stale_and_refuses() -> Bool {
  let r = join(facts: [root_fact(mentions: []), helper_fact], rows: [structural_row(path: [0], shape: "a")], discharges: [])
  length(xs: r.stale) == 1 && traversal_census_exit(report: r) == 1
}

// 4. A positional read reached through a helper is a site in the caller as well as in the helper.
test fn a_helper_mediated_children_read_is_a_site_in_the_caller_holds() -> Bool {
  let r = join(facts: [root_fact(mentions: [mention(callee: "h.pos", kind: SiteCall, path: [0], shape: "a", fed: true)]), helper_fact], rows: [], discharges: [])
  fold_list(xs: r.results, empty: 0, cons: fn(n, x) { if x.module == "m" { n + 1 } else { n } }) == 1
}

// 5. Direct recursion (a Cons walk calling itself) is a site.
test fn direct_recursion_is_a_site_holds() -> Bool {
  let r = join(facts: [root_fact(mentions: [mention(callee: "m.root", kind: SiteCall, path: [1], shape: "r", fed: true)]), helper_fact], rows: [], discharges: [])
  fold_list(xs: r.results, empty: 0, cons: fn(n, x) { if x.module == "m" && x.class_word == "unresolved" { n + 1 } else { n } }) == 1
}

// 6. A closure module no stage owns refuses the census.
test fn an_unowned_closure_module_refuses() -> Bool {
  let extra = TraversalFnFact { function: "x.helper", module: "x", mentions: [] }
  let r = join(facts: [root_fact(mentions: [mention(callee: "x.helper", kind: SiteCall, path: [0], shape: "a", fed: false)]), helper_fact, extra], rows: [], discharges: [])
  has_refusal(r: r, prefix: "unowned_module") && traversal_census_exit(report: r) == 1
}

// 7. Identical sibling sites are distinguished by path: a row for one does not classify the other.
test fn identical_sibling_sites_are_distinguished_by_path_holds() -> Bool {
  let r = join(facts: [root_fact(mentions: [fold_call(path: [0], shape: "a"), fold_call(path: [1], shape: "a")]), helper_fact], rows: [structural_row(path: [0], shape: "a")], discharges: [])
  count_class(r: r, word: "structural") == 1 && fold_list(xs: r.results, empty: 0, cons: fn(n, x) { if x.module == "m" && x.class_word == "unresolved" { n + 1 } else { n } }) == 1
}

// 8. A row re-pointed onto code that changed (same path, different shape) is stale and the site is Unresolved.
test fn a_swapped_site_at_the_same_path_refuses_the_old_row() -> Bool {
  let r = join(facts: [root_fact(mentions: [fold_call(path: [0], shape: "b")]), helper_fact], rows: [structural_row(path: [0], shape: "a")], discharges: [])
  length(xs: r.stale) == 1 && has_cause(r: r, cause: "no_row")
}

// 9. A primitive named as a value (higher-order delegation) is a site, not a pass.
test fn higher_order_delegation_is_a_site_holds() -> Bool {
  let r = join(facts: [root_fact(mentions: [mention(callee: "std.algebra.fold_list", kind: SiteValueReference, path: [0], shape: "a", fed: false)]), helper_fact], rows: [], discharges: [])
  fold_list(xs: r.results, empty: 0, cons: fn(n, x) { if x.module == "m" && x.class_word == "unresolved" { n + 1 } else { n } }) == 1
}

// 10. A fused row without a plan-discharge record is Unresolved; with the record it is admitted.
test fn a_fused_row_without_a_discharge_is_unresolved_and_with_one_is_admitted() -> Bool {
  let row = TraversalDisposition { key: key(path: [0], shape: "a"), class: AdmittedFusedRealization { discharge: TraversalPlanDischarge { part: "p" } } }
  let facts = [root_fact(mentions: [fold_call(path: [0], shape: "a")]), helper_fact]
  let without = join(facts: facts, rows: [row], discharges: [])
  let admitted = join(facts: facts, rows: [row], discharges: ["p"])
  has_cause(r: without, cause: "fused_without_discharge") && count_class(r: admitted, word: "fused") == 1
}
