module v2.test.claim.outside_discovery_roots_census_real_execution

// THE REAL PAIRING for the outside-discovery-roots census: what the index actually lists under the note's
// subject IS the population the census reports, and every one of them is a finding. The expectation is the
// note's declared population as the tree measures it; the observation is git's; this file is where they are
// held together.
//
// WHY A SEPARATE FILE, AND WHY THE LOCAL-REPO WET LANE. The two reads this census is built on -- `ls-files`
// and the claim-marker grep -- are effects: each goes to `shell.Exec.RunArgv` through
// gunbc.command_runner.run_shell_command_capture, and RunArgv carries no `mock_response`, so hermetic
// discovery REFUSES the claim rather than skipping it. That refusal is the hermetic envelope doing its job: a
// mocked index or a mocked grep stdout would re-check the census against authored data, and the fact under
// test is what the index actually tracks under a declared subject. So the claim runs where the repo puts
// claims whose subject is a real process's stdout -- the local-repo wet lane, beside
// the local-repo wet lane, enrolled as its members are: a frontier row in gunbc.ci.ci_layer_roots, a
// schedule entry in v2.workflow.local_repo_wet_terminal, and expectations in v2.workflow.floor_route_gap --
// the same triple that enrolls members like
// test.claim.machine_intake.mtcollins1_census_image_local_wet.
//
// WHY src/v2 AND NOT dag/test/claim, where most of that lane's members sit: the file imports
// v2.workflow.outside_discovery_roots_census, and the modelled import rule
// (v2.std.cross_tree.resolution tree_fundamentality_order) DENIES dag -> v2 while allowing v2 -> dag. A new
// module lives where its import edges are admitted, so this one lives in v2 and the schedule row points
// there. The executor resolves the entry by the row's identity.module_path over the witness layer roots
// (src/v1/stage0/src/cli_run/required_floor_runner.rs), which include src/v2, so the placement costs the
// lane nothing.
//
// THE EXECUTION IS PURELY LOCAL: two git reads over the checkout (`-C <checkout> ls-files`, `-C <checkout>
// grep -E -l`), no network, no remote host, no Cargo, nothing written.
//
// THE MUTUAL OBLIGATION, stated the way the pairing obligation requires it: deleting either capture from the
// live entry does not make this claim quiet, it makes it red. The census cannot invent a listing or a marker
// answer -- both arrive as typed reads, and a missing one is `ListingRefused`/`BearersRefused`, which makes
// the outcome `CensusUnread` and empties `out.findings`; the containment below then fails on the first
// declared path.
// So the witness cannot survive the deletion of the integration it witnesses, and it cannot be satisfied by
// the pure file's fixtures either, because those inject listings rather than performing reads.

import std.types { String, Bool, List }
import std.algebra { is_empty, length, list_map }

import std.decl_ref { decl_ref }
import v2.std.decl_ref_resolution_host { declaration_ref_resolution_census_live }
import gunbc.ci.ci_layer_roots { witness_layer_roots }

import v2.workflow.outside_discovery_roots_census {
  CensusObserved,
  OutsideRootsStanding,
  InsideGovernedTree,
  OutsideDiscoveryRoots,
  NotAClaimFile,
  path_is_under_note_subject,
  emitted_entry_for_module,
  subject_path_is_emitted,
  outside_roots_citations,
  outside_roots_cause,
  declaration_ref_display
}

import v2.workflow.outside_discovery_roots_census_live {
  tracked_claim_listing,
  tracked_claim_bearers,
  outside_roots_census
}

// THE EXPECTATION, imported rather than restated: the same list the hermetic witness holds its injected
// listings against. Two copies of a population, in two files, is the second-implementation defect this repo
// calls §3's fork; one list, read by both the hermetic and the wet observer, is one fact with two readers.
import v2.test.claim.outside_discovery_roots_census_helpers { emitted_registry_path }
import gunbc.stage0.stage0_rust_host_observation { emitted_population_repo_paths }
import v2.lens.module_graph { module_declaration_facts_live, ModuleDeclarationFact }
import extdeps.filesystem.filesystem_io { Filesystem }

fn is_in(listing: List<String>, path: String) -> Bool {
  any(xs: listing, predicate: fn(candidate) { candidate == path })
}

fn standing_path(row: OutsideRootsStanding) -> String {
  match row {
    InsideGovernedTree { path: path, tree_directory: _ } => path
    OutsideDiscoveryRoots { path: path, cause: _ } => path
    NotAClaimFile { path: path } => path
  }
}

// THE EXPECTED SUBJECT POPULATION IS DERIVED, NOT WRITTEN. The registry names emitted Rust targets, so a
// subject .dag path is in it when the module that path DECLARES (the host's own scan, `module_declaration_facts_live`)
// composes to an entry the registry names -- the same composition the emitter performs. Neither `git ls-files`
// nor the marker grep ever touches either input. A hand-kept copy of the file list was a change detector (DESIGN 5): it went red when #14522
// added a file, and a tool that updates it would collapse the claim to `measure() == measure()`.
fn derived_subject_population(registry_content: String, facts: List<ModuleDeclarationFact>) -> List<String> {
  let emitted = emitted_population_repo_paths(content: registry_content)
  filter(
    xs: list_map(xs: facts, f: fn(fact) { fact.path }),
    predicate: fn(path) {
      path_is_under_note_subject(path: path) && subject_path_is_emitted(path: path, emitted: emitted, facts: facts)
    }
  )
}

// THE PAIRING, over two instruments and no literal. The CENSUS (index listing + marker answer) and the
// REGISTRY (emitter) must agree on the subject at identity: every registry-named subject path is a row the
// census classified (so a path the emitter names that the index does not track reds, by name), and every
// finding the census reports is a path the emitter named (so a claim file the emitter never produced reds).
// Which of the named paths declare a claim is the marker's verdict and is exercised hermetically by the
// witness file; it is not re-asserted against a list here, because that list was the change detector.
fn subject_agrees_with_registry(derived: List<String>, rows: List<OutsideRootsStanding>, findings: List<String>) -> Bool {
  !(is_empty(derived))
    && all(xs: derived, predicate: fn(path) { is_in(listing: list_map(xs: rows, f: fn(row) { standing_path(row: row) }), path: path) })
    && all(xs: findings, predicate: fn(path) { is_in(listing: derived, path: path) })
}

test fn the_live_index_agrees_with_the_emitted_subject_population_by_real_execution() -> Bool {
  let read = Filesystem.Read(path: emitted_registry_path)
  let out = outside_roots_census(
    listing: tracked_claim_listing(),
    bearers: tracked_claim_bearers()
  )
  read.success
    && match out.outcome {
      CensusObserved { rows: rows } => subject_agrees_with_registry(
        derived: derived_subject_population(registry_content: read.content, facts: module_declaration_facts_live(pool_roots: ["src/v1"])),
        rows: rows,
        findings: out.findings
      )
      _ => false
    }
}

// THE RED for the pairing above, on the same predicate: a registry that names a subject path the census has
// no row for must refuse, and the live claim above is its positive control. Without this the claim could be
// satisfied by a predicate that never answers false.
test fn a_registry_path_the_census_has_no_row_for_is_a_disagreement_by_real_execution() -> Bool {
  let read = Filesystem.Read(path: emitted_registry_path)
  let out = outside_roots_census(
    listing: tracked_claim_listing(),
    bearers: tracked_claim_bearers()
  )
  let derived = derived_subject_population(registry_content: read.content, facts: module_declaration_facts_live(pool_roots: ["src/v1"]))
  read.success
    && match out.outcome {
      CensusObserved { rows: rows } => !(subject_agrees_with_registry(
        derived: concat(derived, ["src/v1/tests/claim/a_path_the_index_never_tracked_xyz.dag"]),
        rows: rows,
        findings: out.findings
      ))
      _ => false
    }
}

// THE POSITIVE CONTROL, and the reason the claim above is not a tautology that passes when nothing is
// observed. A census that read nothing reports no findings and `unread`; a census that read the index
// reports the population and is not unread. If either capture were deleted, `unread` would carry this claim
// to its red side rather than letting it pass on an empty population.
test fn the_live_reads_produce_an_observed_population_rather_than_a_refusal_by_real_execution() -> Bool {
  let out = outside_roots_census(
    listing: tracked_claim_listing(),
    bearers: tracked_claim_bearers()
  )
  (match out.outcome { CensusObserved { rows: _ } => true _ => false }) && !(is_empty(out.findings))
}

// THE GAP POPULATION IS OBSERVED, NOT ASSUMED. The scan-dir gap is printed with no standing, on the ruling
// that nobody has decided whether the flat `src/v2/test/claim` shape is accepted -- which makes it exactly the
// population that could sit at zero forever and look like a clean report. A zero here is only meaningful if
// the read ran; the same capture that produced the ruled findings produced this one, and `unread` is the
// refusal, so an empty gap on a read census is an observation and not a silence. Asserted on the real route
// because no fixture can say the route emits it: the hermetic witness gives the shape, this gives inhabitation.
test fn the_scan_dir_gap_is_observed_on_the_real_route_by_real_execution() -> Bool {
  let out = outside_roots_census(
    listing: tracked_claim_listing(),
    bearers: tracked_claim_bearers()
  )
  (match out.outcome { CensusObserved { rows: _ } => true _ => false })
    && !(is_empty(out.scan_dir_gap))
    && all(xs: out.scan_dir_gap, predicate: fn(path) { is_in(listing: out.findings, path: path) == false })
}

// THE JOIN ON FACTS THE HOST SUPPLIES is the derivation above: the host's own scan declares each module, the
// registry names what the emitter produced, and the expected population is their composition. The claim that
// once asserted a hand-kept list against that join is dissolved with the list; its shape stays proven by
// `the_join_requires_the_fact_to_name_the_path_and_the_module_to_be_emitted` in the witness file.

// ---------------------------------------------------------------------------
// THE CITATIONS RESOLVE. Review 83419: the census used to name its authorities as free strings -- a note
// name, a module path, even a Rust file path baked into a `cause: String`. A claim that checks the printed
// line contains that string checks the census against its own text: rename the note or delete the layout
// function and every claim stays green. The authorities are DeclarationRefs now, and this is the claim that
// makes a rename RED -- it asks the live index, for each citation the census prints, whether the symbol is
// actually there.
//
// WHY IT IS ON THE WET LANE AND NOT WITH THE HERMETIC WITNESS. Resolving a reference means reading the tree
// the reference points at (`decl_facts_at` over the witness layer roots). A hermetic claim that answered from
// a hand-minted DeclFact list would be checking the census against facts I authored, which is the
// measure()==measure() failure this file exists to avoid. So the facts come from the tree, and the lane is
// the one that allows the read.
// ---------------------------------------------------------------------------

// Every citation the census can print resolves to a real declaration, and no citation is refused for any of
// the four typed reasons. A count rather than a boolean, so a failure names how many broke rather than only
// that one did.
test fn every_printed_citation_resolves_against_the_live_index_by_real_execution() -> Bool {
  let census = declaration_ref_resolution_census_live(
    refs: outside_roots_citations,
    pool_roots: witness_layer_roots
  )
  census.resolved_count == length(xs: outside_roots_citations)
    && census.module_absent_count == 0
    && census.declaration_absent_count == 0
    && census.field_absent_count == 0
    && census.ambiguous_count == 0
}

// THE CONTROL, and it is the claim that makes the one above mean anything. If resolution could not fail --
// if the reader answered "resolved" for a symbol that does not exist -- the claim above would be a tautology
// wearing a check. This mints a reference to a symbol that is not in the tree and requires the resolver to
// REFUSE it. It is also what distinguishes "the resolver ran and said no" from "the resolver never ran": a
// broken or vacuous resolution route makes this red while the positive claim stays green, which is the
// asymmetry that tells the two apart.
test fn a_citation_to_a_symbol_that_does_not_exist_is_refused_by_real_execution() -> Bool {
  let census = declaration_ref_resolution_census_live(
    refs: [decl_ref(module_path: "v2.cli.repository_layout", decl_name: "repository_module_file_of_path_definitely_not_renamed")],
    pool_roots: witness_layer_roots
  )
  census.resolved_count == 0
    && census.module_absent_count + census.declaration_absent_count
         + census.field_absent_count + census.ambiguous_count == 1
}

// The printed form is the citation, not a paraphrase of it. The receipt the operator reads and the reference
// the resolver checks are the same two fields of the same record, so a receipt cannot keep flattering a
// symbol that has already been renamed away.
test fn every_citation_the_receipt_prints_is_a_citation_the_resolver_checks_by_real_execution() -> Bool {
  let census = declaration_ref_resolution_census_live(
    refs: outside_roots_citations,
    pool_roots: witness_layer_roots
  )
  census.resolved_count == length(xs: outside_roots_citations)
    && all(xs: outside_roots_citations, predicate: fn(ref) {
      declaration_ref_display(ref: ref) == concat(ref.module_path as String, concat(":", ref.decl_name as String))
    })
    && declaration_ref_display(ref: outside_roots_cause.note_subject)
         == "gunbc.ci.ci_layer_roots:v1_claim_scoped_witness_batch_deleted_note"
}
