module v2.test.claim.native_loop_model_test

import std.algebra { Empty }
import std.types { Bool, String }
import v2.compiler.native_loop {
  CompileAccepted,
  CompileRefused,
  EntryIdentity,
  ExecuteAccepted,
  ExecuteRefused,
  ExecuteRequest,
  NativeCompileResponse,
  NativeExecuteResponse,
  NativeRequest,
  NativeRequestDecode,
  NativeRequestDecoded,
  NativeRequestDecodeRefusedMalformedJson,
  NativeRequestDecodeRefusedUnknownAction,
  NativeResponse,
  NativeTestResponse,
  OutputDirectory,
  SourceRootIdentity,
  TestAccepted,
  TestRefused,
  TestRequest,
  TestRosterIdentity,
}
import v2.std.optional { Absent }

fn fixture_execute_request() -> NativeRequest {
  ExecuteRequest { source_roots: [SourceRootIdentity { value: "src/v2" }], entry: EntryIdentity { value: "fixture.entry" }, inputs: Empty }
}

fn fixture_test_request() -> NativeRequest {
  TestRequest { source_roots: [SourceRootIdentity { value: "src/v2" }], roster_identity: TestRosterIdentity { value: "required-v2" }, optional_subject_selection: Absent }
}

test fn native_loop_execute_request_schema_constructs() -> Bool {
  match fixture_execute_request() { ExecuteRequest { source_roots: _, entry: _, inputs: _ } => true _ => false }
}

test fn native_loop_test_request_schema_constructs() -> Bool {
  match fixture_test_request() { TestRequest { source_roots: _, roster_identity: _, optional_subject_selection: _ } => true _ => false }
}

test fn native_loop_decode_success_carries_request() -> Bool {
  let decoded: NativeRequestDecode = NativeRequestDecoded { request: fixture_execute_request() }
  match decoded { NativeRequestDecoded { request: ExecuteRequest { source_roots: _, entry: _, inputs: _ } } => true _ => false }
}

test fn native_loop_unknown_action_tag_is_uninhabited_as_request() -> Bool {
  let decoded: NativeRequestDecode = NativeRequestDecodeRefusedUnknownAction { action: "serve" }
  match decoded { NativeRequestDecodeRefusedUnknownAction { action: _ } => true _ => false }
}

test fn native_loop_malformed_json_has_distinct_decode_refusal() -> Bool {
  let decoded: NativeRequestDecode = NativeRequestDecodeRefusedMalformedJson
  match decoded { NativeRequestDecodeRefusedMalformedJson => true _ => false }
}

test fn native_loop_compile_response_schema_is_typed() -> Bool {
  let accepted: NativeResponse = NativeCompileResponse { response: CompileAccepted { output_directory: OutputDirectory { value: "target/native" } } }
  let refused: NativeResponse = NativeCompileResponse { response: CompileRefused }
  match accepted { NativeCompileResponse { response: CompileAccepted { output_directory: _ } } => match refused { NativeCompileResponse { response: CompileRefused } => true _ => false } _ => false }
}

test fn native_loop_test_response_schema_is_typed() -> Bool {
  let accepted: NativeResponse = NativeTestResponse { response: TestAccepted { roster_identity: TestRosterIdentity { value: "required-v2" } } }
  let refused: NativeResponse = NativeTestResponse { response: TestRefused }
  match accepted { NativeTestResponse { response: TestAccepted { roster_identity: _ } } => match refused { NativeTestResponse { response: TestRefused } => true _ => false } _ => false }
}

test fn native_loop_execute_response_schema_is_typed() -> Bool {
  let accepted: NativeResponse = NativeExecuteResponse { response: ExecuteAccepted { value: Empty } }
  let refused: NativeResponse = NativeExecuteResponse { response: ExecuteRefused }
  match accepted { NativeExecuteResponse { response: ExecuteAccepted { value: _ } } => match refused { NativeExecuteResponse { response: ExecuteRefused } => true _ => false } _ => false }
}

data native_loop_schema_only_test_note: String = "These controls execute only the request/response/decode schema. They deliberately do not simulate entry, source, build, roster, selected-test, effect, generation, or PATH admission. Those falsifiers cannot honestly execute until the decision consumes XL-1's single effect-demand authority."
