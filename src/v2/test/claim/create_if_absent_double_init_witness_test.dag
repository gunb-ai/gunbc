module v2.test.claim.create_if_absent_double_init_witness_test

import v2.std.effects {
  create_always_shape,
  create_double_init_collapsible,
  create_effect_is_dedupable,
  create_if_absent_shape,
  sample_create_if_absent_key_b,
  sample_create_if_absent_key_source
}
import v2.std.logic { Bool }

test fn create_if_absent_same_identity_is_dedupable_holds() -> Bool {
  let shape = create_if_absent_shape(key_source: sample_create_if_absent_key_source)
  create_effect_is_dedupable(shape: shape)
    && create_double_init_collapsible(
      a: shape,
      b: shape
    )
}

test fn create_always_is_not_dedupable_holds() -> Bool {
  let shape = create_always_shape()
  !create_effect_is_dedupable(shape: shape)
    && !create_double_init_collapsible(a: shape, b: shape)
}

test fn create_if_absent_different_identity_not_dedupable_holds() -> Bool {
  let a = create_if_absent_shape(key_source: sample_create_if_absent_key_source)
  let b = create_if_absent_shape(key_source: sample_create_if_absent_key_b)
  create_effect_is_dedupable(shape: a)
    && create_effect_is_dedupable(shape: b)
    && !create_double_init_collapsible(a: a, b: b)
}
