module v2.test.claim.cool_moth_census
import std.types { Int, List }
import v2.compiler.normalize { NormalizeWithIsolatedAllocator, normalize_with }
import v2.compiler.parse { ParseArtifact, parse_module_prepared, prepare_grammar }
import v2.compiler.program_assembly { dag_prepared_lex }
import v2.compiler.reference_site_collector {
  HeadBindingUndecided,
  HeadBoundAtRootValue,
  HeadBoundInFrame,
  HeadLexicallyUnbound,
  HeadNotAValuePosition,
  SiteHeadBinding,
  collect_scoped_module_reference_sites
}
import v2.compiler.tokenize { tokenize_prepared }
import std.algebra { length, list_map }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Rejected }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.integer { int_to_decimal_string }
import v2.std.node {
  Authored,
  CoreEdgeLabel,
  EdgeLabel,
  Node,
  Positional,
  ProductionEdge,
  StructuralLabel,
  Symbol,
  core_edge_label_canonical_symbol,
  symbol_intern_lexeme,
  symbol_lexeme
}
import v2.std.qualified_name { qualified_name_to_dotted_string }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn head_text(head: SiteHeadBinding) -> String {
  match head {
    HeadNotAValuePosition => "NOTVALUE"
    HeadBoundInFrame => "FRAME"
    HeadBoundAtRootValue => "ROOT"
    HeadBindingUndecided => "UNDECIDED"
    HeadLexicallyUnbound => "UNBOUND"
  }
}

fn pname(s: Symbol) -> String {
  let n = symbol_lexeme(sym: s)
  if n == "grammar_production_captured_node_projection" {
    "CAP"
  } else {
    if n == "grammar_production_identity_node_projection" {
      "ID"
    } else {
      if n == "fold_list_node_head" {
        "FH"
      } else {
        if n == "fold_list_node_tail" {
          "FT"
        } else {
          "P:" + n
        }
      }
    }
  }
}

fn code(marker: CoreEdgeLabel) -> String {
  match marker {
    ArrowBodyEdge => "AB"
    ArrowSignatureOrderEdge => "OS"
    LoopBoundEdge => "LB"
    LoopCarrierEdge => "LC"
    LoopDomainEdge => "LD"
    LoopRealizedDeclarationEdge => "LDec"
    MatchArmPatternEdge => "Pat"
    MatchArmBodyEdge => "ABdy"
    CastTargetEdge => "Cast"
    TypeAnnotationEdge => "TA"
    TypeParamsEdge => "TP"
    TypeBodyEdge => "TB"
    TypeAliasEdge => "TAli"
    DeclarationReferenceEdge => "DR"
    FieldProjectionBaseEdge => "Base"
    FieldProjectionFieldEdge => "Fld"
    ConstructTagEdge => "Tag"
    ConstructTagElidedEdge => "TagE"
    ParameterReferenceEdge => "PR"
    ArrowEffectClaimsEdge => "Eff"
    ArrowExecutionModeClaimEdge => "Exec"
    BinderTypeEdge => "BT"
    BinderStructureEdge => "BS"
    BinderDefaultEdge => "BD"
    ArrowResourceRequirementsEdge => "Res"
    AdmitCallersEdge => "Adm"
    LexicalReferenceEdge => "LR"
    MapLiteralEntryEdge => "ME"
    MapLiteralEntriesEdge => "Ms"
    BodyTermLoweredEdge { seal: _ } => "Low"
    MatchArmScopeExitEdge => "Ex"
    ConstantMemberEdge => "Cm"
  }
}

fn seg(label: EdgeLabel) -> String {
  match label {
    Positional => "POS"
    Authored { name: s } => "a:" + symbol_lexeme(sym: s)
    StructuralLabel { label: ProductionEdge { language: _, edge: s } } => pname(s: s)
    StructuralLabel { label: CoreMarker { marker: m } } => code(marker: m)
  }
}

fn sites_line(tag: String, root: Node, imports: List<Symbol>) -> String {
  fold(
    collect_scoped_module_reference_sites(root: root, imported: imports).sites,
    init: "",
    f: fn(acc, s) {
      acc
        + tag
        + " SITE ["
        + fold(s.site.position, init: "", f: fn(pa, p) { pa + seg(label: p) + "/" })
        + "] "
        + qualified_name_to_dotted_string(qn: s.site.spelling)
        + "="
        + head_text(head: s.head)
        + " ;; "
    }
  )
}

fn probe_row(tag: String, content: String) -> String {
  match prepare_grammar(grammar: dag_language_model().grammar) {
    Rejected { diagnostics: _ } => tag + ": grammar-unprepared ;; "
    Accepted { value: prepared, diagnostics: _ } =>
      match tokenize_prepared(text: content, file: symbol_intern_lexeme(lexeme: "test/subject.dag"), prepared: dag_prepared_lex()) {
        Rejected { diagnostics: _ } => tag + ": tokenize-refused ;; "
        Accepted { value: stream, diagnostics: _ } =>
          match parse_module_prepared(tokens: stream, prepared: prepared) {
            Rejected { diagnostics: _ } => tag + ": parse-refused ;; "
            Accepted { value: artifact, diagnostics: _ } =>
              match normalize_with(parse_tree: artifact.tree, source: NormalizeWithIsolatedAllocator, spans: artifact.span_index) {
                Rejected { diagnostics: _ } => tag + ": normalize-refused ;; "
                Accepted { value: scoped, diagnostics: _ } =>
                  tag
                    + " ROWS="
                    + int_to_decimal_string(value: length(xs: scoped.tree.import_bindings))
                    + " ;; "
                    + sites_line(
                      tag: tag + "-IMP",
                      root: scoped.tree.root,
                      imports: list_map(xs: scoped.tree.import_bindings, f: fn(r) { r.binding })
                    )
                    + sites_line(tag: tag + "-NOIMP", root: scoped.tree.root, imports: [])
              }
          }
      }
  }
}

test fn cell_a() -> String {
  probe_row(tag: "A", content: "module v2.test.subject\n\nfn u(chars: fn(String) -> Int, x: String) -> Int {\n  chars(s: x)\n}\n")
}

test fn cell_i() -> String {
  probe_row(tag: "I", content: "module v2.test.subject\nimport std.algebra { chars }\n\nfn u(x: String) -> Int {\n  chars(s: x)\n}\n")
}

test fn cell_d() -> String {
  probe_row(tag: "D", content: "module v2.test.subject\n\nfn u(x: Int, w: x.T) -> Int {\n  g(v: x)\n}\n")
}

test fn cell_e() -> String {
  probe_row(tag: "E", content: "module v2.test.subject\n\nfn u(v: Int) -> Int {\n  match v {\n    SlotHeld { version: held } => held\n    SlotEmpty => 0\n  }\n}\n")
}

test fn cell_f() -> String {
  probe_row(tag: "F", content: "module v2.test.subject\n\nfn u() -> Int {\n  let y = 1\n  f(v: missing)\n}\n")
}

test fn cell_g() -> String {
  probe_row(tag: "G", content: "module v2.test.subject\n\nfn u(x: Int) -> Int {\n  o { field: x }\n}\n")
}

test fn cell_j() -> String {
  probe_row(tag: "J", content: "module v2.test.subject\n\nfn u() -> Int {\n  let f = (v) => v.y\n  0\n}\n")
}

test fn cell_k() -> String {
  probe_row(tag: "K", content: "module v2.test.subject\n\nfn u() -> Int {\n  loop x in xs {\n    x.y\n  }\n}\n")
}

test fn cell_l() -> String {
  probe_row(tag: "L", content: "module v2.test.subject\n\nfn u(x: Int) -> Int {\n  let f = (v) => v.x\n  0\n}\n")
}
