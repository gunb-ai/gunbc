module v2.test.claim.diagnostic_sequence_outcome_witness

import v2.std.diagnostic {
  Outcome,
  Accepted,
  Rejected,
  StageDiagnosticPolicy,
  ShortCircuit,
  Accumulate,
  outcome_accepted,
  outcome_rejected,
  sequence_outcome,
  port_locus,
  Diagnostic,
  ExternalContractUnknown,
  Unavailable,
}
import v2.std.collection { List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data short_circuit_policy: StageDiagnosticPolicy = StageDiagnosticPolicy { accumulation: ShortCircuit }
data accumulate_policy: StageDiagnosticPolicy = StageDiagnosticPolicy { accumulation: Accumulate }

fn diagnostic_a() -> Diagnostic {
  Diagnostic {
    reason: ^sequence_outcome_witness_reason_a
    at: port_locus(port: ^sequence_outcome_witness_port_a)
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn diagnostic_b() -> Diagnostic {
  Diagnostic {
    reason: ^sequence_outcome_witness_reason_b
    at: port_locus(port: ^sequence_outcome_witness_port_b)
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

test fn witness_sequence_outcome_empty_accepts() -> Bool {
  match sequence_outcome(xs: [], policy: short_circuit_policy) {
    Accepted { value: vs, diagnostics: None } => vs.length() == 0
    Rejected { diagnostics: _ } => false
  }
}

test fn witness_sequence_outcome_collects_values() -> Bool {
  match sequence_outcome(
    xs: [outcome_accepted(value: 1), outcome_accepted(value: 2)],
    policy: short_circuit_policy
  ) {
    Accepted { value: vs, diagnostics: None } =>
      (vs.length() == 2) && (vs.first() == 1) && (vs.skip(n: 1).first() == 2)
    Rejected { diagnostics: _ } => false
  }
}

test fn witness_sequence_outcome_short_circuits_on_reject() -> Bool {
  match sequence_outcome(
    xs: [
      outcome_accepted(value: 1),
      outcome_rejected(d: diagnostic_a()),
      outcome_accepted(value: 99)
    ],
    policy: short_circuit_policy
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn witness_sequence_outcome_accumulate_collects_both_values() -> Bool {
  match sequence_outcome(
    xs: [outcome_accepted(value: 1), outcome_accepted(value: 2)],
    policy: accumulate_policy
  ) {
    Accepted { value: vs, diagnostics: None } =>
      (vs.length() == 2) && (vs.first() == 1) && (vs.skip(n: 1).first() == 2)
    Rejected { diagnostics: _ } => false
  }
}

test fn witness_sequence_outcome_accumulate_merges_two_rejections() -> Bool {
  match sequence_outcome(
    xs: [outcome_rejected(d: diagnostic_a()), outcome_rejected(d: diagnostic_b())],
    policy: accumulate_policy
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.tail.length() > 0
  }
}

test fn witness_sequence_outcome_short_circuit_does_not_merge_second_reject() -> Bool {
  match sequence_outcome(
    xs: [outcome_rejected(d: diagnostic_a()), outcome_rejected(d: diagnostic_b())],
    policy: short_circuit_policy
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.tail.length() == 0
  }
}

