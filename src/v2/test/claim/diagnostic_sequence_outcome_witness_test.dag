module v2.test.claim.diagnostic_sequence_outcome_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data short_circuit_policy: v2.std.diagnostic.StageDiagnosticPolicy = v2.std.diagnostic.StageDiagnosticPolicy { accumulation: v2.std.diagnostic.ShortCircuit }
data accumulate_policy: v2.std.diagnostic.StageDiagnosticPolicy = v2.std.diagnostic.StageDiagnosticPolicy { accumulation: v2.std.diagnostic.Accumulate }

fn diagnostic_a() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^sequence_outcome_witness_reason_a
    at: v2.std.diagnostic.port_locus(port: ^sequence_outcome_witness_port_a)
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn diagnostic_b() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^sequence_outcome_witness_reason_b
    at: v2.std.diagnostic.port_locus(port: ^sequence_outcome_witness_port_b)
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

test fn witness_sequence_outcome_empty_accepts() -> Bool {
  match v2.std.diagnostic.sequence_outcome(xs: [], policy: short_circuit_policy) {
    v2.std.diagnostic.Accepted { value: vs, diagnostics: None } => vs.length() == 0
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn witness_sequence_outcome_collects_values() -> Bool {
  match v2.std.diagnostic.sequence_outcome(
    xs: [v2.std.diagnostic.outcome_accepted(value: 1), v2.std.diagnostic.outcome_accepted(value: 2)],
    policy: short_circuit_policy
  ) {
    v2.std.diagnostic.Accepted { value: vs, diagnostics: None } =>
      (vs.length() == 2) && (vs.first() == 1) && (vs.skip(n: 1).first() == 2)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn witness_sequence_outcome_short_circuits_on_reject() -> Bool {
  match v2.std.diagnostic.sequence_outcome(
    xs: [
      v2.std.diagnostic.outcome_accepted(value: 1),
      v2.std.diagnostic.outcome_rejected(d: diagnostic_a()),
      v2.std.diagnostic.outcome_accepted(value: 99)
    ],
    policy: short_circuit_policy
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

test fn witness_sequence_outcome_accumulate_collects_both_values() -> Bool {
  match v2.std.diagnostic.sequence_outcome(
    xs: [v2.std.diagnostic.outcome_accepted(value: 1), v2.std.diagnostic.outcome_accepted(value: 2)],
    policy: accumulate_policy
  ) {
    v2.std.diagnostic.Accepted { value: vs, diagnostics: None } =>
      (vs.length() == 2) && (vs.first() == 1) && (vs.skip(n: 1).first() == 2)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn witness_sequence_outcome_accumulate_merges_two_rejections() -> Bool {
  match v2.std.diagnostic.sequence_outcome(
    xs: [v2.std.diagnostic.outcome_rejected(d: diagnostic_a()), v2.std.diagnostic.outcome_rejected(d: diagnostic_b())],
    policy: accumulate_policy
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: d } => d.tail.length() > 0
  }
}

test fn witness_sequence_outcome_short_circuit_does_not_merge_second_reject() -> Bool {
  match v2.std.diagnostic.sequence_outcome(
    xs: [v2.std.diagnostic.outcome_rejected(d: diagnostic_a()), v2.std.diagnostic.outcome_rejected(d: diagnostic_b())],
    policy: short_circuit_policy
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: d } => d.tail.length() == 0
  }
}

