module v2.test.claim.cli_run_hollowing_ledger_witness

import gunbc.cli_run_hollowing_ledger {
  cli_run_hollowing_ledger_enumeration_holds,
  cli_run_hollowing_ledger_rows,
  cli_run_hollowing_no_unclassified_holds,
  cli_run_hollowing_row_count_baseline
}
import v2.std.algebra { length }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data cli_run_hollowing_ledger_witness_note: String = "Fast-lane receipts (quick-moth-273): cli_run.rs hollowing ledger on dag/gunbc/cli_run_hollowing_ledger.dag — enumeration and no-unclassified predicates fold cli_run_hollowing_ledger_rows (not parallel constants). Bidirectional source-tie execution proof (filesystem_read of cli_run.rs, add/remove fail-closed) lives in long/cli_run_hollowing_ledger_source_tie_witness_test.dag — exceeds per-PR 5s eval budget. Regenerate after cli_run.rs fn-surface edits: python3 scripts/generate_cli_run_hollowing_ledger.py; verify-only: python3 scripts/generate_cli_run_hollowing_ledger.py --verify. Dissolve-on: seed-shrink Chunk F."

test fn witness_cli_run_hollowing_ledger_enumeration_holds() -> Bool {
  cli_run_hollowing_ledger_enumeration_holds()
    && cli_run_hollowing_row_count_baseline == length(cli_run_hollowing_ledger_rows)
}

test fn witness_cli_run_hollowing_ledger_no_unclassified_holds() -> Bool {
  cli_run_hollowing_no_unclassified_holds()
}
