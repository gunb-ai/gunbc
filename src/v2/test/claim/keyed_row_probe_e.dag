module v2.test.claim.keyed_row_probe_e

import v2.test.claim.type_param_binder_frame { tpb_artifact, tpb_std_optional_witness, tpb_src_ingest, tpb_assemble_over, tpb_language }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.infer { infer }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.diagnostic { Accepted, Outcome, Rejected, Some, diagnostics_has_reason, diagnostics_fatal_reason }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.algebra { Cons }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.cross_tree.import_model { V2Tree }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// std.probe_seq peer: a sequence carrier a fold can range over, since std.types is not stubbable here.
fn kp_seq_witness() -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: "module std.probe_seq\n\ntype Seq<T> = | Nil\n", fidelity: Lossless },
    artifact: kp_seq_artifact,
    compilation_unit: ^keyed_row_probe_e_seq_cu,
    source_root: V2Tree
  }
}

data kp_seq_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^keyed_row_probe_seq_artifact,
  file_path: "src/v2/pilot/keyed_row_probe_seq_pilot.dag"
}

fn kp_ingest(src: String) -> List<DagSourceReadWitness> {
  match tpb_src_ingest(src: src) {
    Cons { head: h, tail: t } => Cons { head: h, tail: Cons { head: tpb_std_optional_witness(), tail: Cons { head: kp_seq_witness(), tail: t } } }
    other => other
  }
}

fn kp_assemble(src: String) -> Outcome<ResolvedTree> {
  match tpb_language {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prep, diagnostics: _ } => tpb_assemble_over(ingest: kp_ingest(src: src), prep: prep)
  }
}

fn kp_resolved(src: String) -> Bool {
  match kp_assemble(src: src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn kp_clean(src: String) -> Bool {
  match kp_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: d } => !diagnostics_has_reason(d: d, reason: ^infer_grounding_not_derived)
      }
  }
}

fn kp_rejected(src: String) -> Bool {
  match kp_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}

fn kp_advisory(src: String) -> Bool {
  match kp_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: d } => diagnostics_has_reason(d: d, reason: ^infer_grounding_not_derived)
      }
  }
}

fn kp_fatal_is(src: String, reason: Symbol) -> Bool {
  match kp_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: nd } => diagnostics_fatal_reason(d: nd) == reason
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}

fn kp_rejected_with(src: String, reason: Symbol) -> Bool {
  match kp_assemble(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: nd } => diagnostics_has_reason(d: Some { diagnostics: nd }, reason: reason)
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}

data kp_y: String = "module p\n\nimport std.probe_seq { Seq }\n\ntype Num\n  = N\n  | M\n\nfn y(rows: Seq<Num>) -> Num {\n  N\n}\n"
data kp_e: String = "module p\n\nimport std.optional { Optional, Present }\nimport std.probe_seq { Seq }\n\ntype Sw\n  = On\n  | Off\n\ntype R<K, V> {\n  row_key: K\n  value: V\n}\n\nfn f<K, V>(rows: Seq<R<K, V>>, s: Sw) -> Optional<R<K, V>> {\n  fold(rows, init: none, f: fn(acc, row) {\n    match s {\n      On => Present { value: row }\n      Off => acc\n    }\n  })\n}\n"
data kp_e_absent: String = "module p\n\nimport std.optional { Optional, Present, Absent }\nimport std.probe_seq { Seq }\n\ntype Sw\n  = On\n  | Off\n\ntype R<K, V> {\n  row_key: K\n  value: V\n}\n\nfn f<K, V>(rows: Seq<R<K, V>>, s: Sw) -> Optional<R<K, V>> {\n  fold(rows, init: Absent, f: fn(acc, row) {\n    match s {\n      On => Present { value: row }\n      Off => acc\n    }\n  })\n}\n"
data kp_e_ctl: String = "module p\n\nimport std.optional { Optional, Present }\nimport std.probe_seq { Seq }\n\ntype Sw\n  = On\n  | Off\n\ntype Num\n  = N\n  | M\n\nfn f(rows: Seq<Num>, s: Sw) -> Optional<Num> {\n  fold(rows, init: none, f: fn(acc, row) {\n    match s {\n      On => Present { value: row }\n      Off => acc\n    }\n  })\n}\n"
data kp_f: String = "module p\n\nimport std.optional { Optional, Present, Absent }\n\ntype Ch\n  = Out\n  | Err\n\ntype Sw\n  = On\n  | Off\n\nfn op<T>(value: T) -> Optional<T> {\n  Present { value: value }\n}\n\nfn none_of<T>() -> Optional<T> {\n  Absent\n}\n\nfn g(s: Sw) -> Optional<Ch> {\n  match s {\n    On => op(value: Out)\n    Off => none_of()\n  }\n}\n"
data kp_f_ctl: String = "module p\n\nimport std.optional { Optional, Present, Absent }\n\ntype Ch\n  = Out\n  | Err\n\ntype Sw\n  = On\n  | Off\n\nfn g(s: Sw) -> Optional<Ch> {\n  match s {\n    On => Present { value: Out }\n    Off => Absent\n  }\n}\n"

data kp_a: String = "module p\n\ntype B<T> {\n  low: T\n  high: T\n}\n\nfn d<T>(x: T) -> B<T> {\n  B { low: x, high: x }\n}\n"
data kp_b: String = "module p\n\nimport std.optional { Optional, Present }\n\nfn w<T>(v: T) -> Optional<T> {\n  Present { value: v }\n}\n"
data kp_c: String = "module p\n\nimport std.optional { Optional, Absent }\n\nfn n<T>(v: T) -> Optional<T> {\n  Absent\n}\n"

test fn kp_y_resolves() -> Bool { kp_resolved(src: kp_y) }
test fn kp_y_rejected() -> Bool { kp_rejected(src: kp_y) }
test fn kp_y_advisory() -> Bool { kp_advisory(src: kp_y) }
test fn kp_a_resolves() -> Bool { kp_resolved(src: kp_a) }
test fn kp_a_rejected() -> Bool { kp_rejected(src: kp_a) }
test fn kp_a_advisory() -> Bool { kp_advisory(src: kp_a) }
test fn kp_b_resolves() -> Bool { kp_resolved(src: kp_b) }
test fn kp_b_rejected() -> Bool { kp_rejected(src: kp_b) }
test fn kp_b_advisory() -> Bool { kp_advisory(src: kp_b) }
test fn kp_c_resolves() -> Bool { kp_resolved(src: kp_c) }
test fn kp_c_rejected() -> Bool { kp_rejected(src: kp_c) }
test fn kp_c_advisory() -> Bool { kp_advisory(src: kp_c) }
test fn kp_e_resolves() -> Bool { kp_resolved(src: kp_e) }
test fn kp_e_rejected() -> Bool { kp_rejected(src: kp_e) }
test fn kp_e_advisory() -> Bool { kp_advisory(src: kp_e) }
test fn kp_e_absent_resolves() -> Bool { kp_resolved(src: kp_e_absent) }
test fn kp_e_absent_rejected() -> Bool { kp_rejected(src: kp_e_absent) }
test fn kp_e_absent_advisory() -> Bool { kp_advisory(src: kp_e_absent) }
test fn kp_e_ctl_resolves() -> Bool { kp_resolved(src: kp_e_ctl) }
test fn kp_e_ctl_rejected() -> Bool { kp_rejected(src: kp_e_ctl) }
test fn kp_e_ctl_advisory() -> Bool { kp_advisory(src: kp_e_ctl) }
test fn kp_f_resolves() -> Bool { kp_resolved(src: kp_f) }
test fn kp_f_rejected() -> Bool { kp_rejected(src: kp_f) }
test fn kp_f_advisory() -> Bool { kp_advisory(src: kp_f) }
test fn kp_f_ctl_resolves() -> Bool { kp_resolved(src: kp_f_ctl) }
test fn kp_f_ctl_rejected() -> Bool { kp_rejected(src: kp_f_ctl) }
test fn kp_f_ctl_advisory() -> Bool { kp_advisory(src: kp_f_ctl) }
test fn kp_e_fatal_grounding_not_derived() -> Bool { kp_fatal_is(src: kp_e, reason: ^infer_grounding_not_derived) }
test fn kp_e_has_grounding_not_derived() -> Bool { kp_rejected_with(src: kp_e, reason: ^infer_grounding_not_derived) }
test fn kp_e_fatal_reason_fold_carrier_type() -> Bool { kp_fatal_is(src: kp_e, reason: ^infer_reason_fold_carrier_type_not_derived) }
test fn kp_e_has_reason_fold_carrier_type() -> Bool { kp_rejected_with(src: kp_e, reason: ^infer_reason_fold_carrier_type_not_derived) }
test fn kp_e_fatal_branch_cond_not_bool() -> Bool { kp_fatal_is(src: kp_e, reason: ^infer_branch_cond_not_bool) }
test fn kp_e_has_branch_cond_not_bool() -> Bool { kp_rejected_with(src: kp_e, reason: ^infer_branch_cond_not_bool) }
test fn kp_e_absent_fatal_grounding_not_derived() -> Bool { kp_fatal_is(src: kp_e_absent, reason: ^infer_grounding_not_derived) }
test fn kp_e_absent_has_grounding_not_derived() -> Bool { kp_rejected_with(src: kp_e_absent, reason: ^infer_grounding_not_derived) }
test fn kp_e_absent_fatal_reason_fold_carrier_type() -> Bool { kp_fatal_is(src: kp_e_absent, reason: ^infer_reason_fold_carrier_type_not_derived) }
test fn kp_e_absent_has_reason_fold_carrier_type() -> Bool { kp_rejected_with(src: kp_e_absent, reason: ^infer_reason_fold_carrier_type_not_derived) }
test fn kp_e_absent_fatal_branch_cond_not_bool() -> Bool { kp_fatal_is(src: kp_e_absent, reason: ^infer_branch_cond_not_bool) }
test fn kp_e_absent_has_branch_cond_not_bool() -> Bool { kp_rejected_with(src: kp_e_absent, reason: ^infer_branch_cond_not_bool) }
test fn kp_f_fatal_grounding_not_derived() -> Bool { kp_fatal_is(src: kp_f, reason: ^infer_grounding_not_derived) }
test fn kp_f_has_grounding_not_derived() -> Bool { kp_rejected_with(src: kp_f, reason: ^infer_grounding_not_derived) }
test fn kp_f_fatal_reason_fold_carrier_type() -> Bool { kp_fatal_is(src: kp_f, reason: ^infer_reason_fold_carrier_type_not_derived) }
test fn kp_f_has_reason_fold_carrier_type() -> Bool { kp_rejected_with(src: kp_f, reason: ^infer_reason_fold_carrier_type_not_derived) }
test fn kp_f_fatal_branch_cond_not_bool() -> Bool { kp_fatal_is(src: kp_f, reason: ^infer_branch_cond_not_bool) }
