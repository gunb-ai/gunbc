module v2.test.claim.source_root_tagging

import gunbc.source_root_read { SourceRootFile }
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootArgumentAdmitted,
  SourceRootArgumentUnrecognized,
  SourceRootIngest,
  SourceRootIngestFromFilesBuilt,
  SourceRootIngestFromFilesUnrecognizedRoot,
  admit_source_root_argument,
  source_root_ingest_from_files,
  source_root_set_from_ingest
}
import v2.std.artifact { Artifact, SourceFile }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.cross_tree.import_model { DagTree, V2Tree, source_root_set_contains }
import std.algebra { Cons, Empty }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data sr_tag_v2_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: "module v2.std.sr_tag_fixture", fidelity: Lossless },
  artifact: Artifact {
    kind: SourceFile,
    id: ^sr_tag_v2_artifact,
    file_path: "src/v2/std/sr_tag_fixture.dag"
  },
  compilation_unit: ^sr_tag_v2_cu,
  source_root: V2Tree
}

data sr_tag_dag_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: "module std.sr_tag_fixture", fidelity: Lossless },
  artifact: Artifact {
    kind: SourceFile,
    id: ^sr_tag_dag_artifact,
    file_path: "dag/std/sr_tag_fixture.dag"
  },
  compilation_unit: ^sr_tag_dag_cu,
  source_root: DagTree
}

data sr_tag_mixed_ingest: SourceRootIngest = [sr_tag_v2_read, sr_tag_dag_read]
data sr_tag_v2_only_ingest: SourceRootIngest = [sr_tag_v2_read]

test fn a_dag_source_root_argument_is_dag_tree() -> Bool {
  match admit_source_root_argument(argument: "dag") {
    SourceRootArgumentAdmitted { tree: DagTree } => true
    SourceRootArgumentAdmitted { tree: V2Tree } => false
    SourceRootArgumentUnrecognized { argument: _ } => false
  }
}

test fn a_v2_source_root_argument_is_v2_tree() -> Bool {
  match admit_source_root_argument(argument: "src/v2") {
    SourceRootArgumentAdmitted { tree: V2Tree } => true
    SourceRootArgumentAdmitted { tree: DagTree } => false
    SourceRootArgumentUnrecognized { argument: _ } => false
  }
}

test fn a_copied_single_root_argument_is_unrecognized() -> Bool {
  match admit_source_root_argument(argument: "/tmp/copied-closure") {
    SourceRootArgumentUnrecognized { argument: argument } => argument == "/tmp/copied-closure"
    SourceRootArgumentAdmitted { tree: _ } => false
  }
}

fn sr_file(path: String, origin: String) -> SourceRootFile {
  SourceRootFile { path: path, content: "module fixture.sr_tag\n", origin: origin }
}

test fn a_dag_file_whose_path_contains_src_is_still_dag_tree() -> Bool {
  match source_root_ingest_from_files(
    files: [sr_file(path: "dag/pkg/src/leaf.dag", origin: "dag")]
  ) {
    SourceRootIngestFromFilesUnrecognizedRoot { argument: _, path: _ } => false
    SourceRootIngestFromFilesBuilt { ingest: ingest } =>
      match ingest {
        Empty => false
        Cons { head: read, tail: rest } =>
          match rest {
            Empty => match read.source_root {
              DagTree => true
              V2Tree => false
            }
            Cons { head: _, tail: _ } => false
          }
      }
  }
}

test fn ingest_from_an_unrecognized_origin_refuses() -> Bool {
  match source_root_ingest_from_files(
    files: [sr_file(path: "/tmp/copied-closure/src/v2/std/algebra.dag", origin: "/tmp/copied-closure")]
  ) {
    SourceRootIngestFromFilesUnrecognizedRoot { argument: argument, path: path } =>
      (argument == "/tmp/copied-closure")
        && (path == "/tmp/copied-closure/src/v2/std/algebra.dag")
    SourceRootIngestFromFilesBuilt { ingest: _ } => false
  }
}

test fn two_root_origins_tag_each_tree() -> Bool {
  match source_root_ingest_from_files(
    files: [
      sr_file(path: "dag/std/algebra.dag", origin: "dag"),
      sr_file(path: "src/v2/std/algebra.dag", origin: "src/v2")
    ]
  ) {
    SourceRootIngestFromFilesUnrecognizedRoot { argument: _, path: _ } => false
    SourceRootIngestFromFilesBuilt { ingest: ingest } =>
      source_root_set_contains(roots: source_root_set_from_ingest(ingest: ingest), r: DagTree)
        && source_root_set_contains(roots: source_root_set_from_ingest(ingest: ingest), r: V2Tree)
  }
}

test fn source_root_tag_carried_and_folded_to_grounded_set() -> Bool {
  let mixed = source_root_set_from_ingest(ingest: sr_tag_mixed_ingest)
  let v2_only = source_root_set_from_ingest(ingest: sr_tag_v2_only_ingest)
  source_root_set_contains(roots: mixed, r: V2Tree)
    && source_root_set_contains(roots: mixed, r: DagTree)
    && source_root_set_contains(roots: v2_only, r: V2Tree)
    && !source_root_set_contains(roots: v2_only, r: DagTree)
}
