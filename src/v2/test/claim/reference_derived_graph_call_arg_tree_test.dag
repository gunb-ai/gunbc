module v2.test.claim.reference_derived_graph_call_arg_tree

import std.types { Int }
import v2.extdeps.languages.dag {
  parse_production_captured_child_optional,
  parse_production_emitted_identity_optional,
  parse_qualified_name_segments_from_capture,
  qualified_name_from_module_node,
  qualified_name_from_symbol_segments,
}
import v2.compiler.reference_site_collector { collect_module_reference_sites }
import v2.lens.module_graph {
  LocatedModuleRoot,
  ModuleDependencyEdge,
  reference_derived_edges_from_located_roots,
}
import v2.std.algebra { length, list_snoc_item }
import v2.std.collection { List }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus,
  outcome_accepted
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.node { Edge, Node }
import v2.std.optional { Absent, Present }
import v2.std.qualified_name { QualifiedName, qualified_name_to_dotted_string }
import v2.std.text { String }
import v2.test.claim.reference_derived_graph_fixture {
  consumer_body_value_path,
  consumer_call_only_path,
  consumer_type_only_path,
  provider_module,
  provider_path,
  xl4_fixture_trees,
  xl4_item_at,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// COLLECTOR-ROUTE DEFICIENCY PROBES over the shared ingest xl4_fixture_trees. The production
// edge producer is the collector, not a parse-tree qualified-name walk. Call-argument == 0 is
// tree-side (eager-raven-113). Qualified type-position is the dotted-reference capability.

fn ca_edge_count(edges: List<ModuleDependencyEdge>, path: String, target: String) -> Int {
  length(xs: edges |> filter(e => e.path == path && e.target_module == target))
}

fn ca_edges_from_pair(
  provider_root: Node,
  consumer_path: String,
  consumer_root: Node
) -> List<ModuleDependencyEdge> {
  reference_derived_edges_from_located_roots(
    items: [
      LocatedModuleRoot { path: provider_path, root: provider_root },
      LocatedModuleRoot { path: consumer_path, root: consumer_root }
    ]
  ).edges
}

data ca_ingest_refused_count: Int = -1

fn ca_pair_edge_count_from_trees(
  trees: Outcome<List<LocatedModuleRoot>>,
  consumer_path: String
) -> Int {
  match trees {
    Rejected { diagnostics: _ } => ca_ingest_refused_count
    Accepted { value: items, diagnostics: _ } =>
      match xl4_item_at(items: items, path: provider_path) {
        Absent => ca_ingest_refused_count
        Present { value: provider } =>
          match xl4_item_at(items: items, path: consumer_path) {
            Absent => ca_ingest_refused_count
            Present { value: consumer } =>
              ca_edge_count(
                edges: ca_edges_from_pair(
                  provider_root: provider.root,
                  consumer_path: consumer_path,
                  consumer_root: consumer.root
                ),
                path: consumer_path,
                target: provider_module
              )
          }
      }
  }
}

data ca_provided_value_dotted: String = "test.fixture.reference_derived_graph.provider.provided_value"

data ca_provided_marker_dotted: String = "test.fixture.reference_derived_graph.provider.ProvidedMarker"

fn ca_parse_site_count(consumer_path: String, needle: String) -> Int {
  match xl4_fixture_trees().parsed {
    Rejected { diagnostics: _ } => ca_ingest_refused_count
    Accepted { value: items, diagnostics: _ } =>
      match xl4_item_at(items: items, path: consumer_path) {
        Absent => ca_ingest_refused_count
        Present { value: item } =>
          length(
            xs: collect_module_reference_sites(root: item.root).sites
              |> filter(site => qualified_name_to_dotted_string(qn: site.spelling) == needle)
          )
      }
  }
}

fn ca_parse_call_arg_edge_count() -> Int {
  ca_parse_site_count(consumer_path: consumer_call_only_path, needle: ca_provided_value_dotted)
}

fn ca_normalized_call_arg_edge_count() -> Int {
  ca_pair_edge_count_from_trees(trees: xl4_fixture_trees().located, consumer_path: consumer_call_only_path)
}

fn ca_parse_type_pos_edge_count() -> Int {
  ca_parse_site_count(consumer_path: consumer_type_only_path, needle: ca_provided_marker_dotted)
}

fn ca_normalized_type_pos_edge_count() -> Int {
  ca_pair_edge_count_from_trees(trees: xl4_fixture_trees().located, consumer_path: consumer_type_only_path)
}

fn ca_parse_body_value_edge_count() -> Int {
  ca_parse_site_count(consumer_path: consumer_body_value_path, needle: ca_provided_value_dotted)
}

fn ca_normalized_body_value_edge_count() -> Int {
  ca_pair_edge_count_from_trees(trees: xl4_fixture_trees().located, consumer_path: consumer_body_value_path)
}

test fn call_argument_only_reference_is_missing_from_parse_tree_today_holds() -> Bool {
  ca_parse_call_arg_edge_count() == 0
}

test fn call_argument_only_reference_is_missing_from_normalized_tree_today_holds() -> Bool {
  ca_normalized_call_arg_edge_count() == 0
}

test fn type_position_only_is_missing_from_parse_tree_today_holds() -> Bool {
  ca_parse_type_pos_edge_count() == 0
}

test fn type_position_only_is_missing_from_normalized_tree_today_holds() -> Bool {
  ca_normalized_type_pos_edge_count() == 0
}

test fn body_value_outside_call_is_missing_from_parse_tree_today_holds() -> Bool {
  ca_parse_body_value_edge_count() == 0
}

test fn body_value_outside_call_is_missing_from_normalized_tree_today_holds() -> Bool {
  ca_normalized_body_value_edge_count() == 0
}

data ca_no_qn_sites: List<QualifiedName> = []

fn ca_qn_from_qualified_name_production(production_node: Node, module_root: Node) -> Outcome<QualifiedName> {
  match parse_production_captured_child_optional(node: production_node) {
    Absent =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: ^ca_parse_qn_oracle_capture_missing,
            at: node_locus(node: production_node),
            correction: Unavailable { reason: ExternalContractUnknown }
          }
        )
      }
    Present { value: capture } =>
      match parse_qualified_name_segments_from_capture(qn_capture: capture, root: module_root) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: segments, diagnostics: _ } =>
          qualified_name_from_symbol_segments(segments: segments, root: module_root)
      }
  }
}

fn ca_collect_non_import_qn_sites_from_edges(
  edges: List<Edge>,
  module_root: Node,
  module_qn: QualifiedName,
  acc: List<QualifiedName>
) -> Outcome<List<QualifiedName>> {
  match edges |> first {
    Absent => outcome_accepted(value: acc)
    Present { value: edge } =>
      match ca_collect_non_import_qn_sites_from_node(
        node: edge.target,
        module_root: module_root,
        module_qn: module_qn,
        acc: acc
      ) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: next_acc, diagnostics: _ } =>
          ca_collect_non_import_qn_sites_from_edges(
            edges: edges |> skip(1),
            module_root: module_root,
            module_qn: module_qn,
            acc: next_acc
          )
      }
  }
}

fn ca_collect_non_import_qn_sites_from_node(
  node: Node,
  module_root: Node,
  module_qn: QualifiedName,
  acc: List<QualifiedName>
) -> Outcome<List<QualifiedName>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_import_decl {
        outcome_accepted(value: acc)
      } else if id == ^dag_surface_qualified_name {
        match ca_qn_from_qualified_name_production(production_node: node, module_root: module_root) {
          Rejected { diagnostics: d } => Rejected { diagnostics: d }
          Accepted { value: site_qn, diagnostics: _ } =>
            ca_collect_non_import_qn_sites_from_edges(
              edges: node.children,
              module_root: module_root,
              module_qn: module_qn,
              acc: if site_qn == module_qn {
                acc
              } else {
                list_snoc_item(xs: acc, item: site_qn)
              }
            )
        }
      } else {
        ca_collect_non_import_qn_sites_from_edges(
          edges: node.children,
          module_root: module_root,
          module_qn: module_qn,
          acc: acc
        )
      }
    Absent =>
      ca_collect_non_import_qn_sites_from_edges(
        edges: node.children,
        module_root: module_root,
        module_qn: module_qn,
        acc: acc
      )
  }
}

fn ca_collect_non_import_qn_sites(module_root: Node) -> Outcome<List<QualifiedName>> {
  match qualified_name_from_module_node(root: module_root) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: module_qn, diagnostics: _ } =>
      ca_collect_non_import_qn_sites_from_node(
        node: module_root,
        module_root: module_root,
        module_qn: module_qn,
        acc: ca_no_qn_sites
      )
  }
}

fn ca_parse_qn_walk_site_count(consumer_path: String, needle: String) -> Int {
  match xl4_fixture_trees().parsed {
    Rejected { diagnostics: _ } => ca_ingest_refused_count
    Accepted { value: items, diagnostics: _ } =>
      match xl4_item_at(items: items, path: consumer_path) {
        Absent => ca_ingest_refused_count
        Present { value: item } =>
          match ca_collect_non_import_qn_sites(module_root: item.root) {
            Rejected { diagnostics: _ } => ca_ingest_refused_count
            Accepted { value: sites, diagnostics: _ } =>
              length(xs: sites |> filter(qn => qualified_name_to_dotted_string(qn: qn) == needle))
          }
      }
  }
}

test fn parse_qn_walk_sees_type_position_provided_marker_holds() -> Bool {
  ca_parse_qn_walk_site_count(
    consumer_path: consumer_type_only_path,
    needle: ca_provided_marker_dotted
  ) > 0
}

test fn parse_qn_walk_does_not_see_body_value_provided_value_today_holds() -> Bool {
  ca_parse_qn_walk_site_count(
    consumer_path: consumer_body_value_path,
    needle: ca_provided_value_dotted
  ) == 0
}

test fn parse_qn_walk_does_not_see_call_arg_provided_value_today_holds() -> Bool {
  ca_parse_qn_walk_site_count(
    consumer_path: consumer_call_only_path,
    needle: ca_provided_value_dotted
  ) == 0
}
