module v2.test.claim.declared_source_ref_selection_test

import v2.compiler.source_authority {
  ModuleStorageIndex,
  SourceRef,
  module_storage_parsed_binding,
  source_ref_for_storage_path
}
import v2.lens.affected_set.declared_source_ref_selection {
  DeclaredSourceRefsTouched,
  DeclaredSourceRefsUntouched,
  DeclaredSourceRefsUnresolved,
  NoDeclaredSourceRefs,
  declared_source_refs_selection_axis
}
import v2.std.artifact { Artifact, SourceFile }
import v2.std.collection { List }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.logic { Bool }
import v2.std.provenance { span_index_empty }
import v2.std.qualified_name { qualified_name_from_string_segments }
import std.algebra { Cons, Empty }

data dsr_fixture_index: ModuleStorageIndex = Cons {
  head: module_storage_parsed_binding(
    module: qualified_name_from_string_segments(segments: ["v2", "compiler", "normalize"]),
    artifact: Artifact {
      kind: SourceFile,
      id: ^src_v2_compiler_03_normalize_dag,
      file_path: "src/v2/compiler/03_normalize.dag"
    },
    span_index: span_index_empty(),
    source_root: V2Tree
  ),
  tail: Empty
}

data dsr_normalize_ref: SourceRef = source_ref_for_storage_path(path: "src/v2/compiler/03_normalize.dag")

data dsr_fixture_refs: List<SourceRef> = [dsr_normalize_ref]

test fn declared_source_refs_touched_when_emitter_changes() -> Bool {
  match declared_source_refs_selection_axis(
    index: dsr_fixture_index,
    refs: dsr_fixture_refs,
    touched_paths: ["src/v2/compiler/03_normalize.dag"]
  ) {
    DeclaredSourceRefsTouched => true
    _ => false
  }
}

test fn declared_source_refs_untouched_on_unrelated_path() -> Bool {
  match declared_source_refs_selection_axis(
    index: dsr_fixture_index,
    refs: dsr_fixture_refs,
    touched_paths: ["src/v2/std/logic.dag"]
  ) {
    DeclaredSourceRefsUntouched => true
    _ => false
  }
}

test fn declared_source_refs_unresolved_when_index_misses_path() -> Bool {
  match declared_source_refs_selection_axis(
    index: Empty,
    refs: dsr_fixture_refs,
    touched_paths: ["src/v2/compiler/03_normalize.dag"]
  ) {
    DeclaredSourceRefsUnresolved { count: 1 } => true
    _ => false
  }
}

test fn declared_source_refs_absent_when_list_empty() -> Bool {
  match declared_source_refs_selection_axis(
    index: dsr_fixture_index,
    refs: [],
    touched_paths: ["src/v2/compiler/03_normalize.dag"]
  ) {
    NoDeclaredSourceRefs => true
    _ => false
  }
}
