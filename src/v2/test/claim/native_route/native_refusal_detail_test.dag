module v2.test.claim.native_route.native_refusal_detail

import gunbc.witness_v2_native_route { NativeRouteMemberRow, native_route_member_row_text }
import v2.compiler.compile {
  NativeLaneModuleContextRowsDecided,
  NativeLaneModuleResolution,
  NativeLaneModuleResolveRowsDecided,
  NativeLaneModuleResolved,
  NativeLaneUniverseModule,
  NativeTestContext,
  native_lane_file_refusal_index,
  native_lane_module_resolution,
  native_test_context_from_ingest
}
import v2.compiler.native_test_vocabulary {
  NativeTestFileRefusal,
  NativeTestPassed,
  NativeTestRefused,
  NativeTestReturnedFalse,
  NativeTestReturnedOther,
  NativeTestStage,
  NativeTestStageContext,
  NativeTestStageEntry,
  NativeTestStageEval,
  NativeTestStagePrepare,
  NativeTestVerdict
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.algebra { any, count_where, fold_list, length }
import v2.std.collection { Map }
import v2.std.integer { Int }
import std.algebra { Cons, Empty }
import v2.std.artifact { Artifact, SourceFile }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic {
  Accepted,
  DeclarationLocus,
  Diagnostic,
  InvariantPortLocus,
  NodeLocus,
