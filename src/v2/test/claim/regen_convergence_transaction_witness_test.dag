test fn affected_bound_refusal_cannot_widen_into_stage_planning() -> Bool {
  match regen_admit_affected_bound(
    bound: AffectedCandidatePopulationRefused { reason: "edited module unlocatable" },
    changed: []
  ) {
    RegenAffectedBoundRefused { refusal: AffectedSetBoundRefused { reason: _ } } => true
    _ => false
  }
}

test fn stage_population_outside_the_affected_bound_refuses() -> Bool {
  let inside = fixture_surface(module: "compiler.inside", path: "inside.rs", role: GenerationInput, seed: SeedEmbedded)
  let outside = fixture_surface(module: "compiler.outside", path: "outside.rs", role: GenerationInput, seed: SeedEmbedded)
  match regen_admit_affected_bound(
    bound: AffectedCandidatePopulation { projected_paths: ["inside.rs"] },
    changed: [inside, outside]
  ) {
    RegenAffectedBoundRefused {
      refusal: AffectedSetStagePopulationDisagrees { changed: changed, outside_bound: outside_bound }
    } => count(changed) == 2 && count(outside_bound) == 1
    _ => false
  }
}

test fn whole_population_bound_admits_the_observed_stage_population() -> Bool {
  let row = fixture_surface(module: "compiler.any", path: "any.rs", role: GenerationInput, seed: SeedEmbedded)
  match regen_admit_affected_bound(bound: CompleteCandidatePopulation, changed: [row]) {
    RegenAffectedBoundAdmitted => true
    _ => false
  }
}

test fn repeated_seed_and_candidate_state_is_a_cycle_refusal() -> Bool {
  match regen_admit_generation_progress(
    seen_state_keys: ["seed-a:tree-a"],
    seed_digest: "seed-a",
    candidate_tree_digest: "tree-a",
    ordinal: 2,
    bound: 8
  ) {
    RegenGenerationProgressRefused { refusal: GenerationCycleDetected { seed_digest: _, candidate_tree_digest: _ } } => true
    _ => false
  }
}

test fn finite_generation_bound_refuses_separately_from_a_cycle() -> Bool {
  match regen_admit_generation_progress(
    seen_state_keys: [],
    seed_digest: "seed-new",
    candidate_tree_digest: "tree-new",
    ordinal: 8,
    bound: 8
  ) {
    RegenGenerationProgressRefused { refusal: GenerationBoundExceeded { bound: 8 } } => true
    _ => false
  }
}

test fn single_pass_producer_plus_old_dependent_refuses_the_seed_build() -> Bool {
  let producer = fixture_surface(
    module: "compiler.transport",
    path: "compiler_transport.rs",
    role: GenerationInput,
    seed: SeedEmbedded
  )
  let old_dependent = fixture_surface(
    module: "std.dependent",
    path: "std_dependent.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  match regen_execute_convergence_fixture(fixture: RegenConvergenceFixture {
    g0_changed: [producer, old_dependent],
    producer_stage_build: RegenStageBuildFailed { reason: "producer installed beside old dependent" },
    g1_changed: [],
    subject_stage_build: RegenStageBuildPassed,
    g2_changed: []
  }) {
    RegenFixtureRefused { refusal: StageExecutionRefused { refusal: StageSeedBuildRefused { ordinal: 1, reason: _ } } } => true
    _ => false
  }
}

test fn staged_producer_then_complete_subject_cut_reaches_zero_drift() -> Bool {
  let producer = fixture_surface(
    module: "compiler.transport",
    path: "compiler_transport.rs",
    role: GenerationInput,
    seed: SeedEmbedded
  )
  let lower = fixture_surface(
    module: "std.lower",
    path: "std_lower.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  let dependent = fixture_surface(
    module: "std.dependent",
    path: "std_dependent.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  match regen_execute_convergence_fixture(fixture: RegenConvergenceFixture {
    g0_changed: [producer, lower],
    producer_stage_build: RegenStageBuildPassed,
    g1_changed: [lower, dependent],
    subject_stage_build: RegenStageBuildPassed,
    g2_changed: []
  }) {
    RegenFixtureReachedFixedPoint { stage_kinds: kinds } =>
      count(kinds) == 2
        && kinds |> any(kind => match kind { PromoteGenerationInputs => true _ => false })
        && kinds |> any(kind => match kind { InstallSeedCompatibilityCut => true _ => false })
    RegenFixtureRefused { refusal: _ } => false
  }
}

fn one_identity() -> RegenSurfaceIdentity {
  RegenSurfaceIdentity { declaring_module: "std.subject", projected_path: "std_subject.rs" }
}

fn second_identity() -> RegenSurfaceIdentity {
  RegenSurfaceIdentity { declaring_module: "std.dependent", projected_path: "std_dependent.rs" }
}

test fn stale_candidate_from_g0_cannot_install_after_g1() -> Bool {
  match regen_admit_candidate_generation(observation: RegenCandidateGenerationObservation {
    planned_surfaces: [one_identity(), second_identity()],
    current_seed_digest: "g1",
    manifest_producer_seed_digest: "g0",
    observed_candidate_digest: "candidate-g0"
  }) {
    RegenCandidateGenerationRefused { refusal: CandidateStaleAfterProducerRebuild { planned_surfaces: surfaces, observed_generation_id: _, current_generation_id: _, observed_candidate_digest: _ } } =>
      count(surfaces) == 2
        && surfaces |> any(surface => surface.projected_path == "std_subject.rs")
        && surfaces |> any(surface => surface.projected_path == "std_dependent.rs")
    _ => false
  }
}

test fn a_planned_surface_with_no_observed_effect_refuses_before_the_digest_check() -> Bool {
  let admission = regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity(), second_identity()],
    executed: [one_identity()],
    expected_candidate_digest: "candidate",
    observed_candidate_digest: "candidate",
    build_terminal: RegenStageBuildPassed
  })
  match admission {
    RegenStageExecutionRefused { refusal: StagePlannedExecutedMismatch { planned: planned, executed: executed } } =>
      count(planned) == 2
        && count(executed) == 1
        && regen_stage_execution_admission_label(admission: admission) == "StagePlannedExecutedMismatch"
    _ => false
  }
}

test fn a_population_refusal_renders_both_populations_not_only_its_name() -> Bool {
  let admission = regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity(), second_identity()],
    expected_candidate_digest: "candidate",
    observed_candidate_digest: "candidate",
    build_terminal: RegenStageBuildPassed
  })
  regen_stage_execution_admission_detail(admission: admission)
    == "planned=[std_subject.rs] executed=[std_subject.rs std_dependent.rs]"
}

test fn an_admitted_stage_renders_no_refusal_detail() -> Bool {
  let admission = regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity()],
    expected_candidate_digest: "candidate",
    observed_candidate_digest: "candidate",
    build_terminal: RegenStageBuildPassed
  })
  regen_stage_execution_admission_detail(admission: admission) == ""
}

test fn an_observed_effect_outside_the_plan_refuses_in_the_other_direction() -> Bool {
  match regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity(), second_identity()],
    expected_candidate_digest: "candidate",
    observed_candidate_digest: "candidate",
    build_terminal: RegenStageBuildPassed
  }) {
    RegenStageExecutionRefused { refusal: StagePlannedExecutedMismatch { planned: planned, executed: executed } } =>
      count(planned) == 1 && count(executed) == 2
    _ => false
  }
}

test fn tampered_candidate_digest_refuses_before_admission() -> Bool {
  match regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity(), second_identity()],
    executed: [one_identity(), second_identity()],
    expected_candidate_digest: "expected",
    observed_candidate_digest: "tampered",
    build_terminal: RegenStageBuildPassed
  }) {
    RegenStageExecutionRefused { refusal: InstalledDigestMismatch { surfaces: surfaces, expected: _, observed: _ } } =>
      count(surfaces) == 2
        && surfaces |> any(surface => surface.projected_path == "std_subject.rs")
        && surfaces |> any(surface => surface.projected_path == "std_dependent.rs")
    _ => false
  }
}

test fn stage_build_failure_is_a_typed_transaction_refusal() -> Bool {
  match regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity()],
    expected_candidate_digest: "candidate",
    observed_candidate_digest: "candidate",
    build_terminal: RegenStageBuildFailed { reason: "old dependent rejects producer output" }
  }) {
    RegenStageExecutionRefused { refusal: StageSeedBuildRefused { ordinal: _, reason: _ } } => true
    _ => false
  }
}

test fn matching_stage_population_digest_generation_and_build_are_admitted() -> Bool {
  match regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity()],
    expected_candidate_digest: "candidate",
    observed_candidate_digest: "candidate",
    build_terminal: RegenStageBuildPassed
  }) {
    RegenStageExecutionAdmitted => true
    RegenStageExecutionRefused { refusal: _ } => false
  }
}


test fn an_admitted_surface_in_neither_planned_nor_deferred_refuses_by_identity() -> Bool {
  match regen_admit_install_boundary_population(observation: RegenInstallBoundaryObservation {
    admitted: [one_identity(), second_identity()],
    planned: [one_identity()],
    deferred: []
  }) {
    RegenPopulationRefused { refusal: StagePartitionPopulationDisagrees {
      admitted_without_partition: dropped, partition_without_admitted: extra, planned_and_deferred: both
    } } =>
      count(dropped) == 1
        && dropped |> any(row => row.projected_path == "std_dependent.rs")
        && count(extra) == 0
        && count(both) == 0
    _ => false
  }
}

// THE DIRECTION A COUNT CANNOT SEE. One admitted surface is missing from the partition and one
// partition member was never admitted, so the two totals agree exactly. A cardinality check reports
// this population as covered; the identity join names both residues instead.
test fn equal_counts_with_different_identities_still_refuses_both_directions() -> Bool {
  match regen_admit_install_boundary_population(observation: RegenInstallBoundaryObservation {
    admitted: [one_identity()],
    planned: [second_identity()],
    deferred: []
  }) {
    RegenPopulationRefused { refusal: StagePartitionPopulationDisagrees {
      admitted_without_partition: dropped, partition_without_admitted: extra, planned_and_deferred: _
    } } =>
      count(dropped) == 1
        && dropped |> any(row => row.projected_path == "std_subject.rs")
        && count(extra) == 1
        && extra |> any(row => row.projected_path == "std_dependent.rs")
    _ => false
  }
}

test fn one_surface_both_planned_and_deferred_refuses_where_a_union_would_absorb_it() -> Bool {
  match regen_admit_install_boundary_population(observation: RegenInstallBoundaryObservation {
    admitted: [one_identity()],
    planned: [one_identity()],
    deferred: [one_identity()]
  }) {
    RegenPopulationRefused { refusal: StagePartitionPopulationDisagrees {
      admitted_without_partition: _, partition_without_admitted: _, planned_and_deferred: both
    } } => count(both) == 1 && both |> any(row => row.projected_path == "std_subject.rs")
    _ => false
  }
}

test fn a_partition_that_exactly_covers_the_admitted_population_is_admitted() -> Bool {
  match regen_admit_install_boundary_population(observation: RegenInstallBoundaryObservation {
    admitted: [one_identity(), second_identity()],
    planned: [one_identity()],
    deferred: [second_identity()]
  }) {
    RegenPopulationAdmitted => true
    _ => false
  }
}

fn disposition_is_terminal(d: RegenSurfaceDisposition) -> Bool {
  match regen_disposition_terminality(disposition: d) {
    DispositionTerminal => true
    DispositionNonTerminal => false
  }
}

test fn deferred_is_the_only_nonterminal_disposition() -> Bool {
  disposition_is_terminal(d: SurfaceApplied { installed_digest: "digest" })
    && disposition_is_terminal(d: SurfaceSuperseded { by_generation_id: "g2" })
    && disposition_is_terminal(d: SurfaceDispositionRefused { reason: "refused" })
    && !disposition_is_terminal(d: SurfaceDeferred { reason: AwaitingPromotedProducer })
}

// A LINEAGE THAT NAMES EVERY ADMITTED SURFACE AND STILL ENDS IN A PROMISE. The population join is
// satisfied in both directions here -- this is exactly the case a population equality alone reports
// as complete, and it is why terminality is a separate conjunct rather than a property of the join.
test fn a_lineage_terminating_in_deferred_is_unfinished_not_done() -> Bool {
  let admission = regen_admit_transaction_lineage(
    initial_admitted: [one_identity(), second_identity()],
    lineage: [
      RegenSurfaceLineage { identity: one_identity(), disposition: SurfaceApplied { installed_digest: "d1" } },
      RegenSurfaceLineage { identity: second_identity(), disposition: SurfaceDeferred { reason: AwaitingPromotedProducer } }
    ]
  )
  match admission {
    RegenPopulationRefused { refusal: SurfaceLineageUnfinished { surfaces: surfaces } } =>
      count(surfaces) == 1
        && surfaces |> any(row => row.projected_path == "std_dependent.rs")
        && regen_population_admission_label(admission: admission) == "SurfaceLineageUnfinished"
    _ => false
  }
}

test fn an_admitted_surface_absent_from_the_terminal_lineage_refuses() -> Bool {
  match regen_admit_transaction_lineage(
    initial_admitted: [one_identity(), second_identity()],
    lineage: [
      RegenSurfaceLineage { identity: one_identity(), disposition: SurfaceApplied { installed_digest: "d1" } }
    ]
  ) {
    RegenPopulationRefused { refusal: TransactionLineagePopulationDisagrees {
      admitted_without_lineage: missing, lineage_without_admitted: extra
    } } => count(missing) == 1 && count(extra) == 0
    _ => false
  }
}

test fn a_lineage_row_that_was_never_admitted_refuses_in_the_other_direction() -> Bool {
  match regen_admit_transaction_lineage(
    initial_admitted: [one_identity()],
    lineage: [
      RegenSurfaceLineage { identity: one_identity(), disposition: SurfaceApplied { installed_digest: "d1" } },
      RegenSurfaceLineage { identity: second_identity(), disposition: SurfaceSuperseded { by_generation_id: "g2" } }
    ]
  ) {
    RegenPopulationRefused { refusal: TransactionLineagePopulationDisagrees {
      admitted_without_lineage: missing, lineage_without_admitted: extra
    } } => count(missing) == 0 && count(extra) == 1
    _ => false
  }
}

// THE POSITIVE CONTROL, and it carries Superseded deliberately: a surface that stopped drifting
// because a later generation replaced its candidate ENDS its lineage without ever being installed,
// and scoring that as unfinished would refuse a correct transaction.
test fn applied_and_superseded_together_close_the_lineage() -> Bool {
  match regen_admit_transaction_lineage(
    initial_admitted: [one_identity(), second_identity()],
    lineage: [
      RegenSurfaceLineage { identity: one_identity(), disposition: SurfaceApplied { installed_digest: "d1" } },
      RegenSurfaceLineage { identity: second_identity(), disposition: SurfaceSuperseded { by_generation_id: "g2" } }
    ]
  ) {
    RegenPopulationAdmitted => true
    _ => false
  }
}

fn fixture_surface_in_closure(
  module: String,
  path: String,
  role: RegenGenerationRole,
  seed: RegenSeedMembership,
  closure_id: String
) -> RegenChangedSurface {
  let identity = RegenSurfaceIdentity { declaring_module: module, projected_path: path }
  RegenChangedSurface {
    identity: identity,
    generation_role: role,
    seed_membership: seed,
    dependency_closure_id: closure_id,
    pre_stage_state: PresentBeforeInstall { digest: "old" },
    candidate: RegenCandidateIdentity {
      producer_generation_id: "g0",
      candidate_tree_id: "tree-g0",
      candidate_tree_digest: "tree-digest-g0",
      surface: identity,
      candidate_digest: "new"
    }
  }
}

fn fixture_surface(module: String, path: String, role: RegenGenerationRole, seed: RegenSeedMembership) -> RegenChangedSurface {
  let closure_id = match role {
    GenerationInput => "generation-input-cut"
    GenerationSubject => match seed {
      SeedEmbedded => "seed-compatibility-cut"
      OutsideSeed => "non-seed-publish"
      UnresolvedSeedMembership { reason: _ } => "unresolved-seed-membership"
    }
    NonSeedGeneratedOutput => "non-seed-publish"
    UnresolvedGenerationRole { reason: _ } => "unresolved-generation-role"
    BootstrapSourceMirror => "generation-input-cut"
  }
  fixture_surface_in_closure(
    module: module,
    path: path,
    role: role,
    seed: seed,
    closure_id: closure_id
  )
}

fn fixture_plan(kind: RegenStageKind, rows: List<RegenChangedSurface>) -> RegenStagePlanOutcome {
  regen_plan_stage(
    ordinal: 1,
    kind: kind,
    producer_generation_id: "g0",
    candidate_tree_id: "tree-g0",
    candidate_tree_digest: "tree-digest-g0",
    changed: rows,
    build_target: "claim_executor",
    build_invocation: "cargo build --release --bin claim_executor"
  )
}

test fn producer_stage_defers_seed_subject_until_promoted_generation() -> Bool {
  let producer = fixture_surface(
    module: "compiler.producer",
    path: "compiler_producer.rs",
    role: GenerationInput,
    seed: SeedEmbedded
  )
  let subject = fixture_surface(
    module: "std.subject",
    path: "std_subject.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  match fixture_plan(kind: PromoteGenerationInputs, rows: [producer, subject]) {
    RegenStagePlanned { stage: stage } =>
      count(stage.planned_surfaces) == 1
        && stage.planned_surfaces |> all(only => only.identity.declaring_module == "compiler.producer")
        && count(stage.deferred_surfaces) == 1
    RegenStagePlanningRefused { refusal: _ } => false
    RegenConvergenceTerminal => false
  }
}

test fn seed_compatibility_cut_installs_all_changed_subjects_together() -> Bool {
  let lower = fixture_surface(
    module: "std.lower",
    path: "std_lower.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  let dependent = fixture_surface(
    module: "std.dependent",
    path: "std_dependent.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  match fixture_plan(kind: InstallSeedCompatibilityCut, rows: [lower, dependent]) {
    RegenStagePlanned { stage: stage } => count(stage.planned_surfaces) == 2
    RegenStagePlanningRefused { refusal: _ } => false
    RegenConvergenceTerminal => false
  }
}

test fn unresolved_generation_role_refuses_before_a_stage_is_planned() -> Bool {
  let unknown = fixture_surface(
    module: "new.surface",
    path: "new_surface.rs",
    role: UnresolvedGenerationRole { reason: "no generation-role authority row" },
    seed: SeedEmbedded
  )
  match fixture_plan(kind: PromoteGenerationInputs, rows: [unknown]) {
    RegenStagePlanningRefused { refusal: GenerationRoleUnresolved { surface: _, reason: _ } } => true
    RegenStagePlanningRefused { refusal: _ } => false
    RegenStagePlanned { stage: _ } => false
    RegenConvergenceTerminal => false
  }
}

test fn non_seed_output_waits_for_publish_stage() -> Bool {
  let output = fixture_surface(
    module: "artifact.output",
    path: "artifact_output.rs",
    role: NonSeedGeneratedOutput,
    seed: OutsideSeed
  )
  let early = fixture_plan(kind: InstallSeedCompatibilityCut, rows: [output])
  let publish = fixture_plan(kind: PublishNonSeedOutputs, rows: [output])
  match early {
    RegenStagePlanningRefused { refusal: SurfaceInIncompatibleStageRoles { surfaces: held } } =>
      count(held) == 1 && match publish {
        RegenStagePlanned { stage: stage } => count(stage.planned_surfaces) == 1
        RegenStagePlanningRefused { refusal: _ } => false
        RegenConvergenceTerminal => false
      }
    RegenStagePlanned { stage: _ } => false
    RegenStagePlanningRefused { refusal: _ } => false
    RegenConvergenceTerminal => false
  }
}

test fn one_stage_cannot_claim_two_dependency_closures() -> Bool {
  let lower = fixture_surface_in_closure(
    module: "std.lower",
    path: "std_lower.rs",
    role: GenerationSubject,
    seed: SeedEmbedded,
    closure_id: "seed-core"
  )
  let foreign = fixture_surface_in_closure(
    module: "std.foreign",
    path: "std_foreign.rs",
    role: GenerationSubject,
    seed: SeedEmbedded,
    closure_id: "seed-surface"
  )
  match fixture_plan(kind: InstallSeedCompatibilityCut, rows: [lower, foreign]) {
    RegenStagePlanningRefused {
      refusal: StageDependencyClosureIncomplete { closure_id: "seed-core", missing: missing }
    } => count(missing) == 1
    RegenStagePlanningRefused { refusal: _ } => false
    RegenStagePlanned { stage: _ } => false
    RegenConvergenceTerminal => false
  }
}

// The explicit generation-role roster is the sole producer: every admitted fixture generation
// input appears exactly once, while an ordinary subject is absent rather than silently promoted.
test fn explicit_generation_role_roster_is_total_and_unique_for_generation_inputs() -> Bool {
  let roles = regen_generation_role_modules(modules: [
    "v1.compiler.emit_rust",
    "v1.compiler.required_regen_host",
    "std.ordinary_subject"
  ])
  count(roles |> filter(module => module == "v1.compiler.emit_rust")) == 1
    && count(roles |> filter(module => module == "v1.compiler.required_regen_host")) == 1
    && count(roles |> filter(module => module == "std.ordinary_subject")) == 0
}

// Aggregate generated surfaces have producer ownership even though they deliberately have no
// same-named DAG module. The product and source projections must join through the bootstrap-edge
// authority; a host-side basename fallback would make this discriminator observational.
test fn compiler_tests_aggregate_has_one_declared_product_owner() -> Bool {
  count(regen_generated_product_owner_paths() |> filter(path => path == "compiler_tests.rs")) == 1
    && regen_generated_product_source_modules(product: "compiler_tests.rs")
      == ["v1.compiler.compiler_tests_rust"]
}

// The generated CLI carrier is a seed-embedded generation subject synthesized by
// v1.compiler.emit_rust, not an ordinary same-named module projection. Ownership and generation
// role are both declared here; adding a basename exception in the host would let either fact
// drift independently.
test fn gunbc_cli_dispatch_aggregate_has_one_declared_generation_subject_owner() -> Bool {
  count(regen_generated_product_owner_paths() |> filter(path => path == "gunbc_cli_dispatch_generated.rs")) == 1
    && regen_generated_product_source_modules(product: "gunbc_cli_dispatch_generated.rs")
      == ["v1.compiler.emit_rust"]
    && regen_generated_product_generation_role_labels(product: "gunbc_cli_dispatch_generated.rs")
      == ["GenerationSubject"]
    && count(regen_generation_role_modules(modules: ["v1.compiler.emit_rust"]) |> filter(module => module == "v1.compiler.emit_rust")) == 1
    && count(regen_bootstrap_product_paths() |> filter(path => path == "gunbc_cli_dispatch_generated.rs")) == 0
}

// These stage assertions consume GenerationSubject and SeedEmbedded independently. Together
// they reject both false aggregate roles: generation-input promotion and non-seed publication.
test fn gunbc_cli_dispatch_generation_subject_obeys_all_three_stage_boundaries() -> Bool {
  let carrier = fixture_surface(
    module: "v1.compiler.emit_rust",
    path: "gunbc_cli_dispatch_generated.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  let promote = fixture_plan(kind: PromoteGenerationInputs, rows: [carrier])
  let install = fixture_plan(kind: InstallSeedCompatibilityCut, rows: [carrier])
  let publish = fixture_plan(kind: PublishNonSeedOutputs, rows: [carrier])
  match promote {
    RegenStagePlanningRefused { refusal: SurfaceInIncompatibleStageRoles { surfaces: held } } =>
      count(held) == 1 && match install {
        RegenStagePlanned { stage: stage } =>
          count(stage.planned_surfaces) == 1
            && stage.planned_surfaces |> all(row =>
              row.identity.declaring_module == "v1.compiler.emit_rust"
                && row.identity.projected_path == "gunbc_cli_dispatch_generated.rs"
            )
            && match publish {
              RegenStagePlanningRefused { refusal: SurfaceInIncompatibleStageRoles { surfaces: publish_held } } =>
                count(publish_held) == 1
              _ => false
            }
        _ => false
      }
    _ => false
  }
}

// Seed-manifest absence is not itself an OutsideSeed fact. The generated-product authority
// explicitly classifies publishable aggregates, while the seed crate root remains an input.
test fn aggregate_product_roles_make_non_seed_publication_reachable() -> Bool {
  regen_generated_product_generation_role_labels(product: "compiler_tests.rs")
      == ["NonSeedGeneratedOutput"]
    && regen_generated_product_generation_role_labels(product: "emitted_population.rs")
      == ["NonSeedGeneratedOutput"]
    && regen_generated_product_generation_role_labels(product: "main.rs")
      == ["NonSeedGeneratedOutput"]
    && regen_generated_product_generation_role_labels(product: "lib.rs")
      == ["GenerationInput"]
    && regen_generated_product_generation_role_labels(product: "unowned.rs") == []
}
