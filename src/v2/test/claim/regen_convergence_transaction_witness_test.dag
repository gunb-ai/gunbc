module v2.test.claim.regen_convergence_transaction_witness_test

import std.types { Bool, List, String }
import gunbc.regen_affected_set {
  regen_generation_role_modules,
  regen_generated_product_owner_paths,
  regen_generated_product_source_modules
}

import v2.workflow.regen_convergence_transaction {
  RegenSurfaceIdentity,
  RegenCandidateIdentity,
  RegenChangedSurface,
  CompleteCandidatePopulation,
  AffectedCandidatePopulation,
  AffectedCandidatePopulationRefused,
  RegenAffectedBoundAdmitted,
  RegenAffectedBoundRefused,
  AffectedSetBoundRefused,
  AffectedSetStagePopulationDisagrees,
  RegenGenerationRole,
  RegenSeedMembership,
  RegenStageKind,
  RegenStagePlanOutcome,
  RegenStageExecutionObservation,
  RegenConvergenceFixture,
  GenerationInput,
  BootstrapSourceMirror,
  GenerationSubject,
  NonSeedGeneratedOutput,
  UnresolvedGenerationRole,
  GenerationRoleUnresolved,
  SeedEmbedded,
  OutsideSeed,
  UnresolvedSeedMembership,
  PromoteGenerationInputs,
  InstallSeedCompatibilityCut,
  PublishNonSeedOutputs,
  RegenStagePlanned,
  RegenStagePlanningRefused,
  RegenConvergenceTerminal,
  RegenStageBuildPassed,
  RegenStageBuildFailed,
  RegenStageExecutionAdmitted,
  RegenStageExecutionRefused,
  CandidateStaleAfterProducerRebuild,
  InstalledDigestMismatch,
  StageSeedBuildRefused,
  SurfaceInIncompatibleStageRoles,
  StageDependencyClosureIncomplete,
  RegenFixtureReachedFixedPoint,
  RegenFixtureRefused,
  FinalRegenerationStillDrifts,
  regen_execute_convergence_fixture,
  regen_admit_generation_progress,
  RegenGenerationProgressAdmitted,
  RegenGenerationProgressRefused,
  GenerationCycleDetected,
  GenerationBoundExceeded,
  regen_admit_stage_execution,
  regen_plan_stage,
  regen_admit_affected_bound
}

test fn affected_bound_refusal_cannot_widen_into_stage_planning() -> Bool {
  match regen_admit_affected_bound(
    bound: AffectedCandidatePopulationRefused { reason: "edited module unlocatable" },
    changed: []
  ) {
    RegenAffectedBoundRefused { refusal: AffectedSetBoundRefused { reason: _ } } => true
    _ => false
  }
}

test fn stage_population_outside_the_affected_bound_refuses() -> Bool {
  let inside = fixture_surface(module: "compiler.inside", path: "inside.rs", role: GenerationInput, seed: SeedEmbedded)
  let outside = fixture_surface(module: "compiler.outside", path: "outside.rs", role: GenerationInput, seed: SeedEmbedded)
  match regen_admit_affected_bound(
    bound: AffectedCandidatePopulation { projected_paths: ["inside.rs"] },
    changed: [inside, outside]
  ) {
    RegenAffectedBoundRefused {
      refusal: AffectedSetStagePopulationDisagrees { changed: changed, outside_bound: outside_bound }
    } => count(changed) == 2 && count(outside_bound) == 1
    _ => false
  }
}

test fn whole_population_bound_admits_the_observed_stage_population() -> Bool {
  let row = fixture_surface(module: "compiler.any", path: "any.rs", role: GenerationInput, seed: SeedEmbedded)
  match regen_admit_affected_bound(bound: CompleteCandidatePopulation, changed: [row]) {
    RegenAffectedBoundAdmitted => true
    _ => false
  }
}

test fn repeated_seed_and_candidate_state_is_a_cycle_refusal() -> Bool {
  match regen_admit_generation_progress(
    seen_state_keys: ["seed-a:tree-a"],
    seed_digest: "seed-a",
    candidate_tree_digest: "tree-a",
    ordinal: 2,
    bound: 8
  ) {
    RegenGenerationProgressRefused { refusal: GenerationCycleDetected { seed_digest: _, candidate_tree_digest: _ } } => true
    _ => false
  }
}

test fn finite_generation_bound_refuses_separately_from_a_cycle() -> Bool {
  match regen_admit_generation_progress(
    seen_state_keys: [],
    seed_digest: "seed-new",
    candidate_tree_digest: "tree-new",
    ordinal: 8,
    bound: 8
  ) {
    RegenGenerationProgressRefused { refusal: GenerationBoundExceeded { bound: 8 } } => true
    _ => false
  }
}

test fn single_pass_producer_plus_old_dependent_refuses_the_seed_build() -> Bool {
  let producer = fixture_surface(
    module: "compiler.transport",
    path: "compiler_transport.rs",
    role: GenerationInput,
    seed: SeedEmbedded
  )
  let old_dependent = fixture_surface(
    module: "std.dependent",
    path: "std_dependent.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  match regen_execute_convergence_fixture(fixture: RegenConvergenceFixture {
    g0_changed: [producer, old_dependent],
    producer_stage_build: RegenStageBuildFailed { reason: "producer installed beside old dependent" },
    g1_changed: [],
    subject_stage_build: RegenStageBuildPassed,
    g2_changed: []
  }) {
    RegenFixtureRefused { refusal: StageSeedBuildRefused { ordinal: 1, reason: _ } } => true
    _ => false
  }
}

test fn staged_producer_then_complete_subject_cut_reaches_zero_drift() -> Bool {
  let producer = fixture_surface(
    module: "compiler.transport",
    path: "compiler_transport.rs",
    role: GenerationInput,
    seed: SeedEmbedded
  )
  let lower = fixture_surface(
    module: "std.lower",
    path: "std_lower.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  let dependent = fixture_surface(
    module: "std.dependent",
    path: "std_dependent.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  match regen_execute_convergence_fixture(fixture: RegenConvergenceFixture {
    g0_changed: [producer, lower],
    producer_stage_build: RegenStageBuildPassed,
    g1_changed: [lower, dependent],
    subject_stage_build: RegenStageBuildPassed,
    g2_changed: []
  }) {
    RegenFixtureReachedFixedPoint { stage_kinds: kinds } =>
      count(kinds) == 2
        && kinds |> any(kind => match kind { PromoteGenerationInputs => true _ => false })
        && kinds |> any(kind => match kind { InstallSeedCompatibilityCut => true _ => false })
    RegenFixtureRefused { refusal: _ } => false
  }
}

fn one_identity() -> RegenSurfaceIdentity {
  RegenSurfaceIdentity { declaring_module: "std.subject", projected_path: "std_subject.rs" }
}

test fn stale_candidate_from_g0_cannot_install_after_g1() -> Bool {
  match regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity()],
    input_generation_id: "g1",
    observed_candidate_generation_id: "g0",
    expected_candidate_digest: "candidate-g1",
    observed_candidate_digest: "candidate-g0",
    build_terminal: RegenStageBuildPassed
  }) {
    RegenStageExecutionRefused { refusal: CandidateStaleAfterProducerRebuild { candidate: _, current_generation_id: _ } } => true
    _ => false
  }
}

test fn tampered_candidate_digest_refuses_before_admission() -> Bool {
  match regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity()],
    input_generation_id: "g1",
    observed_candidate_generation_id: "g1",
    expected_candidate_digest: "expected",
    observed_candidate_digest: "tampered",
    build_terminal: RegenStageBuildPassed
  }) {
    RegenStageExecutionRefused { refusal: InstalledDigestMismatch { surface: _, expected: _, observed: _ } } => true
    _ => false
  }
}

test fn stage_build_failure_is_a_typed_transaction_refusal() -> Bool {
  match regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity()],
    input_generation_id: "g1",
    observed_candidate_generation_id: "g1",
    expected_candidate_digest: "candidate",
    observed_candidate_digest: "candidate",
    build_terminal: RegenStageBuildFailed { reason: "old dependent rejects producer output" }
  }) {
    RegenStageExecutionRefused { refusal: StageSeedBuildRefused { ordinal: _, reason: _ } } => true
    _ => false
  }
}

test fn matching_stage_population_digest_generation_and_build_are_admitted() -> Bool {
  match regen_admit_stage_execution(observation: RegenStageExecutionObservation {
    planned: [one_identity()],
    executed: [one_identity()],
    input_generation_id: "g1",
    observed_candidate_generation_id: "g1",
    expected_candidate_digest: "candidate",
    observed_candidate_digest: "candidate",
    build_terminal: RegenStageBuildPassed
  }) {
    RegenStageExecutionAdmitted => true
    RegenStageExecutionRefused { refusal: _ } => false
  }
}

fn fixture_surface_in_closure(
  module: String,
  path: String,
  role: RegenGenerationRole,
  seed: RegenSeedMembership,
  closure_id: String
) -> RegenChangedSurface {
  let identity = RegenSurfaceIdentity { declaring_module: module, projected_path: path }
  RegenChangedSurface {
    identity: identity,
    generation_role: role,
    seed_membership: seed,
    dependency_closure_id: closure_id,
    pre_stage_digest: "old",
    candidate: RegenCandidateIdentity {
      producer_generation_id: "g0",
      candidate_tree_id: "tree-g0",
      candidate_tree_digest: "tree-digest-g0",
      surface: identity,
      candidate_digest: "new"
    }
  }
}

fn fixture_surface(module: String, path: String, role: RegenGenerationRole, seed: RegenSeedMembership) -> RegenChangedSurface {
  let closure_id = match role {
    GenerationInput => "generation-input-cut"
    GenerationSubject => match seed {
      SeedEmbedded => "seed-compatibility-cut"
      OutsideSeed => "non-seed-publish"
      UnresolvedSeedMembership { reason: _ } => "unresolved-seed-membership"
    }
    NonSeedGeneratedOutput => "non-seed-publish"
    UnresolvedGenerationRole { reason: _ } => "unresolved-generation-role"
    BootstrapSourceMirror => "generation-input-cut"
  }
  fixture_surface_in_closure(
    module: module,
    path: path,
    role: role,
    seed: seed,
    closure_id: closure_id
  )
}

fn fixture_plan(kind: RegenStageKind, rows: List<RegenChangedSurface>) -> RegenStagePlanOutcome {
  regen_plan_stage(
    ordinal: 1,
    kind: kind,
    producer_generation_id: "g0",
    candidate_tree_id: "tree-g0",
    candidate_tree_digest: "tree-digest-g0",
    changed: rows,
    build_target: "claim_executor",
    build_invocation: "cargo build --release --bin claim_executor"
  )
}

test fn producer_stage_defers_seed_subject_until_promoted_generation() -> Bool {
  let producer = fixture_surface(
    module: "compiler.producer",
    path: "compiler_producer.rs",
    role: GenerationInput,
    seed: SeedEmbedded
  )
  let subject = fixture_surface(
    module: "std.subject",
    path: "std_subject.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  match fixture_plan(kind: PromoteGenerationInputs, rows: [producer, subject]) {
    RegenStagePlanned { stage: stage } =>
      count(stage.planned_surfaces) == 1
        && stage.planned_surfaces |> all(only => only.identity.declaring_module == "compiler.producer")
        && count(stage.deferred_surfaces) == 1
    RegenStagePlanningRefused { refusal: _ } => false
    RegenConvergenceTerminal => false
  }
}

test fn seed_compatibility_cut_installs_all_changed_subjects_together() -> Bool {
  let lower = fixture_surface(
    module: "std.lower",
    path: "std_lower.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  let dependent = fixture_surface(
    module: "std.dependent",
    path: "std_dependent.rs",
    role: GenerationSubject,
    seed: SeedEmbedded
  )
  match fixture_plan(kind: InstallSeedCompatibilityCut, rows: [lower, dependent]) {
    RegenStagePlanned { stage: stage } => count(stage.planned_surfaces) == 2
    RegenStagePlanningRefused { refusal: _ } => false
    RegenConvergenceTerminal => false
  }
}

test fn unresolved_generation_role_refuses_before_a_stage_is_planned() -> Bool {
  let unknown = fixture_surface(
    module: "new.surface",
    path: "new_surface.rs",
    role: UnresolvedGenerationRole { reason: "no generation-role authority row" },
    seed: SeedEmbedded
  )
  match fixture_plan(kind: PromoteGenerationInputs, rows: [unknown]) {
    RegenStagePlanningRefused { refusal: GenerationRoleUnresolved { surface: _, reason: _ } } => true
    RegenStagePlanningRefused { refusal: _ } => false
    RegenStagePlanned { stage: _ } => false
    RegenConvergenceTerminal => false
  }
}

test fn non_seed_output_waits_for_publish_stage() -> Bool {
  let output = fixture_surface(
    module: "artifact.output",
    path: "artifact_output.rs",
    role: NonSeedGeneratedOutput,
    seed: OutsideSeed
  )
  let early = fixture_plan(kind: InstallSeedCompatibilityCut, rows: [output])
  let publish = fixture_plan(kind: PublishNonSeedOutputs, rows: [output])
  match early {
    RegenStagePlanningRefused { refusal: SurfaceInIncompatibleStageRoles { surfaces: held } } =>
      count(held) == 1 && match publish {
        RegenStagePlanned { stage: stage } => count(stage.planned_surfaces) == 1
        RegenStagePlanningRefused { refusal: _ } => false
        RegenConvergenceTerminal => false
      }
    RegenStagePlanned { stage: _ } => false
    RegenStagePlanningRefused { refusal: _ } => false
    RegenConvergenceTerminal => false
  }
}

test fn one_stage_cannot_claim_two_dependency_closures() -> Bool {
  let lower = fixture_surface_in_closure(
    module: "std.lower",
    path: "std_lower.rs",
    role: GenerationSubject,
    seed: SeedEmbedded,
    closure_id: "seed-core"
  )
  let foreign = fixture_surface_in_closure(
    module: "std.foreign",
    path: "std_foreign.rs",
    role: GenerationSubject,
    seed: SeedEmbedded,
    closure_id: "seed-surface"
  )
  match fixture_plan(kind: InstallSeedCompatibilityCut, rows: [lower, foreign]) {
    RegenStagePlanningRefused {
      refusal: StageDependencyClosureIncomplete { closure_id: "seed-core", missing: missing }
    } => count(missing) == 1
    RegenStagePlanningRefused { refusal: _ } => false
    RegenStagePlanned { stage: _ } => false
    RegenConvergenceTerminal => false
  }
}

// The explicit generation-role roster is the sole producer: every admitted fixture generation
// input appears exactly once, while an ordinary subject is absent rather than silently promoted.
test fn explicit_generation_role_roster_is_total_and_unique_for_generation_inputs() -> Bool {
  let roles = regen_generation_role_modules(modules: [
    "v1.compiler.emit_rust",
    "v1.compiler.required_regen_host",
    "std.ordinary_subject"
  ])
  count(roles |> filter(module => module == "v1.compiler.emit_rust")) == 1
    && count(roles |> filter(module => module == "v1.compiler.required_regen_host")) == 1
    && count(roles |> filter(module => module == "std.ordinary_subject")) == 0
}

// Aggregate generated surfaces have producer ownership even though they deliberately have no
// same-named DAG module. The product and source projections must join through the bootstrap-edge
// authority; a host-side basename fallback would make this discriminator observational.
test fn compiler_tests_aggregate_has_one_declared_product_owner() -> Bool {
  count(regen_generated_product_owner_paths() |> filter(path => path == "compiler_tests.rs")) == 1
    && regen_generated_product_source_modules(product: "compiler_tests.rs")
      == ["v1.compiler.compiler_tests_rust"]
}
