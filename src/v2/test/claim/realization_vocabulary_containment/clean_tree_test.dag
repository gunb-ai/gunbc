module v2.test.realization_vocabulary_containment.clean_tree


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn realization_vocab_clean_tree_holds() -> Bool {
  realization_vocab_containment_clean_live(scan_roots: realization_vocab_consumer_scan_roots)
    && (realization_vocab_leak_count_live(scan_roots: realization_vocab_consumer_scan_roots) == 0)
}
