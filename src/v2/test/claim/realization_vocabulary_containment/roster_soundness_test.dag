module v2.test.realization_vocabulary_containment.roster_soundness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data typescript_sidecar_module: String = "extdeps.languages.typescript.program"

data bash_build_module: String = "v2.extdeps.languages.bash_build"

data roster_soundness_fast_lane_note: String = "Live-corpus roster soundness receipt moved to long/realization_vocabulary_containment_witness_test.dag (5s fast-lane budget). Per-PR controls hand-build LayerImportFact census rows and derive live_leak_edges via realization_vocab_live_leak_edges_from_facts (not by projecting realization_vocab_grandfathered_edge_roster); roster_sound then compares that derived edge set against the grandfather roster. Positive: full TS-0 frozen census facts. RED: same census minus build_step so one grandfathered edge is stale."

data ts0_frozen_census_facts: List<v2.std.layer.LayerImportFact> = [
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixStd,
    path: "dag/gunbc/roadmap_component.dag",
    import_module: typescript_sidecar_module
  },
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixStd,
    path: "dag/gunbc/design/theme_transition.dag",
    import_module: typescript_sidecar_module
  },
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixStd,
    path: "dag/gunbc/node_http_server_emit.dag",
    import_module: typescript_sidecar_module
  },
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixWorkflow,
    path: "src/v2/workflow/effect_plan_bash_materialize.dag",
    import_module: bash_build_module
  },
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixStd,
    path: "dag/tools/build_step.dag",
    import_module: bash_build_module
  }
]

data ts0_frozen_census_facts_missing_build_step: List<v2.std.layer.LayerImportFact> = [
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixStd,
    path: "dag/gunbc/roadmap_component.dag",
    import_module: typescript_sidecar_module
  },
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixStd,
    path: "dag/gunbc/design/theme_transition.dag",
    import_module: typescript_sidecar_module
  },
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixStd,
    path: "dag/gunbc/node_http_server_emit.dag",
    import_module: typescript_sidecar_module
  },
  v2.std.layer.LayerImportFact {
    layer: v2.std.layer.LayerPrefixWorkflow,
    path: "src/v2/workflow/effect_plan_bash_materialize.dag",
    import_module: bash_build_module
  }
]

test fn realization_vocab_roster_soundness_census_complete_holds() -> Bool {
  v2.lens.realization_vocabulary_containment.realization_vocab_roster_sound(
    live_leak_edges: v2.lens.realization_vocabulary_containment.realization_vocab_live_leak_edges_from_facts(facts: ts0_frozen_census_facts)
  )
}

test fn realization_vocab_roster_soundness_planted_stale_red_holds() -> Bool {
  v2.lens.realization_vocabulary_containment.realization_vocab_roster_sound(
    live_leak_edges: v2.lens.realization_vocabulary_containment.realization_vocab_live_leak_edges_from_facts(
      facts: ts0_frozen_census_facts_missing_build_step
    )
  ) == false
}

test fn realization_vocab_grandfathered_edge_roster_keys_are_distinct_holds() -> Bool {
  v2.lens.realization_vocabulary_containment.realization_vocab_grandfathered_edge_roster_well_formed()
}

test fn realization_vocab_grandfathered_edge_keys_distinct_red_on_planted_duplicate_holds() -> Bool {
  let planted = [
    "dag/gunbc/roadmap_component.dag -> extdeps.languages.typescript.program",
    "dag/tools/build_step.dag -> v2.extdeps.languages.bash_build",
    "dag/gunbc/roadmap_component.dag -> extdeps.languages.typescript.program"
  ]
  let distinct = [
    "dag/gunbc/roadmap_component.dag -> extdeps.languages.typescript.program",
    "dag/tools/build_step.dag -> v2.extdeps.languages.bash_build"
  ]
  !v2.lens.realization_vocabulary_containment.realization_vocab_grandfathered_edge_keys_are_distinct(keys: planted)
    && v2.lens.realization_vocabulary_containment.realization_vocab_grandfathered_edge_keys_are_distinct(keys: distinct)
    && v2.lens.realization_vocabulary_containment.realization_vocab_grandfathered_edge_keys_are_distinct(
      keys: v2.lens.realization_vocabulary_containment.realization_vocab_grandfathered_edge_keys()
    )
}
