fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold(xs, init: false, f: fn(acc, s) { acc || (s == target) })
}

fn edge_in_grandfathered_roster(edge: v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge) -> Bool {
  fold(
    realization_vocab_grandfathered_edges(),
    init: false,
    f: fn(found, candidate) {
      found || realization_vocab_import_edge_eq(a: candidate, b: edge)
    }
  )
}

test fn ci_spec_excused_from_bash_roster_holds() -> Bool {
  !v2.test.realization_vocabulary_containment.lens_unit.discriminators.edge_in_grandfathered_roster(
    edge: v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge {
      importer_path: "dag/gunbc/ci_spec.dag",
      vocab_module: bash_vocab_module
    }
  )
}

