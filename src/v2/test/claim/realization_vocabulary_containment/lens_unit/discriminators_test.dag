module v2.test.realization_vocabulary_containment.lens_unit.discriminators

import v2.std.layer { LayerImportFact }
import v2.lens.realization_vocabulary_containment {
  realization_vocab_exception_paths,
  realization_vocab_leak_count,
  realization_vocab_leak_count_canonical,
  realization_vocab_leak_count_with_edge_prefixes,
  realization_edge_path_prefixes_without
}
import v2.std.collection { List }
import v2.std.layer { LayerPrefixStd, LayerPrefixExtdeps, LayerPrefixWorkflow }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data sidecar_module: String = "extdeps.languages.typescript.program"

data bash_vocab_module: String = "v2.extdeps.languages.bash_build"

data fresh_leak_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/tools/_perturb_fresh_consumer.dag",
    import_module: sidecar_module
  }
]

test fn fresh_non_edge_import_is_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: fresh_leak_facts) == 1
}

data edge_import_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixExtdeps,
    path: "src/v2/extdeps/languages/bash.dag",
    import_module: sidecar_module
  }
]

test fn realization_edge_import_is_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: edge_import_facts) == 0
}

data rostered_import_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/gunbc/node_http_server_emit.dag",
    import_module: sidecar_module
  }
]

test fn rostered_consumer_import_is_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: rostered_import_facts) == 0
}

data roster_without_node_http_emit: List<String> = [
  "dag/tools/dag_compile_clean_transport.dag",
  "dag/tools/emit_host_transport.dag",
  "dag/tools/layering_imports_transport.dag",
  "src/v2/workflow/compiler_closure_ingest_transport.dag",
  "src/v2/workflow/source_root_ingest_transport.dag"
]

test fn de_rostered_consumer_import_is_leak_holds() -> Bool {
  realization_vocab_leak_count(
    facts: rostered_import_facts,
    roster: roster_without_node_http_emit
  ) == 1
}

data non_vocab_import_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/tools/_perturb_fresh_consumer.dag",
    import_module: "extdeps.shell"
  }
]

test fn non_vocabulary_import_is_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: non_vocab_import_facts) == 0
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold(xs, init: false, f: fn(acc, s) { acc || (s == target) })
}

test fn ci_spec_excused_from_bash_roster_holds() -> Bool {
  !list_contains_str(xs: realization_vocab_exception_paths(), target: "dag/gunbc/ci_spec.dag")
}

test fn build_step_rostered_for_bash_build_holds() -> Bool {
  list_contains_str(
    xs: realization_vocab_exception_paths(),
    target: "dag/tools/build_step.dag"
  )
}

data bash_fresh_leak_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/tools/_perturb_fresh_bash_consumer.dag",
    import_module: bash_vocab_module
  }
]

test fn bash_vocab_fresh_non_edge_import_is_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: bash_fresh_leak_facts) == 1
}

data bash_edge_import_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixExtdeps,
    path: "src/v2/workflow/bash_emit.dag",
    import_module: bash_vocab_module
  }
]

test fn bash_vocab_realization_edge_import_is_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: bash_edge_import_facts) == 0
}

test fn node_http_server_emit_rostered_for_typescript_sidecar_holds() -> Bool {
  list_contains_str(
    xs: realization_vocab_exception_paths(),
    target: "dag/gunbc/node_http_server_emit.dag"
  )
}

data bash_orchestration_emit_module: String = "v2.extdeps.languages.bash_orchestration_emit"

data bucket_d_emit_edge_import_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixWorkflow,
    path: "src/v2/workflow/ci_materialization_emit.dag",
    import_module: bash_orchestration_emit_module
  },
  LayerImportFact {
    layer: LayerPrefixWorkflow,
    path: "src/v2/workflow/ci_merge_admission_emit.dag",
    import_module: bash_orchestration_emit_module
  }
]

data bucket_d_emit_edge_discriminator_note: String = "Synthetic executing receipt for #7265 bucket-D emit modules: live-corpus containment is dark (pre-existing unrostered TS-AST consumers), so canonical live-tree scan cannot validate the two new realization_edge_path_prefixes rows. These facts mirror the actual imports; GREEN requires leak_count_canonical == 0."

test fn bucket_d_emit_modules_on_edge_roster_are_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: bucket_d_emit_edge_import_facts) == 0
}

data ci_materialization_emit_edge_fact: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixWorkflow,
    path: "src/v2/workflow/ci_materialization_emit.dag",
    import_module: bash_orchestration_emit_module
  }
]

test fn de_rostered_ci_materialization_emit_edge_is_leak_holds() -> Bool {
  realization_vocab_leak_count_with_edge_prefixes(
    facts: ci_materialization_emit_edge_fact,
    roster: realization_vocab_exception_paths(),
    edge_prefixes: realization_edge_path_prefixes_without(
      excluded: "src/v2/workflow/ci_materialization_emit"
    )
  ) == 1
}
