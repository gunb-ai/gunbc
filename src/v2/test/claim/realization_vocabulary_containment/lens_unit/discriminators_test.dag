data bash_orchestration_emit_module: String = "v2.extdeps.languages.bash_orchestration_emit"

data bucket_d_emit_edge_import_facts: List<v2.std.layer.LayerImportFact> = [
  v2.std.layer.LayerImportFact {
    layer: LayerPrefixWorkflow,
    path: "src/v2/workflow/ci_materialization_emit.dag",
    import_module: bash_orchestration_emit_module
  }
]

data bucket_d_emit_edge_discriminator_note: String = "Synthetic executing receipt for the surviving #7265 bucket-D materialization emitter. The sibling merge-admission emitter and its edge-prefix row deleted when the live work moved inside WalkPlan; retaining its synthetic fact would validate an implementation that no longer exists."

test fn bucket_d_emit_modules_on_edge_roster_are_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: bucket_d_emit_edge_import_facts) == 0
}

data ci_materialization_emit_edge_fact: List<v2.std.layer.LayerImportFact> = [
  v2.std.layer.LayerImportFact {
    layer: LayerPrefixWorkflow,
    path: "src/v2/workflow/ci_materialization_emit.dag",
    import_module: bash_orchestration_emit_module
  }
]

test fn de_rostered_ci_materialization_emit_edge_is_leak_holds() -> Bool {
  realization_vocab_leak_count_with_edge_prefixes(
    facts: ci_materialization_emit_edge_fact,
    edge_prefixes: realization_edge_path_prefixes_without(
      excluded: "src/v2/workflow/ci_materialization_emit"
    )
  ) == 1
}

test fn grandfathered_edge_keys_are_exact_identity_holds() -> Bool {
  v2.test.realization_vocabulary_containment.lens_unit.discriminators.list_contains_str(
    xs: realization_vocab_grandfathered_edge_keys(),
    target: "dag/gunbc/roadmap_component.dag -> extdeps.languages.typescript.program"
  )
}
