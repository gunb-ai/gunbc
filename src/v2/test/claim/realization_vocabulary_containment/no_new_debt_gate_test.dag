module v2.test.realization_vocabulary_containment.no_new_debt_gate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data ts0_no_new_debt_gate_note: String = "TS-0 exact-edge no-new-debt gate (language-support-completion design LANG-2/TS-0, census re-run 2026-08-06): the five current live-corpus leak edges are frozen at (importer_path, vocab_module) identity grain on v2.lens.realization_vocabulary_containment realization_vocab_grandfathered_edge_roster; a NEW exact edge outside that roster still refuses. Per-PR mechanism coverage only — synthetic predicate receipts over hand-built LayerImportFact rows, not a second live-tree census. The irreducible live-corpus receipt runs on the falsifier substrate long lane (realization_vocab_live_corpus_receipt_holds)."

data typescript_sidecar_module: String = "extdeps.languages.typescript.program"

data bash_build_module: String = "v2.extdeps.languages.bash_build"

data ts0_census_roadmap_component_edge: v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge = v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge {
  importer_path: "dag/gunbc/roadmap_component.dag",
  vocab_module: typescript_sidecar_module
}

data ts0_census_theme_transition_edge: v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge = v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge {
  importer_path: "dag/gunbc/design/theme_transition.dag",
  vocab_module: typescript_sidecar_module
}

data ts0_census_node_http_server_emit_edge: v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge = v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge {
  importer_path: "dag/gunbc/node_http_server_emit.dag",
  vocab_module: typescript_sidecar_module
}

data ts0_census_effect_plan_bash_materialize_edge: v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge = v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge {
  importer_path: "src/v2/workflow/effect_plan_bash_materialize.dag",
  vocab_module: bash_build_module
}

data ts0_census_build_step_edge: v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge = v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge {
  importer_path: "dag/tools/build_step.dag",
  vocab_module: bash_build_module
}

fn edge_in_grandfathered_roster(edge: v2.lens.realization_vocabulary_containment.RealizationVocabImportEdge) -> Bool {
  fold(
    realization_vocab_grandfathered_edges(),
    init: false,
    f: fn(found, candidate) {
      found || realization_vocab_import_edge_eq(a: candidate, b: edge)
    }
  )
}

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold(xs, init: false, f: fn(acc, s) { acc || (s == target) })
}

test fn ts0_census_roadmap_component_edge_is_grandfathered_holds() -> Bool {
  v2.test.realization_vocabulary_containment.no_new_debt_gate.edge_in_grandfathered_roster(edge: ts0_census_roadmap_component_edge)
}

test fn ts0_census_theme_transition_edge_is_grandfathered_holds() -> Bool {
  v2.test.realization_vocabulary_containment.no_new_debt_gate.edge_in_grandfathered_roster(edge: ts0_census_theme_transition_edge)
}

test fn ts0_census_node_http_server_emit_edge_is_grandfathered_holds() -> Bool {
