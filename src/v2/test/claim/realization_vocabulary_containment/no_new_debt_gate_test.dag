test fn ts0_unrostered_non_edge_import_is_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: ts0_fresh_unrostered_leak_facts) == 1
}

data ts0_frozen_facts_union: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/gunbc/roadmap_component.dag",
    import_module: typescript_sidecar_module
  },
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/gunbc/design/theme_transition.dag",
    import_module: typescript_sidecar_module
  },
  LayerImportFact {
