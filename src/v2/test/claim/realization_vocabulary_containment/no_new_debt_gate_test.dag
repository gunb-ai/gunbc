test fn ts0_grandfathered_edge_keys_use_exact_edge_identity_holds() -> Bool {
  v2.test.realization_vocabulary_containment.no_new_debt_gate.list_contains_str(
    xs: realization_vocab_grandfathered_edge_keys(),
    target: "dag/gunbc/roadmap_component.dag -> extdeps.languages.typescript.program"
  )
    && v2.test.realization_vocabulary_containment.no_new_debt_gate.list_contains_str(
      xs: realization_vocab_grandfathered_edge_keys(),
      target: "src/v2/workflow/effect_plan_bash_materialize.dag -> v2.extdeps.languages.bash_build"
    )
}
