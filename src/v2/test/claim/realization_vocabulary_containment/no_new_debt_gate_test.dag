module v2.test.realization_vocabulary_containment.no_new_debt_gate

import v2.std.layer { LayerImportFact, LayerPrefixStd, LayerPrefixWorkflow }
import v2.lens.realization_vocabulary_containment {
  realization_vocab_exception_paths,
  realization_vocab_leak_count_canonical,
  realization_vocab_containment_holds_canonical
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data ts0_no_new_debt_gate_note: String = "TS-0 exact-edge no-new-debt gate (language-support-completion design LANG-2/TS-0): the three known live-corpus leaks are frozen as declared frontier rows on v2.lens.realization_vocabulary_containment realization_vocab_exception_roster; a NEW import of target-AST vocabulary outside realization-edge prefixes and outside that roster still refuses. Per-PR mechanism coverage only — synthetic predicate receipts over hand-built LayerImportFact rows at exact path identity grain, not a second live-tree census. The irreducible live-corpus receipt runs on the falsifier substrate long lane (realization_vocab_live_corpus_receipt_holds)."

data typescript_sidecar_module: String = "extdeps.languages.typescript.program"

data bash_build_module: String = "v2.extdeps.languages.bash_build"

data ts0_frozen_roadmap_component_fact: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/gunbc/roadmap_component.dag",
    import_module: typescript_sidecar_module
  }
]

data ts0_frozen_theme_transition_fact: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/gunbc/design/theme_transition.dag",
    import_module: typescript_sidecar_module
  }
]

data ts0_frozen_effect_plan_bash_materialize_fact: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixWorkflow,
    path: "src/v2/workflow/effect_plan_bash_materialize.dag",
    import_module: bash_build_module
  }
]

fn list_contains_str(xs: List<String>, target: String) -> Bool {
  fold(xs, init: false, f: fn(acc, s) { acc || (s == target) })
}

test fn ts0_frozen_roadmap_component_is_rostered_holds() -> Bool {
  list_contains_str(
    xs: realization_vocab_exception_paths(),
    target: "dag/gunbc/roadmap_component.dag"
  )
}

test fn ts0_frozen_theme_transition_is_rostered_holds() -> Bool {
  list_contains_str(
    xs: realization_vocab_exception_paths(),
    target: "dag/gunbc/design/theme_transition.dag"
  )
}

test fn ts0_frozen_effect_plan_bash_materialize_is_rostered_holds() -> Bool {
  list_contains_str(
    xs: realization_vocab_exception_paths(),
    target: "src/v2/workflow/effect_plan_bash_materialize.dag"
  )
}

test fn ts0_frozen_roadmap_component_import_is_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: ts0_frozen_roadmap_component_fact) == 0
}

test fn ts0_frozen_theme_transition_import_is_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: ts0_frozen_theme_transition_fact) == 0
}

test fn ts0_frozen_effect_plan_bash_materialize_import_is_not_leak_holds() -> Bool {
  realization_vocab_leak_count_canonical(facts: ts0_frozen_effect_plan_bash_materialize_fact) == 0
}

data ts0_fresh_unrostered_leak_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerPrefixStd,
    path: "dag/gunbc/_perturb_ts0_fresh_consumer.dag",
