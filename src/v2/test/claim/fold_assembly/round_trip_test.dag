module v2.test.fold_assembly.round_trip

import v2.std.fold_assembly {
  apply_fills, assemble_fold, expand_fold,
  fold_template_of, fold_per_element_of,
  fold_template_edge, encode_per_element
}
import v2.std.anti_unification {
  ChainGeneralization, anti_unify_chain, hole_node, extract_fillings
}
import v2.std.node {
  Node, Edge, EdgeLabel, Positional, Named,
  NodeKind, TypeNode, Connective, Atom, Conj,
  Symbol, node_synthetic, name_occurrences
}
import v2.std.exact_structural_equality_zip_fold_predicate { exact_structural_equality_zip_fold }
import v2.std.algebra { FreeMonoid, zip_eq, length, list_snoc_item, freemonoid_empty }
import v2.std.collection { List }
import v2.std.logic { Bool }

fn atom(id: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: id } }, children: [])
}
fn conj2(a: Node, b: Node) -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: [
    Edge { label: Positional, target: a },
    Edge { label: Positional, target: b }
  ])
}
fn conj3(a: Node, b: Node, c: Node) -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: [
    Edge { label: Positional, target: a },
    Edge { label: Positional, target: b },
    Edge { label: Positional, target: c }
  ])
}

fn node_eq(a: Node, b: Node) -> Bool {
  exact_structural_equality_zip_fold(source_facts: a, candidate: b)
}
fn chain_eq(a: FreeMonoid<Node>, b: FreeMonoid<Node>) -> Bool {
  (length(xs: a) == length(xs: b))
    && zip_eq(a: a, b: b, eq: fn(x, y) { node_eq(a: x, b: y) })
}

data gate_chain: List<Node> = [
  conj3(a: atom(id: ^run), b: atom(id: ^gate_rust),  c: atom(id: ^acc0)),
  conj3(a: atom(id: ^run), b: atom(id: ^gate_emit),  c: atom(id: ^acc1)),
  conj3(a: atom(id: ^run), b: atom(id: ^gate_layer), c: atom(id: ^acc2))
]

data divergent_chain: List<Node> = [
  conj2(a: atom(id: ^is_if),     b: atom(id: ^stmt_first)),
  conj2(a: atom(id: ^is_assign), b: conj2(a: atom(id: ^skip), b: atom(id: ^stmt_first))),
  conj2(a: atom(id: ^is_loop),   b: conj2(a: atom(id: ^skip), b: atom(id: ^stmt_first)))
]

data short_chain: List<Node> = [
  conj3(a: atom(id: ^run), b: atom(id: ^gate_rust), c: atom(id: ^acc0)),
  conj3(a: atom(id: ^run), b: atom(id: ^gate_emit), c: atom(id: ^acc1))
]

fn round_trips(steps: FreeMonoid<Node>) -> Bool {
  chain_eq(a: expand_fold(fold_form: assemble_fold(g: anti_unify_chain(steps: steps))), b: steps)
}

test fn gate_chain_round_trips() -> Bool {
  round_trips(steps: gate_chain)
}
test fn divergent_chain_round_trips() -> Bool {
  round_trips(steps: divergent_chain)
}
test fn short_chain_round_trips() -> Bool {
  round_trips(steps: short_chain)
}

fn apply_recovers_step(template: Node, step: Node) -> Bool {
  node_eq(a: apply_fills(template: template, fills: extract_fillings(template: template, element: step)), b: step)
}
test fn apply_inverts_extract_on_gate_step() -> Bool {
  apply_recovers_step(template: anti_unify_chain(steps: gate_chain).template, step: conj3(a: atom(id: ^run), b: atom(id: ^gate_emit), c: atom(id: ^acc1)))
}

test fn fold_form_has_exactly_one_template_edge() -> Bool {
  name_occurrences(name: fold_template_edge, children: assemble_fold(g: anti_unify_chain(steps: gate_chain)).children) == 1
}
test fn fold_form_template_is_the_kernel_template() -> Bool {
  node_eq(
    a: fold_template_of(fold_form: assemble_fold(g: anti_unify_chain(steps: gate_chain))),
    b: anti_unify_chain(steps: gate_chain).template
  )
}

fn fills_eq(a: FreeMonoid<Node>, b: FreeMonoid<Node>) -> Bool {
  (length(xs: a) == length(xs: b)) && zip_eq(a: a, b: b, eq: fn(x, y) { node_eq(a: x, b: y) })
}
fn per_element_eq(a: FreeMonoid<FreeMonoid<Node>>, b: FreeMonoid<FreeMonoid<Node>>) -> Bool {
  (length(xs: a) == length(xs: b)) && zip_eq(a: a, b: b, eq: fn(x, y) { fills_eq(a: x, b: y) })
}
test fn fold_form_preserves_per_element_fills() -> Bool {
  per_element_eq(
    a: fold_per_element_of(fold_form: assemble_fold(g: anti_unify_chain(steps: gate_chain))),
    b: anti_unify_chain(steps: gate_chain).per_element
  )
}

fn corrupted_per_element() -> FreeMonoid<FreeMonoid<Node>> {
  list_snoc_item(
    xs: list_snoc_item(
      xs: list_snoc_item(
        xs: freemonoid_empty(),
        item: list_snoc_item(xs: list_snoc_item(xs: freemonoid_empty(), item: atom(id: ^WRONG)), item: atom(id: ^acc0))
      ),
      item: list_snoc_item(xs: list_snoc_item(xs: freemonoid_empty(), item: atom(id: ^gate_emit)), item: atom(id: ^acc1))
    ),
    item: list_snoc_item(xs: list_snoc_item(xs: freemonoid_empty(), item: atom(id: ^gate_layer)), item: atom(id: ^acc2))
  )
}
fn corrupted_fold_form() -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: [
    Edge { label: Named { name: fold_template_edge }, target: anti_unify_chain(steps: gate_chain).template },
    Edge { label: Named { name: ^fold_elements }, target: encode_per_element(per_element: corrupted_per_element()) }
  ])
}
test fn corrupted_fold_form_does_not_round_trip() -> Bool {
  !chain_eq(a: expand_fold(fold_form: corrupted_fold_form()), b: gate_chain)
}
