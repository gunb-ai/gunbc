module v2.test.claim.body_lowering_unrecognised_lowered_shape

import gunbc.compile_diagnostic_census {
  CensusNotRunnable,
  CensusObserved,
  census_rows_of_class,
  census_total_count
}
import v2.compiler.body_lowering_fold {
  OperandRefAbsent,
  OperandRefLowered,
  OperandRefRefused,
  body_lower_fold,
  body_lower_operand_ref_read,
  body_term_of
}
import v2.test.parse.expression_bodied_fn_decl_parse { g_tokenize_parse }
import v2.extdeps.languages.dag {
  dag_int_literal_node_from_lexeme,
  parse_production_emitted_identity_optional
}
import v2.std.compilers.body_lowering { BodyTerm, Lowered, RawLeaf, RawParse }
import v2.std.diagnostic { Accepted, Outcome, Rejected, node_locus }
import std.types { Bool }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.node {
  Atom,
  Authored,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  node_synthetic
}
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import std.types { Int }
import std.occurrence_identity { OccurrenceSynthetic }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE SUBJECT IS THE TERM BODY LOWERING READS OFF ITS TREE (v2.compiler.body_lowering_fold
// body_term_of) AND THE WALLS AROUND IT (MQ-5). The first group supplies inputs at that boundary
// (DESIGN section 3): a node that is neither wrapped by a producer nor stamped by the parse refuses
// wherever it is read, and the raw forms the parse does write are read positively. The second group
// runs the real route: source text through tokenize, parse and the bottom-up fold, so the claim is
// about what a producer actually emits. The third hands the compiler fixture sources that try to
// forge the Lowered label, on the seed acceptance path. The route pairing for real programs is held
// by v2.test.claim.namespace_xl0.value_position_whole_read and
// v2.test.claim.namespace_xl0.reference_conservation_admission.

fn ulsh_leaf() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^ulsh_leaf } }, children: [])
}

// A Conj under a label no grammar production and no lowering emits, with no wrapper over it.
fn ulsh_unknown_shape() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Authored { name: ^ulsh_probe_edge }, target: ulsh_leaf() }]
  )
}

fn ulsh_unknown_over_transform() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Authored { name: ^ulsh_probe_edge },
        target: node_synthetic(
          kind: ComputationNode { behavior: Transform },
          children: [Edge { label: Positional, target: ulsh_leaf() }]
        )
      }
    ]
  )
}

// A producer's output with its seal missing: the allowlist used to take this whole.
fn ulsh_unsealed_transform() -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [Edge { label: Positional, target: ulsh_leaf() }]
  )
}

fn ulsh_raw_sequence() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Authored { name: ^grammar_sequence_left_node_projection }, target: ulsh_leaf() },
      Edge { label: Authored { name: ^grammar_sequence_right_node_projection }, target: ulsh_leaf() }
    ]
  )
}

fn ulsh_int_literal_token() -> Optional<Node> {
  match dag_int_literal_node_from_lexeme(lexeme: "7", occurrence_id: OccurrenceSynthetic) {
    Accepted { value: lit, diagnostics: _ } => optional_present(value: lit)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn ulsh_refused_unrecognised(o: Outcome<Node>) -> Bool {
  match o {
    Rejected { diagnostics: d } => d.head.reason == ^body_lowering_reason_unrecognised_lowered_shape
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn ulsh_term_refused(n: Node) -> Bool {
  match body_term_of(node: n) {
    Rejected { diagnostics: d } => d.head.reason == ^body_lowering_reason_unrecognised_lowered_shape
    Accepted { value: _, diagnostics: _ } => false
  }
}

// RED if the fold re-reads the shape as raw parse or refuses it for another reason.
test fn an_unrecognised_lowered_shape_refuses_at_the_fold() -> Bool {
  ulsh_refused_unrecognised(o: body_lower_fold(node: ulsh_unknown_shape()))
}

// The refusal is located at the unrecognised node itself, not at the recognised node inside it.
test fn the_refusal_is_located_at_the_unrecognised_node() -> Bool {
  let outer = ulsh_unknown_over_transform()
  match body_lower_fold(node: outer) {
    Rejected { diagnostics: d } => d.head.at == node_locus(node: outer)
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn an_unrecognised_lowered_shape_refuses_at_the_operand_reader() -> Bool {
  match body_lower_operand_ref_read(node: ulsh_unknown_shape()) {
    OperandRefRefused { diagnostics: d } => d.head.reason == ^body_lowering_reason_unrecognised_lowered_shape
    OperandRefLowered { lowered: _ } => false
    OperandRefAbsent => false
  }
}

// THE RE-READ IS UNWRITABLE, NOT RECOGNISED BY SHAPE. A Transform no producer sealed was taken whole
// by the deleted allowlist; it is now neither a term nor raw parse, and refuses.
test fn an_unsealed_producer_output_refuses_at_the_fold() -> Bool {
  ulsh_refused_unrecognised(o: body_lower_fold(node: ulsh_unsealed_transform()))
}

// POSITIVE CONTROLS: what the parse writes is read as the parse wrote it, by a positive test.
test fn a_raw_parse_sequence_is_raw_parse() -> Bool {
  match body_term_of(node: ulsh_raw_sequence()) {
    Accepted { value: RawParse { node: _ }, diagnostics: _ } => true
    _ => false
  }
}

test fn a_childless_atom_is_a_raw_leaf() -> Bool {
  match body_term_of(node: ulsh_leaf()) {
    Accepted { value: RawLeaf { node: _ }, diagnostics: _ } => true
    _ => false
  }
}

test fn a_parse_minted_literal_token_is_a_raw_leaf() -> Bool {
  match ulsh_int_literal_token() {
    Absent => false
    Present { value: lit } =>
      match body_term_of(node: lit) {
        Accepted { value: RawLeaf { node: _ }, diagnostics: _ } => true
        _ => false
      }
  }
}

// The literal-token arm admits the token's own payload edge and nothing beside it.
test fn a_literal_token_carrying_a_foreign_edge_refuses() -> Bool {
  match ulsh_int_literal_token() {
    Absent => false
    Present { value: lit } =>
      ulsh_term_refused(n: node_synthetic(kind: lit.kind, children: [Edge { label: Authored { name: ^ulsh_probe_edge }, target: ulsh_leaf() }]))
  }
}

// THE ROUTE: a value position the fold lowers to a bare identifier. The postfix producer passes the
// atom through unchanged, and the atom must still leave the fold sealed as that producer's output.
// RED if the postfix arm of body_lower_reduce_emitted stops sealing: the atom then reads as a raw leaf.
data ulsh_route_source: String = "module ulsh_route\n\ndata ulsh_value: Int = ulsh_name\n"

// THE PARSE IS ONE NULLARY PRODUCER, filled in preparation under the single-claim fill debt of
// v2.workflow.floor_pure_producer_share floor_single_claim_fill_debt, as the door claim's is
// (v2.test.claim.body_lowering_data_literal_door door_data_literal_normalized). The
// route claim reads the postfix node it yields; building the language model, tokenizing and parsing
// inside the claim cost 399ms against a 302ms enrolment margin on the merge-group floor. It parses
// through the shared prepared grammar (g_tokenize_parse), the same route the door claim reads.
fn ulsh_route_postfix() -> Optional<Node> {
  match g_tokenize_parse(text: ulsh_route_source, file: ^ulsh_route_file) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: tree, diagnostics: _ } =>
      ulsh_first_emitted(root: tree, production: ^dag_surface_postfix_expr)
  }
}

fn ulsh_first_emitted(root: Node, production: Symbol) -> Optional<Node> {
  let own = match parse_production_emitted_identity_optional(node: root) {
    Present { value: e } => e == production
    Absent => false
  }
  if own {
    optional_present(value: root)
  } else {
    fold(root.children, init: optional_absent(), f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent => ulsh_first_emitted(root: e.target, production: production)
      }
    })
  }
}

test fn a_passed_through_atom_leaves_the_fold_sealed() -> Bool {
  match ulsh_route_postfix() {
        Absent => false
        Present { value: postfix } =>
          match body_lower_fold(node: postfix) {
            Rejected { diagnostics: _ } => false
            Accepted { value: folded, diagnostics: _ } =>
              match body_term_of(node: folded) {
                Accepted { value: Lowered { node: atom, shape: _ }, diagnostics: _ } =>
                  match node_atom_identity_optional(node: atom) {
                    Present { value: id } => id == ^ulsh_name
                    Absent => false
                  }
                _ => false
              }
          }
  }
}

// THE FORGERY WALL, ON THE SEED ACCEPTANCE PATH. The Lowered label carries a sole_constructor seal
// (v2.std.node BodyTermLoweredSeal) minted only for the body-lowering mint. A fixture that calls the
// seal's mint from outside its admitted caller refuses, and so does one that builds the seal record
// directly; the positive control is that the corpus compiles the real mint (this module resolves).
// Each fixture is well typed apart from the forgery (the seal carries a LoweredShape arm), so the
// forgery is the only thing that can refuse.
fn ulsh_refusals(source: String, wanted: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: wanted))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data ulsh_forged_mint_call_source: String = "module ulsh_forge_call\nimport v2.std.compilers.lowered_shape { LoweredOperand }\nimport v2.std.node { BodyTermLoweredSeal, body_term_lowered_seal }\nfn ulsh_forge() -> BodyTermLoweredSeal = body_term_lowered_seal(shape: LoweredOperand)\n"

data ulsh_forged_record_source: String = "module ulsh_forge_record\nimport v2.std.compilers.lowered_shape { LoweredOperand }\nimport v2.std.node { BodyTermLoweredSeal }\nfn ulsh_forge() -> BodyTermLoweredSeal = BodyTermLoweredSeal { shape: LoweredOperand }\n"

test fn a_forged_seal_mint_call_refuses() -> Bool {
  ulsh_refusals(source: ulsh_forged_mint_call_source, wanted: "ConstructorCallAdmissionRefused") >= 1
}

test fn a_forged_seal_record_refuses() -> Bool {
  ulsh_refusals(source: ulsh_forged_record_source, wanted: "SoleConstructorViolation") >= 1
}
