fn translate_accepts_synthetic_empty_facts_tree() -> Bool {
  match v2.compiler.translate.translate(tree: v2.test.manual.sg2_mode2_non_grammar_emit.sg2_mode2_inferred_tree, target: v2.test.manual.sg2_mode2_non_grammar_emit.sg2_mode2_target()) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn cross_language_compile_refuses_canonical_underived_holds() -> Bool {
  match v2.test.manual.python_grammar_claim.python_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: parse_tree, diagnostics: _ } =>
      match v2.compiler.ingest.cross_language_compile(
        parse_tree: parse_tree,
        source_model: v2.extdeps.languages.python.python_target_model(),
        target_model: v2.extdeps.languages.typescript.ts_target_model()
      ) {
        v2.std.diagnostic.Rejected { diagnostics: d } =>
          translate_refused_canonical_grounding(d: d)
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn translate_accepts_derived_rust_add_tree() -> Bool {
  match v2.compiler.translate.translate(tree: v2.test.manual.rust_add_emit_translate.rust_add_inferred_tree, target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn translate_derived_emit_byte_identical_to_before() -> Bool {
  match v2.compiler.emit.emit(tree: v2.test.manual.rust_add_emit_translate.rust_add_inferred_tree, target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == v2.extdeps.languages.rust.rust_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

