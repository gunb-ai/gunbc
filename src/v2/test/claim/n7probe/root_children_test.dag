module v2.test.n7probe.root_children

import v2.std.node { Edge, Node, Symbol }
import v2.std.diagnostic { Diagnostic }
import v2.test.n7probe.n7_provider { N7Leg }
import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn n7_leg(l: N7Leg) -> Int {
  l.target
}

fn n7_reason(d: Diagnostic) -> Symbol {
  d.reason
}

fn n7_children(root: Node) -> List<Edge> {
  root.children
}

test fn n7_probe_trivially_true() -> Bool {
  true
}
