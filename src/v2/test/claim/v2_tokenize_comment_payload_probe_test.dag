module v2.test.claim.v2_tokenize_comment_payload_probe

import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }

data v2_tokenize_comment_payload_probe_note: String = "SH-D: localizer named dag/std/algebra.dag as the first file in the use_site_verdict closure that refuses to lex. Its only // block (a standalone leading one, the form DESIGN 4c admits) carries a backtick and an em-dash in its PAYLOAD. Plain-ASCII // blocks tokenize, and non-ASCII inside string literals tokenizes, so the untested combination is the payload itself. If these reject, comment payloads are being lexed as ordinary tokens rather than routed through the annotation channel 4c specifies."

test fn ascii_comment_payload_control_tokenizes() -> Bool {
  match tokenize(text: "// plain note here\ndata x: String = \"p\"", file: ^probe, rules: dag_language_model().lex) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn backtick_in_comment_payload_rejects() -> Bool {
  match tokenize(text: "// reads `s` here\ndata x: String = \"p\"", file: ^probe, rules: dag_language_model().lex) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ds } => ds.head.reason == ^tokenize_lex_e1_unrecognized_char
  }
}

test fn em_dash_in_comment_payload_rejects() -> Bool {
  match tokenize(text: "// pattern — here\ndata x: String = \"p\"", file: ^probe, rules: dag_language_model().lex) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ds } => ds.head.reason == ^tokenize_lex_e1_unrecognized_char
  }
}
