module v2.test.claim.normalized_tree_admission

import v2.compiler.body_lowering_fold { body_lower_wrapper_retained_shell }
import v2.compiler.normalized_tree { admit_normalized_tree }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  Diagnostics,
  ExternalContractUnknown,
  None,
  Outcome,
  NonEmptyDiagnostics,
  Rejected,
  Some,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Conj, Node, TypeNode, node_synthetic }

data normalized_tree_admission_witness_note: String = "BL-1's discriminating evidence. The invalid state is a root carrying wrapper-retention evidence presented to resolve as normalized -- which was reachable while NormalizedTree was an alias for Node, because the carrier had no door to refuse at. These controls execute the door: retention refuses, a clean tree admits, and retention is found ANYWHERE in the diagnostic list rather than at its head, because rejected_with_pending prepends outer diagnostics and a head-only read is systematically wrong."

fn probe_shell() -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: [])
}

fn unrelated_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^normalized_tree_probe_unrelated_reason,
    at: node_locus(node: probe_shell()),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn retention_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^body_lowering_reason_wrapper_retained_emitted,
    at: node_locus(node: probe_shell()),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn is_rejected(o: Outcome<v2.compiler.normalized_tree.NormalizedTree>) -> Bool {
  match o {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn a_retained_root_is_refused_at_the_carrier_door() -> Bool {
  is_rejected(o: admit_normalized_tree(
    root: probe_shell(),
    diagnostics: Some {
      diagnostics: NonEmptyDiagnostics { head: retention_diagnostic(), tail: [] }
    }
  ))
}

test fn retention_is_found_past_the_diagnostic_head_RED() -> Bool {
  is_rejected(o: admit_normalized_tree(
    root: probe_shell(),
    diagnostics: Some {
      diagnostics: NonEmptyDiagnostics {
        head: unrelated_diagnostic(),
        tail: [retention_diagnostic()]
      }
    }
  ))
}

test fn a_clean_root_is_admitted_positive_control() -> Bool {
  (is_rejected(o: admit_normalized_tree(root: probe_shell(), diagnostics: None)) == false)
}

test fn an_unrelated_diagnostic_does_not_refuse_RED() -> Bool {
  (is_rejected(o: admit_normalized_tree(
    root: probe_shell(),
    diagnostics: Some {
      diagnostics: NonEmptyDiagnostics { head: unrelated_diagnostic(), tail: [] }
    }
  )) == false)
}

test fn the_production_retention_producer_is_refused_by_the_door() -> Bool {
  match body_lower_wrapper_retained_shell(shell: probe_shell()) {
    Accepted { value: v, diagnostics: d } => is_rejected(o: admit_normalized_tree(root: v, diagnostics: d))
    Rejected { diagnostics: _ } => false
  }
}
