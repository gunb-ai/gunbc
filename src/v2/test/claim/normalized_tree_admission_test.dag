module v2.test.claim.normalized_tree_admission


data normalized_tree_admission_witness_note: String = "BL-1's discriminating evidence. The invalid state is a root carrying wrapper-retention evidence presented to resolve as normalized -- which was reachable while NormalizedTree was an alias for Node, because the carrier had no door to refuse at. These controls execute the door: retention refuses, a clean tree admits, and retention is found ANYWHERE in the diagnostic list rather than at its head, because rejected_with_pending prepends outer diagnostics and a head-only read is systematically wrong."

fn probe_shell() -> v2.std.node.Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: Conj }, children: [])
}

fn unrelated_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^normalized_tree_probe_unrelated_reason,
    at: node_locus(node: v2.test.claim.normalized_tree_admission.probe_shell()),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn retention_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^body_lowering_reason_wrapper_retained_emitted,
    at: node_locus(node: v2.test.claim.normalized_tree_admission.probe_shell()),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn is_rejected(o: v2.std.diagnostic.Outcome<v2.compiler.normalized_tree.NormalizedTree>) -> v2.std.logic.Bool {
  match o {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn a_retained_root_is_refused_at_the_carrier_door() -> v2.std.logic.Bool {
  v2.test.claim.normalized_tree_admission.is_rejected(o: admit_normalized_tree(
    root: v2.test.claim.normalized_tree_admission.probe_shell(),
    diagnostics: v2.std.diagnostic.Some {
      diagnostics: v2.std.diagnostic.NonEmptyDiagnostics { head: retention_diagnostic(), tail: [] }
    }
  ))
}

test fn retention_is_found_past_the_diagnostic_head_RED() -> v2.std.logic.Bool {
  v2.test.claim.normalized_tree_admission.is_rejected(o: admit_normalized_tree(
    root: v2.test.claim.normalized_tree_admission.probe_shell(),
    diagnostics: v2.std.diagnostic.Some {
      diagnostics: v2.std.diagnostic.NonEmptyDiagnostics {
        head: v2.test.claim.normalized_tree_admission.unrelated_diagnostic(),
        tail: [retention_diagnostic()]
      }
    }
  ))
}

test fn a_clean_root_is_admitted_positive_control() -> v2.std.logic.Bool {
  (v2.test.claim.normalized_tree_admission.is_rejected(o: admit_normalized_tree(root: v2.test.claim.normalized_tree_admission.probe_shell(), diagnostics: v2.std.diagnostic.None)) == false)
}

test fn an_unrelated_diagnostic_does_not_refuse_RED() -> v2.std.logic.Bool {
  (v2.test.claim.normalized_tree_admission.is_rejected(o: admit_normalized_tree(
    root: v2.test.claim.normalized_tree_admission.probe_shell(),
    diagnostics: v2.std.diagnostic.Some {
      diagnostics: v2.std.diagnostic.NonEmptyDiagnostics { head: v2.test.claim.normalized_tree_admission.unrelated_diagnostic(), tail: [] }
    }
  )) == false)
}

test fn the_production_retention_producer_is_refused_by_the_door() -> v2.std.logic.Bool {
  match body_lower_wrapper_retained_shell(shell: v2.test.claim.normalized_tree_admission.probe_shell()) {
    Accepted { value: v, diagnostics: d } => v2.test.claim.normalized_tree_admission.is_rejected(o: admit_normalized_tree(root: v, diagnostics: d))
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn two_probe_roots() -> FreeMonoid<v2.std.node.Node> {
  std.algebra.Cons { head: v2.test.claim.normalized_tree_admission.probe_shell(), tail: std.algebra.Cons { head: v2.test.claim.normalized_tree_admission.probe_shell(), tail: std.algebra.Empty } }
}

test fn plural_admission_does_not_duplicate_shared_diagnostics_RED() -> v2.std.logic.Bool {
  match admit_normalized_roots(
    roots: two_probe_roots(),
    diagnostics: v2.std.diagnostic.Some {
      diagnostics: v2.std.diagnostic.NonEmptyDiagnostics { head: v2.test.claim.normalized_tree_admission.unrelated_diagnostic(), tail: [] }
    }
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: d } =>
      diagnostics_eq(
        a: d,
        b: v2.std.diagnostic.Some {
          diagnostics: v2.std.diagnostic.NonEmptyDiagnostics { head: v2.test.claim.normalized_tree_admission.unrelated_diagnostic(), tail: [] }
        }
      )
  }
}

test fn plural_admission_refuses_a_retained_batch() -> v2.std.logic.Bool {
  match admit_normalized_roots(
    roots: two_probe_roots(),
    diagnostics: v2.std.diagnostic.Some {
      diagnostics: v2.std.diagnostic.NonEmptyDiagnostics { head: retention_diagnostic(), tail: [] }
    }
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
