// L-NEW-b witness: containment-only traversal excludes reference edges (fail-closed grant scope).

module v2.test.claim.edge_role_containment_fold

import v2.std.dependency {
  BootstrapDependsOn,
  BindsTo,
  Contains,
  DependencyView,
  ModuleDependsOn,
  dependency_lens
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Bind,
  ComputationNode,
  Conj,
  Edge,
  Named,
  Node,
  TypeNode,
  SyntheticOccurrence,
  containment_subtree_nodes,
  named_containment_edge,
  named_reference_edge
}

data edge_role_contained_child: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^edge_role_contained_child_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data edge_role_referenced_child: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^edge_role_referenced_child_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data edge_role_mixed_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    named_containment_edge(name: ^edge_role_contained_field, target: edge_role_contained_child),
    named_reference_edge(name: ^dependency_binds_to_edge, target: edge_role_referenced_child)
  ],
  occurrence_id: SyntheticOccurrence
}

fn containment_subtree_excludes_reference_child_holds() -> Bool {
  let nodes = containment_subtree_nodes(root: edge_role_mixed_root)
  fold(nodes, init: true, f: fn(acc, n) {
    acc && (n != edge_role_referenced_child)
  })
}

fn dependency_lens_reference_edge_is_not_contains_holds() -> Bool {
  fold(dependency_lens(root: edge_role_mixed_root), init: true, f: fn(acc, view) {
    if view.dependent == edge_role_referenced_child {
      acc && (view.kind == BindsTo)
    } else if view.dependent == edge_role_contained_child {
      acc && (view.kind == Contains)
    } else {
      acc
    }
  })
}

data edge_role_bind_body_child: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^edge_role_bind_body_child_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data edge_role_bind_parent: Node = Node {
  kind: ComputationNode { behavior: Bind },
  children: [
    named_reference_edge(name: ^dependency_binds_to_edge, target: edge_role_bind_body_child)
  ],
  occurrence_id: SyntheticOccurrence
}

fn dependency_lens_bind_body_binds_to_edge_is_contains_holds() -> Bool {
  fold(dependency_lens(root: edge_role_bind_parent), init: true, f: fn(acc, view) {
    if view.dependent == edge_role_bind_body_child {
      acc && (view.kind == Contains)
    } else {
      acc
    }
  })
}

test fn dependency_lens_bind_body_binds_to_edge_is_contains() -> Bool {
  dependency_lens_bind_body_binds_to_edge_is_contains_holds()
}

test fn containment_subtree_excludes_reference_child() -> Bool {
  containment_subtree_excludes_reference_child_holds()
}

test fn dependency_lens_reference_edge_is_not_contains() -> Bool {
  dependency_lens_reference_edge_is_not_contains_holds()
}

data edge_role_module_import_child: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^edge_role_module_import_child_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data edge_role_module_import_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    named_reference_edge(name: ^dependency_module_import_edge, target: edge_role_module_import_child)
  ],
  occurrence_id: SyntheticOccurrence
}

fn dependency_lens_module_import_edge_is_module_depends_on_holds() -> Bool {
  fold(dependency_lens(root: edge_role_module_import_root), init: true, f: fn(acc, view) {
    if view.dependent == edge_role_module_import_child {
      acc && (view.kind == ModuleDependsOn)
    } else {
      acc
    }
  })
}

test fn dependency_lens_module_import_edge_is_module_depends_on() -> Bool {
  dependency_lens_module_import_edge_is_module_depends_on_holds()
}

data edge_role_bootstrap_depends_child: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^edge_role_bootstrap_depends_child_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data edge_role_bootstrap_depends_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    named_reference_edge(name: ^dependency_bootstrap_depends_edge, target: edge_role_bootstrap_depends_child)
  ],
  occurrence_id: SyntheticOccurrence
}

fn dependency_lens_bootstrap_depends_edge_is_bootstrap_depends_on_holds() -> Bool {
  fold(dependency_lens(root: edge_role_bootstrap_depends_root), init: true, f: fn(acc, view) {
    if view.dependent == edge_role_bootstrap_depends_child {
      acc && (view.kind == BootstrapDependsOn)
    } else {
      acc
    }
  })
}

test fn dependency_lens_bootstrap_depends_edge_is_bootstrap_depends_on() -> Bool {
  dependency_lens_bootstrap_depends_edge_is_bootstrap_depends_on_holds()
}
