module v2.test.claim.determinism_contract_test

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.determinism {
  Determinism,
  Deterministic,
  NonDeterministic,
  determinism_compose,
  determinism_from_perturbation
}
import std.perturbation { ResponseConsistent, ResponseViolation }
import v2.std.determinism {
  DeterminismFact,
  determinism_fact_classification,
  determinism_fact_signature
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn example_root() -> DeclarationRef {
  DeclarationRef {
    module_path: "std.resources",
    decl_name: "Clock",
    field: WholeDeclaration
  }
}

fn det_is_deterministic(c: Determinism) -> Bool {
  match c {
    Deterministic => true
    NonDeterministic { source: _ } => false
  }
}

test fn determinism_perturbation_consistent_is_deterministic() -> Bool {
  det_is_deterministic(
    c: determinism_from_perturbation(verdict: ResponseConsistent, reached: example_root())
  )
}

test fn determinism_perturbation_violation_is_nondeterministic() -> Bool {
  !det_is_deterministic(
    c: determinism_from_perturbation(verdict: ResponseViolation, reached: example_root())
  )
}

test fn determinism_compose_det_det_is_deterministic() -> Bool {
  det_is_deterministic(
    c: determinism_compose(outer: Deterministic, inner: Deterministic)
  )
}

test fn determinism_compose_nondet_left_propagates() -> Bool {
  !det_is_deterministic(
    c: determinism_compose(
      outer: NonDeterministic { source: example_root() },
      inner: Deterministic
    )
  )
}

test fn determinism_compose_nondet_right_propagates() -> Bool {
  !det_is_deterministic(
    c: determinism_compose(
      outer: Deterministic,
      inner: NonDeterministic { source: example_root() }
    )
  )
}

test fn determinism_fact_binds_signature_and_classification() -> Bool {
  let fact = DeterminismFact {
    signature: ^emit_export_set,
    classification: Deterministic
  }
  det_is_deterministic(c: determinism_fact_classification(fact: fact))
    && (determinism_fact_signature(fact: fact) == ^emit_export_set)
}