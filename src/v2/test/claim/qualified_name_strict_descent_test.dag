module v2.test.claim.qualified_name_strict_descent

import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.text { String }
import v2.std.qualified_name {
  QualifiedName,
  qualified_name_from_string_segments,
  qualified_name_is_strict_descendant
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn qn(segments: List<String>) -> QualifiedName {
  qualified_name_from_string_segments(segments: segments)
}

fn container() -> QualifiedName {
  qn(segments: ["gunbc", "row"])
}

test fn strict_descent_admits_a_child_and_refuses_a_sibling() -> Bool {
  qualified_name_is_strict_descendant(container: container(), candidate: qn(segments: ["gunbc", "row", "first"]))
    && !qualified_name_is_strict_descendant(container: container(), candidate: qn(segments: ["gunbc", "other", "first"]))
}

// `row` is a textual prefix of `rowing`, and containment must refuse it: this is the control that
// separates a segment-wise relation from a string one, and it is the case a dotted-string
// implementation gets wrong while passing every other probe here.
test fn strict_descent_refuses_a_segment_that_merely_starts_with_the_container() -> Bool {
  !qualified_name_is_strict_descendant(container: container(), candidate: qn(segments: ["gunbc", "rowing"]))
}

test fn strict_descent_refuses_the_container_itself() -> Bool {
  !qualified_name_is_strict_descendant(container: container(), candidate: container())
}

test fn strict_descent_admits_a_deeper_descendant() -> Bool {
  qualified_name_is_strict_descendant(
    container: container(),
    candidate: qn(segments: ["gunbc", "row", "first", "nested"])
  )
}

// Descent is not symmetric: an ancestor is not beneath its own descendant.
test fn strict_descent_refuses_the_reverse_direction() -> Bool {
  !qualified_name_is_strict_descendant(
    container: qn(segments: ["gunbc", "row", "first"]),
    candidate: container()
  )
}
