module v2.test.extdeps_external_authority.corpus.facts_readback_verdict_perturb

import v2.lens.extdeps_external_authority {
  extdeps_external_authority_clean_for_module,
  extdeps_external_authority_has_missing_formal_anchor,
  extdeps_external_authority_violation_count_for_module,
}
import v2.lens.extdeps_external_authority.module_refs {
  extdeps_fixture_clean_https_module,
  extdeps_fixture_missing_anchor_module,
}
import v2.std.logic { Bool }

fn witness_computed_facts_readback_holds() -> Bool {
  extdeps_external_authority_clean_for_module(module: extdeps_fixture_clean_https_module)
}

fn witness_literal_perturb_facts_readback_red() -> Bool {
  extdeps_external_authority_violation_count_for_module(
    module: extdeps_fixture_missing_anchor_module
  ) == 1
    && extdeps_external_authority_has_missing_formal_anchor(
      module: extdeps_fixture_missing_anchor_module
    )
}

test fn extdeps_external_authority_facts_readback_verdict_perturb_witness() -> Bool {
  witness_computed_facts_readback_holds()
    && witness_literal_perturb_facts_readback_red()
}
