module v2.test.extdeps_external_authority.corpus.backfill_roster_soundness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data planted_stale_backfill_entry: QualifiedName = Cons {
  head: ^extdeps,
  tail: Cons { head: ^nonexistent_planted_backfill_module, tail: Empty }
}

fn qn_list_contains(xs: List<QualifiedName>, target: QualifiedName) -> Bool {
  any(xs: xs, predicate: fn(m) { m == target })
}

fn backfill_roster_sound(roster: List<QualifiedName>, live: List<QualifiedName>) -> Bool {
  for_all(xs: roster, predicate: fn(entry) { qn_list_contains(xs: live, target: entry) })
}

test fn extdeps_external_authority_backfill_roster_planted_stale_red_holds() -> Bool {
  backfill_roster_sound(
    roster: list_append(
      left: extdeps_external_authority_backfill_entries(),
      right: [planted_stale_backfill_entry]
    ),
    live: extdeps_derived_extdeps_modules()
  ) == false
}

test fn extdeps_external_authority_backfill_roster_soundness_holds() -> Bool {
  backfill_roster_sound(
    roster: extdeps_external_authority_backfill_entries(),
    live: extdeps_derived_extdeps_modules()
  )
    && extdeps_external_authority_backfill_roster_planted_stale_red_holds()
}
