module v2.test.claim.bash_program_fold

import extdeps.languages.bash.program {
  CmdSubst,
  Concat,
  Lit,
  ShellProgram,
  StderrToNull,
  VarRef,
  WithRedir,
  assign,
  command,
  lit,
  serialize_bash
}
import tools.host_prelude { ClaimRun, assign_root_stmt, gunbc_claims_program, witness_bin, witness_bin_program }
import v2.workflow.bash_program_emit { bash_program_serialize }
import v2.std.diagnostic { Accepted, Diagnostic, Outcome, Rejected }

fn bash_program_fold_sample() -> ShellProgram {
  ShellProgram {
    set_e: true,
    statements: [
      command(words: [lit(text: "echo"), lit(text: "hi")]),
      assign(name: "X", value: lit(text: "1"))
    ]
  }
}

fn bash_program_fold_sample_no_set_e() -> ShellProgram {
  ShellProgram {
    set_e: false,
    statements: [
      command(words: [lit(text: "echo"), lit(text: "hi")]),
      assign(name: "X", value: lit(text: "1"))
    ]
  }
}

fn bash_program_serialize_matches_sidecar(p: ShellProgram) -> Bool {
  match bash_program_serialize(p: p) {
    Accepted { value: folded, diagnostics: _ } => folded == serialize_bash(p: p)
    Rejected { diagnostics: _ } => false
  }
}

test fn bash_program_serialize_matches_oracle_holds() -> Bool {
  bash_program_serialize_matches_sidecar(p: bash_program_fold_sample())
}

test fn bash_program_serialize_set_e_has_teeth_holds() -> Bool {
  match bash_program_serialize(p: bash_program_fold_sample()) {
    Accepted { value: folded, diagnostics: _ } =>
      folded != serialize_bash(p: bash_program_fold_sample_no_set_e())
    Rejected { diagnostics: _ } => false
  }
}

fn bash_program_depth2_cmdsubst_sample() -> ShellProgram {
  ShellProgram {
    set_e: false,
    statements: [
      assign(name: "ROOT", value: CmdSubst {
        body: command(words: [lit(text: "pwd")])
      })
    ]
  }
}

fn bash_program_depth2_redir_sample() -> ShellProgram {
  ShellProgram {
    set_e: false,
    statements: [
      WithRedir {
        stmt: command(words: [lit(text: "git"), lit(text: "rev-parse")]),
        redir: StderrToNull
      }
    ]
  }
}

fn bash_program_depth2_concat_sample() -> ShellProgram {
  ShellProgram {
    set_e: false,
    statements: [
      assign(name: "BIN", value: Concat {
        parts: [VarRef { name: "ROOT" }, Lit { text: "/target/release/gunbc" }]
      })
    ]
  }
}

test fn bash_program_serialize_cmdsubst_matches_oracle_holds() -> Bool {
  bash_program_serialize_matches_sidecar(p: bash_program_depth2_cmdsubst_sample())
}

test fn bash_program_serialize_redir_matches_oracle_holds() -> Bool {
  bash_program_serialize_matches_sidecar(p: bash_program_depth2_redir_sample())
}

test fn bash_program_serialize_concat_matches_oracle_holds() -> Bool {
  bash_program_serialize_matches_sidecar(p: bash_program_depth2_concat_sample())
}

data bash_program_fold_real_program_probe_note: String = "The real-program builders below are MANUAL probes, deliberately not test fns: whole-tree backward row-selection is superlinear in nesting depth (measured 2026-07-10: ~1s flat, 64s for the single depth-4 assign_root_stmt, unfinished after 8min for the full witness program), so a discovery-run test over them would hang the local floor. Byte-identity for the compound constructs is proven by the depth-2 oracle tests above plus the manual assign_root probe. Dissolves when the backward-selection cost shape is fixed (see bash_program_emit_cost_wall_note in v2.workflow.bash_program_emit) or when witness transports become typed argv invocations and stop serializing bash at runtime."

fn bash_program_fold_real_witness_program() -> ShellProgram {
  witness_bin_program(
    invoke: witness_bin(var_name: "V1_DAG_PARSE", bin_name: "v1srcdag_parse"),
    prereqs: [],
    args: ["--entry", "dag/std/algebra.dag"]
  )
}

fn bash_program_fold_real_claims_program() -> ShellProgram {
  gunbc_claims_program(
    source_roots: ["src/v2", "dag"],
    claims: [ClaimRun { entry: "src/v2/test/claim/bash_program_fold_test.dag", function: "bash_program_serialize_matches_oracle_holds" }]
  )
}

fn bash_program_serialize_real_witness_probe() -> Outcome<String> {
  bash_program_serialize(p: bash_program_fold_real_witness_program())
}

fn bash_program_serialize_depth_probe_assign_root() -> Outcome<String> {
  bash_program_serialize(p: ShellProgram { set_e: false, statements: [assign_root_stmt()] })
}

fn bash_program_real_witness_probe_matches_sidecar() -> Bool {
  bash_program_serialize_matches_sidecar(p: bash_program_fold_real_witness_program())
}

fn bash_program_assign_root_probe_matches_sidecar() -> Bool {
  bash_program_serialize_matches_sidecar(p: ShellProgram { set_e: false, statements: [assign_root_stmt()] })
}
