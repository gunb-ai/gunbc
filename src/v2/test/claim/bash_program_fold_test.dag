module v2.test.claim.bash_program_fold

import v2.extdeps.languages.bash_build {
  bash_build_and_then,
  bash_build_assign,
  bash_build_assign_lit,
  bash_build_command_from_lits,
  bash_build_command_from_word_nodes,
  bash_build_command_words_pair,
  bash_build_command_words_single,
  bash_build_exit,
  bash_build_if_from_stmts,
  bash_build_or_else,
  bash_build_subshell_from_stmts,
  bash_build_with_redir,
  bash_build_word_cmdsubst,
  bash_build_word_concat,
  bash_build_word_concat_from_nodes,
  bash_build_word_lit,
  bash_build_word_var
}
import v2.workflow.bash_emit {
  BashEmitSpecial,
  BashEmitStmt,
  BashEmitTagged,
  bash_emit_matches_golden,
  bash_emit_program,
  bash_emit_program_matches_golden
}
import v2.std.algebra { list_append, list_map }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.test.claim.bash_program_fold_support {
  bash_program_fixture_assign_root_node,
  bash_program_fold_tag_assign,
  bash_program_fold_tag_command,
  bash_program_fold_tag_if,
  bash_program_fold_tag_or_else,
  bash_program_fold_tag_subshell,
  bash_program_fold_tag_with_redir
}


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data bash_program_fold_golden_note: String = "Goldens below are hand-authored expected bytes, deliberately independent of extdeps.languages.bash.program serialize_bash and of the grammar rows/segment spellings. Each test compares bash_emit_program (row-emit) against its golden only, so a row/emitter regression cannot go green by perturbing both sides at once (PR #6467 ci_cargo_eagain_retry_core_golden pattern)."

data bash_program_fold_sample_set_e_golden: String = "set -e\n'echo' 'hi'\nX='1'\n"
data bash_program_fold_sample_no_set_e_golden: String = "'echo' 'hi'\nX='1'\n"
data bash_program_depth2_cmdsubst_golden: String = "ROOT=$('pwd')\n"
data bash_program_depth2_redir_golden: String = "'git' 'rev-parse' 2>/dev/null\n"
data bash_program_depth2_concat_golden: String = "BIN=\"$ROOT\"'/target/release/gunbc'\n"
data bash_program_assign_root_golden: String = "ROOT=$('git' 'rev-parse' '--show-toplevel' 2>/dev/null || 'pwd')\n"
data bash_program_exit_subshell_golden: String = "('echo' 'hi'; exit 1)\n"
data bash_program_exit_if_golden: String = "if 'true'; then 'echo' 'hi'; exit 1; fi\n"
data bash_program_andor_exit_golden: String = "'true' || exit 1\n"

data bash_program_mktemp_rm_golden: String = "set -e\nOUT=$('mktemp' '-d')\n'rm' '-rf' \"$OUT\"\n"
data bash_program_metachars_quoted_golden: String = "'echo' '$(rm -rf /)'\n"
data bash_program_varref_vs_lit_golden: String = "\"$ROOT\" 'ROOT'\n"

data bash_program_real_offline_disposition_note: String = "Real-program golden probes execute as test fns under src/v2/test/claim/long/bash_program_real_probes_witness_test.dag (OfflineLocalRecipe) — review 43557; never if-false pins. Goldens below remain the oracle in this module."

data bash_program_real_witness_golden: String = "set -e\nROOT=$('git' 'rev-parse' '--show-toplevel' 2>/dev/null || 'pwd')\nV1_DAG_PARSE=\"$ROOT\"'/target/release/v1srcdag_parse'\nif '[' '!' '-x' \"$V1_DAG_PARSE\" ']'; then ('cd' \"$ROOT\" && 'cargo' 'build' '-p' 'v1-compiler' '--release' '--bin' 'v1srcdag_parse') || exit 1; fi\nif '[' '!' '-x' \"$V1_DAG_PARSE\" ']'; then 'echo' '::error::build verification: declared artifact '\\''v1srcdag_parse'\\'' absent or not executable after a '\\''successful'\\'' build (sccache/cache corruption — DESIGN §5 fail-open); failing closed: '\"$V1_DAG_PARSE\" >&2; exit 1; fi\nif '[' '!' '-s' \"$V1_DAG_PARSE\" ']'; then 'echo' '::error::build verification: declared artifact '\\''v1srcdag_parse'\\'' is zero-byte after a '\\''successful'\\'' build (sccache served a truncated/empty cached artifact — DESIGN §5 fail-open); failing closed: '\"$V1_DAG_PARSE\" >&2; exit 1; fi\n'cd' \"$ROOT\"\n\"$V1_DAG_PARSE\" '--entry' 'dag/std/algebra.dag'\n"

data bash_program_real_claims_golden: String = "set -e\nROOT=$('git' 'rev-parse' '--show-toplevel' 2>/dev/null || 'pwd')\nGUNBC=\"$ROOT\"'/target/release/gunbc'\nif '[' '!' '-x' \"$GUNBC\" ']'; then ('cd' \"$ROOT\" && 'cargo' 'build' '-p' 'v1-compiler' '--release' '--bin' 'gunbc') || exit 1; fi\nif '[' '!' '-x' \"$GUNBC\" ']'; then 'echo' '::error::build verification: declared artifact '\\''gunbc'\\'' absent or not executable after a '\\''successful'\\'' build (sccache/cache corruption — DESIGN §5 fail-open); failing closed: '\"$GUNBC\" >&2; exit 1; fi\nif '[' '!' '-s' \"$GUNBC\" ']'; then 'echo' '::error::build verification: declared artifact '\\''gunbc'\\'' is zero-byte after a '\\''successful'\\'' build (sccache served a truncated/empty cached artifact — DESIGN §5 fail-open); failing closed: '\"$GUNBC\" >&2; exit 1; fi\n\"$GUNBC\" 'run' '--source-root' 'src/v2' '--source-root' 'dag' '--entry' 'src/v2/test/claim/bash_program_fold_test.dag' '--function' 'bash_program_serialize_matches_golden_holds' '--claim-run'\n"

data bash_program_exit_tail_regression_note: String = "The exit-in-joined-tail tests below are the discriminating controls for the improper-string class fixed in 06_translate (serialize joins once built modeled cons cells with the last spelling attached as an improper native tail; interp == NORMALIZES a top-level hybrid, so a matches-golden oracle alone can be fooled when both sides carry the same hybrid - which is why the literal-equality witness exists: it is normalization-independent). Red before the concat grounding of serialize_concrete_syntax_tokens_to_source_string / target_serialize_relation_row_from_model_bounded / token_sequence_to_source_bounded; green after. Declared residue of the same class (not yet grounded, no bash-row consumer today): the type-expression joins in 06_translate (serialize_type_expr_args/separated/record_fields) and the list_append string joins in emit_produced.dag / emit_module.dag - the follow-up sweep grounds them the same way (native concat accumulator), priced by the first oracle that reds on them."

fn bash_program_fold_sample_specials() -> List<BashEmitSpecial> {
  [
    bash_program_fold_tag_command(node: bash_build_command_from_lits(lits: ["echo", "hi"])),
    bash_program_fold_tag_assign(node: bash_build_assign_lit(name: "X", text: "1"))
  ]
}

fn bash_program_depth2_cmdsubst_specials() -> List<BashEmitSpecial> {
  [
    bash_program_fold_tag_assign(
      node: bash_build_assign(
        name: "ROOT",
        value: bash_build_word_cmdsubst(
          body: bash_build_command_from_lits(lits: ["pwd"])
        )
      )
    )
  ]
}

fn bash_program_depth2_redir_specials() -> List<BashEmitSpecial> {
  [
    bash_program_fold_tag_with_redir(
      node: bash_build_with_redir(
        inner: bash_build_command_from_lits(lits: ["git", "rev-parse"]),
        redir: ^bash_production_fold_redir_stderr_null
      )
    )
  ]
}

fn bash_program_depth2_concat_specials() -> List<BashEmitSpecial> {
  [
    bash_program_fold_tag_assign(
      node: bash_build_assign(
        name: "BIN",
        value: bash_build_word_concat(
          parts: bash_build_command_words_pair(
            left: bash_build_command_words_single(word: bash_build_word_var(name: "ROOT")),
            right: bash_build_word_lit(text: "/target/release/gunbc")
          )
        )
      )
    )
  ]
}

fn bash_program_mktemp_rm_specials() -> List<BashEmitSpecial> {
  [
    bash_program_fold_tag_assign(
      node: bash_build_assign(
        name: "OUT",
        value: bash_build_word_cmdsubst(
          body: bash_build_command_from_lits(lits: ["mktemp", "-d"])
        )
      )
    ),
    bash_program_fold_tag_command(
      node: bash_build_command_from_word_nodes(words: [
        bash_build_word_lit(text: "rm"),
        bash_build_word_lit(text: "-rf"),
        bash_build_word_var(name: "OUT")
      ])
    )
  ]
}

test fn bash_program_mktemp_rm_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: bash_program_mktemp_rm_specials(),
    set_e: true,
    golden: bash_program_mktemp_rm_golden
  )
}

test fn bash_program_metachars_quoted_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: [
      bash_program_fold_tag_command(
        node: bash_build_command_from_lits(lits: ["echo", "$(rm -rf /)"])
      )
    ],
    set_e: false,
    golden: bash_program_metachars_quoted_golden
  )
}

test fn bash_program_varref_vs_lit_quoting_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: [
      bash_program_fold_tag_command(
        node: bash_build_command_from_word_nodes(words: [
          bash_build_word_var(name: "ROOT"),
          bash_build_word_lit(text: "ROOT")
        ])
      )
    ],
    set_e: false,
    golden: bash_program_varref_vs_lit_golden
  )
}

test fn bash_program_serialize_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: bash_program_fold_sample_specials(),
    set_e: true,
    golden: bash_program_fold_sample_set_e_golden
  )
}

test fn bash_program_serialize_set_e_has_teeth_holds() -> Bool {
  match bash_emit_program(statements: bash_program_fold_sample_specials(), set_e: true) {
    Accepted { value: folded, diagnostics: _ } =>
      folded != bash_program_fold_sample_no_set_e_golden
    Rejected { diagnostics: _ } => false
  }
}

test fn bash_program_serialize_cmdsubst_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: bash_program_depth2_cmdsubst_specials(),
    set_e: false,
    golden: bash_program_depth2_cmdsubst_golden
  )
}

test fn bash_program_serialize_redir_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: bash_program_depth2_redir_specials(),
    set_e: false,
    golden: bash_program_depth2_redir_golden
  )
}

test fn bash_program_serialize_concat_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: bash_program_depth2_concat_specials(),
    set_e: false,
    golden: bash_program_depth2_concat_golden
  )
}


test fn bash_program_assign_root_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: [bash_program_fold_tag_assign(node: bash_program_fixture_assign_root_node())],
    set_e: false,
    golden: bash_program_assign_root_golden
  )
}

test fn bash_program_exit_in_subshell_tail_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: [
      bash_program_fold_tag_subshell(
        node: bash_build_subshell_from_stmts(stmts: [
          bash_build_command_from_lits(lits: ["echo", "hi"]),
          bash_build_exit(code: "1")
        ])
      )
    ],
    set_e: false,
    golden: bash_program_exit_subshell_golden
  )
}

test fn bash_program_exit_in_if_body_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: [
      bash_program_fold_tag_if(
        node: bash_build_if_from_stmts(
          cond: bash_build_command_from_lits(lits: ["true"]),
          then_stmts: [
            bash_build_command_from_lits(lits: ["echo", "hi"]),
            bash_build_exit(code: "1")
          ]
        )
      )
    ],
    set_e: false,
    golden: bash_program_exit_if_golden
  )
}

test fn bash_program_exit_spelling_literal_holds() -> Bool {
  bash_emit_matches_golden(
    stmt: BashEmitStmt {
      node: bash_build_subshell_from_stmts(stmts: [
        bash_build_command_from_lits(lits: ["echo", "hi"]),
        bash_build_exit(code: "1")
      ]),
      production_binding: ^bash_production_fold_subshell,
      rule_name: ^bash_relation_rule_fold_subshell
    },
    golden: "('echo' 'hi'; exit 1)"
  )
}

test fn bash_program_andor_exit_matches_golden_holds() -> Bool {
  bash_emit_program_matches_golden(
    statements: [
      bash_program_fold_tag_or_else(
        node: bash_build_or_else(
          left: bash_build_command_from_lits(lits: ["true"]),
          right: bash_build_exit(code: "1")
        )
      )
    ],
    set_e: false,
    golden: bash_program_andor_exit_golden
  )
}


