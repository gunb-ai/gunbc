module v2.test.claim.floor_non_verdict_admission_test


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data roster_fixture: List<String> = std.algebra.Cons { head: "m.a", tail: std.algebra.Cons { head: "m.b", tail: std.algebra.Cons { head: "m.c", tail: v2.std.algebra.Empty {} } } }

// UNCHANGED: the population is exactly the roster.
data observed_unchanged: List<String> = std.algebra.Cons { head: "m.a", tail: std.algebra.Cons { head: "m.b", tail: std.algebra.Cons { head: "m.c", tail: v2.std.algebra.Empty {} } } }

// REPAID: two identities now answer while their roster rows still stand. Must REFUSE -- not
// because repayment is penalised, but because a row the run no longer observes is a stale row
// asserting a debt that no longer exists, and the executing gate refuses exactly that
// (stale_non_verdict is a conjunct of required_floor_outcome_is_clean). Repaying and deleting the
// row are one act; the fixture below drives the deleted-row form and is admitted.
data observed_repaid: List<String> = std.algebra.Cons { head: "m.b", tail: v2.std.algebra.Empty {} }

// GROWN: a fourth identity begins producing no verdict. Must refuse.
data observed_grown: List<String> = std.algebra.Cons { head: "m.a", tail: std.algebra.Cons { head: "m.b", tail: std.algebra.Cons { head: "m.c", tail: std.algebra.Cons { head: "m.d", tail: v2.std.algebra.Empty {} } } } }

// THE DISCRIMINATING CASE, AND THE REASON THE ADMISSION IS NOT A COUNT. `m.c` was repaired and
// `m.d` began throwing in the same change. The population is STILL THREE IDENTITIES, so every
// count in the run is identical to the unchanged case -- and a repaired witness has bought
// permission for an unrelated witness to lose its verdict. This is the mutation a count-based
// implementation passes silently.
data observed_swapped: List<String> = std.algebra.Cons { head: "m.a", tail: std.algebra.Cons { head: "m.b", tail: std.algebra.Cons { head: "m.d", tail: v2.std.algebra.Empty {} } } }

test fn unchanged_population_is_admitted() -> Bool {
  v2.workflow.floor_non_verdict_admission.non_verdict_admits(observed: observed_unchanged, roster: roster_fixture)
}

test fn repayment_that_leaves_the_row_behind_refuses_and_is_reported_per_identity() -> Bool {
  !v2.workflow.floor_non_verdict_admission.non_verdict_admits(observed: observed_repaid, roster: roster_fixture)
    && v2.std.algebra.length(xs: v2.workflow.floor_non_verdict_admission.non_verdict_repaid(observed: observed_repaid, roster: roster_fixture)) == 2
    && v2.std.algebra.length(xs: v2.workflow.floor_non_verdict_admission.non_verdict_added(observed: observed_repaid, roster: roster_fixture)) == 0
}

// AND THE REPAIR ITSELF IS ADMITTED, which is the control that keeps the row above from reading as
// a penalty on repayment. Deleting the two repaid identities from the roster in the same change
// leaves both collections empty, and the same function that refuses the stale form admits this
// one. Without this control the pair would not discriminate between "stale rows refuse" and
// "repayment refuses", which are opposite rules.
test fn repayment_with_the_row_deleted_is_admitted() -> Bool {
  v2.workflow.floor_non_verdict_admission.non_verdict_admits(observed: observed_repaid, roster: observed_repaid)
    && v2.std.algebra.length(xs: v2.workflow.floor_non_verdict_admission.non_verdict_repaid(observed: observed_repaid, roster: observed_repaid)) == 0
    && v2.std.algebra.length(xs: v2.workflow.floor_non_verdict_admission.non_verdict_added(observed: observed_repaid, roster: observed_repaid)) == 0
}

test fn growth_refuses() -> Bool {
  !v2.workflow.floor_non_verdict_admission.non_verdict_admits(observed: observed_grown, roster: roster_fixture)
    && v2.std.algebra.length(xs: v2.workflow.floor_non_verdict_admission.non_verdict_added(observed: observed_grown, roster: roster_fixture)) == 1
}

// THE EVIDENCE THAT THE IDENTITY-GRAIN DECISION WAS REAL, not the plumbing test. The swapped
// population has the SAME LENGTH as the roster, so this assertion is the one a count-based
// admission fails -- and the length equality is asserted here beside the refusal, so the
// discrimination cannot be read as an artifact of the sizes differing.
test fn a_swap_that_leaves_the_count_unmoved_still_refuses() -> Bool {
  v2.std.algebra.length(xs: observed_swapped) == v2.std.algebra.length(xs: roster_fixture)
    && !v2.workflow.floor_non_verdict_admission.non_verdict_admits(observed: observed_swapped, roster: roster_fixture)
    && v2.std.algebra.length(xs: v2.workflow.floor_non_verdict_admission.non_verdict_added(observed: observed_swapped, roster: roster_fixture)) == 1
    && v2.std.algebra.length(xs: v2.workflow.floor_non_verdict_admission.non_verdict_repaid(observed: observed_swapped, roster: roster_fixture)) == 1
}
