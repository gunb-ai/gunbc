module v2.test.probe.assemble_shrink

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import std.algebra { Cons, Empty }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data probe_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^probe_artifact,
  file_path: "src/v2/pilot/probe_pilot.dag"
}

fn probe_ingest(src: String) -> SourceRootIngest {
  Cons {
    head: DagSourceReadWitness {
      source: Medium { carried: src, fidelity: Lossless },
      artifact: probe_artifact,
      compilation_unit: ^probe_pilot_cu,
      source_root: V2Tree
    },
    tail: Empty
  }
}

fn probe_admission() -> Admission {
  Admission {
    subject: ResolutionSubject { name: Cons { head: ^probe_pilot, tail: Empty } },
    imports: Empty
  }
}

fn assembles(src: String) -> Bool {
  match assemble_program_from_ingest(
    ingest: probe_ingest(src: src),
    admission: probe_admission(),
    lm: dag_language_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data s_a_empty_module: String = "module probe_pilot\n"
data s_b_kernel_fn: String = "module probe_pilot\n\nfn f(x: Int) -> Int { x }\n"
data s_c_type_only: String = "module probe_pilot\n\ntype Flag = On | Off\n"
data s_d_type_in_sig: String = "module probe_pilot\n\ntype Flag = On | Off\n\nfn g(f: Flag) -> Flag { f }\n"
data s_e_ctor_in_body: String = "module probe_pilot\n\ntype Flag = On | Off\n\nfn h() -> Flag { On }\n"
data s_f_match_arm: String = "module probe_pilot\n\ntype Flag = On | Off\n\nfn flip(f: Flag) -> Flag { match f { On => Off } }\n"
data s_h_where_clause_type: String = "module probe_pilot\n\ntype Name = String where brand(\"Name\")\n"
data s_i_type_plus_fn: String = "module probe_pilot\n\ntype Name = String where brand(\"Name\")\n\nfn f(x: Int) -> Int { x }\n"
data s_g_record_type: String = "module probe_pilot\n\ntype Box { n: Int }\n\nfn mk() -> Box { Box { n: 1 } }\n"

test fn a_empty_module_assembles() -> Bool { assembles(src: s_a_empty_module) }
test fn b_kernel_fn_assembles() -> Bool { assembles(src: s_b_kernel_fn) }
test fn c_type_only_assembles() -> Bool { assembles(src: s_c_type_only) }
test fn d_type_in_signature_assembles() -> Bool { assembles(src: s_d_type_in_sig) }
test fn e_constructor_in_body_assembles() -> Bool { assembles(src: s_e_ctor_in_body) }
test fn f_match_arm_assembles() -> Bool { assembles(src: s_f_match_arm) }
test fn g_record_type_assembles() -> Bool { assembles(src: s_g_record_type) }

test fn h_where_clause_type_assembles() -> Bool { assembles(src: s_h_where_clause_type) }
test fn i_where_clause_type_plus_fn_assembles() -> Bool { assembles(src: s_i_type_plus_fn) }
