module v2.test.claim.affected_set_disposition_both_axes

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data disposition_fixture_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^disposition_fixture_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data disposition_fixture_changed_path: String = "src/v2/test/fixture/floor_skip/node_precise_discriminator_test.dag"

test fn disposition_node_frontier_only_skips_holds() -> Bool {
  floor_kernel_would_skip(
    changed_paths: [disposition_fixture_changed_path],
    frontier_nodes: [disposition_fixture_node],
    touches_frontier: false,
    function_edited: false,
    entry_file_touched: false,
    runtime_data_dependency_touched: false
  )
}

test fn disposition_node_frontier_only_runs_holds() -> Bool {
  !floor_kernel_would_skip(
    changed_paths: [disposition_fixture_changed_path],
    frontier_nodes: [disposition_fixture_node],
    touches_frontier: true,
    function_edited: false,
    entry_file_touched: false,
    runtime_data_dependency_touched: false
  )
}

test fn disposition_function_edited_only_runs_holds() -> Bool {
  !floor_kernel_would_skip(
    changed_paths: [disposition_fixture_changed_path],
    frontier_nodes: [disposition_fixture_node],
    touches_frontier: false,
    function_edited: true,
    entry_file_touched: false,
    runtime_data_dependency_touched: false
  )
}

test fn disposition_both_axes_false_skips_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: DiffPathsProduced { changed_paths: [disposition_fixture_changed_path] },
    frontier: FrontierProduced { nodes: [disposition_fixture_node] },
    touches_frontier: false,
    function_edited: false,
    entry_file_touched: false,
    runtime_data_dependency_touched: false
  ) {
    SkipAssumedGreen => true
    RunWitness { reason: _ } => false
    Refused { cause: _ } => false
  }
}

test fn disposition_either_axis_runs_holds() -> Bool {
  match floor_witness_run_disposition(
    diff: DiffPathsProduced { changed_paths: [disposition_fixture_changed_path] },
    frontier: FrontierProduced { nodes: [disposition_fixture_node] },
    touches_frontier: false,
    function_edited: true,
    entry_file_touched: false,
    runtime_data_dependency_touched: false
  ) {
    RunWitness { reason: _ } => true
    SkipAssumedGreen => false
    Refused { cause: _ } => false
  }
    && match floor_witness_run_disposition(
      diff: DiffPathsProduced { changed_paths: [disposition_fixture_changed_path] },
      frontier: FrontierProduced { nodes: [disposition_fixture_node] },
      touches_frontier: true,
      function_edited: false,
      entry_file_touched: false,
      runtime_data_dependency_touched: false
    ) {
      RunWitness { reason: _ } => true
      SkipAssumedGreen => false
      Refused { cause: _ } => false
    }
}

