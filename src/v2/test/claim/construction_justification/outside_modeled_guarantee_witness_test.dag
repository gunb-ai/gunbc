module v2.test.claim.construction_justification.outside_modeled_guarantee_witness_test

import v2.lens.common.construction_justification {
  ConstructionClass,
  GuaranteeBoundary,
  OutsideModeledGuarantee,
  WallAfterGrounding,
  CapabilityNotRepresented,
  PolicyJudgmentRequired,
  modeled_outside_boundary,
  decl_facts_inventory_authority,
  guarantee_boundary_required_is_not_subject,
  wall_now_total_projection_forbids_outside_modeled_guarantee
}
import v2.lens.common.outside_modeled_guarantee_join { guarantee_boundary_still_outside }
import v2.lens.enforcement.complexity_contract_subject {
  complexity_derived_kernel_boundary,
  complexity_optimality_boundary
}
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn cost_lens_ref() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.lens.cost",
    decl_name: "cost_lens",
    field: WholeDeclaration
  }
}

fn synthesis_lens_ref() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.lens.synthesis",
    decl_name: "synthesis_lens",
    field: WholeDeclaration
  }
}

fn nonexistent_capability_ref() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.lens.cost",
    decl_name: "capability_absent_from_decl_facts",
    field: WholeDeclaration
  }
}

fn planted_outside_requiring(required: DeclarationRef) -> GuaranteeBoundary {
  modeled_outside_boundary(
    subject: DeclarationRef {
      module_path: "v2.lens.complexity",
      decl_name: "asymptotic_projection",
      field: WholeDeclaration
    },
    required_capability: required,
    capability_inventory_authority: decl_facts_inventory_authority,
    boundary_kind: CapabilityNotRepresented { required: required }
  )
}

fn grounding_verdict_ref() -> DeclarationRef {
  DeclarationRef {
    module_path: "v2.lens.grounding_ledger",
    decl_name: "GroundingVerdict",
    field: WholeDeclaration
  }
}

fn planted_subject_as_required_capability_boundary() -> GuaranteeBoundary {
  modeled_outside_boundary(
    subject: grounding_verdict_ref(),
    required_capability: grounding_verdict_ref(),
    capability_inventory_authority: decl_facts_inventory_authority,
    boundary_kind: PolicyJudgmentRequired { judgment: grounding_verdict_ref() }
  )
}

fn planted_outside_requiring_cost_lens() -> ConstructionClass {
  OutsideModeledGuarantee { boundary: planted_outside_requiring(required: cost_lens_ref()) }
}

fn class_is_wall_after_grounding(class: ConstructionClass) -> Bool {
  match class {
    WallAfterGrounding { dissolves_to: _ } => true
    _ => false
  }
}

fn live_outside_class_still_outside(class: ConstructionClass) -> Bool {
  match class {
    OutsideModeledGuarantee { boundary: b } =>
      guarantee_boundary_still_outside(boundary: b)
        && guarantee_boundary_required_is_not_subject(boundary: b)
    _ => false
  }
}

test fn cost_wall_now_projected_complexity_forbids_outside_modeled_guarantee_holds() -> Bool {
  wall_now_total_projection_forbids_outside_modeled_guarantee(
    upstream: v2.lens.cost.construction_justification.class,
    downstream: v2.lens.complexity.construction_justification.class
  )
}

test fn complexity_module_aligns_derived_kernel_contract_holds() -> Bool {
  match v2.lens.complexity.construction_justification.class {
    WallAfterGrounding { dissolves_to: _ } =>
      match complexity_derived_kernel_boundary.class {
        WallAfterGrounding { dissolves_to: _ } =>
          match complexity_optimality_boundary.class {
            OutsideModeledGuarantee { boundary: _ } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn planted_outside_for_existing_decl_reds() -> Bool {
  !guarantee_boundary_still_outside(boundary: planted_outside_requiring(required: cost_lens_ref()))
    && !guarantee_boundary_still_outside(boundary: planted_outside_requiring(required: synthesis_lens_ref()))
}

test fn planted_subject_as_required_capability_reds() -> Bool {
  !guarantee_boundary_required_is_not_subject(boundary: planted_subject_as_required_capability_boundary())
}

test fn planted_absent_decl_still_outside_holds() -> Bool {
  guarantee_boundary_still_outside(boundary: planted_outside_requiring(required: nonexistent_capability_ref()))
}

test fn live_extract_stamps_are_on_ladder() -> Bool {
  class_is_wall_after_grounding(class: v2.lens.complexity.construction_justification.class)
    && class_is_wall_after_grounding(class: complexity_derived_kernel_boundary.class)
    && class_is_wall_after_grounding(class: v2.lens.grounding.construction_justification.class)
    && class_is_wall_after_grounding(class: v2.lens.grounding_ledger.construction_justification.class)
    && class_is_wall_after_grounding(class: v2.lens.synthesis.construction_justification.class)
    && class_is_wall_after_grounding(class: v2.lens.unit_modeling.construction_justification.class)
    && class_is_wall_after_grounding(class: v2.lens.testgen.construction_justification.class)
    && class_is_wall_after_grounding(class: v2.lens.fn_index_depth_agreement.construction_justification.class)
}

test fn live_undecidable_residues_are_outside_modeled_guarantee() -> Bool {
  live_outside_class_still_outside(class: v2.lens.grounding.grounding_name_only_residual_boundary.class)
    && live_outside_class_still_outside(class: v2.lens.synthesis.synthesis_rice_residual_boundary.class)
    && live_outside_class_still_outside(class: complexity_optimality_boundary.class)
}

test fn planted_wall_now_to_outside_modeled_guarantee_projection_red() -> Bool {
  !wall_now_total_projection_forbids_outside_modeled_guarantee(
    upstream: v2.lens.cost.construction_justification.class,
    downstream: planted_outside_requiring_cost_lens()
  )
}
