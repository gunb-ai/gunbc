module v2.test.round_trip.dag_ingest_round_trip


fn dag_round_trip_input_node() -> Node {
  let lm = dag_language_model()
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_round_trip_edge(
        name: ^dag_round_trip_lang_axis,
        target: dag_round_trip_atom(s: ^dag_language_model_surface_id)
      ),
      dag_round_trip_edge(
        name: ^dag_round_trip_fixture_axis,
        target: dag_round_trip_atom(s: ^dag_add_fn_round_trip_fixture_subject)
      ),
      dag_round_trip_edge(
        name: ^dag_round_trip_lex_axis,
        target: dag_round_trip_bool_node(pass: dag_round_trip_lex_ready())
      ),
      dag_round_trip_edge(
        name: ^dag_round_trip_grammar_axis,
        target: dag_round_trip_bool_node(pass: dag_round_trip_grammar_ready(lm: lm))
      ),
      dag_round_trip_edge(
        name: ^dag_round_trip_normalization_axis,
        target: dag_round_trip_bool_node(pass: dag_round_trip_trivia_fidelity_resolved())
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

data claim_dag_ingest_round_trip: TestClaim = RoundTripClaim {
  label: "T-36 W1 readiness: dag_add_fn_round_trip_fixture + lex/grammar/C5 authorities re-derived (emit→ingest fidelity W1b)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: dag_round_trip_input_node(),
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_dag_ingestion_floor_min: TestClaim = EqualsClaim {
  label: "B-min .dag ingestion floor: lex, grammar, and C5 trivia authorities are ready",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: dag_round_trip_bool_node(pass: true),
  rhs: dag_round_trip_bool_node(pass: dag_round_trip_authorities_ready()),
  classification: TestClassification { tier: Tier3, layer: Integration }
}
