module v2.test.round_trip.dag_comment_wall_test


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn slash_slash_in_string() -> String {
  "https://example.com"
}

test fn dag_line_comment_is_fail_closed() -> Bool {
  dag_line_comment_fidelity() == FailClosed { feature: DagLineCommentFailClosed }
}

test fn dag_block_comment_is_fail_closed() -> Bool {
  dag_block_comment_fidelity() == FailClosed { feature: DagBlockCommentFailClosed }
}

test fn slash_slash_inside_string_literal_accepted() -> Bool {
  slash_slash_in_string() == "https://example.com"
}
