module v2.test.claim.infer_self_grounding_wall


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

fn measured_infer_eval_harness_source() -> std.types.NonEmptyStr {
  fold_list(
    xs: gunbc.guarantee_probe_corpus.v2_infer_eval_harness_source_paths(),
    empty: "guarantee-probe-harness-source" as std.types.NonEmptyStr,
    cons: fn(acc, path) {
      let read = filesystem_read(path: path)
      concat(
        concat(concat(acc as String, "\n=== "), path as String),
        concat(" ===\n", read.content as String),
      ) as std.types.NonEmptyStr
    },
  )
}

fn infer_wall_harness_revision(probe: gunbc.guarantee_measurement.GuaranteeProbeId) -> gunbc.guarantee_measurement.MeasurementRevision {
  let harness_source = measured_infer_eval_harness_source()
  match gunbc.guarantee_probe_corpus.active_v2_infer_eval_probe_row(probe: probe) {
    v2.std.optional.Present { value: row } =>
      gunbc.guarantee_probe_corpus.v2_infer_eval_harness_revision(
        probe: probe,
        expectation: row.expectation,
        harness_source: harness_source,
      )
    v2.std.optional.Absent =>
      gunbc.guarantee_probe_corpus.v2_infer_eval_harness_revision(
        probe: probe,
        expectation: gunbc.guarantee_probe_corpus.ExpectAcceptedCounted { diagnostic_class: "infer-harness-row-absent" as std.types.NonEmptyStr },
        harness_source: harness_source,
      )
  }
}

fn wall_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn wall_conj_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn wall_disj_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Disj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn wall_value_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Value },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn wall_malformed_bool_with_payload() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_token_kw_true } },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^wall_malformed_bool_payload_field },
        target: wall_value_node()
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn wall_malformed_int_with_extra_payload() -> v2.std.node.Node {
  let literal = dag_int_literal_fixture_one()
  v2.std.node.Node {
    kind: literal.kind,
    children: list_snoc_item(
      xs: literal.children,
      item: v2.std.node.Edge {
        label: v2.std.node.Named { name: ^wall_malformed_int_payload_field },
        target: wall_value_node()
      }
    ),
    occurrence_id: literal.occurrence_id
  }
}

fn wall_derived_type_node() -> v2.std.node.Node {
  wall_atom(s: ^wall_derived_type_marker)
}

fn wall_self_grounding(node: v2.std.node.Node) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: node
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn wall_derived_grounding(node: v2.std.node.Node) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: wall_derived_type_node()
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn wall_grounding_for_node_refused(root: v2.std.node.Node) -> Bool {
  match infer(tree: root) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match canonical_grounding_for_node(tree: tree, node: root) {
        v2.std.diagnostic.Rejected { diagnostics: r } => r.head.reason == ^infer_grounding_not_derived
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}

fn wall_resolved_type_refused(root: v2.std.node.Node) -> Bool {
  match infer(tree: root) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match inferred_facts_witness_for_node(tree: tree, node: root) {
        Violates { diagnostic: _ } => false
        Holds { value: facts } =>
          match inferred_facts_resolved_type(facts: facts) {
            Violates { diagnostic: d } => d.reason == ^infer_grounding_not_derived
            Holds { value: _ } => false
          }
      }
  }
}

fn wall_infer_counts_frontier(root: v2.std.node.Node) -> Bool {
  match infer(tree: root) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: d } =>
      match d {
        Some { diagnostics: nds } => nds.head.reason == ^infer_grounding_not_derived
        None => false
      }
  }
}

test fn wall_construction_authority_refuses_self_evidence() -> Bool {
  match canonical_grounding_from_derived_type(
    node: wall_conj_node(),
    derived_type: wall_conj_node()
  ) {
    v2.std.diagnostic.Rejected { diagnostics: r } => r.head.reason == ^grounding_evidence_is_source
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn wall_construction_authority_accepts_derived_type() -> Bool {
  match canonical_grounding_from_derived_type(
    node: wall_conj_node(),
    derived_type: wall_derived_type_node()
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: g, diagnostics: _ } =>
      (g.node == wall_conj_node())
        && (g.witness.structural.evidence == wall_derived_type_node())
  }
}

data wall_hand_built_residue_note: String = "The stated residue: a CanonicalGrounding written field-by-field, bypassing the construction authority, is still admitted. This is asserted rather than left implicit so the wall's edge is documented by a test and not by optimism — see canonical_grounding_admission_scope_note for why the 'evidence != node' read-path proxy was withdrawn (it false-positives on v2_evaluator's bool fixture, which uses one atom as both evaluand and primitive_type). Closing this residue needs CanonicalGrounding to stop being structurally constructible, not a wider predicate."

test fn wall_hand_built_self_grounding_is_the_stated_residue() -> Bool {
  canonical_grounding_admits_infer_facts(grounding: wall_self_grounding(node: wall_conj_node()))
}

test fn wall_admission_admits_hand_built_derived_grounding() -> Bool {
  canonical_grounding_admits_infer_facts(grounding: wall_derived_grounding(node: wall_conj_node()))
}

test fn wall_conj_grounding_no_longer_returns_source_as_its_own_type() -> Bool {
  wall_grounding_for_node_refused(root: wall_conj_node())
}

test fn wall_disj_grounding_no_longer_returns_source_as_its_own_type() -> Bool {
  wall_grounding_for_node_refused(root: wall_disj_node())
}

test fn wall_frontier_node_has_no_resolved_type() -> Bool {
  wall_resolved_type_refused(root: wall_value_node())
}

test fn wall_frontier_is_counted_on_the_accepted_path() -> Bool {
  wall_infer_counts_frontier(root: wall_value_node())
}

test fn wall_malformed_bool_payload_is_not_grounded_or_discharged() -> Bool {
  wall_grounding_for_node_refused(root: wall_malformed_bool_with_payload())
    && wall_infer_counts_frontier(root: wall_malformed_bool_with_payload())
}

test fn wall_malformed_int_payload_is_not_grounded_or_discharged() -> Bool {
  wall_grounding_for_node_refused(root: wall_malformed_int_with_extra_payload())
    && wall_infer_counts_frontier(root: wall_malformed_int_with_extra_payload())
}

fn wall_frontier_observation_matches_infer(nes: v2.std.diagnostic.NonEmptyDiagnostics, o: gunbc.guarantee_measurement.ProbeObservation) -> Bool {
  gunbc.guarantee_measurement.probe_observation_fold(
    o: o,
    fold: gunbc.guarantee_measurement.ProbeObservationFold {
      refused: fn(_, _) { false },
      accepted_clean: false,
      accepted_counted: fn(cls, c) {
        (cls as String) == (nes.head.reason as String)
          && c == gunbc.guarantee_probe_corpus.non_empty_diagnostics_count_reason(nes: nes, reason: ^infer_grounding_not_derived)
      },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

test fn wall_frontier_receipt_joins_corpus_identity() -> Bool {
  let root = wall_value_node()
  match infer(tree: root) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: d } =>
      match d {
        None => false
        Some { diagnostics: nes } =>
          match gunbc.guarantee_probe_corpus.active_v2_infer_eval_probe_row(probe: gunbc.guarantee_probe_corpus.v2_frontier_red_probe) {
            v2.std.optional.Present { value: row } =>
              wall_resolved_type_refused(root: root)
                && nes.head.reason == ^infer_grounding_not_derived
                && gunbc.guarantee_probe_corpus.receipt_matches_v2_infer_eval_probe_row(
                  receipt: gunbc.guarantee_probe_corpus.build_v2_infer_eval_receipt(
                    row: row,
                    observed: gunbc.guarantee_probe_corpus.probe_observation_from_accepted_infer_diagnostics(diagnostics: d),
                    subject_revision: gunbc.guarantee_probe_corpus.synthetic_infer_eval_subject_revision_from_node(node: root),
                    harness_revision: infer_wall_harness_revision(probe: row.probe),
                  ),
                  row: row,
                )
                && match gunbc.guarantee_measurement.join_receipt_to_path(
                  receipt: gunbc.guarantee_probe_corpus.build_v2_infer_eval_receipt(
                    row: row,
                    observed: gunbc.guarantee_probe_corpus.probe_observation_from_accepted_infer_diagnostics(diagnostics: d),
                    subject_revision: gunbc.guarantee_probe_corpus.synthetic_infer_eval_subject_revision_from_node(node: root),
                    harness_revision: infer_wall_harness_revision(probe: row.probe),
                  ),
                  paths: gunbc.guarantee_probe_corpus.guarantee_probe_paths(),
                ) {
                  ReceiptJoined { path: p } =>
                    p.acceptance_boundary == gunbc.guarantee_measurement.InferToEval
                      && wall_frontier_observation_matches_infer(
                        nes: nes,
                        o: gunbc.guarantee_probe_corpus.probe_observation_from_accepted_infer_diagnostics(diagnostics: d),
                      )
                  ReceiptPathUnknown { receipt_path: _ } => false
                  ReceiptPathDuplicate { receipt_path: _, matches: _ } => false
                }
            v2.std.optional.Absent => false
          }
      }
  }
}

test fn wall_frontier_derived_green_receipt_joins_corpus_identity() -> Bool {
  let root = dag_pick_if_body_fixture
  match infer(tree: root) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: d } =>
      match gunbc.guarantee_probe_corpus.active_v2_infer_eval_probe_row(probe: gunbc.guarantee_probe_corpus.v2_frontier_green_probe) {
        v2.std.optional.Present { value: row } =>
          d == v2.std.diagnostic.None
            && gunbc.guarantee_probe_corpus.observation_is_clean(o: gunbc.guarantee_probe_corpus.probe_observation_from_accepted_infer_diagnostics(diagnostics: d))
            && gunbc.guarantee_probe_corpus.receipt_matches_v2_infer_eval_probe_row(
              receipt: gunbc.guarantee_probe_corpus.build_v2_infer_eval_receipt(
                row: row,
                observed: gunbc.guarantee_probe_corpus.probe_observation_from_accepted_infer_diagnostics(diagnostics: d),
                subject_revision: gunbc.guarantee_probe_corpus.synthetic_infer_eval_subject_revision_from_node(node: root),
                harness_revision: infer_wall_harness_revision(probe: row.probe),
              ),
              row: row,
            )
            && match gunbc.guarantee_measurement.join_receipt_to_path(
              receipt: gunbc.guarantee_probe_corpus.build_v2_infer_eval_receipt(
                row: row,
                observed: gunbc.guarantee_probe_corpus.probe_observation_from_accepted_infer_diagnostics(diagnostics: d),
                subject_revision: gunbc.guarantee_probe_corpus.synthetic_infer_eval_subject_revision_from_node(node: root),
                harness_revision: infer_wall_harness_revision(probe: row.probe),
              ),
              paths: gunbc.guarantee_probe_corpus.guarantee_probe_paths(),
            ) {
              ReceiptJoined { path: p } => p.acceptance_boundary == gunbc.guarantee_measurement.InferToEval
              ReceiptPathUnknown { receipt_path: _ } => false
              ReceiptPathDuplicate { receipt_path: _, matches: _ } => false
            }
        v2.std.optional.Absent => false
      }
  }
}
