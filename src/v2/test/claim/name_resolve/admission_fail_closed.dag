module v2.test.claim.name_resolve.admission_fail_closed

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.name_resolve { ResolutionContext, Admission, AdmissionAccepted, AdmissionRejected, AdmissionState, Import, ImportVisible, ResolutionSubject, admit_import_entry, admit_imported_modules, resolution_context, resolve_in_context, resolve_with_admission, resolve_with_admission_policy, validated_module_root_for_name, module_root_find, validate_module_roots, ValidatedModuleRoots }
import v2.std.declaration_marker { test_code_index_empty, test_marker_channel_empty }
import v2.compiler.normalized_tree { NormalizedTree, admit_normalized_tree, no_import_bindings, no_imported_modules, no_type_declaration_kinds, no_type_declaration_modifiers }
import v2.std.cross_tree.import_model { DagTree, SourceRootRef, SourceRootSet, V2Tree }
import v2.std.cross_tree.resolution { SourceRootIndex, source_root_index_empty, source_root_index_insert }
import v2.extdeps.languages.dag { dag_grammar_atom, dag_language_model_surface_empty_prelude, dag_named_edge, dag_surface_edge }
import std.algebra { Cons, Empty, FreeMonoid, fold_list, empty_map, map_insert }
import v2.std.namespace_alias { CapturedImportTarget }
import v2.std.diagnostic { Accepted, ByteRange, None, Outcome, Rejected, bind_outcome, outcome_accepted, Textual, diagnostics_eq, non_empty_diagnostics_eq, locus_eq }
import v2.std.qualified_name { QualifiedName, qualified_name_to_dotted_string }
import v2.std.node { node_same_occurrence, Atom, Conj, Edge, Authored, Node, Positional, Symbol, TypeNode, symbol_lexeme, fold_list_node, NotADeclaration }
import v2.std.resolution_policy { ImportScoped }

test fn resolve_module_not_found_preserves_missing_module_identity() -> Bool {
  let missing = fc_qn(seg: ^fc_missing_seg)
  fc_with_roots(o: fc_single_found_root(), f: fn(roots) {
  match module_root_find(roots: roots, name: missing) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      match d.head.at {
        Textual { file: module_file, extent: _ } =>
          (d.head.reason == ^resolve_module_not_found)
            && (symbol_lexeme(sym: module_file) == qualified_name_to_dotted_string(qn: missing))
        _ => false
      }
  }
  })
}

fn fc_qn_node(seg: Symbol) -> Node {
  fold_list_node(
    xs: Cons { head: seg, tail: Empty },
    item_node: fn(sym) {
      Node { kind: TypeNode { connective: Atom { identity: sym } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
    }
  )
}

fn fc_module_root_export(seg: Symbol, export_sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_surface_edge(edge: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_surface_edge(edge: ^dag_surface_module_header_qualified_name,
        target: fc_qn_node(seg: seg)
      ),
      Edge {
        label: Authored { name: export_sym },
        target: Node {
          kind: TypeNode {
            connective: Atom { identity: ^Int }
          },
          children: [],
          occurrence_id: OccurrenceSynthetic
},
declaration: NotADeclaration
      }
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn fc_module_root(seg: Symbol) -> Node {
  fc_module_root_export(seg: seg, export_sym: ^fc_export_sym)
}

fn fc_qn(seg: Symbol) -> QualifiedName {
  Cons { head: seg, tail: Empty }
}

// These fixtures pass module roots to validate_module_roots / resolve_with_admission, which since
// BL-1 take FreeMonoid<NormalizedTree>. They therefore admit each synthetic root through the real
// door rather than casting past it -- a fixture that reached the sealed carrier without admission
// would be the wrapper-payload conflation the receipt in
// docs/plans/hollow-alias-construction-wall.md section 8.2 records, planted in the witness
// population. Admission is threaded as an Outcome and its refusal arm FAILS the witness: a fixture
// that cannot be admitted is a broken fixture, and reporting that as a passing verdict is the
// fabrication these witnesses exist to catch.

fn fc_with_roots(
  o: Outcome<FreeMonoid<NormalizedTree>>,
  f: fn(FreeMonoid<NormalizedTree>) -> Bool
) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: roots, diagnostics: _ } => f(roots)
  }
}

fn fc_admitted(n: Node) -> Outcome<NormalizedTree> {
  admit_normalized_tree(import_bindings: no_import_bindings(), imported_modules: no_imported_modules(), type_declaration_kinds: no_type_declaration_kinds(), type_declaration_modifiers: no_type_declaration_modifiers(), test_markers: test_marker_channel_empty(), root: n, diagnostics: None)
}

fn fc_located_import(target: QualifiedName) -> CapturedImportTarget {
  CapturedImportTarget {
    target: target,
    at: Textual {
      file: ^fc_import_file,
      extent: ByteRange { start: 14, end: 42 }
    }
  }
}

fn fc_admitted_importing(n: Node, modules: FreeMonoid<CapturedImportTarget>) -> Outcome<NormalizedTree> {
  admit_normalized_tree(import_bindings: no_import_bindings(), imported_modules: modules, type_declaration_kinds: no_type_declaration_kinds(), type_declaration_modifiers: no_type_declaration_modifiers(), test_markers: test_marker_channel_empty(), root: n, diagnostics: None)
}

fn fc_duplicate_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_dup_seg)), f: fn(a) {
    bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_dup_seg)), f: fn(b) {
      outcome_accepted(value: Cons { head: a, tail: Cons { head: b, tail: Empty } })
    })
  })
}

fn fc_single_found_root() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_found_seg)), f: fn(a) {
    outcome_accepted(value: Cons { head: a, tail: Empty })
  })
}

fn fc_malformed_subject_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_surface_edge(edge: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_surface_edge(edge: ^dag_surface_module_header_qualified_name,
        target: fc_qn_node(seg: ^fc_malformed_seg)
      ),
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^fc_malformed_child_sym } },
          children: [],
          occurrence_id: OccurrenceSynthetic
},
declaration: NotADeclaration
      }
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn fc_malformed_subject_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_malformed_subject_root()), f: fn(a) {
    outcome_accepted(value: Cons { head: a, tail: Empty })
  })
}

fn fc_import_missing_target() -> Import {
  Import { target: fc_qn(seg: ^fc_missing_seg), visibility: ImportVisible }
}

fn fc_initial_admission_state() -> AdmissionState {
  AdmissionAccepted { bindings: empty_map(), origins: empty_map() }
}

test fn admit_import_missing_module_is_rejected() -> Bool {
  fc_with_roots(o: fc_single_found_root(), f: fn(roots) {
  match validate_module_roots(roots: roots) {
    Rejected { diagnostics: _ } => false
    Accepted { value: validated, diagnostics: _ } =>
      match admit_import_entry(
        roots: validated,
        import_edge: fc_import_missing_target(),
        state: fc_initial_admission_state(),
        subject_qn: fc_qn(seg: ^fc_subject_seg),
        index: source_root_index_empty(),
        active_roots: Empty
      ) {
        AdmissionAccepted { bindings: _, origins: _ } => false
        AdmissionRejected { diagnostics: _ } => true
      }
  }
  })
}

