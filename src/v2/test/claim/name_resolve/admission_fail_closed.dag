fn fc_dual_import_subject_root(seg: Symbol, use_sym: Symbol, imported_decl: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_surface_edge(edge: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_surface_edge(edge: ^dag_surface_module_header_qualified_name,
        target: fc_qn_node(seg: seg)
      ),
      Edge {
        label: Authored { name: use_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: imported_decl } },
          children: [],
          occurrence_id: OccurrenceSynthetic
},
declaration: NotADeclaration
      }
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn fc_dual_import_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_dual_import_subject_root(
    seg: ^fc_subject_seg,
    use_sym: ^fc_import_use_sym,
    imported_decl: ^fc_export_a_sym
  )), f: fn(a) {
    bind_outcome(o: fc_admitted(n: fc_module_root_export(seg: ^fc_import_a_seg, export_sym: ^fc_export_a_sym)), f: fn(b) {
      bind_outcome(o: fc_admitted(n: fc_module_root_export(seg: ^fc_import_b_seg, export_sym: ^fc_export_b_sym)), f: fn(c) {
        outcome_accepted(value: Cons { head: a, tail: Cons { head: b, tail: Cons { head: c, tail: Empty } } })
      })
    })
  })
}

test fn resolve_dual_imports_do_not_collide_on_header_metadata() -> Bool {
  fc_with_roots(o: fc_dual_import_roots(), f: fn(roots) {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: roots,
    admission: Admission {
      subject: ResolutionSubject {
        name: fc_qn(seg: ^fc_subject_seg)
      },
      imports: Cons {
        head: Import { target: fc_qn(seg: ^fc_import_a_seg), visibility: ImportVisible },
        tail: Cons {
          head: Import { target: fc_qn(seg: ^fc_import_b_seg), visibility: ImportVisible },
          tail: Empty
        }
      }
    },
    index: source_root_index_empty(),
    active_roots: Empty,
    policy: ImportScoped
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
  })
}

test fn resolve_with_admission_threads_validate_diagnostics_on_accept() -> Bool {
  fc_with_roots(o: fc_dual_import_roots(), f: fn(roots) {
  match validate_module_roots(roots: roots) {
    Accepted { value: _, diagnostics: validate_diag } =>
      match resolve_with_admission_policy(
        lm: dag_language_model_surface_empty_prelude(),
        roots: roots,
        admission: Admission {
          subject: ResolutionSubject {
            name: fc_qn(seg: ^fc_subject_seg)
          },
          imports: Cons {
            head: Import { target: fc_qn(seg: ^fc_import_a_seg), visibility: ImportVisible },
            tail: Cons {
              head: Import { target: fc_qn(seg: ^fc_import_b_seg), visibility: ImportVisible },
              tail: Empty
            }
          }
        },
        index: source_root_index_empty(),
        active_roots: Empty,
        policy: ImportScoped
      ) {
        Accepted { value: _, diagnostics: resolve_diag } =>
          diagnostics_eq(a: resolve_diag, b: validate_diag)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
  })
}


fn fc_shared_validation_refusal_preserved(roots: FreeMonoid<NormalizedTree>) -> Bool {
  match validate_module_roots(roots: roots) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: expected } =>
      let context = resolution_context(
        lm: dag_language_model_surface_empty_prelude(),
        roots: roots,
        index: source_root_index_empty(),
        active_roots: Empty,
        policy: ImportScoped
      )
      fold_list(
        xs: [^fc_dup_seg, ^fc_missing_seg],
        empty: true,
        cons: fn(preserved, subject) {
          preserved && match resolve_in_context(
            context: context,
            admission: Admission {
              subject: ResolutionSubject { name: fc_qn(seg: subject) },
              imports: Empty
            }
          ).resolved {
            Accepted { value: _, diagnostics: _ } => false
            Rejected { diagnostics: actual } =>
              non_empty_diagnostics_eq(a: expected, b: actual)
          }
        }
      )
  }
}

test fn shared_context_duplicate_root_refusal_preserves_every_diagnostic_for_each_subject() -> Bool {
  fc_with_roots(o: fc_duplicate_roots(), f: fn(roots) {
    fc_shared_validation_refusal_preserved(roots: roots)
  })
}

test fn shared_context_malformed_root_refusal_preserves_every_diagnostic_for_each_subject() -> Bool {
  fc_with_roots(o: fc_malformed_subject_roots(), f: fn(roots) {
    fc_shared_validation_refusal_preserved(roots: roots)
  })
}

// The export-provider fixtures contain an unbound service marker under the empty
// prelude. They are valid import targets, not independently resolvable subjects.
// Both subjects below resolve the provider's exported binding through admission.
fn fc_shared_subject_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_dual_import_subject_root(
    seg: ^fc_subject_a_seg,
    use_sym: ^fc_use_a_sym,
    imported_decl: ^fc_export_a_sym
  )), f: fn(a) {
    bind_outcome(o: fc_admitted(n: fc_dual_import_subject_root(
      seg: ^fc_subject_b_seg,
      use_sym: ^fc_use_b_sym,
      imported_decl: ^fc_export_a_sym
    )), f: fn(b) {
      bind_outcome(o: fc_admitted(n: fc_module_root_export(
        seg: ^fc_import_a_seg,
        export_sym: ^fc_export_a_sym
      )), f: fn(provider) {
        outcome_accepted(value: [a, b, provider])
      })
    })
  })
}

test fn shared_context_resolves_two_subjects_and_preserves_missing_subject_location() -> Bool {
  fc_with_roots(o: fc_shared_subject_roots(), f: fn(roots) {
    let context = resolution_context(
      lm: dag_language_model_surface_empty_prelude(),
      roots: roots,
      index: source_root_index_empty(),
      active_roots: Empty,
      policy: ImportScoped
    )
    let accepted = fold_list(
      xs: [^fc_subject_a_seg, ^fc_subject_b_seg],
      empty: true,
      cons: fn(ok, subject) {
        ok && match resolve_in_context(
          context: context,
          admission: Admission {
            subject: ResolutionSubject { name: fc_qn(seg: subject) },
            imports: [Import { target: fc_qn(seg: ^fc_import_a_seg), visibility: ImportVisible }]
          }
        ).resolved {
          Accepted { value: _, diagnostics: d } => diagnostics_eq(a: d, b: None)
          Rejected { diagnostics: _ } => false
        }
      }
    )
    let missing = fc_qn(seg: ^fc_missing_seg)
    accepted && match module_root_find(roots: roots, name: missing) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: expected } =>
        match resolve_in_context(
          context: context,
          admission: Admission {
            subject: ResolutionSubject { name: missing },
            imports: Empty
          }
        ).resolved {
          Accepted { value: _, diagnostics: _ } => false
          Rejected { diagnostics: actual } =>
            non_empty_diagnostics_eq(a: expected, b: actual)
        }
    }
  })
}

// ── THE MODULE NAMESPACE PROVIDER: at most once per context, refusals stored, no silent reuse ──
// (v2.compiler.name_resolve ResolutionContext namespaces; docs/plans/declaration-body-resolution-provider.md
// P1, control C5). Every claim threads the context a resolution returns into the next one, which is
// the discipline the native loops follow.

fn fc_provider_context(roots: FreeMonoid<NormalizedTree>) -> Outcome<ResolutionContext> {
  resolution_context(
    lm: dag_language_model_surface_empty_prelude(),
    roots: roots,
    index: source_root_index_empty(),
    active_roots: Empty,
    policy: ImportScoped
  )
}

fn fc_provider_admission(seg: Symbol) -> Admission {
  Admission {
    subject: ResolutionSubject { name: fc_qn(seg: seg) },
    imports: [Import { target: fc_qn(seg: ^fc_import_a_seg), visibility: ImportVisible }]
  }
}

fn fc_namespaces_built(context: Outcome<ResolutionContext>) -> Int {
  match context {
    Accepted { value: shared, diagnostics: _ } => shared.namespaces_built
    Rejected { diagnostics: _ } => 0 - 1
  }
}

// AT MOST ONCE: subject a, then a again, then b, over one threaded context, builds two namespaces --
// the second demand for a is served the stored value. RED if a demand for a module already in the
// provider builds again (three), which is the rebuild this provider exists to remove; and the served
// resolution is the same tree the first one produced.
test fn namespace_provider_builds_each_module_at_most_once_per_context() -> Bool {
  fc_with_roots(o: fc_shared_subject_roots(), f: fn(roots) {
    let first = resolve_in_context(context: fc_provider_context(roots: roots), admission: fc_provider_admission(seg: ^fc_subject_a_seg))
    let again = resolve_in_context(context: first.context, admission: fc_provider_admission(seg: ^fc_subject_a_seg))
    let other = resolve_in_context(context: again.context, admission: fc_provider_admission(seg: ^fc_subject_b_seg))
    (fc_namespaces_built(context: first.context) == 1)
      && (fc_namespaces_built(context: again.context) == 1)
      && (fc_namespaces_built(context: other.context) == 2)
      && match first.resolved {
        Rejected { diagnostics: _ } => false
        Accepted { value: a1, diagnostics: _ } =>
          match again.resolved {
            Rejected { diagnostics: _ } => false
            Accepted { value: a2, diagnostics: _ } => node_same_occurrence(a: a1.root, b: a2.root)
          }
      }
  })
}

// A DEMAND UNDER A DIFFERENT ADMISSION REFUSES, located at the subject, and neither serves nor
// overwrites the stored namespace: the same subject asked with no imports after being produced with
// one import is a different input, so the provider's key would be incomplete if it answered.
test fn namespace_provider_refuses_a_demand_whose_admission_differs() -> Bool {
  fc_with_roots(o: fc_shared_subject_roots(), f: fn(roots) {
    let first = resolve_in_context(context: fc_provider_context(roots: roots), admission: fc_provider_admission(seg: ^fc_subject_a_seg))
    let conflicting = resolve_in_context(
      context: first.context,
      admission: Admission { subject: ResolutionSubject { name: fc_qn(seg: ^fc_subject_a_seg) }, imports: Empty }
    )
    (fc_namespaces_built(context: conflicting.context) == 1)
      && match conflicting.resolved {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } => d.head.reason == ^resolve_reason_namespace_provider_admission_conflict
      }
  })
}

// A MODULE OUTSIDE THE INGEST REFUSES AT THE PROVIDER, and the refusal is stored like any other
// production: a second demand is served it without a second build.
test fn namespace_provider_refuses_a_module_outside_the_ingest_once() -> Bool {
  fc_with_roots(o: fc_shared_subject_roots(), f: fn(roots) {
    let missing = Admission { subject: ResolutionSubject { name: fc_qn(seg: ^fc_missing_seg) }, imports: Empty }
    let first = resolve_in_context(context: fc_provider_context(roots: roots), admission: missing)
    let again = resolve_in_context(context: first.context, admission: missing)
    (fc_namespaces_built(context: again.context) == 1)
      && match again.resolved {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } => d.head.reason == ^resolve_module_not_found
      }
  })
}

// The validated index must return the same normalized tree and missing-name diagnostics
// as the general scan. Duplicate populations remain refused before that index exists.
test fn validated_subject_index_matches_general_lookup() -> Bool {
  fc_with_roots(o: fc_shared_subject_roots(), f: fn(roots) {
    match validate_module_roots(roots: roots) {
      Rejected { diagnostics: _ } => false
      Accepted { value: validated, diagnostics: _ } =>
        validated.roots == roots && fold_list(
          xs: [^fc_subject_a_seg, ^fc_subject_b_seg, ^fc_missing_seg],
          empty: true,
          cons: fn(ok, segment) {
            let name = fc_qn(seg: segment)
            ok && match module_root_find(roots: roots, name: name) {
              Accepted { value: expected, diagnostics: expected_diag } =>
                match validated_module_root_for_name(roots: validated, name: name) {
                  Accepted { value: actual, diagnostics: actual_diag } =>
                    actual == expected && diagnostics_eq(a: actual_diag, b: expected_diag)
                  Rejected { diagnostics: _ } => false
                }
              Rejected { diagnostics: expected } =>
                match validated_module_root_for_name(roots: validated, name: name) {
                  Accepted { value: _, diagnostics: _ } => false
                  Rejected { diagnostics: actual } => non_empty_diagnostics_eq(a: actual, b: expected)
                }
            }
          }
        )
    }
  })
}

// Duplicate roots refuse before a validated index can be consumed; the general
// unvalidated lookup retains its ambiguity refusal for the same requested name.
test fn keyed_validation_preserves_general_ambiguity_diagnostic() -> Bool {
  fc_with_roots(o: fc_duplicate_roots(), f: fn(roots) {
    match module_root_find(roots: roots, name: fc_qn(seg: ^fc_dup_seg)) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: expected } =>
        match validate_module_roots(roots: roots) {
          Accepted { value: _, diagnostics: _ } => false
          Rejected { diagnostics: actual } => non_empty_diagnostics_eq(a: actual, b: expected)
        }
    }
  })
}

fn fc_validation_order_roots(malformed_first: Bool, unequal: Bool) -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_dup_seg)), f: fn(a) {
    bind_outcome(o: fc_admitted(n: if unequal {
      fc_module_root_export(seg: ^fc_dup_seg, export_sym: ^fc_other_export_sym)
    } else { fc_module_root(seg: ^fc_dup_seg) }), f: fn(b) {
      bind_outcome(o: fc_admitted(n: fc_malformed_subject_root()), f: fn(malformed) {
        outcome_accepted(value: if malformed_first { [malformed, a, b] } else { [a, b, malformed] })
      })
    })
  })
}

// The trailing malformed root must never replace the first duplicate refusal, even
// when both duplicates contain exactly the same tree.
test fn keyed_validation_equal_duplicate_precedes_malformed() -> Bool {
  fc_with_roots(o: fc_validation_order_roots(malformed_first: false, unequal: false), f: fn(roots) {
    match validate_module_roots(roots: roots) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: actual } => actual.head.reason == ^resolve_duplicate_module_name
    }
  })
}

test fn keyed_validation_unequal_duplicate_precedes_malformed() -> Bool {
  fc_with_roots(o: fc_validation_order_roots(malformed_first: false, unequal: true), f: fn(roots) {
    match validate_module_roots(roots: roots) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: actual } => actual.head.reason == ^resolve_duplicate_module_name
    }
  })
}

test fn keyed_validation_malformed_precedes_duplicate() -> Bool {
  fc_with_roots(o: fc_validation_order_roots(malformed_first: true, unequal: false), f: fn(roots) {
    match validate_module_roots(roots: roots) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: actual } => actual.head.reason == ^resolve_reason_malformed_imported_root
    }
  })
}

// AN IMPORT IS A DEPENDENCY EVEN WHEN NOTHING FROM IT IS USED. NamespaceOnlyY used to check only
// captured alias rows, so a missing module with an empty (or unused) import block was Accepted.
fn fc_unused_missing_import_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(
    o: fc_admitted_importing(
      n: fc_module_root(seg: ^fc_subject_seg),
      modules: Cons { head: fc_located_import(target: fc_qn(seg: ^fc_missing_seg)), tail: Empty }
    ),
    f: fn(a) { outcome_accepted(value: Cons { head: a, tail: Empty }) }
  )
}

fn fc_unused_existing_import_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(
    o: fc_admitted_importing(
      n: fc_module_root(seg: ^fc_subject_seg),
      modules: Cons { head: fc_located_import(target: fc_qn(seg: ^fc_found_seg)), tail: Empty }
    ),
    f: fn(subject) {
      bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_found_seg)), f: fn(found) {
        outcome_accepted(value: Cons { head: subject, tail: Cons { head: found, tail: Empty } })
      })
    }
  )
}

test fn unused_missing_import_refuses_under_namespace_only() -> Bool {
  fc_with_roots(o: fc_unused_missing_import_roots(), f: fn(roots) {
    match resolve_with_admission(
      lm: dag_language_model_surface_empty_prelude(),
      roots: roots,
      admission: Admission {
        subject: ResolutionSubject { name: fc_qn(seg: ^fc_subject_seg) },
        imports: Empty
      }
    ) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: d } =>
        (d.head.reason == ^resolve_module_not_found)
          && (match d.head.at {
            Textual { file: file, extent: extent } =>
              (symbol_lexeme(sym: file) == symbol_lexeme(sym: ^fc_import_file))
                && (match extent {
                  ByteRange { start: start, end: end } =>
                    (start == 14) && (end == 42)
                  _ => false
                })
            _ => false
          })
    }
  })
}

test fn unused_existing_import_accepts_under_namespace_only() -> Bool {
  fc_with_roots(o: fc_unused_existing_import_roots(), f: fn(roots) {
    match validate_module_roots(roots: roots) {
      Rejected { diagnostics: _ } => false
      Accepted { value: validated, diagnostics: _ } =>
        match admit_imported_modules(
          roots: validated,
          modules: Cons { head: fc_located_import(target: fc_qn(seg: ^fc_found_seg)), tail: Empty },
          state: fc_initial_admission_state(),
          subject_qn: fc_qn(seg: ^fc_subject_seg),
          index: source_root_index_empty(),
          active_roots: Empty
        ) {
          AdmissionAccepted { bindings: _, origins: _ } => true
          AdmissionRejected { diagnostics: _ } => false
        }
    }
  })
}

// ADMISSION READS THE VALIDATED MAP, NEVER THE ROOT LIST. validate_module_roots derives each root's
// name once; admission must consume that map rather than rescanning every root per import, which
// re-derived every root's name for every import of every module and made the whole-tree census
// modules x imports x modules (perf at main 2f87f93d8f: ~90% of the run in module_root_lookup). The
// fixture discriminates the two readings: its root LIST holds two roots named `found`, so a rescan
// refuses as a duplicate, while its validated MAP names one root, so a map read admits. Both import
// paths are held: the ImportScoped export merge (admit_import_entry) and the NamespaceOnlyY existence
// check (admit_imported_modules).
test fn admission_reads_the_validated_map_not_the_root_list() -> Bool {
  fc_with_validated(o: bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_found_seg)), f: fn(first) {
    bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_found_seg)), f: fn(second) {
      outcome_accepted(value: ValidatedModuleRoots {
        roots: Cons { head: first, tail: Cons { head: second, tail: Empty } },
        by_name: map_insert(m: empty_map(), key: fc_qn(seg: ^fc_found_seg), value: first),
        test_code: test_code_index_empty()
      })
    })
  }), f: fn(validated) {
    let found = fc_qn(seg: ^fc_found_seg)
    let rescan_refuses = match module_root_find(roots: validated.roots, name: found) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: d } => d.head.reason == ^resolve_duplicate_module_name
    }
    let entry_admits = match admit_import_entry(
      roots: validated,
      import_edge: Import { target: found, visibility: ImportVisible },
      state: fc_initial_admission_state(),
      subject_qn: fc_qn(seg: ^fc_subject_seg),
      index: source_root_index_empty(),
      active_roots: Empty
    ) {
      AdmissionAccepted { bindings: _, origins: _ } => true
      AdmissionRejected { diagnostics: _ } => false
    }
    let existence_admits = match admit_imported_modules(
      roots: validated,
      modules: Cons { head: fc_located_import(target: found), tail: Empty },
      state: fc_initial_admission_state(),
      subject_qn: fc_qn(seg: ^fc_subject_seg),
      index: source_root_index_empty(),
      active_roots: Empty
    ) {
      AdmissionAccepted { bindings: _, origins: _ } => true
      AdmissionRejected { diagnostics: _ } => false
    }
    rescan_refuses && entry_admits && existence_admits
  })
}

fn fc_with_validated(o: Outcome<ValidatedModuleRoots>, f: fn(ValidatedModuleRoots) -> Bool) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: v, diagnostics: _ } => f(v)
  }
}

// AN IMPORT REFUSED AT ADMISSION IS LOCATED AT ITS OWN IMPORT LINE. The cross-tree gate's refusals
// (denied, ambiguous) are minted where the subject's captured import target is in hand, and that
// target carries the import declaration's authored span; so the refusal names the import, exactly as
// the module-not-found arm above does, rather than the resolve port's invariant. RED on main: the
// denial's `at` was invariant_port_locus(resolve_diagnostic_port, resolve_cross_tree_import_denied),
// which a census reports as FileRefusalAtInvariant though the import's line was known. The subject is
// a dag-tree module importing a v2-tree one (LessFundamental in v2.std.cross_tree.resolution
// tree_fundamentality_order); the found root is the target, so the gate is the only refusal reachable.
fn fc_cross_tree_index(subject: SourceRootRef, target: FreeMonoid<SourceRootRef>) -> SourceRootIndex {
  fold_list(
    xs: target,
    empty: source_root_index_insert(index: source_root_index_empty(), module: fc_qn(seg: ^fc_subject_seg), root: subject),
    cons: fn(index, root) { source_root_index_insert(index: index, module: fc_qn(seg: ^fc_found_seg), root: root) }
  )
}

fn fc_both_trees() -> SourceRootSet {
  Cons { head: V2Tree, tail: Cons { head: DagTree, tail: Empty } }
}

fn fc_cross_tree_admission(roots: FreeMonoid<NormalizedTree>, index: SourceRootIndex) -> AdmissionState {
  match validate_module_roots(roots: roots) {
    Rejected { diagnostics: d } => AdmissionRejected { diagnostics: d }
    Accepted { value: validated, diagnostics: _ } =>
      admit_imported_modules(
        roots: validated,
        modules: Cons { head: fc_located_import(target: fc_qn(seg: ^fc_found_seg)), tail: Empty },
        state: fc_initial_admission_state(),
        subject_qn: fc_qn(seg: ^fc_subject_seg),
        index: index,
        active_roots: fc_both_trees()
      )
  }
}

fn fc_refused_at_import_line(state: AdmissionState, reason: Symbol) -> Bool {
  match state {
    AdmissionAccepted { bindings: _, origins: _ } => false
    AdmissionRejected { diagnostics: d } =>
      (d.head.reason == reason)
        && locus_eq(a: d.head.at, b: fc_located_import(target: fc_qn(seg: ^fc_found_seg)).at)
  }
}

test fn cross_tree_denied_import_is_located_at_its_import_line() -> Bool {
  fc_with_roots(o: fc_single_found_root(), f: fn(roots) {
    fc_refused_at_import_line(
      state: fc_cross_tree_admission(roots: roots, index: fc_cross_tree_index(subject: DagTree, target: Cons { head: V2Tree, tail: Empty })),
      reason: ^resolve_cross_tree_import_denied
    )
  })
}

test fn cross_tree_ambiguous_import_is_located_at_its_import_line() -> Bool {
  fc_with_roots(o: fc_single_found_root(), f: fn(roots) {
    fc_refused_at_import_line(
      state: fc_cross_tree_admission(roots: roots, index: fc_cross_tree_index(subject: DagTree, target: Cons { head: V2Tree, tail: Cons { head: DagTree, tail: Empty } })),
      reason: ^resolve_cross_tree_import_ambiguous
    )
  })
}

// THE POSITIVE CONTROL ON THE SAME FIXTURE: the reversed edge (v2 importing dag, MoreFundamental) is
// admitted, so the RED above is the gate's verdict and not a fixture that refuses on every route.
test fn cross_tree_admitted_import_is_accepted_on_the_same_fixture() -> Bool {
  fc_with_roots(o: fc_single_found_root(), f: fn(roots) {
    match fc_cross_tree_admission(roots: roots, index: fc_cross_tree_index(subject: V2Tree, target: Cons { head: DagTree, tail: Empty })) {
      AdmissionAccepted { bindings: _, origins: _ } => true
      AdmissionRejected { diagnostics: _ } => false
    }
  })
}
