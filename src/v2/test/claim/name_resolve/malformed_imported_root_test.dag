module v2.test.name_resolve.malformed_imported_root

import v2.compiler.name_resolve {
  AdmissionAccepted,
  AdmissionRejected,
  AdmissionState,
  Import,
  ImportVisible,
  admit_import_entry
}
import v2.compiler.normalized_tree { NormalizedTree, admit_normalized_tree }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected, bind_outcome, outcome_accepted }
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_named_edge
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list_node }
import v2.std.collection { empty_map }
import v2.std.node { Atom, Conj, Edge, Node, Positional, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.qualified_name { QualifiedName }

fn malformed_qn_node() -> Node {
  fold_list_node(
    xs: Cons { head: ^malformed_seg, tail: Empty },
    item_node: fn(sym) {
      Node { kind: TypeNode { connective: Atom { identity: sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    }
  )
}

fn malformed_root_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: malformed_qn_node()
      ),
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^malformed_child_sym } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn malformed_entry_name() -> QualifiedName {
  Cons { head: ^malformed_seg, tail: Empty }
}

fn roots_with_malformed_entry() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(o: admit_normalized_tree(root: malformed_root_node(), diagnostics: None), f: fn(a) {
    outcome_accepted(value: Cons { head: a, tail: Empty })
  })
}

fn import_edge_for_malformed() -> Import {
  Import { target: malformed_entry_name(), visibility: ImportVisible }
}

fn initial_admission_state() -> AdmissionState {
  AdmissionAccepted { bindings: empty_map(), origins: empty_map() }
}

fn admit_result_is_rejected(state: AdmissionState) -> Bool {
  match state {
    AdmissionAccepted { bindings: _, origins: _ } => false
    AdmissionRejected { diagnostics: _ } => true
  }
}

test fn witness_malformed_root_is_rejected_holds() -> Bool {
  match roots_with_malformed_entry() {
    Rejected { diagnostics: _ } => false
    Accepted { value: roots, diagnostics: _ } =>
  admit_result_is_rejected(
    state: admit_import_entry(
      roots: roots,
      import_edge: import_edge_for_malformed(),
      state: initial_admission_state(),
      subject_qn: malformed_entry_name(),
      index: source_root_index_empty(),
      active_roots: Empty
    )
  )
  }
}
