fn fc_dual_import_subject_root(seg: Symbol, use_sym: Symbol, imported_decl: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: fc_qn_node(seg: seg)
      ),
      Edge {
        label: Named { name: use_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: imported_decl } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn fc_dual_import_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_dual_import_subject_root(
    seg: ^fc_subject_seg,
    use_sym: ^fc_import_use_sym,
    imported_decl: ^fc_export_a_sym
  )), f: fn(a) {
    bind_outcome(o: fc_admitted(n: fc_module_root_export(seg: ^fc_import_a_seg, export_sym: ^fc_export_a_sym)), f: fn(b) {
      bind_outcome(o: fc_admitted(n: fc_module_root_export(seg: ^fc_import_b_seg, export_sym: ^fc_export_b_sym)), f: fn(c) {
        outcome_accepted(value: Cons { head: a, tail: Cons { head: b, tail: Cons { head: c, tail: Empty } } })
      })
    })
  })
}

test fn resolve_dual_imports_do_not_collide_on_header_metadata() -> Bool {
  fc_with_roots(o: fc_dual_import_roots(), f: fn(roots) {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: roots,
    admission: Admission {
      subject: ResolutionSubject {
        name: fc_qn(seg: ^fc_subject_seg)
      },
      imports: Cons {
        head: Import { target: fc_qn(seg: ^fc_import_a_seg), visibility: ImportVisible },
        tail: Cons {
          head: Import { target: fc_qn(seg: ^fc_import_b_seg), visibility: ImportVisible },
          tail: Empty
        }
      }
    },
    index: source_root_index_empty(),
    active_roots: Empty,
    policy: ImportScoped
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
  })
}

test fn resolve_with_admission_threads_validate_diagnostics_on_accept() -> Bool {
  fc_with_roots(o: fc_dual_import_roots(), f: fn(roots) {
  match validate_module_roots(roots: roots) {
    Accepted { value: _, diagnostics: validate_diag } =>
      match resolve_with_admission_policy(
        lm: dag_language_model_surface_empty_prelude(),
        roots: roots,
        admission: Admission {
          subject: ResolutionSubject {
            name: fc_qn(seg: ^fc_subject_seg)
          },
          imports: Cons {
            head: Import { target: fc_qn(seg: ^fc_import_a_seg), visibility: ImportVisible },
            tail: Cons {
              head: Import { target: fc_qn(seg: ^fc_import_b_seg), visibility: ImportVisible },
              tail: Empty
            }
          }
        },
        index: source_root_index_empty(),
        active_roots: Empty,
        policy: ImportScoped
      ) {
        Accepted { value: _, diagnostics: resolve_diag } =>
          diagnostics_eq(a: resolve_diag, b: validate_diag)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
  })
}

