}

test fn validate_module_roots_threads_accepted_projection_diagnostics() -> Bool {
  fc_with_roots(o: fc_single_found_root(), f: fn(roots) {
  match validate_module_roots(roots: roots) {
    Accepted { value: _, diagnostics: d } =>
      diagnostics_eq(a: d, b: None)
    Rejected { diagnostics: _ } => false
  }
  })
}

test fn validate_module_roots_merges_pending_before_duplicate_reject() -> Bool {
  fc_with_roots(o: fc_duplicate_roots(), f: fn(roots) {
  match validate_module_roots(roots: roots) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
  })
}

test fn validate_module_roots_malformed_root_is_rejected() -> Bool {
  fc_with_roots(o: fc_malformed_subject_roots(), f: fn(roots) {
  match validate_module_roots(roots: roots) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
  })
}

test fn resolve_malformed_subject_root_is_rejected() -> Bool {
  fc_with_roots(o: fc_malformed_subject_roots(), f: fn(roots) {
  match resolve_with_admission(
    lm: dag_language_model_surface_empty_prelude(),
    roots: roots,
    admission: Admission {
      subject: ResolutionSubject {
