module v2.test.name_resolve.admission_fail_closed


test fn resolve_module_not_found_preserves_missing_module_identity() -> Bool {
  let missing = fc_qn(seg: ^fc_missing_seg)
  fc_with_roots(o: fc_single_found_root(), f: fn(roots) {
  match subject_module_root_for_name(roots: roots, name: missing) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      match d.head.at {
        Textual { file: module_file, extent: _ } =>
          (d.head.reason == ^resolve_module_not_found)
            && (symbol_lexeme(sym: module_file) == qualified_name_to_dotted_string(qn: missing))
        _ => false
      }
  }
  })
}

fn fc_qn_node(seg: v2.std.node.Symbol) -> Node {
  fold_list_node(
    xs: std.algebra.Cons { head: seg, tail: std.algebra.Empty },
    item_node: fn(sym) {
      v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    }
  )
}

fn fc_module_root_export(seg: v2.std.node.Symbol, export_sym: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: fc_qn_node(seg: seg)
      ),
      v2.std.node.Edge {
        label: Named { name: export_sym },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn fc_module_root(seg: v2.std.node.Symbol) -> Node {
  fc_module_root_export(seg: seg, export_sym: ^fc_export_sym)
}

fn fc_qn(seg: v2.std.node.Symbol) -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons { head: seg, tail: std.algebra.Empty }
}

data fc_admitted_fixture_note: String = "These fixtures pass module roots to validate_module_roots / resolve_with_admission, which since BL-1 take FreeMonoid<NormalizedTree>. They therefore admit each synthetic root through the real door rather than casting past it -- a fixture that reached the sealed carrier without admission would be the wrapper-payload conflation the receipt in docs/plans/hollow-alias-construction-wall.md section 8.2 records, planted in the witness population. Admission is threaded as an Outcome and its refusal arm FAILS the witness: a fixture that cannot be admitted is a broken fixture, and reporting that as a passing verdict is the fabrication these witnesses exist to catch."

fn fc_with_roots(
  o: v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>>,
  f: fn(FreeMonoid<NormalizedTree>) -> Bool
) -> Bool {
  match o {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: roots, diagnostics: _ } => f(roots)
  }
}

fn fc_admitted(n: Node) -> v2.std.diagnostic.Outcome<v2.compiler.normalized_tree.NormalizedTree> {
  admit_normalized_tree(root: n, diagnostics: None)
}

fn fc_duplicate_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_dup_seg)), f: fn(a) {
    bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_dup_seg)), f: fn(b) {
      outcome_accepted(value: std.algebra.Cons { head: a, tail: std.algebra.Cons { head: b, tail: std.algebra.Empty } })
    })
  })
}

fn fc_single_found_root() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_module_root(seg: ^fc_found_seg)), f: fn(a) {
    outcome_accepted(value: std.algebra.Cons { head: a, tail: std.algebra.Empty })
  })
}

fn fc_malformed_subject_root() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: fc_qn_node(seg: ^fc_malformed_seg)
      ),
      v2.std.node.Edge {
        label: Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fc_malformed_child_sym } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn fc_malformed_subject_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_malformed_subject_root()), f: fn(a) {
    outcome_accepted(value: std.algebra.Cons { head: a, tail: std.algebra.Empty })
  })
}

fn fc_import_missing_target() -> v2.compiler.name_resolve.Import {
  v2.compiler.name_resolve.Import { target: fc_qn(seg: ^fc_missing_seg), visibility: ImportVisible }
}

fn fc_initial_admission_state() -> v2.compiler.name_resolve.AdmissionState {
  v2.compiler.name_resolve.AdmissionAccepted { bindings: empty_map(), origins: empty_map() }
}

test fn admit_import_missing_module_is_rejected() -> Bool {
  fc_with_roots(o: fc_single_found_root(), f: fn(roots) {
  match admit_import_entry(
    roots: roots,
    import_edge: fc_import_missing_target(),
    state: fc_initial_admission_state(),
    subject_qn: fc_qn(seg: ^fc_subject_seg),
    index: source_root_index_empty(),
    active_roots: std.algebra.Empty
  ) {
    AdmissionAccepted { bindings: _, origins: _ } => false
    AdmissionRejected { diagnostics: _ } => true
  }
  })
}

test fn resolve_duplicate_module_roots_is_rejected() -> Bool {
  fc_with_roots(o: fc_duplicate_roots(), f: fn(roots) {
  match resolve_with_admission(
    lm: dag_language_model_surface_empty_prelude(),
    roots: roots,
    admission: v2.compiler.name_resolve.Admission {
      subject: v2.compiler.name_resolve.ResolutionSubject {
        name: fc_qn(seg: ^fc_dup_seg)
      },
      imports: Empty
    }
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
  })
}

