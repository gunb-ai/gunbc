fn fc_dual_import_subject_root(seg: v2.std.node.Symbol, use_sym: v2.std.node.Symbol, imported_decl: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: fc_qn_node(seg: seg)
      ),
      v2.std.node.Edge {
        label: Named { name: use_sym },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: imported_decl } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn fc_dual_import_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  bind_outcome(o: fc_admitted(n: fc_dual_import_subject_root(
    seg: ^fc_subject_seg,
    use_sym: ^fc_import_use_sym,
    imported_decl: ^fc_export_a_sym
  )), f: fn(a) {
    bind_outcome(o: fc_admitted(n: fc_module_root_export(seg: ^fc_import_a_seg, export_sym: ^fc_export_a_sym)), f: fn(b) {
      bind_outcome(o: fc_admitted(n: fc_module_root_export(seg: ^fc_import_b_seg, export_sym: ^fc_export_b_sym)), f: fn(c) {
        outcome_accepted(value: std.algebra.Cons { head: a, tail: std.algebra.Cons { head: b, tail: std.algebra.Cons { head: c, tail: std.algebra.Empty } } })
      })
    })
  })
}

test fn resolve_dual_imports_do_not_collide_on_header_metadata() -> Bool {
  fc_with_roots(o: fc_dual_import_roots(), f: fn(roots) {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: roots,
    admission: v2.compiler.name_resolve.Admission {
      subject: v2.compiler.name_resolve.ResolutionSubject {
        name: fc_qn(seg: ^fc_subject_seg)
      },
      imports: std.algebra.Cons {
        head: v2.compiler.name_resolve.Import { target: fc_qn(seg: ^fc_import_a_seg), visibility: ImportVisible },
        tail: std.algebra.Cons {
          head: v2.compiler.name_resolve.Import { target: fc_qn(seg: ^fc_import_b_seg), visibility: ImportVisible },
          tail: std.algebra.Empty
        }
      }
    },
    index: source_root_index_empty(),
    active_roots: std.algebra.Empty,
    policy: ImportScoped
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
  })
}

test fn resolve_with_admission_threads_validate_diagnostics_on_accept() -> Bool {
  fc_with_roots(o: fc_dual_import_roots(), f: fn(roots) {
  match validate_module_roots(roots: roots) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: validate_diag } =>
      match resolve_with_admission_policy(
        lm: dag_language_model_surface_empty_prelude(),
        roots: roots,
        admission: v2.compiler.name_resolve.Admission {
          subject: v2.compiler.name_resolve.ResolutionSubject {
            name: fc_qn(seg: ^fc_subject_seg)
          },
          imports: std.algebra.Cons {
            head: v2.compiler.name_resolve.Import { target: fc_qn(seg: ^fc_import_a_seg), visibility: ImportVisible },
            tail: std.algebra.Cons {
              head: v2.compiler.name_resolve.Import { target: fc_qn(seg: ^fc_import_b_seg), visibility: ImportVisible },
              tail: std.algebra.Empty
            }
          }
        },
        index: source_root_index_empty(),
        active_roots: std.algebra.Empty,
        policy: ImportScoped
      ) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: resolve_diag } =>
          diagnostics_eq(a: resolve_diag, b: validate_diag)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
  })
}

