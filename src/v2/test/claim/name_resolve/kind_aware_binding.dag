module v2.test.claim.name_resolve.kind_aware_binding

import v2.compiler.source_root_eval {
  native_test_context_from_ingest,
  native_lane_file_refusal_index,
  native_module_resolve_verdict,
  NativeTestContext,
  NativeModuleResolveVerdict,
  NativeModuleResolveAccepted,
  NativeModuleResolveRefused
}
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol }
import std.types { Bool }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Production lookup is kind-aware: a type-role Optional and a constructor Optional of the same
// spelling are not one ambiguous name. Eligibility is
// std.occurrence_binding_resolve occurrence_category_binding_verdict applied to the lexical
// population before symbol_index_lexical_selection (v2.compiler.resolve
// lookup_symbol_index_atom_identity). These claims run the native prepare/resolve route.

data kab_type_opt_source: String = "module v2.test.kab.type_opt\n\ntype Optional<T> = Missing | Held { value: T }\n"

data kab_type_opt2_source: String = "module v2.test.kab.type_opt2\n\ntype Optional<T> = OtherMiss | OtherHeld { value: T }\n"

data kab_card_source: String = "module v2.test.kab.card\n\ntype Card = Need | Optional\n"

data kab_user_source: String = "module v2.test.kab.user\n\nimport v2.test.kab.type_opt { Optional }\nimport v2.test.kab.card { Optional }\ntype Unit = | U\nfn f(x: Optional<Unit>) -> Unit { U }\n"

data kab_value_user_source: String = "module v2.test.kab.value_user\n\nimport v2.test.kab.type_opt { Optional }\nimport v2.test.kab.card { Card, Optional }\nfn g() -> Card { Optional }\n"

data kab_wrong_kind_source: String = "module v2.test.kab.wrong_kind\n\nimport v2.test.kab.card { Optional }\ntype Unit = | U\nfn f(x: Optional<Unit>) -> Unit { U }\n"

data kab_two_types_source: String = "module v2.test.kab.two_types\n\nimport v2.test.kab.type_opt { Optional }\nimport v2.test.kab.type_opt2 { Optional }\ntype Unit = | U\nfn f(x: Optional<Unit>) -> Unit { U }\n"

data kab_data_n_source: String = "module v2.test.kab.data_n\n\ndata n: Int = 1\n"

data kab_data_n_user_source: String = "module v2.test.kab.data_n_user\n\nimport v2.test.kab.data_n { n }\nfn h() -> Int { n }\n"

data kab_data_n_as_type_source: String = "module v2.test.kab.data_n_as_type\n\nimport v2.test.kab.data_n { n }\nfn h(x: n) -> Int { 1 }\n"

data kab_fn_data_source: String = "module v2.test.kab.fn_data\n\ndata n: Int = 1\nfn k() -> Int { 2 }\n"

data kab_fn_data_user_source: String = "module v2.test.kab.fn_data_user\n\nimport v2.test.kab.fn_data { n, k }\nfn h() -> Int { n }\nfn g() -> Int { k() }\n"

data kab_alias_types_source: String = "module v2.test.kab.alias_types\n\ntype FsIntList = FsIntEmpty | FsIntCons { head: Int, tail: FsIntList }\n\ntype FsIntNonEmpty {\n  head: Int\n  tail: FsIntList\n}\n\ntype FsIntAlias = FsIntNonEmpty\n"

data kab_alias_return_source: String = "module v2.test.kab.alias_return\n\nimport v2.test.kab.alias_types { FsIntAlias, FsIntNonEmpty, FsIntEmpty }\nfn fse_alias_ok() -> FsIntAlias { FsIntNonEmpty { head: 1, tail: FsIntEmpty } }\n"

data kab_alias_formal_source: String = "module v2.test.kab.alias_formal\n\nimport v2.test.kab.alias_types { FsIntAlias, FsIntNonEmpty }\nfn f(x: FsIntAlias) -> FsIntNonEmpty { x }\n"

data kab_qual_type_source: String = "module v2.test.kab.qual_type\n\nimport v2.test.kab.type_opt { Optional }\nimport v2.test.kab.card { Optional }\ntype Unit = | U\nfn f(x: v2.test.kab.type_opt.Optional<Unit>) -> Unit { U }\n"

data kab_qual_ctor_source: String = "module v2.test.kab.qual_ctor\n\nimport v2.test.kab.type_opt { Optional }\nimport v2.test.kab.card { Card, Optional }\nfn g() -> Card { v2.test.kab.card.Optional }\n"

data kab_rec_source: String = "module v2.test.kab.rec\n\ntype Rec { value: Unit }\ntype Unit = | U\n"

data kab_rec_user_source: String = "module v2.test.kab.rec_user\n\nimport v2.test.kab.rec\nimport v2.test.kab.rec { Rec }\nfn f(x: Rec) -> Rec { x }\n"

data kab_rec_ctor_source: String = "module v2.test.kab.rec_ctor\n\nimport v2.test.kab.rec\nimport v2.test.kab.rec { Rec, Unit, U }\nfn f() -> Rec { Rec { value: U } }\n"

data kab_record_field_source: String = "module v2.test.kab.record_field\n\nimport v2.test.kab.type_opt { Optional }\nimport v2.test.kab.card { Optional }\ntype Unit = | U\ntype Box { v: Optional<Unit> }\n"

data kab_alias_rhs_source: String = "module v2.test.kab.alias_rhs\n\nimport v2.test.kab.type_opt { Optional }\nimport v2.test.kab.card { Optional }\ntype Unit = | U\ntype Box = Optional<Unit>\n"

data kab_variant_payload_source: String = "module v2.test.kab.variant_payload\n\nimport v2.test.kab.type_opt { Optional }\nimport v2.test.kab.card { Optional }\ntype Unit = | U\ntype Box = Wrap { v: Optional<Unit> }\n"

data kab_m_source: String = "module v2.test.kab.m\n\ntype R { value: Unit }\ntype Unit = | U\n"

data kab_qual_m_r_source: String = "module v2.test.kab.qual_m_r\n\nimport v2.test.kab.m { R, Unit, U }\nfn f() -> R { v2.test.kab.m.R { value: U } }\n"

data kab_shadow_m_source: String = "module v2.test.kab.shadow_m\n\nimport v2.test.kab.m { R, Unit, U }\nfn f(m: R) -> R { m.R { value: U } }\n"

data kab_root_m_source: String = "module v2.test.kab.root_m\n\nimport v2.test.kab.m { R, Unit, U }\ndata m: R = R { value: U }\nfn f() -> R { m.R { value: U } }\n"

data kab_refined_source: String = "module v2.test.kab.refined\n\nfn positive(n: Int) -> Bool { true }\ntype Pos = Int where positive\n"

data kab_refined_user_source: String = "module v2.test.kab.refined_user\n\nimport v2.test.kab.refined { Pos }\nfn f(p: Pos) -> Bool { true }\ntype Box { p: Pos }\n"

data kab_refined_as_value_source: String = "module v2.test.kab.refined_as_value\n\nimport v2.test.kab.refined { Pos }\nfn g() -> Int { Pos }\n"

fn kab_read(text: String, id: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: text, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: id,
    source_root: DagTree
  }
}

fn kab_context() -> Outcome<NativeTestContext> {
  native_test_context_from_ingest(ingest: [
    kab_read(text: kab_type_opt_source, id: ^kab_type_opt, path: "src/v2/test/fixture/kab/type_opt.dag"),
    kab_read(text: kab_type_opt2_source, id: ^kab_type_opt2, path: "src/v2/test/fixture/kab/type_opt2.dag"),
    kab_read(text: kab_card_source, id: ^kab_card, path: "src/v2/test/fixture/kab/card.dag"),
    kab_read(text: kab_user_source, id: ^kab_user, path: "src/v2/test/fixture/kab/user.dag"),
    kab_read(text: kab_value_user_source, id: ^kab_value_user, path: "src/v2/test/fixture/kab/value_user.dag"),
    kab_read(text: kab_wrong_kind_source, id: ^kab_wrong_kind, path: "src/v2/test/fixture/kab/wrong_kind.dag"),
    kab_read(text: kab_two_types_source, id: ^kab_two_types, path: "src/v2/test/fixture/kab/two_types.dag"),
    kab_read(text: kab_data_n_source, id: ^kab_data_n, path: "src/v2/test/fixture/kab/data_n.dag"),
    kab_read(text: kab_data_n_user_source, id: ^kab_data_n_user, path: "src/v2/test/fixture/kab/data_n_user.dag"),
    kab_read(text: kab_data_n_as_type_source, id: ^kab_data_n_as_type, path: "src/v2/test/fixture/kab/data_n_as_type.dag"),
    kab_read(text: kab_fn_data_source, id: ^kab_fn_data, path: "src/v2/test/fixture/kab/fn_data.dag"),
    kab_read(text: kab_fn_data_user_source, id: ^kab_fn_data_user, path: "src/v2/test/fixture/kab/fn_data_user.dag"),
    kab_read(text: kab_alias_types_source, id: ^kab_alias_types, path: "src/v2/test/fixture/kab/alias_types.dag"),
    kab_read(text: kab_alias_return_source, id: ^kab_alias_return, path: "src/v2/test/fixture/kab/alias_return.dag"),
    kab_read(text: kab_alias_formal_source, id: ^kab_alias_formal, path: "src/v2/test/fixture/kab/alias_formal.dag"),
    kab_read(text: kab_qual_type_source, id: ^kab_qual_type, path: "src/v2/test/fixture/kab/qual_type.dag"),
    kab_read(text: kab_qual_ctor_source, id: ^kab_qual_ctor, path: "src/v2/test/fixture/kab/qual_ctor.dag"),
    kab_read(text: kab_rec_source, id: ^kab_rec, path: "src/v2/test/fixture/kab/rec.dag"),
    kab_read(text: kab_rec_user_source, id: ^kab_rec_user, path: "src/v2/test/fixture/kab/rec_user.dag"),
    kab_read(text: kab_rec_ctor_source, id: ^kab_rec_ctor, path: "src/v2/test/fixture/kab/rec_ctor.dag"),
    kab_read(text: kab_record_field_source, id: ^kab_record_field, path: "src/v2/test/fixture/kab/record_field.dag"),
    kab_read(text: kab_alias_rhs_source, id: ^kab_alias_rhs, path: "src/v2/test/fixture/kab/alias_rhs.dag"),
    kab_read(text: kab_variant_payload_source, id: ^kab_variant_payload, path: "src/v2/test/fixture/kab/variant_payload.dag"),
    kab_read(text: kab_m_source, id: ^kab_m, path: "src/v2/test/fixture/kab/m.dag"),
    kab_read(text: kab_qual_m_r_source, id: ^kab_qual_m_r, path: "src/v2/test/fixture/kab/qual_m_r.dag"),
    kab_read(text: kab_shadow_m_source, id: ^kab_shadow_m, path: "src/v2/test/fixture/kab/shadow_m.dag"),
    kab_read(text: kab_root_m_source, id: ^kab_root_m, path: "src/v2/test/fixture/kab/root_m.dag"),
    kab_read(text: kab_refined_source, id: ^kab_refined, path: "src/v2/test/fixture/kab/refined.dag"),
    kab_read(text: kab_refined_user_source, id: ^kab_refined_user, path: "src/v2/test/fixture/kab/refined_user.dag"),
    kab_read(text: kab_refined_as_value_source, id: ^kab_refined_as_value, path: "src/v2/test/fixture/kab/refined_as_value.dag")
  ])
}

type KabVerdicts {
  user: NativeModuleResolveVerdict
  value_user: NativeModuleResolveVerdict
  wrong_kind: NativeModuleResolveVerdict
  two_types: NativeModuleResolveVerdict
  data_n_user: NativeModuleResolveVerdict
  data_n_as_type: NativeModuleResolveVerdict
  fn_data_user: NativeModuleResolveVerdict
  alias_return: NativeModuleResolveVerdict
  alias_formal: NativeModuleResolveVerdict
  qual_type: NativeModuleResolveVerdict
  qual_ctor: NativeModuleResolveVerdict
  rec_user: NativeModuleResolveVerdict
  rec_ctor: NativeModuleResolveVerdict
  record_field: NativeModuleResolveVerdict
  alias_rhs: NativeModuleResolveVerdict
  variant_payload: NativeModuleResolveVerdict
  qual_m_r: NativeModuleResolveVerdict
  shadow_m: NativeModuleResolveVerdict
  root_m: NativeModuleResolveVerdict
  refined_user: NativeModuleResolveVerdict
  refined_as_value: NativeModuleResolveVerdict
}

fn kab_verdicts() -> Optional<KabVerdicts> {
  match kab_context() {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: context, diagnostics: _ } =>
      {
        let index = native_lane_file_refusal_index(refusals: context.file_refusals)
        optional_present(value: KabVerdicts {
          user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.user", path: ^kab_user).verdict,
          value_user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.value_user", path: ^kab_value_user).verdict,
          wrong_kind: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.wrong_kind", path: ^kab_wrong_kind).verdict,
          two_types: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.two_types", path: ^kab_two_types).verdict,
          data_n_user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.data_n_user", path: ^kab_data_n_user).verdict,
          data_n_as_type: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.data_n_as_type", path: ^kab_data_n_as_type).verdict,
          fn_data_user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.fn_data_user", path: ^kab_fn_data_user).verdict,
          alias_return: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.alias_return", path: ^kab_alias_return).verdict,
          alias_formal: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.alias_formal", path: ^kab_alias_formal).verdict,
          qual_type: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.qual_type", path: ^kab_qual_type).verdict,
          qual_ctor: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.qual_ctor", path: ^kab_qual_ctor).verdict,
          rec_user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.rec_user", path: ^kab_rec_user).verdict,
          rec_ctor: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.rec_ctor", path: ^kab_rec_ctor).verdict,
          record_field: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.record_field", path: ^kab_record_field).verdict,
          alias_rhs: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.alias_rhs", path: ^kab_alias_rhs).verdict,
          variant_payload: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.variant_payload", path: ^kab_variant_payload).verdict,
          qual_m_r: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.qual_m_r", path: ^kab_qual_m_r).verdict,
          shadow_m: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.shadow_m", path: ^kab_shadow_m).verdict,
          root_m: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.root_m", path: ^kab_root_m).verdict,
          refined_user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.refined_user", path: ^kab_refined_user).verdict,
          refined_as_value: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.kab.refined_as_value", path: ^kab_refined_as_value).verdict
        })
      }
  }
}

fn kab_accepted(v: NativeModuleResolveVerdict) -> Bool {
  match v {
    NativeModuleResolveAccepted { resolved: _ } => true
    _ => false
  }
}

fn kab_fatal(v: NativeModuleResolveVerdict) -> Optional<Symbol> {
  match v {
    NativeModuleResolveRefused { first: d, rest: _, observation: _ } =>
      optional_present(value: diagnostics_fatal_reason(d: d))
    _ => optional_absent()
  }
}

fn kab_refuses_with(v: NativeModuleResolveVerdict, reason: Symbol) -> Bool {
  match kab_fatal(v: v) {
    Present { value: r } => r == reason
    Absent => false
  }
}

// THE THREE-LINE REPRO. Importing the type Optional and the Card variant Optional must not refuse
// Optional<Unit> in type position: the variant is ineligible before none/one/many.
test fn type_role_optional_resolves_beside_a_same_spelling_variant() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.user)
  }
}

// THE VALUE-ROLE DUAL. The same two imports bind the variant in a constructor position.
test fn value_role_optional_binds_the_variant_beside_the_type() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.value_user)
  }
}

// WRONG KIND. Only the variant is imported; Optional<Unit> in type position is a category mismatch (the name exists, as a variant). The
// kernel excludes an inadmissible declaration then runs none/one/many
// (occurrence_binding_resolve_category_inadmissible_candidate_is_excluded_holds →
// OccurrenceUnbound). WrongOccurrenceRole is a different cause (declaration vs reference role).
test fn a_variant_optional_in_type_position_is_a_category_mismatch() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_refuses_with(v: vs.wrong_kind, reason: ^resolve_reason_reference_category_mismatch)
  }
}

// GENUINE AMBIGUITY. Two type declarations named Optional stay many after eligibility.
test fn two_type_optionals_remain_ambiguous_in_type_position() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_refuses_with(v: vs.two_types, reason: ^resolve_reason_ambiguous_symbol)
  }
}

// DATA VALUE IN VALUE POSITION. Lowering turns `data n` into a nullary Arrow, classified
// CallableOccurrence. occurrence_category_binding_verdict admits CallableOccurrence as a
// declaration for a LexicalValueOccurrence reference, so the value-position use stays eligible;
// type position excludes it and the kernel fold is unbound (not a second diagnostic).
test fn a_data_value_resolves_in_value_position() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.data_n_user)
  }
}

test fn a_data_value_in_type_position_is_a_category_mismatch() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_refuses_with(v: vs.data_n_as_type, reason: ^resolve_reason_reference_category_mismatch)
  }
}

// SAME-MODULE IMPORT. An imported fn and an imported data value from one module both bind in
// their positions: the import item is NotATypeDecl, so neither lookup walks as TypeOccurrence.
test fn an_imported_fn_and_data_value_from_the_same_module_resolve() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.fn_data_user)
  }
}

// ALIAS-TYPED FORMAL (#13832 regression): fill treated NotATypeDecl as "no members", so a fn Arrow
// was never descended and `x` was not indexed. Body `{ x }` refused parameter_path_not_indexed;
// return-position alias has no parameter path and stayed green.
test fn an_alias_typed_formal_resolves_and_its_body_x_binds() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.alias_formal)
  }
}

test fn an_alias_in_return_position_still_resolves() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.alias_return)
  }
}

// QUALIFIED PATHS USE THE SAME ELIGIBILITY (resolve_declared_path_reading /
// symbol_index_lexical_eligible). A dotted type Optional is not ambiguous with the imported variant.
test fn a_qualified_type_optional_resolves_beside_a_same_spelling_variant() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.qual_type)
  }
}

test fn a_qualified_variant_optional_binds_beside_the_type() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.qual_ctor)
  }
}

// CORPUS SHAPE: GitHubAppInstallationId / SystemdRunProperty / R2BucketResponse are record types
// used in type position with a whole-module import plus a listed import of the name.
test fn a_listed_record_type_binds_beside_a_whole_module_import() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.rec_user)
  }
}

// CONSTRUCT TAG. Rec is RecordTypePayload. The tag door is the payload map
// (symbol_index_lexical_lookup_for_declared_payload), not ConstructorOccurrence.
test fn a_record_construct_tag_resolves() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.rec_ctor)
  }
}

// TYPE-DECLARATION MEMBERS ARE TYPE POSITIONS. The same two Optional imports as kab_user;
// a colliding constructor must not bind a record field, alias RHS, or variant payload.
test fn a_record_field_type_optional_resolves_beside_a_same_spelling_variant() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.record_field)
  }
}

test fn an_alias_rhs_optional_resolves_beside_a_same_spelling_variant() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.alias_rhs)
  }
}

test fn a_variant_payload_optional_resolves_beside_a_same_spelling_variant() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.variant_payload)
  }
}

// QUALIFIED CONSTRUCT TAG: unshadowed v2.test.kab.m.R admits as the record constructor.
test fn an_unshadowed_qualified_record_constructor_admits() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.qual_m_r)
  }
}

// A FRAME BINDER m MUST STAY A PROJECTION, not select the global record m.R.
test fn a_shadowing_frame_binder_does_not_bind_the_global_record_constructor() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_refuses_with(v: vs.shadow_m, reason: ^resolve_reason_construct_tag_not_a_constructor)
  }
}

// A ROOT-BOUND VALUE HEAD KEEPS ITS PROJECTION READING (same as fps_a_root_bound_data_value_projects).
test fn a_root_bound_value_head_keeps_its_projection_reading_on_a_construct_tag() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_refuses_with(v: vs.root_m, reason: ^resolve_reason_construct_tag_not_a_constructor)
  }
}

// AN IMPORTED REFINEMENT IS A TYPE. `type Pos = Int where positive` is stored as a Conj carrying
// its where clause (v2.std.type_binder refinement_declaration_of_node). Kind eligibility had read
// every non-record Conj as a value, so an imported refinement was excluded from type position and
// refused unbound -- std.types Char inside v2.std.text, which refused String for every importer.
// Both type positions bind: a parameter and a record field.
test fn an_imported_refinement_binds_in_type_position() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_accepted(v: vs.refined_user)
  }
}

// THE DUAL. Classified as a value, the same refinement used to bind in value position; as a type
// it is excluded there and the kernel fold is unbound.
test fn an_imported_refinement_in_value_position_is_a_category_mismatch() -> Bool {
  match kab_verdicts() {
    Absent => false
    Present { value: vs } => kab_refuses_with(v: vs.refined_as_value, reason: ^resolve_reason_reference_category_mismatch)
  }
}
