module v2.test.name_resolve.test_code_reference_wall

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE WALL AT ONE INTERFACE: name resolution, handed modules the real front end produced from
// source (tokenize, parse_module, normalize -- which is also where the `test` marker is captured
// onto NormalizedTree). Each claim reports the head refusal reason or ACCEPTED, so a red that
// refuses for some OTHER reason (an unbound name, a malformed root) does not pass for the wall.
//
// Every fixture body is expression-bodied (`fn f() -> T = expr`). A block body holding a call,
// `{ leaf() }`, lowers today to a Transform over the brace token with the call gone, so a block-bodied
// fixture would hand resolution no reference at all and every red would green for the wrong reason.
//
// The owner ruling (2026-09-16/17) has two halves, and each has a red and a control here:
// a test-marked declaration may be referenced by NOTHING, a test fn in the same module included;
// and serving code may not depend on any declaration of a module that declares tests, while
// another test module may.

// The language model is built ONCE per claim and handed to every stage: building it is a large share
// of a claim's cost, and each stage needs the same one.
fn wall_normalized(lm: LanguageModel, src: String, file: Symbol) -> Outcome<NormalizedTree> {
  match tokenize(text: src, file: file, rules: lm.lex) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: artifact, diagnostics: _ } => normalize(parse_tree: artifact.tree)
      }
  }
}

fn wall_verdict(outcome: Outcome<ResolvedTree>) -> String {
  match outcome {
    Accepted { value: _, diagnostics: _ } => "ACCEPTED"
    Rejected { diagnostics: d } => symbol_lexeme(sym: d.head.reason)
  }
}

// Resolves `subject_src` with `peer_src` beside it as the only other root, through the multi-root
// door (v2.compiler.name_resolve resolve_with_admission) -- the one the native compile uses. The
// single-tree door, v2.compiler.resolve resolve, builds its namespace from the root's own Conj and
// does not see the members of a grafted module root at all, so it cannot bind a module-level
// reference either way and is not a door this wall can be measured at.
fn wall_resolve_with_peer(subject_src: String, peer_src: String) -> String {
  let lm = dag_language_model()
  match wall_normalized(lm: lm, src: subject_src, file: ^wall_subject_file) {
    Rejected { diagnostics: _ } => "SUBJECT_REFUSED_BEFORE_RESOLVE"
    Accepted { value: subject, diagnostics: _ } =>
      match wall_normalized(lm: lm, src: peer_src, file: ^wall_peer_file) {
        Rejected { diagnostics: _ } => "PEER_REFUSED_BEFORE_RESOLVE"
        Accepted { value: peer, diagnostics: _ } =>
          match qualified_name_from_module_node(root: subject.root) {
            Rejected { diagnostics: _ } => "SUBJECT_UNNAMED"
            Accepted { value: subject_qn, diagnostics: _ } =>
              wall_verdict(outcome: resolve_with_admission(
                lm: lm,
                roots: Cons { head: subject, tail: Cons { head: peer, tail: Empty } },
                admission: Admission {
                  subject: ResolutionSubject { name: subject_qn },
                  imports: Empty
                }
              ))
          }
      }
  }
}

data test_calls_test_source: String = "module wall.same\n\ntest fn leaf() -> Bool = true\n\ntest fn rollup() -> Bool = leaf()\n"

data serving_calls_test_source: String = "module wall.same\n\ntest fn leaf() -> Bool = true\n\nfn helper() -> Bool = leaf()\n"

data test_calls_helper_source: String = "module wall.same\n\nfn helper() -> Bool = true\n\ntest fn uses_helper() -> Bool = helper()\n"

data local_shadows_test_source: String = "module wall.same\n\ntest fn leaf() -> Bool = true\n\nfn helper(leaf: Bool) -> Bool = leaf\n"

data peer_test_module_source: String = "module wall.peer\n\nfn shared_fixture() -> Bool = true\n\ntest fn peer_leaf() -> Bool = shared_fixture()\n"

data peer_serving_module_source: String = "module wall.peer\n\nfn shared_fixture() -> Bool = true\n"

data serving_reaches_peer_test_fn_source: String = "module wall.serving\n\nfn uses_peer() -> Bool = peer_leaf()\n"

data serving_reaches_peer_test_module_source: String = "module wall.serving\n\nfn uses_peer() -> Bool = shared_fixture()\n"

data test_module_reaches_peer_test_module_source: String = "module wall.consumer\n\nfn local() -> Bool = true\n\ntest fn consumer_holds() -> Bool = shared_fixture()\n"

// RED: a test fn calling another test fn in its own module. This is the case the ruling names
// explicitly.
test fn test_fn_calling_a_test_fn_is_refused_holds() -> Bool {
  wall_resolve_with_peer(subject_src: test_calls_test_source, peer_src: peer_serving_module_source)
    == "resolve_reason_test_code_referenced"
}

// RED: serving code calling a test fn in its own module.
test fn serving_fn_calling_a_test_fn_is_refused_holds() -> Bool {
  wall_resolve_with_peer(subject_src: serving_calls_test_source, peer_src: peer_serving_module_source)
    == "resolve_reason_test_code_referenced"
}

// RED: serving code calling a test fn another module declares.
test fn serving_code_calling_another_modules_test_fn_is_refused_holds() -> Bool {
  wall_resolve_with_peer(subject_src: serving_reaches_peer_test_fn_source, peer_src: peer_test_module_source)
    == "resolve_reason_test_code_referenced"
}

// RED: serving code depending on an UNMARKED declaration of a module that declares tests.
test fn serving_code_depending_on_a_test_module_is_refused_holds() -> Bool {
  wall_resolve_with_peer(subject_src: serving_reaches_peer_test_module_source, peer_src: peer_test_module_source)
    == "resolve_reason_serving_code_depends_on_test_code"
}

// CONTROL: the intended shape, a test fn calling an ordinary fn, resolves.
test fn test_fn_calling_an_ordinary_fn_resolves_holds() -> Bool {
  wall_resolve_with_peer(subject_src: test_calls_helper_source, peer_src: peer_serving_module_source) == "ACCEPTED"
}

// CONTROL: a local binder that shares a test fn's name binds to the local, not to the test fn.
test fn a_local_binder_shadowing_a_test_fn_resolves_holds() -> Bool {
  wall_resolve_with_peer(subject_src: local_shadows_test_source, peer_src: peer_serving_module_source) == "ACCEPTED"
}

// CONTROL for the dependency half: the same reference from the same serving module resolves once the
// peer declares no tests, so the red above is about the peer's test code and nothing else.
test fn serving_code_depending_on_a_serving_module_resolves_holds() -> Bool {
  wall_resolve_with_peer(subject_src: serving_reaches_peer_test_module_source, peer_src: peer_serving_module_source)
    == "ACCEPTED"
}

// CONTROL: a test module may depend on another test module's ordinary declarations.
test fn test_module_depending_on_a_test_module_resolves_holds() -> Bool {
  wall_resolve_with_peer(subject_src: test_module_reaches_peer_test_module_source, peer_src: peer_test_module_source)
    == "ACCEPTED"
}

