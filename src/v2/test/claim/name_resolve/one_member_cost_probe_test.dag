module v2.test.name_resolve.one_member_cost_probe

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
  resolve_with_admission
}
import v2.compiler.normalized_tree { NormalizedTree, admit_normalized_tree }
import v2.compiler.parse { parse_module }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_canonical_symbols,
  dag_grammar,
  dag_grammar_atom,
  dag_language_model,
  dag_language_model_surface_empty_prelude,
  dag_lex,
  dag_named_edge
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list_node }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected, bind_outcome, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v2.std.qualified_name { QualifiedName }
import v2.std.text { String }

fn probe_qn_node(seg: Symbol) -> Node {
  fold_list_node(
    xs: Cons { head: seg, tail: Empty },
    item_node: fn(sym) {
      Node {
        kind: TypeNode { connective: Atom { identity: sym } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    }
  )
}

fn probe_one_member_root_export(export_sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: probe_qn_node(seg: ^probe_one_member_seg)
      ),
      Edge {
        label: Named { name: ^probe_export_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: export_sym } },
          children: [],
          occurrence_id: OccurrenceSynthetic
        }
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn probe_one_member_qn() -> QualifiedName {
  Cons { head: ^probe_one_member_seg, tail: Empty }
}

fn probe_roots_for_export(export_sym: Symbol) -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(
    o: admit_normalized_tree(
      root: probe_one_member_root_export(export_sym: export_sym),
      diagnostics: None
    ),
    f: fn(a) {
      outcome_accepted(value: Cons { head: a, tail: Empty })
    }
  )
}

fn probe_with_export_roots(
  export_sym: Symbol,
  f: fn(FreeMonoid<NormalizedTree>) -> Bool
) -> Bool {
  match probe_roots_for_export(export_sym: export_sym) {
    Rejected { diagnostics: _ } => false
    Accepted { value: roots, diagnostics: _ } => f(roots)
  }
}

fn probe_resolve(roots: FreeMonoid<NormalizedTree>) -> Outcome<ResolvedTree> {
  resolve_with_admission(
    lm: dag_language_model(),
    roots: roots,
    admission: Admission {
      subject: ResolutionSubject { name: probe_one_member_qn() },
      imports: Empty
    }
  )
}

fn probe_resolved_export_identity(tree: ResolvedTree, wanted: Symbol) -> Bool {
  match tree.kind {
    TypeNode { connective: Atom { identity: id } } => id == wanted
    _ =>
      fold(tree.children, init: false, f: fn(acc, e) {
        acc || probe_resolved_export_identity(tree: e.target, wanted: wanted)
      })
  }
}

test fn one_member_module_resolves_under_full_language_model() -> Bool {
  probe_with_export_roots(export_sym: ^dag_c3_surface_sugar_service, f: fn(roots) {
    match probe_resolve(roots: roots) {
      Accepted { value: resolved, diagnostics: _ } =>
        probe_resolved_export_identity(
          tree: resolved,
          wanted: ^dag_c3_surface_sugar_service
        )
      Rejected { diagnostics: _ } => false
    }
  })
}

test fn one_member_uncanonical_export_still_refuses() -> Bool {
  probe_with_export_roots(export_sym: ^probe_uncanonical_export, f: fn(roots) {
    match probe_resolve(roots: roots) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
  })
}

test fn one_member_missing_subject_still_refuses() -> Bool {
  probe_with_export_roots(export_sym: ^dag_c3_surface_sugar_service, f: fn(roots) {
    match resolve_with_admission(
      lm: dag_language_model(),
      roots: roots,
      admission: Admission {
        subject: ResolutionSubject {
          name: Cons { head: ^probe_missing_subject_seg, tail: Empty }
        },
        imports: Empty
      }
    ) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
  })
}

test fn empty_prelude_service_atom_still_refuses() -> Bool {
  probe_with_export_roots(export_sym: ^dag_c3_surface_sugar_service, f: fn(roots) {
    match resolve_with_admission(
      lm: dag_language_model_surface_empty_prelude(),
      roots: roots,
      admission: Admission {
        subject: ResolutionSubject { name: probe_one_member_qn() },
        imports: Empty
      }
    ) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
  })
}

test fn language_model_carries_its_canonical_symbols() -> Bool {
  let lm = dag_language_model()
  lm.canonical_symbols.member(^dag_c3_surface_sugar_service)
    && !lm.canonical_symbols.member(^probe_uncanonical_export)
}

data probe_front_end_source: String = "module probe.one_member\n"

test fn tokenize_parse_one_member_does_not_run_resolve() -> Bool {
  match tokenize(
    text: probe_front_end_source,
    file: ^probe_front_end_file,
    rules: dag_lex()
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tokens, diagnostics: _ } =>
      match parse_module(tokens: tokens, grammar: dag_grammar()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

test fn dag_canonical_symbols_keep_prelude_and_reject_uncanonical() -> Bool {
  dag_canonical_symbols().member(^dag_c3_surface_sugar_service)
    && !dag_canonical_symbols().member(^probe_uncanonical_export)
}
