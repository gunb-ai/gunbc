module v2.test.name_resolve.one_member_cost_probe

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
  resolve_with_admission
}
import v2.compiler.normalized_tree { NormalizedTree, admit_normalized_tree }
import v2.compiler.resolve { ResolvedTree }
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_language_model,
  dag_named_edge
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list_node }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected, bind_outcome, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v2.std.qualified_name { QualifiedName }

fn probe_qn_node(seg: Symbol) -> Node {
  fold_list_node(
    xs: Cons { head: seg, tail: Empty },
    item_node: fn(sym) {
      Node {
        kind: TypeNode { connective: Atom { identity: sym } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    }
  )
}

fn probe_one_member_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: probe_qn_node(seg: ^probe_one_member_seg)
      ),
      Edge {
        label: Named { name: ^probe_export_sym },
        target: Node {
          kind: TypeNode {
            connective: Atom { identity: ^dag_c3_surface_sugar_service }
          },
          children: [],
          occurrence_id: OccurrenceSynthetic
        }
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn probe_one_member_qn() -> QualifiedName {
  Cons { head: ^probe_one_member_seg, tail: Empty }
}

fn probe_one_member_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  bind_outcome(
    o: admit_normalized_tree(root: probe_one_member_root(), diagnostics: None),
    f: fn(a) {
      outcome_accepted(value: Cons { head: a, tail: Empty })
    }
  )
}

fn probe_with_roots(f: fn(FreeMonoid<NormalizedTree>) -> Bool) -> Bool {
  match probe_one_member_roots() {
    Rejected { diagnostics: _ } => false
    Accepted { value: roots, diagnostics: _ } => f(roots)
  }
}

fn probe_resolved_keeps_service_atom(tree: ResolvedTree) -> Bool {
  match tree.kind {
    TypeNode { connective: Atom { identity: id } } =>
      id == ^dag_c3_surface_sugar_service
    _ =>
      fold(tree.children, init: false, f: fn(acc, e) {
        acc || probe_resolved_keeps_service_atom(tree: e.target)
      })
  }
}

test fn one_member_module_resolves_under_full_language_model() -> Bool {
  probe_with_roots(f: fn(roots) {
    match resolve_with_admission(
      lm: dag_language_model(),
      roots: roots,
      admission: Admission {
        subject: ResolutionSubject { name: probe_one_member_qn() },
        imports: Empty
      }
    ) {
      Accepted { value: resolved, diagnostics: _ } =>
        probe_resolved_keeps_service_atom(tree: resolved)
      Rejected { diagnostics: _ } => false
    }
  })
}

test fn one_member_missing_subject_still_refuses() -> Bool {
  probe_with_roots(f: fn(roots) {
    match resolve_with_admission(
      lm: dag_language_model(),
      roots: roots,
      admission: Admission {
        subject: ResolutionSubject {
          name: Cons { head: ^probe_missing_subject_seg, tail: Empty }
        },
        imports: Empty
      }
    ) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
  })
}
