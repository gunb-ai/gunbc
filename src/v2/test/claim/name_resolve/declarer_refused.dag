module v2.test.claim.name_resolve.declarer_refused

import v2.compiler.source_root_eval {
  native_test_context_from_ingest,
  native_lane_file_refusal_index,
  native_module_resolve_verdict,
  NativeTestContext,
  NativeModuleResolveVerdict,
  NativeModuleResolveAccepted,
  NativeModuleResolveRefused
}
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree, SourceRootRef, V2Tree }
import v2.std.diagnostic {
  Accepted,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  DeclarerRefused,
  Suggested,
  Unavailable,
  UserInputBoundary,
  AmbiguousIntent,
  CorrectionNotModeled,
  ExternalContractUnknown,
  diagnostics_fatal,
  diagnostics_fatal_reason,
  diagnostics_list_has_reason
}
import v2.std.qualified_name { qualified_name_to_dotted_string }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol }
import std.types { Bool }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data dr_v2lib_source: String = "module v2.test.dr.v2lib\n\ntype Lib = L\n"

data dr_decl_source: String = "module v2.test.dr.decl\n\nimport v2.test.dr.v2lib { Lib }\ntype Rec { value: Lib }\n"

data dr_user_source: String = "module v2.test.dr.user\n\nimport v2.test.dr.decl { Rec }\nfn f(x: Rec) -> Rec { x }\n"

data dr_ctor_user_source: String = "module v2.test.dr.ctor_user\n\nimport v2.test.dr.decl { Rec }\nfn g() -> Rec { Rec { value: L } }\n"

data dr_rec_source: String = "module v2.test.dr.rec\n\ntype Rec { value: Unit }\ntype Unit = | U\n"

data dr_rec_user_source: String = "module v2.test.dr.rec_user\n\nimport v2.test.dr.rec\nimport v2.test.dr.rec { Rec }\nfn f(x: Rec) -> Rec { x }\n"

data dr_missing_source: String = "module v2.test.dr.missing\n\nfn f(x: Nowhere) -> Int { 1 }\n"

data dr_p_source: String = "module v2.test.dr.p\n\nimport v2.test.dr.v2lib { Lib }\n"

data dr_p_child_source: String = "module v2.test.dr.p.child\n\ntype R { value: Unit }\ntype Unit = | U\n"

data dr_nested_user_source: String = "module v2.test.dr.nested_user\n\nimport v2.test.dr.p.child { R }\nfn f(x: R) -> R { x }\n"

fn dr_read(text: String, id: Symbol, path: String, root: SourceRootRef) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: text, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: id,
    source_root: root
  }
}

fn dr_context() -> Outcome<NativeTestContext> {
  native_test_context_from_ingest(ingest: [
    dr_read(text: dr_v2lib_source, id: ^dr_v2lib, path: "src/v2/test/fixture/dr/v2lib.dag", root: V2Tree),
    dr_read(text: dr_decl_source, id: ^dr_decl, path: "src/v2/test/fixture/dr/decl.dag", root: DagTree),
    dr_read(text: dr_user_source, id: ^dr_user, path: "src/v2/test/fixture/dr/user.dag", root: DagTree),
    dr_read(text: dr_ctor_user_source, id: ^dr_ctor_user, path: "src/v2/test/fixture/dr/ctor_user.dag", root: DagTree),
    dr_read(text: dr_rec_source, id: ^dr_rec, path: "src/v2/test/fixture/dr/rec.dag", root: DagTree),
    dr_read(text: dr_rec_user_source, id: ^dr_rec_user, path: "src/v2/test/fixture/dr/rec_user.dag", root: DagTree),
    dr_read(text: dr_missing_source, id: ^dr_missing, path: "src/v2/test/fixture/dr/missing.dag", root: DagTree),
    dr_read(text: dr_p_source, id: ^dr_p, path: "src/v2/test/fixture/dr/p.dag", root: DagTree),
    dr_read(text: dr_p_child_source, id: ^dr_p_child, path: "src/v2/test/fixture/dr/p_child.dag", root: DagTree),
    dr_read(text: dr_nested_user_source, id: ^dr_nested_user, path: "src/v2/test/fixture/dr/nested_user.dag", root: DagTree)
  ])
}

type DrVerdicts {
  user: NativeModuleResolveVerdict
  ctor_user: NativeModuleResolveVerdict
  rec_user: NativeModuleResolveVerdict
  missing: NativeModuleResolveVerdict
  nested_user: NativeModuleResolveVerdict
}

fn dr_verdicts() -> Optional<DrVerdicts> {
  match dr_context() {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: context, diagnostics: _ } =>
      {
        let index = native_lane_file_refusal_index(refusals: context.file_refusals)
        optional_present(value: DrVerdicts {
          user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.dr.user", path: ^dr_user).verdict,
          ctor_user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.dr.ctor_user", path: ^dr_ctor_user).verdict,
          rec_user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.dr.rec_user", path: ^dr_rec_user).verdict,
          missing: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.dr.missing", path: ^dr_missing).verdict,
          nested_user: native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.dr.nested_user", path: ^dr_nested_user).verdict
        })
      }
  }
}

fn dr_accepted(v: NativeModuleResolveVerdict) -> Bool {
  match v {
    NativeModuleResolveAccepted { resolved: _ } => true
    _ => false
  }
}

fn dr_refused_first(v: NativeModuleResolveVerdict) -> Optional<NonEmptyDiagnostics> {
  match v {
    NativeModuleResolveRefused { first: d, rest: _, observation: _ } => optional_present(value: d)
    _ => optional_absent()
  }
}

fn dr_refuses_with(v: NativeModuleResolveVerdict, reason: Symbol) -> Bool {
  match dr_refused_first(v: v) {
    Present { value: d } => diagnostics_fatal_reason(d: d) == reason
    Absent => false
  }
}

fn dr_chain_names_cause(v: NativeModuleResolveVerdict, reason: Symbol) -> Bool {
  match dr_refused_first(v: v) {
    Present { value: d } =>
      (d.head.reason == reason) || diagnostics_list_has_reason(xs: d.tail, reason: reason)
    Absent => false
  }
}

// (a) A listed import of a name whose declaring module refused for dag→v2 is
// declarer-refused, carrying that module's cross-tree chain, not unbound_symbol.
test fn an_imported_name_from_a_cross_tree_refused_declarer_is_declarer_refused() -> Bool {
  match dr_verdicts() {
    Absent => false
    Present { value: vs } =>
      dr_refuses_with(v: vs.user, reason: ^resolve_reason_declarer_refused)
        && dr_chain_names_cause(v: vs.user, reason: ^resolve_cross_tree_import_denied)
        && !dr_refuses_with(v: vs.user, reason: ^resolve_reason_unbound_symbol)
  }
}

// Construct-tag door: imported Rec { … } from the same refused declarer, not unbound (review 79237).
test fn an_imported_record_construct_tag_from_a_refused_declarer_is_declarer_refused() -> Bool {
  match dr_verdicts() {
    Absent => false
    Present { value: vs } =>
      dr_refuses_with(v: vs.ctor_user, reason: ^resolve_reason_declarer_refused)
        && dr_chain_names_cause(v: vs.ctor_user, reason: ^resolve_cross_tree_import_denied)
        && !dr_refuses_with(v: vs.ctor_user, reason: ^resolve_reason_unbound_symbol)
  }
}

// (b) Whole-module import plus listed record type, same tree, declarer resolves.
test fn a_listed_record_type_binds_beside_a_whole_module_import() -> Bool {
  match dr_verdicts() {
    Absent => false
    Present { value: vs } => dr_accepted(v: vs.rec_user)
  }
}

// (c) A name nothing declares stays unbound.
test fn a_genuinely_undeclared_name_is_unbound() -> Bool {
  match dr_verdicts() {
    Absent => false
    Present { value: vs } => dr_refuses_with(v: vs.missing, reason: ^resolve_reason_unbound_symbol)
  }
}

// A HEALTHY NESTED PROVIDER beside a refused parent (v2.test.dr.p dag→v2) still binds.
// Prefix-join would have attributed v2.test.dr.p.child.R to p.
test fn a_healthy_nested_provider_beside_a_refused_parent_binds() -> Bool {
  match dr_verdicts() {
    Absent => false
    Present { value: vs } => dr_accepted(v: vs.nested_user)
  }
}

// AN ACTUAL DECLARING-PROVIDER REFUSAL keeps its chain (control (a) restated against the nested roster).
test fn an_actual_declaring_provider_refusal_chain_survives() -> Bool {
  match dr_verdicts() {
    Absent => false
    Present { value: vs } =>
      dr_refuses_with(v: vs.user, reason: ^resolve_reason_declarer_refused)
        && dr_chain_names_cause(v: vs.user, reason: ^resolve_cross_tree_import_denied)
  }
}

// THE TYPED DECLARER (DESIGN section 6b: born where the resolver finds the refused provider). The
// fatal diagnostic's correction names the refused declarer's module, so the census attributes by
// identity. Every other correction, including the one an unbound name carries, reads as no declarer.
fn dr_fatal_declarer(v: NativeModuleResolveVerdict) -> String {
  match dr_refused_first(v: v) {
    Absent => "none"
    Present { value: d } =>
      match diagnostics_fatal(d: d).correction {
        Suggested { node: _ } => "other"
        Unavailable { reason: r } =>
          match r {
            DeclarerRefused { declarer: q } => qualified_name_to_dotted_string(qn: q)
            UserInputBoundary => "other"
            AmbiguousIntent => "other"
            ExternalContractUnknown => "other"
            CorrectionNotModeled => "other"
          }
      }
  }
}

test fn a_declarer_refused_diagnostic_carries_the_refused_declarer_module() -> Bool {
  match dr_verdicts() {
    Absent => false
    Present { value: vs } =>
      dr_fatal_declarer(v: vs.user) == "v2.test.dr.decl"
        && dr_fatal_declarer(v: vs.ctor_user) == "v2.test.dr.decl"
  }
}

test fn an_unbound_name_carries_no_declarer() -> Bool {
  match dr_verdicts() {
    Absent => false
    Present { value: vs } => dr_fatal_declarer(v: vs.missing) == "other"
  }
}
