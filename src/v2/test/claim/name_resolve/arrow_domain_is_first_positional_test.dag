module v2.test.name_resolve.arrow_domain_is_first_positional

import v2.compiler.resolve { arrow_domain_frame_binders, arrow_domain_has_named_bindings }
import v2.std.arrow_signature { declared_signature }
import v2.compiler.symbol_index_fill { symbol_index_fill_containment_node }
import v2.std.symbol_index { empty_symbol_index, symbol_index_lookup }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.collection { map_lookup }
import v2.std.optional { Absent, Present }
import v2.std.node { Arrow, Atom, Conj, Edge, Authored, Node, Positional, Symbol, TypeNode }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.node_query { binder_edge }

// AN ARROW'S DOMAIN IS ITS FIRST POSITIONAL CHILD, NOT ITS FIRST CHILD (v2.std.node
// arrow_first_positional_target). Every producer on main happens to place the domain first, so reading
// first(children) agreed with the domain there and discriminated nothing; an Arrow whose first child is
// a Named edge made v2.compiler.resolve read that edge's target as the parameter list and
// v2.compiler.symbol_index_fill index it in the domain's place, with no diagnostic. The specimen puts an
// empty Conj behind a Named edge ahead of the domain Conj { x: Int }: reading the first child finds no
// binder and indexes nothing; reading the first positional finds `x`.
//
// The real producers' route (a lowered fn declaration, domain first) stays exercised by
// v2.test.claim.declared_parameter_order_test and v2.test.claim.normalize.service_declaration_lowering;
// this claim supplies the Arrow because no producer emits the named-first order it discriminates.

fn adf_leaf(sym: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: sym } }, children: [], occurrence_id: OccurrenceSynthetic }
}

// Deliberately hand-built shape with no producer: a named edge ahead of the domain. It carries the
// domain's declared order (A4: a domain that binds a name owes one), so the only unusual thing about it
// is the leading named edge this claim discriminates.
fn adf_named_first_arrow() -> Node {
  let signature = declared_signature(params: [binder_edge(name: ^x, type_node: adf_leaf(sym: ^Int))], source: adf_leaf(sym: ^Int))
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Authored { name: ^adf_leading_named_edge }, target: Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic } },
      signature.domain,
      Edge { label: Positional, target: adf_leaf(sym: ^Int) },
      signature.order
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

test fn arrow_domain_is_first_positional_in_resolve_holds() -> Bool {
  let arrow = adf_named_first_arrow()
  arrow_domain_has_named_bindings(n: arrow)
    && match map_lookup(m: arrow_domain_frame_binders(n: arrow).locals, key: ^x) {
      Present { value: _ } => true
      Absent => false
    }
}

test fn arrow_domain_is_first_positional_in_symbol_index_fill_holds() -> Bool {
  match symbol_index_lookup(
    index: symbol_index_fill_containment_node(
      index: empty_symbol_index(),
      path: qualified_name_from_dotted_string(dotted: "m.f"),
      node: adf_named_first_arrow()
    ),
    qualified_path: qualified_name_from_dotted_string(dotted: "m.f.x")
  ) {
    Present { value: _ } => true
    Absent => false
  }
}
