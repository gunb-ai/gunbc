test fn a_pure_renaming_alias_reaches_the_aliased_constructor() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.alias_user)
  }
}

// THE NEW REFUSAL, STATED: an authored record in an Optional position. The set is {Present, Absent};
// the record name is not in it. The flip introduces this refusal at a declared-return site, so it is a
// claim here rather than a discovery in the diff.
// THE UNREADABLE SET, AS RULED (tidy-ant-251, 2026-11-03): a kernel generic the storage lookup declines
// (`Opt<T>` is not in the repository), so no authored constructor set can be read, and the name door
// answers exactly as it did before this PR -- the site still REFUSES, it does not silently accept. The
// code does not invent a refusal it has no stated warrant for (DESIGN 5); the fail-closed cause
// resolve_reason_pattern_atom_constructor_type_unresolved fires only where the atom position already
// went through the expected-type reading and the set could not be read, which the two claims on
// atom_unresolved below pin. What is NOT closed here is a finding, not a pass: an unreadable set under a
// kernel generic argument is a rung ceiling, recorded in gunbc.recurring_failure_mode
// a_misspelled_nullary_variant_in_the_last_arm_reads_as_a_catch_all_binder.
test fn an_authored_record_under_an_optional_expectation_refuses_as_an_unbound_name() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_refuses_with(v: vs.optional_position, reason: ^resolve_reason_unbound_symbol)
  }
}

// THE COINCIDING LABEL, IMPORTED. `Node` is visible: the user imports the record type of that name from
// another module, and the expected type declares an ARM of that name. So this is NOT the unbound branch
// -- the name door answers -- and that hit is not a member of the expected type's constructor set. The
// set is the authority and does not declare the path, so the site REFUSES with the constructor-set cause
// and never keeps the name door's binding. This is the shape where today's accepted identity (the record)
// differs from the expected type's arm: the rule refuses it rather than silently retargeting it, and the
// bounded diff must report every such row.
test fn an_imported_label_that_coincides_with_an_arm_refuses_with_the_new_cause() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } =>
      ctee_refuses_with(v: vs.coinciding, reason: ^resolve_construct_tag_not_in_expected_type)
  }
}

// THE SCRUTINEE'S DECLARED TYPE IS WHAT AN ARM PATTERN IS READ AGAINST. `w.inner` has no annotation of
// its own to read: the type comes from the declared type of the field `inner` at the declared type of
// the formal `w`, and the arms' expected set is then Cell's. CellA and CellB are NOT imported, so the
// name door cannot reach them at all -- an arm's alias row lives only in the declaring module's scope --
// which makes acceptance evidence that the scrutinee's type arrived at the pattern and the arm bound
// from the expected type, not from a name.
test fn an_arm_pattern_tag_of_the_scrutinee_type_resolves() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.scrutinee_field)
  }
}

// THE SAME MATCH WITH AN ARM THE SCRUTINEE'S TYPE DOES NOT DECLARE. `Payload` is an arm of ANOTHER
// coproduct (Other) and is imported by name, so the name door answers -- with a different declaration
// than the expected type's arms; the expected set (Cell's arms) does not declare it, so the site refuses
// with the constructor-set cause instead of keeping the name door's binding. Today's verdict at such a site is
// ACCEPTED on the name door, so every occurrence of this shape is a bound-to-refused move and is
// reported per site in the bounded diff -- not a new deny invented here.
test fn an_arm_pattern_tag_the_scrutinee_type_does_not_declare_refuses_with_the_new_cause() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } =>
      ctee_refuses_with(v: vs.scrutinee_wrong, reason: ^resolve_construct_tag_not_in_expected_type)
  }
}

// A CONTROL AT THE RUNG THAT STOPS. A scrutinee typed by a type parameter has no readable constructor
// set: the parameter's declared type is the parameter itself, and a parameter is not a declaration in
// the index. The arm keeps the name door exactly as today, which for these unimported arm spellings is
// resolve_reason_unbound_symbol. No rank is invented to make the arm readable.
test fn a_scrutinee_typed_by_a_type_parameter_keeps_the_name_door() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } =>
      ctee_refuses_with(v: vs.scrutinee_param, reason: ^resolve_reason_unbound_symbol)
  }
}
// The arm shape above with the projection removed: a formal of an authored coproduct type, arm tags not
// imported. ROUND 1b MEASUREMENT EXPECTATION: accepted -- pattern_user's module already accepts a tag
// arm of the scrutinee's declared type when the scrutinee is a formal -- which would leave the
// projection step as the position where the scrutinee's declared type stops reaching the pattern.
test fn an_arm_pattern_tag_of_a_declared_formal_scrutinee_resolves() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.scrutinee_formal)
  }
}

// THE SAME LABEL, NOT IMPORTED: the spelling has no name-door answer, exactly one arm of the expected
// type carries it, so that ARM binds, recorded as bound by expected type. Beside the claim above this is
// the pair keen-heron-809 asked for: visibility of a different declaration refuses, absence of one binds
// the arm.
test fn an_unimported_label_that_matches_one_arm_binds_that_arm() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.coinciding_unimported)
  }
}


// CONTROL: the expected head is a BINDER, so there is no constructor set to read and the name door
