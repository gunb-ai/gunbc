  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.field_user)
  }
}

// THE NEW CAUSE, located: the spelling binds an arm of a DIFFERENT coproduct, and the expected type
// does not declare it. Refusing it by name alone would have accepted a tag the expected type has no
// such constructor for.
test fn an_arm_the_expected_type_does_not_declare_refuses_with_the_new_cause() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } =>
      ctee_refuses_with(v: vs.wrong_tag, reason: ^resolve_construct_tag_not_in_expected_type)
  }
}

