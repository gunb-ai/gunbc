// THE ASYMMETRY, STATED AND PINNED (rule kept by tidy-ant-251, 2026-11-03; jolly-cat-271's pattern
// precedence, gunbc.rung_claim_seam_debt bare_atom_match_arm_pattern_bind). A CONSTRUCT TAG outside the
// expected set refuses with the new cause (the claim above on wrong_tag); a pattern ATOM outside it binds
// as a catch-all, in a field position exactly as in an arm position -- case-blind, last, even though the
// readable set is in hand and lacks the spelling. Refusing it was considered and NOT adopted, and the
// compensating refusal resolve_catch_all_binder_read_gate covers only a top-level arm catch-all its body
// never reads, so a field-position binder the body reads is uncovered: the misspelling is silently
// catch-all. That residual is declared, with this module as a receipt, in
// gunbc.recurring_failure_mode a_misspelled_nullary_variant_in_the_last_arm_reads_as_a_catch_all_binder.
// This claim is the executable pin for the shipped rule, and it FLIPS if the precedence change is ruled.
test fn an_atom_outside_the_expected_set_binds_as_a_catch_all_binder() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.atom_misspelled)
  }
}

test fn an_atom_naming_a_visible_nullary_constructor_under_an_unreadable_expectation_refuses() -> Bool {
  match ctee_verdicts() { Absent => false Present { value: vs } =>
    ctee_refuses_with(v: vs.atom_unresolved, reason: ^resolve_reason_pattern_atom_constructor_type_unresolved) }
}

// The atom sits in a FIELD pattern under a field type the expectation cannot read (the generic argument
// `T` is a binder, and a binder head answers Absent), so the reading falls through to a binder. A
// top-level arm binder that the body never reads would refuse on resolve's own unread catch-all gate
// (resolve_catch_all_binder_read_gate) before this rule could be seen, so the fixture reads its position.
test fn an_atom_naming_no_constructor_under_an_unreadable_expectation_binds_as_today() -> Bool {
  match ctee_verdicts() { Absent => false Present { value: vs } => ctee_accepted(v: vs.atom_unresolved_binder) }
}

