module v2.test.claim.name_resolve.construct_tag_expected_type

import v2.compiler.source_root_eval {
  native_test_context_from_ingest,
  native_lane_file_refusal_index,
  native_module_resolve_verdict,
  NativeTestContext,
  NativeModuleResolveVerdict,
  NativeModuleResolveAccepted,
  NativeModuleResolveRefused
}
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol }
import std.types { Bool }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import extdeps.communication.medium { Lossless, Medium }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// AN AUTHORED CONSTRUCT TAG IS READ FROM THE EXPECTED TYPE'S DECLARED CONSTRUCTOR SET (ruling on
// docs/plans/native-construct-tag-expected-type-arm.md, tidy-ant-251, 2026-11-02; the producer is
// v2.compiler.resolve resolve_construct_tag_under_expected_constructor_set, fed by
// resolve_expected_authored_construct_edge in value position and resolve_pattern_field_edge in
// pattern position). These claims run the native prepare/resolve route, so each reports the FATAL
// reason of one module: a shape that refuses for a different reason than its claim states turns that
// claim red rather than passing over the wrong cause.
//
// WHY THE FIXTURES LOOK LIKE THIS. An arm of a coproduct gets a module-level alias row ONLY when its
// name is unique among that module's coproducts, and that row lives in the DECLARING module's scope
// (v2.compiler.symbol_index_fill symbol_index_fill_containment_node, disj_variant_count_of). So in an
// importer the bare spelling of an arm has nothing to hit, while the expected type the site already
// names DOES name the arm -- which is the A2 census class in
// docs/plans/t4-a2a4-unbound-name-attribution.md (Value, None, Equal, Accepted; 417 dag modules and
// their v2 counterparts import a type and never spell its arms). Each pair below therefore declares
// the type in one module and uses it in another that imports only the type.

data ctee_types_source: String = "module v2.test.ctee.types\n\ntype Behavior = Value | Call { name: Int }\ntype Box = Boxed { behavior: Behavior }\ntype Tree = Node { child: Int } | Leaf\ntype Wrapper { inner: Cell }\ntype Cell = CellA { a: Int } | CellB { b: Int }\ntype Holder<T> { held: T }\ntype Opt<T> = None | Some { value: T }\n"

// A record whose NAME coincides with an arm of Tree above. The spelling has two declarations, one of
// them a record type in a different module: the expected type's set holds the ARM, and the name door
// can reach the record instead.
data ctee_node_record_source: String = "module v2.test.ctee.node_record\n\ntype Node { child: Int }\n"

data ctee_other_source: String = "module v2.test.ctee.other\n\ntype Other = Payload { flag: Int } | Call { flag: Int }\n"

// A CONSTRUCTOR IN RETURN POSITION, spelled bare, with the expected type imported and the arm not.
// Before the arm of this change: resolve_reason_unbound_symbol. After: accepted, bound by expected
// type (v2.compiler.resolve ExpectedTypeConstructorRoute).
data ctee_return_source: String = "module v2.test.ctee.return_user\n\nimport v2.test.ctee.types { Behavior }\nfn f() -> Behavior { Call { name: 1 } }\n"

// THE NESTED PATTERN ARM: the tag sits under a pattern field, and the field's declared type is what
// the constructor must be read from. Before: resolve_reason_unbound_symbol at `Value`.
data ctee_pattern_source: String = "module v2.test.ctee.pattern_user\n\nimport v2.test.ctee.types { Box }\nfn f(x: Box) -> Int {\n  match x {\n    Boxed { behavior: Call { name: n } } => n\n    Boxed { behavior: Call { name: p } } => p\n  }\n}\n"

// THE RECORD-FIELD ARM: a value under a record field whose authored field type is the expected type.
// This is the position rule that already existed (resolve_record_field_edge); what is new is that the
// construct under it is gated by the field type's constructor set rather than by its spelling.
data ctee_field_source: String = "module v2.test.ctee.field_user\n\nimport v2.test.ctee.types { Box, Behavior }\nfn f() -> Box { Boxed { behavior: Call { name: 1 } } }\n"

// THE MISMATCH: the spelling binds a declaration -- an arm of a DIFFERENT coproduct -- and the expected
// type does not declare it. That is the case the ruling named, and it refuses with the new cause
// without consulting any other door.
data ctee_wrong_tag_source: String = "module v2.test.ctee.wrong_tag\n\nimport v2.test.ctee.types { Behavior }\nimport v2.test.ctee.other { Payload }\nfn f() -> Behavior { Payload { flag: 1 } }\n"

// GENUINE AMBIGUITY IS PRESERVED, not resolved by the expected type: two imported arms spelled alike
// stay many, and the door refuses as ambiguous rather than picking the arm that happens to match.
data ctee_ambiguous_source: String = "module v2.test.ctee.ambiguous\n\nimport v2.test.ctee.types { Behavior, Call }\nimport v2.test.ctee.other { Call }\nfn f() -> Behavior { Call { name: 1 } }\n"

// THE SET THAT CANNOT BE READ: the expected type is a kernel integer, which has no constructor set.
// The name door answers exactly as it did before, so this stays unbound and is NOT relabelled.
data ctee_no_set_source: String = "module v2.test.ctee.no_set\n\nfn f(x: Int) -> Int { Value }\n"

// THE CONTROL THAT MUST NOT MOVE: an importer that already imports the arm binds it today, and keeps
// the same declaring identity after the change -- the bounded-diff rule says nothing goes from bound
// to bound with a different identity.
data ctee_imported_arm_source: String = "module v2.test.ctee.imported_arm\n\nimport v2.test.ctee.types { Behavior, Value }\nfn f() -> Behavior { Value }\n"

// THE QUALIFIED TAG KEEPS ITS DOTTED DOOR: it already names its owner, and the set governs the bare
// spelling. Verdict unchanged by this change.
data ctee_qualified_source: String = "module v2.test.ctee.qualified\n\nimport v2.test.ctee.types { Behavior }\nfn f() -> Behavior { v2.test.ctee.types.Behavior.Value }\n"

// AN ALIAS AS THE DECLARED TYPE: the pure renaming (type BoxAlias = Box) is followed to Box's
// constructor, exactly as resolve_expected_rename_chain follows List to FreeMonoid.
data ctee_alias_source: String = "module v2.test.ctee.alias_user\n\nimport v2.test.ctee.types { Box }\ntype BoxAlias = Box\ndata first: BoxAlias = Boxed { behavior: Call { name: 1 } }\n"

// A NEW REFUSAL THE FLIP STATES RATHER THAN DISCOVERS: an authored record standing where the expected
// type is an optional-shaped coproduct, Opt<Box>. The expectation declares None and Some; the record's
// own tag (Boxed) is not among them, so the site that bound the record by name now refuses with the
// constructor-set cause. Under explicit_present_is_the_authoring_policy that is the intended reading, but
// it is a refusal at a declared-return site and is named here so the diff measures it. The fixture
// declares its own optional-shaped coproduct (as v2.test.claim.match_binder.kind_aware_binding does)
// rather than importing std.optional: at 897d2a1c the version that imported it refused with a cause that
// was NONE of the three constructor-set causes (its three elimination probes -- unbound, ambiguous,
// new-cause -- were all red), so the ingested-fixture route to a std.* module is not settled here and is
// kept out of this claim.
data ctee_optional_position_source: String = "module v2.test.ctee.optional_position\n\nimport v2.test.ctee.types { Box, Opt }\nfn pack() -> Opt<Box> { Boxed { behavior: Call { name: 1 } } }\n"

// THE SCRUTINEE'S DECLARED TYPE, carried into the arm patterns. Three shapes, one per rung:
// `w.inner` where w is a formal of the enclosing declaration (the field's declared type read at
// Wrapper's declaration, then Cell's arm set); the same scrutinee with an arm the set does NOT declare,
// which is a bound-to-refused move and is claimed as such; and a scrutinee typed by a type parameter,
// where no constructor set is readable and the arm keeps the name door.
data ctee_scrutinee_field_source: String = "module v2.test.ctee.scrutinee_field\n\nimport v2.test.ctee.types { Cell, Wrapper }\nfn read(w: Wrapper) -> Int {\n  match w.inner {\n    CellA { a: n } => n\n    CellB { b: m } => m\n  }\n}\n"
data ctee_scrutinee_wrong_source: String = "module v2.test.ctee.scrutinee_wrong\n\nimport v2.test.ctee.types { Cell, Wrapper }\nimport v2.test.ctee.other { Payload }\nfn read(w: Wrapper) -> Int {\n  match w.inner {\n    Payload { flag: b } => b\n  }\n}\n"
data ctee_scrutinee_param_source: String = "module v2.test.ctee.scrutinee_param\n\nimport v2.test.ctee.types { Cell }\nfn read<T>(v: T) -> Int {\n  match v {\n    CellA { a: n } => n\n    CellB { b: m } => m\n  }\n}\n"

// THE DIFFERENTIAL FOR THE ARMS-PATTERN CLAIMS: the shape of scrutinee_field with the PROJECTION STEP
// REMOVED -- the scrutinee is the formal itself, of an authored coproduct type, and the arm tags are not
// imported. Read with scrutinee_field's elimination arms this says WHERE the expected type stops
// reaching a pattern: formal accepted and field unbound leaves the projection's declared type as what is
// lost; formal unbound too means an arm pattern never takes a scrutinee type at all.
data ctee_scrutinee_formal_source: String = "module v2.test.ctee.scrutinee_formal\n\nimport v2.test.ctee.types { Cell }\nfn read(c: Cell) -> Int {\n  match c {\n    CellA { a: n } => n\n    CellB { b: m } => m\n  }\n}\n"

data ctee_coinciding_source: String = "module v2.test.ctee.coinciding\n\nimport v2.test.ctee.types { Tree }\nimport v2.test.ctee.node_record { Node }\nfn make() -> Tree { Node { child: 1 } }\n"

// The pair's other half: nothing named Node is visible, so the expected type's own arm answers.
data ctee_coinciding_unimported_source: String = "module v2.test.ctee.coinciding_unimported\n\nimport v2.test.ctee.types { Tree }\nfn make() -> Tree { Node { child: 1 } }\n"

// THE TYPE PARAMETER CONTROL: the expected head has binders, so there is no constructor set and the
// name door answers exactly as it does today.
// A binder carries no constructor set, so the expected type cannot answer and the name door does, with
// today's answer: an unimported arm spelling stays unbound. This claim is what says the arm does not
// fire where the ruling does not let it.
// An unimported NULLARY arm spelled bare, under an expectation whose type does declare it.
data ctee_nullary_source: String = "module v2.test.ctee.nullary\n\nimport v2.test.ctee.types { Tree }\nfn make() -> Tree { Leaf }\n"

data ctee_type_param_source: String = "module v2.test.ctee.type_param\n\nimport v2.test.ctee.types { Tree }\nfn pass_through<T>(v: T) -> T { Leaf }\n"

// THE PAYLOAD-ABSENT PATTERN ATOM, five shapes of one rule (the joint rule with jolly-cat-271: the
// visible-value gate first, then the constructor reading by the expected type's declared arm set, then
// the binder). `atom_field` is the corpus's dominant shape: a NULLARY arm spelled bare inside a field
// pattern, reached through the scrutinee's declared type and the arm's payload field, with the arm
// spelling NOT imported. `atom_binder` keeps a fresh lowercase binder a binder. `atom_misspelled` is the
// misspelling guard jolly-cat-271 asked to be pinned: an atom outside the set is still a binder, and the
// unread-binder gate is what refuses it. `atom_unresolved` is the fail-closed half: no readable expected
// type AND a nullary constructor visible in scope -- read as a binder it would silently swallow every
// scrutinee value, so it refuses. `atom_unresolved_binder` is its pair: the same unreadable expectation
// with a spelling that names no constructor, which binds exactly as today.
data ctee_atom_field_source: String = "module v2.test.ctee.atom_field\n\nimport v2.test.ctee.types { Box }\nfn rank(b: Box) -> Int {\n  match b {\n    Boxed { behavior: Value } => 0\n    Boxed { behavior: Call { name: n } } => n\n  }\n}\n"
data ctee_atom_binder_source: String = "module v2.test.ctee.atom_binder\n\nimport v2.test.ctee.types { Box }\nfn rank(b: Box) -> Int {\n  match b {\n    Boxed { behavior: picked } => picked\n  }\n}\n"
data ctee_atom_misspelled_source: String = "module v2.test.ctee.atom_misspelled\n\nimport v2.test.ctee.types { Box }\nfn rank(b: Box) -> Int {\n  match b {\n    Boxed { behavior: Absnet } => 0\n  }\n}\n"
data ctee_atom_unresolved_source: String = "module v2.test.ctee.atom_unresolved\n\nimport v2.test.ctee.types { Leaf, Tree }\nfn pick<T>(t: T) -> Int {\n  match t {\n    Leaf => 0\n  }\n}\n"
data ctee_atom_unresolved_binder_source: String = "module v2.test.ctee.atom_unresolved_binder\n\nimport v2.test.ctee.types { Holder }\nfn pick<T>(h: Holder<T>) -> T {\n  match h {\n    Holder { held: picked } => picked\n  }\n}\n"

fn ctee_read(text: String, id: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: text, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: id,
    source_root: DagTree
  }
}

fn ctee_context() -> Outcome<NativeTestContext> {
  native_test_context_from_ingest(ingest: [
    ctee_read(text: ctee_types_source, id: ^ctee_types, path: "src/v2/test/fixture/ctee/types.dag"),
    ctee_read(text: ctee_other_source, id: ^ctee_other, path: "src/v2/test/fixture/ctee/other.dag"),
    ctee_read(text: ctee_return_source, id: ^ctee_return_user, path: "src/v2/test/fixture/ctee/return_user.dag"),
    ctee_read(text: ctee_pattern_source, id: ^ctee_pattern_user, path: "src/v2/test/fixture/ctee/pattern_user.dag"),
    ctee_read(text: ctee_field_source, id: ^ctee_field_user, path: "src/v2/test/fixture/ctee/field_user.dag"),
    ctee_read(text: ctee_wrong_tag_source, id: ^ctee_wrong_tag, path: "src/v2/test/fixture/ctee/wrong_tag.dag"),
    ctee_read(text: ctee_ambiguous_source, id: ^ctee_ambiguous, path: "src/v2/test/fixture/ctee/ambiguous.dag"),
    ctee_read(text: ctee_no_set_source, id: ^ctee_no_set, path: "src/v2/test/fixture/ctee/no_set.dag"),
    ctee_read(text: ctee_imported_arm_source, id: ^ctee_imported_arm, path: "src/v2/test/fixture/ctee/imported_arm.dag"),
    ctee_read(text: ctee_qualified_source, id: ^ctee_qualified, path: "src/v2/test/fixture/ctee/qualified.dag"),
    ctee_read(text: ctee_node_record_source, id: ^ctee_node_record, path: "src/v2/test/fixture/ctee/node_record.dag"),
    ctee_read(text: ctee_alias_source, id: ^ctee_alias_user, path: "src/v2/test/fixture/ctee/alias_user.dag"),
    ctee_read(text: ctee_optional_position_source, id: ^ctee_optional_position, path: "src/v2/test/fixture/ctee/optional_position.dag"),
    ctee_read(text: ctee_coinciding_source, id: ^ctee_coinciding, path: "src/v2/test/fixture/ctee/coinciding.dag"),
    ctee_read(text: ctee_scrutinee_field_source, id: ^ctee_scrutinee_field, path: "src/v2/test/fixture/ctee/scrutinee_field.dag"),
    ctee_read(text: ctee_scrutinee_wrong_source, id: ^ctee_scrutinee_wrong, path: "src/v2/test/fixture/ctee/scrutinee_wrong.dag"),
    ctee_read(text: ctee_scrutinee_param_source, id: ^ctee_scrutinee_param, path: "src/v2/test/fixture/ctee/scrutinee_param.dag"),
    ctee_read(text: ctee_scrutinee_formal_source, id: ^ctee_scrutinee_formal, path: "src/v2/test/fixture/ctee/scrutinee_formal.dag"),
    ctee_read(text: ctee_coinciding_unimported_source, id: ^ctee_coinciding_unimported, path: "src/v2/test/fixture/ctee/coinciding_unimported.dag"),
    ctee_read(text: ctee_type_param_source, id: ^ctee_type_param, path: "src/v2/test/fixture/ctee/type_param.dag"),
    ctee_read(text: ctee_nullary_source, id: ^ctee_nullary, path: "src/v2/test/fixture/ctee/nullary.dag"),
    ctee_read(text: ctee_atom_field_source, id: ^ctee_atom_field, path: "src/v2/test/fixture/ctee/atom_field.dag"),
    ctee_read(text: ctee_atom_binder_source, id: ^ctee_atom_binder, path: "src/v2/test/fixture/ctee/atom_binder.dag"),
    ctee_read(text: ctee_atom_misspelled_source, id: ^ctee_atom_misspelled, path: "src/v2/test/fixture/ctee/atom_misspelled.dag"),
    ctee_read(text: ctee_atom_unresolved_source, id: ^ctee_atom_unresolved, path: "src/v2/test/fixture/ctee/atom_unresolved.dag"),
    ctee_read(text: ctee_atom_unresolved_binder_source, id: ^ctee_atom_unresolved_binder, path: "src/v2/test/fixture/ctee/atom_unresolved_binder.dag")
  ])
}

type CteeVerdicts {
  declared_types: NativeModuleResolveVerdict
  return_user: NativeModuleResolveVerdict
  pattern_user: NativeModuleResolveVerdict
  field_user: NativeModuleResolveVerdict
  wrong_tag: NativeModuleResolveVerdict
  ambiguous: NativeModuleResolveVerdict
  no_set: NativeModuleResolveVerdict
  imported_arm: NativeModuleResolveVerdict
  qualified: NativeModuleResolveVerdict
  alias_user: NativeModuleResolveVerdict
  optional_position: NativeModuleResolveVerdict
  coinciding: NativeModuleResolveVerdict
  scrutinee_field: NativeModuleResolveVerdict
  scrutinee_wrong: NativeModuleResolveVerdict
  scrutinee_param: NativeModuleResolveVerdict
  scrutinee_formal: NativeModuleResolveVerdict
  coinciding_unimported: NativeModuleResolveVerdict
  type_param: NativeModuleResolveVerdict
  nullary: NativeModuleResolveVerdict
  atom_field: NativeModuleResolveVerdict
  atom_binder: NativeModuleResolveVerdict
  atom_misspelled: NativeModuleResolveVerdict
  atom_unresolved: NativeModuleResolveVerdict
  atom_unresolved_binder: NativeModuleResolveVerdict
}

fn ctee_verdicts() -> Optional<CteeVerdicts> {
  match ctee_context() {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: context, diagnostics: _ } =>
      {
        let index = native_lane_file_refusal_index(refusals: context.file_refusals)
        let declared_types = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.types", path: ^ctee_types)
        let return_user = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.return_user", path: ^ctee_return_user)
        let pattern_user = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.pattern_user", path: ^ctee_pattern_user)
        let field_user = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.field_user", path: ^ctee_field_user)
        let wrong_tag = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.wrong_tag", path: ^ctee_wrong_tag)
        let ambiguous = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.ambiguous", path: ^ctee_ambiguous)
        let no_set = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.no_set", path: ^ctee_no_set)
        let imported_arm = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.imported_arm", path: ^ctee_imported_arm)
        let qualified = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.qualified", path: ^ctee_qualified)
        let alias_user = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.alias_user", path: ^ctee_alias_user)
        let optional_position = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.optional_position", path: ^ctee_optional_position)
        let coinciding = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.coinciding", path: ^ctee_coinciding)
        let scrutinee_field = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.scrutinee_field", path: ^ctee_scrutinee_field)
        let scrutinee_wrong = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.scrutinee_wrong", path: ^ctee_scrutinee_wrong)
        let scrutinee_param = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.scrutinee_param", path: ^ctee_scrutinee_param)
        let scrutinee_formal = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.scrutinee_formal", path: ^ctee_scrutinee_formal)
        let coinciding_unimported = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.coinciding_unimported", path: ^ctee_coinciding_unimported)
        let type_param = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.type_param", path: ^ctee_type_param)
        let nullary = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.nullary", path: ^ctee_nullary)
        let atom_field = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.atom_field", path: ^ctee_atom_field)
        let atom_binder = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.atom_binder", path: ^ctee_atom_binder)
        let atom_misspelled = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.atom_misspelled", path: ^ctee_atom_misspelled)
        let atom_unresolved = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.atom_unresolved", path: ^ctee_atom_unresolved)
        let atom_unresolved_binder = native_module_resolve_verdict(context: context, refusal_index: index, module: "v2.test.ctee.atom_unresolved_binder", path: ^ctee_atom_unresolved_binder)
        optional_present(value: CteeVerdicts {
          declared_types: declared_types.verdict,
          return_user: return_user.verdict,
          pattern_user: pattern_user.verdict,
          field_user: field_user.verdict,
          wrong_tag: wrong_tag.verdict,
          ambiguous: ambiguous.verdict,
          no_set: no_set.verdict,
          imported_arm: imported_arm.verdict,
          qualified: qualified.verdict,
          alias_user: alias_user.verdict,
          optional_position: optional_position.verdict,
          coinciding: coinciding.verdict,
          scrutinee_field: scrutinee_field.verdict,
          scrutinee_wrong: scrutinee_wrong.verdict,
          scrutinee_param: scrutinee_param.verdict,
          scrutinee_formal: scrutinee_formal.verdict,
          coinciding_unimported: coinciding_unimported.verdict,
          type_param: type_param.verdict,
          nullary: nullary.verdict,
          atom_field: atom_field.verdict,
          atom_binder: atom_binder.verdict,
          atom_misspelled: atom_misspelled.verdict,
          atom_unresolved: atom_unresolved.verdict,
          atom_unresolved_binder: atom_unresolved_binder.verdict
        })
      }
  }
}

fn ctee_accepted(v: NativeModuleResolveVerdict) -> Bool {
  match v {
    NativeModuleResolveAccepted { resolved: _ } => true
    _ => false
  }
}

fn ctee_fatal(v: NativeModuleResolveVerdict) -> Optional<Symbol> {
  match v {
    NativeModuleResolveRefused { first: d, rest: _, observation: _ } =>
      optional_present(value: diagnostics_fatal_reason(d: d))
    _ => optional_absent()
  }
}

fn ctee_refuses_with(v: NativeModuleResolveVerdict, reason: Symbol) -> Bool {
  match ctee_fatal(v: v) {
    Present { value: r } => r == reason
    Absent => false
  }
}

// The fixture pair itself resolves; a red here means the fixture drifted, not that the door moved.
test fn the_declaring_module_resolves() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.declared_types)
  }
}

// RED BEFORE, GREEN AFTER: a bare arm spelling in return position, under an imported expected type.
test fn an_arm_of_the_expected_type_resolves_in_return_position() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.return_user)
  }
}

// RED BEFORE, GREEN AFTER: the same spelling nested in a pattern, read from the pattern field's
// declared type. The pattern field rule used to drop the resolved tag path, which is why this site had
// no expected type to be read against.
test fn an_arm_of_the_expected_type_resolves_in_a_nested_pattern() -> Bool {
  match ctee_verdicts() {
    Absent => false
    Present { value: vs } => ctee_accepted(v: vs.pattern_user)
  }
}

// RED BEFORE, GREEN AFTER: the same spelling under a record field whose authored field type names the
