module v2.test.manual.solve_constraints_add


fn fixture_add_constraint_graph() -> v2.std.constraints.ConstraintGraph {
  v2.std.constraints.ConstraintGraph { root: fixture_add_resolved_tree() }
}

fn anchor_solve_constraints_add() -> v2.std.diagnostic.Outcome<v2.std.constraints.CanonicalGrounding> {
  solve_constraints(
    policy: v2.std.constraints.ConstraintSolvePolicy {
      graph: fixture_add_constraint_graph()
    }
  )
}

data witness_solve_constraints_add_accepts: Bool = match anchor_solve_constraints_add() {
  Accepted { value: g, diagnostics: d } =>
    (g.node == fixture_add_resolved_tree())
      && (g.witness.structural.property == ^preservation_rule_constraint_satisfaction)
      && (g.witness.structural.evidence == fixture_add_resolved_tree())
      && (g.witness.closedness.property == ^constraint_property_candidate_set_closedness)
      && (d == v2.std.diagnostic.None)
  v2.std.diagnostic.Rejected { diagnostics: _ } => false
}
fn solve_constraints_witness_fail_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^solve_constraints_witness_fail_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn solve_constraints_claim_input(ok: Bool) -> Node {
  if ok {
    fixture_add_resolved_node()
  } else {
    solve_constraints_witness_fail_node()
  }
}

data claim_solve_constraints_add_compiles: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/solve_constraints_add: constraint path module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fixture_add_resolved_node(),
  expected_value: fixture_add_resolved_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_solve_constraints_add_accepts: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/solve_constraints_add: solve_constraints Accepted on add graph root",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: solve_constraints_claim_input(ok: witness_solve_constraints_add_accepts),
  expected_value: fixture_add_resolved_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
