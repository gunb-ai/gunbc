module v2.test.claim.manual.solve_constraints_add

import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.constraints {
  CanonicalGrounding,
  ConstraintGraph,
  ConstraintSolvePolicy,
  solve_constraints
}
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v2.std.node { node_same_occurrence, Atom, Node, Symbol, TypeNode }
import v2.test.claim.manual.infer_ground_add {
  fixture_add_resolved_node,
  fixture_add_resolved_tree
}
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn fixture_add_constraint_graph() -> ConstraintGraph {
  ConstraintGraph { root: fixture_add_resolved_tree().root }
}

fn anchor_solve_constraints_add() -> Outcome<CanonicalGrounding> {
  solve_constraints(
    policy: ConstraintSolvePolicy {
      graph: fixture_add_constraint_graph()
    }
  )
}

data witness_solve_constraints_add_accepts: Bool = match anchor_solve_constraints_add() {
  Accepted { value: g, diagnostics: d } =>
    node_same_occurrence(a: g.node, b: fixture_add_resolved_tree().root)
      && (g.witness.structural.property == ^preservation_rule_constraint_satisfaction)
      && (node_same_occurrence(a: g.witness.structural.evidence, b: fixture_add_resolved_tree().root))
      && (g.witness.closedness.property == ^constraint_property_candidate_set_closedness)
      && (d == None)
  Rejected { diagnostics: _ } => false
}
fn solve_constraints_witness_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^solve_constraints_witness_fail_atom } },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}
fn solve_constraints_claim_input(ok: Bool) -> Node {
  if ok {
    fixture_add_resolved_node()
  } else {
    solve_constraints_witness_fail_node()
  }
}

data claim_solve_constraints_add_compiles: TestClaim = CompilesClaim {
  label: "manual/solve_constraints_add: constraint path module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fixture_add_resolved_node(),
  expected_value: fixture_add_resolved_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_solve_constraints_add_accepts: TestClaim = CompilesClaim {
  label: "manual/solve_constraints_add: solve_constraints Accepted on add graph root",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: solve_constraints_claim_input(ok: witness_solve_constraints_add_accepts),
  expected_value: fixture_add_resolved_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
