module v2.test.manual.ambiguity_count_probe

import v2.compiler.parse {
  grammar_choice_ambiguity_count,
  grammar_choice_ambiguity_roster
}
import v2.extdeps.languages.dag { dag_wave1_grammar_root }
import v2.std.algebra { length }
import v2.std.collection { list_at_optional, Present, Absent }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

fn roster_prod_at(index: Int) -> Symbol {
  match list_at_optional(xs: grammar_choice_ambiguity_roster(root: dag_wave1_grammar_root()), index: index) {
    Present { value: row } => row.production
    Absent => ^roster_index_absent
  }
}

fn roster_both_nullable_at(index: Int) -> Bool {
  match list_at_optional(xs: grammar_choice_ambiguity_roster(root: dag_wave1_grammar_root()), index: index) {
    Present { value: row } => row.both_nullable
    Absent => false
  }
}

fn roster_overlap_len_at(index: Int) -> Int {
  match list_at_optional(xs: grammar_choice_ambiguity_roster(root: dag_wave1_grammar_root()), index: index) {
    Present { value: row } => length(xs: row.overlap_terminals)
    Absent => -1
  }
}

fn roster_prod_eq(index: Int, prod: Symbol) -> Bool {
  roster_prod_at(index: index) == prod
}

test fn probe_count_eq_5() -> Bool {
  grammar_choice_ambiguity_count(root: dag_wave1_grammar_root()) == 5
}

test fn probe_row0_prod_expr() -> Bool {
  roster_prod_eq(index: 0, prod: ^dag_production_expr)
}

test fn probe_row1_prod_expr() -> Bool {
  roster_prod_eq(index: 1, prod: ^dag_production_expr)
}

test fn probe_row2_prod_expr() -> Bool {
  roster_prod_eq(index: 2, prod: ^dag_production_expr)
