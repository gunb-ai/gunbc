test fn probe_row0_overlap_len_1() -> Bool {
  roster_overlap_len_at(index: 0) == 1
}

test fn probe_row0_overlap_len_gt_0() -> Bool {
  roster_overlap_len_at(index: 0) > 0
}

test fn probe_row0_both_nullable() -> Bool {
  roster_both_nullable_at(index: 0)
}

test fn probe_row1_both_nullable() -> Bool {
  roster_both_nullable_at(index: 1)
}

