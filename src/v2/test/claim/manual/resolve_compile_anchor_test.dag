module v2.test.manual.resolve_compile_anchor

fn service_atom_conj_tree() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
          },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn anchor_resolve_service_atom_via_canonical_symbols() -> v2.std.diagnostic.Outcome<v2.compiler.resolve.ResolvedTree> {
  v2.compiler.resolve.resolve(
    tree: service_atom_conj_tree(),
    lm: v2.extdeps.languages.dag.dag_language_model_void()
  )
}

fn anchor_resolve_empty_prelude_service_atom() -> v2.std.diagnostic.Outcome<v2.compiler.resolve.ResolvedTree> {
  v2.compiler.resolve.resolve(
    tree: service_atom_conj_tree(),
    lm: v2.extdeps.languages.dag.dag_language_model_surface_empty_prelude()
  )
}

fn anchor_resolve_multi_edge_conj_via_canonical_symbols() -> v2.std.diagnostic.Outcome<v2.compiler.resolve.ResolvedTree> {
  match v2.compiler.normalized_tree.admit_normalized_tree(
    root: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
      children: [
        v2.std.node.Edge {
          label: v2.std.node.Named { name: ^anchor_decl_first },
          target: v2.std.node.Node {
            kind: v2.std.node.TypeNode {
              connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
            },
            children: [],
            occurrence_id: v2.std.node.SyntheticOccurrence
          }
        },
        v2.std.node.Edge {
          label: v2.std.node.Named { name: ^anchor_decl_second },
          target: v2.std.node.Node {
            kind: v2.std.node.TypeNode {
              connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_type }
            },
            children: [],
            occurrence_id: v2.std.node.SyntheticOccurrence
          }
        }
      ],
      occurrence_id: v2.std.node.SyntheticOccurrence
},
    diagnostics: v2.std.diagnostic.None
  ) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: t, diagnostics: _ } => v2.compiler.resolve.resolve(tree: t, lm: v2.extdeps.languages.dag.dag_language_model_void())
  }
}

fn anchor_resolve_bind_binder_use() -> v2.std.diagnostic.Outcome<v2.compiler.resolve.ResolvedTree> {
  match v2.compiler.normalized_tree.admit_normalized_tree(
    root: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
      children: [
        v2.std.node.Edge {
          label: v2.std.node.Named { name: ^anchor_decl_first },
          target: v2.std.node.Node {
            kind: v2.std.node.ComputationNode { behavior: v2.std.node.Bind },
            children: [
              v2.std.node.Edge {
                label: v2.std.node.Positional,
                target: v2.std.node.Node {
                  kind: v2.std.node.TypeNode {
                    connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_fn }
                  },
                  children: [],
                  occurrence_id: v2.std.node.SyntheticOccurrence
                }
              },
              v2.std.node.Edge {
                label: v2.std.node.Positional,
                target: v2.std.node.Node {
                  kind: v2.std.node.TypeNode {
                    connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
                  },
                  children: [],
                  occurrence_id: v2.std.node.SyntheticOccurrence
                }
              },
              v2.std.node.Edge {
                label: v2.std.node.Positional,
                target: v2.std.node.Node {
                  kind: v2.std.node.TypeNode {
                    connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_fn }
                  },
                  children: [],
                  occurrence_id: v2.std.node.SyntheticOccurrence
                }
              }
            ],
            occurrence_id: v2.std.node.SyntheticOccurrence
          }
        }
      ],
      occurrence_id: v2.std.node.SyntheticOccurrence
},
    diagnostics: v2.std.diagnostic.None
  ) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: t, diagnostics: _ } => v2.compiler.resolve.resolve(tree: t, lm: v2.extdeps.languages.dag.dag_language_model_void())
  }
}

fn resolve_imported_qn_node() -> v2.std.node.Node {
  v2.std.algebra.fold_list_node(
    xs: std.algebra.Cons { head: ^anchor_imported_path_segment, tail: std.algebra.Empty },
    item_node: fn(sym) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
        children: [],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
    }
  )
}

fn resolve_imported_module_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.extdeps.languages.dag.dag_named_edge(
        name: ^dag_surface_module_header,
        target: v2.extdeps.languages.dag.dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      v2.extdeps.languages.dag.dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: resolve_imported_qn_node()
      ),
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^anchor_imported_decl },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
          },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn resolve_subject_qn_node() -> v2.std.node.Node {
  v2.std.algebra.fold_list_node(
    xs: std.algebra.Cons { head: ^anchor_subject_path_segment, tail: std.algebra.Empty },
    item_node: fn(sym) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
        children: [],
        occurrence_id: v2.std.node.SyntheticOccurrence
}
    }
  )
}

fn resolve_subject_module_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.extdeps.languages.dag.dag_named_edge(
        name: ^dag_surface_module_header,
        target: v2.extdeps.languages.dag.dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      v2.extdeps.languages.dag.dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: resolve_subject_qn_node()
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn resolve_subject_module_root_with_import_use() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.extdeps.languages.dag.dag_named_edge(
        name: ^dag_surface_module_header,
        target: v2.extdeps.languages.dag.dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      v2.extdeps.languages.dag.dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: resolve_subject_qn_node()
      ),
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^anchor_subject_import_use },
        target: resolve_imported_use_tree()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn resolve_subject_name() -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons { head: ^anchor_subject_path_segment, tail: std.algebra.Empty }
}

fn resolve_roots_single_import() -> v2.std.diagnostic.Outcome<std.algebra.FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  v2.compiler.normalized_tree.admit_normalized_roots(
    roots: std.algebra.Cons {
    head: resolve_subject_module_root_with_import_use(),
    tail: std.algebra.Cons {
      head: resolve_imported_module_root(),
      tail: std.algebra.Empty
    }
  },
    diagnostics: v2.std.diagnostic.None
  )
}

fn resolve_imported_use_tree() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^anchor_imported_decl } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn resolve_import_target() -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons { head: ^anchor_imported_path_segment, tail: std.algebra.Empty }
}

test fn resolve_with_admission_imported_binding_accepts() -> v2.std.logic.Bool {
  match resolve_roots_single_import() {
    Rejected { diagnostics: _ } => false
    Accepted { value: admitted, diagnostics: _ } =>
    match v2.compiler.name_resolve.resolve_with_admission_policy(
      lm: v2.extdeps.languages.dag.dag_language_model_surface_empty_prelude(),
      roots: admitted,
      admission: v2.compiler.name_resolve.Admission {
        subject: v2.compiler.name_resolve.ResolutionSubject {
          name: resolve_subject_name()
        },
        imports: std.algebra.Cons {
          head: v2.compiler.name_resolve.Import {
            target: resolve_import_target(),
            visibility: v2.compiler.name_resolve.ImportVisible
          },
          tail: std.algebra.Empty
        }
      },
      index: v2.std.cross_tree.resolution.source_root_index_empty(),
      active_roots: std.algebra.Empty,
      policy: v2.std.resolution_policy.ImportScoped
    ) {
      Accepted { value: _, diagnostics: _ } => true
      Rejected { diagnostics: _ } => false
    }
  }
}
