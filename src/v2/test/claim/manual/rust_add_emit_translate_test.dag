module v2.test.manual.rust_add_emit_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data rust_add_forbidden_authority_source_text: String = "authority_source_text_fallback_forbidden"


data rust_add_emitted_root: Node = rust_fixture_emitted_add_fn

data rust_add_target_model: v2.std.compilers.target_model.TargetModel = rust_target_model()

data rust_add_poisoned_authority_target_model: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: rust_target_model_node(),
  lex: rust_fn_add_lex(),
  binding_spellings: rust_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: rust_add_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data rust_add_empty_translation_rules_bundle: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data rust_add_missing_translation_rules_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: rust_add_empty_translation_rules_bundle,
  lex: rust_fn_add_lex(),
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_rust_add_serialize_rejects_missing_translation_rules() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  target_serialize_source_from_model(
    target: rust_add_missing_translation_rules_target,
    emitted: rust_add_emitted_root
  )
}

data rust_add_serialize_reject_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_rust_add_serialize_rejects_missing_translation_rules()

test fn rust_add_serialize_reject_receipt_holds() -> Bool {
  match rust_add_serialize_reject_receipt {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d != v2.std.diagnostic.None
  }
}


fn rust_add_i32_facts_node() -> Node {
  rust_integer_facts_node(facts: rust_facts_i32)
}

fn rust_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn rust_add_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == rust_fixture_emitted_add_fn {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_fixture_i32_inhabitant {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_add_i32_facts_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_inhabitant_i32) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_fixture_i32_inhabitant
      )
    }
  } else if node == rust_add_i32_facts_node() {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_surface_spelling_i32) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_add_i32_facts_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_std_projection_int32) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_add_i32_facts_node()
      )
    }
  } else if node == rust_int_kind_node(kind: v2.extdeps.languages.rust.Signed) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_add_i32_facts_node()
      )
    }
  } else if node == rust_int_width_node(width: v2.extdeps.languages.rust.Bits32) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_add_i32_facts_node()
      )
    }
  } else if node == rust_i32_overflow_disposition_node() {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_i32_scalar_node() {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_scalar_int) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_signed) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_bits32) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_overflow_node(overflow: v2.extdeps.languages.rust.PanicOnOverflow) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_overflow_node(overflow: v2.extdeps.languages.rust.TwoComplementWrap) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_panic_on_overflow) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_overflow_node(overflow: v2.extdeps.languages.rust.PanicOnOverflow)
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_two_complement_wrap) {
    v2.std.witness.Holds {
      value: rust_add_canonical_grounding(
        node: node,
        algebra: rust_overflow_node(overflow: v2.extdeps.languages.rust.TwoComplementWrap)
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^rust_add_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn rust_add_inferred_facts_for(node: Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  match rust_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn rust_add_facts_lookup(key: Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  rust_add_inferred_facts_for(node: key)
}

data rust_add_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: rust_add_emitted_root,
  facts: std.types.Map {
    lookup: rust_add_facts_lookup
  }
}

fn anchor_rust_add_emit_accepts() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  emit(tree: rust_add_inferred_tree, target: rust_add_target_model)
}

fn anchor_rust_add_compile_inferred_accepts() -> v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> {
  compile_inferred(
    inferred: rust_add_inferred_tree,
    mode: v2.compiler.compile.TranslateTo { target: rust_add_poisoned_authority_target_model }
  )
}

data rust_add_emit_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_rust_add_emit_accepts()

test fn rust_add_emit_add_fn_accepts_holds() -> Bool {
  match rust_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == rust_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

data rust_add_compile_inferred_receipt: v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> = anchor_rust_add_compile_inferred_accepts()

test fn rust_add_compile_inferred_receipt_holds() -> Bool {
  match rust_add_compile_inferred_receipt {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}








