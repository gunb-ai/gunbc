module v2.test.manual.typescript_add_emit_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data typescript_add_forbidden_authority_source_text: String = "authority_source_text_fallback_forbidden"
data typescript_add_number_inhabitant: Node = ts_inhabitant_number_node()

data typescript_add_emitted_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Arrow },
  children: [
    v2.std.node.Edge { label: Positional, target: typescript_add_number_inhabitant },
    v2.std.node.Edge { label: Positional, target: typescript_add_number_inhabitant },
    v2.std.node.Edge { label: Positional, target: typescript_add_number_inhabitant }
  ],
  occurrence_id: SyntheticOccurrence
}

data typescript_add_number_facts_node: Node = ts_number_facts_node(facts: ts_facts_number)

data typescript_add_arithmetic_semantics_node: Node = ts_number_arithmetic_semantics_node()

data typescript_add_bitwise_semantics_node: Node = ts_number_bitwise_semantics_node()

data typescript_add_target_model: v2.std.compilers.target_model.TargetModel = ts_target_model()

data typescript_add_poisoned_authority_target_model: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: ts_target_model_node(),
  lex: ts_fn_add_lex(),
  binding_spellings: ts_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: typescript_add_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data typescript_add_empty_translation_rules_bundle: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data typescript_add_missing_translation_rules_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: typescript_add_empty_translation_rules_bundle,
  lex: ts_fn_add_lex(),
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_typescript_add_serialize_rejects_missing_translation_rules() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: typescript_add_missing_translation_rules_target,
    emitted: typescript_add_emitted_root
  )
}

data typescript_add_serialize_reject_receipt: Outcome<Medium<String>> = anchor_typescript_add_serialize_rejects_missing_translation_rules()

test fn typescript_add_serialize_reject_receipt_holds() -> Bool {
  match typescript_add_serialize_reject_receipt {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d != v2.std.diagnostic.None
  }
}


fn typescript_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn typescript_add_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == typescript_add_emitted_root {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == typescript_add_number_inhabitant {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_inhabitant_number) {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_number_inhabitant
      )
    }
  } else if node == typescript_add_number_facts_node {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_surface_spelling_number) {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_number_facts_node
      )
    }
  } else if node == typescript_add_arithmetic_semantics_node {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_number_ieee754_binary64) {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_arithmetic_semantics_node
      )
    }
  } else if node == typescript_add_bitwise_semantics_node {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_number_bitwise_int32_uint32) {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_bitwise_semantics_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_bits64) {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_ieee754_binary64) {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^std_projection_additive_numeric) {
    v2.std.witness.Holds {
      value: typescript_add_canonical_grounding(
        node: node,
        algebra: typescript_add_number_facts_node
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^typescript_add_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn typescript_add_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match typescript_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn typescript_add_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  typescript_add_inferred_facts_for(node: key)
}

data typescript_add_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: typescript_add_emitted_root,
  facts: std.types.Map {
    lookup: typescript_add_facts_lookup
  }
}

fn anchor_typescript_add_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: typescript_add_inferred_tree, target: typescript_add_target_model)
}

fn anchor_typescript_add_compile_inferred_accepts() -> Outcome<v2.compiler.compile.CompileOutput> {
  compile_inferred(
    inferred: typescript_add_inferred_tree,
    mode: v2.compiler.compile.TranslateTo { target: typescript_add_poisoned_authority_target_model }
  )
}

data typescript_add_emit_receipt: Outcome<Medium<String>> = anchor_typescript_add_emit_accepts()

test fn typescript_add_emit_add_fn_accepts_holds() -> Bool {
  match typescript_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == ts_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

data typescript_add_compile_inferred_receipt: Outcome<v2.compiler.compile.CompileOutput> = anchor_typescript_add_compile_inferred_accepts()

test fn typescript_add_compile_inferred_receipt_holds() -> Bool {
  match typescript_add_compile_inferred_receipt {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}





