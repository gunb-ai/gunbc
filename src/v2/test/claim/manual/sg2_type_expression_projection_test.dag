module v2.test.manual.sg2_type_expression_projection

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly
data sg2_fail_text: String = ""
data sg2_expected_type_text: String = "Rc<FooBar<X, Y>>"
data sg2_expected_arrow_text: String = "(X) -> Y"
data sg2_expected_conj_text: String = " { X: X, Y: Y }"

fn sg2_fail_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^sg2_fail_sym } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

data sg2_type_expr_target: v2.std.compilers.target_model.TargetModel = v2.extdeps.languages.rust.rust_sg2_type_expr_projection_probe_target_model()

fn sg2_project_instantiation_emitted() -> v2.std.node.Node {
  match v2.compiler.translate.translate_type_expression_project(
    node: v2.extdeps.languages.rust.rust_sg2_instantiation_source_type_node(),
    target: sg2_type_expr_target,
    projection: v2.extdeps.languages.rust.rust_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => sg2_fail_node()
  }
}

test fn sg2_projection_matches_golden() -> Bool {
  v2.std.node.content_hash(n: sg2_project_instantiation_emitted()) ==
    v2.std.node.content_hash(n: v2.extdeps.languages.rust.rust_sg2_rc_foobar_xy_emitted())
}

fn sg2_project_arrow_emitted() -> v2.std.node.Node {
  match v2.compiler.translate.translate_type_expression_project(
    node: v2.extdeps.languages.rust.rust_sg2_arrow_source_type_node(),
    target: sg2_type_expr_target,
    projection: v2.extdeps.languages.rust.rust_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => sg2_fail_node()
  }
}

fn sg2_project_conj_emitted() -> v2.std.node.Node {
  match v2.compiler.translate.translate_type_expression_project(
    node: v2.extdeps.languages.rust.rust_sg2_conj_source_type_node(),
    target: sg2_type_expr_target,
    projection: v2.extdeps.languages.rust.rust_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => sg2_fail_node()
  }
}

test fn sg2_binary_fn_projection_accepts() -> Bool {
  match v2.compiler.translate.translate_type_expression_project(
    node: v2.extdeps.languages.rust.rust_sg2_binary_fn_source_type_node(),
    target: sg2_type_expr_target,
    projection: v2.extdeps.languages.rust.rust_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn sg2_arrow_malformed_projection_rejects() -> Bool {
  match v2.compiler.translate.translate_type_expression_project(
    node: v2.extdeps.languages.rust.rust_sg2_arrow_malformed_source_type_node(),
    target: sg2_type_expr_target,
    projection: v2.extdeps.languages.rust.rust_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn sg2_serialize_accepts(emitted: v2.std.node.Node) -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: sg2_type_expr_target,
    emitted: emitted
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn sg2_serialized_text(emitted: v2.std.node.Node) -> String {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: sg2_type_expr_target,
    emitted: emitted
  ) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => sg2_fail_text
  }
}

test fn sg2_serialize_matches_expected() -> Bool {
  sg2_serialized_text(emitted: v2.extdeps.languages.rust.rust_sg2_rc_foobar_xy_emitted()) == sg2_expected_type_text
}

test fn sg2_arrow_serialize_matches_expected() -> Bool {
  sg2_serialized_text(emitted: v2.extdeps.languages.rust.rust_sg2_arrow_xy_emitted()) == sg2_expected_arrow_text
}

fn sg2_arrow_projected_serialized_text() -> String {
  sg2_serialized_text(emitted: sg2_project_arrow_emitted())
}

test fn sg2_arrow_projected_serialize_matches_expected() -> Bool {
  sg2_arrow_projected_serialized_text() == sg2_expected_arrow_text
}

test fn sg2_conj_projected_serialize_matches_expected() -> Bool {
  sg2_serialized_text(emitted: sg2_project_conj_emitted()) == sg2_expected_conj_text
}

test fn sg2_instantiation_projected_serialize_matches_expected() -> Bool {
  sg2_serialized_text(emitted: sg2_project_instantiation_emitted()) == sg2_expected_type_text
}

fn sg2_arrow_swapped_split_emitted() -> v2.std.node.Node {
  let row = v2.extdeps.languages.rust.rust_type_expression_projection()
  v2.std.compilers.target_model.target_type_expr_arrow_emitted(
    form: row.arrow_form,
    inputs: std.algebra.Cons {
      head: v2.std.compilers.target_model.target_type_expr_atom_emitted(
        form: row.atom_form,
        identity: ^rust_binding_sg2_y
      ),
      tail: std.algebra.Empty
    },
    output: v2.std.compilers.target_model.target_type_expr_atom_emitted(
      form: row.atom_form,
      identity: ^rust_binding_sg2_x
    )
  )
}

test fn sg2_arrow_swapped_split_serialize_mismatches_expected() -> Bool {
  sg2_serialized_text(emitted: sg2_arrow_swapped_split_emitted()) != sg2_expected_arrow_text
}

test fn sg2_arrow_projected_serialize_accepts() -> Bool {
  sg2_serialize_accepts(emitted: sg2_project_arrow_emitted())
}

test fn sg2_conj_serialize_matches_expected() -> Bool {
  sg2_serialized_text(emitted: v2.extdeps.languages.rust.rust_sg2_conj_xy_emitted()) == sg2_expected_conj_text
}

fn sg2_wire_decode_accepts(emitted: v2.std.node.Node) -> Bool {
  match v2.std.compilers.target_model.target_type_expr_emitted_wire_decode(
    node: emitted,
    projection: v2.extdeps.languages.rust.rust_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn sg2_rust_add_projection_absent() -> Bool {
  match v2.compiler.translate.target_bundle_child_optional_type_expr_projection(target: v2.extdeps.languages.rust.rust_target_model()) {
    Accepted { value: v2.compiler.translate.ProjectionAbsent, diagnostics: _ } => true
    _ => false
  }
}

test fn sg2_rust_add_translate_fallback_accepts() -> Bool {
  match v2.compiler.translate.translate(tree: v2.test.manual.rust_add_emit_translate.rust_add_inferred_tree, target: v2.test.manual.rust_add_emit_translate.rust_add_target_model) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn sg2_instantiation_delimiters_bidirectional() -> Bool {
  let row = v2.extdeps.languages.rust.rust_type_expression_projection()
  row.instantiation_form.open == ^rust_token_lt &&
    row.instantiation_form.separator == ^rust_token_comma &&
    row.instantiation_form.close == ^rust_token_gt
}

test fn witness_sg2_arrow_holds() -> Bool {
  (v2.std.node.content_hash(n: sg2_project_arrow_emitted()) == v2.std.node.content_hash(n: v2.extdeps.languages.rust.rust_sg2_arrow_xy_emitted()))
    && sg2_arrow_serialize_matches_expected()
    && sg2_arrow_projected_serialize_matches_expected()
    && sg2_conj_projected_serialize_matches_expected()
    && sg2_instantiation_projected_serialize_matches_expected()
    && sg2_binary_fn_projection_accepts()
    && sg2_arrow_malformed_projection_rejects()
    && sg2_arrow_swapped_split_serialize_mismatches_expected()
}

test fn witness_sg2_projection_falsification_holds() -> Bool {
  !sg2_serialize_accepts(emitted: sg2_fail_node())
    && !sg2_wire_decode_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_atom_zero_positional_emitted())
    && !sg2_wire_decode_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_arrow_one_positional_emitted())
    && !sg2_serialize_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_atom_missing_surface_emitted())
    && !sg2_serialize_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_atom_extra_positional_emitted())
}

fn sg2_wrong_arrow_projection() -> v2.std.compilers.target_model.TargetTypeExpressionProjection {
  let row = v2.extdeps.languages.rust.rust_type_expression_projection()
  v2.std.compilers.target_model.TargetTypeExpressionProjection {
    atom_form: row.atom_form,
    conj_form: row.conj_form,
    disj_form: row.disj_form,
    arrow_form: v2.std.compilers.target_model.TargetFunctionTypeShape {
      surface: row.arrow_form.surface,
      open: row.arrow_form.open,
      close: row.arrow_form.close,
      arrow: ^sg2_wrong_arrow_token,
      param_ident_token: row.arrow_form.param_ident_token,
      param_type_separator: row.arrow_form.param_type_separator,
      param_list_separator: row.arrow_form.param_list_separator
    },
    cardinality_form: row.cardinality_form,
    instantiation_form: row.instantiation_form
  }
}

test fn witness_sg2_fold_row_delimiter_discriminates_holds() -> Bool {
  match v2.std.compilers.target_model.type_expr_projection_bundle_shape_for_connective(
    bundle: v2.extdeps.languages.rust.rust_type_expression_projection_bundle_node(),
    connective: v2.std.node.Arrow
  ) {
    Accepted { value: good_shape, diagnostics: _ } =>
      match v2.std.compilers.target_model.type_expr_projection_row_shape_witness_gate(
        source_facts: good_shape,
        projection: sg2_wrong_arrow_projection(),
        connective: v2.std.node.Arrow
      ) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn sg2_conj_projection_matches_golden() -> Bool {
  v2.std.node.content_hash(n: sg2_project_conj_emitted()) == v2.std.node.content_hash(n: v2.extdeps.languages.rust.rust_sg2_conj_xy_emitted())
}

test fn sg2_serialize_rejects_record_extra_positional() -> Bool {
  !sg2_serialize_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_record_extra_positional_emitted())
}

test fn sg2_serialize_rejects_sum_extra_positional() -> Bool {
  !sg2_serialize_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_sum_extra_positional_emitted())
}

test fn sg2_serialize_rejects_atom_duplicate_surface() -> Bool {
  !sg2_serialize_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_atom_duplicate_surface_emitted())
}

test fn sg2_serialize_rejects_atom_wrong_surface() -> Bool {
  !sg2_serialize_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_atom_wrong_surface_emitted())
}

test fn sg2_serialize_rejects_atom_extra_named() -> Bool {
  !sg2_serialize_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_atom_extra_named_emitted())
}

test fn sg2_wire_decode_rejects_instantiation_zero_positional() -> Bool {
  !sg2_wire_decode_accepts(emitted: v2.extdeps.languages.rust.rust_sg2_malformed_instantiation_zero_positional_emitted())
}
