module v2.test.manual.typescript_wave1_grammar_claim

import v2.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
}
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.typescript {
  ts_source_text,
  ts_wave1_grammar_root,
  ts_wave1_lex
}
import v2.std.compilers.lexing { token_stream_remaining }
import v2.std.diagnostic { Accepted, Outcome, Rejected, port_locus }
import v2.std.grammar { ParseTree }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.logic { Bool }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn typescript_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^typescript_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^typescript_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn typescript_wave1_grammar_validates_fixture() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: ts_wave1_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn typescript_wave1_grammar_parse_accepted() -> Bool {
  match typescript_wave1_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn typescript_wave1_grammar_parse_fixture() -> Outcome<ParseTree> {
  let at = port_locus(port: ^parse_stage_locus_port)
  match tokenize(
    text: ts_source_text,
    file: ^typescript_wave1_parse_fixture_file,
    rules: ts_wave1_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar_validate_for_parse(root: ts_wave1_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          parse_production_tree(
            tokens: token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^ts_production_fn_add
          )
      }
  }
}

data claim_typescript_wave1_grammar_validates: TestClaim = EqualsClaim {
  label: "ts_wave1_grammar_root passes grammar_validate_for_parse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: typescript_claim_bool_atom(b: typescript_wave1_grammar_validates_fixture()),
  rhs: typescript_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_typescript_wave1_grammar_parses_tokens: TestClaim = EqualsClaim {
  label: "typescript MVP-1 production parse_production accepts lexer output for typed-add source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: typescript_claim_bool_atom(b: typescript_wave1_grammar_parse_accepted()),
  rhs: typescript_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
