module test.claim.manual.dsv41_6b_probe

import std.types { Bool, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import test.claim.apt_package_of_witness {
  apt_package_of_resolves_the_declared_package,
  a_tool_with_no_apt_source_resolves_to_absent,
  the_resolved_package_is_not_the_binary_name,
}
import test.claim.runner_password_session_tool_converge_witness {
  the_plan_reads_the_package_off_the_enrolled_tool,
  a_tool_with_no_apt_source_is_unacquirable_not_guessed,
  an_unprobeable_transport_refuses_rather_than_installing,
  an_unacquirable_tool_refuses_before_reaching_a_host,
  an_unmodeled_host_is_refused_as_a_subject,
  a_rostered_runner_is_admitted_with_the_administrator_principal,
  the_receipt_distinguishes_unobserved_from_absent,
}

func probe_6b_rows() -> ProcessExit {
  if apt_package_of_resolves_the_declared_package()
    && a_tool_with_no_apt_source_resolves_to_absent()
    && the_resolved_package_is_not_the_binary_name()
    && the_plan_reads_the_package_off_the_enrolled_tool()
    && a_tool_with_no_apt_source_is_unacquirable_not_guessed()
    && an_unprobeable_transport_refuses_rather_than_installing()
    && an_unacquirable_tool_refuses_before_reaching_a_host()
    && an_unmodeled_host_is_refused_as_a_subject()
    && a_rostered_runner_is_admitted_with_the_administrator_principal()
    && the_receipt_distinguishes_unobserved_from_absent() {
    ExitSuccess
  } else {
    exit_failure(reason: "DSV41-6b hermetic rows RED")
  }
}
