    Rejected { diagnostics } => diagnostics.head.reason == ^exact_one_int_out_of_range
  }
}

fn refinement_authoritative_claim_input(ok: Bool) -> Node {
  if ok {
    stub_empty_conj
  } else {
    stub_empty_disj
  }
}

data claim_positive_int_authoritative_literal_two_accepts: TestClaim = EqualsClaim {
  label: "manual/refinement: positive_int_authoritative_literal(value: 2) matches make_positive_int_at_authoritative",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: refinement_authoritative_claim_input(ok: witness_positive_int_authoritative_literal_two_accepts()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_positive_int_authoritative_zero_rejects: TestClaim = EqualsClaim {
  label: "manual/refinement: authoritative make_positive_int rejects 0",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: refinement_authoritative_claim_input(ok: witness_positive_int_authoritative_zero_rejects()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

