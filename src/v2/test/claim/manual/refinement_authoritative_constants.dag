module v2.test.manual.refinement_authoritative_constants


fn witness_positive_int_authoritative_literal_two_accepts() -> Bool {
  match make_positive_int_at_authoritative(value: 2) {
    Accepted { value: accepted, diagnostics: _ } =>
      match positive_int_authoritative_literal(value: 2) {
        Accepted { value: literal, diagnostics: _ } =>
          positive_int_value(p: literal) == positive_int_value(p: accepted)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn witness_positive_int_authoritative_zero_rejects() -> Bool {
  match make_positive_int_at_authoritative(value: 0) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics } => diagnostics.head.reason == ^positive_int_out_of_range
  }
}

fn witness_non_negative_int_authoritative_minus_one_rejects() -> Bool {
  match make_non_negative_int_at_authoritative(value: -1) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics } => diagnostics.head.reason == ^non_negative_int_out_of_range
  }
}

