module v2.test.manual.typescript_grammar_claim


test fn typescript_grammar_validates_fixture() -> Bool {
  let at = v2.std.diagnostic.port_locus(port: ^parse_stage_locus_port)
  match v2.compiler.parse.grammar_validate_for_parse(root: v2.extdeps.languages.typescript.ts_fn_add_grammar_root(), at: at) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn typescript_grammar_parse_accepted() -> Bool {
  match typescript_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn typescript_grammar_parse_fixture() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let at = v2.std.diagnostic.port_locus(port: ^parse_stage_locus_port)
  match v2.compiler.tokenize.tokenize(
    text: v2.extdeps.languages.typescript.ts_source_text,
    file: ^typescript_parse_fixture_file,
    rules: v2.extdeps.languages.typescript.ts_fn_add_lex()
  ) {
    v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    v2.std.diagnostic.Accepted { value: stream, diagnostics: _ } =>
      match v2.compiler.parse.grammar_validate_for_parse(root: v2.extdeps.languages.typescript.ts_fn_add_grammar_root(), at: at) {
        v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
        v2.std.diagnostic.Accepted { value: validated, diagnostics: _ } =>
          v2.compiler.parse.parse_production_tree(
            tokens: v2.std.compilers.lexing.token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^ts_production_fn_add
          )
      }
  }
}
