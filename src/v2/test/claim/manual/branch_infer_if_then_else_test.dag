module v2.test.manual.branch_infer_if_then_else


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn branch_infer_arm_mismatch_body() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_pick_if_body_from_arms(
    condition: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_token_kw_true),
    then_arm: v2.extdeps.languages.dag.dag_int_literal_fixture_one(),
    else_arm: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_token_ident)
  )
}

test fn branch_infer_bool_cond_accepts_holds() -> Bool {
  match v2.compiler.infer.infer(tree: v2.extdeps.languages.dag.dag_pick_if_body_fixture) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

data branch_infer_underived_arm_ruling_note: String = "The else arm is the bare dag_token_ident token-class atom, not a literal with a modeled type. After the self-grounding wall it cannot participate in an arm-type comparison: inference must refuse infer_grounding_not_derived before claiming a mismatch. The discriminating mismatch RED remains covered by branch_infer_test using two genuinely derived operand types."

test fn branch_infer_underived_arm_refuses_before_mismatch_holds() -> Bool {
  match v2.compiler.infer.infer(tree: branch_infer_arm_mismatch_body()) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: d } => d.head.reason == ^infer_grounding_not_derived
  }
}
