module v2.test.manual.branch_infer_if_then_else


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn branch_infer_arm_mismatch_body() -> v2.std.node.Node {
  dag_pick_if_body_from_arms(
    condition: dag_type_atom_node(identity: ^dag_token_kw_true),
    then_arm: dag_int_literal_fixture_one(),
    else_arm: dag_type_atom_node(identity: ^dag_token_ident)
  )
}

test fn branch_infer_bool_cond_accepts_holds() -> v2.std.logic.Bool {
  match infer(tree: dag_pick_if_body_fixture) {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}

data branch_infer_underived_arm_ruling_note: String = "The else arm is the bare dag_token_ident token-class atom, not a literal with a modeled type. After the self-grounding wall it cannot participate in an arm-type comparison: inference must refuse infer_grounding_not_derived before claiming a mismatch. The discriminating mismatch RED remains covered by branch_infer_test using two genuinely derived operand types."

test fn branch_infer_underived_arm_refuses_before_mismatch_holds() -> v2.std.logic.Bool {
  match infer(tree: branch_infer_arm_mismatch_body()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^infer_grounding_not_derived
  }
}
