module v2.test.manual.branch_infer_if_then_else

import v2.compiler.infer {
  infer,
}
import v2.extdeps.languages.dag {
  dag_int_literal_fixture_one,
  dag_pick_if_body_fixture,
  dag_pick_if_body_from_arms,
  dag_type_atom_node
}
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn branch_infer_arm_mismatch_body() -> Node {
  dag_pick_if_body_from_arms(
    condition: dag_type_atom_node(identity: ^dag_token_kw_true),
    then_arm: dag_int_literal_fixture_one(),
    else_arm: dag_type_atom_node(identity: ^dag_token_ident)
  )
}

test fn branch_infer_bool_cond_accepts_holds() -> Bool {
  match infer(tree: dag_pick_if_body_fixture) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_infer_arm_mismatch_red_holds() -> Bool {
  match infer(tree: branch_infer_arm_mismatch_body()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^infer_branch_arm_type_mismatch
  }
}

