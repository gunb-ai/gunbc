module v2.test.manual.find_witness_identity


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
fn identity_source_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^identity_source_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn identity_other_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^identity_other_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn identity_closedness() -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^identity_closed_candidates,
    evidence: identity_source_node()
  }
}
fn exact_identity_predicate() -> v2.std.find_witness.PreservationPredicate {
  v2.std.find_witness.PreservationPredicate {
    algebra: identity_source_node(),
    preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
  }
}
fn constraint_predicate() -> v2.std.find_witness.PreservationPredicate {
  v2.std.find_witness.PreservationPredicate {
    algebra: identity_source_node(),
    preservation_rule: ^preservation_rule_constraint_satisfaction
  }
}
fn unknown_rule_predicate() -> v2.std.find_witness.PreservationPredicate {
  v2.std.find_witness.PreservationPredicate {
    algebra: identity_source_node(),
    preservation_rule: ^identity_wrong_property
  }
}
fn candidate_set_identity_single() -> v2.std.find_witness.CandidateSet {
  v2.std.find_witness.CandidateSet {
    candidates: [identity_source_node()],
    closedness: identity_closedness()
  }
}
fn candidate_set_non_identity_single() -> v2.std.find_witness.CandidateSet {
  v2.std.find_witness.CandidateSet {
    candidates: [identity_other_node()],
    closedness: identity_closedness()
  }
}
fn candidate_set_identity_duplicate() -> v2.std.find_witness.CandidateSet {
  v2.std.find_witness.CandidateSet {
    candidates: [identity_source_node(), identity_source_node()],
    closedness: identity_closedness()
  }
}
fn valid_identity_witness() -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^preservation_rule_exact_structural_equality_zip_fold,
    evidence: identity_source_node()
  }
}
fn mismatched_property_witness() -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^identity_wrong_property,
    evidence: identity_source_node()
  }
}
fn mismatched_evidence_witness() -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^preservation_rule_exact_structural_equality_zip_fold,
    evidence: identity_other_node()
  }
}
fn rejected_for_no_candidate(o: v2.std.diagnostic.Outcome<v2.std.find_witness.FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == ^find_witness_reason_no_candidate
  }
}
fn rejected_for_ambiguous_candidate(o: v2.std.diagnostic.Outcome<v2.std.find_witness.FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == ^find_witness_reason_ambiguous_candidate
  }
}
fn rejected_for_not_realized(o: v2.std.diagnostic.Outcome<v2.std.find_witness.FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == ^find_witness_reason_not_realized
  }
}
fn quality_is_identity(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    Identity => true
    Exact => false
    Widened => false
  }
}
test data witness_find_witness_identity_accepts: Bool = match find_witness(
  source_facts: identity_source_node(),
  candidates: candidate_set_identity_single(),
  predicate: exact_identity_predicate(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == identity_source_node()
  Rejected { diagnostics: _ } => false
}
test data witness_find_witness_non_identity_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_non_identity_single(),
    predicate: exact_identity_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_constraint_rule_accepts: Bool = match find_witness(
  source_facts: identity_source_node(),
  candidates: candidate_set_identity_single(),
  predicate: constraint_predicate(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == identity_source_node()
  Rejected { diagnostics: _ } => false
}
test data witness_find_witness_other_rule_rejects: Bool = rejected_for_not_realized(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_identity_single(),
    predicate: unknown_rule_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_unique_only_ambiguous_rejects: Bool = rejected_for_ambiguous_candidate(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_identity_duplicate(),
    predicate: exact_identity_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_selected_invalid_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_identity_duplicate(),
    predicate: exact_identity_predicate(),
    multiplicity_policy: v2.std.find_witness.TargetSelection {
      policy: v2.std.find_witness.TargetDeclaredPriority { priority: identity_other_node() }
    }
  )
)
test data witness_find_witness_user_selected_invalid_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_identity_duplicate(),
    predicate: exact_identity_predicate(),
    multiplicity_policy: v2.std.find_witness.TargetSelection {
      policy: v2.std.find_witness.UserSelected { selection: identity_other_node() }
    }
  )
)
test data witness_verify_witness_accepts: Bool = match verify_witness(
  source_facts: identity_source_node(),
  candidate: identity_source_node(),
  predicate: exact_identity_predicate(),
  witness: valid_identity_witness()
) {
  Accepted { value: _, diagnostics: _ } => true
  Rejected { diagnostics: _ } => false
}
test data witness_verify_witness_property_mismatch_rejects: Bool = match verify_witness(
  source_facts: identity_source_node(),
  candidate: identity_source_node(),
  predicate: exact_identity_predicate(),
  witness: mismatched_property_witness()
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: _ } => true
}
test data witness_verify_witness_evidence_mismatch_rejects: Bool = match verify_witness(
  source_facts: identity_source_node(),
  candidate: identity_source_node(),
  predicate: exact_identity_predicate(),
  witness: mismatched_evidence_witness()
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: _ } => true
}
fn identity_grounding() -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: identity_source_node(),
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: valid_identity_witness(),
      closedness: identity_closedness()
    }
  }
}
fn coercion_identity_candidates() -> v2.std.coercion.CoercionCandidateSet {
  v2.std.coercion.CoercionCandidateSet { set: candidate_set_identity_single() }
}
test data witness_coercion_fold_identity_accepts: Bool = match coercion_fold(
  source: identity_grounding(),
  candidates: coercion_identity_candidates(),
  policy: v2.std.find_witness.TargetDeclaredPriority { priority: identity_source_node() }
) {
  Accepted { value: r, diagnostics: _ } =>
    (r.target == identity_source_node()) && quality_is_identity(q: r.quality)
  Rejected { diagnostics: _ } => false
}
