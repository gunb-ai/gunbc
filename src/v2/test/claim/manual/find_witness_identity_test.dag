module v2.test.manual.find_witness_identity


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
fn identity_source_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^identity_source_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn identity_other_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^identity_other_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn identity_closedness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: ^identity_closed_candidates,
    evidence: identity_source_node()
  }
}
fn exact_identity_predicate() -> PreservationPredicate {
  PreservationPredicate {
    algebra: identity_source_node(),
    preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
  }
}
fn constraint_predicate() -> PreservationPredicate {
  PreservationPredicate {
    algebra: identity_source_node(),
    preservation_rule: ^preservation_rule_constraint_satisfaction
  }
}
fn unknown_rule_predicate() -> PreservationPredicate {
  PreservationPredicate {
    algebra: identity_source_node(),
    preservation_rule: ^identity_wrong_property
  }
}
fn candidate_set_identity_single() -> CandidateSet {
  CandidateSet {
    candidates: [identity_source_node()],
    closedness: identity_closedness()
  }
}
fn candidate_set_non_identity_single() -> CandidateSet {
  CandidateSet {
    candidates: [identity_other_node()],
    closedness: identity_closedness()
  }
}
fn candidate_set_identity_duplicate() -> CandidateSet {
  CandidateSet {
    candidates: [identity_source_node(), identity_source_node()],
    closedness: identity_closedness()
  }
}
fn valid_identity_witness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: ^preservation_rule_exact_structural_equality_zip_fold,
    evidence: identity_source_node()
  }
}
fn mismatched_property_witness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: ^identity_wrong_property,
    evidence: identity_source_node()
  }
}
fn mismatched_evidence_witness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: ^preservation_rule_exact_structural_equality_zip_fold,
    evidence: identity_other_node()
  }
}
fn rejected_for_no_candidate(o: Outcome<FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == ^find_witness_reason_no_candidate
  }
}
fn rejected_for_ambiguous_candidate(o: Outcome<FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == ^find_witness_reason_ambiguous_candidate
  }
}
fn rejected_for_not_realized(o: Outcome<FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == ^find_witness_reason_not_realized
  }
}
fn quality_is_identity(q: CoercionQuality) -> Bool {
  match q {
    Identity => true
    Exact => false
    Widened => false
  }
}
test data witness_find_witness_identity_accepts: Bool = match find_witness(
  source_facts: identity_source_node(),
  candidates: candidate_set_identity_single(),
  predicate: exact_identity_predicate(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == identity_source_node()
  Rejected { diagnostics: _ } => false
}
test data witness_find_witness_non_identity_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_non_identity_single(),
    predicate: exact_identity_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_constraint_rule_accepts: Bool = match find_witness(
  source_facts: identity_source_node(),
  candidates: candidate_set_identity_single(),
  predicate: constraint_predicate(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == identity_source_node()
  Rejected { diagnostics: _ } => false
}
test data witness_find_witness_other_rule_rejects: Bool = rejected_for_not_realized(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_identity_single(),
    predicate: unknown_rule_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_unique_only_ambiguous_rejects: Bool = rejected_for_ambiguous_candidate(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_identity_duplicate(),
    predicate: exact_identity_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_selected_invalid_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_identity_duplicate(),
    predicate: exact_identity_predicate(),
    multiplicity_policy: TargetSelection {
      policy: TargetDeclaredPriority { priority: identity_other_node() }
    }
  )
)
test data witness_find_witness_user_selected_invalid_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: identity_source_node(),
    candidates: candidate_set_identity_duplicate(),
    predicate: exact_identity_predicate(),
    multiplicity_policy: TargetSelection {
      policy: UserSelected { selection: identity_other_node() }
    }
  )
)
test data witness_verify_witness_accepts: Bool = match verify_witness(
  source_facts: identity_source_node(),
  candidate: identity_source_node(),
  predicate: exact_identity_predicate(),
  witness: valid_identity_witness()
) {
  Accepted { value: _, diagnostics: _ } => true
  Rejected { diagnostics: _ } => false
}
test data witness_verify_witness_property_mismatch_rejects: Bool = match verify_witness(
  source_facts: identity_source_node(),
  candidate: identity_source_node(),
  predicate: exact_identity_predicate(),
  witness: mismatched_property_witness()
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: _ } => true
}
test data witness_verify_witness_evidence_mismatch_rejects: Bool = match verify_witness(
  source_facts: identity_source_node(),
  candidate: identity_source_node(),
  predicate: exact_identity_predicate(),
  witness: mismatched_evidence_witness()
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: _ } => true
}
fn identity_grounding() -> CanonicalGrounding {
  CanonicalGrounding {
    node: identity_source_node(),
    witness: CanonicalGroundingWitness {
      structural: valid_identity_witness(),
      closedness: identity_closedness()
    }
  }
}
fn coercion_identity_candidates() -> CoercionCandidateSet {
  CoercionCandidateSet { set: candidate_set_identity_single() }
}
test data witness_coercion_fold_identity_accepts: Bool = match coercion_fold(
  source: identity_grounding(),
  candidates: coercion_identity_candidates(),
  policy: TargetDeclaredPriority { priority: identity_source_node() }
) {
  Accepted { value: r, diagnostics: _ } =>
    (r.target == identity_source_node()) && quality_is_identity(q: r.quality)
  Rejected { diagnostics: _ } => false
}
fn identity_witness_claim_input(ok: Bool) -> Node {
  if ok {
    identity_source_node()
  } else {
    identity_other_node()
  }
}
fn identity_witness_expected() -> Node {
  identity_source_node()
}
data claim_find_witness_identity_module_compiles: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: identity behavior anchors compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_source_node(),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_identity_accepts: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: identity candidate accepts",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_find_witness_identity_accepts),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_non_identity_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: non-identity candidate rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_find_witness_non_identity_rejects),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
data claim_find_witness_constraint_rule_accepts: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: constraint_satisfaction accepts identity candidate",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_find_witness_constraint_rule_accepts),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_other_rule_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: unrealized preservation rule rejects before enumeration",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_find_witness_other_rule_rejects),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_unique_only_ambiguous_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: UniqueOnly ambiguity rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_find_witness_unique_only_ambiguous_rejects),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_selected_invalid_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: invalid declared priority rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_find_witness_selected_invalid_rejects),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_user_selected_invalid_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: invalid user selection rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_find_witness_user_selected_invalid_rejects),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_verify_witness_accepts: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: verify_witness accepts matching witness",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_verify_witness_accepts),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_verify_witness_property_mismatch_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: verify_witness rejects property mismatch",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_verify_witness_property_mismatch_rejects),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_verify_witness_evidence_mismatch_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: verify_witness rejects evidence mismatch",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_verify_witness_evidence_mismatch_rejects),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_coercion_fold_identity_accepts: TestClaim = CompilesClaim {
  label: "manual/find_witness_identity: coercion_fold identity accepts",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: identity_witness_claim_input(ok: witness_coercion_fold_identity_accepts),
  expected_value: identity_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
