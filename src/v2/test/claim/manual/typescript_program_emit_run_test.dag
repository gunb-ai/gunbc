module v2.test.manual.typescript_program_emit_run


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn ts_program_emit_add_source() -> String {
  match v2.test.manual.typescript_add_emit_translate.anchor_typescript_add_emit_accepts() {
    v2.std.diagnostic.Accepted { value: source, diagnostics: _ } => source.carried
    v2.std.diagnostic.Rejected { diagnostics: _ } => "TS_ADD_EMIT_REJECTED"
  }
}

test fn ts_program_emit_add_source_holds() -> Bool {
  ts_program_emit_add_source() == "function add(x: number, y: number): number { return x + y; }"
}

test fn ts_atom_catalog_realizes_char_to_string_holds() -> Bool {
  match v2.std.compilers.target_model.target_atom_realization_lookup_in_catalog(
    catalog: v2.extdeps.languages.typescript.ts_target_atom_realization_catalog,
    source_carrier: v2.std.compilers.target_model.char_kernel_type_node()
  ) {
    v2.std.diagnostic.Accepted { value: row, diagnostics: _ } => row.display_name == ^char_kernel_type_atom
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
