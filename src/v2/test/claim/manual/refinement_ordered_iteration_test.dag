module v2.test.manual.refinement_ordered_iteration

fn ordered_classifier_for_list_int() -> v2.std.refinement.IterationClassifier<std.types.List<Int>> {
  v2.std.refinement.IterationClassifier { classify: fn(_) { v2.std.refinement.StructurallyOrdered } }
}

fn unordered_classifier_for_list_int() -> v2.std.refinement.IterationClassifier<std.types.List<Int>> {
  v2.std.refinement.IterationClassifier { classify: fn(_) { v2.std.refinement.StructurallyUnordered } }
}

fn test_locus() -> v2.std.diagnostic.Locus {
  v2.std.diagnostic.Textual { file: ^refinement_ordered_iteration_test_file, extent: v2.std.diagnostic.WholeFile }
}

test fn witness_ordered_classifier_accepts() -> Bool {
  match v2.std.refinement.refine_ordered_iteration(
    base: std.algebra.Empty,
    by: ordered_classifier_for_list_int(),
    at: test_locus()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn witness_unordered_classifier_rejects_with_naming_the_leak() -> Bool {
  match v2.std.refinement.refine_ordered_iteration(
    base: std.algebra.Empty,
    by: unordered_classifier_for_list_int(),
    at: test_locus()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: diags } => diags.head.reason == ^naming_the_leak
  }
}
