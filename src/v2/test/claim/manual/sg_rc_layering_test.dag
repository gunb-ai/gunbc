module v2.test.manual.sg_rc_layering


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data sg_rc_fail_text: String = ""
data sg_rc_expected_rc_diagnostics: String = "Rc<Diagnostics>"
data sg_rc_expected_owned_diagnostics: String = "Diagnostics"
data sg_rc_expected_rc_outcome_node: String = "Rc<Outcome<Node>>"

fn sg_rc_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg_rc_fail_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn sg_rc_ctor_binding_spelling(binding: Symbol, expected: String) -> Bool {
  let spellings = rust_sg2_binding_spellings()
  match spellings.lookup(binding) {
    Present { value: spelling } => spelling == expected
    Absent => false
  }
}

test fn sg_rc_ctor_spellings_in_binding_map() -> Bool {
  sg_rc_ctor_binding_spelling(binding: ^rust_sg_rc_ctor_rc_new, expected: "Rc::new")
  && sg_rc_ctor_binding_spelling(binding: ^rust_sg_rc_ctor_box_new, expected: "Box::new")
}

fn sg_rc_target() -> TargetModel {
  rust_sg2_type_expr_target_model()
}

fn sg_rc_diagnostics_inner_emitted() -> Node {
  target_type_expr_atom_emitted(
    form: rust_type_expression_projection().atom_form,
    identity: ^target_carrier_diagnostics
  )
}

fn sg_rc_apply_layer_to_diagnostics(layer: TargetReferenceLayer) -> Node {
  target_reference_layer_apply_type_emitted(
    inner: sg_rc_diagnostics_inner_emitted(),
    layer: layer,
    projection: rust_type_expression_projection(),
    tokens: rust_reference_layer_tokens()
  )
}

fn sg_rc_serialized_type_text(emitted: Node) -> String {
  match target_serialize_source_from_model(target: sg_rc_target(), emitted: emitted) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => sg_rc_fail_text
  }
}

fn sg_rc_outcome_node_source_type() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^target_carrier_outcome } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^target_carrier_node } },
          children: [],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn sg_rc_outcome_node_projected_type() -> Node {
  match translate_type_expression_project(
    node: sg_rc_outcome_node_source_type(),
    target: sg_rc_target(),
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: projected, diagnostics: _ } => projected
    Rejected { diagnostics: _ } => sg_rc_fail_node()
  }
}

fn sg_rc_outcome_node_return_shell() -> Node {
  match translate_apply_use_site_ownership_to_projected_type(
    projected: sg_rc_outcome_node_projected_type(),
    source_carrier: sg_rc_outcome_node_source_type(),
    target: sg_rc_target(),
    use_site: OwnershipAtFunctionReturn
  ) {
    Accepted { value: wrapped, diagnostics: _ } => wrapped
    Rejected { diagnostics: _ } => sg_rc_fail_node()
  }
}

test fn sg_rc_outcome_inner_sg2_args_preserved() -> Bool {
  sg_rc_serialized_type_text(emitted: sg_rc_outcome_node_return_shell()) ==
    sg_rc_expected_rc_outcome_node
}

fn sg_rc_f1_rc_type_text() -> String {
  sg_rc_serialized_type_text(emitted: sg_rc_apply_layer_to_diagnostics(layer: ReferenceLayerRc))
}

fn sg_rc_f1_owned_type_text() -> String {
  sg_rc_serialized_type_text(emitted: sg_rc_apply_layer_to_diagnostics(layer: ReferenceLayerOwned))
}

fn sg_rc_diagnostics_identity_value() -> TargetValueExpression {
  target_value_expression_symbol_identity(identity: ^target_carrier_diagnostics)
}

fn sg_rc_value_expr_ctor_identity(expr: TargetValueExpression) -> Symbol {
  match expr.node.kind {
    TypeNode { connective: Atom { identity: id } } => id
    _ => ^sg_rc_fail_sym
  }
}

test fn sg_rc_f1_value_dual_boundary_holds() -> Bool {
  let inner = sg_rc_diagnostics_identity_value()
  let tokens = rust_reference_layer_tokens()
  let rc = target_reference_layer_apply_value_expression(
    inner: inner,
    layer: ReferenceLayerRc,
    tokens: tokens
  )
  let owned = target_reference_layer_apply_value_expression(
    inner: inner,
    layer: ReferenceLayerOwned,
    tokens: tokens
  )
  match rc.kind {
    TargetValueExprReferenceRcNew =>
      sg_rc_value_expr_ctor_identity(expr: rc) == tokens.rc_new_ctor
    _ => false
  } && match owned.kind {
    TargetValueExprSymbolIdentity => true
    _ => false
  }
}

test fn sg_rc_f1_dual_boundary_holds() -> Bool {
  sg_rc_f1_rc_type_text() == sg_rc_expected_rc_diagnostics
    && sg_rc_f1_owned_type_text() == sg_rc_expected_owned_diagnostics
    && sg_rc_f1_value_dual_boundary_holds()
}

test fn sg_rc_f2_return_value_holds() -> Bool {
  match translate_apply_use_site_ownership_to_value_expression(
    expr: sg_rc_diagnostics_identity_value(),
    source_carrier: target_carrier_diagnostics_node(),
    target: sg_rc_target(),
    use_site: OwnershipAtFunctionReturn
  ) {
    Accepted { value: wrapped, diagnostics: _ } =>
      match wrapped.kind {
        TargetValueExprReferenceRcNew => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn sg_rc_f2_param_value_holds() -> Bool {
  match translate_apply_use_site_ownership_to_value_expression(
    expr: sg_rc_diagnostics_identity_value(),
    source_carrier: target_carrier_diagnostics_node(),
    target: sg_rc_target(),
    use_site: OwnershipAtFunctionParameter
  ) {
    Accepted { value: wrapped, diagnostics: _ } =>
      match wrapped.kind {
        TargetValueExprSymbolIdentity => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn sg_rc_probe_heap_param_without_row_rejects() -> Bool {
  match translate_coerced_shell_at_use_site(
    coerced: target_carrier_probe_heap_node(),
    target: sg_rc_target(),
    use_site: OwnershipAtFunctionParameter
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn sg_rc_f6_round_trip_owned() -> Bool {
  match target_reference_layer_probe_from_emitted_type(
    emitted: sg_rc_apply_layer_to_diagnostics(layer: ReferenceLayerOwned),
    projection: rust_type_expression_projection(),
    tokens: rust_reference_layer_tokens()
  ) {
    ReferenceLayerProbeNotWrapped => true
    _ => false
  }
}

test fn sg_rc_value_rc_wrap_tagged() -> Bool {
  let inner = sg_rc_diagnostics_identity_value()
  let tokens = rust_reference_layer_tokens()
  let expected = target_reference_layer_apply_value_expression(
    inner: inner,
    layer: ReferenceLayerRc,
    tokens: tokens
  )
  match translate_apply_use_site_ownership_to_value_expression(
    expr: inner,
    source_carrier: target_carrier_diagnostics_node(),
    target: sg_rc_target(),
    use_site: OwnershipAtBindingProjection
  ) {
    Accepted { value: wrapped, diagnostics: _ } =>
      match wrapped.kind {
        TargetValueExprReferenceRcNew =>
          sg_rc_value_expr_ctor_identity(expr: wrapped) == tokens.rc_new_ctor
            && content_hash(n: target_value_expression_node(expr: wrapped)) ==
              content_hash(n: target_value_expression_node(expr: expected))
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

