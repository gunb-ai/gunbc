module v2.test.manual.body_lowering_variants


test fn body_lowering_variant_branch_matches() -> Bool {
  v2.std.compilers.body_lowering.lower_branch(
    condition: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_token_kw_true),
    then_arm: v2.extdeps.languages.dag.dag_int_literal_fixture_one(),
    else_arm: v2.extdeps.languages.dag.dag_int_literal_fixture_two()
  ) == v2.extdeps.languages.dag.dag_pick_if_body_node()
}

test fn body_lowering_variant_loop_matches() -> Bool {
  v2.std.compilers.body_lowering.lower_loop(
    value: v2.extdeps.languages.dag.dag_int_literal_fixture_one(),
    bound: v2.extdeps.languages.dag.dag_loop_measure_node()
  ) == v2.extdeps.languages.dag.dag_loop_body_node()
}

test fn body_lowering_variant_bind_matches() -> Bool {
  v2.std.compilers.body_lowering.lower_bind(
    key_binding: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_bind_x),
    value: v2.extdeps.languages.dag.dag_int_literal_fixture_one(),
    body_binding: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_bind_x)
  ) == v2.extdeps.languages.dag.dag_bind_let_body_node()
}

