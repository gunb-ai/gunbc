module v2.test.manual.body_lowering_variants

import v2.std.compilers.body_lowering { lower_bind, lower_branch, lower_loop }
import v2.extdeps.languages.dag {
  dag_bind_let_body_node,
  dag_int_literal_fixture_one,
  dag_int_literal_fixture_two,
  dag_loop_body_node,
  dag_loop_measure_node,
  dag_pick_if_body_node,
  dag_type_atom_node
}
import v2.std.logic { Bool }

test fn body_lowering_variant_branch_matches() -> Bool {
  lower_branch(
    condition: dag_type_atom_node(identity: ^dag_token_kw_true),
    then_arm: dag_int_literal_fixture_one(),
    else_arm: dag_int_literal_fixture_two()
  ) == dag_pick_if_body_node()
}

test fn body_lowering_variant_loop_matches() -> Bool {
  lower_loop(
    value: dag_int_literal_fixture_one(),
    bound: dag_loop_measure_node()
  ) == dag_loop_body_node()
}

test fn body_lowering_variant_bind_matches() -> Bool {
  lower_bind(
    key_binding: dag_type_atom_node(identity: ^dag_binding_bind_x),
    value: dag_int_literal_fixture_one(),
    body_binding: dag_type_atom_node(identity: ^dag_binding_bind_x)
  ) == dag_bind_let_body_node()
}

