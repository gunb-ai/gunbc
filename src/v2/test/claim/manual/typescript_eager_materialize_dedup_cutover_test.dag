module v2.test.manual.typescript_eager_materialize_dedup_cutover


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ts_arc1_eager_row_round_trip_holds() -> Bool {
  match ts_task_type_alias_relation_row_witness() {
    Holds { value: eager_row } =>
      match ts_eager_grammar_relation_row_witness(lhs: ^ts_production_type_alias_decl) {
        Holds { value: rederived } =>
          content_hash(n: eager_row) == content_hash(n: rederived)
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn ts_arc1_pr3_eager_row_round_trip_holds() -> Bool {
  match ts_pr3_identity_relation_row_witness() {
    Holds { value: eager_row } =>
      match ts_eager_grammar_relation_row_witness(lhs: ^ts_production_pr3_typed_fn_decl) {
        Holds { value: rederived } =>
          content_hash(n: eager_row) == content_hash(n: rederived)
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn ts_arc1_exemplar_derive_violates_holds() -> Bool {
  match ts_exemplar_emitted_for_lhs(lhs: ^ts_production_fn_add) {
    Violates { diagnostic: d } => d.reason == ^grammar_relation_emitted_not_conj
    Holds { value: _ } => false
  }
}

fn ts_arc1_surplus_conj_emitted() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: ts_inhabitant_atom(id: ^ts_binding_task) },
      Edge { label: Positional, target: ts_type_annotation_task_record_emitted() },
      Edge { label: Positional, target: ts_inhabitant_atom(id: ^ts_surplus_conj_slot_dummy) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_arc1_perturbed_row_derive_red_holds() -> Bool {
  match formal_production_for_lhs_exact(
    productions: ts_task_formal_productions(),
    lhs: ^ts_production_type_alias_decl,
    child: ts_arc1_surplus_conj_emitted()
  ) {
    Holds { value: production } =>
      match derive_grammar_relation_row_node(
        production: production,
        productions: ts_task_formal_productions(),
        emitted: ts_arc1_surplus_conj_emitted()
      ) {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
    Violates { diagnostic: _ } => true
  }
}

fn ts_arc1_scaffold_row_present_holds() -> Bool {
  match find_named_child(
    root: ts_fn_add_scaffold_relation_row_node(),
    name: ^grammar_relation_field_emitted
  ) {
    Accepted { value: emitted, diagnostics: _ } =>
      emitted == ts_emitted_add_fn_node()
    Rejected { diagnostics: _ } => false
  }
}

test fn ts_arc1_eager_row_content_hash_round_trip_holds() -> Bool {
  ts_arc1_eager_row_round_trip_holds()
}

test fn ts_arc1_pr3_eager_row_content_hash_round_trip_holds() -> Bool {
  ts_arc1_pr3_eager_row_round_trip_holds()
}

test fn ts_arc1_arrow_exemplar_keeps_scaffold_fallback_holds() -> Bool {
  ts_arc1_exemplar_derive_violates_holds() && ts_arc1_scaffold_row_present_holds()
}

test fn ts_arc1_perturbed_eager_emitted_derive_red_holds() -> Bool {
  ts_arc1_perturbed_row_derive_red_holds()
}
