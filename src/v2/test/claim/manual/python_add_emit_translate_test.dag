module v2.test.manual.python_add_emit_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data python_add_forbidden_authority_source_text: String = "authority_source_text_fallback_forbidden"

data python_add_int_inhabitant: Node = python_int_inhabitant_node()

data python_add_emitted_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Arrow },
  children: [
    v2.std.node.Edge { label: Positional, target: python_add_int_inhabitant },
    v2.std.node.Edge { label: Positional, target: python_add_int_inhabitant },
    v2.std.node.Edge { label: Positional, target: python_add_int_inhabitant }
  ],
  occurrence_id: SyntheticOccurrence
}

data python_add_int_facts_node: Node = python_integer_facts_node(facts: python_facts_int)

data python_add_target_model: v2.std.compilers.target_model.TargetModel = python_target_model()

data python_add_poisoned_authority_target_model: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: python_target_model_node(),
  lex: python_lex(),
  binding_spellings: python_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: python_add_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data python_add_empty_translation_rules_bundle: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data python_add_missing_translation_rules_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: python_add_empty_translation_rules_bundle,
  lex: python_lex(),
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_python_add_serialize_rejects_missing_translation_rules() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: python_add_missing_translation_rules_target,
    emitted: python_add_emitted_root
  )
}

data python_add_serialize_reject_receipt: Outcome<Medium<String>> = anchor_python_add_serialize_rejects_missing_translation_rules()

test fn python_add_serialize_reject_receipt_holds() -> Bool {
  match python_add_serialize_reject_receipt {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d != v2.std.diagnostic.None
  }
}


fn python_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn python_add_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == python_add_emitted_root {
    v2.std.witness.Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == python_add_int_inhabitant {
    v2.std.witness.Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_inhabitant_int) {
    v2.std.witness.Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_inhabitant
      )
    }
  } else if node == python_add_int_facts_node {
    v2.std.witness.Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_surface_spelling_int) {
    v2.std.witness.Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_repr_int_arbitrary_precision) {
    v2.std.witness.Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: ^std_projection_additive_numeric) {
    v2.std.witness.Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_facts_node
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^python_add_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn python_add_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match python_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn python_add_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  python_add_inferred_facts_for(node: key)
}

data python_add_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: python_add_emitted_root,
  facts: std.types.Map {
    lookup: python_add_facts_lookup
  }
}

fn anchor_python_add_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: python_add_inferred_tree, target: python_add_target_model)
}

fn anchor_python_add_compile_inferred_accepts() -> Outcome<v2.compiler.compile.CompileOutput> {
  compile_inferred(
    inferred: python_add_inferred_tree,
    mode: v2.compiler.compile.TranslateTo { target: python_add_poisoned_authority_target_model }
  )
}

data python_add_emit_receipt: Outcome<Medium<String>> = anchor_python_add_emit_accepts()

test fn python_add_emit_add_fn_accepts_holds() -> Bool {
  match python_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == python_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

data python_add_compile_inferred_receipt: Outcome<v2.compiler.compile.CompileOutput> = anchor_python_add_compile_inferred_accepts()

test fn python_add_compile_inferred_receipt_holds() -> Bool {
  match python_add_compile_inferred_receipt {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}





