module v2.test.manual.python_add_emit_translate

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.compiler.emit { emit }
import v2.compiler.compile {
  CompileOutput,
  TranslateResult,
  TranslateTo,
  compile_inferred
}
import v2.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  run_test_claim_assert,
  test_claim_cache_receipt,
  test_claim_typed_input_node
}
import v2.compiler.translate {
  target_serialize_source_from_model,
  translate,
}
import v2.extdeps.languages.python {
  python_facts_int,
  python_inhabitant_atom,
  python_int_inhabitant_node,
  python_integer_facts_node,
  python_binding_spellings,
  python_source_text,
  python_target_model,
  python_target_model_node,
  python_lex
}
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.compilers.target_model { TargetModel, target_model_emit_transforms_empty }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.test.manual.infer_ground_add {
  infer_receipt_context
}
import v2.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v2.std.collection { Map, empty_map }
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.node {
  Arrow,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  DiagnosticClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  CompilesClaim,
  manual_claim_anchor,
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data python_add_forbidden_authority_source_text: String = "authority_source_text_fallback_forbidden"

data python_add_int_inhabitant: Node = python_int_inhabitant_node()

data python_add_emitted_root: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: python_add_int_inhabitant },
    Edge { label: Positional, target: python_add_int_inhabitant },
    Edge { label: Positional, target: python_add_int_inhabitant }
  ],
  occurrence_id: SyntheticOccurrence
}

data python_add_int_facts_node: Node = python_integer_facts_node(facts: python_facts_int)

data python_add_target_model: TargetModel = python_target_model()

data python_add_poisoned_authority_target_model: TargetModel = TargetModel {
  bundle: python_target_model_node(),
  lex: python_lex(),
  binding_spellings: python_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: python_add_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data python_add_empty_translation_rules_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data python_add_missing_translation_rules_target: TargetModel = TargetModel {
  bundle: python_add_empty_translation_rules_bundle,
  lex: python_lex(),
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_python_add_serialize_rejects_missing_translation_rules() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: python_add_missing_translation_rules_target,
    emitted: python_add_emitted_root
  )
}

data python_add_serialize_reject_receipt: Outcome<Medium<String>> = anchor_python_add_serialize_rejects_missing_translation_rules()

fn python_add_serialize_reject_claim_outcome() -> Outcome<Node> {
  match python_add_serialize_reject_receipt {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: ^python_add_serialize_unexpected_accept,
            at: node_locus(node: python_add_emitted_root),
            correction: Unavailable { reason: ExternalContractUnknown }
          }
        )
      }
  }
}

fn python_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn python_add_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == python_add_emitted_root {
    Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == python_add_int_inhabitant {
    Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_inhabitant_int) {
    Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_inhabitant
      )
    }
  } else if node == python_add_int_facts_node {
    Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_surface_spelling_int) {
    Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_repr_int_arbitrary_precision) {
    Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: ^std_projection_additive_numeric) {
    Holds {
      value: python_add_canonical_grounding(
        node: node,
        algebra: python_add_int_facts_node
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^python_add_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn python_add_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match python_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn python_add_facts_lookup(key: Node) -> Witness<InferredFacts> {
  python_add_inferred_facts_for(node: key)
}

data python_add_inferred_tree: InferredTree = InferredTree {
  root: python_add_emitted_root,
  facts: Map {
    lookup: python_add_facts_lookup
  }
}

fn anchor_python_add_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: python_add_inferred_tree, target: python_add_target_model)
}

fn anchor_python_add_compile_inferred_accepts() -> Outcome<CompileOutput> {
  compile_inferred(
    inferred: python_add_inferred_tree,
    mode: TranslateTo { target: python_add_poisoned_authority_target_model }
  )
}

data python_add_emit_receipt: Outcome<Medium<String>> = anchor_python_add_emit_accepts()

test fn python_add_emit_add_fn_accepts_holds() -> Bool {
  match python_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == python_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

data python_add_compile_inferred_receipt: Outcome<CompileOutput> = anchor_python_add_compile_inferred_accepts()

fn python_add_emit_claim_outcome() -> Outcome<Node> {
  match python_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      if (source.carried == python_source_text) && (d == None) {
        Accepted { value: python_add_emitted_root, diagnostics: None }
      } else {
        Rejected {
          diagnostics: diagnostics_singleton(
            d: Diagnostic {
              reason: ^python_add_emit_source_mismatch,
              at: node_locus(node: python_add_emitted_root),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn python_add_compile_inferred_claim_outcome() -> Outcome<Node> {
  match python_add_compile_inferred_receipt {
    Accepted { value: compile_result, diagnostics: d } =>
      match compile_result {
        TranslateResult { source } =>
          if (source.carried == python_source_text) && (d == None) {
            Accepted { value: python_add_emitted_root, diagnostics: None }
          } else {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: Diagnostic {
                  reason: ^python_add_compile_source_mismatch,
                  at: node_locus(node: python_add_emitted_root),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }
              )
            }
          }
        _ =>
          Rejected {
            diagnostics: diagnostics_singleton(
              d: Diagnostic {
                reason: ^python_add_compile_source_mismatch,
                at: node_locus(node: python_add_emitted_root),
                correction: Unavailable { reason: ExternalContractUnknown }
              }
            )
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

data claim_python_add_emit_add_fn_accepts: TestClaim = CompilesClaim {
  label: "manual/rust_add_emit: anchor_python_add_emit_accepts with canonical python_add add-fn source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: python_add_emitted_root,
  expected_value: python_add_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_python_add_compile_inferred_add_fn_accepts: TestClaim = CompilesClaim {
  label: "manual/rust_add_emit: compile_inferred emits canonical python_add add-fn source through grammar inverse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: python_add_emitted_root,
  expected_value: python_add_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data subject_python_add_emit_add_fn_accepts: TestClaimEvalSubject<Node> = TestClaimEvalSubject {
  claim: claim_python_add_emit_add_fn_accepts,
  context: infer_receipt_context(),
  tree: python_add_inferred_tree,
  input: test_claim_typed_input_node(
    evaluator_input: python_add_emitted_root,
    evaluator_pin: ^infer_receipt_input_infer_add
  )
}

data run_python_add_emit_add_fn_accepts: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(subject: subject_python_add_emit_add_fn_accepts),
  verdict: run_test_claim_assert(
    claim: claim_python_add_emit_add_fn_accepts,
    actual: python_add_emit_claim_outcome(),
    at: python_add_emitted_root
  )
}

data subject_python_add_compile_inferred_add_fn_accepts: TestClaimEvalSubject<Node> = TestClaimEvalSubject {
  claim: claim_python_add_compile_inferred_add_fn_accepts,
  context: infer_receipt_context(),
  tree: python_add_inferred_tree,
  input: test_claim_typed_input_node(
    evaluator_input: python_add_emitted_root,
    evaluator_pin: ^infer_receipt_input_infer_add
  )
}

data run_python_add_compile_inferred_add_fn_accepts: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(subject: subject_python_add_compile_inferred_add_fn_accepts),
  verdict: run_test_claim_assert(
    claim: claim_python_add_compile_inferred_add_fn_accepts,
    actual: python_add_compile_inferred_claim_outcome(),
    at: python_add_emitted_root
  )
}

data claim_python_add_serialize_rejects_missing_translation_rules: TestClaim = DiagnosticClaim {
  label: "manual/rust_add_emit: target_serialize_source_from_model rejects python bundle missing translation_rules",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: python_add_emitted_root,
  expected_rejection: diagnostics_singleton(
    d: Diagnostic {
      reason: ^translate_target_bundle_malformed,
      at: node_locus(node: python_add_empty_translation_rules_bundle),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  ),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data subject_python_add_serialize_rejects_missing_translation_rules: TestClaimEvalSubject<Node> = TestClaimEvalSubject {
  claim: claim_python_add_serialize_rejects_missing_translation_rules,
  context: infer_receipt_context(),
  tree: python_add_inferred_tree,
  input: test_claim_typed_input_node(
    evaluator_input: python_add_emitted_root,
    evaluator_pin: ^infer_receipt_input_infer_add
  )
}

data run_python_add_serialize_rejects_missing_translation_rules: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(subject: subject_python_add_serialize_rejects_missing_translation_rules),
  verdict: run_test_claim_assert(
    claim: claim_python_add_serialize_rejects_missing_translation_rules,
    actual: python_add_serialize_reject_claim_outcome(),
    at: python_add_emitted_root
  )
}
