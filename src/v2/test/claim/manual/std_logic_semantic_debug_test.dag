module v2.test.manual.std_logic_semantic_debug

import v2.test.fixture.std_logic_module {
  std_logic_module_ingest,
  std_logic_module_admission
}
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.infer { infer }
import v2.compiler.program_partition { partition_user_semantic_types_from_root }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.algebra { list_head, HeadFound, HeadAbsent }
import v2.std.node { Disj, TypeNode }
import v2.std.logic { Bool }

test fn std_logic_debug_semantic_is_disj() -> Bool {
  match assemble_program_from_ingest(
    ingest: std_logic_module_ingest(),
    admission: std_logic_module_admission(),
    lm: dag_language_model()
  ) {
    Accepted { value: resolved, diagnostics: _ } =>
      match infer(tree: resolved) {
        Accepted { value: tree, diagnostics: _ } =>
          match list_head(xs: partition_user_semantic_types_from_root(root: tree.root)) {
            HeadFound { value: decl } =>
              match decl.semantic.kind {
                TypeNode { connective: Disj } => true
                _ => false
              }
            HeadAbsent => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
