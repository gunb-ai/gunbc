module v2.test.manual.typescript_pr3_typed_fn_translate


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data typescript_pr3_emitted_root: Node = ts_pr3_identity_typed_fn_emitted()

fn typescript_pr3_target_model_for_emit() -> Witness<TargetModel> {
  ts_pr3_identity_target_model_witness()
}

fn typescript_pr3_canonical_grounding(node: Node, algebra: Node) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn typescript_pr3_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == typescript_pr3_emitted_root {
    Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_token_ty_number) {
    Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_binding_pr3_identity) {
    Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_binding_param_x) {
    Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if content_hash(n: node) == content_hash(n: typescript_pr3_emitted_root) {
    Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: typescript_pr3_emitted_root)
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^typescript_pr3_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn typescript_pr3_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match typescript_pr3_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn typescript_pr3_facts_lookup(key: Node) -> Witness<InferredFacts> {
  typescript_pr3_inferred_facts_for(node: key)
}

data typescript_pr3_inferred_tree: InferredTree = InferredTree {
  root: typescript_pr3_emitted_root,
  facts: Map { lookup: typescript_pr3_facts_lookup }
}

fn anchor_typescript_pr3_emit_accepts() -> Outcome<Medium<String>> {
  match typescript_pr3_target_model_for_emit() {
    Holds { value: target } => emit(tree: typescript_pr3_inferred_tree, target: target)
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn anchor_typescript_pr3_compile_inferred_accepts() -> Outcome<CompileOutput> {
  match typescript_pr3_target_model_for_emit() {
    Holds { value: target } =>
      compile_inferred(
        inferred: typescript_pr3_inferred_tree,
        mode: TranslateTo { target: target }
      )
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

data typescript_pr3_emit_receipt: Outcome<Medium<String>> = anchor_typescript_pr3_emit_accepts()

data typescript_pr3_compile_inferred_receipt: Outcome<CompileOutput> = anchor_typescript_pr3_compile_inferred_accepts()

fn typescript_pr3_emit_claim_outcome() -> Outcome<Node> {
  match typescript_pr3_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      if (source.carried == ts_pr3_identity_source_text) && (d == None) {
        Accepted { value: typescript_pr3_emitted_root, diagnostics: None }
      } else {
        Rejected {
          diagnostics: diagnostics_singleton(
            d: Diagnostic {
              reason: ^typescript_pr3_emit_source_mismatch,
              at: node_locus(node: typescript_pr3_emitted_root),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn typescript_pr3_compile_inferred_claim_outcome() -> Outcome<Node> {
  match typescript_pr3_compile_inferred_receipt {
    Accepted { value: compile_result, diagnostics: d } =>
      match compile_result {
        TranslateResult { source } =>
          if (source.carried == ts_pr3_identity_source_text) && (d == None) {
            Accepted { value: typescript_pr3_emitted_root, diagnostics: None }
          } else {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: Diagnostic {
                  reason: ^typescript_pr3_compile_source_mismatch,
                  at: node_locus(node: typescript_pr3_emitted_root),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }
              )
            }
          }
        _ =>
          Rejected {
            diagnostics: diagnostics_singleton(
              d: Diagnostic {
                reason: ^typescript_pr3_compile_source_mismatch,
                at: node_locus(node: typescript_pr3_emitted_root),
                correction: Unavailable { reason: ExternalContractUnknown }
              }
            )
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

data claim_typescript_pr3_typed_fn_emit_accepts: TestClaim = CompilesClaim {
  label: "manual/rust_add_emit: pr3 identity typed-fn emit round-trips via derive grammar-relation row",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: typescript_pr3_emitted_root,
  expected_value: typescript_pr3_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_typescript_pr3_typed_fn_compile_accepts: TestClaim = CompilesClaim {
  label: "manual/G3: compile_inferred emits canonical identity typed-fn through grammar inverse production ts_production_pr3_typed_fn_decl",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: typescript_pr3_emitted_root,
  expected_value: typescript_pr3_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data run_typescript_pr3_typed_fn_emit_accepts: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(
    subject: TestClaimEvalSubject {
      claim: claim_typescript_pr3_typed_fn_emit_accepts,
      context: typescript_pr3_emitted_root,
      tree: typescript_pr3_inferred_tree,
      input: test_claim_typed_input_node(
        evaluator_input: typescript_pr3_emitted_root,
        evaluator_pin: typescript_pr3_emitted_root
      )
    }
  ),
  verdict: run_test_claim_assert(
    claim: claim_typescript_pr3_typed_fn_emit_accepts,
    actual: typescript_pr3_emit_claim_outcome(),
    at: typescript_pr3_emitted_root
  )
}
