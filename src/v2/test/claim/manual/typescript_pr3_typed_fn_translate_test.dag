module v2.test.manual.typescript_pr3_typed_fn_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data typescript_pr3_emitted_root: v2.std.node.Node = ts_pr3_identity_typed_fn_emitted()

fn typescript_pr3_target_model_for_emit() -> Witness<v2.std.compilers.target_model.TargetModel> {
  ts_pr3_identity_target_model_witness()
}

fn typescript_pr3_canonical_grounding(node: v2.std.node.Node, algebra: v2.std.node.Node) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn typescript_pr3_canonical_grounding_for(node: v2.std.node.Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == typescript_pr3_emitted_root {
    v2.std.witness.Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_token_ty_number) {
    v2.std.witness.Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_binding_pr3_identity) {
    v2.std.witness.Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_binding_param_x) {
    v2.std.witness.Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if content_hash(n: node) == content_hash(n: typescript_pr3_emitted_root) {
    v2.std.witness.Holds {
      value: typescript_pr3_canonical_grounding(node: node, algebra: typescript_pr3_emitted_root)
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^typescript_pr3_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn typescript_pr3_inferred_facts_for(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match typescript_pr3_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn typescript_pr3_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  typescript_pr3_inferred_facts_for(node: key)
}

data typescript_pr3_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: typescript_pr3_emitted_root,
  facts: std.types.Map { lookup: typescript_pr3_facts_lookup }
}

fn anchor_typescript_pr3_emit_accepts() -> v2.std.diagnostic.Outcome<Medium<String>> {
  match typescript_pr3_target_model_for_emit() {
    Holds { value: target } => v2.compiler.emit.emit(tree: typescript_pr3_inferred_tree, target: target)
    Violates { diagnostic: d } =>
      v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn anchor_typescript_pr3_compile_inferred_accepts() -> v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> {
  match typescript_pr3_target_model_for_emit() {
    Holds { value: target } =>
      compile_inferred(
        inferred: typescript_pr3_inferred_tree,
        mode: v2.compiler.compile.TranslateTo { target: target }
      )
    Violates { diagnostic: d } =>
      v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

data typescript_pr3_emit_receipt: v2.std.diagnostic.Outcome<Medium<String>> = anchor_typescript_pr3_emit_accepts()

data typescript_pr3_compile_inferred_receipt: v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> = anchor_typescript_pr3_compile_inferred_accepts()
test fn typescript_pr3_emit_receipt_decided() -> Bool {
  match typescript_pr3_emit_receipt {
    Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}
test fn typescript_pr3_compile_inferred_receipt_decided() -> Bool {
  match typescript_pr3_compile_inferred_receipt {
    Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}


