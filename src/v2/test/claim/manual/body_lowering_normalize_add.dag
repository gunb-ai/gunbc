fn body_lowering_arrow_direct_well_formed() -> Bool {
  match body_lowering_parsed_fn_decl() {
    Absent => false
    Present { value: fn_decl } =>
      match body_lower_fn_decl_to_arrow(shell: fn_decl) {
        Accepted { value: arrow, diagnostics: _ } => well_formed(n: arrow)
        Rejected { diagnostics: _ } => false
      }
  }
}

fn body_lowering_module_well_formed() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } => well_formed(n: tree)
  }
}

fn body_lowering_normalized_resolves() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match resolve(tree: tree, lm: dag_language_model()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

fn body_lowering_normalize_accepts() -> Bool {
  match body_lowering_normalized_module() {
    Present { value: _ } => true
    Absent => false
  }
}

fn body_lowering_tree_contains_atom(root: Node, wanted: Symbol) -> Bool {
  match node_atom_identity_optional(node: root) {
    Present { value: id } =>
      if id == wanted {
        true
      } else {
        false
      }
    Absent =>
      fold(root.children, init: false, f: fn(found, e) {
        if found {
          true
        } else {
          body_lowering_tree_contains_atom(root: e.target, wanted: wanted)
        }
      })
  }
}

fn body_lowering_fixture_resolves() -> Bool {
  let lm = dag_language_model()
  match resolve(tree: dag_add_arrow_with_body_fixture, lm: lm) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn body_lowering_transform_operand_identities(arrow: Node) -> List<Symbol> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } =>
          fold(body.children, init: Empty, f: fn(acc, e) {
            match e.label {
              Positional =>
                match list_at_optional(xs: acc, index: 0) {
                  Present { value: _ } => acc
                  Absent =>
                    match node_atom_identity_optional(node: e.target) {
                      Present { value: id } => [id]
                      Absent => acc
                    }
                }
              _ => acc
            }
          })
        _ => Empty
      }
    Rejected { diagnostics: _ } => Empty
  }
}

fn body_lowering_normalized_operator_is_plus() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          match find_arrow_body_child(root: arrow) {
            Accepted { value: body, diagnostics: _ } =>
              match body.kind {
                ComputationNode { behavior: Transform } =>
                  if count(body.children) >= 1 {
                    match first(body.children) {
                      Present { value: e0 } =>
                        match node_atom_identity_optional(node: e0.target) {
                          Present { value: id } => id == ^dag_token_plus
                          Absent => false
                        }
                      Absent => false
                    }
                  } else {
                    false
                  }
                _ => false
              }
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn body_lower_arrow_operand_identity(arrow: Node, index: Int) -> Optional<Symbol> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match list_at_optional(xs: body.children, index: index) {
        Present { value: e } => node_atom_identity_optional(node: e.target)
        Absent => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

fn body_lowering_domain_named_count(arrow: Node) -> Int {
  if count(arrow.children) >= 1 {
    match first(arrow.children) {
      Present { value: e0 } =>
        fold(e0.target.children, init: 0, f: fn(n, e) {
          match e.label {
            Named { name: _ } => n + 1
            _ => n
          }
        })
      Absent => 0
    }
  } else {
    0
  }
}

fn body_lowering_normalized_domain_has_two_params() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          body_lowering_domain_named_count(arrow: arrow) == 2
      }
  }
}

fn body_lowering_normalized_operand2_lexeme_is_y() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          match body_lower_arrow_operand_identity(arrow: arrow, index: 2) {
            Present { value: id } => symbol_lexeme(sym: id) == "y"
            Absent => false
          }
      }
  }
}

fn body_lowering_normalized_operands_swapped() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          match body_lower_arrow_operand_identity(arrow: arrow, index: 1) {
            Present { value: left } =>
              match body_lower_arrow_operand_identity(arrow: arrow, index: 2) {
                Present { value: right } =>
                  if count(arrow.children) >= 1 {
                    match first(arrow.children) {
                      Present { value: e0 } =>
                        match list_at_optional(xs: e0.target.children, index: 0) {
                          Present { value: de0 } =>
                            match list_at_optional(xs: e0.target.children, index: 1) {
                              Present { value: de1 } =>
                                match de0.label {
                                  Named { name: bind0 } =>
                                    match de1.label {
                                      Named { name: bind1 } =>
                                        (left == bind1) && (right == bind0)
                                      _ => false
                                    }
                                  _ => false
                                }
                              Absent => false
                            }
                          Absent => false
                        }
                      Absent => false
                    }
                  } else {
                    false
                  }
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_transform_child_count(arrow: Node) -> Int {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } => count(body.children)
    Rejected { diagnostics: _ } => 0
  }
}

fn body_lowering_normalized_transform_has_three_children() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          body_lowering_transform_child_count(arrow: arrow) == 3
      }
  }
}

fn body_lowering_domain_operand2_match() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          if count(arrow.children) >= 1 {
            match first(arrow.children) {
              Present { value: e0 } =>
                match list_at_optional(xs: e0.target.children, index: 1) {
                  Present { value: de1 } =>
                    match de1.label {
                      Named { name: domain_binding } =>
                        match body_lower_arrow_operand_identity(arrow: arrow, index: 2) {
                          Present { value: operand } => domain_binding == operand
                          Absent => false
                        }
                      _ => false
                    }
                  Absent => false
                }
              Absent => false
            }
          } else {
            false
          }
      }
  }
}

fn body_lower_arrow_domain_first_binding(arrow: Node) -> Optional<Symbol> {
  if count(arrow.children) >= 1 {
    match first(arrow.children) {
      Present { value: e0 } =>
        fold(e0.target.children, init: optional_absent(), f: fn(found, e) {
          match found {
            Present { value: _ } => found
            Absent =>
              match e.label {
                Named { name: sym } => Present { value: sym }
                _ => optional_absent()
              }
          }
        })
      Absent => Absent
    }
  } else {
    Absent
  }
}

fn body_lowering_domain_operand1_match() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          match body_lower_arrow_domain_first_binding(arrow: arrow) {
            Present { value: domain_binding } =>
              match body_lower_arrow_operand_identity(arrow: arrow, index: 1) {
                Present { value: operand } => domain_binding == operand
                Absent => false
              }
            Absent => false
          }
      }
  }
}

