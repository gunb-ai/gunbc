fn body_lowering_normalized_matches_fixture_operands() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: normalized_arrow } =>
          match body_lower_arrow_operand_identity(arrow: normalized_arrow, index: 1) {
            Present { value: norm_left } =>
              match body_lower_arrow_operand_identity(arrow: normalized_arrow, index: 2) {
                Present { value: norm_right } =>
                  match body_lower_arrow_operand_identity(arrow: dag_add_arrow_with_body_fixture, index: 1) {
                    Present { value: fix_left } =>
                      match body_lower_arrow_operand_identity(arrow: dag_add_arrow_with_body_fixture, index: 2) {
                        Present { value: fix_right } =>
                          (norm_left == fix_left) && (norm_right == fix_right)
                        Absent => false
                      }
                    Absent => false
                  }
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_normalized_left_operand_is_atom() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          match body_lower_arrow_operand_identity(arrow: arrow, index: 1) {
            Present { value: _ } => true
            Absent => false
          }
      }
  }
}

fn body_lowering_left_operand_is_param_x() -> Bool {
  match body_lowering_normalized_module() {
