fn body_lowering_operand_equals(arrow: Node, index: Int, wanted: Symbol) -> Bool {
  match body_lower_arrow_operand_identity(arrow: arrow, index: index) {
    Present { value: id } => id == wanted
    Absent => false
  }
}

