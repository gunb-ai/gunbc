    Present { value: tree } =>
      body_lowering_tree_contains_atom(root: tree, wanted: ^dag_binding_param_x)
        && body_lowering_tree_contains_atom(root: tree, wanted: ^dag_binding_param_y)
  }
}

fn body_lowering_normalized_arrow_root_resolves() -> Bool {
  let lm = dag_language_model()
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          match resolve(tree: arrow, lm: lm) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn body_lowering_normalize_yields_arrow() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          well_formed(n: arrow)
            && match find_arrow_body_child(root: arrow) {
              Accepted { value: body, diagnostics: _ } =>
                match body.kind {
                  ComputationNode { behavior: Transform } => true
                  _ => false
                }
              Rejected { diagnostics: _ } => false
            }
      }
  }
}

data claim_body_lowering_normalize_add_resolves: TestClaim = EqualsClaim {
  label: "manual/body-lowering-normalize: census add module normalizes then resolves",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_bool_node(pass: body_lowering_normalized_resolves()),
  rhs: body_lowering_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_normalize_add_yields_arrow: TestClaim = EqualsClaim {
  label: "manual/body-lowering-normalize: census add module normalizes fn_decl to Arrow with Transform body",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_bool_node(pass: body_lowering_normalize_yields_arrow()),
  rhs: body_lowering_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
