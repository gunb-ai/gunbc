module v2.test.manual.body_lowering_normalize_add


data body_lowering_add_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

fn body_lowering_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_norm_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_norm_fail } },
      children: []
    )
  }
}

fn body_lowering_normalized_module() -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(
    text: body_lowering_add_module_source,
    file: ^body_lowering_add_probe_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: tree, diagnostics: _ } => Present { value: tree }
          }
      }
  }
}

fn body_lower_find_arrow_in_module(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn body_lower_find_fn_decl(root: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: emitted } =>
      match emitted == ^dag_surface_fn_decl {
        true => Present { value: root }
        false =>
          fold(root.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lower_find_fn_decl(root: e.target)
            }
          })
      }
    Absent =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_find_fn_decl(root: e.target)
        }
      })
  }
}

fn body_lowering_parsed_fn_decl() -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(
    text: body_lowering_add_module_source,
    file: ^body_lowering_add_probe_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          body_lower_find_fn_decl(root: artifact.tree)
      }
  }
}

fn body_lower_has_arrow_token(root: Node) -> Bool {
  match node_atom_identity_optional(node: root) {
    Present { value: id } => id == ^dag_token_arrow
    Absent =>
      fold(root.children, init: false, f: fn(acc, e) {
        if acc {
          true
        } else {
          body_lower_has_arrow_token(root: e.target)
        }
      })
  }
}

fn body_lowering_fn_body_subtree_holds() -> Bool {
  match body_lowering_parsed_fn_decl() {
    Absent => false
    Present { value: fn_decl } =>
      match body_lower_unwrap_captured(shell: fn_decl) {
        Present { value: captured } =>
          match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_fn_body) {
            ParseSubtreeFound { captured: _ } => true
            ParseSubtreeAbsent => false
          }
        Absent => false
      }
  }
}

fn body_lowering_arrow_token_holds() -> Bool {
  match body_lowering_parsed_fn_decl() {
    Absent => false
    Present { value: fn_decl } =>
      match body_lower_unwrap_captured(shell: fn_decl) {
        Present { value: captured } => body_lower_has_arrow_token(root: captured)
        Absent => false
      }
  }
}

fn body_lower_collect_atoms(root: Node, acc: List<Symbol>) -> List<Symbol> {
  let acc1 = match node_atom_identity_optional(node: root) {
    Present { value: id } => Cons { head: id, tail: acc }
    Absent => acc
  }
  fold(root.children, init: acc1, f: fn(a, e) {
    body_lower_collect_atoms(root: e.target, acc: a)
  })
}

fn body_lowering_has_plus_token() -> Bool {
  match body_lowering_parsed_fn_decl() {
    Absent => false
    Present { value: fn_decl } =>
      match body_lower_unwrap_captured(shell: fn_decl) {
        Present { value: captured } =>
          fold(
            body_lower_collect_atoms(root: captured, acc: Empty),
            init: false,
            f: fn(acc, sym) { acc || sym == ^dag_token_plus }
          )
        Absent => false
      }
  }
}

