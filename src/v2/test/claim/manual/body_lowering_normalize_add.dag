module v2.test.manual.body_lowering_normalize_add

import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.collection { Absent, Optional, Present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  ComputationNode,
  Node,
  Transform,
  TypeNode,
  node_synthetic,
  well_formed
}
import v2.std.node_query { find_arrow_body_child }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data body_lowering_add_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

fn body_lowering_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_norm_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_norm_fail } },
      children: []
    )
  }
}

fn body_lowering_normalized_module() -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(
    text: body_lowering_add_module_source,
    file: ^body_lowering_add_probe_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: tree, diagnostics: _ } => Present { value: tree }
          }
      }
  }
}

fn body_lower_find_arrow_in_module(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn body_lowering_normalize_yields_arrow() -> Bool {
  match body_lowering_normalized_module() {
    Absent => false
    Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          well_formed(n: arrow)
            && match find_arrow_body_child(root: arrow) {
              Accepted { value: body, diagnostics: _ } =>
                match body.kind {
                  ComputationNode { behavior: Transform } => true
                  _ => false
                }
              Rejected { diagnostics: _ } => false
            }
      }
  }
}

data claim_body_lowering_normalize_add_yields_arrow: TestClaim = EqualsClaim {
  label: "manual/body-lowering-normalize: census add module normalizes fn_decl to Arrow with Transform body",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_bool_node(pass: body_lowering_normalize_yields_arrow()),
  rhs: body_lowering_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
