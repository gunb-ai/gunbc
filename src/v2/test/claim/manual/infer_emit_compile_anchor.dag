module v2.test.manual.infer_emit_compile_anchor



data anchor_stub_empty_conj: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data anchor_stub_target_model: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: anchor_stub_empty_conj,
  lex: VoidLexRules,
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: std.algebra.Empty,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data anchor_stub_source: Medium<String> = extdeps.communication.medium.Medium { carried: std.algebra.Empty, fidelity: extdeps.communication.medium.Lossless }
data anchor_stub_inferred_facts: v2.compiler.inferred_tree.InferredFacts = claim_inferred_facts_from_nodes(
  resolved: anchor_stub_empty_conj,
  algebra: anchor_stub_empty_conj,
  descent: v2.std.witness.Violates {
    diagnostic: v2.std.diagnostic.Diagnostic {
      reason: ^anchor_stub_descent_not_derived,
      at: node_locus(node: anchor_stub_empty_conj),
      correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
    }
  }
)

data anchor_stub_empty_facts_map: std.algebra.PartialFunction<v2.std.node.Node, v2.compiler.inferred_tree.InferredFacts> = std.algebra.PartialFunction {
  lookup: fn(_) {
    Absent
  }
}

data anchor_stub_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: anchor_stub_empty_conj,
  facts: anchor_stub_empty_facts_map
}

fn anchor_infer_rejects() -> Outcome<v2.compiler.inferred_tree.InferredTree> {
  infer(tree: anchor_stub_empty_conj)
}

fn anchor_emit_rejects() -> Outcome<Medium<String>> {
  v2.compiler.emit.emit(
    tree: anchor_stub_inferred_tree,
    target: anchor_stub_target_model
  )
}

fn anchor_emit_accepts() -> Outcome<Medium<String>> {
  anchor_rust_add_emit_accepts()
}

fn anchor_compile_inferred_accepts() -> Outcome<v2.compiler.compile.CompileOutput> {
  compile_inferred(
    inferred: v2.test.manual.rust_add_emit_translate.rust_add_inferred_tree,
    mode: v2.compiler.compile.TranslateTo { target: rust_add_target_model }
  )
}

fn anchor_compile_rejects() -> Outcome<Medium<String>> {
  compile_ingest_staging(source: anchor_stub_source, target: anchor_stub_target_model)
}
