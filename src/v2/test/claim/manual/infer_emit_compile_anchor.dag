module v2.test.manual.infer_emit_compile_anchor

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.compiler.compile {
  CompileMode,
  CompileOutput,  TranslateResult,
  TranslateTo,
  compile_inferred,
  compile_ingest_staging
}
import extdeps.communication.medium { Lossless, Medium }
import v2.std.compilers.target_model { TargetModel, target_model_emit_transforms_empty }
import v2.std.compilers.lexing { VoidLexRules }
import v2.compiler.emit { emit }
import v2.compiler.infer {
  InferredFacts,
  InferredTree,
  infer
}
import v2.test.manual.rust_add_emit_translate {
  anchor_rust_add_emit_accepts,
  rust_add_inferred_tree,
  rust_add_target_model
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import std.algebra { Empty }
import v2.std.collection { Map, empty_map }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  node_locus,
  Outcome,
  port_locus,
  Unavailable
}
import std.algebra { Empty }
import v2.std.node { Conj, Node, Symbol, TypeNode, SyntheticOccurrence }

import v2.std.witness { Violates, Witness }

data anchor_stub_empty_conj: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data anchor_stub_target_model: TargetModel = TargetModel {
  bundle: anchor_stub_empty_conj,
  lex: VoidLexRules,
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: Empty,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data anchor_stub_source: Medium<String> = Medium { carried: Empty, fidelity: Lossless }
data anchor_stub_inferred_facts: InferredFacts = claim_inferred_facts_from_nodes(
  resolved: anchor_stub_empty_conj,
  algebra: anchor_stub_empty_conj,
  descent: Violates {
    diagnostic: Diagnostic {
      reason: ^anchor_stub_descent_not_derived,
      at: node_locus(node: anchor_stub_empty_conj),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
)

data anchor_stub_empty_facts_map: Map<Node, InferredFacts> = Map {
  lookup: fn(_) {
    Violates {
      diagnostic: Diagnostic {
        reason: ^anchor_facts_map_lookup_not_realized,
        at: port_locus(port: ^anchor_facts_map_lookup_not_realized),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

data anchor_stub_inferred_tree: InferredTree = InferredTree {
  root: anchor_stub_empty_conj,
  facts: anchor_stub_empty_facts_map
}

fn anchor_infer_rejects() -> Outcome<InferredTree> {
  infer(tree: anchor_stub_empty_conj)
}

fn anchor_emit_rejects() -> Outcome<Medium<String>> {
  emit(
    tree: anchor_stub_inferred_tree,
    target: anchor_stub_target_model
  )
}

fn anchor_emit_accepts() -> Outcome<Medium<String>> {
  anchor_rust_add_emit_accepts()
}

fn anchor_compile_inferred_accepts() -> Outcome<CompileOutput> {
  compile_inferred(
    inferred: rust_add_inferred_tree,
    mode: TranslateTo { target: rust_add_target_model }
  )
}

fn anchor_compile_rejects() -> Outcome<Medium<String>> {
  compile_ingest_staging(source: anchor_stub_source, target: anchor_stub_target_model)
}
