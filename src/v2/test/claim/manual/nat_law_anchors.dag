module v2.test.manual.nat_law_anchors

import v2.std.verification {TestClaim,
TestClassification,
  Tier1,
  Unit,
  ManualNatAddLeftIdentity,
  ManualNatAddRightIdentity,
  ManualNatAddAssociativity,
  ManualNatMulLeftIdentity,
  ManualNatMulAnnihilator,
  ManualNatMulAssociativity,
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  RoundTripClaim,
  manual_claim_anchor
}
import v2.std.diagnostic { Accepted, None, Outcome }
import v2.test.manual.connective_anchors { stub_empty_conj }

data claim_nat_add_left_identity: TestClaim = CompilesClaim {
  label: "manual/nat: monoid left identity nat_add(Zero,a)=a (law)",
  anchor: manual_claim_anchor(anchor: ManualNatAddLeftIdentity),
  input: stub_empty_conj,
  expected_value: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nat_add_right_identity: TestClaim = CompilesClaim {
  label: "manual/nat: monoid right identity nat_add(a,Zero)=a (law)",
  anchor: manual_claim_anchor(anchor: ManualNatAddRightIdentity),
  input: stub_empty_conj,
  expected_value: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nat_add_associativity: TestClaim = CompilesClaim {
  label: "manual/nat: monoid associativity nat_add(nat_add(a,b),c)=nat_add(a,nat_add(b,c)) (law)",
  anchor: manual_claim_anchor(anchor: ManualNatAddAssociativity),
  input: stub_empty_conj,
  expected_value: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nat_mul_left_identity: TestClaim = CompilesClaim {
  label: "manual/nat: multiplicative monoid identity nat_mul(one,a)=a where one is Succ-of-Zero (law)",
  anchor: manual_claim_anchor(anchor: ManualNatMulLeftIdentity),
  input: stub_empty_conj,
  expected_value: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nat_mul_annihilator: TestClaim = CompilesClaim {
  label: "manual/nat: semiring zero annihilator nat_mul(Zero,a)=Zero (law)",
  anchor: manual_claim_anchor(anchor: ManualNatMulAnnihilator),
  input: stub_empty_conj,
  expected_value: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nat_mul_associativity: TestClaim = CompilesClaim {
  label: "manual/nat: multiplicative monoid associativity (law)",
  anchor: manual_claim_anchor(anchor: ManualNatMulAssociativity),
  input: stub_empty_conj,
  expected_value: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
