data claim_nat_mul_left_identity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/nat: multiplicative monoid identity nat_mul(one,a)=a where one is v2.std.nat.Succ-of-v2.std.nat.Zero (law)",
