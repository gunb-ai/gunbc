data claim_nat_mul_annihilator: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/nat: semiring zero annihilator nat_mul(v2.std.nat.Zero,a)=v2.std.nat.Zero (law)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualNatMulAnnihilator),
