}

data claim_nat_add_associativity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/nat: monoid associativity nat_add(nat_add(a,b),c)=nat_add(a,nat_add(b,c)) (law)",
