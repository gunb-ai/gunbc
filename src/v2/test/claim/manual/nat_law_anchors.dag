  input: stub_empty_conj,
  expected_value: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nat_add_associativity: TestClaim = CompilesClaim {
  label: "manual/nat: monoid associativity nat_add(nat_add(a,b),c)=nat_add(a,nat_add(b,c)) (law)",
  anchor: manual_claim_anchor(anchor: ManualNatAddAssociativity),
  input: stub_empty_conj,
  expected_value: stub_empty_conj,
