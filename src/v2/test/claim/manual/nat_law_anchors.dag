module v2.test.manual.nat_law_anchors


data claim_nat_add_left_identity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/nat: monoid left identity nat_add(v2.std.nat.Zero,a)=a (law)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualNatAddLeftIdentity),
  input: v2.test.manual.connective_anchors.stub_empty_conj,
  expected_value: v2.test.manual.connective_anchors.stub_empty_conj,
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_nat_add_right_identity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/nat: monoid right identity nat_add(a,v2.std.nat.Zero)=a (law)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualNatAddRightIdentity),
