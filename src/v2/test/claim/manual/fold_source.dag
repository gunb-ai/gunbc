module v2.test.manual.fold_source

import std.algebra { Cons, Empty }
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, SyntheticOccurrence, TypeNode }
import v2.std.text { SourceFold, String, fold_source }
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

type CountAcc {
  count: Int
  done: Bool
}

fn count_init(_source: String) -> CountAcc {
  CountAcc { count: 0, done: false }
}

fn count_is_done(acc: CountAcc) -> Bool {
  acc.done
}

fn count_step(acc: CountAcc) -> CountAcc {
  let next = acc.count + 1
  CountAcc { count: next, done: next >= 3 }
}

fn count_three_algebra() -> SourceFold<CountAcc> {
  SourceFold {
    init: count_init,
    is_done: count_is_done,
    step: count_step
  }
}

data src_abc: String = Cons { head: 97, tail: Cons { head: 98, tail: Cons { head: 99, tail: Empty } } }

fn witness_fold_source_stops_at_is_done() -> Bool {
  let result = fold_source(src: src_abc, algebra: count_three_algebra())
  result.count == 3 && result.done
}

fn fold_source_ok_node(ok: Bool) -> Node {
  if ok {
    Node {
      kind: TypeNode { connective: Atom { identity: ^fold_source_ok_atom } },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  } else {
    Node {
      kind: TypeNode { connective: Atom { identity: ^fold_source_fail_atom } },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn fold_source_expected() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^fold_source_ok_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

data claim_fold_source_compiles: TestClaim = CompilesClaim {
  label: "manual/fold_source: module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fold_source_ok_node(ok: true),
  expected_value: fold_source_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_fold_source_is_done_short_circuits: TestClaim = CompilesClaim {
  label: "manual/fold_source: is_done short-circuits before |src| bound",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fold_source_ok_node(ok: witness_fold_source_stops_at_is_done()),
  expected_value: fold_source_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
