module v2.test.manual.int_literal_parse_smoke

import v2.extdeps.languages.dag {
  dag_int_literal_node_from_lexeme,
  dag_int_literal_magnitude_int_from_node
}
import v2.std.collection { Present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.integer {
  decimal_digits_to_magnitude,
  integer_decimal_magnitude_node,
  integer_string_to_decimal_digits_optional
}
import v2.std.logic { Bool }
import v2.std.node { SyntheticOccurrence }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn int_literal_string_to_digits_holds() -> Bool {
  match integer_string_to_decimal_digits_optional(s: "1") {
    Present { value: _ } => true
    _ => false
  }
}

test fn int_literal_magnitude_node_holds() -> Bool {
  match integer_string_to_decimal_digits_optional(s: "1") {
    Present { value: digits } => {
      let _node = integer_decimal_magnitude_node(magnitude: decimal_digits_to_magnitude(digits: digits))
      true
    }
    _ => false
  }
}

test fn int_literal_node_from_lexeme_one_holds() -> Bool {
  match dag_int_literal_node_from_lexeme(lexeme: "1", occurrence_id: SyntheticOccurrence) {
    Accepted { value: node, diagnostics: _ } =>
      match dag_int_literal_magnitude_int_from_node(node: node) {
        Accepted { value: v, diagnostics: _ } => v == 1
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
