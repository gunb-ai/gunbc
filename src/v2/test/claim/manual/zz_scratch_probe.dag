module v2.test.manual.zz_scratch_probe

import extdeps.filesystem.filesystem_io
import v2.compiler.parse { ValidatedGrammarRoot, grammar_validate_for_parse, parse_production }
import v2.compiler.normalize { normalize }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.collection { List }
import v2.std.compilers.lexing { symbol_lexeme, token_stream_remaining }
import v2.std.diagnostic { Accepted, Rejected, port_locus }
import v2.std.grammar { ModeledGrammar, VoidGrammar }
import v2.std.logic { Bool }
import v2.std.text { String }

fn probe_normalize_stage(path: String) -> String {
  let lm = dag_language_model()
  let source = filesystem_read(path: path).content
  match lm.grammar {
    VoidGrammar => "void_grammar"
    ModeledGrammar { root: root } =>
      match grammar_validate_for_parse(root: root, at: port_locus(port: ^probe_locus)) {
        Rejected { diagnostics: _ } => "grammar_invalid"
        Accepted { value: validated, diagnostics: _ } =>
          match tokenize(text: source, file: ^probe_file2, rules: lm.lex) {
            Rejected { diagnostics: _ } => "tokenize_fail"
            Accepted { value: stream, diagnostics: _ } =>
              match parse_production(
                tokens: token_stream_remaining(stream: stream),
                validated: validated,
                production_name: validated.root.start
              ) {
                Rejected { diagnostics: _ } => "parse_fail"
                Accepted { value: artifact, diagnostics: _ } =>
                  match normalize(parse_tree: artifact.tree) {
                    Rejected { diagnostics: nd } => concat("normalize_REJECT: ", symbol_lexeme(sym: nd.head.reason))
                    Accepted { value: _, diagnostics: _ } => "OK"
                  }
              }
          }
      }
  }
}

fn probe_normalize_file(path: String) -> Bool {
  probe_normalize_stage(path: path) == "OK"
}

fn probe_normalize_target_model() -> Bool {
  probe_normalize_file(path: "src/v2/std/compilers/target_model.dag")
}

fn probe_normalize_node_dag() -> Bool {
  probe_normalize_file(path: "src/v2/std/node.dag")
}

fn probe_normalize_collection() -> Bool {
  probe_normalize_file(path: "src/v2/std/collection.dag")
}

fn probe_normalize_refinement() -> Bool {
  probe_normalize_file(path: "src/v2/std/refinement.dag")
}

fn probe_stage_collection() -> Bool {
  probe_normalize_stage(path: "src/v2/std/collection.dag") == "OK"
}

fn probe_stage_collection_str() -> String {
  probe_normalize_stage(path: "src/v2/std/collection.dag")
}
