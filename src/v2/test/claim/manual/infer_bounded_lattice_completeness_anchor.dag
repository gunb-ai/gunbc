module v2.test.manual.infer_bounded_lattice_completeness_anchor

import v2.compiler.infer {
  InferredTree,
  infer
}
import v2.std.bounded_lattice_completeness {
  infer_bounded_lattice_consumer_gate,
  infer_bounded_lattice_instance_gate,
  partial_bounded_lattice_instances_in_tree
}
import v2.std.algebra {
  BoundedLatticeComplete,
  BoundedLatticePartial,
  MissingMeet,
  MissingLatticeField,
  NotBoundedLatticeInstance,
  length
}
import v2.std.bounded_lattice_completeness { bounded_lattice_instance_completeness }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Arrow, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
fn anchor_atom_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn anchor_fn_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn anchor_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn anchor_complete_lattice_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      anchor_named_edge(name: ^lattice_field_meet, target: anchor_fn_node()),
      anchor_named_edge(name: ^lattice_field_join, target: anchor_fn_node())
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn anchor_lattice_missing_meet_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      anchor_named_edge(name: ^lattice_field_join, target: anchor_fn_node())
    ],
    occurrence_id: SyntheticOccurrence
}
}

data anchor_complete_bounded_lattice_instance: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(name: ^bounded_lattice_field_lattice, target: anchor_complete_lattice_node()),
    anchor_named_edge(name: ^bounded_lattice_field_top, target: anchor_atom_node(s: ^anchor_top_sym)),
    anchor_named_edge(name: ^bounded_lattice_field_bottom, target: anchor_atom_node(s: ^anchor_bottom_sym))
  ],
  occurrence_id: SyntheticOccurrence
}

data anchor_partial_bounded_lattice_instance: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(name: ^bounded_lattice_field_lattice, target: anchor_lattice_missing_meet_node()),
    anchor_named_edge(name: ^bounded_lattice_field_top, target: anchor_atom_node(s: ^anchor_top_sym)),
    anchor_named_edge(name: ^bounded_lattice_field_bottom, target: anchor_atom_node(s: ^anchor_bottom_sym))
  ],
  occurrence_id: SyntheticOccurrence
}

data anchor_partial_missing_lattice_field_instance: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(name: ^bounded_lattice_field_top, target: anchor_atom_node(s: ^anchor_top_sym)),
    anchor_named_edge(name: ^bounded_lattice_field_bottom, target: anchor_atom_node(s: ^anchor_bottom_sym))
  ],
  occurrence_id: SyntheticOccurrence
}

data anchor_consumer_of_partial: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(
      name: ^inhabitant_edge,
      target: anchor_partial_bounded_lattice_instance
    )
  ],
  occurrence_id: SyntheticOccurrence
}

data anchor_module_with_partial_only: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(
      name: ^anchor_partial_decl_sym,
      target: anchor_partial_bounded_lattice_instance
    )
  ],
  occurrence_id: SyntheticOccurrence
}

data anchor_module_with_partial_and_consumer: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(
      name: ^anchor_partial_decl_sym,
      target: anchor_partial_bounded_lattice_instance
    ),
    anchor_named_edge(
      name: ^anchor_consumer_decl_sym,
      target: anchor_consumer_of_partial
    )
  ],
  occurrence_id: SyntheticOccurrence
}

data anchor_non_bl_node_is_not_complete_variant: Bool = match bounded_lattice_instance_completeness(instance: anchor_atom_node(s: ^anchor_top_sym)) {
  NotBoundedLatticeInstance => true
  BoundedLatticeComplete => false
  BoundedLatticePartial { missing: _ } => false
}

data anchor_complete_bounded_lattice_completeness_ok: Bool = match bounded_lattice_instance_completeness(instance: anchor_complete_bounded_lattice_instance) {
  BoundedLatticeComplete => true
  _ => false
}

data anchor_partial_bounded_lattice_missing_meet: Bool = match bounded_lattice_instance_completeness(instance: anchor_partial_bounded_lattice_instance) {
  BoundedLatticePartial { missing: MissingMeet } => true
  _ => false
}

data anchor_partial_missing_lattice_field: Bool = match bounded_lattice_instance_completeness(instance: anchor_partial_missing_lattice_field_instance) {
  BoundedLatticePartial { missing: MissingLatticeField } => true
  _ => false
}

data anchor_bounded_lattice_completeness_classifies_instances: Bool = anchor_complete_bounded_lattice_completeness_ok && anchor_partial_bounded_lattice_missing_meet && anchor_partial_missing_lattice_field

data anchor_partials_collected_from_module: Bool = length(
  xs: partial_bounded_lattice_instances_in_tree(tree: anchor_module_with_partial_and_consumer)
) == 1

data anchor_partials_collected_from_partial_only_module: Bool = length(
  xs: partial_bounded_lattice_instances_in_tree(tree: anchor_module_with_partial_only)
) == 1

data anchor_module_partial_only_consumer_gate_accepts: Bool = match infer_bounded_lattice_consumer_gate(
  consumer: anchor_module_with_partial_only,
  partials: [anchor_partial_bounded_lattice_instance]
) {
  Accepted { value: _, diagnostics: _ } => true
  Rejected { diagnostics: _ } => false
}

data anchor_instance_gate_rejects_partial: Outcome<Node> = infer_bounded_lattice_instance_gate(instance: anchor_partial_bounded_lattice_instance)

data anchor_instance_gate_accepts_complete: Outcome<Node> = infer_bounded_lattice_instance_gate(instance: anchor_complete_bounded_lattice_instance)

data anchor_consumer_gate_rejects_partial_reference: Outcome<Node> = infer_bounded_lattice_consumer_gate(
  consumer: anchor_consumer_of_partial,
  partials: [anchor_partial_bounded_lattice_instance]
)

data anchor_infer_rejects_consumer_tree: Outcome<InferredTree> = infer(tree: anchor_module_with_partial_and_consumer)

fn anchor_infer_consumer_tree_is_rejected() -> Bool {
  match anchor_infer_rejects_consumer_tree {
    Rejected { diagnostics: _ } => true
    _ => false
  }
}

data anchor_infer_consumer_tree_rejects: Bool = anchor_infer_consumer_tree_is_rejected()
fn sg6_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg6_pass_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg6_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg6_fail_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg6_claim_input(ok: Bool) -> Node {
  if ok {
    sg6_pass_node()
  } else {
    sg6_fail_node()
  }
}

fn sg6_missing_meet_consumer_infer_rejects() -> Bool {
  anchor_infer_consumer_tree_rejects
    && anchor_partial_bounded_lattice_missing_meet
    && anchor_bounded_lattice_completeness_classifies_instances
}

data claim_sg6_bounded_lattice_missing_meet_infer_rejects: TestClaim = CompilesClaim {
  label: "manual/sg6: BoundedLattice missing meet rejects at infer consumer (not emit stub)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg6_claim_input(ok: sg6_missing_meet_consumer_infer_rejects()),
  expected_value: sg6_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
