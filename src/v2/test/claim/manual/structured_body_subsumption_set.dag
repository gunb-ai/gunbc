module v2.test.manual.structured_body_subsumption_set


fn subsumption_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^subsumption_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^subsumption_fail } },
      children: []
    )
  }
}

fn int_pair_arrow_signature() -> Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: dag_pick_arrow_domain_conj_node() },
      v2.std.node.Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_type_int) },
      v2.std.node.Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_type_int) }
    ]
  )
}

fn subsumes(structured_body: Node, table_target: Node) -> Bool {
  match produce_arrow_with_structured_body(
    signature: int_pair_arrow_signature(),
    structured_body: structured_body
  ) {
    Accepted { value: arrow_with_body, diagnostics: _ } => arrow_with_body == table_target
    Rejected { diagnostics: _ } => false
  }
}

fn subsumption_pick() -> Bool {
  subsumes(structured_body: dag_pick_if_body_node(), table_target: dag_pick_arrow_with_body_node())
}

fn subsumption_loop() -> Bool {
  subsumes(structured_body: dag_loop_body_node(), table_target: dag_loop_arrow_with_body_node())
}

fn subsumption_bind() -> Bool {
  subsumes(structured_body: dag_bind_let_body_node(), table_target: dag_bind_arrow_with_body_node())
}

data claim_subsumption_pick: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/subsumption-set: dispatch surface subsumes the pick_if flat-index table (byte-identical Arrow)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: subsumption_bool_node(pass: subsumption_pick()),
  rhs: subsumption_bool_node(pass: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_subsumption_loop: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/subsumption-set: dispatch surface subsumes the loop flat-index table (byte-identical Arrow)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: subsumption_bool_node(pass: subsumption_loop()),
  rhs: subsumption_bool_node(pass: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_subsumption_bind: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/subsumption-set: dispatch surface subsumes the bind flat-index table (byte-identical Arrow)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: subsumption_bool_node(pass: subsumption_bind()),
  rhs: subsumption_bool_node(pass: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
