module v2.test.claim.manual.annotation_gap_v1_v2_agreement_probe_pair

import std.types { String }
import std.algebra { string_contains }
import v2.test.claim.manual.annotation_gap_v1_v2_agreement {
  AgreementControlRung, ManualUngated, GatedRow, FloorExecuted,
  agreement_control_module_name, agreement_control_entry_fn, agreement_control_rung
}
import v2.workflow.required_floor { required_gate_admits }

// THE TWO CLAIMS THAT REACH OUTSIDE THIS FILE, and nothing else. This module used to carry its own receipt:
// the kind of probe, the ref the broken tree is durable on, the two commits where the control was observed
// failing and passing, the date, the roster arm it removed, the three source roots and the run-log pointers --
// and the only reader of all of it was a claim in this same file running `string_contains` over those same
// strings. Data that no consumer outside its own file reads cannot refuse anything: it is self-certification
// with extra steps, and it makes the module look like it is checking something when it is checking its own
// transcription (gunbc.design_argument::consumption, "a witness asserting existence rather than exercising
// behavior"; gunbc.design_argument::source_annotations, a `String` declaration whose only purpose is
// commentary is misplaced or dead data). Every one of those carriers is gone, along with the well-formedness
// claim that read them.
//
// WHAT REMAINS, and why these two survive the deletion: each one compares something published HERE against
// something computed ELSEWHERE, so an edit on the other side can turn it red.
//   * `probe_pair_witness_identity_agrees_with_the_control` -- the witness module and entry fn this pair was
//     executed against are checked against the CONTROL'S OWN published carriers, imported from the control
//     module. Renaming the module or its entry fn turns this red instead of leaving a green receipt about a
//     file that no longer exists.
//   * `probe_pair_rung_agrees_with_the_floors_own_admission` -- the control's declared rung is matched against
//     `required_gate_admits`, which the floor computes from its own two selector rosters. Enrolling this
//     control without restating its rung, or raising the rung while no roster names it, turns this red. That
//     is the only way a rung statement earns more than its author's word.
//
// WHERE THE EXECUTIONS ARE, since they are deliberately NOT stored here: no predicate in this language
// observes a process or a filesystem, so a Bool or a commit-sha string beside a run certifies nothing about
// it. The raw PASS/FAIL lines, each command's real exit status, the exact argv, the binary's sha256 and the
// tree sha it ran on are recorded in the pull-request run log; the deliberately-broken tree (the roster arm
// of `v2.compiler.parse` `parse_node_is_source_region` removed, so a comment before `2 * 3` loses `2 * 3` as
// its neighbour on the v2 side while v1 still names it) is durable as a named ref in the same repository, and
// its history shows every plant, including the one whose diff against its first parent was EMPTY and which is
// therefore a parent of the break and not a break. Both are named, with their hashes, in that run log rather
// than repeated here where nothing could read them.

data annotation_gap_v1_v2_agreement_probe_witness_module: String = "v2.test.claim.manual.annotation_gap_v1_v2_agreement"

data annotation_gap_v1_v2_agreement_probe_witness_fn: String = "v1_and_v2_agree_on_neighbour_text_holds"

// THE RECEIPT AND THE CONTROL MUST NAME THE SAME WITNESS. These two strings are a copy of what the control
// publishes, and a copy that drifts is a receipt for a run of some other file -- so they are checked against
// the control's OWN imported carriers rather than against prose. The two `string_contains` conjuncts refuse a
// carrier that was emptied on both sides at once, which equality alone would pass.
test fn probe_pair_witness_identity_agrees_with_the_control() -> Bool {
  annotation_gap_v1_v2_agreement_probe_witness_module == agreement_control_module_name
    && annotation_gap_v1_v2_agreement_probe_witness_fn == agreement_control_entry_fn
    && string_contains(s: agreement_control_entry_fn, pattern: "v1_and_v2_agree")
    && string_contains(s: agreement_control_module_name, pattern: "annotation_gap_v1_v2_agreement")
}

// THE RUNG IS CHECKED AGAINST THE GATE'S OWN DECISION, NOT ASSERTED BESIDE IT. `agreement_control_rung` is
// published by the control; the admission decision is `required_gate_admits`, computed by the floor from its
// own two selector rosters. All three arms consult the floor, so the claim cannot be satisfied by the rung's
// own value. ManualUngated is therefore not a confession filed here for readers to trust; it is a claim that
// the floor admits this module under NEITHER selector kind, and a family row that later swept this path in
// would fail it too.
test fn probe_pair_rung_agrees_with_the_floors_own_admission() -> Bool {
  match agreement_control_rung {
    ManualUngated => !required_gate_admits(module_path: agreement_control_module_name)
    GatedRow => required_gate_admits(module_path: agreement_control_module_name)
    FloorExecuted => required_gate_admits(module_path: agreement_control_module_name)
  }
}
