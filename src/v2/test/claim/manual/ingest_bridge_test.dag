module v2.test.manual.ingest_bridge

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.text { string_is_empty }
import std.algebra { Cons, Empty }
import v2.compiler.ingest {
  cross_language_compile,
  parse_tree_to_emitted_node,
  parse_tree_to_target_model_bridge
}
import v2.compiler.parse {
  grammar_validate_for_parse,
  parse_production,
}
import v2.std.grammar {
  StampClass,
  StampBinding,
  GrammarProduction,
  GrammarRoot,
  Terminal,
  grammar_concrete_fixed_token_node,
  grammar_empty_sync_tokens,
  grammar_relation_tokens_node
}
import v2.extdeps.languages.dag {
  dag_binding_spellings,
  dag_declared_inhabitants_root,
  dag_fidelity_quotient_node,
  dag_fixture_emitted_add_fn,
  dag_selection_policy_node,
  dag_serialize_source_node,
  dag_source_text,
  dag_target_model,
  dag_lex
}
import v2.std.compilers.lexing { Token }
import v2.std.compilers.target_model {
  TargetModel, target_model_emit_transforms_empty
}
import v2.std.diagnostic { Accepted, None, Outcome, Rejected, port_locus }
import v2.std.logic { Bool }
import v2.std.node {
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  UnifiedTestClaim,
  manual_claim_anchor
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.effects { atom_node }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn ingest_fixture_token() -> Token {
  Token {
    class: ^ingest_fixture_tok,
    lexeme: Empty,
    file: ^ingest_fixture_file,
    start: 0,
    end: 1
  }
}

fn ingest_fixture_root() -> GrammarRoot {
  GrammarRoot {
    start: ^ingest_fixture_start,
    productions: Cons {
      head: GrammarProduction {
        name: ^ingest_fixture_start,
        expression: Terminal { token_class: ^ingest_fixture_tok, stamp: StampClass },
        emitted: dag_fixture_emitted_add_fn
      },
      tail: Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn ingest_parse() -> Outcome<Node> {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: ingest_fixture_root(), at: at) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: validated, diagnostics: _ } =>
      match parse_production(
        tokens: Cons { head: ingest_fixture_token(), tail: Empty },
        validated: validated,
        production_name: ^ingest_fixture_start
      ) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: artifact, diagnostics: _ } =>
          Accepted { value: artifact.tree, diagnostics: None }
      }
  }
}

fn ingest_fixture_row_node(emitted: Node, spine_class: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^grammar_relation_field_emitted }, target: emitted },
      Edge {
        label: Named { name: ^grammar_relation_field_tokens },
        target: grammar_relation_tokens_node(
          tokens: Cons { head: spine_class, tail: Empty },
          token_to_node: grammar_concrete_fixed_token_node
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ingest_fixture_bundle_with_rules(rules: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^target_model_edge_selection_policy }, target: dag_selection_policy_node() },
      Edge { label: Named { name: ^target_model_edge_declared_inhabitants }, target: dag_declared_inhabitants_root() },
      Edge { label: Named { name: ^target_model_edge_translation_rules }, target: rules },
      Edge { label: Named { name: ^target_model_edge_serialize_source }, target: dag_serialize_source_node() },
      Edge { label: Named { name: ^target_model_edge_fidelity_quotient }, target: dag_fidelity_quotient_node() }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ingest_fixture_model_from_bundle(bundle: Node) -> TargetModel {
  TargetModel {
    bundle: bundle,
    lex: dag_lex(),
    binding_spellings: dag_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: dag_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn ingest_fixture_model(emitted: Node, spine_class: Symbol) -> TargetModel {
  let rules = Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^ingest_fixture_rule }, target: ingest_fixture_row_node(emitted: emitted, spine_class: spine_class) }
    ],
    occurrence_id: SyntheticOccurrence
  }
  ingest_fixture_model_from_bundle(bundle: ingest_fixture_bundle_with_rules(rules: rules))
}

fn ingest_fixture_model_ambiguous(emitted: Node, spine_class: Symbol) -> TargetModel {
  let rules = Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^ingest_fixture_rule }, target: ingest_fixture_row_node(emitted: emitted, spine_class: spine_class) },
      Edge { label: Named { name: ^ingest_fixture_rule_alt }, target: ingest_fixture_row_node(emitted: emitted, spine_class: spine_class) }
    ],
    occurrence_id: SyntheticOccurrence
  }
  ingest_fixture_model_from_bundle(bundle: ingest_fixture_bundle_with_rules(rules: rules))
}

test fn ingest_recovers_emitted_holds() -> Bool {
  match ingest_parse() {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(
        parse_tree: tree,
        source_model: ingest_fixture_model(emitted: dag_fixture_emitted_add_fn, spine_class: ^ingest_fixture_tok)
      ) {
        Accepted { value: recovered, diagnostics: _ } =>
          recovered == dag_fixture_emitted_add_fn
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingest_bridge_to_canonical_holds() -> Bool {
  match ingest_parse() {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_target_model_bridge(
        parse_tree: tree,
        source_model: ingest_fixture_model(emitted: dag_fixture_emitted_add_fn, spine_class: ^ingest_fixture_tok)
      ) {
        Accepted { value: core, diagnostics: _ } =>
          core == dag_fixture_emitted_add_fn
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingest_fails_closed_off_frontier_holds() -> Bool {
  match ingest_parse() {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(
        parse_tree: tree,
        source_model: ingest_fixture_model(emitted: dag_fixture_emitted_add_fn, spine_class: ^ingest_fixture_other_tok)
      ) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingest_fails_closed_ambiguous_holds() -> Bool {
  match ingest_parse() {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(
        parse_tree: tree,
        source_model: ingest_fixture_model_ambiguous(emitted: dag_fixture_emitted_add_fn, spine_class: ^ingest_fixture_tok)
      ) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

fn ingest_unstamped_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

test fn ingest_fails_closed_on_unstamped_holds() -> Bool {
  match parse_tree_to_emitted_node(
    parse_tree: ingest_unstamped_node(),
    source_model: ingest_fixture_model(emitted: dag_fixture_emitted_add_fn, spine_class: ^ingest_fixture_tok)
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn ingest_cross_language_compile_holds() -> Bool {
  match ingest_parse() {
    Accepted { value: tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: tree,
        source_model: ingest_fixture_model(emitted: dag_fixture_emitted_add_fn, spine_class: ^ingest_fixture_tok),
        target_model: dag_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } =>
          string_is_empty(s: source.carried) == false
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn ingest_bridge_realized() -> Bool {
  ingest_recovers_emitted_holds()
    && ingest_bridge_to_canonical_holds()
    && ingest_fails_closed_off_frontier_holds()
    && ingest_fails_closed_ambiguous_holds()
    && ingest_fails_closed_on_unstamped_holds()
    && ingest_cross_language_compile_holds()
}

fn ingest_bridge_realized_input(ok: Bool) -> Symbol {
  if ok { ^ingest_bridge_realized } else { ^ingest_bridge_not_realized }
}

data claim_ingest_bridge_module_compiles: TestClaim = CompilesClaim {
  label: "manual/ingest_bridge: forward interpreter bridge claim compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_node(s: ^ingest_fixture_start),
  expected_value: atom_node(s: ^ingest_fixture_start),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_ingest_bridge_realized: TestClaim = CompilesClaim {
  label: "manual/ingest_bridge: ParseTree frontier -> forward-selected emit-side core node -> canonical IR by execution (Option A; row-driven, fail-closed, forward-deterministic)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ingest_bridge_realized_input(ok: ingest_bridge_realized()),
  expected_value: atom_node(s: ^ingest_bridge_realized),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
