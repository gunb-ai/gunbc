module v2.test.manual.kotlin_grammar_claim


fn kotlin_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^kotlin_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^kotlin_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn kotlin_grammar_validates_fixture() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: kotlin_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn kotlin_grammar_parse_accepted() -> Bool {
  match kotlin_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn kotlin_grammar_parse_fixture() -> Outcome<v2.std.grammar.ParseTree> {
  let at = port_locus(port: ^parse_stage_locus_port)
  match tokenize(
    text: kotlin_source_text,
    file: ^kotlin_parse_fixture_file,
    rules: kotlin_lex()
  ) {
    Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar_validate_for_parse(root: kotlin_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          parse_production_tree(
            tokens: token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^kotlin_production_fn_add
          )
      }
  }
}

data claim_kotlin_grammar_validates: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "kotlin_grammar_root passes grammar_validate_for_parse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: kotlin_claim_bool_atom(b: kotlin_grammar_validates_fixture()),
  rhs: kotlin_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_kotlin_grammar_parses_tokens: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "kotlin production parse_production accepts lexer output for fun-add source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: kotlin_claim_bool_atom(b: kotlin_grammar_parse_accepted()),
  rhs: kotlin_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
