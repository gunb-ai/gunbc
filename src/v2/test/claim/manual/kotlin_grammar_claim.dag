module v2.test.manual.kotlin_grammar_claim


fn kotlin_claim_bool_atom(b: Bool) -> v2.std.node.Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^kotlin_claim_bool_true } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^kotlin_claim_bool_false } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
  }
}

fn kotlin_grammar_validates_fixture() -> Bool {
  let at = v2.std.diagnostic.port_locus(port: ^parse_stage_locus_port)
  match v2.compiler.parse.grammar_validate_for_parse(root: v2.extdeps.languages.kotlin.kotlin_grammar_root(), at: at) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn kotlin_grammar_parse_accepted() -> Bool {
  match kotlin_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn kotlin_grammar_parse_fixture() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let at = v2.std.diagnostic.port_locus(port: ^parse_stage_locus_port)
  match v2.compiler.tokenize.tokenize(
    text: v2.extdeps.languages.kotlin.kotlin_source_text,
    file: ^kotlin_parse_fixture_file,
    rules: v2.extdeps.languages.kotlin.kotlin_lex()
  ) {
    v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    v2.std.diagnostic.Accepted { value: stream, diagnostics: _ } =>
      match v2.compiler.parse.grammar_validate_for_parse(root: v2.extdeps.languages.kotlin.kotlin_grammar_root(), at: at) {
        v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
        v2.std.diagnostic.Accepted { value: validated, diagnostics: _ } =>
          v2.compiler.parse.parse_production_tree(
            tokens: v2.std.compilers.lexing.token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^kotlin_production_fn_add
          )
      }
  }
}

data claim_kotlin_grammar_validates: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "v2.extdeps.languages.kotlin.kotlin_grammar_root passes v2.compiler.parse.grammar_validate_for_parse",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: kotlin_claim_bool_atom(b: kotlin_grammar_validates_fixture()),
  rhs: kotlin_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}

data claim_kotlin_grammar_parses_tokens: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "kotlin production parse_production accepts lexer output for fun-add source",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: kotlin_claim_bool_atom(b: kotlin_grammar_parse_accepted()),
  rhs: kotlin_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}
