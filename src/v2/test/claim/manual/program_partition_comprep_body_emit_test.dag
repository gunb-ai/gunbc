module v2.test.manual.program_partition_comprep_body_emit

import v2.compiler.program_partition {
  emit_for_target,
  facts_closure_fold,
  program_segment_from_section_unavailable,
  resolve_program_partition
}
import v2.extdeps.languages.typescript {
  ts_mvp1_source_text,
  ts_mvp1_target_model
}
import v2.std.algebra { Empty, any, fold_list, list_snoc_item }
import v2.std.collection { List }
import v2.std.diagnostic {
  Accepted,
  None,
  Rejected
}
import v2.std.logic { Bool }
import v2.std.node { Node, node_subtree_nodes }
import v2.std.node_query { find_arrow_body_child }
import v2.std.program_segment {
  partition_boundary_ambient_context,
  partition_boundary_fail_closed,
  program_segment_subtree_root,
  program_segment_whole_program
}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.test.manual.comprep_add_body_emit_typescript {
  comprep_ts_emit_from_producer_tree,
  comprep_ts_producer_inferred_tree
}

fn program_partition_node_list_member_seen(seen: List<Node>, needle: Node) -> Bool {
  any(xs: seen, predicate: fn(member) { member == needle })
}

fn program_partition_node_list_is_duplicate_free(xs: List<Node>) -> Bool {
  match fold_list(
    xs: xs,
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, member) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: seen, diagnostics: _ } =>
          if program_partition_node_list_member_seen(seen: seen, needle: member) {
            Rejected { diagnostics: None }
          } else {
            Accepted {
              value: list_snoc_item(xs: seen, item: member),
              diagnostics: None
            }
          }
      }
    }
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn program_partition_body_canonical_closure_enumeration_is_duplicate_free() -> Bool {
  match comprep_ts_producer_inferred_tree() {
    Accepted { value: program, diagnostics: _ } =>
      match find_arrow_body_child(root: program.root) {
        Accepted { value: body, diagnostics: _ } =>
          program_partition_node_list_is_duplicate_free(
            xs: node_subtree_nodes(root: body)
          )
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn program_partition_body_fail_closed_facts_closure_fold_accepts() -> Bool {
  match comprep_ts_producer_inferred_tree() {
    Accepted { value: program, diagnostics: _ } =>
      match find_arrow_body_child(root: program.root) {
        Accepted { value: body, diagnostics: _ } =>
          match resolve_program_partition(
            program: program,
            segment: program_segment_subtree_root(root: body),
            boundary: partition_boundary_fail_closed()
          ) {
            Accepted { value: partition, diagnostics: _ } =>
              match facts_closure_fold(partition: partition) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn program_partition_body_emit_accepts_and_differs_from_whole() -> Bool {
  match comprep_ts_producer_inferred_tree() {
    Accepted { value: program, diagnostics: _ } =>
      match find_arrow_body_child(root: program.root) {
        Accepted { value: body, diagnostics: _ } =>
          match comprep_ts_emit_from_producer_tree(target: ts_mvp1_target_model()) {
            Accepted { value: whole_source, diagnostics: whole_d } =>
              match emit_for_target(
                program: program,
                segment: program_segment_subtree_root(root: body),
                target: ts_mvp1_target_model(),
                boundary: partition_boundary_ambient_context()
              ) {
                Accepted { value: body_source, diagnostics: body_d } =>
                  (body_d == None)
                    && (whole_d == None)
                    && (body_source != whole_source)
                    && (whole_source.carried == ts_mvp1_source_text)
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn program_partition_whole_program_emit_matches_direct() -> Bool {
  match comprep_ts_producer_inferred_tree() {
    Accepted { value: program, diagnostics: _ } =>
      match comprep_ts_emit_from_producer_tree(target: ts_mvp1_target_model()) {
        Accepted { value: direct_source, diagnostics: direct_d } =>
          match emit_for_target(
            program: program,
            segment: program_segment_whole_program(),
            target: ts_mvp1_target_model(),
            boundary: partition_boundary_ambient_context()
          ) {
            Accepted { value: partition_source, diagnostics: partition_d } =>
              (direct_d == None)
                && (partition_d == None)
                && (direct_source == partition_source)
                && (direct_source.carried == ts_mvp1_source_text)
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn program_partition_section_adapter_unavailable_rejects() -> Bool {
  match program_segment_from_section_unavailable() {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
