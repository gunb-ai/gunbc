module v2.test.manual.go_add_emit_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data go_add_forbidden_authority_source_text: String = "authority_source_text_fallback_forbidden"

data go_add_int_inhabitant: v2.std.node.Node = go_int_inhabitant_node()

data go_add_emitted_root: v2.std.node.Node = go_emitted_add_fn_node()

data go_add_int_facts_node: v2.std.node.Node = go_integer_facts_node(facts: go_facts_int)

data go_add_int_width_node: v2.std.node.Node = go_signed_int_width_node(width: SignedPlatformInt)

data go_add_int_kind_signed_node: v2.std.node.Node = go_int_kind_node(kind: v2.extdeps.languages.go.Signed)

data go_add_int_overflow_node: v2.std.node.Node = go_overflow_node(
  overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow
)

data go_add_target_model: v2.std.compilers.target_model.TargetModel = go_target_model()

data go_add_poisoned_authority_target_model: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: go_target_model_node(),
  lex: go_lex(),
  binding_spellings: go_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: go_add_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data go_add_empty_translation_rules_bundle: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data go_add_missing_translation_rules_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: go_add_empty_translation_rules_bundle,
  lex: go_lex(),
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_go_add_serialize_rejects_missing_translation_rules() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  target_serialize_source_from_model(
    target: go_add_missing_translation_rules_target,
    emitted: go_add_emitted_root
  )
}

data go_add_serialize_reject_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_go_add_serialize_rejects_missing_translation_rules()

test fn go_add_serialize_reject_receipt_holds() -> Bool {
  match go_add_serialize_reject_receipt {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d != v2.std.diagnostic.None
  }
}


fn go_add_canonical_grounding(
  node: v2.std.node.Node,
  algebra: v2.std.node.Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn go_add_canonical_grounding_for(node: v2.std.node.Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == go_add_emitted_root {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == go_add_int_inhabitant {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_inhabitant_int) {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_inhabitant
      )
    }
  } else if node == go_add_int_facts_node {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_surface_spelling_int) {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_add_int_width_node {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_tag_signed_platform_int) {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_width_node
      )
    }
  } else if node == go_add_int_kind_signed_node {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_tag_signed) {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_kind_signed_node
      )
    }
  } else if node == go_add_int_overflow_node {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_tag_overflow_signed_truncates) {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_overflow_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_repr_twos_complement_integer) {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_std_projection_int) {
    v2.std.witness.Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^go_add_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn go_add_inferred_facts_for(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match go_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn go_add_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  go_add_inferred_facts_for(node: key)
}

data go_add_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: go_add_emitted_root,
  facts: std.types.Map {
    lookup: go_add_facts_lookup
  }
}

fn anchor_go_add_emit_accepts() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.emit.emit(tree: go_add_inferred_tree, target: go_add_target_model)
}

fn anchor_go_add_compile_inferred_accepts() -> v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> {
  compile_inferred(
    inferred: go_add_inferred_tree,
    mode: v2.compiler.compile.TranslateTo { target: go_add_poisoned_authority_target_model }
  )
}

data go_add_emit_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_go_add_emit_accepts()

test fn go_add_emit_add_fn_accepts_holds() -> Bool {
  match go_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == go_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

data go_add_compile_inferred_receipt: v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> = anchor_go_add_compile_inferred_accepts()

test fn go_add_compile_inferred_receipt_holds() -> Bool {
  match go_add_compile_inferred_receipt {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}





