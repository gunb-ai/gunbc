module v2.test.manual.go_add_emit_translate

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.compiler.emit { emit }
import v2.compiler.compile {
  CompileOutput,
  TranslateResult,
  TranslateTo,
  compile_inferred
}
import v2.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  run_test_claim_assert,
  test_claim_cache_receipt,
  test_claim_typed_input_node
}
import v2.compiler.translate {
  target_serialize_source_from_model,
  translate,
}
import v2.extdeps.languages.go {
  Signed,
  SignedPlatformInt,
  SignedTypedIntegerTruncatesSilentlyOnOverflow,
  go_facts_int,
  go_inhabitant_atom,
  go_int_inhabitant_node,
  go_int_kind_node,
  go_integer_facts_node,
  go_binding_spellings,
  go_source_text,
  go_target_model,
  go_target_model_node,
  go_named_edge,
  go_overflow_node,
  go_signed_int_width_node,
  go_lex
}
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.compilers.target_model { TargetModel, target_model_emit_transforms_empty }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.test.manual.infer_ground_add {
  infer_receipt_context
}
import v2.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v2.std.collection {
  Map,
  empty_map
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.node {
  Arrow,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data go_add_forbidden_authority_source_text: String = "authority_source_text_fallback_forbidden"

data go_add_int_inhabitant: Node = go_int_inhabitant_node()

data go_add_emitted_root: Node = go_emitted_add_fn_node()

data go_add_int_facts_node: Node = go_integer_facts_node(facts: go_facts_int)

data go_add_int_width_node: Node = go_signed_int_width_node(width: SignedPlatformInt)

data go_add_int_kind_signed_node: Node = go_int_kind_node(kind: Signed)

data go_add_int_overflow_node: Node = go_overflow_node(
  overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow
)

data go_add_target_model: TargetModel = go_target_model()

data go_add_poisoned_authority_target_model: TargetModel = TargetModel {
  bundle: go_target_model_node(),
  lex: go_lex(),
  binding_spellings: go_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: go_add_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data go_add_empty_translation_rules_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data go_add_missing_translation_rules_target: TargetModel = TargetModel {
  bundle: go_add_empty_translation_rules_bundle,
  lex: go_lex(),
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_go_add_serialize_rejects_missing_translation_rules() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: go_add_missing_translation_rules_target,
    emitted: go_add_emitted_root
  )
}

data go_add_serialize_reject_receipt: Outcome<Medium<String>> = anchor_go_add_serialize_rejects_missing_translation_rules()

test fn go_add_serialize_reject_receipt_holds() -> Bool {
  match go_add_serialize_reject_receipt {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d != None
  }
}


fn go_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn go_add_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == go_add_emitted_root {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == go_add_int_inhabitant {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_inhabitant_int) {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_inhabitant
      )
    }
  } else if node == go_add_int_facts_node {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_surface_spelling_int) {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_add_int_width_node {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_tag_signed_platform_int) {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_width_node
      )
    }
  } else if node == go_add_int_kind_signed_node {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_tag_signed) {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_kind_signed_node
      )
    }
  } else if node == go_add_int_overflow_node {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_tag_overflow_signed_truncates) {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_overflow_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_repr_twos_complement_integer) {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else if node == go_inhabitant_atom(id: ^go_std_projection_int) {
    Holds {
      value: go_add_canonical_grounding(
        node: node,
        algebra: go_add_int_facts_node
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^go_add_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn go_add_inferred_facts_for(node: Node) -> Optional<InferredFacts> {
  match go_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            ))
      }
  }
}

fn go_add_facts_lookup(key: Node) -> Optional<InferredFacts> {
  go_add_inferred_facts_for(node: key)
}

data go_add_inferred_tree: InferredTree = InferredTree {
  root: go_add_emitted_root,
  facts: Map {
    lookup: go_add_facts_lookup
  }
}

fn anchor_go_add_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: go_add_inferred_tree, target: go_add_target_model)
}

fn anchor_go_add_compile_inferred_accepts() -> Outcome<CompileOutput> {
  compile_inferred(
    inferred: go_add_inferred_tree,
    mode: TranslateTo { target: go_add_poisoned_authority_target_model }
  )
}

data go_add_emit_receipt: Outcome<Medium<String>> = anchor_go_add_emit_accepts()

test fn go_add_emit_add_fn_accepts_holds() -> Bool {
  match go_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == go_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

data go_add_compile_inferred_receipt: Outcome<CompileOutput> = anchor_go_add_compile_inferred_accepts()

test fn go_add_compile_inferred_receipt_holds() -> Bool {
  match go_add_compile_inferred_receipt {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}





