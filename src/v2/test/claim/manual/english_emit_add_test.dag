module v2.test.manual.english_emit_add


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data english_emit_add_emitted_root: Node = english_add_fn_emitted_node()

data english_emit_add_target_model: v2.std.compilers.target_model.TargetModel = english_add_fn_target_model()

data english_emit_add_noun_inhabitant: Node = english_noun_inhabitant_node()

data english_emit_add_noun_facts_node: Node = english_noun_facts_node()

fn english_emit_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn english_emit_add_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == english_emit_add_emitted_root {
    v2.std.witness.Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == english_emit_add_noun_inhabitant {
    v2.std.witness.Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: english_emit_add_noun_facts_node
      )
    }
  } else if node == english_inhabitant_atom(id: ^english_inhabitant_noun) {
    v2.std.witness.Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: english_emit_add_noun_inhabitant
      )
    }
  } else if node == english_emit_add_noun_facts_node {
    v2.std.witness.Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == english_inhabitant_atom(id: ^english_surface_spelling_noun) {
    v2.std.witness.Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: english_emit_add_noun_facts_node
      )
    }
  } else if node == english_inhabitant_atom(id: ^english_category_formal_noun_phrase) {
    v2.std.witness.Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: english_emit_add_noun_facts_node
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^english_emit_add_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn english_emit_add_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match english_emit_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn english_emit_add_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  english_emit_add_inferred_facts_for(node: key)
}

data english_emit_add_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: english_emit_add_emitted_root,
  facts: std.types.Map {
    lookup: english_emit_add_facts_lookup
  }
}

fn anchor_english_emit_add_accepts() -> Outcome<Medium<String>> {
  emit(tree: english_emit_add_inferred_tree, target: english_emit_add_target_model)
}

data english_emit_add_receipt: Outcome<Medium<String>> = anchor_english_emit_add_accepts()

test fn english_emit_add_prose_holds() -> Bool {
  match english_emit_add_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == english_add_fn_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

fn english_emit_add_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: english_emit_add_target_model,
    emitted: english_emit_add_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match english_emit_add_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn english_emit_add_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: english_emit_add_target_model,
    emitted: english_emit_add_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}

fn english_emit_add_ingest_parse(source: Medium<String>) -> Outcome<v2.std.grammar.ParseTree> {
  match tokenize(
    text: source.carried,
    file: ^english_emit_add_round_trip_fixture_file,
    rules: english_lex()
  ) {
    Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: english_add_fn_paragraph_grammar())
  }
}

fn english_emit_add_identity_edge_matches(e: v2.std.node.Edge, expected: Node) -> Bool {
  match e.label {
    Named { name: n } =>
      (n == ^grammar_production_identity_node_projection) && (e.target == expected)
    Positional => false
  }
}

fn english_emit_add_parse_identity_matches(root: Node, expected: Node) -> Bool {
  fold_list(
    xs: root.children,
    empty: false,
    cons: fn(acc, e) {
      acc || english_emit_add_identity_edge_matches(e: e, expected: expected)
    }
  )
}

test fn english_emit_add_ingest_round_trip_holds() -> Bool {
  let serialize_ok = english_emit_add_matches_serialize_holds()
  let grammar_ok = english_emit_add_grammar_inverse_holds()
  let ingest_ok = match english_emit_add_receipt {
    Rejected { diagnostics: _ } => false
    Accepted { value: source, diagnostics: _ } =>
      match english_emit_add_ingest_parse(source: source) {
        Accepted { value: tree, diagnostics: d } =>
          english_emit_add_parse_identity_matches(
            root: tree,
            expected: english_emit_add_emitted_root
          ) && (d == v2.std.diagnostic.None)
        Rejected { diagnostics: _ } => false
      }
  }
  serialize_ok && grammar_ok && ingest_ok
}
