module v2.test.manual.english_emit_add

import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.compiler.parse { parse }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.tokenize { tokenize }
import v2.compiler.translate {
  grammar_inverse_source_validated,
  target_serialize_source_from_model
}
import v2.extdeps.languages.english {
  english_add_fn_emitted_node,
  english_add_fn_paragraph_grammar,
  english_add_fn_source_text,
  english_add_fn_target_model,
  english_inhabitant_atom,
  english_noun_facts_node,
  english_noun_inhabitant_node,
  english_lex
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.std.algebra { fold_list }
import v2.std.cardinality { termination_proof_witness_for_node }
import v2.std.collection {
  Map
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.grammar { ParseTree }
import v2.std.logic { Bool }
import v2.std.node { Edge, Named, Node, Positional }
import v2.std.compilers.target_model { TargetModel }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data english_emit_add_emitted_root: Node = english_add_fn_emitted_node()

data english_emit_add_target_model: TargetModel = english_add_fn_target_model()

data english_emit_add_noun_inhabitant: Node = english_noun_inhabitant_node()

data english_emit_add_noun_facts_node: Node = english_noun_facts_node()

fn english_emit_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn english_emit_add_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == english_emit_add_emitted_root {
    Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == english_emit_add_noun_inhabitant {
    Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: english_emit_add_noun_facts_node
      )
    }
  } else if node == english_inhabitant_atom(id: ^english_inhabitant_noun) {
    Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: english_emit_add_noun_inhabitant
      )
    }
  } else if node == english_emit_add_noun_facts_node {
    Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == english_inhabitant_atom(id: ^english_surface_spelling_noun) {
    Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: english_emit_add_noun_facts_node
      )
    }
  } else if node == english_inhabitant_atom(id: ^english_category_formal_noun_phrase) {
    Holds {
      value: english_emit_add_canonical_grounding(
        node: node,
        algebra: english_emit_add_noun_facts_node
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^english_emit_add_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn english_emit_add_inferred_facts_for(node: Node) -> Optional<InferredFacts> {
  match english_emit_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            ))
      }
  }
}

fn english_emit_add_facts_lookup(key: Node) -> Optional<InferredFacts> {
  english_emit_add_inferred_facts_for(node: key)
}

data english_emit_add_inferred_tree: InferredTree = InferredTree {
  root: english_emit_add_emitted_root,
  facts: Map {
    lookup: english_emit_add_facts_lookup
  }
}

fn anchor_english_emit_add_accepts() -> Outcome<Medium<String>> {
  emit(tree: english_emit_add_inferred_tree, target: english_emit_add_target_model)
}

data english_emit_add_receipt: Outcome<Medium<String>> = anchor_english_emit_add_accepts()

test fn english_emit_add_prose_holds() -> Bool {
  match english_emit_add_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == english_add_fn_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn english_emit_add_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: english_emit_add_target_model,
    emitted: english_emit_add_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match english_emit_add_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn english_emit_add_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: english_emit_add_target_model,
    emitted: english_emit_add_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn english_emit_add_ingest_parse(source: Medium<String>) -> Outcome<ParseTree> {
  match tokenize(
    text: source.carried,
    file: ^english_emit_add_round_trip_fixture_file,
    rules: english_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: english_add_fn_paragraph_grammar())
  }
}

fn english_emit_add_identity_edge_matches(e: Edge, expected: Node) -> Bool {
  match e.label {
    Named { name: n } =>
      (n == ^grammar_production_identity_node_projection) && (e.target == expected)
    Positional => false
  }
}

fn english_emit_add_parse_identity_matches(root: Node, expected: Node) -> Bool {
  fold_list(
    xs: root.children,
    empty: false,
    cons: fn(acc, e) {
      acc || english_emit_add_identity_edge_matches(e: e, expected: expected)
    }
  )
}

fn english_emit_add_ingest_round_trip_holds() -> Bool {
  match english_emit_add_receipt {
    Rejected { diagnostics: _ } => false
    Accepted { value: source, diagnostics: _ } =>
      match english_emit_add_ingest_parse(source: source) {
        Accepted { value: tree, diagnostics: d } =>
          english_emit_add_parse_identity_matches(
            root: tree,
            expected: english_emit_add_emitted_root
          ) && (d == None)
        Rejected { diagnostics: _ } => false
      }
  }
}

test fn english_emit_add_emit_ingest_round_trip_holds() -> Bool {
  english_emit_add_prose_holds()
    && english_emit_add_matches_serialize_holds()
    && english_emit_add_grammar_inverse_holds()
    && english_emit_add_ingest_round_trip_holds()
}
