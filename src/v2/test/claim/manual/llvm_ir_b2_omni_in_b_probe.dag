module v2.test.manual.llvm_ir_b2_omni_in_b_probe


fn llvm_probe_atom(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

data llvm_probe_type: v2.extdeps.languages.llvm_ir.LlvmType = v2.extdeps.languages.llvm_ir.IntegerType { bits: v2.std.cardinality.NonZeroNat { prev: Zero } }

data llvm_probe_left_incoming: v2.extdeps.languages.llvm_ir.PhiIncoming = v2.extdeps.languages.llvm_ir.PhiIncoming {
  value: v2.extdeps.languages.llvm_ir.ConstantOperand { constant: v2.extdeps.languages.llvm_ir.IntConstant { ty: llvm_probe_type, value: 0 } },
  block: ^llvm_probe_left_symbol
}

data llvm_probe_right_incoming: v2.extdeps.languages.llvm_ir.PhiIncoming = v2.extdeps.languages.llvm_ir.PhiIncoming {
  value: v2.extdeps.languages.llvm_ir.ConstantOperand { constant: v2.extdeps.languages.llvm_ir.IntConstant { ty: llvm_probe_type, value: 1 } },
  block: ^llvm_probe_right_symbol
}

data llvm_probe_phi: v2.extdeps.languages.llvm_ir.PhiNode = v2.extdeps.languages.llvm_ir.PhiNode {
  result: ^llvm_probe_phi_result_symbol,
  result_type: llvm_probe_type,
  incomings: [llvm_probe_left_incoming, llvm_probe_right_incoming]
}

data llvm_probe_entry_block: v2.extdeps.languages.llvm_ir.BasicBlock = v2.extdeps.languages.llvm_ir.BasicBlock {
  label: ^llvm_probe_cond_symbol,
  phis: [],
  body: [],
  terminator: v2.extdeps.languages.llvm_ir.ConditionalBr {
    condition: v2.extdeps.languages.llvm_ir.ConstantOperand { constant: v2.extdeps.languages.llvm_ir.IntConstant { ty: llvm_probe_type, value: 1 } },
    if_true: ^llvm_probe_left_symbol,
    if_false: ^llvm_probe_right_symbol
  }
}

data llvm_probe_left_block: v2.extdeps.languages.llvm_ir.BasicBlock = v2.extdeps.languages.llvm_ir.BasicBlock {
  label: ^llvm_probe_left_symbol,
  phis: [],
  body: [],
  terminator: v2.extdeps.languages.llvm_ir.UnconditionalBr { target: ^llvm_probe_merge_symbol }
}

data llvm_probe_right_block: v2.extdeps.languages.llvm_ir.BasicBlock = v2.extdeps.languages.llvm_ir.BasicBlock {
  label: ^llvm_probe_right_symbol,
  phis: [],
  body: [],
  terminator: v2.extdeps.languages.llvm_ir.UnconditionalBr { target: ^llvm_probe_merge_symbol }
}

data llvm_probe_merge_block: v2.extdeps.languages.llvm_ir.BasicBlock = v2.extdeps.languages.llvm_ir.BasicBlock {
  label: ^llvm_probe_merge_symbol,
  phis: [llvm_probe_phi],
  body: [],
  terminator: v2.extdeps.languages.llvm_ir.RetValue { value: v2.extdeps.languages.llvm_ir.LocalRef { name: ^llvm_probe_phi_result_symbol } }
}

data llvm_probe_function_body: v2.extdeps.languages.llvm_ir.FunctionBody = v2.extdeps.languages.llvm_ir.Defined {
  entry: llvm_probe_entry_block,
  rest: [llvm_probe_left_block, llvm_probe_right_block, llvm_probe_merge_block]
}

fn llvm_probe_receipt_holds() -> Bool {
  block_well_formed(b: llvm_probe_entry_block)
  && block_well_formed(b: llvm_probe_left_block)
  && block_well_formed(b: llvm_probe_right_block)
  && block_well_formed(b: llvm_probe_merge_block)
  && block_successors(t: llvm_probe_entry_block.terminator) == [^llvm_probe_left_symbol, ^llvm_probe_right_symbol]
  && block_successors(t: llvm_probe_left_block.terminator) == [^llvm_probe_merge_symbol]
  && block_successors(t: llvm_probe_right_block.terminator) == [^llvm_probe_merge_symbol]
  && llvm_probe_merge_block.phis == [llvm_probe_phi]
}

fn llvm_probe_pass_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge { label: Named { name: ^llvm_probe_result_symbol }, target: llvm_probe_atom(s: ^llvm_probe_pass_symbol) },
      v2.std.node.Edge { label: Named { name: ^llvm_probe_ssa_axis_symbol }, target: llvm_probe_atom(s: ^llvm_probe_phi_result_symbol) },
      v2.std.node.Edge { label: Named { name: ^llvm_probe_phi_axis_symbol }, target: llvm_probe_atom(s: ^llvm_probe_phi_axis_symbol) },
      v2.std.node.Edge { label: Named { name: ^llvm_probe_cfg_axis_symbol }, target: llvm_probe_atom(s: ^llvm_probe_cfg_axis_symbol) },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn llvm_probe_receipt_node() -> Node {
  if llvm_probe_receipt_holds() {
    llvm_probe_pass_node()
  } else {
    llvm_probe_atom(s: ^llvm_probe_fail_symbol)
  }
}

data llvm_probe_expected_node: Node = llvm_probe_pass_node()

data claim_llvm_ir_b2_omni_in_b_probe: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "T-4.12 llvm_ir B2-OMNI IN-B probe: SSA, phi, CFG successors present",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: llvm_probe_expected_node,
  rhs: llvm_probe_receipt_node(),
  classification: v2.std.verification.TestClassification { tier: Tier3, layer: Unit }
}
