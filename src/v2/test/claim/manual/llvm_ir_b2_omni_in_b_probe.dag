module v2.test.manual.llvm_ir_b2_omni_in_b_probe

import v2.extdeps.languages.llvm_ir {
  BasicBlock,
  ConstantOperand,
  ConditionalBr,
  Defined,
  FunctionBody,
  IntegerType,
  IntConstant,
  LlvmType,
  LocalRef,
  PhiIncoming,
  PhiNode,
  RetValue,
  UnconditionalBr,
  block_successors,
  block_well_formed
}
import v2.std.cardinality { NonZeroNat }
import std.nat { Zero }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  Unit,
  manual_claim_anchor
}

fn llvm_probe_atom(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

data llvm_probe_type: LlvmType = IntegerType { bits: NonZeroNat { prev: Zero } }

data llvm_probe_left_incoming: PhiIncoming = PhiIncoming {
  value: ConstantOperand { constant: IntConstant { ty: llvm_probe_type, value: 0 } },
  block: ^llvm_probe_left_symbol
}

data llvm_probe_right_incoming: PhiIncoming = PhiIncoming {
  value: ConstantOperand { constant: IntConstant { ty: llvm_probe_type, value: 1 } },
  block: ^llvm_probe_right_symbol
}

data llvm_probe_phi: PhiNode = PhiNode {
  result: ^llvm_probe_phi_result_symbol,
  result_type: llvm_probe_type,
  incomings: [llvm_probe_left_incoming, llvm_probe_right_incoming]
}

data llvm_probe_entry_block: BasicBlock = BasicBlock {
  label: ^llvm_probe_cond_symbol,
  phis: [],
  body: [],
  terminator: ConditionalBr {
    condition: ConstantOperand { constant: IntConstant { ty: llvm_probe_type, value: 1 } },
    if_true: ^llvm_probe_left_symbol,
    if_false: ^llvm_probe_right_symbol
  }
}

data llvm_probe_left_block: BasicBlock = BasicBlock {
  label: ^llvm_probe_left_symbol,
  phis: [],
  body: [],
  terminator: UnconditionalBr { target: ^llvm_probe_merge_symbol }
}

data llvm_probe_right_block: BasicBlock = BasicBlock {
  label: ^llvm_probe_right_symbol,
  phis: [],
  body: [],
  terminator: UnconditionalBr { target: ^llvm_probe_merge_symbol }
}

data llvm_probe_merge_block: BasicBlock = BasicBlock {
  label: ^llvm_probe_merge_symbol,
  phis: [llvm_probe_phi],
  body: [],
  terminator: RetValue { value: LocalRef { name: ^llvm_probe_phi_result_symbol } }
}

data llvm_probe_function_body: FunctionBody = Defined {
  entry: llvm_probe_entry_block,
  rest: [llvm_probe_left_block, llvm_probe_right_block, llvm_probe_merge_block]
}

fn llvm_probe_receipt_holds() -> Bool {
  block_well_formed(b: llvm_probe_entry_block)
  && block_well_formed(b: llvm_probe_left_block)
  && block_well_formed(b: llvm_probe_right_block)
  && block_well_formed(b: llvm_probe_merge_block)
  && block_successors(t: llvm_probe_entry_block.terminator) == [^llvm_probe_left_symbol, ^llvm_probe_right_symbol]
  && block_successors(t: llvm_probe_left_block.terminator) == [^llvm_probe_merge_symbol]
  && block_successors(t: llvm_probe_right_block.terminator) == [^llvm_probe_merge_symbol]
  && llvm_probe_merge_block.phis == [llvm_probe_phi]
}

fn llvm_probe_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^llvm_probe_result_symbol }, target: llvm_probe_atom(s: ^llvm_probe_pass_symbol) },
      Edge { label: Named { name: ^llvm_probe_ssa_axis_symbol }, target: llvm_probe_atom(s: ^llvm_probe_phi_result_symbol) },
      Edge { label: Named { name: ^llvm_probe_phi_axis_symbol }, target: llvm_probe_atom(s: ^llvm_probe_phi_axis_symbol) },
      Edge { label: Named { name: ^llvm_probe_cfg_axis_symbol }, target: llvm_probe_atom(s: ^llvm_probe_cfg_axis_symbol) },
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn llvm_probe_receipt_node() -> Node {
  if llvm_probe_receipt_holds() {
    llvm_probe_pass_node()
  } else {
    llvm_probe_atom(s: ^llvm_probe_fail_symbol)
  }
}

data llvm_probe_expected_node: Node = llvm_probe_pass_node()

data claim_llvm_ir_b2_omni_in_b_probe: TestClaim = EqualsClaim {
  label: "T-4.12 llvm_ir B2-OMNI IN-B probe: SSA, phi, CFG successors present",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: llvm_probe_expected_node,
  rhs: llvm_probe_receipt_node(),
  classification: TestClassification { tier: Tier3, layer: Unit }
}
