module v2.test.manual.infer_bounded_lattice_completeness_anchor

fn anchor_atom_node(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn anchor_fn_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn anchor_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn anchor_complete_lattice_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      anchor_named_edge(name: ^lattice_field_meet, target: anchor_fn_node()),
      anchor_named_edge(name: ^lattice_field_join, target: anchor_fn_node())
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn anchor_lattice_missing_meet_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      anchor_named_edge(name: ^lattice_field_join, target: anchor_fn_node())
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

data anchor_complete_bounded_lattice_instance: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    anchor_named_edge(name: ^bounded_lattice_field_lattice, target: anchor_complete_lattice_node()),
    anchor_named_edge(name: ^bounded_lattice_field_top, target: v2.test.manual.infer_bounded_lattice_completeness_anchor.anchor_atom_node(s: ^anchor_top_sym)),
    anchor_named_edge(name: ^bounded_lattice_field_bottom, target: v2.test.manual.infer_bounded_lattice_completeness_anchor.anchor_atom_node(s: ^anchor_bottom_sym))
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data anchor_partial_bounded_lattice_instance: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    anchor_named_edge(name: ^bounded_lattice_field_lattice, target: anchor_lattice_missing_meet_node()),
    anchor_named_edge(name: ^bounded_lattice_field_top, target: v2.test.manual.infer_bounded_lattice_completeness_anchor.anchor_atom_node(s: ^anchor_top_sym)),
    anchor_named_edge(name: ^bounded_lattice_field_bottom, target: v2.test.manual.infer_bounded_lattice_completeness_anchor.anchor_atom_node(s: ^anchor_bottom_sym))
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data anchor_partial_missing_lattice_field_instance: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    anchor_named_edge(name: ^bounded_lattice_field_top, target: v2.test.manual.infer_bounded_lattice_completeness_anchor.anchor_atom_node(s: ^anchor_top_sym)),
    anchor_named_edge(name: ^bounded_lattice_field_bottom, target: v2.test.manual.infer_bounded_lattice_completeness_anchor.anchor_atom_node(s: ^anchor_bottom_sym))
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data anchor_consumer_of_partial: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    anchor_named_edge(
      name: ^inhabitant_edge,
      target: anchor_partial_bounded_lattice_instance
    )
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data anchor_module_with_partial_only: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    anchor_named_edge(
      name: ^anchor_partial_decl_sym,
      target: anchor_partial_bounded_lattice_instance
    )
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data anchor_module_with_partial_and_consumer: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    anchor_named_edge(
      name: ^anchor_partial_decl_sym,
      target: anchor_partial_bounded_lattice_instance
    ),
    anchor_named_edge(
      name: ^anchor_consumer_decl_sym,
      target: anchor_consumer_of_partial
    )
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

test data anchor_non_bl_node_is_not_complete_variant: v2.std.logic.Bool = match v2.std.bounded_lattice_completeness.bounded_lattice_instance_completeness(instance: v2.test.manual.infer_bounded_lattice_completeness_anchor.anchor_atom_node(s: ^anchor_top_sym)) {
  NotBoundedLatticeInstance => true
  BoundedLatticeComplete => false
  BoundedLatticePartial { missing: _ } => false
}

data anchor_complete_bounded_lattice_completeness_ok: v2.std.logic.Bool = match v2.std.bounded_lattice_completeness.bounded_lattice_instance_completeness(instance: anchor_complete_bounded_lattice_instance) {
  BoundedLatticeComplete => true
  _ => false
}

data anchor_partial_bounded_lattice_missing_meet: v2.std.logic.Bool = match v2.std.bounded_lattice_completeness.bounded_lattice_instance_completeness(instance: anchor_partial_bounded_lattice_instance) {
  BoundedLatticePartial { missing: v2.std.algebra.MissingMeet } => true
  _ => false
}

data anchor_partial_missing_lattice_field: v2.std.logic.Bool = match v2.std.bounded_lattice_completeness.bounded_lattice_instance_completeness(instance: anchor_partial_missing_lattice_field_instance) {
  BoundedLatticePartial { missing: v2.std.algebra.MissingLatticeField } => true
  _ => false
}

data anchor_bounded_lattice_completeness_classifies_instances: v2.std.logic.Bool = anchor_complete_bounded_lattice_completeness_ok && anchor_partial_bounded_lattice_missing_meet && anchor_partial_missing_lattice_field

test data anchor_partials_collected_from_module: v2.std.logic.Bool = v2.std.algebra.length(
  xs: v2.std.bounded_lattice_completeness.partial_bounded_lattice_instances_in_tree(tree: anchor_module_with_partial_and_consumer)
) == 2

test data anchor_partials_collected_from_partial_only_module: v2.std.logic.Bool = v2.std.algebra.length(
  xs: v2.std.bounded_lattice_completeness.partial_bounded_lattice_instances_in_tree(tree: anchor_module_with_partial_only)
) == 1

test data anchor_module_partial_only_consumer_gate_accepts: v2.std.logic.Bool = match v2.std.bounded_lattice_completeness.infer_bounded_lattice_consumer_gate(
  consumer: anchor_module_with_partial_only,
  partials: [anchor_partial_bounded_lattice_instance]
) {
  Accepted { value: _, diagnostics: _ } => true
  Rejected { diagnostics: _ } => false
}

data anchor_instance_gate_rejects_partial: v2.std.diagnostic.Outcome<v2.std.node.Node> = v2.std.bounded_lattice_completeness.infer_bounded_lattice_instance_gate(instance: anchor_partial_bounded_lattice_instance)

data anchor_instance_gate_accepts_complete: v2.std.diagnostic.Outcome<v2.std.node.Node> = v2.std.bounded_lattice_completeness.infer_bounded_lattice_instance_gate(instance: anchor_complete_bounded_lattice_instance)

data anchor_consumer_gate_rejects_partial_reference: v2.std.diagnostic.Outcome<v2.std.node.Node> = v2.std.bounded_lattice_completeness.infer_bounded_lattice_consumer_gate(
  consumer: anchor_consumer_of_partial,
  partials: [anchor_partial_bounded_lattice_instance]
)

data anchor_infer_rejects_consumer_tree: v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> = v2.compiler.infer.infer(tree: anchor_module_with_partial_and_consumer)

fn anchor_infer_consumer_tree_is_rejected() -> v2.std.logic.Bool {
  match anchor_infer_rejects_consumer_tree {
    Rejected { diagnostics: _ } => true
    _ => false
  }
}

data anchor_infer_consumer_tree_rejects: v2.std.logic.Bool = anchor_infer_consumer_tree_is_rejected()

test fn sg6_missing_meet_consumer_infer_rejects() -> v2.std.logic.Bool {
  anchor_infer_consumer_tree_rejects
    && anchor_partial_bounded_lattice_missing_meet
    && anchor_bounded_lattice_completeness_classifies_instances
}
