module v2.test.manual.value_null_split_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data value_null_split_phase_a_note: String = "Phase A witnesses (keen-ferret-250): pin Optional/Witness construction carriers vs the overloaded Value::Null sentinel. optional_null_straddle_rostered_until_phase_e delegates the Optional×native_value_null straddle to the testgen roster (removed in Phase E). raw_get_miss_differs_from_optional_absent stays GREEN while raw get miss is untyped and optional_absent() is Optional::Absent; it flips RED in Phase B when get+Optional routes through map_lookup_as_optional."

test fn optional_absent_matches_absent_pattern() -> Bool {
  match v2.std.optional.optional_absent() {
    v2.std.optional.Absent => true
    v2.std.optional.Present { value: _ } => false
  }
}

test fn optional_present_matches_present_pattern() -> Bool {
  match v2.std.optional.optional_present(value: 42) {
    v2.std.optional.Present { value: v } => v == 42
    v2.std.optional.Absent => false
  }
}

test fn map_get_miss_is_absent_not_present() -> Bool {
  match map_get(v2.std.collection.empty_map(), "missing") {
    v2.std.diagnostic.Accepted { value: v2.std.optional.Absent, diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: v2.std.optional.Present { value: _ }, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn map_get_hit_is_present() -> Bool {
  let m = v2.std.collection.empty_map() |> v2.std.collection.map_insert("k", 7)
  match map_get(m, "k") {
    v2.std.diagnostic.Accepted { value: v2.std.optional.Present { value: v }, diagnostics: _ } => v == 7
    v2.std.diagnostic.Accepted { value: v2.std.optional.Absent, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn optional_null_straddle_rostered_until_phase_e() -> Bool {
  v2.test.generated.cross_representation_equality.witness_cross_representation_equality_covers_optional_null
}

test fn raw_get_miss_differs_from_optional_absent() -> Bool {
  let m = v2.std.collection.empty_map()
  (m |> get("missing")) != v2.std.optional.optional_absent()
}

test fn witness_holds_matches_holds_pattern() -> Bool {
  match v2.std.witness.Holds { value: 1 } {
    v2.std.witness.Holds { value: v } => v == 1
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}
