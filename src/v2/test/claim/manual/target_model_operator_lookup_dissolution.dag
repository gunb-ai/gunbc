module v2.test.manual.target_model_operator_lookup_dissolution


fn operator_lookup_dissolution_probe_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^operator_lookup_dissolution_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn operator_lookup_dissolution_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^operator_lookup_dissolution_pass } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn operator_lookup_dissolution_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^operator_lookup_dissolution_fail } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn operator_lookup_dissolution_claim_input(ok: Bool) -> Node {
  if ok {
    operator_lookup_dissolution_pass_node()
  } else {
    operator_lookup_dissolution_fail_node()
  }
}

fn operator_catalog_with_malformed_and_valid_rows() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^target_operator_realization_row_edge },
        target: operator_lookup_dissolution_probe_node()
      },
      Edge {
        label: Named { name: ^target_operator_realization_row_edge },
        target: ts_add_operator_realization_row()
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn operator_lookup_known_op_accepts() -> Bool {
  match target_operator_realization_catalog_lookup(
    catalog: operator_catalog_with_malformed_and_valid_rows(),
    canonical_op: canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn operator_lookup_empty_catalog_rejects_miss() -> Bool {
  match target_operator_realization_catalog_lookup(
    catalog: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    },
    canonical_op: canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_operator_realization_catalog_miss
  }
}

fn operator_catalog_with_malformed_row_skips_accepts_valid() -> Bool {
  match target_operator_realization_catalog_lookup(
    catalog: operator_catalog_with_malformed_and_valid_rows(),
    canonical_op: canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data claim_operator_lookup_accepts: TestClaim = CompilesClaim {
  label: "manual/operator_lookup_dissolution: target_operator_realization_catalog_lookup accepts known OpAdd row",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: operator_lookup_dissolution_claim_input(ok: operator_lookup_known_op_accepts()),
  expected_value: operator_lookup_dissolution_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_operator_lookup_miss: TestClaim = CompilesClaim {
  label: "manual/operator_lookup_dissolution: empty operator catalog rejects miss",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: operator_lookup_dissolution_claim_input(ok: operator_lookup_empty_catalog_rejects_miss()),
  expected_value: operator_lookup_dissolution_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_operator_catalog_malformed_row_skips: TestClaim = CompilesClaim {
  label: "manual/operator_lookup_dissolution: Conj catalog with malformed row skips it, accepts valid row (fail-open witness)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: operator_lookup_dissolution_claim_input(
    ok: operator_catalog_with_malformed_row_skips_accepts_valid()
  ),
  expected_value: operator_lookup_dissolution_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
