module v2.test.manual.bind_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn bind_emit_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  bind_round_trip_inferred_facts_for(node: key)
}

fn bind_emit_inferred_tree_for(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: bind_emit_facts_lookup }
  }
}

fn bind_emit_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_bind_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: bind_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn bind_emit_wrong_value_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_bind_wrong_value_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: bind_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn bind_emit_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Medium<String>> {
  bind_outcome(
    o: bind_emit_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn bind_emit_wrong_value_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Medium<String>> {
  bind_outcome(
    o: bind_emit_wrong_value_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn bind_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: dag_bind_target_model(),
    emitted: dag_fixture_emitted_bind_fn
  ) {
    v2.std.diagnostic.Accepted { value: authority, diagnostics: ad } =>
      match bind_emit_from_producer(target: dag_bind_target_model()) {
        v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn bind_emit_wrong_value_discriminates() -> Bool {
  match bind_emit_from_producer(target: dag_bind_target_model()) {
    v2.std.diagnostic.Accepted { value: canonical, diagnostics: dc } =>
      match bind_emit_wrong_value_from_producer(target: dag_bind_target_model()) {
        v2.std.diagnostic.Accepted { value: wrong, diagnostics: dw } =>
          (wrong != canonical) && (dc == v2.std.diagnostic.None) && (dw == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

