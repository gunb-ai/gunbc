module v2.test.manual.scheduler_runnable_frontier

import v2.std.collection { List }
import v2.std.dependency {
  Contains,
  DataDependsOn,
  DependencyView,
  ReadinessLayer,
  topological_layers
}
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.workflow.scheduler {
  RunnableFrontier,
  SchedulerNoRunnableFrontier,
  SchedulerPlanBlocked,
  SchedulerPlanComplete,
  SchedulerPlanRunnable,
  runnable_frontier,
  runnable_frontier_from_dependencies,
  scheduler_plan,
  scheduler_plan_from_dependencies,
  scheduler_step_plan_from_dependencies
}

import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

data scheduler_build_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^scheduler_build_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data scheduler_test_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^scheduler_test_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data scheduler_emit_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^scheduler_emit_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data scheduler_missing_source_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^scheduler_missing_source_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data scheduler_fixture_graph: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^scheduler_build_symbol }, target: scheduler_build_node },
    Edge { label: Named { name: ^scheduler_test_symbol }, target: scheduler_test_node },
    Edge { label: Named { name: ^scheduler_emit_symbol }, target: scheduler_emit_node }
  ],
  occurrence_id: SyntheticOccurrence
}

data scheduler_build_to_emit_dependency: DependencyView = DependencyView {
  source: scheduler_build_node,
  dependent: scheduler_emit_node,
  kind: DataDependsOn,
  usage_site: scheduler_emit_node
}

data scheduler_test_to_emit_dependency: DependencyView = DependencyView {
  source: scheduler_test_node,
  dependent: scheduler_emit_node,
  kind: DataDependsOn,
  usage_site: scheduler_emit_node
}

data scheduler_fixture_nodes: List<Node> = [
  scheduler_build_node,
  scheduler_test_node,
  scheduler_emit_node
]

data scheduler_fixture_dependencies: List<DependencyView> = [
  scheduler_build_to_emit_dependency,
  scheduler_test_to_emit_dependency
]

data scheduler_fixture_reversed_dependencies: List<DependencyView> = [
  DependencyView {
    source: scheduler_emit_node,
    dependent: scheduler_build_node,
    kind: DataDependsOn,
    usage_site: scheduler_build_node
  },
  DependencyView {
    source: scheduler_emit_node,
    dependent: scheduler_test_node,
    kind: DataDependsOn,
    usage_site: scheduler_test_node
  }
]

data scheduler_contains_noise_dependency: DependencyView = DependencyView {
  source: scheduler_emit_node,
  dependent: scheduler_build_node,
  kind: Contains,
  usage_site: scheduler_build_node
}

data scheduler_fixture_dependencies_with_contains_noise: List<DependencyView> = [
  scheduler_build_to_emit_dependency,
  scheduler_test_to_emit_dependency,
  scheduler_contains_noise_dependency
]

data scheduler_missing_prerequisite_dependencies: List<DependencyView> = [
  DependencyView {
    source: scheduler_emit_node,
    dependent: scheduler_build_node,
    kind: DataDependsOn,
    usage_site: scheduler_build_node
  }
]

data scheduler_mixed_runnable_blocked_dependencies: List<DependencyView> = [
  DependencyView {
    source: scheduler_missing_source_node,
    dependent: scheduler_test_node,
    kind: DataDependsOn,
    usage_site: scheduler_test_node
  }
]

fn scheduler_initial_frontier() -> RunnableFrontier {
  runnable_frontier_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies,
    scheduled: []
  )
}

fn scheduler_after_independent_frontier() -> RunnableFrontier {
  runnable_frontier_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies,
    scheduled: [scheduler_build_node, scheduler_test_node]
  )
}

fn scheduler_reversed_initial_frontier() -> RunnableFrontier {
  runnable_frontier_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_reversed_dependencies,
    scheduled: []
  )
}

fn scheduler_contains_noise_frontier() -> RunnableFrontier {
  runnable_frontier_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies_with_contains_noise,
    scheduled: []
  )
}

fn scheduler_layers_reuse_dependency_fold() -> Bool {
  match scheduler_plan(graph_node: scheduler_fixture_graph) {
    SchedulerPlanComplete { layers: layers, scheduled: _ } => layers == topological_layers(graph_node: scheduler_fixture_graph)
    SchedulerPlanRunnable { frontier: _, scheduled: _, remaining: _, layers: _ } => false
    SchedulerPlanBlocked { evidence: _, scheduled: _, remaining: _, layers: _ } => false
  }
}

fn scheduler_graph_frontier_projects_first_layer() -> Bool {
  runnable_frontier(graph_node: scheduler_fixture_graph).ready == [scheduler_fixture_graph]
}

fn scheduler_dependency_frontier_carries_runnable_work() -> Bool {
  scheduler_initial_frontier().ready == [scheduler_build_node, scheduler_test_node]
}

fn scheduler_next_frontier_after_independent_work() -> Bool {
  scheduler_after_independent_frontier().ready == [scheduler_emit_node]
}

fn scheduler_reversed_dependencies_change_frontier() -> Bool {
  scheduler_reversed_initial_frontier().ready != scheduler_initial_frontier().ready
}

fn scheduler_contains_edges_do_not_block_execution() -> Bool {
  scheduler_contains_noise_frontier().ready == [scheduler_build_node, scheduler_test_node]
}

fn scheduler_missing_prerequisite_blocks_with_evidence() -> Bool {
  match scheduler_plan_from_dependencies(
    nodes: [scheduler_build_node],
    dependencies: scheduler_missing_prerequisite_dependencies,
    scheduled: []
  ) {
    SchedulerPlanComplete { layers: _, scheduled: _ } => false
    SchedulerPlanRunnable { frontier: _, scheduled: _, remaining: _, layers: _ } => false
    SchedulerPlanBlocked { evidence: SchedulerNoRunnableFrontier {}, scheduled: scheduled, remaining: remaining, layers: layers } => scheduled == [] && remaining == [scheduler_build_node] && layers == []
  }
}

fn scheduler_step_plan_exposes_runnable_state() -> Bool {
  match scheduler_step_plan_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies,
    scheduled: []
  ) {
    SchedulerPlanComplete { layers: _, scheduled: _ } => false
    SchedulerPlanRunnable { frontier: frontier, scheduled: scheduled, remaining: remaining, layers: layers } => frontier.ready == [scheduler_build_node, scheduler_test_node] && scheduled == [scheduler_build_node, scheduler_test_node] && remaining == [scheduler_emit_node] && layers == [ReadinessLayer { ready: [scheduler_build_node, scheduler_test_node] }]
    SchedulerPlanBlocked { evidence: _, scheduled: _, remaining: _, layers: _ } => false
  }
}

fn scheduler_full_plan_completes_all_work() -> Bool {
  match scheduler_plan_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies,
    scheduled: []
  ) {
    SchedulerPlanComplete { layers: layers, scheduled: scheduled } => scheduled == [scheduler_build_node, scheduler_test_node, scheduler_emit_node] && layers == [ReadinessLayer { ready: [scheduler_build_node, scheduler_test_node] }, ReadinessLayer { ready: [scheduler_emit_node] }]
    SchedulerPlanRunnable { frontier: _, scheduled: _, remaining: _, layers: _ } => false
    SchedulerPlanBlocked { evidence: _, scheduled: _, remaining: _, layers: _ } => false
  }
}

fn scheduler_all_scheduled_completes_without_blocking() -> Bool {
  match scheduler_plan_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies,
    scheduled: scheduler_fixture_nodes
  ) {
    SchedulerPlanComplete { layers: layers, scheduled: scheduled } => scheduled == scheduler_fixture_nodes && layers == []
    SchedulerPlanRunnable { frontier: _, scheduled: _, remaining: _, layers: _ } => false
    SchedulerPlanBlocked { evidence: _, scheduled: _, remaining: _, layers: _ } => false
  }
}

fn scheduler_mixed_runnable_then_blocked_reports_remaining() -> Bool {
  match scheduler_plan_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_mixed_runnable_blocked_dependencies,
    scheduled: []
  ) {
    SchedulerPlanComplete { layers: _, scheduled: _ } => false
    SchedulerPlanRunnable { frontier: _, scheduled: _, remaining: _, layers: _ } => false
    SchedulerPlanBlocked { evidence: SchedulerNoRunnableFrontier {}, scheduled: scheduled, remaining: remaining, layers: layers } => scheduled == [scheduler_build_node, scheduler_emit_node] && remaining == [scheduler_test_node] && layers == [ReadinessLayer { ready: [scheduler_build_node, scheduler_emit_node] }]
  }
}

data scheduler_runnable_frontier_reuses_dependency_fold: Bool = scheduler_layers_reuse_dependency_fold()

data scheduler_runnable_frontier_projects_canonical_first_layer: Bool = scheduler_graph_frontier_projects_first_layer()

data scheduler_runnable_frontier_dependency_ready_set: Bool = scheduler_dependency_frontier_carries_runnable_work()

data scheduler_runnable_frontier_next_layer_receipt: Bool = scheduler_next_frontier_after_independent_work()

data scheduler_runnable_frontier_discriminates_dependency_order: Bool = scheduler_reversed_dependencies_change_frontier()

data scheduler_runnable_frontier_ignores_contains_edges: Bool = scheduler_contains_edges_do_not_block_execution()

data scheduler_runnable_frontier_blocks_missing_prerequisite: Bool = scheduler_missing_prerequisite_blocks_with_evidence()

data scheduler_runnable_frontier_step_plan_is_runnable: Bool = scheduler_step_plan_exposes_runnable_state()

data scheduler_runnable_frontier_full_plan_completes: Bool = scheduler_full_plan_completes_all_work()

data scheduler_runnable_frontier_all_scheduled_completes: Bool = scheduler_all_scheduled_completes_without_blocking()

data scheduler_runnable_frontier_mixed_plan_blocks: Bool = scheduler_mixed_runnable_then_blocked_reports_remaining()

test fn scheduler_runnable_frontier_claims_hold() -> Bool {
  scheduler_runnable_frontier_reuses_dependency_fold && scheduler_runnable_frontier_projects_canonical_first_layer && scheduler_runnable_frontier_dependency_ready_set && scheduler_runnable_frontier_next_layer_receipt && scheduler_runnable_frontier_discriminates_dependency_order && scheduler_runnable_frontier_ignores_contains_edges && scheduler_runnable_frontier_blocks_missing_prerequisite && scheduler_runnable_frontier_step_plan_is_runnable && scheduler_runnable_frontier_full_plan_completes && scheduler_runnable_frontier_all_scheduled_completes && scheduler_runnable_frontier_mixed_plan_blocks
}
