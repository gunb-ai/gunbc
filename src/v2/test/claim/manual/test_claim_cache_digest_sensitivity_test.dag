fn tcc_cache_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^tcc_cache_pass_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn tcc_cache_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^tcc_cache_fail_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn tcc_cache_root() -> Node {
  claim_atom_node(s: ^tcc_cache_root_sym)
}

fn tcc_cache_eval_node_a() -> Node {
  claim_atom_node(s: ^tcc_cache_eval_a_sym)
}

fn tcc_cache_eval_node_b() -> Node {
  claim_atom_node(s: ^tcc_cache_eval_b_sym)
}

fn tcc_cache_tree_facts_for_reason(reason: Symbol) -> InferredTree {
  claim_inferred_tree(
    root: tcc_cache_root(),
    facts: claim_inferred_facts(
      type_symbol: reason,
      algebra_symbol: ^tcc_cache_facts_algebra_sym,
      descent_symbol: ^tcc_cache_facts_descent_sym,
    )
  )
}

fn tcc_cache_eval_context() -> EvalContext {
  eval_context_v4_evaluator()
}

fn tcc_cache_stub_claim() -> TestClaim {
  CompilesClaim {
    label: "manual/test_claim_cache: digest sensitivity scaffold",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    classification: TestClassification { tier: Tier1, layer: Unit },
    input: tcc_cache_pass_node(),
    expected_value: tcc_cache_pass_node()
  }
}

fn tcc_cache_subject(
  tree: InferredTree,
  evaluator_input: Node
) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: tcc_cache_stub_claim(),
    context: tcc_cache_eval_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: evaluator_input,
      evaluator_pin: ^tcc_cache_evaluator_pin
    )
  }
}

test fn tcc_cache_facts_diagnostic_digest_differs() -> Bool {
  let tree_a = tcc_cache_tree_facts_for_reason(reason: ^tcc_cache_facts_diag_a)
  let tree_b = tcc_cache_tree_facts_for_reason(reason: ^tcc_cache_facts_diag_b)
  let hash_a = test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree_a, evaluator_input: tcc_cache_eval_node_a())
  )
  let hash_b = test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree_b, evaluator_input: tcc_cache_eval_node_a())
  )
  hash_a != hash_b
}

fn tcc_cache_diagnostic_claim(expected_reason: Symbol) -> TestClaim {
  DiagnosticClaim {
    label: "manual/test_claim_cache: diagnostic claim hash scaffold",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    classification: TestClassification { tier: Tier1, layer: Unit },
    input: tcc_cache_root(),
    expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: expected_reason,
        at: node_locus(node: tcc_cache_root()),
        correction: Unavailable { reason: AmbiguousIntent }
      }
    )
  }
}

test fn tcc_cache_compiles_equals_same_nodes_claim_hash_differs() -> Bool {
  let node_x = tcc_cache_root()
  let node_y = tcc_cache_pass_node()
  test_claim_claim_hash_digest(
    c: CompilesClaim {
      label: "manual/test_claim_cache: compiles shape",
      anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: TestClassification { tier: Tier1, layer: Unit },
      input: node_x,
      expected_value: node_y
    }
  ) != test_claim_claim_hash_digest(
    c: EqualsClaim {
      label: "manual/test_claim_cache: equals shape",
      anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: TestClassification { tier: Tier1, layer: Unit },
      lhs: node_x,
      rhs: node_y
    }
  )
}

test fn tcc_cache_diagnostic_reason_claim_hash_differs() -> Bool {
  test_claim_claim_hash_digest(c: tcc_cache_diagnostic_claim(expected_reason: ^tcc_cache_expected_diag_a)) !=
    test_claim_claim_hash_digest(c: tcc_cache_diagnostic_claim(expected_reason: ^tcc_cache_expected_diag_b))
}

test fn tcc_cache_evaluator_input_digest_differs() -> Bool {
  let tree = tcc_cache_tree_facts_for_reason(reason: ^tcc_cache_facts_diag_a)
  let hash_a = test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree, evaluator_input: tcc_cache_eval_node_a())
  )
  let hash_b = test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree, evaluator_input: tcc_cache_eval_node_b())
  )
  hash_a != hash_b
}

test fn tcc_cache_ineligible_interpretation_digest_differs() -> Bool {
  let digest_a = test_claim_interpretation_cache_digest(
    context: eval_context_with_semantics(
      runtime_identity: ^tcc_cache_ineligible_pin_a,
      interpretation: eval_default_interpretation(),
      structure_witness: v2_evaluator_interpretation_structure_witness()
    )
  )
  let digest_b = test_claim_interpretation_cache_digest(
    context: eval_context_with_semantics(
      runtime_identity: ^tcc_cache_ineligible_pin_b,
      interpretation: eval_default_interpretation(),
      structure_witness: v2_evaluator_interpretation_structure_witness()
    )
  )
  digest_a != digest_b
}

data tcc_cache_byte_limb_base: Int = 256
data tcc_cache_int_one: Int = 1
data tcc_cache_int_two: Int = 2

fn tcc_cache_byte_offset_pow_2() -> Int {
  int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_4() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_2(), b: tcc_cache_byte_offset_pow_2())
}

fn tcc_cache_byte_offset_pow_8() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_4(), b: tcc_cache_byte_offset_pow_4())
}

fn tcc_cache_byte_offset_pow_9() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_8(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_12() -> Int {
  int_mul(
    a: tcc_cache_byte_offset_pow_9(),
    b: int_mul(a: tcc_cache_byte_limb_base, b: int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base))
  )
}

fn tcc_cache_byte_offset_pow_13() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_12(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_16() -> Int {
  int_mul(
    a: tcc_cache_byte_offset_pow_13(),
    b: int_mul(a: tcc_cache_byte_limb_base, b: int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base))
  )
}

fn tcc_cache_byte_offset_pow_19() -> Int {
  int_mul(
    a: tcc_cache_byte_offset_pow_16(),
    b: int_mul(a: tcc_cache_byte_limb_base, b: int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base))
  )
}

fn tcc_cache_byte_offset_pow_20() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_19(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_21() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_20(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_22() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_21(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_28() -> Int {
  int_mul(
    a: tcc_cache_byte_offset_pow_22(),
    b: int_mul(
      a: tcc_cache_byte_limb_base,
      b: int_mul(a: tcc_cache_byte_limb_base, b: int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base))
    )
  )
}

fn tcc_cache_byte_offset_pow_29() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_28(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_36() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_28(), b: tcc_cache_byte_offset_pow_8())
}

fn tcc_cache_byte_offset_pow_37() -> Int {
  int_mul(a: tcc_cache_byte_offset_pow_36(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_exact_ceiling() -> Int {
  int_add(a: tcc_cache_byte_offset_pow_9(), b: int_negate(a: tcc_cache_int_one))
}

fn tcc_cache_byte_offset_over_ceiling() -> Int {
  tcc_cache_byte_offset_pow_9()
}

fn tcc_cache_byte_offset_same_quotient() -> Int {
  int_add(a: tcc_cache_byte_offset_over_ceiling(), b: tcc_cache_byte_limb_base)
}

// DEMOTED (retirement candidates, 2026-08-19): the TEN byte-offset rows below assert
// digest discrimination in the over-ceiling / limb-exhaustion regime, which begins at
// 256^9 = 2^72 — above i64::MAX. Every pow_9..pow_37 fixture is therefore unrepresentable,
// so the pairs these rows compare cannot be constructed at all: the regime is unreachable
// from any representable Int, and the claims cannot be stated with executable fixtures on
// this realization. The digest algorithm itself does not alias on these pairs (symbolic
// simulation of the limb arithmetic: all pairs differ) — the defect is in the fixtures,
// not in the thing they test.
//
// COUNT CORRECTED FROM EIGHT TO TEN (gunbc#8505 follow-up). The first two rows here —
// exact_ceiling_digest_differs_from_over_ceiling and
// same_quotient_low_limbs_digest_differs — were left as `test fn` when their eight
// siblings were demoted, and they reach pow_9 through
// tcc_cache_byte_offset_over_ceiling exactly as the others do. They were demoted by
// enumeration rather than by the property, so two members of the class were missed.
//
// WHY THAT SURVIVED CI AND THEN BROKE main: the earlier description of this regime said
// `a * b` wraps silently in release mode, and the two rows passed on that behaviour by
// comparing 0 against 0 — a VACUOUS pass, not a real one. Int multiplication now refuses
// with a typed located diagnostic (`integer overflow: 4294967296 * 4294967296 does not
// fit in a 64-bit Int`) instead of wrapping, which is the correct fail-closed behaviour
// and turned the vacuous pass into an honest failure. main went red at f44a1254 with
// failed=2, both of them. The rows did not regress; the silence that hid them was
// removed.
fn tcc_cache_byte_offset_exact_ceiling_digest_differs_from_over_ceiling() -> Bool {
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_exact_ceiling())) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_over_ceiling()))
}

fn tcc_cache_byte_offset_same_quotient_low_limbs_digest_differs() -> Bool {
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_over_ceiling())) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_same_quotient()))
}

fn tcc_cache_byte_offset_sign_over_ceiling_digest_differs() -> Bool {
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_over_ceiling())) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: 0 - tcc_cache_byte_offset_over_ceiling()))
}

fn tcc_cache_byte_offset_large_overflow_quotient_digest_differs() -> Bool {
  let overflow_quotient = tcc_cache_byte_offset_pow_13()
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: overflow_quotient)) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: int_mul(a: tcc_cache_int_two, b: overflow_quotient)))
}

fn tcc_cache_byte_offset_exhausted_residual_quotient_digest_differs() -> Bool {
  let overflow_quotient = tcc_cache_byte_offset_pow_19()
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: overflow_quotient)) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: int_mul(a: tcc_cache_int_two, b: overflow_quotient)))
}

fn tcc_cache_byte_offset_exhausted_residual_adjacent_power_digest_differs() -> Bool {
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_pow_19())) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_pow_20()))
}

fn tcc_cache_byte_offset_exhausted_residual_adjacent_power_21_22_digest_differs() -> Bool {
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_pow_21())) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_pow_22()))
}

fn tcc_cache_byte_offset_exhausted_residual_21_double_digest_differs() -> Bool {
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_pow_21())) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: int_mul(a: tcc_cache_int_two, b: tcc_cache_byte_offset_pow_21())))
}

fn tcc_cache_byte_offset_exhausted_residual_29_double_digest_differs() -> Bool {
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_pow_29())) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: int_mul(a: tcc_cache_int_two, b: tcc_cache_byte_offset_pow_29())))
}

fn tcc_cache_byte_offset_exhausted_residual_37_double_digest_differs() -> Bool {
  byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: tcc_cache_byte_offset_pow_37())) !=
    byte_offset_cache_key_fingerprint(key: byte_offset_cache_key(i: int_mul(a: tcc_cache_int_two, b: tcc_cache_byte_offset_pow_37())))
}

fn tcc_cache_runtime_unit() -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue { unit_type: v2_eval_unit_type_node() }
  }
}

fn tcc_stub_alloc_a(_node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Accepted { value: tcc_cache_runtime_unit(), diagnostics: None }
}

fn tcc_stub_call_b(
  _node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  Accepted { value: tcc_cache_runtime_unit(), diagnostics: None }
}

fn tcc_interp_stub_allocate_body() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: tcc_stub_alloc_a,
      identity: ^tcc_stub_alloc_a
    },
    transform: TransformInterpreter {
      call_primitive: v2_eval_call_primitive,
      identity: ^v2_eval_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: v2_eval_choose_branch,
      identity: ^v2_eval_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: v2_eval_step_loop,
      identity: ^v2_eval_step_loop
    },
    bind: BindInterpreter {
      bind_value: v2_eval_bind_value,
      identity: ^v2_eval_bind_value
    },
    match: MatchInterpreter {
      choose_arm: runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm
    }
  }
}

fn tcc_interp_stub_call_body() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: v2_eval_allocate_literal,
      identity: ^v2_eval_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: tcc_stub_call_b,
      identity: ^tcc_stub_call_b
    },
    branch: BranchInterpreter {
      choose_branch: v2_eval_choose_branch,
      identity: ^v2_eval_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: v2_eval_step_loop,
      identity: ^v2_eval_step_loop
    },
    bind: BindInterpreter {
