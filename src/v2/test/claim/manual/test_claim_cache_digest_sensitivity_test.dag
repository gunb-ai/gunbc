test fn tcc_cache_same_pin_match_only_slot_digest_differs() -> Bool {
  let digest_default = test_claim_interpretation_cache_digest(
    context: eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_match_default_body(),
      structure_witness: tcc_witness_match_default_body()
    )
  )
  let digest_match_only = test_claim_interpretation_cache_digest(
    context: eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_match_stub_body(),
      structure_witness: tcc_witness_match_stub_body()
    )
  )
  digest_default != digest_match_only
}

test fn tcc_cache_same_pin_match_only_slot_identical_digest_equal() -> Bool {
  let digest_a = test_claim_interpretation_cache_digest(
    context: eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_match_default_body(),
      structure_witness: tcc_witness_match_default_body()
    )
  )
  let digest_b = test_claim_interpretation_cache_digest(
    context: eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_match_default_body(),
      structure_witness: tcc_witness_match_default_body()
    )
  )
  digest_a == digest_b
}

fn tcc_cache_diagnostic_tail_bag_claim(label_suffix: String, tail: List<Diagnostic>) -> TestClaim {
  DiagnosticClaim {
    label: label_suffix,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    classification: TestClassification { tier: Tier1, layer: Unit },
    input: tcc_cache_root(),
    expected_rejection: NonEmptyDiagnostics {
      head: Diagnostic {
        reason: ^tcc_cache_expected_diag_a,
        at: node_locus(node: tcc_cache_root()),
        correction: Unavailable { reason: AmbiguousIntent }
      },
      tail: tail
    }
  }
}

test fn tcc_cache_diagnostic_tail_permutation_claim_hash_invariant() -> Bool {
  let diag_b = Diagnostic {
    reason: ^tcc_cache_tail_diag_b,
    at: node_locus(node: tcc_cache_root()),
    correction: Unavailable { reason: AmbiguousIntent }
  }
  let diag_c = Diagnostic {
    reason: ^tcc_cache_tail_diag_c,
    at: node_locus(node: tcc_cache_root()),
    correction: Unavailable { reason: AmbiguousIntent }
  }
  test_claim_claim_hash_digest(
    c: tcc_cache_diagnostic_tail_bag_claim(
      label_suffix: "manual/test_claim_cache: tail order ab",
      tail: [diag_b, diag_c]
    )
  ) == test_claim_claim_hash_digest(
    c: tcc_cache_diagnostic_tail_bag_claim(
      label_suffix: "manual/test_claim_cache: tail order ba",
      tail: [diag_c, diag_b]
    )
  )
}

test fn tcc_cache_correction_variant_domain_claim_hash_differs() -> Bool {
  let ambiguous_tag_node = claim_atom_node(s: ^test_claim_no_correction_ambiguous_intent_tag)
  test_claim_claim_hash_digest(
    c: DiagnosticClaim {
      label: "manual/test_claim_cache: suggested vs unavailable correction domain",
      anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: TestClassification { tier: Tier1, layer: Unit },
      input: tcc_cache_root(),
      expected_rejection: diagnostics_singleton(
        d: Diagnostic {
          reason: ^tcc_cache_expected_diag_a,
          at: node_locus(node: tcc_cache_root()),
          correction: Suggested { node: ambiguous_tag_node }
        }
      )
    }
  ) != test_claim_claim_hash_digest(
    c: DiagnosticClaim {
      label: "manual/test_claim_cache: unavailable ambiguous intent correction",
      anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: TestClassification { tier: Tier1, layer: Unit },
      input: tcc_cache_root(),
      expected_rejection: diagnostics_singleton(
        d: Diagnostic {
          reason: ^tcc_cache_expected_diag_a,
          at: node_locus(node: tcc_cache_root()),
          correction: Unavailable { reason: AmbiguousIntent }
        }
      )
    }
  )
}

test fn tcc_cache_locus_variant_domain_claim_hash_differs() -> Bool {
  test_claim_claim_hash_digest(
    c: DiagnosticClaim {
      label: "manual/test_claim_cache: node locus domain",
      anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: TestClassification { tier: Tier1, layer: Unit },
      input: tcc_cache_root(),
      expected_rejection: diagnostics_singleton(
        d: Diagnostic {
          reason: ^tcc_cache_expected_diag_a,
          at: node_locus(node: tcc_cache_root()),
          correction: Unavailable { reason: AmbiguousIntent }
        }
      )
    }
  ) != test_claim_claim_hash_digest(
    c: DiagnosticClaim {
      label: "manual/test_claim_cache: port locus domain",
      anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: TestClassification { tier: Tier1, layer: Unit },
      input: tcc_cache_root(),
      expected_rejection: diagnostics_singleton(
        d: Diagnostic {
          reason: ^tcc_cache_expected_diag_a,
          at: invariant_port_locus(port: ^tcc_cache_root_sym, invariant: ^tcc_cache_expected_diag_a),
          correction: Unavailable { reason: AmbiguousIntent }
        }
      )
    }
  )
}
