fn tcc_cache_byte_offset_exhausted_residual_29_double_digest_differs() -> Bool {
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_pow_29())) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: v2.std.integer.int_mul(a: tcc_cache_int_two, b: tcc_cache_byte_offset_pow_29())))
}

fn tcc_cache_byte_offset_exhausted_residual_37_double_digest_differs() -> Bool {
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_pow_37())) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: v2.std.integer.int_mul(a: tcc_cache_int_two, b: tcc_cache_byte_offset_pow_37())))
}

fn tcc_cache_runtime_unit() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeUnit {
    value: v2.std.runtime.RuntimeUnitValue { unit_type: v2.extdeps.runtimes.v2_evaluator.v2_eval_unit_type_node() }
  }
}

fn tcc_stub_alloc_a(_node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: tcc_cache_runtime_unit(), diagnostics: v2.std.diagnostic.None }
}

fn tcc_stub_call_b(
  _node: v2.std.node.Node,
  _args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: tcc_cache_runtime_unit(), diagnostics: v2.std.diagnostic.None }
}

fn tcc_interp_stub_allocate_body() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: tcc_stub_alloc_a,
      identity: ^tcc_stub_alloc_a
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: v2.extdeps.runtimes.v2_evaluator.v2_eval_call_primitive,
      identity: ^v2_eval_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: v2.extdeps.runtimes.v2_evaluator.v2_eval_choose_branch,
      identity: ^v2_eval_choose_branch
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: v2.extdeps.runtimes.v2_evaluator.v2_eval_step_loop,
      identity: ^v2_eval_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: v2.extdeps.runtimes.v2_evaluator.v2_eval_bind_value,
      identity: ^v2_eval_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm    }
  }
}

fn tcc_interp_stub_call_body() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal,
      identity: ^v2_eval_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: tcc_stub_call_b,
      identity: ^tcc_stub_call_b
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: v2.extdeps.runtimes.v2_evaluator.v2_eval_choose_branch,
      identity: ^v2_eval_choose_branch
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: v2.extdeps.runtimes.v2_evaluator.v2_eval_step_loop,
      identity: ^v2_eval_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: v2.extdeps.runtimes.v2_evaluator.v2_eval_bind_value,
      identity: ^v2_eval_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^runtime_reject_match_arm    }
  }
}

fn tcc_witness_stub_allocate_body() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^tcc_stub_alloc_a,
    call_primitive: ^v2_eval_call_primitive,
    choose_branch: ^v2_eval_choose_branch,
    step_loop: ^v2_eval_step_loop,
    bind_value: ^v2_eval_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

fn tcc_witness_stub_call_body() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^v2_eval_allocate_literal,
    call_primitive: ^tcc_stub_call_b,
    choose_branch: ^v2_eval_choose_branch,
    step_loop: ^v2_eval_step_loop,
    bind_value: ^v2_eval_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

test fn tcc_cache_same_pin_different_executed_slot_digest_differs() -> Bool {
  let digest_a = v2.compiler.eval.test_claim_interpretation_cache_digest(
    context: v2.compiler.eval.eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_stub_allocate_body(),
      structure_witness: tcc_witness_stub_allocate_body()
    )
  )
  let digest_b = v2.compiler.eval.test_claim_interpretation_cache_digest(
    context: v2.compiler.eval.eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_stub_call_body(),
      structure_witness: tcc_witness_stub_call_body()
    )
  )
  digest_a != digest_b
}

// The existing same-pin perturbation above varies allocate_literal/call_primitive
// only; match/choose_arm is held at runtime_reject_match_arm on both sides, so it
// cannot exercise the Match slot's participation in cache identity. These two
// functions hold value/transform/branch/loop/bind fixed to their registered
// production implementations and perturb ONLY choose_arm, pairing a discriminating
// case (Match implementation differs -> digest must differ) with a negative control
// (Match implementation identical -> digest must stay equal, proving the
// discriminating case is not vacuous).
fn tcc_stub_choose_arm(
  _node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Accepted { value: tcc_cache_pass_node(), diagnostics: v2.std.diagnostic.None }
}

fn tcc_interp_match_default_body() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal, identity: ^v2_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: v2.extdeps.runtimes.v2_evaluator.v2_eval_call_primitive, identity: ^v2_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: v2.extdeps.runtimes.v2_evaluator.v2_eval_choose_branch, identity: ^v2_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: v2.extdeps.runtimes.v2_evaluator.v2_eval_step_loop, identity: ^v2_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: v2.extdeps.runtimes.v2_evaluator.v2_eval_bind_value, identity: ^v2_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: v2.std.runtime.runtime_reject_match_arm, identity: ^runtime_reject_match_arm }
  }
}

fn tcc_interp_match_stub_body() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: v2.extdeps.runtimes.v2_evaluator.v2_eval_allocate_literal, identity: ^v2_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: v2.extdeps.runtimes.v2_evaluator.v2_eval_call_primitive, identity: ^v2_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: v2.extdeps.runtimes.v2_evaluator.v2_eval_choose_branch, identity: ^v2_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: v2.extdeps.runtimes.v2_evaluator.v2_eval_step_loop, identity: ^v2_eval_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: v2.extdeps.runtimes.v2_evaluator.v2_eval_bind_value, identity: ^v2_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: tcc_stub_choose_arm, identity: ^tcc_stub_choose_arm }
  }
}

fn tcc_witness_match_default_body() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^v2_eval_allocate_literal,
    call_primitive: ^v2_eval_call_primitive,
    choose_branch: ^v2_eval_choose_branch,
    step_loop: ^v2_eval_step_loop,
    bind_value: ^v2_eval_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

fn tcc_witness_match_stub_body() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^v2_eval_allocate_literal,
    call_primitive: ^v2_eval_call_primitive,
    choose_branch: ^v2_eval_choose_branch,
    step_loop: ^v2_eval_step_loop,
    bind_value: ^v2_eval_bind_value,
    choose_arm: ^tcc_stub_choose_arm  }
}

test fn tcc_cache_same_pin_match_only_slot_digest_differs() -> Bool {
  let digest_default = v2.compiler.eval.test_claim_interpretation_cache_digest(
    context: v2.compiler.eval.eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_match_default_body(),
      structure_witness: tcc_witness_match_default_body()
    )
  )
  let digest_match_only = v2.compiler.eval.test_claim_interpretation_cache_digest(
    context: v2.compiler.eval.eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_match_stub_body(),
      structure_witness: tcc_witness_match_stub_body()
    )
  )
  digest_default != digest_match_only
}

test fn tcc_cache_same_pin_match_only_slot_identical_digest_equal() -> Bool {
  let digest_a = v2.compiler.eval.test_claim_interpretation_cache_digest(
    context: v2.compiler.eval.eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_match_default_body(),
      structure_witness: tcc_witness_match_default_body()
    )
  )
  let digest_b = v2.compiler.eval.test_claim_interpretation_cache_digest(
    context: v2.compiler.eval.eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_match_default_body(),
      structure_witness: tcc_witness_match_default_body()
    )
  )
  digest_a == digest_b
}

fn tcc_cache_diagnostic_tail_bag_claim(label_suffix: String, tail: std.types.List<v2.std.diagnostic.Diagnostic>) -> v2.std.verification.TestClaim {
  v2.std.verification.DiagnosticClaim {
    label: label_suffix,
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
    input: tcc_cache_root(),
    expected_rejection: v2.std.diagnostic.NonEmptyDiagnostics {
      head: v2.std.diagnostic.Diagnostic {
        reason: ^tcc_cache_expected_diag_a,
        at: v2.std.diagnostic.node_locus(node: tcc_cache_root()),
        correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
      },
      tail: tail
    }
  }
}

test fn tcc_cache_diagnostic_tail_permutation_claim_hash_invariant() -> Bool {
  let diag_b = v2.std.diagnostic.Diagnostic {
    reason: ^tcc_cache_tail_diag_b,
    at: v2.std.diagnostic.node_locus(node: tcc_cache_root()),
    correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
  }
  let diag_c = v2.std.diagnostic.Diagnostic {
    reason: ^tcc_cache_tail_diag_c,
    at: v2.std.diagnostic.node_locus(node: tcc_cache_root()),
    correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
  }
  v2.compiler.eval.test_claim_claim_hash_digest(
    c: tcc_cache_diagnostic_tail_bag_claim(
      label_suffix: "manual/test_claim_cache: tail order ab",
      tail: [diag_b, diag_c]
    )
  ) == v2.compiler.eval.test_claim_claim_hash_digest(
    c: tcc_cache_diagnostic_tail_bag_claim(
      label_suffix: "manual/test_claim_cache: tail order ba",
      tail: [diag_c, diag_b]
    )
  )
}

test fn tcc_cache_correction_variant_domain_claim_hash_differs() -> Bool {
  let ambiguous_tag_node = v2.test.lens_common.infer_fixture.claim_atom_node(s: ^test_claim_no_correction_ambiguous_intent_tag)
  v2.compiler.eval.test_claim_claim_hash_digest(
    c: v2.std.verification.DiagnosticClaim {
      label: "manual/test_claim_cache: suggested vs unavailable correction domain",
      anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
      input: tcc_cache_root(),
      expected_rejection: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^tcc_cache_expected_diag_a,
          at: v2.std.diagnostic.node_locus(node: tcc_cache_root()),
          correction: v2.std.diagnostic.Suggested { node: ambiguous_tag_node }
        }
      )
    }
  ) != v2.compiler.eval.test_claim_claim_hash_digest(
    c: v2.std.verification.DiagnosticClaim {
      label: "manual/test_claim_cache: unavailable ambiguous intent correction",
      anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
      input: tcc_cache_root(),
      expected_rejection: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^tcc_cache_expected_diag_a,
          at: v2.std.diagnostic.node_locus(node: tcc_cache_root()),
          correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
        }
      )
    }
  )
}

test fn tcc_cache_locus_variant_domain_claim_hash_differs() -> Bool {
  v2.compiler.eval.test_claim_claim_hash_digest(
    c: v2.std.verification.DiagnosticClaim {
      label: "manual/test_claim_cache: node locus domain",
      anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
      input: tcc_cache_root(),
      expected_rejection: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^tcc_cache_expected_diag_a,
          at: v2.std.diagnostic.node_locus(node: tcc_cache_root()),
          correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
        }
      )
    }
  ) != v2.compiler.eval.test_claim_claim_hash_digest(
    c: v2.std.verification.DiagnosticClaim {
      label: "manual/test_claim_cache: port locus domain",
      anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
      input: tcc_cache_root(),
      expected_rejection: v2.std.diagnostic.diagnostics_singleton(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^tcc_cache_expected_diag_a,
          at: v2.std.diagnostic.port_locus(port: ^tcc_cache_root_sym),
          correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
        }
      )
    }
  )
}
