test fn tcc_cache_same_pin_different_executed_slot_digest_differs() -> Bool {
  let digest_a = test_claim_interpretation_cache_digest(
    context: eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_stub_allocate_body(),
      structure_witness: tcc_witness_stub_allocate_body()
    )
  )
  let digest_b = test_claim_interpretation_cache_digest(
    context: eval_context_with_semantics(
      runtime_identity: ^tcc_cache_interpretation_pin,
      interpretation: tcc_interp_stub_call_body(),
      structure_witness: tcc_witness_stub_call_body()
    )
  )
  digest_a != digest_b
}

// The existing same-pin perturbation above varies allocate_literal/call_primitive
// only; match/choose_arm is held at runtime_reject_match_arm on both sides, so it
// cannot exercise the Match slot's participation in cache identity. These two
// functions hold value/transform/branch/loop/bind fixed to their registered
// production implementations and perturb ONLY choose_arm, pairing a discriminating
// case (Match implementation differs -> digest must differ) with a negative control
// (Match implementation identical -> digest must stay equal, proving the
// discriminating case is not vacuous).
fn tcc_stub_choose_arm(
  _node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  Accepted { value: tcc_cache_pass_node(), diagnostics: None }
}

fn tcc_interp_match_default_body() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: v2_eval_allocate_literal, identity: ^v2_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: v2_eval_call_primitive, identity: ^v2_eval_call_primitive },
    branch: BranchInterpreter { choose_branch: v2_eval_choose_branch, identity: ^v2_eval_choose_branch },
    loop: LoopInterpreter { step_loop: v2_eval_step_loop, identity: ^v2_eval_step_loop },
    bind: BindInterpreter { bind_value: v2_eval_bind_value, identity: ^v2_eval_bind_value },
    match: MatchInterpreter { choose_arm: runtime_reject_match_arm, identity: ^runtime_reject_match_arm }
  }
}

fn tcc_interp_match_stub_body() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: v2_eval_allocate_literal, identity: ^v2_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: v2_eval_call_primitive, identity: ^v2_eval_call_primitive },
    branch: BranchInterpreter { choose_branch: v2_eval_choose_branch, identity: ^v2_eval_choose_branch },
    loop: LoopInterpreter { step_loop: v2_eval_step_loop, identity: ^v2_eval_step_loop },
    bind: BindInterpreter { bind_value: v2_eval_bind_value, identity: ^v2_eval_bind_value },
    match: MatchInterpreter { choose_arm: tcc_stub_choose_arm, identity: ^tcc_stub_choose_arm }
  }
}

fn tcc_witness_match_default_body() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^v2_eval_allocate_literal,
    call_primitive: ^v2_eval_call_primitive,
    choose_branch: ^v2_eval_choose_branch,
    step_loop: ^v2_eval_step_loop,
    bind_value: ^v2_eval_bind_value,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn tcc_witness_match_stub_body() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^v2_eval_allocate_literal,
    call_primitive: ^v2_eval_call_primitive,
    choose_branch: ^v2_eval_choose_branch,
    step_loop: ^v2_eval_step_loop,
    bind_value: ^v2_eval_bind_value,
    choose_arm: ^tcc_stub_choose_arm
