module v2.test.manual.test_claim_cache_digest_sensitivity


fn tcc_cache_pass_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^tcc_cache_pass_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn tcc_cache_fail_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^tcc_cache_fail_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn tcc_cache_root() -> v2.std.node.Node {
  v2.test.lens_common.infer_fixture.claim_atom_node(s: ^tcc_cache_root_sym)
}

fn tcc_cache_eval_node_a() -> v2.std.node.Node {
  v2.test.lens_common.infer_fixture.claim_atom_node(s: ^tcc_cache_eval_a_sym)
}

fn tcc_cache_eval_node_b() -> v2.std.node.Node {
  v2.test.lens_common.infer_fixture.claim_atom_node(s: ^tcc_cache_eval_b_sym)
}

fn tcc_cache_tree_facts_for_reason(reason: v2.std.node.Symbol) -> v2.compiler.inferred_tree.InferredTree {
  v2.test.lens_common.infer_fixture.claim_inferred_tree(
    root: tcc_cache_root(),
    facts: v2.test.lens_common.infer_fixture.claim_inferred_facts(
      type_symbol: reason,
      algebra_symbol: ^tcc_cache_facts_algebra_sym,
      descent_symbol: ^tcc_cache_facts_descent_sym,
    )
  )
}

fn tcc_cache_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_v4_evaluator()
}

fn tcc_cache_stub_claim() -> v2.std.verification.TestClaim {
  v2.std.verification.CompilesClaim {
    label: "manual/test_claim_cache: digest sensitivity scaffold",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
    input: tcc_cache_pass_node(),
    expected_value: tcc_cache_pass_node()
  }
}

fn tcc_cache_subject(
  tree: v2.compiler.inferred_tree.InferredTree,
  evaluator_input: v2.std.node.Node
) -> v2.compiler.eval.TestClaimEvalSubject<v2.std.node.Node> {
  v2.compiler.eval.TestClaimEvalSubject {
    claim: tcc_cache_stub_claim(),
    context: tcc_cache_eval_context(),
    tree: tree,
    input: v2.compiler.eval.test_claim_typed_input_node(
      evaluator_input: evaluator_input,
      evaluator_pin: ^tcc_cache_evaluator_pin
    )
  }
}

test fn tcc_cache_facts_diagnostic_digest_differs() -> Bool {
  let tree_a = tcc_cache_tree_facts_for_reason(reason: ^tcc_cache_facts_diag_a)
  let tree_b = tcc_cache_tree_facts_for_reason(reason: ^tcc_cache_facts_diag_b)
  let hash_a = v2.compiler.eval.test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree_a, evaluator_input: tcc_cache_eval_node_a())
  )
  let hash_b = v2.compiler.eval.test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree_b, evaluator_input: tcc_cache_eval_node_a())
  )
  hash_a != hash_b
}

fn tcc_cache_diagnostic_claim(expected_reason: v2.std.node.Symbol) -> v2.std.verification.TestClaim {
  v2.std.verification.DiagnosticClaim {
    label: "manual/test_claim_cache: diagnostic claim hash scaffold",
    anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
    classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
    input: tcc_cache_root(),
    expected_rejection: v2.std.diagnostic.diagnostics_singleton(
      d: v2.std.diagnostic.Diagnostic {
        reason: expected_reason,
        at: v2.std.diagnostic.node_locus(node: tcc_cache_root()),
        correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
      }
    )
  }
}

test fn tcc_cache_compiles_equals_same_nodes_claim_hash_differs() -> Bool {
  let node_x = tcc_cache_root()
  let node_y = tcc_cache_pass_node()
  v2.compiler.eval.test_claim_claim_hash_digest(
    c: v2.std.verification.CompilesClaim {
      label: "manual/test_claim_cache: compiles shape",
      anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
      input: node_x,
      expected_value: node_y
    }
  ) != v2.compiler.eval.test_claim_claim_hash_digest(
    c: v2.std.verification.EqualsClaim {
      label: "manual/test_claim_cache: equals shape",
      anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
      classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit },
      lhs: node_x,
      rhs: node_y
    }
  )
}

test fn tcc_cache_diagnostic_reason_claim_hash_differs() -> Bool {
  v2.compiler.eval.test_claim_claim_hash_digest(c: tcc_cache_diagnostic_claim(expected_reason: ^tcc_cache_expected_diag_a)) !=
    v2.compiler.eval.test_claim_claim_hash_digest(c: tcc_cache_diagnostic_claim(expected_reason: ^tcc_cache_expected_diag_b))
}

test fn tcc_cache_evaluator_input_digest_differs() -> Bool {
  let tree = tcc_cache_tree_facts_for_reason(reason: ^tcc_cache_facts_diag_a)
  let hash_a = v2.compiler.eval.test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree, evaluator_input: tcc_cache_eval_node_a())
  )
  let hash_b = v2.compiler.eval.test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree, evaluator_input: tcc_cache_eval_node_b())
  )
  hash_a != hash_b
}

test fn tcc_cache_ineligible_interpretation_digest_differs() -> Bool {
  let digest_a = v2.compiler.eval.test_claim_interpretation_cache_digest(
    context: v2.compiler.eval.eval_context_with_semantics(
      runtime_identity: ^tcc_cache_ineligible_pin_a,
      interpretation: v2.compiler.eval.eval_default_interpretation(),
      structure_witness: v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation_structure_witness()
    )
  )
  let digest_b = v2.compiler.eval.test_claim_interpretation_cache_digest(
    context: v2.compiler.eval.eval_context_with_semantics(
      runtime_identity: ^tcc_cache_ineligible_pin_b,
      interpretation: v2.compiler.eval.eval_default_interpretation(),
      structure_witness: v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation_structure_witness()
    )
  )
  digest_a != digest_b
}

data tcc_cache_byte_limb_base: Int = 256
data tcc_cache_int_one: Int = 1
data tcc_cache_int_two: Int = 2

fn tcc_cache_byte_offset_pow_2() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_4() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_2(), b: tcc_cache_byte_offset_pow_2())
}

fn tcc_cache_byte_offset_pow_8() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_4(), b: tcc_cache_byte_offset_pow_4())
}

fn tcc_cache_byte_offset_pow_9() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_8(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_12() -> Int {
  v2.std.integer.int_mul(
    a: tcc_cache_byte_offset_pow_9(),
    b: v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base))
  )
}

fn tcc_cache_byte_offset_pow_13() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_12(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_16() -> Int {
  v2.std.integer.int_mul(
    a: tcc_cache_byte_offset_pow_13(),
    b: v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base))
  )
}

fn tcc_cache_byte_offset_pow_19() -> Int {
  v2.std.integer.int_mul(
    a: tcc_cache_byte_offset_pow_16(),
    b: v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base))
  )
}

fn tcc_cache_byte_offset_pow_20() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_19(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_21() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_20(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_22() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_21(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_28() -> Int {
  v2.std.integer.int_mul(
    a: tcc_cache_byte_offset_pow_22(),
    b: v2.std.integer.int_mul(
      a: tcc_cache_byte_limb_base,
      b: v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: v2.std.integer.int_mul(a: tcc_cache_byte_limb_base, b: tcc_cache_byte_limb_base))
    )
  )
}

fn tcc_cache_byte_offset_pow_29() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_28(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_pow_36() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_28(), b: tcc_cache_byte_offset_pow_8())
}

fn tcc_cache_byte_offset_pow_37() -> Int {
  v2.std.integer.int_mul(a: tcc_cache_byte_offset_pow_36(), b: tcc_cache_byte_limb_base)
}

fn tcc_cache_byte_offset_exact_ceiling() -> Int {
  v2.std.integer.int_add(a: tcc_cache_byte_offset_pow_9(), b: v2.std.integer.int_negate(a: tcc_cache_int_one))
}

fn tcc_cache_byte_offset_over_ceiling() -> Int {
  tcc_cache_byte_offset_pow_9()
}

fn tcc_cache_byte_offset_same_quotient() -> Int {
  v2.std.integer.int_add(a: tcc_cache_byte_offset_over_ceiling(), b: tcc_cache_byte_limb_base)
}

// DEMOTED (retirement candidates, 2026-08-19): the TEN byte-offset rows below assert
// digest discrimination in the over-ceiling / limb-exhaustion regime, which begins at
// 256^9 = 2^72 — above i64::MAX. Every pow_9..pow_37 fixture is therefore unrepresentable,
// so the pairs these rows compare cannot be constructed at all: the regime is unreachable
// from any representable Int, and the claims cannot be stated with executable fixtures on
// this realization. The digest algorithm itself does not alias on these pairs (symbolic
// simulation of the limb arithmetic: all pairs differ) — the defect is in the fixtures,
// not in the thing they test.
//
// COUNT CORRECTED FROM EIGHT TO TEN (gunbc#8505 follow-up). The first two rows here —
// exact_ceiling_digest_differs_from_over_ceiling and
// same_quotient_low_limbs_digest_differs — were left as `test fn` when their eight
// siblings were demoted, and they reach pow_9 through
// tcc_cache_byte_offset_over_ceiling exactly as the others do. They were demoted by
// enumeration rather than by the property, so two members of the class were missed.
//
// WHY THAT SURVIVED CI AND THEN BROKE main: the earlier description of this regime said
// `a * b` wraps silently in release mode, and the two rows passed on that behaviour by
// comparing 0 against 0 — a VACUOUS pass, not a real one. Int multiplication now refuses
// with a typed located diagnostic (`integer overflow: 4294967296 * 4294967296 does not
// fit in a 64-bit Int`) instead of wrapping, which is the correct fail-closed behaviour
// and turned the vacuous pass into an honest failure. main went red at f44a1254 with
// failed=2, both of them. The rows did not regress; the silence that hid them was
// removed.
fn tcc_cache_byte_offset_exact_ceiling_digest_differs_from_over_ceiling() -> Bool {
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_exact_ceiling())) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_over_ceiling()))
}

fn tcc_cache_byte_offset_same_quotient_low_limbs_digest_differs() -> Bool {
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_over_ceiling())) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_same_quotient()))
}

fn tcc_cache_byte_offset_sign_over_ceiling_digest_differs() -> Bool {
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_over_ceiling())) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: 0 - tcc_cache_byte_offset_over_ceiling()))
}

fn tcc_cache_byte_offset_large_overflow_quotient_digest_differs() -> Bool {
  let overflow_quotient = tcc_cache_byte_offset_pow_13()
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: overflow_quotient)) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: v2.std.integer.int_mul(a: tcc_cache_int_two, b: overflow_quotient)))
}

fn tcc_cache_byte_offset_exhausted_residual_quotient_digest_differs() -> Bool {
  let overflow_quotient = tcc_cache_byte_offset_pow_19()
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: overflow_quotient)) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: v2.std.integer.int_mul(a: tcc_cache_int_two, b: overflow_quotient)))
}

fn tcc_cache_byte_offset_exhausted_residual_adjacent_power_digest_differs() -> Bool {
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_pow_19())) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_pow_20()))
}

fn tcc_cache_byte_offset_exhausted_residual_adjacent_power_21_22_digest_differs() -> Bool {
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_pow_21())) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_pow_22()))
}

fn tcc_cache_byte_offset_exhausted_residual_21_double_digest_differs() -> Bool {
  v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: tcc_cache_byte_offset_pow_21())) !=
    v2.std.node.byte_offset_cache_key_fingerprint(key: v2.std.node.byte_offset_cache_key(i: v2.std.integer.int_mul(a: tcc_cache_int_two, b: tcc_cache_byte_offset_pow_21())))
