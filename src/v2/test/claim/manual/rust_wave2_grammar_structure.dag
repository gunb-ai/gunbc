module v2.test.manual.rust_wave2_grammar_structure
import v2.std.language_model { LanguageModel }

import v2.extdeps.languages.rust {
  rust_formal_production_list_has_lhs,
  rust_language_model_wave2,
  rust_wave2_formal_productions,
  rust_wave2_lex_rules
}
import v2.std.grammar { grammar_carries_symbol }
import v2.std.compilers.lexing { lex_rule_set_token_class_member }
import v2.std.logic { Bool }
import v2.std.diagnostic { Accepted, Outcome, Rejected }

fn rust_wave2_grammar_structure_satisfied(lm: LanguageModel) -> Bool {
  lex_rule_set_token_class_member(rules: rust_wave2_lex_rules(), token_class: ^rust_token_kw_let) &&
    lex_rule_set_token_class_member(rules: rust_wave2_lex_rules(), token_class: ^rust_token_kw_else) &&
    rust_formal_production_list_has_lhs(
      productions: rust_wave2_formal_productions(),
      lhs: ^rust_production_mvp1_fn_add
    ) &&
    rust_formal_production_list_has_lhs(
      productions: rust_wave2_formal_productions(),
      lhs: ^rust_production_fn_item
    ) &&
    rust_formal_production_list_has_lhs(
      productions: rust_wave2_formal_productions(),
      lhs: ^rust_production_if_expr
    ) &&
    rust_formal_production_list_has_lhs(
      productions: rust_wave2_formal_productions(),
      lhs: ^rust_production_type
    ) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_fn_item) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_typed_param) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_param_list) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_type) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_block) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_stmt) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_let_stmt) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_if_expr) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: ^rust_production_return_expr)
}

fn rust_wave2_grammar_structure_outcome_satisfied(lm: Outcome<LanguageModel>) -> Bool {
  match lm {
    Accepted { value: model, diagnostics: _ } =>
      rust_wave2_grammar_structure_satisfied(lm: model)
    Rejected { diagnostics: _ } => false
  }
}

data rust_wave2_grammar_structure_ready: Bool = rust_wave2_grammar_structure_outcome_satisfied(lm: rust_language_model_wave2())
