module v2.test.manual.dissolution_subsumption_reverification


type MechanicalReverificationReportAuthority
  = LensCiTestClaimRunner
  | ReportAuthorityUnavailable

type MechanicalReverificationExecution
  = Completed { report_authority: MechanicalReverificationReportAuthority }
  | Failed
  | NotRun
  | ReportUnavailable

type MechanicalReverificationRun {
  test_claim: v2.lens.subsumption.TestClaimId
  applied_root_fix: v2.lens.subsumption.DiffId
  execution: MechanicalReverificationExecution
  findings_before: Set<v2.lens.subsumption.DiffId>
  findings_after: Set<v2.lens.subsumption.DiffId>
}

type MechanicalReverificationError
  = NonMechanicalRow
  | TestClaimMismatch { expected: v2.lens.subsumption.TestClaimId, observed: v2.lens.subsumption.TestClaimId }
  | RootFixMismatch { expected: v2.lens.subsumption.DiffId, observed: v2.lens.subsumption.DiffId }
  | TestClaimExecutionNotAuthoritative { execution: MechanicalReverificationExecution }
  | SubsumedFixMissingBefore { fix: v2.lens.subsumption.DiffId }
  | SubsumedFixStillPresentAfter { fix: v2.lens.subsumption.DiffId }

type MechanicalReverificationVerdict
  = Verified
  | NotVerified { diagnostic: MechanicalReverificationError }
  | Unverifiable { diagnostic: MechanicalReverificationError }

type OptionalDiffId
  = DiffIdAbsent
  | DiffIdPresent { value: v2.lens.subsumption.DiffId }

fn subsumption_symbol_node(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn subsumption_template_leaf_node(row: v2.lens.subsumption.DissolutionSubsumption) -> Node {
  let fix = v2.lens.subsumption.DiffId { id: ^emit_rust_template_leaf_fix }
  if row.subsumed_fixes.member(fix) {
    subsumption_symbol_node(s: ^emit_rust_template_leaf_fix)
  } else {
    subsumption_symbol_node(s: ^subsumption_runtime_rejected)
  }
}

fn subsumption_name_dispatch_leaf_node(row: v2.lens.subsumption.DissolutionSubsumption) -> Node {
  let fix = v2.lens.subsumption.DiffId { id: ^emit_rust_name_dispatch_leaf_fix }
  if row.subsumed_fixes.member(fix) {
    subsumption_symbol_node(s: ^emit_rust_name_dispatch_leaf_fix)
  } else {
    subsumption_symbol_node(s: ^subsumption_runtime_rejected)
  }
}

fn subsumption_receipt_node(row: v2.lens.subsumption.DissolutionSubsumption) -> Node {
  match row.verification {
    MechanicalReverification { test_claim: claim } =>
      v2.std.node.Node {
        kind: v2.std.node.ComputationNode { behavior: Value },
        children: [
          v2.std.node.Edge {
            label: Named { name: ^subsumption_root_fix_edge },
            target: subsumption_symbol_node(s: row.root_fix.id)
          },
          v2.std.node.Edge {
            label: Named { name: ^subsumption_first_leaf_edge },
            target: subsumption_template_leaf_node(row: row)
          },
          v2.std.node.Edge {
            label: Named { name: ^subsumption_second_leaf_edge },
            target: subsumption_name_dispatch_leaf_node(row: row)
          },
          v2.std.node.Edge {
            label: Named { name: ^subsumption_mechanical_claim_edge },
            target: subsumption_symbol_node(s: claim.id)
          }
        ],
        occurrence_id: SyntheticOccurrence
}
    ProducerStageDerivation { derivation_path: _ } =>
      subsumption_symbol_node(s: ^subsumption_runtime_rejected)
  }
}

fn expected_rust_language_model_emit_receipt_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Value },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^subsumption_root_fix_edge },
        target: subsumption_symbol_node(s: ^rust_language_model_emit_root_fix)
      },
      v2.std.node.Edge {
        label: Named { name: ^subsumption_first_leaf_edge },
        target: subsumption_symbol_node(s: ^emit_rust_template_leaf_fix)
      },
      v2.std.node.Edge {
        label: Named { name: ^subsumption_second_leaf_edge },
        target: subsumption_symbol_node(s: ^emit_rust_name_dispatch_leaf_fix)
      },
      v2.std.node.Edge {
        label: Named { name: ^subsumption_mechanical_claim_edge },
        target: subsumption_symbol_node(s: ^rust_language_model_emit_mechanical_reverification_claim)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn completed_lens_ci_execution() -> MechanicalReverificationExecution {
  Completed { report_authority: LensCiTestClaimRunner }
}

fn mechanical_reverification_execution_for_run(run: v2.compiler.eval.TestClaimRun<Node, RuntimeValue>) -> MechanicalReverificationExecution {
  match run.verdict {
    Pass => completed_lens_ci_execution()
    SemanticMismatch { actual: _, falsification: _ } => Failed
    BuildFailed { actual: _, diagnostic: _ } => Failed
    RunFailed { actual: _, diagnostic: _ } => Failed
    Deferred { actual: _, diagnostic: _ } => ReportUnavailable
  }
}

fn missing_subsumed_fix_before(expected: Set<v2.lens.subsumption.DiffId>, observed: Set<v2.lens.subsumption.DiffId>) -> OptionalDiffId {
  let template = v2.lens.subsumption.DiffId { id: ^emit_rust_template_leaf_fix }
  let name_dispatch = v2.lens.subsumption.DiffId { id: ^emit_rust_name_dispatch_leaf_fix }
  if expected.member(template) && !observed.member(template) {
    DiffIdPresent { value: template }
  } else if expected.member(name_dispatch) && !observed.member(name_dispatch) {
    DiffIdPresent { value: name_dispatch }
  } else {
    DiffIdAbsent
  }
}

fn surviving_subsumed_fix_after(observed: Set<v2.lens.subsumption.DiffId>) -> OptionalDiffId {
  let template = v2.lens.subsumption.DiffId { id: ^emit_rust_template_leaf_fix }
  let name_dispatch = v2.lens.subsumption.DiffId { id: ^emit_rust_name_dispatch_leaf_fix }
  if observed.member(template) {
    DiffIdPresent { value: template }
  } else if observed.member(name_dispatch) {
    DiffIdPresent { value: name_dispatch }
  } else {
    DiffIdAbsent
  }
}

fn mechanical_reverification_verdict(
  row: v2.lens.subsumption.DissolutionSubsumption,
  run: MechanicalReverificationRun
) -> MechanicalReverificationVerdict {
  match row.verification {
    MechanicalReverification { test_claim: expected_claim } =>
      if expected_claim == run.test_claim {
        if row.root_fix == run.applied_root_fix {
          if run.execution == completed_lens_ci_execution() {
            match missing_subsumed_fix_before(
              expected: row.subsumed_fixes,
              observed: run.findings_before
            ) {
              DiffIdPresent { value: missing } =>
                Unverifiable { diagnostic: SubsumedFixMissingBefore { fix: missing } }
              DiffIdAbsent =>
                match surviving_subsumed_fix_after(observed: run.findings_after) {
                  DiffIdPresent { value: surviving } =>
                    NotVerified { diagnostic: SubsumedFixStillPresentAfter { fix: surviving } }
                  DiffIdAbsent => Verified
                }
            }
          } else {
            Unverifiable {
              diagnostic: TestClaimExecutionNotAuthoritative { execution: run.execution }
            }
          }
        } else {
          Unverifiable {
            diagnostic: RootFixMismatch {
              expected: row.root_fix,
              observed: run.applied_root_fix
            }
          }
        }
      } else {
        Unverifiable {
          diagnostic: TestClaimMismatch {
            expected: expected_claim,
            observed: run.test_claim
          }
        }
      }
    ProducerStageDerivation { derivation_path: _ } =>
      Unverifiable { diagnostic: NonMechanicalRow }
  }
}

fn mechanical_reverification_verdict_node(v: MechanicalReverificationVerdict) -> Node {
  match v {
    Verified => subsumption_symbol_node(s: ^mechanical_reverification_verified)
    NotVerified { diagnostic: _ } => subsumption_symbol_node(s: ^mechanical_reverification_not_verified)
    Unverifiable { diagnostic: _ } => subsumption_symbol_node(s: ^mechanical_reverification_unverifiable)
  }
}

fn subsumption_runtime_unit(node: Node) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeUnit {
    value: v2.std.runtime.RuntimeUnitValue { unit_type: node }
  }
}

fn subsumption_allocate_literal(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: subsumption_runtime_unit(node: node), diagnostics: v2.std.diagnostic.None }
}

fn subsumption_reject_runtime(node: Node) -> Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^subsumption_runtime_rejected, node: node)
    )
  }
}

fn subsumption_call_primitive(
  node: Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<v2.std.runtime.RuntimeValue> {
  subsumption_reject_runtime(node: node)
}

fn subsumption_choose_branch(
  node: Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<Node> {
  v2.std.diagnostic.Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^subsumption_runtime_rejected, node: node)
    )
  }
}

fn subsumption_step_loop(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Accepted { value: v2.std.runtime.Continue { value: subsumption_runtime_unit(node: node) }, diagnostics: v2.std.diagnostic.None }
}

fn subsumption_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: v2.std.diagnostic.None }
}

fn subsumption_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: subsumption_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: subsumption_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: subsumption_choose_branch
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: subsumption_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: subsumption_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: runtime_reject_match_arm
    }
  }
}

fn subsumption_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^subsumption_descent_dimension }
  }
}

fn subsumption_facts(node: Node) -> v2.compiler.infer.InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: node,
    descent: v2.std.witness.Holds { value: subsumption_termination_proof() }
  )
}

fn subsumption_fact_lookup(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_present(value: subsumption_facts(node: node))
}

fn subsumption_inferred_tree(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: subsumption_fact_lookup
    }
  }
}

fn subsumption_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^subsumption_allocate_literal_sym,
    call_primitive: ^subsumption_call_primitive_sym,
    choose_branch: ^subsumption_choose_branch_sym,
    step_loop: ^subsumption_step_loop_sym,
    bind_value: ^subsumption_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn subsumption_context() -> v2.compiler.eval.EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^subsumption_interpretation_pin,
    interpretation: subsumption_interpretation(),
    structure_witness: subsumption_interpretation_structure_witness()
  )
}

data claim_rust_language_model_emit_mechanical_reverification: v2.std.verification.TestClaim = v2.std.verification.StructuralEqualsClaim {
  label: "dissolution subsumption rust LanguageModel emit row receipt",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: subsumption_receipt_node(row: rust_language_model_emit_subsumption),
  rhs: expected_rust_language_model_emit_receipt_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}

data subject_rust_language_model_emit_mechanical_reverification_claim: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_rust_language_model_emit_mechanical_reverification,
  context: subsumption_context(),
  tree: subsumption_inferred_tree(
    root: subsumption_receipt_node(row: rust_language_model_emit_subsumption)
  ),
  evaluator_pin: ^subsumption_evaluator_pin
)

data run_rust_language_model_emit_mechanical_reverification_claim: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_rust_language_model_emit_mechanical_reverification_claim
)

fn rust_language_model_emit_observed_before_value() -> Set<v2.lens.subsumption.DiffId> {
  std.types.Set {
    member: fn(d) {
      d.id == ^emit_rust_template_leaf_fix ||
        d.id == ^emit_rust_name_dispatch_leaf_fix
    }
  }
}

data rust_language_model_emit_observed_before: Set<v2.lens.subsumption.DiffId> = rust_language_model_emit_observed_before_value()

fn rust_language_model_emit_observed_after_value() -> Set<v2.lens.subsumption.DiffId> {
  std.types.Set {
    member: fn(_) {
      false
    }
  }
}

data rust_language_model_emit_observed_after: Set<v2.lens.subsumption.DiffId> = rust_language_model_emit_observed_after_value()

data rust_language_model_emit_lens_ci_report: MechanicalReverificationRun = MechanicalReverificationRun {
  test_claim: v2.lens.subsumption.TestClaimId { id: ^rust_language_model_emit_mechanical_reverification_claim },
  applied_root_fix: v2.lens.subsumption.DiffId { id: ^rust_language_model_emit_root_fix },
  execution: mechanical_reverification_execution_for_run(
    run: run_rust_language_model_emit_mechanical_reverification_claim
  ),
  findings_before: rust_language_model_emit_observed_before,
  findings_after: rust_language_model_emit_observed_after
}

data verdict_rust_language_model_emit_subsumption: MechanicalReverificationVerdict = mechanical_reverification_verdict(
  row: rust_language_model_emit_subsumption,
  run: rust_language_model_emit_lens_ci_report
)

data claim_rust_language_model_emit_subsumption_reverifies: v2.std.verification.TestClaim = v2.std.verification.StructuralEqualsClaim {
  label: "dissolution subsumption rust LanguageModel emit row verifies Lens-CI verdict",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: mechanical_reverification_verdict_node(v: verdict_rust_language_model_emit_subsumption),
  rhs: mechanical_reverification_verdict_node(v: Verified),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}

data subject_rust_language_model_emit_subsumption_reverifies: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_rust_language_model_emit_subsumption_reverifies,
  context: subsumption_context(),
  tree: subsumption_inferred_tree(
    root: mechanical_reverification_verdict_node(v: verdict_rust_language_model_emit_subsumption)
  ),
  evaluator_pin: ^subsumption_evaluator_pin
)

data run_rust_language_model_emit_subsumption_reverifies: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_rust_language_model_emit_subsumption_reverifies
)
