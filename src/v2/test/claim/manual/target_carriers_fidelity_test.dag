module v2.test.manual.target_carriers_fidelity

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data target_carriers_probe_text: String = "fn add(x:Int, y:Int) -> Int { x + y }"

test fn dag_target_advertises_declared_loss() -> Bool {
  match decode_fidelity_from_target(target: dag_target_model()) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossy => true
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn rust_target_advertises_lossless() -> Bool {
  match decode_fidelity_from_target(target: rust_target_model()) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossless => true
        Lossy => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn dag_emit_medium_matches_compose_up() -> Bool {
  match target_source_medium(
    text: target_carriers_probe_text,
    target: dag_target_model()
  ) {
    Accepted { value: medium, diagnostics: _ } =>
      match medium.fidelity {
        Lossy => medium.carried == target_carriers_probe_text
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn dag_serialize_source_advertises_declared_loss() -> Bool {
  match target_serialize_source_from_model(
    target: dag_target_model(),
    emitted: dag_fixture_emitted_add_fn
  ) {
    Accepted { value: medium, diagnostics: _ } =>
      match medium.fidelity {
        Lossy => true
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn red_dag_emit_mis_tags_lossless() -> Bool {
  match target_serialize_source_from_model(
    target: dag_target_model(),
    emitted: dag_fixture_emitted_add_fn
  ) {
    Accepted { value: medium, diagnostics: _ } =>
      match medium.fidelity {
        Lossless => true
        Lossy => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn perturbed_quotient_fidelity_is_lossless() -> Bool {
  match decode_fidelity_from_target(
    target: dag_target_model_lossless_fidelity_quotient()
  ) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossless => true
        Lossy => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn perturbed_quotient_fidelity_red_if_still_lossy() -> Bool {
  match decode_fidelity_from_target(
    target: dag_target_model_lossless_fidelity_quotient()
  ) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossy => true
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

