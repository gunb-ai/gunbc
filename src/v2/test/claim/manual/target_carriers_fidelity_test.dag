module v2.test.manual.target_carriers_fidelity

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data target_carriers_probe_text: String = "fn add(x:Int, y:Int) -> Int { x + y }"

fn dag_target_advertises_declared_loss() -> Bool {
  match decode_fidelity_from_target(target: dag_target_model()) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossy => true
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn rust_target_advertises_lossless() -> Bool {
  match decode_fidelity_from_target(target: rust_target_model_staging()) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossless => true
        Lossy => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn dag_emit_medium_matches_compose_up() -> Bool {
  match target_source_medium(
    text: target_carriers_probe_text,
    target: dag_target_model()
  ) {
    Accepted { value: medium, diagnostics: _ } =>
      match medium.fidelity {
        Lossy => medium.carried == target_carriers_probe_text
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn dag_serialize_source_advertises_declared_loss() -> Bool {
  match target_serialize_source_from_model(
    target: dag_target_model(),
    emitted: dag_fixture_emitted_add_fn
  ) {
    Accepted { value: medium, diagnostics: _ } =>
      match medium.fidelity {
        Lossy => true
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn red_dag_emit_mis_tags_lossless() -> Bool {
  match target_serialize_source_from_model(
    target: dag_target_model(),
    emitted: dag_fixture_emitted_add_fn
  ) {
    Accepted { value: medium, diagnostics: _ } =>
      match medium.fidelity {
        Lossless => true
        Lossy => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn perturbed_quotient_fidelity_is_lossless() -> Bool {
  match decode_fidelity_from_target(
    target: dag_target_model_lossless_fidelity_quotient()
  ) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossless => true
        Lossy => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn perturbed_quotient_fidelity_red_if_still_lossy() -> Bool {
  match decode_fidelity_from_target(
    target: dag_target_model_lossless_fidelity_quotient()
  ) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossy => true
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn target_carriers_declared_loss_fidelity_holds() -> Bool {
  dag_target_advertises_declared_loss()
    && rust_target_advertises_lossless()
    && dag_emit_medium_matches_compose_up()
    && dag_serialize_source_advertises_declared_loss()
    && !red_dag_emit_mis_tags_lossless()
    && perturbed_quotient_fidelity_is_lossless()
    && !perturbed_quotient_fidelity_red_if_still_lossy()
}

fn fidelity_quotient_bundle(edges: List<Edge>) -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: edges)
}

fn fidelity_quotient_edge() -> Edge {
  Edge {
    label: Named { name: ^target_model_edge_fidelity_quotient },
    target: node_synthetic(kind: TypeNode { connective: Conj }, children: [])
  }
}

// A target bundle carrying two fidelity-quotient edges contradicts itself: it refuses, where it
// used to read as carrying none and decode Lossless. One edge is Present and none is Absent.
test fn target_carriers_ambiguous_fidelity_quotient_refuses() -> Bool {
  let none_absent = match bundle_fidelity_quotient_optional(bundle: fidelity_quotient_bundle(edges: [])) {
    Accepted { value: Absent, diagnostics: _ } => true
    _ => false
  }
  let one_present = match bundle_fidelity_quotient_optional(
    bundle: fidelity_quotient_bundle(edges: [fidelity_quotient_edge()])
  ) {
    Accepted { value: Present { value: _ }, diagnostics: _ } => true
    _ => false
  }
  let two_refused = match bundle_fidelity_quotient_optional(
    bundle: fidelity_quotient_bundle(edges: [fidelity_quotient_edge(), fidelity_quotient_edge()])
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
  none_absent && one_present && two_refused
}
