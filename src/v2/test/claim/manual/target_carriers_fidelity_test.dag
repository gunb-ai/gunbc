module v2.test.manual.target_carriers_fidelity

import extdeps.communication.medium { Lossless, Lossy, Medium }
import v2.compiler.target_carriers {
  decode_fidelity_from_target,
  target_source_medium
}
import v2.extdeps.languages.dag { dag_mvp1_target_model }
import v2.extdeps.languages.rust { rust_mvp1_target_model }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }

data target_carriers_probe_text: String = "fn add(x:Int, y:Int) -> Int { x + y }"

fn dag_target_advertises_declared_loss() -> Bool {
  match decode_fidelity_from_target(target: dag_mvp1_target_model()) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossy => true
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn rust_target_advertises_lossless() -> Bool {
  match decode_fidelity_from_target(target: rust_mvp1_target_model()) {
    Accepted { value: fidelity, diagnostics: _ } =>
      match fidelity {
        Lossless => true
        Lossy => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn dag_emit_medium_matches_compose_up() -> Bool {
  match target_source_medium(
    text: target_carriers_probe_text,
    target: dag_mvp1_target_model()
  ) {
    Accepted { value: medium, diagnostics: _ } =>
      match medium.fidelity {
        Lossy => medium.carried == target_carriers_probe_text
        Lossless => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn target_carriers_declared_loss_fidelity_holds() -> Bool {
  dag_target_advertises_declared_loss()
    && rust_target_advertises_lossless()
    && dag_emit_medium_matches_compose_up()
}
