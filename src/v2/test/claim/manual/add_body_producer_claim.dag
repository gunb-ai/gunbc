module v2.test.manual.add_body_producer_claim


fn add_body_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^add_body_producer_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^add_body_producer_fail } },
      children: []
    )
  }
}

fn add_body_table_fixture_arrow_accepts() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      well_formed(n: arrow)
        && match find_arrow_body_child(root: arrow) {
          Accepted { value: body, diagnostics: _ } =>
            match body.kind {
              ComputationNode { behavior: _ } => true
              _ => false
            }
          Rejected { diagnostics: _ } => false
        }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_swapped_operand_body() -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_token_plus } },
          children: []
        )
      },
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_param_y } },
          children: []
        )
      },
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_param_x } },
          children: []
        )
      }
    ]
  )
}

fn add_body_operand_order_differs() -> Bool {
  let canonical = dag_add_binary_body_fixture
  let swapped = add_arrow_swapped_operand_body()
  canonical != swapped
}

fn add_body_arrow_with_atom_body_rejects() -> Bool {
  let arrow = node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
          children: []
        )
      },
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
          children: []
        )
      },
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
          children: []
        )
      },
      Edge {
        label: Named { name: ^arrow_body_edge },
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^add_body_producer_fail } },
          children: []
        )
      }
    ]
  )
  !well_formed(n: arrow)
}

fn add_body_edge_targets_binary_transform() -> Bool {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match find_arrow_body_child(root: arrow) {
        Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            ComputationNode { behavior: Transform } => true
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data claim_add_body_producer_well_formed: TestClaim = EqualsClaim {
  label: "manual/add_arrow: table_fixture_add_arrow_with_body is well-formed with Arrow.body Behavior subtree",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: add_body_bool_node(pass: add_body_table_fixture_arrow_accepts()),
  rhs: add_body_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_add_body_operand_order_discriminates: TestClaim = EqualsClaim {
  label: "manual/add_arrow: swapped operand param refs change body subtree (discriminating red for eval follow-up)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: add_body_bool_node(pass: add_body_operand_order_differs()),
  rhs: add_body_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_add_body_is_transform: TestClaim = EqualsClaim {
  label: "manual/add_arrow: Arrow.body target is ComputationNode Transform for add",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: add_body_bool_node(pass: add_body_edge_targets_binary_transform()),
  rhs: add_body_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_add_body_arrow_body_rejects_non_computation_target: TestClaim = EqualsClaim {
  label: "manual/add_arrow: Arrow.body with TypeNode atom target rejects well_formed (E-9 target-shape authority)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: add_body_bool_node(pass: add_body_arrow_with_atom_body_rejects()),
  rhs: add_body_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
