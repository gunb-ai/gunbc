module v2.test.manual.record_construct_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data record_construct_emitted_root: Node = dag_fixture_emitted_rec_fn
data record_construct_target_model: v2.std.compilers.target_model.TargetModel = dag_rec_target_model()

fn record_construct_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn record_construct_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == dag_fixture_emitted_rec_fn {
    v2.std.witness.Holds { value: record_construct_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_rec_construct_body_fixture {
    v2.std.witness.Holds { value: record_construct_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_pick_arrow_domain_conj_node() {
    v2.std.witness.Holds { value: record_construct_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_rec) {
    v2.std.witness.Holds { value: record_construct_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_int) {
    v2.std.witness.Holds {
      value: record_construct_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_rec_v) {
    v2.std.witness.Holds { value: record_construct_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_rec_lit_nine) {
    v2.std.witness.Holds { value: record_construct_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_fixture_int_inhabitant {
    v2.std.witness.Holds { value: record_construct_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    v2.std.witness.Holds {
      value: record_construct_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^record_construct_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn record_construct_inferred_facts_for(node: Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  match record_construct_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn record_construct_facts_lookup(key: Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  record_construct_inferred_facts_for(node: key)
}

data record_construct_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: record_construct_emitted_root,
  facts: std.types.Map { lookup: record_construct_facts_lookup }
}

test fn record_construct_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: v2.test.manual.record_construct_emit.record_construct_target_model,
    emitted: record_construct_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match emit(tree: record_construct_inferred_tree, target: v2.test.manual.record_construct_emit.record_construct_target_model) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn record_construct_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: v2.test.manual.record_construct_emit.record_construct_target_model,
    emitted: record_construct_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}

fn record_construct_coercion_quality_is_faithful(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

test fn record_construct_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: record_construct_emitted_root,
    tree: record_construct_inferred_tree,
    target: v2.test.manual.record_construct_emit.record_construct_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_rec_fn)
        && record_construct_coercion_quality_is_faithful(q: result.quality)
        && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn record_construct_emit_holds_keystone() -> Bool {
  record_construct_emit_holds()
}

test fn record_construct_grammar_inverse_holds_keystone() -> Bool {
  record_construct_grammar_inverse_holds()
}

test fn record_construct_ingest_via_coerce_holds_keystone() -> Bool {
  record_construct_ingest_via_coerce_matches_canonical()
}

