module v2.test.manual.structured_body_subsumption_set

import v2.std.node {
  Arrow,
  Edge,
  Node,
  Positional,
  TypeNode,
  node_synthetic
}
import v2.compiler.body_producer { produce_arrow_with_structured_body }
import v2.extdeps.languages.dag {
  dag_bind_arrow_with_body_node,
  dag_bind_let_body_node,
  dag_loop_arrow_with_body_node,
  dag_loop_body_node,
  dag_pick_arrow_domain_conj_node,
  dag_pick_arrow_with_body_node,
  dag_pick_if_body_node,
  dag_type_atom_node
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn int_pair_arrow_signature() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: dag_pick_arrow_domain_conj_node() },
      Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_type_int) },
      Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_type_int) }
    ]
  )
}

fn subsumes(structured_body: Node, table_target: Node) -> Bool {
  match produce_arrow_with_structured_body(
    signature: int_pair_arrow_signature(),
    structured_body: structured_body
  ) {
    Accepted { value: arrow_with_body, diagnostics: _ } => arrow_with_body == table_target
    Rejected { diagnostics: _ } => false
  }
}

test fn subsumption_pick() -> Bool {
  subsumes(structured_body: dag_pick_if_body_node(), table_target: dag_pick_arrow_with_body_node())
}

test fn subsumption_loop() -> Bool {
  subsumes(structured_body: dag_loop_body_node(), table_target: dag_loop_arrow_with_body_node())
}

test fn subsumption_bind() -> Bool {
  subsumes(structured_body: dag_bind_let_body_node(), table_target: dag_bind_arrow_with_body_node())
}

