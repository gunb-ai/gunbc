module v2.test.manual.structured_body_subsumption_set

fn int_pair_arrow_signature() -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.dag.dag_pick_arrow_domain_conj_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_type_int) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_binding_type_int) }
    ]
  )
}

fn subsumes(structured_body: v2.std.node.Node, table_target: v2.std.node.Node) -> Bool {
  match v2.compiler.body_producer.produce_arrow_with_structured_body(
    signature: int_pair_arrow_signature(),
    structured_body: structured_body
  ) {
    Accepted { value: arrow_with_body, diagnostics: _ } => arrow_with_body == table_target
    Rejected { diagnostics: _ } => false
  }
}

test fn subsumption_pick() -> Bool {
  subsumes(structured_body: v2.extdeps.languages.dag.dag_pick_if_body_node(), table_target: v2.extdeps.languages.dag.dag_pick_arrow_with_body_node())
}

test fn subsumption_loop() -> Bool {
  subsumes(structured_body: v2.extdeps.languages.dag.dag_loop_body_node(), table_target: v2.extdeps.languages.dag.dag_loop_arrow_with_body_node())
}

test fn subsumption_bind() -> Bool {
  subsumes(structured_body: v2.extdeps.languages.dag.dag_bind_let_body_node(), table_target: v2.extdeps.languages.dag.dag_bind_arrow_with_body_node())
}

