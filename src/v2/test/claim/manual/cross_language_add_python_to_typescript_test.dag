module v2.test.manual.cross_language_add_python_to_typescript

import v2.test.manual.python_grammar_claim {
  python_grammar_parse_fixture
}
import v2.test.manual.typescript_effect_io_emit {
  ts_effect_io_emit_holds
}
import v2.test.manual.ingest_bridge {
  ingest_bridge_realized
}

import v2.std.text { string_is_empty }
import std.algebra { Cons, Empty }
import v2.compiler.ingest {
  cross_language_compile,
  parse_tree_to_emitted_node,
  parse_tree_to_target_model_bridge
}

import v2.compiler.infer { infer }
import v2.std.inhabitant_neutralization { neutralize_core_for_target }
import v2.compiler.emit { emit }
import v2.extdeps.languages.python {
  python_emitted_add_fn_node,
  python_target_model
}
import v2.extdeps.languages.typescript { ts_target_model }

import v2.std.grammar { ParseTree }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Rejected,
  Unavailable,
  port_locus
}
import v2.std.witness { Holds, Violates, Witness }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  Unit,
  UnifiedTestClaim,
  manual_claim_anchor
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.effects { atom_node }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

type ParseTreeToTargetModelBridge {
  source_parse_tree: Symbol
  intended_target_language: Symbol
}

type ParseTreeToTargetModelBridgeCheck = Witness<ParseTreeToTargetModelBridge>

fn parse_tree_to_target_model_bridge_scaffold() -> Witness<ParseTreeToTargetModelBridge> {
  if ingest_bridge_realized() {
    Holds {
      value: ParseTreeToTargetModelBridge {
        source_parse_tree: ^ingest_bridge_hermetic_fixture_parse_tree,
        intended_target_language: ^typescript
      }
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^parse_tree_to_target_model_bridge_not_realized,
        at: port_locus(port: ^cross_language_bridge_port),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

data cross_language_python_to_typescript_bridge_check: ParseTreeToTargetModelBridgeCheck = parse_tree_to_target_model_bridge_scaffold()

test fn parse_tree_to_target_model_bridge_realized() -> Bool {
  match parse_tree_to_target_model_bridge_scaffold() {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

fn parse_tree_to_target_model_bridge_fails_closed() -> Bool {
  match parse_tree_to_target_model_bridge_scaffold() {
    Violates { diagnostic: d } => d.reason == ^parse_tree_to_target_model_bridge_not_realized
    Holds { value: _ } => false
  }
}

test fn cross_language_emit_inhabitant_neutralization_fails_closed() -> Bool {
  match infer(tree: python_emitted_add_fn_node()) {
    Accepted { value: inferred, diagnostics: _ } =>
      match emit(tree: inferred, target: ts_target_model()) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn cross_language_emit_inhabitant_neutralization_holds() -> Bool {
  match neutralize_core_for_target(
    core: python_emitted_add_fn_node(),
    target: ts_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: ts_target_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn cross_language_add_python_to_typescript_chain_status_holds() -> Bool {

  match python_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>

      match parse_tree_to_target_model_bridge(
        parse_tree: python_parse_tree,
        source_model: python_target_model()
      ) {
        Accepted { value: python_core, diagnostics: _ } =>
          python_core == python_emitted_add_fn_node()

            && cross_language_compile_on_real_tree_holds(parse_tree: python_parse_tree)
            && ts_effect_io_emit_holds()
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn cross_language_compile_on_real_tree_holds(parse_tree: ParseTree) -> Bool {
  match cross_language_compile(
    parse_tree: parse_tree,
    source_model: python_target_model(),
    target_model: ts_target_model()
  ) {
    Accepted { value: ts_source, diagnostics: _ } =>
      string_is_empty(s: ts_source.carried) == false
    Rejected { diagnostics: _ } => false
  }
}

type CrossLanguageEmitCellStatus
  = ChainProven
  | ChainFailsClosedAtCheck { check: Symbol }
  | ChainSourceNotModeled

type CrossLanguageEmitMatrixRow {
  source_language: Symbol
  target_language: Symbol
  status: CrossLanguageEmitCellStatus
}

data cross_language_emit_matrix: List<CrossLanguageEmitMatrixRow> = [

  CrossLanguageEmitMatrixRow {
    source_language: ^dag,
    target_language: ^typescript,
    status: ChainProven {}
  },

  CrossLanguageEmitMatrixRow {
    source_language: ^python,
    target_language: ^typescript,
    status: ChainProven {}
  },

  CrossLanguageEmitMatrixRow {
    source_language: ^go,
    target_language: ^typescript,
    status: ChainFailsClosedAtCheck { check: ^go_add_parse_production_currently_rejects }
  }
]

fn cross_language_bridge_realized_input(ok: Bool) -> Symbol {
  if ok {
    ^cross_language_bridge_realized
  } else {
    ^cross_language_bridge_not_realized
  }
}

data claim_cross_language_add_python_to_typescript_module_compiles: TestClaim = CompilesClaim {
  label: "manual/cross_language: python->ts add-slice end-to-end matrix claim compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_node(s: ^ingest_bridge_hermetic_fixture_parse_tree),
  expected_value: atom_node(s: ^ingest_bridge_hermetic_fixture_parse_tree),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_cross_language_parse_tree_bridge_realized: TestClaim = CompilesClaim {
  label: "manual/cross_language: ParseTree->TargetModel bridge realized (#4801) — typed check Holds (was fail-closed)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: cross_language_bridge_realized_input(ok: parse_tree_to_target_model_bridge_realized()),
  expected_value: atom_node(s: ^cross_language_bridge_realized),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
