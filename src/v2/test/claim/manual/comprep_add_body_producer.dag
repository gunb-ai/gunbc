module v2.test.manual.comprep_add_body_producer

import v2.compiler.body_producer {
  arrow_has_body_edge,
  produce_mvp1_add_arrow_with_body,
  produce_mvp1_add_arrow_with_body_from_resolved
}
import v2.extdeps.languages.dag { dag_mvp1_add_binary_body_fixture }
import v2.compiler.normalize { normalize }
import v2.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
}
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_grammar_production_mvp1_fn_add,
  dag_language_model_wave1,
  dag_mvp1_source_text
}
import v2.std.diagnostic {
  Accepted,
  Rejected,
  bind_outcome,
  outcome_accepted,
  port_locus
}
import v2.std.grammar { GrammarRoot, ParseTree }
import v2.std.compilers.lexing { Token }
import v2.std.collection { List, Set }
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  ComputationNode,
  Edge,
  Named,
  Node,
  Positional,
  Transform,
  TypeNode,
  node_synthetic,
  well_formed
}
import v2.std.node_query { find_arrow_body_child }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn comprep_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^comprep_body_producer_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^comprep_body_producer_fail } },
      children: []
    )
  }
}

fn comprep_produce_add_arrow_accepts() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      well_formed(n: arrow) && arrow_has_body_edge(arrow: arrow)
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_swapped_operand_body() -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_token_plus } },
          children: []
        )
      },
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_param_y } },
          children: []
        )
      },
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_param_x } },
          children: []
        )
      }
    ]
  )
}

fn comprep_body_operand_order_differs() -> Bool {
  let canonical = dag_mvp1_add_binary_body_fixture
  let swapped = comprep_swapped_operand_body()
  canonical != swapped
}

fn comprep_arrow_with_atom_body_rejects() -> Bool {
  let arrow = node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
          children: []
        )
      },
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
          children: []
        )
      },
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
          children: []
        )
      },
      Edge {
        label: Named { name: ^arrow_body_edge },
        target: node_synthetic(
          kind: TypeNode { connective: Atom { identity: ^comprep_body_producer_fail } },
          children: []
        )
      }
    ]
  )
  !well_formed(n: arrow)
}

fn comprep_mvp1_add_parse_root() -> GrammarRoot {
  GrammarRoot {
    start: ^dag_production_mvp1_fn_add,
    productions: [dag_grammar_production_mvp1_fn_add()],
    sync_tokens: Set {
      member: fn(_) {
        false
      }
    }
  }
}

fn comprep_parse_mvp1_add_tokens(tokens: List<Token>) -> Outcome<ParseTree> {
  let root = comprep_mvp1_add_parse_root()
  match grammar_validate_for_parse(root: root, at: port_locus(port: ^parse_stage_locus_port)) {
    Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: tokens,
        validated: validated,
        production_name: ^dag_production_mvp1_fn_add
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn comprep_source_resolved_add_arrow() -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(text: dag_mvp1_source_text, file: ^comprep_add_body_producer_source_file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: comprep_parse_mvp1_add_tokens(tokens: tokens.tokens),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn comprep_resolved_bridge_produces_well_formed_arrow() -> Bool {
  match comprep_source_resolved_add_arrow() {
    Accepted { value: resolved, diagnostics: _ } =>
      match produce_mvp1_add_arrow_with_body_from_resolved(resolved_root: resolved) {
        Accepted { value: arrow, diagnostics: _ } =>
          well_formed(n: arrow) && arrow_has_body_edge(arrow: arrow)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_body_edge_targets_binary_transform() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match find_arrow_body_child(root: arrow) {
        Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            ComputationNode { behavior: Transform } => true
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data claim_comprep_add_body_producer_well_formed: TestClaim = EqualsClaim {
  label: "manual/comprep: produce_mvp1_add_arrow_with_body is well-formed with Arrow.body Behavior subtree",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: comprep_bool_node(pass: comprep_produce_add_arrow_accepts()),
  rhs: comprep_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_comprep_add_body_operand_order_discriminates: TestClaim = EqualsClaim {
  label: "manual/comprep: swapped operand param refs change body subtree (discriminating red for eval follow-up)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: comprep_bool_node(pass: comprep_body_operand_order_differs()),
  rhs: comprep_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_comprep_add_body_is_transform: TestClaim = EqualsClaim {
  label: "manual/comprep: Arrow.body target is ComputationNode Transform for MVP add",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: comprep_bool_node(pass: comprep_body_edge_targets_binary_transform()),
  rhs: comprep_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_comprep_resolved_bridge_produces_well_formed_arrow: TestClaim = EqualsClaim {
  label: "manual/comprep: resolve→body_producer bridge yields well-formed Arrow with Behavior body from source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: comprep_bool_node(pass: comprep_resolved_bridge_produces_well_formed_arrow()),
  rhs: comprep_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_comprep_arrow_body_rejects_non_computation_target: TestClaim = EqualsClaim {
  label: "manual/comprep: Arrow.body with TypeNode atom target rejects well_formed (E-9 target-shape authority)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: comprep_bool_node(pass: comprep_arrow_with_atom_body_rejects()),
  rhs: comprep_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
