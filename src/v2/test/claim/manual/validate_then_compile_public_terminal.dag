module v2.test.manual.validate_then_compile_public_terminal



data rust_target_model_stub: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
},
  lex: VoidLexRules,
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: std.algebra.Empty,
  runtime_row: target_emit_host_runtime_row_unconfigured
}
fn claim_symbol_node(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn always_reject_lens_gate(_tree: v2.compiler.infer.InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(
      at: port_locus(port: ^rejecting_lens_gate_at)
    )
  )
}

data rejecting_lens: v2.compiler.compile.CompileLens = v2.compiler.compile.CompileLens { gate: always_reject_lens_gate }

fn grounding_sanity_gate(tree: v2.compiler.infer.InferredTree) -> Outcome<Witness<Node>> {
  outcome_accepted(v2.std.witness.Holds { value: tree.root })
}

data grounding_sanity_lens: v2.compiler.compile.CompileLens = v2.compiler.compile.CompileLens { gate: grounding_sanity_gate }

fn anchor_validate_then_compile_empty_lenses() -> Outcome<Validated<v2.compiler.compile.CompileOutput>> {
  validate_then_compile(
    source: fixture_add_resolved_tree(),
    lenses: [],
    mode: v2.compiler.compile.TranslateTo { target: rust_target_model_stub }
  )
}

fn anchor_validate_then_compile_rejecting_lens() -> Outcome<Validated<v2.compiler.compile.CompileOutput>> {
  validate_then_compile(
    source: fixture_add_resolved_tree(),
    lenses: [rejecting_lens],
    mode: v2.compiler.compile.TranslateTo { target: rust_target_model_stub }
  )
}

fn claim_empty_lenses_matches_compile_core_outcome(
  actual: Outcome<Validated<v2.compiler.compile.CompileOutput>>
) -> Bool {
  match actual {
    Rejected { diagnostics: r } =>
      r.head.reason != ^compile_lens_gate_rejected
    Accepted { value: v, diagnostics: _ } => match v.value {
      TranslateResult { source: _ } => true
      _ => false
    }
  }
}

fn claim_rejecting_lens_is_compile_lens_gate_rejected(
  actual: Outcome<Validated<v2.compiler.compile.CompileOutput>>
) -> Bool {
  match actual {
    Rejected { diagnostics: r } =>
      r.head.reason == ^compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

data claim_validate_then_compile_module_compiles: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/validate_then_compile: validate_then_compile public terminal module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: claim_symbol_node(s: ^claim_validate_then_compile_module),
  expected_value: claim_symbol_node(s: ^claim_validate_then_compile_module),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_empty_lenses_skips_gate: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/validate_then_compile: empty lens list does not compile_lens_gate_reject (infer/compile-core Rejected OK)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim_symbol_node(s: ^claim_validate_then_compile_module),
  rhs: claim_validate_then_compile_skips_gate_passes(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

fn claim_validate_then_compile_skips_gate_passes() -> Node {
  if claim_empty_lenses_matches_compile_core_outcome(
    actual: anchor_validate_then_compile_empty_lenses()
  ) {
    claim_symbol_node(s: ^claim_validate_then_compile_module)
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_rejecting_lens_blocks_before_compile: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/validate_then_compile: required lens Rejected blocks before compile-core",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim_symbol_node(s: ^claim_validate_then_compile_module),
  rhs: claim_rejecting_lens_blocks_passes(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

fn claim_rejecting_lens_blocks_passes() -> Node {
  if claim_rejecting_lens_is_compile_lens_gate_rejected(
    actual: anchor_validate_then_compile_rejecting_lens()
  ) {
    claim_symbol_node(s: ^claim_validate_then_compile_module)
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}
