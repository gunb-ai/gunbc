module v2.test.manual.comprep_bind_emit

import v2.compiler.body_producer {
  produce_mvp1_bind_arrow_with_body,
  produce_mvp1_bind_arrow_with_body_wrong_value
}
import v2.test.manual.comprep_bind_round_trip {
  comprep_bind_round_trip_inferred_facts_for,
  comprep_bind_inferred_tree
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.extdeps.languages.dag {
  dag_mvp1_bind_source_text,
  dag_mvp1_bind_target_model,
  dag_mvp1_fixture_emitted_bind_fn
}
import v2.compiler.translate {
  target_serialize_source_from_model,
  translate_emitted_node
}
import v2.std.collection { Map, list_at_optional }
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  bind_outcome
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.node_query {
  find_arrow_body_child,
  node_positional_child_targets
}
import v2.std.compilers.target_model {
  TargetModel,
  target_value_expr_bind_let_gate
}
import v2.std.witness { Holds, Witness }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

fn comprep_bind_emit_facts_lookup(key: Node) -> Witness<InferredFacts> {
  comprep_bind_round_trip_inferred_facts_for(node: key)
}

fn comprep_bind_emit_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: comprep_bind_emit_facts_lookup }
  }
}

fn comprep_bind_emit_producer_tree() -> Outcome<InferredTree> {
  match produce_mvp1_bind_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: comprep_bind_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn comprep_bind_emit_wrong_value_producer_tree() -> Outcome<InferredTree> {
  match produce_mvp1_bind_arrow_with_body_wrong_value() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: comprep_bind_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn comprep_bind_emit_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: comprep_bind_emit_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn comprep_bind_emit_wrong_value_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: comprep_bind_emit_wrong_value_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn comprep_bind_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: dag_mvp1_bind_target_model(),
    emitted: dag_mvp1_fixture_emitted_bind_fn
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match comprep_bind_emit_from_producer(target: dag_mvp1_bind_target_model()) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_bind_emit_wrong_value_discriminates() -> Bool {
  match comprep_bind_emit_from_producer(target: dag_mvp1_bind_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match comprep_bind_emit_wrong_value_from_producer(target: dag_mvp1_bind_target_model()) {
        Accepted { value: wrong, diagnostics: dw } =>
          (wrong != canonical) && (dc == None) && (dw == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn comprep_bind_emit_keystone_holds() -> Bool {
  comprep_bind_emit_holds() && comprep_bind_emit_wrong_value_discriminates()
}

fn comprep_bind_emit_post_translate_root() -> Outcome<Node> {
  bind_outcome(
    o: comprep_bind_emit_producer_tree(),
    f: fn(tree) {
      translate_emitted_node(tree: tree, target: dag_mvp1_bind_target_model())
    }
  )
}

fn comprep_bind_emit_diag_bind_gate_on_post_translate_body() -> Bool {
  match comprep_bind_emit_post_translate_root() {
    Accepted { value: translated, diagnostics: d } =>
      match find_arrow_body_child(root: translated) {
        Accepted { value: body, diagnostics: bd } =>
          target_value_expr_bind_let_gate(node: body) && (d == None) && (bd == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_bind_emit_diag_emit_eq_authority_text() -> Bool {
  match comprep_bind_emit_from_producer(target: dag_mvp1_bind_target_model()) {
    Accepted { value: emitted, diagnostics: d } =>
      (emitted.carried == dag_mvp1_bind_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}
