module v2.test.manual.python_wave1_grammar_claim

import v2.compiler.parse {
  grammar_validate_for_parse,
  grammar_has_choice_ambiguity,
  parse_production_tree,
}
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.python {
  python_mvp1_source_text,
  python_wave1_grammar_root,
  python_wave1_lex
}
import v2.std.compilers.lexing { token_stream_remaining }
import v2.std.diagnostic { Accepted, Outcome, Rejected, port_locus }
import v2.std.grammar { ParseTree }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.logic { Bool }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
fn python_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^python_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^python_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn python_wave1_grammar_validates_fixture() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: python_wave1_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn python_wave1_grammar_has_choice_ambiguity_fixture() -> Bool {
  grammar_has_choice_ambiguity(root: python_wave1_grammar_root())
}

fn python_wave1_grammar_parse_fixture() -> Outcome<ParseTree> {
  let at = port_locus(port: ^parse_stage_locus_port)
  match tokenize(
    text: python_mvp1_source_text,
    file: ^python_wave1_parse_fixture_file,
    rules: python_wave1_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar_validate_for_parse(root: python_wave1_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          parse_production_tree(
            tokens: token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^python_production_mvp1_fn_add
          )
      }
  }
}

fn python_wave1_grammar_parse_accepts_fixture() -> Bool {
  match python_wave1_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data claim_python_wave1_grammar_validates: TestClaim = EqualsClaim {
  label: "python_wave1_grammar_root passes grammar_validate_for_parse (choice overlap remains on roster until left-factored)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_wave1_grammar_validates_fixture()),
  rhs: python_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_python_wave1_grammar_has_choice_ambiguity: TestClaim = EqualsClaim {
  label: "python_wave1_grammar_root still has choice ambiguity count=1 on the roster (suite stmt overlap until left-factored)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_wave1_grammar_has_choice_ambiguity_fixture()),
  rhs: python_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_python_wave1_grammar_parses_tokens: TestClaim = EqualsClaim {
  label: "python MVP-1 token stream parses through grammar_validate_for_parse and parse_production_tree",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_wave1_grammar_parse_accepts_fixture()),
  rhs: python_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
