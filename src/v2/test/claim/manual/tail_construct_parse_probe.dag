module v2.test.manual.tail_construct_parse_probe

import extdeps.filesystem.filesystem_io
import v2.compiler.normalize { normalize }
import v2.compiler.parse { grammar_validate_for_parse, parse_production }
import v2.compiler.tokenize { tokenize }


data tcp_subject: Symbol = ^tail_construct_probe_subject

fn tcp_cause(source_text: String) -> Symbol {
  let lm = dag_language_model()
  let at = port_locus(port: ^parse_stage_locus_port)
  match lm.grammar {
    VoidGrammar => ^language_grammar_unavailable
    ModeledGrammar { root: root } =>
      match grammar_validate_for_parse(root: root, at: at) {
        Rejected { diagnostics: _ } => ^language_grammar_rejected
        Accepted { value: validated, diagnostics: _ } =>
          match tokenize(text: source_text, file: tcp_subject, rules: lm.lex) {
            Rejected { diagnostics: _ } => ^source_tokenization_rejected
            Accepted { value: stream, diagnostics: _ } =>
              match parse_production(
                tokens: token_stream_remaining(stream: stream),
                validated: validated,
                production_name: validated.root.start
              ) {
                Rejected { diagnostics: _ } => ^source_parse_rejected
                Accepted { value: artifact, diagnostics: _ } =>
                  match normalize(parse_tree: artifact.tree) {
                    Rejected { diagnostics: _ } => ^source_normalization_rejected
                    Accepted { value: _, diagnostics: _ } => ^source_analysis_established
                  }
              }
          }
      }
  }
}

fn tcp_cause_path(path: String) -> Symbol {
  tcp_cause(source_text: filesystem_read(path: path).content)
}

fn tcp_subject_analyze() -> Symbol {
  tcp_cause_path(path: "src/v2/lens/complexity_accumulator_copy/analyze.dag")
}

