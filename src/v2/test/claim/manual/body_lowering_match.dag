fn body_lowering_tree_has_any_atom(root: Node) -> Bool {
  match node_atom_identity_optional(node: root) {
    Present { value: _ } => true
    Absent =>
      fold(root.children, init: false, f: fn(found, e) {
        if found {
          true
        } else {
          body_lowering_tree_has_any_atom(root: e.target)
        }
      })
  }
}

