fn body_lowering_tree_has_kw_true_atom(root: Node) -> Bool {
  match node_atom_identity_optional(node: root) {
    Present { value: id } =>
      (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false)
    Absent =>
      fold(root.children, init: false, f: fn(found, e) {
        if found {
          true
        } else {
          body_lowering_tree_has_kw_true_atom(root: e.target)
        }
      })
  }
}

