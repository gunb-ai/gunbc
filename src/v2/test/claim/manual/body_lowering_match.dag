module v2.test.manual.body_lowering_match

import v2.compiler.body_lowering_fold {
  body_lower_match_arms_optional,
  body_lower_try_match_from_captured,
  body_lower_unwrap_captured,
  body_lower_wire_match_arm_capture
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_language_model,
  parse_production_emitted_identity_optional,
  parse_subtree_find_production_captured
}
import std.algebra { Empty }
import v2.std.algebra { length }
import v2.std.optional {
  Absent,
  Optional,
  Present
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Conj,
  Match,
  Node,
  TypeNode,
  node_synthetic
}
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data body_lowering_match_source: String = "module m\n\nfn classical_not(a: Int) -> Int {\n  match a {\n    true => false,\n    false => true\n  }\n}\n"

data body_lowering_match_swapped_source: String = "module m\n\nfn classical_not(a: Int) -> Int {\n  match a {\n    true => true,\n    false => false\n  }\n}\n"

fn body_lowering_match_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_match_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_match_fail } },
      children: []
    )
  }
}

fn body_lowering_find_match_expr(root: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: emitted } =>
      match emitted == ^dag_surface_match_expr {
        true => Present { value: root }
        false =>
          fold(root.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lowering_find_match_expr(root: e.target)
            }
          })
      }
    Absent =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lowering_find_match_expr(root: e.target)
        }
      })
  }
}

fn body_lowering_tree_has_match_behavior(root: Node) -> Bool {
  match root.kind {
    ComputationNode { behavior: Match } => true
    _ =>
      fold(root.children, init: false, f: fn(found, e) {
        if found {
          true
        } else {
          body_lowering_tree_has_match_behavior(root: e.target)
        }
      })
  }
}

fn body_lowering_parsed_tree(source: String) -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(text: source, file: ^body_lowering_match_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } => Present { value: artifact.tree }
      }
  }
}

fn body_lowering_match_lowers_to_match() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match body_lower_try_match_from_captured(captured: captured) {
                Rejected { diagnostics: _ } => false
                Accepted { value: lowered_opt, diagnostics: _ } =>
                  match lowered_opt {
                    Present { value: lowered } =>
                      match lowered.kind {
                        ComputationNode { behavior: Match } => true
                        _ => false
                      }
                    Absent => false
                  }
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_normalize_accepts_match_module() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

fn body_lowering_normalized_module_has_match() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: normalized, diagnostics: _ } =>
          body_lowering_tree_has_match_behavior(root: normalized)
      }
  }
}

fn body_lowering_match_swapped_arms_normalize_accepts() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_swapped_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

fn body_lowering_match_arms_found() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match body_lower_match_arms_optional(captured: captured) {
                Rejected { diagnostics: _ } => false
                Accepted { value: arms_opt, diagnostics: _ } =>
                  match arms_opt {
                    Present { value: arms } => length(xs: arms) > 0
                    Absent => false
                  }
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_match_first_arm_wires() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match parse_subtree_find_production_captured(
                root: captured,
                emitted: ^dag_surface_match_arm
              ) {
                ParseSubtreeFound { captured: arm } =>
                  match body_lower_wire_match_arm_capture(arm_capture: arm) {
                    Accepted { value: _, diagnostics: _ } => true
                    Rejected { diagnostics: _ } => false
                  }
                ParseSubtreeAbsent => false
              }
            Absent => false
          }
      }
  }
}

data unnavigable_arm_budget_note: String = "Synthetic empty Conj arm capture has no navigable match_arm production spine — body_lower_wire_match_arm_capture must refuse with ^body_lowering_reason_match_arm_navigation_refused (structural termination; no fuel budget)."

fn body_lowering_match_unnavigable_arm_refuses() -> Bool {
  let unnavigable_arm = node_synthetic(
    kind: TypeNode { connective: Conj },
    children: Empty
  )
  match body_lower_wire_match_arm_capture(arm_capture: unnavigable_arm) {
    Rejected { diagnostics: d } =>
      d.head.reason == ^body_lowering_reason_match_arm_navigation_refused
    Accepted { value: _, diagnostics: _ } => false
  }
}

data claim_body_lowering_match_arms_found: TestClaim = EqualsClaim {
  label: "manual/body-lowering-match: classical_not arms discoverable",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_match_bool_node(pass: body_lowering_match_arms_found()),
  rhs: body_lowering_match_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_match_lowers_to_match: TestClaim = EqualsClaim {
  label: "manual/body-lowering-match: match_expr lowers to Match computation",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_match_bool_node(pass: body_lowering_match_lowers_to_match()),
  rhs: body_lowering_match_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_match_normalize_accepts: TestClaim = EqualsClaim {
  label: "manual/body-lowering-match: classical_not module normalizes without refusal",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_match_bool_node(pass: body_lowering_normalize_accepts_match_module()),
  rhs: body_lowering_match_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_match_normalized_has_match: TestClaim = EqualsClaim {
  label: "manual/body-lowering-match: normalized classical_not retains Match behavior",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_match_bool_node(pass: body_lowering_normalized_module_has_match()),
  rhs: body_lowering_match_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_match_swapped_normalize_accepts: TestClaim = EqualsClaim {
  label: "manual/body-lowering-match: swapped-arm module normalizes without refusal",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_match_bool_node(pass: body_lowering_match_swapped_arms_normalize_accepts()),
  rhs: body_lowering_match_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_match_first_arm_wires: TestClaim = EqualsClaim {
  label: "manual/body-lowering-match: true=>false arm wires pattern and body",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_match_bool_node(pass: body_lowering_match_first_arm_wires()),
  rhs: body_lowering_match_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_match_unnavigable_arm_refuses: TestClaim = EqualsClaim {
  label: "manual/body-lowering-match: unnavigable arm subtree refuses (fail-closed)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_match_bool_node(pass: body_lowering_match_unnavigable_arm_refuses()),
  rhs: body_lowering_match_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

fn body_lowering_match_arms_found_witness() -> Bool {
  body_lowering_match_arms_found()
}

fn body_lowering_match_lowers_to_match_witness() -> Bool {
  body_lowering_match_lowers_to_match()
}

fn body_lowering_normalize_accepts_match_module_witness() -> Bool {
  body_lowering_normalize_accepts_match_module()
}

fn body_lowering_normalized_module_has_match_witness() -> Bool {
  body_lowering_normalized_module_has_match()
}

fn body_lowering_match_swapped_arms_normalize_accepts_witness() -> Bool {
  body_lowering_match_swapped_arms_normalize_accepts()
}

fn body_lowering_match_first_arm_wires_witness() -> Bool {
  body_lowering_match_first_arm_wires()
}

fn body_lowering_match_unnavigable_arm_refuses_witness() -> Bool {
  body_lowering_match_unnavigable_arm_refuses()
}
