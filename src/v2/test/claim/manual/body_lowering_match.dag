module v2.test.manual.body_lowering_match

import v2.compiler.body_lowering_fold {
  body_lower_match_arm_wire_optional,
  body_lower_match_arms_optional,
  body_lower_match_scrutinee_optional,
  body_lower_operand_ref_optional,
  body_lower_try_match_from_captured,
  body_lower_unwrap_captured
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_language_model,
  parse_production_emitted_identity_optional,
  parse_subtree_find_production_captured
}
import std.algebra { Cons, Empty }
import v2.std.algebra { length }
import v2.std.collection { Absent, Optional, Present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Match,
  Node,
  TypeNode,
  node_synthetic
}

data body_lowering_match_source: String = "module m\n\nfn classical_not(a: Int) -> Int {\n  match a {\n    True => False,\n    False => True\n  }\n}\n"

data body_lowering_match_swapped_source: String = "module m\n\nfn classical_not(a: Int) -> Int {\n  match a {\n    True => True,\n    False => False\n  }\n}\n"

fn body_lowering_match_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_match_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_match_fail } },
      children: []
    )
  }
}

fn body_lowering_find_match_expr(root: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: emitted } =>
      match emitted == ^dag_surface_match_expr {
        true => Present { value: root }
        false =>
          fold(root.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lowering_find_match_expr(root: e.target)
            }
          })
      }
    Absent =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lowering_find_match_expr(root: e.target)
        }
      })
  }
}

fn body_lowering_tree_has_match_behavior(root: Node) -> Bool {
  match root.kind {
    ComputationNode { behavior: Match } => true
    _ =>
      fold(root.children, init: false, f: fn(found, e) {
        if found {
          true
        } else {
          body_lowering_tree_has_match_behavior(root: e.target)
        }
      })
  }
}

fn body_lowering_parsed_tree(source: String) -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(text: source, file: ^body_lowering_match_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } => Present { value: artifact.tree }
      }
  }
}

fn body_lowering_match_lowers_to_match() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match body_lower_try_match_from_captured(captured: captured) {
                Present { value: lowered } =>
                  match lowered.kind {
                    ComputationNode { behavior: Match } => true
                    _ => false
                  }
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_normalize_accepts_match_module() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

fn body_lowering_normalized_module_has_match() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: normalized, diagnostics: _ } =>
          body_lowering_tree_has_match_behavior(root: normalized)
      }
  }
}

fn body_lowering_match_swapped_arms_normalize_accepts() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_swapped_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

fn body_lowering_match_parse_succeeds_witness() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Present { value: _ } => true
    Absent => false
  }
}

fn body_lowering_find_match_expr_witness() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

fn body_lowering_match_captured_witness() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: _ } => true
            Absent => false
          }
      }
  }
}

fn body_lowering_match_binary_subtree_witness() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match parse_subtree_find_production_captured(
                root: captured,
                emitted: ^dag_surface_binary_expr
              ) {
                ParseSubtreeFound { captured: _ } => true
                ParseSubtreeAbsent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_match_operand_ref_witness() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match parse_subtree_find_production_captured(
                root: captured,
                emitted: ^dag_surface_binary_expr
              ) {
                ParseSubtreeFound { captured: binary } =>
                  match body_lower_operand_ref_optional(node: binary) {
                    Present { value: _ } => true
                    Absent => false
                  }
                ParseSubtreeAbsent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_match_scrutinee_found_witness() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match body_lower_match_scrutinee_optional(captured: captured) {
                Present { value: _ } => true
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_match_arms_found_witness() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match body_lower_match_arms_optional(captured: captured) {
                Present { value: arms } => length(xs: arms) > 0
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_match_first_arm_wire_witness() -> Bool {
  match body_lowering_parsed_tree(source: body_lowering_match_source) {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_match_expr(root: tree) {
        Absent => false
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: captured } =>
              match parse_subtree_find_production_captured(
                root: captured,
                emitted: ^dag_surface_match_arm
              ) {
                ParseSubtreeFound { captured: arm } =>
                  match body_lower_match_arm_wire_optional(arm_capture: arm) {
                    Present { value: _ } => true
                    Absent => false
                  }
                ParseSubtreeAbsent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lowering_match_lowers_to_match_witness() -> Bool {
  body_lowering_match_lowers_to_match()
}

fn body_lowering_normalize_accepts_match_module_witness() -> Bool {
  body_lowering_normalize_accepts_match_module()
}

fn body_lowering_normalized_module_has_match_witness() -> Bool {
  body_lowering_normalized_module_has_match()
}
