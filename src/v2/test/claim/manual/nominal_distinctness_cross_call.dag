module v2.test.manual.nominal_distinctness_cross_call



data nominal_distinct_forbidden_authority_source_text: String = "nominal_distinct_forbidden_authority_source_text"

data nominal_distinct_records_source: Medium<String> = extdeps.communication.medium.Medium { carried: "module nominal.distinct.records.probe\n\ntype WrapA {\n  value: Int\n}\n\ntype WrapB {\n  value: Int\n}\n\nfn expects_a(x: WrapA) -> Int = x.value\n\nfn call_site(b: WrapB) -> Int = expects_a(b)\n", fidelity: Lossless }

data nominal_distinct_brands_source: Medium<String> = extdeps.communication.medium.Medium { carried: "module nominal.distinct.desugared_brands.probe\n\ntype IntentId {\n  value: String\n}\n\ntype IssueId {\n  value: String\n}\n\nfn expects_intent(x: IntentId) -> String = x.value\n\nfn call_site(i: IssueId) -> String = expects_intent(i)\n", fidelity: Lossless }
data nominal_distinct_control_source: Medium<String> = extdeps.communication.medium.Medium { carried: "module nominal.distinct.control.probe\n\ntype WrapA {\n  value: Int\n}\n\nfn expects_a(x: WrapA) -> Int = x.value\n\nfn call_site(a: WrapA) -> Int = expects_a(a)\n", fidelity: Lossless }
data nominal_distinct_compile_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: rust_target_model_node(),
  lex: rust_fn_add_lex(),
  binding_spellings: rust_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: nominal_distinct_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn nominal_distinct_input_node(sym: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data nominal_distinct_records_input: Node = nominal_distinct_input_node(sym: ^nominal_distinct_records_input_symbol)
data nominal_distinct_brands_input: Node = nominal_distinct_input_node(sym: ^nominal_distinct_brands_input_symbol)
data nominal_distinct_control_input: Node = nominal_distinct_input_node(sym: ^nominal_distinct_control_input_symbol)

fn anchor_nominal_distinct_records_compile() -> v2.std.diagnostic.Outcome<Medium<String>> {
  compile_ingest_staging(
    source: nominal_distinct_records_source,
    target: nominal_distinct_compile_target
  )
}

fn anchor_nominal_distinct_brands_compile() -> v2.std.diagnostic.Outcome<Medium<String>> {
  compile_ingest_staging(
    source: nominal_distinct_brands_source,
    target: nominal_distinct_compile_target
  )
}

fn anchor_nominal_distinct_control_compile() -> v2.std.diagnostic.Outcome<Medium<String>> {
  compile_ingest_staging(
    source: nominal_distinct_control_source,
    target: nominal_distinct_compile_target
  )
}

data nominal_distinct_records_compile_receipt: v2.std.diagnostic.Outcome<Medium<String>> = anchor_nominal_distinct_records_compile()
data nominal_distinct_brands_compile_receipt: v2.std.diagnostic.Outcome<Medium<String>> = anchor_nominal_distinct_brands_compile()
data nominal_distinct_control_compile_receipt: v2.std.diagnostic.Outcome<Medium<String>> = anchor_nominal_distinct_control_compile()

fn nominal_distinct_cross_call_must_reject_diagnostic(at: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^nominal_distinct_cross_call_must_reject,
    at: node_locus(node: at),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn nominal_distinct_compile_accepted_miss_diagnostic(at: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^nominal_distinct_compile_accepted_miss,
    at: node_locus(node: at),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn nominal_distinct_records_expected_rejection() -> v2.std.diagnostic.NonEmptyDiagnostics {
  match nominal_distinct_records_compile_receipt {
    Rejected { diagnostics: r } => r
    Accepted { value: _, diagnostics: _ } =>
      diagnostics_singleton(
        d: nominal_distinct_cross_call_must_reject_diagnostic(at: nominal_distinct_records_input)
      )
  }
}

fn nominal_distinct_brands_expected_rejection() -> v2.std.diagnostic.NonEmptyDiagnostics {
  match nominal_distinct_brands_compile_receipt {
    Rejected { diagnostics: r } => r
    Accepted { value: _, diagnostics: _ } =>
      diagnostics_singleton(
        d: nominal_distinct_cross_call_must_reject_diagnostic(at: nominal_distinct_brands_input)
      )
  }
}

fn nominal_distinct_control_compiles_ok() -> Bool {
  match nominal_distinct_control_compile_receipt {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data claim_nominal_distinct_records_cross_call_rejects: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "manual/nominal: structurally-identical WrapA/WrapB records reject cross-call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nominal_distinct_records_input,
  expected_rejection: nominal_distinct_records_expected_rejection(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_nominal_distinct_branded_aliases_cross_call_rejects: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "manual/nominal: IntentId/IssueId desugared nominal records reject cross-call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nominal_distinct_brands_input,
  expected_rejection: nominal_distinct_brands_expected_rejection(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_nominal_distinct_same_type_control_compiles: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/nominal: same-type WrapA cross-call compiles (positive control)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nominal_distinct_control_input,
  expected_value: nominal_distinct_control_input,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

fn nominal_distinct_runtime_type_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^nominal_distinct_type_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn nominal_distinct_runtime_unit(node: Node) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeUnit {
    value: v2.std.runtime.RuntimeUnitValue { unit_type: nominal_distinct_runtime_type_node() }
  }
}

fn nominal_distinct_compile_for_input(node: Node) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if node == nominal_distinct_records_input {
    match nominal_distinct_records_compile_receipt {
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      Accepted { value: _, diagnostics: _ } =>
        v2.std.diagnostic.Accepted { value: nominal_distinct_runtime_unit(node: node), diagnostics: v2.std.diagnostic.None }
    }
  } else if node == nominal_distinct_brands_input {
    match nominal_distinct_brands_compile_receipt {
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      Accepted { value: _, diagnostics: _ } =>
        v2.std.diagnostic.Accepted { value: nominal_distinct_runtime_unit(node: node), diagnostics: v2.std.diagnostic.None }
    }
  } else if node == nominal_distinct_control_input {
    match nominal_distinct_control_compile_receipt {
      Accepted { value: _, diagnostics: _ } =>
        v2.std.diagnostic.Accepted { value: nominal_distinct_runtime_unit(node: node), diagnostics: v2.std.diagnostic.None }
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    }
  } else {
    outcome_rejected(
      nominal_distinct_compile_accepted_miss_diagnostic(at: node)
    )
  }
}

fn nominal_distinct_allocate_literal(
  node: Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  nominal_distinct_compile_for_input(node: node)
}

fn nominal_distinct_call_primitive(
  node: Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  nominal_distinct_compile_for_input(node: node)
}

fn nominal_distinct_choose_branch(
  node: Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<Node> {
  v2.std.diagnostic.Accepted { value: node, diagnostics: v2.std.diagnostic.None }
}

fn nominal_distinct_step_loop(
  node: Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Accepted { value: v2.std.runtime.Continue { value: nominal_distinct_runtime_unit(node: node) }, diagnostics: v2.std.diagnostic.None }
}

fn nominal_distinct_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: v2.std.diagnostic.None }
}

fn nominal_distinct_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: nominal_distinct_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: nominal_distinct_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: nominal_distinct_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: nominal_distinct_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: nominal_distinct_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn nominal_distinct_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^nominal_distinct_allocate_literal_sym,
    call_primitive: ^nominal_distinct_call_primitive_sym,
    choose_branch: ^nominal_distinct_choose_branch_sym,
    step_loop: ^nominal_distinct_step_loop_sym,
    bind_value: ^nominal_distinct_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn nominal_distinct_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^nominal_distinct_descent_dimension }
  }
}

fn nominal_distinct_facts(node: Node) -> v2.compiler.infer.InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: node,
    descent: v2.std.witness.Holds { value: nominal_distinct_termination_proof() }
  )
}

fn nominal_distinct_fact_lookup(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_present(value: nominal_distinct_facts(node: node))
}

fn nominal_distinct_inferred_tree(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: nominal_distinct_fact_lookup }
  }
}

fn nominal_distinct_context() -> v2.compiler.eval.EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^nominal_distinct_interpretation_pin,
    interpretation: nominal_distinct_interpretation(),
    structure_witness: nominal_distinct_interpretation_structure_witness()
  )
}

fn nominal_distinct_subject(
  claim: v2.std.verification.TestClaim,
  evaluator_pin: v2.std.node.Symbol
) -> TestClaimEvalSubject<Node> {
  let input = test_claim_input(c: claim)
  eval_test_claim_subject(
    claim: claim,
    context: nominal_distinct_context(),
    tree: nominal_distinct_inferred_tree(root: input),
    evaluator_pin: evaluator_pin
  )
}

data subject_nominal_distinct_records_cross_call_rejects: TestClaimEvalSubject<Node> = nominal_distinct_subject(
  claim: claim_nominal_distinct_records_cross_call_rejects,
  evaluator_pin: ^nominal_distinct_records_input_symbol
)

data subject_nominal_distinct_branded_aliases_cross_call_rejects: TestClaimEvalSubject<Node> = nominal_distinct_subject(
  claim: claim_nominal_distinct_branded_aliases_cross_call_rejects,
  evaluator_pin: ^nominal_distinct_brands_input_symbol
)

data subject_nominal_distinct_same_type_control_compiles: TestClaimEvalSubject<Node> = nominal_distinct_subject(
  claim: claim_nominal_distinct_same_type_control_compiles,
  evaluator_pin: ^nominal_distinct_control_input_symbol
)

data run_nominal_distinct_records_cross_call_rejects: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_nominal_distinct_records_cross_call_rejects
)

data run_nominal_distinct_branded_aliases_cross_call_rejects: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_nominal_distinct_branded_aliases_cross_call_rejects
)

data run_nominal_distinct_same_type_control_compiles: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_nominal_distinct_same_type_control_compiles
)

data witness_nominal_distinct_control_compile_anchor: Bool = nominal_distinct_control_compiles_ok()
