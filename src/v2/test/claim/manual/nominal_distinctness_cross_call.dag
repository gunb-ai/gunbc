module v2.test.manual.nominal_distinctness_cross_call

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.compiler.compile {  compile_ingest_staging
}
import v2.std.verification { test_claim_input }
import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_test_claim_subject,
  run_test_claim,
}
import v2.compiler.infer {
  InferredFacts,
  InferredTree
}
import extdeps.communication.medium { Lossless, Medium }
import v2.extdeps.languages.rust {
  rust_binding_spellings,
  rust_target_model_node,
  rust_fn_add_lex
}
import v2.std.cardinality { RankingDimension, TerminationProof }
import v2.std.collection { List, Map }

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus,
  outcome_rejected
}
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  CallSemantics,
  ControlTransfer,
  Continue,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimeUnit,
  RuntimeUnitValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v2.std.compilers.target_model { TargetModel, target_model_emit_transforms_empty }
import v2.std.verification {
  CompilesClaim,
  DiagnosticClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds, Violates, Witness }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }

data nominal_distinct_forbidden_authority_source_text: String = "nominal_distinct_forbidden_authority_source_text"

data nominal_distinct_records_source: Medium<String> = Medium { carried: "module nominal.distinct.records.probe\n\ntype WrapA {\n  value: Int\n}\n\ntype WrapB {\n  value: Int\n}\n\nfn expects_a(x: WrapA) -> Int = x.value\n\nfn call_site(b: WrapB) -> Int = expects_a(b)\n", fidelity: Lossless }

data nominal_distinct_brands_source: Medium<String> = Medium { carried: "module nominal.distinct.desugared_brands.probe\n\ntype IntentId {\n  value: String\n}\n\ntype IssueId {\n  value: String\n}\n\nfn expects_intent(x: IntentId) -> String = x.value\n\nfn call_site(i: IssueId) -> String = expects_intent(i)\n", fidelity: Lossless }
data nominal_distinct_control_source: Medium<String> = Medium { carried: "module nominal.distinct.control.probe\n\ntype WrapA {\n  value: Int\n}\n\nfn expects_a(x: WrapA) -> Int = x.value\n\nfn call_site(a: WrapA) -> Int = expects_a(a)\n", fidelity: Lossless }
data nominal_distinct_compile_target: TargetModel = TargetModel {
  bundle: rust_target_model_node(),
  lex: rust_fn_add_lex(),
  binding_spellings: rust_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: nominal_distinct_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn nominal_distinct_input_node(sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data nominal_distinct_records_input: Node = nominal_distinct_input_node(sym: ^nominal_distinct_records_input_symbol)
data nominal_distinct_brands_input: Node = nominal_distinct_input_node(sym: ^nominal_distinct_brands_input_symbol)
data nominal_distinct_control_input: Node = nominal_distinct_input_node(sym: ^nominal_distinct_control_input_symbol)

fn anchor_nominal_distinct_records_compile() -> Outcome<Medium<String>> {
  compile_ingest_staging(
    source: nominal_distinct_records_source,
    target: nominal_distinct_compile_target
  )
}

fn anchor_nominal_distinct_brands_compile() -> Outcome<Medium<String>> {
  compile_ingest_staging(
    source: nominal_distinct_brands_source,
    target: nominal_distinct_compile_target
  )
}

fn anchor_nominal_distinct_control_compile() -> Outcome<Medium<String>> {
  compile_ingest_staging(
    source: nominal_distinct_control_source,
    target: nominal_distinct_compile_target
  )
}

data nominal_distinct_records_compile_receipt: Outcome<Medium<String>> = anchor_nominal_distinct_records_compile()
data nominal_distinct_brands_compile_receipt: Outcome<Medium<String>> = anchor_nominal_distinct_brands_compile()
data nominal_distinct_control_compile_receipt: Outcome<Medium<String>> = anchor_nominal_distinct_control_compile()

fn nominal_distinct_cross_call_must_reject_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^nominal_distinct_cross_call_must_reject,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn nominal_distinct_compile_accepted_miss_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^nominal_distinct_compile_accepted_miss,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn nominal_distinct_records_expected_rejection() -> NonEmptyDiagnostics {
  match nominal_distinct_records_compile_receipt {
    Rejected { diagnostics: r } => r
    Accepted { value: _, diagnostics: _ } =>
      diagnostics_singleton(
        d: nominal_distinct_cross_call_must_reject_diagnostic(at: nominal_distinct_records_input)
      )
  }
}

fn nominal_distinct_brands_expected_rejection() -> NonEmptyDiagnostics {
  match nominal_distinct_brands_compile_receipt {
    Rejected { diagnostics: r } => r
    Accepted { value: _, diagnostics: _ } =>
      diagnostics_singleton(
        d: nominal_distinct_cross_call_must_reject_diagnostic(at: nominal_distinct_brands_input)
      )
  }
}

fn nominal_distinct_control_compiles_ok() -> Bool {
  match nominal_distinct_control_compile_receipt {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data claim_nominal_distinct_records_cross_call_rejects: TestClaim = DiagnosticClaim {
  label: "manual/nominal: structurally-identical WrapA/WrapB records reject cross-call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nominal_distinct_records_input,
  expected_rejection: nominal_distinct_records_expected_rejection(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nominal_distinct_branded_aliases_cross_call_rejects: TestClaim = DiagnosticClaim {
  label: "manual/nominal: IntentId/IssueId desugared nominal records reject cross-call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nominal_distinct_brands_input,
  expected_rejection: nominal_distinct_brands_expected_rejection(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nominal_distinct_same_type_control_compiles: TestClaim = CompilesClaim {
  label: "manual/nominal: same-type WrapA cross-call compiles (positive control)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nominal_distinct_control_input,
  expected_value: nominal_distinct_control_input,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

fn nominal_distinct_runtime_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^nominal_distinct_type_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn nominal_distinct_runtime_unit(node: Node) -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue { unit_type: nominal_distinct_runtime_type_node() }
  }
}

fn nominal_distinct_compile_for_input(node: Node) -> Outcome<RuntimeValue> {
  if node == nominal_distinct_records_input {
    match nominal_distinct_records_compile_receipt {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: _, diagnostics: _ } =>
        Accepted { value: nominal_distinct_runtime_unit(node: node), diagnostics: None }
    }
  } else if node == nominal_distinct_brands_input {
    match nominal_distinct_brands_compile_receipt {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: _, diagnostics: _ } =>
        Accepted { value: nominal_distinct_runtime_unit(node: node), diagnostics: None }
    }
  } else if node == nominal_distinct_control_input {
    match nominal_distinct_control_compile_receipt {
      Accepted { value: _, diagnostics: _ } =>
        Accepted { value: nominal_distinct_runtime_unit(node: node), diagnostics: None }
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
    }
  } else {
    outcome_rejected(
      nominal_distinct_compile_accepted_miss_diagnostic(at: node)
    )
  }
}

fn nominal_distinct_allocate_literal(
  node: Node,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  nominal_distinct_compile_for_input(node: node)
}

fn nominal_distinct_call_primitive(
  node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  nominal_distinct_compile_for_input(node: node)
}

fn nominal_distinct_choose_branch(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  Accepted { value: node, diagnostics: None }
}

fn nominal_distinct_step_loop(
  node: Node,
  _env: EvaluationEnvironment
) -> Outcome<ControlTransfer> {
  Accepted { value: Continue { value: nominal_distinct_runtime_unit(node: node) }, diagnostics: None }
}

fn nominal_distinct_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn nominal_distinct_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: nominal_distinct_allocate_literal },
    transform: TransformInterpreter { call_primitive: nominal_distinct_call_primitive },
    branch: BranchInterpreter { choose_branch: nominal_distinct_choose_branch },
    loop: LoopInterpreter { step_loop: nominal_distinct_step_loop },
    bind: BindInterpreter { bind_value: nominal_distinct_bind_value },
    match: MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn nominal_distinct_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^nominal_distinct_allocate_literal_sym,
    call_primitive: ^nominal_distinct_call_primitive_sym,
    choose_branch: ^nominal_distinct_choose_branch_sym,
    step_loop: ^nominal_distinct_step_loop_sym,
    bind_value: ^nominal_distinct_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn nominal_distinct_termination_proof() -> TerminationProof {
  TerminationProof {
    non_increasing: [],
    strict: RankingDimension { measured: ^nominal_distinct_descent_dimension }
  }
}

fn nominal_distinct_facts(node: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: node,
    descent: Holds { value: nominal_distinct_termination_proof() }
  )
}

fn nominal_distinct_fact_lookup(node: Node) -> Witness<InferredFacts> {
  Holds { value: nominal_distinct_facts(node: node) }
}

fn nominal_distinct_inferred_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: nominal_distinct_fact_lookup }
  }
}

fn nominal_distinct_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^nominal_distinct_interpretation_pin,
    interpretation: nominal_distinct_interpretation(),
    structure_witness: nominal_distinct_interpretation_structure_witness()
  )
}

fn nominal_distinct_subject(
  claim: TestClaim,
  evaluator_pin: Symbol
) -> TestClaimEvalSubject<Node> {
  let input = test_claim_input(c: claim)
  eval_test_claim_subject(
    claim: claim,
    context: nominal_distinct_context(),
    tree: nominal_distinct_inferred_tree(root: input),
    evaluator_pin: evaluator_pin
  )
}

data subject_nominal_distinct_records_cross_call_rejects: TestClaimEvalSubject<Node> = nominal_distinct_subject(
  claim: claim_nominal_distinct_records_cross_call_rejects,
  evaluator_pin: ^nominal_distinct_records_input_symbol
)

data subject_nominal_distinct_branded_aliases_cross_call_rejects: TestClaimEvalSubject<Node> = nominal_distinct_subject(
  claim: claim_nominal_distinct_branded_aliases_cross_call_rejects,
  evaluator_pin: ^nominal_distinct_brands_input_symbol
)

data subject_nominal_distinct_same_type_control_compiles: TestClaimEvalSubject<Node> = nominal_distinct_subject(
  claim: claim_nominal_distinct_same_type_control_compiles,
  evaluator_pin: ^nominal_distinct_control_input_symbol
)

data run_nominal_distinct_records_cross_call_rejects: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_nominal_distinct_records_cross_call_rejects
)

data run_nominal_distinct_branded_aliases_cross_call_rejects: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_nominal_distinct_branded_aliases_cross_call_rejects
)

data run_nominal_distinct_same_type_control_compiles: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_nominal_distinct_same_type_control_compiles
)

data witness_nominal_distinct_control_compile_anchor: Bool = nominal_distinct_control_compiles_ok()
