module v2.test.manual.refinement_nonempty_list

import v2.std.refinement { Refined, Validation, refine }
import v2.std.algebra { non_empty }
import v2.std.collection { List }
import v2.std.diagnostic { Locus, Outcome }
import v2.std.node { Symbol }
type NonEmptyList<T> = Refined<List<T>>
fn witness_non_empty_list<T>(xs: List<T>, at: Locus) -> Outcome<NonEmptyList<T>> {
  refine(
    base: xs,
    by: Validation {
      reason: ^refinement_empty_list_reason,
      admits: fn(items) { non_empty(xs: items) }
    },
    at: at
  )
}
