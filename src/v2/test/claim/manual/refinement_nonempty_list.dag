module v2.test.manual.refinement_nonempty_list

type NonEmptyList<T> = Refined<List<T>>
fn witness_non_empty_list<T>(xs: List<T>, at: v2.std.diagnostic.Locus) -> Outcome<NonEmptyList<T>> {
  refine(
    base: xs,
    by: v2.std.refinement.Validation {
      reason: ^refinement_empty_list_reason,
      admits: fn(items) { non_empty(xs: items) }
    },
    at: at
  )
}
