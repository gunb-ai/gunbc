module v2.test.manual.add_body_emit_typescript


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data add_body_ts_emit_operand_swap_source_text: String = "function add(x: number, y: number): number { return y + x; }"

data add_body_ts_emit_catalog_minus_source_text: String = "function add(x: number, y: number): number { return x - y; }"

fn add_body_ts_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: Named { name: name }, target: target }
}

fn add_body_ts_add_operator_row_minus() -> v2.std.node.Node {
  target_operator_realization_node(
    operation: canonical_operation_op_add(),
    shape: v2.std.compilers.target_model.InfixToken { token: ^ts_token_minus }
  )
}

fn add_body_ts_operator_catalog_minus() -> v2.std.node.Node {
  target_operator_realizations_catalog_node(rows: [add_body_ts_add_operator_row_minus()])
}

fn add_body_ts_operator_catalog_empty() -> v2.std.node.Node {
  target_operator_realizations_catalog_node(rows: [])
}

fn add_body_ts_target_model_bundle(operator_catalog: v2.std.node.Node) -> v2.std.node.Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      add_body_ts_named_edge(
        name: ^target_model_edge_selection_policy,
        target: ts_selection_policy_node()
      ),
      add_body_ts_named_edge(
        name: ^target_model_edge_declared_inhabitants,
        target: ts_add_declared_inhabitants_root()
      ),
      add_body_ts_named_edge(
        name: ^target_model_edge_translation_rules,
        target: ts_translation_rules_node()
      ),
      add_body_ts_named_edge(
        name: ^target_model_edge_serialize_source,
        target: ts_serialize_source_node()
      ),
      add_body_ts_named_edge(
        name: ^target_model_edge_value_expression_projection,
        target: value_expr_projection_bundle_node(
          projection: ts_value_expression_projection()
        )
      ),
      add_body_ts_named_edge(
        name: ^target_model_edge_operator_realizations,
        target: operator_catalog
      )
    ]
  )
}

fn add_body_ts_lex_with_minus() -> v2.std.compilers.lexing.LexRules {
  let base = ts_fn_add_lex_rules()
  v2.std.compilers.lexing.ModeledLexRules {
    root: v2.std.compilers.lexing.LexRuleSet {
      rules: list_append(
        left: base.rules,
        right: std.algebra.Cons {
          head: ts_lex_rule(token_class: ^ts_token_minus, text: " - "),
          tail: std.algebra.Empty
        }
      )
    }
  }
}

fn add_body_ts_target_model_minus_catalog() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: add_body_ts_target_model_bundle(operator_catalog: add_body_ts_operator_catalog_minus()),
    lex: add_body_ts_lex_with_minus(),
    binding_spellings: ts_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: ts_source_text_authority(),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn add_body_ts_target_model_missing_operator_catalog() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: add_body_ts_target_model_bundle(operator_catalog: add_body_ts_operator_catalog_empty()),
    lex: ts_fn_add_lex(),
    binding_spellings: ts_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: ts_source_text_authority(),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn add_body_ts_canonical_grounding(node: v2.std.node.Node, algebra: v2.std.node.Node) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

data add_body_ts_number_inhabitant: Node = ts_inhabitant_number_node()
data add_body_ts_number_facts_node: Node = ts_number_facts_node(facts: ts_facts_number)
data add_body_ts_arithmetic_semantics_node: Node = ts_number_arithmetic_semantics_node()
data add_body_ts_bitwise_semantics_node: Node = ts_number_bitwise_semantics_node()

fn add_body_ts_canonical_grounding_for(node: v2.std.node.Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == dag_add_arrow_with_body_fixture {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_add_arrow_signature_fixture {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_add_binary_body_fixture {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_add_arrow_with_body_swapped_operands_fixture {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_add_binary_body_swapped_operands_fixture {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == add_body_ts_number_inhabitant {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_inhabitant_number) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_inhabitant
      )
    }
  } else if node == add_body_ts_number_facts_node {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_surface_spelling_number) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_facts_node
      )
    }
  } else if node == add_body_ts_arithmetic_semantics_node {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_number_ieee754_binary64) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_arithmetic_semantics_node
      )
    }
  } else if node == add_body_ts_bitwise_semantics_node {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_number_bitwise_int32_uint32) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_bitwise_semantics_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_bits64) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_ieee754_binary64) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^std_projection_additive_numeric) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^dag_token_plus) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_param_x) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_param_y) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_type_int) {
    v2.std.witness.Holds {
      value: add_body_ts_canonical_grounding(
        node: node,
        algebra: add_body_ts_number_inhabitant
      )
    }
  } else {
    match node.kind {
      TypeNode { connective: Atom { identity: id } } =>
        if id == ^dag_binding_type_int {
          v2.std.witness.Holds {
            value: add_body_ts_canonical_grounding(
              node: node,
              algebra: add_body_ts_number_inhabitant
            )
          }
        } else if id == ^dag_token_plus {
          v2.std.witness.Holds {
            value: add_body_ts_canonical_grounding(node: node, algebra: node)
          }
        } else if id == ^dag_binding_param_x {
          v2.std.witness.Holds {
            value: add_body_ts_canonical_grounding(node: node, algebra: node)
          }
        } else if id == ^dag_binding_param_y {
          v2.std.witness.Holds {
            value: add_body_ts_canonical_grounding(node: node, algebra: node)
          }
        } else {
          v2.std.witness.Violates {
            diagnostic: v2.std.diagnostic.Diagnostic {
              reason: ^add_body_ts_body_grounding_miss,
              at: node_locus(node: node),
              correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
            }
          }
        }
      _ =>
        v2.std.witness.Violates {
          diagnostic: v2.std.diagnostic.Diagnostic {
            reason: ^add_body_ts_body_grounding_miss,
            at: node_locus(node: node),
            correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
          }
        }
    }
  }
}

fn add_body_ts_inferred_facts_for(node: v2.std.node.Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match add_body_ts_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn add_body_ts_facts_lookup(key: v2.std.node.Node) -> Optional<v2.compiler.infer.InferredFacts> {
  add_body_ts_inferred_facts_for(node: key)
}

fn add_body_ts_inferred_tree_for(root: v2.std.node.Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: add_body_ts_facts_lookup }
  }
}

fn add_body_ts_producer_inferred_tree() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_add_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: add_body_ts_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn add_body_ts_producer_swapped_inferred_tree() -> v2.std.diagnostic.Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_add_arrow_with_body_swapped_operands() {
    Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: add_body_ts_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn add_body_ts_emit_from_producer_tree(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Medium<String>> {
  bind_outcome(
    o: add_body_ts_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn add_body_ts_emit_from_producer_swapped_tree(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Medium<String>> {
  bind_outcome(
    o: add_body_ts_producer_swapped_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn add_body_ts_emit_add_fn_accepts_holds() -> Bool {
  match add_body_ts_emit_from_producer_tree(target: ts_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == ts_source_text) && (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_emit_operand_swap_discriminates() -> Bool {
  match add_body_ts_emit_from_producer_swapped_tree(target: ts_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == add_body_ts_emit_operand_swap_source_text) &&
      (source.carried != ts_source_text) &&
      (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_emit_catalog_minus_discriminates() -> Bool {
  match add_body_ts_emit_from_producer_tree(target: add_body_ts_target_model_minus_catalog()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == add_body_ts_emit_catalog_minus_source_text) &&
      (source.carried != ts_source_text) &&
      (d == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_emit_missing_catalog_rejects() -> Bool {
  match add_body_ts_emit_from_producer_tree(
    target: add_body_ts_target_model_missing_operator_catalog()
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
