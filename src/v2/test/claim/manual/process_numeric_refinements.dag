module v2.test.manual.process_numeric_refinements


fn witness_exit_code_256_rejects() -> Bool {
  match make_exit_code(value: 256, at: node_locus(node: stub_empty_conj)) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics } => diagnostics.head.reason == ^exit_code_out_of_range
  }
}

fn witness_process_id_zero_rejects() -> Bool {
  match make_process_id(value: 0, at: node_locus(node: stub_empty_conj)) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics } => diagnostics.head.reason == ^process_id_out_of_range
  }
}

fn witness_signal_num_zero_rejects() -> Bool {
  match make_signal_num(value: 0, at: node_locus(node: stub_empty_conj)) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics } => diagnostics.head.reason == ^signal_num_out_of_range
  }
}

fn process_refinement_claim_input(ok: Bool) -> Node {
  if ok {
    stub_empty_conj
  } else {
    stub_empty_disj
  }
}

data claim_exit_code_256_rejects: TestClaim = EqualsClaim {
  label: "manual/process: make_exit_code rejects 256",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: process_refinement_claim_input(ok: witness_exit_code_256_rejects()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_process_id_zero_rejects: TestClaim = EqualsClaim {
  label: "manual/process: make_process_id rejects 0",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: process_refinement_claim_input(ok: witness_process_id_zero_rejects()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_signal_num_zero_rejects: TestClaim = EqualsClaim {
  label: "manual/process: make_signal_num rejects 0",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: process_refinement_claim_input(ok: witness_signal_num_zero_rejects()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
