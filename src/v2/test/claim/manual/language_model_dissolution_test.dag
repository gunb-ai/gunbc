module v2.test.manual.language_model_dissolution


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn void_core_node() -> Node {
  model_core_first_primitive_substrate(core: bool_model_core())
}

fn void_lex_node() -> Node {
  lex_rules_to_node(rules: VoidLexRules)
}

fn void_grammar_node() -> Node {
  grammar_to_node(grammar: VoidGrammar)
}

test fn dag_subset_core_is_canonical_void() -> Bool {
  model_core_first_primitive_substrate(core: dag_language_model().core) == void_core_node()
}

test fn swift_subset_lex_is_canonical_void() -> Bool {
  lex_rules_to_node(rules: swift_primitive_language_model().lex) == void_lex_node()
}

test fn swift_subset_grammar_is_canonical_void() -> Bool {
  grammar_to_node(grammar: swift_primitive_language_model().grammar) == void_grammar_node()
}

test fn go_full_shape_core_is_not_void() -> Bool {
  !(model_core_first_primitive_substrate(core: go_language_model().core) == void_core_node())
}

test fn go_full_shape_grammar_is_not_void() -> Bool {
  !(grammar_to_node(grammar: go_language_model().grammar) == void_grammar_node())
}
