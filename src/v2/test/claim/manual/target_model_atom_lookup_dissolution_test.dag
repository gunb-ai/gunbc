module v2.test.manual.target_model_atom_lookup_dissolution

fn atom_lookup_dissolution_probe_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^atom_lookup_dissolution_probe } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

test fn passing_candidate_fold_duplicate_produces_many() -> Bool {
  match v2.std.algebra.fold_list(
    xs: [atom_lookup_dissolution_probe_node(), atom_lookup_dissolution_probe_node()],
    empty: v2.std.passing_candidate_fold.NoPassingCandidate,
    cons: fn(acc, n) {
      match acc {
        NoPassingCandidate => v2.std.passing_candidate_fold.OnePassingCandidate { candidate: n }
        OnePassingCandidate { candidate: _ } => v2.std.passing_candidate_fold.ManyPassingCandidates
        ManyPassingCandidates => v2.std.passing_candidate_fold.ManyPassingCandidates
      }
    }
  ) {
    NoPassingCandidate => false
    OnePassingCandidate { candidate: _ } => false
    ManyPassingCandidates => true
  }
}

test fn atom_lookup_in_catalog_known_carrier_accepts() -> Bool {
  match v2.std.compilers.target_model.target_atom_realization_lookup_in_catalog(
    catalog: v2.extdeps.languages.typescript.ts_target_atom_realization_catalog,
    source_carrier: v2.std.compilers.target_model.symbol_kernel_type_node()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn atom_lookup_in_catalog_unknown_carrier_rejects_miss() -> Bool {
  match v2.std.compilers.target_model.target_atom_realization_lookup_in_catalog(
    catalog: v2.extdeps.languages.typescript.ts_target_atom_realization_catalog,
    source_carrier: atom_lookup_dissolution_probe_node()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_atom_realization_lookup_miss
  }
}

test fn atom_lookup_in_catalog_node_non_conj_rejects_decode_invalid() -> Bool {
  match v2.std.compilers.target_model.target_atom_realization_lookup_in_catalog_node(
    catalog: atom_lookup_dissolution_probe_node(),
    source_carrier: atom_lookup_dissolution_probe_node(),
    host_target_model: v2.extdeps.languages.typescript.ts_sg2_type_expr_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_atom_realization_catalog_row_decode_invalid
  }
}

test fn atom_catalog_with_malformed_row_skips_accepts_valid() -> Bool {
  match v2.std.compilers.target_model.target_atom_realization_lookup_in_catalog_node(
    catalog: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
      children: [
        v2.std.node.Edge { label: v2.std.node.Positional, target: atom_lookup_dissolution_probe_node() },
        v2.std.node.Edge {
          label: v2.std.node.Positional,
          target: v2.std.compilers.target_model.target_atom_realization_to_node(
            row: v2.extdeps.languages.typescript.ts_target_atom_realization_bool,
            host_bundle: v2.extdeps.languages.typescript.ts_sg2_type_expr_target_model_node()
          )
        }
      ],
      occurrence_id: v2.std.node.SyntheticOccurrence
    },
    source_carrier: v2.std.logic.bool_node(),
    host_target_model: v2.extdeps.languages.typescript.ts_sg2_type_expr_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

