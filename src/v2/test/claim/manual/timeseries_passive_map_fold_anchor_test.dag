module v2.test.manual.timeseries_passive_map_fold_anchor

import std.algebra { Cons, Empty }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import std.nat { Zero }
import v2.std.timeseries_signal {
  CapacitorFold,
  CapacitorRating,
  CapacitorState,
  FoldStep,
  InductorFold,
  InductorRating,
  InductorState,
  MapStep,
  ResistorMap,
  ResistorRating,
  StepBranchVoltage,
  StepCurrent,
  StepPotentialDifference,
  TimeSeriesSample,
  TimeSeriesSignal,
  TimeStep,
  capacitance_micro,
  capacitance_micro_count,
  capacitor_fold_step,
  charge_micro,
  charge_micro_count,
  current,
  current_count,
  duration_micro,
  fold_capacitor_transient,
  flux_micro,
  flux_micro_count,
  inductance_micro,
  inductor_fold_step,
  resistance_micro,
  resistor_map_voltage,
  voltage,
  voltage_count,
}
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data timeseries_anchor_resistor: ResistorMap = ResistorMap {
  kind: MapStep
  rating: ResistorRating { microohms: resistance_micro(1000) }
}

data timeseries_anchor_current: StepCurrent = StepCurrent {
  microamperes: current(2)
}

data timeseries_anchor_capacitor: CapacitorFold = CapacitorFold {
  kind: FoldStep
  rating: CapacitorRating { microfarads: capacitance_micro(2) }
}

data timeseries_anchor_cap_initial: CapacitorState = CapacitorState {
  voltage: StepPotentialDifference { microvolts: voltage(0) }
  charge_microcoulombs: charge_micro(0)
}

data timeseries_anchor_inductor: InductorFold = InductorFold {
  kind: FoldStep
  rating: InductorRating { microhenries: inductance_micro(2) }
}

data timeseries_anchor_ind_initial: InductorState = InductorState {
  current: StepCurrent { microamperes: current(0) }
  flux_microwebers: flux_micro(0)
}

data timeseries_anchor_voltage: StepBranchVoltage = StepBranchVoltage {
  difference: StepPotentialDifference { microvolts: voltage(4) }
}

data timeseries_anchor_dt: TimeStep = TimeStep {
  dt_microseconds: duration_micro(1000)
}

data timeseries_anchor_tick0: TimeSeriesSample = TimeSeriesSample {
  tick: Zero
  microvolts: voltage(0)
}

data timeseries_anchor_signal: TimeSeriesSignal = Cons {
  head: timeseries_anchor_tick0,
  tail: Empty
}

test fn timeseries_anchor_resistor_map_holds() -> Bool {
  let mapped = resistor_map_voltage(
    element: timeseries_anchor_resistor,
    current: timeseries_anchor_current,
  )
  voltage_count(mapped.difference.microvolts) == 2000
}

test fn timeseries_signed_magnitude_resistor_map_holds() -> Bool {
  let mapped = resistor_map_voltage(
    element: ResistorMap {
      kind: MapStep
      rating: ResistorRating { microohms: resistance_micro(1000) }
    },
    current: StepCurrent { microamperes: current(-3) },
  )
  voltage_count(mapped.difference.microvolts) == -3000
}

data timeseries_signed_cap_initial_positive: CapacitorState = CapacitorState {
  voltage: StepPotentialDifference { microvolts: voltage(500) }
  charge_microcoulombs: charge_micro(1000)
}

test fn timeseries_signed_magnitude_capacitor_fold_holds() -> Bool {
  match capacitor_fold_step(
    element: timeseries_anchor_capacitor,
    state: timeseries_signed_cap_initial_positive,
    current: StepCurrent { microamperes: current(-2) },
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      charge_micro_count(stepped.charge_microcoulombs) == -1000
        && voltage_count(stepped.voltage.microvolts) == -500
    Rejected { diagnostics: _ } => false
  }
}

test fn timeseries_anchor_capacitor_fold_holds() -> Bool {
  match capacitor_fold_step(
    element: timeseries_anchor_capacitor,
    state: timeseries_anchor_cap_initial,
    current: timeseries_anchor_current,
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      charge_micro_count(stepped.charge_microcoulombs) == 2000
        && voltage_count(stepped.voltage.microvolts) == 1000
    Rejected { diagnostics: _ } => false
  }
}

data timeseries_anchor_current_low: StepCurrent = StepCurrent {
  microamperes: current(2)
}

data timeseries_anchor_current_high: StepCurrent = StepCurrent {
  microamperes: current(4)
}

data timeseries_anchor_current_pair: List<StepCurrent> = Cons {
  head: timeseries_anchor_current_low,
  tail: Cons { head: timeseries_anchor_current_high, tail: Empty }
}

test fn timeseries_anchor_capacitor_fold_chronological_holds() -> Bool {
  match fold_capacitor_transient(
    element: timeseries_anchor_capacitor,
    initial: timeseries_anchor_cap_initial,
    currents: timeseries_anchor_current_pair,
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      voltage_count(stepped.voltage.microvolts) == 3000
    Rejected { diagnostics: _ } => false
  }
}

data timeseries_anchor_cap_zero_rating: CapacitorFold = CapacitorFold {
  kind: FoldStep
  rating: CapacitorRating { microfarads: capacitance_micro(0) }
}

test fn timeseries_anchor_capacitor_zero_rating_rejects() -> Bool {
  match capacitor_fold_step(
    element: timeseries_anchor_cap_zero_rating,
    state: timeseries_anchor_cap_initial,
    current: timeseries_anchor_current,
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn timeseries_anchor_inductor_fold_holds() -> Bool {
  match inductor_fold_step(
    element: timeseries_anchor_inductor,
    state: timeseries_anchor_ind_initial,
    voltage: timeseries_anchor_voltage,
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      flux_micro_count(stepped.flux_microwebers) == 4000
        && current_count(stepped.current.microamperes) == 2000
    Rejected { diagnostics: _ } => false
  }
}

data claim_timeseries_passive_map_fold_compiles: TestClaim = CompilesClaim {
  label: "manual/timeseries_passive_map_fold_anchor: S1 map/fold passives compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: timeseries_anchor_resistor,
  expected_value: timeseries_anchor_resistor,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
