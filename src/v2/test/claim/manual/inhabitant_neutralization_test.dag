module v2.test.manual.inhabitant_neutralization


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn inhabitant_neutralization_python_int_std_projection_holds() -> Bool {
  match v2.std.inhabitant_neutralization.inhabitant_std_projection_symbol(inhabitant: v2.extdeps.languages.python.python_int_inhabitant_node()) {
    v2.std.diagnostic.Accepted { value: proj, diagnostics: _ } => proj == ^std_projection_additive_numeric
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_ts_target_lookup_holds() -> Bool {
  match v2.std.inhabitant_neutralization.target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: v2.extdeps.languages.typescript.ts_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

