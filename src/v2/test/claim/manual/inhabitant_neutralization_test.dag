module v2.test.manual.inhabitant_neutralization


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn inhabitant_neutralization_python_int_std_projection_holds() -> v2.std.logic.Bool {
  match inhabitant_std_projection_symbol(inhabitant: python_int_inhabitant_node()) {
    Accepted { value: proj, diagnostics: _ } => proj == ^std_projection_additive_numeric
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_ts_target_lookup_holds() -> v2.std.logic.Bool {
  match target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: ts_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

