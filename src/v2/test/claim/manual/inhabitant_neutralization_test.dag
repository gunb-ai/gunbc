module v2.test.manual.inhabitant_neutralization

import v2.compiler.emit { emit }
import v2.compiler.ingest { cross_language_compile }
import v2.compiler.infer { infer }
import v2.compiler.translate { translate }
import v2.extdeps.languages.go {
  go_facts_float64,
  go_facts_int,
  go_int64_additive_numeric_inhabitant_node,
  go_int64_falsifier_emitted_add_fn_node,
  go_int_additive_numeric_inhabitant_node,
  go_int_inhabitant_node,
  go_source_text,
  go_target_model,
  go_target_model_int64_selection_policy
}
import v2.extdeps.languages.python {
  python_int_inhabitant_node,
  python_emitted_add_fn_node,
  python_target_model
}
import v2.test.manual.ingest_bridge { ingest_cross_language_compile_holds }
import v2.test.manual.python_grammar_claim { python_grammar_parse_fixture }
import v2.extdeps.languages.typescript { ts_source_text, ts_target_model }
import v2.std.inhabitant_neutralization {
  inhabitant_std_projection_symbol,
  neutralize_core_for_target,
  target_inhabitant_for_std_projection
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  UnifiedTestClaim,
  manual_claim_anchor
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn inhabitant_neutralization_python_int_std_projection_holds() -> Bool {
  match inhabitant_std_projection_symbol(inhabitant: python_int_inhabitant_node()) {
    Accepted { value: proj, diagnostics: _ } => proj == ^std_projection_additive_numeric
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_ts_target_lookup_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: ts_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_go_int64_std_projection_holds() -> Bool {
  match inhabitant_std_projection_symbol(
    inhabitant: go_int64_additive_numeric_inhabitant_node()
  ) {
    Accepted { value: proj, diagnostics: _ } => proj == ^std_projection_additive_numeric
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_go_int_additive_numeric_std_projection_holds() -> Bool {
  match inhabitant_std_projection_symbol(
    inhabitant: go_int_additive_numeric_inhabitant_node()
  ) {
    Accepted { value: proj, diagnostics: _ } => proj == ^std_projection_additive_numeric
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_go_int_additive_numeric_target_lookup_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: go_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_go_additive_numeric_lookup_tiebreak_selects_platform_int_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: go_target_model()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int_additive_numeric_inhabitant_node()
    Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_go_additive_numeric_lookup_policy_flip_selects_int64_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: go_target_model_int64_selection_policy()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int64_additive_numeric_inhabitant_node()
    Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_go_platform_std_projection_lookup_baseline_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: go_facts_int.std_projection,
    target: go_target_model()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int_inhabitant_node()
    Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_go_unqualified_std_projection_lookup_rejects_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: go_facts_float64.std_projection,
    target: go_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn inhabitant_neutralization_go_int64_to_ts_emit_holds() -> Bool {
  match neutralize_core_for_target(
    core: go_int64_falsifier_emitted_add_fn_node(),
    target: ts_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: ts_target_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_neutralize_python_to_go_holds() -> Bool {
  match neutralize_core_for_target(
    core: python_emitted_add_fn_node(),
    target: go_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_third_inhabitant_falsifier_holds() -> Bool {
  inhabitant_neutralization_go_int64_std_projection_holds()
    && inhabitant_neutralization_go_int_additive_numeric_std_projection_holds()
    && inhabitant_neutralization_go_int_additive_numeric_target_lookup_holds()
    && inhabitant_neutralization_go_additive_numeric_lookup_tiebreak_selects_platform_int_holds()
    && inhabitant_neutralization_neutralize_python_to_go_holds()
    && inhabitant_neutralization_go_int64_to_ts_emit_holds()
}

test fn inhabitant_neutralization_emit_after_neutralize_holds() -> Bool {
  match neutralize_core_for_target(
    core: python_emitted_add_fn_node(),
    target: ts_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: ts_target_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_raw_emit_still_fails_closed() -> Bool {
  match infer(tree: python_emitted_add_fn_node()) {
    Accepted { value: inferred, diagnostics: _ } =>
      match emit(tree: inferred, target: ts_target_model()) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_same_language_cross_language_compile_unchanged_holds() -> Bool {
  ingest_cross_language_compile_holds()
}

fn inhabitant_neutralization_same_flavor_python_emit_holds() -> Bool {
  match neutralize_core_for_target(
    core: python_emitted_add_fn_node(),
    target: python_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: python_target_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_03_ingest_regression_guard_holds() -> Bool {
  inhabitant_neutralization_same_language_cross_language_compile_unchanged_holds()
    && inhabitant_neutralization_same_flavor_python_emit_holds()
    && inhabitant_neutralization_raw_emit_still_fails_closed()
}

fn inhabitant_neutralization_python_to_ts_cross_language_compile_e2e_holds() -> Bool {
  match python_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: python_parse_tree,
        source_model: python_target_model(),
        target_model: ts_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } => source.carried == ts_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_python_to_go_cross_language_compile_e2e_holds() -> Bool {
  match python_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: python_parse_tree,
        source_model: python_target_model(),
        target_model: go_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } => source.carried == go_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_python_to_go_discriminates_on_real_tree() -> Bool {
  match python_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: python_parse_tree,
        source_model: python_target_model(),
        target_model: ts_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } => source.carried == ts_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


fn inhabitant_neutralization_python_to_go_holds() -> Bool {
  inhabitant_neutralization_python_to_go_cross_language_compile_e2e_holds()
    && inhabitant_neutralization_python_to_go_discriminates_on_real_tree()
}

fn inhabitant_neutralization_python_to_go_translate_rejects() -> Bool {
  match neutralize_core_for_target(
    core: python_emitted_add_fn_node(),
    target: go_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match translate(tree: inferred, target: go_target_model()) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_python_to_go_emit_rejects() -> Bool {
  match neutralize_core_for_target(
    core: python_emitted_add_fn_node(),
    target: go_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: go_target_model()) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}



data claim_inhabitant_neutralization_module_compiles: TestClaim = CompilesClaim {
  label: "manual/inhabitant_neutralization: module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: python_emitted_add_fn_node(),
  expected_value: python_emitted_add_fn_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data inhabitant_neutralization_manual_orphan_pins: Bool = if false {
  inhabitant_neutralization_python_int_std_projection_holds()
    && inhabitant_neutralization_ts_target_lookup_holds()
    && inhabitant_neutralization_python_to_ts_cross_language_compile_e2e_holds()
    && inhabitant_neutralization_python_to_go_holds()
    && inhabitant_neutralization_python_to_go_translate_rejects()
    && inhabitant_neutralization_python_to_go_emit_rejects()
} else {
  true
}

