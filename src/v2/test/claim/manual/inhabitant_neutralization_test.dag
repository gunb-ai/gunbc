fn inhabitant_neutralization_go_additive_numeric_lookup_tiebreak_selects_platform_int_holds() -> Bool {
  match v2.std.inhabitant_neutralization.target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: v2.extdeps.languages.go.go_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: selected, diagnostics: _ } =>
      selected == v2.extdeps.languages.go.go_int_additive_numeric_inhabitant_node()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_go_additive_numeric_lookup_policy_flip_selects_int64_holds() -> Bool {
  match v2.std.inhabitant_neutralization.target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
