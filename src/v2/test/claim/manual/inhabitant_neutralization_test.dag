fn inhabitant_neutralization_go_additive_numeric_lookup_tiebreak_selects_platform_int_holds() -> v2.std.logic.Bool {
  match target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: go_target_model()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int_additive_numeric_inhabitant_node()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_go_additive_numeric_lookup_policy_flip_selects_int64_holds() -> v2.std.logic.Bool {
  match target_inhabitant_for_std_projection(
    std_projection: ^std_projection_additive_numeric,
    target: go_target_model_int64_selection_policy()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int64_additive_numeric_inhabitant_node()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_go_platform_std_projection_lookup_baseline_holds() -> v2.std.logic.Bool {
  match target_inhabitant_for_std_projection(
    std_projection: go_facts_int.std_projection,
    target: go_target_model()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int_inhabitant_node()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
