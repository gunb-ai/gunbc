  ) {
    v2.std.diagnostic.Accepted { value: selected, diagnostics: _ } =>
      selected == v2.extdeps.languages.go.go_int64_additive_numeric_inhabitant_node()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_go_platform_std_projection_lookup_baseline_holds() -> Bool {
  match v2.std.inhabitant_neutralization.target_inhabitant_for_std_projection(
    std_projection: go_facts_int.std_projection,
    target: v2.extdeps.languages.go.go_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: selected, diagnostics: _ } =>
      selected == v2.extdeps.languages.go.go_int_inhabitant_node()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_go_unqualified_std_projection_lookup_rejects_holds() -> Bool {
  match v2.std.inhabitant_neutralization.target_inhabitant_for_std_projection(
    std_projection: go_facts_float64.std_projection,
    target: v2.extdeps.languages.go.go_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

fn inhabitant_neutralization_go_int64_to_ts_emit_refuses_underived_holds() -> Bool {
  match v2.std.inhabitant_neutralization.neutralize_core_for_target(
    core: v2.extdeps.languages.go.go_int64_falsifier_emitted_add_fn_node(),
    target: v2.extdeps.languages.typescript.ts_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: neutralized, diagnostics: _ } =>
      match v2.compiler.infer.infer(tree: neutralized) {
        v2.std.diagnostic.Accepted { value: inferred, diagnostics: _ } =>
          match v2.compiler.emit.emit(tree: inferred, target: v2.extdeps.languages.typescript.ts_target_model()) {
            v2.std.diagnostic.Rejected { diagnostics: d } =>
              d.head.reason == ^infer_grounding_not_derived
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_neutralize_python_to_go_holds() -> Bool {
  match v2.std.inhabitant_neutralization.neutralize_core_for_target(
    core: v2.extdeps.languages.python.python_emitted_add_fn_node(),
    target: v2.extdeps.languages.go.go_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_third_inhabitant_falsifier_holds() -> Bool {
  inhabitant_neutralization_python_int_std_projection_holds()
    && inhabitant_neutralization_ts_target_lookup_holds()
    && inhabitant_neutralization_go_int64_std_projection_holds()
    && inhabitant_neutralization_go_int_additive_numeric_std_projection_holds()
    && inhabitant_neutralization_go_int_additive_numeric_target_lookup_holds()
    && inhabitant_neutralization_go_additive_numeric_lookup_tiebreak_selects_platform_int_holds()
    && inhabitant_neutralization_neutralize_python_to_go_holds()
    && inhabitant_neutralization_go_int64_to_ts_emit_refuses_underived_holds()
}

test fn inhabitant_neutralization_emit_after_neutralize_refuses_underived_holds() -> Bool {
  match v2.std.inhabitant_neutralization.neutralize_core_for_target(
    core: v2.extdeps.languages.python.python_emitted_add_fn_node(),
    target: v2.extdeps.languages.typescript.ts_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: neutralized, diagnostics: _ } =>
      match v2.compiler.infer.infer(tree: neutralized) {
        v2.std.diagnostic.Accepted { value: inferred, diagnostics: _ } =>
          match v2.compiler.emit.emit(tree: inferred, target: v2.extdeps.languages.typescript.ts_target_model()) {
            v2.std.diagnostic.Rejected { diagnostics: d } =>
              d.head.reason == ^infer_grounding_not_derived
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_raw_emit_still_fails_closed() -> Bool {
  match v2.compiler.infer.infer(tree: v2.extdeps.languages.python.python_emitted_add_fn_node()) {
    v2.std.diagnostic.Accepted { value: inferred, diagnostics: _ } =>
      match v2.compiler.emit.emit(tree: inferred, target: v2.extdeps.languages.typescript.ts_target_model()) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => true
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_same_language_cross_language_compile_unchanged_holds() -> Bool {
  v2.test.manual.ingest_bridge.ingest_cross_language_compile_refuses_underived_holds()
}

fn inhabitant_neutralization_same_flavor_python_emit_refuses_underived_holds() -> Bool {
  match v2.std.inhabitant_neutralization.neutralize_core_for_target(
    core: v2.extdeps.languages.python.python_emitted_add_fn_node(),
    target: v2.extdeps.languages.python.python_target_model()
  ) {
    v2.std.diagnostic.Accepted { value: neutralized, diagnostics: _ } =>
      match v2.compiler.infer.infer(tree: neutralized) {
        v2.std.diagnostic.Accepted { value: inferred, diagnostics: _ } =>
          match v2.compiler.emit.emit(tree: inferred, target: v2.extdeps.languages.python.python_target_model()) {
            v2.std.diagnostic.Rejected { diagnostics: d } =>
              d.head.reason == ^infer_grounding_not_derived
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_03_ingest_regression_guard_holds() -> Bool {
  inhabitant_neutralization_same_language_cross_language_compile_unchanged_holds()
    && inhabitant_neutralization_same_flavor_python_emit_refuses_underived_holds()
    && inhabitant_neutralization_raw_emit_still_fails_closed()
}










data claim_inhabitant_neutralization_module_compiles: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/inhabitant_neutralization: module compiles",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: v2.extdeps.languages.python.python_emitted_add_fn_node(),
  expected_value: v2.extdeps.languages.python.python_emitted_add_fn_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}


