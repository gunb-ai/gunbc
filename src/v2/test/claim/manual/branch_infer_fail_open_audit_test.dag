module v2.test.manual.branch_infer_fail_open_audit

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn branch_infer_fail_open_audit_body() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_pick_if_body_from_arms(
    condition: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_token_kw_true),
    then_arm: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_pick_lit_one),
    else_arm: v2.extdeps.languages.dag.dag_type_atom_node(identity: ^dag_token_ident)
  )
}

test fn branch_infer_fail_open_audit_rejects_holds() -> Bool {
  match v2.compiler.infer.infer(tree: branch_infer_fail_open_audit_body()) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
    && !branch_infer_fail_open_audit_silent_accept_holds()
}

fn branch_infer_fail_open_audit_silent_accept_holds() -> Bool {
  match v2.compiler.infer.infer(tree: branch_infer_fail_open_audit_body()) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn branch_infer_fail_open_audit_literal_arm_accepts_holds() -> Bool {
  match v2.compiler.infer.infer(tree: v2.extdeps.languages.dag.dag_pick_if_body_fixture) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

