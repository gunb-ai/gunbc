module v2.test.manual.resolve_compile_anchor

fn service_atom_conj_tree() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn anchor_resolve_service_atom_via_canonical_symbols() -> Outcome<v2.compiler.resolve.ResolvedTree> {
  resolve(
    tree: service_atom_conj_tree(),
    lm: dag_language_model_void()
  )
}

fn anchor_resolve_empty_prelude_service_atom() -> Outcome<v2.compiler.resolve.ResolvedTree> {
  resolve(
    tree: service_atom_conj_tree(),
    lm: dag_language_model_surface_empty_prelude()
  )
}

fn anchor_resolve_multi_edge_conj_via_canonical_symbols() -> Outcome<v2.compiler.resolve.ResolvedTree> {
  match admit_normalized_tree(
    root: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [
        v2.std.node.Edge {
          label: Named { name: ^anchor_decl_first },
          target: v2.std.node.Node {
            kind: v2.std.node.TypeNode {
              connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
            },
            children: [],
            occurrence_id: SyntheticOccurrence
          }
        },
        v2.std.node.Edge {
          label: Named { name: ^anchor_decl_second },
          target: v2.std.node.Node {
            kind: v2.std.node.TypeNode {
              connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_type }
            },
            children: [],
            occurrence_id: SyntheticOccurrence
          }
        }
      ],
      occurrence_id: SyntheticOccurrence
},
    diagnostics: None
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: t, diagnostics: _ } => resolve(tree: t, lm: dag_language_model_void())
  }
}

fn anchor_resolve_bind_binder_use() -> Outcome<v2.compiler.resolve.ResolvedTree> {
  match admit_normalized_tree(
    root: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [
        v2.std.node.Edge {
          label: Named { name: ^anchor_decl_first },
          target: v2.std.node.Node {
            kind: v2.std.node.ComputationNode { behavior: Bind },
            children: [
              v2.std.node.Edge {
                label: Positional,
                target: v2.std.node.Node {
                  kind: v2.std.node.TypeNode {
                    connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_fn }
                  },
                  children: [],
                  occurrence_id: SyntheticOccurrence
                }
              },
              v2.std.node.Edge {
                label: Positional,
                target: v2.std.node.Node {
                  kind: v2.std.node.TypeNode {
                    connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
                  },
                  children: [],
                  occurrence_id: SyntheticOccurrence
                }
              },
              v2.std.node.Edge {
                label: Positional,
                target: v2.std.node.Node {
                  kind: v2.std.node.TypeNode {
                    connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_fn }
                  },
                  children: [],
                  occurrence_id: SyntheticOccurrence
                }
              }
            ],
            occurrence_id: SyntheticOccurrence
          }
        }
      ],
      occurrence_id: SyntheticOccurrence
},
    diagnostics: None
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: t, diagnostics: _ } => resolve(tree: t, lm: dag_language_model_void())
  }
}

fn resolve_roots_claim_node(ok: Bool) -> Node {
  if ok {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^anchor_resolve_roots_pass } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  } else {
    v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^anchor_resolve_roots_fail } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn resolve_imported_qn_node() -> Node {
  fold_list_node(
    xs: std.algebra.Cons { head: ^anchor_imported_path_segment, tail: Empty },
    item_node: fn(sym) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    }
  )
}

fn resolve_imported_module_root() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: resolve_imported_qn_node()
      ),
      v2.std.node.Edge {
        label: Named { name: ^anchor_imported_decl },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode {
            connective: v2.std.node.Atom { identity: ^dag_c3_surface_sugar_service }
          },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn resolve_subject_qn_node() -> Node {
  fold_list_node(
    xs: std.algebra.Cons { head: ^anchor_subject_path_segment, tail: Empty },
    item_node: fn(sym) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    }
  )
}

fn resolve_subject_module_root() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: resolve_subject_qn_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn resolve_subject_module_root_with_import_use() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: resolve_subject_qn_node()
      ),
      v2.std.node.Edge {
        label: Named { name: ^anchor_subject_import_use },
        target: resolve_imported_use_tree()
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn resolve_subject_name() -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons { head: ^anchor_subject_path_segment, tail: Empty }
}

fn resolve_roots_single_import() -> Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  admit_normalized_roots(
    roots: std.algebra.Cons {
    head: resolve_subject_module_root_with_import_use(),
    tail: std.algebra.Cons {
      head: resolve_imported_module_root(),
      tail: Empty
    }
  },
    diagnostics: None
  )
}

fn resolve_imported_use_tree() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^anchor_imported_decl } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn resolve_import_target() -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons { head: ^anchor_imported_path_segment, tail: Empty }
}

fn resolve_with_admission_imported_binding_accepts() -> Bool {
  match resolve_roots_single_import() {
    Rejected { diagnostics: _ } => false
    Accepted { value: admitted, diagnostics: _ } =>
    match resolve_with_admission_policy(
      lm: dag_language_model_surface_empty_prelude(),
      roots: admitted,
      admission: v2.compiler.name_resolve.Admission {
        subject: v2.compiler.name_resolve.ResolutionSubject {
          name: resolve_subject_name()
        },
        imports: std.algebra.Cons {
          head: v2.compiler.name_resolve.Import {
            target: resolve_import_target(),
            visibility: ImportVisible
          },
          tail: Empty
        }
      },
      index: source_root_index_empty(),
      active_roots: Empty,
      policy: ImportScoped
    ) {
      Accepted { value: _, diagnostics: _ } => true
      Rejected { diagnostics: _ } => false
    }
  }
}

data claim_resolve_with_admission_imported_binding_accepts: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "resolve/with_admission: visible imported module named export resolves via module-root projection",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: resolve_roots_claim_node(ok: resolve_with_admission_imported_binding_accepts()),
  expected_value: resolve_roots_claim_node(ok: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
