module v2.test.manual.sg1b_signature_realization_failclosed


fn sg1b_fc_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg1b_fc_pass_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg1b_fc_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg1b_fc_fail_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg1b_fc_claim_input(ok: Bool) -> Node {
  if ok {
    sg1b_fc_pass_node()
  } else {
    sg1b_fc_fail_node()
  }
}

fn sg1b_fc_probe_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg1b_fc_probe_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg1b_fc_boundary_param_with_children() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: discriminant(v: FunctionBoundaryParam) } },
    children: [
      Edge { label: Positional, target: sg1b_fc_probe_node() }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn sg1b_fc_boundary_param_nullary() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: discriminant(v: FunctionBoundaryParam) } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg1b_fc_non_conj_catalog() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg1b_fc_probe_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg1b_fc_boundary_site_with_children_rejects_decode_invalid() -> Bool {
  match target_function_boundary_site_from_node(
    n: sg1b_fc_boundary_param_with_children(),
    source_carrier: sg1b_fc_probe_node()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_function_boundary_site_decode_invalid
  }
}

fn sg1b_fc_boundary_site_nullary_accepts() -> Bool {
  match target_function_boundary_site_from_node(
    n: sg1b_fc_boundary_param_nullary(),
    source_carrier: sg1b_fc_probe_node()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn sg1b_fc_atom_catalog_non_conj_rejects_decode_invalid() -> Bool {
  match target_atom_realization_lookup_in_catalog_node(
    catalog: sg1b_fc_non_conj_catalog(),
    source_carrier: sg1b_fc_probe_node(),
    host_target_model: rust_sg2_type_expr_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_atom_realization_catalog_row_decode_invalid
  }
}

fn sg1b_fc_signature_catalog_non_conj_rejects_decode_invalid() -> Bool {
  match target_function_signature_realization_lookup_in_catalog_node(
    catalog: sg1b_fc_non_conj_catalog(),
    source_carrier: sg1b_fc_probe_node(),
    boundary_site: FunctionBoundaryParam,
    host_target_model: rust_sg2_type_expr_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_function_signature_realization_row_decode_invalid
  }
}

data claim_sg1b_fc_boundary_site_with_children_rejects: TestClaim = CompilesClaim {
  label: "manual/sg1b: nullary FunctionBoundarySite atom carrying children rejects decode-invalid (Practice 2)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg1b_fc_claim_input(ok: sg1b_fc_boundary_site_with_children_rejects_decode_invalid()),
  expected_value: sg1b_fc_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg1b_fc_boundary_site_nullary_accepts: TestClaim = CompilesClaim {
  label: "manual/sg1b: well-formed nullary FunctionBoundarySite atom still decodes (happy path preserved)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg1b_fc_claim_input(ok: sg1b_fc_boundary_site_nullary_accepts()),
  expected_value: sg1b_fc_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg1b_fc_atom_catalog_non_conj_rejects: TestClaim = CompilesClaim {
  label: "manual/sg1: non-Conj atom-realization catalog rejects decode-invalid, not lookup-miss (P3 fail-closed)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg1b_fc_claim_input(ok: sg1b_fc_atom_catalog_non_conj_rejects_decode_invalid()),
  expected_value: sg1b_fc_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg1b_fc_signature_catalog_non_conj_rejects: TestClaim = CompilesClaim {
  label: "manual/sg1b: non-Conj signature-realization catalog rejects decode-invalid, not lookup-miss (P3 fail-closed)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg1b_fc_claim_input(ok: sg1b_fc_signature_catalog_non_conj_rejects_decode_invalid()),
  expected_value: sg1b_fc_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
