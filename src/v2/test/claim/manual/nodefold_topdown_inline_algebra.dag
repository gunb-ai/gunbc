module v2.test.manual.nodefold_topdown_inline_algebra

import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  NodeFoldTopDown,
  TypeNode,
  SyntheticOccurrence,
  fold_node_topdown
}
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

type MyFold {
  origin: Int
  state: Int
  at_conj: Bool
}

fn my_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^inline_leaf } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn inline_topdown_algebra() -> NodeFoldTopDown<MyFold, MyFold> {
  NodeFoldTopDown {
    init: fn(n, fold) {
      MyFold { origin: fold.origin, state: fold.state + 1, at_conj: true }
    },
    child_context: fn(n, fold, e) { fold },
    step: fn(acc, e, child_r) {
      if acc.at_conj { child_r } else { acc }
    }
  }
}

fn use_inline_topdown() -> Int {
  match fold_node_topdown(
    n: my_leaf(),
    ctx: MyFold { origin: 7, state: 0, at_conj: false },
    algebra: inline_topdown_algebra()
  ) {
    MyFold { origin: o, state: s, at_conj: _ } => o + s
  }
}

data witness_inline_topdown_field_access: Bool = use_inline_topdown() == 8

data claim_nodefold_topdown_inline_algebra_compiles: TestClaim = CompilesClaim {
  label: "manual/nodefold_topdown_inline_algebra: inline NodeFoldTopDown algebra compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: my_leaf(),
  expected_value: my_leaf(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nodefold_topdown_inline_field_access: TestClaim = CompilesClaim {
  label: "manual/nodefold_topdown_inline_algebra: init lambda reads fold.origin/state/at_conj",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: my_leaf(),
  expected_value: my_leaf(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
