module v2.test.manual.target_model_operator_lookup_dissolution

import v2.extdeps.languages.typescript { ts_add_operator_realization_row }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Conj, Edge, Named, Node, SyntheticOccurrence, TypeNode }
import v2.std.compilers.target_model {
  canonical_operation_op_add,
  target_operator_realization_catalog_lookup,
}

fn operator_lookup_dissolution_probe_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^operator_lookup_dissolution_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn operator_catalog_with_malformed_and_valid_rows() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^target_operator_realization_row_edge },
        target: operator_lookup_dissolution_probe_node()
      },
      Edge {
        label: Named { name: ^target_operator_realization_row_edge },
        target: ts_add_operator_realization_row()
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

test fn operator_lookup_known_op_accepts() -> Bool {
  match target_operator_realization_catalog_lookup(
    catalog: operator_catalog_with_malformed_and_valid_rows(),
    canonical_op: canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn operator_lookup_empty_catalog_rejects_miss() -> Bool {
  match target_operator_realization_catalog_lookup(
    catalog: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    },
    canonical_op: canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_operator_realization_catalog_miss
  }
}

test fn operator_catalog_with_malformed_row_skips_accepts_valid() -> Bool {
  match target_operator_realization_catalog_lookup(
    catalog: operator_catalog_with_malformed_and_valid_rows(),
    canonical_op: canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

