module v2.test.manual.target_model_operator_lookup_dissolution

fn operator_lookup_dissolution_probe_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^operator_lookup_dissolution_probe } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn operator_catalog_with_malformed_and_valid_rows() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^target_operator_realization_row_edge },
        target: operator_lookup_dissolution_probe_node()
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^target_operator_realization_row_edge },
        target: v2.extdeps.languages.typescript.ts_add_operator_realization_row()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

test fn operator_lookup_known_op_accepts() -> Bool {
  match v2.std.compilers.target_model.target_operator_realization_catalog_lookup(
    catalog: operator_catalog_with_malformed_and_valid_rows(),
    canonical_op: v2.std.compilers.target_model.canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn operator_lookup_empty_catalog_rejects_miss() -> Bool {
  match v2.std.compilers.target_model.target_operator_realization_catalog_lookup(
    catalog: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
      children: [],
      occurrence_id: v2.std.node.SyntheticOccurrence
    },
    canonical_op: v2.std.compilers.target_model.canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_operator_realization_catalog_miss
  }
}

test fn operator_catalog_with_malformed_row_skips_accepts_valid() -> Bool {
  match v2.std.compilers.target_model.target_operator_realization_catalog_lookup(
    catalog: operator_catalog_with_malformed_and_valid_rows(),
    canonical_op: v2.std.compilers.target_model.canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

