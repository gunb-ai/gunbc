module v2.test.manual.c_add_emit_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data c_add_int_inhabitant: Node = c_int_inhabitant_node()

data c_add_emitted_root: Node = c_emitted_add_fn_node()

data c_add_wrong_emitted_root: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Arrow },
  children: [
    v2.std.node.Edge { label: Positional, target: c_add_int_inhabitant },
    v2.std.node.Edge { label: Positional, target: c_add_int_inhabitant }
  ],
  occurrence_id: SyntheticOccurrence
}

data c_add_target_model: v2.std.compilers.target_model.TargetModel = c_target_model()

data c_add_empty_translation_rules_bundle: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data c_add_missing_translation_rules_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: c_add_empty_translation_rules_bundle,
  lex: c_lex(),
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn c_add_canonical_grounding(node: Node, algebra: Node) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn c_add_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == c_add_emitted_root {
    v2.std.witness.Holds { value: c_add_canonical_grounding(node: node, algebra: node) }
  } else if node == c_add_int_inhabitant {
    v2.std.witness.Holds { value: c_add_canonical_grounding(node: node, algebra: c_add_int_inhabitant) }
  } else if node == c_atom(id: ^c_inhabitant_int) {
    v2.std.witness.Holds { value: c_add_canonical_grounding(node: node, algebra: c_add_int_inhabitant) }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^c_add_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn c_add_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match c_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn c_add_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  c_add_inferred_facts_for(node: key)
}

data c_add_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: c_add_emitted_root,
  facts: std.types.Map { lookup: c_add_facts_lookup }
}

fn c_add_emit_accepts() -> v2.std.diagnostic.Outcome<Medium<String>> {
  emit(tree: c_add_inferred_tree, target: c_add_target_model)
}

data c_add_emit_receipt: Outcome<Medium<String>> = c_add_emit_accepts()

fn c_add_serialize_rejects_missing_translation_rules() -> v2.std.diagnostic.Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: c_add_missing_translation_rules_target,
    emitted: c_add_emitted_root
  )
}

data c_add_serialize_reject_receipt: Outcome<Medium<String>> = c_add_serialize_rejects_missing_translation_rules()

test fn c_add_emit_add_fn_accepts_holds() -> Bool {
  match c_add_emit_receipt {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == c_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn c_add_serialize_source_matches_authority_holds() -> Bool {
  match target_serialize_source_from_model(
    target: c_add_target_model,
    emitted: c_add_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: authority, diagnostics: d } =>
      (authority.carried == c_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn c_add_serialize_rejects_missing_translation_rules_holds() -> Bool {
  match c_add_serialize_reject_receipt {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

test fn c_add_emit_wrong_node_refuses_holds() -> Bool {
  let wrong_tree = v2.compiler.infer.InferredTree {
    root: c_add_wrong_emitted_root,
    facts: std.types.Map { lookup: c_add_facts_lookup }
  }
  match emit(tree: wrong_tree, target: c_add_target_model) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried != c_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

