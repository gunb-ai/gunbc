module v2.test.manual.c_add_emit_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data c_add_int_inhabitant: v2.std.node.Node = v2.extdeps.languages.c.c_int_inhabitant_node()

data c_add_emitted_root: v2.std.node.Node = v2.extdeps.languages.c.c_emitted_add_fn_node()

data c_add_wrong_emitted_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: c_add_int_inhabitant },
    v2.std.node.Edge { label: v2.std.node.Positional, target: c_add_int_inhabitant }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data c_add_target_model: v2.std.compilers.target_model.TargetModel = v2.extdeps.languages.c.c_target_model()

data c_add_empty_translation_rules_bundle: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data c_add_missing_translation_rules_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
  bundle: c_add_empty_translation_rules_bundle,
  lex: v2.extdeps.languages.c.c_lex(),
  binding_spellings: v2.std.collection.empty_map(),
  token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
}

fn c_add_canonical_grounding(node: v2.std.node.Node, algebra: v2.std.node.Node) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn c_add_canonical_grounding_for(node: v2.std.node.Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == c_add_emitted_root {
    v2.std.witness.Holds { value: c_add_canonical_grounding(node: node, algebra: node) }
  } else if node == c_add_int_inhabitant {
    v2.std.witness.Holds { value: c_add_canonical_grounding(node: node, algebra: c_add_int_inhabitant) }
  } else if node == v2.extdeps.languages.c.c_atom(id: ^c_inhabitant_int) {
    v2.std.witness.Holds { value: c_add_canonical_grounding(node: node, algebra: c_add_int_inhabitant) }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^c_add_grounding_miss,
        at: v2.std.diagnostic.node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  }
}

fn c_add_inferred_facts_for(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  match c_add_canonical_grounding_for(node: node) {
    v2.std.witness.Violates { diagnostic: d } => v2.std.optional.optional_absent()
    v2.std.witness.Holds { value: grounding } =>
      match v2.std.cardinality.termination_proof_witness_for_node(n: node) {
        v2.std.witness.Violates { diagnostic: d } => v2.std.optional.optional_absent()
        v2.std.witness.Holds { value: proof } =>
          v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn c_add_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  c_add_inferred_facts_for(node: key)
}

data c_add_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: c_add_emitted_root,
  facts: PartialFunction { lookup: c_add_facts_lookup }
}

fn c_add_emit_accepts() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.emit.emit(tree: c_add_inferred_tree, target: c_add_target_model)
}

data c_add_emit_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = c_add_emit_accepts()

fn c_add_serialize_rejects_missing_translation_rules() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.translate.target_serialize_source_from_model(
    target: c_add_missing_translation_rules_target,
    emitted: c_add_emitted_root
  )
}

data c_add_serialize_reject_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = c_add_serialize_rejects_missing_translation_rules()

test fn c_add_emit_add_fn_accepts_holds() -> Bool {
  match c_add_emit_receipt {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == v2.extdeps.languages.c.c_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn c_add_serialize_source_matches_authority_holds() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: c_add_target_model,
    emitted: c_add_emitted_root
  ) {
    v2.std.diagnostic.Accepted { value: authority, diagnostics: d } =>
      (authority.carried == v2.extdeps.languages.c.c_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn c_add_serialize_rejects_missing_translation_rules_holds() -> Bool {
  match c_add_serialize_reject_receipt {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

test fn c_add_emit_wrong_node_refuses_holds() -> Bool {
  let wrong_tree = v2.compiler.inferred_tree.InferredTree {
    root: c_add_wrong_emitted_root,
    facts: PartialFunction { lookup: c_add_facts_lookup }
  }
  match v2.compiler.emit.emit(tree: wrong_tree, target: c_add_target_model) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried != v2.extdeps.languages.c.c_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

