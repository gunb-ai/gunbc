module v2.test.manual.c_add_emit_translate


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data c_add_int_inhabitant: Node = c_int_inhabitant_node()

data c_add_emitted_root: Node = c_emitted_add_fn_node()

data c_add_wrong_emitted_root: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: c_add_int_inhabitant },
    Edge { label: Positional, target: c_add_int_inhabitant }
  ],
  occurrence_id: SyntheticOccurrence
}

data c_add_target_model: TargetModel = c_target_model()

data c_add_empty_translation_rules_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data c_add_missing_translation_rules_target: TargetModel = TargetModel {
  bundle: c_add_empty_translation_rules_bundle,
  lex: c_lex(),
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn c_add_canonical_grounding(node: Node, algebra: Node) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn c_add_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == c_add_emitted_root {
    Holds { value: c_add_canonical_grounding(node: node, algebra: node) }
  } else if node == c_add_int_inhabitant {
    Holds { value: c_add_canonical_grounding(node: node, algebra: c_add_int_inhabitant) }
  } else if node == c_atom(id: ^c_inhabitant_int) {
    Holds { value: c_add_canonical_grounding(node: node, algebra: c_add_int_inhabitant) }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^c_add_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn c_add_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match c_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn c_add_facts_lookup(key: Node) -> Witness<InferredFacts> {
  c_add_inferred_facts_for(node: key)
}

data c_add_inferred_tree: InferredTree = InferredTree {
  root: c_add_emitted_root,
  facts: Map { lookup: c_add_facts_lookup }
}

fn c_add_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: c_add_inferred_tree, target: c_add_target_model)
}

data c_add_emit_receipt: Outcome<Medium<String>> = c_add_emit_accepts()

fn c_add_serialize_rejects_missing_translation_rules() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: c_add_missing_translation_rules_target,
    emitted: c_add_emitted_root
  )
}

data c_add_serialize_reject_receipt: Outcome<Medium<String>> = c_add_serialize_rejects_missing_translation_rules()

test fn c_add_emit_add_fn_accepts_holds() -> Bool {
  match c_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == c_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn c_add_serialize_source_matches_authority_holds() -> Bool {
  match target_serialize_source_from_model(
    target: c_add_target_model,
    emitted: c_add_emitted_root
  ) {
    Accepted { value: authority, diagnostics: d } =>
      (authority.carried == c_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn c_add_serialize_rejects_missing_translation_rules_holds() -> Bool {
  match c_add_serialize_reject_receipt {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn c_add_emit_wrong_node_refuses_holds() -> Bool {
  let wrong_tree = InferredTree {
    root: c_add_wrong_emitted_root,
    facts: Map { lookup: c_add_facts_lookup }
  }
  match emit(tree: wrong_tree, target: c_add_target_model) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried != c_source_text) && (d == None)
    Rejected { diagnostics: _ } => true
  }
}

test fn c_add_emit_translate_keystone_holds() -> Bool {
  c_add_emit_add_fn_accepts_holds()
    && c_add_serialize_source_matches_authority_holds()
    && c_add_serialize_rejects_missing_translation_rules_holds()
    && c_add_emit_wrong_node_refuses_holds()
}
