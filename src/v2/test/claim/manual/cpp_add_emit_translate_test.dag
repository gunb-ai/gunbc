module v2.test.manual.cpp_add_emit_translate

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.compiler.emit { emit }
import v2.compiler.compile {
  CompileOutput,
  TranslateResult,
  TranslateTo,
  compile_inferred
}
import v2.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  run_test_claim_assert,
  test_claim_cache_receipt,
  test_claim_typed_input_node
}
import v2.compiler.translate {
  target_serialize_source_from_model,
  translate,
}
import v2.extdeps.languages.cpp {
  CppIntegerPrimitiveFacts,
  Int,
  cpp_atom,
  cpp_int_inhabitant_node,
  cpp_integer_facts_node,
  cpp_integer_scalar_fact_node,
  cpp_binding_spellings,
  cpp_emitted_add_fn_node,
  cpp_source_text,
  cpp_target_model,
  cpp_target_model_node,
  cpp_target_profile,
  cpp_signed_integer_facts,
  cpp_signed_integer_spelling_node,
  cpp_lex
}
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.compilers.target_model { TargetModel, target_model_emit_transforms_empty }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.test.manual.infer_ground_add {
  infer_receipt_context
}
import v2.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v2.std.collection {
  Map,
  empty_map
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.node {
  Arrow,
  Atom,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  DiagnosticClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  CompilesClaim,
  manual_claim_anchor
}
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data cpp_add_forbidden_authority_source_text: String = "authority_source_text_fallback_forbidden"

data cpp_add_target_profile: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^cpp_add_target_profile_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data cpp_add_int_primitive_facts: CppIntegerPrimitiveFacts = cpp_signed_integer_facts(
  spelling: Int,
  surface_spelling: ^cpp_surface_spelling_int,
  target_profile: cpp_target_profile
)

data cpp_add_int_inhabitant: Node = cpp_int_inhabitant_node(target_profile: cpp_target_profile)

data cpp_add_emitted_root: Node = cpp_emitted_add_fn_node(target_profile: cpp_target_profile)

data cpp_add_int_facts_node: Node = cpp_integer_facts_node(facts: cpp_add_int_primitive_facts)

data cpp_add_int_scalar_node: Node = cpp_integer_scalar_fact_node(facts: cpp_add_int_primitive_facts)

data cpp_add_int_width_node: Node = cpp_add_int_primitive_facts.width_fact

data cpp_add_int_spelling_node: Node = cpp_signed_integer_spelling_node(spelling: Int)

data cpp_add_target_model: TargetModel = cpp_target_model()

data cpp_add_poisoned_authority_target_model: TargetModel = TargetModel {
  bundle: cpp_target_model_node(target_profile: cpp_target_profile),
  lex: cpp_lex(),
  binding_spellings: cpp_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: cpp_add_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data cpp_add_empty_translation_rules_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data cpp_add_missing_translation_rules_target: TargetModel = TargetModel {
  bundle: cpp_add_empty_translation_rules_bundle,
  lex: cpp_lex(),
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_cpp_add_serialize_rejects_missing_translation_rules() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: cpp_add_missing_translation_rules_target,
    emitted: cpp_add_emitted_root
  )
}

data cpp_add_serialize_reject_receipt: Outcome<Medium<String>> = anchor_cpp_add_serialize_rejects_missing_translation_rules()

fn cpp_add_serialize_reject_claim_outcome() -> Outcome<Node> {
  match cpp_add_serialize_reject_receipt {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: ^cpp_add_serialize_unexpected_accept,
            at: node_locus(node: cpp_add_emitted_root),
            correction: Unavailable { reason: ExternalContractUnknown }
          }
        )
      }
  }
}

fn cpp_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn cpp_add_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == cpp_add_emitted_root {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == cpp_add_int_inhabitant {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_facts_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_inhabitant_int) {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_inhabitant
      )
    }
  } else if node == cpp_add_int_facts_node {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == cpp_atom(id: ^cpp_surface_spelling_int) {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_facts_node
      )
    }
  } else if node == cpp_add_int_scalar_node {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_facts_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_tag_signed_integer) {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_scalar_node
      )
    }
  } else if node == cpp_add_int_width_node {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_scalar_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_tag_width_selection) {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_width_node
      )
    }
  } else if node == cpp_add_int_spelling_node {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_width_node
      )
    }
  } else if node == cpp_target_profile {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_width_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_tag_twos_complement) {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_scalar_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_tag_representable_result_required) {
    Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_scalar_node
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^cpp_add_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn cpp_add_inferred_facts_for(node: Node) -> Optional<InferredFacts> {
  match cpp_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            ))
      }
  }
}

fn cpp_add_facts_lookup(key: Node) -> Optional<InferredFacts> {
  cpp_add_inferred_facts_for(node: key)
}

data cpp_add_inferred_tree: InferredTree = InferredTree {
  root: cpp_add_emitted_root,
  facts: Map {
    lookup: cpp_add_facts_lookup
  }
}

fn anchor_cpp_add_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: cpp_add_inferred_tree, target: cpp_add_target_model)
}

fn anchor_cpp_add_compile_inferred_accepts() -> Outcome<CompileOutput> {
  compile_inferred(
    inferred: cpp_add_inferred_tree,
    mode: TranslateTo { target: cpp_add_poisoned_authority_target_model }
  )
}

data cpp_add_emit_receipt: Outcome<Medium<String>> = anchor_cpp_add_emit_accepts()

data cpp_add_compile_inferred_receipt: Outcome<CompileOutput> = anchor_cpp_add_compile_inferred_accepts()

fn cpp_add_emit_claim_outcome() -> Outcome<Node> {
  match cpp_add_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      if (source.carried == cpp_source_text) && (d == None) {
        Accepted { value: cpp_add_emitted_root, diagnostics: None }
      } else {
        Rejected {
          diagnostics: diagnostics_singleton(
            d: Diagnostic {
              reason: ^cpp_add_emit_source_mismatch,
              at: node_locus(node: cpp_add_emitted_root),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn cpp_add_compile_inferred_claim_outcome() -> Outcome<Node> {
  match cpp_add_compile_inferred_receipt {
    Accepted { value: compile_result, diagnostics: d } =>
      match compile_result {
        TranslateResult { source } =>
          if (source.carried == cpp_source_text) && (d == None) {
            Accepted { value: cpp_add_emitted_root, diagnostics: None }
          } else {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: Diagnostic {
                  reason: ^cpp_add_compile_source_mismatch,
                  at: node_locus(node: cpp_add_emitted_root),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }
              )
            }
          }
        _ =>
          Rejected {
            diagnostics: diagnostics_singleton(
              d: Diagnostic {
                reason: ^cpp_add_compile_source_mismatch,
                at: node_locus(node: cpp_add_emitted_root),
                correction: Unavailable { reason: ExternalContractUnknown }
              }
            )
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

data claim_cpp_add_emit_add_fn_accepts: TestClaim = CompilesClaim {
  label: "manual/rust_add_emit: anchor_cpp_add_emit_accepts with canonical cpp_add add-fn source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: cpp_add_emitted_root,
  expected_value: cpp_add_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_cpp_add_compile_inferred_add_fn_accepts: TestClaim = CompilesClaim {
  label: "manual/rust_add_emit: compile_inferred emits canonical cpp_add add-fn source through grammar inverse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: cpp_add_emitted_root,
  expected_value: cpp_add_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data subject_cpp_add_emit_add_fn_accepts: TestClaimEvalSubject<Node> = TestClaimEvalSubject {
  claim: claim_cpp_add_emit_add_fn_accepts,
  context: infer_receipt_context(),
  tree: cpp_add_inferred_tree,
  input: test_claim_typed_input_node(
    evaluator_input: cpp_add_emitted_root,
    evaluator_pin: ^infer_receipt_input_infer_add
  )
}

data run_cpp_add_emit_add_fn_accepts: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(subject: subject_cpp_add_emit_add_fn_accepts),
  verdict: run_test_claim_assert(
    claim: claim_cpp_add_emit_add_fn_accepts,
    actual: cpp_add_emit_claim_outcome(),
    at: cpp_add_emitted_root
  )
}

data subject_cpp_add_compile_inferred_add_fn_accepts: TestClaimEvalSubject<Node> = TestClaimEvalSubject {
  claim: claim_cpp_add_compile_inferred_add_fn_accepts,
  context: infer_receipt_context(),
  tree: cpp_add_inferred_tree,
  input: test_claim_typed_input_node(
    evaluator_input: cpp_add_emitted_root,
    evaluator_pin: ^infer_receipt_input_infer_add
  )
}

data run_cpp_add_compile_inferred_add_fn_accepts: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(subject: subject_cpp_add_compile_inferred_add_fn_accepts),
  verdict: run_test_claim_assert(
    claim: claim_cpp_add_compile_inferred_add_fn_accepts,
    actual: cpp_add_compile_inferred_claim_outcome(),
    at: cpp_add_emitted_root
  )
}

data claim_cpp_add_serialize_rejects_missing_translation_rules: TestClaim = DiagnosticClaim {
  label: "manual/rust_add_emit: target_serialize_source_from_model rejects cpp bundle missing translation_rules",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: cpp_add_emitted_root,
  expected_rejection: diagnostics_singleton(
    d: Diagnostic {
      reason: ^translate_target_bundle_malformed,
      at: node_locus(node: cpp_add_empty_translation_rules_bundle),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  ),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data subject_cpp_add_serialize_rejects_missing_translation_rules: TestClaimEvalSubject<Node> = TestClaimEvalSubject {
  claim: claim_cpp_add_serialize_rejects_missing_translation_rules,
  context: infer_receipt_context(),
  tree: cpp_add_inferred_tree,
  input: test_claim_typed_input_node(
    evaluator_input: cpp_add_emitted_root,
    evaluator_pin: ^infer_receipt_input_infer_add
  )
}

data run_cpp_add_serialize_rejects_missing_translation_rules: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(subject: subject_cpp_add_serialize_rejects_missing_translation_rules),
  verdict: run_test_claim_assert(
    claim: claim_cpp_add_serialize_rejects_missing_translation_rules,
    actual: cpp_add_serialize_reject_claim_outcome(),
    at: cpp_add_emitted_root
  )
}
