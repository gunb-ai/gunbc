module v2.test.manual.cpp_add_emit_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data cpp_add_forbidden_authority_source_text: String = "authority_source_text_fallback_forbidden"

data cpp_add_target_profile: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^cpp_add_target_profile_atom } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data cpp_add_int_primitive_facts: v2.extdeps.languages.cpp.CppIntegerPrimitiveFacts = cpp_signed_integer_facts(
  spelling: Int,
  surface_spelling: ^cpp_surface_spelling_int,
  target_profile: cpp_target_profile
)

data cpp_add_int_inhabitant: Node = cpp_int_inhabitant_node(target_profile: cpp_target_profile)

data cpp_add_emitted_root: Node = cpp_emitted_add_fn_node(target_profile: cpp_target_profile)

data cpp_add_int_facts_node: Node = cpp_integer_facts_node(facts: cpp_add_int_primitive_facts)

data cpp_add_int_scalar_node: Node = cpp_integer_scalar_fact_node(facts: cpp_add_int_primitive_facts)

data cpp_add_int_width_node: Node = cpp_add_int_primitive_facts.width_fact

data cpp_add_int_spelling_node: Node = cpp_signed_integer_spelling_node(spelling: Int)

data cpp_add_target_model: v2.std.compilers.target_model.TargetModel = cpp_target_model()

data cpp_add_poisoned_authority_target_model: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: cpp_target_model_node(target_profile: cpp_target_profile),
  lex: cpp_lex(),
  binding_spellings: cpp_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: cpp_add_forbidden_authority_source_text,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

data cpp_add_empty_translation_rules_bundle: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data cpp_add_missing_translation_rules_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: cpp_add_empty_translation_rules_bundle,
  lex: cpp_lex(),
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_cpp_add_serialize_rejects_missing_translation_rules() -> v2.std.diagnostic.Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: cpp_add_missing_translation_rules_target,
    emitted: cpp_add_emitted_root
  )
}

data cpp_add_serialize_reject_receipt: v2.std.diagnostic.Outcome<Medium<String>> = anchor_cpp_add_serialize_rejects_missing_translation_rules()

test fn cpp_add_serialize_reject_receipt_holds() -> Bool {
  match cpp_add_serialize_reject_receipt {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d != v2.std.diagnostic.None
  }
}


fn cpp_add_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn cpp_add_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == cpp_add_emitted_root {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == cpp_add_int_inhabitant {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_facts_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_inhabitant_int) {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_inhabitant
      )
    }
  } else if node == cpp_add_int_facts_node {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == cpp_atom(id: ^cpp_surface_spelling_int) {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_facts_node
      )
    }
  } else if node == cpp_add_int_scalar_node {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_facts_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_tag_signed_integer) {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_scalar_node
      )
    }
  } else if node == cpp_add_int_width_node {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_scalar_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_tag_width_selection) {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_width_node
      )
    }
  } else if node == cpp_add_int_spelling_node {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_width_node
      )
    }
  } else if node == cpp_target_profile {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_width_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_tag_twos_complement) {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_scalar_node
      )
    }
  } else if node == cpp_atom(id: ^cpp_tag_representable_result_required) {
    v2.std.witness.Holds {
      value: cpp_add_canonical_grounding(
        node: node,
        algebra: cpp_add_int_scalar_node
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^cpp_add_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn cpp_add_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match cpp_add_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn cpp_add_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  cpp_add_inferred_facts_for(node: key)
}

data cpp_add_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: cpp_add_emitted_root,
  facts: std.types.Map {
    lookup: cpp_add_facts_lookup
  }
}

fn anchor_cpp_add_emit_accepts() -> v2.std.diagnostic.Outcome<Medium<String>> {
  emit(tree: cpp_add_inferred_tree, target: cpp_add_target_model)
}

fn anchor_cpp_add_compile_inferred_accepts() -> v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> {
  compile_inferred(
    inferred: cpp_add_inferred_tree,
    mode: v2.compiler.compile.TranslateTo { target: cpp_add_poisoned_authority_target_model }
  )
}

data cpp_add_emit_receipt: v2.std.diagnostic.Outcome<Medium<String>> = anchor_cpp_add_emit_accepts()

test fn cpp_add_emit_receipt_holds() -> Bool {
  match cpp_add_emit_receipt {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}

data cpp_add_compile_inferred_receipt: v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> = anchor_cpp_add_compile_inferred_accepts()

test fn cpp_add_compile_inferred_receipt_holds() -> Bool {
  match cpp_add_compile_inferred_receipt {
    Accepted { value: _, diagnostics: d } => d == v2.std.diagnostic.None
    Rejected { diagnostics: _ } => false
  }
}





