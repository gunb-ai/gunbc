module v2.test.manual.refinement_ordered_iteration

import v2.std.refinement {
  IterationClassifier,
  IterationOrdering,
  StructurallyOrdered,
  StructurallyUnordered,
  refine_ordered_iteration,
}
import v2.std.algebra { Empty }
import v2.std.collection { List }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  Locus,
  Outcome,
  Rejected,
  Textual,
  WholeFile,
}
import v2.std.node { Node, Symbol }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor,
}
import v2.test.manual.connective_anchors {
  stub_empty_conj,
  stub_empty_disj,
}
fn ordered_classifier_for_list_int() -> IterationClassifier<List<Int>> {
  IterationClassifier { classify: fn(_) { StructurallyOrdered } }
}

fn unordered_classifier_for_list_int() -> IterationClassifier<List<Int>> {
  IterationClassifier { classify: fn(_) { StructurallyUnordered } }
}

fn test_locus() -> Locus {
  Textual { file: ^refinement_ordered_iteration_test_file, extent: WholeFile }
}

fn witness_ordered_classifier_accepts() -> Bool {
  match refine_ordered_iteration(
    base: Empty,
    by: ordered_classifier_for_list_int(),
    at: test_locus()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn claim_ordered_classifier_accepts_input(ok: Bool) -> Node {
  if ok { stub_empty_conj } else { stub_empty_disj }
}

data claim_refine_ordered_iteration_accepts_on_ordered_classifier: TestClaim = EqualsClaim {
  label: "manual/refinement: refine_ordered_iteration accepts when the classifier reports StructurallyOrdered",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim_ordered_classifier_accepts_input(ok: witness_ordered_classifier_accepts()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit },
}

fn witness_unordered_classifier_rejects_with_naming_the_leak() -> Bool {
  match refine_ordered_iteration(
    base: Empty,
    by: unordered_classifier_for_list_int(),
    at: test_locus()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: diags } => diags.head.reason == ^naming_the_leak
  }
}

fn claim_unordered_classifier_rejects_input(ok: Bool) -> Node {
  if ok { stub_empty_conj } else { stub_empty_disj }
}

data claim_refine_ordered_iteration_rejects_unordered_with_naming_the_leak: TestClaim = EqualsClaim {
  label: "manual/refinement: refine_ordered_iteration rejects with naming_the_leak when the classifier reports StructurallyUnordered",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim_unordered_classifier_rejects_input(ok: witness_unordered_classifier_rejects_with_naming_the_leak()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit },
}
