module v2.test.manual.branch_lazy_arm_eval_acceptance


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn lazy_arm_atom(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn lazy_arm_byte() -> v2.std.machine.Byte {
  v2.std.machine.Byte { bits: [true] }
}

fn lazy_arm_bool_type() -> Node {
  lazy_arm_atom(s: ^lazy_arm_bool_type_sym)
}

fn lazy_arm_i64() -> Node {
  lazy_arm_atom(s: ^lazy_arm_i64_sym)
}

fn lazy_arm_bool_value(is_true: Bool) -> v2.std.runtime.RuntimeValue {
  if is_true {
    v2.std.runtime.RuntimePrimitive {
      value: v2.std.runtime.RuntimePrimitiveValue {
        primitive_type: lazy_arm_bool_type(),
        bytes: [lazy_arm_byte()]
      }
    }
  } else {
    v2.std.runtime.RuntimePrimitive {
      value: v2.std.runtime.RuntimePrimitiveValue {
        primitive_type: lazy_arm_bool_type(),
        bytes: Empty
      }
    }
  }
}

fn lazy_arm_one_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: lazy_arm_i64(),
      bytes: [lazy_arm_byte()]
    }
  }
}

fn lazy_arm_two_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: lazy_arm_i64(),
      bytes: [lazy_arm_byte(), lazy_arm_byte()]
    }
  }
}

fn lazy_arm_kw_true() -> Node {
  lazy_arm_atom(s: ^dag_token_kw_true)
}

fn lazy_arm_kw_false() -> Node {
  lazy_arm_atom(s: ^dag_token_kw_false)
}

fn lazy_arm_int_literal_from_lexeme(lexeme: String) -> Node {
  match dag_int_literal_node_from_lexeme(lexeme: lexeme, occurrence_id: SyntheticOccurrence) {
    Accepted { value: n, diagnostics: _ } => n
    Rejected { diagnostics: _ } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^lazy_arm_lit_lexeme_invalid } },
        occurrence_id: SyntheticOccurrence,
        children: []
      }
  }
}

fn lazy_arm_lit_one() -> Node {
  lazy_arm_int_literal_from_lexeme(lexeme: "1")
}

data lazy_arm_divergent_value_node: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Value },
  occurrence_id: SyntheticOccurrence,
  children: []
}

data lazy_arm_counted_value_node: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Value },
  occurrence_id: SyntheticOccurrence,
  children: []
}

fn lazy_arm_divergent() -> Node {
  lazy_arm_divergent_value_node
}

fn lazy_arm_counted() -> Node {
  lazy_arm_counted_value_node
}

fn lazy_arm_counted_slot_key() -> v2.std.runtime.EnvironmentBindingKey {
  v2.std.runtime.EnvironmentBindingKey {
    identity: ^lazy_arm_counted_slot_sym
  }
}

fn lazy_arm_touch_key() -> v2.std.runtime.EnvironmentBindingKey {
  v2.std.runtime.EnvironmentBindingKey {
    identity: ^lazy_arm_touch_counter_sym
  }
}

fn lazy_arm_binding_keys_equal(
  a: v2.std.runtime.EnvironmentBindingKey,
  b: v2.std.runtime.EnvironmentBindingKey
) -> Bool {
  a.identity == b.identity
}

fn lazy_arm_int_from_runtime(value: v2.std.runtime.RuntimeValue) -> Int {
  match value {
    RuntimePrimitive { value: p } => count(p.bytes)
    _ => 0
  }
}

fn lazy_arm_touch_from_env(env: v2.std.runtime.EvaluationEnvironment) -> Int {
  match v2.std.collection.map_get(m: env.bindings, key: lazy_arm_touch_key()) {
    Accepted { value: opt, diagnostics: _ } =>
      match opt {
        Present { value: v } => lazy_arm_int_from_runtime(value: v)
        Absent => 0
      }
    Rejected { diagnostics: _ } => 0
  }
}

fn lazy_arm_int_bytes(n: Int) -> v2.std.runtime.RuntimeValue {
  if n == 0 {
    v2.std.runtime.RuntimePrimitive {
      value: v2.std.runtime.RuntimePrimitiveValue {
        primitive_type: lazy_arm_i64(),
        bytes: Empty
      }
    }
  } else if n == 1 {
    lazy_arm_one_value()
  } else if n == 2 {
    lazy_arm_two_value()
  } else {
    lazy_arm_one_value()
  }
}

fn lazy_arm_diagnostic(n: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^lazy_arm_runtime_rejected,
    at: node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn lazy_arm_allocate_literal(node: Node, env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.RuntimeValue> {
  if dag_node_is_int_literal_atom(node: node) {
    match dag_int_literal_magnitude_int_from_node(node: node) {
      Accepted { value: mag, diagnostics: _ } =>
        if mag == 1 {
          outcome_accepted(value: lazy_arm_one_value())
        } else if mag == 2 {
          outcome_accepted(value: lazy_arm_two_value())
        } else {
          outcome_rejected(d: lazy_arm_diagnostic(n: node))
        }
      Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    }
  } else {
    match node.kind {
      TypeNode { connective: Atom { identity: id } } =>
        if id == ^dag_token_kw_true {
          outcome_accepted(value: lazy_arm_bool_value(is_true: true))
        } else if id == ^dag_token_kw_false {
          outcome_accepted(value: lazy_arm_bool_value(is_true: false))
        } else {
          outcome_rejected(d: lazy_arm_diagnostic(n: node))
        }
      ComputationNode { behavior: Value } =>
        if node == lazy_arm_counted_value_node {
          if lazy_arm_touch_from_env(env: env) >= 1 {
            outcome_rejected(d: lazy_arm_diagnostic(n: node))
          } else {
            outcome_accepted(value: lazy_arm_one_value())
          }
        } else if node == lazy_arm_divergent_value_node {
          outcome_rejected(d: lazy_arm_diagnostic(n: node))
        } else {
          outcome_rejected(d: lazy_arm_diagnostic(n: node))
        }
      _ => outcome_rejected(d: lazy_arm_diagnostic(n: node))
    }
  }
}

fn lazy_arm_runtime_bool_true(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == lazy_arm_bool_type()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn lazy_arm_runtime_bool_false(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == lazy_arm_bool_type()) && (count(p.bytes) == 0)
    _ => false
  }
}

fn lazy_arm_nth_child_target(node: Node, wanted: Int) -> Outcome<Node> {
  match list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        Edge { label: _, target: arm } => outcome_accepted(value: arm)
      }
    Absent => outcome_rejected(d: lazy_arm_diagnostic(n: node))
  }
}

fn lazy_arm_choose_branch(
  node: Node,
  condition: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<Node> {
  if count(node.children) == 3 {
    if lazy_arm_runtime_bool_true(value: condition) {
      lazy_arm_nth_child_target(node: node, wanted: 1)
    } else if lazy_arm_runtime_bool_false(value: condition) {
      lazy_arm_nth_child_target(node: node, wanted: 2)
    } else {
      outcome_rejected(d: lazy_arm_diagnostic(n: node))
    }
  } else {
    outcome_rejected(d: lazy_arm_diagnostic(n: node))
  }
}

fn lazy_arm_call_primitive(
  _node: Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<v2.std.runtime.RuntimeValue> {
  outcome_rejected(d: lazy_arm_diagnostic(n: _node))
}

fn lazy_arm_step_loop(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.ControlTransfer> {
  outcome_rejected(d: lazy_arm_diagnostic(n: node))
}

fn lazy_arm_bind_value(
  key: v2.std.runtime.EnvironmentBindingKey,
  value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<v2.std.runtime.EvaluationEnvironment> {
  let bound = v2.std.runtime.EvaluationEnvironment {
    bindings: map_insert(m: env.bindings, key: key, value: value)
  }
  let touched = if lazy_arm_binding_keys_equal(
    a: key,
    b: lazy_arm_counted_slot_key()
  ) {
    let next = lazy_arm_touch_from_env(env: bound) + 1
    v2.std.runtime.EvaluationEnvironment {
      bindings: map_insert(
        m: bound.bindings,
        key: lazy_arm_touch_key(),
        value: lazy_arm_int_bytes(n: next)
      )
    }
  } else {
    bound
  }
  v2.std.diagnostic.Accepted {
    value: touched,
    diagnostics: None
  }
}

fn lazy_arm_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: lazy_arm_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: lazy_arm_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: lazy_arm_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: lazy_arm_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: lazy_arm_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn lazy_arm_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^lazy_arm_allocate_literal_sym,
    call_primitive: ^lazy_arm_call_primitive_sym,
    choose_branch: ^lazy_arm_choose_branch_sym,
    step_loop: ^lazy_arm_step_loop_sym,
    bind_value: ^lazy_arm_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn lazy_arm_context() -> v2.compiler.eval.EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^lazy_arm_runtime_id,
    interpretation: lazy_arm_interpretation(),
    structure_witness: lazy_arm_interpretation_structure_witness()
  )
}

fn lazy_arm_bind_node(
  key_decl: Node,
  value: Node,
  body: Node
) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Bind },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: key_decl },
      v2.std.node.Edge { label: Positional, target: value },
      v2.std.node.Edge { label: Positional, target: body }
    ]
  }
}

fn lazy_arm_counted_bind_arm() -> Node {
  lazy_arm_bind_node(
    key_decl: lazy_arm_atom(s: ^lazy_arm_counted_slot_sym),
    value: lazy_arm_counted(),
    body: lazy_arm_lit_one()
  )
}

fn lazy_arm_branch_body(
  condition: Node,
  then_arm: Node,
  else_arm: Node
) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Branch },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: condition },
      v2.std.node.Edge { label: Positional, target: then_arm },
      v2.std.node.Edge { label: Positional, target: else_arm }
    ]
  }
}

fn lazy_arm_pick_call(callee: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [v2.std.node.Edge { label: Positional, target: callee }]
  }
}

fn lazy_arm_arrow_with_body(body: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: Conj },
          occurrence_id: SyntheticOccurrence,
          children: []
        }
      },
      v2.std.node.Edge { label: Positional, target: lazy_arm_i64() },
      v2.std.node.Edge { label: Positional, target: lazy_arm_i64() },
      v2.std.node.Edge { label: Named { name: ^arrow_body_edge }, target: body }
    ]
  }
}

fn lazy_arm_tree_root(call: Node, expected: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Named { name: ^lazy_arm_actual }, target: call },
      v2.std.node.Edge { label: Named { name: ^lazy_arm_expected }, target: expected }
    ]
  }
}

fn lazy_arm_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_present(value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: lazy_arm_i64(),
      descent: termination_proof_witness_for_node(n: key)
    ))
}

fn lazy_arm_admitted_tree(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: lazy_arm_facts_lookup }
  }
}

fn lazy_arm_run_branch(
  body: Node,
  expected: Node
) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  let arrow = lazy_arm_arrow_with_body(body: body)
  let call = lazy_arm_pick_call(callee: arrow)
  let root = lazy_arm_tree_root(call: call, expected: expected)
  let tree = lazy_arm_admitted_tree(root: root)
  outcome_accepted(
    value: run_test_claim(
      subject: v2.compiler.eval.TestClaimEvalSubject {
        claim: v2.std.verification.CompilesClaim {
          label: "manual/branch_lazy_arm: demand-driven Branch eval acceptance",
          anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
          input: call,
          expected_value: expected,
          classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
        },
        context: lazy_arm_context(),
        tree: tree,
        input: test_claim_typed_input_node(
          evaluator_input: call,
          evaluator_pin: ^lazy_arm_pick_call_pin
        )
      }
    )
  )
}

fn lazy_arm_run_passes(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn lazy_arm_true_then_counted_else_divergent_holds() -> Bool {
  lazy_arm_run_passes(
    run: lazy_arm_run_branch(
      body: lazy_arm_branch_body(
        condition: lazy_arm_kw_true(),
        then_arm: lazy_arm_counted_bind_arm(),
        else_arm: lazy_arm_divergent()
      ),
      expected: lazy_arm_lit_one()
    )
  )
}

test fn lazy_arm_false_then_divergent_else_counted_holds() -> Bool {
  lazy_arm_run_passes(
    run: lazy_arm_run_branch(
      body: lazy_arm_branch_body(
        condition: lazy_arm_kw_false(),
        then_arm: lazy_arm_divergent(),
        else_arm: lazy_arm_counted_bind_arm()
      ),
      expected: lazy_arm_lit_one()
    )
  )
}

test fn lazy_arm_counted_literal_rejects_second_touch_holds() -> Bool {
  let env = empty_evaluation_environment()
  match lazy_arm_allocate_literal(node: lazy_arm_counted(), env: env) {
    Accepted { value: v, diagnostics: _ } =>
      match lazy_arm_bind_value(key: lazy_arm_counted_slot_key(), value: v, env: env) {
        Accepted { value: touched, diagnostics: _ } =>
          match lazy_arm_allocate_literal(node: lazy_arm_counted(), env: touched) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

