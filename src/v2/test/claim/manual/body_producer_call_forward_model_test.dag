module v2.test.manual.body_producer_call_forward_model

import v2.compiler.body_producer_forward {
  CallApplyOnExistingPrimaryAndPostfixProductions,
  body_producer_call_consumers,
  body_producer_call_forward_standing,
  body_producer_call_interim_constructor,
  body_producer_call_producers,
  body_producer_call_resolve_consumer,
  body_producer_call_surface_primary,
  body_producer_call_surfaces,
  body_producer_forward_row_count
}
import std.decl_ref { DeclarationRef }
import v2.std.logic { Bool }

fn body_producer_call_refs_contain(xs: List<DeclarationRef>, target: DeclarationRef) -> Bool {
  fold(xs, init: false, f: fn(acc, row) { acc || (row == target) })
}

test fn body_producer_call_forward_standing_is_existing_productions() -> Bool {
  match body_producer_call_forward_standing {
    CallApplyOnExistingPrimaryAndPostfixProductions => true
  }
}

test fn body_producer_call_producers_include_transform_call_constructor() -> Bool {
  body_producer_call_refs_contain(
    xs: body_producer_call_producers(),
    target: body_producer_call_interim_constructor
  )
}

test fn body_producer_call_consumers_include_resolve_transform_children() -> Bool {
  body_producer_call_refs_contain(
    xs: body_producer_call_consumers(),
    target: body_producer_call_resolve_consumer
  )
}

test fn body_producer_call_surfaces_include_primary_ident_suffix() -> Bool {
  fold(body_producer_call_surfaces(), init: false, f: fn(acc, s) {
    acc || (s == body_producer_call_surface_primary)
  })
}

test fn body_producer_forward_behavior_row_count_unchanged_in_phase_1() -> Bool {
  body_producer_forward_row_count() == 7
}
