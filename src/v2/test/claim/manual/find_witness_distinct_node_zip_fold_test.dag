module v2.test.manual.find_witness_distinct_node_zip_fold


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
fn distinct_source_leaf() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^distinct_zip_source_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_target_leaf() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^distinct_zip_source_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_wrong_leaf() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^distinct_zip_wrong_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_source_add_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: distinct_source_leaf() },
      v2.std.node.Edge { label: Positional, target: distinct_source_leaf() },
      v2.std.node.Edge { label: Positional, target: distinct_source_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_target_add_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: distinct_target_leaf() },
      v2.std.node.Edge { label: Positional, target: distinct_target_leaf() },
      v2.std.node.Edge { label: Positional, target: distinct_target_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_wrong_arity_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: distinct_wrong_leaf() },
      v2.std.node.Edge { label: Positional, target: distinct_wrong_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_wrong_subtree_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: distinct_wrong_arity_node() },
      v2.std.node.Edge { label: Positional, target: distinct_target_leaf() },
      v2.std.node.Edge { label: Positional, target: distinct_target_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_source_nested_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: distinct_source_add_node() },
      v2.std.node.Edge { label: Positional, target: distinct_source_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_target_nested_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: distinct_target_add_node() },
      v2.std.node.Edge { label: Positional, target: distinct_target_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_closedness() -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^distinct_zip_closed_candidates,
    evidence: distinct_target_add_node()
  }
}
fn distinct_exact_predicate() -> v2.std.find_witness.PreservationPredicate {
  v2.std.find_witness.PreservationPredicate {
    algebra: distinct_source_add_node(),
    preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
  }
}
fn distinct_candidate_set() -> v2.std.find_witness.CandidateSet {
  v2.std.find_witness.CandidateSet {
    candidates: [distinct_target_add_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_wrong_arity_candidate_set() -> v2.std.find_witness.CandidateSet {
  v2.std.find_witness.CandidateSet {
    candidates: [distinct_wrong_arity_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_wrong_subtree_candidate_set() -> v2.std.find_witness.CandidateSet {
  v2.std.find_witness.CandidateSet {
    candidates: [distinct_wrong_subtree_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_nested_predicate() -> v2.std.find_witness.PreservationPredicate {
  v2.std.find_witness.PreservationPredicate {
    algebra: distinct_source_nested_node(),
    preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
  }
}
fn distinct_nested_candidate_set() -> v2.std.find_witness.CandidateSet {
  v2.std.find_witness.CandidateSet {
    candidates: [distinct_target_nested_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_valid_witness() -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^preservation_rule_exact_structural_equality_zip_fold,
    evidence: distinct_target_add_node()
  }
}
fn rejected_for_no_candidate(o: v2.std.diagnostic.Outcome<v2.std.find_witness.FindWitnessResult>) -> Bool {
  match o {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: r } => r.head.reason == ^find_witness_reason_no_candidate
  }
}
fn quality_is_exact(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => false
    Widened => false
  }
}
fn quality_is_identity(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    Identity => true
    Exact => false
    Widened => false
  }
}
test data witness_find_witness_distinct_node_accepts: Bool = match find_witness(
  source_facts: distinct_source_add_node(),
  candidates: distinct_candidate_set(),
  predicate: distinct_exact_predicate(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == distinct_target_add_node()
  v2.std.diagnostic.Rejected { diagnostics: _ } => false
}
test data witness_verify_witness_distinct_node_accepts: Bool = match verify_witness(
  source_facts: distinct_source_add_node(),
  candidate: distinct_target_add_node(),
  predicate: distinct_exact_predicate(),
  witness: distinct_valid_witness()
) {
  v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
  v2.std.diagnostic.Rejected { diagnostics: _ } => false
}
test data witness_find_witness_wrong_arity_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: distinct_source_add_node(),
    candidates: distinct_wrong_arity_candidate_set(),
    predicate: distinct_exact_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_wrong_subtree_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: distinct_source_add_node(),
    candidates: distinct_wrong_subtree_candidate_set(),
    predicate: distinct_exact_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_nested_distinct_node_accepts: Bool = match find_witness(
  source_facts: distinct_source_nested_node(),
  candidates: distinct_nested_candidate_set(),
  predicate: distinct_nested_predicate(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == distinct_target_nested_node()
  v2.std.diagnostic.Rejected { diagnostics: _ } => false
}
fn distinct_grounding() -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: distinct_source_add_node(),
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: distinct_valid_witness(),
      closedness: distinct_closedness()
    }
  }
}
fn distinct_coercion_candidates() -> v2.std.coercion.CoercionCandidateSet {
  v2.std.coercion.CoercionCandidateSet { set: distinct_candidate_set() }
}
test data witness_coercion_fold_distinct_node_accepts: Bool = match coercion_fold(
  source: distinct_grounding(),
  candidates: distinct_coercion_candidates(),
  policy: v2.std.find_witness.TargetDeclaredPriority { priority: distinct_target_add_node() }
) {
  Accepted { value: r, diagnostics: _ } =>
    (r.target == distinct_target_add_node()) && (quality_is_exact(q: r.quality) || quality_is_identity(q: r.quality))
  v2.std.diagnostic.Rejected { diagnostics: _ } => false
}
