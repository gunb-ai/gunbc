module v2.test.manual.find_witness_distinct_node_zip_fold

import v2.std.coercion {
  CoercionCandidateSet,
  Exact,
  Identity,
  CoercionQuality,
  coercion_fold
}
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected
}
import v2.std.find_witness {
  CandidateSet,
  FindWitnessResult,
  PreservationPredicate,
  TargetDeclaredPriority,
  UniqueOnly,
  find_witness,
  verify_witness
}
import v2.std.node {
  Atom,
  Arrow,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { StructuralPropertyWitness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
fn distinct_source_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^distinct_zip_source_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_target_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^distinct_zip_source_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_wrong_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^distinct_zip_wrong_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_source_add_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_source_leaf() },
      Edge { label: Positional, target: distinct_source_leaf() },
      Edge { label: Positional, target: distinct_source_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_target_add_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_target_leaf() },
      Edge { label: Positional, target: distinct_target_leaf() },
      Edge { label: Positional, target: distinct_target_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_wrong_arity_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_wrong_leaf() },
      Edge { label: Positional, target: distinct_wrong_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_wrong_subtree_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_wrong_arity_node() },
      Edge { label: Positional, target: distinct_target_leaf() },
      Edge { label: Positional, target: distinct_target_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_source_nested_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_source_add_node() },
      Edge { label: Positional, target: distinct_source_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_target_nested_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_target_add_node() },
      Edge { label: Positional, target: distinct_target_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn distinct_closedness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: ^distinct_zip_closed_candidates,
    evidence: distinct_target_add_node()
  }
}
fn distinct_exact_predicate() -> PreservationPredicate {
  PreservationPredicate {
    algebra: distinct_source_add_node(),
    preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
  }
}
fn distinct_candidate_set() -> CandidateSet {
  CandidateSet {
    candidates: [distinct_target_add_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_wrong_arity_candidate_set() -> CandidateSet {
  CandidateSet {
    candidates: [distinct_wrong_arity_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_wrong_subtree_candidate_set() -> CandidateSet {
  CandidateSet {
    candidates: [distinct_wrong_subtree_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_nested_predicate() -> PreservationPredicate {
  PreservationPredicate {
    algebra: distinct_source_nested_node(),
    preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
  }
}
fn distinct_nested_candidate_set() -> CandidateSet {
  CandidateSet {
    candidates: [distinct_target_nested_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_valid_witness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: ^preservation_rule_exact_structural_equality_zip_fold,
    evidence: distinct_target_add_node()
  }
}
fn rejected_for_no_candidate(o: Outcome<FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == ^find_witness_reason_no_candidate
  }
}
fn quality_is_exact(q: CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => false
    Widened => false
  }
}
fn quality_is_identity(q: CoercionQuality) -> Bool {
  match q {
    Identity => true
    Exact => false
    Widened => false
  }
}
test data witness_find_witness_distinct_node_accepts: Bool = match find_witness(
  source_facts: distinct_source_add_node(),
  candidates: distinct_candidate_set(),
  predicate: distinct_exact_predicate(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == distinct_target_add_node()
  Rejected { diagnostics: _ } => false
}
test data witness_verify_witness_distinct_node_accepts: Bool = match verify_witness(
  source_facts: distinct_source_add_node(),
  candidate: distinct_target_add_node(),
  predicate: distinct_exact_predicate(),
  witness: distinct_valid_witness()
) {
  Accepted { value: _, diagnostics: _ } => true
  Rejected { diagnostics: _ } => false
}
test data witness_find_witness_wrong_arity_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: distinct_source_add_node(),
    candidates: distinct_wrong_arity_candidate_set(),
    predicate: distinct_exact_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_wrong_subtree_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: distinct_source_add_node(),
    candidates: distinct_wrong_subtree_candidate_set(),
    predicate: distinct_exact_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
test data witness_find_witness_nested_distinct_node_accepts: Bool = match find_witness(
  source_facts: distinct_source_nested_node(),
  candidates: distinct_nested_candidate_set(),
  predicate: distinct_nested_predicate(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == distinct_target_nested_node()
  Rejected { diagnostics: _ } => false
}
fn distinct_grounding() -> CanonicalGrounding {
  CanonicalGrounding {
    node: distinct_source_add_node(),
    witness: CanonicalGroundingWitness {
      structural: distinct_valid_witness(),
      closedness: distinct_closedness()
    }
  }
}
fn distinct_coercion_candidates() -> CoercionCandidateSet {
  CoercionCandidateSet { set: distinct_candidate_set() }
}
test data witness_coercion_fold_distinct_node_accepts: Bool = match coercion_fold(
  source: distinct_grounding(),
  candidates: distinct_coercion_candidates(),
  policy: TargetDeclaredPriority { priority: distinct_target_add_node() }
) {
  Accepted { value: r, diagnostics: _ } =>
    (r.target == distinct_target_add_node()) && (quality_is_exact(q: r.quality) || quality_is_identity(q: r.quality))
  Rejected { diagnostics: _ } => false
}
fn distinct_witness_claim_input(ok: Bool) -> Node {
  if ok {
    distinct_source_add_node()
  } else {
    distinct_fail_node()
  }
}
fn distinct_witness_expected() -> Node {
  distinct_source_add_node()
}
data claim_find_witness_distinct_node_zip_fold_compiles: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_zip_fold: distinct-node anchors compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: distinct_source_add_node(),
  expected_value: distinct_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_distinct_node_accepts: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_zip_fold: distinct-node candidate accepts",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: distinct_witness_claim_input(ok: witness_find_witness_distinct_node_accepts),
  expected_value: distinct_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_verify_witness_distinct_node_accepts: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_zip_fold: distinct-node witness verifies",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: distinct_witness_claim_input(ok: witness_verify_witness_distinct_node_accepts),
  expected_value: distinct_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_wrong_arity_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_zip_fold: wrong arity rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: distinct_witness_claim_input(ok: witness_find_witness_wrong_arity_rejects),
  expected_value: distinct_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_wrong_subtree_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_zip_fold: same root arity wrong subtree rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: distinct_witness_claim_input(ok: witness_find_witness_wrong_subtree_rejects),
  expected_value: distinct_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_nested_distinct_node_accepts: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_zip_fold: nested distinct-node candidate accepts",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: distinct_witness_claim_input(ok: witness_find_witness_nested_distinct_node_accepts),
  expected_value: distinct_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_coercion_fold_distinct_node_accepts: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_zip_fold: coercion_fold returns Exact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: distinct_witness_claim_input(ok: witness_coercion_fold_distinct_node_accepts),
  expected_value: distinct_witness_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
