module v2.test.claim.manual.constructor_tag_route_probe_red

// v2-side twin of dag/test/claim/constructor_tag_route_probe_red.dag. Same frontier, same
// polarity-red status: runs, returns false, is not a regression control.

import std.primitives { tag_of, same_arm }

type Pa = P1 { a: Int } | P2
type Pb = Q1 { a: Int } | Q2

test fn same_arm_one_t_two_coproducts_must_refuse() -> Bool {
  same_arm(tag: tag_of(v: P1 { a: 1 }), v: Q1 { a: 1 })
}
