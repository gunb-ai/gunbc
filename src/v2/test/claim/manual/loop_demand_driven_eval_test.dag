module v2.test.manual.loop_demand_driven_eval

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn loop_eval_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn loop_eval_byte() -> std.bit.Byte {
  std.bit.Byte { bits: [true] }
}

fn loop_eval_i64() -> v2.std.node.Node {
  loop_eval_atom(s: ^loop_eval_i64_sym)
}

fn loop_eval_one_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: loop_eval_i64(),
      bytes: [loop_eval_byte()]
    }
  }
}

fn loop_eval_lit_one() -> v2.std.node.Node {
  match v2.extdeps.languages.dag.dag_int_literal_node_from_lexeme(lexeme: "1", occurrence_id: SyntheticOccurrence) {
    Accepted { value: n, diagnostics: _ } => n
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_eval_lit_one_lexeme_invalid } },
        occurrence_id: SyntheticOccurrence,
        children: []
      }
  }
}

data loop_eval_divergent_value_node: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Value },
  occurrence_id: SyntheticOccurrence,
  children: []
}

fn loop_eval_divergent() -> v2.std.node.Node {
  loop_eval_divergent_value_node
}

fn loop_eval_measure() -> v2.std.node.Node {
  loop_eval_lit_one()
}

fn loop_eval_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^loop_eval_runtime_rejected,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_eval_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: node) {
    match v2.extdeps.languages.dag.dag_int_literal_magnitude_int_from_node(node: node) {
      Accepted { value: mag, diagnostics: _ } =>
        if mag == 1 {
          v2.std.diagnostic.outcome_accepted(value: loop_eval_one_value())
        } else {
          v2.std.diagnostic.outcome_rejected(d: loop_eval_diagnostic(n: node))
        }
      v2.std.diagnostic.Rejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    }
  } else if node == loop_eval_divergent_value_node {
    v2.std.diagnostic.outcome_rejected(d: loop_eval_diagnostic(n: node))
  } else {
    v2.std.diagnostic.outcome_rejected(d: loop_eval_diagnostic(n: node))
  }
}

fn loop_eval_call_primitive(
  _node: v2.std.node.Node,
  _args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: loop_eval_diagnostic(n: _node))
}

fn loop_eval_choose_branch(
  _node: v2.std.node.Node,
  _condition: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(d: loop_eval_diagnostic(n: _node))
}

fn loop_eval_step_loop_continue(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_accepted(value: v2.std.runtime.Continue { value: loop_eval_one_value() })
}

fn loop_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: v2.std.diagnostic.None }
}

fn loop_eval_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: loop_eval_allocate_literal, identity: ^loop_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: loop_eval_call_primitive, identity: ^loop_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: loop_eval_choose_branch, identity: ^loop_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: loop_eval_step_loop_continue, identity: ^loop_eval_step_loop_continue },
    bind: v2.std.runtime.BindInterpreter { bind_value: loop_eval_bind_value, identity: ^loop_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: v2.std.runtime.runtime_reject_match_arm, identity: ^runtime_reject_match_arm }
  }
}

fn loop_eval_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^loop_eval_allocate_literal,
    call_primitive: ^loop_eval_call_primitive,
    choose_branch: ^loop_eval_choose_branch,
    step_loop: ^loop_eval_step_loop_continue,
    bind_value: ^loop_eval_bind_value,    choose_arm: ^runtime_reject_match_arm
  }
}

fn loop_eval_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^loop_eval_runtime_id,
    interpretation: loop_eval_interpretation(),
    structure_witness: loop_eval_interpretation_structure_witness()
  )
}

fn loop_eval_loop_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^loop_eval_measure_sym }
  }
}

fn loop_eval_node_is_loop(node: v2.std.node.Node) -> v2.std.logic.Bool {
  match node.kind {
    ComputationNode { behavior: Loop } => true
    _ => false
  }
}

fn loop_eval_bounded_descent() -> v2.std.witness.Witness<v2.std.cardinality.TerminationProof> {
  v2.std.witness.Holds { value: v2.std.cardinality.structural_node_size_termination_proof() }
}

fn loop_eval_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  if loop_eval_node_is_loop(node: key) {
    v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
        resolved: key,
        algebra: loop_eval_i64(),
        descent: v2.std.witness.Holds { value: loop_eval_loop_termination_proof() }
      ))
  } else {
    v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
        resolved: key,
        algebra: loop_eval_i64(),
        descent: loop_eval_bounded_descent()
      ))
  }
}

fn loop_eval_loop_node(body: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Loop },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: body },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_bound_edge }, target: loop_eval_measure() }
    ]
  }
}

fn loop_eval_pick_call(callee: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    occurrence_id: SyntheticOccurrence,
    children: [v2.std.node.Edge { label: Positional, target: callee }]
  }
}

fn loop_eval_arrow_with_body(body: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: Conj },
          occurrence_id: SyntheticOccurrence,
          children: []
        }
      },
      v2.std.node.Edge { label: Positional, target: loop_eval_i64() },
      v2.std.node.Edge { label: Positional, target: loop_eval_i64() },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^arrow_body_edge }, target: body }
    ]
  }
}

fn loop_eval_tree_root(call: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_eval_actual }, target: call },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_eval_expected }, target: expected }
    ]
  }
}

fn loop_eval_admitted_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map { lookup: loop_eval_facts_lookup }
  }
}

fn loop_eval_run(body: v2.std.node.Node, expected: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>> {
  let arrow = loop_eval_arrow_with_body(body: body)
  let call = loop_eval_pick_call(callee: arrow)
  let root = loop_eval_tree_root(call: call, expected: expected)
  let tree = loop_eval_admitted_tree(root: root)
  v2.std.diagnostic.outcome_accepted(
    value: v2.compiler.eval.run_test_claim(
      subject: v2.compiler.eval.TestClaimEvalSubject {
        claim: v2.std.verification.CompilesClaim {
          label: "manual/loop_demand_driven_eval: demand-driven Loop eval acceptance",
          anchor: v2.std.verification.manual_claim_anchor(anchor: ManualAnchorAbsent),
          input: call,
          expected_value: expected,
          classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
        },
        context: loop_eval_context(),
        tree: tree,
        input: v2.compiler.eval.test_claim_typed_input_node(
          evaluator_input: call,
          evaluator_pin: ^loop_eval_pick_call_pin
        )
      }
    )
  )
}

fn loop_eval_run_passes(run: v2.std.diagnostic.Outcome<v2.compiler.eval.TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue>>) -> v2.std.logic.Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match v2.compiler.eval.test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn loop_eval_divergent_body_step_loop_holds() -> v2.std.logic.Bool {
  loop_eval_run_passes(
    run: loop_eval_run(
      body: loop_eval_loop_node(body: loop_eval_divergent()),
      expected: loop_eval_lit_one()
    )
  )
}

data loop_demand_driven_eval_non_keystone_manuals_note: String = "lit_one / pick_call_direct / arrow_lit_one manuals were never on the enrolled keystone (main = divergent pole only). Umbrella-dissolution briefly folded them into the keystone and CI red them (run 30223338595). Deleted rather than if-false/Symbol-pin (review 43557). Dissolve-on: re-land as test fns only when claim_batch shows Bool(true) on CI hardware."

test fn loop_demand_driven_eval_keystone_holds() -> v2.std.logic.Bool {
  loop_eval_divergent_body_step_loop_holds()
}

