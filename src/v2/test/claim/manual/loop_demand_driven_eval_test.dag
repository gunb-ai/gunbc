module v2.test.manual.loop_demand_driven_eval

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn loop_eval_atom(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn loop_eval_byte() -> Byte {
  Byte { bits: [true] }
}

fn loop_eval_i64() -> Node {
  loop_eval_atom(s: ^loop_eval_i64_sym)
}

fn loop_eval_one_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: loop_eval_i64(),
      bytes: [loop_eval_byte()]
    }
  }
}

fn loop_eval_lit_one() -> Node {
  match dag_int_literal_node_from_lexeme(lexeme: "1", occurrence_id: SyntheticOccurrence) {
    Accepted { value: n, diagnostics: _ } => n
    Rejected { diagnostics: _ } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^loop_eval_lit_one_lexeme_invalid } },
        occurrence_id: SyntheticOccurrence,
        children: []
      }
  }
}

data loop_eval_divergent_value_node: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Value },
  occurrence_id: SyntheticOccurrence,
  children: []
}

fn loop_eval_divergent() -> Node {
  loop_eval_divergent_value_node
}

fn loop_eval_measure() -> Node {
  loop_eval_lit_one()
}

fn loop_eval_diagnostic(n: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^loop_eval_runtime_rejected,
    at: node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn loop_eval_allocate_literal(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.RuntimeValue> {
  if dag_node_is_int_literal_atom(node: node) {
    match dag_int_literal_magnitude_int_from_node(node: node) {
      Accepted { value: mag, diagnostics: _ } =>
        if mag == 1 {
          outcome_accepted(value: loop_eval_one_value())
        } else {
          outcome_rejected(d: loop_eval_diagnostic(n: node))
        }
      Rejected { diagnostics: d } => Rejected { diagnostics: d }
    }
  } else if node == loop_eval_divergent_value_node {
    outcome_rejected(d: loop_eval_diagnostic(n: node))
  } else {
    outcome_rejected(d: loop_eval_diagnostic(n: node))
  }
}

fn loop_eval_call_primitive(
  _node: Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<v2.std.runtime.RuntimeValue> {
  outcome_rejected(d: loop_eval_diagnostic(n: _node))
}

fn loop_eval_choose_branch(
  _node: Node,
  _condition: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(d: loop_eval_diagnostic(n: _node))
}

fn loop_eval_step_loop_continue(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.ControlTransfer> {
  outcome_accepted(value: Continue { value: loop_eval_one_value() })
}

fn loop_eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<v2.std.runtime.EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn loop_eval_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: loop_eval_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: loop_eval_call_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: loop_eval_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: loop_eval_step_loop_continue },
    bind: v2.std.runtime.BindInterpreter { bind_value: loop_eval_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn loop_eval_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^loop_eval_allocate_literal_sym,
    call_primitive: ^loop_eval_call_primitive_sym,
    choose_branch: ^loop_eval_choose_branch_sym,
    step_loop: ^loop_eval_step_loop_continue_sym,
    bind_value: ^loop_eval_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn loop_eval_context() -> v2.compiler.eval.EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^loop_eval_runtime_id,
    interpretation: loop_eval_interpretation(),
    structure_witness: loop_eval_interpretation_structure_witness()
  )
}

fn loop_eval_loop_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^loop_eval_measure_sym }
  }
}

fn loop_eval_node_is_loop(node: Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Loop } => true
    _ => false
  }
}

fn loop_eval_bounded_descent() -> Witness<v2.std.cardinality.TerminationProof> {
  Holds { value: structural_node_size_termination_proof() }
}

fn loop_eval_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  if loop_eval_node_is_loop(node: key) {
    optional_present(value: claim_inferred_facts_from_nodes(
        resolved: key,
        algebra: loop_eval_i64(),
        descent: Holds { value: loop_eval_loop_termination_proof() }
      ))
  } else {
    optional_present(value: claim_inferred_facts_from_nodes(
        resolved: key,
        algebra: loop_eval_i64(),
        descent: loop_eval_bounded_descent()
      ))
  }
}

fn loop_eval_loop_node(body: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Loop },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Positional, target: body },
      v2.std.node.Edge { label: Named { name: ^loop_bound_edge }, target: loop_eval_measure() }
    ]
  }
}

fn loop_eval_pick_call(callee: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [v2.std.node.Edge { label: Positional, target: callee }]
  }
}

fn loop_eval_arrow_with_body(body: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Arrow },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: Conj },
          occurrence_id: SyntheticOccurrence,
          children: []
        }
      },
      v2.std.node.Edge { label: Positional, target: loop_eval_i64() },
      v2.std.node.Edge { label: Positional, target: loop_eval_i64() },
      v2.std.node.Edge { label: Named { name: ^arrow_body_edge }, target: body }
    ]
  }
}

fn loop_eval_tree_root(call: Node, expected: Node) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: Named { name: ^loop_eval_actual }, target: call },
      v2.std.node.Edge { label: Named { name: ^loop_eval_expected }, target: expected }
    ]
  }
}

fn loop_eval_admitted_tree(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: Map { lookup: loop_eval_facts_lookup }
  }
}

fn loop_eval_run(body: Node, expected: Node) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  let arrow = loop_eval_arrow_with_body(body: body)
  let call = loop_eval_pick_call(callee: arrow)
  let root = loop_eval_tree_root(call: call, expected: expected)
  let tree = loop_eval_admitted_tree(root: root)
  outcome_accepted(
    value: run_test_claim(
      subject: v2.compiler.eval.TestClaimEvalSubject {
        claim: v2.std.verification.CompilesClaim {
          label: "manual/loop_demand_driven_eval: demand-driven Loop eval acceptance",
          anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
          input: call,
          expected_value: expected,
          classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
        },
        context: loop_eval_context(),
        tree: tree,
        input: test_claim_typed_input_node(
          evaluator_input: call,
          evaluator_pin: ^loop_eval_pick_call_pin
        )
      }
    )
  )
}

fn loop_eval_run_passes(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn loop_eval_divergent_body_step_loop_holds() -> Bool {
  loop_eval_run_passes(
    run: loop_eval_run(
      body: loop_eval_loop_node(body: loop_eval_divergent()),
      expected: loop_eval_lit_one()
    )
  )
}

data loop_demand_driven_eval_non_keystone_manuals_note: String = "lit_one / pick_call_direct / arrow_lit_one manuals were never on the enrolled keystone (main = divergent pole only). Umbrella-dissolution briefly folded them into the keystone and CI red them (run 30223338595). Deleted rather than if-false/Symbol-pin (review 43557). Dissolve-on: re-land as test fns only when claim_batch shows Bool(true) on CI hardware."

test fn loop_demand_driven_eval_keystone_holds() -> Bool {
  loop_eval_divergent_body_step_loop_holds()
}

