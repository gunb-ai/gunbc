module v2.test.claim.manual.defork_empty_repro

import v2.std.algebra { Empty, fold_list, list_append }
import v2.std.collection { List }
import v2.std.integer { Int }
import std.realization_schedule { ScheduleWitnessEntry }

fn repro_fold() -> List<Int> {
  fold_list(xs: [1, 2], empty: Empty, cons: fn(acc, item) {
    list_append(left: [item], right: acc)
  })
}
