module v2.test.manual.sg2_typescript_type_expression_projection

import v2.compiler.translate {
  translate_type_expression_project,
  target_serialize_source_from_model
}
import v2.extdeps.languages.typescript {
  ts_sg2_arrow_labeled_xy_emitted,
  ts_sg2_arrow_malformed_source_type_node,
  ts_sg2_arrow_mixed_wire_emitted,
  ts_sg2_arrow_source_type_node,
  ts_sg2_arrow_xy_emitted,
  ts_sg2_binary_fn_source_type_node,
  ts_sg2_conj_source_type_node,
  ts_sg2_conj_xy_emitted,
  ts_sg2_disj_source_type_node,
  ts_sg2_foobar_xy_emitted,
  ts_sg2_instantiation_source_type_node,
  ts_sg2_sum_xy_emitted,
  ts_sg2_type_expr_target_model,
  ts_type_expression_projection
}
import v2.std.compilers.target_model {
  target_type_expr_arrow_labeled_codomain,
  target_type_expr_arrow_labeled_param_slots,
  target_type_expr_arrow_wire_shape,
  target_type_expr_emitted_wire_decode,
  TargetTypeExprArrowLabeledWire,
  TargetTypeExprArrowPositionalWire
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, content_hash, SyntheticOccurrence }
import v2.std.text { String }
import v2.std.verification {
  CompilesClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data ts_sg2_fail_text: String = ""
data ts_sg2_expected_instantiation_text: String = "FooBar<X, Y>"
data ts_sg2_expected_arrow_text: String = "(X) => Y"
data ts_sg2_expected_arrow_labeled_text: String = "(X: X) => Y"
data ts_sg2_expected_conj_text: String = " { X: X, Y: Y }"
data ts_sg2_expected_disj_text: String = "X | Y"

fn ts_sg2_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^ts_sg2_pass_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_sg2_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^ts_sg2_fail_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_sg2_claim_input(ok: Bool) -> Node {
  if ok {
    ts_sg2_pass_node()
  } else {
    ts_sg2_fail_node()
  }
}

fn ts_sg2_project_instantiation_emitted() -> Node {
  match translate_type_expression_project(
    node: ts_sg2_instantiation_source_type_node(),
    target: ts_sg2_type_expr_target_model(),
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => ts_sg2_fail_node()
  }
}

fn ts_sg2_projection_matches_golden() -> Bool {
  content_hash(n: ts_sg2_project_instantiation_emitted()) ==
    content_hash(n: ts_sg2_foobar_xy_emitted())
}

fn ts_sg2_project_arrow_emitted() -> Node {
  match translate_type_expression_project(
    node: ts_sg2_arrow_source_type_node(),
    target: ts_sg2_type_expr_target_model(),
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => ts_sg2_fail_node()
  }
}

fn ts_sg2_project_conj_emitted() -> Node {
  match translate_type_expression_project(
    node: ts_sg2_conj_source_type_node(),
    target: ts_sg2_type_expr_target_model(),
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => ts_sg2_fail_node()
  }
}

fn ts_sg2_project_disj_emitted() -> Node {
  match translate_type_expression_project(
    node: ts_sg2_disj_source_type_node(),
    target: ts_sg2_type_expr_target_model(),
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => ts_sg2_fail_node()
  }
}

fn ts_sg2_binary_fn_projection_accepts() -> Bool {
  match translate_type_expression_project(
    node: ts_sg2_binary_fn_source_type_node(),
    target: ts_sg2_type_expr_target_model(),
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn ts_sg2_arrow_malformed_projection_rejects() -> Bool {
  match translate_type_expression_project(
    node: ts_sg2_arrow_malformed_source_type_node(),
    target: ts_sg2_type_expr_target_model(),
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn ts_sg2_serialize_accepts(emitted: Node) -> Bool {
  match target_serialize_source_from_model(
    target: ts_sg2_type_expr_target_model(),
    emitted: emitted
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn ts_sg2_serialized_text(emitted: Node) -> String {
  match target_serialize_source_from_model(
    target: ts_sg2_type_expr_target_model(),
    emitted: emitted
  ) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => ts_sg2_fail_text
  }
}

fn ts_sg2_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_foobar_xy_emitted()) == ts_sg2_expected_instantiation_text
}

fn ts_sg2_arrow_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_arrow_xy_emitted()) == ts_sg2_expected_arrow_text
}

fn ts_sg2_arrow_projected_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_project_arrow_emitted()) == ts_sg2_expected_arrow_text
}

fn ts_sg2_conj_projected_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_project_conj_emitted()) == ts_sg2_expected_conj_text
}

fn ts_sg2_instantiation_projected_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_project_instantiation_emitted()) == ts_sg2_expected_instantiation_text
}

fn ts_sg2_disj_projected_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_project_disj_emitted()) == ts_sg2_expected_disj_text
}

fn ts_sg2_arrow_labeled_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_arrow_labeled_xy_emitted()) ==
    ts_sg2_expected_arrow_labeled_text
}

fn ts_sg2_arrow_positional_wire_shape() -> Bool {
  match target_type_expr_arrow_wire_shape(node: ts_sg2_arrow_xy_emitted()) {
    Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: _ } => true
    Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}

fn ts_sg2_arrow_labeled_wire_shape() -> Bool {
  match target_type_expr_arrow_wire_shape(node: ts_sg2_arrow_labeled_xy_emitted()) {
    Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: _ } => true
    Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}

fn ts_sg2_arrow_mixed_wire_rejects() -> Bool {
  match target_type_expr_arrow_wire_shape(node: ts_sg2_arrow_mixed_wire_emitted()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn ts_sg2_arrow_mixed_wire_decode_rejects() -> Bool {
  match target_type_expr_emitted_wire_decode(
    node: ts_sg2_arrow_mixed_wire_emitted(),
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn ts_sg2_arrow_mixed_wire_labeled_accessors_reject() -> Bool {
  match target_type_expr_arrow_labeled_codomain(node: ts_sg2_arrow_mixed_wire_emitted()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } =>
      match target_type_expr_arrow_labeled_param_slots(node: ts_sg2_arrow_mixed_wire_emitted()) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
  }
}

fn ts_sg2_conj_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_conj_xy_emitted()) == ts_sg2_expected_conj_text
}

fn ts_sg2_disj_serialize_matches_expected() -> Bool {
  ts_sg2_serialized_text(emitted: ts_sg2_sum_xy_emitted()) == ts_sg2_expected_disj_text
}

fn ts_sg2_wire_decode_accepts(emitted: Node) -> Bool {
  match target_type_expr_emitted_wire_decode(
    node: emitted,
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn ts_sg2_instantiation_delimiters_bidirectional() -> Bool {
  let row = ts_type_expression_projection()
  row.instantiation_form.open == ^ts_token_lt &&
    row.instantiation_form.separator == ^ts_token_comma &&
    row.instantiation_form.close == ^ts_token_gt
}

data claim_ts_sg2_projection_structural: TestClaim = EqualsClaim {
  label: "manual/sg2-ts: Instantiation projects to golden FooBar<X,Y> emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_sg2_project_instantiation_emitted(),
  rhs: ts_sg2_foobar_xy_emitted(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_serialize_falsification: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: serialized generic apply is FooBar<X, Y>",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_serialize_matches_expected()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_projection_structural: TestClaim = EqualsClaim {
  label: "manual/sg2-ts: Arrow projects to golden fat-arrow emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_sg2_project_arrow_emitted(),
  rhs: ts_sg2_arrow_xy_emitted(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_conj_projection_structural: TestClaim = EqualsClaim {
  label: "manual/sg2-ts: Conj record projects to golden structural record emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_sg2_project_conj_emitted(),
  rhs: ts_sg2_conj_xy_emitted(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_disj_projection_structural: TestClaim = EqualsClaim {
  label: "manual/sg2-ts: Disj union projects to golden sum emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_sg2_project_disj_emitted(),
  rhs: ts_sg2_sum_xy_emitted(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_serialize: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: serialized arrow is (X) => Y",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_arrow_serialize_matches_expected()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_labeled_serialize: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: serialized labeled arrow is (X: X) => Y",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_arrow_labeled_serialize_matches_expected()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_positional_wire_shape: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: positional golden arrow wire classifies as PositionalWire",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_arrow_positional_wire_shape()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_labeled_wire_shape: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: labeled golden arrow wire classifies as LabeledWire",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_arrow_labeled_wire_shape()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_mixed_wire_shape_rejects: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: mixed positional+labeled arrow wire-shape rejects fail-closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_arrow_mixed_wire_rejects()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_mixed_wire_decode_rejects: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: mixed positional+labeled arrow wire decode rejects fail-closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_arrow_mixed_wire_decode_rejects()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_mixed_wire_labeled_accessors_reject: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: mixed positional+labeled arrow labeled accessors reject fail-closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_arrow_mixed_wire_labeled_accessors_reject()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_conj_serialize: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: serialized conj record is { X, Y } (structural; field labels gated)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_conj_serialize_matches_expected()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_disj_serialize: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: serialized disj union is X | Y",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_disj_serialize_matches_expected()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_binary_fn_projection: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: substrate binary-fn Arrow projects n-ary inputs + output",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_binary_fn_projection_accepts()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_arrow_malformed_rejects: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: Arrow with fewer than two positional children rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_arrow_malformed_projection_rejects()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_bidirectional_delimiters: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: instantiation_form delimiters are bidirectional lex token classes",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_instantiation_delimiters_bidirectional()),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_ts_sg2_wire_decode_instantiation: TestClaim = CompilesClaim {
  label: "manual/sg2-ts: wire decode accepts golden instantiation emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ts_sg2_claim_input(ok: ts_sg2_wire_decode_accepts(emitted: ts_sg2_foobar_xy_emitted())),
  expected_value: ts_sg2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

fn witness_ts_sg2_projected_serialize_holds() -> Bool {
  ts_sg2_projection_matches_golden()
    && ts_sg2_arrow_projected_serialize_matches_expected()
    && ts_sg2_conj_projected_serialize_matches_expected()
    && ts_sg2_instantiation_projected_serialize_matches_expected()
    && ts_sg2_disj_projected_serialize_matches_expected()
}
