module v2.test.manual.parallel_executor


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data parallel_executor_expected_first_batch: v2.workflow.executor.ExecutorBatch = v2.workflow.executor.ExecutorBatch {
  jobs: [
    v2.workflow.executor.executor_job_for_node(node: v2.test.manual.scheduler_runnable_frontier.scheduler_build_node),
    v2.workflow.executor.executor_job_for_node(node: v2.test.manual.scheduler_runnable_frontier.scheduler_test_node)
  ]
}

data parallel_executor_expected_second_batch: v2.workflow.executor.ExecutorBatch = v2.workflow.executor.ExecutorBatch {
  jobs: [
    v2.workflow.executor.executor_job_for_node(node: v2.test.manual.scheduler_runnable_frontier.scheduler_emit_node)
  ]
}

data parallel_executor_expected_batches: List<v2.workflow.executor.ExecutorBatch> = [
  parallel_executor_expected_first_batch,
  parallel_executor_expected_second_batch
]

fn parallel_executor_groups_independent_jobs() -> Bool {
  match v2.workflow.executor.parallel_executor_plan_from_dependencies(
    nodes: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_nodes,
    dependencies: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_dependencies,
    scheduled: []
  ) {
    v2.workflow.executor.ExecutorRunComplete { batches: batches, scheduled: _ } => batches == parallel_executor_expected_batches
    v2.workflow.executor.ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    v2.workflow.executor.ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

fn parallel_executor_projects_scheduler_scheduled_nodes() -> Bool {
  match v2.workflow.executor.parallel_executor_plan_from_dependencies(
    nodes: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_nodes,
    dependencies: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_dependencies,
    scheduled: []
  ) {
    v2.workflow.executor.ExecutorRunComplete { batches: _, scheduled: scheduled } =>
      scheduled == [
        v2.test.manual.scheduler_runnable_frontier.scheduler_build_node,
        v2.test.manual.scheduler_runnable_frontier.scheduler_test_node,
        v2.test.manual.scheduler_runnable_frontier.scheduler_emit_node
      ]
    v2.workflow.executor.ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    v2.workflow.executor.ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

fn parallel_executor_keeps_dependent_job_out_of_first_batch() -> Bool {
  match v2.workflow.executor.parallel_executor_plan_from_dependencies(
    nodes: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_nodes,
    dependencies: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_dependencies,
    scheduled: []
  ) {
    v2.workflow.executor.ExecutorRunComplete { batches: batches, scheduled: _ } =>
      v2.workflow.executor.executor_batch_contains_node(batch: parallel_executor_expected_first_batch, node: v2.test.manual.scheduler_runnable_frontier.scheduler_emit_node) == false
        && batches == parallel_executor_expected_batches
    v2.workflow.executor.ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    v2.workflow.executor.ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

fn parallel_executor_contains_edges_do_not_serialize() -> Bool {
  match v2.workflow.executor.parallel_executor_plan_from_dependencies(
    nodes: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_nodes,
    dependencies: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_dependencies_with_contains_noise,
    scheduled: []
  ) {
    v2.workflow.executor.ExecutorRunComplete { batches: batches, scheduled: _ } => batches == parallel_executor_expected_batches
    v2.workflow.executor.ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    v2.workflow.executor.ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

fn parallel_executor_step_plan_exposes_runnable_batch_once() -> Bool {
  match v2.workflow.executor.parallel_executor_step_plan_from_dependencies(
    nodes: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_nodes,
    dependencies: v2.test.manual.scheduler_runnable_frontier.scheduler_fixture_dependencies,
    scheduled: []
  ) {
    v2.workflow.executor.ExecutorRunComplete { batches: _, scheduled: _ } => false
    v2.workflow.executor.ExecutorRunRunnable {
      batch: batch,
      scheduled: scheduled,
      remaining: remaining
    } =>
      batch == parallel_executor_expected_first_batch
        && scheduled == [v2.test.manual.scheduler_runnable_frontier.scheduler_build_node, v2.test.manual.scheduler_runnable_frontier.scheduler_test_node]
        && remaining == [v2.test.manual.scheduler_runnable_frontier.scheduler_emit_node]
    v2.workflow.executor.ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

fn parallel_executor_blocks_on_missing_prerequisite() -> Bool {
  match v2.workflow.executor.parallel_executor_plan_from_dependencies(
    nodes: [v2.test.manual.scheduler_runnable_frontier.scheduler_build_node],
    dependencies: v2.test.manual.scheduler_runnable_frontier.scheduler_missing_prerequisite_dependencies,
    scheduled: []
  ) {
    v2.workflow.executor.ExecutorRunComplete { batches: _, scheduled: _ } => false
    v2.workflow.executor.ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    v2.workflow.executor.ExecutorRunBlocked {
      evidence: v2.workflow.executor.ExecutorSchedulerBlocked { evidence: v2.workflow.scheduler.SchedulerNoRunnableFrontier {} },
      batches: batches,
      scheduled: scheduled,
      remaining: remaining
    } => batches == [] && scheduled == [] && remaining == [v2.test.manual.scheduler_runnable_frontier.scheduler_build_node]
    v2.workflow.executor.ExecutorRunBlocked { evidence: v2.workflow.executor.ExecutorEmptyFrontier {}, batches: _, scheduled: _, remaining: _ } => false
  }
}

fn parallel_executor_layers_reuse_readiness_frontiers() -> Bool {
  let layers = [
    v2.std.dependency.ReadinessLayer { ready: [v2.test.manual.scheduler_runnable_frontier.scheduler_build_node, v2.test.manual.scheduler_runnable_frontier.scheduler_test_node] },
    v2.std.dependency.ReadinessLayer { ready: [v2.test.manual.scheduler_runnable_frontier.scheduler_emit_node] }
  ]
  match v2.workflow.executor.parallel_executor_plan_from_layers(layers: layers) {
    v2.workflow.executor.ExecutorRunComplete { batches: batches, scheduled: scheduled } =>
      v2.workflow.executor.executor_batches_preserve_frontiers(batches: batches, layers: layers)
        && scheduled == [
          v2.test.manual.scheduler_runnable_frontier.scheduler_build_node,
          v2.test.manual.scheduler_runnable_frontier.scheduler_test_node,
          v2.test.manual.scheduler_runnable_frontier.scheduler_emit_node
        ]
    v2.workflow.executor.ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    v2.workflow.executor.ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

data parallel_executor_batches_independent_jobs: Bool = parallel_executor_groups_independent_jobs()

data parallel_executor_scheduled_nodes_match_scheduler: Bool = parallel_executor_projects_scheduler_scheduled_nodes()

data parallel_executor_dependent_waits_for_prior_batch: Bool = parallel_executor_keeps_dependent_job_out_of_first_batch()

data parallel_executor_contains_noise_non_blocking: Bool = parallel_executor_contains_edges_do_not_serialize()

data parallel_executor_step_runnable_batch_once: Bool = parallel_executor_step_plan_exposes_runnable_batch_once()

data parallel_executor_missing_prerequisite_blocks: Bool = parallel_executor_blocks_on_missing_prerequisite()

data parallel_executor_layer_projection_reuses_frontiers: Bool = parallel_executor_layers_reuse_readiness_frontiers()

test fn parallel_executor_claims_hold() -> Bool {
  parallel_executor_batches_independent_jobs
    && parallel_executor_scheduled_nodes_match_scheduler
    && parallel_executor_dependent_waits_for_prior_batch
    && parallel_executor_contains_noise_non_blocking
    && parallel_executor_step_runnable_batch_once
    && parallel_executor_missing_prerequisite_blocks
    && parallel_executor_layer_projection_reuses_frontiers
}
