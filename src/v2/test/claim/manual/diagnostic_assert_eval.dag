module v2.test.manual.diagnostic_assert_eval

import v2.compiler.eval {
  TestClaimEvalSubject,
  aggregate_verdicts,
  eval_diagnostic,
  run_test_claim_assert
}
import v2.std.verdict { Verdict, Pass, Fail, Deferred }
import v2.std.node { Node }
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  node_locus,
  NonEmptyDiagnostics,
  Outcome,
  Accepted,
  Rejected,
  None,
  Unavailable,
  diagnostics_singleton,
  outcome_node_eq
}
import v2.std.collection { List }
import v2.std.node { Node, Symbol }
import v2.std.verification {
  DiagnosticClaim,
  TestClaim,
  ManualAnchorAbsent,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.test.manual.connective_anchors { stub_empty_conj }
fn diag_assert_node() -> Node {
  stub_empty_conj
}

fn diag_assert_d() -> Diagnostic {
  Diagnostic {
    reason: ^diag_assert_reason,
    at: node_locus(node: diag_assert_node()),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn diag_assert_other_d() -> Diagnostic {
  Diagnostic {
    reason: ^diag_assert_other,
    at: node_locus(node: diag_assert_node()),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

data rejected_expected_rejection: NonEmptyDiagnostics = diagnostics_singleton(d: diag_assert_d())

data rejected_expected: Outcome<Node> = Rejected { diagnostics: rejected_expected_rejection }

data rejected_same: Outcome<Node> = rejected_expected

data rejected_other: Outcome<Node> = Rejected {
  diagnostics: diagnostics_singleton(d: diag_assert_other_d())
}

data accepted_actual: Outcome<Node> = Accepted {
  value: diag_assert_node(),
  diagnostics: None
}

data witness_diagnostic_claim_match: TestClaim = DiagnosticClaim {
  label: "witness: diagnostic claim match",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: diag_assert_node(),
  expected_rejection: rejected_expected_rejection,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data witness_diagnostic_claim_mismatch: TestClaim = DiagnosticClaim {
  label: "witness: diagnostic claim mismatch",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: diag_assert_node(),
  expected_rejection: rejected_expected_rejection,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data witness_diagnostic_claim_accepted_fail: TestClaim = DiagnosticClaim {
  label: "witness: diagnostic claim accepted fail",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: diag_assert_node(),
  expected_rejection: rejected_expected_rejection,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data witness_diagnostic_assert_match_pass: Bool = match run_test_claim_assert(
  claim: witness_diagnostic_claim_match,
  actual: rejected_same,
  at: diag_assert_node()
) {
  Pass => true
  Fail { actual: _, falsification: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}

data witness_diagnostic_assert_mismatch_fail: Bool = match run_test_claim_assert(
  claim: witness_diagnostic_claim_mismatch,
  actual: rejected_other,
  at: diag_assert_node()
) {
  Pass => false
  Fail { actual: _, falsification: _ } => true
  Deferred { actual: _, diagnostic: _ } => false
}

fn empty_node_verdicts() -> List<Verdict<TestClaimEvalSubject<Node>, Node>> {
  []
}

data witness_diagnostic_assert_accepted_fail: Bool = match run_test_claim_assert(
  claim: witness_diagnostic_claim_accepted_fail,
  actual: accepted_actual,
  at: diag_assert_node()
) {
  Pass => false
  Fail { actual: _, falsification: _ } => true
  Deferred { actual: _, diagnostic: _ } => false
}

data witness_aggregate_empty_fail: Bool = match aggregate_verdicts(rs: empty_node_verdicts(), at: diag_assert_node()) {
  Pass => false
  Fail { actual: _, falsification: _ } => true
  Deferred { actual: _, diagnostic: _ } => false
}

fn deferred_verdict() -> Verdict<TestClaimEvalSubject<Node>, Node> {
  Deferred {
    actual: rejected_same,
    diagnostic: eval_diagnostic(reason: ^diag_assert_reason, node: diag_assert_node())
  }
}

data witness_aggregate_deferred_blocks_pass: Bool = match aggregate_verdicts(rs: [Pass, deferred_verdict()], at: diag_assert_node()) {
  Pass => false
  Fail { actual: _, falsification: _ } => false
  Deferred { actual: _, diagnostic: _ } => true
}
