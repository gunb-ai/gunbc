module v2.test.manual.program_assembly_multi_file


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn pa_graft_module_root(root: Node) -> Node {
  match module_header_containment_graft(root: root) {
    v2.std.diagnostic.Accepted { value: grafted, diagnostics: _ } => grafted
    v2.std.diagnostic.Rejected { diagnostics: _ } => root
  }
}

fn pa_qn_node(seg: v2.std.node.Symbol) -> Node {
  fold_list_node(
    xs: std.algebra.Cons { head: seg, tail: std.algebra.Empty },
    item_node: fn(sym) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
}

fn pa_module_root(seg: v2.std.node.Symbol, export_sym: v2.std.node.Symbol, export_atom: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: pa_qn_node(seg: seg)
      ),
      v2.std.node.Edge {
        label: Named { name: export_sym },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: export_atom } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pa_subject_with_import_use() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: pa_qn_node(seg: ^pa_subject_seg)
      ),
      v2.std.node.Edge {
        label: Named { name: ^pa_import_use_sym },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^pa_imported_decl } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pa_cross_file_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  admit_normalized_roots(
    roots: std.algebra.Cons {
    head: pa_graft_module_root(root: pa_subject_with_import_use()),
    tail: std.algebra.Cons {
      head: pa_graft_module_root(
        root: pa_module_root(
          seg: ^pa_imported_seg,
          export_sym: ^pa_imported_decl,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: std.algebra.Empty
    }
  },
    diagnostics: None
  )
}

fn pa_duplicate_module_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  admit_normalized_roots(
    roots: std.algebra.Cons {
    head: pa_graft_module_root(
      root: pa_module_root(
        seg: ^pa_subject_seg,
        export_sym: ^pa_imported_decl,
        export_atom: ^dag_c3_surface_sugar_service
      )
    ),
    tail: std.algebra.Cons {
      head: pa_graft_module_root(
        root: pa_module_root(
          seg: ^pa_subject_seg,
          export_sym: ^pa_other_export,
          export_atom: ^dag_c3_surface_sugar_type
        )
      ),
      tail: std.algebra.Empty
    }
  },
    diagnostics: None
  )
}

fn pa_cross_file_admission() -> v2.compiler.name_resolve.Admission {
  v2.compiler.name_resolve.Admission {
    subject: v2.compiler.name_resolve.ResolutionSubject {
      name: std.algebra.Cons { head: ^pa_subject_seg, tail: std.algebra.Empty }
    },
    imports: std.algebra.Cons {
      head: v2.compiler.name_resolve.Import {
        target: std.algebra.Cons { head: ^pa_imported_seg, tail: std.algebra.Empty },
        visibility: ImportVisible
      },
      tail: std.algebra.Empty
    }
  }
}

test fn program_assembly_cross_file_import_assembles_holds() -> Bool {
  match pa_cross_file_roots() {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: admitted_roots, diagnostics: _ } =>
    match assemble_program_from_module_roots(
      roots: admitted_roots,
      admission: pa_cross_file_admission(),
      lm: dag_language_model_surface_empty_prelude()
    ) {
      v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
      v2.std.diagnostic.Rejected { diagnostics: _ } => false
    }
  }
}

test fn program_assembly_duplicate_module_roots_rejects() -> Bool {
  match pa_duplicate_module_roots() {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: admitted_roots, diagnostics: _ } =>
    match assemble_program_from_module_roots(
      roots: admitted_roots,
      admission: pa_cross_file_admission(),
      lm: dag_language_model_surface_empty_prelude()
    ) {
      v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      v2.std.diagnostic.Rejected { diagnostics: _ } => true
    }
  }
}

data pa_ingest_stub_source: Medium<String> = extdeps.communication.medium.Medium { carried: "module pa_subject_seg", fidelity: Lossless }
data pa_ingest_source_file_artifact: v2.std.artifact.Artifact = v2.std.artifact.Artifact {
  kind: SourceFile,
  id: ^pa_ingest_source_file_artifact,
  file_path: "src/v2/test/fixture/program_assembly/pa_ingest_peer.dag"
}

data pa_ingest_test_claim_artifact: v2.std.artifact.Artifact = v2.std.artifact.Artifact {
  kind: TestClaimArtifact,
  id: ^pa_ingest_test_claim_artifact,
  file_path: "src/v2/test/fixture/pa_ingest_claim.dag"
}

data pa_ingest_source_file_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: pa_ingest_stub_source,
  artifact: pa_ingest_source_file_artifact,
  compilation_unit: ^pa_ingest_peer_cu,
  source_root: V2Tree
}

data pa_ingest_non_source_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: pa_ingest_stub_source,
  artifact: pa_ingest_test_claim_artifact,
  compilation_unit: ^pa_ingest_peer_cu,
  source_root: V2Tree
}

data pa_ingest_non_source_ingest: v2.compiler.source_authority.SourceRootIngest = std.algebra.Cons {
  head: pa_ingest_non_source_read,
  tail: std.algebra.Empty
}

test fn program_assembly_ingest_non_source_file_rejects() -> Bool {
  match assemble_program_from_ingest(
    ingest: pa_ingest_non_source_ingest,
    admission: v2.compiler.name_resolve.Admission {
      subject: v2.compiler.name_resolve.ResolutionSubject {
        name: std.algebra.Cons { head: ^pa_subject_seg, tail: std.algebra.Empty }
      },
      imports: Empty
    },
    lm: dag_language_model_surface_empty_prelude()
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      d.head.reason == ^source_authority_read_artifact_not_source_file
  }
}
