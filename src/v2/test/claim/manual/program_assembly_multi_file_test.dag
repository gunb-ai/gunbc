module v2.test.manual.program_assembly_multi_file

import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.normalized_tree {
  NormalizedTree,
  admit_normalized_tree,
  admit_unmarked_normalized_roots,
  no_type_declaration_kinds, no_type_declaration_modifiers
}
import v2.std.declaration_marker { test_marker_channel_empty }
import v2.std.namespace_alias { AliasBindingRow }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve {
  Admission,
  Import,
  ImportVisible,
  ResolutionSubject
}
import v2.compiler.program_assembly {
  assemble_program_from_ingest,
  assemble_program_from_module_roots
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_language_model_surface_empty_prelude,
  dag_named_edge,
  dag_surface_edge,
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list_node }
import v2.std.artifact { Artifact, SourceFile, TestClaimArtifact }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.compiler.namespace_graft { module_header_containment_graft }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Authored,
  Node,
  Symbol,
  TypeNode,
}
import v2.std.qualified_name { QualifiedName }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn pa_graft_module_root(root: Node) -> Node {
  match module_header_containment_graft(root: root) {
    Accepted { value: grafted, diagnostics: _ } => grafted
    Rejected { diagnostics: _ } => root
  }
}

fn pa_qn_node(seg: Symbol) -> Node {
  fold_list_node(
    xs: Cons { head: seg, tail: Empty },
    item_node: fn(sym) {
      Node {
        kind: TypeNode { connective: Atom { identity: sym } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    }
  )
}

fn pa_module_root(seg: Symbol, export_sym: Symbol, export_atom: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_surface_edge(edge: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_surface_edge(edge: ^dag_surface_module_header_qualified_name,
        target: pa_qn_node(seg: seg)
      ),
      Edge {
        label: Authored { name: export_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: export_atom } },
          children: [],
          occurrence_id: OccurrenceSynthetic
        }
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn pa_subject_with_import_use() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_surface_edge(edge: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_surface_edge(edge: ^dag_surface_module_header_qualified_name,
        target: pa_qn_node(seg: ^pa_subject_seg)
      ),
      Edge {
        label: Authored { name: ^pa_import_use_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^pa_imported_decl } },
          children: [],
          occurrence_id: OccurrenceSynthetic
        }
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

// THE SUBJECT'S IMPORT ARRIVES AS THE ALIAS BINDING ROW NORMALIZE CAPTURES, not as an Admission import
// the resolver used to satisfy by a global spelling search. gunbc#12048 made an import a binding on
// the reference's own chain (v2.std.namespace_alias AliasBindingRow, carried on NormalizedTree because
// the graft dissolves the import decl) and deleted the global bare search as a resolution route, so a
// hand-built root with no binding rows leaves `pa_imported_decl` unbound -- this claim was silently red
// from that change (bisected on BuildBuddy) until the fixture supplied the row.
fn pa_subject_import_bindings() -> FreeMonoid<AliasBindingRow> {
  Cons {
    head: AliasBindingRow {
      binding: ^pa_imported_decl,
      target: Cons { head: ^pa_imported_seg, tail: Cons { head: ^pa_imported_decl, tail: Empty } }
    },
    tail: Empty
  }
}

fn pa_cross_file_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  match admit_normalized_tree(
    root: pa_graft_module_root(root: pa_subject_with_import_use()),
    test_markers: test_marker_channel_empty(),
    import_bindings: pa_subject_import_bindings(),
    type_declaration_kinds: no_type_declaration_kinds(),
    type_declaration_modifiers: no_type_declaration_modifiers(),
    diagnostics: None
  ) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: subject, diagnostics: _ } =>
      match admit_unmarked_normalized_roots(
        roots: Cons {
          head: pa_graft_module_root(
            root: pa_module_root(
              seg: ^pa_imported_seg,
              export_sym: ^pa_imported_decl,
              export_atom: ^dag_token_ident
            )
          ),
          tail: Empty
        },
        diagnostics: None
      ) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: imported, diagnostics: _ } =>
          Accepted { value: Cons { head: subject, tail: imported }, diagnostics: None }
      }
  }
}

fn pa_duplicate_module_roots() -> Outcome<FreeMonoid<NormalizedTree>> {
  admit_unmarked_normalized_roots(
    roots: Cons {
    head: pa_graft_module_root(
      root: pa_module_root(
        seg: ^pa_subject_seg,
        export_sym: ^pa_imported_decl,
        export_atom: ^dag_token_ident
      )
    ),
    tail: Cons {
      head: pa_graft_module_root(
        root: pa_module_root(
          seg: ^pa_subject_seg,
          export_sym: ^pa_other_export,
          export_atom: ^dag_token_colon
        )
      ),
      tail: Empty
    }
  },
    diagnostics: None
  )
}

fn pa_cross_file_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: Cons { head: ^pa_subject_seg, tail: Empty }
    },
    imports: Cons {
      head: Import {
        target: Cons { head: ^pa_imported_seg, tail: Empty },
        visibility: ImportVisible
      },
      tail: Empty
    }
  }
}

test fn program_assembly_cross_file_import_assembles_holds() -> Bool  {
  match pa_cross_file_roots() {
    Rejected { diagnostics: _ } => false
    Accepted { value: admitted_roots, diagnostics: _ } =>
    match assemble_program_from_module_roots(
      roots: admitted_roots,
      admission: pa_cross_file_admission(),
      lm: dag_language_model_surface_empty_prelude()
    ) {
      Accepted { value: _, diagnostics: _ } => true
      Rejected { diagnostics: _ } => false
    }
  }
}

test fn program_assembly_duplicate_module_roots_rejects() -> Bool  {
  match pa_duplicate_module_roots() {
    Rejected { diagnostics: _ } => false
    Accepted { value: admitted_roots, diagnostics: _ } =>
    match assemble_program_from_module_roots(
      roots: admitted_roots,
      admission: pa_cross_file_admission(),
      lm: dag_language_model_surface_empty_prelude()
    ) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
  }
}

data pa_ingest_stub_source: Medium<String> = Medium { carried: "module pa_subject_seg", fidelity: Lossless }
data pa_ingest_source_file_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^pa_ingest_source_file_artifact,
  file_path: "src/v2/test/fixture/program_assembly/pa_ingest_peer.dag"
}

data pa_ingest_test_claim_artifact: Artifact = Artifact {
  kind: TestClaimArtifact,
  id: ^pa_ingest_test_claim_artifact,
  file_path: "src/v2/test/fixture/pa_ingest_claim.dag"
}

data pa_ingest_source_file_read: DagSourceReadWitness = DagSourceReadWitness {
  source: pa_ingest_stub_source,
  artifact: pa_ingest_source_file_artifact,
  compilation_unit: ^pa_ingest_peer_cu,
  source_root: V2Tree
}

data pa_ingest_non_source_read: DagSourceReadWitness = DagSourceReadWitness {
  source: pa_ingest_stub_source,
  artifact: pa_ingest_test_claim_artifact,
  compilation_unit: ^pa_ingest_peer_cu,
  source_root: V2Tree
}

data pa_ingest_non_source_ingest: SourceRootIngest = Cons {
  head: pa_ingest_non_source_read,
  tail: Empty
}

test fn program_assembly_ingest_non_source_file_rejects() -> Bool  {
  match assemble_program_from_ingest(
    ingest: pa_ingest_non_source_ingest,
    admission: Admission {
      subject: ResolutionSubject {
        name: Cons { head: ^pa_subject_seg, tail: Empty }
      },
      imports: Empty
    },
    lm: dag_language_model_surface_empty_prelude()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      d.head.reason == ^source_authority_read_artifact_not_source_file
  }
}
