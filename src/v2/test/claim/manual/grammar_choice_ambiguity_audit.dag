module v2.test.manual.grammar_choice_ambiguity_audit

import v2.compiler.parse {
  grammar_choice_ambiguity_count,
  grammar_choice_ambiguity_roster,
  grammar_has_choice_ambiguity,
  grammar_validate_for_parse
}
import v2.extdeps.languages.dag { dag_wave1_grammar_root }
import v2.extdeps.languages.python { python_wave1_grammar_root }
import v2.std.collection { list_at_optional, Present, Absent }
import v2.std.diagnostic { Accepted, Rejected, port_locus }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

data gca_audit_note: String = "Manual ambiguity stomper receipt (not CI-enrolled). Engine contract: EVERY Choice routes through parse_choice_first_dispatch; choice_branches_ambiguous (same predicate as this roster) unconditionally selects parse_choice_residue_backtrack — ordered try-L-then-R, not an enumerated production set ('named backtrack residue' names the function). FIRST-dispatch is an optimization only when branches are provably disjoint at the current token. grammar_validate_for_parse must not reject on roster overlap: that gate restated an LL(1) property this engine never assumed and blocked parse before the universal backtrack arm (#6314 regression). dag_wave1: five rostered overlaps (expr block|binary brace, arg, match_arm, field_pattern, if_expr). python_wave1: roster count=1 (suite stmt overlap) — still tracked for left-factoring, not a validate refusal. Remaining parser fallback: match_arm_stmt_body memo bypass. dag_wave1 grammar root: extdeps authority (dag_wave1_grammar_root)."

fn witness_python_wave1_choice_ambiguity_count() -> Int {
  grammar_choice_ambiguity_count(root: python_wave1_grammar_root())
}

fn witness_python_wave1_grammar_validate_accepts() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: python_wave1_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn witness_dag_wave1_choice_ambiguity_count_is_five() -> Bool {
  grammar_choice_ambiguity_count(root: dag_wave1_grammar_root()) == 5
}

fn witness_dag_wave1_grammar_has_choice_ambiguity() -> Bool {
  grammar_has_choice_ambiguity(root: dag_wave1_grammar_root())
}

fn witness_dag_wave1_grammar_validate_accepts() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: dag_wave1_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn witness_dag_wave1_first_choice_ambiguity_production() -> Symbol {
  match list_at_optional(
    xs: grammar_choice_ambiguity_roster(root: dag_wave1_grammar_root()),
    index: 0
  ) {
    Present { value: row } => row.production
    Absent => ^grammar_choice_ambiguity_roster_empty
  }
}
