module v2.test.manual.grammar_choice_ambiguity_audit


fn witness_python_choice_ambiguity_count() -> Int {
  grammar_choice_ambiguity_count(root: python_grammar_root())
}

fn witness_python_grammar_validate_accepts_with_overlap_residue() -> Bool {
  let at = invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^grammar_choice_ambiguity_audit_grammar_contract)
  match grammar_validate_for_parse(root: python_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn witness_dag_choice_ambiguity_count() -> Int {
  grammar_choice_ambiguity_count(root: dag_grammar_root())
}

fn witness_dag_zero_nullable_choice_ambiguity() -> Bool {
  is_empty(xs: grammar_nullable_ambiguity_rows(
    roster: grammar_choice_ambiguity_roster(root: dag_grammar_root())
  ))
}

fn witness_dag_overlap_residue_row_count() -> Int {
  length(xs: grammar_choice_ambiguity_roster(root: dag_grammar_root()))
}

fn witness_dag_grammar_validate_accepts() -> Bool {
  let at = invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^grammar_choice_ambiguity_audit_grammar_contract)
  match grammar_validate_for_parse(root: dag_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// THE RESIDUE ROSTER BY IDENTITY, not a count plus its first row. A row's identity is its
// production and the terminals both arms can start with: two rosters of equal length can differ
// in every row, so a count cannot show a row was removed and another added. One line per row,
// `production: t1 t2 ...`, in roster order.
fn grammar_choice_ambiguity_row_identity(row: GrammarChoiceAmbiguityRow) -> String {
  symbol_lexeme(sym: row.production) + ": " + string_join(
    fields: fold_list(xs: row.overlap_terminals, empty: [], cons: fn(acc, t) {
      list_snoc_item(xs: acc, item: symbol_lexeme(sym: t))
    }),
    separator: " "
  )
}

fn witness_dag_overlap_residue_row_identities() -> String {
  string_join(
    fields: fold_list(
      xs: grammar_choice_ambiguity_roster(root: dag_grammar_root()),
      empty: [],
      cons: fn(acc, row) { list_snoc_item(xs: acc, item: grammar_choice_ambiguity_row_identity(row: row)) }
    ),
    separator: "\n"
  )
}
