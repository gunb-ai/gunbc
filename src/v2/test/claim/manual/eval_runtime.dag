module v2.test.manual.eval_runtime



fn eval_byte() -> std.bit.Byte {
  std.bit.Byte { bits: [true] }
}

fn eval_i64_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^eval_i64_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn eval_algebra_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^eval_algebra_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data eval_two_literal: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Value },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data eval_add_subgraph_node: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Transform },
  children: [
    v2.std.node.Edge { label: Positional, target: eval_two_literal },
    v2.std.node.Edge { label: Positional, target: eval_two_literal }
  ],
  occurrence_id: SyntheticOccurrence
}

fn eval_add_subgraph() -> Node {
  eval_add_subgraph_node
}

fn eval_runtime_value(bytes: List<std.bit.Byte>) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: eval_i64_node(),
      bytes: bytes
    }
  }
}

fn eval_two_value() -> v2.std.runtime.RuntimeValue {
  eval_runtime_value(bytes: [eval_byte(), eval_byte()])
}

fn eval_five_value() -> v2.std.runtime.RuntimeValue {
  eval_runtime_value(
    bytes: [
      eval_byte(),
      eval_byte(),
      eval_byte(),
      eval_byte(),
      eval_byte()
    ]
  )
}

fn eval_allocate_literal(_node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: eval_two_value(), diagnostics: v2.std.diagnostic.None }
}

fn eval_arg_is_two_literal(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == eval_i64_node()) && (count(p.bytes) == 2)
    _ => false
  }
}

fn eval_args_absent_diagnostic() -> v2.std.diagnostic.Diagnostic {
  eval_diagnostic(reason: ^eval_args_not_two_literals, node: eval_add_subgraph_node)
}

fn eval_args_are_two_literals(args: List<v2.std.runtime.RuntimeValue>) -> Bool {
  if count(args) == 2 {
    match list_nth(xs: args, wanted: 0, absent: eval_args_absent_diagnostic()) {
      Holds { value: left } =>
        match list_nth(xs: args, wanted: 1, absent: eval_args_absent_diagnostic()) {
          Holds { value: right } =>
            eval_arg_is_two_literal(value: left)
              && eval_arg_is_two_literal(value: right)
          Violates { diagnostic: _ } => false
        }
      Violates { diagnostic: _ } => false
    }
  } else {
    false
  }
}

fn eval_call_primitive(
  _node: Node,
  args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if eval_args_are_two_literals(args: args) {
    v2.std.diagnostic.Accepted { value: eval_five_value(), diagnostics: v2.std.diagnostic.None }
  } else {
    v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(
        d: eval_diagnostic(reason: ^eval_args_not_two_literals, node: _node)
      )
    }
  }
}

fn eval_choose_branch(_node: Node, _value: v2.std.runtime.RuntimeValue, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<Node> {
  v2.std.diagnostic.Accepted { value: eval_add_subgraph(), diagnostics: v2.std.diagnostic.None }
}

fn eval_step_loop(_node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Accepted { value: v2.std.runtime.Continue { value: eval_five_value() }, diagnostics: v2.std.diagnostic.None }
}

fn eval_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: v2.std.diagnostic.None }
}

fn eval_represent_result(value: v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: value, diagnostics: v2.std.diagnostic.None }
}

fn eval_allocate(value: v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: value, diagnostics: v2.std.diagnostic.None }
}

fn eval_example_call(_call: v2.std.runtime.EvaluationCall, _frame: v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Accepted { value: v2.std.runtime.Return { value: eval_five_value() }, diagnostics: v2.std.diagnostic.None }
}

fn eval_return_value(value: v2.std.runtime.RuntimeValue, _frame: v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Accepted { value: v2.std.runtime.Return { value: value }, diagnostics: v2.std.diagnostic.None }
}

fn eval_transfer(_control: v2.std.runtime.ControlTransfer, frame: v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationFrame> {
  v2.std.diagnostic.Accepted { value: frame, diagnostics: v2.std.diagnostic.None }
}

fn eval_interpretation_algebra() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: eval_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: eval_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: eval_choose_branch
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: eval_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: eval_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: runtime_reject_match_arm
    }
  }
}

fn eval_example_diagnostic(n: Node) -> v2.std.diagnostic.Diagnostic {
  eval_diagnostic(reason: ^eval_descent_not_derived, node: n)
}

fn eval_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^eval_descent_dimension }
  }
}

fn eval_facts_for_node(node: Node) -> v2.compiler.infer.InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: eval_i64_node(),
    descent: v2.std.witness.Holds { value: eval_termination_proof() }
  )
}

fn eval_fact_lookup(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  if node == eval_two_literal {
    optional_present(value: eval_facts_for_node(node: eval_two_literal))
  } else if node == eval_add_subgraph_node {
    optional_present(value: eval_facts_for_node(node: eval_add_subgraph_node))
  } else {
    optional_absent()
  }
}

fn eval_inferred_tree() -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: eval_add_subgraph(),
    facts: std.types.Map {
      lookup: eval_fact_lookup
    }
  }
}

fn eval_actual() -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  eval(
    tree: eval_inferred_tree(),
    interpretation: eval_interpretation_algebra(),
    inputs: inputs_root_only(root: eval_add_subgraph())
  )
}

fn eval_empty_environment() -> v2.std.runtime.EvaluationEnvironment {
  v2.std.runtime.EvaluationEnvironment {
    bindings: empty_map()
  }
}

data witness_eval_add_accepts_five: Bool = match eval_actual() {
  v2.std.diagnostic.Accepted { value: RuntimePrimitive { value: p }, diagnostics: None } =>
    (p.primitive_type == eval_i64_node()) && (count(p.bytes) == 5)
  _ => false
}

data witness_eval_call_primitive_rejects_bad_args: Bool = match eval_call_primitive(
  _node: eval_add_subgraph_node,
  args: [],
  _env: eval_empty_environment()
) {
  v2.std.diagnostic.Rejected { diagnostics: _ } => true
  _ => false
}

fn eval_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^eval_allocate_literal_sym,
    call_primitive: ^eval_call_primitive_sym,
    choose_branch: ^eval_choose_branch_sym,
    step_loop: ^eval_step_loop_sym,
    bind_value: ^eval_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn eval_context() -> v2.compiler.eval.EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^eval_interpretation_pin,
    interpretation: eval_interpretation_algebra(),
    structure_witness: eval_interpretation_structure_witness()
  )
}

data claim_eval_test_claim_route: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "eval routes TestClaim through runtime interpretation",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: eval_add_subgraph(),
  rhs: eval_add_subgraph(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data subject_eval_test_claim_route: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_eval_test_claim_route,
  context: eval_context(),
  tree: eval_inferred_tree(),
  evaluator_pin: ^eval_evaluator_pin
)

data run_eval_test_claim_route: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_eval_test_claim_route
)
