module v2.test.manual.bash_emit_command


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn bash_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_absent()
}

fn bash_arrow_emitted_red_fixture() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^bash_word_git } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      },
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^bash_word_rev_parse } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      },
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^bash_word_show_toplevel } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_lhs_exact_arrow_emitted_rejects() -> Bool {
  match v2.extdeps.languages.bash.bash_lhs_exact_relation_row_witness(
    lhs: ^bash_production_command,
    tokens: v2.extdeps.languages.bash.bash_concrete_tokens(),
    emitted: bash_arrow_emitted_red_fixture()
  ) {
    v2.std.witness.Violates { diagnostic: d } => d.reason == ^grammar_relation_emitted_not_conj
    v2.std.witness.Holds { value: _ } => false
  }
}

test fn bash_emit_lhs_exact_arrow_emitted_rejects_holds() -> Bool {
  bash_lhs_exact_arrow_emitted_rejects()
}

data bash_emit_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: v2.extdeps.languages.bash.bash_emitted_command,
  facts: PartialFunction {
    lookup: bash_facts_lookup
  }
}

fn anchor_bash_emit_accepts() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.emit.emit(tree: bash_emit_inferred_tree, target: v2.extdeps.languages.bash.bash_target_model())
}

data bash_emit_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_bash_emit_accepts()

test fn bash_emit_command_accepts_holds() -> Bool {
  match bash_emit_receipt {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried == v2.extdeps.languages.bash.bash_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

data bash_empty_bundle: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data bash_missing_rules_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
  bundle: bash_empty_bundle,
  lex: v2.extdeps.languages.bash.bash_lex(),
  binding_spellings: v2.std.collection.empty_map(),
  token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
}

fn anchor_bash_serialize_rejects_missing_rules() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.translate.target_serialize_source_from_model(
    target: bash_missing_rules_target,
    emitted: v2.extdeps.languages.bash.bash_emitted_command
  )
}

data bash_serialize_reject_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_bash_serialize_rejects_missing_rules()

test fn bash_emit_missing_rules_rejects_holds() -> Bool {
  match bash_serialize_reject_receipt {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

