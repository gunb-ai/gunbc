fn bash_emit_pipe_brace_grouped_wrong_flat_model_rejects() -> Bool {
  let tree = v2.compiler.inferred_tree.InferredTree {
    root: v2.extdeps.languages.bash.bash_pipe_and_or_brace_grouped_emitted,
    facts: PartialFunction { lookup: bash_facts_lookup }
  }
  match v2.compiler.emit.emit(tree: tree, target: v2.extdeps.languages.bash.bash_pipe_and_or_flat_wrong_target_model()) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
      (source.carried != v2.extdeps.languages.bash.bash_pipe_and_or_brace_grouped_source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

test fn bash_emit_pipe_brace_grouped_wrong_flat_model_rejects_holds() -> Bool {
  bash_emit_pipe_brace_grouped_wrong_flat_model_rejects()
}
