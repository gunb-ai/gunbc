}

test fn bash_emit_pipe_and_or_flat_wrong_model_holds() -> Bool {
  bash_emit_slice4_holds(
    emitted: bash_pipe_and_or_flat_wrong_emitted,
    source_text: bash_pipe_and_or_flat_wrong_source_text,
    target: bash_pipe_and_or_flat_wrong_target_model()
  )
}

fn bash_emit_pipe_brace_grouped_wrong_flat_model_rejects() -> Bool {
  let tree = InferredTree {
    root: bash_pipe_and_or_brace_grouped_emitted,
    facts: Map { lookup: bash_facts_lookup }
  }
  match emit(tree: tree, target: bash_pipe_and_or_flat_wrong_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source.carried != bash_pipe_and_or_brace_grouped_source_text) && (d == None)
    Rejected { diagnostics: _ } => true
  }
}

test fn bash_emit_pipe_brace_grouped_wrong_flat_model_rejects_holds() -> Bool {
  bash_emit_pipe_brace_grouped_wrong_flat_model_rejects()
}
