fn bash_emit_slice4_holds(
  emitted: v2.std.node.Node,
  source_text: String,
  target: v2.std.compilers.target_model.TargetModel
) -> Bool {
  let tree = v2.compiler.inferred_tree.InferredTree {
    root: emitted,
    facts: PartialFunction { lookup: bash_facts_lookup }
  }
  match v2.compiler.emit.emit(tree: tree, target: target) {
    v2.std.diagnostic.Accepted { value: source, diagnostics: d } => (source.carried == source_text) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn bash_emit_and_then_holds() -> Bool {
  bash_emit_slice4_holds(
    emitted: v2.extdeps.languages.bash.bash_and_then_emitted,
    source_text: v2.extdeps.languages.bash.bash_and_then_source_text,
    target: v2.extdeps.languages.bash.bash_and_then_target_model()
  )
}

