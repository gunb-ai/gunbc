import v2.std.collection { Map, empty_map }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.node { Arrow, Atom, Conj, Edge, Node, Positional, SyntheticOccurrence, TypeNode }
import v2.std.witness { Holds, Violates, Witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn bash_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^bash_emit_facts_unexpected_consultation,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn bash_arrow_emitted_red_fixture() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^bash_word_git } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^bash_word_rev_parse } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^bash_word_show_toplevel } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_lhs_exact_arrow_emitted_rejects() -> Bool {
  match bash_lhs_exact_relation_row_witness(
    lhs: ^bash_production_command,
    tokens: bash_concrete_tokens(),
    emitted: bash_arrow_emitted_red_fixture()
  ) {
    Violates { diagnostic: d } => d.reason == ^grammar_relation_emitted_not_conj
    Holds { value: _ } => false
  }
}

test fn bash_emit_lhs_exact_arrow_emitted_rejects_holds() -> Bool {
  bash_lhs_exact_arrow_emitted_rejects()
}

data bash_emit_inferred_tree: InferredTree = InferredTree {
  root: bash_emitted_command,
  facts: Map {
    lookup: bash_facts_lookup
  }
}

fn anchor_bash_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: bash_emit_inferred_tree, target: bash_target_model())
}

data bash_emit_receipt: Outcome<Medium<String>> = anchor_bash_emit_accepts()

test fn bash_emit_command_accepts_holds() -> Bool {
  match bash_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source.carried == bash_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

data bash_empty_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data bash_missing_rules_target: TargetModel = TargetModel {
  bundle: bash_empty_bundle,
  lex: bash_lex(),
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_bash_serialize_rejects_missing_rules() -> Outcome<Medium<String>> {
  target_serialize_source_from_model(
    target: bash_missing_rules_target,
    emitted: bash_emitted_command
  )
}

data bash_serialize_reject_receipt: Outcome<Medium<String>> = anchor_bash_serialize_rejects_missing_rules()

test fn bash_emit_missing_rules_rejects_holds() -> Bool {
  match bash_serialize_reject_receipt {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

