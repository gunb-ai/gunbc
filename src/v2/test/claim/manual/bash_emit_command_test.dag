}

test fn bash_emit_pipe_and_or_flat_wrong_model_holds() -> Bool {
  bash_emit_slice4_holds(
    emitted: v2.extdeps.languages.bash.bash_pipe_and_or_flat_wrong_emitted,
    source_text: v2.extdeps.languages.bash.bash_pipe_and_or_flat_wrong_source_text,
    target: v2.extdeps.languages.bash.bash_pipe_and_or_flat_wrong_target_model()
  )
