fn bash_emit_slice4_holds(
  emitted: Node,
  source_text: String,
  target: TargetModel
) -> Bool {
  let tree = InferredTree {
    root: emitted,
    facts: Map { lookup: bash_facts_lookup }
  }
  match emit(tree: tree, target: target) {
    Accepted { value: source, diagnostics: d } => (source.carried == source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn bash_emit_and_then_holds() -> Bool {
  bash_emit_slice4_holds(
    emitted: bash_and_then_emitted,
    source_text: bash_and_then_source_text,
    target: bash_and_then_target_model()
  )
}

