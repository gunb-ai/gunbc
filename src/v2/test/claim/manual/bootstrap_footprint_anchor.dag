module v2.test.manual.bootstrap_footprint_anchor


fn bootstrap_footprint_anchor_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^bootstrap_footprint_anchor_fail_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn bootstrap_footprint_anchor_bad_snapshot_root_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^bootstrap_footprint_anchor_bad_snapshot_root } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn bootstrap_footprint_anchor_bad_projection_inputs() -> BootstrapProjectionInputs {
  BootstrapProjectionInputs {
    snapshot: BootstrapSourceSnapshot {
      root: bootstrap_footprint_anchor_bad_snapshot_root_node(),
      language_model: seed_capability_language_model(),
      content_hash: BootstrapHashPin {
        digest: pinned_v4_fixed_point_hash,
        pin: ^pinned_v4_fixed_point_hash_pin
      }
    },
    target_model: rust_target_model(),
    runtime_model: v2_evaluator_runtime()
  }
}

fn bootstrap_footprint_anchor_pass_node() -> Node {
  bootstrap_source_snapshot_root()
}

fn bootstrap_footprint_anchor_claim_input(ok: Bool) -> Node {
  if ok {
    bootstrap_footprint_anchor_pass_node()
  } else {
    bootstrap_footprint_anchor_fail_node()
  }
}

fn bootstrap_footprint_canonical_holds() -> Bool {
  match bootstrap_footprint(inputs: bootstrap_projection_inputs) {
    Holds { value: fp } =>
      fp.closure_hash ==
        content_hash(n: bootstrap_projection_closure_node(inputs: bootstrap_projection_inputs))
    Violates { diagnostic: _ } => false
  }
}

fn bootstrap_footprint_non_canonical_violates() -> Bool {
  let bad_inputs = bootstrap_footprint_anchor_bad_projection_inputs()
  match bootstrap_footprint(inputs: bad_inputs) {
    Holds { value: _ } => false
    Violates { diagnostic: d } => d.reason == ^bootstrap_footprint_not_realized
  }
}

fn bootstrap_footprint_anchor_bad_content_hash_projection_inputs() -> BootstrapProjectionInputs {
  BootstrapProjectionInputs {
    snapshot: BootstrapSourceSnapshot {
      root: bootstrap_source_snapshot_root(),
      language_model: seed_capability_language_model(),
      content_hash: BootstrapHashPin {
        digest: v2_stage0_hash,
        pin: ^pinned_v4_fixed_point_hash_pin
      }
    },
    target_model: rust_target_model(),
    runtime_model: v2_evaluator_runtime()
  }
}

fn bootstrap_footprint_bad_content_hash_violates() -> Bool {
  let bad_inputs = bootstrap_footprint_anchor_bad_content_hash_projection_inputs()
  match bootstrap_footprint(inputs: bad_inputs) {
    Holds { value: _ } => false
    Violates { diagnostic: d } => d.reason == ^bootstrap_footprint_not_realized
  }
}

fn bootstrap_footprint_anchor_bad_runtime_boundary() -> ResourceEffectBoundary {
  ResourceEffectBoundary {
    ffi: v2_eval_boundary_allowance(allowed: true),
    exceptions: v2_eval_boundary_allowance(allowed: false),
    async: v2_eval_boundary_allowance(allowed: false),
    concurrency: v2_eval_boundary_allowance(allowed: false),
    identity_reference: v2_eval_boundary_allowance(allowed: false)
  }
}

fn bootstrap_footprint_anchor_bad_runtime_model() -> V4EvaluatorRuntime {
  V4EvaluatorRuntime {
    runtime_identity: ^v2_evaluator_runtime_id,
    core: v2_evaluator_model_core(),
    values: v2_evaluator_value_representation(),
    execution: v2_evaluator_execution(),
    boundary: bootstrap_footprint_anchor_bad_runtime_boundary()
  }
}

fn bootstrap_footprint_anchor_bad_runtime_projection_inputs() -> BootstrapProjectionInputs {
  BootstrapProjectionInputs {
    snapshot: BootstrapSourceSnapshot {
      root: bootstrap_source_snapshot_root(),
      language_model: seed_capability_language_model(),
      content_hash: BootstrapHashPin {
        digest: pinned_v4_fixed_point_hash,
        pin: ^pinned_v4_fixed_point_hash_pin
      }
    },
    target_model: rust_target_model(),
    runtime_model: bootstrap_footprint_anchor_bad_runtime_model()
  }
}

fn bootstrap_footprint_bad_runtime_same_identity_violates() -> Bool {
  let bad_runtime = bootstrap_footprint_anchor_bad_runtime_model()
  let canonical_runtime = v2_evaluator_runtime()
  (bad_runtime.runtime_identity == canonical_runtime.runtime_identity)
    && (bad_runtime != canonical_runtime)
    && (match bootstrap_footprint(inputs: bootstrap_footprint_anchor_bad_runtime_projection_inputs()) {
      Holds { value: _ } => false
      Violates { diagnostic: d } => d.reason == ^bootstrap_footprint_not_realized
    })
}

data claim_bootstrap_footprint_canonical_holds: TestClaim = CompilesClaim {
  label: "T-20 bootstrap_footprint: canonical projection inputs return Holds with closure_hash",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: bootstrap_footprint_anchor_claim_input(ok: bootstrap_footprint_canonical_holds()),
  expected_value: bootstrap_footprint_anchor_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_bootstrap_footprint_non_canonical_violates: TestClaim = CompilesClaim {
  label: "T-20 bootstrap_footprint: non-canonical projection inputs fail closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: bootstrap_footprint_anchor_claim_input(ok: bootstrap_footprint_non_canonical_violates()),
  expected_value: bootstrap_footprint_anchor_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_bootstrap_footprint_bad_content_hash_violates: TestClaim = CompilesClaim {
  label: "T-20 bootstrap_footprint: mismatched snapshot content_hash fails closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: bootstrap_footprint_anchor_claim_input(ok: bootstrap_footprint_bad_content_hash_violates()),
  expected_value: bootstrap_footprint_anchor_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_bootstrap_footprint_bad_runtime_violates: TestClaim = CompilesClaim {
  label: "T-20 bootstrap_footprint: same runtime_identity with a foreign boundary fails closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: bootstrap_footprint_anchor_claim_input(ok: bootstrap_footprint_bad_runtime_same_identity_violates()),
  expected_value: bootstrap_footprint_anchor_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
