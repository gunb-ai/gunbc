module v2.test.manual.typescript_record_task_translate

import v2.compiler.emit { emit }
import v2.compiler.compile {
  CompileOutput,
  TranslateResult,
  TranslateTo,
  compile_inferred
}
import v2.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  run_test_claim_assert,
  test_claim_cache_receipt,
  test_claim_typed_input_node
}
import v2.compiler.translate { target_serialize_source_from_model }
import v2.extdeps.languages.typescript {
  ts_inhabitant_atom,
  ts_binding_spellings,
  ts_task_type_alias_source_text,
  ts_task_target_model_witness,
  ts_task_type_alias_emitted
}
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.compilers.target_model { TargetModel }
import v2.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v2.std.collection {
  Map,
  empty_map
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.node { Conj, Node, Symbol, TypeNode, content_hash }
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data typescript_record_task_emitted_root: Node = ts_task_type_alias_emitted()

fn typescript_record_task_target_model_for_emit() -> Witness<TargetModel> {
  ts_task_target_model_witness()
}

fn typescript_record_task_canonical_grounding(node: Node, algebra: Node) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn typescript_record_task_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == typescript_record_task_emitted_root {
    Holds {
      value: typescript_record_task_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_token_ty_string) {
    Holds {
      value: typescript_record_task_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_surface_record_type) {
    Holds {
      value: typescript_record_task_canonical_grounding(node: node, algebra: node)
    }
  } else if content_hash(n: node) == content_hash(n: typescript_record_task_emitted_root) {
    Holds {
      value: typescript_record_task_canonical_grounding(node: node, algebra: typescript_record_task_emitted_root)
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^typescript_record_task_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn typescript_record_task_inferred_facts_for(node: Node) -> Optional<InferredFacts> {
  match typescript_record_task_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            ))
      }
  }
}

fn typescript_record_task_facts_lookup(key: Node) -> Optional<InferredFacts> {
  typescript_record_task_inferred_facts_for(node: key)
}

data typescript_record_task_inferred_tree: InferredTree = InferredTree {
  root: typescript_record_task_emitted_root,
  facts: Map { lookup: typescript_record_task_facts_lookup }
}

fn anchor_typescript_record_task_emit_accepts() -> Outcome<Medium<String>> {
  match typescript_record_task_target_model_for_emit() {
    Holds { value: target } => emit(tree: typescript_record_task_inferred_tree, target: target)
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn anchor_typescript_record_task_compile_inferred_accepts() -> Outcome<CompileOutput> {
  match typescript_record_task_target_model_for_emit() {
    Holds { value: target } =>
      compile_inferred(
        inferred: typescript_record_task_inferred_tree,
        mode: TranslateTo { target: target }
      )
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

data typescript_record_task_emit_receipt: Outcome<Medium<String>> = anchor_typescript_record_task_emit_accepts()

data typescript_record_task_compile_inferred_receipt: Outcome<CompileOutput> = anchor_typescript_record_task_compile_inferred_accepts()

fn typescript_record_task_emit_claim_outcome() -> Outcome<Node> {
  match typescript_record_task_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      if (source.carried == ts_task_type_alias_source_text) && (d == None) {
        Accepted { value: typescript_record_task_emitted_root, diagnostics: None }
      } else {
        Rejected {
          diagnostics: diagnostics_singleton(
            d: Diagnostic {
              reason: ^typescript_record_task_emit_source_mismatch,
              at: node_locus(node: typescript_record_task_emitted_root),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn typescript_record_task_compile_inferred_claim_outcome() -> Outcome<Node> {
  match typescript_record_task_compile_inferred_receipt {
    Accepted { value: compile_result, diagnostics: d } =>
      match compile_result {
        TranslateResult { source } =>
          if (source.carried == ts_task_type_alias_source_text) && (d == None) {
            Accepted { value: typescript_record_task_emitted_root, diagnostics: None }
          } else {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: Diagnostic {
                  reason: ^typescript_record_task_compile_source_mismatch,
                  at: node_locus(node: typescript_record_task_emitted_root),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }
              )
            }
          }
        _ =>
          Rejected {
            diagnostics: diagnostics_singleton(
              d: Diagnostic {
                reason: ^typescript_record_task_compile_source_mismatch,
                at: node_locus(node: typescript_record_task_emitted_root),
                correction: Unavailable { reason: ExternalContractUnknown }
              }
            )
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

data claim_typescript_record_task_type_alias_emit_accepts: TestClaim = CompilesClaim {
  label: "manual/rust_add_emit: Task type_alias emit round-trips via derive grammar-relation row",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: typescript_record_task_emitted_root,
  expected_value: typescript_record_task_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_typescript_record_task_type_alias_compile_accepts: TestClaim = CompilesClaim {
  label: "manual/G2: compile_inferred emits canonical Task type_alias source through grammar inverse production ts_production_type_alias_decl and type_annotation family",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: typescript_record_task_emitted_root,
  expected_value: typescript_record_task_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data run_typescript_record_task_type_alias_emit_accepts: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(
    subject: TestClaimEvalSubject {
      claim: claim_typescript_record_task_type_alias_emit_accepts,
      context: typescript_record_task_emitted_root,
      tree: typescript_record_task_inferred_tree,
      input: test_claim_typed_input_node(
        evaluator_input: typescript_record_task_emitted_root,
        evaluator_pin: typescript_record_task_emitted_root
      )
    }
  ),
  verdict: run_test_claim_assert(
    claim: claim_typescript_record_task_type_alias_emit_accepts,
    actual: typescript_record_task_emit_claim_outcome(),
    at: typescript_record_task_emitted_root
  )
}
