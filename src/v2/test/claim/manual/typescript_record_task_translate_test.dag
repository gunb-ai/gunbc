module v2.test.manual.typescript_record_task_translate


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
data typescript_record_task_emitted_root: Node = ts_task_type_alias_emitted()

fn typescript_record_task_target_model_for_emit() -> Witness<v2.std.compilers.target_model.TargetModel> {
  ts_task_target_model_witness()
}

fn typescript_record_task_canonical_grounding(node: Node, algebra: Node) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn typescript_record_task_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == typescript_record_task_emitted_root {
    v2.std.witness.Holds {
      value: typescript_record_task_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_token_ty_string) {
    v2.std.witness.Holds {
      value: typescript_record_task_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_surface_record_type) {
    v2.std.witness.Holds {
      value: typescript_record_task_canonical_grounding(node: node, algebra: node)
    }
  } else if content_hash(n: node) == content_hash(n: typescript_record_task_emitted_root) {
    v2.std.witness.Holds {
      value: typescript_record_task_canonical_grounding(node: node, algebra: typescript_record_task_emitted_root)
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^typescript_record_task_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn typescript_record_task_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match typescript_record_task_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn typescript_record_task_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  typescript_record_task_inferred_facts_for(node: key)
}

data typescript_record_task_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: typescript_record_task_emitted_root,
  facts: std.types.Map { lookup: typescript_record_task_facts_lookup }
}

fn anchor_typescript_record_task_emit_accepts() -> v2.std.diagnostic.Outcome<Medium<String>> {
  match typescript_record_task_target_model_for_emit() {
    Holds { value: target } => emit(tree: typescript_record_task_inferred_tree, target: target)
    Violates { diagnostic: d } =>
      v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn anchor_typescript_record_task_compile_inferred_accepts() -> v2.std.diagnostic.Outcome<v2.compiler.compile.CompileOutput> {
  match typescript_record_task_target_model_for_emit() {
    Holds { value: target } =>
      compile_inferred(
        inferred: typescript_record_task_inferred_tree,
        mode: v2.compiler.compile.TranslateTo { target: target }
      )
    Violates { diagnostic: d } =>
      v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

data typescript_record_task_emit_receipt: Outcome<Medium<String>> = anchor_typescript_record_task_emit_accepts()

data typescript_record_task_compile_inferred_receipt: Outcome<v2.compiler.compile.CompileOutput> = anchor_typescript_record_task_compile_inferred_accepts()
test fn typescript_record_task_emit_receipt_decided() -> Bool {
  match typescript_record_task_emit_receipt {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}
test fn typescript_record_task_compile_inferred_receipt_decided() -> Bool {
  match typescript_record_task_compile_inferred_receipt {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}


