module v2.test.claim.manual.medium_node_instantiation

import v2.std.node { node_same_occurrence }
import std.live_tree { LiveTreeDisposition }
import v2.extdeps.runtimes.v2_evaluator { v2_eval_bool_literal_pin }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn medium_node_lossless() -> Medium<Node> {
  Medium { carried: v2_eval_bool_literal_pin, fidelity: Lossless }
}

test fn medium_node_carried_is_expected() -> Bool {
  node_same_occurrence(a: medium_node_lossless().carried, b: v2_eval_bool_literal_pin)
}

test fn medium_node_fidelity_is_lossless() -> Bool {
  match medium_node_lossless().fidelity {
    Lossless => true
    Lossy => false
  }
}

test fn medium_node_lossy_tag_not_lossless() -> Bool {
  match (Medium { carried: v2_eval_bool_literal_pin, fidelity: Lossy }).fidelity {
    Lossless => false
    Lossy => true
  }
}

