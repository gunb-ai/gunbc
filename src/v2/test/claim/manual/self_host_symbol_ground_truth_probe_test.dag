module v2.test.manual.self_host_symbol_ground_truth_probe

import v2.test.manual.self_host_module_emit_derisk {
  derisk_infer_outcome_for,
  src_fn_simple_body,
  src_type_decl
}
import v2.compiler.program_partition {
  PartitionUserSemanticType,
  partition_user_semantic_types_from_root
}
import v2.compiler.infer { InferredTree }
import std.algebra { Cons, Empty }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Edge, Node, Symbol, TypeNode }
import v2.std.text { String }
import v2.std.collection { Absent, Optional, Present }

fn node_contains_atom_identity(node: Node, sym: Symbol) -> Bool {
  let here = match node.kind {
    TypeNode { connective: Atom { identity: id } } => id == sym
    _ => false
  }
  if here {
    true
  } else {
    fold(node.children, init: false, f: fn(acc, edge) {
      match edge {
        Edge { label: _, target: t } => acc || node_contains_atom_identity(node: t, sym: sym)
      }
    })
  }
}

fn first_decl_name(tree: InferredTree) -> Optional<Symbol> {
  match partition_user_semantic_types_from_root(root: tree.root) {
    Cons { head: d, tail: _ } =>
      match d {
        PartitionUserSemanticType { name: n, semantic: _ } => Present { value: n }
      }
    Empty => Absent
  }
}

fn probe_decl_name_appears_as_atom_in_tree(src: String) -> Bool {
  match derisk_infer_outcome_for(src: src) {
    Accepted { value: tree, diagnostics: _ } =>
      match first_decl_name(tree: tree) {
        Present { value: name } => node_contains_atom_identity(node: tree.root, sym: name)
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn probe_fn_decl_name_appears_as_atom() -> Bool {
  probe_decl_name_appears_as_atom_in_tree(src: src_fn_simple_body)
}

test fn probe_type_decl_name_appears_as_atom() -> Bool {
  probe_decl_name_appears_as_atom_in_tree(src: src_type_decl)
}

fn probe_tree_contains(src: String, sym: Symbol) -> Bool {
  match derisk_infer_outcome_for(src: src) {
    Accepted { value: tree, diagnostics: _ } => node_contains_atom_identity(node: tree.root, sym: sym)
    Rejected { diagnostics: _ } => false
  }
}

test fn probe_fn_tree_has_On() -> Bool { probe_tree_contains(src: src_fn_simple_body, sym: ^On) }
test fn probe_fn_tree_has_Off() -> Bool { probe_tree_contains(src: src_fn_simple_body, sym: ^Off) }
test fn probe_fn_tree_has_Flag() -> Bool { probe_tree_contains(src: src_fn_simple_body, sym: ^Flag) }
test fn probe_fn_tree_has_keep() -> Bool { probe_tree_contains(src: src_fn_simple_body, sym: ^keep) }

fn first_decl_semantic(tree: InferredTree) -> Optional<Node> {
  match partition_user_semantic_types_from_root(root: tree.root) {
    Cons { head: d, tail: _ } =>
      match d { PartitionUserSemanticType { name: _, semantic: s } => Present { value: s } }
    Empty => Absent
  }
}

fn probe_semantic_contains(src: String, sym: Symbol) -> Bool {
  match derisk_infer_outcome_for(src: src) {
    Accepted { value: tree, diagnostics: _ } =>
      match first_decl_semantic(tree: tree) {
        Present { value: s } => node_contains_atom_identity(node: s, sym: sym)
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn probe_semantic_has_Flag() -> Bool { probe_semantic_contains(src: src_fn_simple_body, sym: ^Flag) }
test fn probe_semantic_has_On() -> Bool { probe_semantic_contains(src: src_fn_simple_body, sym: ^On) }
