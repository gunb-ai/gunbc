module v2.test.manual.fold_node_topdown


fn topdown_leaf() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^topdown_leaf_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn topdown_one_child_tree() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge { label: Named { name: ^topdown_child_a }, target: topdown_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn topdown_two_level_chain() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge { label: Named { name: ^topdown_chain_child }, target: topdown_one_child_tree() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn depth_max_algebra() -> v2.std.node.NodeFoldTopDown<Int, Int> {
  v2.std.node.NodeFoldTopDown {
    init: fn(_, depth) { depth },
    child_context: fn(_, depth, _) { depth + 1 },
    step: fn(acc, _, child_r) { if child_r > acc { child_r } else { acc } }
  }
}

data witness_leaf_returns_init: Bool = fold_node_topdown(n: topdown_leaf(), ctx: 0, algebra: depth_max_algebra()) == 0
data witness_one_child_max_depth_is_one: Bool = fold_node_topdown(n: topdown_one_child_tree(), ctx: 0, algebra: depth_max_algebra()) == 1
data witness_two_level_chain_max_depth_is_two: Bool = fold_node_topdown(n: topdown_two_level_chain(), ctx: 0, algebra: depth_max_algebra()) == 2

fn depth_edge_dispatch_algebra() -> v2.std.node.NodeFoldTopDown<Int, Int> {
  v2.std.node.NodeFoldTopDown {
    init: fn(_, depth) { depth },
    child_context: fn(_, depth, e) {
      match e.label {
        Named { name: lbl } =>
          if lbl == ^topdown_right_child { depth + 2 } else { depth + 1 }
        Positional => depth + 1
      }
    },
    step: fn(acc, _, child_r) { if child_r > acc { child_r } else { acc } }
  }
}

fn topdown_edge_dispatch_root() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge { label: Named { name: ^topdown_left_child }, target: topdown_leaf() },
      v2.std.node.Edge { label: Named { name: ^topdown_right_child }, target: topdown_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}
data witness_child_context_dispatches_on_edge: Bool = fold_node_topdown(n: topdown_edge_dispatch_root(), ctx: 0, algebra: depth_edge_dispatch_algebra()) == 2

fn topdown_ok_node(ok: Bool) -> Node {
  if ok { topdown_leaf() } else { topdown_one_child_tree() }
}

fn topdown_expected() -> Node {
  topdown_leaf()
}

data claim_fold_node_topdown_compiles: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/fold_node_topdown: module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: topdown_leaf(),
  expected_value: topdown_leaf(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_fold_node_topdown_leaf_returns_init: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/fold_node_topdown: leaf returns init(leaf, ctx)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: topdown_ok_node(ok: witness_leaf_returns_init),
  expected_value: topdown_expected(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_fold_node_topdown_one_child_depth: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/fold_node_topdown: one-child tree max depth is 1",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: topdown_ok_node(ok: witness_one_child_max_depth_is_one),
  expected_value: topdown_expected(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_fold_node_topdown_chain_depth: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/fold_node_topdown: two-level chain max depth is 2",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: topdown_ok_node(ok: witness_two_level_chain_max_depth_is_two),
  expected_value: topdown_expected(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_fold_node_topdown_edge_dispatch: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/fold_node_topdown: child_context dispatches on edge not ordinal",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: topdown_ok_node(ok: witness_child_context_dispatches_on_edge),
  expected_value: topdown_expected(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
