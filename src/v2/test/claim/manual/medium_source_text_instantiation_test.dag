module v2.test.manual.medium_source_text_instantiation

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data medium_source_fixture_text: String = "module medium.source\nfn add(x:Int, y:Int) -> Int { x + y }"

fn medium_source_lossless() -> Medium<String> {
  lossless_source(text: medium_source_fixture_text)
}

fn medium_source_read_witness() -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: medium_source_lossless(),
    artifact: Artifact {
      kind: SourceFile,
      id: ^medium_source_fixture_artifact,
      file_path: "src/v2/test/claim/manual/medium_source_text_instantiation_test.dag"
    },
    compilation_unit: ^medium_source_fixture_compilation_unit,
    source_root: V2Tree
  }
}

test fn medium_source_carried_matches_fixture() -> Bool {
  let m = medium_source_lossless()
  m.carried == medium_source_fixture_text
}

test fn medium_source_fidelity_is_lossless() -> Bool {
  match medium_source_lossless().fidelity {
    Lossless => true
    Lossy => false
  }
}

test fn witness_source_field_is_medium() -> Bool {
  match medium_source_read_witness().source.fidelity {
    Lossless => medium_source_read_witness().source.carried == medium_source_fixture_text
    Lossy => false
  }
}

