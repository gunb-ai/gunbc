module v2.test.manual.infer_algebra_ref_grounding_anchor

fn anchor_atom_node(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn anchor_conj_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn anchor_computation_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Value },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data algebra_ref_bare_atom_is_ungrounded: Bool = !algebra_ref_is_grounded(algebra: anchor_atom_node(s: ^anchor_algebra_ungrounded_sym))

data algebra_ref_conj_is_grounded: Bool = algebra_ref_is_grounded(algebra: anchor_conj_node())

data algebra_ref_computation_node_is_ungrounded: Bool = !algebra_ref_is_grounded(algebra: anchor_computation_node())

fn anchor_inferred_facts_bare_atom_algebra() -> v2.compiler.infer.InferredFacts {
  v2.compiler.infer.InferredFacts {
    grounding: v2.compiler.infer.DerivedGrounding {
      grounding: v2.std.constraints.CanonicalGrounding {
        node: anchor_atom_node(s: ^anchor_resolved_type_sym),
        witness: v2.std.constraints.CanonicalGroundingWitness {
          structural: v2.std.witness.StructuralPropertyWitness {
            property: ^constraint_property_being_canonical,
            evidence: anchor_atom_node(s: ^anchor_algebra_ungrounded_sym)
          },
          closedness: v2.std.witness.StructuralPropertyWitness {
            property: ^constraint_property_candidate_set_closedness,
            evidence: anchor_atom_node(s: ^anchor_resolved_type_sym)
          }
        }
      }
    },
    descent: Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingDimension { measured: ^anchor_descent_dim_sym }
      }
    }
  }
}

data anchor_canonical_grounding_rejects_bare_atom: Outcome<v2.std.constraints.CanonicalGrounding> = canonical_grounding_from_inferred_facts(node: anchor_atom_node(s: ^anchor_resolved_type_sym), facts: anchor_inferred_facts_bare_atom_algebra())
