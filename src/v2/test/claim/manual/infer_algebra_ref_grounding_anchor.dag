module v2.test.manual.infer_algebra_ref_grounding_anchor
import v2.std.optional { optional_absent }

import v2.std.witness { Holds, Violates, Witness }
import v2.compiler.infer { algebra_ref_is_grounded, canonical_grounding_from_inferred_facts }

fn anchor_atom_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn anchor_conj_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn anchor_disj_node() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn anchor_arrow_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn anchor_cardinality_node() -> Node {
  Node {
    kind: TypeNode { connective: Cardinality },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn anchor_instantiation_node() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn anchor_computation_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Value },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

data algebra_ref_bare_atom_is_ungrounded: Bool = !algebra_ref_is_grounded(algebra: anchor_atom_node(s: ^anchor_algebra_ungrounded_sym))

data algebra_ref_conj_is_grounded: Bool = algebra_ref_is_grounded(algebra: anchor_conj_node())

data algebra_ref_computation_node_is_ungrounded: Bool = !algebra_ref_is_grounded(algebra: anchor_computation_node())

fn anchor_inferred_facts_bare_atom_algebra() -> InferredFacts {
  InferredFacts {
    grounding: DerivedGrounding {
      grounding: CanonicalGrounding {
        node: anchor_atom_node(s: ^anchor_resolved_type_sym),
        witness: CanonicalGroundingWitness {
          structural: StructuralPropertyWitness {
            property: ^constraint_property_being_canonical,
            evidence: anchor_atom_node(s: ^anchor_algebra_ungrounded_sym)
          },
          closedness: StructuralPropertyWitness {
            property: ^constraint_property_candidate_set_closedness,
            evidence: anchor_atom_node(s: ^anchor_resolved_type_sym)
          }
        }
      }
    },
    descent: Holds {
      value: v2.std.cardinality.TerminationProof {
        non_increasing: [],
        strict: v2.std.cardinality.RankingComponent { measured: ^anchor_descent_dim_sym }
      }
    },
    denotation: optional_absent()
  }
}

data anchor_canonical_grounding_rejects_bare_atom: Outcome<CanonicalGrounding> = canonical_grounding_from_inferred_facts(node: anchor_atom_node(s: ^anchor_resolved_type_sym), facts: anchor_inferred_facts_bare_atom_algebra())

// EVERY CONNECTIVE SAYS WHETHER IT NEEDS A MINTED AUTHORITY, by name. The five structure
// connectives need none at their own node (a bare Atom alone answers to a mint); each is pinned
// here so the grounding gate's enumeration cannot drift silently, and a connective added later
// has to state its grounding at the gate instead of inheriting one.
test fn anchor_structural_connectives_are_grounded_by_name() -> Bool {
  algebra_ref_is_grounded(algebra: anchor_conj_node())
    && algebra_ref_is_grounded(algebra: anchor_disj_node())
    && algebra_ref_is_grounded(algebra: anchor_arrow_node())
    && algebra_ref_is_grounded(algebra: anchor_cardinality_node())
    && algebra_ref_is_grounded(algebra: anchor_instantiation_node())
}
