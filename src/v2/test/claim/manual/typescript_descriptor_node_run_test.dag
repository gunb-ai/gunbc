module v2.test.manual.typescript_descriptor_node_run

import v2.compiler.eval {
  Inputs,
  inputs_for_emit_host,
}
import v2.compiler.emit_host {
  emit_host_exit_not_ok_diagnostic,
  run_emit_host,
  runtime_value_parse,
  runtime_value_signed_i32_le_as_int
}
import v2.extdeps.languages.typescript { ts_target_model }
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  diagnostics_singleton
}
import v2.std.host_run { HostLogicalRun }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.compilers.target_model { TargetModel }
import v2.std.text { String }
import v2.test.manual.add_body_emit_typescript {
  add_body_ts_emit_from_producer_tree,
  add_body_ts_target_model_minus_catalog
}
import v2.test.manual.connective_anchors { stub_empty_conj }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn typescript_descriptor_node_emit_host_fixture_inputs() -> Inputs {
  inputs_for_emit_host(
    claim_input_root: stub_empty_conj,
    expected_eval_root: stub_empty_conj,
    claim_pin: ^typescript_descriptor_node_claim_pin
  )
}

fn typescript_descriptor_node_host_run_i32(target: TargetModel, source: Medium<String>) -> Outcome<Int> {
  match run_emit_host(
    target: target,
    source: source,
    fixture_inputs: typescript_descriptor_node_emit_host_fixture_inputs()
  ) {
    Accepted { value: receipt, diagnostics: None } =>
      match receipt.logical_run {
        Accepted { value: HostLogicalRun { stdout: stdout }, diagnostics: None } =>
          match runtime_value_parse(target: target, stdout: stdout) {
            Accepted { value: rv, diagnostics: None } =>
              runtime_value_signed_i32_le_as_int(value: rv)
            Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
          }
        _ =>
          Rejected {
            diagnostics: diagnostics_singleton(d: emit_host_exit_not_ok_diagnostic())
          }
      }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}

fn typescript_descriptor_node_ts_node_run_add_holds() -> Bool {
  match add_body_ts_emit_from_producer_tree(target: ts_target_model()) {
    Accepted { value: source, diagnostics: None } =>
      match typescript_descriptor_node_host_run_i32(target: ts_target_model(), source: source) {
        Accepted { value: n, diagnostics: None } => n == 5
        _ => false
      }
    _ => false
  }
}

fn typescript_descriptor_node_ts_node_run_catalog_minus_discriminates() -> Bool {
  match add_body_ts_emit_from_producer_tree(target: add_body_ts_target_model_minus_catalog()) {
    Accepted { value: source, diagnostics: None } =>
      match typescript_descriptor_node_host_run_i32(
        target: add_body_ts_target_model_minus_catalog(),
        source: source
      ) {
        Accepted { value: n, diagnostics: None } => n == -1
        _ => false
      }
    _ => false
  }
}

data typescript_descriptor_node_ts_node_run_add_holds_symbol: Symbol = typescript_descriptor_node_ts_node_run_add_holds
data typescript_descriptor_node_ts_node_run_catalog_minus_discriminates_symbol: Symbol = typescript_descriptor_node_ts_node_run_catalog_minus_discriminates

