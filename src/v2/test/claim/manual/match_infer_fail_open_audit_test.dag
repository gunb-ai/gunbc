import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn diagnostics_contain_reason(d: Diagnostics, reason: Symbol) -> Bool {
  match d {
    None => false
    Some { diagnostics: nes } => non_empty_diagnostics_contain_reason(nes: nes, reason: reason)
  }
}

fn non_empty_diagnostics_contain_reason(nes: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  if nes.head.reason == reason {
    true
  } else {
    fold_list(
      xs: nes.tail,
      empty: false,
      cons: fn(acc, diag) {
        acc || diag.reason == reason
      }
    )
  }
}

fn match_infer_fail_open_audit_body() -> Node {
  dag_match_body_from_arms(
    scrutinee: dag_type_atom_node(identity: ^dag_token_kw_true),
    true_arm: dag_match_arm_node(
      pattern_lit: ^dag_token_kw_true,
      body_lit: ^dag_pick_lit_one
    ),
    false_arm: dag_match_arm_node(
      pattern_lit: ^dag_token_kw_false,
      body_lit: ^dag_token_ident
    )
  )
}

test fn match_infer_fail_open_audit_rejects_holds() -> Bool {
  match infer(tree: match_infer_fail_open_audit_body()) {
    Accepted { value: _, diagnostics: d } => false
    Rejected { diagnostics: _ } => true
  }
}

fn match_infer_fail_open_audit_non_exhaustive_body() -> Node {
  Node {
    kind: ComputationNode { behavior: Match },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_token_kw_true)
      },
      Edge {
        label: Positional,
        target: dag_match_arm_node(
          pattern_lit: ^dag_token_kw_true,
          body_lit: ^dag_pick_lit_one
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

test fn match_infer_fail_open_audit_non_exhaustive_rejects_holds() -> Bool {
  match infer(tree: match_infer_fail_open_audit_non_exhaustive_body()) {
