data match_infer_fail_open_audit_literal_arm_note: String = "literal_arm_accepts (dag_match_if_body_fixture → Accepted/None) was a never-enrolled plain fn on main; umbrella dissolution promoted it to test fn and CI returned Bool(false) (run 30223338595). Deleted rather than if-false/Symbol-pin (review 43557). Dissolve-on: re-land as test fn when infer(dag_match_if_body_fixture) is Accepted with empty diagnostics on CI hardware."

fn classical_not_int_match_arrow_fixture() -> v2.std.node.Node {
  dag_arrow_with_body_node(
    domain: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [
        v2.std.node.Edge {
          label: v2.std.node.Named { name: ^dag_binding_param_x },
          target: dag_type_atom_node(identity: ^dag_binding_type_int)
        }
      ],
      occurrence_id: SyntheticOccurrence
    },
    return_type_binding: ^dag_binding_type_int,
    body: dag_match_body_from_arms(
      scrutinee: dag_type_atom_node(identity: ^dag_binding_param_x),
      true_arm: dag_match_arm_node(
        pattern_lit: ^dag_token_kw_true,
        body_lit: ^dag_token_kw_false
      ),
      false_arm: dag_match_arm_node(
        pattern_lit: ^dag_token_kw_false,
        body_lit: ^dag_token_kw_true
      )
    )
  )
}

