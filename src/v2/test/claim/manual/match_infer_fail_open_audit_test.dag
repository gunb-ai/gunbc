test fn classical_not_int_match_arrow_real_infer_holds() -> Bool {
  match infer(tree: classical_not_int_match_arrow_fixture()) {
    Accepted { value: _, diagnostics: d } =>
      diagnostics_contain_reason(
        d: d,
        reason: ^infer_match_int_scrutinee_bool_literal_scaffold
      )
    Rejected { diagnostics: _ } => false
  }
}

