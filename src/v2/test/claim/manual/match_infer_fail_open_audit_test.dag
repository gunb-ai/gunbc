module v2.test.manual.match_infer_fail_open_audit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn diagnostics_contain_reason(d: v2.std.diagnostic.Diagnostics, reason: v2.std.node.Symbol) -> v2.std.logic.Bool {
  match d {
    None => false
    Some { diagnostics: nes } => v2.test.manual.match_infer_fail_open_audit.non_empty_diagnostics_contain_reason(nes: nes, reason: reason)
  }
}

fn non_empty_diagnostics_contain_reason(nes: v2.std.diagnostic.NonEmptyDiagnostics, reason: v2.std.node.Symbol) -> v2.std.logic.Bool {
  if nes.head.reason == reason {
    true
  } else {
    fold_list(
      xs: nes.tail,
      empty: false,
      cons: fn(acc, diag) {
        acc || diag.reason == reason
      }
    )
  }
}

fn match_infer_fail_open_audit_body() -> v2.std.node.Node {
  dag_match_body_from_arms(
    scrutinee: dag_type_atom_node(identity: ^dag_token_kw_true),
    true_arm: dag_match_arm_node(
      pattern_lit: ^dag_token_kw_true,
      body_lit: ^dag_pick_lit_one
    ),
    false_arm: dag_match_arm_node(
      pattern_lit: ^dag_token_kw_false,
      body_lit: ^dag_token_ident
    )
  )
}

test fn match_infer_fail_open_audit_rejects_holds() -> v2.std.logic.Bool {
  match infer(tree: match_infer_fail_open_audit_body()) {
    Accepted { value: _, diagnostics: d } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

fn match_infer_fail_open_audit_non_exhaustive_body() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Match },
    children: [
      v2.std.node.Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_token_kw_true)
      },
      v2.std.node.Edge {
        label: Positional,
        target: dag_match_arm_node(
          pattern_lit: ^dag_token_kw_true,
          body_lit: ^dag_pick_lit_one
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

test fn match_infer_fail_open_audit_non_exhaustive_rejects_holds() -> v2.std.logic.Bool {
  match infer(tree: match_infer_fail_open_audit_non_exhaustive_body()) {
    Accepted { value: _, diagnostics: d } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
