module v2.test.manual.match_infer_fail_open_audit

import v2.compiler.infer { infer }
import v2.extdeps.languages.dag {
  dag_arrow_with_body_node,
  dag_complement_arrow_with_body_fixture,
  dag_complement_body_fixture,
  dag_match_arm_node,
  dag_match_body_from_arms,
  dag_match_if_body_fixture,
  dag_type_atom_node
}
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  ComputationNode,
  Edge,
  Match,
  Named,
  Node,
  Positional,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

fn match_infer_fail_open_audit_body() -> Node {
  dag_match_body_from_arms(
    scrutinee: dag_type_atom_node(identity: ^dag_token_kw_true),
    true_arm: dag_match_arm_node(
      pattern_lit: ^dag_token_kw_true,
      body_lit: ^dag_pick_lit_one
    ),
    false_arm: dag_match_arm_node(
      pattern_lit: ^dag_token_kw_false,
      body_lit: ^dag_token_ident
    )
  )
}

test fn match_infer_fail_open_audit_rejects_holds() -> Bool {
  match infer(tree: match_infer_fail_open_audit_body()) {
    Accepted { value: _, diagnostics: d } => false
    Rejected { diagnostics: _ } => true
  }
}

fn match_infer_fail_open_audit_non_exhaustive_body() -> Node {
  Node {
    kind: ComputationNode { behavior: Match },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_token_kw_true)
      },
      Edge {
        label: Positional,
        target: dag_match_arm_node(
          pattern_lit: ^dag_token_kw_true,
          body_lit: ^dag_pick_lit_one
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

test fn match_infer_fail_open_audit_non_exhaustive_rejects_holds() -> Bool {
  match infer(tree: match_infer_fail_open_audit_non_exhaustive_body()) {
    Accepted { value: _, diagnostics: d } => false
    Rejected { diagnostics: _ } => true
  }
}

fn match_infer_fail_open_audit_extra_arm_body() -> Node {
  Node {
    kind: ComputationNode { behavior: Match },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_token_kw_true)
      },
      Edge {
        label: Positional,
        target: dag_match_arm_node(
          pattern_lit: ^dag_token_kw_true,
          body_lit: ^dag_pick_lit_one
        )
      },
      Edge {
        label: Positional,
        target: dag_match_arm_node(
          pattern_lit: ^dag_token_kw_false,
          body_lit: ^dag_pick_lit_one
        )
      },
      Edge {
        label: Positional,
        target: dag_match_arm_node(
          pattern_lit: ^dag_token_kw_true,
          body_lit: ^dag_pick_lit_two
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

test fn match_infer_fail_open_audit_extra_arm_rejects_holds() -> Bool {
  match infer(tree: match_infer_fail_open_audit_extra_arm_body()) {
    Accepted { value: _, diagnostics: d } => false
    Rejected { diagnostics: _ } => true
  }
}

fn match_infer_fail_open_audit_literal_arm_accepts_holds() -> Bool {
  match infer(tree: dag_match_if_body_fixture) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn classical_not_int_match_arrow_fixture() -> Node {
  dag_arrow_with_body_node(
    domain: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge {
          label: Named { name: ^dag_binding_param_x },
          target: dag_type_atom_node(identity: ^dag_binding_type_int)
        }
      ],
      occurrence_id: SyntheticOccurrence
    },
    return_type_binding: ^dag_binding_type_int,
    body: dag_match_body_from_arms(
      scrutinee: dag_type_atom_node(identity: ^dag_binding_param_x),
      true_arm: dag_match_arm_node(
        pattern_lit: ^dag_token_kw_true,
        body_lit: ^dag_token_kw_false
      ),
      false_arm: dag_match_arm_node(
        pattern_lit: ^dag_token_kw_false,
        body_lit: ^dag_token_kw_true
      )
    )
  )
}

