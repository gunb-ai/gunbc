module v2.test.manual.python_grammar_claim


fn python_claim_bool_atom(b: Bool) -> v2.std.node.Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^python_claim_bool_true } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^python_claim_bool_false } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
  }
}

fn python_grammar_validates_fixture() -> Bool {
  let at = v2.std.diagnostic.port_locus(port: ^parse_stage_locus_port)
  match v2.compiler.parse.grammar_validate_for_parse(root: v2.extdeps.languages.python.python_grammar_root(), at: at) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn python_grammar_parse_accepts() -> Bool {
  match python_grammar_parse_fixture() {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn python_grammar_parse_fixture() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let at = v2.std.diagnostic.port_locus(port: ^parse_stage_locus_port)
  match v2.compiler.tokenize.tokenize(
    text: v2.extdeps.languages.python.python_source_text,
    file: ^python_parse_fixture_file,
    rules: v2.extdeps.languages.python.python_lex()
  ) {
    v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    v2.std.diagnostic.Accepted { value: stream, diagnostics: _ } =>
      match v2.compiler.parse.grammar_validate_for_parse(root: v2.extdeps.languages.python.python_grammar_root(), at: at) {
        v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
        v2.std.diagnostic.Accepted { value: validated, diagnostics: _ } =>
          v2.compiler.parse.parse_production_tree(
            tokens: v2.std.compilers.lexing.token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^python_production_fn_add
          )
      }
  }
}

data claim_python_grammar_validates: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "v2.extdeps.languages.python.python_grammar_root validates: its single Choice FIRST overlap is non-nullable, accepted as counted residue (overlap-residue split 2026-07-06)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_grammar_validates_fixture()),
  rhs: python_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}

data claim_python_grammar_parses_tokens: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "python parses end-to-end: non-nullable overlap routed to parse_choice_residue_backtrack at runtime",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_grammar_parse_accepts()),
  rhs: python_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}
