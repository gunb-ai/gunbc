module v2.test.manual.python_grammar_claim


fn python_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^python_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^python_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn python_grammar_validates_fixture() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: python_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn python_grammar_parse_accepts() -> Bool {
  match python_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn python_grammar_parse_fixture() -> Outcome<ParseTree> {
  let at = port_locus(port: ^parse_stage_locus_port)
  match tokenize(
    text: python_source_text,
    file: ^python_parse_fixture_file,
    rules: python_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar_validate_for_parse(root: python_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          parse_production_tree(
            tokens: token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^python_production_fn_add
          )
      }
  }
}

data claim_python_grammar_validates: TestClaim = EqualsClaim {
  label: "python_grammar_root validates: its single Choice FIRST overlap is non-nullable, accepted as counted residue (overlap-residue split 2026-07-06)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_grammar_validates_fixture()),
  rhs: python_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_python_grammar_parses_tokens: TestClaim = EqualsClaim {
  label: "python parses end-to-end: non-nullable overlap routed to parse_choice_residue_backtrack at runtime",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_grammar_parse_accepts()),
  rhs: python_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
