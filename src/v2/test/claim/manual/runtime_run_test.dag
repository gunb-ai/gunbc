module v2.test.manual.runtime_run


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data runtime_run_node_a: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^runtime_run_node_a_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data runtime_run_node_b: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^runtime_run_node_b_symbol } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data runtime_run_nodes: List<v2.std.node.Node> = [runtime_run_node_a, runtime_run_node_b]
data runtime_run_dependencies: List<v2.std.dependency.DependencyView> = []

fn runtime_run_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^runtime_run_descent_dimension }
  }
}

fn runtime_run_facts_for(node: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredFacts {
  v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_unit_type_node(),
    descent: v2.std.witness.Holds { value: runtime_run_termination_proof() }
  )
}

fn runtime_run_fact_lookup(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  if node == runtime_run_node_a {
    v2.std.optional.optional_present(value: runtime_run_facts_for(node: runtime_run_node_a))
  } else if node == runtime_run_node_b {
    v2.std.optional.optional_present(value: runtime_run_facts_for(node: runtime_run_node_b))
  } else {
    v2.std.optional.optional_absent()
  }
}

fn runtime_run_test_tree() -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: runtime_run_node_a,
    facts: PartialFunction { lookup: runtime_run_fact_lookup }
  }
}

fn runtime_run_unit_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeUnit {
    value: v2.std.runtime.RuntimeUnitValue { unit_type: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_unit_type_node() }
  }
}

fn runtime_run_allocate_literal(
  _node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: runtime_run_unit_value(), diagnostics: None }
}

fn runtime_run_reject_primitive(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: v2.compiler.eval.eval_diagnostic(reason: ^runtime_run_eval_rejected, node: node)
    )
  }
}

fn runtime_run_reject_branch(
  node: v2.std.node.Node,
  _value: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: v2.compiler.eval.eval_diagnostic(reason: ^runtime_run_eval_rejected, node: node)
    )
  }
}

fn runtime_run_reject_loop(
  node: v2.std.node.Node,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(
      d: v2.compiler.eval.eval_diagnostic(reason: ^runtime_run_eval_rejected, node: node)
    )
  }
}

fn runtime_run_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: None }
}

fn runtime_run_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: runtime_run_allocate_literal, identity: ^runtime_run_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: runtime_run_reject_primitive, identity: ^runtime_run_reject_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: runtime_run_reject_branch, identity: ^runtime_run_reject_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: runtime_run_reject_loop, identity: ^runtime_run_reject_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: runtime_run_bind_value, identity: ^runtime_run_bind_value },
    match: MatchInterpreter { choose_arm: runtime_reject_match_arm, identity: ^runtime_reject_match_arm }
  }
}

fn runtime_run_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^runtime_run_allocate_literal,
    call_primitive: ^runtime_run_reject_primitive,
    choose_branch: ^runtime_run_reject_branch,
    step_loop: ^runtime_run_reject_loop,
    bind_value: ^runtime_run_bind_value,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn runtime_run_context() -> v2.compiler.eval.EvalContext {
  v2.compiler.eval.eval_context_with_semantics(
    runtime_identity: ^runtime_run_eval_runtime_id,
    interpretation: runtime_run_interpretation(),
    structure_witness: runtime_run_structure_witness()
  )
}

test fn runtime_run_step_appends_receipt_holds() -> Bool {
  let init = v2.workflow.runtime_run.RuntimeRunState { log: v2.workflow.runtime_run.runtime_run_log_empty(), scheduled: [] }
  let frontier = v2.workflow.scheduler.RunnableFrontier { ready: [runtime_run_node_a] }
  let state = v2.workflow.runtime_run.runtime_run_step_from_frontier(
    frontier: frontier,
    state: init,
    tree: runtime_run_test_tree(),
    context: runtime_run_context()
  )
  v2.std.algebra.length(xs: state.log.entries) == 1 && state.scheduled == [runtime_run_node_a]
}

test fn runtime_run_completes_both_nodes_holds() -> Bool {
  match v2.workflow.runtime_run.runtime_run(
    nodes: runtime_run_nodes,
    dependencies: runtime_run_dependencies,
    tree: runtime_run_test_tree(),
    context: runtime_run_context()
  ) {
    v2.workflow.runtime_run.RuntimeRunComplete { log: log, scheduled: scheduled } =>
      v2.std.algebra.length(xs: log.entries) == 2 && v2.std.algebra.length(xs: scheduled) == 2
    v2.workflow.runtime_run.RuntimeRunBlocked { evidence: _, log: _, scheduled: _, remaining: _ } => false
  }
}

test fn runtime_run_step_is_bounded_to_frontier_holds() -> Bool {
  let init = v2.workflow.runtime_run.RuntimeRunState { log: v2.workflow.runtime_run.runtime_run_log_empty(), scheduled: [] }
  let frontier = v2.workflow.scheduler.RunnableFrontier { ready: [runtime_run_node_a] }
  let state = v2.workflow.runtime_run.runtime_run_step_from_frontier(
    frontier: frontier,
    state: init,
    tree: runtime_run_test_tree(),
    context: runtime_run_context()
  )

  state.scheduled == [runtime_run_node_a] && v2.std.algebra.length(xs: state.log.entries) == 1
}

