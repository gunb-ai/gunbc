module v2.test.claim.manual.test_migration_debt

import std.types { List }
import v2.lens.test_migration_debt {
  retained_rust_kernel_wall_holds_live,
  retained_declared_source_files,
  discovered_rust_test_modules,
  discovered_legacy_behavior_ids,
  names_are_duplicate_free,
  list_contains_name,
  retained_module_has_a_discovered_test_among,
  module_body_has_no_skip_attribute,
  manifest_uses_default_harness,
  no_retained_module_is_skipped,
  retained_kernel_uses_default_harness,
}
import v2.std.text { String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE RETENTION WALL AGAINST THE LIVE TREE. The former ratchets asserted three
// live counts stayed under point-in-time ceilings; that shape is retired with
// the population it measured. This asserts exact two-direction identity
// equality between the discovered Rust test modules and the declared retained
// rows, so the wall cannot be satisfied by a count that merely fell.
test fn retained_rust_kernel_wall_holds_against_live_tree() -> Bool {
  return retained_rust_kernel_wall_holds_live()
}

// SYNTHETIC CONTROLS. Each plants the exact violation the wall exists to catch
// and requires refusal, so no clause can pass vacuously. They operate on
// fixture lists rather than the tree, because the tree cannot be perturbed from
// inside a witness.
fn fixture_declared() -> List<String> {
  ["alpha_test.rs", "beta_test.rs"]
}

fn fixture_discovered_with_undeclared() -> List<String> {
  ["alpha_test.rs", "beta_test.rs", "gamma_test.rs"]
}

fn fixture_discovered_missing_one() -> List<String> {
  ["alpha_test.rs"]
}

// An undeclared Rust test module appearing in the tree must red: every
// discovered module must be declared.
test fn planted_undeclared_module_refuses() -> Bool {
  return !(fixture_discovered_with_undeclared()
    |> all(f => list_contains_name(xs: fixture_declared(), needle: f)))
}

// A declared row whose module no longer exists must red as a stale row.
test fn planted_stale_retention_row_refuses() -> Bool {
  return !(fixture_declared()
    |> all(f => list_contains_name(xs: fixture_discovered_missing_one(), needle: f)))
}

// A duplicated row must red rather than silently double-counting.
test fn planted_duplicate_row_refuses() -> Bool {
  return !names_are_duplicate_free(xs: ["alpha_test.rs", "alpha_test.rs"])
}

// The clean fixture must be admitted, so the three refusals above are
// discriminating rather than blanket.
test fn clean_fixture_is_admitted() -> Bool {
  return names_are_duplicate_free(xs: fixture_declared())
    && (fixture_declared() |> all(f => list_contains_name(xs: fixture_declared(), needle: f)))
}

// A retained row pointing at a module with no discovered #[test] must red.
// Same split as module_body_has_no_skip_attribute: the production predicate takes the
// id list, the live path supplies discovered_legacy_behavior_ids, and this control
// supplies a fixture list that cannot contain the planted module.
test fn planted_module_without_tests_refuses() -> Bool {
  return !retained_module_has_a_discovered_test_among(
    source_file: "zzz_nonexistent_module_test.rs",
    ids: ["src/v1/tests/src/alpha_test.rs::t"]
  )
}

test fn planted_module_with_a_test_is_admitted() -> Bool {
  return retained_module_has_a_discovered_test_among(
    source_file: "alpha_test.rs",
    ids: ["src/v1/tests/src/alpha_test.rs::t"]
  )
}

// THE EXECUTION-WALL CONTROLS. Each plants the exact route by which a retained
// test could stay discovered and compiled while never running.
test fn planted_ignored_test_refuses() -> Bool {
  return !module_body_has_no_skip_attribute(body: "#[test]\n#[ignore]\nfn t() {}")
}

test fn planted_should_panic_test_refuses() -> Bool {
  return !module_body_has_no_skip_attribute(body: "#[test]\n#[should_panic]\nfn t() {}")
}

test fn plain_test_body_is_admitted() -> Bool {
  return module_body_has_no_skip_attribute(body: "#[test]\nfn t() { assert!(true); }")
}

test fn planted_custom_harness_refuses() -> Bool {
  return !manifest_uses_default_harness(manifest: "[[test]]\nname = \"x\"\nharness = false\n")
}

test fn planted_unspaced_custom_harness_refuses() -> Bool {
  return !manifest_uses_default_harness(manifest: "[lib]\nharness=false\n")
}

// An unreadable or absent manifest must refuse rather than read as "no custom
// harness found" — absence of evidence is not evidence of the default harness.
test fn planted_empty_manifest_refuses() -> Bool {
  return !manifest_uses_default_harness(manifest: "")
}

test fn default_harness_manifest_is_admitted() -> Bool {
  return manifest_uses_default_harness(manifest: "[package]\nname = \"x\"\n")
}

// And the same two clauses against the LIVE tree, so the controls above are not
// merely exercising a function nothing calls in production.
test fn live_retained_kernel_is_fully_executed() -> Bool {
  return no_retained_module_is_skipped() && retained_kernel_uses_default_harness()
}

// Live populations are nonempty, so an emptied tree cannot pass the equality
// above vacuously.
test fn live_populations_are_nonempty() -> Bool {
  return count(discovered_rust_test_modules()) > 0
    && count(retained_declared_source_files()) > 0
    && count(discovered_legacy_behavior_ids()) > 0
}

// OFFENDER LISTING. Plain fns, not tests: the claim runner prints a bare
// `FAIL <test>` for a false verdict and has no reason channel, so the wall
// cannot name offenders itself. These return them for `gunbc run`; the wall's
// verdict expression above is untouched.
fn offenders_undeclared(discovered: List<String>, declared: List<String>) -> List<String> {
  discovered |> filter(f => !list_contains_name(xs: declared, needle: f))
}

fn offenders_stale(discovered: List<String>, declared: List<String>) -> List<String> {
  declared |> filter(f => !list_contains_name(xs: discovered, needle: f))
}

// Live tree: discovered Rust test modules with no retained row.
fn live_modules_with_no_retained_row() -> List<String> {
  offenders_undeclared(discovered: discovered_rust_test_modules(), declared: retained_declared_source_files())
}

// Live tree: retained rows naming no discovered module.
fn live_retained_rows_with_no_module() -> List<String> {
  offenders_stale(discovered: discovered_rust_test_modules(), declared: retained_declared_source_files())
}

// Planted fixture: gamma_test.rs is the fake undeclared module.
fn planted_modules_with_no_retained_row() -> List<String> {
  offenders_undeclared(discovered: fixture_discovered_with_undeclared(), declared: fixture_declared())
}

fn planted_retained_rows_with_no_module() -> List<String> {
  offenders_stale(discovered: fixture_discovered_missing_one(), declared: fixture_declared())
}
