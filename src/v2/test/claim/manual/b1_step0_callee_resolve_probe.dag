module v2.test.manual.b1_step0_callee_resolve_probe

import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
  resolve_with_admission
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_language_model,
  qualified_name_from_module_node
}
import std.algebra { Cons, Empty }
import v2.std.collection { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.qualified_name { QualifiedName }

data b1_step0_probe_source: String = "module b1_step0_probe\n\nfn helper(x: Int) -> Int { x }\n\nfn caller() -> Int { helper(1) }\n"

fn b1_step0_normalized_module() -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(
    text: b1_step0_probe_source,
    file: ^b1_step0_probe_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => optional_absent()
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => optional_absent()
            Accepted { value: tree, diagnostics: _ } => optional_present(value: tree)
          }
      }
  }
}

fn b1_step0_module_qn(root: Node) -> Optional<QualifiedName> {
  match qualified_name_from_module_node(root: root) {
    Accepted { value: qn, diagnostics: _ } => optional_present(value: qn)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn b1_step0_same_module_callee_resolve_accepts() -> Bool {
  match b1_step0_normalized_module() {
    Absent => false
    Present { value: root } =>
      match b1_step0_module_qn(root: root) {
        Absent => false
        Present { value: module_qn } =>
          match resolve_with_admission(
            lm: dag_language_model(),
            roots: Cons { head: root, tail: Empty },
            admission: Admission {
              subject: ResolutionSubject { name: module_qn },
              imports: Empty
            }
          ) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

test fn b1_step0_normalize_probe_holds() -> Bool {
  match b1_step0_normalized_module() {
    Present { value: _ } => true
    Absent => false
  }
}

test fn b1_step0_same_module_callee_resolve_probe_holds() -> Bool {
  b1_step0_same_module_callee_resolve_accepts()
}
