module v2.test.manual.structured_body_dispatch


fn structured_body_non_behavior_node() -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^structured_body_residual } },
    children: []
  )
}

fn structured_body_pick_branch_body() -> v2.std.node.Node {
  match v2.std.node_query.find_arrow_body_child(root: v2.extdeps.languages.dag.dag_pick_arrow_with_body_fixture) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } => body
    v2.std.diagnostic.Rejected { diagnostics: _ } => structured_body_non_behavior_node()
  }
}

test fn structured_body_dispatch_accepts_transform_call() -> Bool {
  match v2.compiler.body_producer.body_producer_dispatch_structured_body(body: v2.extdeps.languages.dag.dag_add_binary_body_node()) {
    v2.std.diagnostic.Accepted { value: validated, diagnostics: _ } => validated == v2.extdeps.languages.dag.dag_add_binary_body_node()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn structured_body_dispatch_accepts_branch() -> Bool {
  let branch = structured_body_pick_branch_body()
  match v2.compiler.body_producer.body_producer_dispatch_structured_body(body: branch) {
    v2.std.diagnostic.Accepted { value: validated, diagnostics: _ } => validated == branch
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn structured_body_dispatch_rejects_non_behavior() -> Bool {
  match v2.compiler.body_producer.body_producer_dispatch_structured_body(body: structured_body_non_behavior_node()) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

test fn structured_body_produce_subsumes_add_table() -> Bool {
  match v2.compiler.body_producer.produce_arrow_with_structured_body(
    signature: v2.extdeps.languages.dag.dag_add_arrow_signature_node(),
    structured_body: v2.extdeps.languages.dag.dag_add_binary_body_node()
  ) {
    v2.std.diagnostic.Accepted { value: arrow_with_body, diagnostics: _ } =>
      arrow_with_body == v2.extdeps.languages.dag.dag_add_arrow_with_body_node()
        && v2.std.node.well_formed(n: arrow_with_body)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

