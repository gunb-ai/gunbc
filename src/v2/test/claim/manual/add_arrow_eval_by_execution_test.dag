    children: [
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_token_plus) },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_y) },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_param_x) }
    ]
  }
}

