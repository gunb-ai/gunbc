      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^dag_binding_type_int) },
      Edge { label: Named { name: ^arrow_body_edge }, target: add_arrow_eval_canonical_body() }
    ]
  }
}

