fn add_arrow_excess_actual_call(callee: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Positional, target: callee },
      Edge { label: Positional, target: add_arrow_eval_literal_two_node() },
      Edge { label: Positional, target: add_arrow_eval_literal_three_node() },
      Edge { label: Positional, target: add_arrow_eval_literal_two_node() }
    ]
  }
}

fn add_arrow_eval_run_passes(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_source_pipeline_admits_add_holds() -> Bool {
  match add_arrow_source_ingested_add_infers() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_canonical_tree_infers_holds() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match add_arrow_eval_inferred_run_tree(callee: arrow, expected: add_arrow_eval_literal_five_node()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_runtime_value_is_five(value: RuntimeValue) -> Bool {
  add_arrow_eval_arg_is_count(value: value, n: 5)
}

fn add_arrow_eval_direct_runtime_holds() -> Bool {
  match source_bridged_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => {
      let input = add_arrow_eval_add_call(callee: arrow)
      match add_arrow_eval_inferred_run_tree(callee: arrow, expected: add_arrow_eval_literal_five_node()) {
        Accepted { value: tree, diagnostics: _ } =>
          match eval(
            tree: tree,
            interpretation: add_arrow_eval_interpretation(),
            inputs: inputs_root_only(root: input)
          ) {
            Accepted { value: actual, diagnostics: None } =>
              add_arrow_eval_runtime_value_is_five(value: actual)
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_source_driven_add_executes_holds() -> Bool {
  match source_bridged_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      add_arrow_eval_run_passes(
        run: add_arrow_eval_run(
          callee: arrow,
          expected: add_arrow_eval_literal_five_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_produced_add_body_executes_holds() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      add_arrow_eval_run_passes(
        run: add_arrow_eval_run(
          callee: arrow,
          expected: add_arrow_eval_literal_five_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_swapped_operands_red_holds() -> Bool {
  add_arrow_eval_swapped_operands_claim_passes() == false
}

fn add_arrow_eval_swapped_operands_claim_passes() -> Bool {
  add_arrow_eval_run_passes(
    run: add_arrow_eval_run(
      callee: add_arrow_swapped_add_arrow(),
      expected: add_arrow_eval_literal_five_node()
    )
  )
}

fn add_arrow_excess_signature_red_holds() -> Bool {
  add_arrow_eval_run_passes(
    run: add_arrow_eval_run(
      callee: add_arrow_excess_signature_arrow(),
      expected: add_arrow_eval_literal_five_node()
    )
  ) == false
}

fn add_arrow_excess_body_red_holds() -> Bool {
  add_arrow_eval_run_passes(
    run: add_arrow_eval_run(
      callee: add_arrow_excess_body_arrow(),
      expected: add_arrow_eval_literal_five_node()
    )
  ) == false
}

fn add_arrow_excess_actual_executes_to_five() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => {
      let input = add_arrow_excess_actual_call(callee: arrow)
      match add_arrow_eval_inferred_run_tree(callee: arrow, expected: add_arrow_eval_literal_five_node()) {
        Accepted { value: tree, diagnostics: _ } =>
          match eval(
            tree: tree,
            interpretation: add_arrow_eval_interpretation(),
            inputs: inputs_root_only(root: input)
          ) {
            Accepted { value: actual, diagnostics: None } =>
              add_arrow_eval_runtime_value_is_five(value: actual)
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_excess_actual_red_holds() -> Bool {
  add_arrow_excess_actual_executes_to_five() == false
}

fn add_arrow_eval_lazy_arm_branch_suppression_holds() -> Bool {
  let branch = add_arrow_eval_lazy_arm_branch_node()
  let tree = add_arrow_eval_admitted_tree(root: branch)
  match eval(
    tree: tree,
    interpretation: add_arrow_eval_lazy_arm_interpretation(),
    inputs: inputs_root_only(root: branch)
  ) {
    Accepted { value: v, diagnostics: _ } =>
      add_arrow_eval_runtime_value_is_five(value: v)
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_step_loop_continue(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  outcome_accepted(value: Continue { value: add_arrow_eval_five_value() })
}

fn add_arrow_eval_lazy_arm_loop_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: add_arrow_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: add_arrow_eval_call_primitive },
    branch: BranchInterpreter { choose_branch: add_arrow_eval_choose_first_arm },
    loop: LoopInterpreter { step_loop: add_arrow_eval_step_loop_continue },
    bind: BindInterpreter { bind_value: add_arrow_eval_bind_value },
    match: MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn add_arrow_eval_lazy_arm_loop_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Loop },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^add_arrow_eval_unknown_arm_literal) },
      Edge {
        label: Named { name: ^loop_bound_edge },
        target: add_arrow_eval_atom(s: ^add_arrow_eval_loop_measure_literal)
      }
    ]
  }
}

fn add_arrow_eval_loop_admitted_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: fn(key) {
        match key.kind {
          ComputationNode { behavior: Loop } =>
            Holds {
              value: claim_inferred_facts_from_nodes(
                resolved: key,
                algebra: add_arrow_eval_i64_node(),
                descent: Holds {
                  value: TerminationProof {
                    non_increasing: [],
                    strict: RankingDimension {
                      measured: ^add_arrow_eval_loop_measure_literal
                    }
                  }
                }
              )
            }
          _ =>
            add_arrow_eval_facts_lookup(key: key)
        }
      }
    }
  }
}

fn add_arrow_eval_lazy_arm_loop_suppression_holds() -> Bool {
  let loop_node = add_arrow_eval_lazy_arm_loop_node()
  let tree = add_arrow_eval_loop_admitted_tree(root: loop_node)
  match eval(
    tree: tree,
    interpretation: add_arrow_eval_lazy_arm_loop_interpretation(),
    inputs: inputs_root_only(root: loop_node)
  ) {
    Accepted { value: v, diagnostics: _ } =>
      add_arrow_eval_runtime_value_is_five(value: v)
    Rejected { diagnostics: _ } => false
  }
}

test fn add_arrow_eval_by_execution_keystone_holds() -> Bool {
  add_arrow_eval_source_driven_add_executes_holds()
    && add_arrow_eval_direct_runtime_holds()
    && add_arrow_eval_source_pipeline_admits_add_holds()
    && add_arrow_eval_swapped_operands_red_holds()

    && add_arrow_excess_signature_red_holds()
    && add_arrow_excess_body_red_holds()
    && add_arrow_excess_actual_red_holds()

    && add_arrow_eval_lazy_arm_branch_suppression_holds()

    && add_arrow_eval_lazy_arm_loop_suppression_holds()
}
