fn add_arrow_eval_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn add_arrow_eval_byte() -> Byte {
  Byte { bits: [true] }
}

fn add_arrow_eval_i64_node() -> Node {
  add_arrow_eval_atom(s: ^add_arrow_eval_i64)
}

fn add_arrow_eval_int_value(bytes: List<Byte>) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: add_arrow_eval_i64_node(),
      bytes: bytes
    }
  }
}

fn add_arrow_eval_two_value() -> RuntimeValue {
  add_arrow_eval_int_value(bytes: [add_arrow_eval_byte(), add_arrow_eval_byte()])
}

fn add_arrow_eval_three_value() -> RuntimeValue {
  add_arrow_eval_int_value(bytes: [add_arrow_eval_byte(), add_arrow_eval_byte(), add_arrow_eval_byte()])
}

fn add_arrow_eval_five_value() -> RuntimeValue {
  add_arrow_eval_int_value(bytes: [
    add_arrow_eval_byte(),
    add_arrow_eval_byte(),
    add_arrow_eval_byte(),
    add_arrow_eval_byte(),
    add_arrow_eval_byte()
  ])
}

fn add_arrow_eval_literal_two_node() -> Node {
  add_arrow_eval_atom(s: ^add_arrow_eval_literal_two)
}

fn add_arrow_eval_literal_three_node() -> Node {
  add_arrow_eval_atom(s: ^add_arrow_eval_literal_three)
}

fn add_arrow_eval_literal_five_node() -> Node {
  add_arrow_eval_atom(s: ^add_arrow_eval_literal_five)
}

fn add_arrow_eval_runtime_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^add_arrow_eval_runtime_rejected,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn add_arrow_eval_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  if node == add_arrow_eval_literal_two_node() {
    outcome_accepted(value: add_arrow_eval_two_value())
  } else if node == add_arrow_eval_literal_three_node() {
    outcome_accepted(value: add_arrow_eval_three_value())
  } else if node == add_arrow_eval_literal_five_node() {
    outcome_accepted(value: add_arrow_eval_five_value())
  } else {
    outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_arg_is_count(value: RuntimeValue, n: Int) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == add_arrow_eval_i64_node()) && (count(p.bytes) == n)
    _ => false
  }
}

fn add_arrow_eval_ordered_add_args(args: List<RuntimeValue>) -> Bool {
  if count(args) == 2 {
    match first(args) {
      Present { value: left } =>
        match last(args) {
          Present { value: right } =>
            add_arrow_eval_arg_is_count(value: left, n: 2)
              && add_arrow_eval_arg_is_count(value: right, n: 3)
          Absent => false
        }
      Absent => false
    }
  } else {
    false
  }
}

fn add_arrow_eval_call_primitive(
  node: Node,
  args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  if add_arrow_eval_ordered_add_args(args: args) {
    outcome_accepted(value: add_arrow_eval_five_value())
  } else {
    outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_choose_branch(node: Node, _value: RuntimeValue, _env: EvaluationEnvironment) -> Outcome<Node> {
  outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
}

fn add_arrow_eval_choose_first_arm(node: Node, _value: RuntimeValue, _env: EvaluationEnvironment) -> Outcome<Node> {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 1) {
    Present { value: arm } => outcome_accepted(value: arm)
    Absent => outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
  }
}

fn add_arrow_eval_lazy_arm_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: add_arrow_eval_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: add_arrow_eval_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: add_arrow_eval_choose_first_arm
    },
    loop: LoopInterpreter {
      step_loop: add_arrow_eval_step_loop
    },
    bind: BindInterpreter {
      bind_value: add_arrow_eval_bind_value
    }
  }
}

fn add_arrow_eval_lazy_arm_branch_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Branch },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Positional, target: add_arrow_eval_literal_two_node() },
      Edge { label: Positional, target: add_arrow_eval_literal_five_node() },
      Edge { label: Positional, target: add_arrow_eval_atom(s: ^add_arrow_eval_unknown_arm_literal) }
    ]
  }
}

fn add_arrow_eval_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  outcome_rejected(d: add_arrow_eval_runtime_diagnostic(n: node))
}

fn add_arrow_eval_bind_value(
  key: EnvironmentBindingKey,
  value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted {
    value: EvaluationEnvironment {
      bindings: map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: None
  }
}

fn add_arrow_eval_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: add_arrow_eval_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: add_arrow_eval_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: add_arrow_eval_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: add_arrow_eval_step_loop
    },
    bind: BindInterpreter {
      bind_value: add_arrow_eval_bind_value
    }
  }
}

fn add_arrow_eval_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^add_arrow_eval_allocate_literal_sym,
    call_primitive: ^add_arrow_eval_call_primitive_sym,
    choose_branch: ^add_arrow_eval_choose_branch_sym,
    step_loop: ^add_arrow_eval_step_loop_sym,
    bind_value: ^add_arrow_eval_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn add_arrow_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^add_arrow_eval_runtime_id,
    interpretation: add_arrow_eval_interpretation(),
    structure_witness: add_arrow_eval_interpretation_structure_witness()
  )
}

fn add_arrow_source_ingested_add_infers() -> Outcome<InferredTree> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(text: dag_mvp1_source_text, file: ^add_arrow_eval_source_file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: source_bridged_add_parse_tokens(tokens: tokens.tokens),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              bind_outcome(
                o: resolve(tree: normalized, lm: lm),
                f: fn(resolved) {
                  outcome_accepted(value: add_arrow_eval_admitted_tree(root: resolved))
                }
              )
            }
          )
        }
      )
    }
  )
}

fn add_arrow_eval_tokenize_source() -> Outcome<List<Token>> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(text: dag_mvp1_source_text, file: ^add_arrow_eval_source_file, rules: lm.lex),
    f: fn(tokens) {
      outcome_accepted(value: tokens.tokens)
    }
  )
}

fn add_arrow_eval_tokenize_holds() -> Bool {
  match add_arrow_eval_tokenize_source() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_parse_holds() -> Bool {
  match add_arrow_eval_tokenize_source() {
    Accepted { value: tokens, diagnostics: _ } =>
      match source_bridged_add_parse_tokens(tokens: tokens) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_normalize_holds() -> Bool {
  match add_arrow_eval_tokenize_source() {
    Accepted { value: tokens, diagnostics: _ } =>
      match source_bridged_add_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_resolve_holds() -> Bool {
  let lm = dag_language_model_wave1()
  match add_arrow_eval_tokenize_source() {
    Accepted { value: tokens, diagnostics: _ } =>
      match source_bridged_add_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } =>
              match resolve(tree: normalized, lm: lm) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn add_arrow_eval_add_call(callee: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Positional, target: callee },
      Edge { label: Positional, target: add_arrow_eval_literal_two_node() },
      Edge { label: Positional, target: add_arrow_eval_literal_three_node() }
    ]
  }
}

fn add_arrow_eval_tree_root(call: Node, expected: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Named { name: ^add_arrow_eval_actual }, target: call },
      Edge { label: Named { name: ^add_arrow_eval_expected }, target: expected }
    ]
  }
}

fn add_arrow_eval_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Holds {
    value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: add_arrow_eval_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    )
  }
}

fn add_arrow_eval_admitted_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: add_arrow_eval_facts_lookup
    }
  }
}

fn add_arrow_eval_inferred_run_tree(callee: Node, expected: Node) -> Outcome<InferredTree> {
  let call = add_arrow_eval_add_call(callee: callee)
  let root = add_arrow_eval_tree_root(call: call, expected: expected)
  outcome_accepted(value: add_arrow_eval_admitted_tree(root: root))
}

fn add_arrow_eval_claim(input: Node, expected: Node) -> TestClaim {
  CompilesClaim {
    label: "manual/add_arrow: source-bridged add Arrow.body executes through eval callee dispatch",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}

fn add_arrow_eval_subject(tree: InferredTree, input: Node, expected: Node) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: add_arrow_eval_claim(input: input, expected: expected),
    context: add_arrow_eval_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^add_arrow_eval_add_call_pin
    )
  }
}

fn add_arrow_eval_run(callee: Node, expected: Node) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  let input = add_arrow_eval_add_call(callee: callee)
  bind_outcome(
    o: add_arrow_eval_inferred_run_tree(callee: callee, expected: expected),
    f: fn(tree) {
      outcome_accepted(
        value: run_test_claim(
          subject: add_arrow_eval_subject(tree: tree, input: input, expected: expected)
        )
      )
    }
  )
}

