module v2.test.manual.infer_self_grounding_probe

import v2.compiler.infer {
  InferredTree,
  canonical_grounding_for_node,
  infer
}
import v2.std.constraints { CanonicalGrounding }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.node {
  Arrow,
  Atom,
  Bind,
  Cardinality,
  ComputationNode,
  Conj,
  Disj,
  Instantiation,
  Node,
  Symbol,
  SyntheticOccurrence,
  Transform,
  TypeNode,
  Value
}

fn probe_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn probe_conj_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn probe_disj_node() -> Node {
  Node {
    kind: TypeNode { connective: Disj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn probe_arrow_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn probe_value_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Value },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn probe_transform_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn probe_bind_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Bind },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn probe_infer_accepts(root: Node) -> Bool {
  match infer(tree: root) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn probe_grounding_evidence_is_source(root: Node) -> Bool {
  match infer(tree: root) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match canonical_grounding_for_node(tree: tree, node: root) {
        Rejected { diagnostics: _ } => false
        Accepted { value: g, diagnostics: _ } =>
          g.witness.structural.evidence == root
      }
  }
}

fn probe_infer_accepts_value_leaf() -> Bool {
  probe_infer_accepts(root: probe_value_node())
}

fn probe_infer_accepts_transform_leaf() -> Bool {
  probe_infer_accepts(root: probe_transform_node())
}

fn probe_infer_accepts_bind_leaf() -> Bool {
  probe_infer_accepts(root: probe_bind_node())
}

fn probe_infer_accepts_conj_leaf() -> Bool {
  probe_infer_accepts(root: probe_conj_node())
}

fn probe_conj_grounding_evidence_is_source() -> Bool {
  probe_grounding_evidence_is_source(root: probe_conj_node())
}

fn probe_disj_grounding_evidence_is_source() -> Bool {
  probe_grounding_evidence_is_source(root: probe_disj_node())
}

fn probe_arrow_grounding_evidence_is_source() -> Bool {
  probe_grounding_evidence_is_source(root: probe_arrow_node())
}

fn probe_value_grounding_evidence_is_source() -> Bool {
  probe_grounding_evidence_is_source(root: probe_value_node())
}
