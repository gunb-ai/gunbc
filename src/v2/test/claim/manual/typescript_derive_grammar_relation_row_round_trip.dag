module v2.test.manual.typescript_derive_grammar_relation_row_round_trip



fn ts_grammar_relation_round_trip_pass_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ts_grammar_relation_round_trip_pass_sym } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_grammar_relation_round_trip_fail_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ts_grammar_relation_round_trip_fail_sym } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_grammar_relation_tokens_root() -> v2.std.node.Node {
  v2.std.grammar.grammar_relation_tokens_node(
    tokens: v2.extdeps.languages.typescript.ts_canonical_add_fn_tokens(),
    token_to_node: v2.extdeps.languages.typescript.ts_concrete_token_node
  )
}

fn ts_grammar_relation_row_std_node() -> v2.std.node.Node {
  v2.std.grammar.grammar_relation_row_to_node(
    row: v2.std.grammar.derive_grammar_relation_row(
      production: v2.extdeps.languages.typescript.ts_formal_production_fn_add(),
      emitted: v2.extdeps.languages.typescript.ts_emitted_add_fn_node()
    ),
    tokens: ts_grammar_relation_tokens_root()
  )
}

data ts_derive_row_node_receipt: v2.std.witness.Witness<v2.std.node.Node> = v2.std.grammar.derive_grammar_relation_row_node(
  production: v2.extdeps.languages.typescript.ts_formal_production_fn_add(),
  productions: [v2.extdeps.languages.typescript.ts_formal_production_fn_add()],
  emitted: v2.extdeps.languages.typescript.ts_emitted_add_fn_node()
)

fn ts_task_type_alias_emitted_surplus_conj_slot() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.typescript.ts_inhabitant_atom(id: ^ts_binding_task) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.typescript.ts_type_annotation_task_record_emitted() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: v2.extdeps.languages.typescript.ts_inhabitant_atom(id: ^ts_surplus_conj_slot_dummy) }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_lhs_exact_arrow_emitted_rejects() -> Bool {
  match v2.std.grammar.formal_production_for_lhs_exact(
    productions: v2.extdeps.languages.typescript.ts_task_formal_productions(),
    lhs: ^ts_production_type_alias_decl,
    child: v2.extdeps.languages.typescript.ts_emitted_add_fn_node()
  ) {
    Violates { diagnostic: d } => d.reason == ^grammar_relation_emitted_not_conj
    Holds { value: _ } => false
  }
}

fn ts_task_derive_row_surplus_conj_slot_rejects() -> Bool {
  match v2.std.grammar.formal_production_for_lhs_exact(
    productions: v2.extdeps.languages.typescript.ts_task_formal_productions(),
    lhs: ^ts_production_type_alias_decl,
    child: v2.extdeps.languages.typescript.ts_task_type_alias_emitted()
  ) {
    Holds { value: production } =>
      match v2.std.grammar.derive_grammar_relation_row_node(
        production: production,
        productions: v2.extdeps.languages.typescript.ts_task_formal_productions(),
        emitted: ts_task_type_alias_emitted_surplus_conj_slot()
      ) {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

fn ts_task_derive_row_round_trip_holds() -> Bool {
  match v2.extdeps.languages.typescript.ts_task_type_alias_relation_row_witness() {
    Holds { value: fixture_row } =>
      match v2.std.grammar.formal_production_for_lhs_exact(
        productions: v2.extdeps.languages.typescript.ts_task_formal_productions(),
        lhs: ^ts_production_type_alias_decl,
        child: v2.extdeps.languages.typescript.ts_task_type_alias_emitted()
      ) {
        Holds { value: production } =>
          match v2.std.grammar.derive_grammar_relation_row_node(
            production: production,
            productions: v2.extdeps.languages.typescript.ts_task_formal_productions(),
            emitted: v2.extdeps.languages.typescript.ts_task_type_alias_emitted()
          ) {
            Holds { value: derived_row } =>
              v2.std.node.content_hash(n: fixture_row) == v2.std.node.content_hash(n: derived_row)
            Violates { diagnostic: _ } => false
          }
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn ts_derive_grammar_relation_row_round_trip_holds() -> Bool {
  v2.std.node.content_hash(n: ts_grammar_relation_row_std_node()) ==
    v2.std.node.content_hash(n: v2.extdeps.languages.typescript.ts_grammar_relation_row_node(row: v2.extdeps.languages.typescript.ts_grammar_relation_row()))
}

fn ts_grammar_relation_round_trip_claim_input(ok: Bool) -> v2.std.node.Node {
  if ok {
    ts_grammar_relation_round_trip_pass_node()
  } else {
    ts_grammar_relation_round_trip_fail_node()
  }
}

data claim_typescript_derive_grammar_relation_row_round_trip: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "T-11 REPLAN-3: v2.std.grammar.derive_grammar_relation_row round-trips typescript formal grammar-relation row (TaskManager fixture bound)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: ts_grammar_relation_round_trip_claim_input(
    ok: ts_derive_grammar_relation_row_round_trip_holds()
  ),
  expected_value: ts_grammar_relation_round_trip_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}

data claim_typescript_derive_grammar_relation_row_arrow_emitted_rejects: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "T-11 PR-1.5b: v2.std.grammar.formal_production_for_lhs_exact rejects Arrow emitted (not v2.std.node.Conj/v2.std.node.Atom)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: ts_grammar_relation_round_trip_claim_input(
    ok: ts_lhs_exact_arrow_emitted_rejects()
  ),
  expected_value: ts_grammar_relation_round_trip_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}

fn ts_pr3_identity_derive_row_round_trip_holds() -> Bool {
  match v2.extdeps.languages.typescript.ts_pr3_identity_relation_row_witness() {
    Holds { value: eager_row } =>
      match v2.extdeps.languages.typescript.ts_eager_grammar_relation_row_witness(lhs: ^ts_production_pr3_typed_fn_decl) {
        Holds { value: rederived } =>
          v2.std.node.content_hash(n: eager_row) == v2.std.node.content_hash(n: rederived)
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

data claim_typescript_pr3_identity_derive_grammar_relation_row_round_trip: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "T-11 FINISH-LINE-B Arc 1: pr3_identity eager row v2.std.node.content_hash round-trips v2.std.grammar.derive_grammar_relation_row_node",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: ts_grammar_relation_round_trip_claim_input(
    ok: ts_pr3_identity_derive_row_round_trip_holds()
  ),
  expected_value: ts_grammar_relation_round_trip_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}

data claim_typescript_derive_grammar_relation_row_surplus_conj_rejects: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "T-11 PR-1.5b: v2.std.grammar.derive_grammar_relation_row_node rejects emitted v2.std.node.Conj with surplus positional child",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: ts_grammar_relation_round_trip_claim_input(
    ok: ts_task_derive_row_surplus_conj_slot_rejects()
  ),
  expected_value: ts_grammar_relation_round_trip_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}
