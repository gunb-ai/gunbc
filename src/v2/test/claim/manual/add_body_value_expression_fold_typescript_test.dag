module v2.test.manual.add_body_value_expression_fold_typescript

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.compiler.body_producer {
  produce_mvp1_add_arrow_with_body,
  produce_mvp1_add_arrow_with_body_swapped_operands
}
import v2.compiler.translate { translate_project_transform_in_arrow_scope }
import v2.extdeps.languages.typescript {
  ts_mvp1_add_return_body_tokens,
  ts_mvp1_binding_spellings,
  ts_mvp1_declared_inhabitants_root,
  ts_mvp1_selection_policy_node,
  ts_mvp1_serialize_source_node,
  ts_mvp1_source_text_authority,
  ts_mvp1_target_model,
  ts_mvp1_translation_rules_node,
  ts_value_expression_projection,
  ts_wave1_lex_rules
}
import v2.std.algebra { Cons, Empty, length, list_append }
import v2.std.collection { List }
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  TypeNode,
  content_hash,
  node_synthetic
}
import v2.std.compilers.target_model {
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  InfixToken,
  TargetModel,
  target_model_emit_transforms_empty,
  canonical_operation_op_add,
  concrete_syntax_token_list_to_node,
  target_operator_realization_node,
  target_operator_realizations_catalog_node,
  target_project_arrow_body_to_value_expression,
  target_value_expression_projection_from_target,
  target_value_expression_tokens_from_target,
  value_expr_projection_bundle_node}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

fn add_body_fold_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn add_body_fold_add_operator_row_minus() -> Node {
  target_operator_realization_node(
    operation: canonical_operation_op_add(),
    shape: InfixToken { token: ^ts_token_minus }
  )
}

fn add_body_fold_operator_catalog_minus() -> Node {
  target_operator_realizations_catalog_node(rows: [add_body_fold_add_operator_row_minus()])
}

fn add_body_fold_operator_catalog_empty() -> Node {
  target_operator_realizations_catalog_node(rows: [])
}

fn add_body_fold_target_model_bundle(operator_catalog: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      add_body_fold_named_edge(
        name: ^target_model_edge_selection_policy,
        target: ts_mvp1_selection_policy_node()
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_declared_inhabitants,
        target: ts_mvp1_declared_inhabitants_root()
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_translation_rules,
        target: ts_mvp1_translation_rules_node()
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_serialize_source,
        target: ts_mvp1_serialize_source_node()
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_value_expression_projection,
        target: value_expr_projection_bundle_node(
          projection: ts_value_expression_projection()
        )
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_operator_realizations,
        target: operator_catalog
      )
    ]
  )
}

fn add_body_fold_target_model_minus_catalog() -> TargetModel {
  TargetModel {
    bundle: add_body_fold_target_model_bundle(
      operator_catalog: add_body_fold_operator_catalog_minus()
    ),
    lex: ts_wave1_lex_rules(),
    binding_spellings: ts_mvp1_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: ts_mvp1_source_text_authority(),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn add_body_fold_target_model_missing_operator_catalog() -> TargetModel {
  TargetModel {
    bundle: add_body_fold_target_model_bundle(
      operator_catalog: add_body_fold_operator_catalog_empty()
    ),
    lex: ts_wave1_lex_rules(),
    binding_spellings: ts_mvp1_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: ts_mvp1_source_text_authority(),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn add_body_fold_tokens_equal(
  left: List<ConcreteSyntaxToken>,
  right: List<ConcreteSyntaxToken>
) -> Bool {
  content_hash(n: concrete_syntax_token_list_to_node(tokens: left)) == content_hash(n: concrete_syntax_token_list_to_node(tokens: right))
}

fn add_body_fold_operand_swap_body_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_y },
    FixedToken { token_class: ^ts_token_plus },
    BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_x }
  ]
}

fn add_body_fold_catalog_minus_body_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_x },
    FixedToken { token_class: ^ts_token_minus },
    BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_y }
  ]
}

fn add_body_fold_body_tokens_for_arrow(
  arrow: Node,
  target: TargetModel
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_project_arrow_body_to_value_expression(
      arrow: arrow,
      target: target,
      handle_transform: fn(a, b, t) {
        translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t)
      }
    ),
    f: fn(expr) {
      bind_outcome(
        o: target_value_expression_projection_from_target(target: target),
        f: fn(projection) {
          target_value_expression_tokens_from_target(
            expr: expr,
            target: target,
            projection: projection
          )
        }
      )
    }
  )
}

fn add_body_fold_tokens_accept_arrow(
  arrow: Node,
  target: TargetModel,
  expected: List<ConcreteSyntaxToken>
) -> Bool {
  match add_body_fold_body_tokens_for_arrow(arrow: arrow, target: target) {
    Accepted { value: tokens, diagnostics: d } =>
      add_body_fold_tokens_equal(left: tokens, right: expected) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_fold_add_body_tokens_holds() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      add_body_fold_tokens_accept_arrow(
        arrow: arrow,
        target: ts_mvp1_target_model(),
        expected: ts_mvp1_add_return_body_tokens()
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_fold_operand_swap_discriminates() -> Bool {
  match produce_mvp1_add_arrow_with_body_swapped_operands() {
    Accepted { value: swapped_arrow, diagnostics: _ } =>
      add_body_fold_tokens_accept_arrow(
        arrow: swapped_arrow,
        target: ts_mvp1_target_model(),
        expected: add_body_fold_operand_swap_body_tokens()
      )
      && match produce_mvp1_add_arrow_with_body() {
        Accepted { value: canonical_arrow, diagnostics: _ } =>
          !add_body_fold_tokens_accept_arrow(
            arrow: canonical_arrow,
            target: ts_mvp1_target_model(),
            expected: add_body_fold_operand_swap_body_tokens()
          )
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_fold_catalog_minus_discriminates() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      add_body_fold_tokens_accept_arrow(
        arrow: arrow,
        target: add_body_fold_target_model_minus_catalog(),
        expected: add_body_fold_catalog_minus_body_tokens()
      )
    Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_fold_missing_catalog_rejects() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match add_body_fold_body_tokens_for_arrow(
        arrow: arrow,
        target: add_body_fold_target_model_missing_operator_catalog()
      ) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
