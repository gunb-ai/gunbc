module v2.test.manual.add_body_value_expression_fold_typescript


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn add_body_fold_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn add_body_fold_add_operator_row_minus() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_operator_realization_node(
    operation: v2.std.compilers.target_model.canonical_operation_op_add(),
    shape: v2.std.compilers.target_model.InfixToken { token: ^ts_token_minus }
  )
}

fn add_body_fold_operator_catalog_minus() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_operator_realizations_catalog_node(rows: [add_body_fold_add_operator_row_minus()])
}

fn add_body_fold_operator_catalog_empty() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_operator_realizations_catalog_node(rows: [])
}

fn add_body_fold_target_model_bundle(operator_catalog: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      add_body_fold_named_edge(
        name: ^target_model_edge_selection_policy,
        target: v2.extdeps.languages.typescript.ts_selection_policy_node()
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_declared_inhabitants,
        target: v2.extdeps.languages.typescript.ts_add_declared_inhabitants_root()
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_translation_rules,
        target: v2.extdeps.languages.typescript.ts_translation_rules_node()
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_serialize_source,
        target: v2.extdeps.languages.typescript.ts_serialize_source_node()
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_value_expression_projection,
        target: v2.std.compilers.target_model.value_expr_projection_bundle_node(
          projection: v2.extdeps.languages.typescript.ts_value_expression_projection()
        )
      ),
      add_body_fold_named_edge(
        name: ^target_model_edge_operator_realizations,
        target: operator_catalog
      )
    ]
  )
}

fn add_body_fold_target_model_minus_catalog() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: add_body_fold_target_model_bundle(
      operator_catalog: add_body_fold_operator_catalog_minus()
    ),
    lex: v2.std.compilers.lexing.ModeledLexRules { root: v2.extdeps.languages.typescript.ts_fn_add_lex_rules() },
    binding_spellings: v2.extdeps.languages.typescript.ts_binding_spellings(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
    authority_source_text: v2.extdeps.languages.typescript.ts_source_text_authority(),
    runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
  }
}

fn add_body_fold_target_model_missing_operator_catalog() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: add_body_fold_target_model_bundle(
      operator_catalog: add_body_fold_operator_catalog_empty()
    ),
    lex: v2.std.compilers.lexing.ModeledLexRules { root: v2.extdeps.languages.typescript.ts_fn_add_lex_rules() },
    binding_spellings: v2.extdeps.languages.typescript.ts_binding_spellings(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
    authority_source_text: v2.extdeps.languages.typescript.ts_source_text_authority(),
    runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
  }
}

fn add_body_fold_tokens_equal(
  left: List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  right: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> Bool {
  v2.std.node.content_hash(n: v2.std.compilers.target_model.concrete_syntax_token_list_to_node(tokens: left)) == v2.std.node.content_hash(n: v2.std.compilers.target_model.concrete_syntax_token_list_to_node(tokens: right))
}

fn add_body_fold_operand_swap_body_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_plus },
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_x }
  ]
}

fn add_body_fold_catalog_minus_body_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_minus },
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_y }
  ]
}

fn add_body_fold_body_tokens_for_arrow(
  arrow: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.target_project_arrow_body_to_value_expression(
      arrow: arrow,
      target: target,
      source_bool_form: v2.extdeps.languages.dag.dag_value_expression_projection().bool_literal_form,
      handle_transform: fn(a, b, t) {
        v2.compiler.translate.translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t)
      }
    ),
    f: fn(expr) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.target_value_expression_projection_from_target(target: target),
        f: fn(projection) {
          v2.std.compilers.target_model.target_value_expression_tokens_from_target(
            expr: expr,
            target: target,
            projection: projection
          )
        }
      )
    }
  )
}

fn add_body_fold_tokens_accept_arrow(
  arrow: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  expected: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> Bool {
  match add_body_fold_body_tokens_for_arrow(arrow: arrow, target: target) {
    v2.std.diagnostic.Accepted { value: tokens, diagnostics: d } =>
      add_body_fold_tokens_equal(left: tokens, right: expected) && (d == v2.std.diagnostic.None)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_fold_add_body_tokens_holds() -> Bool {
  match v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      add_body_fold_tokens_accept_arrow(
        arrow: arrow,
        target: v2.extdeps.languages.typescript.ts_target_model(),
        expected: v2.extdeps.languages.typescript.ts_add_return_body_tokens()
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_fold_operand_swap_discriminates() -> Bool {
  match v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_arrow_with_body_swapped_operands() {
    v2.std.diagnostic.Accepted { value: swapped_arrow, diagnostics: _ } =>
      add_body_fold_tokens_accept_arrow(
        arrow: swapped_arrow,
        target: v2.extdeps.languages.typescript.ts_target_model(),
        expected: add_body_fold_operand_swap_body_tokens()
      )
      && match v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_arrow_with_body() {
        v2.std.diagnostic.Accepted { value: canonical_arrow, diagnostics: _ } =>
          !add_body_fold_tokens_accept_arrow(
            arrow: canonical_arrow,
            target: v2.extdeps.languages.typescript.ts_target_model(),
            expected: add_body_fold_operand_swap_body_tokens()
          )
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_fold_catalog_minus_discriminates() -> Bool {
  match v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      add_body_fold_tokens_accept_arrow(
        arrow: arrow,
        target: add_body_fold_target_model_minus_catalog(),
        expected: add_body_fold_catalog_minus_body_tokens()
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn add_body_ts_fold_missing_catalog_rejects() -> Bool {
  match v2.test.complexity_gate.table_fixture_add_subject_producer.table_fixture_add_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } =>
      match add_body_fold_body_tokens_for_arrow(
        arrow: arrow,
        target: add_body_fold_target_model_missing_operator_catalog()
      ) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => true
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
