module v2.test.manual.posix_output_capture

import v2.extdeps.posix { CapturedOutputPipes }
import std.algebra { FreeMonoid }
import v2.std.algebra { is_empty }
import v2.std.node { Node }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  ManualAnchorAbsent,
  manual_claim_anchor
}
import v2.test.manual.connective_anchors { stub_empty_conj, stub_empty_disj }

data empty_captured_pipes: CapturedOutputPipes = CapturedOutputPipes {
  stdout: Empty,
  stderr: Empty
}

fn witness_captured_pipes_stdout_is_empty() -> Bool {
  is_empty(xs: empty_captured_pipes.stdout)
}

fn witness_captured_pipes_stderr_is_empty() -> Bool {
  is_empty(xs: empty_captured_pipes.stderr)
}

fn claim_input(ok: Bool) -> Node {
  if ok {
    stub_empty_conj
  } else {
    stub_empty_disj
  }
}

data claim_captured_output_pipes_stdout_empty: TestClaim = EqualsClaim {
  label: "manual/posix: CapturedOutputPipes.stdout is independently empty",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim_input(ok: witness_captured_pipes_stdout_is_empty()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_captured_output_pipes_stderr_empty: TestClaim = EqualsClaim {
  label: "manual/posix: CapturedOutputPipes.stderr is independently empty",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim_input(ok: witness_captured_pipes_stderr_is_empty()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
