module v2.test.manual.posix_output_capture


data empty_captured_pipes: v2.extdeps.posix.CapturedOutputPipes = v2.extdeps.posix.CapturedOutputPipes {
  stdout: Empty,
  stderr: Empty
}

fn witness_captured_pipes_stdout_is_empty() -> Bool {
  is_empty(xs: empty_captured_pipes.stdout)
}

fn witness_captured_pipes_stderr_is_empty() -> Bool {
  is_empty(xs: empty_captured_pipes.stderr)
}

fn claim_input(ok: Bool) -> Node {
  if ok {
    stub_empty_conj
  } else {
    stub_empty_disj
  }
}

data claim_captured_output_pipes_stdout_empty: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/posix: CapturedOutputPipes.stdout is independently empty",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim_input(ok: witness_captured_pipes_stdout_is_empty()),
  rhs: stub_empty_conj,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_captured_output_pipes_stderr_empty: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/posix: CapturedOutputPipes.stderr is independently empty",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim_input(ok: witness_captured_pipes_stderr_is_empty()),
  rhs: stub_empty_conj,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
