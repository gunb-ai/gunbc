module v2.test.manual.typescript_grammar_claim


fn typescript_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^typescript_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^typescript_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn typescript_grammar_validates_fixture() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: ts_fn_add_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn typescript_grammar_parse_accepted() -> Bool {
  match typescript_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn typescript_grammar_parse_fixture() -> Outcome<ParseTree> {
  let at = port_locus(port: ^parse_stage_locus_port)
  match tokenize(
    text: ts_source_text,
    file: ^typescript_parse_fixture_file,
    rules: ts_fn_add_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar_validate_for_parse(root: ts_fn_add_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          parse_production_tree(
            tokens: token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^ts_production_fn_add
          )
      }
  }
}

data claim_typescript_grammar_validates: TestClaim = EqualsClaim {
  label: "ts_fn_add_grammar_root passes grammar_validate_for_parse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: typescript_claim_bool_atom(b: typescript_grammar_validates_fixture()),
  rhs: typescript_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_typescript_grammar_parses_tokens: TestClaim = EqualsClaim {
  label: "typescript production parse_production accepts lexer output for typed-add source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: typescript_claim_bool_atom(b: typescript_grammar_parse_accepted()),
  rhs: typescript_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
