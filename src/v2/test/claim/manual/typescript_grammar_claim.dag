module v2.test.manual.typescript_grammar_claim


fn typescript_claim_bool_atom(b: Bool) -> v2.std.node.Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^typescript_claim_bool_true } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^typescript_claim_bool_false } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
  }
}

fn typescript_grammar_validates_fixture() -> Bool {
  let at = v2.std.diagnostic.port_locus(port: ^parse_stage_locus_port)
  match v2.compiler.parse.grammar_validate_for_parse(root: v2.extdeps.languages.typescript.ts_fn_add_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn typescript_grammar_parse_accepted() -> Bool {
  match typescript_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn typescript_grammar_parse_fixture() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let at = v2.std.diagnostic.port_locus(port: ^parse_stage_locus_port)
  match v2.compiler.tokenize.tokenize(
    text: v2.extdeps.languages.typescript.ts_source_text,
    file: ^typescript_parse_fixture_file,
    rules: v2.extdeps.languages.typescript.ts_fn_add_lex()
  ) {
    Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match v2.compiler.parse.grammar_validate_for_parse(root: v2.extdeps.languages.typescript.ts_fn_add_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          v2.compiler.parse.parse_production_tree(
            tokens: v2.std.compilers.lexing.token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^ts_production_fn_add
          )
      }
  }
}

data claim_typescript_grammar_validates: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "v2.extdeps.languages.typescript.ts_fn_add_grammar_root passes v2.compiler.parse.grammar_validate_for_parse",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: typescript_claim_bool_atom(b: typescript_grammar_validates_fixture()),
  rhs: typescript_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}

data claim_typescript_grammar_parses_tokens: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "typescript production parse_production accepts lexer output for typed-add source",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: typescript_claim_bool_atom(b: typescript_grammar_parse_accepted()),
  rhs: typescript_claim_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}
