module v2.test.claim.manual.resolved_arm_forge_argument_red

// A resolved arm must not be forgeable: nothing an author writes may produce a ResolvedArm that
// elaboration did not mint. The record-literal route is covered in v2.test.claim.is_surface; this is
// the FUNCTION-ARGUMENT route: the forged fact is built in argument position of a call that consumes
// it. Expected: refused with `sole_constructor type 'ResolvedArm' cannot be constructed outside its
// defining module`. Like ctor_tag_forge_red, a compile-time refusal yields no verdict for any test in
// the file, so the specimen is its own file; the positive control is resolved_arm_consume_control.dag.

import std.decl_ref { DeclarationRef }
import v2.compiler.arm_resolution { ResolvedArm, UnitArmSameArm }
import v2.std.node { Node }

fn take_arm(a: ResolvedArm) -> Int { 1 }

test fn forged_resolved_arm_as_function_argument_must_refuse() -> Bool {
  true
}

fn forge_arm_taken(d: DeclarationRef, t: Node) -> Int {
  take_arm(a: ResolvedArm { owner_decl: d, owner_type: t, arm: d, realization: UnitArmSameArm })
}
