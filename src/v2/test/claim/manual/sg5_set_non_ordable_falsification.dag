module v2.test.manual.sg5_set_non_ordable_falsification


fn sg5_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg5_pass_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg5_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg5_fail_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg5_claim_input(ok: Bool) -> Node {
  if ok {
    sg5_pass_node()
  } else {
    sg5_fail_node()
  }
}

fn sg5_set_non_ordable_projection_rejects() -> Bool {
  match translate_type_expression_project(
    node: rust_sg5_set_non_ordable_source_type_node(),
    target: rust_sg2_type_expr_target_model(),
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data claim_sg5_set_non_ordable_fail_closed: TestClaim = CompilesClaim {
  label: "manual/sg5: Set<NonOrdable> projection rejects (TargetCollectionRealization fallback, not BTreeSet)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg5_claim_input(ok: sg5_set_non_ordable_projection_rejects()),
  expected_value: sg5_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
