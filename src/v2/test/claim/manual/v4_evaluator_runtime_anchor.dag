module v2.test.manual.v2_evaluator_runtime_anchor


type v2_evaluator_anchor_runtime_type = V4EvaluatorRuntime

data v2_evaluator_anchor_runtime: v2_evaluator_anchor_runtime_type = v2_evaluator_runtime()

data v2_evaluator_anchor_core: ModelCore = v2_evaluator_anchor_runtime.core

data v2_evaluator_anchor_core_standalone: ModelCore = v2_evaluator_model_core()

data v2_evaluator_anchor_values: ValueRepresentationModel = v2_evaluator_anchor_runtime.values

data v2_evaluator_anchor_values_standalone: ValueRepresentationModel = v2_evaluator_value_representation()

data v2_evaluator_anchor_interpretation: InterpretationAlgebra = v2_evaluator_interpretation()

data v2_evaluator_anchor_interpretation_standalone: InterpretationAlgebra = v2_evaluator_interpretation()

data v2_evaluator_anchor_execution: ExecutionSemantics = v2_evaluator_anchor_runtime.execution

data v2_evaluator_anchor_execution_standalone: ExecutionSemantics = v2_evaluator_execution()

data v2_evaluator_anchor_boundary: ResourceEffectBoundary = v2_evaluator_anchor_runtime.boundary

data v2_evaluator_anchor_boundary_standalone: ResourceEffectBoundary = v2_evaluator_boundary()

data witness_v4_evaluator_runtime_identity: Bool = v2_evaluator_anchor_runtime.runtime_identity == ^v2_evaluator_runtime_id

data witness_v4_evaluator_interpretation_reinstantiation_eq: Bool = v2_evaluator_anchor_interpretation == v2_evaluator_anchor_interpretation_standalone

data witness_v4_evaluator_interpretation_fresh_call_eq: Bool = v2_evaluator_anchor_interpretation == v2_evaluator_interpretation()

data witness_v4_evaluator_model_core_wired: Bool = v2_evaluator_anchor_core == bool_model_core() && v2_evaluator_anchor_core_standalone == bool_model_core()

data witness_v4_evaluator_semantics_fail_closed: Bool = match v2_eval_call_primitive(
  node: v2_eval_unit_type_node(),
  args: [],
  env: v2_eval_empty_environment()
) {
  Rejected { diagnostics: _ } => true
  _ => false
}

data witness_v4_evaluator_transfer_fail_closed: Bool = match v2_eval_transfer(
  control: Suspend { continuation: v2_eval_empty_frame() },
  frame: v2_eval_empty_frame()
) {
  Rejected { diagnostics: _ } => true
  _ => false
}

fn v2_evaluator_witness_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^v2_evaluator_witness_fail_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn v2_evaluator_witness_claim_input(ok: Bool) -> Node {
  if ok {
    v2_eval_unit_type_node()
  } else {
    v2_evaluator_witness_fail_node()
  }
}

data claim_v4_evaluator_runtime_bundle: TestClaim = CompilesClaim {
  label: "T-34 v2 evaluator concrete runtime bundle constructs and carriers wire",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: v2_evaluator_witness_claim_input(ok: witness_v4_evaluator_runtime_identity && witness_v4_evaluator_model_core_wired && witness_v4_evaluator_interpretation_reinstantiation_eq && witness_v4_evaluator_interpretation_fresh_call_eq),
  expected_value: v2_eval_unit_type_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_v4_evaluator_semantics_fail_closed: TestClaim = CompilesClaim {
  label: "T-34 v2 evaluator call_primitive rejects deferred semantics",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: v2_evaluator_witness_claim_input(ok: witness_v4_evaluator_semantics_fail_closed),
  expected_value: v2_eval_unit_type_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_v4_evaluator_transfer_fail_closed: TestClaim = CompilesClaim {
  label: "T-34 v2 evaluator transfer rejects deferred control",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: v2_evaluator_witness_claim_input(ok: witness_v4_evaluator_transfer_fail_closed),
  expected_value: v2_eval_unit_type_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
