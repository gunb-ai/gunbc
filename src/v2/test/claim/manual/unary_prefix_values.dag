module v2.test.claim.manual.unary_prefix_values

// THE VALUE CHANNEL for the unary-prefix fix (lane adhoc-9102e2d6-92f; defect and cause at
// gunbc.recurring_failure_mode.unary_minus_absorbs_a_following_additive_operator).
//
// A claim body is parsed by the v1 parser and evaluated by the v1 interpreter, so the arms below
// ARE the interpreter's own reading of `-1 - 2`, `-a + b`, `!a && b` -- no host plumbing, no
// second tree. The seed's own body parsing is what the fix changes, so before the mirror is
// regenerated to the fix these arms evaluate the OLD binding (this file is the RED: `-1 - 2`
// computes 1, `!a && b` with a=true,b=false computes true), and after the regenerated mirror they
// compute the fixed values. That is the "evaluates to -3 on the v1 interpreter" channel, run
// through the same executor every claim in this repository runs through.
//
// The emitted-Rust channel is the text arm below: the emitter reads the SAME tree, so the emitted
// program shows whether the parenthesization changed -- pre-fix `-1 - 2` emits the minus applied
// to the whole `(1 - 2)` binop; post-fix it emits the binop over the negated literal.

import std.types { Bool, Int, String, List }
import std.optional { Absent, Present }
import std.process { ProcessExit, exit_failure, ExitSuccess }
import v1.compiler.compile { compile_sources, SourceFile }
import v1.compiler.artifact { RenderTarget, Rust }

// THE DISTINGUISHING ARMS. Chosen so old binding and new binding compute DIFFERENT values:
//   -1 - 2      old: -(1 - 2) = 1    new: (-1) - 2 = -3
//   -1 + 2      old: -(1 + 2) = -3   new: (-1) + 2 = 1
//   !a && b     (a,b = true,false)   old: !(true && false) = true   new: (!true) && false = false
//   !a || b     (a,b = true,true)    old: !(true || true) = false   new: (!true) || true = true
// Controls (same value both bindings -- they must stay true, the fix must not move them):
//   -(1 - 2) == 1 (parenthesized), -1 * 2 == -2 (multiplication is unaffected in VALUE),
//   -1 < 0, standalone -3 == -3.
test fn unary_prefix_value_arms_hold() -> ProcessExit {
  let a1 = -1 - 2
  let b1 = -1 + 2
  let t = true
  let f = false
  let c1 = !t && f
  let c2 = !t || t
  let d1 = -1 - 2 - 3
  let p1 = -(1 - 2) == 1
  let p2 = -1 * 2 == -2
  let p3 = -1 < 0
  let p4 = -3 == 0 - 3
  let report = concat(
    "-1 - 2 = ", to_string(value: a1), " (want -3); ",
    "-1 + 2 = ", to_string(value: b1), " (want 1); ",
    "!t && f = ", to_string(value: c1), " (want false); ",
    "!t || t = ", to_string(value: c2), " (want true); ",
    "-1 - 2 - 3 = ", to_string(value: d1), " (want -6; the old binding computes 4); ",
    "controls -(1-2)==1: ", to_string(value: p1),
    ", -1*2==-2: ", to_string(value: p2),
    ", -1<0: ", to_string(value: p3),
    ", -3==0-3: ", to_string(value: p4)
  )
  if a1 == -3 && b1 == 1 && c1 == false && c2 == true && d1 == -6 && p1 && p2 && p3 && p4 {
    ExitSuccess
  } else {
    exit_failure(reason: concat("unary-prefix value arms refused: ", report))
  }
}

// THE EMITTED-RUST CHANNEL: the emitter reads the same tree the parser built, so the emitted text
// carries the same defect. Pre-fix, `-1 - 2` renders the minus applied to the whole `(1 - 2)`
// binop; post-fix, the binop sits over the negated literal. Both discriminator substrings are
// carried in the refusal so the arm is calibratable from its own report.
fn emit_body(body: String) -> String {
  let src = concat("module probe.unary_prefix.emit\n\nfn probe_case(a: Bool, b: Bool) -> Int {\n  ", body, "\n}\n")
  let result = compile_sources(
    sources: [SourceFile { path: "probe_emit_unary_prefix.dag", content: src }],
    target: Rust
  )
  result.files |> map(f => f.content) |> join(separator: "\n")
}

test fn unary_prefix_emitted_text_follows_the_tree() -> ProcessExit {
  let minus = emit_body(body: "-1 - 2 - 3")
  let bang = emit_body(body: "!t && f && t")
  // The emitter parenthesizes a binop's children when a child is itself a binop, so the triple
  // distinguishes the two trees in TEXT: post-fix the outer row is over the negated literal,
  // "(-1 - 2) - (3)"; the old tree renders the unary applied to the whole row, "-(1 - 2) - (3)".
  // (A pair like "-1 - 2" alone renders identically under both trees -- Neg does not parenthesize
  // -- which is why the triple, not the pair, is the discriminator.)
  let ok = contains_pair(text: minus, want: "(-1 - 2) - (3)", refuse: "-(1 - 2) - (3)") &&
    contains_pair(text: bang, want: "(!t && f) && (t)", refuse: "!(t && f) && (t)")
  if ok {
    ExitSuccess
  } else {
    exit_failure(reason: concat(
      "unary-prefix emitted-text refused.\nminus:\n", minus,
      "\nbang:\n", bang
    ))
  }
}

fn contains_pair(text: String, want: String, refuse: String) -> Bool {
  string_contains(s: text, pattern: want) && !string_contains(s: text, pattern: refuse)
}
