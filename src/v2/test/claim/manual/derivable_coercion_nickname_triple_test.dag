module v2.test.manual.derivable_coercion_nickname_triple


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn task_id_candidate_set(candidates: List<v2.std.node.Node>, closedness_evidence: v2.std.node.Node) -> v2.std.find_witness.CandidateSet {
  v2.std.find_witness.CandidateSet {
    candidates: candidates,
    closedness: v2.test.fixture.derivable_coercion_task_id.derivable_coercion_candidate_closedness(evidence: closedness_evidence)
  }
}

fn task_id_predicate(source: v2.std.node.Node, target: v2.std.node.Node, rule: v2.std.node.Symbol) -> v2.std.find_witness.PreservationPredicate {
  if rule == ^preservation_rule_refinement_widening {
    v2.std.find_witness.PreservationPredicate {
      algebra: v2.std.refinement_widening_predicate.refinement_widening_predicate_algebra(source: source, candidate: target),
      preservation_rule: rule
    }
  } else {
    v2.std.find_witness.PreservationPredicate {
      algebra: source,
      preservation_rule: rule
    }
  }
}

fn find_witness_sibling_accepts(source: v2.std.node.Node, target: v2.std.node.Node, rule: v2.std.node.Symbol) -> Bool {
  match v2.std.find_witness.find_witness(
    source_facts: source,
    candidates: task_id_candidate_set(
      candidates: [target],
      closedness_evidence: target
    ),
    predicate: task_id_predicate(source: source, target: target, rule: rule),
    multiplicity_policy: v2.std.find_witness.UniqueOnly
  ) {
    v2.std.diagnostic.Accepted { value: fw, diagnostics: _ } => fw.candidate == target
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn find_witness_dispatch_accepts(source: v2.std.node.Node, target: v2.std.node.Node) -> Bool {
  match v2.std.find_witness.find_witness_derives(
    source_facts: source,
    candidates: task_id_candidate_set(
      candidates: [target],
      closedness_evidence: target
    ),
    derivation_algebra: source,
    multiplicity_policy: v2.std.find_witness.UniqueOnly
  ) {
    v2.std.diagnostic.Accepted { value: fw, diagnostics: _ } => fw.candidate == target
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

data witness_task_id_surfaces_distinct: Bool = (v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node() != v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node()) && (v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node() != v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node()) && (v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node() != v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node())

data witness_task_id_shared_core_matches: Bool = v2.std.exact_structural_equality_zip_fold_predicate.exact_structural_equality_zip_fold(source_facts: v2.test.fixture.derivable_coercion_task_id.task_id_semantic_core_node(), candidate: v2.test.fixture.derivable_coercion_task_id.task_id_semantic_core_node())

data witness_matrix_exact_api_to_db_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node(), rule: ^preservation_rule_exact_structural_equality_zip_fold)

data witness_matrix_exact_api_to_wire_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node(), rule: ^preservation_rule_exact_structural_equality_zip_fold)

data witness_matrix_exact_db_to_wire_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node(), rule: ^preservation_rule_exact_structural_equality_zip_fold)

data witness_matrix_exact_api_to_account_id_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.account_id_wrong_inhabitant_node(), rule: ^preservation_rule_exact_structural_equality_zip_fold)

data witness_matrix_widening_api_to_db_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node(), rule: ^preservation_rule_refinement_widening)

data witness_matrix_widening_api_to_wire_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node(), rule: ^preservation_rule_refinement_widening)

data witness_matrix_widening_db_to_wire_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node(), rule: ^preservation_rule_refinement_widening)

data witness_matrix_widening_api_to_account_id_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.account_id_wrong_inhabitant_node(), rule: ^preservation_rule_refinement_widening)

data witness_matrix_constraint_api_to_db_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node(), rule: ^preservation_rule_constraint_satisfaction)

data witness_matrix_constraint_api_to_wire_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node(), rule: ^preservation_rule_constraint_satisfaction)

data witness_matrix_constraint_db_to_wire_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node(), rule: ^preservation_rule_constraint_satisfaction)

data witness_matrix_constraint_api_to_account_id_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.account_id_wrong_inhabitant_node(), rule: ^preservation_rule_constraint_satisfaction)

data witness_dispatch_api_to_db_accepts: Bool = find_witness_dispatch_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node())

data witness_dispatch_api_to_wire_accepts: Bool = find_witness_dispatch_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node())

data witness_dispatch_db_to_wire_accepts: Bool = find_witness_dispatch_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_db_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_wire_inhabitant_node())

data witness_dispatch_api_to_account_id_accepts: Bool = find_witness_dispatch_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.account_id_wrong_inhabitant_node())

fn find_witness_dispatch_faithful_for_siblings() -> Bool {
  witness_dispatch_api_to_db_accepts
    && witness_dispatch_api_to_wire_accepts
    && witness_dispatch_db_to_wire_accepts
    && !witness_dispatch_api_to_account_id_accepts
}

data witness_crux_substrate_gap: Bool = !find_witness_dispatch_faithful_for_siblings()

data witness_matrix_exact_api_to_api_accepts: Bool = find_witness_sibling_accepts(source: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), target: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node(), rule: ^preservation_rule_exact_structural_equality_zip_fold)

fn derivable_coercion_pass_node() -> v2.std.node.Node {
  v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node()
}

fn derivable_coercion_claim_lhs(ok: Bool) -> v2.std.node.Node {
  if ok {
    derivable_coercion_pass_node()
  } else {
    v2.test.fixture.derivable_coercion_task_id.account_id_wrong_inhabitant_node()
  }
}

data claim_task_id_surfaces_distinct: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/derivable_coercion: API/DB/wire inhabitants have distinct SurfaceSpelling surfaces",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: derivable_coercion_claim_lhs(ok: witness_task_id_surfaces_distinct),
  rhs: derivable_coercion_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_crux_substrate_gap: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/derivable_coercion: CRUX — find_witness dispatch derives nickname siblings and rejects wrong-core",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: derivable_coercion_claim_lhs(ok: !witness_crux_substrate_gap),
  rhs: derivable_coercion_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_matrix_widening_accepts_siblings_and_wrong_core: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "manual/derivable_coercion: CRUX — widening accepts siblings AND wrong-core (non-discriminating)",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: derivable_coercion_claim_lhs(ok: witness_matrix_widening_api_to_db_accepts && witness_matrix_widening_api_to_wire_accepts && witness_matrix_widening_db_to_wire_accepts && witness_matrix_widening_api_to_account_id_accepts),
  rhs: derivable_coercion_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

test data witness_claim_task_id_surfaces_distinct: Bool = match v2.compiler.eval.run_test_claim_assert(
  claim: claim_task_id_surfaces_distinct,
  actual: v2.std.diagnostic.Accepted { value: derivable_coercion_pass_node(), diagnostics: v2.std.diagnostic.None },
  at: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node()
) {
  v2.std.verdict.Pass => true
  v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => false
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => false
  v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
}

test data witness_claim_crux_substrate_gap: Bool = match v2.compiler.eval.run_test_claim_assert(
  claim: claim_crux_substrate_gap,
  actual: v2.std.diagnostic.Accepted { value: derivable_coercion_pass_node(), diagnostics: v2.std.diagnostic.None },
  at: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node()
) {
  v2.std.verdict.Pass => true
  v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => false
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => false
  v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
}

test data witness_claim_matrix_widening_accepts_siblings_and_wrong_core: Bool = match v2.compiler.eval.run_test_claim_assert(
  claim: claim_matrix_widening_accepts_siblings_and_wrong_core,
  actual: v2.std.diagnostic.Accepted { value: derivable_coercion_pass_node(), diagnostics: v2.std.diagnostic.None },
  at: v2.test.fixture.derivable_coercion_task_id.task_id_api_inhabitant_node()
) {
  v2.std.verdict.Pass => true
  v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => false
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => false
  v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
}
