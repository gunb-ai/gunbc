module v2.test.manual.target_model_atom_lookup_dissolution


fn atom_lookup_dissolution_probe_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^atom_lookup_dissolution_probe } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn atom_lookup_dissolution_pass_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^atom_lookup_dissolution_pass } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn atom_lookup_dissolution_fail_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^atom_lookup_dissolution_fail } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn atom_lookup_dissolution_claim_input(ok: Bool) -> Node {
  if ok {
    atom_lookup_dissolution_pass_node()
  } else {
    atom_lookup_dissolution_fail_node()
  }
}

fn passing_candidate_fold_duplicate_produces_many() -> Bool {
  match fold_list(
    xs: [atom_lookup_dissolution_probe_node(), atom_lookup_dissolution_probe_node()],
    empty: NoPassingCandidate,
    cons: fn(acc, n) {
      match acc {
        NoPassingCandidate => v2.std.passing_candidate_fold.OnePassingCandidate { candidate: n }
        OnePassingCandidate { candidate: _ } => ManyPassingCandidates
        ManyPassingCandidates => ManyPassingCandidates
      }
    }
  ) {
    NoPassingCandidate => false
    OnePassingCandidate { candidate: _ } => false
    ManyPassingCandidates => true
  }
}

fn atom_lookup_in_catalog_known_carrier_accepts() -> Bool {
  match target_atom_realization_lookup_in_catalog(
    catalog: ts_target_atom_realization_catalog,
    source_carrier: symbol_kernel_type_node()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn atom_lookup_in_catalog_unknown_carrier_rejects_miss() -> Bool {
  match target_atom_realization_lookup_in_catalog(
    catalog: ts_target_atom_realization_catalog,
    source_carrier: atom_lookup_dissolution_probe_node()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_atom_realization_lookup_miss
  }
}

fn atom_lookup_in_catalog_node_non_conj_rejects_decode_invalid() -> Bool {
  match target_atom_realization_lookup_in_catalog_node(
    catalog: atom_lookup_dissolution_probe_node(),
    source_carrier: atom_lookup_dissolution_probe_node(),
    host_target_model: ts_sg2_type_expr_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^target_atom_realization_catalog_row_decode_invalid
  }
}

fn atom_catalog_with_malformed_row_skips_accepts_valid() -> Bool {
  match target_atom_realization_lookup_in_catalog_node(
    catalog: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: Conj },
      children: [
        v2.std.node.Edge { label: Positional, target: atom_lookup_dissolution_probe_node() },
        v2.std.node.Edge {
          label: Positional,
          target: target_atom_realization_to_node(
            row: ts_target_atom_realization_bool,
            host_bundle: ts_sg2_type_expr_target_model_node()
          )
        }
      ],
      occurrence_id: SyntheticOccurrence
    },
    source_carrier: bool_node(),
    host_target_model: ts_sg2_type_expr_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data claim_passing_candidate_fold_ambiguity: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/atom_lookup_dissolution: PassingCandidateFold duplicate nodes yield ManyPassingCandidates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: passing_candidate_fold_duplicate_produces_many()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_atom_lookup_in_catalog_accepts: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/atom_lookup_dissolution: target_atom_realization_lookup_in_catalog accepts known carrier",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: atom_lookup_in_catalog_known_carrier_accepts()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_atom_lookup_in_catalog_miss: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/atom_lookup_dissolution: target_atom_realization_lookup_in_catalog unknown carrier rejects miss",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: atom_lookup_in_catalog_unknown_carrier_rejects_miss()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_atom_lookup_in_catalog_node_non_conj: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/atom_lookup_dissolution: target_atom_realization_lookup_in_catalog_node non-Conj rejects decode-invalid",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: atom_lookup_in_catalog_node_non_conj_rejects_decode_invalid()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_atom_catalog_malformed_row_skips: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "manual/atom_lookup_dissolution: Conj catalog with malformed row skips it, accepts valid row (fail-open witness)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: atom_catalog_with_malformed_row_skips_accepts_valid()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
