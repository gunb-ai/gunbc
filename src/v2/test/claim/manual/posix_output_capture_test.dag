module v2.test.manual.posix_output_capture

data empty_captured_pipes: v2.extdeps.posix.CapturedOutputPipes = v2.extdeps.posix.CapturedOutputPipes {
  stdout: Empty,
  stderr: Empty
}

test fn witness_captured_pipes_stdout_is_empty() -> Bool {
  v2.std.algebra.is_empty(xs: empty_captured_pipes.stdout)
}

test fn witness_captured_pipes_stderr_is_empty() -> Bool {
  v2.std.algebra.is_empty(xs: empty_captured_pipes.stderr)
}
