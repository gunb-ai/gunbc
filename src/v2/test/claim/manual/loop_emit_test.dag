module v2.test.manual.loop_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn loop_emit_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.test.execution.loop_round_trip.loop_round_trip_inferred_facts_for(node: key)
}

fn loop_emit_inferred_tree_for(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: PartialFunction { lookup: loop_emit_facts_lookup }
  }
}

fn loop_emit_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: loop_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn loop_emit_wrong_value_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match v2.test.complexity_gate.table_fixture_loop_subject_producer.table_fixture_loop_wrong_value_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: loop_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn loop_emit_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: loop_emit_producer_tree(),
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

fn loop_emit_wrong_value_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: loop_emit_wrong_value_producer_tree(),
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

test fn loop_emit_holds() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: v2.extdeps.languages.dag.dag_loop_target_model(),
    emitted: v2.extdeps.languages.dag.dag_fixture_emitted_loop_fn
  ) {
    v2.std.diagnostic.Accepted { value: authority, diagnostics: ad } =>
      match loop_emit_from_producer(target: v2.extdeps.languages.dag.dag_loop_target_model()) {
        v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn loop_emit_wrong_value_discriminates() -> Bool {
  match loop_emit_from_producer(target: v2.extdeps.languages.dag.dag_loop_target_model()) {
    v2.std.diagnostic.Accepted { value: canonical, diagnostics: dc } =>
      match loop_emit_wrong_value_from_producer(target: v2.extdeps.languages.dag.dag_loop_target_model()) {
        v2.std.diagnostic.Accepted { value: wrong, diagnostics: dw } =>
          (wrong != canonical) && (dc == v2.std.diagnostic.None) && (dw == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

