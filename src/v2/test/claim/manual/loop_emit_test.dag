module v2.test.manual.loop_emit

import v2.test.complexity_gate.table_fixture_loop_subject_producer {
  table_fixture_loop_arrow_with_body,
  table_fixture_loop_wrong_value_arrow_with_body
}
import v2.test.execution.loop_round_trip {
  loop_round_trip_inferred_facts_for,
  loop_inferred_tree
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.extdeps.languages.dag {
  dag_fixture_emitted_loop_fn,
  dag_loop_source_text,
  dag_loop_target_model
}
import v2.compiler.translate {
  target_serialize_source_from_model,
  translate_emitted_node
}
import v2.std.collection {
  Map
}
import v2.std.optional {
  Optional
}
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  bind_outcome
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.node_query {
  find_arrow_body_child
}
import v2.std.compilers.target_model {
  TargetModel,
  target_value_expr_loop_gate
}
import v2.std.witness { Holds, Witness }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn loop_emit_facts_lookup(key: Node) -> Optional<InferredFacts> {
  loop_round_trip_inferred_facts_for(node: key)
}

fn loop_emit_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: loop_emit_facts_lookup }
  }
}

fn loop_emit_producer_tree() -> Outcome<InferredTree> {
  match table_fixture_loop_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: loop_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn loop_emit_wrong_value_producer_tree() -> Outcome<InferredTree> {
  match table_fixture_loop_wrong_value_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: loop_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn loop_emit_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: loop_emit_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn loop_emit_wrong_value_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: loop_emit_wrong_value_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn loop_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: dag_loop_target_model(),
    emitted: dag_fixture_emitted_loop_fn
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match loop_emit_from_producer(target: dag_loop_target_model()) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn loop_emit_wrong_value_discriminates() -> Bool {
  match loop_emit_from_producer(target: dag_loop_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match loop_emit_wrong_value_from_producer(target: dag_loop_target_model()) {
        Accepted { value: wrong, diagnostics: dw } =>
          (wrong != canonical) && (dc == None) && (dw == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

