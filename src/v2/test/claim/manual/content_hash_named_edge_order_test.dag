module v2.test.manual.content_hash_named_edge_order

fn content_hash_order_leaf() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^content_hash_order_leaf_sym } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_order_conj_ab() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^content_hash_order_field_a },
        target: content_hash_order_leaf()
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^content_hash_order_field_b },
        target: content_hash_order_leaf()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_order_conj_ba() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^content_hash_order_field_b },
        target: content_hash_order_leaf()
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^content_hash_order_field_a },
        target: content_hash_order_leaf()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

test fn content_hash_named_edge_order_holds() -> Bool {
  v2.std.node.content_hash(n: content_hash_order_conj_ab()) ==
    v2.std.node.content_hash(n: content_hash_order_conj_ba())
}

fn content_hash_nested_conj_ab() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^content_hash_order_field_a },
        target: content_hash_order_conj_ab()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_nested_conj_ba() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^content_hash_order_field_a },
        target: content_hash_order_conj_ba()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

test fn content_hash_nested_named_edge_order_holds() -> Bool {
  v2.std.node.content_hash(n: content_hash_nested_conj_ab()) ==
    v2.std.node.content_hash(n: content_hash_nested_conj_ba())
}
