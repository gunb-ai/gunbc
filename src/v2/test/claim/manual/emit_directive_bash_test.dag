module v2.test.manual.emit_directive_bash


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn emit_directive_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  optional_absent()
}

data emit_directive_error_example: v2.std.diagnostic.EmitDirective = v2.std.diagnostic.EmitDirective {
  severity: SeverityError,
  message: "build verification failed"
}

data emit_directive_warning_example: v2.std.diagnostic.EmitDirective = v2.std.diagnostic.EmitDirective {
  severity: SeverityWarning,
  message: "build verification failed"
}

data emit_directive_other_example: v2.std.diagnostic.EmitDirective = v2.std.diagnostic.EmitDirective {
  severity: SeverityError,
  message: "cache corruption"
}

data emit_directive_error_expected: String = "'echo' 'build verification failed' >&2"
data emit_directive_other_expected: String = "'echo' 'cache corruption' >&2"

data emit_directive_error_to_stdout_wrong_expected: String = "'echo' 'build verification failed'"

fn emit_directive_bash_emit(d: v2.std.diagnostic.EmitDirective) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.emit.emit(
    tree: v2.compiler.inferred_tree.InferredTree {
      root: emit_directive_bash_emitted_command,
      facts: std.algebra.PartialFunction { lookup: emit_directive_facts_lookup }
    },
    target: emit_directive_bash_target_model(d: d)
  )
}

test fn emit_directive_bash_error_emits_echo_stderr_holds() -> Bool {
  match v2.test.manual.emit_directive_bash.emit_directive_bash_emit(d: emit_directive_error_example) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == emit_directive_error_expected) && (dg == v2.std.diagnostic.None)
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_directive_bash_severity_invariant_holds() -> Bool {
  match v2.test.manual.emit_directive_bash.emit_directive_bash_emit(d: emit_directive_error_example) {
    Accepted { value: se, diagnostics: _ } =>
      match v2.test.manual.emit_directive_bash.emit_directive_bash_emit(d: emit_directive_warning_example) {
        Accepted { value: sw, diagnostics: _ } => se.carried == sw.carried
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_directive_bash_message_flows_holds() -> Bool {
  match v2.test.manual.emit_directive_bash.emit_directive_bash_emit(d: emit_directive_error_example) {
    Accepted { value: s1, diagnostics: _ } =>
      match v2.test.manual.emit_directive_bash.emit_directive_bash_emit(d: emit_directive_other_example) {
        Accepted { value: s2, diagnostics: _ } =>
          (s2.carried == emit_directive_other_expected) && (s1.carried != s2.carried)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn emit_directive_bash_emit_to_stdout_wrong(d: v2.std.diagnostic.EmitDirective) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.emit.emit(
    tree: v2.compiler.inferred_tree.InferredTree {
      root: emit_directive_bash_emitted_command,
      facts: std.algebra.PartialFunction { lookup: emit_directive_facts_lookup }
    },
    target: emit_directive_bash_to_stdout_wrong_target_model(d: d)
  )
}

test fn emit_directive_bash_to_stdout_wrong_ne_correct_holds() -> Bool {
  match emit_directive_bash_emit_to_stdout_wrong(d: emit_directive_error_example) {
    Accepted { value: w, diagnostics: _ } =>
      (w.carried == emit_directive_error_to_stdout_wrong_expected)
        && (w.carried != emit_directive_error_expected)
    Rejected { diagnostics: _ } => false
  }
}
