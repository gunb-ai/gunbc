module v2.test.manual.rust_wire_serde_naming_policy_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn rust_ws_serialize_accepts(target: v2.std.compilers.target_model.TargetModel, emitted: Node) -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(target: target, emitted: emitted) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn rust_ws_serialized_text(target: v2.std.compilers.target_model.TargetModel, emitted: Node) -> String {
  match v2.compiler.translate.target_serialize_source_from_model(target: target, emitted: emitted) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => ""
  }
}

test fn witness_rust_wire_serde_screaming_snake_holds() -> Bool {
  rust_ws_serialize_accepts(
    target: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_screaming_snake_target,
    emitted: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_review_event_emitted
  )
    && rust_ws_serialized_text(
      target: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_screaming_snake_target,
      emitted: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_review_event_emitted
    ) == rust_ws_review_event_screaming_golden
}

test fn witness_rust_wire_serde_snake_case_holds() -> Bool {
  rust_ws_serialize_accepts(
    target: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_snake_case_target,
    emitted: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_review_event_emitted
  )
    && rust_ws_serialized_text(
      target: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_snake_case_target,
      emitted: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_review_event_emitted
    ) == rust_ws_review_event_snake_golden
}

test fn witness_rust_wire_serde_naming_discriminates() -> Bool {
  let screaming = rust_ws_serialized_text(
    target: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_screaming_snake_target,
    emitted: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_review_event_emitted
  )
  let snake = rust_ws_serialized_text(
    target: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_snake_case_target,
    emitted: v2.extdeps.languages.rust_wire_serde.rust_wire_serde_review_event_emitted
  )
  screaming != snake
    && screaming != v2.extdeps.languages.rust_wire_serde.rust_ws_review_event_body_golden
    && snake != v2.extdeps.languages.rust_wire_serde.rust_ws_review_event_body_golden
}

test data unified_claim_rust_wire_serde_screaming_snake: v2.std.verification.UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v2/test/claim/manual/rust_wire_serde_naming_policy_test.dag",
    function: witness_rust_wire_serde_screaming_snake_holds
  }
}

test data unified_claim_rust_wire_serde_snake_case: v2.std.verification.UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v2/test/claim/manual/rust_wire_serde_naming_policy_test.dag",
    function: witness_rust_wire_serde_snake_case_holds
  }
}

test data unified_claim_rust_wire_serde_naming_discriminates: v2.std.verification.UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v2/test/claim/manual/rust_wire_serde_naming_policy_test.dag",
    function: witness_rust_wire_serde_naming_discriminates
  }
}
