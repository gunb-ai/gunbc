test fn row3_match_arm() -> Bool { roster_prod_eq(index: 3, prod: ^dag_production_match_arm) }
test fn row3_top_level_item() -> Bool { roster_prod_eq(index: 3, prod: ^dag_production_top_level_item) }
test fn row3_primary_ident_suffix() -> Bool { roster_prod_eq(index: 3, prod: ^dag_production_primary_ident_suffix) }
