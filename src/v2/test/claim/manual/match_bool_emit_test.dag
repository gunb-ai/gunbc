module v2.test.manual.match_bool_emit

import v2.compiler.body_producer {
  produce_mvp1_match_arrow_with_body,
  produce_mvp1_match_arrow_with_body_swapped_arms
}
import v2.test.manual.match_bool_round_trip {
  match_bool_inferred_facts_for,
  match_bool_inferred_tree
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.extdeps.languages.dag {
  dag_mvp1_fixture_emitted_match_fn,
  dag_mvp1_match_if_body_fixture,
  dag_mvp1_match_source_text,
  dag_mvp1_match_target_model,
  dag_mvp1_node_is_kw_true_atom,
  dag_mvp1_pick_arrow_domain_conj_node
}
import v2.compiler.source_authority { source_authority_node_equal }
import v2.compiler.translate {
  coerce_grounded_node,
  target_serialize_source_from_model,
  translate_emitted_node
}
import v2.std.collection { Map, list_at_optional }
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  bind_outcome
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.node_query {
  find_arrow_body_child,
  node_positional_child_targets
}
import v2.std.compilers.target_model {
  TargetModel,
  target_value_expr_match_gate
}
import v2.std.witness { Holds, Witness }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

fn match_bool_emit_facts_lookup(key: Node) -> Witness<InferredFacts> {
  match_bool_inferred_facts_for(node: key)
}

fn match_bool_emit_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: match_bool_emit_facts_lookup }
  }
}

fn match_bool_emit_producer_tree() -> Outcome<InferredTree> {
  match produce_mvp1_match_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: match_bool_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn match_bool_emit_swapped_producer_tree() -> Outcome<InferredTree> {
  match produce_mvp1_match_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: match_bool_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn match_bool_emit_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: match_bool_emit_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn match_bool_emit_swapped_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: match_bool_emit_swapped_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn match_bool_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: dag_mvp1_match_target_model(),
    emitted: dag_mvp1_fixture_emitted_match_fn
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match match_bool_emit_from_producer(target: dag_mvp1_match_target_model()) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn match_bool_emit_swapped_arms_discriminates() -> Bool {
  match match_bool_emit_from_producer(target: dag_mvp1_match_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match match_bool_emit_swapped_from_producer(target: dag_mvp1_match_target_model()) {
        Accepted { value: swapped, diagnostics: ds } =>
          (swapped != canonical) && (dc == None) && (ds == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn match_bool_emit_keystone_holds() -> Bool {
  match_bool_emit_holds() && match_bool_emit_swapped_arms_discriminates()
}

fn match_bool_emit_post_translate_root() -> Outcome<Node> {
  bind_outcome(
    o: match_bool_emit_producer_tree(),
    f: fn(tree) {
      translate_emitted_node(tree: tree, target: dag_mvp1_match_target_model())
    }
  )
}

fn match_bool_emit_diag_match_gate_on_post_translate_body() -> Bool {
  match match_bool_emit_post_translate_root() {
    Accepted { value: translated, diagnostics: d } =>
      match find_arrow_body_child(root: translated) {
        Accepted { value: body, diagnostics: bd } =>
          target_value_expr_match_gate(node: body) && (d == None) && (bd == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn match_bool_emit_diag_scrut_bare_kw_true_on_post_translate() -> Bool {
  match match_bool_emit_post_translate_root() {
    Accepted { value: translated, diagnostics: d } =>
      match find_arrow_body_child(root: translated) {
        Accepted { value: body, diagnostics: bd } =>
          match list_at_optional(xs: node_positional_child_targets(node: body), index: 0) {
            Present { value: scrut } =>
              dag_mvp1_node_is_kw_true_atom(node: scrut) && (d == None) && (bd == None)
            Absent => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn match_bool_emit_diag_emit_eq_authority_text() -> Bool {
  match match_bool_emit_from_producer(target: dag_mvp1_match_target_model()) {
    Accepted { value: emitted, diagnostics: d } =>
      (emitted.carried == dag_mvp1_match_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}
