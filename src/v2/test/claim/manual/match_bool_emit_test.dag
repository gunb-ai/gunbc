module v2.test.manual.match_bool_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn match_bool_emit_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.test.execution.match_bool_round_trip.match_bool_inferred_facts_for(node: key)
}

fn match_bool_emit_inferred_tree_for(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: PartialFunction { lookup: match_bool_emit_facts_lookup }
  }
}

fn match_bool_emit_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match v2.test.complexity_gate.table_fixture_match_subject_producer.table_fixture_match_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: match_bool_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn match_bool_emit_swapped_producer_tree() -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match v2.test.complexity_gate.table_fixture_match_subject_producer.table_fixture_match_arrow_with_body_swapped_arms() {
    v2.std.diagnostic.Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: match_bool_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn match_bool_emit_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: match_bool_emit_producer_tree(),
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

fn match_bool_emit_swapped_from_producer(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: match_bool_emit_swapped_producer_tree(),
    f: fn(tree) {
      v2.compiler.emit.emit(tree: tree, target: target)
    }
  )
}

test fn match_bool_emit_holds() -> Bool {
  match v2.compiler.translate.target_serialize_source_from_model(
    target: v2.extdeps.languages.dag.dag_match_target_model(),
    emitted: v2.extdeps.languages.dag.dag_fixture_emitted_match_fn
  ) {
    v2.std.diagnostic.Accepted { value: authority, diagnostics: ad } =>
      match match_bool_emit_from_producer(target: v2.extdeps.languages.dag.dag_match_target_model()) {
        v2.std.diagnostic.Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == v2.std.diagnostic.None) && (ad == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn match_bool_emit_swapped_arms_discriminates() -> Bool {
  match match_bool_emit_from_producer(target: v2.extdeps.languages.dag.dag_match_target_model()) {
    v2.std.diagnostic.Accepted { value: canonical, diagnostics: dc } =>
      match match_bool_emit_swapped_from_producer(target: v2.extdeps.languages.dag.dag_match_target_model()) {
        v2.std.diagnostic.Accepted { value: swapped, diagnostics: ds } =>
          (swapped != canonical) && (dc == v2.std.diagnostic.None) && (ds == v2.std.diagnostic.None)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

