module v2.test.manual.match_bool_emit

import v2.test.complexity_gate.table_fixture_match_subject_producer {
  table_fixture_match_arrow_with_body,
  table_fixture_match_arrow_with_body_swapped_arms
}
import v2.test.execution.match_bool_round_trip {
  match_bool_inferred_facts_for,
  match_bool_inferred_tree
}
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.extdeps.languages.dag {
  dag_fixture_emitted_match_fn,
  dag_match_if_body_fixture,
  dag_match_source_text,
  dag_match_target_model,
  dag_node_is_kw_true_atom,
  dag_pick_arrow_domain_conj_node
}
import v2.compiler.source_authority { source_authority_node_equal }
import v2.compiler.translate {
  coerce_grounded_node,
  target_serialize_source_from_model,
  translate_emitted_node
}
import v2.std.collection {
  Map,
  list_at_optional
}
import v2.std.optional {
  Optional,
  Present,
  Absent
}
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  bind_outcome
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.node_query {
  find_arrow_body_child,
  node_positional_child_targets
}
import v2.std.compilers.target_model {
  TargetModel,
  target_value_expr_match_gate
}
import v2.std.witness { Holds, Witness }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn match_bool_emit_facts_lookup(key: Node) -> Optional<InferredFacts> {
  match_bool_inferred_facts_for(node: key)
}

fn match_bool_emit_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: match_bool_emit_facts_lookup }
  }
}

fn match_bool_emit_producer_tree() -> Outcome<InferredTree> {
  match table_fixture_match_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: match_bool_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn match_bool_emit_swapped_producer_tree() -> Outcome<InferredTree> {
  match table_fixture_match_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: match_bool_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn match_bool_emit_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: match_bool_emit_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn match_bool_emit_swapped_from_producer(target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: match_bool_emit_swapped_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn match_bool_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: dag_match_target_model(),
    emitted: dag_fixture_emitted_match_fn
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match match_bool_emit_from_producer(target: dag_match_target_model()) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn match_bool_emit_swapped_arms_discriminates() -> Bool {
  match match_bool_emit_from_producer(target: dag_match_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match match_bool_emit_swapped_from_producer(target: dag_match_target_model()) {
        Accepted { value: swapped, diagnostics: ds } =>
          (swapped != canonical) && (dc == None) && (ds == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

