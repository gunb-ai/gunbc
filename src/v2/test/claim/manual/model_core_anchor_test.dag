module v2.test.manual.model_core_anchor


test fn model_core_bool_width_fact_holds() -> Bool {
  match v2.std.model_core.model_core_bool_fact_lookup(
    facts: v2.std.logic.bool_primitive_facts,
    axis: discriminant(v: v2.std.model_core.ModelCoreFactAxisWidth {})
  ) {
    v2.std.witness.Holds { value } => value == v2.std.logic.bool_width_fact_node(width: bool_primitive_facts.width)
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

test fn model_core_bool_encoding_fact_holds() -> Bool {
  match v2.std.model_core.model_core_bool_fact_lookup(
    facts: v2.std.logic.bool_primitive_facts,
    axis: discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {})
  ) {
    v2.std.witness.Holds { value } => value == v2.std.logic.bool_encoding_fact_node(encoding: bool_primitive_facts.encoding)
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

test fn model_core_bool_unbound_axes_fail_closed() -> Bool {
  match v2.std.model_core.model_core_bool_fact_lookup(
    facts: v2.std.logic.bool_primitive_facts,
    axis: discriminant(v: v2.std.model_core.ModelCoreFactAxisSignedness {})
  ) {
    v2.std.witness.Holds { value: _ } => false
    v2.std.witness.Violates { diagnostic: _ } => true
  }
}

test fn model_core_primitives_contract() -> Bool {
  (v2.std.algebra.length(xs: v2.std.model_core.bool_model_core().primitives) == 1) &&
  model_core_first_primitive_substrate(core: v2.std.model_core.bool_model_core()) ==
    v2.std.logic.bool_primitive_facts_node(facts: v2.std.logic.bool_primitive_facts) &&
  v2.std.model_core.model_core_bool_primitive_bundle().substrate_carrier ==
    v2.std.logic.bool_primitive_facts_node(facts: v2.std.logic.bool_primitive_facts) &&
  model_core_bool_width_fact_holds() &&
  model_core_bool_encoding_fact_holds() &&
  model_core_bool_unbound_axes_fail_closed()
}

test fn model_core_inhabitance_contract() -> Bool {
  v2.std.model_core.bool_model_core().inhabitance == [v2.std.model_core.model_core_bool_inhabitance()]
}

test fn model_core_laws_contract() -> Bool {
  v2.std.model_core.bool_model_core().laws == [
    v2.std.model_core.model_core_bool_law_obligation(key: v2.std.model_core.ModelCoreBoolBoundedLatticeIdentities),
    v2.std.model_core.model_core_bool_law_obligation(key: v2.std.model_core.ModelCoreBoolDistributivity),
    v2.std.model_core.model_core_bool_law_obligation(key: v2.std.model_core.ModelCoreBoolComplementInvolution),
    v2.std.model_core.model_core_bool_law_obligation(key: v2.std.model_core.ModelCoreBoolComplementBounds),
  ]
}

test fn model_core_payload_contract_holds() -> Bool {
  let core = v2.std.model_core.bool_model_core()
  (v2.std.model_core.bool_model_core().inhabitance == core.inhabitance) &&
  (v2.std.model_core.bool_model_core().laws == core.laws) &&
  (model_core_first_primitive_substrate(core: v2.std.model_core.bool_model_core()) ==
    model_core_first_primitive_substrate(core: core)) &&
  (v2.std.algebra.length(xs: core.primitives) == 1) &&
  (v2.std.algebra.length(xs: core.inhabitance) == 1) &&
  (v2.std.algebra.length(xs: core.laws) == 4) &&
  (v2.std.algebra.length(xs: core.partiality.operations) == 0) &&
  model_core_primitives_contract() &&
  model_core_inhabitance_contract() &&
  model_core_laws_contract()
}
