fn body_lowering_tree_contains_atom(root: v2.std.node.Node, wanted: Symbol) -> Bool {
  match node_atom_identity_optional(node: root) {
    v2.std.optional.Present { value: id } =>
      if id == wanted {
        true
      } else {
        false
      }
    v2.std.optional.Absent =>
      fold(root.children, init: false, f: fn(found, e) {
        if found {
          true
        } else {
          body_lowering_tree_contains_atom(root: e.target, wanted: wanted)
        }
      })
  }
}

test fn body_lowering_fixture_resolves() -> Bool {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.normalized_tree.admit_normalized_tree(root: v2.extdeps.languages.dag.dag_add_arrow_with_body_fixture, diagnostics: v2.std.diagnostic.None) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: admitted, diagnostics: _ } =>
      match v2.compiler.resolve.resolve(tree: admitted, lm: lm) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

fn body_lowering_transform_operand_identities(arrow: v2.std.node.Node) -> List<Symbol> {
  match v2.std.node_query.find_arrow_body_child(root: arrow) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        v2.std.node.ComputationNode { behavior: v2.std.node.Transform } =>
          fold(body.children, init: std.algebra.Empty, f: fn(acc, e) {
            match e.label {
              Positional =>
                match v2.std.collection.list_at_optional(xs: acc, index: 0) {
                  v2.std.optional.Present { value: _ } => acc
                  v2.std.optional.Absent =>
                    match node_atom_identity_optional(node: e.target) {
                      v2.std.optional.Present { value: id } => [id]
                      v2.std.optional.Absent => acc
                    }
                }
              _ => acc
            }
          })
        _ => std.algebra.Empty
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => std.algebra.Empty
  }
}

test fn body_lowering_normalized_operator_is_plus() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          match v2.std.node_query.find_arrow_body_child(root: arrow) {
            v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
              match body.kind {
                v2.std.node.ComputationNode { behavior: v2.std.node.Transform } =>
                  if count(body.children) >= 1 {
                    match first(body.children) {
                      v2.std.optional.Present { value: e0 } =>
                        match node_atom_identity_optional(node: e0.target) {
                          v2.std.optional.Present { value: id } => id == ^dag_token_plus
                          v2.std.optional.Absent => false
                        }
                      v2.std.optional.Absent => false
                    }
                  } else {
                    false
                  }
                _ => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn body_lower_arrow_operand_identity(arrow: v2.std.node.Node, index: Int) -> v2.std.optional.Optional<Symbol> {
  match v2.std.node_query.find_arrow_body_child(root: arrow) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
      match v2.std.collection.list_at_optional(xs: body.children, index: index) {
        v2.std.optional.Present { value: e } => node_atom_identity_optional(node: e.target)
        v2.std.optional.Absent => v2.std.optional.Absent
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
  }
}

fn body_lowering_domain_named_count(arrow: v2.std.node.Node) -> Int {
  if count(arrow.children) >= 1 {
    match first(arrow.children) {
      v2.std.optional.Present { value: e0 } =>
        fold(e0.target.children, init: 0, f: fn(n, e) {
          match e.label {
            Named { name: _ } => n + 1
            _ => n
          }
        })
      v2.std.optional.Absent => 0
    }
  } else {
    0
  }
}

test fn body_lowering_normalized_domain_has_two_params() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          body_lowering_domain_named_count(arrow: arrow) == 2
      }
  }
}

test fn body_lowering_normalized_operand2_lexeme_is_y() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          match body_lower_arrow_operand_identity(arrow: arrow, index: 2) {
            v2.std.optional.Present { value: id } => v2.std.compilers.lexing.symbol_lexeme(sym: id) == "y"
            v2.std.optional.Absent => false
          }
      }
  }
}

fn body_lowering_normalized_operands_swapped() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          match body_lower_arrow_operand_identity(arrow: arrow, index: 1) {
            v2.std.optional.Present { value: left } =>
              match body_lower_arrow_operand_identity(arrow: arrow, index: 2) {
                v2.std.optional.Present { value: right } =>
                  if count(arrow.children) >= 1 {
                    match first(arrow.children) {
                      v2.std.optional.Present { value: e0 } =>
                        match v2.std.collection.list_at_optional(xs: e0.target.children, index: 0) {
                          v2.std.optional.Present { value: de0 } =>
                            match v2.std.collection.list_at_optional(xs: e0.target.children, index: 1) {
                              v2.std.optional.Present { value: de1 } =>
                                match de0.label {
                                  Named { name: bind0 } =>
                                    match de1.label {
                                      Named { name: bind1 } =>
                                        (left == bind1) && (right == bind0)
                                      _ => false
                                    }
                                  _ => false
                                }
                              v2.std.optional.Absent => false
                            }
                          v2.std.optional.Absent => false
                        }
                      v2.std.optional.Absent => false
                    }
                  } else {
                    false
                  }
                v2.std.optional.Absent => false
              }
            v2.std.optional.Absent => false
          }
      }
  }
}

fn body_lowering_transform_child_count(arrow: v2.std.node.Node) -> Int {
  match v2.std.node_query.find_arrow_body_child(root: arrow) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } => count(body.children)
    v2.std.diagnostic.Rejected { diagnostics: _ } => 0
  }
}

test fn body_lowering_normalized_transform_has_three_children() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          body_lowering_transform_child_count(arrow: arrow) == 3
      }
  }
}

test fn body_lowering_domain_operand2_match() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          if count(arrow.children) >= 1 {
            match first(arrow.children) {
              v2.std.optional.Present { value: e0 } =>
                match v2.std.collection.list_at_optional(xs: e0.target.children, index: 1) {
                  v2.std.optional.Present { value: de1 } =>
                    match de1.label {
                      Named { name: domain_binding } =>
                        match body_lower_arrow_operand_identity(arrow: arrow, index: 2) {
                          v2.std.optional.Present { value: operand } => domain_binding == operand
                          v2.std.optional.Absent => false
                        }
                      _ => false
                    }
                  v2.std.optional.Absent => false
                }
              v2.std.optional.Absent => false
            }
          } else {
            false
          }
      }
  }
}

fn body_lower_arrow_domain_first_binding(arrow: v2.std.node.Node) -> v2.std.optional.Optional<Symbol> {
  if count(arrow.children) >= 1 {
    match first(arrow.children) {
      v2.std.optional.Present { value: e0 } =>
        fold(e0.target.children, init: optional_absent(), f: fn(found, e) {
          match found {
            v2.std.optional.Present { value: _ } => found
            v2.std.optional.Absent =>
              match e.label {
                Named { name: sym } => v2.std.optional.Present { value: sym }
                _ => optional_absent()
              }
          }
        })
      v2.std.optional.Absent => v2.std.optional.Absent
    }
  } else {
    v2.std.optional.Absent
  }
}

test fn body_lowering_domain_operand1_match() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          match body_lower_arrow_domain_first_binding(arrow: arrow) {
            v2.std.optional.Present { value: domain_binding } =>
              match body_lower_arrow_operand_identity(arrow: arrow, index: 1) {
                v2.std.optional.Present { value: operand } => domain_binding == operand
                v2.std.optional.Absent => false
              }
            v2.std.optional.Absent => false
          }
      }
  }
}

fn body_lowering_parsed_has_param_bindings() -> Bool {
  match body_lowering_parsed_fn_decl() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: fn_decl } =>
      body_lowering_tree_contains_atom(root: fn_decl, wanted: ^dag_binding_param_x)
        && body_lowering_tree_contains_atom(root: fn_decl, wanted: ^dag_binding_param_y)
  }
}

test fn body_lowering_normalized_operand1_lexeme_is_x() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          match body_lower_arrow_operand_identity(arrow: arrow, index: 1) {
            v2.std.optional.Present { value: id } => v2.std.compilers.lexing.symbol_lexeme(sym: id) == "x"
            v2.std.optional.Absent => false
          }
      }
  }
}

fn body_lowering_operand_equals(arrow: v2.std.node.Node, index: Int, wanted: Symbol) -> Bool {
  match body_lower_arrow_operand_identity(arrow: arrow, index: index) {
    v2.std.optional.Present { value: id } => id == wanted
    v2.std.optional.Absent => false
  }
}

fn body_lowering_normalized_left_is_param_x() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          body_lowering_operand_equals(arrow: arrow, index: 1, wanted: ^dag_binding_param_x)
      }
  }
}

fn body_lowering_normalized_right_is_param_y() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          body_lowering_operand_equals(arrow: arrow, index: 2, wanted: ^dag_binding_param_y)
      }
  }
}

fn body_lowering_normalized_matches_fixture_operands() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: normalized_arrow } =>
          match body_lower_arrow_operand_identity(arrow: normalized_arrow, index: 1) {
            v2.std.optional.Present { value: norm_left } =>
              match body_lower_arrow_operand_identity(arrow: normalized_arrow, index: 2) {
                v2.std.optional.Present { value: norm_right } =>
                  match body_lower_arrow_operand_identity(arrow: v2.extdeps.languages.dag.dag_add_arrow_with_body_fixture, index: 1) {
                    v2.std.optional.Present { value: fix_left } =>
                      match body_lower_arrow_operand_identity(arrow: v2.extdeps.languages.dag.dag_add_arrow_with_body_fixture, index: 2) {
                        v2.std.optional.Present { value: fix_right } =>
                          (norm_left == fix_left) && (norm_right == fix_right)
                        v2.std.optional.Absent => false
                      }
                    v2.std.optional.Absent => false
                  }
                v2.std.optional.Absent => false
              }
            v2.std.optional.Absent => false
          }
      }
  }
}

test fn body_lowering_normalized_left_operand_is_atom() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          match body_lower_arrow_operand_identity(arrow: arrow, index: 1) {
            v2.std.optional.Present { value: _ } => true
            v2.std.optional.Absent => false
          }
      }
  }
}

fn body_lowering_left_operand_is_param_x() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      body_lowering_tree_contains_atom(root: tree.root, wanted: ^dag_binding_param_x)
        && body_lowering_tree_contains_atom(root: tree.root, wanted: ^dag_binding_param_y)
  }
}

test fn body_lowering_normalized_arrow_root_resolves() -> Bool {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          match v2.compiler.normalized_tree.admit_normalized_tree(root: arrow, diagnostics: v2.std.diagnostic.None) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
            v2.std.diagnostic.Accepted { value: admitted_arrow, diagnostics: _ } =>
              match v2.compiler.resolve.resolve(tree: admitted_arrow, lm: lm) {
                v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
          }
      }
  }
}

test fn body_lowering_normalize_yields_arrow() -> Bool {
  match body_lowering_normalized_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lower_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          v2.std.node.well_formed(n: arrow)
            && match v2.std.node_query.find_arrow_body_child(root: arrow) {
              v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
                match body.kind {
                  v2.std.node.ComputationNode { behavior: v2.std.node.Transform } => true
                  _ => false
                }
              v2.std.diagnostic.Rejected { diagnostics: _ } => false
            }
      }
  }
}
