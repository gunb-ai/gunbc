module v2.test.manual.body_lowering_normalize_add


data body_lowering_add_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

fn body_lowering_normalized_module() -> v2.std.optional.Optional<v2.compiler.normalized_tree.NormalizedTree> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: body_lowering_add_module_source,
    file: ^body_lowering_add_probe_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
    v2.std.diagnostic.Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: artifact.tree) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
            v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } => v2.std.optional.Present { value: tree }
          }
      }
  }
}

fn body_lower_find_arrow_in_module(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } => v2.std.optional.Present { value: root }
    _ =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => body_lower_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn body_lower_find_fn_decl(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: root) {
    v2.std.optional.Present { value: emitted } =>
      match emitted == ^dag_surface_fn_decl {
        true => v2.std.optional.Present { value: root }
        false =>
          fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
            match acc {
              v2.std.optional.Present { value: _ } => acc
              v2.std.optional.Absent => body_lower_find_fn_decl(root: e.target)
            }
          })
      }
    v2.std.optional.Absent =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => body_lower_find_fn_decl(root: e.target)
        }
      })
  }
}

fn body_lowering_parsed_fn_decl() -> v2.std.optional.Optional<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: body_lowering_add_module_source,
    file: ^body_lowering_add_probe_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
    v2.std.diagnostic.Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          body_lower_find_fn_decl(root: artifact.tree)
      }
  }
}

fn body_lower_has_arrow_token(root: v2.std.node.Node) -> Bool {
  match node_atom_identity_optional(node: root) {
    v2.std.optional.Present { value: id } => id == ^dag_token_arrow
    v2.std.optional.Absent =>
      fold(root.children, init: false, f: fn(acc, e) {
        if acc {
          true
        } else {
          body_lower_has_arrow_token(root: e.target)
        }
      })
  }
}

test fn body_lowering_fn_body_subtree_holds() -> Bool {
  match body_lowering_parsed_fn_decl() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: fn_decl } =>
      match v2.compiler.body_lowering_fold.body_lower_unwrap_captured(shell: fn_decl) {
        v2.std.optional.Present { value: captured } =>
          match v2.extdeps.languages.dag.parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_fn_body) {
            v2.extdeps.languages.dag.ParseSubtreeFound { captured: _ } => true
            v2.extdeps.languages.dag.ParseSubtreeAbsent => false
          }
        v2.std.optional.Absent => false
      }
  }
}

test fn body_lowering_arrow_token_holds() -> Bool {
  match body_lowering_parsed_fn_decl() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: fn_decl } =>
      match v2.compiler.body_lowering_fold.body_lower_unwrap_captured(shell: fn_decl) {
        v2.std.optional.Present { value: captured } => body_lower_has_arrow_token(root: captured)
        v2.std.optional.Absent => false
      }
  }
}

fn body_lower_collect_atoms(root: v2.std.node.Node, acc: List<Symbol>) -> List<Symbol> {
  let acc1 = match node_atom_identity_optional(node: root) {
    v2.std.optional.Present { value: id } => std.algebra.Cons { head: id, tail: acc }
    v2.std.optional.Absent => acc
  }
  fold(root.children, init: acc1, f: fn(a, e) {
    body_lower_collect_atoms(root: e.target, acc: a)
  })
}

test fn body_lowering_has_plus_token() -> Bool {
  match body_lowering_parsed_fn_decl() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: fn_decl } =>
      match v2.compiler.body_lowering_fold.body_lower_unwrap_captured(shell: fn_decl) {
        v2.std.optional.Present { value: captured } =>
          fold(
            body_lower_collect_atoms(root: captured, acc: std.algebra.Empty),
            init: false,
            f: fn(acc, sym) { acc || sym == ^dag_token_plus }
          )
        v2.std.optional.Absent => false
      }
  }
}

