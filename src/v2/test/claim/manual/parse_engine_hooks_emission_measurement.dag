module v2.test.claim.manual.parse_engine_hooks_emission_measurement

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
  observe_provenanced_rust_emission_from_ingest
}
import v2.compiler.self_host.direct_rust_door_fixture {
  direct_rust_door_admission,
  direct_rust_door_ingest,
  direct_rust_door_ingest_artifact,
  direct_rust_door_module_path
}
import v2.extdeps.languages.rust { rust_target_model }
import std.algebra { Cons, Empty }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.text { String }
import v2.std.node { Symbol }
import v2.std.algebra { fold_list }
import v2.std.collection { Int }


data measurement_note: String = "MEASUREMENT INSTRUMENT, not a witness. Deliberately plain fns so nothing enrolls. Answers one question by execution: which stage of observe_provenanced_rust_emission_from_ingest first refuses for a module-level data declaration, which is the shape parse_engine_hooks is made of. The historical blocker description says emission is absent for module-level data; this measures whether that is still where it stops, because building a renderer from a description rather than a measurement is how a lane spends days on a stage the pipeline never reaches."

data pmh_module_source: String = "module data_probe\n\ndata probe_value: Int = 7\n"

data pmh_fn_module_source: String = "module data_probe\n\nfn probe_value() -> Int { 7 }\n"

data pmh_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^pmh_ingest_artifact,
  file_path: "src/v2/test/claim/manual/parse_engine_hooks_emission_measurement.dag"
}

data pmh_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: pmh_module_source, fidelity: Lossless },
  artifact: pmh_artifact,
  compilation_unit: ^pmh_data_probe_cu,
  source_root: V2Tree
}

fn pmh_ingest() -> SourceRootIngest {
  Cons { head: pmh_read, tail: Empty }
}

fn pmh_admission() -> Admission {
  Admission {
    subject: ResolutionSubject { name: Cons { head: ^data_probe, tail: Empty } },
    imports: Empty
  }
}

fn measure_module_data_emission_stage() -> String {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: pmh_ingest(),
    admission: pmh_admission(),
    target: rust_target_model(),
    module_path: "src/v2/compiler/parse_engine_hooks.dag"
  ) {
    AssemblyRejected { diagnostics: _ } => "STAGE=AssemblyRejected"
    InferenceRejected { diagnostics: _ } => "STAGE=InferenceRejected"
    EmissionRejected { diagnostics: _ } => "STAGE=EmissionRejected"
    ProducerReceiptRejected { diagnostics: _ } => "STAGE=ProducerReceiptRejected"
    ArtifactProduced { artifact: _ } => "STAGE=ArtifactProduced"
  }
}

// CONTROL. Runs the SAME instrument over an ingest that is known to assemble --
// the direct-rust-door fixture, a plain fn module. If this ALSO reported
// AssemblyRejected the instrument would be measuring its own synthetic ingest
// rather than the pipeline, and the data-declaration reading would be worthless.
// The two differ only in the ingested module, so the stage difference is
// attributable to the module shape and nothing else.
fn measure_control_fn_module_stage() -> String {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: direct_rust_door_ingest(),
    admission: direct_rust_door_admission(),
    target: rust_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    AssemblyRejected { diagnostics: _ } => "CONTROL=AssemblyRejected"
    InferenceRejected { diagnostics: _ } => "CONTROL=InferenceRejected"
    EmissionRejected { diagnostics: _ } => "CONTROL=EmissionRejected"
    ProducerReceiptRejected { diagnostics: _ } => "CONTROL=ProducerReceiptRejected"
    ArtifactProduced { artifact: _ } => "CONTROL=ArtifactProduced"
  }
}

// SECOND CONTROL, isolating the one variable the first control leaves confounded.
// The door control differs from the subject in TWO ways: fn-versus-data AND its
// own ingest/admission wiring. This one holds my wiring, my module name, my
// admission and my artifact fixed and changes ONLY the declaration form, so a
// stage difference here is attributable to data-versus-fn and to nothing else.
// If this also reported AssemblyRejected, the subject reading would be about my
// instrument rather than about module-level data.
data pmh_fn_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: pmh_fn_module_source, fidelity: Lossless },
  artifact: pmh_artifact,
  compilation_unit: ^pmh_data_probe_cu,
  source_root: V2Tree
}

fn measure_synthetic_fn_module_stage() -> String {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: Cons { head: pmh_fn_read, tail: Empty },
    admission: pmh_admission(),
    target: rust_target_model(),
    module_path: "src/v2/compiler/parse_engine_hooks.dag"
  ) {
    AssemblyRejected { diagnostics: _ } => "SYNTHFN=AssemblyRejected"
    InferenceRejected { diagnostics: _ } => "SYNTHFN=InferenceRejected"
    EmissionRejected { diagnostics: _ } => "SYNTHFN=EmissionRejected"
    ProducerReceiptRejected { diagnostics: _ } => "SYNTHFN=ProducerReceiptRejected"
    ArtifactProduced { artifact: _ } => "SYNTHFN=ArtifactProduced"
  }
}

// THE ISOLATED SUBJECT, after the second control refuted the first reading.
// My own synthetic wiring does not assemble at all -- its fn form refuses at the
// same stage as its data form -- so the earlier data-versus-fn conclusion was a
// fact about the instrument, not the pipeline. This holds the DOOR's wiring
// fixed (its artifact, its compilation unit, its module name, its admission) and
// changes exactly one thing: the declaration inside the module. Against
// measure_control_fn_module_stage, which shares all of that and carries a fn,
// any stage difference is attributable to the declaration form alone.
data pmh_door_shaped_data_source: String = "module add_probe\n\ndata probe_value: Int = 7\n"

data pmh_door_shaped_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: pmh_door_shaped_data_source, fidelity: Lossless },
  artifact: direct_rust_door_ingest_artifact,
  compilation_unit: ^direct_rust_door_add_probe_cu,
  source_root: V2Tree
}

fn measure_door_shaped_data_module_stage() -> String {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: Cons { head: pmh_door_shaped_read, tail: Empty },
    admission: direct_rust_door_admission(),
    target: rust_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    AssemblyRejected { diagnostics: _ } => "DATASUBJ=AssemblyRejected"
    InferenceRejected { diagnostics: _ } => "DATASUBJ=InferenceRejected"
    EmissionRejected { diagnostics: _ } => "DATASUBJ=EmissionRejected"
    ProducerReceiptRejected { diagnostics: _ } => "DATASUBJ=ProducerReceiptRejected"
    ArtifactProduced { artifact: _ } => "DATASUBJ=ArtifactProduced"
  }
}

// The REASON, not only the stage. A stage name says where it stopped; the
// diagnostic reason says what it objected to, and only the second one tells
// anyone what to build. Reported with the diagnostic count because a single
// reason read off a multi-diagnostic refusal would misrepresent the refusal
// as narrower than it is.
fn measure_door_shaped_data_reason() -> Symbol {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: Cons { head: pmh_door_shaped_read, tail: Empty },
    admission: direct_rust_door_admission(),
    target: rust_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    AssemblyRejected { diagnostics: d } => d.head.reason
    InferenceRejected { diagnostics: d } => d.head.reason
    EmissionRejected { diagnostics: d } => d.head.reason
    ProducerReceiptRejected { diagnostics: d } => d.head.reason
    ArtifactProduced { artifact: _ } => ^no_refusal_artifact_was_produced
  }
}

fn measure_control_fn_reason() -> Symbol {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: direct_rust_door_ingest(),
    admission: direct_rust_door_admission(),
    target: rust_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    AssemblyRejected { diagnostics: d } => d.head.reason
    InferenceRejected { diagnostics: d } => d.head.reason
    EmissionRejected { diagnostics: d } => d.head.reason
    ProducerReceiptRejected { diagnostics: d } => d.head.reason
    ArtifactProduced { artifact: _ } => ^no_refusal_artifact_was_produced
  }
}

// THE TAIL, NOT THE HEAD. rejected_with_pending PREPENDS the grammar-global overlap
// residue onto a later rejection, so d.head.reason is a constant for ANY parse failure
// of ANY module and discriminates nothing. These read position two and the diagnostic
// count, which is where the actual cause lives.
fn measure_door_shaped_data_second_reason() -> Symbol {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: Cons { head: pmh_door_shaped_read, tail: Empty },
    admission: direct_rust_door_admission(),
    target: rust_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    AssemblyRejected { diagnostics: d } =>
      match d.tail {
        Cons { head: h2, tail: _ } => h2.reason
        Empty => ^tail_is_empty_head_was_the_only_diagnostic
      }
    InferenceRejected { diagnostics: _ } => ^unexpected_stage_inference
    EmissionRejected { diagnostics: _ } => ^unexpected_stage_emission
    ProducerReceiptRejected { diagnostics: _ } => ^unexpected_stage_receipt
    ArtifactProduced { artifact: _ } => ^no_refusal_artifact_was_produced
  }
}

fn measure_door_shaped_data_third_reason() -> Symbol {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: Cons { head: pmh_door_shaped_read, tail: Empty },
    admission: direct_rust_door_admission(),
    target: rust_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    AssemblyRejected { diagnostics: d } =>
      match d.tail {
        Cons { head: _, tail: t2 } =>
          match t2 {
            Cons { head: h3, tail: _ } => h3.reason
            Empty => ^only_two_diagnostics
          }
        Empty => ^tail_is_empty_head_was_the_only_diagnostic
      }
    InferenceRejected { diagnostics: _ } => ^unexpected_stage_inference
    EmissionRejected { diagnostics: _ } => ^unexpected_stage_emission
    ProducerReceiptRejected { diagnostics: _ } => ^unexpected_stage_receipt
    ArtifactProduced { artifact: _ } => ^no_refusal_artifact_was_produced
  }
}

// ALL SEVEN roster rows are prepended, so positions 1..7 are the constant and the
// cause begins at 8. This folds the whole list and keeps the FIRST reason that is
// not the residue, which is the only reading that survives the prepend.
fn pmh_first_non_residue(d) -> Symbol {
  fold_list(
    xs: d,
    empty: ^no_non_residue_diagnostic_present,
    cons: (acc, diag) =>
      if acc == ^no_non_residue_diagnostic_present && diag.reason != ^parse_grammar_choice_overlap_residue {
        diag.reason
      } else {
        acc
      }
  )
}

fn pmh_diagnostic_count(d) -> Int {
  fold_list(xs: d, empty: 0, cons: (acc, _) => acc + 1)
}

fn measure_door_shaped_data_true_cause() -> Symbol {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: Cons { head: pmh_door_shaped_read, tail: Empty },
    admission: direct_rust_door_admission(),
    target: rust_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    AssemblyRejected { diagnostics: d } => pmh_first_non_residue(d: d)
    InferenceRejected { diagnostics: d } => pmh_first_non_residue(d: d)
    EmissionRejected { diagnostics: d } => pmh_first_non_residue(d: d)
    ProducerReceiptRejected { diagnostics: d } => pmh_first_non_residue(d: d)
    ArtifactProduced { artifact: _ } => ^no_refusal_artifact_was_produced
  }
}

fn measure_door_shaped_data_diagnostic_count() -> Int {
  match observe_provenanced_rust_emission_from_ingest(
    ingest: Cons { head: pmh_door_shaped_read, tail: Empty },
    admission: direct_rust_door_admission(),
    target: rust_target_model(),
    module_path: direct_rust_door_module_path
  ) {
    AssemblyRejected { diagnostics: d } => pmh_diagnostic_count(d: d)
    InferenceRejected { diagnostics: d } => pmh_diagnostic_count(d: d)
    EmissionRejected { diagnostics: d } => pmh_diagnostic_count(d: d)
    ProducerReceiptRejected { diagnostics: d } => pmh_diagnostic_count(d: d)
    ArtifactProduced { artifact: _ } => 0
  }
}
