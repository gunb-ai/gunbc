module v2.test.manual.typescript_bind_let_iife_emit


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn bind_let_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^bind_let_binding_k, "k"),
      ^bind_let_binding_v,
      "v"
    ),
    ^bind_let_binding_b,
    "b"
  )
}

fn bind_let_target_model() -> TargetModel {
  TargetModel {
    bundle: ts_target_model_node(),
    lex: ts_lex(),
    binding_spellings: bind_let_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn ts_bind_let_expr() -> TargetValueExpression {
  target_value_expression_bind_let(
    bind_key: target_value_expression_binding_ref(binding: ^bind_let_binding_k),
    bind_value: target_value_expression_binding_ref(binding: ^bind_let_binding_v),
    bind_body: target_value_expression_binding_ref(binding: ^bind_let_binding_b)
  )
}

fn ts_bind_let_emit_with_projection(
  projection: TargetValueExpressionProjection
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: target_value_expression_to_concrete_tokens(
      expr: ts_bind_let_expr(),
      projection: projection,
      catalog: ts_operator_realizations_catalog_node()
    ),
    f: fn(tokens) {
      serialize_concrete_syntax_tokens_to_source(
        target: bind_let_target_model(),
        tokens: tokens
      )
    }
  )
}

fn ts_bind_let_emit_statement_sequenced() -> String {
  match ts_bind_let_emit_with_projection(
    projection: ts_value_expression_projection()
  ) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => "BIND_LET_EMIT_REJECTED"
  }
}

fn ts_bind_let_emit_value_producing() -> String {
  match ts_bind_let_emit_with_projection(
    projection: ts_value_expression_projection_with_block_evaluation_mode(
      block_evaluation_mode: ValueProducing
    )
  ) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => "BIND_LET_EMIT_REJECTED"
  }
}

test fn ts_bind_let_iife_emit_exact_holds() -> Bool {
  ts_bind_let_emit_statement_sequenced() == "(function () { let k =v;return b; })()"
}

test fn ts_bind_let_mode_perturbation_flips_holds() -> Bool {
  (ts_bind_let_emit_statement_sequenced() == "(function () { let k =v;return b; })()")
    && (ts_bind_let_emit_statement_sequenced() != ts_bind_let_emit_value_producing())
    && (ts_bind_let_emit_statement_sequenced() != "BIND_LET_EMIT_REJECTED")
}

fn block_construct_loop_expr() -> TargetValueExpression {
  target_value_expression_loop(
    body: target_value_expression_binding_ref(binding: ^bind_let_binding_b)
  )
}

test fn ts_loop_statement_sequenced_fails_closed_holds() -> Bool {
  match target_value_expression_to_concrete_tokens(
    expr: block_construct_loop_expr(),
    projection: ts_value_expression_projection(),
    catalog: ts_operator_realizations_catalog_node()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn dag_loop_value_producing_emits_holds() -> Bool {
  match target_value_expression_to_concrete_tokens(
    expr: block_construct_loop_expr(),
    projection: dag_value_expression_projection(),
    catalog: dag_operator_realizations_catalog_node()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn block_construct_closure_expr() -> TargetValueExpression {
  target_value_expression_closure(
    params: [^bind_let_binding_k],
    body: target_value_expression_binding_ref(binding: ^bind_let_binding_b)
  )
}

test fn ts_closure_statement_sequenced_fails_closed_holds() -> Bool {
  match target_value_expression_to_concrete_tokens(
    expr: block_construct_closure_expr(),
    projection: ts_value_expression_projection(),
    catalog: ts_operator_realizations_catalog_node()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn dag_closure_value_producing_emits_holds() -> Bool {
  match target_value_expression_to_concrete_tokens(
    expr: block_construct_closure_expr(),
    projection: dag_value_expression_projection(),
    catalog: dag_operator_realizations_catalog_node()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
