data bisect_empty_source: Medium<String> = Medium { carried: "module stage0.bisect.empty\n", fidelity: Lossless }
data bisect_add_module_source: Medium<String> = Medium { carried: "module bisect.add\n\nfn add(x:Int, y:Int) -> Int { x + y }", fidelity: Lossless }
data bisect_add_module_truncated_source: Medium<String> = Medium { carried: "module bisect.add\n\nfn add(x:Int, y:Int) -> Int { x + ", fidelity: Lossless }
fn bisect_through_tokenize() -> Outcome<TokenStream> {
  let lm = dag_language_model()
  tokenize(
    text: bisect_empty_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  )
}

fn bisect_through_parse() -> Outcome<ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      parse(tokens: token_stream, grammar: lm.grammar)
    }
  )
}

fn bisect_through_normalize() -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          normalize(parse_tree: parse_tree)
        }
      )
    }
  )
}

fn bisect_tokenize_terminates() -> Bool {
  match bisect_through_tokenize() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_parse_terminates() -> Bool {
  match bisect_through_parse() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_through_grammar_validate() -> Outcome<ValidatedGrammarRoot> {
  let lm = dag_language_model()
  match lm.grammar {
    ModeledGrammar { root: root } =>
      grammar_validate_for_parse(root: root, at: port_locus(port: ^parse_stage_locus_port))
    _ =>
      Rejected { diagnostics: None }
  }
}

fn bisect_grammar_validate_terminates() -> Bool {
  match bisect_through_grammar_validate() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_through_parse_production() -> Outcome<ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: bisect_through_grammar_validate(),
        f: fn(validated) {
          match lm.grammar {
            ModeledGrammar { root: root } =>
              parse_production_tree(
                tokens: token_stream_remaining(stream: token_stream),
                validated: validated,
                production_name: root.start
              )
            _ =>
              Rejected { diagnostics: None }
          }
        }
      )
    }
  )
}

fn bisect_parse_production_terminates() -> Bool {
  match bisect_through_parse_production() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_single_module_parse_expr() -> Bool {
  let lm = dag_language_model()
  match lm.grammar {
    ModeledGrammar { root: root } =>
      bind_outcome(
        o: tokenize(
          text: bisect_empty_source.carried,
          file: ^compile_ingest_staging_source_file,
          rules: lm.lex
        ),
        f: fn(token_stream) {
          match grammar_lookup_production(root: root, name: root.start) {
            Holds { value: production } =>
              match parse_expr(
                expr: production.expression,
                tokens: token_stream_remaining(stream: token_stream),
                all_tokens: token_stream_all(stream: token_stream),
                root: root,
                table: parse_table_empty(),
                prov: parse_prov_initial()
              ) {
                ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: _ } =>
                  outcome_accepted(value: true)
                ParseExprRejected { diagnostics: _, table: _ } =>
                  outcome_accepted(value: true)
              }
            Violates { diagnostic: _ } =>
              Rejected { diagnostics: None }
          }
        }
      )
    _ =>
      Rejected { diagnostics: None }
  }
}

fn bisect_single_module_parse_expr_terminates() -> Bool {
  match bisect_single_module_parse_expr() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_normalize_terminates() -> Bool {
  match bisect_through_normalize() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_find_fn_decl(root: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: emitted } =>
      match emitted == ^dag_surface_fn_decl {
        true => Present { value: root }
        false =>
          fold(root.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => bisect_find_fn_decl(root: e.target)
            }
          })
      }
    Absent =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => bisect_find_fn_decl(root: e.target)
        }
      })
  }
}

fn bisect_parsed_add_module() -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(
    text: bisect_add_module_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse(tokens: ts, grammar: lm.grammar) {
        Accepted { value: parsed, diagnostics: _ } => Present { value: parsed }
        Rejected { diagnostics: _ } => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

fn bisect_add_domain_holds() -> Bool {
  match bisect_parsed_add_module() {
    Absent => false
    Present { value: tree } =>
      match bisect_find_fn_decl(root: tree) {
        Absent => false
        Present { value: fn_decl } =>
          match body_lower_unwrap_captured(shell: fn_decl) {
            Present { value: captured } =>
              match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_param_list) {
                ParseSubtreeFound { captured: param_list } =>
                  match body_lower_domain_from_param_list(param_list: param_list) {
                    Present { value: _ } => true
                    Absent => false
                  }
                ParseSubtreeAbsent => false
              }
            Absent => false
          }
      }
  }
}

fn bisect_add_body_holds() -> Bool {
  match bisect_parsed_add_module() {
    Absent => false
    Present { value: tree } =>
      match bisect_find_fn_decl(root: tree) {
        Absent => false
        Present { value: fn_decl } =>
          match body_lower_unwrap_captured(shell: fn_decl) {
            Present { value: captured } =>
              match body_lower_body_from_fn_captured(captured: captured) {
                Present { value: _ } => true
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn bisect_add_return_holds() -> Bool {
  match bisect_parsed_add_module() {
    Absent => false
    Present { value: tree } =>
      match bisect_find_fn_decl(root: tree) {
        Absent => false
        Present { value: fn_decl } =>
          match body_lower_unwrap_captured(shell: fn_decl) {
            Present { value: captured } =>
              match body_lower_return_type_from_fn_captured(captured: captured) {
                Present { value: _ } => true
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn bisect_add_arrow_lowering_accepts() -> Bool {
  match bisect_parsed_add_module() {
    Absent => false
    Present { value: tree } =>
      match bisect_find_fn_decl(root: tree) {
        Absent => false
        Present { value: fn_decl } =>
          match body_lower_fn_decl_to_arrow(shell: fn_decl) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn bisect_add_arrow_well_formed() -> Bool {
  match bisect_parsed_add_module() {
    Absent => false
    Present { value: tree } =>
      match bisect_find_fn_decl(root: tree) {
        Absent => false
        Present { value: fn_decl } =>
          match body_lower_fn_decl_to_arrow(shell: fn_decl) {
            Accepted { value: arrow, diagnostics: _ } => well_formed(n: arrow)
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

test fn witness_bisect_add_domain_holds() -> Bool { bisect_add_domain_holds() }
test fn witness_bisect_add_body_holds() -> Bool { bisect_add_body_holds() }
test fn witness_bisect_add_return_holds() -> Bool { bisect_add_return_holds() }
test fn witness_bisect_add_arrow_lowering_accepts() -> Bool { bisect_add_arrow_lowering_accepts() }
test fn witness_bisect_add_arrow_well_formed() -> Bool { bisect_add_arrow_well_formed() }

fn bisect_parse_module_add_parse_accepts() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: bisect_add_module_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      match parse(tokens: token_stream, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn bisect_parse_module_add_normalize_accepts() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: bisect_add_module_source.carried,
    file: ^compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      match parse(tokens: token_stream, grammar: lm.grammar) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
