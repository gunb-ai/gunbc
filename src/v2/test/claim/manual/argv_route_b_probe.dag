module test.claim.manual.argv_route_b_probe

import std.types { String, List }
import v2.std.algebra { fold_list }
import v2.std.operation_argv {
  ArgvMaterialization,
  ShellTransportOperationRow,
  operation_argv_is_materialized,
  operation_argv_is_executable_position_refusal,
  operation_argv_is_expression_residue,
  operation_argv_refusal_label,
  operation_argv_row_bindings,
}

data empty_labels: List<String> = []

fn row_m(row: ShellTransportOperationRow) -> ArgvMaterialization {
  shell_materialize_operation_argv(row.at.path, row.at.service, row.at.operation, operation_argv_row_bindings(row: row))
}

fn main() -> List<String> {
  fold_list(
    xs: shell_transport_operation_rows(),
    empty: empty_labels,
    cons: fn(acc, row) {
      let m = row_m(row: row)
      if operation_argv_is_materialized(m: m) {
        acc
      } else {
        append(acc, items: [operation_argv_refusal_label(m: m)])
      }
    }
  )
}
