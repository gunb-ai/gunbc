module v2.test.manual.go_grammar_claim


fn go_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^go_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^go_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn go_grammar_validates_fixture() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: go_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn go_grammar_parse_accepted() -> Bool {
  match go_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn go_grammar_parse_fixture() -> Outcome<ParseTree> {
  let at = port_locus(port: ^parse_stage_locus_port)
  match tokenize(
    text: go_source_text,
    file: ^go_parse_fixture_file,
    rules: go_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar_validate_for_parse(root: go_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          parse_production_tree(
            tokens: token_stream_remaining(stream: stream),
            validated: validated,
            production_name: ^go_production_fn_add
          )
      }
  }
}

data claim_go_grammar_validates: TestClaim = EqualsClaim {
  label: "go_grammar_root passes grammar_validate_for_parse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_claim_bool_atom(b: go_grammar_validates_fixture()),
  rhs: go_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_go_grammar_parses_tokens: TestClaim = EqualsClaim {
  label: "go production parse_production accepts lexer output for func-add source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_claim_bool_atom(b: go_grammar_parse_accepted()),
  rhs: go_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
