module v2.test.manual.nominal_distinctness_cross_call

data nominal_distinct_forbidden_authority_source_text: String = "nominal_distinct_forbidden_authority_source_text"

data nominal_distinct_records_source: extdeps.communication.medium.Medium<String> = extdeps.communication.medium.Medium { carried: "module nominal.distinct.records.probe\n\ntype WrapA {\n  value: Int\n}\n\ntype WrapB {\n  value: Int\n}\n\nfn expects_a(x: WrapA) -> Int = x.value\n\nfn call_site(b: WrapB) -> Int = expects_a(b)\n", fidelity: extdeps.communication.medium.Lossless }

data nominal_distinct_brands_source: extdeps.communication.medium.Medium<String> = extdeps.communication.medium.Medium { carried: "module nominal.distinct.desugared_brands.probe\n\ntype IntentId {\n  value: String\n}\n\ntype IssueId {\n  value: String\n}\n\nfn expects_intent(x: IntentId) -> String = x.value\n\nfn call_site(i: IssueId) -> String = expects_intent(i)\n", fidelity: extdeps.communication.medium.Lossless }
data nominal_distinct_control_source: extdeps.communication.medium.Medium<String> = extdeps.communication.medium.Medium { carried: "module nominal.distinct.control.probe\n\ntype WrapA {\n  value: Int\n}\n\nfn expects_a(x: WrapA) -> Int = x.value\n\nfn call_site(a: WrapA) -> Int = expects_a(a)\n", fidelity: extdeps.communication.medium.Lossless }
data nominal_distinct_compile_target: v2.std.compilers.target_model.TargetModel = v2.std.compilers.target_model.TargetModel {
  produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
  bundle: v2.extdeps.languages.rust.rust_target_model_node(),
  lex: v2.extdeps.languages.rust.rust_fn_add_lex(),
  binding_spellings: v2.extdeps.languages.rust.rust_binding_spellings(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
  authority_source_text: nominal_distinct_forbidden_authority_source_text,
  runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
}

fn nominal_distinct_input_node(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

data nominal_distinct_records_input: v2.std.node.Node = nominal_distinct_input_node(sym: ^nominal_distinct_records_input_symbol)
data nominal_distinct_brands_input: v2.std.node.Node = nominal_distinct_input_node(sym: ^nominal_distinct_brands_input_symbol)
data nominal_distinct_control_input: v2.std.node.Node = nominal_distinct_input_node(sym: ^nominal_distinct_control_input_symbol)

fn anchor_nominal_distinct_records_compile() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.compile.compile_ingest_staging(
    source: nominal_distinct_records_source,
    target: nominal_distinct_compile_target
  )
}

fn anchor_nominal_distinct_brands_compile() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.compile.compile_ingest_staging(
    source: nominal_distinct_brands_source,
    target: nominal_distinct_compile_target
  )
}

fn anchor_nominal_distinct_control_compile() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.compile.compile_ingest_staging(
    source: nominal_distinct_control_source,
    target: nominal_distinct_compile_target
  )
}

data nominal_distinct_records_compile_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_nominal_distinct_records_compile()
data nominal_distinct_brands_compile_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_nominal_distinct_brands_compile()
data nominal_distinct_control_compile_receipt: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> = anchor_nominal_distinct_control_compile()

test fn nominal_distinct_control_compiles_ok() -> Bool {
  match nominal_distinct_control_compile_receipt {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
