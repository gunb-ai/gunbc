module v2.test.manual.verilog_concurrency_anchor


type verilog_anchor_module = v2.extdeps.languages.verilog.VerilogModule
data verilog_anchor_comb_assign: v2.extdeps.languages.verilog.NetAssignment = v2.extdeps.languages.verilog.NetAssignment {
  lhs_lexeme: "wire_out",
  rhs_lexeme: "wire_in & enable"
}
data verilog_anchor_continuous_assign: v2.extdeps.languages.verilog.ContinuousAssign = v2.extdeps.languages.verilog.ContinuousAssign {
  drive_strength: NoDriveStrength,
  delay: NoDelay,
  assignments: [verilog_anchor_comb_assign]
}
data verilog_anchor_posedge_clk: v2.extdeps.languages.verilog.SensitivityItem = v2.extdeps.languages.verilog.SensitivityItem {
  trigger: PosEdge,
  event_expression_lexeme: "clk"
}
data verilog_anchor_posedge_always: v2.extdeps.languages.verilog.AlwaysBlock = v2.extdeps.languages.verilog.AlwaysBlock {
  sensitivity: v2.extdeps.languages.verilog.ExplicitEventList { items: [verilog_anchor_posedge_clk] },
  body_lexeme: "q <= d;"
}
data verilog_anchor_cost: v2.extdeps.languages.verilog.VerilogCost = v2.extdeps.languages.verilog.VerilogCost {
  gate_cost: 1,
  area_cost: 1
}
data verilog_anchor_module_fixture: verilog_anchor_module = v2.extdeps.languages.verilog.NoPortListModule {
  attributes: NoAttributeInstances,
  module_keyword: ModuleKw,
  name: ^verilog_anchor_q,
  parameter_port_list: NoModuleParameterPortList,
  items: [
    v2.extdeps.languages.verilog.ContinuousAssignItem {
      attributes: NoAttributeInstances,
      assign: verilog_anchor_continuous_assign
    },
    v2.extdeps.languages.verilog.AlwaysBlockItem {
      attributes: NoAttributeInstances,
      always_block: verilog_anchor_posedge_always
    }
  ]
}
