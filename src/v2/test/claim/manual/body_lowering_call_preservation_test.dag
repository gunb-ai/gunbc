module v2.test.manual.body_lowering_call_preservation

import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module, parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.staged_front_end {
  FrontEndBoundReached,
  FrontEndRefused,
  FrontEndResolvedModule,
  FrontEndStageRejected,
  FrontEndStagePassed,
  run_front_end
}
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model, dag_lex }
import v2.std.algebra { bag_eq, fold_list, list_snoc_item }
import v2.std.collection { list_at_optional }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.logic { Bool }
import v2.std.node { Named, Node, Symbol }
import v2.std.node_query { call_argument_targets, call_callee_target, node_is_call }
import v2.std.node_reflection {
  coproduct_arm_keys,
  coproduct_nullary_inhabitants
}
import v2.std.optional { Absent, Optional, Present }
import v2.std.text { String }

data call_preservation_declared_source: String = "module m\n\nfn g(x: Int) -> Int { x }\n\nfn caller() -> Int { g(x: 1) }\n"

data call_preservation_two_named_value_source: String = "module m\n\nfn caller(acc: Int, x: Int) -> Int { list_append(left: x, right: acc) }\n"

data call_preservation_two_arg_source: String = "module m\n\nfn g(x: Int, y: Int) -> Int { x }\n\nfn caller() -> Int { g(x: 1, y: 2) }\n"

data call_preservation_nested_source: String = "module m\n\nfn h(y: Int) -> Int { y }\n\nfn g(x: Int) -> Int { x }\n\nfn caller() -> Int { g(x: h(y: 5)) }\n"

data call_preservation_nested_earlier_arg_source: String = "module m\n\nfn h(y: Int) -> Int { y }\n\nfn g(x: Int, y: Int) -> Int { x }\n\nfn caller() -> Int { g(x: h(y: 5), y: 9) }\n"

data fold_fn_form_snippet: String = "module quad\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { acc })\n}\n"

data fold_arrow_form_snippet: String = "module arrowfold\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: (acc, x) => acc)\n}\n"

data fold_named_step_snippet: String = "module namedstep\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: step)\n}\n"

data pipe_fold_named_step_snippet: String = "module pipefold\n\nfn f(xs: List<Int>) -> Int {\n  xs |> fold(init: 0, f: step)\n}\n"

data fold_nested_call_inline_step_snippet: String = "module decoyfold\n\nfn f(xs: List<Int>) -> Int {\n  fold(map(xs, f: (a, b) => a), init: 0, f: (acc, x) => list_append(left: x, right: acc))\n}\n"

data call_preservation_undeclared_source: String = "module m\n\nfn caller() -> Int { undefined_callee_zzz(a: 1) }\n"

data imported_callee_call_source: String = "module callcount\n\nimport v2.std.algebra { length }\n\nfn caller(xs: List<Int>) -> Int { length(xs: xs) }\n"

data imported_callee_import_only_source: String = "module callcount\n\nimport v2.std.algebra { length }\n\nfn caller(xs: List<Int>) -> Int { 0 }\n"

data same_module_decl_and_call_source: String = "module m\n\nfn g(x: Int) -> Int { x }\n\nfn caller() -> Int { g(x: 1) }\n"

data same_module_decl_no_call_source: String = "module m\n\nfn g(x: Int) -> Int { x }\n\nfn caller() -> Int { 0 }\n"

data call_preservation_postfix_dotted_source: String = "module m\n\ntype Stepper { step: fn(Int) -> Int }\n\nfn caller(s: Stepper) -> Int { s.step(n: 1) }\n"

data call_preservation_lambda_arg_source: String = "module m\n\nfn apply(f: fn(Int) -> Int, x: Int) -> Int { x }\n\nfn caller() -> Int { apply(f: fn(y: Int) -> Int { y }, x: 1) }\n"

data call_preservation_match_arm_source: String = "module m\n\nfn g(x: Int) -> Int { x }\n\nfn caller(b: Bool) -> Int { match b { true => g(x: 1), false => 0 } }\n"

type CallPreservationProducerShape
  = SoleBodyIdentCall
  | PostfixDottedCall
  | NamedArgsCall
  | NestedCallInArgument
  | FoldLoopFirstByNameStep
  | CallWithLambdaArgument
  | CallInMatchArm
  | CallOnInfixRhs

data call_preservation_producer_shape_type: Symbol = ^CallPreservationProducerShape

fn search_call_named(root: Node, callee: Symbol) -> Optional<Node> {
  if node_is_call(node: root) {
    match call_callee_target(node: root) {
      Accepted { value: c, diagnostics: _ } =>
        match node_atom_identity_optional(node: c) {
          Present { value: id } =>
            if id == callee {
              Present { value: root }
            } else {
              search_call_named_children(root: root, callee: callee)
            }
          Absent => search_call_named_children(root: root, callee: callee)
        }
      Rejected { diagnostics: _ } => search_call_named_children(root: root, callee: callee)
    }
  } else {
    search_call_named_children(root: root, callee: callee)
  }
}

fn search_call_named_children(root: Node, callee: Symbol) -> Optional<Node> {
  fold(root.children, init: Absent, f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => search_call_named(root: e.target, callee: callee)
    }
  })
}

fn tree_has_lbrace_operator(root: Node) -> Bool {
  tree_has_punct_call_operator(root: root, punct: ^dag_token_lbrace)
}

fn tree_has_punct_call_operator(root: Node, punct: Symbol) -> Bool {
  let here = match call_callee_target(node: root) {
    Accepted { value: c, diagnostics: _ } =>
      match node_atom_identity_optional(node: c) {
        Present { value: id } => id == punct
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
  here || fold(root.children, init: false, f: fn(acc, e) {
    acc || tree_has_punct_call_operator(root: e.target, punct: punct)
  })
}

fn call_arg_identity_at(root: Node, callee: Symbol, index: Int) -> Optional<Symbol> {
  match search_call_named(root: root, callee: callee) {
    Absent => Absent
    Present { value: call } =>
      match list_at_optional(xs: call_argument_targets(node: call), index: index) {
        Absent => Absent
        Present { value: arg } => node_atom_identity_optional(node: arg)
      }
  }
}

fn call_args_include_punct(root: Node, callee: Symbol, punct: Symbol) -> Bool {
  match search_call_named(root: root, callee: callee) {
    Absent => false
    Present { value: call } =>
      fold(call_argument_targets(node: call), init: false, f: fn(acc, arg) {
        acc || match node_atom_identity_optional(node: arg) {
          Present { value: id } => id == punct
          Absent => false
        }
      })
  }
}

fn normalize_unprepared(src: String, file: Symbol) -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(text: src, file: file, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: normalized, diagnostics: _ } => Present { value: normalized.root }
          }
      }
  }
}

fn normalize_prepared(src: String, file: Symbol) -> Optional<Node> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: prepared, diagnostics: residue } =>
      match tokenize(text: src, file: file, rules: dag_lex()) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: ts, diagnostics: _ } =>
          match parse_module_prepared(
            tokens: ts,
            prepared: prepared,
            validation_residue: residue
          ) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: artifact, diagnostics: _ } =>
              match normalize(parse_tree: artifact.tree) {
                Rejected { diagnostics: _ } => Absent
                Accepted { value: normalized, diagnostics: _ } => Present { value: normalized.root }
              }
          }
      }
  }
}

fn call_arity_named(root: Node, callee: Symbol) -> Int {
  match search_call_named(root: root, callee: callee) {
    Absent => 0
    Present { value: call } => count(call_argument_targets(node: call))
  }
}

fn nested_arg_is_call(root: Node, outer: Symbol, inner: Symbol) -> Bool {
  match search_call_named(root: root, callee: outer) {
    Absent => false
    Present { value: call } =>
      match list_at_optional(xs: call_argument_targets(node: call), index: 0) {
        Absent => false
        Present { value: arg0 } =>
          match search_call_named(root: arg0, callee: inner) {
            Present { value: _ } => true
            Absent => false
          }
      }
  }
}

fn postfix_dotted_call_preserved() -> Bool {
  match normalize_unprepared(src: call_preservation_postfix_dotted_source, file: ^call_pres_postfix) {
    Absent => false
    Present { value: root } =>
      (call_arity_named(root: root, callee: ^step) == 2)
        && match call_arg_identity_at(root: root, callee: ^step, index: 0) {
          Present { value: recv } => recv == ^s
          Absent => false
        }
  }
}

fn named_args_call_preserved() -> Bool {
  match normalize_unprepared(src: call_preservation_two_named_value_source, file: ^call_pres_named_vals) {
    Absent => false
    Present { value: root } =>
      !tree_has_lbrace_operator(root: root)
        && (call_arity_named(root: root, callee: ^list_append) == 2)
        && !call_args_include_punct(root: root, callee: ^list_append, punct: ^dag_token_comma)
        && match call_arg_identity_at(root: root, callee: ^list_append, index: 0) {
          Present { value: a0 } => a0 == ^x
          Absent => false
        }
        && match call_arg_identity_at(root: root, callee: ^list_append, index: 1) {
          Present { value: a1 } => a1 == ^acc
          Absent => false
        }
  }
}

fn nested_call_in_argument_preserved() -> Bool {
  match normalize_unprepared(src: call_preservation_nested_source, file: ^call_pres_nested) {
    Absent => false
    Present { value: root } => nested_arg_is_call(root: root, outer: ^g, inner: ^h)
  }
}

fn fold_loop_first_by_name_step_preserved() -> Bool {
  match normalize_unprepared(src: fold_named_step_snippet, file: ^fold_named_lbrace) {
    Absent => false
    Present { value: root } =>
      !tree_has_lbrace_operator(root: root)
        && !tree_has_punct_call_operator(root: root, punct: ^dag_token_comma)
        && (call_arity_named(root: root, callee: ^fold) == 3)
        && match call_arg_identity_at(root: root, callee: ^fold, index: 0) {
          Present { value: a0 } => a0 == ^xs
          Absent => false
        }
        && match call_arg_identity_at(root: root, callee: ^fold, index: 2) {
          Present { value: a2 } => a2 == ^step
          Absent => false
        }
  }
}

fn lambda_argument_call_preserved() -> Bool {
  match normalize_unprepared(src: call_preservation_lambda_arg_source, file: ^call_pres_lambda) {
    Absent => false
    Present { value: root } =>
      (call_arity_named(root: root, callee: ^apply) == 2)
        && match call_arg_identity_at(root: root, callee: ^apply, index: 1) {
          Present { value: a1 } => a1 == ^x
          Absent => false
        }
  }
}

fn pipe_fold_named_step_preserved() -> Bool {
  match normalize_unprepared(src: pipe_fold_named_step_snippet, file: ^pipe_fold_named) {
    Absent => false
    Present { value: root } =>
      (call_arity_named(root: root, callee: ^fold) == 2)
        && match call_arg_identity_at(root: root, callee: ^fold, index: 1) {
          Present { value: a1 } => a1 == ^step
          Absent => false
        }
  }
}

fn match_arm_call_preserved() -> Bool {
  match normalize_unprepared(src: call_preservation_match_arm_source, file: ^call_pres_match) {
    Absent => false
    Present { value: root } =>
      (call_arity_named(root: root, callee: ^g) == 1)
        && !tree_has_lbrace_operator(root: root)
  }
}

fn unprepared_declared_call_preserved() -> Bool {
  match normalize_unprepared(src: call_preservation_declared_source, file: ^call_pres_unprep) {
    Absent => false
    Present { value: root } =>
      !tree_has_lbrace_operator(root: root)
        && (call_arity_named(root: root, callee: ^g) == 1)
  }
}

fn prepared_declared_call_preserved() -> Bool {
  match normalize_prepared(src: call_preservation_declared_source, file: ^call_pres_prep) {
    Absent => false
    Present { value: root } =>
      !tree_has_lbrace_operator(root: root)
        && (call_arity_named(root: root, callee: ^g) == 1)
  }
}

test fn call_preservation_unprepared_keeps_callee_and_one_arg() -> Bool {
  unprepared_declared_call_preserved()
}

test fn call_preservation_prepared_keeps_callee_and_one_arg() -> Bool {
  prepared_declared_call_preserved()
}

test fn call_preservation_two_arg_control_fails_if_erasure_restored() -> Bool {
  match normalize_unprepared(src: call_preservation_two_arg_source, file: ^call_pres_two) {
    Absent => false
    Present { value: root } => call_arity_named(root: root, callee: ^g) == 2
  }
}

test fn call_preservation_two_named_args_keep_values_not_comma_token() -> Bool {
  named_args_call_preserved()
}

test fn call_preservation_sole_body_named_step_fold_keeps_fold_callee_not_lbrace() -> Bool {
  fold_loop_first_by_name_step_preserved()
}

test fn call_preservation_nested_call_arg_control_fails_if_erasure_restored() -> Bool {
  nested_call_in_argument_preserved()
}

test fn call_preservation_nested_call_in_earlier_arg_does_not_steal_outer_callee() -> Bool {
  match normalize_unprepared(src: call_preservation_nested_earlier_arg_source, file: ^call_pres_nested_earlier) {
    Absent => false
    Present { value: root } =>
      (call_arity_named(root: root, callee: ^g) == 2)
        && nested_arg_is_call(root: root, outer: ^g, inner: ^h)
  }
}

fn fold_ingest_has_surface(src: String, file: Symbol) -> Optional<Bool> {
  match normalize_unprepared(src: src, file: file) {
    Absent => Absent
    Present { value: tree } =>
      Present {
        value: v2.lens.complexity_accumulator_copy.analyze.tree_contains_surface_fold_call(root: tree)
      }
  }
}

fn fold_ingest_has_loop(src: String, file: Symbol) -> Optional<Bool> {
  match normalize_unprepared(src: src, file: file) {
    Absent => Absent
    Present { value: tree } =>
      Present {
        value: v2.lens.complexity_accumulator_copy.analyze.tree_contains_lowered_loop(root: tree)
      }
  }
}

test fn fold_fn_form_after_call_preservation_is_loop_not_surface() -> Bool {
  match fold_ingest_has_loop(src: fold_fn_form_snippet, file: ^fold_fn_loop) {
    Absent => false
    Present { value: loop } =>
      loop
        && match fold_ingest_has_surface(src: fold_fn_form_snippet, file: ^fold_fn_surf) {
          Absent => false
          Present { value: surface } => !surface
        }
  }
}

test fn fold_arrow_form_after_call_preservation_is_not_surface() -> Bool {
  match fold_ingest_has_surface(src: fold_arrow_form_snippet, file: ^fold_arrow_surf) {
    Absent => false
    Present { value: surface } => !surface
  }
}

test fn fold_named_step_after_call_preservation_is_neither_loop_nor_surface() -> Bool {
  match fold_ingest_has_loop(src: fold_named_step_snippet, file: ^fold_named_loop) {
    Absent => false
    Present { value: loop } =>
      !loop
        && match fold_ingest_has_surface(src: fold_named_step_snippet, file: ^fold_named_surf) {
          Absent => false
          Present { value: surface } => !surface
        }
  }
}

test fn fold_named_step_after_call_preservation_keeps_fold_as_transform_callee() -> Bool {
  match normalize_unprepared(src: fold_named_step_snippet, file: ^fold_named_call) {
    Absent => false
    Present { value: root } => call_arity_named(root: root, callee: ^fold) >= 1
  }
}

test fn call_preservation_sole_body_fold_with_nested_call_arg_is_not_init_literal() -> Bool {
  match normalize_unprepared(src: fold_nested_call_inline_step_snippet, file: ^fold_decoy_nested) {
    Absent => false
    Present { value: root } =>
      match fold_ingest_has_loop(src: fold_nested_call_inline_step_snippet, file: ^fold_decoy_loop) {
        Absent => false
        Present { value: loop } =>
          loop || (call_arity_named(root: root, callee: ^fold) >= 1)
      }
  }
}

fn undeclared_callee_refuses_at_resolve() -> Bool {
  let run = run_front_end(
    source: call_preservation_undeclared_source,
    file: ^call_pres_undef
  )
  match run.completion {
    FrontEndResolvedModule { resolved: _ } => false
    FrontEndBoundReached { last: _ } => false
    FrontEndRefused =>
      fold(run.steps, init: false, f: fn(acc, step) {
        match step {
          FrontEndStageRejected { stage: _, diagnostics: d } =>
            acc || (d.head.reason == ^resolve_reason_unbound_symbol)
          FrontEndStagePassed { stage: _, receipt: _, diagnostics: _ } => acc
        }
      })
  }
}

fn declared_callee_resolves() -> Bool {
  let run = run_front_end(
    source: call_preservation_declared_source,
    file: ^call_pres_decl_res
  )
  match run.completion {
    FrontEndResolvedModule { resolved: _ } => true
    FrontEndBoundReached { last: _ } => false
    FrontEndRefused => false
  }
}

test fn call_preservation_undeclared_callee_refuses_at_resolve() -> Bool {
  undeclared_callee_refuses_at_resolve()
}

test fn call_preservation_declared_callee_resolves() -> Bool {
  declared_callee_resolves()
}

fn count_positional_calls_to(root: Node, callee: Symbol) -> Int {
  let here = if node_is_call(node: root) {
    match call_callee_target(node: root) {
      Accepted { value: c, diagnostics: _ } =>
        match node_atom_identity_optional(node: c) {
          Present { value: id } => if id == callee { 1 } else { 0 }
          Absent => 0
        }
      Rejected { diagnostics: _ } => 0
    }
  } else {
    0
  }
  here + fold(root.children, init: 0, f: fn(acc, e) {
    acc + count_positional_calls_to(root: e.target, callee: callee)
  })
}

fn count_named_edges_with_name(root: Node, name: Symbol) -> Int {
  fold(root.children, init: 0, f: fn(acc, e) {
    let here = match e.label {
      Named { name: n } => if n == name { 1 } else { 0 }
      _ => 0
    }
    acc + here + count_named_edges_with_name(root: e.target, name: name)
  })
}

fn positional_call_delta(with_call: String, without_call: String, callee: Symbol, with_file: Symbol, without_file: Symbol) -> Int {
  match normalize_unprepared(src: with_call, file: with_file) {
    Absent => (0 - 1)
    Present { value: a } =>
      match normalize_unprepared(src: without_call, file: without_file) {
        Absent => (0 - 1)
        Present { value: b } =>
          count_positional_calls_to(root: a, callee: callee) - count_positional_calls_to(root: b, callee: callee)
      }
  }
}

fn named_edge_delta(with_call: String, without_call: String, name: Symbol, with_file: Symbol, without_file: Symbol) -> Int {
  match normalize_unprepared(src: with_call, file: with_file) {
    Absent => (0 - 1)
    Present { value: a } =>
      match normalize_unprepared(src: without_call, file: without_file) {
        Absent => (0 - 1)
        Present { value: b } =>
          count_named_edges_with_name(root: a, name: name) - count_named_edges_with_name(root: b, name: name)
      }
  }
}

fn imported_callee_positional_call_delta() -> Int {
  positional_call_delta(
    with_call: imported_callee_call_source,
    without_call: imported_callee_import_only_source,
    callee: ^length,
    with_file: ^imp_call,
    without_file: ^imp_only
  )
}

test fn imported_callee_normalize_call_site_count_is_one_above_import_only() -> Bool {
  imported_callee_positional_call_delta() == 1
}

test fn imported_callee_call_site_adds_no_named_edge_for_callee() -> Bool {
  named_edge_delta(
    with_call: imported_callee_call_source,
    without_call: imported_callee_import_only_source,
    name: ^length,
    with_file: ^imp_named,
    without_file: ^imp_named_only
  ) == 0
}

test fn same_module_declaration_call_site_count_is_one_above_decl_only() -> Bool {
  positional_call_delta(
    with_call: same_module_decl_and_call_source,
    without_call: same_module_decl_no_call_source,
    callee: ^g,
    with_file: ^sm_call,
    without_file: ^sm_decl
  ) == 1
}

fn call_preservation_shape_holds(shape: CallPreservationProducerShape) -> Bool {
  match shape {
    SoleBodyIdentCall => unprepared_declared_call_preserved()
    PostfixDottedCall => postfix_dotted_call_preserved()
    NamedArgsCall => named_args_call_preserved()
    NestedCallInArgument => nested_call_in_argument_preserved()
    FoldLoopFirstByNameStep => fold_loop_first_by_name_step_preserved()
    CallWithLambdaArgument => lambda_argument_call_preserved()
    CallInMatchArm => match_arm_call_preserved()
    CallOnInfixRhs => pipe_fold_named_step_preserved()
  }
}

fn call_preservation_shape_discriminant(shape: CallPreservationProducerShape) -> Symbol {
  discriminant(v: shape)
}

fn call_preservation_symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn call_preservation_shape_discriminants(
  inhabitants: List<CallPreservationProducerShape>
) -> List<Symbol> {
  fold_list(
    xs: inhabitants,
    empty: std.algebra.Empty,
    cons: fn(acc, shape) {
      list_snoc_item(
        xs: acc,
        item: call_preservation_shape_discriminant(shape: shape)
      )
    }
  )
}

test fn call_preservation_producer_shape_table_is_closed() -> Bool {
  match coproduct_nullary_inhabitants(
    type_name: call_preservation_producer_shape_type,
    discriminant_of: call_preservation_shape_discriminant
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: inhabitants, diagnostics: _ } =>
      let keys = coproduct_arm_keys(type_name: call_preservation_producer_shape_type)
      (length(xs: keys) > 0)
        && bag_eq(
          xs: call_preservation_shape_discriminants(inhabitants: inhabitants),
          ys: keys,
          eq: call_preservation_symbol_eq
        )
        && fold(inhabitants, init: true, f: fn(acc, shape) {
          acc && call_preservation_shape_holds(shape: shape)
        })
  }
}

test fn call_preservation_postfix_dotted_keeps_method_and_receiver() -> Bool {
  postfix_dotted_call_preserved()
}

test fn call_preservation_lambda_argument_keeps_outer_call() -> Bool {
  lambda_argument_call_preserved()
}

test fn call_preservation_match_arm_keeps_callee_and_arg() -> Bool {
  match_arm_call_preserved()
}
