module v2.test.claim.manual.annotation_gap_v1_v2_agreement

import std.types { List }
import std.algebra { list_at_optional }
import std.coercion { unicode_scalar_unfold }
import std.source_annotation {
  AnnotationScope,
  FileScope,
  OccurrenceScope,
  ErasedSourceRegion,
  SourceAnnotationDebt,
  source_annotation_graph_rows
}
import extdeps.languages.dag.syntax { dag_parse_environment, strip_line_comment_delimiter }
import v1.compiler.tokenize { tokenize_artifact }
import v1.compiler.parse { parse_with_table, ParsedSourceExtents }
import v1.compiler.annotation_bind { bind_annotations, keyed_annotation_regions }
import v1.std.core { build_newline_index, empty_intern_table }
import v2.compiler.parse { parse_artifact_span_index, parse_module_authored, authored_parse_annotations, authored_parse_semantic }
import v2.compiler.tokenize { lex_walk_artifact }
import v2.extdeps.languages.dag { dag_lex_rules, dag_language_model }
import v2.std.provenance { span_index_extent }
import std.host_text { chars }

// ROADMAP NODE parse-comment-gap-attachment-v2, agreement control. v1 and v2 attach by the SAME rule
// (std.source_annotation attach_annotations) over DIFFERENT region trees -- v1's semantic nodes and
// erased scopes, v2's grammar productions -- so their structural keys are not comparable (v1 keys name
// authored identifiers, v2 keys name productions). What both trees share is the SOURCE: where a
// comment sits between two sibling constructs both parsers retain -- module items, statements, call
// arguments, the operand of an infix application -- the two attachments must name the same neighbour
// TEXT on each side. The infix row is not decoration: v2's region roster
// (v2.compiler.parse parse_node_is_source_region) keeps infix applications as regions ALONGSIDE
// production wrappers, and it is the only row here that can see that second arm -- drop the arm and the
// comment before `2 * 3` names `2` in v2 while v1 still names `2 * 3`. Where the trees
// legitimately differ (v2's stmt_seq has no braces, v1's block does) the scopes' extents differ, so
// this control compares neighbours, not scopes.
//
// HOW TO EXECUTE THIS CONTROL, and two traps on the way there (node parse-comment-gap-attachment-v2-consumed).
// It imports v1.compiler.*, so it needs src/v1 as a source root -- claim_batch with only
// --source-root dag --source-root src/v2 refuses it at the checker, because none of those modules is in a
// root it can see. The executed form names all three roots itself:
//   claim_batch --source-root dag --source-root src/v2 --source-root src/v1 \
//     --entry src/v2/test/claim/manual/annotation_gap_v1_v2_agreement.dag \
//     --functions v1_and_v2_agree_on_neighbour_text_holds --hermetic
// And its two pool callees MUST be imported by name: left bare, the checker refuses the whole claim with
// "effect summary incomplete: call to 'dag_language_model' ... has no established callee identity" (and the
// same for 'span_index_extent'). That refusal is why this control, though it has sat under manual/ since it
// was written, had never been executed by anything until this node.

data agreement_source: String = "module zqx.agree\n\n// above the data row\ndata zqx_d: Int = 1\n\n// between the items\nfn zqx_f(a: Int, b: Int) -> Int \{\n  let x = zqx_g(\n    a,\n    // between the arguments\n    b,\n    1 +\n    // before the product\n    2 * 3\n  )\n  // between the statements\n  x\n\}\n\nfn zqx_g(p: Int, q: Int) -> Int \{\n  p\n\}\n"

data agreement_texts: List<String> = ["above the data row", "between the items", "between the arguments", "before the product", "between the statements"]

// THE CONTROL'S OWN PATH AND RUNG, published here because something OUTSIDE this file decides the rung and has
// to be asked, not because a receipt wanted a string to repeat. `agreement_control_module_name` is the key
// `v2.workflow.required_floor` `required_gate_admits` is asked with, so the rung below is enforced against the
// floor's own admission decision rather than asserted beside it: while this reads ManualUngated the claim fails
// the moment any selector -- including a family row that later sweeps this path in -- admits it, and it fails a
// GatedRow that was raised without a roster. What a path literal does NOT do is catch a rename: that is caught
// twice over by things that actually consume the name -- this module is IMPORTED BY NAME by
// `v2.test.claim.manual.annotation_gap_v1_v2_agreement_probe_pair`, so renaming it fails to resolve rather than
// quietly agreeing with a stale copy, and the entry fn below is consumed by the executor's `--functions` argv.
// Rung is a closed set of facts, so it is a declared sum and not a String: a free String cannot refuse an
// invented rung (gunbc.design_argument::guarantee_ladder, rung honesty; gunbc.design_argument::source_annotations,
// a status belongs in a typed carrier).
// THE ENTRY FN IS DELIBERATELY NOT PUBLISHED HERE. A `String` naming this module's test fn has no consumer
// that could refuse anything: the only reader such a carrier can have is another module's copy of the SAME
// literal, and comparing a copy against its original stays green through the rename it promises to catch --
// which is a second place independently deciding one fact (gunbc.design_argument::single_authority) read by a
// `.contains()` grep that is not a consumer (gunbc.design_argument::fail_closed). The fn name IS consumed, by
// the executor's `--functions` argv: rename the fn and the run itself refuses with
// "does not declare requested function(s)" at rc=2, which is the executed protection and is recorded with its
// raw lines in the pull-request run log rather than restated here where nothing could read it.
// Two rungs, and no third until something can EVIDENCE it. A rung is a claim about a fact outside this file,
// so a variant may exist only while a predicate somewhere can decide it. "The floor executed this control" has
// no such predicate anywhere in the tree -- `v2.workflow.required_floor` `required_gate_admits` answers whether
// the floor ADMITS a path and nothing observes execution -- so admitting a variant nobody can decide would
// invite a rung to be raised on an admission alone. When a floor that executes lands, adding the variant,
// deciding it, and raising this value are ONE change (gunbc.design_argument::guarantee_ladder, rung honesty).
type AgreementControlRung =
    ManualUngated
  | GatedRow

data agreement_control_module_name: String = "v2.test.claim.manual.annotation_gap_v1_v2_agreement"

// The line below IS the status; this comment does not get to state one beside it. It is re-derived from
// `v2.workflow.required_floor` `required_gate_admits` by
// `v2.test.claim.manual.annotation_gap_v1_v2_agreement_probe_pair`
// `probe_pair_rung_agrees_with_the_floors_own_admission`, so raising it without a roster row, or enrolling a
// row without raising it, refuses. Admitting a required-gate row is an operator act on a recorded ruling
// (gunbc.design_ruling::required_gate_rows_grow_by_operator_ruling), and the moment this rung may rise is
// declared once as `v2.compiler.staged_front_end` `front_end_placement_control_next_rung`.
data agreement_control_rung: AgreementControlRung = ManualUngated

fn row_text(row: SourceAnnotationDebt) -> String {
  row.text
}

fn row_before(row: SourceAnnotationDebt) -> Optional<AnnotationScope> {
  row.gap.before
}

fn row_after(row: SourceAnnotationDebt) -> Optional<AnnotationScope> {
  row.gap.after
}

fn slice(source: String, start: Int, end: Int) -> String {
  substring(s: source, start: start, end: end)
}

// ONE REALIZATION PER PARSER, and both projections derived from it (gunbc.design_argument::minimize_redundancy,
// "a concept is modeled once and every use derived from it"). The v1 route is tokenize -> parse_with_table ->
// bind_annotations, and the v2 route is lex_walk_artifact -> parse_module_authored; each appears HERE and only
// here. The neighbour triple and the after-neighbour alone that the pinned conjunct needs are two projections
// over the SAME rows and the SAME recorded extents, so the fixture cannot drift between the copy that asserts
// agreement and the copy that pins the product -- which is the thing the break has to be visible to.
type AgreementProducts {
  neighbours: List<String>
  after_products: List<String>
}

fn v1_agree_products(source: String) -> AgreementProducts {
  let file = "zqx_agree.dag"
  let artifact = tokenize_artifact(source: source, file: file, env: dag_parse_environment)
  let parsed = parse_with_table(
    tokens: artifact.tokens,
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source)),
    intern_table: empty_intern_table(),
  )
  let graph = bind_annotations(transport: parsed.occurrence_transport, extents: parsed.source_extents, captures: artifact.annotations)
  let rows = source_annotation_graph_rows(graph: graph)
    |> filter(r => agreement_texts |> any(t => t == row_text(row: r)))
  AgreementProducts {
    neighbours: rows |> map(r => concat(row_text(row: r), " | ", v1_scope_text(source: source, extents: parsed.source_extents, scope: row_before(row: r)), " | ", v1_scope_text(source: source, extents: parsed.source_extents, scope: row_after(row: r)))),
    after_products: rows |> map(r => v1_scope_text(source: source, extents: parsed.source_extents, scope: row_after(row: r))),
  }
}

fn v2_agree_products(source: String) -> AgreementProducts {
  match lex_walk_artifact(source: chars(text: source), file: ^zqx_agree, rules: dag_lex_rules()) {
    Rejected { diagnostics: _ } => AgreementProducts { neighbours: ["<no lex>"], after_products: ["<no lex>"] }
    Accepted { value: artifact, diagnostics: _ } =>
      match parse_module_authored(artifact: artifact, grammar: dag_language_model().grammar, annotation_text: fn(t) { strip_line_comment_delimiter(lexeme: t) }) {
        Rejected { diagnostics: _ } => AgreementProducts { neighbours: ["<no parse>"], after_products: ["<no parse>"] }
        Accepted { value: authored, diagnostics: _ } =>
          let rows = source_annotation_graph_rows(graph: authored_parse_annotations(artifact: authored))
            |> filter(r => agreement_texts |> any(t => t == row_text(row: r)))
          let index = parse_artifact_span_index(artifact: authored_parse_semantic(artifact: authored))
          AgreementProducts {
            neighbours: rows |> map(r => concat(row_text(row: r), " | ", v2_scope_text(source: source, index: index, scope: row_before(row: r)), " | ", v2_scope_text(source: source, index: index, scope: row_after(row: r)))),
            after_products: rows |> map(r => v2_scope_text(source: source, index: index, scope: row_after(row: r))),
          }
      }
  }
}

// The extent is the one the v1 parser recorded, read back out of the table that realization already holds --
// this function no longer re-parses to look an occurrence up.
fn v1_scope_text(source: String, extents: ParsedSourceExtents, scope: Optional<AnnotationScope>) -> String {
  match scope {
    Absent => "<none>"
    Present { value: s } =>
      match s {
        FileScope => "<file>"
        ErasedSourceRegion { extent: e } => slice(source: source, start: e.start, end: e.end)
        OccurrenceScope { occurrence: id } =>
          match extents.extents |> filter(row => row.occurrence == id) |> first {
            Present { value: row } => slice(source: source, start: row.extent.start, end: row.extent.end)
            Absent => "<no extent>"
          }
      }
  }
}

fn v2_scope_text(source: String, index: v2.std.provenance.SpanIndex, scope: Optional<AnnotationScope>) -> String {
  match scope {
    Absent => "<none>"
    Present { value: s } =>
      match s {
        FileScope => "<file>"
        ErasedSourceRegion { extent: e } => slice(source: source, start: e.start, end: e.end)
        OccurrenceScope { occurrence: id } =>
          match span_index_extent(index: index, id: id) {
            Present { value: recorded } =>
              match recorded {
                SourceExtentKnown { locus: l } =>
                  match l {
                    Textual { file: _, extent: ext } =>
                      match ext {
                        ByteRange { start: st, end: en } => slice(source: source, start: st, end: en)
                        WholeFile => "<whole>"
                      }
                    _ => "<other>"
                  }
                SourceExtentUnrepresentable => "<unrep>"
              }
            Absent => "<absent>"
          }
      }
  }
}

// BOTH PARSERS NAME THE SAME NEIGHBOUR TEXT for every comment between two retained siblings: between
// module items, between call arguments, between statements. The first row is the one place the two
// trees differ in this fixture, asserted rather than dropped: v2 retains the module header as its own
// production, so a comment below it has the header before it; v1's module node has no header child,
// so the same comment has nothing before it. Everything after the first row must match exactly.
test fn v1_and_v2_agree_on_neighbour_text_holds() -> Bool {
  let v1_realized = v1_agree_products(source: agreement_source)
  let v2_realized = v2_agree_products(source: agreement_source)
  let v1 = v1_realized.neighbours
  let v2 = v2_realized.neighbours
  (v1 |> length) == 5
    && (v2 |> length) == 5
    && list_at_optional(xs: v1, index: 1) == list_at_optional(xs: v2, index: 1)
    && list_at_optional(xs: v1, index: 2) == list_at_optional(xs: v2, index: 2)
    && list_at_optional(xs: v1, index: 3) == list_at_optional(xs: v2, index: 3)
    && list_at_optional(xs: v1, index: 4) == list_at_optional(xs: v2, index: 4)
    && list_at_optional(xs: v1, index: 0) == Present { value: "above the data row | <none> | data zqx_d: Int = 1" }
    && list_at_optional(xs: v2, index: 0) == Present { value: "above the data row | module zqx.agree | data zqx_d: Int = 1" }
    // PINNED, not merely agreed. Both parsers must name the PRODUCT `2 * 3` as the neighbour after the
    // "before the product" gap. An agreement claim alone is insensitive to the roster: v1 and v2 can agree
    // on the wrong neighbour and stay green, which is what an unpinned fixture would let happen; the
    // deliberate-break probe in the module beside this one is where that is exercised.
    // src/v2/compiler/parse.dag's roster comment says the infix-application arm exists precisely so
    // `1 + 2 * 3` has a region for `2 * 3`; without it the neighbour is `2`. Pinning the text is what turns
    // that roster arm into something a run can lose.
    && list_at_optional(xs: v2_realized.after_products, index: 3) == Present { value: "2 * 3" }
    && list_at_optional(xs: v1_realized.after_products, index: 3) == Present { value: "2 * 3" }
}
