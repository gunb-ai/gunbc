module v2.test.claim.manual.annotation_gap_v1_v2_agreement

import std.types { List }
import std.algebra { list_at_optional }
import std.coercion { unicode_scalar_unfold }
import std.source_annotation {
  AnnotationScope,
  FileScope,
  OccurrenceScope,
  ErasedSourceRegion,
  SourceAnnotationDebt,
  source_annotation_graph_rows
}
import extdeps.languages.dag.syntax { dag_parse_environment, strip_line_comment_delimiter }
import v1.compiler.tokenize { tokenize_artifact }
import v1.compiler.parse { parse_with_table }
import v1.compiler.annotation_bind { bind_annotations, keyed_annotation_regions }
import v1.std.core { build_newline_index, empty_intern_table }
import v2.compiler.parse { parse_artifact_span_index, parse_module_authored, authored_parse_annotations, authored_parse_semantic }
import v2.compiler.tokenize { lex_walk_artifact }
import v2.extdeps.languages.dag { dag_lex_rules, dag_language_model }
import v2.std.provenance { span_index_extent }
import std.host_text { chars }

// ROADMAP NODE parse-comment-gap-attachment-v2, agreement control. v1 and v2 attach by the SAME rule
// (std.source_annotation attach_annotations) over DIFFERENT region trees -- v1's semantic nodes and
// erased scopes, v2's grammar productions -- so their structural keys are not comparable (v1 keys name
// authored identifiers, v2 keys name productions). What both trees share is the SOURCE: where a
// comment sits between two sibling constructs both parsers retain -- module items, statements, call
// arguments, the operand of an infix application -- the two attachments must name the same neighbour
// TEXT on each side. The infix row is not decoration: v2's region roster
// (v2.compiler.parse parse_node_is_source_region) keeps infix applications as regions ALONGSIDE
// production wrappers, and it is the only row here that can see that second arm -- drop the arm and the
// comment before `2 * 3` names `2` in v2 while v1 still names `2 * 3`. Where the trees
// legitimately differ (v2's stmt_seq has no braces, v1's block does) the scopes' extents differ, so
// this control compares neighbours, not scopes.
//
// HOW TO EXECUTE THIS CONTROL, and two traps on the way there (node parse-comment-gap-attachment-v2-consumed).
// It imports v1.compiler.*, so it needs src/v1 as a source root -- claim_batch with only
// --source-root dag --source-root src/v2 refuses it at the checker, because none of those modules is in a
// root it can see. The three roots the executed form needs are published as a carrier,
// v2.test.claim.manual.annotation_gap_v1_v2_agreement_probe_pair annotation_gap_v1_v2_agreement_probe_argv_roots,
// and checked there by probe_pair_receipt_records_the_route_that_ran_it; the refusal text and its exit status
// are in the run log, not here. The executed form is:
//   claim_batch --source-root dag --source-root src/v2 --source-root src/v1 \
//     --entry src/v2/test/claim/manual/annotation_gap_v1_v2_agreement.dag \
//     --functions v1_and_v2_agree_on_neighbour_text_holds --hermetic
// And its two pool callees MUST be imported by name: left bare, the checker refuses the whole claim with
// "effect summary incomplete: call to 'dag_language_model' ... has no established callee identity" (and the
// same for 'span_index_extent'). That refusal is why this control, though it has sat under manual/ since it
// was written, had never been executed by anything until this node.

data agreement_source: String = "module zqx.agree\n\n// above the data row\ndata zqx_d: Int = 1\n\n// between the items\nfn zqx_f(a: Int, b: Int) -> Int \{\n  let x = zqx_g(\n    a,\n    // between the arguments\n    b,\n    1 +\n    // before the product\n    2 * 3\n  )\n  // between the statements\n  x\n\}\n\nfn zqx_g(p: Int, q: Int) -> Int \{\n  p\n\}\n"

data agreement_texts: List<String> = ["above the data row", "between the items", "between the arguments", "before the product", "between the statements"]

// THE CONTROL'S OWN IDENTITY AND RUNG, published here so a receipt in another module has something to agree
// with. The probe pair imports these three and refuses when its own copy disagrees, so renaming this module,
// renaming its entry fn, or enrolling this control without restating its rung turns THAT claim red -- the rung
// is enforced against the floor's own admission decision, not asserted beside it. Rung is a closed set of
// facts, so it is a declared sum and not a String: a free String cannot refuse an invented rung
// (gunbc.design_argument::guarantee_ladder, rung honesty; gunbc.design_argument::source_annotations, a status
// belongs in a typed carrier).
type AgreementControlRung =
    ManualUngated
  | GatedRow
  | FloorExecuted

data agreement_control_module_name: String = "v2.test.claim.manual.annotation_gap_v1_v2_agreement"

data agreement_control_entry_fn: String = "v1_and_v2_agree_on_neighbour_text_holds"

// ManualUngated, measured 2026-11-24. Enrolment in `v2.workflow.required_floor`
// `required_gate_authored_modules` was HELD: a required-gate row is admitted by the OPERATOR on a recorded
// ruling (`required_gate_rows_grow_by_operator_ruling` in dag/gunbc/design_ruling.dag) and no such ruling
// exists -- the lane-manager yes that briefly carried the row was retracted, and the row went back to main's
// bytes. Independently, the floor has no executor: `run_required_floor` is gone from src/v1/stage0 and no
// workflow passes a --required flag, so even a GatedRow here would not be executed today. The pair claim
// re-derives this from `v2.workflow.required_floor` `required_gate_admits` instead of trusting this line.
data agreement_control_rung: AgreementControlRung = ManualUngated

fn row_text(row: SourceAnnotationDebt) -> String {
  row.text
}

fn row_before(row: SourceAnnotationDebt) -> Optional<AnnotationScope> {
  row.gap.before
}

fn row_after(row: SourceAnnotationDebt) -> Optional<AnnotationScope> {
  row.gap.after
}

fn slice(source: String, start: Int, end: Int) -> String {
  substring(s: source, start: start, end: end)
}

// ---- v1: neighbour text through the binder's own keyed regions.
fn v1_neighbours(source: String) -> List<String> {
  let file = "zqx_agree.dag"
  let artifact = tokenize_artifact(source: source, file: file, env: dag_parse_environment)
  let parsed = parse_with_table(
    tokens: artifact.tokens,
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source)),
    intern_table: empty_intern_table(),
  )
  let graph = bind_annotations(transport: parsed.occurrence_transport, extents: parsed.source_extents, captures: artifact.annotations)
  source_annotation_graph_rows(graph: graph)
    |> filter(r => agreement_texts |> any(t => t == row_text(row: r)))
    |> map(r => concat(row_text(row: r), " | ", v1_scope_text(source: source, scope: row_before(row: r)), " | ", v1_scope_text(source: source, scope: row_after(row: r))))
}

fn v1_scope_text(source: String, scope: Optional<AnnotationScope>) -> String {
  match scope {
    Absent => "<none>"
    Present { value: s } =>
      match s {
        FileScope => "<file>"
        ErasedSourceRegion { extent: e } => slice(source: source, start: e.start, end: e.end)
        OccurrenceScope { occurrence: _ } => v1_occurrence_text(source: source, scope: s)
      }
  }
}

// Recomputes nothing: the extent is the one the v1 parser recorded, read back by re-parsing the same
// bytes and looking the occurrence up in the published table.
fn v1_occurrence_text(source: String, scope: AnnotationScope) -> String {
  match scope {
    OccurrenceScope { occurrence: id } =>
      let file = "zqx_agree.dag"
      let parsed = parse_with_table(
        tokens: tokenize_artifact(source: source, file: file, env: dag_parse_environment).tokens,
        source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source)),
        intern_table: empty_intern_table(),
      )
      match parsed.source_extents.extents |> filter(row => row.occurrence == id) |> first {
        Present { value: row } => slice(source: source, start: row.extent.start, end: row.extent.end)
        Absent => "<no extent>"
      }
    _ => "<not an occurrence>"
  }
}

// ---- v2: neighbour text through the recorded SpanIndex extents.
fn v2_neighbours(source: String) -> List<String> {
  match lex_walk_artifact(source: chars(text: source), file: ^zqx_agree, rules: dag_lex_rules()) {
    Rejected { diagnostics: _ } => ["<no lex>"]
    Accepted { value: artifact, diagnostics: _ } =>
      match parse_module_authored(artifact: artifact, grammar: dag_language_model().grammar, annotation_text: fn(t) { strip_line_comment_delimiter(lexeme: t) }) {
        Rejected { diagnostics: _ } => ["<no parse>"]
        Accepted { value: authored, diagnostics: _ } =>
          v2_rows_text(source: source, rows: source_annotation_graph_rows(graph: authored_parse_annotations(artifact: authored)), index: parse_artifact_span_index(artifact: authored_parse_semantic(artifact: authored)))
      }
  }
}

// After-neighbour only, for the pinned conjunct: the row's `gap.after` text, without the before side, so
// the assertion names the region the roster is supposed to have produced and nothing else.
fn v1_after_products(source: String) -> List<String> {
  let file = "zqx_agree.dag"
  let artifact = tokenize_artifact(source: source, file: file, env: dag_parse_environment)
  let parsed = parse_with_table(
    tokens: artifact.tokens,
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source)),
    intern_table: empty_intern_table(),
  )
  let graph = bind_annotations(transport: parsed.occurrence_transport, extents: parsed.source_extents, captures: artifact.annotations)
  source_annotation_graph_rows(graph: graph)
    |> filter(r => agreement_texts |> any(t => t == row_text(row: r)))
    |> map(r => v1_scope_text(source: source, scope: row_after(row: r)))
}

fn v2_after_products(source: String) -> List<String> {
  match lex_walk_artifact(source: chars(text: source), file: ^zqx_agree, rules: dag_lex_rules()) {
    Rejected { diagnostics: _ } => ["<no lex>"]
    Accepted { value: artifact, diagnostics: _ } =>
      match parse_module_authored(artifact: artifact, grammar: dag_language_model().grammar, annotation_text: fn(t) { strip_line_comment_delimiter(lexeme: t) }) {
        Rejected { diagnostics: _ } => ["<no parse>"]
        Accepted { value: authored, diagnostics: _ } =>
          source_annotation_graph_rows(graph: authored_parse_annotations(artifact: authored))
            |> filter(r => agreement_texts |> any(t => t == row_text(row: r)))
            |> map(r => v2_scope_text(source: source, index: parse_artifact_span_index(artifact: authored_parse_semantic(artifact: authored)), scope: row_after(row: r)))
      }
  }
}

fn v2_rows_text(source: String, rows: List<SourceAnnotationDebt>, index: v2.std.provenance.SpanIndex) -> List<String> {
  rows
    |> filter(r => agreement_texts |> any(t => t == row_text(row: r)))
    |> map(r => concat(row_text(row: r), " | ", v2_scope_text(source: source, index: index, scope: row_before(row: r)), " | ", v2_scope_text(source: source, index: index, scope: row_after(row: r))))
}

fn v2_scope_text(source: String, index: v2.std.provenance.SpanIndex, scope: Optional<AnnotationScope>) -> String {
  match scope {
    Absent => "<none>"
    Present { value: s } =>
      match s {
        FileScope => "<file>"
        ErasedSourceRegion { extent: e } => slice(source: source, start: e.start, end: e.end)
        OccurrenceScope { occurrence: id } =>
          match span_index_extent(index: index, id: id) {
            Present { value: recorded } =>
              match recorded {
                SourceExtentKnown { locus: l } =>
                  match l {
                    Textual { file: _, extent: ext } =>
                      match ext {
                        ByteRange { start: st, end: en } => slice(source: source, start: st, end: en)
                        WholeFile => "<whole>"
                      }
                    _ => "<other>"
                  }
                SourceExtentUnrepresentable => "<unrep>"
              }
            Absent => "<absent>"
          }
      }
  }
}

// BOTH PARSERS NAME THE SAME NEIGHBOUR TEXT for every comment between two retained siblings: between
// module items, between call arguments, between statements. The first row is the one place the two
// trees differ in this fixture, asserted rather than dropped: v2 retains the module header as its own
// production, so a comment below it has the header before it; v1's module node has no header child,
// so the same comment has nothing before it. Everything after the first row must match exactly.
test fn v1_and_v2_agree_on_neighbour_text_holds() -> Bool {
  let v1 = v1_neighbours(source: agreement_source)
  let v2 = v2_neighbours(source: agreement_source)
  (v1 |> length) == 5
    && (v2 |> length) == 5
    && list_at_optional(xs: v1, index: 1) == list_at_optional(xs: v2, index: 1)
    && list_at_optional(xs: v1, index: 2) == list_at_optional(xs: v2, index: 2)
    && list_at_optional(xs: v1, index: 3) == list_at_optional(xs: v2, index: 3)
    && list_at_optional(xs: v1, index: 4) == list_at_optional(xs: v2, index: 4)
    && list_at_optional(xs: v1, index: 0) == Present { value: "above the data row | <none> | data zqx_d: Int = 1" }
    && list_at_optional(xs: v2, index: 0) == Present { value: "above the data row | module zqx.agree | data zqx_d: Int = 1" }
    // PINNED, not merely agreed. Both parsers must name the PRODUCT `2 * 3` as the neighbour after the
    // "before the product" gap. An agreement claim alone is insensitive to the roster: v1 and v2 can agree
    // on the wrong neighbour and stay green, which is exactly what happened when this comment sat before
    // the whole `1 + 2 * 3` (measured: the deliberate-break tree passed the agreement conjuncts, rc=0).
    // src/v2/compiler/parse.dag's roster comment says the infix-application arm exists precisely so
    // `1 + 2 * 3` has a region for `2 * 3`; without it the neighbour is `2`. Pinning the text is what turns
    // that roster arm into something a run can lose.
    && list_at_optional(xs: v2_after_products(source: agreement_source), index: 3) == Present { value: "2 * 3" }
    && list_at_optional(xs: v1_after_products(source: agreement_source), index: 3) == Present { value: "2 * 3" }
    && list_at_optional(xs: v1, index: 3) == list_at_optional(xs: v2, index: 3)
}
