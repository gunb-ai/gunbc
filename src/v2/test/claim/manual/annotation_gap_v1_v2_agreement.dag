module v2.test.claim.manual.annotation_gap_v1_v2_agreement

import std.types { List }
import std.coercion { unicode_scalar_unfold }
import std.source_annotation {
  AnnotationScope,
  FileScope,
  OccurrenceScope,
  ErasedSourceRegion,
  SourceAnnotationDebt,
  source_annotation_graph_rows
}
import extdeps.languages.dag.syntax { dag_parse_environment, strip_line_comment_delimiter }
import v1.compiler.tokenize { tokenize_artifact }
import v1.compiler.parse { parse_with_table }
import v1.compiler.annotation_bind { bind_annotations, keyed_annotation_regions }
import v1.std.core { build_newline_index, empty_intern_table }
import v2.compiler.parse { parse_module_authored, authored_parse_annotations, authored_parse_semantic }
import v2.compiler.tokenize { lex_walk_artifact }
import v2.extdeps.languages.dag { dag_lex_rules }
import std.host_text { chars }

// ROADMAP NODE parse-comment-gap-attachment-v2, agreement control. v1 and v2 attach by the SAME rule
// (std.source_annotation attach_annotations) over DIFFERENT region trees -- v1's semantic nodes and
// erased scopes, v2's grammar productions -- so their structural keys are not comparable (v1 keys name
// authored identifiers, v2 keys name productions). What both trees share is the SOURCE: where a
// comment sits between two sibling constructs both parsers retain -- module items, statements, call
// arguments -- the two attachments must name the same neighbour TEXT on each side. Where the trees
// legitimately differ (v2's stmt_seq has no braces, v1's block does) the scopes' extents differ, so
// this control compares neighbours, not scopes.
//
// Imports v1.compiler.*, so it lives under manual/ and runs with src/v1 as a source root:
//   gunbc run --source-root dag --source-root src/v1 --source-root src/v2 --claim-run \
//     --entry src/v2/test/claim/manual/annotation_gap_v1_v2_agreement.dag

data agreement_source: String = "module zqx.agree\n\n// above the data row\ndata zqx_d: Int = 1\n\n// between the items\nfn zqx_f(a: Int, b: Int) -> Int \{\n  let x = zqx_g(\n    a,\n    // between the arguments\n    b\n  )\n  // between the statements\n  x\n\}\n\nfn zqx_g(p: Int, q: Int) -> Int \{\n  p\n\}\n"

data agreement_texts: List<String> = ["above the data row", "between the items", "between the arguments", "between the statements"]

fn row_text(row: SourceAnnotationDebt) -> String {
  row.text
}

fn row_before(row: SourceAnnotationDebt) -> Optional<AnnotationScope> {
  row.gap.before
}

fn row_after(row: SourceAnnotationDebt) -> Optional<AnnotationScope> {
  row.gap.after
}

fn slice(source: String, start: Int, end: Int) -> String {
  substring(s: source, start: start, end: end)
}

// ---- v1: neighbour text through the binder's own keyed regions.
fn v1_neighbours(source: String) -> List<String> {
  let file = "zqx_agree.dag"
  let artifact = tokenize_artifact(source: source, file: file, env: dag_parse_environment)
  let parsed = parse_with_table(
    tokens: artifact.tokens,
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source)),
    intern_table: empty_intern_table(),
  )
  let graph = bind_annotations(transport: parsed.occurrence_transport, extents: parsed.source_extents, captures: artifact.annotations)
  source_annotation_graph_rows(graph: graph)
    |> filter(r => agreement_texts |> any(t => t == row_text(row: r)))
    |> map(r => concat(row_text(row: r), " | ", v1_scope_text(source: source, scope: row_before(row: r)), " | ", v1_scope_text(source: source, scope: row_after(row: r))))
}

fn v1_scope_text(source: String, scope: Optional<AnnotationScope>) -> String {
  match scope {
    Absent => "<none>"
    Present { value: s } =>
      match s {
        FileScope => "<file>"
        ErasedSourceRegion { extent: e } => slice(source: source, start: e.start, end: e.end)
        OccurrenceScope { occurrence: _ } => v1_occurrence_text(source: source, scope: s)
      }
  }
}

// Recomputes nothing: the extent is the one the v1 parser recorded, read back by re-parsing the same
// bytes and looking the occurrence up in the published table.
fn v1_occurrence_text(source: String, scope: AnnotationScope) -> String {
  match scope {
    OccurrenceScope { occurrence: id } =>
      let file = "zqx_agree.dag"
      let parsed = parse_with_table(
        tokens: tokenize_artifact(source: source, file: file, env: dag_parse_environment).tokens,
        source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source)),
        intern_table: empty_intern_table(),
      )
      match parsed.source_extents.extents |> filter(row => row.occurrence == id) |> first {
        Present { value: row } => slice(source: source, start: row.extent.start, end: row.extent.end)
        Absent => "<no extent>"
      }
    _ => "<not an occurrence>"
  }
}

// ---- v2: neighbour text through the recorded SpanIndex extents.
fn v2_neighbours(source: String) -> List<String> {
  match lex_walk_artifact(source: chars(text: source), file: ^zqx_agree, rules: dag_lex_rules()) {
    Rejected { diagnostics: _ } => ["<no lex>"]
    Accepted { value: artifact, diagnostics: _ } =>
      match parse_module_authored(artifact: artifact, grammar: dag_language_model().grammar, annotation_text: fn(t) { strip_line_comment_delimiter(lexeme: t) }) {
        Rejected { diagnostics: _ } => ["<no parse>"]
        Accepted { value: authored, diagnostics: _ } =>
          v2_rows_text(source: source, rows: source_annotation_graph_rows(graph: authored_parse_annotations(artifact: authored)), index: authored_parse_semantic(artifact: authored).span_index)
      }
  }
}

fn v2_rows_text(source: String, rows: List<SourceAnnotationDebt>, index: v2.std.provenance.SpanIndex) -> List<String> {
  rows
    |> filter(r => agreement_texts |> any(t => t == row_text(row: r)))
    |> map(r => concat(row_text(row: r), " | ", v2_scope_text(source: source, index: index, scope: row_before(row: r)), " | ", v2_scope_text(source: source, index: index, scope: row_after(row: r))))
}

fn v2_scope_text(source: String, index: v2.std.provenance.SpanIndex, scope: Optional<AnnotationScope>) -> String {
  match scope {
    Absent => "<none>"
    Present { value: s } =>
      match s {
        FileScope => "<file>"
        ErasedSourceRegion { extent: e } => slice(source: source, start: e.start, end: e.end)
        OccurrenceScope { occurrence: id } =>
          match span_index_extent(index: index, id: id) {
            Present { value: recorded } =>
              match recorded {
                SourceExtentKnown { locus: l } =>
                  match l {
                    Textual { file: _, extent: ext } =>
                      match ext {
                        ByteRange { start: st, end: en } => slice(source: source, start: st, end: en)
                        WholeFile => "<whole>"
                      }
                    _ => "<other>"
                  }
                SourceExtentUnrepresentable => "<unrep>"
              }
            Absent => "<absent>"
          }
      }
  }
}

// BOTH PARSERS NAME THE SAME NEIGHBOUR TEXT for every comment between two retained siblings: between
// module items, between call arguments, between statements. The first row is the one place the two
// trees differ in this fixture, asserted rather than dropped: v2 retains the module header as its own
// production, so a comment below it has the header before it; v1's module node has no header child,
// so the same comment has nothing before it. Everything after the first row must match exactly.
test fn v1_and_v2_agree_on_neighbour_text_holds() -> Bool {
  let v1 = v1_neighbours(source: agreement_source)
  let v2 = v2_neighbours(source: agreement_source)
  (v1 |> count) == 4 && (v2 |> count) == 4
    && nth(xs: v1, i: 1) == nth(xs: v2, i: 1)
    && nth(xs: v1, i: 2) == nth(xs: v2, i: 2)
    && nth(xs: v1, i: 3) == nth(xs: v2, i: 3)
    && nth(xs: v1, i: 0) == "above the data row | <none> | data zqx_d: Int = 1"
    && nth(xs: v2, i: 0) == "above the data row | module zqx.agree | data zqx_d: Int = 1"
}

fn nth(xs: List<String>, i: Int) -> String {
  match list_at_optional(xs: xs, index: i) {
    Present { value: t } => t
    Absent => "<missing>"
  }
}

fn agreement_report() -> List<String> {
  concat(v1_neighbours(source: agreement_source), concat(["----"], v2_neighbours(source: agreement_source)))
}
