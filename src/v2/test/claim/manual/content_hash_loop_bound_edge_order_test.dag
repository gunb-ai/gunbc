module v2.test.manual.content_hash_loop_bound_edge_order

fn content_hash_loop_body_leaf() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^content_hash_loop_body_sym } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_loop_measure_leaf() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^content_hash_loop_measure_sym } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_loop_body() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body_leaf() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_loop_body_two() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body_leaf() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body_leaf() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_loop_bound_last() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body() },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^loop_bound_edge },
        target: content_hash_loop_measure_leaf()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_loop_bound_first() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^loop_bound_edge },
        target: content_hash_loop_measure_leaf()
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_loop_bound_middle() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body_two() },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^loop_bound_edge },
        target: content_hash_loop_measure_leaf()
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body_two() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_loop_bound_last_two_body() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body_two() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body_two() },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^loop_bound_edge },
        target: content_hash_loop_measure_leaf()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn content_hash_loop_with_extra_named() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: content_hash_loop_body() },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^loop_bound_edge },
        target: content_hash_loop_measure_leaf()
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^content_hash_loop_extra_named_sym },
        target: content_hash_loop_body_leaf()
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

test fn content_hash_loop_bound_edge_order_holds() -> Bool {
  v2.std.node.content_hash(n: content_hash_loop_bound_last()) ==
    v2.std.node.content_hash(n: content_hash_loop_bound_first())
  && v2.std.node.content_hash(n: content_hash_loop_bound_last_two_body()) ==
    v2.std.node.content_hash(n: content_hash_loop_bound_middle())
  && v2.std.node.content_hash(n: content_hash_loop_bound_last()) !=
    v2.std.node.content_hash(n: content_hash_loop_with_extra_named())
}
