module v2.test.manual.branch_infer


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn branch_infer_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn branch_infer_int_binding_type_node() -> Node {
  branch_infer_atom(s: ^dag_binding_type_int)
}

fn branch_infer_string_type_node() -> Node {
  branch_infer_atom(s: ^branch_infer_string_type)
}

fn branch_infer_if_body_from_arms(
  condition: Node,
  then_arm: Node,
  else_arm: Node
) -> Node {
  Node {
    kind: ComputationNode { behavior: Branch },
    children: [
      Edge { label: Positional, target: condition },
      Edge { label: Positional, target: then_arm },
      Edge { label: Positional, target: else_arm }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn branch_infer_bool_if_else_body_node() -> Outcome<Node> {
  outcome_accepted(
    value: branch_infer_if_body_from_arms(
      condition: branch_infer_atom(s: ^dag_token_kw_true),
      then_arm: dag_int_literal_fixture_one(),
      else_arm: dag_int_literal_fixture_two()
    )
  )
}

fn branch_infer_arm_mismatch_body_node() -> Outcome<Node> {
  outcome_accepted(
    value: branch_infer_if_body_from_arms(
      condition: branch_infer_atom(s: ^dag_token_kw_true),
      then_arm: dag_int_literal_fixture_one(),
      else_arm: branch_infer_string_type_node()
    )
  )
}

fn branch_infer_cond_not_bool_body_node() -> Outcome<Node> {
  outcome_accepted(
    value: branch_infer_if_body_from_arms(
      condition: dag_int_literal_fixture_one(),
      then_arm: dag_int_literal_fixture_one(),
      else_arm: dag_int_literal_fixture_two()
    )
  )
}

fn branch_infer_resolved_tree(root: Node) -> ResolvedTree {
  root
}

fn branch_infer_positional_target(body: Node, index: Int) -> Node {
  match list_at_optional(xs: node_positional_child_targets(node: body), index: index) {
    Present { value: target } => target
    Absent => branch_infer_atom(s: ^branch_infer_missing_child)
  }
}

fn branch_infer_run(tree: ResolvedTree) -> Outcome<InferredTree> {
  infer(tree: tree)
}

fn branch_infer_cond_child_is_bool(tree: InferredTree, body: Node) -> Bool {
  let cond = branch_infer_positional_target(body: body, index: 0)
  match inferred_facts_witness_for_node(tree: tree, node: cond) {
    Holds { value: facts } =>
      infer_branch_type_is_bool(
        type_node: infer_branch_operand_resolved_type(node: cond, facts: facts)
      )
    Violates { diagnostic: _ } => false
  }
}

fn branch_infer_branch_result_is_int(tree: InferredTree, body: Node) -> Bool {
  match inferred_facts_witness_for_node(tree: tree, node: body) {
    Holds { value: facts } =>
      infer_branch_type_atoms_equal(
        a: inferred_facts_resolved_type(facts: facts),
        b: branch_infer_int_binding_type_node()
      )
    Violates { diagnostic: _ } => false
  }
}

fn branch_infer_bool_cond_accepts_holds() -> Bool {
  match branch_infer_bool_if_else_body_node() {
    Accepted { value: body, diagnostics: _ } =>
      let tree = branch_infer_resolved_tree(root: body)
      match branch_infer_run(tree: tree) {
        Accepted { value: inferred, diagnostics: _ } =>
          branch_infer_cond_child_is_bool(tree: inferred, body: body)
            && branch_infer_branch_result_is_int(tree: inferred, body: body)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn branch_infer_arm_mismatch_red_holds() -> Bool {
  match branch_infer_arm_mismatch_body_node() {
    Accepted { value: body, diagnostics: _ } =>
      match branch_infer_run(tree: branch_infer_resolved_tree(root: body)) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

fn branch_infer_cond_not_bool_red_holds() -> Bool {
  match branch_infer_cond_not_bool_body_node() {
    Accepted { value: body, diagnostics: _ } =>
      match branch_infer_run(tree: branch_infer_resolved_tree(root: body)) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_infer_keystone_holds() -> Bool {
  branch_infer_bool_cond_accepts_holds()
    && branch_infer_arm_mismatch_red_holds()
    && branch_infer_cond_not_bool_red_holds()
}

fn branch_infer_constraint_satisfaction_grounding_rejected() -> CanonicalGrounding {
  CanonicalGrounding {
    node: branch_infer_atom(s: ^branch_infer_constraint_satisfaction_node),
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^preservation_rule_constraint_satisfaction,
        evidence: branch_infer_atom(s: ^branch_infer_constraint_satisfaction_evidence)
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: branch_infer_atom(s: ^branch_infer_constraint_satisfaction_node)
      }
    }
  }
}

test fn branch_infer_admission_gate_rejects_constraint_satisfaction_holds() -> Bool {
  !infer_grounding_admits_infer_facts(
    grounding: branch_infer_constraint_satisfaction_grounding_rejected()
  )
}
