module v2.test.manual.field_access_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data field_access_emitted_root: Node = dag_fixture_emitted_field_access_fn
data field_access_target_model: v2.std.compilers.target_model.TargetModel = dag_field_access_target_model()

fn field_access_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn field_access_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == dag_fixture_emitted_field_access_fn {
    v2.std.witness.Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_field_access_body_fixture {
    v2.std.witness.Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_field_access_arrow_domain_conj_node() {
    v2.std.witness.Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_int) {
    v2.std.witness.Holds {
      value: field_access_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_rec) {
    v2.std.witness.Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_binding_param_r) {
    v2.std.witness.Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_binding_rec_v) {
    v2.std.witness.Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_token_dot) {
    v2.std.witness.Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_fixture_int_inhabitant {
    v2.std.witness.Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    v2.std.witness.Holds {
      value: field_access_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^field_access_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn field_access_inferred_facts_for(node: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  match field_access_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: v2.std.witness.Holds { value: proof }
            ))
      }
  }
}

fn field_access_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  field_access_inferred_facts_for(node: key)
}

data field_access_inferred_tree: v2.compiler.infer.InferredTree = v2.compiler.infer.InferredTree {
  root: field_access_emitted_root,
  facts: std.types.Map { lookup: field_access_facts_lookup }
}

test fn field_access_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: field_access_target_model,
    emitted: field_access_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match emit(tree: field_access_inferred_tree, target: field_access_target_model) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn field_access_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: field_access_target_model,
    emitted: field_access_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn field_access_coercion_quality_is_faithful(q: v2.std.coercion.CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

test fn field_access_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: field_access_emitted_root,
    tree: field_access_inferred_tree,
    target: field_access_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_field_access_fn)
        && field_access_coercion_quality_is_faithful(q: result.quality)
        && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn field_access_emit_holds_keystone() -> Bool {
  field_access_emit_holds()
}

test fn field_access_grammar_inverse_holds_keystone() -> Bool {
  field_access_grammar_inverse_holds()
}

test fn field_access_ingest_via_coerce_holds_keystone() -> Bool {
  field_access_ingest_via_coerce_matches_canonical()
}

