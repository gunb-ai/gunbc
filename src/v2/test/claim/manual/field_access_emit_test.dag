module v2.test.manual.field_access_emit

import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.translate {
  coerce_grounded_node,
  grammar_inverse_source_validated,
  target_serialize_source_from_model
}
import v2.extdeps.languages.dag {
  dag_inhabitant_atom,
  dag_field_access_arrow_domain_conj_node,
  dag_field_access_body_fixture,
  dag_fixture_emitted_field_access_fn,
  dag_fixture_int_inhabitant,
  dag_field_access_source_text,
  dag_field_access_target_model,
  dag_type_atom_node
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.std.cardinality { termination_proof_witness_for_node }
import v2.std.collection {
  Map
}
import v2.std.optional {
  Optional,
  Present,
  Absent,
  optional_present,
  optional_absent
}
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.coercion { CoercionQuality, Exact, Identity, Widened }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.compilers.target_model { TargetModel }
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data field_access_emitted_root: Node = dag_fixture_emitted_field_access_fn
data field_access_target_model: TargetModel = dag_field_access_target_model()

fn field_access_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn field_access_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == dag_fixture_emitted_field_access_fn {
    Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_field_access_body_fixture {
    Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_field_access_arrow_domain_conj_node() {
    Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_int) {
    Holds {
      value: field_access_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else if node == dag_type_atom_node(identity: ^dag_binding_type_rec) {
    Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_binding_param_r) {
    Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_binding_rec_v) {
    Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_type_atom_node(identity: ^dag_token_dot) {
    Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_fixture_int_inhabitant {
    Holds { value: field_access_canonical_grounding(node: node, algebra: node) }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    Holds {
      value: field_access_canonical_grounding(
        node: node,
        algebra: dag_fixture_int_inhabitant
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^field_access_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn field_access_inferred_facts_for(node: Node) -> Optional<InferredFacts> {
  match field_access_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => optional_absent()
        Holds { value: proof } =>
          optional_present(value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            ))
      }
  }
}

fn field_access_facts_lookup(key: Node) -> Optional<InferredFacts> {
  field_access_inferred_facts_for(node: key)
}

data field_access_inferred_tree: InferredTree = InferredTree {
  root: field_access_emitted_root,
  facts: Map { lookup: field_access_facts_lookup }
}

test fn field_access_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: field_access_target_model,
    emitted: field_access_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match emit(tree: field_access_inferred_tree, target: field_access_target_model) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn field_access_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: field_access_target_model,
    emitted: field_access_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn field_access_coercion_quality_is_faithful(q: CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

test fn field_access_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: field_access_emitted_root,
    tree: field_access_inferred_tree,
    target: field_access_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_fixture_emitted_field_access_fn)
        && field_access_coercion_quality_is_faithful(q: result.quality)
        && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn field_access_emit_holds_keystone() -> Bool {
  field_access_emit_holds()
}

test fn field_access_grammar_inverse_holds_keystone() -> Bool {
  field_access_grammar_inverse_holds()
}

test fn field_access_ingest_via_coerce_holds_keystone() -> Bool {
  field_access_ingest_via_coerce_matches_canonical()
}

