module v2.test.manual.self_host_emit_reason_probe

import v2.compiler.self_host.compiler_closure_emit {
  emit_compiler_import_closure_from_ingest
}
import v2.extdeps.languages.rust { rust_target_model }
import v2.compiler.program_partition { partition_user_semantic_types_from_root }
import v2.test.manual.self_host_module_emit_derisk {
  derisk_ingest_for,
  derisk_module_admission,
  derisk_infer_outcome_for,
  src_single_arm_match,
  src_type_decl,
  src_fn_simple_body
}
import v2.compiler.infer { InferredTree }
import v2.std.algebra { length }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

fn probe_derived_row_count(src: String) -> Int {
  match derisk_infer_outcome_for(src: src) {
    Accepted { value: tree, diagnostics: _ } =>
      length(xs: partition_user_semantic_types_from_root(root: tree.root))
    Rejected { diagnostics: _ } => 0 - 1
  }
}

test fn probe_type_decl_derives_at_least_one() -> Bool { probe_derived_row_count(src: src_type_decl) > 0 }
test fn probe_type_decl_derives_zero() -> Bool { probe_derived_row_count(src: src_type_decl) == 0 }
test fn probe_fn_derives_at_least_one() -> Bool { probe_derived_row_count(src: src_fn_simple_body) > 0 }

fn probe_emit_rejects_with(src: String, reason: Symbol) -> Bool {
  match emit_compiler_import_closure_from_ingest(
    ingest: derisk_ingest_for(src: src),
    admission: derisk_module_admission(),
    target: rust_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == reason
  }
}

test fn probe_type_decl_ownership() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^target_use_site_ownership_lookup_miss) }
test fn probe_type_decl_atom() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^target_atom_realization_lookup_miss) }
test fn probe_type_decl_sig_codomain() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^rust_signature_codomain_missing) }
test fn probe_type_decl_sig_domain() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^rust_signature_domain_missing) }
test fn probe_type_decl_sig_shape() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^rust_signature_type_shape_unsupported) }
test fn probe_type_decl_tok_class() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^translate_concrete_token_class_missing) }
test fn probe_type_decl_conj_child() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^translate_conj_named_child_missing) }
test fn probe_type_decl_type_shape() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^translate_type_expression_shape_missing) }
test fn probe_type_decl_partition_facts() -> Bool { probe_emit_rejects_with(src: src_type_decl, reason: ^partition_facts_miss) }

test fn probe_fn_ownership() -> Bool { probe_emit_rejects_with(src: src_fn_simple_body, reason: ^target_use_site_ownership_lookup_miss) }
test fn probe_fn_sig_codomain() -> Bool { probe_emit_rejects_with(src: src_fn_simple_body, reason: ^rust_signature_codomain_missing) }
test fn probe_fn_type_shape() -> Bool { probe_emit_rejects_with(src: src_fn_simple_body, reason: ^translate_type_expression_shape_missing) }
