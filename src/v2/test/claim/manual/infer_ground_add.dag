module v2.test.manual.infer_ground_add


type InferReceiptCase

  = InferDiagnosticReceiptCase {
      label: String
      input_symbol: v2.std.node.Symbol
      input: Node
      expected_rejection: v2.std.diagnostic.NonEmptyDiagnostics
    }
  | InferCompilesReceiptCase {
      label: String
      input_symbol: v2.std.node.Symbol
      input: Node
      expected_value: Node
    }

fn fixture_int_type_node(atom: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn infer_receipt_symbol_node(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn infer_receipt_runtime_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: infer_receipt_symbol_node(s: ^infer_receipt_runtime_value_symbol),
      bytes: []
    }
  }
}

fn infer_receipt_runtime_diagnostic(n: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^infer_receipt_extdeps,
    at: node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
  }
}

fn infer_receipt_allocate_literal(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: infer_receipt_runtime_diagnostic(n: node)) }
}

fn infer_receipt_call_primitive(
  node: Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: infer_receipt_runtime_diagnostic(n: node)) }
}

fn infer_receipt_choose_branch(node: Node, _value: v2.std.runtime.RuntimeValue, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<Node> {
  v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: infer_receipt_runtime_diagnostic(n: node)) }
}

fn infer_receipt_step_loop(node: Node, _env: v2.std.runtime.EvaluationEnvironment) -> Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: infer_receipt_runtime_diagnostic(n: node)) }
}

fn infer_receipt_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: None }
}

fn infer_receipt_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: infer_receipt_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: infer_receipt_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: infer_receipt_choose_branch
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: infer_receipt_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: infer_receipt_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm
    }
  }
}

fn infer_receipt_case_input(case: InferReceiptCase) -> Node {
  match case {
    InferDiagnosticReceiptCase { input: input, label: _, input_symbol: _, expected_rejection: _ } => input
    InferCompilesReceiptCase { input: input, label: _, input_symbol: _, expected_value: _ } => input
  }
}

fn infer_receipt_claim(case: InferReceiptCase) -> v2.std.verification.TestClaim {
  match case {
    InferDiagnosticReceiptCase {
      label: label,
      input_symbol: _,
      input: input,
      expected_rejection: r
    } =>
      v2.std.verification.DiagnosticClaim {
        label: label,
        anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
        input: input,
        expected_rejection: r,
        classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
      }
    InferCompilesReceiptCase {
      label: label,
      input_symbol: _,
      input: input,
      expected_value: v
    } =>
      v2.std.verification.CompilesClaim {
        label: label,
        anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
        input: input,
        expected_value: v,
        classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
      }
  }
}

fn infer_receipt_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^infer_receipt_allocate_literal_sym,
    call_primitive: ^infer_receipt_call_primitive_sym,
    choose_branch: ^infer_receipt_choose_branch_sym,
    step_loop: ^infer_receipt_step_loop_sym,
    bind_value: ^infer_receipt_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn infer_receipt_context() -> v2.compiler.eval.EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^infer_receipt_interpretation_pin,
    interpretation: infer_receipt_interpretation(),
    structure_witness: infer_receipt_interpretation_structure_witness()
  )
}

fn infer_receipt_empty_tree(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: fn(_) {
        Absent
      }
    }
  }
}

fn infer_receipt_subject(case: InferReceiptCase) -> TestClaimEvalSubject<Node> {
  let input = infer_receipt_case_input(case: case)
  v2.compiler.eval.TestClaimEvalSubject {
    claim: infer_receipt_claim(case: case),
    context: infer_receipt_context(),
    tree: infer_receipt_empty_tree(root: input),
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: infer_receipt_case_pin(case: case)
    )
  }
}

fn infer_receipt_case_pin(case: InferReceiptCase) -> v2.std.node.Symbol {
  match case {
    InferDiagnosticReceiptCase { input_symbol: sym, label: _, input: _, expected_rejection: _ } => sym
    InferCompilesReceiptCase { input_symbol: sym, label: _, input: _, expected_value: _ } => sym
  }
}

fn infer_outcome_node_projection(actual: Outcome<v2.compiler.infer.InferredTree>) -> Outcome<Node> {
  match actual {
    Accepted { value: tree, diagnostics: ad } =>
      v2.std.diagnostic.Accepted { value: tree.root, diagnostics: ad }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn infer_add_receipt_run(
  subject: TestClaimEvalSubject<Node>,
) -> TestClaimRun<Node, InferredTree> {
  let actual = anchor_infer_add()
  v2.compiler.eval.TestClaimRun {
    cache: test_claim_cache_receipt(subject: subject),
    verdict: match test_claim_expected_outcome(c: subject.claim) {
      Accepted { value: expected, diagnostics: _ } =>
        match actual {
          Accepted { value: tree, diagnostics: ad } =>
            if outcome_node_eq(
              a: v2.std.diagnostic.Accepted { value: tree.root, diagnostics: ad },
              b: expected
            ) {
              Pass
            } else {
              verdict_fail(actual: actual)
            }
          Rejected { diagnostics: _ } =>
            if outcome_node_eq(
              a: infer_outcome_node_projection(actual: actual),
              b: expected
            ) {
              Pass
            } else {
              verdict_fail(actual: actual)
            }
        }
      Rejected { diagnostics: _ } => verdict_fail(actual: actual)
    }
  }
}

fn infer_descent_witness_receipt_run(
  subject: TestClaimEvalSubject<Node>,
) -> TestClaimRun<Node, Node> {
  let actual = infer_descent_witness_contract_node(n: subject.input.evaluator_input)
  v2.compiler.eval.TestClaimRun {
    cache: test_claim_cache_receipt(subject: subject),
    verdict: match test_claim_expected_outcome(c: subject.claim) {
      Accepted { value: expected, diagnostics: _ } =>
        if outcome_node_eq(a: actual, b: expected) {
          Pass
        } else {
          verdict_fail(actual: actual)
        }
      Rejected { diagnostics: _ } => verdict_fail(actual: actual)
    }
  }
}

fn fixture_add_resolved_node() -> Node {
  fixture_add_resolved_tree()
}
fn fixture_add_resolved_tree() -> v2.compiler.resolve.ResolvedTree {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^fixture_add_name },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: Arrow },
          children: [
            v2.std.node.Edge {
              label: Positional,
              target: fixture_int_type_node(atom: ^fixture_add_int_atom)
            },
            v2.std.node.Edge {
              label: Positional,
              target: fixture_int_type_node(atom: ^fixture_add_int_atom)
            },
            v2.std.node.Edge {
              label: Positional,
              target: fixture_int_type_node(atom: ^fixture_add_body_int_atom)
            }
          ],
          occurrence_id: SyntheticOccurrence
}
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn anchor_infer_add() -> Outcome<v2.compiler.infer.InferredTree> {
  infer(tree: fixture_add_resolved_tree())
}

fn infer_descent_witness_contract_node(n: Node) -> Outcome<Node> {
  match infer_descent_witness_for_node(n: n) {
    Holds { value: _ } => v2.std.diagnostic.Accepted { value: n, diagnostics: None }
    Violates { diagnostic: d } =>
      v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

data case_infer_add_compiles: InferReceiptCase = InferCompilesReceiptCase {
  label: "manual/infer: infer(fixture_add_resolved_tree) derives descent and accepts",
  input_symbol: ^infer_receipt_input_infer_add,
  input: fixture_add_resolved_tree(),
  expected_value: fixture_add_resolved_tree()
}

data subject_infer_add_compiles: TestClaimEvalSubject<Node> = infer_receipt_subject(case: case_infer_add_compiles)

data run_infer_add_compiles: TestClaimRun<Node, InferredTree> = infer_add_receipt_run(subject: subject_infer_add_compiles)

data case_infer_descent_witness_holds_atom: InferReceiptCase = InferCompilesReceiptCase {
  label: "manual/infer: infer_descent_witness_contract_node Holds on bounded Atom TypeNode",
  input_symbol: ^infer_receipt_input_descent_witness,
  input: fixture_int_type_node(atom: ^fixture_add_int_atom),
  expected_value: fixture_int_type_node(atom: ^fixture_add_int_atom)
}

data subject_infer_descent_witness_holds_atom: TestClaimEvalSubject<Node> = infer_receipt_subject(case: case_infer_descent_witness_holds_atom)

data run_infer_descent_witness_holds_atom: TestClaimRun<Node, Node> = infer_descent_witness_receipt_run(subject: subject_infer_descent_witness_holds_atom)

data claim_infer_add_compiles: v2.std.verification.TestClaim = infer_receipt_claim(case: case_infer_add_compiles)

data claim_infer_descent_witness_holds_atom: v2.std.verification.TestClaim = infer_receipt_claim(case: case_infer_descent_witness_holds_atom)
