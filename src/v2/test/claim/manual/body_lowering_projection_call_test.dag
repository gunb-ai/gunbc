module v2.test.manual.body_lowering_projection_call

import v2.compiler.body_lowering_fold {
  body_lower_try_postfix_projection,
  body_lower_unwrap_captured
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_language_model,
  parse_production_emitted_identity_optional
}
import v2.std.grammar { node_atom_identity_optional }
import v2.std.node_query { call_argument_targets, call_callee_target, node_is_call }
import v2.std.collection { list_at_optional }
import v2.std.optional {
  Absent,
  Optional,
  Present
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  ComputationNode,
  Node,
  Symbol,
  Transform
}

data body_lowering_projection_source: String = "module proj\n\nfn f(acc: Int, x: Int) -> Int {\n  helper.step(a: acc, b: x)\n}\n"

data filing_ident_and_nested_source: String = "module m\n\nfn h(y: Int) -> Int { y }\n\nfn g(x: Int, y: Int) -> Int { x }\n\nfn ident_caller() -> Int { g(x: 1, y: 0) }\n\nfn nested_caller() -> Int { g(x: h(y: 5), y: 9) }\n"

fn body_lowering_find_postfix_expr(root: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: emitted } =>
      match emitted == ^dag_surface_postfix_expr {
        true => Present { value: root }
        false =>
          fold(root.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lowering_find_postfix_expr(root: e.target)
            }
          })
      }
    Absent =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lowering_find_postfix_expr(root: e.target)
        }
      })
  }
}

fn body_lowering_parsed_module() -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(
    text: body_lowering_projection_source,
    file: ^body_lowering_proj_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } => Present { value: artifact.tree }
      }
  }
}

fn search_call_named(root: Node, callee: Symbol) -> Optional<Node> {
  match node_is_call(node: root) {
    false => search_call_named_children(root: root, callee: callee)
    true =>
      match call_callee_target(node: root) {
        Accepted { value: c, diagnostics: _ } =>
          match node_atom_identity_optional(node: c) {
            Present { value: id } =>
              match id == callee {
                true => Present { value: root }
                false => search_call_named_children(root: root, callee: callee)
              }
            Absent => search_call_named_children(root: root, callee: callee)
          }
        Rejected { diagnostics: _ } => search_call_named_children(root: root, callee: callee)
      }
  }
}

fn search_call_named_children(root: Node, callee: Symbol) -> Optional<Node> {
  fold(root.children, init: Absent, f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => search_call_named(root: e.target, callee: callee)
    }
  })
}

fn call_named_arity(root: Node, callee: Symbol) -> Int {
  match search_call_named(root: root, callee: callee) {
    Absent => 0
    Present { value: call } => count(call_argument_targets(node: call))
  }
}

fn tree_has_punct_call_operator(root: Node, punct: Symbol) -> Bool {
  let here = match call_callee_target(node: root) {
    Accepted { value: c, diagnostics: _ } =>
      match node_atom_identity_optional(node: c) {
        Present { value: id } => id == punct
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
  here || fold(root.children, init: false, f: fn(acc, e) {
    acc || tree_has_punct_call_operator(root: e.target, punct: punct)
  })
}

fn normalize_source_root(src: String, file: Symbol) -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(text: src, file: file, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: normalized, diagnostics: _ } => Present { value: normalized.root }
          }
      }
  }
}

fn count_calls_named(root: Node, callee: Symbol) -> Int {
  let here = if node_is_call(node: root) {
    match call_callee_target(node: root) {
      Accepted { value: c, diagnostics: _ } =>
        match node_atom_identity_optional(node: c) {
          Present { value: id } => if id == callee { 1 } else { 0 }
          Absent => 0
        }
      Rejected { diagnostics: _ } => 0
    }
  } else {
    0
  }
  here + fold(root.children, init: 0, f: fn(acc, e) {
    acc + count_calls_named(root: e.target, callee: callee)
  })
}

fn nested_arg_is_call(root: Node, outer: Symbol, inner: Symbol) -> Bool {
  let here = if node_is_call(node: root) {
    match call_callee_target(node: root) {
      Accepted { value: c, diagnostics: _ } =>
        match node_atom_identity_optional(node: c) {
          Present { value: id } =>
            if id == outer {
              match list_at_optional(xs: call_argument_targets(node: root), index: 0) {
                Absent => false
                Present { value: arg0 } =>
                  match search_call_named(root: arg0, callee: inner) {
                    Present { value: _ } => true
                    Absent => false
                  }
              }
            } else {
              false
            }
          Absent => false
        }
      Rejected { diagnostics: _ } => false
    }
  } else {
    false
  }
  here || fold(root.children, init: false, f: fn(acc, e) {
    acc || nested_arg_is_call(root: e.target, outer: outer, inner: inner)
  })
}

fn call_named_has_arity(root: Node, callee: Symbol, arity: Int) -> Bool {
  let here = if node_is_call(node: root) {
    match call_callee_target(node: root) {
      Accepted { value: c, diagnostics: _ } =>
        match node_atom_identity_optional(node: c) {
          Present { value: id } =>
            (id == callee) && (count(call_argument_targets(node: root)) == arity)
          Absent => false
        }
      Rejected { diagnostics: _ } => false
    }
  } else {
    false
  }
  here || fold(root.children, init: false, f: fn(acc, e) {
    acc || call_named_has_arity(root: e.target, callee: callee, arity: arity)
  })
}

fn filing_ident_and_nested_preserved() -> Bool {
  match normalize_source_root(src: filing_ident_and_nested_source, file: ^filing_ident_nested) {
    Absent => false
    Present { value: root } =>
      (count_calls_named(root: root, callee: ^g) == 2)
        && nested_arg_is_call(root: root, outer: ^g, inner: ^h)
        && call_named_has_arity(root: root, callee: ^g, arity: 2)
  }
}

test fn body_lowering_projection_lowers_to_transform() -> Bool {
  match body_lowering_parsed_module() {
    Absent => false
    Present { value: tree } =>
      match body_lowering_find_postfix_expr(root: tree) {
        Absent => false
        Present { value: postfix } =>
          match body_lower_unwrap_captured(shell: postfix) {
            Present { value: captured } =>
              match body_lower_try_postfix_projection(node: captured) {
                Rejected { diagnostics: _ } => false
                Accepted { value: found, diagnostics: _ } =>
                  match found {
                    Present { value: lowered } =>
                      match lowered.kind {
                        ComputationNode { behavior: Transform } => true
                        _ => false
                      }
                    Absent => false
                  }
              }
            Absent => false
          }
      }
  }
}

data body_lowering_field_access_source: String = "module fa\n\nfn f(x: Int) -> Int { x.field }\n"

test fn body_lowering_field_access_postfix_rejects() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: body_lowering_field_access_source,
    file: ^body_lowering_proj_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match body_lowering_find_postfix_expr(root: artifact.tree) {
            Absent => false
            Present { value: postfix } =>
              match body_lower_unwrap_captured(shell: postfix) {
                Present { value: captured } =>
                  match body_lower_try_postfix_projection(node: captured) {
                    Rejected { diagnostics: _ } => true
                    Accepted { value: _, diagnostics: _ } => false
                  }
                Absent => false
              }
          }
      }
  }
}

test fn body_lowering_normalize_accepts_projection_module() -> Bool {
  let lm = dag_language_model()
  match tokenize(
    text: body_lowering_projection_source,
    file: ^body_lowering_proj_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: normalized, diagnostics: _ } =>
              (call_named_arity(root: normalized.root, callee: ^step) == 2)
                && !tree_has_punct_call_operator(root: normalized.root, punct: ^dag_token_lbrace)
                && filing_ident_and_nested_preserved()
          }
      }
  }
}

