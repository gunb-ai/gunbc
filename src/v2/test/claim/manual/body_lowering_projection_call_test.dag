module v2.test.manual.body_lowering_projection_call

data body_lowering_projection_source: String = "module proj\n\nfn f(acc: Int, x: Int) -> Int {\n  helper.step(a: acc, b: x)\n}\n"

fn body_lowering_find_postfix_expr(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: root) {
    v2.std.optional.Present { value: emitted } =>
      match emitted == ^dag_surface_postfix_expr {
        true => v2.std.optional.Present { value: root }
        false =>
          fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
            match acc {
              v2.std.optional.Present { value: _ } => acc
              v2.std.optional.Absent => body_lowering_find_postfix_expr(root: e.target)
            }
          })
      }
    v2.std.optional.Absent =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => body_lowering_find_postfix_expr(root: e.target)
        }
      })
  }
}

fn body_lowering_parsed_module() -> v2.std.optional.Optional<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: body_lowering_projection_source,
    file: ^body_lowering_proj_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
    Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
        Accepted { value: artifact, diagnostics: _ } => v2.std.optional.Present { value: artifact.tree }
      }
  }
}

test fn body_lowering_projection_lowers_to_transform() -> v2.std.logic.Bool {
  match body_lowering_parsed_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match body_lowering_find_postfix_expr(root: tree) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: postfix } =>
          match v2.compiler.body_lowering_fold.body_lower_unwrap_captured(shell: postfix) {
            v2.std.optional.Present { value: captured } =>
              match v2.compiler.body_lowering_fold.body_lower_try_postfix_projection(node: captured) {
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
                Accepted { value: found, diagnostics: _ } =>
                  match found {
                    v2.std.optional.Present { value: lowered } =>
                      match lowered.kind {
                        ComputationNode { behavior: v2.std.node.Transform } => true
                        _ => false
                      }
                    v2.std.optional.Absent => false
                  }
              }
            v2.std.optional.Absent => false
          }
      }
  }
}

data body_lowering_field_access_source: String = "module fa\n\nfn f(x: Int) -> Int { x.field }\n"

test fn body_lowering_field_access_postfix_rejects() -> v2.std.logic.Bool {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: body_lowering_field_access_source,
    file: ^body_lowering_proj_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match body_lowering_find_postfix_expr(root: artifact.tree) {
            v2.std.optional.Absent => false
            v2.std.optional.Present { value: postfix } =>
              match v2.compiler.body_lowering_fold.body_lower_unwrap_captured(shell: postfix) {
                v2.std.optional.Present { value: captured } =>
                  match v2.compiler.body_lowering_fold.body_lower_try_postfix_projection(node: captured) {
                    v2.std.diagnostic.Rejected { diagnostics: _ } => true
                    Accepted { value: _, diagnostics: _ } => false
                  }
                v2.std.optional.Absent => false
              }
          }
      }
  }
}

test fn body_lowering_normalize_accepts_projection_module() -> v2.std.logic.Bool {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: body_lowering_projection_source,
    file: ^body_lowering_proj_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: artifact.tree) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
            Accepted { value: _, diagnostics: _ } => true
          }
      }
  }
}

