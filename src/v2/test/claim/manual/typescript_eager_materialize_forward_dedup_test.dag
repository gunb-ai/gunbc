module v2.test.manual.typescript_eager_materialize_forward_dedup


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn ts_arc1_row_token_spine_classes(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Symbol>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: std.algebra.Empty,
            f: fn(acc, t) {
              v2.std.algebra.list_append(
                left: acc,
                right: [v2.std.compilers.target_model.concrete_syntax_token_class(token: t)]
              )
            }
          )
          v2.std.diagnostic.outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn ts_arc1_rules_with_duplicate_spine_rows() -> v2.std.node.Node {
  match v2.extdeps.languages.typescript.ts_task_type_alias_relation_row_witness() {
    v2.std.witness.Holds { value: eager_row } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [
          v2.extdeps.languages.typescript.ts_named_edge(
            name: ^ts_relation_rule_type_alias_task,
            target: eager_row
          ),
          v2.extdeps.languages.typescript.ts_named_edge(
            name: ^ts_arc1_forward_row_many_collision_dup,
            target: eager_row
          )
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
    v2.std.witness.Violates { diagnostic: _ } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
  }
}

fn ts_arc1_dedup_cutover_rules() -> v2.std.node.Node {
  match v2.extdeps.languages.typescript.ts_task_type_alias_relation_row_witness() {
    v2.std.witness.Holds { value: eager_row } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [
          v2.extdeps.languages.typescript.ts_named_edge(
            name: ^ts_relation_rule_type_alias_task,
            target: eager_row
          )
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
    v2.std.witness.Violates { diagnostic: _ } =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
  }
}

fn ts_arc1_forward_row_many_without_dedup_red_body() -> Bool {
  match v2.extdeps.languages.typescript.ts_task_type_alias_relation_row_witness() {
    v2.std.witness.Holds { value: row } =>
      match ts_arc1_row_token_spine_classes(row: row) {
        v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
          match v2.compiler.ingest.grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: ts_arc1_rules_with_duplicate_spine_rows()
          ) {
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
            v2.std.diagnostic.Rejected { diagnostics: _ } => true
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

fn ts_arc1_forward_row_dedup_cutover_green_body() -> Bool {
  match v2.extdeps.languages.typescript.ts_task_type_alias_relation_row_witness() {
    v2.std.witness.Holds { value: row } =>
      match ts_arc1_row_token_spine_classes(row: row) {
        v2.std.diagnostic.Accepted { value: frontier, diagnostics: _ } =>
          match v2.compiler.ingest.grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: ts_arc1_dedup_cutover_rules()
          ) {
            v2.std.diagnostic.Accepted { value: emitted, diagnostics: d } =>
              (d == None) && (emitted == v2.extdeps.languages.typescript.ts_task_type_alias_emitted())
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.witness.Violates { diagnostic: _ } => false
  }
}

test fn ts_arc1_forward_row_many_without_dedup_red_holds() -> Bool {
  ts_arc1_forward_row_many_without_dedup_red_body()
}

test fn ts_arc1_forward_row_dedup_cutover_green_holds() -> Bool {
  ts_arc1_forward_row_dedup_cutover_green_body()
}
