module v2.test.manual.bash_command_fold_two_runner

import std.realization_schedule { Runnable, RunnableSingleClaim }
import v2.std.collection { List }

data bash_fold_two_entry: String = "src/v2/test/claim/bash_command_fold_test.dag"

fn bash_command_fold_two_plan() -> List<List<Runnable>> {
  [
    [
      RunnableSingleClaim {
        entry: bash_fold_two_entry,
        function: "bash_fold_relation_row_true_witness_holds"
      },
      RunnableSingleClaim {
        entry: bash_fold_two_entry,
        function: "bash_fold_command_single_lit_true_holds"
      }
    ]
  ]
}
