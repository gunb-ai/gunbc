module v2.test.manual.sql_create_table_fold_runner

import std.realization_schedule { Runnable, RunnableSingleClaim }
import v2.std.collection { List }

data sql_fold_test_entry: String = "src/v2/test/claim/sql_create_table_fold_test.dag"

fn sql_create_table_fold_plan() -> List<List<Runnable>> {
  [
    [
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_relation_row_single_col_witness_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_create_table_single_col_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_create_table_two_col_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_create_table_with_pk_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_wrong_production_rejects_oracle_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_direct_serialize_single_col_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_oracle_rejects_unsupported_drop_table_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_oracle_rejects_parameterized_numeric_type_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_two_col_uses_recursive_list_production_holds"
      },
      RunnableSingleClaim {
        entry: sql_fold_test_entry,
        function: "sql_fold_single_col_uses_leaf_list_production_holds"
      }
    ]
  ]
}
