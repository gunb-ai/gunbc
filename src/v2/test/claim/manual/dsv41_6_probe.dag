module test.claim.manual.dsv41_6_probe

import std.types { Bool, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.fleet_bootstrap_principal_session {
  open_fleet_password_leg,
  PasswordLegPrerequisiteReady,
  PasswordLegPrerequisiteRefused,
  BootstrapCredentialNotHeld,
}
import test.claim.fleet_bootstrap_principal_session_witness {
  the_bootstrap_principal_leg_reaches_the_password_transport_by_execution,
  a_missing_password_session_binary_refuses_before_the_transport,
  a_present_password_session_binary_reaches_the_credential,
}
import test.claim.host_cli_dependency_witness_test {
  password_session_enrollment_names_the_execed_binary,
  password_session_roster_carries_the_sshpass_requirement,
}
import test.claim.host_cli_dependency_wet_witness_test {
  observe_sshpass_wet_posix_command_v_check_does_not_crash,
  password_session_enrollment_walks_wet_without_crashing,
}

func probe_hermetic_rows() -> ProcessExit {
  if password_session_enrollment_names_the_execed_binary()
    && password_session_roster_carries_the_sshpass_requirement() {
    ExitSuccess
  } else {
    exit_failure(reason: "hermetic sshpass enrollment witnesses RED")
  }
}

func probe_wet_rows() -> ProcessExit {
  if observe_sshpass_wet_posix_command_v_check_does_not_crash()
    && password_session_enrollment_walks_wet_without_crashing() {
    ExitSuccess
  } else {
    exit_failure(reason: "wet sshpass enrollment witnesses RED")
  }
}

func probe_leg_refusal() -> ProcessExit {
  match open_fleet_password_leg(credential: BootstrapCredentialNotHeld) {
    PasswordLegPrerequisiteReady { password_file: p } =>
      exit_failure(reason: concat("READY (no refusal): ", p as String))
    PasswordLegPrerequisiteRefused { cause: c } =>
      exit_failure(reason: concat("REFUSED: ", c as String))
  }
}

func probe_discriminator_regression() -> ProcessExit {
  if the_bootstrap_principal_leg_reaches_the_password_transport_by_execution()
    && a_missing_password_session_binary_refuses_before_the_transport()
    && a_present_password_session_binary_reaches_the_credential() {
    ExitSuccess
  } else {
    exit_failure(reason: "discriminator or new hermetic prerequisite pair RED")
  }
}
