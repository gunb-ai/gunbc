module v2.test.manual.refinement_vacuous_stub_pack

import v2.std.refinement {
  VacuousValidation,
  vacuous_admits_marker,
  refined_base,
  refined_vacuous_stub_pack,
}
import v2.std.diagnostic {
  Locus,
  Textual,
  WholeFile,
}
import v2.std.integer { Int }

fn test_locus() -> Locus {
  Textual { file: ^refinement_vacuous_stub_pack_test_file, extent: WholeFile }
}

data stub_pack_vacuous_validation: VacuousValidation<Int> = VacuousValidation {
  reason: ^refinement_vacuous_stub_pack_test_invalid,
  vacuous: vacuous_admits_marker
}

test fn stub_pack_round_trips_the_base_value() -> Bool {
  refined_base(
    r: refined_vacuous_stub_pack(base: 7, by: stub_pack_vacuous_validation, at: test_locus())
  ) == 7
}
