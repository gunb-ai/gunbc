module v2.test.manual.emit_host_match_equals_eval

import v2.compiler.body_producer {
  produce_mvp1_match_arrow_with_body,
  produce_mvp1_match_arrow_with_body_swapped_arms
}
import v2.compiler.emit_host {
  emit_host_octets_byte_string,
  run_test_claim_emit_vs_eval
}
import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_test_claim_subject
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.dag {
  dag_mvp1_match_arrow_with_body_fixture
}
import v2.extdeps.languages.rust {
  rust_emit_host_runtime_primitive_type_node,
  rust_mvp1_match_target_model_staging
}
import v2.std.collection { List, Map, list_at_optional }
import v2.std.compilers.target_model {
  match_arm_body,
  match_arm_pattern
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.machine { Byte }
import v2.std.node {
  Atom,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  Transform,
  TypeNode
}
import v2.std.node_query {
  find_named_child,
  node_positional_child_targets
}
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  MatchInterpreter,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v2.std.verdict { Deferred, Fail, Pass, Verdict }
import v2.std.verification {
  EqualsClaim,
  Integration,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  manual_claim_anchor
}
import v2.std.witness { Holds, Violates, Witness }

data emit_match_eval_call_pin: Symbol = ^emit_match_eval_call_pin

fn emit_match_eval_octet_value(n: Int) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: rust_emit_host_runtime_primitive_type_node(),
      bytes: emit_host_octets_byte_string(octets: [0, n, 0, 0, 0])
    }
  }
}

fn emit_match_eval_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_match_eval_bool_true(value: RuntimeValue) -> Bool {
  value == emit_match_eval_octet_value(n: 1)
}

fn emit_match_eval_bool_false(value: RuntimeValue) -> Bool {
  value == emit_match_eval_octet_value(n: 0)
}

fn emit_match_eval_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^dag_token_kw_true {
        outcome_accepted(value: emit_match_eval_octet_value(n: 1))
      } else if id == ^dag_token_kw_false {
        outcome_accepted(value: emit_match_eval_octet_value(n: 0))
      } else if id == ^dag_mvp1_pick_lit_one {
        outcome_accepted(value: emit_match_eval_octet_value(n: 1))
      } else if id == ^dag_mvp1_pick_lit_two {
        outcome_accepted(value: emit_match_eval_octet_value(n: 2))
      } else {
        outcome_rejected(
          diagnostics: diagnostics_singleton(
            d: emit_match_eval_diagnostic(
              reason: ^emit_match_eval_literal_miss,
              node: node
            )
          )
        )
      }
    _ =>
      outcome_rejected(
        diagnostics: diagnostics_singleton(
          d: emit_match_eval_diagnostic(reason: ^emit_match_eval_literal_miss, node: node)
        )
      )
  }
}

fn emit_match_eval_call_primitive(
  _node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  outcome_rejected(
    diagnostics: diagnostics_singleton(
      d: emit_match_eval_diagnostic(
        reason: ^emit_match_eval_call_primitive_miss,
        node: _node
      )
    )
  )
}

fn emit_match_eval_choose_branch(
  _node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  outcome_rejected(
    diagnostics: diagnostics_singleton(
      d: emit_match_eval_diagnostic(reason: ^emit_match_eval_branch_miss, node: _node)
    )
  )
}

fn emit_match_eval_step_loop(
  node: Node,
  _env: EvaluationEnvironment
) -> Outcome<ControlTransfer> {
  outcome_rejected(
    diagnostics: diagnostics_singleton(
      d: emit_match_eval_diagnostic(reason: ^emit_match_eval_loop_miss, node: node)
    )
  )
}

fn emit_match_eval_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn emit_match_eval_pattern_atom(arm_wire: Node) -> Outcome<Symbol> {
  bind_outcome(
    o: find_named_child(root: arm_wire, name: match_arm_pattern),
    f: fn(pattern_node) {
      match pattern_node.kind {
        TypeNode { connective: Atom { identity: id } } => outcome_accepted(value: id)
        _ =>
          outcome_rejected(
            diagnostics: diagnostics_singleton(
              d: emit_match_eval_diagnostic(
                reason: ^emit_match_eval_pattern_shape,
                node: arm_wire
              )
            )
          )
      }
    }
  )
}

fn emit_match_eval_arm_body(arm_wire: Node) -> Outcome<Node> {
  bind_outcome(
    o: find_named_child(root: arm_wire, name: match_arm_body),
    f: fn(body_node) {
      outcome_accepted(value: body_node)
    }
  )
}

fn emit_match_eval_pattern_matches(pattern_id: Symbol, scrutinee: RuntimeValue) -> Bool {
  if pattern_id == ^dag_token_kw_true {
    emit_match_eval_bool_true(value: scrutinee)
  } else if pattern_id == ^dag_token_kw_false {
    emit_match_eval_bool_false(value: scrutinee)
  } else {
    false
  }
}

fn emit_match_eval_try_arm(
  match_node: Node,
  arm_index: Int,
  scrutinee: RuntimeValue
) -> Outcome<Node> {
  match list_at_optional(xs: node_positional_child_targets(node: match_node), index: arm_index) {
    Present { value: arm_wire } =>
      bind_outcome(
        o: emit_match_eval_pattern_atom(arm_wire: arm_wire),
        f: fn(pattern_id) {
          if emit_match_eval_pattern_matches(pattern_id: pattern_id, scrutinee: scrutinee) {
            emit_match_eval_arm_body(arm_wire: arm_wire)
          } else {
            outcome_rejected(
              diagnostics: diagnostics_singleton(
                d: emit_match_eval_diagnostic(
                  reason: ^emit_match_eval_arm_miss,
                  node: match_node
                )
              )
            )
          }
        }
      )
    Absent =>
      outcome_rejected(
        diagnostics: diagnostics_singleton(
          d: emit_match_eval_diagnostic(reason: ^emit_match_eval_arm_miss, node: match_node)
        )
      )
  }
}

fn emit_match_eval_choose_arm(
  node: Node,
  scrutinee: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  match emit_match_eval_try_arm(match_node: node, arm_index: 1, scrutinee: scrutinee) {
    Accepted { value: body, diagnostics: d } => Accepted { value: body, diagnostics: d }
    Rejected { diagnostics: _ } =>
      emit_match_eval_try_arm(match_node: node, arm_index: 2, scrutinee: scrutinee)
  }
}

fn emit_match_eval_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: emit_match_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: emit_match_eval_call_primitive },
    branch: BranchInterpreter { choose_branch: emit_match_eval_choose_branch },
    loop: LoopInterpreter { step_loop: emit_match_eval_step_loop },
    bind: BindInterpreter { bind_value: emit_match_eval_bind_value },
    match: MatchInterpreter { choose_arm: emit_match_eval_choose_arm }
  }
}

fn emit_match_eval_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^emit_match_eval_allocate_literal_sym,
    call_primitive: ^emit_match_eval_call_primitive_sym,
    choose_branch: ^emit_match_eval_choose_branch_sym,
    step_loop: ^emit_match_eval_step_loop_sym,
    bind_value: ^emit_match_eval_bind_value_sym,
    choose_arm: ^emit_match_eval_choose_arm_sym
  }
}

fn emit_match_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^emit_match_eval_interpretation_pin,
    interpretation: emit_match_eval_interpretation(),
    structure_witness: emit_match_eval_structure_witness()
  )
}

fn emit_match_eval_call_node(callee: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [Edge { label: Positional, target: callee }],
    occurrence_id: SyntheticOccurrence
  }
}

data emit_match_eval_subgraph_node: Node = emit_match_eval_call_node(
  callee: dag_mvp1_match_arrow_with_body_fixture
)

fn emit_match_eval_facts_miss(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^emit_match_eval_facts_not_consulted,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn emit_match_eval_producer_tree() -> Outcome<InferredTree> {
  match produce_mvp1_match_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: InferredTree {
          root: root,
          facts: Map { lookup: emit_match_eval_facts_miss }
        },
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn emit_match_eval_swapped_producer_tree() -> Outcome<InferredTree> {
  match produce_mvp1_match_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: InferredTree {
          root: root,
          facts: Map { lookup: emit_match_eval_facts_miss }
        },
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn emit_match_eval_subject_tree(tree: InferredTree) -> InferredTree {
  tree
}

fn emit_match_eval_claim(rhs_result_node: Node) -> TestClaim {
  EqualsClaim {
    label: "S2 B9: rust emit(match-fn) host-run == eval(one_or_two-call) via shared octet codec",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: rhs_result_node,
    rhs: rhs_result_node,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

fn emit_match_eval_subject(tree: InferredTree) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: emit_match_eval_claim(rhs_result_node: emit_match_eval_subgraph_node),
    context: emit_match_eval_context(),
    tree: emit_match_eval_subject_tree(tree: tree),
    evaluator_pin: ^emit_match_eval_evaluator_pin
  )
}

fn emit_match_eval_run(tree: InferredTree) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: emit_match_eval_subject(tree: tree),
    target: rust_mvp1_match_target_model_staging()
  )
}

fn emit_match_eval_verdict_is_pass(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    Fail { actual: _, falsification: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

fn emit_match_eval_verdict_is_fail(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Fail { actual: _, falsification: _ } => true
    Pass => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}

test fn emit_host_match_equals_eval_holds() -> Bool {
  match emit_match_eval_producer_tree() {
    Accepted { value: tree, diagnostics: d } =>
      emit_match_eval_verdict_is_pass(run: emit_match_eval_run(tree: tree)) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_wrong_fixture_refuses_holds() -> Bool {
  match emit_match_eval_swapped_producer_tree() {
    Accepted { value: tree, diagnostics: d } =>
      emit_match_eval_verdict_is_fail(run: emit_match_eval_run(tree: tree)) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_host_match_equals_eval_all_holds() -> Bool {
  emit_host_match_equals_eval_holds() && emit_host_match_wrong_fixture_refuses_holds()
}
