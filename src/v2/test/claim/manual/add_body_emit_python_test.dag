module v2.test.manual.add_body_emit_python


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data python_add_emit_perturbed_source_text: String = "def add(a, b): return a + b"

fn python_add_emit_perturbed_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^python_binding_fn_add, "add"),
      ^python_binding_param_x,
      "a"
    ),
    ^python_binding_param_y,
    "b"
  )
}

fn python_add_emit_perturbed_target_model() -> TargetModel {
  TargetModel {
    bundle: python_target_model_node(),
    lex: python_lex(),
    binding_spellings: python_add_emit_perturbed_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: python_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn python_add_emit_from_tree(target: TargetModel) -> Outcome<Medium<String>> {
  emit(tree: python_add_inferred_tree, target: target)
}

fn python_add_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: python_target_model(),
    emitted: python_emitted_add_fn_node()
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match python_add_emit_from_tree(target: python_target_model()) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn python_add_emit_perturbed_spellings_discriminates() -> Bool {
  match python_add_emit_from_tree(target: python_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match python_add_emit_from_tree(
        target: python_add_emit_perturbed_target_model()
      ) {
        Accepted { value: perturbed, diagnostics: dp } =>
          (perturbed != canonical)
            && (perturbed.carried == python_add_emit_perturbed_source_text)
            && (dc == None)
            && (dp == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn python_add_emit_keystone_holds() -> Bool {
  python_add_emit_holds() && python_add_emit_perturbed_spellings_discriminates()
}
