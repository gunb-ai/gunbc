module v2.test.manual.branch_if_then_else_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn branch_if_then_else_emit_facts_lookup(key: Node) -> Optional<v2.compiler.infer.InferredFacts> {
  branch_if_then_else_inferred_facts_for(node: key)
}

fn branch_if_then_else_emit_inferred_tree_for(root: Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: branch_if_then_else_emit_facts_lookup }
  }
}

fn branch_if_then_else_emit_producer_tree() -> Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_pick_if_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: branch_if_then_else_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn branch_if_then_else_emit_swapped_producer_tree() -> Outcome<v2.compiler.infer.InferredTree> {
  match table_fixture_pick_if_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: branch_if_then_else_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn branch_if_then_else_emit_from_producer(target: v2.std.compilers.target_model.TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: branch_if_then_else_emit_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn branch_if_then_else_emit_swapped_from_producer(target: v2.std.compilers.target_model.TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: branch_if_then_else_emit_swapped_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

test fn branch_if_then_else_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: dag_pick_target_model(),
    emitted: dag_fixture_emitted_pick_fn
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match branch_if_then_else_emit_from_producer(target: dag_pick_target_model()) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn branch_if_then_else_emit_swapped_arms_discriminates() -> Bool {
  match branch_if_then_else_emit_from_producer(target: dag_pick_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match branch_if_then_else_emit_swapped_from_producer(target: dag_pick_target_model()) {
        Accepted { value: swapped, diagnostics: ds } =>
          (swapped != canonical) && (dc == None) && (ds == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


