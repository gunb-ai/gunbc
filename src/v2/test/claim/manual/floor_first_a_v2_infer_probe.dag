data a4_style_nominal_mismatch_source: Medium<String> = Medium {
  carried: "module probe.a4.nominal\n\ntype WrapA {\n  value: Int\n}\n\ntype WrapB {\n  value: Int\n}\n\nfn expects_a(x: WrapA) -> Int = x.value\n\nfn call_site(b: WrapB) -> Int = expects_a(b)\n",
  fidelity: Lossless
}

fn a4_style_nominal_mismatch() -> ProcessExit { probe_exit(source: a4_style_nominal_mismatch_source) }
fn marker_red_admit() -> ProcessExit { probe_exit(source: marker_red_admit_source) }
fn marker_control_string() -> ProcessExit { probe_exit(source: marker_control_string_at_sealed_source) }
fn marker_control_ok() -> ProcessExit { probe_exit(source: marker_control_identical_source) }
fn alias_red_filepath_param() -> ProcessExit { probe_exit(source: alias_red_filepath_param_source) }
fn alias_red_filepath_cast() -> ProcessExit { probe_exit(source: alias_red_filepath_cast_source) }
fn alias_control_literal() -> ProcessExit { probe_exit(source: alias_control_literal_source) }
fn alias_control_string() -> ProcessExit { probe_exit(source: alias_control_string_param_source) }
fn alias_control_int() -> ProcessExit { probe_exit(source: alias_control_int_param_source) }
fn alias_control_foreign() -> ProcessExit { probe_exit(source: alias_control_foreign_record_source) }
