  integer_interval_value_set_node(
    interval: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^malformed_interval_payload } },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  )
}

