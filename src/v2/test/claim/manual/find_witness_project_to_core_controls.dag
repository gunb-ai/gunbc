          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn integer_value_set_rejects_malformed_interval_payload_control() -> Bool {
  !integer_value_set_contains(container: python_int_value_set(), contained: malformed_interval_value_set())
}

data witness_integer_value_set_rejects_malformed_interval_payload: Bool = integer_value_set_rejects_malformed_interval_payload_control()

fn integer_value_set_interval_containment_rejects_malformed_payload_control() -> Bool {
  !integer_value_set_contains(container: i32_value_set(), contained: malformed_interval_value_set())
}

data witness_integer_value_set_interval_containment_rejects_malformed_payload: Bool = integer_value_set_interval_containment_rejects_malformed_payload_control()

fn integer_value_set_rejects_unbounded_with_extra_field_control() -> Bool {
  !integer_value_set_contains(container: python_int_value_set(), contained: unbounded_value_set_with_extra_field())
}

data witness_integer_value_set_rejects_unbounded_with_extra_field: Bool = integer_value_set_rejects_unbounded_with_extra_field_control()

fn integer_value_set_reverse_is_strict_coarsening_control() -> Bool {
  let strict = integer_value_set_strictly_contains(container: python_int_value_set(), contained: i32_value_set())
  let reverse_contains = integer_value_set_contains(container: i32_value_set(), contained: python_int_value_set())
  strict && !reverse_contains
}

data witness_integer_value_set_reverse_is_strict_coarsening: Bool = integer_value_set_reverse_is_strict_coarsening_control()

data witness_integer_value_set_refuses_incompatible_unknown: Bool = !integer_value_set_contains(container: task_id_api_inhabitant_node(), contained: i32_value_set())

data witness_refinement_widening_refuses_semantically_equal_value_sets: Bool = !refinement_widening_preservation_holds(
  source_facts: task_id_api_inhabitant_node(),
  candidate: task_id_wire_inhabitant_node(),
  algebra: refinement_widening_predicate_algebra_for_value_sets(
    source: task_id_api_inhabitant_node(),
    candidate: task_id_wire_inhabitant_node(),
    source_value_set: i32_value_set(),
    candidate_value_set: i32_value_set_interval_first()
  )
)

data witness_integer_interval_bound_compare_orders_pointer_width_bounds: Bool = match integer_interval_bound_compare(
    left: integer_pointer_width_bound(signedness: Signed, endpoint: v2.std.integer.IntegerRangeInclusiveMin),
    right: integer_pointer_width_bound(signedness: Unsigned, endpoint: IntegerRangeInclusiveMin)
  ) {
    std.algebra.Less => true
    std.algebra.Equal => false
    Greater => false
  }
    && integer_interval_bound_compare(
      left: integer_pointer_width_bound(signedness: Signed, endpoint: IntegerRangeInclusiveMin),
      right: integer_concrete_zero()
    ) == std.algebra.Less
    && integer_interval_bound_compare(
      left: integer_pointer_width_bound(signedness: Unsigned, endpoint: IntegerRangeInclusiveMin),
      right: integer_concrete_zero()
    ) == std.algebra.Equal
    && !integer_interval_spec_contains(
      container: uint_platform_interval_spec(),
      contained: uint8_interval_spec()
    )
    && !integer_interval_spec_contains(
      container: int_platform_interval_spec(),
      contained: int8_interval_spec()
    )

