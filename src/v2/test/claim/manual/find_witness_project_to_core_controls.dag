fn i32_value_set() -> Node {
  integer_interval_value_set_node(interval: integer_interval_spec_node(spec: int32_interval_spec()))
}

fn i32_value_set_interval_first() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^integer_value_set_field_interval },
        target: integer_interval_spec_node(spec: int32_interval_spec())
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^integer_value_set_field_kind },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^integer_value_set_kind_interval } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

