}

fn python_int_value_set() -> Node {
  integer_unbounded_value_set_node()
}

data witness_integer_value_set_accepts_i32_subset_python_int: Bool = v2.std.integer_value_set.integer_value_set_contains(container: python_int_value_set(), contained: i32_value_set())

data witness_integer_value_set_accepts_i16_subset_i32: Bool = integer_value_set_contains(container: i32_value_set(), contained: i16_value_set())

data witness_integer_value_set_accepts_u8_subset_i16: Bool = integer_value_set_contains(container: i16_value_set(), contained: u8_value_set())

