data witness_project_to_core_drops_nested_surface: Bool = match find_witness_derives(
  source_facts: nested_project_to_core_node(nested_core: ^nested_inner_core, nested_surface: ^nested_source_surface),
  candidates: control_candidate_set(
    candidates: [nested_project_to_core_node(nested_core: ^nested_inner_core, nested_surface: ^nested_candidate_surface)],
    closedness_evidence: nested_project_to_core_node(nested_core: ^nested_inner_core, nested_surface: ^nested_candidate_surface)
  ),
  derivation_algebra: nested_project_to_core_node(nested_core: ^nested_inner_core, nested_surface: ^nested_source_surface),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } =>
    fw.candidate == nested_project_to_core_node(nested_core: ^nested_inner_core, nested_surface: ^nested_candidate_surface)
  Rejected { diagnostics: _ } => false
}

