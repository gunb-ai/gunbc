module test.claim.manual.scratch_dual_import_probe

import extdeps.git
import extdeps.git {
  git_diff_name_status_field_separator
}
import std.types { String }
import std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn scratch_probe() -> String {
  git_diff_name_status_field_separator
}

fn scratch_probe_head() -> String {
  git.Core.HeadCommit().sha
}

test fn scratch_dual_import_probe_holds() -> Bool {
  string_length(s: scratch_probe()) == 1
}
