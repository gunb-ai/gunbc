module v2.test.manual.call_carrier_node_query

import v2.std.node {
  Atom,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Transform,
  TypeNode,
  Value,
  node_synthetic
}
import v2.std.compilers.body_lowering {
  Application,
  ApplicationRead,
  ApplicationRefused,
  ArrowHead,
  AtomHead,
  InspectableOperand,
  NotApplication,
  UnprojectedOperand,
  application_read
}
import v2.std.diagnostic { diagnostics_fatal_reason }
import v2.std.collection { Absent, Present, list_at_optional }
import v2.std.logic { Bool }

fn call_carrier_callee_ref() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^call_carrier_callee_add } },
    children: []
  )
}

fn call_carrier_arg_x() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^call_carrier_arg_x } },
    children: []
  )
}

fn call_carrier_arg_y() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^call_carrier_arg_y } },
    children: []
  )
}

fn call_carrier_call_node() -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: call_carrier_callee_ref() },
      Edge { label: Positional, target: call_carrier_arg_x() },
      Edge { label: Positional, target: call_carrier_arg_y() }
    ]
  )
}

fn call_carrier_value_node() -> Node {
  node_synthetic(kind: ComputationNode { behavior: Value }, children: [])
}

fn call_carrier_callee_free_transform() -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: call_carrier_value_node() },
      Edge { label: Positional, target: call_carrier_value_node() }
    ]
  )
}

// The call carrier read through v2.std.compilers.body_lowering application_read, the one reader
// that replaced v2.std.node_query node_is_call / call_callee_target / call_argument_targets. The
// module and test names are kept because the floor roster keys them.

fn call_carrier_is_application(r: ApplicationRead) -> Bool {
  match r {
    Application { view: _ } => true
    NotApplication => false
    ApplicationRefused { diagnostics: _ } => false
  }
}

test fn call_carrier_call_recognized() -> Bool {
  call_carrier_is_application(r: application_read(site: call_carrier_call_node()))
}

// A Transform whose head is not a callee is REFUSED, located at the head -- not "not a call".
// node_is_call answered false here, which is what let a malformed call drop out of every lens.
test fn call_carrier_callee_free_not_call() -> Bool {
  match application_read(site: call_carrier_callee_free_transform()) {
    ApplicationRefused { diagnostics: d } =>
      diagnostics_fatal_reason(d: d) == ^body_view_transform_head_not_callee
    Application { view: _ } => false
    NotApplication => false
  }
}

test fn call_carrier_callee_is_reference() -> Bool {
  match application_read(site: call_carrier_call_node()) {
    Application { view: v } =>
      match v.head_identity {
        AtomHead { identity: id } => id == ^call_carrier_callee_add
        ArrowHead => false
      }
    NotApplication => false
    ApplicationRefused { diagnostics: _ } => false
  }
}

test fn call_carrier_value_not_callee_reference() -> Bool {
  match application_read(site: call_carrier_value_node()) {
    NotApplication => true
    Application { view: _ } => false
    ApplicationRefused { diagnostics: _ } => false
  }
}

test fn call_carrier_callee_target_matches() -> Bool {
  match application_read(site: call_carrier_call_node()) {
    Application { view: v } => v.head == call_carrier_callee_ref()
    NotApplication => false
    ApplicationRefused { diagnostics: _ } => false
  }
}

test fn call_carrier_callee_target_rejects_non_call() -> Bool {
  !call_carrier_is_application(r: application_read(site: call_carrier_callee_free_transform()))
}

test fn call_carrier_arguments_match() -> Bool {
  match application_read(site: call_carrier_call_node()) {
    Application { view: v } =>
      let args = v.operands
      let arity_two = count(args) == 2
      let first_is_x = match list_at_optional(xs: args, index: 0) {
        Present { value: InspectableOperand { node: a0 } } => a0 == call_carrier_arg_x()
        Present { value: UnprojectedOperand { at: _ } } => false
        Absent => false
      }
      let second_is_y = match list_at_optional(xs: args, index: 1) {
        Present { value: InspectableOperand { node: a1 } } => a1 == call_carrier_arg_y()
        Present { value: UnprojectedOperand { at: _ } } => false
        Absent => false
      }
      arity_two && first_is_x && second_is_y
    NotApplication => false
    ApplicationRefused { diagnostics: _ } => false
  }
}
