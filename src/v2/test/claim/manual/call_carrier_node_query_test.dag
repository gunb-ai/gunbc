module v2.test.manual.call_carrier_node_query

fn call_carrier_callee_ref() -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^call_carrier_callee_add } },
    children: []
  )
}

fn call_carrier_arg_x() -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^call_carrier_arg_x } },
    children: []
  )
}

fn call_carrier_arg_y() -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^call_carrier_arg_y } },
    children: []
  )
}

fn call_carrier_call_node() -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: call_carrier_callee_ref() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: call_carrier_arg_x() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: call_carrier_arg_y() }
    ]
  )
}

fn call_carrier_value_node() -> v2.std.node.Node {
  v2.std.node.node_synthetic(kind: v2.std.node.ComputationNode { behavior: v2.std.node.Value }, children: [])
}

fn call_carrier_callee_free_transform() -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: call_carrier_value_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: call_carrier_value_node() }
    ]
  )
}

test fn call_carrier_call_recognized() -> v2.std.logic.Bool {
  v2.std.node_query.node_is_call(node: call_carrier_call_node())
}

test fn call_carrier_callee_free_not_call() -> v2.std.logic.Bool {
  !v2.std.node_query.node_is_call(node: call_carrier_callee_free_transform())
}

test fn call_carrier_callee_is_reference() -> v2.std.logic.Bool {
  v2.std.node_query.node_is_callee_reference(node: call_carrier_callee_ref())
}

test fn call_carrier_value_not_callee_reference() -> v2.std.logic.Bool {
  !v2.std.node_query.node_is_callee_reference(node: call_carrier_value_node())
}

test fn call_carrier_callee_target_matches() -> v2.std.logic.Bool {
  match v2.std.node_query.call_callee_target(node: call_carrier_call_node()) {
    Accepted { value: callee, diagnostics: _ } => callee == call_carrier_callee_ref()
    Rejected { diagnostics: _ } => false
  }
}

test fn call_carrier_callee_target_rejects_non_call() -> v2.std.logic.Bool {
  match v2.std.node_query.call_callee_target(node: call_carrier_callee_free_transform()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn call_carrier_arguments_match() -> v2.std.logic.Bool {
  let args = v2.std.node_query.call_argument_targets(node: call_carrier_call_node())
  let arity_two = count(args) == 2
  let first_is_x = match v2.std.collection.list_at_optional(xs: args, index: 0) {
    Present { value: a0 } => a0 == call_carrier_arg_x()
    Absent => false
  }
  let second_is_y = match v2.std.collection.list_at_optional(xs: args, index: 1) {
    Present { value: a1 } => a1 == call_carrier_arg_y()
    Absent => false
  }
  arity_two && first_is_x && second_is_y
}
