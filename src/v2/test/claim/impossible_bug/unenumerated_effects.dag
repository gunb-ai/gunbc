module v2.test.impossible_bug.unenumerated_effects

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  node_locus,
  None,
  Outcome,
  Rejected,
  Suggested,
  diagnostics_singleton
}
import v2.std.node { Edge, Named, Node, Positional, Symbol, TypeNode, Atom, Arrow, Conj, SyntheticOccurrence }
import v2.std.verification {
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier2,
  Unit,
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  RoundTripClaim,
  manual_claim_anchor
}

fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn effect_subject(signature: Node, body: Node) -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: signature },
      Edge { label: Positional, target: body },
    ],
    occurrence_id: SyntheticOccurrence
}
}

data effect_derived_from_signature_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^effect_read_subject_field },
      target: effect_subject(signature: atom_node(s: ^read_signature_symbol), body: atom_node(s: ^read_signature_symbol))
    },
    Edge {
      label: Named { name: ^effect_write_subject_field },
      target: effect_subject(signature: atom_node(s: ^write_signature_symbol), body: atom_node(s: ^write_signature_symbol))
    },
  ],
  occurrence_id: SyntheticOccurrence
}

data explicit_reread_input: Node = effect_subject(signature: atom_node(s: ^read_signature_symbol), body: atom_node(s: ^explicit_reread_symbol))

data falsification_redundant_read: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^effect_signature_field }, target: atom_node(s: ^read_signature_symbol) },
    Edge { label: Named { name: ^effect_body_field }, target: atom_node(s: ^read_signature_symbol) },
  ],
  occurrence_id: SyntheticOccurrence
}

data claim_effect_derived_from_signature: TestClaim = CompilesClaim {
  label: "effect lens derives read write shape from signature",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: effect_derived_from_signature_input,
  expected_value: effect_derived_from_signature_input,
  classification: TestClassification { tier: Tier2, layer: Unit }
}

data claim_explicit_reread_passes: TestClaim = CompilesClaim {
  label: "explicit reread primitive records intent without effect side taxonomy",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: explicit_reread_input,
  expected_value: explicit_reread_input,
  classification: TestClassification { tier: Tier2, layer: Unit }
}

data claim_redundant_read_caught: TestClaim = DiagnosticClaim {
  label: "redundant read without intervening write is rejected by effect lens",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_redundant_read,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^impossible_bug_reason_redundant_read,
        at: node_locus(node: falsification_redundant_read),
        correction: Suggested { node: explicit_reread_input }
      }
    ),
  classification: TestClassification { tier: Tier2, layer: Unit }
}
