module v2.test.impossible_bug.idempotency_contract


fn atom_node(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn idempotency_contract(body: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: ^idempotency_position_field }, target: atom_node(s: ^idempotent_position_symbol) },
      v2.std.node.Edge { label: v2.std.node.Named { name: ^idempotency_body_field }, target: body },
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

data idempotent_inhabitant_input: v2.std.node.Node = idempotency_contract(body: atom_node(s: ^idempotent_effect_symbol))

data falsification_nonidempotent_in_idempotent_position: v2.std.node.Node = idempotency_contract(body: atom_node(s: ^non_idempotent_effect_symbol))

data falsification_repeated_append_in_idempotent_position: v2.std.node.Node = idempotency_contract(body: atom_node(s: ^repeated_append_effect_symbol))

data claim_idempotent_inhabitant_passes: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "idempotent algebra inhabitant accepts idempotent structure",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: idempotent_inhabitant_input,
  expected_value: idempotent_inhabitant_input,
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_repeated_append_in_idempotent_position_caught: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "idempotent algebra inhabitance rejects repeated append composition",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: falsification_repeated_append_in_idempotent_position,
  expected_rejection: v2.std.diagnostic.diagnostics_singleton(
      d: v2.std.diagnostic.Diagnostic {
        reason: ^impossible_bug_reason_idempotency_repetition,
        at: v2.std.diagnostic.node_locus(node: falsification_repeated_append_in_idempotent_position),
        correction: v2.std.diagnostic.Suggested { node: idempotent_inhabitant_input }
      }
    ),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_nonidempotent_in_idempotent_position_caught: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "idempotent algebra inhabitance rejects non-idempotent composition",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: falsification_nonidempotent_in_idempotent_position,
  expected_rejection: v2.std.diagnostic.diagnostics_singleton(
      d: v2.std.diagnostic.Diagnostic {
        reason: ^impossible_bug_reason_idempotency_violation,
        at: v2.std.diagnostic.node_locus(node: falsification_nonidempotent_in_idempotent_position),
        correction: v2.std.diagnostic.Suggested { node: idempotent_inhabitant_input }
      }
    ),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}
