module v2.test.impossible_bug.idempotency_contract

import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  node_locus,
  None,
  Outcome,
  Rejected,
  Suggested,
  diagnostics_singleton
}
import v2.std.node { Edge, Named, Node, Symbol, TypeNode, Atom, Conj, SyntheticOccurrence }
import v2.std.verification {
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  RoundTripClaim,
  manual_claim_anchor
}
fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn idempotency_contract(body: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^idempotency_position_field }, target: atom_node(s: ^idempotent_position_symbol) },
      Edge { label: Named { name: ^idempotency_body_field }, target: body },
    ],
    occurrence_id: SyntheticOccurrence
}
}

data idempotent_inhabitant_input: Node = idempotency_contract(body: atom_node(s: ^idempotent_effect_symbol))

data falsification_nonidempotent_in_idempotent_position: Node = idempotency_contract(body: atom_node(s: ^non_idempotent_effect_symbol))

data falsification_repeated_append_in_idempotent_position: Node = idempotency_contract(body: atom_node(s: ^repeated_append_effect_symbol))

data claim_idempotent_inhabitant_passes: TestClaim = CompilesClaim {
  label: "idempotent algebra inhabitant accepts idempotent structure",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: idempotent_inhabitant_input,
  expected_value: idempotent_inhabitant_input,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_repeated_append_in_idempotent_position_caught: TestClaim = DiagnosticClaim {
  label: "idempotent algebra inhabitance rejects repeated append composition",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_repeated_append_in_idempotent_position,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^impossible_bug_reason_idempotency_repetition,
        at: node_locus(node: falsification_repeated_append_in_idempotent_position),
        correction: Suggested { node: idempotent_inhabitant_input }
      }
    ),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_nonidempotent_in_idempotent_position_caught: TestClaim = DiagnosticClaim {
  label: "idempotent algebra inhabitance rejects non-idempotent composition",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_nonidempotent_in_idempotent_position,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^impossible_bug_reason_idempotency_violation,
        at: node_locus(node: falsification_nonidempotent_in_idempotent_position),
        correction: Suggested { node: idempotent_inhabitant_input }
      }
    ),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
