module v2.test.impossible_bug.transport_type_drift

fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

data shared_wire_contract_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^client_field }, target: atom_node(s: ^shared_wire_contract_symbol) },
    Edge { label: Named { name: ^server_field }, target: atom_node(s: ^shared_wire_contract_symbol) },
  ],
  occurrence_id: SyntheticOccurrence
}

data falsification_wire_contract_drift: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^client_field }, target: atom_node(s: ^client_field_int_symbol) },
    Edge { label: Named { name: ^server_field }, target: atom_node(s: ^server_field_string_symbol) },
  ],
  occurrence_id: SyntheticOccurrence
}

data falsification_target_contract_drift: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^client_field }, target: atom_node(s: ^client_field_int_symbol) },
    Edge { label: Named { name: ^target_field }, target: atom_node(s: ^target_field_bool_symbol) },
  ],
  occurrence_id: SyntheticOccurrence
}

data claim_shared_declaration_compiles_both_sides: TestClaim = CompilesClaim {
  label: "shared transport declaration compiles client and server sides",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: shared_wire_contract_input,
  expected_value: shared_wire_contract_input,
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_target_contract_drift_impossible: TestClaim = DiagnosticClaim {
  label: "transport field drift rejects target-side parallel authority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_target_contract_drift,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^impossible_bug_reason_target_transport_drift,
        at: node_locus(node: falsification_target_contract_drift),
        correction: Suggested { node: shared_wire_contract_input }
      }
    ),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_wire_contract_drift_impossible: TestClaim = DiagnosticClaim {
  label: "transport field drift rejects parallel client server authority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_wire_contract_drift,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^impossible_bug_reason_transport_drift,
        at: node_locus(node: falsification_wire_contract_drift),
        correction: Suggested { node: shared_wire_contract_input }
      }
    ),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
