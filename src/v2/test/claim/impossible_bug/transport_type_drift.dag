module v2.test.impossible_bug.transport_type_drift

fn atom_node(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

data shared_wire_contract_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^client_field }, target: v2.test.impossible_bug.transport_type_drift.atom_node(s: ^shared_wire_contract_symbol) },
    v2.std.node.Edge { label: Named { name: ^server_field }, target: v2.test.impossible_bug.transport_type_drift.atom_node(s: ^shared_wire_contract_symbol) },
  ],
  occurrence_id: SyntheticOccurrence
}

data falsification_wire_contract_drift: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^client_field }, target: v2.test.impossible_bug.transport_type_drift.atom_node(s: ^client_field_int_symbol) },
    v2.std.node.Edge { label: Named { name: ^server_field }, target: v2.test.impossible_bug.transport_type_drift.atom_node(s: ^server_field_string_symbol) },
  ],
  occurrence_id: SyntheticOccurrence
}

data falsification_target_contract_drift: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge { label: Named { name: ^client_field }, target: v2.test.impossible_bug.transport_type_drift.atom_node(s: ^client_field_int_symbol) },
    v2.std.node.Edge { label: Named { name: ^target_field }, target: v2.test.impossible_bug.transport_type_drift.atom_node(s: ^target_field_bool_symbol) },
  ],
  occurrence_id: SyntheticOccurrence
}

data claim_shared_declaration_compiles_both_sides: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "shared transport declaration compiles client and server sides",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: shared_wire_contract_input,
  expected_value: shared_wire_contract_input,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}

data claim_target_contract_drift_impossible: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "transport field drift rejects target-side parallel authority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_target_contract_drift,
  expected_rejection: diagnostics_singleton(
      d: v2.std.diagnostic.Diagnostic {
        reason: ^impossible_bug_reason_target_transport_drift,
        at: node_locus(node: falsification_target_contract_drift),
        correction: v2.std.diagnostic.Suggested { node: shared_wire_contract_input }
      }
    ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}

data claim_wire_contract_drift_impossible: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "transport field drift rejects parallel client server authority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_wire_contract_drift,
  expected_rejection: diagnostics_singleton(
      d: v2.std.diagnostic.Diagnostic {
        reason: ^impossible_bug_reason_transport_drift,
        at: node_locus(node: falsification_wire_contract_drift),
        correction: v2.std.diagnostic.Suggested { node: shared_wire_contract_input }
      }
    ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}
