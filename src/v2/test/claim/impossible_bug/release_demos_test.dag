module v2.test.impossible_bug.release_demos

import v2.std.logic { Bool }
import v2.std.diagnostic { Accepted, Diagnostic, Rejected }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim,
  TransportTypeDrift,
  impossible_bug_class_from_diagnostic_reason,
  test_claim_input,
  test_claim_expected_outcome
}
import v2.test.impossible_bug.transport_type_drift {
  claim_target_contract_drift_impossible,
  claim_wire_contract_drift_impossible,
  falsification_target_contract_drift,
  falsification_wire_contract_drift
}
import v2.test.impossible_bug.idempotency_contract {
  claim_nonidempotent_in_idempotent_position_caught
}
import v2.test.impossible_bug.suboptimal_complexity {
  claim_overcost_against_structural_bound_violates
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn release_complexity_claim_catches() -> Bool {
  match test_claim_expected_outcome(c: claim_overcost_against_structural_bound_violates) {
    Accepted { value: Rejected { diagnostics: expected }, diagnostics: None } =>
      match expected.head {
        Diagnostic { reason: reason, at: _, correction: _ } =>
          match impossible_bug_class_from_diagnostic_reason(reason: reason) {
              Accepted { value: SuboptimalComplexity, diagnostics: None } => true
              _ => false
            }
      }
    _ => false
  }
}

fn release_idempotency_claim_catches() -> Bool {
  match test_claim_expected_outcome(c: claim_nonidempotent_in_idempotent_position_caught) {
    Accepted { value: Rejected { diagnostics: expected }, diagnostics: None } =>
      match expected.head {
        Diagnostic { reason: reason, at: _, correction: _ } =>
          match impossible_bug_class_from_diagnostic_reason(reason: reason) {
              Accepted { value: IdempotencyContract, diagnostics: None } => true
              _ => false
            }
      }
    _ => false
  }
}

fn release_transport_target_contract_drift_catches() -> Bool {
  match test_claim_expected_outcome(c: claim_target_contract_drift_impossible) {
    Accepted { value: Rejected { diagnostics: expected }, diagnostics: None } =>
      match expected.head {
        Diagnostic { reason: reason, at: _, correction: _ } =>
          (falsification_target_contract_drift == test_claim_input(c: claim_target_contract_drift_impossible))
            && match impossible_bug_class_from_diagnostic_reason(reason: reason) {
              Accepted { value: TransportTypeDrift, diagnostics: None } => true
              _ => false
            }
      }
    _ => false
  }
}

fn release_transport_wire_contract_drift_catches() -> Bool {
  match test_claim_expected_outcome(c: claim_wire_contract_drift_impossible) {
    Accepted { value: Rejected { diagnostics: expected }, diagnostics: None } =>
      match expected.head {
        Diagnostic { reason: reason, at: _, correction: _ } =>
          (falsification_wire_contract_drift == test_claim_input(c: claim_wire_contract_drift_impossible))
            && match impossible_bug_class_from_diagnostic_reason(reason: reason) {
              Accepted { value: TransportTypeDrift, diagnostics: None } => true
              _ => false
            }
      }
    _ => false
  }
}

fn release_transport_drift_probe_catches() -> Bool {
  release_transport_target_contract_drift_catches() &&
    release_transport_wire_contract_drift_catches()
}

test fn release_complexity_claims_are_class_rejections() -> Bool {
  release_complexity_claim_catches()
}

test fn release_idempotency_claims_are_class_rejections() -> Bool {
  release_idempotency_claim_catches()
}

test fn release_transport_claims_are_class_rejections() -> Bool {
  release_transport_drift_probe_catches()
}

