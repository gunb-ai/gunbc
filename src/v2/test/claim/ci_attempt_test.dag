data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── The envelope ──────────────────────────────────────────────────────────────

data base_request: CiAttemptRequest = CiAttemptRequest {
  tree_identity: TreeIdentity { commit: ^ci_test_commit_a },
  source_manifest: SourceManifestIdentity {
    digest: symbol_identity_digest(sym: ^ci_test_manifest_a)
  },
  source_roots: [SourceRootDag, SourceRootV2],
  exclusions: [
    SubjectExclusion {
      subject: ^ownership_movable_test,
      ground: ExcludedOutsideDeclaredSourceRoots { containing_root: ^ci_source_root_src_v1 }
    }
  ],
  tool: ToolIdentity { compiler: ^ci_test_compiler_a },
  fixture_store: FixtureStoreAbsent,
  published_mocks: PublishedMockSetEmpty,
  configuration: ConfigurationIdentity { identity: ^ci_test_config_a }
}

data request_other_roots: CiAttemptRequest = CiAttemptRequest {
  tree_identity: base_request.tree_identity,
  source_manifest: base_request.source_manifest,
  source_roots: [SourceRootDag],
  exclusions: base_request.exclusions,
  tool: base_request.tool,
  fixture_store: base_request.fixture_store,
  published_mocks: base_request.published_mocks,
  configuration: base_request.configuration
}

data request_other_tool: CiAttemptRequest = CiAttemptRequest {
  tree_identity: base_request.tree_identity,
  source_manifest: base_request.source_manifest,
  source_roots: base_request.source_roots,
  exclusions: base_request.exclusions,
  tool: ToolIdentity { compiler: ^ci_test_compiler_b },
  fixture_store: base_request.fixture_store,
  published_mocks: base_request.published_mocks,
  configuration: base_request.configuration
}

// THE FIXTURE-STORE PAIR IS THE POINT OF THE ENVELOPE. Preparation used to be built
// from source bytes alone, so these two requests would have carried ONE identity
// while producing different results for every fixture-dependent claim — a parity
// comparison between them would have compared two subjects and reported agreement.
data request_other_fixtures: CiAttemptRequest = CiAttemptRequest {
  tree_identity: base_request.tree_identity,
  source_manifest: base_request.source_manifest,
  source_roots: base_request.source_roots,
  exclusions: base_request.exclusions,
  tool: base_request.tool,
  fixture_store: FixtureStoreAt { identity: ^ci_test_fixture_store },
  published_mocks: base_request.published_mocks,
  configuration: base_request.configuration
}

data request_other_mocks: CiAttemptRequest = CiAttemptRequest {
  tree_identity: base_request.tree_identity,
  source_manifest: base_request.source_manifest,
  source_roots: base_request.source_roots,
  exclusions: base_request.exclusions,
  tool: base_request.tool,
  fixture_store: base_request.fixture_store,
  published_mocks: PublishedMockSetOf { identity: ^ci_test_mock_set },
  configuration: base_request.configuration
}

data request_other_config: CiAttemptRequest = CiAttemptRequest {
  tree_identity: base_request.tree_identity,
  source_manifest: base_request.source_manifest,
  source_roots: base_request.source_roots,
  exclusions: base_request.exclusions,
  tool: base_request.tool,
  fixture_store: base_request.fixture_store,
  published_mocks: base_request.published_mocks,
  configuration: ConfigurationIdentity { identity: ^ci_test_config_b }
}

// THE TWO CONTENT COORDINATES, each varied alone. Without these the digest described
// how to read sources and never what they were, so one request against two different
// commits carried one identity — and a materialization keyed on it would share a
// result across a code change.
data request_other_tree: CiAttemptRequest = CiAttemptRequest {
  tree_identity: TreeIdentity { commit: ^ci_test_commit_b },
  source_manifest: base_request.source_manifest,
  source_roots: base_request.source_roots,
  exclusions: base_request.exclusions,
  tool: base_request.tool,
  fixture_store: base_request.fixture_store,
  published_mocks: base_request.published_mocks,
  configuration: base_request.configuration
}

// SAME TREE, DIFFERENT ADMITTED FILE SET. This is why the manifest is a separate
// coordinate rather than implied by the commit: what the roots resolve to can move
// without the tree moving.
data request_other_manifest: CiAttemptRequest = CiAttemptRequest {
  tree_identity: base_request.tree_identity,
  source_manifest: SourceManifestIdentity {
    digest: symbol_identity_digest(sym: ^ci_test_manifest_b)
  },
  source_roots: base_request.source_roots,
  exclusions: base_request.exclusions,
  tool: base_request.tool,
  fixture_store: base_request.fixture_store,
  published_mocks: base_request.published_mocks,
  configuration: base_request.configuration
}

data request_other_exclusion_subject: CiAttemptRequest = CiAttemptRequest {
  tree_identity: base_request.tree_identity,
  source_manifest: base_request.source_manifest,
  source_roots: base_request.source_roots,
  exclusions: [
    SubjectExclusion {
      subject: ^some_other_excluded_module,
      ground: ExcludedOutsideDeclaredSourceRoots { containing_root: ^ci_source_root_src_v1 }
    }
  ],
  tool: base_request.tool,
  fixture_store: base_request.fixture_store,
  published_mocks: base_request.published_mocks,
  configuration: base_request.configuration
}

test fn digest_covers_every_envelope_field() -> Bool {
  let base = ci_attempt_subject_digest(request: base_request)
  (ci_attempt_subject_digest(request: request_other_tree) != base)
    && (ci_attempt_subject_digest(request: request_other_manifest) != base)
    && (ci_attempt_subject_digest(request: request_other_roots) != base)
    && (ci_attempt_subject_digest(request: request_other_tool) != base)
    && (ci_attempt_subject_digest(request: request_other_fixtures) != base)
    && (ci_attempt_subject_digest(request: request_other_mocks) != base)
    && (ci_attempt_subject_digest(request: request_other_config) != base)
    && (ci_attempt_subject_digest(request: request_other_exclusion_subject) != base)
}

// RED CONTROL, in the other direction: a digest that differed for everything would
// satisfy the claim above while being useless. The same envelope must digest equal.
test fn digest_is_stable_for_one_envelope() -> Bool {
  let once = ci_attempt_subject_digest(request: base_request)
  let again = ci_attempt_subject_digest(request: base_request)
  once == again
}

// ── Scheduling ────────────────────────────────────────────────────────────────

data n_format: CiNode = CiNode {
  identity: ^ci_node_format_check,
  kind: FormatCheck,
  claims: [ReadOnlyRepository]
}

data n_seed_tests: CiNode = CiNode {
  identity: ^ci_node_retained_seed_tests,
  kind: RetainedSeedTests,
  claims: [CargoTargetWrite { target: ^ci_target_stage0 }]
}

data n_artifact_verify: CiNode = CiNode {
  identity: ^ci_node_generated_artifact_verify,
  kind: CompileCleanStanding,
  claims: [CargoTargetWrite { target: ^ci_target_stage0 }]
}

// SAME KIND OF CLAIM, DIFFERENT TARGET. This node writes a cargo target too, and
// writing a DIFFERENT one is not a conflict — the discriminating case for the
// parameterized claim, and the one an unparameterized model gets wrong by
// serializing work that never contended.
data n_other_target_build: CiNode = CiNode {
  identity: ^ci_node_other_target_build,
  kind: RetainedSeedTests,
  claims: [CargoTargetWrite { target: ^ci_target_emitted }]
}

data n_prepare: CiNode = CiNode {
  identity: ^ci_node_prepare_exact_subject,
  kind: PrepareExactSubject,
  claims: [ReadOnlyRepository]
}

data n_claim_a: CiNode = CiNode {
  identity: ^ci_node_claim_a,
  kind: EvaluateHermeticClaim { declaration: ^ci_decl_a },
  claims: [PreparedContextAccess]
}

data n_claim_b: CiNode = CiNode {
  identity: ^ci_node_claim_b,
  kind: EvaluateHermeticClaim { declaration: ^ci_decl_b },
  claims: [PreparedContextAccess]
}

fn batch_contains(batch: ExecutorBatch, node: CiNode) -> Bool {
  let wanted = ci_node_to_node(node: node)
  fold_list(
    xs: batch.jobs,
    empty: false,
    cons: fn(acc, job) { acc || (job.node == wanted) }
  )
}

fn some_batch_holds_both(
  batches: List<ExecutorBatch>,
  left: CiNode,
  right: CiNode
) -> Bool {
  fold_list(
    xs: batches,
    empty: false,
    cons: fn(acc, b) {
      acc || (batch_contains(batch: b, node: left) && batch_contains(batch: b, node: right))
    }
  )
}

data no_deps: List<DependencyView> = []

// INDEPENDENT NODES OVERLAP. Two read-only checks with no edge between them land in
// one batch, which is the fact that makes "parallel" describe execution rather than
// describe the plan's shape.
test fn independent_nodes_share_a_batch() -> Bool {
  match ci_schedule(plan_nodes: [n_format, n_prepare], dependencies: no_deps) {
    CiScheduleComplete { batches: bs } =>
      some_batch_holds_both(batches: bs, left: n_format, right: n_prepare)
    CiScheduleBlocked { evidence: _, unschedulable: _ } => false
  }
}

// CONFLICTING NODES SERIALIZE, and the check is that they never co-reside — not that
// something labelled them conflicting. Two nodes writing one cargo target directory
// are ordered by the edge their claim produces.
test fn resource_conflicting_nodes_never_share_a_batch() -> Bool {
  claims_conflict(left: n_seed_tests, right: n_artifact_verify)
    && match ci_schedule(
      plan_nodes: [n_seed_tests, n_artifact_verify],
      dependencies: no_deps
    ) {
      CiScheduleComplete { batches: bs } =>
        !some_batch_holds_both(batches: bs, left: n_seed_tests, right: n_artifact_verify)
      CiScheduleBlocked { evidence: _, unschedulable: _ } => false
    }
}

// THE OTHER DIRECTION, and without it the conflict rule is satisfied by an
// implementation that serializes everything. Two nodes writing DIFFERENT cargo
// targets do not conflict and do share a batch.
test fn different_targets_of_one_claim_kind_do_not_conflict() -> Bool {
  !claims_conflict(left: n_seed_tests, right: n_other_target_build)
    && match ci_schedule(
      plan_nodes: [n_seed_tests, n_other_target_build],
      dependencies: no_deps
    ) {
      CiScheduleComplete { batches: bs } =>
        some_batch_holds_both(batches: bs, left: n_seed_tests, right: n_other_target_build)
      CiScheduleBlocked { evidence: _, unschedulable: _ } => false
    }
}

// A CYCLIC PLAN YIELDS NO BATCHES AT ALL. This is the arm that used to return the
// partial prefix accumulated before the blockage, so a plan that can never run
// produced a schedule that ran part of it and reported nothing wrong. The witness
// asserts the standing is blocked AND names unschedulable work, because a blocked
// standing carrying an empty remainder would be the same silence one level in.
test fn a_cyclic_plan_refuses_rather_than_scheduling_a_prefix() -> Bool {
  match ci_schedule(
    plan_nodes: [n_format, n_prepare],
    dependencies: [
      ci_dependency(source: n_format, dependent: n_prepare),
      ci_dependency(source: n_prepare, dependent: n_format)
    ]
  ) {
    CiScheduleComplete { batches: _ } => false
    CiScheduleBlocked { evidence: _, unschedulable: rem } => length(xs: rem) > 0
  }
}

// The witness pair is the honest statement about today's evaluator: both claim
// PreparedContextAccess, so they conflict and serialize. When the Arc-safe store
// lands, resource_claim_is_exclusive flips one row and this witness is what tells us
// the change took effect.
test fn witness_nodes_conflict_on_the_prepared_context() -> Bool {
  claims_conflict(left: n_claim_a, right: n_claim_b)
    && !claims_conflict(left: n_format, right: n_prepare)
}

// ── Ledger reconciliation ─────────────────────────────────────────────────────

data plan_two: List<CiNode> = [n_format, n_prepare]

data receipts_complete: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed },
  CiNodeReceipt { node_identity: ^ci_node_prepare_exact_subject, outcome: NodePassed }
]

data receipts_missing: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed }
]

// EQUAL COUNTS, DIFFERENT POPULATIONS. This is the case a length comparison calls
// agreement: one planned node never reported and one unplanned node did, so the
// ledger has exactly as many rows as the plan has nodes and still describes a
// different run.
data receipts_surplus_at_equal_count: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed },
  CiNodeReceipt { node_identity: ^ci_node_claim_a, outcome: NodePassed }
]

data receipts_duplicate: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed },
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed },
  CiNodeReceipt { node_identity: ^ci_node_prepare_exact_subject, outcome: NodePassed }
]

test fn reconciliation_is_an_identity_join_not_a_count() -> Bool {
  let complete = match reconcile_ledger(plan_nodes: plan_two, receipts: receipts_complete) {
    LedgerComplete => true
    LedgerMissing { node_identity: _ } => false
    LedgerSurplus { node_identity: _ } => false
    LedgerDuplicate { node_identity: _ } => false
  }
  let missing = match reconcile_ledger(plan_nodes: plan_two, receipts: receipts_missing) {
    LedgerMissing { node_identity: m } => m == ^ci_node_prepare_exact_subject
    LedgerComplete => false
    LedgerSurplus { node_identity: _ } => false
    LedgerDuplicate { node_identity: _ } => false
  }
  let equal_count_disagrees = match reconcile_ledger(
    plan_nodes: plan_two,
    receipts: receipts_surplus_at_equal_count
  ) {
    LedgerComplete => false
    LedgerMissing { node_identity: _ } => true
    LedgerSurplus { node_identity: _ } => true
    LedgerDuplicate { node_identity: _ } => false
  }
  let duplicate = match reconcile_ledger(plan_nodes: plan_two, receipts: receipts_duplicate) {
    LedgerDuplicate { node_identity: d } => d == ^ci_node_format_check
    LedgerComplete => false
    LedgerMissing { node_identity: _ } => false
    LedgerSurplus { node_identity: _ } => false
  }
  complete
    && missing
    && equal_count_disagrees
    && duplicate
    && (length(xs: receipts_surplus_at_equal_count) == length(xs: plan_two))
}

// ── The verdict ───────────────────────────────────────────────────────────────

data receipts_one_failed: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed },
  CiNodeReceipt { node_identity: ^ci_node_prepare_exact_subject, outcome: NodeFailed }
]

// A LOST RECEIPT IS NOT A PASS. Every node that DID report passed here; the attempt
// still refuses, because the fold only means something once every planned node
// reported exactly once. This is the arm that makes the verdict derivable from the
// ledger rather than from whatever was printed.
test fn verdict_refuses_an_unreconciled_ledger_even_when_all_reports_passed() -> Bool {
  let all_reported_passed = fold_list(
    xs: receipts_missing,
    empty: true,
    cons: fn(acc, r) {
      acc
        && match r.outcome {
          NodePassed => true
          NodeFailed => false
          NodeRefused { cause: _ } => false
        }
    }
  )
  all_reported_passed
    && match ci_attempt_verdict(plan_nodes: plan_two, receipts: receipts_missing) {
      AttemptRefused { reconciliation: _ } => true
      AttemptPassed => false
      AttemptFailed { node_identity: _ } => false
      AttemptNodeRefused { node_identity: _, cause: _ } => false
    }
}

test fn verdict_passes_and_fails_on_the_reconciled_ledger() -> Bool {
  let passes = match ci_attempt_verdict(plan_nodes: plan_two, receipts: receipts_complete) {
    AttemptPassed => true
    AttemptFailed { node_identity: _ } => false
    AttemptNodeRefused { node_identity: _, cause: _ } => false
    AttemptRefused { reconciliation: _ } => false
  }
  let fails = match ci_attempt_verdict(plan_nodes: plan_two, receipts: receipts_one_failed) {
    AttemptFailed { node_identity: f } => f == ^ci_node_prepare_exact_subject
    AttemptPassed => false
    AttemptNodeRefused { node_identity: _, cause: _ } => false
    AttemptRefused { reconciliation: _ } => false
  }
  passes && fails
}

test fn ci_attempt_witnesses() -> Bool {
  digest_covers_every_envelope_field()
    && digest_is_stable_for_one_envelope()
    && independent_nodes_share_a_batch()
    && resource_conflicting_nodes_never_share_a_batch()
    && different_targets_of_one_claim_kind_do_not_conflict()
    && a_cyclic_plan_refuses_rather_than_scheduling_a_prefix()
    && witness_nodes_conflict_on_the_prepared_context()
    && reconciliation_is_an_identity_join_not_a_count()
    && verdict_refuses_an_unreconciled_ledger_even_when_all_reports_passed()
    && verdict_passes_and_fails_on_the_reconciled_ledger()
    && materialization_admits_once_then_shares()
    && different_input_identity_is_not_a_duplicate()
    && unknown_identity_refuses_rather_than_recomputing()
    && exact_receipts_admit_regardless_of_order()
    && host_cannot_invent_drop_or_rewiden_work()
    && a_claim_request_carries_only_a_capability_digest()
    && a_refused_node_is_distinct_from_a_failed_node()
}

// ── Materialization standing ──────────────────────────────────────────────────

data key_a: ComputationKey = ComputationKey {
  operation: ^ci_op_generate_artifacts,
  inputs: ci_attempt_subject_digest(request: base_request),
  tool: ^ci_test_compiler_a,
  configuration: ^ci_test_config_a
}

data key_b: ComputationKey = ComputationKey {
  operation: ^ci_op_generate_artifacts,
  inputs: ci_attempt_subject_digest(request: request_other_fixtures),
  tool: ^ci_test_compiler_a,
  configuration: ^ci_test_config_a
}

// THE DRIFT-GATE / HEAL PAIR, which is the live duplicate this models: heal generates
// every registered artifact to WRITE it, and the floor generates every registered
// artifact to COMPARE it. Same operation, same inputs, same tool, same configuration
// — so the second one shares rather than regenerating.
test fn materialization_admits_once_then_shares() -> Bool {
  let first = admit_materialization(
    live: ci_no_materialized,
    occurrence: ^ci_node_generated_artifact_verify,
    key: key_a,
    grade: StructurallyIdentical
  )
  let live = record_materialization(live: ci_no_materialized, standing: first)
  let second = admit_materialization(
    live: live,
    occurrence: ^ci_node_heal_apply,
    key: key_a,
    grade: StructurallyIdentical
  )
  let first_is_once = match first {
    MaterializedOnce { key: _, producer: p } => p == ^ci_node_generated_artifact_verify
    SharedFrom { key: _, producer: _, consumer: _ } => false
    RefusedDuplicateRecompute { key: _, first_occurrence: _, duplicate_occurrence: _, grade: _ } => false
  }
  let second_shares = match second {
    SharedFrom { key: _, producer: p, consumer: c } =>
      (p == ^ci_node_generated_artifact_verify) && (c == ^ci_node_heal_apply)
    MaterializedOnce { key: _, producer: _ } => false
    RefusedDuplicateRecompute { key: _, first_occurrence: _, duplicate_occurrence: _, grade: _ } => false
  }
  first_is_once && second_shares
}

// A DIFFERENT INPUT IDENTITY IS A DIFFERENT COMPUTATION, not a duplicate. This is the
// regen case: generation 0 over the seed and generation 1 over the rebuilt seed are
// legitimately two runs, and a rule that could not tell them apart would either refuse
// the fixed point or bless an accidental repeat.
test fn different_input_identity_is_not_a_duplicate() -> Bool {
  let first = admit_materialization(
    live: ci_no_materialized,
    occurrence: ^ci_node_generated_artifact_verify,
    key: key_a,
    grade: StructurallyIdentical
  )
  let live = record_materialization(live: ci_no_materialized, standing: first)
  match admit_materialization(
    live: live,
    occurrence: ^ci_node_regen_second_generation,
    key: key_b,
    grade: StructurallyIdentical
  ) {
    MaterializedOnce { key: _, producer: p } => p == ^ci_node_regen_second_generation
    SharedFrom { key: _, producer: _, consumer: _ } => false
    RefusedDuplicateRecompute { key: _, first_occurrence: _, duplicate_occurrence: _, grade: _ } => false
  }
}

// AN UNKNOWN GRADE REFUSES. It cannot share, because nothing established the two
// computations are the same; it cannot recompute, because nothing established they
// differ. Recomputing on unknown is the absorbing fallback -- never wrong, never
// measurable, and the deficit's frequency zeroed by construction.
test fn unknown_identity_refuses_rather_than_recomputing() -> Bool {
  let first = admit_materialization(
    live: ci_no_materialized,
    occurrence: ^ci_node_generated_artifact_verify,
    key: key_a,
    grade: StructurallyIdentical
  )
  let live = record_materialization(live: ci_no_materialized, standing: first)
  match admit_materialization(
    live: live,
    occurrence: ^ci_node_heal_apply,
    key: key_a,
    grade: IdentityUnknown {
      cause: MissingEnforcement { detail: "no declared normalizer for this operation" }
    }
  ) {
    RefusedDuplicateRecompute { key: _, first_occurrence: f, duplicate_occurrence: d, grade: _ } =>
      (f == ^ci_node_generated_artifact_verify) && (d == ^ci_node_heal_apply)
    MaterializedOnce { key: _, producer: _ } => false
    SharedFrom { key: _, producer: _, consumer: _ } => false
  }
}

// ── The host primitive seam ───────────────────────────────────────────────────

data cap_two: HostCapacity = HostCapacity {
  cpu_slots: 2,
  process_slots: 2,
  resident_bytes: 8589934592
}

data requested_jobs: List<Symbol> = [^ci_node_format_check, ^ci_node_prepare_exact_subject]

data receipts_exact: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_prepare_exact_subject, outcome: NodePassed },
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed }
]

data receipts_invented: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed },
  CiNodeReceipt { node_identity: ^ci_node_prepare_exact_subject, outcome: NodePassed },
  CiNodeReceipt { node_identity: ^ci_node_claim_a, outcome: NodePassed }
]

data receipts_dropped: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed }
]

// ORDER IS NOT IDENTITY. The receipts come back reversed and the batch still admits,
// because a batch is a set admitted to run together -- treating arrival order as
// identity would make a correct concurrent executor look wrong, which is exactly the
// failure that would push someone back to a serial runner.
test fn exact_receipts_admit_regardless_of_order() -> Bool {
  match admit_batch_execution(
    jobs: requested_jobs,
    capacity: cap_two,
    receipts: receipts_exact,
    observed_width: 2
  ) {
    BatchExecuted { receipts: rs } => length(xs: rs) == 2
    BatchRefusedInventedWork { node_identity: _ } => false
    BatchRefusedDroppedWork { node_identity: _ } => false
    BatchRefusedWidthExceeded { permitted: _, observed: _ } => false
  }
}

// THE THREE HOST OVERREACHES ARE THREE REFUSALS, not one. Invented work means the host
// has a source of jobs the plan does not know about; dropped work means a receipt was
// lost or a job silently skipped; exceeded width means the host re-decided a
// scheduling question the plan already answered. Same fix for none of them.
test fn host_cannot_invent_drop_or_rewiden_work() -> Bool {
  let invented = match admit_batch_execution(
    jobs: requested_jobs,
    capacity: cap_two,
    receipts: receipts_invented,
    observed_width: 2
  ) {
    BatchRefusedInventedWork { node_identity: n } => n == ^ci_node_claim_a
    BatchExecuted { receipts: _ } => false
    BatchRefusedDroppedWork { node_identity: _ } => false
    BatchRefusedWidthExceeded { permitted: _, observed: _ } => false
  }
  let dropped = match admit_batch_execution(
    jobs: requested_jobs,
    capacity: cap_two,
    receipts: receipts_dropped,
    observed_width: 1
  ) {
    BatchRefusedDroppedWork { node_identity: n } => n == ^ci_node_prepare_exact_subject
    BatchExecuted { receipts: _ } => false
    BatchRefusedInventedWork { node_identity: _ } => false
    BatchRefusedWidthExceeded { permitted: _, observed: _ } => false
  }
  let rewidened = match admit_batch_execution(
    jobs: requested_jobs,
    capacity: cap_two,
    receipts: receipts_exact,
    observed_width: 5
  ) {
    BatchRefusedWidthExceeded { permitted: p, observed: o } => (p == 2) && (o == 5)
    BatchExecuted { receipts: _ } => false
    BatchRefusedInventedWork { node_identity: _ } => false
    BatchRefusedDroppedWork { node_identity: _ } => false
  }
  invented && dropped && rewidened
}

// A CLAIM REQUEST NAMES THE SUBJECT BY DIGEST. There is no field on it for a source
// root, an index, a resolver, or an entry path, so a claim cannot ask the host to
// build a compiler world -- the structural half of "zero per-entry graph resolves".
test fn a_claim_request_carries_only_a_capability_digest() -> Bool {
  match (EvaluatePreparedClaimRequest {
    capability: ci_attempt_subject_digest(request: base_request),
    declaration: ^ci_decl_a,
    budget_ms: 5000
  }) {
    EvaluatePreparedClaimRequest { capability: c, declaration: d, budget_ms: b } =>
      (c == ci_attempt_subject_digest(request: base_request)) && (d == ^ci_decl_a) && (b == 5000)
    PrepareExactSubjectRequest { envelope: _ } => false
    RealizeCiHostEffectRequest { effect: _ } => false
    ExecuteExactBatchRequest { jobs: _, capacity: _ } => false
  }
}

// A REFUSED NODE IS NOT A FAILED NODE. A failure is a checked property that did not
// hold; a refusal is a node that could not be judged at all, and they route
// differently -- a defect in the subject versus a defect in the attempt.
data receipts_one_refused: List<CiNodeReceipt> = [
  CiNodeReceipt { node_identity: ^ci_node_format_check, outcome: NodePassed },
  CiNodeReceipt {
    node_identity: ^ci_node_prepare_exact_subject,
    outcome: NodeRefused { cause: ^ci_cause_capability_unavailable }
  }
]

test fn a_refused_node_is_distinct_from_a_failed_node() -> Bool {
  let refused = match ci_attempt_verdict(plan_nodes: plan_two, receipts: receipts_one_refused) {
    AttemptNodeRefused { node_identity: n, cause: c } =>
      (n == ^ci_node_prepare_exact_subject) && (c == ^ci_cause_capability_unavailable)
    AttemptFailed { node_identity: _ } => false
    AttemptPassed => false
    AttemptRefused { reconciliation: _ } => false
  }
  let failed = match ci_attempt_verdict(plan_nodes: plan_two, receipts: receipts_one_failed) {
    AttemptFailed { node_identity: n } => n == ^ci_node_prepare_exact_subject
    AttemptNodeRefused { node_identity: _, cause: _ } => false
    AttemptPassed => false
    AttemptRefused { reconciliation: _ } => false
  }
  refused && failed
}
