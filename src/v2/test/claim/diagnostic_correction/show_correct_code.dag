module v2.test.diagnostic_correction.show_correct_code

import v2.std.diagnostic {
  AmbiguousIntent,
  ByteRange,
  Diagnostic,
  ExternalContractUnknown,
  node_locus,
  Outcome,
  port_locus,
  Rejected,
  Suggested,
  Textual,
  Unavailable,
  UserInputBoundary,
  WholeFile,
  diagnostics_singleton
}
import v2.std.node { Edge, Named, Node, Symbol, TypeNode, Atom, Conj, SyntheticOccurrence }
import v2.std.verification {ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  Integration,
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  RoundTripClaim,
  manual_claim_anchor
}
fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

fn pair_node(left: Symbol, right: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^correction_left }, target: atom_node(s: left) },
      Edge { label: Named { name: ^correction_right }, target: atom_node(s: right) },
    ],
    occurrence_id: SyntheticOccurrence
}
}

data complexity_correction_input: Node = pair_node(left: ^correction_bad_complexity_symbol, right: ^correction_good_complexity_symbol)

data complexity_correction_expected_node: Node = atom_node(s: ^correction_good_complexity_symbol)

data falsification_complexity_diagnostic_without_correct_code: Node = complexity_correction_input

data transport_correction_input: Node = pair_node(left: ^correction_drift_client_symbol, right: ^correction_drift_server_symbol)

data transport_correction_expected_node: Node = atom_node(s: ^correction_shared_contract_symbol)

data falsification_transport_diagnostic_without_correct_code: Node = transport_correction_input

data falsification_ambiguous_boundary_without_unavailable_reason: Node = atom_node(s: ^correction_english_boundary_symbol)

data falsification_textual_whole_file_without_locus: Node = atom_node(s: ^correction_textual_whole_file_subject)

data falsification_textual_byte_range_without_locus: Node = atom_node(s: ^correction_textual_byte_range_subject)

data falsification_port_diagnostic_without_locus: Node = atom_node(s: ^correction_drift_client_symbol)

data falsification_external_contract_without_reason: Node = atom_node(s: ^correction_drift_server_symbol)

data falsification_user_boundary_without_reason: Node = atom_node(s: ^correction_english_boundary_symbol)

data claim_complexity_diagnostic_suggests_correct_code: TestClaim = DiagnosticClaim {
  label: "complexity diagnostic suggests structurally correct replacement",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_complexity_diagnostic_without_correct_code,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^correction_complexity_reason,
        at: node_locus(node: falsification_complexity_diagnostic_without_correct_code),
        correction: Suggested { node: complexity_correction_expected_node }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_transport_diagnostic_suggests_shared_contract: TestClaim = DiagnosticClaim {
  label: "transport diagnostic suggests shared declaration replacement",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_transport_diagnostic_without_correct_code,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^correction_transport_reason,
        at: node_locus(node: falsification_transport_diagnostic_without_correct_code),
        correction: Suggested { node: transport_correction_expected_node }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_ambiguous_boundary_diagnostic_names_no_correction_reason: TestClaim = DiagnosticClaim {
  label: "ambiguous boundary diagnostic carries explicit unavailable correction reason",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_ambiguous_boundary_without_unavailable_reason,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^correction_ambiguous_boundary_reason,
        at: node_locus(node: falsification_ambiguous_boundary_without_unavailable_reason),
        correction: Unavailable { reason: AmbiguousIntent }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_textual_diagnostic_carries_whole_file_locus: TestClaim = DiagnosticClaim {
  label: "textual diagnostic carries whole-file locus and suggested correction",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_textual_whole_file_without_locus,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^correction_textual_reason,
        at: Textual { file: ^correction_source_file, extent: WholeFile },
        correction: Suggested { node: complexity_correction_expected_node }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_textual_diagnostic_carries_byte_range_locus: TestClaim = DiagnosticClaim {
  label: "textual diagnostic carries byte-range locus and suggested correction",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_textual_byte_range_without_locus,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^correction_textual_reason,
        at: Textual { file: ^correction_source_file, extent: ByteRange { start: 0, end: 1 } },
        correction: Suggested { node: complexity_correction_expected_node }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_port_diagnostic_carries_port_locus: TestClaim = DiagnosticClaim {
  label: "port diagnostic carries port locus and suggested correction",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_port_diagnostic_without_locus,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^correction_port_reason,
        at: port_locus(port: ^correction_port_symbol),
        correction: Suggested { node: transport_correction_expected_node }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_external_contract_diagnostic_names_no_correction_reason: TestClaim = DiagnosticClaim {
  label: "external contract diagnostic carries explicit unavailable correction reason",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_external_contract_without_reason,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^correction_external_contract_reason,
        at: node_locus(node: falsification_external_contract_without_reason),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_user_boundary_diagnostic_names_no_correction_reason: TestClaim = DiagnosticClaim {
  label: "user boundary diagnostic carries explicit unavailable correction reason",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_user_boundary_without_reason,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^correction_user_boundary_reason,
        at: node_locus(node: falsification_user_boundary_without_reason),
        correction: Unavailable { reason: UserInputBoundary }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Integration }
}
