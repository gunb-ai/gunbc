module v2.test.claim.algebra.zz_resolver_tail_rematch_probe

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type SymbolPath = FreeMonoid<Symbol>

fn probe_of_two() -> SymbolPath {
  Cons { head: ^a, tail: Cons { head: ^b, tail: Empty } }
}

fn second_is_present(path: SymbolPath) -> Bool {
  match path {
    Empty => false
    Cons { head: _, tail: t } =>
      match t {
        Empty => false
        Cons { head: _, tail: _ } => true
      }
  }
}

test fn tail_bound_raw_rematch_resolves() -> Bool {
  second_is_present(path: probe_of_two()) == true
}
