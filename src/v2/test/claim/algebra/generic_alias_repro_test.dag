module v2.test.claim.algebra.generic_alias_repro

import v2.std.algebra { Cons, Empty, FreeMonoid }
import v2.std.node { Symbol }

type QName = FreeMonoid<Symbol>

fn qname_singleton(sym: Symbol) -> QName {
  Cons { head: sym, tail: Empty }
}

fn qname_len(qn: QName) -> Int {
  match qn {
    Empty => 0
    Cons { head: _, tail: t } => 1 + qname_len(qn: t)
  }
}

test fn qname_matches_freemonoid_variants() -> Bool {
  qname_len(qn: qname_singleton(sym: ^a)) == 1
}
