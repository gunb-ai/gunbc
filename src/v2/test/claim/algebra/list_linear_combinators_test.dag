module v2.test.claim.algebra.list_linear_combinators


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn sample() -> std.algebra.FreeMonoid<Int> {
  std.algebra.Cons { head: 1, tail: std.algebra.Cons { head: 2, tail: std.algebra.Cons { head: 3, tail: std.algebra.Empty } } }
}

fn list_eq(xs: std.algebra.FreeMonoid<Int>, ys: std.algebra.FreeMonoid<Int>) -> Bool {
  match xs {
    std.algebra.Empty =>
      match ys {
        std.algebra.Empty => true
        Cons { head: _, tail: _ } => false
      }
    Cons { head: xh, tail: xt } =>
      match ys {
        std.algebra.Empty => false
        Cons { head: yh, tail: yt } =>
          (xh == yh) && list_eq(xs: xt, ys: yt)
      }
  }
}

test fn map_preserves_order_and_applies() -> Bool {
  list_eq(
    xs: list_map(xs: v2.test.claim.algebra.list_linear_combinators.sample(), f: fn(x) { x * 10 }),
    ys: [10, 20, 30]
  )
}

test fn map_of_empty_is_empty() -> Bool {
  list_eq(xs: list_map(xs: std.algebra.Empty, f: fn(x) { x * 10 }), ys: std.algebra.Empty)
}

test fn filter_keeps_order_of_survivors() -> Bool {
  list_eq(
    xs: filter(xs: v2.test.claim.algebra.list_linear_combinators.sample(), predicate: fn(x) { x != 2 }),
    ys: [1, 3]
  )
}

test fn filter_none_survive_is_empty() -> Bool {
  list_eq(xs: filter(xs: v2.test.claim.algebra.list_linear_combinators.sample(), predicate: fn(x) { x > 9 }), ys: std.algebra.Empty)
}

test fn flat_map_concatenates_groups_in_order() -> Bool {
  list_eq(
    xs: list_flat_map(xs: v2.test.claim.algebra.list_linear_combinators.sample(), f: fn(x) { [x, x * 10] }),
    ys: [1, 10, 2, 20, 3, 30]
  )
}

test fn flat_map_drops_empty_groups() -> Bool {
  list_eq(
    xs: list_flat_map(xs: v2.test.claim.algebra.list_linear_combinators.sample(), f: fn(x) {
      if x == 2 { std.algebra.Empty } else { std.algebra.Cons { head: x, tail: std.algebra.Empty } }
    }),
    ys: [1, 3]
  )
}

test fn reverse_reverses() -> Bool {
  list_eq(xs: list_reverse(xs: v2.test.claim.algebra.list_linear_combinators.sample()), ys: [3, 2, 1])
    && list_eq(xs: list_reverse(xs: std.algebra.Empty), ys: std.algebra.Empty)
}
