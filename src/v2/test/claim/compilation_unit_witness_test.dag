module v2.test.claim.compilation_unit_witness

import std.types { NonEmptyStr, ContentHash, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.interface_summary {
  InterfaceSummary,
  ExportEntry,
  ExportFn,
  InterfaceHash,
  contract_absent,
}
import v2.std.compilers.compilation_unit {
  CompilationUnit,
  CompilationUnitId,
  HandExplicit,
  ModuleDag,
  ModuleDagEdge,
  ModuleId,
  PartitionR4Refused,
  PartitionR4Valid,
  PolicyDerived,
  compilation_unit_artifact_id,
  partition_fold,
  partition_fold_deps_match_boundary_edges,
  partition_provenance_eq,
  partition_provenance_hand_explicit,
  partition_provenance_policy_derived,
  partition_r4_validity_verdict_valid,
  partition_unit_by_id,
}
import v2.std.collection { empty_map, map_insert }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_mod_a: ModuleId = "mod.a" as NonEmptyStr
data witness_mod_b: ModuleId = "mod.b" as NonEmptyStr
data witness_mod_c: ModuleId = "mod.c" as NonEmptyStr

data witness_unit_one: CompilationUnitId = "cu-one" as ContentHash
data witness_unit_two: CompilationUnitId = "cu-two" as ContentHash
data witness_unit_all: CompilationUnitId = "cu-all" as ContentHash

data witness_interface_hash: InterfaceHash = "witness-interface-hash-v0" as ContentHash

fn witness_export(name: NonEmptyStr) -> ExportEntry {
  ExportEntry {
    name: name,
    kind: ExportFn,
    contract: contract_absent(),
  }
}

fn witness_interface(module_path: NonEmptyStr, export_name: NonEmptyStr) -> InterfaceSummary {
  InterfaceSummary {
    module_path: module_path,
    exports: [witness_export(name: export_name)],
    interface_hash: witness_interface_hash,
  }
}

fn witness_interfaces() -> Map<ModuleId, InterfaceSummary> {
  empty_map()
    |> map_insert(witness_mod_a, witness_interface(module_path: "mod.a" as NonEmptyStr, export_name: "fn_a" as NonEmptyStr))
    |> map_insert(witness_mod_b, witness_interface(module_path: "mod.b" as NonEmptyStr, export_name: "fn_b" as NonEmptyStr))
    |> map_insert(witness_mod_c, witness_interface(module_path: "mod.c" as NonEmptyStr, export_name: "fn_c" as NonEmptyStr))
}

fn witness_triangle_dag() -> ModuleDag {
  ModuleDag {
    modules: [witness_mod_a, witness_mod_b, witness_mod_c],
    edges: [
      ModuleDagEdge { from: witness_mod_a, to: witness_mod_b },
      ModuleDagEdge { from: witness_mod_b, to: witness_mod_c },
      ModuleDagEdge { from: witness_mod_c, to: witness_mod_a },
    ],
    interfaces: witness_interfaces(),
  }
}

fn witness_chain_dag() -> ModuleDag {
  ModuleDag {
    modules: [witness_mod_a, witness_mod_b, witness_mod_c],
    edges: [
      ModuleDagEdge { from: witness_mod_a, to: witness_mod_b },
      ModuleDagEdge { from: witness_mod_b, to: witness_mod_c },
    ],
    interfaces: witness_interfaces(),
  }
}

fn witness_two_unit_assignment() -> Map<ModuleId, CompilationUnitId> {
  empty_map()
    |> map_insert(witness_mod_a, witness_unit_one)
    |> map_insert(witness_mod_b, witness_unit_one)
    |> map_insert(witness_mod_c, witness_unit_two)
}

fn witness_single_unit_assignment() -> Map<ModuleId, CompilationUnitId> {
  empty_map()
    |> map_insert(witness_mod_a, witness_unit_all)
    |> map_insert(witness_mod_b, witness_unit_all)
    |> map_insert(witness_mod_c, witness_unit_all)
}

fn witness_partition_fold_two_units() -> List<CompilationUnit> {
  partition_fold(
    module_dag: witness_triangle_dag(),
    assignment: witness_two_unit_assignment()
  )
}

fn witness_unit_one_members_and_deps() -> Bool {
  let units = witness_partition_fold_two_units()
  match partition_unit_by_id(units: units, unit_id: witness_unit_one) {
    Present { value: unit } =>
      (unit.members == [witness_mod_a, witness_mod_b])
        && (unit.deps == [witness_unit_two])
        && (unit.artifact == compilation_unit_artifact_id(unit_id: witness_unit_one))
    Absent => false
  }
}

fn witness_unit_two_members_interface_and_deps() -> Bool {
  let units = witness_partition_fold_two_units()
  match partition_unit_by_id(units: units, unit_id: witness_unit_two) {
    Present { value: unit } =>
      (unit.members == [witness_mod_c])
        && (unit.deps == [witness_unit_one])
        && ((unit.interface |> count) == 1)
        && (match unit.interface |> first {
          Present { value: export } => export.name == ("fn_c" as NonEmptyStr)
          Absent => false
        })
    Absent => false
  }
}

fn witness_single_unit_partition_has_no_cross_unit_deps() -> Bool {
  let units = partition_fold(
    module_dag: witness_triangle_dag(),
    assignment: witness_single_unit_assignment()
  )
  match partition_unit_by_id(units: units, unit_id: witness_unit_all) {
    Present { value: unit } =>
      (unit.members == [witness_mod_a, witness_mod_b, witness_mod_c])
        && (unit.deps == [])
        && ((unit.interface |> count) == 0)
    Absent => false
  }
}

fn witness_intra_unit_edges_do_not_become_deps() -> Bool {
  let units = partition_fold(
    module_dag: witness_chain_dag(),
    assignment: witness_single_unit_assignment()
  )
  match partition_unit_by_id(units: units, unit_id: witness_unit_all) {
    Present { value: unit } => unit.deps == []
    Absent => false
  }
}

fn witness_fold_deps_match_boundary_edges_two_unit() -> Bool {
  partition_fold_deps_match_boundary_edges(
    module_dag: witness_triangle_dag(),
    assignment: witness_two_unit_assignment()
  )
}

fn witness_fold_deps_match_boundary_edges_single_unit() -> Bool {
  partition_fold_deps_match_boundary_edges(
    module_dag: witness_triangle_dag(),
    assignment: witness_single_unit_assignment()
  )
}

fn witness_misderived_deps_would_fail_receipt() -> Bool {
  let units = witness_partition_fold_two_units()
  match partition_unit_by_id(units: units, unit_id: witness_unit_one) {
    Present { value: unit } =>
      !(unit.deps == [])
        && !(unit.deps == [witness_unit_one])
        && (unit.deps == [witness_unit_two])
    Absent => false
  }
}

fn witness_provenance_variants_distinct() -> Bool {
  let explicit = partition_provenance_hand_explicit()
  let derived = partition_provenance_policy_derived(
    policy: DeclarationRef {
      module_path: "v2.std.compilers.compilation_unit" as NonEmptyStr,
      decl_name: "partition_fold" as NonEmptyStr,
      field: WholeDeclaration,
    }
  )
  !partition_provenance_eq(left: explicit, right: derived)
    && partition_provenance_eq(left: explicit, right: explicit)
    && match derived {
      PolicyDerived { policy: _ } => true
      HandExplicit => false
    }
}

fn witness_r4_interface_carriers_only() -> Bool {
  partition_r4_validity_verdict_valid(verdict: PartitionR4Valid)
    && !partition_r4_validity_verdict_valid(
      verdict: PartitionR4Refused {
        cause: {
          tag: "rust-scc-split" as NonEmptyStr,
          detail: "witness-only carrier; realization-owned predicate",
        }
      }
    )
}

test fn compilation_unit_witnesses() -> Bool {
  witness_unit_one_members_and_deps()
    && witness_unit_two_members_interface_and_deps()
    && witness_single_unit_partition_has_no_cross_unit_deps()
    && witness_intra_unit_edges_do_not_become_deps()
    && witness_fold_deps_match_boundary_edges_two_unit()
    && witness_fold_deps_match_boundary_edges_single_unit()
    && witness_misderived_deps_would_fail_receipt()
    && witness_provenance_variants_distinct()
    && witness_r4_interface_carriers_only()
}
