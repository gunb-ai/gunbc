module v2.test.claim.compilation_unit_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data witness_mod_a: v2.std.compilers.compilation_unit.ModuleId = "mod.a" as std.types.NonEmptyStr
data witness_mod_b: v2.std.compilers.compilation_unit.ModuleId = "mod.b" as std.types.NonEmptyStr
data witness_mod_c: v2.std.compilers.compilation_unit.ModuleId = "mod.c" as std.types.NonEmptyStr

data witness_unit_one: v2.std.compilers.compilation_unit.CompilationUnitId = "cu-one" as v2.std.compilers.compilation_unit.CompilationUnitId
data witness_unit_two: v2.std.compilers.compilation_unit.CompilationUnitId = "cu-two" as v2.std.compilers.compilation_unit.CompilationUnitId
data witness_unit_all: v2.std.compilers.compilation_unit.CompilationUnitId = "cu-all" as v2.std.compilers.compilation_unit.CompilationUnitId

data witness_type_point: v2.std.node.Symbol = ^witness_cu_point
data witness_type_int: v2.std.node.Symbol = ^witness_cu_int
data witness_fn_use_point: v2.std.node.Symbol = ^witness_cu_use_point

fn witness_type_atom(sym: v2.std.node.Symbol) -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } }, children: [])
}

fn witness_point_struct_conj_body() -> Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^x },
        target: v2.test.claim.compilation_unit_witness.witness_type_atom(sym: v2.test.claim.compilation_unit_witness.witness_type_int),
      }
    ]
  )
}

fn witness_fn_taking_point_by_value() -> Node {
  node_synthetic(
    kind: v2.std.node.TypeNode {
      connective: Arrow,
    },
    children: [
      v2.std.node.Edge {
        label: Named { name: ^domain },
        target: v2.test.claim.compilation_unit_witness.witness_type_atom(sym: v2.test.claim.compilation_unit_witness.witness_type_point),
      },
      v2.std.node.Edge {
        label: Named { name: ^codomain },
        target: v2.test.claim.compilation_unit_witness.witness_type_atom(sym: v2.test.claim.compilation_unit_witness.witness_type_int),
      }
    ]
  )
}

fn witness_exports_for_c() -> List<Node> {
  [v2.test.claim.compilation_unit_witness.witness_fn_taking_point_by_value()]
}

fn witness_type_defs_for_c() -> List<v2.std.compilers.compilation_unit.ModuleTypeDefinitionRow> {
  [
    v2.std.compilers.compilation_unit.ModuleTypeDefinitionRow {
      identity: v2.test.claim.compilation_unit_witness.witness_type_point,
      definition: v2.test.claim.compilation_unit_witness.witness_point_struct_conj_body(),
    }
  ]
}

fn witness_triangle_dag() -> v2.std.compilers.compilation_unit.ModuleDag {
  v2.std.compilers.compilation_unit.ModuleDag {
    modules: [witness_mod_a, witness_mod_b, witness_mod_c],
    edges: [
      v2.std.compilers.compilation_unit.ModuleDagEdge { from: witness_mod_a, to: witness_mod_b },
      v2.std.compilers.compilation_unit.ModuleDagEdge { from: witness_mod_b, to: witness_mod_c },
      v2.std.compilers.compilation_unit.ModuleDagEdge { from: witness_mod_c, to: witness_mod_a },
    ],
    exports: empty_map()
      |> map_insert(witness_mod_a, std.algebra.Empty)
      |> map_insert(witness_mod_b, std.algebra.Empty)
      |> map_insert(witness_mod_c, v2.test.claim.compilation_unit_witness.witness_exports_for_c()),
    type_definitions: empty_map()
      |> map_insert(witness_mod_a, std.algebra.Empty)
      |> map_insert(witness_mod_b, std.algebra.Empty)
      |> map_insert(witness_mod_c, v2.test.claim.compilation_unit_witness.witness_type_defs_for_c()),
  }
}

fn witness_chain_dag() -> v2.std.compilers.compilation_unit.ModuleDag {
  v2.std.compilers.compilation_unit.ModuleDag {
    modules: [witness_mod_a, witness_mod_b, witness_mod_c],
    edges: [
      v2.std.compilers.compilation_unit.ModuleDagEdge { from: witness_mod_a, to: witness_mod_b },
      v2.std.compilers.compilation_unit.ModuleDagEdge { from: witness_mod_b, to: witness_mod_c },
    ],
    exports: empty_map()
      |> map_insert(witness_mod_a, std.algebra.Empty)
      |> map_insert(witness_mod_b, std.algebra.Empty)
      |> map_insert(witness_mod_c, std.algebra.Empty),
    type_definitions: empty_map()
      |> map_insert(witness_mod_a, std.algebra.Empty)
      |> map_insert(witness_mod_b, std.algebra.Empty)
      |> map_insert(witness_mod_c, std.algebra.Empty),
  }
}

fn witness_two_unit_assignment() -> Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId> {
  empty_map()
    |> map_insert(witness_mod_a, v2.test.claim.compilation_unit_witness.witness_unit_one)
    |> map_insert(witness_mod_b, v2.test.claim.compilation_unit_witness.witness_unit_one)
    |> map_insert(witness_mod_c, v2.test.claim.compilation_unit_witness.witness_unit_two)
}

fn witness_single_unit_assignment() -> Map<v2.std.compilers.compilation_unit.ModuleId, v2.std.compilers.compilation_unit.CompilationUnitId> {
  empty_map()
    |> map_insert(witness_mod_a, witness_unit_all)
    |> map_insert(witness_mod_b, witness_unit_all)
    |> map_insert(witness_mod_c, witness_unit_all)
}

fn witness_partition_fold_two_units() -> List<v2.std.compilers.compilation_unit.CompilationUnit> {
  partition_fold(
    module_dag: v2.test.claim.compilation_unit_witness.witness_triangle_dag(),
    assignment: v2.test.claim.compilation_unit_witness.witness_two_unit_assignment()
  )
}

test fn witness_unit_one_members_and_deps() -> Bool {
  let units = v2.test.claim.compilation_unit_witness.witness_partition_fold_two_units()
  match partition_unit_by_id(units: units, unit_id: v2.test.claim.compilation_unit_witness.witness_unit_one) {
    Present { value: unit } =>
      (unit.members == [witness_mod_a, witness_mod_b])
        && (unit.deps == [v2.test.claim.compilation_unit_witness.witness_unit_two])
    Absent => false
  }
}

test fn witness_unit_two_interface_carries_declaration_content() -> Bool {
  let units = v2.test.claim.compilation_unit_witness.witness_partition_fold_two_units()
  let export_decl = v2.test.claim.compilation_unit_witness.witness_fn_taking_point_by_value()
  match partition_unit_by_id(units: units, unit_id: v2.test.claim.compilation_unit_witness.witness_unit_two) {
    Present { value: unit } =>
      (unit.members == [witness_mod_c])
        && (unit.deps == [v2.test.claim.compilation_unit_witness.witness_unit_one])
        && partition_interface_contains_node(interface: unit.interface, needle: export_decl)
    Absent => false
  }
}

test fn witness_unit_two_interface_includes_by_value_type_def() -> Bool {
  let units = v2.test.claim.compilation_unit_witness.witness_partition_fold_two_units()
  let point_def = v2.test.claim.compilation_unit_witness.witness_point_struct_conj_body()
  match partition_unit_by_id(units: units, unit_id: v2.test.claim.compilation_unit_witness.witness_unit_two) {
    Present { value: unit } =>
      partition_interface_contains_node(interface: unit.interface, needle: point_def)
        && ((unit.interface |> count) >= 2)
    Absent => false
  }
}

test fn witness_interface_closure_saturates_on_triangle() -> Bool {
  let dag = v2.test.claim.compilation_unit_witness.witness_triangle_dag()
  let assignment = v2.test.claim.compilation_unit_witness.witness_two_unit_assignment()
  let units = partition_fold(module_dag: dag, assignment: assignment)
  match partition_unit_by_id(units: units, unit_id: v2.test.claim.compilation_unit_witness.witness_unit_two) {
    Present { value: unit } =>
      match partition_interface_closure_saturate_result(
        seeds: [v2.test.claim.compilation_unit_witness.witness_fn_taking_point_by_value()],
        module_dag: dag,
        members: unit.members
      ) {
        PartitionInterfaceClosed { nodes: _ } => true
        PartitionInterfaceTruncated => false
      }
    Absent => false
  }
}

test fn witness_partition_fold_outcome_refuses_zero_closure_fuel() -> Bool {
  match partition_fold_outcome_with_closure_fuel(
    module_dag: v2.test.claim.compilation_unit_witness.witness_triangle_dag(),
    assignment: v2.test.claim.compilation_unit_witness.witness_two_unit_assignment(),
    closure_fuel: 0
  ) {
    PartitionFoldRefused {
      cause: InterfaceClosureUnreachedFixpoint { unit_id: _ },
    } => true
    PartitionFoldOk { units: _ } => false
  }
}

test fn witness_single_unit_partition_has_no_cross_unit_deps() -> Bool {
  let units = partition_fold(
    module_dag: v2.test.claim.compilation_unit_witness.witness_triangle_dag(),
    assignment: witness_single_unit_assignment()
  )
  match partition_unit_by_id(units: units, unit_id: witness_unit_all) {
    Present { value: unit } =>
      (unit.members == [witness_mod_a, witness_mod_b, witness_mod_c])
        && (unit.deps == [])
        && ((unit.interface |> count) == 0)
    Absent => false
  }
}

test fn witness_intra_unit_edges_do_not_become_deps() -> Bool {
  let units = partition_fold(
    module_dag: witness_chain_dag(),
    assignment: witness_single_unit_assignment()
  )
  match partition_unit_by_id(units: units, unit_id: witness_unit_all) {
    Present { value: unit } => unit.deps == []
    Absent => false
  }
}

test fn witness_fold_deps_match_boundary_edges_two_unit() -> Bool {
  partition_fold_deps_match_boundary_edges(
    module_dag: v2.test.claim.compilation_unit_witness.witness_triangle_dag(),
    assignment: v2.test.claim.compilation_unit_witness.witness_two_unit_assignment()
  )
}

test fn witness_fold_deps_match_boundary_edges_single_unit() -> Bool {
  partition_fold_deps_match_boundary_edges(
    module_dag: v2.test.claim.compilation_unit_witness.witness_triangle_dag(),
    assignment: witness_single_unit_assignment()
  )
}

test fn witness_misderived_deps_would_fail_receipt() -> Bool {
  let units = v2.test.claim.compilation_unit_witness.witness_partition_fold_two_units()
  match partition_unit_by_id(units: units, unit_id: v2.test.claim.compilation_unit_witness.witness_unit_one) {
    Present { value: unit } =>
      !(unit.deps == [])
        && !(unit.deps == [v2.test.claim.compilation_unit_witness.witness_unit_one])
        && (unit.deps == [v2.test.claim.compilation_unit_witness.witness_unit_two])
    Absent => false
  }
}

test fn witness_provenance_variants_distinct() -> Bool {
  let explicit = partition_provenance_hand_explicit()
  let derived = partition_provenance_policy_derived(
    policy: std.decl_ref.DeclarationRef {
      module_path: "v2.std.compilers.compilation_unit" as std.types.NonEmptyStr,
      decl_name: "partition_fold" as std.types.NonEmptyStr,
      field: std.decl_ref.WholeDeclaration,
    }
  )
  !partition_provenance_eq(left: explicit, right: derived)
    && partition_provenance_eq(left: explicit, right: explicit)
    && match derived {
      PolicyDerived { policy: _ } => true
      HandExplicit => false
    }
}

test fn witness_r4_interface_carriers_only() -> Bool {
  let valid_verdict = PartitionR4Valid
  let refused_verdict = partition_r4_witness_refused_scc_split
  match valid_verdict {
    PartitionR4Valid => true
    PartitionR4Refused { cause: _ } => false
  }
    && match refused_verdict {
      PartitionR4Valid => false
      PartitionR4Refused { cause: _ } => true
    }
}

test fn witness_partition_fold_outcome_ok_on_triangle() -> Bool {
  match partition_fold_outcome(
    module_dag: v2.test.claim.compilation_unit_witness.witness_triangle_dag(),
    assignment: v2.test.claim.compilation_unit_witness.witness_two_unit_assignment()
  ) {
    PartitionFoldOk { units: units } => (units |> count) == 2
    PartitionFoldRefused { cause: _ } => false
  }
}


data compilation_unit_artifact_unwritable_note: String = "Review 2026-08-01 finding 2. CompilationUnit previously carried an artifact field of type CompilationUnitArtifactId, always populated by rebranding id. It claimed independent information while carrying none, so a literal naming id unit-a and artifact unit-b was writable and made one unit claim two target identities: unit-a.h and unit-a.c against unit-b.o. The repair REMOVES the field, so that specimen is unwritable rather than refused — the climb is to structural impossibility, and per DESIGN section 4b the discriminating evidence stays enrolled even though the production machinery is deleted. A runtime falsifier can no longer be constructed because there is nothing left to mismatch, so the retained evidence is a compile-refusal pair: a record literal carrying a field its declaration does not have must NOT compile clean, while the same literal without it must. Both poles execute."

fn w_extra_derived_field_is_unwritable() -> Bool {
  !compile_dag_rust_emit_check(
    "module cuartifact_extra\n\nimport std.types { NonEmptyStr, String }\n\ntype UnitId = NonEmptyStr where brand(\"UnitId\")\n\ntype Unit {\n  id: UnitId\n}\n\nfn mismatched() -> Unit {\n  Unit { id: \"unit-a\" as UnitId, artifact: \"unit-b\" as UnitId }\n}\n",
    "src/cuartifact_extra.rs",
    [],
    []
  )
}

fn w_declared_fields_only_compiles_clean() -> Bool {
  compile_dag_rust_emit_check(
    "module cuartifact_ok\n\nimport std.types { NonEmptyStr, String }\n\ntype UnitId = NonEmptyStr where brand(\"UnitId\")\n\ntype Unit {\n  id: UnitId\n}\n\nfn consistent() -> Unit {\n  Unit { id: \"unit-a\" as UnitId }\n}\n",
    "src/cuartifact_ok.rs",
    ["fn consistent"],
    []
  )
}

test fn mismatched_artifact_identity_is_unwritable() -> Bool {
  w_extra_derived_field_is_unwritable()
}

test fn declared_fields_only_is_the_accepted_control() -> Bool {
  w_declared_fields_only_compiles_clean()
}
