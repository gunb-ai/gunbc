module v2.test.claim.scratch_decl_probe

import v2.std.collection { List }
import v2.std.decl_index { DeclFact, decl_facts, decl_facts_count, decl_facts_fn_item_count }
import v2.std.logic { Bool }
import v2.std.text { String }

data probe_roots: List<String> = ["dag", "src/v1", "src/v2"]

test fn decl_facts_probe_finds_build_type_env() -> Bool {
  fold(decl_facts(pool_roots: probe_roots), init: false, f: fn(found, fact) {
    found || (fact.qualified_name == "v1.compiler.infer.build_type_env")
  })
}

test fn decl_facts_probe_finds_dag_root_sentinel() -> Bool {
  fold(decl_facts(pool_roots: probe_roots), init: false, f: fn(found, fact) {
    found || (fact.qualified_name == "gunbc.commit_workflow.commit_gate_roster")
  })
}

test fn decl_facts_probe_finds_cost_lens_sentinel() -> Bool {
  fold(decl_facts(pool_roots: probe_roots), init: false, f: fn(found, fact) {
    found || (fact.qualified_name == "lens.cost.cost_lens")
  })
}

test fn decl_facts_probe_counts_hold() -> Bool {
  (decl_facts_count(pool_roots: probe_roots) > 1000)
    && (decl_facts_fn_item_count(pool_roots: probe_roots) > 500)
}
