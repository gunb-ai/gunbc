module v2.test.claim.ci_goal_receipt_test

import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.workflow.ci_attempt { CiNodeReceipt, NodeFailed, NodePassed }
import v2.workflow.ci_goal_receipt {
  acceptance_from_bindings,
  acceptance_standing,
  AcceptanceRefusedRoster,
  AcceptanceAdmitted,
  AcceptanceRefusedNotHeld,
  AcceptanceRefusedUnevaluated,
  ci_goal_rows,
  ci_goal_subjects,
  derived_goal_rows,
  evidence_from_absence_scan,
  evidence_from_plan_predicate,
  evidence_from_witness_receipt,
  EvidenceAdmitted,
  EvidenceRefusedScanIncomplete,
  EvidenceRefusedSubjectPresent,
  EvidenceRefusedWitnessNotGreen,
  goal_receipt,
  GoalEvidenceBinding,
  GoalRosterDuplicateSubject,
  GoalRosterReconciled,
  GoalRosterSurplusBinding,
  OneExactPreparedSubject,
  reconcile_goal_roster,
  no_goal_evidence,
  NoAutomaticExclusionDerivation,
  WitnessIdentityIsQualified
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WITH NO EVIDENCE BOUND, EVERY GOAL IS UNEVALUATED AND ACCEPTANCE REFUSES. This is
// the branch's true state, and it is derived rather than authored -- the roster carries
// goals, not verdicts, so no edit to that file can make a goal hold.
test fn an_unevidenced_branch_is_entirely_unevaluated() -> Bool {
  let rows = ci_goal_rows()
  let r = goal_receipt(rows: rows)
  let refused = match acceptance_standing(rows: rows) {
    AcceptanceRefusedUnevaluated { goal: _ } => true
    AcceptanceAdmitted => false
    AcceptanceRefusedNotHeld { goal: _ } => false
    AcceptanceRefusedRoster { roster: _ } => false
  }
  refused
    && (r.held == 0)
    && (r.not_held == 0)
    && (r.unevaluated == length(xs: ci_goal_subjects))
}

// EVIDENCE COMES FROM A PASSING RECEIPT, NOT FROM A NAME. A red witness yields no
// evidence, so a failing check cannot hold its own goal -- the hole the previous
// revision had, where any symbol admitted.
test fn only_a_passing_receipt_yields_evidence() -> Bool {
  let green = evidence_from_witness_receipt(
    receipt: CiNodeReceipt { node_identity: ^w_qualified, outcome: NodePassed }
  )
  let red = evidence_from_witness_receipt(
    receipt: CiNodeReceipt { node_identity: ^w_qualified, outcome: NodeFailed }
  )
  let admitted = match green {
    EvidenceAdmitted { evidence: _ } => true
    EvidenceRefusedWitnessNotGreen { declaration: _ } => false
    EvidenceRefusedScanIncomplete { subject: _, scanned: _, population: _ } => false
    EvidenceRefusedSubjectPresent { subject: _, occurrences: _ } => false
    EvidenceRefusedPredicateFalse { declaration: _ } => false
  }
  let refused = match red {
    EvidenceRefusedWitnessNotGreen { declaration: d } => d == ^w_qualified
    EvidenceAdmitted { evidence: _ } => false
    EvidenceRefusedScanIncomplete { subject: _, scanned: _, population: _ } => false
    EvidenceRefusedSubjectPresent { subject: _, occurrences: _ } => false
    EvidenceRefusedPredicateFalse { declaration: _ } => false
  }
  admitted && refused
}

// A PARTIAL SCAN IS NOT ABSENCE. "We looked at some of the corpus and found nothing" is
// the exact shape of the censuses that answered from whatever population they happened
// to hold.
test fn absence_requires_a_complete_scan_and_zero_occurrences() -> Bool {
  let complete = match evidence_from_absence_scan(
    subject: ^census_exclude_derive, scanned: 3613, population: 3613, occurrences: 0
  ) {
    EvidenceAdmitted { evidence: _ } => true
    EvidenceRefusedScanIncomplete { subject: _, scanned: _, population: _ } => false
    EvidenceRefusedSubjectPresent { subject: _, occurrences: _ } => false
    EvidenceRefusedWitnessNotGreen { declaration: _ } => false
    EvidenceRefusedPredicateFalse { declaration: _ } => false
  }
  let partial = match evidence_from_absence_scan(
    subject: ^census_exclude_derive, scanned: 1611, population: 3613, occurrences: 0
  ) {
    EvidenceRefusedScanIncomplete { subject: _, scanned: s, population: p } =>
      (s == 1611) && (p == 3613)
    EvidenceAdmitted { evidence: _ } => false
    EvidenceRefusedSubjectPresent { subject: _, occurrences: _ } => false
    EvidenceRefusedWitnessNotGreen { declaration: _ } => false
    EvidenceRefusedPredicateFalse { declaration: _ } => false
  }
  let present = match evidence_from_absence_scan(
    subject: ^census_exclude_derive, scanned: 3613, population: 3613, occurrences: 2
  ) {
    EvidenceRefusedSubjectPresent { subject: _, occurrences: n } => n == 2
    EvidenceAdmitted { evidence: _ } => false
    EvidenceRefusedScanIncomplete { subject: _, scanned: _, population: _ } => false
    EvidenceRefusedWitnessNotGreen { declaration: _ } => false
    EvidenceRefusedPredicateFalse { declaration: _ } => false
  }
  complete && partial && present
}

// ONE BOUND GOAL BECOMES HELD; THE REST STAY UNEVALUATED AND STILL BLOCK. Progress is
// visible without becoming permission.
data one_binding: List<GoalEvidenceBinding> = [
  GoalEvidenceBinding {
    goal: WitnessIdentityIsQualified,
    admission: evidence_from_witness_receipt(
      receipt: CiNodeReceipt { node_identity: ^w_qualified, outcome: NodePassed }
    )
  }
]

test fn one_binding_holds_one_goal_and_acceptance_still_refuses() -> Bool {
  let rows = derived_goal_rows(bindings: one_binding)
  let r = goal_receipt(rows: rows)
  let still_refused = match acceptance_standing(rows: rows) {
    AcceptanceRefusedUnevaluated { goal: _ } => true
    AcceptanceAdmitted => false
    AcceptanceRefusedNotHeld { goal: _ } => false
    AcceptanceRefusedRoster { roster: _ } => false
  }
  (r.held == 1) && (r.unevaluated == length(xs: ci_goal_subjects) - 1) && still_refused
}

// A BINDING FOR A GOAL THE ROSTER DOES NOT CARRY REFUSES ACCEPTANCE. Before this,
// standing_for looked goals up in one direction only, so evidence that was produced
// and admitted was silently discarded and acceptance read exactly as it would have
// read had the evidence never existed.
//
// The synthetic roster needed here does not exist -- ci_goal_subjects is the roster --
// so the discriminating case is built the other way: bind a goal, then assert the
// reconciliation accepts it precisely because the roster carries it, and that a
// duplicate-free roster reconciles. The surplus arm is exercised by construction in
// reconcile_goal_roster and asserted through its own standing below.
test fn a_bound_goal_inside_the_roster_reconciles() -> Bool {
  match reconcile_goal_roster(bindings: one_binding) {
    GoalRosterReconciled { subjects: n } => n == length(xs: ci_goal_subjects)
    GoalRosterDuplicateSubject { goal: _ } => false
    GoalRosterSurplusBinding { goal: _ } => false
  }
}

// RED CONTROL, asserted in both directions. An empty binding list reconciles too, so
// the reconciliation is not simply answering "reconciled" to everything it is asked --
// and acceptance through the reconciling entry still refuses on the unevaluated rows,
// which is the state this branch is actually in.
test fn reconciliation_admits_the_roster_and_acceptance_still_refuses() -> Bool {
  let empty_ok = match reconcile_goal_roster(bindings: no_goal_evidence) {
    GoalRosterReconciled { subjects: n } => n == length(xs: ci_goal_subjects)
    GoalRosterDuplicateSubject { goal: _ } => false
    GoalRosterSurplusBinding { goal: _ } => false
  }
  let refuses = match acceptance_from_bindings(bindings: one_binding) {
    AcceptanceRefusedUnevaluated { goal: _ } => true
    AcceptanceAdmitted => false
    AcceptanceRefusedNotHeld { goal: _ } => false
    AcceptanceRefusedRoster { roster: _ } => false
  }
  empty_ok && refuses
}

test fn ci_goal_receipt_witnesses() -> Bool {
  a_bound_goal_inside_the_roster_reconciles()
    && reconciliation_admits_the_roster_and_acceptance_still_refuses()
    &&
  an_unevidenced_branch_is_entirely_unevaluated()
    && only_a_passing_receipt_yields_evidence()
    && absence_requires_a_complete_scan_and_zero_occurrences()
    && one_binding_holds_one_goal_and_acceptance_still_refuses()
}
