module v2.test.claim.generated_conformance_floor




data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn generated_claim_emitted(o: v2.std.diagnostic.Outcome<v2.std.verification.TestClaim>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

