module v2.test.claim.native_driver_plan

import std.types { List }
import v2.std.text { String }
import std.algebra { length, fold_list }
import gunbc.instrument_targets { instrument_bindings }
import gunbc.native_census_verb { NativeCensusVerbWord, CensusVerbDeclRef, native_census_verb_of_word, native_census_verbs }
import gunbc.target_binding { TargetBinding, NativeCensusVerbProducer }
import std.optional { Absent, Present }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.process { ExitFailure, ExitSuccess }
import extdeps.bazel.target_pattern { render_target_pattern }
import gunbc.native_route_universe { native_route_default_pattern }
import extdeps.process.gnu_bash_exit { exit_code_misuse }
import v2.compiler.source_root_eval {
  NativeDriverAdjudicate,
  NativeDriverCensus,
  NativeDriverCensusResolve,
  NativeDriverCensusInfer,
  NativeDriverCensusScoped,
  NativeDriverCensusVerb,
  NativeDriverSelfHostFrontier,
  NativeDriverPlanRefused,
  NativeDriverPlanned,
  native_driver_adjudicate_needs_facts,
  native_driver_adjudicate_needs_pattern,
  native_driver_census_scoped_needs_subject,
  native_driver_census_scoped_needs_against,
  native_driver_parse,
  native_driver_plan_exit,
  native_driver_plan_source_roots,
  native_driver_usage
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHAT THESE ARMS EXIST TO PIN. The verb surface used to live in the rendered main: three literal
// comparisons and three inline refusals in emitted Rust, which no witness could reach. Moving the
// decision here is only an improvement if the decision is now EXERCISED, so every verb the driver
// admits and every refusal it can raise has an arm, and what the host reads -- the roots accessor
// and the adjudicate verb's facts path -- is checked against a plan rather than against argv.
//
// The refusal arms assert the EXACT message the rendered main printed. That is deliberate and it is
// not a change detector: these strings are this program's command-line contract, the change being
// made is a move rather than a redesign, and an arm that accepted any refusal text would pass
// while the contract silently changed under it.

fn parsed_verb_is_census(argv: List<String>) -> Bool {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => false
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverCensus { source_roots: _ } => true
        NativeDriverCensusResolve { source_roots: _ } => false
        NativeDriverCensusInfer { source_roots: _ } => false
        NativeDriverCensusVerb { verb: _, source_roots: _ } => false
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: _, source_roots: _ } => false
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: _ } => false
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => false
      }
  }
}

fn parsed_verb_is_census_resolve(argv: List<String>) -> Bool {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => false
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverCensus { source_roots: _ } => false
        NativeDriverCensusResolve { source_roots: _ } => true
        NativeDriverCensusInfer { source_roots: _ } => false
        NativeDriverCensusVerb { verb: _, source_roots: _ } => false
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: _, source_roots: _ } => false
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: _ } => false
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => false
      }
  }
}

fn parsed_verb_is_adjudicate(argv: List<String>) -> Bool {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => false
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverCensus { source_roots: _ } => false
        NativeDriverCensusResolve { source_roots: _ } => false
        NativeDriverCensusInfer { source_roots: _ } => false
        NativeDriverCensusVerb { verb: _, source_roots: _ } => false
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: _, source_roots: _ } => false
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: _ } => true
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => false
      }
  }
}

fn refusal_detail(argv: List<String>) -> String {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanned { verb: _ } => ""
    NativeDriverPlanRefused { reason: _, detail: detail } => detail
  }
}

fn planned_root_count(argv: List<String>) -> Int {
  length(xs: native_driver_plan_source_roots(plan: native_driver_parse(argv: argv)))
}

fn planned_facts_path(argv: List<String>) -> String {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => ""
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverAdjudicate { facts_path: path, pattern: _, source_roots: _ } => path
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => ""
        NativeDriverCensus { source_roots: _ } => ""
        NativeDriverCensusResolve { source_roots: _ } => ""
        NativeDriverCensusInfer { source_roots: _ } => ""
        NativeDriverCensusVerb { verb: _, source_roots: _ } => ""
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: _, source_roots: _ } => ""
      }
  }
}

fn plan_exit_is_misuse(argv: List<String>) -> Bool {
  match native_driver_plan_exit(plan: native_driver_parse(argv: argv)) {
    ExitSuccess => false
    ExitFailure { code: code, reason: _ } => code == exit_code_misuse
  }
}

fn plan_exit_is_success(argv: List<String>) -> Bool {
  match native_driver_plan_exit(plan: native_driver_parse(argv: argv)) {
    ExitSuccess => true
    ExitFailure { code: _, reason: _ } => false
  }
}

test fn the_census_verb_plans_with_its_roots_holds() -> Bool {
  parsed_verb_is_census(argv: ["census", "dag", "src/v2"])
  && (planned_root_count(argv: ["census", "dag", "src/v2"]) == 2)
  && plan_exit_is_success(argv: ["census", "dag", "src/v2"])
}

test fn the_census_resolve_verb_is_not_the_census_verb_holds() -> Bool {
  parsed_verb_is_census_resolve(argv: ["census-resolve", "dag"])
  && !parsed_verb_is_census(argv: ["census-resolve", "dag"])
}

fn parsed_verb_is_census_infer(argv: List<String>) -> Bool {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => false
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverCensus { source_roots: _ } => false
        NativeDriverCensusResolve { source_roots: _ } => false
        NativeDriverCensusVerb { verb: _, source_roots: _ } => false
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: _, source_roots: _ } => false
        NativeDriverCensusInfer { source_roots: _ } => true
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: _ } => false
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => false
      }
  }
}

// census-infer is its own word with its own roots, never census-resolve under another spelling
// (docs/plans/census-part-2-inference-design.md section 2a).
test fn the_census_infer_verb_plans_with_its_roots_and_is_not_census_resolve_holds() -> Bool {
  parsed_verb_is_census_infer(argv: ["census-infer", "dag", "src/v2"])
  && (planned_root_count(argv: ["census-infer", "dag", "src/v2"]) == 2)
  && !parsed_verb_is_census_resolve(argv: ["census-infer", "dag"])
}

// The first word after `adjudicate` is the facts path and `--pattern <p>` is an option; NEITHER is a source root -- the distinction
// the rendered main made by consuming one argument before collecting the rest.
test fn adjudicate_takes_its_facts_path_before_the_roots_holds() -> Bool {
  parsed_verb_is_adjudicate(argv: ["adjudicate", "host-facts.tsv", "--pattern", "//v2/test/...", "dag", "src/v2"])
  && (planned_facts_path(argv: ["adjudicate", "host-facts.tsv", "--pattern", "//v2/test/...", "dag", "src/v2"]) == "host-facts.tsv")
  && (planned_root_count(argv: ["adjudicate", "host-facts.tsv", "--pattern", "//v2/test/...", "dag", "src/v2"]) == 2)
  && (planned_root_count(argv: ["adjudicate", "host-facts.tsv", "dag", "src/v2"]) == 2)
}

// The self-host frontier is its own verb, never a mode of adjudicate: its three file operands are not a
// facts path, so the verb predicate discriminates the two words.
test fn the_self_host_frontier_verb_is_not_adjudicate_holds() -> Bool {
  parsed_verb_is_adjudicate(argv: ["adjudicate", "f.tsv", "dag"])
    && !parsed_verb_is_adjudicate(argv: ["self-host-frontier", "m.rs", "v.txt", "o.txt"])
}

test fn only_adjudicate_names_a_facts_path_holds() -> Bool {
  (planned_facts_path(argv: ["census", "dag"]) == "")
  && (planned_facts_path(argv: ["census-resolve", "dag"]) == "")
}

// Preserved behaviour, asserted so a later reader does not "fix" it: the rendered main planned a
// census with no roots and let the run fold answer. A parse-time refusal here would be a new wall.
test fn a_census_with_no_roots_is_planned_not_refused_holds() -> Bool {
  parsed_verb_is_census(argv: ["census"])
  && (planned_root_count(argv: ["census"]) == 0)
}

test fn an_empty_command_line_refuses_with_the_usage_holds() -> Bool {
  (refusal_detail(argv: []) == native_driver_usage)
  && plan_exit_is_misuse(argv: [])
}

test fn an_unknown_verb_refuses_and_names_the_word_holds() -> Bool {
  (refusal_detail(argv: ["adjudicat", "x"])
    == "REFUSED: unknown mode adjudicat -- expected adjudicate, census, census-resolve, census-infer, census-scoped, self-host-frontier, decl-ref-census")
  && plan_exit_is_misuse(argv: ["adjudicat", "x"])
}

test fn adjudicate_without_a_facts_path_refuses_holds() -> Bool {
  (refusal_detail(argv: ["adjudicate"]) == native_driver_adjudicate_needs_facts)
  && plan_exit_is_misuse(argv: ["adjudicate"])
}

// A refused plan names nothing to fetch, so the host walks no directory and reads no file for one.
test fn a_refused_plan_names_no_roots_and_no_facts_path_holds() -> Bool {
  (planned_root_count(argv: ["nonsense", "dag", "src/v2"]) == 0)
  && (planned_facts_path(argv: ["nonsense", "dag", "src/v2"]) == "")
}

// The first bad word is the located cause; later words cannot repair it, and cannot change which
// refusal is reported.
test fn a_later_word_cannot_repair_an_unknown_verb_holds() -> Bool {
  refusal_detail(argv: ["nonsense", "census"])
    == "REFUSED: unknown mode nonsense -- expected adjudicate, census, census-resolve, census-infer, census-scoped, self-host-frontier, decl-ref-census"
}

// THE PATTERN OPTION: carried to the plan as the authority parsed it, and refused at the command
// line when it does not parse or is dangling -- misuse (status 2), never a derived universe. ABSENT,
// it is the compiler's own route boundary, read from the declaration that owns it.
fn planned_pattern_render(argv: List<String>) -> String {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => ""
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverAdjudicate { facts_path: _, pattern: p, source_roots: _ } => render_target_pattern(pattern: p)
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => ""
        NativeDriverCensus { source_roots: _ } => ""
        NativeDriverCensusResolve { source_roots: _ } => ""
        NativeDriverCensusInfer { source_roots: _ } => ""
        NativeDriverCensusVerb { verb: _, source_roots: _ } => ""
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: _, source_roots: _ } => ""
      }
  }
}

test fn adjudicate_carries_its_parsed_target_pattern_holds() -> Bool {
  (planned_pattern_render(argv: ["adjudicate", "f.tsv", "--pattern", "//v2/test/claim/parse:expression_bodied_fn_decl_parse", "src/v2"])
    == "//v2/test/claim/parse:expression_bodied_fn_decl_parse")
  && (planned_pattern_render(argv: ["adjudicate", "f.tsv", "--pattern", "//v2/test/parse/...", "src/v2"]) == "//v2/test/parse/...")
}

test fn adjudicate_with_an_unparseable_pattern_refuses_as_misuse_holds() -> Bool {
  plan_exit_is_misuse(argv: ["adjudicate", "f.tsv", "--pattern", "v2/test/parse", "src/v2"])
  && string_contains(s: refusal_detail(argv: ["adjudicate", "f.tsv", "--pattern", "v2/test/parse", "src/v2"]), pattern: "not absolute")
  && (planned_root_count(argv: ["adjudicate", "f.tsv", "--pattern", "v2/test/parse", "src/v2"]) == 0)
}

// A FLAG WITH NO VALUE REFUSES, and does not fall back to the default. The caller named a pattern and
// lost it; answering for the whole boundary would report a population nobody asked for.
test fn adjudicate_with_a_dangling_pattern_flag_refuses_holds() -> Bool {
  (refusal_detail(argv: ["adjudicate", "f.tsv", "--pattern"]) == native_driver_adjudicate_needs_pattern)
  && plan_exit_is_misuse(argv: ["adjudicate", "f.tsv", "--pattern"])
  && (planned_root_count(argv: ["adjudicate", "f.tsv", "--pattern"]) == 0)
}

// THE DEFAULT IS THE AUTHORITY'S VALUE, NOT A SPELLING OF IT HERE. The expectation is rendered from
// `native_route_default_pattern` itself, so moving that declaration moves both sides together and an
// emitted driver that substituted its own boundary would disagree with it. With no roots the plan is
// still made (the same rule the census verbs keep): absence of roots is the run fold's to answer.
test fn adjudicate_without_a_pattern_defaults_to_the_route_boundary_holds() -> Bool {
  (planned_pattern_render(argv: ["adjudicate", "f.tsv", "dag", "src/v2"])
    == render_target_pattern(pattern: native_route_default_pattern()))
  && (planned_pattern_render(argv: ["adjudicate", "f.tsv"]) == render_target_pattern(pattern: native_route_default_pattern()))
  && (planned_root_count(argv: ["adjudicate", "f.tsv"]) == 0)
  && plan_exit_is_success(argv: ["adjudicate", "f.tsv"])
}

// DISCRIMINATING PAIR: an explicit pattern is not overwritten by the default. A parse that always
// planned the default would pass the control above and fail this one.
test fn an_explicit_pattern_is_not_replaced_by_the_default_holds() -> Bool {
  (planned_pattern_render(argv: ["adjudicate", "f.tsv", "--pattern", "//v2/test/parse/...", "src/v2"])
    != render_target_pattern(pattern: native_route_default_pattern()))
}

// THE FLAG IS RECOGNISED ONLY WHERE AN OPTION CAN BE. Once the first root has been read every later
// word is a root, so a root that happens to be spelled like the flag is not misread as one.
test fn the_flag_after_the_first_root_is_a_root_holds() -> Bool {
  (planned_root_count(argv: ["adjudicate", "f.tsv", "dag", "--pattern"]) == 2)
  && (planned_pattern_render(argv: ["adjudicate", "f.tsv", "dag", "--pattern"]) == render_target_pattern(pattern: native_route_default_pattern()))
}

fn parsed_verb_is_decl_ref_census(argv: List<String>) -> Bool {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => false
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverCensus { source_roots: _ } => false
        NativeDriverCensusResolve { source_roots: _ } => false
        NativeDriverCensusInfer { source_roots: _ } => false
        NativeDriverCensusVerb { verb: v, source_roots: _ } => v == CensusVerbDeclRef
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: _, source_roots: _ } => false
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: _ } => false
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => false
      }
  }
}

// The declaration-reference census is its own verb over source roots, so `decl-ref-census` plans that
// verb with every following word a root.
test fn decl_ref_census_plans_its_own_verb_over_its_roots_holds() -> Bool {
  parsed_verb_is_decl_ref_census(argv: ["decl-ref-census", "dag", "src/v2"])
    && (planned_root_count(argv: ["decl-ref-census", "dag", "src/v2"]) == 2)
    && !parsed_verb_is_census_resolve(argv: ["decl-ref-census", "dag"])
}

// THE PREDICATE KEYS ON THE VERB ROW, not on the plan arm: every census verb plans the one
// NativeDriverCensusVerb arm, so the verbs are told apart only by the word the row carries. An arm
// answering one constant for the whole row fails one side of this pair.
test fn decl_ref_census_is_not_another_census_verb_holds() -> Bool {
  parsed_verb_is_decl_ref_census(argv: ["decl-ref-census", "dag"])
    && !parsed_verb_is_decl_ref_census(argv: ["effect-pair-census", "dag"])
}

// THE SCOPED VERB: its own word, a subject operand checked against the one label-to-module function
// (native_census_subject_module) before any root, then its roots. A label that names no module and a
// verb with no subject are misuse, refused at the command line.
fn planned_scoped_subject(argv: List<String>) -> String {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => ""
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverCensusScoped { subject: subject, subjects_rest: _, against: _, source_roots: _ } => subject
        NativeDriverCensus { source_roots: _ } => ""
        NativeDriverCensusResolve { source_roots: _ } => ""
        NativeDriverCensusInfer { source_roots: _ } => ""
        NativeDriverCensusVerb { verb: _, source_roots: _ } => ""
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: _ } => ""
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => ""
      }
  }
}

test fn the_census_scoped_verb_plans_its_subject_before_its_roots_holds() -> Bool {
  (planned_scoped_subject(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "dag", "src/v2"])
    == "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all")
  && (planned_root_count(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "dag", "src/v2"]) == 2)
  && plan_exit_is_success(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "dag", "src/v2"])
  && !parsed_verb_is_census_infer(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "dag"])
}

test fn a_census_scoped_subject_that_names_no_module_refuses_as_misuse_holds() -> Bool {
  (planned_scoped_subject(argv: ["census-scoped", "//v2/test/claim/parse:expression_bodied_fn_decl_parse", "dag"]) == "")
  && plan_exit_is_misuse(argv: ["census-scoped", "//v2/test/claim/parse:expression_bodied_fn_decl_parse", "dag"])
  && plan_exit_is_misuse(argv: ["census-scoped", "//v2/test/...", "dag"])
  && (planned_root_count(argv: ["census-scoped", "//v2/test/...", "dag"]) == 0)
}

test fn census_scoped_without_a_subject_refuses_with_its_message_holds() -> Bool {
  (refusal_detail(argv: ["census-scoped"]) == native_driver_census_scoped_needs_subject)
  && plan_exit_is_misuse(argv: ["census-scoped"])
}

// THE BASELINE IS AN OPERAND OF ITS OWN, right after the subject: its path is never counted as a
// root, a flag with no path refuses as misuse, and a run without one plans no baseline.
fn planned_scoped_against(argv: List<String>) -> String {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => "<refused>"
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: against, source_roots: _ } =>
          match against {
            Present { value: path } => path
            Absent => "<none>"
          }
        NativeDriverCensus { source_roots: _ } => "<other>"
        NativeDriverCensusResolve { source_roots: _ } => "<other>"
        NativeDriverCensusInfer { source_roots: _ } => "<other>"
        NativeDriverCensusVerb { verb: _, source_roots: _ } => "<other>"
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: _ } => "<other>"
        NativeDriverSelfHostFrontier { manifest_path: _, verdict_path: _, observed_path: _ } => "<other>"
      }
  }
}

test fn census_scoped_against_names_a_baseline_and_not_a_root_holds() -> Bool {
  (planned_scoped_against(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "--against", "before.json", "dag", "src/v2"]) == "before.json")
  && (planned_root_count(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "--against", "before.json", "dag", "src/v2"]) == 2)
  && (planned_scoped_against(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "dag"]) == "<none>")
}

test fn census_scoped_against_without_a_path_refuses_as_misuse_holds() -> Bool {
  (refusal_detail(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "--against"]) == native_driver_census_scoped_needs_against)
  && plan_exit_is_misuse(argv: ["census-scoped", "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all", "--against"])
}

fn parsed_frontier_operands(argv: List<String>) -> String {
  match native_driver_parse(argv: argv) {
    NativeDriverPlanRefused { reason: _, detail: _ } => ""
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverSelfHostFrontier { manifest_path: m, verdict_path: v, observed_path: o } => concat(m, "|", v, "|", o)
        NativeDriverCensus { source_roots: _ } => ""
        NativeDriverCensusResolve { source_roots: _ } => ""
        NativeDriverCensusInfer { source_roots: _ } => ""
        NativeDriverCensusVerb { verb: _, source_roots: _ } => ""
        NativeDriverCensusScoped { subject: _, subjects_rest: _, against: _, source_roots: _ } => ""
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: _ } => ""
      }
  }
}

// The frontier verb takes exactly three file operands and no source root; a missing or extra one is
// misuse at the command line, never an ignored word.
test fn the_self_host_frontier_verb_plans_three_operands_and_no_roots_holds() -> Bool {
  (parsed_frontier_operands(argv: ["self-host-frontier", "m.rs", "v.txt", "o.txt"]) == "m.rs|v.txt|o.txt")
    && (planned_root_count(argv: ["self-host-frontier", "m.rs", "v.txt", "o.txt"]) == 0)
    && plan_exit_is_success(argv: ["self-host-frontier", "m.rs", "v.txt", "o.txt"])
    && plan_exit_is_misuse(argv: ["self-host-frontier", "m.rs", "v.txt"])
    && plan_exit_is_misuse(argv: ["self-host-frontier"])
    && plan_exit_is_misuse(argv: ["self-host-frontier", "m.rs", "v.txt", "o.txt", "extra"])
}

// THE JOIN THAT KEEPS THE VERB ONE FACT. The binding's producer field IS NativeCensusVerbWord
// (gunbc.native_census_verb), so a binding naming a verb that is not a word cannot be written; the one
// direction left to join is that every word has a binding.
fn binding_names_verb(b: TargetBinding, v: NativeCensusVerbWord) -> Bool {
  match b.producer {
    NativeCensusVerbProducer { verb: w } => w == v
    _ => false
  }
}

test fn every_native_census_verb_word_has_a_binding_holds() -> Bool {
  fold_list(xs: native_census_verbs, empty: true, cons: fn(ok, v) {
    ok && fold_list(xs: instrument_bindings(), empty: false, cons: fn(found, b) { found || binding_names_verb(b: b, v: v) })
  })
}

test fn a_misspelled_census_verb_is_not_a_word_holds() -> Bool {
  match native_census_verb_of_word(word: "decl-ref-cenzus") {
    Present { value: _ } => false
    Absent => true
  }
}
