// src/v2/test/claim/concept_index_enumeration_test.dag
// Discriminating witnesses for v2.std.concept_index.enumerate_concepts (DESIGN.md §2/§5).
// Proves the corpus enumeration primitive produces the downstream consumer contract shape
// (plans.namespace_index): List<QualifiedConcept> { qualified_name: String (logical, v2.-stripped),
// concept: ConceptStruct { name: String (leaf), fields: List<FieldRef> } }.
//
// Green BY EXECUTION on the live import closure (not a hand-fed demo_index): the concept_index
// module's own record types and this module's own record are enumerated, with full field
// projection. Discriminating: a non-existent concept is absent, and the un-normalized v2.-prefixed
// path is absent (proves the strip rule rather than an accidental substring pass).
//
// Note: the consolidation classifier witnesses (synonym/homonym/novel) live in the CONSUMER
// (ctrl plans.namespace_index), which swaps its hand-fed demo_index() for enumerate_concepts()
// post-merge; THIS file proves only the enumeration shape gunbc owns.

module v2.test.claim.concept_index_enumeration


import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.collection { List }
import v2.std.concept_index { FieldRef, QualifiedConcept, enumerate_concepts }


// A record declared in THIS module — proves enumeration covers the live corpus (and the
// v2.test.* -> test.* logical-path normalization), with its members projected to FieldRefs.
type ConceptIndexWitnessRecord {
  alpha: String
  beta: Bool
}


fn idx() -> List<QualifiedConcept> {
  enumerate_concepts()
}

fn idx_has_qn(target: String) -> Bool {
  fold(idx(), init: false, f: fn(acc, qc) { acc || (qc.qualified_name == target) })
}

fn fields_contains(fields: List<FieldRef>, fname: String, tname: String) -> Bool {
  fold(fields, init: false, f: fn(acc, fr) { acc || ((fr.field == fname) && (fr.type_name == tname)) })
}

// Locate a concept by its (logical) qualified name and assert its full ConceptStruct projection:
// leaf name, field count, and a field-membership predicate (set-style, order-insensitive — the
// consumer's structurally_equal is set equality on FieldRef pairs).
fn concept_matches(
  target_qn: String,
  short_name: String,
  field_count: Int,
  check: fn(List<FieldRef>) -> Bool
) -> Bool {
  fold(idx(), init: false, f: fn(acc, qc) {
    if qc.qualified_name == target_qn {
      acc
        || ((qc.concept.name == short_name)
            && (qc.concept.fields.length() == field_count)
            && check(qc.concept.fields))
    } else {
      acc
    }
  })
}

fn witness_enumeration_nonempty() -> Bool {
  idx().length() > 0
}

// FieldRef (a record in v2.std.concept_index): logical qn strips the v2. prefix, leaf name is
// short, both members project as String fields.
fn witness_fieldref_self_projection() -> Bool {
  concept_matches(
    target_qn: "std.concept_index.FieldRef",
    short_name: "FieldRef",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "field", tname: "String")
        && fields_contains(fields: fields, fname: "type_name", tname: "String")
    }
  )
}

// QualifiedConcept: a record whose member types are non-primitive (String + ConceptStruct).
fn witness_qualified_concept_self_projection() -> Bool {
  concept_matches(
    target_qn: "std.concept_index.QualifiedConcept",
    short_name: "QualifiedConcept",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "qualified_name", tname: "String")
        && fields_contains(fields: fields, fname: "concept", tname: "ConceptStruct")
    }
  )
}

// This module's own record is enumerated (live corpus coverage; v2.test.* -> test.* strip).
fn witness_local_record_enumerated() -> Bool {
  concept_matches(
    target_qn: "test.claim.concept_index_enumeration.ConceptIndexWitnessRecord",
    short_name: "ConceptIndexWitnessRecord",
    field_count: 2,
    check: fn(fields) {
      fields_contains(fields: fields, fname: "alpha", tname: "String")
        && fields_contains(fields: fields, fname: "beta", tname: "Bool")
    }
  )
}

// Discriminating negatives: a non-existent concept is absent; the un-normalized v2.-prefixed path
// is absent (proves the strip rule, not an accidental pass).
fn witness_absent_concept_is_false() -> Bool {
  (idx_has_qn(target: "std.concept_index.NoSuchConceptZZZ") == false)
    && (idx_has_qn(target: "v2.std.concept_index.FieldRef") == false)
}

test fn concept_index_enumeration_witnesses() -> Bool {
  witness_enumeration_nonempty()
    && witness_fieldref_self_projection()
    && witness_qualified_concept_self_projection()
    && witness_local_record_enumerated()
    && witness_absent_concept_is_false()
}
