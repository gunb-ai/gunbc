module v2.test.claim.walk_plan_schedule_lens

import std.execution_mode { Hermetic }
import std.realization_schedule {
  RealizationObjective,
  RealizationPlan,
  Runnable,
  RunnableSingleClaim,
  RunnableDiscoveryBatch,
  RunnableKernelWorkload,
  WalkPlan,
  NoWalkFinalization,
  NoFinalizationDeclared,
  NoPreWalkExecution,
  cost_account_predicted_zero,
  runnable_memory_negligible,
  runnable_memory_substantial,
  runnable_resource_profile,
  runnable_resource_profile_negligible,
}
import std.content_hash { ContentHash, content_hash_of_value }
import v2.lens.schedule_lens { walk_plan_schedule_lens_verdict_for_ci_floor }
import v2.std.collection { List }
import v2.std.lens_verdict { Holds, LensVerdict, Violation, NotApplicable, Unrealized }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.workflow.ci_floor_plan { gunbc_ci_floor_schedule_lens_holds }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data synthetic_target: ContentHash = content_hash_of_value(value: "walk-plan-schedule-lens-v1")
data synthetic_compile_gate_fn: String = "dag_compile_clean_gate_passes"
data synthetic_entry: String = "dag/tools/floor_effect_gate_witness.dag"

fn synthetic_claim(function: String) -> Runnable {
  RunnableSingleClaim {
    entry: synthetic_entry,
    function: function,
    profile: runnable_resource_profile_negligible()
  }
}

fn synthetic_ordinary_plan() -> RealizationPlan<Runnable> {
  RealizationPlan {
    target: synthetic_target,
    objective: RealizationObjective { goals: [] },
    schedule: [
      [synthetic_claim(function: "cheap_claim_pool_gate_passes")],
      [synthetic_claim(function: synthetic_compile_gate_fn)],
      [
        synthetic_claim(function: "emit_host_gate_passes"),
        synthetic_claim(function: "regen_verify_gate_passes")
      ]
    ],
    total: cost_account_predicted_zero()
  }
}

fn stage_a() -> Runnable {
  synthetic_claim(function: "capture_tested_subject")
}

fn stage_b() -> Runnable {
  synthetic_claim(function: "stamp_tested_floor")
}

fn stage_c() -> Runnable {
  synthetic_claim(function: "refresh_target_and_gate")
}

fn expected_stages() -> List<List<Runnable>> {
  [[stage_a(), stage_b()], [stage_c()]]
}

fn synthetic_walk(stages: List<List<Runnable>>) -> WalkPlan<NoWalkFinalization> {
  WalkPlan {
    pre_walk_execution: NoPreWalkExecution {},
    batches: synthetic_ordinary_plan().schedule,
    finalization: NoFinalizationDeclared {},
    on_success_stages: stages,
    ordinary_budget: none,
    on_success_budget: none
  }
}

fn synthetic_walk_with_wrong_ordinary_projection() -> WalkPlan<NoWalkFinalization> {
  WalkPlan {
    pre_walk_execution: NoPreWalkExecution {},
    batches: synthetic_ordinary_plan().schedule.skip(n: 1),
    finalization: NoFinalizationDeclared {},
    on_success_stages: expected_stages(),
    ordinary_budget: none,
    on_success_budget: none
  }
}

fn synthetic_verdict(stages: List<List<Runnable>>, expected: List<List<Runnable>>) -> LensVerdict {
  walk_plan_schedule_lens_verdict_for_ci_floor(
    plan: synthetic_walk(stages: stages),
    ordinary_plan: synthetic_ordinary_plan(),
    expected_on_success_stages: expected,
    compile_gate_fn: synthetic_compile_gate_fn,
    cheap_gate_labels: ["cheap_claim_pool_gate_passes"]
  )
}

fn verdict_holds(verdict: LensVerdict) -> Bool {
  match verdict {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn verdict_violates(verdict: LensVerdict) -> Bool {
  match verdict {
    Holds => false
    Violation { diagnostic: _ } => true
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn discovery_runnable() -> Runnable {
  RunnableDiscoveryBatch {
    source_roots: ["dag"],
    scan_dirs: [],
    explicit_entries: [],
    exclude_substrings: [],
    discovery_scope_dirs: [],
    profile: runnable_resource_profile_negligible()
  }
}

fn profiled_claim(
  function: String,
  heavy_whole_tree_resolve: Bool,
  spawns_host_compiler: Bool,
  substantial: Bool
) -> Runnable {
  RunnableSingleClaim {
    entry: synthetic_entry,
    function: function,
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: heavy_whole_tree_resolve,
      spawns_host_compiler: spawns_host_compiler,
      memory: if substantial { runnable_memory_substantial() } else { runnable_memory_negligible() },
      execution_mode: Hermetic
    )
  }
}

test fn gunbc_ci_walk_plan_schedule_lens_holds() -> Bool {
  gunbc_ci_floor_schedule_lens_holds()
}

test fn walk_plan_schedule_lens_synthetic_controls_hold() -> Bool {
  verdict_holds(verdict: synthetic_verdict(stages: expected_stages(), expected: expected_stages()))
    && verdict_violates(verdict: walk_plan_schedule_lens_verdict_for_ci_floor(
      plan: synthetic_walk_with_wrong_ordinary_projection(),
      ordinary_plan: synthetic_ordinary_plan(),
      expected_on_success_stages: expected_stages(),
      compile_gate_fn: synthetic_compile_gate_fn,
      cheap_gate_labels: ["cheap_claim_pool_gate_passes"]
    ))
    && verdict_violates(verdict: synthetic_verdict(stages: [], expected: expected_stages()))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[stage_c()], [stage_a(), stage_b()]],
      expected: expected_stages()
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[stage_a(), stage_b(), stage_c()]],
      expected: expected_stages()
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[stage_a()], [stage_b()], [stage_c()]],
      expected: expected_stages()
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[stage_a(), stage_b()], [stage_a(), stage_b()], [stage_c()]],
      expected: expected_stages()
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[stage_a(), stage_b(), stage_b()], [stage_c()]],
      expected: expected_stages()
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[stage_a()], [stage_c()]],
      expected: expected_stages()
    ))
    && verdict_holds(verdict: synthetic_verdict(
      stages: [[stage_b(), stage_a()], [stage_c()]],
      expected: expected_stages()
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[discovery_runnable()]],
      expected: [[discovery_runnable()]]
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[RunnableKernelWorkload { fused_op_count: 1 }]],
      expected: [[RunnableKernelWorkload { fused_op_count: 1 }]]
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[profiled_claim(function: "heavy", heavy_whole_tree_resolve: true, spawns_host_compiler: false, substantial: false)]],
      expected: [[profiled_claim(function: "heavy", heavy_whole_tree_resolve: true, spawns_host_compiler: false, substantial: false)]]
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[profiled_claim(function: "host", heavy_whole_tree_resolve: false, spawns_host_compiler: true, substantial: false)]],
      expected: [[profiled_claim(function: "host", heavy_whole_tree_resolve: false, spawns_host_compiler: true, substantial: false)]]
    ))
    && verdict_violates(verdict: synthetic_verdict(
      stages: [[profiled_claim(function: "substantial", heavy_whole_tree_resolve: false, spawns_host_compiler: false, substantial: true)]],
      expected: [[profiled_claim(function: "substantial", heavy_whole_tree_resolve: false, spawns_host_compiler: false, substantial: true)]]
    ))
}
