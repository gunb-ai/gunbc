module v2.test.claim.variant_field_native_binding

import std.algebra { Cons, Empty, FreeMonoid }
import v2.compiler.normalized_tree { no_record_declarations, no_resource_declarations }
import v2.compiler.symbol_index_fill { symbol_index_fill_module_root }
import v2.extdeps.languages.dag { dag_grammar_atom, dag_named_edge }
import v2.std.algebra { fold_list_node, is_empty }
import v2.std.collection { List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Disj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  node_synthetic
}
import v2.std.qualified_name {
  qualified_name_from_dotted_string,
  qualified_name_snoc,
  qualified_name_to_dotted_string
}
import v2.std.symbol_index {
  SymbolIndex,
  empty_symbol_index,
  symbol_index_candidates_at
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: the restoration trigger of gunbc.rung_drop
// variant_fields_unlowered_on_the_native_route (declared 2026-09-21) — the half that was not
// established by gunbc#12033: that the NATIVE route, the emitted compiler
// (claim_executor --v2-native-route, which derives this universe and executes every identity in
// it), lowers variant fields into declared field identities and binds pattern binders from them.
// The claims below are written so the emitted binary itself answers them: each test fn's body
// constructs and matches, so a native execution that lost a binder — the loss this row was
// declared over, "a positional binder was silently lost" — fails here, on the native route.
//
// THE SPECIMEN, VERBATIM FROM THE ROW: "the binder `node` of the `Present { value: node }` arms
// of v2.std.symbol_index symbol_index_candidates_at". The specimen claim calls the real std fn
// (not a mirror) and holds that the candidate it returns CARRIES the bound node — the value the
// arm's binder delivered. A native execution that dropped the binder cannot produce it.
//
// CI ENROLLMENT WAITS ON gunbc.rung_drop v2_native_route_off_the_merge_path: until the
// `emit-build` lane's first green fleet run executes the frontier, this universe is adjudicated
// natively only by the operator-invoked instrument, and the floor executes it interpreted. The
// interpreted floor run and the native adjudicate are two executions of the same claims; the
// native receipt is recorded on the retiring PR.
//
// THE discriminating red is a mutation receipt: with the binder binding
// broken (the arm's binder dropped in v2.std.symbol_index, the #11998 state), the specimen and
// round-trip claims refuse or return false — on the floor before the change, on the native route
// after it.

type Seal = Boxed(Int) | Held { value: Int }

fn seal_unbox(s: Seal) -> Int {
  match s {
    Boxed(v) => v
    Held { value: w } => w
  }
}

// THE POSITIONAL ROUND TRIP THE ROW NAMES: "a positional `A(x)` construction and match round-trip
// field \"0\"". Construction `Boxed(41)` supplies field "0"; the arm pattern's binder receives it;
// the comparison closes the round trip.
test fn vfb_positional_construction_and_match_round_trip_field_zero() -> Bool {
  let s = Boxed(41)
  match s {
    Boxed(v) => v == 41
    Held { value: _ } => false
  }
}

// THE SAME ROUND TRIP THROUGH A CALL: the construction and the match bind in different fns, so the
// value crosses a call boundary as the declared field's inhabitant and comes back as the binder's.
test fn vfb_positional_round_trip_through_a_call_holds() -> Bool {
  seal_unbox(s: Boxed(41)) == 41
}

// THE NAMED SPELLING, ONE FACT TWO WAYS (the row's reason for one frontier over both spellings):
// `Held { value: 7 }` declares-and-supplies `value`; the arm binds it under its name.
test fn vfb_named_construction_and_match_round_trip_holds() -> Bool {
  let s = Held { value: 7 }
  match s {
    Held { value: w } => w == 7
    Boxed(_) => false
  }
}

// THE OTHER ARM STILL ANSWERS: a matched-away arm is a verdict, not a dropped field. A named
// arm whose field binder is a wildcard must not swallow a positional value — the claim holds
// when the match answers with the Boxed arm.
test fn vfb_named_arm_of_a_positional_value_stays_unmatched() -> Bool {
  let s = Boxed(41)
  match s {
    Held { value: _ } => false
    Boxed(_) => true
  }
}

// ---- THE FILED SPECIMEN: the real symbol_index_candidates_at, called for real ----

fn vfb_qn_spine(segments: FreeMonoid<Symbol>) -> Node {
  fold_list_node(
    xs: segments,
    item_node: fn(sym) {
      node_synthetic(
        kind: TypeNode { connective: Atom { identity: sym } },
        children: []
      )
    }
  )
}

fn vfb_module_root(qn_spine: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: qn_spine
      ),
      vfb_type_with_variants(type_sym: ^Mood)
    ]
  )
}

fn vfb_type_with_variants(type_sym: Symbol) -> Edge {
  Edge {
    label: Named { name: type_sym },
    target: node_synthetic(
      kind: TypeNode { connective: Disj },
      children: [
        vfb_variant_arm_edge(variant_sym: ^Yes),
        vfb_variant_arm_edge(variant_sym: ^No)
      ]
    )
  }
}

fn vfb_variant_arm_edge(variant_sym: Symbol) -> Edge {
  Edge {
    label: Named { name: variant_sym },
    target: node_synthetic(
      kind: TypeNode { connective: Atom { identity: variant_sym } },
      children: []
    )
  }
}

data vfb_specimen_module_qn: FreeMonoid<Symbol> = qualified_name_from_dotted_string(
  dotted: "v2.test.variant_field_binding_specimen"
)

data vfb_specimen_root: Node = vfb_module_root(
  qn_spine: vfb_qn_spine(segments: vfb_specimen_module_qn)
)

data vfb_specimen_index: SymbolIndex = symbol_index_fill_module_root(
  index: empty_symbol_index(),
  root: vfb_specimen_root,
  record_declarations: no_record_declarations(), resource_declarations: no_resource_declarations()
)

// THE SPECIMEN OBSERVATION: symbol_index_candidates_at's `Present { value: node }` arm binds
// `node` and the candidate CARRIES it — the declared type's node, at the declared path. If the
// binder were dropped the way #11998 dropped positional binders, the arm cannot hand this back.
test fn vfb_specimen_binder_present_value_node_binds() -> Bool {
  match symbol_index_candidates_at(
    index: vfb_specimen_index,
    position: vfb_specimen_module_qn,
    name: ^Mood
  ) {
    Cons { head: candidate, tail: tail } =>
      (qualified_name_to_dotted_string(qn: candidate.path) == "v2.test.variant_field_binding_specimen.Mood")
        && (match candidate.node.kind {
          TypeNode { connective: Disj } => true
          _ => false
        })
        && is_empty(xs: tail)
    Empty => false
  }
}

// THE BINDER CARRIES THE VARIANT ARM TOO: position inside the type, name = variant — the same
// `Present { value: node }` arm, a different declared field identity ("0" on a variant declared
// positionally is the OTHER arm of the row's one fact; here the variant's node comes back).
test fn vfb_specimen_variant_binder_binds() -> Bool {
  let type_position = qualified_name_snoc(qn: vfb_specimen_module_qn, segment: ^Mood)
  match symbol_index_candidates_at(
    index: vfb_specimen_index,
    position: type_position,
    name: ^Yes
  ) {
    Cons { head: candidate, tail: tail } =>
      (qualified_name_to_dotted_string(qn: candidate.path) == "v2.test.variant_field_binding_specimen.Mood.Yes")
        && (match candidate.node.kind {
          TypeNode { connective: Atom { identity: sym } } => sym == ^Yes
          _ => false
        })
        && is_empty(xs: tail)
    Empty => false
  }
}

// AN ABSENT LOOKUP STAYS ABSENT: the arm that answers Empty is the other edge of the same
// Optional the specimen matches over.
test fn vfb_specimen_unbound_name_yields_no_candidates() -> Bool {
  is_empty(
    xs: symbol_index_candidates_at(
      index: vfb_specimen_index,
      position: vfb_specimen_module_qn,
      name: ^Nowhere
    )
  )
}
