module v2.test.claim.ambient_name_census_standing_witness

// THE AMBIENT-NAME CENSUS REFUSES A MODULE THE WAVE BROKE, NOT A MODULE ALREADY BROKEN. A rewritten module
// the head run reached and refused at resolve is judged against the merge base read by the SAME compiler:
// refused there too means the wave did not break it (printed, passes); resolved there, or not held there at
// all, means the wave did (exit 1, named); a probed module the base run never reported is no observation
// (exit 2). The comparison is `ambient_name_census_standing`'s; the host only gathers the base run.
//
// Every fixture is a pair of OPPOSITES in one claim set: the module the wave broke beside the module that
// was already refused, so a standing that refused everything, or nothing, fails one half.

import std.types { String, Bool, List }
import std.algebra { string_contains }
import std.process { ExitSuccess, ExitFailure }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import gunbc.instruments.ambient_name_census_reading {
  ambient_name_census_standing, ambient_census_probe_modules, ambient_census_fixture_stdout
}

fn healthy_head() -> String {
  "binding_module\thealthy\t1\t0\t0\t0\nbinding_unreached\tbroken_by_wave\tresolve\nbinding_unreached\talready_refused\tresolve\n"
}

fn both_rewritten() -> String {
  "broken_by_wave\tpresent\nalready_refused\tpresent\n"
}

fn standing(base_stdout: String, base_probed: String) -> CliWireResponse {
  ambient_name_census_standing(
    fixture_stdout: ambient_census_fixture_stdout(),
    fixture_status: 0,
    unindexed_status: 2,
    tree_stdout: healthy_head(),
    tree_runs: "",
    rewritten: both_rewritten(),
    base_stdout: base_stdout,
    base_probed: base_probed
  )
}

test fn a_module_the_base_resolved_and_the_head_refuses_exits_one_and_is_named() -> Bool {
  match standing(
    base_stdout: "binding_module\tbroken_by_wave\t1\t0\t0\t0\nbinding_unreached\talready_refused\tresolve\n",
    base_probed: "broken_by_wave\nalready_refused\n"
  ) {
    CliWirePrintable { bytes: bytes, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 1)
        && string_contains(s: reason, pattern: "broken_by_wave")
        && !(string_contains(s: reason, pattern: "already_refused"))
        && string_contains(s: bytes, pattern: "refused_rewritten\tbroken_by_wave\tresolve\tnewly_refused")
        && string_contains(s: bytes, pattern: "refused_rewritten\talready_refused\tresolve\tpreviously_refused")
        && !(string_contains(s: bytes, pattern: "no module newly refused"))
        && string_contains(s: bytes, pattern: "1 module(s) newly refused")
    _ => false
  }
}

test fn touching_only_an_already_refused_module_does_not_refuse() -> Bool {
  match standing(
    base_stdout: "binding_unreached\tbroken_by_wave\tresolve\nbinding_unreached\talready_refused\tresolve\n",
    base_probed: "broken_by_wave\nalready_refused\n"
  ) {
    CliWirePrintable { bytes: bytes, exit: ExitSuccess } =>
      string_contains(s: bytes, pattern: "refused_rewritten\tbroken_by_wave\tresolve\tpreviously_refused")
        && string_contains(s: bytes, pattern: "refused_rewritten\talready_refused\tresolve\tpreviously_refused")
    _ => false
  }
}

test fn a_carried_only_run_exits_zero_and_prints_the_carried_identities_and_count() -> Bool {
  match ambient_name_census_standing(
    fixture_stdout: ambient_census_fixture_stdout(),
    fixture_status: 0,
    unindexed_status: 2,
    tree_stdout: "binding_module\thealthy\t1\t0\t0\t0\nbinding_unreached\talready_refused\tresolve\n",
    tree_runs: "",
    rewritten: "already_refused\tpresent\n",
    base_stdout: "binding_unreached\talready_refused\tresolve\n",
    base_probed: "already_refused\n"
  ) {
    CliWirePrintable { bytes: bytes, exit: ExitSuccess } =>
      string_contains(s: bytes, pattern: "carried_refused\talready_refused")
        && string_contains(s: bytes, pattern: "carried_refused_count\t1")
        && string_contains(s: bytes, pattern: "no module newly refused against the merge base; 1 carried")
    _ => false
  }
}

test fn a_carried_module_that_newly_resolves_leaves_the_carried_set() -> Bool {
  match ambient_name_census_standing(
    fixture_stdout: ambient_census_fixture_stdout(),
    fixture_status: 0,
    unindexed_status: 2,
    tree_stdout: "binding_module\thealthy\t1\t0\t0\t0\nbinding_module\twas_refused\t1\t0\t0\t0\n",
    tree_runs: "",
    rewritten: "was_refused\tpresent\n",
    base_stdout: "binding_unreached\twas_refused\tresolve\n",
    base_probed: "was_refused\n"
  ) {
    CliWirePrintable { bytes: bytes, exit: ExitSuccess } =>
      string_contains(s: bytes, pattern: "carried_refused_count\t0")
        && !(string_contains(s: bytes, pattern: "carried_refused\twas_refused"))
    _ => false
  }
}

test fn a_refused_module_the_base_does_not_hold_is_newly_refused() -> Bool {
  match standing(
    base_stdout: "binding_unreached\talready_refused\tresolve\n",
    base_probed: "already_refused\n"
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 1) && string_contains(s: reason, pattern: "broken_by_wave")
    _ => false
  }
}

test fn a_probed_module_the_base_run_never_reported_is_no_observation() -> Bool {
  match standing(
    base_stdout: "binding_unreached\talready_refused\tresolve\n",
    base_probed: "broken_by_wave\nalready_refused\n"
  ) {
    CliWirePrintable { bytes: bytes, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 2)
        && string_contains(s: reason, pattern: "merge-base probe did not observe")
        && string_contains(s: bytes, pattern: "refused_rewritten\tbroken_by_wave\tresolve\tbase_unread")
    _ => false
  }
}

test fn a_finding_outranks_an_unread_base_module() -> Bool {
  match ambient_name_census_standing(
    fixture_stdout: ambient_census_fixture_stdout(),
    fixture_status: 0,
    unindexed_status: 2,
    tree_stdout: healthy_head(),
    tree_runs: "",
    rewritten: both_rewritten(),
    base_stdout: "binding_module\tbroken_by_wave\t1\t0\t0\t0\n",
    base_probed: "broken_by_wave\nalready_refused\n"
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: _ } } => code == 1
    _ => false
  }
}

test fn the_probe_list_is_exactly_the_head_refused_rewritten_modules() -> Bool {
  ambient_census_probe_modules(tree_stdout: healthy_head(), rewritten: both_rewritten() + "healthy\tpresent\n")
    == ["broken_by_wave", "already_refused"]
}

fn standing_over(tree_stdout: String) -> CliWireResponse {
  ambient_name_census_standing(
    fixture_stdout: ambient_census_fixture_stdout(),
    fixture_status: 0,
    unindexed_status: 2,
    tree_stdout: tree_stdout,
    tree_runs: "",
    rewritten: both_rewritten(),
    base_stdout: "binding_unreached\tbroken_by_wave\tresolve\nbinding_unreached\talready_refused\tresolve\n",
    base_probed: "broken_by_wave\nalready_refused\n"
  )
}

test fn an_unrecognised_binding_row_is_printed_and_refused_not_dropped() -> Bool {
  match standing_over(tree_stdout: healthy_head() + "binding_mystery_kind\tx\t1\n") {
    CliWirePrintable { bytes: bytes, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 1)
        && string_contains(s: reason, pattern: "unrecognised row control")
        && string_contains(s: reason, pattern: "binding_mystery_kind")
        && string_contains(s: bytes, pattern: "unrecognised_binding_row\tbinding_mystery_kind\tx\t1")
    _ => false
  }
}

test fn a_binding_refusal_cause_row_is_a_known_kind_and_is_printed() -> Bool {
  match standing_over(tree_stdout: healthy_head() + "binding_refusal_cause\tbroken_by_wave\town\tunresolved\t3:4\n") {
    CliWirePrintable { bytes: bytes, exit: ExitSuccess } =>
      string_contains(s: bytes, pattern: "binding_refusal_cause\tbroken_by_wave\town\tunresolved\t3:4")
    _ => false
  }
}

fn standing_with_causes(causes: String) -> CliWireResponse {
  ambient_name_census_standing(
    fixture_stdout: ambient_census_fixture_stdout(),
    fixture_status: 0,
    unindexed_status: 2,
    tree_stdout: healthy_head() + causes,
    tree_runs: "",
    rewritten: both_rewritten(),
    base_stdout: "binding_module\tbroken_by_wave\t1\t0\t0\t0\nbinding_unreached\talready_refused\tresolve\n",
    base_probed: "broken_by_wave\nalready_refused\n"
  )
}

test fn a_newly_refused_module_whose_every_cause_cascades_from_a_carried_declarer_is_listed_counted_and_exits_zero() -> Bool {
  match standing_with_causes(causes: "binding_refusal_cause\tbroken_by_wave\town\tresolve_reason_declarer_refused\t3:4\talready_refused\nbinding_refusal_cause\talready_refused\town\tresolve_reason_unbound_symbol\t9:1\t-\n") {
    CliWirePrintable { bytes: bytes, exit: ExitSuccess } =>
      string_contains(s: bytes, pattern: "refused_rewritten\tbroken_by_wave\tresolve\trefused_by_carried_dependency")
        && string_contains(s: bytes, pattern: "refused_by_carried_dependency_count\t1")
        && string_contains(s: bytes, pattern: "carried_refused_count\t1")
    _ => false
  }
}

test fn a_newly_refused_module_with_an_own_non_cascade_cause_still_exits_one() -> Bool {
  match standing_with_causes(causes: "binding_refusal_cause\tbroken_by_wave\town\tresolve_reason_unbound_symbol\t3:4\t-\n") {
    CliWirePrintable { bytes: bytes, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 1)
        && string_contains(s: reason, pattern: "broken_by_wave")
        && string_contains(s: bytes, pattern: "refused_rewritten\tbroken_by_wave\tresolve\tnewly_refused")
        && string_contains(s: bytes, pattern: "refused_by_carried_dependency_count\t0")
    _ => false
  }
}

test fn a_cascade_from_a_declarer_outside_the_carried_set_still_exits_one() -> Bool {
  match standing_with_causes(causes: "binding_refusal_cause\tbroken_by_wave\town\tresolve_reason_declarer_refused\t3:4\tsome.other_module\n") {
    CliWirePrintable { bytes: bytes, exit: ExitFailure { code: code, reason: _ } } =>
      (code == 1) && string_contains(s: bytes, pattern: "refused_rewritten\tbroken_by_wave\tresolve\tnewly_refused")
    _ => false
  }
}

test fn a_newly_refused_module_with_no_cause_row_is_not_a_cascade_and_exits_one() -> Bool {
  match standing_with_causes(causes: "") {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: _ } } => code == 1
    _ => false
  }
}

test fn a_cascade_with_one_unexplained_cause_among_cascade_causes_still_exits_one() -> Bool {
  match standing_with_causes(causes: "binding_refusal_cause\tbroken_by_wave\town\tresolve_reason_declarer_refused\t3:4\talready_refused\nbinding_refusal_cause\tbroken_by_wave\timport_target_file_refused\tresolve_module_not_found\t1:1\t-\n") {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: _ } } => code == 1
    _ => false
  }
}

fn outside_declarer_cause() -> String {
  "binding_refusal_cause\tbroken_by_wave\town\tresolve_reason_declarer_refused\t3:4\text.declarer\nbinding_refusal_cause\text.declarer\town\tresolve_reason_declarer_refused\t9:1\text.root\n"
}

fn standing_with_declarer(base_stdout: String, base_probed: String) -> CliWireResponse {
  ambient_name_census_standing(
    fixture_stdout: ambient_census_fixture_stdout(),
    fixture_status: 0,
    unindexed_status: 2,
    tree_stdout: healthy_head() + outside_declarer_cause(),
    tree_runs: "",
    rewritten: both_rewritten(),
    base_stdout: base_stdout,
    base_probed: base_probed
  )
}

test fn a_declarer_observed_refused_at_head_and_base_with_the_same_cause_class_carries_the_cascade() -> Bool {
  match standing_with_declarer(
    base_stdout: "binding_module\tbroken_by_wave\t1\t0\t0\t0\nbinding_unreached\talready_refused\tresolve\nbinding_unreached\text.declarer\tresolve\nbinding_refusal_cause\text.declarer\town\tresolve_reason_declarer_refused\t9:1\text.root\n",
    base_probed: "broken_by_wave\nalready_refused\next.declarer\n"
  ) {
    CliWirePrintable { bytes: bytes, exit: ExitSuccess } =>
      string_contains(s: bytes, pattern: "refused_rewritten\tbroken_by_wave\tresolve\trefused_by_carried_dependency")
    _ => false
  }
}

test fn a_declarer_refused_at_head_but_resolved_at_base_does_not_carry_and_exits_one() -> Bool {
  match standing_with_declarer(
    base_stdout: "binding_module\tbroken_by_wave\t1\t0\t0\t0\nbinding_unreached\talready_refused\tresolve\nbinding_module\text.declarer\t1\t0\t0\t0\n",
    base_probed: "broken_by_wave\nalready_refused\next.declarer\n"
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: _ } } => code == 1
    _ => false
  }
}

test fn a_declarer_the_base_probe_did_not_observe_never_carries_and_exits_one() -> Bool {
  match standing_with_declarer(
    base_stdout: "binding_module\tbroken_by_wave\t1\t0\t0\t0\nbinding_unreached\talready_refused\tresolve\nbinding_unreached\text.declarer\tresolve\nbinding_refusal_cause\text.declarer\town\tresolve_reason_declarer_refused\t9:1\text.root\n",
    base_probed: "broken_by_wave\nalready_refused\n"
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: _ } } => code == 1
    _ => false
  }
}

test fn a_declarer_refused_at_base_for_a_different_cause_class_does_not_carry() -> Bool {
  match standing_with_declarer(
    base_stdout: "binding_module\tbroken_by_wave\t1\t0\t0\t0\nbinding_unreached\talready_refused\tresolve\nbinding_unreached\text.declarer\tresolve\nbinding_refusal_cause\text.declarer\town\tresolve_reason_unbound_symbol\t9:1\t-\n",
    base_probed: "broken_by_wave\nalready_refused\next.declarer\n"
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: _ } } => code == 1
    _ => false
  }
}

test fn the_probe_list_adds_the_named_declarers_one_hop_and_not_their_declarers() -> Bool {
  ambient_census_probe_modules(tree_stdout: healthy_head() + outside_declarer_cause(), rewritten: both_rewritten())
    == ["broken_by_wave", "already_refused", "ext.declarer"]
}
