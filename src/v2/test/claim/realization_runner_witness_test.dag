module v2.test.claim.realization_runner_witness

import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.dependency { DataDependsOn, DependencyView }
import v2.std.node { Atom, Node, TypeNode }
import v2.workflow.executor {
  ExecutorBatch,
  ExecutorJob,
  executor_job_for_node
}
import v2.workflow.realization_runner {
  RunnerDispatchBlocked,
  RunnerDispatchOk,
  RunnerScheduleBlocked,
  RunnerScheduleComplete,
  node_keyed_store_empty,
  node_keyed_store_has_node,
  node_keyed_store_put,
  runner_dispatch_batch,
  runner_ordering_only,
  runner_schedule_plan_from_dependencies,
  runner_schedule_store_covers_nodes,
  runner_walk_batches
}

data runner_test_a_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^runner_test_a } },
  children: []
}

data runner_test_b_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^runner_test_b } },
  children: []
}

data runner_test_a_to_b: DependencyView = DependencyView {
  source: runner_test_a_node,
  dependent: runner_test_b_node,
  kind: DataDependsOn,
  usage_site: runner_test_b_node
}

data runner_test_nodes: List<Node> = [runner_test_a_node, runner_test_b_node]

data runner_test_dependencies: List<DependencyView> = [runner_test_a_to_b]

data runner_test_first_batch: ExecutorBatch = ExecutorBatch {
  jobs: [executor_job_for_node(node: runner_test_a_node)]
}

data runner_test_second_batch: ExecutorBatch = ExecutorBatch {
  jobs: [executor_job_for_node(node: runner_test_b_node)]
}

data runner_test_batches: List<ExecutorBatch> = [
  runner_test_first_batch,
  runner_test_second_batch
]

fn witness_node_keyed_store_put_and_has() -> Bool {
  let store = node_keyed_store_put(
    store: node_keyed_store_empty(),
    node: runner_test_a_node,
    value: runner_ordering_only
  )
  node_keyed_store_has_node(store: store, node: runner_test_a_node)
    && !node_keyed_store_has_node(store: store, node: runner_test_b_node)
}

fn witness_runner_walk_populates_store_in_dependency_order() -> Bool {
  match runner_walk_batches(
    batches: runner_test_batches,
    dependencies: runner_test_dependencies,
    store: node_keyed_store_empty(),
    value: runner_ordering_only
  ) {
    RunnerDispatchOk { store: store } =>
      node_keyed_store_has_node(store: store, node: runner_test_a_node)
        && node_keyed_store_has_node(store: store, node: runner_test_b_node)
    RunnerDispatchBlocked { evidence: _ } => false
  }
}

fn witness_runner_schedule_matches_executor_batches() -> Bool {
  match runner_schedule_plan_from_dependencies(
    nodes: runner_test_nodes,
    dependencies: runner_test_dependencies,
    value: runner_ordering_only
  ) {
    RunnerScheduleComplete { batches: batches, store: store } =>
      (length(xs: batches) == 2)
        && runner_schedule_store_covers_nodes(store: store, nodes: runner_test_nodes)
    RunnerScheduleBlocked { evidence: _ } => false
  }
}

fn witness_runner_blocks_when_prerequisite_missing() -> Bool {
  let batch = ExecutorBatch {
    jobs: [executor_job_for_node(node: runner_test_b_node)]
  }
  match runner_dispatch_batch(
    batch: batch,
    dependencies: runner_test_dependencies,
    store: node_keyed_store_empty(),
    value: runner_ordering_only
  ) {
    RunnerDispatchBlocked { evidence: _ } => true
    RunnerDispatchOk { store: _ } => false
  }
}

test fn realization_runner_witnesses() -> Bool {
  witness_node_keyed_store_put_and_has()
    && witness_runner_walk_populates_store_in_dependency_order()
    && witness_runner_schedule_matches_executor_batches()
    && witness_runner_blocks_when_prerequisite_missing()
}
