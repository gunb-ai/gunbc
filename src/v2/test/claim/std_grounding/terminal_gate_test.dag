module v2.test.std_grounding.terminal_gate

import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.collection { List }
import v2.std.machine { Byte }
import v2.std.diagnostic { Accepted, None }
import v2.std.witness { Holds }
import v2.std.host_run {
  BuildLog,
  EmitHostRunReceipt,
  ExitOk,
  HostExit,
  HostLogicalRun,
  HostRunStdout
}
import v2.std.verdict { verdict_tally_empty }
import v2.std.grounding {
  AuthoringTimeVerdictSurface,
  HostVerdictSurfaceExecutionStatus,
  PerTargetTestClaimReceipt,
  RuntimeVerdicts,
  host_verdict_surface_runtime_authoritative
}
import v2.extdeps.languages.rust { rust_mvp1_target_model }

import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
fn terminal_gate_empty_bytes() -> List<Byte> {
  []
}

fn terminal_gate_receipt(status: HostVerdictSurfaceExecutionStatus) -> PerTargetTestClaimReceipt {
  PerTargetTestClaimReceipt {
    host_run: EmitHostRunReceipt {
      target: rust_mvp1_target_model(),
      source_text: "",
      exit: HostExit {
        outcome: Accepted { value: Holds { value: ExitOk { code: 0 } }, diagnostics: None }
      },
      logical_run: Accepted {
        value: HostLogicalRun { stdout: HostRunStdout { bytes: terminal_gate_empty_bytes() } },
        diagnostics: None
      },
      stderr_bytes: terminal_gate_empty_bytes(),
      build_log: BuildLog { lines: [] }
    },
    execution_status: status,
    verdict_tally: verdict_tally_empty
  }
}

test fn witness_grounding_terminal_gate_runtime_authoritative_discriminates() -> Bool {
  host_verdict_surface_runtime_authoritative(receipt: terminal_gate_receipt(status: RuntimeVerdicts))
    && (host_verdict_surface_runtime_authoritative(
      receipt: terminal_gate_receipt(status: AuthoringTimeVerdictSurface)
    ) == false)
}
