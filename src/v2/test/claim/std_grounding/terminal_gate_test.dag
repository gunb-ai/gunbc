module v2.test.std_grounding.terminal_gate



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
fn terminal_gate_empty_bytes() -> List<std.bit.Byte> {
  []
}

fn terminal_gate_receipt(status: v2.std.grounding.HostVerdictSurfaceExecutionStatus) -> v2.std.grounding.PerTargetTestClaimReceipt {
  v2.std.grounding.PerTargetTestClaimReceipt {
    host_run: v2.std.host_run.EmitHostRunReceipt {
      target: rust_target_model(),
      source_text: "",
      exit: v2.std.host_run.HostExit {
        outcome: v2.std.diagnostic.Accepted { value: v2.std.witness.Holds { value: v2.std.host_run.ExitOk { code: 0 } }, diagnostics: v2.std.diagnostic.None }
      },
      logical_run: v2.std.diagnostic.Accepted {
        value: v2.std.host_run.HostLogicalRun { stdout: v2.std.host_run.HostRunStdout { bytes: terminal_gate_empty_bytes() } },
        diagnostics: v2.std.diagnostic.None
      },
      stderr_bytes: terminal_gate_empty_bytes(),
      build_log: v2.std.host_run.BuildLog { lines: [] },
      compile_skipped: false
    },
    execution_status: status,
    verdict_tally: v2.std.verdict.verdict_tally_empty
  }
}

test fn witness_grounding_terminal_gate_runtime_authoritative_discriminates() -> v2.std.logic.Bool {
  host_verdict_surface_runtime_authoritative(receipt: terminal_gate_receipt(status: RuntimeVerdicts))
    && (host_verdict_surface_runtime_authoritative(
      receipt: terminal_gate_receipt(status: AuthoringTimeVerdictSurface)
    ) == false)
}
