module v2.test.claim.build_transport_admission_witness



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data build_transport_admission_witness_note: String = "Discriminating witnesses for the P-B build-transport admission decision (v2.compiler.build_transport_admission). A well-formed build transport (workspace-relative emitted files, a declared host toolchain, a workspace-produced run program) is Permit; a transport whose workspace file escapes its subtree (a `..` path or an absolute path) is a located std.access.Deny, never widened (DESIGN 5). The refusal arm is the RED control: if the escape projection or admit_effect check were dropped, admits_escaping_write would flip. The projection helper is exercised directly so the containment boundary is pinned independent of the fold. Containment is SEGMENT-decomposed (review 39707): a `..` PATH SEGMENT escapes, but a bare `..` substring inside a filename (foo..bar) does not -- pinned by build_transport_admits_dotdot_substring. Build/run reads cover the invocation ARGS too (review 39684): a WorkspacePath/ProducedArtifact arg that escapes is refused -- pinned by build_transport_refuses_escaping_arg."

test fn emit_host_access_decision_seed_transport_is_declared_scaffold() -> Bool {
  match v2.compiler.emit_host.emit_host_access_decision_seed_transport_scaffold {
    Scaffold { dissolves_to: _, bind: bind } =>
      bind.module_path == "v1_compiler.v1_interpreter"
        && bind.decl_name == "require_permitted_transport"
        && string_contains(
          s: emit_host_access_decision_seed_transport_receipt,
          pattern: "permit_arm_from_another_carrier_refuses",
        )
        && string_contains(
          s: std.dissolution.dissolution_description(condition: emit_host_access_decision_seed_transport_dissolve_trigger),
          pattern: "v1-zero-hand-maintained-rust",
        )
        && string_contains(
          s: std.dissolution.dissolution_description(condition: emit_host_access_decision_seed_transport_dissolve_trigger),
          pattern: "DISSOLVES WHEN",
        )
    _ => false
  }
}

fn well_formed_build() -> v2.std.host_transport.ProcessInvocation {
  v2.std.host_transport.ProcessInvocation {
    program: v2.std.host_transport.HostToolProgram { executable: "cc" },
    args: []
  }
}

fn well_formed_run() -> v2.std.host_transport.ProcessInvocation {
  v2.std.host_transport.ProcessInvocation {
    program: v2.std.host_transport.ProducedProgram { path: "fixture" },
    args: []
  }
}

data emitted: v2.std.host_transport.WorkspaceContent = EmittedSource

fn transport_with_workspace_path(p: String) -> v2.std.host_transport.HostTransportDescriptor {
  v2.std.host_transport.HostTransportDescriptor {
    identity: ^build_transport_admission_sample,
    workspace: [v2.std.host_transport.WorkspaceFile { path: p, content: emitted }],
    build: [well_formed_build()],
    run: well_formed_run(),
    runtime_value_codec: SignedI32Le
  }
}

data well_formed_transport: v2.std.host_transport.HostTransportDescriptor = transport_with_workspace_path(p: "fixture.c")
data escaping_transport: v2.std.host_transport.HostTransportDescriptor = transport_with_workspace_path(p: "../etc/passwd")
data absolute_transport: v2.std.host_transport.HostTransportDescriptor = transport_with_workspace_path(p: "/etc/passwd")
data dotdot_substring_transport: v2.std.host_transport.HostTransportDescriptor = transport_with_workspace_path(p: "foo..bar")

fn build_with_arg(a: v2.std.host_transport.InvocationArg) -> v2.std.host_transport.ProcessInvocation {
  v2.std.host_transport.ProcessInvocation {
    program: v2.std.host_transport.HostToolProgram { executable: "cc" },
    args: [a]
  }
}

fn transport_with_build(b: v2.std.host_transport.ProcessInvocation) -> v2.std.host_transport.HostTransportDescriptor {
  v2.std.host_transport.HostTransportDescriptor {
    identity: ^build_transport_admission_sample,
    workspace: [v2.std.host_transport.WorkspaceFile { path: "fixture.c", content: emitted }],
    build: [b],
    run: well_formed_run(),
    runtime_value_codec: SignedI32Le
  }
}

data escaping_arg_transport: v2.std.host_transport.HostTransportDescriptor = transport_with_build(
  b: build_with_arg(a: v2.std.host_transport.WorkspacePath { path: "../escape" })
)
data contained_arg_transport: v2.std.host_transport.HostTransportDescriptor = transport_with_build(
  b: build_with_arg(a: v2.std.host_transport.WorkspacePath { path: "fixture.c" })
)

fn is_admitted(a: std.access.AccessDecision) -> Bool {
  match a {
    Permit => true
    Deny { refusal: refusal } => false
  }
}

fn is_refused(a: std.access.AccessDecision) -> Bool {
  match a {
    Permit => false
    Deny { refusal: refusal } => true
  }
}

test fn build_transport_admits_well_formed() -> Bool {
  v2.test.claim.build_transport_admission_witness.is_admitted(a: build_transport_admissible(transport: well_formed_transport))
}

test fn build_transport_refuses_escaping_write() -> Bool {
  v2.test.claim.build_transport_admission_witness.is_refused(a: build_transport_admissible(transport: escaping_transport))
}

test fn build_transport_refuses_absolute_write() -> Bool {
  v2.test.claim.build_transport_admission_witness.is_refused(a: build_transport_admissible(transport: absolute_transport))
}

test fn build_transport_refusal_is_located() -> Bool {
  match build_transport_admissible(transport: escaping_transport) {
    Deny { refusal: refusal } =>
      refusal.location.profile == "EffectRequest"
        && refusal.location.action == "write"
        && refusal.location.object == "../etc/passwd"
    Permit => false
  }
}

test fn build_transport_admits_dotdot_substring() -> Bool {
  v2.test.claim.build_transport_admission_witness.is_admitted(a: build_transport_admissible(transport: dotdot_substring_transport))
    && rel_path_is_workspace_contained(p: "foo..bar")
    && !rel_path_is_workspace_contained(p: "../escape")
    && !rel_path_is_workspace_contained(p: "a/../b")
    && !rel_path_is_workspace_contained(p: "a/..")
}

test fn build_transport_refuses_escaping_arg() -> Bool {
  v2.test.claim.build_transport_admission_witness.is_refused(a: build_transport_admissible(transport: escaping_arg_transport))
    && v2.test.claim.build_transport_admission_witness.is_admitted(a: build_transport_admissible(transport: contained_arg_transport))
}

test fn build_transport_projection_boundary() -> Bool {
  std.effect_grant.position_under(
    target: build_transport_rel_position(rel: "src/lib.rs"),
    root: std.effect_grant.NamespacePosition { tree: FilesystemPathTree, path: ["workspace"] }
  )
    && !std.effect_grant.position_under(
         target: build_transport_rel_position(rel: "../escape"),
         root: std.effect_grant.NamespacePosition { tree: FilesystemPathTree, path: ["workspace"] }
       )
}
