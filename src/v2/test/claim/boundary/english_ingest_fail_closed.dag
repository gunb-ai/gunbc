module v2.test.boundary.english_ingest_fail_closed

fn atom_node(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

data arbitrary_english_prose_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^english_boundary_field },
      target: v2.test.boundary.english_ingest_fail_closed.atom_node(s: ^english_ingest_boundary_symbol)
    },
    v2.std.node.Edge {
      label: Named { name: ^english_payload_field },
      target: v2.test.boundary.english_ingest_fail_closed.atom_node(s: ^english_arbitrary_prose_symbol)
    },
  ],
  occurrence_id: SyntheticOccurrence
}

data english_shape_b_docs_input: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^english_typed_value_field },
      target: v2.test.boundary.english_ingest_fail_closed.atom_node(s: ^english_typed_value_symbol)
    },
    v2.std.node.Edge {
      label: Named { name: ^english_walker_field },
      target: v2.test.boundary.english_ingest_fail_closed.atom_node(s: ^english_doc_walker_symbol)
    },
  ],
  occurrence_id: SyntheticOccurrence
}

data english_shape_b_docs_output: Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [
    v2.std.node.Edge {
      label: Named { name: ^english_typed_value_field },
      target: v2.test.boundary.english_ingest_fail_closed.atom_node(s: ^english_typed_value_symbol)
    },
    v2.std.node.Edge {
      label: Named { name: ^english_output_field },
      target: v2.test.boundary.english_ingest_fail_closed.atom_node(s: ^english_prose_output_symbol)
    },
  ],
  occurrence_id: SyntheticOccurrence
}

data test_english_prose_ingest_is_diagnostic: v2.std.verification.TestClaim = v2.std.verification.DiagnosticClaim {
  label: "english prose ingest rejects outside the lossless core",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: arbitrary_english_prose_input,
  expected_rejection: diagnostics_singleton(
      d: v2.std.diagnostic.Diagnostic {
        reason: ^english_ingest_not_in_lossless_core_reason,
        at: node_locus(node: arbitrary_english_prose_input),
        correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
      }
    ),
  classification: v2.std.verification.TestClassification { tier: Tier3, layer: Boundary }
}

data test_english_emit_is_shapeB_docs: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "english prose output is shape-b docs over typed values",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: english_shape_b_docs_input,
  expected_value: english_shape_b_docs_output,
  classification: v2.std.verification.TestClassification { tier: Tier3, layer: Boundary }
}
