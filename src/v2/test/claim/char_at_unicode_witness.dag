module v2.test.claim.char_at_unicode_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.host_text { char_at, string_length }
import std.optional { Absent, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// CHARAT-0 discriminating control: char_at indexes Unicode code points, not UTF-8 bytes. A
// byte-offset implementation returns the wrong character at index 1 on "aéb" (continuation byte
// U+00A9 misread as ©) while code-point indexing returns U+00E9.
//
// WHAT THIS SWITCHES, AND WHAT IT DOES NOT BUY (2026-11-01, valiant-deer-27 on tidy-ant-251's F5
// ruling; scope corrected 2026-11-04 after review 90474, which caught the earlier wording claiming
// more than the claims measure). The switch is at the CHECKER: `char_at` here names std.host_text's
// declaration by import (result std.optional Optional of the one-code-point host text, position a
// std.nat Nat), not the ambient builtin the rest of the corpus still calls, and the module only
// TYPE-CHECKS against that declaration -- an ambient String result refuses in the helper's `HostText?`
// parameter, which is the executed half of this claim. Absence becomes an arm to match rather than a
// value to compare against (the old last arm asserted the sentinel: src/v1/runtime_rust.dag answered an
// empty host text at or past the end and clamped a negative position to 0 --
// gunbc.recurring_failure_mode `absence_carried_by_a_second_representation` in its plainest form); the
// file now asserts Absent, and every other assertion keeps its meaning.
//
// WHAT IS NOT ESTABLISHED HERE, STATED PLAINLY: these claims do NOT show that the declared operation
// EXECUTES. The interpreter still answers a free call's VALUE by SPELLING -- the `free_call.char_at` arm
// of gunbc.v1.v1_interpreter_primitive_surface, keyed by the primitive spelling (see the block above
// `char_at_past_the_multibyte_char_is_not_a_byte_offset`, and
// gunbc.recurring_failure_mode `host_seam_realization_is_keyed_by_primitive_spelling`) -- so the value
// that reaches `at_is` is the ambient builtin's bare host text while the checker typed the call
// `HostText?`. The green claims therefore measure the AMBIENT REALIZATION behind a declared name: one
// name, two meanings on one route (DESIGN section 3, a witness discriminates at one interface -- this one
// discriminates the checking interface only). `std.host_text`'s `char_at` still has NO executing
// consumer, which is a frontier this PR states rather than closes; step 2 of the egress (resolved-target
// dispatch, src/v1/04_lookup.dag `resolved_declaration_call_target`) is what makes these claims read the
// declared operation's value, and it is claimed as that PR's target, not this one's.
//
// The samples are host texts by construction: a literal denotes HostText, so no argument reaches
// char_at's HostText parameter through an undeclared crossing (DESIGN section 4: text crossings go
// through the declared unfold, and this file takes none -- it names the carrier directly). The code-point
// count is taken the same way, through the declared unfold `chars` and std.algebra's length.

fn ae_b_text() -> HostText {
  "a\u{e9}b"
}

fn ab_e_c_text() -> HostText {
  "ab\u{e9}c"
}

// One read, one answer, matched: present means the value is the text we expect, absent fails.
fn at_is(read: HostText?, want: HostText) -> Bool {
  match read {
    Absent => false
    Present { value: v } => v == want
  }
}

test fn char_at_indexes_code_points_on_multibyte_text() -> Bool {
  let s = ae_b_text()
  at_is(read: char_at(text: s, pos: 0), want: "a")
    && at_code_point(read: char_at(text: s, pos: 1), want: 233)
    && at_is(read: char_at(text: s, pos: 2), want: "b")
}

test fn char_at_byte_offset_would_mismatch_at_index_one() -> Bool {
  let s = ae_b_text()
  at_code_point(read: char_at(text: s, pos: 1), want: 233)
    && !at_is(read: char_at(text: s, pos: 1), want: "\u{a9}")
}

// The count arm #15507 added, kept under its name and now read through the DECLARATION: #15507 declared
// std.host_text string_length, so this call binds that declaration instead of the ambient builtin, and the
// arm states the same code-point fact without routing through a name this PR does not claim.
test fn string_length_counts_code_points_not_bytes() -> Bool {
  string_length(text: ae_b_text()) == 3
}

// STRING-INDEX-0 discriminating control for the prefix-bounded ASCII fast path. char_at/substring
// no longer rescan the whole string for ASCII-ness; they test only the bytes up to the requested
// position, so a string whose ASCII PREFIX is followed by a multibyte char now takes the
// byte-indexed path for positions inside that prefix and the code-point path beyond it. On "ab" +
// U+00E9 + "c" (5 bytes, 4 code points) a byte-offset implementation returns U+00A9 at index 3 and
// "c" at index 4; code-point indexing returns "c" at index 3 and Absent at index 4. These two
// claims cover char_at only: substring takes the same prefix-bounded fast path, but removing its
// prefix check left every witness green, so no discriminating control for it is asserted here
// rather than one that has never been seen to fail.

test fn char_at_agrees_across_the_ascii_prefix_boundary() -> Bool {
  let s = ab_e_c_text()
  at_is(read: char_at(text: s, pos: 0), want: "a")
    && at_is(read: char_at(text: s, pos: 1), want: "b")
    && at_code_point(read: char_at(text: s, pos: 2), want: 233)
    && at_is(read: char_at(text: s, pos: 3), want: "c")
}

// BYTE OFFSET, NOT CODE-POINT OFFSET. "ab" then U+00E9 then "c" has four code points, so index 3 is
// "c" and never U+00A9 -- the second byte of the two-byte encoding read back as its own character.
// This is the arm that carried the empty-text sentinel before the switch: a realization answering with
// a fragment, with the empty text, or with anything at all past the end refuses here.
//
// THE OUT-OF-RANGE ASSERTION IS HELD BACK FROM THIS PR ON PURPOSE, AND ITS TEXT IS THIS:
//     && at_absent(read: char_at(text: s, pos: 4))
// where at_absent matches Absent and refuses Present. It is red at this head for a ROUTE reason, not a
// contract reason. Measured at 956dc433116f: the checker binds this call to std.host_text's declaration
// (the module only type-checks because the result is Optional<HostText> -- an ambient String result
// refuses in the helper's HostText? parameter), while the interpreter answers the call's VALUE by
// SPELLING, through the free_call.char_at arm of gunbc.v1.v1_interpreter_primitive_surface keyed by its
// authored spelling in a flat, name-merged item registry, so position 4 comes back as the ambient
// builtin's empty text. A red claim landing on main is a main red, not a stamp, so the assertion joins
// the PR that makes a free call evaluate by its RESOLVED declaration target, where it is that PR's
// discriminating pair: red without resolved-target dispatch, green with it. The fork itself is
// receipted in gunbc.recurring_failure_mode.host_seam_realization_is_keyed_by_primitive_spelling, and
// the withheld assertion is named in the std.host_text char_at disposition row's next field. Today's wrong
// answer is not left unmeasured: the claim the_out_of_range_read_is_a_present_until_resolved_target_dispatch_lands
// below EXECUTES that read and asserts it, so the defect is a control that turns itself red when fixed.
test fn char_at_past_the_multibyte_char_is_not_a_byte_offset() -> Bool {
  let s = ab_e_c_text()
  !at_is(read: char_at(text: s, pos: 3), want: "\u{a9}")
}

// THE EXECUTED PROBE OF THE DEFECT THAT IS STILL OPEN (DESIGN 4b's expected-red, in the one form that can
// land green today). This claim runs the out-of-range read and asserts today's WRONG answer -- a Present
// rather than an Absent -- because on this route the interpreter still answers the call's VALUE by
// SPELLING (the free_call.char_at arm of gunbc.v1.v1_interpreter_primitive_surface) while the checker
// bound std.host_text's declaration. It is a control, not an endorsement of the sentinel: the moment a
// free call dispatches by its RESOLVED declaration target (src/v1/04_lookup.dag
// resolved_declaration_call_target) the read answers Absent, THIS claim goes red, and it is replaced by
// the Absent assertion quoted at the arm above -- which is that change's discriminating pair. Nothing has
// to be remembered, because the probe cannot survive the fix it documents.
test fn the_out_of_range_read_is_a_present_until_resolved_target_dispatch_lands() -> Bool {
  let s = ab_e_c_text()
  !at_absent(read: char_at(text: s, pos: 4))
}

// Absence is a typed arm, not a value: the read that found nothing has no value to compare.
fn at_absent(read: HostText?) -> Bool {
  match read {
    Absent => true
    Present { value: _ } => false
  }
}

// Present, and its single code point is the scalar we asked for: the multibyte control, one scalar
// per character, never one byte.
fn at_code_point(read: HostText?, want: Int) -> Bool {
  match read {
    Absent => false
    Present { value: v } => code_point(c: v) == want
  }
}
