module v2.test.claim.fold_lowering

// NO IMPORT BLOCK, AND THAT IS LOAD-BEARING RATHER THAN AN OMISSION.
//
// This module is the merge of the one-claim unit entry that already lived here
// and the end-to-end entry that lived under src/v2/test/claim/long/ -- one
// subject, one witness module (DESIGN.md §3). The long entry resolved every
// name it used from the ambient witness pool and carried no imports; this file
// carried two. Measured 2026-08-21: with those two import rows present, every
// end-to-end claim fails with `no such function: tokenize` -- an explicit
// import block replaces the ambient pool rather than adding to it. The rows
// were removed, not relocated, because `fold_family_head` and `Bool` resolve
// from that same pool and the one claim that used them still passes.
test fn fold_family_head_recognizes_fold_variants() -> Bool {
  fold_family_head(sym: ^fold)
    && fold_family_head(sym: ^fold_list)
    && fold_family_head(sym: ^fold_list_right)
    && fold_family_head(sym: ^fold_node)
    && !fold_family_head(sym: ^map)
    && !fold_family_head(sym: ^g)
}

data fold_lowering_witness_note: String = "Grounds the un-forked fold->Loop desugaring (v2.compiler.fold_lowering) by execution on REAL source, end-to-end through the census ingest (tokenize -> parse_module). A surface fold parses as an ordinary call; after the StampLexeme grammar fix its callee carries its NAME (^fold) as an atom identity and the collection likewise (^xs) — the survival sub-facts are the RED control that a grammar regression (head stamped as the token class) breaks. The located fold-call subtree (the first primary_expr capture — the outermost fn-body expression) desugars to the canonical seam Loop, and the kept loop_multiplicity derives PROVEN termination from the fold-iteration measure — the same real derivation the foundation's loop witnesses use, now reached from a real parsed fold call rather than a hand-built loop. Two fail-closed red controls: a non-fold call (head ^g) refuses (never desugars a foreign call), and a fold call carrying no fn-literal iteration body refuses (never fabricates a loop). This is the desugaring the whole-tree body producer will run on every located fold call once corpus walking is affordable; the shape it emits is exactly what the accumulator-copy rule (M3) will key on."

data fold_snippet: String = "module fold_probe\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn(acc, x) { acc })\n}\n"

data non_fold_snippet: String = "module g_probe\n\nfn f(xs: List<Int>) -> Int {\n  g(xs, f: fn(acc, x) { acc })\n}\n"

data bodyless_fold_snippet: String = "module bodyless_probe\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0)\n}\n"

data named_step_fold_snippet: String = "module named_step_probe\n\nfn f(xs: List<Int>) -> Int {\n  fold_list(xs, empty: 0, cons: cons)\n}\n"

data algebra_fold_snippet: String = "module algebra_probe\n\nfn f(n: Node) -> Int {\n  fold_node(n: n, algebra: alg)\n}\n"

data paramless_step_fold_snippet: String = "module paramless_step_probe\n\nfn f(xs: List<Int>) -> Int {\n  fold(xs, init: 0, f: fn() { 0 })\n}\n"

// THE SUBJECT CONSUMES A SURFACE PARSE SUBTREE, SO THE INGEST STOPS AT PARSE.
//
// This function called normalize between parse_module and the locate, and the
// witnesses that depend on it had never executed, so nothing said what that
// cost. Measured 2026-08-21 on the first run these claims ever had: with
// normalize in the chain the well-formed fold reaches fold_call_lowering as
// FoldCallNotAFold and ^fold is not among the tree's atom identities at all;
// with the chain stopped at parse it reaches FoldCallLowered. Same snippet,
// same subject, one stage apart.
//
// That is not a defect in normalize and it is not a weakening here. The
// authority's own contract (v2.compiler.fold_lowering fold_lowering_note) is
// that a surface fold "parses as an ordinary call (a ^dag_surface_primary_expr
// whose head ident ... carries its NAME as an atom identity)" and that its
// input is "the primary_expr captured child, a sequence(head_ident,
// call_suffix)". fold_call_head_symbol reads that surface shape by name
// (^grammar_sequence_left_node_projection). Normalize's output is the core
// graph, past the surface productions this stage keys on -- so feeding it here
// was handing the desugaring an input from the wrong side of the seam, and the
// refusal it produced was correct.
fn ingest(source_text: String, file: Symbol) -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(text: source_text, file: file, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } => Present { value: artifact.tree }
      }
  }
}

fn locate_call(root: Node) -> Optional<Node> {
  match parse_subtree_find_production_captured(root: root, emitted: ^dag_surface_primary_expr) {
    ParseSubtreeFound { captured: call } => Present { value: call }
    ParseSubtreeAbsent => Absent
  }
}

fn ingest_and_locate(source_text: String, file: Symbol) -> Optional<Node> {
  match ingest(source_text: source_text, file: file) {
    Absent => Absent
    Present { value: tree } => locate_call(root: tree)
  }
}

fn is_proven_termination(m: Multiplicity) -> Bool {
  match m {
    ProvenTermination { proof: _ } => true
    RequiresTerminationProof => false
    Bounded => false
  }
}

fn outcome_is_rejected(o: Outcome<Node>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn collect_atom_identities(n: Node, acc: List<Symbol>) -> List<Symbol> {
  let acc1 = match node_atom_identity_optional(node: n) {
    Present { value: s } => Cons { head: s, tail: acc }
    Absent => acc
  }
  fold(n.children, init: acc1, f: fn(a, e) {
    collect_atom_identities(n: e.target, acc: a)
  })
}

fn symbol_in(needle: Symbol, xs: List<Symbol>) -> Bool {
  fold(xs, init: false, f: fn(acc, s) {
    if acc { true } else { s == needle }
  })
}

fn fold_snippet_identities() -> List<Symbol> {
  match ingest(source_text: fold_snippet, file: ^fold_probe_file) {
    Absent => std.algebra.Empty
    Present { value: tree } => collect_atom_identities(n: tree, acc: std.algebra.Empty)
  }
}

test fn fold_probe_ingest_is_accepted() -> Bool {
  match ingest(source_text: fold_snippet, file: ^fold_probe_file) {
    Absent => false
    Present { value: _ } => true
  }
}

test fn fold_callee_name_survives_parse() -> Bool {
  symbol_in(needle: ^fold, xs: fold_snippet_identities())
}

test fn fold_collection_name_survives_parse() -> Bool {
  symbol_in(needle: ^xs, xs: fold_snippet_identities())
}

test fn fold_call_lowers_to_terminating_loop() -> Bool {
  match ingest_and_locate(source_text: fold_snippet, file: ^fold_probe_file) {
    Absent => false
    Present { value: call } =>
      match fold_call_to_loop(fold_call: call) {
        Accepted { value: loop, diagnostics: _ } =>
          is_proven_termination(m: loop_multiplicity(n: loop))
        Rejected { diagnostics: _ } => false
      }
  }
}

fn lowered_fixture_loop() -> Optional<Node> {
  match ingest_and_locate(source_text: fold_snippet, file: ^fold_probe_file) {
    Absent => Absent
    Present { value: call } =>
      match fold_call_to_loop(fold_call: call) {
        Accepted { value: loop, diagnostics: _ } => Present { value: loop }
        Rejected { diagnostics: _ } => Absent
      }
  }
}

// WHY THESE TWO CLAIMS PROJECT `.children` INSIDE A NODE-TYPED HELPER RATHER
// THAN OFF THE MATCH BINDER DIRECTLY, which is the shape they were authored in.
//
// Measured 2026-08-21, on the first execution these claims have ever had: a
// binder introduced by destructuring a GENERIC coproduct (`Present { value: l }`
// of `Optional<Node>`, `Accepted { value: l }` of `Outcome<Node>`) is usable in
// ARGUMENT position -- four sibling claims in this file pass doing exactly that
// -- but projecting a field off it (`l.children`) fails with `error type
// cascade` at the projection's own offset. The element type is not resolved at
// the point the field is read.
//
// That is a v2 inference deficit, not a fact about these claims, and it is
// REPORTED rather than absorbed: it is named here, at the site whose shape it
// dictates, and raised to the emission-convergence lane. The helpers below are
// not a dodge around a refusal -- they are the same projection performed where
// the type IS concrete, which is a `Node` parameter, and they leave both claims
// asserting exactly what they asserted before. When the deficit closes, these
// two helpers dissolve back into the match arms and nothing else changes.
fn carrier_binder_of(n: Node) -> NamedEdgeTargetLookup {
  loop_carrier_binder_target(children: n.children)
}

fn with_duplicate_carrier_edge(n: Node, binder: Node) -> Node {
  node_rebuild(
    n: n,
    children: list_snoc_item(
      xs: n.children,
      item: Edge { label: Named { name: ^loop_carrier_edge }, target: binder }
    )
  )
}

test fn lowered_loop_binds_carrier_binder() -> Bool {
  match lowered_fixture_loop() {
    Absent => false
    Present { value: loop } =>
      match carrier_binder_of(n: loop) {
        Found { target: binder } =>
          match node_atom_identity_optional(node: binder) {
            Present { value: sym } => sym == ^acc
            Absent => false
          }
        Ambiguous => false
        Absent => false
      }
  }
}

test fn duplicate_carrier_edge_is_malformed() -> Bool {
  match lowered_fixture_loop() {
    Absent => false
    Present { value: loop } =>
      match carrier_binder_of(n: loop) {
        Found { target: binder } =>
          !well_formed(n: with_duplicate_carrier_edge(n: loop, binder: binder))
        Ambiguous => false
        Absent => false
      }
  }
}

test fn non_fold_call_refuses() -> Bool {
  match ingest_and_locate(source_text: non_fold_snippet, file: ^g_probe_file) {
    Absent => false
    Present { value: call } =>
      outcome_is_rejected(o: fold_call_to_loop(fold_call: call))
  }
}

test fn bodyless_fold_call_refuses_no_loop_fabricated() -> Bool {
  match ingest_and_locate(source_text: bodyless_fold_snippet, file: ^bodyless_probe_file) {
    Absent => false
    Present { value: call } =>
      outcome_is_rejected(o: fold_call_to_loop(fold_call: call))
  }
}


// THE CONFLATED ARM, SPLIT -- and what each half of this block is pinning.
//
// bodyless_fold_call_refuses_no_loop_fabricated above is UNCHANGED and still
// green: fold_call_to_loop is the two-state projection and every non-lowered
// arm is still a refusal there, so the no-fabrication property this file has
// always asserted is asserted in exactly the same words against exactly the
// same function. What the split adds is the DISPOSITION NAME, which is a
// question the two-state projection cannot be asked, and the claims below ask
// it of fold_call_lowering directly.
//
// Three subjects, deliberately: two that the stage CANNOT judge malformed
// because judging them needs the callee declaration, and one that it CAN and
// therefore must still refuse. Without the third, the split would have deleted
// an arm rather than separated two states, and this file would go green for a
// stage that had stopped refusing anything.
fn lowering_of(source_text: String, file: Symbol) -> Optional<FoldCallLowering> {
  match ingest_and_locate(source_text: source_text, file: file) {
    Absent => Absent
    Present { value: call } => Present { value: fold_call_lowering(fold_call: call) }
  }
}

fn is_step_form_unresolved(source_text: String, file: Symbol) -> Bool {
  match lowering_of(source_text: source_text, file: file) {
    Absent => false
    Present { value: l } =>
      match l {
        FoldCallStepFormUnresolved { diagnostic: _ } => true
        FoldCallStepShapeInvalid { diagnostic: _ } => false
        FoldCallNotAFold { diagnostic: _ } => false
        FoldCallLowered { seam_loop: _ } => false
      }
  }
}

fn is_step_shape_invalid(source_text: String, file: Symbol) -> Bool {
  match lowering_of(source_text: source_text, file: file) {
    Absent => false
    Present { value: l } =>
      match l {
        FoldCallStepShapeInvalid { diagnostic: _ } => true
        FoldCallStepFormUnresolved { diagnostic: _ } => false
        FoldCallNotAFold { diagnostic: _ } => false
        FoldCallLowered { seam_loop: _ } => false
      }
  }
}

fn fabricates_no_loop(source_text: String, file: Symbol) -> Bool {
  match ingest_and_locate(source_text: source_text, file: file) {
    Absent => false
    Present { value: call } => outcome_is_rejected(o: fold_call_to_loop(fold_call: call))
  }
}

// (b) THE TWO NOT-APPLICABLE SHAPES, ASSERTED BY DISPOSITION NAME.
// Both are real corpus shapes, not constructed curiosities: v2.std.algebra
// passes a step by name, v2.std.node calls fold_node with an algebra record
// that is never a step fn at all. Neither is malformed and this stage cannot
// establish that either way, because that read is the callee's declaration.
test fn named_step_fold_is_step_form_unresolved() -> Bool {
  is_step_form_unresolved(source_text: named_step_fold_snippet, file: ^named_step_probe_file)
}

test fn algebra_carrying_fold_is_step_form_unresolved() -> Bool {
  is_step_form_unresolved(source_text: algebra_fold_snippet, file: ^algebra_probe_file)
}

test fn bodyless_fold_is_step_form_unresolved() -> Bool {
  is_step_form_unresolved(source_text: bodyless_fold_snippet, file: ^bodyless_probe_file)
}

// (c) THE GENUINELY MALFORMED CASE, RETAINED AS A REFUSAL WITH ITS REASON.
// Here the fn literal IS in hand and it cannot be a fold step -- no first
// parameter means no accumulator binder. That judgement needs nothing the
// stage lacks, so it stays shape_invalid. This claim is what keeps the split
// from being a deletion: it goes red if the not-applicable arm ever widens to
// swallow a form the stage can actually judge.
test fn paramless_step_fold_is_step_shape_invalid() -> Bool {
  is_step_shape_invalid(source_text: paramless_step_fold_snippet, file: ^paramless_step_probe_file)
}

// (a) NO LOOP IS FABRICATED ON ANY OF THEM -- the substantive safety property,
// unchanged by the split and asserted across every subject it touches.
test fn split_dispositions_fabricate_no_loop() -> Bool {
  fabricates_no_loop(source_text: named_step_fold_snippet, file: ^named_step_probe_file)
    && fabricates_no_loop(source_text: algebra_fold_snippet, file: ^algebra_probe_file)
    && fabricates_no_loop(source_text: bodyless_fold_snippet, file: ^bodyless_probe_file)
    && fabricates_no_loop(source_text: paramless_step_fold_snippet, file: ^paramless_step_probe_file)
}

// THE POSITIVE CONTROL FOR THE SPLIT ITSELF. A well-formed fold still lowers,
// so none of the above is green merely because the authority stopped lowering.
test fn well_formed_fold_still_lowers_through_the_split() -> Bool {
  match lowering_of(source_text: fold_snippet, file: ^fold_probe_file) {
    Absent => false
    Present { value: l } =>
      match l {
        FoldCallLowered { seam_loop: loop } => is_proven_termination(m: loop_multiplicity(n: loop))
        FoldCallStepFormUnresolved { diagnostic: _ } => false
        FoldCallStepShapeInvalid { diagnostic: _ } => false
        FoldCallNotAFold { diagnostic: _ } => false
      }
  }
}

// A NON-FOLD CALL IS STILL NOT-A-FOLD, not swept into the new arm.
test fn non_fold_call_is_not_a_fold_disposition() -> Bool {
  match lowering_of(source_text: non_fold_snippet, file: ^g_probe_file) {
    Absent => false
    Present { value: l } =>
      match l {
        FoldCallNotAFold { diagnostic: _ } => true
        FoldCallLowered { seam_loop: _ } => false
        FoldCallStepFormUnresolved { diagnostic: _ } => false
        FoldCallStepShapeInvalid { diagnostic: _ } => false
      }
  }
}
