module v2.test.parse.parse_binding_fidelity

import v2.compiler.name_resolve {
  Admission,
  Import,
  ImportVisible,
  ResolutionSubject,
  resolve_with_admission_policy
}
import v2.compiler.ingested_fixture_arrows {
  ingested_add_module_source,
  ingested_find_arrow_in_module
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_language_model_surface_empty_prelude,
  dag_language_model,
  dag_named_edge
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list_node }
import v2.std.collection { Absent, List, Optional, Present, list_at_optional }
import v2.std.qualified_name { QualifiedName }
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.grammar { ParseTree, node_atom_identity_optional }
import v2.std.compilers.lexing { TokenStream, symbol_lexeme }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.node_query { find_arrow_body_child }
import v2.std.resolution_policy { ImportScoped }
import v2.std.cross_tree.resolution { SourceRootIndex, source_root_index_empty }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.compiler.namespace_graft { module_header_containment_graft }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn pbf_graft_module_root(root: Node) -> Node {
  match module_header_containment_graft(root: root) {
    Accepted { value: grafted, diagnostics: _ } => grafted
    Rejected { diagnostics: _ } => root
  }
}

fn pbf_tokenize() -> Outcome<TokenStream> {
  let lm = dag_language_model()
  tokenize(text: ingested_add_module_source, file: ^pbf_source_file, rules: lm.lex)
}

fn pbf_parse_tokens(tokens: TokenStream) -> Outcome<ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: parse_module(tokens: tokens, grammar: lm.grammar),
    f: fn(artifact) {
      outcome_accepted(value: artifact.tree)
    }
  )
}

fn pbf_normalized_add_module() -> Outcome<Node> {
  match pbf_tokenize() {
    Accepted { value: tokens, diagnostics: _ } =>
      match pbf_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          normalize(parse_tree: parsed)
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn pbf_normalized_add_arrow() -> Optional<Node> {
  match pbf_normalized_add_module() {
    Accepted { value: tree, diagnostics: _ } =>
      ingested_find_arrow_in_module(root: tree)
    Rejected { diagnostics: _ } => Absent
  }
}

fn pbf_resolved_add_module() -> Outcome<Node> {
  let lm = dag_language_model()
  match pbf_normalized_add_module() {
    Accepted { value: normalized, diagnostics: _ } =>
      resolve(tree: normalized, lm: lm)
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn pbf_resolved_add_arrow() -> Optional<Node> {
  match pbf_resolved_add_module() {
    Accepted { value: tree, diagnostics: _ } =>
      ingested_find_arrow_in_module(root: tree)
    Rejected { diagnostics: _ } => Absent
  }
}

fn pbf_arrow_body_operand_lexeme(arrow: Node, index: Int) -> Optional<String> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match list_at_optional(xs: body.children, index: index) {
        Present { value: e } =>
          match node_atom_identity_optional(node: e.target) {
            Present { value: id } => Present { value: symbol_lexeme(sym: id) }
            Absent => Absent
          }
        Absent => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

fn pbf_arrow_body_operand_id(arrow: Node, index: Int) -> Optional<Symbol> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match list_at_optional(xs: body.children, index: index) {
        Present { value: e } => node_atom_identity_optional(node: e.target)
        Absent => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

fn pbf_tree_contains_atom_identity(root: Node, wanted: Symbol) -> Bool {
  match root.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == wanted {
        true
      } else {
        false
      }
    _ =>
      fold(
        root.children,
        init: false,
        f: fn(found, edge) {
          if found {
            true
          } else {
            pbf_tree_contains_atom_identity(root: edge.target, wanted: wanted)
          }
        }
      )
  }
}

fn pbf_parse_preserves_param_x_binding() -> Bool {
  match pbf_normalized_add_arrow() {
    Present { value: arrow } =>
      match pbf_arrow_body_operand_lexeme(arrow: arrow, index: 1) {
        Present { value: lex } => lex == "x"
        Absent => false
      }
    Absent => false
  }
}

fn pbf_parse_preserves_param_y_binding() -> Bool {
  match pbf_normalized_add_arrow() {
    Present { value: arrow } =>
      match pbf_arrow_body_operand_lexeme(arrow: arrow, index: 2) {
        Present { value: lex } => lex == "y"
        Absent => false
      }
    Absent => false
  }
}

fn pbf_parse_does_not_collapse_to_token_ident() -> Bool {
  match pbf_normalized_add_arrow() {
    Present { value: arrow } =>
      match pbf_arrow_body_operand_lexeme(arrow: arrow, index: 1) {
        Present { value: left } =>
          match pbf_arrow_body_operand_lexeme(arrow: arrow, index: 2) {
            Present { value: right } => (left == "x") && (right == "y") && (left != right)
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn pbf_resolved_add_accepts() -> Bool {
  match pbf_resolved_add_module() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_resolved_tree_has_distinct_param_bindings() -> Bool {
  match pbf_resolved_add_arrow() {
    Present { value: arrow } =>
      match pbf_arrow_body_operand_id(arrow: arrow, index: 1) {
        Present { value: left } =>
          match pbf_arrow_body_operand_id(arrow: arrow, index: 2) {
            Present { value: right } => (left != right) && (symbol_lexeme(sym: left) == "x") && (symbol_lexeme(sym: right) == "y")
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn pbf_qn_node(seg: Symbol) -> Node {
  fold_list_node(
    xs: Cons { head: seg, tail: Empty },
    item_node: fn(sym) {
      Node {
        kind: TypeNode { connective: Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
}

fn pbf_module_root(seg: Symbol, export_sym: Symbol, export_atom: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: pbf_qn_node(seg: seg)
      ),
      Edge {
        label: Named { name: export_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: export_atom } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pbf_subject_with_import_use() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: pbf_qn_node(seg: ^pbf_subject_seg)
      ),
      Edge {
        label: Named { name: ^pbf_import_use_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^pbf_imported_decl } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pbf_cross_file_roots() -> FreeMonoid<Node> {
  Cons {
    head: pbf_graft_module_root(root: pbf_subject_with_import_use()),
    tail: Cons {
      head: pbf_graft_module_root(
        root: pbf_module_root(
          seg: ^pbf_imported_seg,
          export_sym: ^pbf_imported_decl,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: Empty
    }
  }
}

fn pbf_cross_file_import_resolves() -> Bool {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: pbf_cross_file_roots(),
    admission: Admission {
      subject: ResolutionSubject {
        name: Cons { head: ^pbf_subject_seg, tail: Empty }
      },
      imports: Cons {
        head: Import {
          target: Cons { head: ^pbf_imported_seg, tail: Empty },
          visibility: ImportVisible
        },
        tail: Empty
      }
    },
    index: source_root_index_empty(),
    active_roots: Empty,
    policy: ImportScoped
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_unbound_atom_tree() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^pbf_unbound_sym } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pbf_resolve_unbound_symbol_rejects() -> Bool {
  match resolve(
    tree: pbf_unbound_atom_tree(),
    lm: dag_language_model_surface_empty_prelude()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn pbf_subject_with_ambiguous_import_use() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: pbf_qn_node(seg: ^pbf_subject_seg)
      ),
      Edge {
        label: Named { name: ^pbf_ambiguous_export_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^pbf_ambiguous_export_sym } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pbf_ambiguous_import_roots() -> FreeMonoid<Node> {
  Cons {
    head: pbf_graft_module_root(root: pbf_subject_with_ambiguous_import_use()),
    tail: Cons {
      head: pbf_graft_module_root(
        root: pbf_module_root(
          seg: ^pbf_ambiguous_import_a_seg,
          export_sym: ^pbf_ambiguous_export_sym,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: Cons {
        head: pbf_graft_module_root(
          root: pbf_module_root(
            seg: ^pbf_ambiguous_import_b_seg,
            export_sym: ^pbf_ambiguous_export_sym,
            export_atom: ^dag_c3_surface_sugar_type
          )
        ),
        tail: Empty
      }
    }
  }
}

fn pbf_ambiguous_export_rejects() -> Bool {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: pbf_ambiguous_import_roots(),
    admission: Admission {
      subject: ResolutionSubject {
        name: Cons { head: ^pbf_subject_seg, tail: Empty }
      },
      imports: Cons {
        head: Import {
          target: Cons { head: ^pbf_ambiguous_import_a_seg, tail: Empty },
          visibility: ImportVisible
        },
        tail: Cons {
          head: Import {
            target: Cons { head: ^pbf_ambiguous_import_b_seg, tail: Empty },
            visibility: ImportVisible
          },
          tail: Empty
        }
      }
    },
    index: source_root_index_empty(),
    active_roots: Empty,
    policy: ImportScoped
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data parse_binding_fidelity_fast_note: String = "Fixture: three cross-file binding resolution + fail-closed witness tests. Discovered per-PR via *_test.dag walk. Long-lane corpus split: long/parse_binding_fidelity_witness_test.dag (commit_workflow-enrolled module ingest tests) — see parse_binding_fidelity_long_note."

test fn witness_cross_file_import_binding_resolves_holds() -> Bool {
  pbf_cross_file_import_resolves()
}

test fn witness_unbound_symbol_fail_closed_holds() -> Bool {
  pbf_resolve_unbound_symbol_rejects()
    && ((pbf_resolve_unbound_symbol_rejects() == false) == false)
}

test fn witness_ambiguous_export_fail_closed_holds() -> Bool {
  pbf_ambiguous_export_rejects()
    && ((pbf_ambiguous_export_rejects() == false) == false)
}
