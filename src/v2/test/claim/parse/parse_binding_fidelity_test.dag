module v2.test.parse.parse_binding_fidelity

import v2.compiler.name_resolve {
  Admission,
  Import,
  ImportVisible,
  ResolutionSubject,
  resolve_with_admission
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
}
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_grammar_production_mvp1_fn_add,
  dag_language_model_surface_empty_prelude,
  dag_language_model_wave1,
  dag_mvp1_source_text,
  dag_named_edge
}
import v2.std.algebra { Cons, Empty, FreeMonoid, fold_list_node }
import v2.std.collection { List, Set }
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted,
  port_locus
}
import v2.std.grammar { GrammarRoot, ParseTree }
import v2.std.compilers.lexing { Token, token_stream_all }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.qualified_name { QnCons, QnEmpty, QualifiedName }

fn pbf_parse_root() -> GrammarRoot {
  GrammarRoot {
    start: ^dag_production_mvp1_fn_add,
    productions: [dag_grammar_production_mvp1_fn_add()],
    sync_tokens: Set { member: fn(_) { false } }
  }
}

fn pbf_tokenize() -> Outcome<List<Token>> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(text: dag_mvp1_source_text, file: ^pbf_source_file, rules: lm.lex),
    f: fn(stream) {
      outcome_accepted(value: token_stream_all(stream: stream))
    }
  )
}

fn pbf_parse_tokens(tokens: List<Token>) -> Outcome<ParseTree> {
  match grammar_validate_for_parse(
    root: pbf_parse_root(),
    at: port_locus(port: ^parse_stage_locus_port)
  ) {
    Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: tokens,
        validated: validated,
        production_name: ^dag_production_mvp1_fn_add
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn pbf_tree_contains_atom_identity(root: Node, wanted: Symbol) -> Bool {
  match root.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == wanted {
        true
      } else {
        false
      }
    _ =>
      fold(
        root.children,
        init: false,
        f: fn(found, edge) {
          if found {
            true
          } else {
            pbf_tree_contains_atom_identity(root: edge.target, wanted: wanted)
          }
        }
      )
  }
}

fn pbf_parse_preserves_param_x_binding() -> Bool {
  match pbf_tokenize() {
    Accepted { value: tokens, diagnostics: _ } =>
      match pbf_parse_tokens(tokens: tokens) {
        Accepted { value: tree, diagnostics: _ } =>
          pbf_tree_contains_atom_identity(root: tree, wanted: ^dag_binding_param_x)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_parse_preserves_param_y_binding() -> Bool {
  match pbf_tokenize() {
    Accepted { value: tokens, diagnostics: _ } =>
      match pbf_parse_tokens(tokens: tokens) {
        Accepted { value: tree, diagnostics: _ } =>
          pbf_tree_contains_atom_identity(root: tree, wanted: ^dag_binding_param_y)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_parse_does_not_collapse_to_token_ident() -> Bool {
  match pbf_tokenize() {
    Accepted { value: tokens, diagnostics: _ } =>
      match pbf_parse_tokens(tokens: tokens) {
        Accepted { value: tree, diagnostics: _ } =>
          (pbf_tree_contains_atom_identity(root: tree, wanted: ^dag_binding_param_x) == true)
            && (pbf_tree_contains_atom_identity(root: tree, wanted: ^dag_binding_param_y) == true)
            && ((pbf_tree_contains_atom_identity(root: tree, wanted: ^dag_token_ident) == true) == false)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_resolved_add_accepts() -> Bool {
  let lm = dag_language_model_wave1()
  match pbf_tokenize() {
    Accepted { value: tokens, diagnostics: _ } =>
      match pbf_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } =>
              match resolve(tree: normalized, lm: lm) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_resolved_tree_has_distinct_param_bindings() -> Bool {
  let lm = dag_language_model_wave1()
  match pbf_tokenize() {
    Accepted { value: tokens, diagnostics: _ } =>
      match pbf_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          match normalize(parse_tree: parsed) {
            Accepted { value: normalized, diagnostics: _ } =>
              match resolve(tree: normalized, lm: lm) {
                Accepted { value: resolved, diagnostics: _ } =>
                  pbf_tree_contains_atom_identity(root: resolved, wanted: ^dag_binding_param_x)
                    && pbf_tree_contains_atom_identity(root: resolved, wanted: ^dag_binding_param_y)
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_qn_node(seg: Symbol) -> Node {
  fold_list_node(
    xs: Cons { head: seg, tail: Empty },
    item_node: fn(sym) {
      Node {
        kind: TypeNode { connective: Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
}

fn pbf_module_root(seg: Symbol, export_sym: Symbol, export_atom: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: pbf_qn_node(seg: seg)
      ),
      Edge {
        label: Named { name: export_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: export_atom } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pbf_subject_with_import_use() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: pbf_qn_node(seg: ^pbf_subject_seg)
      ),
      Edge {
        label: Named { name: ^pbf_import_use_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^pbf_imported_decl } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pbf_cross_file_roots() -> FreeMonoid<Node> {
  Cons {
    head: pbf_subject_with_import_use(),
    tail: Cons {
      head: pbf_module_root(
        seg: ^pbf_imported_seg,
        export_sym: ^pbf_imported_decl,
        export_atom: ^dag_c3_surface_sugar_service
      ),
      tail: Empty
    }
  }
}

fn pbf_cross_file_import_resolves() -> Bool {
  match resolve_with_admission(
    lm: dag_language_model_surface_empty_prelude(),
    roots: pbf_cross_file_roots(),
    admission: Admission {
      subject: ResolutionSubject {
        name: QnCons { head: ^pbf_subject_seg, tail: QnEmpty }
      },
      imports: Cons {
        head: Import {
          target: QnCons { head: ^pbf_imported_seg, tail: QnEmpty },
          visibility: ImportVisible
        },
        tail: Empty
      }
    }
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_unbound_atom_tree() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^pbf_unbound_sym } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pbf_resolve_unbound_symbol_rejects() -> Bool {
  match resolve(
    tree: pbf_unbound_atom_tree(),
    lm: dag_language_model_surface_empty_prelude()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn pbf_subject_with_ambiguous_import_use() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: pbf_qn_node(seg: ^pbf_subject_seg)
      ),
      Edge {
        label: Named { name: ^pbf_ambiguous_export_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^pbf_ambiguous_export_sym } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn pbf_ambiguous_import_roots() -> FreeMonoid<Node> {
  Cons {
    head: pbf_subject_with_ambiguous_import_use(),
    tail: Cons {
      head: pbf_module_root(
        seg: ^pbf_ambiguous_import_a_seg,
        export_sym: ^pbf_ambiguous_export_sym,
        export_atom: ^dag_c3_surface_sugar_service
      ),
      tail: Cons {
        head: pbf_module_root(
          seg: ^pbf_ambiguous_import_b_seg,
          export_sym: ^pbf_ambiguous_export_sym,
          export_atom: ^dag_c3_surface_sugar_type
        ),
        tail: Empty
      }
    }
  }
}

fn pbf_ambiguous_export_rejects() -> Bool {
  match resolve_with_admission(
    lm: dag_language_model_surface_empty_prelude(),
    roots: pbf_ambiguous_import_roots(),
    admission: Admission {
      subject: ResolutionSubject {
        name: QnCons { head: ^pbf_subject_seg, tail: QnEmpty }
      },
      imports: Cons {
        head: Import {
          target: QnCons { head: ^pbf_ambiguous_import_a_seg, tail: QnEmpty },
          visibility: ImportVisible
        },
        tail: Cons {
          head: Import {
            target: QnCons { head: ^pbf_ambiguous_import_b_seg, tail: QnEmpty },
            visibility: ImportVisible
          },
          tail: Empty
        }
      }
    }
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn witness_parse_binding_fidelity_distinct_identifiers_holds() -> Bool {
  pbf_parse_preserves_param_x_binding()
    && pbf_parse_preserves_param_y_binding()
    && pbf_parse_does_not_collapse_to_token_ident()
}

test fn witness_resolve_distinct_param_bindings_holds() -> Bool {
  pbf_resolved_add_accepts()
    && pbf_resolved_tree_has_distinct_param_bindings()
}

test fn witness_cross_file_import_binding_resolves_holds() -> Bool {
  pbf_cross_file_import_resolves()
}

test fn witness_unbound_symbol_fail_closed_holds() -> Bool {
  pbf_resolve_unbound_symbol_rejects()
    && ((pbf_resolve_unbound_symbol_rejects() == false) == false)
}

test fn witness_ambiguous_export_fail_closed_holds() -> Bool {
  pbf_ambiguous_export_rejects()
    && ((pbf_ambiguous_export_rejects() == false) == false)
}
