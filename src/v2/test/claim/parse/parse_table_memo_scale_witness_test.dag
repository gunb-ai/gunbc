module v2.test.parse.parse_table_memo_scale_witness

import extdeps.filesystem.filesystem_io
import v2.compiler.parse {
  ParseMemoStats,
  grammar_validate_for_parse,
  parse_production_memo_stats
}
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.compilers.lexing { token_stream_remaining }
import v2.std.diagnostic { Accepted, Rejected, port_locus }
import v2.std.grammar { ModeledGrammar, ParseGrammar }
import v2.std.logic { Bool }

type FilesystemReadResult { content: String }

data parse_memo_scale_tokenize_path: String = "src/v1/01_tokenize.dag"

fn parse_memo_scale_stats_for_grammar(
  source_text: String,
  grammar: ParseGrammar
) -> ParseMemoStats {
  let lm = dag_language_model_wave1()
  let at = port_locus(port: ^parse_stage_locus_port)
  match tokenize(text: source_text, file: ^parse_memo_scale_file_anchor, rules: lm.lex) {
    Rejected { diagnostics: _ } =>
      ParseMemoStats { hits: 0, misses: 0 }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar {
        ModeledGrammar { root: root } =>
          match grammar_validate_for_parse(root: root, at: at) {
            Rejected { diagnostics: _ } =>
              ParseMemoStats { hits: 0, misses: 0 }
            Accepted { value: validated, diagnostics: _ } =>
              parse_production_memo_stats(
                tokens: token_stream_remaining(stream: stream),
                validated: validated,
                production_name: validated.root.start
              )
          }
        VoidGrammar =>
          ParseMemoStats { hits: 0, misses: 0 }
      }
  }
}

fn parse_memo_scale_tokenize_stats() -> ParseMemoStats {
  let source_text = filesystem_read(path: parse_memo_scale_tokenize_path).content
  parse_memo_scale_stats_for_grammar(
    source_text: source_text,
    grammar: dag_language_model_wave1().grammar
  )
}

fn witness_parse_memo_scale_tokenize_hits() -> Int {
  parse_memo_scale_tokenize_stats().hits
}

fn witness_parse_memo_scale_tokenize_misses() -> Int {
  parse_memo_scale_tokenize_stats().misses
}

test fn parse_memo_scale_tokenize_hits_substantial_holds() -> Bool {
  witness_parse_memo_scale_tokenize_hits() > 0
}

test fn parse_memo_scale_tokenize_misses_recorded_holds() -> Bool {
  witness_parse_memo_scale_tokenize_misses() > 0
}
