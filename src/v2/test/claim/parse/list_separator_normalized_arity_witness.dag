test fn ff639_canonical_reader_counts_handbuilt_introduction() -> Bool {
  let a = declaration_reference_node(qn: [^ff639_a], occurrence_id: OccurrenceSynthetic)
  let b = declaration_reference_node(qn: [^ff639_b], occurrence_id: OccurrenceSynthetic)
  match list_introduction_elements_optional(
    node: lower_list_introduction_at(elements: [a, b], occurrence_id: OccurrenceSynthetic)
  ) {
    Present { value: elements } => length(xs: elements) == 2
    Absent => false
  }
}

test fn ff639_canonical_reader_refuses_non_positional_head() -> Bool {
  let a = declaration_reference_node(qn: [^ff639_a], occurrence_id: OccurrenceSynthetic)
  let smuggled = node_with_occurrence_id(
    kind: ComputationNode { behavior: Transform },
    children: [Edge { label: Authored { name: ^ff639_head }, target: a, declaration: NotADeclaration }],
    occurrence_id: OccurrenceSynthetic
  )
  match list_introduction_elements_optional(node: smuggled) {
    Present { value: _ } => false
    Absent => true
  }
}
