// two2: a shorter list lowers to fewer elements -- the counts are arity-sensitive, not constant
data two2_inner: String = "[1, 2]"
fn two2_source() -> String {
  "module m\ndata v: Int = [1, 2]"
}

fn two2_stream() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^arity_witness, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "m", file: ^arity_witness, start: 7, end: 8 },
    Token { class: ^dag_token_kw_data, lexeme: "data", file: ^arity_witness, start: 9, end: 13 },
    Token { class: ^dag_token_ident, lexeme: "v", file: ^arity_witness, start: 14, end: 15 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^arity_witness, start: 15, end: 16 },
    Token { class: ^dag_token_ident, lexeme: "Int", file: ^arity_witness, start: 17, end: 20 },
    Token { class: ^dag_token_eq, lexeme: "=", file: ^arity_witness, start: 21, end: 22 },
    Token { class: ^dag_token_lbracket, lexeme: "[", file: ^arity_witness, start: 23, end: 24 },
    Token { class: ^dag_token_int_literal, lexeme: "1", file: ^arity_witness, start: 24, end: 25 },
    Token { class: ^dag_token_comma, lexeme: ",", file: ^arity_witness, start: 25, end: 26 },
    Token { class: ^dag_token_int_literal, lexeme: "2", file: ^arity_witness, start: 27, end: 28 },
    Token { class: ^dag_token_rbracket, lexeme: "]", file: ^arity_witness, start: 28, end: 29 }
  ])
}

test fn two2_lowers_to_2_elements_holds() -> Bool {
  arity_is(tokens: two2_stream(), expected: 2)
}
test fn two2_stream_matches_the_tokenizer_holds() -> Bool {
  supplied_stream_matches_tokenize(text: two2_source(), file: ^arity_witness, supplied: two2_stream())
}

// juxtaposed3: the dropped separator: refused at parse, so NO lowered list exists (at main this same specimen normalizes with three elements -- the flip)
data juxtaposed3_inner: String = "[1 2 3]"
fn juxtaposed3_source() -> String {
  "module m\ndata v: Int = [1 2 3]"
}

fn juxtaposed3_stream() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^arity_witness, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "m", file: ^arity_witness, start: 7, end: 8 },
    Token { class: ^dag_token_kw_data, lexeme: "data", file: ^arity_witness, start: 9, end: 13 },
    Token { class: ^dag_token_ident, lexeme: "v", file: ^arity_witness, start: 14, end: 15 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^arity_witness, start: 15, end: 16 },
    Token { class: ^dag_token_ident, lexeme: "Int", file: ^arity_witness, start: 17, end: 20 },
    Token { class: ^dag_token_eq, lexeme: "=", file: ^arity_witness, start: 21, end: 22 },
    Token { class: ^dag_token_lbracket, lexeme: "[", file: ^arity_witness, start: 23, end: 24 },
    Token { class: ^dag_token_int_literal, lexeme: "1", file: ^arity_witness, start: 24, end: 25 },
    Token { class: ^dag_token_int_literal, lexeme: "2", file: ^arity_witness, start: 26, end: 27 },
    Token { class: ^dag_token_int_literal, lexeme: "3", file: ^arity_witness, start: 28, end: 29 },
    Token { class: ^dag_token_rbracket, lexeme: "]", file: ^arity_witness, start: 29, end: 30 }
  ])
}

test fn juxtaposed3_refuses_before_any_lowered_list_holds() -> Bool {
  no_lowered_list(tokens: juxtaposed3_stream())
}
test fn juxtaposed3_stream_matches_the_tokenizer_holds() -> Bool {
  supplied_stream_matches_tokenize(text: juxtaposed3_source(), file: ^arity_witness, supplied: juxtaposed3_stream())
}

// records2: the corpus shape: separated record elements keep both elements
data records2_inner: String = "[Row { name: \"a\" }, Row { name: \"b\" }]"
fn records2_source() -> String {
  "module m\ndata v: Int = [Row { name: \"a\" }, Row { name: \"b\" }]"
}

fn records2_stream() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^arity_witness, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "m", file: ^arity_witness, start: 7, end: 8 },
    Token { class: ^dag_token_kw_data, lexeme: "data", file: ^arity_witness, start: 9, end: 13 },
    Token { class: ^dag_token_ident, lexeme: "v", file: ^arity_witness, start: 14, end: 15 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^arity_witness, start: 15, end: 16 },
    Token { class: ^dag_token_ident, lexeme: "Int", file: ^arity_witness, start: 17, end: 20 },
    Token { class: ^dag_token_eq, lexeme: "=", file: ^arity_witness, start: 21, end: 22 },
    Token { class: ^dag_token_lbracket, lexeme: "[", file: ^arity_witness, start: 23, end: 24 },
    Token { class: ^dag_token_ident, lexeme: "Row", file: ^arity_witness, start: 24, end: 27 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^arity_witness, start: 28, end: 29 },
    Token { class: ^dag_token_ident, lexeme: "name", file: ^arity_witness, start: 30, end: 34 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^arity_witness, start: 34, end: 35 },
    Token { class: ^dag_token_string_literal, lexeme: "\"a\"", file: ^arity_witness, start: 36, end: 39 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^arity_witness, start: 40, end: 41 },
    Token { class: ^dag_token_comma, lexeme: ",", file: ^arity_witness, start: 41, end: 42 },
    Token { class: ^dag_token_ident, lexeme: "Row", file: ^arity_witness, start: 43, end: 46 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^arity_witness, start: 47, end: 48 },
    Token { class: ^dag_token_ident, lexeme: "name", file: ^arity_witness, start: 49, end: 53 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^arity_witness, start: 53, end: 54 },
    Token { class: ^dag_token_string_literal, lexeme: "\"b\"", file: ^arity_witness, start: 55, end: 58 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^arity_witness, start: 59, end: 60 },
    Token { class: ^dag_token_rbracket, lexeme: "]", file: ^arity_witness, start: 60, end: 61 }
  ])
}

test fn records2_lowers_to_2_elements_holds() -> Bool {
  arity_is(tokens: records2_stream(), expected: 2)
}
test fn records2_stream_matches_the_tokenizer_holds() -> Bool {
  supplied_stream_matches_tokenize(text: records2_source(), file: ^arity_witness, supplied: records2_stream())
}
