// THE PINNED TOTALS ARE MEASURED, NOT GUESSED. Each specimen module lowers to a fixed spine of
// three further canonical introductions carrying three elements between them -- the argument and
// parameter introductions the lowering materialises for the module's two functions -- on top of the
// AUTHORED lists (the probe list plus the two-element control). So the pins are: [x, x, x] + [x, x]
// -> (lists 5, elements 8); [x] + [x, x] -> (5, 6); [x, x] + [x, x] -> (5, 7); [x, x, x,] + [x, x]
// -> (5, 8); [] + [x, x] -> (5, 5); and [[x, x], [x]] + [x, x] -> (7, 10), the nested probe adding
// two introductions of two and one elements. They were bracketed with monotone >= claims and then
// pinned by a one-candidate-passes equality pass, because an earlier draft of this witness pinned
// hand-guessed totals and was red for a reason that had nothing to do with the wall. Any change to
// an authored element count -- which is exactly what a dropped separator used to do silently --
// moves these numbers.
//
// THE FLIP CLAIM. THE WALL'S OWN WORDS AT THE FILE LEVEL: this text is the three-element specimen
// above with two commas removed, and it must not load. Green at head; on main the same claim is red,
// because there the module loads and its list lowers to three elements -- the silent arity change
// this node exists to close. It is the only claim in this file whose verdict differs across the
// trees; every shape above must hold on BOTH, which is the inertness control for the wall.
test fn ff639_juxtaposed_module_refused_holds() -> Bool {
  !ff639_loads(
    source: ff639_juxtaposed_source,
    id: ^ff639_juxtaposed_load_artifact,
    unit: ^ff639_juxtaposed_load_cu,
    path: "src/v2/test/fixture/parse/ff639_arity_juxtaposed_load.dag"
  )
}

test fn ff639_canonical_reader_counts_handbuilt_introduction() -> Bool {
  let a = declaration_reference_node(qn: [^ff639_a], occurrence_id: OccurrenceSynthetic)
  let b = declaration_reference_node(qn: [^ff639_b], occurrence_id: OccurrenceSynthetic)
  match list_introduction_elements_optional(
    node: lower_list_introduction_at(elements: [a, b], occurrence_id: OccurrenceSynthetic)
  ) {
    Present { value: elements } => length(xs: elements) == 2
    Absent => false
  }
}

test fn ff639_canonical_reader_refuses_non_positional_head() -> Bool {
  let a = declaration_reference_node(qn: [^ff639_a], occurrence_id: OccurrenceSynthetic)
  let smuggled = node_with_occurrence_id(
    kind: ComputationNode { behavior: Transform },
    children: [Edge { label: Authored { name: ^ff639_head }, target: a, declaration: NotADeclaration }],
    occurrence_id: OccurrenceSynthetic
  )
  match list_introduction_elements_optional(node: smuggled) {
    Present { value: _ } => false
    Absent => true
  }
}
