module v2.test.claim.parse.list_separator_normalized_arity_witness

import std.types { List }
import v2.compiler.normalized_tree { NormalizedTree, normalized_tree_roots_to_nodes }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.node {
  Authored,
  ComputationNode,
  Edge,
  Node,
  NotADeclaration,
  Positional,
  Symbol,
  Transform,
  node_subtree_nodes,
  node_with_occurrence_id,
}
import v2.std.qualified_name { QualifiedName, declaration_reference_node }
import v2.std.list_introduction { list_introduction_elements_optional, lower_list_introduction_at }
import v2.extdeps.languages.dag { dag_language_model }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import std.algebra { Cons, Empty, fold_list, length }
import extdeps.communication.medium { Lossless, Medium }
import std.occurrence_identity { OccurrenceSynthetic }

// EVERY LEGITIMATE LIST KEEPS ITS ARITY AT THE LOWERED FORM, AND THE WALL IS THE ONLY THING THAT
// CHANGES. The displaced cost on this node was a separator specimen that survived regen, the
// whole-corpus compile, fixed-point verify and a 15-case matrix because the ACCEPTED list was
// silently reshaped -- a witness that only asks "did it parse" cannot see it, and neither can the
// reference floor. So each specimen is loaded as an inline carried-Medium source (hermetic: no
// filesystem_read, no source_root_walk) through the same route the resolver is handed,
// program_assembly.module_roots_from_source_root_ingest with the live dag grammar, and every
// canonical list introduction in the loaded module is counted ONLY through the one canonical reader
// v2.std.list_introduction.list_introduction_elements_optional -- a leaked comma node or a stray
// optional wrapper changes the count and the claim goes red instead of counting something plausible.
//
// NON-VACUITY: every specimen module ALSO carries a known-good two-element list (ff_ctl), and each
// claim asserts BOTH the number of canonical lists and their TOTAL element count, so "no lowered
// list" can never pass because the route failed to run at all. The juxtaposed specimen is the flip:
// the wall refuses the module, so the counts collapse to 0/0 at head while main silently lowers it
// to three elements -- the same claim, expected text, run against both trees with one runner.
//
// The two hand-built claims prove the reader itself has teeth: a canonical introduction built by
// lower_list_introduction_at counts its elements, and a Transform whose head edge is not positional
// is refused. Without them a reader that answered Present for anything would pass the suite.

type Ff639Stats {
  lists: Int
  elements: Int
}

data ff639_three_source: String = "module ff639.arity.three\n\nimport std.types { Bool }\n\nfn ff_take(xs: List<Bool>) -> Bool { true }\n\nfn ff_probe(x: Bool) -> Bool { ff_take(xs: [x, x, x]) }\n\nfn ff_ctl(x: Bool) -> List<Bool> { [x, x] }"

data ff639_single_source: String = "module ff639.arity.single\n\nimport std.types { Bool }\n\nfn ff_take(xs: List<Bool>) -> Bool { true }\n\nfn ff_probe(x: Bool) -> Bool { ff_take(xs: [x]) }\n\nfn ff_ctl(x: Bool) -> List<Bool> { [x, x] }"

data ff639_two_source: String = "module ff639.arity.two\n\nimport std.types { Bool }\n\nfn ff_take(xs: List<Bool>) -> Bool { true }\n\nfn ff_probe(x: Bool) -> Bool { ff_take(xs: [x, x]) }\n\nfn ff_ctl(x: Bool) -> List<Bool> { [x, x] }"

data ff639_trailing_source: String = "module ff639.arity.trailing\n\nimport std.types { Bool }\n\nfn ff_take(xs: List<Bool>) -> Bool { true }\n\nfn ff_probe(x: Bool) -> Bool { ff_take(xs: [x, x, x,]) }\n\nfn ff_ctl(x: Bool) -> List<Bool> { [x, x] }"

data ff639_empty_source: String = "module ff639.arity.empty\n\nimport std.types { Bool }\n\nfn ff_take(xs: List<Bool>) -> Bool { true }\n\nfn ff_probe(x: Bool) -> Bool { ff_take(xs: []) }\n\nfn ff_ctl(x: Bool) -> List<Bool> { [x, x] }"

data ff639_nested_source: String = "module ff639.arity.nested\n\nimport std.types { Bool }\n\nfn ff_take(xs: List<Bool>) -> Bool { true }\n\nfn ff_probe(x: Bool) -> Bool { ff_take(xs: [[x, x], [x]]) }\n\nfn ff_ctl(x: Bool) -> List<Bool> { [x, x] }"

data ff639_juxtaposed_source: String = "module ff639.arity.juxtaposed\n\nimport std.types { Bool }\n\nfn ff_take(xs: List<Bool>) -> Bool { true }\n\nfn ff_probe(x: Bool) -> Bool { ff_take(xs: [x x x]) }\n\nfn ff_ctl(x: Bool) -> List<Bool> { [x, x] }"

fn ff639_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

fn ff639_count(node: Node, acc: Ff639Stats) -> Ff639Stats {
  match list_introduction_elements_optional(node: node) {
    Present { value: elements } =>
      Ff639Stats { lists: acc.lists + 1, elements: acc.elements + length(xs: elements) }
    Absent => acc
  }
}


fn ff639_loads(source: String, id: Symbol, unit: Symbol, path: String) -> Bool {
  match module_roots_from_source_root_ingest(
    ingest: Cons { head: ff639_read(source: source, id: id, unit: unit, path: path), tail: Empty },
    lm: dag_language_model()
  ) {
    Accepted { value: roots, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn ff639_has_list(source: String, id: Symbol, unit: Symbol, path: String) -> Bool {
  ff639_stats(source: source, id: id, unit: unit, path: path).lists >= 1
}

fn ff639_stats(source: String, id: Symbol, unit: Symbol, path: String) -> Ff639Stats {
  match module_roots_from_source_root_ingest(
    ingest: Cons { head: ff639_read(source: source, id: id, unit: unit, path: path), tail: Empty },
    lm: dag_language_model()
  ) {
    Accepted { value: roots, diagnostics: _ } =>
      fold_list(
        xs: normalized_tree_roots_to_nodes(roots: roots),
        empty: Ff639Stats { lists: 0, elements: 0 },
        cons: fn(acc, root) {
          fold_list(
            xs: node_subtree_nodes(root: root),
            empty: acc,
            cons: fn(inner, n) { ff639_count(node: n, acc: inner) }
          )
        }
      )
    Rejected { diagnostics: _ } => Ff639Stats { lists: 0, elements: 0 }
  }
}

fn ff639_stats_is(source: String, id: Symbol, unit: Symbol, path: String, lists: Int, elements: Int) -> Bool {
  let s = ff639_stats(source: source, id: id, unit: unit, path: path)
  s.lists == lists && s.elements == elements
}

test fn ff639_three_lowered_arity_holds() -> Bool {
  ff639_stats_is(
    source: ff639_three_source,
    id: ^ff639_three_artifact,
    unit: ^ff639_three_cu,
    path: "src/v2/test/fixture/parse/ff639_arity_three.dag",
    lists: 5,
    elements: 8
  )
}

