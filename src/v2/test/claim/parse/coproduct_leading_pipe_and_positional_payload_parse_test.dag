module v2.test.parse.coproduct_leading_pipe_and_positional_payload_parse

import test.claim.parse_test_coproduct_leading_pipe { cp_lowers }

// THE FOUR fn-FRAGMENT LOWERING CLAIMS, HELD UNGATED. They are the coproduct claims whose fragment is a
// whole fn declaration; at that grain each exceeds the required floor's CPU enrolment margin (floor run
// 37456790634: 441-587 ms against 391 ms), a wall no declared eval-step drop lowers. So they stay outside
// required_gate_prefixes, as they were before the v2.test.parse census (gunbc#13372) gated their
// siblings in test.claim.parse_test_coproduct_leading_pipe: they run only when a change touches them, and
// a red here can stand on main unseen. STATED FRONTIER: gunbc.recurring_failure_mode
// fn_fragment_lowering_exceeds_the_enrolment_margin, whose trigger gates them.

// The positional row alone, with no leading `|`, at its construction site: the front end CONSUMES
// the spelling through normalize. The field-"0" lowering itself, the construction's operand and
// the binder are the subject of v2.test.parse.variant_field_lowering.
test fn positional_payload_without_leading_pipe_with_construction_normalizes_holds() -> Bool {
  cp_lowers(text: "fn wrap(x: Int) -> C {\n  A(x)\n}", production: ^dag_production_fn_decl)
}

// ELIMINATION BINDS THE BINDER. gunbc#11998 turned the silent loss of `A(x) => x`'s binder into a
// typed refusal until variant fields lowered; they lower now and the arm lowers -- the shape it binds
// through is asserted by v2.test.parse.variant_field_lowering vf_positional_pattern_binds_field_zero,
// so this row keeps only the route half.
test fn positional_pattern_binder_normalizes_holds() -> Bool {
  cp_lowers(text: "fn unwrap(c: C) -> Int {\n  match c {\n    A(x) => x\n    B => 0\n  }\n}", production: ^dag_production_fn_decl)
}

// A wildcard payload binds nothing, so nothing is lost and it still lowers: std.content_hash
// content_hash_family is exactly this shape (`Fnv1a64(_) => Fnv1a64StructuralFamily`).
test fn positional_wildcard_pattern_still_normalizes_holds() -> Bool {
  cp_lowers(text: "fn tag(c: C) -> Int {\n  match c {\n    A(_) => 1\n    B => 0\n  }\n}", production: ^dag_production_fn_decl)
}

// The braced spelling of the same elimination still lowers.
test fn braced_pattern_binder_still_normalizes_holds() -> Bool {
  cp_lowers(text: "fn unwrap(c: C) -> Int {\n  match c {\n    A { v: x } => x\n    B => 0\n  }\n}", production: ^dag_production_fn_decl)
}
