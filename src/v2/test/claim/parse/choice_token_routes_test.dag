module v2.test.parse.choice_token_routes

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE PREPARED ROUTE TABLE MUST ANSWER EXACTLY WHAT THE INLINE DISPATCH ANSWERED. The rule is restated
// here as the oracle, in the order parse_choice_on_present_token used to evaluate it, rather than
// called through choice_token_route_for_class -- a witness that asked the table's own builder would
// agree with itself. Checked at every choice of the real .dag grammar, for every token class in
// either FIRST set and for one class in neither (which must route to backtracking by absence).
type InlineChoiceRoute
  = InlineLeft
  | InlineRight
  | InlineBacktrack

fn inline_choice_route(left_first: GrammarExprFirstFold, right_first: GrammarExprFirstFold, token_class: Symbol) -> InlineChoiceRoute {
  if symbol_list_contains(xs: left_first.terminals, item: token_class) && !symbol_list_contains(xs: right_first.terminals, item: token_class) {
    InlineLeft
  } else {
    if symbol_list_contains(xs: right_first.terminals, item: token_class) && !symbol_list_contains(xs: left_first.terminals, item: token_class) {
      InlineRight
    } else {
      if left_first.nullable && symbol_list_contains(xs: right_first.terminals, item: token_class) {
        InlineRight
      } else {
        InlineBacktrack
      }
    }
  }
}

fn table_choice_route(routes: Map<Symbol, ChoiceTokenRoute>, token_class: Symbol) -> InlineChoiceRoute {
  match map_lookup(m: routes, key: token_class) {
    Present { value: ChoiceRouteLeft } => InlineLeft
    Present { value: ChoiceRouteRight } => InlineRight
    Absent => InlineBacktrack
  }
}

type ChoiceRouteCensus {
  choices: Int
  classes_checked: Int
  disagreements: Int
}

fn choice_route_census_empty() -> ChoiceRouteCensus {
  ChoiceRouteCensus { choices: 0, classes_checked: 0, disagreements: 0 }
}

fn choice_route_census_one_choice(
  census: ChoiceRouteCensus,
  left_first: GrammarExprFirstFold,
  right_first: GrammarExprFirstFold,
  routes: Map<Symbol, ChoiceTokenRoute>
) -> ChoiceRouteCensus {
  let classes = list_snoc_item(
    xs: list_append(left: left_first.terminals, right: right_first.terminals),
    item: ^choice_token_routes_class_in_neither_first_set
  )
  fold_list(
    xs: classes,
    empty: ChoiceRouteCensus {
      choices: census.choices + 1,
      classes_checked: census.classes_checked,
      disagreements: census.disagreements
    },
    cons: fn(acc, token_class) {
      ChoiceRouteCensus {
        choices: acc.choices,
        classes_checked: acc.classes_checked + 1,
        disagreements: if inline_choice_route(left_first: left_first, right_first: right_first, token_class: token_class)
          == table_choice_route(routes: routes, token_class: token_class) {
          acc.disagreements
        } else {
          acc.disagreements + 1
        }
      }
    }
  )
}

fn choice_route_census_expr(census: ChoiceRouteCensus, expr: PreparedGrammarExpr) -> ChoiceRouteCensus {
  match expr {
    PreparedTerminal { token_class: _, stamp: _ } => census
    PreparedNonterminal { production: _ } => census
    PreparedSequence { left: left, right: right } =>
      choice_route_census_expr(census: choice_route_census_expr(census: census, expr: left), expr: right)
    PreparedChoice { left: left, right: right, left_first: left_first, right_first: right_first, ambiguous: _, routes: routes } =>
      choice_route_census_expr(
        census: choice_route_census_expr(
          census: choice_route_census_one_choice(census: census, left_first: left_first, right_first: right_first, routes: routes),
          expr: left
        ),
        expr: right
      )
    PreparedOptional { element: element } => choice_route_census_expr(census: census, expr: element)
    PreparedRepeat { element: element } => choice_route_census_expr(census: census, expr: element)
  }
}

fn choice_route_census_dag_grammar() -> Optional<ChoiceRouteCensus> {
  match prepare_grammar(grammar: dag_language_model().grammar) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: prepared, diagnostics: _ } =>
      match prepared {
        PreparedVoidGrammar => optional_absent()
        PreparedModeled { modeled: modeled } =>
          optional_present(value: fold_list(
            xs: modeled.validated.root.productions,
            empty: choice_route_census_empty(),
            cons: fn(acc, production) {
              match map_lookup(m: modeled.analysis.prepared_exprs, key: production.name) {
                Present { value: expr } => choice_route_census_expr(census: acc, expr: expr)
                Absent => ChoiceRouteCensus {
                  choices: acc.choices,
                  classes_checked: acc.classes_checked,
                  disagreements: acc.disagreements + 1
                }
              }
            }
          ))
      }
  }
}

fn choice_route_census_choices(census: ChoiceRouteCensus) -> Int {
  census.choices
}

fn choice_route_census_classes_checked(census: ChoiceRouteCensus) -> Int {
  census.classes_checked
}

fn choice_route_census_disagreements(census: ChoiceRouteCensus) -> Int {
  census.disagreements
}

// Non-vacuous by construction: the census must have visited choices and classes, not just found
// zero disagreements among nothing.
test fn prepared_choice_routes_agree_with_the_inline_dispatch_rule() -> Bool {
  match choice_route_census_dag_grammar() {
    Absent => false
    Present { value: census } =>
      (choice_route_census_choices(census: census) > 0)
        && (choice_route_census_classes_checked(census: census) > choice_route_census_choices(census: census))
        && (choice_route_census_disagreements(census: census) == 0)
  }
}
