// A parse-door refusal is typed, not merely non-acceptance: tokenize ACCEPTS the source and parse
// REJECTS it with this fatal reason, raised by the parse stage from a grammar row's Expect
// (v2.std.parse_refusal_reason), never the generic ^parse_g0_tokens_remain that would collapse the
// five service-family refusals into one.
fn refuses_at_parse_as(src: String, reason: Symbol) -> Bool {
  let lm = probe_cached_lm
  match tokenize_prepared(text: src, file: ^probe, prepared: dag_prepared_lex()) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == reason
      }
    Rejected { diagnostics: _ } => false
  }
}

// Control: the typed assertion discriminates. The generic reason is not the missing-name refusal's
// reason, so the five claims above cannot go green on a collapsed refusal.
test fn a_parse_refusal_under_another_reason_is_not_accepted_holds() -> Bool {
  !refuses_at_parse_as(src: missing_name_red_source, reason: ^parse_g0_tokens_remain)
}

data wrong_marker_word_source: String = "module m\nservicee S {\n}\n"

data wrong_marker_case_source: String = "module m\nService S {\n}\n"

data wrong_operation_entry_word_source: String = "module m\nservice S {\n  operation Op {\n    reqires Network\n  }\n}\n"

// LIMB 3, A MEASURED LIMITATION -- NOT per-marker typed coverage. A wrong word in the service MARKER
// position is refused at the parse door (tokenize accepts, parse rejects) but with the GENERIC
// ^parse_g0_tokens_remain: the marker is a declaration-start alternative, so `servicee` is not
// distinguishable from "not a service declaration at all" and the parse stage has nothing more
// specific to say. These two claims pin the observed refusal, raising stage and reason; they are
// green only because the reason is generic, and assert no typed marker reason.
test fn a_wrong_marker_word_is_refused_at_parse_with_the_generic_reason_holds() -> Bool {
  refuses_at_parse_as(src: wrong_marker_word_source, reason: ^parse_g0_tokens_remain)
}

test fn a_wrong_marker_case_is_refused_at_parse_with_the_generic_reason_holds() -> Bool {
  refuses_at_parse_as(src: wrong_marker_case_source, reason: ^parse_g0_tokens_remain)
}

// Discriminator: the genericity above is a property of POSITION, not of weak refusal machinery. A
// wrong word inside an operation body has its own typed reason.
test fn a_wrong_word_in_an_operation_body_has_its_own_typed_reason_holds() -> Bool {
  refuses_at_parse_as(src: wrong_operation_entry_word_source, reason: ^parse_operation_body_entry_unknown)
}

test fn plain_type_still_parses_holds() -> Bool {
  parses(src: plain_type_source)
}

// ROUTE, not only parse. A service LOWERS at declaration grade. A service-level transport has no
// operation entry to attach to and refuses located as unread. A config-only service admits (XL-2 3c);
// an empty service parses and is refused at normalize (see its claim).
// This pair was the retention route before the lowering landed; the climb keeps it as the permanent
// control that normalize discriminates on what a service carries (gunbc.design_argument::guarantee_ladder (dissolution on climb)). The type
// control is the positive half: a lowered type declaration is the cheapest lowered item.
fn refused_as(ne: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  fold_list(
    xs: ne.tail,
    empty: ne.head.reason == reason,
    cons: fn(found, d) { found || d.reason == reason }
  )
}

fn normalize_refuses_as(src: String, reason: Symbol) -> Bool {
  match parse_src(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: a, diagnostics: _ } =>
      match normalize(parse_tree: a.tree) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: r } => refused_as(ne: r, reason: reason)
      }
  }
}

fn normalize_admits(src: String) -> Bool {
  match parse_src(src: src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: a, diagnostics: _ } =>
      match normalize(parse_tree: a.tree) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

// Each route needs only a service declaration, not a populated one. The populated smallest_service
// fixture measured 396ms here against the 302ms enrolment margin (floor run 35440687934), paying to
// parse and normalize an operation this claim never inspects (gunbc.design_argument::single_authority, a witness discriminates at
// one interface).
data empty_service_source: String = "module m\nservice S {}\n"

data transport_only_service_source: String = "module m\nservice S {\n  transport shell { argv: [] }\n}\n"

test fn a_service_with_a_transport_is_refused_at_the_normalized_tree_door_holds() -> Bool {
  normalize_refuses_as(src: transport_only_service_source, reason: ^body_lowering_reason_service_member_unread)
}

// WHAT MAIN DOES TODAY, NOT A RULING ON WHAT IT SHOULD DO. `service S {}` parses (the service row's
// body is repeat(service_body_entry), which admits zero entries) and normalize REFUSES it with
// ^namespace_graft_body_dissolved_refused (measured at main's released binary; it is refused under the
// same reason when the module also carries a function, so the module's lack of a function is not the
// cause). It is not refused under wrapper_retention_not_normalized or service_member_unread, and a
// config-only service admits. Whether an empty service is ADMISSIBLE IS UNSETTLED. Looked at, none
// decides it: the grammar row (zero entries parse; parse is not normalize); the
// compile_door_cause_ownership row for service_realization_unreachable ("a service whose members lower
// admits on both normalize grades" is vacuously true for zero members, so it does not decide it); this
// module's earlier comment claiming an empty service admits (a comment, not an authority); and the design
// rulings searched. This claim records only the measured refusal and its reason so the divergence is
// explicit and countable; it does not assert that refusal is right, and it changes no admission. The open
// question is recorded at #gunbc.integration_concern.empty_service_parses_but_normalize_refuses_it::empty_service_parses_but_normalize_refuses_it
// and this claim is re-pinned by whatever ruling settles it.
test fn an_empty_service_parses_and_is_refused_at_normalize_by_the_namespace_graft_holds() -> Bool {
  parses(src: empty_service_source) && normalize_refuses_as(src: empty_service_source, reason: ^namespace_graft_body_dissolved_refused)
}

test fn type_control_is_admitted_at_the_normalized_tree_door_holds() -> Bool {
  normalize_admits(src: plain_type_source)
}

test fn config_only_service_is_admitted_at_the_normalized_tree_door_holds() -> Bool {
  normalize_admits(src: config_only_service_source)
}

data service_generic_param_source: String = "module m\nservice S<T> {\n}\n"
data service_generic_param_name_source: String = "module m\nfn f<T>(service: T) -> T { service }\n"

test fn a_service_declaration_admits_no_generic_parameter_holds() -> Bool {
  tokenizes(src: service_generic_param_source) && refuses_at_parse_as(src: service_generic_param_source, reason: ^parse_service_body_open_brace_missing)
}

test fn the_word_service_still_parses_beside_a_generic_parameter_holds() -> Bool {
  parses(src: service_generic_param_name_source)
}
