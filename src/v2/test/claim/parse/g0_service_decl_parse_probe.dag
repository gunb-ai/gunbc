module v2.test.claim.parse.g0_service_decl_parse_probe

import v2.compiler.normalize { normalize }
import v2.compiler.parse { ParseArtifact, parse_module }
import v2.compiler.program_assembly { dag_prepared_lex }
import v2.compiler.tokenize { tokenize_prepared }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Diagnostic, NonEmptyDiagnostics, Outcome, Rejected, diagnostics_fatal_reason }
import v2.std.language_model { LanguageModel }
import std.algebra { fold_list }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol, well_formed }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SH-3: G0 had no service production. v1 parse_service_def expects keyword
// `service`, then a dotted name, then a brace body of operations (and optional
// transport/config). The marker words are literal terminals over ident, not keyword classes. The first native fatal was leftover token `service` at
// dag/extdeps/access/posix_effective_principal_read_op.dag. The family is the
// nest below; service-level `config` is admitted over v1's closed field set, and the v2-inline
// operation form remains v1-admitted remainder. Lowering is a separate stage: the route rows below
// pin what normalize does with a parsed service.

data probe_cached_lm: LanguageModel = dag_language_model()

fn parse_src(src: String) -> Outcome<ParseArtifact> {
  let lm = probe_cached_lm
  match tokenize_prepared(text: src, file: ^probe, prepared: dag_prepared_lex()) {
    Accepted { value: ts, diagnostics: _ } => parse_module(tokens: ts, grammar: lm.grammar)
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn parses(src: String) -> Bool {
  match parse_src(src: src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn smallest_service_parsed() -> Outcome<ParseArtifact> {
  parse_src(src: smallest_service_source)
}

// A refusal claim names the PARSE DOOR, so it must establish that the door is the thing that
// refused. `parse_src` folds a tokenize rejection and a parse rejection into one `Rejected`, so a
// helper that is merely the negation of `parses` is green whenever ANYTHING fails -- including a
// fixture that never reached the parser. That is the absorbing arm gunbc.design_argument::fail_closed refuses: it widens
// instead of discriminating, and every one of the five service refusals below would have passed
// for a reason it is not about. This helper requires tokenize to ACCEPT and parse to REJECT, so the
// stage is pinned and a fixture that dies in the lexer reds instead of flattering the claim.
fn refuses_at_parse(src: String) -> Bool {
  let lm = probe_cached_lm
  match tokenize_prepared(text: src, file: ^probe, prepared: dag_prepared_lex()) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

data fn_control_source: String = "module m\nfn f() -> Int { 1 }\n"

data smallest_service_source: String = "module m\nservice S {\n  operation Op {\n    input { x: Int }\n    output { y: Int from \"y\" }\n    readonly\n    transport shell { argv: [\"a\"] }\n  }\n}\n"

data missing_name_red_source: String = "module m\nservice {\n  operation Op { input { x: Int } }\n}\n"

data missing_brace_red_source: String = "module m\nservice S\nfn f() -> Int { 1 }\n"

data unknown_modifier_red_source: String = "module m\nservice S {\n  operation Op {\n    input { x: Int }\n    volatile\n    transport shell { argv: [\"x\"] }\n  }\n}\n"

data field_default_source: String = "module m\nservice S {\n  operation Op {\n    input { path: String, max_depth: Int = 1 }\n    transport shell { argv: [\"a\"] }\n  }\n}\n"

data field_default_without_expr_red_source: String = "module m\nservice S {\n  operation Op {\n    input { max_depth: Int = }\n  }\n}\n"

// The service body of dag/extdeps/access/posix_effective_principal_read_op.dag, the first native
// fatal this family exists to clear: newline-separated output fields, exit, mock_response.
data posix_effective_principal_service_source: String = "module m\nservice access.PosixEffectivePrincipal {\n  operation Read {\n    input { read: EffectivePosixPrincipalRead }\n    output {\n      exit_code: Int from \"exit_code\"\n      success: Bool from \"exit_success\"\n      stdout: String from \"stdout\"\n      stderr: String from \"stderr\"\n    }\n    readonly\n\n    transport shell { argv: [\"whoami\"] }\n    exit {\n      0 => Unit\n      nonzero => String \"whoami failed\"\n    }\n    mock_response {\n      0 => { exit_code: 1, success: false, stdout: \"\", stderr: \"hermetic effective-principal observation unavailable\" } \"hermetic access.PosixEffectivePrincipal.Read refuses external identity observation\"\n    }\n  }\n}\n"

data remaining_arms_service_source: String = "module m\nservice S {\n  transport rest { base: \"u\" }\n  operation Op {\n    input { x: Int }\n    idempotent\n    hermetic\n    response {\n      200 => Int\n      404 => String \"missing\"\n    }\n  }\n}\n"

// The shape of the config block in dag/extdeps/github/workflow_runs.dag service
// github.WorkflowRuns: newline-separated fields, one of them a struct literal. Trimmed to two
// fields and no operation so the claim pays only for the production it is about.
data service_config_source: String = "module m\nservice S {\n  config {\n    endpoint: e\n    auth_source: EnvVar { name: \"T\" }\n  }\n}\n"

// v1 parse_config_fields refuses a field outside endpoint/auth/auth_input/auth_source/rate_limit
// by name; the grammar's closed choice must refuse it too.
data service_config_unknown_field_red_source: String = "module m\nservice S {\n  config {\n    endpoint: e\n    region: r\n  }\n}\n"

data service_config_without_colon_red_source: String = "module m\nservice S {\n  config {\n    endpoint e\n  }\n}\n"

// A service whose only entry is config: config binds the transport (endpoint, auth), so it is
// realization, set aside, and full normalize refuses the service for it -- carried to a typed
// refusal, never dropped on the way to resolve.
// The config is nonempty: since #12974 the service realization conformance wall refuses an empty
// config as service_realization_config_malformed (v2.compiler.service_realization
// realization_config_refusal), which is a different refusal from the set-aside one asserted here.
data config_only_service_source: String = "module m\nservice S { config { endpoint: e } }\n"

data exit_entry_without_arrow_red_source: String = "module m\nservice S {\n  operation Op {\n    exit {\n      0 Unit\n    }\n  }\n}\n"

// v1 parse_mock_response_entries_acc takes the trailing description as optional, so the
// refusal pinned here is the missing expression, not a missing message.
data mock_entry_without_expr_red_source: String = "module m\nservice S {\n  operation Op {\n    mock_response {\n      0 =>\n    }\n  }\n}\n"

// The plain type control. The field tail is no longer service-scoped: since #12810 every field
// admits v1's `[from "key"] [= default]` tail at parse, a record field with a wire key refuses at
// lowering, and since #12948 a record field default lowers onto its binder. Those routes are
// asserted by v2.test.claim.parse.record_field_tail, so the two claims that pinned a PARSE refusal
// here were deleted as contradicting a ruled change rather than re-pointed at a second copy.
data plain_type_source: String = "module m\ntype T { x: Int }\n"

test fn fn_control_still_parses_holds() -> Bool {
  parses(src: fn_control_source)
}

test fn smallest_service_parses_holds() -> Bool {
  match smallest_service_parsed() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn smallest_service_tree_is_well_formed_holds() -> Bool {
  match smallest_service_parsed() {
    Accepted { value: a, diagnostics: _ } => well_formed(n: a.tree)
    Rejected { diagnostics: _ } => false
  }
}

test fn service_without_name_still_refuses_holds() -> Bool {
  refuses_at_parse_as(src: missing_name_red_source, reason: ^parse_service_name_missing)
}

test fn service_without_brace_still_refuses_holds() -> Bool {
  refuses_at_parse_as(src: missing_brace_red_source, reason: ^parse_service_body_open_brace_missing)
}

test fn unknown_operation_modifier_still_refuses_holds() -> Bool {
  refuses_at_parse_as(src: unknown_modifier_red_source, reason: ^parse_operation_body_entry_unknown)
}

// RESTORED (gunbc#11955). An earlier revision retired this claim as a gunbc.design_argument::guarantee_ladder (dissolution on climb) climb, arguing that
// deleting the twelve keyword lex rules left its RED unauthorable. That is the one thing gunbc.design_argument::guarantee_ladder (dissolution on climb)
// does not permit: a climb dissolves the lower-rung PRODUCTION machinery and never the evidence.
// The RED is authorable and this fixture IS the authoring -- 4b decides the question at the
// fixture boundary, not the corpus boundary, and plain source using the marker words as ordinary
// names is exactly source handed to the compiler by a fixture. Deleting the lex rules removes the
// mechanism that could break name usability TODAY; it is not evidence that a later lexer or
// grammar change cannot add one, and this claim is what would notice.
//
// G0 IS THE SUBJECT, NOT THE SEED. Seven of the marker words are reserved in the SEED's
// extdeps.languages.dag.syntax dag_keyword_set, so this text is not writable as .dag source today;
// it is tokenized here by G0's own lex rules, which carry no keyword entry for any of them. The
// asymmetry is real and belongs to the seed, not to this family.
data keyword_as_name_source: String = "module m\nfn f(from: Int, input: Int) -> Int { let transport = from\n transport + input }\n"

// THE STAGE PIN'S OWN CONTROL. refuses_at_parse replaced a helper that was the negation of
// `parses`, and a stage pin nobody has seen discriminate is indistinguishable from the helper it
// replaced. This source dies in the LEXER, so the old helper called it a refusal and the new one
// must not: refuses_at_parse is false here, and false is the passing reading. Delete the tokenize
// arm of refuses_at_parse and this claim goes red while every service refusal above stays green --
// which is the point, since those five could not tell the two doors apart either.
data lexically_invalid_source: String = "module m\nfn f() -> Int { 1 @ 2 }\n"

test fn a_lexical_failure_is_not_a_parse_door_refusal_holds() -> Bool {
  match refuses_at_parse(src: lexically_invalid_source) {
    true => false
    false => true
  }
}

test fn service_keywords_remain_usable_as_names_holds() -> Bool {
  parses(src: keyword_as_name_source)
}

// THE RETAINED NAME-USABILITY CONTROL, ALL SEVEN SERVICE-FAMILY WORDS. The fixture above spells three
// (from, input, transport); the row names seven: service, operation, requires, transport, exit,
// response and mock_response. Each is used here as an ordinary name -- a parameter, a let binding --
// in one module handed to G0's own lexer and grammar. It reds if any later change keywords a spelling
// again. Two claims, one per boundary: tokenize ACCEPTS it (the lexical boundary, no keyword class
// intercepts a word), and parse ACCEPTS it (the grammar boundary, a plain-name slot is not a choice
// among marker words).
data service_family_words_as_names_source: String = "module m\nfn f(service: Int, operation: Int, requires: Int, response: Int) -> Int { let transport = service\n let exit = operation\n let mock_response = requires\n transport + exit + mock_response + response }\n"

fn tokenizes(src: String) -> Bool {
  match tokenize_prepared(text: src, file: ^probe, prepared: dag_prepared_lex()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn all_seven_service_family_words_tokenize_as_names_holds() -> Bool {
  tokenizes(src: service_family_words_as_names_source)
}

test fn all_seven_service_family_words_parse_as_names_holds() -> Bool {
  parses(src: service_family_words_as_names_source)
}

test fn field_default_parses_holds() -> Bool {
  parses(src: field_default_source)
}

test fn field_default_without_expr_still_refuses_holds() -> Bool {
  refuses_at_parse(src: field_default_without_expr_red_source)
}

test fn posix_effective_principal_service_parses_holds() -> Bool {
  parses(src: posix_effective_principal_service_source)
}

