module test.claim.parse_test_swift_grammar

data swift_extended_fn_source: String = "func choose(x: Int) -> Int { let y = x + 1\nif y > 0 { return y }\nreturn 0 }"

fn swift_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn swift_tokenize_and_parse() -> Outcome<ParseTree> {
  match tokenize(
    text: swift_extended_fn_source,
    file: ^swift_parse_file,
    rules: swift_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: swift_grammar())
  }
}

// Swift lex/grammar accepts an extended function with let, if, return, and binary expressions.
// Formerly the data row `claim_swift_extended_function_parses: TestClaim = EqualsClaim`, which no runner executes (the
// required floor runs `test fn` claims only): the same lhs == rhs predicate, made runnable by the
// v2.test.parse census (gunbc#13372).
test fn claim_swift_extended_function_parses_holds() -> Bool {
  (swift_parse_accepted(out: swift_tokenize_and_parse())) == true
}
