module v2.test.parse.d1_declaration_grammar_parse

import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_lex,
  parse_subtree_find_production_captured,
  ParseSubtreeAbsent,
  ParseSubtreeFound
}
import v2.std.algebra { list_snoc_item }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Edge, Named, Node, Positional }
import v2.std.optional { Absent, Optional, Present }
import v2.std.text { string_join }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn d1_tokenize_parse(text: String, file: Symbol) -> Outcome<Node> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prepared, diagnostics: residue } =>
      bind_outcome(
        o: tokenize(text: text, file: file, rules: dag_lex()),
        f: fn(token_stream) {
          match parse_module_prepared(
            tokens: token_stream,
            prepared: prepared,
            validation_residue: residue
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: artifact, diagnostics: d } =>
              Accepted { value: artifact.tree, diagnostics: d }
          }
        }
      )
  }
}

fn d1_parse_accepted(text: String, file: Symbol) -> Bool {
  match d1_tokenize_parse(text: text, file: file) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn d1_normalize_accepted(text: String, file: Symbol) -> Bool {
  match d1_tokenize_parse(text: text, file: file) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match normalize(parse_tree: tree) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

fn d1_tree_carries_where_clause(root: Node) -> Bool {
  match parse_subtree_find_production_captured(
    root: root,
    emitted: ^dag_surface_where_refinement_clause
  ) {
    ParseSubtreeFound { captured: _ } => true
    ParseSubtreeAbsent => false
  }
}

fn d1_edge_names_where_clause(e: Edge) -> Bool {
  match e.label {
    Named { name: n } => n == ^dag_surface_where_refinement_clause
    _ => false
  }
}

fn d1_find_where_host_conj(root: Node) -> Optional<Node> {
  match fold(root.children, init: false, f: fn(found, e) {
    found || d1_edge_names_where_clause(e: e)
  }) {
    true => Present { value: root }
    false =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => d1_find_where_host_conj(root: e.target)
        }
      })
  }
}

fn d1_edge_label_text(e: Edge) -> String {
  match e.label {
    Named { name: n } => symbol_lexeme(sym: n)
    Positional => "positional"
  }
}

fn d1_child_labels(n: Node) -> String {
  string_join(
    fields: fold(n.children, init: [], f: fn(acc, e) {
      list_snoc_item(xs: acc, item: d1_edge_label_text(e: e))
    }),
    separator: ", "
  )
}

fn d1_find_flag(root: Node) -> String {
  match d1_tree_carries_where_clause(root: root) {
    true => "find=true"
    false => "find=false"
  }
}

fn d1_locus_from_root(root: Node) -> String {
  match d1_find_where_host_conj(root: root) {
    Present { value: host } =>
      string_join(
        fields: ["variant_conj: [", d1_child_labels(n: host), "] ", d1_find_flag(root: root)],
        separator: ""
      )
    Absent =>
      string_join(
        fields: [
          "host-conj-absent: root children [",
          d1_child_labels(n: root),
          "] ",
          d1_find_flag(root: root)
        ],
        separator: ""
      )
  }
}

data d1_where_reproducer: String = "module m\ntype A = NonEmptyStr where brand(\"A\")\nfn f() -> Int { 1 }\n"
data d1_where_control: String = "module m\ntype A = NonEmptyStr\nfn f() -> Int { 1 }\n"
data d1_where_bare: String = "module m\ntype A = NonEmptyStr where non_empty\nfn f() -> Int { 1 }\n"
data d1_where_empty: String = "module m\ntype A = NonEmptyStr where\nfn f() -> Int { 1 }\n"

test fn cause_a_where_refinement_clause_parses_holds() -> Bool {
  d1_parse_accepted(text: d1_where_reproducer, file: ^d1_where_reproducer)
    && d1_parse_accepted(text: d1_where_bare, file: ^d1_where_bare)
    && d1_parse_accepted(text: d1_where_control, file: ^d1_where_control)
}

test fn cause_a_where_clause_parse_tree_carries_holds() -> Bool {
  match d1_tokenize_parse(text: d1_where_reproducer, file: ^d1_where_carry_parse) {
    Rejected { diagnostics: _ } => false
    Accepted { value: brand_tree, diagnostics: _ } =>
      match d1_tokenize_parse(text: d1_where_bare, file: ^d1_where_carry_parse_bare) {
        Rejected { diagnostics: _ } => false
        Accepted { value: bare_tree, diagnostics: _ } =>
          d1_tree_carries_where_clause(root: brand_tree)
            && d1_tree_carries_where_clause(root: bare_tree)
      }
  }
}

test fn cause_a_where_control_normalizes_holds() -> Bool {
  d1_normalize_accepted(text: d1_where_control, file: ^d1_where_control_norm)
}

test fn cause_a_where_reproducer_normalizes_holds() -> Bool {
  d1_normalize_accepted(text: d1_where_reproducer, file: ^d1_where_norm)
}

fn cause_a_where_clause_survives_normalize_locus() -> String {
  match d1_tokenize_parse(text: d1_where_reproducer, file: ^d1_where_carry_norm) {
    Rejected { diagnostics: r } =>
      string_join(
        fields: ["parse-refused: ", symbol_lexeme(sym: r.head.reason)],
        separator: ""
      )
    Accepted { value: brand_tree, diagnostics: _ } =>
      match normalize(parse_tree: brand_tree) {
        Rejected { diagnostics: r } =>
          string_join(
            fields: ["normalize-refused: ", symbol_lexeme(sym: r.head.reason)],
            separator: ""
          )
        Accepted { value: brand_normalized, diagnostics: _ } =>
          d1_locus_from_root(root: brand_normalized.root)
      }
  }
}

test fn cause_a_where_clause_survives_normalize_holds() -> Bool {
  match d1_tokenize_parse(text: d1_where_reproducer, file: ^d1_where_carry_norm) {
    Rejected { diagnostics: _ } => false
    Accepted { value: brand_tree, diagnostics: _ } =>
      match d1_tokenize_parse(text: d1_where_bare, file: ^d1_where_carry_norm_bare) {
        Rejected { diagnostics: _ } => false
        Accepted { value: bare_tree, diagnostics: _ } =>
          match normalize(parse_tree: brand_tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: brand_normalized, diagnostics: _ } =>
              match normalize(parse_tree: bare_tree) {
                Rejected { diagnostics: _ } => false
                Accepted { value: bare_normalized, diagnostics: _ } =>
                  d1_tree_carries_where_clause(root: brand_normalized.root)
                    && d1_tree_carries_where_clause(root: bare_normalized.root)
              }
          }
      }
  }
}

test fn cause_a_empty_where_clause_refuses_holds() -> Bool {
  !d1_parse_accepted(text: d1_where_empty, file: ^d1_where_empty)
}
