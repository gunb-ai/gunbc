    Token { class: ^dag_token_ident, lexeme: "Z", file: ^coproduct_parse_probe, start: 26, end: 27 },
    Token { class: ^dag_token_rparen, lexeme: ")", file: ^coproduct_parse_probe, start: 27, end: 28 },
    Token { class: ^dag_token_pipe, lexeme: "|", file: ^coproduct_parse_probe, start: 29, end: 30 },
