test fn cps_fidelity_4() -> Bool {
  supplied_stream_matches_tokenize(
    text: "module m.t\n\ntype C = A(X, Z) | B\n",
    file: ^coproduct_parse_probe,
    supplied: cps_stream_4()
  )
}

