fn cps_parsed_1() -> Outcome<Node> {
  supplied_stream_parse(tokens: cps_stream_1())
}

fn cps_parsed_2() -> Outcome<Node> {
  supplied_stream_parse(tokens: cps_stream_2())
}

fn cps_parsed_4() -> Outcome<Node> {
