    Token { class: ^dag_token_ident, lexeme: "R", file: ^coproduct_parse_probe, start: 17, end: 18 },
    Token { class: ^dag_token_lparen, lexeme: "(", file: ^coproduct_parse_probe, start: 18, end: 19 },
    Token { class: ^dag_token_ident, lexeme: "X", file: ^coproduct_parse_probe, start: 19, end: 20 },
