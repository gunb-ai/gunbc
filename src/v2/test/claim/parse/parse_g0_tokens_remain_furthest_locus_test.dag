module v2.test.claim.parse.parse_g0_tokens_remain_furthest_locus

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE REFUSAL IS LOCATED WHERE THE PARSE STOPPED, NOT WHERE THE FAILED ITEM BEGAN. The gen-two
// census of v2.compiler.compile (probe/neat-boar-16-gen2-census) reported all 387
// parse_g0_tokens_remain refusals at the first token of a top-level item -- `test` 204, `fn` 117,
// `service` 41 -- because the module's `repeat` stops at an item whose production fails as a
// whole, and the diagnostic named the first leftover token. The first claim is the treatment: an
// unadmitted token inside a fn body is reported at that token. The second is the control that the
// furthest rule does not invent depth: a failure that consumed nothing inside the item stays at
// the item's first token. The third pins the offset unit as it stands.

// The fatal diagnostic is the last one (v2.std.diagnostic diagnostics_fatal); grammar advisories ride
// ahead of it. -1 is no tokens_remain refusal on a source extent; every claim compares against a positive offset.
fn tokens_remain_start(src: String) -> Int {
  let lm = dag_language_model()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } =>
          let fatal = diagnostics_fatal(d: d)
          if fatal.reason == ^parse_g0_tokens_remain {
            match fatal.at {
              SourcePortLocus { anchor: _, file: _, extent: ByteRange { start: s, end: _ } } => s
              SourcePortLocus { anchor: _, file: _, extent: WholeFile } => -1
              Textual { file: _, extent: _ } => -1
              NodeLocus { anchor: _ } => -1
              InvariantPortLocus { anchor: _, invariant: _ } => -1
              DeclarationLocus { declaration: _ } => -1
            }
          } else {
            -1
          }
        Accepted { value: _, diagnostics: _ } => -1
      }
    Rejected { diagnostics: _ } => -1
  }
}

// `fn f` begins at 32; the `]` the let initializer cannot start with is at 58.
test fn tokens_remain_mid_item_failure_is_located_at_the_construct() -> Bool {
  tokens_remain_start(src: "module m.t\nfn ok() -> Int { 1 }\nfn f() -> Int {\n  let x = ]\n  x\n}\n") == 58
}

test fn tokens_remain_item_level_failure_stays_at_the_item_start() -> Bool {
  tokens_remain_start(src: "module m.t\nfn ok() -> Int { 1 }\n]\n") == 32
}

// THE UNIT IS CODE POINTS TODAY, WHATEVER THE EXTENT IS CALLED. Three two-byte scalars precede the
// `]`: code-point offset 60, byte offset 63. v2.compiler.tokenize advances its position by the
// lexeme's length in code points and the carrier is v2.std.diagnostic ByteRange, so every v2 token
// extent is mislabelled, not only this refusal's. Converting is a lexer-wide change with consumers
// that slice source by these offsets; when it lands this claim must flip to 63, not be deleted.
test fn tokens_remain_offset_unit_is_code_points_as_lexed() -> Bool {
  tokens_remain_start(src: "module m.t\ndata s: String = \"ééé\"\nfn f() -> Int {\n  let x = ]\n  x\n}\n") == 60
}

// THE LOCUS DOES NOT DEPEND ON CACHE WARMTH. The seed serves parse memo entries across parses of
// one token stream, so the second parse here meets entries the first one stored; each entry carries
// its own subparse's furthest record, and the served parse must land on the same token.
test fn tokens_remain_locus_is_the_same_on_a_served_reparse() -> Bool {
  let src = "module m.t\nfn ok() -> Int { 1 }\nfn f() -> Int {\n  let x = ]\n  x\n}\n"
  let cold = tokens_remain_start(src: src)
  let warm = tokens_remain_start(src: src)
  cold == 58 && warm == 58
}
