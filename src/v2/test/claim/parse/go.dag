module v2.test.parse.go

fn go_parse_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^go_parse_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^go_parse_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn go_parse_accepted(out: v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn go_tokenize_and_parse() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  match tokenize(
    text: go_source_text,
    file: ^go_parse_file,
    rules: go_lex()
  ) {
    Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: go_grammar())
  }
}

data claim_go_add_function_parses: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "Go corpus symmetry accepts the current add-function source through the Go lex/grammar",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_parse_bool_atom(
    b: go_parse_accepted(out: go_tokenize_and_parse())
  ),
  rhs: go_parse_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}
