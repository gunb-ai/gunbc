module v2.test.parse.rust_wave2a

import v2.compiler.tokenize { TokenStream, tokenize }
import v2.compiler.parse { ParseTree, parse }
import v2.extdeps.languages.rust { rust_wave2_lex, rust_wave2_grammar }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}
data rust_wave2a_non_source: String = "fn choose(x: i32, y: i32) -> i32 { let z = x + 1;\nif z > 0 { return z }\nreturn 0 }"

data rust_wave2a_return_semi_source: String = "fn r() -> i32 { return; }"

data rust_wave2a_layout_tight_source: String = "fn choose(x: i32, y: i32) -> i32 { let\nz=x+1;\nif z>0 { return z; }\nreturn 0; }"

fn rust_wave2a_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^rust_wave2a_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^rust_wave2a_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn rust_wave2a_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn rust_wave2a_tokenize_and_parse_source(text: String) -> Outcome<ParseTree> {
  match tokenize(
    text: text,
    file: ^rust_wave2a_file,
    rules: rust_wave2_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: rust_wave2_grammar())
  }
}

fn rust_wave2a_tokenize_and_parse() -> Outcome<ParseTree> {
  rust_wave2a_tokenize_and_parse_source(text: rust_wave2a_non_source)
}

data claim_rust_wave2a_non_function_parses: TestClaim = EqualsClaim {
  label: "Rust Wave 2a lex/grammar accepts a non-MVP function with let, if, return, and binary expressions",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_wave2a_bool_atom(
    b: rust_wave2a_parse_accepted(out: rust_wave2a_tokenize_and_parse())
  ),
  rhs: rust_wave2a_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_rust_wave2a_return_semi_parses: TestClaim = EqualsClaim {
  label: "Rust Wave 2a accepts return; with layout-free return lexeme and trivia between tokens",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_wave2a_bool_atom(
    b: rust_wave2a_parse_accepted(
      out: rust_wave2a_tokenize_and_parse_source(text: rust_wave2a_return_semi_source)
    )
  ),
  rhs: rust_wave2a_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_rust_wave2a_layout_tight_parses: TestClaim = EqualsClaim {
  label: "Rust Wave 2a accepts tight/newline-separated layout with trivia-separated tokens",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_wave2a_bool_atom(
    b: rust_wave2a_parse_accepted(
      out: rust_wave2a_tokenize_and_parse_source(text: rust_wave2a_layout_tight_source)
    )
  ),
  rhs: rust_wave2a_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
