module v2.test.parse.python

data python_extended_fn_source: String = "def choose(x):\n    y = x + 1\n    if y > 0:\n        return y\n    return 0"

fn python_parse_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^python_parse_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^python_parse_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn python_parse_accepted(out: v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree>) -> Bool {
  match out {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn python_tokenize_and_parse() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  match tokenize(
    text: python_extended_fn_source,
    file: ^python_parse_file,
    rules: python_lex()
  ) {
    v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    v2.std.diagnostic.Accepted { value: stream, diagnostics: _ } =>
      parse(tokens: stream, grammar: python_grammar())
  }
}

data claim_python_extended_function_parses: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "Python lex/grammar accepts an extended function with assignment, if, and indented returns",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_parse_bool_atom(
    b: python_parse_accepted(out: python_tokenize_and_parse())
  ),
  rhs: python_parse_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}
