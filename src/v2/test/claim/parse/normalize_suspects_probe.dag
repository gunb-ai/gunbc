module v2.test.claim.parse.normalize_suspects_probe

// WHO FAILED TO NORMALIZE. CI's reference check refused 241 marked references with
// RunStepTargetCallerUnread / 'cited module read but did not normalize' and truncates its report to the
// first 40 lines, so the modules that actually failed to normalize are not named there. Each file below
// gets two claims: that it classifies accepted, and that it does not refuse with the wall's own cause --
// so a refusal this change caused is distinguishable from one it did not, in one run.

import v2.compiler.parse_acceptance_census { parse_acceptance_of_text }
import v2.std.text { String, char_eq }
import std.algebra { is_prefix_of }

fn verdict(path: String) -> String {
  parse_acceptance_of_text(text: filesystem_read(path: path).content, path: path)
}

fn accepted(path: String) -> Bool { verdict(path: path) == "accepted" }

fn not_wall(path: String) -> Bool {
  !is_prefix_of(prefix: "refused parse_list_element_separator_missing", xs: verdict(path: path), eq: char_eq)
}

test fn f_dag_extdeps_llm_openai_dag_accepted_holds() -> Bool { accepted(path: "dag/extdeps/llm/openai.dag") }
test fn f_dag_extdeps_llm_openai_dag_not_wall_holds() -> Bool { not_wall(path: "dag/extdeps/llm/openai.dag") }
