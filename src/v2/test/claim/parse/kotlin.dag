module v2.test.parse.kotlin

data kotlin_extended_fn_source: String = "fun choose(x: Int): Int { val y: Int = x + 1; if (y > 0) { return y }; return 0 }"

fn kotlin_parse_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^kotlin_parse_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^kotlin_parse_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn kotlin_parse_accepted(out: v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn kotlin_tokenize_and_parse() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  match tokenize(
    text: kotlin_extended_fn_source,
    file: ^kotlin_parse_file,
    rules: kotlin_lex()
  ) {
    Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: kotlin_grammar())
  }
}

data claim_kotlin_extended_function_parses: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "Kotlin lex/grammar accepts an extended function with val, if, return, and binary expressions",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: kotlin_parse_bool_atom(
    b: kotlin_parse_accepted(out: kotlin_tokenize_and_parse())
  ),
  rhs: kotlin_parse_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}
