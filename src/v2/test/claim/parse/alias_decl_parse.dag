module v2.test.parse.alias_decl_parse


data alias_decl_parse_source: String = "module v2.test.parse.alias_decl_probe\n\nalias NodeAlias = v2.std.node.Node\n"

fn alias_decl_parse_tree() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(
      text: alias_decl_parse_source,
      file: ^alias_decl_parse_probe,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      v2.compiler.parse.parse(tokens: token_stream, grammar: lm.grammar)
    }
  )
}

fn alias_decl_find_in_children(tree: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  fold(tree.children, init: v2.std.optional.optional_absent(), f: fn(acc, edge) {
    match acc {
      v2.std.optional.Present { value: _ } => acc
      v2.std.optional.Absent => alias_decl_find_node(tree: edge.target)
    }
  })
}

fn alias_decl_find_node(tree: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: tree) {
    v2.std.optional.Present { value: id } =>
      if id == ^dag_surface_alias_decl {
        v2.std.optional.optional_present(value: tree)
      } else {
        alias_decl_find_in_children(tree: tree)
      }
    v2.std.optional.Absent => alias_decl_find_in_children(tree: tree)
  }
}

fn alias_decl_expected_row() -> v2.std.namespace_alias.AliasBindingRow {
  v2.std.namespace_alias.AliasBindingRow {
    binding: ^NodeAlias,
    target: v2.std.qualified_name.qualified_name_from_dotted_string(dotted: "v2.std.node.Node")
  }
}

fn alias_decl_parse_and_binding_row_holds() -> Bool {
  match alias_decl_parse_tree() {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match alias_decl_find_node(tree: tree) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: decl } =>
          match v2.extdeps.languages.dag.alias_binding_row_from_decl_node(decl: decl, module_root: tree) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
            v2.std.diagnostic.Accepted { value: row, diagnostics: _ } =>
              (row.binding == alias_decl_expected_row().binding)
                && (row.target == alias_decl_expected_row().target)
          }
      }
  }
}

fn alias_decl_keyword_reserved_in_binding_position_red_control_holds() -> Bool {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(
      text: "module probe\nalias alias = v2.std.node.Node\n",
      file: ^alias_decl_reserved_keyword_probe,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      v2.compiler.parse.parse(tokens: token_stream, grammar: lm.grammar)
    }
  ) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

data alias_decl_fill_parse_source: String = "module v2.test.parse.alias_decl_fill_probe\n\ntype AliasTargetType {}\n\nalias AliasBinding = v2.test.parse.alias_decl_fill_probe.AliasTargetType\n"

fn alias_decl_fill_parse_tree() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.tokenize.tokenize(
      text: alias_decl_fill_parse_source,
      file: ^alias_decl_fill_probe,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      v2.compiler.parse.parse(tokens: token_stream, grammar: lm.grammar)
    }
  )
}

fn alias_decl_fill_lexical_lookup_holds() -> Bool {
  match alias_decl_fill_parse_tree() {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match v2.extdeps.languages.dag.qualified_name_from_module_node(root: tree) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
        v2.std.diagnostic.Accepted { value: module_qn, diagnostics: _ } =>
          let idx = v2.compiler.symbol_index_fill.symbol_index_fill_module_root(index: v2.std.symbol_index.empty_symbol_index(), root: tree)
          let target_path = v2.std.qualified_name.qualified_name_snoc(qn: module_qn, segment: ^AliasTargetType)
          match v2.std.symbol_index.symbol_index_lexical_lookup(
            index: idx,
            position: module_qn,
            name: ^AliasBinding
          ) {
            v2.std.symbol_index.LexicalHit { node: hit, path: _ } =>
              match v2.std.symbol_index.symbol_index_lookup(index: idx, qualified_path: target_path) {
                v2.std.optional.Present { value: target } => hit == target
                v2.std.optional.Absent => false
              }
            v2.std.symbol_index.LexicalAmbiguous { candidates: _ } => false
            v2.std.symbol_index.LexicalUnbound => false
          }
      }
  }
}
