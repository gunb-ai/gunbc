module v2.test.parse.alias_decl_parse

import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  DeclarationLocus,
  InvariantPortLocus,
  NodeLocus,
  Outcome,
  Rejected,
  SourcePortLocus,
  Textual,
  bind_outcome
}
import std.algebra { Empty, FreeMonoid }
import v2.std.node { Atom, Node, TypeNode, symbol_lexeme }
import v2.compiler.normalized_tree { NormalizedTree, normalized_tree_roots_to_binding_sources }
import v2.compiler.name_resolve { Admission, ResolutionSubject, resolve_with_admission }
import v2.compiler.symbol_index_fill { symbol_index_fill_module_roots }
import v2.std.symbol_index {
  LexicalAmbiguous,
  LexicalHit,
  LexicalUnbound,
  SymbolIndex,
  empty_symbol_index,
  symbol_index_lexical_lookup,
  symbol_index_lookup
}
import v2.compiler.normalize { normalize }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.namespace_alias { AliasBindingRow }
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse, parse_module }
import v2.extdeps.languages.dag {
  alias_binding_row_from_decl_node,
  dag_language_model,
  parse_production_emitted_identity_optional
}

data alias_decl_parse_source: String = "module v2.test.parse.alias_decl_probe\n\nalias NodeAlias = v2.std.node.Node\n"

fn alias_decl_parse_tree() -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: alias_decl_parse_source,
      file: ^alias_decl_parse_probe,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      parse(tokens: token_stream, grammar: lm.grammar)
    }
  )
}

fn alias_decl_find_in_children(tree: Node) -> Optional<Node> {
  fold(tree.children, init: optional_absent(), f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => alias_decl_find_node(tree: edge.target)
    }
  })
}

fn alias_decl_find_node(tree: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: tree) {
    Present { value: id } =>
      if id == ^dag_surface_alias_decl {
        optional_present(value: tree)
      } else {
        alias_decl_find_in_children(tree: tree)
      }
    Absent => alias_decl_find_in_children(tree: tree)
  }
}

fn alias_decl_expected_row() -> AliasBindingRow {
  AliasBindingRow {
    binding: ^NodeAlias,
    target: qualified_name_from_dotted_string(dotted: "v2.std.node.Node")
  }
}

fn alias_decl_parse_and_binding_row_holds() -> Bool {
  match alias_decl_parse_tree() {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match alias_decl_find_node(tree: tree) {
        Absent => false
        Present { value: decl } =>
          match alias_binding_row_from_decl_node(decl: decl, module_root: tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: row, diagnostics: _ } =>
              (row.binding == alias_decl_expected_row().binding)
                && (row.target == alias_decl_expected_row().target)
          }
      }
  }
}

fn alias_decl_keyword_reserved_in_binding_position_red_control_holds() -> Bool {
  let lm = dag_language_model()
  match bind_outcome(
    o: tokenize(
      text: "module probe\nalias alias = v2.std.node.Node\n",
      file: ^alias_decl_reserved_keyword_probe,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      parse(tokens: token_stream, grammar: lm.grammar)
    }
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data alias_decl_fill_parse_source: String = "module v2.test.parse.alias_decl_fill_probe\n\ntype AliasTargetType {}\n\nalias AliasBinding = v2.test.parse.alias_decl_fill_probe.AliasTargetType\n"

// THE NORMALIZED ROUTE IS THE ONE EVERY PRODUCTION CALLER USES (v2.compiler.normalized_tree
// normalized_tree_roots_to_binding_sources into symbol_index_fill_module_roots), so every claim below
// normalizes real source and fills the index through that route rather than handing the fill a raw
// parse tree.
fn alias_decl_normalized(text: String, file: Symbol) -> Outcome<NormalizedTree> {
  let lm = dag_language_model()
  match tokenize(text: text, file: file, rules: lm.lex) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: a, diagnostics: _ } => normalize(parse_tree: a.tree)
      }
  }
}

fn alias_decl_index_of(trees: FreeMonoid<NormalizedTree>) -> SymbolIndex {
  symbol_index_fill_module_roots(
    index: empty_symbol_index(),
    roots: normalized_tree_roots_to_binding_sources(roots: trees)
  )
}

// The lexical lookup of `name` at `position`, compared with the node the index holds at `target`.
fn alias_decl_lookup_hits_target(idx: SymbolIndex, position: String, name: Symbol, target: String) -> Bool {
  match symbol_index_lexical_lookup(index: idx, position: qualified_name_from_dotted_string(dotted: position), name: name) {
    LexicalHit { node: hit, path: _ } =>
      match symbol_index_lookup(index: idx, qualified_path: qualified_name_from_dotted_string(dotted: target)) {
        Present { value: t } => hit == t
        Absent => false
      }
    LexicalAmbiguous { candidates: _ } => false
    LexicalUnbound => false
  }
}

// AN ALIAS NAME RESOLVES TO ITS TARGET. Measured at main 6296275 before the interim refusal of
// gunbc#13375: normalize accepted this source and AliasBinding resolved to its OWN grafted node
// (lexical hit, hit != target) -- a silent wrong answer. The declaration now dissolves at the graft
// (v2.compiler.namespace_graft namespace_graft_unit_disposition) and its row is carried through
// normalize (v2.compiler.normalize import_binding_capture), so the hit IS AliasTargetType. RED if the
// alias is grafted as a member again (the hit is the alias's own node) or the row is dropped (unbound).
fn alias_decl_fill_lexical_lookup_holds() -> Bool {
  match alias_decl_normalized(text: alias_decl_fill_parse_source, file: ^alias_decl_fill_probe) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      alias_decl_lookup_hits_target(
        idx: alias_decl_index_of(trees: [t]),
        position: "v2.test.parse.alias_decl_fill_probe",
        name: ^AliasBinding,
        target: "v2.test.parse.alias_decl_fill_probe.AliasTargetType"
      )
  }
}

// AN ALIAS TO A TARGET NOTHING DECLARES BINDS NOTHING, AND THE REFERENCE THROUGH IT REFUSES, LOCATED.
// The row stays deferred at the fill's fixed point (v2.compiler.symbol_index_fill
// symbol_index_fill_bindings_to_fixed_point), so the alias name is UNBOUND -- never a hit on the
// alias's own node -- and resolution refuses the reference that wanted it, at the reference site
// (docs/plans/namespace-resolution-design.md section 13), exactly as it refuses an import of a
// name its module does not declare.
data alias_decl_unresolved_source: String = "module v2.test.parse.alias_decl_unresolved_probe\n\nalias Missing = v2.test.parse.alias_decl_unresolved_probe.Nowhere\n\nfn uses_missing(x: Missing) -> Missing = x\n"

fn alias_decl_unresolved_resolve_verdict() -> String {
  match alias_decl_normalized(text: alias_decl_unresolved_source, file: ^alias_decl_unresolved_probe) {
    Rejected { diagnostics: d } => "NOT_NORMALIZED:" + symbol_lexeme(sym: d.head.reason)
    Accepted { value: t, diagnostics: _ } =>
      match resolve_with_admission(
        lm: dag_language_model(),
        roots: [t],
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: "v2.test.parse.alias_decl_unresolved_probe") },
          imports: Empty
        }
      ) {
        Accepted { value: _, diagnostics: _ } => "ACCEPTED"
        Rejected { diagnostics: d } => symbol_lexeme(sym: d.head.reason) + "@" + alias_decl_locus_lexeme(d: d.head)
      }
  }
}

fn alias_decl_locus_lexeme(d: Diagnostic) -> String {
  match d.at {
    NodeLocus { anchor: a } =>
      match a.at.kind {
        TypeNode { connective: Atom { identity: id } } => symbol_lexeme(sym: id)
        _ => "node"
      }
    Textual { file: _, extent: _ } => "textual"
    SourcePortLocus { anchor: _, file: _, extent: _ } => "source_port"
    InvariantPortLocus { anchor: _, invariant: _ } => "invariant_port"
    DeclarationLocus { declaration: _ } => "declaration"
  }
}

fn alias_decl_unresolved_target_refuses_holds() -> Bool {
  match alias_decl_normalized(text: alias_decl_unresolved_source, file: ^alias_decl_unresolved_probe) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      (match symbol_index_lexical_lookup(
        index: alias_decl_index_of(trees: [t]),
        position: qualified_name_from_dotted_string(dotted: "v2.test.parse.alias_decl_unresolved_probe"),
        name: ^Missing
      ) {
        LexicalUnbound => true
        LexicalHit { node: _, path: _ } => false
        LexicalAmbiguous { candidates: _ } => false
      })
        && (alias_decl_unresolved_resolve_verdict() == "resolve_reason_unbound_symbol@Missing")
  }
}

// AN ALIAS DISAMBIGUATES WHAT UNIQUE-ON-CHAIN REFUSES. Two imports bind X at the subject from two
// providers, so X is Ambiguous there (two declarations, one name -- refused, never first-wins). The
// alias names ONE of them under a name only it binds, so AX resolves to alias_amb_a.X: the fix menu of
// docs/plans/namespace-resolution-design.md section 13 ("qualify by containment path / introduce an
// alias / rename"), executed. The ambiguity on X itself is not hidden by the alias: X stays refused.
data alias_amb_a_source: String = "module v2.test.parse.alias_amb_a\n\ntype X {}\n"

data alias_amb_b_source: String = "module v2.test.parse.alias_amb_b\n\ntype X {}\n"

data alias_amb_subject_source: String = "module v2.test.parse.alias_amb_s\n\nimport v2.test.parse.alias_amb_a { X }\nimport v2.test.parse.alias_amb_b { X }\n\nalias AX = v2.test.parse.alias_amb_a.X\n"

fn alias_decl_disambiguates_holds() -> Bool {
  match alias_decl_normalized(text: alias_amb_a_source, file: ^alias_amb_a_probe) {
    Rejected { diagnostics: _ } => false
    Accepted { value: a, diagnostics: _ } =>
      match alias_decl_normalized(text: alias_amb_b_source, file: ^alias_amb_b_probe) {
        Rejected { diagnostics: _ } => false
        Accepted { value: b, diagnostics: _ } =>
          match alias_decl_normalized(text: alias_amb_subject_source, file: ^alias_amb_s_probe) {
            Rejected { diagnostics: _ } => false
            Accepted { value: s, diagnostics: _ } =>
              let idx = alias_decl_index_of(trees: [a, b, s])
              (match symbol_index_lexical_lookup(
                index: idx,
                position: qualified_name_from_dotted_string(dotted: "v2.test.parse.alias_amb_s"),
                name: ^X
              ) {
                LexicalAmbiguous { candidates: _ } => true
                LexicalHit { node: _, path: _ } => false
                LexicalUnbound => false
              })
                && alias_decl_lookup_hits_target(
                  idx: idx,
                  position: "v2.test.parse.alias_amb_s",
                  name: ^AX,
                  target: "v2.test.parse.alias_amb_a.X"
                )
          }
      }
  }
}
