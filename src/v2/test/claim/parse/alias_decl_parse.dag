module v2.test.parse.alias_decl_parse

import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.node { Node }
import v2.compiler.normalized_tree {
  NormalizedTree,
  normalized_tree_record_declarations,
  normalized_tree_resource_declarations
}
import v2.compiler.normalize { normalize }
import v2.std.qualified_name { qualified_name_from_dotted_string, qualified_name_snoc }
import v2.std.namespace_alias { AliasBindingRow }
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse, parse_module }
import v2.compiler.symbol_index_fill { symbol_index_fill_module_root }
import v2.std.symbol_index {
  LexicalAmbiguous,
  LexicalHit,
  LexicalUnbound,
  empty_symbol_index,
  symbol_index_lexical_lookup,
  symbol_index_lookup
}
import v2.extdeps.languages.dag {
  alias_binding_row_from_decl_node,
  dag_language_model,
  parse_production_emitted_identity_optional,
  qualified_name_from_module_node
}

data alias_decl_parse_source: String = "module v2.test.parse.alias_decl_probe\n\nalias NodeAlias = v2.std.node.Node\n"

fn alias_decl_parse_tree() -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: alias_decl_parse_source,
      file: ^alias_decl_parse_probe,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      parse(tokens: token_stream, grammar: lm.grammar)
    }
  )
}

fn alias_decl_find_in_children(tree: Node) -> Optional<Node> {
  fold(tree.children, init: optional_absent(), f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => alias_decl_find_node(tree: edge.target)
    }
  })
}

fn alias_decl_find_node(tree: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: tree) {
    Present { value: id } =>
      if id == ^dag_surface_alias_decl {
        optional_present(value: tree)
      } else {
        alias_decl_find_in_children(tree: tree)
      }
    Absent => alias_decl_find_in_children(tree: tree)
  }
}

fn alias_decl_expected_row() -> AliasBindingRow {
  AliasBindingRow {
    binding: ^NodeAlias,
    target: qualified_name_from_dotted_string(dotted: "v2.std.node.Node")
  }
}

fn alias_decl_parse_and_binding_row_holds() -> Bool {
  match alias_decl_parse_tree() {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match alias_decl_find_node(tree: tree) {
        Absent => false
        Present { value: decl } =>
          match alias_binding_row_from_decl_node(decl: decl, module_root: tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: row, diagnostics: _ } =>
              (row.binding == alias_decl_expected_row().binding)
                && (row.target == alias_decl_expected_row().target)
          }
      }
  }
}

fn alias_decl_keyword_reserved_in_binding_position_red_control_holds() -> Bool {
  let lm = dag_language_model()
  match bind_outcome(
    o: tokenize(
      text: "module probe\nalias alias = v2.std.node.Node\n",
      file: ^alias_decl_reserved_keyword_probe,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      parse(tokens: token_stream, grammar: lm.grammar)
    }
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data alias_decl_fill_parse_source: String = "module v2.test.parse.alias_decl_fill_probe\n\ntype AliasTargetType {}\n\nalias AliasBinding = v2.test.parse.alias_decl_fill_probe.AliasTargetType\n"

// THE FILL READS A NORMALIZED TREE, as every production caller supplies one (v2.compiler.normalized_tree
// normalized_tree_roots_to_binding_sources into symbol_index_fill_module_roots). This claim used to
// hand it the raw parse tree, whose type declaration is not a lowered member, so the containment walk
// indexed nothing (target, binding and module root all absent, measured). The assertion is unchanged.
// ON THE REAL ROUTE IT IS STILL FALSE, AND THAT IS A DEFECT, NOT A STALE CLAIM: measured at 6296275,
// the target is indexed and the lexical lookup of AliasBinding HITS, but not the target -- no alias
// binding row is read from the normalized tree (alias_binding_row_from_decl_node accepts no node of
// it), so the alias name resolves to its own grafted node. No .dag source declares an `alias`, so no
// compile closure reaches the defect today; the claim stays red until the native route carries an
// alias declaration's row to the index.
fn alias_decl_fill_normalized() -> Outcome<NormalizedTree> {
  let lm = dag_language_model()
  match tokenize(text: alias_decl_fill_parse_source, file: ^alias_decl_fill_probe, rules: lm.lex) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: a, diagnostics: _ } => normalize(parse_tree: a.tree)
      }
  }
}

fn alias_decl_fill_lexical_lookup_holds() -> Bool {
  match alias_decl_fill_normalized() {
    Rejected { diagnostics: _ } => false
    Accepted { value: nt, diagnostics: _ } =>
      match qualified_name_from_module_node(root: nt.root) {
        Rejected { diagnostics: _ } => false
        Accepted { value: module_qn, diagnostics: _ } =>
          let idx = symbol_index_fill_module_root(
            index: empty_symbol_index(),
            root: nt.root,
            record_declarations: normalized_tree_record_declarations(t: nt),
            resource_declarations: normalized_tree_resource_declarations(t: nt)
          )
          let target_path = qualified_name_snoc(qn: module_qn, segment: ^AliasTargetType)
          match symbol_index_lexical_lookup(
            index: idx,
            position: module_qn,
            name: ^AliasBinding
          ) {
            LexicalHit { node: hit, path: _ } =>
              match symbol_index_lookup(index: idx, qualified_path: target_path) {
                Present { value: target } => hit == target
                Absent => false
              }
            LexicalAmbiguous { candidates: _ } => false
            LexicalUnbound => false
          }
      }
  }
}

