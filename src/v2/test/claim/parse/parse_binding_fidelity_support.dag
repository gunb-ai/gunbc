module v2.test.parse.parse_binding_fidelity_support

import v2.compiler.name_resolve {
  Admission,
  Import,
  ImportVisible,
  ResolutionSubject,
  resolve_with_admission_policy
}
import v2.compiler.ingested_fixture_arrows {
  ingested_add_module_source,
  ingested_find_arrow_in_module
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_language_model_surface_empty_prelude,
  dag_language_model,
  dag_named_edge
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list_node }
import v2.std.collection {
  List,
  list_at_optional
}
import v2.std.optional {
  Absent,
  Optional,
  Present
}
import v2.std.qualified_name { QualifiedName }
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.grammar { ParseTree, node_atom_identity_optional }
import v2.std.compilers.lexing { TokenStream, symbol_lexeme }
import v2.std.logic { Bool }
import v2.std.node {
  Node,
  Symbol
}
import v2.std.node_query { find_arrow_body_child }
import v2.std.resolution_policy { ImportScoped }
import v2.std.cross_tree.resolution { SourceRootIndex, source_root_index_empty }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.compiler.namespace_graft { module_header_containment_graft }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data parse_binding_fidelity_support_note: String = "Shared parse-binding helpers for long-lane + body_lowering consumers (review 43128: not a *_test.dag — module-local orphan hygiene would false-red cross-module-only helpers). Dead `pbf_tree_contains_atom_identity` deleted (review 43356 — was self-recursive only, not a shared consumer). Fast-lane tests stay in parse_binding_fidelity_test.dag."

fn pbf_tokenize() -> Outcome<TokenStream> {
  let lm = dag_language_model()
  tokenize(text: ingested_add_module_source, file: ^pbf_source_file, rules: lm.lex)
}

fn pbf_parse_tokens(tokens: TokenStream) -> Outcome<ParseTree> {
  let lm = dag_language_model()
  bind_outcome(
    o: parse_module(tokens: tokens, grammar: lm.grammar),
    f: fn(artifact) {
      outcome_accepted(value: artifact.tree)
    }
  )
}

fn pbf_normalized_add_module() -> Outcome<Node> {
  match pbf_tokenize() {
    Accepted { value: tokens, diagnostics: _ } =>
      match pbf_parse_tokens(tokens: tokens) {
        Accepted { value: parsed, diagnostics: _ } =>
          normalize(parse_tree: parsed)
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn pbf_normalized_add_arrow() -> Optional<Node> {
  match pbf_normalized_add_module() {
    Accepted { value: tree, diagnostics: _ } =>
      ingested_find_arrow_in_module(root: tree)
    Rejected { diagnostics: _ } => Absent
  }
}

fn pbf_resolved_add_module() -> Outcome<Node> {
  let lm = dag_language_model()
  match pbf_normalized_add_module() {
    Accepted { value: normalized, diagnostics: _ } =>
      resolve(tree: normalized, lm: lm)
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn pbf_resolved_add_arrow() -> Optional<Node> {
  match pbf_resolved_add_module() {
    Accepted { value: tree, diagnostics: _ } =>
      ingested_find_arrow_in_module(root: tree)
    Rejected { diagnostics: _ } => Absent
  }
}

fn pbf_arrow_body_operand_lexeme(arrow: Node, index: Int) -> Optional<String> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match list_at_optional(xs: body.children, index: index) {
        Present { value: e } =>
          match node_atom_identity_optional(node: e.target) {
            Present { value: id } => Present { value: symbol_lexeme(sym: id) }
            Absent => Absent
          }
        Absent => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

fn pbf_arrow_body_operand_id(arrow: Node, index: Int) -> Optional<Symbol> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match list_at_optional(xs: body.children, index: index) {
        Present { value: e } => node_atom_identity_optional(node: e.target)
        Absent => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

fn pbf_parse_preserves_param_x_binding() -> Bool {
  match pbf_normalized_add_arrow() {
    Present { value: arrow } =>
      match pbf_arrow_body_operand_lexeme(arrow: arrow, index: 1) {
        Present { value: lex } => lex == "x"
        Absent => false
      }
    Absent => false
  }
}

fn pbf_parse_preserves_param_y_binding() -> Bool {
  match pbf_normalized_add_arrow() {
    Present { value: arrow } =>
      match pbf_arrow_body_operand_lexeme(arrow: arrow, index: 2) {
        Present { value: lex } => lex == "y"
        Absent => false
      }
    Absent => false
  }
}

fn pbf_parse_does_not_collapse_to_token_ident() -> Bool {
  match pbf_normalized_add_arrow() {
    Present { value: arrow } =>
      match pbf_arrow_body_operand_lexeme(arrow: arrow, index: 1) {
        Present { value: left } =>
          match pbf_arrow_body_operand_lexeme(arrow: arrow, index: 2) {
            Present { value: right } => (left == "x") && (right == "y") && (left != right)
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn pbf_resolved_add_accepts() -> Bool {
  match pbf_resolved_add_module() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn pbf_resolved_tree_has_distinct_param_bindings() -> Bool {
  match pbf_resolved_add_arrow() {
    Present { value: arrow } =>
      match pbf_arrow_body_operand_id(arrow: arrow, index: 1) {
        Present { value: left } =>
          match pbf_arrow_body_operand_id(arrow: arrow, index: 2) {
            Present { value: right } => (left != right) && (symbol_lexeme(sym: left) == "x") && (symbol_lexeme(sym: right) == "y")
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

