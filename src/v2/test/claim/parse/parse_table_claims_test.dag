module v2.test.parse.parse_table_claims



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly
fn parse_table_token(class: v2.std.node.Symbol) -> v2.std.compilers.lexing.Token {
  v2.std.compilers.lexing.Token { class: class, lexeme: std.algebra.Empty, file: class, start: 0, end: 0 }
}

data parse_table_two_tokens: List<v2.std.compilers.lexing.Token> = std.algebra.Cons {
  head: parse_table_token(class: ^parse_table_probe_class),
  tail: std.algebra.Cons { head: parse_table_token(class: ^parse_table_probe_class), tail: std.algebra.Empty }
}

data parse_table_empty_tokens: List<v2.std.compilers.lexing.Token> = std.algebra.Empty

test fn parse_table_token_position_indices_no_extra_append_holds() -> Bool {
  (length(xs: token_position_indices(tokens: parse_table_two_tokens)) == 3)
    && (length(xs: token_position_indices(tokens: parse_table_empty_tokens)) == 1)
    && ((length(xs: token_position_indices(tokens: parse_table_two_tokens)) == 4) == false)
}

fn nullable_set_singleton(name: v2.std.node.Symbol) -> std.types.Set<v2.std.node.Symbol> {
  std.types.Set { member: fn(sym) { sym == name } }
}

test fn parse_table_nullable_morphism_holds() -> Bool {
  let ns = nullable_set_singleton(name: ^parse_table_nullable_probe_nt)
  (expr_is_nullable_given_set(
    expr: Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass },
    nullable_set: ns
  ) == false)
    && (expr_is_nullable_given_set(
      expr: Optional { element: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass } },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Repeat { element: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass } },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_probe_nt },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_other_nt },
      nullable_set: ns
    ) == false)
    && (expr_is_nullable_given_set(
      expr: v2.std.grammar.Sequence {
        left: Optional { element: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass } },
        right: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_probe_nt }
      },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: v2.std.grammar.Sequence {
        left: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass },
        right: Optional { element: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass } }
      },
      nullable_set: ns
    ) == false)
    && (expr_is_nullable_given_set(
      expr: v2.std.grammar.Choice {
        left: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass },
        right: Optional { element: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass } }
      },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: v2.std.grammar.Choice {
        left: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass },
        right: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_other_nt }
      },
      nullable_set: ns
    ) == false)
}

fn parse_table_projection_grammar() -> v2.std.grammar.ParseGrammar {
  v2.std.grammar.ModeledGrammar {
    root: v2.std.grammar.GrammarRoot {
      start: ^pt_proj_start,
      productions: std.algebra.Cons {
        head: v2.std.grammar.GrammarProduction {
          name: ^pt_proj_start,
          expression: v2.std.grammar.Sequence {
            left: v2.std.grammar.Terminal { token_class: ^pt_proj_tok_a, stamp: StampClass },
            right: v2.std.grammar.Choice {
              left: v2.std.grammar.Nonterminal { production: ^pt_proj_nt_b },
              right: Optional { element: v2.std.grammar.Repeat { element: v2.std.grammar.Terminal { token_class: ^pt_proj_tok_c, stamp: StampClass } } }
            }
          },
          emitted: grammar_atom(identity: ^pt_proj_start)
        },
        tail: std.algebra.Empty
      },
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}

test fn parse_table_grammar_expr_projection_holds() -> Bool {
  (grammar_carries_symbol(grammar: parse_table_projection_grammar(), sym: ^pt_proj_tok_a) == true)
    && (grammar_carries_symbol(grammar: parse_table_projection_grammar(), sym: ^pt_proj_nt_b) == true)
    && (grammar_carries_symbol(grammar: parse_table_projection_grammar(), sym: ^pt_proj_tok_c) == true)
    && (grammar_carries_symbol(grammar: parse_table_projection_grammar(), sym: ^pt_proj_absent) == false)
}

data parse_table_defined_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^pt_undef_defined,
  productions: std.algebra.Cons {
    head: v2.std.grammar.GrammarProduction {
      name: ^pt_undef_defined,
      expression: Terminal { token_class: ^pt_undef_tok, stamp: StampClass },
      emitted: grammar_atom(identity: ^pt_undef_defined)
    },
    tail: std.algebra.Empty
  },
  sync_tokens: grammar_empty_sync_tokens()
}

test fn parse_table_left_corner_morphism_holds() -> Bool {
  let ns = nullable_set_singleton(name: ^parse_table_nullable_probe_nt)
  (length(xs: expr_direct_left_corner_list(
    expr: Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass },
    nullable_set: ns
  )) == 0)
    && (length(xs: expr_direct_left_corner_list(
      expr: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_probe_nt },
      nullable_set: ns
    )) == 1)
    && (length(xs: expr_direct_left_corner_list(
      expr: v2.std.grammar.Sequence {
        left: Optional { element: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass } },
        right: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_probe_nt }
      },
      nullable_set: ns
    )) == 1)
    && (length(xs: expr_direct_left_corner_list(
      expr: v2.std.grammar.Sequence {
        left: v2.std.grammar.Terminal { token_class: ^parse_table_nullable_tok, stamp: StampClass },
        right: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_probe_nt }
      },
      nullable_set: ns
    )) == 0)
    && (length(xs: expr_direct_left_corner_list(
      expr: v2.std.grammar.Choice {
        left: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_probe_nt },
        right: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_other_nt }
      },
      nullable_set: ns
    )) == 2)
    && (length(xs: expr_direct_left_corner_list(
      expr: Optional { element: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_probe_nt } },
      nullable_set: ns
    )) == 1)
    && (length(xs: expr_direct_left_corner_list(
      expr: Repeat { element: v2.std.grammar.Nonterminal { production: ^parse_table_nullable_probe_nt } },
      nullable_set: ns
    )) == 1)
}

test fn parse_table_undefined_nonterminal_morphism_holds() -> Bool {
  let root = parse_table_defined_root
  (expr_has_undefined_nonterminal(
    expr: Terminal { token_class: ^pt_undef_tok, stamp: StampClass },
    root: root
  ) == false)
    && (expr_has_undefined_nonterminal(
      expr: v2.std.grammar.Nonterminal { production: ^pt_undef_defined },
      root: root
    ) == false)
    && (expr_has_undefined_nonterminal(
      expr: v2.std.grammar.Nonterminal { production: ^pt_undef_missing },
      root: root
    ) == true)
    && (expr_has_undefined_nonterminal(
      expr: v2.std.grammar.Sequence {
        left: v2.std.grammar.Terminal { token_class: ^pt_undef_tok, stamp: StampClass },
        right: v2.std.grammar.Nonterminal { production: ^pt_undef_missing }
      },
      root: root
    ) == true)
    && (expr_has_undefined_nonterminal(
      expr: v2.std.grammar.Sequence {
        left: v2.std.grammar.Terminal { token_class: ^pt_undef_tok, stamp: StampClass },
        right: v2.std.grammar.Nonterminal { production: ^pt_undef_defined }
      },
      root: root
    ) == false)
    && (expr_has_undefined_nonterminal(
      expr: v2.std.grammar.Choice {
        left: v2.std.grammar.Terminal { token_class: ^pt_undef_tok, stamp: StampClass },
        right: v2.std.grammar.Nonterminal { production: ^pt_undef_missing }
      },
      root: root
    ) == true)
    && (expr_has_undefined_nonterminal(
      expr: Optional { element: v2.std.grammar.Nonterminal { production: ^pt_undef_missing } },
      root: root
    ) == true)
}

test fn parse_table_parse_expr_combinator_holds() -> Bool {
  let prov = parse_prov_initial()
  let table = parse_table_empty()
  let root = v2.std.grammar.GrammarRoot {
    start: ^pt_parse_expr_start,
    productions: std.algebra.Empty,
    sync_tokens: grammar_empty_sync_tokens()
  }
  let tok_a = parse_table_token(class: ^pt_parse_expr_tok_a)
  let tok_b = parse_table_token(class: ^pt_parse_expr_tok_b)
  let tok_c = parse_table_token(class: ^pt_parse_expr_tok_c)
  let toks_a = std.algebra.Cons { head: tok_a, tail: std.algebra.Empty }
  let toks_b = std.algebra.Cons { head: tok_b, tail: std.algebra.Empty }
  let toks_c = std.algebra.Cons { head: tok_c, tail: std.algebra.Empty }
  let toks_ab = std.algebra.Cons { head: tok_a, tail: std.algebra.Cons { head: tok_b, tail: std.algebra.Empty } }
  let toks_aab = std.algebra.Cons { head: tok_a, tail: std.algebra.Cons { head: tok_a, tail: std.algebra.Cons { head: tok_b, tail: std.algebra.Empty } } }
  let r1 = match parse_expr(
    expr: Terminal { token_class: ^pt_parse_expr_tok_a, stamp: StampClass },
    tokens: toks_a, all_tokens: toks_a, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _, table: _ } =>
      length(xs: rest) == 0
    ParseExprRejected { diagnostics: _, table: _ } => false
  }
  let r2 = match parse_expr(
    expr: Terminal { token_class: ^pt_parse_expr_tok_a, stamp: StampClass },
    tokens: toks_b, all_tokens: toks_b, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: _ } => false
    ParseExprRejected { diagnostics: _, table: _ } => true
  }
  let r3 = match parse_expr(
    expr: v2.std.grammar.Sequence {
      left: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_a, stamp: StampClass },
      right: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_b, stamp: StampClass }
    },
    tokens: toks_ab, all_tokens: toks_ab, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _, table: _ } =>
      length(xs: rest) == 0
    ParseExprRejected { diagnostics: _, table: _ } => false
  }
  let r4 = match parse_expr(
    expr: v2.std.grammar.Choice {
      left: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_a, stamp: StampClass },
      right: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_b, stamp: StampClass }
    },
    tokens: toks_b, all_tokens: toks_b, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _, table: _ } =>
      length(xs: rest) == 0
    ParseExprRejected { diagnostics: _, table: _ } => false
  }
  let r5 = match parse_expr(
    expr: Optional { element: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_a, stamp: StampClass } },
    tokens: toks_b, all_tokens: toks_b, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _, table: _ } =>
      length(xs: rest) == 1
    ParseExprRejected { diagnostics: _, table: _ } => false
  }
  let r6 = match parse_expr(
    expr: Repeat { element: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_a, stamp: StampClass } },
    tokens: toks_aab, all_tokens: toks_aab, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _, table: _ } =>
      length(xs: rest) == 1
    ParseExprRejected { diagnostics: _, table: _ } => false
  }
  let r7 = match parse_expr(
    expr: Repeat { element: Optional { element: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_a, stamp: StampClass } } },
    tokens: toks_b, all_tokens: toks_b, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _, table: _ } =>
      length(xs: rest) == 1
    ParseExprRejected { diagnostics: _, table: _ } => false
  }
  let r8 = match parse_expr(
    expr: v2.std.grammar.Nonterminal { production: ^pt_parse_expr_undefined_prod },
    tokens: toks_a, all_tokens: toks_a, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: _ } => false
    ParseExprRejected { diagnostics: _, table: _ } => true
  }
  let r9 = match parse_expr(
    expr: v2.std.grammar.Choice {
      left: Optional { element: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_a, stamp: StampClass } },
      right: v2.std.grammar.Terminal { token_class: ^pt_parse_expr_tok_b, stamp: StampClass }
    },
    tokens: toks_c, all_tokens: toks_c, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _, table: _ } =>
      length(xs: rest) == 1
    ParseExprRejected { diagnostics: _, table: _ } => false
  }
  r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8 && r9
}
