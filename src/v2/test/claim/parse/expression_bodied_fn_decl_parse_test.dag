module v2.test.parse.expression_bodied_fn_decl_parse

import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node }
import v2.std.node_query { find_arrow_body_child }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn g_tokenize_parse(text: String, file: Symbol) -> Outcome<Node> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prepared, diagnostics: residue } =>
      bind_outcome(
        o: tokenize(text: text, file: file, rules: dag_lex()),
        f: fn(token_stream) {
          match parse_module_prepared(
            tokens: token_stream,
            prepared: prepared,
            validation_residue: residue
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: artifact, diagnostics: d } =>
              Accepted { value: artifact.tree, diagnostics: d }
          }
        }
      )
  }
}

fn g_parse_accepted(text: String, file: Symbol) -> Bool {
  match g_tokenize_parse(text: text, file: file) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn g_tree_has_arrow_body(root: Node) -> Bool {
  match find_arrow_body_child(root: root) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } =>
      fold(root.children, init: false, f: fn(found, e) {
        found || g_tree_has_arrow_body(root: e.target)
      })
  }
}

fn g_normalize_has_arrow_body(parsed: Outcome<Node>) -> Bool {
  match parsed {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match normalize(parse_tree: tree) {
        Rejected { diagnostics: _ } => false
        Accepted { value: normalized, diagnostics: _ } =>
          g_tree_has_arrow_body(root: normalized.root)
      }
  }
}

data expression_bodied_fn_source: String = "module probe.expr_fn\n\nfn f(a: Int) -> Int = a\n"

data expression_bodied_literal_fn_source: String = "module probe.expr_fn_lit\n\nfn f() -> Int = 1\n"

data braced_fn_control_source: String = "module probe.braced_fn\n\nfn f(a: Int) -> Int {\n  a\n}\n"

data empty_eq_fn_source: String = "module probe.empty_eq\n\nfn f(a: Int) -> Int =\n"

// THE SHARE POINTS. Each of the three accepted sources is parsed by two claims -- once to
// assert the parse, once to normalize the tree -- and the required floor evaluates each claim
// in its own frame, so every tokenize+parse was paid twice: the floor's own cost receipt (main
// run 34556223550, required_floor_claim_cost.tsv) shows braced_fn_decl_survives_normalize_holds
// INTERRUPTED at the 500ms per-claim CPU ceiling and its file-mates within one runner swing of
// it. Each nullary producer below is enrolled WARM in v2.workflow.floor_pure_producer_share:
// the floor forces it once during strict preparation, outside every per-claim budget, and both
// claims are handed the parse tree; normalize stays per claim. The empty-`=` source is not
// shared: one claim reads it, and a refusal is the cheap arm.
fn expression_bodied_fn_parsed() -> Outcome<Node> {
  g_tokenize_parse(text: expression_bodied_fn_source, file: ^probe_expr_fn)
}

fn expression_bodied_literal_fn_parsed() -> Outcome<Node> {
  g_tokenize_parse(text: expression_bodied_literal_fn_source, file: ^probe_expr_fn_lit)
}

fn braced_fn_control_parsed() -> Outcome<Node> {
  g_tokenize_parse(text: braced_fn_control_source, file: ^probe_braced_fn)
}

fn g_parsed_accepted(parsed: Outcome<Node>) -> Bool {
  match parsed {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn expression_bodied_fn_decl_parses_holds() -> Bool {
  g_parsed_accepted(parsed: expression_bodied_fn_parsed())
}

test fn expression_bodied_literal_fn_decl_parses_holds() -> Bool {
  g_parsed_accepted(parsed: expression_bodied_literal_fn_parsed())
}

test fn braced_fn_decl_still_parses_holds() -> Bool {
  g_parsed_accepted(parsed: braced_fn_control_parsed())
}

test fn braced_fn_decl_survives_normalize_holds() -> Bool {
  g_normalize_has_arrow_body(parsed: braced_fn_control_parsed())
}

test fn empty_eq_fn_decl_refuses_holds() -> Bool {
  match g_parse_accepted(text: empty_eq_fn_source, file: ^probe_empty_eq) {
    true => false
    false => true
  }
}

test fn expression_bodied_fn_decl_survives_normalize_holds() -> Bool {
  g_normalize_has_arrow_body(parsed: expression_bodied_fn_parsed())
}

test fn expression_bodied_literal_fn_decl_survives_normalize_holds() -> Bool {
  g_normalize_has_arrow_body(parsed: expression_bodied_literal_fn_parsed())
}
