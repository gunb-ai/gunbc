module v2.test.claim.parse.authored_gap_attachment

import extdeps.languages.dag.syntax { strip_line_comment_delimiter }
import std.source_annotation {
  AnnotationScope,
  FileScope,
  OccurrenceScope,
  ErasedSourceRegion,
  SourceAnnotationDebt,
  source_annotation_graph_rows
}
import std.coercion { unicode_scalar_unfold }
import std.types { List }
import v2.compiler.parse { AuthoredParseArtifact, parse_module_authored, authored_parse_annotations, authored_parse_semantic }
import v2.compiler.tokenize { lex_walk_artifact }
import v2.extdeps.languages.dag { dag_lex_rules }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.host_text { chars }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ROADMAP NODE parse-comment-gap-attachment-v2: the v2 parser attaches comments by the SAME gap rule
// as v1 (std.source_annotation attach_annotations), over a roster of its grammar productions. Each
// control lexes and parses real .dag source through the production lexer and grammar, and resolves
// the row's scope and neighbours to the SOURCE TEXT of their recorded extents.

data gap_source: String = "// banner above the header\nmodule zqx.vgap\n\nfn zqx_f(a: Int, b: Int) -> Int \{\n  let x = zqx_g(\n    a,\n    // between the arguments\n    b\n  )\n  // between the statements\n  x\n\}\n\nfn zqx_g(p: Int, q: Int) -> Int \{\n  p\n\}\n// after the last item\n"

fn authored(source: String) -> Optional<AuthoredParseArtifact> {
  let lm = dag_language_model()
  match lex_walk_artifact(source: chars(text: source), file: ^zqx_vgap, rules: dag_lex_rules()) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: artifact, diagnostics: _ } =>
      match parse_module_authored(artifact: artifact, grammar: lm.grammar, annotation_text: fn(t) { strip_line_comment_delimiter(lexeme: t) }) {
        Rejected { diagnostics: _ } => optional_absent()
        Accepted { value: a, diagnostics: _ } => optional_present(value: a)
      }
  }
}

fn scope_text(a: AuthoredParseArtifact, source: String, scope: AnnotationScope) -> String {
  match scope {
    FileScope => "<file>"
    ErasedSourceRegion { extent: e } => substring(s: source, start: e.start, end: e.end)
    OccurrenceScope { occurrence: id } =>
      match span_index_extent(index: authored_parse_semantic(artifact: a).span_index, id: id) {
        Present { value: recorded } =>
          match recorded {
            SourceExtentKnown { locus: l } =>
              match l {
                Textual { file: _, extent: ext } =>
                  match ext {
                    ByteRange { start: s, end: e } => substring(s: source, start: s, end: e)
                    WholeFile => "<whole>"
                  }
                _ => "<other>"
              }
            SourceExtentUnrepresentable => "<unrep>"
          }
        Absent => "<absent>"
      }
  }
}

fn optional_scope_text(a: AuthoredParseArtifact, source: String, scope: Optional<AnnotationScope>) -> String {
  match scope {
    Present { value: s } => scope_text(a: a, source: source, scope: s)
    Absent => "<none>"
  }
}

fn row_text(row: SourceAnnotationDebt) -> String {
  unicode_scalar_unfold(s: row.text)
}

fn row_with_text(rows: List<SourceAnnotationDebt>, text: String) -> Optional<SourceAnnotationDebt> {
  fold_list(xs: rows, empty: optional_absent(), cons: fn(found, row) {
    match found {
      Present { value: _ } => found
      Absent => if row_text(row: row) == text { optional_present(value: row) } else { found }
    }
  })
}

fn row_texts(rows: List<SourceAnnotationDebt>) -> List<String> {
  fold_list(xs: rows, empty: [], cons: fn(acc, row) { list_snoc_item(xs: acc, item: row_text(row: row)) })
}

fn row_scope(row: SourceAnnotationDebt) -> AnnotationScope {
  row.gap.scope
}

fn row_before(row: SourceAnnotationDebt) -> Optional<AnnotationScope> {
  row.gap.before
}

fn row_after(row: SourceAnnotationDebt) -> Optional<AnnotationScope> {
  row.gap.after
}

// [scope, before, after] of the row carrying `text`, as source text.
fn gap_texts(source: String, text: String) -> List<String> {
  match authored(source: source) {
    Absent => ["<no parse>"]
    Present { value: a } =>
      match row_with_text(rows: source_annotation_graph_rows(graph: authored_parse_annotations(artifact: a)), text: text) {
        Absent => ["<no row>"]
        Present { value: row } =>
          [scope_text(a: a, source: source, scope: row_scope(row: row)), optional_scope_text(a: a, source: source, scope: row_before(row: row)), optional_scope_text(a: a, source: source, scope: row_after(row: row))]
      }
  }
}

fn nth_text(xs: List<String>, i: Int) -> String {
  match list_at_optional(xs: xs, index: i) {
    Present { value: t } => t
    Absent => "<missing>"
  }
}

// BETWEEN TWO ARGUMENTS the scope is the call and the neighbours are the two argument productions.
test fn an_argument_comment_lands_between_the_arguments_holds() -> Bool {
  gap_texts(source: gap_source, text: "between the arguments") == ["zqx_g(\n    a,\n    // between the arguments\n    b\n  )", "a", "b"]
}

// BETWEEN TWO STATEMENTS of zqx_f: the neighbours are the two statements, never zqx_g, the next
// declaration a proximity rule would hand the comment to.
test fn a_body_comment_lands_between_its_statements_holds() -> Bool {
  let g = gap_texts(source: gap_source, text: "between the statements")
  nth_text(xs: g, i: 1) == "let x = zqx_g(\n    a,\n    // between the arguments\n    b\n  )" && nth_text(xs: g, i: 2) == "x"
}

test fn file_scope_holds_the_banner_and_the_epilogue_holds() -> Bool {
  let banner = gap_texts(source: gap_source, text: "banner above the header")
  let epilogue = gap_texts(source: gap_source, text: "after the last item")
  nth_text(xs: banner, i: 0) == "<file>" && nth_text(xs: banner, i: 1) == "<none>"
    && nth_text(xs: epilogue, i: 0) == "<file>" && nth_text(xs: epilogue, i: 2) == "<none>"
}

// THE ADJACENCY BITS THE v2 WALK NOW OBSERVES group consecutive lines into one block and split on a
// blank line, through the same fold.
data block_source: String = "module zqx.vblk\n\n// one\n// two\n\n// three\ndata zqx_d: Int = 1\n"

test fn the_walk_observes_block_adjacency_holds() -> Bool {
  match authored(source: block_source) {
    Absent => false
    Present { value: a } => row_texts(rows: source_annotation_graph_rows(graph: authored_parse_annotations(artifact: a))) == ["one\ntwo", "three"]
  }
}


// A NESTED INFIX OPERAND IS A REGION. In `1 + 2 * 3` the product `2 * 3` is an infix application no
// production wraps; a comment in front of it has the whole product after it, not its first operand.
data infix_source: String = "module zqx.vinf\n\ndata zqx_e: Int = 1 +\n  // before the product\n  2 * 3\n"

test fn a_nested_infix_operand_is_a_neighbour_holds() -> Bool {
  let g = gap_texts(source: infix_source, text: "before the product")
  nth_text(xs: g, i: 1) == "1" && nth_text(xs: g, i: 2) == "2 * 3"
}

