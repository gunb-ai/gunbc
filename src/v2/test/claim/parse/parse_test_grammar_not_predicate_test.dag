module test.claim.parse_test_grammar_not_predicate

import v2.compiler.parse { ParseArtifact, parse_module }
import v2.std.algebra { length }
import std.types { List }
import v2.std.compilers.lexing { Token, token_stream_new }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.grammar {
  GrammarExpr,
  GrammarProduction,
  GrammarRoot,
  ModeledGrammar,
  NotPredicate,
  Repeat,
  Sequence,
  StampClass,
  Terminal,
  grammar_atom,
  grammar_emit_parse_tree,
  grammar_empty_sync_tokens
}
import v2.std.integer { Int }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol, content_hash }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// `v2.std.grammar` `NotPredicate` IS FORD'S `!e`: IT SUCCEEDS WITHOUT CONSUMING WHERE `e` FAILS, AND
// DERIVES NO TREE. These claims hold it to that over hand grammars small enough for the floor's
// per-claim budget:
//   * STOP: `(!(a b) a)* (a b)*` over `a a a b` accepts, and the same grammar with the predicate
//     removed refuses, because `a*` then eats the `a` that `a b` needed -- the shape of a match-arm
//     statement body reading the next arm's head as one more statement. The pair is the
//     discriminator: only the predicate separates them.
//   * NO TREE: `!c a` over `a` builds the same tree as `a`, in both directions -- the parse trees
//     share a content hash, and emitting the predicate's tree against its own grammar yields one
//     terminal.
// The dag grammar's use -- v2.extdeps.languages.dag dag_grammar_match_arm_stmt_body_expr -- is
// round-tripped by the `match_statement_body_*` cases of gunbc.instruments.dag_emit_real_grammar_round_trips.

fn np_token(class: Symbol, start: Int) -> Token {
  Token { class: class, lexeme: std.algebra.Empty, file: ^np_file, start: start, end: start + 1 }
}

fn np_terminal(class: Symbol) -> GrammarExpr {
  Terminal { token_class: class, stamp: StampClass }
}

fn np_root(start: GrammarExpr) -> GrammarRoot {
  GrammarRoot {
    start: ^np_start,
    productions: [GrammarProduction { name: ^np_start, expression: start, emitted: grammar_atom(identity: ^np_start) }],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn np_parse(root: GrammarRoot, tokens: List<Token>) -> Outcome<ParseArtifact> {
  parse_module(tokens: token_stream_new(all: tokens), grammar: ModeledGrammar { root: root })
}

fn np_accepted(parsed: Outcome<ParseArtifact>) -> Bool {
  match parsed {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn np_head() -> GrammarExpr {
  Sequence { left: np_terminal(class: ^np_tok_a), right: np_terminal(class: ^np_tok_b) }
}

fn np_stop_grammar(guard: Bool) -> GrammarRoot {
  let item = if guard {
    Sequence { left: NotPredicate { element: np_head() }, right: np_terminal(class: ^np_tok_a) }
  } else {
    np_terminal(class: ^np_tok_a)
  }
  np_root(start: Sequence { left: Repeat { element: item }, right: Repeat { element: np_head() } })
}

data np_stop_tokens: List<Token> = [
  np_token(class: ^np_tok_a, start: 0),
  np_token(class: ^np_tok_a, start: 2),
  np_token(class: ^np_tok_a, start: 4),
  np_token(class: ^np_tok_b, start: 6)
]

test fn a_not_predicate_stops_a_repeat_before_the_next_head_holds() -> Bool {
  np_accepted(parsed: np_parse(root: np_stop_grammar(guard: true), tokens: np_stop_tokens))
}

test fn without_the_not_predicate_the_repeat_eats_the_next_head_holds() -> Bool {
  !np_accepted(parsed: np_parse(root: np_stop_grammar(guard: false), tokens: np_stop_tokens))
}

data np_single_tokens: List<Token> = [np_token(class: ^np_tok_a, start: 0)]

fn np_guarded_single_root() -> GrammarRoot {
  np_root(start: Sequence { left: NotPredicate { element: np_terminal(class: ^np_tok_c) }, right: np_terminal(class: ^np_tok_a) })
}

test fn a_not_predicate_derives_no_tree_holds() -> Bool {
  match np_parse(root: np_guarded_single_root(), tokens: np_single_tokens) {
    Rejected { diagnostics: _ } => false
    Accepted { value: guarded, diagnostics: _ } =>
      match np_parse(root: np_root(start: np_terminal(class: ^np_tok_a)), tokens: np_single_tokens) {
        Rejected { diagnostics: _ } => false
        Accepted { value: plain, diagnostics: _ } =>
          (content_hash(n: guarded.tree) == content_hash(n: plain.tree))
            && match grammar_emit_parse_tree(root: np_guarded_single_root(), tree: guarded.tree) {
              Accepted { value: terminals, diagnostics: _ } => length(xs: terminals) == 1
              Rejected { diagnostics: _ } => false
            }
      }
  }
}

// EMIT READS THE PREDICATE BACKWARD. The tree the guarded stop grammar parses from `a a a b` is
// emitted against that same grammar: the walk passes each `(!(a b) a)` item through
// v2.std.grammar grammar_emit_sequence's predicate rule and the predicate's own arm (no terminal), and
// yields the four terminals the source had -- the predicate costs no token in either direction.
test fn a_not_predicate_guarded_tree_emits_its_tokens_back_holds() -> Bool {
  match np_parse(root: np_stop_grammar(guard: true), tokens: np_stop_tokens) {
    Rejected { diagnostics: _ } => false
    Accepted { value: parsed, diagnostics: _ } =>
      match grammar_emit_parse_tree(root: np_stop_grammar(guard: true), tree: parsed.tree) {
        Accepted { value: terminals, diagnostics: _ } => length(xs: terminals) == 4
        Rejected { diagnostics: _ } => false
      }
  }
}
