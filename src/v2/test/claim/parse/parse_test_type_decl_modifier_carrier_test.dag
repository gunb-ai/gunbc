module test.claim.parse_test_type_decl_modifier_carrier

import v2.compiler.body_lowering_fold {
  DeclaredTypeModifiers,
  DeclaredTypeModifiersAbsent,
  DeclaredTypeModifiersPresent,
  NominalOpaqueModifier,
  SoleConstructorModifier,
  TypeDeclModifier,
  body_lower_type_decl_declared_modifiers
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model, parse_production_emitted_identity_optional }
import v2.std.algebra { Cons, Empty, FreeMonoid, fold_list }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.language_model { LanguageModel }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, Symbol, node_subtree_nodes, symbol_lexeme }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE TYPE-DECLARATION MODIFIER SLOT IS CARRIED, not consumed (gunbc.rung_drop
// g0_type_decl_modifier_parse_without_sealing_property, the half it names as "mints nothing"). The
// reader's subject is ONE interface: a type_decl parse shell in, the declaration's modifier row out
// (v2.compiler.body_lowering_fold body_lower_type_decl_declared_modifiers). Each claim below parses one
// line and asks that reader, so a claim's cost is the parse, not a normalize. The pairing claim at the
// bottom runs the REAL route -- normalize, onto NormalizedTree type_declaration_modifiers -- once, and
// asserts the row arrives there by name: deleting the capture in v2.compiler.normalize makes it red.
//
// The red that an unknown spelling in the slot refuses, located, is held on the real parse route by
// test.claim.parse_test_type_decl_modifier_g0_parse_probe unknown_type_decl_modifier_still_refuses_holds (the
// grammar admits only the closed set's terminals there); it is not restated here.

data tdm_lm: LanguageModel = dag_language_model()

fn tdm_parse(src: String) -> Outcome<Node> {
  bind_outcome(
    o: tokenize(text: src, file: ^type_decl_modifier_carrier_probe, rules: tdm_lm.lex),
    f: fn(ts) { parse(tokens: ts, grammar: tdm_lm.grammar) }
  )
}

fn tdm_first_type_decl(tree: Node) -> Optional<Node> {
  fold_list(xs: node_subtree_nodes(root: tree), empty: optional_absent(), cons: fn(acc, n) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match parse_production_emitted_identity_optional(node: n) {
          Present { value: id } => if id == ^dag_surface_type_decl { optional_present(value: n) } else { acc }
          Absent => acc
        }
    }
  })
}

fn tdm_modifier_text(m: TypeDeclModifier) -> String {
  match m {
    NominalOpaqueModifier => "nominal_opaque"
    SoleConstructorModifier => "sole_constructor"
  }
}

fn tdm_row_text(row: DeclaredTypeModifiers) -> String {
  fold_list(xs: row.modifiers, empty: symbol_lexeme(sym: row.name), cons: fn(acc, m) { acc + " " + tdm_modifier_text(m: m) })
}

// What the reader answers for the first type declaration of `src`: `none`, the row as
// `<name> <modifier>...`, or the refusing stage.
fn tdm_observed(src: String) -> String {
  match tdm_parse(src: src) {
    Rejected { diagnostics: _ } => "PARSE_REFUSED"
    Accepted { value: tree, diagnostics: _ } =>
      match tdm_first_type_decl(tree: tree) {
        Absent => "NO_TYPE_DECL"
        Present { value: shell } =>
          match body_lower_type_decl_declared_modifiers(shell: shell) {
            Rejected { diagnostics: d } => "REFUSED " + symbol_lexeme(sym: d.head.reason)
            Accepted { value: capture, diagnostics: _ } =>
              match capture {
                DeclaredTypeModifiersAbsent => "none"
                DeclaredTypeModifiersPresent { row: row } => tdm_row_text(row: row)
              }
          }
      }
  }
}

// CONTROL: no modifier, no row -- the answer the slot gave before this change, kept.
test fn unmodified_alias_carries_no_modifier_holds() -> Bool {
  tdm_observed(src: "module m\ntype T = Int\n") == "none"
}

// RED BEFORE THIS CHANGE (the slot was consumed and nothing read it): the alias carries its modifier.
test fn nominal_opaque_alias_carries_its_modifier_holds() -> Bool {
  tdm_observed(src: "module m\ntype T nominal_opaque = Int\n") == "T nominal_opaque"
}

test fn sole_constructor_record_carries_its_modifier_holds() -> Bool {
  tdm_observed(src: "module m\ntype T sole_constructor { x: Int }\n") == "T sole_constructor"
}

// Both terminals, in slot order, on a generic declaration: the read is positional past `<T>`.
test fn generic_declaration_carries_both_modifiers_in_slot_order_holds() -> Bool {
  tdm_observed(src: "module m\ntype T<A> nominal_opaque sole_constructor = A\n") == "T nominal_opaque sole_constructor"
}

// A modifier SPELLING used as the type's own name is a name, not a modifier.
test fn modifier_spelling_as_the_name_is_not_a_modifier_holds() -> Bool {
  tdm_observed(src: "module m\ntype sole_constructor = Int\n") == "none"
}

// THE PAIRING CLAIM: the real normalize route carries the row onto NormalizedTree, by name. Its
// fixture is BODYLESS (`type T nominal_opaque`, lowered through v2.std.type_binder type_opaque_wrapper)
// because what it exercises is the capture's wiring into normalize, not body lowering: an alias
// right-hand side put the claim over the floor's new-witness eval-step budget with nothing to show for
// it, while the per-shape reads above cover alias, record and generic slots at the reader's interface.
fn tdm_normalized_rows(src: String) -> FreeMonoid<DeclaredTypeModifiers> {
  match bind_outcome(o: tdm_parse(src: src), f: fn(tree) { normalize(parse_tree: tree) }) {
    Rejected { diagnostics: _ } => Empty
    Accepted { value: t, diagnostics: _ } => t.type_declaration_modifiers
  }
}

test fn normalize_carries_the_modifier_row_onto_the_tree_holds() -> Bool {
  match tdm_normalized_rows(src: "module m\ntype T nominal_opaque\n") {
    Cons { head: row, tail: rest } =>
      match rest {
        Empty => tdm_row_text(row: row) == "T nominal_opaque"
        Cons { head: _, tail: _ } => false
      }
    Empty => false
  }
}
