module v2.test.parse.choice_plan

import std.algebra { Cons, Empty }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.collection { List, empty_map }
import v2.std.compilers.lexing { Token }
import v2.std.grammar {
  Choice,
  GrammarExpr,
  GrammarProduction,
  GrammarRoot,
  Optional,
  Sequence,
  StampClass,
  StampLexeme,
  Terminal,
  TerminalStampMode,
  grammar_atom,
  grammar_empty_sync_tokens
}
import v2.compiler.parse {
  ChoiceTokenPrefix,
  ParseExprAccepted,
  ParseExprRejected,
  compile_choice_alts,
  grammar_validate_for_parse,
  parse_expr,
  parse_prov_initial,
  parse_table_empty,
  prepare_grammar_expr
}
import v2.std.algebra { length }
import v2.std.diagnostic { Accepted, Rejected, invariant_port_locus }
import v2.std.logic { Bool }
import v2.std.node { Hash, Symbol, content_hash }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE PRE-CUTOVER INTERPRETER, restated as the oracle: ordered try-left-then-right.
// One parse of the choice vs one-or-two parses of the authored branches. Small hand
// grammars. Each identity is its own test fn so a miss names one interface.

type ChoiceParseObservation
  = ObservedAccepted { remaining: Int, captured: Hash }
  | ObservedRejected

fn pcp_token(token_class: Symbol) -> Token {
  Token { class: token_class, lexeme: "", file: ^pcp_file, start: 0, end: 1 }
}

fn pcp_choice_root(expr: GrammarExpr) -> GrammarRoot {
  GrammarRoot {
    start: ^pcp_start,
    productions: Cons {
      head: GrammarProduction {
        name: ^pcp_start,
        expression: expr,
        emitted: grammar_atom(identity: ^pcp_start)
      },
      tail: std.algebra.Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn pcp_validate_accepts(expr: GrammarExpr) -> Bool {
  match grammar_validate_for_parse(
    root: pcp_choice_root(expr: expr),
    at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^pcp_grammar_contract)
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn pcp_validate_rejects(expr: GrammarExpr) -> Bool {
  match grammar_validate_for_parse(
    root: pcp_choice_root(expr: expr),
    at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^pcp_grammar_contract)
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn pcp_root() -> GrammarRoot {
  GrammarRoot {
    start: ^pcp_start,
    productions: Cons {
      head: GrammarProduction {
        name: ^pcp_start,
        expression: Terminal { token_class: ^pcp_a, stamp: StampClass },
        emitted: grammar_atom(identity: ^pcp_start)
      },
      tail: std.algebra.Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn pcp_observe(expr: GrammarExpr, tokens: List<Token>) -> ChoiceParseObservation {
  match parse_expr(
    expr: expr,
    tokens: tokens,
    all_tokens: tokens,
    root: pcp_root(),
    table: parse_table_empty(),
    prov: parse_prov_initial()
  ) {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: _, prov: _, table: _ } =>
      ObservedAccepted { remaining: length(xs: remaining), captured: content_hash(n: captured) }
    ParseExprRejected { diagnostics: _, table: _ } =>
      ObservedRejected
  }
}

fn oracle_parse_choice(left: GrammarExpr, right: GrammarExpr, tokens: List<Token>) -> ChoiceParseObservation {
  match parse_expr(
    expr: left,
    tokens: tokens,
    all_tokens: tokens,
    root: pcp_root(),
    table: parse_table_empty(),
    prov: parse_prov_initial()
  ) {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: _, prov: _, table: _ } =>
      ObservedAccepted { remaining: length(xs: remaining), captured: content_hash(n: captured) }
    ParseExprRejected { diagnostics: _, table: _ } =>
      match parse_expr(
        expr: right,
        tokens: tokens,
        all_tokens: tokens,
        root: pcp_root(),
        table: parse_table_empty(),
        prov: parse_prov_initial()
      ) {
        ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: _, prov: _, table: _ } =>
          ObservedAccepted { remaining: length(xs: remaining), captured: content_hash(n: captured) }
        ParseExprRejected { diagnostics: _, table: _ } =>
          ObservedRejected
      }
  }
}

fn term(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn term_stamp(token_class: Symbol, stamp: TerminalStampMode) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: stamp }
}

fn seq(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}

fn opt(element: GrammarExpr) -> GrammarExpr {
  Optional { element: element }
}

test fn prepared_choice_disjoint_first_agrees_with_ordered_oracle() -> Bool {
  let left = term(token_class: ^pcp_a)
  let right = term(token_class: ^pcp_b)
  let expr = Choice { left: left, right: right }
  let tokens_a = [pcp_token(token_class: ^pcp_a)]
  pcp_observe(expr: expr, tokens: tokens_a) == oracle_parse_choice(left: left, right: right, tokens: tokens_a)
}

test fn prepared_choice_discriminates_disjoint_first_tokens() -> Bool {
  let expr = Choice { left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_b) }
  let tokens_a = [pcp_token(token_class: ^pcp_a)]
  let tokens_b = [pcp_token(token_class: ^pcp_b)]
  (pcp_observe(expr: expr, tokens: tokens_a) == pcp_observe(expr: expr, tokens: tokens_b)) == false
}

// One nullable sibling: aa | b? on [a]. Ordered try-left-then-right tries aa, rejects, then b?
// matches empty. The count>=2 heuristic used to drop b? from the `a` bucket and reject.
test fn prepared_choice_one_nullable_alt_agrees_after_aa_rejects() -> Bool {
  let aa = seq(left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_a))
  let expr = Choice { left: aa, right: opt(element: term(token_class: ^pcp_b)) }
  let tokens_a = [pcp_token(token_class: ^pcp_a)]
  pcp_validate_accepts(expr: expr)
    && (pcp_observe(expr: expr, tokens: tokens_a) == oracle_parse_choice(left: aa, right: opt(element: term(token_class: ^pcp_b)), tokens: tokens_a))
}

// Two nullable siblings never reach the prepared runtime: validate refuses both_nullable residue.
test fn prepared_choice_two_nullable_alts_validate_refuses() -> Bool {
  let aa = seq(left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_a))
  let both_nullable = Choice {
    left: aa,
    right: Choice { left: opt(element: term(token_class: ^pcp_b)), right: opt(element: term(token_class: ^pcp_b)) }
  }
  pcp_validate_rejects(expr: both_nullable)
}

test fn prepared_choice_shared_prefix_agrees_with_ordered_oracle() -> Bool {
  let aa = seq(left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_a))
  let ab = seq(left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_b))
  let shared_prefix = Choice { left: ab, right: aa }
  let a_then_b = [pcp_token(token_class: ^pcp_a), pcp_token(token_class: ^pcp_b)]
  pcp_observe(expr: shared_prefix, tokens: a_then_b) == oracle_parse_choice(left: ab, right: aa, tokens: a_then_b)
}

test fn compile_choice_alts_stamp_split_is_choice_token_prefix() -> Bool {
  let stamp_split_left = seq(left: term_stamp(token_class: ^pcp_a, stamp: StampClass), right: term(token_class: ^pcp_a))
  let stamp_split_right = seq(left: term_stamp(token_class: ^pcp_a, stamp: StampLexeme), right: term(token_class: ^pcp_b))
  let stamp_left_fold = prepare_grammar_expr(
    expr: stamp_split_left,
    nullable_set: Empty,
    first_rows: empty_map(),
    production: ^pcp_start
  )
  let stamp_right_fold = prepare_grammar_expr(
    expr: stamp_split_right,
    nullable_set: Empty,
    first_rows: empty_map(),
    production: ^pcp_start
  )
  let stamp_bucket = compile_choice_alts(
    alts: Cons { head: stamp_left_fold, tail: Cons { head: stamp_right_fold, tail: Empty } },
    nullable_set: Empty,
    first_rows: empty_map(),
    production: ^pcp_start
  )
  match stamp_bucket.plan {
    ChoiceTokenPrefix { rows: rows } => length(xs: rows) == 2
    _ => false
  }
}

test fn prepared_choice_stamp_split_agrees_with_ordered_oracle() -> Bool {
  let stamp_split_left = seq(left: term_stamp(token_class: ^pcp_a, stamp: StampClass), right: term(token_class: ^pcp_a))
  let stamp_split_right = seq(left: term_stamp(token_class: ^pcp_a, stamp: StampLexeme), right: term(token_class: ^pcp_b))
  let stamp_split = Choice { left: stamp_split_left, right: stamp_split_right }
  let two_a = [pcp_token(token_class: ^pcp_a), pcp_token(token_class: ^pcp_a)]
  pcp_observe(expr: stamp_split, tokens: two_a) == oracle_parse_choice(left: stamp_split_left, right: stamp_split_right, tokens: two_a)
}

test fn grammar_lookahead_consumes_no_token_and_wrong_class_rejects() -> Bool {
  let tokens = [pcp_token(token_class: ^pcp_a)]
  match parse_expr(
    expr: Lookahead { pattern: term(token_class: ^pcp_a) },
    tokens: tokens,
    all_tokens: tokens,
    root: pcp_root(),
    table: parse_table_empty(),
    prov: parse_prov_initial()
  ) {
    ParseExprRejected { diagnostics: _, table: _ } => false
    ParseExprAccepted { remaining: remaining, captured: _, diagnostics: _, prov: prov, table: _ } =>
      (length(xs: remaining) == 1)
        && (parse_prov_frame_len(prov: prov) == 0)
        && match parse_expr(
          expr: Lookahead { pattern: term(token_class: ^pcp_b) },
          tokens: tokens,
          all_tokens: tokens,
          root: pcp_root(),
          table: parse_table_empty(),
          prov: parse_prov_initial()
        ) {
          ParseExprRejected { diagnostics: _, table: _ } => true
          ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: _ } => false
        }
  }
}
