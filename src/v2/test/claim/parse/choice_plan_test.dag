module v2.test.parse.choice_plan

import std.algebra { Cons, Empty }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.collection { List, empty_map, map_lookup }
import v2.std.compilers.lexing { Token }
import v2.std.grammar {
  Choice,
  GrammarExpr,
  GrammarProduction,
  GrammarRoot,
  Nonterminal,
  Optional,
  Sequence,
  StampClass,
  StampLexeme,
  Terminal,
  TerminalStampMode,
  grammar_atom,
  grammar_empty_sync_tokens,
  grammar_expr_literal_terminal
}
import v2.compiler.parse {
  ChoiceByToken,
  ChoiceByWord,
  ChoiceReject,
  ChoiceSharedPrefix,
  ChoiceTokenPrefix,
  ParseExprAccepted,
  ParseExprRejected,
  ParseExprResult,
  PreparedChoice,
  PreparedChoicePlan,
  compile_choice_alts,
  grammar_validate_for_parse,
  parse_expr,
  parse_expr_with_first,
  parse_prov_initial,
  parse_table_empty,
  parse_table_for_production,
  prepare_grammar_expr
}
import v2.std.optional { Absent, Present }
import v2.std.algebra { fold_list, length }
import v2.std.diagnostic { Accepted, Diagnostic, NonEmptyDiagnostics, None, Rejected, Some, invariant_port_locus }
import v2.std.logic { Bool }
import v2.std.node { Hash, Symbol, content_hash }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE PRE-CUTOVER INTERPRETER, restated as the oracle: ordered try-left-then-right.
// One parse of the choice vs one-or-two parses of the authored branches. Small hand
// grammars. Each identity is its own test fn so a miss names one interface.

type ChoiceParseObservation
  = ObservedAccepted { remaining: Int, captured: Hash }
  | ObservedRejected

fn pcp_token(token_class: Symbol) -> Token {
  Token { class: token_class, lexeme: "", file: ^pcp_file, start: 0, end: 1 }
}

fn pcp_choice_root(expr: GrammarExpr) -> GrammarRoot {
  GrammarRoot {
    start: ^pcp_start,
    productions: Cons {
      head: GrammarProduction {
        name: ^pcp_start,
        expression: expr,
        emitted: grammar_atom(identity: ^pcp_start)
      },
      tail: std.algebra.Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn pcp_validate_accepts_without_overlap_residue(expr: GrammarExpr) -> Bool {
  match grammar_validate_for_parse(
    root: pcp_choice_root(expr: expr),
    at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^pcp_grammar_contract)
  ) {
    Accepted { value: _, diagnostics: None } => true
    Accepted { value: _, diagnostics: Some { diagnostics: _ } } => false
    Rejected { diagnostics: _ } => false
  }
}

fn pcp_validate_rejects(expr: GrammarExpr) -> Bool {
  match grammar_validate_for_parse(
    root: pcp_choice_root(expr: expr),
    at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^pcp_grammar_contract)
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn pcp_root() -> GrammarRoot {
  GrammarRoot {
    start: ^pcp_start,
    productions: Cons {
      head: GrammarProduction {
        name: ^pcp_start,
        expression: Terminal { token_class: ^pcp_a, stamp: StampClass },
        emitted: grammar_atom(identity: ^pcp_start)
      },
      tail: std.algebra.Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn pcp_from_parse(result: ParseExprResult) -> ChoiceParseObservation {
  match result {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: _, prov: _, table: _ } =>
      ObservedAccepted { remaining: length(xs: remaining), captured: content_hash(n: captured) }
    ParseExprRejected { diagnostics: _, table: _ } =>
      ObservedRejected
  }
}

// Analyzed table + the production-prepared tree: ChoiceByToken / SharedPrefix /
// TokenPrefix actually run. The oracle below still parses the authored branches
// through parse_table_empty (ordered try-left-then-right).
fn pcp_observe(expr: GrammarExpr, tokens: List<Token>) -> ChoiceParseObservation {
  let root = pcp_choice_root(expr: expr)
  match grammar_validate_for_parse(
    root: root,
    at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^pcp_grammar_contract)
  ) {
    Rejected { diagnostics: _ } => ObservedRejected
    Accepted { value: validated, diagnostics: _ } =>
      let table = parse_table_for_production(validated: validated, all_tokens: tokens)
      match map_lookup(m: table.prepared_exprs, key: root.start) {
        Absent => ObservedRejected
        Present { value: prepared } =>
          pcp_from_parse(
            result: parse_expr_with_first(
              expr: prepared,
              tokens: tokens,
              all_tokens: tokens,
              root: root,
              table: table,
              prov: parse_prov_initial()
            )
          )
      }
  }
}

fn pcp_observe_root(root: GrammarRoot, expr: GrammarExpr, tokens: List<Token>) -> ChoiceParseObservation {
  pcp_from_parse(
    result: parse_expr(
      expr: expr,
      tokens: tokens,
      all_tokens: tokens,
      root: root,
      table: parse_table_empty(),
      prov: parse_prov_initial()
    )
  )
}

fn pcp_choice_plan(expr: GrammarExpr) -> PreparedChoicePlan {
  match prepare_grammar_expr(
    expr: expr,
    nullable_set: Empty,
    first_rows: empty_map(),
    production: ^pcp_start,
    token_dispatch: true
  ).tree {
    PreparedChoice { plan: plan, first: _ } => plan
    _ => ChoiceReject
  }
}

fn pcp_plan_on_token(plan: PreparedChoicePlan, token_class: Symbol) -> PreparedChoicePlan {
  match plan {
    ChoiceByToken { on_token: on_token, on_other: _, on_end: _ } =>
      match map_lookup(m: on_token, key: token_class) {
        Present { value: inner } => inner
        Absent => ChoiceReject
      }
    _ => ChoiceReject
  }
}

fn oracle_parse_choice(left: GrammarExpr, right: GrammarExpr, tokens: List<Token>) -> ChoiceParseObservation {
  match parse_expr(
    expr: left,
    tokens: tokens,
    all_tokens: tokens,
    root: pcp_root(),
    table: parse_table_empty(),
    prov: parse_prov_initial()
  ) {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: _, prov: _, table: _ } =>
      ObservedAccepted { remaining: length(xs: remaining), captured: content_hash(n: captured) }
    ParseExprRejected { diagnostics: _, table: _ } =>
      match parse_expr(
        expr: right,
        tokens: tokens,
        all_tokens: tokens,
        root: pcp_root(),
        table: parse_table_empty(),
        prov: parse_prov_initial()
      ) {
        ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: _, prov: _, table: _ } =>
          ObservedAccepted { remaining: length(xs: remaining), captured: content_hash(n: captured) }
        ParseExprRejected { diagnostics: _, table: _ } =>
          ObservedRejected
      }
  }
}

fn term(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn term_stamp(token_class: Symbol, stamp: TerminalStampMode) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: stamp }
}

fn seq(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}

fn opt(element: GrammarExpr) -> GrammarExpr {
  Optional { element: element }
}

test fn prepared_choice_disjoint_first_agrees_with_ordered_oracle() -> Bool {
  let left = term(token_class: ^pcp_a)
  let right = term(token_class: ^pcp_b)
  let expr = Choice { left: left, right: right }
  let tokens_a = [pcp_token(token_class: ^pcp_a)]
  match pcp_choice_plan(expr: expr) {
    ChoiceByToken { on_token: _, on_other: _, on_end: _ } =>
      pcp_observe(expr: expr, tokens: tokens_a) == oracle_parse_choice(left: left, right: right, tokens: tokens_a)
    _ => false
  }
}

test fn prepared_choice_discriminates_disjoint_first_tokens() -> Bool {
  let expr = Choice { left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_b) }
  let tokens_a = [pcp_token(token_class: ^pcp_a)]
  let tokens_b = [pcp_token(token_class: ^pcp_b)]
  (pcp_observe(expr: expr, tokens: tokens_a) == pcp_observe(expr: expr, tokens: tokens_b)) == false
}

// Unanalyzed table (`parse_table_empty`): NT-headed Choice must not compile ChoiceByToken
// from empty FIRST. Token `b` is only in the right production.
test fn prepared_choice_nonterminal_alts_empty_table_agrees_with_ordered_oracle() -> Bool {
  let left_nt = Nonterminal { production: ^pcp_left_nt }
  let right_nt = Nonterminal { production: ^pcp_right_nt }
  let expr = Choice { left: left_nt, right: right_nt }
  let root = GrammarRoot {
    start: ^pcp_start,
    productions: [
      GrammarProduction {
        name: ^pcp_start,
        expression: expr,
        emitted: grammar_atom(identity: ^pcp_start)
      },
      GrammarProduction {
        name: ^pcp_left_nt,
        expression: term(token_class: ^pcp_a),
        emitted: grammar_atom(identity: ^pcp_left_nt)
      },
      GrammarProduction {
        name: ^pcp_right_nt,
        expression: term(token_class: ^pcp_b),
        emitted: grammar_atom(identity: ^pcp_right_nt)
      }
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
  let tokens_b = [pcp_token(token_class: ^pcp_b)]
  let observed = pcp_observe_root(root: root, expr: expr, tokens: tokens_b)
  let oracle = match parse_expr(
    expr: left_nt,
    tokens: tokens_b,
    all_tokens: tokens_b,
    root: root,
    table: parse_table_empty(),
    prov: parse_prov_initial()
  ) {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: _, prov: _, table: _ } =>
      ObservedAccepted { remaining: length(xs: remaining), captured: content_hash(n: captured) }
    ParseExprRejected { diagnostics: _, table: _ } =>
      match parse_expr(
        expr: right_nt,
        tokens: tokens_b,
        all_tokens: tokens_b,
        root: root,
        table: parse_table_empty(),
        prov: parse_prov_initial()
      ) {
        ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: _, prov: _, table: _ } =>
          ObservedAccepted { remaining: length(xs: remaining), captured: content_hash(n: captured) }
        ParseExprRejected { diagnostics: _, table: _ } =>
          ObservedRejected
      }
  }
  observed == oracle
}

// One nullable sibling: aa | b? on [a]. Ordered try-left-then-right tries aa, rejects, then b?
// matches empty. The count>=2 heuristic used to drop b? from the `a` bucket and reject.
test fn prepared_choice_one_nullable_alt_agrees_after_aa_rejects() -> Bool {
  let aa = seq(left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_a))
  let expr = Choice { left: aa, right: opt(element: term(token_class: ^pcp_b)) }
  let tokens_a = [pcp_token(token_class: ^pcp_a)]
  pcp_validate_accepts_without_overlap_residue(expr: expr)
    && match pcp_choice_plan(expr: expr) {
      ChoiceByToken { on_token: _, on_other: _, on_end: _ } =>
        pcp_observe(expr: expr, tokens: tokens_a) == oracle_parse_choice(left: aa, right: opt(element: term(token_class: ^pcp_b)), tokens: tokens_a)
      _ => false
    }
}

// Two nullable siblings never reach the prepared runtime: validate refuses both_nullable residue.
test fn prepared_choice_two_nullable_alts_validate_refuses() -> Bool {
  let aa = seq(left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_a))
  let both_nullable = Choice {
    left: aa,
    right: Choice { left: opt(element: term(token_class: ^pcp_b)), right: opt(element: term(token_class: ^pcp_b)) }
  }
  pcp_validate_rejects(expr: both_nullable)
}

test fn prepared_choice_shared_prefix_agrees_with_ordered_oracle() -> Bool {
  let aa = seq(left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_a))
  let ab = seq(left: term(token_class: ^pcp_a), right: term(token_class: ^pcp_b))
  let shared_prefix = Choice { left: ab, right: aa }
  let a_then_b = [pcp_token(token_class: ^pcp_a), pcp_token(token_class: ^pcp_b)]
  match pcp_plan_on_token(plan: pcp_choice_plan(expr: shared_prefix), token_class: ^pcp_a) {
    ChoiceSharedPrefix { prefix: _, suffix: _ } =>
      pcp_observe(expr: shared_prefix, tokens: a_then_b) == oracle_parse_choice(left: ab, right: aa, tokens: a_then_b)
    _ => false
  }
}

test fn compile_choice_alts_stamp_split_is_choice_token_prefix() -> Bool {
  let stamp_split_left = seq(left: term_stamp(token_class: ^pcp_a, stamp: StampClass), right: term(token_class: ^pcp_a))
  let stamp_split_right = seq(left: term_stamp(token_class: ^pcp_a, stamp: StampLexeme), right: term(token_class: ^pcp_b))
  let stamp_left_fold = prepare_grammar_expr(
    expr: stamp_split_left,
    nullable_set: Empty,
    first_rows: empty_map(),
    production: ^pcp_start,
    token_dispatch: true
  )
  let stamp_right_fold = prepare_grammar_expr(
    expr: stamp_split_right,
    nullable_set: Empty,
    first_rows: empty_map(),
    production: ^pcp_start,
    token_dispatch: true
  )
  let stamp_bucket = compile_choice_alts(
    alts: Cons { head: stamp_left_fold, tail: Cons { head: stamp_right_fold, tail: Empty } },
    nullable_set: Empty,
    first_rows: empty_map(),
    token_dispatch: true
  )
  match stamp_bucket {
    ChoiceTokenPrefix { rows: rows } => length(xs: rows) == 2
    _ => false
  }
}

test fn prepared_choice_stamp_split_agrees_with_ordered_oracle() -> Bool {
  let stamp_split_left = seq(left: term_stamp(token_class: ^pcp_a, stamp: StampClass), right: term(token_class: ^pcp_a))
  let stamp_split_right = seq(left: term_stamp(token_class: ^pcp_a, stamp: StampLexeme), right: term(token_class: ^pcp_b))
  let stamp_split = Choice { left: stamp_split_left, right: stamp_split_right }
  let two_a = [pcp_token(token_class: ^pcp_a), pcp_token(token_class: ^pcp_a)]
  match pcp_plan_on_token(plan: pcp_choice_plan(expr: stamp_split), token_class: ^pcp_a) {
    ChoiceTokenPrefix { rows: _ } =>
      pcp_observe(expr: stamp_split, tokens: two_a) == oracle_parse_choice(left: stamp_split_left, right: stamp_split_right, tokens: two_a)
    _ => false
  }
}

// LITERAL TERMINALS: DIFFERENT EXACT WORDS ELIMINATE A FIRST-OVERLAP RESIDUE THAT CLASS KEYS KEEP.
//
// The comparison pair below is IDENTICAL once its leading word is erased: both alternatives are
// word . pcp_a. Keyed on (class, word) the two are FIRST-disjoint and validation reports no overlap
// residue; the control is the same pair with the words erased to the bare class, which validation
// must ACCEPT WITH the specific `^parse_grammar_choice_overlap_residue` diagnostic -- named, not
// inferred from the absence of a clean acceptance, so an unrelated rejection fails the control.
// What this establishes is the FIRST-overlap residue, which is a different fact from whether a
// deeper class lookahead could have separated some other pair. The unequal-suffix pair further
// down is kept for a separate purpose: executing a parse through the second word's alternative.

fn pcp_word_token(word: String) -> Token {
  Token { class: ^pcp_word, lexeme: word, file: ^pcp_file, start: 0, end: 1 }
}

fn lit(lexeme: Symbol) -> GrammarExpr {
  grammar_expr_literal_terminal(token_class: ^pcp_word, lexeme: lexeme)
}

fn pcp_same_suffix_word_pair() -> GrammarExpr {
  Choice {
    left: seq(left: lit(lexeme: ^alpha), right: term(token_class: ^pcp_a)),
    right: seq(left: lit(lexeme: ^beta), right: term(token_class: ^pcp_a))
  }
}

fn pcp_same_suffix_class_pair() -> GrammarExpr {
  Choice {
    left: seq(left: term(token_class: ^pcp_word), right: term(token_class: ^pcp_a)),
    right: seq(left: term(token_class: ^pcp_word), right: term(token_class: ^pcp_a))
  }
}

fn pcp_diagnostic_is_overlap_residue(d: Diagnostic) -> Bool {
  d.reason == ^parse_grammar_choice_overlap_residue
}

fn pcp_any_overlap_residue(ne: NonEmptyDiagnostics) -> Bool {
  fold_list(
    xs: ne.tail,
    empty: pcp_diagnostic_is_overlap_residue(d: ne.head),
    cons: fn(found, d) { found || pcp_diagnostic_is_overlap_residue(d: d) }
  )
}

// Positive: the ACCEPTED arm carrying the overlap-residue diagnostic. Rejection, or acceptance with
// only unrelated diagnostics, or clean acceptance, all answer false.
fn pcp_validate_accepts_with_overlap_residue(expr: GrammarExpr) -> Bool {
  match grammar_validate_for_parse(
    root: pcp_choice_root(expr: expr),
    at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^pcp_grammar_contract)
  ) {
    Accepted { value: _, diagnostics: Some { diagnostics: ne } } => pcp_any_overlap_residue(ne: ne)
    Accepted { value: _, diagnostics: None } => false
    Rejected { diagnostics: _ } => false
  }
}

fn pcp_word_pair() -> GrammarExpr {
  Choice {
    left: seq(left: lit(lexeme: ^alpha), right: term(token_class: ^pcp_a)),
    right: seq(left: lit(lexeme: ^beta), right: term(token_class: ^pcp_b))
  }
}

test fn literal_words_sharing_a_class_prefix_validate_without_overlap_residue() -> Bool {
  pcp_validate_accepts_without_overlap_residue(expr: pcp_same_suffix_word_pair())
}

test fn the_same_pair_keyed_by_class_alone_leaves_overlap_residue() -> Bool {
  pcp_validate_accepts_with_overlap_residue(expr: pcp_same_suffix_class_pair())
}

test fn the_class_bucket_of_a_word_pair_dispatches_on_the_word() -> Bool {
  match pcp_plan_on_token(plan: pcp_choice_plan(expr: pcp_word_pair()), token_class: ^pcp_word) {
    ChoiceByWord { on_word: _, on_other: _ } => true
    _ => false
  }
}

test fn the_second_word_parses_through_its_own_alternative() -> Bool {
  let tokens = [pcp_word_token(word: "beta"), pcp_token(token_class: ^pcp_b)]
  let observed = pcp_observe(expr: pcp_word_pair(), tokens: tokens)
  let consumed_all = match observed {
    ObservedAccepted { remaining: r, captured: _ } => r == 0
    ObservedRejected => false
  }
  consumed_all
    && observed == oracle_parse_choice(
      left: seq(left: lit(lexeme: ^alpha), right: term(token_class: ^pcp_a)),
      right: seq(left: lit(lexeme: ^beta), right: term(token_class: ^pcp_b)),
      tokens: tokens
    )
}

test fn a_literal_terminal_rejects_a_different_word_of_its_class() -> Bool {
  pcp_observe_root(root: pcp_root(), expr: lit(lexeme: ^alpha), tokens: [pcp_word_token(word: "gamma")]) == ObservedRejected
}

// MATCHING IS NOT STAMPING. A literal terminal captures exactly what a StampClass terminal of its
// class captures on the same token -- the class identity -- and NOT what a StampLexeme terminal
// captures (the token's own text as atom identity).
test fn a_literal_terminal_publishes_the_class_identity_not_its_word() -> Bool {
  let tokens = [pcp_word_token(word: "alpha")]
  let literal = pcp_observe_root(root: pcp_root(), expr: lit(lexeme: ^alpha), tokens: tokens)
  let by_class = pcp_observe_root(root: pcp_root(), expr: term(token_class: ^pcp_word), tokens: tokens)
  let by_lexeme = pcp_observe_root(root: pcp_root(), expr: term_stamp(token_class: ^pcp_word, stamp: StampLexeme), tokens: tokens)
  literal == by_class && literal != by_lexeme && literal != ObservedRejected
}
