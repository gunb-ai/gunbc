module test.claim.parse_test_lean_grammar

fn lean_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn lean_tokenize_and_parse() -> Outcome<ParseTree> {
  match tokenize(
    text: lean_source_text,
    file: ^lean_parse_fixture_file,
    rules: lean_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: lean_grammar())
  }
}

// Lean lex/grammar accepts the PROOF-1 def+termination_by fixture via tokenize+parse.
// Formerly the data row `claim_lean_source_parses: TestClaim = EqualsClaim`, which no runner executes (the
// required floor runs `test fn` claims only): the same lhs == rhs predicate, made runnable by the
// v2.test.parse census (gunbc#13372).
test fn claim_lean_source_parses_holds() -> Bool {
  (lean_parse_accepted(out: lean_tokenize_and_parse())) == true
}
