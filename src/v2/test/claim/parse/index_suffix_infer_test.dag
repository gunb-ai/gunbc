module v2.test.claim.parse.index_suffix_infer

import v2.compiler.resolve { ResolvedTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.compiler.infer { infer }
import v2.extdeps.languages.dag { dag_language_model }
import std.algebra { Cons, Empty }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE INDEX SUFFIX UNDER INFER, ON THE PRODUCTION ROUTE: source text through
// assemble_program_from_ingest (lowering and resolve for real), then v2.compiler.infer. The
// verdict is read, not asserted from the lowering: an index is judged as the std element access it
// lowers to (v2.std.collection list_at_optional), so a Map base or a non-Int index must refuse.
data isi_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^index_suffix_infer_artifact,
  file_path: "src/v2/pilot/index_suffix_infer_pilot.dag"
}

fn isi_assemble(src: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: DagSourceReadWitness {
        source: Medium { carried: src, fidelity: Lossless },
        artifact: isi_artifact,
        compilation_unit: ^index_suffix_infer_cu,
        source_root: V2Tree
      },
      tail: Empty
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}

fn isi_infer_accepts(o: Outcome<ResolvedTree>) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

fn isi_list_int() -> Outcome<ResolvedTree> {
  isi_assemble(src: "module p\n\nfn f(xs: List<Int>, i: Int) -> Optional<Int> {\n  xs[i]\n}\n")
}

fn isi_map_base() -> Outcome<ResolvedTree> {
  isi_assemble(src: "module p\n\nfn f(m: Map<Int, Int>, i: Int) -> Optional<Int> {\n  m[i]\n}\n")
}

fn isi_bool_index() -> Outcome<ResolvedTree> {
  isi_assemble(src: "module p\n\nfn f(xs: List<Int>, b: Bool) -> Optional<Int> {\n  xs[b]\n}\n")
}

test fn a_list_with_an_int_index_infers_holds() -> Bool {
  isi_infer_accepts(o: isi_list_int())
}

test fn a_map_base_refuses_at_infer_holds() -> Bool {
  isi_infer_accepts(o: isi_map_base()) == false
}

test fn a_non_int_index_refuses_at_infer_holds() -> Bool {
  isi_infer_accepts(o: isi_bool_index()) == false
}
