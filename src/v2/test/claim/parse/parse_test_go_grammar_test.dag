module test.claim.parse_test_go_grammar

fn go_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn go_tokenize_and_parse() -> Outcome<ParseTree> {
  match tokenize(
    text: go_source_text,
    file: ^go_parse_file,
    rules: go_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: go_grammar())
  }
}

// Go corpus symmetry accepts the current add-function source through the Go lex/grammar.
// Formerly the data row `claim_go_add_function_parses: TestClaim = EqualsClaim`, which no runner executes (the
// required floor runs `test fn` claims only): the same lhs == rhs predicate, made runnable by the
// v2.test.parse census (gunbc#13372).
test fn claim_go_add_function_parses_holds() -> Bool {
  (go_parse_accepted(out: go_tokenize_and_parse())) == true
}
