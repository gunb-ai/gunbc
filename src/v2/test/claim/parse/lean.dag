module v2.test.parse.lean

fn lean_parse_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^lean_parse_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^lean_parse_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn lean_parse_accepted(out: v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn lean_tokenize_and_parse() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  match tokenize(
    text: lean_source_text,
    file: ^lean_parse_fixture_file,
    rules: lean_lex()
  ) {
    Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: lean_grammar())
  }
}

data claim_lean_source_parses: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "Lean lex/grammar accepts the PROOF-1 def+termination_by fixture via tokenize+parse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: lean_parse_bool_atom(
    b: lean_parse_accepted(out: lean_tokenize_and_parse())
  ),
  rhs: lean_parse_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Integration }
}
