}

fn cb2_parsed_8() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_8())
}

fn cb2_normalized_8() -> Outcome<NormalizedTree> {
  supplied_parsed_normalize(parsed: cb2_parsed_8())
}

fn cb2_parsed_9() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_9())
}

fn cb2_normalized_9() -> Outcome<NormalizedTree> {
  supplied_parsed_normalize(parsed: cb2_parsed_9())
}

fn cb2_parsed_10() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_10())
}

fn cb2_normalized_10() -> Outcome<NormalizedTree> {
  supplied_parsed_normalize(parsed: cb2_parsed_10())
}

