    Token { class: ^dag_token_ident, lexeme: "W", file: ^closure_parse_batch_two_probe, start: 35, end: 36 },
    Token { class: ^dag_token_lt, lexeme: "<", file: ^closure_parse_batch_two_probe, start: 36, end: 37 },
    Token { class: ^dag_token_int_literal, lexeme: "8", file: ^closure_parse_batch_two_probe, start: 37, end: 38 },
    Token { class: ^dag_token_gt, lexeme: ">", file: ^closure_parse_batch_two_probe, start: 38, end: 39 },
