module v2.test.parse.closure_parse_batch_two

import v2.std.compilers.lexing { Token, TokenStream, token_stream_new }
import v2.compiler.normalized_tree { NormalizedTree }
import v2.test.parse.supplied_token_stream_support {
  supplied_stream_matches_tokenize,
  supplied_parsed_normalize,
  supplied_stream_parse
}
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import v2.std.logic { Bool }
import v2.std.node { Node, NodeFold, Symbol, fold_node, name_occurrences }
import v2.std.integer { Int }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE INPUT IS SUPPLIED; PARSE AND NORMALIZE STILL EXECUTE, over the shared supplied route
// (v2.test.parse.supplied_token_stream_support). Each specimen's stream owes a cb2_fidelity_* claim
// that it IS what the real tokenizer emits for the specimen text, so a stream that drifted from the
// tokenizer reddens there rather than greening a claim about a stream the compiler never produces.
fn cb2_parses(o: Outcome<Node>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn cb2_normalizes(o: Outcome<NormalizedTree>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// Subject: five constructs of the workload closure (//v2/test/parse/expression_bodied_fn_decl_parse:all)
// the native front end refused, each a row of the one dag grammar (v2.extdeps.languages.dag), each
// admitting only what v1.compiler.parse admits. Every positive claim goes red with its row removed;
// every refusing claim pins the row's boundary.

// B -- dag_grammar_generic_arg_expr (std.integer `MachineWidth<8>`).
test fn int_literal_generic_argument_parses_holds() -> Bool {
  cb2_parses(o: cb2_parsed_0())
}

test fn bare_int_literal_is_not_a_type_holds() -> Bool {
  match cb2_parses(o: cb2_parsed_1()) {
    true => false
    false => true
  }
}

// C -- dag_grammar_primary_name_expr (std.cross_tree.resolution `{ module: module }`).
test fn module_keyword_as_a_value_parses_holds() -> Bool {
  cb2_parses(o: cb2_parsed_2())
}

test fn other_keywords_are_not_values_holds() -> Bool {
  match cb2_parses(o: cb2_parsed_3()) {
    true => false
    false => true
  }
}

// D -- the field_decl_block arm of dag_grammar_type_expr (std.pareto `type AxisScan = { .. }`).
test fn anonymous_record_type_expression_parses_holds() -> Bool {
  cb2_parses(o: cb2_parsed_4())
}

// E -- dag_grammar_admit_callers_clause_expr (std.integer qualified_octets). Parsed and discarded
// (gunbc.rung_drop admit_callers_discarded_on_the_native_route).
test fn admit_callers_clause_parses_holds() -> Bool {
  cb2_parses(o: cb2_parsed_5())
}

// The clause is consumed at fn lowering: the declaration normalizes to an Arrow with the clause
// discarded, which is the rung drop's population, so a retained clause shell would fail here.
test fn admit_callers_clause_normalizes_holds() -> Bool {
  cb2_normalizes(o: cb2_normalized_5())
}

test fn empty_admit_callers_refuses_as_in_v1_holds() -> Bool {
  match cb2_parses(o: cb2_parsed_6()) {
    true => false
    false => true
  }
}

// A -- dag_grammar_else_less_if_stmt_expr (extdeps.uri_path guards): parsed, then refused at
// lowering with its own typed cause, never dropped or rewritten.
test fn else_less_if_refuses_at_lowering_with_its_cause_holds() -> Bool {
  match cb2_normalized_7() {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      diagnostics_fatal_reason(d: d) == ^body_lowering_reason_else_less_if_unlowered
  }
}

// F -- namespace_graft, name_resolve and symbol_index_fill consume the parser's closed projection
// roster (v2.compiler.parse parse_tree_projection_edge) instead of a "_node_projection" lexeme-suffix
// test (v2.std.runtime runtime_value_node_projection and siblings). The two-declaration form is the
// loud face of the defect (an ill-formed Conj); the single-declaration form is the silent one: the
// member was dissolved and the module normalized WITHOUT it.
fn named_edge_count_anywhere(root: Node, name: Symbol) -> Int {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(n) { name_occurrences(name: name, children: n.children) },
      step: fn(acc, _, sub) { acc + sub }
    }
  )
}

test fn two_declarations_named_node_projection_normalize_holds() -> Bool {
  cb2_normalizes(o: cb2_normalized_8())
}

test fn declaration_named_node_projection_is_kept_holds() -> Bool {
  match cb2_normalized_9() {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      named_edge_count_anywhere(root: tree.root, name: ^a_node_projection) == 1
  }
}

// The roster still sees through real projection structure: an ordinary module normalizes and
// its authored member is reachable once, exactly as above, so the change is not a blanket accept.
test fn ordinary_declaration_is_kept_once_holds() -> Bool {
  match cb2_normalized_10() {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      named_edge_count_anywhere(root: tree.root, name: ^a) == 1
  }
}

// ONE PREPARED INPUT PER SPECIMEN. Each specimen is parsed once and normalized once, by the
// nullary producers below, which v2.workflow.floor_pure_producer_share warms outside the fold (the
// same disposition as v2.test.parse.coproduct_leading_pipe_and_positional_payload_parse cps_*).
// Every claim then inspects the result shape at the interface it discriminates at, instead of
// each paying a full parse and normalize again (DESIGN section 3, a witness discriminates at one
// interface). The real path still executes: these producers run the real prepared-grammar parse
// and normalize over a stream each cb2_fidelity_* claim proves equal to the real tokenizer's.

fn cb2_parsed_0() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_0())
}

fn cb2_parsed_1() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_1())
}

fn cb2_parsed_2() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_2())
}

fn cb2_parsed_3() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_3())
}

fn cb2_parsed_4() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_4())
}

fn cb2_parsed_5() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_5())
}

fn cb2_normalized_5() -> Outcome<NormalizedTree> {
  supplied_parsed_normalize(parsed: cb2_parsed_5())
}

fn cb2_parsed_6() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_6())
}

fn cb2_parsed_7() -> Outcome<Node> {
  supplied_stream_parse(tokens: cb2_stream_7())
}

fn cb2_normalized_7() -> Outcome<NormalizedTree> {
