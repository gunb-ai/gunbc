module v2.test.claim.parse.corpus_file_sweep_probe

// SWEEP PROBE (in-session instrument, generated): ONE claim per corpus source file, so every
// file that does not parse under the list-separator wall is NAMED by a failing claim. This is
// the enumeration CI cannot give -- its refusal report is truncated to the first 40 lines.

import v2.compiler.parse_acceptance_census { parse_acceptance_of_text }

fn parses(path: String) -> Bool {
  parse_acceptance_of_text(text: filesystem_read(path: path).content, path: path) == "accepted"
}

test fn f_dag_product_acoustic_ceiling_dag_parses_holds() -> Bool { parses(path: "dag/product/acoustic_ceiling.dag") }
