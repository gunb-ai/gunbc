module v2.test.claim.parse.corpus_separator_sweep_probe

// SWEEP PROBE (in-session instrument, generated): one claim per corpus directory, so the
// directories that do not parse under the list-separator wall are NAMED by a failing claim
// rather than counted away. Two claims per directory: every file accepted, and no file
// refusing with the wall's own cause.

import v2.compiler.parse_acceptance_census { parse_acceptance_of_text }
import v2.std.text { String, char_eq }
import std.algebra { count_where, is_prefix_of, length }
import gunbc.source_root_read { SourceRootPathsRead, SourceRootPathsRefused, SourceRootWalkTask, source_root_walk }

fn dir_paths(dir: String) -> List<String> {
  match source_root_walk(
    pending: [SourceRootWalkTask { path: dir, root: true, origin: dir }],
    paths: [],
    suffix: ".dag"
  ) {
    SourceRootPathsRead { paths: walked } => map(walked, fn(w) { w.path })
    SourceRootPathsRefused { path: _, kind: _, cause: _ } => []
  }
}

fn verdict_of(path: String) -> String {
  parse_acceptance_of_text(text: filesystem_read(path: path).content, path: path)
}

fn every_file_accepted(dir: String) -> Bool {
  let paths = dir_paths(dir: dir)
  let bad = count_where(xs: paths, predicate: fn(p) { verdict_of(path: p) != "accepted" })
  (length(xs: paths) > 0) && (bad == 0)
}

fn no_wall_refusal(dir: String) -> Bool {
  let paths = dir_paths(dir: dir)
  let hits = count_where(
    xs: paths,
    predicate: fn(p) {
      is_prefix_of(prefix: "refused parse_list_element_separator_missing", xs: verdict_of(path: p), eq: char_eq)
    }
  )
  hits == 0
}

test fn d_dag_examples_all_accepted_holds() -> Bool { every_file_accepted(dir: "dag/examples") }
test fn d_dag_examples_no_wall_refusal_holds() -> Bool { no_wall_refusal(dir: "dag/examples") }
