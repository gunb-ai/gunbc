test fn vfs_fidelity_15() -> Bool {
  supplied_stream_matches_tokenize(
    text: "module std.content_hash\n\ntype HashFamily =\n  | Fnv1a64StructuralFamily\n  | Sha256Family\n\ntype Fnv1a64Structural {\n  digest: Fnv1a64StructuralDigestHex\n}\n\ntype Sha256Digest {\n  hex: Sha256DigestHex\n}\n\ntype ContentHash =\n  | Fnv1a64(Fnv1a64Structural)\n  | Sha256Hash(Sha256Digest)\n\nfn structural_content_hash(digest: Fnv1a64StructuralDigestHex) -> Fnv1a64Structural {\n  Fnv1a64Structural { digest: digest }\n}\n\nfn as_content_hash_structural(structural: Fnv1a64Structural) -> ContentHash {\n  Fnv1a64(structural)\n}\n\nfn compare_content_hash(left: ContentHash, right: ContentHash) -> ContentHashComparison {\n  match left {\n    Fnv1a64(left_structural) =>\n      match right {\n        Fnv1a64(right_structural) =>\n          if content_hash_eq_structural(left: left_structural, right: right_structural) {\n            ContentHashEqual\n          } else {\n            ContentHashDifferent\n          }\n        Sha256Hash(_) => ContentHashCrossFamilyIncomparable\n      }\n    Sha256Hash(left_digest) =>\n      match right {\n        Sha256Hash(right_digest) =>\n          if content_hash_eq_cryptographic(left: left_digest, right: right_digest) {\n            ContentHashEqual\n          } else {\n            ContentHashDifferent\n          }\n        Fnv1a64(_) => ContentHashCrossFamilyIncomparable\n      }\n  }\n}\n",
    file: ^variant_field_probe,
    supplied: vfs_stream_15()
  )
}
