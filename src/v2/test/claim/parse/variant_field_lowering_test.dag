test fn vfs_fidelity_15() -> Bool {
  supplied_stream_matches_tokenize(
    text: "module std.content_hash\n\ntype ContentHash =\n  | Fnv1a64(Fnv1a64Structural)\n  | Sha256Hash(Sha256Digest)\n\nfn compare_content_hash(left: ContentHash) -> ContentHashComparison {\n  match left {\n    Fnv1a64(left_structural) => ContentHashEqual\n    Sha256Hash(left_digest) => ContentHashDifferent\n  }\n}\n",
    file: ^variant_field_probe,
    supplied: vfs_stream_15()
  )
}

