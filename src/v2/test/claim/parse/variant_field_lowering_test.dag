    Rejected { diagnostics: _ } => false
  }
}

test fn vf_probe_g_normalize_big() -> Bool {
  vf_normalizes(text: vf_probe_big)
}

// FEASIBILITY PROBE: a hand-supplied token stream for `type C = A(Int) | B`, to establish that
// parse_module_prepared accepts a constructed stream and what the supplied-token route costs.
fn vf_probe_supplied_tokens() -> TokenStream {
  token_stream_new(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^variant_field_probe, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "m", file: ^variant_field_probe, start: 7, end: 8 },
    Token { class: ^dag_token_dot, lexeme: ".", file: ^variant_field_probe, start: 8, end: 9 },
    Token { class: ^dag_token_ident, lexeme: "t", file: ^variant_field_probe, start: 9, end: 10 },
    Token { class: ^dag_token_kw_type, lexeme: "type", file: ^variant_field_probe, start: 12, end: 16 },
    Token { class: ^dag_token_ident, lexeme: "C", file: ^variant_field_probe, start: 17, end: 18 },
    Token { class: ^dag_token_eq, lexeme: "=", file: ^variant_field_probe, start: 19, end: 20 },
    Token { class: ^dag_token_ident, lexeme: "A", file: ^variant_field_probe, start: 21, end: 22 },
    Token { class: ^dag_token_lparen, lexeme: "(", file: ^variant_field_probe, start: 22, end: 23 },
    Token { class: ^dag_token_ident, lexeme: "Int", file: ^variant_field_probe, start: 23, end: 26 },
    Token { class: ^dag_token_rparen, lexeme: ")", file: ^variant_field_probe, start: 26, end: 27 },
    Token { class: ^dag_token_pipe, lexeme: "|", file: ^variant_field_probe, start: 28, end: 29 },
    Token { class: ^dag_token_ident, lexeme: "B", file: ^variant_field_probe, start: 30, end: 31 }
  ])
}

test fn vf_probe_h_supplied_tokens_parse_and_normalize() -> Bool {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => false
    Accepted { value: prepared, diagnostics: residue } =>
      match parse_module_prepared(tokens: vf_probe_supplied_tokens(), prepared: prepared, validation_residue: residue) {
        Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

// FIDELITY: the supplied stream must BE what the tokenizer emits for the same text, or every
// claim built on it is green about a stream the real route never produces. Compared as one
// canonical projection per stream -- a single fold each, no pairwise walk needed.
fn vf_probe_stream_projection(ts: TokenStream) -> String {
  fold(ts.all, init: "", f: fn(acc, t) {
    concat(concat(concat(acc, symbol_lexeme(sym: t.class)), "="), concat(t.lexeme, ";"))
  })
}

test fn vf_probe_i_supplied_tokens_equal_real_tokenize() -> Bool {
  match tokenize(text: vf_positional_sum, file: ^variant_field_probe, rules: dag_lex()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: real, diagnostics: _ } =>
      vf_probe_stream_projection(ts: real)
        == vf_probe_stream_projection(ts: vf_probe_supplied_tokens())
  }
}

data vf_probe_zero_arg_call: String = "module m.t\n\nfn f() -> Int {\n  1\n}\n\nfn g() -> Int {\n  f()\n}\n"

test fn vf_probe_j_zero_arg_call_lowers() -> Bool {
  vf_normalizes(text: vf_probe_zero_arg_call)
}

