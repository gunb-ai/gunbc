module v2.test.parse.parse_table_content_key

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn mk_table(grammar: v2.std.node.Hash, tokens: v2.std.node.Hash) -> v2.compiler.parse.ParseTable {
  let base = parse_table_empty()
  v2.compiler.parse.ParseTableRealization {
    artifact_kind: base.artifact_kind,
    provider_id: base.provider_id,
    materialization: base.materialization,
    grammar_digest: grammar,
    token_stream_digest: tokens,
    entries: base.entries,
    memo_hits: base.memo_hits,
    memo_misses: base.memo_misses,
    memo_lookup_calls: base.memo_lookup_calls,
    nullable_set: base.nullable_set,
    first_rows: base.first_rows,
    productions_by_name: base.productions_by_name
  }
}

fn grammar_one() -> v2.std.node.Hash { symbol_identity_digest(sym: ^ctk_grammar_one) }
fn grammar_two() -> v2.std.node.Hash { symbol_identity_digest(sym: ^ctk_grammar_two) }
fn tokens_one() -> v2.std.node.Hash { symbol_identity_digest(sym: ^ctk_tokens_one) }
fn tokens_two() -> v2.std.node.Hash { symbol_identity_digest(sym: ^ctk_tokens_two) }

fn table_g1_t1() -> v2.compiler.parse.ParseTable { mk_table(grammar: grammar_one(), tokens: tokens_one()) }
fn table_g2_t1() -> v2.compiler.parse.ParseTable { mk_table(grammar: grammar_two(), tokens: tokens_one()) }
fn table_g1_t2() -> v2.compiler.parse.ParseTable { mk_table(grammar: grammar_one(), tokens: tokens_two()) }

fn key_p0_a() -> v2.compiler.parse.ParsePositionKey { v2.compiler.parse.ParsePositionKey { position: 0, production: ^ctk_prod_a } }
fn key_p1_a() -> v2.compiler.parse.ParsePositionKey { v2.compiler.parse.ParsePositionKey { position: 1, production: ^ctk_prod_a } }
fn key_p0_b() -> v2.compiler.parse.ParsePositionKey { v2.compiler.parse.ParsePositionKey { position: 0, production: ^ctk_prod_b } }

test fn witness_subject_deterministic() -> Bool {
  let a = parse_table_subject(table: table_g1_t1(), key: key_p0_a())
  let b = parse_table_subject(table: mk_table(grammar: grammar_one(), tokens: tokens_one()), key: key_p0_a())
  a == b
}

test fn witness_subject_position_sensitive() -> Bool {
  let a = parse_table_subject(table: table_g1_t1(), key: key_p0_a())
  let b = parse_table_subject(table: table_g1_t1(), key: key_p1_a())
  a != b
}

test fn witness_subject_production_sensitive() -> Bool {
  let a = parse_table_subject(table: table_g1_t1(), key: key_p0_a())
  let b = parse_table_subject(table: table_g1_t1(), key: key_p0_b())
  a != b
}

test fn witness_subject_grammar_scope_sensitive() -> Bool {
  let a = parse_table_subject(table: table_g1_t1(), key: key_p0_a())
  let b = parse_table_subject(table: table_g2_t1(), key: key_p0_a())
  a != b
}

test fn witness_subject_token_stream_scope_sensitive() -> Bool {
  let a = parse_table_subject(table: table_g1_t1(), key: key_p0_a())
  let b = parse_table_subject(table: table_g1_t2(), key: key_p0_a())
  a != b
}

