module v2.test.parse.grammar_expect

import std.types { List }
import v2.compiler.parse { ParseArtifact, parse_module }
import v2.std.compilers.lexing { Token, token_stream_new }
import v2.std.diagnostic {
  Accepted,
  ByteRange,
  DeclarationLocus,
  InvariantPortLocus,
  NodeLocus,
  Outcome,
  Rejected,
  SourcePortLocus,
  Textual,
  WholeFile,
  diagnostics_fatal
}
import v2.std.grammar {
  AfterLineBreak,
  Choice,
  Expect,
  GrammarExpr,
  GrammarExprFold,
  GrammarProduction,
  GrammarRoot,
  LiteralTerminal,
  ModeledGrammar,
  Nonterminal,
  Optional,
  RefuseOnMatch,
  Repeat,
  Sequence,
  StampClass,
  Terminal,
  fold_grammar_expr,
  grammar_atom,
  grammar_empty_sync_tokens
}
import v2.std.parse_refusal_reason {
  DataValueMissingAfterEq,
  FnExpressionBodyMissingAfterEq,
  ParseRefusalReason,
  parse_refusal_reason_symbol
}
import v2.std.integer { Int }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol, content_hash }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// `v2.std.grammar` `Expect` IS A LABEL, NEVER A CUT. These claims hold it to that over hand grammars
// small enough for the floor's per-claim budget:
//   * TIE: two expectations failing at the same furthest position resolve to the one ordered
//     choice tried FIRST, and swapping the alternatives swaps the answer -- so the label is
//     decided by authored order, not by evaluation accident.
//   * TRANSPARENCY: wrapping EVERY subexpression of a grammar in Expect changes no accepted tree.
// A reason outside the closed `v2.std.parse_refusal_reason` vocabulary is not a claim here: it does
// not typecheck. The two tie labels are the vocabulary's two real variants.
// The dag grammar's own use -- the `fn ... =` expression body -- is claimed in
// v2.test.parse.expression_bodied_fn_decl_parse.

fn ge_token(class: Symbol, start: Int) -> Token {
  Token { class: class, lexeme: std.algebra.Empty, file: ^ge_file, start: start, end: start + 1 }
}

fn ge_terminal(class: Symbol) -> GrammarExpr {
  Terminal { token_class: class, stamp: StampClass }
}

fn ge_production(name: Symbol, expression: GrammarExpr) -> GrammarProduction {
  GrammarProduction { name: name, expression: expression, emitted: grammar_atom(identity: name) }
}

// start = item*; item = (a b) | (A c); A = a. Both alternatives start on `a`, and the second
// reaches it through a nonterminal, so no shared-prefix factoring merges them: on `a` the choice
// tries left, then right.
fn ge_root(item: GrammarExpr, a_expr: GrammarExpr) -> GrammarRoot {
  GrammarRoot {
    start: ^ge_start,
    productions: [
      ge_production(name: ^ge_start, expression: Repeat { element: Nonterminal { production: ^ge_item } }),
      ge_production(name: ^ge_item, expression: item),
      ge_production(name: ^ge_a, expression: a_expr)
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn ge_left_alt(reason: ParseRefusalReason) -> GrammarExpr {
  Sequence { left: ge_terminal(class: ^ge_tok_a), right: Expect { element: ge_terminal(class: ^ge_tok_b), reason: reason } }
}

fn ge_right_alt(reason: ParseRefusalReason) -> GrammarExpr {
  Sequence { left: Nonterminal { production: ^ge_a }, right: Expect { element: ge_terminal(class: ^ge_tok_c), reason: reason } }
}

fn ge_parse(root: GrammarRoot, tokens: List<Token>) -> Outcome<ParseArtifact> {
  parse_module(tokens: token_stream_new(all: tokens), grammar: ModeledGrammar { root: root })
}

fn ge_fatal_is(parsed: Outcome<ParseArtifact>, reason: ParseRefusalReason, start: Int, end: Int) -> Bool {
  match parsed {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      let fatal = diagnostics_fatal(d: d)
      (fatal.reason == parse_refusal_reason_symbol(reason: reason))
        && match fatal.at {
          SourcePortLocus { anchor: anchor, file: file, extent: extent } =>
            (anchor.at == ^parse_stage_locus_port)
              && (file == ^ge_file)
              && match extent {
                ByteRange { start: s, end: e } => (s == start) && (e == end)
                WholeFile => false
              }
          Textual { file: _, extent: _ } => false
          NodeLocus { anchor: _ } => false
          InvariantPortLocus { anchor: _, invariant: _ } => false
          DeclarationLocus { declaration: _ } => false
        }
  }
}

// A lone `a`: both alternatives consume it, and both expectations then fail at end of input -- a
// tie at the furthest position. The refusal is located at the `a` they were to follow.
data ge_tie_tokens: List<Token> = [ge_token(class: ^ge_tok_a, start: 0)]

test fn expect_tie_first_ordered_alternative_wins_holds() -> Bool {
  let root = ge_root(
    item: Choice { left: ge_left_alt(reason: FnExpressionBodyMissingAfterEq), right: ge_right_alt(reason: DataValueMissingAfterEq) },
    a_expr: ge_terminal(class: ^ge_tok_a)
  )
  ge_fatal_is(parsed: ge_parse(root: root, tokens: ge_tie_tokens), reason: FnExpressionBodyMissingAfterEq, start: 0, end: 1)
}

// The discriminating half of the tie: the same two expectations with the alternatives swapped.
// If the tie were broken by anything but ordered-choice position, one of these two would red.
test fn expect_tie_swapped_alternatives_swap_the_label_holds() -> Bool {
  let root = ge_root(
    item: Choice { left: ge_right_alt(reason: DataValueMissingAfterEq), right: ge_left_alt(reason: FnExpressionBodyMissingAfterEq) },
    a_expr: ge_terminal(class: ^ge_tok_a)
  )
  ge_fatal_is(parsed: ge_parse(root: root, tokens: ge_tie_tokens), reason: DataValueMissingAfterEq, start: 0, end: 1)
}

// Every subexpression wrapped in Expect { _, FnExpressionBodyMissingAfterEq }, recursively.
fn ge_wrap_all(expr: GrammarExpr) -> GrammarExpr {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, stamp) { Expect { element: Terminal { token_class: token_class, stamp: stamp }, reason: FnExpressionBodyMissingAfterEq } },
      literal_terminal: fn(token_class, lexeme) { Expect { element: LiteralTerminal { token_class: token_class, lexeme: lexeme }, reason: FnExpressionBodyMissingAfterEq } },
      nonterminal: fn(production) { Expect { element: Nonterminal { production: production }, reason: FnExpressionBodyMissingAfterEq } },
      sequence: fn(l, r) { Expect { element: Sequence { left: l, right: r }, reason: FnExpressionBodyMissingAfterEq } },
      choice: fn(l, r) { Expect { element: Choice { left: l, right: r }, reason: FnExpressionBodyMissingAfterEq } },
      optional: fn(e) { Expect { element: Optional { element: e }, reason: FnExpressionBodyMissingAfterEq } },
      repeat: fn(e) { Expect { element: Repeat { element: e }, reason: FnExpressionBodyMissingAfterEq } },
      expect: fn(e, reason) { Expect { element: Expect { element: e, reason: reason }, reason: FnExpressionBodyMissingAfterEq } },
      refuse_on_match: fn(e, reason) { Expect { element: RefuseOnMatch { element: e, reason: reason }, reason: FnExpressionBodyMissingAfterEq } },
      after_line_break: fn(e) { Expect { element: AfterLineBreak { element: e }, reason: FnExpressionBodyMissingAfterEq } },
      not_predicate: fn(e) { Expect { element: NotPredicate { element: e }, reason: FnExpressionBodyMissingAfterEq } }
    }
  )
}

fn ge_plain_item() -> GrammarExpr {
  Choice {
    left: Sequence { left: ge_terminal(class: ^ge_tok_a), right: ge_terminal(class: ^ge_tok_b) },
    right: Sequence {
      left: Nonterminal { production: ^ge_a },
      right: Optional { element: ge_terminal(class: ^ge_tok_c) }
    }
  }
}

// `a b a c a`: exercises both alternatives, the optional present and absent, and the repeat.
data ge_accept_tokens: List<Token> = [
  ge_token(class: ^ge_tok_a, start: 0),
  ge_token(class: ^ge_tok_b, start: 2),
  ge_token(class: ^ge_tok_a, start: 4),
  ge_token(class: ^ge_tok_c, start: 6),
  ge_token(class: ^ge_tok_a, start: 8)
]

test fn expect_wrapping_every_row_changes_no_accepted_tree_holds() -> Bool {
  let plain = ge_root(item: ge_plain_item(), a_expr: ge_terminal(class: ^ge_tok_a))
  let wrapped = GrammarRoot {
    start: ^ge_start,
    productions: [
      ge_production(name: ^ge_start, expression: ge_wrap_all(expr: Repeat { element: Nonterminal { production: ^ge_item } })),
      ge_production(name: ^ge_item, expression: ge_wrap_all(expr: ge_plain_item())),
      ge_production(name: ^ge_a, expression: ge_wrap_all(expr: ge_terminal(class: ^ge_tok_a)))
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
  match ge_parse(root: plain, tokens: ge_accept_tokens) {
    Rejected { diagnostics: _ } => false
    Accepted { value: plain_artifact, diagnostics: _ } =>
      match ge_parse(root: wrapped, tokens: ge_accept_tokens) {
        Rejected { diagnostics: _ } => false
        Accepted { value: wrapped_artifact, diagnostics: _ } =>
          content_hash(n: plain_artifact.tree) == content_hash(n: wrapped_artifact.tree)
      }
  }
}
