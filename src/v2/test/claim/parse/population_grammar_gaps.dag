module v2.test.claim.parse.population_grammar_gaps

import v2.compiler.reference_conservation_admission { conservation_subject_of_text }
import v2.std.grammar { parse_production_emitted_identity_optional }
import v2.std.diagnostic { Accepted, NodeLocus, Rejected, diagnostics_fatal }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Present }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE FORMS v2'S GRAMMAR REFUSED THAT THE .dag CORPUS WRITES (gunbc.rung_drop population_parse_*), each
// admitted with the controls that make the admission a reading: the form parses, a malformed neighbour
// still refuses at the parse door, and where the form has no lowered carrier the module refuses at
// lowering, located, rather than lowering with the form dropped.

// ---- field refinement: parse, then refuse (the parameter precedent, parameter_refinement) -------------

data refined_field_source: String = "module probe.gaps\n\ntype T { n: Int where range(min: 0) }\n"
data refined_io_field_source: String = "module probe.gaps\n\nservice S {\n  operation Op {\n    input { n: Int where range(min: 0) }\n    transport shell { argv: [\"a\"] }\n  }\n}\n"
data plain_field_source: String = "module probe.gaps\n\ntype T { n: Int }\n"
data refinement_after_default_red_source: String = "module probe.gaps\n\ntype T { n: Int = 1 where range(min: 0) }\n"
data refinement_without_predicate_red_source: String = "module probe.gaps\n\ntype T { n: Int where }\n"

fn parsed_ok(text: String) -> Bool {
  match conservation_subject_of_text(path: "probe_gaps.dag", text: text).parsed {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn normalized_ok(text: String) -> Bool {
  match conservation_subject_of_text(path: "probe_gaps.dag", text: text).normalized {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn refused_at_clause(text: String) -> Bool {
  match conservation_subject_of_text(path: "probe_gaps.dag", text: text).normalized {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      diagnostics_fatal(d: d).reason == ^body_lowering_reason_field_refinement_unmodeled
        && match diagnostics_fatal(d: d).at {
             NodeLocus { anchor: a } =>
               match parse_production_emitted_identity_optional(node: a.at) {
                 Present { value: id } => id == ^dag_surface_where_refinement_clause
                 Absent => false
               }
             _ => false
           }
  }
}

fn refined_field_parsed() -> Bool { parsed_ok(text: refined_field_source) }
fn refined_field_refused() -> Bool { refused_at_clause(text: refined_field_source) }
fn refined_io_field_parsed() -> Bool { parsed_ok(text: refined_io_field_source) }
fn refined_io_field_refused() -> Bool { refused_at_clause(text: refined_io_field_source) }
fn plain_field_normalized() -> Bool { normalized_ok(text: plain_field_source) }
fn refinement_after_default_parsed() -> Bool { parsed_ok(text: refinement_after_default_red_source) }
fn refinement_without_predicate_parsed() -> Bool { parsed_ok(text: refinement_without_predicate_red_source) }

test fn a_refined_field_parses_holds() -> Bool { refined_field_parsed() }

test fn a_refined_field_refuses_at_its_clause_holds() -> Bool { refined_field_refused() }

test fn a_refined_io_field_parses_holds() -> Bool { refined_io_field_parsed() }

test fn a_refined_io_field_refuses_at_its_clause_holds() -> Bool { refined_io_field_refused() }

test fn an_unrefined_field_still_normalizes_holds() -> Bool { plain_field_normalized() }

test fn a_refinement_after_the_default_still_refuses_at_parse_holds() -> Bool {
  refinement_after_default_parsed() == false
}

test fn a_refinement_without_a_predicate_still_refuses_at_parse_holds() -> Bool {
  refinement_without_predicate_parsed() == false
}
