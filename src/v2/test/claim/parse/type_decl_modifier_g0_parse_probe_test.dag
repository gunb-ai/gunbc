module v2.test.parse.type_decl_modifier_g0_parse_probe

import std.types { List }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.language_model { LanguageModel }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol, node_subtree_nodes, symbol_lexeme }
import v2.std.algebra { fold_list, list_snoc_item }
import std.optional { Absent, Present }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SH-2: posix_effective_principal.dag stopped at leftover `nominal_opaque` because G0's
// dag_grammar_type_decl_expr had no slot between the type name and `=` / field block.
// v1.compiler.parse drop_leading_type_modifier / type_body_tokens_after_modifiers drops
// exactly those two ident spellings, in that order. The treatment is the smallest alias
// that carries `nominal_opaque`; the standing red is an unknown ident in that slot, which
// v1 also leaves for the body parser to refuse.

data probe_cached_lm: LanguageModel = dag_language_model()

fn parse_outcome(src: String) -> String {
  let lm = probe_cached_lm
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Rejected { diagnostics: _ } => "TOKENIZE_REFUSED"
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } =>
          symbol_lexeme(sym: fold_list(xs: d.tail, empty: d.head.reason, cons: fn(_acc, diag) { diag.reason }))
        Accepted { value: _, diagnostics: _ } => "ACCEPTED"
      }
  }
}

data unmodified_alias_source: String = "module m\ntype T = Int\n"
data nominal_opaque_alias_source: String = "module m\ntype T nominal_opaque = Int\n"
data sole_constructor_record_source: String = "module m\ntype T sole_constructor { x: Int }\n"
data unknown_modifier_red_source: String = "module m\ntype T not_a_modifier = Int\n"
data modifier_spelling_as_data_name_source: String = "module m\ndata sole_constructor: Int = 1\n"
data modifier_spelling_as_caret_source: String = "module m\nfn f() -> Int { ^sole_constructor }\n"
data modifier_spelling_as_generic_param_source: String = "module m\ntype T<sole_constructor> = Int\n"

test fn unmodified_type_alias_still_parses_holds() -> Bool {
  parse_outcome(src: unmodified_alias_source) == "ACCEPTED"
}

test fn nominal_opaque_type_alias_parses_holds() -> Bool {
  parse_outcome(src: nominal_opaque_alias_source) == "ACCEPTED"
}

test fn sole_constructor_type_record_still_parses_holds() -> Bool {
  parse_outcome(src: sole_constructor_record_source) == "ACCEPTED"
}

test fn unknown_type_decl_modifier_still_refuses_holds() -> Bool {
  parse_outcome(src: unknown_modifier_red_source) == "parse_g0_tokens_remain"
}

test fn sole_constructor_as_a_data_name_still_parses_holds() -> Bool {
  parse_outcome(src: modifier_spelling_as_data_name_source) == "ACCEPTED"
}

test fn sole_constructor_as_a_caret_symbol_still_parses_holds() -> Bool {
  parse_outcome(src: modifier_spelling_as_caret_source) == "ACCEPTED"
}

// THE ARRANGEMENT THESE CLAIMS MEASURE. Every declared name, including a caret symbol's
// referenced name since MQ-1 PR-2, is lexeme-stamped: it publishes the authored text itself
// (v2.compiler.02_parse symbol_intern_lexeme), whichever of the three token classes lexed it.
// DECLARED FLIP (MQ-1 PR-2, true->false of caret_referenced_ident_does_not_publish_the_lexeme_holds):
// the caret site USED to be the one exception -- class-stamped, publishing the generic
// ^dag_token_ident for every caret literal (a grammar limitation the identity_captured_navigation
// lens worked around by re-reading source spans, a route now deleted), which is how two
// different caret symbols reached one lowered node. That claim is inverted below as
// caret_referenced_ident_publishes_the_lexeme_holds: the caret tree and the data-decl tree now both
// carry the word, so reverting the caret site to a class stamp turns it red.

// ONE PARSE FOR THE CARET FIXTURE. The three caret-site claims ask membership questions of the same
// parsed tree, so its atom identities are produced once here (enrolled warm in
// v2.workflow.floor_pure_producer_share) and each claim reads the list rather than re-parsing.
fn caret_tree_atom_identities() -> List<Symbol> {
  let lm = probe_cached_lm
  match tokenize(text: modifier_spelling_as_caret_source, file: ^probe, rules: lm.lex) {
    Rejected { diagnostics: _ } => [^caret_probe_tokenize_refused]
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => [^caret_probe_parse_refused]
        Accepted { value: art, diagnostics: _ } =>
          fold_list(
            xs: node_subtree_nodes(root: art.tree),
            empty: [],
            cons: fn(acc, n) {
              match node_atom_identity_optional(node: n) {
                Present { value: id } => list_snoc_item(xs: acc, item: id)
                Absent => acc
              }
            }
          )
      }
  }
}

fn caret_tree_carries(identity: Symbol) -> Bool {
  fold_list(xs: caret_tree_atom_identities(), empty: false, cons: fn(acc, id) { acc || id == identity })
}

fn parsed_tree_carries_atom(src: String, identity: Symbol) -> Bool {
  let lm = probe_cached_lm
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: art, diagnostics: _ } =>
          fold_list(
            xs: node_subtree_nodes(root: art.tree),
            empty: false,
            cons: fn(acc, n) {
              match node_atom_identity_optional(node: n) {
                Present { value: id } => acc || id == identity
                Absent => acc
              }
            }
          )
      }
  }
}

test fn caret_referenced_ident_publishes_the_lexeme_holds() -> Bool {
  caret_tree_carries(identity: ^sole_constructor)
}

test fn data_decl_name_is_lexeme_stamped_holds() -> Bool {
  parsed_tree_carries_atom(
    src: modifier_spelling_as_data_name_source,
    identity: ^sole_constructor
  )
}

// "THE LEXEME" IS ALSO "NOT A CLASS". v2.compiler.02_parse resolves a class stamp as exactly
// `StampClass => tok.class`, so a class-stamped site publishes a token class -- ^dag_token_ident, or,
// once these spellings lex as their own keyword classes, ^dag_token_kw_sole_constructor -- WITHOUT
// the stamp mode changing. The claims below assert what the caret site publishes positively and
// what it must not: neither the generic identifier class nor the keyword class.
// DECLARED FLIP (MQ-1 PR-2, true->false of caret_referenced_ident_publishes_the_generic_ident_class_holds,
// measured seed base 9ce039421d0 vs head f2ad6a8a417 by fierce-gull-556): the caret site no longer
// publishes ^dag_token_ident, and it is the only site in this fixture that did; inverted below as
// caret_referenced_ident_does_not_publish_the_generic_ident_class_holds.

test fn caret_referenced_ident_does_not_publish_the_generic_ident_class_holds() -> Bool {
  caret_tree_carries(identity: ^dag_token_ident) == false
}

test fn caret_referenced_ident_does_not_publish_the_keyword_class_holds() -> Bool {
  caret_tree_carries(identity: ^dag_token_kw_sole_constructor) == false
}

// FLIPPED 2026-10-01 (DESIGN 4b(4)), the generic-parameter twin of the caret flip above: measured on
// main abcb48293f, the generic-parameter site publishes the LEXEME ^sole_constructor and no site in
// this fixture publishes ^dag_token_ident. The positive half asserts the lexeme the site carries, not
// only the class it no longer does: an answer-only "not the ident class" would stay green if the site
// published nothing at all.
test fn generic_param_publishes_the_lexeme_holds() -> Bool {
  parsed_tree_carries_atom(
    src: modifier_spelling_as_generic_param_source,
    identity: ^sole_constructor
  )
}

test fn generic_param_does_not_publish_the_generic_ident_class_holds() -> Bool {
  parsed_tree_carries_atom(
    src: modifier_spelling_as_generic_param_source,
    identity: ^dag_token_ident
  ) == false
}

test fn generic_param_does_not_publish_the_keyword_class_holds() -> Bool {
  parsed_tree_carries_atom(
    src: modifier_spelling_as_generic_param_source,
    identity: ^dag_token_kw_sole_constructor
  ) == false
}
