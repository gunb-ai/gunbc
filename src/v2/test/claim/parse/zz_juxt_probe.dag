module v2.test.claim.parse.zz_juxt_probe

import v2.test.claim.type_param_binder_frame { tpb_assemble }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn src_of(body: String) -> String {
  "module p\n\ntype X {\n  s: Int\n  t: Int\n}\n\nfn f(s: Int, t: Int, u: Int) -> X {\n  " + body + "\n}\n"
}

fn assembled(body: String) -> Bool {
  match tpb_assemble(src: src_of(body: body)) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn control_long_form_assembles_holds() -> Bool { assembled(body: "X { s: s, t: t }") }
test fn true_s_assembles_holds() -> Bool { assembled(body: "X { true s }") }
test fn one_assembles_holds() -> Bool { assembled(body: "X { 1 }") }
