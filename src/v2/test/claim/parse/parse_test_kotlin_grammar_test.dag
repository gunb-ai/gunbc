module test.claim.parse_test_kotlin_grammar

data kotlin_extended_fn_source: String = "fun choose(x: Int): Int { val y: Int = x + 1; if (y > 0) { return y }; return 0 }"

fn kotlin_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn kotlin_tokenize_and_parse() -> Outcome<ParseTree> {
  match tokenize(
    text: kotlin_extended_fn_source,
    file: ^kotlin_parse_file,
    rules: kotlin_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: kotlin_grammar())
  }
}

// Kotlin lex/grammar accepts an extended function with val, if, return, and binary expressions.
// Formerly the data row `claim_kotlin_extended_function_parses: TestClaim = EqualsClaim`, which no runner executes (the
// required floor runs `test fn` claims only): the same lhs == rhs predicate, made runnable by the
// v2.test.parse census (gunbc#13372).
test fn claim_kotlin_extended_function_parses_holds() -> Bool {
  (kotlin_parse_accepted(out: kotlin_tokenize_and_parse())) == true
}
