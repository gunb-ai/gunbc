module v2.test.claim.parse.juxtaposition_shape_probe

import v2.compiler.reference_conservation_admission { conservation_subject_of_text }
import v2.compiler.body_lowering_fold { body_lower_body_subtree_lower, body_lower_stmt_spine_has_successor, body_lower_unwrap_captured }
import v2.extdeps.languages.dag { ParseSubtreeAbsent, ParseSubtreeFound, parse_subtree_find_production_captured }
import v2.std.diagnostic { Accepted, Rejected }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.node { Node, Symbol, node_subtree_nodes }
import v2.std.grammar { parse_production_emitted_identity_optional }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SHAPE PROBE (investigation only; not a claim cell for the PR). It answers the DESIGN 6b boundary
// question for the juxtaposed-literal class: when a fn body is two juxtaposed bracketed literals
// on separate lines, does the PARSE tree emit a dag_surface_stmt_seq (two statements -> lowering is
// the boundary) or not (the second literal did not become a statement -> grammar is the boundary)?
// Run at origin/main 85758c1ab612 with claim_batch and report each test fn's value.

fn two_source() -> String {
  "module probe.juxtap_two\n\nimport v2.std.list { List }\nimport v2.std.integer { Int }\n\nfn juxtap_two() -> List<Int> {\n  [1, 2, 3]\n  [4, 5]\n}\n"
}

fn one_source() -> String {
  "module probe.juxtap_one\n\nimport v2.std.list { List }\nimport v2.std.integer { Int }\n\nfn juxtap_one() -> List<Int> {\n  [1, 2, 3]\n}\n"
}

// A list literal, one bracketed literal, on its own line as the body's only statement.
fn one_line_list_source() -> String {
  "module probe.juxtap_line\n\nimport v2.std.list { List }\nimport v2.std.integer { Int }\n\nfn pair(value: Int) -> List<Int> {\n  let wire = value\n  [wire, wire]\n}\n"
}

fn parse_tree(tag: String, text: String) -> Optional<Node> {
  match conservation_subject_of_text(path: "probe_" + tag + ".dag", text: text).parsed {
    Accepted { value: artifact, diagnostics: _ } => Present { value: artifact.tree }
    Rejected { diagnostics: _ } => Absent
  }
}

// Count the dag_surface_stmt nodes in the body. claim_batch reports PASS/FAIL, so expose the count
// as Bool thresholds. This is the load-bearing read: a genuine TWO-statement juxtaposition has 2 stmt
// children (and both lowering authorities would already refuse it); a body that lowering ACCEPTS but
// that folds to the last literal must have collapsed to ONE recognized statement, which localizes the
// boundary to the grammar absorbing the second bracket.
fn count_stmts(tag: String, text: String) -> Int {
  match parse_tree(tag: tag, text: text) {
    Present { value: t } =>
      fold(node_subtree_nodes(root: t), init: 0, f: fn(acc, m) {
        if emitted_is(n: m, sym: ^dag_surface_stmt) { acc + 1 } else { acc }
      })
    Absent => 0
  }
}

// juxtap_two: how many statements does the parser recognize? 2 => lowering recognition gap; 1 => grammar
// absorbed the second bracket into one statement.
test fn jp_two_stmt_at_least_one() -> Bool { count_stmts(tag: "two", text: two_source()) >= 1 }
test fn jp_two_stmt_at_least_two() -> Bool { count_stmts(tag: "two", text: two_source()) >= 2 }
test fn jp_two_stmt_at_least_three() -> Bool { count_stmts(tag: "two", text: two_source()) >= 3 }

// juxtap_one control: a single-literal body must be exactly ONE statement (so at_least_two is false).
test fn jp_one_stmt_at_least_one() -> Bool { count_stmts(tag: "one", text: one_source()) >= 1 }
test fn jp_one_stmt_at_least_two() -> Bool { count_stmts(tag: "one", text: one_source()) >= 2 }

// let-then-tail control: a binding plus a tail value is exactly TWO statements (at_least_two true,
// at_least_three false) -- the trustworthy two-statement reference the juxtaposition is compared to.
test fn jp_line_stmt_at_least_two() -> Bool { count_stmts(tag: "line", text: one_line_list_source()) >= 2 }
test fn jp_line_stmt_at_least_three() -> Bool { count_stmts(tag: "line", text: one_line_list_source()) >= 3 }

// THE decisive lowering read. body_lower_stmt_spine_head_optional / _rest_optional use find_named_child,
// which searches the SUBTREE recursively. A list literal `[a, b, c]` is itself an element sequence with
// left/right projections, so a SINGLE list-literal statement could be mis-read as having a statement
// successor -- spuriously routing a one-statement body through the spine and reading the last operand.
// If jp_one_spine_has_successor PASSes on a single-literal body, the spine successor recognition is
// matching the list literal's INTERNAL element sequence, not a real following statement => LOWERING fix
// (restrict the spine projections to the statement spine, not the expression subtree).
fn first_stmt_seq(root: Node) -> Optional<Node> {
  fold(node_subtree_nodes(root: root), init: optional_absent(), f: fn(acc, m) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match parse_production_emitted_identity_optional(node: m) {
          Present { value: id } => if id == ^dag_surface_stmt_seq { optional_present(value: m) } else { optional_absent() }
          Absent => optional_absent()
        }
    }
  })
}

// body_lower_try_statement_spine hands body_lower_stmt_spine_has_successor the CAPTURED child of the
// dag_surface_stmt_seq production (body_lower_find_captured unwraps it), not the production shell. The
// right-nested spine carries grammar_sequence_left/right as DIRECT children of that captured Conj, and
// find_named_child does not recurse -- so the read must unwrap the shell first (body_lower_unwrap_captured)
// exactly as the gate does. A faithful two-statement spine reports a successor; if it does not, the
// spine structure itself is the gap.
fn spine_successor(tag: String, text: String) -> Bool {
  match parse_tree(tag: tag, text: text) {
    Present { value: t } =>
      match first_stmt_seq(root: t) {
        Present { value: shell } =>
          match body_lower_unwrap_captured(shell: shell) {
            Present { value: spine } => body_lower_stmt_spine_has_successor(spine: spine)
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

// The decisive read at the real lowering authority. body_lower_body_from_fn_captured -> body_lower_body_subtree_lower
// -> body_lower_try_statement_spine is the fn-body route normalize takes. body_lower_body_subtree_lower on the
// fn_body's captured child REJECTS a non-final bare value once the spine is seen; it ACCEPTS when the body
// silently folds to the last literal. This is the exact predicate the fix must flip.
fn body_subtree_rejects(tag: String, text: String) -> Bool {
  match parse_tree(tag: tag, text: text) {
    Present { value: t } =>
      match parse_subtree_find_production_captured(root: t, emitted: ^dag_surface_fn_body) {
        ParseSubtreeFound { captured: body } =>
          match body_lower_body_subtree_lower(captured: body) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        ParseSubtreeAbsent => false
      }
    Absent => false
  }
}

// A one-statement body must report NO successor. If juxtap_one reports a successor, the spine matched
// the list's internal element sequence (the recursive-projection bug).
test fn jp_one_spine_has_successor() -> Bool { spine_successor(tag: "one", text: one_source()) }
test fn jp_two_spine_has_successor() -> Bool { spine_successor(tag: "two", text: two_source()) }
// Reference: the let-then-tail body has TWO statements, so a successor is expected here.
test fn jp_line_spine_has_successor() -> Bool { spine_successor(tag: "line", text: one_line_list_source()) }

// Juxtaposed BARE NAMES (no brackets): the A-vs-B discriminator. If body_lower_body_subtree_lower already
// REJECTS this (a bare value before a tail), the spine authority fires for bare values and the list case is
// a list-specific gap; if it ACCEPTS, every juxtaposed non-final bare value escapes uniformly.
fn names_source() -> String {
  "module probe.juxtap_names\n\nimport v2.std.integer { Int }\n\nfn two_names(a: Int, b: Int) -> Int {\n  a\n  b\n}\n"
}

// THE decisive lowering predicate at body_lower_body_subtree_lower (the fn-body route normalize takes).
// At base every one of these ACCEPTS today (the silent last-wins); the fix must flip jp_two and jp_names
// to REJECT while jp_one / jp_line stay ACCEPT.
test fn jp_two_body_subtree_rejects() -> Bool { body_subtree_rejects(tag: "two", text: two_source()) }
test fn jp_one_body_subtree_rejects() -> Bool { body_subtree_rejects(tag: "one", text: one_source()) }
test fn jp_line_body_subtree_rejects() -> Bool { body_subtree_rejects(tag: "line", text: one_line_list_source()) }
test fn jp_names_body_subtree_rejects() -> Bool { body_subtree_rejects(tag: "names", text: names_source()) }

fn emitted_is(n: Node, sym: Symbol) -> Bool {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } => id == sym
    Absent => false
  }
}

fn subtree_has_emitted(root: Node, sym: Symbol) -> Bool {
  fold(node_subtree_nodes(root: root), init: false, f: fn(acc, m) { acc || emitted_is(n: m, sym: sym) })
}

fn two_parses() -> Bool {
  match parse_tree(tag: "two", text: two_source()) {
    Present { value: _ } => true
    Absent => false
  }
}

// THE decisive read: does juxtaposing two bracketed literals emit a statement sequence?
fn two_has_stmt_seq() -> Bool {
  match parse_tree(tag: "two", text: two_source()) {
    Present { value: t } => subtree_has_emitted(root: t, sym: ^dag_surface_stmt_seq)
    Absent => false
  }
}

fn two_has_stmt() -> Bool {
  match parse_tree(tag: "two", text: two_source()) {
    Present { value: t } => subtree_has_emitted(root: t, sym: ^dag_surface_stmt)
    Absent => false
  }
}

fn one_has_stmt_seq() -> Bool {
  match parse_tree(tag: "one", text: one_source()) {
    Present { value: t } => subtree_has_emitted(root: t, sym: ^dag_surface_stmt_seq)
    Absent => false
  }
}

// Positive control: the let-then-list shape already normalizes on main (index_suffix claim); it must
// still report a statement sequence here, so the probe's dag_surface_stmt_seq read is trustworthy.
fn line_has_stmt_seq() -> Bool {
  match parse_tree(tag: "line", text: one_line_list_source()) {
    Present { value: t } => subtree_has_emitted(root: t, sym: ^dag_surface_stmt_seq)
    Absent => false
  }
}

// How many stmt_seq nodes does the juxtaposed body emit? Encoded as Bool reads using only || / && /
// match (the constructs proven in sibling claims). 0 = the juxtaposition never became a statement
// sequence; a spine holding both statements = the parse made a stmt_seq and lowering failed to refuse.
fn two_has_two_stmt_seqs() -> Bool {
  match parse_tree(tag: "two", text: two_source()) {
    Present { value: t } =>
      fold(node_subtree_nodes(root: t), init: false, f: fn(seen_any, m) {
        if seen_any { seen_any } else { emitted_is(n: m, sym: ^dag_surface_stmt_seq) }
      })
    Absent => false
  }
}

test fn jp_two_parses() -> Bool { two_parses() }
test fn jp_two_has_stmt_seq() -> Bool { two_has_stmt_seq() }
test fn jp_two_has_stmt() -> Bool { two_has_stmt() }
test fn jp_one_has_stmt_seq() -> Bool { one_has_stmt_seq() }
test fn jp_line_has_stmt_seq() -> Bool { line_has_stmt_seq() }
