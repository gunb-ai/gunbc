module v2.test.parse.typescript


data ts_type_alias_task_source: String = "type Task = { id: TaskId, title: string, status: TaskStatus };"

data ts_type_alias_minimal_source: String = "type Box = { value: number };"

data ts_type_alias_missing_eq_source: String = "type Box { value: number };"

data ts_union_task_status_source: String = "const status: 'Open' | 'InProgress' | 'Done' = status;"

data ts_union_minimal_source: String = "const bit: 'On' | 'Off' = bit;"

fn ts_parse_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^ts_parse_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^ts_parse_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn ts_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn ts_tokenize_and_parse_source(text: String) -> Outcome<ParseTree> {
  match tokenize(
    text: text,
    file: ^ts_parse_file,
    rules: ts_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: ts_grammar())
  }
}

data claim_ts_type_alias_task_parses: TestClaim = EqualsClaim {
  label: "TS grammar accepts the Task record-type alias: type Task = { id: TaskId, title: string, status: TaskStatus };",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_parse_bool_atom(
    b: ts_parse_accepted(
      out: ts_tokenize_and_parse_source(text: ts_type_alias_task_source)
    )
  ),
  rhs: ts_parse_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_ts_type_alias_minimal_parses: TestClaim = EqualsClaim {
  label: "TS grammar accepts a minimal single-field record-type alias with the spec-required `=` token",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_parse_bool_atom(
    b: ts_parse_accepted(
      out: ts_tokenize_and_parse_source(text: ts_type_alias_minimal_source)
    )
  ),
  rhs: ts_parse_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_ts_type_alias_missing_eq_rejected: TestClaim = EqualsClaim {
  label: "TS grammar REJECTS the no-`=` form `type Box { value: number };` — parse rejects missing ts_token_eq after ident",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_parse_bool_atom(
    b: ts_parse_accepted(
      out: ts_tokenize_and_parse_source(text: ts_type_alias_missing_eq_source)
    )
  ),
  rhs: ts_parse_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_ts_union_task_status_parses: TestClaim = EqualsClaim {
  label: "TS grammar accepts a 3-variant string-literal discriminated union in a const annotation (TaskStatus surface): const status: 'Open' | 'InProgress' | 'Done' = status;",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_parse_bool_atom(
    b: ts_parse_accepted(
      out: ts_tokenize_and_parse_source(text: ts_union_task_status_source)
    )
  ),
  rhs: ts_parse_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_ts_union_minimal_parses: TestClaim = EqualsClaim {
  label: "TS grammar accepts a minimal two-variant string-literal union (regression against left-recursive form requiring ≥3 variants)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_parse_bool_atom(
    b: ts_parse_accepted(
      out: ts_tokenize_and_parse_source(text: ts_union_minimal_source)
    )
  ),
  rhs: ts_parse_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data ts_typed_fn_list_tasks_source: String = "function list_tasks(): Task[] { return x; }"

data claim_ts_typed_fn_list_tasks_parses: TestClaim = EqualsClaim {
  label: "TS grammar accepts a typed-return fn with array-of-named-type: function list_tasks(): Task[] { return x; }",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_parse_bool_atom(
    b: ts_parse_accepted(
      out: ts_tokenize_and_parse_source(text: ts_typed_fn_list_tasks_source)
    )
  ),
  rhs: ts_parse_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
