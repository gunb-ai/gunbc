module v2.test.parse.go_wave2a

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }
import v2.extdeps.languages.go { go_source_text, go_wave1_lex, go_wave1_grammar }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.grammar { ParseTree }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.logic { Bool }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}
fn go_wave2a_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^go_wave2a_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^go_wave2a_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn go_wave2a_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn go_wave2a_tokenize_and_parse() -> Outcome<ParseTree> {
  match tokenize(
    text: go_source_text,
    file: ^go_wave2a_file,
    rules: go_wave1_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: go_wave1_grammar())
  }
}

data claim_go_wave2a_add_function_parses: TestClaim = EqualsClaim {
  label: "Go Wave 2a corpus symmetry accepts the current MVP add-function source through Go wave1 lex/grammar",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_wave2a_bool_atom(
    b: go_wave2a_parse_accepted(out: go_wave2a_tokenize_and_parse())
  ),
  rhs: go_wave2a_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
