module v2.test.claim.parse.parameter_refinement

import v2.compiler.reference_conservation_admission { conservation_subject_of_text }

import v2.std.diagnostic { Accepted, Rejected }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A PARAMETER MAY REFINE ITS TYPE WITH A WHERE CLAUSE (v2.extdeps.languages.dag
// dag_grammar_typed_param_expr), as v1 reads it. It PARSES; the clause lowers onto the
// parameter's type through body_lower_kept_where_clause (the type-variant reader).
data refined_source: String = "module probe.param_refine\n\nfn wait(seconds: Int where range(min: 1, max: 3600)) -> Int {\n  seconds\n}\n"
data plain_source: String = "module probe.param_refine\n\nfn wait(seconds: Int) -> Int {\n  seconds\n}\n"

fn refined_parsed() -> Bool {
  match conservation_subject_of_text(path: "probe_refined.dag", text: refined_source).parsed {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn refined_normalized() -> Bool {
  match conservation_subject_of_text(path: "probe_refined.dag", text: refined_source).normalized {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn plain_normalized() -> Bool {
  match conservation_subject_of_text(path: "probe_plain.dag", text: plain_source).normalized {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn a_refined_parameter_parses_holds() -> Bool { refined_parsed() }

test fn a_refined_parameter_lowers_holds() -> Bool { refined_normalized() }

test fn an_unrefined_parameter_still_normalizes_holds() -> Bool { plain_normalized() }
