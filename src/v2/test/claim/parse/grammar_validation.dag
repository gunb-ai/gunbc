module v2.test.parse.grammar_validation


fn validation_bool_atom(b: Bool) -> Node {
  match b {
    true => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^validation_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^validation_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn validation_outcome_accepted(out: v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree>) -> Bool {
  match out {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn validation_terminal_production(name: v2.std.node.Symbol) -> v2.std.grammar.GrammarProduction {
  v2.std.grammar.GrammarProduction {
    name: name,
    expression: Terminal { token_class: ^validation_tok_class, stamp: StampClass },
    emitted: grammar_atom(identity: name)
  }
}

fn validation_token(class: v2.std.node.Symbol, start: Int, end: Int) -> v2.std.compilers.lexing.Token {
  v2.std.compilers.lexing.Token { class: class, lexeme: std.algebra.Empty, file: ^validation_file, start: start, end: end }
}

data validation_dup_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_start,
  productions: std.algebra.Cons {
    head: validation_terminal_production(name: ^validation_start),
    tail: std.algebra.Cons { head: validation_terminal_production(name: ^validation_start), tail: std.algebra.Empty }
  },
  sync_tokens: grammar_empty_sync_tokens()
}

data validation_missing_start_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_start,
  productions: std.algebra.Cons { head: validation_terminal_production(name: ^validation_other), tail: std.algebra.Empty },
  sync_tokens: grammar_empty_sync_tokens()
}

data validation_dangling_ref_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_start,
  productions: std.algebra.Cons {
    head: v2.std.grammar.GrammarProduction {
      name: ^validation_start,
      expression: v2.std.grammar.Nonterminal { production: ^validation_other },
      emitted: grammar_atom(identity: ^validation_start)
    },
    tail: std.algebra.Empty
  },
  sync_tokens: grammar_empty_sync_tokens()
}

data validation_left_recursive_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_rec_start,
  productions: std.algebra.Cons {
    head: v2.std.grammar.GrammarProduction {
      name: ^validation_rec_start,
      expression: v2.std.grammar.Sequence {
        left: v2.std.grammar.Nonterminal { production: ^validation_rec_start },
        right: v2.std.grammar.Terminal { token_class: ^validation_tok_class, stamp: StampClass }
      },
      emitted: grammar_atom(identity: ^validation_rec_start)
    },
    tail: std.algebra.Empty
  },
  sync_tokens: grammar_empty_sync_tokens()
}

data validation_right_recursive_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_rec_start,
  productions: std.algebra.Cons {
    head: v2.std.grammar.GrammarProduction {
      name: ^validation_rec_start,
      expression: v2.std.grammar.Sequence {
        left: v2.std.grammar.Terminal { token_class: ^validation_tok_class, stamp: StampClass },
        right: Optional { element: v2.std.grammar.Nonterminal { production: ^validation_rec_start } }
      },
      emitted: grammar_atom(identity: ^validation_rec_start)
    },
    tail: std.algebra.Empty
  },
  sync_tokens: grammar_empty_sync_tokens()
}

data validation_two_distinct_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_start,
  productions: std.algebra.Cons {
    head: validation_terminal_production(name: ^validation_start),
    tail: std.algebra.Cons { head: validation_terminal_production(name: ^validation_other), tail: std.algebra.Empty }
  },
  sync_tokens: grammar_empty_sync_tokens()
}

data validation_ambiguous_choice_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_start,
  productions: std.algebra.Cons {
    head: v2.std.grammar.GrammarProduction {
      name: ^validation_start,
      expression: v2.std.grammar.Choice {
        left: v2.std.grammar.Terminal { token_class: ^validation_tok_class, stamp: StampClass },
        right: v2.std.grammar.Terminal { token_class: ^validation_tok_class, stamp: StampClass }
      },
      emitted: grammar_atom(identity: ^validation_start)
    },
    tail: std.algebra.Empty
  },
  sync_tokens: grammar_empty_sync_tokens()
}

data validation_disjoint_choice_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_start,
  productions: std.algebra.Cons {
    head: v2.std.grammar.GrammarProduction {
      name: ^validation_start,
      expression: v2.std.grammar.Choice {
        left: v2.std.grammar.Terminal { token_class: ^validation_tok_class, stamp: StampClass },
        right: v2.std.grammar.Terminal { token_class: ^validation_tok_class_b, stamp: StampClass }
      },
      emitted: grammar_atom(identity: ^validation_start)
    },
    tail: std.algebra.Empty
  },
  sync_tokens: grammar_empty_sync_tokens()
}

fn validation_overlap_choice_validate_accepts_with_residue() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: validation_ambiguous_choice_root, at: at) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } =>
      match d {
        Some { diagnostics: residue } => residue.head.reason == ^parse_grammar_choice_overlap_residue
        None => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

data validation_nullable_ambiguous_choice_root: v2.std.grammar.GrammarRoot = v2.std.grammar.GrammarRoot {
  start: ^validation_start,
  productions: std.algebra.Cons {
    head: v2.std.grammar.GrammarProduction {
      name: ^validation_start,
      expression: v2.std.grammar.Choice {
        left: Optional { element: v2.std.grammar.Terminal { token_class: ^validation_tok_class, stamp: StampClass } },
        right: Optional { element: v2.std.grammar.Terminal { token_class: ^validation_tok_class, stamp: StampClass } }
      },
      emitted: grammar_atom(identity: ^validation_start)
    },
    tail: std.algebra.Empty
  },
  sync_tokens: grammar_empty_sync_tokens()
}

fn validation_nullable_ambiguity_validate_rejects() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: validation_nullable_ambiguous_choice_root, at: at) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
  }
}

fn validation_disjoint_choice_residue_is_none() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: validation_disjoint_choice_root, at: at) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } =>
      match d {
        None => true
        Some { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn validation_disjoint_choice_validate_accepts() -> Bool {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: validation_disjoint_choice_root, at: at) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn validation_lookup_present_holds_named() -> Bool {
  match grammar_lookup_production(root: validation_two_distinct_root, name: ^validation_other) {
    Holds { value: production } => production.name == ^validation_other
    Violates { diagnostic: _ } => false
  }
}

fn validation_lookup_missing_violates() -> Bool {
  match grammar_lookup_production(root: validation_two_distinct_root, name: ^validation_missing) {
    Violates { diagnostic: _ } => true
    Holds { value: _ } => false
  }
}

data validation_one_token_list: List<v2.std.compilers.lexing.Token> = std.algebra.Cons {
  head: validation_token(class: ^validation_tok_class, start: 0, end: 1),
  tail: std.algebra.Empty
}

data validation_two_token_list: List<v2.std.compilers.lexing.Token> = std.algebra.Cons {
  head: validation_token(class: ^validation_tok_class, start: 0, end: 1),
  tail: std.algebra.Cons { head: validation_token(class: ^validation_tok_class, start: 1, end: 2), tail: std.algebra.Empty }
}

fn validation_right_recursive_parse_fixture() -> v2.std.diagnostic.Outcome<v2.std.grammar.ParseTree> {
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_validate_for_parse(root: validation_right_recursive_root, at: at) {
    v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
    v2.std.diagnostic.Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: validation_two_token_list,
        validated: validated,
        production_name: ^validation_rec_start
      )
  }
}

fn validation_empty_sync_found() -> Bool {
  match parse_skip_to_sync(
    tokens: validation_one_token_list,
    sync_tokens: grammar_empty_sync_tokens()
  ) {
    ParseSyncState { found_sync: found, result: _ } => found
  }
}

data claim_duplicate_productions_detected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_has_duplicate_productions returns true for duplicate production names",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_duplicate_productions(root: validation_dup_root)),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_distinct_productions_not_duplicate: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_has_duplicate_productions returns false for distinct production names",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_duplicate_productions(root: validation_two_distinct_root)),
  rhs: validation_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_lookup_production_present_holds: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_lookup_production returns Holds with the production matching the requested name",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: validation_lookup_present_holds_named()),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_lookup_production_absent_violates: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_lookup_production returns Violates for a name absent from productions",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: validation_lookup_missing_violates()),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_undefined_nonterminal_detected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_has_undefined_nonterminals returns true for missing start production",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_undefined_nonterminals(root: validation_missing_start_root)),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_dangling_nonterminal_in_expression_detected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_has_undefined_nonterminals returns true when start production references undefined nonterminal",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_undefined_nonterminals(root: validation_dangling_ref_root)),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_empty_sync_set_no_token_drain: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "parse_skip_to_sync with empty sync set returns found_sync: false for non-empty input",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: validation_empty_sync_found()),
  rhs: validation_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_left_recursion_detected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_has_left_recursion returns true for A = A 'x' (direct left recursion)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_left_recursion(root: validation_left_recursive_root)),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_right_recursion_not_left_recursive: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_has_left_recursion returns false for A = 'x' A? (right-recursive, non-left)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_left_recursion(root: validation_right_recursive_root)),
  rhs: validation_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_right_recursive_parse_succeeds: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "parse_production accepts right-recursive A = 'x' A? on two matching tokens via memoized ParseTable",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(
    b: validation_outcome_accepted(out: validation_right_recursive_parse_fixture())
  ),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_choice_ambiguity_detected: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_has_choice_ambiguity returns true when Choice branches share a FIRST terminal",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_choice_ambiguity(root: validation_ambiguous_choice_root)),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_disjoint_choice_not_ambiguous: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_has_choice_ambiguity returns false when Choice FIRST sets are disjoint",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_choice_ambiguity(root: validation_disjoint_choice_root)),
  rhs: validation_bool_atom(b: false),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_validate_accepts_overlap_with_counted_residue: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_validate_for_parse accepts non-nullable Choice FIRST overlap as counted typed residue (reason parse_grammar_choice_overlap_residue); runtime routes it to parse_choice_residue_backtrack",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: validation_overlap_choice_validate_accepts_with_residue()),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_validate_rejects_nullable_choice_ambiguity: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_validate_for_parse stays fail-closed on genuine ambiguity: both-nullable Choice arms sharing a FIRST terminal are Rejected",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: validation_nullable_ambiguity_validate_rejects()),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_disjoint_choice_validate_residue_none: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "disjoint-FIRST Choice validates with zero residue diagnostics (residue channel discriminates overlap from clean)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: validation_disjoint_choice_residue_is_none()),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}

data claim_validate_accepts_disjoint_choice: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "grammar_validate_for_parse accepts grammars whose Choice branches have disjoint FIRST sets",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: validation_disjoint_choice_validate_accepts()),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: Unit }
}
