  label: "v2.compiler.parse.grammar_has_choice_ambiguity returns true when v2.std.grammar.Choice branches share a FIRST terminal",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: validation_bool_atom(b: v2.compiler.parse.grammar_has_choice_ambiguity(root: validation_ambiguous_choice_root)),
  rhs: validation_bool_atom(b: true),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: v2.std.verification.Unit }
}

data claim_disjoint_choice_not_ambiguous: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "v2.compiler.parse.grammar_has_choice_ambiguity returns false when v2.std.grammar.Choice FIRST sets are disjoint",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: validation_bool_atom(b: v2.compiler.parse.grammar_has_choice_ambiguity(root: validation_disjoint_choice_root)),
