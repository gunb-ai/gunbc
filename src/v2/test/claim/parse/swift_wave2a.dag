module v2.test.parse.swift_wave2a

import v2.std.compilers.lexing { TokenStream }
import v2.std.grammar { ParseTree }
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }
import v2.extdeps.languages.swift { swift_wave1_lex, swift_wave1_grammar }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}
data swift_wave2a_non_source: String = "func choose(x: Int) -> Int { let y = x + 1\nif y > 0 { return y }\nreturn 0 }"

fn swift_wave2a_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^swift_wave2a_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^swift_wave2a_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

fn swift_wave2a_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn swift_wave2a_tokenize_and_parse() -> Outcome<ParseTree> {
  match tokenize(
    text: swift_wave2a_non_source,
    file: ^swift_wave2a_file,
    rules: swift_wave1_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: swift_wave1_grammar())
  }
}

data claim_swift_wave2a_non_function_parses: TestClaim = EqualsClaim {
  label: "Swift Wave 2a lex/grammar accepts a non-MVP function with let, if, return, and binary expressions",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: swift_wave2a_bool_atom(
    b: swift_wave2a_parse_accepted(out: swift_wave2a_tokenize_and_parse())
  ),
  rhs: swift_wave2a_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
