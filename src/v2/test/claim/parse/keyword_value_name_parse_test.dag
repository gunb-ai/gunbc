module v2.test.parse.keyword_value_name_parse

import v2.test.parse.expression_bodied_fn_decl_parse { g_fatal_at, g_tokenize_parse }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.parse_refusal_reason { KeywordAsValueName }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A KEYWORD IS NOT A VALUE NAME, AND SAYING SO IS A LOCATED REFUSAL AT THE BINDER. Every position that
// introduces a value name reads exactly what a value reference reads (v2.extdeps.languages.dag
// dag_grammar_primary_name_expr: an identifier, the two type-declaration modifiers, and the contextual set
// dag_contextual_value_name_keywords = module, data), behind a guard that refuses any other keyword as
// KeywordAsValueName (dag_grammar_value_name_before / _unconditional / dag_grammar_field_pattern_binder_guard).
// Before the guard the binder parsed and the program refused at the keyword's first USE as the generic
// parse_g0_tokens_remain (gunbc.recurring_failure_mode seed_admits_a_keyword_as_a_pattern_binder); that
// leftover reason as the fatal, or an accept, reds the subjects.
//
// THE CONTROLS ARE THE PROBED POSITIONS THE GUARD MUST NOT FIRE IN: keyword LABELS (a field decl, a record
// init, a projection, a field-pattern label), the contextual value names declared and used, `true` / `false`
// as literal patterns, a match arm led by `true`, and a statement value named `node` followed by an `if`.
// Each would refuse if a guard were unconditional or its follow set too wide.

data kvn_param_source: String = "module m.t\nfn f(then: Int) -> Int {\n  0\n}\n"

// a parameter named by a keyword refuses at the keyword: `then` is bytes 16..20 of kvn_param_source.
test fn kvn_param_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: g_tokenize_parse(text: kvn_param_source, file: ^probe_kvn_param),
    reason: KeywordAsValueName,
    file: ^probe_kvn_param,
    start: 16,
    end: 20
  )
}

data kvn_let_source: String = "module m.t\nfn f() -> Int {\n  let alias = 1\n  0\n}\n"

// a let binder named by a keyword refuses at the keyword: `alias` is bytes 33..38 of kvn_let_source.
test fn kvn_let_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: g_tokenize_parse(text: kvn_let_source, file: ^probe_kvn_let),
    reason: KeywordAsValueName,
    file: ^probe_kvn_let,
    start: 33,
    end: 38
  )
}

data kvn_node_sugar_source: String = "module m.t\nfn f() -> Int {\n  node then = 1\n  0\n}\n"

// a `node NAME =` binder named by a keyword refuses at the keyword: `then` is bytes 34..38 of kvn_node_sugar_source.
test fn kvn_node_sugar_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: g_tokenize_parse(text: kvn_node_sugar_source, file: ^probe_kvn_node_sugar),
    reason: KeywordAsValueName,
    file: ^probe_kvn_node_sugar,
    start: 34,
    end: 38
  )
}

data kvn_bare_eq_source: String = "module m.t\nfn f() -> Int {\n  loop = 1\n  0\n}\n"

// A bare `NAME =` binder named by a keyword still REFUSES, but unnamed: statements dispatch by FIRST set and the
// guard is transparent to it, so the let_sugar alternative is never reached for a keyword (the declared limit on
// gunbc.recurring_failure_mode seed_admits_a_keyword_as_a_pattern_binder). The claim holds the floor that matters --
// the keyword is never ACCEPTED as a binder -- and reds if it ever parses.
test fn kvn_bare_eq_keyword_binder_still_refuses_holds() -> Bool {
  match g_tokenize_parse(text: kvn_bare_eq_source, file: ^probe_kvn_bare_eq) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data kvn_pattern_value_source: String = "module m.t\ntype R = R { a: Int }\nfn f(r: R) -> Int {\n  match r {\n    R { a: as } => 0\n  }\n}\n"

// a field-pattern binder named by a keyword refuses at the keyword: `as` is bytes 76..78 of kvn_pattern_value_source.
test fn kvn_pattern_value_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: g_tokenize_parse(text: kvn_pattern_value_source, file: ^probe_kvn_pattern_value),
    reason: KeywordAsValueName,
    file: ^probe_kvn_pattern_value,
    start: 76,
    end: 78
  )
}

data kvn_pattern_pun_source: String = "module m.t\ntype R = R { then: Int }\nfn f(r: R) -> Int {\n  match r {\n    R { then } => 0\n  }\n}\n"

// a punned field-pattern binder named by a keyword refuses at the keyword: `then` is bytes 76..80 of kvn_pattern_pun_source.
test fn kvn_pattern_pun_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: g_tokenize_parse(text: kvn_pattern_pun_source, file: ^probe_kvn_pattern_pun),
    reason: KeywordAsValueName,
    file: ^probe_kvn_pattern_pun,
    start: 76,
    end: 80
  )
}

data kvn_label_keywords_source: String = "module m.t\ntype R = R { module: Int, then: Int }\nfn f(r: R, m: Int) -> Int {\n  let s = R { module: m, then: r.then }\n  match s {\n    R { module: x, then: y } => x\n  }\n}\n"

// Control: keyword LABELS still parse: a field decl, a record init, a projection, a field-pattern label.
test fn kvn_label_keywords_control_holds() -> Bool {
  match g_tokenize_parse(text: kvn_label_keywords_source, file: ^probe_kvn_label_keywords) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_contextual_module_data_source: String = "module m.t\ntype R = R { module: Int }\nfn f(module: Int, data: Int) -> Int {\n  let r = R { module: module }\n  match r {\n    R { module: module } => module\n  }\n}\n"

// Control: the contextual value names module and data are declarable and referenceable.
test fn kvn_contextual_module_data_control_holds() -> Bool {
  match g_tokenize_parse(text: kvn_contextual_module_data_source, file: ^probe_kvn_contextual_module_data) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_bool_literal_pattern_source: String = "module m.t\ntype R = R { ok: Bool }\nfn f(r: R) -> Int {\n  match r {\n    R { ok: true } => 1\n    R { ok: false } => 0\n  }\n}\n"

// Control: true and false stay literal patterns in a field pattern.
test fn kvn_bool_literal_pattern_control_holds() -> Bool {
  match g_tokenize_parse(text: kvn_bool_literal_pattern_source, file: ^probe_kvn_bool_literal_pattern) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_match_arm_true_source: String = "module m.t\nfn f(b: Bool) -> Int {\n  match b {\n    true => 1\n    false => 0\n  }\n}\n"

// Control: a match arm led by true is not a lambda binder.
test fn kvn_match_arm_true_control_holds() -> Bool {
  match g_tokenize_parse(text: kvn_match_arm_true_source, file: ^probe_kvn_match_arm_true) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_node_then_if_statement_source: String = "module m.t\nfn f(node: Int, c: Bool) -> Int {\n  node\n  if c {\n    1\n  } else {\n    0\n  }\n}\n"

// Control: a value named node followed by an if statement is not a node-NAME binder.
test fn kvn_node_then_if_statement_control_holds() -> Bool {
  match g_tokenize_parse(text: kvn_node_then_if_statement_source, file: ^probe_kvn_node_then_if_statement) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
