fn kvn_let_stream() -> TokenStream {
  token_stream_lexed(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^probe_kvn_let, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "m", file: ^probe_kvn_let, start: 7, end: 8 },
    Token { class: ^dag_token_dot, lexeme: ".", file: ^probe_kvn_let, start: 8, end: 9 },
    Token { class: ^dag_token_ident, lexeme: "t", file: ^probe_kvn_let, start: 9, end: 10 },
    Token { class: ^dag_token_kw_fn, lexeme: "fn", file: ^probe_kvn_let, start: 11, end: 13 },
    Token { class: ^dag_token_ident, lexeme: "f", file: ^probe_kvn_let, start: 14, end: 15 },
    Token { class: ^dag_token_lparen, lexeme: "(", file: ^probe_kvn_let, start: 15, end: 16 },
    Token { class: ^dag_token_rparen, lexeme: ")", file: ^probe_kvn_let, start: 16, end: 17 },
    Token { class: ^dag_token_arrow, lexeme: "->", file: ^probe_kvn_let, start: 18, end: 20 },
    Token { class: ^dag_token_ident, lexeme: "Int", file: ^probe_kvn_let, start: 21, end: 24 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^probe_kvn_let, start: 25, end: 26 },
    Token { class: ^dag_token_kw_let, lexeme: "let", file: ^probe_kvn_let, start: 29, end: 32 },
    Token { class: ^dag_token_kw_alias, lexeme: "alias", file: ^probe_kvn_let, start: 33, end: 38 },
    Token { class: ^dag_token_eq, lexeme: "=", file: ^probe_kvn_let, start: 39, end: 40 },
    Token { class: ^dag_token_int_literal, lexeme: "1", file: ^probe_kvn_let, start: 41, end: 42 },
    Token { class: ^dag_token_int_literal, lexeme: "0", file: ^probe_kvn_let, start: 45, end: 46 },
    Token { class: ^dag_token_rbrace, lexeme: "}", file: ^probe_kvn_let, start: 47, end: 48 }
  ], layout: stream_layout_with_break(layout: stream_layout_with_break(layout: stream_layout_with_break(layout: stream_layout_with_break(layout: stream_layout_empty(), token_start: 11, gap_start: 10), token_start: 29, gap_start: 26), token_start: 45, gap_start: 42), token_start: 47, gap_start: 46))
}

