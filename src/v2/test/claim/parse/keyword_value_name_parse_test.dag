module v2.test.parse.keyword_value_name_parse

import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex }
import v2.std.compilers.lexing { StreamLayout, Token, TokenStream, stream_layout_empty, stream_layout_with_break, token_stream_lexed }
import v2.test.parse.expression_bodied_fn_decl_parse { g_fatal_at, g_tokenize_parse }
import v2.test.parse.supplied_token_stream_support { supplied_stream_parse }
import v2.std.algebra { Cons, Empty }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.node { Symbol }
import v2.std.optional { Absent, Optional, Present }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.parse_refusal_reason { KeywordAsValueName }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A KEYWORD IS NOT A VALUE NAME, AND SAYING SO IS A LOCATED REFUSAL AT THE BINDER. Every position that
// introduces a value name reads exactly what a value reference reads (v2.extdeps.languages.dag
// dag_grammar_primary_name_expr: an identifier, the two type-declaration modifiers, and the contextual set
// dag_contextual_value_name_keywords = module, data), behind a guard that refuses any other keyword as
// KeywordAsValueName (dag_grammar_value_name_before / _unconditional / dag_grammar_field_pattern_binder_guard).
// Before the guard the binder parsed and the program refused at the keyword's first USE as the generic
// parse_g0_tokens_remain (gunbc.recurring_failure_mode seed_admits_a_keyword_as_a_pattern_binder); that
// leftover reason as the fatal, or an accept, reds the subjects.
//
// THE CONTROLS ARE THE PROBED POSITIONS THE GUARD MUST NOT FIRE IN: keyword LABELS (a field decl, a record
// init, a projection, a field-pattern label), the contextual value names declared and used, `true` / `false`
// as literal patterns, and a match arm led by `true`. A statement value named `node` followed by an `if` is the same
// probed position, and it is already enrolled as v2.test.parse.bare_node_statement_route
// bare_node_statement_before_an_if_takes_the_expression_route (the same fixture), so it is not repeated here.
// Each would refuse if a guard were unconditional or its follow set too wide.

data kvn_param_source: String = "module m.t\nfn f(then: Int) -> Int {\n  0\n}\n"

// a parameter named by a keyword refuses at the keyword: `then` is bytes 16..20 of kvn_param_source.
test fn kvn_param_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: g_tokenize_parse(text: kvn_param_source, file: ^probe_kvn_param),
    reason: KeywordAsValueName,
    file: ^probe_kvn_param,
    start: 16,
    end: 20
  )
}

data kvn_let_source: String = "module m.t\nfn f() -> Int {\n  let alias = 1\n  0\n}\n"

// a let binder named by a keyword refuses at the keyword: `alias` is bytes 33..38 of kvn_let_source.
test fn kvn_let_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: supplied_stream_parse(tokens: kvn_let_stream()),
    reason: KeywordAsValueName,
    file: ^probe_kvn_let,
    start: 33,
    end: 38
  )
}

data kvn_node_sugar_source: String = "module m.t\nfn f() -> Int {\n  node then = 1\n  0\n}\n"

// a `node NAME =` binder named by a keyword refuses at the keyword: `then` is bytes 34..38 of kvn_node_sugar_source.
test fn kvn_node_sugar_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: supplied_stream_parse(tokens: kvn_node_sugar_stream()),
    reason: KeywordAsValueName,
    file: ^probe_kvn_node_sugar,
    start: 34,
    end: 38
  )
}

data kvn_bare_eq_source: String = "module m.t\nfn f() -> Int {\n  loop = 1\n  0\n}\n"

// A bare `NAME =` binder named by a keyword still REFUSES, but unnamed: statements dispatch by FIRST set and the
// guard is transparent to it, so the let_sugar alternative is never reached for a keyword (the declared limit on
// gunbc.recurring_failure_mode seed_admits_a_keyword_as_a_pattern_binder). The claim holds the floor that matters --
// the keyword is never ACCEPTED as a binder -- and reds if it ever parses.
test fn kvn_bare_eq_keyword_binder_still_refuses_holds() -> Bool {
  match supplied_stream_parse(tokens: kvn_bare_eq_stream()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data kvn_pattern_value_source: String = "module m.t\ndata d: Int = match r {\n  R { a: as } => 0\n}\n"

// a field-pattern binder named by a keyword refuses at the keyword: `as` is bytes 44..46 of kvn_pattern_value_source.
test fn kvn_pattern_value_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: supplied_stream_parse(tokens: kvn_pattern_value_stream()),
    reason: KeywordAsValueName,
    file: ^probe_kvn_pattern_value,
    start: 44,
    end: 46
  )
}

data kvn_pattern_pun_source: String = "module m.t\ndata d: Int = match r {\n  R { then } => 0\n}\n"

// a punned field-pattern binder named by a keyword refuses at the keyword: `then` is bytes 41..45 of kvn_pattern_pun_source.
test fn kvn_pattern_pun_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: supplied_stream_parse(tokens: kvn_pattern_pun_stream()),
    reason: KeywordAsValueName,
    file: ^probe_kvn_pattern_pun,
    start: 41,
    end: 45
  )
}

data kvn_pattern_pun_true_source: String = "module m.t\ndata d: Int = match r {\n  R { true } => 0\n}\n"

// A PUNNED field pattern named `true` is a value BINDER, not a literal pattern (the field pattern is
// `name [":" pattern]`), and a binder named `true` is unreferenceable, so it refuses at the keyword:
// bytes 41..45. Only the position after `:` reads `true` / `false` as literals.
test fn kvn_pattern_pun_true_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: supplied_stream_parse(tokens: kvn_pattern_pun_true_stream()),
    reason: KeywordAsValueName,
    file: ^probe_kvn_pattern_pun_true,
    start: 41,
    end: 45
  )
}

data kvn_pattern_pun_false_source: String = "module m.t\ndata d: Int = match r {\n  R { false } => 0\n}\n"

// The same for `false`: bytes 41..46.
test fn kvn_pattern_pun_false_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: supplied_stream_parse(tokens: kvn_pattern_pun_false_stream()),
    reason: KeywordAsValueName,
    file: ^probe_kvn_pattern_pun_false,
    start: 41,
    end: 46
  )
}

data kvn_bool_label_source: String = "module m.t\ndata d: Int = match r {\n  R { true: x } => 0\n}\n"

// Control: `true` as an explicit field-pattern LABEL is a label, not a binder, so it still parses.
test fn kvn_bool_label_control_holds() -> Bool {
  match supplied_stream_parse(tokens: kvn_bool_label_stream()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_label_keywords_source: String = "module m.t\ndata d: R = R { module: r.then }\n"

// Control: keyword LABELS still parse: a record-init label and a projection (a field-pattern label is in
// the contextual control, a field-declaration label in kvn_field_decl_label).
test fn kvn_label_keywords_control_holds() -> Bool {
  match supplied_stream_parse(tokens: kvn_label_keywords_stream()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_contextual_module_data_source: String = "module m.t\nfn f(module: Int, data: Int) -> Int {\n  module\n}\n"

// Control: the contextual value names module and data are declarable as parameters and referenceable (the
// pattern-binder half is kvn_contextual_pattern_binder).
test fn kvn_contextual_module_data_control_holds() -> Bool {
  match supplied_stream_parse(tokens: kvn_contextual_module_data_stream()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_bool_literal_pattern_source: String = "module m.t\ndata d: Int = match r {\n  R { ok: true } => 0\n}\n"

// Control: true and false stay literal patterns in a field pattern.
test fn kvn_bool_literal_pattern_control_holds() -> Bool {
  match supplied_stream_parse(tokens: kvn_bool_literal_pattern_stream()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_match_arm_true_source: String = "module m.t\ndata d: Int = match b {\n  true => 1\n}\n"

// Control: a match arm led by true is not a lambda binder.
test fn kvn_match_arm_true_control_holds() -> Bool {
  match supplied_stream_parse(tokens: kvn_match_arm_true_stream()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_field_decl_label_source: String = "module m.t\ntype R = R { then: Int }\n"

// Control: a field DECLARATION label is a label, not a value name, so it still admits a keyword.
test fn kvn_field_decl_label_control_holds() -> Bool {
  match supplied_stream_parse(tokens: kvn_field_decl_label_stream()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

data kvn_contextual_pattern_binder_source: String = "module m.t\ndata d: Int = match r {\n  R { module: module } => 0\n}\n"

// Control: a contextual value name binds in a field pattern (its reference half is kvn_contextual_module_data).
test fn kvn_contextual_pattern_binder_control_holds() -> Bool {
  match supplied_stream_parse(tokens: kvn_contextual_pattern_binder_stream()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// THE INPUT IS SUPPLIED AT THE PARSE INTERFACE, AND THE TEXT ROUTE STILL RUNS ONCE. Every claim above
// except kvn_param_refuses_at_the_keyword parses a SUPPLIED token stream (v2.test.parse.supplied_token_stream_support
// supplied_stream_parse), because its subject is the grammar's binder guard, not the tokenizer: deriving the
// stream re-ran tokenize in every claim, and the floor's enrolment margin refused seven of them on that cost.
// kvn_param_refuses_at_the_keyword stays on the real text route (tokenize, prepared parse) as the
// inhabitance claim, and it asserts the ROUTE as well as the answer: the fatal must be KeywordAsValueName
// at the keyword's bytes, which the leftover parse_g0_tokens_remain route cannot produce.
//
// EACH SUPPLIED STREAM IS PROVEN TO BE THE TOKENIZER'S OUTPUT, POSITIONS AND LAYOUT INCLUDED. The located
// claims assert byte ranges and the statement claims depend on line breaks, so the shared class-and-lexeme
// projection is not enough here: kvn_stream_matches_tokenize compares every token's class, lexeme, start and
// end, and the recorded layout's digest, against the real tokenizer over the same source text.
fn kvn_tokens_agree(left: List<Token>, right: List<Token>) -> Bool {
  match left {
    Empty =>
      match right {
        Empty => true
        Cons { head: _, tail: _ } => false
      }
    Cons { head: a, tail: rest_a } =>
      match right {
        Empty => false
        Cons { head: b, tail: rest_b } =>
          (a.class == b.class) && (a.lexeme == b.lexeme) && (a.start == b.start) && (a.end == b.end)
            && kvn_tokens_agree(left: rest_a, right: rest_b)
      }
  }
}

fn kvn_layouts_agree(left: Optional<StreamLayout>, right: Optional<StreamLayout>) -> Bool {
  match left {
    Absent => false
    Present { value: l } =>
      match right {
        Absent => false
        Present { value: r } => l.digest == r.digest
      }
  }
}

fn kvn_stream_matches_tokenize(text: String, file: Symbol, supplied: TokenStream) -> Bool {
  match tokenize(text: text, file: file, rules: dag_lex()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: real, diagnostics: _ } =>
      kvn_tokens_agree(left: real.all, right: supplied.all) && kvn_layouts_agree(left: real.layout, right: supplied.layout)
  }
}

test fn kvn_let_stream_is_the_tokenizer_output_holds() -> Bool {
  kvn_stream_matches_tokenize(text: kvn_let_source, file: ^probe_kvn_let, supplied: kvn_let_stream())
}

test fn kvn_node_sugar_stream_is_the_tokenizer_output_holds() -> Bool {
  kvn_stream_matches_tokenize(text: kvn_node_sugar_source, file: ^probe_kvn_node_sugar, supplied: kvn_node_sugar_stream())
}

