fn kvn_pattern_value_stream() -> TokenStream {
  token_stream_lexed(all: [
    Token { class: ^dag_token_kw_module, lexeme: "module", file: ^probe_kvn_pattern_value, start: 0, end: 6 },
    Token { class: ^dag_token_ident, lexeme: "m", file: ^probe_kvn_pattern_value, start: 7, end: 8 },
    Token { class: ^dag_token_dot, lexeme: ".", file: ^probe_kvn_pattern_value, start: 8, end: 9 },
    Token { class: ^dag_token_ident, lexeme: "t", file: ^probe_kvn_pattern_value, start: 9, end: 10 },
    Token { class: ^dag_token_kw_data, lexeme: "data", file: ^probe_kvn_pattern_value, start: 11, end: 15 },
    Token { class: ^dag_token_ident, lexeme: "d", file: ^probe_kvn_pattern_value, start: 16, end: 17 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^probe_kvn_pattern_value, start: 17, end: 18 },
    Token { class: ^dag_token_ident, lexeme: "Int", file: ^probe_kvn_pattern_value, start: 19, end: 22 },
    Token { class: ^dag_token_eq, lexeme: "=", file: ^probe_kvn_pattern_value, start: 23, end: 24 },
    Token { class: ^dag_token_kw_match, lexeme: "match", file: ^probe_kvn_pattern_value, start: 25, end: 30 },
    Token { class: ^dag_token_ident, lexeme: "r", file: ^probe_kvn_pattern_value, start: 31, end: 32 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^probe_kvn_pattern_value, start: 33, end: 34 },
    Token { class: ^dag_token_ident, lexeme: "R", file: ^probe_kvn_pattern_value, start: 37, end: 38 },
    Token { class: ^dag_token_lbrace, lexeme: "{", file: ^probe_kvn_pattern_value, start: 39, end: 40 },
    Token { class: ^dag_token_ident, lexeme: "a", file: ^probe_kvn_pattern_value, start: 41, end: 42 },
    Token { class: ^dag_token_colon, lexeme: ":", file: ^probe_kvn_pattern_value, start: 42, end: 43 },
    Token { class: ^dag_token_kw_as, lexeme: "as", file: ^probe_kvn_pattern_value, start: 44, end: 46 },
