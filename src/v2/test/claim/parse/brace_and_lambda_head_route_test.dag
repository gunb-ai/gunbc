module v2.test.parse.brace_and_lambda_head_route

import v2.compiler.parse { PreparedModeled, PreparedVoidGrammar, parse_production_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex, parse_production_emitted_identity_optional }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, Symbol }
import std.optional { Absent, Optional, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ROUTE EACH BRACE- OR PAREN-HEADED INPUT TAKES, NOT ONLY ITS VERDICT (v2.extdeps.languages.dag
// dag_grammar_block_literal_head_expr, dag_grammar_empty_block_body_expr,
// dag_grammar_arrow_lambda_name_head_expr). `= {}` is the empty brace literal (operator ruling
// 2026-10-03, A): no block. `A => {}` is an empty arm block: the empty_block_body production.
// `(a, b) => a` is an arrow lambda; `(a)` is a grouped expression and no lambda. Each claim pays ONE
// parse of the smallest fragment that reaches its route, entering the grammar at the production
// under test: `expr` for a value (the brace literal, the lambda, the group) and `match_arm` for an
// arm body. Only the prepared grammar is shared, by declared demand.
data bhr_empty_literal_source: String = "{}"
data bhr_empty_arm_source: String = "t => {}"
data bhr_lambda_source: String = "(a, b) => a"
data bhr_group_source: String = "(a)"

fn bhr_parse(text: String, file: Symbol, production: Symbol) -> Optional<Node> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: prepared, diagnostics: _ } =>
      match prepared {
        PreparedVoidGrammar => Absent
        PreparedModeled { modeled: modeled } =>
          match tokenize(text: text, file: file, rules: dag_lex()) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: token_stream, diagnostics: _ } =>
              match parse_production_prepared(
                tokens: token_stream.all,
                validated: modeled.validated,
                analysis: modeled.analysis,
                production_name: production
              ) {
                Rejected { diagnostics: _ } => Absent
                Accepted { value: artifact, diagnostics: _ } => Present { value: artifact.tree }
              }
          }
      }
  }
}

fn bhr_count(root: Node, emitted: Symbol) -> Int {
  let here = match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } => if id == emitted { 1 } else { 0 }
    Absent => 0
  }
  fold(root.children, init: here, f: fn(acc, e) { acc + bhr_count(root: e.target, emitted: emitted) })
}

// Accepted, with `emitted` appearing `times` times in the tree.
fn bhr_route(text: String, file: Symbol, production: Symbol, emitted: Symbol, times: Int) -> Bool {
  match bhr_parse(text: text, file: file, production: production) {
    Present { value: tree } => bhr_count(root: tree, emitted: emitted) == times
    Absent => false
  }
}

fn bhr_brace_literal(text: String) -> Bool {
  match bhr_parse(text: text, file: ^bhr_lit, production: ^dag_production_expr) {
    Present { value: tree } =>
      bhr_count(root: tree, emitted: ^dag_surface_block_expr) == 0
        && bhr_count(root: tree, emitted: ^dag_surface_empty_block_body) == 0
    Absent => false
  }
}

test fn empty_braces_as_a_value_take_the_brace_literal_route() -> Bool {
  bhr_brace_literal(text: bhr_empty_literal_source)
}

test fn empty_braces_as_an_arm_body_take_the_empty_block_route() -> Bool {
  bhr_route(text: bhr_empty_arm_source, file: ^bhr_arm, production: ^dag_production_match_arm, emitted: ^dag_surface_empty_block_body, times: 1)
}

test fn parenthesised_parameter_list_takes_the_lambda_route() -> Bool {
  bhr_route(text: bhr_lambda_source, file: ^bhr_lam, production: ^dag_production_expr, emitted: ^dag_surface_arrow_lambda, times: 1)
}

test fn grouped_expression_takes_no_lambda_route() -> Bool {
  bhr_route(text: bhr_group_source, file: ^bhr_grp, production: ^dag_production_expr, emitted: ^dag_surface_arrow_lambda, times: 0)
}
