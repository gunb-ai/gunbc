module test.claim.parse_test_rust_grammar

data rust_extended_fn_source: String = "fn choose(x: i32, y: i32) -> i32 { let z = x + 1;\nif z > 0 { return z }\nreturn 0 }"

data rust_return_semi_source: String = "fn r() -> i32 { return; }"

fn rust_parse_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^rust_parse_bool_true } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^rust_parse_bool_false } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
  }
}

fn rust_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn rust_tokenize_and_parse_source(text: String) -> Outcome<ParseTree> {
  match tokenize(
    text: text,
    file: ^rust_parse_file,
    rules: rust_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: rust_grammar())
  }
}

fn rust_tokenize_and_parse() -> Outcome<ParseTree> {
  rust_tokenize_and_parse_source(text: rust_extended_fn_source)
}

// Rust lex/grammar accepts an extended function with let, if, return, and binary expressions.
// Formerly the data row `claim_rust_extended_function_parses: TestClaim = EqualsClaim`, which no runner executes (the
// required floor runs `test fn` claims only): the same lhs == rhs predicate, made runnable by the
// v2.test.parse census (gunbc#13372).
test fn claim_rust_extended_function_parses_holds() -> Bool {
  (rust_parse_accepted(out: rust_tokenize_and_parse())) == true
}

// Rust grammar accepts return; with layout-free return lexeme and trivia between tokens.
// Formerly the data row `claim_rust_return_semi_parses: TestClaim = EqualsClaim`, which no runner executes (the
// required floor runs `test fn` claims only): the same lhs == rhs predicate, made runnable by the
// v2.test.parse census (gunbc#13372).
test fn claim_rust_return_semi_parses_holds() -> Bool {
  (rust_parse_accepted(
      out: rust_tokenize_and_parse_source(text: rust_return_semi_source)
    )) == true
}

