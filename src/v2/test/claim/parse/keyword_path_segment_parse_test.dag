module v2.test.parse.keyword_path_segment_parse

import v2.test.parse.expression_bodied_fn_decl_parse { g_fatal_at, g_tokenize_parse }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.parse_refusal_reason { KeywordAsPathSegment }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A KEYWORD IS NOT A PATH SEGMENT, AND SAYING SO IS A LOCATED REFUSAL. The segment rule
// (v2.extdeps.languages.dag dag_grammar_ident_or_type_decl_modifier_name) admits an identifier or a
// type-declaration modifier, so `match` after `rt.` is not a segment. The declaring positions refuse
// it by name at the keyword (dag_grammar_declared_path_expr) instead of ending the path at `rt` and
// leaving `.match` to the generic leftover-token refusal; that leftover reason, or the choice-overlap
// residue it used to come with, as the fatal reason reds these claims. The control is the same
// position with an identifier that merely starts with the keyword's spelling, which is a segment.

data keyword_module_path_source: String = "module rt.match\n"

// `match` is bytes 10..15 of keyword_module_path_source.
test fn a_keyword_module_path_segment_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: g_tokenize_parse(text: keyword_module_path_source, file: ^probe_keyword_module_path),
    reason: KeywordAsPathSegment,
    file: ^probe_keyword_module_path,
    start: 10,
    end: 15
  )
}

data keyword_import_path_source: String = "module rt.ok\nimport std.if\n"

// `if` is bytes 24..26 of keyword_import_path_source.
test fn a_keyword_import_path_segment_refuses_at_the_keyword_holds() -> Bool {
  g_fatal_at(
    parsed: g_tokenize_parse(text: keyword_import_path_source, file: ^probe_keyword_import_path),
    reason: KeywordAsPathSegment,
    file: ^probe_keyword_import_path,
    start: 24,
    end: 26
  )
}

data identifier_module_path_source: String = "module rt.matcher\n"

test fn an_identifier_spelled_after_a_keyword_is_a_path_segment_holds() -> Bool {
  match g_tokenize_parse(text: identifier_module_path_source, file: ^probe_identifier_module_path) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
