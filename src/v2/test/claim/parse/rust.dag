module v2.test.parse.rust

import v2.std.verification { EqualsClaim, Integration, ManualAnchorAbsent, TestClaim, TestClassification, Tier1, manual_claim_anchor }
import test.claim.parse_test_rust_grammar { rust_parse_accepted, rust_parse_bool_atom, rust_tokenize_and_parse_source }

data rust_layout_tight_source: String = "fn choose(x: i32, y: i32) -> i32 { let\nz=x+1;\nif z>0 { return z; }\nreturn 0; }"

// THE RUST GRAMMAR CLAIMS THAT ARE RED ON MAIN, held here ungated while they are diagnosed
// (v2.test.parse census, gunbc#13372, phase 4 item D). Their green siblings are gated in test.claim.parse_test_rust_grammar.
// These rows are data TestClaims, which no runner executes; the diagnosis PR, gunbc#13426, converts or frontiers them.

data claim_rust_layout_tight_parses: TestClaim = EqualsClaim {
  label: "Rust grammar accepts tight/newline-separated layout with trivia-separated tokens",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: rust_parse_bool_atom(
    b: rust_parse_accepted(
      out: rust_tokenize_and_parse_source(text: rust_layout_tight_source)
    )
  ),
  rhs: rust_parse_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
