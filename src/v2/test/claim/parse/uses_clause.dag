module v2.test.claim.parse.uses_clause

import v2.compiler.reference_conservation_admission { conservation_subject_of_text }

import v2.std.grammar { parse_production_emitted_identity_optional }
import v2.std.diagnostic { Accepted, NodeLocus, Rejected, diagnostics_fatal }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Present }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A FN MAY DECLARE v1's `uses` CLAUSE (v2.extdeps.languages.dag dag_grammar_uses_clause_expr). It
// PARSES; it does not lower: v2 has no carrier for a fn's resource requirement, so normalize refuses
// the fn located at the clause (body_lowering_reason_uses_clause_unmodeled,
// gunbc.recurring_failure_mode uses_clause_has_no_carrier) rather than lowering it without the
// requirement.
data uses_source: String = "module probe.uses\n\nfn fetch(n: Int) -> Int\n  uses net: Network, fs: Filesystem\n  = n\n"

// Each outcome is computed ONCE as a nullary value, enrolled WARM in
// v2.workflow.floor_pure_producer_share, and each claim reads it (a claim that parsed its own source
// is over the new-witness eval-step budget).
fn uses_parsed() -> Bool {
  match conservation_subject_of_text(path: "probe_uses.dag", text: uses_source).parsed {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// The normalize refusal's reason, and whether it is anchored at the clause. A lowering refusal is a
// NodeLocus (v2.std.diagnostic node_locus), so "located at the clause" means its anchor IS the
// uses_clause production shell, not the fn around it.
type UsesRefusal {
  is_unmodeled: Bool
  at_clause: Bool
}

fn uses_refusal() -> UsesRefusal {
  match conservation_subject_of_text(path: "probe_uses.dag", text: uses_source).normalized {
    Accepted { value: _, diagnostics: _ } => UsesRefusal { is_unmodeled: false, at_clause: false }
    Rejected { diagnostics: d } =>
      UsesRefusal {
        is_unmodeled: diagnostics_fatal(d: d).reason == ^body_lowering_reason_uses_clause_unmodeled,
        at_clause: match diagnostics_fatal(d: d).at {
          NodeLocus { anchor: a } =>
            match parse_production_emitted_identity_optional(node: a.at.node) {
              Present { value: id } => id == ^dag_surface_uses_clause
              Absent => false
            }
          _ => false
        }
      }
  }
}

test fn a_fn_with_a_uses_clause_parses_holds() -> Bool { uses_parsed() }

test fn a_fn_with_a_uses_clause_refuses_at_the_clause_holds() -> Bool { uses_refusal().is_unmodeled }

test fn the_uses_refusal_is_located_at_the_clause_holds() -> Bool { uses_refusal().at_clause }

// After D13 deletes a restating uses row, the remaining fn is an ordinary body: it must lower. The
// same shape with the clause still present keeps the UsesClauseCarrier refusal (no signature carrier).
data restatement_without_uses_source: String = "module probe.derived_restatement\n\nresource Network {\n  kind: Capability\n  mode: Read\n}\n\nservice H {\n  operation Get {\n    requires Network\n  }\n}\n\nfn restates(p: Int) -> Int {\n  let r = H.Get()\n  p\n}\n"

data restatement_with_uses_source: String = "module probe.derived_restatement_uses\n\nresource Network {\n  kind: Capability\n  mode: Read\n}\n\nservice H {\n  operation Get {\n    requires Network\n  }\n}\n\nfn restates(p: Int) -> Int uses net: Network {\n  let r = H.Get()\n  p\n}\n"

fn restatement_without_uses_lowers() -> Bool {
  match conservation_subject_of_text(path: "probe_derived_restatement.dag", text: restatement_without_uses_source).normalized {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn restatement_with_uses_refuses_unmodeled() -> Bool {
  match conservation_subject_of_text(path: "probe_derived_restatement_uses.dag", text: restatement_with_uses_source).normalized {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => diagnostics_fatal(d: d).reason == ^body_lowering_reason_uses_clause_unmodeled
  }
}

test fn a_restating_body_without_a_uses_clause_lowers_holds() -> Bool { restatement_without_uses_lowers() }

test fn a_restating_body_with_a_uses_clause_still_refuses_RED() -> Bool { restatement_with_uses_refuses_unmodeled() }
