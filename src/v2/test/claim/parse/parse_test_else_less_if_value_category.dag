module v2.test.claim.parse.parse_test_else_less_if_value_category

import v2.compiler.body_lowering_fold {
  body_lower_admitted_guard_optional,
  body_lower_else_less_if_parts_optional,
  body_lower_if_expr
}
import v2.compiler.parse { PreparedModeled, PreparedVoidGrammar, parse_production_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar, dag_prepared_lex }
import v2.compiler.tokenize { tokenize_prepared }

import v2.std.grammar { parse_production_emitted_identity_optional }
import v2.std.diagnostic { Accepted, Rejected }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, Symbol }
import std.optional { Absent, Optional, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// AN ELSE-LESS `if` PARSES ONE WAY AND HAS NO VALUE (operator ruling 2026-10-03, for this case
// only; v2.extdeps.languages.dag dag_grammar_if_expr_expr). The ruling's controls, each at ONE
// interface and paying ONE parse (gunbc.design_argument::single_authority, the witness rule): both inputs parse to the one
// else-less if_expr route; at statement position the guard reader admits it; at value position the if
// reader `body_lower_if_expr` ADMITS it and lowers it to the else-less Branch -- the `if` reader does
// NOT refuse a well-formed else-less `if` it is handed. The value it owes is refused by the value-owing
// CONSUMER, not at the `if`: that consumer refusal is guarded on the target/serialize route by the
// closure-emission member row
// @ref(v2.test.claim.self_host.closure_emission::a_closure_member_whose_body_does_not_lower_is_its_own_typed_refusal_holds)
// (its `ce_refusing_fn` is the SAME SHAPE: a value-position else-less `if` with an expression arm,
// `if p { p }`), which refuses with `target_value_expr_reason_branch_else_less_as_value`. The
// readers are handed the parsed node rather than reached through a whole normalize. The real path is
// executed by v2.test.claim.parse.closure_parse_batch_two an_early_return_guard_parses_and_lowers_holds
// (a guard specimen normalized end to end), which is the pairing this file's supplied nodes owe.
// Each source is parsed as the production where its position lives, with nothing around it: the
// `if` alone as the expr production is where a value is owed, and a fn body alone as the fn_body
// production is where a statement stands.
data elif_guard_source: String = "{\n  if c { return a }\n  b\n}"
data elif_value_source: String = "if c { a }"

// A source parsed as one production of the dag grammar, so a claim pays for its own tokens and no
// module or signature around them.
fn elif_parse_as(text: String, production: Symbol) -> Optional<Node> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: prepared, diagnostics: _ } =>
      match prepared {
        PreparedVoidGrammar => Absent
        PreparedModeled { modeled: modeled } =>
          match tokenize_prepared(text: text, file: ^elif_probe, prepared: dag_prepared_lex()) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: token_stream, diagnostics: _ } =>
              match parse_production_prepared(
                tokens: token_stream.all,
                validated: modeled.validated,
                analysis: modeled.analysis,
                production_name: production
              ) {
                Rejected { diagnostics: _ } => Absent
                Accepted { value: artifact, diagnostics: _ } => elif_some(node: artifact.tree)
              }
          }
      }
  }
}

fn elif_emitted(node: Node) -> Symbol {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } => id
    Absent => ^elif_no_production
  }
}

fn elif_is_else_less_if(node: Node) -> Bool {
  if elif_emitted(node: node) == ^dag_surface_if_expr {
    match body_lower_else_less_if_parts_optional(if_shell: node) {
      Present { value: _ } => true
      Absent => false
    }
  } else {
    false
  }
}

fn elif_count_else_less_ifs(root: Node) -> Int {
  let here = if elif_is_else_less_if(node: root) { 1 } else { 0 }
  fold(root.children, init: here, f: fn(acc, e) { acc + elif_count_else_less_ifs(root: e.target) })
}

// The first node, in pre-order, that `pick` admits.
fn elif_first(root: Node, pick: fn(Node) -> Bool) -> Optional<Node> {
  if pick(root) {
    elif_some(node: root)
  } else {
    fold(root.children, init: elif_none(), f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent => elif_first(root: e.target, pick: pick)
      }
    })
  }
}

fn elif_none() -> Optional<Node> { Absent }

fn elif_some(node: Node) -> Optional<Node> { Present { value: node } }

fn elif_one_route(parsed: Optional<Node>) -> Bool {
  match parsed {
    Present { value: tree } => elif_count_else_less_ifs(root: tree) == 1
    Absent => false
  }
}

// The statement whose whole expression is the else-less `if` is an admitted guard.
fn elif_guard_admitted(parsed: Optional<Node>) -> Bool {
  match parsed {
    Absent => false
    Present { value: tree } =>
      match elif_first(root: tree, pick: fn(n) { elif_emitted(node: n) == ^dag_surface_stmt }) {
        Absent => false
        Present { value: stmt } =>
          match body_lower_admitted_guard_optional(stmt: stmt) {
            Present { value: _ } => true
            Absent => false
          }
      }
  }
}

// The value-position else-less `if` is ADMITTED by the if reader `body_lower_if_expr` (it lowers to the
// else-less Branch); it is NOT refused at the `if`. The value it owes is the CONSUMER's to refuse, guarded
// on the target/serialize route by the closure-emission member row (see the file header @ref). This row
// goes red if the if reader ever refuses this well-formed shape again -- a real discriminant, not a tautology.
fn elif_value_if_expr_admits(parsed: Optional<Node>) -> Bool {
  match parsed {
    Absent => false
    Present { value: tree } =>
      match elif_first(root: tree, pick: fn(n) { elif_is_else_less_if(node: n) }) {
        Absent => false
        Present { value: if_shell } =>
          match body_lower_if_expr(shell: if_shell) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

// Each claim pays its own parse of its own source (only the prepared grammar is shared, by declared
// demand).
test fn statement_guard_parses_to_one_else_less_if_route() -> Bool {
  elif_one_route(parsed: elif_parse_as(text: elif_guard_source, production: ^dag_production_fn_body))
}

test fn value_if_parses_to_one_else_less_if_route() -> Bool {
  elif_one_route(parsed: elif_parse_as(text: elif_value_source, production: ^dag_production_expr))
}

test fn statement_position_guard_is_admitted() -> Bool {
  elif_guard_admitted(parsed: elif_parse_as(text: elif_guard_source, production: ^dag_production_fn_body))
}

test fn value_position_else_less_if_is_admitted_by_the_if_reader() -> Bool {
  elif_value_if_expr_admits(parsed: elif_parse_as(text: elif_value_source, production: ^dag_production_expr))
}
