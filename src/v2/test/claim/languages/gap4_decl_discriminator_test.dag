// Gap-4 decl-41/42 discriminator — NOT floor-enrolled (manual claim-run only until RED lands).
// Excluded from discovery via FLOOR_DISCOVERY_EXCLUDES in cli_run.rs.

module v2.test.languages.gap4_decl_discriminator

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse_module }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn rejects_parse_g0_tokens_remain(src: String) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => d.head.reason == ^parse_g0_tokens_remain
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn parses(src: String) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Decl 42 — set_symbol_insert @L622 (whole fn)
test fn gap4_decl42_set_symbol_insert_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nimport v2.std.algebra { Set }\nimport v2.std.node { Symbol }\nfn set_symbol_insert(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {\n  Set {\n    member: fn(sym) { sym == item || s.member(sym) }\n  }\n}\n"
  )
}

// Decl 41 — parse_nonterminal_memoized @L548 (whole fn, syntax-only standalone)
test fn gap4_decl41_parse_nonterminal_memoized_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nimport v2.std.collection { List, Map }\nimport v2.std.grammar { GrammarRoot }\nimport v2.std.compilers.lexing { Token }\nimport v2.std.node { Symbol }\nimport v2.std.witness { Witness }\nimport v2.std.grammar { GrammarProduction }\n\ntype ParseProvenanceState { alloc: Int, index: Int }\ntype ParseTable { entries: Map<Int, Int> }\ntype ParsePositionKey { position: Int, production: Symbol }\ntype ParseExprResult = ParseExprAccepted { remaining: List<Token>, captured: Int, diagnostics: List<Int>, prov: ParseProvenanceState } | ParseExprRejected { diagnostics: List<Int> }\n\nfn parse_current_position(all_tokens: List<Token>, tokens: List<Token>) -> Int { 0 }\nfn grammar_lookup_production(root: GrammarRoot, name: Symbol) -> Witness<GrammarProduction> { Holds { value: GrammarProduction { name: name, expression: Terminal { token_class: name }, emitted: name } } }\nfn parse_table_lookup(table: ParseTable, key: ParsePositionKey) -> Witness<ParseExprResult> { Violates { diagnostic: Rejected { diagnostics: None } } }\nfn parse_expr(expr: Int, tokens: List<Token>, all_tokens: List<Token>, root: GrammarRoot, table: ParseTable, prov: ParseProvenanceState) -> ParseExprResult { ParseExprRejected { diagnostics: [] } }\nfn parse_table_insert(table: ParseTable, key: ParsePositionKey, value: ParseExprResult) -> ParseTable { table }\nfn parse_wrap_production_captured(production: GrammarProduction, captured: Int, prov: ParseProvenanceState) -> ParseProvenanceState { prov }\nfn parse_prov_merge(base: ParseProvenanceState, incoming: ParseProvenanceState) -> ParseProvenanceState { base }\n\nfn parse_nonterminal_memoized(\n  all_tokens: List<Token>,\n  tokens: List<Token>,\n  root: GrammarRoot,\n  table: ParseTable,\n  prod_name: Symbol,\n  prov: ParseProvenanceState\n) -> ParseExprResult {\n  let key = ParsePositionKey {\n    position: parse_current_position(all_tokens: all_tokens, tokens: tokens),\n    production: prod_name\n  }\n  match grammar_lookup_production(root: root, name: prod_name) {\n    Violates { diagnostic: d } =>\n      ParseExprRejected { diagnostics: [d] }\n    Holds { value: production } =>\n      match parse_table_lookup(table: table, key: key) {\n        Holds { value: inner } =>\n          match inner {\n            ParseExprRejected { diagnostics: diags } =>\n              ParseExprRejected { diagnostics: diags }\n            ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov } =>\n              let merged_prov = parse_prov_merge(base: prov, incoming: inner_prov)\n              let stamped = parse_wrap_production_captured(\n                production: production,\n                captured: captured,\n                prov: merged_prov\n              )\n              ParseExprAccepted {\n                remaining: remaining,\n                captured: stamped,\n                diagnostics: diags,\n                prov: stamped\n              }\n          }\n        Violates { diagnostic: _ } =>\n          let inner = parse_expr(\n            expr: 0,\n            tokens: tokens,\n            all_tokens: all_tokens,\n            root: root,\n            table: table,\n            prov: prov\n          )\n          let _memo = parse_table_insert(table: table, key: key, value: inner)\n          match inner {\n            ParseExprRejected { diagnostics: diags } =>\n              ParseExprRejected { diagnostics: diags }\n            ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov } =>\n              let stamped = parse_wrap_production_captured(\n                production: production,\n                captured: captured,\n                prov: inner_prov\n              )\n              ParseExprAccepted {\n                remaining: remaining,\n                captured: stamped,\n                diagnostics: diags,\n                prov: stamped\n              }\n          }\n      }\n  }\n}\n"
  )
}

// Suspect (a): let key = Record { ... } then match
test fn gap4_suspect_a_let_record_then_match_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn f() -> Int {\n  let key = ParsePositionKey {\n    position: 0,\n    production: ^x\n  }\n  match key {\n    ParsePositionKey { position: p, production: _ } => p\n  }\n}\n"
  )
}

// Suspect (b): chained lets then tail record expr
test fn gap4_suspect_b_chained_lets_tail_record_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn f() -> Int {\n  let merged = 0\n  let stamped = 1\n  ParseExprAccepted {\n    remaining: [],\n    captured: stamped,\n    diagnostics: [],\n    prov: merged\n  }\n}\n"
  )
}

// Suspect (c): || operator in lambda (set_symbol_insert body)
test fn gap4_suspect_c_or_in_lambda_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nimport v2.std.algebra { Set }\nimport v2.std.node { Symbol }\nfn f(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {\n  Set { member: fn(sym) { sym == item || s.member(sym) } }\n}\n"
  )
}

// Suspect (c) minimal: bare || in fn body
test fn gap4_suspect_c_bare_or_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn f(a: Bool, b: Bool) -> Bool { a || b }\n"
  )
}
