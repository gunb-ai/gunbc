// Gap-4 unit witness — parse_g0_tokens_remain minimal RED on 02_parse.dag deficit.
// Bisect: decl-41 (parse_nonterminal_memoized) RED; decl-42 (set_symbol_insert) GREEN.
// Minimized: let-as-statement inside a match arm (stmt in fn_body ok; match_arm body was expr-only).
// Execution: same-module harness in v2.compiler.parse until import/export restores post-fix.

module v2.test.languages.gap4_parse_tokens_remain

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse_module }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn rejects_parse_g0_tokens_remain(src: String) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => d.head.reason == ^parse_g0_tokens_remain
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn parses(src: String) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Minimal RED — let stmt in match arm (smallest still parse_g0_tokens_remain).
test fn gap4_minimal_red_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn f() -> Int {\n  match lookup() {\n    Holds { value: inner } => let stamped = inner\n    Violates { diagnostic: _ } => 1\n  }\n}\n"
  )
}

// GREEN control — match arm tail expr (no let) parses.
test fn gap4_minimal_green_match_arm_tail_parses_holds() -> Bool {
  parses(
    src: "module m.t\nfn f() -> Int {\n  match lookup() {\n    Holds { value: inner } => inner\n    Violates { diagnostic: _ } => 1\n  }\n}\n"
  )
}

// DISCRIMINATING CONTROL — clearly invalid char must Reject tokenize, not parse_g0_tokens_remain.
test fn gap4_unrecognized_char_rejects_not_tokens_remain_holds() -> Bool {
  match parses(src: "module m.t\nfn f() -> Int { `x }\n") {
    true => false
    false =>
      match rejects_parse_g0_tokens_remain(src: "module m.t\nfn f() -> Int { `x }\n") {
        true => false
        false => true
      }
  }
}
