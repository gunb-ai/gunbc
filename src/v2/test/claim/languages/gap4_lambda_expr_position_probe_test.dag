// Gap-4 locate — minimal lambda-in-expression-position discriminators (§5 unit witnesses).
// Smallest-still-RED snippet for parse_g0_tokens_remain on 02_parse.dag deficit.

module v2.test.languages.gap4_lambda_expr_position_probe

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse_module }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn rejects_parse_g0_tokens_remain(src: String) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => d.head.reason == ^parse_g0_tokens_remain
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// 1. bare lambda as data initializer
fn parse_outcome_label(src: String) -> String {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Rejected { diagnostics: d } => concat(left: "tokenize:", right: d.head.reason)
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => "parse:accepted"
        Rejected { diagnostics: d } => concat(left: "parse:", right: d.head.reason)
      }
  }
}

test fn gap4_bare_lambda_data_init_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(src: "module m.t\ndata x = fn(s) { s }\n")
}

// 2. lambda as record field value (generic record)
test fn gap4_lambda_record_field_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\ndata x = R { f: fn(s) { s } }\n"
  )
}

// 3. Set { member: fn(...) { ... } } — set_symbol_insert body shape
test fn gap4_set_member_lambda_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn f() -> Set<Symbol> {\n  Set { member: fn(sym) { sym } }\n}\n"
  )
}

test fn gap4_set_member_lambda_parses_holds() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: "module m.t\nfn f() -> Set<Symbol> {\n  Set { member: fn(sym) { sym } }\n}\n",
    file: ^probe,
    rules: lm.lex
  ) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// 4. full set_symbol_insert with outer capture
test fn gap4_set_symbol_insert_shape_tokens_remain_holds() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn set_symbol_insert(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {\n  Set { member: fn(sym) { sym == item || s.member(sym) } }\n}\n"
  )
}

// control — top-level fn decl (should parse)
test fn gap4_top_level_fn_decl_accepts_holds() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: "module m.t\nfn f(x: Int) -> Int { x }\n", file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
