module v2.test.languages.dag_caret_symbol_lex

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse_module }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

test fn caret_lex_accepts_symbol_literal_holds() -> Bool {
  match tokenize(text: "^foo", file: ^probe, rules: dag_language_model_wave1().lex) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn caret_parse_accepts_symbol_literal_holds() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: "module probe.t\nfn f() -> Int { ^foo }\n", file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn caret_lex_rejects_unknown_char_control_holds() -> Bool {
  match tokenize(text: "`bad", file: ^probe, rules: dag_language_model_wave1().lex) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ds } => ds.head.reason == ^tokenize_lex_e1_unrecognized_char
  }
}
