// Corrected-syntax gap-4 lambda probes (data decl requires `: Type`).
module v2.test.languages.gap4_lambda_syntax_corrected_probe

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse_module }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn rejects_parse_g0_tokens_remain(src: String) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => d.head.reason == ^parse_g0_tokens_remain
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn parses(src: String) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn parse_reason(src: String) -> String {
  let lm = dag_language_model_wave1()
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Rejected { diagnostics: d } => concat(left: "tokenize:", right: d.head.reason)
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => "accepted"
        Rejected { diagnostics: d } => d.head.reason
      }
  }
}

// 1. bare lambda — corrected data decl
test fn t_bare_lambda_typed() -> Bool {
  rejects_parse_g0_tokens_remain(src: "module m.t\ndata x: Int = fn(s) { s }\n")
}

test fn p_bare_lambda_typed() -> Bool {
  parses(src: "module m.t\ndata x: Int = fn(s) { s }\n")
}

// 2. lambda record field — corrected
test fn t_record_field_lambda() -> Bool {
  rejects_parse_g0_tokens_remain(src: "module m.t\ndata x: R = R { f: fn(s) { s } }\n")
}

test fn p_record_field_lambda() -> Bool {
  parses(src: "module m.t\ndata x: R = R { f: fn(s) { s } }\n")
}

// 3. let-bound lambda in fn body
test fn t_let_lambda() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn f() -> Int {\n  let x = fn(s) { s }\n  0\n}\n"
  )
}

test fn p_let_lambda() -> Bool {
  parses(src: "module m.t\nfn f() -> Int {\n  let x = fn(s) { s }\n  0\n}\n")
}

// 4. Set member lambda (Candidate B)
test fn t_set_member() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn f() -> Set<Symbol> {\n  Set { member: fn(sym) { sym } }\n}\n"
  )
}

test fn p_set_member() -> Bool {
  parses(src: "module m.t\nfn f() -> Set<Symbol> {\n  Set { member: fn(sym) { sym } }\n}\n")
}

// 5. full set_symbol_insert
test fn t_set_symbol_insert() -> Bool {
  rejects_parse_g0_tokens_remain(
    src: "module m.t\nfn set_symbol_insert(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {\n  Set { member: fn(sym) { sym == item || s.member(sym) } }\n}\n"
  )
}

test fn p_set_symbol_insert() -> Bool {
  parses(
    src: "module m.t\nfn set_symbol_insert(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {\n  Set { member: fn(sym) { sym == item || s.member(sym) } }\n}\n"
  )
}
