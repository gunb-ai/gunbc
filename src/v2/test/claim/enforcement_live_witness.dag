module v2.test.claim.enforcement_live_witness


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn enforcement_consistency_gate_holds() -> Bool {
  enforcement_consistency_live() && all_intents_admissible(intents: standing_intent_registry)
}

test fn complexity_repo_wide_verdict_matches_roadmap() -> Bool {
  let v = complexity_repo_wide_verdict_live()
  leg_holds(l: v.claimed)
    && leg_fails(l: v.scope_covered)
    && leg_holds(l: v.subjects_covered)
    && leg_holds(l: v.live_consumer)
    && leg_holds(l: v.red_control)
    && leg_holds(l: v.self_application)
}

data synthetic_binding_witness: ScheduleWitnessEntry = {
  entry: "src/v2/test/claim/synthetic_enforcement_probe_test.dag",
  function: "synthetic_probe_holds",
  kind: CorpusWitnessKind
}

// The synthetic witness is enrolled ONLY against a census that carries its declaration; the
// enrollment read now consults the same DeclFacts pool the rest of the receipt does.
data synthetic_binding_fact: DeclFact = {
  qualified_name: "test.claim.synthetic_enforcement_probe_test.synthetic_probe_holds",
  name: "synthetic_probe_holds",
  kind: FnItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/test/claim/synthetic_enforcement_probe_test.dag"
}

test fn roster_read_liveness_discriminates() -> Bool {
  let bound = BoundConsumerWitness { witness: synthetic_binding_witness }
  consumer_kind_eq(
    a: consumer_enrolled_for(binding: bound, ci_entries: [synthetic_binding_witness], prepush_entries: [], facts: [synthetic_binding_fact]),
    b: EnrolledInFloorRoster
  )
    && consumer_kind_eq(
      a: consumer_enrolled_for(binding: bound, ci_entries: [], prepush_entries: [], facts: [synthetic_binding_fact]),
      b: WitnessOnly
    )
    && consumer_kind_eq(
      a: consumer_enrolled_for(binding: NoConsumerWitness, ci_entries: [synthetic_binding_witness], prepush_entries: [], facts: [synthetic_binding_fact]),
      b: NoConsumer
    )
}

test fn empty_facts_feed_reds_subjects_leg() -> Bool {
  let receipt = derive_receipt(
    contract: lens_contract_cost,
    desired_scope: whole_corpus_scope,
    self_module_prefix: "lens.cost.",
    facts: [],
    ci_entries: [],
    prepush_entries: []
  )
  leg_fails(
    l: intent_family_verdict(
      intent: standing_intent_complexity_repo_wide,
      contracts: [lens_contract_cost],
      receipts: [receipt]
    ).subjects_covered
  )
}

fn red_status_is_failed_to_flip(s: RedControlStatus) -> Bool {
  match s {
    RedControlFailedToFlip => true
    _ => false
  }
}

fn red_status_is_passed(s: RedControlStatus) -> Bool {
  match s {
    RedControlPassed => true
    _ => false
  }
}

fn red_status_is_absent(s: RedControlStatus) -> Bool {
  match s {
    RedControlAbsent => true
    _ => false
  }
}

test fn red_control_of_red_control_flips() -> Bool {
  red_status_is_passed(s: red_control_status_for(probe: cost_red_control_probe))
    && red_status_is_failed_to_flip(s: red_control_status_for(probe: cost_well_formed_probe))
}

test fn only_cost_contract_carries_red_control_probe() -> Bool {
  red_status_is_passed(s: red_control_status_for_contract(contract: lens_contract_cost))
    && red_status_is_absent(s: red_control_status_for_contract(contract: lens_contract_vacuity))
}

fn self_status_is_observed(s: SelfApplicationStatus) -> Bool {
  match s {
    LensModuleFunctionObserved => true
    _ => false
  }
}

fn self_status_is_absent(s: SelfApplicationStatus) -> Bool {
  match s {
    SelfApplicationAbsent => true
    _ => false
  }
}

data synthetic_self_fn_fact: DeclFact = {
  qualified_name: "v2.lens.cost.cost_lens",
  name: "cost_lens",
  kind: FnItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/lens/cost.dag"
}

data synthetic_other_fn_fact: DeclFact = {
  qualified_name: "v2.workflow.other_fn",
  name: "other_fn",
  kind: FnItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/workflow/other.dag"
}

data synthetic_self_type_fact: DeclFact = {
  qualified_name: "v2.lens.cost.some_cost_type",
  name: "some_cost_type",
  kind: TypeItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/lens/cost.dag"
}

test fn self_application_liveness_discriminates() -> Bool {
  self_status_is_observed(
    s: self_application_for(facts: [synthetic_self_fn_fact], module_prefix: "v2.lens.cost.")
  )
    && self_status_is_absent(
      s: self_application_for(facts: [synthetic_other_fn_fact], module_prefix: "v2.lens.cost.")
    )
    && self_status_is_absent(
      s: self_application_for(facts: [synthetic_self_type_fact], module_prefix: "v2.lens.cost.")
    )
}

data synthetic_skeleton_fact: DeclFact = {
  qualified_name: "synthetic.skeleton_fn",
  name: "skeleton_fn",
  kind: FnItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "src/v2/synthetic_skeleton.dag"
}

data synthetic_computation_fact: DeclFact = {
  qualified_name: "synthetic.computation_fn",
  name: "computation_fn",
  kind: FnItem,
  node: cost_red_control_probe,
  rel_path: "src/v2/synthetic_computation.dag"
}

data synthetic_type_fact: DeclFact = {
  qualified_name: "synthetic.some_type",
  name: "some_type",
  kind: TypeItem,
  node: enforcement_red_probe_body_leaf,
  rel_path: "dag/synthetic_type.dag"
}

data synthetic_facts: List<DeclFact> = [
  synthetic_skeleton_fact,
  synthetic_computation_fact,
  synthetic_type_fact
]

test fn skeleton_only_fact_lands_body_unavailable() -> Bool {
  subject_is_body_unavailable(fact: synthetic_skeleton_fact)
    && !subject_is_body_unavailable(fact: synthetic_computation_fact)
}

test fn totality_judged_plus_unavailable_equals_fn_items() -> Bool {
  let judged_plus_unavailable = body_judged_count_of(facts: synthetic_facts) + body_unavailable_count_of(facts: synthetic_facts)
  (fn_item_count_of(facts: synthetic_facts) == 2)
    && (body_unavailable_count_of(facts: synthetic_facts) == 1)
    && (body_judged_count_of(facts: synthetic_facts) == 1)
    && (judged_plus_unavailable == fn_item_count_of(facts: synthetic_facts))
}

fn fact_has_qualified_name(fact: DeclFact, name: String) -> Bool {
  fact.qualified_name == name
}

fn facts_contain_qualified_name(facts: List<DeclFact>, name: String) -> Bool {
  fold(facts, init: false, f: fn(acc, fact) {
    acc || fact_has_qualified_name(fact: fact, name: name)
  })
}

// The sentinel's OWN reading, not a count: it asks the same predicate the census counter uses
// (`v2.lens.enforcement.receipts` `subject_is_body_judged`) of one named declaration, so a corpus
// where the arms partition the population but this fn is mis-judged still goes red.
fn named_fn_fact_is_body_judged(facts: List<DeclFact>, name: String) -> Bool {
  fold(facts, init: false, f: fn(acc, fact) {
    acc || (fact_has_qualified_name(fact: fact, name: name) && subject_is_body_judged(fact: fact))
  })
}

// The three roots the census must key in ONE walk. Their spellings are the census key, which
// `v1.compiler.coproduct_reflection::decl_qualified_name` builds as the module's own qualified name
// with `v2.` KEPT -- see the note there on two declarations sharing one identity once the layer
// prefix is stripped. The cost row therefore reads `v2.lens.cost.cost_lens`: the declaration lives
// in `src/v2/lens/cost.dag` under `module v2.lens.cost`, and no module named `lens.cost` exists.
test fn per_root_sentinels_hold_in_one_walk() -> Bool {
  let facts = enforcement_corpus_facts()
  facts_contain_qualified_name(facts: facts, name: "gunbc.commit_workflow.commit_gate_roster")
    && facts_contain_qualified_name(facts: facts, name: "v1.compiler.infer.build_type_env")
    && facts_contain_qualified_name(facts: facts, name: "v2.lens.cost.cost_lens")
}

// WHAT THIS LEG ASSERTS, AND WHAT IT USED TO ASSERT. It used to assert
// `body_unavailable_count_of(facts) == fn_item_count_of(facts)` -- that the whole live corpus is
// body-unavailable. That was a FROZEN POPULATION SNAPSHOT (the leg name said "currently"), and it
// stopped being true when the fn-arrow body skeleton learned that a call is a call: see
// `v1.compiler.coproduct_reflection::transform_record`. Before that change every skeleton node was
// a TypeNode, so `node_contains_computation` could not fire and the equality was VACUOUSLY true for
// any corpus; after it, any fn whose body contains a call judges as BodyJudged. The census was not
// broken -- the snapshot had been measuring a carrier that could not yet exist.
// This leg now asserts the countable invariant the snapshot stood in for. The two arms are counted
// INDEPENDENTLY (see `v2.lens.enforcement.receipts` `body_judged_count_of`), so the partition
// conjunct is a check between two folds rather than an identity: if one arm's predicate drifts, or
// `judge_subject_node` grows an arm neither counter knows, this goes red. A corpus where either arm
// collapses to zero -- everything judged, or nothing judged -- also goes red, which the snapshot
// could not see in either direction.
test fn live_corpus_body_judgment_partitions_the_population() -> Bool {
  let facts = enforcement_corpus_facts()
  (fn_item_count_of(facts: facts) > 500)
    && (body_judged_count_of(facts: facts) > 0)
    && (body_unavailable_count_of(facts: facts) > 0)
    && (body_judged_count_of(facts: facts) + body_unavailable_count_of(facts: facts)
        == fn_item_count_of(facts: facts))
    && named_fn_fact_is_body_judged(facts: facts, name: "v2.lens.cost.cost_lens")
}

test fn unbound_contracts_remain_enumerable() -> Bool {
  unbound_contract_count() > 0
    && lens_contract_is_unbound(c: lens_contract_complexity_derived_kernel)
    && lens_contract_is_unbound(c: lens_contract_complexity_optimality)
    && lens_contract_is_unbound(c: lens_contract_effect_reach)
}

test fn bound_contracts_derive_live_receipts() -> Bool {
  !lens_contract_is_unbound(c: lens_contract_cost)
    && !lens_contract_is_unbound(c: lens_contract_vacuity)
    && length(xs: coverage_receipts_live()) == (length(xs: lens_contract_registry) - unbound_contract_count())
}

test fn unbound_contracts_omit_semantic_receipts() -> Bool {
  length(xs: coverage_receipts_live()) < length(xs: lens_contract_registry)
}
