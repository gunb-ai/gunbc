module v2.test.claim.name_resolve_cross_tree_resolution


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn ct_graft_module_root(root: v2.std.node.Node) -> v2.std.node.Node {
  match module_header_containment_graft(root: root) {
    Accepted { value: grafted, diagnostics: _ } => grafted
    Rejected { diagnostics: _ } => root
  }
}

fn ct_qn_node(seg: v2.std.node.Symbol) -> v2.std.node.Node {
  fold_list_node(
    xs: std.algebra.Cons { head: seg, tail: std.algebra.Empty },
    item_node: fn(sym) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
}

fn ct_qn_spine(segments: FreeMonoid<v2.std.node.Symbol>) -> v2.std.node.Node {
  fold_list_node(
    xs: segments,
    item_node: fn(sym) {
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
}

fn ct_module_root(qn_spine: v2.std.node.Node, export_sym: v2.std.node.Symbol, export_atom: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: qn_spine
      ),
      v2.std.node.Edge {
        label: v2.std.node.Named { name: export_sym },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: export_atom } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ct_subject_with_import_use(
  qn_spine: v2.std.node.Node,
  import_use_sym: v2.std.node.Symbol,
  imported_decl: v2.std.node.Symbol
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: qn_spine
      ),
      v2.std.node.Edge {
        label: v2.std.node.Named { name: import_use_sym },
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: imported_decl } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ct_qn_one(seg: v2.std.node.Symbol) -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons { head: seg, tail: std.algebra.Empty }
}

fn ct_qn_v2(seg_b: v2.std.node.Symbol) -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons {
    head: ^v2,
    tail: std.algebra.Cons { head: seg_b, tail: std.algebra.Empty }
  }
}

fn ct_qn_v2_std() -> v2.std.qualified_name.QualifiedName {
  std.algebra.Cons {
    head: ^v2,
    tail: std.algebra.Cons { head: ^std, tail: std.algebra.Empty }
  }
}

fn ct_both_trees() -> v2.std.cross_tree.import_model.SourceRootSet {
  std.algebra.Cons { head: V2Tree, tail: std.algebra.Cons { head: DagTree, tail: std.algebra.Empty } }
}

fn ct_dag_same_tree_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  admit_normalized_roots(
    roots: std.algebra.Cons {
    head: ct_graft_module_root(
      root: ct_subject_with_import_use(
        qn_spine: ct_qn_node(seg: ^ct_dag_subject_seg),
        import_use_sym: ^ct_dag_import_use_sym,
        imported_decl: ^ct_dag_imported_decl
      )
    ),
    tail: std.algebra.Cons {
      head: ct_graft_module_root(
        root: ct_module_root(
          qn_spine: ct_qn_node(seg: ^ct_dag_peer_seg),
          export_sym: ^ct_dag_imported_decl,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: std.algebra.Empty
    }
  },
    diagnostics: v2.std.diagnostic.None
  )
}

fn ct_dag_same_tree_admission() -> v2.compiler.name_resolve.Admission {
  v2.compiler.name_resolve.Admission {
    subject: v2.compiler.name_resolve.ResolutionSubject { name: ct_qn_one(seg: ^ct_dag_subject_seg) },
    imports: std.algebra.Cons {
      head: v2.compiler.name_resolve.Import {
        target: ct_qn_one(seg: ^ct_dag_peer_seg),
        visibility: ImportVisible
      },
      tail: std.algebra.Empty
    }
  }
}

fn ct_v2_same_tree_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  admit_normalized_roots(
    roots: std.algebra.Cons {
    head: ct_graft_module_root(
      root: ct_subject_with_import_use(
        qn_spine: ct_qn_spine(
          segments: std.algebra.Cons { head: ^v2, tail: std.algebra.Cons { head: ^ct_v2_subject_seg, tail: std.algebra.Empty } }
        ),
        import_use_sym: ^ct_v2_import_use_sym,
        imported_decl: ^ct_v2_imported_decl
      )
    ),
    tail: std.algebra.Cons {
      head: ct_graft_module_root(
        root: ct_module_root(
          qn_spine: ct_qn_spine(
            segments: std.algebra.Cons { head: ^v2, tail: std.algebra.Cons { head: ^ct_v2_peer_seg, tail: std.algebra.Empty } }
          ),
          export_sym: ^ct_v2_imported_decl,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: std.algebra.Empty
    }
  },
    diagnostics: v2.std.diagnostic.None
  )
}

fn ct_v2_same_tree_admission() -> v2.compiler.name_resolve.Admission {
  v2.compiler.name_resolve.Admission {
    subject: v2.compiler.name_resolve.ResolutionSubject { name: ct_qn_v2(seg_b: ^ct_v2_subject_seg) },
    imports: std.algebra.Cons {
      head: v2.compiler.name_resolve.Import {
        target: ct_qn_v2(seg_b: ^ct_v2_peer_seg),
        visibility: ImportVisible
      },
      tail: std.algebra.Empty
    }
  }
}

fn ct_cross_tree_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  admit_normalized_roots(
    roots: std.algebra.Cons {
    head: ct_graft_module_root(
      root: ct_subject_with_import_use(
        qn_spine: ct_qn_spine(
          segments: std.algebra.Cons { head: ^v2, tail: std.algebra.Cons { head: ^ct_cross_v2_subject_seg, tail: std.algebra.Empty } }
        ),
        import_use_sym: ^ct_cross_import_use_sym,
        imported_decl: ^ct_cross_dag_export_sym
      )
    ),
    tail: std.algebra.Cons {
      head: ct_graft_module_root(
        root: ct_module_root(
          qn_spine: ct_qn_node(seg: ^ct_cross_dag_target_seg),
          export_sym: ^ct_cross_dag_export_sym,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: std.algebra.Empty
    }
  },
    diagnostics: v2.std.diagnostic.None
  )
}

fn ct_cross_tree_admission() -> v2.compiler.name_resolve.Admission {
  v2.compiler.name_resolve.Admission {
    subject: v2.compiler.name_resolve.ResolutionSubject {
      name: ct_qn_v2(seg_b: ^ct_cross_v2_subject_seg)
    },
    imports: std.algebra.Cons {
      head: v2.compiler.name_resolve.Import {
        target: ct_qn_one(seg: ^ct_cross_dag_target_seg),
        visibility: ImportVisible
      },
      tail: std.algebra.Empty
    }
  }
}

fn ct_v2_to_dag_index() -> v2.std.cross_tree.resolution.SourceRootIndex {
  source_root_index_insert(
    index: source_root_index_insert(
      index: source_root_index_empty(),
      module: ct_qn_v2(seg_b: ^ct_cross_v2_subject_seg),
      root: V2Tree
    ),
    module: ct_qn_one(seg: ^ct_cross_dag_target_seg),
    root: DagTree
  )
}

fn ct_dag_to_v2_roots() -> v2.std.diagnostic.Outcome<FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>> {
  admit_normalized_roots(
    roots: std.algebra.Cons {
    head: ct_graft_module_root(
      root: ct_subject_with_import_use(
        qn_spine: ct_qn_node(seg: ^ct_inv_dag_subject_seg),
        import_use_sym: ^ct_inv_import_use_sym,
        imported_decl: ^ct_inv_v2_export_sym
      )
    ),
    tail: std.algebra.Cons {
      head: ct_graft_module_root(
        root: ct_module_root(
          qn_spine: ct_qn_spine(
            segments: std.algebra.Cons { head: ^v2, tail: std.algebra.Cons { head: ^std, tail: std.algebra.Empty } }
          ),
          export_sym: ^ct_inv_v2_export_sym,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: std.algebra.Empty
    }
  },
    diagnostics: v2.std.diagnostic.None
  )
}

fn ct_dag_to_v2_admission() -> v2.compiler.name_resolve.Admission {
  v2.compiler.name_resolve.Admission {
    subject: v2.compiler.name_resolve.ResolutionSubject {
      name: ct_qn_one(seg: ^ct_inv_dag_subject_seg)
    },
    imports: std.algebra.Cons {
      head: v2.compiler.name_resolve.Import {
        target: ct_qn_v2_std(),
        visibility: ImportVisible
      },
      tail: std.algebra.Empty
    }
  }
}

fn ct_dag_to_v2_index() -> v2.std.cross_tree.resolution.SourceRootIndex {
  source_root_index_insert(
    index: source_root_index_insert(
      index: source_root_index_empty(),
      module: ct_qn_one(seg: ^ct_inv_dag_subject_seg),
      root: DagTree
    ),
    module: ct_qn_v2_std(),
    root: V2Tree
  )
}

test fn witness_dag_same_tree_import_resolves_holds() -> v2.std.logic.Bool {
  match ct_dag_same_tree_roots() {
    Rejected { diagnostics: _ } => false
    Accepted { value: admitted, diagnostics: _ } =>
    match resolve_with_admission_policy(
      lm: dag_language_model_surface_empty_prelude(),
      roots: admitted,
      admission: ct_dag_same_tree_admission(),
      index: source_root_index_empty(),
      active_roots: std.algebra.Empty,
      policy: ImportScoped
    ) {
      Accepted { value: _, diagnostics: _ } => true
      Rejected { diagnostics: _ } => false
    }
  }
}

test fn witness_v2_same_tree_import_resolves_holds() -> v2.std.logic.Bool {
  match ct_v2_same_tree_roots() {
    Rejected { diagnostics: _ } => false
    Accepted { value: admitted, diagnostics: _ } =>
    match resolve_with_admission_policy(
      lm: dag_language_model_surface_empty_prelude(),
      roots: admitted,
      admission: ct_v2_same_tree_admission(),
      index: source_root_index_empty(),
      active_roots: std.algebra.Empty,
      policy: ImportScoped
    ) {
      Accepted { value: _, diagnostics: _ } => true
      Rejected { diagnostics: _ } => false
    }
  }
}

test fn witness_cross_tree_v2_to_dag_grounded_resolves_holds() -> v2.std.logic.Bool {
  match ct_cross_tree_roots() {
    Rejected { diagnostics: _ } => false
    Accepted { value: admitted, diagnostics: _ } =>
    match resolve_with_admission_policy(
      lm: dag_language_model_surface_empty_prelude(),
      roots: admitted,
      admission: ct_cross_tree_admission(),
      index: ct_v2_to_dag_index(),
      active_roots: ct_both_trees(),
      policy: ImportScoped
    ) {
      Accepted { value: _, diagnostics: _ } => true
      Rejected { diagnostics: _ } => false
    }
  }
}

test fn witness_cross_tree_dag_to_v2_grounded_denied_holds() -> v2.std.logic.Bool {
  match ct_dag_to_v2_roots() {
    Rejected { diagnostics: _ } => false
    Accepted { value: admitted, diagnostics: _ } =>
    match resolve_with_admission_policy(
      lm: dag_language_model_surface_empty_prelude(),
      roots: admitted,
      admission: ct_dag_to_v2_admission(),
      index: ct_dag_to_v2_index(),
      active_roots: ct_both_trees(),
      policy: ImportScoped
    ) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: r } =>
        (r.head.reason == ^resolve_cross_tree_import_denied)
          && locus_eq(
            a: r.head.at,
            b: port_locus(port: ^resolve_cross_tree_import_denied)
          )
    }
  }
}

