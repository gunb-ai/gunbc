module v2.test.claim.name_resolve_cross_tree_resolution

import v2.compiler.name_resolve {
  Admission,
  Import,
  ImportVisible,
  ResolutionSubject,
  resolve_with_admission_policy
}
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_language_model_surface_empty_prelude,
  dag_named_edge
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list_node }
import v2.std.cross_tree.import_model { DagTree, SourceRootSet, V2Tree }
import v2.std.cross_tree.resolution {
  SourceRootIndex,
  source_root_index_empty,
  source_root_index_insert
}
import v2.std.diagnostic {
  Accepted,
  Rejected,
  locus_eq,
  port_locus
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.compiler.namespace_graft { module_header_containment_graft }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.qualified_name { QualifiedName }
import v2.std.resolution_policy { ImportScoped }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ct_graft_module_root(root: Node) -> Node {
  match module_header_containment_graft(root: root) {
    Accepted { value: grafted, diagnostics: _ } => grafted
    Rejected { diagnostics: _ } => root
  }
}

fn ct_qn_node(seg: Symbol) -> Node {
  fold_list_node(
    xs: Cons { head: seg, tail: Empty },
    item_node: fn(sym) {
      Node {
        kind: TypeNode { connective: Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
}

fn ct_qn_spine(segments: FreeMonoid<Symbol>) -> Node {
  fold_list_node(
    xs: segments,
    item_node: fn(sym) {
      Node {
        kind: TypeNode { connective: Atom { identity: sym } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
}

fn ct_module_root(qn_spine: Node, export_sym: Symbol, export_atom: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: qn_spine
      ),
      Edge {
        label: Named { name: export_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: export_atom } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ct_subject_with_import_use(
  qn_spine: Node,
  import_use_sym: Symbol,
  imported_decl: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_named_edge(
        name: ^dag_surface_module_header_qualified_name,
        target: qn_spine
      ),
      Edge {
        label: Named { name: import_use_sym },
        target: Node {
          kind: TypeNode { connective: Atom { identity: imported_decl } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ct_qn_one(seg: Symbol) -> QualifiedName {
  Cons { head: seg, tail: Empty }
}

fn ct_qn_v2(seg_b: Symbol) -> QualifiedName {
  Cons {
    head: ^v2,
    tail: Cons { head: seg_b, tail: Empty }
  }
}

fn ct_qn_v2_std() -> QualifiedName {
  Cons {
    head: ^v2,
    tail: Cons { head: ^std, tail: Empty }
  }
}

fn ct_both_trees() -> SourceRootSet {
  Cons { head: V2Tree, tail: Cons { head: DagTree, tail: Empty } }
}

fn ct_dag_same_tree_roots() -> FreeMonoid<Node> {
  Cons {
    head: ct_graft_module_root(
      root: ct_subject_with_import_use(
        qn_spine: ct_qn_node(seg: ^ct_dag_subject_seg),
        import_use_sym: ^ct_dag_import_use_sym,
        imported_decl: ^ct_dag_imported_decl
      )
    ),
    tail: Cons {
      head: ct_graft_module_root(
        root: ct_module_root(
          qn_spine: ct_qn_node(seg: ^ct_dag_peer_seg),
          export_sym: ^ct_dag_imported_decl,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: Empty
    }
  }
}

fn ct_dag_same_tree_admission() -> Admission {
  Admission {
    subject: ResolutionSubject { name: ct_qn_one(seg: ^ct_dag_subject_seg) },
    imports: Cons {
      head: Import {
        target: ct_qn_one(seg: ^ct_dag_peer_seg),
        visibility: ImportVisible
      },
      tail: Empty
    }
  }
}

fn ct_v2_same_tree_roots() -> FreeMonoid<Node> {
  Cons {
    head: ct_graft_module_root(
      root: ct_subject_with_import_use(
        qn_spine: ct_qn_spine(
          segments: Cons { head: ^v2, tail: Cons { head: ^ct_v2_subject_seg, tail: Empty } }
        ),
        import_use_sym: ^ct_v2_import_use_sym,
        imported_decl: ^ct_v2_imported_decl
      )
    ),
    tail: Cons {
      head: ct_graft_module_root(
        root: ct_module_root(
          qn_spine: ct_qn_spine(
            segments: Cons { head: ^v2, tail: Cons { head: ^ct_v2_peer_seg, tail: Empty } }
          ),
          export_sym: ^ct_v2_imported_decl,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: Empty
    }
  }
}

fn ct_v2_same_tree_admission() -> Admission {
  Admission {
    subject: ResolutionSubject { name: ct_qn_v2(seg_b: ^ct_v2_subject_seg) },
    imports: Cons {
      head: Import {
        target: ct_qn_v2(seg_b: ^ct_v2_peer_seg),
        visibility: ImportVisible
      },
      tail: Empty
    }
  }
}

fn ct_cross_tree_roots() -> FreeMonoid<Node> {
  Cons {
    head: ct_graft_module_root(
      root: ct_subject_with_import_use(
        qn_spine: ct_qn_spine(
          segments: Cons { head: ^v2, tail: Cons { head: ^ct_cross_v2_subject_seg, tail: Empty } }
        ),
        import_use_sym: ^ct_cross_import_use_sym,
        imported_decl: ^ct_cross_dag_export_sym
      )
    ),
    tail: Cons {
      head: ct_graft_module_root(
        root: ct_module_root(
          qn_spine: ct_qn_node(seg: ^ct_cross_dag_target_seg),
          export_sym: ^ct_cross_dag_export_sym,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: Empty
    }
  }
}

fn ct_cross_tree_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: ct_qn_v2(seg_b: ^ct_cross_v2_subject_seg)
    },
    imports: Cons {
      head: Import {
        target: ct_qn_one(seg: ^ct_cross_dag_target_seg),
        visibility: ImportVisible
      },
      tail: Empty
    }
  }
}

fn ct_v2_to_dag_index() -> SourceRootIndex {
  source_root_index_insert(
    index: source_root_index_insert(
      index: source_root_index_empty(),
      module: ct_qn_v2(seg_b: ^ct_cross_v2_subject_seg),
      root: V2Tree
    ),
    module: ct_qn_one(seg: ^ct_cross_dag_target_seg),
    root: DagTree
  )
}

fn ct_dag_to_v2_roots() -> FreeMonoid<Node> {
  Cons {
    head: ct_graft_module_root(
      root: ct_subject_with_import_use(
        qn_spine: ct_qn_node(seg: ^ct_inv_dag_subject_seg),
        import_use_sym: ^ct_inv_import_use_sym,
        imported_decl: ^ct_inv_v2_export_sym
      )
    ),
    tail: Cons {
      head: ct_graft_module_root(
        root: ct_module_root(
          qn_spine: ct_qn_spine(
            segments: Cons { head: ^v2, tail: Cons { head: ^std, tail: Empty } }
          ),
          export_sym: ^ct_inv_v2_export_sym,
          export_atom: ^dag_c3_surface_sugar_service
        )
      ),
      tail: Empty
    }
  }
}

fn ct_dag_to_v2_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: ct_qn_one(seg: ^ct_inv_dag_subject_seg)
    },
    imports: Cons {
      head: Import {
        target: ct_qn_v2_std(),
        visibility: ImportVisible
      },
      tail: Empty
    }
  }
}

fn ct_dag_to_v2_index() -> SourceRootIndex {
  source_root_index_insert(
    index: source_root_index_insert(
      index: source_root_index_empty(),
      module: ct_qn_one(seg: ^ct_inv_dag_subject_seg),
      root: DagTree
    ),
    module: ct_qn_v2_std(),
    root: V2Tree
  )
}

fn witness_dag_same_tree_import_resolves_holds() -> Bool {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: ct_dag_same_tree_roots(),
    admission: ct_dag_same_tree_admission(),
    index: source_root_index_empty(),
    active_roots: Empty,
    policy: ImportScoped
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn witness_v2_same_tree_import_resolves_holds() -> Bool {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: ct_v2_same_tree_roots(),
    admission: ct_v2_same_tree_admission(),
    index: source_root_index_empty(),
    active_roots: Empty,
    policy: ImportScoped
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn witness_cross_tree_v2_to_dag_grounded_resolves_holds() -> Bool {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: ct_cross_tree_roots(),
    admission: ct_cross_tree_admission(),
    index: ct_v2_to_dag_index(),
    active_roots: ct_both_trees(),
    policy: ImportScoped
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn witness_cross_tree_dag_to_v2_grounded_denied_holds() -> Bool {
  match resolve_with_admission_policy(
    lm: dag_language_model_surface_empty_prelude(),
    roots: ct_dag_to_v2_roots(),
    admission: ct_dag_to_v2_admission(),
    index: ct_dag_to_v2_index(),
    active_roots: ct_both_trees(),
    policy: ImportScoped
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } =>
      (r.head.reason == ^resolve_cross_tree_import_denied)
        && locus_eq(
          a: r.head.at,
          b: port_locus(port: ^resolve_cross_tree_import_denied)
        )
  }
}

test fn name_resolve_cross_tree_resolution_witnesses() -> Bool {
  witness_dag_same_tree_import_resolves_holds()
    && witness_v2_same_tree_import_resolves_holds()
    && witness_cross_tree_v2_to_dag_grounded_resolves_holds()
    && witness_cross_tree_dag_to_v2_grounded_denied_holds()
}
