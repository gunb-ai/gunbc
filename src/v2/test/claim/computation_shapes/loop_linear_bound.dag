module v2.test.computation_shapes.loop_linear_bound


fn loop_linear_bound_leaf(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
}

data loop_linear_bound_body_leaf: v2.std.node.Node = loop_linear_bound_leaf(s: ^loop_linear_bound_body_sym)
data loop_linear_bound_measure_leaf: v2.std.node.Node = loop_linear_bound_leaf(s: ^loop_linear_bound_measure_sym)

data loop_linear_bound_body: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: loop_linear_bound_body_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data loop_linear_bound_subject: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: loop_linear_bound_body },
    v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_bound_edge }, target: loop_linear_bound_measure_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

fn loop_linear_bound_pass_node() -> v2.std.node.Node {
  loop_linear_bound_leaf(s: ^loop_linear_bound_pass_sym)
}

fn loop_linear_bound_fail_node() -> v2.std.node.Node {
  loop_linear_bound_leaf(s: ^loop_linear_bound_fail_sym)
}

fn loop_linear_bound_bool_node(ok: Bool) -> v2.std.node.Node {
  if ok { loop_linear_bound_pass_node() } else { loop_linear_bound_fail_node() }
}

data witness_loop_linear_bound_well_formed: Bool = v2.std.node.well_formed(n: loop_linear_bound_subject)

data claim_loop_linear_bound_well_formed: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "computation_shapes/loop_linear_bound: Loop with loop_bound_edge is well-formed",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: loop_linear_bound_bool_node(ok: witness_loop_linear_bound_well_formed),
  expected_value: loop_linear_bound_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_loop_linear_bound_equals_refl: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "computation_shapes/loop_linear_bound: Equals reflexivity on Loop bound subject",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: loop_linear_bound_subject,
  rhs: loop_linear_bound_subject,
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data loop_linear_bound_subject_rebuilt: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: loop_linear_bound_body },
    v2.std.node.Edge { label: v2.std.node.Named { name: ^loop_bound_edge }, target: loop_linear_bound_measure_leaf }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data loop_linear_bound_subject_unbounded: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Loop },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: loop_linear_bound_body }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data witness_loop_linear_bound_content_hash_stable: Bool = (v2.std.node.content_hash(n: loop_linear_bound_subject) == v2.std.node.content_hash(n: loop_linear_bound_subject_rebuilt)) && (v2.std.node.content_hash(n: loop_linear_bound_subject) != v2.std.node.content_hash(n: loop_linear_bound_subject_unbounded))

data claim_loop_linear_bound_content_hash_stable: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "computation_shapes/loop_linear_bound: content_hash is stable on Loop bound subject",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: loop_linear_bound_bool_node(ok: witness_loop_linear_bound_content_hash_stable),
  expected_value: loop_linear_bound_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}
