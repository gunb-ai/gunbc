module v2.test.computation_shapes.loop_linear_bound


fn loop_linear_bound_leaf(s: v2.std.node.Symbol) -> Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: SyntheticOccurrence
}
}

data loop_linear_bound_body_leaf: Node = loop_linear_bound_leaf(s: ^loop_linear_bound_body_sym)
data loop_linear_bound_measure_leaf: Node = loop_linear_bound_leaf(s: ^loop_linear_bound_measure_sym)

data loop_linear_bound_body: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Transform },
  children: [
    v2.std.node.Edge { label: Positional, target: loop_linear_bound_body_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data loop_linear_bound_subject: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Loop },
  children: [
    v2.std.node.Edge { label: Positional, target: loop_linear_bound_body },
    v2.std.node.Edge { label: Named { name: ^loop_bound_edge }, target: loop_linear_bound_measure_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

fn loop_linear_bound_pass_node() -> Node {
  loop_linear_bound_leaf(s: ^loop_linear_bound_pass_sym)
}

fn loop_linear_bound_fail_node() -> Node {
  loop_linear_bound_leaf(s: ^loop_linear_bound_fail_sym)
}

fn loop_linear_bound_bool_node(ok: Bool) -> Node {
  if ok { loop_linear_bound_pass_node() } else { loop_linear_bound_fail_node() }
}

data witness_loop_linear_bound_well_formed: Bool = well_formed(n: loop_linear_bound_subject)

data claim_loop_linear_bound_well_formed: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "computation_shapes/loop_linear_bound: Loop with loop_bound_edge is well-formed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: loop_linear_bound_bool_node(ok: witness_loop_linear_bound_well_formed),
  expected_value: loop_linear_bound_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

data claim_loop_linear_bound_equals_refl: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "computation_shapes/loop_linear_bound: Equals reflexivity on Loop bound subject",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: loop_linear_bound_subject,
  rhs: loop_linear_bound_subject,
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

data loop_linear_bound_subject_rebuilt: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Loop },
  children: [
    v2.std.node.Edge { label: Positional, target: loop_linear_bound_body },
    v2.std.node.Edge { label: Named { name: ^loop_bound_edge }, target: loop_linear_bound_measure_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data loop_linear_bound_subject_unbounded: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Loop },
  children: [
    v2.std.node.Edge { label: Positional, target: loop_linear_bound_body }
  ],
  occurrence_id: SyntheticOccurrence
}

data witness_loop_linear_bound_content_hash_stable: Bool = (content_hash(n: loop_linear_bound_subject) == content_hash(n: loop_linear_bound_subject_rebuilt)) && (content_hash(n: loop_linear_bound_subject) != content_hash(n: loop_linear_bound_subject_unbounded))

data claim_loop_linear_bound_content_hash_stable: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "computation_shapes/loop_linear_bound: content_hash is stable on Loop bound subject",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: loop_linear_bound_bool_node(ok: witness_loop_linear_bound_content_hash_stable),
  expected_value: loop_linear_bound_pass_node(),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}
