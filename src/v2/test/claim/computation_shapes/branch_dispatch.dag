module v2.test.computation_shapes.branch_dispatch


fn branch_dispatch_leaf(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node { kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } }, children: [],
 occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn branch_dispatch_arm(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: branch_dispatch_leaf(s: s) }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

data branch_dispatch_arm_then: v2.std.node.Node = branch_dispatch_arm(s: ^branch_dispatch_arm_then_sym)
data branch_dispatch_arm_else: v2.std.node.Node = branch_dispatch_arm(s: ^branch_dispatch_arm_else_sym)

data branch_dispatch_subject: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Branch },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: branch_dispatch_arm_then },
    v2.std.node.Edge { label: v2.std.node.Positional, target: branch_dispatch_arm_else }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

fn branch_dispatch_pass_node() -> v2.std.node.Node {
  branch_dispatch_leaf(s: ^branch_dispatch_pass_sym)
}

fn branch_dispatch_fail_node() -> v2.std.node.Node {
  branch_dispatch_leaf(s: ^branch_dispatch_fail_sym)
}

fn branch_dispatch_bool_node(ok: Bool) -> v2.std.node.Node {
  if ok { branch_dispatch_pass_node() } else { branch_dispatch_fail_node() }
}

data witness_branch_dispatch_well_formed: Bool = v2.std.node.well_formed(n: branch_dispatch_subject)

data claim_branch_dispatch_well_formed: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "computation_shapes/branch_dispatch: Branch with two Transform arms is well-formed",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: branch_dispatch_bool_node(ok: witness_branch_dispatch_well_formed),
  expected_value: branch_dispatch_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data claim_branch_dispatch_equals_refl: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "computation_shapes/branch_dispatch: Equals reflexivity on Branch dispatch subject",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  lhs: branch_dispatch_subject,
  rhs: branch_dispatch_subject,
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}

data branch_dispatch_subject_rebuilt: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Branch },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: branch_dispatch_arm_then },
    v2.std.node.Edge { label: v2.std.node.Positional, target: branch_dispatch_arm_else }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data branch_dispatch_subject_arms_swapped: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: v2.std.node.Branch },
  children: [
    v2.std.node.Edge { label: v2.std.node.Positional, target: branch_dispatch_arm_else },
    v2.std.node.Edge { label: v2.std.node.Positional, target: branch_dispatch_arm_then }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

data witness_branch_dispatch_content_hash_stable: Bool = (v2.std.node.content_hash(n: branch_dispatch_subject) == v2.std.node.content_hash(n: branch_dispatch_subject_rebuilt)) && (v2.std.node.content_hash(n: branch_dispatch_subject) != v2.std.node.content_hash(n: branch_dispatch_subject_arms_swapped))

data claim_branch_dispatch_content_hash_stable: v2.std.verification.TestClaim = v2.std.verification.CompilesClaim {
  label: "computation_shapes/branch_dispatch: content_hash is stable on Branch dispatch subject",
  anchor: v2.std.verification.manual_claim_anchor(anchor: v2.std.verification.ManualAnchorAbsent),
  input: branch_dispatch_bool_node(ok: witness_branch_dispatch_content_hash_stable),
  expected_value: branch_dispatch_pass_node(),
  classification: v2.std.verification.TestClassification { tier: v2.std.verification.Tier1, layer: Unit }
}
