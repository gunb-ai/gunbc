module v2.test.claim.enforcement.determinism_transitive_witness

import v2.lens.determinism {
  determinism_findings,
  determinism_transitive_findings,
  determinism_transitive_holds
}
import v2.lens.module_graph { module_declaration_facts_live }
import v2.std.algebra { contains, fold_list, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.diagnostic { Diagnostic }
import v2.std.fn_index { FnArrowDecl, FnArrowParam, callees_from_node, fn_arrow_decl_facts_live }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Positional,
  Transform,
  TypeNode
}
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.text { String }

// ── the live judgment ─────────────────────────────────────────────────────────────────────────
//
// THE LIVE CONSUMER STANDS. Clause 2 of gunbc#10156 required a live required-floor consumer of the
// grounded call-reachability authority -- one whose declared substrate and cadence match the inputs
// it reads, whose failure reaches the required PR floor, and which cannot predict-skip.
// `determinism_transitive_live_closure_holds` below is it.
//
// IT WAS WITHDRAWN ONCE, AND THE REASON IS RECORDED RATHER THAN DELETED, because a reader who finds
// this row green needs to know what changed to make it possible. `fn_arrow_decl_facts_live` was
// ZERO-ARITY in both .dag and host and always walked the whole of `ctx.modules`, so the smallest
// live subject expressible still paid one whole-tree acquisition before evaluating anything --
// decomposition INVERTED on it, and N witnesses over corpus slices cost N x acquisition rather than
// acquisition/N. Measured on required run 33709585360 the withdrawn row was the single most
// expensive subject on the floor, #1 of 3523, against a per-subject line the operator has since
// regrounded to 100ms.
//
// WHAT DISSOLVED THE BLOCKER, stated as the capability the withdrawal named: the acquisition now
// has a caller-named subject. `fn_arrow_decl_facts_live(pool_roots:)` answers over the roots this
// witness declares and over nothing else, so the cost is proportional to the subject rather than to
// the corpus, and the floor's (roots, kinds) parse memo serves every claim naming the same roots
// from one walk. Both consequences the withdrawal said were unavailable are what this row now uses.
//
// THE SUBJECT AND THE CLOSURE HAVE ONE ORIGIN, which is the part a caller can otherwise get wrong.
// `determinism_live_subject_roots` is passed to BOTH producers below -- the declaration population
// and the module list that bounds the reachability walk -- so the closure cannot name a module the
// declarations do not cover, or cover a module the closure does not admit. Pairing two
// independently-chosen values here would make the judgment's scope a coincidence.
//
// WHAT THIS ROW DOES NOT CLAIM. It judges ONE declared subject, not the corpus: a
// non-deterministic primitive reachable from an entry outside these roots is invisible to it, and
// widening the subject is a cost decision measured against the floor's per-subject line, not a
// property this row establishes. That is the honest reading of a caller-named subject -- the scope
// is exactly what the caller declared, and it is declared here in one place.

// THE STAMP IS PART OF THE CLAUSE, NOT HOUSEKEEPING. Clause 2 asks for a consumer whose DECLARED
// substrate matches the inputs it reads and which cannot predict-skip. This module reads the live
// tree from the row below, and it carried no disposition row while it did -- #10156 removed the
// stamp when it withdrew the consumer, correctly, and restoring the consumer without restoring the
// stamp would have left the substrate undeclared while the file claimed the clause was met.
//
// UNDECLARED IS NOT THE SAME AS DECLARED-TRUE HERE, even though the two coincide today.
// v2.std.live_tree records that the selection consumer treats an undeclared entry as ReadsLiveTree,
// so an unstamped row would in fact never predict-skip -- the clause's fourth criterion would hold
// by DEFAULT. It would not hold by DECLARATION, and the criterion is about the declaration: a row
// relying on a fail-closed default asserts nothing about its own inputs, and the same file records
// that a stamp is checked by nothing, so a silent row and a lying row are indistinguishable.
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data determinism_live_subject_roots: List<String> = []

// File grain: the affected_set.dag module carries 78 fn-arrow declarations
// that the determinism transitive walk traverses. Targeting the single file
// keeps the walk within budget (the previous directory-wide walk from
// "src/v2/lens" hit the per-claim CPU deadline). The fn-arrow selection
// composition under corpus_dependency_view is deleted; the main affected_set.dag
// still has the function declarations the walk exercises.
data determinism_live_subject_files: List<String> = ["src/v2/lens/affected_set.dag"]

data determinism_live_entry_module: String = "v2.lens.affected_set"

data determinism_live_empty_modules: List<String> = []

fn determinism_live_closure_modules() -> List<String> {
  fold_list(
    xs: module_declaration_facts_live(pool_roots: determinism_live_subject_roots),
    empty: determinism_live_empty_modules,
    cons: fn(acc, fact) { list_snoc_item(xs: acc, item: fact.module) }
  )
}

test fn determinism_transitive_live_closure_holds() -> Bool {
  determinism_transitive_holds(
    entry_module: determinism_live_entry_module,
    closure_modules: determinism_live_closure_modules(),
    decls: fn_arrow_decl_facts_live(
      pool_roots: determinism_live_subject_roots,
      pool_files: determinism_live_subject_files
    )
  )
}

// POSITIVE CONTROL ON THE LIVE SUBJECT, so the green above is not the empty-population green. If
// the named roots yielded no declarations, or the entry module were absent from the closure, the
// judgment would hold vacuously and report nothing -- which is the failure the fixture rows below
// cannot see, because they supply their own declarations.
test fn the_live_subject_is_not_empty() -> Bool {
  length(
    xs: fn_arrow_decl_facts_live(
      pool_roots: determinism_live_subject_roots,
      pool_files: determinism_live_subject_files
    )
  ) > 0
    && length(xs: determinism_live_closure_modules()) > 0
    && contains(
      xs: determinism_live_closure_modules(),
      item: determinism_live_entry_module,
      eq: fn(a, b) { a == b }
    )
}

// ── THE SHAPE GAP: CLOSED, AND THE PAIR STAYS ────────────────────────────────────────────────
//
// THE TWO ROWS ABOVE ONCE PASSED WITHOUT CARRYING INFORMATION, and the record of why is kept here
// because it is the useful part. The live judgment COULD NOT FAIL over a fn_arrow_decl_facts_live
// population: `v1_compiler.coproduct_reflection` `marshal_skeleton` built every fn-arrow body node
// through `conj_record`, i.e. `TypeNode { connective: Conj }`, while `v2.std.node_query`
// `node_is_call` matches `ComputationNode { behavior: Transform }` and is false otherwise. So
// `node_callee_symbol` was Absent at every skeleton node and `v2.lens.determinism` classified every
// body Deterministic by non-membership. The positive control did not detect this and could not: the
// population was non-empty and the entry module present, which is the precondition passing while
// the check itself is blind.
//
// THE §4b(2) STALL FILED HERE IS RETIRED BY ITS TRIGGER AND BY NOTHING ELSE, AND THE TRIGGER HAS
// FIRED. It named the CAPABILITY -- the fn-arrow body skeleton represents a call at a shape
// `node_is_call` accepts -- and gunbc#10282 landed exactly that: `marshal_generic` returns a
// `ComputationNode { behavior: Transform }` record for an `ExprCall` with a non-empty authored
// name, whose first positional child is already the callee identity leaf. The seed-side executing
// evidence that the PRODUCER emits the accepted shape is
// `marshaled_call_carries_the_transform_call_carrier`, with
// `marshaled_non_call_stays_a_conj_type_node` as its control, on the required
// `cargo test -p v1-compiler --lib` lane -- deliberately there and not here, because both rows
// below construct their nodes by hand and a hand-built node can attest a lens, never a marshal.
//
// WHAT IS NOW TRUE. A call in a fn-arrow body skeleton is a call as this lens recognises one, and
// `v2.std.fn_index.callees_from_node` reads that call channel across the whole output subtree. The
// live judgment's green is therefore a statement about the closure rather than about either a
// representation gap or a depth-one horizon. The nested-body pair below remains the regression
// control for that subtree read.
//
// THE PAIR DOES NOT RETIRE ON THE CLIMB (§4b(4)). The prediction written here when the stall was
// filed -- that the blind arm would red when the capability landed -- was wrong, and stating why is
// worth more than deleting it: the blind arm asserts that a `Conj` node carrying a callee atom is
// NOT a call, which was true before the repair and is true after it. What changed is not this
// arm's verdict but whether the live substrate can produce the other one. So the pair converts from
// the stall's control into the permanent regression control: it is what reds if a later marshal
// change quietly returns calls to a shape this lens cannot see.
//
// The callee spelling is `map_keys` because v2.lens.determinism's own header cites it as the
// order-leaking realization (v1_rt map_keys over im::HashMap on std RandomState), so the atom names
// a primitive the classifier genuinely refuses rather than an invented one.

fn shape_gap_callee_atom() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^map_keys } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

// The shape `node_is_call` accepts.
fn shape_gap_transform_shaped_call() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [ Edge { label: Positional, target: shape_gap_callee_atom() } ],
    occurrence_id: OccurrenceSynthetic
  }
}

// The shape the marshal emitted for EVERY fn-arrow body node before gunbc#10282, and which it now
// emits for every node that is not a named call.
fn shape_gap_conj_shaped_call() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: shape_gap_callee_atom() } ],
    occurrence_id: OccurrenceSynthetic
  }
}

test fn the_determinism_lens_fires_on_a_transform_shaped_call() -> Bool {
  length(xs: determinism_findings(root: shape_gap_transform_shaped_call())) > 0
}

test fn the_determinism_lens_is_blind_to_the_conj_shape_the_marshal_no_longer_emits() -> Bool {
  length(xs: determinism_findings(root: shape_gap_conj_shaped_call())) == 0
}

// ── fixtures ──────────────────────────────────────────────────────────────────────────────────

data fixture_modules: List<String> = ["fix.det.entry", "fix.det.reached", "fix.det.unreached"]

fn atom_node(lexeme: String) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: lexeme) } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

// A call node as node_is_call recognises one: a Transform whose first positional child is a
// callee reference.
fn call_node(callee: String) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [ Edge { label: Positional, target: atom_node(lexeme: callee) } ],
    occurrence_id: OccurrenceSynthetic
  }
}

// THE FIXTURE WAS ONCE FLATTENED TO MATCH THE READER, AND THAT IS NO LONGER EITHER TRUE OR
// REQUIRED. A first version of this fixture wrapped the callee atom one level deeper. Nothing was
// reachable, and BOTH discrimination rows below agreed for that reason rather than for the reason
// they claim: the leak-is-found row went red, and the leak-outside-the-graph row went green while
// proving nothing at all. That is the empty-fixture failure in miniature — two rows in apparent
// agreement, one shared wrong cause. The repair flattened the fixture and wrote down why:
// `call_reachable_decls` read callees from `decl.output` at DEPTH ONE, so a reachable callee had
// to be an atom child of the body root.
//
// THAT PREMISE IS DEAD AND THE READER IS WHAT CHANGED, not the fixture. `callees_from_node` now
// reads call carriers across the whole `decl.output` subtree, decided by execution over the live
// corpus rather than by this paragraph: the population that hid below the root is counted by
// v2.lens.fn_index_depth_agreement. So the accommodation is retired, and the
// nested rows at the end of this file are what hold the grain — they are RED against a depth-one
// reader, which is the control the flattened fixture could not carry. The class is filed as
// gunbc.recurring_failure_mode `fixture_flattened_to_the_reader_grain_it_should_falsify`.
//
// THE SEED BODY IS NOW THE CALL CARRIER ITSELF and this is the second correction of the same
// mistake in this fixture, in the opposite direction. It stood as a Conj root carrying a bare
// callee atom — a shape NO marshal produced, because the marshal spelled a call `Conj` while
// node_is_call demanded `ComputationNode { behavior: Transform }`, so nothing the corpus could hand
// these lenses was ever a call. The marshal now emits the carrier
// (v1.stage0.coproduct_reflection transform_record), which is what makes `call_node` below the
// shape of a real `fn seed() -> X { reached_fn(..) }` body rather than a shape invented to make the
// row pass. A LEAKING CALL two hops out is a call node nested under a body root, which
// determinism_findings reaches because it folds the whole subtree.

fn body_referencing(callee: String) -> Node {
  call_node(callee: callee)
}

fn body_invoking_primitive(primitive: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: call_node(callee: primitive) } ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn calling_decl(qualified_name: String, name: String, callee: String) -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: qualified_name,
    name: name,
    output: body_referencing(callee: callee),
    params: []
  }
}

fn primitive_decl(qualified_name: String, name: String, primitive: String) -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: qualified_name,
    name: name,
    output: body_invoking_primitive(primitive: primitive),
    params: []
  }
}

// `map_keys` carries HostUnspecifiedOrder in std.primitive_identity — the per-process hash seed
// makes its returned order not a function of its input. `sorted_map_keys` is the CanonicalOrder
// twin, so the pair discriminates the classification rather than merely the presence of a call.
data leaking_callee: String = "map_keys"
data deterministic_callee: String = "sorted_map_keys"
data no_terminal_callees: List<String> = []

test fn bare_atom_is_not_a_call_edge() -> Bool {
  length(xs: callees_from_node(
    node: shape_gap_conj_shaped_call(),
    terminal_callee_symbols: no_terminal_callees
  )) == 0
}

test fn callee_text_is_not_filtered_by_path_spelling() -> Bool {
  contains(
    xs: callees_from_node(
      node: call_node(callee: "src/fixture.dag"),
      terminal_callee_symbols: no_terminal_callees
    ),
    item: "src/fixture.dag",
    eq: fn(a, b) { a == b }
  )
}

// entry -> reached -> (leak). The leak is TWO HOPS from the entry and in a DIFFERENT module, which
// is exactly the shape the per-tree door cannot see.
fn decls_with_leak_reached() -> List<FnArrowDecl> {
  [
    calling_decl(qualified_name: "fix.det.entry.seed", name: "seed", callee: "reached_fn"),
    primitive_decl(qualified_name: "fix.det.reached.reached_fn", name: "reached_fn", primitive: leaking_callee),
    primitive_decl(qualified_name: "fix.det.unreached.orphan_fn", name: "orphan_fn", primitive: deterministic_callee)
  ]
}

// The SAME leak, moved to a declaration nothing calls. Reachability is the only thing that can
// tell these two populations apart.
fn decls_with_leak_unreached() -> List<FnArrowDecl> {
  [
    calling_decl(qualified_name: "fix.det.entry.seed", name: "seed", callee: "reached_fn"),
    primitive_decl(qualified_name: "fix.det.reached.reached_fn", name: "reached_fn", primitive: deterministic_callee),
    primitive_decl(qualified_name: "fix.det.unreached.orphan_fn", name: "orphan_fn", primitive: leaking_callee)
  ]
}

fn findings_over(decls: List<FnArrowDecl>) -> List<Diagnostic> {
  determinism_transitive_findings(
    entry_module: "fix.det.entry",
    closure_modules: fixture_modules,
    decls: decls
  )
}

// ── discriminating controls ───────────────────────────────────────────────────────────────────

// RED CONTROL. A leak two hops out, in another module, is FOUND. This is the state the per-tree
// door accepts today, so this row is the whole point of the transitive judgment.
test fn transitive_leak_in_reached_declaration_is_found() -> Bool {
  length(xs: findings_over(decls: decls_with_leak_reached())) > 0
}

// THE CONTROL THAT PROVES REACHABILITY IS LOAD-BEARING RATHER THAN DECORATIVE, and the one that
// would still be green if this consumer folded every declaration in the corpus instead of the
// reachable ones. Same leak, same fixture, same primitive — moved out of the call graph. A judgment
// that flagged it would be answering "does a leak exist anywhere" rather than "can this entry reach
// one", and the reachability authority would be doing no work.
test fn identical_leak_outside_the_call_graph_is_not_found() -> Bool {
  length(xs: findings_over(decls: decls_with_leak_unreached())) == 0
}

// POSITIVE CONTROL ON THE PLANT: the fixture shape itself is clean when the reached body calls the
// canonically-ordered twin, so the red above is caused by the CLASSIFICATION of the callee and not
// by the fixture merely containing a call node.
test fn deterministic_callee_in_the_same_shape_is_clean() -> Bool {
  determinism_transitive_holds(
    entry_module: "fix.det.entry",
    closure_modules: fixture_modules,
    decls: [
      calling_decl(qualified_name: "fix.det.entry.seed", name: "seed", callee: "reached_fn"),
      primitive_decl(qualified_name: "fix.det.reached.reached_fn", name: "reached_fn", primitive: deterministic_callee)
    ]
  )
}

// ── the nested-body grain: a depth-one reader is blind here ───────────────────────────────────

// A BLOCK BODY, BUILT FROM THE SAME CALL CARRIER THE SINGLE-CALL ROWS USE. `body_referencing` IS
// `call_node`, because a body that is one call marshals as the carrier itself; a `let`-block body
// is a Conj of statements with that carrier one level down, so the callee atom sits at depth two.
// Nesting `call_node` rather than inventing a second Conj is what keeps this row a claim about
// DEPTH: the two shapes differ only in the statement record between the root and the call.
fn nested_body_referencing(callee: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [ Edge { label: Positional, target: call_node(callee: callee) } ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn nested_calling_decl(qualified_name: String, name: String, callee: String) -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: qualified_name,
    name: name,
    output: nested_body_referencing(callee: callee),
    params: []
  }
}

// RED CONTROL AGAINST DEPTH ONE. The same two-hop cross-module leak as above, reached through an
// entry whose call sits one statement-record below its body root. A depth-one reader finds no
// callee on the entry at all, reaches nothing, and returns zero findings.
test fn leak_reached_through_a_nested_body_is_found() -> Bool {
  length(
    xs: findings_over(
      decls: [
        nested_calling_decl(qualified_name: "fix.det.entry.seed", name: "seed", callee: "reached_fn"),
        primitive_decl(qualified_name: "fix.det.reached.reached_fn", name: "reached_fn", primitive: leaking_callee),
        primitive_decl(qualified_name: "fix.det.unreached.orphan_fn", name: "orphan_fn", primitive: deterministic_callee)
      ]
    )
  ) > 0
}

// THE DISCRIMINATOR THAT KEEPS THE DEEPER READ FROM BECOMING "FOLD EVERYTHING". Same nested entry,
// leak moved out of the call graph. A transitive read of a declaration's OWN body must not become a
// transitive read of the corpus: this row is green only because reachability still decides.
test fn nested_entry_does_not_reach_a_leak_outside_the_call_graph() -> Bool {
  length(
    xs: findings_over(
      decls: [
        nested_calling_decl(qualified_name: "fix.det.entry.seed", name: "seed", callee: "reached_fn"),
        primitive_decl(qualified_name: "fix.det.reached.reached_fn", name: "reached_fn", primitive: deterministic_callee),
        primitive_decl(qualified_name: "fix.det.unreached.orphan_fn", name: "orphan_fn", primitive: leaking_callee)
      ]
    )
  ) == 0
}

// ── the call channel excludes atom senders by construction ───────────────────────────────────

// THE LOWER-RUNG PARAMETER EXCLUSION IS GONE, AND ITS EVIDENCE STAYS. The first declaration
// carries a parameter reference whose lexeme collides with a leaking declaration name. The second
// changes that occurrence into the producer's actual Transform call carrier. The pair differs in
// structural role, which is the fact callees_from_node now reads; parameter names and lexeme shape
// no longer participate in deciding whether an edge exists.
fn decl_with_param_reference(qualified_name: String, name: String, param: String) -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: qualified_name,
    name: name,
    output: Node {
      kind: TypeNode { connective: Conj },
      children: [ Edge { label: Positional, target: atom_node(lexeme: param) } ],
      occurrence_id: OccurrenceSynthetic
    },
    params: [ FnArrowParam { name: symbol_intern_lexeme(lexeme: param), node: atom_node(lexeme: param) } ]
  }
}

test fn a_parameter_reference_naming_a_declaration_is_not_a_call_edge() -> Bool {
  length(
    xs: findings_over(
      decls: [
        decl_with_param_reference(
          qualified_name: "fix.det.entry.seed",
          name: "seed",
          param: "orphan_fn"
        ),
        primitive_decl(qualified_name: "fix.det.unreached.orphan_fn", name: "orphan_fn", primitive: leaking_callee)
      ]
    )
  ) == 0
}

// POSITIVE CONTROL ON THE STRUCTURAL ROLE: the same callee lexeme in a real call position reaches
// the leak. A reader that rejects all colliding lexemes would make this row red.
test fn the_same_lexeme_in_call_position_is_a_call_edge() -> Bool {
  length(
    xs: findings_over(
      decls: [
        nested_calling_decl(
          qualified_name: "fix.det.entry.seed",
          name: "seed",
          callee: "orphan_fn"
        ),
        primitive_decl(qualified_name: "fix.det.unreached.orphan_fn", name: "orphan_fn", primitive: leaking_callee)
      ]
    )
  ) > 0
}
