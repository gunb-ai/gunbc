module v2.test.claim.enforcement.skeleton_application_read_witness

import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.algebra { any, contains, fold_list, length }
import v2.std.collection { List }
import v2.std.compilers.body_lowering {
  Application,
  ApplicationRefused,
  NotApplication,
  application_read
}
import v2.std.diagnostic { diagnostics_fatal_reason }
import v2.std.fn_index {
  FnArrowDecl,
  SkeletonApplicationFound,
  SkeletonApplicationRefused,
  SkeletonNotApplication,
  SkeletonOperand,
  SkeletonProjected,
  SkeletonUnprojected,
  callees_from_decl,
  fn_arrow_decl_facts_live,
  skeleton_application_read
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Node,
  NodeFold,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  fold_node
}
import v2.std.text { String, string_eq }

// THE TWO ROUTES OVER ONE SHAPE. A Transform whose operand is an empty Conj is residue on a lowered
// body -- application_read refuses it, located -- and is the marshal's "unprojected" in a fn-arrow
// skeleton, which v2.std.fn_index skeleton_application_read admits as SkeletonUnprojected only
// because it is handed the FnArrowDecl the node belongs to. The provenance is the input type,
// enforced by v2.lens.single_constructor (v2.test.claim.single_constructor_wall holds the red).
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn wall_atom(id: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: id } }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn empty_conj() -> Node {
  Node { kind: TypeNode { connective: Conj }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn call_with_empty_operand() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: wall_atom(id: ^skeleton_wall_callee) },
      Edge { label: Positional, target: empty_conj() }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn supplied_skeleton_decl(output: Node) -> FnArrowDecl {
  FnArrowDecl { qualified_name: "fix.skeleton_wall.decl", name: "decl", output: output, params: [] }
}

fn operands_are_exactly_one_unprojected(ops: List<SkeletonOperand>) -> Bool {
  length(xs: ops) == 1
    && any(xs: ops, predicate: fn(op) {
      match op {
        SkeletonUnprojected { at: _ } => true
        SkeletonProjected { node: _ } => false
      }
    })
}

// DISCRIMINATOR, body route: the empty Conj operand is refused as residue, never admitted.
test fn body_route_refuses_an_empty_conj_operand() -> Bool {
  match application_read(site: call_with_empty_operand()) {
    ApplicationRefused { diagnostics: d } => diagnostics_fatal_reason(d: d) == ^body_view_operand_residue
    Application { view: _ } => false
    NotApplication => false
  }
}

// The same Node through the skeleton route reads as a call with one uninspectable operand.
test fn skeleton_route_reads_an_empty_conj_operand_as_unprojected() -> Bool {
  let site = call_with_empty_operand()
  match skeleton_application_read(decl: supplied_skeleton_decl(output: site), site: site) {
    SkeletonApplicationFound { application: a } => operands_are_exactly_one_unprojected(ops: a.operands)
    SkeletonApplicationRefused { diagnostics: _ } => false
    SkeletonNotApplication => false
  }
}

// ---- THE INHABITANCE CLAIM, over a skeleton the real host marshal produced. ----

data skeleton_wall_subject_roots: List<String> = []

data skeleton_wall_subject_files: List<String> = [
  "src/v2/test/claim/enforcement/skeleton_application_fixture.dag"
]

data skeleton_wall_no_terminal_callees: List<String> = []

fn skeleton_wall_caller_decls() -> List<FnArrowDecl> {
  fold_list(
    xs: fn_arrow_decl_facts_live(pool_roots: skeleton_wall_subject_roots, pool_files: skeleton_wall_subject_files),
    empty: [],
    cons: fn(acc, decl) {
      if string_eq(a: decl.name, b: "skeleton_application_fixture_caller") { [decl] } else { acc }
    }
  )
}

fn decl_has_call_with_one_unprojected_operand(decl: FnArrowDecl) -> Bool {
  fold_node(
    n: decl.output,
    algebra: NodeFold {
      init: fn(n) {
        match skeleton_application_read(decl: decl, site: n) {
          SkeletonApplicationFound { application: a } => operands_are_exactly_one_unprojected(ops: a.operands)
          SkeletonApplicationRefused { diagnostics: _ } => false
          SkeletonNotApplication => false
        }
      },
      step: fn(acc, _edge, child) { acc || child }
    }
  )
}

// DISCRIMINATOR, skeleton route, REAL MARSHAL: `count(skeleton_application_fixture_rows)` reads as
// a call whose one operand is SkeletonUnprojected -- the data reference is unprojected -- and the
// call walk names the callee with no refusal. Through the body route the same operand refuses.
test fn a_real_skeleton_unprojected_positional_argument_reads_as_unprojected() -> Bool {
  let decls = skeleton_wall_caller_decls()
  length(xs: decls) == 1
    && any(xs: decls, predicate: fn(d) { decl_has_call_with_one_unprojected_operand(decl: d) })
}

test fn the_real_skeleton_call_walk_names_the_callee_without_refusal() -> Bool {
  let decls = skeleton_wall_caller_decls()
  length(xs: decls) == 1
    && any(xs: decls, predicate: fn(d) {
      let scan = callees_from_decl(decl: d, terminal_callee_symbols: skeleton_wall_no_terminal_callees)
      length(xs: scan.refusals) == 0
        && contains(xs: scan.texts, item: "count", eq: string_eq)
    })
}
