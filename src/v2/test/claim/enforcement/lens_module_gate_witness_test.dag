module v2.test.claim.enforcement.lens_module_gate_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data lens_module_gate_fixture_facts: List<v2.lens.module_graph.ModuleDeclarationFact> = [
  v2.lens.module_graph.ModuleDeclarationFact { module: "v2.lens.alpha_fixture", path: "src/v2/lens/alpha_fixture.dag" },
  v2.lens.module_graph.ModuleDeclarationFact { module: "v2.lens.synthetic_redundant_lens", path: "src/v2/lens/synthetic_redundant_lens.dag" }
]

data lens_module_gate_fixture_bound: List<String> = ["v2.lens.alpha_fixture"]

data lens_module_gate_fixture_surfaces: List<v2.lens.enforcement.lens_module_gate.LensInvariantSurface> = [
  v2.lens.enforcement.lens_module_gate.LensInvariantSurface {
    module: "v2.lens.alpha_fixture",
    projection: v2.lens.enforcement.lens_module_gate.ProjectionNodeDag,
    verdict_authority: v2.lens.enforcement.lens_module_gate.VerdictLensVerdict,
    remedy: v2.lens.enforcement.lens_module_gate.RemedyShare,
    admission: v2.lens.enforcement.lens_module_gate.GenuinelyNewInvariant
  },
  v2.lens.enforcement.lens_module_gate.LensInvariantSurface {
    module: "v2.lens.synthetic_redundant_lens",
    projection: v2.lens.enforcement.lens_module_gate.ProjectionNodeDag,
    verdict_authority: v2.lens.enforcement.lens_module_gate.VerdictLensVerdict,
    remedy: v2.lens.enforcement.lens_module_gate.RemedyShare,
    admission: v2.lens.enforcement.lens_module_gate.GenuinelyNewInvariant
  }
]

data lens_module_gate_genuinely_new_surface: List<v2.lens.enforcement.lens_module_gate.LensInvariantSurface> = [
  v2.lens.enforcement.lens_module_gate.LensInvariantSurface {
    module: "v2.lens.alpha_fixture",
    projection: v2.lens.enforcement.lens_module_gate.ProjectionNodeDag,
    verdict_authority: v2.lens.enforcement.lens_module_gate.VerdictVacuityEvidence,
    remedy: v2.lens.enforcement.lens_module_gate.RemedyIndependentOracle,
    admission: v2.lens.enforcement.lens_module_gate.GenuinelyNewInvariant
  }
]

test fn v2.workflow.enforcement_live.lens_closure_question_zero_holds_live() -> Bool {
  v2.workflow.enforcement_live.lens_closure_question_zero_holds_live()
}

test fn lens_module_gate_holds_live() -> Bool {
  v2.lens.enforcement.lens_module_gate.lens_module_gate_holds()
}

test fn red_control_unenrolled_lens_refused() -> Bool {
  v2.lens.enforcement.lens_module_gate.lens_module_gate_unenrolled_count_from_facts(
    facts: lens_module_gate_fixture_facts,
    bound_module_paths: lens_module_gate_fixture_bound
  ) > 0
}

test fn red_control_redundant_verdict_remedy_refused() -> Bool {
  v2.lens.enforcement.lens_module_gate.lens_module_gate_redundant_blocking_count_from_surfaces(
    surfaces: lens_module_gate_fixture_surfaces
  ) > 0
}

test fn red_control_genuinely_new_distinct_surface_passes() -> Bool {
  v2.lens.enforcement.lens_module_gate.lens_module_gate_redundant_blocking_count_from_surfaces(
    surfaces: lens_module_gate_genuinely_new_surface
  ) == 0
}

test fn red_control_fully_authorized_fixture_clean() -> Bool {
  v2.lens.enforcement.lens_module_gate.lens_module_gate_unenrolled_count_from_facts(
    facts: lens_module_gate_fixture_facts,
    bound_module_paths: ["v2.lens.alpha_fixture", "v2.lens.synthetic_redundant_lens"]
  ) == 0
    && v2.lens.enforcement.lens_module_gate.lens_module_gate_unjustified_count_from_facts(
      facts: lens_module_gate_fixture_facts,
      surfaces: lens_module_gate_fixture_surfaces
    ) == 0
}

test fn question_zero_verdict_live_holds() -> Bool {
  let v = v2.lens.enforcement.gate.lens_closure_question_zero_verdict(
    intent: v2.lens.enforcement.standing_intent.standing_intent_lens_closure_question_zero,
    facts: [],
    bound_module_paths: v2.lens.registry.completeness.lens_registry_completeness_bound_module_paths(),
    surfaces: v2.lens.enforcement.lens_module_gate.lens_module_gate_surfaces()
  )
  v2.lens.enforcement.gate.question_zero_verdict_holds(v: v)
    && v2.lens.enforcement.gate.leg_holds(l: v.unenrolled)
    && v2.lens.enforcement.gate.leg_holds(l: v.unjustified)
    && v2.lens.enforcement.gate.leg_holds(l: v.redundant_claim)
    && v2.lens.enforcement.gate.leg_holds(l: v.audit_residue_counted)
}

test fn audit_residue_counted_for_known_pending_fork() -> Bool {
  v2.lens.enforcement.lens_module_gate.lens_module_gate_audit_residue_count_from_surfaces(surfaces: v2.lens.enforcement.lens_module_gate.lens_module_gate_surfaces()) > 0
}

test fn question_zero_fixture_redundant_leg_fails() -> Bool {
  v2.lens.enforcement.gate.leg_fails(
    l: v2.lens.enforcement.gate.lens_closure_question_zero_verdict(
      intent: v2.lens.enforcement.standing_intent.standing_intent_lens_closure_question_zero,
      facts: lens_module_gate_fixture_facts,
      bound_module_paths: lens_module_gate_fixture_bound,
      surfaces: lens_module_gate_fixture_surfaces
    ).redundant_claim
  )
}

test fn lens_closure_question_zero_live_matches_gate() -> Bool {
  v2.lens.enforcement.gate.lens_closure_question_zero_holds() == v2.lens.enforcement.lens_module_gate.lens_module_gate_blocking_holds()
}
