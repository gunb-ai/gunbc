module v2.test.claim.enforcement.unprojected_leaf_skeleton_witness

import v2.std.algebra { any, contains, fold_list, length }
import v2.std.collection { List }
import v2.std.compilers.body_lowering { node_is_unprojected_leaf }
import v2.std.fn_index { FnArrowDecl, callees_from_node, fn_arrow_decl_facts_live }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.node { Node, NodeFold, fold_node }
import v2.std.text { String, string_eq }

// THE INHABITANCE CLAIM FOR THE UNPROJECTED LEAF, OVER THE REAL MARSHAL. The interface claim in
// v2.test.claim.namespace_xl0.body_shape_contract supplies the leaf by hand; this one reads a
// skeleton v1_compiler.coproduct_reflection marshal_generic actually produced for
// `unprojected_leaf_fixture_callee(x: 1)` and asserts the ROUTE, not only the answer: the literal
// arrives as the typed opaque leaf, and the one call reader over skeletons
// (v2.std.fn_index callees_from_node, over application_read) names the callee with NO refusal.
// Re-emitting an empty Conj for the literal reds both halves: no leaf is found, and the call
// refuses as operand residue.
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data unprojected_leaf_subject_roots: List<String> = []

data unprojected_leaf_subject_files: List<String> = [
  "src/v2/test/claim/enforcement/unprojected_leaf_skeleton_fixture.dag"
]

data unprojected_leaf_no_terminal_callees: List<String> = []

fn unprojected_leaf_caller_decls() -> List<FnArrowDecl> {
  fold_list(
    xs: fn_arrow_decl_facts_live(
      pool_roots: unprojected_leaf_subject_roots,
      pool_files: unprojected_leaf_subject_files
    ),
    empty: [],
    cons: fn(acc, decl) {
      if string_eq(a: decl.name, b: "unprojected_leaf_fixture_caller") { [decl] } else { acc }
    }
  )
}

fn subtree_has_unprojected_leaf(root: Node) -> Bool {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(n) { node_is_unprojected_leaf(n: n) },
      step: fn(acc, _edge, child) { acc || child }
    }
  )
}

test fn the_real_skeleton_carries_the_literal_as_an_unprojected_leaf() -> Bool {
  let decls = unprojected_leaf_caller_decls()
  length(xs: decls) == 1
    && any(xs: decls, predicate: fn(d) { subtree_has_unprojected_leaf(root: d.output) })
}

test fn the_call_over_an_unprojected_argument_is_read_not_refused() -> Bool {
  let decls = unprojected_leaf_caller_decls()
  length(xs: decls) == 1
    && any(xs: decls, predicate: fn(d) {
      let scan = callees_from_node(node: d.output, terminal_callee_symbols: unprojected_leaf_no_terminal_callees)
      length(xs: scan.refusals) == 0
        && contains(xs: scan.texts, item: "unprojected_leaf_fixture_callee", eq: string_eq)
    })
}
