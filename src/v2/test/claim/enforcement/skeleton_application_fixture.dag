module v2.test.claim.enforcement.skeleton_application_fixture

import v2.std.collection { List }
import v2.std.integer { Int }

// The subject of v2.test.claim.enforcement.skeleton_application_read_witness.
//
// A POSITIONAL argument the host fn-arrow marshal does not project -- here a data reference, which
// is neither a parameter nor a variant value -- marshals to an empty Conj standing DIRECTLY in the
// call's operand slot. A NAMED argument does not: its wrapper node is projected, so the value's
// empty Conj sits one level down (`callee(x: 1)` gives Transform[callee, Conj[Conj[]]]) and the
// call's own operand is whole. That is why the subject calls positionally.
data skeleton_application_fixture_rows: List<Int> = []

fn skeleton_application_fixture_caller() -> Int = count(skeleton_application_fixture_rows)
