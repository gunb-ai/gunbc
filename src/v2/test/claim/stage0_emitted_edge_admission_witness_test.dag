module test.claim.stage0_emitted_edge_admission_witness

import std.types { Bool, List, String }
import v2.std.algebra { any }
import gunbc.rust_emitted_edge { rust_prelude_emitted_edges, semantic_source_reference_edge }
import gunbc.stage0_crate_partition_generated {
  GeneratedLayeredCoreCrate,
  GeneratedPartitionCrateRow,
  generated_partition_crate_rows
}
import gunbc.stage0_executable_assembly_generated {
  generated_host_shell_package_name,
  generated_host_shell_partition_dependencies
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.stage0_emitted_edge_admission {
  Stage0EmittedEdgesAdmitted,
  Stage0EmittedEdgesNotCovered,
  Stage0EmittedEdgesRefused,
  Stage0EmittedTreePackages,
  stage0_emitted_edge_admission,
  stage0_package_direct_dependencies,
  stage0_package_reach_table,
  stage0_package_reaches,
  stage0_emitted_edge_admission_refusal
}

// ── ONE ADMISSION, SUPPLIED EDGES, THE REAL PARTITION ROWS ────────────────────────────────────
//
// The subject is gunbc.stage0_emitted_edge_admission: given the edges the emitter returned and the
// host shell's module roster, does every edge land in a package its source crate reaches. The rows
// and package graph are the committed ones (gunbc.stage0_crate_partition_generated), so the module
// names below are real members of real crates: v1_rt in the runtime foundation, std_types in
// std-core, v1_compiler_infer in v1-infer. The edges are supplied, because the claim is about the
// admission, not about what one emission happened to produce. The real producer is exercised by the
// required generated-artifact phase, which runs this admission over the whole seed emission in
// required_regen_host compile_stage0 and refuses the regen on any arm but Admitted.

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn tree_packages(rows: List<GeneratedPartitionCrateRow>) -> Stage0EmittedTreePackages {
  Stage0EmittedTreePackages {
    rows: rows,
    host_shell_package_name: generated_host_shell_package_name,
    host_shell_dependencies: generated_host_shell_partition_dependencies
  }
}

fn committed_tree_packages() -> Stage0EmittedTreePackages {
  tree_packages(rows: generated_partition_crate_rows)
}

// RED: a foundation crate re-exports nothing, so an edge out of the runtime into v1-infer names a
// module its crate cannot see -- the E0432 a partition build would report, refused here by name.
test fn an_edge_out_of_the_foundation_into_a_higher_crate_is_refused() -> Bool {
  match stage0_emitted_edge_admission(
    edges: [semantic_source_reference_edge(from: "v1_rt", to_module: "v1_compiler_infer")],
    host_shell_modules: [],
    packages: committed_tree_packages()
  ) {
    Stage0EmittedEdgesRefused { crossings: crossings } =>
      (crossings |> count) == 1
        && crossings |> all(c =>
          c.from_module == "v1_rt"
            && c.to_module == "v1_compiler_infer"
            && c.from_package == "v1-stage0-runtime"
            && c.to_package == "v1-stage0-v1-infer")
    _ => false
  }
}

// RED, the direction that actually bites: a partition crate naming a host-shell module. The shell
// depends on the partition, never the reverse.
test fn an_edge_from_a_partition_crate_into_the_host_shell_is_refused() -> Bool {
  match stage0_emitted_edge_admission(
    edges: [semantic_source_reference_edge(from: "v1_compiler_infer", to_module: "cli_run")],
    host_shell_modules: ["cli_run"],
    packages: committed_tree_packages()
  ) {
    Stage0EmittedEdgesRefused { crossings: crossings } =>
      (crossings |> count) == 1
        && crossings |> all(c => c.from_package == "v1-stage0-v1-infer" && c.to_package == "v1-compiler")
    _ => false
  }
}

// CONTROL for both REDs: the same admission over edges down the layering admits. v1-infer reaches
// std-core through its facade, and the shell reaches v1-infer through its one dependency.
test fn edges_down_the_layering_are_admitted() -> Bool {
  match stage0_emitted_edge_admission(
    edges: [
      semantic_source_reference_edge(from: "v1_compiler_infer", to_module: "std_types"),
      semantic_source_reference_edge(from: "cli_run", to_module: "v1_compiler_infer"),
      semantic_source_reference_edge(from: "cli_run", to_module: "v1_rt")
    ],
    host_shell_modules: ["cli_run"],
    packages: committed_tree_packages()
  ) {
    Stage0EmittedEdgesAdmitted { edge_count: n } => n == 3
    _ => false
  }
}

// The emitter's own prelude rows, as the emitter produces them for a v1-infer module, admit: the
// runtime edge reaches the foundation and the facade edge names the crate root.
test fn the_emitter_prelude_rows_for_a_partition_module_are_admitted() -> Bool {
  match stage0_emitted_edge_admission(
    edges: rust_prelude_emitted_edges(module: "v1_compiler_infer"),
    host_shell_modules: [],
    packages: committed_tree_packages()
  ) {
    Stage0EmittedEdgesAdmitted { edge_count: _ } => true
    _ => false
  }
}

// NOT COVERED is its own arm: a module in neither a partition row nor the shell roster has no
// crate here, which is what emitting a closure other than the seed looks like. It never passes.
test fn a_module_outside_the_seed_is_not_covered_rather_than_admitted() -> Bool {
  match stage0_emitted_edge_admission(
    edges: [semantic_source_reference_edge(from: "fixture_closure_module", to_module: "std_types")],
    host_shell_modules: ["cli_run"],
    packages: committed_tree_packages()
  ) {
    Stage0EmittedEdgesNotCovered { uncovered: uncovered } =>
      (uncovered |> count) == 1
        && uncovered |> all(u => u.module == "fixture_closure_module" && u.edge_from == "fixture_closure_module")
    _ => false
  }
}

// The refusal the regen prints is located: it names both modules, both packages and the provenance.
test fn the_refusal_names_modules_packages_and_provenance() -> Bool {
  match stage0_emitted_edge_admission_refusal(
    outcome: stage0_emitted_edge_admission(
      edges: [semantic_source_reference_edge(from: "v1_rt", to_module: "v1_compiler_infer")],
      host_shell_modules: [],
      packages: committed_tree_packages()
    )
  ) {
    Present { value: message } =>
      string_contains(s: message, pattern: "v1_rt [v1-stage0-runtime] -> v1_compiler_infer [v1-stage0-v1-infer] (semantic-source-reference)")
    Absent => false
  }
}

// ── THE ROWS ARE THE EMITTED TREE'S, NOT THE BINARY'S ──────────────────────────────────────────
//
// The shape of every change that adds a seed module: the corpus being regenerated lists the module in
// a partition row, while the rows the asking binary was built with do not yet. The admission decides
// over the rows it is HANDED, so the same edge admits against the change's own partition and is not
// covered against its predecessor's. Both arms are asserted on one edge, so the claim establishes the
// route -- the supplied rows decide -- not only an answer.

fn rows_with_a_module_added(rows: List<GeneratedPartitionCrateRow>, package_name: String, module: String) -> List<GeneratedPartitionCrateRow> {
  rows |> map(row =>
    if row.package_name == package_name {
      GeneratedPartitionCrateRow {
        package_name: row.package_name,
        crate_dir: row.crate_dir,
        kind: row.kind,
        modules: row.modules |> concat([module]),
        reexport_packages: row.reexport_packages,
        carries_non_empty_wrappers: row.carries_non_empty_wrappers
      }
    } else {
      row
    }
  )
}

test fn a_module_added_to_the_supplied_partition_is_admitted_where_the_predecessor_rows_do_not_cover_it() -> Bool {
  let edge = semantic_source_reference_edge(from: "v1_compiler_infer", to_module: "fixture_added_std_core_module")
  let added = rows_with_a_module_added(rows: generated_partition_crate_rows, package_name: "v1-stage0-std-core", module: "fixture_added_std_core_module")
  let admitted_against_the_change = match stage0_emitted_edge_admission(edges: [edge], host_shell_modules: [], packages: tree_packages(rows: added)) {
    Stage0EmittedEdgesAdmitted { edge_count: n } => n == 1
    _ => false
  }
  let not_covered_against_the_predecessor = match stage0_emitted_edge_admission(edges: [edge], host_shell_modules: [], packages: committed_tree_packages()) {
    Stage0EmittedEdgesNotCovered { uncovered: uncovered } => uncovered |> all(u => u.module == "fixture_added_std_core_module")
    _ => false
  }
  admitted_against_the_change && not_covered_against_the_predecessor
}

// CONTROL: supplying the change's rows widens nothing. A module the change adds is still placed in its
// own crate and layered like any other -- an edge out of the foundation into it is refused as a
// crossing, and a module the change's rows do not list is still not covered.
test fn the_supplied_partition_still_refuses_crossings_and_uncovered_modules() -> Bool {
  let added = rows_with_a_module_added(rows: generated_partition_crate_rows, package_name: "v1-stage0-std-core", module: "fixture_added_std_core_module")
  let crossing_refused = match stage0_emitted_edge_admission(
    edges: [semantic_source_reference_edge(from: "v1_rt", to_module: "fixture_added_std_core_module")],
    host_shell_modules: [],
    packages: tree_packages(rows: added)
  ) {
    Stage0EmittedEdgesRefused { crossings: crossings } =>
      crossings |> all(c => c.from_package == "v1-stage0-runtime" && c.to_package == "v1-stage0-std-core")
    _ => false
  }
  let uncovered_refused = match stage0_emitted_edge_admission(
    edges: [semantic_source_reference_edge(from: "fixture_added_std_core_module", to_module: "fixture_module_no_row_lists")],
    host_shell_modules: [],
    packages: tree_packages(rows: added)
  ) {
    Stage0EmittedEdgesNotCovered { uncovered: uncovered } =>
      (uncovered |> count) == 1 && uncovered |> all(u => u.module == "fixture_module_no_row_lists")
    _ => false
  }
  crossing_refused && uncovered_refused
}

// THE EMIT-CORE ARM FOLLOWS THE SUPPLIED PACKAGE SET. The emit shell depends on EVERY module-bearing
// package of the set it sits in, so a change that adds a PACKAGE (not only a module) must widen the
// emit shell's edges in the change's own graph. Here the supplied set gains one layered package while
// the committed rows stay as they are: the emit shell's direct dependencies and reach include it
// against the supplied set and exclude it against the committed one -- so neither answer re-enters
// the rows compiled into the asker.
test fn the_emit_core_dependency_and_reach_follow_the_supplied_package_set() -> Bool {
  let added_package = "v1-stage0-fixture-added"
  let supplied = tree_packages(rows: generated_partition_crate_rows |> concat([GeneratedPartitionCrateRow {
    package_name: added_package,
    crate_dir: "src/v1/stage0_fixture_added",
    kind: GeneratedLayeredCoreCrate,
    modules: ["fixture_added_package_module"],
    reexport_packages: [],
    carries_non_empty_wrappers: false
  }]))
  let emit_core = "v1-stage0-emit-core"
  (stage0_package_direct_dependencies(package_name: emit_core, packages: supplied) |> any(p => p == added_package))
    && !(stage0_package_direct_dependencies(package_name: emit_core, packages: committed_tree_packages()) |> any(p => p == added_package))
    && stage0_package_reaches(reach: stage0_package_reach_table(packages: supplied), from_package: emit_core, to_package: added_package)
    && !stage0_package_reaches(reach: stage0_package_reach_table(packages: committed_tree_packages()), from_package: emit_core, to_package: added_package)
}
