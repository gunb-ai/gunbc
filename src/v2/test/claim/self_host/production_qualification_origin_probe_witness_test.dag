module v2.test.claim.self_host.production_qualification_origin_probe_witness_test

import v2.compiler.self_host.emitter_producer_provenance {
  SourceProduced,
  emission_qualification_eq
}
import v2.lens.production_qualification_origin_probe {
  FixtureDerived,
  UnknownOrigin,
  count_derived_fixture_origin_mint_sites,
  count_derived_mint_sites_with_origin,
  derived_sites_for_decl,
  direct_rust_door_inferred_tree_atom,
  direct_rust_door_target_model_callee,
  empty_site_list,
  mint_provenanced_callee,
  mint_written_callee,
  production_qualification_origin_eq,
  production_qualification_origin_probe_admission_holds_for_decls
}
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.fn_index { FnArrowDecl }
import v2.std.node { Atom, Conj, Edge, Node, Positional, TypeNode }
import v2.std.integer { Int }
import v2.test.claim.self_host.production_qualification_origin_probe_structural_fixture {
  structural_red_control_mint_site_qualified_name
}
import v2.std.algebra { any }
import v2.std.integer { int_eq }
import v2.std.logic { Bool }
import v2.std.text { String }

// Production-qualification origin PROBE witnesses (wise-ram-22 recut): per-PR discovery carries
// planted closed-subject checks only (DESIGN §5). Live fn_arrow_decl_facts_live() walks (admission,
// policy-oracle count, frontier RED probes) are long-lane in
// test/claim/long/production_qualification_origin_probe_witness_test.dag.

// Genuine module-graph edge into
// v2.test.claim.self_host.production_qualification_origin_probe_structural_fixture (inert-lens
// hygiene, DESIGN.md §6): long-lane witnesses reference the live probe only through probe lens
// helpers, not a compile-time import of the fixture module. This witness imports
// structural_red_control_mint_site_qualified_name so the test fixture stays reached by a discovered
// per-PR witness.

test fn witness_structural_fixture_module_reached_by_symbol_reference() -> Bool {
  string_contains(
    s: structural_red_control_mint_site_qualified_name,
    pattern: "structural_red_control_mint_site_probe"
  )
}

test fn witness_planted_fixture_origin_count_matches_oracle() -> Bool {
  int_eq(
    a: planted_fixture_origin_mint_site_count(),
    b: production_qualification_planted_fixture_origin_oracle_count
  )
}

test fn witness_structural_red_control_mint_site_discovered() -> Bool {
  any(
    xs: derived_sites_for_decl(
      sites: empty_site_list,
      decl: structural_red_control_planted_decl()
    ),
    predicate: fn(row) {
      row.qualified_name == structural_red_control_planted_qualified_name
        && emission_qualification_eq(
          left: row.qualification_axis,
          right: SourceProduced
        )
        && production_qualification_origin_eq(
          left: row.evidence_origin,
          right: FixtureDerived
        )
    }
  )
}

test fn witness_nested_fixture_marker_classifies_fixture_origin() -> Bool {
  any(
    xs: derived_sites_for_decl(
      sites: empty_site_list,
      decl: nested_fixture_marker_planted_decl()
    ),
    predicate: fn(row) {
      production_qualification_origin_eq(
        left: row.evidence_origin,
        right: FixtureDerived
      )
    }
  )
}

test fn witness_unknown_origin_red_control_refuses_admission() -> Bool {
  let planted_sites = derived_sites_for_decl(
    sites: empty_site_list,
    decl: unknown_origin_red_control_planted_decl()
  )
  (count_derived_mint_sites_with_origin(sites: planted_sites, origin: UnknownOrigin) > 0)
    && !production_qualification_origin_probe_admission_holds_for_decls(
      decls: [unknown_origin_red_control_planted_decl()]
    )
}

test fn witness_parameter_borne_fixture_mint_classifies_unknown_origin() -> Bool {
  any(
    xs: derived_sites_for_decl(
      sites: empty_site_list,
      decl: parameter_borne_fixture_mint_planted_decl()
    ),
    predicate: fn(row) {
      production_qualification_origin_eq(
        left: row.evidence_origin,
        right: UnknownOrigin
      )
    }
  )
}

test fn witness_target_without_fixture_tree_classifies_unknown_origin() -> Bool {
  any(
    xs: derived_sites_for_decl(
      sites: empty_site_list,
      decl: target_without_fixture_tree_red_control_planted_decl()
    ),
    predicate: fn(row) {
      production_qualification_origin_eq(
        left: row.evidence_origin,
        right: UnknownOrigin
      )
    }
  )
}

test fn witness_planted_fixture_origin_refuses_production_admission() -> Bool {
  !production_qualification_origin_probe_admission_holds_for_decls(
    decls: [structural_red_control_planted_decl()]
  )
}

// ---- The planted closed-subject declarations. ----
// They moved here from v2.lens.production_qualification_origin_probe when FnArrowDecl became a
// single-constructor type (v2.lens.single_constructor, MQ-2): a declaration may be constructed only
// by the host marshal, v2.std.fn_index or a witness, and these are witnesses' supplied inputs.

// Closed-subject oracle (DESIGN §5): structural_red_control_planted_decl carries exactly one FixtureDerived SourceProduced row by construction — independent of fn_arrow_decl_facts_live() population.
data production_qualification_planted_fixture_origin_oracle_count: Int = 1

// Live-scope policy (DESIGN §5, review 48255): G2 fn-arrow marshal does not yet surface mint
// callees on live fixture fns in the witness entry closure, so
// known_fixture_origin_mint_surface_count_in_scope() reads zero today — documented expectation, NOT
// an executing tree-copied equality oracle. Discriminating signal is the planted closed-subject
// oracle (production_qualification_planted_fixture_origin_oracle_count). Frontier:
// witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds (explicit_witness_admission)
// expects live FixtureDerived discovery once marshal exposes callee atoms — greens when count > 0,
// then row deletes and a closed-subject expected population or monotone debt contract may enroll.

fn planted_fixture_origin_mint_site_count() -> Int {
  count_derived_fixture_origin_mint_sites(
    sites: derived_sites_for_decl(
      sites: empty_site_list,
      decl: structural_red_control_planted_decl()
    )
  )
}

fn probe_mint_callee_atom_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: mint_written_callee) } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn unknown_origin_red_control_planted_decl() -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: "synthetic.production_qualification_origin_probe.unknown_origin_red_control",
    name: "unknown_origin_red_control_planted_decl",
    output: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Positional, target: probe_mint_callee_atom_node() }
      ],
      occurrence_id: OccurrenceSynthetic
    },
    params: []
  }
}

data structural_red_control_planted_qualified_name: String = "synthetic.production_qualification_origin_probe.structural_red_control_planted"

fn probe_mint_provenanced_callee_atom_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: mint_provenanced_callee) } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn parameter_borne_fixture_mint_planted_decl() -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: "synthetic.production_qualification_origin_probe.parameter_borne_fixture_mint_red_control",
    name: "parameter_borne_fixture_mint_red_control_planted_decl",
    output: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Positional, target: probe_mint_provenanced_callee_atom_node() }
      ],
      occurrence_id: OccurrenceSynthetic
    },
    params: []
  }
}

fn probe_fixture_tree_atom_node() -> Node {
  Node {
    kind: TypeNode {
      connective: Atom {
        identity: symbol_intern_lexeme(lexeme: direct_rust_door_inferred_tree_atom)
      }
    },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn probe_target_model_callee_atom_node() -> Node {
  Node {
    kind: TypeNode {
      connective: Atom {
        identity: symbol_intern_lexeme(lexeme: direct_rust_door_target_model_callee)
      }
    },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn structural_red_control_planted_decl() -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: structural_red_control_planted_qualified_name,
    name: "structural_red_control_planted_decl",
    output: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Positional, target: probe_mint_callee_atom_node() },
        Edge { label: Positional, target: probe_fixture_tree_atom_node() }
      ],
      occurrence_id: OccurrenceSynthetic
    },
    params: []
  }
}

// A declaration root is not a node-walk step: the marker in a marshalled block body can sit below
// an immediate statement record. This control keeps decl_contains_atom on the whole-subtree reader;
// atom_identities_in_node sees the mint at depth one but misses this fixture marker at depth two.
fn nested_fixture_marker_planted_decl() -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: "synthetic.production_qualification_origin_probe.nested_fixture_marker",
    name: "nested_fixture_marker_planted_decl",
    output: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Positional, target: probe_mint_callee_atom_node() },
        Edge {
          label: Positional,
          target: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge { label: Positional, target: probe_fixture_tree_atom_node() }
            ],
            occurrence_id: OccurrenceSynthetic
          }
        }
      ],
      occurrence_id: OccurrenceSynthetic
    },
    params: []
  }
}

data target_without_fixture_tree_red_control_qualified_name: String = "synthetic.production_qualification_origin_probe.target_without_fixture_tree_red_control"

fn target_without_fixture_tree_red_control_planted_decl() -> FnArrowDecl {
  FnArrowDecl {
    qualified_name: target_without_fixture_tree_red_control_qualified_name,
    name: "target_without_fixture_tree_red_control_planted_decl",
    output: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge { label: Positional, target: probe_mint_callee_atom_node() },
        Edge { label: Positional, target: probe_target_model_callee_atom_node() }
      ],
      occurrence_id: OccurrenceSynthetic
    },
    params: []
  }
}
