module v2.test.claim.self_host.production_qualification_origin_probe_witness_test


data production_qualification_origin_probe_witness_note: String = "Production-qualification origin PROBE witnesses (wise-ram-22 recut): per-PR discovery carries planted closed-subject checks only (DESIGN §5). Live fn_arrow_decl_facts_live() walks (admission, policy-oracle count, frontier RED probes) are long-lane in test/claim/long/production_qualification_origin_probe_witness_test.dag."

data production_qualification_origin_probe_fixture_module_reach_note: String = "Genuine module-graph edge into v2.test.claim.self_host.production_qualification_origin_probe_structural_fixture (inert-lens hygiene, DESIGN.md §6): long-lane witnesses reference the live probe only through probe lens helpers, not a compile-time import of the fixture module. This witness imports structural_red_control_mint_site_qualified_name so the test fixture stays reached by a discovered per-PR witness."

test fn witness_structural_fixture_module_reached_by_symbol_reference() -> Bool {
  string_contains(
    s: v2.test.claim.self_host.production_qualification_origin_probe_structural_fixture.structural_red_control_mint_site_qualified_name,
    pattern: "structural_red_control_mint_site_probe"
  )
}

test fn witness_planted_fixture_origin_count_matches_oracle() -> Bool {
  v2.std.integer.int_eq(
    a: v2.lens.production_qualification_origin_probe.planted_fixture_origin_mint_site_count(),
    b: v2.lens.production_qualification_origin_probe.production_qualification_planted_fixture_origin_oracle_count
  )
}

test fn witness_structural_red_control_mint_site_discovered() -> Bool {
  v2.std.algebra.any(
    xs: v2.lens.production_qualification_origin_probe.derived_sites_for_decl(
      sites: v2.lens.production_qualification_origin_probe.empty_site_list,
      decl: v2.lens.production_qualification_origin_probe.structural_red_control_planted_decl()
    ),
    predicate: fn(row) {
      row.qualified_name == v2.lens.production_qualification_origin_probe.structural_red_control_planted_qualified_name
        && v2.compiler.self_host.emitter_producer_provenance.emission_qualification_eq(
          left: row.qualification_axis,
          right: v2.compiler.self_host.emitter_producer_provenance.SourceProduced
        )
        && v2.lens.production_qualification_origin_probe.production_qualification_origin_eq(
          left: row.evidence_origin,
          right: v2.lens.production_qualification_origin_probe.FixtureDerived
        )
    }
  )
}

test fn witness_unknown_origin_red_control_refuses_admission() -> Bool {
  let planted_sites = v2.lens.production_qualification_origin_probe.derived_sites_for_decl(
    sites: v2.lens.production_qualification_origin_probe.empty_site_list,
    decl: v2.lens.production_qualification_origin_probe.unknown_origin_red_control_planted_decl()
  )
  (v2.lens.production_qualification_origin_probe.count_derived_mint_sites_with_origin(sites: planted_sites, origin: v2.lens.production_qualification_origin_probe.UnknownOrigin) > 0)
    && !v2.lens.production_qualification_origin_probe.production_qualification_origin_probe_admission_holds_for_decls(
      decls: [v2.lens.production_qualification_origin_probe.unknown_origin_red_control_planted_decl()]
    )
}

test fn witness_parameter_borne_fixture_mint_classifies_unknown_origin() -> Bool {
  v2.std.algebra.any(
    xs: v2.lens.production_qualification_origin_probe.derived_sites_for_decl(
      sites: v2.lens.production_qualification_origin_probe.empty_site_list,
      decl: v2.lens.production_qualification_origin_probe.parameter_borne_fixture_mint_planted_decl()
    ),
    predicate: fn(row) {
      v2.lens.production_qualification_origin_probe.production_qualification_origin_eq(
        left: row.evidence_origin,
        right: v2.lens.production_qualification_origin_probe.UnknownOrigin
      )
    }
  )
}

test fn witness_target_without_fixture_tree_classifies_unknown_origin() -> Bool {
  v2.std.algebra.any(
    xs: v2.lens.production_qualification_origin_probe.derived_sites_for_decl(
      sites: v2.lens.production_qualification_origin_probe.empty_site_list,
      decl: v2.lens.production_qualification_origin_probe.target_without_fixture_tree_red_control_planted_decl()
    ),
    predicate: fn(row) {
      v2.lens.production_qualification_origin_probe.production_qualification_origin_eq(
        left: row.evidence_origin,
        right: v2.lens.production_qualification_origin_probe.UnknownOrigin
      )
    }
  )
}

test fn witness_planted_fixture_origin_refuses_production_admission() -> Bool {
  !v2.lens.production_qualification_origin_probe.production_qualification_origin_probe_admission_holds_for_decls(
    decls: [v2.lens.production_qualification_origin_probe.structural_red_control_planted_decl()]
  )
}
