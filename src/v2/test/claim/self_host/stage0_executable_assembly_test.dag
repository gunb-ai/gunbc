module v2.test.claim.self_host.stage0_executable_assembly_test

import v2.compiler.self_host.stage0_executable_assembly {
  BinaryEntrypointOwner,
  EmittedPartitionOwner,
  HostShellEmittedOwner,
  ModuleOwnedByNoSurface,
  ModuleOwnedByTwoPartitionPackages,
  ModuleOwnedByTwoSurfaces,
  RetainedHostOwner,
  RetainedModuleHasNoRetentionRow,
  Stage0AssemblyOwnershipRefusalCause,
  Stage0ExecutableModuleOwner,
  stage0_assembly_ownership_census,
  stage0_assembly_ownership_disjoint_and_total,
  stage0_host_shell_declared_modules,
  stage0_host_shell_emitted_owner_count,
  stage0_host_shell_partition_dependencies,
  stage0_live_assembly_ownership_census,
  stage0_live_partition_owned_module_basenames,
  stage0_live_retained_pub_mod_basenames
}
import v2.compiler.self_host.seed_retention_frontier {
  SeedRetentionFrontierRow,
  SeedRetainedIntrinsicSource,
  retained_reason_undeclared
}
import v2.workflow.rust_crate_partition {
  Stage0FoundationCrate,
  Stage0LayeredCoreCrate,
  Stage0PartitionCrateRow,
  stage0_module_bearing_crate_rows,
  stage0_unit_runtime,
  stage0_unit_std_core
}
import v2.std.algebra { any, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// THE WALL THE MONOLITH-MEMBERSHIP JOIN USED TO STAND IN FOR.
//
// While the host shell declared every emitted mirror, "is this module in lib.rs" was a usable
// proxy for "is this module compiled once", and
// v2.test.claim.stage0_partition_roster_layout_join asked it. It could only ever catch one
// direction -- a partition row naming a hand-retained file -- and after the partition cut the
// proxy is gone: a partition-owned module is now DELIBERATELY absent from the host shell's
// declarations, which is exactly the state the old question would have to admit. So the question
// this file asks is the one that survives the cut and is strictly stronger: is every module of
// the executable owned by exactly ONE admitted assembly surface.
//
// THE ORACLE IS A CONSTRUCTED WORLD, never the live tree. Each probe hands the census its own
// four-module population, its own partition rows, its own retained roster and its own retention
// rows, plants exactly one defect, and asserts that defect's arm alone. A live-corpus assertion
// would be an empty-set claim whose condition is absent -- green whether the census works or
// not -- so the live probe at the end is the regression control over the corpus and the fixtures
// are the evidence that a wall exists at all.

data probe_partition_rows: List<Stage0PartitionCrateRow> = [
  Stage0PartitionCrateRow {
    unit_id: stage0_unit_runtime,
    package_name: "probe-foundation",
    crate_dir: "src/v1/probe_foundation",
    kind: Stage0FoundationCrate,
    modules: ["probe_rt"],
    reexport_packages: [],
    carries_non_empty_wrappers: true
  },
  Stage0PartitionCrateRow {
    unit_id: stage0_unit_std_core,
    package_name: "probe-core",
    crate_dir: "src/v1/probe_core",
    kind: Stage0LayeredCoreCrate,
    modules: ["probe_types"],
    reexport_packages: ["probe-foundation"],
    carries_non_empty_wrappers: false
  }
]

data probe_retention_roster: List<SeedRetentionFrontierRow> = [
  retained_reason_undeclared(path: "src/probe_host.rs", cause: SeedRetainedIntrinsicSource)
]

data probe_emitted: List<String> = ["probe_rt", "probe_types", "probe_unpartitioned"]

data probe_retained: List<String> = ["probe_host"]

data probe_declared: List<String> = ["probe_rt", "probe_types", "probe_unpartitioned", "probe_host"]

fn probe_census_refusals(
  declared: List<String>,
  partition_rows: List<Stage0PartitionCrateRow>,
  emitted: List<String>,
  retained: List<String>,
  roster: List<SeedRetentionFrontierRow>
) -> List<Stage0AssemblyOwnershipRefusalCause> {
  stage0_assembly_ownership_census(
    declared_modules: declared,
    partition_rows: partition_rows,
    emitted_module_basenames: emitted,
    retained_pub_mod_basenames: retained,
    roster: roster
  ).refusals
}

// THE POSITIVE CONTROL. One module of each of the three module-grain arms, all resolved, no
// refusal. It is asserted at ARM grain and not by a count, because a count of four owners is
// equally satisfied by four modules landing in the wrong arms.
fn probe_owner_is_partitioned(owner: Stage0ExecutableModuleOwner, module_basename: String, package_name: String) -> Bool {
  match owner {
    EmittedPartitionOwner { module_basename: m, package_name: p } =>
      (m == module_basename) && (p == package_name)
    HostShellEmittedOwner { module_basename: _, host_package: _ } => false
    RetainedHostOwner { module_basename: _, host_package: _, retention_row: _ } => false
    BinaryEntrypointOwner { target: _, package_name: _ } => false
  }
}

fn probe_owner_is_host_shell_emitted(owner: Stage0ExecutableModuleOwner, module_basename: String) -> Bool {
  match owner {
    HostShellEmittedOwner { module_basename: m, host_package: _ } => m == module_basename
    EmittedPartitionOwner { module_basename: _, package_name: _ } => false
    RetainedHostOwner { module_basename: _, host_package: _, retention_row: _ } => false
    BinaryEntrypointOwner { target: _, package_name: _ } => false
  }
}

fn probe_owner_is_retained_host(owner: Stage0ExecutableModuleOwner, module_basename: String, retention_row: String) -> Bool {
  match owner {
    RetainedHostOwner { module_basename: m, host_package: _, retention_row: r } =>
      (m == module_basename) && (r == retention_row)
    EmittedPartitionOwner { module_basename: _, package_name: _ } => false
    HostShellEmittedOwner { module_basename: _, host_package: _ } => false
    BinaryEntrypointOwner { target: _, package_name: _ } => false
  }
}

test fn w_every_declared_module_lands_in_exactly_one_arm() -> Bool {
  let census = stage0_assembly_ownership_census(
    declared_modules: probe_declared,
    partition_rows: probe_partition_rows,
    emitted_module_basenames: probe_emitted,
    retained_pub_mod_basenames: probe_retained,
    roster: probe_retention_roster
  )
  let owners = census.owners
  (length(xs: census.refusals) == 0)
    && any(xs: owners, predicate: fn(o) { probe_owner_is_partitioned(owner: o, module_basename: "probe_rt", package_name: "probe-foundation") })
    && any(xs: owners, predicate: fn(o) { probe_owner_is_partitioned(owner: o, module_basename: "probe_types", package_name: "probe-core") })
    && any(xs: owners, predicate: fn(o) { probe_owner_is_host_shell_emitted(owner: o, module_basename: "probe_unpartitioned") })
    && any(xs: owners, predicate: fn(o) { probe_owner_is_retained_host(owner: o, module_basename: "probe_host", retention_row: "src/probe_host.rs") })
    && stage0_assembly_ownership_disjoint_and_total(
         declared_modules: probe_declared,
         partition_rows: probe_partition_rows,
         emitted_module_basenames: probe_emitted,
         retained_pub_mod_basenames: probe_retained,
         roster: probe_retention_roster
       )
}

// CONTROL: DUPLICATE OWNER REFUSES. A module the partition owns AND the host shell declares as a
// retained module is the exact state the cut exists to make unwritable -- one file compiled
// twice, so the second generation runs a compiler built from a second copy of its own bytes.
// The refusal names the module and both surfaces rather than counting.
fn refusal_is_two_surfaces(cause: Stage0AssemblyOwnershipRefusalCause, module_basename: String) -> Bool {
  match cause {
    ModuleOwnedByTwoSurfaces { module_basename: m, surfaces: s } =>
      (m == module_basename) && (length(xs: s) == 2)
    ModuleOwnedByNoSurface { module_basename: _ } => false
    ModuleOwnedByTwoPartitionPackages { module_basename: _, packages: _ } => false
    RetainedModuleHasNoRetentionRow { module_basename: _ } => false
  }
}

test fn w_module_owned_by_partition_and_host_shell_refuses() -> Bool {
  let refusals = probe_census_refusals(
    declared: ["probe_types"],
    partition_rows: probe_partition_rows,
    emitted: probe_emitted,
    retained: ["probe_types"],
    roster: probe_retention_roster
  )
  (length(xs: refusals) == 1)
    && any(xs: refusals, predicate: fn(c) { refusal_is_two_surfaces(cause: c, module_basename: "probe_types") })
}

// CONTROL: MISSING OWNER REFUSES, and it refuses with the module named. There is no arm that
// answers "compile it in the shell anyway" -- widening here would put a module in the executable
// that no authority claims, which is the absorbing fallback wearing an ownership rule's name.
fn refusal_is_no_surface(cause: Stage0AssemblyOwnershipRefusalCause, module_basename: String) -> Bool {
  match cause {
    ModuleOwnedByNoSurface { module_basename: m } => m == module_basename
    ModuleOwnedByTwoSurfaces { module_basename: _, surfaces: _ } => false
    ModuleOwnedByTwoPartitionPackages { module_basename: _, packages: _ } => false
    RetainedModuleHasNoRetentionRow { module_basename: _ } => false
  }
}

test fn w_module_owned_by_no_surface_refuses() -> Bool {
  let refusals = probe_census_refusals(
    declared: ["probe_orphan"],
    partition_rows: probe_partition_rows,
    emitted: probe_emitted,
    retained: probe_retained,
    roster: probe_retention_roster
  )
  (length(xs: refusals) == 1)
    && any(xs: refusals, predicate: fn(c) { refusal_is_no_surface(cause: c, module_basename: "probe_orphan") })
}

// CONTROL: TWO PARTITION PACKAGES REFUSE. The emit path's owner lookup folds a multi-row match
// down to the first because a duplicated pub mod fails to compile there; an ASSEMBLY census has
// no such backstop, so it must refuse rather than pick.
fn refusal_is_two_packages(cause: Stage0AssemblyOwnershipRefusalCause, module_basename: String) -> Bool {
  match cause {
    ModuleOwnedByTwoPartitionPackages { module_basename: m, packages: p } =>
      (m == module_basename) && (length(xs: p) == 2)
    ModuleOwnedByTwoSurfaces { module_basename: _, surfaces: _ } => false
    ModuleOwnedByNoSurface { module_basename: _ } => false
    RetainedModuleHasNoRetentionRow { module_basename: _ } => false
  }
}

data probe_duplicate_owner_rows: List<Stage0PartitionCrateRow> = [
  Stage0PartitionCrateRow {
    unit_id: stage0_unit_runtime,
    package_name: "probe-foundation",
    crate_dir: "src/v1/probe_foundation",
    kind: Stage0FoundationCrate,
    modules: ["probe_types"],
    reexport_packages: [],
    carries_non_empty_wrappers: true
  },
  Stage0PartitionCrateRow {
    unit_id: stage0_unit_std_core,
    package_name: "probe-core",
    crate_dir: "src/v1/probe_core",
    kind: Stage0LayeredCoreCrate,
    modules: ["probe_types"],
    reexport_packages: ["probe-foundation"],
    carries_non_empty_wrappers: false
  }
]

test fn w_module_owned_by_two_partition_packages_refuses() -> Bool {
  let refusals = probe_census_refusals(
    declared: ["probe_types"],
    partition_rows: probe_duplicate_owner_rows,
    emitted: probe_emitted,
    retained: [],
    roster: probe_retention_roster
  )
  (length(xs: refusals) == 1)
    && any(xs: refusals, predicate: fn(c) { refusal_is_two_packages(cause: c, module_basename: "probe_types") })
}

// CONTROL: PACKAGE MOVEMENT MAY NOT MASQUERADE AS RETIREMENT. A retained host module whose
// retention row has gone is refused rather than silently re-owned, so moving a hand-authored
// module between packages cannot delete the reason the seed keeps it.
fn refusal_is_missing_retention_row(cause: Stage0AssemblyOwnershipRefusalCause, module_basename: String) -> Bool {
  match cause {
    RetainedModuleHasNoRetentionRow { module_basename: m } => m == module_basename
    ModuleOwnedByTwoSurfaces { module_basename: _, surfaces: _ } => false
    ModuleOwnedByNoSurface { module_basename: _ } => false
    ModuleOwnedByTwoPartitionPackages { module_basename: _, packages: _ } => false
  }
}

test fn w_retained_module_without_a_retention_row_refuses() -> Bool {
  let refusals = probe_census_refusals(
    declared: ["probe_host"],
    partition_rows: probe_partition_rows,
    emitted: probe_emitted,
    retained: probe_retained,
    roster: []
  )
  (length(xs: refusals) == 1)
    && any(xs: refusals, predicate: fn(c) { refusal_is_missing_retention_row(cause: c, module_basename: "probe_host") })
}

// THE HOST SHELL'S DECLARATION SURFACE IS THE SUBTRACTION, which is what the lib.rs cut renders.
// A partition-owned module is absent from it and every other declared module survives, so a
// module moving into a partition crate leaves the shell in the same edit.
test fn w_host_shell_declares_exactly_what_the_partition_does_not_own() -> Bool {
  let shell = stage0_host_shell_declared_modules(
    declared_modules: probe_declared,
    partition_rows: probe_partition_rows
  )
  (length(xs: shell) == 2)
    && any(xs: shell, predicate: fn(m) { m == "probe_unpartitioned" })
    && any(xs: shell, predicate: fn(m) { m == "probe_host" })
    && !any(xs: shell, predicate: fn(m) { m == "probe_types" })
    && !any(xs: shell, predicate: fn(m) { m == "probe_rt" })
}

// THE LIVE REGRESSION CONTROL. No module the partition owns is also a retained pub-mod basename
// of the host shell. This is the corpus-side half of the duplicate-owner refusal above: the
// fixture proves the detector fires, this proves the live rosters do not trip it.
test fn w_live_partition_and_retained_surfaces_are_disjoint() -> Bool {
  let partitioned = stage0_live_partition_owned_module_basenames()
  let retained = stage0_live_retained_pub_mod_basenames()
  !any(xs: partitioned, predicate: fn(p) {
    any(xs: retained, predicate: fn(r) { r == p })
  })
}

// The live two-surface flip for v1.compiler.compiler_tests_rust. Partition ownership alone is
// insufficient: the same path may still be declared by the host shell, which Rust permits when
// the declarations live in separate crates. The executable-assembly census ranges over both
// surfaces, requires the emitted mirror to resolve as a partition owner, and requires the shell
// subtraction to remove it. The singleton makes the residue delta observable directly: this
// identity contributes zero HostShellEmittedOwner rows after the move, where it contributed one
// before the partition row landed.
test fn w_compiler_tests_rust_moves_from_host_shell_to_one_partition_surface() -> Bool {
  let module_basename = "v1_compiler_compiler_tests_rust"
  let census = stage0_live_assembly_ownership_census(
    declared_modules: [module_basename],
    emitted_module_basenames: [module_basename]
  )
  (length(xs: census.refusals) == 0)
    && (length(xs: census.owners) == 1)
    && any(xs: census.owners, predicate: fn(owner) {
      match owner {
        EmittedPartitionOwner { module_basename: m, package_name: p } =>
          (m == module_basename) && (p == "v1-stage0-v1-infer")
        HostShellEmittedOwner { module_basename: _, host_package: _ } => false
        RetainedHostOwner { module_basename: _, host_package: _, retention_row: _ } => false
        BinaryEntrypointOwner { target: _, package_name: _ } => false
      }
    })
    && (stage0_host_shell_emitted_owner_count(census: census) == 0)
    && (length(xs: stage0_host_shell_declared_modules(
      declared_modules: [module_basename],
      partition_rows: stage0_module_bearing_crate_rows()
    )) == 0)
}

// The host shell links the partition through one declared edge, and it is the top module-bearing
// package rather than the emit shell. Asserted because the whole re-export chain -- and therefore
// whether a `crate::` path in a module that stayed still resolves -- rests on that one name.
test fn w_host_shell_links_the_top_module_bearing_package() -> Bool {
  (length(xs: stage0_host_shell_partition_dependencies) == 1)
    && any(xs: stage0_host_shell_partition_dependencies, predicate: fn(p) { p == "v1-stage0-v1-infer" })
}
