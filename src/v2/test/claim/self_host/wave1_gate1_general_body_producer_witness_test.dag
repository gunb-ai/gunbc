module v2.test.claim.self_host.wave1_gate1_general_body_producer_witness

import v2.compiler.body_producer {
  body_producer_pick_kw_false,
  body_producer_pick_kw_true
}
import v2.compiler.compile { always_required_lenses }
import v2.compiler.self_host.frontier {
  compiler_frontier_row_03_body_producer,
  compiler_frontier_row_03_normalize
}
import v2.std.algebra { length }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wave1_gate1_witness_note: String = "Wave 1 exit gate 1 fast-lane witness (compile-gate + roster): import-closure resolution of 03_body_producer and 03_normalize. Full ingest execution proofs (add Transform, classical_not Match via tokenize→parse_module→normalize) live in long/wave1_gate1_general_body_producer_witness_test.dag — those witnesses exceed the 5s per-PR discovery budget. A1 receipts (SymbolIndex domain parity, wrapper-retained frontier, scaffold deletion): self_host/wave1_gate1_a1_symbol_index_body_producer_witness_test.dag. Not proven here: Stage D MVP producer subsumption, frontier probe per-module receipts, or FLAG E dissolution of body_lowering_fold.dag."

test fn wave1_gate1_body_producer_modules_import_resolve_holds() -> Bool {
  (length(xs: always_required_lenses()) == 2)
    && (body_producer_pick_kw_true == ^dag_token_kw_true)
    && (body_producer_pick_kw_false == ^dag_token_kw_false)
    && (compiler_frontier_row_03_body_producer.module_path == "src/v2/compiler/03_body_producer.dag")
    && (compiler_frontier_row_03_normalize.module_path == "src/v2/compiler/03_normalize.dag")
}
