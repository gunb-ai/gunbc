module v2.test.claim.self_host.wave1_gate1_general_body_producer_witness

import v2.compiler.body_producer {
  body_producer_pick_kw_false,
  body_producer_pick_kw_true
}
import v2.compiler.compile { always_required_lenses }
import v2.compiler.self_host.frontier {
  compiler_frontier_row_03_body_producer,
  compiler_frontier_row_03_normalize
}
import v2.std.algebra { length }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.test.claim.body_lowering.wave1_gate1_normalize_add_helpers {
  wave1_gate1_normalized_add_resolves_holds,
  wave1_gate1_normalized_add_yields_arrow_transform_holds,
  wave1_gate1_resolved_add_arrow_holds
}
import v2.test.execution.emit_host_classical_not_ingested_equals_eval {
  ingested_classical_not_arrow_has_match_holds,
  ingested_classical_not_resolves_holds
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wave1_gate1_witness_note: String = "Wave 1 exit gate 1 verification (general body producer: real ingested fn bodies become substrate behaviors) by execution. Proven here: tokenize→parse_module→normalize lowers fn_decl to Arrow+Behavior (add: Transform body; classical_not: Match body) without the fixture-bound MVP producer bridge (produce_add_arrow_with_body_from_resolved / dag_grammar_production_fn_add flat-index table). Import-closure resolution of 03_body_producer and 03_normalize is compile-gated. Not proven here: Stage D MVP producer subsumption, FLAG D binding-key re-grounding, frontier probe per-module receipts, or full grammar-row forward fold (FLAG E dissolution of body_lowering_fold.dag)."

test fn wave1_gate1_ingested_add_normalize_yields_arrow_transform_holds() -> Bool {
  wave1_gate1_normalized_add_yields_arrow_transform_holds()
}

test fn wave1_gate1_ingested_add_normalize_resolves_holds() -> Bool {
  wave1_gate1_normalized_add_resolves_holds()
}

test fn wave1_gate1_ingested_add_resolved_arrow_transform_holds() -> Bool {
  wave1_gate1_resolved_add_arrow_holds()
}

test fn wave1_gate1_ingested_match_normalize_yields_match_holds() -> Bool {
  ingested_classical_not_arrow_has_match_holds()
}

test fn wave1_gate1_ingested_match_resolves_holds() -> Bool {
  ingested_classical_not_resolves_holds()
}

test fn wave1_gate1_body_producer_modules_import_resolve_holds() -> Bool {
  (length(xs: always_required_lenses()) == 2)
    && (body_producer_pick_kw_true == ^dag_token_kw_true)
    && (body_producer_pick_kw_false == ^dag_token_kw_false)
    && (compiler_frontier_row_03_body_producer.module_path == "src/v2/compiler/03_body_producer.dag")
    && (compiler_frontier_row_03_normalize.module_path == "src/v2/compiler/03_normalize.dag")
}
