module v2.test.claim.self_host.regen_bootstrap_population

// Behavioral claims for v2.workflow.regen_bootstrap_population: every classification branch,
// every refusal arm, admit in both verdicts, and the module-sealed BootstrapPopulation through
// its accessors (including the carried classified list). These are UNEXECUTED EXPECTATIONS:
// nothing here has been built or run, and a verdict like TransitionNoop is a decision about
// observed object ids only — no filesystem behavior (mtime, write, restore) is observed or
// asserted. Registration is source-root discovery under src/v2/test/claim/self_host/
// (dag/gunbc/ci/ci_layer_roots.dag); the claims are pure, so no effect admission applies.
// The precedence reconciliation is pinned by
// w_both_executable_refuses_unsupported_not_mode_transition; the law itself is encoded in
// classify_bootstrap_path_transition (not restated here).

import std.types { String, Bool, FilePath, List }
import std.algebra { Cons, Empty, fold_list, length }
import std.content_hash { Sha1Digest, Sha1DigestHex }
import std.optional { Optional, Present, Absent, optional_absent, optional_present }
import extdeps.git.object_store {
  GitObjectId,
  GitSha1ObjectId,
  GitTreeEntryName,
  GitTreeEntryNameOctet,
  GitTreeEntryNameAfterSlashValue,
  TreeEntry,
  RegularBlobEntry,
  ExecutableBlobEntry,
  SymlinkEntry,
  SubtreeEntry,
  GitlinkEntry,
  git_sha1_object_id,
  git_object_id_eq,
}
import v2.workflow.regen_bootstrap_population {
  BootstrapCommitSubject,
  BootstrapPathVersion,
  BootstrapPathTransition,
  BootstrapPathTransitionClass,
  BootstrapPopulationRefusal,
  BootstrapPopulationAdmission,
  BootstrapPopulation,
  TransitionNoop,
  RestoreCandidate,
  InstallCandidate,
  TransitionRefused,
  UnsupportedTrackedEntry,
  ModeTransitionUnsupported,
  HeadOnlyPath,
  ProjectionAuthorityUnestablished,
  BootstrapAdmitted,
  BootstrapRefused,
  classify_bootstrap_path_transition,
  admit_bootstrap_population,
  bootstrap_population_selected,
  bootstrap_population_head,
  bootstrap_population_projection,
  bootstrap_population_transition_classes,
}

fn claim_tree_name(
  first: GitTreeEntryNameOctet,
  rest: List<GitTreeEntryNameOctet>,
) -> GitTreeEntryName {
  GitTreeEntryName { first: first, rest: rest }
}

fn claim_name_octet_after_slash(
  value: GitTreeEntryNameAfterSlashValue,
) -> GitTreeEntryNameOctet {
  GitTreeEntryNameOctetAfterSlash { value: value }
}

// Fixture ids are constructed only through git_sha1_object_id (review 45376). The Absent arm
// below is unreachable for pinned lowercase-hex-40 literals; it exists only because data
// initializers require a total GitObjectId. The fallback is the empty-tree sha1, distinct from
// every fixture oid below, so a fallback collision can never silently equal a fixture.
fn claim_sha1(hex: String) -> GitObjectId {
  match git_sha1_object_id(hex: hex) {
    Present { value: oid } => oid
    Absent =>
      GitSha1ObjectId {
        digest: Sha1Digest {
          hex: "4b825dc642cb6eb9a060e54bf8d69288fbee4904" as Sha1DigestHex,
        },
      }
  }
}

data name_regular: GitTreeEntryName = claim_tree_name(
  first: claim_name_octet_after_slash(value: 114),
  rest: [101, 97, 100, 109, 101]
    |> map(value => claim_name_octet_after_slash(value: value)),
)
data name_executable: GitTreeEntryName = claim_tree_name(
  first: claim_name_octet_after_slash(value: 114),
  rest: [117, 110]
    |> map(value => claim_name_octet_after_slash(value: value)),
)
data name_symlink: GitTreeEntryName = claim_tree_name(
  first: claim_name_octet_after_slash(value: 108),
  rest: [105, 110, 107]
    |> map(value => claim_name_octet_after_slash(value: value)),
)
data name_subtree: GitTreeEntryName = claim_tree_name(
  first: claim_name_octet_after_slash(value: 100),
  rest: [111, 99, 115]
    |> map(value => claim_name_octet_after_slash(value: value)),
)
data name_gitlink: GitTreeEntryName = claim_tree_name(
  first: claim_name_octet_after_slash(value: 109),
  rest: [111, 100]
    |> map(value => claim_name_octet_after_slash(value: value)),
)

data oid_a: GitObjectId = claim_sha1(hex: "1111111111111111111111111111111111111111")
data oid_b: GitObjectId = claim_sha1(hex: "2222222222222222222222222222222222222222")
data oid_c: GitObjectId = claim_sha1(hex: "3333333333333333333333333333333333333333")

data path_a: FilePath = "bootstrap/seed.txt"
data path_b: FilePath = "bootstrap/other.txt"

fn entry_regular(oid: GitObjectId) -> TreeEntry {
  RegularBlobEntry { name: name_regular, oid: oid }
}
fn entry_executable(oid: GitObjectId) -> TreeEntry {
  ExecutableBlobEntry { name: name_executable, oid: oid }
}
fn entry_symlink(oid: GitObjectId) -> TreeEntry {
  SymlinkEntry { name: name_symlink, oid: oid }
}
fn entry_subtree(oid: GitObjectId) -> TreeEntry {
  SubtreeEntry { name: name_subtree, oid: oid }
}
fn entry_gitlink(oid: GitObjectId) -> TreeEntry {
  GitlinkEntry { name: name_gitlink, oid: oid }
}

fn version_present(path: FilePath, entry: TreeEntry) -> BootstrapPathVersion {
  BootstrapPathVersion { path: path, entry: optional_present(value: entry) }
}
fn version_absent(path: FilePath) -> BootstrapPathVersion {
  BootstrapPathVersion { path: path, entry: optional_absent<TreeEntry>() }
}
fn transition_of(
  before: BootstrapPathVersion,
  during: BootstrapPathVersion,
) -> BootstrapPathTransition {
  BootstrapPathTransition { before: before, during: during }
}

fn class_tag(class: BootstrapPathTransitionClass) -> String {
  match class {
    TransitionNoop { path: _ } => "TransitionNoop"
    RestoreCandidate { path: _, before_oid: _, during_oid: _ } => "RestoreCandidate"
    InstallCandidate { path: _, during_oid: _ } => "InstallCandidate"
    TransitionRefused { path: _, cause: _ } => "TransitionRefused"
  }
}

fn refusal_tag(cause: BootstrapPopulationRefusal) -> String {
  match cause {
    UnsupportedTrackedEntry { path: _ } => "UnsupportedTrackedEntry"
    ModeTransitionUnsupported { path: _ } => "ModeTransitionUnsupported"
    HeadOnlyPath { path: _ } => "HeadOnlyPath"
    ProjectionAuthorityUnestablished { path: _ } => "ProjectionAuthorityUnestablished"
  }
}

fn class_refusal_tag(class: BootstrapPathTransitionClass) -> String {
  match class {
    TransitionRefused { path: _, cause: cause } => refusal_tag(cause: cause)
    _ => ""
  }
}

fn admission_tag(admission: BootstrapPopulationAdmission) -> String {
  match admission {
    BootstrapAdmitted { population: _ } => "BootstrapAdmitted"
    BootstrapRefused { cause: _ } => "BootstrapRefused"
  }
}

fn admission_refusal_tag(admission: BootstrapPopulationAdmission) -> String {
  match admission {
    BootstrapRefused { cause: cause } => refusal_tag(cause: cause)
    _ => ""
  }
}

fn admitted_population(admission: BootstrapPopulationAdmission) -> Optional<BootstrapPopulation> {
  match admission {
    BootstrapAdmitted { population: population } => optional_present(value: population)
    BootstrapRefused { cause: _ } => optional_absent<BootstrapPopulation>()
  }
}

fn all_tags_equal(tags: List<String>, expected: String) -> Bool {
  fold_list(
    xs: tags,
    empty: true,
    cons: fn(acc: Bool, tag: String) { acc && tag == expected },
  )
}

// HEAD-present + BASE-absent refuses HeadOnlyPath.
test fn w_head_only_path_refuses() -> Bool {
  let class = classify_bootstrap_path_transition(
    transition: transition_of(
      before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      during: version_absent(path: path_a),
    ),
  )
  class_tag(class: class) == "TransitionRefused"
    && class_refusal_tag(class: class) == "HeadOnlyPath"
}

// BASE-only 100644 regular is an InstallCandidate carrying the BASE oid.
test fn w_base_only_regular_is_install_candidate() -> Bool {
  let class = classify_bootstrap_path_transition(
    transition: transition_of(
      before: version_absent(path: path_a),
      during: version_present(path: path_a, entry: entry_regular(oid: oid_c)),
    ),
  )
  class_tag(class: class) == "InstallCandidate"
    && match class {
      InstallCandidate { path: seen, during_oid: seen_oid } =>
        seen == path_a && git_object_id_eq(left: seen_oid, right: oid_c)
      _ => false
    }
}

// BASE-only executable refuses UnsupportedTrackedEntry (100644 required).
test fn w_base_only_executable_refuses_unsupported() -> Bool {
  let class = classify_bootstrap_path_transition(
    transition: transition_of(
      before: version_absent(path: path_a),
      during: version_present(path: path_a, entry: entry_executable(oid: oid_c)),
    ),
  )
  class_tag(class: class) == "TransitionRefused"
    && class_refusal_tag(class: class) == "UnsupportedTrackedEntry"
}

// Unsupported arms (symlink/subtree/gitlink) on EITHER side refuse UnsupportedTrackedEntry,
// covering each arm in each position.
test fn w_unsupported_arms_either_side_refuse() -> Bool {
  let cases = [
    transition_of(
      before: version_present(path: path_a, entry: entry_symlink(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_regular(oid: oid_b)),
    ),
    transition_of(
      before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_symlink(oid: oid_b)),
    ),
    transition_of(
      before: version_present(path: path_a, entry: entry_subtree(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_regular(oid: oid_b)),
    ),
    transition_of(
      before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_subtree(oid: oid_b)),
    ),
    transition_of(
      before: version_present(path: path_a, entry: entry_gitlink(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_regular(oid: oid_b)),
    ),
    transition_of(
      before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_gitlink(oid: oid_b)),
    ),
  ]
  all_tags_equal(
    tags: cases
      |> map(transition => class_refusal_tag(
        class: classify_bootstrap_path_transition(transition: transition),
      )),
    expected: "UnsupportedTrackedEntry",
  )
}

// A 100644-vs-100755 pairing of regular arms is the mode transition, both directions.
test fn w_regular_executable_pairing_is_mode_transition() -> Bool {
  let cases = [
    transition_of(
      before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_executable(oid: oid_b)),
    ),
    transition_of(
      before: version_present(path: path_a, entry: entry_executable(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_regular(oid: oid_b)),
    ),
  ]
  all_tags_equal(
    tags: cases
      |> map(transition => class_refusal_tag(
        class: classify_bootstrap_path_transition(transition: transition),
      )),
    expected: "ModeTransitionUnsupported",
  )
}

// Precedence discriminator: two 100755 executables are UNSUPPORTED tracked entries, NOT a
// mode transition (review91903 branch-precedence reconciliation).
test fn w_both_executable_refuses_unsupported_not_mode_transition() -> Bool {
  let class = classify_bootstrap_path_transition(
    transition: transition_of(
      before: version_present(path: path_a, entry: entry_executable(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_executable(oid: oid_b)),
    ),
  )
  class_refusal_tag(class: class) == "UnsupportedTrackedEntry"
}

// Two 100644 regular files with EQUAL object ids decide Noop — a decision about observed ids
// only; it asserts nothing about filesystem behavior (no mtime, no write, no restore).
test fn w_both_regular_equal_oid_is_noop_decision() -> Bool {
  let class = classify_bootstrap_path_transition(
    transition: transition_of(
      before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
    ),
  )
  class_tag(class: class) == "TransitionNoop"
}

// Differing ids are a RestoreCandidate carrying BOTH observed ids.
test fn w_both_regular_differing_oid_is_restore_candidate() -> Bool {
  let class = classify_bootstrap_path_transition(
    transition: transition_of(
      before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      during: version_present(path: path_a, entry: entry_regular(oid: oid_b)),
    ),
  )
  class_tag(class: class) == "RestoreCandidate"
    && match class {
      RestoreCandidate { path: seen, before_oid: b, during_oid: d } =>
        seen == path_a
        && git_object_id_eq(left: b, right: oid_a)
        && git_object_id_eq(left: d, right: oid_b)
      _ => false
    }
}

// Degenerate transitions (both absent; mismatched paths) refuse
// ProjectionAuthorityUnestablished.
test fn w_projection_unestablished_refuses() -> Bool {
  let cases = [
    transition_of(
      before: version_absent(path: path_a),
      during: version_absent(path: path_a),
    ),
    transition_of(
      before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      during: version_present(path: path_b, entry: entry_regular(oid: oid_a)),
    ),
  ]
  all_tags_equal(
    tags: cases
      |> map(transition => class_refusal_tag(
        class: classify_bootstrap_path_transition(transition: transition),
      )),
    expected: "ProjectionAuthorityUnestablished",
  )
}

// Admission refuses with the LEFTMOST refusing transition's cause. The third fixture
// (symlink before, absent during) would classify HeadOnlyPath but is never observed because
// the leftmost refusal short-circuits.
test fn w_admission_refuses_on_leftmost_refusing_transition() -> Bool {
  let admission = admit_bootstrap_population(
    selected: BootstrapCommitSubject { commit: oid_a, tree: oid_b },
    head: BootstrapCommitSubject { commit: oid_c, tree: oid_c },
    projection: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
    transitions: [
      transition_of(
        before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
        during: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      ),
      transition_of(
        before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
        during: version_present(path: path_a, entry: entry_executable(oid: oid_b)),
      ),
      transition_of(
        before: version_present(path: path_a, entry: entry_symlink(oid: oid_a)),
        during: version_absent(path: path_a),
      ),
    ],
  )
  admission_tag(admission: admission) == "BootstrapRefused"
    && admission_refusal_tag(admission: admission) == "ModeTransitionUnsupported"
}

// Admission admits a clean population; the accessors bind the carried identities and the
// CERTIFIED classified list is carried (a consumer never re-classifies).
test fn w_admission_admits_clean_population_and_accessors_bind_inputs() -> Bool {
  let admission = admit_bootstrap_population(
    selected: BootstrapCommitSubject { commit: oid_a, tree: oid_b },
    head: BootstrapCommitSubject { commit: oid_c, tree: oid_c },
    projection: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
    transitions: [
      transition_of(
        before: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
        during: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
      ),
      transition_of(
        before: version_absent(path: path_b),
        during: version_present(path: path_b, entry: entry_regular(oid: oid_b)),
      ),
    ],
  )
  match admitted_population(admission: admission) {
    Present { value: population } =>
      git_object_id_eq(
        left: bootstrap_population_selected(population: population).commit,
        right: oid_a,
      )
      && git_object_id_eq(
        left: bootstrap_population_head(population: population).tree,
        right: oid_c,
      )
      && bootstrap_population_projection(population: population).path == path_a
      && match bootstrap_population_transition_classes(population: population) {
        // The certified list is carried in order: Noop then InstallCandidate.
        Cons { head: first, tail: Cons { head: second, tail: Empty } } =>
          class_tag(class: first) == "TransitionNoop"
          && class_tag(class: second) == "InstallCandidate"
        _ => false
      }
    Absent => false
  }
}

// Admission admits the empty transition list.
test fn w_admission_admits_empty_transitions() -> Bool {
  let admission = admit_bootstrap_population(
    selected: BootstrapCommitSubject { commit: oid_a, tree: oid_b },
    head: BootstrapCommitSubject { commit: oid_c, tree: oid_c },
    projection: version_present(path: path_a, entry: entry_regular(oid: oid_a)),
    transitions: [],
  )
  admission_tag(admission: admission) == "BootstrapAdmitted"
}

// An absent projection entry refuses admission with ProjectionAuthorityUnestablished.
test fn w_admission_refuses_absent_projection() -> Bool {
  let admission = admit_bootstrap_population(
    selected: BootstrapCommitSubject { commit: oid_a, tree: oid_b },
    head: BootstrapCommitSubject { commit: oid_c, tree: oid_c },
    projection: version_absent(path: path_a),
    transitions: [],
  )
  admission_tag(admission: admission) == "BootstrapRefused"
    && admission_refusal_tag(admission: admission) == "ProjectionAuthorityUnestablished"
}
