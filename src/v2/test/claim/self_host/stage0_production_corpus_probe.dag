module v2.test.claim.self_host.stage0_production_corpus_probe

import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
  ProvenancedRustEmissionObservation,
  observe_provenanced_rust_emission_from_ingest
}
import v2.compiler.self_host.stage0_production_target { stage0_production_target_model }
import v2.compiler.source_authority { SourceRef }
import v2.test.claim.self_host.stage0_subject_paths { subject_path_for_module }
import v2.compiler.source_authority_read {
  source_ref_for_observed_storage_path,
  source_root_ingest_from_source_refs
}
import std.algebra { Cons, Empty }
import std.types { Bool, Int }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_reason_lexemes }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }

// The v2-door walk of the single real cross-boundary i64 corpus subject, asserted by matching the
// door's OWN coproduct variants (single authority -- no re-encoded Int status codes, no legend that
// the tests would depend on for correctness).
//
// Subject: gunbc.rust_decl_type_overlay at dag/gunbc/rust_decl_type_overlay.dag -- the unique corpus
// module that is (a) a single top-level declaration, (b) carried by the seed crate v1-compiler, and
// (c) called across a module boundary carrying the crate's integer. It is named as the acceptance
// subject for the production flip by src/v2/compiler/self_host/stage0_boundary_add_probe.dag, and the
// carrier is #v2.compiler.self_host.stage0_production_target::stage0_production_target_model.
//
// Door: #v2.compiler.self_host.candidate_generation::observe_provenanced_rust_emission_from_ingest
// over the production ingest built by
// #v2.compiler.source_authority_read::source_root_ingest_from_source_refs, refs enumerated off disk
// (this subject imports nothing, so its ref closure is just the module). The ingest step is carried
// by the real #v2.std.diagnostic::Outcome sum, so a read/parse failure is reported as the ingest
// failure it is and never collapses into a fabricated empty ingest.

// Name is the authority; the path is DERIVED from it by the ONE shared production-rule
// derivation (v2.test.claim.self_host.stage0_subject_paths: module_file over
// repository_storage_layout, review 98522) -- no local root rule lives in this probe.

data subject_name: String = "gunbc.rust_decl_type_overlay"
data subject_path: String = subject_path_for_module(module_name: subject_name)

fn subject_refs() -> List<SourceRef> {
  Cons {
    head: source_ref_for_observed_storage_path(path: subject_path, source_root: DagTree),
    tail: Empty
  }
}

fn subject_admission() -> Admission {
  Admission {
    subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject_name) },
    imports: Empty
  }
}

fn corpus_count_refs(xs: List<SourceRef>) -> Int {
  match xs {
    Cons { tail: t } => 1 + corpus_count_refs(xs: t)
    Empty => 0
  }
}

fn corpus_ref_count() -> Int {
  corpus_count_refs(xs: subject_refs())
}

// The door's result, with the ingest build carried by the real Outcome sum: Accepted carries the door
// coproduct (AssemblyRejected | InferenceRejected | EmissionRejected | ProducerReceiptRejected |
// ArtifactProduced); Rejected means the ingest itself could not be built from the off-disk refs.
fn corpus_door() -> Outcome<ProvenancedRustEmissionObservation> {
  match source_root_ingest_from_source_refs(refs: subject_refs()) {
    Accepted { value: ingest, diagnostics: d } =>
      Accepted {
        value: observe_provenanced_rust_emission_from_ingest(
          ingest: ingest,
          admission: subject_admission(),
          target: stage0_production_target_model(),
          module_path: subject_path
        ),
        diagnostics: d
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

// ---- The expected outcome, asserted by matching the door's variants directly ----

// The row's POSITIVE done-condition claim (named by roadmap_authority.dag
// v2-core-emitter-lowers-conjunction-in-value-position::red_control, in the probe module's
// corpus_probes_<stage>_holds convention; the worker keeps this name). The row is done when this
// claim PASSES on gunbc.rust_decl_type_overlay, i.e. the door produces an artifact instead of
// refusing. It is RED at main today (the outer Conj is refused at emission with
// target_value_expr_reason_transform_shape_invalid); it goes green only when the body-expression
// lowering realizes the Conj (and the prefix-not operand) -- those src/v2 edits are the operator's
// ruling and are not in this PR. When it passes, corpus_probes_refused_at_emission_holds and
// corpus_probes_first_refusal_is_transform_shape_holds stop holding on this subject and are retired
// or inverted in the same (authorized) change; a refusal verdict alone is not the done condition.
test fn corpus_probes_emits_holds() -> Bool {
  match corpus_door() {
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => true
    _ => false
  }
}

// The door refuses the subject AT EMISSION (the EmissionRejected variant specifically, not assembly,
// not inference, not an ingest-build failure).
test fn corpus_probes_refused_at_emission_holds() -> Bool {
  match corpus_door() {
    Accepted { value: EmissionRejected { diagnostics: _ }, diagnostics: _ } => true
    _ => false
  }
}

// That emission refusal is the value-expression transform-shape refusal specifically -- discriminating:
// if the emitter ever produced the Conj body, or refused at a different stage or for a different
// reason, this goes red. corpus_reason() matches the door's variants to extract the reason lexeme.
test fn corpus_probes_first_refusal_is_transform_shape_holds() -> Bool {
  corpus_reason() == "target_value_expr_reason_transform_shape_invalid"
}

// The subject really reaches the door (it is not silently dropped): the production ingest is built
// from an off-disk ref (so corpus_door is Accepted, not an ingest-build Rejection), i.e. emission is
// the stage reached rather than a failure before it.
test fn corpus_probes_production_ingest_has_off_disk_refs() -> Bool {
  (corpus_ref_count() >= 1) &&
    match corpus_door() {
      Accepted { value: _, diagnostics: _ } => true
      Rejected { diagnostics: _ } => false
    }
}

// The refusal reason, for the run-link (matched off the same variants; never an Int legend).
fn corpus_reason() -> String {
  match corpus_door() {
    Accepted { value: EmissionRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: AssemblyRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: InferenceRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ProducerReceiptRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => "artifact-produced"
    Rejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
  }
}
