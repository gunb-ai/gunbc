module v2.test.claim.self_host.stage0_production_corpus_probe

import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
  observe_provenanced_rust_emission_from_ingest
}
import v2.compiler.self_host.stage0_production_target { stage0_production_target_model }
import v2.compiler.source_authority { SourceRef }
import v2.compiler.source_authority_read {
  source_ref_for_observed_storage_path,
  source_root_ingest_from_source_refs
}
import std.algebra { Cons, Empty }
import std.types { Bool, Int }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_reason_lexemes }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }

// The v2-door walk of the single real cross-boundary i64 corpus subject.
//
// Subject: gunbc.rust_decl_type_overlay at dag/gunbc/rust_decl_type_overlay.dag -- the unique corpus
// module that is (a) a single top-level declaration, (b) carried by the seed crate v1-compiler, and
// (c) called across a module boundary carrying the crate's integer (see
// #gunbc.instruments.stage0_boundary_add_probe::stage0_boundary_add_probe_subject and the carrier
// #v2.compiler.self_host.stage0_production_target::stage0_production_target_model).
//
// The door is #v2.compiler.self_host.candidate_generation::observe_provenanced_rust_emission_from_ingest
// over the production ingest built by
// #v2.compiler.source_authority_read::source_root_ingest_from_source_refs, with the module's source
// refs enumerated off disk (this subject imports nothing, so its ref closure is just the module).
//
// OUTCOME MODELLED AS DATA (one Int, never competing test fns over the same value):
//   0 artifact-produced, 1 assembly, 2 inference, 3 emission, 4 producer-receipt, 5 ingest-refused.
// The single expected outcome for this subject is 5-stage-clear-through-to-3: the door assembles and
// binds it and then REFUSES AT EMISSION because the stage0-production value-expression emitter
// refuses the Conj(&&) connective (see
// #v2.std.compilers.target_model::target_value_expr_project_atom_in_arrow_scope). The reason is
// target_value_expr_reason_transform_shape_invalid.

data subject_path: String = "dag/gunbc/rust_decl_type_overlay.dag"
data subject_name: String = "gunbc.rust_decl_type_overlay"

// One SourceRef per source file, enumerated off disk (the module + its transitive imports; this
// subject has none, so exactly one ref). Never a fabricated default.
fn subject_refs() -> List<SourceRef> {
  Cons {
    head: source_ref_for_observed_storage_path(path: subject_path, source_root: DagTree),
    tail: Empty
  }
}

fn subject_admission() -> Admission {
  Admission {
    subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject_name) },
    imports: Empty
  }
}

fn corpus_count_refs(xs: List<SourceRef>) -> Int {
  match xs {
    Cons { tail: t } => 1 + corpus_count_refs(xs: t)
    Empty => 0
  }
}

fn corpus_ref_count() -> Int {
  corpus_count_refs(xs: subject_refs())
}

// The walk, as data. An ingest refusal is its OWN stage (5) -- it never collapses to an empty ingest,
// so a read/parse failure of the subject is reported as the ingest failure it is, not misattributed
// to assembly/inference/emission.
fn corpus_walk_code() -> Int {
  match source_root_ingest_from_source_refs(refs: subject_refs()) {
    Rejected { diagnostics: _ } => 5
    Accepted { value: ingest, diagnostics: _ } =>
      match observe_provenanced_rust_emission_from_ingest(
        ingest: ingest,
        admission: subject_admission(),
        target: stage0_production_target_model(),
        module_path: subject_path
      ) {
        ArtifactProduced { artifact: _ } => 0
        AssemblyRejected { diagnostics: _ } => 1
        InferenceRejected { diagnostics: _ } => 2
        EmissionRejected { diagnostics: _ } => 3
        ProducerReceiptRejected { diagnostics: _ } => 4
      }
  }
}

fn corpus_reason() -> String {
  match source_root_ingest_from_source_refs(refs: subject_refs()) {
    Rejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ingest, diagnostics: _ } =>
      match observe_provenanced_rust_emission_from_ingest(
        ingest: ingest,
        admission: subject_admission(),
        target: stage0_production_target_model(),
        module_path: subject_path
      ) {
        EmissionRejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
        AssemblyRejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
        InferenceRejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
        ProducerReceiptRejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
        ArtifactProduced { artifact: _ } => "artifact-produced"
      }
  }
}

// ---- The single expected outcome, asserted as green witnesses (not competing arms) ----

// The subject is refused AT EMISSION (not assembly, not inference, not an ingest failure).
test fn corpus_probes_refused_at_emission_holds() -> Bool { corpus_walk_code() == 3 }

// The refusal is the value-expression transform-shape refusal specifically -- discriminating: if the
// emitter ever wrongly produced the Conj body (or failed at a different stage/reason), this goes red.
test fn corpus_probes_first_refusal_is_transform_shape_holds() -> Bool {
  corpus_reason() == "target_value_expr_reason_transform_shape_invalid"
}

// The subject really reaches the emitter (it is not silently dropped): the ingest is the production
// construction with an off-disk ref, and emission is reached (not refused before it).
test fn corpus_probes_production_ingest_has_off_disk_refs() -> Bool {
  (corpus_ref_count() >= 1) && (corpus_walk_code() != 5)
}

// POSITIVE CONTROL (discriminates "the door is broken" from "the door refuses this shape"): the door
// DOES emit operator bodies -- see #v2.test.claim.self_host.rust_module_emission_population, whose
// `x + y` specimen reaches ArtifactProduced through this same observe route. Together with
// corpus_probes_refused_at_emission_holds this shows the refusal is specific to the Conj connective,
// not a blanket door failure.
