module v2.test.claim.self_host.frontier_probe_empty_ingest


data frontier_probe_empty_ingest_test_note: String = "An empty ingest is the absence of a closure, not a closure containing nothing. Before this wall the probe answered ^resolve_module_not_found with cause MissingModuleIdentityUnavailable, so a survey row asserted the module was missing when its sources had never been supplied — the two states have different remedies and the plausible one was being reported. The measurement that found it: src/v2/compiler/03_resolve.dag needs 71 source reads against the manifest's 64-row inline cap, so the transport emits SourceRootManifestElided with produced_row_count 0 and an Empty ingest, and the probe answered anyway. These claims are fixtures over the empty ingest and cost milliseconds; the RED is the previous behavior, asserted directly — the refusal must NOT be the module-not-found reason, and it must land in the population-refused detail rather than any other arm."

fn empty_ingest() -> v2.compiler.source_authority.SourceRootIngest {
  std.algebra.Empty
}

fn empty_ingest_admission() -> v2.compiler.name_resolve.Admission {
  v2.compiler.name_resolve.Admission {
    subject: v2.compiler.name_resolve.ResolutionSubject {
      name: qualified_name_from_dotted_string(dotted: "v2.compiler.03_resolve")
    },
    imports: std.algebra.Empty
  }
}

fn empty_ingest_receipt() -> v2.compiler.self_host.frontier_probe_types.FrontierProbeReceipt {
  frontier_probe_emit_from_ingest(
    module_path: "src/v2/compiler/03_resolve.dag",
    ingest: empty_ingest(),
    admission: empty_ingest_admission()
  )
}

fn empty_ingest_detail_arm() -> v2.std.node.Symbol {
  match empty_ingest_receipt().detail {
    FrontierProbeClosurePopulationRefused { cause: c } => c
    FrontierProbeDetailAbsent => ^detail_absent
    MissingModule { requested: _ } => ^detail_missing_module
    SourceRootManifestElidedProbe { read_count: _, cap: _ } => ^detail_elided
    FrontierProbeCoverageRefused { coverage: _ } => ^detail_coverage_refused
    SourceRefReadRefused { source_ref: _, error: _ } => ^detail_read_refused
    SourceRefContentHashMismatch { source_ref: _, expected: _, observed: _ } =>
      ^detail_hash_mismatch
  }
}

test fn empty_ingest_refuses_rather_than_reporting_a_missing_module_holds() -> v2.std.logic.Bool {
  empty_ingest_receipt().located_reason != ^resolve_module_not_found
}

test fn empty_ingest_names_the_absent_closure_holds() -> v2.std.logic.Bool {
  empty_ingest_receipt().located_reason == ^frontier_probe_empty_ingest
}

test fn empty_ingest_refusal_lands_in_the_population_detail_holds() -> v2.std.logic.Bool {
  empty_ingest_detail_arm() == ^frontier_probe_empty_ingest
}

test fn empty_ingest_keeps_the_module_path_it_was_asked_about_holds() -> v2.std.logic.Bool {
  empty_ingest_receipt().module_path == "src/v2/compiler/03_resolve.dag"
}
