module v2.test.claim.self_host.frontier_probe_cause_location

import v2.compiler.parse_diagnostic {
  NonEmptyParseStageDiagnostics,
  parse_stage_diagnostic_from_diagnostic_only
}
import v2.compiler.self_host.frontier_probe_assemble_detail {
  assemble_rejection_cause_from_parse_stage
}
import v2.compiler.self_host.frontier_probe_types {
  AssembleMissingModule,
  CauseLocationTextual,
  CauseLocationUnavailable,
  GrammarChoiceOverlap,
  MaskedAssembleRefusal,
  MaskedAssembleRefusalWithoutEvidence,
  MissingModuleIdentityUnavailable,
  OtherAssembleRefusal
}
import std.algebra { Empty }
import v2.std.diagnostic {
  ByteRange,
  Diagnostic,
  Textual,
  Unavailable,
  UserInputBoundary,
  WholeFile,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

data frontier_probe_cause_location_test_note: String = "Discriminating controls for the cause-location field on OtherAssembleRefusal. The field exists because that arm is the catch-all: its reason symbol alone does not say WHICH file refused, and recovering the file previously meant lexing an entire closure by hand. These are FIXTURES, not a pipeline walk, so they cost milliseconds and stay per-PR affordable. The byte range is asserted exactly, not merely for presence: an implementation that preserved the file but substituted WholeFile would satisfy a presence check while destroying the position that makes the field worth carrying. The Unavailable arm is exercised too, because Locus admits NodeLocus and PortLocus, which have no manifest serialization — the projection must classify them rather than error, so one unrepresentable position cannot abort a whole survey."

data cause_location_probe_file: Symbol = ^cause_location_probe_file_symbol

fn textual_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^cause_location_probe_unclassified_reason,
    at: Textual {
      file: cause_location_probe_file,
      extent: ByteRange { start: 7, end: 9 }
    },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn node_locus_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^cause_location_probe_unclassified_reason,
    at: node_locus(node: Empty),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn cause_from(d: Diagnostic) -> Symbol {
  match assemble_rejection_cause_from_parse_stage(
    d: NonEmptyParseStageDiagnostics {
      head: parse_stage_diagnostic_from_diagnostic_only(d: d),
      tail: Empty
    }
  ) {
    GrammarChoiceOverlap { rows: _ } => ^not_other_refusal
    MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => ^not_other_refusal
    MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => ^not_other_refusal
    AssembleMissingModule { requested: _ } => ^not_other_refusal
    MissingModuleIdentityUnavailable => ^not_other_refusal
    OtherAssembleRefusal { reason: _, at: a } =>
      match a {
        CauseLocationTextual { file: f, extent: _ } => f
        CauseLocationUnavailable { reason: u } => u
      }
  }
}

fn textual_extent_start() -> Int {
  match assemble_rejection_cause_from_parse_stage(
    d: NonEmptyParseStageDiagnostics {
      head: parse_stage_diagnostic_from_diagnostic_only(d: textual_diagnostic()),
      tail: Empty
    }
  ) {
    GrammarChoiceOverlap { rows: _ } => 0 - 1
    MaskedAssembleRefusal { overlap_evidence: _, remaining_chain: _ } => 0 - 1
    MaskedAssembleRefusalWithoutEvidence { remaining_chain: _ } => 0 - 1
    AssembleMissingModule { requested: _ } => 0 - 1
    MissingModuleIdentityUnavailable => 0 - 1
    OtherAssembleRefusal { reason: _, at: a } =>
      match a {
        CauseLocationTextual { file: _, extent: e } =>
          match e {
            WholeFile => 0 - 2
            ByteRange { start: s, end: _ } => s
          }
        CauseLocationUnavailable { reason: _ } => 0 - 3
      }
  }
}

test fn textual_locus_preserves_the_file_holds() -> Bool {
  cause_from(d: textual_diagnostic()) == cause_location_probe_file
}

test fn textual_locus_preserves_the_exact_byte_range_holds() -> Bool {
  textual_extent_start() == 7
}

test fn node_locus_projects_to_unavailable_rather_than_erroring_holds() -> Bool {
  cause_from(d: node_locus_diagnostic()) == ^cause_location_node_locus_not_serializable
}
