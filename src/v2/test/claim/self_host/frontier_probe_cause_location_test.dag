module v2.test.claim.self_host.frontier_probe_cause_location


data frontier_probe_cause_location_test_note: String = "Discriminating controls for the refusal location on AssembleRejectionDetail. The location exists because a reason symbol alone does not say WHICH file refused: recovering that previously meant folding tokenize over an entire import closure by hand. These are FIXTURES, not a pipeline walk, so they cost milliseconds. The byte range is asserted EXACTLY rather than for presence — an implementation that kept the file but substituted WholeFile would pass a presence check while destroying the position that makes the field worth carrying, and that substitution is the executed RED for these claims. All three Locus arms are exercised: a port is real serializable data and keeps its symbol, and only a Node, which has no manifest rendering, reaches the not-serializable arm. A two-diagnostic control pins the PAIRING: with a second diagnostic carrying a different reason at a different position, the reason and the location must both come from the head, so neither field can be drawn from a diagnostic the other did not come from. The location is asserted on the DETAIL and never inside the cause, because a clustering key reads the cause and two modules refusing for the same reason at different positions are the same detailed cause."

fn detail_location_of(d: v2.std.diagnostic.Diagnostic) -> v2.std.node.Symbol {
  match v2.compiler.self_host.frontier_probe_assemble_detail.frontier_probe_assemble_detail_from_parse_stage(
    d: v2.compiler.parse_diagnostic.NonEmptyParseStageDiagnostics {
      head: v2.compiler.parse_diagnostic.parse_stage_diagnostic_from_diagnostic_only(d: d),
      tail: std.algebra.Empty
    }
  ) {
    v2.compiler.self_host.frontier_probe_types.NoFrontierProbeDetail => ^no_detail
    v2.compiler.self_host.frontier_probe_types.AssembleRejectionDetail { rejection_chain: _, cause: _, at: a } =>
      match a {
        v2.compiler.self_host.frontier_probe_types.CauseLocationTextual { file: _, extent: _ } => ^location_is_textual
        v2.compiler.self_host.frontier_probe_types.CauseLocationPort { port: p } => p
        v2.compiler.self_host.frontier_probe_types.CauseLocationNodeNotSerializable => ^location_is_node_not_serializable
      }
  }
}

fn textual_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cause_location_probe_unclassified_reason,
    at: v2.std.diagnostic.Textual {
      file: ^cause_location_probe_file_symbol,
      extent: v2.std.diagnostic.ByteRange { start: 7, end: 9 }
    },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn node_locus_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cause_location_probe_unclassified_reason,
    at: v2.std.diagnostic.node_locus(node: std.algebra.Empty),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn port_locus_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cause_location_probe_unclassified_reason,
    at: v2.std.diagnostic.port_locus(port: ^cause_location_probe_port),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn textual_extent_start() -> Int {
  match v2.compiler.self_host.frontier_probe_assemble_detail.frontier_probe_assemble_detail_from_parse_stage(
    d: v2.compiler.parse_diagnostic.NonEmptyParseStageDiagnostics {
      head: v2.compiler.parse_diagnostic.parse_stage_diagnostic_from_diagnostic_only(d: textual_diagnostic()),
      tail: std.algebra.Empty
    }
  ) {
    v2.compiler.self_host.frontier_probe_types.NoFrontierProbeDetail => 0 - 1
    v2.compiler.self_host.frontier_probe_types.AssembleRejectionDetail { rejection_chain: _, cause: _, at: a } =>
      match a {
        v2.compiler.self_host.frontier_probe_types.CauseLocationTextual { file: _, extent: e } =>
          match e {
            v2.std.diagnostic.WholeFile => 0 - 2
            v2.std.diagnostic.ByteRange { start: s, end: _ } => s
          }
        v2.compiler.self_host.frontier_probe_types.CauseLocationPort { port: _ } => 0 - 3
        v2.compiler.self_host.frontier_probe_types.CauseLocationNodeNotSerializable => 0 - 4
      }
  }
}

fn two_diagnostic_stage() -> v2.compiler.parse_diagnostic.NonEmptyParseStageDiagnostics {
  v2.compiler.parse_diagnostic.NonEmptyParseStageDiagnostics {
    head: v2.compiler.parse_diagnostic.parse_stage_diagnostic_from_diagnostic_only(d: textual_diagnostic()),
    tail: std.algebra.Cons {
      head: v2.compiler.parse_diagnostic.parse_stage_diagnostic_from_diagnostic_only(d: later_diagnostic()),
      tail: std.algebra.Empty
    }
  }
}

fn later_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^cause_location_probe_second_reason,
    at: v2.std.diagnostic.Textual {
      file: ^cause_location_probe_other_file_symbol,
      extent: v2.std.diagnostic.ByteRange { start: 99, end: 101 }
    },
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn paired_start_of_two() -> Int {
  match v2.compiler.self_host.frontier_probe_assemble_detail.frontier_probe_assemble_detail_from_parse_stage(d: two_diagnostic_stage()) {
    v2.compiler.self_host.frontier_probe_types.NoFrontierProbeDetail => 0 - 1
    v2.compiler.self_host.frontier_probe_types.AssembleRejectionDetail { rejection_chain: _, cause: _, at: a } =>
      match a {
        v2.compiler.self_host.frontier_probe_types.CauseLocationTextual { file: _, extent: e } =>
          match e {
            v2.std.diagnostic.WholeFile => 0 - 2
            v2.std.diagnostic.ByteRange { start: s, end: _ } => s
          }
        v2.compiler.self_host.frontier_probe_types.CauseLocationPort { port: _ } => 0 - 3
        v2.compiler.self_host.frontier_probe_types.CauseLocationNodeNotSerializable => 0 - 4
      }
  }
}

fn paired_reason_of_two() -> v2.std.node.Symbol {
  match v2.compiler.self_host.frontier_probe_assemble_detail.frontier_probe_assemble_detail_from_parse_stage(d: two_diagnostic_stage()) {
    v2.compiler.self_host.frontier_probe_types.NoFrontierProbeDetail => ^no_detail
    v2.compiler.self_host.frontier_probe_types.AssembleRejectionDetail { rejection_chain: c, cause: _, at: _ } =>
      match c {
        v2.compiler.self_host.frontier_probe_types.NonEmptySymbolChain { head: h, tail: _ } => h
      }
  }
}

test fn location_and_reason_are_drawn_from_the_same_diagnostic_holds() -> Bool {
  paired_start_of_two() == 7 && paired_reason_of_two() == ^cause_location_probe_unclassified_reason
}

test fn textual_locus_reaches_the_textual_arm_holds() -> Bool {
  detail_location_of(d: textual_diagnostic()) == ^location_is_textual
}

test fn textual_locus_preserves_the_exact_byte_range_holds() -> Bool {
  textual_extent_start() == 7
}

test fn port_locus_keeps_its_port_rather_than_degrading_holds() -> Bool {
  detail_location_of(d: port_locus_diagnostic()) == ^cause_location_probe_port
}

test fn node_locus_reaches_the_not_serializable_arm_holds() -> Bool {
  detail_location_of(d: node_locus_diagnostic()) == ^location_is_node_not_serializable
}
