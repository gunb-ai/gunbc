module v2.test.claim.self_host.frontier_probe_cause_location_roundtrip

import v2.compiler.self_host.frontier_probe_types {
  AssembleRejectionDetail,
  CauseLocationDeclaration,
  CauseLocationNodeNotSerializable,
  CauseLocationInvariantPort,
  CauseLocationSourcePort,
  CauseLocationTextual,
  NoFrontierProbeDetail
}
import v2.test.fixture.frontier_probe_cause_location_manifest_fixture {
  frontier_probe_cause_location_emitted_receipt
}
import v2.std.diagnostic { ByteRange, WholeFile }

// RELOAD half of the last survey receipt. #8344 deleted frontier_probe_survey, so this
// pair cannot re-prove that a live emitter writes this text. The fixture is that
// historical receipt with rejection_chain relabelled FreeSemigroup; these claims prove
// it still parses, typechecks, and carries the location. The mint that produces
// FreeSemigroup<Symbol> is exercised by
// v2.test.claim.self_host.frontier_probe_assemble_detail
// assemble_receipt_carries_the_whole_rejection_chain_and_its_fatal_cause.

fn roundtrip_extent_start() -> Int {
  match frontier_probe_cause_location_emitted_receipt.assemble_detail {
    NoFrontierProbeDetail => 0 - 1
    AssembleRejectionDetail { rejection_chain: _, cause: _, at: a } =>
      match a {
        CauseLocationTextual { file: _, extent: e } =>
          match e {
            WholeFile => 0 - 3
            ByteRange { start: s, end: _ } => s
          }
        CauseLocationSourcePort { port: _, file: _, extent: _ } => 0 - 4
        CauseLocationInvariantPort { port: _, invariant: _ } => 0 - 4
        CauseLocationDeclaration { declaration: _ } => 0 - 6
        CauseLocationNodeNotSerializable => 0 - 5
      }
  }
}

test fn emitted_manifest_reloads_with_its_location_intact_holds() -> Bool {
  roundtrip_extent_start() == 28138
}
