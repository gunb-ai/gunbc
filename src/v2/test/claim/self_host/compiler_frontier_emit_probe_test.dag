module v2.test.self_host.compiler_frontier_emit_probe

import v2.compiler.self_host.frontier_probe {
  EmitSurfaceGap,
  FrontierProbeReceipt,
  NameResolutionGap,
  RealizationGap,
  SelfEmitReady,
  UnclassifiedProbeReason,
  frontier_classify_rejection_reason,
  frontier_probe_emit_from_ingest
}
import v2.test.workflow.host_source_root_ingest_manifest {
  host_compiler_closure_admission,
  host_source_root_ingest
}
import v2.std.logic { Bool }

data frontier_probe_target_module_path: String = "src/v2/compiler/PROBE_ENTRY.dag"

fn frontier_module_emit_probe_receipt() -> FrontierProbeReceipt {
  frontier_probe_emit_from_ingest(
    module_path: frontier_probe_target_module_path,
    ingest: host_source_root_ingest,
    admission: host_compiler_closure_admission
  )
}

func frontier_module_emit_probe_accepts_holds() -> Bool {
  match frontier_module_emit_probe_receipt().blocker_class {
    SelfEmitReady => true
    _ => false
  }
}

func frontier_module_emit_probe_name_resolution_holds() -> Bool {
  match frontier_module_emit_probe_receipt().blocker_class {
    NameResolutionGap => true
    _ => false
  }
}

func frontier_module_emit_probe_emit_surface_holds() -> Bool {
  match frontier_module_emit_probe_receipt().blocker_class {
    EmitSurfaceGap => true
    _ => false
  }
}

func frontier_module_emit_probe_realization_holds() -> Bool {
  match frontier_module_emit_probe_receipt().blocker_class {
    RealizationGap => true
    _ => false
  }
}

func frontier_module_emit_probe_unclassified_holds() -> Bool {
  match frontier_module_emit_probe_receipt().blocker_class {
    UnclassifiedProbeReason { reason: _ } => true
    _ => false
  }
}

test fn frontier_classify_unlisted_reason_refuses_holds() -> Bool {
  match frontier_classify_rejection_reason(reason: ^frontier_probe_unlisted_reason_red_control) {
    UnclassifiedProbeReason { reason: reason } => reason == ^frontier_probe_unlisted_reason_red_control
    _ => false
  }
}
