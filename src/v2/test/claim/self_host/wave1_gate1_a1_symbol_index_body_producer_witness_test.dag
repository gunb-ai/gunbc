module v2.test.claim.self_host.wave1_gate1_a1_symbol_index_body_producer_witness

import v2.compiler.body_lowering_fold {
  body_lower_arrow_domain_binding_symbols,
  body_lower_arrow_domain_matches_frontend_symbol_index,
  body_lower_arrow_domain_matches_ingest_param_bindings,
  body_lower_find_captured,
  body_lower_fn_decl_ident_from_captured,
  body_lower_fn_decl_to_arrow,
  body_lower_outcome_frontier_disposition,
  body_lower_param_binding_symbols_from_fn_decl_module,
  body_lowering_domain_construction_disposition,
  body_lowering_interim_scaffold_seed_retained_count,
  BodyLoweringDomainParamListWalk,
  BodyLoweringDomainSymbolIndexResolved,
  BodyLoweringLowered,
  BodyLoweringWrapperRetained
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_language_model,
  ParseSubtreeFound
}
import v2.std.algebra { length }
import v2.std.collection { Absent, Optional, Present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Arrow, Atom, Node, TypeNode, node_synthetic }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wave1_gate1_a1_witness_note: String = "Wave 1 Gate 1 PR-A1 honest receipts: dag_fn_decl_param_binding_atoms deleted; scope_with_fn_decl_params dissolved; wrapper-retained frontier typed+counted; domain construction remains param-list-walk (BodyLoweringDomainParamListWalk) with SeedRetained frontier row (^migrate_when_fn_decl_ident_binding_terminal_lands) until fn_decl ident routes to binding_name_terminal and SymbolIndex carries module_qn.fn.param. Proven by execution: producer Arrow domain matches ingest param bindings independently extracted from parse tree (not self-filled); frontend SymbolIndex fill cannot yet resolve fn.param (discriminating RED control — flips when namespace lane lands fn-ident binding terminal); real-ingest normalize lowers; wrapper-retained RED on invalid shell."

data wave1_gate1_a1_add_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

fn wave1_gate1_a1_find_arrow_in_module(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => wave1_gate1_a1_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn wave1_gate1_a1_parsed_add_module() -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(
    text: wave1_gate1_a1_add_module_source,
    file: ^wave1_gate1_a1_add_probe_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } => Present { value: artifact.tree }
      }
  }
}

fn wave1_gate1_a1_normalized_add_module() -> Optional<Node> {
  match wave1_gate1_a1_parsed_add_module() {
    Absent => Absent
    Present { value: parsed } =>
      match normalize(parse_tree: parsed) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: tree, diagnostics: _ } => Present { value: tree }
      }
  }
}

fn wave1_gate1_a1_ingest_param_domain_parity_holds() -> Bool {
  match wave1_gate1_a1_parsed_add_module() {
    Absent => false
    Present { value: parsed } =>
      let ingest_bindings = body_lower_param_binding_symbols_from_fn_decl_module(root: parsed)
      match wave1_gate1_a1_normalized_add_module() {
        Absent => false
        Present { value: normalized } =>
          match wave1_gate1_a1_find_arrow_in_module(root: normalized) {
            Absent => false
            Present { value: arrow } =>
              body_lower_arrow_domain_matches_ingest_param_bindings(
                arrow: arrow,
                ingest_bindings: ingest_bindings
              )
          }
      }
  }
}

fn wave1_gate1_a1_domain_param_list_walk_holds() -> Bool {
  match wave1_gate1_a1_normalized_add_module() {
    Absent => false
    Present { value: tree } =>
      match wave1_gate1_a1_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          length(xs: body_lower_arrow_domain_binding_symbols(arrow: arrow)) == 2
      }
  }
}

fn wave1_gate1_a1_domain_construction_frontier_holds() -> Bool {
  match body_lowering_domain_construction_disposition {
    BodyLoweringDomainParamListWalk =>
      body_lowering_interim_scaffold_seed_retained_count() == 3
    BodyLoweringDomainSymbolIndexResolved => false
  }
}

fn wave1_gate1_a1_symbol_index_frontend_blocked_red_control_holds() -> Bool {
  match wave1_gate1_a1_parsed_add_module() {
    Absent => false
    Present { value: parsed } =>
      match body_lower_find_captured(root: parsed, emitted: ^dag_surface_fn_decl) {
        ParseSubtreeFound { captured: captured } =>
          match body_lower_fn_decl_ident_from_captured(captured: captured) {
            Absent => true
            Present { value: fn_name } =>
              match wave1_gate1_a1_normalized_add_module() {
                Absent => false
                Present { value: normalized } =>
                  match wave1_gate1_a1_find_arrow_in_module(root: normalized) {
                    Absent => false
                    Present { value: arrow } =>
                      !body_lower_arrow_domain_matches_frontend_symbol_index(
                        arrow: arrow,
                        module_tree: normalized,
                        fn_name: fn_name
                      )
                  }
              }
          }
        _ => false
      }
  }
}

fn wave1_gate1_a1_real_ingest_lowers_holds() -> Bool {
  match wave1_gate1_a1_normalized_add_module() {
    Absent => false
    Present { value: tree } =>
      match wave1_gate1_a1_find_arrow_in_module(root: tree) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

fn wave1_gate1_a1_wrapper_retained_red_control_holds() -> Bool {
  let shell = node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^wave1_gate1_a1_invalid_shell } },
    children: []
  )
  match body_lower_outcome_frontier_disposition(o: body_lower_fn_decl_to_arrow(shell: shell)) {
    BodyLoweringWrapperRetained { reason: r } => r == ^body_lowering_reason_wrapper_retained_emitted
    BodyLoweringLowered => false
  }
}

test fn wave1_gate1_a1_ingest_param_domain_parity_witness_holds() -> Bool {
  wave1_gate1_a1_ingest_param_domain_parity_holds()
}

test fn wave1_gate1_a1_domain_param_list_walk_witness_holds() -> Bool {
  wave1_gate1_a1_domain_param_list_walk_holds()
}

test fn wave1_gate1_a1_domain_construction_frontier_witness_holds() -> Bool {
  wave1_gate1_a1_domain_construction_frontier_holds()
}

test fn wave1_gate1_a1_symbol_index_frontend_blocked_red_control_witness_holds() -> Bool {
  wave1_gate1_a1_symbol_index_frontend_blocked_red_control_holds()
}

test fn wave1_gate1_a1_real_ingest_lowers_witness_holds() -> Bool {
  wave1_gate1_a1_real_ingest_lowers_holds()
}

test fn wave1_gate1_a1_wrapper_retained_red_control_witness_holds() -> Bool {
  wave1_gate1_a1_wrapper_retained_red_control_holds()
}
