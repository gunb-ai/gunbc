module v2.test.claim.self_host.wave1_gate1_a1_symbol_index_body_producer_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data wave1_gate1_a1_witness_note: String = "Wave 1 Gate 1 A1 fast-lane receipts (under 5s per-PR discovery budget): interim scaffold count pinned at 0 after Track B dissolution (body_producer_forward forward row table + body_lower_fold dispatch); forward behavior row count receipt; forward/fold surface-identity parity; match-spine identity-Absent dispatch parity. Full tokenize→parse_module→normalize execution proofs live in long/wave1_gate1_a1_symbol_index_body_producer_witness_test.dag."

fn wave1_gate1_a1_domain_construction_frontier_holds() -> Bool {
  v2.compiler.body_lowering_fold.body_lowering_interim_scaffold_seed_retained_count() == 0
}

fn wave1_gate1_a1_forward_behavior_row_count_holds() -> Bool {
  v2.compiler.body_lowering_fold.body_lowering_forward_behavior_row_count() == 6
}

fn wave1_gate1_a1_forward_fold_surface_identities_agree_holds() -> Bool {
  v2.compiler.body_lowering_fold.body_lowering_forward_fold_surface_identities_agree()
}

fn wave1_gate1_a1_match_spine_identity_absent_dispatch_holds() -> Bool {
  v2.compiler.body_lowering_fold.body_lowering_match_spine_identity_absent_sniff_holds()
    && v2.compiler.body_lowering_fold.body_lowering_match_spine_identity_absent_dispatch_holds()
}

fn wave1_gate1_a1_wrapper_retained_red_control_holds() -> Bool {
  let shell = v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^wave1_gate1_a1_invalid_shell } },
    children: []
  )
  match v2.compiler.body_lowering_fold.body_lower_outcome_frontier_disposition(o: v2.compiler.body_lowering_fold.body_lower_fn_decl_to_arrow(shell: shell)) {
    v2.compiler.body_lowering_fold.BodyLoweringWrapperRetained { reason: r } => r == ^body_lowering_reason_wrapper_retained_emitted
    v2.compiler.body_lowering_fold.BodyLoweringLowered => false
    v2.compiler.body_lowering_fold.BodyLoweringRejected { diagnostics: _ } => false
  }
}

test fn wave1_gate1_a1_domain_construction_frontier_witness_holds() -> Bool {
  wave1_gate1_a1_domain_construction_frontier_holds()
}

test fn wave1_gate1_a1_forward_behavior_row_count_witness_holds() -> Bool {
  wave1_gate1_a1_forward_behavior_row_count_holds()
}

test fn wave1_gate1_a1_forward_fold_surface_identities_agree_witness_holds() -> Bool {
  wave1_gate1_a1_forward_fold_surface_identities_agree_holds()
}

test fn wave1_gate1_a1_match_spine_identity_absent_dispatch_witness_holds() -> Bool {
  wave1_gate1_a1_match_spine_identity_absent_dispatch_holds()
}

test fn wave1_gate1_a1_wrapper_retained_red_control_witness_holds() -> Bool {
  wave1_gate1_a1_wrapper_retained_red_control_holds()
}
