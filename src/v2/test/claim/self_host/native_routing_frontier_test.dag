module v2.test.claim.self_host.native_routing_frontier_test

import v2.compiler.self_host.native_routing_frontier {
  native_routing_frontier_roster,
  native_routing_frontier_family_count_expected,
  native_routed_rows,
  interpreted_retained_rows,
  routing_frontier_row_for_family,
  routing_frontier_total_holds,
  routing_row_is_native
}
import v2.compiler.self_host.parity_window { parity_flip_permitted }
import v2.compiler.self_host.parity_receipts_local { meet_join_local_receipts, complement_local_receipts }
import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.text { String }

fn witness_roster_total_holds() -> Bool {
  routing_frontier_total_holds()
}

fn witness_each_family_has_exactly_one_row() -> Bool {
  fold(
    native_routing_frontier_roster,
    init: true,
    f: fn(acc, row) {
      acc && (length(xs: routing_frontier_row_for_family(family: row.family)) == 1)
    }
  )
}

fn witness_unlisted_family_has_no_row() -> Bool {
  length(xs: routing_frontier_row_for_family(family: "unlisted_synthetic_family")) == 0
}

fn witness_routed_and_retained_split() -> Bool {
  (length(xs: native_routed_rows()) == 0)
    && (length(xs: interpreted_retained_rows()) == 11)
}

fn witness_flips_cite_parity_evidence() -> Bool {
  parity_flip_permitted(family: "meet_join", receipts: meet_join_local_receipts())
    && parity_flip_permitted(family: "complement", receipts: complement_local_receipts())
}

fn witness_retained_rows_carry_reason_and_trigger() -> Bool {
  fold(
    interpreted_retained_rows(),
    init: true,
    f: fn(acc, row) {
      acc && !routing_row_is_native(row: row)
    }
  )
}

test fn native_routing_frontier_witnesses() -> Bool {
  witness_roster_total_holds()
    && witness_each_family_has_exactly_one_row()
    && witness_unlisted_family_has_no_row()
    && witness_routed_and_retained_split()
    && witness_flips_cite_parity_evidence()
    && witness_retained_rows_carry_reason_and_trigger()
}
