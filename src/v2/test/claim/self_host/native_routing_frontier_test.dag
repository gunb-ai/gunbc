module v2.test.claim.self_host.native_routing_frontier_test

import v2.compiler.self_host.native_routing_frontier {
  native_routing_frontier_roster,
  native_routed_rows,
  interpreted_retained_rows,
  routing_frontier_row_for_subject,
  routing_frontier_total_holds,
  routing_row_is_native,
  family_subject
}
import v2.compiler.self_host.parity_window {
  ParityWindowReceipt,
  WindowObserved,
  ParityMonitorVerdict,
  ParityHolding,
  ParityRevertRequired,
  ParityUnobserved,
  ParityEvidenceRefused,
  parity_monitor_verdict,
  parity_routing_admitted
}
import v2.compiler.self_host.parity_receipts_local { meet_join_local_observations, complement_local_observations }
import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.text { String }

fn frontier_verdict_is_revert_required(v: ParityMonitorVerdict) -> Bool {
  match v {
    ParityHolding { family: _, consecutive_green: _ } => false
    ParityRevertRequired { family: _, red_window_id: _ } => true
    ParityUnobserved { family: _ } => false
    ParityEvidenceRefused { family: _, cause: _ } => false
  }
}

test fn witness_roster_total_holds() -> Bool {
  routing_frontier_total_holds()
}

test fn witness_each_subject_has_exactly_one_row() -> Bool {
  fold(
    native_routing_frontier_roster,
    init: true,
    f: fn(acc, row) {
      acc && (length(xs: routing_frontier_row_for_subject(subject: row.subject)) == 1)
    }
  )
}

test fn witness_unlisted_subject_has_no_row() -> Bool {
  length(
    xs: routing_frontier_row_for_subject(
      subject: family_subject(
        module_path: "v2.test.synthetic.unlisted_module",
        decl_name: "unlisted_synthetic_subject"
      )
    )
  ) == 0
}

test fn witness_routed_and_retained_split() -> Bool {
  (length(xs: native_routed_rows()) == 0)
    && (length(xs: interpreted_retained_rows()) == 11)
}

fn family_crate_bound_subject(module_path: String) -> Bool {
  length(
    xs: fold(
      native_routing_frontier_roster,
      init: [],
      f: fn(acc, row) {
        if (row.subject.module_path == module_path)
          && (row.agreement_entry == "src/v2/test/claim/execution/emit_on_demand_family_crate_witness_test.dag") {
          concat(acc, [row])
        } else {
          acc
        }
      }
    )
  ) == 1
}

test fn witness_local_receipts_seed_post_flip_monitor() -> Bool {
  parity_routing_admitted(family: "meet_join", observations: meet_join_local_observations())
    && parity_routing_admitted(family: "complement", observations: complement_local_observations())
    && family_crate_bound_subject(module_path: "v2.test.execution.emit_host_meet_join_equals_eval")
    && family_crate_bound_subject(module_path: "v2.test.execution.emit_host_complement_equals_eval")
}

test fn witness_post_flip_red_window_latches_revert() -> Bool {
  let with_red = concat(
    meet_join_local_observations(),
    [
      WindowObserved {
        receipt: ParityWindowReceipt {
          family: "meet_join",
          cadence_window_id: "main-29963619401",
          agreement_green: false,
          warm_compile_skipped: true
        },
        cadence_sequence: 5
      }
    ]
  )
  let with_red_then_green = concat(
    with_red,
    [
      WindowObserved {
        receipt: ParityWindowReceipt {
          family: "meet_join",
          cadence_window_id: "later-green",
          agreement_green: true,
          warm_compile_skipped: true
        },
        cadence_sequence: 6
      }
    ]
  )
  frontier_verdict_is_revert_required(
    v: parity_monitor_verdict(family: "meet_join", observations: with_red)
  )
    && (parity_routing_admitted(family: "meet_join", observations: with_red) == false)
    && frontier_verdict_is_revert_required(
      v: parity_monitor_verdict(family: "meet_join", observations: with_red_then_green)
    )
    && (parity_routing_admitted(family: "meet_join", observations: with_red_then_green) == false)
}

test fn witness_retained_rows_carry_reason_and_trigger() -> Bool {
  fold(
    interpreted_retained_rows(),
    init: true,
    f: fn(acc, row) {
      acc && !routing_row_is_native(row: row)
    }
  )
}

