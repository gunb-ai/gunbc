test fn corpus_refusal_emit_primitive_apply_arity_invalid_holds() -> Bool {
  reason_for(path: corpus_path, name: corpus_name) == "target_value_expression_emit_primitive_apply_arity_invalid"
}

test fn corpus_refusal_emit_comparison_operand_is_comparison_holds() -> Bool {
  reason_for(path: corpus_path, name: corpus_name) == "target_value_expression_emit_comparison_operand_is_comparison"
