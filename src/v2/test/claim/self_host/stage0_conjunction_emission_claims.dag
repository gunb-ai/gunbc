test fn corpus_refusal_reason_body_scope_binding_invalid_holds() -> Bool {
  reason_for(path: corpus_path, name: corpus_name) == "target_value_expr_reason_body_scope_binding_invalid"
}

test fn corpus_refusal_reason_arrow_body_form_unsupported_holds() -> Bool {
  reason_for(path: corpus_path, name: corpus_name) == "target_value_expr_reason_arrow_body_form_unsupported"
}

test fn corpus_refusal_reason_function_type_position_unrealized_holds() -> Bool {
  reason_for(path: corpus_path, name: corpus_name) == "target_value_expr_reason_function_type_position_unrealized"
}

test fn corpus_refusal_reason_closure_parameter_order_absent_holds() -> Bool {
  reason_for(path: corpus_path, name: corpus_name) == "target_value_expr_reason_closure_parameter_order_absent"
}

test fn corpus_refusal_emit_unsupported_kind_holds() -> Bool {
  reason_for(path: corpus_path, name: corpus_name) == "target_value_expression_emit_unsupported_kind"
}

test fn corpus_refusal_emit_operator_shape_unsupported_holds() -> Bool {
  reason_for(path: corpus_path, name: corpus_name) == "target_value_expression_emit_operator_shape_unsupported"
