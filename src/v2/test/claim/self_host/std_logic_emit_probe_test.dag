module v2.test.self_host.std_logic_emit_probe

import v2.test.fixture.std_logic_module {
  std_logic_assemble_accepts,
  std_logic_assemble_reject_is_unbound_symbol,
  std_logic_module_emit_accepts,
  std_logic_module_emit_len,
  std_logic_module_emit_reject_reason,
  std_logic_partition_fn_decl_count,
  std_logic_partition_type_decl_count,
  std_logic_semantic_type_emit_accepts,
  std_logic_semantic_type_emit_reject_reason
}
import v2.std.logic { Bool }
import v2.std.node { Symbol }

test fn std_logic_whole_program_emit_accepts() -> Bool {
  std_logic_module_emit_accepts()
}

test fn std_logic_whole_program_emit_reject_reason() -> Symbol {
  std_logic_module_emit_reject_reason()
}

test fn std_logic_semantic_type_emit_accepts_holds() -> Bool {
  std_logic_semantic_type_emit_accepts()
}

test fn std_logic_semantic_type_emit_reject_reason() -> Symbol {
  std_logic_semantic_type_emit_reject_reason()
}

test fn std_logic_emit_probe_all_holds() -> Bool {
  std_logic_whole_program_emit_accepts()
    && std_logic_semantic_type_emit_accepts_holds()
}

test fn std_logic_module_emit_len_gt_400() -> Bool {
  std_logic_module_emit_len() > 400
}

test fn std_logic_partition_type_decl_count_gt_0() -> Bool {
  std_logic_partition_type_decl_count() > 0
}

test fn std_logic_assemble_reject_is_unbound_symbol_holds() -> Bool {
  std_logic_assemble_reject_is_unbound_symbol()
}

test fn std_logic_whole_program_emit_reject_reason_probe() -> Symbol {
  std_logic_module_emit_reject_reason()
}
