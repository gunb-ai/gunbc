module v2.test.self_host.std_logic_emit_probe

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.self_host.compiler_closure_emit {
  CompilerClosureEmitReceipt,
  emit_compiler_import_closure_from_ingest
}
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootIngest
}
import v2.extdeps.languages.dag { dag_language_model }
import v2.extdeps.languages.rust { rust_target_model }
import std.algebra { Cons, Empty }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

data std_logic_path: String = "dag/std/logic.dag"

data std_logic_src: String = "module std.logic\n\ntype Classical = True | False\n\nfn classical_not(a: Classical) -> Classical {\n    match a {\n        True => False\n        False => True\n    }\n}\n\nfn classical_and(a: Classical, b: Classical) -> Classical {\n    match a {\n        False => False\n        True => b\n    }\n}\n\nfn classical_or(a: Classical, b: Classical) -> Classical {\n    match a {\n        True => True\n        False => b\n    }\n}\n"

data std_logic_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^std_logic_artifact,
  file_path: std_logic_path
}

fn std_logic_ingest() -> SourceRootIngest {
  let src = std_logic_src
  Cons {
    head: DagSourceReadWitness {
      source: Medium { carried: src, fidelity: Lossless },
      artifact: std_logic_artifact,
      compilation_unit: ^std_logic_cu,
      source_root: DagTree
    },
    tail: Empty
  }
}

fn std_logic_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: Cons { head: ^std, tail: Cons { head: ^logic, tail: Empty } }
    },
    imports: Empty
  }
}

fn std_logic_emit_text() -> String {
  match emit_compiler_import_closure_from_ingest(
    ingest: std_logic_ingest(),
    admission: std_logic_admission(),
    target: rust_target_model()
  ) {
    Accepted { value: receipt, diagnostics: _ } => receipt.source.carried
    Rejected { diagnostics: _ } => ""
  }
}

fn std_logic_emit_accepts() -> Bool {
  match emit_compiler_import_closure_from_ingest(
    ingest: std_logic_ingest(),
    admission: std_logic_admission(),
    target: rust_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn std_logic_whole_program_emit_accepts() -> Bool {
  std_logic_emit_accepts()
}

test fn std_logic_whole_program_emit_has_enum_classical() -> Bool {
  std_logic_emit_accepts()
    && string_contains(std_logic_emit_text(), "enum Classical")
}

test fn std_logic_whole_program_emit_has_classical_not() -> Bool {
  std_logic_emit_accepts()
    && string_contains(std_logic_emit_text(), "classical_not")
}

test fn std_logic_whole_program_emit_rejects_pipe_only_type() -> Bool {
  std_logic_emit_accepts()
    && !string_contains(std_logic_emit_text(), "True | False")
}

test fn std_logic_emit_probe_all_holds() -> Bool {
  std_logic_whole_program_emit_accepts()
    && std_logic_whole_program_emit_has_enum_classical()
    && std_logic_whole_program_emit_has_classical_not()
    && std_logic_whole_program_emit_rejects_pipe_only_type()
}
