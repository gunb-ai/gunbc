module v2.test.claim.self_host.v2_emitter_direct_rust_door_contract

import v2.compiler.self_host.emitter_producer_provenance {
  ProducerMintAdmitted,
  ProducerMintRefused,
  V2EmitterInterpreted,
  emitter_producer_mint_admission,
  mint_v2_interpreted_receipt_with_seed_closure_refuses,
  v2_interpreted_emitter_closure,
}
import v2.compiler.self_host.v2_emitter_direct_rust_door_contract {
  CandidateGenerationSerializeTargetWiring,
  DirectRustDoorEstablished,
  DirectRustDoorRefused,
  DirectRustDoorUnavailable,
  MissingRuleAcceptedDespiteGap,
  MissingTranslationRuleRefuses,
  SeedEmitterRequiredForWrittenSource,
  WrittenSourceIndependentOfSeedEmitter,
  assess_missing_translation_rule_refuses,
  assess_written_source_independent_of_seed_emitter,
  direct_rust_door_authority_module_path,
  direct_rust_door_closing_frontier_count,
  direct_rust_door_required_capabilities,
  refused,
  v2_emitter_direct_rust_door_acceptance_admissions,
  v2_emitter_direct_rust_door_closing_contract_holds,
}
import v2.std.algebra { any, length }
import v2.std.logic { Bool }

data v2_emitter_direct_rust_door_contract_witness_note: String = "CONTROLLED FIXTURES for the two-clause closing fold. The production admission seam establishes MissingTranslationRuleRefuses through the rust_add missing-rules fixture and derives WrittenSourceIndependentOfSeedEmitter from producer provenance — structural seed-closure refusal plus v2-closure admissibility execute green, then a typed unavailable row names CandidateGenerationSerializeTargetWiring because candidate_generation still stops before serialized source. These tests prove the fold rejects a planted accept-despite-gap admission, that duplicate established rows cannot erase the unavailable second clause, and that the second clause is assessed rather than hand-asserted."

test fn witness_required_capability_population_is_two() -> Bool {
  length(direct_rust_door_required_capabilities()) == 2
}

test fn witness_missing_rule_assessment_establishes_on_fixture() -> Bool {
  match assess_missing_translation_rule_refuses() {
    DirectRustDoorEstablished { capability } => capability == MissingTranslationRuleRefuses
    _ => false
  }
}

test fn witness_provenance_structural_wall_refuses_seed_closure() -> Bool {
  mint_v2_interpreted_receipt_with_seed_closure_refuses(
    module_path: direct_rust_door_authority_module_path,
  )
}

test fn witness_v2_interpreted_closure_admissible_without_seed() -> Bool {
  match emitter_producer_mint_admission(
    producer: V2EmitterInterpreted,
    closure: v2_interpreted_emitter_closure,
  ) {
    ProducerMintAdmitted => true
    ProducerMintRefused { cause: _ } => false
  }
}

test fn witness_written_source_assessment_derives_unavailable_from_pipeline() -> Bool {
  match assess_written_source_independent_of_seed_emitter() {
    DirectRustDoorUnavailable { capability, trigger } =>
      capability == WrittenSourceIndependentOfSeedEmitter
        && trigger == CandidateGenerationSerializeTargetWiring
    _ => false
  }
}

test fn witness_production_admissions_leave_one_capability_open() -> Bool {
  let admissions = v2_emitter_direct_rust_door_acceptance_admissions()
  length(admissions) == 2
    && direct_rust_door_closing_frontier_count(admissions: admissions) == 1
    && !v2_emitter_direct_rust_door_closing_contract_holds(admissions: admissions)
    && admissions |> any(admission => match admission {
      DirectRustDoorEstablished { capability } => capability == MissingTranslationRuleRefuses
      _ => false
    })
    && admissions |> any(admission => match admission {
      DirectRustDoorUnavailable { capability, trigger } =>
        capability == WrittenSourceIndependentOfSeedEmitter
          && trigger == CandidateGenerationSerializeTargetWiring
      _ => false
    })
}

test fn witness_accept_despite_gap_refusal_fires() -> Bool {
  match refused(
    capability: MissingTranslationRuleRefuses,
    failure: MissingRuleAcceptedDespiteGap,
  ) {
    DirectRustDoorRefused { capability, failure } =>
      capability == MissingTranslationRuleRefuses && failure == MissingRuleAcceptedDespiteGap
    _ => false
  }
}

test fn witness_seed_emitter_required_for_written_source_refusal_fires() -> Bool {
  match refused(
    capability: WrittenSourceIndependentOfSeedEmitter,
    failure: SeedEmitterRequiredForWrittenSource,
  ) {
    DirectRustDoorRefused { capability, failure } =>
      capability == WrittenSourceIndependentOfSeedEmitter
        && failure == SeedEmitterRequiredForWrittenSource
    _ => false
  }
}

test fn witness_duplicate_established_cannot_erase_unavailable_capability() -> Bool {
  let established_missing = assess_missing_translation_rule_refuses()
  let assessed_written = assess_written_source_independent_of_seed_emitter()
  let admissions = [
    established_missing,
    established_missing,
    assessed_written,
  ]
  direct_rust_door_closing_frontier_count(admissions: admissions) == 1
    && !v2_emitter_direct_rust_door_closing_contract_holds(admissions: admissions)
}
