module v2.test.claim.self_host.disj_prefix_inner_subject_fixture

// DISJ inner-refusal control, mirror of conj_prefix_inner_subject_fixture. The OUTER apply is the realisable
// boolean Disjunction `||` (op_or HAS an InfixToken row and EMITS). Its RIGHT operand is the one-operand PREFIX
// `!closed_alias` (canonical op_not) which refuses at EMISSION. Both operands Bool so no inference type failure.
// If the Disj lowering DESCENDS into the operand through handle_transform, this refuses with the SAME lexeme the
// standalone prefix subject refuses with, AT EMISSION. Lives under the self-host claim tree, NOT the corpus.
fn disj_prefix_inner_subject(flag: Bool, closed_alias: Bool) -> Bool {
  flag || !closed_alias
}
