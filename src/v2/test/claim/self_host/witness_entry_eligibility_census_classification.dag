module v2.test.claim.self_host.witness_entry_eligibility_census_classification

import v2.compiler.self_host.witness_entry_eligibility_census {
  census_disposition_column_for_entry,
  census_reason_column_for_entry,
  census_execution_leg_label,
  census_native_family_crate_leg_label,
  census_emit_on_demand_family_grain_leg_label,
  census_default_interpreted_leg_label
}

test fn census_long_lane_row_holds() -> Bool {
  census_disposition_column_for_entry(
    entry: "src/v2/test/claim/long/meta_exec_confinement_clean_tree.dag"
  ) == "EmitIneligible"
    && census_reason_column_for_entry(
      entry: "src/v2/test/claim/long/meta_exec_confinement_clean_tree.dag"
    ) == "LongLaneScheduled"
    && census_execution_leg_label(
      entry: "src/v2/test/claim/long/meta_exec_confinement_clean_tree.dag"
    ) == census_default_interpreted_leg_label
}

test fn census_offline_recipe_row_holds() -> Bool {
  census_disposition_column_for_entry(
    entry: "src/v2/test/claim/manual/english_emit_add.dag"
  ) == "EmitIneligible"
    && census_reason_column_for_entry(
      entry: "src/v2/test/claim/manual/english_emit_add.dag"
    ) == "OfflineLocalRecipe"
}

test fn census_emit_on_demand_family_crate_leg_holds() -> Bool {
  census_reason_column_for_entry(
    entry: "src/v2/test/claim/execution/emit_on_demand_family_crate_witness.dag"
  ) == "EmitOnDemandFamilyGrain"
    && census_execution_leg_label(
      entry: "src/v2/test/claim/execution/emit_on_demand_family_crate_witness.dag"
    ) == census_native_family_crate_leg_label
}

test fn census_bulk_pending_default_holds() -> Bool {
  census_disposition_column_for_entry(
    entry: "src/v2/test/claim/self_host/native_agreement.dag"
  ) == "InterpretedRetained"
    && census_reason_column_for_entry(
      entry: "src/v2/test/claim/self_host/native_agreement.dag"
    ) == "BulkFlipPendingCensusIncomplete"
    && census_execution_leg_label(
      entry: "src/v2/test/claim/self_host/native_agreement.dag"
    ) == census_default_interpreted_leg_label
}

test fn census_emit_host_execution_family_row_holds() -> Bool {
  census_disposition_column_for_entry(entry: "src/v2/test/claim/execution/emit_host_add_equals_eval.dag") == "InterpretedRetained"
    && census_reason_column_for_entry(entry: "src/v2/test/claim/execution/emit_host_add_equals_eval.dag") == "EmitOnDemandFamilyGrain"
    && census_execution_leg_label(entry: "src/v2/test/claim/execution/emit_host_add_equals_eval.dag") == census_emit_on_demand_family_grain_leg_label
}

test fn census_emit_host_gate_not_family_grain_holds() -> Bool {
  census_reason_column_for_entry(entry: "dag/test/claim/emit_host_gate_witness.dag") == "BulkFlipPendingCensusIncomplete"
}

