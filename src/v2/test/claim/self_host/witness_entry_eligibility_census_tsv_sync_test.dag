module v2.test.claim.self_host.witness_entry_eligibility_census_tsv_sync

import v2.compiler.self_host.witness_entry_eligibility_census {
  witness_entry_eligibility_census_entry_count,
  witness_entry_eligibility_census_declared_entry_count,
  witness_entry_eligibility_census_tsv_path,
  witness_entry_eligibility_census_histogram_path
}

data witness_entry_eligibility_census_tsv_sync_note: String = "TSV-authority sync (review 41767): witness_entry_eligibility_census_entry_count must equal committed TSV data rows. Rust discriminating consumer: cargo test -p v1-compiler witness_entry_eligibility_census_tsv_sync_tests::tsv_data_row_count_matches_declared_authority. Emit transport also refuses when find roster size != declared count."

test fn witness_entry_eligibility_census_declared_count_exposed_holds() -> Bool {
  (witness_entry_eligibility_census_declared_entry_count() == witness_entry_eligibility_census_entry_count) && (witness_entry_eligibility_census_entry_count >= 600)
}

test fn witness_entry_eligibility_census_carrier_paths_nonempty_holds() -> Bool {
  (witness_entry_eligibility_census_tsv_path != "") && (witness_entry_eligibility_census_histogram_path != "")
}

test fn witness_entry_eligibility_census_tsv_sync_witnesses() -> Bool {
  witness_entry_eligibility_census_declared_count_exposed_holds() && witness_entry_eligibility_census_carrier_paths_nonempty_holds()
}
