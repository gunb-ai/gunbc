// ---- WRAPPED negate y + (-x): the nested-inner refusal must surface the INNER (negate) reason ----
test fn nwrap_emits_holds() -> Bool {
  reason_for(path: nwrap_subject_path, name: nwrap_subject_name) == "artifact-produced"
}
test fn nwrap_stage_emission_holds() -> Bool {
  stage_for(path: nwrap_subject_path, name: nwrap_subject_name) == "emission"
}
test fn nwrap_reason_is_transform_shape_holds() -> Bool {
  reason_for(path: nwrap_subject_path, name: nwrap_subject_name) == "target_value_expr_reason_transform_shape_invalid"
}
test fn nwrap_reason_is_arity_invalid_holds() -> Bool {
  reason_for(path: nwrap_subject_path, name: nwrap_subject_name) == "target_value_expression_emit_primitive_apply_arity_invalid"
