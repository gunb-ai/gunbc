test fn nwrap_reason_is_realization_arity_mismatch_holds() -> Bool {
  reason_for(path: nwrap_subject_path, name: nwrap_subject_name) == "target_primitive_realization_arity_mismatch"
}
// The inner-gate raw comparison: the wrapped refusal reason must EQUAL the standalone negate's reason
// (proves the inner refusal propagated intact through the operand recursion, not the outer add's reason
// and not the generic bucket). Self-calibrating; no lexeme hard-coded.
test fn nwrap_reason_equals_standalone_negate_holds() -> Bool {
  reason_for(path: nwrap_subject_path, name: nwrap_subject_name)
    == reason_for(path: negate_subject_path, name: negate_subject_name)
}
