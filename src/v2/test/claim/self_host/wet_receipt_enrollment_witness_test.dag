data wet_binding_revocation_witness_note: String = "2026-07-25: module wet bindings revoked (empty list) after cadence run 30126573464 showed the six SelfEmitted wet receipts RED. Witnesses below pin the revoked state — rows enroll nothing without a binding; nightly = template-only. Review 44453: enrollment keys on binding presence, not EmitterProduced disposition. Re-arm each binding witness when that module's wet receipt greens."

test fn witness_seed_retained_row_enrolls_no_wet_entry() -> Bool {
  length(xs: frontier_row_wet_entries_if_enrolled(row: compiler_frontier_row_06_translate)) == 0
}

