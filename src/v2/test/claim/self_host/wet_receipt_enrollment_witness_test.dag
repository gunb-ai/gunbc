data wet_template_entry_count_note: String = "Twelve template rows: the Gate-4 std/logic per-module self-host receipt, the Gate-1 emit-class import-closure receipt (namespace_import_closure_witness_test), the seven emit-on-demand family aggregates (kernel, field_access, complement, match_loop_fold, meet_join, variant_construct, classical_not_ingested — the 2026-07-21 nightly Wet enrollment; complement + meet_join are pure-receipt residues after the family-grain migration), the family-crate aggregate (emit_on_demand_family_crate_witness_test — the executing consumer for the migrated complement/meet_join native legs, enrolled so the migration cannot orphan them), the Kernel-D native-only-verdict real compile-and-run witness (emit_host_native_only_verdict_test.dag — KERNEL-D TESTING RE-STEER, 2026-07-24: moved off per-PR CommitCheckEnrollment onto this nightly wet cadence, the same lane as the other module-agnostic rows here), and the R1 real-crate roster<->handler bijection receipt (interpreter_dispatch_bijection_real_roster_witness_test.dag — Lane D, gunbc#7825). The non-Gate-4 rows are module-agnostic — no frontier row flips to gate them; they enroll as template rows rather than SelfHostWetReceiptBinding rows. See falsifier_self_host_wet_emit_class_note."

test fn witness_nightly_enrollment_is_template_only_while_bindings_revoked() -> Bool {
  (length(xs: falsifier_self_host_wet_template_entries) == 12)
    && (length(xs: falsifier_self_host_wet_frontier_enrolled_entries()) == 0)
    && (length(xs: falsifier_self_host_wet_entries()) == 12)
}

