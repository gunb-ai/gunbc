module v2.test.claim.self_host.direct_rust_door_emission_witness_test

import v2.compiler.self_host.candidate_generation {
  mint_provenanced_rust_artifact,
  provenanced_rust_artifact_seed_independent
}
import v2.compiler.self_host.direct_rust_door_fixture {
  direct_rust_door_expected_source,
  direct_rust_door_inferred_tree,
  direct_rust_door_module_path,
  direct_rust_door_target_model
}
import v2.compiler.self_host.emitter_producer_provenance {
  mint_v2_interpreted_receipt_with_seed_closure_refuses,
  V2EmitterInterpreted,
  v2_interpreted_emitter_closure_authority,
  v2_interpreted_emitter_closure_seed_free_holds
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }

data direct_rust_door_emission_witness_note: String = "Lane B discriminating witness: mint_provenanced_rust_artifact emits rust add source through v2.compiler.emit with a V2EmitterInterpreted producer receipt whose realized closure excludes v1.compiler.emit_rust. Disk write + cargo compile execute in tools.direct_rust_door_transport (offline wet recipe; see witness_exclusion_frontier row for direct_rust_door_write_compile_witness_test.dag)."

test fn witness_direct_rust_door_provenanced_artifact_holds() -> Bool {
  match mint_provenanced_rust_artifact(
    inferred: direct_rust_door_inferred_tree,
    target: direct_rust_door_target_model(),
    module_path: direct_rust_door_module_path,
    realized_closure: v2_interpreted_emitter_closure_authority()
  ) {
    Accepted { value: artifact, diagnostics: _ } =>
      (artifact.source.carried == direct_rust_door_expected_source)
        && provenanced_rust_artifact_seed_independent(artifact: artifact)
        && (artifact.producer_receipt.producer == V2EmitterInterpreted)
    Rejected { diagnostics: _ } => false
  }
}

test fn witness_seed_closure_poison_refuses_v2_producer_reds() -> Bool {
  mint_v2_interpreted_receipt_with_seed_closure_refuses(
    module_path: direct_rust_door_module_path
  )
}

test fn witness_v2_closure_excludes_seed_emit_rust_holds() -> Bool {
  v2_interpreted_emitter_closure_seed_free_holds()
}
