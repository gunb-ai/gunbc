module v2.test.claim.self_host.witness_bulk_routing_test

import v2.compiler.self_host.witness_bulk_routing {
  witness_bulk_routing_sample_roster,
  witness_bulk_entry_count_expected,
  native_routed_entry_rows,
  interpreted_retained_entry_rows,
  emit_ineligible_entry_rows,
  routing_row_for_entry,
  witness_bulk_routing_total_holds,
  witness_bulk_routing_zero_native_at_landing_holds
}
import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.witness_execution_routing {
  disposition_is_interpreted_retained,
  disposition_is_emit_ineligible
}

fn witness_sample_roster_total_holds() -> Bool {
  witness_bulk_routing_total_holds()
}

fn witness_each_sample_entry_has_exactly_one_row() -> Bool {
  fold(
    witness_bulk_routing_sample_roster,
    init: true,
    f: fn(acc, row) {
      acc && (length(xs: routing_row_for_entry(entry: row.entry)) == 1)
    }
  )
}

fn witness_unlisted_entry_has_no_row() -> Bool {
  length(xs: routing_row_for_entry(entry: "dag/test/claim/synthetic_unlisted_entry.dag")) == 0
}

fn witness_zero_native_at_landing_holds() -> Bool {
  witness_bulk_routing_zero_native_at_landing_holds()
}

fn witness_retained_and_ineligible_split() -> Bool {
  (length(xs: native_routed_entry_rows()) == 0)
    && (length(xs: interpreted_retained_entry_rows()) == 14)
    && (length(xs: emit_ineligible_entry_rows()) == 2)
}

fn witness_retained_rows_carry_reason_and_trigger() -> Bool {
  fold(
    interpreted_retained_entry_rows(),
    init: true,
    f: fn(acc, row) {
      acc && disposition_is_interpreted_retained(d: row.disposition)
    }
  )
}

fn witness_ineligible_rows_carry_typed_cause() -> Bool {
  fold(
    emit_ineligible_entry_rows(),
    init: true,
    f: fn(acc, row) {
      acc && disposition_is_emit_ineligible(d: row.disposition)
    }
  )
}

fn witness_sample_count_matches_expected() -> Bool {
  length(xs: witness_bulk_routing_sample_roster) == witness_bulk_entry_count_expected
}

test fn witness_bulk_routing_witnesses() -> Bool {
  witness_sample_roster_total_holds()
    && witness_each_sample_entry_has_exactly_one_row()
    && witness_unlisted_entry_has_no_row()
    && witness_zero_native_at_landing_holds()
    && witness_retained_and_ineligible_split()
    && witness_retained_rows_carry_reason_and_trigger()
    && witness_ineligible_rows_carry_typed_cause()
    && witness_sample_count_matches_expected()
}
