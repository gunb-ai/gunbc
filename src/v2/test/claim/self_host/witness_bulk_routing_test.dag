module v2.test.claim.self_host.witness_bulk_routing_test


test fn witness_sample_roster_total_holds() -> v2.std.logic.Bool {
  witness_bulk_routing_total_holds()
}

test fn witness_each_sample_entry_has_exactly_one_row() -> v2.std.logic.Bool {
  fold(
    witness_bulk_routing_sample_roster,
    init: true,
    f: fn(acc, row) {
      acc && (length(xs: routing_row_for_entry(entry: row.entry)) == 1)
    }
  )
}

test fn witness_unlisted_entry_has_no_row() -> v2.std.logic.Bool {
  length(xs: routing_row_for_entry(entry: "dag/test/claim/synthetic_unlisted_entry.dag")) == 0
}

test fn witness_zero_native_at_landing_holds() -> v2.std.logic.Bool {
  witness_bulk_routing_zero_native_at_landing_holds()
}

test fn witness_retained_rows_carry_typed_reason_and_trigger() -> v2.std.logic.Bool {
  fold(
    interpreted_retained_entry_rows(),
    init: true,
    f: fn(acc, row) {
      acc && match row.disposition {
        InterpretedRetained { reason: _, dissolution: _ } => true
        _ => false
      }
    }
  )
}

test fn witness_ineligible_rows_carry_typed_cause() -> v2.std.logic.Bool {
  fold(
    emit_ineligible_entry_rows(),
    init: true,
    f: fn(acc, row) {
      acc && match row.disposition {
        EmitIneligible { cause: _, detail: _ } => true
        _ => false
      }
    }
  )
}

