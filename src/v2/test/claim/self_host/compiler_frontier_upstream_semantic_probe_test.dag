module v2.test.self_host.compiler_frontier_upstream_semantic_probe

import v2.compiler.self_host.frontier {
  compiler_frontier_roster_stale_located_reason_count_holds
}
import v2.compiler.self_host.frontier_probe_survey {
  frontier_probe_survey_blocker_partition_totality_holds
}
import v2.compiler.self_host.frontier_probe_types {
  EmitSurfaceGap,
  NameResolutionGap,
  ProbeStageSemanticDerivation,
  UpstreamSemanticRefusal,
  UnknownProbeCause,
  gate_a_flip_probe_unresolved_compiler_error_reason,
  frontier_classify_rejection_reason,
  frontier_probe_located_stage_for_blocker,
  upstream_semantic_compiler_error_class
}

data compiler_frontier_upstream_semantic_probe_note: String = "Lane E vocabulary + receipt-totality wall witnesses (still-dove-191): UpstreamSemanticRefusal is NOT EmitSurfaceGap; UNRESOLVED marker classifies to semantic derivation stage. Stale located_reason wall reds while extinct gate_a_flip_probe_witness_std_dup rows remain on the roster — intentional until second measurement pass."

test fn frontier_classify_unresolved_marker_is_upstream_semantic_holds() -> Bool {
  match frontier_classify_rejection_reason(
    reason: gate_a_flip_probe_unresolved_compiler_error_reason
  ) {
    UpstreamSemanticRefusal {
      diagnostic_class: diagnostic_class,
      diagnostic_name: diagnostic_name
    } =>
      (diagnostic_class == upstream_semantic_compiler_error_class)
        && (diagnostic_name == gate_a_flip_probe_unresolved_compiler_error_reason)
    _ => false
  }
}

test fn frontier_classify_unresolved_marker_not_emit_surface_red_control() -> Bool {
  match frontier_classify_rejection_reason(
    reason: gate_a_flip_probe_unresolved_compiler_error_reason
  ) {
    EmitSurfaceGap => false
    NameResolutionGap => false
    UnknownProbeCause { reason: _ } => false
    _ => true
  }
}

test fn frontier_upstream_semantic_located_stage_is_semantic_derivation_holds() -> Bool {
  match frontier_classify_rejection_reason(
    reason: gate_a_flip_probe_unresolved_compiler_error_reason
  ) {
    UpstreamSemanticRefusal { diagnostic_class: _, diagnostic_name: _ } =>
      frontier_probe_located_stage_for_blocker(blocker: UpstreamSemanticRefusal {
        diagnostic_class: upstream_semantic_compiler_error_class,
        diagnostic_name: gate_a_flip_probe_unresolved_compiler_error_reason
      }) == ProbeStageSemanticDerivation
    _ => false
  }
}

test fn compiler_frontier_stale_located_reason_wall_reds_until_second_pass_holds() -> Bool {
  !compiler_frontier_roster_stale_located_reason_count_holds()
}

test fn compiler_frontier_empty_survey_blocker_partition_totality_holds() -> Bool {
  frontier_probe_survey_blocker_partition_totality_holds(receipts: [], module_count: 0)
}
