module v2.test.claim.self_host.parity_window_test

import v2.compiler.self_host.parity_window {
  ParityWindowReceipt,
  ParityMonitorVerdict,
  ParityHolding,
  ParityRevertRequired,
  ParityUnobserved,
  parity_monitor_verdict,
  parity_holding,
  parity_revert_required
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

fn green_receipt(id: String) -> ParityWindowReceipt {
  ParityWindowReceipt {
    family: "add",
    cadence_window_id: id,
    agreement_green: true,
    warm_compile_skipped: true
  }
}

fn red_receipt(id: String) -> ParityWindowReceipt {
  ParityWindowReceipt {
    family: "add",
    cadence_window_id: id,
    agreement_green: false,
    warm_compile_skipped: true
  }
}

fn cold_receipt(id: String) -> ParityWindowReceipt {
  ParityWindowReceipt {
    family: "add",
    cadence_window_id: id,
    agreement_green: true,
    warm_compile_skipped: false
  }
}

test fn witness_trailing_greens_hold_with_streak() -> Bool {
  match parity_monitor_verdict(
    family: "add",
    receipts: [green_receipt(id: "w1"), green_receipt(id: "w2"), green_receipt(id: "w3")]
  ) {
    ParityHolding { family: f, consecutive_green: n } => (f == "add") && (n == 3)
    ParityRevertRequired { family: _, red_window_id: _ } => false
    ParityUnobserved { family: _ } => false
  }
}

test fn witness_latest_red_demands_revert_naming_window() -> Bool {
  match parity_monitor_verdict(
    family: "add",
    receipts: [green_receipt(id: "w1"), green_receipt(id: "w2"), red_receipt(id: "w3")]
  ) {
    ParityHolding { family: _, consecutive_green: _ } => false
    ParityRevertRequired { family: f, red_window_id: w } => (f == "add") && (w == "w3")
    ParityUnobserved { family: _ } => false
  }
}

test fn witness_cold_divergence_demands_revert() -> Bool {
  parity_revert_required(
    family: "add",
    receipts: [green_receipt(id: "w1"), cold_receipt(id: "w2")]
  )
}

test fn witness_empty_history_is_unobserved_not_holding() -> Bool {
  let unobserved = match parity_monitor_verdict(family: "add", receipts: []) {
    ParityHolding { family: _, consecutive_green: _ } => false
    ParityRevertRequired { family: _, red_window_id: _ } => false
    ParityUnobserved { family: f } => f == "add"
  }
  unobserved
    && (parity_holding(family: "add", receipts: []) == false)
    && (parity_revert_required(family: "add", receipts: []) == false)
}

test fn witness_streak_counts_trailing_only() -> Bool {
  match parity_monitor_verdict(
    family: "add",
    receipts: [
      green_receipt(id: "w1"),
      green_receipt(id: "w2"),
      green_receipt(id: "w3"),
      red_receipt(id: "w4"),
      green_receipt(id: "w5")
    ]
  ) {
    ParityHolding { family: _, consecutive_green: n } => n == 1
    ParityRevertRequired { family: _, red_window_id: _ } => false
    ParityUnobserved { family: _ } => false
  }
}

test fn witness_red_control_holding_rejects_trailing_red() -> Bool {
  parity_holding(
    family: "add",
    receipts: [green_receipt(id: "w1"), red_receipt(id: "w2")]
  ) == false
}
