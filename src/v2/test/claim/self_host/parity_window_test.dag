module v2.test.claim.self_host.parity_window_test


fn green_receipt(id: String) -> ParityWindowReceipt {
  ParityWindowReceipt {
    family: "add",
    cadence_window_id: id,
    agreement_green: true,
    warm_compile_skipped: true
  }
}

fn red_receipt(id: String) -> ParityWindowReceipt {
  ParityWindowReceipt {
    family: "add",
    cadence_window_id: id,
    agreement_green: false,
    warm_compile_skipped: true
  }
}

fn cold_receipt(id: String) -> ParityWindowReceipt {
  ParityWindowReceipt {
    family: "add",
    cadence_window_id: id,
    agreement_green: true,
    warm_compile_skipped: false
  }
}

fn witness_three_greens_permit() -> Bool {
  parity_flip_permitted(
    family: "add",
    receipts: [green_receipt(id: "w1"), green_receipt(id: "w2"), green_receipt(id: "w3")]
  )
}

fn witness_red_resets_streak() -> Bool {
  let refused = parity_flip_permitted(
    family: "add",
    receipts: [
      green_receipt(id: "w1"),
      red_receipt(id: "w2"),
      green_receipt(id: "w3"),
      green_receipt(id: "w4")
    ]
  )
  refused == false
}

fn witness_cold_divergence_resets_streak() -> Bool {
  let refused = parity_flip_permitted(
    family: "add",
    receipts: [
      green_receipt(id: "w1"),
      green_receipt(id: "w2"),
      cold_receipt(id: "w3")
    ]
  )
  refused == false
}

fn witness_empty_receipts_refuse() -> Bool {
  parity_flip_permitted(family: "add", receipts: []) == false
}

fn witness_refusal_carries_streak_and_required() -> Bool {
  match parity_verdict_for(
    family: "add",
    receipts: [green_receipt(id: "w1"), green_receipt(id: "w2")]
  ) {
    ParityFlipRefused { family: _, consecutive_green: streak, required: req } =>
      streak == 2 && req == required_consecutive_green_windows
    ParityFlipPermitted { family: _, consecutive_green: _ } => false
  }
}

fn witness_streak_counts_trailing_only() -> Bool {
  let streak = trailing_consecutive_green(
    receipts: [
      green_receipt(id: "w1"),
      green_receipt(id: "w2"),
      green_receipt(id: "w3"),
      red_receipt(id: "w4"),
      green_receipt(id: "w5")
    ]
  )
  streak == 1
}

test fn parity_window_witnesses() -> Bool {
  witness_three_greens_permit()
    && witness_red_resets_streak()
    && witness_cold_divergence_resets_streak()
    && witness_empty_receipts_refuse()
    && witness_refusal_carries_streak_and_required()
    && witness_streak_counts_trailing_only()
}
