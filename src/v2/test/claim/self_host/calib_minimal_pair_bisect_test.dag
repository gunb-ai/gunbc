data bisect_arity_zero_infix_source: String = "module add_probe\n\nfn f() -> Int { 1 + 1 }\n"

data bisect_arity_zero_infix_path: String = "src/v2/test/fixture/calibration_chain/bisect_arity_zero_infix.dag"

data bisect_flip_receipt: String = "CROSSES: fn add(x: Int, y: Int) -> Int { x + y } AND { x + x }. module QN change and fn name noop (same body) still cross. REFUSE overlap: { x }, { y }, { 0 }, { 1 }, arity-zero fn add() -> Int { 0 }, calib fn noop() -> Int { 0 }. Minimal flip from A0: body { x + y } -> { x } OR { 0 } (module/fn/arity unchanged). Trigger: binary-addition body shape required; single ref, literal, or zero-arity refuses."

fn bisect_read(path: String, source: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact {
      kind: SourceFile,
      id: symbol_intern_lexeme(lexeme: path),
      file_path: path
    },
    compilation_unit: symbol_intern_lexeme(lexeme: path),
    source_root: V2Tree
  }
}

fn bisect_admission_for(read: DagSourceReadWitness) -> Admission {
  match reference_deps_ingest_source_text(
    source_text: read.source.carried,
    file: symbol_intern_lexeme(lexeme: read.artifact.file_path)
  ) {
    Rejected { diagnostics: _ } =>
      Admission {
        subject: ResolutionSubject { name: Cons { head: ^add_probe, tail: Empty } },
        imports: Empty
      }
    Accepted { value: parse_root, diagnostics: _ } =>
      match admission_from_module_root(root: parse_root) {
        Rejected { diagnostics: _ } =>
          Admission {
            subject: ResolutionSubject { name: Cons { head: ^add_probe, tail: Empty } },
            imports: Empty
          }
        Accepted { value: admission, diagnostics: _ } => admission
      }
  }
}

fn bisect_receipt(path: String, source: String) -> FrontierProbeReceipt {
  let read = bisect_read(path: path, source: source)
  frontier_probe_emit_from_ingest(
    module_path: path,
    ingest: Cons { head: read, tail: Empty },
    admission: bisect_admission_for(read: read)
  )
}

fn bisect_crosses_assembly(path: String, source: String) -> Bool {
  bisect_receipt(path: path, source: source).located_stage != ProbeStageAssemble
}

fn bisect_overlap_refused(path: String, source: String) -> Bool {
  let r = bisect_receipt(path: path, source: source)
  (r.located_stage == ProbeStageAssemble)
    && (r.located_reason == ^parse_grammar_choice_overlap_residue)
}

test fn bisect_a0_crosses_assembly_holds() -> Bool {
  bisect_crosses_assembly(path: bisect_a0_path, source: bisect_a0_before)
}

test fn bisect_calib_refuses_overlap_holds() -> Bool {
  bisect_overlap_refused(path: calib_helper_path, source: bisect_calib_after)
}

test fn bisect_module_qn_only_crosses_assembly_holds() -> Bool {
  bisect_crosses_assembly(path: bisect_module_qn_path, source: bisect_module_qn_only_source)
}

