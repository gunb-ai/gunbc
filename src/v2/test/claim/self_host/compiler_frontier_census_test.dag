module v2.test.self_host.compiler_frontier_census


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn compiler_frontier_roster_count_matches_expected() -> Bool {
  compiler_frontier_roster_count() == compiler_frontier_module_count_expected
}

test fn compiler_frontier_roster_is_complete() -> Bool {
  compiler_frontier_roster_complete_holds()
}

test fn compiler_frontier_roster_paths_are_unique() -> Bool {
  compiler_frontier_roster_paths_unique_holds()
}

test fn compiler_frontier_duplicate_path_red_refuses() -> Bool {
  compiler_frontier_known_module_path_exactly_once_holds()
    && compiler_frontier_phantom_module_path_absent_holds()
}

test fn compiler_frontier_initial_census_matches_self_emitted_baseline() -> Bool {
  compiler_frontier_self_emitted_count() == compiler_frontier_self_emitted_baseline
    && compiler_frontier_roster_count() == compiler_frontier_module_count_expected
}

test fn compiler_frontier_execution_measured_attribution_test() -> Bool {
  compiler_frontier_execution_measured_attribution_holds()
    && compiler_frontier_blocker_class_distribution_knowledge_attributed_holds()
    && compiler_frontier_gap_clustering_knowledge_attributed_holds()
    && compiler_frontier_sweep_order_complete_holds()
    && compiler_frontier_roster_all_classified_holds()
    && compiler_frontier_roster_probe_paths_match_holds()
    && compiler_frontier_self_emitted_located_reason_holds()
}

test fn compiler_frontier_census_composite_test() -> Bool {
  compiler_frontier_census_holds()
    && compiler_frontier_initial_census_matches_self_emitted_baseline()
    && compiler_frontier_execution_measured_attribution_holds()
}

test fn compiler_frontier_band_a_emit_readiness_roster_holds() -> Bool {
  compiler_frontier_band_a_emit_readiness_holds()
}

test fn compiler_frontier_band_a_parse_engine_hooks_flipped_discriminator_holds() -> Bool {
  match compiler_frontier_band_a_row_parse_engine_hooks.gate {
    FlippableNow => true
    _ => false
  }
}

test fn compiler_frontier_band_a_use_site_verdict_flipped_discriminator_holds() -> Bool {
  match compiler_frontier_band_a_row_use_site_verdict.gate {
    FlippableNow => true
    _ => false
  }
}
