module v2.test.claim.self_host.stage0_conj_disj_prefix_inner_reason_probe

// STANDING WITNESS ENTRY for this row's inner-named-reason condition, retained by the lane
// manager's ruling and run as LEG2 of the accepted final-evidence wrapper at the head being
// accepted. Executed content: (1) a well-typed Bool conjunction and a well-typed Bool disjunction
// each carrying a refusing prefix operand refuse at EMISSION with the STANDALONE prefix refusal
// reason, by exact equality against the reason the standalone prefix subject refuses on -- not the
// generic transform-shape reason, and not the outer binary's reason; (2) the negate-wrapped Int
// subject `y + (-x)` pinned with its stage and reason side-by-side against the standalone negate,
// the record the companion prefix row's named second gap is measured against; (3) the reachable
// primitive-apply / operand / wire / catalog refusal lexeme set, read from the Diagnostic `reason:`
// fields on that path, so a refusal outside the set is REPORTED as outside the set rather than
// inferred from an empty grep. Subjects live under the self-host claim tree except the corpus
// subject.

import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.self_host.candidate_generation {
  ArtifactProduced, AssemblyRejected, EmissionRejected, InferenceRejected,
  ProducerReceiptRejected, ProvenancedRustEmissionObservation,
  observe_provenanced_rust_emission_from_ingest
}
import v2.compiler.self_host.stage0_production_target { stage0_production_target_model }
import v2.compiler.source_authority { SourceRef }
import v2.test.claim.self_host.stage0_subject_paths { subject_path_for_module }
import v2.compiler.source_authority_read {
  source_ref_for_observed_storage_path, source_root_ingest_from_source_refs
}
import std.algebra { Cons, Empty }
import std.types { Bool }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_reason_lexemes }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }

// Name is the authority; the path is DERIVED from it by the ONE shared production-rule
// derivation (v2.test.claim.self_host.stage0_subject_paths: module_file over
// repository_storage_layout, review 98522) -- no local root rule lives in this probe.

data prefix_name: String = "v2.test.claim.self_host.prefix_not_operand_subject_fixture"
data prefix_path: String = subject_path_for_module(module_name: prefix_name)
data corpus_name: String = "gunbc.rust_decl_type_overlay"
data corpus_path: String = subject_path_for_module(module_name: corpus_name)
data negate_name: String = "v2.test.claim.self_host.prefix_negate_operand_subject_fixture"
data negate_path: String = subject_path_for_module(module_name: negate_name)
data nwrap_name: String = "v2.test.claim.self_host.negate_wrapped_operand_subject_fixture"
data nwrap_path: String = subject_path_for_module(module_name: nwrap_name)
data conjpre_name: String = "v2.test.claim.self_host.conj_prefix_inner_subject_fixture"
data conjpre_path: String = subject_path_for_module(module_name: conjpre_name)
data disjpre_name: String = "v2.test.claim.self_host.disj_prefix_inner_subject_fixture"
data disjpre_path: String = subject_path_for_module(module_name: disjpre_name)

fn refs_for(path: String) -> List<SourceRef> {
  Cons { head: source_ref_for_observed_storage_path(path: path, source_root: DagTree), tail: Empty }
}
fn admission_for(name: String) -> Admission {
  Admission { subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: name) }, imports: Empty }
}
fn door_for(path: String, name: String) -> Outcome<ProvenancedRustEmissionObservation> {
  match source_root_ingest_from_source_refs(refs: refs_for(path: path)) {
    Accepted { value: ingest, diagnostics: d } =>
      Accepted {
        value: observe_provenanced_rust_emission_from_ingest(
          ingest: ingest, admission: admission_for(name: name),
          target: stage0_production_target_model(), module_path: path),
        diagnostics: d }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}
fn reason_for(path: String, name: String) -> String {
  match door_for(path: path, name: name) {
    Accepted { value: EmissionRejected { diagnostics: ds }, diagnostics: _ } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: AssemblyRejected { diagnostics: ds }, diagnostics: _ } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: InferenceRejected { diagnostics: ds }, diagnostics: _ } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ProducerReceiptRejected { diagnostics: ds }, diagnostics: _ } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => "artifact-produced"
    Rejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
  }
}
fn stage_for(path: String, name: String) -> String {
  match door_for(path: path, name: name) {
    Accepted { value: EmissionRejected { diagnostics: _ }, diagnostics: _ } => "emission"
    Accepted { value: AssemblyRejected { diagnostics: _ }, diagnostics: _ } => "assembly"
    Accepted { value: InferenceRejected { diagnostics: _ }, diagnostics: _ } => "inference"
    Accepted { value: ProducerReceiptRejected { diagnostics: _ }, diagnostics: _ } => "producer_receipt"
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => "artifact"
    Rejected { diagnostics: _ } => "ingest_rejected"
  }
}

test fn prefix_emits_holds() -> Bool {
  reason_for(path: prefix_path, name: prefix_name) == "artifact-produced"
}
