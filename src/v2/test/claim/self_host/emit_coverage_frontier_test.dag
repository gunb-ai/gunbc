module v2.test.claim.self_host.emit_coverage_frontier_test

import v2.compiler.self_host.emit_coverage_frontier {
  emit_coverage_frontier_roster,
  self_emitted_native_rows,
  interpreter_retained_rows,
  coverage_frontier_row_for_subject,
  coverage_frontier_total_holds,
  coverage_row_is_native,
  coverage_subject,
  coverage_row_backing_is_enrolled,
  coverage_frontier_all_native_claims_backed,
  EmitCoverageFrontierRow,
  SelfEmittedNative
}
import v2.std.algebra { length }
import v2.std.logic { Bool }
import v2.std.text { String }

test fn witness_roster_total_holds() -> Bool {
  coverage_frontier_total_holds()
}

test fn witness_each_subject_has_exactly_one_row() -> Bool {
  fold(
    emit_coverage_frontier_roster,
    init: true,
    f: fn(acc, row) {
      acc && (length(xs: coverage_frontier_row_for_subject(subject: row.subject)) == 1)
    }
  )
}

test fn witness_unlisted_subject_has_no_row() -> Bool {
  length(
    xs: coverage_frontier_row_for_subject(
      subject: coverage_subject(
        module_path: "v2.test.synthetic.unlisted_module",
        decl_name: "unlisted_synthetic_subject"
      )
    )
  ) == 0
}

test fn witness_split_matches_expected() -> Bool {
  (length(xs: self_emitted_native_rows()) == 9)
    && (length(xs: interpreter_retained_rows()) == 6)
}

// Identity-grain census of the native rows (DESIGN section 5: completeness is an identity join,
// not a count equality — the count leg above is the budget cross-check, this leg names the
// members). 2026-09-07: the add family joined classical_not when its native-only verdict arm
// landed, and the complement family followed on the same arm shape run through the logic family
// crate. 2026-09-08: the field_access family followed against its own family one-build cache
// (octet 9 pinned), the three match_loop_fold family rows (match, loop, fold_closure)
// followed on the same arm shape run through the three-member family crate, the meet_join
// family followed on the complement arm's member-parameterized helper against the same logic
// family crate (octets meet=1 join=1 pinned), and the variant_construct family followed against
// its own family one-build cache (octet 9 pinned); the nine decl names are the closed membership.
test fn witness_native_rows_closed_membership_holds() -> Bool {
  let natives = self_emitted_native_rows()
  (length(xs: natives) == 9)
    && fold(
      natives,
      init: true,
      f: fn(acc, row) {
        acc && (
          (row.subject.decl_name == "ingested_classical_not_source")
            || (row.subject.decl_name == "rust_add_inferred_tree")
            || (row.subject.decl_name == "emit_complement_eval_subject")
            || (row.subject.decl_name == "emit_field_eval_subgraph_node")
            || (row.subject.decl_name == "fold_fixture_param_call_body")
            || (row.subject.decl_name == "table_fixture_loop_arrow_with_body")
            || (row.subject.decl_name == "table_fixture_match_arrow_with_body")
            || (row.subject.decl_name == "meet_join_eval_subject")
            || (row.subject.decl_name == "emit_variant_construct_eval_subgraph_node")
        )
      }
    )
}

test fn witness_real_native_row_is_backed() -> Bool {
  fold(
    self_emitted_native_rows(),
    init: true,
    f: fn(acc, row) { acc && coverage_row_backing_is_enrolled(row: row) }
  )
}

test fn witness_all_claims_backed_holds() -> Bool {
  coverage_frontier_all_native_claims_backed()
}

// Discriminating RED control (parent-preferred idiom, quarantined-known-red): a synthetic row
// falsely claims SelfEmittedNative with a backing citation that is NOT enrolled in
// falsifier_self_host_wet_template_entries. If coverage_row_backing_is_enrolled ever returned true
// for this row, the backing check would be a rubber stamp (a validation that can be satisfied by
// editing the claim, not the realization — DESIGN section 5's named tell).
// witness_synthetic_unbacked_claim_reds asserts the check catches it; this row is never added to
// emit_coverage_frontier_roster itself, so it never inflates the real count.

fn synthetic_unbacked_native_row() -> EmitCoverageFrontierRow {
  EmitCoverageFrontierRow {
    subject: coverage_subject(
      module_path: "v2.test.synthetic.unbacked_native_claim",
      decl_name: "no_such_native_witness"
    ),
    witness_entry: "src/v2/test/claim/execution/does_not_exist_test.dag",
    witness_function: "fabricated_all_holds",
    disposition: SelfEmittedNative {
      backing_entry: "src/v2/test/claim/execution/does_not_exist_test.dag",
      backing_function: "fabricated_all_holds"
    }
  }
}

test fn witness_synthetic_unbacked_claim_reds() -> Bool {
  let probe = synthetic_unbacked_native_row()
  coverage_row_is_native(row: probe) && !coverage_row_backing_is_enrolled(row: probe)
}

