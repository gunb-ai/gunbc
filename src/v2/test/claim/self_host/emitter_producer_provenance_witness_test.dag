data emitter_producer_provenance_witness_note: String = "Producer/qualification construction wall witnesses (session valiant-crab-382): oracle enrollment binds minted BuildRefused quarantine receipts; frontier disposition stays SeedRetained until authorization (BuildGreen) greens. EmitterProduced count baseline is zero (review 44362). PRIMARY RED: V2EmitterInterpreted unwritable when v1.compiler.emit_rust is in closure. SECONDARY RED: flip-wave dishonest claim replay."

test fn witness_oracle_rows_all_enrolled_holds() -> Bool {
  producer_emission_oracle_rows_all_enrolled_holds()
}

test fn witness_live_roster_emitter_produced_oracle_enrolled_holds() -> Bool {
  compiler_frontier_emitter_produced_oracle_enrolled_holds()
}

test fn witness_live_roster_emitter_produced_oracle_backed_holds() -> Bool {
  compiler_frontier_emitter_produced_oracle_backed_holds()
}

test fn witness_oracle_authorization_promotion_path_holds() -> Bool {
  producer_emission_oracle_authorization_promotion_path_holds()
}

data witness_quarantine_enrolled_build_refused_does_not_authorize_red_note: String = "Review 44385 RED: quarantine oracle mint enrolls via producer_emission_receipt_from_oracle_row (BuildRefused) but authorization requires BuildGreen canonical — enrollment and authorization are split (review 44393)."

test fn witness_quarantine_enrolled_build_refused_does_not_authorize_reds() -> Bool {
  let oracle = producer_emission_oracle_row_body_producer
  match producer_emission_receipt_from_oracle_row(row: oracle) {
    Present { value: receipt } =>
      producer_emission_oracle_enrolls_row(module_path: oracle.module_path, receipt: receipt)
        && !producer_emission_oracle_authorizes_row(module_path: oracle.module_path, receipt: receipt)
    Absent => false
  }
}

fn frontier_row_is_quarantine_seed_retained(row: CompilerModuleFrontierRow) -> Bool {
  match row.disposition {
    EmitterProduced { provenance: _ } => false
    SeedRetained { reason: _, migration_trigger: _ } => true
  }
}

test fn witness_quarantine_oracle_modules_seed_retained_holds() -> Bool {
  frontier_row_is_quarantine_seed_retained(row: compiler_frontier_row_03_body_producer)
    && frontier_row_is_quarantine_seed_retained(row: compiler_frontier_row_03_normalize)
    && frontier_row_is_quarantine_seed_retained(row: compiler_frontier_row_07_target_carriers)
    && frontier_row_is_quarantine_seed_retained(row: compiler_frontier_row_discovery_enumeration)
    && frontier_row_is_quarantine_seed_retained(row: compiler_frontier_row_parse_engine_hooks)
    && frontier_row_is_quarantine_seed_retained(row: compiler_frontier_row_use_site_verdict)
}

test fn witness_producer_qualified_baselines_holds() -> Bool {
  compiler_frontier_producer_qualified_baselines_holds()
    && producer_qualified_baselines_holds()
    && (producer_emission_oracle_row_count() == seed_emitter_behavioral_quarantine_baseline)
    && (seed_emitter_behavioral_quarantine_count() == seed_emitter_behavioral_quarantine_baseline)
    && (compiler_frontier_emitter_produced_count() == emitter_produced_baseline)
    && (seed_emitter_behavioral_green_count() == seed_emitter_behavioral_green_baseline)
    && (v2_interpreted_emitter_behavioral_green_count() == 0)
    && (v2_native_emitter_behavioral_green_count() == 0)
    && (v2_emitter_production_routed_count() == 0)
}

test fn witness_emitter_produced_oracle_count_matches_baseline_holds() -> Bool {
  compiler_frontier_emitter_produced_oracle_count_matches_baseline_holds()
}

test fn witness_census_includes_producer_backing_holds() -> Bool {
  compiler_frontier_census_holds()
}

test fn witness_flip_wave_reverted_modules_lack_oracle_holds() -> Bool {
  producer_emission_flip_wave_reverted_modules_lack_oracle_holds()
}

data witness_seed_emit_rust_poison_structural_refusal_note: String = "PRIMARY discriminating RED (calm-badger-682 ruling 2026-07-29): mint_producer_emission_receipt must refuse V2EmitterInterpreted when cssl_harness_realized_closure contains v1.compiler.emit_rust. Harness poison proves the wall fires; the wall is structural in the mint path."

test fn witness_seed_emit_rust_poison_structural_refusal_reds() -> Bool {
  mint_v2_interpreted_receipt_with_seed_closure_refuses(
    module_path: "src/v2/compiler/03_body_producer.dag"
  )
}

test fn witness_v2_producer_claim_with_seed_closure_unauthorized_reds() -> Bool {
  let fabricated = fabricated_v2_interpreted_producer_receipt(
    module_path: "src/v2/compiler/03_body_producer.dag"
  )
  !producer_emission_oracle_authorizes_row(
    module_path: fabricated.module_path,
    receipt: fabricated
  )
}

data witness_flip_wave_secondary_red_note: String = "SECONDARY regression (2026-07-20 flip-wave): dishonest V1SeedEmitter claim for flip-wave module without oracle row must refuse authorization."

test fn witness_flip_wave_dishonest_v1_claim_reds() -> Bool {
  let path = "src/v2/compiler/00_compile.dag"
  let fabricated = fabricated_v1_seed_producer_receipt(module_path: path)
  !producer_emission_oracle_authorizes_row(module_path: path, receipt: fabricated)
}

test fn witness_flip_wave_all_six_dishonest_claims_red() -> Bool {
  fold_list(
    xs: producer_emission_flip_wave_reverted_module_paths,
    empty: true,
    cons: fn(ok, path) {
      ok && !producer_emission_oracle_authorizes_row(
        module_path: path,
        receipt: fabricated_v1_seed_producer_receipt(module_path: path)
      )
    }
  )
}

test fn witness_oracle_rows_match_transport_roster_holds() -> Bool {
  producer_emission_oracle_rows_match_transport_roster_holds()
}

test fn witness_synthetic_oracle_row_not_in_live_registry_reds() -> Bool {
  let red_row = producer_emission_oracle_row_00_compile_flip_wave_red
  match producer_emission_canonical_receipt_for_oracle_row(row: red_row) {
    Present { value: receipt } =>
      !producer_emission_oracle_authorizes_row(module_path: red_row.module_path, receipt: receipt)
    Absent => true
  }
}

data witness_baseline_oracle_row_quarantine_does_not_authorize_red_note: String = "Review 44350 RED: live oracle row enrolled on assemble-red quarantine must not authorize BuildGreen EmitterProduced until wet execution greens."

test fn witness_baseline_oracle_row_quarantine_does_not_authorize_reds() -> Bool {
  let oracle = producer_emission_oracle_row_body_producer
  match producer_emission_canonical_receipt_for_oracle_row(row: oracle) {
    Present { value: receipt } =>
      !producer_emission_oracle_authorizes_row(module_path: oracle.module_path, receipt: receipt)
    Absent => true
  }
}

data witness_absent_from_known_red_without_green_does_not_authorize_red_note: String = "Review 44441 RED: static oracle derivation never mints BuildGreen — a row absent from known-red still receives BuildRefused (not_executed), so authorization cannot be fabricated by roster edits."

test fn witness_absent_from_known_red_without_green_does_not_authorize_reds() -> Bool {
  let synthetic = producer_emission_oracle_row_00_compile_flip_wave_red
  match producer_emission_receipt_from_oracle_row(row: synthetic) {
    Present { value: receipt } =>
      match emission_build_result_axis(result: receipt.build_result) {
        EmissionBuildResultGreen => false
        EmissionBuildResultRefused { cause: _ } =>
          !producer_emission_oracle_authorizes_row(
            module_path: synthetic.module_path,
            receipt: receipt
          )
      }
    Absent => false
  }
}

data witness_fabricated_build_green_same_module_producer_red_note: String = "Reviews 44328/44350 RED: fabricated BuildGreen receipt must NOT authorize against a quarantine-enrolled oracle row."

test fn witness_fabricated_build_green_same_module_producer_reds() -> Bool {
  let oracle = producer_emission_oracle_row_body_producer
  let fabricated = fabricated_v1_seed_producer_receipt(module_path: oracle.module_path)
  !producer_emission_oracle_authorizes_row(module_path: oracle.module_path, receipt: fabricated)
}

test fn witness_wet_known_red_entries_is_shared_authority() -> Bool {
  schedule_witness_entries_structurally_equal(
    left: seed_emitter_behavioral_wet_known_red_entries,
    right: falsifier_self_host_wet_known_red_entries
  )
}

test fn witness_oracle_rows_bidirectional_enrollment_holds() -> Bool {
  producer_emission_oracle_rows_match_enrollment_holds()
}

test fn witness_probe_entries_length_only_parity_would_fail_on_mismatch_red() -> Bool {
  let mismatched_function = "fabricated_flip_wave_all_holds"
  let cited = schedule_witness_entry_cited(
    probe_entry: producer_emission_oracle_row_body_producer.behavioral_probe_entry,
    probe_function: mismatched_function,
    entries: seed_emitter_behavioral_wet_known_red_entries
  )
  !cited
}
