module v2.test.claim.self_host.emitter_producer_provenance_witness_test


data emitter_producer_provenance_witness_note: String = "Producer/qualification construction wall witnesses (session valiant-crab-382): oracle enrollment binds minted BuildRefused quarantine receipts; frontier authorization routes ONLY through producer_emission_canonical_receipt_for_executed_verdict (review 44480). Static oracle derivation never mints BuildGreen. PRIMARY RED: V2EmitterInterpreted unwritable when v1.compiler.emit_rust is in closure. SECONDARY RED: flip-wave dishonest claim replay."

fn witness_fabricated_executed_verdict(
  module_path: String,
  behavioral_probe_entry: String,
  behavioral_probe_function: String
) -> ProducerEmissionExecutedGreenReceipt {
  ProducerEmissionExecutedGreenReceipt {
    module_path: module_path,
    behavioral_probe_entry: behavioral_probe_entry,
    behavioral_probe_function: behavioral_probe_function,
    wet_execution_digest: content_hash_atom(value: behavioral_probe_entry)
  }
}

test fn witness_oracle_rows_all_enrolled_holds() -> Bool {
  producer_emission_oracle_rows_all_enrolled_holds()
}

test fn witness_live_roster_emitter_produced_oracle_enrolled_holds() -> Bool {
  compiler_frontier_emitter_produced_oracle_enrolled_holds()
}

test fn witness_live_roster_emitter_produced_oracle_backed_holds() -> Bool {
  compiler_frontier_emitter_produced_oracle_backed_holds()
}

test fn witness_oracle_authorization_promotion_path_holds() -> Bool {
  producer_emission_oracle_authorization_promotion_path_holds()
    && producer_emission_binding_only_does_not_authorize_holds()
    && producer_emission_oracle_authorization_requires_executed_verdict_holds()
    && mint_authorized_emitter_produced_disposition_refused_at_baseline_holds()
    && hand_forged_emitter_produced_authorization_fails_mint_consistency_holds()
    && hand_forged_matching_token_unauthorized_still_fails_mint_consistency_holds()
}

data witness_hand_forged_emitter_produced_authorization_red_note: String = "Review 44487 RED: hand-constructed AuthorizedEmitterProducedDisposition (wrong or derivable-matching token) must fail authorized_emitter_produced_disposition_mint_consistent — derivation+authorize, not record opacity."

test fn witness_hand_forged_emitter_produced_authorization_fails_mint_consistency_reds() -> Bool {
  hand_forged_emitter_produced_authorization_fails_mint_consistency_holds()
    && hand_forged_matching_token_unauthorized_still_fails_mint_consistency_holds()
}

data witness_emitter_produced_unauthorized_disposition_red_note: String = "Review 44570 RED: EmitterProduced disposition requires authorization_binding in the variant — roster rows must be mint-consistent; promotions empty at baseline."

test fn witness_emitter_produced_unauthorized_disposition_unrepresentable_reds() -> Bool {
  emitter_produced_unauthorized_disposition_unrepresentable_holds()
    && compiler_frontier_emitter_produced_authorization_mint_consistent_holds()
}

data witness_restored_binding_without_executed_receipt_red_note: String = "Review 44455/44460 RED: roster edits and static oracle derivation cannot mint BuildGreen — authorization requires witness-realization mint with admissible wet_execution_digest."

test fn witness_restored_binding_without_executed_receipt_does_not_authorize_reds() -> Bool {
  producer_emission_binding_only_does_not_authorize_holds()
}

data witness_executed_verdict_minting_refused_at_baseline_red_note: String = "Review 44468 RED: producer_emission_canonical_receipt_for_executed_verdict is unwritable at baseline — no synthesizable executed receipt from declarative oracle fields can mint BuildGreen."

test fn witness_executed_verdict_minting_refused_at_baseline_reds() -> Bool {
  producer_emission_executed_verdict_minting_refused_at_baseline_holds()
}

data witness_synthesizable_executed_digest_refused_red_note: String = "Review 44477 RED: declarative-input wet_execution_digest (content_hash_atom of probe entry) is refused before execution_measured admissibility — synthesizable digest cannot mint BuildGreen even when row identity matches."

test fn witness_synthesizable_executed_digest_refused_reds() -> Bool {
  let row = producer_emission_oracle_row_body_producer
  let executed = ProducerEmissionExecutedGreenReceipt {
    module_path: row.module_path,
    behavioral_probe_entry: row.behavioral_probe_entry,
    behavioral_probe_function: row.behavioral_probe_function,
    wet_execution_digest: content_hash_atom(value: row.behavioral_probe_entry)
  }
  match producer_emission_canonical_receipt_for_executed_verdict(row: row, executed: executed) {
    Absent => true
    Present { value: _ } => false
  }
}

data witness_quarantine_enrolled_build_refused_does_not_authorize_red_note: String = "Review 44385 RED: quarantine oracle mint enrolls via producer_emission_receipt_from_oracle_row (BuildRefused) but authorization requires BuildGreen canonical — enrollment and authorization are split (review 44393)."

test fn witness_quarantine_enrolled_build_refused_does_not_authorize_reds() -> Bool {
  let oracle = producer_emission_oracle_row_body_producer
  match producer_emission_receipt_from_oracle_row(row: oracle) {
    Present { value: receipt } =>
      producer_emission_oracle_enrolls_row(module_path: oracle.module_path, receipt: receipt)
        && !producer_emission_oracle_authorizes_row(
          module_path: oracle.module_path,
          receipt: receipt,
          executed: witness_fabricated_executed_verdict(
            module_path: oracle.module_path,
            behavioral_probe_entry: oracle.behavioral_probe_entry,
            behavioral_probe_function: oracle.behavioral_probe_function
          )
        )
    Absent => false
  }
}

