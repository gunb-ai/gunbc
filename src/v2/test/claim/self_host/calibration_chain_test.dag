}

test fn calib_a1_diagnostic_pin() -> Bool {
  calib_a1_receipt().located_reason == ^resolve_module_not_found
}

test fn calib_chain_stops_at_a1_holds() -> Bool {
  calib_probe_crosses_assembly(receipt: calib_a0_receipt())
    && !calib_a1_crosses_assembly()
}

