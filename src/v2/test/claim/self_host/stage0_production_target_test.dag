module v2.test.self_host.stage0_production_target

import v2.compiler.infer { infer }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.self_host.candidate_generation {
  generate_rust_module_emission_candidate
}
import v2.compiler.self_host.stage0_production_target {
  stage0_production_target_model
}
import v2.compiler.source_authority { SourceRef }
import v2.compiler.source_authority_read {
  source_ref_for_observed_storage_path,
  source_root_ingest_from_source_refs
}
import v2.extdeps.languages.dag { dag_language_model }
import v2.extdeps.languages.rust { rust_target_model }
import std.algebra { Cons, Empty }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// WHAT THE STAGE0 CRATE REQUIRES OF A MODULE EMITTED INTO IT, MEASURED OVER THE DISK ROUTE.
//
// The committed mirror of a stage0 module is `pub` and carries i64, because the crate's other
// modules call across module boundaries and the crate's ABI is i64. The Rust language model
// alone produces neither: the .dag source spells no visibility, and the base Rust target
// realizes the language's Int as i32. v2.compiler.self_host.stage0_production_target is the
// profile that selects both AT THIS BOUNDARY, and these claims are what make the selections
// load-bearing rather than decorative.
//
// The two negative arms are the discriminating controls the ruling asks for, one per capability
// class, and they are not one generic malformed-output check: the visibility control observes
// the base target emitting an item with no `pub` (which the crate's real consumer of
// gunbc_rust_decl_type_overlay could not resolve across the module boundary), and the carrier
// control observes the base target emitting i32 at the exact position the stage0 ABI requires
// i64. Each fails for its own reason, so a regression in one cannot be masked by the other.
// They also pin that the profile did not globally relabel the base target: the direct-door
// fixtures remain organized around an i32, visibility-free Rust realization and must stay so.
data stage0_boundary_probe_path: String = "src/v2/compiler/self_host/stage0_boundary_add_probe.dag"

data stage0_boundary_expected_source: String = "pub fn probe_add(x: i64, y: i64) -> i64 { x + y }"

data stage0_boundary_base_target_source: String = "fn probe_add(x: i32, y: i32) -> i32 { x + y }"

data stage0_boundary_emit_refused: String = "stage0-boundary-emit-refused"

fn stage0_boundary_probe_ref() -> SourceRef {
  source_ref_for_observed_storage_path(path: stage0_boundary_probe_path)
}

fn stage0_boundary_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: Cons { head: ^stage0_boundary_add_probe, tail: Empty }
    },
    imports: Empty
  }
}

// The emitted text, or a single refusal sentinel. A refusal cannot be confused with a real
// emission: the sentinel is not Rust and matches no expectation below, so every arm reds on a
// route that stopped rather than reading a stage's silence as agreement.
fn stage0_boundary_emitted_source_for(target: TargetModel) -> String {
  match source_root_ingest_from_source_refs(
    refs: Cons { head: stage0_boundary_probe_ref(), tail: Empty }
  ) {
    Rejected { diagnostics: _ } => stage0_boundary_emit_refused
    Accepted { value: ingest, diagnostics: _ } =>
      match assemble_program_from_ingest(
        ingest: ingest,
        admission: stage0_boundary_admission(),
        lm: dag_language_model()
      ) {
        Rejected { diagnostics: _ } => stage0_boundary_emit_refused
        Accepted { value: resolved, diagnostics: _ } =>
          match infer(tree: resolved) {
            Rejected { diagnostics: _ } => stage0_boundary_emit_refused
            Accepted { value: inferred, diagnostics: _ } =>
              match generate_rust_module_emission_candidate(
                inferred: inferred,
                target: target
              ) {
                Rejected { diagnostics: _ } => stage0_boundary_emit_refused
                Accepted { value: candidate, diagnostics: _ } => candidate.source.carried
              }
          }
      }
  }
}

test fn stage0_production_target_emits_boundary_compatible_source_holds() -> Bool {
  stage0_boundary_emitted_source_for(target: stage0_production_target_model())
    == stage0_boundary_expected_source
}

test fn stage0_visibility_selection_is_load_bearing_holds() -> Bool {
  stage0_boundary_emitted_source_for(target: rust_target_model())
    != stage0_boundary_expected_source
}

test fn stage0_base_target_stays_private_and_i32_holds() -> Bool {
  stage0_boundary_emitted_source_for(target: rust_target_model())
    == stage0_boundary_base_target_source
}
