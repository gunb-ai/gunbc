module v2.test.claim.self_host.closure_emission

import extdeps.communication.medium { Lossless, Medium }
import extdeps.languages.json.emit { JsonArray, JsonValue }
import v2.std.integer { Int }
import v2.std.provenance { SpanIndex }
import extdeps.languages.json.parse {
  FieldRead,
  JsonDocumentParsed,
  JsonDocumentUnreadable,
  json_field,
  json_field_int,
  json_field_string,
  json_field_string_list,
  parse_json_document
}
import std.algebra { Cons, Empty, FreeMonoid, contains, fold_list, length, list_find_first }
import std.optional { Absent, Optional, Present }
import v2.compiler.self_host.closure_emission {
  ClosureEmission,
  ClosureEmissionLocated,
  ClosureMemberEmission,
  ClosureMemberEmitted,
  ClosureMemberRefused,
  closure_emission_first_refusal,
  closure_emission_json,
  closure_emission_refused_count,
  emit_closure_from_ingest_located
}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.extdeps.languages.rust { rust_target_model }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_fatal_reason }
import v2.std.lens_verdict { lens_verdict_diagnostics_located_chain_text_in_spans }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, Symbol, node_synthetic }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string, qualified_name_to_dotted_string }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE DOOR'S CLAIMS, over inline ingests. The ingest a scenario supplies is what the acquirer
// (v2.compiler.module_acquisition) hands the door: the modules some import, member binding or
// qualified reference requested and nothing else. The acquirer's own claims discriminate what it
// reads; these discriminate what the door does with what it was given, at that one interface:
//   - an acquired closure is emitted as one typed arm per member, in acquisition order;
//   - a file in the ingest that does not parse refuses the emission, because a module whose text
//     cannot be read cannot be a member;
//   - one module identity declared by two files refuses the emission at both files;
//   - an entry the ingest does not hold was not acquired for it and is refused, never replaced by
//     some other module;
//   - a member whose body does not lower is that member's typed arm, kept beside the others;
//   - a name the ingest does not bind is its member's typed arm, and the closure is never widened
//     to hold the module that would have bound it.
// Each scenario's whole emission is a NULLARY PRODUCER, because the front end, resolution and
// emission of even a two-module corpus cost more than a new witness may spend (the measured reason
// v2.test.claim.reference_closure and cross_module_reference_resolution share theirs): the real
// door runs once at preparation and every claim reads the carrier it produced.
//
// THE INHABITANCE CLAIM for these supplied ingests is not a claim in this file: the real producer of
// the ingest is the acquirer reading the repository through the layout, and the door that composes
// the two on the real files is executed by every subject step of the required gate
// (gunbc.emitted_subject_build_gate emitted_subject_build_rows), where deleting the acquirer or the
// door makes the emitted compiler fail to build.

data ce_entry_source: String = "module v2.test.ce_entry\n\nimport std.types { Bool }\n\nfn ce_entry_fn(p: Bool) -> Bool { v2.test.ce_member.ce_member_fn(p: p) }\n"

data ce_member_source: String = "module v2.test.ce_member\n\nimport std.types { Bool }\n\nfn ce_member_fn(p: Bool) -> Bool { p }\n"

// F1/F2: an importer over a module that IS in the closure (import-free, non-generic), and one over a
// module that is NOT. Both import by name, so import admission must find (or fail to find) the target
// among the closure's roots.
data ce_base_source: String = "module v2.test.ce_base\n\ntype CeBase = CeBaseA | CeBaseB\n"

data ce_importer_source: String = "module v2.test.ce_importer\n\nimport v2.test.ce_base { CeBase }\n\nfn ce_importer_fn(p: CeBase) -> CeBase { p }\n"

data ce_absent_importer_source: String = "module v2.test.ce_absent_importer\n\nimport v2.test.ce_absent { CeAbsent }\n\nfn ce_absent_importer_fn(p: CeAbsent) -> CeAbsent { p }\n"

data ce_unbound_name_source: String = "module v2.test.ce_unbound_name\n\nimport v2.std.logic { Bool }\n\nfn ce_unbound_name_fn(p: Bool) -> Bool { ce_no_such_fn(p) }\n"

data ce_logic_source: String = "module v2.std.logic\n\ntype Bool = True | False\n"

// Two files declaring ONE module identity with INDEPENDENT declarations: the case most likely to pass
// silently, since neither file's declarations collide with the other's.
data ce_duplicate_a_source: String = "module v2.test.ce_duplicate\n\nimport std.types { Bool }\n\nfn ce_duplicate_a(p: Bool) -> Bool { p }\n"

data ce_duplicate_b_source: String = "module v2.test.ce_duplicate\n\nimport std.types { Bool }\n\nfn ce_duplicate_b(p: Bool) -> Bool { p }\n"

data ce_unparseable_source: String = "module v2.test.ce_unparseable\nfn ce_broken( -> Int { x }\n"

// A member whose body does not lower: the entry reaches it, so the refusal is a member's.
data ce_refusing_entry_source: String = "module v2.test.ce_refusing_entry\n\nimport std.types { Bool }\n\nfn ce_refusing_entry_fn(p: Bool) -> Bool { v2.test.ce_refusing_member.ce_refusing_fn(p: p) }\n"

data ce_refusing_member_source: String = "module v2.test.ce_refusing_member\n\nimport std.types { Bool }\n\nfn ce_refusing_fn(p: Bool) -> Bool { if p { p } }\n"

fn ce_read(source: String, id: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: id,
    source_root: DagTree
  }
}

fn ce_locus() -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^ce_entry_locus } }, children: [])
}

fn ce_emit(ingest: SourceRootIngest, entry: String) -> ClosureEmissionLocated {
  emit_closure_from_ingest_located(
    ingest: ingest,
    entry: qualified_name_from_dotted_string(dotted: entry),
    entry_locus: ce_locus(),
    target: rust_target_model()
  )
}

fn ce_logic_read() -> DagSourceReadWitness {
  ce_read(source: ce_logic_source, id: ^ce_logic_read, path: "src/v2/std/logic.dag")
}

fn ce_emission_clean() -> ClosureEmissionLocated {
  ce_emit(
    ingest: [
      ce_logic_read(),
      ce_read(source: ce_entry_source, id: ^ce_entry_read, path: "src/v2/test/ce_entry.dag"),
      ce_read(source: ce_member_source, id: ^ce_member_read, path: "src/v2/test/ce_member.dag")
    ],
    entry: "v2.test.ce_entry"
  )
}

fn ce_emission_unparseable_file() -> ClosureEmissionLocated {
  ce_emit(
    ingest: [
      ce_logic_read(),
      ce_read(source: ce_unparseable_source, id: ^ce_unparseable_read, path: "src/v2/test/ce_unparseable.dag")
    ],
    entry: "v2.std.logic"
  )
}

fn ce_emission_duplicate_module() -> ClosureEmissionLocated {
  ce_emit(
    ingest: [
      ce_logic_read(),
      ce_read(source: ce_duplicate_a_source, id: ^ce_duplicate_a_read, path: "src/v2/test/ce_duplicate_a.dag"),
      ce_read(source: ce_duplicate_b_source, id: ^ce_duplicate_b_read, path: "src/v2/test/ce_duplicate_b.dag")
    ],
    entry: "v2.std.logic"
  )
}

fn ce_emission_entry_not_acquired() -> ClosureEmissionLocated {
  ce_emit(ingest: [ce_logic_read()], entry: "v2.test.ce_entry")
}

fn ce_emission_member_body_refuses() -> ClosureEmissionLocated {
  ce_emit(
    ingest: [
      ce_logic_read(),
      ce_read(source: ce_refusing_entry_source, id: ^ce_refusing_entry_read, path: "src/v2/test/ce_refusing_entry.dag"),
      ce_read(source: ce_refusing_member_source, id: ^ce_refusing_member_read, path: "src/v2/test/ce_refusing_member.dag")
    ],
    entry: "v2.test.ce_refusing_entry"
  )
}

// The entry names a module the ingest does not hold. A hand-built ingest can be short of what its
// entry needs, though the acquirer's cannot be; the door must say so at the member and not repair it.
fn ce_emission_unbound_name() -> ClosureEmissionLocated {
  ce_emit(
    ingest: [
      ce_logic_read(),
      ce_read(source: ce_entry_source, id: ^ce_entry_read, path: "src/v2/test/ce_entry.dag")
    ],
    entry: "v2.test.ce_entry"
  )
}

fn ce_emission_import_present() -> ClosureEmissionLocated {
  ce_emit(
    ingest: [
      ce_logic_read(),
      ce_read(source: ce_base_source, id: ^ce_base_read, path: "src/v2/test/ce_base.dag"),
      ce_read(source: ce_importer_source, id: ^ce_importer_read, path: "src/v2/test/ce_importer.dag")
    ],
    entry: "v2.test.ce_importer"
  )
}

fn ce_emission_import_absent() -> ClosureEmissionLocated {
  ce_emit(
    ingest: [
      ce_logic_read(),
      ce_read(source: ce_absent_importer_source, id: ^ce_absent_importer_read, path: "src/v2/test/ce_absent_importer.dag")
    ],
    entry: "v2.test.ce_absent_importer"
  )
}

fn ce_emission_unbound_symbol() -> ClosureEmissionLocated {
  ce_emit(
    ingest: [
      ce_logic_read(),
      ce_read(source: ce_unbound_name_source, id: ^ce_unbound_name_read, path: "src/v2/test/ce_unbound_name.dag")
    ],
    entry: "v2.test.ce_unbound_name"
  )
}

fn ce_qn_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  a == b
}

fn ce_members_are(e: ClosureEmission, expected: FreeMonoid<String>) -> Bool {
  length(xs: e.members) == length(xs: expected)
    && fold_list(xs: expected, empty: true, cons: fn(ok, name) {
      ok && contains(xs: e.members, item: qualified_name_from_dotted_string(dotted: name), eq: ce_qn_eq)
    })
}

fn ce_arm_module(m: ClosureMemberEmission) -> String {
  match m {
    ClosureMemberEmitted { module: q, text: _ } => qualified_name_to_dotted_string(qn: q)
    ClosureMemberRefused { module: q, diagnostics: _ } => qualified_name_to_dotted_string(qn: q)
  }
}

fn ce_arm_is_emitted(m: ClosureMemberEmission) -> Bool {
  match m {
    ClosureMemberEmitted { module: _, text: _ } => true
    ClosureMemberRefused { module: _, diagnostics: _ } => false
  }
}

// How many arms the carrier holds for one module identity. A member owes exactly one.
fn ce_arm_count(e: ClosureEmission, name: String) -> Int {
  fold_list(xs: e.modules, empty: 0, cons: fn(n, m) {
    if ce_arm_module(m: m) == name { n + 1 } else { n }
  })
}

// The arm a member's identity carries, if the carrier holds one.
fn ce_arm_of(e: ClosureEmission, name: String) -> Optional<ClosureMemberEmission> {
  list_find_first(xs: e.modules, predicate: fn(m) { ce_arm_module(m: m) == name })
}

fn ce_arm_of_is_emitted(arm: Optional<ClosureMemberEmission>) -> Bool {
  match arm {
    Absent => false
    Present { value: found } => ce_arm_is_emitted(m: found)
  }
}

fn ce_arm_is_refused_with(arm: Optional<ClosureMemberEmission>, reason: Symbol) -> Bool {
  match arm {
    Absent => false
    Present { value: found } =>
      match found {
        ClosureMemberEmitted { module: _, text: _ } => false
        ClosureMemberRefused { module: _, diagnostics: d } => diagnostics_fatal_reason(d: d) == reason
      }
  }
}

fn ce_arm_is_refused(arm: Optional<ClosureMemberEmission>) -> Bool {
  match arm {
    Absent => false
    Present { value: found } => !ce_arm_is_emitted(m: found)
  }
}

// DIRECTION 1. An acquired closure is emitted whole: the members are exactly the ingest's, and every
// member -- entry, member and v2.std.logic -- has EXACTLY ONE arm, so a duplicated arm or a missing one
// reds. Whether a member's arm is Emitted or a typed Refused is the emit stages' answer, not the door's
// (on this tree an ordinary fn can still answer translate_rejected_grounding_not_derived, v2.compiler.infer's
// grounding frontier), and a refusal is carried as the member's arm rather than stopping the others.
test fn an_acquired_closure_is_emitted_as_exactly_one_arm_per_member_holds() -> Bool {
  match ce_emission_clean().outcome {
    Rejected { diagnostics: _ } => false
    Accepted { value: e, diagnostics: _ } =>
      ce_members_are(e: e, expected: ["v2.test.ce_entry", "v2.test.ce_member", "v2.std.logic"])
        && length(xs: e.modules) == 3
        && ce_arm_count(e: e, name: "v2.test.ce_entry") == 1
        && ce_arm_count(e: e, name: "v2.test.ce_member") == 1
        && ce_arm_count(e: e, name: "v2.std.logic") == 1
  }
}

// DIRECTION 2. A file in the ingest that does not parse refuses the emission: its declarations are
// unreadable, so it cannot be a member and nothing it declares can be bound.
test fn a_file_in_the_closure_that_does_not_parse_refuses_the_emission_holds() -> Bool {
  match ce_emission_unparseable_file().outcome {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

// DIRECTION 3. A module identity declared by two files refuses the emission at the wall that sees the
// whole ingest, even when the two files' declarations are independent, and it LOCATES BOTH FILES
// because a collision is a two-place fact. The acquirer cannot produce such an ingest (it reads one
// file per requested name), so this is the door's input contract for a hand-built one.
test fn two_files_declaring_one_module_refuse_the_emission_at_both_files_holds() -> Bool {
  let located = ce_emission_duplicate_module()
  match located.outcome {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      diagnostics_fatal_reason(d: d) == ^closure_census_duplicate_module
        && string_contains(
          s: lens_verdict_diagnostics_located_chain_text_in_spans(d: d, index: located.spans),
          pattern: "ce_duplicate_a_read"
        )
        && string_contains(
          s: lens_verdict_diagnostics_located_chain_text_in_spans(d: d, index: located.spans),
          pattern: "ce_duplicate_b_read"
        )
  }
}

// DIRECTION 4. An entry the ingest does not hold was not acquired for it. The refusal is located at
// the entry's locus and states why; the door never emits some other module in its place.
test fn an_entry_the_ingest_does_not_hold_is_refused_as_not_acquired_holds() -> Bool {
  match ce_emission_entry_not_acquired().outcome {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == ^closure_emission_entry_not_acquired
  }
}

// DIRECTION 5. A member whose body does not lower is THAT MEMBER'S typed arm, at its own cause:
// resolution and emission answer per member, so one member's refusal neither aborts the others nor
// disappears into a whole-emission failure. The carrier is accepted, and the refused arm is the
// refusing module's (v2.compiler.body_lowering_fold body_lower_fn_decl_to_arrow refuses the else-less `if`).
test fn a_closure_member_whose_body_does_not_lower_is_its_own_typed_refusal_holds() -> Bool {
  match ce_emission_member_body_refuses().outcome {
    Rejected { diagnostics: _ } => false
    Accepted { value: e, diagnostics: _ } =>
      length(xs: e.modules) == 3
        && ce_arm_count(e: e, name: "v2.test.ce_refusing_member") == 1
        && ce_arm_is_refused_with(arm: ce_arm_of(e: e, name: "v2.test.ce_refusing_member"), reason: ^body_lowering_reason_else_less_if_unlowered)
  }
}

fn ce_first_refused_reason(e: ClosureEmission) -> Optional<Symbol> {
  match list_find_first(xs: e.modules, predicate: fn(m) { !ce_arm_is_emitted(m: m) }) {
    Absent => Absent
    Present { value: found } =>
      match found {
        ClosureMemberEmitted { module: _, text: _ } => Absent
        ClosureMemberRefused { module: _, diagnostics: d } => Present { value: diagnostics_fatal_reason(d: d) }
      }
  }
}

fn ce_first_refusal_reason(e: ClosureEmission) -> Optional<Symbol> {
  match closure_emission_first_refusal(emission: e) {
    Absent => Absent
    Present { value: d } => Present { value: diagnostics_fatal_reason(d: d) }
  }
}

fn ce_reasons_agree(a: Optional<Symbol>, b: Optional<Symbol>) -> Bool {
  match a {
    Absent => match b { Absent => false
      Present { value: _ } => false }
    Present { value: x } =>
      match b {
        Absent => false
        Present { value: y } => x == y
      }
  }
}

// A consumer that must state ONE located cause (the CLI's failing status) reads the first refusal in
// acquisition order. It is derived here a second way -- the first refused arm of the carrier -- and the
// two causes must be the same member's, so a first-refusal that skipped an arm or took the last one
// reds; and the refusal count is the number of refused arms, at least the refusing member's.
test fn the_first_refusal_of_a_closure_is_the_first_refused_arms_cause_holds() -> Bool {
  match ce_emission_member_body_refuses().outcome {
    Rejected { diagnostics: _ } => false
    Accepted { value: e, diagnostics: _ } =>
      closure_emission_refused_count(emission: e) >= 1
        && ce_reasons_agree(a: ce_first_refused_reason(e: e), b: ce_first_refusal_reason(e: e))
  }
}

// DIRECTION 6. A name the ingest does not bind is its member's typed refusal, and the closure stays
// exactly what the ingest holds: the door does not go and read the module that would have bound it
// (a hand-built ingest short of its entry's needs is a defect at the supplier, never widened here).
test fn a_name_the_ingest_does_not_bind_refuses_its_member_and_never_widens_the_closure_holds() -> Bool {
  match ce_emission_unbound_name().outcome {
    Rejected { diagnostics: _ } => false
    Accepted { value: e, diagnostics: _ } =>
      ce_members_are(e: e, expected: ["v2.test.ce_entry", "v2.std.logic"])
        && length(xs: e.modules) == 2
        && ce_arm_is_refused(arm: ce_arm_of(e: e, name: "v2.test.ce_entry"))
  }
}

// F1 (T4 S2). An importer over a module the closure holds resolves its import against the CLOSURE's
// roots and is emitted; the import-free base is its own arm. Before the closure-wide context every
// importer answered resolve_module_not_found whatever it imported.
test fn an_importer_over_a_module_the_closure_holds_is_emitted_holds() -> Bool {
  match ce_emission_import_present().outcome {
    Rejected { diagnostics: _ } => false
    Accepted { value: e, diagnostics: _ } =>
      ce_arm_of_is_emitted(arm: ce_arm_of(e: e, name: "v2.test.ce_importer"))
        && ce_arm_count(e: e, name: "v2.test.ce_base") == 1
  }
}

// F2 (control). An import of a module absent from the closure still refuses resolve_module_not_found,
// at that member: sharing the closure's roots must not widen what an import may bind.
test fn an_import_of_a_module_absent_from_the_closure_still_refuses_resolve_module_not_found_holds() -> Bool {
  match ce_emission_import_absent().outcome {
    Rejected { diagnostics: _ } => false
    Accepted { value: e, diagnostics: _ } =>
      ce_arm_is_refused_with(arm: ce_arm_of(e: e, name: "v2.test.ce_absent_importer"), reason: ^resolve_module_not_found)
  }
}

// ONE PARSED ROW AGAINST ONE CARRIER ARM: the same module identity, and exactly one of `emitted` /
// `refused`, the one the arm is.
fn ce_row_matches(row: JsonValue, arm: ClosureMemberEmission) -> Bool {
  let emitted = match json_field_string(obj: row, key: "emitted") { FieldRead { value: _ } => true
    _ => false }
  let refused = match json_field_string(obj: row, key: "refused") { FieldRead { value: _ } => true
    _ => false }
  (match json_field_string(obj: row, key: "module") {
    FieldRead { value: name } => name == ce_arm_module(m: arm)
    _ => false
  })
    && (emitted != refused)
    && (emitted == ce_arm_is_emitted(m: arm))
}

// Two lists, position by position: equal length and every position agrees.
fn ce_rows_match(rows: FreeMonoid<JsonValue>, arms: FreeMonoid<ClosureMemberEmission>) -> Bool {
  match rows {
    Empty => match arms { Empty => true
      Cons { head: _, tail: _ } => false }
    Cons { head: r, tail: rs } =>
      match arms {
        Empty => false
        Cons { head: a, tail: as_ } => ce_row_matches(row: r, arm: a) && ce_rows_match(rows: rs, arms: as_)
      }
  }
}

fn ce_names_match(names: FreeMonoid<String>, members: FreeMonoid<QualifiedName>) -> Bool {
  match names {
    Empty => match members { Empty => true
      Cons { head: _, tail: _ } => false }
    Cons { head: n, tail: ns } =>
      match members {
        Empty => false
        Cons { head: m, tail: ms } => n == qualified_name_to_dotted_string(qn: m) && ce_names_match(names: ns, members: ms)
      }
  }
}

// THE CODEC ROUND TRIP AT IDENTITY GRAIN: the rendering parses back through the codec's other
// direction, the entry and the ORDERED member identities come back equal, and row by row the modules
// come back as the same identities, each with exactly one of emitted/refused matching its arm. A
// serializer that repeated one name, dropped an arm, or swapped emitted for refused reds here.
fn ce_round_trip_holds(e: ClosureEmission, spans: SpanIndex) -> Bool {
  match parse_json_document(s: closure_emission_json(emission: e, spans: spans)) {
    JsonDocumentUnreadable { gap: _ } => false
    JsonDocumentParsed { value: doc } =>
      (match json_field_string(obj: doc, key: "entry") {
        FieldRead { value: entry } => entry == qualified_name_to_dotted_string(qn: e.entry)
        _ => false
      })
        && (match json_field_string_list(obj: doc, key: "members") {
          FieldRead { value: names } => ce_names_match(names: names, members: e.members)
          _ => false
        })
        && (match json_field(obj: doc, key: "modules") {
          FieldRead { value: JsonArray { elements: rows } } => ce_rows_match(rows: rows, arms: e.modules)
          _ => false
        })
  }
}

test fn the_emission_renders_through_its_codec_and_reads_back_the_same_identities_holds() -> Bool {
  let located = ce_emission_clean()
  match located.outcome {
    Rejected { diagnostics: _ } => false
    Accepted { value: e, diagnostics: _ } => ce_round_trip_holds(e: e, spans: located.spans)
  }
}

// The parsed row the rendering holds for one module identity, if any.
fn ce_row_of(located: ClosureEmissionLocated, name: String) -> Optional<JsonValue> {
  match located.outcome {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: e, diagnostics: _ } =>
      match parse_json_document(s: closure_emission_json(emission: e, spans: located.spans)) {
        JsonDocumentUnreadable { gap: _ } => Absent
        JsonDocumentParsed { value: doc } =>
          match json_field(obj: doc, key: "modules") {
            FieldRead { value: JsonArray { elements: rows } } =>
              list_find_first(xs: rows, predicate: fn(r) {
                match json_field_string(obj: r, key: "module") {
                  FieldRead { value: m } => m == name
                  _ => false
                }
              })
            _ => Absent
          }
      }
  }
}

fn ce_field_string_is(obj: JsonValue, key: String, expected: String) -> Bool {
  match json_field_string(obj: obj, key: key) {
    FieldRead { value: v } => v == expected
    _ => false
  }
}

fn ce_field_int_present(obj: JsonValue, key: String) -> Bool {
  match json_field_int(obj: obj, key: key) {
    FieldRead { value: _ } => true
    _ => false
  }
}

// RED (emit per-module diagnostic). A member refused on an unbound name renders, beside the unchanged
// `refused` reason, a `diagnostic` carrying the reason, the SPELLING the author wrote, and the authored
// file and byte range -- as fields, so a population of refusals groups by spelling without parsing a sentence.
test fn a_refused_row_carries_the_unbound_spelling_and_its_authored_position_holds() -> Bool {
  match ce_row_of(located: ce_emission_unbound_symbol(), name: "v2.test.ce_unbound_name") {
    Absent => false
    Present { value: row } =>
      ce_field_string_is(obj: row, key: "refused", expected: "resolve_reason_unbound_symbol")
        && (match json_field(obj: row, key: "diagnostic") {
          FieldRead { value: d } =>
            ce_field_string_is(obj: d, key: "reason", expected: "resolve_reason_unbound_symbol")
              && ce_field_string_is(obj: d, key: "unbound_ref", expected: "ce_no_such_fn")
              && ce_field_string_is(obj: d, key: "file", expected: "ce_unbound_name_read")
              && ce_field_int_present(obj: d, key: "start")
              && ce_field_int_present(obj: d, key: "end")
          _ => false
        })
  }
}

// A refusal with no unbound mention says so with an explicit absence, not an invented spelling.
test fn a_refused_row_without_an_unbound_mention_has_an_explicit_absent_spelling_holds() -> Bool {
  match ce_row_of(located: ce_emission_import_absent(), name: "v2.test.ce_absent_importer") {
    Absent => false
    Present { value: row } =>
      match json_field(obj: row, key: "diagnostic") {
        FieldRead { value: d } =>
          ce_field_string_is(obj: d, key: "reason", expected: "resolve_module_not_found")
            && (match json_field_string(obj: d, key: "unbound_ref") { FieldAbsent => true
              _ => false })
        _ => false
      }
  }
}

// CONTROL. An emitting member's row is unchanged: `emitted` and no `diagnostic`.
test fn an_emitted_row_carries_no_diagnostic_holds() -> Bool {
  match ce_row_of(located: ce_emission_import_present(), name: "v2.test.ce_importer") {
    Absent => false
    Present { value: row } =>
      (match json_field_string(obj: row, key: "emitted") { FieldRead { value: _ } => true
        _ => false })
        && (match json_field(obj: row, key: "diagnostic") { FieldAbsent => true
          _ => false })
  }
}

// PROBE (not a claim, not for landing): the observed result of the unbound-name fixture as text.
// A rejected ingest (the fixture did not parse or the door refused before any row) shows its located
// chain; an accepted one shows the whole emission JSON, rows and diagnostic fields included.
fn ce_probe_unbound_text() -> String {
  let located = ce_emission_unbound_symbol()
  match located.outcome {
    Rejected { diagnostics: d } =>
      concat("REJECTED: ", lens_verdict_diagnostics_located_chain_text_in_spans(d: d, index: located.spans))
    Accepted { value: e, diagnostics: _ } =>
      concat("ACCEPTED: ", closure_emission_json(emission: e, spans: located.spans))
  }
}
