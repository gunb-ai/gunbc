module v2.test.claim.self_host.stage0_unary_not_probe

// Companion SUBJECT probe to stage0_production_corpus_probe, recording the ONE-OPERAND PREFIX
// (boolean not) operator case BEFORE any lowering claims it. It reuses the EXACT door,
// coproduct-variant matching and reason capture of the live corpus probe
// (v2.compiler.self_host.candidate_generation::observe_provenanced_rust_emission_from_ingest),
// but over a dedicated unary-not subject
// (v2.test.claim.self_host.unary_not_value_subject_fixture: `fn not_subject(x: Bool) -> Bool { !x }`).
//
// Point: lowering the corpus subject's outer Conj must not be able to claim that subject emits
// while the prefix operator is still unexercised on the Rust target. These claims record WHICH
// stage refuses the unary-not subject and WHETHER the refusal is the generic transform-shape
// reason. Executed verdicts (released claim_batch 9cb21df4c20325fc53ba4187cf4c55bd08037862a45d3900c5cc5519e360a177,
// roots dag + src/v2, main cba6eac3): FAIL emits / PASS refused_at_emission / FAIL
// refused_at_inference / PASS first_refusal_is_transform_shape -- i.e. `!x` reaches emission and
// is refused there under the generic target_value_expr_reason_transform_shape_invalid, so the
// prefix operator currently has no named refusal and no Rust realization row.
//
// No src/v2 lowering, no catalog row, no new reason symbols: only existing symbols plus the
// string-lexeme comparison of the observed diagnostic reason.

import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
  ProvenancedRustEmissionObservation,
  observe_provenanced_rust_emission_from_ingest
}
import v2.compiler.self_host.stage0_production_target { stage0_production_target_model }
import v2.compiler.source_authority { SourceRef }
import v2.compiler.source_authority_read {
  source_ref_for_observed_storage_path,
  source_root_ingest_from_source_refs
}
import std.algebra { Cons, Empty }
import std.types { Bool, Int }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_reason_lexemes }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }

data subject_path: String = "src/v2/test/claim/self_host/unary_not_value_subject_fixture.dag"
data subject_name: String = "v2.test.claim.self_host.unary_not_value_subject_fixture"

fn subject_refs() -> List<SourceRef> {
  Cons {
    head: source_ref_for_observed_storage_path(path: subject_path, source_root: DagTree),
    tail: Empty
  }
}

fn subject_admission() -> Admission {
  Admission {
    subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject_name) },
    imports: Empty
  }
}

fn corpus_door() -> Outcome<ProvenancedRustEmissionObservation> {
  match source_root_ingest_from_source_refs(refs: subject_refs()) {
    Accepted { value: ingest, diagnostics: d } =>
      Accepted {
        value: observe_provenanced_rust_emission_from_ingest(
          ingest: ingest,
          admission: subject_admission(),
          target: stage0_production_target_model(),
          module_path: subject_path
        ),
        diagnostics: d
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn corpus_reason() -> String {
  match corpus_door() {
    Accepted { value: EmissionRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: AssemblyRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: InferenceRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ProducerReceiptRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => "artifact-produced"
    Rejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
  }
}

// Expect FAIL: the unary-not subject must NOT emit today (prefix operator unexercised on Rust).
test fn unary_not_subject_emits_holds() -> Bool {
  match corpus_door() {
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => true
    _ => false
  }
}

// Which stage refuses it (emission is the observed one).
test fn unary_not_subject_refused_at_emission_holds() -> Bool {
  match corpus_door() {
    Accepted { value: EmissionRejected { diagnostics: _ }, diagnostics: _ } => true
    _ => false
  }
}

test fn unary_not_subject_refused_at_inference_holds() -> Bool {
  match corpus_door() {
    Accepted { value: InferenceRejected { diagnostics: _ }, diagnostics: _ } => true
    _ => false
  }
}

// Whether the refusal is the GENERIC transform-shape reason (observed true today).
test fn unary_not_subject_first_refusal_is_transform_shape_holds() -> Bool {
  corpus_reason() == "target_value_expr_reason_transform_shape_invalid"
}
