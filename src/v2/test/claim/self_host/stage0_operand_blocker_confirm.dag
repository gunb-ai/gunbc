module v2.test.claim.self_host.stage0_operand_blocker_confirm

// CONFIRMATION probe that pins, by the door's PRINTED reason lexeme, the exact refusing reason for each
// operand blocker of gunbc.rust_decl_type_overlay now that the Conj/Disj connective lowering is proven
// correct in isolation. It supersedes the candidate-truth-table probe by adding the emission-side binding
// lexeme the earlier candidate set omitted. Exact-equality claims name the lexeme; string_contains
// fragments corroborate it so the instrument is robust even if the single lexeme differs from prediction.
//
//   prefix_not_operand_subject  `fn(closed_alias: Bool){ !closed_alias }`  -- unary prefix (2 positional
//       children): PREDICTED emission refusal, reason target_value_expr_reason_transform_shape_invalid,
//       raised by the three-positional-child shape check in target_project_binary_primitive_apply_in_arrow_scope.
//   literal_compare_operand_subject `fn(n: Int){ n > 0 }`                  -- well-formed BINARY transform
//       whose right operand is the Int LITERAL 0: PREDICTED emission refusal, reason
//       target_binding_spelling_not_found, because the literal is accepted by
//       target_transform_positional_operand_binding_atom as an Atom identity and only fails when the emitter
//       looks up a spelling for that bogus binding symbol. This corrects the earlier claim that "a literal
//       cannot flow"; it DOES flow and then has no target spelling.

import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
  ProvenancedRustEmissionObservation,
  observe_provenanced_rust_emission_from_ingest
}
import v2.compiler.self_host.stage0_production_target { stage0_production_target_model }
import v2.compiler.source_authority { SourceRef }
import v2.compiler.source_authority_read {
  source_ref_for_observed_storage_path,
  source_root_ingest_from_source_refs
}
import std.algebra { Cons, Empty, string_contains }
import std.types { Bool, Int }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_reason_lexemes }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }

data prefix_subject_path: String = "src/v2/test/claim/self_host/prefix_not_operand_subject_fixture.dag"
data prefix_subject_name: String = "v2.test.claim.self_host.prefix_not_operand_subject_fixture"
data literal_subject_path: String = "src/v2/test/claim/self_host/literal_compare_operand_subject_fixture.dag"
data literal_subject_name: String = "v2.test.claim.self_host.literal_compare_operand_subject_fixture"

fn refs_for(path: String) -> List<SourceRef> {
  Cons { head: source_ref_for_observed_storage_path(path: path, source_root: DagTree), tail: Empty }
}

fn admission_for(name: String) -> Admission {
  Admission { subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: name) }, imports: Empty }
}

fn door_for(path: String, name: String) -> Outcome<ProvenancedRustEmissionObservation> {
  match source_root_ingest_from_source_refs(refs: refs_for(path: path)) {
    Accepted { value: ingest, diagnostics: d } =>
      Accepted {
        value: observe_provenanced_rust_emission_from_ingest(
          ingest: ingest,
          admission: admission_for(name: name),
          target: stage0_production_target_model(),
          module_path: path
        ),
        diagnostics: d
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn reason_for(path: String, name: String) -> String {
  match door_for(path: path, name: name) {
    Accepted { value: EmissionRejected { diagnostics: ds }, diagnostics: _ } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: AssemblyRejected { diagnostics: ds }, diagnostics: _ } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: InferenceRejected { diagnostics: ds }, diagnostics: _ } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ProducerReceiptRejected { diagnostics: ds }, diagnostics: _ } => diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => "artifact-produced"
    Rejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
  }
}

fn stage_for(path: String, name: String) -> String {
  match door_for(path: path, name: name) {
    Accepted { value: EmissionRejected { diagnostics: _ }, diagnostics: _ } => "emission"
    Accepted { value: AssemblyRejected { diagnostics: _ }, diagnostics: _ } => "assembly"
    Accepted { value: InferenceRejected { diagnostics: _ }, diagnostics: _ } => "inference"
    Accepted { value: ProducerReceiptRejected { diagnostics: _ }, diagnostics: _ } => "producer_receipt"
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => "artifact"
    Rejected { diagnostics: _ } => "ingest_rejected"
  }
}

// ---- BLOCKER #1 prefix-not: PINNED to the construction shape check ----
test fn prefix_reason_is_transform_shape_exact() -> Bool {
  reason_for(path: prefix_subject_path, name: prefix_subject_name) == "target_value_expr_reason_transform_shape_invalid"
}
test fn prefix_not_binding_spelling() -> Bool {
  !(string_contains(reason_for(path: prefix_subject_path, name: prefix_subject_name), "binding_spelling"))
}

// ---- BLOCKER #2 literal-in-comparison: PREDICTED target_binding_spelling_not_found ----
test fn literal_emits_holds() -> Bool {
  reason_for(path: literal_subject_path, name: literal_subject_name) == "artifact-produced"
}
test fn literal_refused_at_emission_holds() -> Bool {
  stage_for(path: literal_subject_path, name: literal_subject_name) == "emission"
}
test fn literal_reason_is_binding_spelling_not_found_exact() -> Bool {
  reason_for(path: literal_subject_path, name: literal_subject_name) == "target_binding_spelling_not_found"
}
test fn literal_reason_contains_binding() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "binding")
}
test fn literal_reason_contains_spelling() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "spelling")
}
test fn literal_reason_is_transform_shape_wrong() -> Bool {
  !(string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "transform_shape"))
}

// Category fingerprint: whichever fragment the tool's reason contains PASSES, so even if the exact lexeme
// differs from the predicted target_binding_spelling_not_found the run still names the failing category.
test fn literal_reason_contains_operand() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "operand")
}
test fn literal_reason_contains_primitive() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "primitive")
}
test fn literal_reason_contains_callable() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "callable")
}
test fn literal_reason_contains_coerce() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "coerce")
}
test fn literal_reason_contains_cast() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "cast")
}
test fn literal_reason_contains_scope() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "scope")
}
test fn literal_reason_contains_parameter() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "parameter")
}
test fn literal_reason_contains_operator() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "operator")
}
test fn literal_reason_contains_arity() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "arity")
}
test fn literal_reason_contains_not_found() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "not_found")
}
test fn literal_reason_contains_missing() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "missing")
}
test fn literal_reason_contains_shape() -> Bool {
  string_contains(reason_for(path: literal_subject_path, name: literal_subject_name), "shape")
}
