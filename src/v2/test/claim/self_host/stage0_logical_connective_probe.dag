module v2.test.claim.self_host.stage0_logical_connective_probe

// ISOLATION probe for the v2-core-emitter-lowers-conjunction-in-value-position lowering. It reuses the
// EXACT production door, coproduct-variant matching and reason capture of the live corpus probe
// (v2.compiler.self_host.candidate_generation::observe_provenanced_rust_emission_from_ingest), but over
// two PURE boolean-connective subjects whose operands are simple bindings:
//   conj_subject: `fn conj_subject(a: Bool, b: Bool) -> Bool { a && b }`  (module ...conj_value_subject_fixture)
//   disj_subject: `fn disj_subject(a: Bool, b: Bool) -> Bool { a || b }`  (module ...disj_value_subject_fixture)
//
// Purpose: decide whether the Conj->and / Disj->or lowering is correct in ISOLATION, separate from the
// corpus subject gunbc.rust_decl_type_overlay, whose operands (a prefix-not `!closed_alias` and a
// comparison against the literal `0`) are NOT simple bindings and so exercise the operand-binding path
// the lowering alone does not widen. If the two pure subjects EMIT while the corpus subject still
// refuses, the lowering is proven correct and the residual is isolated to the operand path (the
// ComputationNode/operand widening this node reports rather than folds in). Subjects live under the
// self-host claim tree, NOT the production dag corpus, so they are not counted by the population row.

import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
  ProvenancedRustEmissionObservation,
  observe_provenanced_rust_emission_from_ingest
}
import v2.compiler.self_host.stage0_production_target { stage0_production_target_model }
import v2.compiler.source_authority { SourceRef }
import v2.compiler.source_authority_read {
  source_ref_for_observed_storage_path,
  source_root_ingest_from_source_refs
}
import std.algebra { Cons, Empty }
import std.types { Bool, Int }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_reason_lexemes }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }

data conj_subject_path: String = "src/v2/test/claim/self_host/conj_value_subject_fixture.dag"
data conj_subject_name: String = "v2.test.claim.self_host.conj_value_subject_fixture"
data disj_subject_path: String = "src/v2/test/claim/self_host/disj_value_subject_fixture.dag"
data disj_subject_name: String = "v2.test.claim.self_host.disj_value_subject_fixture"

fn refs_for(path: String) -> List<SourceRef> {
  Cons {
    head: source_ref_for_observed_storage_path(path: path, source_root: DagTree),
    tail: Empty
  }
}

fn admission_for(name: String) -> Admission {
  Admission {
    subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: name) },
    imports: Empty
  }
}

fn door_for(path: String, name: String) -> Outcome<ProvenancedRustEmissionObservation> {
  match source_root_ingest_from_source_refs(refs: refs_for(path: path)) {
    Accepted { value: ingest, diagnostics: d } =>
      Accepted {
        value: observe_provenanced_rust_emission_from_ingest(
          ingest: ingest,
          admission: admission_for(name: name),
          target: stage0_production_target_model(),
          module_path: path
        ),
        diagnostics: d
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn reason_for(path: String, name: String) -> String {
  match door_for(path: path, name: name) {
    Accepted { value: EmissionRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: AssemblyRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: InferenceRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ProducerReceiptRejected { diagnostics: ds }, diagnostics: _ } =>
      diagnostics_reason_lexemes(diagnostics: ds)
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => "artifact-produced"
    Rejected { diagnostics: ds } => diagnostics_reason_lexemes(diagnostics: ds)
  }
}

fn emits_for(path: String, name: String) -> Bool {
  match door_for(path: path, name: name) {
    Accepted { value: ArtifactProduced { artifact: _ }, diagnostics: _ } => true
    _ => false
  }
}

// EXPECT PASS once the Conj arm lowers a simple-binding `a && b` to the `and` realisation.
test fn conj_subject_emits_holds() -> Bool {
  emits_for(path: conj_subject_path, name: conj_subject_name)
}

test fn conj_subject_reason_holds() -> Bool {
  reason_for(path: conj_subject_path, name: conj_subject_name) == "artifact-produced"
}

// EXPECT PASS once the Disj arm lowers a simple-binding `a || b` to the `or` realisation.
test fn disj_subject_emits_holds() -> Bool {
  emits_for(path: disj_subject_path, name: disj_subject_name)
}

test fn disj_subject_reason_holds() -> Bool {
  reason_for(path: disj_subject_path, name: disj_subject_name) == "artifact-produced"
}
