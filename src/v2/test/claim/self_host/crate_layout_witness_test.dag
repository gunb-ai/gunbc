module v2.test.claim.self_host.crate_layout_witness


data witness_red_control_note: String = "Discriminating RED, both directions: (1) OMIT — drop a basename from gunbc.stage0_crate_layout_generated.generated_pub_mod_basenames while its registration row stands, and witness_generated_basenames_match_registrations_holds goes false on the length comparison; (2) INCLUDE — append phantom_module to gunbc.stage0_crate_layout_generated.generated_pub_mod_basenames with no registration row, and witness_generated_has_no_phantom_registration_holds goes false. A third RED sits outside this file: perturb a suffix in dag/gunbc/stage0_crate_layout_generated.dag and the generated-artifact drift gate reds on bytes."

data witness_roster_half_deleted_note: String = "SEVEN WITNESSES WERE DELETED FROM THIS FILE with the self-host frontier roster, and none of them could fail. Three asked whether a specific roster row's basename was registered, each guarded by a match on that row's disposition whose EmitterProduced arm was unreachable — every row was SeedRetained, so all three took the other arm and returned true without consulting the layout at all. Three more compared an emitter-produced basename projection against the emitter-produced count; both sides derived from the same empty projection, so each compared zero with zero. The seventh opened with `if compiler_frontier_emitter_produced_count() == 0 { true }` and had therefore never evaluated its body.

The parity witness transition_parity_host_index_agrees_with_hand_rows is deleted too, and that one WAS load-bearing while it stood: it reds the moment a derived module index and the hand-authored qualified-module bindings disagree. Its subject was the duality between those two authorities, and the deletion removed one side of it — there is no hand-row table left to disagree with the index, so the claim is retired rather than dropped. Same for projection_refuses_on_absent_index, whose subject was that projection's refusal arm.

What remains is the part that was never about self-host progress: the committed generated artifact must match the registration rows it is generated from, on basenames, filenames, directories and the rendered pub-mod block."

fn string_list_contains(xs: List<String>, needle: String) -> v2.std.logic.Bool {
  xs |> any(x => x == needle)
}

fn lists_have_same_members(a: List<String>, b: List<String>) -> v2.std.logic.Bool {
  (length(xs: a) == length(xs: b))
    && fold_list(xs: a, empty: true, cons: fn(ok, x) { ok && v2.test.claim.self_host.crate_layout_witness.string_list_contains(xs: b, needle: x) })
}

fn witness_generated_pub_mod_block_matches_registrations_holds() -> v2.std.logic.Bool {
  gunbc.stage0_crate_layout_generated.generated_pub_mod_block == emit_hand_maintained_pub_mod_block()
}

fn witness_generated_basenames_match_registrations_holds() -> v2.std.logic.Bool {
  lists_have_same_members(
    a: gunbc.stage0_crate_layout_generated.generated_pub_mod_basenames,
    b: hand_maintained_pub_mod_basenames()
  )
}

fn witness_generated_filenames_match_registrations_holds() -> v2.std.logic.Bool {
  lists_have_same_members(
    a: gunbc.stage0_crate_layout_generated.generated_stage0_filenames,
    b: hand_maintained_stage0_filenames()
  )
}

fn witness_generated_dirs_match_registrations_holds() -> v2.std.logic.Bool {
  lists_have_same_members(a: gunbc.stage0_crate_layout_generated.generated_stage0_dirs, b: hand_maintained_stage0_dirs())
}

fn witness_generated_has_no_phantom_registration_holds() -> v2.std.logic.Bool {
  fold_list(
    xs: gunbc.stage0_crate_layout_generated.generated_pub_mod_basenames,
    empty: true,
    cons: fn(ok, basename) {
      ok && v2.test.claim.self_host.crate_layout_witness.string_list_contains(xs: hand_maintained_pub_mod_basenames(), needle: basename)
    }
  )
}

test fn crate_layout_witnesses() -> v2.std.logic.Bool {
  witness_generated_pub_mod_block_matches_registrations_holds()
    && witness_generated_basenames_match_registrations_holds()
    && witness_generated_filenames_match_registrations_holds()
    && witness_generated_dirs_match_registrations_holds()
    && witness_generated_has_no_phantom_registration_holds()
}
