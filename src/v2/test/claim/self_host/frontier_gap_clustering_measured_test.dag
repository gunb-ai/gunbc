module v2.test.claim.self_host.frontier_gap_clustering_measured

import v2.compiler.self_host.frontier_probe_survey {
  CommonRoot,
  HeterogeneousGaps,
  frontier_gap_clustering_from_receipts
}
import v2.compiler.self_host.frontier_probe_types {
  FrontierProbeDetailAbsent,
  FrontierProbeReceipt,
  NoFrontierProbeDetail,
  ProbeStageAssemble,
  RealizationGap,
  UnknownProbeCause
}
import v2.std.algebra { Cons, Empty }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

data frontier_gap_clustering_measured_note: String = "Discriminating controls for the clustering verdict's dominant reason. The verdict used to count blocker CLASSES and then write a hardcoded reason literal into the arm that fired, so a survey of modules refusing for ^tokenize_lex_e1_unrecognized_char — the reason the one real survey to date actually measured — would have reported ^parse_grammar_choice_overlap_residue, a symbol no receipt carried. These fixtures pin the reason to what the receipts say: a unanimous survey reports THAT reason and counts it, and a mixed survey reports its true distinct count rather than the module count. Fixtures, not a pipeline walk, so they cost milliseconds. RED: asserting the previously hardcoded literal on the unanimous case fails, which is the exact substitution these claims exist to catch."

fn receipt_with_reason(reason: Symbol) -> FrontierProbeReceipt {
  FrontierProbeReceipt {
    module_path: "src/v2/compiler/clustering_probe_fixture.dag",
    blocker_class: UnknownProbeCause { reason: reason },
    located_stage: ProbeStageAssemble,
    located_reason: reason,
    detail: FrontierProbeDetailAbsent,
    assemble_detail: NoFrontierProbeDetail
  }
}

fn unanimous_receipts() -> List<FrontierProbeReceipt> {
  Cons {
    head: receipt_with_reason(reason: ^tokenize_lex_e1_unrecognized_char),
    tail: Cons {
      head: receipt_with_reason(reason: ^tokenize_lex_e1_unrecognized_char),
      tail: Empty
    }
  }
}

fn mixed_receipts() -> List<FrontierProbeReceipt> {
  Cons {
    head: receipt_with_reason(reason: ^tokenize_lex_e1_unrecognized_char),
    tail: Cons {
      head: receipt_with_reason(reason: ^parse_grammar_choice_overlap_residue),
      tail: Cons {
        head: receipt_with_reason(reason: ^tokenize_lex_e1_unrecognized_char),
        tail: Empty
      }
    }
  }
}

fn unanimous_dominant_reason() -> Symbol {
  match frontier_gap_clustering_from_receipts(xs: unanimous_receipts(), module_count: 2) {
    CommonRoot { dominant_located_reason: r, dominant_module_count: _, module_count: _ } => r
    HeterogeneousGaps { distinct_located_reason_count: _, module_count: _ } =>
      ^clustering_reported_heterogeneous
  }
}

fn unanimous_dominant_count() -> Int {
  match frontier_gap_clustering_from_receipts(xs: unanimous_receipts(), module_count: 2) {
    CommonRoot { dominant_located_reason: _, dominant_module_count: c, module_count: _ } => c
    HeterogeneousGaps { distinct_located_reason_count: _, module_count: _ } => 0 - 1
  }
}

fn mixed_distinct_count() -> Int {
  match frontier_gap_clustering_from_receipts(xs: mixed_receipts(), module_count: 3) {
    CommonRoot { dominant_located_reason: _, dominant_module_count: _, module_count: _ } => 0 - 1
    HeterogeneousGaps { distinct_located_reason_count: d, module_count: _ } => d
  }
}

fn empty_distinct_count() -> Int {
  match frontier_gap_clustering_from_receipts(xs: Empty, module_count: 0) {
    CommonRoot { dominant_located_reason: _, dominant_module_count: _, module_count: _ } => 0 - 1
    HeterogeneousGaps { distinct_located_reason_count: d, module_count: _ } => d
  }
}

test fn unanimous_survey_reports_the_measured_reason_holds() -> Bool {
  unanimous_dominant_reason() == ^tokenize_lex_e1_unrecognized_char
}

test fn unanimous_survey_counts_the_receipts_carrying_it_holds() -> Bool {
  unanimous_dominant_count() == 2
}

test fn mixed_survey_reports_its_true_distinct_count_holds() -> Bool {
  mixed_distinct_count() == 2
}

test fn empty_survey_is_never_a_common_root_holds() -> Bool {
  empty_distinct_count() == 0
}
