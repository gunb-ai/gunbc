module v2.test.claim.self_host.verdict_failure_kind_witness_test


fn sample_diagnostic(reason: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.port_locus(port: ^verdict_surface),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn sample_rejected_outcome() -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.Rejected {
    diagnostics: v2.std.diagnostic.diagnostics_singleton(d: sample_diagnostic(reason: ^emit_host_build_failed))
  }
}

fn witness_semantic_mismatch_discriminates_from_host_failures() -> Bool {
  let rejected = sample_rejected_outcome()
  let semantic = v2.std.verdict.verdict_semantic_mismatch(
    actual: rejected,
    falsification: v2.std.collection.Absent
  )
  let build = v2.std.verdict.verdict_build_failed(
    actual: rejected,
    diagnostic: sample_diagnostic(reason: ^emit_host_build_failed)
  )
  let run = v2.std.verdict.verdict_run_failed(
    actual: rejected,
    diagnostic: sample_diagnostic(reason: ^emit_host_exit_not_ok)
  )
  match semantic {
    v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => true
    v2.std.verdict.Pass => false
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => false
    v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
  }
    && match build {
      v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => true
      v2.std.verdict.Pass => false
      v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => false
      v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => false
      v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
    }
    && match run {
      v2.std.verdict.RunFailed { actual: _, diagnostic: _ } => true
      v2.std.verdict.Pass => false
      v2.std.verdict.SemanticMismatch { actual: _, falsification: _ } => false
      v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } => false
      v2.std.verdict.Deferred { actual: _, diagnostic: _ } => false
    }
}

test fn verdict_failure_kind_witnesses() -> Bool {
  witness_semantic_mismatch_discriminates_from_host_failures()
}
