module v2.test.claim.self_host.witness_entry_eligibility_census_test

import v2.compiler.self_host.witness_entry_eligibility_census {
  witness_entry_eligibility_census_entry_count,
  witness_entry_eligibility_census_meets_floor,
  witness_entry_eligibility_census_tsv_path,
  witness_entry_eligibility_census_histogram_path
}
import v2.compiler.self_host.witness_bulk_routing {
  witness_bulk_routing_sample_roster,
  witness_bulk_entry_count_expected
}
import v2.std.algebra { length }

data witness_entry_eligibility_census_test_note: String = "Census receipt: full witness_layer_roots roster (882 entry closures; floor >=600 via witness_entry_eligibility_census_meets_floor) strictly exceeds the 16-entry stratified sample. Discovery exclusions do not shrink the census carrier — explicit-roster grains (execution/, long/, etc.) still need leg rows. ROADMAP 2a 744 totality is the bulk-flip dissolve trigger, not this Lane B landing witness. COUNT 876 -> 880 (CI floor endgame, 2026-07-23): +1 for cheap_gate_pool_test.dag AND +3 healing main's latent census drift. COUNT 880 -> 881 (schedule-retention M2, 2026-07-24): +1 for executor_schedule_retention_test.dag. COUNT 881 -> 882 (Kernel-D Stage 2 merge, 2026-07-24): +1 for emit_host_native_only_verdict_test.dag (this PR), merged alongside the schedule-retention addition — two independent branches each added one witness on top of the same 880 baseline, so the merged total is both additions, not either branch's own final literal. The count lives in four hand-synced copies (this literal, the note, witness_entry_eligibility_census_entry_count, the committed TSV rows) — a §3 parallel-representation the emit transport reconciles at regen but no CI witness walls between regens; restructuring is out of this PR's scope."

test fn witness_entry_eligibility_census_count_holds() -> Bool {
  witness_entry_eligibility_census_meets_floor()
    && witness_entry_eligibility_census_entry_count == 882
    && witness_entry_eligibility_census_entry_count > witness_bulk_entry_count_expected
    && length(xs: witness_bulk_routing_sample_roster) == witness_bulk_entry_count_expected
}

test fn witness_entry_eligibility_census_carrier_paths_holds() -> Bool {
  witness_entry_eligibility_census_tsv_path != ""
    && witness_entry_eligibility_census_histogram_path != ""
}

test fn witness_entry_eligibility_census_witnesses() -> Bool {
  witness_entry_eligibility_census_count_holds()
    && witness_entry_eligibility_census_carrier_paths_holds()
}
