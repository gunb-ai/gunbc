module v2.test.claim.self_host.witness_entry_eligibility_census_test

import v2.compiler.self_host.witness_entry_eligibility_census {
  witness_entry_eligibility_census_entry_count,
  witness_entry_eligibility_census_meets_floor,
  witness_entry_eligibility_census_tsv_path,
  witness_entry_eligibility_census_histogram_path
}
import v2.compiler.self_host.witness_bulk_routing {
  witness_bulk_routing_sample_roster,
  witness_bulk_entry_count_expected
}
import v2.std.algebra { length }

data witness_entry_eligibility_census_test_note: String = "Census receipt: full witness_layer_roots roster (882 entry closures; floor >=600 via witness_entry_eligibility_census_meets_floor) strictly exceeds the 16-entry stratified sample. Discovery exclusions do not shrink the census carrier — explicit-roster grains (execution/, long/, etc.) still need leg rows. ROADMAP 2a 744 totality is the bulk-flip dissolve trigger, not this Lane B landing witness. COUNT 876 -> 880 (CI floor endgame, 2026-07-23): +1 for cheap_gate_pool_test.dag (this PR) AND +3 healing main's latent census drift — main declared 876 while its live find was 879, undetected because affected-set selection skips this witness on PRs that do not touch its closure; this plumbing PR's affected set is the first to run it against the drifted tree. The count lives in four hand-synced copies (this literal, the note, witness_entry_eligibility_census_entry_count, the committed TSV rows) — a §3 parallel-representation the emit transport reconciles at regen but no CI witness walls between regens; restructuring is main's carrier, out of this PR's scope. COUNT 880 -> 881 (schedule-retention M2, 2026-07-24): +1 for executor_schedule_retention_test.dag, this PR's new in-corpus witness; the test literal and note were the two hand-synced copies the regen transport does not touch, and this PR's affected set is the first to run this witness against the bumped module constant. COUNT 881 -> 882 (gunbc#7146, 2026-07-24): +1 for diff_baseline_witness_test.dag, the diff-baseline modeling cleanup's RED-control witness — a census collision with the schedule-retention M2 bump above (both independently went 880 -> 881 for different witnesses; the merge is 882)."

test fn witness_entry_eligibility_census_count_holds() -> Bool {
  witness_entry_eligibility_census_meets_floor()
    && witness_entry_eligibility_census_entry_count == 882
    && witness_entry_eligibility_census_entry_count > witness_bulk_entry_count_expected
    && length(xs: witness_bulk_routing_sample_roster) == witness_bulk_entry_count_expected
}

test fn witness_entry_eligibility_census_carrier_paths_holds() -> Bool {
  witness_entry_eligibility_census_tsv_path != ""
    && witness_entry_eligibility_census_histogram_path != ""
}

test fn witness_entry_eligibility_census_witnesses() -> Bool {
  witness_entry_eligibility_census_count_holds()
    && witness_entry_eligibility_census_carrier_paths_holds()
}
