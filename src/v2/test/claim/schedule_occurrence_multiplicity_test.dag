module v2.test.claim.schedule_occurrence_multiplicity_test


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data schedule_occurrence_multiplicity_note: String = "THE MULTIPLICITY WALL for scheduled witnesses, and it reads THE SCHEDULE. A witness enrolled in two lanes is APPENDED to the falsifier plan twice, so its cost is paid twice while each lane's receipt reads as one — the claim 'this expensive root executes once' is decided HERE, at schedule grain, and NOT by the fact that one function walks the pipeline once per call. The subject universe is gunbc_falsifier_ordinary_batches(), the flattened enrolled schedule projected from ci_floor_plan's single lane-enrollment authority, so an enrollment through a THIRD lane is counted. An earlier version summed two named rosters that were already known to overlap; that could not see any occurrence outside those two lists and was therefore a two-roster overlap observation wearing this wall's name. IDENTITY GRAIN: entries join through std.realization_schedule schedule_witness_entry_eq (entry, function, kind), never a bare function-name match — two unrelated modules may legitimately spell a function the same way, and a name join would report duplicate ENROLLMENT where only name reuse existed."

data schedule_occurrence_scope_note: String = "DECLARED BOUND, not an absorbed one: this counts EXPLICIT schedule occurrences — a RunnableSingleClaim naming the entry, or an entry appearing in a discovery batch's explicit_entries / a scoped batch's entries. It does not model an occurrence arising because a discovery batch's scan_dirs happen to sweep the file, because that enrollment is decided by the executor's live filesystem walk rather than by the plan. So the count is a LOWER bound on scheduled occurrences and the wall is sound in the direction it is used (it reds when the count exceeds one) while being unable to red on a scan-dir-only duplicate. Dissolve-on: discovery expansion becomes a modeled projection over the same entry identity, at which point scan-dir membership joins this fold rather than sitting outside it. RunnableSingleClaim carries no WitnessKind, so its arm matches the subject's entry and function and inherits the subject's kind rather than inventing one; that is exact for a single-claim row, whose kind is fixed by the lane that authored it."

data multiplicity_subject_direct_rust_door: ScheduleWitnessEntry = ScheduleWitnessEntry {
  entry: "src/v2/test/claim/long/direct_rust_door_production_group_test.dag",
  function: "direct_rust_door_production_group_closing_expectation_holds",
  kind: CorpusWitnessKind
}

fn schedule_entry_occurrences(
  entries: List<ScheduleWitnessEntry>,
  subject: ScheduleWitnessEntry
) -> Int {
  length(xs: entries |> filter(e => schedule_witness_entry_eq(a: e, b: subject)))
}

fn runnable_subject_occurrences(runnable: Runnable, subject: ScheduleWitnessEntry) -> Int {
  match runnable {
    RunnableSingleClaim { entry: entry, function: function, profile: _ } =>
      if (entry == subject.entry) && (function == subject.function) { 1 } else { 0 }
    RunnableDiscoveryBatch {
      source_roots: _,
      scan_dirs: _,
      explicit_entries: explicit_entries,
      node_frontier_selection: _,
      exclude_substrings: _,
      discovery_scope_dirs: _,
      profile: _
    } => schedule_entry_occurrences(entries: explicit_entries, subject: subject)
    RunnableScopedWitnessBatch { batch: batch } =>
      schedule_entry_occurrences(entries: batch.entries, subject: subject)
    RunnableKernelWorkload { fused_op_count: _ } => 0
  }
}

fn batch_subject_occurrences(batch: List<Runnable>, subject: ScheduleWitnessEntry) -> Int {
  fold_list(xs: batch, empty: 0, cons: fn(acc, runnable) {
    acc + runnable_subject_occurrences(runnable: runnable, subject: subject)
  })
}

fn scheduled_occurrences(subject: ScheduleWitnessEntry) -> Int {
  fold_list(xs: gunbc_falsifier_ordinary_batches(), empty: 0, cons: fn(acc, batch) {
    acc + batch_subject_occurrences(batch: batch, subject: subject)
  })
}

test fn direct_rust_door_group_root_is_scheduled_exactly_once() -> Bool {
  scheduled_occurrences(subject: multiplicity_subject_direct_rust_door) == 1
}

// The planted controls exercise the counter's identity join without reaching the live schedule, so a red in the wall above is attributable to enrollment rather than to the counter. The exact duplicate is what makes it a control for duplicate ENROLLMENT: an earlier version planted two rows sharing one function name across DIFFERENT entries, which proved only name multiplicity and would count ZERO under the exact join this wall performs. The second conjunct asserts exactly that distinction, and the third exercises the Runnable-arm projection the live fold depends on.
test fn multiplicity_counter_discriminates_a_planted_duplicate() -> Bool {
  let exact_duplicate = [
    multiplicity_subject_direct_rust_door,
    multiplicity_subject_direct_rust_door,
  ]
  let same_name_other_entry = [
    ScheduleWitnessEntry {
      entry: "some/other/entry.dag",
      function: "direct_rust_door_production_group_closing_expectation_holds",
      kind: CorpusWitnessKind
    },
  ]
  let planted_batch = [
    RunnableKernelWorkload { fused_op_count: 3 },
    RunnableSingleClaim {
      entry: "src/v2/test/claim/long/direct_rust_door_production_group_test.dag",
      function: "direct_rust_door_production_group_closing_expectation_holds",
      profile: runnable_resource_profile_negligible()
    },
  ]
  let a = schedule_entry_occurrences(
    entries: exact_duplicate,
    subject: multiplicity_subject_direct_rust_door
  ) == 2
  let b = schedule_entry_occurrences(
    entries: same_name_other_entry,
    subject: multiplicity_subject_direct_rust_door
  ) == 0
  let c = batch_subject_occurrences(
    batch: planted_batch,
    subject: multiplicity_subject_direct_rust_door
  ) == 1
  a && b && c
}
