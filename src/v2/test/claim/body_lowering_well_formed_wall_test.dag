module v2.test.claim.body_lowering_well_formed_wall


// Discriminating RED control for body-lowering-is-TOTAL: malformed arrow bodies
// still reject well_formed. After ArrowBodyForm, bare Atom bodies are valid
// (DirectAtomBody); UnsupportedArrowBody Disj remains the negative control.

fn well_formed_wall_atom(identity: v2.std.node.Symbol) -> v2.std.node.Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: []
  )
}

fn well_formed_wall_malformed_arrow() -> v2.std.node.Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_domain) },
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^arrow_body_edge },
        target: node_synthetic(kind: v2.std.node.TypeNode { connective: Disj }, children: [])
      }
    ]
  )
}

fn well_formed_wall_atom_body_arrow() -> v2.std.node.Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_domain) },
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^arrow_body_edge },
        target: well_formed_wall_atom(identity: ^well_formed_wall_bare_body)
      }
    ]
  )
}

fn well_formed_wall_valid_arrow() -> v2.std.node.Node {
  node_synthetic(
    kind: v2.std.node.TypeNode { connective: Arrow },
    children: [
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_domain) },
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      v2.std.node.Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^arrow_body_edge },
        target: node_synthetic(kind: v2.std.node.ComputationNode { behavior: Value }, children: [])
      }
    ]
  )
}

test fn body_lowering_well_formed_wall_rejects_malformed_body() -> Bool {
  !well_formed(n: well_formed_wall_malformed_arrow())
}

test fn body_lowering_well_formed_wall_accepts_atom_body() -> Bool {
  well_formed(n: well_formed_wall_atom_body_arrow())
}

test fn body_lowering_well_formed_wall_accepts_valid_body() -> Bool {
  well_formed(n: well_formed_wall_valid_arrow())
}
