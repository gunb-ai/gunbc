module v2.test.claim.body_lowering_well_formed_wall

import v2.std.node {
  Arrow,
  Atom,
  ComputationNode,
  Conj,
  Disj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  Value,
  node_synthetic,
  well_formed
}

// Discriminating RED control for body-lowering-is-TOTAL: malformed arrow bodies
// still reject well_formed. After ArrowBodyForm, bare Atom bodies are valid
// (DirectAtomBody); UnsupportedArrowBody Disj remains the negative control.

fn well_formed_wall_atom(identity: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: []
  )
}

fn well_formed_wall_malformed_arrow() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_domain) },
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      Edge {
        label: Named { name: ^arrow_body_edge },
        target: node_synthetic(kind: TypeNode { connective: Disj }, children: [])
      }
    ]
  )
}

fn well_formed_wall_atom_body_arrow() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_domain) },
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      Edge {
        label: Named { name: ^arrow_body_edge },
        target: well_formed_wall_atom(identity: ^well_formed_wall_bare_body)
      }
    ]
  )
}

fn well_formed_wall_valid_arrow() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_domain) },
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      Edge { label: Positional, target: well_formed_wall_atom(identity: ^well_formed_wall_return) },
      Edge {
        label: Named { name: ^arrow_body_edge },
        target: node_synthetic(kind: ComputationNode { behavior: Value }, children: [])
      }
    ]
  )
}

test fn body_lowering_well_formed_wall_rejects_malformed_body() -> Bool {
  !well_formed(n: well_formed_wall_malformed_arrow())
}

test fn body_lowering_well_formed_wall_accepts_atom_body() -> Bool {
  well_formed(n: well_formed_wall_atom_body_arrow())
}

test fn body_lowering_well_formed_wall_accepts_valid_body() -> Bool {
  well_formed(n: well_formed_wall_valid_arrow())
}
