module v2.test.claim.v2_tokenize_annotation_probe

import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.text { String }

data v2_tokenize_annotation_probe_note: String = "SH-D: does the v2 lexer admit the standalone leading // annotation block DESIGN 4c describes? Two files in the use_site_verdict closure carry them (dag/std/algebra.dag, dag/std/dissolution.dag), and the closure measures ^tokenize_lex_e1_unrecognized_char."

test fn leading_annotation_block_tokenizes() -> Bool {
  match tokenize(text: "// note\ndata x: String = \"p\"", file: ^probe, rules: dag_language_model().lex) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn leading_annotation_block_rejects_as_unrecognized_char() -> Bool {
  match tokenize(text: "// note\ndata x: String = \"p\"", file: ^probe, rules: dag_language_model().lex) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: ds } => ds.head.reason == ^tokenize_lex_e1_unrecognized_char
  }
}
