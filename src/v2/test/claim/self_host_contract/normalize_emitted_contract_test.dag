module v2.test.claim.self_host_contract.normalize_emitted_contract

import std.logic { Bool }
import v2.compiler.normalize { normalize }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Node, Edge, Positional, ComputationNode, Value, node_synthetic }

// THE 03_normalize ROW'S CONTRACT, STATED ONCE AND REALIZED TWICE. Read off the authority:
// v2.compiler.normalize normalize accepts a well-formed tree and refuses one that is not; a Value
// node carrying a child is not well formed (v2.std.node behavior_edges_conform).
fn nmc_value_node() -> Node {
  node_synthetic(kind: ComputationNode { behavior: Value }, children: [])
}

fn nmc_value_with_child() -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Value },
    children: [Edge { label: Positional, target: nmc_value_node() }]
  )
}

fn nmc_accepts(tree: Node) -> Bool {
  match normalize(parse_tree: tree) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// The planted fault asserts ONLY the wrong acceptance: the malformed tree normalizing.
fn normalize_emitted_contract_holds(inject_fault: Bool) -> Bool {
  let malformed_accepted = nmc_accepts(tree: nmc_value_with_child())
  if inject_fault {
    malformed_accepted
  } else {
    nmc_accepts(tree: nmc_value_node()) && !malformed_accepted
  }
}

test fn normalize_emitted_contract_holds_and_its_planted_fault_does_not() -> Bool {
  normalize_emitted_contract_holds(inject_fault: false)
    && !normalize_emitted_contract_holds(inject_fault: true)
}
