module v2.test.fact_cardinality.lens_unit.synthetic_unified_green


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data synthetic_unified_dag: v2.lens.fact_cardinality.FactCardinalityDeclFact = v2.lens.fact_cardinality.FactCardinalityDeclFact {
  rel_path_decl_key: "std/algebra.dag:Lattice",
  tree: Dag,
  content_hash: "7e31b580ce38306e"
}

data synthetic_unified_v2: v2.lens.fact_cardinality.FactCardinalityDeclFact = v2.lens.fact_cardinality.FactCardinalityDeclFact {
  rel_path_decl_key: "std/algebra.dag:Lattice",
  tree: V2,
  content_hash: "7e31b580ce38306e"
}

test fn synthetic_unified_green_holds() -> Bool {
  v2.lens.fact_cardinality.fact_cardinality_cross_tree_coexistence(
    left: synthetic_unified_dag,
    right: synthetic_unified_v2
  )
    && !v2.lens.fact_cardinality.fact_cardinality_cross_tree_diverged_fork(
      left: synthetic_unified_dag,
      right: synthetic_unified_v2
    )
}
