module v2.test.claim.symbol_index_declaration_identity_witness_test

import std.types { Bool, String }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.induction { SubValueUnknown }
import v1.std.core { error_type }
import v1.compiler.infer_env {
  SymbolIndex,
  SymbolIndexEntry,
  TypeBinding,
  GlobalBareUniqueBinding,
  NominalDeclarationBinding,
  ResolvedAliasBinding,
  AliasReferentUnresolvedAfterIndexClosure,
  AliasReferentCycle,
  ConflictingIndexedIdentity,
  empty_symbol_index,
  symbol_index_insert_decl,
  symbol_index_entry_lookup,
}
import v1.compiler.infer { finalize_symbol_index_alias_edge }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn declaration(module_path: String, name: String) -> DeclarationRef {
  decl_ref(module_path: module_path, decl_name: name)
}

fn nominal(index: SymbolIndex, module_path: String, name: String) -> SymbolIndex {
  symbol_index_insert_decl(
    index: index,
    module_path: module_path,
    binding: TypeBinding { name: name, resolved: error_type, provenance: SubValueUnknown },
    provenance: NominalDeclarationBinding { declaration: declaration(module_path: module_path, name: name) }
  )
}

fn one_edge(alias_key: String, referent_key: String) -> Map<String, String> {
  map_insert(empty_map(), alias_key, referent_key)
}

fn resolved_alias(
  index: SymbolIndex,
  edges: Map<String, String>,
  alias_module: String,
  alias_name: String,
  referent_key: String
) -> SymbolIndex {
  finalize_symbol_index_alias_edge(
    index: index,
    edges: edges,
    alias_key: concat(alias_module, ".", alias_name),
    alias_declaration: declaration(module_path: alias_module, name: alias_name),
    referent_key: referent_key
  )
}

fn alias_entry_has(
  entry: SymbolIndexEntry,
  alias_module: String,
  alias_name: String,
  referent_key: String,
  owner_module: String,
  owner_name: String
) -> Bool {
  declaration_ref_eq(a: entry.declaring_declaration, b: declaration(module_path: owner_module, name: owner_name))
    && match entry.provenance {
      ResolvedAliasBinding { alias_declaration, referent_key: observed_referent, declaring_declaration } =>
        declaration_ref_eq(a: alias_declaration, b: declaration(module_path: alias_module, name: alias_name))
          && observed_referent == referent_key
          && declaration_ref_eq(a: declaring_declaration, b: declaration(module_path: owner_module, name: owner_name))
      NominalDeclarationBinding { declaration: _ } => false
      _ => false
    }
}

test fn reexport_keeps_alias_edge_and_terminal_declaration() -> Bool {
  let base = nominal(index: empty_symbol_index(), module_path: "fixture.owner", name: "Thing")
  let edges = one_edge(alias_key: "fixture.facade.Alias", referent_key: "fixture.owner.Thing")
  let finalized = resolved_alias(index: base, edges: edges, alias_module: "fixture.facade", alias_name: "Alias", referent_key: "fixture.owner.Thing")
  match symbol_index_entry_lookup(index: finalized, qualified_name: "fixture.facade.Alias") {
    Present { value: entry } =>
      alias_entry_has(entry: entry, alias_module: "fixture.facade", alias_name: "Alias", referent_key: "fixture.owner.Thing", owner_module: "fixture.owner", owner_name: "Thing")
        && match map_get(finalized.global_bare, "Alias") {
          Present { value: GlobalBareUniqueBinding { module_path: _, binding: _, entry: bare_entry } } =>
            declaration_ref_eq(a: bare_entry.declaring_declaration, b: entry.declaring_declaration)
          _ => false
        }
    Absent => false
  }
}

test fn alias_chain_and_retarget_preserve_terminal_identity() -> Bool {
  let base = nominal(index: nominal(index: empty_symbol_index(), module_path: "fixture.left", name: "Thing"), module_path: "fixture.right", name: "Thing")
  let chain = map_insert(one_edge(alias_key: "fixture.facade.Alias", referent_key: "fixture.bridge.Middle"), "fixture.bridge.Middle", "fixture.left.Thing")
  let left = resolved_alias(index: base, edges: chain, alias_module: "fixture.facade", alias_name: "Alias", referent_key: "fixture.bridge.Middle")
  let right_edges = one_edge(alias_key: "fixture.facade.Alias", referent_key: "fixture.right.Thing")
  let right = resolved_alias(index: base, edges: right_edges, alias_module: "fixture.facade", alias_name: "Alias", referent_key: "fixture.right.Thing")
  match symbol_index_entry_lookup(index: left, qualified_name: "fixture.facade.Alias") {
    Present { value: left_entry } => match symbol_index_entry_lookup(index: right, qualified_name: "fixture.facade.Alias") {
      Present { value: right_entry } =>
        declaration_ref_eq(a: left_entry.declaring_declaration, b: declaration(module_path: "fixture.left", name: "Thing"))
          && declaration_ref_eq(a: right_entry.declaring_declaration, b: declaration(module_path: "fixture.right", name: "Thing"))
      Absent => false
    }
    Absent => false
  }
}

test fn alias_refusal_population_is_typed() -> Bool {
  let missing_edges = one_edge(alias_key: "fixture.facade.Missing", referent_key: "fixture.absent.Thing")
  let missing = resolved_alias(index: empty_symbol_index(), edges: missing_edges, alias_module: "fixture.facade", alias_name: "Missing", referent_key: "fixture.absent.Thing")
  let cycle_edges = map_insert(one_edge(alias_key: "fixture.a.A", referent_key: "fixture.b.B"), "fixture.b.B", "fixture.a.A")
  let cycle = resolved_alias(index: empty_symbol_index(), edges: cycle_edges, alias_module: "fixture.a", alias_name: "A", referent_key: "fixture.b.B")
  (missing.insert_refusals |> any(r => match r {
    AliasReferentUnresolvedAfterIndexClosure { alias_qualified_name, referent_qualified_name } => alias_qualified_name == "fixture.facade.Missing" && referent_qualified_name == "fixture.absent.Thing"
    _ => false
  })) && (cycle.insert_refusals |> any(r => match r {
    AliasReferentCycle { alias_qualified_name, cycle_at: _ } => alias_qualified_name == "fixture.a.A"
    _ => false
  }))
}

test fn alias_finalization_is_insertion_order_independent() -> Bool {
  let base = nominal(index: empty_symbol_index(), module_path: "fixture.owner", name: "Thing")
  let edges = map_insert(one_edge(alias_key: "fixture.a.A", referent_key: "fixture.owner.Thing"), "fixture.b.B", "fixture.owner.Thing")
  let ab = resolved_alias(index: resolved_alias(index: base, edges: edges, alias_module: "fixture.a", alias_name: "A", referent_key: "fixture.owner.Thing"), edges: edges, alias_module: "fixture.b", alias_name: "B", referent_key: "fixture.owner.Thing")
  let ba = resolved_alias(index: resolved_alias(index: base, edges: edges, alias_module: "fixture.b", alias_name: "B", referent_key: "fixture.owner.Thing"), edges: edges, alias_module: "fixture.a", alias_name: "A", referent_key: "fixture.owner.Thing")
  ab.entries == ba.entries && ab.global_bare == ba.global_bare
}

test fn conflicting_indexed_identity_is_never_overwritten() -> Bool {
  let first = nominal(index: empty_symbol_index(), module_path: "fixture.owner", name: "Thing")
  let conflicting = symbol_index_insert_decl(
    index: first,
    module_path: "fixture.owner",
    binding: TypeBinding { name: "Thing", resolved: error_type, provenance: SubValueUnknown },
    provenance: NominalDeclarationBinding { declaration: declaration(module_path: "fixture.other", name: "Thing") }
  )
  (conflicting.insert_refusals |> any(r => match r {
    ConflictingIndexedIdentity { qualified_name, existing: _, proposed } =>
      qualified_name == "fixture.owner.Thing"
        && declaration_ref_eq(a: proposed, b: declaration(module_path: "fixture.other", name: "Thing"))
    _ => false
  })) && match symbol_index_entry_lookup(index: conflicting, qualified_name: "fixture.owner.Thing") {
    Present { value: entry } => declaration_ref_eq(a: entry.declaring_declaration, b: declaration(module_path: "fixture.owner", name: "Thing"))
    Absent => false
  }
}
