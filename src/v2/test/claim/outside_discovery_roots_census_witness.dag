module v2.test.claim.outside_discovery_roots_census_witness

// THE WITNESS for the outside-discovery-roots census: every standing the census can produce, on listings
// the claim injects, plus the one claim that asks the index for the real thing.
//
// WHAT IS INJECTED AND WHAT IS NOT. A fixture here is an INJECTED LISTING -- the same thing the live entry
// hands the pure census from git -- so the census's decisions are tested without a filesystem and without
// letting the census read the tree it reports on. Nothing in the census module is transcribed: the
// population it reports is computed per path from `v2.cli.repository_layout`.
//
// WHAT GROUNDS THE EXPECTATION, and what does not. The fixture lists below are the EXPECTED SUBJECT
// POPULATION at file grain. They are NOT what the note declares: that note declares a subject (the entries
// under `src/v1/tests/claim` have no executing consumer) and names zero files, so a path-level "the note
// declared this" would be a claim the cited source cannot support. What grounds each item is the emitted
// population registry, read through `gunbc.stage0.stage0_rust_host_observation::emitted_population_repo_paths`
// and joined through `gunbc.rust_emitted_edge::module_to_filename` -- different instrument, different
// provenance from `git ls-files`, so the pairing is not `measure() == measure()`. The declared-module facts
// that complete the join come from the host's own scan
// (`v2.lens.module_graph::module_declaration_facts_live`) in the wet claim, never from anything authored here.
// If a file enters or leaves the tree without the registry moving, the pairing claim fails loudly, naming the
// path.
//
// NO COUNT LITERALS (§5/§6). Equality of populations here is stated as containment both ways over derived
// sets, never as a number copied from an instrument run.

import std.types { String, Bool, List }
import std.optional { Optional, Absent, Present }
import std.algebra { Cons, Empty, is_empty }

import v2.test.claim.outside_discovery_roots_census_helpers {
  prose_mentioning_paths,
  subject_helpers_declare_nothing,
  subject_population_expected,
  emitted_registry_path
}
import v2.workflow.outside_discovery_roots_census {
  OutsideRootsStanding,
  InsideGovernedTree,
  OutsideDiscoveryRoots,
  NotAClaimFile,
  OutsideRootsOutcome,
  CensusUnread,
  CensusUnreadCause,
  CensusReadFailure,
  IndexUnread,
  MarkerUnread,
  ReadProcessAbsent,
  ReadProcessRefused,
  ReadNoAnswer,
  census_unread_cause_text,
  CensusObserved,
  census_rows,
  outside_roots_row,
  outside_roots_findings,
  findings_under_note_subject,
  findings_outside_note_subject,
  outside_roots_receipt_lines,
  outside_roots_header_lines,
  path_is_claim_file,
  path_is_under_note_subject,
  outside_roots_cause,
  scan_dir_authority,
  declaration_ref_display,
  scan_dir_gap_population,
  scan_dir_gap_receipt_lines,
  scan_dir_gap_header_lines,
  emitted_entry_for_module,
  subject_path_is_emitted
}
import v2.workflow.outside_discovery_roots_census_live {
  TrackedListing,
  ListingRead,
  ListingRefused,
  ClaimBearerRead,
  BearersRead,
  BearersRefused,
  listing_from_captured_text,
  bearers_from_captured_text,
  listing_paths,
  claim_declaration_pattern,
  outside_roots_census,
  head_stamp_line
}
import v2.cli.repository_layout { repository_module_file_of_path }
import gunbc.rust_emitted_edge { module_to_filename }
import gunbc.stage0.stage0_cargo_manifest { stage0_package_root, stage0_source_dir_relative_to_package }
import gunbc.stage0.stage0_emitted_population_manifest { emitted_population_manifest_basename }
import gunbc.stage0.stage0_rust_host_observation { emitted_population_repo_paths }
import v2.lens.module_graph { ModuleDeclarationFact }
import std.types { Int }
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.compiler.parse { PreparedGrammar, parse_module_prepared, prepare_grammar }
import v2.compiler.tokenize { prepare_lex_rules, tokenize_prepared }
import v2.extdeps.languages.dag { dag_language_model }
import v2.compiler.test_marker_capture { test_marker_content }
import v2.std.node { symbol_intern_lexeme, symbol_lexeme }
import v2.std.diagnostic { Accepted, Rejected }
import std.algebra { length, list_map }

// ---------------------------------------------------------------------------
// A listing with a governed path in it, so a census that reported governed files as findings would go red
// on a fixture rather than only on the real tree.
data governed_listing_rows: List<String> = [
  "src/v2/workflow/outside_discovery_roots_census.dag",
  "dag/gunbc/claim_coverage_census.dag"
]

// A path outside the governed trees that is NOT a claim file: the census must say NotAClaimFile, not stay
// silent and not call it a finding.
data non_claim_outside_path: String = "src/v1/tests/claim/README.dag-free"

// ---------------------------------------------------------------------------
// THE STANDING ITSELF.
// ---------------------------------------------------------------------------

// A governed path is never a finding: the layout owns it, so some governed reader can acquire it.
test fn a_governed_path_is_never_a_finding() -> Bool {
  all(xs: governed_listing_rows, predicate: fn(path) {
    match outside_roots_row(path: path, claim_bearers: subject_population_expected) {
      InsideGovernedTree { path: reported, tree_directory: dir } => reported == path && dir != ""
      OutsideDiscoveryRoots { path: _, cause: _ } => false
      NotAClaimFile { path: _ } => false
      }
  })
}

// A path under no governed tree, ending .dag, is THE finding -- and it carries the cause that says why:
// the layout, not a name-match.
test fn a_claim_file_under_no_governed_tree_is_the_finding_with_a_cause() -> Bool {
  match outside_roots_row(
    path: "src/v1/tests/claim/annotation_gap_round_trip_test.dag",
    claim_bearers: subject_population_expected
  ) {
    OutsideDiscoveryRoots { path: reported, cause: cause } =>
      reported == "src/v1/tests/claim/annotation_gap_round_trip_test.dag"
        && cause.layout_authority.module_path == "v2.cli.repository_layout"
        && cause.layout_authority.decl_name == "repository_module_file_of_path"
    InsideGovernedTree { path: _, tree_directory: _ } => false
    NotAClaimFile { path: _ } => false
  }
}

// The census reports one row per path it was handed -- nothing skipped, nothing invented. This is the
// anti-widening control: a census that dropped a row, or added one, breaks here.
test fn the_census_reports_exactly_one_row_per_listed_path() -> Bool {
  let listing = concat(governed_listing_rows, concat(subject_population_expected, [non_claim_outside_path]))
  let rows = census_rows(listing: listing, claim_bearers: subject_population_expected)
  length(xs: rows) == length(xs: listing)
    && all(xs: listing, predicate: fn(path) {
         length(xs: filter(xs: rows, predicate: fn(row) { row_path(row: row) == path })) == 1
       })
}

// The path a row is about, for the one-row-per-path control.
fn row_path(row: OutsideRootsStanding) -> String {
  match row {
    InsideGovernedTree { path: path, tree_directory: _ } => path
    OutsideDiscoveryRoots { path: path, cause: _ } => path
    NotAClaimFile { path: path } => path
  }
}

// Outside the trees but not a claim file: its own standing, so it cannot be counted as a finding and
// cannot be silently skipped either.
test fn a_non_claim_file_outside_the_trees_gets_its_own_standing() -> Bool {
  match outside_roots_row(path: non_claim_outside_path, claim_bearers: subject_population_expected) {
    NotAClaimFile { path: reported } => reported == non_claim_outside_path
    InsideGovernedTree { path: _, tree_directory: _ } => false
    OutsideDiscoveryRoots { path: _, cause: _ } => false
  }
}

// ---------------------------------------------------------------------------
// THE RED THE MANAGER RULED: THE LISTED PATHS. Dropping one path from the listing makes the census stop
// reporting exactly that one and leaves every other finding standing -- so the finding is produced by the
// listing, not by a table the census agrees with.
// ---------------------------------------------------------------------------

test fn removing_a_listed_path_from_the_listing_makes_the_census_stop_naming_it() -> Bool {
  let full = outside_roots_findings(rows: census_rows(listing: subject_population_expected, claim_bearers: subject_population_expected))
  let dropped = "src/v1/tests/claim/tco_tail_call_assigns_every_loop_slot_witness_test.dag"
  let without = filter(xs: subject_population_expected, predicate: fn(path) { path != dropped })
  let shrunk = outside_roots_findings(rows: census_rows(listing: without, claim_bearers: subject_population_expected))
  !(is_in(listing: shrunk, path: dropped))
    && is_in(listing: full, path: dropped)
    && all(xs: subject_population_expected, predicate: fn(path) {
         if path == dropped {
           true
         } else {
           is_in(listing: shrunk, path: path)
         }
       })
}

fn is_in(listing: List<String>, path: String) -> Bool {
  any(xs: listing, predicate: fn(candidate) { candidate == path })
}

// The census names the whole declared population when the listing carries it -- computed containment, no
// count literal.
test fn the_census_names_every_declared_path_when_the_listing_carries_them() -> Bool {
  let findings = outside_roots_findings(rows: census_rows(listing: subject_population_expected, claim_bearers: subject_population_expected))
  all(xs: subject_population_expected, predicate: fn(path) { is_in(listing: findings, path: path) })
}

// Governed paths in the same listing are not findings, so the census's finding set is exactly the
// population under no tree, not "everything outside the scan dirs".
test fn governed_paths_share_a_listing_without_becoming_findings() -> Bool {
  let listing = concat(governed_listing_rows, subject_population_expected)
  let findings = outside_roots_findings(rows: census_rows(listing: listing, claim_bearers: subject_population_expected))
  all(xs: findings, predicate: fn(path) { !(path_is_governed(path: path)) })
    && all(xs: subject_population_expected, predicate: fn(path) { is_in(listing: findings, path: path) })
}

fn path_is_governed(path: String) -> Bool {
  match repository_module_file_of_path(path: path) {
    Present { value: _ } => true
    Absent => false
  }
}

// ---------------------------------------------------------------------------
// THE NOTE HOLDS ONLY ITS OWN SUBJECT. A finding outside the note's declared prefix is NOT absorbed under
// the note's authority: it is reported separately so a new population cannot quietly become "already
// declared" the way a widening would.
// ---------------------------------------------------------------------------

test fn findings_inside_and_outside_the_note_subject_are_kept_apart() -> Bool {
  let listing = concat(subject_population_expected, ["src/v2/lens/not_a_governed_tree_at_all.dag"])
  let findings = outside_roots_findings(rows: census_rows(listing: listing, claim_bearers: subject_population_expected))
  let vouched = findings_under_note_subject(findings: findings)
  let undeclared = findings_outside_note_subject(findings: findings)
  all(xs: vouched, predicate: fn(path) { path_is_under_note_subject(path: path) })
    && all(xs: undeclared, predicate: fn(path) { !(path_is_under_note_subject(path: path)) })
}

// The receipt names the note at identity, so a reader is sent to the authority instead of to a number.
test fn the_receipt_names_the_note_at_identity_rather_than_a_count() -> Bool {
  let lines = outside_roots_receipt_lines(
    findings: [head_path(paths: subject_population_expected)],
    vouched_by_note: true
  )
  any(xs: lines, predicate: fn(line) {
    string_contains(s: line, pattern: declaration_ref_display(ref: outside_roots_cause.note_subject))
      && string_contains(s: line, pattern: "OUTSIDE-DISCOVERY-ROOTS")
  })
}

fn head_path(paths: List<String>) -> String {
  match paths {
    Cons { head: first, tail: _ } => first
    Empty {} => ""
  }
}

// The header cites the layout authority, so the standing's reason is locatable from the receipt alone.
test fn the_header_cites_the_layout_authority() -> Bool {
  let lines = outside_roots_header_lines()
  any(xs: lines, predicate: fn(line) { string_contains(s: line, pattern: "repository_module_file_of_path") })
    && any(xs: lines, predicate: fn(line) { string_contains(s: line, pattern: declaration_ref_display(ref: outside_roots_cause.note_subject)) })
}

// ---------------------------------------------------------------------------
// THE REFUSAL. "Could not look" is not "nothing to report": the census keeps them apart, and the refusal
// outranks a clean census over an empty population.
// ---------------------------------------------------------------------------

test fn an_unreadable_listing_is_not_an_empty_census() -> Bool {
  let refused = outside_roots_census(
    listing: ListingRefused { failure: ReadProcessAbsent },
    bearers: BearersRead { paths: subject_population_expected }
  )
  (match refused.outcome { CensusUnread { cause: IndexUnread { failure: ReadProcessAbsent } } => true _ => false })
    && is_empty(refused.findings)
    && any(xs: refused.lines, predicate: fn(line) { string_contains(s: line, pattern: "UNREAD") })
}

test fn a_read_listing_of_nothing_is_a_clean_census_not_a_refusal() -> Bool {
  let read = outside_roots_census(listing: ListingRead { paths: [] }, bearers: BearersRead { paths: subject_population_expected })
  (match read.outcome { CensusObserved { rows: _ } => true _ => false }) && is_empty(read.findings)
}

// "Could not look" can no longer be MIXED with what was seen: the row list is the type of what was seen, and
// it has no unread arm to hold a census-level fact. The old version of this claim forged such a list and
// asked a predicate to find the marker; review 84111 made the forgery itself the thing that must not
// compile -- so what is asserted here is the construction: every row the fold can produce is a path row.
test fn a_row_list_can_hold_only_path_rows() -> Bool {
  // THE OLD FORGEABLE STATE, now unwritable (review 84111): there is no listing_unread_row() and no arm of
  // OutsideRootsStanding for a listing-level fact -- a List<OutsideRootsStanding> can hold ONLY path rows.
  // The invariant is enforced by the sum having no unread arm, not by a predicate hunting one.
  let rows = census_rows(listing: subject_population_expected, claim_bearers: subject_population_expected)
  all(xs: rows, predicate: fn(row) {
    match row {
      InsideGovernedTree { path: _, tree_directory: _ } => true
      OutsideDiscoveryRoots { path: _, cause: _ } => true
      NotAClaimFile { path: _ } => true
    }
  })
}

// ---------------------------------------------------------------------------
// THE LOCATOR IS NOT AN INPUT (the census output is a pure function of the listing; the head is stamped
// beside it). A stamp cannot invent a revision.
// ---------------------------------------------------------------------------

test fn the_head_is_stamped_beside_the_output_and_never_invented() -> Bool {
  head_stamp_line(revision: "") == "OUTSIDE-DISCOVERY-ROOTS head: no revision supplied"
    && string_contains(s: head_stamp_line(revision: "abc1234"), pattern: "abc1234")
}

// ---------------------------------------------------------------------------
// THE LIVE MODULE IS INSIDE THE WITNESS'S RESOLVING. This claim imports the live module and calls one of
// its pure functions, so a type error anywhere in it cannot be invisible to the corpus (the blocker
// bold-badger-676 caught once in the S1 census: 20 claims passed while the live module refused to resolve).
// ---------------------------------------------------------------------------

test fn a_live_function_resolves_and_reports_no_finding_for_an_empty_listing() -> Bool {
  let out = outside_roots_census(listing: ListingRead { paths: [] }, bearers: BearersRead { paths: subject_population_expected })
  is_empty(out.findings) && (match out.outcome { CensusObserved { rows: _ } => true _ => false })
}

// The capture's decision on an EMPTY answer, exercised directly: it is a refusal with a cause, never an
// empty population standing in for success. The decision is a pure function of the captured text precisely
// so this can be put in its hand -- the capture itself only runs on the real route.
test fn an_empty_answer_from_the_index_is_a_typed_refusal_not_an_empty_population() -> Bool {
  match listing_from_captured_text(text: "   \n ") {
    ListingRefused { failure: ReadNoAnswer } => true
    ListingRefused { failure: _ } => false
    ListingRead { paths: paths } => false
  }
}

// ...while a real listing of one path is read as one path, and the trailing newline is not a second one.
test fn a_captured_listing_splits_on_newlines_and_drops_the_trailing_one() -> Bool {
  match listing_from_captured_text(text: "src/v1/tests/claim/escape_json_string_differential.dag\n") {
    ListingRead { paths: paths } =>
      length(xs: paths) == 1
        && any(xs: paths, predicate: fn(p) { p == "src/v1/tests/claim/escape_json_string_differential.dag" })
    ListingRefused { failure: _ } => false
  }
}

// The phrase a naive reader would hand the marker read. Kept here, beside the claim that rejects it, so the
// claim says what the wrong answer is instead of only that the right one is right.
data bare_marker_phrase: String = "test fn"

// ---------------------------------------------------------------------------
// THE TWO READS ARE NOT ONE READ. The census refuses when the marker answer is refused even though the
// listing came back full: a missing marker read would otherwise print every path as NotAClaimFile, which is
// a clean bill of health produced by a broken observation.
// ---------------------------------------------------------------------------

test fn a_refused_marker_read_is_a_refusal_even_when_the_listing_read_fine() -> Bool {
  let out = outside_roots_census(
    listing: ListingRead { paths: subject_population_expected },
    bearers: BearersRefused { failure: ReadProcessAbsent }
  )
  (match out.outcome { CensusUnread { cause: MarkerUnread { failure: ReadProcessAbsent } } => true _ => false })
    && is_empty(out.findings)
    && any(xs: out.lines, predicate: fn(line) { string_contains(s: line, pattern: "marker") })
}

// An empty marker answer is NOT a refusal: if nothing tracked declares a claim, every path really is
// NotAClaimFile. Refusing here would turn "nothing declares a claim" into "we could not tell", which is the
// direction that hides a finding.
test fn an_empty_marker_answer_reports_every_path_as_not_a_claim_file() -> Bool {
  let out = outside_roots_census(
    listing: ListingRead { paths: subject_population_expected },
    bearers: BearersRead { paths: [] }
  )
  (match out.outcome { CensusObserved { rows: _ } => true _ => false }) && is_empty(out.findings)
}

// THE FABRICATED-FINDING RED, on the files themselves. Tracked `.dag` under the very subject the note names,
// which declare no test fn: they were reported as uncovered claims by an extension-only rule. Handed to the
// census WITHOUT the marker answer, they must come back NotAClaimFile -- and the same census, handed the
// paths that do declare claims, still reports those. One claim, both directions, so the marker test cannot
// be satisfied by simply reporting nothing.
test fn a_tracked_dag_that_declares_no_claim_is_never_reported_as_one() -> Bool {
  let rows = census_rows(listing: subject_helpers_declare_nothing, claim_bearers: subject_population_expected)
  let findings = outside_roots_findings(rows: rows)
  is_empty(findings)
    && all(xs: subject_helpers_declare_nothing, predicate: fn(path) {
         match outside_roots_row(path: path, claim_bearers: subject_population_expected) {
           NotAClaimFile { path: reported } => reported == path
           InsideGovernedTree { path: _, tree_directory: _ } => false
           OutsideDiscoveryRoots { path: _, cause: _ } => false
                }
       })
    && all(xs: subject_population_expected, predicate: fn(path) {
         is_in(listing: outside_roots_findings(rows: census_rows(listing: subject_population_expected, claim_bearers: subject_population_expected)), path: path)
       })
}

// The same shape for the files outside the subject whose text only MENTIONS the phrase in prose: no marker
// answer for them means no finding for them.
test fn prose_that_only_mentions_the_marker_is_not_a_claim_file() -> Bool {
  all(xs: prose_mentioning_paths, predicate: fn(path) {
    match outside_roots_row(path: path, claim_bearers: subject_population_expected) {
      NotAClaimFile { path: reported } => reported == path
      InsideGovernedTree { path: _, tree_directory: _ } => false
      OutsideDiscoveryRoots { path: _, cause: _ } => false
      }
  })
}

// THE NOTE IS CREDITED ONLY AT THE GRAIN IT ACTUALLY HOLDS. The note's body declares a SUBJECT --
// `git grep -c annotation_gap_round_trip_test -- dag/gunbc/ci/ci_layer_roots.dag` returns nothing, so the
// note names no file. A receipt that said a path was "declared by" the note would be crediting a
// directory-grain source with item-grain authority (DESIGN §5: a failure arm refuses, never widens), and it
// was what the first version of this census did on every line. So the assertion is in both directions: the
// vouched line says the path is WITHIN THE SUBJECT the note declares, and the false phrasing is asserted
// ABSENT -- "declared by" may not reappear, because a future edit that reintroduced it would read as the
// note having named the file.
test fn the_receipt_credits_the_note_only_at_the_grain_it_holds() -> Bool {
  let vouched = outside_roots_receipt_lines(
    findings: [head_path(paths: subject_population_expected)],
    vouched_by_note: true
  )
  let not_vouched = outside_roots_receipt_lines(
    findings: [head_path(paths: prose_mentioning_paths)],
    vouched_by_note: false
  )
  all(xs: vouched, predicate: fn(line) {
    string_contains(s: line, pattern: "within the subject")
      && string_contains(s: line, pattern: declaration_ref_display(ref: outside_roots_cause.note_subject))
      && !(string_contains(s: line, pattern: "declared by"))
  })
    && any(xs: not_vouched, predicate: fn(line) { string_contains(s: line, pattern: "OUTSIDE the subject") })
}

// THE GRAIN OF THE MARKER READ IS ON EVERY LINE, in both attributions. `acquisition_test_markers` is the
// authority on "declares a test fn" and it PARSES; the census was handed a regex over text. A line that
// named the note and the path while staying silent about which of those two spoke would read as the
// parser's verdict -- and this pattern already proved twice over that it is not one (prose `test fn` and
// fixture text both matched it). So the qualification is not a comment, it is printed, and this claim is
// what keeps it printed.
test fn every_receipt_line_says_the_marker_answer_is_a_pattern_match_not_the_marker_authority() -> Bool {
  let vouched = outside_roots_receipt_lines(
    findings: [head_path(paths: subject_population_expected)],
    vouched_by_note: true
  )
  let not_vouched = outside_roots_receipt_lines(
    findings: [head_path(paths: prose_mentioning_paths)],
    vouched_by_note: false
  )
  all(xs: vouched, predicate: fn(line) {
    string_contains(s: line, pattern: "not acquisition_test_markers")
  })
    && all(xs: not_vouched, predicate: fn(line) {
         string_contains(s: line, pattern: "not acquisition_test_markers")
       })
}

// THE MARKER PATTERN IS THE DECLARATION SHAPE, not the bare phrase -- claimed on the data the live entry
// reads with, because the two answer different populations. The bare phrase matches any `.dag` containing the
// letters `test fn` anywhere, including prose mentions in modules that implement other things; the anchored
// declaration shape matches only files that DECLARE one. A naive reader who passed the bare phrase would
// silently promote those prose files to findings, so "it contains the phrase" is not enough: the pattern must
// be anchored and must name a declaration.
test fn the_marker_pattern_asks_for_a_declaration_and_not_a_mention() -> Bool {
  !(claim_declaration_pattern == bare_marker_phrase)
    && claim_declaration_pattern.starts_with(prefix: "^")
    && string_contains(s: claim_declaration_pattern, pattern: bare_marker_phrase)
    && string_contains(s: claim_declaration_pattern, pattern: "[A-Za-z_]")
}

// The pure decision on an empty marker answer, in the same shape the listing capture has: no text at all is
// "the transport never answered", which is a refusal, not an empty population.
test fn no_text_at_all_from_the_marker_read_is_a_refusal() -> Bool {
  match bearers_from_captured_text(text: " \n ") {
    BearersRefused { failure: ReadNoAnswer } => true
    BearersRefused { failure: _ } => false
    BearersRead { paths: _ } => false
  }
}

// ---------------------------------------------------------------------------
// THE PARSE-BACKED ROUTE, PROBED RATHER THAN ARGUED (manager ask).
//
// The question was whether the seed parser can answer "declares a test fn" for a src/v1 file, which would
// let the census use the authority instead of a pattern. It CAN, and the probe is here rather than in a
// comment: `v2.compiler.test_marker_capture test_marker_content` walks a PARSE TREE and yields one
// TestMarkedContent {name, content} per `dag_surface_test_fn_decl` -- the same production
// v2.compiler.body_lowering_fold body_lower_test_fn_decl_to_member lowers -- over text read through the
// read-only Filesystem.Read service operation, the way
// src/v2/test/claim/text_string_importer_census.dag reads its own subjects. Note what this route does NOT
// need: acquisition_test_markers takes a ModuleFileRef, which v2.cli.repository_layout refuses to bind for a
// src/v1 path (its root matcher answers only [V2Tree, DagTree]), so the ACQUISITION route is closed for these
// files while the PARSE route, which takes text, is open. That distinction is the whole answer.
// ---------------------------------------------------------------------------

// THE SAME DISCRIMINATOR THE PATTERN READ FAILED, at the authority's grain. The three files the pattern read
// once reported as findings contain the phrase `test fn` in PROSE (in modules implementing other things). The
// parser gives them no shells: a comment is not a declaration node. This claim is the census's reason for
// trusting the declaration shape over the phrase -- the parser and the anchored pattern agree, and the
// parser is why the anchor is the right shape rather than a guess that happened to work.
test fn the_parse_route_declines_the_prose_files_the_pattern_read_once_matched() -> Bool {
  let read = Filesystem.Read(path: "src/v1/compile.dag")
  match parse_marker_names(text: read.content, path: "src/v1/compile.dag") {
    ParseMarkersRefused { cause: _ } => false
    ParseMarkersRead { names: names } => (length(xs: names) == 0) && read.success
  }
}

// AND THE SAME ROUTE FINDS THE DECLARATIONS WHERE THE SUBJECT HAS THEM, so the claim above cannot be green
// simply because parsing always answers empty. The file declares three test fns; the parse route names them,
// and its answer is compared to those names at identity -- not to a count, which a stub could match.
test fn the_parse_route_names_the_declared_test_fns_of_a_src_v1_file() -> Bool {
  let read = Filesystem.Read(path: probe_subject_path)
  match parse_marker_names(text: read.content, path: probe_subject_path) {
    ParseMarkersRefused { cause: _ } => false
    ParseMarkersRead { names: names } =>
      read.success
        && all(xs: probe_subject_expected_names, predicate: fn(name) {
             any(xs: names, predicate: fn(found) { found == name })
           })
  }
}

// THE PARSE ROUTE IS NOT THE CENSUS'S MARKER, AND THE CENSUS SAYS SO ON EVERY LINE. This claim pins the
// receipt token rather than trusting a comment: if the token were dropped, a pattern match over text would
// read as the marker authority's verdict, which is the transcribed standing DESIGN §6 forbids.
test fn the_census_receipt_never_borrows_the_marker_authoritys_name() -> Bool {
  let lines = outside_roots_receipt_lines(
    findings: [head_path(paths: subject_population_expected)],
    vouched_by_note: true
  )
  all(xs: lines, predicate: fn(line) {
    string_contains(s: line, pattern: "pattern-grain")
      && string_contains(s: line, pattern: "not acquisition_test_markers")
  })
}

// ---------------------------------------------------------------------------
// The parse probe's plumbing. A refusal is a distinct standing, not an empty answer: a claim that read
// "no names" from a refused parse would look exactly like the prose files, which is the fail-open shape.
// ---------------------------------------------------------------------------

data probe_subject_path: String = "src/v1/tests/claim/escape_json_string_differential.dag"

// THE NAMES THAT FILE DECLARES, read from its text by a person and pinned here as the thing the parse route
// is held to. Names, not a count: "three" is satisfiable by any three tokens, these are not.
// Read out of the file with `grep -n '^test fn' src/v1/tests/claim/escape_json_string_differential.dag`
// at this commit, and transcribed EXACTLY -- including the third name's `RED_` prefix, which is part of
// the identifier, not a standing. The first version of this list invented three plausible
// escape_json_string_* names that do not exist anywhere in the repo; the claim below FAILED on them,
// which is precisely what holding the parse route to names rather than a count is for.
data probe_subject_expected_names: List<String> = [
  "the_seed_copy_spells_every_control_code_point_per_rfc_8259",
  "the_seed_copy_leaves_quote_backslash_non_ascii_and_a_plain_word_per_rfc_8259",
  "RED_the_seed_copy_escapes_nul_and_backspace"
]

type ParseMarkers
  = ParseMarkersRead { names: List<String> }
  | ParseMarkersRefused { cause: String }

fn parse_marker_names(text: String, path: String) -> ParseMarkers {
  match prepare_grammar(grammar: dag_language_model().grammar) {
    Rejected { diagnostics: _ } => ParseMarkersRefused { cause: concat("grammar unprepared for ", path) }
    Accepted { value: prepared, diagnostics: _ } => match tokenize_prepared(
      text: text,
      file: symbol_intern_lexeme(lexeme: path),
      prepared: prepare_lex_rules(rules: dag_language_model().lex)
    ) {
      Rejected { diagnostics: _ } => ParseMarkersRefused { cause: concat("tokenize refused for ", path) }
      Accepted { value: tokens, diagnostics: _ } => match parse_module_prepared(tokens: tokens, prepared: prepared) {
        Rejected { diagnostics: _ } => ParseMarkersRefused { cause: concat("parse refused for ", path) }
        Accepted { value: artifact, diagnostics: _ } => match test_marker_content(tree: artifact.tree) {
          Rejected { diagnostics: _ } => ParseMarkersRefused { cause: concat("marker read refused for ", path) }
          Accepted { value: rows, diagnostics: _ } =>
            ParseMarkersRead { names: list_map(xs: rows, f: fn(row) { symbol_lexeme(sym: row.name) }) }
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// THE SCAN-DIR GAP: A POPULATION, NOT A STANDING.
//
// Five claims, each a refusal of a specific shortcut:
//  (1) a path inside one of the authority's three lanes never enters the population. The lazy implementation
//      -- "gap = anything under src/v2/test/claim" or "gap = anything not scanned that I know about" -- passes
//      this one while lying about scanned files, so the lane test is exercised against real lane paths.
//  (2) the ruled population and this standing-less population are DISJOINT, which is what one predicate read
//      in two directions buys: the layout refuses the note's paths (so they are ruled findings) and accepts
//      everything in the gap. Appearing twice under two judgments would be a double-count a reader cannot see.
//  (3) census visibility is decided by the layout authority, in one direction for each population.
//  (4) a path the marker read never answered cannot enter the population: it is a join over the answer, so it
//      is computed and not a hand-listed set someone remembered.
//  (5) the receipt says it rules no standing and names the lane authority, so the absence of a standing can
//      never be read as a judgment of "fine".
// ---------------------------------------------------------------------------

data note_declared_first_path: String = "src/v1/tests/claim/annotation_gap_round_trip_test.dag"

// Real paths from the authority's own three lanes, taken as tracked by `git ls-files` at this commit.
data scan_lane_fixture_paths: List<String> = [
  "dag/test/claim/a_payload_surplus_variant_wall.dag",
  "src/v2/test/claim/manual/add_body_emit_python.dag",
  "src/v2/test/claim/emit/arrow_scope_atom_refuses_unresolved.dag"
]

test fn a_path_in_a_scan_lane_never_enters_the_gap_population() -> Bool {
  all(xs: scan_lane_fixture_paths, predicate: fn(path) {
    !(any(xs: scan_dir_gap_population(claim_bearers: [path]), predicate: fn(gap) { gap == path }))
  })
}

// THE MUTUAL-EXCLUSION CLAIM. The two populations are decided by ONE predicate -- `repository_module_file_of_path`
// -- read in opposite directions, so a path can be in at most one of them. Asserted over the full subject
// list, where it is the property a reader actually needs: the 13 note paths carry a ruled standing and must
// not also appear in a standing-less population. It is exercised over the whole list rather than one path,
// because a partial list would let a prefix-typo exclusion look correct.
test fn the_ruled_population_and_the_gap_population_are_disjoint() -> Bool {
  let gap = scan_dir_gap_population(claim_bearers: subject_population_expected)
  all(xs: subject_population_expected, predicate: fn(path) {
    !(any(xs: gap, predicate: fn(g) { g == path }))
  })
}

// The layout's case is what keeps the two populations apart: `OutsideDiscoveryRoots` is refused BY the
// layout (Absent), this one is owned by the layout (Present) and skipped by the lanes. A path can be in at
// most one, and the src/v1 population must stay in its own standing. The case is MATCHED here exactly as
// `outside_roots_row` matches it -- no Bool predicate mediates the layout's answer (review 84153 #2).
test fn census_visibility_decides_which_population_a_path_is_in() -> Bool {
  all(xs: governed_listing_rows, predicate: fn(path) {
    match repository_module_file_of_path(path: path) {
      Present { value: _ } => true
      Absent => false
    }
  }) && all(xs: subject_population_expected, predicate: fn(path) {
    (match repository_module_file_of_path(path: path) {
       Present { value: _ } => false
       Absent => true
     }) && path_is_under_note_subject(path: path)
  })
}

// THE NOTE'S SUBJECT IS ONE FACT, NOT TWO (review 84153 #1, §3 "one fact, one home"): the census classifies
// paths by the note's subject directory, and that directory is a TYPED CARRIER at the note's own home in
// gunbc.ci.ci_layer_roots -- not a copy here. But a carrier beside prose is only one fact if they agree, so
// this claim reads the note's own String and requires it to NAME the directory the carrier declares. The
// RED is the drift: rewrite the note to a different subject and the carrier no longer matches its prose, so
// this goes RED and the census's sorting/receipt-credit cannot quietly keep crediting the old subject.
test fn the_subject_carrier_and_the_note_prose_agree() -> Bool {
  string_contains(s: v1_claim_scoped_witness_batch_deleted_note, pattern: v1_claim_scoped_witness_batch_deleted_subject_directory)
}

// The population is a JOIN over the marker answer: a path the read never answered cannot appear, no matter how
// un-scanned it is. A hand-listed population would pass every other claim here and still be fiction.
// POSITIVE MEMBERSHIP, on a real path. Every other claim here can be satisfied by a population that is
// always EMPTY -- which is exactly what "the census reports nothing and looks clean" means. This path is a
// tracked `.dag` that declares five test fns, sits under the layout's `src` root (so census-visible), and
// falls under none of the authority's three lanes. If the lane predicate stops excluding, this is the claim
// that says so; if the population silently empties, this is the claim that says so too.
data gap_member_fixture_path: String = "src/v2/test/claim/affected_set_universe.dag"

test fn a_real_census_visible_path_outside_every_lane_is_in_the_gap() -> Bool {
  let gap = scan_dir_gap_population(claim_bearers: [gap_member_fixture_path])
  any(xs: gap, predicate: fn(g) { g == gap_member_fixture_path })
}

test fn a_path_the_marker_read_never_answered_cannot_enter_the_gap() -> Bool {
  let gap = scan_dir_gap_population(claim_bearers: [note_declared_first_path])
  !(any(xs: gap, predicate: fn(g) { string_contains(s: g, pattern: "add_body_emit_python") }))
}

test fn the_gap_receipt_says_it_rules_no_standing_and_names_the_lane_authority() -> Bool {
  let lines = concat(scan_dir_gap_header_lines(), scan_dir_gap_receipt_lines(paths: [note_declared_first_path]))
  all(xs: lines, predicate: fn(line) { string_contains(s: line, pattern: "OUTSIDE-SCAN-DIRS") })
    && any(xs: lines, predicate: fn(line) { string_contains(s: line, pattern: "no standing is ruled") })
    && any(xs: lines, predicate: fn(line) { string_contains(s: line, pattern: declaration_ref_display(ref: scan_dir_authority)) })
}

// ---------------------------------------------------------------------------
// THE EMITTER JOIN, THROUGH THE REPO'S OWN MODELED AUTHORITIES (review 83368).
//
// This section used to `string_contains` over `// src/v1_tests_claim_<stem>.rs` comment lines in a seed Rust
// file, with a hand-written fallback stripping `_test` for one file. The reviewer was right that a comment in
// a Rust file is not a modeled authority -- and the reason it was worse than it looked is that the repo
// ALREADY models both halves of what I hand-rolled:
//
//   - READING the artifact: `gunbc.stage0.stage0_rust_host_observation::emitted_population_repo_paths` is the
//     structural inverse of the emitter's own write, splitting on
//     `emitted_population_manifest_line_separator` and stripping `emitted_population_manifest_line_prefix`,
//     both read from `gunbc.stage0.stage0_emitted_population_manifest`. That module documents why the artifact
//     is a `.rs` of COMMENT LINES: so the regen comparison covers it, with nothing parsing Rust. My grep was a
//     second, dumber parser of the same artifact.
//   - NAMING the emitted file: `gunbc.rust_emitted_edge::module_to_filename` maps a module to its file name,
//     composed with `stage0_package_root` and `stage0_source_dir_relative_to_package`.
//
// THE `_test` SPECIAL CASE IS GONE ENTIRELY, and the reason matters more than the deletion. It existed
// because I derived the expected name from the file PATH, whose stem keeps `_test`, while the emitter names the
// file after the DECLARED MODULE, whose name has no `_test` to strip.
// `src/v1/tests/claim/tco_tail_call_assigns_every_loop_slot_witness_test.dag` declares
// `module v1.tests.claim.tco_tail_call_assigns_every_loop_slot_witness`; `module_to_filename` of THAT is the
// artifact's line verbatim. There was never an irregularity to tolerate -- only a rule I had not read, and a
// fallback written to paper over my own gap. Deleting the fallback deletes the exception.
//
// WHAT THIS FILE CAN PROVE HERMETICALLY, and what it cannot. The declared module of a source file is known to
// the HOST -- it parses the file -- and is reachable through
// `v2.lens.module_graph::module_declaration_facts_live`, a host effect a hermetic claim cannot perform. So a
// hermetic claim here asserts the SHAPE of the join on facts it supplies, and says that in its name; the
// inhabitation claim, where the facts come from the host's own scan, is the wet
// `every_expected_subject_path_is_emitted_by_its_declared_module_by_real_execution`. A hermetic claim that
// passed itself its own module names and called that the check would be a fixture compared to a fixture, which
// is the exact failure mode the reviewer is guarding against.
// ---------------------------------------------------------------------------

test fn the_modeled_reader_yields_the_entry_the_declared_module_composes_to() -> Bool {
  let read = Filesystem.Read(path: emitted_registry_path)
  let emitted = emitted_population_repo_paths(content: read.content)
  read.success
    && !(is_empty(emitted))
    && any(
      xs: emitted,
      predicate: fn(entry) {
        entry == emitted_entry_for_module(module_name: "v1.tests.claim.escape_json_string_differential")
      }
    )
}

// THE NEGATIVE CONTROL. A join that cannot answer false proves nothing, so a module no emitter produced must
// compose to nothing IN THE SAME LIST the positive claim reads. The two claims differ by one trailing `x`,
// which is what makes the pair non-degenerate: satisfied together only by a predicate that discriminates.
test fn a_module_the_emitter_never_produced_composes_to_no_entry_in_the_population() -> Bool {
  let read = Filesystem.Read(path: emitted_registry_path)
  let emitted = emitted_population_repo_paths(content: read.content)
  read.success
    && !(any(
      xs: emitted,
      predicate: fn(entry) {
        entry == emitted_entry_for_module(module_name: "v1.tests.claim.escape_json_string_differentialx")
      }
    ))
}

// THE `_test` CASE, now an ordinary case. The declared module is asserted to carry no `_test` because that is
// what the file's own `module` header says -- the same rule as every other file, exercised on the one name
// that previously needed a fallback. Rename the module to keep `_test` and the entry stops matching, so the
// change is reported rather than absorbed by a fallback.
test fn the_test_suffixed_file_composes_to_its_entry_from_its_declared_module() -> Bool {
  let read = Filesystem.Read(path: emitted_registry_path)
  let emitted = emitted_population_repo_paths(content: read.content)
  let declared = "v1.tests.claim.tco_tail_call_assigns_every_loop_slot_witness"
  read.success
    && !(string_contains(s: declared, pattern: "_test"))
    && any(
      xs: emitted,
      predicate: fn(entry) { entry == emitted_entry_for_module(module_name: declared) }
    )
}

// THE JOIN PREDICATE, on supplied facts. Both halves must match -- the fact must name THIS path, and the
// fact's module must compose to an emitted entry -- and each negative case removes exactly one half, so
// neither half can be silently ignored. Without the facts-as-argument split this predicate could only have
// been exercised on the wet lane, where a broken fact match is indistinguishable from a broken read.
data join_fixture_path: String = "src/v1/tests/claim/escape_json_string_differential.dag"
data join_fixture_module: String = "v1.tests.claim.escape_json_string_differential"

test fn the_join_requires_the_fact_to_name_the_path_and_the_module_to_be_emitted() -> Bool {
  let facts = [ModuleDeclarationFact { module: join_fixture_module, path: join_fixture_path }]
  let other_path = [ModuleDeclarationFact { module: join_fixture_module, path: "src/v1/tests/claim/other.dag" }]
  let other_module = [ModuleDeclarationFact { module: "v1.tests.claim.carrier_realization_census", path: join_fixture_path }]
  let emitted = [emitted_entry_for_module(module_name: join_fixture_module)]
  subject_path_is_emitted(path: join_fixture_path, emitted: emitted, facts: facts)
    && !(subject_path_is_emitted(path: join_fixture_path, emitted: emitted, facts: other_path))
    && !(subject_path_is_emitted(path: join_fixture_path, emitted: emitted, facts: other_module))
    && !(subject_path_is_emitted(path: join_fixture_path, emitted: [], facts: facts))
}

// ---------------------------------------------------------------------------
// THE CITATION LIST IS THE WHOLE SET. The resolution claims ask the index about `outside_roots_citations`;
// if an entry were dropped from that list, every citation still in it would resolve and the census would
// keep PRINTING four authorities while CHECKING three -- a silent shrink of exactly the kind review 83419
// is about. The number below is not a tree measurement: `OutsideRootsCause` is a declared product of exactly
// four fields, plus the scan-dir authority, so five is a property of the type and a rename cannot move it.
// ---------------------------------------------------------------------------

test fn the_citation_list_covers_every_authority_the_cause_carries() -> Bool {
  let printed = list_map(xs: outside_roots_citations, f: fn(ref) { declaration_ref_display(ref: ref) })
  length(xs: printed) == 5
    && all(xs: [
         declaration_ref_display(ref: outside_roots_cause.tracked_by),
         declaration_ref_display(ref: outside_roots_cause.note_subject),
         declaration_ref_display(ref: outside_roots_cause.emitted_by),
         declaration_ref_display(ref: outside_roots_cause.layout_authority),
         declaration_ref_display(ref: scan_dir_authority)
       ], predicate: fn(citation) {
         any(xs: printed, predicate: fn(p) { p == citation })
       })
    && all(xs: printed, predicate: fn(p) {
         string_contains(s: p, pattern: ".")
           && !string_contains(s: p, pattern: " ")
       })
}

// ---------------------------------------------------------------------------
// THE UNREAD CAUSE IS A SUM (review 84644): each arm is a distinct, countable value, so a reader that asks
// "which read failed, and how" matches a constructor instead of searching a sentence. One fixture per arm,
// each through the real census route; the discriminator is the arm itself, and the counted total below is
// derived from the same list the arms are enumerated in, so a new arm that is not fixtured shows as a gap.
// ---------------------------------------------------------------------------

fn unread_via_listing(failure: CensusReadFailure) -> OutsideRootsOutcome {
  outside_roots_census(
    listing: ListingRefused { failure: failure },
    bearers: BearersRead { paths: subject_population_expected }
  ).outcome
}

fn unread_via_bearers(failure: CensusReadFailure) -> OutsideRootsOutcome {
  outside_roots_census(
    listing: ListingRead { paths: subject_population_expected },
    bearers: BearersRefused { failure: failure }
  ).outcome
}

test fn a_listing_whose_process_never_answered_is_the_index_process_absent_arm() -> Bool {
  match unread_via_listing(failure: ReadProcessAbsent) {
    CensusUnread { cause: IndexUnread { failure: ReadProcessAbsent } } => true
    _ => false
  }
}

test fn a_listing_the_process_refused_keeps_its_exit_code_and_stderr_as_data() -> Bool {
  match unread_via_listing(failure: ReadProcessRefused { exit_code: 128, stderr: "fatal: not a git repository" }) {
    CensusUnread { cause: IndexUnread { failure: ReadProcessRefused { exit_code: code, stderr: err } } } =>
      code == 128 && err == "fatal: not a git repository"
    _ => false
  }
}

test fn an_empty_listing_answer_is_the_index_no_answer_arm() -> Bool {
  match unread_via_listing(failure: ReadNoAnswer) {
    CensusUnread { cause: IndexUnread { failure: ReadNoAnswer } } => true
    _ => false
  }
}

test fn a_marker_read_whose_process_never_answered_is_the_marker_process_absent_arm() -> Bool {
  match unread_via_bearers(failure: ReadProcessAbsent) {
    CensusUnread { cause: MarkerUnread { failure: ReadProcessAbsent } } => true
    _ => false
  }
}

test fn a_marker_read_the_process_refused_keeps_its_exit_code_and_stderr_as_data() -> Bool {
  match unread_via_bearers(failure: ReadProcessRefused { exit_code: 2, stderr: "fatal: bad pattern" }) {
    CensusUnread { cause: MarkerUnread { failure: ReadProcessRefused { exit_code: code, stderr: err } } } =>
      code == 2 && err == "fatal: bad pattern"
    _ => false
  }
}

test fn an_empty_marker_answer_is_the_marker_no_answer_arm() -> Bool {
  match unread_via_bearers(failure: ReadNoAnswer) {
    CensusUnread { cause: MarkerUnread { failure: ReadNoAnswer } } => true
    _ => false
  }
}

// The six arms render to six distinct receipts, and only the renderer makes prose: the subject axis and the
// failure axis both show, so two causes that differ in either never print the same line.
test fn the_six_unread_causes_render_to_six_distinct_receipt_texts() -> Bool {
  let causes = [
    IndexUnread { failure: ReadProcessAbsent },
    IndexUnread { failure: ReadProcessRefused { exit_code: 1, stderr: "e" } },
    IndexUnread { failure: ReadNoAnswer },
    MarkerUnread { failure: ReadProcessAbsent },
    MarkerUnread { failure: ReadProcessRefused { exit_code: 1, stderr: "e" } },
    MarkerUnread { failure: ReadNoAnswer }
  ]
  let texts = list_map(xs: causes, f: fn(c) { census_unread_cause_text(cause: c) })
  length(xs: texts) == 6
    && all_pairs_differ(texts: texts)
}

fn all_pairs_differ(texts: List<String>) -> Bool {
  match texts {
    Empty => true
    Cons { head: h, tail: t } => !any(xs: t, predicate: fn(o) { o == h }) && all_pairs_differ(texts: t)
  }
}

test fn a_refused_exit_code_and_stderr_reach_the_rendered_receipt() -> Bool {
  let text = census_unread_cause_text(cause: IndexUnread { failure: ReadProcessRefused { exit_code: 128, stderr: " fatal: nope \n" } })
  string_contains(s: text, pattern: "exit 128") && string_contains(s: text, pattern: "fatal: nope")
}
