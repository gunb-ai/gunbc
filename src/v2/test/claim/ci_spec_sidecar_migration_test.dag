module v2.test.claim.ci_spec_sidecar_migration

import gunbc.ci_spec {
  ci_floor_build_verify_script,
  ci_release_build_script,
  gunbc_ci_spec,
  gunbc_ci_run_script
}
import v2.std.logic { Bool }

data golden_floor_build_verify_script: String = "\"$ROOT/target/release/claim_executor\" --verify-build-artifacts \"$ROOT/target/release/claim_executor\" \"$ROOT/target/release/gunbc\"\n"

test fn ci_spec_floor_build_verify_script_byte_identical_holds() -> Bool {
  ci_floor_build_verify_script() == golden_floor_build_verify_script
}

test fn ci_spec_release_build_script_artifact_tail_byte_identical_holds() -> Bool {
  string_contains(s: ci_release_build_script(), pattern: golden_floor_build_verify_script)
    && string_contains(s: gunbc_ci_run_script(spec: gunbc_ci_spec), pattern: golden_floor_build_verify_script)
}
