module v2.test.languages_consumer_census.corpus.rust_language_external_consumer

import v2.lens.languages_consumer_census {
  languages_consumer_census_live_external_consumer_count,
  languages_consumer_census_live_has_external_consumer
}
import v2.std.logic { Bool }
import v2.std.text { String }

data rust_language_decl: String = "rust_language"

test fn corpus_rust_language_has_external_consumer() -> Bool {
  languages_consumer_census_live_has_external_consumer(decl_name: rust_language_decl)
}

test fn corpus_rust_language_external_consumer_count_positive() -> Bool {
  languages_consumer_census_live_external_consumer_count(decl_name: rust_language_decl) > 0
}
