module v2.test.claim.edge_label.structural_label_readers

import std.occurrence_identity { OccurrenceSynthetic }
import std.types { List }
import v2.std.node {
  Atom,
  Authored,
  Conj,
  Edge,
  EdgeLabel,
  Node,
  Symbol,
  TypeNode,
  ArrowBodyEdge,
  LoopBoundEdge,
  MatchArmPatternEdge,
  CastTargetEdge,
  core_edge,
  edge_is_core,
  label_occurrences,
  all_names_distinct,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.extdeps.languages.dag {
  dag_surface_edge,
  dag_surface_edge_label,
  dag_surface_module_header_metadata_edge,
  dag_node_is_module_root_conj,
  dag_node_is_module_surface,
  dag_node_is_record_field_carrier,
  dag_named_edge,
}
import v2.compiler.body_lowering_fold { body_lower_edge_names_where_clause }
import v2.compiler.resolution_provenance { ReferenceSite }
import v2.lens.module_graph { site_is_import_syntax_mention }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: the readers that used to recognise a grammar-structural edge by its label TEXT
// (gunbc.recurring_failure_mode behavior_named_edge_label_validated_not_constructed, the EdgeLabel
// climb). Each is asked twice at its own interface with a supplied edge: once with the real
// structural label, which it must still recognise, and once with an AUTHORED name spelled exactly
// like that label, which it must not. Before the coproduct both edges were one value, so every
// "authored" row below answered like its structural partner. The real-path inhabitance for these
// labels is carried by the existing parse and graft claims that reach the same readers through
// ingest (v2.test.claim.parse.where_refinement_clause_parse, v2.test.claim.namespace_graft.*).

fn slr_atom(id: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: id } }, children: [], occurrence_id: OccurrenceSynthetic }
}

fn slr_authored(name: Symbol) -> Edge {
  Edge { label: Authored { name: name }, target: slr_atom(id: name) }
}

fn slr_conj(children: List<Edge>) -> Node {
  Node { kind: TypeNode { connective: Conj }, children: children, occurrence_id: OccurrenceSynthetic }
}

fn slr_site(position: List<EdgeLabel>) -> ReferenceSite {
  ReferenceSite { position: position, spelling: [^slr_mention] }
}

// Reader 1: v2.extdeps.languages.dag dag_surface_module_header_metadata_edge.
test fn the_header_edges_are_metadata_and_their_spellings_are_not() -> Bool {
  dag_surface_module_header_metadata_edge(e: dag_surface_edge(edge: ^dag_surface_module_header, target: slr_atom(id: ^h)))
    && dag_surface_module_header_metadata_edge(e: dag_surface_edge(edge: ^dag_surface_module_header_qualified_name, target: slr_atom(id: ^q)))
    && !dag_surface_module_header_metadata_edge(e: slr_authored(name: ^dag_surface_module_header))
    && !dag_surface_module_header_metadata_edge(e: slr_authored(name: ^dag_surface_module_header_qualified_name))
}

// Reader 2: the Absent-emission arm of dag_node_is_module_root_conj. The specimen the failure mode
// recorded -- `fn f(dag_surface_module_header: Int)` gives a Conj a member edge named like the
// header -- is the authored row.
test fn a_member_spelled_like_the_header_does_not_make_a_module_root() -> Bool {
  dag_node_is_module_root_conj(n: slr_conj(children: [dag_surface_edge(edge: ^dag_surface_module_header, target: slr_atom(id: ^h))]))
    && !dag_node_is_module_root_conj(n: slr_conj(children: [slr_authored(name: ^dag_surface_module_header)]))
}

fn slr_identity(id: Symbol) -> Node {
  slr_conj(children: [dag_named_edge(name: ^grammar_production_identity_node_projection, target: slr_atom(id: id))])
}

// THE THREE STAMPS, AND NOT THE CHILDREN SHAPE. A module surface is a declaration identity, a
// graft-body stamp, or a dag_surface_module_header production edge. A Conj of Authored members that
// merely looks like a container is a record-field carrier.
test fn a_module_surface_is_stamped_not_guessed_from_children() -> Bool {
  dag_node_is_module_surface(n: slr_identity(id: ^dag_surface_module))
    && dag_node_is_module_surface(n: slr_identity(id: ^dag_surface_fn_decl))
    && dag_node_is_module_surface(n: slr_identity(id: ^namespace_graft_module_body))
    && dag_node_is_module_surface(n: slr_conj(children: [dag_surface_edge(edge: ^dag_surface_module_header, target: slr_atom(id: ^h))]))
    && !dag_node_is_module_surface(n: slr_conj(children: [slr_authored(name: ^dag_surface_module_header)]))
    && !dag_node_is_module_surface(n: slr_conj(children: [slr_authored(name: ^x)]))
}

test fn a_hand_built_record_is_a_field_carrier_and_a_module_surface_is_not() -> Bool {
  dag_node_is_record_field_carrier(n: slr_conj(children: [slr_authored(name: ^x)]))
    && !dag_node_is_record_field_carrier(n: slr_identity(id: ^dag_surface_module))
    && !dag_node_is_record_field_carrier(n: slr_identity(id: ^dag_surface_type_decl))
}

// Reader 3: v2.compiler.body_lowering_fold body_lower_edge_names_where_clause.
test fn a_field_spelled_like_the_where_clause_is_not_one() -> Bool {
  body_lower_edge_names_where_clause(e: dag_surface_edge(edge: ^dag_surface_where_refinement_clause, target: slr_atom(id: ^w)))
    && !body_lower_edge_names_where_clause(e: slr_authored(name: ^dag_surface_where_refinement_clause))
}

// Reader 4: v2.lens.module_graph site_is_import_syntax_mention over a ReferenceSite position.
test fn a_scope_spelled_like_import_syntax_is_not_import_syntax() -> Bool {
  site_is_import_syntax_mention(site: slr_site(position: [Authored { name: ^m }, dag_surface_edge_label(edge: ^dag_surface_import_decl)]))
    && site_is_import_syntax_mention(site: slr_site(position: [dag_surface_edge_label(edge: ^dag_surface_import_block)]))
    && site_is_import_syntax_mention(site: slr_site(position: [dag_surface_edge_label(edge: ^dag_surface_import_decl_qualified_name)]))
    && !site_is_import_syntax_mention(site: slr_site(position: [Authored { name: ^m }, Authored { name: ^dag_surface_import_decl }]))
    && !site_is_import_syntax_mention(site: slr_site(position: [Authored { name: ^dag_surface_import_block }]))
    && !site_is_import_syntax_mention(site: slr_site(position: [Authored { name: ^dag_surface_import_decl_qualified_name }]))
}

// The core markers: an authored name spelled like a marker's canonical symbol is not that marker,
// and a node may carry both without the label-distinctness rule treating them as one label.
test fn an_authored_name_spelled_like_a_core_marker_is_not_the_marker() -> Bool {
  edge_is_core(e: core_edge(marker: ArrowBodyEdge, target: slr_atom(id: ^b)), marker: ArrowBodyEdge)
    && !edge_is_core(e: slr_authored(name: ^arrow_body_edge), marker: ArrowBodyEdge)
    && !edge_is_core(e: slr_authored(name: ^loop_bound_edge), marker: LoopBoundEdge)
    && !edge_is_core(e: slr_authored(name: ^match_arm_pattern), marker: MatchArmPatternEdge)
    && !edge_is_core(e: core_edge(marker: ArrowBodyEdge, target: slr_atom(id: ^b)), marker: CastTargetEdge)
    && all_names_distinct(children: [core_edge(marker: ArrowBodyEdge, target: slr_atom(id: ^b)), slr_authored(name: ^arrow_body_edge)])
    && (label_occurrences(label: Authored { name: ^arrow_body_edge }, children: [core_edge(marker: ArrowBodyEdge, target: slr_atom(id: ^b))]) == 0)
}
