module v2.test.claim.claim_coverage_census_s1_witness

// THE DISCOVERED-UNIVERSE CENSUS, WITNESSED (Charter 4 exit census, sunny-ibex-149).
//
// The live census (`gunbc.claim_coverage_census_live claim_coverage_census_exit`) reads the checkout and
// cannot be answered by a test. Its POLICY is pure and injected: `v2.workflow.claim_coverage_census_s1
// classify_rows`/`derive_executed` decide standings and executed-by from an injected universe, claim rows,
// classifier rows and produced identities, and `v2.workflow.claim_coverage_census_s1_live s1_block` turns a
// composition into printed lines plus an exit. So every arm below -- including all three exits -- is
// checked over fixtures decided by the same functions the live instrument runs.
//
// NO COUNT LITERALS, NO HEAD READING, NO SILENT ARMS. Nothing here asserts a population size of the live
// corpus: an exact expected list is asserted instead, so a carrier that silently gained or lost members
// fails a named expectation rather than a number. And every fixture asserts its OWNERSHIP of the line it
// expects -- "some line mentions it", never "some line exists" -- because an assertion that passes when the
// census prints nothing at all is how a census that stopped answering reads as green. Where a test needs to
// show a channel is not muted, it pairs a stale member with a grounded one in the SAME carrier: a channel
// that printed everything, or nothing, would fail one of the two halves.

import std.types { String, Bool, List, Map }
import std.algebra { string_contains, empty_map, map_insert, is_empty }
import std.optional { Absent, Present }
import v2.workflow.claim_coverage_census_s1 {
  ClaimRow, ClassifierRow, ClassifierRole, CoverRole, EnrollmentRole,
  IdentityMember, DeclaredMember, FileMember,
  ExactMemberMatch, SubstringMemberMatch, classifier_member_text,
  S1Census, ClassifierStanding, GroundedCover, S1Composed, S1InputsUnread,
  RequiredJobLabelDefect, LabelUnbound, LabelAmbiguous,
  classify_rows, derive_executed, s1_uncovered, s1_census_lines, s1_stamp_head,
  s1_block, S1Standing, S1Held, S1DidNotHold, S1Unread
}
import v2.workflow.claim_coverage_census_s1_carriers {
  s1_all_classifier_rows, cover_witness_entry_row
}
// THE LIVE MODULE IS IMPORTED DELIBERATELY: a module no claim imports is a module no witness RESOLVES, and
// that is how its `Cons`-into-a-`List`-field type error survived a green per-file parse sweep (see
// `a_live_function_resolves_and_names_nothing_for_a_producer_that_names_nothing`). Importing is not
// READING: the one entry this corpus calls is a pure match over producer variants. The claims that DO read
// the checkout -- the scoped real-discovery pairing claims -- live in
// `v2.test.claim.claim_coverage_census_s1_live_pairing`, which states why they cannot live here.
import v2.workflow.claim_coverage_census_s1_live {
  producer_named_identities, credited_producer_names
}
import gunbc.target_binding {
  TargetBinding, TargetProducer, RequiredFloorProducer, CliWireProgramProducer
}
import extdeps.bazel.label { Label, PackagePath, TargetName }
import std.realization_schedule { ScheduleWitnessEntry, CorpusWitnessKind }
import gunbc.claim_coverage_census {
  ClaimCoverageStanding, ClaimCoverageHeld, ClaimCoverageDidNotHold, UncoveredClaim
}
import gunbc.claim_coverage_census_live {
  ComposedCensusStanding, ComposedHeld, ComposedFinding, ComposedUnread,
  claim_coverage_composed_standing, claim_coverage_composed_exit, claim_coverage_composed_exit_code
}
import gunbc.cli_wire { CliWirePrintable }
import std.process { ExitSuccess, ExitFailure }
import v2.workflow.claim_coverage_census_s1 { s1_exit_code_did_not_hold, s1_exit_code_unread }

// The fixture corpus: two claims of module `m` over `m.dag` and one of module `other` over `other.dag`.
// The module is a fixture token and the identity is its exact `module.function` spelling -- the same shape
// the source ingress produces, so the join is exercised rather than approximated.
fn fixture_rows() -> List<ClaimRow> {
  [
    ClaimRow { identity: "m.a", entry: "m.dag", function: "a" },
    ClaimRow { identity: "m.b", entry: "m.dag", function: "b" },
    ClaimRow { identity: "other.c", entry: "other.dag", function: "c" }
  ]
}

fn fixture_universe() -> List<String> {
  ["m.a", "m.b", "other.c"]
}

// A cover row naming one identity, as the fill-debt list and floor_expected_red spell them. The arm IS
// the grain: an identity member carries the claim spelling and no relation, because an identity joins by
// exact spelling and nothing else (review 82804 dissolved the old grain-plus-dummy-fields record).
fn cover_identity(carrier: String, member: String) -> ClassifierRow {
  ClassifierRow {
    carrier: carrier,
    member: IdentityMember { identity: member },
    role: CoverRole
  }
}

// An ENROLLMENT row (floor_expected_red's shape): same member arm, the EnrollmentRole, because an
// expectation excuses nothing. Review 82845: the role is a coproduct fixed by this constructor, not a Bool
// a caller passes -- a wrong `true` used to be writable and silent.
fn expectation_identity(member: String) -> ClassifierRow {
  ClassifierRow {
    carrier: "v2.workflow.floor_route_authority.floor_expected_red",
    member: IdentityMember { identity: member },
    role: EnrollmentRole
  }
}

// A cover row over a whole FILE: the grain the frozen deferrals and the bin wet entries declare. The fold
// grounds it through the one expansion -- never by string surgery.
fn cover_file(carrier: String, member: String) -> ClassifierRow {
  ClassifierRow {
    carrier: carrier,
    member: FileMember { path: member, match_: ExactMemberMatch, function: Absent },
    role: CoverRole
  }
}

// A file cover narrowed to one function: the shape a carrier reaches when it names one claim of a file.
// The function is a declared field of the arm, never parsed out of the member.
fn cover_file_fn(carrier: String, member: String, function: String) -> ClassifierRow {
  ClassifierRow {
    carrier: carrier,
    member: FileMember { path: member, match_: ExactMemberMatch, function: Present { value: function } },
    role: CoverRole
  }
}

// A frontier pattern: substring matching exists ONLY for that carrier, and this is how the witness says
// "this row is a frontier pattern" without reaching for the real carrier.
fn frontier_pattern(pattern: String) -> ClassifierRow {
  ClassifierRow {
    carrier: "gunbc.ci.ci_layer_roots.witness_exclusion_frontier",
    member: FileMember { path: pattern, match_: SubstringMemberMatch, function: Absent },
    role: CoverRole
  }
}

// A member the carrier declared at NO grain -- a rung_drop population is List<String>, so the declaration
// carries a text and no grain. The fold joins it against the discovered identities and then the discovered
// file paths and refuses it only when neither bears it; no spelling test is involved.
fn declared_member(carrier: String, text: String) -> ClassifierRow {
  ClassifierRow {
    carrier: carrier,
    member: DeclaredMember { text: text },
    role: CoverRole
  }
}

// The fill-debt carrier, spelled once so every stale-row assertion names the carrier it claims to test.
data fill_debt_carrier: String = "v2.workflow.floor_pure_producer_share.floor_single_claim_fill_debt"

// `s1_uncovered` answers by identity; membership is a fold, so no builtin spelling can be assumed here.
fn list_has(xs: List<String>, wanted: String) -> Bool {
  fold(
    xs,
    init: false,
    f: fn(acc, x) { acc || x == wanted }
  )
}

fn covered(census: S1Census, identity: String) -> Bool {
  !list_has(xs: s1_uncovered(census: census), wanted: identity)
}

fn line_names(lines: List<String>, needle: String) -> Bool {
  any(lines, s => string_contains(s: s, pattern: needle))
}

// THE LOCATOR IS BESIDE THE CENSUS, NOT INSIDE IT (warm-wolf-570: the head is a locator, not an input, and
// the host-native route cannot run git). Both halves are asserted, because either one alone lets the
// regression back in: a census that still took a head would print a locator itself, and a stamp that was
// optional or filled with a placeholder would print none. So -- the census's own lines contain NO locator,
// and stamping prepends EXACTLY ONE carrying the revision it was given.
fn head_stamped_beside(lines: List<String>) -> Bool {
  let stamped = s1_stamp_head(lines: lines, head: "fixturehead")
  !any(lines, line => string_contains(s: line, pattern: "S1-CENSUS head:"))
    && any(stamped, line => line == "S1-CENSUS head:fixturehead")
    && (stamped |> filter(line => string_contains(s: line, pattern: "S1-CENSUS head:")) |> count == 1)
}

// A row's verdict, read from its carrier+member -- the standing carries the row it judged, so the witness
// asks the same question a reader of the receipt asks: which row, and how did it stand.
fn stale_stands(stands: List<ClassifierStanding>, member: String) -> Bool {
  any(stands, standing => match standing {
    StaleEnrolled { row: row } => classifier_member_text(row: row) == member
    _ => false
  })
}

fn ungrounded_stands(stands: List<ClassifierStanding>, member: String) -> Bool {
  any(stands, standing => match standing {
    UngroundedDropMember { row: row } => classifier_member_text(row: row) == member
    _ => false
  })
}

fn grounded_cover(stands: List<ClassifierStanding>, member: String) -> Bool {
  any(stands, standing => match standing {
    GroundedCover { row: row, covers: _ } => classifier_member_text(row: row) == member
    _ => false
  })
}

fn covers_of(stands: List<ClassifierStanding>, member: String) -> List<String> {
  fold(
    stands,
    init: [],
    f: fn(acc, standing) {
      match standing {
        GroundedCover { row: row, covers: covers } =>
          if classifier_member_text(row: row) == member { covers } else { acc }
        _ => acc
      }
    }
  )
}

// A census over an injected classification, so no test restates the classification it is asserting.
fn census_over(rows: List<ClaimRow>, universe: List<String>, covers: List<ClassifierRow>, produced: List<String>) -> S1Census {
  S1Census {
    universe: universe,
    rows: rows,
    executed: derive_executed(rows: rows, produced: produced),
    stands: classify_rows(universe: universe, rows: rows, classifier_rows: covers)
  }
}

// POSITIVE CONTROL: a controlled fixture with a KNOWN covered set exits 0. Two claims are covered (one by
// an identity row, one by a function-narrowed file row), the third by a whole-file drop row, and the
// required job's bound producer names one identity: the census holds, prints the head it was read at, and
// names nothing as a finding. This is the arm that fails if any finding channel is muted -- so the covered
// set itself is asserted per identity, not just the exit.
test fn a_fixture_whose_claims_are_all_covered_holds_and_exits_zero() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [
      cover_identity(carrier: "t.drop", member: "m.a"),
      cover_file_fn(carrier: "t.drop", member: "m.dag", function: "b"),
      cover_file(carrier: "t.drop", member: "other.dag")
    ],
    produced: ["m.a"]
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  match block.standing { S1Held => true, _ => false }
    && covered(census: census, identity: "m.a")
    && covered(census: census, identity: "m.b")
    && covered(census: census, identity: "other.c")
    && head_stamped_beside(lines: block.lines)
    && !line_names(lines: block.lines, needle: "UNCOVERED ")
    && !line_names(lines: block.lines, needle: "STALE-ENROLLED")
    && !line_names(lines: block.lines, needle: "UNGROUNDED-DROP-MEMBER")
}

// REMOVE A COVERED CLAIM FROM ITS DROP AND THE CENSUS MUST NAME IT (warm-wolf-570's RED). The row covering
// `m.b` is deleted and nothing else changes: `m.b` alone is named, the census exits 1, and the reason says
// the universe did not hold. The other two are asserted NOT named, which is what makes this a report about
// the deleted cover rather than about the fixture.
test fn removing_a_covered_claim_from_its_drop_makes_the_census_name_it() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [
      cover_identity(carrier: "t.drop", member: "m.a"),
      cover_file(carrier: "t.drop", member: "other.dag")
    ],
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  match block.standing { S1DidNotHold { reason: _ } => true, _ => false }
    && (s1_uncovered(census: census) == ["m.b"])
    && line_names(lines: block.lines, needle: "UNCOVERED m.b")
    && !line_names(lines: block.lines, needle: "UNCOVERED m.a")
    && !line_names(lines: block.lines, needle: "UNCOVERED other.c")
    && match block.standing {
         S1DidNotHold { reason: reason } => string_contains(s: reason, pattern: "did not hold")
         _ => false
       }
}

// AN EXPECTATION EXCUSES NOTHING. floor_expected_red rows carry EnrollmentRole, so naming an uncovered
// claim in it cannot green the census: the claim stays uncovered and the census exits 1. The other arm of
// the same fixture is a cover row holding the census (above), so this is about cover vs expectation and not
// about the fixture.
test fn a_floor_expected_red_row_never_covers_a_claim() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [
      cover_identity(carrier: "t.drop", member: "m.a"),
      cover_file(carrier: "t.drop", member: "other.dag"),
      expectation_identity(member: "m.b")
    ],
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  match block.standing { S1DidNotHold { reason: _ } => true, _ => false }
    && (s1_uncovered(census: census) == ["m.b"])
    && !line_names(lines: block.lines, needle: "UNCOVERED m.a")
}

// STALE ENROLLMENT IS NAMED, EVERY ONE OF IT. These are jolly-boar-495's pre-fix #14373 fill-debt rows, at
// the identities the pre-fix carrier itself declared (module field + claim, from c07970511^: the rows at
// src/v2/workflow/floor_pure_producer_share.dag lines 1059/1264/1592). None of the three claims exists at
// this head, so each must be refused BY NAME -- not counted, not dropped -- and the census must exit 1
// because of them. The whole dotted identity is asserted, because a bare function name joins to nothing at
// the identity grain and the RED would then pass vacuously.
test fn the_three_prefix_fill_debt_rows_are_stale_enrolled_by_name() -> Bool {
  let rows = fixture_rows()
  let stale = [
    "v2.test.claim.body_cast_node.bcn_let_in_value_cast_carries_its_target",
    "v2.test.claim.compiler.kernel_value_type_roster_witness.kvr_a_named_calls_bool_formal_is_counted_not_judged_holds",
    "v2.test.claim.type_param_binder_frame.tpb_emitter_refuses_a_generic_arrow"
  ]
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: map(stale, member => cover_identity(carrier: fill_debt_carrier, member: member)),
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  match block.standing { S1DidNotHold { reason: _ } => true, _ => false }
    && all(stale, member => line_names(lines: block.lines, needle: concat("STALE-ENROLLED ", concat(fill_debt_carrier, concat(" ", member)))))
    && all(stale, member => stale_stands(stands: census.stands, member: member))
    && head_stamped_beside(lines: block.lines)
}

// THE SAME CARRIER, POST-FIX: NOTHING IS STALE, AND THE RENAMED CLAIM IS GROUNDED. Two halves in one
// carrier over one file: the pre-fix tpb identity (which #14373 renamed away) stands stale, and the real
// claim -- `..._where_rows_declare_no_type_params` -- stands a grounded cover over exactly its own
// identity. A stale channel that printed everything would fail the second half; one that printed nothing
// would fail the first. This is the non-vacuity check for the test above, and it is the shape of the
// positive control jolly-boar-495 asked for: the post-fix list prints none.
test fn the_prefix_row_is_stale_while_its_renamed_successor_is_grounded() -> Bool {
  let tpb = "v2.test.claim.type_param_binder_frame"
  let prefix = concat(tpb, ".tpb_emitter_refuses_a_generic_arrow")
  let successor = concat(prefix, "_where_rows_declare_no_type_params")
  let rows = [ClaimRow { identity: successor, entry: "tpb.dag", function: "tpb_emitter_refuses_a_generic_arrow_where_rows_declare_no_type_params" }]
  let universe = [successor]
  let census = census_over(
    rows: rows,
    universe: universe,
    covers: [
      cover_identity(carrier: fill_debt_carrier, member: prefix),
      cover_identity(carrier: fill_debt_carrier, member: successor)
    ],
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  stale_stands(stands: census.stands, member: prefix)
    && line_names(lines: block.lines, needle: concat("STALE-ENROLLED ", concat(fill_debt_carrier, concat(" ", prefix))))
    && !line_names(lines: block.lines, needle: concat("STALE-ENROLLED ", concat(fill_debt_carrier, concat(" ", successor))))
    && grounded_cover(stands: census.stands, member: successor)
    && (covers_of(stands: census.stands, member: successor) == universe)
    && !stale_stands(stands: census.stands, member: successor)
}

// THE FULL POST-FIX LIST PRINTS NOTHING STALE. Every member resolves into the discovered universe, so the
// stale channel is silent AND the census holds -- silence with a clean exit, not silence over findings.
test fn a_fully_resolving_carrier_prints_no_stale_row_and_holds() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [
      cover_identity(carrier: fill_debt_carrier, member: "m.a"),
      cover_identity(carrier: fill_debt_carrier, member: "m.b"),
      cover_identity(carrier: fill_debt_carrier, member: "other.c")
    ],
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  !line_names(lines: block.lines, needle: "STALE-ENROLLED")
    && match block.standing { S1Held => true, _ => false }
    && all(fixture_universe(), id => grounded_cover(stands: census.stands, member: id))
}

// STALENESS IS DECIDED AGAINST THE WHOLE UNIVERSE, never against a filtered view of it. `m.a` is in the
// universe but is absent from the injected rows: a caller that classified over the ROWS would report it
// stale, while the fold classifies over the UNIVERSE, so an enrolled claim discovery holds is never refused.
// This is what keeps a filtered report (uncovered-only, say) from inventing stale enrollments.
test fn a_claim_the_universe_holds_is_never_stale_enrolled_when_rows_are_filtered() -> Bool {
  let rows = [ClaimRow { identity: "m.b", entry: "m.dag", function: "b" }]
  let census = S1Census {
    universe: fixture_universe(),
    rows: rows,
    executed: [],
    stands: classify_rows(
      universe: fixture_universe(),
      rows: rows,
      classifier_rows: [
        cover_identity(carrier: "t.drop", member: "m.a"),
        cover_identity(carrier: "t.drop", member: "m.b")
      ]
    )
  }
  !line_names(lines: s1_census_lines(census: census), needle: "STALE-ENROLLED m.a")
    && covered(census: census, identity: "m.a")
    && covered(census: census, identity: "m.b")
}

// A DROP MEMBER THAT GROUNDS IN NEITHER POPULATION IS REFUSED, EACH ONE A FINDING. The size of that live
// population is the instrument's output (`gunbc test //gunbc/instruments:claim-coverage-census`) and is
// deliberately not restated here -- a transcribed count rots unreachably (DESIGN §6). What these claims
// assert is the SHAPE's handling, over fixture instances of it. These
// values are fixture instances of the shape warm-wolf-570 ruled must not be repaired by editing the
// declaration: they parse as neither a `.dag` path nor a dotted identity. They travel at their declared text
// and the census refuses them by carrier AND member, so every one of them is a located finding.
test fn a_drop_member_that_is_neither_path_nor_identity_is_an_ungrounded_refusal() -> Bool {
  let rows = fixture_rows()
  let ungroundable = [
    "the whole long-lane class is excused",
    "long_lane_quarantine_membership",
    "some.identation.that.is.not.a.path.and.not.a.claim"
  ]
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: map(ungroundable, member => declared_member(carrier: "gunbc.rung_drop.t.drop", text: member)),
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  match block.standing { S1DidNotHold { reason: _ } => true, _ => false }
    && all(ungroundable, member => line_names(lines: block.lines, needle: concat("UNGROUNDED-DROP-MEMBER gunbc.rung_drop.t.drop ", member)))
    && all(ungroundable, member => ungrounded_stands(stands: census.stands, member: member))
}

// GRAIN IS THE ARM AND GROUNDING IS THE JOIN, NEVER A SPELLING TEST (review 82792, then 82804). The SAME
// member text under the two arms, grounded by the population each arm joins against: as a file member
// `m.dag` grounds through the file's discovered claims; as an identity member it is not a claim discovery
// holds, so it is `StaleEnrolled` -- a verdict from the universe, not from the member containing `.dag`.
// Nothing here asks the member what it looks like, and no arm can carry a relation its grain cannot answer.
test fn each_grain_is_grounded_by_the_population_it_joins_and_never_by_spelling() -> Bool {
  let rows = fixture_rows()
  let as_file = classify_rows(
    universe: fixture_universe(),
    rows: rows,
    classifier_rows: [cover_file(carrier: "t.drop", member: "m.dag")]
  )
  let as_identity = classify_rows(
    universe: fixture_universe(),
    rows: rows,
    classifier_rows: [cover_identity(carrier: "t.drop", member: "m.dag")]
  )
  (covers_of(stands: as_file, member: "m.dag") == ["m.a", "m.b"])
    && stale_stands(stands: as_identity, member: "m.dag")
    && !ungrounded_stands(stands: as_identity, member: "m.dag")
}

// REGRESSION FOR THE `.dag`-IN-A-MODULE-NAME CASE THE REVIEW FOUND (review 82792, DESIGN §4 "a heuristic is
// never necessary"). Real modules are named `extdeps.languages.dag.emit` and `gunbc.dag_grammar_fork_census`,
// so a legal identity contains the substring `.dag`. An identity-grain cover row over such a claim must be a
// GROUNDED COVER, not an invented `UngroundedDropMember`: the claims it covers would otherwise fall into
// UNCOVERED and the census would exit 1 for a defect that does not exist. The file-grain half of the same
// assertion keeps the refusal honest -- the identical text, declared over a file, grounds in no discovered
// file and IS refused.
test fn an_identity_whose_module_name_contains_dag_is_grounded_not_refused() -> Bool {
  let identity = "extdeps.languages.dag.emit.emit_a_module"
  let rows = [ClaimRow { identity: identity, entry: "dag/extdeps/languages/dag/emit.dag", function: "emit_a_module" }]
  let universe = [identity]
  let grounded = classify_rows(
    universe: universe,
    rows: rows,
    classifier_rows: [cover_identity(carrier: "t.drop", member: identity)]
  )
  let misdeclared = classify_rows(
    universe: universe,
    rows: rows,
    classifier_rows: [cover_file(carrier: "t.drop", member: identity)]
  )
  grounded_cover(stands: grounded, member: identity)
    && (covers_of(stands: grounded, member: identity) == universe)
    && !ungrounded_stands(stands: grounded, member: identity)
    && ungrounded_stands(stands: misdeclared, member: identity)
}

// A DROP POPULATION MEMBER IS JOINED AGAINST BOTH POPULATIONS, NEVER JUDGED BY ITS LOOKS (review 82804).
// A rung_drop population is `List<String>`: the declaration carries a text and no grain, and its members
// are mixed in practice -- some name a discovered file, some name a discovered claim. Each is tried against
// the identities and then the file paths, both by equality; the value is refused only when neither bears it.
// Three members, one carrier: the claim spelling grounds and covers exactly itself, the path grounds and
// covers the file's claims, and the prose names nothing and is the finding.
test fn an_untyped_drop_member_grounds_in_either_population_and_neither_by_spelling() -> Bool {
  let rows = fixture_rows()
  let carrier = "gunbc.rung_drop.t.drop"
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [
      declared_member(carrier: carrier, text: "other.c"),
      declared_member(carrier: carrier, text: "m.dag"),
      declared_member(carrier: carrier, text: "the whole long-lane class is excused")
    ],
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  (covers_of(stands: census.stands, member: "other.c") == ["other.c"])
    && (covers_of(stands: census.stands, member: "m.dag") == ["m.a", "m.b"])
    && ungrounded_stands(stands: census.stands, member: "the whole long-lane class is excused")
    && (count(s1_uncovered(census: census)) == 0)
    && match block.standing { S1DidNotHold { reason: _ } => true, _ => false }
}

// AN EXACT FILE MEMBER SELECTING NO DISCOVERED CLAIM IS REFUSED. A real-looking path whose file discovery
// holds no claims for -- renamed, deleted, or never there -- is an ungroundable refusal naming the drop, not
// a silent "covered nothing". This is the population a prose drop could hide forever.
test fn an_exact_file_member_selecting_no_discovered_claim_is_refused() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [cover_file(carrier: "t.drop", member: "renamed_away.dag")],
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  match block.standing { S1DidNotHold { reason: _ } => true, _ => false }
    && line_names(lines: block.lines, needle: "UNGROUNDED-DROP-MEMBER t.drop renamed_away.dag")
    && ungrounded_stands(stands: census.stands, member: "renamed_away.dag")
}

// THE ONE EXPANSION IS THE FILE'S OWN DISCOVERED CLAIMS -- total over the file, exact across files. A
// whole-file cover grants both of `m.dag`'s identities and does NOT reach into `other.dag`, which is the
// difference between a declared expansion and a prefix match.
test fn a_file_grain_cover_grants_exactly_that_files_discovered_identities() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [cover_file(carrier: "t.drop", member: "m.dag")],
    produced: []
  )
  (covers_of(stands: census.stands, member: "m.dag") == ["m.a", "m.b"])
    && (s1_uncovered(census: census) == ["other.c"])
}

// A FRONTIER PATTERN THAT SELECTS NOTHING IS A FINDING. Substring matching is allowed for that one carrier
// because the frontier declares patterns -- so a pattern grounding in no discovered file is refused exactly
// like a stale member, while a pattern that grounds covers the files it selects.
test fn a_frontier_pattern_grounding_in_no_file_is_refused_and_one_grounding_covers() -> Bool {
  let rows = fixture_rows()
  let dead = classify_rows(
    universe: fixture_universe(),
    rows: rows,
    classifier_rows: [frontier_pattern(pattern: "no_such_lane_directory")]
  )
  let live = classify_rows(
    universe: fixture_universe(),
    rows: rows,
    classifier_rows: [frontier_pattern(pattern: "m.da")]
  )
  ungrounded_stands(stands: dead, member: "no_such_lane_directory")
    && (covers_of(stands: live, member: "m.da") == ["m.a", "m.b"])
}

// EXECUTED-BY IS DERIVED FROM THE PRODUCER'S OWN CLAIM SET AND NOTHING ELSE. An identity the producer names
// is executed only if discovery ALSO enrolled it: a binding cannot manufacture an executed claim for a file
// holding no test, so the ghost identity contributes nothing and the claims remain in the reported
// population. Executed-by is never a list the census authored.
test fn a_producer_naming_an_undiscovered_claim_executes_nothing() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [],
    produced: ["m.a", "ghost.fn_that_discovery_does_not_hold", "m.b"]
  )
  (census.executed == ["m.a", "m.b"])
    && (s1_uncovered(census: census) == ["other.c"])
    && line_names(lines: s1_census_lines(census: census), needle: "UNCOVERED other.c")
    && !line_names(lines: s1_census_lines(census: census), needle: "UNCOVERED m.a")
}

// A PRODUCER THAT EXPOSES NO CLAIM SET LEAVES THE UNIVERSE UNCOVERED, and that IS the finding: nothing is
// excused because a required job "should" run it. The census exits 1 and names every identity.
test fn a_producer_exposing_no_claim_set_leaves_the_universe_uncovered_and_is_a_finding() -> Bool {
  let rows = fixture_rows()
  let census = census_over(rows: rows, universe: fixture_universe(), covers: [], produced: [])
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  match block.standing { S1DidNotHold { reason: _ } => true, _ => false }
    && all(fixture_universe(), id => line_names(lines: block.lines, needle: concat("UNCOVERED ", id)))
}

// EXIT 2 IS THE ONLY ARM FOR AN INPUT THAT COULD NOT BE READ, AND IT DECIDES NOTHING. The channels are
// disjoint by construction: an unread input prints its located causes and prints NO claim population -- no
// UNCOVERED, no STALE-ENROLLED, no UNGROUNDED-DROP-MEMBER -- because a census that could not read is not a
// census whose claims failed. If this ever sees a finding line beside an unread cause, the channels have
// been merged and the exit-2 arm has become a fake green.
test fn an_unread_input_exits_two_and_reports_no_claim_population() -> Bool {
  let block = s1_block(
    s1: S1InputsUnread { causes: ["m.dag: unreadable", "the dag grammar did not prepare: the marker channel cannot answer"] }
  )
  match block.standing { S1Unread { reason: _ } => true, _ => false }
    && line_names(lines: block.lines, needle: "S1-CENSUS INPUT UNREAD m.dag: unreadable")
    && line_names(lines: block.lines, needle: "marker channel cannot answer")
    && !line_names(lines: block.lines, needle: "UNCOVERED ")
    && !line_names(lines: block.lines, needle: "STALE-ENROLLED")
    && !line_names(lines: block.lines, needle: "UNGROUNDED-DROP-MEMBER")
    && match block.standing {
         S1Unread { reason: reason } => string_contains(s: reason, pattern: "could not be read")
         _ => false
       }
}

// AN UNATTRIBUTABLE REQUIRED-JOB LABEL IS A FINDING, NOT A MARGINALIA (parent ruling on review of
// #14469). It used to be a note beside a standing that still read `S1Held`, and `executed_of` still summed
// whatever bindings matched the label -- a label with no single producer behind it both printed a warning
// and reported the census as clean. A label the census cannot resolve is the census failing to establish
// what it was built to establish, so it stands with the other findings: the line prints AND the block
// refuses. Every standing in the census here is clean on purpose -- if a label defect could still hold,
// this is the claim that would see it.
test fn an_unbound_required_job_label_refuses_rather_than_printing_beside_held() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [
      cover_identity(carrier: "t.drop", member: "m.a"),
      cover_identity(carrier: "t.drop", member: "m.b"),
      cover_identity(carrier: "t.drop", member: "other.c")
    ],
    produced: []
  )
  let block = s1_block(
    s1: S1Composed {
      census: census,
      label_defects: [LabelUnbound { label: "//gunbc/instruments:t.thing" }]
    }
  )
  line_names(lines: block.lines, needle: "REQUIRED-JOB LABEL UNBOUND //gunbc/instruments:t.thing")
    && match block.standing {
         S1DidNotHold { reason: reason } =>
           string_contains(s: reason, pattern: "required-job label")
         _ => false
       }
}

// THE DOUBLED LABEL REFUSES TOO, AND SAYS WHICH ONE. Two producers binding one label is the case that
// silently reported their UNION as executed, so it is refused and located by label rather than summarised.
test fn an_ambiguous_required_job_label_refuses_and_names_the_label() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [
      cover_identity(carrier: "t.drop", member: "m.a"),
      cover_identity(carrier: "t.drop", member: "m.b"),
      cover_identity(carrier: "t.drop", member: "other.c")
    ],
    produced: []
  )
  let block = s1_block(
    s1: S1Composed {
      census: census,
      label_defects: [LabelAmbiguous { label: "//gunbc/instruments:t.doubled" }]
    }
  )
  line_names(lines: block.lines, needle: "REQUIRED-JOB LABEL AMBIGUOUS //gunbc/instruments:t.doubled")
    && match block.standing { S1DidNotHold { reason: _ } => true, _ => false }
}

// A CLEAN LABEL SET STILL HOLDS, OR THE TWO REFUSALS ABOVE PROVE NOTHING. They assert a refusal; a policy
// that refused everything would satisfy them. The same census with an empty defect list must read S1Held,
// so the refusal is shown to be caused by the defect and not by the shape of the claim.
test fn the_same_census_holds_when_no_required_job_label_is_defective() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [
      cover_identity(carrier: "t.drop", member: "m.a"),
      cover_identity(carrier: "t.drop", member: "m.b"),
      cover_identity(carrier: "t.drop", member: "other.c")
    ],
    produced: []
  )
  let block = s1_block(s1: S1Composed { census: census, label_defects: [] })
  match block.standing { S1Held => true, _ => false }
}

// ---------------------------------------------------------------------------
// THE WITNESS ENTRY'S GRAIN (the parent's REQUEST_CHANGES at 69453470805, finding (a)).
// `bin_wet_classifier_rows` and `explicit_admission_classifier_rows` passed the entry's file alone into
// `cover_file_row` and dropped `ScheduleWitnessEntry.function`, so a lane admitted for ONE test of a file
// was credited with EVERY claim in it -- 2 admitted tests of 13 in `map_literal.dag` read as 13 covered.
// The fix is `cover_witness_entry_row` in the carriers module: the entry's own function text decides the
// grain, and the file row is reached only when that text is empty. These claims run the REAL adapter over
// the fixture corpus, so the finding is not asserted by prose: an admission naming `a` must ground to
// exactly `m.a` and leave its SIBLING `m.b` in the census's uncovered report.
// ---------------------------------------------------------------------------

// The two witnesses the fixtures use: same carrier, same entry file, one named function each. A witness
// entry whose function text is EMPTY declares only the file -- that is the grain the carrier declares,
// asserted by the third claim.
data grain_witness_named_a: ScheduleWitnessEntry = ScheduleWitnessEntry {
  entry: "m.dag", function: "a", kind: CorpusWitnessKind
}
data grain_witness_empty_function: ScheduleWitnessEntry = ScheduleWitnessEntry {
  entry: "m.dag", function: "", kind: CorpusWitnessKind
}

// THE ADAPTER ITSELF, AT IDENTITY GRAIN. A named function must become a file+function member -- not the
// file member the widened fold used to build. This is the RED: revert `cover_witness_entry_row` to
// `cover_file_row(carrier:, path: witness.entry)` and BOTH members below collapse to the file text.
test fn a_witness_entry_naming_one_function_becomes_a_file_and_function_member() -> Bool {
  let row = cover_witness_entry_row(carrier: "t.lane", witness: grain_witness_named_a)
  classifier_member_text(row: row) == "m.dag#a"
    && match row.role { CoverRole => true, EnrollmentRole => false }
}

// A WITNESS THAT DECLARES NO FUNCTION DECLARES THE FILE, and the member says so with no `#` at all. The
// empty text is a declaration made by the carrier, not a value this census invented, and the widening is
// only legitimate where the carrier made it.
test fn a_witness_entry_with_no_function_declares_the_whole_file_and_nothing_more() -> Bool {
  let row = cover_witness_entry_row(carrier: "t.lane", witness: grain_witness_empty_function)
  classifier_member_text(row: row) == "m.dag"
}

// THE SIBLING IS STILL UNCOVERED -- the finding, run through the census rather than through the row.
// One admission for `m.a`, over the fixture universe of `m.a` AND `m.b`: exactly `m.b` (and the other
// module's `other.c`) may be in the uncovered report, and `m.a` may never be. Under the dropped-field
// fold the cover expanded to the whole file and `m.b` was grounded by a lane that names one test:
// this claim is where that widening goes red.
test fn admitting_one_function_grounds_that_claim_and_leaves_its_sibling_uncovered() -> Bool {
  let rows = fixture_rows()
  let census = census_over(
    rows: rows,
    universe: fixture_universe(),
    covers: [cover_witness_entry_row(carrier: "t.lane", witness: grain_witness_named_a)],
    produced: []
  )
  let uncovered = s1_uncovered(census: census)
  any(uncovered, id => id == "m.b")
    && any(uncovered, id => id == "other.c")
    && !any(uncovered, id => id == "m.a")
}

// ---------------------------------------------------------------------------
// THE UNIQUE BINDING (the parent's REQUEST_CHANGES at 69453470805, finding (b), second half). A required
// job's label can reach the fold with no binding, or with two. A single list fold returned the UNION of
// everything any matching binding credits, so a label with two producers executed the sum of both, and the
// UNBOUND arm's findings went to notes the block did not read -- a census reporting S1Held beside an
// unbound label. `executed_of` now adds `credited_producer_names`, which credits through exactly one
// binding and nothing for every other shape. The unbound/ambiguous refusal itself is claimed in the
// s1_block claims above; this is the credit rule, asserted at the one site that decides who executed.
// ---------------------------------------------------------------------------

// The fixtures' label: one package path, named targets, the same shape `gunbc.target_bindings` carries.
fn grain_label(target: String) -> Label {
  Label {
    package: PackagePath { segments: ["gunbc"] },
    target: TargetName { name: target }
  }
}

fn binding_for(target: String, entry: String, function: String) -> TargetBinding {
  TargetBinding {
    target: grain_label(target: target),
    producer: CliWireProgramProducer { entry: entry, function: function }
  }
}

fn grain_index() -> Map<String, String> {
  let labeled: Map<String, String> = empty_map()
  map_insert(m: labeled, key: "m.dag", value: "m")
}

// ONE BINDING CREDITS THE IDENTITY IT NAMES -- the arm that must stay alive while the two below refuse.
test fn a_unique_binding_credits_the_identity_its_producer_names() -> Bool {
  credited_producer_names(bindings: [binding_for(target: "t", entry: "m.dag", function: "a")], index: grain_index())
    == ["m.a"]
}

// TWO BINDINGS CREDIT NOTHING. This is `executed_of`'s own fold step: what a doubled label contributes to
// the executed set. The union it used to contribute is exactly the fabrication the parent refused -- an
// identity executed by nobody in particular. The sibling arms make the refusal mean "not unique" and not
// "empty list", so all three cases are pinned together.
test fn a_label_with_two_bindings_credits_nothing_but_a_unique_one_does() -> Bool {
  credited_producer_names(
    bindings: [
      binding_for(target: "t", entry: "m.dag", function: "a"),
      binding_for(target: "t", entry: "m.dag", function: "b")
    ],
    index: grain_index()
  ) |> is_empty()
    && credited_producer_names(bindings: [], index: grain_index()) |> is_empty()
}

// A PRODUCER NAMES NOTHING UNBOUND -- the unspellable pair: an entry the index does not hold, or a producer
// variant that carries no entry at all. Contributes nothing to the executed set in both cases (the rule
// `a_live_function_resolves_and_names_nothing_for_a_producer_that_names_nothing` states for one variant,
// asserted here across the list shape as well).
test fn a_binding_whose_entry_the_index_does_not_hold_credits_nothing() -> Bool {
  credited_producer_names(bindings: [binding_for(target: "t", entry: "gone.dag", function: "a")], index: grain_index())
    |> is_empty()
    && credited_producer_names(bindings: [TargetBinding {
        target: grain_label(target: "t"),
        producer: RequiredFloorProducer
      }], index: grain_index()) |> is_empty()
}

// THE PAIRING OBLIGATION ON THE REAL PRODUCER (DESIGN 3, required by nimble-badger-800's verification
// and warm-wolf-570). EVERY claim above injects its own fixtures, which is what lets them assert the three
// exits over a population a test controls -- and it is also why none of them can discharge the corpus-level
// control: deleting an ActiveFillDebt member from `v2.workflow.floor_pure_producer_share` left all of them
// passing, because the real list reaches the census only through `s1_all_classifier_rows()`. A fixture that
// never touches the thing it claims to classify proves only that the fixture is self-consistent. So exactly
// one claim here reads the REAL carriers and asserts, by identity, that a named active member of the real
// fill-debt list arrives as an identity-grain cover row of the fill-debt carrier. Delete that member from
// src/v2/workflow/floor_pure_producer_share.dag and this claim fails -- the corpus-level RED, in the witness
// rather than only in the live instrument.
//
// THE MEMBER IS NAMED, NOT COUNTED (DESIGN 5): no cardinality of the real list is asserted, so the carriers
// may grow or shrink without this claim going stale for the wrong reason. The member is one whose module and
// claim are both declared at this head, so the claim tests the carrier and not a stale row; the stale rows
// have their own pair of claims above, and the same join decides both.
test fn the_real_fill_debt_carrier_yields_its_named_active_member_as_an_identity_cover_row() -> Bool {
  let named = "v2.test.claim.compiler.literal_elaboration.lel_route_runs_on_the_real_path"
  let rows = s1_all_classifier_rows()
  any(rows, row => row.carrier == fill_debt_carrier && classifier_member_text(row: row) == named)
    && any(rows, row => match row.member {
         IdentityMember { identity: identity } =>
           identity == named && match row.role { CoverRole => true, EnrollmentRole => false }
         _ => false
       })
}

// THE SAME OBLIGATION FOR A DROP, WHICH IS THE POPULATION WITH NO GRAIN AT ALL. A rung_drop population is
// `List<String>`, so this asserts on the real roster that a member the drops actually declare reaches the
// census as a member row of ITS OWN drop's carrier -- located, not paraphrased. The drop is untouched by
// this PR (no amendment to reach exit 0); this claim only makes the census owe the roster something, so a
// drop that stopped contributing rows at all is a witness failure and not a silent shrink.
test fn a_real_rung_drop_member_arrives_under_its_own_drop_carrier() -> Bool {
  let rows = s1_all_classifier_rows()
  any(rows, row =>
    string_contains(s: row.carrier, pattern: "gunbc.rung_drop.")
      && match row.role { CoverRole => true, EnrollmentRole => false })
    && any(rows, row => match row.member {
         DeclaredMember { text: text } => text != "" && string_contains(s: row.carrier, pattern: "gunbc.rung_drop.")
         _ => false
       })
}

// THE LIVE MODULE MUST RESOLVE INSIDE THE WITNESS CORPUS, OR IT IS NOT EVIDENCED AT ALL
// (blocker from bold-badger-676, warm-wolf-570's dispatch). Every claim above injects its own fixture
// universe, so none of them ever imported `v2.workflow.claim_coverage_census_s1_live` — and a per-file
// `v1_src_dag_parse` sweep resolves imports, not bodies, so the module's `if` arms returning a `List` on
// one branch and a `Cons` (FreeMonoid) on the others were invisible until a real consumer tried to
// resolve it on BuildBuddy. This claim's ASSERTION is trivial by design; its VALUE is that resolving this
// entry drags the live module's every body through the resolver, which is the only way a type error in
// that module can reach a witness instead of a fleet run. It performs no effect: `producer_named_identities`
// is a pure match over the producer variants, and a producer that names no claim must contribute none.
test fn a_live_function_resolves_and_names_nothing_for_a_producer_that_names_nothing() -> Bool {
  producer_named_identities(producer: RequiredFloorProducer, index: empty_map()) |> is_empty()
}

// ---------------------------------------------------------------------------
// THE COMPOSED EXIT. Every case is asserted over fixtures, because the live entry's own exit depends on
// whatever the checkout happens to look like and cannot be driven to a chosen state from a claim. The case
// that was WRONG is claimed first: a definite finding beside an unread input exits 1, not 2. The parent's
// ruling (2026-10-20) is the Kleene reading -- a finding is `false`, and `false AND unknown = false`, so an
// unread input elsewhere cannot downgrade a definite failure to "no observation". Exit 2 survives only where
// nothing was found and something could not be read.
// ---------------------------------------------------------------------------

// One real finding, from the wet census's own sum: an enrolled identity no required job executes, with the
// drop that accounts for it named. Not a stand-in string -- the arm carries a population, and the receipt is
// built from it, so the reason text this claim asserts over is the census's own wording.
data finding_wet_standing: ClaimCoverageStanding = ClaimCoverageDidNotHold {
  uncovered: [UncoveredClaim {
    source_id: "claim-set-fixture",
    identity: "gunbc.fixture_claim_does_not_hold",
    declaring_drop: Absent
  }]
}

// THE RED (parent ruling, 2026-10-20): finding + unread input => 1. This fails at the previous head, where
// the unread arm was matched first and returned 2 -- the answer was "we could not tell" for a census that
// had in fact found an uncovered claim, which a reader would have read as a broken fixture rather than a
// real failure.
test fn a_definite_finding_beside_an_unread_input_exits_one_not_two() -> Bool {
  // The DECISION, before the number: the composition over these two standings is a finding, not an unread.
  // Asserted at this grain as well because the exit code is derived from it -- if a mutation made the number
  // right for the wrong reason, this arm is where it shows.
  (match claim_coverage_composed_standing(
    wet: finding_wet_standing,
    s1: S1Unread { reason: "the acquisition index could not be read" }
  ) {
    ComposedFinding { reasons: reasons } => !is_empty(reasons)
    ComposedUnread { cause: _ } => false
    ComposedHeld => false
  })
  && match claim_coverage_composed_exit(
    bytes: "receipt",
    wet: finding_wet_standing,
    s1: S1Unread { reason: "the acquisition index could not be read" }
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 1)
        && string_contains(s: reason, pattern: "claim-coverage-census: did not hold")
        && string_contains(s: reason, pattern: "gunbc.fixture_claim_does_not_hold")
        // The unread cause still travels: it does not decide the exit, but the reader has to fix it.
        && string_contains(s: reason, pattern: "could not be read")
    _ => false
  }
}

// THE OTHER HALF OF THE SAME BOUNDARY: unread with NOTHING found stays exit 2. Both claims together are what
// make the precedence claim mean "1 beats 2", rather than "always 1" -- a mutation that returned 1 for every
// input would pass the claim above and fail this one.
test fn an_unread_input_with_no_finding_exits_two_and_names_the_cause() -> Bool {
  match claim_coverage_composed_exit(
    bytes: "receipt",
    wet: ClaimCoverageHeld,
    s1: S1Unread { reason: "the acquisition index could not be read" }
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 2)
        && string_contains(s: reason, pattern: "the acquisition index could not be read")
        // The exit-2 arm prints the bare cause, not the finding-and-unread note.
        && !(string_contains(s: reason, pattern: "does not change the exit"))
    _ => false
  }
}

// A finding on the S1 side alone, with the wet census holding, is still exit 1.
test fn an_s1_finding_alone_exits_one() -> Bool {
  match claim_coverage_composed_exit(
    bytes: "receipt",
    wet: ClaimCoverageHeld,
    s1: S1DidNotHold { reason: "a discovered claim is executed by no required job" }
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 1) && string_contains(s: reason, pattern: "executed by no required job")
    _ => false
  }
}

// BOTH censuses finding something keeps BOTH reasons, so neither reader is sent to the wrong file -- and the
// exit stays 1.
test fn two_findings_keep_both_reasons_and_stay_at_one() -> Bool {
  match claim_coverage_composed_exit(
    bytes: "receipt",
    wet: finding_wet_standing,
    s1: S1DidNotHold { reason: "the discovered universe did not hold" }
  ) {
    CliWirePrintable { bytes: _, exit: ExitFailure { code: code, reason: reason } } =>
      (code == 1)
        && string_contains(s: reason, pattern: "gunbc.fixture_claim_does_not_hold")
        && string_contains(s: reason, pattern: "the discovered universe did not hold")
    _ => false
  }
}

// THE CLEAN CASE: both standings hold, exit 0, and nothing is reported as a failure.
test fn two_held_standings_exit_zero() -> Bool {
  match claim_coverage_composed_exit(bytes: "receipt", wet: ClaimCoverageHeld, s1: S1Held) {
    CliWirePrintable { bytes: bytes, exit: ExitSuccess } => bytes == "receipt"
    _ => false
  }
}

// THE EXIT NUMBER CANNOT DISAGREE WITH THE DECISION: the code is derived from the composed standing by the
// one function that turns a standing into a protocol number, and it reuses the instrument's constants rather
// than restating them. This is what a mutation that hardcoded an integer would break.
test fn the_exit_code_is_derived_from_the_composed_standing() -> Bool {
  (claim_coverage_composed_exit_code(standing: ComposedHeld) == 0)
    && (claim_coverage_composed_exit_code(standing: ComposedFinding { reasons: ["a"] }) == s1_exit_code_did_not_hold)
    && (claim_coverage_composed_exit_code(standing: ComposedUnread { cause: "b" }) == s1_exit_code_unread)
    && (s1_exit_code_did_not_hold == 1)
    && (s1_exit_code_unread == 2)
}
