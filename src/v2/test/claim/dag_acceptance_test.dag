  InferReceiptRow,
  passed_row,
  TargetCompileClaim,
  TargetCompileStage,
  TranslateStage,
  TranslationClaim,
  obligation_eq,
  target_compile_row,
  AcceptanceContractIncomplete,
  AcceptanceContractRejected,
  AcceptanceContractSatisfied,
  AcceptanceEnvironment,
  AcceptanceRunState,
  BlockedByPrerequisite,
  DagAcceptanceContract,
  DagAcceptanceReceipt,
  DagCandidate,
  DagStageObligation,
  ExecutorUnavailable,
  FullLedger,
  InferStage,
  InteractiveFailFast,
  NonEmptyObligations,
  NormalizeStage,
  NotRequiredByContract,
  ParseStage,
  ResolveStage,
  SkippedAfterDecisiveRejection,
  StageCostRow,
  StageExecution,
  StageNotRun,
  StagePassed,
  StagePassedWithFrontier,
  StageRejected,
  StageUndecided,
  TargetCompileDecided,
  TargetCompileExecutor,
  TargetCompileFailedUnparsed,
  TargetCompileObservation,
  TargetCompilerUnavailable,
  TokenizeStage,
  VerifierBudgetRemainingMs,
  VerifierBudgetUnavailable,
  VerifierBudgetUnbounded,
