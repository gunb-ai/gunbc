module v2.test.claim.lens_suite_modeling_witness

import v2.lens.suite.census { lens_suite_registry_census, lens_suite_registry_census_holds }
import v2.lens.suite.checkpoint_a_harness {
  lens_suite_checkpoint_a_execution_gated,
  lens_suite_checkpoint_a_harness_holds,
}
import v2.lens.suite.fact_pack {
  lens_corpus_fact_pack_fixture,
  lens_corpus_fact_pack_second_query_constructs_zero,
}
import v2.lens.suite.receipt {
  LensSuiteReceipt,
  lens_suite_zero_execution_never_succeeds,
}
import v2.lens.suite.roster {
  lens_suite_planned_count,
  lens_suite_registered_count,
  lens_suite_registry_join_complete,
}
import v2.lens.suite.selection {
  lens_suite_boring_checkpoint_is_determinism,
  lens_suite_boring_lens_mechanically_selected,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import std.verification { NanosecondDuration, nanosecond_duration }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data lens_suite_modeling_witness_note: String = "V2-LENS-0 modeling slice (operator ruling 2026-08-09): witnesses the LensSuiteReceipt laws, registry-derived roster, mechanical boring-lens selection, fact-pack identity/construction-count laws, registry census, and Checkpoint A harness gate — NO lens-body execution on the interpreter path. Permanence RED: zero executed lenses cannot verdict success."

test fn witness_lens_suite_registry_join_complete() -> Bool {
  lens_suite_registry_join_complete()
}

test fn witness_lens_suite_boring_lens_mechanically_selected() -> Bool {
  lens_suite_boring_lens_mechanically_selected()
}

test fn witness_lens_suite_registry_census_holds() -> Bool {
  lens_suite_registry_census_holds()
}

test fn witness_lens_suite_checkpoint_a_harness_gated() -> Bool {
  lens_suite_checkpoint_a_harness_holds() && lens_suite_checkpoint_a_execution_gated()
}

test fn witness_lens_suite_zero_execution_never_succeeds_red() -> Bool {
  let planned = lens_suite_planned_count()
  let registered = lens_suite_registered_count()
  let fact_pack = lens_corpus_fact_pack_fixture(construction_count: 1)
  let zero_executed = LensSuiteReceipt {
    subject_digest: fact_pack.identity,
    registered_count: registered,
    planned_count: planned,
    executed_count: 0,
    accepted_readings: 0,
    expected_refusals: 0,
    unexpected_refusals: 0,
    unavailable_count: 0,
    unaccounted_count: 0,
    fact_pack_identity: fact_pack.identity,
    fact_pack_construction_count: fact_pack.construction_count,
    v1_lens_body_executions: 0,
    fallback_count: 0,
    preparation_wall: nanosecond_duration(count: 0),
    execution_wall: nanosecond_duration(count: 0),
    members: []
  }
  lens_suite_zero_execution_never_succeeds(receipt: zero_executed)
}

test fn witness_lens_suite_fact_pack_second_query_constructs_zero() -> Bool {
  let first = lens_corpus_fact_pack_fixture(construction_count: 1)
  let second = lens_corpus_fact_pack_fixture(construction_count: 0)
  lens_corpus_fact_pack_second_query_constructs_zero(first: first, second: second)
}

test fn witness_lens_suite_census_registered_matches_registry() -> Bool {
  let census = lens_suite_registry_census()
  census.registered_identity_count == lens_suite_registered_count()
}

test fn witness_lens_suite_boring_selection_is_determinism() -> Bool {
  lens_suite_boring_checkpoint_is_determinism()
}
