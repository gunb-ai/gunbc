module v2.test.claim.match_arm_binder_frame

import v2.compiler.normalized_tree { normalized_tree_record_declarations }
import v2.compiler.resolve { ResolvedTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { assemble_program_from_ingest, dag_prepared_grammar, dag_prepared_lex }
import v2.compiler.tokenize { tokenize_prepared }
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRootIngest
}
import v2.extdeps.languages.dag { dag_language_model }
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Atom, Node, TypeNode, node_subtree_nodes }
import v2.std.text { String }
import v2.std.qualified_name { declaration_reference_path_optional, qualified_name_last_segment }
import std.optional { Absent, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: the match-arm scope frame of v2.compiler.resolve (resolve_match_node_walk): the binders a
// lowered pattern carries (v2.test.claim.parse.variant_field_lowering asserts the shape) are a lexical
// frame for the arm's body, and nothing else. BOUNDARY: source text in, assembled (normalized +
// resolved) program out through assemble_program_from_ingest, the same real path the
// declaration_graft_assemble rows run; the outcome and its typed reason are the observation.
//
// WHY THE SHADOWING CONTROL IS SHAPED THE WAY IT IS. A binder's canonical atom is its own symbol,
// exactly as a parameter's is, so a resolved tree cannot show WHICH frame answered `x`. What can:
// a frame local is answered BoundInFrame before the root is reached, and the root's test-code
// wall (resolve_atom_bound) is never consulted for it. So the outer `x` here is a TEST-MARKED
// declaration: with the frame, the arm's `x` binds to the arm and the module assembles; without
// it, `x` reaches the root, names test code, and refuses resolve_reason_test_code_referenced --
// the red that makes the green mean the arm bound it. The mutation receipt (frame deleted) is on
// the PR.

data mab_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^match_arm_binder_frame_artifact,
  file_path: "src/v2/pilot/match_arm_binder_frame_pilot.dag"
}

fn mab_ingest_for(src: String) -> SourceRootIngest {
  Cons {
    head: DagSourceReadWitness {
      source: Medium { carried: src, fidelity: Lossless },
      artifact: mab_artifact,
      compilation_unit: ^match_arm_binder_frame_cu,
      source_root: V2Tree
    },
    tail: Empty
  }
}

fn mab_admission() -> Admission {
  Admission {
    subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } },
    imports: Empty
  }
}

fn mab_assemble(src: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(ingest: mab_ingest_for(src: src), admission: mab_admission(), lm: dag_language_model())
}

// THE RESOLVED OUTCOME IS THE SHARE POINT, NOT THE LANGUAGE MODEL. Each claim here reaches its
// verdict through assemble_program_from_ingest, whose cost is dominated by dag_language_model()
// -- measured at 90028 eval steps ALONE against the floor's 72300 per-claim ceiling, so a claim
// that only calls it is already over. The model itself cannot be shared: gunbc run 35327371663
// refused exactly that as ServeCacheValueNotPortable at .value.lm.canonical_symbols.member
// kind=Closure, because a LanguageModel carries a function and the store serves values. So these
// rows take the seam v2.workflow.floor_pure_producer_share already uses for resolve subjects --
// the RESOLVED Outcome<ResolvedTree> per subject, nullary, pure, over an inline source, Nodes and located
// diagnostics with no closure at any depth.
//
// THE REAL PATH STILL EXECUTES. Preparation runs each producer once, for real, and is REFUSED
// there if it cannot run; the rows then read it. That is the DESIGN section 3 pairing obligation
// discharged by the mechanism rather than by an extra claim -- delete the integration and
// preparation breaks, not just an assertion.
fn mab_outcome_accepts(o: Outcome<ResolvedTree>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn mab_outcome_refuses_with(o: Outcome<ResolvedTree>, reason: Symbol) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == reason
  }
}

fn mab_resolved_0() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\ntest fn x() -> Int { 1 }\n\nfn pick(c: C) -> Int {\n  match c {\n    A(x) => x\n    B => 0\n  }\n}\n")
}

fn mab_resolved_1() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\ntest fn x() -> Int { 1 }\n\nfn pick(c: C) -> Int {\n  match c {\n    A(_) => x\n    B => 0\n  }\n}\n")
}

fn mab_resolved_2() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(y) => y\n    B => 0\n  }\n}\n")
}

fn mab_resolved_3() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(y) => z\n    B => 0\n  }\n}\n")
}

fn mab_resolved_4() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    Aa(y) => y\n    B => 0\n  }\n}\n")
}

fn mab_resolved_5() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(y) => y\n    B => y\n  }\n}\n")
}

fn mab_resolved_6() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype Opt = Present { value: Int } | Absent\ntype C = A(Opt) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(Present { value: y }) => y\n    A(Absent) => 0\n    B => 1\n  }\n}\n")
}

fn mab_resolved_7() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype Opt = Present { value: Int } | Absent\n\nfn get(o: Opt) -> Int {\n  match o {\n    Present { value: v } => v\n    Absent => 0\n  }\n}\n")
}

fn mab_resolved_8() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype Opt = Present { value: Int } | Absent\n\nfn get(o: Opt) -> Int {\n  match o {\n    Present { value } => value\n    Absent => 0\n  }\n}\n")
}

fn mab_resolved_9() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn tag(c: C) -> Int {\n  match c {\n    A(_) => 1\n    B => 0\n  }\n}\n")
}

// (1) A binder shadowing an outer name binds the ARM's binding: the outer `x` is test code, and
// the arm's `x` never reaches it.
test fn mab_shadowing_binder_binds_the_arm() -> Bool {
  mab_outcome_accepts(o: mab_resolved_0())
}

// The wall the frame bypasses is real: the same outer test-code name, referenced from an arm that
// binds no `x`, refuses through the root exactly as the frame-less reading of (1) would.
test fn mab_outer_test_code_name_still_refuses_without_a_binder() -> Bool {
  mab_outcome_refuses_with(
    o: mab_resolved_1(),
    reason: ^resolve_reason_test_code_referenced
  )
}

// A binder with no outer name at all binds through the frame (green) -- and the body naming a
// different, unbound name refuses (red): the frame binds exactly the binder.
test fn mab_fresh_binder_binds() -> Bool {
  mab_outcome_accepts(o: mab_resolved_2())
}

test fn mab_unbound_name_in_arm_body_refuses() -> Bool {
  mab_outcome_refuses_with(
    o: mab_resolved_3(),
    reason: ^resolve_reason_unbound_symbol
  )
}

// (3) The constructor tag is not a binder: a misspelled variant refuses as an unbound reference
// instead of becoming a fresh binder that matches everything.
test fn mab_misspelled_tag_refuses() -> Bool {
  mab_outcome_refuses_with(
    o: mab_resolved_4(),
    reason: ^resolve_reason_unbound_symbol
  )
}

// (4) The binder does not leak: a sibling arm naming it is unbound.
test fn mab_binder_does_not_leak_to_a_sibling_arm() -> Bool {
  mab_outcome_refuses_with(
    o: mab_resolved_5(),
    reason: ^resolve_reason_unbound_symbol
  )
}

// Nested constructs bind at depth, braced and shorthand spellings bind their field's binder, and
// a wildcard binds nothing.
test fn mab_nested_braced_and_shorthand_binders_bind() -> Bool {
  mab_outcome_accepts(o: mab_resolved_6())
    && mab_outcome_accepts(o: mab_resolved_7())
    && mab_outcome_accepts(o: mab_resolved_8())
    && mab_outcome_accepts(o: mab_resolved_9())
}


// PKG16: WHAT A BINDER SPELLING AN OUTER NAME BINDS, ASKED OF THE INDEX. The classifier
// (v2.compiler.resolve resolve_pattern_atom_names_constructor) now reads the declared-payload fact
// the symbol index holds instead of the node's shape. These rows are the census that repair was
// measured against, kept enrolled as regression controls. Both readings of `A(W) => W` ACCEPT, so
// acceptance cannot discriminate; what does is the resolved tree: a frame binder stays the Atom it
// was spelled as, while a declaration reference resolves to its qualified spine
// (resolved_reference_node). An Atom surviving is the arm having bound it.
//
// WHAT THIS CENSUS FOUND, stated because a reader will otherwise assume these rows are the red for
// the repair: THEY ARE NOT. On #12033's head, with the old shape predicate, every row below already
// holds -- a where-alias, a record-literal data row and the fresh control all bind, and the
// ambiguous route refuses. A module container is never an index entry (the fill descends module
// spine segments without inserting a path), so the module-name specimen this package was filed on
// does not reach the classifier by lexical ascent. No shape was found that the old predicate admits
// and the index rejects, so the repair is construction with no behavioural delta on this corpus.
fn mab_has_atom(o: Outcome<ResolvedTree>, id: Symbol) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: n, diagnostics: _ } =>
      fold(node_subtree_nodes(root: n.root), init: false, f: fn(found, m) {
        found || (match m.kind {
          TypeNode { connective: Atom { identity: i } } => i == id
          _ => false
        })
      })
  }
}

fn mab_resolved_where_alias_binder() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\nfn lower_hex_64(v: Int) -> Bool { true }\n\ntype W = Int where lower_hex_64\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(W) => W\n    B => 0\n  }\n}\n")
}

fn mab_resolved_unshadowed_binder() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\nfn lower_hex_64(v: Int) -> Bool { true }\n\ntype V = Int where lower_hex_64\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(W) => W\n    B => 0\n  }\n}\n")
}

fn mab_resolved_record_data_binder() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype Rec { f: Int }\ndata d: Rec = Rec { f: 1 }\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(d) => 0\n    B => 0\n  }\n}\n")
}

// The instrument is live: with no outer W, the binder's Atom survives.
test fn mab_unshadowed_binder_atom_survives() -> Bool {
  mab_has_atom(o: mab_resolved_unshadowed_binder(), id: ^W)
}

test fn mab_binder_spelling_a_where_alias_binds() -> Bool {
  mab_outcome_accepts(o: mab_resolved_where_alias_binder())
    && mab_has_atom(o: mab_resolved_where_alias_binder(), id: ^W)
}

// REVERSED BY THE DECLARATION-SHAPE SPLIT (queued item of tidy-ant-251, 2026-10-25, decided there with
// its reason). This row asserted that a field binder spelled like a module `data` row binds. Once the
// index tells a `data` row (an Arrow marked ConstantMemberEdge) from a function (v2.std.symbol_index
// type_decl_member_shape), a pattern atom naming a visible module-level value is the same situation at
// either pattern position as one naming a frame value: the author meant to compare or to shadow, and
// the compiler cannot tell which, so it refuses resolve_reason_pattern_atom_names_visible_value
// (rename to bind, or use an equality guard to compare). Binding it is the silent wrong answer when
// the arm reads the atom (`A(d) => d` would return the scrutinee's payload, not the constant). Kept,
// reversed, as the regression control (DESIGN section 4b(4)); a binder spelled like a module FUNCTION
// still binds (mab_a_binder_spelled_like_a_module_function_still_binds).
test fn mab_binder_spelling_a_record_data_row_refuses() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_record_data_binder(), reason: ^resolve_reason_pattern_atom_names_visible_value)
}

// A BINDER SPELLED LIKE A NON-PAYLOAD DECLARED IN TWO MODULES BINDS. `n` is off the arm's lexical
// chain and two fns spell it corpus-wide, so the global-bare lookup is Ambiguous. That arm used to
// answer constructor for ANY ambiguity, so `A(n) => n` refused resolve_reason_unbound_symbol -- the
// over-prohibition behind the operator's seven expression_bodied_fn_decl_parse refusals at the
// binder `d` of `Rejected { diagnostics: d }` on main 4446f2e990f. The arm now asks each claimant
// whether it is a declared payload, and neither fn is. Red on that main (it refused); green here.
// Its partner below keeps the fail-closed half: the same shape over two VARIANTS still refuses.
fn mab_file(src: String, id: Symbol) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: src, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: "src/v2/pilot/match_arm_binder_frame_pilot.dag" },
    compilation_unit: id,
    source_root: V2Tree
  }
}

fn mab_resolved_ambiguous_binder() -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: mab_file(src: "module p.a\n\nfn n() -> Int { 1 }\n", id: ^match_arm_binder_ambiguous_a_cu),
      tail: Cons {
        head: mab_file(src: "module r.b\n\nfn n() -> Int { 2 }\n", id: ^match_arm_binder_ambiguous_b_cu),
        tail: Cons {
          head: mab_file(src: "module p.q\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(n) => n\n    B => 0\n  }\n}\n", id: ^match_arm_binder_ambiguous_q_cu),
          tail: Empty
        }
      }
    },
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^p, tail: Cons { head: ^q, tail: Empty } } },
      imports: Empty
    },
    lm: dag_language_model()
  )
}

test fn mab_binder_spelling_a_non_payload_declared_in_two_modules_binds() -> Bool {
  mab_outcome_accepts(o: mab_resolved_ambiguous_binder())
    && mab_has_atom(o: mab_resolved_ambiguous_binder(), id: ^n)
}

// THE FAIL-CLOSED PARTNER: a pattern atom spelled like a VARIANT declared in two modules, imported
// into neither, is still a constructor. `N` is a declared payload at both claimants, so the
// ambiguous arm answers constructor, the atom resolves as a reference and refuses unbound, rather
// than becoming a catch-all binder. It discriminates the per-candidate question from "ambiguity is
// a binder": with the arm answering binder unconditionally this row reds.
fn mab_resolved_two_module_variant() -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: mab_file(src: "module p.a\n\ntype K = M | N\n", id: ^match_arm_binder_variant_a_cu),
      tail: Cons {
        head: mab_file(src: "module r.b\n\ntype L = N | O\n", id: ^match_arm_binder_variant_b_cu),
        tail: Cons {
          head: mab_file(src: "module p.q\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(N) => 1\n    B => 0\n  }\n}\n", id: ^match_arm_binder_variant_q_cu),
          tail: Empty
        }
      }
    },
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^p, tail: Cons { head: ^q, tail: Empty } } },
      imports: Empty
    },
    lm: dag_language_model()
  )
}

test fn mab_binder_spelling_a_variant_declared_in_two_modules_refuses() -> Bool {
  mab_outcome_refuses_with(
    o: mab_resolved_two_module_variant(),
    reason: ^resolve_reason_unbound_symbol
  )
}

// WHICH TYPES THE CARRIER CALLS RECORDS, AND WHICH IT MUST NOT (the record-versus-where-alias
// control). The record half of the declared-payload fact is read before the record rehome by
// v2.compiler.body_lowering_fold body_lower_type_decl_record_name_optional and carried on
// NormalizedTree record_declarations. After the rehome a record and a where-alias are the same
// Conj { N: .. } shape, so nothing downstream could catch this predicate answering Present for a
// where-alias, or for a coproduct whose variant carries a field block on the parse tree. So the
// capture itself is asserted, over all four spellings: a record, a nullary record, a where-alias,
// and a coproduct with a fielded variant -- exactly the two records, in declaration order.
fn mab_record_declarations(src: String) -> Outcome<FreeMonoid<Symbol>> {
  match tokenize_prepared(text: src, file: ^match_arm_binder_record_probe, prepared: dag_prepared_lex()) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: tokens, diagnostics: _ } =>
      match dag_prepared_grammar() {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: prepared, diagnostics: _ } =>
          match parse_module_prepared(tokens: tokens, prepared: prepared) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: artifact, diagnostics: _ } =>
              match normalize(parse_tree: artifact.tree) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: tree, diagnostics: d } =>
                  Accepted { value: normalized_tree_record_declarations(t: tree), diagnostics: d }
              }
          }
      }
  }
}

// NULLARY AND PURE so the floor prepares it once (v2.workflow.floor_pure_producer_share), for the
// same reason the mab_resolved_* specimens are.
fn mab_record_declarations_specimen() -> Outcome<FreeMonoid<Symbol>> {
  mab_record_declarations(src: "module p\n\ntype R { f: Int }\ntype W = Int where string_non_empty\ntype C = A { v: Int } | B\ntype U {}\n")
}

test fn mab_where_alias_is_not_a_record() -> Bool {
  match mab_record_declarations_specimen() {
    Rejected { diagnostics: _ } => false
    Accepted { value: names, diagnostics: _ } =>
      names == Cons { head: ^R, tail: Cons { head: ^U, tail: Empty } }
  }
}

// THE FILED SPECIMEN'S SHAPE, AT THE RESOLVE INTERFACE (Pkg16 trigger claim). The binder `node` of
// a `Present { value: node }` arm inside v2.std.symbol_index symbol_index_candidates_at, with a
// sibling MODULE v2.std.node that lexical ascent from the arm would reach. The claim is that the
// arm binds `node` through the index-keyed classifier (v2.compiler.resolve
// resolve_pattern_atom_names_constructor asking v2.std.symbol_index
// symbol_index_declared_payload_at, which returns the payload kind): the tree is Accepted and the binder's Atom survives. It is
// established HERE, at the resolve interface over a supplied mirror of the two modules -- not on the
// native route, whose emitted compiler does not build -- and says so rather than more.
fn mab_resolved_module_named_binder() -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: mab_file(src: "module v2.std.node\n\nfn content_hash(v: Int) -> Int { v }\n", id: ^match_arm_binder_specimen_node_cu),
      tail: Cons {
        head: mab_file(src: "module v2.std.symbol_index\n\ntype Opt = Present { value: Int } | Absent\n\nfn symbol_index_candidates_at(o: Opt) -> Int {\n  match o {\n    Present { value: node } => node\n    Absent => 0\n  }\n}\n", id: ^match_arm_binder_specimen_index_cu),
        tail: Empty
      }
    },
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^v2, tail: Cons { head: ^std, tail: Cons { head: ^symbol_index, tail: Empty } } } },
      imports: Empty
    },
    lm: dag_language_model()
  )
}

test fn mab_binder_spelling_a_sibling_module_binds_the_arm() -> Bool {
  mab_outcome_accepts(o: mab_resolved_module_named_binder())
    && mab_has_atom(o: mab_resolved_module_named_binder(), id: ^node)
}

// A DECLARED CONSTRUCTOR IN A PATTERN STAYS A DECLARATION REFERENCE. `True` is a declared payload,
// answered by the symbol index before the canonical set is consulted (v2.compiler.resolve
// resolve_pattern_atom_names_constructor LexicalHit), so narrowing the canonical set to token
// classes and kernel bindings (v2.extdeps.languages.dag dag_canonical_symbol_map) leaves it a
// reference. Red with the LexicalHit arm answering binder: the atom then stays an Atom.
fn mab_resolved_declared_constructor() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype T = True | False\ntype C = A(T) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(True) => 1\n    A(_) => 0\n    B => 0\n  }\n}\n")
}

test fn mab_declared_constructor_in_a_pattern_stays_a_declaration_reference() -> Bool {
  match mab_resolved_declared_constructor() {
    Rejected { diagnostics: _ } => false
    Accepted { value: n, diagnostics: _ } =>
      fold(node_subtree_nodes(root: n.root), init: false, f: fn(found, m) {
        found || (match declaration_reference_path_optional(node: m) {
          Present { value: path } => qualified_name_last_segment(qn: path) == Present { value: ^True }
          Absent => false
        })
      })
  }
}

// AN UNIMPORTED CONSTRUCTOR IN A PATTERN REFUSES RATHER THAN BINDING. `None` is declared only in
// p.o and not imported into p.q, so it is off the arm's lexical chain and the classifier takes its
// LexicalUnbound -> global-bare branch. A variant is indexed under its containment path AND its
// unique alias, so that lookup answers GlobalBareLookupAmbiguous, which reads as constructor: the
// atom resolves as a reference and refuses unbound, rather than becoming a catch-all binder that
// matches every A(_). WHAT IT DISCRIMINATES, measured: red with the GlobalBareLookupAmbiguous arm
// answering binder; still green with the declared-payload fact forced false, because this spelling
// never reaches the GlobalBareHit arm. RE-MEASURED 2026-10-25 on #15125, and it contradicts that: this
// row stays GREEN with GlobalBareLookupAmbiguous answering binder, and goes RED with GlobalBareHit and
// GlobalBareLookupUnbound both answering binder, so its live route is one of those two, not the
// ambiguous arm. The paragraph above is kept as the record of what was claimed. It is the executed receipt for the bridge's fail-safe
// direction, not evidence for the index-keyed payload fact.
fn mab_resolved_unimported_constructor() -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: mab_file(src: "module p.o\n\ntype Opt = Some(Int) | None\n", id: ^match_arm_binder_unimported_o_cu),
      tail: Cons {
        head: mab_file(src: "module p.q\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(None) => None\n    B => 0\n  }\n}\n", id: ^match_arm_binder_unimported_q_cu),
        tail: Empty
      }
    },
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^p, tail: Cons { head: ^q, tail: Empty } } },
      imports: Empty
    },
    lm: dag_language_model()
  )
}

test fn mab_unimported_constructor_in_a_pattern_refuses_rather_than_binding() -> Bool {
  mab_outcome_refuses_with(
    o: mab_resolved_unimported_constructor(),
    reason: ^resolve_reason_unbound_symbol
  )
}

// A BARE-ATOM ARM PATTERN IS A PATTERN ATOM LIKE A FIELD'S, AND BINDS ITS ARM BY THE SAME RULE.
// `other => other` is the catch-all binder the ambient-name census (gunbc test
// //gunbc/instruments:ambient-name-census) reported unbound at both occurrences, pattern and body,
// at gunbc.instruments.ambient_name_census_reading: v2.compiler.lexical_scope
// pattern_binder_candidates took candidates only from a construct's field atoms, so a pattern with no
// construct tag offered none and the atom resolved as a plain reference. The outer `other` is
// TEST-MARKED for the reason (1) above states: with the arm binding it the module assembles, and
// without the binder `other` reaches the root and refuses resolve_reason_test_code_referenced.
fn mab_resolved_bare_binder() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\ntest fn other() -> Int { 1 }\n\nfn pick(c: C) -> C {\n  match c {\n    A(y) => c\n    other => other\n  }\n}\n")
}

// The binder scopes exactly its arm: a sibling arm naming it, and the rest of the function after the
// match, each see the enclosing scope, where nothing declares `other`.
fn mab_resolved_bare_binder_sibling() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> C {\n  match c {\n    A(y) => other\n    other => c\n  }\n}\n")
}

fn mab_resolved_bare_binder_after_match() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> C {\n  let k = match c {\n    other => other\n  }\n  other\n}\n")
}

// A bare atom naming a declared nullary variant stays a constructor: `B` resolves to its
// declaration and is never a frame binder.
fn mab_resolved_bare_nullary_variant() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(y) => y\n    B => 0\n  }\n}\n")
}

test fn mab_bare_atom_binder_binds_its_arm() -> Bool {
  mab_outcome_accepts(o: mab_resolved_bare_binder())
    && mab_has_atom(o: mab_resolved_bare_binder(), id: ^other)
}

test fn mab_bare_atom_binder_does_not_leak_to_a_sibling_arm() -> Bool {
  mab_outcome_refuses_with(
    o: mab_resolved_bare_binder_sibling(),
    reason: ^resolve_reason_unbound_symbol
  )
}

test fn mab_bare_atom_binder_does_not_leak_past_the_match() -> Bool {
  mab_outcome_refuses_with(
    o: mab_resolved_bare_binder_after_match(),
    reason: ^resolve_reason_unbound_symbol
  )
}

test fn mab_bare_nullary_variant_stays_a_declaration_reference() -> Bool {
  match mab_resolved_bare_nullary_variant() {
    Rejected { diagnostics: _ } => false
    Accepted { value: n, diagnostics: _ } =>
      fold(node_subtree_nodes(root: n.root), init: false, f: fn(found, m) {
        found || (match declaration_reference_path_optional(node: m) {
          Present { value: path } => qualified_name_last_segment(qn: path) == Present { value: ^B }
          Absent => false
        })
      })
  }
}

// The rule reads the index, not the spelling: a LOWERCASE atom naming a payload declared in scope is a
// constructor, exactly as an uppercase one is.
fn mab_resolved_bare_lowercase_variant() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype K = on | off\n\nfn bit(k: K) -> Int {\n  match k {\n    on => 1\n    off => 0\n  }\n}\n")
}

test fn mab_bare_lowercase_payload_stays_a_constructor() -> Bool {
  match mab_resolved_bare_lowercase_variant() {
    Rejected { diagnostics: _ } => false
    Accepted { value: n, diagnostics: _ } =>
      fold(node_subtree_nodes(root: n.root), init: false, f: fn(found, m) {
        found || (match declaration_reference_path_optional(node: m) {
          Present { value: path } => qualified_name_last_segment(qn: path) == Present { value: ^on }
          Absent => false
        })
      })
  }
}

// AN ABSENCE LITERAL IS NEVER A BINDER (v2.extdeps.languages.dag dag_pattern_atom_is_literal). The seed
// reads `none` and `null` in a pattern as LitNull; read as binders they would match every value. Each
// stays an atom that resolves as a reference and refuses, at the top and in a field alike.
fn mab_resolved_bare_none() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(y) => y\n    none => 0\n  }\n}\n")
}

fn mab_resolved_bare_null() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(y) => y\n    null => 0\n  }\n}\n")
}

fn mab_resolved_field_null() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(null) => 1\n    A(_) => 2\n    B => 0\n  }\n}\n")
}

test fn mab_absence_literal_pattern_refuses_rather_than_binding() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_bare_none(), reason: ^resolve_reason_unbound_symbol)
    && mab_outcome_refuses_with(o: mab_resolved_bare_null(), reason: ^resolve_reason_unbound_symbol)
    && mab_outcome_refuses_with(o: mab_resolved_field_null(), reason: ^resolve_reason_unbound_symbol)
}

// A CATCH-ALL BINDER ITS ARM NEVER READS REFUSES (v2.compiler.resolve
// resolve_catch_all_binder_read_gate); the remedy is `_`. Its sharpest case is the one this gate exists
// for: a MISSPELLED nullary variant in the last arm (`Bx` for `B`) names no payload and reads as a
// binder, and, unread, it refuses rather than silently covering `B`. Both rows red with the gate
// deleted: the first accepts, and the second accepts with the misspelling covering every leftover
// variant.
fn mab_resolved_unread_catch_all() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(y) => y\n    other => 0\n  }\n}\n")
}

fn mab_resolved_misspelled_last_nullary() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A(y) => y\n    Bx => 0\n  }\n}\n")
}

test fn mab_unread_catch_all_binder_refuses() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_unread_catch_all(), reason: ^resolve_reason_catch_all_binder_unread)
}

test fn mab_misspelled_nullary_in_the_last_arm_refuses() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_misspelled_last_nullary(), reason: ^resolve_reason_catch_all_binder_unread)
}

// AN UNIMPORTED NULLARY VARIANT WHOSE ARM READS IT REFUSES, NEVER BINDS. `Absent => Absent` reads the
// atom, so the unread-binder gate cannot catch it; what keeps it a constructor is the payload test
// itself (resolve_pattern_atom_names_constructor). `Absent` is declared only in p.o and not imported
// into p.q, so it is off the arm's lexical chain and the test takes the global-bare branch, which
// names it a declared variant BY IDENTITY: GlobalBareHit, whose one path is a declared payload, not the
// canonical-symbol spelling fallback. The atom then resolves as a reference and refuses unbound. Read as
// a binder it would be a catch-all whose arm returns the scrutinee, Accepted with the wrong meaning.
// WHAT DISCRIMINATES IT, measured 2026-10-25 on #15125: red with the GlobalBareHit and
// GlobalBareLookupUnbound arms both answering binder; green with only GlobalBareLookupUnbound (the
// canonical fallback) answering binder, and green with GlobalBareLookupAmbiguous answering binder.
fn mab_resolved_unimported_bare_nullary_read() -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: mab_file(src: "module p.o\n\ntype Opt = Present { value: Int } | Absent\n", id: ^match_arm_binder_unimported_bare_o_cu),
      tail: Cons {
        head: mab_file(src: "module p.q\n\nfn pick(o: Int) -> Int {\n  match o {\n    Absent => Absent\n  }\n}\n", id: ^match_arm_binder_unimported_bare_q_cu),
        tail: Empty
      }
    },
    admission: Admission {
      subject: ResolutionSubject { name: Cons { head: ^p, tail: Cons { head: ^q, tail: Empty } } },
      imports: Empty
    },
    lm: dag_language_model()
  )
}

test fn mab_unimported_bare_nullary_read_by_its_arm_refuses_rather_than_binding() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_unimported_bare_nullary_read(), reason: ^resolve_reason_unbound_symbol)
}

// A PATTERN ATOM NAMING A VALUE OF AN ENCLOSING FRAME REFUSES WITH ONE CAUSE THAT NAMES BOTH READINGS
// (v2.compiler.resolve resolve_pattern_atom_naming_a_frame_value, resolve_reason_pattern_atom_names_visible_value:
// rename to bind, or use an equality guard to compare). Before, these programs refused
// binder_hides_visible_value, and the first one's arm is also unread: the reason asserted is the one cause
// that replaces both for a pattern atom. A binder spelled like a module FUNCTION is not decided here
// (module-level names are a declaration-shape modeling item) and still binds.
fn mab_resolved_constant_frame_pattern() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C, x: C) -> Int {\n  match c {\n    x => 1\n  }\n}\n")
}

fn mab_resolved_constant_frame_field_pattern() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A(Int) | B\n\nfn pick(c: C, k: Int) -> Int {\n  match c {\n    A(k) => 1\n    A(_) => 2\n    B => 0\n  }\n}\n")
}

fn mab_resolved_binder_spelled_like_a_function() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\nfn twice(v: Int) -> Int { v }\n\ntype C = A(Int) | B\n\nfn pick(c: C) -> C {\n  match c {\n    A(y) => c\n    twice => twice\n  }\n}\n")
}

test fn mab_a_pattern_atom_naming_a_frame_value_refuses_naming_both_readings() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_constant_frame_pattern(), reason: ^resolve_reason_pattern_atom_names_visible_value)
}

test fn mab_a_field_pattern_atom_naming_a_frame_value_refuses_naming_both_readings() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_constant_frame_field_pattern(), reason: ^resolve_reason_pattern_atom_names_visible_value)
}

test fn mab_a_binder_spelled_like_a_module_function_still_binds() -> Bool {
  mab_outcome_accepts(o: mab_resolved_binder_spelled_like_a_function())
    && mab_has_atom(o: mab_resolved_binder_spelled_like_a_function(), id: ^twice)
}

// A MODULE-LEVEL CONSTANT IN PATTERN POSITION refuses with the same cause, now that the index tells a
// `data` row from a function (v2.std.symbol_index type_decl_member_shape). The first row is
// v2.extdeps.languages.wasm's shape: the seed read each atom as a catch-all binder.
fn mab_resolved_module_constant_pattern() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype F { w: Int }\n\ndata fa: F = F { w: 1 }\n\ndata fb: F = F { w: 2 }\n\nfn id(f: F) -> Int {\n  match f {\n    fa => 1\n    fb => 2\n  }\n}\n")
}

fn mab_resolved_module_constant_read_pattern() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype F { w: Int }\n\ndata fa: F = F { w: 1 }\n\nfn id(f: F) -> F {\n  match f {\n    fa => fa\n  }\n}\n")
}

test fn mab_a_module_constant_in_pattern_position_refuses_naming_both_readings() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_module_constant_pattern(), reason: ^resolve_reason_pattern_atom_names_visible_value)
    && mab_outcome_refuses_with(o: mab_resolved_module_constant_read_pattern(), reason: ^resolve_reason_pattern_atom_names_visible_value)
}

// THE WHOLE-ARM BARE ATOM (PatternTagPosition). The position reports one way for a nullary tag and
// for a catch-all binder, so it cannot tell them apart: resolution decides, by what the atom names on
// the arm's chain. The discriminator is the unread-binder rule: a catch-all binder its arm never reads
// refuses (resolve_reason_catch_all_binder_unread), so `A => 1` accepting means A was taken as the
// tag, not as a binder; `other => 1` refusing means `other` was taken as a binder. A binder the body
// reads stays the Atom it was spelled as. (Atom presence of a tag's own spelling proves nothing: the
// type declaration spells it too.)
fn mab_resolved_nullary_tag_arm() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A => 1\n    B => 0\n  }\n}\n")
}

fn mab_resolved_fresh_name_arm() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A | B\n\nfn pick(c: C) -> Int {\n  match c {\n    A => 1\n    other => 0\n  }\n}\n")
}

fn mab_resolved_fresh_name_arm_body_reads_it() -> Outcome<ResolvedTree> {
  mab_assemble(src: "module p\n\ntype C = A | B\n\nfn pick(c: C) -> C {\n  match c {\n    A => B\n    other => other\n  }\n}\n")
}

test fn mab_a_bare_atom_arm_naming_a_nullary_tag_binds_the_tag() -> Bool {
  mab_outcome_accepts(o: mab_resolved_nullary_tag_arm())
}

test fn mab_a_bare_atom_arm_naming_nothing_binds_a_binder_its_body_reads() -> Bool {
  mab_outcome_accepts(o: mab_resolved_fresh_name_arm_body_reads_it())
    && mab_has_atom(o: mab_resolved_fresh_name_arm_body_reads_it(), id: ^other)
}

test fn mab_an_unread_catch_all_binder_refuses() -> Bool {
  mab_outcome_refuses_with(o: mab_resolved_fresh_name_arm(), reason: ^resolve_reason_catch_all_binder_unread)
}
