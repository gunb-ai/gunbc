module v2.test.claim.shell_emission_authorization_test


fn empty_roster() -> List<v2.std.execution_surface.ShellEmissionRosterEntry> {
  []
}

fn all_absent_gate() -> v2.std.execution_surface.RuntimeAvailabilityGate {
  v2.std.execution_surface.RuntimeAvailabilityGate {
    gunbc_binary: v2.std.execution_surface.Absent,
    typed_transport: v2.std.execution_surface.Absent,
    plan_interpreter: v2.std.execution_surface.Absent
  }
}

test fn foreign_executor_authorizes_regardless_of_window() -> v2.std.logic.Bool {
  let auth = authorize_shell_emission(
    capability: v2.std.execution_surface.ShellPayloadRequired { foreign: GitHubActionsRunStep },
    window: SteadyState,
    site: ^ci_bootstrap_shim,
    roster: empty_roster()
  )
  match auth {
    Authorized { justification: ForeignExecutorMandated { capability: _ } } => true
    Authorized { justification: _ } => false
    v2.std.execution_surface.Refused { cause: _ } => false
  }
}

test fn bootstrap_window_with_absent_gate_authorizes() -> v2.std.logic.Bool {
  let auth = authorize_shell_emission(
    capability: TypedArgv,
    window: v2.std.execution_surface.BootstrapBeforeRuntime { until: all_absent_gate() },
    site: ^fresh_standup_shim,
    roster: empty_roster()
  )
  match auth {
    Authorized { justification: BootstrapProvisioned { window: _, site: _ } } => true
    Authorized { justification: _ } => false
    v2.std.execution_surface.Refused { cause: _ } => false
  }
}

test fn bootstrap_window_with_unknown_availability_refuses() -> v2.std.logic.Bool {
  let gate = v2.std.execution_surface.RuntimeAvailabilityGate {
    gunbc_binary: v2.std.execution_surface.Absent,
    typed_transport: v2.std.execution_surface.Unknown { cause: "probe not run" },
    plan_interpreter: v2.std.execution_surface.Absent
  }
  let auth = authorize_shell_emission(
    capability: TypedArgv,
    window: v2.std.execution_surface.BootstrapBeforeRuntime { until: gate },
    site: ^fresh_standup_shim,
    roster: empty_roster()
  )
  match auth {
    v2.std.execution_surface.Refused { cause: UnknownAvailability { gate: _ } } => true
    v2.std.execution_surface.Refused { cause: _ } => false
    Authorized { justification: _ } => false
  }
}

test fn steady_state_without_roster_entry_refuses() -> v2.std.logic.Bool {
  let auth = authorize_shell_emission(
    capability: TypedArgv,
    window: SteadyState,
    site: ^live_deploy_apply,
    roster: empty_roster()
  )
  match auth {
    v2.std.execution_surface.Refused { cause: RuntimePresentRequiresTypedRealization { capability: _ } } => true
    v2.std.execution_surface.Refused { cause: _ } => false
    Authorized { justification: _ } => false
  }
}

test fn steady_state_with_matching_roster_entry_authorizes() -> v2.std.logic.Bool {
  let roster = [
    v2.std.execution_surface.ShellEmissionRosterEntry {
      site: ^live_deploy_apply,
      roster_key: "live_deploy_apply",
      dissolution: std.dissolution.unbound_dissolution(description: "dissolve-on: live_deploy typed-effect reshape (slice 3)")
    }
  ]
  let auth = authorize_shell_emission(
    capability: TypedArgv,
    window: SteadyState,
    site: ^live_deploy_apply,
    roster: roster
  )
  match auth {
    Authorized { justification: RosterException { roster_key: k, dissolution: _ } } =>
      k == "live_deploy_apply"
    Authorized { justification: _ } => false
    v2.std.execution_surface.Refused { cause: _ } => false
  }
}

test fn steady_state_roster_entry_for_other_site_still_refuses() -> v2.std.logic.Bool {
  let roster = [
    v2.std.execution_surface.ShellEmissionRosterEntry {
      site: ^live_deploy_apply,
      roster_key: "live_deploy_apply",
      dissolution: std.dissolution.unbound_dissolution(description: "dissolve-on: live_deploy typed-effect reshape (slice 3)")
    }
  ]
  let auth = authorize_shell_emission(
    capability: TypedArgv,
    window: SteadyState,
    site: ^srv3_install_tail,
    roster: roster
  )
  match auth {
    v2.std.execution_surface.Refused { cause: RuntimePresentRequiresTypedRealization { capability: _ } } => true
    v2.std.execution_surface.Refused { cause: _ } => false
    Authorized { justification: _ } => false
  }
}

test fn typed_plan_interpretation_at_steady_state_still_needs_roster() -> v2.std.logic.Bool {
  let auth = authorize_shell_emission(
    capability: TypedPlanInterpretation,
    window: SteadyState,
    site: ^fleet_converge_srv1,
    roster: empty_roster()
  )
  !shell_emission_authorization_is_authorized(auth: auth)
}

test fn authorization_predicate_is_bool_summarizable() -> v2.std.logic.Bool {
  let authorized = authorize_shell_emission(
    capability: v2.std.execution_surface.ShellPayloadRequired { foreign: AutoinstallLateCommand },
    window: v2.std.execution_surface.BootstrapBeforeRuntime { until: all_absent_gate() },
    site: ^autoinstall_late_command,
    roster: empty_roster()
  )
  shell_emission_authorization_is_authorized(auth: authorized)
}
