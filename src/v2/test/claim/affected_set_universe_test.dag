module v2.test.claim.affected_set_universe

import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.node { Symbol }
import v2.std.algebra { bag_eq }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.lens.affected_set {
  RepoProcess,
  RepoProcessUniverse,
  UniverseComplete,
  UniverseIncomplete,
  ci_gate_processes,
  meta_processes,
  repo_process_universe,
  repo_process_universe_from
}
import gunbc.ci_spec {
  Gate,
  gunbc_ci_gates,
  gunbc_ci_falsifier_gates
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

// THE DISPOSITION CHANGED WITH THE CUTOVER, and it is a fact about this module rather than a
// formality. These claims used to reach reflection through a seam that took only a bare spelling,
// so nothing they called named a source population and SubstrateInputsOnly was true. The reads are
// now scope-carrying: they name pool roots and consult the live declaration index through
// v2.std.decl_index, so the claims read the live tree and say so.
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn process_identities(ps: List<RepoProcess>) -> List<Symbol> {
  ps |> map(p => p.identity)
}

fn gate_discriminants(gates: List<Gate>) -> List<Symbol> {
  gates |> map(g => discriminant(v: g))
}

fn identity_in(ps: List<RepoProcess>, sym: Symbol) -> Bool {
  fold(ps, init: false, f: fn(acc, p) { acc || (p.identity == sym) })
}

// THE ROOTS THIS LENS READS, named because the reflection reads are now scope-carrying and a
// population the claim does not state is one a reader cannot re-derive.
data affected_set_universe_pool_roots: List<String> = ["dag", "src/v2"]


// A REFUSED READ IS NOT AN EMPTY ONE. These claims previously consumed bare lists; the reads can now
// refuse, so each unwraps explicitly and a refusal fails the claim rather than degrading to an empty
// process set that would satisfy several of the assertions below by vacuity.
fn processes_or_empty(o: Outcome<List<RepoProcess>>) -> List<RepoProcess> {
  match o {
    Accepted { value: ps, diagnostics: _ } => ps
    Rejected { diagnostics: _ } => []
  }
}

fn read_refused(o: Outcome<List<RepoProcess>>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn affected_set_universe_gate_processes_match_declared_gates() -> Bool {
  bag_eq(
    xs: process_identities(
      ps: processes_or_empty(o: ci_gate_processes(pool_roots: affected_set_universe_pool_roots))
    ),
    ys: gate_discriminants(
      gates: concat(gunbc_ci_gates, gunbc_ci_falsifier_gates)
    ),
    eq: symbol_eq
  )
}

test fn affected_set_universe_includes_meta_self() -> Bool {
  let metas = processes_or_empty(
    o: meta_processes(pool_roots: affected_set_universe_pool_roots)
  )
  identity_in(ps: metas, sym: ^AffectedSetLens)
    && identity_in(ps: metas, sym: ^TestgenLens)
    && !identity_in(ps: metas, sym: ^NotARealMetaProcess)
}

// THE READS MUST ACTUALLY RESOLVE, asserted separately because processes_or_empty deliberately
// degrades a refusal to an empty list for the assertions above. Without this claim a corpus in
// which every reflection read refused would still satisfy the negative half of the claim above --
// !identity_in over an empty list is true -- so the refusal would be invisible exactly where it
// matters most. This is the claim that makes the others mean what they say.
test fn affected_set_universe_reflection_reads_resolve() -> Bool {
  !read_refused(o: ci_gate_processes(pool_roots: affected_set_universe_pool_roots))
    && !read_refused(o: meta_processes(pool_roots: affected_set_universe_pool_roots))
}

test fn affected_set_universe_is_complete() -> Bool {
  match repo_process_universe(pool_roots: affected_set_universe_pool_roots) {
    UniverseComplete { processes: _ } => true
    UniverseIncomplete { uncovered_kind: _, reason: _ } => false
  }
}

test fn affected_set_universe_incomplete_fails_closed() -> Bool {
  match repo_process_universe_from(
    pool_roots: affected_set_universe_pool_roots,
    processes: processes_or_empty(
      o: ci_gate_processes(pool_roots: affected_set_universe_pool_roots)
    )
  ) {
    UniverseComplete { processes: _ } => false
    UniverseIncomplete { uncovered_kind: k, reason: _ } => k == ^MetaProcessRole
  }
}
