module v2.test.claim.affected_set_universe

import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.node { Symbol }
import v2.std.algebra { bag_eq }
import v2.lens.affected_set {
  RepoProcess,
  RepoProcessUniverse,
  UniverseComplete,
  UniverseIncomplete,
  ci_gate_processes,
  meta_processes,
  repo_process_universe,
  repo_process_universe_from
}
import gunbc.ci_gate { Gate }
import gunbc.commit_workflow {
  commit_gate_roster,
  project_ci_floor_gates,
  project_falsifier_gates,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn process_identities(ps: List<RepoProcess>) -> List<Symbol> {
  ps |> map(p => p.identity)
}

fn gate_discriminants(gates: List<Gate>) -> List<Symbol> {
  gates |> map(g => discriminant(v: g))
}

fn identity_in(ps: List<RepoProcess>, sym: Symbol) -> Bool {
  fold(ps, init: false, f: fn(acc, p) { acc || (p.identity == sym) })
}

test fn affected_set_universe_gate_processes_match_declared_gates() -> Bool {
  bag_eq(
    xs: process_identities(ps: ci_gate_processes()),
    ys: gate_discriminants(
      gates: concat(
        project_ci_floor_gates(roster: commit_gate_roster),
        project_falsifier_gates(roster: commit_gate_roster),
      )
    ),
    eq: symbol_eq
  )
}

test fn affected_set_universe_includes_meta_self() -> Bool {
  identity_in(ps: meta_processes(), sym: ^AffectedSetLens)
    && identity_in(ps: meta_processes(), sym: ^TestgenLens)
    && !identity_in(ps: meta_processes(), sym: ^NotARealMetaProcess)
}

test fn affected_set_universe_is_complete() -> Bool {
  match repo_process_universe() {
    UniverseComplete { processes: _ } => true
    UniverseIncomplete { uncovered_kind: _, reason: _ } => false
  }
}

test fn affected_set_universe_incomplete_fails_closed() -> Bool {
  match repo_process_universe_from(processes: ci_gate_processes()) {
    UniverseComplete { processes: _ } => false
    UniverseIncomplete { uncovered_kind: k, reason: _ } => k == ^MetaProcessRole
  }
}
