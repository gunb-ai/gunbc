module v2.test.claim.affected_set_universe


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn symbol_eq(a: v2.std.node.Symbol, b: v2.std.node.Symbol) -> Bool {
  a == b
}

fn process_identities(ps: List<v2.lens.affected_set.RepoProcess>) -> List<v2.std.node.Symbol> {
  fold(ps, init: [], f: fn(acc, p) { v2.std.algebra.list_snoc_item(xs: acc, item: p.identity) })
}

fn gate_discriminants(gates: List<gunbc.ci_gate.Gate>) -> List<v2.std.node.Symbol> {
  fold(gates, init: [], f: fn(acc, g) { v2.std.algebra.list_snoc_item(xs: acc, item: discriminant(v: g)) })
}

fn identity_in(ps: List<v2.lens.affected_set.RepoProcess>, sym: v2.std.node.Symbol) -> Bool {
  fold(ps, init: false, f: fn(acc, p) { acc || (p.identity == sym) })
}

test fn affected_set_universe_gate_processes_match_declared_gates() -> Bool {
  v2.std.algebra.bag_eq(
    xs: process_identities(ps: v2.lens.affected_set.ci_gate_processes()),
    ys: gate_discriminants(
      gates: concat(gunbc.ci_spec.gunbc_ci_gates, gunbc.ci_spec.gunbc_ci_falsifier_gates)
    ),
    eq: symbol_eq
  )
}

test fn affected_set_universe_includes_meta_self() -> Bool {
  identity_in(ps: v2.lens.affected_set.meta_processes(), sym: ^AffectedSetLens)
    && identity_in(ps: v2.lens.affected_set.meta_processes(), sym: ^TestgenLens)
    && !identity_in(ps: v2.lens.affected_set.meta_processes(), sym: ^NotARealMetaProcess)
}

test fn affected_set_universe_is_complete() -> Bool {
  match v2.lens.affected_set.repo_process_universe() {
    v2.lens.affected_set.UniverseComplete { processes: _ } => true
    v2.lens.affected_set.UniverseIncomplete { uncovered_kind: _, reason: _ } => false
  }
}

test fn affected_set_universe_incomplete_fails_closed() -> Bool {
  match v2.lens.affected_set.repo_process_universe_from(processes: v2.lens.affected_set.ci_gate_processes()) {
    v2.lens.affected_set.UniverseComplete { processes: _ } => false
    v2.lens.affected_set.UniverseIncomplete { uncovered_kind: k, reason: _ } => k == ^MetaProcessRole
  }
}
