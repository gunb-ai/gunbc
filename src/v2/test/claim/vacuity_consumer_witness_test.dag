module v2.test.claim.vacuity_consumer_witness

import v2.lens.vacuity {
  BoolWitnessClaim,
  EqualityOperands,
  LiteralOracle,
  LiveSurfaceSnapshot,
  OperandProvenanceUnknown,
  ProvenDuplicate,
  Unknown,
  VacuityEvidence,
  VacuityEvidenceRecord,
  classify_unified_test_claim_vacuity,
  classify_vacuity_same_eval_record,
  vacuity_evidence_eq
}
import std.algebra { Empty }
import v2.lens.inert_carrier { count_not_in_roster, count_stale_roster }
import v2.std.algebra { fold_list, list_append }
import v2.std.collection { List }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.verification { BoolWitness, EvalOnly }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data vacuity_consumer_witness_note: String = "Binds lens_contract_vacuity.consumer_witness (mandate item 5): this witness ACTUALLY EXECUTES the real-corpus BoolWitnessClaim classifier over a small, honestly-declared bounded pool (real test fn declarations reject wholesale at parse today — the confirmed `test` grammar gap documented in v2.lens.vacuity's vacuity_bool_witness_real_corpus_note — so a wider scan would be a Group-C zero-catch lens dressed up as coverage), asserts a roster of tolerated ProvenDuplicate occurrences reconciles exactly (count_not_in_roster == 0 && count_stale_roster == 0, the inert_carrier.dag roster-diff idiom — never a LensContract.mode flip), and carries a genuine synthetic RED control shaped exactly like the PR #7614 defect (a LiveSurfaceSnapshot value compared against a LiteralOracle with no independent oracle) which MUST classify ProvenDuplicate through the real classify_vacuity_same_eval_record call, not a stand-in assertion. This IS the argument for binding an executing consumer: the same-eval fail-open (classify_vacuity_same_eval_record's deepest else branch) was already flagged by the lens's own W3 dissolution note in vacuity.dag — the mechanism knew about its own defect and carried the marker, and the defect survived anyway because nothing executes the lens (AuditOnly with NoConsumerWitness). A declared, marked, honestly-noted defect is still a live fail-open when no consumer runs the thing that would report it."

data vacuity_consumer_witness_scan_scope_note: String = "Scope is a declared, bounded, representative pool (dissolve-on: v2.extdeps.languages.dag's dag_language_model() grammar gains a `test` keyword/production, at which point real test fn declarations parse and the scan widens to the corpus discovery roster like cost_coverage/grammar_coverage do)."

data vacuity_witness_fixture_bool_witness: BoolWitness = BoolWitness {
  entry: "src/v2/lens/vacuity_self_application_fixture.dag",
  function: ^vacuity_self_application_probe
}

data vacuity_witness_real_test_fn_bool_witness: BoolWitness = BoolWitness {
  entry: "src/v2/lens/vacuity_test.dag",
  function: ^vacuity_falsification_suite_nonempty
}

data vacuity_witness_scan_pool: List<BoolWitness> = [
  vacuity_witness_fixture_bool_witness,
  vacuity_witness_real_test_fn_bool_witness
]

fn vacuity_witness_evidence_for(w: BoolWitness) -> VacuityEvidence {
  classify_unified_test_claim_vacuity(
    claim: BoolWitnessClaim { witness: w },
    lhs_provenance: OperandProvenanceUnknown,
    rhs_provenance: OperandProvenanceUnknown,
    operand_provenance: OperandProvenanceUnknown
  )
}

data vacuity_witness_tolerated_duplicate_roster: List<String> = [
  "src/v2/lens/vacuity_self_application_fixture.dag::vacuity_self_application_probe"
]

fn vacuity_witness_bool_witness_label(w: BoolWitness) -> String {
  concat(w.entry, concat("::", symbol_lexeme(sym: w.function)))
}

fn vacuity_witness_observed_duplicate_labels() -> List<String> {
  fold_list(
    xs: vacuity_witness_scan_pool,
    empty: Empty,
    cons: fn(acc, w) {
      if vacuity_evidence_eq(a: vacuity_witness_evidence_for(w: w), b: ProvenDuplicate) {
        list_append(left: acc, right: [vacuity_witness_bool_witness_label(w: w)])
      } else {
        acc
      }
    }
  )
}

test fn vacuity_consumer_witness_fixture_classifies_proven_duplicate_by_execution() -> Bool {
  vacuity_evidence_eq(
    a: vacuity_witness_evidence_for(w: vacuity_witness_fixture_bool_witness),
    b: ProvenDuplicate
  )
}

test fn vacuity_consumer_witness_real_test_fn_stays_unknown_by_execution() -> Bool {
  vacuity_evidence_eq(
    a: vacuity_witness_evidence_for(w: vacuity_witness_real_test_fn_bool_witness),
    b: Unknown
  )
}

test fn vacuity_consumer_witness_duplicate_roster_reconciles() -> Bool {
  let observed = vacuity_witness_observed_duplicate_labels()
  (count_not_in_roster(names: observed, roster: vacuity_witness_tolerated_duplicate_roster) == 0)
    && (count_stale_roster(roster: vacuity_witness_tolerated_duplicate_roster, inert_names: observed) == 0)
}

test fn vacuity_consumer_witness_pr7614_shape_red_control_classifies_proven_duplicate() -> Bool {
  vacuity_evidence_eq(
    a: classify_vacuity_same_eval_record(
      record: VacuityEvidenceRecord {
        subject: EqualityOperands,
        transport: EvalOnly,
        lhs_provenance: LiveSurfaceSnapshot,
        rhs_provenance: LiteralOracle,
        operands_structurally_equal: true
      }
    ),
    b: ProvenDuplicate
  )
}
