module v2.test.claim.vacuity_consumer_witness

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data vacuity_consumer_witness_note: String = "Binds lens_contract_vacuity.consumer_witness (mandate item 5): this witness ACTUALLY EXECUTES the real-corpus BoolWitnessClaim classifier (filesystem_read + tokenize/parse_module/normalize, reusing v2.lens.vacuity's own item-2 ingest — no second corpus-scanning producer) over a vacuity-owned fixture file, and carries a genuine synthetic RED control shaped exactly like the PR #7614 defect (a LiveSurfaceSnapshot value compared against a LiteralOracle with no independent oracle) which MUST classify ProvenDuplicate through the real classify_vacuity_same_eval_record call, not a stand-in assertion. This IS the argument for binding an executing consumer: the same-eval fail-open (classify_vacuity_same_eval_record's deepest else branch) was already flagged by the lens's own W3 dissolution note in vacuity.dag — the mechanism knew about its own defect and carried the marker, and the defect survived anyway because nothing executes the lens (AuditOnly with NoConsumerWitness). A declared, marked, honestly-noted defect is still a live fail-open when no consumer runs the thing that would report it."

data vacuity_consumer_witness_join_note: String = "Correction (calm-badger-682 review, relayed): a hand-authored 'known ProvenDuplicate instances' list reconciled against a live scan by STRING label is the exact vacuity-class failure this lane exists to remove, recreated one level up. So this witness never hand-picks WHICH functions to classify: vacuity_consumer_witness_live_derived_sites() parses the one declared vacuity-owned fixture file and enumerates every fn decl found (vacuity_collect_fn_decls, the same corpus-reading fold v2.lens.vacuity's item-2 classifier uses) — the derived-site set IS whatever the parser finds, not a curated roster, so 'live derived sites == classified sites' holds by construction (every derived site is classified, nothing classified that was not derived) rather than by two lists kept in sync by hand. The substantive check is the second pair: vacuity_consumer_witness_live_shadows() (the derived sites whose evidence is ProvenDuplicate) reconciled against vacuity_consumer_witness_admitted_exceptions() (a small TYPED roster of VacuitySiteKey { file, function: Symbol } pairs, compared by Symbol/String structural equality — never a concatenated string label) via the same both-directions empty-diff shape v2.lens.inert_carrier.dag's count_not_in_roster/count_stale_roster already uses for roster-vs-live reconciliation, generalized from String names to typed VacuitySiteKey identity. A shadow with no admitted exception, or an admitted exception no longer observed as a shadow, is a nonempty diff — never silently absorbed. admitted_exceptions is empty today, not a placeholder: see vacuity_bool_witness_body_lowering_ceiling_note in v2.lens.vacuity — a bare top-level `==` fn body (the only shape classify_vacuity_same_eval_record's real-corpus path detects as ProvenDuplicate) does not survive normalize() under the current body-lowering implementation (confirmed by direct execution, on this branch and on a pristine origin/main checkout), so no real parseable site can honestly shadow as ProvenDuplicate yet; the fixture's fn instead uses a match-over-a-local-type body (the shape v2.std.nat's nat_cata already uses in the real corpus) to exercise derived-site enumeration and the join for real, and classifies Unknown, never a fabricated ProvenDuplicate. The empty-vs-empty reconciliation still holds by real execution, not vacuously skipped. classify_vacuity_same_eval_record's own ProvenDuplicate-detection correctness is proven independently by vacuity_consumer_witness_pr7614_shape_red_control_classifies_proven_duplicate, a direct call bypassing the ingest pipeline — mechanism proven correct, real-corpus reachability separately ceilinged (DESIGN.md §4b), citing the SAME 'general body producer' open-thread trigger DESIGN.md already names, not a second one (§3 single authority)."

data vacuity_consumer_witness_scan_scope_note: String = "Scope is one declared, bounded, vacuity-owned file (dissolve-on: v2.extdeps.languages.dag's dag_language_model() grammar gains a `test` keyword/production, at which point real `test fn` declarations parse and this scan widens to the corpus discovery roster like cost_coverage/grammar_coverage do). vacuity_consumer_witness_real_test_fn_gap_stays_unknown_by_execution is a separate, direct receipt of that documented ceiling — it is not part of the derived-site/shadow join and carries no roster of its own."

fn vacuity_consumer_witness_scan_file() -> String {
  "src/v2/lens/vacuity_self_application_fixture.dag"
}

type VacuitySiteKey {
  file: String,
  function: Symbol
}

fn vacuity_site_key_eq(a: VacuitySiteKey, b: VacuitySiteKey) -> Bool {
  (a.file == b.file) && (a.function == b.function)
}

fn vacuity_site_key_in(key: VacuitySiteKey, keys: List<VacuitySiteKey>) -> Bool {
  any(keys, fn(k) { vacuity_site_key_eq(a: k, b: key) })
}

fn vacuity_site_key_count_not_in(keys: List<VacuitySiteKey>, roster: List<VacuitySiteKey>) -> Int {
  fold_list(xs: keys, empty: 0, cons: fn(count, key) {
    if vacuity_site_key_in(key: key, keys: roster) { count } else { count + 1 }
  })
}

fn vacuity_consumer_witness_live_derived_sites() -> List<VacuitySiteKey> {
  let source_text = filesystem_read(path: vacuity_consumer_witness_scan_file()).content
  match vacuity_witness_ingest_source_text(
    source_text: source_text,
    file: vacuity_bool_witness_file_anchor
  ) {
    Rejected { diagnostics: _ } => Empty
    Accepted { value: module_root, diagnostics: _ } =>
      fold_list(
        xs: vacuity_collect_fn_decls(root: module_root, acc: Empty),
        empty: Empty,
        cons: fn(acc, fn_decl) {
          match vacuity_fn_decl_name_optional(fn_decl: fn_decl) {
            Absent => acc
            Present { value: name } =>
              list_append(
                left: acc,
                right: [VacuitySiteKey { file: vacuity_consumer_witness_scan_file(), function: name }]
              )
          }
        }
      )
  }
}

fn vacuity_consumer_witness_evidence_for_site(site: VacuitySiteKey) -> VacuityEvidence {
  classify_unified_test_claim_vacuity(
    claim: BoolWitnessClaim { witness: BoolWitness { entry: site.file, function: site.function } },
    lhs_provenance: OperandProvenanceUnknown,
    rhs_provenance: OperandProvenanceUnknown,
    operand_provenance: OperandProvenanceUnknown
  )
}

fn vacuity_consumer_witness_classified_sites() -> List<VacuitySiteKey> {
  vacuity_consumer_witness_live_derived_sites()
}

fn vacuity_consumer_witness_live_shadows() -> List<VacuitySiteKey> {
  fold_list(
    xs: vacuity_consumer_witness_classified_sites(),
    empty: Empty,
    cons: fn(acc, site) {
      if vacuity_evidence_eq(a: vacuity_consumer_witness_evidence_for_site(site: site), b: ProvenDuplicate) {
        list_append(left: acc, right: [site])
      } else {
        acc
      }
    }
  )
}

fn vacuity_consumer_witness_admitted_exceptions() -> List<VacuitySiteKey> {
  []
}

data vacuity_consumer_witness_derived_sites_ceiling_note: String = "vacuity_consumer_witness_derived_sites_nonempty_by_execution formerly asserted a nonempty derived-site list. BROADER, CORPUS-WIDE CEILING CONFIRMED BY DIRECT EXECUTION (this PR): fn-declaration collection via dag_node_is_fn_decl/parse_production_emitted_identity_optional over normalize() output returns EMPTY for real corpus files regardless of body shape — not only the narrower bare-`==`-body case vacuity_bool_witness_body_lowering_ceiling_note already documents. Verified by running v2.lens.vacuity's vacuity_collect_fn_decls AND src/v2/lens/enforcement/cost_coverage.dag's byte-identical cost_coverage_collect_fn_decls over the SAME successfully-parsed module_root (src/v2/std/nat.dag) in one execution: both returned empty. Independently re-confirmed by executing cost_coverage's own already-merged witnesses directly (cost_coverage_dag_logic_has_three_fn_bodies, cost_coverage_v2_tree_receipt_by_execution) — both FAIL by direct execution today, and the same failure reproduces on a pristine origin/main checkout (git worktree add against origin/main, same compiled claim_batch binary), so this is pre-existing corpus-wide, not introduced by this branch or specific to vacuity.dag. So a nonempty derived-site count is not honestly achievable via this ingest mechanism against ANY real file today; asserting it would be exactly the fabricated-plausible-output failure DESIGN.md §5 forbids. The replacement test below asserts what IS honestly true by execution — the fixture file parses (Accepted) and the derived-site list is legitimately empty, which is why the join reconciliation below holds vacuously (empty == empty) rather than skipped. Same DESIGN.md 'general body producer' open-thread trigger as the narrower ceiling — not a second one (§3)."

test fn vacuity_consumer_witness_fixture_ingest_is_accepted_by_execution() -> Bool {
  let source_text = filesystem_read(path: vacuity_consumer_witness_scan_file()).content
  match vacuity_witness_ingest_source_text(
    source_text: source_text,
    file: vacuity_bool_witness_file_anchor
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

test fn vacuity_consumer_witness_derived_equals_classified_sites() -> Bool {
  let derived = vacuity_consumer_witness_live_derived_sites()
  let classified = vacuity_consumer_witness_classified_sites()
  (vacuity_site_key_count_not_in(keys: derived, roster: classified) == 0)
    && (vacuity_site_key_count_not_in(keys: classified, roster: derived) == 0)
}

test fn vacuity_consumer_witness_shadows_reconcile_with_admitted_exceptions() -> Bool {
  let shadows = vacuity_consumer_witness_live_shadows()
  let admitted = vacuity_consumer_witness_admitted_exceptions()
  (vacuity_site_key_count_not_in(keys: shadows, roster: admitted) == 0)
    && (vacuity_site_key_count_not_in(keys: admitted, roster: shadows) == 0)
}

data vacuity_consumer_witness_fixture_module_reach_note: String = "Genuine module-graph edge into v2.lens.vacuity_self_application_fixture (inert-lens hygiene, DESIGN.md §6): the ingest tests above reach the fixture only as a filesystem_read STRING path, which the module-graph facts walk (build_module_graph_facts_live) does not treat as a reference edge — a string is not an import. This test calls vacuity_self_application_probe directly, a real compile-time symbol reference that registers the edge, so the fixture module is reached by a discovered floor witness rather than only read as bytes."

test fn vacuity_consumer_witness_fixture_module_reached_by_direct_call() -> Bool {
  (vacuity_self_application_probe(tag: VacuitySelfApplicationProbeYes) == true)
    && (vacuity_self_application_probe(tag: VacuitySelfApplicationProbeNo) == false)
}

test fn vacuity_consumer_witness_real_test_fn_gap_stays_unknown_by_execution() -> Bool {
  vacuity_evidence_eq(
    a: classify_unified_test_claim_vacuity(
      claim: BoolWitnessClaim {
        witness: BoolWitness {
          entry: "src/v2/lens/vacuity_test.dag",
          function: ^vacuity_falsification_suite_nonempty
        }
      },
      lhs_provenance: OperandProvenanceUnknown,
      rhs_provenance: OperandProvenanceUnknown,
      operand_provenance: OperandProvenanceUnknown
    ),
    b: Unknown
  )
}

test fn vacuity_consumer_witness_pr7614_shape_red_control_classifies_proven_duplicate() -> Bool {
  vacuity_evidence_eq(
    a: classify_vacuity_same_eval_record(
      record: VacuityEvidenceRecord {
        subject: EqualityOperands,
        transport: EvalOnly,
        lhs_provenance: LiveSurfaceSnapshot,
        rhs_provenance: LiteralOracle,
        operands_structurally_equal: true
      }
    ),
    b: ProvenDuplicate
  )
}
