  QualifiedName,
  declaration_reference_node,
  declaration_reference_path_optional,
  parameter_reference_node,
  parameter_reference_path_optional,
  qualified_name_from_dotted_string
}
import v2.std.resolution_policy { NamespaceOnlyY }
import v2.std.symbol_index { empty_symbol_index, symbol_index_lookup }
import v2.std.text { String }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A NAMED FN'S PARAMETER IS A PATH-KEYED REFERENCE; EVERY OTHER BINDER STAYS LEXICAL.
// v2.compiler.resolve builds a ParameterFrame over the domain of an Arrow the containment walk reaches
// (resolve_arrow_node_in) and mints each reference it answers as parameter_reference_node over
// <fn path>.<label>, verified against the symbol index (resolve_frame_bound_reference). A `let`,
// match-arm or lambda frame is Lexical and its binder stays the bare atom. ROUTE: rows (1)-(3) are
// source text through assemble_program_from_ingest, lowering and resolve for real, and they assert
// the ROUTE -- which carrier each reference arrives as -- not only acceptance. Rows (4)-(6) supply the
// carrier at one interface each (resolve's frame arm, eval, reference_closure); (1) is their
// inhabitance claim that resolve really emits it.

data pr_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^parameter_reference_artifact,
  file_path: "src/v2/pilot/parameter_reference_pilot.dag"
}

fn pr_assemble(src: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: DagSourceReadWitness {
        source: Medium { carried: src, fidelity: Lossless },
        artifact: pr_artifact,
        compilation_unit: ^parameter_reference_cu,
        source_root: V2Tree
      },
      tail: Empty
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}

// ONE PROGRAM, EVERY ROUTE CASE, ONE FRONT END. Each route row asks a different question of the SAME
// resolved program, so the program is resolved once by a nullary producer the floor serves warm
// (v2.workflow.floor_pure_producer_share), and each row reads only the portable values it inspects:
// the parameter-reference paths, and the grounded and declared types at two paths.
data pr_program_source: String = "module p\n\nfn positive(x: Int) -> Bool { true }\n\ntype Pos = Int where positive\n\nfn f(x: Pos) -> Pos {\n  x\n}\n\nfn g(x: Int) -> Int {\n  x\n}\n\nfn h(x: Int) -> Int {\n  let x = 1\n  x\n}\n\nfn k(a: Int) -> fn(Int) -> Int {\n  fn(y) { y }\n}\n"

// Every parameter-reference path in the resolved program, in walk order; a refused program answers
// Absent, which no row reads as "no parameter references".
fn pr_program_parameter_paths() -> Optional<FreeMonoid<QualifiedName>> {
  match pr_assemble(src: pr_program_source) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: t, diagnostics: _ } =>
      optional_present(value: fold(node_subtree_nodes(root: t.root), init: Empty, f: fn(acc, n) {
        match parameter_reference_path_optional(node: n) {
          Present { value: path } => list_snoc_item(xs: acc, item: path)
          Absent => acc
        }
      }))
  }
}

fn pr_qn(dotted: String) -> QualifiedName {
  qualified_name_from_dotted_string(dotted: dotted)
}

fn pr_paths_hold(pred: fn(FreeMonoid<QualifiedName>) -> Bool) -> Bool {
  match pr_program_parameter_paths() {
    Present { value: paths } => pred(paths)
    Absent => false
  }
}

fn pr_paths_contain(paths: FreeMonoid<QualifiedName>, path: QualifiedName) -> Bool {
  fold(paths, init: false, f: fn(acc, q) { acc || (q == path) })
}

// (1) BESIDE fn positive(x: Int), `x` IN fn f(x: Pos) AND fn g(x: Int) ARE EACH FN'S OWN PARAMETER, BY
// PATH. positive's body does not mention x, so no p.positive.x appears -- the scope search this
// replaces walked the tree for the first Arrow naming `x`.
test fn pr_named_fn_parameter_is_a_parameter_reference_holds() -> Bool {
  pr_paths_hold(pred: fn(paths) {
    pr_paths_contain(paths: paths, path: pr_qn(dotted: "p.f.x"))
      && pr_paths_contain(paths: paths, path: pr_qn(dotted: "p.g.x"))
      && !pr_paths_contain(paths: paths, path: pr_qn(dotted: "p.positive.x"))
  })
}

// (2) A `let` NAMED LIKE A PARAMETER STILL BINDS LEXICALLY. h's body `x` is the let binder, so no
// p.h.x is minted: had the ParameterFrame answered it, p.h.x would appear.
test fn pr_let_shadowing_a_parameter_binds_lexically_holds() -> Bool {
  pr_paths_hold(pred: fn(paths) { !pr_paths_contain(paths: paths, path: pr_qn(dotted: "p.h.x")) })
}

// (3) A LAMBDA'S PARAMETER STAYS ON THE LEXICAL ROUTE. Its Arrow is met below k's body, so its frame is
// Lexical and resolve mints nothing under k (the declared frontier on v2.compiler.resolve FrameKind).
test fn pr_lambda_parameter_binds_lexically_holds() -> Bool {
  pr_paths_hold(pred: fn(paths) {
    !pr_paths_contain(paths: paths, path: pr_qn(dotted: "p.k.y"))
      && !pr_paths_contain(paths: paths, path: pr_qn(dotted: "p.k.a"))
  })
}

// (4) A PARAMETER FRAME WHOSE PATH THE INDEX DOES NOT HOLD REFUSES AT RESOLVE, never falls back to the
// bare atom. The frame is supplied (ParameterFrame over m.f, index empty), which is exactly the
// disagreement between resolve's containment position and the fill that the refusal guards; the
// Lexical twin over the same name accepts, so the red is the kind, not the name.
fn pr_ctx(kind: FrameKind) -> ResolveContext {
  let namespace = Namespace {
    bindings: empty_map(),
    canonical_symbols: empty_canonical_symbol_set(),
    symbol_index: empty_symbol_index(),
    module_qn: pr_qn(dotted: "m"),
    test_code: test_code_index_empty(),
    declared_in: pr_qn(dotted: "m"),
    imported_origins: empty_map()
  }
  ResolveContext {
    scope: ScopeFrame {
      locals: map_insert(empty_map(), ^pr_x, ^pr_x),
      outer: scope_from_namespace(namespace: namespace),
      kind: kind
    },
    type_scope: scope_from_namespace(namespace: namespace),
    namespace: namespace,
    policy: NamespaceOnlyY,
    position: pr_qn(dotted: "m"),
    lm: dag_language_model(),
    under_module_root: false,
    declaring: NotDeclaring
  }
}

data pr_x_atom: Node = Node { kind: TypeNode { connective: Atom { identity: ^pr_x } }, children: [], occurrence_id: OccurrenceSynthetic }

test fn pr_unindexed_parameter_path_refuses_at_resolve_holds() -> Bool {
  let refused = match resolve_node(ctx: pr_ctx(kind: ParameterFrame { arrow_path: pr_qn(dotted: "m.f") }), n: pr_x_atom) {
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == ^resolve_reason_parameter_path_not_indexed
    Accepted { value: _, diagnostics: _ } => false
  }
  let lexical_accepts = match resolve_node(ctx: pr_ctx(kind: LexicalFrame), n: pr_x_atom) {
    Accepted { value: v, diagnostics: _ } => v == pr_x_atom
    Rejected { diagnostics: _ } => false
  }
  refused && lexical_accepts
}

// (5) EVAL REFUSES A PARAMETER REFERENCE, TYPED AND LOCATED, AND DOES NOT KEY IT BY ITS LEAF. The
// environment binds the leaf `x`; a fall back to the old label keying would find it and answer. The
// refusal stands until gunbc#12506's named-call route evaluates a declared fn body over resolver
// output (the declared frontier on v2.compiler.eval eval_type_node_atom).
fn pr_facts_lookup(key: Node) -> Optional<InferredFacts> {
  optional_present(value: claim_inferred_facts_from_nodes(
    resolved: key,
    algebra: key,
    descent: termination_proof_witness_for_node(n: key)
  ))
}

test fn pr_eval_refuses_a_parameter_reference_holds() -> Bool {
  let reference = parameter_reference_node(qn: pr_qn(dotted: "p.f.x"), occurrence_id: OccurrenceSynthetic)
  match eval_with_context(
    tree: InferredTree { root: reference, facts: PartialFunction { lookup: pr_facts_lookup } },
    context: eval_context_with_semantics(
      runtime_identity: ^parameter_reference_runtime_id,
      interpretation: v2_evaluator_interpretation(),
      structure_witness: v2_evaluator_interpretation_structure_witness()
    ),
    inputs: inputs_root_only(root: reference)
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^eval_rejected_parameter_reference_unbound
    Accepted { value: _, diagnostics: _ } => false
  }
}

// (6) A PARAMETER REFERENCE PULLS NO MODULE INTO THE REFERENCE CLOSURE; a declaration reference beside
// it does. The two differ only in their marker, so the red is the kind.
test fn pr_parameter_reference_pulls_no_module_holds() -> Bool {
  let parameter = parameter_reference_node(qn: pr_qn(dotted: "q.f.x"), occurrence_id: OccurrenceSynthetic)
  let declaration = declaration_reference_node(qn: pr_qn(dotted: "q.T"), occurrence_id: OccurrenceSynthetic)
  (reference_closure_declaring_paths(n: parameter, acc: Empty) == Empty)
    && (reference_closure_declaring_paths(n: declaration, acc: Empty) == Cons { head: pr_qn(dotted: "q.T"), tail: Empty })
}

// (7) THE TWO MARKERS NEVER READ AS EACH OTHER: one path, two carriers, two readers.
test fn pr_parameter_and_declaration_markers_are_disjoint_holds() -> Bool {
  let path = pr_qn(dotted: "q.f.x")
  let parameter = parameter_reference_node(qn: path, occurrence_id: OccurrenceSynthetic)
  let declaration = declaration_reference_node(qn: path, occurrence_id: OccurrenceSynthetic)
  (parameter_reference_path_optional(node: parameter) == optional_present(value: path))
    && (declaration_reference_path_optional(node: parameter) == Absent)
    && (declaration_reference_path_optional(node: declaration) == optional_present(value: path))
    && (parameter_reference_path_optional(node: declaration) == Absent)
}


// (8) THE GROUNDING, THROUGH THE INDEX: `x` in fn f(x: Pos) grounds as exactly the resolved declared
// type the index holds at p.f.x, `x` in fn g(x: Int) as the one at p.g.x, and the two differ -- the
// unscoped walk once answered positive's Int for f. Real ingest, resolve and infer, once, served warm.
type PrGrounding {
  f_grounded: Optional<Node>
  g_grounded: Optional<Node>
  f_declared: Optional<Node>
  g_declared: Optional<Node>
}

fn pr_grounded_in(inferred: InferredTree, path: QualifiedName) -> Optional<Node> {
  fold(node_subtree_nodes(root: inferred.root), init: Absent, f: fn(acc, n) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if parameter_reference_path_optional(node: n) == optional_present(value: path) {
          match inferred_facts_witness_for_node(tree: inferred, node: n) {
            Holds { value: facts } =>
              match inferred_facts_resolved_type(facts: facts) {
                Holds { value: ty } => optional_present(value: ty)
                Violates { diagnostic: _ } => Absent
              }
            Violates { diagnostic: _ } => Absent
          }
        } else { acc }
    }
  })
}

fn pr_program_grounding() -> PrGrounding {
  let ungrounded = PrGrounding { f_grounded: Absent, g_grounded: Absent, f_declared: Absent, g_declared: Absent }
  match pr_assemble(src: pr_program_source) {
    Rejected { diagnostics: _ } => ungrounded
    Accepted { value: resolved, diagnostics: _ } =>
      match infer_and_discharge(tree: resolved) {
        Rejected { diagnostics: _ } => ungrounded
        Accepted { value: inferred, diagnostics: _ } =>
          PrGrounding {
            f_grounded: pr_grounded_in(inferred: inferred, path: pr_qn(dotted: "p.f.x")),
            g_grounded: pr_grounded_in(inferred: inferred, path: pr_qn(dotted: "p.g.x")),
            f_declared: symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: pr_qn(dotted: "p.f.x")),
            g_declared: symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: pr_qn(dotted: "p.g.x"))
          }
      }
  }
}

test fn pr_parameter_grounds_through_the_index_holds() -> Bool {
  let g = pr_program_grounding()
  match g.f_grounded {
    Present { value: _ } =>
      (g.f_grounded == g.f_declared) && (g.g_grounded == g.g_declared) && (g.f_grounded != g.g_grounded)
    Absent => false
  }
}
