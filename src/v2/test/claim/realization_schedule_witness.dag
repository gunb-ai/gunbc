module v2.test.claim.realization_schedule_witness

import v2.std.algebra { list_snoc_item }
import v2.std.collection { List }
import std.realization {
  RealizationPlan,
  RealizationObjective,
  Runnable,
  schedule_lens_verdict_for_ci_floor,
  schedule_generates_identical_schedule,
  schedule_eq,
  cost_account_predicted_zero,
}
import v2.workflow.ci_floor_plan {
  gunbc_ci_floor_realization_plan,
  gunbc_ci_floor_batches,
  gunbc_ci_floor_schedule_inner,
  ci_floor_target_digest,
  ci_floor_compile_gate_fn,
}
import v2.workflow.compile_clean_shard_roster { compile_clean_sharding_enabled }

fn witness_batches_are_plan_schedule() -> Bool {
  schedule_generates_identical_schedule(
    plan: gunbc_ci_floor_realization_plan(),
    schedule: gunbc_ci_floor_batches()
  )
}

fn witness_batches_identical_to_inner_schedule() -> Bool {
  schedule_eq(
    left: gunbc_ci_floor_batches(),
    right: gunbc_ci_floor_schedule_inner()
  )
}

fn witness_schedule_lens_holds_on_floor_plan() -> Bool {
  match schedule_lens_verdict_for_ci_floor(
    plan: gunbc_ci_floor_realization_plan(),
    compile_gate_fn: ci_floor_compile_gate_fn,
    compile_clean_sharded: compile_clean_sharding_enabled()
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn perturbed_schedule_wrong_order(inner: List<List<Runnable>>) -> List<List<Runnable>> {
  list_snoc_item(
    xs: list_snoc_item(xs: [], item: inner.skip(n: 1).first()),
    item: inner.first()
  )
}

fn witness_schedule_lens_red_when_corpus_runs_first_on_live_floor() -> Bool {
  let inner = gunbc_ci_floor_schedule_inner()
  let perturbed = RealizationPlan {
    target: ci_floor_target_digest
    objective: RealizationObjective { goals: [] }
    schedule: perturbed_schedule_wrong_order(inner: inner)
    total: cost_account_predicted_zero()
  }
  match schedule_lens_verdict_for_ci_floor(plan: perturbed, compile_gate_fn: ci_floor_compile_gate_fn, compile_clean_sharded: compile_clean_sharding_enabled()) {
    Holds => false
    Violation { diagnostic: _ } => true
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn realization_schedule_witnesses() -> Bool {
  witness_batches_are_plan_schedule()
    && witness_batches_identical_to_inner_schedule()
    && witness_schedule_lens_holds_on_floor_plan()
    && witness_schedule_lens_red_when_corpus_runs_first_on_live_floor()
}
