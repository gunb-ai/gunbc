module v2.test.claim.compiler.optional_layers

import std.types { Bool }
import std.algebra { Empty, list_at_optional }
import std.optional { Absent, Present }
import std.nat { Zero }
import v2.std.optional_layers {
  OccupancyWrapperMalformed,
  TypeNodeOccupancy,
  one_optional_layer,
  two_optional_layers,
  type_node_occupancy_read,
  wrap_type_node_occupancy
}
import std.occurrence_identity { OccurrenceSynthetic }
import v2.compiler.infer {
  InferFormalMatched,
  InferFormalShapeMismatch,
  infer_match_generic_formal,
  infer_type_head_and_args,
  infer_type_instantiated
}
import v2.std.inhabitance {
  DeclaredTypeObligation,
  InhabitanceRefused,
  InhabitanceUndecidable,
  Inhabits,
  RefusalComparisonCouldNotRun,
  RefusalStructuralMismatch,
  RefusalWitnessSearchDecision,
  declared_type_inhabitance,
  inhabitance_pair_undecidable_reason,
  inhabitance_refusal_diagnostic
}
import v2.std.diagnostic { Diagnostic, PositionDirectCallArgument, Suggested, Unavailable }
import v2.std.symbol_index { empty_symbol_index }

import v2.std.node { node_same_occurrence, Atom, ComputationNode, Edge, Instantiation, Node, Positional, Symbol, TypeNode, NotADeclaration }
import v2.std.list_introduction { list_introduction_head_path }
import v2.std.qualified_name { declaration_reference_node, optional_declaration_identity }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ol_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn ol_list_of(element: Node) -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: declaration_reference_node(qn: list_introduction_head_path(), occurrence_id: OccurrenceSynthetic), declaration: NotADeclaration },
      Edge { label: Positional, target: element, declaration: NotADeclaration }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn ol_obligation(declared: Node, produced: Node) -> DeclaredTypeObligation {
  DeclaredTypeObligation {
    position: PositionDirectCallArgument { argument_ordinal_path: [] },
    parameter_identity: ^ol_param,
    declared: declared,
    produced: produced,
    produced_declared_carrier: Absent,
    application: ol_atom(id: ^ol_app),
    type_variables: []
  }
}

test fn a_nested_occupancy_tree_reads_as_two_layers() -> Bool {
  match type_node_occupancy_read(n: wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: two_optional_layers())) {
    TypeNodeOccupancy { depth: c, base: b } =>
      c == two_optional_layers()
        && (match b.kind {
          TypeNode { connective: Atom { identity: id } } => id == ^ol_int
          TypeNode { connective: _ } => false
          ComputationNode { behavior: _ } => false
        })
    OccupancyWrapperMalformed { wrapper: _ } => false
  }
}

test fn wrapping_required_is_the_base() -> Bool {
  node_same_occurrence(a: wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: Zero), b: ol_atom(id: ^ol_int))
}

fn ol_malformed_occupancy() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: declaration_reference_node(qn: optional_declaration_identity(), occurrence_id: OccurrenceSynthetic), declaration: NotADeclaration }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

test fn a_malformed_occupancy_wrapper_refuses() -> Bool {
  match type_node_occupancy_read(n: ol_malformed_occupancy()) {
    OccupancyWrapperMalformed { wrapper: _ } => true
    TypeNodeOccupancy { depth: _, base: _ } => false
  }
}

test fn a_malformed_occupancy_wrapper_is_refused_at_inhabitance() -> Bool {
  let one = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: one_optional_layer())
  match declared_type_inhabitance(obligation: ol_obligation(declared: ol_malformed_occupancy(), produced: one)) {
    InhabitanceRefused { find_witness_reason: r, refusal_class: _ } => r == ^inhabitance_optional_layer_wrapper_malformed
    Inhabits { homomorphism: _ } => false
    InhabitanceUndecidable { reason: _ } => false
  }
}

// Container identity (gunbc#13330 in v2): unify reads Instantiation arguments, never the
// Instantiation node and never a child that only spells the parameter.
// RED FOR REVIEW 92072, AND UNEXECUTED: the gate does not compile claim modules (gunbc.rung_drop), so this
// row is a source-derived prediction until a claim run observes it. A malformed occupancy wrapper is not a
// type error. inhabitance_optional_layer_judgement answers OptionalLayerWrapperMalformed exactly where
// type_node_occupancy_read cannot read an occupancy at all -- an input that is not a well-formed node -- the
// same family inhabitance_structural_decision puts in RefusalComparisonCouldNotRun, which that classifier
// describes as never a claim that the value's type is wrong. Before the fix the refusal site hand-paired
// that reason with RefusalStructuralMismatch, so the diagnostic route handed the author a SUGGESTED NODE for
// a type error that does not exist. Every arm below binds all three declared fields of the variant: a
// pattern that binds a subset silently wildcards the rest (gunbc.recurring_failure_mode
// a_pattern_binding_a_subset_of_fields_is_an_implicit_wildcard).
test fn a_malformed_occupancy_wrapper_refuses_as_could_not_run() -> Bool {
  let one = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: one_optional_layer())
  match declared_type_inhabitance(obligation: ol_obligation(declared: ol_malformed_occupancy(), produced: one)) {
    InhabitanceRefused { find_witness_reason: r, refusal_class: RefusalComparisonCouldNotRun, position: _ } =>
      r == ^inhabitance_optional_layer_wrapper_malformed
    InhabitanceRefused { find_witness_reason: _, refusal_class: RefusalStructuralMismatch, position: _ } => false
    InhabitanceRefused { find_witness_reason: _, refusal_class: RefusalWitnessSearchDecision, position: _ } => false
    Inhabits { homomorphism: _ } => false
    InhabitanceUndecidable { reason: _ } => false
  }
}

// THE SAME REFUSAL AT THE DIAGNOSTIC, AND THE LOAD-BEARING PART: the class is read OUT of the verdict and
// handed to inhabitance_refusal_diagnostic, so this row cannot pass by choosing the class itself. A
// could-not-run refusal carries no suggested node; the author is not sent to fix a type error the compiler
// never showed. UNEXECUTED, for the reason above.
test fn a_malformed_occupancy_wrapper_diagnostic_carries_no_suggested_node() -> Bool {
  let obligation = ol_obligation(
    declared: ol_malformed_occupancy(),
    produced: wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: one_optional_layer())
  )
  match declared_type_inhabitance(obligation: obligation) {
    InhabitanceRefused { find_witness_reason: r, refusal_class: cls, position: p } =>
      match inhabitance_refusal_diagnostic(obligation: obligation, refusal_class: cls, find_witness_reason: r, position: p) {
        Diagnostic { reason: _, at: _, correction: Unavailable { reason: _ } } => true
        Diagnostic { reason: _, at: _, correction: Suggested { node: _ } } => false
      }
    Inhabits { homomorphism: _ } => false
    InhabitanceUndecidable { reason: _ } => false
  }
}

// POSITIVE CONTROL, UNEXECUTED: a depth mismatch IS a type error at this obligation, so it keeps the
// structural-mismatch class and the suggested node that carries the shape evidence. This is the arm the fix
// must not move, and it is why the fix is a reclassification of one arm rather than of the family.
test fn a_depth_mismatch_keeps_the_type_mismatch_class_and_its_suggestion() -> Bool {
  let one = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: one_optional_layer())
  let two = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: two_optional_layers())
  let obligation = ol_obligation(declared: two, produced: one)
  match inhabitance_pair_undecidable_reason(declared: two, produced: one, type_variables: []) {
    Present { value: _ } => false
    Absent =>
      match declared_type_inhabitance(obligation: obligation) {
        InhabitanceRefused { find_witness_reason: r, refusal_class: RefusalStructuralMismatch, position: p } =>
          r == ^inhabitance_optional_layer_depth_mismatch
            && (match inhabitance_refusal_diagnostic(obligation: obligation, refusal_class: RefusalStructuralMismatch, find_witness_reason: r, position: p) {
              Diagnostic { reason: _, at: _, correction: Suggested { node: _ } } => true
              Diagnostic { reason: _, at: _, correction: Unavailable { reason: _ } } => false
            })
        InhabitanceRefused { find_witness_reason: _, refusal_class: RefusalComparisonCouldNotRun, position: _ } => false
        InhabitanceRefused { find_witness_reason: _, refusal_class: RefusalWitnessSearchDecision, position: _ } => false
        Inhabits { homomorphism: _ } => false
        InhabitanceUndecidable { reason: _ } => false
      }
  }
}

// POSITIVE CONTROL, UNEXECUTED: an Optional produced where a required value is declared is a type error, so
// it keeps the structural-mismatch class. The fix moves only the malformed-wrapper pair.
test fn an_optional_at_a_required_declared_position_keeps_the_type_mismatch_class() -> Bool {
  let one = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: one_optional_layer())
  match declared_type_inhabitance(obligation: ol_obligation(declared: ol_atom(id: ^ol_int), produced: one)) {
    InhabitanceRefused { find_witness_reason: r, refusal_class: RefusalStructuralMismatch, position: _ } =>
      r == ^inhabitance_optional_produced_at_required_declared
    InhabitanceRefused { find_witness_reason: _, refusal_class: RefusalComparisonCouldNotRun, position: _ } => false
    InhabitanceRefused { find_witness_reason: _, refusal_class: RefusalWitnessSearchDecision, position: _ } => false
    Inhabits { homomorphism: _ } => false
    InhabitanceUndecidable { reason: _ } => false
  }
}

test fn container_instantiation_args_are_the_element_not_the_slot_spelling() -> Bool {
  let produced = ol_list_of(element: ol_atom(id: ^ol_int))
  match list_at_optional(xs: infer_type_head_and_args(t: produced).args, index: 0) {
    Absent => false
    Present { value: arg } =>
      match arg.kind {
        TypeNode { connective: Atom { identity: id } } => id == ^ol_int
        TypeNode { connective: _ } => false
        ComputationNode { behavior: _ } => false
      }
  }
}

test fn list_of_t_binds_t_to_the_element_type() -> Bool {
  match infer_match_generic_formal(
    formal: ol_list_of(element: ol_atom(id: ^ol_t)),
    produced: ol_list_of(element: ol_atom(id: ^ol_int)),
    type_params: [^ol_t],
    instances: Empty,
    declarations: empty_symbol_index()
  ) {
    InferFormalShapeMismatch { decision: _ } => false
    InferFormalMatched { instances: bound } =>
      node_same_occurrence(a: infer_type_instantiated(t: ol_list_of(element: ol_atom(id: ^ol_t)), instances: bound), b: ol_list_of(element: ol_atom(id: ^ol_int)))
  }
}

test fn an_int_at_a_list_formal_is_a_shape_mismatch() -> Bool {
  match infer_match_generic_formal(
    formal: ol_list_of(element: ol_atom(id: ^ol_t)),
    produced: ol_atom(id: ^ol_int),
    type_params: [^ol_t],
    instances: Empty,
    declarations: empty_symbol_index()
  ) {
    InferFormalShapeMismatch { decision: _ } => true
    InferFormalMatched { instances: _ } => false
  }
}

test fn optional_t_matches_optional_int_and_binds_t() -> Bool {
  let formal = wrap_type_node_occupancy(base: ol_atom(id: ^ol_t), depth: one_optional_layer())
  let produced = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: one_optional_layer())
  match infer_match_generic_formal(
    formal: formal,
    produced: produced,
    type_params: [^ol_t],
    instances: Empty,
    declarations: empty_symbol_index()
  ) {
    InferFormalShapeMismatch { decision: _ } => false
    InferFormalMatched { instances: bound } =>
      node_same_occurrence(a: infer_type_instantiated(t: formal, instances: bound), b: produced)
  }
}

test fn substituting_u_optional_into_t_optional_composes_two_layers() -> Bool {
  let formal = wrap_type_node_occupancy(base: ol_atom(id: ^ol_t), depth: one_optional_layer())
  let u_opt = wrap_type_node_occupancy(base: ol_atom(id: ^ol_u), depth: one_optional_layer())
  match infer_match_generic_formal(
    formal: formal,
    produced: wrap_type_node_occupancy(base: u_opt, depth: one_optional_layer()),
    type_params: [^ol_t],
    instances: Empty,
    declarations: empty_symbol_index()
  ) {
    InferFormalShapeMismatch { decision: _ } => false
    InferFormalMatched { instances: bound } =>
      node_same_occurrence(a: infer_type_instantiated(t: formal, instances: bound), b: wrap_type_node_occupancy(base: ol_atom(id: ^ol_u), depth: two_optional_layers()))
  }
}

test fn one_optional_layer_does_not_match_a_required_int() -> Bool {
  match infer_match_generic_formal(
    formal: wrap_type_node_occupancy(base: ol_atom(id: ^ol_t), depth: one_optional_layer()),
    produced: ol_atom(id: ^ol_int),
    type_params: [^ol_t],
    instances: Empty,
    declarations: empty_symbol_index()
  ) {
    InferFormalShapeMismatch { decision: _ } => true
    InferFormalMatched { instances: _ } => false
  }
}

test fn two_optional_layers_are_not_one_at_inhabitance() -> Bool {
  let one = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: one_optional_layer())
  let two = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: two_optional_layers())
  match inhabitance_pair_undecidable_reason(declared: one, produced: two, type_variables: []) {
    Absent =>
      match declared_type_inhabitance(obligation: ol_obligation(declared: one, produced: two)) {
        InhabitanceRefused { find_witness_reason: r, refusal_class: _ } => r == ^inhabitance_optional_layer_depth_mismatch
        Inhabits { homomorphism: _ } => false
        InhabitanceUndecidable { reason: _ } => false
      }
    Present { value: _ } => false
  }
}

test fn matching_optional_depths_are_decidable_not_a_collapsed_carrier() -> Bool {
  let one = wrap_type_node_occupancy(base: ol_atom(id: ^ol_int), depth: one_optional_layer())
  match inhabitance_pair_undecidable_reason(declared: one, produced: one, type_variables: []) {
    Absent =>
      match declared_type_inhabitance(obligation: ol_obligation(declared: one, produced: one)) {
        Inhabits { homomorphism: _ } => true
        InhabitanceRefused { find_witness_reason: _, refusal_class: _ } => false
        InhabitanceUndecidable { reason: _ } => false
      }
    Present { value: _ } => false
  }
}
