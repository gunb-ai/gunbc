// lacked application_ -- the label's OWN prefix -- so any application-shaped fatal PASSed the
// four-family none trivially; see msg_daeba408).
test fn nam_c_fatal_family_is_still_none() -> Bool {
  (!(nam_any_family(x: nam_c_reason()))) && (nam_c_reason() != "ACCEPTED") && (nam_c_reason() != "RESOLVE_REFUSED")
}
