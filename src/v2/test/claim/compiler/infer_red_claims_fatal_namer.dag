// CONTROL: at least one candidate must match. FAIL here (with all == claims FAIL) => the set is
// still too narrow -- report and widen, do not conclude 'no fatal'.
test fn nam_a_fatal_is_in_the_candidate_set() -> Bool {
  nam_in_set(x: nam_a_reason())
}

// ACCEPTED as a first-class name: PASS here + all nam_*_fatal_is_* FAIL means the tree is now
// accepted (the regression-shaped world for (a)); with the probe's rp_a_is_not_accepted PASS it
// cannot be, but the namer reads self-contained.
test fn nam_a_reason_is_accepted() -> Bool {
  nam_a_reason() == "ACCEPTED"
}

// (c) gets the same set (its counted-frontier disappearance suggests the judge now ANSWERS where it
// once counted; whatever it answers must name itself).
test fn nam_c_reason_is_accepted() -> Bool {
  nam_c_reason() == "ACCEPTED"
}

test fn nam_c_fatal_is_the_label() -> Bool {
