}

// ---- CLAIM (b): bare Int at an Int? formal, bisected to #14644 (the Optional stack) ----
// THE STANDING HYPOTHESIS, to be falsified or confirmed by this run: #14644 did NOT accept the
// bare literal (a silent widen would be the regression M3's prior expects); it refuses it with the
// NEW typed reason infer_literal_at_optional_is_not_present -- already pinned green by the source-
// route sibling v2.test.claim.compiler.infer_arm_close_witness rc8_declared_formal_bare_literal_-
// refuses ("no implicit lift", per explicit_present_is_the_authoring_policy). If nam_b_fatal_is_-
// literal_at_optional PASSes and nam_b_reason_is_accepted FAILs, (b) is FIXTURE DRIFT: the claim
// still asserts the pre-#14644 label while the tree now refuses with the correct ruling-aligned
// reason. If nam_b_reason_is_accepted PASSes, it is the silent-widen REGRESSION and gets its own
// RED. The tree and predicate are identical to claim (b)'s body (iaai_resolved_with_optional over
// inhabitance_optional_formal_tree, then infer, then the fatal).
fn nam_b_reason() -> String {
  match iaai_resolved_with_optional(root: inhabitance_optional_formal_tree()) {
    Rejected { diagnostics: _ } => "RESOLVE_REFUSED"
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Accepted { value: _, diagnostics: _ } => "ACCEPTED"
        Rejected { diagnostics: d } => nam_fatal_sym(d: d)
      }
  }
}

test fn nam_b_reason_is_accepted() -> Bool {
  nam_b_reason() == "ACCEPTED"
}

