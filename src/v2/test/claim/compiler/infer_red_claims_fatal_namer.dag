// FAMILY PARTITION (belt for the narrow set): the reason symbols mintable through the pipeline are
// ~430 across the compiler (measured), so 14 exact candidates may all miss. These prefix claims
// partition the space; whichever family claim PASSes names where to widen for the second run, so a
// run is never wasted on 'nothing matched'. The families are disjoint by prefix.
fn nam_starts(x: String, prefix: String) -> Bool {
  starts_with(s: x, prefix: prefix)
}

test fn nam_a_fatal_family_is_inhabitance() -> Bool {
  nam_starts(x: nam_a_reason(), prefix: "inhabitance_")
}

test fn nam_a_fatal_family_is_infer() -> Bool {
  nam_starts(x: nam_a_reason(), prefix: "infer_")
}

test fn nam_a_fatal_family_is_resolve() -> Bool {
  nam_starts(x: nam_a_reason(), prefix: "resolve")
}

test fn nam_a_fatal_family_is_body_lowering() -> Bool {
  nam_starts(x: nam_a_reason(), prefix: "body_lowering_")
}

test fn nam_a_fatal_family_is_none() -> Bool {
  (!(nam_starts(x: nam_a_reason(), prefix: "inhabitance_"))) && (!(nam_starts(x: nam_a_reason(), prefix: "infer_"))) && (!(nam_starts(x: nam_a_reason(), prefix: "resolve"))) && (!(nam_starts(x: nam_a_reason(), prefix: "body_lowering_"))) && (nam_a_reason() != "ACCEPTED")
}

test fn nam_c_fatal_family_is_inhabitance() -> Bool {
  nam_starts(x: nam_c_reason(), prefix: "inhabitance_")
}

test fn nam_c_fatal_family_is_infer() -> Bool {
  nam_starts(x: nam_c_reason(), prefix: "infer_")
