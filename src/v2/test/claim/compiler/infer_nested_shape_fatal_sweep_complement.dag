module v2.test.claim.compiler.infer_nested_shape_fatal_sweep_complement

// SEAT 16, SCRATCH (never-merge branch; claims only; nothing here lands). Round 9, the
// COMPLEMENT SAFETY-NET to round 8 (c56fbe05e8e8, run pending with M3). Round 8's universe
// harvested reason: ^... / cause: ^... LITERALS only -- but 19 mint sites in the same closure
// pass a reason through a HELPER whose Symbol comes from a match arm elsewhere
// (inhabitance_undecidable_reason_symbol, inhabitance_application_refusal_reason, the
// application_parameter_order_*_reason pair, parse/resolve/tokenize refusal-symbol matchers),
// so their lexemes reach diagnostics WITHOUT a reason:/cause: literal. This module takes the
// COMPLEMENT: every bare ^symbol appearing anywhere in the 161-file transitive import closure
// of the tree route that is NOT in round 8's 509-name literal set (1381 names, same python
// procedure, cited by method). If round 8 lands a bucket, this module is moot; if round 8's
// universe FAILs, this nets out whether the extraction is suspect or the universe was narrow.
// Tree imports the claim's OWN builders (byte-identical to c8cc1df9c8d1).

import v2.test.lens_common.infer_fixture { claim_resolved_tree_without_declarations }
import v2.compiler.infer { infer }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Rejected, diagnostics_fatal_reason }
import v2.std.node { symbol_lexeme }
import v2.std.text { String }
import std.types { List }
import std.algebra { contains }
import v2.test.claim.compiler.infer_application_argument_inhabitance_witness {
  inhabitance_arrow_formal_tree_minted_codomain,
  inhabitance_generic_formal_tree_over
}

fn nsc_fatal_sym(d: NonEmptyDiagnostics) -> String {
  symbol_lexeme(sym: diagnostics_fatal_reason(d: d))
}

fn nsc_reason() -> String {
  match infer(tree: claim_resolved_tree_without_declarations(
    root: inhabitance_generic_formal_tree_over(
      declared: inhabitance_arrow_formal_tree_minted_codomain()
    )
  )) {
    Accepted { value: _, diagnostics: _ } => "ACCEPTED"
    Rejected { diagnostics: d } => nsc_fatal_sym(d: d)
  }
}

fn nsc_eq(a: String, b: String) -> Bool {
  a == b
}

data nsc_bucket_1: List<String> = [
  "0",
  "10",
  "127",
  "2",
  "3",
  "32",
  "62",
  "63"
]
fn nsc_bucket_1() -> Bool {
  contains(xs: nsc_bucket_1, item: nsc_reason(), eq: nsc_eq)
}
test fn nsc_bucket_1_holds() -> Bool {
  nsc_bucket_1()
}

