module v2.test.claim.compiler.collection_concat_realization

import v2.compiler.fold_lowering { CollectionRosterRow, NotARosterPrimitiveCallRow, RosterFreeMonoidPrimitiveCall, RosterPrimitiveCallSignature, RosterPrimitiveCallSignatureUnreadable, collection_roster_primitive_call_row_optional, collection_roster_primitive_call_signature_at, collection_roster_signature_arrow }
import v2.compiler.infer { InferFormalMatched, InferFormalShapeMismatch, infer_formals_from_domain, infer_match_generic_formal, infer_type_instantiated }
import v2.test.claim.compiler.infer_fold_member_instance { fmi_assemble, fmi_infer_tree, fmi_reason }
import std.types { Bool, List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.qualified_name { declaration_reference_node, declaration_reference_path_optional, parameter_reference_path_optional, qualified_name_last_segment, qualified_name_to_dotted_string }
import v2.std.optional { Absent, Optional, Present }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Atom, Edge, Instantiation, Node, Positional, TypeNode, node_subtree_nodes, node_synthetic, symbol_intern_lexeme }
import v2.std.node_query { node_positional_child_targets }
import v2.std.collection { list_at_optional }
import v2.std.symbol_index { empty_symbol_index }
import v2.std.list_introduction { list_introduction_head_path }
import v2.extdeps.languages.dag { dag_binding_denotation }
import std.occurrence_identity { OccurrenceSynthetic }
import std.primitives { CarrierSensitive, concat_contract }
import std.algebra { Cons, Empty, NamedTemplate }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: a bare `concat` whose name no declaration claims binds to the std.algebra collection roster's
// primitive-call row (collection_concat_shape) through v2.compiler.resolve resolve_atom_unscoped, and v2.compiler.infer
// types the call BY THAT ROW (v2.compiler.fold_lowering collection_roster_signature_arrow).
//
// SHAPE, PER DESIGN SECTION 3's WITNESS RULE (sharp-raven-357): exactly ONE claim runs the real route -- assemble plus
// infer on a source that exercises it (cca_route_runs_on_the_real_path). Every other claim supplies its input at ONE
// interface: the row's signature, read through the production projection and the production matcher
// (v2.compiler.infer infer_match_generic_formal, gunbc#13187), never by re-assembling a module. The two refusals (an
// Int operand, a mismatched element) are the matcher's and the judge's own subject, controlled by
// v2.test.claim.compiler.generic_formal_instantiation; here they are asked of THIS route's formal, so the claims say
// the route presents the shape that subject decides.
//
// DELETING THE ROUTE REDS THE REAL-PATH CLAIM: remove the concat row from collection_roster_rows and `concat(` is
// refused resolve_reason_unbound_symbol, so assembly refuses and the reading is false (mutation run cited in the PR).

// The ONE real-path fixture. f joins two lists through the row; g's parameter is spelled `concat`, so its use must bind
// the parameter -- any binding of the name precedes the roster, which resolve asks last -- never the row.
data cca_route_source: String = "module p\n\nimport v2.std.collection { List }\n\ntype Pair {\n  target: Int\n}\n\nfn f(a: List<Pair>, b: List<Pair>) -> List<Pair> {\n  concat(a, b)\n}\n\nfn g(concat: Int) -> Int {\n  concat\n}\n"

data cca_row_path: String = "std.algebra.collection_concat_shape"

type CcaRouteReading {
  row_references: Int
  parameter_named_concat_bound: Bool
  infer_accepted: Bool
}

fn cca_route_reading() -> CcaRouteReading {
  match fmi_assemble(src: cca_route_source) {
    Rejected { diagnostics: _ } => CcaRouteReading { row_references: 0, parameter_named_concat_bound: false, infer_accepted: false }
    Accepted { value: tree, diagnostics: _ } =>
      CcaRouteReading {
        row_references: fold(node_subtree_nodes(root: tree.root), init: 0, f: fn(acc, n) {
          match declaration_reference_path_optional(node: n) {
            Present { value: p } => if qualified_name_to_dotted_string(qn: p) == cca_row_path { acc + 1 } else { acc }
            Absent => acc
          }
        }),
        parameter_named_concat_bound: fold(node_subtree_nodes(root: tree.root), init: false, f: fn(acc, n) {
          acc || (match parameter_reference_path_optional(node: n) {
            Present { value: p } =>
              match qualified_name_last_segment(qn: p) {
                Present { value: leaf } => leaf == ^concat
                Absent => false
              }
            Absent => false
          })
        }),
        infer_accepted: fmi_reason(o: fmi_infer_tree(tree: tree)) == ^accepted
      }
  }
}

// THE REAL PATH: f's head binds the row (exactly once -- g's `concat` does not), g's `concat` is its parameter, and
// infer accepts the module.
test fn cca_route_runs_on_the_real_path() -> Bool {
  let r = cca_route_reading()
  r.row_references == 1 && r.parameter_named_concat_bound && r.infer_accepted
}

// SUPPLIED INPUT: the row's signature formals, through the production projection and reader.
fn cca_formals() -> List<Node> {
  match collection_roster_primitive_call_row_optional(head: ^concat) {
    Absent => Empty
    Present { value: row } =>
      match collection_roster_signature_arrow(row: row) {
        Absent => Empty
        Present { value: arrow } =>
          match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
            Absent => Empty
            Present { value: domain } =>
              match infer_formals_from_domain(domain: domain) {
                Absent => Empty
                Present { value: formals } => fold(formals, init: Empty, f: fn(acc, formal) { Cons { head: formal.declared, tail: acc } })
              }
          }
      }
  }
}

fn cca_int_type() -> Node {
  match dag_binding_denotation(sym: ^dag_binding_type_int) {
    Present { value: t } => t
    Absent => node_synthetic(kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } }, children: [])
  }
}

fn cca_pair_type() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^cca_pair } }, children: [])
}

fn cca_list_of(element: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: declaration_reference_node(qn: list_introduction_head_path(), occurrence_id: OccurrenceSynthetic) },
      Edge { label: Positional, target: element }
    ]
  )
}

fn cca_is_instantiation(t: Node) -> Bool {
  match t.kind {
    TypeNode { connective: Instantiation } => true
    TypeNode { connective: _ } => false
    _ => false
  }
}

// SUPPLIED: the signature has two formals, both the one free monoid over the row's element binder.
test fn cca_signature_is_two_free_monoid_formals() -> Bool {
  match cca_formals() {
    Cons { head: a, tail: Cons { head: b, tail: Empty } } => cca_is_instantiation(t: a) && a == b
    _ => false
  }
}

// SUPPLIED, RED: an Int operand at the row's free-monoid formal is a shape mismatch to the production matcher -- the
// carrier refusal (`Int concat Int`).
test fn cca_int_operand_is_a_shape_mismatch_at_the_row_formal() -> Bool {
  match list_at_optional(xs: cca_formals(), index: 0) {
    Absent => false
    Present { value: formal } =>
      match infer_match_generic_formal(formal: formal, produced: cca_int_type(), type_params: [^collection_roster_element], instances: Empty, declarations: empty_symbol_index()) {
        InferFormalShapeMismatch => true
        InferFormalMatched { instances: _ } => false
      }
  }
}

// SUPPLIED, RED: once the first operand binds the element to Pair, the formal instantiates to List<Pair>, which is not
// a List<Int> -- the mismatched-element refusal the judge then makes.
test fn cca_mismatched_element_instantiates_to_a_different_list() -> Bool {
  match list_at_optional(xs: cca_formals(), index: 0) {
    Absent => false
    Present { value: formal } =>
      match infer_match_generic_formal(formal: formal, produced: cca_list_of(element: cca_pair_type()), type_params: [^collection_roster_element], instances: Empty, declarations: empty_symbol_index()) {
        InferFormalShapeMismatch => false
        InferFormalMatched { instances: bound } =>
          infer_type_instantiated(t: formal, instances: bound) == cca_list_of(element: cca_pair_type())
            && infer_type_instantiated(t: formal, instances: bound) != cca_list_of(element: cca_int_type())
      }
  }
}

// COST AUTHORITY: the row the head binds is the primitive whose contract is std.primitives concat_contract, and that
// contract -- not the row's ShapeLinearScan (gunbc.recurring_failure_mode primitive_operation_carries_two_cost_authorities)
// -- carries the persistent-carrier cost log(n + m).
test fn cca_bound_row_is_the_concat_primitive_at_log_cost() -> Bool {
  let row_is_concat = match collection_roster_primitive_call_row_optional(head: symbol_intern_lexeme(lexeme: concat_contract.name)) {
    Present { value: r } => r.template.name == concat_contract.name
    Absent => false
  }
  row_is_concat && match concat_contract.carrier_cost {
    CarrierSensitive { ephemeral_work: _, persistent_work: w } => w == "log(n + m)"
    _ => false
  }
}

// SUPPLIED, THE THREE-WAY LOOKUP (review 76235): a primitive-call row's path answers its signature, and a fold row's
// path (map) answers NotARosterPrimitiveCallRow -- the indexed declaration's business. Neither may fall through to the
// row's template VALUE.
test fn cca_signature_lookup_tells_a_primitive_row_from_a_fold_row() -> Bool {
  (match collection_roster_primitive_call_signature_at(path: "std.algebra.collection_concat_shape") {
    RosterPrimitiveCallSignature { arrow: _ } => true
    RosterPrimitiveCallSignatureUnreadable => false
    NotARosterPrimitiveCallRow => false
  }) && (match collection_roster_primitive_call_signature_at(path: "std.algebra.collection_map_shape") {
    NotARosterPrimitiveCallRow => true
    RosterPrimitiveCallSignature { arrow: _ } => false
    RosterPrimitiveCallSignatureUnreadable => false
  })
}

// SUPPLIED, RED: a primitive-call row whose template the projection cannot read (here a result named by a
// spelling no kernel row carries) yields NO signature -- the input that the lookup turns into
// RosterPrimitiveCallSignatureUnreadable and infer into a located refusal
// (infer_reason_roster_row_signature_unreadable), never a typing by the template. No live row reaches that arm today;
// this pins the projection that would feed it.
test fn cca_unreadable_template_yields_no_signature() -> Bool {
  let row = CollectionRosterRow {
    head: symbol_intern_lexeme(lexeme: "cca_unreadable"),
    template: { name: "cca_unreadable", param_types: [], return_type: NamedTemplate { name: "cca_no_such_kernel_type" }, size_effect: none, cost_shape: none, callback_element_position: none },
    row: DeclarationRef { module_path: "std.algebra", decl_name: "cca_unreadable", field: WholeDeclaration },
    form: RosterFreeMonoidPrimitiveCall
  }
  match collection_roster_signature_arrow(row: row) {
    Absent => true
    Present { value: _ } => false
  }
}
