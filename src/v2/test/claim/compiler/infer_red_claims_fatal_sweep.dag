module v2.test.claim.compiler.infer_red_claims_fatal_sweep

// SEAT 16, SCRATCH SWEEP (never-merge branch; claims only; nothing here lands). Round 4 per
// M3 msg_decf6a0e: claim_batch prints PASS/FAIL only and rounds 2-3 left the (a)/(c) fatals
// OUTSIDE every exact candidate and every one of the 16 known families, so this module bisects
// the COMPLEMENT: every reason lexeme minted in v2.compiler.infer's transitive import closure
// whose prefix is not covered by the rounds 2-3 partition (194 names, produced by a python
// closure walk over the tree at this head -- the discovery procedure, cited by method). Each
// bucket membership claim uses the green contains+annotated-eq pattern (round 3); exactly one
// bucket PASSes per tree (or the universe guard FAILs, which means the fatal is OUTSIDE this
// complement and the extraction itself is suspect, not the name).

import v2.test.lens_common.infer_fixture { claim_resolved_tree_without_declarations }
import v2.compiler.infer { infer }
import v2.compiler.resolve { ResolvedTree }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Rejected, diagnostics_fatal_reason }
import v2.std.node { symbol_lexeme }
import v2.std.text { String }
import std.types { List }
import std.algebra { contains }
import v2.extdeps.languages.dag {
  dag_arrow_with_body_node,
  dag_int_literal_fixture_one,
  dag_type_atom_node
}
import v2.test.claim.compiler.infer_application_argument_inhabitance_witness {
  inhabitance_generic_formal_tree,
  inhabitance_generic_formal_tree_over,
  inhabitance_named_conj_domain
}

fn sweep_fatal_sym(d: NonEmptyDiagnostics) -> String {
  symbol_lexeme(sym: diagnostics_fatal_reason(d: d))
}

fn sweep_a_reason() -> String {
  match infer(tree: claim_resolved_tree_without_declarations(root: inhabitance_generic_formal_tree())) {
    Accepted { value: _, diagnostics: _ } => "ACCEPTED"
    Rejected { diagnostics: d } => sweep_fatal_sym(d: d)
  }
}

fn sweep_c_tree() -> ResolvedTree {
  claim_resolved_tree_without_declarations(
    root: inhabitance_generic_formal_tree_over(
      declared: dag_arrow_with_body_node(
        domain: inhabitance_named_conj_domain(
          parameter: ^inhabitance_param_x,
          declared: dag_type_atom_node(identity: ^dag_binding_type_int)
        ),
        return_type_binding: ^inhabitance_type_param_t,
        body: dag_int_literal_fixture_one()
      )
    )
  )
}

fn sweep_c_reason() -> String {
  match infer(tree: sweep_c_tree()) {
    Accepted { value: _, diagnostics: _ } => "ACCEPTED"
    Rejected { diagnostics: d } => sweep_fatal_sym(d: d)
  }
}

fn sweep_eq(a: String, b: String) -> Bool {
  a == b
}

