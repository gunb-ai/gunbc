module v2.test.claim.compiler.float_literal_home_unruled

import v2.test.claim.compiler.infer_fold_member_instance { fmi_assemble, fmi_infer_tree, fmi_reason }
import v2.std.diagnostic { Accepted, Rejected }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A float literal's home (kernel binary64, std.decimal or other) is an open operator ruling, so no
// stage types it: resolve returns the atom whole and carries its exact digits, and infer refuses it
// typed and located with infer_reason_float_literal_home_unruled. It was refused at resolve as
// float_literal_not_lowered, a stage deciding what a later stage owns.
data flhu_float_src: String = "module p\n\nfn f() -> Int {\n  1.8\n}\n"

data flhu_int_src: String = "module p\n\nfn f() -> Int {\n  18\n}\n"

// RED: the float assembles (resolve no longer refuses) and infer refuses it under the new reason.
test fn a_float_literal_reaches_infer_and_refuses_home_unruled() -> Bool {
  match fmi_assemble(src: flhu_float_src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      fmi_reason(o: fmi_infer_tree(tree: tree)) == ^infer_reason_float_literal_home_unruled
  }
}

// POSITIVE CONTROL: an int literal in the same position is typed and accepted as before.
test fn an_int_literal_still_infers() -> Bool {
  match fmi_assemble(src: flhu_int_src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } => fmi_reason(o: fmi_infer_tree(tree: tree)) == ^accepted
  }
}
