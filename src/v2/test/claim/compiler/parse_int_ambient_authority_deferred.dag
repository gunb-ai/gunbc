module v2.test.claim.compiler.parse_int_ambient_authority_deferred

import v2.compiler.resolve { ResolvedTree }
import v2.test.claim.body_let_annotation { bla_assemble_with_peers, bla_source, bla_q_artifact }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import extdeps.filesystem.filesystem_io
import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE parse_int AMBIENT AUTHORITY IS DEFERRED, NOT YET RETIRED (NAMESPACE-XL, chars and list_push precedent; the
// home is a root-coordinator decision approved by sleek-owl-397). std.integer now declares the one home
// (`fn parse_int(s: String) -> Int?`), and the generated sweep imports it at the call sites this wave covered.
// But ten files still reach the name AMBIENTLY: nine refuse the sweep at compiler normalize (their own current-tree
// normalize already refuses, with or without this wave — they are compiler obligations, not wave defects) and one
// (std.checked_arithmetic) closes an import cycle against std.integer's own dependencies. The std.primitives
// `parse_int_contract` stopgap therefore STANDS in this head — deleting it would break those ten call sites
// outside the gate (ruled by wise-moth-707 on the wave). THIS CLAIM READS THE REAL std.primitives CLOSURE FROM
// DISK, so it holds against the actual tree: while the residual is non-zero, a module using `parse_int` WITHOUT
// the declared import still admits at resolve (the stopgap), the control keeps the ambient tier honest (a name
// whose contract row stands, `to_string`, still binds), and the positive restates the home minimally, beside the
// real std.optional (the `Int?` sugar binds to that declaration), showing the declared import binds where the
// name would otherwise come only from ambient. WHEN THE RESIDUAL REACHES ZERO (the nine normalize classes fixed,
// the checked_arithmetic cycle broken by the option-A child adhoc-b2319e13-286), the contract row is deleted in a
// later head and this claim flips: the first test below becomes the RED-until-deletion form (refuses with
// resolve_reason_unbound_symbol), exactly as parse_int_ambient_authority_retired stood for the chars and list_push
// waves.

fn pir_peer(path: String) -> DagSourceReadWitness {
  bla_source(src: filesystem_read(path: path).content, artifact: bla_q_artifact, cu: ^body_let_annotation_q_cu)
}

fn pir_primitives_closure() -> List<DagSourceReadWitness> {
  [
    pir_peer(path: "dag/std/primitives.dag"),
    pir_peer(path: "dag/std/types.dag"),
    pir_peer(path: "dag/std/algebra.dag"),
    pir_peer(path: "dag/std/optional.dag"),
    pir_peer(path: "dag/std/error_primitives.dag"),
    pir_peer(path: "dag/std/unicode/types.dag")
  ]
}

fn pir_resolve_reason(p_src: String) -> Symbol {
  match bla_assemble_with_peers(p_src: p_src, peers: pir_primitives_closure()) {
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
    Accepted { value: tree, diagnostics: _ } => ^accepted
  }
}

// THE DEFERRAL WITNESS: while the residual population is non-zero the stopgap row stands, so the name admits with
// no import. This is the EXACT MIRROR of the retired-claim's RED: the same source that must refuse at resolve in
// the head that deletes parse_int_contract admits here. It pins which state this head is in.
test fn ambient_stopgap_still_admits_while_residual_stands() -> Bool {
  pir_resolve_reason(p_src: "module p\n\nimport std.types { Int, String }\n\nfn f(t: String) -> Int? {\n  parse_int(s: t)\n}\n")
    == ^accepted
}

// THE CONTROL: the ambient tier is intact for a surviving contract row.
test fn surviving_contract_row_still_binds_at_resolve() -> Bool {
  pir_resolve_reason(p_src: "module p\n\nfn f(x: Int) -> String {\n  to_string(x)\n}\n")
    == ^accepted
}

// THE POSITIVE: the subject's own import line binds the home beside the real std.optional, where the bare name
// would otherwise come only from the ambient stopgap.
test fn declared_import_of_the_home_binds_where_ambient_refuses() -> Bool {
  match bla_assemble_with_peers(
    p_src: "module p\n\nimport std.integer { parse_int }\n\nfn f(t: String) -> Int? {\n  parse_int(s: t)\n}\n",
    peers: [
      bla_source(
        src: "module std.integer\n\nfn parse_int(s: String) -> Int? {\n  parse_int(s: s)\n}\n",
        artifact: bla_q_artifact,
        cu: ^body_let_annotation_q_cu
      ),
      pir_peer(path: "dag/std/optional.dag")
    ]
  ) {
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
    Accepted { value: tree, diagnostics: _ } => ^accepted
  } == ^accepted
}
