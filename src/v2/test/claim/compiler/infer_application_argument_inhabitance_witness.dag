import std.occurrence_identity { OccurrenceSynthetic }

fn inhabitance_named_conj_domain(parameter: Symbol, declared: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(
        name: parameter,
        type_node: declared
      )
    ]
  )
}

fn inhabitance_apply(domain: Node, arg: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: dag_arrow_with_body_node(
          domain: domain,
          return_type_binding: ^dag_binding_type_int,
          body: dag_int_literal_fixture_one()
        ),
        declaration: NotADeclaration
      },
      Edge { label: Positional, target: arg, declaration: NotADeclaration }
    ]
  )
}

fn inhabitance_call_tree(arg: Node) -> Node {
  inhabitance_apply(
    domain: inhabitance_named_conj_domain(
      parameter: ^inhabitance_param_x,
      declared: dag_type_atom_node(identity: ^dag_binding_type_int)
    ),
    arg: arg
  )
}

// THE FORMAL MENTIONS A TYPE VARIABLE THE CALLEE DECLARES. `T` is bound by the Arrow's own type
// parameter list (v2.std.type_binder type_params_edge), so the relation holds no instance for it and
// the obligation is counted UndecidableGenericFormal. An Instantiation that mentions no declared type
// variable is decided structurally instead (inhabitance_ground_instantiation_* below).
//
// EVERY T POSITION IS MINTED, NOT SYNTHETIC. v2.test.lens_common.infer_fixture (its claim_callable_arrow
// header): each authored position carries its OWN minted occurrence, because raw node equality compares
// occurrence and two synthetic atoms of one spelling are ONE key -- an atom structurally equal to the
// type infer derives for it is refused as grounding_evidence_is_source by
// v2.std.constraints.canonical_grounding_from_derived_type. Since #14749 (c5d5b2025e4e) an in-scope type
// variable HAS a derived type (the infer_atom_is_rigid_binder_in_scope leaf rule derives
// v2.compiler.infer.infer_open_type_param_atom, an OccurrenceSynthetic atom), so a T position still
// built with dag_type_atom_node now collides with the node it grounds and the tree refuses for
// self-evidence before its inhabitance verdict is reached. Pre-#14749 nothing derived a type for an
// in-scope T at these positions, so the shared synthetic key was latent. The assertions below stay the
// behavior assertions (refuses non-inhabiting / counted frontier); the FIXTURES carry the discipline.
fn inhabitance_generic_formal_tree() -> Node {
  inhabitance_generic_formal_tree_over(
    declared: node_synthetic(
      kind: TypeNode { connective: Instantiation },
      children: [
        Edge {
          label: Positional,
          target: claim_minted_atom(identity: ^inhabitance_type_param_t, n: 3001),
          declaration: NotADeclaration
        }
      ]
    )
  )
}

fn inhabitance_generic_formal_tree_over(declared: Node) -> Node {
  let arrow = dag_arrow_with_body_node(
    domain: inhabitance_named_conj_domain(
      parameter: ^inhabitance_param_t,
      declared: declared
    ),
    return_type_binding: ^dag_binding_type_int,
    body: dag_int_literal_fixture_one()
  )
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: node_synthetic(
          kind: arrow.kind,
          children: list_snoc_item(
            xs: arrow.children,
            item: type_params_edge(
              conj: node_synthetic(
                kind: TypeNode { connective: Conj },
                children: type_binder_set_children(binders: [
                  Edge {
                    label: Authored { name: ^inhabitance_type_param_t },
                    target: claim_minted_atom(identity: ^inhabitance_type_param_t, n: 3002),
                    declaration: NotADeclaration
                  }
                ], source: claim_minted_atom(identity: ^inhabitance_type_param_t, n: 3003))
              )
            )
          )
        ),
        declaration: NotADeclaration
      },
      Edge { label: Positional, target: dag_int_literal_fixture_one(), declaration: NotADeclaration }
    ]
  )
}

// THE ARROW FORMAL `(Int) -> T`, codomain MINTED. Byte-faithful to v2.extdeps.languages.dag
// dag_arrow_with_body_node EXCEPT the two codomain T atoms: each position carries its OWN minted
// occurrence, for the reason recorded on inhabitance_generic_formal_tree -- the arrow's codomain is an
// in-scope T position, and dag_arrow_with_body_node builds it with the shared synthetic spelling key,
// which collides with the open atom #14749's leaf rule derives for it (grounding_evidence_is_source).
fn inhabitance_arrow_formal_tree_minted_codomain() -> Node {
  let domain = inhabitance_named_conj_domain(
    parameter: ^inhabitance_param_x,
    declared: dag_type_atom_node(identity: ^dag_binding_type_int)
  )
  let signature = declared_signature(params: domain.children, source: domain)
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      signature.domain,
      Edge {
        label: Positional,
        target: claim_minted_atom(identity: ^inhabitance_type_param_t, n: 3004),
        declaration: NotADeclaration
      },
      Edge {
        label: Positional,
        target: claim_minted_atom(identity: ^inhabitance_type_param_t, n: 3005),
        declaration: NotADeclaration
      },
      signature.order,
      Edge {
        label: core_edge_label(marker: ArrowBodyEdge),
        target: dag_int_literal_fixture_one(),
        declaration: NotADeclaration
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn inhabitance_optional_formal_tree() -> Node {
  inhabitance_apply(
    domain: inhabitance_named_conj_domain(
      parameter: ^inhabitance_param_opt,
      declared: wrap_type_node_occupancy(
        base: dag_type_atom_node(identity: ^dag_binding_type_int),
        depth: Succ { prev: Zero }
      )
    ),
    arg: dag_int_literal_fixture_one()
  )
}

fn inhabitance_arity_unmodeled_tree() -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: dag_arrow_with_body_node(
          domain: inhabitance_named_conj_domain(
            parameter: ^inhabitance_param_x,
            declared: dag_type_atom_node(identity: ^dag_binding_type_int)
          ),
          return_type_binding: ^dag_binding_type_int,
          body: dag_int_literal_fixture_one()
        ),
        declaration: NotADeclaration
      },
      Edge {
        label: Positional,
        target: dag_int_literal_fixture_one(),
        declaration: NotADeclaration
      },
      Edge {
        label: Positional,
        target: dag_int_literal_fixture_two(),
        declaration: NotADeclaration
      }
    ]
  )
}

fn inhabitance_formal_unresolved_tree() -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^inhabitance_takes_int),
        declaration: NotADeclaration
      },
      Edge {
        label: Positional,
        target: dag_int_literal_fixture_one(),
        declaration: NotADeclaration
      }
    ]
  )
}

test fn infer_incompatible_argument_refuses_holds() -> Bool {
  match infer(
    tree: claim_resolved_tree_without_declarations(root: inhabitance_call_tree(arg: dag_type_atom_node(identity: ^dag_token_kw_true)))
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: nds } =>
      diagnostics_has_reason(
        d: Some { diagnostics: nds },
        reason: ^application_argument_does_not_inhabit
      )
  }
}

test fn infer_compatible_argument_admits_holds() -> Bool {
  match infer(tree: claim_resolved_tree_without_declarations(root: inhabitance_call_tree(arg: dag_int_literal_fixture_one()))) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn infer_argument_type_not_derived_is_counted_frontier_holds() -> Bool {
  match infer(
    tree: claim_resolved_tree_without_declarations(root: inhabitance_call_tree(
      arg: node_synthetic(kind: ComputationNode { behavior: Value }, children: [])
    ))
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: d } =>
      diagnostics_has_reason(
        d: d,
        reason: ^inhabitance_undecidable_argument_type_not_derived
      )
  }
}

// An Instantiation that mentions the declared type variable is no longer a counted frontier: the formal
// is matched structurally (v2.compiler.infer infer_judge_generic_formal) and the Int argument, whose
// type is derived, does not inhabit it, so the application refuses. The claim formerly asserted
// UndecidableGenericFormal here and is flipped to the decided verdict.
test fn infer_generic_formal_instantiation_refuses_a_non_inhabiting_argument_holds() -> Bool {
  match infer(tree: claim_resolved_tree_without_declarations(root: inhabitance_generic_formal_tree())) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      diagnostics_fatal_reason(d: d) == ^application_argument_does_not_inhabit
  }
}

// THE DISCRIMINATING HALF THAT STAYS COUNTED: a type variable inside an ARROW formal (`(Int) -> T`) is
// still the generic formal the judge holds no instance for; only a first-order Instantiation is matched.
// (A bare variable formal binds its first instance and is decided, so it is not the counted shape.)
// THE CLAIMED BEHAVIOR, RE-TARGETED TO THE SHAPE THAT STILL EXHIBITS IT AFTER #14749. This claim
// asserts: an inhabitance obligation whose type mentions an in-scope type variable is COUNTED at the
// frontier (ACCEPTED with the counted reason), not refused. Pre-#14749 (c5d5b2025e4e) the fixture put
// the arrow INSIDE a formal (g<T>(t: (Int) -> T)) and its obligation counted, because nothing could
// decide an in-scope T. The rigid-binder leaf rule made exactly that obligation decidable -- an
// in-scope T now compares as itself -- so the counted reason for a T-headed FORMAL is gone by design
// (the row gunbc.recurring_failure_mode witness_module_absent_from_the_executed_set records the
// claim's old assertion as that rule's documented symptom). The counted frontier for an in-scope type
// variable SURVIVES where the obligation cannot collapse to a self-comparison: applying a GENERIC
// ARROW itself whose signature mentions T. This fixture pins THAT shape -- byte-faithful to the
// arrow above (minted codomain positions 3004/3005), with the type-parameter binder minted (3006/3007,
// distinct ids per position as v2.test.lens_common.infer_fixture requires) and the arrow applied
// directly to the argument. claim_batch on this module re-derives the verdict; the assertion is
// unchanged from the pre-#14749 claim (Accepted + counted reason present).
fn inhabitance_arrow_formal_generic_application_tree() -> Node {
  let arrow = inhabitance_arrow_formal_tree_minted_codomain()
  let binder_conj = Node {
    kind: TypeNode { connective: Conj },
    children: type_binder_set_children(
      binders: [
        Edge {
          label: Authored { name: ^inhabitance_type_param_t },
          target: claim_minted_atom(identity: ^inhabitance_type_param_t, n: 3006),
          declaration: NotADeclaration
        }
      ],
      source: claim_minted_atom(identity: ^inhabitance_type_param_t, n: 3007)
    ),
    occurrence_id: OccurrenceSynthetic
  }
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: arrow.kind,
          children: list_snoc_item(
            xs: arrow.children,
            item: type_params_edge(conj: binder_conj)
          ),
          occurrence_id: OccurrenceSynthetic
        },
        declaration: NotADeclaration
      },
      Edge { label: Positional, target: dag_int_literal_fixture_one(), declaration: NotADeclaration }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

test fn infer_applied_generic_arrow_type_variable_is_counted_frontier_holds() -> Bool {
  match infer(
    tree: claim_resolved_tree_without_declarations(
      root: inhabitance_arrow_formal_generic_application_tree()
    )
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: d } =>
      diagnostics_has_reason(d: d, reason: ^inhabitance_undecidable_generic_formal)
  }
}

// POSITIVE CONTROL FOR THE SUPERSEDED SHAPE. The ORIGINAL subject of the counted-frontier claim was
// the arrow NESTED inside a generic callable's formal -- (<T>(t: (Int) -> T))(1), i.e.
// inhabitance_generic_formal_tree_over(declared: <the minted-codomain arrow>) -- the same fixture
// repair (minted T positions) applied to it. Its verdict was measured, not assumed: scratch probes
// on the never-merge witness branch split the conjunction and named the fatal by bucket sweep then
// exact round, all on this fixture's own exported builders.
// THE MEASURED VERDICT: REJECTED at the inner arrow's OWN declared-return obligation. The walk
// settles the inner Arrow as a node, and v2.compiler.infer infer_arrow_declared_return_check judges
// its body at the declared return -- here the minted in-scope T atom. The body is the literal Int;
// Int inhabits no rigid T, the witness search finds no candidate, and v2.std.inhabitance mints the
// exact refusal for that position (inhabitance_no_candidate_return_reason, reached through
// inhabitance_application_refusal_reason at the position_declared_return position).
// CHAIN RE-DERIVATION (§6b), decided NOT a #14749 regression: #14749 made the obligation DECIDABLE,
// and a decidable door that RUNS may decide REFUSED. Here the refusal is correct -- a function
// literal whose body is Int at declared return T is malformed (no value of a rigid T is
// constructible), so no well-formed body-bearing arrow with a rigid T codomain exists; the
// pre-#14749 counted-accept was the fail-open artifact (T undecidable meant the door was skipped).
// This claim PINS that decided-and-refused verdict: Rejected, the fatal is the declared-return door
// label, and the counted generic-formal reason is NOT what refused it. A future change that flips
// this verdict -- accepts the malformed literal, counts it, or refuses it elsewhere -- goes red
// HERE instead of silently unwatching the shape the re-target abandoned. Measured by claim_batch on
// this module; the counterpart, not a duplicate, of the claim above: same obligation, two positions,
// two pinned verdicts.
test fn infer_nested_body_bearing_arrow_formal_is_decided_and_refused_holds() -> Bool {
  match infer(
    tree: claim_resolved_tree_without_declarations(
      root: inhabitance_generic_formal_tree_over(
        declared: inhabitance_arrow_formal_tree_minted_codomain()
      )
    )
  ) {
    Rejected { diagnostics: nds } =>
      (diagnostics_fatal_reason(d: nds) == ^arrow_body_does_not_inhabit_declared_return)
        && !diagnostics_has_reason(
          d: Some { diagnostics: nds },
          reason: ^inhabitance_undecidable_generic_formal
        )
    Accepted { value: _, diagnostics: _ } => false
  }
}

data iaai_host_source: String = "module v2.test.iaai_host\n\nfn iaai_noop() -> Bool { true }\n"

data iaai_ingest: SourceRootIngest = [
  rcf_read_in(tree: DagTree, source: oar_optional_source, id: ^iaai_optional_read, unit: ^iaai_optional_cu, path: "dag/std/optional.dag"),
  rcf_read_in(tree: V2Tree, source: iaai_host_source, id: ^iaai_host_read, unit: ^iaai_host_cu, path: "src/v2/test/iaai_host.dag")
]

// The supplied formal tree is checked against an index that holds std.optional: the peer root is
// ingested and resolved like any consumer's, and only the root is swapped for the hand-built tree.
fn iaai_resolved_with_optional(root: Node) -> Outcome<ResolvedTree> {
  match module_roots_from_source_root_ingest(ingest: iaai_ingest, lm: dag_language_model()) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      match resolve_in_context(
        context: resolution_context(lm: dag_language_model(), roots: roots, index: source_root_index_empty(), active_roots: Empty, policy: default_name_resolution_policy()),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: "v2.test.iaai_host") },
          imports: Empty
        }
      ).resolved {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: t, diagnostics: ds } =>
          Accepted { value: ResolvedTree { root: root, symbol_index: t.symbol_index, resolved_declarations: t.resolved_declarations, occurrence_resolutions: t.occurrence_resolutions, duplicate_binding_records: t.duplicate_binding_records, module_outcomes: t.module_outcomes, outcome_index: t.outcome_index, member_kinds: t.member_kinds, type_declaration_modifiers: t.type_declaration_modifiers, constructing_module: t.constructing_module }, diagnostics: ds }
      }
  }
}

// A formal declared `Int?` owes no descent: it is an Instantiation of the std.optional Optional
// declaration, whose connective is Bounded (v2.std.cardinality connective_multiplicity). Whatever
// the application's verdict, it is never infer_descent_not_derived.
test fn infer_optional_formal_owes_no_descent_holds() -> Bool {
  match iaai_resolved_with_optional(root: inhabitance_optional_formal_tree()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: nds } =>
          !diagnostics_has_reason(d: Some { diagnostics: nds }, reason: ^infer_descent_not_derived)
        Accepted { value: _, diagnostics: d } =>
          !diagnostics_has_reason(d: d, reason: ^infer_descent_not_derived)
      }
  }
}

// The CUT'S SEMANTICS, not a fixture gap (std.optional is ingested above): a bare Int at an `Int?`
// formal is an Int at an Instantiation of Optional, which does not inhabit it (the authoring policy
// is explicit Present, gunbc.design_ruling explicit_present_is_the_authoring_policy). The old
// Occupancy connective admitted it with the OptionalCarrier advisory; that admission is what the cut retires.
// REASON UPDATED to the typed 'no implicit lift' reason #14644 (the Optional stack, Rule A part 3)
// introduced: the refusal is unchanged -- still Rejected, still no accept -- but the chain's reason
// is now infer_literal_at_optional_is_not_present, minted by v2.compiler.infer's
// InferLiteralElaborationRefused cause, the same reason the landed source-route witnesses
// v2.test.claim.compiler.infer_arm_close_witness (rb_x1/rb_x3/rc8) pin green for the identical
// ruling. This claim, re-derived by claim_batch on this module, is the instrument; the formerly
// asserted label was the pre-#14644 spelling the typed reason replaced.
test fn infer_bare_int_at_an_optional_formal_refuses_holds() -> Bool {
  match iaai_resolved_with_optional(root: inhabitance_optional_formal_tree()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: nds } =>
          diagnostics_has_reason(d: Some { diagnostics: nds }, reason: ^infer_literal_at_optional_is_not_present)
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}

test fn infer_positional_surplus_refuses_holds() -> Bool {
  match infer(tree: claim_resolved_tree_without_declarations(root: inhabitance_arity_unmodeled_tree())) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: nds } =>
      diagnostics_has_reason(
        d: Some { diagnostics: nds },
        reason: ^application_positional_surplus
      )
  }
}

test fn infer_atom_operator_is_counted_formal_unresolved_holds() -> Bool {
  match infer(tree: claim_resolved_tree_without_declarations(root: inhabitance_formal_unresolved_tree())) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: d } =>
      diagnostics_has_reason(
        d: d,
        reason: ^inhabitance_undecidable_formal_unresolved
      )
  }
}

// THE COLLECTION-VERSUS-NOMINAL-PRODUCT CELL, MEASURED ON THIS PATH BECAUSE THE SEED'S SAME CELL
// WAS A HOLE. `v1.compiler.infer` admitted a `List<String>` at a `Rec { a: String }` formal and a
// `Rec` at a `List<Int>` formal, in both directions, by falling through a chain of arms each
// keyed on the kind of ONE side (gunbc.recurring_failure_mode
// declared_type_wall_keyed_on_the_value_being_a_kernel, measured specimen three). This path's
// relation is different in kind -- `declared_type_inhabitance` is find_witness over
// preservation_rule_exact_structural_equality_zip_fold, which reads BOTH sides -- so the seed's
// repair does not transfer and the cell had to be measured rather than assumed.
//
// WHAT IS MEASURED (captured diagnostics, not inferred from the classifier): the two directions
// stop at DIFFERENT boundaries. With the product declared and the collection supplied as the
// argument, the argument is an Instantiation with no derived value type, so the obligation is
// counted UndecidableArgumentTypeNotDerived before the relation is asked. With the collection
// declared, the formal `List<Int>` mentions no declared type variable, so it is decided
// (inhabitance_node_undecidable_reason reads the declaring Arrow's type parameters since the
// declared-return producer landed); the product argument derives its formation evidence, and the
// relation REFUSES it at the formal, application_argument_does_not_inhabit. Neither direction answers
// Inhabits the way the seed did. The first direction keeps the standing of
// gunbc.recurring_failure_mode argument_type_obligation_absent_while_the_route_advances; its
// next-rung trigger is that row's: an argument whose value type is derived as an APPLIED collection
// type.
fn inhabitance_collection_type_node() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^inhabitance_type_list),
        declaration: NotADeclaration
      },
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_binding_type_int),
        declaration: NotADeclaration
      }
    ]
  )
}

fn inhabitance_nominal_product_type_node() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      binder_edge(
        name: ^inhabitance_field_a,
        type_node: dag_type_atom_node(identity: ^dag_binding_type_int)
      )
    ]
  )
}

fn inhabitance_declared_formal_tree(declared: Node, arg: Node) -> Node {
  inhabitance_apply(
    domain: inhabitance_named_conj_domain(
      parameter: ^inhabitance_param_x,
      declared: declared
    ),
    arg: arg
  )
}

test fn inhabitance_collection_produced_at_a_product_formal_is_counted_frontier_holds() -> Bool {
  match infer(
    tree: claim_resolved_tree_without_declarations(root: inhabitance_declared_formal_tree(
      declared: inhabitance_nominal_product_type_node(),
      arg: inhabitance_collection_type_node()
    ))
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: d } =>
      diagnostics_has_reason(
        d: d,
        reason: ^inhabitance_undecidable_argument_type_not_derived
      )
  }
}

test fn inhabitance_product_produced_at_a_collection_formal_refuses_holds() -> Bool {
  match infer(
    tree: claim_resolved_tree_without_declarations(root: inhabitance_declared_formal_tree(
      declared: inhabitance_collection_type_node(),
      arg: inhabitance_nominal_product_type_node()
    ))
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: nds } =>
      diagnostics_has_reason(
        d: Some { diagnostics: nds },
        reason: ^application_argument_does_not_inhabit
      )
  }
}

// THE ARGUMENT POSITION WIDENS A REFINEMENT TO ITS DECLARED CARRIER, one step, through the same
// relation a let, a declared return and a record field reach (v2.std.inhabitance
// declared_type_inhabitance_declared_carrier). The obligation is SUPPLIED: from source a call to a
// named fn does not reach the judge yet (infer reads no formals off a callee reference), so the
// argument position is claimed at the relation's interface, and the real route's inhabitance is
// v2.test.claim.body_let_annotation (5e), which runs the same rule from source at the other three
// positions. `Pos` stands for a refinement whose declaration states carrier Int, `Pos2` one whose
// carrier is Pos, `Neg` a sibling refinement of Int. RED BEFORE: the relation had no carrier arm, so
// a Pos argument at an Int formal refused.
fn aai_argument_obligation(produced: Symbol, carrier: Optional<Node>, declared: Symbol) -> DeclaredTypeObligation {
  DeclaredTypeObligation {
    position: position_direct_call_argument(),
    parameter_identity: ^inhabitance_param_x,
    declared: dag_type_atom_node(identity: declared),
    produced: dag_type_atom_node(identity: produced),
    produced_declared_carrier: carrier,
    application: dag_type_atom_node(identity: produced),
    type_variables: []
  }
}

fn aai_inhabits_by_carrier(o: DeclaredTypeObligation) -> Bool {
  match declared_type_inhabitance(obligation: o) {
    Inhabits { homomorphism: h } => h.rule == ^homomorphism_rule_refinement_declared_carrier
    _ => false
  }
}

fn aai_refused(o: DeclaredTypeObligation) -> Bool {
  match declared_type_inhabitance(obligation: o) {
    InhabitanceRefused { find_witness_reason: _ } => true
    _ => false
  }
}

test fn inhabitance_refinement_argument_widens_to_its_declared_carrier_holds() -> Bool {
  aai_inhabits_by_carrier(o: aai_argument_obligation(
    produced: ^aai_pos,
    carrier: Present { value: dag_type_atom_node(identity: ^dag_binding_type_int) },
    declared: ^dag_binding_type_int
  ))
}

test fn inhabitance_refinement_argument_without_a_carrier_refuses_holds() -> Bool {
  aai_refused(o: aai_argument_obligation(produced: ^aai_pos, carrier: Absent, declared: ^dag_binding_type_int))
}

test fn inhabitance_refinement_argument_widens_one_step_only_holds() -> Bool {
  aai_refused(o: aai_argument_obligation(
    produced: ^aai_pos2,
    carrier: Present { value: dag_type_atom_node(identity: ^aai_pos) },
    declared: ^dag_binding_type_int
  ))
}

test fn inhabitance_sibling_refinement_argument_refuses_holds() -> Bool {
  aai_refused(o: aai_argument_obligation(
    produced: ^aai_neg,
    carrier: Present { value: dag_type_atom_node(identity: ^dag_binding_type_int) },
    declared: ^aai_pos
  ))
}

// AN ARROW AT AN ARROW IS ITS DOMAIN TYPES POSITIONALLY AND ITS RETURN (v2.std.inhabitance
// declared_type_inhabitance_arrow), never a binder name or a body, at every position that reaches the
// one relation: this is the ARGUMENT position (a named fn passed to an Arrow-typed formal), the record
// field and declared-return positions are claimed from source in infer_optional_at_required_witness.
// RED BEFORE: the relation had no Arrow arm, so two arrows of one signature differing in a binder name
// refused with the exact-equality reason.
fn aai_arrow(parameter: Symbol, domain: Symbol, codomain: Symbol) -> Node {
  declared_signature_arrow(
    params: [binder_edge(name: parameter, type_node: dag_type_atom_node(identity: domain))],
    codomain: dag_type_atom_node(identity: codomain),
    source: dag_type_atom_node(identity: codomain)
  )
}

fn aai_arrow_obligation(declared: Node, produced: Node) -> DeclaredTypeObligation {
  DeclaredTypeObligation {
    position: position_direct_call_argument(),
    parameter_identity: ^inhabitance_param_x,
    declared: declared,
    produced: produced,
    produced_declared_carrier: Absent,
    application: produced,
    type_variables: []
  }
}

test fn inhabitance_arrow_differing_only_in_a_binder_name_inhabits_holds() -> Bool {
  match declared_type_inhabitance(obligation: aai_arrow_obligation(
    declared: aai_arrow(parameter: ^aai_k, domain: ^dag_binding_type_int, codomain: ^dag_binding_type_bool),
    produced: aai_arrow(parameter: ^inhabitance_param_x, domain: ^dag_binding_type_int, codomain: ^dag_binding_type_bool)
  )) {
    Inhabits { homomorphism: _ } => true
    _ => false
  }
}

test fn inhabitance_arrow_with_a_different_domain_refuses_holds() -> Bool {
  aai_refused(o: aai_arrow_obligation(
    declared: aai_arrow(parameter: ^aai_k, domain: ^dag_binding_type_int, codomain: ^dag_binding_type_bool),
    produced: aai_arrow(parameter: ^aai_k, domain: ^dag_binding_type_bool, codomain: ^dag_binding_type_bool)
  ))
}

test fn inhabitance_arrow_with_a_different_return_refuses_holds() -> Bool {
  aai_refused(o: aai_arrow_obligation(
    declared: aai_arrow(parameter: ^aai_k, domain: ^dag_binding_type_int, codomain: ^dag_binding_type_bool),
    produced: aai_arrow(parameter: ^aai_k, domain: ^dag_binding_type_int, codomain: ^dag_binding_type_int)
  ))
}

// A NESTED ARROW IS NOT WIDENED (review 78749): a signature whose domain holds an Arrow stays on the
// exact comparison, so an inner return mismatch refuses rather than reaching an advisory acceptance.
fn aai_higher_order(inner_return: Symbol) -> Node {
  declared_signature_arrow(
    params: [binder_edge(name: ^aai_k, type_node: aai_arrow(parameter: ^aai_k, domain: ^dag_binding_type_int, codomain: inner_return))],
    codomain: dag_type_atom_node(identity: ^dag_binding_type_bool),
    source: dag_type_atom_node(identity: ^dag_binding_type_bool)
  )
}

test fn inhabitance_nested_arrow_with_a_different_inner_return_refuses_holds() -> Bool {
  aai_refused(o: aai_arrow_obligation(
    declared: aai_higher_order(inner_return: ^dag_binding_type_bool),
    produced: aai_higher_order(inner_return: ^dag_binding_type_int)
  ))
}

test fn inhabitance_identical_nested_arrows_inhabit_holds() -> Bool {
  match declared_type_inhabitance(obligation: aai_arrow_obligation(
    declared: aai_higher_order(inner_return: ^dag_binding_type_bool),
    produced: aai_higher_order(inner_return: ^dag_binding_type_bool)
  )) {
    Inhabits { homomorphism: _ } => true
    _ => false
  }
}

// LIST-TYPED-VALUE ELEMENT MISMATCH, THE v2 RELATION. The seed refuses List<RunProp> at
// List<String> through PositionGenericTypeArgument (gunbc.recurring_failure_mode
// list_typed_value_element_mismatch_admitted). v2's declared_type_inhabitance compares Instantiation
// nodes by exact structural equality, so List<Int> versus List<product> is the same pair without
// re-deriving the seed's generic-argument walk. This is the judgement v2 owns; the authored-source
// census lives on the seed compile route.
fn aai_list_of(elem: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^inhabitance_type_list),
        declaration: NotADeclaration
      },
      Edge { label: Positional, target: elem, declaration: NotADeclaration }
    ]
  )
}

fn aai_list_obligation(declared: Node, produced: Node) -> DeclaredTypeObligation {
  DeclaredTypeObligation {
    position: position_direct_call_argument(),
    parameter_identity: ^inhabitance_param_x,
    declared: declared,
    produced: produced,
    produced_declared_carrier: Absent,
    application: produced,
    type_variables: []
  }
}

test fn inhabitance_list_of_product_at_list_of_int_refuses_holds() -> Bool {
  aai_refused(o: aai_list_obligation(
    declared: aai_list_of(elem: dag_type_atom_node(identity: ^dag_binding_type_int)),
    produced: aai_list_of(elem: inhabitance_nominal_product_type_node())
  ))
}

test fn inhabitance_matching_list_of_int_inhabits_holds() -> Bool {
  match declared_type_inhabitance(obligation: aai_list_obligation(
    declared: aai_list_of(elem: dag_type_atom_node(identity: ^dag_binding_type_int)),
    produced: aai_list_of(elem: dag_type_atom_node(identity: ^dag_binding_type_int))
  )) {
    Inhabits { homomorphism: _ } => true
    _ => false
  }
}
