module v2.test.claim.compiler.operation_declaration_seam

// THE INHABITANCE PAIRING FOR THE HOST-BOUNDARY SEAMS: the seam's own declaration row (the
// OperationDeclaration at its real declaration path, which the census's D13 seam-opaque arm reads)
// AND the std.primitive_projection row for the same path -- the seam is SEALED (real projection row,
// opaque, no host fallback) and DECLARED (a real OperationDeclaration row carrying its requirement)
// at once. A declaration row that does not join to a projection row, or a projection row with no
// declaration behind it, is the hole this pairing refuses.

import std.algebra { Empty, fold_list, length, list_snoc_item }
import std.primitive_projection { DivergentProjection, HostRealizedSeam, ModeledProjection, primitive_projection_roster }
import extdeps.communication.medium { Lossless, Medium }
import std.decl_ref { DeclarationRef, decl_ref }
import std.effects { ReadEffect }
import std.optional { Absent, Present }
import std.types { Bool, List }
import v2.compiler.dependency_demand {
  CalleeOutsideClosure,
  DemandDerived,
  DemandUndecided,
  DependencyDemand,
  DependencyDemandRow,
  FunctionFact,
  OperationFact,
  RequiresNone,
  RequiresResources,
  RequiresUndeclared,
  dependency_demand_of,
  demand_equal,
  resource_set_of
}
import v2.compiler.dependency_demand_census {
  demand_census_declaration_is_host_seam,
  demand_census_seam_operation_fact,
  demand_census_seam_requirement
}
import v2.compiler.effect_pair_census {
  ReachesDeclaredResource,
  ReachesExecutionSemanticsUnknown,
  ReachesUndeclaredOperation,
  effect_reach_reason,
  effect_reach_table,
  reach_operation_reason,
  reach_operation_semantics
}
import v2.compiler.name_resolve { module_root_find }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.compiler.source_root_eval { native_test_context_from_ingest, native_test_resolve_module }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.integer { Int }
import v2.std.node { symbol_intern_lexeme }
import v2.std.operation_declaration {
  DeclaredShape,
  NativeHostActuation,
  NativeHostObservation,
  NoResourceAccess,
  OperationDispositionUnclassified,
  ObservesHost,
  Pure,
  effect_demand_operation_classifications,
  operation_declaration_for,
  operation_declaration_for_path,
  operation_declaration_m2v_population,
  operation_declaration_path,
  operation_declaration_roster,
  operation_declaration_row_count_for
}
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string, qualified_name_from_string_segments }

// THE REAL SEAM PATHS, module-qualified the way a module walk produces them -- never a bare primitive
// slug, which is the join the deleted index used and which matched nothing a walk produced.

fn seam_path() -> QualifiedName {
  qualified_name_from_dotted_string(dotted: "v2.std.data_index.data_init_decl_facts_live")
}

fn read_seam_path() -> QualifiedName {
  qualified_name_from_dotted_string(dotted: "v2.std.live_read.filesystem_read")
}

fn caller_path() -> QualifiedName {
  qualified_name_from_dotted_string(dotted: "v2.test.fixture.operation_declaration_seam_caller.caller")
}

fn filesystem_resource() -> QualifiedName {
  qualified_name_from_string_segments(segments: ["std", "resources", "Filesystem"])
}

fn never_declared_path() -> QualifiedName {
  qualified_name_from_dotted_string(dotted: "t.never.declared.nothing_here")
}

fn never_declared_key() -> DeclarationRef {
  decl_ref(module_path: "t.never.declared", decl_name: "nothing_here")
}

// THE CALLER THE CENSUS SETTLES: one transparent function whose only callee is the seam. The
// operation table is built by the census's OWN D13 arm (demand_census_seam_operation_fact), so what
// the caller settles at is exactly what the arm read out of the declaration row. An absent row is not
// a settlement: the fold's seed is a cause no input can produce.
fn caller_demand_over(callee: QualifiedName) -> DependencyDemand {
  let rows: List<DependencyDemandRow> = dependency_demand_of(
    functions: [FunctionFact { path: caller_path(), callees: [callee], calls_function_value: false }],
    operations: [demand_census_seam_operation_fact(path: callee)]
  )
  fold_list(
    xs: rows,
    empty: DemandUndecided { cause: CalleeOutsideClosure { callee: caller_path() } },
    cons: fn(acc, row) { if row.function == caller_path() { row.demand } else { acc } }
  )
}

test fn the_seam_predicate_holds_on_a_real_projection_path_holds() -> Bool {
  demand_census_declaration_is_host_seam(path: seam_path())
}

// THE FIRST HALF OF THE PAIRING, AT THE FULL ROSTER: every OperationDeclaration's path is a projected
// HostRealizedSeam path, by the join the census itself uses (operation_declaration_path turns the
// row's own DeclarationRef back into the QualifiedName, so the key comes from the row and not from a
// string the claim invented). A row at a path the projection does not seal is a fabricated operation
// the census would still answer as opaque.
test fn every_declaration_row_is_a_projected_host_seam_holds() -> Bool {
  fold_list(
    xs: operation_declaration_roster,
    empty: 0,
    cons: fn(n, row) {
      if demand_census_declaration_is_host_seam(path: operation_declaration_path(declaration: row.declaration)) {
        n
      } else {
        n + 1
      }
    }
  ) == 0
}

// THE SECOND HALF, AT THE SAME KEY: the census's seam arm dispatches on std.primitive_projection, so
// the count of declaration rows the arm dispatches on EQUALS the roster, and the converse is joined
// at identity grain against the projection's own rows: every HostRealizedSeam the projection seals
// has exactly one declaration row (no seam left without a row, none declared twice).
fn every_projected_host_seam_has_a_declaration_row() -> Bool {
  fold_list(
    xs: primitive_projection_roster(),
    empty: true,
    cons: fn(ok, projected) {
      ok && match projected.fidelity {
        HostRealizedSeam => operation_declaration_row_count_for(declaration: projected.declaration) == 1
        ModeledProjection => true
        DivergentProjection { divergence: _ } => true
      }
    }
  )
}

test fn every_host_realized_seam_carries_exactly_one_declaration_row_holds() -> Bool {
  fold_list(
    xs: operation_declaration_roster,
    empty: 0,
    cons: fn(n, row) {
      if demand_census_declaration_is_host_seam(path: operation_declaration_path(declaration: row.declaration)) {
        n + 1
      } else {
        n
      }
    }
  ) == length(xs: operation_declaration_roster)
    && every_projected_host_seam_has_a_declaration_row()
    && demand_census_declaration_is_host_seam(path: read_seam_path())
}

// THE DISPOSITION SPLIT THE ROSTER CARRIES, derived from the rows' dispositions: the population is
// every row whose semantics touches the host; exactly ONE of them is implementable (the read
// authority, joined by identity) and every other member is blocked, so no member is left over.
// RED A: DELETING filesystem_read's declaration row reddens THIS claim -- the row disappears, so no
// population member is implementable.
test fn the_m2v_population_splits_one_implementable_and_the_rest_blocked_holds() -> Bool {
  let rows = operation_declaration_m2v_population()
  let implementable = fold_list(
    xs: rows,
    empty: [],
    cons: fn(acc, row) {
      match row.disposition {
        NativeHostObservation { operation_identity: _ } => list_snoc_item(xs: acc, item: row.declaration)
        NativeHostActuation { operation_identity: _ } => list_snoc_item(xs: acc, item: row.declaration)
        _ => acc
      }
    }
  )
  let blocked = fold_list(
    xs: rows,
    empty: 0,
    cons: fn(n, row) {
      match row.disposition {
        OperationDispositionUnclassified { blocking_question: _ } => n + 1
        _ => n
      }
    }
  )
  length(xs: implementable) == 1
    && operation_declaration_row_count_for(declaration: decl_ref(module_path: "v2.std.live_read", decl_name: "filesystem_read")) == 1
    && fold_list(
      xs: implementable,
      empty: true,
      cons: fn(ok, declaration) { ok && declaration.module_path == "v2.std.live_read" && declaration.decl_name == "filesystem_read" }
    )
    && blocked + length(xs: implementable) == length(xs: rows)
    && length(xs: rows) > 1
}

test fn filesystem_read_declares_observes_host_read_named_file_with_the_filesystem_requirement_holds() -> Bool {
  match operation_declaration_for(declaration: decl_ref(module_path: "v2.std.live_read", decl_name: "filesystem_read")) {
    Absent => false
    Present { value: row } =>
      match row.semantics {
        ObservesHost { operation_identity: identity } =>
          match row.disposition {
            NativeHostObservation { operation_identity: _ } =>
              identity == symbol_intern_lexeme(lexeme: "read_named_file")
                && row.requirement == RequiresResources { resources: [filesystem_resource()] }
                && row.shape == DeclaredShape { shape: ReadEffect }
            _ => false
          }
        _ => false
      }
  }
}

test fn every_blocked_host_operation_keeps_known_semantics_and_a_named_question_holds() -> Bool {
  fold_list(
    xs: operation_declaration_m2v_population(),
    empty: true,
    cons: fn(ok, row) {
      ok && match row.disposition {
        OperationDispositionUnclassified { blocking_question: q } =>
          match row.semantics {
            ObservesHost { operation_identity: _ } => q != symbol_intern_lexeme(lexeme: "")
            _ => false
          }
        _ => row.declaration.module_path == "v2.std.live_read"
      }
    }
  )
}

// ---- THE D13 ARM, DRIVEN ON REAL ROWS ------------------------------------------------------------
// WHY THESE CLAIMS DO NOT WALK A REAL CORPUS MODULE, AND WHAT NAMES THAT REFUSAL INSTEAD. The walk
// route is native_test_context_from_ingest -> native_test_resolve_module, and NO claim in this
// repository resolves a real corpus module through it: a claim can carry only bytes it authors, so a
// corpus module's root never enters the context, and the instruments get their corpus from the Rust
// driver's own ingest-all-files route (production_ingest), which no claim can call. Refusing to fight
// the harness, the pairing below drives the REAL arm functions on REAL roster rows, and the refusal
// itself is NAMED BELOW in the compiler's own diagnostic: `module_root_find` on a corpus module name
// with roots no claim-carried ingest can supply is Rejected at ^resolve_module_not_found, minted by
// `resolve_module_not_found_diagnostic_from_missing` in v2.compiler.name_resolve -- the arm
// `resolve_in_context` reaches for a subject root. The WALKED-TABLE half of the inhabitance pairing
// (the seven seams appearing in the walked table at their real DeclarationRef, none settling
// Derived-empty) is claimed by the bounded std-closure B0 instrument,
// //gunbc/instruments:effect-pair-census; its run state at this head is REPORTED, not claimed, in the
// PR body.

// (1) THE WALKED SEAM IS MATCHED BY DECLARATION PATH AND CARRIES ITS OWN ROW'S REQUIREMENT. The
// requirement text exists nowhere but the row: an arm trusting a builtin table, or one walking the
// seam's self-call body, could not produce RequiresResources{[std.resources.Filesystem]} from it.
test fn the_walked_seam_is_matched_by_declaration_path_and_carries_the_rows_requirement_holds() -> Bool {
  let seam = demand_census_seam_operation_fact(path: seam_path())
  if demand_census_declaration_is_host_seam(path: seam_path()) {
    seam.path == seam_path()
      && seam.requirement == RequiresResources { resources: [filesystem_resource()] }
  } else {
    false
  }
}

// (2) THE WALKED SEAM FORMS NO FUNCTION FACT. The seam's body is never walked, so the census needs NO
// FunctionFact at the seam's own path for a caller to settle: an arm that walked the body (a self
// call: recursion) or that refused an operation with no function fact would answer Undecided here --
// DemandDidNotSettle, OpaqueOperationCalled, or CalleeOutsideClosure from the fold's own seed.
test fn the_walked_seam_forms_no_function_fact_holds() -> Bool {
  match caller_demand_over(callee: seam_path()) {
    DemandDerived { resources: _ } => true
    DemandUndecided { cause: _ } => false
  }
}

// (3) THE FAIL-OPEN CLOSING, MEASURED AT A TRANSPARENT CALLER. A caller whose only callee is the seam
// settles at EXACTLY the row's Filesystem singleton: not the EMPTY Derived the body-less fall-through
// produced while the census walked the seam's self-call body instead of reading its declaration, and
// not Undecided. This caller's seam is data_init_decl_facts_live: DELETING THAT ROW reddens this
// claim through RequiresUndeclared (the caller settles DemandUndecided{UndeclaredOperationCalled}).
// Deleting filesystem_read's row does NOT touch it -- the next claim is the one RED A reddens.
test fn a_transparent_caller_of_the_seam_settles_at_the_rows_filesystem_requirement_holds() -> Bool {
  demand_equal(
    left: caller_demand_over(callee: seam_path()),
    right: DemandDerived { resources: resource_set_of(paths: [filesystem_resource()]) }
  )
}

// THE SAME CALLER OVER THE READ AUTHORITY, the seam RED A deletes: the fact comes from
// demand_census_seam_operation_fact on the path, so deleting filesystem_read's row leaves the caller
// DemandUndecided{UndeclaredOperationCalled} and this claim red.
test fn a_transparent_caller_of_filesystem_read_settles_at_the_rows_filesystem_requirement_holds() -> Bool {
  demand_equal(
    left: caller_demand_over(callee: read_seam_path()),
    right: DemandDerived { resources: resource_set_of(paths: [filesystem_resource()]) }
  )
}

// THE B0 REACH, AT THE SAME IDENTITY: in the reach table the effect-pair instrument builds, the read
// authority reaches by ITS DECLARATION (ReachesDeclaredResource at its real module-qualified path) and
// is not left among the unclassified operations whose semantics nothing answered. RED A: DELETING
// filesystem_read's declaration row reddens THIS claim too -- the reach reason becomes
// ReachesUndeclaredOperation and the path joins the unclassified rows.
test fn the_read_authority_reaches_by_its_declaration_in_the_b0_reach_table_holds() -> Bool {
  let fact = demand_census_seam_operation_fact(path: read_seam_path())
  let table = effect_reach_table(
    functions: [FunctionFact { path: caller_path(), callees: [read_seam_path()], calls_function_value: false }],
    operations: [fact]
  )
  match effect_reach_reason(table: table, callee: read_seam_path()) {
    Present { value: ReachesDeclaredResource { operation: p } } =>
      p == read_seam_path()
        && fold_list(
          xs: table.unclassified,
          empty: false,
          cons: fn(any, path) { if path == read_seam_path() { true } else { any } }
        ) == false
    _ => false
  }
}

// THE HOLE, MEASURED AT THIS HEAD. The reducer answers DemandDerived{EMPTY} for ANY operation it is
// handed with RequiresNone -- which is exactly what the census produced for a host-realized seam while
// the arm fell through to a walk of its self-call body (a host observation read as pure: fail-open).
// The declaration row is the ONLY thing standing between a projected seam and that answer, because the
// arm now builds its fact from the row's RequiresResources{Filesystem}. And deleting the row does NOT
// reopen the hole: the arm then answers the typed RequiresUndeclared and the caller settles Undecided,
// never the empty Derived -- which is what claim (3) reddens through.
test fn the_declaration_row_is_the_only_thing_between_the_seam_and_derived_empty_holds() -> Bool {
  let rows: List<DependencyDemandRow> = dependency_demand_of(
    functions: [FunctionFact { path: caller_path(), callees: [seam_path()], calls_function_value: false }],
    operations: [OperationFact { path: seam_path(), requirement: RequiresNone }]
  )
  match rows {
    Cons { head: row, tail: _ } =>
      match row.demand {
        DemandDerived { resources: set } => set.size == 0
        DemandUndecided { cause: _ } => false
      }
    Empty => false
  }
}

// ---- RED B: NO ARM FABRICATES Pure / ReadEffect / RequiresNone FOR A PATH NOTHING DECLARES -------
// Every arm is named with what it MUST answer, and the falsifier is a key no row answers.

// A key no row answers is the TYPED UNDECLARED ARM in both vocabularies the census answers in: the
// census's own RequirementClass (RequiresUndeclared) and the reach census's requirement read, whose
// reason is ReachesUndeclaredOperation at that path. And where a requirement is handed to the reach
// census with no declaration behind it, the semantics read answers Absent and the reason is the TYPED
// ReachesExecutionSemanticsUnknown -- never Pure, never ReadEffect, never a host-observation reason.
test fn an_operation_with_no_declaration_row_is_the_typed_undeclared_arm_holds() -> Bool {
  match demand_census_seam_requirement(declaration: never_declared_key()) {
    RequiresUndeclared =>
      match reach_operation_semantics(op: OperationFact { path: never_declared_path(), requirement: RequiresNone }) {
        Absent =>
          match reach_operation_reason(op: OperationFact { path: never_declared_path(), requirement: RequiresNone }) {
            Present { value: ReachesExecutionSemanticsUnknown } =>
              match reach_operation_reason(op: OperationFact { path: never_declared_path(), requirement: RequiresUndeclared }) {
                Present { value: ReachesUndeclaredOperation { operation: p } } => p == never_declared_path()
                _ => false
              }
            _ => false
          }
        Present { value: _ } => false
      }
    _ => false
  }
}

// AND THE MISSING ROW ITSELF IS ABSENT from the keyed read -- not a row with a default behind it. A
// fallback roster entry (Pure / RequiresNone / ReadEffect for a missing key) makes BOTH the keyed
// read and the semantics read answer Present, reddening this claim.
test fn the_missing_row_is_absent_from_the_keyed_read_and_carries_no_default_semantics_holds() -> Bool {
  if operation_declaration_for(declaration: never_declared_key()) != Absent {
    false
  } else {
    match operation_declaration_for_path(path: never_declared_path()) {
      Absent =>
        match reach_operation_semantics(op: OperationFact { path: never_declared_path(), requirement: RequiresNone }) {
          Absent => true
          Present { value: _ } => false
        }
      Present { value: _ } => false
    }
  }
}

// THE READ AUTHORITY'S FACT, AT DECLARATION IDENTITY: the D13 arm's fact for filesystem_read carries
// the read authority's OWN identity (read_named_file) at RequiresResources{Filesystem}, the reach
// census reads its semantics as the host observation, and its reason is ReachesDeclaredResource at its
// real module-qualified path. Deleting the row reddens this through RequiresUndeclared + Absent.
test fn the_read_authoritys_fact_carries_its_rows_identity_at_declaration_key_holds() -> Bool {
  let fact = demand_census_seam_operation_fact(path: read_seam_path())
  if demand_census_declaration_is_host_seam(path: read_seam_path()) {
    fact.requirement == RequiresResources { resources: [filesystem_resource()] }
      && match reach_operation_semantics(op: fact) {
          Present { value: ObservesHost { operation_identity: identity } } =>
            identity == symbol_intern_lexeme(lexeme: "read_named_file")
          _ => false
        }
      && match reach_operation_reason(op: fact) {
          Present { value: ReachesDeclaredResource { operation: p } } => p == read_seam_path()
          _ => false
        }
  } else {
    false
  }
}

// ---- THE REAL PRODUCER'S REFUSAL, NAMED IN THE COMPILER'S OWN WORDS -------------------------------
// THE REFUSAL. The corpus module the walked claims would have resolved is refused where its absence is
// discovered: the module-root read. `module_root_find` is the one function `resolve_in_context`
// reaches for a subject root, and with roots no claim-carried ingest can supply (a claim authors its
// own bytes; only the driver's production_ingest makes file bytes the authority), it refuses at
// ^resolve_module_not_found -- NOT an "unresolved-module" string the claim invented (Diagnostic
// carries reason: Symbol and no code field), and NOT a silent Absent.
test fn a_real_corpus_module_is_refused_by_the_compilers_module_not_found_diagnostic_holds() -> Bool {
  match module_root_find(roots: Empty, name: qualified_name_from_dotted_string(dotted: "v2.std.data_index")) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^resolve_module_not_found
  }
}

// THE SAME REFUSAL THROUGH THE ROUTE THE WALKED CLAIMS WOULD HAVE TAKEN, so it is the compiler's
// refusal and not a fixture accident: the native test context carries ONE claim-authored witness (a
// novel module, which does resolve) and the corpus module is refused at the same diagnostic. This is
// also the control that reddens if the walked claims above are ever moved back onto a corpus-module
// route: the route refuses, by name.
test fn a_real_corpus_module_is_refused_by_name_in_the_native_test_context_holds() -> Bool {
  let trivial = DagSourceReadWitness {
    source: Medium {
      carried: "module v2.test.fixture.ods_trivial\n\ntype Trivial {\n  marker: Symbol\n}\n",
      fidelity: Lossless
    },
    artifact: Artifact { kind: SourceFile, id: ^ods_trivial_artifact, file_path: "src/v2/test/fixture/ods_trivial.dag" },
    compilation_unit: ^ods_trivial_artifact,
    source_root: V2Tree
  }
  match native_test_context_from_ingest(ingest: [trivial]) {
    Rejected { diagnostics: _ } => false
    Accepted { value: context, diagnostics: _ } =>
      match native_test_resolve_module(
        context: context,
        module: qualified_name_from_dotted_string(dotted: "v2.std.data_index")
      ).resolved {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } => d.head.reason == ^resolve_module_not_found
      }
  }
}

// A pure kernel seam touches no resource: its shape is the declared absence, never a Read shape
// borrowed from EffectShape (which has no arm for "no effect"), and no host-observing row claims it.
test fn a_pure_seam_declares_no_resource_access_and_no_host_row_does_holds() -> Bool {
  fold_list(
    xs: operation_declaration_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && match row.semantics {
        Pure => row.shape == NoResourceAccess && row.requirement == RequiresNone
        ObservesHost { operation_identity: _ } =>
          match row.shape {
            NoResourceAccess => false
            _ => true
          }
        _ => true
      }
    }
  )
}
