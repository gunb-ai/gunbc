  DeclaredTypeObligation,
  InhabitanceRefused,
  InhabitanceUndecidable,
  Inhabits,
  declared_type_inhabitance,
  inhabitance_occupancy_type,
  inhabitance_undecidable_reason_symbol,
  position_declared_return
}
