}
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }

import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_fatal,
  diagnostics_singleton,
  node_locus
}
import v2.std.integer { Int }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Conj, Node, Symbol, TypeNode, node_with_occurrence_id }
import std.occurrence_identity { OccurrenceSynthetic }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.qualified_name {
  qualified_name_from_dotted_string,
  qualified_name_to_dotted_string
}
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SOURCES ARE SUPPLIED AND THE ROUTE IS REAL (DESIGN section 3). The boundary these claims
// discriminate is v2.compiler.source_root_eval native_demand_census_report over an ingest, so its input --
// source bytes -- is constructed, and everything above it is the production front end, the real
// resolver and the D13 reducer. The fixture is a closed ingest whose uses fns are
// the controlled population the count-conservation claim is grounded in (DESIGN section 5: a literal
// grounded in a controlled fixture), one fn per verdict the census can reach:
//   restates      calls an operation declared `requires Network`                 -> equal
//   transitive    calls `restates`                                               -> equal
//   over_claims   authors Network and reaches nothing                             -> mismatch
//   opaque_reach  reaches an operation declared `requires opaque`                -> undecided
//   via_bare_service  calls an operation declared `requires none`                 -> mismatch
//                 (a service dependency is not a Network requirement)
//   fs_only       authors Filesystem and calls a Filesystem capability           -> equal in vocabulary;
//                 its row is out of vocabulary and counts toward the Filesystem audit
//   alias_used    its body names the uses alias; resolve does not bind it      -> unobserved
//   member_collision  calls t.http.H.net (requires none) beside H.Network (requires
//                 Network); spelling substitution would mint a false Equal     -> mismatch
//   let_shadows   `let net = p; net` — a local binder, not the uses alias      -> mismatch
//   duplicate_alias  two uses entries share the alias; first-match is refused   -> unobserved
data ddc_resources_source: String = "module std.resources\n\nresource Network {\n  kind: Capability\n  mode: Read\n}\n\nresource Filesystem {\n  kind: Capability\n  mode: ReadWrite\n  capability read {}\n}\n"

// The closed world supplies what its own sources import: every fixture below imports `std.types { Bool }`, and an ingest
// without that module refuses each importer at resolve (resolve_module_not_found), so no derivation claim reaches the reducer.
data ddc_types_source: String = "module std.types\n\ntype Bool = True | False\n"

data ddc_http_source: String = "module t.http\n\nimport std.resources { Network }\n\nservice H {\n  operation Get {\n    requires Network\n  }\n  operation Exec {\n    requires opaque\n  }\n  operation Ping {\n    requires none\n  }\n  operation net {\n    requires none\n  }\n  operation Network {\n    requires Network\n  }\n}\n"

data ddc_app_source: String = "module t.app\n\nimport std.resources { Network }\nimport std.types { Bool }\n\nfn restates(p: Bool) -> Bool uses net: Network {\n  let r = t.http.H.Get()\n  p\n}\n\nfn transitive(p: Bool) -> Bool uses net: Network {\n  restates(p: p)\n}\n\nfn over_claims(p: Bool) -> Bool uses net: Network {\n  p\n}\n\nfn opaque_reach(p: Bool) -> Bool uses net: Network {\n  let r = t.http.H.Exec()\n  p\n}\n\nfn via_bare_service(p: Bool) -> Bool uses net: Network {\n  let r = t.http.H.Ping()\n  p\n}\n\nfn fs_only(p: Bool) -> Bool uses fs: std.resources.Filesystem {\n  let r = std.resources.Filesystem.read()\n  p\n}\n\nfn mixed(p: Bool) -> Bool uses net: Network, fs: std.resources.Filesystem {\n  let r = t.http.H.Get()\n  let s = std.resources.Filesystem.read()\n  p\n}\n"

// A CALL THROUGH A FUNCTION VALUE, beside a direct Network call that would otherwise make the fn Equal.
// Its own module, so a refusal here cannot hide the other fns.
data ddc_valued_source: String = "module t.valued\n\nimport std.resources { Network }\nimport std.types { Bool }\n\nfn via_value(p: Bool) -> Bool uses net: Network {\n  let r = t.http.H.Get()\n  let g = t.app.restates\n  g(p: p)\n}\n\nfn via_param(p: Bool, g: fn(Bool) -> Bool) -> Bool uses net: Network {\n  let r = t.http.H.Get()\n  g(p: p)\n}\n"

// A USES FILE THE FRONT END REFUSES BEFORE AUTHORSHIP: a string that never terminates is refused at
// tokenize, so its uses fn is read by nobody and the census population is incomplete.
data ddc_broken_source: String = "module t.broken\n\nimport std.resources { Network }\n\nfn lost(p: Bool) -> Bool uses net: Network {\n  \"never terminates\n}\n"

// A CONSUMER OF THE REFUSED FILE above, and a CONTROL whose name is genuinely missing. Both import and call a name
// no index holds; only the first names a file the context refused, so only the first is a cascade member.
data ddc_relies_source: String = "module t.relies\n\nimport std.resources { Network }\nimport std.types { Bool }\nimport t.broken { lost }\n\nfn reads_refused(p: Bool) -> Bool uses net: Network {\n  lost(p: p)\n}\n"

data ddc_missing_source: String = "module t.missing_name\n\nimport std.resources { Network }\nimport std.types { Bool }\n\nfn reads_missing(p: Bool) -> Bool uses net: Network {\n  never_declared(p: p)\n}\n"

data ddc_alias_source: String = "module t.aliasing\n\nimport std.resources { Network }\nimport std.types { Bool }\n\nfn member_collision(p: Bool) -> Bool uses net: Network {\n  let r = t.http.H.net()\n  p\n}\n\nfn let_shadows(p: Bool) -> Bool uses net: Network {\n  let net = p\n  net\n}\n\nfn duplicate_alias(p: Bool) -> Bool uses net: Network, net: Network {\n  p\n}\n"

data ddc_alias_ref_source: String = "module t.alias_ref\n\nimport std.resources { Network }\nimport std.types { Bool }\n\nfn alias_used(p: Bool) -> Bool uses net: Network {\n  net\n}\n"

fn ddc_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data ddc_ingest: SourceRootIngest = [
  ddc_read(source: ddc_types_source, id: ^ddc_types_artifact, unit: ^ddc_types_cu, path: "dag/std/types.dag"),
  ddc_read(source: ddc_resources_source, id: ^ddc_resources_artifact, unit: ^ddc_resources_cu, path: "dag/std/resources.dag"),
  ddc_read(source: ddc_http_source, id: ^ddc_http_artifact, unit: ^ddc_http_cu, path: "dag/t/http.dag"),
  ddc_read(source: ddc_app_source, id: ^ddc_app_artifact, unit: ^ddc_app_cu, path: "dag/t/app.dag"),
  ddc_read(source: ddc_alias_source, id: ^ddc_alias_artifact, unit: ^ddc_alias_cu, path: "dag/t/aliasing.dag"),
  ddc_read(source: ddc_alias_ref_source, id: ^ddc_alias_ref_artifact, unit: ^ddc_alias_ref_cu, path: "dag/t/alias_ref.dag"),
  ddc_read(source: ddc_valued_source, id: ^ddc_valued_artifact, unit: ^ddc_valued_cu, path: "dag/t/valued.dag"),
  ddc_read(source: ddc_broken_source, id: ^ddc_broken_artifact, unit: ^ddc_broken_cu, path: "dag/t/broken.dag"),
  ddc_read(source: ddc_relies_source, id: ^ddc_relies_artifact, unit: ^ddc_relies_cu, path: "dag/t/relies.dag"),
  ddc_read(source: ddc_missing_source, id: ^ddc_missing_artifact, unit: ^ddc_missing_cu, path: "dag/t/missing_name.dag")
]

// Computed ONCE, enrolled WARM in v2.workflow.floor_pure_producer_share: every claim below reads the
// report rather than re-running the census (DESIGN section 3: their subject is the report).
fn ddc_report() -> Outcome<DemandCensusReport> {
  native_demand_census_report(ingest: ddc_ingest)
}

fn ddc_verdict(function: String) -> Optional<DemandCensusVerdict> {
  match ddc_report() {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: r, diagnostics: _ } =>
      fold_list(xs: r.rows, empty: optional_absent(), cons: fn(acc, row) {
        if qualified_name_to_dotted_string(qn: row.function) == function { optional_present(value: row.verdict) } else { acc }
      })
  }
}

fn ddc_is_equal(function: String) -> Bool {
  match ddc_verdict(function: function) {
    Absent => false
    Present { value: v } =>
      match v {
        CensusEqual => true
        CensusMismatch { authored: _, derived: _ } => false
        CensusUndecided { cause: _ } => false
        CensusUnobserved { reason: _ } => false
      }
  }
}

// COUNT CONSERVATION: the strip found the uses fns and the route emitted one row per fn, from a
// different fold than the one that counted them.
test fn every_uses_fn_gets_exactly_one_census_row_holds() -> Bool {
  match ddc_report() {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      (r.uses_functions == 15) && (length(xs: r.rows) == 15) && demand_census_conserved(r: r)
  }
}

test fn a_row_restating_a_called_network_operation_is_equal_holds() -> Bool {
  ddc_is_equal(function: "t.app.restates")
}

test fn demand_through_a_transparent_callee_is_equal_holds() -> Bool {
  ddc_is_equal(function: "t.app.transitive")
}

test fn a_row_claiming_network_the_body_never_reaches_is_a_mismatch_RED() -> Bool {
  match ddc_verdict(function: "t.app.over_claims") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusMismatch { authored: a, derived: d } => (length(xs: a) == 1) && (length(xs: d) == 0)
        CensusEqual => false
        CensusUndecided { cause: _ } => false
        CensusUnobserved { reason: _ } => false
      }
  }
}

// A SERVICE CALL IS NOT A NETWORK REQUIREMENT. Ping is declared `requires none`; reaching it does
// not put Network on derived demand, so the authored Network row is a mismatch and is not deletable.
test fn a_service_call_without_requires_network_does_not_derive_network_RED() -> Bool {
  match ddc_verdict(function: "t.app.via_bare_service") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusMismatch { authored: a, derived: d } => (length(xs: a) == 1) && (length(xs: d) == 0)
        CensusEqual => false
        CensusUndecided { cause: _ } => false
        CensusUnobserved { reason: _ } => false
      }
  }
}

test fn reaching_an_opaque_operation_is_undecided_by_that_cause_RED() -> Bool {
  match ddc_verdict(function: "t.app.opaque_reach") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusUndecided { cause: OpaqueOperationCalled { operation: o } } => qualified_name_to_dotted_string(qn: o) == "t.http.H.Exec"
        CensusUndecided { cause: _ } => false
        CensusEqual => false
        CensusMismatch { authored: _, derived: _ } => false
        CensusUnobserved { reason: _ } => false
      }
  }
}

test fn a_body_naming_its_uses_alias_stays_unobserved_until_resolve_binds_it_holds() -> Bool {
  match ddc_verdict(function: "t.alias_ref.alias_used") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusUnobserved { reason: _ } => true
        CensusEqual => false
        CensusMismatch { authored: _, derived: _ } => false
        CensusUndecided { cause: _ } => false
      }
  }
}

test fn a_qualified_member_sharing_the_alias_spelling_is_not_substituted_RED() -> Bool {
  match ddc_verdict(function: "t.aliasing.member_collision") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusMismatch { authored: a, derived: d } => (length(xs: a) == 1) && (length(xs: d) == 0)
        CensusEqual => false
        CensusUndecided { cause: _ } => false
        CensusUnobserved { reason: _ } => false
      }
  }
}

test fn a_let_binder_sharing_the_alias_spelling_is_not_substituted_RED() -> Bool {
  match ddc_verdict(function: "t.aliasing.let_shadows") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusMismatch { authored: a, derived: d } => (length(xs: a) == 1) && (length(xs: d) == 0)
        CensusEqual => false
        CensusUndecided { cause: _ } => false
        CensusUnobserved { reason: _ } => false
      }
  }
}

test fn duplicate_uses_aliases_leave_the_fn_unobserved_RED() -> Bool {
  match ddc_verdict(function: "t.aliasing.duplicate_alias") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusUnobserved { reason: UnobservedAliasConflict } => true
        CensusUnobserved { reason: _ } => false
        CensusEqual => false
        CensusMismatch { authored: _, derived: _ } => false
        CensusUndecided { cause: _ } => false
      }
  }
}

// Only the in-vocabulary rows of Equal fns are deletable: the Network rows of restates, transitive
// and mixed. The Filesystem rows of fs_only and mixed are out of vocabulary and count only
// toward that audit.
test fn only_equal_network_rows_are_deletable_and_filesystem_is_counted_apart_holds() -> Bool {
  match ddc_report() {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      (demand_census_deletable_rows(r: r) == 3) && (demand_census_out_of_vocabulary_agreeing(r: r, resource: qualified_name_from_dotted_string(dotted: "std.resources.Filesystem")) == 2)
  }
}

// THE PRODUCTION CONTROL: the elision is the census route's alone. Production lowering of the SAME
// t.app source still refuses at the clause (v2.compiler.body_lowering_fold
// body_lower_fn_uses_refusal_optional), so nothing outside the census lowers a uses fn. The outcome is
// computed once as a nullary Bool enrolled WARM in v2.workflow.floor_pure_producer_share, through the
// same single-source front end v2.test.claim.parse.uses_clause reads; building the whole four-module
// context for one refusal was over the new-witness budget.
fn ddc_app_production_refuses_at_the_clause() -> Bool {
  match conservation_subject_of_text(path: "dag/t/app.dag", text: ddc_app_source).normalized {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => diagnostics_fatal(d: d).reason == ^body_lowering_reason_uses_clause_unmodeled
  }
}

test fn production_lowering_of_the_same_fns_still_refuses_at_the_clause_holds() -> Bool {
  ddc_app_production_refuses_at_the_clause()
}

fn ddc_row_standings(function: String) -> List<AuthoredRowStanding> {
  match ddc_report() {
    Rejected { diagnostics: _ } => []
    Accepted { value: r, diagnostics: _ } =>
      fold_list(xs: r.rows, empty: [], cons: fn(acc, row) {
        if qualified_name_to_dotted_string(qn: row.function) == function { row.standings } else { acc }
      })
  }
}

fn ddc_is_deletable(st: AuthoredRowStanding, resource: String) -> Bool {
  match st {
    RowDeletable { resource: p } => qualified_name_to_dotted_string(qn: p) == resource
    RowMismatch { resource: _ } => false
    RowOutOfVocabulary { resource: _ } => false
    RowUndecided { resource: _, cause: _ } => false
    RowUnobserved { resource: _ } => false
    RowTypeUnresolved => false
  }
}

fn ddc_is_out_of_vocabulary(st: AuthoredRowStanding, resource: String) -> Bool {
  match st {
    RowOutOfVocabulary { resource: p } => qualified_name_to_dotted_string(qn: p) == resource
    RowDeletable { resource: _ } => false
    RowMismatch { resource: _ } => false
    RowUndecided { resource: _, cause: _ } => false
    RowUnobserved { resource: _ } => false
    RowTypeUnresolved => false
  }
}

// A FUNCTION-LEVEL EQUAL NEVER LICENSES BOTH ROWS. mixed restates Network and also authors Filesystem;
// its Network row is deletable and its Filesystem row is out of vocabulary, row by row.
test fn a_mixed_fn_licenses_only_its_in_vocabulary_row_RED() -> Bool {
  let sts = ddc_row_standings(function: "t.app.mixed")
  (length(xs: sts) == 2)
    && fold_list(xs: sts, empty: false, cons: fn(any, st) { any || ddc_is_deletable(st: st, resource: "std.resources.Network") })
    && fold_list(xs: sts, empty: false, cons: fn(any, st) { any || ddc_is_out_of_vocabulary(st: st, resource: "std.resources.Filesystem") })
    && !fold_list(xs: sts, empty: false, cons: fn(any, st) { any || ddc_is_deletable(st: st, resource: "std.resources.Filesystem") })
}

// THE REAL ROUTE READS A CALL THROUGH A FUNCTION VALUE: via_value's direct Network call would make it
// Equal, and the call through `g` makes it undecided by that cause instead.
test fn a_call_through_a_function_value_is_undecided_on_the_real_route_RED() -> Bool {
  match ddc_verdict(function: "t.valued.via_value") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusUndecided { cause: FunctionValueCalled { function: f } } => qualified_name_to_dotted_string(qn: f) == "t.valued.via_value"
        CensusUndecided { cause: _ } => false
        CensusEqual => false
        CensusMismatch { authored: _, derived: _ } => false
        CensusUnobserved { reason: _ } => false
      }
  }
}

// A USES FILE REFUSED BEFORE AUTHORSHIP MAKES THE POPULATION INCOMPLETE: the census counts it and exits 2
// (no observation), so conservation holding over the files that WERE read cannot read as held.
test fn a_uses_file_refused_before_authorship_is_an_incomplete_population_RED() -> Bool {
  match ddc_report() {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      (length(xs: r.unreadable) == 1)
        && (demand_census_exit(r: r) == 2)
        && match r.unreadable {
          Cons { head: u, tail: Empty } =>
            (u.file_path == "dag/t/broken.dag")
              && match u.stage {
                UnreadableAtTokenize => true
                UnreadableAtParse => false
              }
          Empty => false
          Cons { head: _, tail: _ } => false
        }
  }
}

// A CALL THROUGH A NAMED FUNCTION PARAMETER: via_param's direct Network call would make it Equal, and the
// call through its parameter `g` -- minted as a parameter reference, not a lexical one -- makes it
// undecided by that cause instead (review of gunbc#12992).
test fn a_call_through_a_function_parameter_is_undecided_on_the_real_route_RED() -> Bool {
  match ddc_verdict(function: "t.valued.via_param") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusUndecided { cause: FunctionValueCalled { function: f } } => qualified_name_to_dotted_string(qn: f) == "t.valued.via_param"
        CensusUndecided { cause: _ } => false
        CensusEqual => false
        CensusMismatch { authored: _, derived: _ } => false
        CensusUnobserved { reason: _ } => false
      }
  }
}


// A CONSUMER OF A FILE-REFUSED MODULE IS TOLD THE IMPORTEE WAS REFUSED, not that its name is unbound: the refused
// file's declarations never entered the index, so the unbound name is the symptom. The row files the import-target
// cause, names the refused file, and carries no unbound locus.
test fn a_consumer_of_a_file_refused_module_is_told_the_importee_was_refused_RED() -> Bool {
  match ddc_verdict(function: "t.relies.reads_refused") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusUnobserved { reason: UnobservedImporteeRefused { importee_file: f, importee_cause: _ } } => f == ^ddc_broken_cu
        CensusUnobserved { reason: _ } => false
        CensusEqual => false
        CensusMismatch { authored: _, derived: _ } => false
        CensusUndecided { cause: _ } => false
      }
  }
}

// THE CONTROL: a name no module declares, with no refused importee, still reports unbound at its locus.
test fn a_genuinely_missing_name_still_reports_unbound_holds() -> Bool {
  match ddc_verdict(function: "t.missing_name.reads_missing") {
    Absent => false
    Present { value: v } =>
      match v {
        CensusUnobserved { reason: UnobservedModuleResolveRefused { first_reason: r, first_unbound: u } } =>
          (r == ^resolve_reason_unbound_symbol)
            && match u { Present { value: _ } => true Absent => false }
        CensusUnobserved { reason: _ } => false
        CensusEqual => false
        CensusMismatch { authored: _, derived: _ } => false
        CensusUndecided { cause: _ } => false
      }
  }
}

// AN UNRESOLVED QUALIFIED PATH THROUGH THE REAL CENSUS DOOR, not a constructed declaration_reference
// node (parent REQUEST_CHANGES on #13995). The ingest has Network but not std.algebra / std.optional,
// so the type ascriptions refuse at resolve; first_unbound is the fatal the resolver located.
data ddc_shaped_fm_source: String = "module t.shaped_fm\n\nimport std.resources { Network }\n\nfn reads_freemonoid(p: Network) -> Network uses net: Network {\n  let xs: std.algebra.FreeMonoid<Network> = p\n  p\n}\n"

data ddc_shaped_opt_source: String = "module t.shaped_opt\n\nimport std.resources { Network }\n\nfn reads_optional(p: Network) -> Network uses net: Network {\n  let x: std.optional.Optional<Network> = p\n  p\n}\n"

data ddc_shaped_ingest: SourceRootIngest = [
  ddc_read(source: ddc_resources_source, id: ^ddc_resources_artifact, unit: ^ddc_resources_cu, path: "dag/std/resources.dag"),
  ddc_read(source: ddc_shaped_fm_source, id: ^ddc_shaped_fm_artifact, unit: ^ddc_shaped_fm_cu, path: "dag/t/shaped_fm.dag"),
  ddc_read(source: ddc_shaped_opt_source, id: ^ddc_shaped_opt_artifact, unit: ^ddc_shaped_opt_cu, path: "dag/t/shaped_opt.dag")
]

fn ddc_shaped_report() -> Outcome<DemandCensusReport> {
  native_demand_census_report(ingest: ddc_shaped_ingest)
}

fn ddc_shaped_unbound_text(function: String) -> String {
  match ddc_shaped_report() {
    Rejected { diagnostics: _ } => ""
    Accepted { value: r, diagnostics: _ } =>
      fold_list(xs: r.rows, empty: "", cons: fn(acc, row) {
        if qualified_name_to_dotted_string(qn: row.function) == function {
          match row.verdict {
            CensusUnobserved { reason: UnobservedModuleResolveRefused { first_reason: _, first_unbound: u } } =>
              demand_census_unbound_site_text(u: u)
            CensusUnobserved { reason: _ } => acc
            CensusEqual => acc
            CensusMismatch { authored: _, derived: _ } => acc
            CensusUndecided { cause: _ } => acc
          }
        } else {
          acc
        }
      })
  }
}

test fn a_shaped_unbound_names_std_algebra_freemonoid_RED() -> Bool {
  ddc_shaped_unbound_text(function: "t.shaped_fm.reads_freemonoid") == "unbound_ref=std.algebra.FreeMonoid"
}

test fn a_different_shaped_ref_renders_differently_holds() -> Bool {
  let a = ddc_shaped_unbound_text(function: "t.shaped_fm.reads_freemonoid")
  let b = ddc_shaped_unbound_text(function: "t.shaped_opt.reads_optional")
  (a == "unbound_ref=std.algebra.FreeMonoid")
    && (b == "unbound_ref=std.optional.Optional")
    && !(a == b)
}

// NO PATH WAS DERIVED, AND THAT IS ABSENT, not an empty name (review 80092). A conj with no
// children is a composite mention; shaped-reference lookup answers Absent, so the renderer must
// print unbound_kind=conj rather than unbound_ref=.
fn ddc_kind_only_node() -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: OccurrenceSynthetic
  )
}

test fn a_shaped_unbound_without_a_path_renders_kind_RED() -> Bool {
  demand_census_unbound_site_text(u: demand_census_unbound_locus_from_diagnostics(d: diagnostics_singleton(d: Diagnostic {
    reason: ^resolve_reason_unbound_symbol,
    at: node_locus(node: ddc_kind_only_node()),
    correction: Unavailable { reason: ExternalContractUnknown }
  }))) == "unbound_kind=conj"
}
