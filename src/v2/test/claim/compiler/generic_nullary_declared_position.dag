// file can stay Accepted.
type FsList<T>
  = FsEmpty
  | FsNonEmpty { head: T, tail: FsList<T> }

fn make() -> FsList<Int> { FsEmpty }

fn via_let() -> Int {
  let x: FsList<Int> = FsEmpty
  1
}

fn takes_int_list(xs: FsList<Int>) -> Int { 1 }

fn return_is_fslist_int() -> Int { takes_int_list(xs: make()) }

