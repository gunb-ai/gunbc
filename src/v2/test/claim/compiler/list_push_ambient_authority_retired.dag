module v2.test.claim.compiler.list_push_ambient_authority_retired

import v2.compiler.resolve { ResolvedTree }
import v2.test.claim.body_let_annotation { bla_assemble_with_peers, bla_source, bla_q_artifact }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import extdeps.filesystem.filesystem_io
import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE list_push AMBIENT AUTHORITY IS RETIRED (NAMESPACE-XL, chars precedent). The one authority for the
// name `list_push` is the declared import of its home (std.algebra `fn list_push<T>`, FreeMonoid's own
// snoc); the std.primitives `list_push_contract` row that let the last resolve tier admit the name with no
// import is DELETED, not aliased. THIS CLAIM READS THE REAL std.primitives CLOSURE FROM DISK, so it is RED
// against a tree where the ambient row still exists: a module using `list_push` WITHOUT the declared import
// refuses AT RESOLVE with resolve_reason_unbound_symbol. The control keeps the ambient tier honest (a name
// whose contract row stands, `to_string`, still binds), and the positive proves the declared import binds.

fn lpr_peer(path: String) -> DagSourceReadWitness {
  bla_source(src: filesystem_read(path: path).content, artifact: bla_q_artifact, cu: ^body_let_annotation_q_cu)
}

fn lpr_primitives_closure() -> List<DagSourceReadWitness> {
  [
    lpr_peer(path: "dag/std/primitives.dag"),
    lpr_peer(path: "dag/std/types.dag"),
    lpr_peer(path: "dag/std/algebra.dag"),
    lpr_peer(path: "dag/std/optional.dag"),
    lpr_peer(path: "dag/std/error_primitives.dag"),
    lpr_peer(path: "dag/std/unicode/types.dag")
  ]
}

fn lpr_resolve_reason(p_src: String) -> Symbol {
  match bla_assemble_with_peers(p_src: p_src, peers: lpr_primitives_closure()) {
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
    Accepted { value: tree, diagnostics: _ } => ^accepted
  }
}

// THE RED: no import of std.algebra, so no tier declares the name.
test fn list_push_without_the_declared_import_refuses_at_resolve() -> Bool {
  lpr_resolve_reason(p_src: "module p\n\nimport std.types { Int, List }\n\nfn f(xs: List<Int>) -> List<Int> {\n  list_push(xs: xs, item: 1)\n}\n")
    == ^resolve_reason_unbound_symbol
}

// THE CONTROL: the ambient tier is intact for a surviving contract row.
test fn surviving_contract_row_still_binds_at_resolve() -> Bool {
  lpr_resolve_reason(p_src: "module p\n\nfn f(x: Int) -> String {\n  to_string(x)\n}\n")
    == ^accepted
}

// THE POSITIVE: the declared import binds to the real std.algebra declaration (read from disk).
test fn declared_import_of_the_home_binds_where_ambient_refuses() -> Bool {
  lpr_resolve_reason(p_src: "module p\n\nimport std.types { Int, List }\nimport std.algebra { list_push }\n\nfn f(xs: List<Int>) -> List<Int> {\n  list_push(xs: xs, item: 1)\n}\n")
    == ^accepted
}
