module v2.test.claim.compiler.optional_native_controls

import v2.compiler.resolve { ResolvedTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model }
import std.algebra { Cons, Empty }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import std.types { Bool, String }
import v2.compiler.infer { infer }
import v2.test.claim.optional_sugar_declaration_bound { osd_std_optional }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data onc_artifact: Artifact = Artifact { kind: SourceFile, id: ^optional_native_controls_artifact, file_path: "src/v2/pilot/onc_pilot.dag" }
data onc_std_artifact: Artifact = Artifact { kind: SourceFile, id: ^optional_native_controls_std_artifact, file_path: "src/v2/pilot/onc_std_pilot.dag" }

// The cut's executed controls on the SUBSTITUTE route assemble_program_from_ingest -> infer (the native claim route is blocked on
// T1.0: native has no `none -> Absent` lowering). `T?` reaches infer as the std.optional Instantiation only.
fn onc_witness(src: String, artifact: Artifact) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: src, fidelity: Lossless },
    artifact: artifact,
    compilation_unit: ^optional_native_controls_cu,
    source_root: V2Tree
  }
}

fn onc_assemble(body: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: [
      onc_witness(src: concat("module p\n\nimport std.optional { Absent, Optional, Present }\n\n", body), artifact: onc_artifact),
      onc_witness(src: osd_std_optional(), artifact: onc_std_artifact)
    ],
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}

fn onc_infer_accepted(body: String) -> Bool {
  match onc_assemble(body: body) {
    Rejected { diagnostics: _ } => false
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

fn onc_assembles(body: String) -> Bool {
  match onc_assemble(body: body) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

test fn onc_absent_at_int_optional_accepts() -> Bool {
  onc_infer_accepted(body: "fn mk() -> Int? { Absent }\n")
}

test fn onc_present_int_at_int_optional_accepts() -> Bool {
  onc_infer_accepted(body: "fn mk() -> Int? { Present { value: 1 } }\n")
}

test fn onc_present_string_at_int_optional_refuses_at_the_payload() -> Bool {
  onc_assembles(body: "fn mk() -> Int? { Present { value: \"s\" } }\n") && !onc_infer_accepted(body: "fn mk() -> Int? { Present { value: \"s\" } }\n")
}

test fn onc_nested_optional_keeps_its_depth() -> Bool {
  onc_infer_accepted(body: "fn n(x: Optional<Int>?) -> Optional<Int>? { x }\n") && onc_assembles(body: "fn n(x: Optional<Int>?) -> Int? { x }\n") && !onc_infer_accepted(body: "fn n(x: Optional<Int>?) -> Int? { x }\n")
}

test fn onc_planted_error_refuses() -> Bool {
  onc_assembles(body: "fn bad() -> Bool { 1 }\n") && !onc_infer_accepted(body: "fn bad() -> Bool { 1 }\n")
}
