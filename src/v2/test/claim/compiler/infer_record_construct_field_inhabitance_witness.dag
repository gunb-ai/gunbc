data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A RECORD CONSTRUCT'S FIELD VALUES INHABIT THE FIELDS ITS RECORD DECLARES, OR INFER REFUSES.
//
// The subject is v2.compiler.infer infer_record_construct_facts: a construct whose tag resolves to a
// declared record is its constructor applied by name, so the one binding plan pairs each declared
// field with the value that fills it and the one judge (infer_judge_declared_position, at
// v2.std.inhabitance PositionRecordField) decides each pair under one instantiation of the record's
// binders. The class is gunbc.recurring_failure_mode
// construct_field_value_not_typed_against_the_record_declaration, and its specimen is rcf_bad_source.
//
// THE ROUTE IS REAL. Every claim reaches infer from inline source text through the production fold
// (tokenize, parse, normalize with body lowering, resolve through v2.compiler.name_resolve
// resolve_in_context), and infer is handed resolve's own ResolvedTree, index
// included. No tree here is hand-built, so deleting the record row, or the index read it depends on,
// turns the refusing claims green-to-red rather than leaving a designed fixture passing. Each
// subject's resolution is a nullary warm producer (v2.workflow.floor_pure_producer_share) and infer
// stays per claim.
//
// EVERY RED HAS A CONTROL ONE TERM AWAY. The specimen differs from the accepted module only in
// `n: true` against `n: 1`; the generic red only in `w: true` against `w: 2`. So no refusal here
// can be satisfied by a check that refuses every construct, and no acceptance by one that judges
// nothing: the accepted module is also asserted DECIDED (no counted obligation at its constructs).
//
// CROSS-MODULE FIELD VALUES ARE JUDGED TOO. A record declared in another module has its field SET
// checked (missing still refuses) and its field VALUES judged: `n: true` against `RcfFar.n: Int`
// refuses as `record_field_value_does_not_inhabit`, the same reason as a same-module Int field.
// The former pin (`UndecidableFormalUnresolved` on an Accepted construct) went red when that
// trigger landed.
data rcf_provider_source: String = "module v2.test.rcfp\n\ntype RcfFar {\n  n: Int\n  m: Int\n}\n"

data rcf_bad_source: String = "module v2.test.rcf_bad\n\ntype ArB {\n  n: Int\n  m: Int\n}\n\ndata ar_bad: ArB = ArB { n: true, m: 3 }\n"

data rcf_good_source: String = "module v2.test.rcf_good\n\ntype ArB {\n  n: Int\n  m: Int\n}\n\ndata ar_good: ArB = ArB { n: 1, m: 3 }\n"

data rcf_generic_good_source: String = "module v2.test.rcf_generic_good\n\ntype Bx<T> {\n  v: T\n  w: T\n}\n\ndata bx_good: Bx<Int> = Bx { v: 1, w: 2 }\n"

data rcf_nested_good_source: String = "module v2.test.rcf_nested_good\n\ntype ArB {\n  n: Int\n}\n\ntype ArOuter {\n  inner: ArB\n}\n\ndata ar_outer: ArOuter = ArOuter { inner: ArB { n: 1 } }\n"

data rcf_missing_source: String = "module v2.test.rcf_missing\n\ntype ArB {\n  n: Int\n  m: Int\n}\n\ndata ar_missing: ArB = ArB { n: 1 }\n"

data rcf_unknown_source: String = "module v2.test.rcf_unknown\n\ntype ArB {\n  n: Int\n  m: Int\n}\n\ndata ar_unknown: ArB = ArB { n: 1, m: 3, q: 4 }\n"

data rcf_generic_bad_source: String = "module v2.test.rcf_generic_bad\n\ntype Bx<T> {\n  v: T\n  w: T\n}\n\ndata bx_bad: Bx<Int> = Bx { v: 1, w: true }\n"

