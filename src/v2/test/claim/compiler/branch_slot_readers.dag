module v2.test.claim.compiler.branch_slot_readers

// WHAT THIS CLAIMS (gunbc.plans.demand_engine_program 2.4). A Branch's condition, then and else are read
// through the v2.std.node slot table (branch_positional_slot, branch_slot_target) by every consumer:
// v2.compiler.eval (eval_branch_condition), v2.program (program_choose_branch),
// v2.compiler.infer (infer_branch_bool_if_else) and v2.std.compilers.target_model
// (target_project_branch_bool_if_else, target_value_expr_branch_bool_gate). Each claim SUPPLIES a Branch
// at that consumer's own interface with a then arm different from the else arm, so a reader that takes the
// wrong slot answers differently; the shared-node controls make the condition the same node as an arm.

import std.algebra { Cons, Empty, PartialFunction }
import std.types { List }
import std.occurrence_identity { OccurrenceSynthetic }
import std.optional { Absent, Optional, Present, optional_present }
import v2.compiler.eval { empty_evaluation_environment, eval_with_context, inputs_root_only }
import v2.compiler.refinement_discharge { infer_and_discharge }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.compiler.resolve { ResolvedTree }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes, claim_resolved_tree_without_declarations }
import v2.compiler.target_serialize { translate_project_transform_in_arrow_scope }
import v2.extdeps.languages.dag { dag_int_literal_fixture_one, dag_int_literal_fixture_two, dag_type_atom_node, dag_value_expression_projection }
import v2.extdeps.languages.typescript { ts_binding_spellings, ts_fn_add_lex_rules, ts_source_text_authority }
import v2.program { program_bool_type, program_bool_value, program_choose_branch, program_i64_type, program_int_one_value, program_termination_proof, program_context_with_effect_io, program_kw_false, program_kw_true, program_literal_one, program_literal_two }
import v2.std.arrow_signature { declared_signature }
import v2.std.compilers.body_lowering { lower_branch }
import v2.std.compilers.lexing { ModeledLexRules }
import v2.std.compilers.target_model {
  PrimitiveRealizationsUnwired,
  ProducedDeclUnwired,
  TargetModel,
  TargetValueExpression,
  target_model_emit_transforms_empty,
  target_operator_realizations_catalog_node,
  target_project_arrow_body_to_value_expression,
  value_expr_projection_bundle_node
}
import v2.std.diagnostic { Accepted, Outcome, Rejected, node_locus }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Arrow,
  ArrowBodyEdge,
  Atom,
  Authored,
  ComputationNode,
  Branch,
  Conj,
  Edge,
  Node,
  NotADeclaration,
  Positional,
  Symbol,
  TypeNode,
  content_hash,
  core_edge,
  node_synthetic
}
import v2.std.node_query { binder_edge }
import v2.std.witness { Holds }
import v2.std.runtime { EvaluationEnvironment, RuntimeValue, RuntimeValuesEqual, runtime_value_equality }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn bsr_node_is(found: Optional<Node>, expected: Node) -> Bool {
  match found {
    Present { value: n } => content_hash(n: n) == content_hash(n: expected)
    Absent => false
  }
}

// ---- program_choose_branch: the interpreter that picks the arm ----

fn bsr_chosen_is(chosen: Outcome<Node>, expected: Node) -> Bool {
  match chosen {
    Accepted { value: n, diagnostics: _ } => content_hash(n: n) == content_hash(n: expected)
    Rejected { diagnostics: _ } => false
  }
}

test fn bsr_a_true_condition_chooses_the_then_arm_and_a_false_one_the_else_arm() -> Bool {
  let b = lower_branch(condition: program_kw_true(), then_arm: program_literal_one(), else_arm: program_literal_two())
  bsr_chosen_is(chosen: program_choose_branch(node: b, condition: program_bool_value(is_true: true), _env: bsr_env()), expected: program_literal_one())
    && bsr_chosen_is(chosen: program_choose_branch(node: b, condition: program_bool_value(is_true: false), _env: bsr_env()), expected: program_literal_two())
}

// The condition is the same node as the else arm: a reader that took the condition's value position for the
// else arm (or the reverse) would still pick the right node only by luck of position, so the arms differ.
test fn bsr_a_condition_equal_to_the_else_arm_still_chooses_by_slot() -> Bool {
  let b = lower_branch(condition: program_kw_false(), then_arm: program_literal_one(), else_arm: program_kw_false())
  bsr_chosen_is(chosen: program_choose_branch(node: b, condition: program_bool_value(is_true: false), _env: bsr_env()), expected: program_kw_false())
    && bsr_chosen_is(chosen: program_choose_branch(node: b, condition: program_bool_value(is_true: true), _env: bsr_env()), expected: program_literal_one())
}

test fn bsr_a_condition_equal_to_the_then_arm_still_chooses_by_slot() -> Bool {
  let b = lower_branch(condition: program_kw_true(), then_arm: program_kw_true(), else_arm: program_literal_two())
  bsr_chosen_is(chosen: program_choose_branch(node: b, condition: program_bool_value(is_true: true), _env: bsr_env()), expected: program_kw_true())
    && bsr_chosen_is(chosen: program_choose_branch(node: b, condition: program_bool_value(is_true: false), _env: bsr_env()), expected: program_literal_two())
}

test fn bsr_a_branch_with_a_fourth_positional_child_is_refused() -> Bool {
  let four = node_synthetic(
    kind: ComputationNode { behavior: Branch },
    children: [
      Edge { label: Positional, target: program_kw_true(), declaration: NotADeclaration },
      Edge { label: Positional, target: program_literal_one(), declaration: NotADeclaration },
      Edge { label: Positional, target: program_literal_two(), declaration: NotADeclaration },
      Edge { label: Positional, target: program_literal_two(), declaration: NotADeclaration }
    ]
  )
  match program_choose_branch(node: four, condition: program_bool_value(is_true: true), _env: bsr_env()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn bsr_reason_is(chosen: Outcome<Node>, reason: Symbol) -> Bool {
  match chosen {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == reason
  }
}

// The whole-node shape preflight (count(children) == 3) precedes the condition dispatch, so a malformed
// Branch with a non-Bool condition refuses with the SHAPE reason, not the condition reason.
test fn bsr_a_malformed_branch_with_a_non_bool_condition_refuses_with_the_shape_reason() -> Bool {
  let two = node_synthetic(
    kind: ComputationNode { behavior: Branch },
    children: [
      Edge { label: Positional, target: program_kw_true(), declaration: NotADeclaration },
      Edge { label: Positional, target: program_literal_one(), declaration: NotADeclaration }
    ]
  )
  bsr_reason_is(chosen: program_choose_branch(node: two, condition: program_literal_one_value(), _env: bsr_env()), reason: ^program_branch_shape_rejected)
}

// Three positionals plus an extra LABELED child: branch_slot_target counts positionals only, so the
// whole-node preflight is what refuses it.
test fn bsr_three_positionals_plus_a_labeled_child_is_refused() -> Bool {
  let extra = node_synthetic(
    kind: ComputationNode { behavior: Branch },
    children: [
      Edge { label: Positional, target: program_kw_true(), declaration: NotADeclaration },
      Edge { label: Positional, target: program_literal_one(), declaration: NotADeclaration },
      Edge { label: Positional, target: program_literal_two(), declaration: NotADeclaration },
      Edge { label: Authored { name: ^bsr_extra }, target: program_literal_two(), declaration: NotADeclaration }
    ]
  )
  bsr_reason_is(chosen: program_choose_branch(node: extra, condition: program_bool_value(is_true: true), _env: bsr_env()), reason: ^program_branch_shape_rejected)
}

fn program_literal_one_value() -> RuntimeValue {
  program_int_one_value()
}

fn bsr_env() -> EvaluationEnvironment {
  empty_evaluation_environment()
}

// ---- eval_branch_condition: eval reads the condition from its slot, then the interpreter picks ----

fn bsr_facts_int(node: Node) -> Optional<InferredFacts> {
  optional_present(value: bsr_facts_of(node: node, algebra: program_i64_type()))
}

fn bsr_facts_bool(node: Node) -> Optional<InferredFacts> {
  optional_present(value: bsr_facts_of(node: node, algebra: program_bool_type()))
}

fn bsr_facts_of(node: Node, algebra: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(resolved: node, algebra: algebra, descent: Holds { value: program_termination_proof() })
}

fn bsr_eval_with(root: Node, facts: fn(Node) -> Optional<InferredFacts>) -> Outcome<RuntimeValue> {
  eval_with_context(
    tree: InferredTree { root: root, facts: PartialFunction { lookup: facts } },
    context: program_context_with_effect_io(),
    inputs: inputs_root_only(root: root)
  )
}

// Int-typed fixtures (the arms are Int literals; the condition is a Bool the facts also type Int, which eval
// does not read) and Bool-typed fixtures (every node a Bool).
fn bsr_eval_int(root: Node) -> Outcome<RuntimeValue> {
  bsr_eval_with(root: root, facts: bsr_facts_int)
}

fn bsr_eval_bool(root: Node) -> Outcome<RuntimeValue> {
  bsr_eval_with(root: root, facts: bsr_facts_bool)
}

fn bsr_same_value(a: Outcome<RuntimeValue>, b: Outcome<RuntimeValue>) -> Bool {
  match a {
    Accepted { value: x, diagnostics: _ } =>
      match b {
        Accepted { value: y, diagnostics: _ } =>
          match runtime_value_equality(a: x, b: y) {
            RuntimeValuesEqual => true
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn bsr_eval_of_a_true_branch_is_the_then_arm_and_of_a_false_branch_the_else_arm() -> Bool {
  bsr_same_value(
    a: bsr_eval_int(root: lower_branch(condition: program_kw_true(), then_arm: program_literal_one(), else_arm: program_literal_two())),
    b: bsr_eval_int(root: program_literal_one())
  )
    && bsr_same_value(
      a: bsr_eval_int(root: lower_branch(condition: program_kw_false(), then_arm: program_literal_one(), else_arm: program_literal_two())),
      b: bsr_eval_int(root: program_literal_two())
    )
    && !bsr_same_value(a: bsr_eval_int(root: program_literal_one()), b: bsr_eval_int(root: program_literal_two()))
}

// Shared-node controls over Bool arms that differ (true, false): the condition is the same node as the else
// arm, then as the then arm.
test fn bsr_eval_with_the_condition_equal_to_the_else_arm_reads_each_slot_once() -> Bool {
  bsr_same_value(
    a: bsr_eval_bool(root: lower_branch(condition: program_kw_false(), then_arm: program_kw_true(), else_arm: program_kw_false())),
    b: bsr_eval_bool(root: program_kw_false())
  )
    && !bsr_same_value(a: bsr_eval_bool(root: program_kw_true()), b: bsr_eval_bool(root: program_kw_false()))
}

test fn bsr_eval_with_the_condition_equal_to_the_then_arm_reads_each_slot_once() -> Bool {
  bsr_same_value(
    a: bsr_eval_bool(root: lower_branch(condition: program_kw_true(), then_arm: program_kw_true(), else_arm: program_kw_false())),
    b: bsr_eval_bool(root: program_kw_true())
  )
}

// ---- infer_branch_bool_if_else ----

// then (an Int literal) and else (a Bool literal) differ in type, so unification refuses, and it refuses AT
// THE THEN ARM: the located node proves which slot was read as the then arm.
fn bsr_infer_rejection_locus_is(root: Node, expected: Node) -> Bool {
  match infer_and_discharge(tree: bsr_resolved(root: root)) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.at == node_locus(node: expected)
  }
}

fn bsr_resolved(root: Node) -> ResolvedTree {
  claim_resolved_tree_without_declarations(root: root)
}

fn bsr_infers(root: Node) -> Bool {
  match infer_and_discharge(tree: bsr_resolved(root: root)) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn bsr_infer_admits_a_bool_condition_with_agreeing_arms() -> Bool {
  bsr_infers(root: lower_branch(condition: program_kw_true(), then_arm: dag_int_literal_fixture_one(), else_arm: dag_int_literal_fixture_two()))
}

test fn bsr_infer_refuses_an_int_in_the_condition_slot() -> Bool {
  !bsr_infers(root: lower_branch(condition: dag_int_literal_fixture_one(), then_arm: program_kw_true(), else_arm: program_kw_false()))
}

test fn bsr_infer_locates_an_arm_mismatch_at_the_then_arm() -> Bool {
  bsr_infer_rejection_locus_is(
    root: lower_branch(condition: program_kw_true(), then_arm: dag_int_literal_fixture_one(), else_arm: program_kw_false()),
    expected: dag_int_literal_fixture_one()
  )
}

// Condition equal to the else arm (both the bool `true` node), then an Int: the mismatch is still the then arm.
test fn bsr_infer_with_the_condition_equal_to_the_else_arm_locates_at_the_then_arm() -> Bool {
  bsr_infer_rejection_locus_is(
    root: lower_branch(condition: program_kw_true(), then_arm: dag_int_literal_fixture_one(), else_arm: program_kw_true()),
    expected: dag_int_literal_fixture_one()
  )
}

// ---- target_project_branch_bool_if_else (and its target_value_expr_branch_bool_gate) ----

fn bsr_atom(id: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: id } }, children: [])
}

fn bsr_named(name: Symbol, target: Node) -> Edge {
  Edge { label: Authored { name: name }, target: target, declaration: NotADeclaration }
}

fn bsr_fn(body: Node) -> Node {
  let signature = declared_signature(
    params: [binder_edge(name: ^bsr_x, type_node: bsr_atom(id: ^fold_call_type_int))],
    source: bsr_atom(id: ^fold_call_type_int)
  )
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      signature.domain,
      Edge { label: Positional, target: bsr_atom(id: ^fold_call_type_int), declaration: NotADeclaration },
      signature.order,
      core_edge(marker: ArrowBodyEdge, target: body)
    ]
  )
}

fn bsr_target_model() -> TargetModel {
  TargetModel {
    primitive_realizations: PrimitiveRealizationsUnwired,
    produced_decl_support: ProducedDeclUnwired,
    bundle: node_synthetic(
      kind: TypeNode { connective: Conj },
      children: [
        bsr_named(
          name: ^target_model_edge_value_expression_projection,
          target: value_expr_projection_bundle_node(projection: dag_value_expression_projection())
        ),
        bsr_named(
          name: ^target_model_edge_operator_realizations,
          target: target_operator_realizations_catalog_node(rows: [])
        )
      ]
    ),
    lex: ModeledLexRules { root: ts_fn_add_lex_rules() },
    binding_spellings: ts_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: ts_source_text_authority(),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn bsr_project(body: Node) -> Outcome<TargetValueExpression> {
  target_project_arrow_body_to_value_expression(
    arrow: bsr_fn(body: body),
    target: bsr_target_model(),
    source_bool_form: dag_value_expression_projection().bool_literal_form,
    handle_transform: fn(a, b, t) { translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t) }
  )
}

fn bsr_field(wire: Node, name: Symbol) -> Optional<Node> {
  bsr_field_in(edges: wire.children, name: name)
}

fn bsr_field_in(edges: List<Edge>, name: Symbol) -> Optional<Node> {
  match edges {
    Empty => Absent
    Cons { head: e, tail: rest } => bsr_field_edge(e: e, rest: rest, name: name)
  }
}

fn bsr_field_edge(e: Edge, rest: List<Edge>, name: Symbol) -> Optional<Node> {
  match e.label {
    Authored { name: n } =>
      if n == name { optional_present(value: e.target) } else { bsr_field_in(edges: rest, name: name) }
    _ => bsr_field_in(edges: rest, name: name)
  }
}

fn bsr_projected_node(body: Node) -> Optional<Node> {
  match bsr_project(body: body) {
    Accepted { value: e, diagnostics: _ } => optional_present(value: e.node)
    Rejected { diagnostics: _ } => Absent
  }
}

// The three projected arms are each the projection of that arm ALONE: the then arm is the parameter
// reference `x`, the else arm the bool literal `false`, the condition the bool literal `true`.
fn bsr_conditional_slots_hold(cond: Node, then_arm: Node, else_arm: Node) -> Bool {
  match bsr_projected_node(body: lower_branch(condition: cond, then_arm: then_arm, else_arm: else_arm)) {
    Absent => false
    Present { value: wire } =>
      bsr_node_is(found: bsr_field(wire: wire, name: ^target_value_expr_field_branch_condition), expected: bsr_expected(body: cond))
        && bsr_node_is(found: bsr_field(wire: wire, name: ^target_value_expr_field_branch_then_arm), expected: bsr_expected(body: then_arm))
        && bsr_node_is(found: bsr_field(wire: wire, name: ^target_value_expr_field_branch_else_arm), expected: bsr_expected(body: else_arm))
        && !(content_hash(n: bsr_expected(body: then_arm)) == content_hash(n: bsr_expected(body: else_arm)))
  }
}

fn bsr_expected(body: Node) -> Node {
  match bsr_projected_node(body: body) {
    Present { value: n } => n
    Absent => body
  }
}

test fn bsr_target_projects_condition_then_and_else_from_their_own_slots() -> Bool {
  bsr_conditional_slots_hold(cond: bsr_atom(id: ^dag_token_kw_true), then_arm: bsr_atom(id: ^bsr_x), else_arm: bsr_atom(id: ^dag_token_kw_false))
}

// Condition equal to the else arm.
test fn bsr_target_with_the_condition_equal_to_the_else_arm_keeps_each_slot() -> Bool {
  bsr_conditional_slots_hold(cond: bsr_atom(id: ^dag_token_kw_true), then_arm: bsr_atom(id: ^bsr_x), else_arm: bsr_atom(id: ^dag_token_kw_true))
}

// Condition equal to the then arm.
test fn bsr_target_with_the_condition_equal_to_the_then_arm_keeps_each_slot() -> Bool {
  bsr_conditional_slots_hold(cond: bsr_atom(id: ^dag_token_kw_true), then_arm: bsr_atom(id: ^dag_token_kw_true), else_arm: bsr_atom(id: ^bsr_x))
}

// The gate: a non-bool-literal in the condition slot refuses even when a bool literal is in an arm slot.
test fn bsr_target_refuses_a_non_bool_literal_in_the_condition_slot() -> Bool {
  match bsr_project(body: lower_branch(condition: bsr_atom(id: ^bsr_x), then_arm: bsr_atom(id: ^dag_token_kw_true), else_arm: bsr_atom(id: ^dag_token_kw_false))) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
