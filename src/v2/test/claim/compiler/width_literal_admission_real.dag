module v2.test.claim.compiler.width_literal_admission_real

import v2.compiler.infer { infer }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model }
import extdeps.communication.medium { Lossless, Medium }
import extdeps.filesystem.filesystem_io { Filesystem }
import std.algebra { Cons, Empty, fold_list, list_snoc_item }
import v2.std.cross_tree.import_model { DagTree, V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_fatal_reason }
import v2.std.node { Symbol, symbol_intern_lexeme }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE PAIRING CLAIM FOR v2.test.claim.compiler.width_literal_admission (DESIGN section 3: a supplied boundary owes ONE
// inhabitance claim that the real producer reaches it). That file restates std.integer's Int, UInt, UInt8 and Int8 as
// peers; THIS file assembles the REAL std.integer import closure from dag/ and infers a call that passes 300 to a
// UInt8 formal, so the real producer's Compose<UInt, MachineWidth<8>> is what reaches infer. Deleting the
// restated-peer route leaves this one; deleting the real route leaves the peers, and this goes red.
// The closure is the transitive imports of std.integer; a change to them that this list omits refuses at assembly
// (a located unresolved-import diagnostic), never a silent pass.
data wlr_closure: List<String> = ["dag/extdeps/currency/currency.dag", "dag/extdeps/external_authority.dag", "dag/extdeps/units/dimensionless.dag", "dag/extdeps/units/iec_80000_13.dag", "dag/extdeps/units/iso8601.dag", "dag/extdeps/units/iso_80000_3.dag", "dag/extdeps/uri.dag", "dag/std/algebra.dag", "dag/std/checked_arithmetic.dag", "dag/std/computation.dag", "dag/std/constructors.dag", "dag/std/decimal.dag", "dag/std/decl_ref.dag", "dag/std/dissolution.dag", "dag/std/error_primitives.dag", "dag/std/induction.dag", "dag/std/integer.dag", "dag/std/keyed_roster.dag", "dag/std/keyed_row.dag", "dag/std/machine_constraints.dag", "dag/std/measure.dag", "dag/std/nat.dag", "dag/std/optional.dag", "dag/std/render_repeat_string_bootstrap.dag", "dag/std/roster_frontier.dag", "dag/std/termination.dag", "dag/std/types.dag", "dag/std/unicode/types.dag"]

fn wlr_witness(path: String, root: Symbol) -> DagSourceReadWitness {
  let read = Filesystem.Read(path: path)
  DagSourceReadWitness {
    source: Medium { carried: read.content, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: symbol_intern_lexeme(lexeme: path), file_path: path },
    compilation_unit: symbol_intern_lexeme(lexeme: path),
    source_root: DagTree
  }
}

fn wlr_ingest(src: String) -> List<DagSourceReadWitness> {
  fold_list(
    xs: wlr_closure,
    empty: [DagSourceReadWitness {
      source: Medium { carried: src, fidelity: Lossless },
      artifact: Artifact { kind: SourceFile, id: ^width_literal_admission_real_p, file_path: "src/v2/pilot/width_literal_admission_real_p.dag" },
      compilation_unit: ^width_literal_admission_real_p_cu,
      source_root: V2Tree
    }],
    cons: fn(acc, path) { list_snoc_item(xs: acc, item: wlr_witness(path: path, root: ^dag)) }
  )
}

fn wlr_reason(literal: String) -> Symbol {
  let src = concat(concat("module p\n\nimport std.integer { UInt8 }\n\nfn g(n: UInt8) -> Bool {\n  true\n}\n\nfn uses() -> Bool {\n  g(n: ", literal), ")\n}\n")
  match assemble_program_from_ingest(
    ingest: wlr_ingest(src: src),
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  ) {
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
    Accepted { value: resolved, diagnostics: _ } =>
      match infer(tree: resolved) {
        Accepted { value: _, diagnostics: _ } => ^accepted
        Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
      }
  }
}

// POSITIVE CONTROL on the real closure: 255 at the real UInt8 is accepted, so the refusal below is the width's.
test fn wlr_real_uint8_255_is_admitted() -> Bool { wlr_reason(literal: "255") == ^accepted }

// RED on the real closure: 300 at the real UInt8 refuses with the width's reason.
test fn wlr_real_uint8_300_refuses() -> Bool { wlr_reason(literal: "300") == ^infer_reason_literal_outside_machine_width }

test fn wlr_probe_assembly_accepts() -> Bool {
  match assemble_program_from_ingest(
    ingest: wlr_ingest(src: "module p\n\nimport std.integer { UInt8 }\n\nfn g(n: UInt8) -> Bool {\n  true\n}\n\nfn uses() -> Bool {\n  g(n: 255)\n}\n"),
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}
test fn wlr_probe_unbound() -> Bool { wlr_reason(literal: "255") == ^resolve_reason_unbound_symbol }
test fn wlr_probe_declarer() -> Bool { wlr_reason(literal: "255") == ^resolve_reason_declarer_refused }
test fn wlr_probe_grounding() -> Bool { wlr_reason(literal: "255") == ^infer_grounding_not_derived }
test fn wlr_probe_outside() -> Bool { wlr_reason(literal: "255") == ^infer_reason_literal_outside_machine_width }
