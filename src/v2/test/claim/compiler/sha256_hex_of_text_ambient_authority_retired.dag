module v2.test.claim.compiler.sha256_hex_of_text_ambient_authority_retired

import v2.compiler.resolve { ResolvedTree }
import v2.test.claim.body_let_annotation { bla_assemble_with_peers, bla_source, bla_q_artifact }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import extdeps.filesystem.filesystem_io
import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE sha256_hex_of_text AMBIENT AUTHORITY IS RETIRED (NAMESPACE-XL, the chars and list_push precedent; root-coordinator
// decision, sleek-owl-397). The one authority for the name is the declared import of its home (std.content_hash
// `fn sha256_hex_of_text(text: String) -> String`, UTF-8 encode then SHA-256 then lowercase hex); the std.primitives
// `sha256_hex_of_text_contract` row that let the last resolve tier admit the name with no import is DELETED, not
// aliased. THIS CLAIM READS THE REAL std.primitives AND std.content_hash FROM DISK, so it is RED against a tree where the
// ambient row still exists: a module using the name WITHOUT the declared import refuses AT RESOLVE with
// resolve_reason_unbound_symbol. The control keeps the ambient tier honest (a name whose contract row stands,
// `to_string`, still binds), and the positive proves the declared import binds.

fn shr_peer(path: String) -> DagSourceReadWitness {
  bla_source(src: filesystem_read(path: path).content, artifact: bla_q_artifact, cu: ^body_let_annotation_q_cu)
}

fn shr_closure() -> List<DagSourceReadWitness> {
  [
    shr_peer(path: "dag/std/primitives.dag"),
    shr_peer(path: "dag/std/types.dag"),
    shr_peer(path: "dag/std/algebra.dag"),
    shr_peer(path: "dag/std/optional.dag"),
    shr_peer(path: "dag/std/error_primitives.dag"),
    shr_peer(path: "dag/std/unicode/types.dag"),
    shr_peer(path: "dag/std/host_text.dag"),
    shr_peer(path: "dag/std/content_hash.dag")
  ]
}

fn shr_resolve_reason(p_src: String) -> Symbol {
  match bla_assemble_with_peers(p_src: p_src, peers: shr_closure()) {
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
    Accepted { value: tree, diagnostics: _ } => ^accepted
  }
}

// THE RED: no import of std.content_hash, so no tier declares the name.
test fn sha256_hex_of_text_without_the_declared_import_refuses_at_resolve() -> Bool {
  shr_resolve_reason(p_src: "module p\n\nimport std.types { String }\n\nfn f(t: String) -> String {\n  sha256_hex_of_text(text: t)\n}\n")
    == ^resolve_reason_unbound_symbol
}

// THE CONTROL: the ambient tier is intact for a surviving contract row.
test fn surviving_contract_row_still_binds_at_resolve() -> Bool {
  shr_resolve_reason(p_src: "module p\n\nfn f(x: Int) -> String {\n  to_string(x)\n}\n")
    == ^accepted
}

// THE POSITIVE: the declared import binds to the real std.content_hash declaration (read from disk).
test fn declared_import_of_the_home_binds_where_ambient_refuses() -> Bool {
  shr_resolve_reason(p_src: "module p\n\nimport std.types { String }\nimport std.content_hash { sha256_hex_of_text }\n\nfn f(t: String) -> String {\n  sha256_hex_of_text(text: t)\n}\n")
    == ^accepted
}
