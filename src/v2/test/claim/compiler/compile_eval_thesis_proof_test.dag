module v2.test.claim.compiler.compile_eval_thesis_proof

import v2.compiler.compile {
  Eval,
  EvalResult,
  compile,
  compile_inferred
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.runtimes.v2_evaluator {
  v2_eval_bool_literal_pin,
  v2_eval_bool_true_primitive,
  v2_eval_unit_literal_pin
}
import extdeps.communication.medium { Lossless, Lossy, Medium }
import v2.std.collection { Map }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node }
import v2.std.optional {
  Optional,
  Absent,
  Present,
  optional_absent,
  optional_present
}
import v2.std.runtime {
  RuntimeValueNodeProjected,
  RuntimeValueNodeUnrepresentable,
  runtime_value_node_projection
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v2.std.witness { Holds }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn compile_eval_thesis_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^compile_eval_thesis_descent_dimension }
  }
}

fn compile_eval_thesis_facts_lookup(key: Node) -> Optional<InferredFacts> {
  if key == v2_eval_bool_literal_pin {
    optional_present(value: claim_inferred_facts_from_nodes(
        resolved: v2_eval_bool_literal_pin,
        algebra: v2_eval_bool_literal_pin,
        descent: Holds { value: compile_eval_thesis_termination_proof() }
      ))
  } else if key == v2_eval_unit_literal_pin {
    optional_present(value: claim_inferred_facts_from_nodes(
        resolved: v2_eval_unit_literal_pin,
        algebra: v2_eval_unit_literal_pin,
        descent: Holds { value: compile_eval_thesis_termination_proof() }
      ))
  } else {
    optional_absent()
  }
}

fn compile_eval_thesis_inferred(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: compile_eval_thesis_facts_lookup
    }
  }
}

fn compile_eval_thesis_expected_bool_node() -> Node {
  match runtime_value_node_projection(value: v2_eval_bool_true_primitive()) {
    RuntimeValueNodeProjected { node: n } => n
    RuntimeValueNodeUnrepresentable => v2_eval_bool_literal_pin
  }
}

fn compile_eval_thesis_medium_matches_expected(medium: Medium<Node>) -> Bool {
  match medium.fidelity {
    Lossless => medium.carried == compile_eval_thesis_expected_bool_node()
    Lossy => false
  }
}

test fn compile_eval_bool_reaches_node_value_holds() -> Bool {
  match compile_inferred(
    inferred: compile_eval_thesis_inferred(root: v2_eval_bool_literal_pin),
    mode: Eval { runtime: v2_eval_bool_literal_pin }
  ) {
    Accepted { value: EvalResult { value: actual }, diagnostics: _ } =>
      compile_eval_thesis_medium_matches_expected(medium: actual)
    Rejected { diagnostics: _ } => false
  }
}

test fn compile_eval_bool_via_compile_entry_holds() -> Bool {
  match compile(
    source: v2_eval_bool_literal_pin,
    mode: Eval { runtime: v2_eval_bool_literal_pin }
  ) {
    Accepted { value: EvalResult { value: actual }, diagnostics: _ } =>
      compile_eval_thesis_medium_matches_expected(medium: actual)
    Rejected { diagnostics: _ } => false
  }
}

test fn compile_eval_unit_unrepresentable_red_holds() -> Bool {
  match compile_inferred(
    inferred: compile_eval_thesis_inferred(root: v2_eval_unit_literal_pin),
    mode: Eval { runtime: v2_eval_unit_literal_pin }
  ) {
    Rejected { diagnostics: d } =>
      d.head.reason == ^eval_rejected_runtime_value_node_unrepresentable
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn isolate_t1_holds() -> Bool {
  compile_eval_bool_reaches_node_value_holds()
}

test fn isolate_t2_holds() -> Bool {
  compile_eval_bool_via_compile_entry_holds()
}

test fn isolate_t3_holds() -> Bool {
  compile_eval_unit_unrepresentable_red_holds()
}
