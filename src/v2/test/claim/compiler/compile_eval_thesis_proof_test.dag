module v2.test.claim.compiler.compile_eval_thesis_proof

import v2.compiler.eval { eval_diagnostic }
import v2.compiler.compile {
  Eval,
  EvalResult,
  compile,
  compile_inferred
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.runtimes.v2_evaluator {
  v2_eval_wave1_bool_literal_pin,
  v2_eval_wave1_bool_true_primitive,
  v2_eval_wave1_unit_literal_pin
}
import v2.std.cardinality { RankingDimension, TerminationProof }
import v2.std.collection { Map }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.runtime {
  RuntimeValueNodeProjected,
  RuntimeValueNodeUnrepresentable,
  runtime_value_node_projection
}
import v2.std.witness { Holds, Violates, Witness }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_from_nodes }

fn compile_eval_thesis_termination_proof() -> TerminationProof {
  TerminationProof {
    non_increasing: [],
    strict: RankingDimension { measured: ^compile_eval_thesis_descent_dimension }
  }
}

fn compile_eval_thesis_facts_lookup(key: Node) -> Witness<InferredFacts> {
  if key == v2_eval_wave1_bool_literal_pin {
    Holds {
      value: claim_inferred_facts_from_nodes(
        resolved: v2_eval_wave1_bool_literal_pin,
        algebra: v2_eval_wave1_bool_literal_pin,
        descent: Holds { value: compile_eval_thesis_termination_proof() }
      )
    }
  } else if key == v2_eval_wave1_unit_literal_pin {
    Holds {
      value: claim_inferred_facts_from_nodes(
        resolved: v2_eval_wave1_unit_literal_pin,
        algebra: v2_eval_wave1_unit_literal_pin,
        descent: Holds { value: compile_eval_thesis_termination_proof() }
      )
    }
  } else {
    Violates {
      diagnostic: eval_diagnostic(reason: ^compile_eval_thesis_facts_miss, node: key)
    }
  }
}

fn compile_eval_thesis_inferred(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: compile_eval_thesis_facts_lookup
    }
  }
}

fn compile_eval_thesis_expected_bool_node() -> Node {
  match runtime_value_node_projection(value: v2_eval_wave1_bool_true_primitive()) {
    RuntimeValueNodeProjected { node: n } => n
    RuntimeValueNodeUnrepresentable => v2_eval_wave1_bool_literal_pin
  }
}

fn compile_eval_thesis_medium_matches_expected(medium: Medium<Node>) -> Bool {
  match medium.fidelity {
    Lossless => medium.carried == compile_eval_thesis_expected_bool_node()
    Lossy => false
  }
}

fn compile_eval_bool_reaches_node_value_holds() -> Bool {
  match compile_inferred(
    inferred: compile_eval_thesis_inferred(root: v2_eval_wave1_bool_literal_pin),
    mode: Eval { runtime: v2_eval_wave1_bool_literal_pin }
  ) {
    Accepted { value: EvalResult { value: actual }, diagnostics: _ } =>
      compile_eval_thesis_medium_matches_expected(medium: actual)
    Rejected { diagnostics: _ } => false
  }
}

fn compile_eval_bool_via_compile_entry_holds() -> Bool {
  match compile(
    source: v2_eval_wave1_bool_literal_pin,
    mode: Eval { runtime: v2_eval_wave1_bool_literal_pin }
  ) {
    Accepted { value: EvalResult { value: actual }, diagnostics: _ } =>
      compile_eval_thesis_medium_matches_expected(medium: actual)
    Rejected { diagnostics: _ } => false
  }
}

fn compile_eval_unit_unrepresentable_red_holds() -> Bool {
  match compile_inferred(
    inferred: compile_eval_thesis_inferred(root: v2_eval_wave1_unit_literal_pin),
    mode: Eval { runtime: v2_eval_wave1_unit_literal_pin }
  ) {
    Rejected { diagnostics: d } =>
      d.head.reason == ^eval_rejected_runtime_value_node_unrepresentable
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn compile_eval_thesis_proof_holds() -> Bool {
  compile_eval_bool_reaches_node_value_holds()
    && compile_eval_bool_via_compile_entry_holds()
    && compile_eval_unit_unrepresentable_red_holds()
}
