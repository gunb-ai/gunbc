module v2.test.claim.compiler.nominal_application_child_edge_shape

// PROBE (node adhoc-afb0f800-78c): what does a lowered nominal type-application look like on the two sides
// of a declared-type judgment -- the declared position's annotation and the produced position's inferred
// type -- and does the difference between them reach the child Edge LABELS?
//
// v2.std.exact_structural_equality_zip_fold_predicate's descent (the arm #15868 adds) decides a child pair
// by its Edge label BEFORE its target, so a label that differs between the two producers reports as a TYPE
// mismatch on every nominal application. The cells below separate the two readings without a local run:
// every cell is a whole-module read through the real resolver and infer, and each asks one question.
//
// DISSOLUTION CONDITION, stated up front because §6 asks for it: this file is the instrument that
// measures the mismatch, and it does not outlive the fix it measures. When the lowering lands, every cell
// whose verdict is SETTLED stays -- renamed to the contract it guards, in the PR that carries the fix, as
// the regression control that would have caught the bug -- and every cell that only measured is DELETED in
// that same commit. Nothing here is left standing as scaffold: no cell survives unless it asserts a
// settled verdict about the fixed contract.
//
// Reading the table while the measurement is open: a cell RED where it is written ACCEPT means the two
// sides of that program are NOT structurally identical, which is the lowering mismatch; a cell RED where it
// is written REFUSE means the judge is answering for a reason other than the one named.
import v2.compiler.name_resolve { Admission, ResolutionSubject, resolution_context, resolve_in_context }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.source_authority { SourceRootIngest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.node { Symbol }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.std.text { String }
import std.algebra { Cons, Empty, list_at_optional }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.compiler.infer { infer_type_alias_normalized_at }
import v2.std.node {
  all_edges_positional,
  Ambiguous,
  ComputationNode,
  Edge,
  Found,
  Instantiation,
  Node,
  NotFound,
  TypeNode,
  arrow_body_target_lookup,
  node_equal_ignoring_provenance,
  positional_child_target_nodes
}
import v2.std.symbol_index { symbol_index_lookup }
import v2.std.qualified_name { declaration_denotation_of_type }
import v2.test.claim.compiler.infer_record_construct_field_inhabitance_witness {
  RcfInferAccepted,
  RcfInferRefused,
  RcfResolveRefused,
  rcf_read_in,
  rcf_refusal,
  rcf_verdict
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data nal_algebra_source: String = "module std.algebra\n\nopaque type FreeMonoid<element>\n"

// Pair is a transparent alias whose body is a PRODUCT, so its members carry the structural labels
// first and second; List is a transparent alias of an OPAQUE nominal, so its body has no member
// labels at all. A mismatch that appears for Pair and not for List is the member labels.
data nal_types_source: String = "module std.types\n\nimport std.algebra { FreeMonoid }\n\ntype List<element> = FreeMonoid<element>\n\ntype Pair<A, B> = Mk { first: A, second: B }\n"

fn nal_mono_source(module_name: String, formal: String, result: String) -> String {
  join(
    [
      "module ",
      module_name,
      "\n\nimport std.types { Pair, List }\n\nfn nal_take(p: ",
      formal,
      ") -> ",
      result,
      " {\n  p\n}\n"
    ],
    ""
  )
}

fn nal_generic_source(module_name: String, formal: String, result: String) -> String {
  join(
    [
      "module ",
      module_name,
      "\n\nimport std.types { Pair, List }\n\nfn nal_take<K>(p: ",
      formal,
      ") -> ",
      result,
      " {\n  p\n}\n"
    ],
    ""
  )
}

data nal_ingest: SourceRootIngest = [
  rcf_read_in(tree: DagTree, source: nal_algebra_source, id: ^nal_algebra_read, unit: ^nal_algebra_cu, path: "dag/std/algebra.dag"),
  rcf_read_in(tree: DagTree, source: nal_types_source, id: ^nal_types_read, unit: ^nal_types_cu, path: "dag/std/types.dag"),
  rcf_read_in(tree: DagTree, source: nal_mono_source(module_name: "gunbc.nal_concrete_ident", formal: "Pair<Int, String>", result: "Pair<Int, String>"), id: ^nal_concrete_ident_read, unit: ^nal_concrete_ident_cu, path: "dag/gunbc/nal_concrete_ident.dag"),
  rcf_read_in(tree: DagTree, source: nal_mono_source(module_name: "gunbc.nal_concrete_differ", formal: "Pair<Int, String>", result: "Pair<Int, Int>"), id: ^nal_concrete_differ_read, unit: ^nal_concrete_differ_cu, path: "dag/gunbc/nal_concrete_differ.dag"),
  rcf_read_in(tree: DagTree, source: nal_generic_source(module_name: "gunbc.nal_generic_ident", formal: "Pair<K, String>", result: "Pair<K, String>"), id: ^nal_generic_ident_read, unit: ^nal_generic_ident_cu, path: "dag/gunbc/nal_generic_ident.dag"),
  rcf_read_in(tree: DagTree, source: nal_generic_source(module_name: "gunbc.nal_generic_differ", formal: "Pair<K, String>", result: "Pair<K, Int>"), id: ^nal_generic_differ_read, unit: ^nal_generic_differ_cu, path: "dag/gunbc/nal_generic_differ.dag"),
  rcf_read_in(tree: DagTree, source: nal_mono_source(module_name: "gunbc.nal_alias_ident", formal: "List<Int>", result: "List<Int>"), id: ^nal_alias_ident_read, unit: ^nal_alias_ident_cu, path: "dag/gunbc/nal_alias_ident.dag"),
  rcf_read_in(tree: DagTree, source: nal_mono_source(module_name: "gunbc.nal_alias_differ", formal: "List<Int>", result: "List<String>"), id: ^nal_alias_differ_read, unit: ^nal_alias_differ_cu, path: "dag/gunbc/nal_alias_differ.dag"),
  rcf_read_in(tree: DagTree, source: nal_generic_source(module_name: "gunbc.nal_nested_differ", formal: "Pair<List<K>, String>", result: "Pair<List<K>, Int>"), id: ^nal_nested_differ_read, unit: ^nal_nested_differ_cu, path: "dag/gunbc/nal_nested_differ.dag")
]

fn nal_resolve_subject(subject: String) -> Outcome<ResolvedTree> {
  match module_roots_from_source_root_ingest(ingest: nal_ingest, lm: dag_language_model()) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_in_context(
        context: resolution_context(lm: dag_language_model(), roots: roots, index: source_root_index_empty(), active_roots: Empty, policy: default_name_resolution_policy()),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject) },
          imports: Empty
        }
      ).resolved
  }
}

fn nal_refused_as(subject: String, reason: Symbol) -> Bool {
  match rcf_refusal(resolved: nal_resolve_subject(subject: subject), reason: reason) {
    Absent => false
    Present { value: _ } => true
  }
}

fn nal_accepted(subject: String) -> Bool {
  match rcf_verdict(resolved: nal_resolve_subject(subject: subject)) {
    RcfInferAccepted { diagnostics: _ } => true
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

// ACCEPT expected. The two sides are the SAME application, spelled twice: Pair<Int, String> against
// Pair<Int, String>, no type variable anywhere. If this is red, the two producers do not agree on the
// node shape at all -- labels included -- and every nominal mismatch is being decided on the label.
test fn nal_identical_concrete_nominal_application_is_accepted_holds() -> Bool {
  nal_accepted(subject: "gunbc.nal_concrete_ident")
}

// REFUSE expected, and it refuses today (the type arguments genuinely differ).
test fn nal_differing_concrete_nominal_application_refuses_holds() -> Bool {
  nal_refused_as(subject: "gunbc.nal_concrete_differ", reason: ^arrow_body_does_not_inhabit_declared_return)
}

// ACCEPT expected. The generic control, same shape as the site-6 control of
// v2.test.claim.compiler.infer_route_candidates_inhabitance_witness.
test fn nal_identical_generic_nominal_application_is_accepted_holds() -> Bool {
  nal_accepted(subject: "gunbc.nal_generic_ident")
}

// REFUSE expected. The site-6 shape: Pair<K, String> against Pair<K, Int>. Whether the judge reaches the
// argument TYPES at all is what #15868's arm names; here the question is only that it refuses.
test fn nal_differing_generic_nominal_application_refuses_holds() -> Bool {
  nal_refused_as(subject: "gunbc.nal_generic_differ", reason: ^arrow_body_does_not_inhabit_declared_return)
}

// ACCEPT expected. List is a transparent alias of an opaque nominal, so its body carries no member
// labels: identical applications of it must be accepted even if the product body's member labels are
// what splits Pair's two sides.
test fn nal_identical_alias_application_is_accepted_holds() -> Bool {
  nal_accepted(subject: "gunbc.nal_alias_ident")
}

// REFUSE expected: List<Int> against List<String>.
test fn nal_differing_alias_application_refuses_holds() -> Bool {
  nal_refused_as(subject: "gunbc.nal_alias_differ", reason: ^arrow_body_does_not_inhabit_declared_return)
}

// REFUSE expected. The nested discriminator's outer cell: the disagreement is in the SECOND argument of
// an application whose first argument is the same application again.
test fn nal_nested_second_argument_disagreement_refuses_holds() -> Bool {
  nal_refused_as(subject: "gunbc.nal_nested_differ", reason: ^arrow_body_does_not_inhabit_declared_return)
}

// ---------------------------------------------------------------------------------------------
// THE NODE-LEVEL CELLS. The cells above ask the judge; these read the two nodes themselves out of the
// resolved tree at the same interface the judge reads them, and ask one shape question each: which
// connective, and are the ARGUMENT edges positional. Child zero of an application is the constructor
// reference, so the argument edges are the tail of `children` -- the exact list the comparison pairs by
// ordinal, and the list whose label equality it requires before it will descend into a target.
//
// THE PRODUCED SIDE is the parameter's declared type, which is what a reference to it is inferred from
// (v2.compiler.infer infer_parameter_reference_facts reads exactly this symbol-index entry).
// THE DECLARED SIDE is the Arrow's body target, the return annotation.
// ---------------------------------------------------------------------------------------------

fn nal_resolved(subject: String) -> Outcome<ResolvedTree> {
  nal_resolve_subject(subject: subject)
}

fn nal_symbol(resolved: Outcome<ResolvedTree>, dotted: String) -> Optional<Node> {
  match resolved {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: tree, diagnostics: _ } =>
      symbol_index_lookup(index: tree.resolved_declarations, qualified_path: qualified_name_from_dotted_string(dotted: dotted))
  }
}

fn nal_produced_node_of(resolved: Outcome<ResolvedTree>, subject: String) -> Optional<Node> {
  nal_symbol(resolved: resolved, dotted: join([subject, ".nal_take.p"], ""))
}

fn nal_produced_node(subject: String) -> Optional<Node> {
  nal_produced_node_of(resolved: nal_resolved(subject: subject), subject: subject)
}

fn nal_fn_node_of(resolved: Outcome<ResolvedTree>, subject: String) -> Optional<Node> {
  nal_symbol(resolved: resolved, dotted: join([subject, ".nal_take"], ""))
}

fn nal_fn_node(subject: String) -> Optional<Node> {
  nal_symbol(resolved: nal_resolved(subject: subject), dotted: join([subject, ".nal_take"], ""))
}

// The return annotation, read the way infer reads an Arrow's body. Each cell resolves its source root
// ONCE and hands the resolved tree to every reader, so one program costs one resolve.
fn nal_declared_node_of(resolved: Outcome<ResolvedTree>, subject: String) -> Optional<Node> {
  match nal_fn_node_of(resolved: resolved, subject: subject) {
    Absent => optional_absent()
    Present { value: n } =>
      match arrow_body_target_lookup(children: n.children) {
        Found { target: body } => optional_present(value: body)
        Ambiguous => optional_absent()
        NotFound =>
          match list_at_optional(xs: positional_child_target_nodes(node: n), index: 0) {
            Absent => optional_absent()
            Present { value: inner } => nal_arrow_body_optional(children: inner.children)
          }
      }
  }
}

fn nal_declared_node(subject: String) -> Optional<Node> {
  nal_declared_node_of(resolved: nal_resolved(subject: subject), subject: subject)
}

fn nal_arrow_body_optional(children: List<Edge>) -> Optional<Node> {
  match arrow_body_target_lookup(children: children) {
    Found { target: body } => optional_present(value: body)
    Ambiguous => optional_absent()
    NotFound => optional_absent()
  }
}

fn nal_argument_edges(node: Node) -> List<Edge> {
  match node.children {
    Empty => Empty
    Cons { head: _, tail: rest } => rest
  }
}

fn nal_on_produced(subject: String, f: fn(Node) -> Bool) -> Bool {
  match nal_produced_node(subject: subject) {
    Absent => false
    Present { value: n } => f(n)
  }
}

fn nal_on_declared(subject: String, f: fn(Node) -> Bool) -> Bool {
  match nal_declared_node(subject: subject) {
    Absent => false
    Present { value: n } => f(n)
  }
}

fn nal_kind_is_instantiation(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Instantiation } => true
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}

fn nal_arguments_are_positional(n: Node) -> Bool {
  all_edges_positional(children: nal_argument_edges(node: n))
}

fn nal_denotation_reads(n: Node) -> Bool {
  match declaration_denotation_of_type(t: n) {
    Absent => false
    Present { value: _ } => true
  }
}

fn nal_normalized_of(resolved: Outcome<ResolvedTree>, at: Optional<Node>) -> Optional<Node> {
  match resolved {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: tree, diagnostics: _ } =>
      match at {
        Absent => optional_absent()
        Present { value: n } =>
          optional_present(value: infer_type_alias_normalized_at(t: n, bodies: tree.resolved_declarations, bindings: tree.symbol_index))
      }
  }
}

fn nal_normalized_produced(subject: String) -> Optional<Node> {
  let resolved = nal_resolved(subject: subject)
  nal_normalized_of(resolved: resolved, at: nal_produced_node_of(resolved: resolved, subject: subject))
}

fn nal_normalized_declared(subject: String) -> Optional<Node> {
  let resolved = nal_resolved(subject: subject)
  nal_normalized_of(resolved: resolved, at: nal_declared_node_of(resolved: resolved, subject: subject))
}

fn nal_on_normalized_produced(subject: String, f: fn(Node) -> Bool) -> Bool {
  match nal_normalized_produced(subject: subject) {
    Absent => false
    Present { value: n } => f(n)
  }
}

fn nal_on_normalized_declared(subject: String, f: fn(Node) -> Bool) -> Bool {
  match nal_normalized_declared(subject: subject) {
    Absent => false
    Present { value: n } => f(n)
  }
}

// Are the two sides the same node up to provenance? A false here while the program is CORRECT (declared
// and produced spell the same application) is the soundness case: correct programs refusing.
fn nal_sides_equal(a: Optional<Node>, b: Optional<Node>) -> Bool {
  match a {
    Absent => false
    Present { value: x } =>
      match b {
        Absent => false
        Present { value: y } => node_equal_ignoring_provenance(a: x, b: y)
      }
  }
}

// --- the concrete identical program: Pair<Int, String> declared against Pair<Int, String> produced -----

test fn nal_node_concrete_produced_side_is_reachable_holds() -> Bool {
  match nal_produced_node(subject: "gunbc.nal_concrete_ident") {
    Absent => false
    Present { value: _ } => true
  }
}

test fn nal_node_concrete_declared_side_is_reachable_holds() -> Bool {
  match nal_declared_node(subject: "gunbc.nal_concrete_ident") {
    Absent => false
    Present { value: _ } => true
  }
}

test fn nal_node_concrete_produced_is_instantiation_holds() -> Bool {
  nal_on_produced(subject: "gunbc.nal_concrete_ident", f: nal_kind_is_instantiation)
}

test fn nal_node_concrete_declared_is_instantiation_holds() -> Bool {
  nal_on_declared(subject: "gunbc.nal_concrete_ident", f: nal_kind_is_instantiation)
}

test fn nal_node_concrete_produced_arguments_positional_holds() -> Bool {
  nal_on_produced(subject: "gunbc.nal_concrete_ident", f: nal_arguments_are_positional)
}

test fn nal_node_concrete_declared_arguments_positional_holds() -> Bool {
  nal_on_declared(subject: "gunbc.nal_concrete_ident", f: nal_arguments_are_positional)
}

// THE SOUNDNESS CELL. Both sides spell Pair<Int, String> and the body is the parameter itself, so the
// program is correct; if this is red the two producers disagree about a node that names one type.
test fn nal_node_concrete_sides_are_structurally_equal_holds() -> Bool {
  let resolved = nal_resolved(subject: "gunbc.nal_concrete_ident")
  nal_sides_equal(
    a: nal_produced_node_of(resolved: resolved, subject: "gunbc.nal_concrete_ident"),
    b: nal_declared_node_of(resolved: resolved, subject: "gunbc.nal_concrete_ident")
  )
}

test fn nal_node_concrete_produced_denotation_reads_holds() -> Bool {
  nal_on_produced(subject: "gunbc.nal_concrete_ident", f: nal_denotation_reads)
}

test fn nal_node_concrete_declared_denotation_reads_holds() -> Bool {
  nal_on_declared(subject: "gunbc.nal_concrete_ident", f: nal_denotation_reads)
}

// --- the site-6 shape: Pair<K, String> declared against Pair<K, Int> produced --------------------------

test fn nal_node_generic_produced_is_instantiation_holds() -> Bool {
  nal_on_produced(subject: "gunbc.nal_generic_differ", f: nal_kind_is_instantiation)
}

test fn nal_node_generic_declared_is_instantiation_holds() -> Bool {
  nal_on_declared(subject: "gunbc.nal_generic_differ", f: nal_kind_is_instantiation)
}

test fn nal_node_generic_produced_arguments_positional_holds() -> Bool {
  nal_on_produced(subject: "gunbc.nal_generic_differ", f: nal_arguments_are_positional)
}

test fn nal_node_generic_declared_arguments_positional_holds() -> Bool {
  nal_on_declared(subject: "gunbc.nal_generic_differ", f: nal_arguments_are_positional)
}

// --- the same two sides after alias normalization, which is the shape the judge compares ----------------

test fn nal_node_generic_produced_normalized_is_instantiation_holds() -> Bool {
  nal_on_normalized_produced(subject: "gunbc.nal_generic_differ", f: nal_kind_is_instantiation)
}

test fn nal_node_generic_declared_normalized_is_instantiation_holds() -> Bool {
  nal_on_normalized_declared(subject: "gunbc.nal_generic_differ", f: nal_kind_is_instantiation)
}

test fn nal_node_generic_produced_normalized_arguments_positional_holds() -> Bool {
  nal_on_normalized_produced(subject: "gunbc.nal_generic_differ", f: nal_arguments_are_positional)
}

test fn nal_node_generic_declared_normalized_arguments_positional_holds() -> Bool {
  nal_on_normalized_declared(subject: "gunbc.nal_generic_differ", f: nal_arguments_are_positional)
}

test fn nal_node_concrete_produced_normalized_is_instantiation_holds() -> Bool {
  nal_on_normalized_produced(subject: "gunbc.nal_concrete_ident", f: nal_kind_is_instantiation)
}

test fn nal_node_concrete_declared_normalized_is_instantiation_holds() -> Bool {
  nal_on_normalized_declared(subject: "gunbc.nal_concrete_ident", f: nal_kind_is_instantiation)
}
