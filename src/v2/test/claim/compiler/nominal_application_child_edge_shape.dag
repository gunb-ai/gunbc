module v2.test.claim.compiler.nominal_application_child_edge_shape

// PROBE (node adhoc-afb0f800-78c): what does a lowered nominal type-application look like on the two sides
// of a declared-type judgment -- the declared position's annotation and the produced position's inferred
// type -- and does the difference between them reach the child Edge LABELS?
//
// v2.std.exact_structural_equality_zip_fold_predicate's descent (the arm #15868 adds) decides a child pair
// by its Edge label BEFORE its target, so a label that differs between the two producers reports as a TYPE
// mismatch on every nominal application. The cells below separate the two readings without a local run:
// every cell is a whole-module read through the real resolver and infer, and each asks one question.
//
// Reading the table: a cell that is RED where it is written ACCEPT means the two sides of that program are
// NOT structurally identical, which is the lowering mismatch; a cell that is RED where it is written REFUSE
// means the judge is answering for the wrong reason. Nothing here is a claim of the final contract; these
// are the measurements the fix is written against.
import v2.compiler.name_resolve { Admission, ResolutionSubject, resolution_context, resolve_in_context }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.source_authority { SourceRootIngest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.node { Symbol }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.std.text { String }
import std.algebra { Empty }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Present }
import v2.test.claim.compiler.infer_record_construct_field_inhabitance_witness {
  RcfInferAccepted,
  RcfInferRefused,
  RcfResolveRefused,
  rcf_read_in,
  rcf_refusal,
  rcf_verdict
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data nal_algebra_source: String = "module std.algebra\n\nopaque type FreeMonoid<element>\n"

// Pair is a transparent alias whose body is a PRODUCT, so its members carry the structural labels
// first and second; List is a transparent alias of an OPAQUE nominal, so its body has no member
// labels at all. A mismatch that appears for Pair and not for List is the member labels.
data nal_types_source: String = "module std.types\n\nimport std.algebra { FreeMonoid }\n\ntype List<element> = FreeMonoid<element>\n\ntype Pair<A, B> = Mk { first: A, second: B }\n"

fn nal_mono_source(module_name: String, formal: String, result: String) -> String {
  join(
    [
      "module ",
      module_name,
      "\n\nimport std.types { Pair, List }\n\nfn nal_take(p: ",
      formal,
      ") -> ",
      result,
      " {\n  p\n}\n"
    ],
    ""
  )
}

fn nal_generic_source(module_name: String, formal: String, result: String) -> String {
  join(
    [
      "module ",
      module_name,
      "\n\nimport std.types { Pair, List }\n\nfn nal_take<K>(p: ",
      formal,
      ") -> ",
      result,
      " {\n  p\n}\n"
    ],
    ""
  )
}

data nal_ingest: SourceRootIngest = [
  rcf_read_in(tree: DagTree, source: nal_algebra_source, id: ^nal_algebra_read, unit: ^nal_algebra_cu, path: "dag/std/algebra.dag"),
  rcf_read_in(tree: DagTree, source: nal_types_source, id: ^nal_types_read, unit: ^nal_types_cu, path: "dag/std/types.dag"),
  rcf_read_in(tree: DagTree, source: nal_mono_source(module_name: "gunbc.nal_concrete_ident", formal: "Pair<Int, String>", result: "Pair<Int, String>"), id: ^nal_concrete_ident_read, unit: ^nal_concrete_ident_cu, path: "dag/gunbc/nal_concrete_ident.dag"),
  rcf_read_in(tree: DagTree, source: nal_mono_source(module_name: "gunbc.nal_concrete_differ", formal: "Pair<Int, String>", result: "Pair<Int, Int>"), id: ^nal_concrete_differ_read, unit: ^nal_concrete_differ_cu, path: "dag/gunbc/nal_concrete_differ.dag"),
  rcf_read_in(tree: DagTree, source: nal_generic_source(module_name: "gunbc.nal_generic_ident", formal: "Pair<K, String>", result: "Pair<K, String>"), id: ^nal_generic_ident_read, unit: ^nal_generic_ident_cu, path: "dag/gunbc/nal_generic_ident.dag"),
  rcf_read_in(tree: DagTree, source: nal_generic_source(module_name: "gunbc.nal_generic_differ", formal: "Pair<K, String>", result: "Pair<K, Int>"), id: ^nal_generic_differ_read, unit: ^nal_generic_differ_cu, path: "dag/gunbc/nal_generic_differ.dag"),
  rcf_read_in(tree: DagTree, source: nal_mono_source(module_name: "gunbc.nal_alias_ident", formal: "List<Int>", result: "List<Int>"), id: ^nal_alias_ident_read, unit: ^nal_alias_ident_cu, path: "dag/gunbc/nal_alias_ident.dag"),
  rcf_read_in(tree: DagTree, source: nal_mono_source(module_name: "gunbc.nal_alias_differ", formal: "List<Int>", result: "List<String>"), id: ^nal_alias_differ_read, unit: ^nal_alias_differ_cu, path: "dag/gunbc/nal_alias_differ.dag"),
  rcf_read_in(tree: DagTree, source: nal_generic_source(module_name: "gunbc.nal_nested_differ", formal: "Pair<List<K>, String>", result: "Pair<List<K>, Int>"), id: ^nal_nested_differ_read, unit: ^nal_nested_differ_cu, path: "dag/gunbc/nal_nested_differ.dag")
]

fn nal_resolve_subject(subject: String) -> Outcome<ResolvedTree> {
  match module_roots_from_source_root_ingest(ingest: nal_ingest, lm: dag_language_model()) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_in_context(
        context: resolution_context(lm: dag_language_model(), roots: roots, index: source_root_index_empty(), active_roots: Empty, policy: default_name_resolution_policy()),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject) },
          imports: Empty
        }
      ).resolved
  }
}

fn nal_refused_as(subject: String, reason: Symbol) -> Bool {
  match rcf_refusal(resolved: nal_resolve_subject(subject: subject), reason: reason) {
    Absent => false
    Present { value: _ } => true
  }
}

fn nal_accepted(subject: String) -> Bool {
  match rcf_verdict(resolved: nal_resolve_subject(subject: subject)) {
    RcfInferAccepted { diagnostics: _ } => true
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

// ACCEPT expected. The two sides are the SAME application, spelled twice: Pair<Int, String> against
// Pair<Int, String>, no type variable anywhere. If this is red, the two producers do not agree on the
// node shape at all -- labels included -- and every nominal mismatch is being decided on the label.
test fn nal_identical_concrete_nominal_application_is_accepted_holds() -> Bool {
  nal_accepted(subject: "gunbc.nal_concrete_ident")
}

// REFUSE expected, and it refuses today (the type arguments genuinely differ).
test fn nal_differing_concrete_nominal_application_refuses_holds() -> Bool {
  nal_refused_as(subject: "gunbc.nal_concrete_differ", reason: ^arrow_body_does_not_inhabit_declared_return)
}

// ACCEPT expected. The generic control, same shape as the site-6 control of
// v2.test.claim.compiler.infer_route_candidates_inhabitance_witness.
test fn nal_identical_generic_nominal_application_is_accepted_holds() -> Bool {
  nal_accepted(subject: "gunbc.nal_generic_ident")
}

// REFUSE expected. The site-6 shape: Pair<K, String> against Pair<K, Int>. Whether the judge reaches the
// argument TYPES at all is what #15868's arm names; here the question is only that it refuses.
test fn nal_differing_generic_nominal_application_refuses_holds() -> Bool {
  nal_refused_as(subject: "gunbc.nal_generic_differ", reason: ^arrow_body_does_not_inhabit_declared_return)
}

// ACCEPT expected. List is a transparent alias of an opaque nominal, so its body carries no member
// labels: identical applications of it must be accepted even if the product body's member labels are
// what splits Pair's two sides.
test fn nal_identical_alias_application_is_accepted_holds() -> Bool {
  nal_accepted(subject: "gunbc.nal_alias_ident")
}

// REFUSE expected: List<Int> against List<String>.
test fn nal_differing_alias_application_refuses_holds() -> Bool {
  nal_refused_as(subject: "gunbc.nal_alias_differ", reason: ^arrow_body_does_not_inhabit_declared_return)
}

// REFUSE expected. The nested discriminator's outer cell: the disagreement is in the SECOND argument of
// an application whose first argument is the same application again.
test fn nal_nested_second_argument_disagreement_refuses_holds() -> Bool {
  nal_refused_as(subject: "gunbc.nal_nested_differ", reason: ^arrow_body_does_not_inhabit_declared_return)
}
