module v2.test.claim.compiler.declared_return_result

import v2.test.claim.compiler.infer_fold_member_instance { fmi_assemble, fmi_infer_tree, fmi_list_peers, fmi_reason }
import v2.test.claim.body_let_annotation { bla_assemble_with_peers, bla_source }
import v2.compiler.infer { infer, infer_application_result_type, infer_arrow_declared_return_type, infer_projected_field_type, infer_projection_receiver_of_type, infer_receiver_arity_mismatch_diagnostic, ProjectionReceiver, ReceiverArityMismatch, ReceiverDeclarationUnavailable, ReceiverPayload, ReceiverTypeNotADeclaration, ReceiverTypeUnderived }
import v2.compiler.inferred_tree { ObligatedInferredTree }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.qualified_name { declaration_reference_node }
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  diagnostics_fatal_reason
}
import v2.std.inhabitance { TypeVariableInstance }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { node_equal_ignoring_provenance,
  Arrow,
  Atom,
  Authored,
  Conj,
  Edge,
  Instantiation,
  Node,
  OccurrenceSynthetic,
  Positional,
  Symbol,
  TypeNode,
  node_synthetic,
  NotADeclaration
}
import std.optional { Absent, Optional, Present }
import std.algebra { Cons, list_snoc_item, length, list_map }
import std.types { List, String }
import v2.std.symbol_index { SymbolIndex, empty_symbol_index, symbol_index_insert, symbol_index_mark_declared_type_params }
import v2.std.type_binder { type_binder_set_children, type_params_edge }
import std.types { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: a call's result type when its callee declares a non-kernel return
// (v2.compiler.infer infer_application_result_type), and a field read off an instantiated generic
// record (infer_projected_field_type).
//
// WITNESS SHAPE (DESIGN section 3, a witness discriminates at one interface): supplied claims judge
// infer_application_result_type at its own interface. ONE inhabitance claim runs the production
// assembly route: drr_the_real_route_judges_a_projected_generic_call_result (Box<Int>.item at Bool,
// plus the RFM Nat / generic-Nat / Out<Int> / Int consuming-position specimens).

fn drr_atom(sym: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: sym } }, children: [])
}

fn drr_positional(target: Node) -> Edge {
  Edge { label: Positional, target: target, declaration: NotADeclaration }
}

// fn <params>(<no domain>) -> ret
fn drr_arrow(params: List<Symbol>, ret: Node) -> Node {
  let domain = node_synthetic(kind: TypeNode { connective: Conj }, children: [])
  let positional = [drr_positional(target: domain), drr_positional(target: ret)]
  if length(xs: params) == 0 {
    node_synthetic(kind: TypeNode { connective: Arrow }, children: positional)
  } else {
    let binders = drr_binder_set(params: params)
    node_synthetic(kind: TypeNode { connective: Arrow }, children: list_snoc_item(xs: positional, item: type_params_edge(conj: binders)))
  }
}

// A binder set built through the one mint (v2.std.type_binder type_binder_set_children), so it carries
// its declared-order edge and conforms, as a lowered signature's does.
fn drr_binder_set(params: List<Symbol>) -> Node {
  let edges = list_map(xs: params, f: fn(p) { Edge { label: Authored { name: p }, target: drr_atom(sym: p), declaration: NotADeclaration } })
  let source = drr_atom(sym: ^drr_binder_source)
  node_synthetic(kind: TypeNode { connective: Conj }, children: type_binder_set_children(binders: edges, source: source))
}

fn drr_box_of(arg: Node) -> Node {
  node_synthetic(kind: TypeNode { connective: Instantiation }, children: [drr_positional(target: drr_atom(sym: ^drr_box)), drr_positional(target: arg)])
}

fn drr_present_equals(o: Optional<Node>, expected: Node) -> Bool {
  match o {
    Absent => false
    Present { value: v } => node_equal_ignoring_provenance(a: v, b: expected)
  }
}

fn drr_is_absent(o: Optional<Node>) -> Bool {
  match o {
    Absent => true
    Present { value: _ } => false
  }
}

// DECLARED RETURN: `fn mk() -> Tally` types its call as Tally. The replaced reader answered Absent.
test fn drr_a_declared_return_is_the_call_result() -> Bool {
  let arrow = drr_arrow(params: [], ret: drr_atom(sym: ^drr_tally))
  drr_is_absent(o: infer_arrow_declared_return_type(arrow: arrow))
    && drr_present_equals(o: infer_application_result_type(arrow: arrow, instances: [], declarations: empty_symbol_index(), bindings: empty_symbol_index()), expected: drr_atom(sym: ^drr_tally))
}

// KERNEL FIRST: a kernel return answers exactly what the replaced reader answers.
test fn drr_a_kernel_return_is_unchanged() -> Bool {
  let arrow = drr_arrow(params: [], ret: drr_atom(sym: ^dag_binding_type_int))
  match infer_arrow_declared_return_type(arrow: arrow) {
    Absent => false
    Present { value: kernel } =>
      drr_present_equals(o: infer_application_result_type(arrow: arrow, instances: [], declarations: empty_symbol_index(), bindings: empty_symbol_index()), expected: kernel)
  }
}

// INSTANTIATED: `fn boxed<T>(..) -> Box<T>` called with T bound to Tally types as Box<Tally>.
test fn drr_a_generic_return_is_instantiated_at_the_call() -> Bool {
  let arrow = drr_arrow(params: [^drr_t], ret: drr_box_of(arg: drr_atom(sym: ^drr_t)))
  let instances = [TypeVariableInstance { binder: ^drr_t, instance: drr_atom(sym: ^drr_tally) }]
  drr_is_absent(o: infer_arrow_declared_return_type(arrow: arrow))
    && drr_present_equals(o: infer_application_result_type(arrow: arrow, instances: instances, declarations: empty_symbol_index(), bindings: empty_symbol_index()), expected: drr_box_of(arg: drr_atom(sym: ^drr_tally)))
}

// FRONTIER: the same callee with T bound by no argument stays NOT derived -- never typed as Box<T>.
test fn drr_a_return_mentioning_an_unbound_type_parameter_is_not_derived() -> Bool {
  let arrow = drr_arrow(params: [^drr_t], ret: drr_box_of(arg: drr_atom(sym: ^drr_t)))
  drr_is_absent(o: infer_application_result_type(arrow: arrow, instances: [], declarations: empty_symbol_index(), bindings: empty_symbol_index()))
}

// PROJECTED FIELD: `item: T` read off a Box<Tally> receiver is Tally (the replaced reader kept T as
// written); a receiver that binds nothing keeps the field's declared type.
test fn drr_a_generic_record_field_projects_at_its_instantiation() -> Bool {
  let bound = [TypeVariableInstance { binder: ^drr_t, instance: drr_atom(sym: ^drr_tally) }]
  node_equal_ignoring_provenance(a: infer_projected_field_type(field_type: drr_atom(sym: ^drr_t), instances: bound), b: drr_atom(sym: ^drr_tally))
    && node_equal_ignoring_provenance(a: infer_projected_field_type(field_type: drr_atom(sym: ^drr_t), instances: []), b: drr_atom(sym: ^drr_t))
}

// WRONG TYPE-ARGUMENT COUNT: Box declares one type parameter, so a receiver typed Box<Tally, Tally>
// has no instantiation to read a field at and refuses as an arity mismatch; Box<Tally> reads its payload.
fn drr_box_path() -> List<Symbol> {
  [^drr_p, ^drr_box]
}

fn drr_box_index() -> SymbolIndex {
  let payload = node_synthetic(kind: TypeNode { connective: Conj }, children: [Edge { label: Authored { name: ^item }, target: drr_atom(sym: ^drr_t), declaration: NotADeclaration }])
  symbol_index_mark_declared_type_params(
    index: symbol_index_insert(index: empty_symbol_index(), qualified_path: drr_box_path(), resolved: payload),
    qualified_path: drr_box_path(),
    params: drr_binder_set(params: [^drr_t])
  )
}

fn drr_box_applied(args: List<Node>) -> Node {
  let head = declaration_reference_node(qn: drr_box_path(), occurrence_id: OccurrenceSynthetic)
  node_synthetic(kind: TypeNode { connective: Instantiation }, children: list_map(xs: Cons { head: head, tail: args }, f: fn(n) { drr_positional(target: n) }))
}

fn drr_is_arity_mismatch(r: ProjectionReceiver) -> Bool {
  match r {
    ReceiverArityMismatch => true
    ReceiverPayload { payload: _, instances: _ } => false
    ReceiverTypeNotADeclaration => false
    ReceiverDeclarationUnavailable { path: _ } => false
    ReceiverTypeUnderived => false
  }
}

fn drr_is_payload(r: ProjectionReceiver) -> Bool {
  match r {
    ReceiverPayload { payload: _, instances: _ } => true
    ReceiverArityMismatch => false
    ReceiverTypeNotADeclaration => false
    ReceiverDeclarationUnavailable { path: _ } => false
    ReceiverTypeUnderived => false
  }
}

test fn drr_a_wrong_type_argument_count_at_a_generic_record_projection_refuses() -> Bool {
  let tally = drr_atom(sym: ^drr_tally)
  drr_is_arity_mismatch(r: infer_projection_receiver_of_type(receiver_type: drr_box_applied(args: [tally, tally]), declarations: drr_box_index()))
    && drr_is_payload(r: infer_projection_receiver_of_type(receiver_type: drr_box_applied(args: [tally]), declarations: drr_box_index()))
    && infer_receiver_arity_mismatch_diagnostic(node: tally).reason == ^infer_reason_projection_receiver_type_arity_mismatch
}

// THE ONE REAL-PATH CLAIM, ASSERTING THE ROUTE. `boxed(1).item` at a Bool parameter refuses as an
// argument mismatch only if the call's generic declared return is derived (Box<Int>), the field is
// projected at that instantiation (Int), and the projection is judged at the declared Bool. The same
// claim also infers the RFM consuming-position specimens (Nat / generic Nat / Out<Int> / Int at Bool,
// Nat at Nat, wants_bool(mk())). Before infer_application_result_type landed, the call stayed underived
// and the program was ACCEPTED.
data drr_route_source: String = "module p\n\ntype Box<T> {\n  item: T\n}\n\nfn boxed<T>(x: T) -> Box<T> {\n  Box { item: x }\n}\n\nfn wants_bool(b: Bool) -> Int {\n  0\n}\n\nfn k() -> Int {\n  wants_bool(boxed(1).item)\n}\n"

// The route's verdicts are nullary producers (the Box projection plus the RFM specimens), so the
// floor fills the real path as this claim's shared fill (its single-claim fill debt) and the claim
// itself only compares the reasons.
fn drr_route_reason() -> Symbol {
  match fmi_assemble(src: drr_route_source) {
    Rejected { diagnostics: _ } => ^drr_assembly_refused
    Accepted { value: tree, diagnostics: _ } => fmi_reason(o: fmi_infer_tree(tree: tree))
  }
}

// RFM inhabitance folded into the one real-path claim below
// (gunbc.recurring_failure_mode call_result_of_a_declared_return_type_unjudged_in_v2_infer).
// Production assembly with a std.nat peer, then infer. Measured against main 1f25232cdc: a callee
// declared to return Nat (plain or generic), Out<Int>, or kernel Int, used where Bool is declared,
// refuses -- declared return as arrow_body_does_not_inhabit_declared_return, argument as
// application_argument_does_not_inhabit. The honest Nat-at-Nat control is accepted. Integer literals
// at Nat (0) so the body is admitted by kernel grounding; the refusal is the CALL result at the
// consuming position. These cannot be supplied arrows at infer_application_result_type: that fold
// answers the result type, not inhabitance of the call at a Bool (or Nat) position.
data drr_nat_peer_artifact: Artifact = Artifact { kind: SourceFile, id: ^drr_nat_peer_artifact, file_path: "src/v2/pilot/drr_nat_peer.dag" }

data drr_nat_peer_source: String = "module std.nat\n\ntype Nat\n  = Zero\n  | Succ { prev: Nat }\n"

fn drr_nat_peer() -> DagSourceReadWitness {
  bla_source(src: drr_nat_peer_source, artifact: drr_nat_peer_artifact, cu: ^drr_nat_peer_cu)
}

fn drr_assemble_with_nat(src: String) -> Outcome<ResolvedTree> {
  bla_assemble_with_peers(p_src: src, peers: list_snoc_item(xs: fmi_list_peers(), item: drr_nat_peer()))
}

fn drr_inferred(src: String) -> Outcome<ObligatedInferredTree> {
  match drr_assemble_with_nat(src: src) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: tree, diagnostics: _ } => infer(tree: tree)
  }
}

fn drr_reason(src: String) -> Symbol {
  match drr_inferred(src: src) {
    Accepted { value: _, diagnostics: _ } => ^accepted
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
  }
}

fn drr_reason_is(src: String, wanted: Symbol) -> Bool {
  drr_reason(src: src) == wanted
}

data drr_nat_at_bool_source: String = "module p\n\nimport std.nat { Nat }\n\nfn mk() -> Nat {\n  0\n}\n\nfn f() -> Bool {\n  mk()\n}\n"

data drr_generic_nat_at_bool_source: String = "module p\n\nimport std.nat { Nat }\nimport std.types { List }\n\nfn mk<T>(xs: List<T>) -> Nat {\n  0\n}\n\nfn f(xs: List<Int>) -> Bool {\n  mk(xs)\n}\n"

data drr_int_at_bool_source: String = "module p\n\nfn mk() -> Int {\n  0\n}\n\nfn f() -> Bool {\n  mk()\n}\n"

data drr_nat_at_nat_source: String = "module p\n\nimport std.nat { Nat }\n\nfn mk() -> Nat {\n  0\n}\n\nfn f() -> Nat {\n  mk()\n}\n"

data drr_nat_at_bool_arg_source: String = "module p\n\nimport std.nat { Nat }\n\nfn mk() -> Nat {\n  0\n}\n\nfn wants_bool(b: Bool) -> Int {\n  0\n}\n\nfn k() -> Int {\n  wants_bool(mk())\n}\n"

data drr_out_at_bool_source: String = "module p\n\ntype Out<T> = Present { value: T } | Absent\n\nfn mk() -> Out<Int> {\n  Present { value: 1 }\n}\n\nfn f() -> Bool {\n  mk()\n}\n"

test fn drr_the_real_route_judges_a_projected_generic_call_result() -> Bool {
  drr_route_reason() == ^application_argument_does_not_inhabit
    && drr_reason_is(src: drr_nat_at_bool_source, wanted: ^arrow_body_does_not_inhabit_declared_return)
    && drr_reason_is(src: drr_generic_nat_at_bool_source, wanted: ^arrow_body_does_not_inhabit_declared_return)
    && drr_reason_is(src: drr_int_at_bool_source, wanted: ^arrow_body_does_not_inhabit_declared_return)
    && drr_reason_is(src: drr_nat_at_bool_arg_source, wanted: ^application_argument_does_not_inhabit)
    && drr_reason_is(src: drr_nat_at_nat_source, wanted: ^accepted)
    && drr_reason_is(src: drr_out_at_bool_source, wanted: ^arrow_body_does_not_inhabit_declared_return)
}

