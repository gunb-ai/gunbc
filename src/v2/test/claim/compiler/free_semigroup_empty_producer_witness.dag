module v2.test.claim.compiler.free_semigroup_empty_producer_witness

import v2.compiler.resolve { ResolvedTree }
import v2.compiler.name_resolve { Admission, ResolutionSubject, resolution_context, resolve_in_context }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.compiler.normalized_tree { NormalizedTree }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.source_authority { SourceRootIngest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_has_reason }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Symbol }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }
import std.algebra { Empty, FreeMonoid }
import v2.test.claim.compiler.infer_record_construct_field_inhabitance_witness {
  RcfInferAccepted,
  RcfInferRefused,
  RcfResolveRefused,
  rcf_read,
  rcf_refuses_with,
  rcf_verdict
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// FIXTURES DECLARE THE FreeMonoid/FreeSemigroup SHAPE LOCALLY (FsList/FsNonEmpty): a fixture source string
// cannot import std.algebra on this route. The relation judged is shape-general, not FreeSemigroup-specific.
// AN EMPTY PRODUCER AT A FreeSemigroup POSITION (gunbc.recurring_failure_mode
// a_possibly_empty_producer_enters_a_nonempty_consumer). FreeSemigroup is the product
// { head, tail }: its required `head` has no source in an empty producer, so the existing
// structural relation (v2.std.inhabitance declared_type_inhabitance) must refuse it.
data fse_return_empty_source: String = "module v2.test.fse_return_empty\n\ntype FsList<T> = FsEmpty | FsCons { head: T, tail: FsList<T> }\n\ntype FsNonEmpty<T> {\n  head: T\n  tail: FsList<T>\n}\n\nfn fse_probe() -> FsNonEmpty<Int> { FsEmpty }\n"

data fse_built_ok_source: String = "module v2.test.fse_built_ok\n\ntype FsList<T> = FsEmpty | FsCons { head: T, tail: FsList<T> }\n\ntype FsNonEmpty<T> {\n  head: T\n  tail: FsList<T>\n}\n\nfn fse_ok() -> FsNonEmpty<Int> { FsNonEmpty { head: 1, tail: FsEmpty } }\n"

data fse_formal_variant_source: String = "module v2.test.fse_formal_variant\n\ntype FsList<T> = FsEmpty | FsCons { head: T, tail: FsList<T> }\n\ntype FsNonEmpty<T> {\n  head: T\n  tail: FsList<T>\n}\n\nfn fse_take(xs: FsNonEmpty<Int>) -> Int { 1 }\n\nfn fse_call() -> Int { fse_take(xs: FsEmpty) }\n"

data fse_ingest: SourceRootIngest = [
  rcf_read(source: fse_return_empty_source, id: ^fse_return_empty_read, unit: ^fse_return_empty_cu, path: "src/v2/test/fixture/free_semigroup_empty/return_empty.dag"),
  rcf_read(source: fse_built_ok_source, id: ^fse_built_ok_read, unit: ^fse_built_ok_cu, path: "src/v2/test/fixture/free_semigroup_empty/built_ok.dag"),
  rcf_read(source: fse_formal_variant_source, id: ^fse_formal_variant_read, unit: ^fse_formal_variant_cu, path: "src/v2/test/fixture/free_semigroup_empty/formal_b.dag"),
]

fn fse_normalized() -> Outcome<FreeMonoid<NormalizedTree>> {
  module_roots_from_source_root_ingest(ingest: fse_ingest, lm: dag_language_model())
}

fn fse_resolve(subject: String) -> Outcome<ResolvedTree> {
  match fse_normalized() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_in_context(
        context: resolution_context(lm: dag_language_model(), roots: roots, index: source_root_index_empty(), active_roots: Empty, policy: default_name_resolution_policy()),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject) },
          imports: Empty
        }
      ).resolved
  }
}

fn fse_accepted_with(resolved: Outcome<ResolvedTree>, reason: Symbol) -> Bool {
  match rcf_verdict(resolved: resolved) {
    RcfInferAccepted { diagnostics: ds } => diagnostics_has_reason(d: ds, reason: reason)
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

fn fse_accepted_plain(resolved: Outcome<ResolvedTree>) -> Bool {
  match rcf_verdict(resolved: resolved) {
    RcfInferAccepted { diagnostics: _ } => true
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

// THE RED, declared return: `Empty` at FreeSemigroup<Int> refuses.
test fn fse_empty_at_a_declared_free_semigroup_return_refuses_holds() -> Bool {
  rcf_refuses_with(resolved: fse_resolve(subject: "v2.test.fse_return_empty"), reason: ^arrow_body_does_not_inhabit_declared_return)
}

// THE RED, argument: a nullary variant of the FreeMonoid-shaped coproduct at a nonempty-product formal
// refuses. The `[]` LITERAL spelling is NOT exercised here: a list literal does not resolve in this
// in-memory fixture closure (no std root), so that shape stays unexecuted on the native route.
test fn fse_empty_variant_at_a_nonempty_product_formal_refuses_holds() -> Bool {
  rcf_refuses_with(resolved: fse_resolve(subject: "v2.test.fse_formal_variant"), reason: ^application_argument_does_not_inhabit)
}

// THE POSITIVE CONTROL: a constructed nonempty value is accepted.
test fn fse_a_constructed_nonempty_value_is_accepted_holds() -> Bool {
  fse_accepted_plain(resolved: fse_resolve(subject: "v2.test.fse_built_ok"))
}


fn fse_resolved_ok(resolved: Outcome<ResolvedTree>) -> Bool {
  match resolved {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

fn fse_infer_refused(resolved: Outcome<ResolvedTree>) -> Bool {
  match rcf_verdict(resolved: resolved) {
    RcfInferRefused { diagnostics: _ } => true
    RcfInferAccepted { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

