module v2.test.claim.compiler.gfi_probe

import v2.test.claim.compiler.infer_fold_member_instance { fmi_assemble }
import v2.test.claim.compiler.generic_formal_instantiation { gfi_alias_agrees }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.symbol_index { symbol_index_lookup }
import v2.std.qualified_name { declaration_reference_path_optional, qualified_name_from_dotted_string }
import v2.std.type_binder { TypeAlias, type_decl_view }
import v2.std.node { TypeNode, Instantiation }
import v2.std.node_query { node_positional_child_targets }
import v2.std.collection { list_at_optional }
import v2.std.optional { Absent, Present }
import v2.std.logic { Bool }

test fn gfi_probe_list_in_resolved_declarations() -> Bool {
  match fmi_assemble(src: gfi_alias_agrees) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match symbol_index_lookup(index: tree.resolved_declarations, qualified_path: qualified_name_from_dotted_string(dotted: "v2.std.collection.List")) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

test fn gfi_probe_list_in_symbol_index() -> Bool {
  match fmi_assemble(src: gfi_alias_agrees) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match symbol_index_lookup(index: tree.symbol_index, qualified_path: qualified_name_from_dotted_string(dotted: "v2.std.collection.List")) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

fn gfi_probe_view(which: Int) -> Bool {
  match fmi_assemble(src: gfi_alias_agrees) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match symbol_index_lookup(index: tree.resolved_declarations, qualified_path: qualified_name_from_dotted_string(dotted: "v2.std.collection.List")) {
        Absent => false
        Present { value: d } =>
          match type_decl_view(target: d) {
            TypeAlias { binders: _, aliased: a } =>
              if which == 0 { true } else {
                match a.kind {
                  TypeNode { connective: Instantiation } =>
                    if which == 1 { true } else {
                      match list_at_optional(xs: node_positional_child_targets(node: a), index: 0) {
                        Present { value: h } =>
                          match declaration_reference_path_optional(node: h) {
                            Present { value: _ } => true
                            Absent => false
                          }
                        Absent => false
                      }
                    }
                  _ => false
                }
              }
            _ => false
          }
      }
  }
}
test fn gfi_probe_is_alias() -> Bool { gfi_probe_view(which: 0) }
test fn gfi_probe_aliased_is_instantiation() -> Bool { gfi_probe_view(which: 1) }
test fn gfi_probe_aliased_head_is_reference() -> Bool { gfi_probe_view(which: 2) }
