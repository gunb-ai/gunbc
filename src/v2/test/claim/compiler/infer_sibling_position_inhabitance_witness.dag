module v2.test.claim.compiler.infer_sibling_position_inhabitance_witness

import v2.compiler.resolve { ResolvedTree }
import v2.compiler.name_resolve { Admission, ResolutionSubject, resolution_context, resolve_in_context }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.compiler.normalized_tree { NormalizedTree }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.source_authority { SourceRootIngest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Diagnostics, None, Outcome, Rejected, Some, diagnostics_has_reason }
import v2.std.node { Symbol, Node, Edge, Positional, TypeNode, Instantiation, NotADeclaration, node_synthetic }
import v2.std.inhabitance { DeclaredTypeObligation, InhabitanceRefused, InhabitanceUndecidable, Inhabits, declared_type_inhabitance, position_declared_return }
import v2.extdeps.languages.dag { dag_type_atom_node }
import v2.std.qualified_name { declaration_reference_node }
import v2.std.list_introduction { list_introduction_head_path }
import std.occurrence_identity { OccurrenceSynthetic }
import std.optional { Absent, Present }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }
import std.algebra { Empty, FreeMonoid }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.cross_tree.import_model { DagTree }
import v2.test.claim.compiler.infer_record_construct_field_inhabitance_witness {
  RcfInferAccepted,
  RcfInferRefused,
  RcfResolveRefused,
  rcf_verdict,
  rcf_read_in
}

// A TYPE VARIABLE UNDECIDES ONLY ITS OWN POSITION; A CONCRETE SIBLING IS STILL JUDGED.
//
// v2.std.inhabitance inhabitance_pair_undecidable_reason reads the pair as a THREE-VALUED position verdict
// (inhabitance_position_verdict): a position that is concrete and refuses, or two distinct nominal heads,
// DISAGREES; a bare variable sitting over the very same variable AGREES; only a position that genuinely
// cannot be read is UNDECIDED. A disagreeing sibling wins over an undecided position -- `Map<K, String>` at
// `Map<K, Int>` refuses on the value position whatever K is. A pair with no disagreement and no undecided
// position is AGREED -- `Map<K, Int>` at `Map<K, Int>` inhabits whatever K is -- so it is no longer left
// undecided, where the whole-pair abstention used to carry it into UndecidableGenericFormal. v1's
// counterpart is v1.compiler.infer application_arguments_inhabitance (a disagreeing argument outranks an
// undecided one, #15441); the relation is mirrored, not imported. The fix is in the ONE pair judgment, not
// each caller (infer_judge_generic_formal and infer_judge_declared_position both go through it).
//
// TWO LAYERS, because the whole-pair abstention is reached only where an obligation carries variables
// (call-argument formals not yet instantiated, fold members and carriers). THE RELATION CLAIMS pin the
// pair judgment at its interface with supplied nodes: the RED is Pair<T, String> declared against
// Pair<T, Int> produced, which must REFUSE; the POSITIVE CONTROL is Pair<T, Int> declared against
// Pair<T, Int> produced, which must be ACCEPTED (Inhabits) -- main left it UndecidableGenericFormal. A
// genuinely unreadable position beside agreeing siblings -- Pair<List<T>, Int> at Pair<List<Bool>, Int> --
// STAYS undecided, never refusing for the wrong reason. THE SOURCE-ROUTE CLAIMS are CONTROLS: they refuse on
// BOTH heads (the base already carries #15868's structural reasons, so a sibling mismatch refuses regardless of
// this change -- they are not the discriminator). They assert the refusal THROUGH the structural reason the
// Diagnostic actually carries: application_argument_does_not_inhabit_diagnostic sets its reason to the
// find_witness reason, so a disagreeing sibling refuses with ^inhabitance_structural_arguments_differ (the
// argument ordinal is the locus; the argument-ordinal position slot is asserted once #15868 carries that
// accessor). A separate _is_not_accepted claim per subject pins that the call is refused at ALL, so a
// wrong-reason refusal is never confused with an ACCEPT.

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data skp_types_source: String = "module std.types\n\nimport std.algebra { FreeMonoid }\n\ntype List<element> = FreeMonoid<element>\n\ntype Pair<A, B> = Mk { first: A, second: B }\n"
data skp_algebra_source: String = "module std.algebra\n\ntype FreeMonoid<T>\n  = Empty\n  | Cons { head: T, tail: FreeMonoid<T> }\n"

fn skp_probe_source_with(module_name: String, declared: String, produced: String) -> String {
  join(["module ", module_name, "\n\nimport std.types { List, Pair }\n\nfn skp_take<K>(m: ", declared, ") -> Int {\n  0\n}\n\nfn skp_call(p: ", produced, ") -> Int {\n  skp_take(m: p)\n}\n"], "")
}

data skp_red_source: String = skp_probe_source_with(module_name: "gunbc.skp_red", declared: "Pair<K, String>", produced: "Pair<Int, Int>")
data skp_nested_var_red_source: String = skp_probe_source_with(module_name: "gunbc.skp_nested_var_red", declared: "Pair<List<K>, String>", produced: "Pair<List<Int>, Int>")
data skp_nested_sibling_red_source: String = skp_probe_source_with(module_name: "gunbc.skp_nested_sibling_red", declared: "Pair<Pair<K, String>, Int>", produced: "Pair<Pair<Int, Int>, Int>")
data skp_nested_var_control_source: String = skp_probe_source_with(module_name: "gunbc.skp_nested_var_control", declared: "Pair<List<K>, String>", produced: "Pair<List<Int>, String>")
data skp_control_source: String = skp_probe_source_with(module_name: "gunbc.skp_control", declared: "Pair<K, String>", produced: "Pair<Int, String>")

data skp_ingest: SourceRootIngest = [
  rcf_read_in(tree: DagTree, source: skp_algebra_source, id: ^skp_algebra_read, unit: ^skp_algebra_cu, path: "dag/std/algebra.dag"),
  rcf_read_in(tree: DagTree, source: skp_types_source, id: ^skp_types_read, unit: ^skp_types_cu, path: "dag/std/types.dag"),
  rcf_read_in(tree: DagTree, source: skp_red_source, id: ^skp_red_read, unit: ^skp_red_cu, path: "dag/gunbc/skp_red.dag"),
  rcf_read_in(tree: DagTree, source: skp_control_source, id: ^skp_control_read, unit: ^skp_control_cu, path: "dag/gunbc/skp_control.dag"),
  rcf_read_in(tree: DagTree, source: skp_nested_var_red_source, id: ^skp_nested_var_red_read, unit: ^skp_nested_var_red_cu, path: "dag/gunbc/skp_nested_var_red.dag"),
  rcf_read_in(tree: DagTree, source: skp_nested_sibling_red_source, id: ^skp_nested_sibling_red_read, unit: ^skp_nested_sibling_red_cu, path: "dag/gunbc/skp_nested_sibling_red.dag"),
  rcf_read_in(tree: DagTree, source: skp_nested_var_control_source, id: ^skp_nested_var_control_read, unit: ^skp_nested_var_control_cu, path: "dag/gunbc/skp_nested_var_control.dag")
]

fn skp_resolve_subject(subject: String) -> Outcome<ResolvedTree> {
  match module_roots_from_source_root_ingest(ingest: skp_ingest, lm: dag_language_model()) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_in_context(
        context: resolution_context(lm: dag_language_model(), roots: roots, index: source_root_index_empty(), active_roots: Empty, policy: default_name_resolution_policy()),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject) },
          imports: Empty
        }
      ).resolved
  }
}

// WHY THE OLD FILTER FAILED. application_argument_does_not_inhabit_diagnostic (v2.std.inhabitance) sets the
// refusal Diagnostic's `reason` to the FIND_WITNESS reason -- the structural decision -- NOT to a symbol named
// application_argument_does_not_inhabit. So a claim filtering rcf_refusal on ^application_argument_does_not_inhabit
// matched NOTHING on base or head (both carry #15868's structural reasons). The refusal is asserted by the reason
// the Diagnostic actually carries: ^inhabitance_structural_arguments_differ for a disagreeing sibling.

// (1) The refusal must carry the structural reason the manager mandated. True iff refused WITH
// ^inhabitance_structural_arguments_differ.
fn skp_call_arg_refuses_with_arguments_differ(subject: String) -> Bool {
  match rcf_verdict(resolved: skp_resolve_subject(subject: subject)) {
    RcfInferRefused { diagnostics: ds } => diagnostics_has_reason(d: ds, reason: ^inhabitance_structural_arguments_differ)
    RcfInferAccepted { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

// (2) Independent of WHICH reason: the call must be refused at ALL (any fatal). A refusal with the wrong reason
// keeps this true while (1) is false; only a genuine ACCEPT makes it false. (1)+(2) together separate
// refused-with-arguments_differ / refused-for-another-reason / accepted.
fn skp_call_arg_is_not_accepted(subject: String) -> Bool {
  match rcf_verdict(resolved: skp_resolve_subject(subject: subject)) {
    RcfInferRefused { diagnostics: _ } => true
    RcfResolveRefused => true
    RcfInferAccepted { diagnostics: _ } => false
  }
}

fn skp_accepted(subject: String) -> Bool {
  match rcf_verdict(resolved: skp_resolve_subject(subject: subject)) {
    RcfInferAccepted { diagnostics: _ } => true
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

test fn skp_call_argument_with_a_nested_variable_beside_a_concrete_mismatch_refuses_with_arguments_differ() -> Bool {
  skp_call_arg_refuses_with_arguments_differ(subject: "gunbc.skp_nested_var_red")
}

test fn skp_call_argument_with_a_nested_concrete_mismatch_beside_a_variable_refuses_with_arguments_differ() -> Bool {
  skp_call_arg_refuses_with_arguments_differ(subject: "gunbc.skp_nested_sibling_red")
}

test fn skp_call_argument_with_a_variable_beside_a_concrete_mismatch_refuses_with_arguments_differ() -> Bool {
  skp_call_arg_refuses_with_arguments_differ(subject: "gunbc.skp_red")
}

test fn skp_call_argument_with_a_nested_variable_beside_a_concrete_mismatch_is_not_accepted() -> Bool {
  skp_call_arg_is_not_accepted(subject: "gunbc.skp_nested_var_red")
}

test fn skp_call_argument_with_a_nested_concrete_mismatch_beside_a_variable_is_not_accepted() -> Bool {
  skp_call_arg_is_not_accepted(subject: "gunbc.skp_nested_sibling_red")
}

test fn skp_call_argument_with_a_variable_beside_a_concrete_mismatch_is_not_accepted() -> Bool {
  skp_call_arg_is_not_accepted(subject: "gunbc.skp_red")
}

test fn skp_call_argument_with_a_variable_and_agreeing_siblings_is_accepted_holds() -> Bool {
  skp_accepted(subject: "gunbc.skp_control")
}

// THE RELATION CLAIMS: declared_type_inhabitance over supplied nodes, T a variable of the obligation.
fn skp_pair_of(first: Node, second: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: declaration_reference_node(qn: qualified_name_from_dotted_string(dotted: "gunbc.skp_pair"), occurrence_id: OccurrenceSynthetic), declaration: NotADeclaration },
      Edge { label: Positional, target: first, declaration: NotADeclaration },
      Edge { label: Positional, target: second, declaration: NotADeclaration }
    ]
  )
}

fn skp_list_of(element: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: declaration_reference_node(qn: list_introduction_head_path(), occurrence_id: OccurrenceSynthetic), declaration: NotADeclaration },
      Edge { label: Positional, target: element, declaration: NotADeclaration }
    ]
  )
}

fn skp_atom(identity: Symbol) -> Node {
  dag_type_atom_node(identity: identity)
}

fn skp_obligation(declared: Node, produced: Node) -> DeclaredTypeObligation {
  DeclaredTypeObligation {
    position: position_declared_return(),
    parameter_identity: ^declared_return,
    declared: declared,
    produced: produced,
    produced_declared_carrier: Absent,
    application: node_synthetic(kind: TypeNode { connective: Conj }, children: []),
    type_variables: [^skp_t, ^skp_u]
  }
}

fn skp_refuses(declared: Node, produced: Node) -> Bool {
  match declared_type_inhabitance(obligation: skp_obligation(declared: declared, produced: produced)) {
    InhabitanceRefused { find_witness_reason: _, refusal_class: _ } => true
    Inhabits { homomorphism: _ } => false
    InhabitanceUndecidable { reason: _ } => false
  }
}

fn skp_undecided(declared: Node, produced: Node) -> Bool {
  match declared_type_inhabitance(obligation: skp_obligation(declared: declared, produced: produced)) {
    InhabitanceUndecidable { reason: _ } => true
    Inhabits { homomorphism: _ } => false
    InhabitanceRefused { find_witness_reason: _, refusal_class: _ } => false
  }
}

fn skp_inhabits(declared: Node, produced: Node) -> Bool {
  match declared_type_inhabitance(obligation: skp_obligation(declared: declared, produced: produced)) {
    Inhabits { homomorphism: _ } => true
    InhabitanceUndecidable { reason: _ } => false
    InhabitanceRefused { find_witness_reason: _, refusal_class: _ } => false
  }
}

test fn skp_relation_variable_beside_a_concrete_mismatch_refuses_holds() -> Bool {
  skp_refuses(
    declared: skp_pair_of(first: skp_atom(identity: ^skp_t), second: skp_atom(identity: ^dag_binding_type_int)),
    produced: skp_pair_of(first: skp_atom(identity: ^skp_t), second: skp_atom(identity: ^bool_node_symbol))
  )
}

test fn skp_relation_nested_variable_beside_a_concrete_mismatch_refuses_holds() -> Bool {
  skp_refuses(
    declared: skp_pair_of(first: skp_list_of(element: skp_atom(identity: ^skp_t)), second: skp_atom(identity: ^dag_binding_type_int)),
    produced: skp_pair_of(first: skp_list_of(element: skp_atom(identity: ^skp_t)), second: skp_atom(identity: ^bool_node_symbol))
  )
}

test fn skp_relation_concrete_mismatch_nested_beside_a_variable_refuses_holds() -> Bool {
  skp_refuses(
    declared: skp_pair_of(first: skp_pair_of(first: skp_atom(identity: ^skp_t), second: skp_atom(identity: ^dag_binding_type_int)), second: skp_atom(identity: ^dag_binding_type_int)),
    produced: skp_pair_of(first: skp_pair_of(first: skp_atom(identity: ^skp_t), second: skp_atom(identity: ^bool_node_symbol)), second: skp_atom(identity: ^dag_binding_type_int))
  )
}

// THE POSITIVE CONTROL: a pair whose every position agrees -- the same variable over the same variable, an
// agreeing concrete sibling -- is ACCEPTED (Inhabits), no longer carried into UndecidableGenericFormal.
// `Map<K, Int>` at `Map<K, Int>` inhabits whatever K instantiates to.
test fn skp_relation_variable_with_agreeing_siblings_inhabits_holds() -> Bool {
  skp_inhabits(
    declared: skp_pair_of(first: skp_atom(identity: ^skp_t), second: skp_atom(identity: ^dag_binding_type_int)),
    produced: skp_pair_of(first: skp_atom(identity: ^skp_t), second: skp_atom(identity: ^dag_binding_type_int))
  )
}

// THE AGREEMENT CONDITION, THE ONLY NEW BEHAVIOUR: a variable position may be AGREED only for the SAME
// BINDER, so two DISTINCT binders -- T at U, both in the census, whatever their source spelling -- are NOT
// Inhabits. In v2 a same-spelled-different-scope pair is minted to two distinct symbols
// (v2.std.anonymous_binder), which is exactly the situation this claim pins: the value position agrees (Int
// at Int) but the variable position cannot be read (T at U), so the pair is UNDECIDED, never Inhabits. This
// is where any unsoundness in an Undecided->Agree widening would live, so it is asserted as Undecided.
test fn skp_relation_distinct_binders_not_inhabits_holds() -> Bool {
  skp_undecided(
    declared: skp_pair_of(first: skp_atom(identity: ^skp_t), second: skp_atom(identity: ^dag_binding_type_int)),
    produced: skp_pair_of(first: skp_atom(identity: ^skp_u), second: skp_atom(identity: ^dag_binding_type_int))
  )
}

// A GENUINELY UNREADABLE POSITION STAYS UNDECIDED: the list element is a variable over a concrete type
// (T at Bool), which cannot be read, beside an agreeing Int sibling. No sibling disagrees, so the pair is
// carried by the unreadable position into UndecidableGenericFormal -- it must NOT start refusing.
test fn skp_relation_nested_variable_with_agreeing_siblings_stays_undecided_holds() -> Bool {
  skp_undecided(
    declared: skp_pair_of(first: skp_list_of(element: skp_atom(identity: ^skp_t)), second: skp_atom(identity: ^dag_binding_type_int)),
    produced: skp_pair_of(first: skp_list_of(element: skp_atom(identity: ^bool_node_symbol)), second: skp_atom(identity: ^dag_binding_type_int))
  )
}
