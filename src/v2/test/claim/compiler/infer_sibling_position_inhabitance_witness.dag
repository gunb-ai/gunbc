module v2.test.claim.compiler.infer_sibling_position_inhabitance_witness

import v2.compiler.resolve { ResolvedTree }
import v2.compiler.name_resolve { Admission, ResolutionSubject, resolution_context, resolve_in_context }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.compiler.normalized_tree { NormalizedTree }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.source_authority { SourceRootIngest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Diagnostics, None, Outcome, Rejected, Some }
import v2.std.node { Symbol }
import std.optional { Absent, Present }
import v2.test.claim.compiler.callback_argument_formal { caf_correction_type }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }
import std.algebra { Empty, FreeMonoid }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.cross_tree.import_model { DagTree }
import v2.test.claim.compiler.infer_record_construct_field_inhabitance_witness {
  RcfInferAccepted,
  RcfInferRefused,
  RcfResolveRefused,
  rcf_refusal,
  rcf_verdict,
  rcf_read_in
}

// A TYPE VARIABLE UNDECIDES ONLY ITS OWN POSITION; A CONCRETE SIBLING IS STILL JUDGED.
//
// The specimen is a callee `fn skp_take<K>(m: Pair<K, String>) -> Int` applied to `Pair<Int, Int>`:
// K is the callee's variable, so its position is undecided, but the second argument is concrete and
// disagrees (Int at String). v2.std.inhabitance inhabitance_pair_undecidable_reason used to make the
// WHOLE pair UndecidableGenericFormal as soon as either side mentioned a variable anywhere, so infer
// admitted it with an advisory; it now judges the sibling positions (inhabitance_positions_disagree)
// and a disagreeing sibling wins over the undecided position. v1's counterpart is
// v1.compiler.types application_arguments_verdict. Not imported: the relation is mirrored, not shared.
// THE CONTROL IS ONE TERM AWAY: `Pair<Int, String>` agrees at the concrete sibling and K stays undecided.

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data skp_types_source: String = "module std.types\n\nimport std.algebra { FreeMonoid }\n\ntype List<element> = FreeMonoid<element>\n\ntype Pair<A, B> = Mk { first: A, second: B }\n"
data skp_algebra_source: String = "module std.algebra\n\ntype FreeMonoid<T>\n  = Empty\n  | Cons { head: T, tail: FreeMonoid<T> }\n"

fn skp_probe_source_with(module_name: String, formal: String, produced: String) -> String {
  join(["module ", module_name, "\n\nimport std.types { List, Pair }\n\nfn skp_take<K>(m: ", formal, ") -> Int {\n  0\n}\n\nfn skp_call(p: ", produced, ") -> Int {\n  skp_take(m: p)\n}\n"], "")
}

fn skp_probe_source(module_name: String, produced: String) -> String {
  skp_probe_source_with(module_name: module_name, formal: "Pair<K, String>", produced: produced)
}

data skp_red_source: String = skp_probe_source(module_name: "gunbc.skp_red", produced: "Pair<Int, Int>")
data skp_nested_var_red_source: String = skp_probe_source_with(module_name: "gunbc.skp_nested_var_red", formal: "Pair<List<K>, String>", produced: "Pair<List<Int>, Int>")
data skp_nested_sibling_red_source: String = skp_probe_source_with(module_name: "gunbc.skp_nested_sibling_red", formal: "Pair<Pair<K, String>, Int>", produced: "Pair<Pair<Int, Int>, Int>")
data skp_nested_var_control_source: String = skp_probe_source_with(module_name: "gunbc.skp_nested_var_control", formal: "Pair<List<K>, String>", produced: "Pair<List<Int>, String>")
data skp_control_source: String = skp_probe_source(module_name: "gunbc.skp_control", produced: "Pair<Int, String>")

data skp_ingest: SourceRootIngest = [
  rcf_read_in(tree: DagTree, source: skp_algebra_source, id: ^skp_algebra_read, unit: ^skp_algebra_cu, path: "dag/std/algebra.dag"),
  rcf_read_in(tree: DagTree, source: skp_types_source, id: ^skp_types_read, unit: ^skp_types_cu, path: "dag/std/types.dag"),
  rcf_read_in(tree: DagTree, source: skp_red_source, id: ^skp_red_read, unit: ^skp_red_cu, path: "dag/gunbc/skp_red.dag"),
  rcf_read_in(tree: DagTree, source: skp_control_source, id: ^skp_control_read, unit: ^skp_control_cu, path: "dag/gunbc/skp_control.dag"),
  rcf_read_in(tree: DagTree, source: skp_nested_var_red_source, id: ^skp_nested_var_red_read, unit: ^skp_nested_var_red_cu, path: "dag/gunbc/skp_nested_var_red.dag"),
  rcf_read_in(tree: DagTree, source: skp_nested_sibling_red_source, id: ^skp_nested_sibling_red_read, unit: ^skp_nested_sibling_red_cu, path: "dag/gunbc/skp_nested_sibling_red.dag"),
  rcf_read_in(tree: DagTree, source: skp_nested_var_control_source, id: ^skp_nested_var_control_read, unit: ^skp_nested_var_control_cu, path: "dag/gunbc/skp_nested_var_control.dag")
]

fn skp_resolve_subject(subject: String) -> Outcome<ResolvedTree> {
  match module_roots_from_source_root_ingest(ingest: skp_ingest, lm: dag_language_model()) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_in_context(
        context: resolution_context(lm: dag_language_model(), roots: roots, index: source_root_index_empty(), active_roots: Empty, policy: default_name_resolution_policy()),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject) },
          imports: Empty
        }
      ).resolved
  }
}

fn skp_refused_at_the_argument(subject: String) -> Bool {
  match rcf_refusal(resolved: skp_resolve_subject(subject: subject), reason: ^application_argument_does_not_inhabit) {
    Absent => false
    Present { value: d } =>
      match caf_correction_type(d: d, name: ^m) {
        Absent => false
        Present { value: _ } => true
      }
  }
}

fn skp_accepted(subject: String) -> Bool {
  match rcf_verdict(resolved: skp_resolve_subject(subject: subject)) {
    RcfInferAccepted { diagnostics: _ } => true
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

// The decided-vs-undecided cell: a pair whose concrete positions all agree stays UNDECIDED (accepted
// carrying the generic-formal advisory), never Inhabits. Only infer_grounding_not_derived is admitted.
fn skp_only_admitted_advisories(d: Diagnostics) -> Bool {
  match d {
    None => true
    Some { diagnostics: nd } =>
      fold(concat([nd.head], nd.tail), init: true, f: fn(acc, x) { acc && (x.reason == ^infer_grounding_not_derived) })
  }
}

fn skp_accepted_but_undecided(subject: String) -> Bool {
  match rcf_verdict(resolved: skp_resolve_subject(subject: subject)) {
    RcfInferAccepted { diagnostics: ds } => !skp_only_admitted_advisories(d: ds)
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

test fn skp_a_variable_nested_in_a_position_does_not_hide_a_concrete_sibling_refuses_holds() -> Bool {
  skp_refused_at_the_argument(subject: "gunbc.skp_nested_var_red")
}

test fn skp_a_concrete_mismatch_nested_beside_a_variable_refuses_holds() -> Bool {
  skp_refused_at_the_argument(subject: "gunbc.skp_nested_sibling_red")
}

test fn skp_agreeing_concrete_positions_beside_a_variable_stay_undecided_holds() -> Bool {
  skp_accepted_but_undecided(subject: "gunbc.skp_control") && skp_accepted_but_undecided(subject: "gunbc.skp_nested_var_control")
}

test fn skp_a_variable_at_the_first_position_does_not_hide_a_concrete_second_mismatch_refuses_holds() -> Bool {
  skp_refused_at_the_argument(subject: "gunbc.skp_red")
}

test fn skp_a_variable_at_the_first_position_with_an_agreeing_second_is_accepted_holds() -> Bool {
  skp_accepted(subject: "gunbc.skp_control")
}
