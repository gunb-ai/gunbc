}

// The reducer's controls over supplied body facts. The extraction that produces such facts from a
// resolved tree is exercised by the source-snippet controls beside these.
fn epc_site(occurrence: Int) -> EffectSite {
  EffectSite { occurrence: occurrence, locus: CallSiteUnlocated, ordinal: 0, callee: FactStaticCall { callee: qualified_name_from_dotted_string(dotted: "t.shell") }, reason: ReachesHostActuation, contexts: Empty }
}

fn epc_facts_with(sites: List<EffectSite>, orders: List<OrderEdge>, exclusive: List<OrderEdge>) -> BodyEffectFacts {
  BodyEffectFacts {
    module: qualified_name_from_dotted_string(dotted: "t"),
    function: qualified_name_from_dotted_string(dotted: "t.f"),
    sites: sites,
    orders: orders,
    exclusive: exclusive
  }
}

fn epc_two_sites() -> List<EffectSite> {
  list_snoc_item(xs: list_snoc_item(xs: Empty, item: epc_site(occurrence: 1)), item: epc_site(occurrence: 2))
}

fn epc_three_sites() -> List<EffectSite> {
  list_snoc_item(xs: epc_two_sites(), item: epc_site(occurrence: 3))
}

fn epc_facts(orders: List<OrderEdge>) -> BodyEffectFacts {
  epc_facts_with(sites: epc_two_sites(), orders: orders, exclusive: Empty)
}

// POSITIVE CONTROL: two effects nothing orders are listed.
test fn two_unrelated_effects_are_one_pair_holds() -> Bool {
  length(xs: body_effect_pairs(facts: epc_facts(orders: Empty)).pairs) == 1
}

// NEGATIVE CONTROL: the second effect depends on the first, so the pair is not listed.
test fn a_second_effect_using_the_first_is_not_a_pair_holds() -> Bool {
  length(xs: body_effect_pairs(facts: epc_facts(orders: list_snoc_item(xs: Empty, item: OrderEdge { from: 1, to: 2 }))).pairs) == 0
}


// ORDER IS TRANSITIVE: 1 before 2 and 2 before 3 order 1 and 3 with no direct edge, so no pair is listed.
test fn a_chain_of_orders_leaves_no_pair_holds() -> Bool {
  length(xs: body_effect_pairs(facts: epc_facts_with(
    sites: epc_three_sites(),
    orders: list_snoc_item(xs: list_snoc_item(xs: Empty, item: OrderEdge { from: 1, to: 2 }), item: OrderEdge { from: 2, to: 3 }),
    exclusive: Empty
  )).pairs) == 0
}

// A CHAIN OF DIAMONDS: diamond i runs 3i -> 3i+1 and 3i+2 -> 3i+3, so a walk that keeps a duplicate per
// path meets 2^n frontier entries by the last diamond. Fuel is the diamond count and descends by one.
fn epc_diamonds(n: Int, acc: List<OrderEdge>) -> List<OrderEdge> {
  if n < 1 {
    acc
  } else {
    let b = (n - 1) * 3
    epc_diamonds(n: n - 1, acc: list_snoc_item(xs: list_snoc_item(xs: list_snoc_item(xs: list_snoc_item(xs: acc,
      item: OrderEdge { from: b, to: b + 1 }),
      item: OrderEdge { from: b, to: b + 2 }),
      item: OrderEdge { from: b + 1, to: b + 3 }),
      item: OrderEdge { from: b + 2, to: b + 3 }))
  }
}

// DISCRIMINATING CONTROL for the visited set: the two ends of twenty-two chained diamonds are ordered, so no
// pair is listed, and the answer is reached in a number of steps linear in the diamonds. Without a
// visited set the forward walk meets 2^22 duplicate frontier entries and exhausts the claim's cost budget.
test fn twenty_two_chained_diamonds_order_their_ends_in_linear_steps_holds() -> Bool {
  length(xs: body_effect_pairs(facts: epc_facts_with(
    sites: list_snoc_item(xs: list_snoc_item(xs: Empty, item: epc_site(occurrence: 0)), item: epc_site(occurrence: 66)),
    orders: epc_diamonds(n: 22, acc: Empty),
    exclusive: Empty
  )).pairs) == 0
}

// ONE ORDERED PAIR DOES NOT HIDE ITS NEIGHBOURS: 1 before 2 leaves (1,3) and (2,3) unordered.
test fn one_order_among_three_leaves_two_pairs_holds() -> Bool {
  length(xs: body_effect_pairs(facts: epc_facts_with(
    sites: epc_three_sites(),
    orders: list_snoc_item(xs: Empty, item: OrderEdge { from: 1, to: 2 }),
    exclusive: Empty
  )).pairs) == 2
}

// EXCLUSIVE ARMS ARE NOT A PAIR but are reported apart, so the absence is not silent.
test fn sites_in_exclusive_arms_are_reported_apart_holds() -> Bool {
  let r = body_effect_pairs(facts: epc_facts_with(
    sites: epc_two_sites(),
    orders: Empty,
    exclusive: list_snoc_item(xs: Empty, item: OrderEdge { from: 1, to: 2 })
  ))
  (length(xs: r.pairs) == 0) && (length(xs: r.exclusive_pairs) == 1)
}

fn epc_caller_of(callee: String) -> FunctionFact {
  FunctionFact {
    path: qualified_name_from_dotted_string(dotted: "t.caller"),
    callees: list_snoc_item(xs: Empty, item: qualified_name_from_dotted_string(dotted: callee)),
    calls_function_value: false
  }
}

fn epc_none_operation(path: String) -> OperationFact {
  OperationFact { path: qualified_name_from_dotted_string(dotted: path), requirement: RequiresNone }
}

fn epc_caller_reaches(callee: String) -> Bool {
  let table = effect_reach_table(
    functions: list_snoc_item(xs: Empty, item: epc_caller_of(callee: callee)),
    operations: list_snoc_item(xs: Empty, item: epc_none_operation(path: callee))
  )
  match map_lookup(m: table.reasons, key: qualified_name_from_dotted_string(dotted: "t.caller")) {
    Present { value: _ } => true
    Absent => false
  }
}

// A RequiresNone operation whose rostered primitive ObservesHost makes its caller reach.
test fn a_requires_none_operation_with_host_semantics_makes_its_caller_reach_holds() -> Bool {
  epc_caller_reaches(callee: "v2.std.decl_index.decl_facts")
}

// An operation with no semantics row is Unknown: counted unclassified AND reaching.
test fn an_operation_with_no_semantics_row_is_unclassified_and_reaches_holds() -> Bool {
  let table = effect_reach_table(
    functions: list_snoc_item(xs: Empty, item: epc_caller_of(callee: "t.unrowed")),
    operations: list_snoc_item(xs: Empty, item: epc_none_operation(path: "t.unrowed"))
  )
  length(xs: table.unclassified) == 1 && epc_caller_reaches(callee: "t.unrowed")
}

// Pure and ReadsBoundInput semantics do not reach.
test fn pure_and_bound_input_semantics_do_not_reach_holds() -> Bool {
  match reach_reason_of_semantics(s: Pure) {
    Absent =>
      match reach_reason_of_semantics(s: ReadsBoundInput { input_identity: ^x }) {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: _ } => false
  }
}

fn epc_repeat_body() -> BodyOrdered {
  BodyOrdered {
    module: qualified_name_from_dotted_string(dotted: "t"),
    function: qualified_name_from_dotted_string(dotted: "t.f"),
    sites: list_snoc_item(xs: Empty, item: FactCallSite { occurrence: Absent, callee: FactStaticCall { callee: qualified_name_from_dotted_string(dotted: "t.shell") }, enter: 1, exit: 2, operands: Empty }),
    orders: Empty,
    exclusive: Empty,
    not_derived: Empty,
    activation_not_derived: Empty,
    repetition_unknown: Empty,
    repeated: list_snoc_item(xs: Empty, item: RepeatedOccurrence { occurrence: 1, source: LoopIteratedBody }),
    groups: Empty
  }
}

// One effect site inside a Loop extent runs repeatedly: one repeated row, and no pair.
test fn a_site_in_a_loop_extent_gives_one_repeated_row_holds() -> Bool {
  let table = effect_reach_table(
    functions: Empty,
    operations: list_snoc_item(xs: Empty, item: OperationFact { path: qualified_name_from_dotted_string(dotted: "t.shell"), requirement: RequiresOpaque })
  )
  let r = effect_pair_census_of_module(module: qualified_name_from_dotted_string(dotted: "t"), bodies: list_snoc_item(xs: Empty, item: epc_repeat_body()), table: table)
  length(xs: r.repeated) == 1 && length(xs: r.pairs) == 0
}


// ---- THE REAL EXTRACTOR OVER SUPPLIED TREES ---------------------------------------------------------
// The D13 walk (demand_fact_walk_children) runs on supplied Node roots, and its groups feed the real reducer
// activation_edges, so the boundary under test is the walk's roles and A2 join, not hand-written spans. The
// shapes (four-positional Branch, labeled Match child, malformed arm, shared node) are ones the front end never
// writes; the shared-node controls below pair with the source control that the front end does write a three
// positional Branch whose roles are read (epc_branch_source).
data epc_fe_artifact: Artifact = Artifact { kind: SourceFile, id: ^epc_fe_artifact, file_path: "src/v2/test/fixture/effect_pair_census.dag" }

data epc_branch_source: String = "module acd\n\nfn f(c: Bool, a: Int, b: Int) -> Int {\n  if c { a + 1 } else { b + 2 }\n}\n"

fn epc_tree() -> Optional<ResolvedTree> {
  match assemble_program_from_ingest(
    ingest: Cons {
      head: DagSourceReadWitness { source: Medium { carried: epc_branch_source, fidelity: Lossless }, artifact: epc_fe_artifact, compilation_unit: ^epc_fe_cu, source_root: V2Tree },
      tail: Empty
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^acd, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  ) {
    Accepted { value: resolved, diagnostics: _ } => optional_present(value: resolved)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

// A marked declaration reference, because only a reference ticks the walk: an Atom leaves every span empty, so a
// control built from Atoms would hold no site and prove nothing.
fn epc_atom(s: Symbol) -> Node {
  resolved_reference_node_of_kind(kind: DeclarationReferenceKind, qn: qualified_name_from_dotted_string(dotted: "t.shell"), occurrence_id: OccurrenceSynthetic)
}

fn epc_pos(target: Node) -> Edge {
  Edge { label: Positional, target: target, declaration: NotADeclaration }
}

fn epc_arm(pattern: Node, body: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: core_edge_label(marker: MatchArmPatternEdge), target: pattern, declaration: NotADeclaration },
      Edge { label: core_edge_label(marker: MatchArmBodyEdge), target: body, declaration: NotADeclaration }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn epc_walk_groups(node: Node) -> List<FactGroup> {
  match epc_tree() {
    Absent => Empty
    Present { value: tree } =>
      demand_fact_walk_children(
        w: DemandFactWalk { functions: Empty, operations: Empty, audited: Empty, current: Empty, value_call: false, sites: Empty, bodies: Empty, tick: 0, groups: Empty },
        position: qualified_name_from_dotted_string(dotted: "t.f"),
        node: node,
        resolved: tree
      ).groups
  }
}

fn epc_spans_of(g: FactGroup) -> List<FactSpan> {
  match g {
    FactActivationGroup { children: c, not_derived: _ } => c
    FactRepeatedGroup { children: c, repetition: _ } => c
  }
}

fn epc_sites_in(spans: List<FactSpan>) -> List<FactCallSite> {
  fold_list(xs: spans, empty: Empty, cons: fn(acc, sp) {
    list_snoc_item(xs: acc, item: FactCallSite { occurrence: Absent, callee: FactStaticCall { callee: qualified_name_from_dotted_string(dotted: "t.shell") }, enter: sp.enter, exit: sp.exit, operands: Empty })
  })
}

fn epc_unroled_all(spans: List<FactSpan>) -> Bool {
  fold_list(xs: spans, empty: true, cons: fn(acc, sp) { acc && (match sp.role { FactUnroled => true, _ => false }) })
}

fn epc_nonempty(spans: List<FactSpan>) -> Bool {
  fold_list(xs: spans, empty: true, cons: fn(acc, sp) { acc && (sp.exit > sp.enter) })
}

fn epc_single_group(node: Node) -> Optional<FactGroup> {
  match epc_walk_groups(node: node) {
    Cons { head: g, tail: Empty } => optional_present(value: g)
    _ => optional_absent()
  }
}

// A FOUR-POSITIONAL Branch is not condition/then/else: A2 refuses it, so the group carries that typed reason, roles
// no span, and the reducer orders and excludes nothing (the refusal is carried, never guessed at from position).
// RED if the walk or the reducer reads "first child = selector, the rest = arms".
test fn a_four_positional_branch_is_carried_as_not_derived_and_orders_nothing_holds() -> Bool {
  match epc_single_group(node: Node { kind: ComputationNode { behavior: Branch }, children: [epc_pos(target: epc_atom(s: ^e1)), epc_pos(target: epc_atom(s: ^e2)), epc_pos(target: epc_atom(s: ^e3)), epc_pos(target: epc_atom(s: ^e4))], occurrence_id: OccurrenceSynthetic }) {
    Absent => false
    Present { value: g } =>
      match g {
        FactRepeatedGroup { children: _, repetition: _ } => false
        FactActivationGroup { children: spans, not_derived: nd } => {
          let e = activation_edges(sites: epc_sites_in(spans: spans), groups: list_snoc_item(xs: Empty, item: g))
          (match nd { Present { value: _ } => true, Absent => false }) && epc_nonempty(spans: spans) && epc_unroled_all(spans: spans) && length(xs: e.orders) == 0 && length(xs: e.exclusive) == 0 && length(xs: e.refusals) == 1
        }
      }
  }
}

// A MALFORMED MATCH ARM (an arm without its pattern/body markers): refused by A2 as MatchArmMalformed; carried, no roles.
test fn a_malformed_match_arm_is_carried_as_not_derived_and_orders_nothing_holds() -> Bool {
  match epc_single_group(node: Node { kind: ComputationNode { behavior: Match }, children: [epc_pos(target: epc_atom(s: ^s)), epc_pos(target: epc_atom(s: ^not_an_arm)), epc_pos(target: epc_arm(pattern: epc_atom(s: ^p), body: epc_atom(s: ^b)))], occurrence_id: OccurrenceSynthetic }) {
    Absent => false
    Present { value: g } =>
      match g {
        FactRepeatedGroup { children: _, repetition: _ } => false
        FactActivationGroup { children: spans, not_derived: nd } => {
          let e = activation_edges(sites: epc_sites_in(spans: spans), groups: list_snoc_item(xs: Empty, item: g))
          (match nd { Present { value: _ } => true, Absent => false }) && epc_nonempty(spans: spans) && epc_unroled_all(spans: spans) && length(xs: e.orders) == 0 && length(xs: e.exclusive) == 0
        }
      }
  }
}

// A LABELED CHILD of a Match is neither selector nor arm: its span is FactUnroled, and the positional scrutinee and
// arms keep their slot roles (or, were the site refused, every span is unroled). RED if the walk counts positions
// over all children (the labeled child would take the first arm's place).
test fn a_labeled_match_child_takes_no_role_and_positions_count_positionals_only_holds() -> Bool {
  match epc_single_group(node: Node { kind: ComputationNode { behavior: Match }, children: [
    epc_pos(target: epc_atom(s: ^s)),
    Edge { label: core_edge_label(marker: MatchArmBodyEdge), target: epc_atom(s: ^labeled), declaration: NotADeclaration },
    epc_pos(target: epc_arm(pattern: epc_atom(s: ^p1), body: epc_atom(s: ^b1))),
    epc_pos(target: epc_arm(pattern: epc_atom(s: ^p2), body: epc_atom(s: ^b2)))
  ], occurrence_id: OccurrenceSynthetic }) {
    Absent => false
    Present { value: g } =>
      match g {
        FactRepeatedGroup { children: _, repetition: _ } => false
        FactActivationGroup { children: spans, not_derived: nd } =>
          match nd {
            Present { value: _ } => epc_unroled_all(spans: spans)
            Absent =>
              match spans {
                Cons { head: a, tail: Cons { head: b, tail: Cons { head: c, tail: Cons { head: d, tail: Empty } } } } =>
                  (match a.role { FactSelector => true, _ => false }) && (match b.role { FactUnroled => true, _ => false }) && (match c.role { FactAlternative => true, _ => false }) && (match d.role { FactAlternative => true, _ => false })
                _ => false
              }
          }
      }
  }
}

// SHARED NODES: the condition IS the else arm (one node). Spans are keyed by extent, not node identity, so the
// selector orders before BOTH arms and the two arms are alternatives: two orders, one exclusive pair. RED if the
// reducer finds roles by node equality.
test fn a_shared_selector_and_arm_node_keeps_roles_by_slot_holds() -> Bool {
  match epc_single_group(node: Node { kind: ComputationNode { behavior: Branch }, children: [epc_pos(target: epc_atom(s: ^shared)), epc_pos(target: epc_atom(s: ^then_arm)), epc_pos(target: epc_atom(s: ^shared))], occurrence_id: OccurrenceSynthetic }) {
    Absent => false
    Present { value: g } =>
      match g {
        FactRepeatedGroup { children: _, repetition: _ } => false
        FactActivationGroup { children: spans, not_derived: nd } => {
          let e = activation_edges(sites: epc_sites_in(spans: spans), groups: list_snoc_item(xs: Empty, item: g))
          (match nd { Present { value: _ } => false, Absent => true }) && epc_nonempty(spans: spans) && length(xs: e.orders) == 2 && length(xs: e.exclusive) == 1
        }
      }
  }
}

// An absent OccurrenceId is the typed CallSiteUnlocated, and the printed anchor is the body-local call ordinal (3 here),
// never the walk tick (7), which is private. RED if the tick is printed.
test fn a_site_without_an_occurrence_identity_is_reported_unlocated_with_its_ordinal_holds() -> Bool {
  epc_site_text(s: EffectSite { occurrence: 7, locus: CallSiteUnlocated, ordinal: 3, callee: FactStaticCall { callee: qualified_name_from_dotted_string(dotted: "t.shell") }, reason: ReachesHostActuation, contexts: Empty })
    == "t.shell@call_site_unlocated contexts=none call_ordinal_in_function=3(host_actuation)"
}

// ---- REPETITION: only a Loop's iterated body repeats --------------------------------------------------
fn epc_loop_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Loop },
    children: [
      Edge { label: core_edge_label(marker: LoopDomainEdge), target: epc_atom(s: ^domain), declaration: NotADeclaration },
      epc_pos(target: epc_atom(s: ^body))
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn epc_lambda_node() -> Node {
  Node { kind: TypeNode { connective: Arrow }, children: [epc_pos(target: epc_atom(s: ^lam))], occurrence_id: OccurrenceSynthetic }
}

// A declaration Arrow: its body is the ArrowBodyEdge child (without one it is an operation arrow, not a fn).
fn epc_decl_arrow() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [Edge { label: core_edge_label(marker: ArrowBodyEdge), target: epc_atom(s: ^body), declaration: NotADeclaration }],
    occurrence_id: OccurrenceSynthetic
  }
}

fn epc_fn_walk() -> Optional<DemandFactWalk> {
  match epc_tree() {
    Absent => optional_absent()
    Present { value: tree } =>
      optional_present(value: demand_fact_declaration(
        w: DemandFactWalk { functions: Empty, operations: Empty, audited: Empty, current: Empty, value_call: false, sites: Empty, bodies: Empty, tick: 0, groups: Empty },
        path: qualified_name_from_dotted_string(dotted: "t.f"),
        node: epc_decl_arrow(),
        resolved: tree
      ))
  }
}

// A Loop with an effect-bearing DOMAIN and BODY: exactly one repeated extent, the iterated body; the domain runs once.
// RED if the whole Loop (every child) is one repeated span: the domain's site would be counted too.
test fn a_loop_repeats_only_its_iterated_body_not_its_domain_holds() -> Bool {
  match epc_single_group(node: epc_loop_node()) {
    Absent => false
    Present { value: g } =>
      match g {
        FactActivationGroup { children: _, not_derived: _ } => false
        FactRepeatedGroup { children: spans, repetition: r } =>
          length(xs: spans) == 1 && epc_nonempty(spans: spans) && (match r { LoopIteratedBody => true, _ => false })
      }
  }
}

// A lambda walked as a value is exactly one repeated-unknown group: typed unknown, never LoopIteratedBody.
test fn an_inline_lambda_is_a_typed_unknown_not_a_repeated_site_holds() -> Bool {
  match epc_single_group(node: epc_lambda_node()) {
    Absent => false
    Present { value: g } =>
      match g {
        FactRepeatedGroup { children: spans, repetition: r } =>
          epc_nonempty(spans: spans) && (match r { LambdaInstantiationUnknown => true, _ => false })
        _ => false
      }
  }
}

// The SAME Arrow as a declaration body is the fn's own, not repeated: one body row, no repetition group. NOT shown here: that the body's sites were walked (measured 0 sites
// through the ArrowBodyEdge route), so this control discriminates the declaration-Arrow route only.
// RED if the declaration's own Arrow counts as a repetition (the old whole-extent behaviour).
test fn an_ordinary_fn_declaration_records_no_repetition_holds() -> Bool {
  match epc_fn_walk() {
    Absent => false
    Present { value: w } =>
      match w.bodies {
        Cons { head: b, tail: Empty } => length(xs: b.groups) == 0
        _ => false
      }
  }
}

fn epc_ctx_groups() -> List<FactGroup> {
  [
    FactActivationGroup { children: [FactSpan { enter: 0, exit: 2, role: FactSelector }, FactSpan { enter: 2, exit: 6, role: FactAlternative }], not_derived: Empty },
    FactRepeatedGroup { children: [FactSpan { enter: 3, exit: 5, role: FactUnroled }], repetition: LoopIteratedBody }
  ]
}

// ONE structural occurrence evaluated in more than one context lists EVERY context, not one: tick 4 is an
// alternative of the Branch AND inside the Loop's iterated body. RED if only the first (or the innermost) context is reported.
test fn one_occurrence_in_two_contexts_lists_both_holds() -> Bool {
  epc_contexts_word(cs: site_contexts(sites: Empty, groups: epc_ctx_groups(), tick: 4)) == "activation:alternative+repeated:loop_iterated_body"
}

// The role distinguishes selector from alternative, and a site under no extent is "none".
test fn a_selector_site_and_an_unnested_site_report_their_own_role_holds() -> Bool {
  epc_contexts_word(cs: site_contexts(sites: Empty, groups: epc_ctx_groups(), tick: 1)) == "activation:selector"
    && epc_contexts_word(cs: site_contexts(sites: Empty, groups: epc_ctx_groups(), tick: 9)) == "none"
}


// ---- THE CALL-SITE POPULATION, THROUGH THE REAL FRONT END AND demand_fact_note_site ----------------------------
// These controls read demand_census_module_facts over ingested source, so every site below is made by
// demand_fact_note_site (the controls above that call demand_fact_walk_children directly never reach it).
data epc_fv_source: String = "module acd\n\nfn an_effect() -> Int {\n  1\n}\n\nfn f(g: fn() -> Int) -> Int {\n  let a = g()\n  let b = an_effect()\n  b\n}\n"

data epc_flag_source: String = "module acd\n\ndata an_flag: Bool = true\n\nfn f() -> Int {\n  if an_flag { 1 } else { 2 }\n}\n"

data epc_param_selector_source: String = "module acd\n\nfn an_effect() -> Int {\n  1\n}\n\nfn f(flag: Bool) -> Int {\n  let b = an_effect()\n  if flag { b } else { 2 }\n}\n"

data epc_ordinal_source: String = "module acd\n\ndata an_value: Int = 3\n\nfn an_effect() -> Int {\n  1\n}\n\nfn f() -> Int {\n  let a = an_value\n  let b = an_effect()\n  an_effect()\n}\n"

fn epc_source_bodies(source: String) -> List<FactBodySites> {
  match assemble_program_from_ingest(
    ingest: Cons {
      head: DagSourceReadWitness { source: Medium { carried: source, fidelity: Lossless }, artifact: epc_fe_artifact, compilation_unit: ^epc_fe_cu, source_root: V2Tree },
      tail: Empty
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^acd, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  ) {
    Accepted { value: tree, diagnostics: _ } => demand_census_module_facts(resolved: tree, module_qn: Cons { head: ^acd, tail: Empty }).bodies
    Rejected { diagnostics: _ } => Empty
  }
}

fn epc_body_of_f(bodies: List<FactBodySites>) -> Optional<FactBodySites> {
  fold_list(xs: bodies, empty: optional_absent(), cons: fn(acc, b) {
    if b.function == qualified_name_from_dotted_string(dotted: "acd.f") { optional_present(value: b) } else { acc }
  })
}

fn epc_f_sites(source: String) -> Optional<List<FactCallSite>> {
  match epc_body_of_f(bodies: epc_source_bodies(source: source)) {
    Present { value: b } => optional_present(value: b.sites)
    Absent => optional_absent()
  }
}

fn epc_is_function_value_site(s: FactCallSite) -> Bool {
  match s.callee {
    FactFunctionValueCall { head: FactParameterHead } => true
    _ => false
  }
}

fn epc_is_static_site_of(s: FactCallSite, dotted: String) -> Bool {
  match s.callee {
    FactStaticCall { callee: c } => c == qualified_name_from_dotted_string(dotted: dotted)
    _ => false
  }
}

fn epc_census_pairs(source: String) -> List<EffectPairRow> {
  effect_pair_census_of_module(
    module: qualified_name_from_dotted_string(dotted: "acd"),
    bodies: module_ordered_bodies(module: qualified_name_from_dotted_string(dotted: "acd"), bodies: epc_source_bodies(source: source), uses: Empty, not_derived: Empty),
    table: effect_reach_table(
      functions: Empty,
      operations: list_snoc_item(xs: Empty, item: OperationFact { path: qualified_name_from_dotted_string(dotted: "acd.an_effect"), requirement: RequiresOpaque })
    )
  ).pairs
}

// POSITIVE: a call through a PARAMETER beside a static effect is two sites, the function-value one typed as such,
// and (nothing orders them) exactly ONE candidate pair. RED if the function-value arm is removed (one site, no pair).
test fn a_function_value_call_beside_a_static_effect_is_one_candidate_pair_holds() -> Bool {
  match epc_f_sites(source: epc_fv_source) {
    Absent => false
    Present { value: sites } =>
      length(xs: sites) == 2
        && fold_list(xs: sites, empty: false, cons: fn(a, s) { a || epc_is_function_value_site(s: s) })
        && fold_list(xs: sites, empty: false, cons: fn(a, s) { a || epc_is_static_site_of(s: s, dotted: "acd.an_effect") })
        && length(xs: epc_census_pairs(source: epc_fv_source)) == 1
  }
}

// NEGATIVE: a Branch whose selector is a bare declaration reference is no call. RED if the first-child test
// stands without the Transform guard (the Branch is reported as a call of acd.an_flag).
test fn a_branch_with_a_declaration_reference_selector_is_not_a_call_site_holds() -> Bool {
  match epc_f_sites(source: epc_flag_source) {
    Absent => false
    Present { value: sites } => length(xs: sites) == 0
  }
}

// NEGATIVE, THE GUARD'S OWN CASE: a Branch whose selector is a bare PARAMETER reference beside one static effect is
// ONE site (the static call) and no pair. Without the Transform guard the parameter-head test reads the Branch's first
// child and mints a function-value site for the selector, so the counts change. RED if the guard is dropped.
test fn a_branch_with_a_parameter_selector_is_not_a_call_site_holds() -> Bool {
  match epc_f_sites(source: epc_param_selector_source) {
    Absent => false
    Present { value: sites } => length(xs: sites) == 1 && length(xs: epc_census_pairs(source: epc_param_selector_source)) == 0
  }
}

// ORDINAL: two calls preceded by an unrelated declaration reference read ordinals 0 and 1, while the private walk
// tick of the first is past 0 (it advanced across the data reference and the earlier declaration). RED if the
// tick is reported as the ordinal.
test fn call_ordinals_reset_per_function_and_ignore_unrelated_references_holds() -> Bool {
  match epc_census_pairs(source: epc_ordinal_source) {
    Cons { head: p, tail: Empty } => p.first.ordinal == 0 && p.second.ordinal == 1 && p.first.occurrence > 0
    _ => false
  }
}
