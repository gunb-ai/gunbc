// LOCATOR 9: the callee of the first recorded obligation's application, in the facts discharge will read.
// 0 resolve/infer refused, 1 no obligation, 2 callee not first child, 3 callee has no facts entry,
// 4 entry carries no denotation, 5 entry carries a denotation.
fn lrj_callee_facts_code(subject: String) -> Int {
  match lrj_resolve(subject: subject) {
    Rejected { diagnostics: _ } => 0
    Accepted { value: r, diagnostics: _ } =>
      match infer(tree: r) {
        Rejected { diagnostics: _ } => 0
        Accepted { value: t, diagnostics: _ } =>
          match t.obligations {
            Empty => 1
            Cons { head: o, tail: _ } =>
              match positional_child_target_nodes(node: o.application) {
                Empty => 2
                Cons { head: callee, tail: _ } =>
                  match t.facts.lookup(callee) {
                    Absent => 3
                    Present { value: f } => match f.denotation { Absent => 4  Present { value: _ } => 5 }
                  }
              }
          }
      }
  }
}

test fn lrj_callee_facts_is_1_holds() -> Bool { lrj_callee_facts_code(subject: "v2.test.lrj_holds") == 1 }
test fn lrj_callee_facts_is_2_holds() -> Bool { lrj_callee_facts_code(subject: "v2.test.lrj_holds") == 2 }
test fn lrj_callee_facts_is_3_holds() -> Bool { lrj_callee_facts_code(subject: "v2.test.lrj_holds") == 3 }
test fn lrj_callee_facts_is_4_holds() -> Bool { lrj_callee_facts_code(subject: "v2.test.lrj_holds") == 4 }
test fn lrj_callee_facts_is_5_holds() -> Bool { lrj_callee_facts_code(subject: "v2.test.lrj_holds") == 5 }

// LOCATOR 10: which CHILD of the obligation's application the evaluator refuses when evaluated alone.
// 0 resolve/infer refused, 1 no obligation, 2 shape, then 10 + (literal evaluates ? 1 : 0) + (callee evaluates ? 2 : 0).
fn lrj_child_evaluates(tree: InferredTree, root: Node) -> Bool {
  match eval(tree: tree, interpretation: v2_evaluator_interpretation(), inputs: inputs_root_only(root: root)) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn lrj_children_code(subject: String) -> Int {
  match lrj_resolve(subject: subject) {
    Rejected { diagnostics: _ } => 0
    Accepted { value: r, diagnostics: _ } =>
      match infer(tree: r) {
        Rejected { diagnostics: _ } => 0
        Accepted { value: t, diagnostics: _ } =>
          match t.obligations {
            Empty => 1
            Cons { head: o, tail: _ } =>
              match positional_child_target_nodes(node: o.application) {
                Cons { head: callee, tail: Cons { head: literal, tail: _ } } =>
                  let tree = InferredTree { root: t.root, facts: t.facts }
                  let lit = if lrj_child_evaluates(tree: tree, root: literal) { 1 } else { 0 }
                  let cal = if lrj_child_evaluates(tree: tree, root: callee) { 2 } else { 0 }
                  10 + lit + cal
                _ => 2
              }
          }
      }
  }
}

test fn lrj_children_is_10_holds() -> Bool { lrj_children_code(subject: "v2.test.lrj_holds") == 10 }
