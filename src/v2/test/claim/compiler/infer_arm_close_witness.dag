module v2.test.claim.compiler.infer_arm_close_witness

import v2.compiler.resolve { ResolvedTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model }
import std.algebra { Cons, Empty }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason, diagnostics_has_reason, Some }
import v2.std.node { Symbol }
import std.optional { Absent, Optional, Present }
import std.types { Bool, Int, List, String }
import v2.compiler.infer { infer }
import v2.test.claim.optional_sugar_declaration_bound { osd_std_optional }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data ers_artifact: Artifact = Artifact { kind: SourceFile, id: ^infer_expected_return_seed_artifact, file_path: "src/v2/pilot/ers_pilot.dag" }
data ers_collection_artifact: Artifact = Artifact { kind: SourceFile, id: ^infer_expected_return_seed_collection_artifact, file_path: "src/v2/pilot/ers_collection_pilot.dag" }
data ers_algebra_artifact: Artifact = Artifact { kind: SourceFile, id: ^infer_expected_return_seed_algebra_artifact, file_path: "src/v2/pilot/ers_algebra_pilot.dag" }
data ers_std_artifact: Artifact = Artifact { kind: SourceFile, id: ^infer_expected_return_seed_std_artifact, file_path: "src/v2/pilot/ers_std_pilot.dag" }

fn ers_witness(src: String, artifact: Artifact) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: src, fidelity: Lossless },
    artifact: artifact,
    compilation_unit: ^infer_expected_return_seed_cu,
    source_root: V2Tree
  }
}

fn ers_assemble(body: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: [
      ers_witness(src: concat("module p\n\nimport std.optional { Absent, Optional, Present }\nimport v2.std.collection { List }\nimport std.algebra { collection_concat_shape }\n\n", body), artifact: ers_artifact),
      ers_witness(src: osd_std_optional(), artifact: ers_std_artifact),
      ers_witness(src: "module v2.std.collection\n\nimport std.algebra { FreeMonoid }\n\ntype List<T> = std.algebra.FreeMonoid<T>\n", artifact: ers_collection_artifact),
      ers_witness(src: "module std.algebra\n\ntype FreeMonoid<T> = | Empty | Cons { head: T, tail: FreeMonoid<T> }\n\nfn collection_concat_shape() -> Int { 0 }\n", artifact: ers_algebra_artifact)
    ],
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}


// RULE A (native): an application at a declared position is judged with its type variables seeded by matching the callee's
// declared return against the position's declared type (v2.compiler.infer infer_expected_return_seed). Every control runs the
// real route: assemble, resolve, infer. `none` is not used: it does not lower to Absent natively yet (a separate gap), and Absent
// at an expected T? exercises the seed exactly because Absent's own T is otherwise unbound.

fn ers_id2() -> String { "fn id2<T>(a: T?, b: T?) -> T? { a }\n\n" }
fn ers_row() -> String { "type Row {\n  f: Int?\n}\n\ntype Cell {\n  c: Int?\n}\n\n" }

fn ers_f() -> Outcome<ResolvedTree> { ers_assemble(body: concat(ers_id2(), "fn f() -> Int? { id2(Absent, Absent) }\n")) }
fn ers_h() -> Outcome<ResolvedTree> { ers_assemble(body: concat(ers_id2(), "fn h<U>() -> U? { id2(Absent, Absent) }\n")) }
fn ers_let_annotated() -> Outcome<ResolvedTree> { ers_assemble(body: concat(ers_id2(), "fn a() -> Int? {\n  let x: Int? = id2(Absent, Absent)\n  x\n}\n")) }
fn ers_g() -> Outcome<ResolvedTree> { ers_assemble(body: concat(ers_id2(), "fn g() -> Int? {\n  let x = id2(Absent, Absent)\n  x\n}\n")) }
fn ers_k() -> Outcome<ResolvedTree> { ers_assemble(body: concat(ers_row(), concat(ers_id2(), "fn keep<T>(a: T, b: T?) -> T? { b }\n\nfn k(c: Cell) -> Row? { keep(c, Absent) }\n"))) }
fn ers_plain() -> Outcome<ResolvedTree> { ers_assemble(body: "fn plain() -> Int? { 1 }\n") }
fn ers_planted() -> Outcome<ResolvedTree> { ers_assemble(body: "fn bad() -> Bool { 1 }\n") }

fn ers_infer_accepted(o: Outcome<ResolvedTree>) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

fn ers_fatal_is(o: Outcome<ResolvedTree>, reason: Symbol) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == reason
      }
  }
}

fn ers_error_count(o: Outcome<ResolvedTree>) -> Int {
  match o {
    Rejected { diagnostics: _ } => 0 - 1
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Accepted { value: _, diagnostics: _ } => 0
        Rejected { diagnostics: d } => fold(d.tail, init: 1, f: fn(acc, _x) { acc + 1 })
      }
  }
}


fn ers_pick() -> Outcome<ResolvedTree> { ers_assemble(body: concat(ers_row(), "fn pick<T>(a: T) -> T { a }\n\nfn kp(c: Cell) -> Row { pick(c) }\n")) }

fn rb_b1() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  let x = if true { Present { value: 1 } } else { Absent }\n  x\n}\n") }
test fn rb_b1_infer_accepts() -> Bool { ers_infer_accepted(o: rb_b1()) }

fn rb_b2() -> Outcome<ResolvedTree> { ers_assemble(body: "fn mk() -> Int? { Absent }\n\nfn t() -> Int? {\n  let x = if true { mk() } else { Absent }\n  x\n}\n") }
test fn rb_b2_infer_accepts() -> Bool { ers_infer_accepted(o: rb_b2()) }

fn rb_if_alias() -> Outcome<ResolvedTree> { ers_assemble(body: "type MyInt = Int\n\nfn t(a: MyInt, b: Int) -> Int {\n  if true { a } else { b }\n}\n") }
test fn rb_if_alias_arm_equals_underlying_arm_accepts() -> Bool { ers_infer_accepted(o: rb_if_alias()) }

fn rb_b6() -> Outcome<ResolvedTree> { ers_assemble(body: "fn mk() -> Int? { Present { value: 1 } }\n\nfn t() -> Int? {\n  if true { mk() } else { Present { value: 2 } }\n}\n") }
test fn rb_b6_application_arm_equals_constructor_arm_accepts() -> Bool { ers_infer_accepted(o: rb_b6()) }

fn rb_b3() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(o: Int?) -> Int? {\n  let x = match o {\n    Present { value: v } => Present { value: v }\n    Absent => Absent\n  }\n  x\n}\n") }
test fn rb_b3_infer_accepts() -> Bool { ers_infer_accepted(o: rb_b3()) }

fn rb_b4() -> Outcome<ResolvedTree> { ers_assemble(body: "type Row {\n  f: Int?\n}\n\ntype Cell {\n  c: Int?\n}\n\nfn t(r: Row, e: Cell) -> Row {\n  let x = if true { r } else { e }\n  r\n}\n") }
test fn rb_b4_has_arms_declare_conflicting_types() -> Bool { ers_fatal_is(o: rb_b4(), reason: ^infer_arms_declare_conflicting_types) }

fn rb_planted() -> Outcome<ResolvedTree> { ers_assemble(body: "fn bad() -> Bool { 1 }\n") }
test fn rb_planted_count_is_1() -> Bool { ers_error_count(o: rb_planted()) == 1 }

fn rb_resolved(o: Outcome<ResolvedTree>) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

fn rb_b5() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  let x = if true { Absent } else { Absent }\n  x\n}\n") }
test fn rb_b5_refuses_no_arm_declares() -> Bool { ers_fatal_is(o: rb_b5(), reason: ^infer_no_arm_declares_a_type) }

// Mixed-state arms with NO expected type (an unannotated let): an Int arm beside an Absent arm. Absent is underived, so the join
// elaborates it at the declaring sibling's type (Int) and the arms conflict. The Optional control beside it accepts through the same join.
// With a declared expected type each arm is judged against it (Rule A part 2, child-frame hops), so that case is covered there.
fn rb_g1() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  let x = if true { 1 } else { Absent }\n  x\n}\n") }
test fn rb_g1_int_beside_absent_refuses() -> Bool { ers_fatal_is(o: rb_g1(), reason: ^infer_arms_declare_conflicting_types) }
test fn rb_g1_the_optional_sibling_control_accepts() -> Bool { ers_infer_accepted(o: rb_b1()) }

// Cost bound: arm nesting depth 1/2/4/8. The instrument is claim_batch's per-claim eval_steps receipt; the four claims differ only in depth.
fn rb_d1() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  if true { Absent } else { Present { value: 1 } }\n}\n") }
test fn rb_d1_depth_1_accepts() -> Bool { ers_infer_accepted(o: rb_d1()) }
fn rb_d2() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  if true { Absent } else { if true { Absent } else { Present { value: 1 } } }\n}\n") }
test fn rb_d2_depth_2_accepts() -> Bool { ers_infer_accepted(o: rb_d2()) }
fn rb_d4() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  if true { Absent } else { if true { Absent } else { if true { Absent } else { if true { Absent } else { Present { value: 1 } } } } }\n}\n") }
test fn rb_d4_depth_4_accepts() -> Bool { ers_infer_accepted(o: rb_d4()) }
fn rb_d8() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  if true { Absent } else { if true { Absent } else { if true { Absent } else { if true { Absent } else { if true { Absent } else { if true { Absent } else { if true { Absent } else { if true { Absent } else { Present { value: 1 } } } } } } } } }\n}\n") }
test fn rb_d8_depth_8_accepts() -> Bool { ers_infer_accepted(o: rb_d8()) }

// WITH a declared expected type, Int beside Absent must refuse at this head (no silent accept), with its accepting positive beside it.
// The REASON is the join's (infer_arms_declare_conflicting_types) because the expected type does not yet reach the branch arms;
// PR B (session/gentle-newt-78-b, stacked on this PR) is the trigger that delivers the expected type to the arms and removes
// the infer_arm_join_deferred_to_declared_type refusal below.
fn rb_x1() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool) -> Int? { if b { 1 } else { Absent } }\n") }
test fn rb_x1_int_beside_absent_at_declared_return_refuses() -> Bool { ers_fatal_is(o: rb_x1(), reason: ^infer_arm_join_deferred_to_declared_type) }
fn rb_x2() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool) -> Int? { if b { Present { value: 1 } } else { Absent } }\n") }
test fn rb_x2_present_beside_absent_at_declared_return_accepts() -> Bool { ers_infer_accepted(o: rb_x2()) }

// B1: WITH A DECLARED EXPECTED TYPE THE JOIN MUST NOT CHOOSE A LAYER. `if b { Absent } else { x }` with x: Int? at Optional<Int?> would
// join at Int? and then elaborate to Present at Optional<Int?>, so Absent would mean Present{Absent}, not the outer Absent. The sibling must not win:
// the join refuses with the typed deferral until the expected type reaches the arms. The positive beside it declares the layer the join chose.
fn rb_n1() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool, x: Int?) -> Optional<Int?> { if b { Absent } else { x } }\n") }
test fn rb_n1_nested_optional_sibling_must_not_win() -> Bool { ers_fatal_is(o: rb_n1(), reason: ^infer_arm_join_deferred_to_declared_type) }
fn rb_n2() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool, x: Int?) -> Int? { if b { Absent } else { x } }\n") }
test fn rb_n2_same_shape_at_the_joined_layer_accepts() -> Bool { ers_infer_accepted(o: rb_n2()) }
fn rb_n3() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(o: Int?, x: Int?) -> Optional<Int?> {\n  match o {\n    Absent => Absent\n    Present { value: _ } => x\n  }\n}\n") }
test fn rb_n3_match_sibling_must_not_win() -> Bool { ers_fatal_is(o: rb_n3(), reason: ^infer_arm_join_deferred_to_declared_type) }
fn rb_n4() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(o: Int?, x: Int?) -> Int? {\n  match o {\n    Absent => Absent\n    Present { value: _ } => x\n  }\n}\n") }
test fn rb_n4_match_at_the_joined_layer_accepts() -> Bool { ers_infer_accepted(o: rb_n4()) }

// B3: ARM ORDER IS NOT A MEANING. Open (Absent) and derived (Present{x}) arms in every placement settle the same way.
// MEASURED: with a `[]` arm the verdict still depends on order in THIS PR -- native `[]` fails infer_grounding_not_derived before any join can hold it
// (Absent,[],Present gives grounding_not_derived; Present,[],Absent gives no_arm_declares) -- so the three-kind permutation control
// is PR B's, where `[]` mints a held open type.
fn rb_o_code(o: Outcome<ResolvedTree>) -> Int {
  if ers_infer_accepted(o: o) { 0 } else if ers_fatal_is(o: o, reason: ^infer_arms_declare_conflicting_types) { 1 } else if ers_fatal_is(o: o, reason: ^infer_no_arm_declares_a_type) { 2 } else { 3 }
}
fn rb_o_APA() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  let x = if true { Absent } else { if true { Present { value: 1 } } else { Absent } }\n  x\n}\n") }
fn rb_o_AAP() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  let x = if true { Absent } else { if true { Absent } else { Present { value: 1 } } }\n  x\n}\n") }
fn rb_o_PAA() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  let x = if true { Present { value: 1 } } else { if true { Absent } else { Absent } }\n  x\n}\n") }
// An inner join with no declaring arm hands its held arms to the enclosing join (infer_gather_branch_hand_up), so Present placed first
// settles exactly as Present placed last: one verdict under every placement (this was the pinned PAA gap).
test fn rb_o_every_order_gives_one_verdict() -> Bool {
  let v = rb_o_code(o: rb_o_APA())
  rb_o_code(o: rb_o_AAP()) == v && rb_o_code(o: rb_o_PAA()) == v
}
test fn rb_o_the_verdict_is_acceptance() -> Bool { rb_o_code(o: rb_o_PAA()) == 0 }
// The hand-up refuses where no enclosing declaring arm exists, in either nesting position.
fn rb_o_none() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t() -> Int? {\n  let x = if true { Absent } else { if true { Absent } else { Absent } }\n  x\n}\n") }
test fn rb_o_no_declaring_arm_anywhere_refuses() -> Bool { rb_o_code(o: rb_o_none()) == 2 }

// B1 THROUGH THE HAND-UP: arms handed up from an inner branch are closed by the enclosing join, so the deferral covers them too.
fn rb_n5() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool, c: Bool, x: Int?) -> Optional<Int?> { if b { if c { Absent } else { Absent } } else { x } }\n") }
test fn rb_n5_handed_up_arms_do_not_close_at_the_sibling() -> Bool { ers_fatal_is(o: rb_n5(), reason: ^infer_arm_join_deferred_to_declared_type) }
fn rb_n6() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool, c: Bool, x: Int?) -> Int? { if b { if c { Absent } else { Absent } } else { x } }\n") }
test fn rb_n6_handed_up_arms_at_the_joined_layer_accept() -> Bool { ers_infer_accepted(o: rb_n6()) }

// ONE ARM JOIN FOR if AND Bool match (infer_join_arm_types): an unannotated let over a Bool match settles as the if does.
fn rb_m1() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(b: Bool) -> Int? {\n  let x = match b {\n    true => Present { value: 1 }\n    false => Absent\n  }\n  x\n}\n") }
fn rb_m2() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(b: Bool) -> Int? {\n  let x = match b {\n    true => Absent\n    false => Present { value: 1 }\n  }\n  x\n}\n") }
fn rb_m3() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(b: Bool) -> Int? {\n  let x = match b {\n    true => Absent\n    false => Absent\n  }\n  x\n}\n") }
test fn rb_m1_bool_match_present_then_absent_accepts() -> Bool { ers_infer_accepted(o: rb_m1()) }
test fn rb_m2_bool_match_absent_then_present_accepts() -> Bool { ers_infer_accepted(o: rb_m2()) }
test fn rb_m3_all_absent_bool_match_refuses_no_arm_declares() -> Bool { ers_fatal_is(o: rb_m3(), reason: ^infer_no_arm_declares_a_type) }

// B3 THROUGH A NESTED Bool MATCH, both orders (manager 1 condition): order changes only whether a program is accepted, never its type or layer.
fn rb_mn_a() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(c: Bool, b: Bool) -> Int? {\n  let x = if c { Present { value: 1 } } else { match b {\n      true => Absent\n      false => Absent\n    } }\n  x\n}\n") }
fn rb_mn_b() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(c: Bool, b: Bool) -> Int? {\n  let x = if c { match b {\n      true => Absent\n      false => Absent\n    } } else { Present { value: 1 } }\n  x\n}\n") }
fn rb_mn_c() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(c: Bool, b: Bool) -> Int? {\n  let x = if c { Absent } else { match b {\n      true => Present { value: 1 }\n      false => Absent\n    } }\n  x\n}\n") }
fn rb_mn_c2() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(c: Bool, b: Bool) -> Optional<Int?> {\n  let x = if c { Absent } else { match b {\n      true => Present { value: 1 }\n      false => Absent\n    } }\n  x\n}\n") }
fn rb_mn_d() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(c: Bool, b: Bool) -> Int? {\n  let x = if c { match b {\n      true => Present { value: 1 }\n      false => Absent\n    } } else { Absent }\n  x\n}\n") }
fn rb_mn_d2() -> Outcome<ResolvedTree> { ers_assemble(body: "fn t(c: Bool, b: Bool) -> Optional<Int?> {\n  let x = if c { match b {\n      true => Present { value: 1 }\n      false => Absent\n    } } else { Absent }\n  x\n}\n") }
test fn rb_mn_a_all_absent_inner_match_refuses_no_arm_declares() -> Bool { ers_fatal_is(o: rb_mn_a(), reason: ^infer_no_arm_declares_a_type) }
test fn rb_mn_b_all_absent_inner_match_refuses_no_arm_declares() -> Bool { ers_fatal_is(o: rb_mn_b(), reason: ^infer_no_arm_declares_a_type) }
test fn rb_mn_c_declaring_inner_match_accepts_at_the_joined_layer() -> Bool { ers_infer_accepted(o: rb_mn_c()) }
test fn rb_mn_c2_and_does_not_accept_a_deeper_layer() -> Bool { ers_fatal_is(o: rb_mn_c2(), reason: ^inhabitance_optional_layer_depth_mismatch) }
test fn rb_mn_d_declaring_inner_match_accepts_at_the_joined_layer() -> Bool { ers_infer_accepted(o: rb_mn_d()) }
test fn rb_mn_d2_and_does_not_accept_a_deeper_layer() -> Bool { ers_fatal_is(o: rb_mn_d2(), reason: ^inhabitance_optional_layer_depth_mismatch) }

// B1 FOR THE Bool MATCH: the same deferral judgment (infer_join_defers_to_declared) as the if. Absent beside x: Int? at Optional<Int?> refuses.
fn rb_m4() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool, x: Int?) -> Optional<Int?> {\n  match b {\n    true => Absent\n    false => x\n  }\n}\n") }
fn rb_m5() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool, x: Int?) -> Int? {\n  match b {\n    true => Absent\n    false => x\n  }\n}\n") }
test fn rb_m4_bool_match_must_not_choose_a_layer() -> Bool { ers_fatal_is(o: rb_m4(), reason: ^infer_arm_join_deferred_to_declared_type) }
test fn rb_m5_same_bool_match_at_the_joined_layer_accepts() -> Bool { ers_infer_accepted(o: rb_m5()) }

// ADMISSION IS NEVER SKIPPED BY A HAND-UP (Manager 1): an inner branch whose condition is not Bool refuses even when its held arms are closed by an enclosing declaring arm.
fn rb_h1() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(n: Int, b: Bool) -> Int? { if b { Present { value: 1 } } else { if n { Absent } else { Absent } } }\n") }
fn rb_h2() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(n: Bool, b: Bool) -> Int? { if b { Present { value: 1 } } else { if n { Absent } else { Absent } } }\n") }
test fn rb_h1_non_bool_inner_condition_refuses_after_a_hand_up() -> Bool { ers_fatal_is(o: rb_h1(), reason: ^infer_branch_cond_not_bool) && !ers_infer_accepted(o: rb_h1()) }
test fn rb_h2_same_shape_with_a_bool_condition_accepts() -> Bool { ers_infer_accepted(o: rb_h2()) }

// ARM AGREEMENT IS JUDGED AFTER CLOSURE, NOT ONLY AT THE FIRST HELD ARM (Manager 1): a nested arm of another type, whose closure at the declaring type is incompatible, refuses in either inner-arm order; Absent beside Absent still accepts.
fn rb_k1() -> Outcome<ResolvedTree> { ers_assemble(body: "type Other<T> = OtherNone | OtherSome { value: T }\nfn f(b: Bool, c: Bool) -> Int? { if b { Present { value: 1 } } else { if c { Absent } else { OtherNone } } }\n") }
fn rb_k2() -> Outcome<ResolvedTree> { ers_assemble(body: "type Other<T> = OtherNone | OtherSome { value: T }\nfn f(b: Bool, c: Bool) -> Int? { if b { Present { value: 1 } } else { if c { OtherNone } else { Absent } } }\n") }
fn rb_k3() -> Outcome<ResolvedTree> { ers_assemble(body: "fn f(b: Bool, c: Bool) -> Int? { if b { Present { value: 1 } } else { if c { Absent } else { Absent } } }\n") }
test fn rb_k1_nested_arm_of_another_type_refuses_after_closure() -> Bool { ers_fatal_is(o: rb_k1(), reason: ^infer_arms_declare_conflicting_types) && !ers_infer_accepted(o: rb_k1()) }
test fn rb_k2_same_in_the_other_inner_arm_order() -> Bool { ers_fatal_is(o: rb_k2(), reason: ^infer_arms_declare_conflicting_types) && !ers_infer_accepted(o: rb_k2()) }
test fn rb_k3_absent_beside_absent_accepts() -> Bool { ers_infer_accepted(o: rb_k3()) }
