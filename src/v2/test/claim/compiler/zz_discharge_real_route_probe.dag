// 0 found, 1 equals call, 2 has entry, 3 call is a child of the body (or the body's subtree contains the call)
fn zz_body(subject: String, c: Int) -> Bool {
  match zz_resolve(subject: subject) {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      match zz_call(tree: r) {
        Absent => false
        Present { value: call } =>
          match zz_obligated(subject: subject) {
            Absent => false
            Present { value: t } =>
              match zz_deepest(r: r.root, call: call) {
                Absent => false
                Present { value: d } =>
                  match arrow_body_target_lookup(children: d.children) {
                    Found { target: b } =>
                      if c == 0 { true } else if c == 1 { b == call } else if c == 2 { zz_has_entry(t: t, n: b) } else { fold(node_subtree_nodes(root: b), init: false, f: fn(acc, n) { acc || n == call }) }
                    _ => false
                  }
              }
          }
      }
  }
}
test fn zz_body_0() -> Bool { zz_body(subject: "v2.test.zzpd_t", c: 0) }
test fn zz_body_1() -> Bool { zz_body(subject: "v2.test.zzpd_t", c: 1) }
test fn zz_body_2() -> Bool { zz_body(subject: "v2.test.zzpd_t", c: 2) }
test fn zz_body_3() -> Bool { zz_body(subject: "v2.test.zzpd_t", c: 3) }
