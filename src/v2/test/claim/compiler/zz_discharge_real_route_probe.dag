// Entry census over the resolved tree infer was handed: which nodes have ANY facts entry.
fn zz_has_entry(t: ObligatedInferredTree, n: Node) -> Bool {
  match t.facts.lookup(n) { Present { value: _ } => true  Absent => false }
}

fn zz_census(subject: String, only_transform: Bool, want_every: Bool) -> Bool {
  match zz_resolve(subject: subject) {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      match zz_obligated(subject: subject) {
        Absent => false
        Present { value: t } =>
          fold(node_subtree_nodes(root: r.root), init: want_every, f: fn(acc, n) {
            let counted = if only_transform {
              match n.kind { ComputationNode { behavior: Transform } => true  _ => false }
            } else { true }
            if counted {
              if want_every { acc && zz_has_entry(t: t, n: n) } else { acc || zz_has_entry(t: t, n: n) }
            } else { acc }
          })
      }
  }
}

test fn zz_census_any_node_has_entry() -> Bool { zz_census(subject: "v2.test.zzpd_t", only_transform: false, want_every: false) }
test fn zz_census_every_node_has_entry() -> Bool { zz_census(subject: "v2.test.zzpd_t", only_transform: false, want_every: true) }
test fn zz_census_any_transform_has_entry() -> Bool { zz_census(subject: "v2.test.zzpd_t", only_transform: true, want_every: false) }
test fn zz_census_every_transform_has_entry() -> Bool { zz_census(subject: "v2.test.zzpd_t", only_transform: true, want_every: true) }

fn zz_kind_is(n: Node, k: Int) -> Bool {
  match n.kind {
    ComputationNode { behavior: Transform } => k == 0 || k == 1
    ComputationNode { behavior: Value } => k == 0 || k == 2
    ComputationNode { behavior: Branch } => k == 0 || k == 3
    ComputationNode { behavior: Match } => k == 0 || k == 4
    ComputationNode { behavior: _ } => k == 0 || k == 10
    TypeNode { connective: Atom { identity: _ } } => k == 0 || k == 5
    TypeNode { connective: Conj } => k == 0 || k == 6
    TypeNode { connective: Arrow } => k == 0 || k == 7
    TypeNode { connective: Instantiation } => k == 0 || k == 8
    TypeNode { connective: Disj } => k == 0 || k == 9
  }
}

// region: 0 whole tree, 1 ancestors of the call, 2 descendants of the call
fn zz_in_region(r: Node, call: Node, n: Node, region: Int) -> Bool {
  if region == 0 { true }
  else if region == 1 { list_contains_node(xs: node_subtree_nodes(root: n), x: call) && !(n == call) }
  else { list_contains_node(xs: node_subtree_nodes(root: call), x: n) && !(n == call) }
}

fn list_contains_node(xs: List<Node>, x: Node) -> Bool {
  fold(xs, init: false, f: fn(acc, y) { acc || y == x })
}

fn zz_exists(subject: String, k: Int, region: Int, entried: Bool) -> Bool {
  match zz_resolve(subject: subject) {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      match zz_call(tree: r) {
        Absent => false
        Present { value: call } =>
          match zz_obligated(subject: subject) {
            Absent => false
            Present { value: t } =>
              fold(node_subtree_nodes(root: r.root), init: false, f: fn(acc, n) {
                acc || (zz_kind_is(n: n, k: k) && zz_in_region(r: r.root, call: call, n: n, region: region) && (zz_has_entry(t: t, n: n) == entried))
              })
          }
      }
  }
}
