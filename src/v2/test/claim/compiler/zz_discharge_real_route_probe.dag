// The deepest ancestor of the call: the ancestor whose subtree is smallest.
fn zz_deepest(r: Node, call: Node) -> Optional<Node> {
  fold(node_subtree_nodes(root: r), init: optional_absent(), f: fn(acc, n) {
    if zz_in_region(r: r, call: call, n: n, region: 1) {
      match acc {
        Absent => optional_present(value: n)
        Present { value: best } =>
          if size_lt(a: node_subtree_nodes(root: n), b: node_subtree_nodes(root: best)) { optional_present(value: n) } else { acc }
      }
    } else { acc }
  })
}

fn size_lt(a: List<Node>, b: List<Node>) -> Bool {
  fold(a, init: 0, f: fn(c, _x) { c + 1 }) < fold(b, init: 0, f: fn(c, _x) { c + 1 })
}

fn zz_deepest_kind(subject: String, k: Int) -> Bool {
  match zz_resolve(subject: subject) {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      match zz_call(tree: r) {
        Absent => false
        Present { value: call } =>
          match zz_deepest(r: r.root, call: call) { Absent => false  Present { value: d } => zz_kind_is(n: d, k: k) }
      }
  }
}

// edge class from the deepest ancestor to the call: 0 positional, 1 authored, 2 structural
fn zz_deepest_edge(subject: String, c: Int) -> Bool {
  match zz_resolve(subject: subject) {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      match zz_call(tree: r) {
        Absent => false
        Present { value: call } =>
          match zz_deepest(r: r.root, call: call) {
            Absent => false
            Present { value: d } =>
              fold(d.children, init: false, f: fn(acc, e) {
                acc || (e.target == call && (match e.label { Positional => c == 0  Authored { name: _ } => c == 1  StructuralLabel { label: _ } => c == 2 }))
              })
          }
      }
  }
}

fn zz_deepest_is_entried(subject: String) -> Bool {
  match zz_resolve(subject: subject) {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      match zz_call(tree: r) {
        Absent => false
        Present { value: call } =>
          match zz_obligated(subject: subject) {
            Absent => false
            Present { value: t } => match zz_deepest(r: r.root, call: call) { Absent => false  Present { value: d } => zz_has_entry(t: t, n: d) }
          }
      }
  }
}

test fn zz_deepest_ancestor_is_entried() -> Bool { zz_deepest_is_entried(subject: "v2.test.zzpd_t") }
