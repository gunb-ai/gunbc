module v2.test.claim.compiler.string_template_unlowered

import v2.test.claim.compiler.infer_fold_member_instance { fmi_assemble, fmi_infer_tree, fmi_reason }
import v2.compiler.infer { infer }
import v2.compiler.inferred_tree { InferredTree }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, node_subtree_nodes }
import v2.std.qualified_name { declaration_reference_path_optional, qualified_name_to_dotted_string }
import std.optional { Absent, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data stu_template_src: String = "module p\n\nfn f(x: String) -> String {\n  \"hello \{x}\"\n}\n"

data stu_literal_src: String = "module p\n\nfn f(x: String) -> String {\n  \"hello\"\n}\n"

data stu_eval_src: String = "module p\n\ndata k: String = \"k\"\n\nfn f() -> String {\n  \"a\{k\}b\"\n}\n"

fn stu_binds_concat_row(root: Node) -> Bool {
  fold(node_subtree_nodes(root: root), init: false, f: fn(acc, n) {
    acc || (match declaration_reference_path_optional(node: n) {
      Present { value: p } => qualified_name_to_dotted_string(qn: p) == "std.algebra.collection_concat_shape"
      Absent => false
    })
  })
}

fn stu_eval_inferred() -> Outcome<InferredTree> {
  match fmi_assemble(src: stu_eval_src) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: tree, diagnostics: _ } => infer(tree: tree)
  }
}

// GREEN: a well-formed template is no longer body_lowering_reason_string_template_unlowered.
test fn a_string_template_assembles_as_a_concat_chain() -> Bool {
  match fmi_assemble(src: stu_template_src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      stu_binds_concat_row(root: tree.root) && (fmi_reason(o: fmi_infer_tree(tree: tree)) == ^accepted)
  }
}

// WHAT THIS ESTABLISHES: the lowered tree of a template whose hole is a data reference binds the
// roster concat row (#13693) and infers. It does NOT evaluate the template.
//
// v2.compiler.eval ON A LOWERED TEMPLATE TODAY: typed, located refusal
// (eval_rejected_runtime_binding_lookup_miss and/or eval_rejected_grounding_not_derived at the
// concat operator, which is a declaration reference to std.algebra.collection_concat_shape — a
// nullary function returning the AlgebraFieldTemplate, not a callable concat body). It does not
// fabricate concatenated bytes. FRONTIER: a template evaluates through v2 eval; trigger is that
// capability (v2.compiler.eval concat arm for the kernel String concat witness the lowered tree
// binds), not an artifact. Until then, bytes of a template are not produced by v2 eval. The
// emitted-target route (translate of the same concat call) is the candidate realization of those
// bytes; no enrolled claim executes an emitted template.
test fn a_lowered_template_binds_concat_and_infers() -> Bool {
  match stu_eval_inferred() {
    Rejected { diagnostics: _ } => false
    Accepted { value: inferred, diagnostics: _ } => stu_binds_concat_row(root: inferred.root)
  }
}

// GREEN: a hole-free string literal still assembles.
test fn a_plain_string_literal_assembles() -> Bool {
  match fmi_assemble(src: stu_literal_src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
