module v2.test.claim.compiler.string_template_unlowered

import v2.test.claim.compiler.infer_fold_member_instance { fmi_assemble, fmi_infer_tree, fmi_reason }
import v2.test.claim.callexec.declaration_reference_eval { cref_the_call_to }
import v2.compiler.infer { infer }
import v2.compiler.inferred_tree { InferredTree }
import v2.compiler.eval { eval, inputs_root_only }
import v2.compiler.translate { translate }
import v2.extdeps.runtimes.v2_evaluator { v2_evaluator_interpretation }
import v2.extdeps.languages.rust { rust_target_model }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, Symbol, node_subtree_nodes }
import v2.std.qualified_name { declaration_reference_path_optional, qualified_name_to_dotted_string }
import std.optional { Absent, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data stu_template_src: String = "module p\n\nfn f(x: String) -> String {\n  \"hello \{x}\"\n}\n"

data stu_literal_src: String = "module p\n\nfn f(x: String) -> String {\n  \"hello\"\n}\n"

data stu_eval_src: String = "module p\n\ndata k: String = \"k\"\n\nfn f() -> String {\n  \"a\{k\}b\"\n}\n\nfn consume_f() -> String {\n  f()\n}\n"

fn stu_binds_concat_row(root: Node) -> Bool {
  fold(node_subtree_nodes(root: root), init: false, f: fn(acc, n) {
    acc || (match declaration_reference_path_optional(node: n) {
      Present { value: p } => qualified_name_to_dotted_string(qn: p) == "std.algebra.collection_concat_shape"
      Absent => false
    })
  })
}

fn stu_eval_inferred() -> Outcome<InferredTree> {
  match fmi_assemble(src: stu_eval_src) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: tree, diagnostics: _ } => infer(tree: tree)
  }
}

fn stu_eval_f_reason() -> Symbol {
  match stu_eval_inferred() {
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
    Accepted { value: inferred, diagnostics: _ } =>
      match cref_the_call_to(root: inferred.root, name: ^f) {
        Absent => ^call_absent
        Present { value: call } =>
          match eval(tree: inferred, interpretation: v2_evaluator_interpretation(), inputs: inputs_root_only(root: call)) {
            Accepted { value: _, diagnostics: _ } => ^accepted
            Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
          }
      }
  }
}

fn stu_translate_reason() -> Symbol {
  match stu_eval_inferred() {
    Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
    Accepted { value: inferred, diagnostics: _ } =>
      match translate(tree: inferred, target: rust_target_model()) {
        Accepted { value: _, diagnostics: _ } => ^accepted
        Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
      }
  }
}

// GREEN: a well-formed template is no longer body_lowering_reason_string_template_unlowered.
test fn a_string_template_assembles_as_a_concat_chain() -> Bool {
  match fmi_assemble(src: stu_template_src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      stu_binds_concat_row(root: tree.root) && (fmi_reason(o: fmi_infer_tree(tree: tree)) == ^accepted)
  }
}

// WHAT THIS ESTABLISHES: the lowered tree of a template whose hole is a data reference binds the
// roster concat row (#13693) and infers. It does NOT evaluate the template.
test fn a_lowered_template_binds_concat_and_infers() -> Bool {
  match stu_eval_inferred() {
    Rejected { diagnostics: _ } => false
    Accepted { value: inferred, diagnostics: _ } => stu_binds_concat_row(root: inferred.root)
  }
}

// FRONTIER, V2 EVAL PATH (DESIGN 4b-1, 4b-4): v2.compiler.eval of a call whose body is a lowered
// template refuses typed and located. The reason is eval_rejected_grounding_not_derived — not a
// silent concat of host bytes. When the eval concat arm lands, this row flips to the positive
// control (the produced bytes).
test fn a_lowered_template_refuses_at_v2_eval() -> Bool {
  stu_eval_f_reason() == ^eval_rejected_grounding_not_derived
}

// FRONTIER, EMITTED PATH: v2.compiler.translate of the same inferred tree to rust_target_model
// refuses typed and located with translate_rejected_grounding_not_derived. It does not emit a host
// concat of the template's parts. No emitted bytes exist for a claim to execute.
test fn a_lowered_template_refuses_at_translate() -> Bool {
  stu_translate_reason() == ^translate_rejected_grounding_not_derived
}

// GREEN: a hole-free string literal still assembles.
test fn a_plain_string_literal_assembles() -> Bool {
  match fmi_assemble(src: stu_literal_src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
