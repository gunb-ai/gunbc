module v2.test.claim.compiler.infer_free_monoid_element_inhabitance_witness

import v2.compiler.resolve { ResolvedTree }
import v2.compiler.name_resolve { Admission, ResolutionSubject, resolution_context, resolve_in_context }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.compiler.normalized_tree { NormalizedTree }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.source_authority { SourceRootIngest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Diagnostics, None, Outcome, Rejected, Some }
import v2.std.node { Symbol }
import std.optional { Absent, Present }
import v2.test.claim.compiler.callback_argument_formal { caf_correction_type }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }
import std.algebra { Empty, FreeMonoid }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.cross_tree.import_model { DagTree }
import v2.test.claim.compiler.infer_record_construct_field_inhabitance_witness {
  RcfInferAccepted,
  RcfInferRefused,
  RcfResolveRefused,
  rcf_refusal,
  rcf_verdict,
  rcf_read_in
}

// AN ELEMENT AT A FreeMonoid<String> FORMAL INHABITS String, OR THE APPLICATION REFUSES.
//
// The specimen is `fn f(xs: List<T>) -> String { string_concat_join(fields: xs, separator: ",") }`
// with `string_concat_join(fields: FreeMonoid<String>, ..)` (std.algebra): the seed admits it for any T
// because v1.compiler.infer direct_call_generic_type_argument_inhabitance_diags judges type arguments
// only when the two applications share an AUTHORED head name, and `List` is not spelled `FreeMonoid`.
// The class and its correction receipt are gunbc.recurring_failure_mode
// list_typed_value_element_mismatch_admitted. v2 does not carry the defect forward (DESIGN section 7):
// v2.compiler.infer infer_declared_type_obligation normalizes BOTH sides through the one alias rule
// (infer_type_alias_normalized_at, which unfolds inside every Instantiation argument), so
// `List<Bool>` reaches v2.std.inhabitance declared_type_inhabitance as `FreeMonoid<Bool>` and the exact
// structural comparison decides it against `FreeMonoid<String>`.
//
// THE TWO REFINEMENT CLAIMS ARE NOT SEED CORRECTIONS; THEY PIN v2's CURRENT FAIL-CLOSED READING. A
// refinement of String does inhabit String, so admitting `List<NonEmptyStr>` at `FreeMonoid<String>`
// could be a sound covariant widening, and the seed's acceptance of it is not shown wrong here (the
// seed reached it without judging anything, which is the defect; the verdict itself is open). v2
// refuses because no declared route admits a refinement under an application: the relation's
// subsumption (declared_type_inhabitance_declared_carrier) widens a produced refinement to its stated
// carrier ONE step at the TOP of the produced type, and `List<NonEmptyStr>` is not itself a refinement.
// THE TWO PINS HAVE DIFFERENT TRIGGERS, because the refinement-carrier chains differ in length and the
// relation widens ONE step. `NonEmptyStr -> String` is one step: its pin retires on a declared covariance
// route for refinements under List/FreeMonoid (a conversion, DESIGN section 4 coercion). `PathSegment ->
// NonEmptyStr -> String` is two: a covariance route that widens one step would admit `List<NonEmptyStr>`
// and still refuse `List<PathSegment>`, so its pin retires only when covariance widens along the FULL
// refinement-carrier chain (transitive refinement widening, which declared_type_inhabitance_declared_carrier
// does not do even at the top level today). Each pin turns red on purpose when its own trigger lands and is
// rewritten as an accepted control then. Bool, Int and the Bool literal are the seed corrections.
//
// THE ROUTE IS REAL: every claim reaches infer from inline source text through the production fold
// (module_roots_from_source_root_ingest, resolve_in_context), and infer is handed resolve's own tree.
// EVERY RED HAS A CONTROL ONE TERM AWAY: the String module differs from each red only in the element
// type, and a transparent alias of String (`Email`) is accepted, so the refinement refusals are about
// refinement, not about aliasing.

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fmj_algebra_source: String = "module std.algebra\n\ntype FreeMonoid<T>\n  = Empty\n  | Cons { head: T, tail: FreeMonoid<T> }\n\nfn string_concat_join(fields: FreeMonoid<String>, separator: String) -> String {\n  separator\n}\n"

data fmj_types_source: String = "module std.types\n\nimport std.algebra { FreeMonoid }\n\ntype Bool = True | False\n\ntype List<element> = FreeMonoid<element>\n\ntype Email = String\n\nfn string_non_empty(s: String) -> Bool {\n  true\n}\n\ntype NonEmptyStr = String where string_non_empty\n\ntype PathSegment = NonEmptyStr where string_non_empty\n"

fn fmj_probe_source(module_name: String, imports: String, element: String) -> String {
  join(["module ", module_name, "\n\nimport std.types { ", imports, " }\nimport std.algebra { string_concat_join }\n\nfn fmj_join(xs: List<", element, ">) -> String {\n  string_concat_join(fields: xs, separator: \",\")\n}\n"], "")
}

data fmj_bool_source: String = fmj_probe_source(module_name: "gunbc.fmj_bool", imports: "Bool, List", element: "Bool")
data fmj_int_source: String = fmj_probe_source(module_name: "gunbc.fmj_int", imports: "List", element: "Int")
data fmj_non_empty_source: String = fmj_probe_source(module_name: "gunbc.fmj_non_empty", imports: "List, NonEmptyStr", element: "NonEmptyStr")
data fmj_segment_source: String = fmj_probe_source(module_name: "gunbc.fmj_segment", imports: "List, PathSegment", element: "PathSegment")
data fmj_string_source: String = fmj_probe_source(module_name: "gunbc.fmj_string", imports: "List", element: "String")
data fmj_email_source: String = fmj_probe_source(module_name: "gunbc.fmj_email", imports: "List, Email", element: "Email")

data fmj_bool_literal_source: String = "module gunbc.fmj_bool_literal\n\nimport std.algebra { string_concat_join }\n\nfn fmj_join() -> String {\n  string_concat_join(fields: [true, false], separator: \",\")\n}\n"
data fmj_string_literal_source: String = "module gunbc.fmj_string_literal\n\nimport std.algebra { string_concat_join }\n\nfn fmj_join() -> String {\n  string_concat_join(fields: [\"a\", \"b\"], separator: \",\")\n}\n"

data fmj_undecided_fold_source: String = "module gunbc.fmj_undecided_fold\n\nfn fmj_f(x: Int) -> Int {\n  fold([x], init: 0, f: fn(a, e) { a })\n}\n"
data fmj_undecided_generic_source: String = "module gunbc.fmj_undecided_generic\n\nfn fmj_f<T>(x: T) -> T {\n  x\n}\n"

data fmj_ingest: SourceRootIngest = [
  rcf_read_in(tree: DagTree, source: fmj_algebra_source, id: ^fmj_algebra_read, unit: ^fmj_algebra_cu, path: "dag/std/algebra.dag"),
  rcf_read_in(tree: DagTree, source: fmj_types_source, id: ^fmj_types_read, unit: ^fmj_types_cu, path: "dag/std/types.dag"),
  rcf_read_in(tree: DagTree, source: fmj_bool_source, id: ^fmj_bool_read, unit: ^fmj_bool_cu, path: "dag/gunbc/fmj_bool.dag"),
  rcf_read_in(tree: DagTree, source: fmj_int_source, id: ^fmj_int_read, unit: ^fmj_int_cu, path: "dag/gunbc/fmj_int.dag"),
  rcf_read_in(tree: DagTree, source: fmj_non_empty_source, id: ^fmj_non_empty_read, unit: ^fmj_non_empty_cu, path: "dag/gunbc/fmj_non_empty.dag"),
  rcf_read_in(tree: DagTree, source: fmj_segment_source, id: ^fmj_segment_read, unit: ^fmj_segment_cu, path: "dag/gunbc/fmj_segment.dag"),
  rcf_read_in(tree: DagTree, source: fmj_string_source, id: ^fmj_string_read, unit: ^fmj_string_cu, path: "dag/gunbc/fmj_string.dag"),
  rcf_read_in(tree: DagTree, source: fmj_email_source, id: ^fmj_email_read, unit: ^fmj_email_cu, path: "dag/gunbc/fmj_email.dag"),
  rcf_read_in(tree: DagTree, source: fmj_bool_literal_source, id: ^fmj_bool_literal_read, unit: ^fmj_bool_literal_cu, path: "dag/gunbc/fmj_bool_literal.dag"),
  rcf_read_in(tree: DagTree, source: fmj_string_literal_source, id: ^fmj_string_literal_read, unit: ^fmj_string_literal_cu, path: "dag/gunbc/fmj_string_literal.dag"),
  rcf_read_in(tree: DagTree, source: fmj_undecided_fold_source, id: ^fmj_undecided_fold_read, unit: ^fmj_undecided_fold_cu, path: "dag/gunbc/fmj_undecided_fold.dag"),
  rcf_read_in(tree: DagTree, source: fmj_undecided_generic_source, id: ^fmj_undecided_generic_read, unit: ^fmj_undecided_generic_cu, path: "dag/gunbc/fmj_undecided_generic.dag")
]

fn fmj_fixture_normalized() -> Outcome<FreeMonoid<NormalizedTree>> {
  module_roots_from_source_root_ingest(ingest: fmj_ingest, lm: dag_language_model())
}

fn fmj_resolve_subject(subject: String) -> Outcome<ResolvedTree> {
  match fmj_fixture_normalized() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_in_context(
        context: resolution_context(lm: dag_language_model(), roots: roots, index: source_root_index_empty(), active_roots: Empty, policy: default_name_resolution_policy()),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject) },
          imports: Empty
        }
      ).resolved
  }
}

// Refused at THIS argument: an application_argument_does_not_inhabit refusal whose correction names the
// `fields` parameter (v2.std.inhabitance application_argument_does_not_inhabit_diagnostic). A refusal at
// `separator`, or any other infer refusal, does not satisfy it.
fn fmj_refused_at_the_argument(subject: String) -> Bool {
  match rcf_refusal(resolved: fmj_resolve_subject(subject: subject), reason: ^application_argument_does_not_inhabit) {
    Absent => false
    Present { value: d } =>
      match caf_correction_type(d: d, name: ^fields) {
        Absent => false
        Present { value: _ } => true
      }
  }
}

// "DECIDED" IS ESTABLISHED BY WHAT AN ACCEPTED RUN MAY CARRY, NOT BY A LIST OF WHAT IT MAY NOT
// (the same predicate as v2.test.claim.compiler.infer_declared_return_source_witness
// drs_only_admitted_advisories). infer admits an InhabitanceUndecidable verdict on the Accepted path
// with one advisory per undecided obligation; searching for the undecidable reasons by name would read
// a reason added to v2.std.inhabitance InhabitanceUndecidableReason later as decided, and the corpus
// cannot enumerate a coproduct's arms to close that. So an Accepted run counts as decided only when
// EVERY diagnostic it carries is admitted below, and any other reason -- each undecidable arm today,
// or one added later -- fails the control. fmj_an_undecided_return_is_not_read_as_decided_holds and
// fmj_a_generic_return_is_not_read_as_decided_holds keep that red authorable.
fn fmj_admitted_advisory_reasons() -> List<Symbol> {
  [^infer_grounding_not_derived]
}

fn fmj_only_admitted_advisories(d: Diagnostics) -> Bool {
  match d {
    None => true
    Some { diagnostics: nd } =>
      fold(concat([nd.head], nd.tail), init: true, f: fn(acc, x) {
        acc && fold(fmj_admitted_advisory_reasons(), init: false, f: fn(found, r) { found || (x.reason == r) })
      })
  }
}

// Accepted AND decided: an accepted module carrying any advisory outside the admitted set is not the control.
fn fmj_accepted_and_decided(subject: String) -> Bool {
  match rcf_verdict(resolved: fmj_resolve_subject(subject: subject)) {
    RcfInferAccepted { diagnostics: ds } => fmj_only_admitted_advisories(d: ds)
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

fn fmj_accepted_but_undecided(subject: String) -> Bool {
  match rcf_verdict(resolved: fmj_resolve_subject(subject: subject)) {
    RcfInferAccepted { diagnostics: ds } => !fmj_only_admitted_advisories(d: ds)
    RcfInferRefused { diagnostics: _ } => false
    RcfResolveRefused => false
  }
}

// THE REDS, one per element type the seed admits.
test fn fmj_a_list_of_bool_at_a_free_monoid_of_string_refuses_holds() -> Bool {
  fmj_refused_at_the_argument(subject: "gunbc.fmj_bool")
}

test fn fmj_a_list_of_int_at_a_free_monoid_of_string_refuses_holds() -> Bool {
  fmj_refused_at_the_argument(subject: "gunbc.fmj_int")
}

test fn fmj_a_list_of_a_string_refinement_at_a_free_monoid_of_string_refuses_holds() -> Bool {
  fmj_refused_at_the_argument(subject: "gunbc.fmj_non_empty")
}

test fn fmj_a_list_of_a_two_step_refinement_at_a_free_monoid_of_string_refuses_holds() -> Bool {
  fmj_refused_at_the_argument(subject: "gunbc.fmj_segment")
}

test fn fmj_a_bool_list_literal_at_a_free_monoid_of_string_refuses_holds() -> Bool {
  fmj_refused_at_the_argument(subject: "gunbc.fmj_bool_literal")
}

// THE CONTROLS, one term away.
test fn fmj_a_list_of_string_at_a_free_monoid_of_string_is_accepted_and_decided_holds() -> Bool {
  fmj_accepted_and_decided(subject: "gunbc.fmj_string")
}

test fn fmj_a_list_of_a_transparent_string_alias_is_accepted_and_decided_holds() -> Bool {
  fmj_accepted_and_decided(subject: "gunbc.fmj_email")
}

test fn fmj_a_string_list_literal_at_a_free_monoid_of_string_is_accepted_and_decided_holds() -> Bool {
  fmj_accepted_and_decided(subject: "gunbc.fmj_string_literal")
}

// THE PREDICATE'S OWN REDS: two modules v2 accepts while counting an obligation undecided must not read
// as decided (the shapes infer_declared_return_source_witness measured).
test fn fmj_an_undecided_return_is_not_read_as_decided_holds() -> Bool {
  fmj_accepted_but_undecided(subject: "gunbc.fmj_undecided_fold")
}

test fn fmj_a_generic_return_is_not_read_as_decided_holds() -> Bool {
  fmj_accepted_but_undecided(subject: "gunbc.fmj_undecided_generic")
}
