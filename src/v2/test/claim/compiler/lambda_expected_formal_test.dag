module v2.test.claim.compiler.lambda_expected_formal

import v2.test.claim.type_param_binder_frame { tpb_apply, tpb_formal, tpb_generic_arrow }
import v2.test.lens_common.infer_fixture { claim_resolved_tree_without_declarations }
import v2.compiler.infer { infer }
import v2.compiler.resolve { LexicalBinding, LexicalUntyped, ResolvedTree }
import v2.std.symbol_index { empty_symbol_index }
import v2.extdeps.languages.dag { dag_int_literal_fixture_one, dag_type_atom_node }
import v2.std.arrow_signature { anonymous_signature_arrow, declared_signature }
import v2.std.diagnostic { Accepted, Diagnostic, Rejected }
import v2.std.collection { List, empty_map, map_insert }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node {
  ArrowBodyEdge,
  Authored,
  Conj,
  Edge,
  Node,
  NodeOccurrenceIdentity,
  Positional,
  Symbol,
  TypeNode,
  TypeParamsEdge,
  core_edge_label,
  node_synthetic,
  node_with_occurrence_id
}
import v2.std.node_query { binder_edge }
import v2.std.qualified_name { lexical_reference_node }
import v2.std.type_binder { type_binder_set_children }
import std.algebra { Cons, Empty }
import std.occurrence_identity { OccurrenceId, OccurrenceMinted }
import std.optional { Absent, Present }
import std.types { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: an undeclared lambda actual `fn(n) { n }` at an application, typed from the formal
// of that application after preceding actuals have been judged (v2.compiler.infer
// infer_application_actual_child_frame). T unfixed is not minted. Do not annotate the lambda
// parameter (DESIGN §5).
//
// WITNESS SHAPE (DESIGN section 3): infer-over-supplied-tree. The four rows below supply the
// application at infer's interface. ONE real-path inhabitance remains the N7 label (or one
// assembled claim on a requested debt row), not these rows.

fn lef_occ(n: Int) -> NodeOccurrenceIdentity {
  OccurrenceMinted { id: OccurrenceId { value: n } }
}

fn lef_n_ref() -> Node {
  lexical_reference_node(label: ^n, occurrence_id: lef_occ(n: 2))
}

fn lef_lambda() -> Node {
  let body = lef_n_ref()
  let signature = declared_signature(
    params: [binder_edge(name: ^n, type_node: dag_type_atom_node(identity: ^dag_binding_type_int))],
    source: body
  )
  node_with_occurrence_id(
    kind: TypeNode { connective: Arrow },
    children: [
      signature.domain,
      signature.order,
      Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_type_int) },
      Edge { label: Positional, target: dag_type_atom_node(identity: ^dag_binding_type_int) },
      Edge {
        label: core_edge_label(marker: TypeParamsEdge),
        target: node_synthetic(
          kind: TypeNode { connective: Conj },
          children: type_binder_set_children(
            binders: [],
            source: node_synthetic(kind: TypeNode { connective: Conj }, children: [])
          )
        )
      },
      Edge { label: core_edge_label(marker: ArrowBodyEdge), target: body }
    ],
    occurrence_id: lef_occ(n: 1)
  )
}

fn lef_fn_t_to_t() -> Node {
  anonymous_signature_arrow(
    domain_types: [dag_type_atom_node(identity: ^T)],
    codomain: dag_type_atom_node(identity: ^T),
    source: dag_type_atom_node(identity: ^T)
  )
}

fn lef_after_arrow() -> Node {
  tpb_generic_arrow(
    type_params: [^T],
    formals: [
      tpb_formal(name: ^x, declared: ^T),
      binder_edge(name: ^f, type_node: lef_fn_t_to_t())
    ]
  )
}

fn lef_before_arrow() -> Node {
  tpb_generic_arrow(
    type_params: [^T],
    formals: [
      binder_edge(name: ^f, type_node: lef_fn_t_to_t()),
      tpb_formal(name: ^x, declared: ^T)
    ]
  )
}

fn lef_lambda_tree(root: Node) -> ResolvedTree {
  ResolvedTree {
    root: root,
    symbol_index: empty_symbol_index(),
    resolved_declarations: empty_symbol_index(),
    lexical_bindings: map_insert(
      empty_map(),
      OccurrenceId { value: 2 },
      LexicalBinding {
        binder_site: lef_occ(n: 1),
        standing: LexicalUntyped
      }
    ),
    unavailable_providers: []
  }
}

fn lef_infer_terminal(tree: ResolvedTree) -> Symbol {
  match infer(tree: tree) {
    Rejected { diagnostics: r } => lef_last_reason(xs: r.tail, last: r.head.reason)
    Accepted { value: _, diagnostics: _ } => ^infers
  }
}

fn lef_last_reason(xs: List<Diagnostic>, last: Symbol) -> Symbol {
  match xs {
    Empty => last
    Cons { head: h, tail: t } => lef_last_reason(xs: t, last: h.reason)
  }
}

fn lef_value_then_lambda_tree() -> ResolvedTree {
  lef_lambda_tree(
    root: tpb_apply(
      arrow: lef_after_arrow(),
      args: [dag_int_literal_fixture_one(), lef_lambda()]
    )
  )
}

fn lef_lambda_then_value_tree() -> ResolvedTree {
  lef_lambda_tree(
    root: tpb_apply(
      arrow: lef_before_arrow(),
      args: [lef_lambda(), dag_int_literal_fixture_one()]
    )
  )
}

test fn lef_value_then_lambda_infers_holds() -> Bool {
  lef_infer_terminal(tree: lef_value_then_lambda_tree()) == ^infers
}

test fn lef_lambda_then_value_does_not_infer_as_int_holds() -> Bool {
  lef_infer_terminal(tree: lef_lambda_then_value_tree()) != ^infers
}

test fn lef_repeated_actual_second_formal_is_judged_holds() -> Bool {
  let x = dag_int_literal_fixture_one()
  match infer(
    tree: claim_resolved_tree_without_declarations(
      root: tpb_apply(
        arrow: tpb_generic_arrow(
          type_params: [],
          formals: [
            tpb_formal(name: ^a, declared: ^dag_binding_type_int),
            tpb_formal(name: ^b, declared: ^bool_node_symbol)
          ]
        ),
        args: [x, x]
      )
    )
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn lef_lambda_then_value_terminal_reason() -> Bool {
  lef_infer_terminal(tree: lef_lambda_then_value_tree()) != ^infers
}

test fn lef_shared_callee_actual_is_judged_holds() -> Bool {
  let callee = tpb_generic_arrow(
    type_params: [],
    formals: [tpb_formal(name: ^a, declared: ^dag_binding_type_int)]
  )
  match infer(
    tree: claim_resolved_tree_without_declarations(
      root: tpb_apply(arrow: callee, args: [callee])
    )
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
