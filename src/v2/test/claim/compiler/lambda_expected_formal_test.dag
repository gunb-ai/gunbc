module v2.test.claim.compiler.lambda_expected_formal

import v2.test.claim.type_param_binder_frame { tpb_assemble }
import v2.compiler.infer { infer }
import v2.compiler.resolve { ResolvedTree }
import v2.std.diagnostic { Accepted, Diagnostic, Outcome, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { ComputationNode, Edge, Node, Symbol, Transform }
import v2.std.algebra { list_map }
import v2.std.collection { List }
import std.algebra { Cons, Empty }
import std.types { Bool, String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: an undeclared lambda actual `fn(n) { n }` at an application, typed from the formal
// of that application after preceding actuals have been judged (v2.compiler.infer
// infer_application_actual_child_frame). T unfixed is not minted. Do not annotate the lambda
// parameter (DESIGN §5).
//
// WITNESS SHAPE (DESIGN section 3): ONE real-path inhabitance — value-then-lambda assembles and
// infers. The left-to-right red is a second assemble of a module whose lambda precedes the
// instantiating actual (n stays underived). If that red later supplies its tree, this inhabitance
// remains the one real path.

data lef_value_then_lambda_src: String = "module p\n\nfn after<T>(x: T, f: fn(T) -> T) -> T {\n  f(x)\n}\n\nfn k() -> Int {\n  after(1, fn(n) { n })\n}"

data lef_lambda_then_value_src: String = "module p\n\nfn before<T>(f: fn(T) -> T, x: T) -> T {\n  f(x)\n}\n\nfn k() -> Int {\n  before(fn(n) { n }, 1)\n}"

data lef_repeated_actual_src: String = "module p\n\nfn takes(a: Int, b: Bool) -> Int {\n  0\n}\n\nfn k() -> Int {\n  let x = 1\n  takes(a: x, b: x)\n}"

data lef_shared_callee_actual_src: String = "module p\n\nfn takes(a: Int) -> Int {\n  a\n}\n\nfn k() -> Int {\n  takes(1)\n}"

fn lef_infer_terminal(src: String) -> Symbol {
  match tpb_assemble(src: src) {
    Rejected { diagnostics: r } => r.head.reason
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: r2 } => lef_last_reason(xs: r2.tail, last: r2.head.reason)
        Accepted { value: _, diagnostics: _ } => ^infers
      }
  }
}

fn lef_last_reason(xs: List<Diagnostic>, last: Symbol) -> Symbol {
  match xs {
    Empty => last
    Cons { head: h, tail: t } => lef_last_reason(xs: t, last: h.reason)
  }
}

test fn lef_value_then_lambda_infers_holds() -> Bool {
  lef_infer_terminal(src: lef_value_then_lambda_src) == ^infers
}

// L-to-R: the lambda is the first actual, so T is unfixed at entry and n stays underived.
test fn lef_lambda_then_value_does_not_infer_as_int_holds() -> Bool {
  lef_infer_terminal(src: lef_lambda_then_value_src) != ^infers
}

// Two actuals of one binding at two formals: both pairs are judged (authored index, not first
// node-equal pair). x inhabits Int and not Bool, so the call must not infer.
test fn lef_repeated_actual_second_formal_is_judged_holds() -> Bool {
  lef_infer_terminal(src: lef_repeated_actual_src) != ^infers
}

// SUPPLIED TREE: the callee edge and the actual edge share one Node. Positional index, not
// target equality, must still judge that actual at Int; a function does not inhabit Int.
fn lef_rewrite_child_edges(xs: List<Edge>) -> List<Edge> {
  list_map(xs: xs, f: fn(e) {
    Edge { label: e.label, target: lef_share_callee_as_actual(n: e.target) }
  })
}

fn lef_share_callee_as_actual(n: Node) -> Node {
  let children = lef_rewrite_child_edges(xs: n.children)
  match n.kind {
    ComputationNode { behavior: Transform } =>
      match children {
        Cons { head: callee, tail: Cons { head: actual, tail: rest } } =>
          Node {
            kind: n.kind,
            occurrence_id: n.occurrence_id,
            children: Cons {
              head: callee,
              tail: Cons {
                head: Edge { label: actual.label, target: callee.target },
                tail: rest
              }
            }
          }
        _ => Node { kind: n.kind, occurrence_id: n.occurrence_id, children: children }
      }
    _ => Node { kind: n.kind, occurrence_id: n.occurrence_id, children: children }
  }
}

test fn lef_shared_callee_actual_is_judged_holds() -> Bool {
  match tpb_assemble(src: lef_shared_callee_actual_src) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      match infer(
        tree: ResolvedTree {
          root: lef_share_callee_as_actual(n: tree.root),
          symbol_index: tree.symbol_index,
          resolved_declarations: tree.resolved_declarations,
          lexical_bindings: tree.lexical_bindings,
          unavailable_providers: tree.unavailable_providers
        }
      ) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
  }
}
