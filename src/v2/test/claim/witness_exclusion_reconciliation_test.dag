data falsifier_self_host_wet_dark_lane_unclassified_rows_note: String = "falsifier_self_host_wet_dark_lane_population (gunbc.ci_layer_roots) derives its count from the real witness_exclusion_frontier rather than a hand-typed ordinal, but a derived count is only as trustworthy as the predicate deriving it: a row could phrase its dissolve_on around the same wet lane in a spelling the positive predicate has not learned, silently deflating the count for a reason no one sees (still-bat-561 review, 2026-08-05). The guard is a wider candidate net (witness_exclusion_row_mentions_wet_lane_dark_state) plus an unclassified-residue list: falsifier_self_host_wet_dark_lane_unclassified_rows_empty_holds asserts the PROPERTY that the residue stays empty, never the population's numeric value -- a count copied from the current tree is not an independent oracle (DESIGN.md §5)."

test fn falsifier_self_host_wet_dark_lane_unclassified_rows_empty_holds() -> Bool {
  gunbc.ci_layer_roots.falsifier_self_host_wet_dark_lane_unclassified_rows().length() == 0
}

data falsifier_self_host_wet_dark_lane_population_matches_waiting_rows_note: String = "review 48422 (cursor/composer-2.5, 2026-08-05): falsifier_self_host_wet_dark_lane_population(), falsifier_self_host_wet_dark_lane_waiting_patterns(), and dispatch_bijection_real_roster_red_falsifier_self_host_wet_dark_note() had no call sites anywhere in the tree -- the derivation looked finished but nothing on the floor executed it (DESIGN §5 specification-without-execution). These tests are the executing consumers: population_matches_waiting_rows asserts the population is exactly the count of the same waiting-rows list by construction; dispatch_bijection_real_roster_red_enrolled_on_falsifier_self_host_wet_holds asserts R1 bijection is on the falsifier template roster when the cadence is active (Lane D enrollment, separate from per-PR bin-witness execution receipts)."

test fn falsifier_self_host_wet_dark_lane_population_matches_waiting_rows_holds() -> Bool {
  gunbc.ci_layer_roots.falsifier_self_host_wet_dark_lane_population() == gunbc.ci_layer_roots.falsifier_self_host_wet_dark_lane_waiting_rows().length()
}

test fn dispatch_bijection_real_roster_red_enrolled_on_falsifier_self_host_wet_holds() -> Bool {
  dispatch_bijection_real_roster_red_enrolled_on_falsifier_self_host_wet()
}

// Re-homed here from gunbc.ci_layer_roots (this file is its only consumer, and it already
// reaches both authorities the note joins). Keeping it in ci_layer_roots forced that module
// to import v2.compiler.self_host.wet_receipt_enrollment, and since gunbc.ci_spec imports
// ci_layer_roots, that edge widened ~63 witness entries' import closures into the self_host
// subtree and its two live-read carrier homes — which permanently disabled affected-set
// skipping for them. A status projection must not decide selection for the corpus.
fn dispatch_bijection_real_roster_red_falsifier_self_host_wet_dark_note() -> String {
  concat(
    "R1 real-crate bijection enrollment (Lane D, gunbc#7825): falsifier_self_host_wet_cadence_active=",
    concat(
      falsifier_self_host_wet_cadence_is_active() as String,
      concat(
        " template_enrolled=",
        concat(
          dispatch_bijection_real_roster_red_enrolled_on_falsifier_self_host_wet() as String,
          concat(
            " witness_identity=dag/test/claim/interpreter_dispatch_bijection_real_roster_witness_test.dag::interpreter_dispatch_bijection_real_roster_red_holds dark_lane_waiting_patterns=",
            join(gunbc.ci_layer_roots.falsifier_self_host_wet_dark_lane_waiting_patterns(), ", ")
          )
        )
      )
    )
  )
}

test fn dispatch_bijection_real_roster_red_falsifier_self_host_wet_note_names_witness_identity_holds() -> Bool {
  string_contains(
    s: dispatch_bijection_real_roster_red_falsifier_self_host_wet_dark_note(),
    pattern: "interpreter_dispatch_bijection_real_roster_red_holds"
  )
}

fn synthetic_wet_lane_row(dissolution: std.dissolution.DissolutionCondition) -> gunbc.ci_layer_roots.WitnessExclusionRow {
  gunbc.ci_layer_roots.WitnessExclusionRow {
    pattern: "synthetic_wet_lane_third_spelling_test.dag",
    classification: std.witness_admission.OfflineLocalRecipe,
    reason: "synthetic",
    dissolution: dissolution
  }
}

data witness_exclusion_red_control_third_spelling_row_is_unclassified_note: String = "The discriminating RED control: a synthetic row phrasing its trigger around the wet lane in a THIRD spelling -- naming the lane without the cadence-flag identifier, without referential equality to excl_wet_integration_dissolve, and without un-darken(s) -- must be caught by the broad candidate net yet missed by the precise positive predicate, proving the unclassified-residue mechanism can actually distinguish (not merely always return true/empty by construction)."

test fn witness_exclusion_red_control_third_spelling_row_is_unclassified() -> Bool {
  let row = synthetic_wet_lane_row(dissolution: std.dissolution.unbound_dissolution(description: "falsifier_self_host_wet lane activates for this trigger"))
  gunbc.ci_layer_roots.witness_exclusion_row_mentions_wet_lane_dark_state(row: row)
    && !gunbc.ci_layer_roots.witness_exclusion_row_waits_on_wet_lane_undarken(row: row)
}

// Positive control on the same synthetic-row path: a row that DOES match one of the positive arms must not be reported as unclassified by the net/positive-predicate pairing.
test fn witness_exclusion_control_matched_row_is_not_flagged_unclassified() -> Bool {
  let row = synthetic_wet_lane_row(dissolution: std.dissolution.unbound_dissolution(description: "falsifier_self_host_wet_cadence_active flips true"))
  gunbc.ci_layer_roots.witness_exclusion_row_mentions_wet_lane_dark_state(row: row)
    && gunbc.ci_layer_roots.witness_exclusion_row_waits_on_wet_lane_undarken(row: row)
}
