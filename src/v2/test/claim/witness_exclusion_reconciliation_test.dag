module v2.test.claim.witness_exclusion_reconciliation_test



data witness_exclusion_reconciliation_note: String = "Executable reconciliation for gunbc.ci_layer_roots.witness_exclusion_frontier, which is a PATH POLICY carrier as of 2026-08-03: every row is well-formed (never DiscoverySelection, never QuarantineProbeExpectRed, NoConsumer only for the synthetic admission RED-control path, nonempty reason and dissolve_on), the remaining explicit-roster classifications name files those rosters actually run, and the whole-tree probe policy is exactly concat(discovery, strict-resolve). The known-red arm is GONE from this reconciliation rather than strengthened: exact admission moved to gunbc.explicit_witness_admission, so there is no pattern row left to reconcile against a probe roster and the containment check that stood in for identity has nothing to check. What replaces it is a refusal — witness_exclusion_frontier_carries_no_admission_holds, with a synthetic QuarantineProbeExpectRed row as its RED control. RED controls: a DiscoverySelection row, a bare-nickname row, an unbacked BinWitnessWet row, an unbacked rehomed row, an unbacked substrate-long-lane row, and a quarantine row in the path carrier."

test fn witness_exclusion_frontier_reconciliation_holds() -> Bool {
  v2.workflow.witness_admission.witness_exclusion_rows_well_formed_holds()
    && v2.workflow.witness_admission.witness_exclusion_explicit_roster_rows_consistent_holds()
    && v2.workflow.witness_admission.witness_exclusion_falsifier_rows_consistent_holds()
    && v2.workflow.witness_admission.witness_whole_tree_resolve_exclusion_concat_authority_holds()
}


// Constructs the empty condition through the NON-LITERAL path deliberately.
// The literal form `unbound_dissolution(description: "")` is refused at compile
// now that the parameter is NonEmptyStr -- that is the wall. Refinement at
// non-literal positions is still deferred, and that gap is exactly what the
// downstream well-formedness guard defends, so this control has to reach it
// through the gap to keep proving the guard works (DESIGN 4b(4): production
// machinery dissolves on a climb, the evidence stays enrolled).
fn synthetic_nonliteral_text(text: String) -> std.types.NonEmptyStr {
  concat(text, "")
}

fn synthetic_empty_condition(text: String) -> std.dissolution.DissolutionCondition {
  std.dissolution.unbound_dissolution(description: synthetic_nonliteral_text(text: text))
}

fn synthetic_row(pattern: String) -> gunbc.ci_layer_roots.WitnessExclusionRow {
  gunbc.ci_layer_roots.WitnessExclusionRow {
    pattern: pattern,
    classification: DiscoverySelection,
    reason: "synthetic",
    dissolution: std.dissolution.unbound_dissolution(description: "synthetic")
  }
}

test fn witness_exclusion_red_control_discovery_selection_row_reds() -> Bool {
  let verdict = v2.workflow.witness_admission.witness_exclusion_rows_well_formed(
    rows: [synthetic_row(pattern: "synthetic_row.dag")]
  )
  verdict == false
}

test fn witness_exclusion_red_control_bare_nickname_row_reds() -> Bool {
  v2.workflow.witness_admission.witness_exclusion_rows_well_formed(
    rows: [
      gunbc.ci_layer_roots.WitnessExclusionRow {
        pattern: "synthetic_nickname.dag",
        classification: std.witness_admission.OfflineLocalRecipe,
        reason: "",
        dissolution: synthetic_empty_condition(text: "")
      }
    ]
  ) == false
}

