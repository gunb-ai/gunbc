module v2.test.claim.witness_exclusion_reconciliation_test

import std.witness_admission { DiscoverySelection }
import gunbc.ci_layer_roots {
  WitnessExclusionRow,
  BinWitnessWet,
  QuarantineProbeExpectRed,
  FalsifierRehomedBinWet,
  FalsifierSubstrateLongLane,
  NoConsumer,
  OfflineLocalRecipe
}
import v2.workflow.witness_admission {
  witness_exclusion_rows_well_formed,
  witness_exclusion_rows_well_formed_holds,
  witness_exclusion_explicit_roster_rows_consistent,
  witness_exclusion_explicit_roster_rows_consistent_holds,
  witness_exclusion_falsifier_rows_consistent_holds,
  witness_whole_tree_resolve_exclusion_concat_authority_holds,
  witness_exclusion_frontier_carries_no_admission_holds
}
import std.realization_schedule { ScheduleWitnessEntry, CorpusWitnessKind }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data witness_exclusion_reconciliation_note: String = "Executable reconciliation for gunbc.ci_layer_roots.witness_exclusion_frontier, which is a PATH POLICY carrier as of 2026-08-03: every row is well-formed (never DiscoverySelection, never QuarantineProbeExpectRed, NoConsumer only for the synthetic admission RED-control path, nonempty reason and dissolve_on), the remaining explicit-roster classifications name files those rosters actually run, and the whole-tree probe policy is exactly concat(discovery, strict-resolve). The known-red arm is GONE from this reconciliation rather than strengthened: exact admission moved to gunbc.explicit_witness_admission, so there is no pattern row left to reconcile against a probe roster and the containment check that stood in for identity has nothing to check. What replaces it is a refusal — witness_exclusion_frontier_carries_no_admission_holds, with a synthetic QuarantineProbeExpectRed row as its RED control. RED controls: a DiscoverySelection row, a bare-nickname row, an unbacked BinWitnessWet row, an unbacked rehomed row, an unbacked substrate-long-lane row, and a quarantine row in the path carrier."

test fn witness_exclusion_frontier_reconciliation_holds() -> Bool {
  witness_exclusion_rows_well_formed_holds()
    && witness_exclusion_explicit_roster_rows_consistent_holds()
    && witness_exclusion_falsifier_rows_consistent_holds()
    && witness_whole_tree_resolve_exclusion_concat_authority_holds()
}

fn synthetic_row(pattern: String) -> WitnessExclusionRow {
  WitnessExclusionRow {
    pattern: pattern,
    classification: DiscoverySelection,
    reason: "synthetic",
    dissolve_on: "synthetic"
  }
}

test fn witness_exclusion_red_control_discovery_selection_row_reds() -> Bool {
  let verdict = witness_exclusion_rows_well_formed(
    rows: [synthetic_row(pattern: "synthetic_row.dag")]
  )
  verdict == false
}

test fn witness_exclusion_red_control_bare_nickname_row_reds() -> Bool {
  witness_exclusion_rows_well_formed(
    rows: [
      WitnessExclusionRow {
        pattern: "synthetic_nickname.dag",
        classification: OfflineLocalRecipe,
        reason: "",
        dissolve_on: ""
      }
    ]
  ) == false
}

test fn witness_exclusion_red_control_unbacked_bin_wet_row_reds() -> Bool {
  witness_exclusion_explicit_roster_rows_consistent(
    rows: [
      WitnessExclusionRow {
        pattern: "no_such_entry_anywhere.dag",
        classification: BinWitnessWet,
        reason: "synthetic",
        dissolve_on: "synthetic"
      }
    ],
    bin_entries: [],
    rehomed_entries: [],
    substrate_long_entries: []
  ) == false
}

test fn witness_exclusion_red_control_unbacked_rehomed_row_reds() -> Bool {
  witness_exclusion_explicit_roster_rows_consistent(
    rows: [
      WitnessExclusionRow {
        pattern: "no_such_rehomed_entry.dag",
        classification: FalsifierRehomedBinWet,
        reason: "synthetic",
        dissolve_on: "synthetic"
      }
    ],
    bin_entries: [],
    rehomed_entries: [],
    substrate_long_entries: []
  ) == false
}

test fn witness_exclusion_red_control_unbacked_substrate_long_lane_row_reds() -> Bool {
  witness_exclusion_explicit_roster_rows_consistent(
    rows: [
      WitnessExclusionRow {
        pattern: "no_such_substrate_long_entry.dag",
        classification: FalsifierSubstrateLongLane,
        reason: "synthetic",
        dissolve_on: "synthetic"
      }
    ],
    bin_entries: [],
    rehomed_entries: [],
    substrate_long_entries: []
  ) == false
}

test fn witness_exclusion_frontier_carries_no_quarantine_row_holds() -> Bool {
  witness_exclusion_frontier_carries_no_admission_holds()
}

test fn witness_exclusion_red_control_quarantine_row_in_path_carrier_reds() -> Bool {
  witness_exclusion_rows_well_formed(
    rows: [
      WitnessExclusionRow {
        pattern: "synthetic_quarantined_file_test.dag",
        classification: QuarantineProbeExpectRed,
        reason: "synthetic",
        dissolve_on: "synthetic"
      }
    ]
  ) == false
}
