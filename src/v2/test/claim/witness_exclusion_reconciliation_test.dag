  v2.workflow.witness_admission.witness_exclusion_explicit_roster_rows_consistent(
    rows: [
      gunbc.ci_layer_roots.WitnessExclusionRow {
        pattern: "no_such_entry_anywhere.dag",
        classification: BinWitnessWet,
        reason: "synthetic",
        dissolution: std.dissolution.unbound_dissolution(description: "synthetic")
      }
    ],
    bin_entries: [],
    rehomed_entries: [],
    substrate_long_entries: []
  ) == false
}

