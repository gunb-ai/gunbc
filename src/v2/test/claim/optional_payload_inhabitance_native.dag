module v2.test.claim.optional_payload_inhabitance_native

import v2.compiler.infer { infer }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model }
import extdeps.communication.medium { Lossless, Medium }
import std.algebra { Cons, Empty, fold_list }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, None, Outcome, Rejected, Some }
import v2.std.node { Symbol, symbol_lexeme }
import v2.std.text { String }
import std.types { List }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import std.process { ExitSuccess }

data opi_std_artifact: Artifact = Artifact { kind: SourceFile, id: ^opi_std_artifact_id, file_path: "src/v2/pilot/opi_std_pilot.dag" }
data opi_artifact: Artifact = Artifact { kind: SourceFile, id: ^opi_artifact_id, file_path: "src/v2/pilot/opi_pilot.dag" }

fn opi_witness(src: String, artifact: Artifact) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: src, fidelity: Lossless },
    artifact: artifact,
    compilation_unit: ^opi_cu,
    source_root: V2Tree
  }
}

fn opi_reasons(r: NonEmptyDiagnostics) -> String {
  fold(r.tail, init: symbol_lexeme(sym: r.head.reason), f: fn(acc, d) { acc + "/" + symbol_lexeme(sym: d.reason) })
}

fn opi_probe(body: String) -> String {
  match assemble_program_from_ingest(
    ingest: [
      opi_witness(src: "module std.optional\n\ntype Optional<T>\n  = Absent\n  | Present { value: T }\n", artifact: opi_std_artifact),
      opi_witness(src: "module p\n\nimport std.optional { Optional, Absent, Present }\n\n" + body, artifact: opi_artifact)
    ],
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^p, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  ) {
    Rejected { diagnostics: r } => "RESOLVE_REFUSED:" + opi_reasons(r: r)
    Accepted { value: tree, diagnostics: _ } =>
      match infer(tree: tree) {
        Rejected { diagnostics: r } => "INFER_REJECTED:" + opi_reasons(r: r)
        Accepted { value: _, diagnostics: d } =>
          match d {
            None => "INFER_ACCEPTED:clean"
            Some { diagnostics: r } => "INFER_ACCEPTED:diag:" + opi_reasons(r: r)
          }
      }
  }
}

fn opi_report() -> CliWireResponse {
  CliWirePrintable {
    bytes: "control_int=" + opi_probe(body: "fn f() -> Int? {\n  Present { value: 1 }\n}\n")
      + " | hole_string=" + opi_probe(body: "fn f() -> Int? {\n  Present { value: \"s\" }\n}\n")
      + " | absent=" + opi_probe(body: "fn f() -> Int? {\n  Absent\n}\n")
      + " | bare_lift=" + opi_probe(body: "fn f(x: Int) -> Int? {\n  x\n}\n")
      + " | rigid_t=" + opi_probe(body: "fn f<T>(x: T) -> Int? {\n  Present { value: x }\n}\n")
      + " | planted=" + opi_probe(body: "fn f() -> Int {\n  true\n}\n")
      + " | END",
    exit: ExitSuccess
  }
}
