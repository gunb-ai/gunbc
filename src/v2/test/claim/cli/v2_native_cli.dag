module v2.test.claim.cli.v2_native_cli
import std.optional { Absent, Optional, Present }


import std.algebra { Cons, Empty, FreeMonoid, length, list_head }
import std.process { ExitFailure, ExitSuccess }
import extdeps.process.gnu_bash_exit { exit_code_misuse }
import extdeps.process.posix_exit { exit_code_general_error }
import v2.cli.compile_cli {
  CliEmitClosure,
  CliEmitted,
  CliPlan,
  CliPlanParsed,
  CliPlanRefused,
  CliRunOutcome,
  CliRunRefused,
  CliEmitTarget,
  CliTargetC,
  CliTargetRust,
  CliTargetSwift,
  CliUsageRefused,
  CliPopulationReported,
  CliIfArmReaderDifferential,
  CliCheckLayout,
  CliSelectSpelledModules,
  CliParsePopulation,
  cli_emit_target_spelling,
  cli_verb_if_arm_reader_differential,
  v2_cli_exit,
  v2_cli_parse,
  v2_cli_plan_source_roots,
  v2_cli_run
}
import v2.cli.population_verb_names { cli_verb_check_layout, cli_verb_parse_population, cli_verb_select_spelled_modules }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.std.artifact { Artifact, SourceFile }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.node { Symbol }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.text { String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT IS THE V2-NATIVE CLI'S OWN DECISIONS, SUPPLIED AT ITS OWN BOUNDARY. Every argv below
// is constructed here rather than derived by running a process, because the interface under test is
// `argv -> plan` and `plan x ingest -> outcome`: deriving the inputs would re-execute a walk, a
// spawn and a filesystem this claim is not about, once per claim (DESIGN section 3, a witness
// discriminates at ONE interface).
//
// AND THE PAIRING OBLIGATION IS DISCHARGED BY THE LAST ROW, which is the reason the supplied inputs
// above are readings rather than a fast green set. `the_emit_verb_reaches_the_real_closure_emitter`
// hands a real one-module ingest through the real fold and asserts it reaches `CliEmitted` -- so
// deleting the emitter call from `v2_cli_run` turns that row red while every parse row stays green,
// which is exactly the discrimination a shape-only inhabitance claim would not have.

fn argv_of(items: FreeMonoid<String>) -> FreeMonoid<String> { items }

fn plan_refusal_reason(plan: CliPlan) -> Symbol {
  match plan {
    CliPlanRefused { reason: reason, detail: _ } => reason
    CliPlanParsed { verb: _ } => ^cli_plan_was_not_refused
  }
}

fn plan_first_root(plan: CliPlan) -> String {
  match plan {
    CliPlanRefused { reason: _, detail: _ } => ""
    CliPlanParsed { verb: verb } =>
      match verb {
        CliEmitClosure { entry: _, source_roots: roots, target: _ } =>
          match list_head(xs: roots) {
            Absent => ""
            Present { value: first } => first
          }
        CliIfArmReaderDifferential { source_roots: _ } => ""
        CliCheckLayout { source_roots: _ } => ""
        CliSelectSpelledModules { source_roots: _ } => ""
        CliParsePopulation { source_roots: _, compiler: _, write_identity: _, receipts: _, reuse_from: _ } => ""
      }
  }
}

fn outcome_refusal_reason(outcome: CliRunOutcome) -> Symbol {
  match outcome {
    CliRunRefused { reason: reason, detail: _ } => reason
    CliUsageRefused { reason: reason, detail: _ } => reason
    CliEmitted { text: _, closure_size: _, refused_count: _, refusal_detail: _ } =>
      ^cli_outcome_was_not_refused
    CliPopulationReported { text: _, held: _, detail: _ } =>
      ^cli_outcome_was_not_refused
  }
}

fn outcome_emitted(outcome: CliRunOutcome) -> Bool {
  match outcome {
    CliRunRefused { reason: _, detail: _ } => false
    CliUsageRefused { reason: _, detail: _ } => false
    CliEmitted { text: _, closure_size: _, refused_count: _, refusal_detail: _ } => true
    CliPopulationReported { text: _, held: _, detail: _ } => false
  }
}

data argv_emit_one_root: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons {
    head: "--entry",
    tail: Cons {
      head: "cli_probe",
      tail: Cons { head: "--source-root", tail: Cons { head: "dag", tail: Empty } }
    }
  }
}

data argv_emit_two_roots: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons {
    head: "--entry",
    tail: Cons {
      head: "cli_probe",
      tail: Cons {
        head: "--source-root",
        tail: Cons {
          head: "dag",
          tail: Cons {
            head: "--source-root",
            tail: Cons { head: "src/v2", tail: Empty }
          }
        }
      }
    }
  }
}

data argv_empty: FreeMonoid<String> = Empty

data argv_emit_no_root: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons { head: "--entry", tail: Cons { head: "cli_probe", tail: Empty } }
}

data argv_emit_dangling_option: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons { head: "--source-root", tail: Empty }
}

data argv_unknown_verb: FreeMonoid<String> = Cons {
  head: "compile",
  tail: Cons { head: "--source-root", tail: Cons { head: "dag", tail: Empty } }
}

data argv_unknown_option: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons { head: "--output", tail: Cons { head: "out.rs", tail: Empty } }
}

test fn the_emit_verb_with_one_root_parses_holds() -> Bool {
  let plan = v2_cli_parse(argv: argv_of(items: argv_emit_one_root))
  (length(xs: v2_cli_plan_source_roots(plan: plan)) == 1)
    && (plan_first_root(plan: plan) == "dag")
}

// THE ROOTS COME BACK IN THE ORDER THEY WERE GIVEN, which is not free: the parser accumulates onto
// the head of a list and reverses once at the end, so a dropped reverse would still parse, still
// name the right COUNT, and hand the host a walk in the wrong order. Order is observable in the
// emitted closure, so this is a correctness row rather than a cosmetic one.
test fn the_source_roots_keep_their_given_order_holds() -> Bool {
  let plan = v2_cli_parse(argv: argv_of(items: argv_emit_two_roots))
  (length(xs: v2_cli_plan_source_roots(plan: plan)) == 2)
    && (plan_first_root(plan: plan) == "dag")
}

test fn no_verb_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_empty))) == ^cli_no_verb
}

test fn the_emit_verb_without_a_source_root_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_emit_no_root)))
    == ^cli_no_source_root
}

// A TRAILING OPTION IS ITS OWN CAUSE AND NOT "no source root". The two are different defects with
// different fixes -- one forgot the verb's argument, the other forgot the option's -- and
// collapsing them would hand an operator who typed `--source-root` and stopped a message telling
// them to add the option they already typed.
test fn a_dangling_source_root_option_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_emit_dangling_option)))
    == ^cli_source_root_missing_value
}

data argv_emit_no_entry: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons { head: "--source-root", tail: Cons { head: "dag", tail: Empty } }
}

data argv_emit_dangling_entry: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons { head: "--entry", tail: Empty }
}

data argv_emit_entry_eats_an_option: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons {
    head: "--entry",
    tail: Cons { head: "--source-root", tail: Cons { head: "dag", tail: Empty } }
  }
}

// THE ENTRY IS REQUIRED, AND THE REASON IS THE RESOLVER RATHER THAN TASTE. `assemble_program_from_ingest`
// resolves the admission's subject against the roots the ingest produced, so an emit with no named
// subject has nothing to resolve. This row is the reason `v2_cli_closure_admission` cannot go back
// to a constant: a synthetic subject would make this refusal unnecessary and every emit reject.
test fn the_emit_verb_without_an_entry_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_emit_no_entry)))
    == ^cli_no_entry
}

test fn a_dangling_entry_option_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_emit_dangling_entry)))
    == ^cli_entry_missing_value
}

// AN OPTION IN A VALUE POSITION IS REFUSED RATHER THAN SWALLOWED, and this row is the discriminating
// one for that: `--entry --source-root dag` parses cleanly under a parser that takes whatever
// follows, binding the entry to the literal `--source-root` and then refusing much later for a
// module nobody named. Here it refuses at the position where the operator can still see what they
// typed.
test fn an_option_in_the_entry_value_position_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_emit_entry_eats_an_option)))
    == ^cli_entry_missing_value
}

test fn an_unknown_verb_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_unknown_verb)))
    == ^cli_unknown_verb
}

fn argv_emit_with_target(target: String) -> FreeMonoid<String> {
  Cons {
    head: "emit",
    tail: Cons {
      head: "--entry",
      tail: Cons {
        head: "cli_probe",
        tail: Cons {
          head: "--source-root",
          tail: Cons { head: "dag", tail: Cons { head: "--target", tail: Cons { head: target, tail: Empty } } }
        }
      }
    }
  }
}

// `kotlin` is the discriminating unknown: a real target with a model, not rostered in this door.
data argv_emit_unknown_target: FreeMonoid<String> = argv_emit_with_target(target: "kotlin")

data argv_emit_dangling_target: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons {
    head: "--entry",
    tail: Cons { head: "cli_probe", tail: Cons { head: "--source-root", tail: Cons { head: "dag", tail: Cons { head: "--target", tail: Empty } } } }
  }
}

fn plan_is_target(plan: CliPlan, expected: CliEmitTarget) -> Bool {
  match plan {
    CliPlanRefused { reason: _, detail: _ } => false
    CliPlanParsed { verb: verb } =>
      match verb {
        CliEmitClosure { entry: _, source_roots: _, target: target } =>
          cli_emit_target_spelling(t: target) == cli_emit_target_spelling(t: expected)
        CliIfArmReaderDifferential { source_roots: _ } => false
        CliCheckLayout { source_roots: _ } => false
        CliSelectSpelledModules { source_roots: _ } => false
        CliParsePopulation { source_roots: _, compiler: _, write_identity: _, receipts: _, reuse_from: _ } => false
      }
  }
}

// EACH ROSTERED SPELLING SELECTS ITS OWN ARM. Three rows rather than one because a parser that
// mapped every known spelling to the first arm would pass any single one of them.
test fn the_rust_target_spelling_selects_rust_holds() -> Bool {
  plan_is_target(plan: v2_cli_parse(argv: argv_emit_with_target(target: "rust")), expected: CliTargetRust)
}

test fn the_c_target_spelling_selects_c_holds() -> Bool {
  plan_is_target(plan: v2_cli_parse(argv: argv_emit_with_target(target: "c")), expected: CliTargetC)
}

test fn the_swift_target_spelling_selects_swift_holds() -> Bool {
  plan_is_target(plan: v2_cli_parse(argv: argv_emit_with_target(target: "swift")), expected: CliTargetSwift)
}

// NO --target IS THE PLAN'S DECLARED DEFAULT, which is the argv every existing caller spawns.
test fn an_emit_without_a_target_plans_the_declared_default_holds() -> Bool {
  plan_is_target(plan: v2_cli_parse(argv: argv_of(items: argv_emit_one_root)), expected: CliTargetRust)
}

// A TARGET OUTSIDE THE ROSTER REFUSES AT THE PARSE, before any root is walked -- it never reaches
// the emitter as a name the emitter has no model for.
test fn an_unknown_target_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_emit_unknown_target)))
    == ^cli_unknown_target
}

test fn a_dangling_target_option_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_emit_dangling_target)))
    == ^cli_target_missing_value
}

test fn an_unknown_option_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_unknown_option)))
    == ^cli_unknown_option
}

// A REFUSED PLAN NAMES NO ROOTS, so the host walks nothing. This is the row that keeps the shim
// honest: the rendered main asks the PLAN what to walk, and if a refused plan answered with the
// roots it had collected before refusing, a run that the CLI rejected would still pay a full
// filesystem walk -- and, worse, would have read a corpus while reporting a refusal.
test fn a_refused_plan_names_no_source_roots_holds() -> Bool {
  length(xs: v2_cli_plan_source_roots(plan: v2_cli_parse(argv: argv_of(items: argv_unknown_verb)))) == 0
}

// THE ENTRY STRING MUST BECOME THE NAME THE RESOLVER WILL MATCH, and this row is the boundary
// between the two halves of this CLI. Everything above is argv handling, which answers in its own
// vocabulary; everything below hands a QualifiedName to `assemble_program_from_ingest`, which
// resolves it against the modules the ingest produced. The conversion between them is the one step
// neither half owns, so it gets its own claim rather than being inferred from the emit succeeding:
// if this is wrong the emit rejects with a resolution failure that names the subject, and reading
// that backwards to "the string did not convert" is a diagnosis nobody should have to make twice.
test fn a_dotted_entry_converts_to_the_subject_the_resolver_matches_holds() -> Bool {
  qualified_name_from_dotted_string(dotted: "cli_probe") == Cons { head: ^cli_probe, tail: Empty }
}

// A MULTI-SEGMENT ENTRY IS THE REAL SHAPE, so the single-segment row above is not the whole claim:
// every module this CLI will actually be pointed at is dotted, and a converter that happened to
// work only when there was nothing to split would pass that row and fail every real invocation.
test fn a_multi_segment_entry_converts_segment_by_segment_holds() -> Bool {
  qualified_name_from_dotted_string(dotted: "v2.cli.compile_cli")
    == Cons { head: ^v2, tail: Cons { head: ^cli, tail: Cons { head: ^compile_cli, tail: Empty } } }
}

// THE EMPTY INGEST IS THE STANDING RED, AND IT DOES NOT RETIRE. The emitter this CLI calls is TOTAL
// over its ingest -- an empty one emits an empty program and reports Accepted -- so without this
// refusal a source root that walked to zero files would print nothing and exit 0, which is
// bottom-as-ignorance rendered as bottom-as-answer. Deleting the `cli_empty_ingest` arm from
// `v2_cli_run` turns this row red and leaves every other row in this file green.
test fn a_plan_over_an_empty_ingest_refuses_holds() -> Bool {
  outcome_refusal_reason(
    outcome: v2_cli_run(plan: v2_cli_parse(argv: argv_of(items: argv_emit_one_root)), ingest: Empty)
  ) == ^cli_empty_ingest
}

// A REFUSED PLAN CARRIES ITS OWN CAUSE THROUGH THE RUN, rather than being re-diagnosed against the
// ingest it never asked for. The plan below refused for an unknown verb and the ingest is empty, so
// a run that judged the ingest first would report `cli_empty_ingest` and bury the real defect.
test fn a_refused_plan_keeps_its_cause_through_the_run_holds() -> Bool {
  outcome_refusal_reason(
    outcome: v2_cli_run(plan: v2_cli_parse(argv: argv_of(items: argv_unknown_verb)), ingest: Empty)
  ) == ^cli_unknown_verb
}

// THE EMIT ARM HAS NO GREEN INHABITANCE CLAIM TODAY, AND THIS IS A DECLARED FRONTIER RATHER THAN
// AN OMISSION (DESIGN section 3c). The rows above supply argv at this CLI's own boundary, which
// owes one claim that the real producer runs -- and the claim was written, ran, and went RED for a
// reason that is not this CLI's.
//
// WHAT WAS MEASURED, 2026-09-16, and it is the reason the claim is not simply left red here. A row
// asserting `v2_cli_run` reaches `CliEmitted` over a one-module ingest failed; so did the SAME
// ingest and admission handed to `emit_compiler_import_closure_from_ingest` DIRECTLY, with this CLI
// entirely out of the path -- which localises the refusal to the fold rather than to the routing.
// And the pre-existing claim for that fold, `v2.test.claim.long.self_host_module_emit_derisk`
// `self_host_frontier_emit_ownership_miss_accepts`, is RED ON THIS TREE unchanged: it asserts
// Accepted for the identical module shape and does not get it. So the emitter does not accept a
// standalone-module ingest at this head, and a claim asserting that it does would be red for a
// defect it does not own.
//
// WHY THAT RED WAS NOT ALREADY KNOWN: that file lives under `test/claim/long/`, which CI discovery
// EXCLUDES at directory grain, and its last commit is a repository-wide DESIGN edit. The exclusion
// note in `gunbc.ci.ci_layer_roots` already carries the retraction that relocating a witness there is
// precisely what stops it running; this is that retraction's next receipt.
//
// THE TRIGGER, NAMED AS A CAPABILITY (DESIGN section 4b(3)): `emit_compiler_import_closure_from_ingest`
// accepts a single-module ingest whose admission names that module -- evidenced by
// `self_host_frontier_emit_ownership_miss_accepts` going green. At that point the inhabitance claim
// for this CLI is a one-module ingest and three lines over it, and it lands HERE with the fixture
// it needs -- which is why no fixture is parked here now: a probe ingest with no claim executing
// it is the dangling declaration section 3c calls red, and "ready for later" is that section's
// own tell.
// THE EXECUTING CONSUMER IN THE MEANTIME is `gunbc test //gunbc/instruments:v2-native-cli`, which
// emits and compiles this module's whole closure -- that is compilation of the emit arm and not
// execution of it, and the difference is exactly what this frontier records.

// A COMMAND LINE THAT WAS NOT USABLE EXITS 2, WORK THAT RAN AND REFUSED EXITS 1. The two are
// different terminations for the caller -- one means "fix the invocation", the other "the subject
// did not emit" -- so each row pins its exact code rather than any non-zero.
test fn a_refused_plan_exits_misuse_holds() -> Bool {
  match v2_cli_exit(
    outcome: v2_cli_run(plan: v2_cli_parse(argv: argv_of(items: argv_empty)), ingest: Empty)
  ) {
    ExitSuccess => false
    ExitFailure { code: code, reason: _ } => code == exit_code_misuse
  }
}

test fn an_unknown_target_exits_misuse_holds() -> Bool {
  match v2_cli_exit(
    outcome: v2_cli_run(plan: v2_cli_parse(argv: argv_of(items: argv_emit_unknown_target)), ingest: Empty)
  ) {
    ExitSuccess => false
    ExitFailure { code: code, reason: _ } => code == exit_code_misuse
  }
}

test fn an_emit_refusal_exits_general_error_holds() -> Bool {
  match v2_cli_exit(
    outcome: v2_cli_run(plan: v2_cli_parse(argv: argv_of(items: argv_emit_one_root)), ingest: Empty)
  ) {
    ExitSuccess => false
    ExitFailure { code: code, reason: _ } => code == exit_code_general_error
  }
}

// THE REFUSAL NAMES THE REFUSING LINK, NOT THE FIRST ADVISORY. This is the run-level claim the emit
// arm's frontier above does not block: a refusal at ASSEMBLE happens before the single-module
// emit frontier is reached, so a supplied ingest holding one file with tokens left after its module
// body refuses through the real front end (tokenize, parse, normalize over dag_language_model).
// The outcome's `reason` must be the
// FATAL -- the last link, parse_g0_tokens_remain -- and the detail must locate it: the compilation
// unit the front end was handed (v2.compiler.program_assembly names the read's compilation_unit as
// the diagnostic file) and the byte extent of the first remaining token. Before this change the `reason` field carried the head,
// which on every such refusal was then the same grammar-global advisory (a residue since retired), so three different broken
// entries refused with one indistinguishable reason (gunbc#11507 measured it on the built binary).
data cli_probe_entry_source: String = "module v2.cli_probe.entry\n\nimport std.types { Bool }\n\nfn cli_probe_entry_value(p: Bool) -> Bool { p }\n"

data cli_probe_trailing_source: String = "module v2.cli_probe.trailing\n\nimport std.types { Bool }\n\nfn cli_probe_trailing_value(p: Bool) -> Bool { p }\n) ) )\n"

fn cli_probe_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data cli_probe_trailing_ingest: SourceRootIngest = [
  cli_probe_read(source: cli_probe_entry_source, id: ^cli_probe_entry_artifact, unit: ^cli_probe_entry_cu, path: "dag/cli_probe_entry.dag"),
  cli_probe_read(source: cli_probe_trailing_source, id: ^cli_probe_trailing_artifact, unit: ^cli_probe_trailing_cu, path: "dag/cli_probe_trailing.dag")
]

data argv_emit_cli_probe_entry: FreeMonoid<String> = Cons {
  head: "emit",
  tail: Cons {
    head: "--entry",
    tail: Cons {
      head: "v2.cli_probe.entry",
      tail: Cons { head: "--source-root", tail: Cons { head: "dag", tail: Empty } }
    }
  }
}

// ONE NULLARY PRODUCER, FORCED ONCE (v2.workflow.floor_pure_producer_share, WARM): the run pays a
// grammar preparation and a two-file front end, which is more than one claim's budget, and both
// claims below inspect one field of its outcome.
fn cli_probe_trailing_outcome() -> CliRunOutcome {
  v2_cli_run(
    plan: v2_cli_parse(argv: argv_of(items: argv_emit_cli_probe_entry)),
    ingest: cli_probe_trailing_ingest
  )
}

test fn a_trailing_token_refusal_names_the_refusing_link_as_its_reason_holds() -> Bool {
  outcome_refusal_reason(outcome: cli_probe_trailing_outcome()) == ^parse_g0_tokens_remain
}

test fn a_trailing_token_refusal_locates_its_fatal_in_the_file_holds() -> Bool {
  match cli_probe_trailing_outcome() {
    CliRunRefused { reason: _, detail: detail } =>
      string_contains(s: detail, pattern: "FATAL AT cli_probe_trailing_cu bytes ")
        && string_contains(s: detail, pattern: "parse_g0_tokens_remain @ cli_probe_trailing_cu bytes ")
    CliUsageRefused { reason: _, detail: _ } => false
    CliEmitted { text: _, closure_size: _, refused_count: _, refusal_detail: _ } => false
    CliPopulationReported { text: _, held: _, detail: _ } => false
  }
}

// AN UNBOUND EMIT LINE NAMES WHAT FAILED BEFORE FATAL AT (review 80097). Same door as the trailing-
// token claims: v2_cli_run over a supplied ingest. The fatal stays last; the census projection rides
// in front of it. Dropping the CLI wiring while keeping the census renderer greens every census
// claim and reds this one.
data cli_probe_unbound_source: String = "module v2.cli_probe.unbound\n\nfn go() -> Bool {\n  never_declared\n}\n"

data cli_probe_unbound_ingest: SourceRootIngest = [
  cli_probe_read(source: cli_probe_unbound_source, id: ^cli_probe_unbound_artifact, unit: ^cli_probe_unbound_cu, path: "dag/cli_probe_unbound.dag")
]

fn cli_probe_unbound_outcome() -> CliRunOutcome {
  v2_cli_run(
    plan: CliPlanParsed {
      verb: CliEmitClosure {
        entry: "v2.cli_probe.unbound",
        source_roots: Empty,
        target: CliTargetRust
      }
    },
    ingest: cli_probe_unbound_ingest
  )
}

test fn an_unbound_emit_line_names_what_is_unbound_before_fatal_at_RED() -> Bool {
  match cli_probe_unbound_outcome() {
    CliRunRefused { reason: _, detail: detail } =>
      string_contains(s: detail, pattern: "unbound_name=never_declared | FATAL AT")
    CliUsageRefused { reason: _, detail: _ } => false
    CliEmitted { text: _, closure_size: _, refused_count: _, refusal_detail: detail } =>
      string_contains(s: detail, pattern: "unbound_name=never_declared | FATAL AT")
    CliPopulationReported { text: _, held: _, detail: _ } => false
  }
}

// THE WHOLE-POPULATION VERBS TAKE SOURCE ROOTS AND NO ENTRY. Their parse is one walk shared by three
// verbs (`if-arm-reader-differential`, `check-layout`, `parse-population`), so the claim that matters
// is that each SPELLING selects its OWN verb: a parser that mapped every roots verb to the first arm
// would parse all three and select one. The argv below is supplied at this CLI's boundary, and the
// verbs' own subject -- what a held or refused population looks like -- is claimed where it is
// decided (`v2.test.claim.source_layout_lookup`) and executed on the built binary
// (`v1_compiler.cli_run.native_lane_runner` `walk_population_controls`), which is where the real
// producer runs.
fn argv_roots_verb(verb: String, root: String) -> FreeMonoid<String> {
  Cons { head: verb, tail: Cons { head: "--source-root", tail: Cons { head: root, tail: Empty } } }
}

fn plan_roots_verb_label(plan: CliPlan) -> String {
  match plan {
    CliPlanRefused { reason: _, detail: _ } => ""
    CliPlanParsed { verb: verb } =>
      match verb {
        CliEmitClosure { entry: _, source_roots: _, target: _ } => "emit"
        CliIfArmReaderDifferential { source_roots: _ } => cli_verb_if_arm_reader_differential
        CliCheckLayout { source_roots: _ } => cli_verb_check_layout
        CliSelectSpelledModules { source_roots: _ } => cli_verb_select_spelled_modules
        CliParsePopulation { source_roots: _, compiler: _, write_identity: _, receipts: _, reuse_from: _ } => cli_verb_parse_population
      }
  }
}

test fn the_check_layout_spelling_selects_its_own_verb_holds() -> Bool {
  plan_roots_verb_label(plan: v2_cli_parse(argv: argv_roots_verb(verb: "check-layout", root: "dag")))
    == cli_verb_check_layout
}

test fn the_select_spelled_modules_spelling_selects_its_own_verb_holds() -> Bool {
  plan_roots_verb_label(plan: v2_cli_parse(argv: argv_roots_verb(verb: "select-spelled-modules", root: "dag")))
    == cli_verb_select_spelled_modules
}

test fn the_parse_population_spelling_selects_its_own_verb_holds() -> Bool {
  plan_roots_verb_label(plan: v2_cli_parse(argv: argv_roots_verb(verb: "parse-population", root: "dag")))
    == cli_verb_parse_population
}

data argv_parse_population_writes: FreeMonoid<String> = Cons {
  head: "parse-population",
  tail: Cons {
    head: "--source-root",
    tail: Cons {
      head: "dag",
      tail: Cons {
        head: "--compiler",
        tail: Cons {
          head: "cid",
          tail: Cons {
            head: "--write-identity",
            tail: Cons {
              head: "/tmp/id",
              tail: Cons { head: "--receipts", tail: Cons { head: "/tmp/r", tail: Empty } }
            }
          }
        }
      }
    }
  }
}

test fn parse_population_parses_write_identity_and_receipts_holds() -> Bool {
  match v2_cli_parse(argv: argv_of(items: argv_parse_population_writes)) {
    CliPlanRefused { reason: _, detail: _ } => false
    CliPlanParsed { verb: verb } =>
      match verb {
        CliParsePopulation { source_roots: _, compiler: c, write_identity: w, receipts: r, reuse_from: _ } =>
          match c {
            Absent => false
            Present { value: cid } => cid == "cid"
          }
            && match w {
              Absent => false
              Present { value: p } => p == "/tmp/id"
            }
            && match r {
              Absent => false
              Present { value: p } => p == "/tmp/r"
            }
        CliEmitClosure { entry: _, source_roots: _, target: _ } => false
        CliIfArmReaderDifferential { source_roots: _ } => false
        CliCheckLayout { source_roots: _ } => false
        CliSelectSpelledModules { source_roots: _ } => false
      }
  }
}

data argv_parse_population_reuse: FreeMonoid<String> = [
  "parse-population", "--source-root", "dag", "--compiler", "cid", "--reuse-from", "/tmp/base"
]

data argv_parse_population_reuse_dangling: FreeMonoid<String> = [
  "parse-population", "--source-root", "dag", "--reuse-from"
]

test fn parse_population_parses_reuse_from_and_refuses_it_dangling_holds() -> Bool {
  (match v2_cli_parse(argv: argv_of(items: argv_parse_population_reuse)) {
    CliPlanRefused { reason: _, detail: _ } => false
    CliPlanParsed { verb: verb } =>
      match verb {
        CliParsePopulation { source_roots: _, compiler: _, write_identity: _, receipts: _, reuse_from: r } =>
          match r {
            Absent => false
            Present { value: p } => p == "/tmp/base"
          }
        CliEmitClosure { entry: _, source_roots: _, target: _ } => false
        CliIfArmReaderDifferential { source_roots: _ } => false
        CliCheckLayout { source_roots: _ } => false
        CliSelectSpelledModules { source_roots: _ } => false
      }
  })
    && match v2_cli_parse(argv: argv_of(items: argv_parse_population_reuse_dangling)) {
      CliPlanRefused { reason: reason, detail: _ } => reason == ^cli_reuse_from_missing_value
      CliPlanParsed { verb: _ } => false
    }
}

test fn the_differential_spelling_selects_its_own_verb_holds() -> Bool {
  plan_roots_verb_label(plan: v2_cli_parse(argv: argv_roots_verb(verb: "if-arm-reader-differential", root: "dag")))
    == cli_verb_if_arm_reader_differential
}

test fn a_population_verb_names_the_roots_it_was_given_holds() -> Bool {
  let plan = v2_cli_parse(argv: argv_roots_verb(verb: "check-layout", root: "src/v2"))
  (length(xs: v2_cli_plan_source_roots(plan: plan)) == 1) && (plan_first_root_of_roots_verb(plan: plan) == "src/v2")
}

fn plan_first_root_of_roots_verb(plan: CliPlan) -> String {
  match list_head(xs: v2_cli_plan_source_roots(plan: plan)) {
    Absent => ""
    Present { value: first } => first
  }
}

// A POPULATION VERB WITH NO ROOT IS A REFUSAL AND NOT AN EMPTY POPULATION: it would check or parse
// nothing and hold, which is the empty-observation narrow section 5 forbids.
data argv_check_layout_no_root: FreeMonoid<String> = Cons { head: "check-layout", tail: Empty }

data argv_parse_population_dangling_root: FreeMonoid<String> = Cons {
  head: "parse-population",
  tail: Cons { head: "--source-root", tail: Empty }
}

data argv_check_layout_with_entry: FreeMonoid<String> = Cons {
  head: "check-layout",
  tail: Cons { head: "--entry", tail: Cons { head: "cli_probe", tail: Empty } }
}

test fn a_population_verb_without_a_source_root_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_check_layout_no_root))) == ^cli_no_source_root
}

test fn a_population_verb_with_a_dangling_source_root_option_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_parse_population_dangling_root)))
    == ^cli_source_root_missing_value
}

// THE POPULATION VERBS HAVE NO ENTRY: the option that selects a closure's subject is an unknown option
// to a verb whose subject is the population, rather than a value the verb would quietly ignore.
test fn a_population_verb_given_an_entry_refuses_holds() -> Bool {
  plan_refusal_reason(plan: v2_cli_parse(argv: argv_of(items: argv_check_layout_with_entry))) == ^cli_unknown_option
}

// A POPULATION VERB READS THE BOUND TREES ITSELF AND ACQUIRES NO CLOSURE, so running it over a
// supplied ingest refuses by name; it does not answer from the ingest it was never meant to have.
test fn a_population_verb_over_an_ingest_refuses_holds() -> Bool {
  (outcome_refusal_reason(
    outcome: v2_cli_run(plan: v2_cli_parse(argv: argv_roots_verb(verb: "check-layout", root: "dag")), ingest: Empty)
  ) == ^cli_population_verb_takes_no_ingest)
    && (outcome_refusal_reason(
      outcome: v2_cli_run(plan: v2_cli_parse(argv: argv_roots_verb(verb: "parse-population", root: "dag")), ingest: Empty)
    ) == ^cli_population_verb_takes_no_ingest)
}

// THE STATUS OF A POPULATION VERB IS WHETHER IT HELD. A held verdict exits 0 and a refused one exits
// 1 -- "the subject did not hold", the same code an emit refusal exits, and not the misuse code that
// means the invocation was unusable.
test fn a_held_population_verdict_exits_success_holds() -> Bool {
  match v2_cli_exit(outcome: CliPopulationReported { text: "", held: true, detail: "held" }) {
    ExitSuccess => true
    ExitFailure { code: _, reason: _ } => false
  }
}

test fn a_refused_population_verdict_exits_general_error_holds() -> Bool {
  match v2_cli_exit(outcome: CliPopulationReported { text: "a located line", held: false, detail: "did not hold" }) {
    ExitSuccess => false
    ExitFailure { code: code, reason: _ } => code == exit_code_general_error
  }
}
