module v2.test.claim.cli.rst_probe

// STANDALONE, never imported by any instrument or required claim. This is a diagnostic harness only: it asks
// whether the whole-corpus run-step refusals are an ACQUISITION failure (the target module is not a readable
// population member under [dag, src/v2]) or a LOAD failure (readable, but never became a resolution root). It
// imports only the acquisition surface, so claim_batch resolves it in seconds instead of the whole compiler.

import std.types { Bool, List, String }
import std.algebra { fold_list }
import v2.std.cross_tree.import_model { DagTree, V2Tree }
import v2.cli.repository_layout { repository_storage_layout }
import v2.compiler.module_acquisition { SourceRootBinding, population_member, PopulationMember }

fn probe_refused_names() -> List<String> {
  [
    "gunbc.cloudflare.r2_bucket_ensure", "gunbc.cloudflare.r2_token_mint_run", "gunbc.fleet.approval_ntfy_retirement",
    "gunbc.fleet.flex_pass_run", "gunbc.fleet.hetzner_cloud_server_control", "gunbc.fleet.org_actions_inspection",
    "gunbc.fleet.organization_runner_roster_read", "gunbc.fleet.srv1_root_mutation_approval_run", "gunbc.heal_publication",
    "gunbc.host.host_reset_return_run", "gunbc.live_deploy.apply", "gunbc.live_deploy.pre_swap_admission",
    "gunbc.machine_intake.arrival_run", "gunbc.machine_intake.mtcollins1_boot_run", "gunbc.machine_intake.mtcollins1_kvm_observer_observe",
    "gunbc.machine_intake.mtcollins1_sol_notice", "gunbc.runner.runner_group_restriction_ensure_run",
    "gunbc.runner.runner_jit_dead_sweep_run", "gunbc.runner.runner_lost_boot_sweep_run", "gunbc.runner.runner_microvm_network_apply",
    "gunbc.runner.runner_qualification_attempt_run", "gunbc.runner.runner_service_slot_start", "product.fabric.flex_vast_template_control"
  ]
}

fn probe_one_readable(name: String) -> Bool {
  match population_member(layout: repository_storage_layout(), bindings: [
    SourceRootBinding { tree: DagTree, host_directory: "dag" },
    SourceRootBinding { tree: V2Tree, host_directory: "src/v2" }
  ], name: name) {
    PopulationMemberRead { member: _ } => true
    PopulationMemberRefused { cause: _ } => false
  }
}

test fn probe_refused_run_step_target_modules_are_population_readable_holds() -> Bool {
  fold_list(xs: probe_refused_names(), empty: true, cons: fn(acc, name) { acc && probe_one_readable(name: name) })
}
