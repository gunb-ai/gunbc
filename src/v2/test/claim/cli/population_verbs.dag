data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE POPULATION PARSE'S DECLARED-REFUSAL JUDGMENT, DISCRIMINATED AT THE INTERFACE IT ANSWERS FOR.
//
// THE SUBJECT is the typed verdict of v2.cli.population_verbs: given the classes
// (gunbc.parse_population_refusals RefusalClass: drop, parse cause, exact module file keys) and the
// judgment of each enumerated member, does the population parse hold. Its inputs are SUPPLIED classes
// and SUPPLIED member judgments, so these claims never read the live declaration or the live tree and
// cannot go stale when either moves. What that runner pairs it with is NOT a repository walk:
// `gunbc test //gunbc/instruments:v2-native-cli` (src/v1/stage0/src/cli_run/native_lane_runner.rs,
// walk_population_controls) holds `check-layout` over the live roots and walks `parse-population` only over
// the FIXTURE roots ("the fixture roots below walk the verb on real directories"), so deleting this verb
// would fail those controls. The walk over the REPOSITORY itself runs
// in the gate's parse-verdict steps, and its Reused arm on a publish (this patch's route) runs only once
// .github/workflows/witnesses.yml carries --reuse-from on the publish walk.
//
// THE DECLARATION IS TWO-SIDED AND THE VERDICT OWNS BOTH SIDES. A walk that judged every member holds
// only when
//   - every member that refused was declared, with the declared cause (a module no class names, or a
//     named module that now fails for ANOTHER cause, is a new defect, not the declared one);
//   - no declared member parses (a listed module that parses is how a list can only shrink); and
//   - every declared refusal was MET: a declared module the enumeration never reached (deleted,
//     renamed, left out of the walk) is a located red, so the list cannot outlive its files and a walk
//     that skipped the declared modules cannot pass by skipping them.
// A module declared twice is a second authority for one parse result and refuses the whole report.

data fixture_classes: List<RefusalClass> = [
  RefusalClass { drop: "fixture_drop_a", cause: "parse_g0_tokens_remain", keys: ["dag:a/one.dag", "dag:a/two.dag"] },
  RefusalClass { drop: "fixture_drop_b", cause: "parse_declaration_marker_not_test", keys: ["v2:b/three.dag"] }
]

type Judgment
  = JudgedRefused { key: String, cause: String }
  | JudgedParses { key: String, source_digest: String }

data fixture_source_digest: String = "fixture-source-digest"
data fixture_compiler: String = "fixture-compiler"

fn held_parse_report_text() -> String {
  parse_verdict_stored_accepted_line(source_digest: fixture_source_digest, compiler: fixture_compiler)
}

// The begun declaration as a fixture tally. A duplicated declaration is carried as a tally whose
// located lines are the duplicated keys, so the clean-start control below refuses it.
fn begun(classes: List<RefusalClass>) -> PopulationParse {
  match population_parse_begin(classes: classes, compiler: optional_absent(), reuse: parse_verdict_reuse_off()) {
    PopulationBegun { tally: tally } => tally
    PopulationDeclarationDuplicated { keys: keys } => {
      let no_declared: List<DeclaredRefusal> = []
      let no_causes: Map<String, String> = empty_map()
      let no_judged: Map<String, Bool> = empty_map()
      PopulationParse {
        parsed: 0,
        declared: 0,
        roster: DeclaredRoster { ordered: no_declared, causes: no_causes },
        judged: no_judged,
        refusals: keys,
        accepted_receipts: [],
        compiler: optional_absent(),
        reuse: parse_verdict_reuse_off()
      }
    }
  }
}

fn judge(tally: PopulationParse, judgment: Judgment) -> PopulationParse {
  match judgment {
    JudgedRefused { key: key, cause: cause } => population_parse_refused(tally: tally, key: key, cause: cause, at: Absent)
    JudgedParses { key: key, source_digest: digest } => population_parse_accepted(tally: tally, key: key, source_digest: digest)
  }
}

// The verdict over a supplied walk: the same two steps `parse_population_listed` takes over the real
// enumeration, with the member judgments supplied.
fn verdict(classes: List<RefusalClass>, judgments: List<Judgment>) -> PopulationReport {
  match population_parse_begin(classes: classes, compiler: optional_present(value: fixture_compiler), reuse: parse_verdict_reuse_off()) {
    PopulationDeclarationDuplicated { keys: keys } => population_declaration_duplicated_report(keys: keys)
    PopulationBegun { tally: tally } =>
      population_parse_report(tally: fold_list(xs: judgments, empty: tally, cons: fn(acc, judgment) { judge(tally: acc, judgment: judgment) }))
  }
}

data every_declared_met: List<Judgment> = [
  JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
  JudgedRefused { key: "dag:a/two.dag", cause: "parse_g0_tokens_remain" },
  JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" },
  JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }
]

fn first_refusal(tally: PopulationParse) -> String {
  match list_head(xs: tally.refusals) {
    Absent => ""
    Present { value: line } => line
  }
}

// ---- the positive control: every declared refusal met, something parsed -------------------------------

test fn a_walk_meeting_every_declared_refusal_and_parsing_something_holds() -> Bool {
  let report = verdict(classes: fixture_classes, judgments: every_declared_met)
  report.held
    && report.text == held_parse_report_text()
    && !string_contains(s: report.text, pattern: "dag:a/one.dag")
    && !string_contains(s: report.text, pattern: "v2:b/three.dag")
}

test fn a_compiler_stamped_walk_with_no_accepted_receipt_refuses_empty() -> Bool {
  let report = verdict(
    classes: fixture_classes,
    judgments: [
      JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "dag:a/two.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" }
    ]
  )
  !report.held && report.detail == parse_verdict_receipts_empty_detail
}

test fn a_declaration_begins_with_nothing_judged() -> Bool {
  let tally = begun(classes: fixture_classes)
  (tally.parsed == 0) && (tally.declared == 0) && (length(xs: tally.refusals) == 0)
}

// ---- the per-member judgment ---------------------------------------------------------------------------

test fn a_covered_refusal_is_tallied_declared_and_reports_nothing() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/one.dag", cause: "parse_g0_tokens_remain", at: Absent)
  (tally.declared == 1) && (tally.parsed == 0) && (length(xs: tally.refusals) == 0)
}

test fn an_uncovered_refusal_is_reported_with_its_key_and_cause() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/four.dag", cause: "parse_g0_tokens_remain", at: Absent)
  (tally.declared == 0) && (tally.parsed == 0) && (first_refusal(tally: tally) == "dag:a/four.dag: parse_g0_tokens_remain")
}

// The module is declared, but for another cause: the declared refusal is no longer the module's, so the
// walk reports the contradiction once and does not also count the declaration as met.
test fn a_refusal_for_another_cause_than_the_declared_one_is_reported_and_not_met() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/one.dag", cause: "parse_declaration_marker_not_test", at: Absent)
  (tally.declared == 0)
    && (length(xs: tally.refusals) == 1)
    && first_refusal(tally: tally).starts_with(prefix: "dag:a/one.dag: parse_declaration_marker_not_test; gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain")
}

test fn a_member_is_declared_under_its_own_class_cause_only() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "v2:b/three.dag", cause: "parse_g0_tokens_remain", at: Absent)
  (tally.declared == 0) && (length(xs: tally.refusals) == 1)
}

test fn an_unlisted_module_that_parses_is_counted_parsed() -> Bool {
  let tally = population_parse_accepted(tally: begun(classes: fixture_classes), key: "dag:a/four.dag", source_digest: fixture_source_digest)
  (tally.parsed == 1) && (tally.declared == 0) && (length(xs: tally.refusals) == 0)
}

test fn a_listed_module_that_parses_is_reported_and_not_counted() -> Bool {
  let tally = population_parse_accepted(tally: begun(classes: fixture_classes), key: "dag:a/two.dag", source_digest: fixture_source_digest)
  (tally.parsed == 0) && (length(xs: tally.refusals) == 1) && first_refusal(tally: tally).starts_with(prefix: "dag:a/two.dag: parses, but gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain")
}

// ---- the verdict: each way the population parse does not hold, against the control --------------------

test fn a_walk_with_an_undeclared_refusal_does_not_hold() -> Bool {
  let report = verdict(
    classes: fixture_classes,
    judgments: [
      JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "dag:a/two.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" },
      JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest },
      JudgedRefused { key: "dag:a/five.dag", cause: "parse_g0_tokens_remain" }
    ]
  )
  !report.held && report.text == "dag:a/five.dag: parse_g0_tokens_remain"
}

// A declared module that now parses: the list must shrink, so the walk is red and the line names it.
test fn a_walk_in_which_a_declared_module_now_parses_does_not_hold() -> Bool {
  let report = verdict(
    classes: fixture_classes,
    judgments: [
      JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
      JudgedParses { key: "dag:a/two.dag", source_digest: fixture_source_digest },
      JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" },
      JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }
    ]
  )
  !report.held && report.text.starts_with(prefix: "dag:a/two.dag: parses, but")
}

// A declared module the enumeration never reached. Every other member judged cleanly and something
// parsed, so the unmet declaration is the only thing that can refuse this walk.
test fn a_walk_that_never_met_a_declared_refusal_does_not_hold() -> Bool {
  let report = verdict(
    classes: fixture_classes,
    judgments: [
      JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" },
      JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }
    ]
  )
  !report.held
    && report.text.starts_with(prefix: "dag:a/two.dag: gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain, but the population parse never met the module")
}

// A walk that skipped the declared modules altogether cannot pass by skipping them: every declared
// refusal is its own located line, in declaration order.
test fn a_walk_that_met_no_declared_refusal_reports_each_on_its_own_line() -> Bool {
  let report = verdict(classes: fixture_classes, judgments: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }])
  !report.held
    && report.text.starts_with(prefix: "dag:a/one.dag: gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain, but")
    && report.text.ends_with(suffix: "so remove it from its class")
    && !string_contains(s: report.detail, pattern: "a parse over nothing")
}

// The same walk with the declaration removed holds: the red above is the declaration's, not the walk's.
test fn the_same_walk_holds_when_nothing_is_declared() -> Bool {
  let none_declared: List<RefusalClass> = []
  let report = verdict(classes: none_declared, judgments: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }])
  report.held && report.text == held_parse_report_text()
}

// A module with one parse result is declared in one class: declared in two, the first would hide the
// second.
test fn a_module_declared_in_two_classes_refuses_the_report() -> Bool {
  let doubled: List<RefusalClass> = [
    RefusalClass { drop: "fixture_drop_a", cause: "parse_g0_tokens_remain", keys: ["dag:a/one.dag"] },
    RefusalClass { drop: "fixture_drop_b", cause: "parse_declaration_marker_not_test", keys: ["dag:a/one.dag"] }
  ]
  let report = verdict(classes: doubled, judgments: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }])
  !report.held && report.text == "dag:a/one.dag: gunbc.parse_population_refusals declares it more than once"
}

test fn a_module_declared_twice_in_one_class_refuses_the_report() -> Bool {
  let doubled: List<RefusalClass> = [RefusalClass { drop: "fixture_drop_a", cause: "parse_g0_tokens_remain", keys: ["dag:a/one.dag", "dag:a/one.dag"] }]
  let report = verdict(classes: doubled, judgments: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }])
  !report.held && report.text == "dag:a/one.dag: gunbc.parse_population_refusals declares it more than once"
}

test fn a_walk_that_parsed_nothing_does_not_hold() -> Bool {
  let none_declared: List<RefusalClass> = []
  let nothing_judged: List<Judgment> = []
  let report = verdict(classes: none_declared, judgments: nothing_judged)
  !report.held && report.detail == parse_verdict_receipts_empty_detail
}

// A walk over nothing with a declaration is red on both counts: the detail says that no module was
// enumerated (the cause every other unmet declaration follows from), and the text still names each
// declared module the walk never met. The host's walked empty-root control reads the detail.
test fn a_walk_over_no_enumerated_module_does_not_hold_and_names_the_declared_modules() -> Bool {
  let nothing_judged: List<Judgment> = []
  let report = verdict(classes: fixture_classes, judgments: nothing_judged)
  !report.held
    && report.text.starts_with(prefix: "dag:a/one.dag: ")
    && string_contains(s: report.detail, pattern: "a parse over nothing is not a parse of zero")
}

// THE TWO PRODUCTS, SEPARATED. report.text and the published payload were one value, and that single slot
// is what forced the gate to keep the two routes apart: with no base read the text IS the receipts payload,
// and with a base read the text is the operator's counts line. A publishing route that reads a base must
// therefore write the bytes a walk with no base would have written, while still printing the counts.
// The two tallies below carry the SAME verdicts; only their route differs, so their payloads must not.
//
// THIS IS NOT THE PURITY ORACLE. The oracle is the one gunbc.recurring_failure_mode.cache_impurity names
// ("byte-identical cached-vs-cold is the purity oracle"): two walks of ONE SUBJECT TREE under ONE
// parse-compiler identity, one cold and one reusing, compared BYTE FOR BYTE -- and only after both have
// actually been EXECUTED. A claim over fixtures is not that comparison, a hit push compared against a
// different, closure-changing tree is not it either, and nothing in this file has been executed (see the
// obligation at the foot of this file). What this control can do is narrower and local: hold the published
// payload fixed across the route while the counts line moves.
//
// BOTH SIDES GO THROUGH THE WALK'S OWN READING HALF, for the rows that have a reading half: a parses row is
// judged by standing, then counted, then acceptance (judge_read). A refused row skips standing and counted
// ENTIRELY -- population_parse_refused is called directly -- because a fixture refusal carries no source
// digest and standing cannot be judged without one. So the counts these controls compare are the counted
// ones, and they are NOT a walk's counts: a real walk also counts a declared-refused member, as
// miss_declared_refused, and does not count a member the lookup itself refused. Both of those routes are
// shown by the member-route controls below, not by this one.
//
// Both sides begin from reuse_tally_declared, whose declared classes COVER the refusals the fold replays. On
// the classes-free fixture those three rows are undeclared refusals, the report would not be held, and the
// baseline being compared would not exist.
test fn reading_a_base_changes_the_report_line_and_not_the_published_payload() -> Bool {
  let off_tally = fold_list(
    xs: every_declared_met,
    empty: reuse_tally_declared(reuse: parse_verdict_reuse_off()),
    cons: fn(acc, judgment) { judge_read(tally: acc, judgment: judgment) }
  )
  let on_tally = fold_list(
    xs: every_declared_met,
    empty: reuse_tally_declared(
      reuse: reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text()))
    ),
    cons: fn(acc, judgment) { judge_read(tally: acc, judgment: judgment) }
  )
  let off = population_verdict_products(tally: off_tally)
  let on = population_verdict_products(tally: on_tally)
  published_payload_ignores_the_route(
    off: off,
    on: on,
    cold_expected: held_parse_report_text(),
    counts_line: parse_verdict_reuse_counts_text(counts: on_tally.reuse.counts)
  )
}

// ---- THE WALK'S MEMBER ROUTE, DRIVEN FOR REAL ----------------------------------------------------------
//
// Every control in this block drives `population_parse_member_decided` -- the body the walk itself runs
// (src/v2/cli/population_verbs.dag): the digest of the member's own bytes, the standing lookup against the
// base, the counting, and THEN either the Reused acceptance or the call into the real parser. The controls
// these replace called `population_parse_accepted` on both sides of a "parity" comparison, and that function
// never reads the base: the pair could not fail, and a mutation inside the Reused-versus-parse branch stayed
// invisible. They are gone rather than annotated.
//
// WHAT IS SUPPLIED IS THE MEMBER, NOT THE DECISION. Each control hands over the (file, content) pair the
// lookup would have returned -- the boundary this claim answers for (DESIGN section 3, "A witness
// discriminates at one interface": its inputs are SUPPLIED VALUES at that boundary, never the result of
// running the producer). Everything past that boundary is production code, including `acquisition_parse`
// running over the environment the production route builds for itself (module_acquisition's acquisition_env,
// over the repository layout and the live .dag grammar -- the same call population_verbs makes). `bindings` is
// empty on purpose: the member lookup and `enumerate_bound_modules`' roster read them, and the decision under
// test reads neither -- a control that passed bindings would be claiming coverage of a step it does not run.
//
// WHAT STAYS OPEN, DECLARED RATHER THAN PASSED. No claim in this file executes the member LOOKUP, the CLI
// that assembles a tally from a real repository, or the two-walks-of-one-subject-tree byte comparison that is
// the actual purity oracle. Those are the real-producer inhabitance obligations. The lookup over a real
// repository is executed only by the gate's parse-verdict steps: `gunbc test
// //gunbc/instruments:v2-native-cli`'s walk_population_controls holds `check-layout` over the live roots and
// walks `parse-population` over the FIXTURE roots only ("the fixture roots below walk the verb on real
// directories"), and the Reused arm of the PUBLISHING walk executes only once .github/workflows/witnesses.yml
// carries --reuse-from there. NOTHING HERE HAS BEEN EXECUTED:
// no CI job runs v1 unit tests or witnesses, so a missing symbol in this file is NO_OBSERVATION and never a
// failure, and no claim below may be called RED or GREEN until an authorized execution exists.
//
// MUTATIONS THESE CONTROLS DISTINGUISH, each named against the control it must redden:
//   delete the Reused arm, or let it fall through to the parser
//     -> a_reused_member_is_accepted_without_the_parser_being_asked
//   let the Reused arm accept without counting
//     -> the same control, on its counts conjunct
//   let the standing lookup ignore the parse-compiler identity
//     -> a_base_under_another_identity_sends_the_unreused_member_to_the_parser
//   let the standing lookup call an unseen digest Reused
//     -> a_base_without_the_digest_sends_the_member_to_the_parser
//   record a receipt for a member the parser refused
//     -> a_refused_member_publishes_nothing_for_itself
//   sort the artifact -- publish it in a different order than the walk reached the members
//     -> a_mixed_walk_publishes_its_own_lines_in_walk_order, on its reversed-pair conjuncts
//   let a reused member's line be published, or a receipt recorded, for a member the roster declares refused
//     -> a_declared_refused_member_is_demoted_and_publishes_nothing
//
// TWO MUTATIONS THIS TABLE CANNOT REDDEN AT THIS INTERFACE, relabelled rather than claimed:
//   PUBLISH A MEMBER'S LINE UNDER ANOTHER MEMBER'S KEY: UNOBSERVABLE HERE. A receipt line carries no key
//     ("sha256:<digest> <compiler>", parse_verdict_stored_accepted_line), so no assertion over these tallies
//     can see a key swap. What keying means is decided by parse_verdict_receipt_lines' Map key and by the
//     artifact's consumers -- the CLI seam and the published artifact -- and those are the OPEN inhabitance
//     obligations named above, not a passed control.
//   ACCEPT THE BASE'S LINE AS THE MEMBER'S OWN: an EQUIVALENT mutation. Reused standing is granted only when
//     the base holds the EXACT line the member's own digest spells (gunbc.parse_verdict_schema
//     .parse_verdict_standing), so substituting "the base's line" for "the member's line" writes the same
//     bytes; no control can distinguish two programs that compute the same value.
//
// AT SUITE GRAIN, NOT PER CONTROL: four of these controls (a_refused_member_publishes_nothing_for_itself, the
// two standing controls that expect a parser visit, and a_reused_member_is_accepted_without_the_parser_being_
// asked, which never visits the parser at all) are satisfied by a parser that refuses EVERYTHING -- each either
// requires a refusal or never asks. A total-refusal parser is reddened by the three that require a member to
// PARSE: a_parsed_member_publishes_the_line_the_writer_will_publish,
// a_mixed_walk_publishes_its_own_lines_in_walk_order, and a_declared_refused_member_is_demoted_and_publishes_
// nothing (whose refusal must read "parses, but ... declares it refused", not a parse refusal). Read
// individually, the refusal controls do not establish that anything parses.

data parsable_member_text: String = "module v2.test.subject\n\nfn subject(x: Bool) -> Bool {\n  true\n}\n"

data parsable_other_text: String = "module v2.test.other\n\nfn other(x: Bool) -> Bool {\n  false\n}\n"

// Not a module header, so the parser's refusal is certain. The controls assert only THAT it refuses and never
// inspect the wording, which is the compiler's to phrase.
data unparsable_member_text: String = "no module header and no declaration: not a .dag module\n"

data member_file: ModuleFileRef = ModuleFileRef { tree: V2Tree, relative_path: "test/claim/cli/fixture_member.dag" }

data other_member_file: ModuleFileRef = ModuleFileRef { tree: V2Tree, relative_path: "test/claim/cli/fixture_other.dag" }

fn member_of(name: String, file: ModuleFileRef, content: String) -> AcquiredModule {
  AcquiredModule {
    name: name,
    file: file,
    host_directory: "src/v2",
    content: content,
    requests: [],
    test_markers: [],
    origin: AcquiredFromFile
  }
}

fn member_digest(content: String) -> String {
  content_hash_atom(value: content).digest as String
}

// The line the published artifact must carry for one member, spelled by the schema's own writer -- the same
// writer population_parse_receipts_text uses, so a control that pairs them is asking the question the
// artifact's consumers ask and not a question of its own invention.
fn member_line(content: String) -> String {
  parse_verdict_stored_accepted_line(source_digest: member_digest(content: content), compiler: fixture_compiler)
}

// THE ENVIRONMENT EVERY MEMBER-ROUTE CONTROL BELOW BUILDS, AND THE UNPREPARED ARM THEY SHARE. A refused
// a defect in the toolchain itself -- the live .dag grammar declining to prepare -- and a control that could
// not tell that condition from a walk would be worthless, so the Unprepared arm fails the control loudly
// rather than agreeing quietly. It is not a path any control here claims to cover.
test fn a_reused_member_is_accepted_without_the_parser_being_asked() -> Bool {
  match acquisition_env(layout: repository_storage_layout(), bindings: []) {
    AcquisitionEnvReady { env: env } => {
      let line = member_line(content: unparsable_member_text)
      let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: line))
      let tally = population_parse_member_decided(
        env: env,
        member: member_of(name: "v2.test.subject", file: member_file, content: unparsable_member_text),
        tally: reuse_tally(reuse: reuse)
      )
      length(xs: tally.refusals) == 0
        && length(xs: tally.accepted_receipts) == 1
        && list_head(xs: tally.accepted_receipts) == Present { value: line }
        && tally.reuse.counts.reused == 1
        && tally.reuse.counts.miss_digest_unseen == 0
        && tally.parsed == 1
        && population_verdict_products(tally: tally).receipts == Present { value: line }
    }
    AcquisitionEnvUnprepared { diagnostics: _ } => false
  }
}

// THE MISMATCHED IDENTITY IS NOT BELIEVED, AND THE ONLY THING THAT CAN SAY SO IS THE COUNT. The member's own
// line IS in the base, under another parse-compiler identity, and the member's text cannot parse -- so a
// standing rule that ignored the identity field would reuse it, accept it, and leave this control's refusal
// conjunct unsatisfied. The published payload also carries nothing: what a walk did not verify is not
// published, even when a base happens to hold the very line.
test fn a_base_under_another_identity_sends_the_unreused_member_to_the_parser() -> Bool {
  match acquisition_env(layout: repository_storage_layout(), bindings: []) {
    AcquisitionEnvReady { env: env } => {
      let line = member_line(content: unparsable_member_text)
      let reuse = reuse_base(i_base: optional_present(value: "another-parse-compiler"), text: optional_present(value: line))
      let tally = population_parse_member_decided(
        env: env,
        member: member_of(name: "v2.test.subject", file: member_file, content: unparsable_member_text),
        tally: reuse_tally(reuse: reuse)
      )
      tally.reuse.counts.miss_identity_mismatch == 1
        && tally.reuse.counts.reused == 0
        && length(xs: tally.accepted_receipts) == 0
        && length(xs: tally.refusals) == 1
    }
    AcquisitionEnvUnprepared { diagnostics: _ } => false
  }
}

// A DIGEST THE BASE NEVER CARRIED IS NOT THE MEMBER. Right identity, key present, different digest: the walk
// must parse, and this member cannot parse, so the refusal is the proof the base was not trusted. Delete the
// digest comparison and the member is reused, published and refused nowhere.
test fn a_base_without_the_digest_sends_the_member_to_the_parser() -> Bool {
  match acquisition_env(layout: repository_storage_layout(), bindings: []) {
    AcquisitionEnvReady { env: env } => {
      let other_line = parse_verdict_stored_accepted_line(source_digest: "digest-an-other-edit", compiler: fixture_compiler)
      let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: other_line))
      let tally = population_parse_member_decided(
        env: env,
        member: member_of(name: "v2.test.subject", file: member_file, content: unparsable_member_text),
        tally: reuse_tally(reuse: reuse)
      )
      tally.reuse.counts.miss_digest_unseen == 1
        && tally.reuse.counts.reused == 0
        && length(xs: tally.accepted_receipts) == 0
        && length(xs: tally.refusals) == 1
    }
    AcquisitionEnvUnprepared { diagnostics: _ } => false
  }
}

// A REFUSAL LEAVES NO RECEIPT BEHIND. Reuse off, so the standing is Absent and the parser is asked; the
// parser refuses; nothing is published for the member and the tally still carries the refusal the report must
// spell. This is the arm that would publish a line it never verified if acceptance were moved above the parse.
test fn a_refused_member_publishes_nothing_for_itself() -> Bool {
  match acquisition_env(layout: repository_storage_layout(), bindings: []) {
    AcquisitionEnvReady { env: env } => {
      let tally = population_parse_member_decided(
        env: env,
        member: member_of(name: "v2.test.subject", file: member_file, content: unparsable_member_text),
        tally: reuse_tally(reuse: parse_verdict_reuse_off())
      )
      length(xs: tally.refusals) == 1
        && length(xs: tally.accepted_receipts) == 0
        && tally.reuse.counts.reused == 0
    }
    AcquisitionEnvUnprepared { diagnostics: _ } => false
  }
}

// A PARSED MEMBER PUBLISHES ITS OWN LINE, WRITTEN BY THE SCHEMA'S WRITER. Reuse off over a member that does
// parse: the parser's acceptance is the only route to a receipt, and the line must be exactly what
// `population_parse_receipts_text` will publish for it -- which is the pairing the separated products exist
// to make checkable.
test fn a_parsed_member_publishes_the_line_the_writer_will_publish() -> Bool {
  match acquisition_env(layout: repository_storage_layout(), bindings: []) {
    AcquisitionEnvReady { env: env } => {
      let tally = population_parse_member_decided(
        env: env,
        member: member_of(name: "v2.test.subject", file: member_file, content: parsable_member_text),
        tally: reuse_tally(reuse: parse_verdict_reuse_off())
      )
      let line = member_line(content: parsable_member_text)
      length(xs: tally.refusals) == 0
        && length(xs: tally.accepted_receipts) == 1
        && list_head(xs: tally.accepted_receipts) == Present { value: line }
        && population_verdict_products(tally: tally).receipts == Present { value: line }
    }
    AcquisitionEnvUnprepared { diagnostics: _ } => false
  }
}

// THE MIXED WALK, IN WALK ORDER. Two members, both parsable, the base covering ONLY the first. Warm: the
// first is reused, the second parsed. Cold: both parsed, same order, no base. The published artifact must be
// BYTE-IDENTICAL -- a reused member's line is the line a parse would have written, or the cache has changed
// the answer -- and the counts must DIFFER, which is what makes this two walks rather than one walk compared
// with itself. Then the same members in the OPPOSITE order must produce a DIFFERENT artifact: the published
// text is a walk-ordered artifact and not a set. (The ORDER OF THE BASE is metadata, by contrast:
// `parse_verdict_receipt_lines` folds the base into a Map keyed by the folded line, so a lookup is a presence
// test with no order to observe -- a Map property, exercised by no control here; what IS controlled is that the
// base's ancestor field decides nothing, in the_named_ancestor_changes_nothing_about_standing.)
test fn a_mixed_walk_publishes_its_own_lines_in_walk_order() -> Bool {
  match acquisition_env(layout: repository_storage_layout(), bindings: []) {
    AcquisitionEnvReady { env: env } => {
      let first = member_of(name: "v2.test.subject", file: member_file, content: parsable_member_text)
      let second = member_of(name: "v2.test.other", file: other_member_file, content: parsable_other_text)
      let first_line = member_line(content: parsable_member_text)
      let second_line = member_line(content: parsable_other_text)
      let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: first_line))
      let warm = population_parse_member_decided(
        env: env,
        member: second,
        tally: population_parse_member_decided(env: env, member: first, tally: reuse_tally(reuse: reuse))
      )
      let cold = population_parse_member_decided(
        env: env,
        member: second,
        tally: population_parse_member_decided(env: env, member: first, tally: reuse_tally(reuse: parse_verdict_reuse_off()))
      )
      let warm_reversed = population_parse_member_decided(
        env: env,
        member: first,
        tally: population_parse_member_decided(env: env, member: second, tally: reuse_tally(reuse: reuse))
      )
      let cold_reversed = population_parse_member_decided(
        env: env,
        member: first,
        tally: population_parse_member_decided(env: env, member: second, tally: reuse_tally(reuse: parse_verdict_reuse_off()))
      )
      let warm_products = population_verdict_products(tally: warm)
      let cold_products = population_verdict_products(tally: cold)
      let warm_reversed_products = population_verdict_products(tally: warm_reversed)
      let cold_reversed_products = population_verdict_products(tally: cold_reversed)
      warm.reuse.counts.reused == 1
        && warm.reuse.counts.miss_digest_unseen == 1
        && cold.reuse.counts.reused == 0
        && cold.reuse.counts.miss_digest_unseen == 0
        && length(xs: warm.accepted_receipts) == 2
        // accepted_receipts is newest-first and the writer reverses it (population_parse_receipts_text), so
        // the head is the member the walk reached LAST.
        && list_head(xs: warm.accepted_receipts) == Present { value: second_line }
        // Neither member's line alone is the artifact: both are in it, in the order the walk reached them.
        && warm_products.receipts != Present { value: first_line }
        && warm_products.receipts != Present { value: second_line }
        // THE PAIR: a reused member's bytes are the bytes a parse would have published.
        && warm_products.receipts == cold_products.receipts
        // ...while the two walks are still distinguishable in what they report.
        && warm_products.report.text != cold_products.report.text
        // THE ORDER IS PART OF THE ARTIFACT: reversed walk, reversed bytes, in both routes -- and the
        // reversed walk really did reuse (otherwise this pair is one walk compared with itself).
        && warm_reversed.reuse.counts.reused == 1
        && warm_reversed.reuse.counts.miss_digest_unseen == 1
        && warm_reversed_products.receipts == cold_reversed_products.receipts
        && warm_reversed_products.receipts != warm_products.receipts
    }
    AcquisitionEnvUnprepared { diagnostics: _ } => false
  }
}

// THE COMBINED ROUTE, which existed only in pieces before this control: a member the roster DECLARES refused
// cannot reuse, is not counted as reused, is not counted as parsed, and publishes nothing -- even when the base
// carries EXACTLY the line its own bytes would spell. Three functions carry it, and a mutation to any one of
// them moves a number or a receipt here: population_parse_standing demotes a Reused lookup whose key the roster
// names to MissDeclaredRefused (delete the demotion and this control sees reused=1, parsed=1 and a receipt),
// population_parse_counted records the demotion (delete its MissDeclaredRefused arm and miss_declared_refused
// stays 0), and population_parse_accepted refuses a parsable member the roster names (delete its roster arm and
// parsed becomes 1 with a receipt). Before this, the standing rule alone was covered by
// parse_verdict_declared_refused_module_is_its_own_miss_holds and the parser-refusal arm by
// a_refused_member_publishes_nothing_for_itself; neither reached a member that PARSES while declared refused.
data member_file_key_text: String = "v2:test/claim/cli/fixture_member.dag"

data member_refusal_classes: List<RefusalClass> = [
  RefusalClass { drop: "fixture_drop_member", cause: "parse_g0_tokens_remain", keys: [member_file_key_text] }
]

fn reuse_tally_member_refused(reuse: ParseVerdictReuse) -> PopulationParse {
  match population_parse_begin(
    classes: member_refusal_classes,
    compiler: optional_present(value: fixture_compiler),
    reuse: reuse
  ) {
    PopulationBegun { tally: tally } => tally
    PopulationDeclarationDuplicated { keys: _ } => begun(classes: member_refusal_classes)
  }
}

test fn a_declared_refused_member_is_demoted_and_publishes_nothing() -> Bool {
  match acquisition_env(layout: repository_storage_layout(), bindings: []) {
    AcquisitionEnvReady { env: env } => {
      // The base WOULD have reused this member: the exact identity, and the line its own bytes spell.
      let own_line = member_line(content: parsable_member_text)
      let tally = population_parse_member_decided(
        env: env,
        member: member_of(name: "v2.test.subject", file: member_file, content: parsable_member_text),
        tally: reuse_tally_member_refused(reuse: reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: own_line)))
      )
      tally.reuse.counts.miss_declared_refused == 1
        && tally.reuse.counts.reused == 0
        && tally.parsed == 0
        && length(xs: tally.refusals) == 1
        && first_refusal(tally: tally).starts_with(prefix: concat(member_file_key_text, ": parses, but gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain"))
        // NO RECEIPT UNDER ITS OWN KEY, and the payload is the honest EMPTY one (a compiler is named, so the
        // product is Present and empty, not Absent): nothing was accepted, so nothing may be published.
        && population_verdict_products(tally: tally).receipts == Present { value: "" }
    }
    AcquisitionEnvUnprepared { diagnostics: _ } => false
  }
}

// THE ANCESTOR IS METADATA, NOT STANDING: two bases that differ ONLY in which ancestor they name decide the
// same standing for the same member. This is what makes the start commit a matter of hit rate and log
// honesty rather than soundness (the case the gate's comment claims, and the reason the force-push and
// batched-push residuals need no git-side guard to be safe).
test fn the_named_ancestor_changes_nothing_about_standing() -> Bool {
  let lines_text = reuse_receipts_text()
  let lines = Present { value: parse_verdict_receipt_lines(text: lines_text) }
  let one = ParseVerdictBase {
    ancestor: optional_present(value: "ancestor-one"),
    i_base: optional_present(value: fixture_compiler),
    receipt_lines: lines
  }
  let other = ParseVerdictBase {
    ancestor: Absent,
    i_base: optional_present(value: fixture_compiler),
    receipt_lines: lines
  }
  reuse_standing_is(reuse: parse_verdict_reuse_requested(base: one), digest: fixture_source_digest, expected: Reused)
    && reuse_standing_is(reuse: parse_verdict_reuse_requested(base: other), digest: fixture_source_digest, expected: Reused)
}

// THE PUBLISHED PAYLOAD IS THE ROUTE-INDEPENDENT PRODUCT: the same verdicts, read either way, publish the
// same bytes -- while the log line does move, because the walk with a base says what it reused.
fn published_payload_ignores_the_route(off: PopulationVerdictProducts, on: PopulationVerdictProducts, cold_expected: String, counts_line: String) -> Bool {
  match off.receipts {
    Absent => false
    // THE PUBLISHED BYTES DO NOT MOVE. The route changed; the artifact did not.
    Present { value: cold } => match on.receipts {
      Absent => false
      Present { value: warm } =>
        (cold == cold_expected)
          && (off.report.text == cold)
          && (off.report.held == true)
          && (warm == cold)
          && (on.report.held == true)
          // THE LOG LINE DOES MOVE: with a base read, the walk says what it reused.
          && (on.report.text == counts_line)
          && (on.report.text != cold)
    }
  }
}

// A HELD WALK WITH NO COMPILER HAS NO PAYLOAD TO PUBLISH: population_verdict_products answers Absent, not an
// empty string. PRODUCER-ONLY CLAIM, AND NOTHING MORE. This says what the PRODUCER hands a writer; it does not
// exercise the writer, whose `--compiler` is required whenever `--receipts` or `--write-identity` is asked for,
// so the writer's own Absent arm is UNREACHABLE from any accepted invocation and stays UNTESTED on purpose (see
// the arm's own label in src/v2/cli/compile_cli.dag for its scope). What an empty read means downstream is not
// this arm's business either: a base carrying no lines answers every member lookup with a miss, so no walk is
// ever completed by an empty base -- which is why population_verdict_products does not claim to guard it.
test fn a_walk_with_no_compiler_offers_no_receipts_payload() -> Bool {
  let no_compiler = fold_list(
    xs: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }],
    empty: begun(classes: []),
    cons: fn(acc, judgment) { judge(tally: acc, judgment: judgment) }
  )
  match population_verdict_products(tally: no_compiler).receipts {
    Absent => true
    Present { value: _ } => false
  }
}

// REUSE: the base the restore step left behind, built through the SAME crossing the verb reads it
// with (`parse_verdict_receipt_lines`), so a witness that supplies the text still executes the unfold.
fn reuse_receipts_text() -> String {
  concat(concat(held_parse_report_text(), "\n"), "parse-verdict\tother-digest\tfixture-compiler\tAccepted")
}

fn reuse_base(i_base: Optional<String>, text: Optional<String>) -> ParseVerdictReuse {
  parse_verdict_reuse_requested(base: ParseVerdictBase {
    ancestor: optional_present(value: "ancestor-sha"),
    i_base: i_base,
    receipt_lines: match text {
      Absent => Absent
      Present { value: t } => Present { value: parse_verdict_receipt_lines(text: t) }
    }
  })
}

// HOW ONE JUDGMENT ROW IS READ, AS FAR AS A ROW WITHOUT BYTES CAN BE READ: a parses row goes through
// standing, then counting, then acceptance. A REFUSED row is handed straight to `population_parse_refused` --
// it gets NO standing and NO counting, because the fixture's refusal rows carry no source digest and standing
// cannot be judged without one, and fabricating a digest would test nothing. `reused` and every miss move ONLY
// in population_parse_counted: a control that skips it cannot see a reuse happen, and cannot tell a walk that
// read a base from one that ignored it. Two consequences, stated rather than papered over: the counts this
// function produces are not a whole walk's counts (a real walk counts a declared-refused member as
// miss_declared_refused, and never counts a member the lookup itself refused -- the first is shown by
// `a_declared_refused_member_is_demoted_and_publishes_nothing`, the second is the lookup's own arm, which no
// control here reaches); and the decision itself -- Reused versus the parser -- is driven over a supplied
// member by the member-route controls above, which is where that branch gets its discrimination.
fn judge_read(tally: PopulationParse, judgment: Judgment) -> PopulationParse {
  match judgment {
    JudgedParses { key: key, source_digest: source_digest } => {
      let standing = population_parse_standing(tally: tally, key: key, source_digest: source_digest)
      let counted = population_parse_counted(tally: tally, standing: standing)
      population_parse_accepted(tally: counted, key: key, source_digest: source_digest)
    }
    JudgedRefused { key: key, cause: cause } => population_parse_refused(tally: tally, key: key, cause: cause, at: Absent)
  }
}

// THE SAME BEGINNING AS `begun(classes: fixture_classes)`, WITH A ROUTE ATTACHED. The classes-free fixture is
// right for the standing-rule controls, which assert one lookup and carry no refusals; it is WRONG for a
// control that replays the declared refusals, because on that fixture they are undeclared refusals, the report
// is not held, and the baseline being compared against does not exist.
fn reuse_tally_declared(reuse: ParseVerdictReuse) -> PopulationParse {
  match population_parse_begin(classes: fixture_classes, compiler: optional_present(value: fixture_compiler), reuse: reuse) {
    PopulationBegun { tally: tally } => tally
    PopulationDeclarationDuplicated { keys: _ } => begun(classes: fixture_classes)
  }
}

fn reuse_tally(reuse: ParseVerdictReuse) -> PopulationParse {
  match population_parse_begin(classes: [], compiler: optional_present(value: fixture_compiler), reuse: reuse) {
    PopulationBegun { tally: tally } => tally
    PopulationDeclarationDuplicated { keys: _ } => begun(classes: [])
  }
}

fn reuse_standing_is(reuse: ParseVerdictReuse, digest: String, expected: ParseVerdictStanding) -> Bool {
  match population_parse_standing(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: digest) {
    Present { value: got } => got == expected
    Absent => false
  }
}

// POSITIVE CONTROL, ROUTE ASSERTED: the exact identity and a receipt line for this digest give the
// Reused standing, and counting it moves `reused`, not any miss.
test fn parse_verdict_exact_identity_hit_is_reused_holds() -> Bool {
  let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text()))
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: Reused)
    && parse_verdict_reuse_counts_text(
      counts: population_parse_counted(tally: reuse_tally(reuse: reuse), standing: population_parse_standing(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: fixture_source_digest)).reuse.counts
    ) == "parse-verdict reuse: ancestor=ancestor-sha reused=1 miss_identity_absent=0 miss_identity_mismatch=0 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
}

// RED: a different base identity refuses reuse even though the digest's line is present.
test fn parse_verdict_identity_mismatch_refuses_reuse_holds() -> Bool {
  let reuse = reuse_base(i_base: optional_present(value: "other-compiler"), text: optional_present(value: reuse_receipts_text()))
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: MissIdentityMismatch)
}

// An evicted or never-published entry is a typed miss on each blob, never Reused.
test fn parse_verdict_absent_entry_is_a_typed_miss_holds() -> Bool {
  reuse_standing_is(reuse: reuse_base(i_base: Absent, text: Absent), digest: fixture_source_digest, expected: MissIdentityAbsent)
    && reuse_standing_is(reuse: reuse_base(i_base: optional_present(value: fixture_compiler), text: Absent), digest: fixture_source_digest, expected: MissEntryAbsent)
}

// The restore chain chose the ancestor and left one record plus one pair of blobs; the verb reads
// them through the same functions `parse_verdict_base_read` uses, over supplied outcomes.
fn locator_reuse(record: FilesystemReadOutcome, identity: FilesystemReadOutcome) -> ParseVerdictReuse {
  parse_verdict_reuse_requested(base: parse_verdict_base_from(
    ancestor: parse_verdict_ancestor_from(record: record),
    identity: identity,
    receipts: FilesystemReadSucceeded { content: reuse_receipts_text() }
  ))
}

fn locator_counts_text(reuse: ParseVerdictReuse) -> String {
  parse_verdict_reuse_counts_text(
    counts: population_parse_counted(
      tally: reuse_tally(reuse: reuse),
      standing: population_parse_standing(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: fixture_source_digest)
    ).reuse.counts
  )
}

// POSITIVE CONTROL, ROUTE ASSERTED: the restore chain recorded the second ancestor with the exact
// identity. That entry is the one reused, and the counts line names it.
test fn parse_verdict_locator_reuses_the_first_published_ancestor_holds() -> Bool {
  let reuse = locator_reuse(record: FilesystemReadSucceeded { content: "sha-2\n" }, identity: FilesystemReadSucceeded { content: fixture_compiler })
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: Reused)
    && locator_counts_text(reuse: reuse) == "parse-verdict reuse: ancestor=sha-2 reused=1 miss_identity_absent=0 miss_identity_mismatch=0 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
}

// RED: the chosen entry has another identity. It refuses reuse and counts the mismatch against the
// ancestor it came from; the workflow never offers a nearer match (see the restore witnesses).
test fn parse_verdict_locator_does_not_fall_through_a_mismatched_ancestor_holds() -> Bool {
  let reuse = locator_reuse(record: FilesystemReadSucceeded { content: "sha-1\n" }, identity: FilesystemReadSucceeded { content: "other-compiler" })
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: MissIdentityMismatch)
    && locator_counts_text(reuse: reuse) == "parse-verdict reuse: ancestor=sha-1 reused=0 miss_identity_absent=0 miss_identity_mismatch=1 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
}

// Nothing restored (no record, no identity) is a typed miss naming no ancestor; an empty record does too.
test fn parse_verdict_locator_with_no_published_ancestor_is_a_typed_miss_holds() -> Bool {
  let missing = locator_reuse(record: FilesystemReadRefused { error: "no record" }, identity: FilesystemReadRefused { error: "no entry" })
  let empty = locator_reuse(record: FilesystemReadSucceeded { content: "\n" }, identity: FilesystemReadRefused { error: "no entry" })
  reuse_standing_is(reuse: missing, digest: fixture_source_digest, expected: MissIdentityAbsent)
    && locator_counts_text(reuse: missing) == "parse-verdict reuse: ancestor=none reused=0 miss_identity_absent=1 miss_identity_mismatch=0 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
    && locator_counts_text(reuse: empty) == "parse-verdict reuse: ancestor=none reused=0 miss_identity_absent=1 miss_identity_mismatch=0 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
}

// A changed module (digest not in the restored set) re-parses.
test fn parse_verdict_unseen_digest_is_a_typed_miss_holds() -> Bool {
  reuse_standing_is(
    reuse: reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text())),
    digest: "edited-digest",
    expected: MissDigestUnseen
  )
}

// A module the declaration names refused has a matching stored line, yet reuse is withheld under its
// OWN standing: counting it as an unseen digest would send a reader looking for a missing receipt.
test fn parse_verdict_declared_refused_module_is_its_own_miss_holds() -> Bool {
  let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text()))
  match population_parse_begin(
    classes: [RefusalClass { drop: "fixture_drop_a", cause: "parse_g0_tokens_remain", keys: ["dag:a/four.dag"] }],
    compiler: optional_present(value: fixture_compiler),
    reuse: reuse
  ) {
    PopulationBegun { tally: tally } =>
      match population_parse_standing(tally: tally, key: "dag:a/four.dag", source_digest: fixture_source_digest) {
        Present { value: got } => got == MissDeclaredRefused
        Absent => false
      }
    PopulationDeclarationDuplicated { keys: _ } => false
  }
}

// Reuse off yields no standing at all: every module parses, as before.
test fn parse_verdict_reuse_off_has_no_standing_holds() -> Bool {
  match population_parse_standing(tally: reuse_tally(reuse: parse_verdict_reuse_off()), key: "k", source_digest: fixture_source_digest) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE SPELLING SELECTION IS A SUPERSET, AND THE CONTROLS SAY WHICH WAY: a comment that only mentions the name is
// SELECTED (no binding is claimed), a module that writes it as code is selected, and a module that writes neither
// is not. A selection that dropped the comment-only module would be claiming a binding-level fact it cannot see.
test fn a_comment_only_mention_of_a_ruled_spelling_is_selected_holds() -> Bool {
  spelled_in(content: "module m\n// chars is mentioned here only\n", names: ["chars"])
}

test fn a_module_writing_a_ruled_spelling_as_code_is_selected_holds() -> Bool {
  spelled_in(content: "module m\nfn f(s: String) -> Int { length(xs: chars(s: s)) }\n", names: ["chars"])
}

test fn a_module_spelling_no_ruled_name_is_not_selected_holds() -> Bool {
  !spelled_in(content: "module m\nfn f(s: String) -> Int { 1 }\n", names: ["chars"])
}

test fn a_selection_over_no_ruled_names_selects_nothing_holds() -> Bool {
  !spelled_in(content: "module m\n// chars\n", names: [])
}

test fn a_selection_reports_the_selected_names_and_holds() -> Bool {
  let report = select_spelled_report(selection: SpelledSelected { names: ["a.m1", "a.m2"] })
  report.held && report.text == "a.m1\na.m2"
}

test fn an_unreadable_module_refuses_the_whole_selection_holds() -> Bool {
  let report = select_spelled_report(selection: SpelledRefused { module: "a.m3", cause: "unreadable" })
  !report.held && report.text == "a.m3: unreadable"
}

// THE DECLARED COUNTS SHAPE IS BOUND TO THE PRINTED LINE, BYTE FOR BYTE. The fleet's reuse walk reads
// this line back and its only contract on it is a shell exit code, so the field set IS the contract
// (gunbc.recurring_failure_mode.instruction_and_subject_resolved_from_different_revisions, silent arm:
// four PR runs printed the six-field shape with no ancestor= under the NEW workflow and exited green with
// reused=0). gunbc.witness.compiler_gate_contract_stamp hashes these rows, so if the verb printed a field
// the rows omitted -- or stopped printing one -- the stamp would go on certifying a contract nobody has,
// and the guard built on it would pass a stale subject. That is a silent-green of exactly the kind this
// class records, smuggled into the mitigation, so the binding is a witness and not a comment.
test fn parse_verdict_counts_shape_matches_declared_rows_holds() -> Bool {
  let printed = parse_verdict_reuse_counts_text(
    counts: ParseVerdictReuseCounts {
      ancestor: "ancestor-sha",
      reused: 1,
      miss_identity_absent: 2,
      miss_identity_mismatch: 3,
      miss_entry_absent: 4,
      miss_digest_unseen: 5,
      miss_declared_refused: 6
    }
  )
  // THE BINDING IS EXACT, AND IT RUNS BOTH WAYS. Equality against the full printed line catches a
  // renamed, reordered, dropped or ADDED field; the occurrence fold catches the other direction, where
  // somebody edits the rows to match a print that had drifted away from them. Either way the stamp can
  // only certify a shape the verb actually prints.
  printed ==
    "parse-verdict reuse: ancestor=ancestor-sha reused=1 miss_identity_absent=2 miss_identity_mismatch=3 miss_entry_absent=4 miss_digest_unseen=5 miss_declared_refused=6"
    && string_contains(s: printed, pattern: parse_verdict_reuse_counts_prefix)
    && for_all(
      parse_verdict_reuse_counts_field_names(),
      label => string_contains(s: printed, pattern: join([" ", label, "="], ""))
    )
}

// The parse stage's located refusal reaches the population report: the line:col rides after the cause.
test fn a_located_undeclared_refusal_reports_its_line_and_column() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/five.dag", cause: "parse_data_value_missing_after_eq", at: Present { value: "3:13" })
  (length(xs: tally.refusals) == 1)
    && (first_refusal(tally: tally) == "dag:a/five.dag: parse_data_value_missing_after_eq at 3:13")
}

test fn an_unlocated_undeclared_refusal_reports_the_cause_alone() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/five.dag", cause: "parse_data_value_missing_after_eq", at: Absent)
  (length(xs: tally.refusals) == 1)
    && (first_refusal(tally: tally) == "dag:a/five.dag: parse_data_value_missing_after_eq")
}

// ---- WHAT THIS FILE DOES NOT ESTABLISH ---------------------------------------------------------------
//
// Nothing in this file has been EXECUTED. No CI job runs v1 unit tests or witnesses; the two emitted closures
// typecheck the CLI layer only (v2.cli.compile_cli, v2.compiler.source_root_eval), and this module is in
// neither, so a missing symbol here is NO_OBSERVATION and never a failure. Until an authorized execution
// exists, no claim above is RED, no claim above is GREEN, and the reviewer's judgement of them is a source
// review and not evidence.
//
// OPEN INHABITANCE OBLIGATIONS, named rather than assumed away:
//   1. THE MEMBER LOOKUP. The member-route controls supply the (file, content) pair a lookup would return.
//      The walk over the REPOSITORY is executed only by the gate's parse-verdict steps
//      (.github/workflows/witnesses.yml, generated from gunbc.witness.compiler_gate_workflow):
//      `gunbc test //gunbc/instruments:v2-native-cli`'s walk_population_controls walks `parse-population` over
//      the FIXTURE roots only, holding `check-layout` over the live roots, so it does not execute the lookup
//      over real repository modules. The Reused arm on a PUBLISH additionally executes only once that YAML
//      carries --reuse-from on the publish walk, which is the withheld regeneration.
//   2. THE PURITY ORACLE. gunbc.recurring_failure_mode.cache_impurity names it: "byte-identical cached-vs-cold
//      is the purity oracle" -- two EXECUTED walks of ONE subject tree under ONE parse-compiler identity, one
//      cold and one reusing. No claim in a fixture file can be that comparison, and no such pair has been run.
//   3. THE PUBLISHED ARTIFACT. Whether the bytes above ever reach an artifact is a claim about the gate's
//      save steps (dag/gunbc/parse_verdict_publish.dag) and the Actions cache, neither of which any test in
//      this tree executes.
