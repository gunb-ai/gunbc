module v2.test.claim.cli.population_verbs
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.types { Bool, List, Map, String }
import extdeps.filesystem.filesystem_io { FilesystemReadOutcome, FilesystemReadRefused, FilesystemReadSucceeded }
import gunbc.parse_population_refusals { RefusalClass }
import v2.cli.parse_verdict_reuse {
  ParseVerdictBase,
  parse_verdict_ancestor_from,
  parse_verdict_base_from,
  parse_verdict_receipt_lines,
  parse_verdict_reuse_counts_text,
  parse_verdict_reuse_counts_field_names,
}
import gunbc.parse_verdict_schema {
  ParseVerdictStanding,
  Reused,
  MissIdentityAbsent,
  MissIdentityMismatch,
  MissEntryAbsent,
  MissDigestUnseen,
  MissDeclaredRefused,
}
import v2.cli.population_verbs {
  SpelledRefused,
  SpelledSelected,
  spelled_in,
  select_spelled_report,
  ParseVerdictReuse,
  parse_verdict_reuse_off,
  parse_verdict_reuse_requested,
  population_parse_standing,
  population_parse_counted,
  DeclaredRefusal,
  DeclaredRoster,
  PopulationBegun,
  PopulationDeclarationDuplicated,
  PopulationParse,
  PopulationReport,
  population_declaration_duplicated_report,
  population_parse_accepted,
  population_parse_begin,
  population_parse_refused,
  population_parse_report,
  population_verdict_products,
  PopulationVerdictProducts,
}
import gunbc.parse_verdict_schema {
  parse_verdict_receipts_empty_detail,
  parse_verdict_stored_accepted_line,
}
import std.algebra { fold_list, for_all, length, list_head, empty_map }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.text { String }



data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE POPULATION PARSE'S DECLARED-REFUSAL JUDGMENT, DISCRIMINATED AT THE INTERFACE IT ANSWERS FOR.
//
// THE SUBJECT is the typed verdict of v2.cli.population_verbs: given the classes
// (gunbc.parse_population_refusals RefusalClass: drop, parse cause, exact module file keys) and the
// judgment of each enumerated member, does the population parse hold. Its inputs are SUPPLIED classes
// and SUPPLIED member judgments, so these claims never read the live declaration or the live tree and
// cannot go stale when either moves. The route is paired with the walked live-root controls of
// `gunbc test //gunbc/instruments:v2-native-cli` (src/v1/stage0/src/cli_run/native_lane_runner.rs
// walk_population_controls), which run the real `parse-population` verb over the repository: deleting
// that verb makes those controls fail.
//
// THE DECLARATION IS TWO-SIDED AND THE VERDICT OWNS BOTH SIDES. A walk that judged every member holds
// only when
//   - every member that refused was declared, with the declared cause (a module no class names, or a
//     named module that now fails for ANOTHER cause, is a new defect, not the declared one);
//   - no declared member parses (a listed module that parses is how a list can only shrink); and
//   - every declared refusal was MET: a declared module the enumeration never reached (deleted,
//     renamed, left out of the walk) is a located red, so the list cannot outlive its files and a walk
//     that skipped the declared modules cannot pass by skipping them.
// A module declared twice is a second authority for one parse result and refuses the whole report.

data fixture_classes: List<RefusalClass> = [
  RefusalClass { drop: "fixture_drop_a", cause: "parse_g0_tokens_remain", keys: ["dag:a/one.dag", "dag:a/two.dag"] },
  RefusalClass { drop: "fixture_drop_b", cause: "parse_declaration_marker_not_test", keys: ["v2:b/three.dag"] }
]

type Judgment
  = JudgedRefused { key: String, cause: String }
  | JudgedParses { key: String, source_digest: String }

data fixture_source_digest: String = "fixture-source-digest"
data fixture_compiler: String = "fixture-compiler"

fn held_parse_report_text() -> String {
  parse_verdict_stored_accepted_line(source_digest: fixture_source_digest, compiler: fixture_compiler)
}

// The begun declaration as a fixture tally. A duplicated declaration is carried as a tally whose
// located lines are the duplicated keys, so the clean-start control below refuses it.
fn begun(classes: List<RefusalClass>) -> PopulationParse {
  match population_parse_begin(classes: classes, compiler: optional_absent(), reuse: parse_verdict_reuse_off()) {
    PopulationBegun { tally: tally } => tally
    PopulationDeclarationDuplicated { keys: keys } => {
      let no_declared: List<DeclaredRefusal> = []
      let no_causes: Map<String, String> = empty_map()
      let no_judged: Map<String, Bool> = empty_map()
      PopulationParse {
        parsed: 0,
        declared: 0,
        roster: DeclaredRoster { ordered: no_declared, causes: no_causes },
        judged: no_judged,
        refusals: keys,
        accepted_receipts: [],
        compiler: optional_absent(),
        reuse: parse_verdict_reuse_off()
      }
    }
  }
}

fn judge(tally: PopulationParse, judgment: Judgment) -> PopulationParse {
  match judgment {
    JudgedRefused { key: key, cause: cause } => population_parse_refused(tally: tally, key: key, cause: cause, at: Absent)
    JudgedParses { key: key, source_digest: digest } => population_parse_accepted(tally: tally, key: key, source_digest: digest)
  }
}

// The verdict over a supplied walk: the same two steps `parse_population_listed` takes over the real
// enumeration, with the member judgments supplied.
fn verdict(classes: List<RefusalClass>, judgments: List<Judgment>) -> PopulationReport {
  match population_parse_begin(classes: classes, compiler: optional_present(value: fixture_compiler), reuse: parse_verdict_reuse_off()) {
    PopulationDeclarationDuplicated { keys: keys } => population_declaration_duplicated_report(keys: keys)
    PopulationBegun { tally: tally } =>
      population_parse_report(tally: fold_list(xs: judgments, empty: tally, cons: fn(acc, judgment) { judge(tally: acc, judgment: judgment) }))
  }
}

data every_declared_met: List<Judgment> = [
  JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
  JudgedRefused { key: "dag:a/two.dag", cause: "parse_g0_tokens_remain" },
  JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" },
  JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }
]

fn first_refusal(tally: PopulationParse) -> String {
  match list_head(xs: tally.refusals) {
    Absent => ""
    Present { value: line } => line
  }
}

// ---- the positive control: every declared refusal met, something parsed -------------------------------

test fn a_walk_meeting_every_declared_refusal_and_parsing_something_holds() -> Bool {
  let report = verdict(classes: fixture_classes, judgments: every_declared_met)
  report.held
    && report.text == held_parse_report_text()
    && !string_contains(s: report.text, pattern: "dag:a/one.dag")
    && !string_contains(s: report.text, pattern: "v2:b/three.dag")
}

test fn a_compiler_stamped_walk_with_no_accepted_receipt_refuses_empty() -> Bool {
  let report = verdict(
    classes: fixture_classes,
    judgments: [
      JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "dag:a/two.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" }
    ]
  )
  !report.held && report.detail == parse_verdict_receipts_empty_detail
}

test fn a_declaration_begins_with_nothing_judged() -> Bool {
  let tally = begun(classes: fixture_classes)
  (tally.parsed == 0) && (tally.declared == 0) && (length(xs: tally.refusals) == 0)
}

// ---- the per-member judgment ---------------------------------------------------------------------------

test fn a_covered_refusal_is_tallied_declared_and_reports_nothing() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/one.dag", cause: "parse_g0_tokens_remain", at: Absent)
  (tally.declared == 1) && (tally.parsed == 0) && (length(xs: tally.refusals) == 0)
}

test fn an_uncovered_refusal_is_reported_with_its_key_and_cause() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/four.dag", cause: "parse_g0_tokens_remain", at: Absent)
  (tally.declared == 0) && (tally.parsed == 0) && (first_refusal(tally: tally) == "dag:a/four.dag: parse_g0_tokens_remain")
}

// The module is declared, but for another cause: the declared refusal is no longer the module's, so the
// walk reports the contradiction once and does not also count the declaration as met.
test fn a_refusal_for_another_cause_than_the_declared_one_is_reported_and_not_met() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/one.dag", cause: "parse_declaration_marker_not_test", at: Absent)
  (tally.declared == 0)
    && (length(xs: tally.refusals) == 1)
    && first_refusal(tally: tally).starts_with(prefix: "dag:a/one.dag: parse_declaration_marker_not_test; gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain")
}

test fn a_member_is_declared_under_its_own_class_cause_only() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "v2:b/three.dag", cause: "parse_g0_tokens_remain", at: Absent)
  (tally.declared == 0) && (length(xs: tally.refusals) == 1)
}

test fn an_unlisted_module_that_parses_is_counted_parsed() -> Bool {
  let tally = population_parse_accepted(tally: begun(classes: fixture_classes), key: "dag:a/four.dag", source_digest: fixture_source_digest)
  (tally.parsed == 1) && (tally.declared == 0) && (length(xs: tally.refusals) == 0)
}

test fn a_listed_module_that_parses_is_reported_and_not_counted() -> Bool {
  let tally = population_parse_accepted(tally: begun(classes: fixture_classes), key: "dag:a/two.dag", source_digest: fixture_source_digest)
  (tally.parsed == 0) && (length(xs: tally.refusals) == 1) && first_refusal(tally: tally).starts_with(prefix: "dag:a/two.dag: parses, but gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain")
}

// ---- the verdict: each way the population parse does not hold, against the control --------------------

test fn a_walk_with_an_undeclared_refusal_does_not_hold() -> Bool {
  let report = verdict(
    classes: fixture_classes,
    judgments: [
      JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "dag:a/two.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" },
      JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest },
      JudgedRefused { key: "dag:a/five.dag", cause: "parse_g0_tokens_remain" }
    ]
  )
  !report.held && report.text == "dag:a/five.dag: parse_g0_tokens_remain"
}

// A declared module that now parses: the list must shrink, so the walk is red and the line names it.
test fn a_walk_in_which_a_declared_module_now_parses_does_not_hold() -> Bool {
  let report = verdict(
    classes: fixture_classes,
    judgments: [
      JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
      JudgedParses { key: "dag:a/two.dag", source_digest: fixture_source_digest },
      JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" },
      JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }
    ]
  )
  !report.held && report.text.starts_with(prefix: "dag:a/two.dag: parses, but")
}

// A declared module the enumeration never reached. Every other member judged cleanly and something
// parsed, so the unmet declaration is the only thing that can refuse this walk.
test fn a_walk_that_never_met_a_declared_refusal_does_not_hold() -> Bool {
  let report = verdict(
    classes: fixture_classes,
    judgments: [
      JudgedRefused { key: "dag:a/one.dag", cause: "parse_g0_tokens_remain" },
      JudgedRefused { key: "v2:b/three.dag", cause: "parse_declaration_marker_not_test" },
      JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }
    ]
  )
  !report.held
    && report.text.starts_with(prefix: "dag:a/two.dag: gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain, but the population parse never met the module")
}

// A walk that skipped the declared modules altogether cannot pass by skipping them: every declared
// refusal is its own located line, in declaration order.
test fn a_walk_that_met_no_declared_refusal_reports_each_on_its_own_line() -> Bool {
  let report = verdict(classes: fixture_classes, judgments: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }])
  !report.held
    && report.text.starts_with(prefix: "dag:a/one.dag: gunbc.parse_population_refusals declares it refused for parse_g0_tokens_remain, but")
    && report.text.ends_with(suffix: "so remove it from its class")
    && !string_contains(s: report.detail, pattern: "a parse over nothing")
}

// The same walk with the declaration removed holds: the red above is the declaration's, not the walk's.
test fn the_same_walk_holds_when_nothing_is_declared() -> Bool {
  let none_declared: List<RefusalClass> = []
  let report = verdict(classes: none_declared, judgments: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }])
  report.held && report.text == held_parse_report_text()
}

// A module with one parse result is declared in one class: declared in two, the first would hide the
// second.
test fn a_module_declared_in_two_classes_refuses_the_report() -> Bool {
  let doubled: List<RefusalClass> = [
    RefusalClass { drop: "fixture_drop_a", cause: "parse_g0_tokens_remain", keys: ["dag:a/one.dag"] },
    RefusalClass { drop: "fixture_drop_b", cause: "parse_declaration_marker_not_test", keys: ["dag:a/one.dag"] }
  ]
  let report = verdict(classes: doubled, judgments: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }])
  !report.held && report.text == "dag:a/one.dag: gunbc.parse_population_refusals declares it more than once"
}

test fn a_module_declared_twice_in_one_class_refuses_the_report() -> Bool {
  let doubled: List<RefusalClass> = [RefusalClass { drop: "fixture_drop_a", cause: "parse_g0_tokens_remain", keys: ["dag:a/one.dag", "dag:a/one.dag"] }]
  let report = verdict(classes: doubled, judgments: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }])
  !report.held && report.text == "dag:a/one.dag: gunbc.parse_population_refusals declares it more than once"
}

test fn a_walk_that_parsed_nothing_does_not_hold() -> Bool {
  let none_declared: List<RefusalClass> = []
  let nothing_judged: List<Judgment> = []
  let report = verdict(classes: none_declared, judgments: nothing_judged)
  !report.held && report.detail == parse_verdict_receipts_empty_detail
}

// A walk over nothing with a declaration is red on both counts: the detail says that no module was
// enumerated (the cause every other unmet declaration follows from), and the text still names each
// declared module the walk never met. The host's walked empty-root control reads the detail.
test fn a_walk_over_no_enumerated_module_does_not_hold_and_names_the_declared_modules() -> Bool {
  let nothing_judged: List<Judgment> = []
  let report = verdict(classes: fixture_classes, judgments: nothing_judged)
  !report.held
    && report.text.starts_with(prefix: "dag:a/one.dag: ")
    && string_contains(s: report.detail, pattern: "a parse over nothing is not a parse of zero")
}

// THE TWO PRODUCTS, SEPARATED. report.text and the published payload were one value, and that single slot
// is what forced the gate to keep the two routes apart: with no base read the text IS the receipts payload,
// and with a base read the text is the operator's counts line. A publishing route that reads a base must
// therefore write the bytes a walk with no base would have written, while still printing the counts -- the
// purity oracle for the default-branch route standing on an ancestor
// (gunbc.recurring_failure_mode.cache_impurity: "byte-identical cached-vs-cold is the purity oracle"). The
// two tallies below carry the SAME verdicts; only their route differs, so their payloads must not.
test fn reading_a_base_changes_the_report_line_and_not_the_published_payload() -> Bool {
  let off_tally = fold_list(
    xs: every_declared_met,
    empty: reuse_tally(reuse: parse_verdict_reuse_off()),
    cons: fn(acc, judgment) { judge(tally: acc, judgment: judgment) }
  )
  let on_tally = fold_list(
    xs: every_declared_met,
    empty: reuse_tally(
      reuse: reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text()))
    ),
    cons: fn(acc, judgment) { judge(tally: acc, judgment: judgment) }
  )
  let off = population_verdict_products(tally: off_tally)
  let on = population_verdict_products(tally: on_tally)
  published_payload_ignores_the_route(
    off: off,
    on: on,
    cold_expected: held_parse_report_text(),
    counts_line: parse_verdict_reuse_counts_text(counts: on_tally.reuse.counts)
  )
}

// THE PUBLISHED LINE IS THE MEMBER'S OWN, WHATEVER ROUTE BROUGHT IT. The member's standing is taken
// through the SAME function the walk consults (population_parse_standing); only when it is actually Reused
// does the acceptance run, and the line the publishing route then writes is byte-identical to the line the
// no-base route writes for the same member. Discriminatory mutations, each flipping a named assertion: a
// base under another parse-compiler identity yields MissIdentityMismatch instead of the reused path (next
// control); a base carrying another digest yields MissDigestUnseen; a walk with no compiler yields an
// Absent payload, not an empty one (the writer control below).
test fn a_reused_member_publishes_the_line_a_parsed_member_would() -> Bool {
  let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text()))
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: Reused)
    && published_payloads_agree(
      cold: population_verdict_products(
        tally: population_parse_accepted(tally: reuse_tally(reuse: parse_verdict_reuse_off()), key: "dag:a/four.dag", source_digest: fixture_source_digest)
      ),
      warm: population_verdict_products(
        tally: population_parse_accepted(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: fixture_source_digest)
      ),
      expected: held_parse_report_text()
    )
}

// RED AGAINST AN UNSOUND REUSE: a base under a different parse-compiler identity must not stand in for the
// member, and the line published for that member must still be the one THIS walk verified by parsing.
test fn a_mismatched_base_still_publishes_only_what_this_walk_verified() -> Bool {
  let wrong = reuse_base(i_base: optional_present(value: "other-compiler"), text: optional_present(value: reuse_receipts_text()))
  reuse_standing_is(reuse: wrong, digest: fixture_source_digest, expected: MissIdentityMismatch)
    && published_payloads_agree(
      cold: population_verdict_products(
        tally: population_parse_accepted(tally: reuse_tally(reuse: parse_verdict_reuse_off()), key: "dag:a/four.dag", source_digest: fixture_source_digest)
      ),
      warm: population_verdict_products(
        tally: population_parse_accepted(tally: reuse_tally(reuse: wrong), key: "dag:a/four.dag", source_digest: fixture_source_digest)
      ),
      expected: held_parse_report_text()
    )
}

// MIXED WALK, THE ORDER CASE: one member stands on the ancestor's line, the other is parsed here. The
// published file must carry both lines in the same order as the all-parsed walk -- the file IS the artifact,
// so a payload that agrees as a set but not in order is still a different artifact.
test fn a_mixed_walk_publishes_the_same_lines_in_the_same_order() -> Bool {
  let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text()))
  let cold_t = fold_list(
    xs: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }, JudgedParses { key: "dag:a/six.dag", source_digest: "other-digest" }],
    empty: reuse_tally(reuse: parse_verdict_reuse_off()),
    cons: fn(acc, judgment) { judge(tally: acc, judgment: judgment) }
  )
  // THE FIRST MEMBER STANDS ON THE ANCESTOR, THE SECOND DOES NOT: asserted, not assumed.
  let standing = population_parse_standing(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: fixture_source_digest)
  let warm_t = fold_list(
    xs: [JudgedParses { key: "dag:a/six.dag", source_digest: "other-digest" }],
    empty: population_parse_accepted(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: fixture_source_digest),
    cons: fn(acc, judgment) { judge(tally: acc, judgment: judgment) }
  )
  match standing {
    Present { value: Reused } =>
      published_payloads_agree(
        cold: population_verdict_products(tally: cold_t),
        warm: population_verdict_products(tally: warm_t),
        expected: concat(held_parse_report_text(), "\nparse-verdict\tother-digest\tfixture-compiler\tAccepted")
      )
    Present { value: MissIdentityAbsent } => false
    Present { value: MissIdentityMismatch } => false
    Present { value: MissEntryAbsent } => false
    Present { value: MissDigestUnseen } => false
    Present { value: MissDeclaredRefused } => false
    Absent => false
  }
}

// A BASE THAT ANSWERS NOTHING FOR THIS MEMBER IS AN ALL-MISS, NEVER A PASS. The identity is exact and the
// line set is well-formed but does not carry the member's digest, so the member is parsed and what is
// published is what THIS walk verified -- the shape that keeps a restored-but-useless base from being read
// as completeness.
test fn a_base_without_the_member_line_misses_it_and_publishes_its_own() -> Bool {
  let unrelated = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: "parse-verdict\tsome-other-digest\tfixture-compiler\tAccepted"))
  reuse_standing_is(reuse: unrelated, digest: fixture_source_digest, expected: MissDigestUnseen)
    && published_payloads_agree(
      cold: population_verdict_products(
        tally: population_parse_accepted(tally: reuse_tally(reuse: parse_verdict_reuse_off()), key: "dag:a/four.dag", source_digest: fixture_source_digest)
      ),
      warm: population_verdict_products(
        tally: population_parse_accepted(tally: reuse_tally(reuse: unrelated), key: "dag:a/four.dag", source_digest: fixture_source_digest)
      ),
      expected: held_parse_report_text()
    )
}

// THE ANCESTOR IS METADATA, NOT STANDING: two bases that differ ONLY in which ancestor they name decide the
// same standing for the same member. This is what makes the start commit a matter of hit rate and log
// honesty rather than soundness (the case the gate's comment claims, and the reason the force-push and
// batched-push residuals need no git-side guard to be safe).
test fn the_named_ancestor_changes_nothing_about_standing() -> Bool {
  let lines_text = reuse_receipts_text()
  let lines = Present { value: parse_verdict_receipt_lines(text: lines_text) }
  let one = ParseVerdictBase {
    ancestor: optional_present(value: "ancestor-one"),
    i_base: optional_present(value: fixture_compiler),
    receipt_lines: lines
  }
  let other = ParseVerdictBase {
    ancestor: Absent,
    i_base: optional_present(value: fixture_compiler),
    receipt_lines: lines
  }
  reuse_standing_is(reuse: parse_verdict_reuse_requested(base: one), digest: fixture_source_digest, expected: Reused)
    && reuse_standing_is(reuse: parse_verdict_reuse_requested(base: other), digest: fixture_source_digest, expected: Reused)
}

fn published_payloads_agree(cold: PopulationVerdictProducts, warm: PopulationVerdictProducts, expected: String) -> Bool {
  match cold.receipts {
    Absent => false
    Present { value: cold_body } => match warm.receipts {
      Absent => false
      Present { value: warm_body } => (cold_body == expected) && (warm_body == cold_body)
    }
  }
}

// THE PUBLISHED PAYLOAD IS THE ROUTE-INDEPENDENT PRODUCT: the same verdicts, read either way, publish the
// same bytes -- while the log line does move, because the walk with a base says what it reused.
fn published_payload_ignores_the_route(off: PopulationVerdictProducts, on: PopulationVerdictProducts, cold_expected: String, counts_line: String) -> Bool {
  match off.receipts {
    Absent => false
    // THE PUBLISHED BYTES DO NOT MOVE. The route changed; the artifact did not.
    Present { value: cold } => match on.receipts {
      Absent => false
      Present { value: warm } =>
        (cold == cold_expected)
          && (off.report.text == cold)
          && (off.report.held == true)
          && (warm == cold)
          && (on.report.held == true)
          // THE LOG LINE DOES MOVE: with a base read, the walk says what it reused.
          && (on.report.text == counts_line)
          && (on.report.text != cold)
    }
  }
}

// A HELD WALK WITH NO COMPILER HAS NO PAYLOAD TO PUBLISH, and Absent (not an empty string) is what makes
// the writer refuse instead of publishing a base of zero verdicts that a later run would read as complete.
test fn a_walk_with_no_compiler_offers_no_receipts_payload() -> Bool {
  let no_compiler = fold_list(
    xs: [JudgedParses { key: "dag:a/four.dag", source_digest: fixture_source_digest }],
    empty: begun(classes: []),
    cons: fn(acc, judgment) { judge(tally: acc, judgment: judgment) }
  )
  match population_verdict_products(tally: no_compiler).receipts {
    Absent => true
    Present { value: _ } => false
  }
}

// REUSE: the base the restore step left behind, built through the SAME crossing the verb reads it
// with (`parse_verdict_receipt_lines`), so a witness that supplies the text still executes the unfold.
fn reuse_receipts_text() -> String {
  concat(concat(held_parse_report_text(), "\n"), "parse-verdict\tother-digest\tfixture-compiler\tAccepted")
}

fn reuse_base(i_base: Optional<String>, text: Optional<String>) -> ParseVerdictReuse {
  parse_verdict_reuse_requested(base: ParseVerdictBase {
    ancestor: optional_present(value: "ancestor-sha"),
    i_base: i_base,
    receipt_lines: match text {
      Absent => Absent
      Present { value: t } => Present { value: parse_verdict_receipt_lines(text: t) }
    }
  })
}

fn reuse_tally(reuse: ParseVerdictReuse) -> PopulationParse {
  match population_parse_begin(classes: [], compiler: optional_present(value: fixture_compiler), reuse: reuse) {
    PopulationBegun { tally: tally } => tally
    PopulationDeclarationDuplicated { keys: _ } => begun(classes: [])
  }
}

fn reuse_standing_is(reuse: ParseVerdictReuse, digest: String, expected: ParseVerdictStanding) -> Bool {
  match population_parse_standing(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: digest) {
    Present { value: got } => got == expected
    Absent => false
  }
}

// POSITIVE CONTROL, ROUTE ASSERTED: the exact identity and a receipt line for this digest give the
// Reused standing, and counting it moves `reused`, not any miss.
test fn parse_verdict_exact_identity_hit_is_reused_holds() -> Bool {
  let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text()))
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: Reused)
    && parse_verdict_reuse_counts_text(
      counts: population_parse_counted(tally: reuse_tally(reuse: reuse), standing: population_parse_standing(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: fixture_source_digest)).reuse.counts
    ) == "parse-verdict reuse: ancestor=ancestor-sha reused=1 miss_identity_absent=0 miss_identity_mismatch=0 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
}

// RED: a different base identity refuses reuse even though the digest's line is present.
test fn parse_verdict_identity_mismatch_refuses_reuse_holds() -> Bool {
  let reuse = reuse_base(i_base: optional_present(value: "other-compiler"), text: optional_present(value: reuse_receipts_text()))
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: MissIdentityMismatch)
}

// An evicted or never-published entry is a typed miss on each blob, never Reused.
test fn parse_verdict_absent_entry_is_a_typed_miss_holds() -> Bool {
  reuse_standing_is(reuse: reuse_base(i_base: Absent, text: Absent), digest: fixture_source_digest, expected: MissIdentityAbsent)
    && reuse_standing_is(reuse: reuse_base(i_base: optional_present(value: fixture_compiler), text: Absent), digest: fixture_source_digest, expected: MissEntryAbsent)
}

// The restore chain chose the ancestor and left one record plus one pair of blobs; the verb reads
// them through the same functions `parse_verdict_base_read` uses, over supplied outcomes.
fn locator_reuse(record: FilesystemReadOutcome, identity: FilesystemReadOutcome) -> ParseVerdictReuse {
  parse_verdict_reuse_requested(base: parse_verdict_base_from(
    ancestor: parse_verdict_ancestor_from(record: record),
    identity: identity,
    receipts: FilesystemReadSucceeded { content: reuse_receipts_text() }
  ))
}

fn locator_counts_text(reuse: ParseVerdictReuse) -> String {
  parse_verdict_reuse_counts_text(
    counts: population_parse_counted(
      tally: reuse_tally(reuse: reuse),
      standing: population_parse_standing(tally: reuse_tally(reuse: reuse), key: "dag:a/four.dag", source_digest: fixture_source_digest)
    ).reuse.counts
  )
}

// POSITIVE CONTROL, ROUTE ASSERTED: the restore chain recorded the second ancestor with the exact
// identity. That entry is the one reused, and the counts line names it.
test fn parse_verdict_locator_reuses_the_first_published_ancestor_holds() -> Bool {
  let reuse = locator_reuse(record: FilesystemReadSucceeded { content: "sha-2\n" }, identity: FilesystemReadSucceeded { content: fixture_compiler })
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: Reused)
    && locator_counts_text(reuse: reuse) == "parse-verdict reuse: ancestor=sha-2 reused=1 miss_identity_absent=0 miss_identity_mismatch=0 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
}

// RED: the chosen entry has another identity. It refuses reuse and counts the mismatch against the
// ancestor it came from; the workflow never offers a nearer match (see the restore witnesses).
test fn parse_verdict_locator_does_not_fall_through_a_mismatched_ancestor_holds() -> Bool {
  let reuse = locator_reuse(record: FilesystemReadSucceeded { content: "sha-1\n" }, identity: FilesystemReadSucceeded { content: "other-compiler" })
  reuse_standing_is(reuse: reuse, digest: fixture_source_digest, expected: MissIdentityMismatch)
    && locator_counts_text(reuse: reuse) == "parse-verdict reuse: ancestor=sha-1 reused=0 miss_identity_absent=0 miss_identity_mismatch=1 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
}

// Nothing restored (no record, no identity) is a typed miss naming no ancestor; an empty record does too.
test fn parse_verdict_locator_with_no_published_ancestor_is_a_typed_miss_holds() -> Bool {
  let missing = locator_reuse(record: FilesystemReadRefused { error: "no record" }, identity: FilesystemReadRefused { error: "no entry" })
  let empty = locator_reuse(record: FilesystemReadSucceeded { content: "\n" }, identity: FilesystemReadRefused { error: "no entry" })
  reuse_standing_is(reuse: missing, digest: fixture_source_digest, expected: MissIdentityAbsent)
    && locator_counts_text(reuse: missing) == "parse-verdict reuse: ancestor=none reused=0 miss_identity_absent=1 miss_identity_mismatch=0 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
    && locator_counts_text(reuse: empty) == "parse-verdict reuse: ancestor=none reused=0 miss_identity_absent=1 miss_identity_mismatch=0 miss_entry_absent=0 miss_digest_unseen=0 miss_declared_refused=0"
}

// A changed module (digest not in the restored set) re-parses.
test fn parse_verdict_unseen_digest_is_a_typed_miss_holds() -> Bool {
  reuse_standing_is(
    reuse: reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text())),
    digest: "edited-digest",
    expected: MissDigestUnseen
  )
}

// A module the declaration names refused has a matching stored line, yet reuse is withheld under its
// OWN standing: counting it as an unseen digest would send a reader looking for a missing receipt.
test fn parse_verdict_declared_refused_module_is_its_own_miss_holds() -> Bool {
  let reuse = reuse_base(i_base: optional_present(value: fixture_compiler), text: optional_present(value: reuse_receipts_text()))
  match population_parse_begin(
    classes: [RefusalClass { drop: "fixture_drop_a", cause: "parse_g0_tokens_remain", keys: ["dag:a/four.dag"] }],
    compiler: optional_present(value: fixture_compiler),
    reuse: reuse
  ) {
    PopulationBegun { tally: tally } =>
      match population_parse_standing(tally: tally, key: "dag:a/four.dag", source_digest: fixture_source_digest) {
        Present { value: got } => got == MissDeclaredRefused
        Absent => false
      }
    PopulationDeclarationDuplicated { keys: _ } => false
  }
}

// Reuse off yields no standing at all: every module parses, as before.
test fn parse_verdict_reuse_off_has_no_standing_holds() -> Bool {
  match population_parse_standing(tally: reuse_tally(reuse: parse_verdict_reuse_off()), key: "k", source_digest: fixture_source_digest) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE SPELLING SELECTION IS A SUPERSET, AND THE CONTROLS SAY WHICH WAY: a comment that only mentions the name is
// SELECTED (no binding is claimed), a module that writes it as code is selected, and a module that writes neither
// is not. A selection that dropped the comment-only module would be claiming a binding-level fact it cannot see.
test fn a_comment_only_mention_of_a_ruled_spelling_is_selected_holds() -> Bool {
  spelled_in(content: "module m\n// chars is mentioned here only\n", names: ["chars"])
}

test fn a_module_writing_a_ruled_spelling_as_code_is_selected_holds() -> Bool {
  spelled_in(content: "module m\nfn f(s: String) -> Int { length(xs: chars(s: s)) }\n", names: ["chars"])
}

test fn a_module_spelling_no_ruled_name_is_not_selected_holds() -> Bool {
  !spelled_in(content: "module m\nfn f(s: String) -> Int { 1 }\n", names: ["chars"])
}

test fn a_selection_over_no_ruled_names_selects_nothing_holds() -> Bool {
  !spelled_in(content: "module m\n// chars\n", names: [])
}

test fn a_selection_reports_the_selected_names_and_holds() -> Bool {
  let report = select_spelled_report(selection: SpelledSelected { names: ["a.m1", "a.m2"] })
  report.held && report.text == "a.m1\na.m2"
}

test fn an_unreadable_module_refuses_the_whole_selection_holds() -> Bool {
  let report = select_spelled_report(selection: SpelledRefused { module: "a.m3", cause: "unreadable" })
  !report.held && report.text == "a.m3: unreadable"
}

// THE DECLARED COUNTS SHAPE IS BOUND TO THE PRINTED LINE, BYTE FOR BYTE. The fleet's reuse walk reads
// this line back and its only contract on it is a shell exit code, so the field set IS the contract
// (gunbc.recurring_failure_mode.instruction_and_subject_resolved_from_different_revisions, silent arm:
// four PR runs printed the six-field shape with no ancestor= under the NEW workflow and exited green with
// reused=0). gunbc.witness.compiler_gate_contract_stamp hashes these rows, so if the verb printed a field
// the rows omitted -- or stopped printing one -- the stamp would go on certifying a contract nobody has,
// and the guard built on it would pass a stale subject. That is a silent-green of exactly the kind this
// class records, smuggled into the mitigation, so the binding is a witness and not a comment.
test fn parse_verdict_counts_shape_matches_declared_rows_holds() -> Bool {
  let printed = parse_verdict_reuse_counts_text(
    counts: ParseVerdictReuseCounts {
      ancestor: "ancestor-sha",
      reused: 1,
      miss_identity_absent: 2,
      miss_identity_mismatch: 3,
      miss_entry_absent: 4,
      miss_digest_unseen: 5,
      miss_declared_refused: 6
    }
  )
  // THE BINDING IS EXACT, AND IT RUNS BOTH WAYS. Equality against the full printed line catches a
  // renamed, reordered, dropped or ADDED field; the occurrence fold catches the other direction, where
  // somebody edits the rows to match a print that had drifted away from them. Either way the stamp can
  // only certify a shape the verb actually prints.
  printed ==
    "parse-verdict reuse: ancestor=ancestor-sha reused=1 miss_identity_absent=2 miss_identity_mismatch=3 miss_entry_absent=4 miss_digest_unseen=5 miss_declared_refused=6"
    && string_contains(s: printed, pattern: parse_verdict_reuse_counts_prefix)
    && for_all(
      parse_verdict_reuse_counts_field_names(),
      label => string_contains(s: printed, pattern: join([" ", label, "="], ""))
    )
}

// The parse stage's located refusal reaches the population report: the line:col rides after the cause.
test fn a_located_undeclared_refusal_reports_its_line_and_column() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/five.dag", cause: "parse_data_value_missing_after_eq", at: Present { value: "3:13" })
  (length(xs: tally.refusals) == 1)
    && (first_refusal(tally: tally) == "dag:a/five.dag: parse_data_value_missing_after_eq at 3:13")
}

test fn an_unlocated_undeclared_refusal_reports_the_cause_alone() -> Bool {
  let tally = population_parse_refused(tally: begun(classes: fixture_classes), key: "dag:a/five.dag", cause: "parse_data_value_missing_after_eq", at: Absent)
  (length(xs: tally.refusals) == 1)
    && (first_refusal(tally: tally) == "dag:a/five.dag: parse_data_value_missing_after_eq")
}
