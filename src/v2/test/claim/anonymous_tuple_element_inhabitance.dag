module v2.test.claim.anonymous_tuple_element_inhabitance

import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.refinement_discharge { infer_and_discharge }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model }
import std.algebra { Cons, Empty }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import v2.std.node { Symbol }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: a collection whose ELEMENT is a tuple produced by a generic (an enumerate) inhabits a declared
// collection type only when the element does. The seed admits it (gunbc.recurring_failure_mode
// declared_type_wall_keyed_on_the_value_being_a_kernel, the anonymous-tuple receipt): `ys |> enumerate`
// is ACCEPTED where `List<String>` is declared, and as the first argument of a generic whose element
// another argument fixes at Int. This claim is the v2 side of that receipt: v2 refuses both by a
// positive judgment and accepts both controls.
//
// ROUTE: source text assembled through assemble_program_from_ingest (lowering and resolve run for
// real), then infer_and_discharge, over two modules: `pa` declares the sequence, the pair, the
// enumerate and the two consumers, and `pb` calls them.
//
// DISCRIMINATION: each wrong call differs from its control only in the element (Pair<Int, Bool> in
// place of Bool), and the controls infer clean, so the refusals are about the element and not about
// the harness.

fn tuple_witness(src: String, path: String, cu: Symbol) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: src, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: cu, file_path: path },
    compilation_unit: cu,
    source_root: V2Tree
  }
}

fn tuple_program(body: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: tuple_witness(
        src: "module pa\n\ntype Seq<T> = Nil | More { head: T, tail: Seq<T> }\n\ntype Pair<A, B> { first: A, second: B }\n\nfn produce_b() -> Seq<Bool> { More { head: true, tail: Nil } }\n\nfn enumerate1<T>(xs: Seq<T>) -> Seq<Pair<Int, T>> { match xs { Nil => Nil  More { head: h, tail: _ } => More { head: Pair { first: 0, second: h }, tail: Nil } } }\n\nfn want_bools(xs: Seq<Bool>) -> Int { 0 }\n\nfn same_element<T>(xs: Seq<T>, probe: T) -> Int { 0 }\n",
        path: "src/v2/pa.dag",
        cu: ^anonymous_tuple_element_pa_cu
      ),
      tail: Cons {
        head: tuple_witness(
          src: concat("module pb\n\nimport pa { More, Nil, Pair, Seq, enumerate1, produce_b, same_element, want_bools }\n\nfn g() -> Int { ", concat(body, " }\n")),
          path: "src/v2/pb.dag",
          cu: ^anonymous_tuple_element_pb_cu
        ),
        tail: Empty
      }
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^pb, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}

fn tuple_infers(body: String) -> Bool {
  match tuple_program(body: body) {
    Rejected { diagnostics: _ } => false
    Accepted { value: resolved, diagnostics: _ } =>
      match infer_and_discharge(tree: resolved) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

fn tuple_refuses_at_infer_with(body: String, reason: Symbol) -> Bool {
  match tuple_program(body: body) {
    Rejected { diagnostics: _ } => false
    Accepted { value: resolved, diagnostics: _ } =>
      match infer_and_discharge(tree: resolved) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d) == reason
      }
  }
}

// (0) CONTROLS: the same consumers with a Seq<Bool> argument infer clean, so a refusal below is about
// the element.
test fn the_bool_element_controls_infer() -> Bool {
  tuple_infers(body: "want_bools(xs: produce_b())") && tuple_infers(body: "same_element(xs: produce_b(), probe: true)")
}

// (1) A SEQUENCE OF PAIRS DOES NOT INHABIT A DECLARED SEQUENCE OF BOOL. The seed admits this shape.
test fn a_tuple_element_does_not_inhabit_a_declared_bool_element() -> Bool {
  tuple_refuses_at_infer_with(body: "want_bools(xs: enumerate1(xs: produce_b()))", reason: ^application_argument_does_not_inhabit)
}

// (2) A GENERIC WHOSE ELEMENT ANOTHER ARGUMENT FIXES REFUSES THE PAIR ELEMENT.
test fn a_tuple_element_does_not_bind_a_generic_fixed_at_int() -> Bool {
  tuple_refuses_at_infer_with(body: "same_element(xs: enumerate1(xs: produce_b()), probe: 3)", reason: ^application_argument_does_not_inhabit)
}
