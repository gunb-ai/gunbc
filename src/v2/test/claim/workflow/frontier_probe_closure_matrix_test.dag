module v2.test.workflow.frontier_probe_closure_matrix

import v2.compiler.self_host.frontier_probe {
  FrontierProbeIngestSubject,
  frontier_probe_closure_count_mismatch_reason,
  frontier_probe_closure_refs_digest_mismatch_reason,
  frontier_probe_closure_storage_hash_conflict_reason,
  frontier_probe_discovered_closure_subject_for_matrix,
  frontier_probe_entry_binding_refused_reason,
  frontier_probe_receipt_for_subject
}
import v2.compiler.self_host.frontier_probe_types {
  FrontierProbeClosurePopulationRefused,
  FrontierProbeCoverageRefused
}
import v2.compiler.source_authority {
  DiscoveredSourceRefsDigest,
  FrontierProbeDiscoveredClosure,
  SourceRef,
  SourceRootCoverage,
  SourceRootCoverageComplete,
  SourceRootManifestAbsent,
  SourceRootManifestElided,
  SourceRootRowsMissing,
  content_hash_of_value,
  discovered_source_refs_digest_for_refs,
  frontier_probe_discovered_closure_seal
}
import v2.std.cross_tree.import_model { DagTree }
import std.algebra { Cons, Empty }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fp_matrix_synthetic_ref(path: String, hash_seed: String) -> SourceRef {
  SourceRef {
    path: path,
    source_root: DagTree,
    content_hash: content_hash_of_value(value: hash_seed as NonEmptyStr)
  }
}

fn fp_matrix_ref_a() -> SourceRef {
  fp_matrix_synthetic_ref(path: "dag/std/algebra.dag", hash_seed: "fp-matrix-ref-a")
}

fn fp_matrix_ref_b() -> SourceRef {
  fp_matrix_synthetic_ref(path: "dag/std/types.dag", hash_seed: "fp-matrix-ref-b")
}

fn fp_matrix_closure_subject_matching_digest(
  refs: List<SourceRef>,
  coverage: SourceRootCoverage,
  ingest_read_count: Int,
  entry: SourceRef
) -> FrontierProbeIngestSubject {
  frontier_probe_discovered_closure_subject_for_matrix(
    closure: frontier_probe_discovered_closure_seal(refs: refs, entry: entry),
    coverage: coverage,
    ingest_read_count: ingest_read_count
  )
}

fn fp_matrix_duplicate_closure_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_ref_a(), tail: Empty }
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 2,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_entry_not_in_refs_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 1,
    entry: fp_matrix_ref_b()
  )
}

fn fp_matrix_count_mismatch_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_ref_b(), tail: Empty }
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 3,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_rows_missing_coverage_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootRowsMissing {
      read_count: 5,
      produced_row_count: 0
    },
    ingest_read_count: 1,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_manifest_absent_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootManifestAbsent,
    ingest_read_count: 1,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_elided_incomplete_refs_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootManifestElided { read_count: 91, cap: 64 },
    ingest_read_count: 1,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_wrong_hash_ref() -> SourceRef {
  fp_matrix_synthetic_ref(path: "dag/std/algebra.dag", hash_seed: "wrong-hash-bytes")
}

fn fp_matrix_storage_hash_conflict_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_wrong_hash_ref(), tail: Empty }
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 2,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_substituted_refs_digest() -> DiscoveredSourceRefsDigest {
  discovered_source_refs_digest_for_refs(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_ref_a(), tail: Empty }
    }
  )
}

fn fp_matrix_forged_closure_subject() -> FrontierProbeIngestSubject {
  frontier_probe_discovered_closure_subject_for_matrix(
    closure: FrontierProbeDiscoveredClosure {
      refs: Cons {
        head: fp_matrix_ref_a(),
        tail: Cons { head: fp_matrix_ref_b(), tail: Empty }
      },
      population_digest: fp_matrix_substituted_refs_digest(),
      entry: fp_matrix_ref_a()
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 2
  )
}

test fn frontier_probe_closure_storage_duplicate_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_duplicate_closure_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_entry_binding_refused_reason
    _ => false
  }
}

test fn frontier_probe_closure_entry_binding_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_entry_not_in_refs_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_entry_binding_refused_reason
    _ => false
  }
}

test fn frontier_probe_closure_count_mismatch_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_count_mismatch_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_closure_count_mismatch_reason
    _ => false
  }
}

test fn frontier_probe_closure_refs_digest_mismatch_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_forged_closure_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_closure_refs_digest_mismatch_reason
    _ => false
  }
}

test fn frontier_probe_coverage_rows_missing_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_rows_missing_coverage_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: coverage } =>
      match coverage {
        SourceRootRowsMissing { read_count: 5, produced_row_count: 0 } => true
        _ => false
      }
    _ => false
  }
}

test fn frontier_probe_coverage_manifest_absent_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_manifest_absent_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: coverage } =>
      match coverage {
        SourceRootManifestAbsent => true
        _ => false
      }
    _ => false
  }
}

test fn frontier_probe_elided_incomplete_refs_coverage_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_elided_incomplete_refs_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: coverage } =>
      match coverage {
        SourceRootManifestElided { read_count: 91, cap: 64 } => true
        _ => false
      }
    _ => false
  }
}

test fn frontier_probe_storage_hash_conflict_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_storage_hash_conflict_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_closure_storage_hash_conflict_reason
    _ => false
  }
}
