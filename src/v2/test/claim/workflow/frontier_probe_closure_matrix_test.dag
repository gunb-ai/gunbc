module v2.test.workflow.frontier_probe_closure_matrix

import v2.compiler.self_host.frontier_probe {
  FrontierProbeIngestSubject,
  FrontierProbeReferencedClosure,
  frontier_probe_closure_count_mismatch_reason,
  frontier_probe_closure_refs_digest_mismatch_reason,
  frontier_probe_closure_storage_duplicate_reason,
  frontier_probe_closure_storage_hash_conflict_reason,
  frontier_probe_entry_binding_refused_reason,
  frontier_probe_receipt_for_subject
}
import v2.compiler.self_host.frontier_probe_types {
  FrontierProbeClosurePopulationRefused,
  FrontierProbeCoverageRefused,
  FrontierProbeDetailAbsent,
  SourceRefContentHashMismatch,
  SourceRefReadRefused
}
import v2.compiler.source_authority {
  DagTree,
  SourceRef,
  SourceRootCoverage,
  SourceRootCoverageComplete,
  SourceRootManifestAbsent,
  SourceRootManifestElided,
  SourceRootRowsMissing,
  content_hash_of_value,
  source_ref_for_storage_path,
  source_ref_list_digest
}
import std.algebra { Cons, Empty }
import std.content_hash { Fnv1a64Structural }
import v2.std.collection { List }
import v2.std.logic { Bool }

fn fp_matrix_ref_a() -> SourceRef {
  source_ref_for_storage_path(path: "dag/std/algebra.dag")
}

fn fp_matrix_ref_b() -> SourceRef {
  source_ref_for_storage_path(path: "dag/std/types.dag")
}

fn fp_matrix_ref_v2() -> SourceRef {
  source_ref_for_storage_path(path: "src/v2/std/text.dag")
}

fn fp_matrix_closure_subject(
  refs: List<SourceRef>,
  coverage: SourceRootCoverage,
  ingest_read_count: Int,
  entry: SourceRef,
  discovered_source_refs_digest: Fnv1a64Structural
) -> FrontierProbeIngestSubject {
  FrontierProbeReferencedClosure {
    refs: refs,
    coverage: coverage,
    ingest_read_count: ingest_read_count,
    discovered_source_refs_digest: discovered_source_refs_digest,
    entry: entry
  }
}

fn fp_matrix_closure_subject_matching_digest(
  refs: List<SourceRef>,
  coverage: SourceRootCoverage,
  ingest_read_count: Int,
  entry: SourceRef
) -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject(
    refs: refs,
    coverage: coverage,
    ingest_read_count: ingest_read_count,
    entry: entry,
    discovered_source_refs_digest: source_ref_list_digest(refs: refs)
  )
}

fn fp_matrix_duplicate_closure_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_ref_a(), tail: Empty }
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 2,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_entry_not_in_refs_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 1,
    entry: fp_matrix_ref_b()
  )
}

fn fp_matrix_count_mismatch_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_ref_b(), tail: Empty }
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 3,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_rows_missing_coverage_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootRowsMissing {
      read_count: 5,
      produced_row_count: 0
    },
    ingest_read_count: 1,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_manifest_absent_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootManifestAbsent,
    ingest_read_count: 1,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_elided_incomplete_refs_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootManifestElided { read_count: 91, cap: 64 },
    ingest_read_count: 91,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_elided_complete_refs_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_ref_b(), tail: Empty }
    },
    coverage: SourceRootManifestElided { read_count: 2, cap: 64 },
    ingest_read_count: 2,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_below_cap_complete_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Empty
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 1,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_second_root_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_ref_v2(), tail: Empty }
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 2,
    entry: fp_matrix_ref_v2()
  )
}

fn fp_matrix_missing_path_ref() -> SourceRef {
  SourceRef {
    path: "dag/nonexistent_fp_matrix_probe_path.dag",
    source_root: DagTree,
    content_hash: content_hash_of_value(value: "missing-path" as NonEmptyStr)
  }
}

fn fp_matrix_read_failure_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_missing_path_ref(),
      tail: Empty
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 1,
    entry: fp_matrix_missing_path_ref()
  )
}

fn fp_matrix_wrong_hash_ref() -> SourceRef {
  SourceRef {
    path: "dag/std/algebra.dag",
    source_root: DagTree,
    content_hash: content_hash_of_value(value: "wrong-hash-bytes" as NonEmptyStr)
  }
}

fn fp_matrix_hash_mismatch_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_wrong_hash_ref(),
      tail: Empty
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 1,
    entry: fp_matrix_wrong_hash_ref()
  )
}

fn fp_matrix_storage_hash_conflict_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject_matching_digest(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_wrong_hash_ref(), tail: Empty }
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 2,
    entry: fp_matrix_ref_a()
  )
}

fn fp_matrix_substituted_refs_subject() -> FrontierProbeIngestSubject {
  fp_matrix_closure_subject(
    refs: Cons {
      head: fp_matrix_ref_a(),
      tail: Cons { head: fp_matrix_ref_b(), tail: Empty }
    },
    coverage: SourceRootCoverageComplete,
    ingest_read_count: 2,
    entry: fp_matrix_ref_a(),
    discovered_source_refs_digest: source_ref_list_digest(
      refs: Cons {
        head: fp_matrix_ref_a(),
        tail: Cons { head: fp_matrix_ref_a(), tail: Empty }
      }
    )
  )
}

test fn frontier_probe_closure_storage_duplicate_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_duplicate_closure_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_closure_storage_duplicate_reason
    _ => false
  }
}

test fn frontier_probe_closure_entry_binding_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_entry_not_in_refs_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_entry_binding_refused_reason
    _ => false
  }
}

test fn frontier_probe_closure_count_mismatch_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_count_mismatch_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_closure_count_mismatch_reason
    _ => false
  }
}

test fn frontier_probe_closure_refs_digest_mismatch_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_substituted_refs_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_closure_refs_digest_mismatch_reason
    _ => false
  }
}

test fn frontier_probe_coverage_rows_missing_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_rows_missing_coverage_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: coverage } =>
      match coverage {
        SourceRootRowsMissing { read_count: 5, produced_row_count: 0 } => true
        _ => false
      }
    _ => false
  }
}

test fn frontier_probe_coverage_manifest_absent_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_manifest_absent_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: coverage } =>
      match coverage {
        SourceRootManifestAbsent => true
        _ => false
      }
    _ => false
  }
}

test fn frontier_probe_elided_incomplete_refs_coverage_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_elided_incomplete_refs_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: coverage } =>
      match coverage {
        SourceRootManifestElided { read_count: 91, cap: 64 } => true
        _ => false
      }
    _ => false
  }
}

test fn frontier_probe_below_cap_complete_passes_population_gate_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_below_cap_complete_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: _ } => false
    FrontierProbeClosurePopulationRefused { cause: _ } => false
    _ => true
  }
}

test fn frontier_probe_elided_complete_refs_passes_population_gate_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_elided_complete_refs_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: _ } => false
    FrontierProbeClosurePopulationRefused { cause: _ } => false
    _ => true
  }
}

test fn frontier_probe_second_source_root_passes_population_gate_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_second_root_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeCoverageRefused { coverage: _ } => false
    FrontierProbeClosurePopulationRefused { cause: _ } => false
    _ => true
  }
}

test fn frontier_probe_read_failure_detail_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_read_failure_subject(),
    fixture_module_path: ""
  ).detail {
    SourceRefReadRefused { source_ref: _, error: _ } => true
    _ => false
  }
}

test fn frontier_probe_hash_mismatch_detail_carries_observed_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_hash_mismatch_subject(),
    fixture_module_path: ""
  ).detail {
    SourceRefContentHashMismatch { source_ref: _, expected: _, observed: _ } => true
    _ => false
  }
}

test fn frontier_probe_storage_hash_conflict_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_matrix_storage_hash_conflict_subject(),
    fixture_module_path: ""
  ).detail {
    FrontierProbeClosurePopulationRefused { cause: cause } =>
      cause == frontier_probe_closure_storage_hash_conflict_reason
    _ => false
  }
}
