module v2.test.workflow.frontier_probe_closure_readthrough

import v2.compiler.self_host.frontier_probe {
  FrontierProbeIngestSubject,
  frontier_probe_discovered_closure_subject_for_matrix,
  frontier_probe_receipt_for_subject
}
import v2.compiler.self_host.frontier_probe_types {
  SourceRefContentHashMismatch,
  SourceRefReadRefused
}
import v2.compiler.source_authority {
  SourceRef,
  SourceRootCoverageComplete,
  content_hash_of_value,
  frontier_probe_discovered_closure_seal
}
import v2.std.cross_tree.import_model { DagTree }
import std.algebra { Cons, Empty }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn fp_readthrough_closure_subject_matching_digest(
  refs: List<SourceRef>,
  ingest_read_count: Int,
  entry: SourceRef
) -> FrontierProbeIngestSubject {
  frontier_probe_discovered_closure_subject_for_matrix(
    closure: frontier_probe_discovered_closure_seal(refs: refs, entry: entry),
    coverage: SourceRootCoverageComplete,
    ingest_read_count: ingest_read_count
  )
}

fn fp_readthrough_missing_path_ref() -> SourceRef {
  SourceRef {
    path: "dag/nonexistent_fp_matrix_probe_path.dag",
    source_root: DagTree,
    content_hash: content_hash_of_value(value: "missing-path" as NonEmptyStr)
  }
}

fn fp_readthrough_read_failure_subject() -> FrontierProbeIngestSubject {
  fp_readthrough_closure_subject_matching_digest(
    refs: Cons {
      head: fp_readthrough_missing_path_ref(),
      tail: Empty
    },
    ingest_read_count: 1,
    entry: fp_readthrough_missing_path_ref()
  )
}

fn fp_readthrough_wrong_hash_ref() -> SourceRef {
  SourceRef {
    path: "dag/std/algebra.dag",
    source_root: DagTree,
    content_hash: content_hash_of_value(value: "wrong-hash-bytes" as NonEmptyStr)
  }
}

fn fp_readthrough_hash_mismatch_subject() -> FrontierProbeIngestSubject {
  fp_readthrough_closure_subject_matching_digest(
    refs: Cons {
      head: fp_readthrough_wrong_hash_ref(),
      tail: Empty
    },
    ingest_read_count: 1,
    entry: fp_readthrough_wrong_hash_ref()
  )
}

test fn frontier_probe_read_failure_detail_refused_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_readthrough_read_failure_subject(),
    fixture_module_path: ""
  ).detail {
    SourceRefReadRefused { source_ref: _, error: _ } => true
    _ => false
  }
}

test fn frontier_probe_hash_mismatch_detail_carries_observed_holds() -> Bool {
  match frontier_probe_receipt_for_subject(
    subject: fp_readthrough_hash_mismatch_subject(),
    fixture_module_path: ""
  ).detail {
    SourceRefContentHashMismatch { source_ref: _, expected: _, observed: _ } => true
    _ => false
  }
}
