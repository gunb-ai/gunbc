module v2.test.workflow.host_module_binding_manifest

import v2.compiler.source_authority { ModuleStorageIndex }
import std.algebra { Empty }
import v2.std.integer { Int }
import v2.std.text { String }

data host_module_binding_manifest_note: String = "COMMITTED STUB for the module-binding supply carrier — the host handler for the .dag-modeled op v2.compiler.source_authority.module_storage_bindings_for_source_roots. The real rows are emitted at run time by discover_source_root_ingest --emit-module-binding-manifest into a later source root, which overlays this file; the stub exists so consumers always RESOLVE (the same posture as v2.test.workflow.host_source_root_ingest_manifest). Rows are ParsedFromSource: the producer routes through v1_compiler_parse (task 4 repoint), not a substring scan. Unlike the source-root ingest manifest this carrier holds NO source text — module <-> path + provenance only — which is why it is not bounded by that manifest's corpus-protection inline cap and can carry the whole tree (measured: 1156 rows for src/v2 alone)."

data host_module_binding_count: Int = 0

data host_module_bindings: ModuleStorageIndex = Empty
