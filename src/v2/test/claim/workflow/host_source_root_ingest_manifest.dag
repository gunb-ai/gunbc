module v2.test.workflow.host_source_root_ingest_manifest

import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
}
import v2.compiler.source_authority {
  SourceRootIngest,
  SourceRootProvenanceCoverageReceipt,
}
import v2.std.algebra { Empty }
import v2.std.qualified_name { QnCons, QnEmpty }
import v2.std.text { String }

data host_source_root_ingest_content_hash: String = ""

data host_source_root_ingest_coverage_receipt: SourceRootProvenanceCoverageReceipt = SourceRootProvenanceCoverageReceipt {
  ingest_read_count: 0,
  produced_row_count: 0,
  coverage_complete: false
}

data host_source_root_ingest: SourceRootIngest = Empty

// Compile stub — runtime overlay replaces with entry-parsed admission from discover_source_root_ingest.
// Admission QN authority: 00_compile.dag entry source; runtime pin is discover_source_root_ingest
//   parse_source_root_entry_admission (emitted as host_compiler_closure_admission in the manifest).
data host_compiler_closure_admission: Admission = Admission {
  subject: ResolutionSubject {
    name: QnCons {
      head: ^v2,
      tail: QnCons { head: ^compiler, tail: QnCons { head: ^compile, tail: QnEmpty } }
    }
  },
  imports: Empty
}
