module v2.test.workflow.host_source_root_ingest_manifest

import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
}
import v2.compiler.source_authority {
  DiscoveredSourceRefsDigestNoRefList,
  DiscoveredSourceRefsDigestUnavailable,
  SourceRef,
  SourceRootIngest,
  SourceRootManifestAbsent,
  SourceRootProvenanceCoverageReceipt,
}
import std.algebra { Cons, Empty }
import std.content_hash { Fnv1a64, Fnv1a64Structural }
import v2.std.collection { List }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.text { String }

data host_source_root_ingest_content_hash: String = ""

data host_source_root_ingest_coverage_receipt: SourceRootProvenanceCoverageReceipt = SourceRootProvenanceCoverageReceipt {
  ingest_read_count: 0,
  produced_row_count: 0,
  discovered_source_refs_digest: DiscoveredSourceRefsDigestUnavailable {
    cause: DiscoveredSourceRefsDigestNoRefList {
      reason: "committed-stub-no-host-manifest"
    }
  },
  coverage: SourceRootManifestAbsent
}

data host_source_root_ingest: SourceRootIngest = Empty

data host_source_root_closure_refs: List<SourceRef> = Empty

data host_compiler_closure_admission: Admission = Admission {
  subject: ResolutionSubject {
    name: Cons {
      head: ^v2,
      tail: Cons { head: ^compiler, tail: Cons { head: ^compile, tail: Empty } }
    }
  },
  imports: Empty
}

data frontier_probe_entry_source_ref: SourceRef = SourceRef {
  path: "",
  source_root: DagTree,
  content_hash: Fnv1a64(Fnv1a64Structural { digest: "0000000000000000" })
}

data frontier_probe_entry_module_path: String = ""

data realization_sweep_entry_identities: List<String> = []
