module v2.test.workflow.source_root_overflow_never_empty_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// RED control: pre-capless elision with produced_row_count 0 and empty refs must refuse.
test fn source_root_overflow_empty_population_old_defect_refused_holds() -> Bool {
  let bad_receipt = v2.compiler.source_authority.SourceRootProvenanceCoverageReceipt {
    ingest_read_count: 165,
    produced_row_count: 0,
    discovered_source_refs_digest: v2.compiler.source_authority.DiscoveredSourceRefsDigestUnavailable {
      cause: v2.compiler.source_authority.DiscoveredSourceRefsDigestNoRefList { reason: "substrate-red-control" }
    },
    coverage: v2.compiler.source_authority.SourceRootManifestElided { read_count: 165, cap: manifest_inline_list_max }
  }
  !source_root_overflow_never_empty_population_holds(
    receipt: bad_receipt,
    refs: v2.std.algebra.Empty
  )
}
