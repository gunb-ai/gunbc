module v2.test.workflow.source_root_overflow_never_empty_witness

import v2.compiler.source_authority {
  SourceRootManifestElided,
  SourceRootProvenanceCoverageReceipt,
  DiscoveredSourceRefsDigestUnavailable,
  DiscoveredSourceRefsDigestNoRefList,
  manifest_inline_list_max,
  source_root_overflow_never_empty_population_holds
}
import v2.std.algebra { Empty }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data source_root_overflow_never_empty_witness_note: String = "Substrate RED control: the pre-capless defect produced SourceRootManifestElided with produced_row_count 0 and an empty ref population — the empty-observation narrow. source_root_overflow_never_empty_population_holds must refuse that shape."

test fn source_root_overflow_empty_population_old_defect_refused_holds() -> Bool {
  let bad_receipt = SourceRootProvenanceCoverageReceipt {
    ingest_read_count: 165,
    produced_row_count: 0,
    discovered_source_refs_digest: DiscoveredSourceRefsDigestUnavailable {
      cause: DiscoveredSourceRefsDigestNoRefList { reason: "substrate-red-control" }
    },
    coverage: SourceRootManifestElided { read_count: 165, cap: manifest_inline_list_max }
  }
  !source_root_overflow_never_empty_population_holds(
    receipt: bad_receipt,
    refs: Empty
  )
}
