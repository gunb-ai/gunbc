module v2.test.claim.argv_word_construction.census_test

// Claims for the typed-argv construction census (the debt paydown instrument).
//
// What CI CAN hold: the lens mechanics on a controlled fixture read and parsed inside the claim,
// the modeled-roots boundary (a typed refusal, never a silent zero), the established route on a
// small in-roots module, the site-class routing, the roster gates on constructed rows, and the
// committed instrument's contract over exactly the roster's own modules.
//
// What CI CANNOT hold: a whole-corpus walk inside one witness (parsing hundreds of modules
// exceeds the witness budget). The corpus recount is the committed instrument's own emitter,
// argv_word_construction_census_recount / _recount_emit, run on a wet lane; the committed roster
// in gunbc.instruments.argv_word_construction_census is filled from that output, and the
// bounded-contract claim below re-walks exactly the roster's modules, so the gates stay executed
// in CI at whatever size the roster is.

import v2.lens.argv_word_construction {
  ArgvWordsFact,
  ArgvWordsSiteClass,
  ArgvWordsRosterRow,
  ArgvWordsSite,
  DataDecl,
  ExtdepsInterfaceBuilder,
  FnDecl,
  WorkflowCallSite,
  ArgvWordsModuleEstablished,
  ArgvWordsModuleRefused,
  RawTreeEstablished,
  RawTreeNotEstablished,
  argv_word_construction_gates,
  argv_word_construction_module_sites,
  argv_word_construction_rows_resolve,
  argv_word_construction_census_covers,
  argv_word_construction_roster_shrinks,
  argv_word_construction_site_named,
  site_class_of,
  facts_of,
  is_census_member,
  raw_tree_of_text
}
import gunbc.instruments.argv_word_construction_census {
  argv_word_construction_census_live,
  argv_word_construction_census_check_paths,
  argv_word_construction_census_roster,
  argv_word_construction_census_roster_modules
}
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.algebra { fold_list, length }
import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.optional { Absent, Present }
import std.process { ExitSuccess, ProcessExit, ExitFailure }

// A real module file under the declared src/v2 root (claim_batch's filesystem is confined to the
// declared source roots), read and parsed INSIDE the claims that exercise the lens mechanics. Its
// declared module name (fixture.argv_word_construction.host_words) is unique in the tree, so
// loading it does not fork the namespace. It sits OUTSIDE the modeled census roots, which the
// boundary claim below pins as a typed refusal.
data fixture_path: String = "src/v2/test/fixture_roots/argv_word_construction/host_words.dag"

// The modeled-roots specimen, used only through the pure class router (no parse in CI).
data specimen_path: String = "dag/extdeps/systemd/systemd_run.dag"
data specimen_workflow_path: String = "dag/gunbc/compute/work_provider_local.dag"

// A small module inside the modeled roots with no argv debt: the established route must
// establish it and report an empty site set -- distinct from the boundary refusal.
data established_route_path: String = "dag/extdeps/cpu/ampere_altra_package_contacts.dag"

data gate_file: String = "dag/gunbc/instruments/argv_word_construction_census.dag"

// ---------------------------------------------------------------- fixture facts

fn fixture_facts() -> Optional<List<ArgvWordsFact>> {
  let read = Filesystem.Read(path: fixture_path)
  match read.success {
    false => Absent
    true =>
      match raw_tree_of_text(text: read.content) {
        RawTreeNotEstablished { cause: _ } => Absent
        RawTreeEstablished { root: root } => Present { value: facts_of(root: root) }
      }
  }
}

fn fact_named(xs: List<ArgvWordsFact>, want: String) -> Optional<ArgvWordsFact> {
  fold_list(xs: xs, empty: Absent, cons: fn(acc, f) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match f.decl == want {
          true => Present { value: f }
          false => Absent
        }
    }
  })
}

// THE MEMBER POPULATION THIS FIXTURE CARRIES, AS THE LENS RENDERS IT TODAY (verified through the
// instrument's fixture_facts_dump, not a hand-maintained list): four members -- the three counted
// argv-returning builders (transient, run_with_properties, label_rows) plus one candidate fn
// (waits_quietly, which spells flag literals and returns a scalar: candidates, not counted). The
// three data decls render as UNNAMED facts (fact_name falls back to "<unnamed data>") and none of
// them is a member. The lens is the authority for what a member is; the claim pins its output.
test fn census_fixture_route_counts_its_members() -> Bool {
  match fixture_facts() {
    Absent => false
    Present { value: facts } =>
      let members = fold_list(xs: facts, empty: 0, cons: fn(acc, f) { if is_census_member(f: f) { acc + 1 } else { acc } })
      let data_decls = fold_list(xs: facts, empty: 0, cons: fn(acc, f) { if f.decl_kind == DataDecl { acc + 1 } else { acc } })
      (members == 4) && (data_decls == 3) && (length(xs: facts) == 7)
      && match fact_named(xs: facts, want: "fixture_transient_unit_argv") {
        Absent => false
        Present { value: f } => is_census_member(f: f) && (f.counted == true)
      }
  }
}

// THE CLASSES THE LENS RENDERS ON THIS FIXTURE TODAY: data decls come back UNNAMED ("<unnamed
// data>" fallback), counted false, no candidates, no flag words -- the lens attributes vocabulary
// to FUNCTIONS, not to data. So the candidate class is now the FN that spells flag literals and
// returns a scalar (fixture_waits_quietly: candidates, not counted); commit_args's vocabulary is
// reached BY NAME through fixture_transient_unit_argv's tail, which is why the reach shows up on
// that fn (counted, two flag words) and not on the data decl.
test fn census_fixture_route_classifies_data_decls_at_their_own_kind() -> Bool {
  match fixture_facts() {
    Absent => false
    Present { value: facts } =>
      let data_facts = fold_list(xs: facts, empty: 0, cons: fn(acc, f) { if f.decl_kind == DataDecl { acc + 1 } else { acc } })
      let data_members = fold_list(xs: facts, empty: 0, cons: fn(acc, f) { if (f.decl_kind == DataDecl) && is_census_member(f: f) { acc + 1 } else { acc } })
      (data_facts == 3) && (data_members == 0)
      && match fact_named(xs: facts, want: "fixture_waits_quietly") {
        Absent => false
        Present { value: waits } =>
          (waits.decl_kind == FnDecl) && (waits.counted == false)
          && (length(xs: waits.candidates) == 2) && (length(xs: waits.flag_words) == 0)
          && (waits.returns_argv_words == false) && (waits.list_string_params == 0)
      }
      && match fact_named(xs: facts, want: "fixture_transient_unit_argv") {
        Absent => false
        Present { value: transient } =>
          (transient.decl_kind == FnDecl) && (transient.counted == true)
          && (length(xs: transient.flag_words) == 2) && (length(xs: transient.candidates) == 0)
          && (transient.returns_argv_words == true) && (transient.list_string_params == 0)
      }
  }
}

// The fn signals: the gluing builders are counted and argv-returning with their flag literals
// named; a List<String> parameter IS the argv-interface class per the census contract whether or
// not the body glues flags (counted, no flag words); a flag literal outside an argv position is
// candidate class (not counted) but still a member because candidates are reported.
test fn census_fixture_route_reads_fn_signals() -> Bool {
  match fixture_facts() {
    Absent => false
    Present { value: facts } =>
      match fact_named(xs: facts, want: "fixture_transient_unit_argv") {
        Absent => false
        Present { value: transient } =>
          match fact_named(xs: facts, want: "fixture_run_with_properties") {
            Absent => false
            Present { value: with_props } =>
              match fact_named(xs: facts, want: "fixture_label_rows") {
                Absent => false
                Present { value: label_rows } =>
                  match fact_named(xs: facts, want: "fixture_waits_quietly") {
                    Absent => false
                    Present { value: waits } =>
                      (transient.decl_kind == FnDecl) && (transient.counted == true)
                      && (transient.returns_argv_words == true)
                      && (transient.list_string_params == 0)
                      && member_named(xs: transient.flag_words, x: "--unit=")
                      && member_named(xs: transient.flag_words, x: "--collect")
                      && (with_props.counted == true) && (with_props.returns_argv_words == true)
                      && (with_props.list_string_params == 1)
                      && member_named(xs: with_props.flag_words, x: "--unit=")
                      && (label_rows.counted == true) && (label_rows.list_string_params == 1)
                      && (length(xs: label_rows.flag_words) == 0)
                      && (waits.counted == false) && member_named(xs: waits.candidates, x: "--wait")
                  }
              }
          }
      }
  }
}

// ---------------------------------------------------------------- the boundary

test fn census_boundary_refuses_the_fixture_with_the_modeled_roots_reason() -> Bool {
  match argv_word_construction_module_sites(path: fixture_path) {
    ArgvWordsModuleEstablished { path: _, sites: _ } => false
    ArgvWordsModuleRefused { path: _, reason: r } =>
      string_contains(s: r, pattern: "outside the modeled roots")
  }
}

test fn census_refuses_modules_outside_the_modeled_roots() -> Bool {
  match argv_word_construction_module_sites(path: "docs/plans/some-note.md") {
    ArgvWordsModuleEstablished { path: _, sites: _ } => false
    ArgvWordsModuleRefused { path: _, reason: _ } => true
  }
}

// ---------------------------------------------------------------- the established route

test fn census_established_route_on_a_modeled_module_without_debt() -> Bool {
  match argv_word_construction_module_sites(path: established_route_path) {
    ArgvWordsModuleRefused { path: _, reason: _ } => false
    ArgvWordsModuleEstablished { path: p, sites: sites } =>
      (p == established_route_path) && (length(xs: sites) == 0)
  }
}

// ---------------------------------------------------------------- class routing (pure)

fn class_is(c: ArgvWordsSiteClass, want: ArgvWordsSiteClass) -> Bool {
  match c {
    ExtdepsInterfaceBuilder => match want {
      ExtdepsInterfaceBuilder => true
      WorkflowCallSite => false
    }
    WorkflowCallSite => match want {
      ExtdepsInterfaceBuilder => false
      WorkflowCallSite => true
    }
  }
}

test fn census_site_class_routes_the_modeled_roots() -> Bool {
  match site_class_of(module_file: specimen_path) {
    Absent => false
    Present { value: c } =>
      match site_class_of(module_file: specimen_workflow_path) {
        Absent => false
        Present { value: w } =>
          class_is(c: c, want: ExtdepsInterfaceBuilder) && class_is(c: w, want: WorkflowCallSite)
      }
  }
}

// ---------------------------------------------------------------- the gates (constructed rows)

fn live_member(path: String, decl: String) -> ArgvWordsSite {
  ArgvWordsSite {
    module_file: path,
    decl: decl,
    decl_kind: FnDecl,
    site_class: WorkflowCallSite,
    flag_words: ["--wait"],
    counted: true,
    candidates: Empty,
    returns_argv_words: false,
    list_string_params: 0,
    list_string_data: false
  }
}

fn roster_row(path: String, decl: String) -> ArgvWordsRosterRow {
  ArgvWordsRosterRow {
    module_file: path,
    decl: decl,
    decl_kind: FnDecl,
    site_class: WorkflowCallSite,
    note: "witness row"
  }
}

fn exit_is_success(exit: ProcessExit) -> Bool {
  match exit {
    ExitSuccess => true
    ExitFailure { code: _, reason: _ } => false
  }
}

test fn gate_stale_row_refuses_the_recount() -> Bool {
  let live = [live_member(path: gate_file, decl: "still_debt")]
  let roster = [roster_row(path: gate_file, decl: "still_debt"), roster_row(path: gate_file, decl: "paid_but_row_kept")]
  !exit_is_success(exit: argv_word_construction_rows_resolve(live: live, roster: roster))
}

test fn gate_uncovered_member_refuses_the_recount() -> Bool {
  let live = [live_member(path: gate_file, decl: "still_debt"), live_member(path: gate_file, decl: "new_string_built_argv")]
  let roster = [roster_row(path: gate_file, decl: "still_debt")]
  !exit_is_success(exit: argv_word_construction_census_covers(live: live, roster: roster))
}

test fn gate_grown_roster_refuses_the_shrink_contract() -> Bool {
  let roster = [roster_row(path: gate_file, decl: "one"), roster_row(path: gate_file, decl: "two")]
  !exit_is_success(exit: argv_word_construction_roster_shrinks(baseline_population: 1, roster: roster))
}

test fn gate_within_contract_holds() -> Bool {
  let live = [live_member(path: gate_file, decl: "still_debt")]
  let roster = [roster_row(path: gate_file, decl: "still_debt")]
  exit_is_success(exit: argv_word_construction_gates(live: live, roster: roster, baseline_population: 1))
}

// The committed instrument's contract over exactly the roster's own modules: every committed row
// resolves against a live counted site, no live counted member is uncovered, the population has
// not grown past the baseline, and every module walk either established or refused with a named
// reason. With the roster still at zero rows this walks nothing and holds trivially; once the
// wet-lane recount fills the roster, this claim walks exactly those modules in CI.
test fn committed_census_holds_its_own_contract() -> Bool {
  exit_is_success(exit: argv_word_construction_census_check_paths(paths: argv_word_construction_census_roster_modules()))
}

// The instrument's own live filter subtracts only what the committed exclusions name.
test fn instrument_live_filter_keeps_unexcluded_members() -> Bool {
  let sites = [live_member(path: gate_file, decl: "still_debt")]
  fold_list(xs: argv_word_construction_census_live(sites: sites), empty: true, cons: fn(acc, s) { acc && (s.decl == "still_debt") })
}

// ---------------------------------------------------------------- helpers

fn member_named(xs: List<String>, x: String) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, y) { acc || (y == x) })
}
