module v2.test.claim.binder_reference

import v2.compiler.resolve { ResolvedTree }
import v2.compiler.infer { infer }
import v2.test.claim.type_param_binder_frame { tpb_assemble }
import v2.test.claim.emit.module_member_emission { MemberClosureRefused, MemberEmitted, MemberEmissionVerdict, MemberRefused, member_emission_verdict_of }
import v2.std.diagnostic { Accepted, Outcome, Rejected, diagnostics_fatal_reason }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, node_subtree_nodes }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.optional { Absent, Optional, Present }
import v2.std.qualified_name { binder_reference_symbol_optional, declaration_reference_path_optional, qualified_name_last_segment }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: the binder reference (v2.std.qualified_name binder_reference_node), the carrier
// v2.compiler.resolve resolve_frame_bound_reference mints for every name it finds in a LexicalFrame --
// a let, a match-arm pattern binder, a closure parameter -- and which every later stage reads by its
// kind. BOUNDARY: source text in, through the production route (tpb_assemble is
// assemble_program_from_ingest; member_emission_verdict_of is the closure-emission door), so the
// lowering, the resolve rewrite and each consumer run for real.
//
// RED BEFORE: resolve returned a bare canonical atom for a lexical binder, which the emitter could not
// tell from any other atom and checked only against the arrow's parameters, so a let-bound name used
// inside an expression refused target_value_expr_reason_body_scope_binding_invalid (row 1), and a
// closure whose body is its enclosing fn's parameter had no arm in target_project_realized_closure
// (row 5). Rows 2-4 and 6 pin the scope of the change: it is the VALUE binders that are marked, a
// binder wins over a same-named declaration, type parameters are untouched, and a closure parameter
// is typed exactly as it was.

fn br_binder_references_named(o: Outcome<ResolvedTree>, name: Symbol) -> Int {
  match o {
    Rejected { diagnostics: _ } => 0 - 1
    Accepted { value: t, diagnostics: _ } =>
      fold(node_subtree_nodes(root: t.root), init: 0, f: fn(acc, n) {
        match binder_reference_symbol_optional(node: n) {
          Present { value: b } => if b == name { acc + 1 } else { acc }
          Absent => acc
        }
      })
  }
}

fn br_declaration_references_ending(o: Outcome<ResolvedTree>, name: Symbol) -> Int {
  match o {
    Rejected { diagnostics: _ } => 0 - 1
    Accepted { value: t, diagnostics: _ } =>
      fold(node_subtree_nodes(root: t.root), init: 0, f: fn(acc, n) {
        match declaration_reference_path_optional(node: n) {
          Present { value: path } =>
            match qualified_name_last_segment(qn: path) {
              Present { value: leaf } => if leaf == name { acc + 1 } else { acc }
              Absent => acc
            }
          Absent => acc
        }
      })
  }
}

fn br_atoms_named(o: Outcome<ResolvedTree>, name: Symbol) -> Int {
  match o {
    Rejected { diagnostics: _ } => 0 - 1
    Accepted { value: t, diagnostics: _ } =>
      fold(node_subtree_nodes(root: t.root), init: 0, f: fn(acc, n) {
        match node_atom_identity_optional(node: n) {
          Present { value: id } => if id == name { acc + 1 } else { acc }
          Absent => acc
        }
      })
  }
}

// (1) A LET-BOUND NAME INSIDE AN EXPRESSION RESOLVES TO A BINDER REFERENCE. Its emission is the
// supplied-tree row v2.test.emit.rust_bind_let_emit a_let_bound_name_in_a_value_position_emits_holds:
// on this production route infer leaves a let binder's grounding underived (before and after this
// change), so emission refuses infer_grounding_not_derived before the emitter sees the reference.
// That infer gap is its own boundary and is not this row's subject.
test fn a_let_bound_name_inside_an_expression_is_a_binder_reference_holds() -> Bool {
  br_binder_references_named(o: tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let y = x\n  y + y\n}\n"), name: ^y) == 2
}

// (2) A BINDER SHADOWS A SAME-NAMED TOP-LEVEL FN: the let's `y` resolves to the binder, never to the
// module's `y`. The declaration count pins that the module's fn is not what the tail names.
fn br_shadowing() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn y() -> Int = 1\n\nfn f(x: Int) -> Int {\n  let y = x\n  y\n}\n")
}

test fn a_binder_shadowing_a_top_level_fn_resolves_to_the_binder_holds() -> Bool {
  (br_binder_references_named(o: br_shadowing(), name: ^y) == 1) && (br_declaration_references_ending(o: br_shadowing(), name: ^y) == 0)
}

// (3) A MATCH-ARM BINDER IS A BINDER REFERENCE IN ITS PATTERN AND ITS ARM BODY (resolve walks the
// pattern in the arm's frame, so both are the one binder), and a closure parameter in its body.
test fn an_arm_binder_and_a_closure_parameter_are_binder_references_holds() -> Bool {
  (br_binder_references_named(o: tpb_assemble(src: "module p\n\ntype Box = Holds { value: Int }\n\nfn f(b: Box) -> Int = match b {\n  Holds { value: v } => v\n}\n"), name: ^v) == 2)
    && (br_binder_references_named(o: tpb_assemble(src: "module p\n\nfn f(x: Int) -> Int {\n  let g = fn(a) { a }\n  g(x)\n}\n"), name: ^a) == 1)
}

// (4) TYPE PARAMETERS ARE UNCHANGED: a type position resolves in the type-role frame, which this
// change does not touch, so `T` stays a bare atom and is never a binder reference.
fn br_generic() -> Outcome<ResolvedTree> {
  tpb_assemble(src: "module p\n\nfn id<T>(x: T) -> T { x }\n")
}

test fn a_type_parameter_is_never_a_binder_reference_holds() -> Bool {
  (br_binder_references_named(o: br_generic(), name: ^T) == 0) && (br_atoms_named(o: br_generic(), name: ^T) > 0)
}

// (5) A CLOSURE WHOSE BODY IS ITS ENCLOSING FN'S PARAMETER EMITS. Its body classifies
// ParameterReferenceBody, which target_project_realized_closure had no arm for before this change --
// a defect found while placing the binder arm beside it, fixed in the same cut.
test fn a_closure_returning_an_enclosing_parameter_emits_holds() -> Bool {
  match member_emission_verdict_of(source: "module v2.test.member_emission\n\nfn k(x: Int) -> fn(Int) -> Int {\n  fn(y) { x }\n}\n") {
    MemberEmitted { text: t } => string_contains(s: t, pattern: "move |y| { x }")
    MemberRefused { reason: _ } => false
    MemberClosureRefused { reason: _ } => false
  }
}

// (6) A CLOSURE PARAMETER IS TYPED EXACTLY AS BEFORE. infer reads the binder reference's symbol and
// hands it to the existing frozen scope search (v2.compiler.infer infer_parameter_scope_search,
// unchanged: no new caller, no new rule). Measured 2026-10-01 on the same three sources at the base
// (72dda5f3dd, #12799 + #12671) and at this change: identical verdicts. A lambda parameter is a
// type variable (no surface annotation exists for it), so `a + x` refuses on the operand type while
// `fn(a) { a }` and an annotated return both infer. The row pins those verdicts so a change to how a
// lambda parameter is typed reds it.
fn br_infer_verdict(src: String) -> Symbol {
  match tpb_assemble(src: src) {
    Rejected { diagnostics: _ } => ^br_resolve_refused
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Accepted { value: _, diagnostics: _ } => ^br_infer_accepted
        Rejected { diagnostics: d } => diagnostics_fatal_reason(d: d)
      }
  }
}

test fn a_closure_parameter_is_typed_as_before_the_binder_carrier_holds() -> Bool {
  (br_infer_verdict(src: "module p\n\nfn f(x: Int) -> Int {\n  let g = fn(a) { a + x }\n  g(x)\n}\n") == ^infer_transform_operand_type_mismatch)
    && (br_infer_verdict(src: "module p\n\nfn f(x: Int) -> Int {\n  let g = fn(a) { a }\n  g(x)\n}\n") == ^br_infer_accepted)
    && (br_infer_verdict(src: "module p\n\nfn f(x: Int) -> Int {\n  let g = fn(a) -> Int { a }\n  x\n}\n") == ^br_infer_accepted)
}
