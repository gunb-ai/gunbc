module v2.test.claim.affected_set_self_confirmation

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.algebra { contains }
import v2.std.collection { List }
import v2.std.text { String }
import v2.lens.affected_set.self_confirmation {
  affected_set_universe_validating_entry,
  compile_clean_scope_validating_entry,
  compile_clean_shard_a_validating_entry,
  derive_self_relevant_check_identities,
  mechanism_touch_affected_set_paths,
  mechanism_touch_compile_clean_scope_tool_paths,
  mechanism_touch_module_graph_paths,
  mechanism_touch_affected_set_expected_identities,
  mechanism_touch_compile_clean_scope_tool_expected_identities,
  mechanism_touch_module_graph_expected_identities,
  repair_receipt_expected_identities,
  repair_receipt_touched_paths,
  self_relevant_check_identity_in_derived_set,
  self_relevant_checks_blocks_skip,
  self_relevant_identities_match_expected
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data affected_set_self_confirmation_note: String = "Affected-set self-confirmation witness (operator brief calm-fox-44): change the selection mechanism -> derive expected self-relevant checks -> prove the repairing check is IN the selected identity set. NOT 'CI eventually went green' (absorbing fallback). The #7915 receipt is the discriminating repair scenario: only dag/extdeps/systems/nvidia.dag and dag/test/claim/generated_artifact_drift_test.dag changed, yet compile_clean_shard_a_witness_test must be in the derived identity set. Completeness is an identity join (bag_eq), never a roster count literal. RED control uses scope-only identity set that omits shard_a while full derivation includes it."

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn identity_in_set(entry: String, identities: List<String>) -> Bool {
  contains(xs: identities, item: entry, eq: string_eq)
}

test fn witness_mechanism_touch_derives_scope_check_identity() -> Bool {
  let touched = mechanism_touch_module_graph_paths()
  let derived = derive_self_relevant_check_identities(touched_paths: touched)
  identity_in_set(entry: compile_clean_scope_validating_entry, identities: derived)
    && self_relevant_check_identity_in_derived_set(
      entry_path: compile_clean_scope_validating_entry,
      touched_paths: touched
    )
}

test fn witness_mechanism_touch_blocks_skip_for_scope_check() -> Bool {
  let touched = mechanism_touch_module_graph_paths()
  self_relevant_checks_blocks_skip(
    entry_path: compile_clean_scope_validating_entry,
    touched_paths: touched
  )
}

test fn witness_mechanism_touch_module_graph_derived_identities_exact() -> Bool {
  self_relevant_identities_match_expected(
    touched_paths: mechanism_touch_module_graph_paths(),
    expected: mechanism_touch_module_graph_expected_identities
  )
}

test fn witness_mechanism_touch_compile_clean_scope_tool_derives_scope_identity() -> Bool {
  let touched = mechanism_touch_compile_clean_scope_tool_paths()
  let derived = derive_self_relevant_check_identities(touched_paths: touched)
  identity_in_set(entry: compile_clean_scope_validating_entry, identities: derived)
    && self_relevant_checks_blocks_skip(
      entry_path: compile_clean_scope_validating_entry,
      touched_paths: touched
    )
}

test fn witness_mechanism_touch_compile_clean_scope_tool_derived_identities_exact() -> Bool {
  self_relevant_identities_match_expected(
    touched_paths: mechanism_touch_compile_clean_scope_tool_paths(),
    expected: mechanism_touch_compile_clean_scope_tool_expected_identities
  )
}

test fn witness_mechanism_touch_affected_set_roster_identities_exact() -> Bool {
  self_relevant_identities_match_expected(
    touched_paths: mechanism_touch_affected_set_paths(),
    expected: mechanism_touch_affected_set_expected_identities
  )
    && identity_in_set(
      entry: affected_set_universe_validating_entry,
      identities: mechanism_touch_affected_set_expected_identities
    )
}

test fn witness_repair_receipt_derives_shard_a_identity() -> Bool {
  let touched = repair_receipt_touched_paths()
  let derived = derive_self_relevant_check_identities(touched_paths: touched)
  identity_in_set(entry: compile_clean_shard_a_validating_entry, identities: derived)
    && identity_in_set(entry: compile_clean_scope_validating_entry, identities: derived)
}

test fn witness_repair_receipt_derived_identities_exact() -> Bool {
  self_relevant_identities_match_expected(
    touched_paths: repair_receipt_touched_paths(),
    expected: repair_receipt_expected_identities
  )
}

test fn witness_repair_receipt_blocks_skip_for_shard_a() -> Bool {
  let touched = repair_receipt_touched_paths()
  self_relevant_checks_blocks_skip(
    entry_path: compile_clean_shard_a_validating_entry,
    touched_paths: touched
  )
}

data self_confirmation_red_control_note: String = "Discriminating RED: scope-only identity set (the #7915 failure shape) omits shard_a while full derivation includes it — identity membership, not cardinality."

test fn witness_repair_receipt_red_control_shard_a_absent() -> Bool {
  let touched = repair_receipt_touched_paths()
  let scope_only: List<String> = [compile_clean_scope_validating_entry]
  let derived = derive_self_relevant_check_identities(touched_paths: touched)
  !identity_in_set(
    entry: compile_clean_shard_a_validating_entry,
    identities: scope_only
  )
    && identity_in_set(
      entry: compile_clean_shard_a_validating_entry,
      identities: derived
    )
}
