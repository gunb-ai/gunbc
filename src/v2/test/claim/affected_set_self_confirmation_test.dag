module v2.test.claim.affected_set_self_confirmation

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.algebra { contains, length }
import v2.std.text { String }
import v2.lens.affected_set.self_confirmation {
  affected_set_universe_validating_entry,
  compile_clean_scope_validating_entry,
  compile_clean_shard_a_validating_entry,
  derive_self_relevant_check_identities,
  mechanism_touch_module_graph_paths,
  repair_receipt_touched_paths,
  self_relevant_check_identity_in_derived_set,
  self_relevant_checks_blocks_skip,
  selection_mechanism_self_relevant_rows
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data affected_set_self_confirmation_note: String = "Affected-set self-confirmation witness (operator brief calm-fox-44): change the selection mechanism -> derive expected self-relevant checks -> prove the repairing check is IN the selected identity set. NOT 'CI eventually went green' (absorbing fallback). The #7915 receipt is the discriminating repair scenario: only dag/extdeps/systems/nvidia.dag and dag/test/claim/generated_artifact_drift_test.dag changed, yet compile_clean_shard_a_witness_test must be in the derived identity set. RED control uses a hand-built derivation that omits shard_a while keeping scope — the predicate must answer false."

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn identity_in_set(entry: String, identities: List<String>) -> Bool {
  contains(xs: identities, item: entry, eq: string_eq)
}

test fn witness_mechanism_touch_derives_scope_check_identity() -> Bool {
  let touched = mechanism_touch_module_graph_paths()
  let derived = derive_self_relevant_check_identities(touched_paths: touched)
  identity_in_set(entry: compile_clean_scope_validating_entry, identities: derived)
    && self_relevant_check_identity_in_derived_set(
      entry_path: compile_clean_scope_validating_entry,
      touched_paths: touched
    )
}

test fn witness_mechanism_touch_blocks_skip_for_scope_check() -> Bool {
  let touched = mechanism_touch_module_graph_paths()
  self_relevant_checks_blocks_skip(
    entry_path: compile_clean_scope_validating_entry,
    touched_paths: touched
  )
}

test fn witness_repair_receipt_derives_shard_a_identity() -> Bool {
  let touched = repair_receipt_touched_paths()
  let derived = derive_self_relevant_check_identities(touched_paths: touched)
  identity_in_set(entry: compile_clean_shard_a_validating_entry, identities: derived)
    && identity_in_set(entry: compile_clean_scope_validating_entry, identities: derived)
}

test fn witness_repair_receipt_blocks_skip_for_shard_a() -> Bool {
  let touched = repair_receipt_touched_paths()
  self_relevant_checks_blocks_skip(
    entry_path: compile_clean_shard_a_validating_entry,
    touched_paths: touched
  )
}

test fn witness_mechanism_row_count_pinned() -> Bool {
  length(xs: selection_mechanism_self_relevant_rows) == 2
}

data self_confirmation_red_control_note: String = "Discriminating RED: a synthetic derivation that keeps compile-clean scope but drops shard_a must NOT satisfy the repair-receipt predicate — exactly the #7915 failure shape (repair merged while the shard-a identity was absent from the selected set)."

test fn witness_repair_receipt_red_control_shard_a_absent() -> Bool {
  let touched = repair_receipt_touched_paths()
  let scope_only: List<String> = [compile_clean_scope_validating_entry]
  let derived = derive_self_relevant_check_identities(touched_paths: touched)
  !identity_in_set(
    entry: compile_clean_shard_a_validating_entry,
    identities: scope_only
  )
    && identity_in_set(
      entry: compile_clean_shard_a_validating_entry,
      identities: derived
    )
}
