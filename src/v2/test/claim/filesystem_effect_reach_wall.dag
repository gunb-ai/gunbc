module v2.test.claim.filesystem_effect_reach_wall

import v2.compiler.effect_demand {
  DemandRestatementRow,
  AuthorizedRow,
  NewRestatementRowRefused,
  FilesystemEffectSite,
  FilesystemEffectReach,
  FilesystemEffectCensusPopulation,
  FilesystemEffectCensusReport,
  ReachedThroughHandler,
  ReachedFreePrimitiveDirectly,
  ReachedOutsideBoundHandler,
  filesystem_free_primitive_slug,
  filesystem_effect_emitted_closure_population,
  filesystem_effect_direct_reach_debt_contract,
  filesystem_effect_debt_join_holds,
  filesystem_effect_census_log,
  filesystem_effect_reach,
  filesystem_effect_emitted_closure_census,
  filesystem_effect_site_eq,
  filesystem_effect_reaches_are_located_distinct,
  filesystem_effect_reach_site,
  FilesystemWallCompileGateTrigger,
  filesystem_wall_compile_gate_trigger,
  filesystem_effect_reach_census,
  filesystem_effect_direct_reach_wall_holds,
  filesystem_effect_callee_matches_identity,
  demand_restatement_row_verdict,
  demand_restatement_new_row_refusals,
  demand_restatement_wall_holds
}
// THE REAL ROSTER, not a hand-built stand-in: the restatement wall is run over the rows the census
// actually retained, read from the module that carries them, so the witness exercises the real producer
// (gunbc.design_argument::consumption -- "a witness asserting existence rather than exercising behavior"
// is a tell of a dangling declaration).
import gunbc.demand_engine_restatement_follow_up {
  DemandRestatementRetainedRow,
  demand_restatement_retained_fn_rows,
  demand_restatement_retained_pattern_rows
}
import std.algebra { Cons, Empty, length, string_contains }
import std.types { Bool, List }
import v2.std.text { String }
import v2.std.node { symbol_intern_lexeme, TypeNode, Conj, node_synthetic }
import v2.compiler.name_resolve { DeclPhase1Row, LocallyResolved }
import v2.std.qualified_name {
  QualifiedName,
  qualified_name_from_dotted_string,
  qualified_name_from_string_segments,
  qualified_name_to_dotted_string
}
import v2.test.claim.compiler.operation_declaration_seam { read_seam_path }

// EFFECTS-1 (egress-effects-1-filesystem-provider), THE CONTROLS FOR BOTH WALLS. The row's red_control is
// "a new demand_restatement row refuses; an emitted closure reaching filesystem_read directly refuses
// under the handler binding." THE RED IS THE ROW'S OWN REFUSAL, NOT MODULE ABSENCE: it is carried as a
// RedProbe (v2 gunbc.roadmap.roadmap_status) on the durable branch
// red-control/egress-effects-1-filesystem-provider, whose named break NEUTERS the refusal predicates in
// v2.compiler.effect_demand (direct reaches pass through; an unauthorised restatement row passes through)
// with nothing else changed -- so the witness's refusal assertions FAIL there and PASS at the probe's
// green base. Red_at, green_at, red_base and probe_ref are recorded with the executed pair in the PR
// comment run link; until that run link exists these are DECLARED controls, not executed ones. (As base
// context only: none of the symbols below existed at the dispatch base a9a0ee068a4 -- that fact is not
// the red control and is not claimed as one.) Each discriminating test plants exactly one defect over a
// small SYNTHETIC world (fail_closed's construction-over-validation rule: the refusal is a parameterized
// function, never an oracle copied from the tree it audits), and has a reachable opposite answer -- a
// green control that still passes.

// =============================================================================================
// WALL 2 -- filesystem_read direct reach, located BY SITE over the NAMED typed population source
// =============================================================================================

// The handler the native door binds reuses v1.compiler.emit_rust emit_file_call's semantics -- the
// definition is \#v1.compiler.emit_rust::emit_file_call (escaped: src/v1 is outside the roots the marked-reference check binds), which is what makes
// "emit_file_call" the slug a green control reaches through: it is the one filesystem realization the
// native door binds, and the free legacy primitive `filesystem_read` is neither that handler nor its
// interface. The handler slug a green control reaches through is a filesystem realization OTHER than the
// free primitive's slug.
data filesystem_handler_slug: String = "emit_file_call"

// The two self_host.dag direct reaches, located by SITE (module + enclosing declaration + OCCURRENCE
// INDEX within that declaration -- NOT a line number): read_roster_manifest occurrence 1 and
// fold_side_bytes occurrence 1. They are distinct offenders -- keying on (module, operation) alone would
// collapse them, the under-counting defect this lane must not ship. The census is run with the named
// typed population source (filesystem_effect_emitted_closure_population) passed BY NAME.

data self_host_read_roster_manifest_site: FilesystemEffectSite = FilesystemEffectSite {
  module_path: "v2.compiler.self_host",
  enclosing_declaration: "read_roster_manifest",
  site_occurrence: 1
}

data self_host_fold_side_bytes_site: FilesystemEffectSite = FilesystemEffectSite {
  module_path: "v2.compiler.self_host",
  enclosing_declaration: "fold_side_bytes",
  site_occurrence: 1
}

data handler_site: FilesystemEffectSite = FilesystemEffectSite {
  module_path: "v2.compiler.compile",
  enclosing_declaration: "compiled_closure",
  site_occurrence: 1
}

data filesystem_reach_through_handler: FilesystemEffectReach = filesystem_effect_reach(
  site: handler_site,
  operation: "emit_file_call",
  handler_slug: filesystem_handler_slug
)

data filesystem_reach_self_host_roster: FilesystemEffectReach = filesystem_effect_reach(
  site: self_host_read_roster_manifest_site,
  operation: "filesystem_read",
  handler_slug: filesystem_handler_slug
)

data filesystem_reach_self_host_fold: FilesystemEffectReach = filesystem_effect_reach(
  site: self_host_fold_side_bytes_site,
  operation: "filesystem_read",
  handler_slug: filesystem_handler_slug
)

// THE CENSUS OVER THE EMITTED-CLOSURE POPULATION, run with the NAMED typed population source. self_host
// is the one in-population module (the module the native-emitted closure under the NativeCliDriver
// binding reaches); its two direct reaches are the two located offenders.
data self_host_emitted_closure_reaches: List<FilesystemEffectReach> = Cons {
  head: filesystem_reach_self_host_roster,
  tail: Cons { head: filesystem_reach_self_host_fold, tail: Empty }
}

data self_host_emitted_closure_report: FilesystemEffectCensusReport = filesystem_effect_reach_census(
  population_source: filesystem_effect_emitted_closure_population,
  reaches: self_host_emitted_closure_reaches
)

test fn filesystem_handler_binding_green_control_holds() -> Bool {
  let report = filesystem_effect_reach_census(
    population_source: filesystem_effect_emitted_closure_population,
    reaches: Cons { head: filesystem_reach_through_handler, tail: Empty }
  )
  filesystem_effect_direct_reach_wall_holds(report: report)
}

// THE NAMED POPULATION SOURCE IS CARRIED, not a bare list: the census report names the emitted-closure
// rule it was measured over (consumption of the typed declaration -- a reader sees WHERE the population
// came from, and the call site passes the symbol BY NAME, no inline literal).
test fn filesystem_census_report_names_its_population_source() -> Bool {
  self_host_emitted_closure_report.population_source.rule
    == ^emitted_closure_under_native_cli_driver_e2_filesystem_binding
}

// The named source names the real driver arm and the real bound handler, so a reader can re-derive the
// population against the corpus at the cited head rather than take it on faith.
test fn filesystem_population_source_names_the_real_driver_and_handler() -> Bool {
  (self_host_emitted_closure_report.population_source.driver_arm == "NativeCliDriver")
    && (self_host_emitted_closure_report.population_source.bound_handler == "emit_file_call")
    && (self_host_emitted_closure_report.population_source.free_primitive_slug == filesystem_free_primitive_slug)
}

// MULTIPLICITY: self_host's two direct reaches are TWO distinct offenders in the census report, located
// at two distinct SITES (the wall does not collapse them to one). This is the defect a (module,
// operation) key would have printed as ONE.
test fn filesystem_census_reports_two_distinct_sites_for_self_host() -> Bool {
  let offenders = self_host_emitted_closure_report.offenders
  (length(xs: offenders) == 2)
    && (!filesystem_effect_site_eq(
      left: self_host_read_roster_manifest_site,
      right: self_host_fold_side_bytes_site
    ))
}

// THE DISTINCTNESS ARM IS LIVE, THROUGH THE WALL (review 98184 finding 3: keyed on the offender list the
// arm was inert -- an empty offender list is trivially distinct, so its RED was unauthorable; the arm now
// keys on the extractor's REACHES, where two phase-1 rows for the same declaration CAN number the same
// located site twice). GREEN -- the real self_host census reaches sit at distinct located sites, so the
// wall holds its second arm. RED, AUTHORED -- two reaches at the SAME located site, BOTH through the bound
// handler so the offender list is EMPTY, and the wall still refuses: the failing arm is observably the
// distinctness arm, not the emptiness arm.
test fn filesystem_reaches_are_located_distinct_on_the_real_self_host_census() -> Bool {
  filesystem_effect_reaches_are_located_distinct(
    reaches: self_host_emitted_closure_report.reaches
  ) == true
}

test fn filesystem_same_site_twice_breaks_the_wall_with_no_offenders() -> Bool {
  let duplicated = Cons {
    head: filesystem_reach_through_handler,
    tail: Cons { head: filesystem_reach_through_handler, tail: Empty }
  }
  let report = filesystem_effect_reach_census(
    population_source: filesystem_effect_emitted_closure_population,
    reaches: duplicated
  )
  // Zero offenders: both reaches went through the bound handler, so the emptiness arm PASSES.
  (length(xs: report.offenders) == 0)
    // And the wall still breaks: the duplicate located site is the only thing that can fail here.
    && (!filesystem_effect_direct_reach_wall_holds(report: report))
    && (filesystem_effect_reaches_are_located_distinct(reaches: report.reaches) == false)
}

// THE TRIGGER CARRIER IS CONSUMED, and it names the real offender rather than hiding it in prose
// (gunbc.design_argument::source_annotations). The gate connects only when these two located self_host
// declarations migrate to the bound handler; reading them off the carrier (not re-typing them) proves the
// named offender is visible in the artifact. The declarations match the two census sites' enclosing
// declarations, so the trigger and the census agree on WHICH sites are the known in-population offenders.
test fn filesystem_compile_gate_trigger_names_the_two_self_host_sites() -> Bool {
  // TARGETS READ AS TYPED IDENTITIES (review 98447 finding 2 / gunbc.design_argument::single_authority):
  // QualifiedName equality against the SAME authority objects the census and the population use -- the
  // handler identity is the witness's own filesystem_handler_identity data, the module the census sites'
  // module -- never string fields the witness string-matches. TYPED, NOT RESOLVED (Manager A, review
  // 98447 re-ask): these comparisons make the check an identity comparison; nothing here resolves the
  // names against the corpus, so a corpus rename does NOT fail this leg while the fixture strings drift
  // together. The rename guard is the deferred resolve-against-real-phase-1-rows leg, owned by Manager
  // B's establishing roadmap row for this instrument.
  (filesystem_wall_compile_gate_trigger.awaiting_migration_module
      == qualified_name_from_dotted_string(dotted: "v2.compiler.self_host"))
    && (qualified_name_to_dotted_string(qn: filesystem_wall_compile_gate_trigger.awaiting_migration_module)
      == self_host_read_roster_manifest_site.module_path)
    && (length(xs: filesystem_wall_compile_gate_trigger.awaiting_migration_declarations) == 2)
    && (any(
      xs: filesystem_wall_compile_gate_trigger.awaiting_migration_declarations,
      predicate: fn(d) {
        d
          == qualified_name_from_dotted_string(
            dotted: concat(
              self_host_read_roster_manifest_site.module_path,
              concat(".", self_host_read_roster_manifest_site.enclosing_declaration)
            )
          )
      }
    ))
    && (any(
      xs: filesystem_wall_compile_gate_trigger.awaiting_migration_declarations,
      predicate: fn(d) {
        d
          == qualified_name_from_dotted_string(
            dotted: concat(
              self_host_fold_side_bytes_site.module_path,
              concat(".", self_host_fold_side_bytes_site.enclosing_declaration)
            )
          )
      }
    ))
    && (filesystem_wall_compile_gate_trigger.migrate_to_bound_handler == filesystem_handler_identity)
    && (filesystem_wall_compile_gate_trigger.migrate_to_bound_handler
      != filesystem_wall_compile_gate_trigger.awaiting_migration_module)
    && (filesystem_wall_compile_gate_trigger.migrate_to_bound_handler != filesystem_primitive_identity)
    && (filesystem_wall_compile_gate_trigger.gate_connects_when
      == ^self_host_direct_reaches_migrate_to_bound_handler)
    // THE CAPABILITY IS NAMED, not just the consequence (gunbc.design_argument::guarantee_ladder; Manager
    // B): the carrier holds Manager B's capability SENTENCE verbatim -- "emit_rust binds a native handler at
    // an ordinary-function entry" -- and the witness asserts THAT STRING, not a row id: a row id asserted
    // here could be renamed under the trigger and leave it claiming to hold (B: "Not a row id, so it
    // survives a rename"). The symbol handle and the consequence symbol are separate, so capability and
    // consequence cannot collapse into one word.
    && (filesystem_wall_compile_gate_trigger.missing_capability
      == ^emit_side_native_filesystem_handler_binding_to_ordinary_function_entry)
    && (filesystem_wall_compile_gate_trigger.missing_capability
      != filesystem_wall_compile_gate_trigger.gate_connects_when)
    && (filesystem_wall_compile_gate_trigger.capability_text
      == "emit_rust binds a native handler at an ordinary-function entry")
    // Non-echo legs: the string's CONTENT is checked piecewise against what it must name (the emitter stage
    // as subject, the entry kind as object), and it is checked to be NEITHER target identity -- so an edit
    // that swaps the capability for a migration target or the handler name fails on shape, not just on the
    // constant comparison.
    && string_contains(s: filesystem_wall_compile_gate_trigger.capability_text, pattern: "emit_rust")
    && string_contains(s: filesystem_wall_compile_gate_trigger.capability_text, pattern: "ordinary-function entry")
    && (filesystem_wall_compile_gate_trigger.capability_text
      != qualified_name_to_dotted_string(qn: filesystem_wall_compile_gate_trigger.migrate_to_bound_handler))
    && (filesystem_wall_compile_gate_trigger.capability_text
      != qualified_name_to_dotted_string(qn: filesystem_wall_compile_gate_trigger.awaiting_migration_module))
    && (!string_contains(s: filesystem_wall_compile_gate_trigger.capability_text, pattern: "self_host"))
    // A row id may sit BESIDE the capability as a cross-reference, never instead of it: the capability text
    // itself must not be a row identifier.
    && (!string_contains(s: filesystem_wall_compile_gate_trigger.capability_text, pattern: "rn_"))
    && (!string_contains(s: filesystem_wall_compile_gate_trigger.capability_text, pattern: "egress-effects-1"))
}

// THE NEWLY-ADDED-SITE CONTROL (Manager B's binding arm). This is NOT the planted-out-of-bounds arm: a
// planted reach proves the wall catches what the producer emits; THIS proves the census notices a site
// NOBODY has flagged before -- an extra direct reach appearing in a fresh module/declaration must surface as
// exactly ONE NEW NAMED offender, and the two known self_host offenders must still be there. It is a
// DISCRIMINATOR for the site-identity key: a (module, operation) key would collapse the two self_host sites
// (same module, same operation) to ONE, so baseline 2 would read 1 and the whole chain fails. With the
// occurrence key the three sites are distinct, the baseline is 2, the extension is 3, and the new one is the
// planted site by name. If the census could not tell an old offender from a new one, the still-present and
// the new-site assertions could not both hold -- which is the failure B asked to be surfaced now.
test fn filesystem_newly_added_site_surfaces_as_a_new_named_offender() -> Bool {
  let planted_site = FilesystemEffectSite {
    module_path: "v2.compiler.native_census_witness_planted",
    enclosing_declaration: "planted_direct_read",
    site_occurrence: 1
  }
  let planted_reach = filesystem_effect_reach(
    site: planted_site,
    operation: "filesystem_read",
    handler_slug: filesystem_handler_slug
  )
  let extended = Cons {
    head: filesystem_reach_self_host_roster,
    tail: Cons { head: filesystem_reach_self_host_fold, tail: Cons { head: planted_reach, tail: Empty } }
  }
  let report = filesystem_effect_reach_census(
    population_source: filesystem_effect_emitted_closure_population,
    reaches: extended
  )
  (length(xs: self_host_emitted_closure_report.offenders) == 2)
    && (length(xs: report.offenders) == 3)
    && filesystem_effect_reaches_are_located_distinct(reaches: report.reaches)
    && any(
      xs: report.offenders,
      predicate: fn(o) {
        filesystem_effect_site_eq(
          left: filesystem_effect_reach_site(reach: o),
          right: planted_site
        )
      }
    )
    && any(
      xs: report.offenders,
      predicate: fn(o) {
        filesystem_effect_site_eq(
          left: filesystem_effect_reach_site(reach: o),
          right: self_host_read_roster_manifest_site
        )
      }
    )
    && any(
      xs: report.offenders,
      predicate: fn(o) {
        filesystem_effect_site_eq(
          left: filesystem_effect_reach_site(reach: o),
          right: self_host_fold_side_bytes_site
        )
      }
    )
}

// =============================================================================================
// FULL-IDENTITY DISCRIMINATION (Manager A blocking point c + warm-fox's false-negative hole)
// =============================================================================================
// The producer keys a reach on the callee's WHOLE resolved QualifiedName, not its final segment. A
// last-segment test would (1) refuse a HONYM declared elsewhere in its own module as if it were the free
// primitive (false positive) and (2) miss the real primitive reached through a spelling whose last segment
// is not the slug (the hole). These tests PROVE the discrimination rather than assert it (fail_closed:
// construction over validation): plant the two shapes side by side and show which the wall keys.
// The primitive identity is a SUPPLIED QualifiedName, not a hand-typed slug constant.

// The free primitive's declared identity, sourced from the EXISTING AUTHORITY rather than retyped
// (Manager A: "Source the identity from the existing authority, operation_declaration_seam.dag:66 ...
// import or reference that value, never a retyped string"). read_seam_path() returns the QualifiedName the
// production resolver records for the read seam -- v2.std.live_read.filesystem_read -- so this fixture cannot
// drift from what the resolve fold actually emits, and it names the module that DECLARES filesystem_read.
data filesystem_primitive_identity: QualifiedName = read_seam_path()

// A HONYM: a declaration named filesystem_read in its OWN module (built segment by segment so the last
// segment genuinely equals the primitive's last segment -- the discrimination a last-segment test would fail
// is only meaningful if the final segments really match). The module differs, so the full path differs.
// Must NOT match.
data filesystem_homonym_identity: QualifiedName =
  qualified_name_from_string_segments(segments: [
    "v2", "test", "fixture", "filesystem_read_homonym", "filesystem_read"
  ])

// GREEN: a callee whose full resolved path IS the primitive identity (the authority value itself) matches.
test fn filesystem_full_identity_callee_matches() -> Bool {
  filesystem_effect_callee_matches_identity(
    callee: read_seam_path(),
    identity: filesystem_primitive_identity
  )
}

// RED (discriminating): a homonym -- SAME last segment, DIFFERENT module -- must NOT match. If the wall
// keyed on the last segment this would wrongly return true (the false-positive arm).
test fn filesystem_homonym_does_not_match() -> Bool {
  ! filesystem_effect_callee_matches_identity(
    callee: filesystem_homonym_identity,
    identity: filesystem_primitive_identity
  )
}

// GREEN (the hole closed): the wall keys on the RESOLVED identity, so the real primitive reached under a
// renamed import (the same resolved authority path arriving again) matches, while a same-named declaration
// in a DIFFERENT module does not -- the pair a last-segment slug test could not tell apart (warm-fox's
// false-negative hole plus A's false positive). The primitive side is the authority value, so it is the real
// spelling both sides carry.
test fn filesystem_renamed_import_still_matches_the_primitive_identity() -> Bool {
  filesystem_effect_callee_matches_identity(
    callee: read_seam_path(),
    identity: filesystem_primitive_identity
  )
    && ! filesystem_effect_callee_matches_identity(
      callee: qualified_name_from_string_segments(segments: [
        "v2", "other", "module", "filesystem_read"
      ]),
      identity: filesystem_primitive_identity
    )
}

// A non-filesystem callee matches neither identity (contributes no reach), so the derived path stays honest
// about what it covers.
test fn filesystem_non_matching_callee_matches_neither_identity() -> Bool {
  let unrelated = qualified_name_from_dotted_string(dotted: "std.algebra.fold_list")
  ! filesystem_effect_callee_matches_identity(callee: unrelated, identity: filesystem_primitive_identity)
}

test fn filesystem_read_direct_reach_refuses() -> Bool {
  let report = filesystem_effect_reach_census(
    population_source: filesystem_effect_emitted_closure_population,
    reaches: Cons { head: filesystem_reach_self_host_roster, tail: Empty }
  )
  (length(xs: report.offenders) == 1)
    && (!filesystem_effect_direct_reach_wall_holds(report: report))
}

// THE CAUSE IS NAMED and the reach is located at its enclosing declaration + occurrence index.
test fn filesystem_read_direct_reach_names_its_cause_and_site() -> Bool {
  match filesystem_effect_reach(
    site: self_host_read_roster_manifest_site,
    operation: "filesystem_read",
    handler_slug: filesystem_handler_slug
  ) {
    ReachedFreePrimitiveDirectly {
      site: site,
      operation: operation,
      cause: _
    } =>
      (site.module_path == "v2.compiler.self_host")
        && (operation == filesystem_free_primitive_slug)
        && (site.enclosing_declaration == "read_roster_manifest")
        && (site.site_occurrence == 1)
    ReachedThroughHandler { site: _, operation: _ } => false
    ReachedOutsideBoundHandler { site: _, operation: _, cause: _ } => false
  }
}

// A THIRD call inside the SAME enclosing declaration is occurrence 2 -- a NEW offender, not a duplicate
// of occurrence 1. This, with the length==2 test above, is what stops the census passing by collapsing
// two sites into one or by growing quietly.
test fn filesystem_a_third_occurrence_in_the_same_declaration_is_a_new_offender() -> Bool {
  let third_site = FilesystemEffectSite {
    module_path: "v2.compiler.self_host",
    enclosing_declaration: "read_roster_manifest",
    site_occurrence: 2
  }
  (filesystem_effect_site_eq(left: third_site, right: self_host_read_roster_manifest_site) == false)
    && (filesystem_effect_site_eq(left: third_site, right: self_host_fold_side_bytes_site) == false)
    && (filesystem_effect_site_eq(left: third_site, right: third_site) == true)
}

// A filesystem operation that is neither the free primitive nor the bound handler's own slug is refused
// as ReachedOutsideBoundHandler with its own named cause -- NOT silently accepted. This is the fix for
// the dead handler_slug: the handler's identity is read, and a reach matching neither the handler nor the
// free primitive is a hole, not a pass-through.
test fn filesystem_reach_neither_handler_nor_primitive_refuses() -> Bool {
  match filesystem_effect_reach(
    site: FilesystemEffectSite {
      module_path: "v2.compiler.unrelated",
      enclosing_declaration: "unrelated_call",
      site_occurrence: 1
    },
    operation: "some_other_free_primitive",
    handler_slug: filesystem_handler_slug
  ) {
    ReachedOutsideBoundHandler {
      site: site,
      operation: operation,
      cause: _
    } => (site.module_path == "v2.compiler.unrelated") && (operation == "some_other_free_primitive")
    ReachedFreePrimitiveDirectly { site: _, operation: _, cause: _ } => false
    ReachedThroughHandler { site: _, operation: _ } => false
  }
}

test fn filesystem_mixed_reach_refuses_only_the_direct_one() -> Bool {
  let report = filesystem_effect_reach_census(
    population_source: filesystem_effect_emitted_closure_population,
    reaches: Cons {
      head: filesystem_reach_through_handler,
      tail: Cons { head: filesystem_reach_self_host_roster, tail: Empty }
    }
  )
  (length(xs: report.offenders) == 1)
    && (!filesystem_effect_direct_reach_wall_holds(report: report))
}

// =============================================================================================
// THE DERIVED POPULATION -- reaches pulled out of the phase-1 rows the resolver's fold PRODUCES, not
// typed by hand in the test (review 98184 finding 1; Manager A condition 2; DESIGN consumption and
// witness_one_interface: the inhabittance claim is over what the REAL producer emits)
// =============================================================================================
// filesystem_effect_reaches_from_phase1_rows maps the SAME list name_resolve's phase-1 fold built
// (ClosureDeclarations.rows) to located reaches. These rows are built through the SAME row type the fold
// emits, with callees as resolved QualifiedNames: the primitive identity is the AUTHORITY value
// read_seam_path() (#v2.std.live_read::filesystem_read -- that declaration is the ONLY declaration of
// filesystem_read in the corpus, shown by the real-roster leg of this witness at run time; extdeps.filesystem.filesystem_io declares NO
// filesystem_read, its member is filesystem_read_outcome, so a filesystem_io fixture would be a claim
// about the tree that is false -- this fixture's homonym spelling is named in filesystem_homonym_fixture_
// spelling below and it is NOT filesystem_io). A HONYM carrying the same last segment but its own module
// path sits INSIDE the scanned tier. The census must refuse the three primitive sites and NOT the homonym
// -- asserted by NAME, so a last-segment wall fails here (false positive) or misses the primitive (the
// hole). A clean real-closure census is bounded by the scope line the census log prints: ambient builtin-
// route calls are counted only where the resolve fold records a resolved callee path, which the executed
// ambient-callee leg must show before a green is read as builtin-route coverage.

// The bound handler's declared identity (src/v1/05_emit_rust.dag emit_file_call), supplied to the census
// as a resolved QualifiedName so the through-handler arm is keyed on identity, not a slug.
data filesystem_handler_identity: QualifiedName =
  qualified_name_from_dotted_string(dotted: "v1.compiler.emit_rust.emit_file_call")

// THE FIXTURE POPULATION LABEL names the fixture closure these rows stand for -- NOT compile_cli. The
// real-closure leg (self_host under compiler_pipeline_entry) is a separate executed leg; labelling a
// fixture run with the production root would print provenance it did not measure.
data filesystem_effect_fixture_closure_population: FilesystemEffectCensusPopulation =
  FilesystemEffectCensusPopulation {
    rule: ^derived_fixture_closure_over_wall_fixture_rows,
    driver_arm: "NativeCliDriver",
    emitted_closure_root_module: "v2.test.claim.filesystem_effect_reach_wall",
    emitted_closure_root_declaration: "filesystem_derived_population_fixture",
    bound_handler: "emit_file_call",
    free_primitive_slug: "filesystem_read"
  }

// Build a row of the SAME type the phase-1 fold emits. `local` carries a synthetic node: the producer
// reads module, name and callees only; the node is the row-type inhabitant, not census data.
fn derived_row(module_path: String, decl: String, callees: List<QualifiedName>) -> DeclPhase1Row {
  DeclPhase1Row {
    module: qualified_name_from_dotted_string(dotted: module_path),
    name: symbol_intern_lexeme(lexeme: decl),
    path: qualified_name_from_dotted_string(dotted: concat(concat(module_path, "."), decl)),
    local: LocallyResolved { node: node_synthetic(kind: TypeNode { connective: Conj }, children: []) },
    callees: callees
  }
}

// THE HONYM: same last segment as the primitive, its OWN module path. This is the fixture spelling the
// census log leg names.
data filesystem_homonym_fixture_spelling: String =
  "v2.test.fixture.wall_population.filesystem_read"

data filesystem_derived_population_rows: List<DeclPhase1Row> = [
  derived_row("v2.compiler.self_host", "read_roster_manifest", [read_seam_path()]),
  derived_row(
    "v2.compiler.self_host",
    "fold_side_bytes",
    [read_seam_path(), qualified_name_from_dotted_string(dotted: "std.algebra.fold_list")]
  ),
  derived_row("v2.compiler.native_census_witness_planted", "planted_direct_read", [read_seam_path()]),
  derived_row(
    "v2.compiler.self_host",
    "local_filesystem_read_holder",
    [qualified_name_from_dotted_string(dotted: filesystem_homonym_fixture_spelling)]
  ),
  derived_row("v2.cli.compile_cli", "compiled_closure", [filesystem_handler_identity])
]

data filesystem_derived_census_report: FilesystemEffectCensusReport =
  filesystem_effect_emitted_closure_census(
    population_source: filesystem_effect_fixture_closure_population,
    rows: filesystem_derived_population_rows,
    free_primitive_identity: filesystem_primitive_identity,
    bound_handler_identity: filesystem_handler_identity,
    bound_handler_slug: filesystem_handler_slug
  )

// THE DERIVED CENSUS REFUSES EXACTLY THE THREE PRIMITIVE SITES, named. The derived producer -- not a
// hand-typed reach list -- located them.
test fn filesystem_derived_census_refuses_the_three_primitive_sites_by_name() -> Bool {
  let report = filesystem_derived_census_report
  (length(xs: report.offenders) == 3)
    && any(
      xs: report.offenders,
      predicate: fn(o) {
        filesystem_effect_site_eq(
          left: filesystem_effect_reach_site(reach: o),
          right: self_host_read_roster_manifest_site
        )
      }
    )
    && any(
      xs: report.offenders,
      predicate: fn(o) {
        filesystem_effect_site_eq(
          left: filesystem_effect_reach_site(reach: o),
          right: self_host_fold_side_bytes_site
        )
      }
    )
    && any(
      xs: report.offenders,
      predicate: fn(o) {
        filesystem_effect_site_eq(
          left: filesystem_effect_reach_site(reach: o),
          right: FilesystemEffectSite {
            module_path: "v2.compiler.native_census_witness_planted",
            enclosing_declaration: "planted_direct_read",
            site_occurrence: 1
          }
        )
      }
    )
}

// THE HONYM IS NOT REFUSED -- and not merely "not an offender": it produces NO REACH AT ALL, so a
// last-segment wall would show it here as a false-positive offender. The non-filesystem callee
// (std.algebra.fold_list) likewise produced no reach (fold_side_bytes contributed exactly one).
test fn filesystem_derived_census_refuses_neither_the_homonym_nor_a_non_filesystem_callee() -> Bool {
  let report = filesystem_derived_census_report
  (any(
    xs: report.reaches,
    predicate: fn(r) {
      filesystem_effect_reach_site(reach: r).enclosing_declaration == "local_filesystem_read_holder"
    }
  ) == false)
    && (length(xs: report.reaches) == 4)
}

// THE HANDLER ARM AUTHORISES: the row whose callee is the bound handler's identity reaches through the
// handler and keeps the wall green over a handler-only population.
test fn filesystem_derived_handler_row_is_authorised_and_wall_holds() -> Bool {
  let handler_only = filesystem_effect_emitted_closure_census(
    population_source: filesystem_effect_fixture_closure_population,
    rows: [derived_row("v2.cli.compile_cli", "compiled_closure", [filesystem_handler_identity])],
    free_primitive_identity: filesystem_primitive_identity,
    bound_handler_identity: filesystem_handler_identity,
    bound_handler_slug: filesystem_handler_slug
  )
  (length(xs: handler_only.offenders) == 0)
    && (length(xs: handler_only.reaches) == 1)
    && filesystem_effect_direct_reach_wall_holds(report: handler_only)
}

// THE WALL DOES NOT HOLD over the derived population -- the refusal fires on the PRODUCED reaches.
test fn filesystem_derived_population_breaks_the_wall() -> Bool {
  ! filesystem_effect_direct_reach_wall_holds(report: filesystem_derived_census_report)
}

// THE CENSUS LOG PRINTS THE CONTRACT BESIDE THE REFUSED COUNT, PRINTS THE CONTRACT TRAVERSAL (warm-fox
// condition 1), AND NAMES EACH OFFENDER SITE. The asserted substrings cannot be echoed from an input: no
// row input contains "offender ", "debt_site ", the "#" joiner, or "refused=" -- the log fn ASSEMBLES those
// lines from the census and the typed contract. (The test NAME keeps the old "bound" word only because the
// srv1 leg list is keyed on it; the bound itself was deleted per review 98447.)
test fn filesystem_census_log_names_refused_count_bound_and_three_sites() -> Bool {
  let log = filesystem_effect_census_log(report: filesystem_derived_census_report)
  string_contains(
    s: log,
    pattern: "refused=3 contract_sites=4 contract_distinct=4"
  )
    && string_contains(s: log, pattern: "debt_site v2.compiler.self_host#read_roster_manifest#1")
    && string_contains(s: log, pattern: "debt_site v2.compiler.self_host#fold_side_bytes#1")
    && string_contains(s: log, pattern: "debt_site v2.workflow.compile_door_ledger#ledger_read_witness#1")
    && string_contains(s: log, pattern: "debt_site v2.workflow.compile_door_ledger#door_ledger_row#1")
    && string_contains(s: log, pattern: "offender v2.compiler.self_host#read_roster_manifest#1")
    && string_contains(s: log, pattern: "offender v2.compiler.self_host#fold_side_bytes#1")
    && string_contains(
      s: log,
      pattern: "offender v2.compiler.native_census_witness_planted#planted_direct_read#1"
    )
    && string_contains(
      s: log,
      pattern: "arms: derived=free_primitive_direct(refused) and through_handler(authorised)"
    )
    && string_contains(s: log, pattern: "ReachedOutsideBoundHandler is supplied-population-only")
    && string_contains(s: log, pattern: "ambient builtin-route calls are counted only where")
    && (string_contains(s: log, pattern: "offender v2.compiler.self_host#local_filesystem_read_holder")
      == false)
}

// =============================================================================================
// THE DEBT CONTRACT (review 98447 finding 1, Manager B formulation): a MONOTONE IDENTITY-GRAIN JOIN,
// exercised in BOTH refusal directions on fixture input plus a green control. No number here is copied
// from a tree; every count is derived by the run that claims it. FIXTURE-EXERCISED ONLY (Manager A,
// review 98447 re-ask): the reaches below come from derived_row fixtures, so these legs prove the join
// PREDICATES fire on planted input -- they cannot catch a corpus rename (contract and fixture drift
// together). The real-reach observation is the two scratch probe trees run outside this witness (the
// census run itself refuses), and the real-closure join leg is deferred to Manager B's establishing
// roadmap row for this instrument.
// =============================================================================================

// Rows spelling EXACTLY the four contracted sites: two #v2.compiler.self_host declarations and two
// #v2.workflow.compile_door_ledger declarations, each with the real primitive as a phase-1 callee.
data filesystem_contract_rows: List<DeclPhase1Row> = [
  derived_row("v2.compiler.self_host", "read_roster_manifest", [read_seam_path()]),
  derived_row("v2.compiler.self_host", "fold_side_bytes", [read_seam_path()]),
  derived_row("v2.workflow.compile_door_ledger", "ledger_read_witness", [read_seam_path()]),
  derived_row("v2.workflow.compile_door_ledger", "door_ledger_row", [read_seam_path()])
]

fn contract_census(rows: List<DeclPhase1Row>) -> FilesystemEffectCensusReport {
  filesystem_effect_emitted_closure_census(
    population_source: filesystem_effect_fixture_closure_population,
    rows: rows,
    free_primitive_identity: filesystem_primitive_identity,
    bound_handler_identity: filesystem_handler_identity,
    bound_handler_slug: filesystem_handler_slug
  )
}

// GREEN CONTROL: the census over exactly the contracted population locates all four, the wall refuses
// (four direct reaches), and the identity join HOLDS -- contract within reaches and reaches within
// contract, both directions, in the run that claims it.
test fn filesystem_contract_census_joins_and_refuses_all_four() -> Bool {
  let report = contract_census(rows: filesystem_contract_rows)
  (length(xs: report.offenders) == 4)
    && filesystem_effect_debt_join_holds(reaches: report.reaches)
    && (!filesystem_effect_direct_reach_wall_holds(report: report))
}

// RED DIRECTION (a) -- UNKNOWN REACH (Manager B's required arm): a fifth direct reach at a site that is
// NOT a contract member must break the join by name while the four known ones stay located. The wall
// alone would already refuse this (fail_closed); the join is what proves the CONTRACT bites.
test fn filesystem_contract_join_refuses_unknown_reach() -> Bool {
  let report = contract_census(
    rows: list_append(
      left: filesystem_contract_rows,
      right: [derived_row("v2.compiler.native_census_witness_planted", "planted_direct_read", [read_seam_path()])]
    )
  )
  (length(xs: report.offenders) == 5)
    && (!filesystem_effect_debt_join_holds(reaches: report.reaches))
}

// RED DIRECTION (b) -- CENSUS INCOMPLETE (Manager B's required arm): every reach present is a contract
// member, but one member is not reached at all. A join that only checked "reaches within contract"
// would GREEN this -- the completeness direction refuses it: a census that never sees a contracted debt
// is blind, not clean.
test fn filesystem_contract_join_refuses_unreached_member() -> Bool {
  let report = contract_census(
    rows: [
      derived_row("v2.compiler.self_host", "read_roster_manifest", [read_seam_path()]),
      derived_row("v2.compiler.self_host", "fold_side_bytes", [read_seam_path()]),
      derived_row("v2.workflow.compile_door_ledger", "ledger_read_witness", [read_seam_path()])
    ]
  )
  (length(xs: report.offenders) == 3)
    && (!filesystem_effect_debt_join_holds(reaches: report.reaches))
}

// UNIQUE GRAIN (warm-fox condition 3): four members, four DISTINCT identity strings -- a collision
// cannot hide a three-member contract behind four entries. The route that owns each identity is the
// DIRECT reach (the instrument face on filesystem_effect_direct_reach_debt_contract says so).
test fn filesystem_contract_identity_grain_is_duplicate_free() -> Bool {
  (length(xs: filesystem_effect_direct_reach_debt_contract) == 4)
    && (filesystem_effect_debt_contract_distinct_count() == 4)
}

// =============================================================================================
// WALL 1 -- new demand_restatement row
// =============================================================================================

// Map a REAL retained row (NonEmptyStr fields + a trigger) down to the wall's row identity.
fn restatement_row_of(retained: DemandRestatementRetainedRow) -> DemandRestatementRow {
  DemandRestatementRow {
    module_path: retained.module_path as String,
    declaration: retained.declaration as String,
    alias: retained.alias as String,
    authored_type: retained.authored_type as String
  }
}

// THE REAL ROSTER, built in single-pipe stages (the proven idiom in dag/product/fabric): map each real
// retained population down to the wall's identity type, then append. The wall runs over THESE rows, not
// over hand-built stand-ins, so the green control exercises the real producer over an executing route.
data real_restatement_fn_rows: List<DemandRestatementRow> =
  demand_restatement_retained_fn_rows |> map(r => restatement_row_of(retained: r))

data real_restatement_pattern_rows: List<DemandRestatementRow> =
  demand_restatement_retained_pattern_rows |> map(r => restatement_row_of(retained: r))

data real_restatement_roster: List<DemandRestatementRow> =
  real_restatement_fn_rows |> concat(real_restatement_pattern_rows)

// GREEN by the real producer: the wall holds when the arriving population IS the real retained roster,
// and the real population is non-empty (an empty population is VOID, not green).
test fn demand_restatement_wall_holds_on_the_real_roster() -> Bool {
  (length(xs: real_restatement_roster) > 0)
    && (demand_restatement_wall_holds(arriving: real_restatement_roster, roster: real_restatement_roster))
}

// RED over the REAL roster: a brand-new row that is not among the real retained rows refuses, and the
// wall flips to false. The discriminator is real population + one new row, not a synthetic fixture.
test fn demand_restatement_new_row_refuses_against_the_real_roster() -> Bool {
  let newcomer = DemandRestatementRow {
    module_path: "v2.compiler.brand_new_restatement",
    declaration: "a_restated_demand_never_retained",
    alias: "NeverRetained",
    authored_type: "std.resources.Filesystem"
  }
  let arriving = Cons { head: newcomer, tail: real_restatement_roster }
  (length(xs: demand_restatement_new_row_refusals(arriving: arriving, roster: real_restatement_roster)) == 1)
    && (!demand_restatement_wall_holds(arriving: arriving, roster: real_restatement_roster))
}

// A real retained row, arriving, is AUTHORIZED (the wall does not refuse the rows it should carry).
test fn demand_restatement_real_retained_row_is_authorized() -> Bool {
  match demand_restatement_retained_fn_rows {
    Cons { head: first_real_row, tail: _ } =>
      match demand_restatement_row_verdict(row: restatement_row_of(retained: first_real_row), roster: real_restatement_roster) {
        AuthorizedRow { row: _ } => true
        NewRestatementRowRefused { row: _, cause: _ } => false
      }
    Empty => false
  }
}
