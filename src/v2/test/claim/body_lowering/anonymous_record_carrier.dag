module v2.test.claim.body_lowering.anonymous_record_carrier

// CENSUS GROUP resolve_anonymous_record_no_expected_type: THE REFUSAL BELONGS TO THE MISSING CARRIER,
// IS LOCATED AT EACH HEADLESS ELEMENT, AND MANUFACTURES NOTHING.
//
// The whole-tree census carried 93 of these (measured at e629787afb7 by
// //gunbc/instruments:v2-native-census-scoped: residual_rows=17887, cause_groups=12; this group = 93 --
// dag/std/algebra.dag 77, dag/std/coercion.dag 8, dag/std/syntax.dag 8). At every one the author had
// ALREADY written the annotation -- `data x: List<T> = [ { f: v } ]` -- and the refusal's cause was that
// the module does not carry the name `List`: the annotation is then an unresolvable head, no expectation
// reaches the element, and resolve refuses AT THE ELEMENT rather than inventing a structural type (the
// plan docs/plans/anonymous-record-literal-design.md, and the authority v2.compiler.resolve
// resolve_anonymous_record_refused: "Nothing is inferred, unified or substituted here"). So these are
// not untyped sources and resolve is not defective -- it refuses precisely because it will NOT infer.
// The fix is the carrier, which is a name-home fact, not a resolve change.
//
// THE DISCRIMINATOR IS THE CARRIER IMPORT AND NOTHING ELSE. The specimens share one shape: three headless
// records, two in a `List<ArB>` data initializer and one in a `List<ArB>` return. The RED pair and the
// POSITIVE pair differ on exactly ONE line -- `import std.algebra { FreeMonoid }` versus `import
// v2.test.arc_types { List }`, the module's own carrier. Each has a HEADED twin whose elements name `ArB`
// themselves, so "the RED module simply fails for its own sake" cannot be what keeps this green: the RED
// headed twin must resolve clean on the SAME route, and the POSITIVE headless must elaborate to the SAME
// qualified constructs as the RED headed twin. `Bool` is imported on both sides, so "it was the extra
// import" is not available either.
//
// WHY THE CLAIM READS RESOLVE AND NOT THE CENSUS ROUTE. The census row route
// (v2.compiler.source_root_eval native_census_residual_rows, v2.compiler.native_test_vocabulary
// FileRefusalAt*) cannot be entered by any claim on main today: naming those symbols refuses every test in
// the file with cause=resolve_reason_declarer_refused, at chain head resolve_reason_unbound_symbol @
// dag/std/content_hash.dag bytes 8030..8035 (`chars`, declared nowhere in the corpus). That is NOT caused
// by this file -- the untouched precedent //v2/test/claim/native_census/located_refusal:all refuses
// identically (A/B'd at the same sha), and the census instrument itself runs because its closure does not
// cross that declarer. The measure for the census group is therefore the instrument's own reading (before:
// 93 rows, all cascade None; after: 16 fewer), and what is pinned HERE is the claim-grade fact about the
// same group, at the stage that actually refuses: v2.compiler.resolve's outcome for the identical shapes.
//
// THE SPECIMENS LIVE HERE AND NOWHERE ELSE. They deliberately refuse, so they sit in their own ingest: a
// claim module that reads a whole ingest (v2.test.claim.body_lowering.anonymous_record's ar_ingest, ~30
// claims) is poisoned by any refusing source inside it -- every claim there then refuses at prepare with
// cause=positive_population_empty.

import std.algebra { Cons, Empty, FreeMonoid, list_snoc_item }
import std.optional { Absent, Optional, Present }
import std.types { Bool, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
  resolution_context,
  resolve_in_context
}
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.cross_tree.resolution { source_root_index_empty }
import v2.std.diagnostic {
  Accepted,
  DeclarationLocus,
  InvariantPortLocus,
  Locus,
  NodeLocus,
  Outcome,
  Rejected,
  SourcePortLocus,
  Textual
}
import v2.std.node { Atom, Node, Symbol, TypeNode, node_subtree_nodes, symbol_lexeme }
import v2.std.node_query { ConstructTagElided, construct_tag_reading, construct_tag_path_optional }
import v2.std.qualified_name { qualified_name_from_dotted_string, qualified_name_to_dotted_string }
import v2.std.text { String }
import v2.std.resolution_policy { default_name_resolution_policy }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE PROVIDER: ArB is the only record in the tree whose fields are `{ n, m }`, so the headless
// elements' field set identifies it uniquely -- a chooser that read field NAMES (the ruled-out leniency,
// and the v1 seed's way) would elaborate too, and the LOCUS test below is what reds it instead.
data arc_provider_source: String = "module v2.test.arc_p\n\nimport std.types { Bool }\n\ntype ArB {\n  n: Bool\n  m: Bool\n}\n"

// THE ALIASED CARRIER, written where the census files' authors could not write it: dag/std/*.dag cannot
// reach a std.algebra type without a cycle (std.types -> std.algebra), which is the home-table question
// routed to Manager 3 with that cycle as the decisive input.
data arc_types_source: String = "module v2.test.arc_types\n\nimport std.algebra { FreeMonoid }\n\ntype List<element> = FreeMonoid<element>\n"

// RED: the annotation `List<ArB>` is written on three declarations and the module does NOT carry `List`.
// The three headless records sit at lines 8, 9 and 12.
data arc_red_source: String = "module v2.test.arc_red\n\nimport std.types { Bool }\nimport std.algebra { FreeMonoid }\nimport v2.test.arc_p { ArB }\n\ndata arc_entries: List<ArB> = [\n  { n: true, m: false },\n  { n: false, m: true }\n]\n\nfn arc_ret() -> List<ArB> { [{ n: true, m: true }] }\n"

// RED's HEADED TWIN: same module, same lines, each element names ArB itself.
data arc_red_headed_source: String = "module v2.test.arc_red_headed\n\nimport std.types { Bool }\nimport std.algebra { FreeMonoid }\nimport v2.test.arc_p { ArB }\n\ndata arc_entries: List<ArB> = [\n  ArB { n: true, m: false },\n  ArB { n: false, m: true }\n]\n\nfn arc_ret() -> List<ArB> { [ArB { n: true, m: true }] }\n"

// POSITIVE CONTROL: differs from RED on line 4 alone -- the carrier is carried.
data arc_pos_source: String = "module v2.test.arc_pos\n\nimport std.types { Bool }\nimport v2.test.arc_types { List }\nimport v2.test.arc_p { ArB }\n\ndata arc_entries: List<ArB> = [\n  { n: true, m: false },\n  { n: false, m: true }\n]\n\nfn arc_ret() -> List<ArB> { [{ n: true, m: true }] }\n"

// POSITIVE CONTROL's HEADED TWIN.
data arc_pos_headed_source: String = "module v2.test.arc_pos_headed\n\nimport std.types { Bool }\nimport v2.test.arc_types { List }\nimport v2.test.arc_p { ArB }\n\ndata arc_entries: List<ArB> = [\n  ArB { n: true, m: false },\n  ArB { n: false, m: true }\n]\n\nfn arc_ret() -> List<ArB> { [ArB { n: true, m: true }] }\n"

// THE CARRIER WRITTEN DIRECTLY, with no alias in the way: the annotation names `FreeMonoid<ArB>` itself,
// the head std.algebra really declares (dag/std/algebra.dag type FreeMonoid). This is the pass-proven
// shape of the in-repo control v2.test.claim.body_lowering.anonymous_record's ar_list_headless_source.
// It isolates the ALIAS as a variable: if the headless form closes under `FreeMonoid` but not under a
// `type List<element> = FreeMonoid<element>` carrier, the 16 acyclic sites are not closed by an import
// alone and the after-census reading is what says so -- this pair cannot be quietly true while that is false.
data arc_direct_headless_source: String = "module v2.test.arc_direct_headless\n\nimport std.types { Bool }\nimport std.algebra { FreeMonoid }\nimport v2.test.arc_p { ArB }\n\ndata arc_entries: FreeMonoid<ArB> = [\n  { n: true, m: false },\n  { n: false, m: true }\n]\n\nfn arc_ret() -> FreeMonoid<ArB> { [{ n: true, m: true }] }\n"

data arc_direct_headed_source: String = "module v2.test.arc_direct_headed\n\nimport std.types { Bool }\nimport std.algebra { FreeMonoid }\nimport v2.test.arc_p { ArB }\n\ndata arc_entries: FreeMonoid<ArB> = [\n  ArB { n: true, m: false },\n  ArB { n: false, m: true }\n]\n\nfn arc_ret() -> FreeMonoid<ArB> { [ArB { n: true, m: true }] }\n"

fn arc_read(source: String, id: Symbol, unit: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: unit,
    source_root: DagTree
  }
}

data arc_ingest: SourceRootIngest = Cons { head: arc_read(source: arc_provider_source, id: ^arc_provider_read, unit: ^arc_provider_cu, path: "src/v2/test/fixture/anonymous_record/provider.dag"), tail: Cons { head: arc_read(source: arc_types_source, id: ^arc_types_read, unit: ^arc_types_cu, path: "src/v2/test/fixture/anonymous_record/carrier_types.dag"), tail: Cons { head: arc_read(source: arc_red_source, id: ^arc_red_read, unit: ^arc_red_cu, path: "src/v2/test/fixture/anonymous_record/carrier_red.dag"), tail: Cons { head: arc_read(source: arc_red_headed_source, id: ^arc_red_headed_read, unit: ^arc_red_headed_cu, path: "src/v2/test/fixture/anonymous_record/carrier_red_headed.dag"), tail: Cons { head: arc_read(source: arc_pos_source, id: ^arc_pos_read, unit: ^arc_pos_cu, path: "src/v2/test/fixture/anonymous_record/carrier_pos.dag"), tail: Cons { head: arc_read(source: arc_pos_headed_source, id: ^arc_pos_headed_read, unit: ^arc_pos_headed_cu, path: "src/v2/test/fixture/anonymous_record/carrier_pos_headed.dag"), tail: Cons { head: arc_read(source: arc_direct_headless_source, id: ^arc_direct_headless_read, unit: ^arc_direct_headless_cu, path: "src/v2/test/fixture/anonymous_record/direct_headless.dag"), tail: Cons { head: arc_read(source: arc_direct_headed_source, id: ^arc_direct_headed_read, unit: ^arc_direct_headed_cu, path: "src/v2/test/fixture/anonymous_record/direct_headed.dag"), tail: Empty } } } } } } } }

// THE FRONT END RUNS ONCE, THROUGH THE PRODUCTION ROUTE -- tokenize, parse, normalize, resolve -- as in
// v2.test.claim.body_lowering.map_literal's ml_resolve_subject and anonymous_record's ar_* producers.
fn arc_resolve(subject: String) -> Outcome<ResolvedTree> {
  match module_roots_from_source_root_ingest(ingest: arc_ingest, lm: dag_language_model()) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: roots, diagnostics: _ } =>
      resolve_in_context(
        context: resolution_context(
          lm: dag_language_model(),
          roots: roots,
          index: source_root_index_empty(),
          active_roots: Empty,
          policy: default_name_resolution_policy()
        ),
        admission: Admission {
          subject: ResolutionSubject { name: qualified_name_from_dotted_string(dotted: subject) },
          imports: Empty
        }
      ).resolved
  }
}

// EVERY REASON IN A REFUSAL'S CHAIN, as lexemes, in order. The claim reads the CHAIN, not one slot in
// it: a refusal under an unresolvable head legitimately carries the head's own `List` complaint too, and
// an assertion pinned to whichever diagnostic the chain happens to report last would red on ordering
// churn while saying nothing about this group. "<accepted>" is reported by an accepting outcome, so a
// claim that demands the refusal cannot be satisfied by one.
fn arc_reasons(o: Outcome<ResolvedTree>) -> List<String> {
  match o {
    Accepted { value: _, diagnostics: _ } => Empty
    Rejected { diagnostics: d } =>
      fold(d.tail, init: Cons { head: symbol_lexeme(sym: d.head.reason), tail: Empty }, f: fn(acc, diag) {
        list_snoc_item(xs: acc, item: symbol_lexeme(sym: diag.reason))
      })
  }
}

// THE LOCUS OF THE REFUSAL THIS GROUP OWNS, taken from the chain by its reason -- so the position that is
// pinned is the position of the anonymous-record refusal, and nothing else in the chain can stand in.
fn arc_locus_of(o: Outcome<ResolvedTree>, reason: Symbol) -> Optional<Locus> {
  match o {
    Accepted { value: _, diagnostics: _ } => Absent
    Rejected { diagnostics: d } => {
      fold(Cons { head: d.head, tail: d.tail }, init: Absent, f: fn(acc, diag) {
        match acc {
          Present { value: _ } => acc
          Absent => if diag.reason == reason { Present { value: diag.at } } else { acc }
        }
      })
    }
  }
}

fn arc_has_reason(o: Outcome<ResolvedTree>, reason: String) -> Bool {
  fold(arc_reasons(o: o), init: false, f: fn(acc, r) { acc || (r == reason) })
}

// THE HEADED CONSTRUCTS OF A RESOLVED TREE, in tree order, as dotted strings -- read the way the
// pass-proven in-repo control reads them (v2.test.claim.body_lowering.anonymous_record ar_construct_paths:
// v2.std.node_query construct_tag_path_optional, then v2.std.qualified_name qualified_name_to_dotted_string).
// A literal whose constructor was never decided reports NO path at all, so this reading is what reds the
// ruled-out leniency: nothing here accepts a silently structural record, and every positive arm must name
// the record it elaborated to.
fn arc_construct_paths(o: Outcome<ResolvedTree>) -> List<String> {
  match o {
    Rejected { diagnostics: _ } => Empty
    Accepted { value: t, diagnostics: _ } =>
      fold(node_subtree_nodes(root: t.root), init: Empty, f: fn(acc, n) {
        match construct_tag_path_optional(n: n) {
          Present { value: path } => list_snoc_item(xs: acc, item: qualified_name_to_dotted_string(qn: path))
          Absent => acc
        }
      })
  }
}

// THE THREE ELABORATED CONSTRUCTS, as data. Built with Cons/Empty rather than a list literal on purpose:
// a `[..]` literal is elaborated through v2.std.list_introduction's head path
// (std.algebra.FreeMonoid), and that path does NOT resolve in a claim module today -- the pass-proven
// precedent v2.test.claim.body_lowering.anonymous_record refuses ALL 12 of its claims at exactly that
// construction on pure origin/main (A/B'd: identical verdicts with my two tree files reverted), so this
// file keeps literals out of its own text and pins the census group through the instrument instead.
fn arc_three_arb_paths() -> List<String> {
  Cons {
    head: "v2.test.arc_p.ArB",
    tail: Cons { head: "v2.test.arc_p.ArB", tail: Cons { head: "v2.test.arc_p.ArB", tail: Empty } }
  }
}

// A node whose construct tag is ELIDED -- an authored `{ f: v }`. construct_tag_reading is the authority
// the design names for that test.
fn arc_is_elided(n: Node) -> Bool {
  construct_tag_reading(n: n) == ConstructTagElided
}

fn arc_carries_keyword(n: Node, id: Symbol) -> Bool {
  fold(node_subtree_nodes(root: n), init: false, f: fn(acc, m) {
    acc || match m.kind {
      TypeNode { connective: Atom { identity: a } } => a == id
      _ => false
    }
  })
}

// DISCRIMINATING, AND THE WHOLE POINT OF THE GROUP: a headless shape under an unresolvable head refuses
// THIS reason. The census's 93 sites are this shape at scale -- the author wrote the annotation, the
// module did not carry the head's name, so no expectation reached the element. A resolve that inferred a
// structural record would ACCEPT, and this reds.
test fn arc_a_headless_shape_under_an_unresolvable_head_refuses_this_reason_holds() -> Bool {
  let red = arc_resolve(subject: "v2.test.arc_red")
  match red {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => arc_has_reason(o: red, reason: "resolve_anonymous_record_no_expected_type")
  }
}

// NEVER YIELDS A STRUCTURAL TYPE, AND IS LOCATED AT THE ELEMENT. (a) No tree escapes the refusal at all,
// so no elided literal survives with a constructor guessed from its field set -- ArB is the only record in
// this tree with fields `n, m`, so a field-name chooser (the ruled-out leniency, and the v1 seed's way)
// would have elaborated here and this claim would red. (b) The refusal is pinned to the ELIDED LITERAL as
// a NodeLocus, never the annotation's node: an anchor that had moved up to the enclosing `fn` carries that
// keyword in its subtree and reds this, and a Textual, SourcePort or Declaration locus reds it too -- only
// a refusal at the element tells an author which of three records to fix.
test fn arc_the_refusal_is_located_at_the_element_and_yields_no_tree_holds() -> Bool {
  let red = arc_resolve(subject: "v2.test.arc_red")
  match red {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => match arc_locus_of(o: red, reason: ^resolve_anonymous_record_no_expected_type) {
      Absent => false
      Present { value: loc } => match loc {
        NodeLocus { anchor: a } =>
          arc_is_elided(n: a.at)
            && !arc_carries_keyword(n: a.at, id: ^dag_token_kw_fn)
            && !arc_carries_keyword(n: a.at, id: ^dag_token_kw_let)
        Textual { file: _, extent: _ } => false
        SourcePortLocus { anchor: _, file: _, extent: _ } => false
        DeclarationLocus { declaration: _ } => false
        InvariantPortLocus { anchor: _, invariant: _ } => false
      }
    }
  }
}

// POSITIVE CONTROL, RUN (1) -- THE SHAPE IS NOT THE PROBLEM. The RED twin with every element headed
// (ArB written at all three positions, everything else byte-identical: same module, same three elements,
// same list, same annotations) resolves clean and elaborates its three constructs. So the refusal above
// cannot be blamed on the module, its `Bool` import, the list, or the route.
test fn arc_elements_that_name_their_constructor_elaborate_holds() -> Bool {
  (arc_reasons(o: arc_resolve(subject: "v2.test.arc_red_headed")) == Empty)
    && (arc_construct_paths(o: arc_resolve(subject: "v2.test.arc_red_headed")) == arc_three_arb_paths()
}

// POSITIVE CONTROL, RUN (2) -- THE CARRIER CLOSES THE GROUP BY ELABORATING. The byte-identical module
// with the carrier on line 4 elaborates its three HEADLESS elements to exactly the constructs the headed
// twin elaborates: named, in order, three of them. A lingering "<elided>", a wrong record, or a fourth or
// missing construct reds this. This is the census group's after-state in miniature: not fewer refusals,
// records with their constructors elaborated.
test fn arc_with_the_carrier_the_headless_form_elaborates_like_its_headed_form_holds() -> Bool {
  (arc_reasons(o: arc_resolve(subject: "v2.test.arc_pos")) == Empty)
    && (arc_construct_paths(o: arc_resolve(subject: "v2.test.arc_pos")) == arc_three_arb_paths()
}

// THE CARRIER, WRITTEN AS ITS OWN HEAD, CLOSES THE SAME THREE POSITIONS. The census's 16 acyclic sites
// name an ALIAS (`List<...>`, where std.types writes `type List<element> = FreeMonoid<element>`); this pair
// names the aliased head `FreeMonoid` directly and is the shape the in-repo control
// v2.test.claim.body_lowering.anonymous_record's ar_list_headless_source already proves passes. If the
// alias were what kept a headless literal unresolved, this claim would stay green while the after-census
// reading stayed at 93 -- so the two readings together, not either alone, are what closes the group.
test fn arc_a_head_literal_under_a_directly_named_head_elaborates_holds() -> Bool {
  (arc_reasons(o: arc_resolve(subject: "v2.test.arc_direct_headless")) == Empty)
    && (arc_construct_paths(o: arc_resolve(subject: "v2.test.arc_direct_headless")) == arc_three_arb_paths()
    && (arc_construct_paths(o: arc_resolve(subject: "v2.test.arc_direct_headed"))
      == arc_three_arb_paths())
}

// THE CARRIER IS THE ONLY DIFFERENCE, BOTH WAYS AND AT ONCE, so the pair cannot drift apart: RED refuses,
// POSITIVE accepts, and the two sources differ on one import line. This is the claim-grade form of the
// census before/after (93 -> 77 once the 16 acyclic sites carry their head), measured by the instrument.
test fn arc_the_carrier_alone_flips_the_verdict_holds() -> Bool {
  (arc_has_reason(o: arc_resolve(subject: "v2.test.arc_red"), reason: "resolve_anonymous_record_no_expected_type"))
    && (arc_reasons(o: arc_resolve(subject: "v2.test.arc_pos")) == Empty)
}
