module v2.test.claim.body_lowering.infer_transform_binary_infix_witness_test

import v2.compiler.infer {
  infer,
  inferred_facts_grounding_derived,
  inferred_facts_witness_for_node
}
import v2.compiler.resolve { resolve }
import v2.extdeps.languages.dag {
  dag_int_literal_fixture_one,
  dag_int_literal_fixture_two,
  dag_language_model
}
import v2.std.compilers.body_lowering { lower_binary_infix }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Node,
  Transform,
  TypeNode,
  node_synthetic
}
import v2.std.node_query { find_arrow_body_child }
import v2.std.optional { Absent, Optional, Present }
import v2.std.witness { Holds, Violates }
import v2.test.claim.body_lowering.wave1_gate1_normalize_add_helpers {
  wave1_gate1_find_arrow_in_module,
  wave1_gate1_normalized_add_module
}

data infer_transform_binary_infix_witness_note: String = "v2-inferred-tree-completeness: first Transform derivation rule (binary infix Int add). Measures diagnostic delta on the real add_probe normalize-resolve-infer vertical — Transform body moves to DerivedGrounding while Arrow remains on the GroundingNotDerived frontier until its rule lands. Non-add binary infix (subtract fixture) stays Accepted + frontier — dispatch is gated on infer_transform_is_binary_infix_int_add_shape, not unconditional Transform routing. Production direct-rust-door group may stay red; this witness is the per-kind instrument."

fn infer_transform_subtract_fixture() -> Node {
  lower_binary_infix(
    left: dag_int_literal_fixture_one(),
    operator: node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^dag_token_minus } },
      children: []
    ),
    right: dag_int_literal_fixture_two()
  )
}

fn infer_transform_witness_resolved_add_arrow() -> Optional<Node> {
  match wave1_gate1_normalized_add_module() {
    Absent => Absent
    Present { value: tree } =>
      match resolve(tree: tree, lm: dag_language_model()) {
        Accepted { value: resolved, diagnostics: _ } =>
          wave1_gate1_find_arrow_in_module(root: resolved)
        Rejected { diagnostics: _ } => Absent
      }
  }
}

fn infer_transform_witness_add_body(arrow: Node) -> Optional<Node> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } => Present { value: body }
        _ => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

test fn infer_transform_add_body_derived_grounding_holds() -> Bool {
  match infer_transform_witness_resolved_add_arrow() {
    Absent => false
    Present { value: arrow } =>
      match infer_transform_witness_add_body(arrow: arrow) {
        Absent => false
        Present { value: body } =>
          match infer(tree: arrow) {
            Accepted { value: tree, diagnostics: _ } =>
              match inferred_facts_witness_for_node(tree: tree, node: body) {
                Holds { value: facts } => inferred_facts_grounding_derived(facts: facts)
                Violates { diagnostic: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

test fn infer_transform_add_arrow_remains_frontier_holds() -> Bool {
  match infer_transform_witness_resolved_add_arrow() {
    Absent => false
    Present { value: arrow } =>
      match infer(tree: arrow) {
        Accepted { value: tree, diagnostics: _ } =>
          match inferred_facts_witness_for_node(tree: tree, node: arrow) {
            Holds { value: facts } => !inferred_facts_grounding_derived(facts: facts)
            Violates { diagnostic: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
  }
}

test fn infer_transform_non_add_remains_frontier_holds() -> Bool {
  let body = infer_transform_subtract_fixture()
  match infer(tree: body) {
    Accepted { value: tree, diagnostics: _ } =>
      match inferred_facts_witness_for_node(tree: tree, node: body) {
        Holds { value: facts } => !inferred_facts_grounding_derived(facts: facts)
        Violates { diagnostic: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
