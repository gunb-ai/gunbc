module v2.test.claim.body_lowering.infer_transform_binary_infix_witness_test

import v2.compiler.infer { infer }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.test.claim.body_lowering.infer_transform_binary_infix_witness_helpers {
  infer_transform_subtract_fixture
}

// Subtract is a reached Transform with no modeled operator Arrow, so the application-argument
// inhabitance judgment cannot name a declared parameter type and must refuse (never assume
// compatible). Add vertical discriminating receipt remains on FalsifierSubstrateLongLane.

test fn infer_transform_non_add_remains_frontier_holds() -> Bool {
  match infer(tree: infer_transform_subtract_fixture()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: nds } =>
      nds.head.reason == ^application_parameter_type_not_derived
  }
}
