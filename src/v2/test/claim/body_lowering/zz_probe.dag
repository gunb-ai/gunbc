module v2.test.claim.body_lowering.zz_probe

import v2.compiler.reference_conservation_admission { conserved_normalize_of_text, no_explained_drops }
import v2.test.claim.body_lowering.normalize_outcome_helpers { body_lowering_normalize_outcome }
import v2.test.claim.body_lowering.wave1_gate1_b1_bare_call_helpers {
  wave1_gate1_b1_normalized_module,
  wave1_gate1_b1_find_named_fn_arrow_body,
  wave1_gate1_b1_bare_call_module_source,
  wave1_gate1_b1_builtin_call_module_source
}

fn where_retained(src: String) -> String {
  match conserved_normalize_of_text(path: "p", text: src, explained: no_explained_drops()) {
    Accepted { value: _, diagnostics: _ } => "ACCEPTED"
    Rejected { diagnostics: ds } =>
      match ds.head.at {
        NodeLocus { anchor: a } =>
          match parse_production_emitted_identity_optional(node: a.at) {
            Present { value: s } => symbol_lexeme(sym: ds.head.reason) ++ " @ " ++ symbol_lexeme(sym: s)
            Absent => symbol_lexeme(sym: ds.head.reason) ++ " @ <no production>"
          }
        _ => symbol_lexeme(sym: ds.head.reason) ++ " @ <non-node locus>"
      }
  }
}

fn p1() -> String { body_lowering_normalize_outcome(src: "module m.t\nfn f() -> Int {\n  1\n  2\n}\n", file: ^p) }
fn p2() -> String { where_retained(src: "module m.t\ntype A { meet: fn(Int, Int) -> Int }\ndata d: A = A { meet: fn(a, b) { a } }\n") }
fn q1() -> String { where_retained(src: "module m.t\ntype A {\n  meet: fn(Int, Int) -> Int\n}\nfn f() -> A {\n  A {\n    meet: fn(a, b) { a }\n  }\n}\n") }
fn q2() -> String { where_retained(src: "module m.t\ntype A { meet: fn(Int, Int) -> Int }\ndata d: A = A { meet: fn(a, b) { a + b } }\n") }
fn q3() -> String { where_retained(src: "module m.t\ndata d: fn(Int) -> Int = fn(a) { a }\n") }
fn b1_builtin() -> String { where_retained(src: wave1_gate1_b1_builtin_call_module_source) }
fn b1_body_kind() -> String {
  match wave1_gate1_b1_normalized_module(source: wave1_gate1_b1_bare_call_module_source) {
    Absent => "NORMALIZE_ABSENT"
    Present { value: root } =>
      match wave1_gate1_b1_find_named_fn_arrow_body(root: root, fn_lexeme: "caller") {
        Absent => "BODY_ABSENT"
        Present { value: _ } => "BODY_PRESENT"
      }
  }
}
