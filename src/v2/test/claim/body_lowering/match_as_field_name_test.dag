module v2.test.claim.body_lowering.match_as_field_name

import v2.compiler.body_lowering_fold {
  body_lowering_match_field_name_spine_does_not_sniff_holds
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Cause F: a field literally named match, accessed as r.match, was sniffed as a
// match-expression because kw_match headed an identity-absent sequence. The sniff now
// requires a following lbrace. Full-module tokenize/parse/normalize of r.match is above the
// floor's 500ms changed-witness CPU ceiling; this claim is the cheap discriminator for that
// sniff. The closure receipt is the population green for src/v2/std/runtime.dag.

test fn match_keyword_after_dot_is_not_a_match_expr_sniff_holds() -> Bool {
  body_lowering_match_field_name_spine_does_not_sniff_holds()
}
