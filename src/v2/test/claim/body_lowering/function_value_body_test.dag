module v2.test.claim.body_lowering.function_value_body

import v2.compiler.reference_conservation_admission { conserved_normalize_of_text, no_explained_drops }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A FUNCTION VALUE AS AN ARROW'S WHOLE BODY LOWERS WELL-FORMED (v2.std.node ArrowBodyForm
// FunctionValueBody). Before that arm, v2.compiler.body_lowering_fold body_lower_reify_arrow_body
// refused these at the inner Arrow; with the arm deleted from the classifier they refuse again
// (post_normalize_not_well_formed), so each claim is red without it. The route past normalize --
// resolve with the inner binders scoped, infer, emit -- is
// v2.test.claim.body_lowering.function_value_body_route's.
fn fvb_lowers_well_formed(src: String) -> Bool {
  match conserved_normalize_of_text(path: "fvb_probe_file", text: src, explained: no_explained_drops()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// A fn whose whole body is a fn literal (no let above it, so no Bind carries it).
test fn a_fn_whose_body_is_a_fn_literal_lowers_well_formed() -> Bool {
  fvb_lowers_well_formed(src: "module m.t\nfn f(x: Int) -> fn(Int) -> Int {\n  fn(a) { x }\n}\n")
}

// A curried lambda: the outer lambda's body is itself a lambda.
test fn a_curried_lambda_argument_lowers_well_formed() -> Bool {
  fvb_lowers_well_formed(src: "module m.t\nfn g(r: Int) -> Int { r }\nfn f() -> Int { g(x => y => x) }\n")
}
