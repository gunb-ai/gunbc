module v2.test.claim.body_lowering.data_initializer_fn_value

import v2.compiler.body_lowering_fold {
  body_lower_is_structure_preserved_emitted
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Cause R: a function value in a data-record field wrapper-retained at admit_normalized_tree
// because dag_surface_arrow_lambda and dag_surface_fn_literal had no producer. The shells are
// now structure-preserved after the child fold, same door as field_init. Full-module
// tokenize/parse/normalize of a data initializer is above the floor's 500ms changed-witness CPU
// ceiling; this claim is the cheap discriminator for those two identities. The closure receipt
// is the population green for src/v2/std/logic.dag.

test fn arrow_lambda_and_fn_literal_are_structure_preserved_holds() -> Bool {
  body_lower_is_structure_preserved_emitted(emitted: ^dag_surface_arrow_lambda)
    && body_lower_is_structure_preserved_emitted(emitted: ^dag_surface_fn_literal)
}
