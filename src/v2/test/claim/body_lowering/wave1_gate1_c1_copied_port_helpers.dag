module v2.test.claim.body_lowering.wave1_gate1_c1_copied_port_helpers

import v2.lens.cost.copied_port_citations {
  copied_port_citation_list_append,
  copied_port_citation_list_snoc_item,
  copied_port_citation_map_merge,
  copied_port_citation_retained_count,
  copied_port_index_of
}
import v2.lens.cost.copied_port_derivation { derive_copied_port_index_from_arrow }
import v2.std.collection { Absent, Present }
import v2.std.logic { Bool }

data wave1_gate1_c1_note: String = "Wave 1 Gate 1 C1 helpers: per-op cost derivation over ^arrow_body_edge retires the hand copied_port_fact_registry; unpriceable combiners stay fail-closed via copied_port_index_of => Absent."

fn wave1_gate1_c1_derived_indices_match_retired_registry_holds() -> Bool {
  match derive_copied_port_index_from_arrow(
    arrow: copied_port_citation_list_append.arrow
  ) {
    Present { value: append_idx } =>
      match derive_copied_port_index_from_arrow(
        arrow: copied_port_citation_list_snoc_item.arrow
      ) {
        Present { value: snoc_idx } =>
          match derive_copied_port_index_from_arrow(
            arrow: copied_port_citation_map_merge.arrow
          ) {
            Present { value: merge_idx } =>
              (append_idx == 0)
              && (snoc_idx == 0)
              && (merge_idx == 1)
              && match copied_port_index_of(combiner: ^list_append) {
                Present { value: lookup } => lookup == append_idx
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn wave1_gate1_c1_unpriceable_combiner_refuses_holds() -> Bool {
  match copied_port_index_of(combiner: ^wave1_gate1_c1_unpriceable_combiner) {
    Absent => true
    Present { value: _ } => false
  }
}

fn wave1_gate1_c1_unregistered_combiner_lookup_refuses_holds() -> Bool {
  match copied_port_index_of(combiner: ^mystery_unpriceable_combiner_xyz) {
    Absent => true
    Present { value: _ } => false
  }
}

fn wave1_gate1_c1_citation_retained_frontier_count_holds() -> Bool {
  copied_port_citation_retained_count() == 3
}
