module v2.test.claim.body_lowering.reify_arrow_atom_value

import v2.compiler.body_lowering_fold {
  body_lower_reify_arrow_body
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  ComputationNode,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  Value,
  node_synthetic,
  well_formed
}

data reify_arrow_atom_value_note: String = "Atom arrow-bodies must reify to ComputationNode{Value} at body_lower_reify_arrow_body — a bare TypeNode atom is not a valid arrow-body realization (well_formed's arrow_body_target_is_valid_realization admits ComputationNode or record-construct Conj only). The negative control is the pre-reify atom shape; the positive control is the Value wrap with occurrence_id preserved."

fn reify_arrow_atom_fixture(identity: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: []
  )
}

fn reify_arrow_with_body(body: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      Edge {
        label: Positional,
        target: reify_arrow_atom_fixture(identity: ^reify_arrow_atom_domain)
      },
      Edge {
        label: Positional,
        target: reify_arrow_atom_fixture(identity: ^reify_arrow_atom_return)
      },
      Edge {
        label: Positional,
        target: reify_arrow_atom_fixture(identity: ^reify_arrow_atom_return)
      },
      Edge {
        label: Named { name: ^arrow_body_edge },
        target: body
      }
    ]
  )
}

test fn reify_arrow_atom_body_rejects_well_formed() -> Bool {
  !well_formed(n: reify_arrow_with_body(body: reify_arrow_atom_fixture(identity: ^reify_arrow_atom_body)))
}

test fn reify_arrow_atom_wraps_to_value_body() -> Bool {
  match body_lower_reify_arrow_body(body: reify_arrow_atom_fixture(identity: ^reify_arrow_atom_body)) {
    Rejected { diagnostics: _ } => false
    Accepted { value: reified, diagnostics: _ } =>
      match reified.kind {
        ComputationNode { behavior: Value } => well_formed(n: reify_arrow_with_body(body: reified))
        _ => false
      }
  }
}
