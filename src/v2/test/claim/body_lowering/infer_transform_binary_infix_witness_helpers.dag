module v2.test.claim.body_lowering.infer_transform_binary_infix_witness_helpers


data infer_transform_binary_infix_witness_helpers_note: String = "Shared helpers for Transform binary-infix derivation witnesses. add_probe normalize→resolve→infer exceeds per-PR 5s fast-lane eval budget — discriminating add vertical enrolled on FalsifierSubstrateLongLane (long/infer_transform_binary_infix_witness_test.dag + gunbc.explicit_witness_admission). Fast per-PR subtract frontier control in body_lowering/infer_transform_binary_infix_witness_test.dag."

fn infer_transform_subtract_fixture() -> v2.std.node.Node {
  v2.std.compilers.body_lowering.lower_binary_infix(
    left: v2.extdeps.languages.dag.dag_int_literal_fixture_one(),
    operator: v2.std.node.node_synthetic(
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_token_minus } },
      children: []
    ),
    right: v2.extdeps.languages.dag.dag_int_literal_fixture_two()
  )
}

fn infer_transform_witness_resolved_add_arrow() -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.test.claim.body_lowering.wave1_gate1_normalize_add_helpers.wave1_gate1_normalized_add_module() {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: tree } =>
      match v2.compiler.resolve.resolve(tree: tree, lm: v2.extdeps.languages.dag.dag_language_model()) {
        v2.std.diagnostic.Accepted { value: resolved, diagnostics: _ } =>
          v2.test.claim.body_lowering.wave1_gate1_normalize_add_helpers.wave1_gate1_find_arrow_in_module(root: resolved)
        v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
      }
  }
}

fn infer_transform_witness_add_body(arrow: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.node_query.find_arrow_body_child(root: arrow) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        v2.std.node.ComputationNode { behavior: v2.std.node.Transform } => v2.std.optional.Present { value: body }
        _ => v2.std.optional.Absent
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
  }
}

fn infer_transform_add_vertical_discriminating_holds() -> Bool {
  match infer_transform_witness_resolved_add_arrow() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: arrow } =>
      match infer_transform_witness_add_body(arrow: arrow) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: body } =>
          match v2.compiler.infer.infer(tree: arrow) {
            v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
              match v2.compiler.infer.inferred_facts_witness_for_node(tree: tree, node: body) {
                v2.std.witness.Holds { value: body_facts } =>
                  v2.compiler.infer.inferred_facts_grounding_derived(facts: body_facts)
                    && match v2.compiler.infer.inferred_facts_witness_for_node(tree: tree, node: arrow) {
                      v2.std.witness.Holds { value: arrow_facts } =>
                        !v2.compiler.infer.inferred_facts_grounding_derived(facts: arrow_facts)
                      v2.std.witness.Violates { diagnostic: _ } => false
                    }
                v2.std.witness.Violates { diagnostic: _ } => false
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
      }
  }
}
