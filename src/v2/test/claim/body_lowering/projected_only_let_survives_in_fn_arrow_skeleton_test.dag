module v2.test.claim.body_lowering.projected_only_let_survives_in_fn_arrow_skeleton

// RED FOR THE MARSHAL'S LIVE-REFERENCE DEFECT (owning link: coproduct_reflection.rs
// node_local_reference_name, the permissive companion of node_references_param).
//
// The skeleton marshal's let-liveness set is fed by node_local_reference_name, which counted only
// `ExprVar` and `ExprCall` as value reads. A FIELD projection (`pair.left`) reads its base just as
// much, but did not count -- so a `let pair = <named call>` whose bound record is only projected
// fell out of the live set, and the let's RHS -- the producing call itself -- was grafted OUT of
// the body skeleton. The continuation survives (the downstream trim call is still there), but the
// skeleton now shows a call consuming a projection of a binding whose producing node is absent.
// FnArrowDecl.output and the .dag decl facts are built by that same marshal (marshal_fn_body_
// skeleton), so this shape is missing from the only body grain the .dag substrate exposes, for
// EVERY consumer of marshal_fn_body_skeleton and fn_arrow_output_skeleton.
//
// Why a named-call RHS and not a raw wire read: the dump instrument (por_skeleton_probe, scratch)
// shows that callee identity atoms are BARE fn names (T:Atom(por_sink), T:Atom(trim)), and that a
// service operation like Filesystem.Read emits no callee atom and no C: node at all -- a projected
// wire-read let loses its RHS invisibly at node grain. A NAMED-CALL RHS makes the same loss
// atom-observable: pre-fix the specimen's skeleton lacks T:Atom(por_mk_pair); post-fix it is
// present. That asymmetry is the discriminator.
//
// THE POSITIVE CONTROL is the mirror shape: the same bound record passed WHOLE to a receiver. Its
// let was always live by the old analysis too, so its producing call's atom must be present both
// before and after the fix -- proving the enumeration route sees live-call residue and the red is
// not a route artifact.
//
// The fix under test: a field projection counts as a live reference to its base (the function's own
// documented contract is "every value read"), resolved through nested projections to the base
// binding's authored name. Atom emission is untouched -- identity atoms stay on the strict
// node_references_param -- so reachability queries see no new atoms on genuine param-reference
// sites; only previously dropped let-RHS structure comes back.

import std.algebra { trim }
import v2.std.algebra { list_find_first }
import v2.std.node { Node, Symbol, symbol_lexeme }
import v2.std.fn_index { atom_identities_in_subtree, fn_arrow_decl_facts_live }
import v2.std.optional { Absent, Present }
import std.process { ExitSuccess, ProcessExit, exit_failure }

data por_pool_roots: List<String> = []
data por_pool_files: List<String> = ["src/v2/test/claim/body_lowering/projected_only_let_survives_in_fn_arrow_skeleton_test.dag"]

type PorPair = PorPair { meta: PorMeta, right: String }

type PorMeta = PorMeta { tag: String }

fn por_mk_pair(s: String) -> PorPair {
  PorPair { meta: PorMeta { tag: trim(s) }, right: s }
}

// THE SPECIMEN (single projection): a bound named call whose record is used only through
// one field projection.
fn por_projected_only_record(p: String) -> String {
  let pair = por_mk_pair(s: p)
  trim(pair.right)
}

// THE SPECIMEN (nested projection): the same shape through two levels -- if the marshal ever
// stopped recursing through projections, the base would go unreferenced exactly here.
fn por_projected_nested_record(p: String) -> String {
  let pair = por_mk_pair(s: p)
  trim(pair.meta.tag)
}

// POSITIVE CONTROL: the same bound record passed WHOLE to a receiver. Always live, old and new.
fn por_record_passed_whole(p: String) -> String {
  let pair = por_mk_pair(s: p)
  por_sink_pair(x: pair)
}

fn por_sink_pair(x: PorPair) -> String {
  x.right
}

data por_mk_pair_callee_id: String = "por_mk_pair"
data por_sink_pair_callee_id: String = "por_sink_pair"

fn por_symbol_seen(symbols: List<Symbol>, callee_id: String) -> Bool {
  match list_find_first(xs: symbols, predicate: fn(s) { symbol_lexeme(sym: s) == callee_id }) {
    Present { value: _ } => true
    Absent => false
  }
}

fn por_projected_only_let_survives_in_fn_arrow_skeleton() -> ProcessExit {
  let por_decl_facts = fn_arrow_decl_facts_live(pool_roots: por_pool_roots, pool_files: por_pool_files)
  let por_projected_pick = list_find_first(
    xs: por_decl_facts,
    predicate: fn(d) { d.name == "por_projected_only_record" },
  )
  let por_whole_pick = list_find_first(
    xs: por_decl_facts,
    predicate: fn(d) { d.name == "por_record_passed_whole" },
  )
  let por_nested_pick = list_find_first(
    xs: por_decl_facts,
    predicate: fn(d) { d.name == "por_projected_nested_record" },
  )
  match por_projected_pick {
    Present { value: por_pd } =>
      match por_whole_pick {
        Present { value: por_wd } =>
          match por_nested_pick {
            Present { value: por_nd } => {
              let por_projected_ids = atom_identities_in_subtree(node: por_pd.output)
              let por_whole_ids = atom_identities_in_subtree(node: por_wd.output)
              let por_nested_ids = atom_identities_in_subtree(node: por_nd.output)
              let por_specimen_has_producer = por_symbol_seen(symbols: por_projected_ids, callee_id: por_mk_pair_callee_id)
              let por_nested_has_producer = por_symbol_seen(symbols: por_nested_ids, callee_id: por_mk_pair_callee_id)
              let por_control_has_producer = por_symbol_seen(symbols: por_whole_ids, callee_id: por_mk_pair_callee_id)
              let por_control_has_consumer = por_symbol_seen(symbols: por_whole_ids, callee_id: por_sink_pair_callee_id)
              if por_control_has_producer {
                if por_control_has_consumer {
                  if por_specimen_has_producer {
                    if por_nested_has_producer {
                      ExitSuccess
                    } else {
                      exit_failure(
                        reason: "RED (nested): a let consumed only through a two-level projection lost its producing call from the fn-arrow skeleton",
                      )
                    }
                  } else {
                    exit_failure(
                      reason: "RED: a projected-only let lost its producing call from the fn-arrow skeleton -- the body grain carries the projection's consumer but not the call that produced the binding",
                    )
                  }
                } else {
                  exit_failure(
                    reason: "control skeleton lacks the por_sink_pair callee; the whole-record control's consumption is not visible, so the discriminator proves nothing",
                  )
                }
              } else {
                exit_failure(
                  reason: "control skeleton lacks the por_mk_pair callee; the whole-record let itself is not live, so the enumeration route is broken",
                )
              }
            }
            Absent =>
              exit_failure(
                reason: "self-enumeration did not find por_projected_nested_record in this module's own decl facts",
              )
          }
        Absent =>
          exit_failure(
            reason: "self-enumeration did not find por_record_passed_whole in this module's own decl facts",
          )
      }
    Absent =>
      exit_failure(
        reason: "self-enumeration did not find por_projected_only_record in this module's own decl facts",
      )
  }}
