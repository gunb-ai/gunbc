module v2.test.claim.body_lowering.fn_body_seam_witness_helpers


data fn_body_seam_witness_helpers_note: String = "Shared helpers for fn_body seam witnesses (decoupled from #6775 integer closure). Execution proofs exceed per-PR 5s fast-lane budget — enrolled in long/wave1_gate1_a1_fn_body_seam_witness_test.dag. Fast RED (invalid shell wrapper-retained) lives in self_host/wave1_gate1_a1_fn_body_seam_witness_test.dag."

fn fn_body_seam_parsed_add_module() -> v2.std.optional.Optional<v2.std.node.Node> {
  let lm = dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: ingested_add_module_source,
    file: ^fn_body_seam_add_probe_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => v2.std.optional.Absent
    Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => v2.std.optional.Absent
        Accepted { value: artifact, diagnostics: _ } => v2.std.optional.Present { value: artifact.tree }
      }
  }
}

fn fn_body_seam_find_production_under_children(root: v2.std.node.Node, emitted: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => fn_body_seam_find_production(root: e.target, emitted: emitted)
    }
  })
}

fn fn_body_seam_find_production(root: v2.std.node.Node, emitted: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      if id == emitted {
        optional_present(value: root)
      } else {
        fn_body_seam_find_production_under_children(root: root, emitted: emitted)
      }
    Absent =>
      fn_body_seam_find_production_under_children(root: root, emitted: emitted)
  }
}

fn fn_body_seam_add_fn_body_shell() -> v2.std.optional.Optional<v2.std.node.Node> {
  match fn_body_seam_parsed_add_module() {
    Absent => v2.std.optional.Absent
    Present { value: tree } =>
      fn_body_seam_find_production(root: tree, emitted: ^dag_surface_fn_body)
  }
}

fn fn_body_seam_tree_has_transform(root: v2.std.node.Node) -> v2.std.logic.Bool {
  match root.kind {
    ComputationNode { behavior: v2.std.node.Transform } => true
    _ =>
      fold(root.children, init: false, f: fn(found, e) {
        if found {
          true
        } else {
          fn_body_seam_tree_has_transform(root: e.target)
        }
      })
  }
}

fn wave1_gate1_a1_fn_body_seam_shell_lowers_identity_holds() -> v2.std.logic.Bool {
  match fn_body_seam_add_fn_body_shell() {
    Absent => false
    Present { value: shell } =>
      match body_lower_fn_body_shell(shell: shell) {
        Rejected { diagnostics: _ } => false
        Accepted { value: lowered, diagnostics: _ } =>
          fn_body_seam_tree_has_transform(root: lowered)
      }
  }
}

fn wave1_gate1_a1_fn_body_seam_fn_decl_binding_ordering_holds() -> v2.std.logic.Bool {
  pbf_parse_preserves_param_x_binding()
    && pbf_parse_preserves_param_y_binding()
}

fn wave1_gate1_a1_fn_body_seam_red_invalid_shell_wrapper_retained_holds() -> v2.std.logic.Bool {
  let shell = node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^wave1_gate1_a1_fn_body_seam_invalid_shell } },
    children: []
  )
  match body_lower_outcome_frontier_disposition(o: body_lower_fn_body_shell(shell: shell)) {
    BodyLoweringWrapperRetained { reason: r } => r == ^body_lowering_reason_wrapper_retained_emitted
    BodyLoweringLowered => false
    BodyLoweringRejected { diagnostics: _ } => false
  }
}

fn wave1_gate1_a1_fn_body_seam_red_premature_fn_decl_shell_is_not_normalize_authority_holds() -> v2.std.logic.Bool {
  match fn_body_seam_add_fn_body_shell() {
    Absent => false
    Present { value: fn_decl_body_shell } =>
      match body_lower_fn_body_shell(shell: fn_decl_body_shell) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

fn wave1_gate1_a1_fn_body_seam_normalize_still_yields_arrow_transform_holds() -> v2.std.logic.Bool {
  let lm = dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: ingested_add_module_source,
    file: ^fn_body_seam_add_probe_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: tree, diagnostics: _ } =>
              match v2.compiler.ingested_fixture_arrows.ingested_find_arrow_in_module(root: tree.root) {
                Absent => false
                Present { value: arrow } =>
                  match find_arrow_body_child(root: arrow) {
                    Accepted { value: body, diagnostics: _ } =>
                      match body.kind {
                        ComputationNode { behavior: v2.std.node.Transform } => true
                        _ => false
                      }
                    Rejected { diagnostics: _ } => false
                  }
              }
          }
      }
  }
}
