module v2.test.claim.body_lowering.arrow_body_form_semantic_helpers


// Semantic eval helpers for ArrowBodyForm acceptance witnesses: ingested arrows
// cross normalize through ingested_fixture_arrows, then execute through
// v2.compiler.eval with v2_evaluator_interpretation.

type ArrowBodyFormAdmissionMirror
  = ArrowBodyFormAdmissionProduction
  | ArrowBodyFormAdmissionRedNoDirectAtom
  | ArrowBodyFormAdmissionRedNoComputationBody

fn classify_arrow_body_form_red_no_direct_atom(target: v2.std.node.Node) -> v2.std.node.ArrowBodyForm {
  match target.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: _ } } => v2.std.node.UnsupportedArrowBody
    v2.std.node.TypeNode { connective: v2.std.node.Conj } => v2.std.node.RecordConstructBody
    v2.std.node.ComputationNode { behavior: b } => v2.std.node.ComputationBody { behavior: b }
    _ => v2.std.node.UnsupportedArrowBody
  }
}

fn classify_arrow_body_form_red_no_computation_body(target: v2.std.node.Node) -> v2.std.node.ArrowBodyForm {
  match target.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: _ } } => v2.std.node.DirectAtomBody
    v2.std.node.TypeNode { connective: v2.std.node.Conj } => v2.std.node.RecordConstructBody
    v2.std.node.ComputationNode { behavior: _ } => v2.std.node.UnsupportedArrowBody
    _ => v2.std.node.UnsupportedArrowBody
  }
}

fn arrow_body_form_admits_body_with_mirror(target: v2.std.node.Node, mirror: ArrowBodyFormAdmissionMirror) -> Bool {
  match mirror {
    ArrowBodyFormAdmissionProduction => v2.std.node.arrow_body_target_is_valid_realization(target: target)
    ArrowBodyFormAdmissionRedNoDirectAtom =>
      match classify_arrow_body_form_red_no_direct_atom(target: target) {
        v2.std.node.UnsupportedArrowBody => false
        v2.std.node.RecordConstructBody => v2.std.node.arrow_body_record_construct_conforms(node: target)
        v2.std.node.DirectAtomBody => true
        v2.std.node.ComputationBody { behavior: _ } => true
      }
    ArrowBodyFormAdmissionRedNoComputationBody =>
      match classify_arrow_body_form_red_no_computation_body(target: target) {
        v2.std.node.UnsupportedArrowBody => false
        v2.std.node.RecordConstructBody => v2.std.node.arrow_body_record_construct_conforms(node: target)
        v2.std.node.DirectAtomBody => true
        v2.std.node.ComputationBody { behavior: _ } => true
      }
  }
}

fn arrow_body_form_semantic_unary_int_if_body_admits_holds(
  callee: v2.std.node.Node,
  arg_lex: String,
  expected: Int,
  mirror: ArrowBodyFormAdmissionMirror
) -> Bool {
  match v2.std.node_query.find_arrow_body_child(root: callee) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
      if arrow_body_form_admits_body_with_mirror(target: body, mirror: mirror) {
        arrow_body_form_eval_unary_int_holds(callee: callee, arg_lex: arg_lex, expected: expected)
      } else {
        false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn arrow_body_form_semantic_nullary_int_if_body_admits_holds(
  callee: v2.std.node.Node,
  expected: Int,
  mirror: ArrowBodyFormAdmissionMirror
) -> Bool {
  match v2.std.node_query.find_arrow_body_child(root: callee) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
      if arrow_body_form_admits_body_with_mirror(target: body, mirror: mirror) {
        arrow_body_form_eval_nullary_int_holds(callee: callee, expected: expected)
      } else {
        false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn arrow_body_form_semantic_binary_int_if_body_admits_holds(
  callee: v2.std.node.Node,
  left_lex: String,
  right_lex: String,
  expected: Int,
  mirror: ArrowBodyFormAdmissionMirror
) -> Bool {
  match v2.std.node_query.find_arrow_body_child(root: callee) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
      if arrow_body_form_admits_body_with_mirror(target: body, mirror: mirror) {
        arrow_body_form_eval_binary_int_holds(
          callee: callee,
          left_lex: left_lex,
          right_lex: right_lex,
          expected: expected
        )
      } else {
        false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn arrow_body_form_eval_int_type_node() -> v2.std.node.Node {
  v2.extdeps.languages.dag.dag_type_atom_node(identity: v2.extdeps.languages.dag.dag_int_type_binding())
}

fn arrow_body_form_eval_int_literal_optional(lexeme: String) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.dag_int_literal_node_from_lexeme(lexeme: lexeme, occurrence_id: v2.std.node.SyntheticOccurrence) {
    v2.std.diagnostic.Accepted { value: node, diagnostics: _ } => v2.std.optional.optional_present(value: node)
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.optional_absent()
  }
}

fn arrow_body_form_eval_runtime_int_equals(value: v2.std.runtime.RuntimeValue, n: Int) -> Bool {
  match value {
    v2.std.runtime.RuntimePrimitive { value: p } =>
      match v2.std.integer.integer_signed_i32_le_bytes_to_int(bytes: p.bytes) {
        v2.std.diagnostic.Accepted { value: magnitude, diagnostics: _ } => magnitude == n
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    _ => false
  }
}

fn arrow_body_form_eval_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_present(value: v2.test.lens_common.infer_fixture.claim_inferred_facts_from_nodes(
    resolved: key,
    algebra: arrow_body_form_eval_int_type_node(),
    descent: v2.std.cardinality.termination_proof_witness_for_node(n: key)
  ))
}

fn arrow_body_form_eval_admitted_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: PartialFunction { lookup: arrow_body_form_eval_facts_lookup }
  }
}

fn arrow_body_form_eval_nullary_call_node(callee: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: [v2.std.node.Edge { label: v2.std.node.Positional, target: callee }]
  }
}

fn arrow_body_form_eval_unary_call_node(callee: v2.std.node.Node, arg: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: callee },
      v2.std.node.Edge { label: v2.std.node.Positional, target: arg }
    ]
  }
}

fn arrow_body_form_eval_binary_call_node(callee: v2.std.node.Node, left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    occurrence_id: v2.std.node.SyntheticOccurrence,
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: callee },
      v2.std.node.Edge { label: v2.std.node.Positional, target: left },
      v2.std.node.Edge { label: v2.std.node.Positional, target: right }
    ]
  }
}

fn arrow_body_form_eval_call_outcome_for_call(call: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.compiler.eval.eval(
    tree: arrow_body_form_eval_admitted_tree(root: call),
    interpretation: v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation(),
    inputs: v2.compiler.eval.inputs_root_only(root: call)
  )
}

fn arrow_body_form_eval_int_result_equals_for_call(call: v2.std.node.Node, expected: Int) -> Bool {
  match arrow_body_form_eval_call_outcome_for_call(call: call) {
    v2.std.diagnostic.Accepted { value: actual, diagnostics: _ } =>
      arrow_body_form_eval_runtime_int_equals(value: actual, n: expected)
    _ => false
  }
}

fn arrow_body_form_eval_unary_int_holds(callee: v2.std.node.Node, arg_lex: String, expected: Int) -> Bool {
  match arrow_body_form_eval_int_literal_optional(lexeme: arg_lex) {
    v2.std.optional.Present { value: arg } =>
      arrow_body_form_eval_int_result_equals_for_call(
        call: arrow_body_form_eval_unary_call_node(callee: callee, arg: arg),
        expected: expected
      )
    Absent => false
  }
}

fn arrow_body_form_eval_nullary_int_holds(callee: v2.std.node.Node, expected: Int) -> Bool {
  arrow_body_form_eval_int_result_equals_for_call(
    call: arrow_body_form_eval_nullary_call_node(callee: callee),
    expected: expected
  )
}

fn arrow_body_form_eval_binary_int_holds(
  callee: v2.std.node.Node,
  left_lex: String,
  right_lex: String,
  expected: Int
) -> Bool {
  match arrow_body_form_eval_int_literal_optional(lexeme: left_lex) {
    v2.std.optional.Present { value: left } =>
      match arrow_body_form_eval_int_literal_optional(lexeme: right_lex) {
        v2.std.optional.Present { value: right } =>
          arrow_body_form_eval_int_result_equals_for_call(
            call: arrow_body_form_eval_binary_call_node(callee: callee, left: left, right: right),
            expected: expected
          )
        Absent => false
      }
    Absent => false
  }
}

fn arrow_body_form_eval_call_does_not_reject_unsupported_callee(call: v2.std.node.Node) -> Bool {
  match arrow_body_form_eval_call_outcome_for_call(call: call) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: None } => true
    v2.std.diagnostic.Rejected { diagnostics: ds } => ds.head.reason != ^eval_rejected_unsupported_callee
  }
}
