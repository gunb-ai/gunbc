module v2.test.claim.body_lowering.peeled_shell_fold_head

import v2.compiler.body_lowering_fold { body_lower_is_pass_through_emitted }
import v2.compiler.fold_lowering { fold_call_head_symbol, fold_family_realization }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex, parse_production_emitted_identity_optional }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node }
import v2.std.optional { Absent, Present }

// body_lower_try_body_lowered no longer retries body_lower_try_fold_loop on
// body_lower_unwrap_surface_shell(node) (gunbc#12495). That deletion preserves
// output only while no pass-through shell the unwrap peels carries a fold-family
// head: the fold-loop search descends through exactly those shells, so the retry
// answered the same as the first search. This claim is the control that goes red
// if the parser ever mints such a shell, over the smallest source that puts a fold call
// under pass-through shells (kept inside v2.workflow.required_floor
// claim_eval_step_budget_for_identity for a new witness), and it asserts the route
// (shells and fold heads are both present) so it cannot pass on an empty tree.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data peeled_shell_fold_head_source: String = "module w.p\n\ndata d: I = fold(x, f: g)\n"

fn peeled_shell_fold_head_parsed() -> Outcome<Node> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prepared, diagnostics: residue } =>
      bind_outcome(
        o: tokenize(
          text: peeled_shell_fold_head_source,
          file: ^peeled_shell_fold_head_file,
          rules: dag_lex()
        ),
        f: fn(token_stream) {
          match parse_module_prepared(
            tokens: token_stream,
            prepared: prepared,
            validation_residue: residue
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: artifact, diagnostics: d } =>
              Accepted { value: artifact.tree, diagnostics: d }
          }
        }
      )
  }
}

fn psfh_is_pass_through_shell(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } => body_lower_is_pass_through_emitted(emitted: id)
    Absent => false
  }
}

fn psfh_has_fold_head(node: Node) -> Bool {
  match fold_call_head_symbol(fold_call: node) {
    Present { value: head } =>
      match fold_family_realization(head: head) {
        Present { value: _ } => true
        Absent => false
      }
    Absent => false
  }
}

fn psfh_any_shell(node: Node) -> Bool {
  psfh_is_pass_through_shell(node: node)
    || fold(node.children, init: false, f: fn(acc, e) { acc || psfh_any_shell(node: e.target) })
}

fn psfh_any_fold_head(node: Node) -> Bool {
  psfh_has_fold_head(node: node)
    || fold(node.children, init: false, f: fn(acc, e) { acc || psfh_any_fold_head(node: e.target) })
}

fn psfh_any_shell_with_fold_head(node: Node) -> Bool {
  (psfh_is_pass_through_shell(node: node) && psfh_has_fold_head(node: node))
    || fold(node.children, init: false, f: fn(acc, e) { acc || psfh_any_shell_with_fold_head(node: e.target) })
}

test fn peeled_shell_fold_head_route_reaches_shells_and_fold_heads() -> Bool {
  match peeled_shell_fold_head_parsed() {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      psfh_any_shell(node: tree) && psfh_any_fold_head(node: tree)
  }
}

test fn peeled_shell_fold_head_no_pass_through_shell_carries_a_fold_head() -> Bool {
  match peeled_shell_fold_head_parsed() {
    Rejected { diagnostics: _ } => false
    Accepted { value: tree, diagnostics: _ } =>
      !psfh_any_shell_with_fold_head(node: tree)
  }
}
