module v2.test.claim.body_lowering.atom_body_discriminator_helpers


data atom_body_discriminator_module_source: String = "module atom_body_discriminator\n\nfn id(x: Int) -> Int { x }\nfn zero() -> Int { 0 }\nfn add(x: Int, y: Int) -> Int { x + y }\nfn zero_binary() -> Int { 1 + 1 }\n"

data atom_body_discriminator_expected_arrow_identities: List<String> = [
  "id",
  "zero",
  "add",
  "zero_binary",
]

type AtomBodyDiscriminatorMirror
  = AtomBodyDiscriminatorProduction
  | AtomBodyDiscriminatorRedNoDirectAtom
  | AtomBodyDiscriminatorRedNoComputationBody

type AtomBodyDiscriminatorObservedRows {
  id: v2.std.node.Node
  zero: v2.std.node.Node
  add: v2.std.node.Node
  zero_binary: v2.std.node.Node
}

type TopLevelIdentityJoinRefusal {
  expected: List<String>
  observed: List<String>
  missing: List<String>
  extra: List<String>
  duplicates: List<String>
}

type AtomBodyDiscriminatorObservation
  = TokenizeRejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }
  | ParseRejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }
  | NormalizeRejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }
  | TopLevelIdentityJoinRefused { refusal: TopLevelIdentityJoinRefusal }
  | DiscriminatorObserved { tree: v2.std.node.Node, rows: AtomBodyDiscriminatorObservedRows }

fn atom_body_discriminator_string_count_eq(items: List<String>, wanted: String) -> Int {
  fold(items, init: 0, f: fn(n, item) {
    if item == wanted {
      n + 1
    } else {
      n
    }
  })
}

fn atom_body_discriminator_string_list_has_duplicate(items: List<String>) -> Bool {
  items |> v2.std.algebra.any(item => atom_body_discriminator_string_count_eq(items: items, wanted: item) > 1)
}

fn atom_body_discriminator_string_in_list(items: List<String>, wanted: String) -> Bool {
  items |> v2.std.algebra.any(item => item == wanted)
}

fn atom_body_discriminator_top_level_arrow_lexemes_identity_join(
  expected: List<String>,
  observed: List<String>
) -> Bool {
  !(atom_body_discriminator_string_list_has_duplicate(items: expected))
    && !(atom_body_discriminator_string_list_has_duplicate(items: observed))
    && expected |> all(e => atom_body_discriminator_string_in_list(items: observed, wanted: e))
    && observed |> all(o => atom_body_discriminator_string_in_list(items: expected, wanted: o))
}

fn atom_body_discriminator_strings_in_first_not_in_second(
  first: List<String>,
  second: List<String>
) -> List<String> {
  fold(first, init: [], f: fn(acc, item) {
    if atom_body_discriminator_string_in_list(items: second, wanted: item) {
      acc
    } else {
      v2.std.algebra.list_snoc_item(xs: acc, item: item)
    }
  })
}

fn atom_body_discriminator_duplicate_strings(items: List<String>) -> List<String> {
  fold(items, init: [], f: fn(acc, item) {
    if atom_body_discriminator_string_count_eq(items: items, wanted: item) > 1
      && !(atom_body_discriminator_string_in_list(items: acc, wanted: item)) {
      v2.std.algebra.list_snoc_item(xs: acc, item: item)
    } else {
      acc
    }
  })
}

fn atom_body_discriminator_top_level_identity_join_refusal(
  expected: List<String>,
  observed: List<String>
) -> TopLevelIdentityJoinRefusal {
  TopLevelIdentityJoinRefusal {
    expected: expected,
    observed: observed,
    missing: atom_body_discriminator_strings_in_first_not_in_second(first: expected, second: observed),
    extra: atom_body_discriminator_strings_in_first_not_in_second(first: observed, second: expected),
    duplicates: atom_body_discriminator_duplicate_strings(items: observed),
  }
}

fn atom_body_discriminator_walk_spine_to_body(captured: v2.std.node.Node) -> v2.std.node.Node {
  match captured.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      if count(captured.children) == 1 {
        match v2.std.collection.list_at_optional(xs: captured.children, index: 0) {
          v2.std.optional.Present { value: edge } =>
            match edge.label {
              v2.std.node.Named { name: _ } => atom_body_discriminator_walk_spine_to_body(captured: edge.target)
              v2.std.node.Positional => captured
            }
          v2.std.optional.Absent => captured
        }
      } else {
        captured
      }
    _ => captured
  }
}

fn atom_body_discriminator_module_scope_body(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.node_query.find_named_child(root: root, name: ^grammar_production_captured_node_projection) {
    v2.std.diagnostic.Accepted { value: captured, diagnostics: _ } =>
      v2.std.optional.optional_present(
        value: atom_body_discriminator_walk_spine_to_body(captured: captured)
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.optional_present(value: root)
  }
}

fn atom_body_discriminator_top_level_arrow_lexeme_optional(edge: v2.std.node.Edge) -> v2.std.optional.Optional<String> {
  match edge.label {
    v2.std.node.Named { name: sym } =>
      match edge.target.kind {
        v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
          v2.std.optional.optional_present(value: v2.std.compilers.lexing.symbol_lexeme(sym: sym))
        _ => v2.std.optional.Absent
      }
    v2.std.node.Positional => v2.std.optional.Absent
  }
}

fn atom_body_discriminator_observed_top_level_arrow_lexemes(root: v2.std.node.Node) -> List<String> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(root.children, init: [], f: fn(acc, edge) {
        match atom_body_discriminator_top_level_arrow_lexeme_optional(edge: edge) {
          v2.std.optional.Absent => acc
          v2.std.optional.Present { value: lexeme } => v2.std.algebra.list_snoc_item(xs: acc, item: lexeme)
        }
      })
    _ => []
  }
}

fn atom_body_discriminator_top_level_named_arrow(root: v2.std.node.Node, fn_lexeme: String) -> v2.std.optional.Optional<v2.std.node.Node> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, edge) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent =>
            match edge.label {
              v2.std.node.Named { name: sym } =>
                match v2.std.compilers.lexing.symbol_lexeme(sym: sym) == fn_lexeme {
                  true =>
                    match edge.target.kind {
                      v2.std.node.TypeNode { connective: v2.std.node.Arrow } => v2.std.optional.optional_present(value: edge.target)
                      _ => v2.std.optional.Absent
                    }
                  false => v2.std.optional.Absent
                }
              v2.std.node.Positional => v2.std.optional.Absent
            }
        }
      })
    _ => v2.std.optional.Absent
  }
}

fn atom_body_discriminator_observed_rows(scope: v2.std.node.Node) -> v2.std.optional.Optional<AtomBodyDiscriminatorObservedRows> {
  match atom_body_discriminator_top_level_named_arrow(root: scope, fn_lexeme: "id") {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: id } =>
      match atom_body_discriminator_top_level_named_arrow(root: scope, fn_lexeme: "zero") {
        v2.std.optional.Absent => v2.std.optional.Absent
        v2.std.optional.Present { value: zero } =>
          match atom_body_discriminator_top_level_named_arrow(root: scope, fn_lexeme: "add") {
            v2.std.optional.Absent => v2.std.optional.Absent
            v2.std.optional.Present { value: add } =>
              match atom_body_discriminator_top_level_named_arrow(
                root: scope,
                fn_lexeme: "zero_binary"
              ) {
                v2.std.optional.Absent => v2.std.optional.Absent
                v2.std.optional.Present { value: zero_binary } =>
                  v2.std.optional.optional_present(
                    value: AtomBodyDiscriminatorObservedRows {
                      id: id,
                      zero: zero,
                      add: add,
                      zero_binary: zero_binary,
                    }
                  )
              }
          }
      }
  }
}

fn atom_body_discriminator_observe() -> AtomBodyDiscriminatorObservation {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: atom_body_discriminator_module_source,
    file: ^atom_body_discriminator_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: d } => TokenizeRejected { diagnostics: d }
    v2.std.diagnostic.Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: d } => ParseRejected { diagnostics: d }
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: artifact.tree) {
            v2.std.diagnostic.Rejected { diagnostics: d } => NormalizeRejected { diagnostics: d }
            v2.std.diagnostic.Accepted { value: normalized, diagnostics: _ } =>
              let root = normalized.root
              match atom_body_discriminator_module_scope_body(root: root) {
                v2.std.optional.Absent =>
                  TopLevelIdentityJoinRefused {
                    refusal: atom_body_discriminator_top_level_identity_join_refusal(
                      expected: atom_body_discriminator_expected_arrow_identities,
                      observed: []
                    )
                  }
                v2.std.optional.Present { value: scope } =>
                  let observed =
                    atom_body_discriminator_observed_top_level_arrow_lexemes(root: scope)
                  if atom_body_discriminator_top_level_arrow_lexemes_identity_join(
                    expected: atom_body_discriminator_expected_arrow_identities,
                    observed: observed
                  ) {
                    match atom_body_discriminator_observed_rows(scope: scope) {
                      v2.std.optional.Absent =>
                        TopLevelIdentityJoinRefused {
                          refusal: atom_body_discriminator_top_level_identity_join_refusal(
                            expected: atom_body_discriminator_expected_arrow_identities,
                            observed: observed
                          )
                        }
                      v2.std.optional.Present { value: rows } =>
                        DiscriminatorObserved { tree: root, rows: rows }
                    }
                  } else {
                    TopLevelIdentityJoinRefused {
                      refusal: atom_body_discriminator_top_level_identity_join_refusal(
                        expected: atom_body_discriminator_expected_arrow_identities,
                        observed: observed
                      )
                    }
                  }
              }
          }
      }
  }
}

fn atom_body_discriminator_arrow_body_optional(arrow: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.node_query.find_arrow_body_child(root: arrow) {
    v2.std.diagnostic.Accepted { value: body, diagnostics: _ } => v2.std.optional.optional_present(value: body)
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
  }
}

fn atom_body_discriminator_named_binding_count(domain: v2.std.node.Node) -> Int {
  match domain.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(domain.children, init: 0, f: fn(count, edge) {
        match edge.label {
          v2.std.node.Named { name: _ } => count + 1
          v2.std.node.Positional => count
        }
      })
    _ => 0
  }
}

fn atom_body_discriminator_parameter_count(arrow: v2.std.node.Node) -> v2.std.optional.Optional<Int> {
  match arrow.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
      match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: arrow), index: 0) {
        v2.std.optional.Present { value: domain } =>
          v2.std.optional.optional_present(value: atom_body_discriminator_named_binding_count(domain: domain))
        v2.std.optional.Absent => v2.std.optional.Absent
      }
    _ => v2.std.optional.Absent
  }
}

fn atom_body_discriminator_classify_body(target: v2.std.node.Node, mirror: AtomBodyDiscriminatorMirror) -> v2.std.node.ArrowBodyForm {
  match mirror {
    AtomBodyDiscriminatorProduction => v2.std.node.classify_arrow_body_form(target: target)
    AtomBodyDiscriminatorRedNoDirectAtom =>
      v2.test.claim.body_lowering.arrow_body_form_semantic_helpers.classify_arrow_body_form_red_no_direct_atom(target: target)
    AtomBodyDiscriminatorRedNoComputationBody =>
      v2.test.claim.body_lowering.arrow_body_form_semantic_helpers.classify_arrow_body_form_red_no_computation_body(target: target)
  }
}

fn atom_body_discriminator_arrow_row_holds(
  arrow: v2.std.node.Node,
  expected_param_count: Int,
  expected_form: v2.std.node.ArrowBodyForm,
  mirror: AtomBodyDiscriminatorMirror
) -> Bool {
  match atom_body_discriminator_parameter_count(arrow: arrow) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: param_count } =>
      match atom_body_discriminator_arrow_body_optional(arrow: arrow) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: body } =>
          param_count == expected_param_count
            && atom_body_discriminator_classify_body(target: body, mirror: mirror) == expected_form
      }
  }
}

fn atom_body_discriminator_arrow_classifies(
  arrow: v2.std.node.Node,
  mirror: AtomBodyDiscriminatorMirror
) -> v2.std.optional.Optional<v2.std.node.ArrowBodyForm> {
  match atom_body_discriminator_arrow_body_optional(arrow: arrow) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: body } =>
      v2.std.optional.optional_present(
        value: atom_body_discriminator_classify_body(target: body, mirror: mirror)
      )
  }
}

fn atom_body_discriminator_batched_receipt_holds() -> Bool {
  match atom_body_discriminator_observe() {
    TokenizeRejected { diagnostics: _ } => false
    ParseRejected { diagnostics: _ } => false
    NormalizeRejected { diagnostics: _ } => false
    TopLevelIdentityJoinRefused { refusal: _ } => false
    DiscriminatorObserved { tree: _, rows: rows } =>
      atom_body_discriminator_arrow_row_holds(
        arrow: rows.id,
        expected_param_count: 1,
        expected_form: v2.std.node.DirectAtomBody,
        mirror: AtomBodyDiscriminatorProduction
      )
        && atom_body_discriminator_arrow_row_holds(
          arrow: rows.zero,
          expected_param_count: 0,
          expected_form: v2.std.node.DirectAtomBody,
          mirror: AtomBodyDiscriminatorProduction
        )
        && atom_body_discriminator_arrow_row_holds(
          arrow: rows.add,
          expected_param_count: 2,
          expected_form: v2.std.node.ComputationBody { behavior: v2.std.node.Transform },
          mirror: AtomBodyDiscriminatorProduction
        )
        && atom_body_discriminator_arrow_row_holds(
          arrow: rows.zero_binary,
          expected_param_count: 0,
          expected_form: v2.std.node.ComputationBody { behavior: v2.std.node.Transform },
          mirror: AtomBodyDiscriminatorProduction
        )
        && match atom_body_discriminator_arrow_classifies(
          arrow: rows.id,
          mirror: AtomBodyDiscriminatorRedNoDirectAtom
        ) {
          v2.std.optional.Present { value: form } => form == v2.std.node.UnsupportedArrowBody
          v2.std.optional.Absent => false
        }
        && match atom_body_discriminator_arrow_classifies(
          arrow: rows.zero,
          mirror: AtomBodyDiscriminatorRedNoDirectAtom
        ) {
          v2.std.optional.Present { value: form } => form == v2.std.node.UnsupportedArrowBody
          v2.std.optional.Absent => false
        }
        && match atom_body_discriminator_arrow_classifies(
          arrow: rows.add,
          mirror: AtomBodyDiscriminatorRedNoDirectAtom
        ) {
          v2.std.optional.Present { value: form } => form != v2.std.node.UnsupportedArrowBody
          v2.std.optional.Absent => false
        }
        && match atom_body_discriminator_arrow_classifies(
          arrow: rows.zero_binary,
          mirror: AtomBodyDiscriminatorRedNoDirectAtom
        ) {
          v2.std.optional.Present { value: form } => form != v2.std.node.UnsupportedArrowBody
          v2.std.optional.Absent => false
        }
        && match atom_body_discriminator_arrow_classifies(
          arrow: rows.id,
          mirror: AtomBodyDiscriminatorRedNoComputationBody
        ) {
          v2.std.optional.Present { value: form } => form == v2.std.node.DirectAtomBody
          v2.std.optional.Absent => false
        }
        && match atom_body_discriminator_arrow_classifies(
          arrow: rows.zero,
          mirror: AtomBodyDiscriminatorRedNoComputationBody
        ) {
          v2.std.optional.Present { value: form } => form == v2.std.node.DirectAtomBody
          v2.std.optional.Absent => false
        }
        && match atom_body_discriminator_arrow_classifies(
          arrow: rows.add,
          mirror: AtomBodyDiscriminatorRedNoComputationBody
        ) {
          v2.std.optional.Present { value: form } => form == v2.std.node.UnsupportedArrowBody
          v2.std.optional.Absent => false
        }
        && match atom_body_discriminator_arrow_classifies(
          arrow: rows.zero_binary,
          mirror: AtomBodyDiscriminatorRedNoComputationBody
        ) {
          v2.std.optional.Present { value: form } => form == v2.std.node.UnsupportedArrowBody
          v2.std.optional.Absent => false
        }
  }
}
