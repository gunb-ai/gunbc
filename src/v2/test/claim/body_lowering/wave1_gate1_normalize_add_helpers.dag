module v2.test.claim.body_lowering.wave1_gate1_normalize_add_helpers


data wave1_gate1_add_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

fn wave1_gate1_find_arrow_in_module(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } => v2.std.optional.Present { value: root }
    _ =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => wave1_gate1_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn wave1_gate1_normalized_module_from_source(source: String, file: Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(text: source, file: file, rules: lm.lex) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
    v2.std.diagnostic.Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: artifact.tree) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
            v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } => v2.std.optional.Present { value: tree }
          }
      }
  }
}

fn wave1_gate1_normalized_add_module() -> v2.std.optional.Optional<v2.std.node.Node> {
  wave1_gate1_normalized_module_from_source(
    source: wave1_gate1_add_module_source,
    file: ^wave1_gate1_add_probe_file
  )
}

fn wave1_gate1_normalized_add_resolves_holds() -> Bool {
  match wave1_gate1_normalized_add_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match v2.compiler.resolve.resolve(tree: tree, lm: v2.extdeps.languages.dag.dag_language_model()) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

fn wave1_gate1_normalized_add_yields_arrow_transform_holds() -> Bool {
  match wave1_gate1_normalized_add_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match wave1_gate1_find_arrow_in_module(root: tree) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: arrow } =>
          v2.std.node.well_formed(n: arrow)
            && match v2.std.node_query.find_arrow_body_child(root: arrow) {
              v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
                match body.kind {
                  v2.std.node.ComputationNode { behavior: v2.std.node.Transform } => true
                  _ => false
                }
              v2.std.diagnostic.Rejected { diagnostics: _ } => false
            }
      }
  }
}

fn wave1_gate1_resolved_add_arrow_transform_holds() -> Bool {
  match wave1_gate1_normalized_add_module() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: tree } =>
      match v2.compiler.resolve.resolve(tree: tree, lm: v2.extdeps.languages.dag.dag_language_model()) {
        v2.std.diagnostic.Accepted { value: resolved, diagnostics: _ } =>
          match wave1_gate1_find_arrow_in_module(root: resolved) {
            v2.std.optional.Present { value: arrow } =>
              match v2.std.node_query.find_arrow_body_child(root: arrow) {
                v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
                  match body.kind {
                    v2.std.node.ComputationNode { behavior: v2.std.node.Transform } => true
                    _ => false
                  }
                v2.std.diagnostic.Rejected { diagnostics: _ } => false
              }
            v2.std.optional.Absent => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}
