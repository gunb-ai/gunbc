module v2.test.claim.body_lowering.wave1_gate1_normalize_add_helpers

import v2.compiler.reference_conservation_admission { conserved_normalize_of_text, no_explained_drops }
import v2.compiler.normalize { normalize }
import v2.std.declaration_marker { test_marker_channel_empty }
import v2.compiler.normalized_tree { admit_normalized_tree, no_import_bindings, no_record_declarations}
import v2.compiler.parse { parse_module }
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.optional {
  Absent,
  Optional,
  Present
}
import v2.std.diagnostic { Accepted, None, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  ComputationNode,
  Node,
  Transform,
  TypeNode,
  well_formed
}
import v2.std.node_query { find_arrow_body_child }

data wave1_gate1_add_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

fn wave1_gate1_find_arrow_in_module(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => wave1_gate1_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn wave1_gate1_normalized_module_from_source(source: String, file: Symbol) -> Optional<Node> {
  match conserved_normalize_of_text(path: symbol_lexeme(sym: file), text: source, explained: no_explained_drops()) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: tree, diagnostics: _ } => Present { value: tree.root }
  }
}

fn wave1_gate1_normalized_add_module() -> Optional<Node> {
  wave1_gate1_normalized_module_from_source(
    source: wave1_gate1_add_module_source,
    file: ^wave1_gate1_add_probe_file
  )
}

fn wave1_gate1_normalized_add_resolves_holds() -> Bool {
  match wave1_gate1_normalized_add_module() {
    Absent => false
    Present { value: tree } =>
      match admit_normalized_tree(import_bindings: no_import_bindings(), record_declarations: no_record_declarations(), test_markers: test_marker_channel_empty(), root: tree, diagnostics: None) {
        Rejected { diagnostics: _ } => false
        Accepted { value: normalized, diagnostics: _ } =>
          match resolve(tree: normalized, lm: dag_language_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn wave1_gate1_normalized_add_yields_arrow_transform_holds() -> Bool {
  match wave1_gate1_normalized_add_module() {
    Absent => false
    Present { value: tree } =>
      match wave1_gate1_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          well_formed(n: arrow)
            && match find_arrow_body_child(root: arrow) {
              Accepted { value: body, diagnostics: _ } =>
                match body.kind {
                  ComputationNode { behavior: Transform } => true
                  _ => false
                }
              Rejected { diagnostics: _ } => false
            }
      }
  }
}

fn wave1_gate1_resolved_add_arrow_transform_holds() -> Bool {
  match wave1_gate1_normalized_add_module() {
    Absent => false
    Present { value: tree } =>
      match admit_normalized_tree(import_bindings: no_import_bindings(), record_declarations: no_record_declarations(), test_markers: test_marker_channel_empty(), root: tree, diagnostics: None) {
        Rejected { diagnostics: _ } => false
        Accepted { value: normalized, diagnostics: _ } =>
          match resolve(tree: normalized, lm: dag_language_model()) {
            Accepted { value: resolved, diagnostics: _ } =>
              match wave1_gate1_find_arrow_in_module(root: resolved) {
                Present { value: arrow } =>
                  match find_arrow_body_child(root: arrow) {
                    Accepted { value: body, diagnostics: _ } =>
                      match body.kind {
                        ComputationNode { behavior: Transform } => true
                        _ => false
                      }
                    Rejected { diagnostics: _ } => false
                  }
                Absent => false
              }
            Rejected { diagnostics: _ } => false
          }
      }
  }
}
