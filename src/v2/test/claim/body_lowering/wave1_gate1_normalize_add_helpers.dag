module v2.test.claim.body_lowering.wave1_gate1_normalize_add_helpers


data wave1_gate1_add_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

fn wave1_gate1_find_arrow_in_module(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match root.kind {
    TypeNode { connective: Arrow } => v2.std.optional.Present { value: root }
    _ =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => wave1_gate1_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn wave1_gate1_normalized_module_from_source(source: String, file: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  let lm = dag_language_model()
  match v2.compiler.tokenize.tokenize(text: source, file: file, rules: lm.lex) {
    Rejected { diagnostics: _ } => v2.std.optional.Absent
    Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => v2.std.optional.Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => v2.std.optional.Absent
            Accepted { value: tree, diagnostics: _ } => v2.std.optional.Present { value: tree }
          }
      }
  }
}

fn wave1_gate1_normalized_add_module() -> v2.std.optional.Optional<v2.std.node.Node> {
  wave1_gate1_normalized_module_from_source(
    source: wave1_gate1_add_module_source,
    file: ^wave1_gate1_add_probe_file
  )
}

fn wave1_gate1_normalized_add_resolves_holds() -> v2.std.logic.Bool {
  match wave1_gate1_normalized_add_module() {
    Absent => false
    Present { value: tree } =>
      match v2.compiler.resolve.resolve(tree: tree, lm: dag_language_model()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

fn wave1_gate1_normalized_add_yields_arrow_transform_holds() -> v2.std.logic.Bool {
  match wave1_gate1_normalized_add_module() {
    Absent => false
    Present { value: tree } =>
      match wave1_gate1_find_arrow_in_module(root: tree) {
        Absent => false
        Present { value: arrow } =>
          well_formed(n: arrow)
            && match find_arrow_body_child(root: arrow) {
              Accepted { value: body, diagnostics: _ } =>
                match body.kind {
                  ComputationNode { behavior: v2.std.node.Transform } => true
                  _ => false
                }
              Rejected { diagnostics: _ } => false
            }
      }
  }
}

fn wave1_gate1_resolved_add_arrow_transform_holds() -> v2.std.logic.Bool {
  match wave1_gate1_normalized_add_module() {
    Absent => false
    Present { value: tree } =>
      match v2.compiler.resolve.resolve(tree: tree, lm: dag_language_model()) {
        Accepted { value: resolved, diagnostics: _ } =>
          match wave1_gate1_find_arrow_in_module(root: resolved) {
            Present { value: arrow } =>
              match find_arrow_body_child(root: arrow) {
                Accepted { value: body, diagnostics: _ } =>
                  match body.kind {
                    ComputationNode { behavior: v2.std.node.Transform } => true
                    _ => false
                  }
                Rejected { diagnostics: _ } => false
              }
            Absent => false
          }
        Rejected { diagnostics: _ } => false
      }
  }
}
