module v2.test.claim.body_lowering.zz_fg556_big

import v2.test.claim.body_lowering.normalize_outcome_helpers {
  body_lowering_normalize_outcome
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data big_source: String = "module v2.compiler.fold_lowering\n\nimport v2.extdeps.languages.dag {\n  dag_call_named_arg_value_optional,\n  dag_lex_token_symbol,\n  parse_production_captured_child_optional,\n  parse_production_emitted_identity_optional\n}\nimport v2.std.optional {\n  Absent,\n  Optional,\n  Present,\n  optional_absent,\n  optional_present\n}\nimport v2.std.diagnostic {\n  Accepted,\n  Diagnostic,\n  ExternalContractUnknown,\n  Outcome,\n  Rejected,\n  Unavailable,\n  node_locus,\n  outcome_accepted,\n  outcome_rejected\n}\nimport v2.std.grammar { node_atom_identity_optional }\nimport std.algebra { Cons, Empty }\nimport v2.std.collection { List }\nimport v2.std.node {\n  Atom,\n  ComputationNode,\n  Conj,\n  Edge,\n  Loop,\n  Named,\n  Node,\n  Positional,\n  Symbol,\n  TypeNode,\n  is_empty_conj_root,\n  node_synthetic\n}\nimport v2.std.node_query { find_named_child }\n\ndata fold_lowering_note: String = \"The un-forked forward lowering for fold — the first slice of the general body producer that replaces both the removed cost-shape fork and the hand-rolled MVP shapes. A surface fold has NO dedicated grammar production; it parses as an ordinary call (a ^dag_surface_primary_expr whose head ident, after the StampLexeme grammar fix, carries its NAME as an atom identity), so its lowering is a SEMANTIC desugaring keyed on the CALLEE identity (DESIGN §4: fold/recursion is sugar over Loop), never a lexeme scan. The input is the fold-call surface subtree — the primary_expr captured child, a sequence(head_ident, call_suffix) — read the homogeneous way cost_coverage locates fn bodies and the qualified-name parser reads sequence heads: fold_call_head_symbol reads the sequence-left head projection (the callee ^fold); fold_call_iteration_body finds the sole ^dag_surface_fn_literal argument and lifts its ^dag_surface_fn_body into the canonical seam Loop (matching body_producer_loop_body) bounded by the fold-iteration measure ^dag_surface_fold_iteration_measure (registered Strict in v2.std.cardinality.measure_descent_fact_registry, so loop_multiplicity derives its termination). Fail-closed twice: a call whose head is not ^fold refuses with ^fold_lowering_not_a_fold_call, and a fold call carrying no fn-literal iteration body refuses with ^fold_lowering_shape_invalid — never fabricates a loop. Verified end-to-end on real source (v2.test.claim.complexity.fold_lowering): fold(xs, init: 0, f: fn(acc, x) { acc }) lowers to a terminating Loop. This unit is the same desugaring the whole-tree body producer will run on every located fold call once corpus resolution/walking is affordable; the caller supplies the located call subtree.\"\n\nfn fold_iteration_measure_atom() -> Node {\n  node_synthetic(\n    kind: TypeNode { connective: Atom { identity: ^dag_surface_fold_iteration_measure } },\n    children: []\n  )\n}\n\nfn fold_call_head_symbol(fold_call: Node) -> Optional<Symbol> {\n  match find_named_child(root: fold_call, name: ^grammar_sequence_left_node_projection) {\n    Accepted { value: head, diagnostics: _ } => node_atom_identity_optional(node: head)\n    Rejected { diagnostics: _ } => Absent\n  }\n}\n\n// MEMBERSHIP IS DERIVED FROM THE STEP-SLOT ROW SET, NOT RESTATED BESIDE IT (review 65812 on\n// gunbc#11315). A callee is fold-family exactly when it declares a step slot, so a fifth member\n// added to one list and not the other cannot exist: it would either lower or not be a member,\n// never sit in the family with no slot and fall silently into FoldCallStepFormUnresolved.\nfn fold_family_head(sym: Symbol) -> Bool {\n  match fold_step_argument_name(head: sym) {\n    Present { value: _ } => true\n    Absent => false\n  }\n}\n\n// THE STEP FORM IS A CLOSED SET THE GRAMMAR DECLARES, AND THE READING MUST BE TOTAL OVER IT\n// AND POSITIONED AT THE STEP ARGUMENT. v2.extdeps.languages.dag declares TWO function-value\n// productions reachable in argument position -- ^dag_production_fn_literal (emitted\n// ^dag_surface_fn_literal) and ^dag_production_arrow_lambda (emitted ^dag_surface_arrow_lambda)\n// -- and this stage searched for the first only. A step spelled `f: (acc, x) => ...` was\n// therefore read as \"no step form present\" and shared one state with a step passed BY NAME,\n// which is a different fact: the arrow lambda's binder and body are IN HAND here exactly as the\n// fn literal's are, while a named step's binder is a callee-resolution fact this stage does not\n// have. Collapsing the two is what made the fold site lose its carrier and, with it, its LOWERED\n// shape -- the site the complexity lens enumerates (gunbc.recurring_failure_mode\n// fold_shape_visible_to_no_lens).\n//\n// THE SEARCH GRAIN IS THE SECOND HALF OF THE SAME DEFECT, AND IT PRE-DATES THE ARROW ARM\n// (review 65699). parse_subtree_find_production_captured is a whole-subtree PRE-ORDER FIRST\n// MATCH, not a read of the step argument, so `fold(xs, init: 0, f: (acc, x) => fold(x, init:\n// acc, f: fn(a, b) { a }))` classified on the INNER fn literal and built a seam Loop whose body\n// and carrier belong to the inner lambda -- a fabricated, plausible lowering handed to the\n// complexity lens, which then answers about the wrong carrier (DESIGN section 5). The same\n// search reached inside a `fold_node(algebra: NodeFold { ... })` record, whose step is not a\n// lambda at all. So the step form is now read from the STEP ARGUMENT of THIS call, located by\n// the binding name the callee declares, and from that argument the reading descends only the\n// CAPTURED-CHILD CHAIN -- never across siblings -- so no construction nested inside the step's\n// own body can be mistaken for the step.\n//\n// StepByName is a REAL arm over the residue, not a fall-through: it is reached when the step\n// argument is absent, carries no declared inline step production, or carries a shape this stage\n// cannot decide (a named step, an algebra record). It keeps yielding the same\n// FoldCallStepFormUnresolved the seam produced before, so the ^fold_accumulator_unread refusal\n// it feeds stays reachable rather than being papered over by a wider accept.\ntype FoldStepForm\n  = StepFnLiteral { literal: Node }\n  | StepArrowLambda { lambda: Node }\n  | StepByName\n\n// The step's binding name is a fact each fold-family callee declares, and they differ:\n// v2.std.algebra fold_list(xs:, empty:, cons:) and fold_list_right(xs:, empty:, snoc:),\n// v2.std.node fold_node(n:, algebra:). fold_node's step is a RECORD rather than a lambda, so\n// naming it here is what keeps the reading from descending into that record looking for one.\nfn some_step_argument_name(name: Symbol) -> Optional<Symbol> {\n  Present { value: name }\n}\n\nfn no_step_argument_name() -> Optional<Symbol> {\n  Absent\n}\n\nfn fold_step_argument_name(head: Symbol) -> Optional<Symbol> {\n  if head == ^fold {\n    some_step_argument_name(name: ^f)\n  } else if head == ^fold_list {\n    some_step_argument_name(name: ^cons)\n  } else if head == ^fold_list_right {\n    some_step_argument_name(name: ^snoc)\n  } else if head == ^fold_node {\n    some_step_argument_name(name: ^algebra)\n  } else {\n    no_step_argument_name()\n  }\n}\n\n// Descends the CAPTURED-CHILD CHAIN of the step argument's value and nothing else: an expr\n// wrapper chain has exactly one captured child per link, so this reaches the step's own\n// production or runs out. It never folds over siblings, which is what stops a literal written\n// INSIDE the step's body from being read as the step.\nfn fold_step_form_at(node: Node) -> FoldStepForm {\n  match parse_production_emitted_identity_optional(node: node) {\n    Absent => StepByName\n    Present { value: id } =>\n      match parse_production_captured_child_optional(node: node) {\n        Absent => StepByName\n        Present { value: captured } =>\n          if id == ^dag_surface_fn_literal {\n            StepFnLiteral { literal: captured }\n          } else if id == ^dag_surface_arrow_lambda {\n            StepArrowLambda { lambda: captured }\n          } else {\n            fold_step_form_at(node: captured)\n          }\n      }\n  }\n}\n\nfn fold_call_step_form(fold_call: Node, head: Symbol) -> FoldStepForm {\n  match fold_step_argument_name(head: head) {\n    Absent => StepByName\n    Present { value: step_name } =>\n      match dag_call_named_arg_value_optional(node: fold_call, name: step_name) {\n        Absent => StepByName\n        Present { value: step_value } => fold_step_form_at(node: step_value)\n      }\n  }\n}\n\nfn fold_seq_child(node: Node, name: Symbol) -> Optional<Node> {\n  match find_named_child(root: node, name: name) {\n    Accepted { value: child, diagnostics: _ } => Present { value: child }\n    Rejected { diagnostics: _ } => Absent\n  }\n}\n\nfn fold_seq_right(node: Node) -> Optional<Node> {\n  fold_seq_child(node: fv_unwrap(node: node), name: ^grammar_sequence_right_node_projection)\n}\n\nfn fold_seq_left(node: Node) -> Optional<Node> {\n  fold_seq_child(node: fv_unwrap(node: node), name: ^grammar_sequence_left_node_projection)\n}\n\n// THE ONE READER OF A FUNCTION VALUE'S PARSE. v2.extdeps.languages.dag declares two function-value\n// productions, and every stage that needs a function value's binders, return clause or body reads\n// them HERE, off the declared grammar rows, and nowhere else: this stage's fold step (carrier = the\n// first binder, iteration body = the body) and v2.compiler.body_lowering_fold's value-position\n// producer (body_lower_function_value_arrow). A change to either grammar row is one edit to this\n// reader. The rows, as sequences read LEFT/RIGHT (an elided optional is the empty conj):\n//\n//   dag_grammar_arrow_lambda_expr, a Choice returned WITHOUT a choice wrapper, told apart by the\n//   first slot (a lexical token there IS the `(`; an ident-lexeme atom is the bare binder):\n//     bare           seq(ident, seq(`=>`, expr))\n//     parenthesised  seq(`(`, seq(ident, seq(`,`, seq(ident, seq(repeat(seq(`,`, ident)),\n//                      seq(`)`, seq(`=>`, expr)))))))\n//   dag_grammar_fn_literal_expr:\n//     seq(`fn`, seq(`(`, seq(opt(comma_list(ident)), seq(`)`, seq(opt(seq(`->`, type_expr)), fn_body)))))\n//   dag_grammar_comma_list_expr(item) = seq(item, seq(repeat(seq(opt(`,`), item)), opt(`,`)))\n//\n// Absent means the capture is not one of those shapes. Callers refuse on it; nothing here guesses.\ntype FunctionValueBinder {\n  name: Symbol\n  at: Node\n}\n\ntype FunctionValueBody\n  = FunctionValueExprBody { expr: Node }\n  | FunctionValueBlockBody { fn_body: Node }\n\ntype FunctionValueParts {\n  binders: List<FunctionValueBinder>\n  return_clause: Node\n  body: FunctionValueBody\n}\n\nfn fv_unwrap(node: Node) -> Node {\n  match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {\n    Accepted { value: child, diagnostics: _ } => fv_unwrap(node: child)\n    Rejected { diagnostics: _ } => node\n  }\n}\n\nfn fv_token_is(node: Node, token: Symbol) -> Bool {\n  match node_atom_identity_optional(node: fv_unwrap(node: node)) {\n    Present { value: id } => id == token\n    Absent => false\n  }\n}\n\n// A binder is an ident-lexeme atom; a lexical token in its slot is not a binder.\nfn fv_binder_optional(node: Node) -> Optional<FunctionValueBinder> {\n  let at = fv_unwrap(node: node)\n  match node_atom_identity_optional(node: at) {\n    Present { value: sym } =>\n      if dag_lex_token_symbol(sym: sym) { optional_absent() } else { optional_present(value: FunctionValueBinder { name: sym, at: at }) }\n    Absent => optional_absent()\n  }\n}\n\nfn fv_no_binders() -> List<FunctionValueBinder> {\n  Empty\n}\n\n// repeat(seq(sep, ident)): the empty conj, or seq(seq(sep, ident), repeat). The separator is a\n// required `,` in the lambda row and an optional one in comma_list.\nfn fv_repeat_binders_optional(repeat: Node, comma_required: Bool) -> Optional<List<FunctionValueBinder>> {\n  let r = fv_unwrap(node: repeat)\n  if is_empty_conj_root(n: r) {\n    optional_present(value: fv_no_binders())\n  } else {\n    match fold_seq_left(node: r) {\n      Absent => optional_absent()\n      Present { value: element } =>\n        match fold_seq_left(node: element) {\n          Absent => optional_absent()\n          Present { value: sep } =>\n            if fv_token_is(node: sep, token: ^dag_token_comma)\n              || ((!comma_required) && is_empty_conj_root(n: fv_unwrap(node: sep))) {\n              match fold_seq_right(node: element) {\n                Absent => optional_absent()\n                Present { value: item } =>\n                  match fv_binder_optional(node: item) {\n                    Absent => optional_absent()\n                    Present { value: b } =>\n                      match fold_seq_right(node: r) {\n                        Absent => optional_absent()\n                        Present { value: rest_repeat } =>\n                          match fv_repeat_binders_optional(repeat: rest_repeat, comma_required: comma_required) {\n                            Absent => optional_absent()\n                            Present { value: rest } => optional_present(value: Cons { head: b, tail: rest })\n                          }\n                      }\n                  }\n              }\n            } else {\n              Absent\n            }\n        }\n    }\n  }\n}\n\n// seq(`=>`, expr) -> the expr.\nfn fv_after_fat_arrow_optional(node: Node) -> Optional<Node> {\n  match fold_seq_left(node: node) {\n    Absent => optional_absent()\n    Present { value: arrow } =>\n      if fv_token_is(node: arrow, token: ^dag_token_fat_arrow) { fold_seq_right(node: node) } else { optional_absent() }\n  }\n}\n\nfn fv_expr_parts(binders: List<FunctionValueBinder>, after_binders: Node) -> Optional<FunctionValueParts> {\n  match fv_after_fat_arrow_optional(node: after_binders) {\n    Absent => optional_absent()\n    Present { value: expr } =>\n      Present {\n        value: FunctionValueParts {\n          binders: binders,\n          return_clause: fv_empty_return_clause(),\n          body: FunctionValueExprBody { expr: expr }\n        }\n      }\n  }\n}\n\n// A lambda writes no return clause; the empty conj is the grammar's own elided-optional value.\nfn fv_empty_return_clause() -> Node {\n  node_synthetic(kind: TypeNode { connective: Conj }, children: [])\n}\n\nfn arrow_lambda_parts_optional(lambda: Node) -> Optional<FunctionValueParts> {\n  match fold_seq_left(node: lambda) {\n    Absent => optional_absent()\n    Present { value: head } =>\n      if fv_token_is(node: head, token: ^dag_token_lparen) {\n        match fold_seq_right(node: lambda) {\n          Absent => optional_absent()\n          Present { value: s1 } =>\n            match fold_seq_left(node: s1) {\n              Absent => optional_absent()\n              Present { value: first_node } =>\n                match fold_seq_right(node: s1) {\n                  Absent => optional_absent()\n                  Present { value: s2 } =>\n                    match fold_seq_right(node: s2) {\n                      Absent => optional_absent()\n                      Present { value: s3 } =>\n                        match fold_seq_right(node: s3) {\n                          Absent => optional_absent()\n                          Present { value: s4 } =>\n                            match fold_seq_right(node: s4) {\n                              Absent => optional_absent()\n                              Present { value: s5 } =>\n                                match fv_seq_parts(first: first_node, comma: fold_seq_left(node: s2), second: fold_seq_left(node: s3), repeat: fold_seq_left(node: s4), close: fold_seq_left(node: s5)) {\n                                  Absent => optional_absent()\n                                  Present { value: binders } =>\n                                    match fold_seq_right(node: s5) {\n                                      Absent => optional_absent()\n                                      Present { value: after } => fv_expr_parts(binders: binders, after_binders: after)\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n      } else {\n        match fv_binder_optional(node: head) {\n          Absent => optional_absent()\n          Present { value: b } =>\n            match fold_seq_right(node: lambda) {\n              Absent => optional_absent()\n              Present { value: after } => fv_expr_parts(binders: Cons { head: b, tail: Empty }, after_binders: after)\n            }\n        }\n      }\n  }\n}\n\n// The parenthesised lambda's slots: first binder, `,`, second binder, repeat, `)`.\nfn fv_seq_parts(\n  first: Node,\n  comma: Optional<Node>,\n  second: Optional<Node>,\n  repeat: Optional<Node>,\n  close: Optional<Node>\n) -> Optional<List<FunctionValueBinder>> {\n  match comma {\n    Absent => optional_absent()\n    Present { value: c } =>\n      match close {\n        Absent => optional_absent()\n        Present { value: rp } =>\n          if fv_token_is(node: c, token: ^dag_token_comma) && fv_token_is(node: rp, token: ^dag_token_rparen) {\n            match fv_binder_optional(node: first) {\n              Absent => optional_absent()\n              Present { value: b1 } =>\n                match second {\n                  Absent => optional_absent()\n                  Present { value: s } =>\n                    match fv_binder_optional(node: s) {\n                      Absent => optional_absent()\n                      Present { value: b2 } =>\n                        match repeat {\n                          Absent => optional_absent()\n                          Present { value: rep } =>\n                            match fv_repeat_binders_optional(repeat: rep, comma_required: true) {\n                              Absent => optional_absent()\n                              Present { value: rest } => optional_present(value: Cons { head: b1, tail: Cons { head: b2, tail: rest } })\n                            }\n                        }\n                    }\n                }\n            }\n          } else {\n            Absent\n          }\n      }\n  }\n}\n\n// opt(comma_list(ident)): the empty conj (no params), or seq(first, seq(repeat, opt(`,`))).\nfn fv_comma_list_binders_optional(params: Node) -> Optional<List<FunctionValueBinder>> {\n  let p = fv_unwrap(node: params)\n  if is_empty_conj_root(n: p) {\n    optional_present(value: fv_no_binders())\n  } else {\n    match fold_seq_left(node: p) {\n      Absent => optional_absent()\n      Present { value: first_node } =>\n        match fv_binder_optional(node: first_node) {\n          Absent => optional_absent()\n          Present { value: first } =>\n            match fold_seq_right(node: p) {\n              Absent => optional_absent()\n              Present { value: tail } =>\n                match fold_seq_left(node: tail) {\n                  Absent => optional_absent()\n                  Present { value: rep } =>\n                    match fv_repeat_binders_optional(repeat: rep, comma_required: false) {\n                      Absent => optional_absent()\n                      Present { value: rest } => optional_present(value: Cons { head: first, tail: rest })\n                    }\n                }\n            }\n        }\n    }\n  }\n}\n\nfn fn_literal_parts_optional(fn_literal: Node) -> Optional<FunctionValueParts> {\n  match fold_seq_right(node: fn_literal) {\n    Absent => optional_absent()\n    Present { value: after_fn } =>\n      match fold_seq_right(node: after_fn) {\n        Absent => optional_absent()\n        Present { value: after_lparen } =>\n          match fold_seq_left(node: after_lparen) {\n            Absent => optional_absent()\n            Present { value: params } =>\n              match fold_seq_right(node: after_lparen) {\n                Absent => optional_absent()\n                Present { value: after_params } =>\n                  match fold_seq_left(node: after_params) {\n                    Absent => optional_absent()\n                    Present { value: rparen } =>\n                      if fv_token_is(node: rparen, token: ^dag_token_rparen) {\n                        match fold_seq_right(node: after_params) {\n                          Absent => optional_absent()\n                          Present { value: after_rparen } =>\n                            match fold_seq_left(node: after_rparen) {\n                              Absent => optional_absent()\n                              Present { value: ret } =>\n                                match fold_seq_right(node: after_rparen) {\n                                  Absent => optional_absent()\n                                  Present { value: fn_body } =>\n                                    match fv_comma_list_binders_optional(params: params) {\n                                      Absent => optional_absent()\n                                      Present { value: binders } =>\n                                        Present {\n                                          value: FunctionValueParts {\n                                            binders: binders,\n                                            return_clause: ret,\n                                            body: FunctionValueBlockBody { fn_body: fn_body }\n                                          }\n                                        }\n                                    }\n                                }\n                            }\n                        }\n                      } else {\n                        Absent\n                      }\n                  }\n              }\n          }\n      }\n  }\n}\n\n// The captured child of a function-value production, by its emitted identity.\nfn function_value_parts_optional(captured: Node, emitted: Symbol) -> Optional<FunctionValueParts> {\n  if emitted == ^dag_surface_arrow_lambda {\n    arrow_lambda_parts_optional(lambda: captured)\n  } else if emitted == ^dag_surface_fn_literal {\n    fn_literal_parts_optional(fn_literal: captured)\n  } else {\n    Absent\n  }\n}\n\n// THE FOLD STEP IS A PROJECTION OF THOSE PARTS. The accumulator carrier is the step's FIRST binder\n// and the iteration body is its body. THE BARE LAMBDA CANNOT BE A FOLD STEP: a fold step takes\n// (accumulator, item), and the grammar admits the single-binder form for ordinary one-argument\n// lambdas; reading its sole binder as an accumulator would fabricate a carrier the source never\n// declared. So an arrow-lambda step needs the parenthesised (two or more binder) form. A fn literal\n// step's body is its fn_body block's captured child, as body_producer_loop_body reads it.\nfn fold_step_first_binder(parts: FunctionValueParts) -> Optional<Symbol> {\n  match parts.binders {\n    Cons { head: b, tail: _ } => optional_present(value: b.name)\n    Empty => optional_absent()\n  }\n}\n\nfn fold_step_has_two_binders(parts: FunctionValueParts) -> Bool {\n  match parts.binders {\n    Cons { head: _, tail: Cons { head: _, tail: _ } } => true\n    _ => false\n  }\n}\n\nfn fold_step_body(parts: FunctionValueParts) -> Optional<Node> {\n  match parts.body {\n    FunctionValueExprBody { expr: e } => optional_present(value: e)\n    FunctionValueBlockBody { fn_body: b } => parse_production_captured_child_optional(node: fv_unwrap(node: b))\n  }\n}\n\nfn step_fn_iteration_body(fn_literal: Node) -> Optional<Node> {\n  match fn_literal_parts_optional(fn_literal: fn_literal) {\n    Absent => optional_absent()\n    Present { value: parts } => fold_step_body(parts: parts)\n  }\n}\n\nfn step_fn_carrier_binder_symbol(fn_literal: Node) -> Optional<Symbol> {\n  match fn_literal_parts_optional(fn_literal: fn_literal) {\n    Absent => optional_absent()\n    Present { value: parts } => fold_step_first_binder(parts: parts)\n  }\n}\n\nfn arrow_lambda_iteration_body(lambda: Node) -> Optional<Node> {\n  match arrow_lambda_parts_optional(lambda: lambda) {\n    Absent => optional_absent()\n    Present { value: parts } =>\n      if fold_step_has_two_binders(parts: parts) { fold_step_body(parts: parts) } else { optional_absent() }\n  }\n}\n\nfn arrow_lambda_carrier_binder_symbol(lambda: Node) -> Optional<Symbol> {\n  match arrow_lambda_parts_optional(lambda: lambda) {\n    Absent => optional_absent()\n    Present { value: parts } =>\n      if fold_step_has_two_binders(parts: parts) { fold_step_first_binder(parts: parts) } else { optional_absent() }\n  }\n}\n\nfn fold_lowering_not_a_fold_call_diagnostic(n: Node) -> Diagnostic {\n  Diagnostic {\n    reason: ^fold_lowering_not_a_fold_call,\n    at: node_locus(node: n),\n    correction: Unavailable { reason: ExternalContractUnknown }\n  }\n}\n\nfn fold_lowering_shape_invalid_diagnostic(n: Node) -> Diagnostic {\n  Diagnostic {\n    reason: ^fold_lowering_shape_invalid,\n    at: node_locus(node: n),\n    correction: Unavailable { reason: ExternalContractUnknown }\n  }\n}\n\nfn fold_lowering_step_form_unresolved_diagnostic(n: Node) -> Diagnostic {\n  Diagnostic {\n    reason: ^fold_lowering_step_form_unresolved,\n    at: node_locus(node: n),\n    correction: Unavailable { reason: ExternalContractUnknown }\n  }\n}\n\nfn fold_carrier_binder_atom(binder: Symbol) -> Node {\n  node_synthetic(\n    kind: TypeNode { connective: Atom { identity: binder } },\n    children: []\n  )\n}\n\nfn fold_call_seam_loop(body: Node, carrier: Symbol) -> Node {\n  node_synthetic(\n    kind: ComputationNode { behavior: Loop },\n    children: [\n      Edge { label: Positional, target: body },\n      Edge { label: Named { name: ^loop_bound_edge }, target: fold_iteration_measure_atom() },\n      Edge { label: Named { name: ^loop_carrier_edge }, target: fold_carrier_binder_atom(binder: carrier) }\n    ]\n  )\n}\n\n// THE ONE ROOT AT WHICH EVERY INLINE STEP SPELLING MEETS. Each declared inline step form\n// projects onto the same two seam inputs -- an iteration body and an accumulator binder -- and\n// from here on there is no per-spelling arm: one seam Loop, built by fold_call_seam_loop, which\n// is what the complexity lens's LOWERED shape enumerates. A step form whose own grammar puts\n// both projections in hand and yields neither is malformed, which is the one judgement this\n// stage HAS earned, so it keeps the existing shape_invalid refusal and never fabricates a Loop.\nfn fold_call_seam_from_step(\n  fold_call: Node,\n  body: Optional<Node>,\n  carrier: Optional<Symbol>\n) -> FoldCallLowering {\n  match body {\n    Absent =>\n      FoldCallStepShapeInvalid {\n        diagnostic: fold_lowering_shape_invalid_diagnostic(n: fold_call)\n      }\n    Present { value: b } =>\n      match carrier {\n        Absent =>\n          FoldCallStepShapeInvalid {\n            diagnostic: fold_lowering_shape_invalid_diagnostic(n: fold_call)\n          }\n        Present { value: c } =>\n          FoldCallLowered { seam_loop: fold_call_seam_loop(body: b, carrier: c) }\n      }\n  }\n}\n\ntype FoldCallLowering\n  = FoldCallLowered { seam_loop: Node }\n  | FoldCallNotAFold { diagnostic: Diagnostic }\n  | FoldCallStepFormUnresolved { diagnostic: Diagnostic }\n  | FoldCallStepShapeInvalid { diagnostic: Diagnostic }\n\n// WHY THIS COPRODUCT EXISTS: a state-space split, not a new mechanism. fold_call_to_loop answered\n// one question -- did this call lower -- with a two-state Outcome, so every reason it did not lower\n// arrived as one Rejected. Two of those reasons are not the same state. A fold-family call carrying\n// a malformed fn literal (no body, no first param) is decidable HERE: the literal is in hand and\n// cannot be a step. A fold-family call carrying NO fn literal is not decidable here -- the step may\n// have been omitted, or passed by name (v2.std.algebra fold_list(xs: t, empty: ..., cons: cons)),\n// or the callee may take an algebra record rather than a step (v2.std.node fold_node(n:,\n// algebra:)). Telling those apart requires reading the callee declaration, which this stage\n// deliberately does not do -- v2.lens.complexity_accumulator_copy.analyze fold_family_carrier\n// already records the named-step-fn case as a Stage B callee-resolution fact. Naming that state\n// shape_invalid asserts malformedness the stage cannot establish:\n// body_lowering_rejection_propagation_note's not-applicable-versus-malformed conflation from the\n// other direction.\n//\n// No Loop is fabricated on any arm; that guarantee is untouched. What changes is only which arm a\n// caller may treat as a counted frontier state rather than a refusal, and the sole caller doing so\n// is v2.compiler.body_lowering_fold body_lower_try_fold_loop.\nfn fold_call_lowering(fold_call: Node) -> FoldCallLowering {\n  match fold_call_head_symbol(fold_call: fold_call) {\n    Absent =>\n      FoldCallNotAFold { diagnostic: fold_lowering_not_a_fold_call_diagnostic(n: fold_call) }\n    Present { value: head } =>\n      if fold_family_head(sym: head) {\n        match fold_call_step_form(fold_call: fold_call, head: head) {\n          StepByName =>\n            FoldCallStepFormUnresolved {\n              diagnostic: fold_lowering_step_form_unresolved_diagnostic(n: fold_call)\n            }\n          StepFnLiteral { literal: fn_literal } =>\n            fold_call_seam_from_step(\n              fold_call: fold_call,\n              body: step_fn_iteration_body(fn_literal: fn_literal),\n              carrier: step_fn_carrier_binder_symbol(fn_literal: fn_literal)\n            )\n          StepArrowLambda { lambda: lambda } =>\n            fold_call_seam_from_step(\n              fold_call: fold_call,\n              body: arrow_lambda_iteration_body(lambda: lambda),\n              carrier: arrow_lambda_carrier_binder_symbol(lambda: lambda)\n            )\n        }\n      } else {\n        FoldCallNotAFold { diagnostic: fold_lowering_not_a_fold_call_diagnostic(n: fold_call) }\n      }\n  }\n}\n\n// The two-state projection of the authority above, kept byte-for-byte in its old semantics: every\n// non-lowered arm is still a refusal here. Consumers that only ask \"did it lower\" -- the\n// accumulator-copy lens -- are unaffected by the split.\nfn fold_call_to_loop(fold_call: Node) -> Outcome<Node> {\n  match fold_call_lowering(fold_call: fold_call) {\n    FoldCallLowered { seam_loop: seam_loop } => outcome_accepted(value: seam_loop)\n    FoldCallNotAFold { diagnostic: d } => outcome_rejected(d: d)\n    FoldCallStepFormUnresolved { diagnostic: d } => outcome_rejected(d: d)\n    FoldCallStepShapeInvalid { diagnostic: d } => outcome_rejected(d: d)\n  }\n}\n"

test fn big_dag() -> String { body_lowering_normalize_outcome(src: big_source, file: ^zz_big_subject) }
