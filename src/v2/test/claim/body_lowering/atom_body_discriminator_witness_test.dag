// Atom-body vs arity discriminator: one tokenize→parse→normalize→resolve pass over the
// four-declaration module, then declaration/parameter_count/ArrowBodyForm rows,
// production eval value assertions (id(7)==7, zero()==0, add(2,3)==5), and both
// RED mirror directions on the same resolved tree.
// Substrate long-lane enrolled (~5002ms thread-CPU locally): the mechanism is
// the production frontend crossing plus eval on the same normalized arrows.

test fn atom_body_discriminator_single_pass_receipt_holds() -> Bool {
  atom_body_discriminator_batched_receipt_holds()
}
