fn wave1_gate1_d_arrow_body_is_match(o: Outcome<Node>) -> Bool {
  match o {
    Accepted { value: arrow, diagnostics: _ } =>
      match find_arrow_body_child(root: arrow) {
        Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            ComputationNode { behavior: Match } => true
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn wave1_gate1_d_census_fixture_variants_well_formed_holds() -> Bool {
  wave1_gate1_d_arrow_well_formed_with_body(o: ingested_add_arrow_with_body())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_add_arrow_with_body_swapped_operands())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_pick_if_arrow_with_body())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_pick_if_arrow_with_body_swapped_arms())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_loop_arrow_with_body())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_loop_arrow_with_body_wrong_value())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_bind_arrow_with_body())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_bind_arrow_with_body_wrong_value())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_match_arrow_with_body())
    && wave1_gate1_d_arrow_well_formed_with_body(o: ingested_match_arrow_with_body_swapped_arms())
}

fn wave1_gate1_d_census_ingested_behavior_kinds_holds() -> Bool {
  wave1_gate1_d_arrow_body_is_transform(o: ingested_add_arrow_with_body())
    && wave1_gate1_d_arrow_body_is_transform(o: ingested_add_arrow_with_body_swapped_operands())
    && wave1_gate1_d_arrow_body_is_branch(o: ingested_pick_if_arrow_with_body())
    && wave1_gate1_d_arrow_body_is_branch(o: ingested_pick_if_arrow_with_body_swapped_arms())
    && wave1_gate1_d_arrow_body_is_loop(o: ingested_loop_arrow_with_body())
    && wave1_gate1_d_arrow_body_is_loop(o: ingested_loop_arrow_with_body_wrong_value())
    && wave1_gate1_d_arrow_body_is_bind(o: ingested_bind_arrow_with_body())
    && wave1_gate1_d_arrow_body_is_bind(o: ingested_bind_arrow_with_body_wrong_value())
    && wave1_gate1_d_arrow_body_is_match(o: ingested_match_arrow_with_body())
    && wave1_gate1_d_arrow_body_is_match(o: ingested_match_arrow_with_body_swapped_arms())
}

fn wave1_gate1_d_census_subsumption_holds() -> Bool {
  wave1_gate1_d_census_fixture_variants_well_formed_holds()
    && wave1_gate1_d_census_ingested_behavior_kinds_holds()
}
