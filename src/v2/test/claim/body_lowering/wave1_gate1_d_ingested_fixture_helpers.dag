module v2.test.claim.body_lowering.wave1_gate1_d_ingested_fixture_helpers


data wave1_gate1_d_note: String = "Wave 1 Gate 1 Stage D long-lane helpers: census ingest via ingested_fixture_arrows. Well-formedness + behavior-kind checks here; ingested bind/loop execution+RED in long/wave1_gate1_d_ingested_bind_loop_eval_witness_test.dag; add/pick/match execution in general_body_producer + pick_ingested + classical_not witnesses."

fn wave1_gate1_d_arrow_well_formed_with_body(o: Outcome<Node>) -> Bool {
  match o {
    Accepted { value: arrow, diagnostics: _ } =>
      well_formed(n: arrow)
        && match find_arrow_body_child(root: arrow) {
          Accepted { value: _, diagnostics: _ } => true
          Rejected { diagnostics: _ } => false
        }
    Rejected { diagnostics: _ } => false
  }
}

fn wave1_gate1_d_arrow_body_is_transform(o: Outcome<Node>) -> Bool {
  match o {
    Accepted { value: arrow, diagnostics: _ } =>
      match find_arrow_body_child(root: arrow) {
        Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            ComputationNode { behavior: Transform } => true
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn wave1_gate1_d_arrow_body_is_branch(o: Outcome<Node>) -> Bool {
  match o {
    Accepted { value: arrow, diagnostics: _ } =>
      match find_arrow_body_child(root: arrow) {
        Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            ComputationNode { behavior: Branch } => true
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

