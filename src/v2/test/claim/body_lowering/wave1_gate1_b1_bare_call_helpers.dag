module v2.test.claim.body_lowering.wave1_gate1_b1_bare_call_helpers

import v2.compiler.reference_conservation_admission { conserved_normalize_of_text, no_explained_drops }
import v2.extdeps.languages.dag { qualified_name_from_module_node }


data wave1_gate1_b1_bare_call_module_source: String = "module wave1_gate1_b1_bare_call\n\nfn helper(x: Int) -> Int { x + x }\n\nfn caller(x: Int) -> Int { helper(x) }\n"

data wave1_gate1_b1_builtin_call_module_source: String = "module wave1_gate1_b1_builtin_call\n\nfn caller(x: Int) -> Int { fold(x, 0, fn(acc, _) { acc }) }\n"

data wave1_gate1_b1_unbound_call_module_source: String = "module wave1_gate1_b1_unbound_call\n\nfn caller(x: Int) -> Int { x + totally_nonexistent_symbol_xyz }\n"

fn wave1_gate1_b1_resolve_source(source: String) -> Bool {
  match conserved_normalize_of_text(path: "wave1_gate1_b1_probe_file", text: source, explained: no_explained_drops()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: root, diagnostics: _ } =>
      match qualified_name_from_module_node(root: root.root) {
        Rejected { diagnostics: _ } => false
        Accepted { value: module_qn, diagnostics: _ } =>
          match resolve_with_admission(
            lm: dag_language_model(),
            roots: Cons { head: root, tail: Empty },
            admission: Admission {
              subject: ResolutionSubject { name: module_qn },
              imports: Empty
            }
          ) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn wave1_gate1_b1_normalized_module(source: String) -> Optional<Node> {
  match conserved_normalize_of_text(path: "wave1_gate1_b1_probe_file", text: source, explained: no_explained_drops()) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: tree, diagnostics: _ } => Present { value: tree }
  }
}

fn wave1_gate1_b1_arrow_named_body_optional(arrow: Node) -> Optional<Node> {
  fold(arrow.children, init: Absent, f: fn(acc, body_edge) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match body_edge.label {
          Named { name: _ } => Present { value: body_edge.target }
          Positional => Absent
        }
    }
  })
}

fn wave1_gate1_b1_find_named_fn_arrow_body(root: Node, fn_lexeme: String) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: Absent, f: fn(acc, edge) {
        match acc {
          Present { value: _ } => acc
          Absent =>
            match edge.label {
              Named { name: sym } =>
                if symbol_lexeme(sym: sym) == fn_lexeme {
                  match edge.target.kind {
                    TypeNode { connective: Arrow } =>
                      wave1_gate1_b1_arrow_named_body_optional(arrow: edge.target)
                    _ => Absent
                  }
                } else {
                  wave1_gate1_b1_find_named_fn_arrow_body(root: edge.target, fn_lexeme: fn_lexeme)
                }
              Positional =>
                wave1_gate1_b1_find_named_fn_arrow_body(root: edge.target, fn_lexeme: fn_lexeme)
            }
        }
      })
    _ =>
      fold(root.children, init: Absent, f: fn(acc, edge) {
        match acc {
          Present { value: _ } => acc
          Absent => wave1_gate1_b1_find_named_fn_arrow_body(root: edge.target, fn_lexeme: fn_lexeme)
        }
      })
  }
}

fn wave1_gate1_b1_caller_body_has_transform(source: String) -> Bool {
  match wave1_gate1_b1_normalized_module(source: source) {
    Absent => false
    Present { value: root } =>
      match wave1_gate1_b1_find_named_fn_arrow_body(root: root, fn_lexeme: "caller") {
        Present { value: body } =>
          match body.kind {
            ComputationNode { behavior: Transform } => true
            _ => false
          }
        Absent => false
      }
  }
}

fn wave1_gate1_b1_bare_call_lowers_to_transform_holds() -> Bool {
  wave1_gate1_b1_caller_body_has_transform(source: wave1_gate1_b1_bare_call_module_source)
}

fn wave1_gate1_b1_bare_call_resolves_end_to_end_holds() -> Bool {
  wave1_gate1_b1_resolve_source(source: wave1_gate1_b1_bare_call_module_source)
}

fn wave1_gate1_b1_builtin_call_resolves_end_to_end_holds() -> Bool {
  wave1_gate1_b1_resolve_source(source: wave1_gate1_b1_builtin_call_module_source)
}

fn wave1_gate1_b1_unbound_call_resolve_rejects_holds() -> Bool {
  match wave1_gate1_b1_resolve_source(source: wave1_gate1_b1_unbound_call_module_source) {
    true => false
    false => true
  }
}
