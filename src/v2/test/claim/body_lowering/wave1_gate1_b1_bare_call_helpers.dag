module v2.test.claim.body_lowering.wave1_gate1_b1_bare_call_helpers

import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
  resolve_with_admission
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_language_model,
  qualified_name_from_module_node
}
import std.algebra { Cons, Empty }
import v2.std.collection { Absent, Optional, Present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  ComputationNode,
  Conj,
  Node,
  Transform,
  TypeNode
}

data wave1_gate1_b1_bare_call_module_source: String = "module wave1_gate1_b1_bare_call\n\nfn helper(x: Int) -> Int { x + x }\n\nfn caller(x: Int) -> Int { helper(x) }\n"

data wave1_gate1_b1_builtin_call_module_source: String = "module wave1_gate1_b1_builtin_call\n\nfn caller(x: Int) -> Int { fold(x, 0, fn(acc, _) { acc }) }\n"

data wave1_gate1_b1_bare_call_infix_module_source: String = "module wave1_gate1_b1_bare_call\n\nfn helper(x: Int) -> Int { x + x }\n\nfn caller(x: Int) -> Int { helper(x) + x }\n"

data wave1_gate1_b1_unbound_call_module_source: String = "module wave1_gate1_b1_unbound_call\n\nfn caller(x: Int) -> Int { totally_nonexistent_symbol_xyz(x) }\n"

fn wave1_gate1_b1_infix_call_resolves_end_to_end_holds() -> Bool {
  wave1_gate1_b1_resolve_source(source: wave1_gate1_b1_bare_call_infix_module_source)
}

fn wave1_gate1_b1_resolve_source(source: String) -> Bool {
  let lm = dag_language_model()
  match tokenize(text: source, file: ^wave1_gate1_b1_probe_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: root, diagnostics: _ } =>
              match qualified_name_from_module_node(root: root) {
                Rejected { diagnostics: _ } => false
                Accepted { value: module_qn, diagnostics: _ } =>
                  match resolve_with_admission(
                    lm: lm,
                    roots: Cons { head: root, tail: Empty },
                    admission: Admission {
                      subject: ResolutionSubject { name: module_qn },
                      imports: Empty
                    }
                  ) {
                    Accepted { value: _, diagnostics: _ } => true
                    Rejected { diagnostics: _ } => false
                  }
              }
          }
      }
  }
}

fn wave1_gate1_b1_normalized_module(source: String) -> Optional<Node> {
  let lm = dag_language_model()
  match tokenize(text: source, file: ^wave1_gate1_b1_probe_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: tree, diagnostics: _ } => Present { value: tree }
          }
      }
  }
}

fn wave1_gate1_b1_find_transform_in_module(root: Node) -> Optional<Node> {
  match root.kind {
    ComputationNode { behavior: Transform } => Present { value: root }
    TypeNode { connective: Arrow } =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => wave1_gate1_b1_find_transform_in_module(root: e.target)
        }
      })
    TypeNode { connective: Conj } =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => wave1_gate1_b1_find_transform_in_module(root: e.target)
        }
      })
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => wave1_gate1_b1_find_transform_in_module(root: e.target)
        }
      })
  }
}

fn wave1_gate1_b1_caller_body_has_transform(source: String) -> Bool {
  match wave1_gate1_b1_normalized_module(source: source) {
    Absent => false
    Present { value: root } =>
      match wave1_gate1_b1_find_transform_in_module(root: root) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

fn wave1_gate1_b1_normalize_source(source: String) -> Bool {
  let lm = dag_language_model()
  match tokenize(text: source, file: ^wave1_gate1_b1_probe_file, rules: lm.lex) {
    Rejected { diagnostics: _ } => false
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => false
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: _ } => false
            Accepted { value: _, diagnostics: _ } => true
          }
      }
  }
}

fn wave1_gate1_b1_bare_call_normalizes_holds() -> Bool {
  wave1_gate1_b1_normalize_source(source: wave1_gate1_b1_bare_call_module_source)
}

fn wave1_gate1_b1_bare_call_lowers_to_transform_holds() -> Bool {
  wave1_gate1_b1_caller_body_has_transform(source: wave1_gate1_b1_bare_call_module_source)
}

fn wave1_gate1_b1_bare_call_resolves_end_to_end_holds() -> Bool {
  wave1_gate1_b1_resolve_source(source: wave1_gate1_b1_bare_call_module_source)
}

fn wave1_gate1_b1_builtin_call_resolves_end_to_end_holds() -> Bool {
  wave1_gate1_b1_resolve_source(source: wave1_gate1_b1_builtin_call_module_source)
}

fn wave1_gate1_b1_unbound_call_resolve_rejects_holds() -> Bool {
  match wave1_gate1_b1_resolve_source(source: wave1_gate1_b1_unbound_call_module_source) {
    true => false
    false => true
  }
}
