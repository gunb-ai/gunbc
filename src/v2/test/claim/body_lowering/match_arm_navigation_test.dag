module v2.test.claim.body_lowering.match_arm_navigation

import v2.compiler.body_lowering_fold {
  body_lowering_match_field_name_spine_does_not_sniff_holds
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Single-arm match navigation and a field literally named `match` both terminated at
// body_lowering_reason_match_arm_navigation_refused. The arm-list reader treated the empty
// comma-list Repeat tail as a missing arm (count, not shape). The field-access reader treated
// kw_match as a match-expression head whenever it was the left of an identity-absent sequence,
// including after a dot. Zero-arm match remains the retained red.

fn normalize_outcome(src: String) -> String {
  let lm = dag_language_model()
  match tokenize(text: src, file: ^match_arm_navigation_subject, rules: lm.lex) {
    Rejected { diagnostics: _ } => "TOKENIZE_REFUSED"
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: _ } => "PARSE_REFUSED"
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: ds } => symbol_lexeme(sym: ds.head.reason)
            Accepted { value: _, diagnostics: _ } => "ACCEPTED"
          }
      }
  }
}

data src_single_arm_wildcard: String = "module m.t\ntype T = A | B\nfn f(t: T) -> Int {\n  match t {\n    _ => 1\n  }\n}\n"

data src_two_arm_accepts: String = "module m.t\ntype T = A | B\nfn f(t: T) -> Int {\n  match t {\n    A => 1\n    _ => 2\n  }\n}\n"

data src_three_arm_accepts: String = "module m.t\ntype T = A | B | C\nfn f(t: T) -> Int {\n  match t {\n    A => 1\n    B => 2\n    _ => 3\n  }\n}\n"

data src_one_arm_constructor: String = "module m.t\ntype T = B { x: Int } | C\nfn f(t: T) -> Int {\n  match t {\n    B { x: v } => v\n  }\n}\n"

data src_one_arm_shorthand_field: String = "module m.t\ntype T = B { x: Int } | C\nfn f(t: T) -> Int {\n  match t {\n    B { x } => x\n  }\n}\n"

data src_zero_arm_refuses: String = "module m.t\ntype T = A | B\nfn f(t: T) -> Int {\n  match t {\n  }\n}\n"

data src_field_named_match: String = "module m.t\ntype R {\n  match: Int\n  other: Int\n}\nfn f(r: R) -> Int {\n  r.match\n}\n"

data src_field_renamed_other: String = "module m.t\ntype R {\n  other: Int\n}\nfn f(r: R) -> Int {\n  r.other\n}\n"

data src_field_named_loop: String = "module m.t\ntype R {\n  loop: Int\n}\nfn f(r: R) -> Int {\n  r.loop\n}\n"

data src_field_named_type: String = "module m.t\ntype R {\n  type: Int\n}\nfn f(r: R) -> Int {\n  r.type\n}\n"

data src_infix_field_named_match: String = "module m.t\ntype R {\n  match: Int\n}\nfn f(a: R, b: R) -> Bool {\n  a.match == b.match\n}\n"

data src_data_lambda_field: String = "module m.t\ntype A {\n  meet: fn(Int, Int) -> Int\n}\ndata d: A = A {\n  meet: (a, b) => a\n}\nfn f() -> Int {\n  1\n}\n"

data src_data_fn_literal_field: String = "module m.t\ntype A {\n  meet: fn(Int, Int) -> Int\n}\ndata d: A = A {\n  meet: fn(a, b) { a }\n}\nfn f() -> Int {\n  1\n}\n"

data src_lambda_in_fn_body: String = "module m.t\ntype A {\n  meet: fn(Int, Int) -> Int\n}\nfn f() -> A {\n  A {\n    meet: (a, b) => a\n  }\n}\n"

test fn single_arm_wildcard_match_normalizes_holds() -> Bool {
  normalize_outcome(src: src_single_arm_wildcard) == "ACCEPTED"
}

test fn two_arm_match_still_accepts_holds() -> Bool {
  normalize_outcome(src: src_two_arm_accepts) == "ACCEPTED"
}

test fn three_arm_match_is_not_parity_holds() -> Bool {
  normalize_outcome(src: src_three_arm_accepts) == "ACCEPTED"
}

test fn one_arm_constructor_pattern_normalizes_holds() -> Bool {
  normalize_outcome(src: src_one_arm_constructor) == "ACCEPTED"
}

test fn one_arm_shorthand_field_pattern_normalizes_holds() -> Bool {
  normalize_outcome(src: src_one_arm_shorthand_field) == "ACCEPTED"
}

test fn zero_arm_match_still_refuses_holds() -> Bool {
  normalize_outcome(src: src_zero_arm_refuses)
    == "body_lowering_reason_match_arm_navigation_refused"
}

test fn field_named_match_normalizes_holds() -> Bool {
  normalize_outcome(src: src_field_named_match) == "ACCEPTED"
}

test fn field_renamed_other_control_holds() -> Bool {
  normalize_outcome(src: src_field_renamed_other) == "ACCEPTED"
}

test fn field_named_loop_control_holds() -> Bool {
  normalize_outcome(src: src_field_named_loop) == "ACCEPTED"
}

test fn field_named_type_control_holds() -> Bool {
  normalize_outcome(src: src_field_named_type) == "ACCEPTED"
}

test fn infix_field_named_match_normalizes_holds() -> Bool {
  normalize_outcome(src: src_infix_field_named_match) == "ACCEPTED"
}

test fn match_keyword_after_dot_is_not_a_match_expr_sniff_holds() -> Bool {
  body_lowering_match_field_name_spine_does_not_sniff_holds()
}

test fn data_record_arrow_lambda_field_is_not_retained_holds() -> Bool {
  normalize_outcome(src: src_data_lambda_field) == "ACCEPTED"
}

test fn data_record_fn_literal_field_is_not_retained_holds() -> Bool {
  normalize_outcome(src: src_data_fn_literal_field) == "ACCEPTED"
}

test fn lambda_in_fn_body_control_holds() -> Bool {
  normalize_outcome(src: src_lambda_in_fn_body) == "ACCEPTED"
}
