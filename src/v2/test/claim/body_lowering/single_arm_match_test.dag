module v2.test.claim.body_lowering.single_arm_match

import v2.compiler.body_lowering_fold {
  body_lower_match_arm_repeat_elem_is_separator,
  body_lower_collect_match_arms_from_repeat_tail,
  body_lower_wire_match_arm_capture
}
import std.algebra { Empty }
import v2.std.algebra { length }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Conj, Node, TypeNode, node_synthetic }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Cause D: a match with exactly one arm was refused because the empty comma-list Repeat
// tail was navigated as a missing arm. These claims exercise the skip-before-extract
// classifier and the retained extract-refusal red on a synthetic empty Conj (the same shape the
// Repeat tail is). Full-module tokenize/parse/normalize of a source string is above the floor's
// 500ms changed-witness CPU ceiling; the closure receipt is the population green for one-arm
// sources.

fn empty_conj_node() -> Node {
  node_synthetic(kind: TypeNode { connective: Conj }, children: Empty)
}

test fn empty_repeat_elem_is_separator_holds() -> Bool {
  body_lower_match_arm_repeat_elem_is_separator(node: empty_conj_node())
}

test fn empty_repeat_tail_collects_no_arm_holds() -> Bool {
  match body_lower_collect_match_arms_from_repeat_tail(repeat_capture: empty_conj_node()) {
    Accepted { value: arms, diagnostics: _ } => length(xs: arms) == 0
    Rejected { diagnostics: _ } => false
  }
}

test fn zero_arm_unnavigable_capture_still_refuses_holds() -> Bool {
  match body_lower_wire_match_arm_capture(arm_capture: empty_conj_node()) {
    Rejected { diagnostics: d } =>
      d.head.reason == ^body_lowering_reason_match_arm_navigation_refused
    Accepted { value: _, diagnostics: _ } => false
  }
}
