module v2.test.claim.body_lowering.single_arm_match

import v2.compiler.reference_conservation_admission {
  ExplainedDrop,
  MatchLaterArm
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.test.claim.body_lowering.normalize_outcome_helpers {
  body_lowering_normalize_outcome,
  body_lowering_normalize_outcome_explained
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Cause D: a match with exactly one arm was refused because the empty comma-list Repeat
// tail was navigated as a missing arm. Two-or-more arms already accepted. Zero-arm match
// remains the retained red.
//
// `match t { }` does not reach that red: the brace is taken as a record on the ident
// scrutinee, so parse refuses before body-lowering. `match (t) { }` is the empty arm
// list.

fn normalize_outcome(src: String) -> String {
  body_lowering_normalize_outcome(src: src, file: ^single_arm_match_subject)
}

data src_single_arm_wildcard: String = "module m.t\ntype T = A | B\nfn f(t: T) -> Int {\n  match t {\n    _ => 1\n  }\n}\n"

data src_two_arm_accepts: String = "module m.t\ntype T = A | B\nfn f(t: T) -> Int {\n  match t {\n    A => 1\n    _ => 2\n  }\n}\n"

data src_three_arm_accepts: String = "module m.t\ntype T = A | B | C\nfn f(t: T) -> Int {\n  match t {\n    A => 1\n    B => 2\n    _ => 3\n  }\n}\n"

data src_one_arm_constructor: String = "module m.t\ntype T = B { x: Int } | C\nfn f(t: T) -> Int {\n  match t {\n    B { x: v } => v\n  }\n}\n"

data src_one_arm_shorthand_field: String = "module m.t\ntype T = B { x: Int } | C\nfn f(t: T) -> Int {\n  match t {\n    B { x } => x\n  }\n}\n"

data src_zero_arm_refuses: String = "module m.t\ntype T = A | B\nfn f(t: T) -> Int {\n  match (t) {\n  }\n}\n"

test fn single_arm_wildcard_match_normalizes_holds() -> Bool {
  normalize_outcome(src: src_single_arm_wildcard) == "ACCEPTED"
}

test fn two_arm_match_still_accepts_holds() -> Bool {
  normalize_outcome(src: src_two_arm_accepts) == "ACCEPTED"
}

test fn three_arm_match_is_not_parity_holds() -> Bool {
  body_lowering_normalize_outcome_explained(src: src_three_arm_accepts, file: ^single_arm_match_subject, explained: three_arm_lost_arm()) == "ACCEPTED"
}

test fn one_arm_constructor_pattern_normalizes_holds() -> Bool {
  normalize_outcome(src: src_one_arm_constructor) == "ACCEPTED"
}

test fn one_arm_shorthand_field_pattern_normalizes_holds() -> Bool {
  normalize_outcome(src: src_one_arm_shorthand_field) == "ACCEPTED"
}

test fn zero_arm_match_still_refuses_holds() -> Bool {
  normalize_outcome(src: src_zero_arm_refuses)
    == "body_lowering_reason_match_arm_navigation_refused"
}

// The third arm (`_ => 3`) is lost by lowering today, pattern and body both, pinned by
// v2.test.claim.namespace_xl0.reference_conservation the_third_match_arm_is_reported_dropped_holds.
fn three_arm_lost_arm() -> FreeMonoid<ExplainedDrop> {
  Cons {
    head: ExplainedDrop { identity: symbol_intern_lexeme(lexeme: "_"), shape: MatchLaterArm },
    tail: Cons { head: ExplainedDrop { identity: ^dag_token_int_literal, shape: MatchLaterArm }, tail: Empty }
  }
}
