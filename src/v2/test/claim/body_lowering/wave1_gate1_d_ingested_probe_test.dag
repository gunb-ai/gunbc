module v2.test.claim.body_lowering.wave1_gate1_d_ingested_probe

import v2.test.claim.body_lowering.wave1_gate1_d_ingested_fixture_helpers { wave1_gate1_d_arrow_accepts }
import v2.compiler.ingested_fixture_arrows {
  ingested_add_arrow_with_body,
  ingested_bind_arrow_with_body,
  ingested_loop_arrow_with_body,
  ingested_loop_module_source,
  ingested_pick_if_arrow_with_body,
  ingested_match_arrow_with_body
}
import v2.compiler.resolve { resolve }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.collection { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.node_query { find_arrow_body_child }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

test fn ingested_loop_normalized_has_body_edge_probe() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: ingested_loop_module_source, file: ^ingested_probe_file, rules: lm.lex) {
    Accepted { value: tokens, diagnostics: _ } =>
      match parse_module(tokens: tokens, grammar: lm.grammar) {
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Accepted { value: normalized, diagnostics: _ } =>
              match ingested_probe_first_arrow_optional(root: normalized) {
                Present { value: arrow } =>
                  match find_arrow_body_child(root: arrow) {
                    Accepted { value: body, diagnostics: _ } =>
                      match body.kind {
                        ComputationNode { behavior: _ } => true
                        _ => false
                      }
                    Rejected { diagnostics: _ } => false
                  }
                Absent => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingested_loop_resolve_holds() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: ingested_loop_module_source, file: ^ingested_probe_file, rules: lm.lex) {
    Accepted { value: tokens, diagnostics: _ } =>
      match parse_module(tokens: tokens, grammar: lm.grammar) {
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Accepted { value: normalized, diagnostics: _ } =>
              match resolve(tree: normalized, lm: lm) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingested_loop_normalize_holds() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: ingested_loop_module_source, file: ^ingested_probe_file, rules: lm.lex) {
    Accepted { value: tokens, diagnostics: _ } =>
      match parse_module(tokens: tokens, grammar: lm.grammar) {
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn ingested_probe_find_arrow(root: Node) -> Bool {
  match root.kind {
    TypeNode { connective: Arrow } => true
    _ =>
      fold(root.children, init: false, f: fn(acc, e) {
        if acc {
          true
        } else {
          ingested_probe_find_arrow(root: e.target)
        }
      })
  }
}

test fn ingested_loop_normalized_has_arrow_probe() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: ingested_loop_module_source, file: ^ingested_probe_file, rules: lm.lex) {
    Accepted { value: tokens, diagnostics: _ } =>
      match parse_module(tokens: tokens, grammar: lm.grammar) {
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Accepted { value: normalized, diagnostics: _ } =>
              ingested_probe_find_arrow(root: normalized)
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingested_loop_normalized_arrow_well_formed_probe() -> Bool {
  let lm = dag_language_model()
  match tokenize(text: ingested_loop_module_source, file: ^ingested_probe_file, rules: lm.lex) {
    Accepted { value: tokens, diagnostics: _ } =>
      match parse_module(tokens: tokens, grammar: lm.grammar) {
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Accepted { value: normalized, diagnostics: _ } =>
              match ingested_probe_first_arrow_optional(root: normalized) {
                Present { value: arrow } => well_formed(n: arrow)
                Absent => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn ingested_probe_first_arrow_optional(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => optional_present(value: root)
    _ =>
      fold(root.children, init: optional_absent(), f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => ingested_probe_first_arrow_optional(root: e.target)
        }
      })
  }
}

test fn ingested_loop_outcome_accepted_probe() -> Bool {
  match ingested_loop_arrow_with_body() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn ingested_loop_has_arrow_body_edge_probe() -> Bool {
  match ingested_loop_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match find_arrow_body_child(root: arrow) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn ingested_add_probe_holds() -> Bool {
  wave1_gate1_d_arrow_accepts(o: ingested_add_arrow_with_body())
}

test fn ingested_pick_probe_holds() -> Bool {
  wave1_gate1_d_arrow_accepts(o: ingested_pick_if_arrow_with_body())
}

test fn ingested_loop_probe_holds() -> Bool {
  wave1_gate1_d_arrow_accepts(o: ingested_loop_arrow_with_body())
}

test fn ingested_bind_probe_holds() -> Bool {
  wave1_gate1_d_arrow_accepts(o: ingested_bind_arrow_with_body())
}

test fn ingested_match_probe_holds() -> Bool {
  wave1_gate1_d_arrow_accepts(o: ingested_match_arrow_with_body())
}
