module v2.test.fact_density.lens_unit.anchor

import v2.lens.fact_density {
  carrier_spec_fact,
  NoFact,
  SourceSpecReadFact
}
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node {
  Node,
  TypeNode,
  Atom,
  SyntheticOccurrence
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fact_density_anchor_hollow_alias: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^fact_density_anchor_int32_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

test fn fact_density_hollow_alias_is_no_fact() -> Bool {
  carrier_spec_fact(carrier: fact_density_anchor_hollow_alias) == NoFact
}
