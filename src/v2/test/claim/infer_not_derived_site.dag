module v2.test.claim.infer_not_derived_site

import v2.compiler.source_root_eval {
  native_infer_accepted_frontier,
  native_infer_not_derived_site_counts,
  NativeInferSiteCount,
  native_test_context_from_ingest,
  native_test_infer_resolved,
  native_test_resolve_module,
  NativeTestPreparedModule
}
import v2.compiler.inferred_tree { DeclarationWrapperEvidenceEdgesAbsent, DerivedGrounding, GroundingNotDerived, NotDerivedSite }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, None, Rejected }
import v2.std.node { node_subtree_nodes, Symbol }
import v2.std.qualified_name { QualifiedName }
import std.algebra { fold_list, contains, length, Cons }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.types { Bool, Int, List, String }
import extdeps.communication.medium { Lossless, Medium }

// WHICH SITE LEFT EACH NODE ON THE GROUNDING FRONTIER. The advisory is one reason; the site on the
// GroundingNotDerived fact is the cause identity (v2.compiler.inferred_tree NotDerivedSite). Each
// fixture below is source text taken through the real ingest -> resolve -> infer route, and the claim
// reads the sites the produced facts carry. Inputs are supplied at infer's interface.

fn nds_read(source: String, id: Symbol, file: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: file },
    compilation_unit: ^nds_cu,
    source_root: DagTree
  }
}

fn nds_prepared(read: DagSourceReadWitness, module: QualifiedName) -> Optional<NativeTestPreparedModule> {
  match native_test_context_from_ingest(ingest: [read]) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: context, diagnostics: _ } =>
      match native_test_resolve_module(context: context, module: module).resolved {
        Rejected { diagnostics: _ } => optional_absent()
        Accepted { value: resolved, diagnostics: _ } =>
          match native_test_infer_resolved(module: module, resolved: resolved) {
            Rejected { diagnostics: _ } => optional_absent()
            Accepted { value: prepared, diagnostics: _ } => optional_present(value: prepared)
          }
      }
  }
}

fn nds_sites(prepared: Optional<NativeTestPreparedModule>) -> List<NotDerivedSite> {
  match prepared {
    Absent => []
    Present { value: p } =>
      fold_list(
        xs: node_subtree_nodes(root: p.inferred.root),
        empty: [],
        cons: fn(acc, n) {
          match p.inferred.facts.lookup(n) {
            Absent => acc
            Present { value: facts } =>
              match facts.grounding {
                GroundingNotDerived { node: _, site: s } => Cons { head: s, tail: acc }
                DerivedGrounding { grounding: _ } => acc
              }
          }
        }
      )
  }
}

data nds_q1_source: String = "module v2.test.nds_q1\n\nfn f0() -> Int { 7 }\n\nfn g0() -> Int { f0() }\n"

fn nds_q1_sites() -> List<NotDerivedSite> {
  nds_sites(prepared: nds_prepared(
    read: nds_read(source: nds_q1_source, id: ^nds_q1_read, file: "src/v2/test/fixture/nds/q1.dag"),
    module: [^v2, ^test, ^nds_q1]
  ))
}

test fn nds_q1_has_DeclarationWrapperEvidenceEdgesAbsent() -> Bool { contains(xs: nds_q1_sites(), item: DeclarationWrapperEvidenceEdgesAbsent, eq: fn(a, b) { a == b }) }

test fn nds_q1_has_ProductEvidenceEdgesAbsent() -> Bool { contains(xs: nds_q1_sites(), item: ProductEvidenceEdgesAbsent, eq: fn(a, b) { a == b }) }

data nds_q2_source: String = "module v2.test.nds_q2\n\nfn f0(x: Int) -> Int { 7 }\n\nfn g0() -> Int { f0(2) }\n"

fn nds_q2_sites() -> List<NotDerivedSite> {
  nds_sites(prepared: nds_prepared(
    read: nds_read(source: nds_q2_source, id: ^nds_q2_read, file: "src/v2/test/fixture/nds/q2.dag"),
    module: [^v2, ^test, ^nds_q2]
  ))
}

test fn nds_q2_has_DeclarationWrapperEvidenceEdgesAbsent() -> Bool { contains(xs: nds_q2_sites(), item: DeclarationWrapperEvidenceEdgesAbsent, eq: fn(a, b) { a == b }) }

test fn nds_q2_has_ProductEvidenceEdgesAbsent() -> Bool { contains(xs: nds_q2_sites(), item: ProductEvidenceEdgesAbsent, eq: fn(a, b) { a == b }) }

data nds_q0_source: String = "module v2.test.nds_q0\n\nfn k() -> Int { 7 }\n"

fn nds_q0_sites() -> List<NotDerivedSite> {
  nds_sites(prepared: nds_prepared(
    read: nds_read(source: nds_q0_source, id: ^nds_q0_read, file: "src/v2/test/fixture/nds/q0.dag"),
    module: [^v2, ^test, ^nds_q0]
  ))
}

test fn nds_q0_has_DeclarationWrapperEvidenceEdgesAbsent() -> Bool { contains(xs: nds_q0_sites(), item: DeclarationWrapperEvidenceEdgesAbsent, eq: fn(a, b) { a == b }) }

test fn nds_q0_has_ProductEvidenceEdgesAbsent() -> Bool { contains(xs: nds_q0_sites(), item: ProductEvidenceEdgesAbsent, eq: fn(a, b) { a == b }) }

// The frontier's total is read from the single walk's rows; the referent is this claim's own independent
// count of GroundingNotDerived facts. A module the fixture route cannot prepare reports false.
test fn nds_q1_frontier_total_matches_an_independent_count() -> Bool {
  match nds_prepared(
    read: nds_read(source: nds_q1_source, id: ^nds_q1_read, file: "src/v2/test/fixture/nds/q1.dag"),
    module: [^v2, ^test, ^nds_q1]
  ) {
    Absent => false
    Present { value: p } =>
      native_infer_accepted_frontier(tree: p.inferred, diagnostics: None).grounding_not_derived
        == length(xs: nds_sites(prepared: Present { value: p }))
  }
}

// The per-site rows are the census of the same facts nds_sites lists: for each site, the row's count is how
// often that site occurs. Rows are supplied so the control below can mutate one.
fn nds_occurrences(sites: List<NotDerivedSite>, site: NotDerivedSite) -> Int {
  fold_list(xs: sites, empty: 0, cons: fn(acc, s) { if s == site { acc + 1 } else { acc } })
}

fn nds_row_count(rows: List<NativeInferSiteCount>, site: NotDerivedSite) -> Int {
  fold_list(xs: rows, empty: 0, cons: fn(acc, r) { if r.site == site { r.count } else { acc } })
}

fn nds_row_matches(rows: List<NativeInferSiteCount>, sites: List<NotDerivedSite>, site: NotDerivedSite) -> Bool {
  nds_row_count(rows: rows, site: site) == nds_occurrences(sites: sites, site: site)
}

test fn nds_q1_wrapper_row_count_is_its_occurrence_count() -> Bool {
  match nds_prepared(
    read: nds_read(source: nds_q1_source, id: ^nds_q1_read, file: "src/v2/test/fixture/nds/q1.dag"),
    module: [^v2, ^test, ^nds_q1]
  ) {
    Absent => false
    Present { value: p } =>
      nds_occurrences(sites: nds_sites(prepared: Present { value: p }), site: DeclarationWrapperEvidenceEdgesAbsent) >= 1
        && nds_row_matches(
          rows: native_infer_not_derived_site_counts(tree: p.inferred),
          sites: nds_sites(prepared: Present { value: p }),
          site: DeclarationWrapperEvidenceEdgesAbsent
        )
  }
}

// RED control: a bumped count does not match.
test fn nds_a_mutated_row_count_is_refused() -> Bool {
  match nds_prepared(
    read: nds_read(source: nds_q1_source, id: ^nds_q1_read, file: "src/v2/test/fixture/nds/q1.dag"),
    module: [^v2, ^test, ^nds_q1]
  ) {
    Absent => false
    Present { value: p } =>
      nds_row_matches(
        rows: [NativeInferSiteCount {
          site: DeclarationWrapperEvidenceEdgesAbsent,
          count: nds_occurrences(sites: nds_sites(prepared: Present { value: p }), site: DeclarationWrapperEvidenceEdgesAbsent) + 1
        }],
        sites: nds_sites(prepared: Present { value: p }),
        site: DeclarationWrapperEvidenceEdgesAbsent
      ) == false
  }
}

// ===================== THE EQUALITY PATH'S ROW LOOKUP: A MISS IS A SITE =====================
//
// QUESTION ANSWERED: does any v2 equality path read a lookup miss as an admit?
// (gunbc.recurring_failure_mode lookup_miss_read_as_positive_classification, the equality instance.)
//
// THE ONE ARM THAT CAN. v2/compiler/infer.dag infer_operation_value_type's EqualityComparison arm asks
// the operand type's carrier for its Equivalence row through infer_algebra_field_result_type. A row is
// carried -> the comparison's type is the field's DECLARED codomain, read from the structure. A row is
// NOT carried -> the arm does not refuse and does not answer Bool by assumption: it accepts the program
// and leaves the comparison node on the grounding frontier with site ComparisonNotDerived --
// "unmodelled, not incomparable", the same counted mechanism that keeps `Bool == Bool` legal while the
// carrier is unmodelled. That is an ACCOUNTED miss, not a silent admit; but until this section the site
// appeared nowhere under src/v2/test, so nothing separated "the arm records the miss" from "the arm
// admits" -- the exact gap that lets the failure mode return with a green tree.
//
// THE PAIR VARIES ONLY THE ROW. Both fixtures are the same `a == b` over two operands of one declared
// type; the Int carrier carries its Equivalence row in v2.extdeps.languages.dag
// dag_algebra_inhabitance_decls, the Bool carrier does not. So the claims below cannot pass because of
// anything but the row's presence.
//
// WHAT EACH CLAIM PINS, and the red that shows it can fail:
//   * row carried, no site            -- red if the arm stops consulting the row (it would then mark
//                                        every comparison not-derived)
//   * row absent, site exactly once   -- red if the arm silently admits (no fact at all) or marks the
//                                        node twice
//   * the frontier TOTAL moves by one -- red if the miss admits without being counted, or if the
//                                        comparison drags unaccounted nodes in beside it
//   * the site's census row           -- red if the per-site rows disagree with the facts on the tree
//   * no comparison, no site, delta 0  -- the cheap weaker control: the site belongs to this construct
//                                        and nothing else in the fixture shape
// The red run drives the row-carried fixture through the row-absent claim; see the PR's witness script.

data nds_eq_row_carried_source: String = "module v2.test.nds_eq_row_carried\n\nfn k(a: Int, b: Int) -> Bool {\n  a == b\n}\n"

data nds_eq_row_absent_source: String = "module v2.test.nds_eq_row_absent\n\nfn k(a: Bool, b: Bool) -> Bool {\n  a == b\n}\n"

data nds_eq_no_comparison_source: String = "module v2.test.nds_eq_no_comparison\n\nfn k(a: Bool, b: Bool) -> Bool {\n  true\n}\n"

fn nds_eq_prepared(source: String, id: Symbol, module: Symbol, file: String) -> Optional<NativeTestPreparedModule> {
  nds_prepared(read: nds_read(source: source, id: id, file: file), module: [^v2, ^test, module])
}

fn nds_eq_row_carried_prepared() -> Optional<NativeTestPreparedModule> {
  nds_eq_prepared(source: nds_eq_row_carried_source, id: ^nds_eq_row_carried_read, module: ^nds_eq_row_carried,
    file: "src/v2/test/fixture/nds/eq_row_carried.dag")
}

fn nds_eq_row_absent_prepared() -> Optional<NativeTestPreparedModule> {
  nds_eq_prepared(source: nds_eq_row_absent_source, id: ^nds_eq_row_absent_read, module: ^nds_eq_row_absent,
    file: "src/v2/test/fixture/nds/eq_row_absent.dag")
}

fn nds_eq_no_comparison_prepared() -> Optional<NativeTestPreparedModule> {
  nds_eq_prepared(source: nds_eq_no_comparison_source, id: ^nds_eq_no_comparison_read, module: ^nds_eq_no_comparison,
    file: "src/v2/test/fixture/nds/eq_no_comparison.dag")
}

fn nds_eq_comparison_sites(prepared: Optional<NativeTestPreparedModule>) -> Int {
  nds_occurrences(sites: nds_sites(prepared: prepared), site: ComparisonNotDerived)
}

// ACCEPTED AND DERIVED: the comparison whose carrier CARRIES the Equivalence row is accepted (the
// `Absent => false` is what keeps a refused fixture from reading as no-site) and leaves no node with
// the comparison site.
test fn nds_eq_row_carried_comparison_is_accepted_without_the_comparison_site() -> Bool {
  match nds_eq_row_carried_prepared() {
    Absent => false
    Present { value: p } => nds_eq_comparison_sites(prepared: Present { value: p }) == 0
  }
}

// ACCEPTED AND ACCOUNTED: the comparison whose carrier has NO row is accepted and carries the site
// exactly once. The count, not `contains`, is what separates "recorded" from "admitted twice".
test fn nds_eq_row_absent_comparison_carries_the_comparison_site_exactly_once() -> Bool {
  match nds_eq_row_absent_prepared() {
    Absent => false
    Present { value: p } => nds_eq_comparison_sites(prepared: Present { value: p }) == 1
  }
}

fn nds_eq_frontier_grounding_total(prepared: Optional<NativeTestPreparedModule>) -> Int {
  match prepared {
    Absent => -1
    Present { value: p } => native_infer_accepted_frontier(tree: p.inferred, diagnostics: None).grounding_not_derived
  }
}

// THE FRONTIER TOTAL MOVES BY EXACTLY ONE. Both fixtures declare the same `fn k(a: T, b: T) -> Bool`
// shape and differ only in the type and in the body's expression, so the comparison is the only thing
// that can move the total -- and it moves it by the one node it leaves behind. A miss read as an admit
// moves the total by zero; an unaccounted node beside it moves it by two. Both are refused here.
test fn nds_eq_row_absent_comparison_moves_the_frontier_total_by_exactly_one() -> Bool {
  match nds_eq_row_absent_prepared() {
    Absent => false
    Present { value: absent_row } =>
      match nds_eq_no_comparison_prepared() {
        Absent => false
        Present { value: no_comparison } =>
          nds_eq_frontier_grounding_total(prepared: Present { value: absent_row })
            - nds_eq_frontier_grounding_total(prepared: Present { value: no_comparison }) == 1
      }
  }
}

// The same delta read on the row-carried fixture: a derived comparison adds nothing to the frontier.
test fn nds_eq_row_carried_comparison_leaves_the_frontier_total_where_the_no_comparison_fixture_has_it() -> Bool {
  match nds_eq_row_carried_prepared() {
    Absent => false
    Present { value: row_carried } =>
      match nds_eq_no_comparison_prepared() {
        Absent => false
        Present { value: no_comparison } =>
          nds_eq_frontier_grounding_total(prepared: Present { value: row_carried })
            == nds_eq_frontier_grounding_total(prepared: Present { value: no_comparison })
      }
  }
}

// THE WEAKER CONTROL, KEPT BECAUSE IT IS CHEAP: the site belongs to the comparison construct, not to
// the fixture shape. Same module, same signature, no `==`.
test fn nds_eq_no_comparison_fixture_carries_no_comparison_site() -> Bool {
  match nds_eq_no_comparison_prepared() {
    Absent => false
    Present { value: p } => nds_eq_comparison_sites(prepared: Present { value: p }) == 0
  }
}

// THE CENSUS AGREES WITH THE TREE: the per-site row for ComparisonNotDerived counts exactly the facts
// nds_eq_comparison_sites counted, on the fixture that has one.
test fn nds_eq_row_absent_comparison_row_count_is_its_occurrence_count() -> Bool {
  match nds_eq_row_absent_prepared() {
    Absent => false
    Present { value: p } =>
      nds_eq_comparison_sites(prepared: Present { value: p }) == 1
        && nds_row_matches(
          rows: native_infer_not_derived_site_counts(tree: p.inferred),
          sites: nds_sites(prepared: Present { value: p }),
          site: ComparisonNotDerived
        )
  }
}
