module v2.test.claim.namespace_graft.collapsed_reader_test

import std.algebra { Cons, Empty }
import v2.extdeps.languages.dag {
  dag_grammar_atom,
  dag_named_edge,
  qualified_name_from_graft_spine,
  qualified_name_from_module_node
}
import v2.std.algebra { fold_list_node }
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.compiler.namespace_graft { module_header_containment_graft }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, SyntheticOccurrence, TypeNode }
import v2.std.qualified_name {
  QualifiedName,
  qualified_name_from_dotted_string
}
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data collapsed_reader_witness_note: String = "Additive-equivalence witness for the QN-reader collapse (namespace-resolution-design.md section 10 dissolve 1): the SINGLE collapsed reader qualified_name_from_module_node must agree with the graft-spine walk on grafted input (discriminates against an unwired collapse — the pre-graft header arms cannot read a grafted tree, so an unwired reader Rejects here) AND with the header-path read on pre-graft input (discriminates against an always-spine mis-wiring — the spine walk rejects a header-bearing tree). The RED control: a bare Conj that is neither grafted nor header-bearing refuses — graft-awareness must not widen acceptance to arbitrary trees."

fn cr_sym_node(sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn cr_qn_spine(segments: FreeMonoid<Symbol>) -> Node {
  fold_list_node(
    xs: segments,
    item_node: fn(sym) { cr_sym_node(sym: sym) }
  )
}

fn cr_export_edge(name: Symbol) -> Edge {
  Edge {
    label: Named { name: name },
    target: cr_sym_node(sym: name)
  }
}

fn cr_pre_graft_module_root(
  qn: QualifiedName,
  body_edges: List<Edge>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: concat(
      [
        dag_named_edge(
          name: ^dag_surface_module_header,
          target: dag_grammar_atom(id: ^dag_surface_module_header)
        ),
        dag_named_edge(
          name: ^dag_surface_module_header_qualified_name,
          target: cr_qn_spine(segments: qn)
        )
      ],
      body_edges
    ),
    occurrence_id: SyntheticOccurrence
  }
}

data cr_module_qn: QualifiedName = qualified_name_from_dotted_string(dotted: "v2.test.namespace_graft.collapsed")

data cr_pre_graft_root: Node = cr_pre_graft_module_root(
  qn: cr_module_qn,
  body_edges: [cr_export_edge(name: ^CrPilotType)]
)

data cr_grafted_root: Node = match module_header_containment_graft(root: cr_pre_graft_root) {
  Accepted { value: grafted, diagnostics: _ } => grafted
  Rejected { diagnostics: _ } => cr_pre_graft_root
}

data cr_bare_conj_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn cr_outcome_accepted_qn(out: Outcome<QualifiedName>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn cr_qn_eq(out: Outcome<QualifiedName>, expected: QualifiedName) -> Bool {
  match out {
    Rejected { diagnostics: _ } => false
    Accepted { value: actual, diagnostics: _ } => actual == expected
  }
}

fn cr_outcomes_agree(lhs: Outcome<QualifiedName>, rhs: Outcome<QualifiedName>) -> Bool {
  match lhs {
    Rejected { diagnostics: _ } => false
    Accepted { value: lhs_qn, diagnostics: _ } =>
      match rhs {
        Rejected { diagnostics: _ } => false
        Accepted { value: rhs_qn, diagnostics: _ } => lhs_qn == rhs_qn
      }
  }
}

test fn collapsed_reader_grafted_spine_agreement_holds() -> Bool {
  cr_outcomes_agree(
    lhs: qualified_name_from_module_node(root: cr_grafted_root),
    rhs: qualified_name_from_graft_spine(root: cr_grafted_root)
  )
}

test fn collapsed_reader_grafted_expected_qn_holds() -> Bool {
  cr_qn_eq(
    out: qualified_name_from_module_node(root: cr_grafted_root),
    expected: cr_module_qn
  )
}

test fn collapsed_reader_pre_graft_header_agreement_holds() -> Bool {
  cr_qn_eq(
    out: qualified_name_from_module_node(root: cr_pre_graft_root),
    expected: cr_module_qn
  )
}

data claim_collapsed_reader_bare_conj_refused: TestClaim = EqualsClaim {
  label: "collapsed QN reader RED: bare Conj (neither grafted spine nor module header) refuses — graft-awareness widens acceptance to grafted trees only",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: cr_sym_node(sym: ^cr_bool_true),
  rhs: cr_sym_node(
    sym: if cr_outcome_accepted_qn(out: qualified_name_from_module_node(root: cr_bare_conj_root)) {
      ^cr_bool_false
    } else {
      ^cr_bool_true
    }
  ),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

test fn collapsed_reader_bare_conj_refused_holds() -> Bool {
  !cr_outcome_accepted_qn(out: qualified_name_from_module_node(root: cr_bare_conj_root))
}
