module v2.test.claim.namespace_graft.collapsed_reader_test


data collapsed_reader_witness_note: String = "Additive-equivalence witness for the QN-reader collapse (namespace-resolution-design.md section 10 dissolve 1): the SINGLE collapsed reader qualified_name_from_module_node must agree with the graft-spine walk on grafted input (discriminates against an unwired collapse — the pre-graft header arms cannot read a grafted tree, so an unwired reader Rejects here) AND with the header-path read on pre-graft input (discriminates against an always-spine mis-wiring — the spine walk rejects a header-bearing tree). The RED control: a bare Conj that is neither grafted nor header-bearing refuses — graft-awareness must not widen acceptance to arbitrary trees."

fn cr_sym_node(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn cr_qn_spine(segments: FreeMonoid<v2.std.node.Symbol>) -> v2.std.node.Node {
  fold_list_node(
    xs: segments,
    item_node: fn(sym) { cr_sym_node(sym: sym) }
  )
}

fn cr_export_edge(name: v2.std.node.Symbol) -> v2.std.node.Edge {
  v2.std.node.Edge {
    label: v2.std.node.Named { name: name },
    target: cr_sym_node(sym: name)
  }
}

fn cr_pre_graft_module_root(
  qn: v2.std.qualified_name.QualifiedName,
  body_edges: List<v2.std.node.Edge>
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: concat(
      [
        dag_named_edge(
          name: ^dag_surface_module_header,
          target: dag_grammar_atom(id: ^dag_surface_module_header)
        ),
        dag_named_edge(
          name: ^dag_surface_module_header_qualified_name,
          target: cr_qn_spine(segments: qn)
        )
      ],
      body_edges
    ),
    occurrence_id: SyntheticOccurrence
  }
}

data cr_module_qn: v2.std.qualified_name.QualifiedName = qualified_name_from_dotted_string(dotted: "v2.test.namespace_graft.collapsed")

data cr_pre_graft_root: v2.std.node.Node = cr_pre_graft_module_root(
  qn: cr_module_qn,
  body_edges: [cr_export_edge(name: ^CrPilotType)]
)

data cr_grafted_root: v2.std.node.Node = match module_header_containment_graft(root: cr_pre_graft_root) {
  Accepted { value: grafted, diagnostics: _ } => grafted
  Rejected { diagnostics: _ } => cr_pre_graft_root
}

data cr_bare_conj_root: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn cr_outcome_accepted_qn(out: v2.std.diagnostic.Outcome<v2.std.qualified_name.QualifiedName>) -> v2.std.logic.Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn cr_qn_eq(out: v2.std.diagnostic.Outcome<v2.std.qualified_name.QualifiedName>, expected: v2.std.qualified_name.QualifiedName) -> v2.std.logic.Bool {
  match out {
    Rejected { diagnostics: _ } => false
    Accepted { value: actual, diagnostics: _ } => actual == expected
  }
}

fn cr_outcomes_agree(lhs: v2.std.diagnostic.Outcome<v2.std.qualified_name.QualifiedName>, rhs: v2.std.diagnostic.Outcome<v2.std.qualified_name.QualifiedName>) -> v2.std.logic.Bool {
  match lhs {
    Rejected { diagnostics: _ } => false
    Accepted { value: lhs_qn, diagnostics: _ } =>
      match rhs {
        Rejected { diagnostics: _ } => false
        Accepted { value: rhs_qn, diagnostics: _ } => lhs_qn == rhs_qn
      }
  }
}

test fn collapsed_reader_grafted_spine_agreement_holds() -> v2.std.logic.Bool {
  cr_outcomes_agree(
    lhs: qualified_name_from_module_node(root: cr_grafted_root),
    rhs: qualified_name_from_graft_spine(root: cr_grafted_root)
  )
}

test fn collapsed_reader_grafted_expected_qn_holds() -> v2.std.logic.Bool {
  cr_qn_eq(
    out: qualified_name_from_module_node(root: cr_grafted_root),
    expected: cr_module_qn
  )
}

test fn collapsed_reader_pre_graft_header_agreement_holds() -> v2.std.logic.Bool {
  cr_qn_eq(
    out: qualified_name_from_module_node(root: cr_pre_graft_root),
    expected: cr_module_qn
  )
}

data claim_collapsed_reader_bare_conj_refused: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "collapsed QN reader RED: bare Conj (neither grafted spine nor module header) refuses — graft-awareness widens acceptance to grafted trees only",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: cr_sym_node(sym: ^cr_bool_true),
  rhs: cr_sym_node(
    sym: if cr_outcome_accepted_qn(out: qualified_name_from_module_node(root: cr_bare_conj_root)) {
      ^cr_bool_false
    } else {
      ^cr_bool_true
    }
  ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

test fn collapsed_reader_bare_conj_refused_holds() -> v2.std.logic.Bool {
  !cr_outcome_accepted_qn(out: qualified_name_from_module_node(root: cr_bare_conj_root))
}
