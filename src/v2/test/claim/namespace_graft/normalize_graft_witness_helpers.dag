module v2.test.claim.namespace_graft.normalize_graft_witness_helpers



data normalize_graft_witness_helpers_note: String = "§10 normalize-as-ingest execution helpers: tokenize→parse_module→normalize paths exceed per-PR 5s fast-lane eval budget (gunbc_ci_fast_lane_rule_note). Enrolled in long/namespace_graft_normalize_witness_test.dag."

data ng_norm_module_source: String = v2.compiler.ingested_fixture_arrows.ingested_add_module_source

fn ng_norm_parsed_root() -> Optional<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: ng_norm_module_source,
    file: ^ng_norm_probe_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
    v2.std.diagnostic.Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } => v2.std.optional.Present { value: artifact.tree }
      }
  }
}

fn ng_norm_normalized_root() -> Optional<v2.std.node.Node> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: ng_norm_module_source,
    file: ^ng_norm_probe_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
    v2.std.diagnostic.Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: artifact.tree) {
            v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
            v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } => v2.std.optional.Present { value: tree }
          }
      }
  }
}

fn ng_norm_grafted_tree_has_no_metadata_edges(node: v2.std.node.Node) -> Bool {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(node.children, init: true, f: fn(ok, edge) {
        if !ok {
          false
        } else {
          match edge.label {
            v2.std.node.Named { name: sym } =>
              if v2.compiler.namespace_graft.namespace_graft_is_metadata_edge(name: sym) {
                false
              } else {
                ng_norm_grafted_tree_has_no_metadata_edges(node: edge.target)
              }
            v2.std.node.Positional =>
              ng_norm_grafted_tree_has_no_metadata_edges(node: edge.target)
          }
        }
      })
    v2.std.node.ComputationNode { behavior: _ } => true
    _ => true
  }
}

fn ng_norm_manual_graft_on_parsed_module_holds() -> Bool {
  match ng_norm_parsed_root() {
    v2.std.optional.Present { value: parsed } =>
      match v2.compiler.namespace_graft.module_header_containment_graft(root: parsed) {
        v2.std.diagnostic.Accepted { value: grafted, diagnostics: _ } =>
          v2.compiler.namespace_graft.namespace_graft_is_module_shell(root: grafted)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.optional.Absent => false
  }
}

fn ng_norm_well_formed_after_manual_graft_holds() -> Bool {
  match ng_norm_parsed_root() {
    v2.std.optional.Present { value: parsed } =>
      match v2.compiler.namespace_graft.module_header_containment_graft(root: parsed) {
        v2.std.diagnostic.Accepted { value: grafted, diagnostics: _ } => v2.std.node.well_formed(n: grafted)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.optional.Absent => false
  }
}

fn ng_norm_normalize_accepts_holds() -> Bool {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  match v2.compiler.tokenize.tokenize(
    text: ng_norm_module_source,
    file: ^ng_norm_probe_file,
    rules: lm.lex
  ) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: ts, diagnostics: _ } =>
      match v2.compiler.parse.parse_module(tokens: ts, grammar: lm.grammar) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match v2.compiler.normalize.normalize(parse_tree: artifact.tree) {
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
      }
  }
}

fn ng_norm_manual_qn_on_parsed_holds() -> Bool {
  match ng_norm_parsed_root() {
    v2.std.optional.Present { value: parsed } =>
      match v2.compiler.namespace_graft.module_header_containment_graft(root: parsed) {
        v2.std.diagnostic.Accepted { value: grafted, diagnostics: _ } =>
          match v2.extdeps.languages.dag.qualified_name_from_graft_spine(root: grafted) {
            v2.std.diagnostic.Accepted { value: qn, diagnostics: _ } =>
              v2.std.qualified_name.qualified_name_to_dotted_string(qn: qn) == "m"
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.optional.Absent => false
  }
}

fn ng_norm_normalize_applies_on_parsed_module_holds() -> Bool {
  match ng_norm_normalized_root() {
    v2.std.optional.Present { value: root } => v2.compiler.namespace_graft.namespace_graft_is_module_shell(root: root)
    v2.std.optional.Absent => false
  }
}

fn ng_norm_graft_after_normalize_body_holds() -> Bool {
  match ng_norm_normalized_root() {
    v2.std.optional.Present { value: normalized } =>
      match v2.compiler.namespace_graft.module_header_containment_graft(root: normalized) {
        v2.std.diagnostic.Accepted { value: grafted, diagnostics: _ } =>
          match v2.extdeps.languages.dag.qualified_name_from_graft_spine(root: grafted) {
            v2.std.diagnostic.Accepted { value: qn, diagnostics: _ } =>
              v2.std.qualified_name.qualified_name_to_dotted_string(qn: qn) == "m"
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.optional.Absent => false
  }
}

fn ng_norm_normalize_qn_round_trip_holds() -> Bool {
  match ng_norm_normalized_root() {
    v2.std.optional.Present { value: root } =>
      match v2.extdeps.languages.dag.qualified_name_from_graft_spine(root: root) {
        v2.std.diagnostic.Accepted { value: qn, diagnostics: _ } =>
          v2.std.qualified_name.qualified_name_to_dotted_string(qn: qn) == "m"
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.optional.Absent => false
  }
}

fn ng_norm_normalize_output_has_zero_metadata_edges_holds() -> Bool {
  match ng_norm_normalized_root() {
    v2.std.optional.Present { value: root } => ng_norm_grafted_tree_has_no_metadata_edges(node: root)
    v2.std.optional.Absent => false
  }
}
