module v2.test.claim.namespace_graft.graft_shape_test


fn ng_sym_node(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn ng_qn_spine(segments: FreeMonoid<v2.std.node.Symbol>) -> v2.std.node.Node {
  fold_list_node(
    xs: segments,
    item_node: fn(sym) { ng_sym_node(sym: sym) }
  )
}

fn ng_pre_graft_module_root(
  qn: v2.std.qualified_name.QualifiedName,
  body_edges: List<v2.std.node.Edge>
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: concat(
      [
        dag_named_edge(
          name: ^dag_surface_module_header,
          target: dag_grammar_atom(id: ^dag_surface_module_header)
        ),
        dag_named_edge(
          name: ^dag_surface_module_header_qualified_name,
          target: ng_qn_spine(segments: qn)
        )
      ],
      body_edges
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn ng_export_edge(name: v2.std.node.Symbol) -> v2.std.node.Edge {
  v2.std.node.Edge {
    label: v2.std.node.Named { name: name },
    target: ng_sym_node(sym: name)
  }
}

data ng_module_qn: v2.std.qualified_name.QualifiedName = qualified_name_from_dotted_string(dotted: "v2.test.namespace_graft.alpha")

data ng_pre_graft_root: v2.std.node.Node = ng_pre_graft_module_root(
  qn: ng_module_qn,
  body_edges: [
    ng_export_edge(name: ^NgPilotType),
    ng_export_edge(name: ^NgPilotFn)
  ]
)

fn ng_outcome_accepted(out: v2.std.diagnostic.Outcome<v2.std.node.Node>) -> v2.std.logic.Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn ng_qn_eq(out: v2.std.diagnostic.Outcome<v2.std.qualified_name.QualifiedName>, expected: v2.std.qualified_name.QualifiedName) -> v2.std.logic.Bool {
  match out {
    Rejected { diagnostics: _ } => false
    Accepted { value: actual, diagnostics: _ } => actual == expected
  }
}

data ng_grafted_root: v2.std.node.Node = match module_header_containment_graft(root: ng_pre_graft_root) {
  Accepted { value: grafted, diagnostics: _ } => grafted
  Rejected { diagnostics: _ } => ng_pre_graft_root
}

test fn namespace_graft_shape_accepts_well_formed_module_holds() -> v2.std.logic.Bool {
  ng_outcome_accepted(out: module_header_containment_graft(root: ng_pre_graft_root))
}

test fn namespace_graft_shape_wraps_module_shell_holds() -> v2.std.logic.Bool {
  namespace_graft_is_module_shell(root: ng_grafted_root)
}

test fn namespace_graft_qn_round_trip_holds() -> v2.std.logic.Bool {
  ng_qn_eq(
    out: qualified_name_from_graft_spine(root: ng_grafted_root),
    expected: ng_module_qn
  )
}

test fn namespace_graft_output_has_zero_metadata_edges_holds() -> v2.std.logic.Bool {
  namespace_graft_grafted_tree_has_no_metadata_edges(node: ng_grafted_root)
}

test fn namespace_graft_body_edges_survive_holds() -> v2.std.logic.Bool {
  match module_header_containment_graft(root: ng_pre_graft_root) {
    Accepted { value: grafted, diagnostics: _ } =>
      match find_named_child(root: grafted, name: ^grammar_production_captured_node_projection) {
        Accepted { value: captured, diagnostics: _ } =>
          match qualified_name_from_graft_spine(root: grafted) {
            Accepted { value: module_qn, diagnostics: _ } => {
              let innermost = namespace_graft_walk_spine_to_body(captured: captured)
              match find_named_child(root: innermost, name: ^NgPilotType) {
                Accepted { value: _, diagnostics: _ } =>
                  match find_named_child(root: innermost, name: ^NgPilotFn) {
                    Accepted { value: _, diagnostics: _ } =>
                      qualified_name_to_dotted_string(qn: module_qn) == "v2.test.namespace_graft.alpha"
                    Rejected { diagnostics: _ } => false
                  }
                Rejected { diagnostics: _ } => false
              }
            }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn namespace_graft_walk_spine_to_body(captured: v2.std.node.Node) -> v2.std.node.Node {
  match captured.kind {
    TypeNode { connective: Conj } =>
      if count(captured.children) == 1 {
        match list_at_optional(xs: captured.children, index: 0) {
          Present { value: edge } =>
            match edge.label {
              Named { name: _ } => namespace_graft_walk_spine_to_body(captured: edge.target)
              Positional => captured
            }
          Absent => captured
        }
      } else {
        captured
      }
    _ => captured
  }
}

fn namespace_graft_grafted_tree_has_no_metadata_edges(node: v2.std.node.Node) -> v2.std.logic.Bool {
  match node.kind {
    TypeNode { connective: Conj } =>
      fold(
        node.children,
        init: true,
        f: fn(ok, edge) {
          if !ok {
            false
          } else {
            match edge.label {
              Named { name: sym } =>
                if namespace_graft_is_metadata_edge(name: sym) {
                  false
                } else {
                  namespace_graft_grafted_tree_has_no_metadata_edges(node: edge.target)
                }
              Positional =>
                namespace_graft_grafted_tree_has_no_metadata_edges(node: edge.target)
            }
          }
        }
      )
    ComputationNode { behavior: _ } => true
    _ => true
  }
}

data ng_empty_qn_node: v2.std.node.Node = emit_module_header_emitted_node(
  qualified_name: v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
)

data claim_namespace_graft_empty_qn_refused: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "namespace_graft RED: empty module header QN refuses graft",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ng_sym_node(sym: ^ng_bool_true),
  rhs: ng_sym_node(
    sym: if ng_outcome_accepted(out: module_header_containment_graft(root: ng_empty_qn_node)) {
      ^ng_bool_false
    } else {
      ^ng_bool_true
    }
  ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

test fn namespace_graft_empty_qn_refused_holds() -> v2.std.logic.Bool {
  !ng_outcome_accepted(out: module_header_containment_graft(root: ng_empty_qn_node))
}

data ng_dual_position_root: v2.std.node.Node = ng_pre_graft_module_root(
  qn: std.algebra.Cons {
    head: ^NgAlpha,
    tail: std.algebra.Cons { head: ^NgBeta, tail: std.algebra.Empty }
  },
  body_edges: [
    v2.std.node.Edge {
      label: v2.std.node.Named { name: ^NgAlpha },
      target: v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: Conj },
        children: [ng_export_edge(name: ^NgDualPilot)],
        occurrence_id: SyntheticOccurrence
      }
    }
  ]
)

data claim_namespace_graft_dual_position_refused: v2.std.verification.TestClaim = v2.std.verification.EqualsClaim {
  label: "namespace_graft RED: dual header+brace position refuses graft",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ng_sym_node(sym: ^ng_bool_true),
  rhs: ng_sym_node(
    sym: if ng_outcome_accepted(out: module_header_containment_graft(root: ng_dual_position_root)) {
      ^ng_bool_false
    } else {
      ^ng_bool_true
    }
  ),
  classification: v2.std.verification.TestClassification { tier: Tier1, layer: v2.std.verification.Unit }
}

test fn namespace_graft_dual_position_refused_holds() -> v2.std.logic.Bool {
  !ng_outcome_accepted(out: module_header_containment_graft(root: ng_dual_position_root))
}
