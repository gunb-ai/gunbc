module v2.test.medium_structure_containment.scanner.decode_fidelity_residue

import v2.lens.medium_structure_containment {
  medium_bash_scan_roots,
  medium_structure_ambiguous_count_live,
  medium_structure_violation_count_live
}
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data decode_fidelity_residue_note: String = "DecodeFidelity residue LEDGER (parent requirement 2026-07-14: the AmbiguousParse residue is COUNTED and REPORTED, never a silent gap — DESIGN.md §5 no absorbing fallback). The live substrate scan (medium_bash_scan_roots) has EXACTLY 2 AmbiguousParse cause HoleStraddlesToken rows, both in dag/extdeps/bmc/webui/nbd_proxy_serve.dag: the nbdkit background line (concat of tool-name Hole, -p Hole, iso_path Hole, trailing background &) and the websocat line (install-path Hole, auth-header Hole, wss-url Hole, socat-bridge Hole). Each carries an UNQUOTED compose-time Hole whose value could contain a separator, so the recognizer refuses to assume-Clean and refuses to assert-Violation. 0 Violations accompany them (violation_count_live == 0). DISSOLUTION TRIGGER (this count drops to 0 by GROUNDING, not by widening): quote each interpolated Hole (a double-quoted Hole is bounded — operators cannot apply inside quotes — and reclassifies Clean) OR give the sink a typed argv model so the Hole becomes a typed operand rather than raw text spliced pre-parse (reclassifies Clean/Violation structurally). Until then the honest disposition is Ambiguous; asserting == 2 keeps the ledger LIVE — a new unquoted-Hole RawLine.text reds this witness on execution, surfacing the added residue within one run rather than absorbing it."

test fn medium_structure_decode_fidelity_residue_is_two_holds() -> Bool {
  (medium_structure_ambiguous_count_live(roots: medium_bash_scan_roots) == 2)
    && (medium_structure_violation_count_live(roots: medium_bash_scan_roots) == 0)
}
