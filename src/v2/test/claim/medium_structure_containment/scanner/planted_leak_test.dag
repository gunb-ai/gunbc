// Scope: scanner-execution RED receipt — the live containment guard must flag the planted
//        fixture (src/v2/test/fixture/medium_structure_scan/leak/plant.dag). The discriminating
//        RED input that goes red when live detection breaks: scanning the fixture dir in
//        isolation MUST report EXACTLY two MediumStructureLeaks — ONE emit-side (the `${{`
//        literal) and ONE check-side (the string-op over the emit-fn receiver) — and NOT clean.
//        Exactly-two is the discriminator: the fixture's two clean controls (a marker-free
//        literal; a string-op over a plain non-emit receiver) must NOT be counted, proving
//        detection keys on the grounded marker / receiver provenance, not on flagging every
//        literal or every string-op. This is the by-execution oracle that the guard fires on a
//        real, committed, two-faced leak.

module v2.test.medium_structure_containment.scanner.planted_leak

import v2.lens.medium_structure_containment {
  medium_structure_leak_count_live,
  medium_structure_containment_clean_live
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data planted_leak_scan_roots: List<String> = [
  "src/v2/test/fixture/medium_structure_scan/leak"
]

test fn medium_structure_planted_leak_detected_holds() -> Bool {
  (medium_structure_leak_count_live(
    emit_roots: planted_leak_scan_roots,
    check_roots: planted_leak_scan_roots
  ) == 2)
    && (medium_structure_containment_clean_live(
      emit_roots: planted_leak_scan_roots,
      check_roots: planted_leak_scan_roots
    ) == false)
}
