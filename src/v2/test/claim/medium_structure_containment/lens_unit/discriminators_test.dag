module v2.test.medium_structure_containment.lens_unit.discriminators

import v2.lens.medium_structure_containment {
  RawLiteralPart,
  RawLiteralPartsFact,
  medium_structure_exception_roster,
  medium_structure_violation_count,
  medium_structure_violation_count_canonical,
  medium_structure_ambiguous_count
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data lens_unit_note: String = "Synthetic RED-on-5.2 / GREEN-on-5.3 controls over hand-built RawLiteralPartsFact rows (no live scan): they pin the classify + roster + gate logic. RED-on-5.2: a RawLine.text composition in a fresh non-rostered file counts a Violation; GREEN-on-5.3: an atom stays Clean (zero); a rostered composition is exempt (zero); the SAME composition de-rostered counts (discriminating that the roster, not the classifier, suppresses it); a Heredoc.body is counted Ambiguous, never Violation."

data empty_roster: List<String> = []

data fresh_composition_fact: List<RawLiteralPartsFact> = [
  RawLiteralPartsFact {
    path: "dag/gunbc/_perturb_fresh_consumer.dag",
    constructor: "RawLine",
    field: "text",
    parts: [RawLiteralPart { is_hole: false, text: "echo a; echo b" }]
  }
]

test fn fresh_composition_is_counted_violation_holds() -> Bool {
  medium_structure_violation_count_canonical(facts: fresh_composition_fact) == 1
}

data fresh_atom_fact: List<RawLiteralPartsFact> = [
  RawLiteralPartsFact {
    path: "dag/gunbc/_perturb_fresh_atom.dag",
    constructor: "RawLine",
    field: "text",
    parts: [RawLiteralPart { is_hole: false, text: "echo hi" }]
  }
]

test fn fresh_atom_is_clean_holds() -> Bool {
  medium_structure_violation_count_canonical(facts: fresh_atom_fact) == 0
}

data rostered_composition_fact: List<RawLiteralPartsFact> = [
  RawLiteralPartsFact {
    path: "dag/extdeps/os/ubuntu_install_media_fetch.dag",
    constructor: "RawLine",
    field: "text",
    parts: [RawLiteralPart { is_hole: false, text: "echo a; echo b" }]
  }
]

data custom_roster_with_specimen_path: List<String> = ["dag/extdeps/os/ubuntu_install_media_fetch.dag"]

test fn rostered_composition_is_not_counted_holds() -> Bool {
  medium_structure_violation_count(
    facts: rostered_composition_fact,
    roster: custom_roster_with_specimen_path
  ) == 0
}

test fn de_rostered_composition_is_counted_holds() -> Bool {
  medium_structure_violation_count(facts: rostered_composition_fact, roster: empty_roster) == 1
}

data heredoc_body_fact: List<RawLiteralPartsFact> = [
  RawLiteralPartsFact {
    path: "dag/gunbc/_perturb_fresh_heredoc.dag",
    constructor: "Heredoc",
    field: "body",
    parts: [RawLiteralPart { is_hole: false, text: "key: value\nother: x" }]
  }
]

test fn heredoc_body_is_not_violation_holds() -> Bool {
  medium_structure_violation_count_canonical(facts: heredoc_body_fact) == 0
}

test fn heredoc_body_is_counted_ambiguous_holds() -> Bool {
  medium_structure_ambiguous_count(
    facts: heredoc_body_fact,
    roster: medium_structure_exception_roster
  ) == 1
}
