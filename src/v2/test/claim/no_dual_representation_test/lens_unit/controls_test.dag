module v2.test.no_dual_representation_test.lens_unit.controls

import v2.std.algebra { length }
import v2.lens.no_dual_representation_test.scan {
  dual_rep_clean_holds_for_scans,
  dual_rep_violation_count_from_scans,
  dual_rep_violations_from_module,
  parse_path_helper_tautology_scan,
  synthetic_body_mirror_scan,
  synthetic_bool_literal_mirror_scan,
  synthetic_distinct_symbol_scan,
  synthetic_independent_oracle_scan,
  synthetic_literal_mirror_scan,
  synthetic_same_symbol_scan
}
import v2.std.logic { Bool }

test fn same_symbol_equality_is_red() -> Bool {
  dual_rep_violation_count_from_scans(scans: [synthetic_same_symbol_scan()]) == 1
}

test fn literal_mirror_is_red() -> Bool {
  dual_rep_violation_count_from_scans(scans: [synthetic_literal_mirror_scan()]) == 1
}

test fn bool_literal_mirror_is_red() -> Bool {
  dual_rep_violation_count_from_scans(scans: [synthetic_bool_literal_mirror_scan()]) == 1
}

test fn independent_oracle_is_green() -> Bool {
  dual_rep_clean_holds_for_scans(scans: [synthetic_independent_oracle_scan()])
}

test fn distinct_symbol_equality_is_green() -> Bool {
  dual_rep_clean_holds_for_scans(scans: [synthetic_distinct_symbol_scan()])
}

test fn body_mirror_is_red() -> Bool {
  length(xs: dual_rep_violations_from_module(scan: synthetic_body_mirror_scan())) == 1
}

test fn parse_path_helper_tautology_is_red() -> Bool {
  dual_rep_violation_count_from_scans(scans: [parse_path_helper_tautology_scan()]) == 1
}
