module v2.test.claim.lean_overflow_semantics_witness


import v2.extdeps.languages.lean {
  lean_admit_fixed_width_overflow_semantics,
  lean_catalog_fixed_width_overflow,
  lean_facts_int32,
  lean_overflow_raise_effect_tag,
  lean_overflow_semantics_arm_tag,
  LeanIntegerScalar,
  LeanOverflowAccepted,
  LeanOverflowPanics,
  LeanOverflowRaiseEffect,
  LeanOverflowRefused,
  LeanOverflowTraps
}
import std.integer {
  IntegerOverflowSemantics,
  OverflowRaises,
  OverflowReturns,
  OverflowUndefined,
  ReturnSaturating,
  ReturnWrapping
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data lean_overflow_semantics_witness_note: String = "P3b cluster-2 receipt (lean end-to-end): std.integer.IntegerOverflowSemantics<E> keeps return, raise, and undefined as separate arms; LeanOverflowPanics and LeanOverflowTraps are distinct E inhabitants. Honest rung: accepted refinement with executing refusal — not structural impossibility. RED: OverflowUndefined and OverflowRaises refuse at lean_admit_fixed_width_overflow_semantics; catalog int32 carries ReturnWrapping, not raises or undefined. Typed let initializers stay single-line per lean_overflow_parse_continuation_note."

test fn overflow_semantics_three_arms_distinguishable() -> Bool {
  let returns: IntegerOverflowSemantics<LeanOverflowRaiseEffect> = OverflowReturns { value_rule: ReturnWrapping }
  let raises: IntegerOverflowSemantics<LeanOverflowRaiseEffect> = OverflowRaises { effect: LeanOverflowPanics }
  let undefined: IntegerOverflowSemantics<LeanOverflowRaiseEffect> = OverflowUndefined
  lean_overflow_semantics_arm_tag(semantics: returns) == ^lean_overflow_arm_returns && lean_overflow_semantics_arm_tag(semantics: raises) == ^lean_overflow_arm_raises && lean_overflow_semantics_arm_tag(semantics: undefined) == ^lean_overflow_arm_undefined && lean_overflow_semantics_arm_tag(semantics: returns) != lean_overflow_semantics_arm_tag(semantics: raises) && lean_overflow_semantics_arm_tag(semantics: raises) != lean_overflow_semantics_arm_tag(semantics: undefined)
}

test fn lean_panic_and_trap_remain_distinct_effects() -> Bool {
  let panic_effect = LeanOverflowPanics
  let trap_effect = LeanOverflowTraps
  lean_overflow_raise_effect_tag(effect: panic_effect) == ^lean_overflow_effect_panics && lean_overflow_raise_effect_tag(effect: trap_effect) == ^lean_overflow_effect_traps && lean_overflow_raise_effect_tag(effect: panic_effect) != lean_overflow_raise_effect_tag(effect: trap_effect)
}

test fn lean_admit_accepts_catalog_wrapping_returns() -> Bool {
  match lean_admit_fixed_width_overflow_semantics(semantics: lean_catalog_fixed_width_overflow) {
    LeanOverflowAccepted { semantics: admitted } =>
      match admitted.semantics {
        OverflowReturns { value_rule: ReturnWrapping } => true
        OverflowReturns { value_rule: ReturnSaturating } => false
        OverflowRaises { effect: _ } => false
        OverflowUndefined => false
      }
    LeanOverflowRefused { observed: _, reason: _ } => false
  }
}

test fn lean_admit_refuses_undefined_for_fixed_width_catalog() -> Bool {
  let undefined: IntegerOverflowSemantics<LeanOverflowRaiseEffect> = OverflowUndefined
  match lean_admit_fixed_width_overflow_semantics(semantics: undefined) {
    LeanOverflowRefused { observed: _, reason: reason } =>
      reason == ^lean_overflow_refuse_undefined_not_fixed_width_catalog
    LeanOverflowAccepted { semantics: _ } => false
  }
}

test fn lean_admit_refuses_raises_panic_for_fixed_width_catalog() -> Bool {
  let raises_panic: IntegerOverflowSemantics<LeanOverflowRaiseEffect> = OverflowRaises { effect: LeanOverflowPanics }
  match lean_admit_fixed_width_overflow_semantics(semantics: raises_panic) {
    LeanOverflowRefused { observed: _, reason: reason } =>
      reason == ^lean_overflow_refuse_raises_not_fixed_width_catalog
    LeanOverflowAccepted { semantics: _ } => false
  }
}

test fn lean_catalog_int32_carries_wrapping_not_raises() -> Bool {
  match lean_facts_int32().scalar {
    LeanIntegerScalar { overflow, signedness: _, width: _ } =>
      match overflow {
        OverflowReturns { value_rule: ReturnWrapping } => true
        OverflowReturns { value_rule: ReturnSaturating } => false
        OverflowRaises { effect: _ } => false
        OverflowUndefined => false
      }
    _ => false
  }
}
