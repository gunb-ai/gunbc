module v2.test.claim.lean_overflow_semantics_witness



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data lean_overflow_semantics_witness_note: String = "P3b cluster-2 receipt (lean end-to-end): std.integer.IntegerOverflowSemantics<E> keeps return, raise, and undefined as separate arms. Panic and trap are distinct E inhabitants; the downstream consumer that acts on the distinction today is lean_overflow_semantics_node (ModelCoreFactAxisOverflowDisposition spec projection) — substituting Panics for Traps changes content_hash of the emitted node. lean_admit_fixed_width_overflow_semantics collapses OverflowRaises { effect: _ } (see lean_overflow_raise_effect_admission_debt_note); witness lean_admit_refuses_trap_same_reason_as_panic_for_fixed_width_catalog is executed evidence of that collapse, not the permanent contract. Honest rung: accepted refinement with executing refusal — not structural impossibility. RED: undefined/raises refuse at admission; catalog int32 carries ReturnWrapping. Typed let initializers stay single-line per lean_overflow_parse_continuation_note."

test fn overflow_semantics_three_arms_distinguishable() -> Bool {
  let returns: std.integer.IntegerOverflowSemantics<v2.extdeps.languages.lean.LeanOverflowRaiseEffect> = std.integer.OverflowReturns { value_rule: std.integer.ReturnWrapping }
  let raises: std.integer.IntegerOverflowSemantics<v2.extdeps.languages.lean.LeanOverflowRaiseEffect> = std.integer.OverflowRaises { effect: v2.extdeps.languages.lean.LeanOverflowPanics }
  let undefined: std.integer.IntegerOverflowSemantics<v2.extdeps.languages.lean.LeanOverflowRaiseEffect> = std.integer.OverflowUndefined
  v2.extdeps.languages.lean.lean_overflow_semantics_arm_tag(semantics: returns) == ^lean_overflow_arm_returns && v2.extdeps.languages.lean.lean_overflow_semantics_arm_tag(semantics: raises) == ^lean_overflow_arm_raises && v2.extdeps.languages.lean.lean_overflow_semantics_arm_tag(semantics: undefined) == ^lean_overflow_arm_undefined && v2.extdeps.languages.lean.lean_overflow_semantics_arm_tag(semantics: returns) != v2.extdeps.languages.lean.lean_overflow_semantics_arm_tag(semantics: raises) && v2.extdeps.languages.lean.lean_overflow_semantics_arm_tag(semantics: raises) != v2.extdeps.languages.lean.lean_overflow_semantics_arm_tag(semantics: undefined)
}

test fn lean_panic_and_trap_project_different_overflow_semantics_nodes() -> Bool {
  let raises_panic: std.integer.IntegerOverflowSemantics<v2.extdeps.languages.lean.LeanOverflowRaiseEffect> = std.integer.OverflowRaises { effect: v2.extdeps.languages.lean.LeanOverflowPanics }
  let raises_trap: std.integer.IntegerOverflowSemantics<v2.extdeps.languages.lean.LeanOverflowRaiseEffect> = std.integer.OverflowRaises { effect: v2.extdeps.languages.lean.LeanOverflowTraps }
  v2.std.node.content_hash(n: v2.extdeps.languages.lean.lean_overflow_semantics_node(semantics: raises_panic)) != v2.std.node.content_hash(n: v2.extdeps.languages.lean.lean_overflow_semantics_node(semantics: raises_trap))
}

test fn lean_admit_refuses_trap_same_reason_as_panic_for_fixed_width_catalog() -> Bool {
  let raises_trap: std.integer.IntegerOverflowSemantics<v2.extdeps.languages.lean.LeanOverflowRaiseEffect> = std.integer.OverflowRaises { effect: v2.extdeps.languages.lean.LeanOverflowTraps }
  match v2.extdeps.languages.lean.lean_admit_fixed_width_overflow_semantics(semantics: raises_trap) {
    v2.extdeps.languages.lean.LeanOverflowRefused { observed: _, reason: reason } =>
      reason == ^lean_overflow_refuse_raises_not_fixed_width_catalog
    v2.extdeps.languages.lean.LeanOverflowAccepted { semantics: _ } => false
  }
}

test fn lean_admit_accepts_catalog_wrapping_returns() -> Bool {
  match v2.extdeps.languages.lean.lean_admit_fixed_width_overflow_semantics(semantics: v2.extdeps.languages.lean.lean_catalog_fixed_width_overflow) {
    v2.extdeps.languages.lean.LeanOverflowAccepted { semantics: admitted } =>
      match admitted.semantics {
        std.integer.OverflowReturns { value_rule: std.integer.ReturnWrapping } => true
        std.integer.OverflowReturns { value_rule: std.integer.ReturnSaturating } => false
        std.integer.OverflowRaises { effect: _ } => false
        std.integer.OverflowUndefined => false
      }
    v2.extdeps.languages.lean.LeanOverflowRefused { observed: _, reason: _ } => false
  }
}

test fn lean_admit_refuses_undefined_for_fixed_width_catalog() -> Bool {
  let undefined: std.integer.IntegerOverflowSemantics<v2.extdeps.languages.lean.LeanOverflowRaiseEffect> = std.integer.OverflowUndefined
  match v2.extdeps.languages.lean.lean_admit_fixed_width_overflow_semantics(semantics: undefined) {
    v2.extdeps.languages.lean.LeanOverflowRefused { observed: _, reason: reason } =>
      reason == ^lean_overflow_refuse_undefined_not_fixed_width_catalog
    v2.extdeps.languages.lean.LeanOverflowAccepted { semantics: _ } => false
  }
}

test fn lean_admit_refuses_raises_panic_for_fixed_width_catalog() -> Bool {
  let raises_panic: std.integer.IntegerOverflowSemantics<v2.extdeps.languages.lean.LeanOverflowRaiseEffect> = std.integer.OverflowRaises { effect: v2.extdeps.languages.lean.LeanOverflowPanics }
  match v2.extdeps.languages.lean.lean_admit_fixed_width_overflow_semantics(semantics: raises_panic) {
    v2.extdeps.languages.lean.LeanOverflowRefused { observed: _, reason: reason } =>
      reason == ^lean_overflow_refuse_raises_not_fixed_width_catalog
    v2.extdeps.languages.lean.LeanOverflowAccepted { semantics: _ } => false
  }
}

test fn lean_catalog_int32_carries_wrapping_not_raises() -> Bool {
  match v2.extdeps.languages.lean.lean_facts_int32().scalar {
    v2.extdeps.languages.lean.LeanIntegerScalar { overflow: admitted, signedness: _, width: _ } =>
      match admitted.semantics {
        std.integer.OverflowReturns { value_rule: std.integer.ReturnWrapping } => true
        std.integer.OverflowReturns { value_rule: std.integer.ReturnSaturating } => false
        std.integer.OverflowRaises { effect: _ } => false
        std.integer.OverflowUndefined => false
      }
    _ => false
  }
}
