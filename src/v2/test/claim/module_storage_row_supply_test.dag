module v2.test.claim.module_storage_row_supply

import std.occurrence_binding_candidates { ModulePathFileRow }
import v2.compiler.source_authority {
  ModulePathFileRowsFromIndex,
  ModulePathFileRowsFromIndexReady,
  ModulePathFileRowsFromIndexRefused,
  ModulePathFileRowProjection,
  ModulePathFileRowProjected,
  ModulePathFileRowNoStorageRealization,
  module_path_file_rows_from_storage_index,
}
import v2.test.workflow.host_module_binding_manifest {
  host_module_binding_count,
  host_module_bindings,
}
import v2.std.algebra { length }
import v2.std.collection { Absent, Present }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data msrs_note: String = "PROVIDER ROWS FROM THE REAL TREE, not from a hand-selected path. This is the second half of the import-deletion lane's provider discovery, and the point of it is what it does NOT add: no filesystem walker, no name scanner, no module-to-file map and no second dependency producer. The whole-tree PARSED module-to-path rows already exist -- discover_source_root_ingest --emit-module-binding-manifest emits them via v1_compiler_parse, carrying no source text and therefore uncapped -- and module_binding_supply_transport already overlays them as a MODULE in an ephemeral source root. So the rows arrive as data through an existing carrier, and this witness projects them through the authority.

Arriving as a module rather than through a filesystem read is what makes this reachable at all. A witness that read the tree with filesystem_read would drag the Filesystem service into its emission closure; under src/v1 that produces an unregisterable dry_run.rs, which is the placement contradiction the sibling import_deletion_bridge witness records. Overlaid data has no such cost."

data msrs_vacuity_note: String = "THE TWO VACUOUS GREENS, both closed, because this witness is only meaningful when the overlay is present. Run without the transport, host_module_bindings is the committed Empty stub and host_module_binding_count is 0 -- and an empty index projects to an empty row set that is legitimately Ready. Every claim below would then pass while observing nothing. So each row requires the manifest to be POPULATED and the projected set to be NON-EMPTY before it asserts anything, exactly as the sibling consistency witness requires a non-empty oracle. Neither arm widens: both refuse."

fn msrs_projected_rows() -> List<ModulePathFileRow>? {
  match host_module_binding_count > 0 {
    false => none
    true =>
      match module_path_file_rows_from_storage_index(index: host_module_bindings) {
        ModulePathFileRowsFromIndexRefused { first_failure: _, more_failures: _ } => none
        ModulePathFileRowsFromIndexReady { rows: rows } =>
          match length(rows) > 0 {
            true => Present { value: rows }
            false => none
          }
      }
  }
}

// THE POSITIVE CONTROL, and the vacuity guard for every row below it. Without this, an absent overlay
// would make the others pass by observing nothing.
test fn msrs_real_tree_rows_project() -> Bool {
  match msrs_projected_rows() {
    Absent => false
    Present { value: rows } => length(rows) > 0
  }
}

// EVERY row the manifest carries projects. Stated as a count identity rather than "some rows
// appeared": the projection refuses the whole index on any binding it cannot realize, so a Ready
// answer over the real tree is the claim that the entire live corpus is file-backed -- and if it ever
// is not, this row is where that shows up, as a refusal rather than as a shorter list.
test fn msrs_every_manifest_binding_projects_to_a_row() -> Bool {
  match msrs_projected_rows() {
    Absent => false
    Present { value: rows } => length(rows) == host_module_binding_count
  }
}

// A KNOWN REAL MODULE resolves to its KNOWN REAL PATH. This is the row that makes the population an
// observation of this repository rather than a shape check: the pair is authored here and must be
// found in rows derived from the live tree, so a projection that produced well-formed rows about the
// wrong files fails it. The subject is deliberately the same module the import-deletion bridge
// witness supplies by hand -- that hand-selected path is what this replaces.
test fn msrs_a_known_module_resolves_to_its_real_file() -> Bool {
  msrs_pair_present(
    module_path: "v2.std.live_tree",
    file_path: "src/v2/std/live_tree.dag",
  )
}

// THE dag/ ROOT IS COVERED, and these are the three rows whose absence the removed comment recorded.
//
// The producer minted the artifact identity as a `^stem` symbol literal from the file BASENAME, so the
// three dag/ files whose stems are reserved .dag keywords emitted `^capability`, `^module` and `^import`
// and the manifest did not parse -- half the corpus undescribable, and a reference-derived closure over
// the real tree cannot be completed while providers in dag/ cannot be named. The repair took the basename
// out of the identity decision rather than escaping it: v1_compiler.cli_run
// source_root_ingest_artifact_id_for_path interns the repo-relative PATH the row already carries, through
// the string-taking Symbol authority, so keywords are inert -- and two same-named files in different
// directories stop colliding on one identity, which the stem form did silently.
//
// One row per keyword, not one row for the class: each is a distinct file whose stem is a distinct
// keyword, and a repair that fixed only the one a class-level assertion happened to visit would pass it.
test fn msrs_keyword_stem_import_module_resolves_to_its_real_file() -> Bool {
  msrs_pair_present(module_path: "std.import", file_path: "dag/std/import.dag")
}

test fn msrs_keyword_stem_go_module_resolves_to_its_real_file() -> Bool {
  msrs_pair_present(
    module_path: "extdeps.languages.go.module",
    file_path: "dag/extdeps/languages/go/module.dag",
  )
}

test fn msrs_keyword_stem_capability_resolves_to_its_real_file() -> Bool {
  msrs_pair_present(
    module_path: "extdeps.bmc.capability",
    file_path: "dag/extdeps/bmc/capability.dag",
  )
}

// TWO ROOTS IN ONE INDEX. The rows above and the src/v2 row are separately asserted pairs; this asks the
// population question they cannot: that the index spans BOTH ordinary source roots at once. A producer
// invoked with one root would satisfy every pair it happened to cover and fail this.
test fn msrs_index_spans_both_ordinary_source_roots() -> Bool {
  match msrs_projected_rows() {
    Absent => false
    Present { value: rows } =>
      msrs_root_covered(rows: rows, prefix: "dag/")
        && msrs_root_covered(rows: rows, prefix: "src/v2/")
  }
}

fn msrs_root_covered(rows: List<ModulePathFileRow>, prefix: String) -> Bool {
  fold(rows, init: false, f: (found, row) =>
    found || ((row.file_path as String).starts_with(prefix: prefix)))
}

// THE NEGATIVE CONTROL. A module that does not exist must not appear, and the pair check must be
// capable of answering no -- otherwise the positive rows prove only that the fold visited something.
test fn msrs_an_absent_module_is_not_projected() -> Bool {
  match msrs_projected_rows() {
    Absent => false
    Present { value: _ } =>
      !msrs_pair_present(
        module_path: "v2.std.module_that_does_not_exist",
        file_path: "src/v2/std/module_that_does_not_exist.dag",
      )
  }
}

// A REAL MODULE PAIRED WITH THE WRONG FILE must not be present either. Distinct from the row above:
// that one asks whether an unknown NAME leaks in, this one asks whether a known name is bound to a
// path it does not have -- the failure a projection that reshaped module names into paths would
// produce, and it would pass the absent-module row.
test fn msrs_a_real_module_is_not_bound_to_the_wrong_file() -> Bool {
  match msrs_projected_rows() {
    Absent => false
    Present { value: _ } =>
      !msrs_pair_present(
        module_path: "v2.std.live_tree",
        file_path: "src/v2/std/live_tree_elsewhere.dag",
      )
  }
}

fn msrs_pair_present(module_path: String, file_path: String) -> Bool {
  match msrs_projected_rows() {
    Absent => false
    Present { value: rows } =>
      fold(rows, init: false, f: (found, row) =>
        found
          || ((row.module_path as String) == module_path
            && (row.file_path as String) == file_path))
  }
}
