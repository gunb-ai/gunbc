module v2.test.claim.trait_derive_completeness_predicate


data trait_derive_completeness_predicate_note: String = "Derisk witnesses for Gate-1 sub-wall #2: trait_derive_completeness.dag is the agnostic predicate authority; rust.dag owns surface-binding rows. RED: Int kernel must satisfy Add but not vice versa for String; unknown atom refuses Ord; nullary enum selects copy derive binding."

fn tdc_nullary_enum_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Disj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      },
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn tdc_payload_enum_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Disj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [
            v2.std.node.Edge {
              label: v2.std.node.Positional,
              target: v2.std.node.Node {
                kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^tdc_payload_field } },
                children: [],
                occurrence_id: v2.std.node.SyntheticOccurrence
              }
            }
          ],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn tdc_unknown_atom_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^tdc_unknown_carrier } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn tdc_elem_shape_is_payload_coproduct(elem: v2.std.node.Node) -> Bool {
  match v2.compiler.trait_derive_completeness.repr_grounding_derive_elem_shape(elem: elem) {
    std.trait_derive_shape.ReprDeriveElemPayloadCoproduct => true
    _ => false
  }
}

fn tdc_elem_shape_is_unknown(elem: v2.std.node.Node) -> Bool {
  match v2.compiler.trait_derive_completeness.repr_grounding_derive_elem_shape(elem: elem) {
    std.trait_derive_shape.ReprDeriveElemUnknown => true
    _ => false
  }
}

fn tdc_elem_shape_is_nullary_enum_copy(elem: v2.std.node.Node) -> Bool {
  match v2.compiler.trait_derive_completeness.repr_grounding_derive_elem_shape(elem: elem) {
    std.trait_derive_shape.ReprDeriveElemNullaryEnumCopy => true
    _ => false
  }
}

fn tdc_elem_shape_is_kernel_string(elem: v2.std.node.Node) -> Bool {
  match v2.compiler.trait_derive_completeness.repr_grounding_derive_elem_shape(elem: elem) {
    std.trait_derive_shape.ReprDeriveElemKernelString => true
    _ => false
  }
}

fn tdc_collection_requirement_gate_is_incomplete(
  requirement: v2.std.compilers.target_model.TargetCapabilityRequirement,
  elem: v2.std.node.Node
) -> Bool {
  match v2.compiler.trait_derive_completeness.trait_derive_completeness_gate_for_collection_requirement(
    requirement: requirement,
    elem: elem
  ) {
    Present { value: gate } =>
      match gate {
        v2.compiler.trait_derive_completeness.TraitDeriveCompletenessIncomplete => true
        v2.compiler.trait_derive_completeness.TraitDeriveCompletenessSatisfied => false
      }
    Absent => false
  }
}

fn tdc_collection_requirement_capability_unknown(
  requirement: v2.std.compilers.target_model.TargetCapabilityRequirement,
  elem: v2.std.node.Node
) -> Bool {
  match v2.compiler.trait_derive_completeness.trait_derive_completeness_gate_for_collection_requirement(
    requirement: requirement,
    elem: elem
  ) {
    Present { value: _ } => false
    Absent => true
  }
}

fn tdc_binding_is(binding: v2.std.collection.Symbol, expected: v2.std.collection.Symbol) -> Bool {
  binding == expected
}

fn tdc_coproduct_binding_accepted(coproduct: v2.std.node.Node) -> v2.std.collection.Symbol {
  match v2.extdeps.languages.rust.rust_trait_derive_surface_binding_for_coproduct(coproduct: coproduct) {
    v2.std.diagnostic.Accepted { value: binding, diagnostics: _ } => binding
    v2.std.diagnostic.Rejected { diagnostics: _ } => ^tdc_impossible_coproduct_binding
  }
}

fn tdc_coproduct_binding_rejected(coproduct: v2.std.node.Node) -> Bool {
  match v2.extdeps.languages.rust.rust_trait_derive_surface_binding_for_coproduct(coproduct: coproduct) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

test fn tdc_string_kernel_satisfies_clone_ord_serde_not_add() -> Bool {
  v2.compiler.trait_derive_completeness.repr_grounding_derive_trait_satisfied(derive_trait: extdeps.languages.rust.capabilities.RustClone, elem: v2.std.compilers.target_model.symbol_kernel_type_node())
    && v2.compiler.trait_derive_completeness.repr_grounding_derive_trait_satisfied(derive_trait: extdeps.languages.rust.capabilities.RustOrd, elem: v2.std.compilers.target_model.symbol_kernel_type_node())
    && v2.compiler.trait_derive_completeness.repr_grounding_derive_trait_satisfied(derive_trait: extdeps.languages.rust.capabilities.RustSerialize, elem: v2.std.compilers.target_model.symbol_kernel_type_node())
    && v2.compiler.trait_derive_completeness.repr_grounding_derive_trait_satisfied(derive_trait: extdeps.languages.rust.capabilities.RustAdd, elem: v2.std.compilers.target_model.symbol_kernel_type_node()) == false
}

test fn tdc_int_kernel_satisfies_arith_and_ord() -> Bool {
  v2.compiler.trait_derive_completeness.repr_grounding_derive_trait_satisfied(derive_trait: extdeps.languages.rust.capabilities.RustAdd, elem: v2.compiler.trait_derive_completeness.trait_derive_int_kernel_type_node())
    && v2.compiler.trait_derive_completeness.repr_grounding_derive_trait_satisfied(derive_trait: extdeps.languages.rust.capabilities.RustOrd, elem: v2.compiler.trait_derive_completeness.trait_derive_int_kernel_type_node())
    && v2.compiler.trait_derive_completeness.repr_grounding_derive_completeness_predicate_for_elem(
      required: std.algebra.Cons {
        head: extdeps.languages.rust.capabilities.RustAdd,
        tail: std.algebra.Cons { head: extdeps.languages.rust.capabilities.RustClone, tail: std.algebra.Cons { head: extdeps.languages.rust.capabilities.RustSerialize, tail: v2.std.algebra.Empty } }
      },
      elem: v2.compiler.trait_derive_completeness.trait_derive_int_kernel_type_node()
    )
}

test fn tdc_unknown_atom_refuses_ord_completeness() -> Bool {
  v2.compiler.trait_derive_completeness.repr_grounding_derive_trait_satisfied(derive_trait: extdeps.languages.rust.capabilities.RustOrd, elem: tdc_unknown_atom_node()) == false
    && tdc_elem_shape_is_unknown(elem: tdc_unknown_atom_node())
    && tdc_collection_requirement_gate_is_incomplete(
      requirement: v2.std.compilers.target_model.TargetCapabilityRequirement {
        representation_parameter: ^target_collection_type_param_t,
        capability_key: ^target_collection_trait_ord
      },
      elem: tdc_unknown_atom_node()
    )
}

test fn tdc_unknown_capability_refuses_rather_than_defaulting() -> Bool {
  tdc_collection_requirement_capability_unknown(
    requirement: v2.std.compilers.target_model.TargetCapabilityRequirement {
      representation_parameter: ^target_collection_type_param_t,
      capability_key: ^tdc_capability_not_declared_by_any_target
    },
    elem: v2.std.compilers.target_model.symbol_kernel_type_node()
  )
    && tdc_collection_requirement_capability_unknown(
      requirement: v2.std.compilers.target_model.TargetCapabilityRequirement {
        representation_parameter: ^target_collection_type_param_t,
        capability_key: ^target_collection_trait_ord
      },
      elem: v2.std.compilers.target_model.symbol_kernel_type_node()
    ) == false
}

test fn tdc_payload_coproduct_shape_and_predicate() -> Bool {
  tdc_elem_shape_is_payload_coproduct(elem: tdc_payload_enum_node())
    && std.trait_derive_shape.repr_grounding_derive_completeness_predicate(
      extdeps.languages.rust.capabilities.rust_capability_shape_table(),
      extdeps.languages.rust.capabilities.payload_coproduct_derive_traits(),
      std.trait_derive_shape.ReprDeriveElemPayloadCoproduct
    )
    && tdc_binding_is(
      binding: tdc_coproduct_binding_accepted(coproduct: tdc_payload_enum_node()),
      expected: ^rust_decl_derive_enum_binding
    )
    && tdc_coproduct_binding_rejected(coproduct: tdc_unknown_atom_node())
}

test fn tdc_nullary_enum_copy_shape_and_binding() -> Bool {
  tdc_elem_shape_is_nullary_enum_copy(elem: tdc_nullary_enum_node())
    && tdc_binding_is(
      binding: tdc_coproduct_binding_accepted(coproduct: tdc_nullary_enum_node()),
      expected: ^rust_decl_derive_enum_copy_binding
    )
}

test fn tdc_symbol_kernel_string_shape() -> Bool {
  tdc_elem_shape_is_kernel_string(elem: v2.std.compilers.target_model.symbol_kernel_type_node())
}

test fn tdc_record_surface_binding_heap_vs_copy() -> Bool {
  tdc_binding_is(
    binding: v2.extdeps.languages.rust.rust_trait_derive_surface_binding_for_record(heap_allocated: true),
    expected: ^rust_decl_derive_struct_binding
  )
    && tdc_binding_is(
      binding: v2.extdeps.languages.rust.rust_trait_derive_surface_binding_for_record(heap_allocated: false),
      expected: ^rust_decl_derive_struct_copy_binding
    )
}

