data claim_phase1_nat_semiring_module_roundtrip: TestClaim = RoundTripClaim {
  label: "fixture=phase1/nat_semiring rung=3 target=dag predicate=R3-dag-roundtrip-wave1-ready",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: phase1_nat_semiring_rung_gate_canonical_subject,
  classification: TestClassification { tier: Tier3, layer: Integration }
}

data claim_phase1_nat_semiring_rust_emit_equals_eval: TestClaim = EqualsClaim {
  label: "fixture=phase1/nat_semiring rung=4 target=rust predicate=R4-rust-emit-equals-eval",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: phase1_nat_semiring_rung_gate_canonical_subject,
