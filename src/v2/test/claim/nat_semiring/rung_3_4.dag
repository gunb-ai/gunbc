  classification: TestClassification { tier: Tier3, layer: Integration }
}

data run_phase1_nat_semiring_rung3_module_roundtrip: TestClaimRun<Node, RuntimeValue> = rung34_roundtrip_run(claim: claim_phase1_nat_semiring_module_roundtrip, fixture_subject: phase1_nat_semiring_rung_gate_canonical_subject)

data run_phase1_nat_semiring_rung4_rust_emit_equals_eval: TestClaimRun<Node, RuntimeValue> = rung34_emit_vs_eval_run(claim: claim_phase1_nat_semiring_rust_emit_equals_eval, fixture_subject: phase1_nat_semiring_rung_gate_canonical_subject)
