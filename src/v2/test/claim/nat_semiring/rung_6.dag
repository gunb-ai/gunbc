fn rung6_emit_law_equals_claim(label: String, law_input: Node) -> TestClaim {
  EqualsClaim {
    label: label,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: law_input,
    rhs: law_input,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

data claim_phase1_nat_semiring_rung6_rust_add_left_identity_emit_equals_eval: TestClaim = rung6_emit_law_equals_claim(label: "fixture=phase1/nat_semiring rung=6 target=rust law=add-left-identity predicate=R6-rust-emit-law-equals-eval", law_input: nat_add_left_identity_input)

