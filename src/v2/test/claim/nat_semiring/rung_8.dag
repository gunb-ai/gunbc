module v2.test.nat_semiring.rung_8


fn rung8_tier1_eval_run(claim: TestClaim) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim(
    subject: rung34_test_claim_subject(
      claim: claim,
      evaluator_input: test_claim_input(c: claim)
    )
  )
}

data run_claim_nat_add_left_identity: TestClaimRun<Node, RuntimeValue> = rung8_tier1_eval_run(claim: claim_nat_add_left_identity)

