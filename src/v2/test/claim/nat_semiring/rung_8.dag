import v2.test.rung_3_4_common { rung34_test_claim_subject }

fn rung8_tier1_eval_run(claim: TestClaim) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim(
    subject: rung34_test_claim_subject(
      claim: claim,
      evaluator_input: test_claim_input(c: claim)
    )
  )
}

data run_claim_nat_add_left_identity: TestClaimRun<Node, RuntimeValue> = rung8_tier1_eval_run(claim: claim_nat_add_left_identity)

data run_claim_nat_add_right_identity: TestClaimRun<Node, RuntimeValue> = rung8_tier1_eval_run(claim: claim_nat_add_right_identity)

data run_claim_nat_add_associativity: TestClaimRun<Node, RuntimeValue> = rung8_tier1_eval_run(claim: claim_nat_add_associativity)

data run_claim_nat_mul_left_identity: TestClaimRun<Node, RuntimeValue> = rung8_tier1_eval_run(claim: claim_nat_mul_left_identity)

data run_claim_nat_mul_annihilator: TestClaimRun<Node, RuntimeValue> = rung8_tier1_eval_run(claim: claim_nat_mul_annihilator)

data run_claim_nat_mul_associativity: TestClaimRun<Node, RuntimeValue> = rung8_tier1_eval_run(claim: claim_nat_mul_associativity)

data run_claim_nat_add_wrong_identity_falsifies_law: TestClaimRun<Node, RuntimeValue> = rung8_tier1_eval_run(claim: claim_nat_add_wrong_identity_falsifies_law)

data phase1_nat_semiring_rung8_runtime_value_rows: List<TestClaimRun<Node, RuntimeValue>> = [
  run_claim_nat_add_left_identity,
  run_claim_nat_add_right_identity,
  run_claim_nat_add_associativity,
  run_claim_nat_mul_left_identity,
