module v2.test.claim.interface_summary.interface_summary_firewall


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data firewall_fixture_roots: List<String> = ["src/v2/test/fixture/interface_summary"]

fn export_fingerprint_for_gate(module_path: std.types.NonEmptyStr) -> std.content_hash.ContentHash? {
  match interface_summary_for_module(
    module_path: module_path,
    pool_roots: firewall_fixture_roots
  ) {
    Present { value: summary } =>
      fold(summary.exports, init: optional_absent(), f: fn(found, entry) {
        match found {
          Present { value: _ } => found
          Absent =>
            match entry.name == "firewall_gate" {
              true => v2.std.optional.Present { value: std.interface_summary.export_entry_fingerprint(entry: entry) }
              false => found
            }
        }
      })
    Absent => v2.std.optional.Absent
  }
}

fn body_only_edit_preserves_export_fingerprint() -> v2.std.logic.Bool {
  let v1 = export_fingerprint_for_gate(
    module_path: "v2.test.fixture.interface_summary.firewall_body_v1"
  )
  let v2 = export_fingerprint_for_gate(
    module_path: "v2.test.fixture.interface_summary.firewall_body_v2"
  )
  match v1 {
    Present { value: fp1 } =>
      match v2 {
        Present { value: fp2 } => fp1 == fp2
        Absent => false
      }
    Absent => false
  }
}

fn signature_edit_changes_export_fingerprint() -> v2.std.logic.Bool {
  let baseline = export_fingerprint_for_gate(
    module_path: "v2.test.fixture.interface_summary.firewall_body_v1"
  )
  let variant = export_fingerprint_for_gate(
    module_path: "v2.test.fixture.interface_summary.firewall_sig_variant"
  )
  match baseline {
    Present { value: fp1 } =>
      match variant {
        Present { value: fp2 } => fp1 != fp2
        Absent => false
      }
    Absent => false
  }
}

test fn interface_summary_firewall_body_only_edit_is_green() -> v2.std.logic.Bool {
  body_only_edit_preserves_export_fingerprint()
}

test fn interface_summary_firewall_signature_edit_is_red() -> v2.std.logic.Bool {
  signature_edit_changes_export_fingerprint()
}

test fn export_signature_facts_host_scaffold_receipt_cites_dissolution_authorities() -> v2.std.logic.Bool {
  match export_signature_facts_host_scaffold_dissolution_trigger {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

test fn interface_summary_import_unresolved_refuses_module_key_hashes() -> v2.std.logic.Bool {
  let edges = [
    v2.lens.module_graph.ImportResolutionFact {
      path: "src/mod.dag",
      import_module: "missing.other",
      target_declared: true
    }
  ]
  match import_interface_hashes_for_module(
    rel_path: "src/mod.dag",
    edges: edges,
    summaries: std.algebra.Empty
  ) {
    Absent => true
    Present { value: _ } => false
  }
}
