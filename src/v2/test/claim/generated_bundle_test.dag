module v2.test.claim.generated_bundle_test

import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { Hash, symbol_identity_digest }
import v2.workflow.generated_bundle {
  assess_drift,
  BundleEntry,
  BundleRefusal,
  CommittedEntry,
  DriftClean,
  DriftFound,
  DriftRefused,
  GeneratedBundle,
  HealAdmitted,
  HealRefusedDriftUnresolved,
  HealRefusedNothingToDo,
  HealRefusedUnassessedSubject,
  heal_plan_from,
  PathDrifted,
  PathMissingFromCommit,
  seal_generated_bundle
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data subject_a: Hash = symbol_identity_digest(sym: ^bundle_subject_a)
data subject_b: Hash = symbol_identity_digest(sym: ^bundle_subject_b)

data no_refusals: List<BundleRefusal> = []

data bundle_a: GeneratedBundle = seal_generated_bundle(
  subject: subject_a,
  entries: [
    BundleEntry { path: ".github/workflows/ci.yml", content: "GENERATED-A" },
    BundleEntry { path: "docs/derived.md", content: "GENERATED-B" }
  ],
  refusals: no_refusals
)

data committed_matching: List<CommittedEntry> = [
  CommittedEntry { path: ".github/workflows/ci.yml", content: "GENERATED-A" },
  CommittedEntry { path: "docs/derived.md", content: "GENERATED-B" }
]

data committed_drifted: List<CommittedEntry> = [
  CommittedEntry { path: ".github/workflows/ci.yml", content: "STALE" },
  CommittedEntry { path: "docs/derived.md", content: "GENERATED-B" }
]

data committed_missing_one: List<CommittedEntry> = [
  CommittedEntry { path: "docs/derived.md", content: "GENERATED-B" }
]

test fn drift_is_clean_found_or_refused() -> Bool {
  let clean = match assess_drift(bundle: bundle_a, committed: committed_matching) {
    DriftClean { subject: _, assessed: n } => n == 2
    DriftFound { subject: _, findings: _ } => false
    DriftRefused { subject: _, refusals: _ } => false
  }
  let found = match assess_drift(bundle: bundle_a, committed: committed_drifted) {
    DriftFound { subject: _, findings: fs } => length(xs: fs) == 1
    DriftClean { subject: _, assessed: _ } => false
    DriftRefused { subject: _, refusals: _ } => false
  }
  let missing = match assess_drift(bundle: bundle_a, committed: committed_missing_one) {
    DriftFound { subject: _, findings: fs } => length(xs: fs) == 1
    DriftClean { subject: _, assessed: _ } => false
    DriftRefused { subject: _, refusals: _ } => false
  }
  clean && found && missing
}

// A REFUSED GENERATION IS NOT CLEAN. The assessable subset agreeing with its commit is
// not the population agreeing with its commit, and reporting the first as the second
// is how an unproducible artifact passes.
data bundle_with_refusal: GeneratedBundle = seal_generated_bundle(
  subject: subject_a,
  entries: [BundleEntry { path: "docs/derived.md", content: "GENERATED-B" }],
  refusals: [BundleRefusal { path: ".github/workflows/ci.yml", cause: "producer refused" }]
)

test fn a_refused_generation_is_never_clean() -> Bool {
  match assess_drift(bundle: bundle_with_refusal, committed: committed_matching) {
    DriftRefused { subject: _, refusals: rs } => length(xs: rs) == 1
    DriftClean { subject: _, assessed: _ } => false
    DriftFound { subject: _, findings: _ } => false
  }
}

// HEAL WRITES EXACTLY THE ASSESSED BYTES. The write content is the bundle's content --
// the same value the receipt judged -- not a fresh production expected to match it.
// This is the property today's tree cannot state: main_wet regenerates after the gate
// assessed, so a moved input between the two passes puts unapproved bytes in the repo.
test fn heal_writes_the_assessed_bytes_only_for_drifted_paths() -> Bool {
  let receipt = assess_drift(bundle: bundle_a, committed: committed_drifted)
  match heal_plan_from(bundle: bundle_a, receipt: receipt) {
    HealAdmitted { plan: p } => {
      let one_write = length(xs: p.writes) == 1
      let exact = fold_list(
        xs: p.writes,
        empty: false,
        cons: fn(acc, w) {
          acc || ((w.path == ".github/workflows/ci.yml") && (w.content == "GENERATED-A"))
        }
      )
      one_write && exact && (p.subject == subject_a)
    }
    HealRefusedNothingToDo { subject: _ } => false
    HealRefusedUnassessedSubject { plan_subject: _, receipt_subject: _ } => false
    HealRefusedDriftUnresolved { subject: _ } => false
  }
}

// A BUNDLE FROM A DIFFERENT GENERATION CANNOT SATISFY THIS RECEIPT. Two runs over
// different inputs are two subjects, and applying one's bytes under the other's
// approval is the exact substitution the seal exists to prevent.
data bundle_other_subject: GeneratedBundle = seal_generated_bundle(
  subject: subject_b,
  entries: [BundleEntry { path: ".github/workflows/ci.yml", content: "GENERATED-ELSEWHERE" }],
  refusals: no_refusals
)

test fn heal_refuses_a_bundle_the_receipt_did_not_assess() -> Bool {
  let receipt = assess_drift(bundle: bundle_a, committed: committed_drifted)
  match heal_plan_from(bundle: bundle_other_subject, receipt: receipt) {
    HealRefusedUnassessedSubject { plan_subject: p, receipt_subject: r } =>
      (p == subject_b) && (r == subject_a)
    HealAdmitted { plan: _ } => false
    HealRefusedNothingToDo { subject: _ } => false
    HealRefusedDriftUnresolved { subject: _ } => false
  }
}

test fn heal_does_nothing_when_clean_and_refuses_when_unresolved() -> Bool {
  let nothing = match heal_plan_from(
    bundle: bundle_a,
    receipt: assess_drift(bundle: bundle_a, committed: committed_matching)
  ) {
    HealRefusedNothingToDo { subject: s } => s == subject_a
    HealAdmitted { plan: _ } => false
    HealRefusedUnassessedSubject { plan_subject: _, receipt_subject: _ } => false
    HealRefusedDriftUnresolved { subject: _ } => false
  }
  let unresolved = match heal_plan_from(
    bundle: bundle_with_refusal,
    receipt: assess_drift(bundle: bundle_with_refusal, committed: committed_matching)
  ) {
    HealRefusedDriftUnresolved { subject: s } => s == subject_a
    HealAdmitted { plan: _ } => false
    HealRefusedNothingToDo { subject: _ } => false
    HealRefusedUnassessedSubject { plan_subject: _, receipt_subject: _ } => false
  }
  nothing && unresolved
}

test fn generated_bundle_witnesses() -> Bool {
  drift_is_clean_found_or_refused()
    && a_refused_generation_is_never_clean()
    && heal_writes_the_assessed_bytes_only_for_drifted_paths()
    && heal_refuses_a_bundle_the_receipt_did_not_assess()
    && heal_does_nothing_when_clean_and_refuses_when_unresolved()
}
