module v2.test.lens_common.resolve_fixture

import v2.compiler.resolve { ResolvedTree }
import v2.compiler.name_resolve { Admission, ClosureDeclarations, ResolutionSubject, closure_declarations_demand, resolution_context, resolve_with_admission_grounded }
import v2.compiler.resolve { Namespace, NotDeclaring, ResolveContext, ScopeRoot, empty_namespace }
import v2.compiler.symbol_index_fill { symbol_index_fill_module_roots }
import v2.std.symbol_index { SymbolIndex, empty_symbol_index }
import v2.std.resolution_policy { default_name_resolution_policy }
import v2.compiler.normalized_tree { NormalizedTree, admit_normalized_tree, normalized_tree_roots_to_binding_sources }
import v2.compiler.body_lowering_fold { DeclaredRecord, DeclaredTypeKind, body_lower_callable_arrow }
import v2.compiler.namespace_graft { namespace_graft_build_body_conj, namespace_graft_fold_spine, namespace_graft_wrap_module_shell }
import v2.std.arrow_signature { declared_signature }
import v2.std.node_query { binder_edge }
import v2.std.namespace_alias { AliasBindingRow }
import v2.std.declaration_marker { test_marker_channel_empty }
import v2.std.cross_tree.resolution { SourceRootIndex, source_root_index_empty, source_root_index_insert }
import v2.std.cross_tree.import_model { V2Tree }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.qualified_name { QualifiedName }
import v2.std.node { Atom, Authored, Conj, Edge, Node, Symbol, TypeNode, allocate_pending_occurrences, content_hash, node_occurrence_allocator_after, node_with_occurrence_id }
import std.occurrence_identity { NodeOccurrenceIdentity, OccurrenceId, OccurrenceMinted, OccurrenceSynthetic, scoped_occurrence_allocator }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected, bind_outcome, outcome_accepted }
import v2.std.optional { optional_present }
import v2.std.algebra { fold_list_node, list_map }
import v2.std.collection { List }
import v2.std.integer { Int }
import std.algebra { Cons, Empty, FreeMonoid }

// A SUPPLIED LOWERED MODULE, INTO REAL RESOLVE (DESIGN section 3's witness rule at resolve's boundary).
// A row whose subject is what v2.compiler.resolve decides -- which declaration a dotted path names, which
// head a scope chain binds, what the closure index carries -- takes resolve's INPUT here as a constructed
// value instead of lowering authored text, which is 150-300k eval steps per module and is not its subject.
// Resolve is the real producer.
//
// THE SHAPE IS NORMALIZE'S, BUILT BY ITS OWN CONSTRUCTORS: the module wrapper and containment spine by
// v2.compiler.namespace_graft (namespace_graft_build_body_conj, namespace_graft_fold_spine,
// namespace_graft_wrap_module_shell), a function by v2.compiler.body_lowering_fold body_lower_callable_arrow
// over v2.std.arrow_signature declared_signature, a dotted path as v2.std.algebra fold_list_node of its
// segments, and the sealed carrier through v2.compiler.normalized_tree admit_normalized_tree, the door
// fixtures use. Type spellings are the authored ones (`Int`, `Box`), as lowering leaves them for resolve.
//
// OCCURRENCES. Every authored position carries its own minted id (claim_lowered_minted). The spine's source
// is SYNTHETIC: namespace_graft closes its image at the source, and a minted source would leave the spine
// OccurrencePending, which admit_normalized_tree refuses (normalize_reason_pending_occurrence_survived). The
// real spine carries the module node's projected occurrence; no row here reads the spine's.
fn claim_lowered_minted(n: Int) -> NodeOccurrenceIdentity {
  OccurrenceMinted { id: OccurrenceId { value: n } }
}

fn claim_lowered_atom(identity: Symbol, n: Int) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: identity } }, children: [], occurrence_id: claim_lowered_minted(n: n) }
}

// A dotted path `a.b.c` as lowering writes it: a fold_list_node whose items are minted atoms, the outer cell
// minted at `n` and each segment at `n + 1 + i`.
fn claim_lowered_path(segments: List<Symbol>, n: Int) -> Node {
  let numbered = claim_number(xs: segments, from: n + 1)
  let cells = fold_list_node(xs: numbered, item_node: fn(p) { claim_lowered_atom(identity: p.segment, n: p.n) })
  node_with_occurrence_id(kind: cells.kind, children: cells.children, occurrence_id: claim_lowered_minted(n: n))
}

type ClaimNumbered {
  segment: Symbol
  n: Int
}

fn claim_number(xs: List<Symbol>, from: Int) -> List<ClaimNumbered> {
  match xs {
    Empty => Empty
    Cons { head: h, tail: t } => Cons { head: ClaimNumbered { segment: h, n: from }, tail: claim_number(xs: t, from: from + 1) }
  }
}

type ClaimLoweredParam {
  name: Symbol
  type_node: Node
}

fn claim_lowered_function(site: Int, params: List<ClaimLoweredParam>, codomain: Node, body: Node) -> Node {
  let source = claim_lowered_atom(identity: ^claim_lowered_site, n: site)
  let signature = declared_signature(
    params: list_map(xs: params, f: fn(p) { binder_edge(name: p.name, type_node: p.type_node) }),
    source: source
  )
  body_lower_callable_arrow(
    source: source,
    domain: signature.domain,
    codomain: codomain,
    order_edge: signature.order,
    type_param_edges: [],
    body: optional_present(value: body)
  )
}

fn claim_lowered_record(fields: List<ClaimLoweredParam>, site: Int) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_map(xs: fields, f: fn(p) { binder_edge(name: p.name, type_node: p.type_node) }),
    occurrence_id: claim_lowered_minted(n: site)
  }
}

type ClaimLoweredModule {
  module: QualifiedName
  members: List<Edge>
  records: List<Symbol>
  imports: List<AliasBindingRow>
}

fn claim_lowered_root(m: ClaimLoweredModule) -> Node {
  let source = Node {
    kind: TypeNode { connective: Atom { identity: ^claim_lowered_module_site } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
  namespace_graft_wrap_module_shell(
    captured: namespace_graft_fold_spine(qn: m.module, body: namespace_graft_build_body_conj(edges: m.members, source: source), source: source),
    source: source
  )
}

// THE PENDING OCCURRENCES ARE ALLOCATED AS NORMALIZE ALLOCATES THEM. The production assemblers close their
// image at their source (v2.std.node close_lowered_image), leaving every member that shares the source's
// occurrence OccurrencePending; normalize then allocates them once, after lowering, with
// allocate_pending_occurrences over an allocator seeded past the tree's own ids -- which is what
// v2.compiler.normalize normalize_isolated_allocator does, and this does the same.
fn claim_lowered_allocated(root: Node) -> Node {
  allocate_pending_occurrences(
    root: root,
    allocator: scoped_occurrence_allocator(alloc: node_occurrence_allocator_after(root: root), scope: content_hash(n: root))
  ).root
}

fn claim_lowered_tree(m: ClaimLoweredModule) -> Outcome<NormalizedTree> {
  admit_normalized_tree(
    root: claim_lowered_allocated(root: claim_lowered_root(m: m)),
    test_markers: test_marker_channel_empty(),
    import_bindings: m.imports,
    type_declaration_kinds: list_map(xs: m.records, f: fn(r) { DeclaredRecord { name: r } }),
    type_declaration_modifiers: Empty,
    diagnostics: None
  )
}

fn claim_lowered_trees(modules: List<ClaimLoweredModule>) -> Outcome<FreeMonoid<NormalizedTree>> {
  match modules {
    Empty => outcome_accepted(value: Empty)
    Cons { head: m, tail: rest } =>
      bind_outcome(o: claim_lowered_tree(m: m), f: fn(t) {
        bind_outcome(o: claim_lowered_trees(modules: rest), f: fn(ts) { outcome_accepted(value: Cons { head: t, tail: ts }) })
      })
  }
}

fn claim_lowered_index(modules: List<ClaimLoweredModule>) -> SourceRootIndex {
  fold(modules, init: source_root_index_empty(), f: fn(acc, m) { source_root_index_insert(index: acc, module: m.module, root: V2Tree) })
}

// REAL RESOLVE over the supplied modules, with `subject` as the module under resolution -- the same entry
// v2.compiler.program_assembly assemble_program_from_ingest calls after lowering.
fn claim_resolve_lowered(modules: List<ClaimLoweredModule>, subject: QualifiedName) -> Outcome<ResolvedTree> {
  bind_outcome(o: claim_lowered_trees(modules: modules), f: fn(roots) {
    resolve_with_admission_grounded(
      lm: dag_language_model(),
      roots: roots,
      admission: Admission { subject: ResolutionSubject { name: subject }, imports: Empty },
      index: claim_lowered_index(modules: modules),
      active_roots: [V2Tree]
    )
  })
}


// THE PROVIDERS' DECLARATIONS AS THE PRODUCTION FILL INDEXES THEM: v2.compiler.symbol_index_fill
// symbol_index_fill_module_roots over the supplied lowered modules, the fill resolve itself starts from
// (v2.compiler.name_resolve resolution_context). A narrower resolve row reads its namespace from here, so
// the index it is handed is the one the producer emits for those modules, not a hand-written map.
fn claim_lowered_symbol_index(modules: List<ClaimLoweredModule>) -> Outcome<SymbolIndex> {
  bind_outcome(o: claim_lowered_trees(modules: modules), f: fn(roots) {
    outcome_accepted(value: symbol_index_fill_module_roots(index: empty_symbol_index(), roots: normalized_tree_roots_to_binding_sources(roots: roots)))
  })
}

// A RESOLVE CONTEXT FOR ONE NARROW RESOLVE FUNCTION: module `module`, its namespace's index the one above, a
// root scope over that namespace, the dag language model and the default policy.
fn claim_resolve_context(module: QualifiedName, index: SymbolIndex) -> ResolveContext {
  let empty = empty_namespace()
  let namespace = Namespace {
    bindings: empty.bindings,
    canonical_symbols: empty.canonical_symbols,
    symbol_index: index,
    module_qn: module,
    test_code: empty.test_code,
    declared_in: module,
    imported_origins: empty.imported_origins
  }
  ResolveContext {
    scope: ScopeRoot { module: namespace },
    type_scope: ScopeRoot { module: namespace },
    namespace: namespace,
    policy: default_name_resolution_policy(),
    position: Empty,
    lm: dag_language_model(),
    under_module_root: false,
    declaring: NotDeclaring
  }
}

// THE CLOSURE INDEX REAL RESOLVE BUILDS over the supplied modules: v2.compiler.name_resolve
// closure_declarations_demand over a context from the production constructor resolution_context. It walks
// every root and indexes the declarations of each that resolves, dropping one that refuses -- the step whose
// output decides whether an imported declaration is retrievable at all.
fn claim_closure(modules: List<ClaimLoweredModule>) -> Outcome<ClosureDeclarations> {
  bind_outcome(o: claim_lowered_trees(modules: modules), f: fn(roots) {
    bind_outcome(
      o: resolution_context(lm: dag_language_model(), roots: roots, index: claim_lowered_index(modules: modules), active_roots: [V2Tree], policy: default_name_resolution_policy()),
      f: fn(shared) { outcome_accepted(value: closure_declarations_demand(shared: shared)) }
    )
  })
}

fn claim_closure_declarations(modules: List<ClaimLoweredModule>) -> Outcome<SymbolIndex> {
  bind_outcome(o: claim_closure(modules: modules), f: fn(c) { outcome_accepted(value: c.declarations) })
}

// The roots the closure REFUSED, as the roster resolve hands infer (v2.compiler.resolve ResolvedTree
// unavailable_providers): each module with the reason its own resolve refused at the head of its chain.
type ClaimRefusedProvider {
  module: QualifiedName
  reason: Symbol
}

fn claim_closure_refused(modules: List<ClaimLoweredModule>) -> Outcome<List<ClaimRefusedProvider>> {
  bind_outcome(o: claim_closure(modules: modules), f: fn(c) {
    outcome_accepted(value: list_map(xs: c.refused, f: fn(r) { ClaimRefusedProvider { module: r.module, reason: r.refusal.head.reason } }))
  })
}
