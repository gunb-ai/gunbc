module v2.test.lens_common.derived_equality_backfill

// D1 derived-equality backfill: the four hand structural-equality folds
// (idempotency_verdict_eq, ownership_mode_eq, parallelism_relation_eq, lens_id_v0_eq) are deleted
// and every call site now uses the derived structural == over the type's own constructors
// (DESIGN section 3/4, dag/std/algebra). These claims are the discriminating RED + positive-control
// the payoff requires: for each type, distinct variants (and, where the type carries a payload
// field, distinct field values) compare UNEQUAL, while equal values compare EQUAL. Each RED is the
// case that would fail if == were wrong (e.g. an equality that ignored a payload field would make
// the field-level RED come out true).

import std.types { List }
import v2.lens.common.algebraic_composition {
  IdempotencyVerdict,
  OwnershipMode,
  ParallelismRelation,
  AlgebraicIdempotenceProven,
  RequiresAlgebraWitness,
  OwnedContainment,
  SharedRead,
  DataDependent,
  EffectCoupled,
  UnresolvedCoupling
}
import v2.lens.registry {
  LensIdV0,
  LensRegistryEntryV0,
  ComplexityDerivedKernel,
  ComplexityOptimality,
  Bound,
  lens_registry_entry_matches_id,
  lens_registry_id_resolves_in
}
import v2.compiler.infer { InferredFacts }
import v2.std.diagnostic { Diagnostic, Textual, WholeFile, Unavailable, AmbiguousIntent, ExternalContractUnknown }
import v2.std.witness { Witness, Holds }
import v2.test.lens_common.infer_fixture { claim_inferred_facts }

// Two structurally distinct InferredFacts (distinct symbols flow into the grounding node identities
// and the descent proof), so the two Witnesses built from them differ at a payload field, not just a
// variant. This is what makes the IdempotencyVerdict field-level RED discriminating.
data backfill_idempotency_law_a: Witness<InferredFacts> = Holds { value: claim_inferred_facts(type_symbol: ^backfill_idem_a_type, algebra_symbol: ^backfill_idem_a_algebra, descent_symbol: ^backfill_idem_a_descent) }
data backfill_idempotency_law_b: Witness<InferredFacts> = Holds { value: claim_inferred_facts(type_symbol: ^backfill_idem_b_type, algebra_symbol: ^backfill_idem_b_algebra, descent_symbol: ^backfill_idem_b_descent) }

// Two structurally distinct Diagnostics (distinct reason, file, and correction reason), so the two
// UnresolvedCoupling payloads differ at a field.
data backfill_parallelism_diagnostic_a: Diagnostic = Diagnostic {
  reason: ^backfill_parallelism_diag_a_reason,
  at: Textual { file: ^backfill_parallelism_diag_a_file, extent: WholeFile },
  correction: Unavailable { reason: AmbiguousIntent }
}

data backfill_parallelism_diagnostic_b: Diagnostic = Diagnostic {
  reason: ^backfill_parallelism_diag_b_reason,
  at: Textual { file: ^backfill_parallelism_diag_b_file, extent: WholeFile },
  correction: Unavailable { reason: ExternalContractUnknown }
}

// ------------------------------------------------------------------ IdempotencyVerdict

// RED (field-level): same variant, DIFFERENT law payload -> must be unequal. Fails if == ignored the
// law field (the payload the hand fold recursed into with a_law == b_law).
test fn idempotency_verdict_field_red() -> Bool {
  (AlgebraicIdempotenceProven { law: backfill_idempotency_law_a } == AlgebraicIdempotenceProven { law: backfill_idempotency_law_b }) == false
}

// RED (variant-level): distinct variants -> must be unequal.
test fn idempotency_verdict_variant_red() -> Bool {
  (AlgebraicIdempotenceProven { law: backfill_idempotency_law_a } == RequiresAlgebraWitness) == false
}

// POSITIVE: equal values compare equal (both arms).
test fn idempotency_verdict_positive() -> Bool {
  (AlgebraicIdempotenceProven { law: backfill_idempotency_law_a } == AlgebraicIdempotenceProven { law: backfill_idempotency_law_a })
    && (RequiresAlgebraWitness == RequiresAlgebraWitness)
}

// ------------------------------------------------------------------ OwnershipMode

// RED: distinct variants -> must be unequal.
test fn ownership_mode_red() -> Bool {
  (OwnedContainment == SharedRead) == false
}

// POSITIVE: equal values compare equal.
test fn ownership_mode_positive() -> Bool {
  OwnedContainment == OwnedContainment
}

// ------------------------------------------------------------------ ParallelismRelation

// RED (field-level): same variant, DIFFERENT diagnostic payload -> must be unequal. Fails if ==
// ignored the diagnostic field (the payload the hand fold recursed into with ad == bd).
test fn parallelism_relation_field_red() -> Bool {
  (UnresolvedCoupling { diagnostic: backfill_parallelism_diagnostic_a } == UnresolvedCoupling { diagnostic: backfill_parallelism_diagnostic_b }) == false
}

// RED (variant-level): distinct variants -> must be unequal.
test fn parallelism_relation_variant_red() -> Bool {
  (DataDependent == EffectCoupled) == false
}

// POSITIVE: equal values compare equal (both a unit arm and the field-carrying arm).
test fn parallelism_relation_positive() -> Bool {
  (DataDependent == DataDependent)
    && (UnresolvedCoupling { diagnostic: backfill_parallelism_diagnostic_a } == UnresolvedCoupling { diagnostic: backfill_parallelism_diagnostic_a })
}

// ------------------------------------------------------------------ LensIdV0

// Two bound registry entries with DIFFERENT lens_ids, for the call-site RED/positive.
data backfill_registry_entry_kernel: LensRegistryEntryV0 = {
  lens_id: ComplexityDerivedKernel,
  module_path: Bound { path: "backfill.kernel" }
}

data backfill_registry_entry_optimality: LensRegistryEntryV0 = {
  lens_id: ComplexityOptimality,
  module_path: Bound { path: "backfill.optimality" }
}

data backfill_registry_entries: List<LensRegistryEntryV0> = [
  backfill_registry_entry_kernel,
  backfill_registry_entry_optimality
]

// RED (field/variant-level, at the real call site): entry.lens_id == lens_id must be false when the
// id does not match (the site that used to call lens_id_v0_eq(left, right)).
test fn lens_id_matches_id_red() -> Bool {
  lens_registry_entry_matches_id(entry: backfill_registry_entry_kernel, lens_id: ComplexityOptimality) == false
}

// RED (distinct variants, direct): must be unequal.
test fn lens_id_variant_red() -> Bool {
  (ComplexityDerivedKernel == ComplexityOptimality) == false
}

// POSITIVE: equal values compare equal, both direct and through the resolving call site.
test fn lens_id_positive() -> Bool {
  (ComplexityDerivedKernel == ComplexityDerivedKernel)
    && lens_registry_entry_matches_id(entry: backfill_registry_entry_kernel, lens_id: ComplexityDerivedKernel)
    && lens_registry_id_resolves_in(entries: backfill_registry_entries, lens_id: ComplexityOptimality)
}
