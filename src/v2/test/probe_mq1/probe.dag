data probe_keep_edge_source: String = "module chunk\n\nfn target_model_bundle_core_keep_edge(acc: List<Edge>, edge: Edge) -> List<Edge> {\n  match edge.label {\n    Named { name: n } =>\n\n      match n == ^target_model_edge_atom_realizations\n        || n == ^target_model_edge_signature_realizations {\n        true => acc\n        false => list_snoc_item(xs: acc, item: edge)\n      }\n    Positional => list_snoc_item(xs: acc, item: edge)\n  }\n}\n"
test fn q_keep_edge_normalize_refused() -> Bool { probe_has(xs: probe_one(src: probe_keep_edge_source), id: ^PROBE_NORMALIZE_REFUSED) }
test fn q_keep_edge_parse_refused() -> Bool { probe_has(xs: probe_one(src: probe_keep_edge_source), id: ^PROBE_PARSE_REFUSED) }
test fn q_keep_edge_operand_unread() -> Bool { probe_has(xs: probe_one(src: probe_keep_edge_source), id: ^body_lowering_reason_operator_operand_unread) }
test fn q_keep_edge_has_generic_ident() -> Bool { probe_has(xs: probe_one(src: probe_keep_edge_source), id: ^dag_token_ident) }
test fn q_keep_edge_has_caret_token() -> Bool { probe_has(xs: probe_one(src: probe_keep_edge_source), id: ^dag_token_caret) }
test fn q_keep_edge_keeps_target_model_edge_atom_realizations() -> Bool { probe_has(xs: probe_one(src: probe_keep_edge_source), id: ^target_model_edge_atom_realizations) }
test fn q_keep_edge_keeps_target_model_edge_signature_realizations() -> Bool { probe_has(xs: probe_one(src: probe_keep_edge_source), id: ^target_model_edge_signature_realizations) }

data probe_ordering_source: String = "module chunk\n\nfn ordering_predicate_from_wire_symbol(id: Symbol) -> Optional<OrderingPredicate> {\n  if id == ^ordering_predicate_is_less {\n    optional_present(value: IsLess)\n  } else {\n    if id == ^ordering_predicate_is_less_or_equal {\n      optional_present(value: IsLessOrEqual)\n    } else {\n      optional_absent()\n    }\n  }\n}\n"
test fn q_ordering_normalize_refused() -> Bool { probe_has(xs: probe_one(src: probe_ordering_source), id: ^PROBE_NORMALIZE_REFUSED) }
test fn q_ordering_parse_refused() -> Bool { probe_has(xs: probe_one(src: probe_ordering_source), id: ^PROBE_PARSE_REFUSED) }
test fn q_ordering_operand_unread() -> Bool { probe_has(xs: probe_one(src: probe_ordering_source), id: ^body_lowering_reason_operator_operand_unread) }
test fn q_ordering_has_generic_ident() -> Bool { probe_has(xs: probe_one(src: probe_ordering_source), id: ^dag_token_ident) }
test fn q_ordering_has_caret_token() -> Bool { probe_has(xs: probe_one(src: probe_ordering_source), id: ^dag_token_caret) }
test fn q_ordering_keeps_ordering_predicate_is_less() -> Bool { probe_has(xs: probe_one(src: probe_ordering_source), id: ^ordering_predicate_is_less) }
test fn q_ordering_keeps_ordering_predicate_is_less_or_equal() -> Bool { probe_has(xs: probe_one(src: probe_ordering_source), id: ^ordering_predicate_is_less_or_equal) }
