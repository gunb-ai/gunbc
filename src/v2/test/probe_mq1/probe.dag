module v2.test.probe_mq1.probe

import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_fatal_reason }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.optional { Absent, Present }
import v2.std.node { Node, Symbol }
import std.algebra { Cons, Empty, FreeMonoid }

fn probe_atoms(n: Node, acc: FreeMonoid<Symbol>) -> FreeMonoid<Symbol> {
  let here = match node_atom_identity_optional(node: n) {
    Present { value: id } => Cons { head: id, tail: acc }
    Absent => acc
  }
  fold(n.children, init: here, f: fn(a, e) { probe_atoms(n: e.target, acc: a) })
}

fn probe_one(src: String) -> FreeMonoid<Symbol> {
  let lm = dag_language_model()
  match tokenize(text: src, file: ^probe_mq1_file, rules: lm.lex) {
    Rejected { diagnostics: d } => Cons { head: ^PROBE_TOKENIZE_REFUSED, tail: Cons { head: diagnostics_fatal_reason(d: d), tail: Empty } }
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Rejected { diagnostics: d } => Cons { head: ^PROBE_PARSE_REFUSED, tail: Cons { head: diagnostics_fatal_reason(d: d), tail: Empty } }
        Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact.tree) {
            Rejected { diagnostics: d } => Cons { head: ^PROBE_NORMALIZE_REFUSED, tail: Cons { head: diagnostics_fatal_reason(d: d), tail: Empty } }
            Accepted { value: t, diagnostics: _ } => probe_atoms(n: t.root, acc: Empty)
          }
      }
  }
}


fn probe_has(xs: FreeMonoid<Symbol>, id: Symbol) -> Bool {
  match xs { Empty => false  Cons { head: h, tail: t } => h == id || probe_has(xs: t, id: id) }
}

data probe_free_name_slot_source: String = "module chunk\n\nfn formal_binding_is_free_name_slot(binding: Symbol) -> Bool {\n  binding == ^grammar_free_name_slot\n}\n"
test fn q_free_name_slot_normalize_refused() -> Bool { probe_has(xs: probe_one(src: probe_free_name_slot_source), id: ^PROBE_NORMALIZE_REFUSED) }
test fn q_free_name_slot_parse_refused() -> Bool { probe_has(xs: probe_one(src: probe_free_name_slot_source), id: ^PROBE_PARSE_REFUSED) }
test fn q_free_name_slot_operand_unread() -> Bool { probe_has(xs: probe_one(src: probe_free_name_slot_source), id: ^body_lowering_reason_operator_operand_unread) }
test fn q_free_name_slot_has_generic_ident() -> Bool { probe_has(xs: probe_one(src: probe_free_name_slot_source), id: ^dag_token_ident) }
test fn q_free_name_slot_has_caret_token() -> Bool { probe_has(xs: probe_one(src: probe_free_name_slot_source), id: ^dag_token_caret) }
test fn q_free_name_slot_keeps_grammar_free_name_slot() -> Bool { probe_has(xs: probe_one(src: probe_free_name_slot_source), id: ^grammar_free_name_slot) }

