test fn q_c00411_sym_probe_arg_sym() -> Bool { probe_has(xs: probe_one(src: "module chunk\n\nfn formal_binding_is_free_name_slot(binding: Symbol) -> Bool {\n  binding == ^grammar_free_name_slot\n}\n"), id: ^probe_arg_sym) }
