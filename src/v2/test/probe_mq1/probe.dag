test fn q_keep_edge_keeps_target_model_edge_signature_realizations() -> Bool { probe_has(xs: probe_one(src: probe_keep_edge_source), id: ^target_model_edge_signature_realizations) }

data probe_ordering_source: String = "module chunk\n\nfn ordering_predicate_from_wire_symbol(id: Symbol) -> Optional<OrderingPredicate> {\n  if id == ^ordering_predicate_is_less {\n    optional_present(value: IsLess)\n  } else {\n    if id == ^ordering_predicate_is_less_or_equal {\n      optional_present(value: IsLessOrEqual)\n    } else {\n      optional_absent()\n    }\n  }\n}\n"
