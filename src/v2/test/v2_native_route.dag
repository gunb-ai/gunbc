      file_refusals: []
    )),
    cause_name: "universe_duplicates_present"
  )
}

// ONE SHAPE, TWO MODULES: the same marked declaration, differing only in whether its module lies
// inside the route boundary. The first is a selection that escaped the boundary operand routing
// enforces and refuses by name; the second is a marked declaration in a `v2` module that is not under
// `v2.test`, which the boundary admits because a test is identified by its marker.
fn boundary_admission_over(module: String) -> NativeRouteAdmission {
  native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_over(
    universe: [test_identity(module: module, declaration: "marked_probe")],
    module_source_index: [],
    population: [passed_row(module: module, declaration: "marked_probe")],
    file_refusals: []
  ))
}

test fn a_universe_member_outside_the_route_boundary_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: boundary_admission_over(module: "test.claim.marked_probe_module"),
    cause_name: "universe_boundary_violations_present"
  )
}

test fn a_marked_universe_member_outside_v2_test_but_inside_the_boundary_is_not_a_violation() -> Bool {
  !native_route_admission_refused_with(
    admission: boundary_admission_over(module: "v2.compiler.marked_probe_module"),
    cause_name: "universe_boundary_violations_present"
  )
}

