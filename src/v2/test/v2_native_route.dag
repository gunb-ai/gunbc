// ── admission: the emitted build ───────────────────────────────────────────────────────────

fn receipt_with_build(build: NativeRouteEmittedBuild) -> NativeRouteReceipt {
  let base = green_receipt()
  NativeRouteReceipt {
    job: base.job,
    tested_tree: base.tested_tree,
    preparation_seed_identity: base.preparation_seed_identity,
    emitted_closure_identity: base.emitted_closure_identity,
    executable_path: base.executable_path,
    executable_identity: base.executable_identity,
    universe: base.universe,
    module_source_index: base.module_source_index,
    population: base.population,
    file_refusals: base.file_refusals,
    false_control: base.false_control,
    true_control: base.true_control,
    malformed_control: base.malformed_control,
    old_route_control: base.old_route_control,
    emitted_build: build
  }
}

test fn an_unbound_compiler_is_refused() -> Bool {
  let base = clean_emitted_build()
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_with_build(
      build: NativeRouteEmittedBuild {
        cargo_argv: base.cargo_argv,
        rustflags: base.rustflags,
        compiler_path: "",
        rustc_identity: base.rustc_identity,
        exit_status: base.exit_status,
        warning_count: base.warning_count
      }
    )),
    cause_name: "emitted_build_compiler_unbound"
  )
  && !native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: green_receipt()),
    cause_name: "emitted_build_compiler_unbound"
  )
}

test fn an_unrecorded_rustc_identity_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_with_build(
      build: emitted_build_with(rustflags: repo_self_warning_denial_rustflags(), rustc_identity: "", exit_status: 0, warning_count: 0)
    )),
    cause_name: "emitted_build_rustc_unrecorded"
  )
}

// THE DENIAL IS COMPARED BY EQUALITY: an inherited empty RUSTFLAGS and a RUSTFLAGS carrying the
// denial beside something else are both a different build environment from the one the receipt
// claims, and both refuse by the same name.
test fn rustflags_without_the_exact_denial_are_refused() -> Bool {
  let inherited_none = native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_with_build(
    build: emitted_build_with(rustflags: "", rustc_identity: "rustc 1.93.0", exit_status: 0, warning_count: 0)
  ))
  let widened = native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_with_build(
    build: emitted_build_with(rustflags: concat(repo_self_warning_denial_rustflags(), " -C opt-level=3"), rustc_identity: "rustc 1.93.0", exit_status: 0, warning_count: 0)
  ))
  native_route_admission_refused_with(admission: inherited_none, cause_name: "emitted_build_warnings_not_denied")
  && native_route_admission_refused_with(admission: widened, cause_name: "emitted_build_warnings_not_denied")
  && !native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: green_receipt()),
    cause_name: "emitted_build_warnings_not_denied"
  )
}

test fn a_warning_or_a_non_zero_status_on_the_emitted_build_is_refused() -> Bool {
  let warned = native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_with_build(
    build: emitted_build_with(rustflags: repo_self_warning_denial_rustflags(), rustc_identity: "rustc 1.93.0", exit_status: 0, warning_count: 1)
  ))
  let failed = native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_with_build(
    build: emitted_build_with(rustflags: repo_self_warning_denial_rustflags(), rustc_identity: "rustc 1.93.0", exit_status: 101, warning_count: 0)
  ))
  native_route_admission_refused_with(admission: warned, cause_name: "emitted_build_not_clean")
  && native_route_admission_refused_with(admission: failed, cause_name: "emitted_build_not_clean")
}

// ── admission: the fold collects every violated clause ─────────────────────────────────────

test fn one_red_run_names_every_violated_clause() -> Bool {
  let admission = native_route_admission_with(live_pair: LivePairRequired, receipt: NativeRouteReceipt {
    job: "wrong-job",
    tested_tree: "",
    preparation_seed_identity: "",
    emitted_closure_identity: "",
    executable_path: "",
    executable_identity: "",
    universe: [],
    module_source_index: [],
    population: [],
    file_refusals: [],
    false_control: Absent,
    true_control: Absent,
    malformed_control: MalformedSpecimenAccepted,
    old_route_control: OldRouteControlAbsent,
    emitted_build: NativeRouteEmittedBuild { cargo_argv: [], rustflags: "", compiler_path: "", rustc_identity: "", exit_status: 101, warning_count: 2 }
  })
  native_route_admission_refused_with(admission: admission, cause_name: "job_name_mismatch")
  && native_route_admission_refused_with(admission: admission, cause_name: "tested_tree_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "preparation_seed_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "emitted_closure_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "route_identity_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "universe_underived")
  && native_route_admission_refused_with(admission: admission, cause_name: "positive_population_empty")
  && native_route_admission_refused_with(admission: admission, cause_name: "required_native_pass_regressed")
  && native_route_admission_refused_with(admission: admission, cause_name: "false_control_not_observed")
  && native_route_admission_refused_with(admission: admission, cause_name: "true_control_not_observed")
  && native_route_admission_refused_with(admission: admission, cause_name: "malformed_control_accepted_by_route")
  && native_route_admission_refused_with(admission: admission, cause_name: "old_route_control_never_installed")
  && native_route_admission_refused_with(admission: admission, cause_name: "emitted_build_rustc_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "emitted_build_compiler_unbound")
  && native_route_admission_refused_with(admission: admission, cause_name: "emitted_build_warnings_not_denied")
  && native_route_admission_refused_with(admission: admission, cause_name: "emitted_build_not_clean")
}

test fn the_admission_summary_names_every_violated_clause() -> Bool {
  native_route_admission_summary(admission: native_route_admission_with(live_pair: LivePairRequired, receipt: NativeRouteReceipt {
    job: "wrong-job",
    tested_tree: "",
    preparation_seed_identity: "",
    emitted_closure_identity: "",
    executable_path: "",
    executable_identity: "",
    universe: [],
    module_source_index: [],
    population: [],
    file_refusals: [],
    false_control: Absent,
    true_control: Absent,
    malformed_control: MalformedSpecimenAccepted,
    old_route_control: OldRouteControlAbsent,
    emitted_build: NativeRouteEmittedBuild { cargo_argv: [], rustflags: "", compiler_path: "", rustc_identity: "", exit_status: 101, warning_count: 2 }
  })) == "refused: job_name_mismatch, tested_tree_unrecorded, preparation_seed_unrecorded, emitted_closure_unrecorded, route_identity_unrecorded, universe_underived, positive_population_empty, required_native_pass_regressed, false_control_not_observed, true_control_not_observed, malformed_control_accepted_by_route, old_route_control_never_installed, emitted_build_rustc_unrecorded, emitted_build_compiler_unbound, emitted_build_warnings_not_denied, emitted_build_not_clean"
}

// THE MODULE A SOURCE DECLARES, JUDGED HERE BECAUSE THE ROUTE NOW OWNS THE FACT. It used to be the seed's
// (its Rust module index) and moved into v2.compiler.compile with the derivation, so its discriminating
// reds move with it. A universe member needs no such reading: its name is the name it was requested by,
// confirmed against its `module` line by the acquirer, so no enrolled row can lack an owning module.
test fn the_declared_module_is_read_off_the_header_and_nothing_else() -> Bool {
  match native_lane_declared_module_name(
    content: "// a leading annotation\n\nmodule v2.test.subject\n\nimport std.types { Bool }\nmodule not.the.header\n"
  ) {
    Present { value: declared } => declared == "v2.test.subject"
    Absent => false
  }
}

// ABSENCE IS AN ARM, NOT A VALUE (review 64499). This pair compared the result against a bare
// String while native_lane_declared_module_name returns Optional<String>, so `Absent == ""` could
// never hold and this witness had an UNAUTHORABLE GREEN -- the state DESIGN section 4b names at
// the top rung, where a check that cannot pass carries no information and is worse than absent
// because it is counted as coverage. The sentinel it asserted was abolished by this same PR, two
// declarations away from the annotation saying absence is Optional and not an empty string.
test fn a_source_with_no_module_header_declares_no_module() -> Bool {
  match native_lane_declared_module_name(content: "// only prose\ntest fn t() -> Bool { true }\n") {
    Absent => true
    Present { value: _ } => false
  }
}

// The green receipt with one control swapped: the old-route arm is the only field under test in
// the two rows below, so every other field stays the admitted one rather than being re-authored.
fn green_receipt_with_old_route_control(control: NativeRouteOldRouteControl) -> NativeRouteReceipt {
  NativeRouteReceipt {
    job: green_receipt().job,
    tested_tree: green_receipt().tested_tree,
    preparation_seed_identity: green_receipt().preparation_seed_identity,
    emitted_closure_identity: green_receipt().emitted_closure_identity,
    executable_path: green_receipt().executable_path,
    executable_identity: green_receipt().executable_identity,
    universe: green_receipt().universe,
    module_source_index: green_receipt().module_source_index,
    population: green_receipt().population,
    file_refusals: green_receipt().file_refusals,
    false_control: green_receipt().false_control,
    true_control: green_receipt().true_control,
    emitted_build: green_receipt().emitted_build,
    malformed_control: green_receipt().malformed_control,
    old_route_control: control
  }
}

// A ROUTE THAT WAS NOT THERE IS A CLOSED FALLBACK, AND AN UNNAMED PATH IS STILL NOT AN OBSERVATION.
// The harness no longer requires the old route to exist so that it can move it, so the receipt can
// carry OldRouteNotPresentAtWindow; admission must hold it exactly as it holds a withdrawal, and
// must still refuse the arm whose path names nothing, which is the same empty-identity refusal the
// withdrawn arm gets.
test fn an_old_route_absent_for_the_window_closes_the_fallback() -> Bool {
  let receipt = green_receipt_with_old_route_control(
    control: OldRouteNotPresentAtWindow { expected_executable: concat(cargo_default_release_dir_rel, "/gunbc") }
  )
  native_route_admitted(admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt))
}

test fn an_absent_old_route_naming_nothing_is_refused() -> Bool {
  let receipt = green_receipt_with_old_route_control(
    control: OldRouteNotPresentAtWindow { expected_executable: "" }
  )
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt),
    cause_name: "old_route_control_never_installed"
  )
}

// ── what the lane acquires, decided by names ─────────────────────────────────────────────────────
//
// A MODULE OUTSIDE THE REQUESTED CLOSURE CHANGES NOTHING, AND THAT IS THE ACCEPTANCE (operator ruling
// 2026-09-11: prove closure-scoping by POPULATION, not by a faster clock, because a hidden
// whole-corpus prepass survives a timer improvement). Two decisions are this lane's and are claimed
// here over supplied values: WHICH NAMES ARE ENTRIES (a module the pattern cannot admit is never
// requested, so it is never read, never tokenized and cannot mint a refusal row or move a verdict), and
// WHAT IS DERIVED FROM THE MODULES THAT CAME BACK (the universe from the front end's own test markers,
// and an ingest that is exactly the acquired modules). Whether the read set IS the requested closure is
// the acquirer's verdict, claimed beside it (v2.test.claim.module_acquisition); the native layout and
// compile verbs run the same acquirer over the real repository, which is the one execution of the
// integration.

fn entries_text(entries: List<String>) -> String {
  fold_list(xs: entries, empty: "", cons: fn(acc, name) { concat(acc, "|", name) })
}

fn entries_under(text: String, population: List<String>) -> String {
  match parse_target_pattern(text: text) {
    TargetPatternRefused { cause: _ } => "pattern-refused"
    TargetPatternParsed { pattern: pattern } =>
      entries_text(entries: native_lane_candidate_entries(pattern: pattern, population: population))
  }
}

// The bound population, as the bound trees' module NAMES: v2 modules of several namespaces, and names
// of the `dag` tree the default pattern's boundary does not reach.
fn bound_population() -> List<String> {
  ["v2.test.alpha", "v2.test.beta.deep", "v2.test.gamma", "v2.workflow.delta", "gunbc.elsewhere", "test.manual.recipe"]
}

test fn the_entries_are_the_control_and_the_modules_the_pattern_admits() -> Bool {
  entries_under(text: "//v2/test/alpha:all", population: bound_population())
    == concat("|", native_route_live_control_module, "|v2.test.alpha")
}

test fn a_subtree_pattern_requests_its_subtree_and_not_the_modules_beside_it() -> Bool {
  entries_under(text: "//v2/test/beta/...", population: bound_population())
    == concat("|", native_route_live_control_module, "|v2.test.beta.deep")
}

test fn a_single_target_requests_the_module_of_its_package_and_no_other() -> Bool {
  entries_under(text: "//v2/test/gamma:a_claim", population: bound_population())
    == concat("|", native_route_live_control_module, "|v2.test.gamma")
}

// THE DEFAULT PATTERN IS THE ROUTE BOUNDARY, NOT A NAMESPACE OF TESTS: every `v2` module of the
// population is an entry, whatever namespace it lives in, and the `dag`-tree names are not. A request
// set that kept the retired `v2.test` predicate drops `v2.workflow.delta`; one that admitted the whole
// population gains `gunbc.elsewhere` and `test.manual.recipe`.
test fn the_default_pattern_requests_every_v2_module_of_the_population() -> Bool {
  entries_text(
    entries: native_lane_candidate_entries(pattern: native_route_default_pattern(), population: bound_population())
  ) == concat("|", native_route_live_control_module, "|v2.test.alpha|v2.test.beta.deep|v2.test.gamma|v2.workflow.delta")
}

// The live-control module is a `v2` module, so the default pattern admits it as a population member
// too: it is requested once, as the head, never twice. A repeated entry would be read twice and its
// markers captured twice.
test fn the_control_module_is_requested_once_under_the_default_pattern() -> Bool {
  entries_text(
    entries: native_lane_candidate_entries(
      pattern: native_route_default_pattern(),
      population: [native_route_live_control_module, "v2.test.alpha"]
    )
  ) == concat("|", native_route_live_control_module, "|v2.test.alpha")
}

// A name whose dummy label cannot be formed is not an entry, so its bytes are not acquired.
// That filter is not the counted refusal: native_lane_population_unformable_identity still
// refuses `native_lane_identity_label_refused` naming the module and the LabelRefusal cause
// (v2.test.claim.native_lane_universe_selection `an_unformable_population_name_refuses_typed`).
test fn a_label_that_cannot_be_formed_is_not_an_entry() -> Bool {
  entries_text(
    entries: native_lane_candidate_entries(
      pattern: native_route_default_pattern(),
      population: ["v2.test.alpha", "v2.test.foo..bar"]
    )
  ) == concat("|", native_route_live_control_module, "|v2.test.alpha")
}

fn an_acquired(name: String, path: String, markers: List<String>, content: String) -> AcquiredModule {
  AcquiredModule {
    name: name,
    file: ModuleFileRef { tree: V2Tree {}, relative_path: path },
    host_directory: "src/v2",
    content: content,
    requests: [],
    test_markers: markers,
    origin: AcquiredFromFile
  }
}

// The subject carries a marked declaration and, in its text, a `test fn` the front end did NOT mark:
// the universe is what the markers say, so the unmarked one is not a member.
fn subject_acquired() -> AcquiredModule {
  an_acquired(
    name: "v2.test.subject",
    path: "test/subject.dag",
    markers: ["a_claim"],
    content: "module v2.test.subject\n\ntest fn a_claim() -> Bool { true }\n\ntest fn only_in_text() -> Bool { true }\n"
  )
}

// Marked, inside the route boundary and OUTSIDE `v2.test`: a test, because the marker is what makes
// one.
fn marked_elsewhere_acquired() -> AcquiredModule {
  an_acquired(
    name: "v2.workflow.delta",
    path: "workflow/delta.dag",
    markers: ["a_workflow_claim"],
    content: "module v2.workflow.delta\n\ntest fn a_workflow_claim() -> Bool { true }\n"
  )
}

// A dependency the route acquires for its bytes: it carries no marker, so it enrols nothing.
fn dependency_acquired() -> AcquiredModule {
  an_acquired(name: "v2.std.logic", path: "std/logic.dag", markers: [], content: "module v2.std.logic\n")
}

// Marked, and OUTSIDE the route boundary (a `dag`-tree module): a test the default pattern does not
// select. Its absence from the universe is the boundary, and the lane still accepts the acquisition.
fn marked_outside_boundary_acquired() -> AcquiredModule {
  an_acquired(
    name: "test.manual.recipe",
    path: "test/manual/recipe.dag",
    markers: ["a_manual_claim"],
    content: "module test.manual.recipe\n\ntest fn a_manual_claim() -> Bool { true }\n"
  )
}

// The live-control module as the repository declares it: plain functions, no marker.
fn control_acquired() -> AcquiredModule {
  an_acquired(
    name: native_route_live_control_module,
    path: "native_lane_fixture/control.dag",
    markers: [],
    content: "module v2.native_lane_fixture.control\n"
  )
}

fn acquired_over(
  modules: List<AcquiredModule>,
  population: List<String>,
  pattern: TargetPattern
) -> Outcome<NativeLaneAcquired> {
  native_lane_acquired(
    acquisition: NativeLaneAcquisition { modules: modules, population: population },
    pattern: pattern
  )
}

fn acquired_default(modules: List<AcquiredModule>, population: List<String>) -> Outcome<NativeLaneAcquired> {
  acquired_over(modules: modules, population: population, pattern: native_route_default_pattern())
}

fn identity_in(identities: List<NativeRouteTestIdentity>, qualified: String) -> Bool {
  fold_list(
    xs: identities,
    empty: false,
    cons: fn(held, identity) { held || native_route_identity_qualified(identity: identity) == qualified }
  )
}

fn everything_acquired() -> List<AcquiredModule> {
  [
    control_acquired(),
    subject_acquired(),
    marked_elsewhere_acquired(),
    dependency_acquired(),
    marked_outside_boundary_acquired()
  ]
}

// THE UNIVERSE IS THE MARKED DECLARATIONS OF THE ACQUIRED MODULES THE ROUTE BOUNDARY REACHES: the
// marked declaration of `v2.test` and the marked one of `v2.workflow` are both members, and the unmarked
// `test fn` in the subject's text, the unmarked control and dependency and the marked declaration
// outside the boundary are not. Exactly two members, so a universe that kept the retired namespace
// predicate loses the workflow member, and one that took the control or the dependency as members, or
// ignored the boundary, gains one.
test fn the_universe_is_the_marked_declarations_of_the_modules_acquired() -> Bool {
  match acquired_default(modules: everything_acquired(), population: ["v2.test.subject"]) {
    Rejected { diagnostics: _ } => false
    Accepted { value: acquired, diagnostics: _ } =>
      identity_in(identities: acquired.universe.identities, qualified: "v2.test.subject.a_claim")
        && identity_in(identities: acquired.universe.identities, qualified: "v2.workflow.delta.a_workflow_claim")
        && (length(xs: acquired.universe.identities) == 2)
  }
}

test fn the_ingest_is_exactly_the_acquired_modules() -> Bool {
  match acquired_default(modules: everything_acquired(), population: ["v2.test.subject"]) {
    Rejected { diagnostics: _ } => false
    Accepted { value: acquired, diagnostics: _ } => length(xs: acquired.ingest) == 5
  }
}

// The population is counted from the names the bound trees listed, not from what was read: a population
// of three modules acquired as two is still a population of three.
test fn the_population_is_the_names_listed_and_not_the_modules_read() -> Bool {
  match acquired_default(
    modules: [control_acquired(), subject_acquired()],
    population: ["v2.test.subject", "v2.test.other", "v2.test.another"]
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: acquired, diagnostics: _ } => acquired.population == 3
  }
}

fn refused_reason_is(outcome: Outcome<NativeLaneAcquired>, reason: Symbol) -> Bool {
  match outcome {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == reason
  }
}

// A MALFORMED DISPOSITION ROW IN AN ACQUIRED UNIVERSE MEMBER STOPS THE LINE: the facts cover the members
// this run requested, and discovery's own finalize judges every one of them.
test fn a_malformed_disposition_row_in_an_acquired_member_refuses_the_derivation() -> Bool {
  refused_reason_is(
    outcome: acquired_default(
      modules: [
        an_acquired(
          name: "v2.test.subject",
          path: "test/subject.dag",
          markers: ["a_claim"],
          content: "module v2.test.subject\n\ndata live_tree_disposition: LiveTreeDisposition = NoSuchVariant\n"
        )
      ],
      population: ["v2.test.subject"]
    ),
    reason: ^native_lane_universe_derivation_refused
  )
}

// A SINGLE TARGET THAT SPELLS A MODULE IS A MISSPELLING, recognised from the listed NAMES: the module
// was not requested (its package is not the pattern's), so nothing was read to find it out.
test fn a_single_target_that_spells_a_module_refuses_naming_the_module_spelling() -> Bool {
  match parse_target_pattern(text: "//v2/test:subject") {
    TargetPatternRefused { cause: _ } => false
    TargetPatternParsed { pattern: pattern } =>
      refused_reason_is(
        outcome: acquired_over(modules: [control_acquired()], population: ["v2.test.subject"], pattern: pattern),
        reason: ^native_lane_pattern_names_a_module
      )
  }
}

// ── the reachability walk's budget ─────────────────────────────────────────────────────
//
// THE WALK THE CENSUS' CLOSURE FAN-OUT RUNS (native_lane_module_reachable) IS DISCRIMINATED AT THE
// INTERFACE IT ANSWERS FOR: the index is a SUPPLIED value, so these claims never read a population.
// The budget is rounds of breadth-first expansion and the closure below is two rounds deep: the seed
// expands to `v2.std.logic` in round one, and round two finds nothing new. A budget of one round leaves
// `v2.std.logic` on the frontier, and the walk must REFUSE by its typed reason rather than answer with
// the seed it had seen: a walk that absorbed the exhaustion would still hold the seed, so only this
// pair tells it apart. A budget of exactly two is the boundary: the frontier is empty when the fuel
// runs out, and the closure is accepted.
fn budget_probe_index() -> Map<String, List<String>> {
  let no_imports: List<String> = []
  map_insert(
    map_insert(empty_map(), "v2.test.subject", ["v2.std.logic"]),
    "v2.std.logic",
    no_imports
  )
}

fn closure_budget_probe(budget: Int) -> Outcome<List<String>> {
  native_lane_module_reachable(
    index: budget_probe_index(),
    frontier: ["v2.test.subject"],
    seen: ["v2.test.subject"],
    seen_set: map_insert(empty_map(), "v2.test.subject", true),
    fuel: budget,
    budget: budget
  )
}

test fn an_exhausted_closure_budget_refuses_the_derivation() -> Bool {
  match closure_budget_probe(budget: 1) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^native_lane_closure_budget_exhausted
  }
}

test fn a_closure_finishing_on_its_last_round_is_accepted() -> Bool {
  match closure_budget_probe(budget: 2) {
    Rejected { diagnostics: _ } => false
    Accepted { value: closure, diagnostics: _ } =>
      length(xs: closure) == 2 && fold_list(xs: closure, empty: false, cons: fn(held, m) { held || m == "v2.std.logic" })
  }
}

// ── the file refusals' composition ─────────────────────────────────────────────────────────
//
// THE TALLY COUNTS AT FATAL GRAIN, ONCE. `resolve_reason_unbound_symbol` is owned at BOTH grains in
// the cause table, so a tally that walked every row would count its refusal twice and the rows
// would sum past the receipt's population; the sum row below is what discriminates that. The two
// per-cause rows discriminate a tally that counted rows instead of refusals, or matched on the
// head reason.
fn native_route_tally_probe() -> List<NativeRouteCauseTally> {
  native_route_file_refusal_tally(receipt: receipt_over(
    universe: [],
    module_source_index: [],
    population: [],
    file_refusals: [
      file_refusal_row(path: ^tally_a, head: ^tokenize_lex_e1_unrecognized_char, fatal: ^parse_g0_tokens_remain),
      file_refusal_row(path: ^tally_b, head: ^tokenize_lex_e1_unrecognized_char, fatal: ^parse_g0_tokens_remain),
      file_refusal_row(path: ^tally_c, head: ^resolve_reason_unbound_symbol, fatal: ^resolve_reason_unbound_symbol)
    ]
  ))
}

fn native_route_tally_count_for(rows: List<NativeRouteCauseTally>, cause: Symbol) -> Int {
  fold_list(xs: rows, empty: 0, cons: fn(acc, row) {
    if row.cause == cause { acc + row.file_refusals } else { acc }
  })
}

test fn the_refusal_tally_counts_each_refusal_once_at_fatal_grain() -> Bool {
  let rows = native_route_tally_probe()
  (native_route_tally_count_for(rows: rows, cause: ^parse_g0_tokens_remain) == 2)
  && (native_route_tally_count_for(rows: rows, cause: ^resolve_reason_unbound_symbol) == 1)
  && (fold_list(xs: rows, empty: 0, cons: fn(acc, row) { acc + row.file_refusals }) == 3)
}

// ── a frontier's retirement, joined to the route's population ──
//
// THE GROUNDING FRONTIER COUNTS BOTH POPULATIONS. One file refusal and one eval-stage member
// refusal under two different grounding causes are both the frontier; a refusal under an
// unrelated cause is not. So the standing is Open with exactly two remaining. A standing that
// read only the file tally would say one, and one that matched any cause would say three.
fn grounding_frontier_probe_receipt() -> NativeRouteReceipt {
  receipt_over(
    universe: [],
    module_source_index: [],
    population: [
      refused_row(
        module: "v2.test.frontier_probe",
        declaration: "eval_refused",
        stage: NativeTestStageEval,
        reason: ^eval_rejected_grounding_not_derived
      ),
      refused_row(
        module: "v2.test.frontier_probe",
        declaration: "resolve_refused",
        stage: NativeTestStagePrepare,
        reason: ^resolve_reason_unbound_symbol
      )
    ],
    file_refusals: [
      file_refusal_row(path: ^frontier_a, head: ^infer_grounding_not_derived, fatal: ^translate_rejected_grounding_not_derived)
    ]
  )
}

test fn the_grounding_frontier_is_open_over_both_populations() -> Bool {
  match native_route_frontier_retirement_standing(
    retirement: node_grounding_frontier_retirement,
    receipt: grounding_frontier_probe_receipt()
  ) {
    FrontierOpen { remaining: n } => n == 2
    FrontierRetired => false
    FrontierRetirementCauseUnowned { cause: _ } => false
  }
}

// POSITIVE CONTROL: a population none of whose refusals is a grounding cause retires the frontier.
test fn the_grounding_frontier_retires_when_no_cause_is_observed() -> Bool {
  match native_route_frontier_retirement_standing(
    retirement: node_grounding_frontier_retirement,
    receipt: receipt_over(
      universe: [],
      module_source_index: [],
      population: [],
      file_refusals: [
        file_refusal_row(path: ^frontier_b, head: ^resolve_reason_unbound_symbol, fatal: ^resolve_reason_unbound_symbol)
      ]
    )
  ) {
    FrontierRetired => true
    FrontierOpen { remaining: _ } => false
    FrontierRetirementCauseUnowned { cause: _ } => false
  }
}

// THE DISCRIMINATING RED: a retirement over a cause the ownership table does not count at fatal
// grain would read zero, and so Retired, forever. It must stand Unowned, naming the cause, and
// that must hold even when the observed population is empty.
test fn a_retirement_over_an_unowned_cause_is_not_retired() -> Bool {
  match native_route_frontier_retirement_standing(
    retirement: FrontierRetirement {
      frontier: ^frontier_probe,
      causes: [^infer_grounding_not_derived, ^frontier_probe_cause_nobody_owns]
    },
    receipt: receipt_over(universe: [], module_source_index: [], population: [], file_refusals: [])
  ) {
    FrontierRetirementCauseUnowned { cause: c } => c == ^frontier_probe_cause_nobody_owns
    FrontierRetired => false
    FrontierOpen { remaining: _ } => false
  }
}

// ── the live pair, enrolled expecting-red (manager ruling 2026-09-21) ──

// A REAL REFUSAL CHAIN: the lookup class first (advisory), the fatal reason last -- the carriage
// order v2.compiler.resolve's ambiguous_symbol_diagnostics emits. A single-diagnostic probe makes
// head == fatal and cannot tell a head read from a fatal read (review 69726).
fn chain_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: invariant_port_locus(port: ^v2_native_route_test_supplied_verdict, invariant: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn refused_chain(class_reason: Symbol, fatal_reason: Symbol, at_prepare: Bool) -> Optional<NativeTestVerdict> {
  Present {
    value: NativeTestRefused {
      stage: if at_prepare { NativeTestStagePrepare } else { NativeTestStageContext },
      diagnostics: NonEmptyDiagnostics { head: chain_diagnostic(reason: class_reason), tail: [chain_diagnostic(reason: fatal_reason)] }
    }
  }
}

fn pinned_chain() -> Optional<NativeTestVerdict> {
  refused_chain(class_reason: ^resolve_ambiguous_on_global_bare, fatal_reason: ^resolve_reason_ambiguous_symbol, at_prepare: true)
}

fn receipt_with_controls(false_control: Optional<NativeTestVerdict>, true_control: Optional<NativeTestVerdict>) -> NativeRouteReceipt {
  let base = green_receipt()
  NativeRouteReceipt {
    job: base.job,
    tested_tree: base.tested_tree,
    preparation_seed_identity: base.preparation_seed_identity,
    emitted_closure_identity: base.emitted_closure_identity,
    executable_path: base.executable_path,
    executable_identity: base.executable_identity,
    universe: base.universe,
    module_source_index: base.module_source_index,
    population: base.population,
    file_refusals: base.file_refusals,
    false_control: false_control,
    true_control: true_control,
    malformed_control: base.malformed_control,
    old_route_control: base.old_route_control,
    emitted_build: base.emitted_build
  }
}

fn pinned() -> NativeRouteLivePairStanding {
  LivePairExpectedRed {
    stage: NativeTestStagePrepare,
    fatal_reason: ^resolve_reason_ambiguous_symbol,
    class_reason: ^resolve_ambiguous_on_global_bare,
    trigger: "t"
  }
}

// Enrolled and holding: both controls refuse at the pinned stage with the pinned reason, and the
// otherwise-green receipt is admitted under a supplied enrollment. The production standing (the
// data row) is exercised by the same receipt through `native_route_admission`: since gunbc#12048
// flipped it to LivePairRequired, the pinned refusals must NOT be admitted there, so a data row
// set back to an enrollment reds here.
test fn an_enrolled_live_pair_holds_only_at_its_pinned_refusal() -> Bool {
  let r = receipt_with_controls(false_control: pinned_chain(), true_control: pinned_chain())
  native_route_admitted(admission: native_route_admission_with(receipt: r, live_pair: pinned()))
  && !native_route_admitted(admission: native_route_admission(receipt: r))
  && !native_route_admitted(admission: native_route_admission_with(receipt: r, live_pair: LivePairRequired))
}

// The flip signal: an observed control while enrolled refuses by its own name.
test fn an_observed_live_pair_while_enrolled_demands_the_flip() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(receipt: green_receipt(), live_pair: pinned()),
    cause_name: "live_pair_observed_while_enrolled_red"
  )
}

// MOVED WALLS, one axis at a time, each refusing as not observed:
// - the CLASS moved while the fatal stayed (global-bare -> lexical-chain, what package 12 does);
// - the FATAL moved while the pinned class is still the pending HEAD advisory -- the case a head
//   read accepts as still pinned (review 69726);
// - the STAGE moved.
test fn a_live_pair_refused_for_another_cause_is_not_the_enrollment() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(
      receipt: receipt_with_controls(
        false_control: refused_chain(class_reason: ^resolve_ambiguous_on_lexical_chain, fatal_reason: ^resolve_reason_ambiguous_symbol, at_prepare: true),
        true_control: pinned_chain()
      ),
      live_pair: pinned()
    ),
    cause_name: "false_control_not_observed"
  )
  && native_route_admission_refused_with(
    admission: native_route_admission_with(
      receipt: receipt_with_controls(
        false_control: pinned_chain(),
        true_control: refused_chain(class_reason: ^resolve_ambiguous_on_global_bare, fatal_reason: ^resolve_reason_unbound_symbol, at_prepare: true)
      ),
      live_pair: pinned()
    ),
    cause_name: "true_control_not_observed"
  )
  && native_route_admission_refused_with(
    admission: native_route_admission_with(
      receipt: receipt_with_controls(
        false_control: pinned_chain(),
        true_control: refused_chain(class_reason: ^resolve_ambiguous_on_global_bare, fatal_reason: ^resolve_reason_ambiguous_symbol, at_prepare: false)
      ),
      live_pair: pinned()
    ),
    cause_name: "true_control_not_observed"
  )
}
