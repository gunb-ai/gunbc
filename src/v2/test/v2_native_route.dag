// ── synthetic receipt constructors ─────────────────────────────────────────────────────────
//
// The admission fold reads the REAL floor rosters (floor_expected_red_roster,
// floor_route_gap_roster) from inside native_route_admission, so the synthetic identities here
// are chosen OFF every roster: "v2.test.*" names no real module carries. The disposition,
// reference and census functions take their rosters as arguments, so their tests are fully
// synthetic.

fn test_identity(module: String, declaration: String) -> NativeRouteTestIdentity {
  NativeRouteTestIdentity { module: module, declaration: declaration }
}

fn passed_row(module: String, declaration: String) -> NativeRouteMemberRow {
  NativeRouteMemberRow {
    identity: test_identity(module: module, declaration: declaration),
    verdict: NativeTestPassed
  }
}

fn false_row(module: String, declaration: String) -> NativeRouteMemberRow {
  NativeRouteMemberRow {
    identity: test_identity(module: module, declaration: declaration),
    verdict: NativeTestReturnedFalse
  }
}

// A SUPPLIED REFUSAL FOR THE AUTHORITY'S CLAUSES. These claims discriminate the admission
// authority over supplied rows (DESIGN section 3: the boundary is the clause, its inputs are
// values); the located diagnostics a real route carries are exercised by the inhabitance
// claims in v2.test.claim.native_route.native_refusal_detail_test, so here the locus is the
// supplied-input port and only the stage and the fatal reason are the claim's subject.
fn refused_verdict(stage: NativeTestStage, reason: Symbol) -> NativeTestVerdict {
  native_test_refused_located(
    stage: stage,
    reason: reason,
    at: invariant_port_locus(port: ^v2_native_route_test_supplied_verdict, invariant: reason)
  )
}

fn refused_row(
  module: String,
  declaration: String,
  stage: NativeTestStage,
  reason: Symbol
) -> NativeRouteMemberRow {
  NativeRouteMemberRow {
    identity: test_identity(module: module, declaration: declaration),
    verdict: refused_verdict(stage: stage, reason: reason)
  }
}

// A refusal whose chain heads with `head` and ends at `fatal`; one link when they are the same.
fn file_refusal_row(path: Symbol, head: Symbol, fatal: Symbol) -> NativeTestFileRefusal {
  NativeTestFileRefusal {
    path: path,
    module: optional_absent(),
    chain: FreeSemigroup {
      head: FileRefusalLink { reason: head, at: FileRefusalAtWholeFile },
      tail: if head == fatal { [] } else { [FileRefusalLink { reason: fatal, at: FileRefusalAtWholeFile }] }
    }
  }
}

// The emitted build as the lane records it on a clean run: cargo's argv, the denial set by the
// lane (read from the same row admission compares against, so the fixture cannot drift from the
// authority), rustc's identity, status 0, no warning header.
fn clean_emitted_build() -> NativeRouteEmittedBuild {
  NativeRouteEmittedBuild {
    cargo_argv: ["cargo", "build", "--release", "--manifest-path", "/emitted/Cargo.toml"],
    rustflags: repo_self_warning_denial_rustflags(),
    compiler_path: "/toolchain/bin/rustc",
    rustc_identity: "rustc 1.93.0 (254b59607 2026-01-19); host: aarch64-unknown-linux-gnu",
    exit_status: 0,
    warning_count: 0
  }
}

fn emitted_build_with(rustflags: String, rustc_identity: String, exit_status: Int, warning_count: Int) -> NativeRouteEmittedBuild {
  NativeRouteEmittedBuild {
    cargo_argv: clean_emitted_build().cargo_argv,
    rustflags: rustflags,
    compiler_path: clean_emitted_build().compiler_path,
    rustc_identity: rustc_identity,
    exit_status: exit_status,
    warning_count: warning_count
  }
}

// A receipt with every well-formedness field recorded and both live controls observed; the
// universe, module-source index, population and file-refusal populations are the arguments
// under test.
fn receipt_over(
  universe: List<NativeRouteTestIdentity>,
  module_source_index: List<NativeRouteModuleSource>,
  population: List<NativeRouteMemberRow>,
  file_refusals: List<NativeTestFileRefusal>
) -> NativeRouteReceipt {
  NativeRouteReceipt {
    job: required_v2_native_job_name,
    tested_tree: "tree-sha",
    preparation_seed_identity: "seed-sha",
    emitted_closure_identity: "closure-sha",
    executable_path: "/emitted/compiler",
    executable_identity: "binary-sha",
    universe: universe,
    module_source_index: module_source_index,
    population: population,
    file_refusals: file_refusals,
    false_control: Present { value: NativeTestReturnedFalse },
    true_control: Present { value: NativeTestPassed },
    malformed_control: MalformedSpecimenRefused {
      path: "target/v2-native-lane/malformed-control-root/dag/gunbc/malformed_specimen.dag",
      reason: ^tokenize_lex_e1_unterminated_string
    },
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" },
    emitted_build: clean_emitted_build()
  }
}

// THE RATCHET'S ONE ROSTERED IDENTITY, AS A SYNTHETIC ROW. The required-pass roster is real
// authority data, so every synthetic receipt that aims at admission must carry the smoke
// member passing — the clause reads the roster, not the test's intent.
fn smoke_identity() -> NativeRouteTestIdentity {
  test_identity(
    module: "v2.test.native_lane_smoke",
    declaration: "native_route_positive_population_smoke"
  )
}

fn smoke_source_row() -> NativeRouteModuleSource {
  NativeRouteModuleSource {
    module: "v2.test.native_lane_smoke",
    path: ^src_v2_test_native_lane_smoke_test_dag
  }
}

// The smallest green receipt: one passing member beside the rostered smoke member, universe
// and population equal, and the module-source index covering both universe modules.
fn green_receipt() -> NativeRouteReceipt {
  receipt_over(
    universe: [
      test_identity(module: "v2.test.alpha", declaration: "passes"),
      smoke_identity()
    ],
    module_source_index: [
      NativeRouteModuleSource { module: "v2.test.alpha", path: ^alpha_path },
      smoke_source_row()
    ],
    population: [
      passed_row(module: "v2.test.alpha", declaration: "passes"),
      passed_row(
        module: "v2.test.native_lane_smoke",
        declaration: "native_route_positive_population_smoke"
      )
    ],
    file_refusals: []
  )
}

// ── the route boundary is the default pattern ────────────────────────────────────────────

// WHICH OPERANDS THE ROUTE OWNS is the default pattern's, decided by the one matcher at a segment edge.
// It is not what makes a declaration a test: a marked declaration in any module of the boundary is
// in, and the boundary says nothing about a module that holds no marker.
test fn the_route_boundary_is_the_v2_tree_and_nothing_else() -> Bool {
  native_route_universe_member(module_qn: "v2.test.v2_native_route")
  && native_route_universe_member(module_qn: "v2.compiler.compile")
  && native_route_universe_member(module_qn: "v2.testing.y")
  && native_route_universe_member(module_qn: "v2")
  && !native_route_universe_member(module_qn: "v22.x")
  && !native_route_universe_member(module_qn: "test.claim.native_route_seed_boundary_witness")
  && !native_route_universe_member(module_qn: "gunbc.witness.v2_native_route")
}

// A module name whose label cannot be formed is outside the boundary: the boundary is claimed of a
// label or not at all, so an unformable name never reads as inside.
test fn a_module_name_that_forms_no_label_is_outside_the_boundary() -> Bool {
  !native_route_universe_member(module_qn: "v2..x")
  && !native_route_identity_in_boundary(identity: test_identity(module: "v2.compiler", declaration: ""))
}

// ── a target pattern selects through the cited matcher ──

// An identity's label, admitted by the one matcher, from the pattern's TEXT: the same parse an
// operator's argument takes. A pattern that fails to parse or an identity whose label refuses is
// `false` here, and each arm below also asserts the positive side, so neither refusal can hold one
// of these arms green.
fn pattern_admits(text: String, module_qn: String, declaration: String) -> Bool {
  match parse_target_pattern(text: text) {
    TargetPatternRefused { cause: _ } => false
    TargetPatternParsed { pattern: pattern } =>
      match native_route_identity_label(module_qn: module_qn, declaration: declaration) {
        LabelRefused { cause: _ } => false
        LabelParsed { label: label } => target_pattern_matches(pattern: pattern, target: label)
      }
  }
}

// THE LAW THAT KEEPS THE DEFAULT HONEST: it narrows nothing. Every module the route owns -- under
// `v2.test` or beside it -- has its label admitted by the default pattern, so the lane at its default
// runs every marked declaration of the tree. A default that stopped at `v2.test` would be the
// location predicate again, dropping marked tests that live elsewhere in `v2`.
fn default_admits(module_qn: String) -> Bool {
  match native_route_identity_label(module_qn: module_qn, declaration: native_route_module_probe_declaration) {
    LabelRefused { cause: _ } => false
    LabelParsed { label: label } =>
      target_pattern_matches(pattern: native_route_default_pattern(), target: label)
  }
}

test fn the_default_pattern_admits_every_universe_member() -> Bool {
  default_admits(module_qn: "v2.test.v2_native_route")
  && default_admits(module_qn: "v2.test.claim.parse.alias_decl_parse")
  && default_admits(module_qn: "v2.compiler.compile")
  && default_admits(module_qn: "v2.testing.y")
  && default_admits(module_qn: "v2.test")
  && !default_admits(module_qn: "v22.x")
  && !default_admits(module_qn: "test.claim.y")
}

// THE CORRESPONDENCE IS THE ONE FACT THIS MODULE OWNS: namespace segments are package segments and
// the declaration is the target name.
test fn an_identity_label_is_its_namespace_as_a_package() -> Bool {
  match native_route_identity_label(module_qn: "v2.test.claim.parse", declaration: "a_parse_holds") {
    LabelRefused { cause: _ } => false
    LabelParsed { label: label } =>
      render_label(l: label) == "//v2/test/claim/parse:a_parse_holds"
  }
}

// `//v2/test/...` reaches a module nested below it and not `v2.testing.*`: the boundary is a
// segment edge, never a character position.
test fn a_subtree_pattern_stops_at_the_namespace_edge() -> Bool {
  pattern_admits(text: "//v2/test/...", module_qn: "v2.test.claim.parse.alias_decl_parse", declaration: "d")
  && !pattern_admits(text: "//v2/test/...", module_qn: "v2.testing.y", declaration: "d")
}

test fn the_root_subtree_pattern_selects_every_module() -> Bool {
  pattern_admits(text: "//...", module_qn: "anything.at.all", declaration: "d")
}

// `//v2/test/claim/parse:all` selects that module and not the ones nested beneath it.
test fn a_package_pattern_selects_one_module_and_not_its_subtree() -> Bool {
  pattern_admits(text: "//v2/test/claim/parse:all", module_qn: "v2.test.claim.parse", declaration: "d")
  && !pattern_admits(text: "//v2/test/claim/parse:all", module_qn: "v2.test.claim.parse.alias_decl_parse", declaration: "d")
}

// The single-target form is the only one that reads the declaration.
test fn a_single_target_pattern_selects_one_declaration() -> Bool {
  pattern_admits(text: "//v2/test/claim/parse:a_parse_holds", module_qn: "v2.test.claim.parse", declaration: "a_parse_holds")
  && !pattern_admits(
    text: "//v2/test/claim/parse:a_parse_holds",
    module_qn: "v2.test.claim.parse",
    declaration: "a_different_declaration"
  )
}

test fn identity_qualification_derives_the_dotted_spelling() -> Bool {
  native_route_identity_qualified(
    identity: test_identity(module: "v2.test.alpha", declaration: "passes")
  ) == "v2.test.alpha.passes"
}

test fn duplicate_identities_are_detected_at_identity_grain() -> Bool {
  let dup = test_identity(module: "v2.test.alpha", declaration: "passes")
  !native_route_identities_unique(xs: [
    dup,
    test_identity(module: "v2.test.beta", declaration: "passes"),
    dup
  ])
  && native_route_identities_unique(xs: [
    test_identity(module: "v2.test.alpha", declaration: "passes"),
    test_identity(module: "v2.test.alpha", declaration: "fails"),
    test_identity(module: "v2.test.beta", declaration: "passes")
  ])
}

// ── the reference is the floor's rosters joined at the identity ────────────────────────────

test fn the_reference_is_the_floor_rosters_joined_at_the_identity() -> Bool {
  match native_route_reference_for(qualified: "v2.test.alpha.red", expected_red: ["v2.test.alpha.red"], route_gap: []) {
    FloorExpectedRed => true
    FloorExpectedPass => false
    FloorRouteGapRefusal => false
  }
}

test fn the_reference_defaults_to_the_floors_standing_expectation() -> Bool {
  match native_route_reference_for(qualified: "v2.test.alpha.green", expected_red: [], route_gap: []) {
    FloorExpectedPass => true
    FloorExpectedRed => false
    FloorRouteGapRefusal => false
  }
}

test fn route_gap_membership_wins_over_expected_red() -> Bool {
  match native_route_reference_for(
    qualified: "v2.test.alpha.gapped",
    expected_red: ["v2.test.alpha.gapped"],
    route_gap: ["v2.test.alpha.gapped"]
  ) {
    FloorRouteGapRefusal => true
    FloorExpectedPass => false
    FloorExpectedRed => false
  }
}

// ── classification is stage- and provenance-keyed ──────────────────────────────────────────

test fn an_entry_stage_refusal_is_a_driver_limit_only_at_a_known_reason() -> Bool {
  match classify_native_refusal(stage: NativeTestStageEntry, reason: ^native_test_entry_declaration_not_arrow) {
    NativeEntryResolutionLimit { reason: r } => r == ^native_test_entry_declaration_not_arrow
    CompilerFrontierAttributed { reason: _ } => false
    NativeEvalBoundary { reason: _ } => false
    UnattributedRefusal { reason: _ } => false
  }
  && match classify_native_refusal(stage: NativeTestStageEntry, reason: ^parse_g0_tokens_remain) {
    NativeEntryResolutionLimit { reason: _ } => false
    CompilerFrontierAttributed { reason: _ } => false
    NativeEvalBoundary { reason: _ } => false
    UnattributedRefusal { reason: r } => r == ^parse_g0_tokens_remain
  }
}

test fn an_eval_stage_refusal_is_the_boundary_only_at_a_boundary_reason() -> Bool {
  match classify_native_refusal(stage: NativeTestStageEval, reason: ^eval_rejected_effect_io_unbound) {
    NativeEvalBoundary { reason: r } => r == ^eval_rejected_effect_io_unbound
    CompilerFrontierAttributed { reason: _ } => false
    NativeEntryResolutionLimit { reason: _ } => false
    UnattributedRefusal { reason: _ } => false
  }
  && match classify_native_refusal(stage: NativeTestStageEval, reason: ^eval_some_unowned_reason) {
    NativeEvalBoundary { reason: _ } => false
    CompilerFrontierAttributed { reason: _ } => false
    NativeEntryResolutionLimit { reason: _ } => false
    UnattributedRefusal { reason: r } => r == ^eval_some_unowned_reason
  }
}

test fn a_context_stage_refusal_is_frontier_attributed_only_when_the_ledger_owns_it() -> Bool {
  match classify_native_refusal(stage: NativeTestStageContext, reason: ^parse_g0_tokens_remain) {
    CompilerFrontierAttributed { reason: r } => r == ^parse_g0_tokens_remain
    NativeEntryResolutionLimit { reason: _ } => false
    NativeEvalBoundary { reason: _ } => false
    UnattributedRefusal { reason: _ } => false
  }
  && match classify_native_refusal(stage: NativeTestStageContext, reason: ^some_unowned_cause) {
    CompilerFrontierAttributed { reason: _ } => false
    NativeEntryResolutionLimit { reason: _ } => false
    NativeEvalBoundary { reason: _ } => false
    UnattributedRefusal { reason: r } => r == ^some_unowned_cause
  }
}

test fn a_prepare_stage_refusal_is_frontier_attributed_only_when_the_ledger_owns_it() -> Bool {
  match classify_native_refusal(stage: NativeTestStagePrepare, reason: ^parse_g0_tokens_remain) {
    CompilerFrontierAttributed { reason: r } => r == ^parse_g0_tokens_remain
    NativeEntryResolutionLimit { reason: _ } => false
    NativeEvalBoundary { reason: _ } => false
    UnattributedRefusal { reason: _ } => false
  }
  && match classify_native_refusal(stage: NativeTestStagePrepare, reason: ^some_unowned_cause) {
    CompilerFrontierAttributed { reason: _ } => false
    NativeEntryResolutionLimit { reason: _ } => false
    NativeEvalBoundary { reason: _ } => false
    UnattributedRefusal { reason: r } => r == ^some_unowned_cause
  }
}

// ── the disposition matrix ─────────────────────────────────────────────────────────────────

test fn a_pass_agrees_with_the_standing_expectation() -> Bool {
  match native_route_disposition(verdict: NativeTestPassed, reference: FloorExpectedPass) {
    NativeAgreementPass => true
    NativeAgreementExpectedRed => false
    NativeAgreementRouteGap => false
    NativeExclusion { cause: _ } => false
    NativeDivergence { cause: _ } => false
  }
}

test fn a_pass_against_an_expected_red_identity_is_a_divergence() -> Bool {
  match native_route_disposition(verdict: NativeTestPassed, reference: FloorExpectedRed) {
    NativeDivergence { cause: c } =>
      match c {
        NativePassedExpectedRed => true
        NativeFalseExpectedPass => false
        NativeReturnedOtherVerdict => false
        NativeReachedRouteGap => false
      }
    NativeAgreementPass => false
    NativeAgreementExpectedRed => false
    NativeAgreementRouteGap => false
    NativeExclusion { cause: _ } => false
  }
}

test fn a_false_against_an_expected_red_identity_is_the_expected_red_observed() -> Bool {
  match native_route_disposition(verdict: NativeTestReturnedFalse, reference: FloorExpectedRed) {
    NativeAgreementExpectedRed => true
    NativeAgreementPass => false
    NativeAgreementRouteGap => false
    NativeExclusion { cause: _ } => false
    NativeDivergence { cause: _ } => false
  }
}

test fn a_false_against_the_standing_expectation_is_a_divergence() -> Bool {
  match native_route_disposition(verdict: NativeTestReturnedFalse, reference: FloorExpectedPass) {
    NativeDivergence { cause: c } =>
      match c {
        NativeFalseExpectedPass => true
        NativePassedExpectedRed => false
        NativeReturnedOtherVerdict => false
        NativeReachedRouteGap => false
      }
    NativeAgreementPass => false
    NativeAgreementExpectedRed => false
    NativeAgreementRouteGap => false
    NativeExclusion { cause: _ } => false
  }
}

test fn a_non_boolean_return_is_a_divergence_on_every_reference() -> Bool {
  match native_route_disposition(verdict: NativeTestReturnedOther, reference: FloorExpectedPass) {
    NativeDivergence { cause: NativeReturnedOtherVerdict } => true
    _ => false
  }
  && match native_route_disposition(verdict: NativeTestReturnedOther, reference: FloorExpectedRed) {
    NativeDivergence { cause: NativeReturnedOtherVerdict } => true
    _ => false
  }
  && match native_route_disposition(verdict: NativeTestReturnedOther, reference: FloorRouteGapRefusal) {
    NativeDivergence { cause: NativeReturnedOtherVerdict } => true
    _ => false
  }
}

test fn a_reached_verdict_on_a_route_gap_identity_is_a_divergence() -> Bool {
  match native_route_disposition(verdict: NativeTestPassed, reference: FloorRouteGapRefusal) {
    NativeDivergence { cause: NativeReachedRouteGap } => true
    _ => false
  }
  && match native_route_disposition(verdict: NativeTestReturnedFalse, reference: FloorRouteGapRefusal) {
    NativeDivergence { cause: NativeReachedRouteGap } => true
    _ => false
  }
}

test fn the_route_gap_agrees_only_with_the_hermetic_boundary_refusal() -> Bool {
  match native_route_disposition(
    verdict: refused_verdict(stage: NativeTestStageEval, reason: ^eval_rejected_effect_io_unbound),
    reference: FloorRouteGapRefusal
  ) {
    NativeAgreementRouteGap => true
    _ => false
  }
}

test fn a_route_gap_refusal_off_the_boundary_is_an_exclusion() -> Bool {
  match native_route_disposition(
    verdict: refused_verdict(stage: NativeTestStageEval, reason: ^some_unowned_cause),
    reference: FloorRouteGapRefusal
  ) {
    NativeExclusion { cause: UnattributedRefusal { reason: r } } => r == ^some_unowned_cause
    _ => false
  }
  && match native_route_disposition(
    verdict: refused_verdict(stage: NativeTestStagePrepare, reason: ^parse_g0_tokens_remain),
    reference: FloorRouteGapRefusal
  ) {
    NativeExclusion { cause: CompilerFrontierAttributed { reason: r } } => r == ^parse_g0_tokens_remain
    _ => false
  }
}

// ── the census ─────────────────────────────────────────────────────────────────────────────

test fn the_census_counts_every_disposition() -> Bool {
  let census = native_route_census(
    rows: [
      passed_row(module: "v2.test.a", declaration: "one"),
      false_row(module: "v2.test.b", declaration: "two"),
      refused_row(module: "v2.test.c", declaration: "three", stage: NativeTestStageEval, reason: ^eval_rejected_effect_io_unbound),
      refused_row(module: "v2.test.d", declaration: "four", stage: NativeTestStagePrepare, reason: ^parse_g0_tokens_remain),
      refused_row(module: "v2.test.e", declaration: "five", stage: NativeTestStageEntry, reason: ^native_test_entry_declaration_not_arrow),
      refused_row(module: "v2.test.f", declaration: "six", stage: NativeTestStageEval, reason: ^eval_rejected_effect_io_unbound),
      refused_row(module: "v2.test.g", declaration: "seven", stage: NativeTestStageContext, reason: ^some_unowned_cause),
      passed_row(module: "v2.test.h", declaration: "eight")
    ],
    expected_red: ["v2.test.b.two", "v2.test.h.eight"],
    route_gap: ["v2.test.c.three"]
  )
  census.agreement_pass == 1
  && census.agreement_expected_red == 1
  && census.agreement_route_gap == 1
  && census.excluded_compiler_frontier == 1
  && census.excluded_entry_limit == 1
  && census.excluded_eval_boundary == 1
  && census.excluded_unattributed == 1
  && census.divergences == 1
}

