// ── admission: file-refusal ownership at both grains ───────────────────────────────────────

test fn an_unattributed_file_refusal_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_over(
      universe: [test_identity(module: "v2.test.alpha", declaration: "passes")],
      module_source_index: [],
      population: [passed_row(module: "v2.test.alpha", declaration: "passes")],
      file_refusals: [file_refusal_row(
        path: ^some_path,
        head: ^tokenize_lex_e1_unrecognized_char,
        fatal: ^some_unowned_cause
      )]
    )),
    cause_name: "unattributed_file_refusals_present"
  )
}

// THE BODY-LOWERING FATAL CAUSES OF THE BROAD RUN AT main bd2c586926b9 ARE OWNED. Supplied rows
// in the receipt's shape (DESIGN section 3, a witness discriminates at one interface): one file
// refusal per cause the run measured unowned, and the file-refusal clause holds over them. The
// paired control keeps the clause discriminating -- the same receipt plus one row whose fatal
// cause has no ownership row still fails it, so the owned rows did not become a catch-all.
fn body_lowering_frontier_refusals() -> List<NativeTestFileRefusal> {
  [
    file_refusal_row(path: ^bl_a, head: ^tokenize_lex_e1_unrecognized_char, fatal: ^body_lowering_reason_call_argument_unread),
    file_refusal_row(path: ^bl_b, head: ^tokenize_lex_e1_unrecognized_char, fatal: ^body_lowering_reason_operator_operand_unread),
    file_refusal_row(path: ^bl_c, head: ^tokenize_lex_e1_unrecognized_char, fatal: ^body_lowering_reason_type_annotation_not_carried),
    file_refusal_row(path: ^bl_d, head: ^tokenize_lex_e1_unrecognized_char, fatal: ^body_lowering_reason_paren_group_unread)
  ]
}

test fn the_body_lowering_frontier_causes_are_owned_at_fatal_grain() -> Bool {
  native_route_file_refusals_attributed(receipt: receipt_over(
    universe: [],
    module_source_index: [],
    population: [],
    file_refusals: body_lowering_frontier_refusals()
  ))
    && match classify_native_refusal(stage: NativeTestStageContext, reason: ^body_lowering_reason_call_argument_unread) {
      CompilerFrontierAttributed { reason: _ } => true
      NativeEntryResolutionLimit { reason: _ } => false
      NativeEvalBoundary { reason: _ } => false
      UnattributedRefusal { reason: _ } => false
    }
}

test fn an_unknown_fatal_cause_beside_the_owned_ones_still_refuses_unowned() -> Bool {
  !native_route_file_refusals_attributed(receipt: receipt_over(
    universe: [],
    module_source_index: [],
    population: [],
    file_refusals: Cons {
      head: file_refusal_row(path: ^bl_e, head: ^tokenize_lex_e1_unrecognized_char, fatal: ^some_unowned_cause),
      tail: body_lowering_frontier_refusals()
    }
  ))
}

// THE PREPARE-STAGE INFER CAUSE OF THE RUN AT main 55e78f40e9a IS OWNED. That run refused its own
// admission on unattributed_exclusions_present with exactly six exclusions, every one a PREPARE
// refusal whose fatal cause was infer_match_scrutinee_not_bool (all in
// v2.test.claim.determinism_contract). Supplied member rows in that shape: the owned cause
// lands on the compiler-frontier count, and the paired unowned row beside it still lands on the
// unattributed count, so the new row did not turn the census into a catch-all.
test fn the_infer_match_scrutinee_cause_is_owned_and_an_unowned_one_still_counts() -> Bool {
  let census = native_route_census(
    rows: [
      refused_row(module: "v2.test.a", declaration: "one", stage: NativeTestStagePrepare, reason: ^infer_match_scrutinee_not_bool),
      refused_row(module: "v2.test.b", declaration: "two", stage: NativeTestStagePrepare, reason: ^some_unowned_cause)
    ],
    expected_red: [],
    route_gap: []
  )
  census.excluded_compiler_frontier == 1 && census.excluded_unattributed == 1
}

// ── admission: context refusals are bound to their observation ─────────────────────────────

test fn a_context_refusal_without_its_file_refusal_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_over(
      universe: [
        test_identity(module: "v2.test.alpha", declaration: "passes"),
        test_identity(module: "v2.test.beta", declaration: "blocked")
      ],
      module_source_index: [
        NativeRouteModuleSource { module: "v2.test.beta", path: ^beta_path }
      ],
      population: [
        passed_row(module: "v2.test.alpha", declaration: "passes"),
        refused_row(
          module: "v2.test.beta",
          declaration: "blocked",
          stage: NativeTestStageContext,
          reason: ^parse_g0_tokens_remain
        )
      ],
      file_refusals: []
    )),
    cause_name: "context_refusals_unbacked"
  )
}

// THE REASON-ONLY JOIN IS THE HOLE THIS CLAUSE CLOSED. The file refusal below carries the
// Context row's exact fatal reason, but at ANOTHER MODULE'S path — under the pre-repair clause
// (any file anywhere with the reason) this receipt was admitted.
test fn a_context_refusal_backed_by_another_modules_file_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_over(
      universe: [
        test_identity(module: "v2.test.alpha", declaration: "passes"),
        test_identity(module: "v2.test.beta", declaration: "blocked")
      ],
      module_source_index: [
        NativeRouteModuleSource { module: "v2.test.alpha", path: ^alpha_path },
        NativeRouteModuleSource { module: "v2.test.beta", path: ^beta_path }
      ],
      population: [
        passed_row(module: "v2.test.alpha", declaration: "passes"),
        refused_row(
          module: "v2.test.beta",
          declaration: "blocked",
          stage: NativeTestStageContext,
          reason: ^parse_g0_tokens_remain
        )
      ],
      file_refusals: [file_refusal_row(
        path: ^alpha_path,
        head: ^tokenize_lex_e1_unrecognized_char,
        fatal: ^parse_g0_tokens_remain
      )]
    )),
    cause_name: "context_refusals_unbacked"
  )
}

// THE PATH WITHOUT THE REASON IS ALSO NOT THE OBSERVATION: the row's module resolves to the
// refusal's path, but the file refused for a different cause than the row carries.
test fn a_context_refusal_at_its_own_path_with_the_wrong_reason_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_over(
      universe: [
        test_identity(module: "v2.test.alpha", declaration: "passes"),
        test_identity(module: "v2.test.beta", declaration: "blocked")
      ],
      module_source_index: [
        NativeRouteModuleSource { module: "v2.test.beta", path: ^beta_path }
      ],
      population: [
        passed_row(module: "v2.test.alpha", declaration: "passes"),
        refused_row(
          module: "v2.test.beta",
          declaration: "blocked",
          stage: NativeTestStageContext,
          reason: ^parse_g0_tokens_remain
        )
      ],
      file_refusals: [file_refusal_row(
        path: ^beta_path,
        head: ^tokenize_lex_e1_unrecognized_char,
        fatal: ^resolve_module_not_found
      )]
    )),
    cause_name: "context_refusals_unbacked"
  )
}

test fn a_context_refusal_backed_by_its_file_refusal_is_not_refused_on_that_clause() -> Bool {
  let admission = native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_over(
    universe: [
      test_identity(module: "v2.test.alpha", declaration: "passes"),
      test_identity(module: "v2.test.beta", declaration: "blocked"),
      smoke_identity()
    ],
    module_source_index: [
      NativeRouteModuleSource { module: "v2.test.alpha", path: ^alpha_path },
      NativeRouteModuleSource { module: "v2.test.beta", path: ^beta_path },
      smoke_source_row()
    ],
    population: [
      passed_row(module: "v2.test.alpha", declaration: "passes"),
      refused_row(
        module: "v2.test.beta",
        declaration: "blocked",
        stage: NativeTestStageContext,
        reason: ^parse_g0_tokens_remain
      ),
      passed_row(
        module: "v2.test.native_lane_smoke",
        declaration: "native_route_positive_population_smoke"
      )
    ],
    file_refusals: [file_refusal_row(
      path: ^beta_path,
      head: ^tokenize_lex_e1_unrecognized_char,
      fatal: ^parse_g0_tokens_remain
    )]
  ))
  !native_route_admission_refused_with(admission: admission, cause_name: "context_refusals_unbacked")
  && native_route_admitted(admission: admission)
}

// ── admission: the controls ────────────────────────────────────────────────────────────────

test fn a_missing_false_control_is_refused() -> Bool {
  let base = green_receipt()
  let receipt = NativeRouteReceipt {
    job: base.job,
    tested_tree: base.tested_tree,
    preparation_seed_identity: base.preparation_seed_identity,
    emitted_closure_identity: base.emitted_closure_identity,
    executable_path: base.executable_path,
    executable_identity: base.executable_identity,
    universe: base.universe,
    module_source_index: base.module_source_index,
    population: base.population,
    file_refusals: base.file_refusals,
    false_control: Absent,
    true_control: base.true_control,
    malformed_control: base.malformed_control,
    old_route_control: base.old_route_control,
    emitted_build: base.emitted_build
  }
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt),
    cause_name: "false_control_not_observed"
  )
}

