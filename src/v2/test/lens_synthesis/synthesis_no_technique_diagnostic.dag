module v2.test.lens_synthesis.synthesis_no_technique_diagnostic

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.synthesis { AlgebraicRank, synthesis_lens_diagnostics }
import std.algebra { non_empty }
import v2.std.node {
  Atom,
  Instantiation,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Transform,
  TypeNode,
  NotADeclaration
}

data synthesis_no_tech_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_no_tech_atom_symbol } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data synthesis_no_tech_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: synthesis_no_tech_leaf, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

data synthesis_no_tech_inner: Node = Node {
  kind: TypeNode { connective: Instantiation },
  children: [
    Edge { label: Positional, target: synthesis_no_tech_body, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

data synthesis_no_tech_input: Node = Node {
  kind: TypeNode { connective: Instantiation },
  children: [
    Edge { label: Positional, target: synthesis_no_tech_inner, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn synthesis_no_tech_diagnostics_non_empty() -> Bool {
  non_empty(synthesis_lens_diagnostics(n: synthesis_no_tech_input, declared_technique: AlgebraicRank))
}
