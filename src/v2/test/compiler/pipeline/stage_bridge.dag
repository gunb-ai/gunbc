module v2.test.compiler.pipeline.stage_bridge


fn pipeline_find_arrow_in_module(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } => v2.std.optional.Present { value: root }
    _ =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => pipeline_find_arrow_in_module(root: e.target)
        }
      })
  }
}

fn pipeline_arrow_body_has_behavior(root: v2.std.node.Node, wanted: v2.std.node.Behavior) -> Bool {
  match pipeline_find_arrow_in_module(root: root) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: arrow } =>
      match v2.std.node_query.find_arrow_body_child(root: arrow) {
        v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
          match body.kind {
            v2.std.node.ComputationNode { behavior: b } => b == wanted
            _ => false
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

fn pipeline_token_stream_has_lexeme(stream: v2.std.compilers.lexing.TokenStream, lexeme: String) -> Bool {
  fold(
    v2.std.compilers.lexing.token_stream_all(stream: stream),
    init: false,
    f: fn(found, t) {
      if found { true } else { t.lexeme == lexeme }
    }
  )
}

fn pipeline_tokenize_source(source: String, file: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.TokenStream> {
  let lm = v2.extdeps.languages.dag.dag_language_model()
  v2.compiler.tokenize.tokenize(text: source, file: file, rules: lm.lex)
}

fn pipeline_parse_tree_from_tokens(tokens: v2.std.compilers.lexing.TokenStream) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.compiler.parse.parse_module(tokens: tokens, grammar: v2.extdeps.languages.dag.dag_language_model().grammar) {
    v2.std.diagnostic.Accepted { value: artifact, diagnostics: d } =>
      outcome_with_diagnostics(value: artifact.tree, diagnostics: d)
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn pipeline_parse_source(source: String, file: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: pipeline_tokenize_source(source: source, file: file),
    f: fn(tokens) {
      pipeline_parse_tree_from_tokens(tokens: tokens)
    }
  )
}

fn pipeline_normalize_source(source: String, file: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.compiler.normalized_tree.NormalizedTree> {
  v2.std.diagnostic.bind_outcome(
    o: pipeline_parse_source(source: source, file: file),
    f: fn(parse_tree) {
      v2.compiler.normalize.normalize(parse_tree: parse_tree)
    }
  )
}

fn pipeline_resolved_source(source: String, file: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: pipeline_normalize_source(source: source, file: file),
    f: fn(normalized) {
      v2.compiler.resolve.resolve(tree: normalized, lm: v2.extdeps.languages.dag.dag_language_model())
    }
  )
}

fn pipeline_inferred_arrow_from_resolved(resolved: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match pipeline_find_arrow_in_module(root: resolved) {
    v2.std.optional.Present { value: arrow } => v2.compiler.infer.infer(tree: arrow)
    v2.std.optional.Absent => v2.compiler.infer.infer(tree: resolved)
  }
}

fn pipeline_inferred_source(source: String, file: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  v2.std.diagnostic.bind_outcome(
    o: pipeline_resolved_source(source: source, file: file),
    f: fn(resolved) {
      pipeline_inferred_arrow_from_resolved(resolved: resolved)
    }
  )
}

fn pipeline_outcome_is_accepted(o: v2.std.diagnostic.Outcome<v2.std.node.Node>) -> Bool {
  match o {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_inferred_outcome_is_accepted(o: v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree>) -> Bool {
  match o {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_pick_deep_unwrap(node: v2.std.node.Node) -> v2.std.node.Node {
  match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
    v2.std.optional.Present { value: captured } => pipeline_pick_deep_unwrap(node: captured)
    v2.std.optional.Absent =>
      match v2.std.node_query.find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
        v2.std.diagnostic.Accepted { value: child, diagnostics: _ } => pipeline_pick_deep_unwrap(node: child)
        v2.std.diagnostic.Rejected { diagnostics: _ } => node
      }
  }
}

fn pipeline_pick_int_literal_in_node_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let unwrapped = pipeline_pick_deep_unwrap(node: node)
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: unwrapped) {
    v2.std.optional.optional_present(value: unwrapped)
  } else {
    fold(unwrapped.children, init: v2.std.optional.Absent, f: fn(acc, e) {
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent => pipeline_pick_int_literal_in_node_optional(node: e.target)
      }
    })
  }
}

fn pipeline_int_literal_has_magnitude_child_holds(literal: v2.std.node.Node) -> Bool {
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: literal) {
    fold(literal.children, init: false, f: fn(_acc, _edge) { true })
  } else {
    false
  }
}

fn pipeline_branch_arm_int_literal_has_magnitude_child_holds(body: v2.std.node.Node, arm_index: Int) -> Bool {
  match v2.std.collection.list_at_optional(xs: body.children, index: arm_index) {
    v2.std.optional.Present { value: edge } =>
      match edge {
        v2.std.node.Edge { label: _, target: arm } =>
          match pipeline_pick_int_literal_in_node_optional(node: arm) {
            v2.std.optional.Present { value: literal } =>
              pipeline_int_literal_has_magnitude_child_holds(literal: literal)
            v2.std.optional.Absent => false
          }
      }
    v2.std.optional.Absent => false
  }
}

fn pipeline_normalize_pick_then_arm_magnitude_relationship_holds() -> Bool {
  match pipeline_normalize_source(
    source: v2.test.compiler.pipeline.corpus.pipeline_corpus_pick_source,
    file: ^pipeline_corpus_pick_file
  ) {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match pipeline_find_arrow_in_module(root: tree.root) {
        v2.std.optional.Present { value: arrow } =>
          match v2.std.node_query.find_arrow_body_child(root: arrow) {
            v2.std.diagnostic.Accepted { value: body, diagnostics: _ } =>
              pipeline_branch_arm_int_literal_has_magnitude_child_holds(
                body: body,
                arm_index: 1
              )
            v2.std.diagnostic.Rejected { diagnostics: _ } => false
          }
        v2.std.optional.Absent => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_tokenize_add_relationship_holds() -> Bool {
  match pipeline_tokenize_source(
    source: v2.test.compiler.pipeline.corpus.pipeline_corpus_add_source,
    file: ^pipeline_corpus_add_file
  ) {
    v2.std.diagnostic.Accepted { value: stream, diagnostics: _ } =>
      pipeline_token_stream_has_lexeme(stream: stream, lexeme: "fn")
        && pipeline_token_stream_has_lexeme(stream: stream, lexeme: "add")
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_tokenize_pick_relationship_holds() -> Bool {
  match pipeline_tokenize_source(
    source: v2.test.compiler.pipeline.corpus.pipeline_corpus_pick_source,
    file: ^pipeline_corpus_pick_file
  ) {
    v2.std.diagnostic.Accepted { value: stream, diagnostics: _ } =>
      pipeline_token_stream_has_lexeme(stream: stream, lexeme: "fn")
        && pipeline_token_stream_has_lexeme(stream: stream, lexeme: "if")
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_parse_add_relationship_holds() -> Bool {
  match pipeline_parse_source(
    source: v2.test.compiler.pipeline.corpus.pipeline_corpus_add_source,
    file: ^pipeline_corpus_add_file
  ) {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } => v2.std.node.well_formed(n: tree)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_normalize_add_relationship_holds() -> Bool {
  match pipeline_normalize_source(
    source: v2.test.compiler.pipeline.corpus.pipeline_corpus_add_source,
    file: ^pipeline_corpus_add_file
  ) {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      pipeline_arrow_body_has_behavior(root: tree.root, wanted: v2.std.node.Transform)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_infer_add_fixture_relationship_holds() -> Bool {
  pipeline_inferred_outcome_is_accepted(o: v2.compiler.infer.infer(tree: v2.test.manual.infer_ground_add.fixture_add_resolved_tree()))
}

fn pipeline_lower_add_fixture_relationship_holds() -> Bool {
  match v2.compiler.translate.translate(tree: v2.test.manual.rust_add_emit_translate.rust_add_inferred_tree, target: v2.extdeps.languages.rust.rust_target_model()) {
    v2.std.diagnostic.Accepted { value: emitted, diagnostics: _ } => v2.std.node.well_formed(n: emitted)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_match_corpus_normalize_relationship_holds() -> Bool {
  match pipeline_normalize_source(
    source: v2.test.compiler.pipeline.corpus.pipeline_corpus_match_source,
    file: ^pipeline_corpus_match_file
  ) {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      pipeline_arrow_body_has_behavior(root: tree.root, wanted: v2.std.node.Match)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_match_corpus_resolve_relationship_holds() -> Bool {
  match pipeline_resolved_source(
    source: v2.test.compiler.pipeline.corpus.pipeline_corpus_match_source,
    file: ^pipeline_corpus_match_file
  ) {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      pipeline_arrow_body_has_behavior(root: tree, wanted: v2.std.node.Match)
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn pipeline_match_corpus_infer_relationship_holds() -> Bool {
  pipeline_inferred_outcome_is_accepted(
    o: pipeline_inferred_source(
      source: v2.test.compiler.pipeline.corpus.pipeline_corpus_match_source,
      file: ^pipeline_corpus_match_file
    )
  )
}

fn pipeline_match_corpus_lower_relationship_holds() -> Bool {
  match pipeline_inferred_source(
    source: v2.test.compiler.pipeline.corpus.pipeline_corpus_match_source,
    file: ^pipeline_corpus_match_file
  ) {
    v2.std.diagnostic.Accepted { value: tree, diagnostics: _ } =>
      match v2.compiler.translate.translate(tree: tree, target: v2.extdeps.languages.rust.rust_target_model()) {
        v2.std.diagnostic.Accepted { value: emitted, diagnostics: _ } => v2.std.node.well_formed(n: emitted)
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}
