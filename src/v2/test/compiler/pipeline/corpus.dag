module v2.test.compiler.pipeline.corpus


data pipeline_corpus_note: String = "Fn-body corpus for per-stage relationship witnesses (CI-visible under src/v2/test/compiler/pipeline/). Fast-lane: tokenize add+pick, infer/lower add fixtures. Full-pipeline parse/normalize (add + pick magnitude RED) live in src/v2/test/claim/long/pipeline_stage_add_pick_relationship_witness_test.dag. Match corpus in src/v2/test/claim/long/pipeline_stage_match_corpus_witness_test.dag."

data pipeline_corpus_add_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

data pipeline_corpus_pick_source: String = "module pick_probe\n\nfn pick(b: Bool) -> Int { if b { 1 } else { 2 } }\n"

data pipeline_corpus_match_source: String = "module match_probe\n\nfn classical_not(x: Int) -> Int {\n  match x {\n    true => false,\n    false => true\n  }\n}\n"
