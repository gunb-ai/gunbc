module v2.test.compiler.pipeline.lower_stage

import v2.compiler.translate { translate }
import v2.extdeps.languages.rust { rust_target_model }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node { well_formed }
import v2.test.manual.rust_add_emit_translate { rust_add_inferred_tree }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Relationship witness: InferredTree -> emitted Node on rust_target_model via translate. Fast-lane:
// canonical rust_add_inferred_tree fixture. Match corpus lower lives in long lane.

test fn pipeline_lower_add_fixture_relationship_green() -> Bool {
  match translate(tree: rust_add_inferred_tree, target: rust_target_model()) {
    Accepted { value: emitted, diagnostics: _ } => well_formed(n: emitted)
    Rejected { diagnostics: _ } => false
  }
}
