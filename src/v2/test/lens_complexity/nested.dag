module v2.test.lens_complexity.nested

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.complexity {
  ComplexityBound,
  ComplexityAssessment,
  composite_complexity_variables,
  complexity_lens,
  established_complexity,
  multidimensional_polynomial_complexity,
  single_complexity_variable
}
import v2.lens.cost {
  LinearCost,
  PolynomialDegree,
  ProductCost,
  SizeVariable,
  SymbolicCost,
  cost_lens
}
import v2.std.cardinality { NonZeroNat }
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v2.std.node {
  Atom,
  Loop,
  LoopBoundEdge,
  core_edge_label,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  NotADeclaration,
  NodeOccurrence
}
import std.nat { Zero }
import v2.std.witness { Holds, Violates, Witness }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
type LensComplexityClaim {
  input: Node
  expected_cost: SymbolicCost
  expected_complexity: ComplexityBound
  falsification: Diagnostic
}
data nested_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^nested_body_atom } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data nested_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: nested_body_leaf, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

data nested_inner_measure: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^nested_inner_measure_atom } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data nested_inner: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: nested_body, declaration: NotADeclaration },
    Edge { label: core_edge_label(marker: LoopBoundEdge), target: nested_inner_measure, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

data nested_input_measure: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^nested_input_measure_atom } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data nested_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: nested_inner, declaration: NotADeclaration },
    Edge { label: core_edge_label(marker: LoopBoundEdge), target: nested_input_measure, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

data nested_claim: LensComplexityClaim = LensComplexityClaim {
  input: nested_input,
  expected_cost: ProductCost {
    lhs: LinearCost { variable: SizeVariable { source: NodeOccurrence { node: nested_input_measure } } },
    rhs: LinearCost { variable: SizeVariable { source: NodeOccurrence { node: nested_inner_measure } } }
  },
  expected_complexity: multidimensional_polynomial_complexity(
    variables: composite_complexity_variables(
      lhs: single_complexity_variable(size_var: SizeVariable { source: NodeOccurrence { node: nested_input_measure } }),
      rhs: single_complexity_variable(size_var: SizeVariable { source: NodeOccurrence { node: nested_inner_measure } })
    ),
    degree: PolynomialDegree { predecessor_after_linear: NonZeroNat { prev: Zero } }
  ),
  falsification: Diagnostic {
    reason: ^nested_claim_reason,
    at: Textual { file: ^nested_claim_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn nested_actual_cost() -> Witness<SymbolicCost> {
  cost_lens(n: nested_input)
}

fn nested_actual_complexity() -> ComplexityAssessment {
  complexity_lens(n: nested_input)
}

test fn nested_cost_projection_holds() -> Bool {
  match nested_actual_cost() {
    Holds { value: actual } => actual == nested_claim.expected_cost
    Violates { diagnostic: _ } => false
  }
}

test fn nested_complexity_projection_holds() -> Bool {
  nested_actual_complexity() == established_complexity(bound: nested_claim.expected_complexity)
}
