module v2.test.scratch_tidy.receipt

import std.process { ProcessExit, ExitFailure }
import gunbc.instruments.type_declaration_use_census {
  type_census_receipt, type_census_run_empty, type_census_run_add, type_census_contribution_of
}
import v2.compiler.compile { native_test_context_from_ingest, native_lane_file_refusal_index, native_census_modules, native_census_module_inference }
import v2.compiler.program_assembly { module_roots_from_source_root_ingest }
import v2.compiler.resolve { resolve }
import v2.compiler.refinement_discharge { infer_and_discharge }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.diagnostic { Accepted, Rejected, bind_outcome }
import v2.std.node { symbol_lexeme }
import v2.std.optional { Present, Absent }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.source_authority { DagSourceReadWitness }
import std.algebra { Cons, Empty }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.artifact { Artifact, SourceFile }

data fixture: String = "module m\n\ntype A = String\n\ntype P = Int where pos\n\ntype R1 { v: String }\n\ntype R2 { x: Int, y: Int }\n\ntype S = X | Y\n\nfn pos(value: Int) -> Bool {\n  true\n}\n\nfn f1(s: String) -> A {\n  s as A\n}\n\nfn f2(n: Int) -> P {\n  n as P\n}\n\nfn f3(p: P) -> Int {\n  p as Int\n}\n\nfn f4(p: P, q: P) -> Bool {\n  (p as Int) == (q as Int)\n}\n\nfn f6(r: R1, r2: R2, s: S) -> Int {\n  1\n}\n"

fn one(text: String) -> String {
  let ingest = Cons { head: DagSourceReadWitness { source: Medium { carried: text, fidelity: Lossless }, artifact: Artifact { kind: SourceFile, id: ^scratch_artifact, file_path: "src/v2/pilot/scratch.dag" }, compilation_unit: ^scratch_cu, source_root: V2Tree }, tail: Empty }
  match native_test_context_from_ingest(ingest: ingest) {
    Rejected { diagnostics: d } => "context refused " + symbol_lexeme(sym: d.head.reason)
    Accepted { value: context, diagnostics: _ } =>
      let index = native_lane_file_refusal_index(refusals: context.file_refusals)
      let run = fold(native_census_modules(ingest: ingest), init: type_census_run_empty(), f: fn(acc, entry) {
        let step = native_census_module_inference(context: context, refusal_index: index, entry: entry)
        type_census_run_add(run: acc, c: type_census_contribution_of(context: step.context, entry: entry, outcome: step.outcome))
      })
      let r = type_census_receipt(run: run)
      v2.std.algebra.fold_list(xs: r.lines, empty: "", cons: fn(acc, l) { if starts_with(s: l, prefix: "cast ") { acc + "\n    " + l } else { acc } })
  }
}

fn main() -> ProcessExit {
  let fixtures = [
    "module m\n\ntype A = String\n\nfn f1(s: String) -> A {\n  s as A\n}\n",
    "module m\n\ntype P = Int where pos\n\nfn pos(value: Int) -> Bool {\n  true\n}\n\nfn f2(n: Int) -> P {\n  n as P\n}\n",
    "module m\n\ntype P = Int where pos\n\nfn pos(value: Int) -> Bool {\n  true\n}\n\nfn f3(p: P) -> Int {\n  p as Int\n}\n",
    "module m\n\ntype P = Int where pos\n\nfn pos(value: Int) -> Bool {\n  true\n}\n\nfn f4(p: P, q: P) -> Bool {\n  (p as Int) == (q as Int)\n}\n",
    "module m\n\nfn f5(n: Int) -> Int {\n  n as Int\n}\n",
    "module m\n\nfn f6() -> String {\n  \"x\" as String\n}\n"
  ]
  ExitFailure { code: 3, reason: fold(fixtures, init: "", f: fn(acc, src) { acc + "\n== " + one(text: src) }) }
}
