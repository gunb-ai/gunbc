module fixture.argv_word_construction.host_words

// The committed real-parse fixture for the typed-argv census lens (v2.lens.argv_word_construction):
// small enough to read and parse inside a claim test, and shaped so every census signal appears
// once. Under the declared src/v2 root like the text-string census's fixture, so claim_batch's
// confined filesystem can read it and the module loader typechecks it as part of the run.

import std.algebra { Cons, Empty }
import v2.std.logic { Bool }
import v2.std.collection { List }
import v2.std.algebra { length }

// A List<String> data decl that IS argv vocabulary: flag words among its literal elements.
data fixture_wait_flags: List<String> = ["--wait", "--quiet", "--collect"]

// A List<String> data decl that is NOT argv vocabulary: no flag words, no argv name (the ceiling
// the parent named; a List<String> data decl is not a member by itself).
data fixture_layout_rows: List<String> = ["header", "divider", "footer"]

// A List<String> data decl that IS argv vocabulary by name, without flag words: command words.
data fixture_commit_args: List<String> = ["commit", "--allow-empty"]

// (a)+(b): a fn builder that glues a flag literal to a value and returns word-lists.
fn fixture_transient_unit_argv(unit: String) -> List<String> {
  Cons { head: "systemd-run", tail: Cons { head: concat("--unit=", unit), tail: Cons { head: "--collect", tail: Empty } } }
}

// (b): a fn accepting a List<String> argv parameter in an argv position, returning word-lists.
fn fixture_run_with_properties(unit: String, property_argv: List<String>) -> List<String> {
  Cons { head: concat("--unit=", unit), tail: property_argv }
}

// NOT a member: a List<String> parameter outside the argv positions, no flag words, no
// List<String> return.
fn fixture_label_rows(labels: List<String>) -> Bool {
  !(length(xs: labels) == 0)
}

// (a) only: a fn that spells a flag literal and returns a scalar.
fn fixture_waits_quietly() -> Bool {
  starts_with(s: concat("--", "wait"), prefix: "--wait")
}
