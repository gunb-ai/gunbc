module v2.test.manual.emitprobe.emit_probe

import extdeps.communication.medium { Medium }
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredTree }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module }
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model }
import v2.extdeps.languages.rust_test { rust_classical_not_ingested_target_model_staging }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.logic { Bool }
import v2.std.node { Arrow, Node, TypeNode }
import v2.std.optional { Absent, Optional, Present }

data probe_source: String = "module m\n\nfn classical_not(x: Int) -> Int {\n  match x {\n    true => false,\n    false => true\n  }\n}\n"

data probe_nested_source: String = "module m\n\nfn classical_not(x: Int) -> Int {\n  match x {\n    true => match x {\n      true => false,\n      false => true\n    },\n    false => match x {\n      true => false,\n      false => true\n    }\n  }\n}\n"

fn probe_find_arrow(root: Node) -> Optional<Node> {
  match root.kind {
    TypeNode { connective: Arrow } => Present { value: root }
    _ =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => probe_find_arrow(root: e.target)
        }
      })
  }
}

fn probe_resolved_from(source: String) -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(text: source, file: ^emit_probe_file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: parse_module(tokens: tokens, grammar: lm.grammar),
        f: fn(artifact) {
          bind_outcome(
            o: normalize(parse_tree: artifact.tree),
            f: fn(normalized) { resolve(tree: normalized, lm: lm) }
          )
        }
      )
    }
  )
}

fn probe_tree_from(source: String) -> Optional<InferredTree> {
  match probe_resolved_from(source: source) {
    Accepted { value: resolved, diagnostics: _ } =>
      match probe_find_arrow(root: resolved) {
        Present { value: arrow } =>
          Present { value: InferredTree { root: arrow, facts: PartialFunction { lookup: fn(_key) { Absent } } } }
        Absent => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

test fn probe_ingest_only_holds() -> Bool {
  match probe_tree() {
    Present { value: _ } => true
    Absent => false
  }
}

test fn probe_ingest_emit_holds() -> Bool {
  match probe_tree() {
    Present { value: tree } =>
      match emit(tree: tree, target: rust_classical_not_ingested_target_model_staging()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Absent => false
  }
}

fn probe_tree() -> Optional<InferredTree> {
  probe_tree_from(source: probe_source)
}

test fn probe_nested_ingest_only_holds() -> Bool {
  match probe_tree_from(source: probe_nested_source) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn probe_nested_ingest_emit_holds() -> Bool {
  match probe_tree_from(source: probe_nested_source) {
    Present { value: tree } =>
      match emit(tree: tree, target: rust_classical_not_ingested_target_model_staging()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Absent => false
  }
}
