module v2.test.manual.retry_body_env_loss_probe

import v2.compiler.emit_orchestration { orch_emit_step }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import std.algebra { FreeMonoid }
import v2.std.orchestration {
  Do,
  EnvBinding,
  EnvSet,
  EscalationLevel,
  FailFast,
  LogMatches,
  Pipeline,
  PipelineStep,
  Retry,
  Run
}
import v2.std.collection { Absent }
import v2.std.diagnostic { Accepted, EmitDirective, None, Rejected, SeverityWarning }
import v2.std.optional { Optional, Present }

data probe_command: String = "probe_cmd"
data probe_exhausted: String = "exit 9"

fn probe_escalation() -> EscalationLevel {
  EscalationLevel {
    detect: LogMatches { source: "BUILD_LOG", pattern: "PAT1" },
    warning: EmitDirective {
      severity: SeverityWarning,
      message: "w1"
    },
    env: [EnvSet { name: "E1", value: "1" }]
  }
}

fn probe_exhausted_pipeline() -> Pipeline {
  Pipeline {
    steps: [
      Do {
        run: Run {
          command: probe_exhausted,
          env: [],
          redirect: Absent,
          capture: Absent
        }
      }
    ],
    on_failure: FailFast
  }
}

fn probe_retry_body(env: FreeMonoid<EnvBinding>) -> PipelineStep {
  Retry {
    body: Pipeline {
      steps: [
        Do {
          run: Run {
            command: probe_command,
            env: env,
            redirect: Absent,
            capture: Absent
          }
        }
      ],
      on_failure: FailFast
    },
    escalations: [probe_escalation()],
    on_exhausted: probe_exhausted_pipeline()
  }
}

fn probe_retry_body_env_empty() -> PipelineStep {
  probe_retry_body(env: [])
}

fn probe_retry_body_env_present() -> PipelineStep {
  probe_retry_body(env: [EnvSet { name: "BODY_VAR", value: "body_val" }])
}

fn probe_emit_string(step: PipelineStep) -> String {
  match orch_emit_step(s: step, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: dg } =>
      match dg {
        None => source.carried
        Some { diagnostics: _ } => "__REJECTED_WITH_DIAGNOSTICS__"
      }
    Rejected { diagnostics: _ } => "__REJECTED__"
  }
}

fn probe_body_env_identical_emission_holds() -> Bool {
  probe_emit_string(step: probe_retry_body_env_empty())
    == probe_emit_string(step: probe_retry_body_env_present())
}

fn probe_body_env_absent_from_emission_holds() -> Bool {
  let emitted = probe_emit_string(step: probe_retry_body_env_present())
  !string_contains(s: emitted, pattern: "BODY_VAR")
    && !string_contains(s: emitted, pattern: "body_val")
}

fn main() -> Bool {
  probe_body_env_identical_emission_holds()
    && probe_body_env_absent_from_emission_holds()
}
