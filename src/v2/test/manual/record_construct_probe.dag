module v2.test.manual.record_construct_probe

import v2.compiler.resolve { ResolvedTree }
import extdeps.communication.medium { Lossless, Medium }
import std.algebra { Cons, Empty }
import v2.compiler.infer { ConstructIsRecord, ConstructNotARecord, infer, infer_declarations, infer_record_construct_read }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.extdeps.languages.dag { dag_binding_denotation, dag_language_model }
import v2.compiler.symbol_index_fill { symbol_index_fill_containment_node }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.collection { List, list_at_optional }
import v2.std.diagnostic { Accepted, Diagnostic, Diagnostics, None, Outcome, Rejected, Some }
import v2.std.logic { Bool }
import v2.std.node { Arrow, Atom, Conj, Edge, Named, Node, Positional, TypeNode, node_subtree_nodes }
import v2.std.node_query { construct_tag_optional }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.qualified_name { declaration_reference_path_optional }
import v2.std.symbol_index { RecordTypePayload, VariantArmPayload, symbol_index_declared_payload_at, symbol_index_lookup, SymbolIndex, empty_symbol_index }
import v2.std.type_binder { GenericTypeDecl, OpaqueTypeDecl, PlainTypeDecl, TypeAlias, type_decl_view }
import v2.std.text { String }

data rcp_bad_source: String = "module rcp\n\ntype ArB { n: Int, m: Int }\n\ndata ar_bad: ArB = ArB { n: true, m: 3 }\n"

data rcp_gen_source: String = "module rcp\n\ntype Bx<T> { v: T, w: T }\n\ndata bx: Bx<Int> = Bx { v: 1, w: 2 }\n"

fn rcp_resolved(source: String) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: DagSourceReadWitness {
        source: Medium { carried: source, fidelity: Lossless },
        artifact: Artifact { kind: SourceFile, id: ^rcp_artifact, file_path: "src/v2/test/manual/rcp.dag" },
        compilation_unit: ^rcp_cu,
        source_root: V2Tree
      },
      tail: Empty
    },
    admission: Admission { subject: ResolutionSubject { name: Cons { head: ^rcp, tail: Empty } }, imports: Empty },
    lm: dag_language_model()
  )
}

fn rcp_bad() -> Outcome<ResolvedTree> { rcp_resolved(source: rcp_bad_source) }
fn rcp_gen() -> Outcome<ResolvedTree> { rcp_resolved(source: rcp_gen_source) }

test fn p01_resolve_accepts() -> Bool {
  match rcp_bad() { Accepted { value: _, diagnostics: _ } => true  Rejected { diagnostics: _ } => false }
}

test fn p02_infer_accepts_the_bad_specimen() -> Bool {
  match rcp_bad() {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      match infer(tree: t) { Accepted { value: _, diagnostics: _ } => true  Rejected { diagnostics: _ } => false }
  }
}

fn rcp_any_node(o: Outcome<ResolvedTree>, p: fn(Node) -> Bool) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } => any(xs: node_subtree_nodes(root: t.root), predicate: p)
  }
}

fn rcp_first_named(n: Node) -> Optional<Edge> {
  match list_at_optional(xs: n.children, index: 0) {
    Absent => Absent
    Present { value: e } => match e.label { Named { name: _ } => Present { value: e }  Positional => Absent }
  }
}

fn rcp_edge_label_is(e: Edge, s: Symbol) -> Bool {
  match e.label { Named { name: l } => l == s  Positional => false }
}

fn rcp_is_construct_with_atom_tag(n: Node) -> Bool {
  match construct_tag_optional(n: n) {
    Present { value: t } => (match declaration_reference_path_optional(node: t) { Present { value: _ } => false  Absent => true })
    Absent => false
  }
}

fn rcp_is_construct_with_ref_tag(n: Node) -> Bool {
  match construct_tag_optional(n: n) {
    Present { value: t } => (match declaration_reference_path_optional(node: t) { Present { value: _ } => true  Absent => false })
    Absent => false
  }
}

test fn p03_construct_tag_stays_an_atom_after_resolve() -> Bool {
  rcp_any_node(o: rcp_bad(), p: fn(n) { rcp_is_construct_with_atom_tag(n: n) })
}

test fn p04_construct_tag_is_a_declaration_reference_after_resolve() -> Bool {
  rcp_any_node(o: rcp_bad(), p: fn(n) { rcp_is_construct_with_ref_tag(n: n) })
}

fn rcp_construct_child_count(n: Node) -> Bool {
  if rcp_is_construct_with_ref_tag(n: n) || rcp_is_construct_with_atom_tag(n: n) { length(xs: n.children) == 3 } else { false }
}

test fn p05_construct_has_three_children() -> Bool {
  rcp_any_node(o: rcp_bad(), p: fn(n) { rcp_construct_child_count(n: n) })
}

fn rcp_decl(o: Outcome<ResolvedTree>, name: Symbol) -> Optional<Node> {
  match o {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: t, diagnostics: _ } =>
      symbol_index_lookup(index: t.symbol_index, qualified_path: Cons { head: ^rcp, tail: Cons { head: name, tail: Empty } })
  }
}

test fn p06_index_holds_the_record_declaration() -> Bool {
  match rcp_decl(o: rcp_bad(), name: ^ArB) { Present { value: _ } => true  Absent => false }
}

test fn p07_record_declaration_is_a_conj_of_two() -> Bool {
  match rcp_decl(o: rcp_bad(), name: ^ArB) {
    Absent => false
    Present { value: d } => match d.kind { TypeNode { connective: Conj } => length(xs: d.children) == 2  _ => false }
  }
}

test fn p08_record_declaration_is_a_plain_decl_with_named_n() -> Bool {
  match rcp_decl(o: rcp_bad(), name: ^ArB) {
    Absent => false
    Present { value: d } =>
      match type_decl_view(target: d) {
        PlainTypeDecl { member: m } => any(xs: m.children, predicate: fn(e) { rcp_edge_label_is(e: e, s: ^n) })
        _ => false
      }
  }
}

fn rcp_field_target(d: Node, s: Symbol) -> Optional<Node> {
  fold(d.children, init: optional_absent(), f: fn(acc, e) { if rcp_edge_label_is(e: e, s: s) { optional_present(value: e.target) } else { acc } })
}

test fn p09_declared_field_n_is_a_bare_int_atom() -> Bool {
  match rcp_decl(o: rcp_bad(), name: ^ArB) {
    Absent => false
    Present { value: d } =>
      match rcp_field_target(d: d, s: ^n) {
        Absent => false
        Present { value: t } => match t.kind { TypeNode { connective: Atom { identity: id } } => id == ^Int  _ => false }
      }
  }
}

test fn p10_declared_field_n_is_a_declaration_reference() -> Bool {
  match rcp_decl(o: rcp_bad(), name: ^ArB) {
    Absent => false
    Present { value: d } =>
      match rcp_field_target(d: d, s: ^n) {
        Absent => false
        Present { value: t } => match declaration_reference_path_optional(node: t) { Present { value: _ } => true  Absent => false }
      }
  }
}

test fn p11_generic_resolve_accepts() -> Bool {
  match rcp_gen() { Accepted { value: _, diagnostics: _ } => true  Rejected { diagnostics: _ } => false }
}

test fn p12_generic_declaration_is_a_generic_decl() -> Bool {
  match rcp_decl(o: rcp_gen(), name: ^Bx) {
    Absent => false
    Present { value: d } =>
      match type_decl_view(target: d) { GenericTypeDecl { binders: _, member: _ } => true  _ => false }
  }
}

test fn p13_generic_declaration_is_a_plain_decl() -> Bool {
  match rcp_decl(o: rcp_gen(), name: ^Bx) {
    Absent => false
    Present { value: d } =>
      match type_decl_view(target: d) { PlainTypeDecl { member: _ } => true  _ => false }
  }
}

fn rcp_diag_has(ds: Diagnostics, r: Symbol) -> Bool {
  match ds {
    None => false
    Some { diagnostics: ne } => (ne.head.reason == r) || any(xs: ne.tail, predicate: fn(d) { d.reason == r })
  }
}

fn rcp_infer_diag_has(o: Outcome<ResolvedTree>, r: Symbol) -> Bool {
  match o {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      match infer(tree: t) { Accepted { value: _, diagnostics: ds } => rcp_diag_has(ds: ds, r: r)  Rejected { diagnostics: _ } => false }
  }
}

test fn p14_bad_infer_carries_a_frontier_diagnostic() -> Bool {
  rcp_infer_diag_has(o: rcp_bad(), r: ^infer_grounding_not_derived)
}

test fn p15_bad_infer_carries_no_diagnostic_at_all() -> Bool {
  match rcp_bad() {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      match infer(tree: t) { Accepted { value: _, diagnostics: ds } => (match ds { None => true  Some { diagnostics: _ } => false })  Rejected { diagnostics: _ } => false }
  }
}

data rcp_good_source: String = "module rcp\n\ntype ArB { n: Int, m: Int }\n\ndata ar_good: ArB = ArB { n: 1, m: 3 }\n"
data rcp_missing_source: String = "module rcp\n\ntype ArB { n: Int, m: Int }\n\ndata ar_x: ArB = ArB { n: 1 }\n"
data rcp_unknown_source: String = "module rcp\n\ntype ArB { n: Int, m: Int }\n\ndata ar_x: ArB = ArB { n: 1, m: 3, q: 4 }\n"
data rcp_gen_bad_source: String = "module rcp\n\ntype Bx<T> { v: T, w: T }\n\ndata bx: Bx<Int> = Bx { v: 1, w: true }\n"
data rcp_gen_ret_bad_source: String = "module rcp\n\ntype Bx<T> { v: T, w: T }\n\ndata bx: Bx<Bool> = Bx { v: 1, w: 2 }\n"
data rcp_other_source: String = "module rcp\n\ntype ArA { n: Int, m: Int }\n\ntype ArB { n: Int, m: Int }\n\ndata ar_x: ArB = ArA { n: 1, m: 3 }\n"

fn rcp_infer_rejects_with(source: String, r: Symbol) -> Bool {
  match rcp_resolved(source: source) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      match infer(tree: t) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: ne } => (ne.head.reason == r) || any(xs: ne.tail, predicate: fn(d) { d.reason == r })
      }
  }
}

fn rcp_infer_accepts_without(source: String, r: Symbol) -> Bool {
  match rcp_resolved(source: source) {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      match infer(tree: t) { Accepted { value: _, diagnostics: ds } => !rcp_diag_has(ds: ds, r: r)  Rejected { diagnostics: _ } => false }
  }
}

test fn q01_bad_refuses_field_value() -> Bool { rcp_infer_rejects_with(source: rcp_bad_source, r: ^record_field_value_does_not_inhabit) }
test fn q02_good_accepts() -> Bool { rcp_infer_accepts_without(source: rcp_good_source, r: ^none_such) }
test fn q03_good_has_no_formal_unresolved() -> Bool { rcp_infer_accepts_without(source: rcp_good_source, r: ^inhabitance_undecidable_formal_unresolved) }
test fn q04_good_has_no_frontier() -> Bool { rcp_infer_accepts_without(source: rcp_good_source, r: ^infer_grounding_not_derived) }
test fn q05_missing_refuses() -> Bool { rcp_infer_rejects_with(source: rcp_missing_source, r: ^record_construct_field_missing) }
test fn q06_unknown_refuses() -> Bool { rcp_infer_rejects_with(source: rcp_unknown_source, r: ^record_construct_field_not_declared) }
test fn q07_generic_good_accepts() -> Bool { rcp_infer_accepts_without(source: rcp_gen_source, r: ^none_such) }
test fn q08_generic_good_no_generic_undecidable() -> Bool { rcp_infer_accepts_without(source: rcp_gen_source, r: ^inhabitance_undecidable_generic_formal) }
test fn q09_generic_bad_refuses() -> Bool { rcp_infer_rejects_with(source: rcp_gen_bad_source, r: ^record_field_value_does_not_inhabit) }
test fn q10_generic_wrong_return_refuses() -> Bool { rcp_infer_rejects_with(source: rcp_gen_ret_bad_source, r: ^arrow_body_does_not_inhabit_declared_return) }
test fn q11_other_record_at_declared_return_refuses() -> Bool { rcp_infer_rejects_with(source: rcp_other_source, r: ^arrow_body_does_not_inhabit_declared_return) }
test fn q12_good_no_not_derived_arg() -> Bool { rcp_infer_accepts_without(source: rcp_good_source, r: ^inhabitance_undecidable_argument_type_not_derived) }


test fn r01_payload_kind_is_marked_record() -> Bool {
  match rcp_bad() {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      match symbol_index_declared_payload_at(index: t.symbol_index, qualified_path: Cons { head: ^rcp, tail: Cons { head: ^ArB, tail: Empty } }) {
        Present { value: k } => (match k { RecordTypePayload => true  VariantArmPayload => false })
        Absent => false
      }
  }
}

test fn r02_payload_kind_is_absent() -> Bool {
  match rcp_bad() {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      match symbol_index_declared_payload_at(index: t.symbol_index, qualified_path: Cons { head: ^rcp, tail: Cons { head: ^ArB, tail: Empty } }) {
        Present { value: _ } => false
        Absent => true
      }
  }
}

test fn r03_some_node_reads_as_record_construct() -> Bool {
  match rcp_bad() {
    Rejected { diagnostics: _ } => false
    Accepted { value: t, diagnostics: _ } =>
      any(xs: node_subtree_nodes(root: t.root), predicate: fn(n) {
        match infer_record_construct_read(node: n, declarations: infer_declarations(tree: t)) { ConstructIsRecord { construct: _ } => true  ConstructNotARecord => false }
      })
  }
}

fn rcp_construct_node(t: ResolvedTree) -> Optional<Node> {
  fold(node_subtree_nodes(root: t.root), init: optional_absent(), f: fn(acc, n) {
    match infer_record_construct_read(node: n, declarations: infer_declarations(tree: t)) { ConstructIsRecord { construct: _ } => optional_present(value: n)  ConstructNotARecord => acc }
  })
}

fn rcp_construct_infer_code(r: Symbol) -> Int {
  match rcp_bad() {
    Rejected { diagnostics: _ } => 9
    Accepted { value: t, diagnostics: _ } =>
      match rcp_construct_node(t: t) {
        Absent => 8
        Present { value: c } =>
          match infer(tree: ResolvedTree { root: c, symbol_index: t.symbol_index }) {
            Accepted { value: _, diagnostics: ds } => if rcp_diag_has(ds: ds, r: r) { 1 } else { 0 }
            Rejected { diagnostics: ne } => if (ne.head.reason == r) || any(xs: ne.tail, predicate: fn(d) { d.reason == r }) { 3 } else { 2 }
          }
      }
  }
}

test fn s01_construct_alone_rejects_with_field_reason() -> Bool { rcp_construct_infer_code(r: ^record_field_value_does_not_inhabit) == 3 }
test fn s02_construct_alone_rejects_other() -> Bool { rcp_construct_infer_code(r: ^record_field_value_does_not_inhabit) == 2 }
test fn s03_construct_alone_accepts_with_frontier() -> Bool { rcp_construct_infer_code(r: ^infer_grounding_not_derived) == 1 }
test fn s04_construct_alone_accepts_with_not_derived_arg() -> Bool { rcp_construct_infer_code(r: ^inhabitance_undecidable_argument_type_not_derived) == 1 }
test fn s05_construct_alone_accepts_with_formal_unresolved() -> Bool { rcp_construct_infer_code(r: ^inhabitance_undecidable_formal_unresolved) == 1 }

fn rcp_subject_index(t: ResolvedTree) -> SymbolIndex {
  symbol_index_fill_containment_node(index: empty_symbol_index(), path: Cons { head: ^rcp, tail: Empty }, node: t.root)
}

fn rcp_resolved_field_n(o: Outcome<ResolvedTree>) -> Optional<Node> {
  match o {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: t, diagnostics: _ } =>
      match symbol_index_lookup(index: rcp_subject_index(t: t), qualified_path: Cons { head: ^rcp, tail: Cons { head: ^ArB, tail: Empty } }) {
        Absent => optional_absent()
        Present { value: d } => rcp_field_target(d: d, s: ^n)
      }
  }
}

test fn t01_resolved_root_index_holds_arb() -> Bool {
  match rcp_resolved_field_n(o: rcp_bad()) { Present { value: _ } => true  Absent => false }
}

test fn t02_resolved_field_n_denotes() -> Bool {
  match rcp_resolved_field_n(o: rcp_bad()) {
    Absent => false
    Present { value: f } =>
      match f.kind { TypeNode { connective: Atom { identity: id } } => (match dag_binding_denotation(sym: id) { Present { value: _ } => true  Absent => false })  _ => false }
  }
}

test fn t03_resolve_only_baseline() -> Bool {
  match rcp_bad() { Accepted { value: t, diagnostics: _ } => length(xs: t.root.children) >= 0  Rejected { diagnostics: _ } => false }
}

fn rcp_code(source: String, r: Symbol) -> Int {
  match rcp_resolved(source: source) {
    Rejected { diagnostics: _ } => 9
    Accepted { value: t, diagnostics: _ } =>
      match infer(tree: t) {
        Accepted { value: _, diagnostics: ds } => if rcp_diag_has(ds: ds, r: r) { 1 } else { 0 }
        Rejected { diagnostics: ne } => if (ne.head.reason == r) || any(xs: ne.tail, predicate: fn(d) { d.reason == r }) { 3 } else { 2 }
      }
  }
}
test fn u01_bad_is_rejected_somehow() -> Bool { rcp_code(source: rcp_bad_source, r: ^zz) == 2 }
test fn u02_bad_accepted() -> Bool { rcp_code(source: rcp_bad_source, r: ^zz) == 0 }
test fn u03_bad_acc_frontier() -> Bool { rcp_code(source: rcp_bad_source, r: ^infer_grounding_not_derived) == 1 }
test fn u04_bad_acc_formal_unresolved() -> Bool { rcp_code(source: rcp_bad_source, r: ^inhabitance_undecidable_formal_unresolved) == 1 }
test fn u05_bad_acc_arg_not_derived() -> Bool { rcp_code(source: rcp_bad_source, r: ^inhabitance_undecidable_argument_type_not_derived) == 1 }
test fn u06_bad_rej_app_arg() -> Bool { rcp_code(source: rcp_bad_source, r: ^application_argument_does_not_inhabit) == 3 }
test fn u07_bad_rej_return() -> Bool { rcp_code(source: rcp_bad_source, r: ^arrow_body_does_not_inhabit_declared_return) == 3 }
test fn u08_missing_rejected_somehow() -> Bool { rcp_code(source: rcp_missing_source, r: ^zz) == 2 }
test fn u09_missing_resolve_rejects() -> Bool { rcp_code(source: rcp_missing_source, r: ^zz) == 9 }
test fn u10_bad_rej_lookup_miss() -> Bool { rcp_code(source: rcp_bad_source, r: ^infer_facts_lookup_miss) == 3 }
test fn u11_bad_rej_conflict() -> Bool { rcp_code(source: rcp_bad_source, r: ^infer_facts_key_conflict) == 3 }
