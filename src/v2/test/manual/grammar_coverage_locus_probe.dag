module v2.test.manual.grammar_coverage_locus_probe

import v2.lens.enforcement.grammar_coverage {
  grammar_coverage_file_receipt,
  grammar_coverage_file_reject_locus_matches
}

fn probe_file_reason(
  rel_path: String,
  stage: String,
  reason: Symbol
) -> Bool {
  grammar_coverage_file_reject_locus_matches(
    receipt: grammar_coverage_file_receipt(rel_path: rel_path),
    stage: stage,
    reason: reason
  )
}

test fn probe_core_parse_g0() -> Bool {
  probe_file_reason(
    rel_path: "src/v1/00_core.dag",
    stage: "parse",
    reason: ^parse_g0_tokens_remain
  )
}

test fn probe_core_parse_e1_syntax() -> Bool {
  probe_file_reason(
    rel_path: "src/v1/00_core.dag",
    stage: "parse",
    reason: ^parse_e1_syntax_error
  )
}

test fn probe_core_parse_grammar_not_well_formed() -> Bool {
  probe_file_reason(
    rel_path: "src/v1/00_core.dag",
    stage: "parse",
    reason: ^parse_grammar_not_well_formed
  )
}

test fn probe_tokenize_parse_g0() -> Bool {
  probe_file_reason(
    rel_path: "src/v1/01_tokenize.dag",
    stage: "parse",
    reason: ^parse_g0_tokens_remain
  )
}

test fn probe_tokenize_parse_e1_syntax() -> Bool {
  probe_file_reason(
    rel_path: "src/v1/01_tokenize.dag",
    stage: "parse",
    reason: ^parse_e1_syntax_error
  )
}

test fn probe_tokenize_parse_grammar_not_well_formed() -> Bool {
  probe_file_reason(
    rel_path: "src/v1/01_tokenize.dag",
    stage: "parse",
    reason: ^parse_grammar_not_well_formed
  )
}

test fn probe_core_direct_reason_eq() -> Bool {
  match grammar_coverage_file_receipt(rel_path: "src/v1/00_core.dag").verdict {
    ParsedClean => false
    ParseRejected { stage: s, reason: r } =>
      (s == "parse") && (r == ^parse_g0_tokens_remain)
  }
}

test fn probe_tokenize_direct_reason_eq() -> Bool {
  match grammar_coverage_file_receipt(rel_path: "src/v1/01_tokenize.dag").verdict {
    ParsedClean => false
    ParseRejected { stage: s, reason: r } =>
      (s == "parse") && (r == ^parse_g0_tokens_remain)
  }
}
