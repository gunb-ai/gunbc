module v2.test.manual.ownership_movable

import v1.compiler.ownership { build_movable_set, make_decision, BindingUsage, EdgeClassification, EdgeKind, OwnershipProof, OwnershipDecision }

data ownership_movable_manual_pool_note: String = "Imports v1.compiler.ownership (#6249). Not in dag/ compile-clean closure — run with --source-root src/v1 in the dependency pool (local/manual receipt only)."

data ownership_movable_witness_staged_offpath_dissolution_trigger: String = "🟡 dissolve-on: this witness's subject is the v1-side ownership de-fork (build_movable_set). Two honest facts about its coverage, stated so nothing reads it as covered-by-illusion (DESIGN §5): (1) OFF AUTO-PATH — it imports v1.compiler.ownership (src/v1), outside the compile-clean gate's witness_layer_roots (dag + src/v2). At dag/test/claim/ it reddened the gate with 41 out-of-scope errors; at src/v1/ it is gate-safe but NOT reached by claim_batch --roster-from-discovery (src/v1 is not a witness_discovery_scan_dir) and NOT CI-enrollable (the floor witness run is dag+src/v2-scoped, cannot resolve the src/v1 import). (2) NOT RESOLVABLE ON CLEAN MAIN — its import closure pulls in src/v1/04_resolve.dag, which carries a PRE-EXISTING dark type error (04_resolve.dag:237-238, if-branch Product(Node) vs Product(Unit)); dark because the seed is hand-synced so the .dag drift is invisible to the gate (§7 regen/fixpoint gap). So this is NOT a live .dag regression guard today. The live v1 ownership logic is carried by the compiled seed (src/v1/stage0/src/v1_compiler_ownership.rs) and exercised via rust_tests — that is where the real coverage sits, not here. The per-site move-license half of this witness (record_whole_use_site / record_field_use_site / merge_branch_licenses) was DELETED with that machinery (persistent-carriers migration, 2026-07-06): structural sharing made per-site move licensing moot, so the licenses and their witnesses dissolved together rather than anchoring future work. DISSOLVES WHEN the v2-side witness over v2.compiler.use_site_verdict's node-attached fact replaces it (dag/src/v2 scope: discoverable AND gate-safe AND resolvable), landing with v2's ownership-analysis pass; operator deferred that producer (c) 2026-07-05."

fn proof_one(name: String, consumers: List<EdgeClassification>) -> OwnershipProof {
  let usage = BindingUsage { name: name, binding_kind: none, consumers: consumers }
  OwnershipProof {
    func_name: "fixture",
    bindings: map_insert(empty_map(), name, usage),
    decisions: [],
    fold_acc_unwrap: []
  }
}

fn edge(k: EdgeKind, s: String) -> EdgeClassification {
  EdgeClassification { kind: k, site: s, span_start: 0 }
}

fn movable_of(proof: OwnershipProof, name: String) -> Bool {
  set_contains(build_movable_set(proof: proof, param_names: set_insert(empty_set(), name)), name)
}

fn witness_read_then_consume_param_is_movable() -> Bool {
  let proof = proof_one(name: "acc", consumers: [edge(k: Projected, s: ".seen"), edge(k: Consumed, s: "return")])
  movable_of(proof: proof, name: "acc")
}

fn witness_double_consume_is_not_movable() -> Bool {
  let proof = proof_one(name: "x", consumers: [edge(k: Consumed, s: "a"), edge(k: Consumed, s: "b")])
  movable_of(proof: proof, name: "x") == false
}

fn witness_zero_consume_is_not_movable() -> Bool {
  let proof = proof_one(name: "r", consumers: [edge(k: Read, s: "a"), edge(k: Projected, s: ".f")])
  movable_of(proof: proof, name: "r") == false
}

fn witness_whole_read_then_consume_is_not_movable() -> Bool {
  let proof = proof_one(name: "x", consumers: [edge(k: Read, s: "read"), edge(k: Consumed, s: "return")])
  movable_of(proof: proof, name: "x") == false
}

fn witness_threaded_then_consume_is_not_movable() -> Bool {
  let proof = proof_one(name: "x", consumers: [edge(k: Threaded, s: "fold_init"), edge(k: Consumed, s: "return")])
  movable_of(proof: proof, name: "x") == false
}

test fn ownership_movable_witnesses() -> Bool {
  witness_read_then_consume_param_is_movable()
    && witness_double_consume_is_not_movable()
    && witness_zero_consume_is_not_movable()
    && witness_whole_read_then_consume_is_not_movable()
    && witness_threaded_then_consume_is_not_movable()
}
