module test.manual.v1_complexity_eviction_hazard_test

import std.types { String, NonEmptyStr, Bool, List }
import v1.compiler.complexity {
  ComplexitySummary,
  CostExpr,
  CostConst,
  Certainty,
  Proven,
  CostInternTable,
  empty_cost_intern_table,
  cache_summary,
  lookup_summary,
  evict_summary,
}

data eviction_hazard_home_note: String = "Homed under src/v2/test/manual/ because it IMPORTS v1.compiler.complexity to execute the seed, and that import does not resolve under the floor's compile-clean scope for a dag/ entry — measured, not assumed: dag/test/claim/long/v1_complexity_capability_census_resolution_test.dag:26 failed with 'unresolved import: module v1.compiler.complexity not found' while the sibling resolution census, which reads v1 through decl_facts POOL ROOTS rather than an import, compiles fine. src/v2/test/manual/ is the established home for a v1-importing witness (ownership_movable_test.dag imports v1.compiler.ownership), is excluded from per-PR discovery at test/manual/ dir grain, and runs by local recipe. Local recipe: claim_batch --source-root dag --source-root src/v2 --source-root src/v1 --entry src/v2/test/manual/v1_complexity_eviction_hazard_test.dag --functions eviction_probe_caches_a_nonzero_summary,eviction_returns_a_proven_zero_instead_of_absent,never_cached_function_is_absent"

data eviction_executing_control_note: String = "CENSUS HAZARD, proven by EXECUTION rather than by matching source text (operator review 2026-08-05). The previous control asserted only that the source contained 'fn evict_summary' and a cache_summary call prefix — a safe implementation could keep both and the control would stay green, so it established nothing about the defect. This runs the seed: cache a summary whose work is nonzero, evict it, look it up again. The correct behavior is Absent — the entry was evicted, so it is NOT COMPUTED. The seed instead returns a Present summary whose work is zero and whose certainty is Proven, so a consumer reads 'costs nothing, proven' for a function whose cost was never derived. The assertions below pin that defect as it exists today; when the migrated form removes the entry or refuses, this witness REDS, which is the correct direction because the row exists to stop this realization carrying across."

fn eviction_probe_table() -> CostInternTable {
  cache_summary(
    table: empty_cost_intern_table(),
    func_name: "probe_fn",
    summary: ComplexitySummary {
      work: CostConst { value: 42 },
      span: CostConst { value: 7 },
      output_size: empty_map(),
      certainty: Proven
    }
  )
}

test fn eviction_probe_caches_a_nonzero_summary() -> Bool {
  match lookup_summary(table: eviction_probe_table(), func_name: "probe_fn") {
    Absent => false
    Present { value: s } =>
      match s.work {
        CostConst { value: v } => v == 42
        _ => false
      }
  }
}

test fn eviction_returns_a_proven_zero_instead_of_absent() -> Bool {
  let evicted = evict_summary(table: eviction_probe_table(), func_name: "probe_fn")
  match lookup_summary(table: evicted, func_name: "probe_fn") {
    Absent => false
    Present { value: s } =>
      match s.work {
        CostConst { value: w } =>
          match s.span {
            CostConst { value: sp } =>
              match s.certainty {
                Proven => w == 0 && sp == 0
                _ => false
              }
            _ => false
          }
        _ => false
      }
  }
}

data eviction_correct_behavior_control_note: String = "The paired statement of what correct looks like, so the defect is described by contrast rather than only pinned. An entry that was never cached must look up Absent — the seed gets THIS case right, which is what makes the evicted case a genuine conflation rather than a uniform absence of the concept: lookup can express 'not computed', and eviction declines to use it."

test fn never_cached_function_is_absent() -> Bool {
  match lookup_summary(table: eviction_probe_table(), func_name: "a_function_never_cached") {
    Absent => true
    Present { value: _ } => false
  }
}

data w_admission_predicate_is_vacuous_note: String = "CENSUS FINDING, moved here from the fast lane because its imports were measurably expensive (see closure_cost_note in the fast-lane companion: this control's v2.lens closure cost an unrelated witness ~1.1s of its 5s budget). The control itself is unchanged and strengthened from the original: asserting that complexity_variables_admits EXISTS establishes nothing, since a real implementation satisfies that too. This uses the tree's own typed admission — v2.lens.complexity declares complexity_variables_vacuous_validation as a VacuousValidation carrying vacuous_admits_marker, which IS the module stating its predicate admits everything — and executes the predicate beside it. Synthesizing a rejected input is not available as a control precisely because the predicate rejects nothing; that is the finding."

test fn census_complexity_admission_predicate_is_vacuous_by_execution() -> Bool {
  complexity_variables_admits(xs: []) &&
  complexity_variables_vacuous_validation.vacuous == vacuous_admits_marker
}
