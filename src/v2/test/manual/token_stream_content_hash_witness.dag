module v2.test.manual.token_stream_content_hash_witness

import extdeps.filesystem.filesystem_io
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.collection { Absent, Optional, Present }
import v2.std.compilers.lexing { Token, TokenStream, symbol_intern_lexeme, token_stream_all }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Hash, combine_hash, symbol_identity_digest }

data token_stream_content_hash_witness_note: String = "adhoc-c328b166-bca fix-4 verification receipt: order-sensitive hash over the tokenize() output (class + interned lexeme per token, in stream order) run once against the pre-fix 01_tokenize.dag (checked out from main, built as its own release binary in a separate worktree) and once against the post-fix version (lex_walk_step reverse-cons + tokenize()'s .reverse()) -- byte-equal Hash across both runs proves the accumulation rewrite is a pure algorithmic change (same token sequence, cheaper to build), not a semantic one. Position fields (start/end) are intentionally excluded: they are derived from the class+lexeme sequence under a deterministic lexer, so hashing them is redundant with hashing the sequence itself, not independent evidence. The two revisions cannot both load in one interpreter run, so compare the printed Hash from two separate `gunbc run` invocations against two independently-built binaries, not in-process."

fn token_hash_step(acc: Hash, t: Token) -> Hash {
  combine_hash(
    a: acc,
    b: combine_hash(a: symbol_identity_digest(sym: t.class), b: symbol_identity_digest(sym: symbol_intern_lexeme(lexeme: t.lexeme)))
  )
}

fn token_stream_content_hash(stream: TokenStream) -> Hash {
  fold(
    token_stream_all(stream: stream),
    init: symbol_identity_digest(sym: ^token_stream_content_hash_seed),
    f: token_hash_step
  )
}

fn token_stream_content_hash_for_path(path: String) -> Optional<Hash> {
  let lm = dag_language_model_wave1()
  let source_text = filesystem_read(path: path).content
  match tokenize(text: source_text, file: ^token_stream_content_hash_file_anchor, rules: lm.lex) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: stream, diagnostics: _ } => Present { value: token_stream_content_hash(stream: stream) }
  }
}

fn witness_token_stream_content_hash_tiny() -> Optional<Hash> {
  token_stream_content_hash_for_path(path: "src/v2/std/witness.dag")
}

fn witness_token_stream_content_hash_small() -> Optional<Hash> {
  token_stream_content_hash_for_path(path: "src/v2/std/execution_mode.dag")
}
