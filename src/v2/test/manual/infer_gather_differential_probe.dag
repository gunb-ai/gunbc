fn infer_probe_differential() -> List<InferProbeRow> {
  list_map(xs: infer_probe_specimens(), f: fn(src) { infer_probe_row(src: src) })
}

fn infer_probe_scale_8_nodes() -> Int {
  match tpb_assemble(src: "module p\n\nfn f0(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f1(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f2(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f3(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f4(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f5(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f6(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f7(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n") {
    Rejected { diagnostics: _ } => 0
    Accepted { value: root, diagnostics: _ } => node_subtree_count(n: root.root)
  }
}

fn infer_probe_scale_8() -> Int {
  match tpb_assemble(src: "module p\n\nfn f0(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f1(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f2(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f3(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f4(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f5(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f6(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n\nfn f7(b: Bool, x: Int) -> Int {\n  let y: Int = x + x\n  if b { y } else { x as Int }\n}\n") {
    Rejected { diagnostics: _ } => 0
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Rejected { diagnostics: _ } => 1
        Accepted { value: _, diagnostics: _ } => 2
      }
  }
}

