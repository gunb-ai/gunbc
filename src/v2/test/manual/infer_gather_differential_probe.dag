module v2.test.manual.infer_gather_differential_probe

import v2.compiler.resolve { ResolvedTree }
import v2.std.symbol_index { empty_symbol_index }
import v2.compiler.infer { infer }
import v2.compiler.inferred_tree { InferredFacts }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, node_subtree_nodes, node_subtree_count }
import v2.std.optional { Optional }
import v2.std.text { String }
import v2.std.algebra { list_map }
import v2.test.claim.type_param_binder_frame { tpb_assemble }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type InferProbeRow
  = InferProbeAssemblyRefused
  | InferProbeRefused { diagnostics: NonEmptyDiagnostics }
  | InferProbeFacts { facts: List<Optional<InferredFacts>> }

fn infer_probe_row(src: String) -> InferProbeRow {
  match tpb_assemble(src: src) {
    Rejected { diagnostics: _ } => InferProbeAssemblyRefused
    Accepted { value: root, diagnostics: _ } =>
      match infer(tree: root) {
        Rejected { diagnostics: r } => InferProbeRefused { diagnostics: r }
        Accepted { value: t, diagnostics: _ } =>
          InferProbeFacts { facts: list_map(xs: node_subtree_nodes(root: t.root), f: fn(n) { t.facts.lookup(n) }) }
      }
  }
}

