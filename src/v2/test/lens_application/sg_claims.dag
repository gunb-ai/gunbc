module v2.test.lens_application.sg_claims



data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data lens_application_synthesis_root_path: Path = Path { steps: [] }

data lens_application_synthesis_root_declaration: DeclarationId = DeclarationId {
  path: lens_application_synthesis_root_path
}

fn lens_application_synthesis_gap_enforce_rejects() -> Bool {
  match apply_advisory_lens(
    lens: decision_tree_synthesis_advisory_lens,
    section: DeclarationScope { declaration: lens_application_synthesis_root_declaration },
    root: synthesis_gap_poly_input,
    config: LensEnforce {
      budget: Report {
        reason: SynthesisGapDecisionTree,
        at: node_locus(node: synthesis_gap_poly_input)
      },
    }
  ) {
    Rejected { diagnostics: d } =>
      d.head.reason == report_reason_to_diagnostic_reason(reason: SynthesisGapDecisionTree)
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn lens_application_synthesis_gap_enforce_rejection_holds() -> Bool {
  lens_application_synthesis_gap_enforce_rejects()
}
