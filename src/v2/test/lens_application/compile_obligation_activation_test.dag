module v2.test.lens_application.compile_obligation_activation

// THE CONTROLS SURVIVE THE RESTRUCTURE AND ARE RE-TARGETED. An earlier revision derived a nine-arm
// ladder here; the ladder was a fork of vocabulary that already exists and is gone. What the
// controls were actually testing was never the enum — it was that a receipt pair cannot be
// half-supplied, that residue must be named, and that a grouping refuses a bad membership — and
// each of those is a fact about the receipts or the bundle, so each control re-points at the fact
// rather than at the deleted arm.
import std.decl_ref { DeclarationRef, decl_ref }
import v2.compiler.compile { required_compile_lens_roster }
import v2.compiler.self_host.compile_obligation_activation {
  BundleMemberNotRegistered,
  BundleRosterEmpty,
  BundleWithoutMembers,
  ObligationBundle,
  ObligationBundleCoverageClosed,
  ObligationBundleCoverageRefused,
  SelfHostObligationReceipts,
  no_self_host_receipts,
  obligation_bundle_coverage,
  receipts_close_the_closure,
  receipts_qualify,
}
import v2.std.algebra { Cons, Empty, fold_list, length, list_reverse }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data probe_obligation: DeclarationRef = decl_ref(module_path: "v2.test.probe", decl_name: "alpha")
data probe_bundle: DeclarationRef = decl_ref(module_path: "v2.test.probe", decl_name: "bundle")

fn receipts(red: Bool, green: Bool) -> SelfHostObligationReceipts {
  SelfHostObligationReceipts {
    obligation: probe_obligation,
    reached_on_route: true,
    executed_with_witness: true,
    planted_red_refused: red,
    nearby_green_accepted: green,
    ledger_rows_observed: 3,
    findings_open: 0,
    unclassifiable_present: false,
    unclassifiable_carried_by_name: false,
  }
}

// THE POSITIVE CONTROL, so the refusals below are properties of the withheld observation rather
// than of a predicate that answers false for everything.
test fn both_halves_of_the_pair_qualify() -> Bool {
  receipts_qualify(r: receipts(red: true, green: true))
}

// THE ARM MOST EASILY FUDGED: a gate that refuses every subject refuses the planted red too, so a
// caught red alone says nothing about discrimination. §4b(1) wants the RED and an accepted positive
// control, and withholding either must fail.
test fn a_caught_red_without_an_accepted_green_does_not_qualify() -> Bool {
  !receipts_qualify(r: receipts(red: true, green: false))
}

test fn an_accepted_green_without_a_caught_red_does_not_qualify() -> Bool {
  !receipts_qualify(r: receipts(red: false, green: true))
}

// A ROUTE THAT WAS NEVER REACHED CANNOT QUALIFY ON LATER OBSERVATIONS: supplying the pair while the
// route is unreached must still fail, which is the "a late receipt cannot lift a missing early one"
// property, expressed as a fact about the receipts rather than as a rung.
test fn an_unreached_route_does_not_qualify_on_later_observations() -> Bool {
  !receipts_qualify(r: SelfHostObligationReceipts {
    obligation: probe_obligation,
    reached_on_route: false,
    executed_with_witness: true,
    planted_red_refused: true,
    nearby_green_accepted: true,
    ledger_rows_observed: 3,
    findings_open: 0,
    unclassifiable_present: false,
    unclassifiable_carried_by_name: false,
  })
}

test fn no_receipts_qualify_nothing() -> Bool {
  !receipts_qualify(r: no_self_host_receipts(obligation: probe_obligation))
}

fn residue(present: Bool, named: Bool) -> SelfHostObligationReceipts {
  SelfHostObligationReceipts {
    obligation: probe_obligation,
    reached_on_route: true,
    executed_with_witness: true,
    planted_red_refused: true,
    nearby_green_accepted: true,
    ledger_rows_observed: 3,
    findings_open: 0,
    unclassifiable_present: present,
    unclassifiable_carried_by_name: named,
  }
}

// UNCLASSIFIABLE RESIDUE CLOSES ONLY WHEN CARRIED BY NAME: silent residue leaves the closure open,
// named residue is open coverage someone can close.
test fn unnamed_residue_leaves_the_closure_open() -> Bool {
  !receipts_close_the_closure(r: residue(present: true, named: false))
}

test fn named_residue_closes_the_closure() -> Bool {
  receipts_close_the_closure(r: residue(present: true, named: true))
}

test fn open_findings_leave_the_closure_open() -> Bool {
  !receipts_close_the_closure(r: SelfHostObligationReceipts {
    obligation: probe_obligation,
    reached_on_route: true,
    executed_with_witness: true,
    planted_red_refused: true,
    nearby_green_accepted: true,
    ledger_rows_observed: 3,
    findings_open: 2,
    unclassifiable_present: false,
    unclassifiable_carried_by_name: false,
  })
}

// A BUNDLE OVER A MEMBER NOBODY REGISTERED IS A GROUPING OVER NOTHING, and it refuses rather than
// reporting a standing for a subject that does not exist.
test fn a_bundle_member_that_is_not_registered_refuses() -> Bool {
  match obligation_bundle_coverage(bundles: [
    ObligationBundle { bundle: probe_bundle, members: [probe_obligation] }
  ]) {
    ObligationBundleCoverageRefused { cause: cause } =>
      match cause {
        BundleMemberNotRegistered { member: _ } => true
        BundleWithoutMembers { bundle: _ } => false
        BundleRosterEmpty => false
      }
    ObligationBundleCoverageClosed { roster_digest: _, bundles: _, members: _ } => false
  }
}

// AN EMPTY BUNDLE IS A NAME WITH NO SUBJECT: it cannot make any member's silence visible, which is
// the only reason a bundle exists.
test fn an_empty_bundle_refuses() -> Bool {
  match obligation_bundle_coverage(bundles: [
    ObligationBundle { bundle: probe_bundle, members: [] }
  ]) {
    ObligationBundleCoverageRefused { cause: cause } =>
      match cause {
        BundleWithoutMembers { bundle: _ } => true
        BundleMemberNotRegistered { member: _ } => false
        BundleRosterEmpty => false
      }
    ObligationBundleCoverageClosed { roster_digest: _, bundles: _, members: _ } => false
  }
}

test fn an_empty_bundle_roster_refuses() -> Bool {
  match obligation_bundle_coverage(bundles: []) {
    ObligationBundleCoverageRefused { cause: cause } =>
      match cause {
        BundleRosterEmpty => true
        BundleWithoutMembers { bundle: _ } => false
        BundleMemberNotRegistered { member: _ } => false
      }
    ObligationBundleCoverageClosed { roster_digest: _, bundles: _, members: _ } => false
  }
}

// THE POSITIVE CONTROL FOR THE JOIN, over the REAL roster: a bundle whose members are registrations
// closes, and reports how many members it covers.
test fn a_bundle_over_real_registrations_closes() -> Bool {
  let members = list_reverse(xs: fold_list(
    xs: required_compile_lens_roster(),
    empty: Empty,
    cons: fn(acc, lens) { Cons { head: lens.identity, tail: acc } }
  ))
  match obligation_bundle_coverage(bundles: [
    ObligationBundle { bundle: probe_bundle, members: members }
  ]) {
    ObligationBundleCoverageClosed { roster_digest: _, bundles: b, members: m } =>
      b == 1 && m == length(xs: required_compile_lens_roster())
    ObligationBundleCoverageRefused { cause: _ } => false
  }
}
