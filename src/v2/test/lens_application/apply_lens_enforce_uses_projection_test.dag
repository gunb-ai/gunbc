module v2.test.lens_application.apply_lens_enforce_uses_projection

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.application {
  DeclarationId,
  DeclarationScope,
  EnforceableLens,
  Lens,
  LensEnforcement,
  apply_lens_enforce
}
import v2.std.diagnostic {
  Accepted,
  CorrectionNotModeled,
  Outcome,
  Rejected,
  Unavailable,
  outcome_accepted,
  outcome_rejected,
  textual_whole_file_diagnostic,
}
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  Cardinality,
  ComputationNode,
  Conj,
  Disj,
  Edge,
  Instantiation,
  Named,
  Node,
  Path,
  Symbol,
  TypeNode,
}

data projection_test_section: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^projection_section_symbol } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data projection_test_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^projection_section_step },
      target: projection_test_section
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

// WHY THE FOUR REMAINING CONNECTIVES REFUSE RATHER THAN ANSWER. This fixture builds exactly
// two shapes -- an Atom section and a Conj root -- and its claim is that `apply_lens_enforce`
// routes the lens output through `project` before `violates`. `Disj`, `Arrow`, `Cardinality`
// and `Instantiation` carry no meaning THIS fixture has defined, so any Symbol returned for
// them would be a fabricated plausible output: the test would keep passing over a tree it was
// never written to describe. A refusal is the only answer the site establishes.
fn projection_test_unmodeled_connective() -> Outcome<Symbol> {
  outcome_rejected(
    textual_whole_file_diagnostic(
      reason: ^projection_test_connective_not_modeled,
      module_file: ^apply_lens_enforce_uses_projection_test,
      correction: Unavailable { reason: CorrectionNotModeled }
    )
  )
}

fn projection_test_read(root: Node) -> Outcome<Symbol> {
  match root.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(value: id)
    TypeNode { connective: Conj } => outcome_accepted(value: ^projection_test_symbol)
    TypeNode { connective: Disj } => projection_test_unmodeled_connective()
    TypeNode { connective: Arrow } => projection_test_unmodeled_connective()
    TypeNode { connective: Cardinality } => projection_test_unmodeled_connective()
    TypeNode { connective: Instantiation } => projection_test_unmodeled_connective()
    ComputationNode { behavior: _ } => outcome_accepted(value: ^projection_test_symbol)
  }
}

data projection_test_lens: Lens<Symbol> = Lens { read: projection_test_read }

fn projection_test_project(output: Symbol) -> Symbol {
  ^projection_projected_symbol
}

fn projection_test_violates(output: Symbol, declared: Symbol) -> Bool {
  output == ^projection_budget_fail && declared == ^projection_budget_fail
}

data projection_test_enforcement: LensEnforcement<Symbol, Symbol, Symbol> = LensEnforcement {
  project: projection_test_project,
  violates: projection_test_violates
}

data projection_test_enforceable: EnforceableLens<Symbol, Symbol, Symbol> = EnforceableLens {
  lens: projection_test_lens,
  enforcement: projection_test_enforcement
}

data projection_test_declaration: DeclarationId = DeclarationId {
  path: Path { steps: [^projection_section_step] }
}

test fn apply_lens_enforce_projection_claim_holds() -> Bool {
  match apply_lens_enforce(
    enforceable: projection_test_enforceable,
    section: DeclarationScope { declaration: projection_test_declaration },
    root: projection_test_root,
    budget: ^projection_budget_ok
  ) {
    Accepted { value: result, diagnostics: _ } =>
      result.output == ^projection_section_symbol && result.projected == ^projection_projected_symbol
    Rejected { diagnostics: _ } => false
  }
}
