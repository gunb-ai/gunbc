module v2.test.occurrence_census.authored_occurrence_census

import std.occurrence_identity { NodeOccurrenceIdentity, OccurrenceId, OccurrenceMinted, OccurrenceProjected, OccurrenceSynthetic, ScopedOccurrenceRef }
import std.algebra { Cons, Empty }
import std.content_hash { content_hash_atom }
import v2.compiler.inferred_tree { authored_occurrence_collisions }
import v2.compiler.compile {
  NativeLaneOccurrenceCensusRow,
  NativeLaneOccurrenceCollision,
  native_lane_occurrence_census,
  native_lane_occurrence_census_lines
}
import v2.std.algebra { length, list_map }
import v2.std.node { Atom, ComputationNode, Conj, Edge, Node, Positional, Symbol, Transform, TypeNode }

// The census walk and its reader are the interface under test, so their inputs are SUPPLIED: small
// trees with a known answer and hand-built rows. The real route (the native lane) is the inhabitance
// run whose receipt #12605 carries.

fn aoc_minted(n: Int) -> NodeOccurrenceIdentity {
  OccurrenceMinted { id: OccurrenceId { value: n } }
}

fn aoc_atom(name: Symbol, occ: NodeOccurrenceIdentity) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: name } }, children: [], occurrence_id: occ }
}

fn aoc_root(children: List<Node>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_map(xs: children, f: fn(c) { Edge { label: Positional, target: c } }),
    occurrence_id: OccurrenceSynthetic
  }
}

// ONE REAL COLLISION: two different nodes, one minted occurrence, one of them nested a level down
// so the walk must descend to find it. Exactly one collision, carrying that occurrence.
test fn aoc_two_different_nodes_under_one_minted_occurrence_is_one_collision() -> Bool {
  let cs = authored_occurrence_collisions(root: aoc_root(children: [
    aoc_atom(name: ^a, occ: aoc_minted(n: 7)),
    aoc_root(children: [aoc_atom(name: ^b, occ: aoc_minted(n: 7))])
  ]))
  match cs {
    Cons { head: c, tail: Empty } => c.occurrence.value == 7
    _ => false
  }
}

// The projected arm is an authored occurrence too.
test fn aoc_projected_occurrence_collides_with_minted_of_the_same_id() -> Bool {
  let projected = OccurrenceProjected {
    id: OccurrenceId { value: 9 },
    caused_by: ScopedOccurrenceRef { scope: content_hash_atom(value: "aoc-projection-cause-scope"), occurrence: OccurrenceId { value: 1 } }
  }
  length(xs: authored_occurrence_collisions(root: aoc_root(children: [
    aoc_atom(name: ^a, occ: aoc_minted(n: 9)),
    aoc_atom(name: ^b, occ: projected)
  ]))) == 1
}

// CONTROL: two different SYNTHETIC nodes have no authored occurrence and are not a collision.
test fn aoc_synthetic_duplicates_are_not_collisions() -> Bool {
  length(xs: authored_occurrence_collisions(root: aoc_root(children: [
    aoc_atom(name: ^a, occ: OccurrenceSynthetic),
    aoc_atom(name: ^b, occ: OccurrenceSynthetic)
  ]))) == 0
}

// CONTROL: the SAME node reached twice (a shared subtree) is one node, not a collision.
test fn aoc_same_node_reached_twice_is_not_a_collision() -> Bool {
  let shared = aoc_atom(name: ^a, occ: aoc_minted(n: 7))
  length(xs: authored_occurrence_collisions(root: aoc_root(children: [shared, shared]))) == 0
}

// CONTROL: distinct occurrences on distinct nodes report nothing.
test fn aoc_distinct_occurrences_report_nothing() -> Bool {
  length(xs: authored_occurrence_collisions(root: aoc_root(children: [
    aoc_atom(name: ^a, occ: aoc_minted(n: 7)),
    aoc_atom(name: ^b, occ: aoc_minted(n: 8))
  ]))) == 0
}

fn aoc_collision() -> NativeLaneOccurrenceCollision {
  NativeLaneOccurrenceCollision {
    occurrence: 7,
    first_kind: TypeNode { connective: Conj },
    second_kind: ComputationNode { behavior: Transform }
  }
}

// THE READER'S ACCOUNTING. Five modules in the universe, two resolved rows (one colliding, one clean):
// observed is the row count, the clean row is not reported as colliding, and the three modules with no
// row are reported UNOBSERVED -- never folded into the clean count.
test fn aoc_census_counts_unresolved_modules_as_unobserved() -> Bool {
  let c = native_lane_occurrence_census(universe: 5, rows: [
    NativeLaneOccurrenceCensusRow { module: "m.colliding", collisions: [aoc_collision()] },
    NativeLaneOccurrenceCensusRow { module: "m.clean", collisions: [] }
  ])
  let head_ok = match native_lane_occurrence_census_lines(c: c) {
    Cons { head: h, tail: _ } => h == "[native-occurrence-census] universe=5 observed=2 unobserved=3 colliding_modules=1"
    Empty => false
  }
  let colliding_ok = match c.colliding {
    Cons { head: r, tail: Empty } => r.module == "m.colliding"
    _ => false
  }
  c.observed == 2 && head_ok && colliding_ok
}

// No rows at all is all-unobserved, not all-clean.
test fn aoc_census_with_no_rows_is_all_unobserved() -> Bool {
  match native_lane_occurrence_census_lines(c: native_lane_occurrence_census(universe: 4, rows: [])) {
    Cons { head: h, tail: Empty } => h == "[native-occurrence-census] universe=4 observed=0 unobserved=4 colliding_modules=0"
    _ => false
  }
}
