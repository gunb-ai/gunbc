// src/v2/test/lens_mock_totality/diagnostic_mock_totality_test.dag
// Scope: §5 PROOF that v2.lens.mock_totality GATES by execution over the diagnostic layer's
//        published mock corpus — GREEN when the consumer is total, RED when a member is omitted.
// Status: discoverable `test fn` witness — the CI floor gates it via
//         `claim_batch --roster-from-discovery` (whole src/v2 scanned for `test fn` in
//         `*_test.dag`). Mirrors the M4.0 filesystem / breadth-roll shell pilot (#5238).
//
// The diagnostic layer is the MULTI-SERVICE shape (diagnostic.ssh.Session / redfish.Http /
// diagnostic.edac.RasMcCtl / diagnostic.ipmi.Tool — twelve published ops total) — the published
// corpus is a flat List spanning all of them, so this single totality witness covers the whole
// layer.
//
// The two witnesses are a discriminating pair (DESIGN.md §5: a real consumer GREEN by execution
// PLUS a discriminating input that goes RED when the behaviour is wrong):
//   - the REAL consumer handles every published case  → lens Accepts  → `..._is_total_holds`.
//   - a consumer with `SelList` deliberately OMITTED → lens Rejects → `..._omitted_member_is_red`.
// The second is the teeth: it goes GREEN only because the lens FAIL-CLOSES on the unhandled
// member — a vacuous lens that always accepted would flip it RED.

module v2.test.lens_mock_totality.diagnostic_mock_totality

import v2.lens.mock_totality { mock_unhandled_rejection }
import v2.test.lens_mock_totality.witness_template {
  mock_totality_green_holds,
  mock_totality_red_on_omission_holds,
  omit_consumer_handles,
  outcome_accepted_p
}
import extdeps.diagnostic.mock_corpus {
  PublishedMockCase,
  diagnostic_published_mock_corpus
}
import v2.std.collection { List }
import v2.std.diagnostic { Outcome, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

type MaterializedDiagnosticMock {
  tag: Symbol
}

data diagnostic_red_omit_keys: List<String> = ["diagnostic.ipmi.Tool.SelList"]

fn materialize_diagnostic_mock(case: PublishedMockCase) -> Outcome<MaterializedDiagnosticMock> {
  if case.operation_key == "diagnostic.ssh.Session.Exec" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_ssh_exec })
  } else if case.operation_key == "diagnostic.ssh.Session.Reachability" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_ssh_reachability })
  } else if case.operation_key == "redfish.Http.GetSensors" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_redfish_get_sensors })
  } else if case.operation_key == "redfish.Http.GetSystem" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_redfish_get_system })
  } else if case.operation_key == "redfish.Http.GetSystemWithNetrc" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_redfish_get_system_with_netrc })
  } else if case.operation_key == "redfish.Http.GetChassisSensors" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_redfish_get_chassis_sensors })
  } else if case.operation_key == "redfish.Http.GetPower" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_redfish_get_power })
  } else if case.operation_key == "redfish.Http.GetThermal" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_redfish_get_thermal })
  } else if case.operation_key == "diagnostic.edac.RasMcCtl.CorrectableCounts" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_edac_correctable_counts })
  } else if case.operation_key == "diagnostic.ipmi.Tool.SensorList" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_ipmi_sensor_list })
  } else if case.operation_key == "diagnostic.ipmi.Tool.SdrList" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_ipmi_sdr_list })
  } else if case.operation_key == "diagnostic.ipmi.Tool.SelList" {
    outcome_accepted(value: MaterializedDiagnosticMock { tag: ^materialized_ipmi_sel_list })
  } else {
    mock_unhandled_rejection()
  }
}

fn diagnostic_real_consumer_handles(case: PublishedMockCase) -> Bool {
  outcome_accepted_p(outcome: materialize_diagnostic_mock(case: case))
}

fn diagnostic_omits_sel_list_consumer_handles(case: PublishedMockCase) -> Bool {
  omit_consumer_handles(
    case: case,
    omit_keys: diagnostic_red_omit_keys,
    total_consumer_handles: diagnostic_real_consumer_handles
  )
}

test fn diagnostic_mock_consumer_is_total_holds() -> Bool {
  mock_totality_green_holds(
    published: diagnostic_published_mock_corpus,
    consumer_handles: diagnostic_real_consumer_handles
  )
}

test fn diagnostic_mock_omitted_member_is_red_holds() -> Bool {
  mock_totality_red_on_omission_holds(
    published: diagnostic_published_mock_corpus,
    consumer_handles: diagnostic_omits_sel_list_consumer_handles
  )
}
