module v2.test.lens_mock_totality.witness_template


fn published_mock_case_eq(a: PublishedMockCase, b: PublishedMockCase) -> Bool {
  a.operation_key == b.operation_key && a.case_id == b.case_id
}

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

fn operation_key_in_omit_set(case: PublishedMockCase, omit_keys: List<String>) -> Bool {
  contains(xs: omit_keys, item: case.operation_key, eq: string_eq)
}

fn omit_consumer_handles(
  case: PublishedMockCase,
  omit_keys: List<String>,
  total_consumer_handles: fn(PublishedMockCase) -> Bool
) -> Bool {
  if operation_key_in_omit_set(case: case, omit_keys: omit_keys) {
    false
  } else {
    total_consumer_handles(case: case)
  }
}

fn outcome_accepted_p<M>(outcome: Outcome<M>) -> Bool {
  match outcome {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn mock_totality_handled_by(
  published: List<PublishedMockCase>,
  consumer_handles: fn(PublishedMockCase) -> Bool
) -> List<PublishedMockCase> {
  filter(xs: published, predicate: consumer_handles)
}

fn mock_totality_green_holds(
  published: List<PublishedMockCase>,
  consumer_handles: fn(PublishedMockCase) -> Bool
) -> Bool {
  match mock_totality_lens(
    published: published,
    handled: mock_totality_handled_by(published: published, consumer_handles: consumer_handles),
    eq: published_mock_case_eq
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn mock_totality_red_on_omission_holds(
  published: List<PublishedMockCase>,
  consumer_handles: fn(PublishedMockCase) -> Bool
) -> Bool {
  match mock_totality_lens(
    published: published,
    handled: mock_totality_handled_by(published: published, consumer_handles: consumer_handles),
    eq: published_mock_case_eq
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
