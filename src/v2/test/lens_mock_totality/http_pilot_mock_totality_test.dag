module v2.test.lens_mock_totality.http_pilot_mock_totality

import v2.lens.mock_totality { mock_unhandled_rejection }
import v2.test.lens_mock_totality.witness_template {
  mock_totality_green_holds,
  mock_totality_red_on_omission_holds,
  omit_consumer_handles,
  outcome_accepted_p
}

import extdeps.test.mock_corpus {
  PublishedMockCase,
  http_pilot_published_mock_corpus
}
import v2.std.collection { List }
import v2.std.diagnostic { Outcome, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

type MaterializedHttpPilotMock {
  tag: Symbol
}

data http_pilot_red_omit_keys: List<String> = ["test.HttpPilot.GetPost"]

fn materialize_http_pilot_mock(case: PublishedMockCase) -> Outcome<MaterializedHttpPilotMock> {
  if case.operation_key == "test.HttpPilot.GetPost" {
    outcome_accepted(value: MaterializedHttpPilotMock { tag: ^materialized_get_post })
  } else {
    mock_unhandled_rejection()
  }
}

fn real_consumer_handles(case: PublishedMockCase) -> Bool {
  outcome_accepted_p(outcome: materialize_http_pilot_mock(case: case))
}

fn omits_get_post_consumer_handles(case: PublishedMockCase) -> Bool {
  omit_consumer_handles(
    case: case,
    omit_keys: http_pilot_red_omit_keys,
    total_consumer_handles: real_consumer_handles
  )
}

test fn http_pilot_mock_consumer_is_total_holds() -> Bool {
  mock_totality_green_holds(
    published: http_pilot_published_mock_corpus,
    consumer_handles: real_consumer_handles
  )
}

test fn http_pilot_mock_omitted_member_is_red_holds() -> Bool {
  mock_totality_red_on_omission_holds(
    published: http_pilot_published_mock_corpus,
    consumer_handles: omits_get_post_consumer_handles
  )
}
