// src/v2/test/lens_mock_totality/llm_mock_totality_test.dag
// Scope: §5 PROOF that v2.lens.mock_totality GATES by execution over the llm layer's published
//        mock corpus — GREEN when the consumer is total, RED when a member is omitted.
// Status: discoverable `test fn` witness — the CI floor gates it via
//         `claim_batch --roster-from-discovery` (whole src/v2 scanned for `test fn` in
//         `*_test.dag`). Mirrors the M4.0 filesystem witness exactly (#5188).
//
// The llm layer spans four services (OpenAI / Anthropic / Codex / Gemini) across three realization
// homes — the published corpus is a flat List spanning all six mocked ops, so this single totality
// witness covers the whole layer.
//
// The two witnesses are a discriminating pair (DESIGN.md §5: a real consumer GREEN by execution
// PLUS a discriminating input that goes RED when the behaviour is wrong):
//   - the REAL consumer handles every published case  → lens Accepts  → `..._is_total_holds`.
//   - a consumer with `llm.Gemini.CliPrompt` deliberately OMITTED → lens Rejects →
//     `..._omitted_member_is_red`.
// The second is the teeth: it goes GREEN only because the lens FAIL-CLOSES on the unhandled
// member — a vacuous lens that always accepted would flip it RED.

module v2.test.lens_mock_totality.llm_mock_totality

import v2.lens.mock_totality { mock_totality_lens, mock_unhandled_rejection }
// Single authority for the llm mock corpus lives in the dsl/ tree
// (dsl/extdeps/llm/mock_corpus.dag) so the v1 runtime reads the SAME model this lens does (M4
// hermetic-realization fold). Cross-tree v2->dsl import is the existing pattern.
import extdeps.llm.mock_corpus {
  PublishedMockCase,
  llm_published_mock_corpus
}
import v2.std.algebra { filter }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Outcome, Rejected, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

// The materialized mock value. A Symbol tag is enough to prove materialization RAN impl-blind;
// response payloads live in the Phase-2 RecordedFixture store (§3), not in the corpus row.
type MaterializedLlmMock {
  tag: Symbol
}

// The REAL consumer: materializes ANY published llm case impl-blind, keyed on the operation_key
// across all six published ops; fail-closes (the canonical `mock_unhandled_rejection`) for an
// unpublished op.
fn materialize_llm_mock(case: PublishedMockCase) -> Outcome<MaterializedLlmMock> {
  if case.operation_key == "llm.OpenAI.ChatCompletion" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_openai_chat_completion })
  } else if case.operation_key == "llm.OpenAI.Responses" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_openai_responses })
  } else if case.operation_key == "llm.Anthropic.Messages" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_anthropic_messages })
  } else if case.operation_key == "llm.Anthropic.CliPrompt" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_anthropic_cli_prompt })
  } else if case.operation_key == "llm.Codex.Review" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_codex_review })
  } else if case.operation_key == "llm.Gemini.CliPrompt" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_gemini_cli_prompt })
  } else {
    mock_unhandled_rejection()
  }
}

// The DELIBERATELY-INCOMPLETE consumer: omits `llm.Gemini.CliPrompt` → fail-closes on that case.
fn materialize_llm_mock_omits_gemini_cli_prompt(case: PublishedMockCase) -> Outcome<MaterializedLlmMock> {
  if case.operation_key == "llm.OpenAI.ChatCompletion" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_openai_chat_completion })
  } else if case.operation_key == "llm.OpenAI.Responses" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_openai_responses })
  } else if case.operation_key == "llm.Anthropic.Messages" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_anthropic_messages })
  } else if case.operation_key == "llm.Anthropic.CliPrompt" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_anthropic_cli_prompt })
  } else if case.operation_key == "llm.Codex.Review" {
    outcome_accepted(value: MaterializedLlmMock { tag: ^materialized_codex_review })
  } else {
    mock_unhandled_rejection()
  }
}

fn llm_mock_case_eq(a: PublishedMockCase, b: PublishedMockCase) -> Bool {
  a.operation_key == b.operation_key && a.case_id == b.case_id
}

fn llm_real_consumer_handles(case: PublishedMockCase) -> Bool {
  match materialize_llm_mock(case: case) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn llm_omits_gemini_cli_prompt_consumer_handles(case: PublishedMockCase) -> Bool {
  match materialize_llm_mock_omits_gemini_cli_prompt(case: case) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn llm_handled_by(consumer_handles: fn(PublishedMockCase) -> Bool) -> List<PublishedMockCase> {
  filter(xs: llm_published_mock_corpus, predicate: consumer_handles)
}

test fn llm_mock_consumer_is_total_holds() -> Bool {
  match mock_totality_lens(
    published: llm_published_mock_corpus,
    handled: llm_handled_by(consumer_handles: llm_real_consumer_handles),
    eq: llm_mock_case_eq
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn llm_mock_omitted_member_is_red_holds() -> Bool {
  match mock_totality_lens(
    published: llm_published_mock_corpus,
    handled: llm_handled_by(consumer_handles: llm_omits_gemini_cli_prompt_consumer_handles),
    eq: llm_mock_case_eq
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
