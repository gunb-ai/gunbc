module v2.test.lens_mock_totality.shell_mock_totality


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type MaterializedShellMock {
  tag: Symbol
}

data shell_red_omit_keys: List<String> = ["shell.Exec.Run"]

fn materialize_shell_mock(case: PublishedMockCase) -> Outcome<MaterializedShellMock> {
  if case.operation_key == "shell.Find.ListDirs" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedShellMock { tag: ^materialized_find_list_dirs })
  } else if case.operation_key == "shell.Exec.Run" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedShellMock { tag: ^materialized_exec_run })
  } else if case.operation_key == "shell.Exec.Check" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedShellMock { tag: ^materialized_exec_check })
  } else {
    v2.lens.mock_totality.mock_unhandled_rejection()
  }
}

fn shell_real_consumer_handles(case: PublishedMockCase) -> Bool {
  v2.test.lens_mock_totality.witness_template.outcome_accepted_p(outcome: materialize_shell_mock(case: case))
}

fn shell_omits_exec_run_consumer_handles(case: PublishedMockCase) -> Bool {
  v2.test.lens_mock_totality.witness_template.omit_consumer_handles(
    case: case,
    omit_keys: shell_red_omit_keys,
    total_consumer_handles: shell_real_consumer_handles
  )
}

test fn shell_mock_consumer_is_total_holds() -> Bool {
  v2.test.lens_mock_totality.witness_template.mock_totality_green_holds(
    published: extdeps.shell.mock_corpus.shell_published_mock_corpus,
    consumer_handles: shell_real_consumer_handles
  )
}

test fn shell_mock_omitted_member_is_red_holds() -> Bool {
  v2.test.lens_mock_totality.witness_template.mock_totality_red_on_omission_holds(
    published: extdeps.shell.mock_corpus.shell_published_mock_corpus,
    consumer_handles: shell_omits_exec_run_consumer_handles
  )
}
