// src/v2/test/lens_mock_totality/github_mock_totality_test.dag
// Scope: §5 PROOF that v2.lens.mock_totality GATES by execution over the github layer's published
//        mock corpus — GREEN when the consumer is total, RED when a member is omitted.
// Status: discoverable `test fn` witness — the CI floor gates it via
//         `claim_batch --roster-from-discovery` (whole src/v2 scanned for `test fn` in
//         `*_test.dag`). Mirrors the M4.0 filesystem / breadth-roll shell+cron witnesses.
//
// The github layer spans two services (`github.Gist` / `github.Pulls`, eight published ops total)
// in one flat corpus — this single totality witness covers the whole layer.
//
// The two witnesses are a discriminating pair (DESIGN.md §5: a real consumer GREEN by execution
// PLUS a discriminating input that goes RED when the behaviour is wrong):
//   - the REAL consumer handles every published case  → lens Accepts  → `..._is_total_holds`.
//   - a consumer with `ListReviews` deliberately OMITTED → lens Rejects → `..._omitted_member_is_red`.
// The second is the teeth: it goes GREEN only because the lens FAIL-CLOSES on the unhandled
// member — a vacuous lens that always accepted would flip it RED.

module v2.test.lens_mock_totality.github_mock_totality

import v2.lens.mock_totality { mock_unhandled_rejection }
import v2.test.lens_mock_totality.witness_template {
  mock_totality_green_holds,
  mock_totality_red_on_omission_holds,
  omit_consumer_handles,
  outcome_accepted_p
}
import extdeps.github.mock_corpus {
  PublishedMockCase,
  github_published_mock_corpus
}
import v2.std.collection { List }
import v2.std.diagnostic { Outcome, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

type MaterializedGithubMock {
  tag: Symbol
}

data github_red_omit_keys: List<String> = ["github.Pulls.ListReviews"]

fn materialize_github_mock(case: PublishedMockCase) -> Outcome<MaterializedGithubMock> {
  if case.operation_key == "github.Gist.Create" {
    outcome_accepted(value: MaterializedGithubMock { tag: ^materialized_gist_create })
  } else if case.operation_key == "github.Pulls.List" {
    outcome_accepted(value: MaterializedGithubMock { tag: ^materialized_pulls_list })
  } else if case.operation_key == "github.Pulls.Get" {
    outcome_accepted(value: MaterializedGithubMock { tag: ^materialized_pulls_get })
  } else if case.operation_key == "github.Pulls.Diff" {
    outcome_accepted(value: MaterializedGithubMock { tag: ^materialized_pulls_diff })
  } else if case.operation_key == "github.Pulls.CreateComment" {
    outcome_accepted(value: MaterializedGithubMock { tag: ^materialized_pulls_create_comment })
  } else if case.operation_key == "github.Pulls.ListReviews" {
    outcome_accepted(value: MaterializedGithubMock { tag: ^materialized_pulls_list_reviews })
  } else if case.operation_key == "github.Pulls.CreateReview" {
    outcome_accepted(value: MaterializedGithubMock { tag: ^materialized_pulls_create_review })
  } else if case.operation_key == "github.Pulls.ListComments" {
    outcome_accepted(value: MaterializedGithubMock { tag: ^materialized_pulls_list_comments })
  } else {
    mock_unhandled_rejection()
  }
}

fn github_real_consumer_handles(case: PublishedMockCase) -> Bool {
  outcome_accepted_p(outcome: materialize_github_mock(case: case))
}

fn github_omits_list_reviews_consumer_handles(case: PublishedMockCase) -> Bool {
  omit_consumer_handles(
    case: case,
    omit_keys: github_red_omit_keys,
    total_consumer_handles: github_real_consumer_handles
  )
}

test fn github_mock_consumer_is_total_holds() -> Bool {
  mock_totality_green_holds(
    published: github_published_mock_corpus,
    consumer_handles: github_real_consumer_handles
  )
}

test fn github_mock_omitted_member_is_red_holds() -> Bool {
  mock_totality_red_on_omission_holds(
    published: github_published_mock_corpus,
    consumer_handles: github_omits_list_reviews_consumer_handles
  )
}
