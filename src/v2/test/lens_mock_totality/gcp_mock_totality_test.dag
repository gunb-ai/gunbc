// src/v2/test/lens_mock_totality/gcp_mock_totality_test.dag
// Scope: §5 PROOF that v2.lens.mock_totality GATES by execution over the GCP cloud layer's
//        published mock corpus — GREEN when the consumer is total, RED when a member is omitted.
// Status: discoverable `test fn` witness — the CI floor gates it via
//         `claim_batch --roster-from-discovery` (whole src/v2 scanned for `test fn` in
//         `*_test.dag`). Modeled on the M4.0 filesystem witness (#5188) / shell witness (#5238).
//
// The GCP layer is the MULTI-SERVICE shape (9 services, 13 published ops total) —
// the published corpus is a flat List spanning all of them, so this single totality witness
// covers the whole layer.
//
// The two witnesses are a discriminating pair (DESIGN.md §5: a real consumer GREEN by execution
// PLUS a discriminating input that goes RED when the behaviour is wrong):
//   - the REAL consumer handles every published case  → lens Accepts  → `..._is_total_holds`.
//   - a consumer with `gcp.SecretManager.AddVersion` deliberately OMITTED
//                                                    → lens Rejects → `..._omitted_member_is_red`.
// The second is the teeth: it goes GREEN only because the lens FAIL-CLOSES on the unhandled
// member — a vacuous lens that always accepted would flip it RED.

module v2.test.lens_mock_totality.gcp_mock_totality

import v2.lens.mock_totality { mock_unhandled_rejection }
import v2.test.lens_mock_totality.witness_template {
  mock_totality_green_holds,
  mock_totality_red_on_omission_holds,
  omit_consumer_handles,
  outcome_accepted_p
}
import extdeps.cloud.gcp.mock_corpus {
  PublishedMockCase,
  gcp_published_mock_corpus
}
import v2.std.collection { List }
import v2.std.diagnostic { Outcome, outcome_accepted }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

type MaterializedGcpMock {
  tag: Symbol
}

data gcp_red_omit_keys: List<String> = ["gcp.SecretManager.AddVersion"]

fn materialize_gcp_mock(case: PublishedMockCase) -> Outcome<MaterializedGcpMock> {
  if case.operation_key == "gcloud.Auth.Login" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcloud_auth_login })
  } else if case.operation_key == "gcloud.Auth.ReadADC" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcloud_auth_read_adc })
  } else if case.operation_key == "oauth2.Google.Refresh" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_oauth2_google_refresh })
  } else if case.operation_key == "shell.GCloud.AuthPrintAccessToken" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_shell_gcloud_auth_print_access_token })
  } else if case.operation_key == "gcp.IAM.GenerateAccessToken" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_iam_generate_access_token })
  } else if case.operation_key == "gcp.ResourceManager.GetIamPolicy" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_resource_manager_get_iam_policy })
  } else if case.operation_key == "gcp.ResourceManager.SetIamPolicy" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_resource_manager_set_iam_policy })
  } else if case.operation_key == "gcp.SecretManager.AccessVersion" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_secret_manager_access_version })
  } else if case.operation_key == "gcp.SecretManager.CreateSecret" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_secret_manager_create_secret })
  } else if case.operation_key == "gcp.SecretManager.AddVersion" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_secret_manager_add_version })
  } else if case.operation_key == "gcp.STS.Exchange" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_sts_exchange })
  } else if case.operation_key == "github.OIDC.GetToken" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_github_oidc_get_token })
  } else if case.operation_key == "gcp.Metadata.GetIdentityToken" {
    outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_metadata_get_identity_token })
  } else {
    mock_unhandled_rejection()
  }
}

fn gcp_real_consumer_handles(case: PublishedMockCase) -> Bool {
  outcome_accepted_p(outcome: materialize_gcp_mock(case: case))
}

fn gcp_omits_add_version_consumer_handles(case: PublishedMockCase) -> Bool {
  omit_consumer_handles(
    case: case,
    omit_keys: gcp_red_omit_keys,
    total_consumer_handles: gcp_real_consumer_handles
  )
}

test fn gcp_mock_consumer_is_total_holds() -> Bool {
  mock_totality_green_holds(
    published: gcp_published_mock_corpus,
    consumer_handles: gcp_real_consumer_handles
  )
}

test fn gcp_mock_omitted_member_is_red_holds() -> Bool {
  mock_totality_red_on_omission_holds(
    published: gcp_published_mock_corpus,
    consumer_handles: gcp_omits_add_version_consumer_handles
  )
}
