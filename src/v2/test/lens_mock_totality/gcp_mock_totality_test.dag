module v2.test.lens_mock_totality.gcp_mock_totality


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type MaterializedGcpMock {
  tag: Symbol
}

data gcp_red_omit_keys: List<String> = ["gcp.SecretManager.AddVersion"]

fn materialize_gcp_mock(case: PublishedMockCase) -> Outcome<MaterializedGcpMock> {
  if case.operation_key == "gcloud.Auth.Login" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcloud_auth_login })
  } else if case.operation_key == "oauth2.Google.Refresh" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_oauth2_google_refresh })
  } else if case.operation_key == "shell.GCloud.AuthPrintAccessToken" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_shell_gcloud_auth_print_access_token })
  } else if case.operation_key == "gcp.IAM.GenerateAccessToken" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_iam_generate_access_token })
  } else if case.operation_key == "gcp.ResourceManager.GetIamPolicy" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_resource_manager_get_iam_policy })
  } else if case.operation_key == "gcp.ResourceManager.SetIamPolicy" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_resource_manager_set_iam_policy })
  } else if case.operation_key == "gcp.SecretManager.AccessVersion" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_secret_manager_access_version })
  } else if case.operation_key == "gcp.SecretManager.CreateSecret" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_secret_manager_create_secret })
  } else if case.operation_key == "gcp.SecretManager.AddVersion" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_secret_manager_add_version })
  } else if case.operation_key == "gcp.STS.Exchange" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_sts_exchange })
  } else if case.operation_key == "github.OIDC.GetToken" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_github_oidc_get_token })
  } else if case.operation_key == "gcp.Metadata.GetIdentityToken" {
    v2.std.diagnostic.outcome_accepted(value: MaterializedGcpMock { tag: ^materialized_gcp_metadata_get_identity_token })
  } else {
    v2.lens.mock_totality.mock_unhandled_rejection()
  }
}

fn gcp_real_consumer_handles(case: PublishedMockCase) -> Bool {
  v2.test.lens_mock_totality.witness_template.outcome_accepted_p(outcome: materialize_gcp_mock(case: case))
}

fn gcp_omits_add_version_consumer_handles(case: PublishedMockCase) -> Bool {
  v2.test.lens_mock_totality.witness_template.omit_consumer_handles(
    case: case,
    omit_keys: gcp_red_omit_keys,
    total_consumer_handles: gcp_real_consumer_handles
  )
}

test fn gcp_mock_consumer_is_total_holds() -> Bool {
  v2.test.lens_mock_totality.witness_template.mock_totality_green_holds(
    published: extdeps.cloud.gcp.mock_corpus.gcp_published_mock_corpus,
    consumer_handles: gcp_real_consumer_handles
  )
}

test fn gcp_mock_omitted_member_is_red_holds() -> Bool {
  v2.test.lens_mock_totality.witness_template.mock_totality_red_on_omission_holds(
    published: extdeps.cloud.gcp.mock_corpus.gcp_published_mock_corpus,
    consumer_handles: gcp_omits_add_version_consumer_handles
  )
}
