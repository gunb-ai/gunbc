// ── admission: the fold collects every violated clause ─────────────────────────────────────

test fn one_red_run_names_every_violated_clause() -> Bool {
  let admission = native_route_admission(receipt: NativeRouteReceipt {
    job: "wrong-job",
    tested_tree: "",
    preparation_seed_identity: "",
    emitted_closure_identity: "",
    executable_path: "",
    executable_identity: "",
    universe: [],
    module_source_index: [],
    population: [],
    file_refusals: [],
    false_control: Absent,
    true_control: Absent,
    malformed_control: MalformedSpecimenAccepted,
    old_route_control: OldRouteControlAbsent
  })
  native_route_admission_refused_with(admission: admission, cause_name: "job_name_mismatch")
  && native_route_admission_refused_with(admission: admission, cause_name: "tested_tree_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "preparation_seed_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "emitted_closure_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "route_identity_unrecorded")
  && native_route_admission_refused_with(admission: admission, cause_name: "universe_underived")
  && native_route_admission_refused_with(admission: admission, cause_name: "positive_population_empty")
  && native_route_admission_refused_with(admission: admission, cause_name: "required_native_pass_regressed")
  && native_route_admission_refused_with(admission: admission, cause_name: "false_control_not_observed")
  && native_route_admission_refused_with(admission: admission, cause_name: "true_control_not_observed")
  && native_route_admission_refused_with(admission: admission, cause_name: "malformed_control_accepted_by_route")
  && native_route_admission_refused_with(admission: admission, cause_name: "old_route_control_never_installed")
}

test fn the_admission_summary_names_every_violated_clause() -> Bool {
  native_route_admission_summary(admission: native_route_admission(receipt: NativeRouteReceipt {
    job: "wrong-job",
    tested_tree: "",
    preparation_seed_identity: "",
    emitted_closure_identity: "",
    executable_path: "",
    executable_identity: "",
    universe: [],
    module_source_index: [],
    population: [],
    file_refusals: [],
    false_control: Absent,
    true_control: Absent,
    malformed_control: MalformedSpecimenAccepted,
    old_route_control: OldRouteControlAbsent
  })) == "refused: job_name_mismatch, tested_tree_unrecorded, preparation_seed_unrecorded, emitted_closure_unrecorded, route_identity_unrecorded, universe_underived, positive_population_empty, required_native_pass_regressed, false_control_not_observed, true_control_not_observed, malformed_control_accepted_by_route, old_route_control_never_installed"
}

// THE DERIVED UNIVERSE'S TWO PRE-JOIN FACTS, JUDGED HERE BECAUSE THE ROUTE NOW OWNS THEM. Both
// used to be the seed's: the module a source declares (its Rust module index) and the refusal a
// discovery row with no owning module gets (UniverseEntryOutsideSubject). They moved into
// v2.compiler.compile with the derivation, so their discriminating reds move with them.

test fn the_declared_module_is_read_off_the_header_and_nothing_else() -> Bool {
  native_lane_declared_module_name(
    content: "// a leading annotation\n\nmodule v2.test.subject\n\nimport v2.std.logic { Bool }\nmodule not.the.header\n"
  ) == "v2.test.subject"
}

test fn a_source_with_no_module_header_declares_no_module() -> Bool {
  native_lane_declared_module_name(content: "// only prose\ntest fn t() -> Bool { true }\n") == ""
}

// The headerless source that enrols a row is the one the derivation names; a headerless source
// that enrols nothing is not a defect and must not be named.
test fn a_discovery_row_whose_source_declares_no_module_refuses_the_derivation() -> Bool {
  let enrolled = FloorDiscoveryWalkState {
    rows: [FloorDiscoveryRow {
      label: "t",
      entry: "src/v2/test/headerless_test.dag",
      function: "t",
      reads_live_tree: SubstrateInputsOnly
    }],
    walk_failures: 0,
    walk_failure_path: Absent,
    sidecar_violations: [],
    disposition_refusal: Absent
  }
  let empty = FloorDiscoveryWalkState {
    rows: [],
    walk_failures: 0,
    walk_failure_path: Absent,
    sidecar_violations: [],
    disposition_refusal: Absent
  }
  native_lane_unowned_row_path(facts: [
    NativeLaneSourceFacts {
      module: "",
      path: ^src_v2_test_quiet_dag,
      imports: [],
      discovery: empty
    },
    NativeLaneSourceFacts {
      module: "",
      path: ^headerless_test_path,
      imports: [],
      discovery: enrolled
    }
  ]) == "headerless_test_path"
}

// The green receipt with one control swapped: the old-route arm is the only field under test in
// the two rows below, so every other field stays the admitted one rather than being re-authored.
fn green_receipt_with_old_route_control(control: NativeRouteOldRouteControl) -> NativeRouteReceipt {
  NativeRouteReceipt {
    job: green_receipt().job,
    tested_tree: green_receipt().tested_tree,
    preparation_seed_identity: green_receipt().preparation_seed_identity,
    emitted_closure_identity: green_receipt().emitted_closure_identity,
    executable_path: green_receipt().executable_path,
    executable_identity: green_receipt().executable_identity,
    universe: green_receipt().universe,
    module_source_index: green_receipt().module_source_index,
    population: green_receipt().population,
    file_refusals: green_receipt().file_refusals,
    false_control: green_receipt().false_control,
    true_control: green_receipt().true_control,
    malformed_control: green_receipt().malformed_control,
    old_route_control: control
  }
}

// A ROUTE THAT WAS NOT THERE IS A CLOSED FALLBACK, AND AN UNNAMED PATH IS STILL NOT AN OBSERVATION.
// The harness no longer requires the old route to exist so that it can move it, so the receipt can
// carry OldRouteNotPresentAtWindow; admission must hold it exactly as it holds a withdrawal, and
// must still refuse the arm whose path names nothing, which is the same empty-identity refusal the
// withdrawn arm gets.
test fn an_old_route_absent_for_the_window_closes_the_fallback() -> Bool {
  let receipt = green_receipt_with_old_route_control(
    control: OldRouteNotPresentAtWindow { expected_executable: "target/release/gunbc" }
  )
  native_route_admitted(admission: native_route_admission(receipt: receipt))
}

test fn an_absent_old_route_naming_nothing_is_refused() -> Bool {
  let receipt = green_receipt_with_old_route_control(
    control: OldRouteNotPresentAtWindow { expected_executable: "" }
  )
  native_route_admission_refused_with(
    admission: native_route_admission(receipt: receipt),
    cause_name: "old_route_control_never_installed"
  )
}

// ── the closure's discriminating RED ───────────────────────────────────────────────────────
//
// A MODULE OUTSIDE THE CLOSURE CHANGES NOTHING, AND THAT IS THE ACCEPTANCE (operator ruling
// 2026-09-11: prove closure-scoping by POPULATION, not by a faster clock, because a hidden
// whole-corpus prepass survives a timer improvement). The rows below drive the route's own closure
// computation with a fact set carrying a module NO universe module imports, and assert it is
// neither in the closure nor in what the route would ingest. The same shape is what makes a
// malformed outsider harmless: never in the ingest means never tokenized, so it cannot mint a
// refusal row or move a verdict.

fn closure_fact(module: String, path: Symbol, imports: List<String>) -> NativeLaneSourceFacts {
  NativeLaneSourceFacts {
    module: module,
    path: path,
    imports: imports,
    discovery: FloorDiscoveryWalkState {
      rows: [],
      walk_failures: 0,
      walk_failure_path: Absent,
      sidecar_violations: [],
      disposition_refusal: Absent
    }
  }
}

fn closure_probe_universe() -> NativeLaneUniverse {
  NativeLaneUniverse {
    modules: [NativeLaneUniverseModule {
      module: "v2.test.subject",
      path: ^src_v2_test_subject_test_dag,
      declarations: ["a_claim"]
    }],
    identities: [NativeRouteTestIdentity { module: "v2.test.subject", declaration: "a_claim" }],
    module_sources: [NativeRouteModuleSource { module: "v2.test.subject", path: ^src_v2_test_subject_test_dag }]
  }
}

fn closure_probe_facts() -> List<NativeLaneSourceFacts> {
  [
    closure_fact(module: "v2.test.subject", path: ^src_v2_test_subject_test_dag, imports: ["v2.std.logic"]),
    closure_fact(module: "v2.std.logic", path: ^src_v2_std_logic_dag, imports: []),
    closure_fact(module: "v2.native_lane_fixture.control", path: ^src_v2_native_lane_fixture_control_dag, imports: []),
    closure_fact(module: "v2.unrelated.outsider", path: ^src_v2_unrelated_outsider_dag, imports: ["v2.std.logic"])
  ]
}

fn native_lane_closure_budget_probe(budget: Int) -> Outcome<List<String>> {
  native_lane_closure_modules(facts: closure_probe_facts(), universe: closure_probe_universe(), budget: budget)
}

test fn the_closure_holds_what_the_universe_needs() -> Bool {
  match native_lane_closure_budget_probe(budget: native_lane_closure_round_budget) {
    Rejected { diagnostics: _ } => false
    Accepted { value: closure, diagnostics: _ } =>
      native_lane_module_named(xs: closure, name: "v2.test.subject")
      && native_lane_module_named(xs: closure, name: "v2.std.logic")
      && native_lane_module_named(xs: closure, name: native_route_live_control_module)
  }
}

test fn a_module_no_universe_member_imports_is_outside_the_closure() -> Bool {
  match native_lane_closure_budget_probe(budget: native_lane_closure_round_budget) {
    Rejected { diagnostics: _ } => false
    Accepted { value: closure, diagnostics: _ } =>
      !native_lane_module_named(xs: closure, name: "v2.unrelated.outsider")
  }
}

// THE BUDGET'S DISCRIMINATING PAIR (review 63719). The probe's closure is two rounds deep: the
// seeds expand to `v2.std.logic` in round one, and round two finds nothing new. A budget of one
// round leaves `v2.std.logic` on the frontier, and the walk must REFUSE the derivation by its typed
// reason rather than answer with the seeds it had seen — that truncated answer would still hold
// `v2.test.subject`, so a walk that absorbed the exhaustion passes every membership row above and
// fails only this one. A budget of exactly two rounds is the boundary: the frontier is empty when
// the fuel runs out, and the closure is accepted.
test fn an_exhausted_closure_budget_refuses_the_derivation() -> Bool {
  match native_lane_closure_budget_probe(budget: 1) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == ^native_lane_closure_budget_exhausted
  }
}

test fn a_closure_finishing_on_its_last_round_is_accepted() -> Bool {
  match native_lane_closure_budget_probe(budget: 2) {
    Rejected { diagnostics: _ } => false
    Accepted { value: closure, diagnostics: _ } => native_lane_module_named(xs: closure, name: "v2.std.logic")
  }
}

// ── the file refusals' composition ─────────────────────────────────────────────────────────
//
// THE TALLY COUNTS AT FATAL GRAIN, ONCE. `resolve_reason_unbound_symbol` is owned at BOTH grains in
// the cause table, so a tally that walked every row would count its refusal twice and the rows
// would sum past the receipt's population; the sum row below is what discriminates that. The two
// per-cause rows discriminate a tally that counted rows instead of refusals, or matched on the
// head reason.
fn native_route_tally_probe() -> List<NativeRouteCauseTally> {
  native_route_file_refusal_tally(receipt: receipt_over(
    universe: [],
    module_source_index: [],
    population: [],
    file_refusals: [
      file_refusal_row(path: ^tally_a, head: ^parse_grammar_choice_overlap_residue, fatal: ^parse_g0_tokens_remain),
      file_refusal_row(path: ^tally_b, head: ^parse_grammar_choice_overlap_residue, fatal: ^parse_g0_tokens_remain),
      file_refusal_row(path: ^tally_c, head: ^resolve_reason_unbound_symbol, fatal: ^resolve_reason_unbound_symbol)
    ]
  ))
}

fn native_route_tally_count_for(rows: List<NativeRouteCauseTally>, cause: Symbol) -> Int {
  fold_list(xs: rows, empty: 0, cons: fn(acc, row) {
    if row.cause == cause { acc + row.file_refusals } else { acc }
  })
}

test fn the_refusal_tally_counts_each_refusal_once_at_fatal_grain() -> Bool {
  let rows = native_route_tally_probe()
  (native_route_tally_count_for(rows: rows, cause: ^parse_g0_tokens_remain) == 2)
  && (native_route_tally_count_for(rows: rows, cause: ^resolve_reason_unbound_symbol) == 1)
  && (fold_list(xs: rows, empty: 0, cons: fn(acc, row) { acc + row.file_refusals }) == 3)
}
