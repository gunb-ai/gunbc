module v2.test.v2_native_route

import gunbc.witness_v2_native_route {
  NativeRouteVerdict, NativeAccepted, NativeRefused,
  NativeRouteMemberRow,
  NativeRouteExclusionCause, CompilerFrontierAttributed, NativeDriverAdmissionLimit, UnattributedRefusal,
  NativeRouteOldRouteControl, OldRouteWithdrawn, OldRouteFalsifierArmed, OldRouteControlAbsent,
  NativeRouteBrokenControl, BrokenSpecimenRefused, BrokenSpecimenAccepted,
  NativeRouteReceipt,
  NativeRouteAdmission, NativeRouteAdmitted, NativeRouteRefused,
  NativeRouteEnrolment, EnrolmentOpen, EnrolmentBlocked,
  required_v2_native_job_name,
  native_route_universe_member,
  native_route_universe,
  classify_native_refusal,
  native_route_exclusion_census,
  native_route_census_is_total,
  native_route_admission,
  native_route_admitted,
  native_route_admission_refused_with,
  native_route_admission_summary,
  native_route_enrolment,
  native_route_enrolment_standing,
  native_route_enrolment_blocked_today,
}
import std.algebra { Cons, Empty }
import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

fn receipt_with(
  population: List<NativeRouteMemberRow>,
  broken_control: NativeRouteBrokenControl,
  old_route_control: NativeRouteOldRouteControl
) -> NativeRouteReceipt {
  NativeRouteReceipt {
    job: required_v2_native_job_name,
    tested_tree: "tree-sha",
    preparation_seed_identity: "seed-sha",
    emitted_closure_identity: "closure-sha",
    executable_path: "/emitted/compiler",
    executable_identity: "binary-sha",
    population: population,
    broken_control: broken_control,
    old_route_control: old_route_control
  }
}

fn accepted_member(path: String) -> NativeRouteMemberRow {
  NativeRouteMemberRow { module_path: path, verdict: NativeAccepted }
}

fn refused_member(path: String, reason: Symbol) -> NativeRouteMemberRow {
  NativeRouteMemberRow {
    module_path: path,
    verdict: NativeRefused { head_reason: reason, fatal_reason: reason }
  }
}

fn green_receipt() -> NativeRouteReceipt {
  receipt_with(
    population: [
      accepted_member(path: "v2.test.one"),
      accepted_member(path: "v2.test.two"),
      refused_member(path: "v2.test.three", reason: ^fact_density_hollow_alias_locus)
    ],
    broken_control: BrokenSpecimenRefused { reason: ^parse_expected_declaration },
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" }
  )
}

// TODAY'S FRONTIER SHAPE: every universe member refused with an attributed cause, the broken
// specimen refused, both controls present — and admission still refuses, because an all-refused
// census proves the route refused, not that it routed.
fn frontier_receipt() -> NativeRouteReceipt {
  receipt_with(
    population: [
      refused_member(path: "v2.test.one", reason: ^parse_grammar_choice_overlap_residue),
      refused_member(path: "v2.test.two", reason: ^resolve_module_not_found)
    ],
    broken_control: BrokenSpecimenRefused { reason: ^parse_expected_declaration },
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" }
  )
}

test fn universe_membership_is_the_prefix_and_nothing_else() -> Bool {
  native_route_universe_member(module_qn: "v2.test.foo")
    && native_route_universe_member(module_qn: "v2.test.claim.long.bar")
    && !native_route_universe_member(module_qn: "v2.test")
    && !native_route_universe_member(module_qn: "v2.testlong.foo")
    && !native_route_universe_member(module_qn: "test.claim.infer_x")
    && !native_route_universe_member(module_qn: "v2.workflow.compile_door_ledger")
}

test fn universe_derivation_selects_exactly_the_prefix_members() -> Bool {
  let derived = native_route_universe(module_qns: [
    "v2.test.a",
    "v2.workflow.compile_door_ledger",
    "v2.test.claim.b",
    "gunbc.witness_floor_workflow"
  ])
  length(xs: derived) == 2
    && match derived {
      Cons { head: first, tail: rest } =>
        match rest {
          Cons { head: second, tail: Empty {} } =>
            first == "v2.test.a" && second == "v2.test.claim.b"
          Cons { head: _, tail: _ } => false
          Empty {} => false
        }
      Empty {} => false
    }
}

test fn refusal_classification_delegates_to_the_door_ledger_attribution() -> Bool {
  match classify_native_refusal(reason: ^fact_density_hollow_alias_locus) {
    CompilerFrontierAttributed { reason: r } => r == ^fact_density_hollow_alias_locus
    NativeDriverAdmissionLimit { reason: _ } => false
    UnattributedRefusal { reason: _ } => false
  }
}

test fn refusal_classification_owns_the_driver_admission_limit() -> Bool {
  match classify_native_refusal(reason: ^resolve_module_not_found) {
    NativeDriverAdmissionLimit { reason: r } => r == ^resolve_module_not_found
    CompilerFrontierAttributed { reason: _ } => false
    UnattributedRefusal { reason: _ } => false
  }
}

test fn refusal_classification_never_silently_buckets_an_unowned_cause() -> Bool {
  match classify_native_refusal(reason: ^a_cause_nobody_owns) {
    UnattributedRefusal { reason: r } => r == ^a_cause_nobody_owns
    CompilerFrontierAttributed { reason: _ } => false
    NativeDriverAdmissionLimit { reason: _ } => false
  }
}

test fn exclusion_census_counts_every_member_exactly_once() -> Bool {
  let rows = [
    accepted_member(path: "v2.test.a"),
    refused_member(path: "v2.test.b", reason: ^fact_density_hollow_alias_locus),
    refused_member(path: "v2.test.c", reason: ^resolve_module_not_found),
    refused_member(path: "v2.test.d", reason: ^a_cause_nobody_owns)
  ]
  let census = native_route_exclusion_census(rows: rows)
  census.accepted == 1
    && census.excluded_compiler_frontier == 1
    && census.excluded_driver_limit == 1
    && census.excluded_unattributed == 1
    && native_route_census_is_total(census: census, rows: rows)
}

test fn a_fully_met_contract_admits() -> Bool {
  native_route_admitted(admission: native_route_admission(receipt: green_receipt()))
}

test fn an_empty_positive_population_refuses_even_with_everything_else_held() -> Bool {
  let admission = native_route_admission(receipt: frontier_receipt())
  !native_route_admitted(admission: admission)
    && native_route_admission_refused_with(admission: admission, cause_name: "positive_population_empty")
}

test fn a_broken_specimen_the_route_accepts_kills_the_whole_census() -> Bool {
  let admission = native_route_admission(receipt: receipt_with(
    population: [accepted_member(path: "v2.test.one")],
    broken_control: BrokenSpecimenAccepted,
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" }
  ))
  native_route_admission_refused_with(admission: admission, cause_name: "broken_specimen_accepted_by_route")
}

test fn an_unattributed_exclusion_blocks_admission_until_someone_owns_it() -> Bool {
  let admission = native_route_admission(receipt: receipt_with(
    population: [
      accepted_member(path: "v2.test.one"),
      refused_member(path: "v2.test.two", reason: ^a_cause_nobody_owns)
    ],
    broken_control: BrokenSpecimenRefused { reason: ^parse_expected_declaration },
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" }
  ))
  native_route_admission_refused_with(admission: admission, cause_name: "unattributed_exclusions_present")
}

test fn route_identity_is_observed_never_synthesized_from_the_intended_command() -> Bool {
  let admission = native_route_admission(receipt: NativeRouteReceipt {
    job: required_v2_native_job_name,
    tested_tree: "tree-sha",
    preparation_seed_identity: "seed-sha",
    emitted_closure_identity: "closure-sha",
    executable_path: "",
    executable_identity: "",
    population: [accepted_member(path: "v2.test.one")],
    broken_control: BrokenSpecimenRefused { reason: ^parse_expected_declaration },
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" }
  })
  native_route_admission_refused_with(admission: admission, cause_name: "route_identity_unrecorded")
}

test fn an_uninstalled_old_route_control_refuses_by_name() -> Bool {
  let admission = native_route_admission(receipt: receipt_with(
    population: [accepted_member(path: "v2.test.one")],
    broken_control: BrokenSpecimenRefused { reason: ^parse_expected_declaration },
    old_route_control: OldRouteControlAbsent
  ))
  native_route_admission_refused_with(admission: admission, cause_name: "old_route_control_never_installed")
}

// The seed and the closure are separate observations with separate refusal names: a receipt
// recording the seed but not the closure must name emitted_closure_unrecorded, and one recording
// the closure but not the seed must name preparation_seed_unrecorded. Before the predicates were
// split, the first shape misreported as preparation_seed_unrecorded and the second cause had no
// reachable construction.
test fn an_unrecorded_closure_refuses_by_its_own_name() -> Bool {
  let admission = native_route_admission(receipt: NativeRouteReceipt {
    job: required_v2_native_job_name,
    tested_tree: "tree-sha",
    preparation_seed_identity: "seed-sha",
    emitted_closure_identity: "",
    executable_path: "/emitted/compiler",
    executable_identity: "binary-sha",
    population: [accepted_member(path: "v2.test.one")],
    broken_control: BrokenSpecimenRefused { reason: ^parse_expected_declaration },
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" }
  })
  native_route_admission_refused_with(admission: admission, cause_name: "emitted_closure_unrecorded")
    && !native_route_admission_refused_with(admission: admission, cause_name: "preparation_seed_unrecorded")
}

test fn an_unrecorded_seed_refuses_by_its_own_name() -> Bool {
  let admission = native_route_admission(receipt: NativeRouteReceipt {
    job: required_v2_native_job_name,
    tested_tree: "tree-sha",
    preparation_seed_identity: "",
    emitted_closure_identity: "closure-sha",
    executable_path: "/emitted/compiler",
    executable_identity: "binary-sha",
    population: [accepted_member(path: "v2.test.one")],
    broken_control: BrokenSpecimenRefused { reason: ^parse_expected_declaration },
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" }
  })
  native_route_admission_refused_with(admission: admission, cause_name: "preparation_seed_unrecorded")
    && !native_route_admission_refused_with(admission: admission, cause_name: "emitted_closure_unrecorded")
}

test fn one_red_run_names_every_violated_clause() -> Bool {
  let admission = native_route_admission(receipt: receipt_with(
    population: [refused_member(path: "v2.test.one", reason: ^a_cause_nobody_owns)],
    broken_control: BrokenSpecimenAccepted,
    old_route_control: OldRouteControlAbsent
  ))
  native_route_admission_refused_with(admission: admission, cause_name: "positive_population_empty")
    && native_route_admission_refused_with(admission: admission, cause_name: "broken_specimen_accepted_by_route")
    && native_route_admission_refused_with(admission: admission, cause_name: "unattributed_exclusions_present")
    && native_route_admission_refused_with(admission: admission, cause_name: "old_route_control_never_installed")
}

test fn a_receipt_naming_another_job_is_not_this_lanes_evidence() -> Bool {
  let admission = native_route_admission(receipt: NativeRouteReceipt {
    job: "some-other-job",
    tested_tree: "tree-sha",
    preparation_seed_identity: "seed-sha",
    emitted_closure_identity: "closure-sha",
    executable_path: "/emitted/compiler",
    executable_identity: "binary-sha",
    population: [accepted_member(path: "v2.test.one")],
    broken_control: BrokenSpecimenRefused { reason: ^parse_expected_declaration },
    old_route_control: OldRouteWithdrawn { withdrawn_executable: "/seed/gunbc" }
  })
  native_route_admission_refused_with(admission: admission, cause_name: "job_name_mismatch")
}

test fn enrolment_is_the_admission_question_asked_of_the_census() -> Bool {
  match native_route_enrolment(census: green_receipt()) {
    EnrolmentOpen => true
    EnrolmentBlocked { causes: _ } => false
  }
    && match native_route_enrolment(census: frontier_receipt()) {
      EnrolmentOpen => false
      EnrolmentBlocked { causes: causes } =>
        native_route_admission_refused_with(
          admission: NativeRouteRefused { causes: causes },
          cause_name: "positive_population_empty"
        )
    }
}

test fn the_admission_summary_names_every_violated_clause() -> Bool {
  native_route_admission_summary(admission: native_route_admission(receipt: frontier_receipt()))
    == "refused: positive_population_empty"
    && native_route_admission_summary(admission: native_route_admission(receipt: green_receipt())) == "admitted"
}

test fn the_standing_row_records_enrolment_blocked_on_the_door_frontier() -> Bool {
  native_route_enrolment_blocked_today(standing: native_route_enrolment_standing)
    && native_route_enrolment_standing.trigger != ""
    && native_route_enrolment_standing.enrolment_edit != ""
    && native_route_enrolment_standing.census_evidence != ""
}
