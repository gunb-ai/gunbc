// ── admission: the required-native ratchet ────────────────────────────────────────────────

// The rostered smoke identity, observed as an ATTRIBUTED exclusion — the exact collapse the
// ratchet exists to block: every clause about classification greens, and coverage still lost
// the identity.
test fn a_regressed_required_native_pass_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission(receipt: receipt_over(
      universe: [smoke_identity()],
      module_source_index: [smoke_source_row()],
      population: [refused_row(
        module: "v2.test.native_lane_smoke",
        declaration: "native_route_positive_population_smoke",
        stage: NativeTestStagePrepare,
        reason: ^parse_g0_tokens_remain
      )],
      file_refusals: []
    )),
    cause_name: "required_native_pass_regressed"
  )
}

// The smoke identity is not in the universe at all — coverage shrank silently. The omission
// clause cannot fire (the universe itself no longer names the member), so the ratchet is the
// only wall, and it reads the roster against the OBSERVED population.
