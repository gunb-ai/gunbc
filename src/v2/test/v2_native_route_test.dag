// THE REASON-ONLY JOIN IS THE HOLE THIS CLAUSE CLOSED. The file refusal below carries the
// Context row's exact fatal reason, but at ANOTHER MODULE'S path — under the pre-repair clause
// (any file anywhere with the reason) this receipt was admitted.
test fn a_context_refusal_backed_by_another_modules_file_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission(receipt: receipt_over(
      universe: [
        test_identity(module: "v2.test.alpha", declaration: "passes"),
        test_identity(module: "v2.test.beta", declaration: "blocked")
      ],
      module_source_index: [
        NativeRouteModuleSource { module: "v2.test.alpha", path: ^alpha_path },
        NativeRouteModuleSource { module: "v2.test.beta", path: ^beta_path }
      ],
      population: [
        passed_row(module: "v2.test.alpha", declaration: "passes"),
        refused_row(
          module: "v2.test.beta",
          declaration: "blocked",
          stage: NativeTestStageContext,
          reason: ^parse_g0_tokens_remain
        )
      ],
      file_refusals: [file_refusal_row(
        path: ^alpha_path,
        head: ^parse_grammar_choice_overlap_residue,
        fatal: ^parse_g0_tokens_remain
      )]
    )),
    cause_name: "context_refusals_unbacked"
  )
}

// THE PATH WITHOUT THE REASON IS ALSO NOT THE OBSERVATION: the row's module resolves to the
// refusal's path, but the file refused for a different cause than the row carries.
test fn a_context_refusal_at_its_own_path_with_the_wrong_reason_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission(receipt: receipt_over(
      universe: [
        test_identity(module: "v2.test.alpha", declaration: "passes"),
        test_identity(module: "v2.test.beta", declaration: "blocked")
      ],
      module_source_index: [
        NativeRouteModuleSource { module: "v2.test.beta", path: ^beta_path }
      ],
      population: [
        passed_row(module: "v2.test.alpha", declaration: "passes"),
        refused_row(
          module: "v2.test.beta",
          declaration: "blocked",
          stage: NativeTestStageContext,
          reason: ^parse_g0_tokens_remain
        )
      ],
      file_refusals: [file_refusal_row(
        path: ^beta_path,
        head: ^parse_grammar_choice_overlap_residue,
        fatal: ^resolve_module_not_found
      )]
    )),
    cause_name: "context_refusals_unbacked"
  )
}

test fn a_context_refusal_backed_by_its_file_refusal_is_not_refused_on_that_clause() -> Bool {
  let admission = native_route_admission(receipt: receipt_over(
    universe: [
      test_identity(module: "v2.test.alpha", declaration: "passes"),
      test_identity(module: "v2.test.beta", declaration: "blocked"),
      smoke_identity()
    ],
    module_source_index: [
      NativeRouteModuleSource { module: "v2.test.alpha", path: ^alpha_path },
      NativeRouteModuleSource { module: "v2.test.beta", path: ^beta_path },
      smoke_source_row()
    ],
    population: [
      passed_row(module: "v2.test.alpha", declaration: "passes"),
      refused_row(
        module: "v2.test.beta",
        declaration: "blocked",
        stage: NativeTestStageContext,
        reason: ^parse_g0_tokens_remain
      ),
      passed_row(
        module: "v2.test.native_lane_smoke",
        declaration: "native_route_positive_population_smoke"
      )
    ],
    file_refusals: [file_refusal_row(
      path: ^beta_path,
      head: ^parse_grammar_choice_overlap_residue,
      fatal: ^parse_g0_tokens_remain
    )]
  ))
  !native_route_admission_refused_with(admission: admission, cause_name: "context_refusals_unbacked")
  && native_route_admitted(admission: admission)
}

