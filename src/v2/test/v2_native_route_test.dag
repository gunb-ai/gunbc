test fn an_unrecorded_route_identity_is_refused() -> Bool {
  let base = green_receipt()
  let no_path = NativeRouteReceipt {
    job: base.job,
    tested_tree: base.tested_tree,
    preparation_seed_identity: base.preparation_seed_identity,
    emitted_closure_identity: base.emitted_closure_identity,
    executable_path: "",
    executable_identity: base.executable_identity,
    universe: base.universe,
    module_source_index: base.module_source_index,
    population: base.population,
    file_refusals: base.file_refusals,
    false_control: base.false_control,
    true_control: base.true_control,
    malformed_control: base.malformed_control,
    old_route_control: base.old_route_control
  }
  let no_identity = NativeRouteReceipt {
    job: base.job,
    tested_tree: base.tested_tree,
    preparation_seed_identity: base.preparation_seed_identity,
    emitted_closure_identity: base.emitted_closure_identity,
    executable_path: base.executable_path,
    executable_identity: "",
    universe: base.universe,
    module_source_index: base.module_source_index,
    population: base.population,
    file_refusals: base.file_refusals,
    false_control: base.false_control,
    true_control: base.true_control,
    malformed_control: base.malformed_control,
    old_route_control: base.old_route_control
  }
  native_route_admission_refused_with(
    admission: native_route_admission(receipt: no_path),
    cause_name: "route_identity_unrecorded"
  )
  && native_route_admission_refused_with(
    admission: native_route_admission(receipt: no_identity),
    cause_name: "route_identity_unrecorded"
  )
}

// ── admission: the universe shape ──────────────────────────────────────────────────────────

test fn an_empty_universe_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission(receipt: receipt_over(universe: [], module_source_index: [], population: [], file_refusals: [])),
    cause_name: "universe_underived"
  )
}

test fn a_duplicated_universe_is_refused() -> Bool {
  let member = test_identity(module: "v2.test.alpha", declaration: "passes")
  native_route_admission_refused_with(
    admission: native_route_admission(receipt: receipt_over(
      universe: [member, member],
      module_source_index: [],
      population: [passed_row(module: "v2.test.alpha", declaration: "passes")],
      file_refusals: []
    )),
    cause_name: "universe_duplicates_present"
  )
}

test fn a_foreign_universe_member_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission(receipt: receipt_over(
      universe: [test_identity(module: "v2.compiler.compile", declaration: "not_a_test")],
      module_source_index: [],
      population: [passed_row(module: "v2.compiler.compile", declaration: "not_a_test")],
      file_refusals: []
    )),
    cause_name: "universe_prefix_violations_present"
  )
}

