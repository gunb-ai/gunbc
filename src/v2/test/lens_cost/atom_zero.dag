module v2.test.lens_cost.atom_zero

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.cost { cost_lens, zero_cost }
import v2.std.node { node_same_occurrence, Atom, Node, TypeNode }
import v2.std.witness { Holds }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data atom_zero_input: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^atom_zero_symbol } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

test fn atom_zero_claim_holds() -> Bool {
  match cost_lens(n: atom_zero_input) {
    Holds { value: actual } => node_same_occurrence(a: actual, b: zero_cost())
    _ => false
  }
}
