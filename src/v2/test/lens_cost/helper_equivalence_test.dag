module v2.test.lens_cost.helper_equivalence_test

import std.nat { Nat, Succ, Zero }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.cardinality { NonZeroNat }
import v2.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile,
}
import v2.std.node { Atom, Node, Symbol, TypeNode }
import v2.std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition }
import v2.lens.cost {
  ConstantCost,
  ExponentialBase,
  ExponentialCost,
  FactorialCost,
  LinearCost,
  LogCost,
  PolynomialCost,
  PolynomialDegree,
  PolyLogCost,
  PolyLogExponent,
  ProductCost,
  SizeVariable,
  SumCost,
  SymbolicCost,
  UnknownCost,
  symbolic_cost_dominates,
  symbolic_max,
  symbolic_product,
  symbolic_sequential,
  zero_cost,
}

// ---------------------------------------------------------------------------
// Witnesses for the wildcard-total rewrite of src/v2/lens/cost.dag.
//
// The PR rewrote symbolic_sequential, symbolic_product and symbolic_max
// (wildcard arms named, ConstantCost Nat sub-patterns moved to
// bind-then-match per the kernel-grounding rule). These claims compare the
// rewritten helpers against base_* copies of the pre-refactor semantics
// over the full representative cross-product: 13 representatives x 13 x
// 3 helpers = 507 pair claims, one per pair, so a single divergent cell
// names its pair.
//
// Representative coverage of the 10 SymbolicCost variants:
//   ConstantCost    -> zero, one, two, three (Zero, CC1, CC2, CC3)
//   UnknownCost     -> unknown
//   LinearCost      -> linear        LogCost        -> log
//   PolynomialCost  -> polynomial    PolyLogCost    -> polylog
//   ExponentialCost -> exponential   FactorialCost  -> factorial
//   SumCost         -> sum           ProductCost    -> product
// ---------------------------------------------------------------------------

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn eqv_synthetic_leaf(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

data eqv_leaf: Node = eqv_synthetic_leaf(identity: ^eqv_size_source)

data eqv_variable: SizeVariable = SizeVariable { source: eqv_leaf }

data eqv_diagnostic: Diagnostic = Diagnostic {
  reason: ^cost_reason_unmodeled_symbolic_cost,
  at: Textual { file: ^eqv_virtual_file, extent: WholeFile },
  correction: Unavailable { reason: AmbiguousIntent },
}



fn rep_zero() -> SymbolicCost {
  ConstantCost { value: Zero }
}

fn rep_one() -> SymbolicCost {
  ConstantCost { value: Succ { prev: Zero } }
}

fn rep_two() -> SymbolicCost {
  ConstantCost { value: Succ { prev: Succ { prev: Zero } } }
}

fn rep_three() -> SymbolicCost {
  ConstantCost { value: Succ { prev: Succ { prev: Succ { prev: Zero } } } }
}

fn rep_unknown() -> SymbolicCost {
  UnknownCost { diagnostic: eqv_diagnostic }
}

fn rep_linear() -> SymbolicCost {
  LinearCost { variable: eqv_variable }
}

fn rep_log() -> SymbolicCost {
  LogCost { variable: eqv_variable }
}

fn rep_polynomial() -> SymbolicCost {
  PolynomialCost { variable: eqv_variable, degree: PolynomialDegree { predecessor_after_linear: NonZeroNat { prev: Zero } } }
}

fn rep_polylog() -> SymbolicCost {
  PolyLogCost { variable: eqv_variable, exponent: PolyLogExponent { predecessor_after_log: NonZeroNat { prev: Zero } } }
}

fn rep_exponential() -> SymbolicCost {
  ExponentialCost { variable: eqv_variable, base: ExponentialBase { predecessor_after_one: NonZeroNat { prev: Zero } } }
}

fn rep_factorial() -> SymbolicCost {
  FactorialCost { variable: eqv_variable }
}

fn rep_sum() -> SymbolicCost {
  SumCost { lhs: eqv_linear, rhs: eqv_log }
}

fn rep_product() -> SymbolicCost {
  ProductCost { lhs: eqv_linear, rhs: eqv_log }
}

// ---------------------------------------------------------------------------
// base_* copies: pre-refactor semantics (main @ 45610ae7cc) in
// bind-then-match form. Disjoint-pattern regrouping only; the pair claims
// below are the proof the regrouping is semantics-preserving.
// ---------------------------------------------------------------------------

fn base_symbolic_sequential(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost {
  match a {
    ConstantCost { value: seq_av } =>
      match seq_av {
        Zero => b
        Succ { prev: _ } => base_sequential_rhs(a, b)
      }
    UnknownCost { diagnostic: _ } => a
    LinearCost { variable: _ } => base_sequential_rhs(a, b)
    LogCost { variable: _ } => base_sequential_rhs(a, b)
    PolynomialCost { variable: _, degree: _ } => base_sequential_rhs(a, b)
    PolyLogCost { variable: _, exponent: _ } => base_sequential_rhs(a, b)
    ExponentialCost { variable: _, base: _ } => base_sequential_rhs(a, b)
    FactorialCost { variable: _ } => base_sequential_rhs(a, b)
    SumCost { lhs: _, rhs: _ } => base_sequential_rhs(a, b)
    ProductCost { lhs: _, rhs: _ } => base_sequential_rhs(a, b)
  }
}

fn base_sequential_rhs(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost {
  match b {
    ConstantCost { value: seq_bv } =>
      match seq_bv {
        Zero => a
        Succ { prev: _ } => SumCost { lhs: a, rhs: b }
      }
    UnknownCost { diagnostic: _ } => b
    LinearCost { variable: _ } => SumCost { lhs: a, rhs: b }
    LogCost { variable: _ } => SumCost { lhs: a, rhs: b }
    PolynomialCost { variable: _, degree: _ } => SumCost { lhs: a, rhs: b }
    PolyLogCost { variable: _, exponent: _ } => SumCost { lhs: a, rhs: b }
    ExponentialCost { variable: _, base: _ } => SumCost { lhs: a, rhs: b }
    FactorialCost { variable: _ } => SumCost { lhs: a, rhs: b }
    SumCost { lhs: _, rhs: _ } => SumCost { lhs: a, rhs: b }
    ProductCost { lhs: _, rhs: _ } => SumCost { lhs: a, rhs: b }
  }
}

fn base_symbolic_product(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost {
  if a == zero_cost() {
    zero_cost()
  } else {
    if b == zero_cost() {
      zero_cost()
    } else {
      match a {
        ConstantCost { value: prod_av } =>
          match prod_av {
            Zero => zero_cost()
            Succ { prev: prod_av2 } =>
              match prod_av2 {
                Zero => b
                Succ { prev: _ } => base_product_high(a, b)
              }
          }
        UnknownCost { diagnostic: _ } => base_product_unknown(a, b)
        LinearCost { variable: _ } => base_product_rhs(a, b)
        LogCost { variable: _ } => base_product_rhs(a, b)
        PolynomialCost { variable: _, degree: _ } => base_product_rhs(a, b)
        PolyLogCost { variable: _, exponent: _ } => base_product_rhs(a, b)
        ExponentialCost { variable: _, base: _ } => base_product_rhs(a, b)
        FactorialCost { variable: _ } => base_product_rhs(a, b)
        SumCost { lhs: _, rhs: _ } => base_product_rhs(a, b)
        ProductCost { lhs: _, rhs: _ } => base_product_rhs(a, b)
      }
    }
  }
}

fn base_product_high(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost {
  match b {
    ConstantCost { value: prod_bv } =>
      match prod_bv {
        Zero => zero_cost()
        Succ { prev: prod_bv2 } =>
          match prod_bv2 {
            Zero => a
            Succ { prev: _ } => ProductCost { lhs: a, rhs: b }
          }
      }
    UnknownCost { diagnostic: _ } => b
    LinearCost { variable: _ } => ProductCost { lhs: a, rhs: b }
    LogCost { variable: _ } => ProductCost { lhs: a, rhs: b }
    PolynomialCost { variable: _, degree: _ } => ProductCost { lhs: a, rhs: b }
    PolyLogCost { variable: _, exponent: _ } => ProductCost { lhs: a, rhs: b }
    ExponentialCost { variable: _, base: _ } => ProductCost { lhs: a, rhs: b }
    FactorialCost { variable: _ } => ProductCost { lhs: a, rhs: b }
    SumCost { lhs: _, rhs: _ } => ProductCost { lhs: a, rhs: b }
    ProductCost { lhs: _, rhs: _ } => ProductCost { lhs: a, rhs: b }
  }
}

fn base_product_rhs(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost {
  match b {
    ConstantCost { value: prod_bv3 } =>
      match prod_bv3 {
        Zero => zero_cost()
        Succ { prev: prod_bv4 } =>
          match prod_bv4 {
            Zero => a
            Succ { prev: _ } => ProductCost { lhs: a, rhs: b }
          }
      }
    UnknownCost { diagnostic: _ } => b
    LinearCost { variable: _ } => ProductCost { lhs: a, rhs: b }
    LogCost { variable: _ } => ProductCost { lhs: a, rhs: b }
    PolynomialCost { variable: _, degree: _ } => ProductCost { lhs: a, rhs: b }
    PolyLogCost { variable: _, exponent: _ } => ProductCost { lhs: a, rhs: b }
    ExponentialCost { variable: _, base: _ } => ProductCost { lhs: a, rhs: b }
    FactorialCost { variable: _ } => ProductCost { lhs: a, rhs: b }
    SumCost { lhs: _, rhs: _ } => ProductCost { lhs: a, rhs: b }
    ProductCost { lhs: _, rhs: _ } => ProductCost { lhs: a, rhs: b }
  }
}

fn base_product_unknown(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost {
  match b {
    ConstantCost { value: prod_bv5 } =>
      match prod_bv5 {
        Zero => zero_cost()
        Succ { prev: _ } => a
      }
    UnknownCost { diagnostic: _ } => a
    LinearCost { variable: _ } => a
    LogCost { variable: _ } => a
    PolynomialCost { variable: _, degree: _ } => a
    PolyLogCost { variable: _, exponent: _ } => a
    ExponentialCost { variable: _, base: _ } => a
    FactorialCost { variable: _ } => a
    SumCost { lhs: _, rhs: _ } => a
    ProductCost { lhs: _, rhs: _ } => a
  }
}

fn base_max_dominance(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost {
  if a == b {
    a
  } else {
    if symbolic_cost_dominates(a: a, b: b) {
      if symbolic_cost_dominates(a: b, b: a) {
        SumCost { lhs: a, rhs: b }
      } else {
        a
      }
    } else {
      b
    }
  }
}

fn base_symbolic_max(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost {
  match a {
    ConstantCost { value: max_av } =>
      match max_av {
        Zero => b
        Succ { prev: _ } => base_max_dominance(a, b)
      }
    LinearCost { variable: _ } => base_max_dominance(a, b)
    LogCost { variable: _ } => base_max_dominance(a, b)
    PolynomialCost { variable: _, degree: _ } => base_max_dominance(a, b)
    PolyLogCost { variable: _, exponent: _ } => base_max_dominance(a, b)
    ExponentialCost { variable: _, base: _ } => base_max_dominance(a, b)
    FactorialCost { variable: _ } => base_max_dominance(a, b)
    SumCost { lhs: _, rhs: _ } => base_max_dominance(a, b)
    ProductCost { lhs: _, rhs: _ } => base_max_dominance(a, b)
    UnknownCost { diagnostic: _ } => base_max_dominance(a, b)
  }
}

test fn eqv_sequential_zero_x_zero() -> Bool {
  base_symbolic_sequential(rep_zero(), rep_zero()) == symbolic_sequential(rep_zero(), rep_zero())
}

