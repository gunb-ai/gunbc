module v2.test.lens_cost.loop_illegal_named

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.cost { cost_lens }
import v2.std.node {
  Atom,
  ComputationNode,
  Edge,
  Loop,
  Authored,
  Node,
  Positional,
  TypeNode,
  LoopBoundEdge,
  core_edge_label,
}
import v2.std.witness { Violates }

data loop_illegal_named_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^loop_illegal_named_body_atom } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data loop_illegal_named_measure_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^loop_illegal_named_measure_atom } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data loop_illegal_named_extra_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^loop_illegal_named_extra_atom } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data loop_illegal_named_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: loop_illegal_named_body_leaf },
    Edge { label: core_edge_label(marker: LoopBoundEdge), target: loop_illegal_named_measure_leaf },
    Edge { label: Authored { name: ^loop_illegal_named_extra_atom }, target: loop_illegal_named_extra_leaf }
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn loop_illegal_named_claim_holds() -> Bool {
  match cost_lens(n: loop_illegal_named_input) {
    Violates { diagnostic: d } => d.reason == ^cardinality_loop_bound_malformed
    _ => false
  }
}
