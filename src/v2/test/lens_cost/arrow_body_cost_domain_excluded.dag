module v2.test.lens_cost.arrow_body_cost_domain_excluded

import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.arrow_signature { declared_signature }
import v2.std.node_query { pattern_wildcard_name, binder_edge }
import v2.lens.cost { SumCost, cost_lens, unit_cost }
import v2.std.node {
  Arrow,
  Atom,
  Occupancy,
  ComputationNode,
  Conj,
  Edge,
  Authored,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  ArrowBodyEdge,
  core_edge_label,
}
import v2.std.witness { Holds }

// Discriminating RED for Wave 1 Gate 1 C1: Arrow domain Cardinality children must NOT inflate the
// cost fold — only ^arrow_body_edge is priced. If cost_edge_role regresses to
// include Arrow positional children, this witness goes red (domain linear cost would dominate).

data arrow_body_cost_domain_param: Node = Node {
  kind: TypeNode { connective: Occupancy },
  children: [
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: ^arrow_body_cost_domain_param_atom } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

data arrow_body_cost_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

fn arrow_body_cost_arrow() -> Node {
  let signature = declared_signature(
    params: [binder_edge(name: pattern_wildcard_name(), type_node: arrow_body_cost_domain_param)],
    source: arrow_body_cost_domain_param
  )
  Node {
  kind: TypeNode { connective: Arrow },
  children: [
    signature.domain,
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: ^arrow_body_cost_return_type } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    },
    signature.order,
    Edge { label: core_edge_label(marker: ArrowBodyEdge), target: arrow_body_cost_body }
  ],
  occurrence_id: OccurrenceSynthetic
  }
}

fn arrow_body_cost_domain_excluded_holds() -> Bool {
  match cost_lens(n: arrow_body_cost_arrow()) {
    Holds { value: actual } =>
      actual == SumCost {
        lhs: unit_cost(),
        rhs: unit_cost()
      }
    Violates { diagnostic: _ } => false
  }
}
