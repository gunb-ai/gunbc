module v2.test.lens_cost.map_linear

import std.occurrence_identity { OccurrenceSynthetic }
import v2.lens.cost { LinearCost, SizeVariable, cost_lens }
import v2.std.node {
  Atom,
  Loop,
  LoopBoundEdge,
  core_edge_label,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Transform,
  TypeNode,
  NotADeclaration
}
import v2.std.witness { Holds }

data map_linear_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^map_linear_body_atom } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data map_linear_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: map_linear_body_leaf, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

data map_linear_measure: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^map_linear_measure_atom } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

data map_linear_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: map_linear_body, declaration: NotADeclaration },
    Edge { label: core_edge_label(marker: LoopBoundEdge), target: map_linear_measure, declaration: NotADeclaration }
  ],
  occurrence_id: OccurrenceSynthetic
}

test fn map_linear_claim_holds() -> Bool {
  match cost_lens(n: map_linear_input) {
    Holds { value: actual } =>
      actual == LinearCost { variable: SizeVariable { source: map_linear_measure } }
    _ => false
  }
}
