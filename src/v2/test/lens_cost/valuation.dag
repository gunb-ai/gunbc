module v2.test.lens_cost.valuation

import std.occurrence_identity { OccurrenceSynthetic }
import std.algebra { Empty }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.lens.cost { ConstantCost, SizeVariable, SymbolicCost, UnknownCost, symbolic_product, unit_cost, zero_cost }
import v2.lens.cost.expr {
  CostAdd,
  CostConst,
  CostEffect,
  CostExpr,
  CostLog,
  CostMul,
  CostSum,
  InvalidLogBase,
  SizeConst,
  normalize_cost_expr_to_symbolic,
  size_of
}
import v2.lens.cost.valuation {
  CostEvaluation,
  CostEvaluationRefused,
  CostEvaluationZeroStanding,
  CostValuationBinding,
  DuplicateSizeBinding,
  ExactCost,
  ExactZero,
  ExpressionRefused,
  IntegerLogarithmUnavailable,
  MissingSizeBinding,
  NotExactZero,
  UnmodeledEffectCost,
  cost_evaluation_zero_standing,
  evaluate_cost_expr,
  multiply_evaluations
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.nat { Nat, Succ, Zero, nat_mul }
import v2.std.node { node_same_occurrence,
  Atom,
  Node,
  Symbol,
  TypeNode,
}
import v2.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data nat_1: Nat = Succ { prev: Zero }
data nat_2: Nat = Succ { prev: nat_1 }
data nat_3: Nat = Succ { prev: nat_2 }
data nat_4: Nat = Succ { prev: nat_3 }
data nat_5: Nat = Succ { prev: nat_4 }
data nat_6: Nat = Succ { prev: nat_5 }
data nat_7: Nat = Succ { prev: nat_6 }
data nat_8: Nat = Succ { prev: nat_7 }
data nat_9: Nat = Succ { prev: nat_8 }
data nat_10: Nat = Succ { prev: nat_9 }

fn synthetic_leaf(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

data outer_leaf: Node = synthetic_leaf(identity: ^valuation_outer_size_atom)
data inner_leaf: Node = synthetic_leaf(identity: ^valuation_inner_size_atom)

data outer_variable: SizeVariable = SizeVariable { source: outer_leaf }
data inner_variable: SizeVariable = SizeVariable { source: inner_leaf }

fn bind(variable: SizeVariable, value: Nat) -> CostValuationBinding {
  CostValuationBinding { variable: variable, value: value }
}

fn unit_loop_over(variable: SizeVariable) -> CostExpr {
  CostSum {
    binder: inner_variable,
    upper: size_of(variable: variable),
    body: CostConst { value: nat_1 }
  }
}

fn is_exact(evaluation: CostEvaluation, expected: Nat) -> Bool {
  match evaluation {
    ExactCost { value: v } => v == expected
    _ => false
  }
}

fn check_unit_body_over_size_five_evaluates_to_five() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: unit_loop_over(variable: outer_variable),
      bindings: [bind(variable: outer_variable, value: nat_5)]
    ),
    expected: nat_5
  )
}

test fn unit_body_over_size_five_evaluates_to_five() -> Bool {
  check_unit_body_over_size_five_evaluates_to_five()
}

test fn changing_the_bound_size_changes_the_derived_work() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: unit_loop_over(variable: outer_variable),
      bindings: [bind(variable: outer_variable, value: nat_10)]
    ),
    expected: nat_10
  ) && !is_exact(
    evaluation: evaluate_cost_expr(
      expr: unit_loop_over(variable: outer_variable),
      bindings: [bind(variable: outer_variable, value: nat_10)]
    ),
    expected: nat_5
  )
}

fn binder_dependent_loop() -> CostExpr {
  CostSum {
    binder: outer_variable,
    upper: size_of(variable: outer_variable),
    body: CostSum {
      binder: inner_variable,
      upper: size_of(variable: outer_variable),
      body: CostConst { value: nat_1 }
    }
  }
}

test fn binder_dependent_body_is_summed_not_treated_as_invariant() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: binder_dependent_loop(),
      bindings: [bind(variable: outer_variable, value: nat_5)]
    ),
    expected: nat_10
  )
}

test fn invariant_body_control_does_not_produce_the_summed_answer() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: CostSum {
        binder: outer_variable,
        upper: size_of(variable: outer_variable),
        body: CostConst { value: nat_1 }
      },
      bindings: [bind(variable: outer_variable, value: nat_5)]
    ),
    expected: nat_5
  )
}

test fn missing_binding_refuses_and_never_becomes_zero() -> Bool {
  match evaluate_cost_expr(
    expr: unit_loop_over(variable: outer_variable),
    bindings: []
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        MissingSizeBinding { variable: v, at: _ } => node_same_occurrence(a: v.source, b: outer_leaf)
        _ => false
      }
    ExactCost { value: _ } => false
  }
}

test fn duplicate_bindings_refuse() -> Bool {
  match evaluate_cost_expr(
    expr: unit_loop_over(variable: outer_variable),
    bindings: [
      bind(variable: outer_variable, value: nat_5),
      bind(variable: outer_variable, value: nat_10)
    ]
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        DuplicateSizeBinding { variable: v, at: _ } => node_same_occurrence(a: v.source, b: outer_leaf)
        _ => false
      }
    _ => false
  }
}

test fn distinct_bindings_control_does_not_refuse() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: unit_loop_over(variable: outer_variable),
      bindings: [
        bind(variable: outer_variable, value: nat_5),
        bind(variable: inner_variable, value: nat_10)
      ]
    ),
    expected: nat_5
  )
}

fn shadowing_expr() -> CostExpr {
  CostAdd {
    left: CostSum {
      binder: outer_variable,
      upper: SizeConst { value: nat_2 },
      body: unit_loop_over(variable: outer_variable)
    },
    right: unit_loop_over(variable: outer_variable)
  }
}

test fn binder_shadowing_is_scoped_and_removed_on_exit() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: shadowing_expr(),
      bindings: [bind(variable: outer_variable, value: nat_3)]
    ),
    expected: nat_4
  )
}

test fn shadowing_control_rejects_the_unshadowed_reading() -> Bool {
  !is_exact(
    evaluation: evaluate_cost_expr(
      expr: shadowing_expr(),
      bindings: [bind(variable: outer_variable, value: nat_3)]
    ),
    expected: nat_9
  )
}

test fn zero_iterations_produce_exact_zero() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: CostSum {
        binder: inner_variable,
        upper: SizeConst { value: Zero },
        body: CostConst { value: nat_1 }
      },
      bindings: []
    ),
    expected: Zero
  )
}

data effect_operation: DeclarationRef = DeclarationRef {
  module_path: "v2.test.lens_cost.valuation",
  decl_name: "unmodelled_effect_specimen",
  field: WholeDeclaration
}

test fn cost_effect_refuses_until_an_effect_model_exists() -> Bool {
  match evaluate_cost_expr(
    expr: CostEffect { operation: effect_operation },
    bindings: []
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        UnmodeledEffectCost { operation: _, at: _ } => true
        _ => false
      }
    ExactCost { value: _ } => false
  }
}

// Four witnesses for one construct, because a logarithm fails in three unrelated ways and an
// earlier revision of the evaluator reported every non-refusing case as UngroundedLogArgument -
// ignoring the base entirely, so base 0 read as an ARGUMENT problem and a fully grounded argument
// was called UNGROUNDED. Each witness pins one cause. The discriminating pair is base-zero against
// grounded-argument: under the earlier arm both answered the same cause, so either one alone would
// have passed while the arm was wrong, and only asserting that they differ catches it.

test fn log_base_zero_refuses_as_an_invalid_base() -> Bool {
  match evaluate_cost_expr(
    expr: CostLog { base: Zero, argument: size_of(variable: outer_variable) },
    bindings: [bind(variable: outer_variable, value: nat_8)]
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        ExpressionRefused { cause: inner, at: _ } =>
          match inner {
            InvalidLogBase { base: b, at: _ } => b == Zero
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn log_base_one_refuses_as_an_invalid_base() -> Bool {
  match evaluate_cost_expr(
    expr: CostLog { base: nat_1, argument: size_of(variable: outer_variable) },
    bindings: [bind(variable: outer_variable, value: nat_8)]
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        ExpressionRefused { cause: inner, at: _ } =>
          match inner {
            InvalidLogBase { base: b, at: _ } => b == nat_1
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn log_of_a_grounded_argument_names_the_missing_authority_not_the_argument() -> Bool {
  match evaluate_cost_expr(
    expr: CostLog { base: nat_2, argument: size_of(variable: outer_variable) },
    bindings: [bind(variable: outer_variable, value: nat_8)]
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        IntegerLogarithmUnavailable { base: b, argument: _, at: _ } => b == nat_2
        _ => false
      }
    _ => false
  }
}

test fn log_of_an_unbound_argument_refuses_as_a_missing_binding() -> Bool {
  match evaluate_cost_expr(
    expr: CostLog { base: nat_2, argument: size_of(variable: outer_variable) },
    bindings: []
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        MissingSizeBinding { variable: v, at: _ } => node_same_occurrence(a: v.source, b: outer_leaf)
        _ => false
      }
    _ => false
  }
}

// Ten iterations of a body that refuses unconditionally yield ONE cause, not ten. Both halves of
// that are the subject: ten identical causes would amplify a single deficit tenfold, degrading the
// countability the accumulate rule exists to protect. This witness reds if the
// settled-disposition skip in evaluate_summation is removed, which is what makes it a regression
// control rather than a description.

test fn refusing_body_under_a_bound_yields_exactly_one_cause() -> Bool {
  match evaluate_cost_expr(
    expr: CostSum {
      binder: inner_variable,
      upper: size_of(variable: outer_variable),
      body: CostEffect { operation: effect_operation }
    },
    bindings: [bind(variable: outer_variable, value: nat_10)]
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.tail {
        Empty => true
        _ => false
      }
    _ => false
  }
}

// Three discriminators, and the third is what keeps the first two from being a blanket zero. A zero
// factor means the other factor is executed ZERO times, so its work is zero whatever it is -
// refusing there would conflate did-no-work with could-not-model, which is the earned-zero
// distinction one level out. Both operand orders are asserted because multiplication is commutative
// and an order-sensitive answer is a defect; that exact defect existed in v2.lens.cost
// symbolic_product, which matched UnknownCost on the left operand before ever inspecting the right,
// and is fixed with this change. ONE times an unmodelled effect still REFUSES, because that factor
// is executed.

test fn zero_times_an_unmodelled_effect_is_exactly_zero() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: CostMul {
        left: CostConst { value: Zero },
        right: CostEffect { operation: effect_operation }
      },
      bindings: []
    ),
    expected: Zero
  )
}

test fn an_unmodelled_effect_times_zero_is_exactly_zero() -> Bool {
  is_exact(
    evaluation: evaluate_cost_expr(
      expr: CostMul {
        left: CostEffect { operation: effect_operation },
        right: CostConst { value: Zero }
      },
      bindings: []
    ),
    expected: Zero
  )
}

test fn one_times_an_unmodelled_effect_still_refuses() -> Bool {
  match evaluate_cost_expr(
    expr: CostMul {
      left: CostConst { value: nat_1 },
      right: CostEffect { operation: effect_operation }
    },
    bindings: []
  ) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        UnmodeledEffectCost { operation: _, at: _ } => true
        _ => false
      }
    ExactCost { value: _ } => false
  }
}

// Every arm is asserted in BOTH operand orders - the zero absorption AND the one-times-unknown
// non-absorption - because the defect being fixed was precisely that operand order changed the
// answer, so a one-sided assertion is the shape that missed it in the first place. The projection
// authority is asserted in both orders, because it previously answered zero in one and unknown in
// the other. The unknown-times-zero direction is the one that was wrong and is the regression
// control for the reorder; the zero-times-unknown direction must keep working and is the control
// that the reorder did not simply swap the bug to the other side.

fn unknown_symbolic_cost() -> SymbolicCost {
  normalize_cost_expr_to_symbolic(expr: CostEffect { operation: effect_operation })
}

test fn symbolic_product_absorbs_zero_from_the_left() -> Bool {
  match symbolic_product(a: zero_cost(), b: unknown_symbolic_cost()) {
    ConstantCost { value: Zero } => true
    _ => false
  }
}

test fn symbolic_product_absorbs_zero_from_the_right() -> Bool {
  match symbolic_product(a: unknown_symbolic_cost(), b: zero_cost()) {
    ConstantCost { value: Zero } => true
    _ => false
  }
}

test fn symbolic_product_still_returns_unknown_without_a_zero_factor() -> Bool {
  match symbolic_product(a: unknown_symbolic_cost(), b: unit_cost()) {
    UnknownCost { diagnostic: _ } => true
    _ => false
  }
}

test fn symbolic_product_one_times_unknown_stays_unknown() -> Bool {
  match symbolic_product(a: unit_cost(), b: unknown_symbolic_cost()) {
    UnknownCost { diagnostic: _ } => true
    _ => false
  }
}

fn effect_refused() -> CostEvaluation {
  evaluate_cost_expr(expr: CostEffect { operation: effect_operation }, bindings: [])
}

fn standing_misarm_every_exact_as_zero(e: CostEvaluation) -> CostEvaluationZeroStanding {
  match e {
    ExactCost { value: _ } => ExactZero
    CostEvaluationRefused { causes: _ } => NotExactZero
  }
}

fn multiply_misarm_refusal_before_annihilator(a: CostEvaluation, b: CostEvaluation) -> CostEvaluation {
  match a {
    CostEvaluationRefused { causes: ca } =>
      match b {
        CostEvaluationRefused { causes: cb } =>
          CostEvaluationRefused { causes: cb }
        ExactCost { value: _ } => CostEvaluationRefused { causes: ca }
      }
    ExactCost { value: va } =>
      match b {
        CostEvaluationRefused { causes: cb } => CostEvaluationRefused { causes: cb }
        ExactCost { value: vb } => ExactCost { value: nat_mul(va, vb) }
      }
  }
}

fn standing_is_exact_zero(e: CostEvaluation) -> Bool {
  match cost_evaluation_zero_standing(e: e) {
    ExactZero => true
    NotExactZero => false
  }
}

test fn cost_evaluation_zero_standing_pins_exact_zero() -> Bool {
  standing_is_exact_zero(e: ExactCost { value: Zero })
}

test fn cost_evaluation_zero_standing_pins_exact_nonzero() -> Bool {
  !standing_is_exact_zero(e: ExactCost { value: nat_2 })
}

test fn cost_evaluation_zero_standing_pins_refused() -> Bool {
  !standing_is_exact_zero(e: effect_refused())
}

test fn multiply_evaluations_pins_zero_times_refused_is_zero() -> Bool {
  is_exact(
    evaluation: multiply_evaluations(a: ExactCost { value: Zero }, b: effect_refused()),
    expected: Zero
  )
}

test fn multiply_evaluations_pins_refused_times_zero_is_zero() -> Bool {
  is_exact(
    evaluation: multiply_evaluations(a: effect_refused(), b: ExactCost { value: Zero }),
    expected: Zero
  )
}

test fn multiply_evaluations_pins_nonzero_times_refused_refuses() -> Bool {
  match multiply_evaluations(a: ExactCost { value: nat_1 }, b: effect_refused()) {
    CostEvaluationRefused { causes: c } =>
      match c.head {
        UnmodeledEffectCost { operation: _, at: _ } => true
        _ => false
      }
    ExactCost { value: _ } => false
  }
}

test fn multiply_evaluations_pins_exact_times_exact() -> Bool {
  is_exact(
    evaluation: multiply_evaluations(a: ExactCost { value: nat_2 }, b: ExactCost { value: nat_3 }),
    expected: nat_6
  )
}

test fn standing_misarm_every_exact_as_zero_disagrees_on_nonzero() -> Bool {
  match standing_misarm_every_exact_as_zero(e: ExactCost { value: nat_2 }) {
    ExactZero => !standing_is_exact_zero(e: ExactCost { value: nat_2 })
    NotExactZero => false
  }
}

test fn multiply_misarm_refusal_before_annihilator_disagrees_on_zero_times_refused() -> Bool {
  match multiply_misarm_refusal_before_annihilator(
    a: ExactCost { value: Zero },
    b: effect_refused()
  ) {
    CostEvaluationRefused { causes: _ } =>
      is_exact(
        evaluation: multiply_evaluations(a: ExactCost { value: Zero }, b: effect_refused()),
        expected: Zero
      )
    ExactCost { value: _ } => false
  }
}

data claim_cost_valuation: TestClaim = EqualsClaim {
  label: "lens_cost/valuation: CostExpr evaluated at a complete SizeVariable valuation yields exact semantic work for a unit body",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: outer_leaf,
  rhs: if check_unit_body_over_size_five_evaluates_to_five() {
    outer_leaf
  } else {
    synthetic_leaf(identity: ^valuation_claim_failed)
  },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

fn claim_leaf_if(ok: Bool, fail: Symbol) -> Node {
  if ok {
    outer_leaf
  } else {
    synthetic_leaf(identity: fail)
  }
}

data claim_multiply_evaluations_pins_every_standing: TestClaim = EqualsClaim {
  label: "lens_cost/valuation: cost_evaluation_zero_standing and multiply_evaluations pin every CostEvaluation shape",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: outer_leaf,
  rhs: claim_leaf_if(
    ok: standing_is_exact_zero(e: ExactCost { value: Zero })
      && !standing_is_exact_zero(e: ExactCost { value: nat_2 })
      && !standing_is_exact_zero(e: effect_refused())
      && is_exact(
        evaluation: multiply_evaluations(a: ExactCost { value: Zero }, b: effect_refused()),
        expected: Zero
      )
      && is_exact(
        evaluation: multiply_evaluations(a: effect_refused(), b: ExactCost { value: Zero }),
        expected: Zero
      )
      && is_exact(
        evaluation: multiply_evaluations(a: ExactCost { value: nat_2 }, b: ExactCost { value: nat_3 }),
        expected: nat_6
      ),
    fail: ^valuation_standing_pin_failed
  ),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_multiply_evaluations_misarm_disagrees: TestClaim = EqualsClaim {
  label: "lens_cost/valuation: a refusal-first multiply mis-arm disagrees with multiply_evaluations on zero times refused",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: outer_leaf,
  rhs: claim_leaf_if(
    ok: match multiply_misarm_refusal_before_annihilator(
      a: ExactCost { value: Zero },
      b: effect_refused()
    ) {
      CostEvaluationRefused { causes: _ } =>
        is_exact(
          evaluation: multiply_evaluations(a: ExactCost { value: Zero }, b: effect_refused()),
          expected: Zero
        )
      ExactCost { value: _ } => false
    },
    fail: ^valuation_misarm_pin_failed
  ),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
