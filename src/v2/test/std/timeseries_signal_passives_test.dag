module v2.test.std.timeseries_signal_passives

import v2.std.logic { Bool }
import v2.std.timeseries_signal {
  BranchCurrent,
  Current,
  GroundReference,
  PotentialDifference,
  Voltage,
  absolute_potential_from_named_preserves_reference,
  branch_current_of_magnitude,
  current,
  current_count,
  named_affine_voltage,
  potential_difference_of_magnitude,
  potential_reference_eq,
  potential_reference_of_named,
  timeseries_witness_approx_zero,
  voltage,
  voltage_count,
}
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_voltage_zero: Voltage = voltage(0)

data witness_current_zero: Current = current(0)

test fn named_affine_voltage_preserves_ground_reference_holds() -> Bool {
  let named = named_affine_voltage(
    reference: GroundReference,
    approx: timeseries_witness_approx_zero
  )
  potential_reference_eq(
    left: potential_reference_of_named(named: named),
    right: GroundReference
  )
}

test fn absolute_potential_from_named_preserves_reference_holds() -> Bool {
  let named = named_affine_voltage(
    reference: GroundReference,
    approx: timeseries_witness_approx_zero
  )
  absolute_potential_from_named_preserves_reference(
    named: named,
    magnitude: witness_voltage_zero
  )
}

test fn potential_difference_of_magnitude_is_structural_identity_holds() -> Bool {
  match potential_difference_of_magnitude(magnitude: witness_voltage_zero) {
    PotentialDifference { magnitude: m } =>
      voltage_count(v: m) == voltage_count(v: witness_voltage_zero)
  }
}

test fn branch_current_of_magnitude_is_structural_identity_holds() -> Bool {
  match branch_current_of_magnitude(magnitude: witness_current_zero) {
    BranchCurrent { magnitude: m } =>
      current_count(c: m) == current_count(c: witness_current_zero)
  }
}

data claim_timeseries_signal_module_compiles: TestClaim = CompilesClaim {
  label: "std/timeseries_signal: torsor + passive topology + map/fold passives compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: GroundReference,
  expected_value: GroundReference,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
