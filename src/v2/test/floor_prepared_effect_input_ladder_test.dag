module v2.test.floor_prepared_effect_input_ladder

import v2.workflow.floor_prepared_effect_input_ladder {
  carried_input_identities, carried_input_verdicts_after_the_carry,
  carried_input_verdicts_before_the_carry,
  every_carried_identity_is_a_single_demand_after_the_carry,
  every_carried_identity_is_authored_duplication_before_the_carry,
  the_minimized_demand_graph_is_green, prepared_effect_input_provider
}
import v2.workflow.floor_pure_producer_share {
  cross_claim_tier_retention,
  carried_input_rows_without_a_prepared_input, floor_cross_claim_carried_input_warm_rows,
  floor_cross_claim_prepared_effect_inputs
}
import std.cache_interface { retention_growth_is_bounded, retention_has_exact_byte_bound }
import std.materialization_ladder { provider_is_content_keyed, provider_is_store_tier }

// THE LADDER OBLIGATIONS ARE DECIDED BY THE FOLD, NOT ASSERTED IN PROSE. Each test below is
// answered by `std.materialization_ladder` or `std.cache_interface` over the LIVE rows rather than
// by a sentence in this file: the verdict transition the carry performs, and the three properties
// of the place the carried value is held while it is carried.

// THE VERDICT TRANSITION, which is what this mechanism actually is. An earlier cut of this file
// asserted `Discharged` and the floor refused it by execution (run 34854251612): at a SHARED-STATE
// obligation LCA the ladder answers AuthoredDuplication and never reaches a provider at all,
// because DESIGN section 2 says the repair there is to CARRY the value and not to cache it. So the
// pair below states the transition the carry performs — the ladder naming the defect before, and
// no repetition left after.
test fn the_demand_is_authored_duplication_before_the_carry() -> Bool  {
  every_carried_identity_is_authored_duplication_before_the_carry()
}

test fn the_demand_is_a_single_acquisition_after_the_carry() -> Bool  {
  every_carried_identity_is_a_single_demand_after_the_carry()
    && the_minimized_demand_graph_is_green()
}

// KEY represents every declared input the result depends on: the tier is CONTENT-keyed, which is
// what makes a changed carrier content a different key rather than a stale hit.
test fn the_provider_is_content_keyed_and_a_store_tier() -> Bool  {
  let p = prepared_effect_input_provider()
  provider_is_content_keyed(p: p) && provider_is_store_tier(p: p)
}

// RETENTION spans the obligated lifetime and no longer: released when the prepared subject's
// scope exits, with an exact byte ceiling — the two predicates `std.cache_interface` separates
// deliberately, because scope release is evidence about growth over time and never about peak.
test fn the_retention_is_scope_released_and_byte_bounded() -> Bool  {
  let r = cross_claim_tier_retention()
  retention_growth_is_bounded(r: r) && retention_has_exact_byte_bound(r: r)
}

// COVERAGE includes every enrolled identity: a row enrolled but uncovered would be refused by the
// fold above, so this states the population is nonempty — an empty coverage would make the
// discharge test vacuously true, which is the decoration DESIGN section 4b refuses.
test fn the_covered_population_is_not_empty() -> Bool  {
  length(xs: carried_input_identities()) > 0
    && length(xs: carried_input_verdicts_before_the_carry()) > 0
    && length(xs: carried_input_verdicts_after_the_carry()) > 0
}

// THE ROSTER WALL, over the live rows: every carried-input row names an input that is actually
// prepared. The second wall that stood here -- no producer both carried and plainly rostered --
// is construction now: the plain roster is deleted, and the derived share declines every closed
// demand for a carried producer (`CarriedInputProducer`, red in
// `v2.test.floor.pure_producer_share_refusal`
// `a_carried_input_producer_is_declined_as_a_plain_share`).
test fn every_carried_row_names_a_prepared_input() -> Bool  {
  length(xs: carried_input_rows_without_a_prepared_input(
    rows: floor_cross_claim_carried_input_warm_rows,
    inputs: floor_cross_claim_prepared_effect_inputs
  )) == 0
}

