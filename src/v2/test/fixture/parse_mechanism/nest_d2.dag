module synthetic.parse_mechanism.nest_d2

import v2.std.logic { Bool }
import v2.std.nat { Nat }

type Bit = B0 | B1

fn nest_leaf(_: Bit) -> Nat { 0 }

fn nest_l1(x: Bit) -> Nat {
  match x {
    B0 => nest_leaf(B0)
    B1 => nest_leaf(B1)
  }
}

fn nested_depth(x: Bit) -> Nat {
  match x {
    B0 => nest_l1(B0)
    B1 => nest_l1(B1)
  }
}
