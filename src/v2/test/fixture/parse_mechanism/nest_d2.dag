module synthetic.parse_mechanism.nest_d2


type Bit = B0 | B1

fn nest_leaf(_: Bit) -> std.nat.Nat { 0 }

fn nest_l1(x: Bit) -> std.nat.Nat {
  match x {
    B0 => nest_leaf(B0)
    B1 => nest_leaf(B1)
  }
}

fn nested_depth(x: Bit) -> std.nat.Nat {
  match x {
    B0 => nest_l1(B0)
    B1 => nest_l1(B1)
  }
}
