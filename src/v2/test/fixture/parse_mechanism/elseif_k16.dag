module synthetic.parse_mechanism.elseif_k16


fn else_if_chain(x: std.nat.Nat) -> std.nat.Nat {
  if x == 0 { 0 }
  else if x == 1 { 1 }
  else if x == 2 { 2 }
  else if x == 3 { 3 }
  else if x == 4 { 4 }
  else if x == 5 { 5 }
  else if x == 6 { 6 }
  else if x == 7 { 7 }
  else if x == 8 { 8 }
  else if x == 9 { 9 }
  else if x == 10 { 10 }
  else if x == 11 { 11 }
  else if x == 12 { 12 }
  else if x == 13 { 13 }
  else if x == 14 { 14 }
  else if x == 15 { 15 }
  else { 16 }
}
