module synthetic.parse_mechanism.elseif_k32


fn else_if_chain(x: Nat) -> Nat {
  if x == 0 { 0 }
  else if x == 1 { 1 }
  else if x == 2 { 2 }
  else if x == 3 { 3 }
  else if x == 4 { 4 }
  else if x == 5 { 5 }
  else if x == 6 { 6 }
  else if x == 7 { 7 }
  else if x == 8 { 8 }
  else if x == 9 { 9 }
  else if x == 10 { 10 }
  else if x == 11 { 11 }
  else if x == 12 { 12 }
  else if x == 13 { 13 }
  else if x == 14 { 14 }
  else if x == 15 { 15 }
  else if x == 16 { 16 }
  else if x == 17 { 17 }
  else if x == 18 { 18 }
  else if x == 19 { 19 }
  else if x == 20 { 20 }
  else if x == 21 { 21 }
  else if x == 22 { 22 }
  else if x == 23 { 23 }
  else if x == 24 { 24 }
  else if x == 25 { 25 }
  else if x == 26 { 26 }
  else if x == 27 { 27 }
  else if x == 28 { 28 }
  else if x == 29 { 29 }
  else if x == 30 { 30 }
  else if x == 31 { 31 }
  else { 32 }
}
