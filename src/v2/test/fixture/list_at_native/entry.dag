module v2.test.fixture.list_at_native

import v2.std.collection { list_at_optional }
import v2.test.claim.collection.list_at_equivalence { list_at_fixture, list_at_value }

// The host supplies the index at runtime; the fixture and Optional projection are shared
// with the seed/reference witness. The emitted body must perform the indexed read.
fn f(index: Int) -> Int {
  list_at_value(answer: list_at_optional(xs: list_at_fixture, index: index))
}

fn empty(index: Int) -> Int {
  list_at_value(answer: list_at_optional(xs: [], index: index))
}
