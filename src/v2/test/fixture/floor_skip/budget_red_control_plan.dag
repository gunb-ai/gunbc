module v2.test.fixture.floor_skip.budget_red_control_plan

import std.realization_schedule {
  Runnable,
  RunnableSingleClaim,
  WalkPlan,
  NoPreWalkExecution,
  runnable_resource_profile_negligible
}
import gunbc.ci_materialization {
  FloorFinalization,
  ResolveObligation,
  ResolveObligationSubject,
  CompileAnchorWholeTree,
}
import v2.std.collection { List }
import std.types { Int }

data budget_red_control_plan_note: String = "THE COST WALL's by-execution RED-control fixture (endgame D5): a minimal plan whose fn is NAMED gunbc_ci_floor_plan so claim_executor arms the per-batch derived clamp against it — one tiny hermetic batch, one generous overhead row (600s) with rate 0, so the computed clamp is 600s. RED direction: GUNBC_FLOOR_BATCH_BUDGET_TIGHTEN_MS=0 tightens the budget to zero, the batch overruns by construction, and the run must exit nonzero with the typed FLOOR-BATCH-OVER-BUDGET refusal naming batch 1. GREEN direction: the same invocation without the env exits zero. The injection is tighten-only (min), so this fixture can force the refusal but can never widen a real budget — a fault injection, not an escape hatch. Recipe: target/release/claim_executor --source-root dag --source-root src/v2 --plan-entry src/v2/test/fixture/floor_skip/budget_red_control_plan.dag --plan-function gunbc_ci_floor_plan. Lives under test/fixture/floor_skip/ (discovery-excluded at dir grain) and declares no test fns, so it is invisible to the witness corpus — driven only by this recipe."

fn budget_red_control_claim() -> Runnable {
  RunnableSingleClaim {
    entry: "src/v2/test/fixture/floor_skip/falsifier_divergence_control_test.dag",
    function: "falsifier_green_control_holds",
    profile: runnable_resource_profile_negligible()
  }
}

data budget_red_control_declared_resolve_note: String = "The fixture DECLARES its finalization policy in its own plan value (declared 1: exactly one single-claim batch paying exactly one entry resolve) — it no longer needs a name-impersonated projection fn, because the policy is a WalkPlan FIELD (walk_finalization_note): the executor reads the parsed value. The return type WalkPlan<FloorFinalization> declares which family this fixture carries; it does not make the empty policy unwritable, since the typechecker does not check a return type against the body (std.realization_schedule walk_finalization_note). Materialization disclosure is intrinsic to FloorFinalization, so this fixture obligates both floor laws by inhabiting the type — there is no Bool to set."

fn gunbc_ci_floor_plan() -> WalkPlan<FloorFinalization> {
  WalkPlan {
    pre_walk_execution: NoPreWalkExecution {},
    batches: [[budget_red_control_claim()]],
    finalization: FloorFinalization {
      expected_resolve_obligations: [
        ResolveObligation {
          identity: CompileAnchorWholeTree,
          subject: ResolveObligationSubject {
            entry: "src/v2/test/fixture/floor_skip/falsifier_divergence_control_test.dag",
            function: "falsifier_green_control_holds",
          },
        },
      ],
    },
    on_success_stages: [],
    ordinary_budget: none,
    on_success_budget: none,
  }
}

fn gunbc_ci_floor_batch_clamp_overhead_seconds() -> List<Int> {
  [600]
}

fn gunbc_ci_floor_batch_clamp_per_unit_ms() -> List<Int> {
  [0]
}

fn gunbc_ci_floor_batch_clamp_authority_modules() -> List<String> {
  ["v2.test.fixture.floor_skip.budget_red_control_plan"]
}

fn gunbc_ci_floor_batch_clamp_authority_decls() -> List<String> {
  ["gunbc_ci_floor_batch_clamp_overhead_seconds"]
}
