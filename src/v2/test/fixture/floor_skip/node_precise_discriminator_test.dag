module v2.test.fixture.floor_skip.node_precise_discriminator

import v2.std.node { Atom, Conj, Edge, Node, Positional, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  EqualsClaim,
  TestClaim,
  ManualAnchorAbsent,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.test.fixture.floor_skip.floor_disc_shared_helper { floor_disc_shared_helper }
import v2.workflow.affected_set_floor_runner { floor_claim_touches_rerun_frontier }

data floor_disc_node_a: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_disc_node_a_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data floor_disc_node_b: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_disc_node_b_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data floor_disc_node_c: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_disc_node_c_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data floor_disc_orphan_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^floor_disc_orphan_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data floor_disc_helper_conj: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: floor_disc_node_c
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn floor_disc_helper_fn() -> Bool {
  floor_disc_shared_helper()
}

data floor_disc_claim_on_a: TestClaim = EqualsClaim {
  label: "floor_disc: claim on node A",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: floor_disc_node_a,
  rhs: floor_disc_node_a,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data floor_disc_claim_on_b: TestClaim = EqualsClaim {
  label: "floor_disc: claim on node B",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: floor_disc_node_b,
  rhs: floor_disc_node_b,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data floor_disc_claim_transitive: TestClaim = EqualsClaim {
  label: "floor_disc: conj-wrapped transitive claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: floor_disc_helper_conj,
  rhs: floor_disc_helper_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

test fn floor_disc_witness_a_only_holds() -> Bool {
  floor_claim_touches_rerun_frontier(
    claim: floor_disc_claim_on_a,
    frontier: [floor_disc_node_a]
  )
    && !floor_claim_touches_rerun_frontier(
      claim: floor_disc_claim_on_a,
      frontier: [floor_disc_node_b]
    )
}

test fn floor_disc_witness_b_only_holds() -> Bool {
  floor_claim_touches_rerun_frontier(
    claim: floor_disc_claim_on_b,
    frontier: [floor_disc_node_b]
  )
    && !floor_claim_touches_rerun_frontier(
      claim: floor_disc_claim_on_b,
      frontier: [floor_disc_node_a]
    )
}

test fn floor_disc_witness_transitive_holds() -> Bool {
  floor_claim_touches_rerun_frontier(
    claim: floor_disc_claim_transitive,
    frontier: [floor_disc_node_c]
  )
}
