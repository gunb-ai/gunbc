fn nullary_reflection_through_generic_wrapper<T>(
  type_name: Symbol,
  discriminant_of: fn(T) -> Symbol
) -> Outcome<List<T>> {
  coproduct_nullary_inhabitants(
    type_name: type_name,
    discriminant_of: discriminant_of
