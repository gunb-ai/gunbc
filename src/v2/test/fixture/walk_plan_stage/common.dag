module v2.test.fixture.walk_plan_stage.common

import std.realization_schedule {
  Runnable,
  RunnableSingleClaim,
  RunnableResourceProfile,
  runnable_resource_profile,
  runnable_resource_profile_negligible,
  runnable_memory_negligible
}
import std.execution_mode { Wet, Hermetic }
import extdeps.filesystem.filesystem_io { Filesystem }

data walk_plan_stage_fixture_note: String = "Production-path stage-executor controls for #7499 run_stage extraction. Each plan function returns a real WalkPlan with populated on_success_stages and is driven through claim_executor --plan-entry/--plan-function (same pattern as floor_skip/budget_red_control_plan.dag). Declines from the required floor by AUTHORED MODULE PREFIX (v2.workflow.required_floor fixture_home_prefixes) and is driven only by the recipes in plan.dag. THAT SENTENCE USED TO READ 'discovery-excluded at dir grain', and it was false from the floor cut until 2026-08-23: a directory stopped being what discovery reads, so all nine test fns here were discovered, planned and enrolled — two on v2.workflow.floor_expected_red and seven on v2.workflow.floor_route_gap — nine permanent rows on two rosters that are only allowed to shrink. The correction is a prefix on the authored module name, which is the fact the 2026-08-04 admission ruling says may gate; nothing here is coverage the floor lost, because the recipes were always the executing consumer. Wet claims use typed service operations (shell.Mkdir/Remove/Test, Filesystem.Read/Write) — no medium-as-string shell programs. Stage-1 overlap peers record independent markers only (walk_plan_note: no guaranteed sibling order or wall-time concurrency); spawn/join overlap is unit-latched in claim_executor stage_members_actually_overlap. Staged plans require GUNBC_WALK_ATTEMPT_ID=walk_plan_stage_attempt_id (claim_executor refuses unidentified walks before any batch). Receipt paths are attempt-scoped under walk_plan_stage_attempt_dir — one authority for attempt_id, receipt paths, stage-2 marker, and plan entry; walk_plan_stage_materialize_harness_authority_holds writes them for the #[ignore] Rust harness (gunbc.walk_plan_stage_fixture_scaffold) so the seed transport consumes rather than forks. GREEN recipes must show claim_executor progress lines for on-success stages, not merely exit 0 — FloorBudgetBelowMinimumFootprint can fail-fast before any batch on memory-tight hosts."

data walk_plan_stage_plan_entry: String = "src/v2/test/fixture/walk_plan_stage/plan.dag"

data walk_plan_stage_attempt_id: String = "walk-plan-stage-fixture"

data walk_plan_stage_attempt_dir: String = "target/floor-attempt-walk-plan-stage-fixture"

data walk_plan_stage_stage1_receipt_path: String = "target/floor-attempt-walk-plan-stage-fixture/on-success-stage-1-receipt.tsv"

data walk_plan_stage_stage2_receipt_path: String = "target/floor-attempt-walk-plan-stage-fixture/on-success-stage-2-receipt.tsv"

data walk_plan_stage_stage2_marker_path: String = "target/walk_plan_stage_stage2_ran"

data walk_plan_stage_harness_authority_path: String = "target/walk_plan_stage_harness_authority.txt"

data walk_plan_stage_overlap_peer_a_entry: String = "src/v2/test/fixture/walk_plan_stage/overlap_peer_a_test.dag"

data walk_plan_stage_overlap_peer_b_entry: String = "src/v2/test/fixture/walk_plan_stage/overlap_peer_b_test.dag"

data walk_plan_stage_plan_site: String = "src/v2/test/fixture/walk_plan_stage/plan.dag::walk_plan_stage_overlap_barrier_plan"

data walk_plan_stage_barrier_receipt_row_note: String = "Per-stage receipt claim rows are tab-separated: claim, entry, function, outcome, wall_ms (#7518). plan_site in the header is plan.dag::plan_function."

fn walk_plan_stage_negligible_wet_profile() -> RunnableResourceProfile {
  runnable_resource_profile(
    heavy_whole_tree_resolve: false,
    spawns_host_compiler: false,
    memory: runnable_memory_negligible(),
    execution_mode: Wet
  )
}

fn walk_plan_stage_green_floor_claim() -> Runnable {
  RunnableSingleClaim {
    entry: "src/v2/test/fixture/floor_skip/falsifier_divergence_control_test.dag",
    function: "falsifier_green_control_holds",
    profile: runnable_resource_profile_negligible()
  }
}

fn walk_plan_stage_cleanup_claim() -> Runnable {
  RunnableSingleClaim {
    entry: "src/v2/test/fixture/walk_plan_stage/cleanup_test.dag",
    function: "walk_plan_stage_cleanup_holds",
    profile: walk_plan_stage_negligible_wet_profile()
  }
}

