module v2.test.fixture.walk_plan_stage.plan


data walk_plan_stage_overlap_barrier_recipe: String = "GREEN overlap+barrier: GUNBC_WALK_ATTEMPT_ID=walk-plan-stage-fixture target/release/claim_executor --source-root dag --source-root src/v2 --plan-entry src/v2/test/fixture/walk_plan_stage/plan.dag --plan-function walk_plan_stage_overlap_barrier_plan. Must print on-success stage progress, PASS both overlap peers (independent markers — no guaranteed sibling order or concurrent admission per walk_plan_note), write target/floor-attempt-walk-plan-stage-fixture/on-success-stage-1-receipt.tsv, then PASS barrier witness, exit 0. RED if stage-1 omits a peer or stage 2 runs before stage-1 receipt finalization."

data walk_plan_stage_failure_barrier_recipe: String = "RED failure barrier: GUNBC_WALK_ATTEMPT_ID=walk-plan-stage-fixture same claim_executor invocation with --plan-function walk_plan_stage_failure_barrier_plan. Stage-1 red member must fail; executor must print remaining stage(s) NOT run; target/walk_plan_stage_stage2_ran must stay absent."

data walk_plan_stage_recursion_refusal_barrier_recipe: String = "RED recursion-refusal barrier: GUNBC_WALK_ATTEMPT_ID=walk-plan-stage-fixture same invocation with --plan-function walk_plan_stage_recursion_refusal_barrier_plan. Stage-1 self-recursive member must fail with interpreter call-depth refusal (unbounded recursion); stage 2 must not run; target/walk_plan_stage_stage2_ran must stay absent. Deviation note: authored .dag recursion is refused inside the interpreter; it is not evidence of a worker-thread unwind. The structural thread-panic path stays pinned at the executor unit boundary by join_reports_a_panicking_member_without_losing_the_others, which injects a genuinely panicking Rust closure and proves sibling evidence survives."

data walk_plan_stage_receipt_refusal_barrier_recipe: String = "RED receipt-write refusal barrier: GUNBC_WALK_ATTEMPT_ID=walk-plan-stage-fixture same invocation with --plan-function walk_plan_stage_receipt_refusal_barrier_plan. Stage-1 receipt write must fail closed after the poison claim; stage 2 must not run; target/walk_plan_stage_stage2_ran must stay absent."

