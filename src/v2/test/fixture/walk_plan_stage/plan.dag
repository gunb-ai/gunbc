module v2.test.fixture.walk_plan_stage.plan

import std.realization_schedule {
  WalkPlan,
  NoWalkFinalization,
  NoFinalizationDeclared
}
import v2.test.fixture.walk_plan_stage.common {
  walk_plan_stage_fixture_note,
  walk_plan_stage_green_floor_claim,
  walk_plan_stage_cleanup_claim,
  walk_plan_stage_overlap_peer_a_claim,
  walk_plan_stage_overlap_peer_b_claim,
  walk_plan_stage_barrier_witness_claim,
  walk_plan_stage_failure_red_member_claim,
  walk_plan_stage_panic_member_claim,
  walk_plan_stage_receipt_refusal_poison_claim,
  walk_plan_stage_stage2_marker_claim
}

data walk_plan_stage_overlap_barrier_recipe: String = "GREEN overlap+barrier: GUNBC_WALK_ATTEMPT_ID=walk-plan-stage-fixture target/release/claim_executor --source-root dag --source-root src/v2 --plan-entry src/v2/test/fixture/walk_plan_stage/plan.dag --plan-function walk_plan_stage_overlap_barrier_plan. Must print on-success stage progress, PASS both overlap peers, write target/floor-attempt-walk-plan-stage-fixture/on-success-stage-1-receipt.tsv, then PASS barrier witness, exit 0. RED if run_stage serializes stage-1 members: the waiting_a/waiting_b handshake times out (10m) because the second peer never starts while the first is blocked."

data walk_plan_stage_failure_barrier_recipe: String = "RED failure barrier: GUNBC_WALK_ATTEMPT_ID=walk-plan-stage-fixture same claim_executor invocation with --plan-function walk_plan_stage_failure_barrier_plan. Stage-1 red member must fail; executor must print remaining stage(s) NOT run; target/walk_plan_stage_stage2_ran must stay absent."

data walk_plan_stage_panic_barrier_recipe: String = "RED panic barrier: GUNBC_WALK_ATTEMPT_ID=walk-plan-stage-fixture same invocation with --plan-function walk_plan_stage_panic_barrier_plan. Stage-1 panicking member must be reported as infra=thread_panic; stage 2 must not run; target/walk_plan_stage_stage2_ran must stay absent."

data walk_plan_stage_receipt_refusal_barrier_recipe: String = "RED receipt-write refusal barrier: GUNBC_WALK_ATTEMPT_ID=walk-plan-stage-fixture same invocation with --plan-function walk_plan_stage_receipt_refusal_barrier_plan. Stage-1 receipt write must fail closed after the poison claim; stage 2 must not run; target/walk_plan_stage_stage2_ran must stay absent."

fn walk_plan_stage_overlap_barrier_plan() -> WalkPlan<NoWalkFinalization> {
  WalkPlan {
    batches: [[walk_plan_stage_green_floor_claim(), walk_plan_stage_cleanup_claim()]],
    finalization: NoFinalizationDeclared {},
    on_success_stages: [
      [walk_plan_stage_overlap_peer_a_claim(), walk_plan_stage_overlap_peer_b_claim()],
      [walk_plan_stage_barrier_witness_claim()],
    ],
  }
}

fn walk_plan_stage_failure_barrier_plan() -> WalkPlan<NoWalkFinalization> {
  WalkPlan {
    batches: [[walk_plan_stage_green_floor_claim(), walk_plan_stage_cleanup_claim()]],
    finalization: NoFinalizationDeclared {},
    on_success_stages: [
      [walk_plan_stage_failure_red_member_claim()],
      [walk_plan_stage_stage2_marker_claim()],
    ],
  }
}

fn walk_plan_stage_panic_barrier_plan() -> WalkPlan<NoWalkFinalization> {
  WalkPlan {
    batches: [[walk_plan_stage_green_floor_claim(), walk_plan_stage_cleanup_claim()]],
    finalization: NoFinalizationDeclared {},
    on_success_stages: [
      [walk_plan_stage_panic_member_claim()],
      [walk_plan_stage_stage2_marker_claim()],
    ],
  }
}

fn walk_plan_stage_receipt_refusal_barrier_plan() -> WalkPlan<NoWalkFinalization> {
  WalkPlan {
    batches: [[walk_plan_stage_green_floor_claim(), walk_plan_stage_cleanup_claim()]],
    finalization: NoFinalizationDeclared {},
    on_success_stages: [
      [walk_plan_stage_receipt_refusal_poison_claim()],
      [walk_plan_stage_stage2_marker_claim()],
    ],
  }
}
