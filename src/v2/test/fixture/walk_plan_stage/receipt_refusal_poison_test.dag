module v2.test.fixture.walk_plan_stage.receipt_refusal_poison


test fn walk_plan_stage_receipt_refusal_poison_holds() -> Bool {
  let target_ready = shell.Mkdir.Parents(path: "target")
  if !target_ready.success {
    false
  } else {
    let _cleared = shell.Remove.RecursiveForce(path: v2.test.fixture.walk_plan_stage.common.walk_plan_stage_stage1_receipt_path)
    shell.Mkdir.Parents(path: v2.test.fixture.walk_plan_stage.common.walk_plan_stage_stage1_receipt_path).success
  }
}
