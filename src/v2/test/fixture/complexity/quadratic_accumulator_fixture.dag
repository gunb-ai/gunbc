module fixture.complexity.quadratic_accumulator

import v2.std.algebra { list_append }
import std.algebra { Empty }
import v2.std.node { Node }
import v2.std.collection { List }

fn quadratic_flatten(xss: List<List<Node>>) -> List<Node> {
  fold(xss, init: Empty, f: fn(acc, chunk) {
    list_append(left: acc, right: chunk)
  })
}
