module v2.test.coercion_fold_int_rust_fixture

import v2.extdeps.languages.rust { rust_inhabitant_i32_node }
import v2.std.coercion {
  CoercionCandidateSet,
  CoercionResult,
  coercion_fold
}
import v2.std.diagnostic { Outcome }
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.find_witness { CandidateSet, TargetDeclaredPriority }
import v2.std.integer { Int }
import v2.std.node {
  Atom,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v2.std.witness { StructuralPropertyWitness }
fn int_source_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^fixture_int_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn int_source_grounding_fixture() -> CanonicalGrounding {
  CanonicalGrounding {
    node: int_source_node(),
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^fixture_property_closed_candidates,
        evidence: int_source_node()
      },
      closedness: StructuralPropertyWitness {
        property: ^fixture_property_candidate_set_closedness,
        evidence: int_source_node()
      }
    }
  }
}
fn rust_i32_candidate_fixture() -> CoercionCandidateSet {
  CoercionCandidateSet {
    set: CandidateSet {
      candidates: [rust_inhabitant_i32_node()],
      closedness: StructuralPropertyWitness {
        property: ^fixture_property_candidate_set_closedness,
        evidence: int_source_node()
      }
    }
  }
}
fn coercion_fold_int_to_i32_fixture() -> Outcome<CoercionResult> {
  coercion_fold(
    source: int_source_grounding_fixture(),
    candidates: rust_i32_candidate_fixture(),
    policy: TargetDeclaredPriority {
      priority: rust_inhabitant_i32_node()
    }
  )
}
