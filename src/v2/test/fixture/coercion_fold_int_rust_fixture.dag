module v2.test.coercion_fold_int_rust_fixture

fn int_source_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^fixture_int_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}
fn int_source_grounding_fixture() -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: int_source_node(),
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^fixture_property_closed_candidates,
        evidence: int_source_node()
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^fixture_property_candidate_set_closedness,
        evidence: int_source_node()
      }
    }
  }
}
fn rust_i32_candidate_fixture() -> v2.std.coercion.CoercionCandidateSet {
  v2.std.coercion.CoercionCandidateSet {
    set: v2.std.find_witness.CandidateSet {
      candidates: [rust_inhabitant_i32_node()],
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^fixture_property_candidate_set_closedness,
        evidence: int_source_node()
      }
    }
  }
}
fn coercion_fold_int_to_i32_fixture() -> Outcome<v2.std.coercion.CoercionResult> {
  coercion_fold(
    source: int_source_grounding_fixture(),
    candidates: rust_i32_candidate_fixture(),
    policy: v2.std.find_witness.TargetDeclaredPriority {
      priority: rust_inhabitant_i32_node()
    }
  )
}
