// Materialized fixture for the statement-position claim suite (v2.test.claim.namespace_xl0.let_statement_position).
// Read as a module by the native lane. Discriminator: a braced arm block whose tail statement begins with a parenthesized expression, the shape dag/gunbc/instruments/compute_run_unit_cold.dag:97 authors. If this refuses while lst_tail_call lowers, a statement expression cannot begin with '(', which is where the residual refusal lives.
module v2.test.fixture.namespace_xl0.lst_tail_paren

import v2.std.logic { Bool }
import v2.std.integer { Int }

type LstS = LstA { v: Int } | LstB

fn lst_uses(x: Int) -> Int { x }

fn lst_equal(a: Int, b: Int) -> Bool { a == b }

fn lst_probe(s: LstS, i: Int) -> Int { match s {
  LstA { v: v } => lst_uses(x: v)
  LstB => {
    let root = i
    (lst_equal(a: root, b: v_or(i)) || lst_uses(x: root)) as Int
  }
} }

fn v_or(i: Int) -> Int { i }
