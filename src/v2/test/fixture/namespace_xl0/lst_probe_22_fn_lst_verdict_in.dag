module v2.test.fixture.namespace_xl0.lst_probe_22_fn_lst_verdict_in
import v2.compiler.source_root_eval {

fn lst_verdict_in(context: NativeTestContext, module_name: String, unit: Symbol) -> LstVerdict {
  fold_list(
    xs: native_census_modules(ingest: lst_ingest()),
    empty: LstAbsent,
    cons: fn(acc, entry) {
      if entry.module == module_name {
        lst_verdict_of(
          context: context,
          unit: unit,
          outcome: native_census_module_resolution(
            context: context,
            refusal_index: native_lane_file_refusal_index(refusals: context.file_refusals),
            entry: entry
          ).outcome
        )
      } else {
        acc
      }
    }
  )
}
