// Minimal repro A (delete once the front-end ruling lands).
// One data item whose value is a call expression and nothing else in the module is unusual.
// The v2 parse population refuses this file with parse_data_value_missing_after_eq; the compiler route
// (gunbc compile --entry this file) accepts it. If this file is refused and probe_data_cons is not, the
// refusal is exactly "a call expression in a data value".
module v2.test.fixture.namespace_xl0.lst_probe_data_call

type ProbeBox {
  v: Int
}

fn probe_make(v: Int) -> ProbeBox {
  ProbeBox { v: v }
}

data probe_value: ProbeBox = probe_make(v: 1)

fn probe_get() -> Int {
  probe_value.v
}
