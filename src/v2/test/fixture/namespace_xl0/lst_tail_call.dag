// Materialized fixture for the statement-position claim suite (v2.test.claim.namespace_xl0.let_statement_position).
// Read as a module by the native lane. Control for lst_tail_paren: same braced block, same bindings, tail statement is a plain call. Must lower.
module v2.test.fixture.namespace_xl0.lst_tail_call

import v2.std.logic { Bool }
import v2.std.integer { Int }

type LstS = LstA { v: Int } | LstB

fn lst_uses(x: Int) -> Int { x }

fn lst_equal(a: Int, b: Int) -> Bool { a == b }

fn lst_probe(s: LstS, i: Int) -> Int { match s {
  LstA { v: v } => lst_uses(x: v)
  LstB => {
    let root = i
    lst_uses(x: root)
  }
} }
