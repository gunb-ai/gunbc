module v2.test.fixture.workflow_default_module_scope.subject

// The SUBJECT of test.claim.workflow_default_module_scope_witness_test: a workflow func whose
// `model` param default names a data declaration THIS module authors. The witness entry module
// declares the same spelling with a different value and imports this one, which is the shape
// gunbc.tools.review and gunbc.tools.review_codex are in on main.
//
// WHY THE SUBJECT LIVES IN THE TREE RATHER THAN IN THE WITNESS STRING. compile_dag_rust_emit_check
// compiles ONE authored source and resolves its imports from the real tree, appending the entry
// LAST. Under the bare last-wins index the entry's declaration therefore always won, so a
// collision authored entirely inside the entry could never exhibit the defect -- the module whose
// default is read has to be the one the fold reaches FIRST.
//
// IMPORT-FREE ON PURPOSE. `WdmsNet` is declared here rather than reached through std.resources so
// the witness closure is two modules instead of the corpus; the emitter's treatment of a param
// default does not depend on which type the `uses` clause names.

type WdmsNet {
  id: Int
}

data wdms_probe_marker: String = "wdms-subject-marker"

data wdms_default_model: String = "wdms-subject-owned"

func wdms_run(model: String = wdms_default_model) -> String
  uses net: WdmsNet
{
  model
}
