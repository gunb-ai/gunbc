module v2.test.fixture.production_qualification_origin_probe.cadence_receipt_plan

import std.realization_schedule { walk_declares_no_native_routing }
import std.realization_schedule {
  WalkPlan,
  NoWalkFinalization,
  NoFinalizationDeclared,
  NoPreWalkExecution
}
import v2.workflow.ci_floor_plan {
  gunbc_falsifier_known_red_probe_batch,
  gunbc_falsifier_substrate_long_lane_batch
}

data production_qualification_origin_probe_cadence_receipt_plan_note: String = "Head-bound composed-batch cadence receipt (wise-ram-22 / operator gate, reproducible at 4e805b48eac): mirrors falsifier batch 3 (known-red probe, expect_red) then batch 6 (substrate-long, ordinary GREEN expectation) using the production plan's RunnableDiscoveryBatch values — not per-function claim_batch. Function is named gunbc_falsifier_plan so claim_executor arms hermetic known-red inversion and substrate-long eval budget (the executor keys those off plan_function, not plan entry). Accepted receipt: batch 1 expect_red PASS (4 probe rows raw FAIL); batch 2 admission_holds GREEN 7872ms; probe RED rows absent from batch 2 roster; batch 2 overall FAIL attributed to 4 pre-existing direct_rust_door rows (#7737). Lives under test/fixture/ (discovery-excluded). Recipe: claim_executor --source-root dag --source-root src/v2 --plan-entry src/v2/test/fixture/production_qualification_origin_probe/cadence_receipt_plan.dag --plan-function gunbc_falsifier_plan"

fn gunbc_falsifier_plan() -> WalkPlan<NoWalkFinalization> {
  WalkPlan {
    pre_walk_execution: NoPreWalkExecution {},
    batches: [
      [gunbc_falsifier_known_red_probe_batch()],
      [gunbc_falsifier_substrate_long_lane_batch()]
    ],
    finalization: NoFinalizationDeclared {},
    on_success_stages: [],
    ordinary_budget: none,
    on_success_budget: none,
    identity_routes: [],
    default_route: walk_declares_no_native_routing(),
  }
}
