  ChangedSelectionDispositionRow { identity: ".lead", disposition: DeclinedChangedWitnessOutsideDiscovery { module_path: "" } },
  ChangedSelectionDispositionRow { identity: "a..b", disposition: DeclinedChangedWitnessOutsideDiscovery { module_path: "a." } },
  ChangedSelectionDispositionRow { identity: "test.claim.gamma_witness.w_undeclared", disposition: DeclinedChangedWitnessOutsideDiscovery { module_path: "test.claim.gamma_witness" } }
