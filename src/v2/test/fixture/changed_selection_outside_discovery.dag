data changed_selection_fixture_changed: List<String> = [
  "test.claim.alpha_witness.w_declared",
  "v1.tests.claim.beta_witness.w_v1_home",
  "solo",
  ".lead",
  "a..b",
  "test.claim.gamma_witness.w_undeclared"
]

data changed_selection_fixture_declared: List<String> = [
  "test.claim.alpha_witness.w_declared",
  "test.claim.delta_witness.w_unchanged"
]

data changed_selection_fixture_expected: List<ChangedSelectionDispositionRow> = [
