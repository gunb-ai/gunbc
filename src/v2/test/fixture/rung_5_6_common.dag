module v2.test.rung_5_6_common

import v2.compiler.emit_host {
  run_test_claim_emit_vs_eval
}
import v2.extdeps.languages.go { go_mvp1_runtime_row, go_mvp1_source_text }
import v2.extdeps.languages.python { python_mvp1_runtime_row, python_mvp1_source_text }
import v2.compiler.eval {
  TestClaimRun
}
import v2.std.collection { empty_map }
import v2.std.compilers.lexing { VoidLexRules }
import v2.std.node { Node }
import v2.std.runtime { RuntimeValue }
import v2.std.compilers.target_model { TargetModel, target_model_emit_transforms_empty }
import v2.std.verification { TestClaim }
import v2.test.rung_3_4_common {
  rung34_emit_host_rust_target_model,
  rung34_emit_host_target_bundle,
  rung34_test_claim_subject
}

data rung56_emit_host_python_target_model: TargetModel = TargetModel {
  bundle: rung34_emit_host_target_bundle,
  lex: VoidLexRules,
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: python_mvp1_source_text,
  runtime_row: python_mvp1_runtime_row()
}

data rung56_emit_host_go_target_model: TargetModel = TargetModel {
  bundle: rung34_emit_host_target_bundle,
  lex: VoidLexRules,
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: go_mvp1_source_text,
  runtime_row: go_mvp1_runtime_row()
}

fn rung56_emit_vs_eval_run(
  claim: TestClaim,
  fixture_subject: Node,
  target: TargetModel
) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: rung34_test_claim_subject(claim: claim, evaluator_input: fixture_subject),
    target: target
  )
}
