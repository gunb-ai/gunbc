module v2.test.fixture.spice_rc_tran_deck


data spice_rc_tran_deck: v2.extdeps.formats.spice.SpiceNetlist = v2.extdeps.formats.spice.SpiceNetlist {
  title: "* rc tran witness",
  body: std.algebra.Cons {
    head: v2.extdeps.formats.spice.DeckComponent {
      component: v2.extdeps.formats.spice.VoltageSource {
        name: "1",
        n_plus: v2.extdeps.formats.spice.Named { node: v2.extdeps.formats.spice.NamedNode { name: "n1" } },
        n_minus: v2.extdeps.formats.spice.Ground,
        value: v2.extdeps.formats.spice.SpiceValue { lexeme: "DC 5" }
      }
    },
    tail: std.algebra.Cons {
      head: v2.extdeps.formats.spice.DeckComponent {
        component: v2.extdeps.formats.spice.Resistor {
          name: "1",
          n_plus: v2.extdeps.formats.spice.Named { node: v2.extdeps.formats.spice.NamedNode { name: "n1" } },
          n_minus: v2.extdeps.formats.spice.Named { node: v2.extdeps.formats.spice.NamedNode { name: "n2" } },
          value: v2.extdeps.formats.spice.SpiceValue { lexeme: "1000" }
        }
      },
      tail: std.algebra.Cons {
        head: v2.extdeps.formats.spice.DeckComponent {
          component: v2.extdeps.formats.spice.Capacitor {
            name: "1",
            n_plus: v2.extdeps.formats.spice.Named { node: v2.extdeps.formats.spice.NamedNode { name: "n2" } },
            n_minus: v2.extdeps.formats.spice.Ground,
            value: v2.extdeps.formats.spice.SpiceValue { lexeme: "1e-6" }
          }
        },
        tail: std.algebra.Cons {
          head: v2.extdeps.formats.spice.DeckDirective {
            directive: v2.extdeps.formats.spice.InitialCondition {
              assignments: v2.extdeps.formats.spice.NodeVoltageBindings {
                first: v2.extdeps.formats.spice.NodeVoltageBinding {
                  node: v2.extdeps.formats.spice.Named { node: v2.extdeps.formats.spice.NamedNode { name: "n2" } },
                  value: v2.extdeps.formats.spice.SpiceValue { lexeme: "0" }
                },
                rest: []
              }
            }
          },
          tail: std.algebra.Cons {
            head: v2.extdeps.formats.spice.DeckDirective {
              directive: v2.extdeps.formats.spice.Tran {
                tstep: v2.extdeps.formats.spice.SpiceValue { lexeme: "1us" },
                tstop: v2.extdeps.formats.spice.SpiceValue { lexeme: "10ms" }
              }
            },
            tail: std.algebra.Empty
          }
        }
      }
    }
  }
}

data spice_rc_tran_deck_ngspice_golden: String = "* rc tran witness\nV1 n1 0 DC 5\nR1 n1 n2 1000\nC1 n2 0 1e-6\n.ic v(n2)=0\n.tran 1us 10ms\n.control\nrun\nquit\n.endc\n.end"
