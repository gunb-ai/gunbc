module v2.test.fixture.medium_structure_scan.leak_plant
import v2.std.logic { Bool }
import v2.std.text { String }

// EMIT-SIDE planted leak: a string literal carrying the grounded GHA expression delimiter `${{`
// (GitHub Actions expression syntax) — the medium leaking out of a Node into authored source.
fn planted_emit_side_leak() -> String {
  "HOME: ${{ runner.temp }}/cargo"
}

// A LOCAL stand-in for an emit fn (its NAME is in emitted_medium_emit_fns). The host's check-side
// detector matches the call-target NAME, so this models an emitted-medium producer without
// importing one — and keeps the fixture self-contained / resolvable.
fn expected_ci_yml() -> String {
  "runs-on: linux\n"
}

// CHECK-SIDE planted leak: a string-op whose receiver traces (one intra-fn `let` hop) to a call
// of the emit fn — inspecting emitted medium output by string. The `pattern:` is deliberately
// marker-FREE so this contributes ONE leak (check-side), not two.
fn planted_check_side_leak() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "runs-on")
}

// CLEAN CONTROL A — a string literal with NO grounded marker → must NOT flag emit-side.
fn clean_plain_literal() -> String {
  "HOME: /home/runner/cargo"
}

// CLEAN CONTROL B — a string-op over a NON-emit receiver (a plain param). The receiver-provenance
// gate must hold: not an emitted-medium value → NOT a leak (a test grepping a non-medium string
// is fine).
fn clean_string_op_over_plain(s: String) -> Bool {
  string_contains(s: s, pattern: "runs-on")
}
