module v2.test.fixture.medium_structure_scan.leak_plant
import v2.std.logic { Bool }
import v2.std.text { String }

fn planted_emit_side_leak() -> String {
  "HOME: ${{ runner.temp }}/cargo"
}

fn expected_ci_yml() -> String {
  "runs-on: linux\n"
}

fn planted_check_side_leak() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "runs-on")
}

fn clean_plain_literal() -> String {
  "HOME: /home/runner/cargo"
}

fn clean_string_op_over_plain(s: String) -> Bool {
  string_contains(s: s, pattern: "runs-on")
}

fn planted_shell_emit_side_leak() -> String {
  "#!/usr/bin/env bash"
}

fn ci_yml_drifted(committed: String) -> Bool {
  committed == ""
}

fn planted_provenance_leak_markerfree() -> Bool {
  ci_yml_drifted(committed: "git add && git commit")
}
