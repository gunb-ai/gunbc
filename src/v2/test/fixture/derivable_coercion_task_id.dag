// src/v2/test/fixture/derivable_coercion_task_id.dag
// Scope: DERIVABLE-COERCION demo — one concept (opaque Symbol-backed TaskId) as API+DB+wire
//   nickname triple; shared semantic core (encoding+carrier), distinct SurfaceSpelling per layer.
// Anchor: task_manager_demo.dag TaskId { identity: Symbol }; thesis nickname-tax payoff.
// Status: fixture authority for find_witness/coercion_fold consumers — zero hand translators.

module v2.test.fixture.derivable_coercion_task_id

import v2.std.model_core {
  ModelCoreFactAxisEncoding,
  ModelCoreFactAxisSurfaceSpelling
}
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.witness { StructuralPropertyWitness }

// Layer nicknames — distinct surface spellings (API TaskId, DB TEXT/CLOB, wire string).
data task_id_nickname_api: Symbol = task_id_nickname_api
data task_id_nickname_db: Symbol = task_id_nickname_db
data task_id_nickname_wire: Symbol = task_id_nickname_wire

// Shared semantic core — Encoding carries the coercion-relevant (representation, carrier) core.
// Follow-up: carrier deserves its own declared ModelCore core axis; until then this demo keeps
// representation+carrier together inside the existing Encoding fact value.
data task_id_encoding_opaque_symbol: Symbol = task_id_encoding_opaque_symbol
data task_id_carrier_symbol_identity: Symbol = task_id_carrier_symbol_identity
data task_id_encoding_core_field_representation: Symbol = task_id_encoding_core_field_representation
data task_id_encoding_core_field_carrier: Symbol = task_id_encoding_core_field_carrier

// Wrong-concept discriminator — numeric encoding (AccountId-style hollow int alias).
data account_id_encoding_numeric: Symbol = account_id_encoding_numeric
data account_id_carrier_machine_int: Symbol = account_id_carrier_machine_int
data account_id_nickname_surface: Symbol = account_id_nickname_surface

data derivable_coercion_closed_candidates: Symbol = derivable_coercion_closed_candidates

fn task_id_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn task_id_semantic_core_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisEncoding {}) },
        target: task_id_encoding_core_node(
          representation: task_id_encoding_opaque_symbol,
          carrier: task_id_carrier_symbol_identity
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn task_id_encoding_core_node(representation: Symbol, carrier: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: task_id_encoding_core_field_representation },
        target: task_id_inhabitant_atom(id: representation)
      },
      Edge {
        label: Named { name: task_id_encoding_core_field_carrier },
        target: task_id_inhabitant_atom(id: carrier)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn task_id_layer_inhabitant(surface_nickname: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisEncoding {}) },
        target: task_id_encoding_core_node(
          representation: task_id_encoding_opaque_symbol,
          carrier: task_id_carrier_symbol_identity
        )
      },
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) },
        target: task_id_inhabitant_atom(id: surface_nickname)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

// API layer — domain `TaskId { identity: Symbol }`.
fn task_id_api_inhabitant_node() -> Node {
  task_id_layer_inhabitant(surface_nickname: task_id_nickname_api)
}

// DB layer — SQL TEXT/CLOB column type for `tasks.id`.
fn task_id_db_inhabitant_node() -> Node {
  task_id_layer_inhabitant(surface_nickname: task_id_nickname_db)
}

// Wire layer — OpenAPI `type: string` task-id field.
fn task_id_wire_inhabitant_node() -> Node {
  task_id_layer_inhabitant(surface_nickname: task_id_nickname_wire)
}

fn account_id_wrong_inhabitant_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisEncoding {}) },
        target: task_id_encoding_core_node(
          representation: account_id_encoding_numeric,
          carrier: account_id_carrier_machine_int
        )
      },
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) },
        target: task_id_inhabitant_atom(id: account_id_nickname_surface)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn derivable_coercion_candidate_closedness(evidence: Node) -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: derivable_coercion_closed_candidates,
    evidence: evidence
  }
}
