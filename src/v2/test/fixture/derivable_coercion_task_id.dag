module v2.test.fixture.derivable_coercion_task_id


fn task_id_inhabitant_atom(id: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn task_id_semantic_core_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) },
        target: task_id_encoding_core_node(
          representation: ^task_id_encoding_opaque_symbol,
          carrier: ^task_id_carrier_symbol_identity
        )
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn task_id_encoding_core_node(representation: v2.std.node.Symbol, carrier: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^task_id_encoding_core_field_representation },
        target: task_id_inhabitant_atom(id: representation)
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^task_id_encoding_core_field_carrier },
        target: task_id_inhabitant_atom(id: carrier)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn task_id_layer_inhabitant(surface_nickname: v2.std.node.Symbol) -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) },
        target: task_id_encoding_core_node(
          representation: ^task_id_encoding_opaque_symbol,
          carrier: ^task_id_carrier_symbol_identity
        )
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) },
        target: task_id_inhabitant_atom(id: surface_nickname)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn task_id_api_inhabitant_node() -> Node {
  task_id_layer_inhabitant(surface_nickname: ^task_id_nickname_api)
}

fn task_id_db_inhabitant_node() -> Node {
  task_id_layer_inhabitant(surface_nickname: ^task_id_nickname_db)
}

fn task_id_wire_inhabitant_node() -> Node {
  task_id_layer_inhabitant(surface_nickname: ^task_id_nickname_wire)
}

fn account_id_wrong_inhabitant_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) },
        target: task_id_encoding_core_node(
          representation: ^account_id_encoding_numeric,
          carrier: ^account_id_carrier_machine_int
        )
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) },
        target: task_id_inhabitant_atom(id: ^account_id_nickname_surface)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn derivable_coercion_candidate_closedness(evidence: Node) -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^derivable_coercion_closed_candidates,
    evidence: evidence
  }
}
