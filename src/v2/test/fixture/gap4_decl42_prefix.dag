// PROV A-pivot wave-2: per-compile occurrence mint + off-tree SpanIndex; global coherence via
// parse_prov_merge across memoized parse-table cells and threaded table build.
type ParseProvenanceState {
  alloc: OccurrenceIdAllocator
  index: SpanIndex
}

type ParseArtifact {
  tree: ParseTree
  span_index: SpanIndex
}

type ParseMintSourceResult {
  id: OccurrenceId
  prov: ParseProvenanceState
}

type ParseStampResult {
  node: Node
  prov: ParseProvenanceState
}

// 🟡 coproduct dissolution — feature:T-8-parse-result-projection; per-expression walk result; dissolves when parse-walk result carrier unifies with Outcome<ParseTree> via T-8 projection (remaining/captured consolidates; List<Diagnostic> accumulator lifts into standard Diagnostics).
type ParseExprResult
  = ParseExprAccepted {
      remaining: List<Token>,
      captured: Node,
      diagnostics: List<Diagnostic>,
      prov: ParseProvenanceState
    }
  | ParseExprRejected { diagnostics: List<Diagnostic> }

type ParseSyncState {
  found_sync: Bool
  result: List<Token>
}

// Accumulator for the fold-list based Repeat implementation in parse_expr.
// fold_list over the token stream bounds iterations to length(tokens);
// done: true short-circuits remaining steps.
type ParseRepeatAcc {
  remaining: List<Token>
  acc_nodes: List<Node>
  acc_diags: List<Diagnostic>
  done: Bool
  prov: ParseProvenanceState
}

// Product accumulator for expr_direct_left_corner_list: corners plus nullable flag
// threaded through fold_grammar_expr so Sequence can gate right corners on left nullability.
type GrammarExprCornerFold {
  corners: List<Symbol>
  nullable: Bool
}

// 🟢 coproduct dissolved — feature: GrammarExpr parse interpreter — bind node://adhoc-2145db6b-69a
// ParseExprWalk (1:1 GrammarExpr mirror) deleted; parse_expr_run_walk deleted. parse_expr now
// uses fold_grammar_expr<fn(tok_in,all_toks,root_in,table_in,prov_in)->ParseExprResult>: each
// algebra handler returns a parse thunk; sequence/choice/optional/repeat compose thunks with
// correct token threading; Nonterminal delegates to parse_nonterminal_memoized (leaf).

// Authority facts (dissolve-on: import extdeps.realization.parse_table_memo when v2 compiler layer resolves extdeps):
//   dsl/std/cache_identity.dag: parse_table_artifact_kind = "parse_table"
//   extdeps/realization/parse_table_memo.dag: parse_table_memo_id = "parse_table_memo_cache"
// Tracked scaffold — Symbol mirrors until v2 compiler layer imports std (dissolution receipt:
// that layer-resolution landing, not a follow-up). Do not fork ids.
data parse_table_artifact_kind: Symbol = ^parse_table
data parse_table_memo_interface: Symbol = ^parse_table_memo

type ParsePositionKey {
  position: Int
  production: Symbol
}

// ParseTable Realization carrier — spec projects through extdeps realization catalog facts; in-process
// handler is v1_interpreter `parse_table_memo` (dissolves hand-rolled Map-only threading).
// grammar_digest: content_hash of the validated grammar root — stable across files sharing lm.grammar.
// token_stream_digest: content-address of the parse_production token stream — memo cells are
// grammar-scoped but token-stream-specific (prevents cross-source pollution in one context).
type ParseTableRealization {
  artifact_kind: Symbol
  interface: Symbol
  grammar_digest: Hash
  token_stream_digest: Hash
  entries: Map<ParsePositionKey, ParseExprResult>
}

type ParseTable = ParseTableRealization












fn parse_grammar_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^parse_grammar_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_g0_tokens_remain_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^parse_g0_tokens_remain,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


