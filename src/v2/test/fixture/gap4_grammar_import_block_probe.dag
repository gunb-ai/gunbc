// Probe: exact import block shape from 02_parse.dag (22 symbols, newline+comma separated).
module gap4.fixture.grammar_import_block_probe

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse_module }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

test fn grammar_import_block_like_02_parse_holds() -> Bool {
  let lm = dag_language_model_wave1()
  let src = "module m.t\nimport v2.std.grammar {\n  Choice,\n  ParseGrammar,\n  GrammarExpr,\n  GrammarExprFold,\n  GrammarProduction,\n  GrammarRoot,\n  ModeledGrammar,\n  Nonterminal,\n  ParseTree,\n  Repeat,\n  Sequence,\n  Terminal,\n  ValidatedGrammarRoot,\n  VoidGrammar,\n  TerminalStampMode,\n  StampBinding,\n  StampClass,\n  StampLexeme,\n  fold_grammar_expr,\n  grammar_empty_node,\n  grammar_named_edge,\n  grammar_to_node\n}\n"
  match tokenize(text: src, file: ^probe, rules: lm.lex) {
    Accepted { value: ts, diagnostics: _ } =>
      match parse_module(tokens: ts, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
