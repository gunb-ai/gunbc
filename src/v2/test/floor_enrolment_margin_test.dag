module v2.test.floor_enrolment_margin

import v2.workflow.floor_enrolment_margin {
  floor_enrolment_margin_envelope_permille,
  floor_enrolment_margin_budget_ms,
    EnrolmentCostReading, EnrolmentCostMeasured, EnrolmentCostAbsent, EnrolmentNotPlanned,
  EnrolmentMarginStanding,
  EnrolmentWithinMargin, EnrolmentOverMargin, EnrolmentCeilingCensored,
  EnrolmentBoundWithoutCeiling, EnrolmentNotMeasured,
  EnrolmentOutsideThisRunsExecution, EnrolmentExpensivenessDeclared, EnrolmentRosterGroundStale,
  EnrolmentExpensivenessNotDeclared, EnrolmentExpensivenessIsDeclared,
  EnrolmentExpensivenessGround, EnrolmentExpensivenessRoster, EnrolmentExpensivenessLongHome,
  enrolment_expensiveness_declaration,
  EnrolmentPairingHole, EnrolmentPairingHoleNone, EnrolmentPairingHoleDeclared,
  EnrolmentPairingHoleOutsideExecution, enrolment_unpaired_pairing_hole,
  enrolment_margin_standing_name,
  enrolment_margin_standing,
  enrolment_margin_standing_blocks,
  enrolment_margin_blocking_cause,
  EnrolmentMarginBlocker, EnrolmentMarginRow,
  enrolment_margin_blockers,
}
import v2.workflow.required_floor { required_floor_per_subject_cpu_line_ms }
import gunbc.floor_cost_distribution {
  ClaimCostReading, ObservedCpuReading, RightCensoredCpuReading, CpuLowerBoundWithoutCeiling,
  implied_clean_run_budget,
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.integer { Int }
import std.measure { Millisecond, millisecond, millisecond_count, EvalStepCount, eval_step_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

// Every fixture below is authored in this source; the module reaches nothing outside the
// substrate inputs.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE EXECUTING EVIDENCE FOR THE ENROLMENT MARGIN GATE. These run the .dag fold itself, one
// discriminating arm each, so the model's rung is established by execution rather than by the host
// citing it (DESIGN section 4b(1): a type name, a diagnostic variant or a plan establishes
// nothing). The host mirror in `v1_compiler.cli_run` realizes these same functions.
//
// THESE WITNESSES ARE THEMSELVES A SPECIMEN OF WHAT THE GATE GUARDS: they are new identities under
// the `v2.test.` gate prefix, so the PR that lands them must show them measured and inside the
// margin. A gate whose own witnesses could not clear it would be self-refuting.

// THE STEP COUNT THESE FIXTURES CARRY IS INCIDENTAL AND IS DECLARED AS SUCH (gunbc#11366 Phase 1).
// Every witness in this file exercises the CPU half -- the margin, the ceiling, the censoring
// discriminator -- so the count is present because the arm requires one and not because any
// assertion here reads it. When Phase 2 denominates this gate in eval steps these fixtures gain a
// step parameter and the value stops being incidental; saying so now is what keeps a later reader
// from mistaking an arbitrary figure for a measured one.
fn observed(cpu_ms: Int) -> EnrolmentCostReading {
  EnrolmentCostMeasured {
    reading: ObservedCpuReading {
      cpu_ms: millisecond(count: cpu_ms),
      eval_steps: fixture_incidental_steps()
    }
  }
}

fn fixture_incidental_steps() -> EvalStepCount {
  eval_step_count(count: 1000)
}

fn censored(lower_bound_ms: Int, ceiling_ms: Int) -> EnrolmentCostReading {
  EnrolmentCostMeasured {
    reading: RightCensoredCpuReading {
      cpu_lower_bound_ms: millisecond(count: lower_bound_ms),
      censoring_ceiling_ms: millisecond(count: ceiling_ms),
      eval_steps_before_censor: fixture_incidental_steps(),
    }
  }
}

fn bound_without_ceiling(lower_bound_ms: Int) -> EnrolmentCostReading {
  EnrolmentCostMeasured {
    reading: CpuLowerBoundWithoutCeiling {
      cpu_lower_bound_ms: millisecond(count: lower_bound_ms),
      eval_steps_before_censor: fixture_incidental_steps(),
    }
  }
}

fn standing_of(reading: EnrolmentCostReading) -> EnrolmentMarginStanding {
  enrolment_margin_standing(
    reading: reading,
    budget_ms: floor_enrolment_margin_budget_ms(),
    per_subject_line_ms: required_floor_per_subject_cpu_line_ms(),
    declaration: EnrolmentExpensivenessNotDeclared,
  )
}

fn standing_declared(
  reading: EnrolmentCostReading,
  identity: String,
  ground: EnrolmentExpensivenessGround,
) -> EnrolmentMarginStanding {
  enrolment_margin_standing(
    reading: reading,
    budget_ms: floor_enrolment_margin_budget_ms(),
    per_subject_line_ms: required_floor_per_subject_cpu_line_ms(),
    declaration: EnrolmentExpensivenessIsDeclared {
      witness_identity: identity,
      ground: ground,
    },
  )
}

fn standing_kind(s: EnrolmentMarginStanding) -> String {
  match s {
    EnrolmentWithinMargin { exact_cpu_ms: _, budget_ms: _ } => "within-margin"
    EnrolmentOverMargin { exact_cpu_ms: _, budget_ms: _ } => "over-margin"
    EnrolmentCeilingCensored { cpu_lower_bound_ms: _, censoring_ceiling_ms: _ } => "ceiling-censored"
    EnrolmentBoundWithoutCeiling { cpu_lower_bound_ms: _ } => "bound-without-ceiling"
    EnrolmentNotMeasured { witness_identity: _, cause: _ } => "not-measured"
    EnrolmentOutsideThisRunsExecution { witness_identity: _, disposition: _ } => "outside-this-run"
    EnrolmentExpensivenessDeclared { witness_identity: _, ground: _, reading: _ } => "expensiveness-declared"
    EnrolmentRosterGroundStale { witness_identity: _, observed_cpu_ms: _, line_ms: _ } => "roster-ground-stale"
  }
}

// THE MARGIN EXISTS AT ALL, WHICH IS THE ONE CHECK THAT CANNOT BE SATISFIED BY A DECORATION.
//
// If the envelope permille were ever set to 1000 (no inflation), `implied_clean_run_budget` returns
// the ceiling unchanged and every arm below still type-checks while the gate silently becomes the
// ceiling it was built to sit inside -- permanently green by construction against the population it
// exists for, which DESIGN section 4b calls worse than absent because it would still be cited as
// coverage. This witness is the guard: the budget must be STRICTLY BELOW the ceiling.
test fn the_enrolment_budget_is_strictly_below_the_ceiling() -> Bool {
  millisecond_count(m: floor_enrolment_margin_budget_ms())
    < millisecond_count(m: required_floor_per_subject_cpu_line_ms())
}

// THE BUDGET IS THE DERIVATION'S ANSWER AND NOT A LITERAL ANYONE WROTE. 302 appears in no
// declaration: it is 500ms through the p90 envelope of 1653 permille, measured by
// `tools.floor_cost_distribution_instrument` `floor_cost_envelope_report` over TWELVE green main
// runs across THREE hosts on 398 identities at identical eval_steps. The sample size is stated
// here as it is at every other site that names the percentile.
test fn the_enrolment_budget_is_the_derived_p90_clean_run_figure() -> Bool {
  millisecond_count(m: floor_enrolment_margin_budget_ms()) == 302
    && millisecond_count(
         m: implied_clean_run_budget(
              ceiling_ms: required_floor_per_subject_cpu_line_ms(),
              inflation_permille: floor_enrolment_margin_envelope_permille(),
            )
       ) == 302
}

// THE DISCRIMINATING RED, AND IT IS THE WHOLE POINT OF THE LANE.
//
// 450ms is UNDER the 500ms CPU ceiling, so the floor admits this row today: it completes, it
// reaches a verdict, nothing refuses it. It is also a row that the measured runner envelope says
// will cross the ceiling on an unlucky host -- which is the cliff the incidents landed on, every
// one of the fifteen interrupts sitting between 501ms and 521ms against that 500ms line. This
// witness goes RED if the gate is deleted, if its budget is widened back to the ceiling, or if the
// comparison is written the wrong way round. No other witness in this module discriminates that.
test fn a_row_under_the_ceiling_but_over_the_margin_is_refused_at_enrolment() -> Bool {
  let reading = observed(cpu_ms: 450)
  millisecond_count(m: millisecond(count: 450)) < millisecond_count(m: required_floor_per_subject_cpu_line_ms())
    && standing_kind(s: standing_of(reading: reading)) == "over-margin"
    && enrolment_margin_standing_blocks(standing: standing_of(reading: reading))
}

// THE POSITIVE CONTROL. An ordinary witness -- the measured per-identity median is ~1ms -- is
// admitted, and the gate reports it as measured and inside the margin rather than merely not
// blocking. Without this arm the module could pass by refusing everything.
test fn an_ordinary_row_well_under_the_margin_is_admitted() -> Bool {
  let s = standing_of(reading: observed(cpu_ms: 1))
  standing_kind(s: s) == "within-margin"
    && !enrolment_margin_standing_blocks(standing: s)
    && enrolment_margin_blocking_cause(standing: s) == ""
}

// THE BOUNDARY IS AT THE BUDGET AND IS INCLUSIVE, stated by execution rather than left to a reader
// of the comparison operator. A row exactly AT 302ms is admitted; one millisecond above it is not.
test fn the_margin_boundary_admits_the_budget_and_refuses_one_above_it() -> Bool {
  standing_kind(s: standing_of(reading: observed(cpu_ms: 302))) == "within-margin"
    && standing_kind(s: standing_of(reading: observed(cpu_ms: 303))) == "over-margin"
}

// NOT-MEASURED IS ITS OWN STANDING WITH ITS OWN CAUSE. This is precision two of the ruling: a
// witness nobody timed and a witness timed at 840ms are different states with different remedies.
// gunbc#10946 is the live specimen -- its v2-native job was cancelled, so its identities carried no
// measurement at all.
test fn an_unmeasured_identity_is_refused_and_not_confused_with_a_slow_one() -> Bool {
  let absent = standing_of(
    reading: EnrolmentCostAbsent {
      witness_identity: "v2.test.parse.where_refinement_clause_parse.where_refinement_clause_parses_and_is_carried_holds",
      cause: "lane_cancelled_before_measurement",
    }
  )
  let slow = standing_of(reading: observed(cpu_ms: 840))
  standing_kind(s: absent) == "not-measured"
    && enrolment_margin_standing_blocks(standing: absent)
    && enrolment_margin_standing_blocks(standing: slow)
    && enrolment_margin_blocking_cause(standing: absent) != enrolment_margin_blocking_cause(standing: slow)
}

// ABSENCE IS NOT A ZERO, WHICH IS THE ARM THAT WOULD MAKE THE GATE FAIL OPEN. A zero-cost default
// for an unmeasured identity would classify it "within-margin" and admit it silently -- the
// absorbing fallback in its most ordinary costume. The two must not agree.
test fn an_unmeasured_identity_does_not_classify_as_a_zero_cost_one() -> Bool {
  standing_kind(
    s: standing_of(
         reading: EnrolmentCostAbsent { witness_identity: "fixture.unmeasured", cause: "no_claim_cost_row" }
       )
  ) != standing_kind(s: standing_of(reading: observed(cpu_ms: 0)))
}

// A CENSORED ROW BLOCKS ON ITS OWN ARM, AND ITS BOUND IS NEVER REPORTED AS A COST. Its cause is
// distinct from the measured-over cause because the remedies differ: an exact 450ms row is told to
// reduce its cost, while a censored row has no upper bound at all and may be arbitrarily worse.
test fn a_censored_row_blocks_under_its_own_cause() -> Bool {
  let s = standing_of(reading: censored(lower_bound_ms: 514, ceiling_ms: 500))
  standing_kind(s: s) == "ceiling-censored"
    && enrolment_margin_standing_blocks(standing: s)
    && enrolment_margin_blocking_cause(standing: s) == "enrolment_censored_at_ceiling"
    && enrolment_margin_blocking_cause(standing: s) != enrolment_margin_blocking_cause(standing: standing_of(reading: observed(cpu_ms: 450)))
}

// A BOUND WITH NO CEILING BLOCKS UNDER ITS OWN CAUSE, AND IS NEITHER OF THE TWO ARMS IT IS
// TEMPTING TO COLLAPSE IT INTO. This is the arm review 65264 found had no producer on the
// acceptance path, so it is asserted here by EXECUTION and not by the rendering match alone:
// a `CpuLowerBoundWithoutCeiling` reading is driven through the real classification and must
// come out refusing, with a cause distinct from BOTH `enrolment_not_measured` (there IS a
// reading, so "produce a measurement" is the wrong remedy) and `enrolment_censored_at_ceiling`
// (no CPU ceiling is armed, so there is nothing to report beside the bound).
test fn a_bound_with_no_ceiling_blocks_under_a_cause_distinct_from_both_neighbours() -> Bool {
  let s = standing_of(reading: bound_without_ceiling(lower_bound_ms: 514))
  let cens = enrolment_margin_blocking_cause(standing: standing_of(reading: censored(lower_bound_ms: 514, ceiling_ms: 500)))
  let miss = enrolment_margin_blocking_cause(
    standing: standing_of(reading: EnrolmentCostAbsent { witness_identity: "fixture.unmeasured", cause: "no_claim_cost_row" })
  )
  standing_kind(s: s) == "bound-without-ceiling"
    && enrolment_margin_standing_blocks(standing: s)
    && enrolment_margin_blocking_cause(standing: s) == "enrolment_bound_without_ceiling"
    && enrolment_margin_blocking_cause(standing: s) != cens
    && enrolment_margin_blocking_cause(standing: s) != miss
}

// THE THREE BLOCKING CAUSES ARE THREE DISTINCT STRINGS. A shared cause would offer the rerun that
// discharges none of them, which is the defect `v2.workflow.floor_changed_witness` records for its
// own blocker shape.
test fn the_blocking_causes_are_pairwise_distinct() -> Bool {
  let over = enrolment_margin_blocking_cause(standing: standing_of(reading: observed(cpu_ms: 450)))
  let cens = enrolment_margin_blocking_cause(standing: standing_of(reading: censored(lower_bound_ms: 514, ceiling_ms: 500)))
  let miss = enrolment_margin_blocking_cause(
    standing: standing_of(reading: EnrolmentCostAbsent { witness_identity: "fixture.unmeasured", cause: "no_claim_cost_row" })
  )
  (over != cens) && (cens != miss) && (over != miss)
}

// THE FOLD'S POSITIVE CONTROL: no newly enrolled identities is the ordinary case for the
// overwhelming majority of changes, and it must leave the required context green with no
// projection lines at all.
test fn a_change_that_enrols_nothing_blocks_nothing() -> Bool {
  count(enrolment_margin_blockers(rows: [])) == 0
}

// THE FOLD KEEPS ONLY THE BLOCKING ROWS, IN INPUT ORDER, EACH CARRYING ITS OWN CAUSE. A change
// enrolling one healthy and one over-margin witness blocks on exactly the second.
//
// RENDERED RATHER THAN INDEXED. `blockers[0]` reds this witness on an index error the moment the
// fold returns empty, which is a failure on the WRONG AXIS: it reports a type error where the
// claim is about which rows survive. Folding to a string reds as a plain inequality for every
// wrong population -- empty, longer, reordered, or right-length-wrong-cause.
test fn the_fold_reports_only_blocking_rows_with_their_causes() -> Bool {
  let blockers = enrolment_margin_blockers(rows: [
    EnrolmentMarginRow { identity: "fixture.cheap", standing: standing_of(reading: observed(cpu_ms: 1)) },
    EnrolmentMarginRow { identity: "fixture.over", standing: standing_of(reading: observed(cpu_ms: 450)) },
    EnrolmentMarginRow { identity: "fixture.also_cheap", standing: standing_of(reading: observed(cpu_ms: 2)) },
  ])
  fold(blockers, init: "", f: fn(acc, b) {
    concat(acc, concat(b.identity, concat("=", concat(b.cause, ";"))))
  }) == "fixture.over=enrolment_measured_over_margin;"
}

// AN IDENTITY THE RUNNER WITHHELD IS NOT THIS GATE'S TO REFUSE, and this is the arm review 64022
// required. The changed-witness selector ranges over the whole diff while the declared population
// ranges over the discovery roots, so a wholly-added test file outside those roots is selectable
// and undeclarable. Refusing it here would demand a measurement that no edit to the witness could
// ever produce.
test fn an_identity_the_runner_withheld_is_not_refused_by_this_gate() -> Bool {
  let s = standing_of(
    reading: EnrolmentNotPlanned {
      witness_identity: "outside.roots.some_witness_holds",
      disposition: "declined_changed_witness_outside_discovery",
    }
  )
  standing_kind(s: s) == "outside-this-run"
    && !enrolment_margin_standing_blocks(standing: s)
    && enrolment_margin_standing_name(standing: s) == "outside_this_runs_execution"
}

// THE TWO ABSENCES STAY DISTINCT, which is the whole content of the repair. A planned identity
// that produced no measurement still blocks; a withheld identity does not, because the two have
// different remedies and only one of them is reachable by editing the witness.
test fn a_withheld_identity_and_an_unmeasured_planned_one_are_different_standings() -> Bool {
  let withheld = standing_of(
    reading: EnrolmentNotPlanned {
      witness_identity: "outside.roots.some_witness_holds",
      disposition: "declined_changed_witness_outside_discovery",
    }
  )
  let unmeasured = standing_of(
    reading: EnrolmentCostAbsent {
      witness_identity: "planned.but.untimed_holds",
      cause: "lane_cancelled_before_measurement",
    }
  )
  standing_kind(s: withheld) != standing_kind(s: unmeasured)
    && !enrolment_margin_standing_blocks(standing: withheld)
    && enrolment_margin_standing_blocks(standing: unmeasured)
}

// THE FOLD DOES NOT CARRY A WITHHELD ROW INTO THE BLOCKING POPULATION. Stated over the fold and
// not only over the predicate, because the fold is what the merge gate actually reads.
test fn the_fold_omits_withheld_rows_and_keeps_over_margin_ones() -> Bool {
  let blockers = enrolment_margin_blockers(rows: [
    EnrolmentMarginRow {
      identity: "outside.roots.withheld",
      standing: standing_of(
        reading: EnrolmentNotPlanned {
          witness_identity: "outside.roots.withheld",
          disposition: "declined_changed_witness_outside_discovery",
        }
      )
    },
    EnrolmentMarginRow { identity: "fixture.over", standing: standing_of(reading: observed(cpu_ms: 450)) },
  ])
  fold(blockers, init: "", f: fn(acc, b) {
    concat(acc, concat(b.identity, concat("=", concat(b.cause, ";"))))
  }) == "fixture.over=enrolment_measured_over_margin;"
}

// HALF ONE: DECLARED EXPENSIVENESS IS CONSUMED FROM
// `enrolment_expensiveness_declaration`, NOT FROM THE STRING ROSTER. Long home at 325ms
// does not block here. IT IS NOT AN EXEMPTION.
test fn a_declared_identity_measured_over_the_margin_does_not_block_here() -> Bool {
  let s = standing_declared(
    reading: observed(cpu_ms: 325),
    identity: "fixture.declared_over_margin",
    ground: EnrolmentExpensivenessLongHome,
  )
  standing_kind(s: s) == "expensiveness-declared"
    && !enrolment_margin_standing_blocks(standing: s)
    && enrolment_margin_standing_name(standing: s) == "expensiveness_declared"
}

// POSITIVE CONTROL: the same 325ms reading with NO declaration still refuses over the margin.
// This is what keeps the arm from being an exemption wearing a typed name: undeclared new
// witnesses at the specimen cost remain refused.
test fn an_undeclared_identity_at_325ms_still_refuses_over_the_margin() -> Bool {
  let s = standing_of(reading: observed(cpu_ms: 325))
  standing_kind(s: s) == "over-margin"
    && enrolment_margin_standing_blocks(standing: s)
}

// EXECUTION JOIN STILL COMES FIRST. A withheld identity with a declaration is still this
// gate's deferral, never a declared-expensiveness standing — consulting the declaration
// before the join would rebuild review 64022 one gate over.
test fn a_declared_identity_the_runner_withheld_stays_outside_this_runs_execution() -> Bool {
  let s = standing_declared(
    reading: EnrolmentNotPlanned {
      witness_identity: "outside.roots.declared_holds",
      disposition: "declined_changed_witness_outside_discovery",
    },
    identity: "outside.roots.declared_holds",
    ground: EnrolmentExpensivenessLongHome,
  )
  standing_kind(s: s) == "outside-this-run"
    && !enrolment_margin_standing_blocks(standing: s)
}

// A DECLARED ROW THAT REACHES NO VERDICT IS NON-BLOCKING HERE AND STILL COUNTED ELSEWHERE.
// This gate mirrors ChangedCostDebtVerdictOnly: the CPU figure is reported and decides
// nothing. Wall deadline and semantic red are unaffected because they are not this match.
test fn a_declared_identity_with_no_measurement_does_not_block_at_enrolment() -> Bool {
  let s = standing_declared(
    reading: EnrolmentCostAbsent {
      witness_identity: "fixture.declared_unmeasured",
      cause: "lane_cancelled_before_measurement",
    },
    identity: "fixture.declared_unmeasured",
    ground: EnrolmentExpensivenessLongHome,
  )
  standing_kind(s: s) == "expensiveness-declared"
    && !enrolment_margin_standing_blocks(standing: s)
}

// THE CENSORED READING UNDER A DECLARATION, SAME POLARITY. Composition with changed-witness
// is the host control `a_declared_identity_censored_at_the_cpu_ceiling_still_stops_the_run`.
test fn a_declared_identity_censored_at_the_ceiling_does_not_block_at_enrolment() -> Bool {
  let s = standing_declared(
    reading: censored(lower_bound_ms: 500, ceiling_ms: 500),
    identity: "fixture.declared_cpu_censored",
    ground: EnrolmentExpensivenessLongHome,
  )
  standing_kind(s: s) == "expensiveness-declared"
    && !enrolment_margin_standing_blocks(standing: s)
}

// STRING-ROSTER MEMBERSHIP DOES NOT DECLARE AT ENROLMENT. The ungated identity-string
// chunks cannot mint EnrolmentExpensivenessIsDeclared (review 65637 / review 65665).
test fn a_string_roster_hold_does_not_declare_at_enrolment() -> Bool {
  match enrolment_expensiveness_declaration(
    witness_identity: "fixture.tripwire_325",
    typed_admission_holds: false,
    long_home_holds: false,
  ) {
    EnrolmentExpensivenessNotDeclared => true
    EnrolmentExpensivenessIsDeclared { witness_identity: _, ground: _ } => false
  }
}

test fn a_long_home_declares_at_enrolment_even_when_a_string_roster_line_exists() -> Bool {
  match enrolment_expensiveness_declaration(
    witness_identity: "fixture.long_home_and_string",
    typed_admission_holds: false,
    long_home_holds: true,
  ) {
    EnrolmentExpensivenessNotDeclared => false
    EnrolmentExpensivenessIsDeclared { witness_identity: _, ground: g } =>
      match g {
        EnrolmentExpensivenessLongHome => true
        EnrolmentExpensivenessRoster => false
      }
  }
}

test fn typed_admission_is_the_only_roster_ground_at_enrolment() -> Bool {
  match enrolment_expensiveness_declaration(
    witness_identity: "fixture.typed_501",
    typed_admission_holds: true,
    long_home_holds: false,
  ) {
    EnrolmentExpensivenessNotDeclared => false
    EnrolmentExpensivenessIsDeclared { witness_identity: _, ground: g } =>
      match g {
        EnrolmentExpensivenessRoster => true
        EnrolmentExpensivenessLongHome => false
      }
  }
}

test fn the_pairing_hole_is_exhaustive_over_standing() -> Bool {
  match enrolment_unpaired_pairing_hole(
    standing: standing_of(reading: observed(cpu_ms: 1))
  ) {
    EnrolmentPairingHoleNone =>
      match enrolment_unpaired_pairing_hole(
        standing: standing_declared(
          reading: observed(cpu_ms: 325),
          identity: "fixture.declared",
          ground: EnrolmentExpensivenessLongHome,
        )
      ) {
        EnrolmentPairingHoleDeclared =>
          match enrolment_unpaired_pairing_hole(
            standing: standing_of(
              reading: EnrolmentNotPlanned {
                witness_identity: "outside.roots.withheld",
                disposition: "declined_changed_witness_outside_discovery",
              }
            )
          ) {
            EnrolmentPairingHoleOutsideExecution => true
            EnrolmentPairingHoleNone => false
            EnrolmentPairingHoleDeclared => false
          }
        EnrolmentPairingHoleNone => false
        EnrolmentPairingHoleOutsideExecution => false
      }
    EnrolmentPairingHoleDeclared => false
    EnrolmentPairingHoleOutsideExecution => false
  }
}

// THE ROSTER GROUND IS LIVE-CONDITIONED (gunbc#11622 review 68363). A typed admission carries an
// identity and a reason, never a reading, so every row below is decided by the reading THIS run
// supplies, against `required_floor_per_subject_cpu_line_ms`. These rows re-home the behaviours
// the retired stored-reading constructor used to establish onto the live arms that now own them.

fn roster_standing(reading: EnrolmentCostReading) -> EnrolmentMarginStanding {
  standing_declared(
    reading: reading,
    identity: "fixture.roster",
    ground: EnrolmentExpensivenessRoster,
  )
}

// Re-homed from the constructor's "above the ceiling is admitted": a live reading strictly over
// the line keeps the admission.
test fn a_roster_admission_over_the_line_stays_declared() -> Bool {
  let s = roster_standing(reading: observed(cpu_ms: 501))
  standing_kind(s: s) == "expensiveness-declared"
    && !enrolment_margin_standing_blocks(standing: s)
}

// Re-homed from the gunbc#10994 325ms tripwire: a margin crossing under the line cannot hold a
// Roster admission. It is stale, blocks, and says the row must delete.
test fn a_roster_admission_at_325ms_is_stale_and_blocks() -> Bool {
  let s = roster_standing(reading: observed(cpu_ms: 325))
  standing_kind(s: s) == "roster-ground-stale"
    && enrolment_margin_standing_blocks(standing: s)
    && enrolment_margin_blocking_cause(standing: s) == "enrolment_roster_ground_stale"
}

// The boundary: the line itself is not over the line.
test fn a_roster_admission_exactly_at_the_line_is_stale() -> Bool {
  standing_kind(s: roster_standing(reading: observed(cpu_ms: 500))) == "roster-ground-stale"
    && standing_kind(s: roster_standing(reading: observed(cpu_ms: 501))) == "expensiveness-declared"
}

// THE HOLE THIS CHANGE CLOSES. A planned Roster identity with no cost row is NotMeasured, exactly
// as an undeclared one is -- the declaration buys no exemption from being measured. LongHome is
// the control: the same absent reading is still only reported there (the declared drop
// `long_home_enrolment_margin_observed_only`), so this row is the Roster arm and not a global
// change.
test fn a_roster_admission_with_no_reading_is_not_measured() -> Bool {
  let absent = EnrolmentCostAbsent {
    witness_identity: "fixture.roster",
    cause: "no_claim_cost_row_for_a_planned_identity",
  }
  standing_kind(s: roster_standing(reading: absent)) == "not-measured"
    && enrolment_margin_standing_blocks(standing: roster_standing(reading: absent))
    && standing_kind(s: standing_declared(
         reading: absent,
         identity: "fixture.long_home",
         ground: EnrolmentExpensivenessLongHome,
       )) == "expensiveness-declared"
}

// Re-homed from "a bound with no ceiling mints nothing" and "a censored row at the ceiling is
// admitted": a lower bound establishes expensiveness only if the bound itself clears the line.
test fn a_roster_admission_with_a_bound_over_the_line_stays_declared() -> Bool {
  standing_kind(s: roster_standing(reading: bound_without_ceiling(lower_bound_ms: 514))) == "expensiveness-declared"
    && standing_kind(s: roster_standing(reading: censored(lower_bound_ms: 514, ceiling_ms: 500))) == "expensiveness-declared"
}

// Re-homed from "a 1ms censored reading against the 500ms ceiling is refused": a bound at or under
// the line proves nothing, so it blocks under the same arm an undeclared identity would get.
test fn a_roster_admission_with_a_bound_under_the_line_blocks_on_its_own_arm() -> Bool {
  let b = roster_standing(reading: bound_without_ceiling(lower_bound_ms: 1))
  let c = roster_standing(reading: censored(lower_bound_ms: 1, ceiling_ms: 1))
  standing_kind(s: b) == "bound-without-ceiling"
    && enrolment_margin_standing_blocks(standing: b)
    && standing_kind(s: c) == "ceiling-censored"
    && enrolment_margin_standing_blocks(standing: c)
}
