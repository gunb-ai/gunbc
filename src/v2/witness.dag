// Witness test extraction from coercion data tables.
//
// Reads TypeCheckpoint.default_expr and InhabitantDecl.identity_expr
// to verify that every kernel type has a canonical witness value.
// Uses the existing coercion API (lookup_checkpoint, lookup_inhabitant)
// — no new lookup boundaries.
//
// Authority chain:
//   std/coercion.dag               -> shared schema
//   extdeps/languages/*/types.dag  -> per-language data (witnesses)
//   v2/coercion.dag                -> lookup dispatch
//   THIS FILE                      -> witness test extraction
//
// Consumers:
//   compiler_tests_rust.dag  -- renders witness tests

module v2.compiler.witness

import v2.compiler.artifact { RenderTarget, Rust, Python, Go }
import v2.compiler.coercion { target_checkpoints, target_inhabitants, target_label }
import std.coercion { TypeCheckpoint, InhabitantDecl }

// =========================================================================
// Witness assertion types (compiler-internal)
//
// Parallel to CoercionAssertion / CoercionTestEntry in coercion.dag.
// =========================================================================

type WitnessAssertion
  = PrimitiveWitnessAssertion { target: RenderTarget, dag_name: String, expected_expr: String }
  | ContainerWitnessAssertion { target: RenderTarget, algebra: String, expected_expr: String }

type WitnessTestCase {
  test_name: String
  assertions: List<WitnessAssertion>
}

// =========================================================================
// Witness test extraction
//
// Reads coercion data tables and produces test cases. Each TypeCheckpoint
// with a default_expr generates a primitive witness assertion. Each
// InhabitantDecl with an identity_expr generates a container witness
// assertion. New data declarations → new witness tests automatically.
//
// Assertions are rendered against the existing coercion lookup functions
// (lookup_checkpoint, lookup_inhabitant) — no new lookup boundary.
// =========================================================================

fn primitive_witness_tests(target: RenderTarget) -> List<WitnessTestCase> {
  let label = target_label(target: target)
  let cps = target_checkpoints(target: target)
  let assertions = cps |> flat_map(cp =>
    match cp.default_expr {
      Some { value: expr } =>
        [PrimitiveWitnessAssertion { target: target, dag_name: cp.dag_name, expected_expr: expr }]
      None => []
    })
  if assertions |> count == 0 { [] }
  else {
    [WitnessTestCase {
      test_name: concat("witness_", label, "_canonical_primitives"),
      assertions: assertions
    }]
  }
}

fn container_witness_tests(target: RenderTarget) -> List<WitnessTestCase> {
  let label = target_label(target: target)
  let inhs = target_inhabitants(target: target)
  let assertions = inhs |> flat_map(inh =>
    match inh.identity_expr {
      Some { value: expr } =>
        [ContainerWitnessAssertion { target: target, algebra: inh.algebra, expected_expr: expr }]
      None => []
    })
  if assertions |> count == 0 { [] }
  else {
    [WitnessTestCase {
      test_name: concat("witness_", label, "_container_identities"),
      assertions: assertions
    }]
  }
}

fn extract_witness_tests() -> List<WitnessTestCase> {
  concat(
    primitive_witness_tests(target: Rust),
    primitive_witness_tests(target: Python),
    primitive_witness_tests(target: Go),
    container_witness_tests(target: Rust),
    container_witness_tests(target: Python),
    container_witness_tests(target: Go))
}
