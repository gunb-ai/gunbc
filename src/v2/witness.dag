// Witness generation and emission algebra enumeration.
//
// Generates canonical witness values for each type from coercion data
// tables (TypeCheckpoint.default_expr, InhabitantDecl.identity_expr).
// Enumerates the emission algebra as (ExprCategory x TypeForm x Cardinality)
// triples for structural form coverage testing.
//
// Authority chain:
//   std/coercion.dag               -> shared schema
//   extdeps/languages/*/types.dag  -> per-language data (witnesses)
//   v2/coercion.dag                -> lookup dispatch
//   THIS FILE                      -> witness extraction + algebra enumeration
//
// Consumers:
//   compiler_tests_rust.dag  -- renders witness + algebra tests

module v2.compiler.witness

import v2.compiler.artifact { RenderTarget, Rust, Python, Go }
import v2.compiler.coercion { target_checkpoints, target_inhabitants, target_label }
import v2.compiler.emit { ExprCategory, ExprCatLeaf, ExprCatCompound, ExprCatControlFlow, ExprCatBinding }
import v2.std.core { Cardinality, Required, CardOptional }
import std.coercion { TypeCheckpoint, InhabitantDecl }
import std.types { TypeForm, FormPrimitive, FormProduct, FormCoproduct, FormCollection, FormCallable }

// =========================================================================
// Witness assertion types (compiler-internal)
//
// Parallel to CoercionAssertion / CoercionTestEntry in coercion.dag.
// =========================================================================

type WitnessAssertion
  = PrimitiveWitnessAssertion { target: RenderTarget, dag_name: String, expected_expr: String }
  | ContainerWitnessAssertion { target: RenderTarget, algebra: String, expected_expr: String }

type WitnessTestCase {
  test_name: String
  assertions: List<WitnessAssertion>
}

// =========================================================================
// Witness lookup functions
//
// Thin wrappers around coercion data. canonical_witness_expr reads
// TypeCheckpoint.default_expr; container_identity_expr reads
// InhabitantDecl.identity_expr. Both are compiled to stage0 Rust
// and tested by the generated witness tests.
// =========================================================================

fn canonical_witness_expr(target: RenderTarget, dag_name: String) -> String? {
  let cps = target_checkpoints(target: target)
  match cps |> filter(cp => cp.dag_name == dag_name) |> first {
    Some { value: cp } => cp.default_expr
    None => none
  }
}

fn container_identity_expr(target: RenderTarget, algebra: String) -> String? {
  let inhs = target_inhabitants(target: target)
  match inhs |> filter(inh => inh.algebra == algebra) |> first {
    Some { value: inh } => inh.identity_expr
    None => none
  }
}

// =========================================================================
// Witness test extraction
//
// Reads coercion data tables and produces test cases. Each TypeCheckpoint
// with a default_expr generates a primitive witness assertion. Each
// InhabitantDecl with an identity_expr generates a container witness
// assertion. New data declarations → new witness tests automatically.
// =========================================================================

fn primitive_witness_tests(target: RenderTarget) -> List<WitnessTestCase> {
  let label = target_label(target: target)
  let cps = target_checkpoints(target: target)
  let assertions = cps |> flat_map(cp =>
    match cp.default_expr {
      Some { value: expr } =>
        [PrimitiveWitnessAssertion { target: target, dag_name: cp.dag_name, expected_expr: expr }]
      None => []
    })
  if assertions |> count == 0 { [] }
  else {
    [WitnessTestCase {
      test_name: concat("witness_", label, "_canonical_primitives"),
      assertions: assertions
    }]
  }
}

fn container_witness_tests(target: RenderTarget) -> List<WitnessTestCase> {
  let label = target_label(target: target)
  let inhs = target_inhabitants(target: target)
  let assertions = inhs |> flat_map(inh =>
    match inh.identity_expr {
      Some { value: expr } =>
        [ContainerWitnessAssertion { target: target, algebra: inh.algebra, expected_expr: expr }]
      None => []
    })
  if assertions |> count == 0 { [] }
  else {
    [WitnessTestCase {
      test_name: concat("witness_", label, "_container_identities"),
      assertions: assertions
    }]
  }
}

fn extract_witness_tests() -> List<WitnessTestCase> {
  concat(
    primitive_witness_tests(target: Rust),
    primitive_witness_tests(target: Python),
    primitive_witness_tests(target: Go),
    container_witness_tests(target: Rust),
    container_witness_tests(target: Python),
    container_witness_tests(target: Go))
}

// =========================================================================
// Emission algebra enumeration (KF-3b)
//
// The emission algebra is (ExprCategory x TypeForm x Cardinality).
// Uses the actual structural types from 00_core.dag (Cardinality),
// 05_emit.dag (ExprCategory), and std/types.dag (TypeForm).
//
// Phase 1: all triples marked valid. Phase 2 will add structural pruning
// (e.g., ExprListLit only produces FormCollection).
// =========================================================================

type EmissionAlgebraElement {
  expr_category: ExprCategory
  type_form: TypeForm
  cardinality: Cardinality
  is_valid: Bool
}

data all_expr_categories: List<ExprCategory> = [
  ExprCatLeaf, ExprCatCompound, ExprCatControlFlow, ExprCatBinding
]

data all_type_forms: List<TypeForm> = [
  FormPrimitive, FormProduct, FormCoproduct, FormCollection, FormCallable
]

data all_cardinalities: List<Cardinality> = [Required, CardOptional]

fn enumerate_emission_algebra() -> List<EmissionAlgebraElement> {
  all_expr_categories |> flat_map(cat =>
    all_type_forms |> flat_map(form =>
      all_cardinalities |> map(card =>
        EmissionAlgebraElement {
          expr_category: cat,
          type_form: form,
          cardinality: card,
          is_valid: true
        })))
}
