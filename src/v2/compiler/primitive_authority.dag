module v2.compiler.primitive_authority

import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.node { Node, Symbol, symbol_lexeme }
import v2.std.data_initializer_identity { projection_named_child_optional }
import v2.extdeps.languages.dag { dag_string_literal_value_optional }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string, qualified_name_to_dotted_string }

// WHERE A KERNEL PRIMITIVE IS DECLARED. A std.primitives PrimitiveContract row carries `name: "<primitive>"`, and THAT
// field is the primitive's identity. The row is FOUND by the declaration path std.primitives.<name>_contract (the
// authority's declaration naming), then JOINED on its own name field: a call head binds only to a row whose declared name
// equals the head (primitive_authority_row_names_head). A row whose declaration name and name field disagree is refused
// by v2.compiler.resolve with resolve_reason_primitive_row_name_disagrees, never bound by the spelling alone.
// v2.compiler.infer refuses a call head whose admitted declaration is such a row (primitive_authority_row_is_contract): the primitive's TYPE SIGNATURE
// has no .dag authority yet (it lives in the seed's builtin_function_registry) and an untyped acceptance would be
// silent wrongness.
fn primitive_authority_path(head: Symbol) -> QualifiedName {
  qualified_name_from_dotted_string(dotted: concat("std.primitives.", symbol_lexeme(sym: head), "_contract"))
}

// The contract row's OWN `name` field. The lowered row is a nullary arrow whose body edge is the initializer record;
// that record's own `name` field is read from it, with no deeper search. A nested record carrying a `name` (a decoy
// under another field) is never reached; a missing, non-literal or unreadable own name is Absent.
fn primitive_authority_row_name_optional(row: Node) -> Optional<String> {
  match projection_named_child_optional(node: row, label: "arrow_body_edge") {
    Absent => optional_absent()
    Present { value: initializer } =>
      match projection_named_child_optional(node: initializer, label: "name") {
        Absent => optional_absent()
        Present { value: v } => dag_string_literal_value_optional(node: v)
      }
  }
}

// A declaration at `path` is a primitive contract row when its OWN declared name N makes the path exactly
// std.primitives.N_contract: classified by the admitted declaration's identity join, never by the shape of the path
// alone, so an ordinary fn at a path that merely looks like one carries no such name and is not a primitive.
fn primitive_authority_row_is_contract(row: Node, path: QualifiedName) -> Bool {
  match primitive_authority_row_name_optional(row: row) {
    Absent => false
    Present { value: declared } => qualified_name_to_dotted_string(qn: path) == concat("std.primitives.", declared, "_contract")
  }
}

fn primitive_authority_row_names_head(row: Node, head: Symbol) -> Bool {
  match primitive_authority_row_name_optional(row: row) {
    Present { value: declared } => declared == symbol_lexeme(sym: head)
    Absent => false
  }
}
