module v2.compiler.primitive_authority

import v2.std.node { Symbol, symbol_lexeme }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string, qualified_name_to_dotted_string }

// THE ONE CARRIER OF "WHERE A KERNEL PRIMITIVE IS DECLARED": std.primitives PrimitiveContract rows are named
// <name>_contract (dag/std/primitives.dag), so the identity of the free kernel call `reverse` is
// std.primitives.reverse_contract. v2.compiler.resolve binds a call head no frame, import or indexed
// declaration claims to that identity (a lookup AFTER every ordinary declaration, so it never shadows one);
// v2.compiler.infer refuses a call head that resolved here, because the primitive's TYPE SIGNATURE has no .dag
// authority yet (it lives in the seed's builtin_function_registry) and an untyped acceptance would be silent
// wrongness.
data primitive_authority_module: String = "std.primitives"
data primitive_authority_row_suffix: String = "_contract"

fn primitive_authority_path(head: Symbol) -> QualifiedName {
  qualified_name_from_dotted_string(dotted: concat("std.primitives.", symbol_lexeme(sym: head), "_contract"))
}

fn primitive_authority_path_is(path: QualifiedName) -> Bool {
  let dotted = qualified_name_to_dotted_string(qn: path)
  dotted.starts_with(prefix: "std.primitives.") && dotted.ends_with(suffix: "_contract")
}
