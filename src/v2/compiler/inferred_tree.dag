module v2.compiler.inferred_tree


// InferredFacts/InferredTree/InferredFactsEntry are the SHAPE infer's pass
// produces and consumers hold -- not the pass itself. They lived inside
// v2.compiler.infer (the 04_infer.dag fold implementation), which imports
// v2.compiler.resolve for its own logic; any consumer that wanted only these
// record shapes (to hand-construct a fixture InferredTree, never calling an
// infer-stage fold) inherited that resolve coupling for free, inflating its
// import closure past what it actually uses -- exactly the module-grain
// type-vs-fold conflation witness_cost_locality_precision_frontier names as
// a known LayerDepth false-positive source (src/v2/lens/witness_cost_locality.dag).
// Split out per the v2.compiler.normalized_tree precedent (03_resolve.dag's
// pass is v2.compiler.resolve; ResolvedTree's own shape carrier is separate).
// v2.compiler.infer imports these back; this is a relocation of one
// authority, never a second declaration of it (DESIGN.md §3).

type NodeGrounding
  = DerivedGrounding { grounding: v2.std.constraints.CanonicalGrounding }
  | GroundingNotDerived { node: v2.std.node.Node }

type InferredFacts {
  grounding: NodeGrounding
  descent: v2.std.witness.Witness<v2.std.cardinality.TerminationProof>
}

type InferredTree {
  root: v2.std.node.Node
  facts: std.algebra.PartialFunction<v2.std.node.Node, InferredFacts>
}

type InferredFactsEntry {
  node: v2.std.node.Node
  facts: v2.compiler.inferred_tree.InferredFacts
}
