import v2.std.text { String }

type ProgramAssemblyFoldState
  = ProgramAssemblyFoldOk {
      roots: FreeMonoid<NormalizedTree>,
      index: SourceRootIndex
    }
  | ProgramAssemblyFoldFailed {
      diagnostics: NonEmptyDiagnostics
    }

// A normalized root together with the path of the read that produced it. The assembly fold
// iterates the reads, so it is the one place the path-to-tree association exists by
// construction; a consumer that needs it reads this pair, never a positional zip of two lists
// across this module's boundary (DESIGN 5: completeness is an identity join, not a count
// equality). The tree-only fold state above is a projection of the located one. A plain
// record, not sole_constructor: the pair carries no invariant beyond its fields. G0 used to
// refuse a modifier between the type name and its field block (gunbc#11461 srv2 pair,
// fold11461g; dag_grammar_type_decl_expr now admits the same two modifiers v1 drops).
type LocatedNormalizedTree {
  path: String,
  tree: NormalizedTree
}

// THE TWO PROVENANCE FIELDS ARE WHY A DIAGNOSTIC CAN NAME A FILE, and they are one fact in two
// halves. `alloc` is the occurrence-id high-water mark reached so far, so the NEXT read is parsed
// seeded from it rather than restarting at zero -- which is what makes an occurrence id unique
// across the whole ingest instead of unique only within one file. `spans` is those ids' origins
// merged into ONE index; because the ids are ingest-unique the merge cannot collide, and because
// tokenize stamps each locus with the read's own compilation unit, every entry already names its
// file. Together they turn "which file is this occurrence from" into a LOOKUP.
//
// THE ORDER OF THOSE TWO SENTENCES IS THE WHOLE DESIGN. Merging per-file indices WITHOUT seeding
// would be the silent-wrongness arm: two files both mint occurrence #3, one entry overwrites or
// shadows the other, and a node from file B resolves to a byte range in file A -- a confident,
// plausible, wrong answer, which DESIGN section 5 forbids more strongly than no answer at all.
// `std.occurrence_identity` `occurrence_identity_scope_law` already said so ("a production source
// graph threads one allocator across every parsed source"; module-local reset is a FORBIDDEN
// identity input); the fold simply stopped obeying it. Seeding is not an optimization here, it is
// the precondition that makes the merge meaningful.
type ProgramAssemblyLocatedFoldState
  = ProgramAssemblyLocatedFoldOk {
      located: FreeMonoid<LocatedNormalizedTree>,
      index: SourceRootIndex,
      alloc: OccurrenceIdAllocator,
      spans: SpanIndex,
      advisories: Diagnostics
    }
  | ProgramAssemblyLocatedFoldFailed {
      diagnostics: NonEmptyDiagnostics,
      spans: SpanIndex
    }

fn program_assembly_empty_roots() -> FreeMonoid<NormalizedTree> {
  Empty
}

fn program_assembly_empty_located_roots() -> FreeMonoid<LocatedNormalizedTree> {
  Empty
}

fn program_assembly_fold_state_from_located(
  state: ProgramAssemblyLocatedFoldState
) -> ProgramAssemblyFoldState {
  match state {
    ProgramAssemblyLocatedFoldFailed { diagnostics: d, spans: _ } =>
      ProgramAssemblyFoldFailed { diagnostics: d }
    ProgramAssemblyLocatedFoldOk { located: located, index: idx, alloc: _, spans: _, advisories: _ } =>
      ProgramAssemblyFoldOk {
        roots: list_map(xs: located, f: fn(item) { item.tree }),
        index: idx
      }
  }
}

// THE PER-FILE FRONT END, ONE DECLARATION PER PHASE. The composition below is unchanged in
// meaning: each phase takes the PREVIOUS PHASE'S OUTCOME and binds it, so diagnostic merging and
// refusal propagation stay inside `.dag` and a caller that enters the phases separately gets
// byte-identical behaviour to calling the composition. The reason the phases are separate
// declarations at all is that a phase span is a REALIZATION fact -- `.dag` is pure and cannot read
// a clock -- so the only honest way to attribute the fold's cost per phase is to let the driver
// that owns the clock enter each phase and time the call. The same seam is what a fold-parallel
// realization needs: each phase is pure in its inputs, so the per-file sequence is also the
// parallel unit.
//
// DIVERGENCE, STATED (DESIGN section 3b, review 65114). `v2.compiler.staged_front_end` is the
// declared authority for the .dag front-end ORDER, and its own header warns that re-inlining the
// calls beside it is "a second copy of the order -- the section-3 nickname class". These phases
// ARE a second stepwise spelling of tokenize -> parse -> normalize, and the divergence is
// deliberate rather than unnoticed. THE REASON IS MEASURED, not asserted: `run_front_end_to` calls
// `dag_language_model()` per call and `front_end_parse_step` calls `parse_module` with a RAW
// grammar, so routing this fold through it would re-derive the language model and re-run
// `prepare_grammar` ONCE PER FILE -- the two per-file recomputes this fold exists to have already
// hoisted, and which this instrument's own receipt prices at one call and 0.13 s for the whole
// 2243-file closure. It also runs a fourth stage, resolve, which the context fold does not
// perform, and it returns a whole FrontEndRun rather than stages a clock can sit between.
//
// SO THE CONSOLIDATION IS NAMED AND IT IS NOT THIS PR'S: a prepared-grammar, resolve-free, per-
// stage entry on `v2.compiler.staged_front_end`, after which these phases are projections of that
// authority and this comment is deleted. That is a modeling change to a load-bearing module with
// its own witness suite, and it is tracked by the trigger on
// `gunbc.recurring_failure_mode.realization_respells_a_modeled_folds_sequencing_to_instrument_it`.
//
// A NON-SOURCE ARTIFACT REFUSES IN THE TOKENIZE PHASE, not before it, so every file enters
// exactly one phase sequence and no refusal escapes the attribution.
fn program_assembly_phase_tokenize(
  read: DagSourceReadWitness,
  lex: PreparedLexRules
) -> Outcome<TokenStream> {
  match read.artifact.kind {
    SourceFile =>
      tokenize_prepared(
        text: read.source.carried,
        file: read.compilation_unit,
        prepared: lex
      )
    _ =>
      outcome_rejected(
        d: source_authority_diagnostic(reason: ^source_authority_read_artifact_not_source_file)
      )
  }
}

// THE SEEDED MEASURED PHASE, AND THE MARK READ BACK OUT AS A SCALAR. These two exist for the
// emitted `SourceRootEvalDriver`, which does not call the composed per-file fold: it open-codes the
// sequence so a clock can sit between the phases, which is admitted debt filed at
// `gunbc.recurring_failure_mode` `realization_respells_a_modeled_folds_sequencing_to_instrument_it`.
// That respelling is exactly why the driver needs its own seam -- it cannot inherit the threading
// the composition does internally, so the threading has to be reachable phase by phase or the
// driver silently keeps the per-file reset while the modeled fold no longer has it.
//
// THE REJECTED-INPUT ARM REPRODUCES bind_outcome EXACTLY, and is spelled out rather than reused
// because bind_outcome cannot carry a second value out of the bound function: a Rejected token
// stream passes its diagnostics through untouched and reports empty accounting, because no parse
// ran -- an answer, not a missing measurement. The Accepted arm merges the incoming diagnostics
// through bind_outcome_accepted, which is what bind_outcome itself calls. (That reasoning arrived
// here with the unseeded twin this phase replaced; the twin is deleted, so the reasoning moves to
// the survivor rather than being deleted with it.)
//
// THE FALLBACK ON A REFUSAL IS THE SEED ITSELF, NOT ZERO, AND NOT THE MARK THE ATTEMPT REACHED.
// Returning `occurrence_id_allocator_initial()` would silently rewind the whole ingest to the
// start, which is the collision this threading exists to prevent, at its worst.
//
// THE SEED IS A FLOOR, NOT A STATEMENT THAT NOTHING WAS MINTED (review 69819). A refused parse HAS
// minted ids -- `parse_prov_seeded` threads the allocator through the entire attempt -- and an
// earlier revision of this paragraph said "nothing after a refusal consumed an id", which was
// false. What is true is that the mark the attempt reached is not RECOVERABLE here:
// `ParseExprRejected` carries no provenance state, by construction, because the parse core
// backtracks and a failed branch's mints are abandoned by design. Reusing those ids is sound
// exactly while nothing retains a refused parse's node loci; the precondition and the carrier that
// would break it are named on `v2.compiler.compile` `native_test_context_absorb`, which is where
// the reuse actually happens.
fn program_assembly_phase_parse_measured_seeded(
  tokens: Outcome<TokenStream>,
  prepared: PreparedGrammar,
  residue: Diagnostics,
  seed: OccurrenceIdAllocator
) -> ParseProductionMeasured {
  match tokens {
    Rejected { diagnostics: d } =>
      ParseProductionMeasured {
        outcome: Rejected { diagnostics: d },
        memo: parse_memo_stats_empty()
      }
    Accepted { value: token_stream, diagnostics: od } =>
      let measured = parse_module_prepared_measured_seeded(
        tokens: token_stream,
        prepared: prepared,
        validation_residue: residue,
        seed: seed
      )
      ParseProductionMeasured {
        outcome: bind_outcome_accepted(od: od, inner: measured.outcome),
        memo: measured.memo
      }
  }
}

// THE MARK AS A SCALAR, for the same reason the three memo counters above are read out one at a
// time: the driver prints scalars, and a record does not cross that boundary as one. This is what
// makes the emitted loop's threading OBSERVABLE from outside the binary -- the per-file line carries
// the mark it was handed and the mark it reached, so a run over several files shows one sequence
// continuing rather than a claim that it does.
fn program_assembly_allocator_next(alloc: OccurrenceIdAllocator) -> Int {
  alloc.next_id
}

fn program_assembly_measured_alloc(
  measured: ParseProductionMeasured,
  seed: OccurrenceIdAllocator
) -> OccurrenceIdAllocator {
  match measured.outcome {
    Rejected { diagnostics: _ } => seed
    Accepted { value: artifact, diagnostics: _ } => artifact.alloc
  }
}

// The three counters, read out one at a time because the driver prints scalars and a record does
// not cross that boundary as one.
fn program_assembly_memo_hits(measured: ParseProductionMeasured) -> Int {
  measured.memo.hits
}

fn program_assembly_memo_misses(measured: ParseProductionMeasured) -> Int {
  measured.memo.misses
}

fn program_assembly_memo_lookup_calls(measured: ParseProductionMeasured) -> Int {
  measured.memo.lookup_calls
}

fn program_assembly_measured_outcome(measured: ParseProductionMeasured) -> Outcome<ParseArtifact> {
  measured.outcome
}

// THE NORMALIZE PHASE ADVANCES THE INGEST'S ALLOCATOR, and returns it beside the outcome so a loop
// over the ingest seeds the next file's parse from it: lowering allocates every image member an id
// (v2.compiler.normalize normalize_scoped), and the next file's authored ids must start above those.
// A refused parse or normalize returns the seed unchanged.
// `spans` is THIS FILE'S OWN span index (the parse artifact's), carried so a refusal's node loci
// can be resolved against the file that produced them before anything retains them; empty when
// the parse itself refused, whose diagnostics are already Textual. Same field, same meaning, as
// `ProgramAssemblySeededReadResult` `spans` on the composed door.
type ProgramAssemblyNormalizedPhase {
  outcome: Outcome<NormalizedTree>
  alloc: OccurrenceIdAllocator
  spans: SpanIndex
}

fn program_assembly_phase_normalize_seeded(
  parsed: Outcome<ParseArtifact>,
  seed: OccurrenceIdAllocator,
  scope: Fnv1a64Structural
) -> ProgramAssemblyNormalizedPhase {
  match parsed {
    Rejected { diagnostics: d } => ProgramAssemblyNormalizedPhase { outcome: Rejected { diagnostics: d }, alloc: seed, spans: span_index_empty() }
    Accepted { value: artifact, diagnostics: od } =>
      match normalize_scoped(parse_tree: artifact.tree, allocator: scoped_occurrence_allocator(alloc: seed, scope: scope)) {
        Rejected { diagnostics: d } =>
          ProgramAssemblyNormalizedPhase { outcome: bind_outcome_accepted(od: od, inner: Rejected { diagnostics: d }), alloc: seed, spans: artifact.span_index }
        Accepted { value: scoped, diagnostics: nd } =>
          ProgramAssemblyNormalizedPhase {
            outcome: bind_outcome_accepted(od: od, inner: Accepted { value: scoped.tree, diagnostics: nd }),
            alloc: scoped.allocator.alloc,
            spans: artifact.span_index
          }
      }
  }
}

fn program_assembly_normalized_outcome(phase: ProgramAssemblyNormalizedPhase) -> Outcome<NormalizedTree> {
  phase.outcome
}

fn program_assembly_normalized_alloc(phase: ProgramAssemblyNormalizedPhase) -> OccurrenceIdAllocator {
  phase.alloc
}

fn program_assembly_normalized_spans(phase: ProgramAssemblyNormalizedPhase) -> SpanIndex {
  phase.spans
}

// The ingest scope as an Outcome, for a caller outside the modeled fold (the emitted driver loop),
// which refuses the whole ingest on the refusal arm.
fn program_assembly_ingest_scope_outcome(ingest: SourceRootIngest) -> Outcome<Fnv1a64Structural> {
  match program_assembly_ingest_scope(ingest: ingest) {
    SourceRefListDigestOk { digest: d } => outcome_accepted(value: d)
    SourceRefListDigestNonStructuralRefused { path: _ } =>
      outcome_rejected(d: source_authority_diagnostic(reason: ^program_assembly_ingest_scope_non_structural))
  }
}

// THE EXECUTION COUNT THE TIME IS READ AGAINST. A phase span alone cannot distinguish "this file
// is large" from "this file pays a per-file constant", so the driver prints the token count beside
// the spans. A refused tokenize counts zero tokens -- absence, not a fabricated size.
fn program_assembly_phase_token_count(tokens: Outcome<TokenStream>) -> Int {
  match tokens {
    Rejected { diagnostics: _ } => 0
    Accepted { value: stream, diagnostics: _ } => token_stream_remaining_count(stream: stream)
  }
}

// THE SEEDED PER-FILE FRONT END, WHICH IS THE ONE THE INGEST FOLD USES. The occurrence ids it mints
// continue the ingest's count instead of restarting, and it hands back the mark it reached and the
// spans it recorded so the fold can thread them. Normalize is applied to the parse artifact's tree,
// so the normalized nodes carry occurrence ids drawn from the SAME ingest-wide sequence the span
// index is keyed by -- that agreement is what makes the later join a lookup rather than a search.
//
// (This paragraph described an earlier carrier, `ProgramAssemblySeededRead`, which the restructure
// to the three-field result below replaced and which survived as an unconstructed declaration --
// DESIGN section 3c's "pub declaration with no call site in the closure", found by review 70027.
// The type is deleted and its reasoning folded here, onto the carrier that exists.)

// THE SPANS SURVIVE THIS READ'S OWN REFUSAL, which is the same reason IngestAssembly exists one
// layer up: a file that PARSED and then failed to normalize or graft has a fully recorded span
// index, and it is exactly the file whose diagnostic a reader needs located. Returning
// Outcome<...> alone would discard that index on the arm where it matters most.
//
// TOKENIZE OR PARSE REFUSING REPORTS AN EMPTY INDEX, and the reason is that the artifact holding
// the index does not exist on that arm -- NOT that no occurrence was minted. A refused parse mints
// ids and records spans for them inside a `ParseProvenanceState` the refusal discards. Empty here
// is therefore "this producer cannot reach what was recorded", which `span_index_lookup` turns into
// a refusal at the join rather than a wrong locus -- the fail-closed arm. An earlier revision of
// this sentence claimed nothing was minted, which was a stronger and false claim (review 69819).
type ProgramAssemblySeededReadResult {
  alloc: OccurrenceIdAllocator,
  spans: SpanIndex,
  produced: Outcome<NormalizedTree>
}

fn program_assembly_read_to_normalized_root_seeded(
  read: DagSourceReadWitness,
  lex: PreparedLexRules,
  prepared: PreparedGrammar,
  residue: Diagnostics,
  seed: OccurrenceIdAllocator,
  scope: Fnv1a64Structural
) -> ProgramAssemblySeededReadResult {
  match bind_outcome(
    o: program_assembly_phase_tokenize(read: read, lex: lex),
    f: fn(token_stream) {
      parse_module_prepared_seeded(
        tokens: token_stream,
        prepared: prepared,
        validation_residue: residue,
        seed: seed
      )
    }
  ) {
    Rejected { diagnostics: d } =>
      ProgramAssemblySeededReadResult {
        alloc: seed,
        spans: span_index_empty(),
        produced: Rejected { diagnostics: d }
      }
    Accepted { value: artifact, diagnostics: od } =>
      match normalize_scoped(parse_tree: artifact.tree, allocator: scoped_occurrence_allocator(alloc: artifact.alloc, scope: scope)) {
        Rejected { diagnostics: d } =>
          ProgramAssemblySeededReadResult {
            alloc: artifact.alloc,
            spans: artifact.span_index,
            produced: bind_outcome_accepted(od: od, inner: Rejected { diagnostics: d })
          }
        Accepted { value: scoped, diagnostics: nd } =>
          ProgramAssemblySeededReadResult {
            alloc: scoped.allocator.alloc,
            spans: artifact.span_index,
            produced: bind_outcome_accepted(od: od, inner: Accepted { value: scoped.tree, diagnostics: nd })
          }
      }
  }
}

// THE UNSEEDED PER-FILE COMPOSITION IS DELETED, NOT RETAINED (review 69837). It was
// `program_assembly_read_to_normalized_root_prepared` and its nullary sibling
// `program_assembly_read_to_normalized_root`: a second per-file front-end composition that still
// performed the per-file allocator reset. This change moved its last real consumer
// (`v2.compiler.compile` `native_test_context_fold_step`) onto the seeded door, which left the pair
// reachable from nothing -- DESIGN section 3c's "a pub declaration with no call site in the
// closure".
//
// DELETED RATHER THAN LEFT STANDING, because a surviving unseeded composition is DESIGN section 3's
// attractor: while it stands, the next fold that needs a per-file front end answers in its
// vocabulary and silently reintroduces the reset. This module's own annotation on `02_parse`
// already concedes that hazard is real and that no wall catches it -- "a NEW ingest fold that calls
// the unseeded door is a defect this annotation cannot catch" -- so the honest move is to remove
// the door rather than document the trap beside it. The seeded producer above is now the single
// per-file front end, and a caller that wants an isolated scope seeds it with
// `occurrence_id_allocator_initial()` explicitly, which is a statement rather than a default.

// THE FAILING READ'S OWN SPANS ARE MERGED IN BEFORE THE REFUSAL IS BUILT (`carried`), and that is
// the point of the repair review 69607 asked for: a file that parsed and then failed to normalize
// or graft is exactly the file whose diagnostic needs locating, and its index would otherwise be
// dropped one step before the renderer asked for it. Both refusing arms below -- the read's own
// refusal and the module-name derivation's -- carry it, so neither loses what was recorded.
// AN ACCEPTED FILE'S ADVISORIES JOIN THE INGEST'S CHAIN WITHOUT RE-COPYING IT. diagnostics_merge
// rebuilds the accumulated chain on every call (list_append is O(n) per call), so folding it once
// per file made the ingest quadratic in its total advisory count (DESIGN section 6, bare minimum
// cost). The new file's diagnostics are pushed one at a time onto the accumulated tail
// (list_snoc_item, amortized O(log n)); the chain's order is unchanged -- earlier files first, each
// file's own order kept.
fn program_assembly_advisories_extend(acc: Diagnostics, more: Diagnostics) -> Diagnostics {
  match more {
    None => acc
    Some { diagnostics: m } =>
      match acc {
        None => more
        Some { diagnostics: a } =>
          Some {
            diagnostics: NonEmptyDiagnostics {
              head: a.head,
              tail: fold_list(
                xs: m.tail,
                empty: list_snoc_item(xs: a.tail, item: m.head),
                cons: fn(t, x) { list_snoc_item(xs: t, item: x) }
              )
            }
          }
      }
  }
}

// THE ONE TRANSITION FROM AN ACCEPTED FOLD TO A REFUSED ONE. The advisories the ingest accumulated
// before the refusing file stay on the refusal, ahead of it, in the order rejected_with_pending gives
// any pending chain (the fatal cause stays the refusal's own, the last element). Both refusing arms of
// the fold step go through here, so they cannot disagree about it; building the failed state from the
// refusal alone dropped every earlier file's advisories.
fn program_assembly_fold_failed(pending: Diagnostics, refused: NonEmptyDiagnostics, spans: SpanIndex) -> ProgramAssemblyLocatedFoldState {
  ProgramAssemblyLocatedFoldFailed {
    diagnostics: rejected_with_pending(pending: pending, rejected: refused),
    spans: spans
  }
}

fn program_assembly_fold_step(
  state: ProgramAssemblyLocatedFoldState,
  read: DagSourceReadWitness,
  lex: PreparedLexRules,
  prepared: PreparedGrammar,
  residue: Diagnostics,
  scope: Fnv1a64Structural
) -> ProgramAssemblyLocatedFoldState {
  match state {
    ProgramAssemblyLocatedFoldFailed { diagnostics: d, spans: spans } =>
      ProgramAssemblyLocatedFoldFailed { diagnostics: d, spans: spans }
    ProgramAssemblyLocatedFoldOk { located: acc, index: idx, alloc: seed, spans: spans, advisories: advised } =>
      let result = program_assembly_read_to_normalized_root_seeded(
        read: read,
        lex: lex,
        prepared: prepared,
        residue: residue,
        seed: seed,
        scope: scope
      )
      let carried = span_index_merge(base: spans, incoming: result.spans)
      match result.produced {
        Accepted { value: tree, diagnostics: file_advisories } =>
          match qualified_name_from_module_node(root: tree.root) {
            Accepted { value: qn, diagnostics: _ } =>
              ProgramAssemblyLocatedFoldOk {
                located: list_snoc_item(
                  xs: acc,
                  item: LocatedNormalizedTree { path: read.artifact.file_path, tree: tree }
                ),
                index: source_root_index_insert(index: idx, module: qn, root: read.source_root),
                alloc: result.alloc,
                spans: carried,
                advisories: program_assembly_advisories_extend(acc: advised, more: file_advisories)
              }
            Rejected { diagnostics: d } =>
              program_assembly_fold_failed(
                pending: program_assembly_advisories_extend(acc: advised, more: file_advisories),
                refused: d,
                spans: carried
              )
          }
        Rejected { diagnostics: d } =>
          program_assembly_fold_failed(pending: advised, refused: d, spans: carried)
      }
  }
}

// §5 fail-closed repair (Phase 1, docs/plans/module-identity-storage-binding-design.md): the
// Rejected arm of qualified_name_from_module_node previously kept the root and left the
// SourceRootIndex UNCHANGED — a module whose name could not be derived was silently dropped from
// the index while its root stayed in the program, so every downstream lookup missed it with no
// diagnostic and no count. That is an absorbing fallback in drop form: the deficit's frequency was
// zero by construction, so it could never rank for fixing (§6 prices by displaced cost, and a
// masked cost displaces nothing). The arm now refuses with the located diagnostic the name
// derivation produced. The binding itself is homed on v2.compiler.source_authority
// (ModuleStorageBinding); this fold keeps the SourceRootIndex it already owned, and its
// name-derivation failure mode is now the same refusal the authority raises.

data program_assembly_prepare_once_note: String = "prepare_grammar is hoisted ABOVE fold_list here so the grammar is well-formed-checked, validated (5 checks), and FIRST/nullable-analyzed ONCE per assembly — then parse_module_prepared reuses the PreparedGrammar for every module in the ingest. A door call over a K-module import closure therefore validates once, not K times (the recompute-per-module cost this dissolves). Empty-ingest is guarded so it never pays the one-time prepare for zero modules. Fail-closed: an invalid grammar fails the whole assembly (ProgramAssemblyFoldFailed) before any module is parsed, carrying the validation diagnostic — never a per-module silent skip."

// THE ONE PREPARED `.dag` GRAMMAR, FORCED ONCE OUTSIDE THE CLAIM FOLD. Every assembly of `.dag`
// source pays `prepare_grammar(grammar: lm.grammar)` with `lm.grammar` content-identical to
// `dag_grammar()` before its fold can start, and `prepare_grammar` is the cross-claim pure tier's
// built-in admitted arm, so one fill serves every claim — if it ever lands. The fill costs more
// than one claim's CPU budget, so an in-fold first touch dies mid-flight (FillBudgetExceeded) and is
// abandoned un-stored, and the next claim starts it over. Enrolled in
// `floor_cross_claim_pure_producers_warm` (v2.workflow.floor_pure_producer_share) so the required
// floor evaluates this nullary producer during strict preparation — outside every per-claim
// budget — and the inner `prepare_grammar` fill lands in the tier before any claim runs.
fn dag_prepared_grammar() -> Outcome<PreparedGrammar> {
  prepare_grammar(grammar: dag_grammar())
}

// THE GRAMMAR REFUSAL REPORTS AN EMPTY INDEX AND THAT IS AN ANSWER, NOT A DROP. An invalid grammar
// fails the whole assembly before any module is parsed, so no occurrence was ever minted and there
// is nothing recorded to carry -- which is a different fact from the per-read refusals above, where
// something WAS recorded and losing it was the defect.
// THE INGEST'S ALLOCATOR SCOPE, computed once per ingest from the source-ref list the ingest reads
// (v2.compiler.source_authority source_ref_list_digest_build, at path grain). Every projected
// occurrence this ingest allocates states its cause in this scope, which is what separates a
// same-graph lowering member from a projector insertion (v2.workflow.legacy_binding_delta).
fn program_assembly_ingest_scope(ingest: SourceRootIngest) -> SourceRefListDigestBuild {
  source_ref_list_digest_build(refs: fold_list(
    xs: ingest,
    empty: Empty,
    cons: fn(acc, read) { list_snoc_item(xs: acc, item: source_ref_for_storage_path(path: read.artifact.file_path)) }
  ))
}

fn program_assembly_fold_ingest_located(
  ingest: SourceRootIngest,
  lm: LanguageModel
) -> ProgramAssemblyLocatedFoldState {
  match ingest {
    Empty =>
      ProgramAssemblyLocatedFoldOk {
        located: program_assembly_empty_located_roots(),
        index: source_root_index_empty(),
        alloc: occurrence_id_allocator_initial(),
        spans: span_index_empty(),
        advisories: None
      }
    _ =>
      match prepare_grammar(grammar: lm.grammar) {
        Rejected { diagnostics: d } =>
          ProgramAssemblyLocatedFoldFailed { diagnostics: d, spans: span_index_empty() }
        Accepted { value: prepared, diagnostics: residue } =>
          let lex = prepare_lex_rules(rules: lm.lex)
          match program_assembly_ingest_scope(ingest: ingest) {
            SourceRefListDigestNonStructuralRefused { path: _ } =>
              ProgramAssemblyLocatedFoldFailed {
                diagnostics: diagnostics_singleton(d: source_authority_diagnostic(reason: ^program_assembly_ingest_scope_non_structural)),
                spans: span_index_empty()
              }
            SourceRefListDigestOk { digest: scope } =>
              fold_list(
                xs: ingest,
                empty: ProgramAssemblyLocatedFoldOk {
                  located: program_assembly_empty_located_roots(),
                  index: source_root_index_empty(),
                  alloc: occurrence_id_allocator_initial(),
                  spans: span_index_empty(),
                  advisories: None
                },
                cons: fn(state, read) {
                  program_assembly_fold_step(state: state, read: read, lex: lex, prepared: prepared, residue: residue, scope: scope)
                }
              )
          }
      }
  }
}

fn program_assembly_fold_ingest(
  ingest: SourceRootIngest,
  lm: LanguageModel
) -> ProgramAssemblyFoldState {
  program_assembly_fold_state_from_located(
    state: program_assembly_fold_ingest_located(ingest: ingest, lm: lm)
  )
}

fn located_module_roots_from_source_root_ingest(
  ingest: SourceRootIngest,
  lm: LanguageModel
) -> Outcome<FreeMonoid<LocatedNormalizedTree>> {
  match program_assembly_fold_ingest_located(ingest: ingest, lm: lm) {
    ProgramAssemblyLocatedFoldOk { located: located, index: _, alloc: _, spans: _, advisories: advised } =>
      outcome_with_diagnostics(value: located, diagnostics: advised)
    ProgramAssemblyLocatedFoldFailed { diagnostics: d, spans: _ } =>
      Rejected { diagnostics: d }
  }
}

// ONE FOLD, BOTH HALVES OF THE IDENTITY JOIN. A consumer that needs to relate a node back to the
// file it came from needs the per-file roots AND the index those roots' occurrences are keyed in,
// and taking them from two separate calls would parse the ingest twice for one question (DESIGN
// section 2) while leaving the two results free to disagree. They are one fold's output, so they are
// returned together.
type LocatedIngestRoots {
  located: FreeMonoid<LocatedNormalizedTree>,
  spans: SpanIndex
}

fn located_roots_and_spans_from_source_root_ingest(
  ingest: SourceRootIngest,
  lm: LanguageModel
) -> Outcome<LocatedIngestRoots> {
  match program_assembly_fold_ingest_located(ingest: ingest, lm: lm) {
    ProgramAssemblyLocatedFoldOk { located: located, index: _, alloc: _, spans: spans, advisories: advised } =>
      outcome_with_diagnostics(value: LocatedIngestRoots { located: located, spans: spans }, diagnostics: advised)
    ProgramAssemblyLocatedFoldFailed { diagnostics: d, spans: _ } =>
      Rejected { diagnostics: d }
  }
}

fn module_roots_from_source_root_ingest(
  ingest: SourceRootIngest,
  lm: LanguageModel
) -> Outcome<FreeMonoid<NormalizedTree>> {
  match program_assembly_fold_ingest_located(ingest: ingest, lm: lm) {
    ProgramAssemblyLocatedFoldOk { located: located, index: _, alloc: _, spans: _, advisories: advised } =>
      outcome_with_diagnostics(value: list_map(xs: located, f: fn(item) { item.tree }), diagnostics: advised)
    ProgramAssemblyLocatedFoldFailed { diagnostics: d, spans: _ } =>
      Rejected { diagnostics: d }
  }
}

fn assemble_program_from_module_roots(
  roots: FreeMonoid<NormalizedTree>,
  admission: Admission,
  lm: LanguageModel
) -> Outcome<ResolvedTree> {
  bind_outcome(
    o: validate_module_roots(roots: roots),
    f: fn(validated_roots) {
      resolve_with_admission(
        lm: lm,
        roots: validated_roots.roots,
        admission: admission
      )
    }
  )
}

// THE SPANS RIDE BESIDE THE OUTCOME, NOT INSIDE IT, AND THAT IS THE WHOLE POINT. A diagnostic needs
// its file exactly when the program did NOT assemble, and `Outcome`'s Rejected arm carries no value
// -- so an index returned as part of the accepted program is an index that has evaporated precisely
// where it was wanted. This carrier holds both arms' worth: the span index the fold recorded before
// it stopped, and the outcome itself. It is the same stance `ParseProductionMeasured` already takes
// for memo counters one layer down, for the same reason.
//
// A REFUSED ASSEMBLY STILL CARRIES THE SPANS OF EVERY FILE IT GOT THROUGH, which is the honest
// answer rather than a convenient one: the fold is fail-closed and stops at the first refusing read,
// so the index covers exactly the reads that were parsed, and an occurrence from a file that was
// never reached is absent rather than fabricated. `span_index_lookup` refuses on absence, so the
// renderer degrades to "no file" instead of to a wrong file.
type IngestAssembly {
  spans: SpanIndex,
  program: Outcome<ResolvedTree>
}

fn assemble_program_from_ingest_located(
  ingest: SourceRootIngest,
  admission: Admission,
  lm: LanguageModel
) -> IngestAssembly {
  match program_assembly_fold_ingest_located(ingest: ingest, lm: lm) {
    ProgramAssemblyLocatedFoldFailed { diagnostics: d, spans: spans } =>
      IngestAssembly { spans: spans, program: Rejected { diagnostics: d } }
    ProgramAssemblyLocatedFoldOk { located: located, index: idx, alloc: _, spans: spans, advisories: advised } =>
      IngestAssembly {
        spans: spans,
        program: bind_outcome_accepted(od: advised, inner: bind_outcome(
          o: validate_module_roots(roots: list_map(xs: located, f: fn(item) { item.tree })),
          f: fn(validated_roots) {
            resolve_with_admission_grounded(
              lm: lm,
              roots: validated_roots.roots,
              admission: admission,
              index: idx,
              active_roots: source_root_set_from_ingest(ingest: ingest)
            )
          }
        ))
      }
  }
}

fn assemble_program_from_ingest(
  ingest: SourceRootIngest,
  admission: Admission,
  lm: LanguageModel
) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest_located(
    ingest: ingest,
    admission: admission,
    lm: lm
  ).program
}
