// THE FREE-MONOID INTRODUCTION: A LIST LITERAL'S ONE INFER CASE. v2 body lowering writes
// `[e1, .., en]` as ONE flat Transform whose head is the reference to std.algebra FreeMonoid's
// declaration and whose remaining positional children are the elements in order
// (v2.std.list_introduction lower_list_introduction, read back by
// list_introduction_elements_optional) -- the flat canonical introduction
// std.literal_elaboration UnicodeScalarSequenceUnfold names, never a cons^n nesting. It is not an
// application: the head is a type, so application-argument inhabitance is not asked of it. Every
// element's type must be one T, compared STRUCTURALLY with provenance stripped (two equal types minted
// at two occurrences are one type, and a list of lists compares its element types whole); the first element that differs refuses located AT that element. The
// literal's type is then FreeMonoid<T>: the Instantiation of the FreeMonoid reference at T. `[]`
// carries no element to derive T from; its type is its boundary's, so it joins the counted
// GroundingNotDerived frontier like every Transform this fold does not derive -- never a guessed T.
// Two element types are one type when they are STRUCTURALLY equal with provenance removed at every
// level -- the same authority the inhabitance judgment decides declared-versus-produced types with
// (v2.std.node node_equal_ignoring_provenance), so a
// list of lists compares its FreeMonoid<T> element types whole rather than as atoms.
fn infer_list_element_type(element: Node, entries: Map<Node, List<InferredFacts>>, resolved: ResolvedTree) -> Outcome<Node> {
  match lookup_inferred_facts_in_entries(entries: entries, key: element) {
    Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: element))
    Present { value: facts } =>
      match infer_branch_operand_resolved_type_with_entries(node: element, facts: facts, entries: entries, instances: infer_no_type_variable_instances(), resolved: resolved) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: t } => outcome_accepted(value: t)
      }
  }
}

// Absent: `[]`, whose T is not derivable here. Present: the elements' one type, or the located
// refusal of the first element that differs.
fn infer_list_elements_unified_type(
  elements: List<Node>,
  entries: Map<Node, List<InferredFacts>>,
  resolved: ResolvedTree
) -> Optional<Outcome<Node>> {
  match elements {
    Empty => Absent
    Cons { head: first, tail: rest } =>
      Present {
        value: bind_outcome(o: infer_list_element_type(element: first, entries: entries, resolved: resolved), f: fn(t) {
          fold(rest, init: outcome_accepted(value: t), f: fn(acc, element) {
            bind_outcome(o: acc, f: fn(unified) {
              bind_outcome(o: infer_list_element_type(element: element, entries: entries, resolved: resolved), f: fn(et) {
                if node_equal_ignoring_provenance(a: unified, b: et) {
                  outcome_accepted(value: unified)
                } else {
                  outcome_rejected(infer_list_element_type_mismatch_diagnostic(element: element))
                }
              })
            })
          })
        })
      }
  }
}

fn infer_freemonoid_type_of(element_type: Node) -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: declaration_reference_node(qn: list_introduction_head_path(), occurrence_id: OccurrenceSynthetic), declaration: NotADeclaration },
      Edge { label: Positional, target: canonicalize_node_strip_provenance(n: element_type), declaration: NotADeclaration }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

// Absent: `[]` (frontier). Present: the literal's facts, or a located refusal.
fn infer_transform_freemonoid_introduction(
  node: Node,
  elements: List<Node>,
  entries: Map<Node, List<InferredFacts>>,
  resolved: ResolvedTree
) -> Optional<Outcome<InferredFacts>> {
  match infer_list_elements_unified_type(elements: elements, entries: entries, resolved: resolved) {
    Absent =>
      // `[]` MINTS ITS ELEMENT TYPE AS A CONSTRUCTOR-USE VARIABLE, exactly as Absent mints its payload
      // (infer_coproduct_type_applied_open): the empty list is a use of the FreeMonoid introduction whose
      // element type this node does not fix, so a declared position closes it and nothing else does.
      Present {
        value: match node_occurrence_id_optional(node: node) {
          Absent => outcome_rejected(infer_declaration_identity_unavailable_diagnostic(at: node))
          Present { value: use_id } =>
            match infer_descent_witness_for_node(n: node) {
              Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
              Holds { value: descent_proof } =>
                inferred_facts_from_derived_type(
                  node: node,
                  derived_type: infer_freemonoid_type_of(element_type: infer_open_type_param_atom(name: fresh_constructor_use_variable(use_id: use_id.value, label: ^element))),
                  descent: Holds { value: descent_proof }
                )
            }
        }
      }
    Present { value: unified } =>
      Present {
        value: bind_outcome(o: unified, f: fn(element_type) {
          match infer_descent_witness_for_node(n: node) {
            Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
            Holds { value: descent_proof } =>
              inferred_facts_from_derived_type(
                node: node,
                derived_type: infer_freemonoid_type_of(element_type: element_type),
                descent: Holds { value: descent_proof }
              )
          }
        })
      }
  }
}

fn infer_gather_transform_row_on_entries(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  expected: Optional<Node>,
  rigid_binders: List<Symbol>,
) -> InferGatherFoldAcc {
  match list_introduction_elements_optional(node: node) {
    Absent =>
      infer_gather_application_row_on_entries(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, expected: expected, rigid_binders: rigid_binders)
    Present { value: elements } =>
    match infer_transform_freemonoid_introduction(node: node, elements: elements, entries: entries, resolved: resolved) {
      Absent =>
        infer_gather_transform_frontier_on_entries(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, instances: infer_no_type_variable_instances(), binder_types: infer_no_binder_types(), rigid_binders: rigid_binders)
      Present { value: introduced } =>
        match introduced {
          Rejected { diagnostics: r } =>
            infer_gather_fold_acc_failed(
              node: node,
              pending: rejected_with_pending(pending: pending, rejected: r),
              await_branch_row: false,
              await_match_row: false,
              await_loop_row: false,
              await_transform_row: false,
              children_remaining: 0
            )
          Accepted { value: facts, diagnostics: d } =>
            match admitted_inferred_facts_entry(node: node, facts: facts) {
              Rejected { diagnostics: r } =>
                infer_gather_fold_acc_failed(
                  node: node,
                  pending: rejected_with_pending(pending: pending, rejected: r),
                  await_branch_row: false,
                  await_match_row: false,
                  await_loop_row: false,
                  await_transform_row: false,
                  children_remaining: 0
                )
              Accepted { value: entry, diagnostics: ed } =>
                infer_gather_fold_acc_ok(
                  node: node,
                  entries: inferred_facts_index_enter(index: entries, entry: entry),
                  pending: diagnostics_merge(outer: diagnostics_merge(outer: pending, inner: d), inner: ed),
                  await_branch_row: false,
                  await_match_row: false,
                  await_loop_row: false,
                  await_transform_row: false,
                  children_remaining: 0
                )
            }
        }
    }
  }
}

fn infer_gather_application_row_on_entries(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  expected: Optional<Node>,
  rigid_binders: List<Symbol>,
) -> InferGatherFoldAcc {
  if infer_application_callee_is_primitive_authority(node: node, resolved: resolved) {
    match infer_primitive_without_signature_refusal(node: node) {
      Rejected { diagnostics: r } =>
        infer_gather_fold_acc_failed(
          node: node,
          pending: rejected_with_pending(pending: pending, rejected: r),
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,
          children_remaining: 0
        )
      Accepted { value: _, diagnostics: _ } => infer_gather_application_row_on_arguments(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, expected: expected, rigid_binders: rigid_binders)
    }
  } else {
    infer_gather_application_row_on_arguments(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, expected: expected, rigid_binders: rigid_binders)
  }
}

fn infer_gather_application_row_on_arguments(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  expected: Optional<Node>,
  rigid_binders: List<Symbol>,
) -> InferGatherFoldAcc {
  match infer_application_argument_inhabitance(node: node, entries: entries, declarations: resolved.resolved_declarations, bindings: resolved.symbol_index, expected: expected, rigid_binders: rigid_binders) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: 0
      )
    Accepted { value: judged_args, diagnostics: id } =>
      infer_gather_acc_with_demands(
        acc: infer_gather_application_row_on_instances(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, rigid_binders: rigid_binders, instances: judged_args.instances, argument_diagnostics: id),
        demands: judged_args.demands
      )
  }
}

fn infer_gather_application_row_on_instances(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  rigid_binders: List<Symbol>,
  instances: List<TypeVariableInstance>,
  argument_diagnostics: Diagnostics,
) -> InferGatherFoldAcc {
  let id = argument_diagnostics
  let merged_pending = diagnostics_merge(outer: pending, inner: id)
  match infer_transform_derived_optional(
        node: node,
        partials: partials,
        entries: entries,
        resolved: resolved,
        arguments_decided: infer_diagnostics_none(d: id),
        instances: instances
      ) {
        Present { value: derived } =>
        match derived {
          Rejected { diagnostics: r } =>
            infer_gather_fold_acc_failed(
              node: node,
              pending: rejected_with_pending(pending: merged_pending, rejected: r),
              await_branch_row: false,
              await_match_row: false,
              await_loop_row: false,
              await_transform_row: false,
              children_remaining: 0
            )
          Accepted { value: facts, diagnostics: d } =>
            match admitted_inferred_facts_entry(node: node, facts: facts) {
              Rejected { diagnostics: r } =>
                infer_gather_fold_acc_failed(
                  node: node,
                  pending: rejected_with_pending(pending: merged_pending, rejected: r),
                  await_branch_row: false,
                  await_match_row: false,
                  await_loop_row: false,
                  await_transform_row: false,
                  children_remaining: 0
                )
              Accepted { value: entry, diagnostics: ed } =>
                infer_gather_fold_acc_ok(
                  node: node,
                  entries: inferred_facts_index_enter(index: entries, entry: entry),
                  pending: diagnostics_merge(
                    outer: diagnostics_merge(outer: merged_pending, inner: d),
                    inner: ed
                  ),
                  await_branch_row: false,
                  await_match_row: false,
                  await_loop_row: false,
                  await_transform_row: false,
                  children_remaining: 0
                )
            }
        }
        Absent =>
        infer_gather_transform_frontier_on_entries(
          node: node,
          entries: entries,
          pending: merged_pending,
          partials: partials,
          kinds: kinds,
          resolved: resolved,
          instances: infer_no_type_variable_instances(),
          binder_types: infer_no_binder_types(),
          rigid_binders: rigid_binders
        )
      }
}

fn infer_unsolved_constructor_type_variable_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_unsolved_constructor_type_variable,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// AN UNANNOTATED LET DECLARES NO POSITION, so nothing closes a constructor-use variable its value carries
// (`let x = Absent`): the variable is minted at the use and stays unbound. An unbound variable is the
// counted frontier, never an admission -- the let is refused at its value.
fn infer_unannotated_let_unsolved_refusal(node: Node, entries: Map<Node, List<InferredFacts>>, resolved: ResolvedTree) -> Outcome<Map<Node, List<InferredFacts>>> {
  match bind_slot_target(n: node, slot: BindValueSlot) {
    Absent => outcome_accepted(entries)
    Present { value: bound } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: bound) {
        Absent => outcome_accepted(entries)
        Present { value: facts } =>
          match inferred_facts_resolved_type_optional(facts: facts) {
            Absent => outcome_accepted(entries)
            Present { value: produced } =>
              if infer_type_is_open(t: produced) {
                outcome_rejected(infer_unsolved_constructor_type_variable_diagnostic(node: bound))
              } else {
                outcome_accepted(entries)
              }
          }
      }
  }
}

// AN ANNOTATED LET IS A DECLARED-TYPE POSITION. `let x: T = e` is Bind[x, e, body] +
// <type-annotation> T (v2.std.type_binder); it awaits its children, then e is judged at T through
// infer_judge_declared_position -- the one relation (v2.std.inhabitance declared_type_inhabitance)
// an argument meets at its formal, a body at its declared return and a field value at its field.
// An ascription converts nothing, so it is not a cast: v2.std.coercion coercion_cast_crossing is the
// relation for the explicit `e as T` form only. The refusal is located at the authored annotation
// and names the bound value (PositionLetAnnotation). A value whose type is not derived stays the counted
// UndecidableArgumentTypeNotDerived frontier, as at every other position. The enclosing fn's type
// parameters are not in scope here, so the obligation carries none: a let annotated with one is
// judged against the type variable's atom as it is spelled.
fn infer_bind_annotation_check(node: Node, entries: Map<Node, List<InferredFacts>>, resolved: ResolvedTree, rigid_binders: List<Symbol>) -> Outcome<Map<Node, List<InferredFacts>>> {
  match type_annotation_optional(n: node) {
    Absent => outcome_accepted(entries)
    Present { value: annotation } =>
      match bind_slot_target(n: node, slot: BindValueSlot) {
        Absent => outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
        Present { value: bound } =>
          infer_judge_declared_position_closing(
            position: position_let_annotation(bound: bound),
            application: annotation,
            entries: entries,
            declarations: resolved.resolved_declarations,
            bindings: resolved.symbol_index,
            formal: InhabitanceFormal { parameter_identity: ^let_annotation, declared: annotation },
            produced_at: bound,
            type_params: [],
            instances: infer_no_type_variable_instances(),
            rigid_binders: rigid_binders
          )
      }
  }
}

fn infer_gather_bind_annotation_row_on_entries(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  rigid_binders: List<Symbol>,
) -> InferGatherFoldAcc {
  match infer_bind_annotation_check(node: node, entries: entries, resolved: resolved, rigid_binders: rigid_binders) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: 0
      )
    Accepted { value: next, diagnostics: d } =>
      infer_gather_let_result_row(node: node, entries: next, pending: diagnostics_merge(outer: pending, inner: d), partials: partials, kinds: kinds, resolved: resolved, rigid_binders: rigid_binders)
  }
}

// THE TRANSFORMS WHOSE TYPE IS DERIVED, by shape: the binary Int add, and a cast whose operand's
// grounding is derived. Absent is the counted frontier (GroundingNotDerived), never an admission.
fn infer_diagnostics_none(d: Diagnostics) -> Bool {
  match d {
    None => true
    Some { diagnostics: _ } => false
  }
}

// A CALL WHOSE HEAD RESOLVED TO A std.primitives CONTRACT ROW (v2.compiler.primitive_authority) has a name and a
// cost row but NO declared type signature: those live in the seed's builtin_function_registry, with no .dag
// authority. Typing it as unknown and accepting would be silent wrongness (DESIGN §5), so it is REFUSED, typed
// and located at the callee, until a .dag signature authority for primitives exists. The refusal is asked at call-head
// position only (asked before argument binding, which would otherwise refuse the row as a non-arrow): a plain data reference to a *_contract row is an ordinary PrimitiveContract value.
fn infer_application_callee_is_primitive_authority(node: Node, resolved: ResolvedTree) -> Bool {
  match infer_application_callee_use(node: node) {
    Absent => false
    Present { value: callee } =>
      match declaration_reference_path_optional(node: callee) {
        Absent => false
        Present { value: path } => symbol_index_declares_primitive_contract_at(index: resolved.symbol_index, qualified_path: path)
      }
  }
}

fn infer_primitive_without_signature_refusal(node: Node) -> Outcome<InferredFacts> {
  let at = match infer_application_callee_use(node: node) {
    Present { value: callee } => callee
    Absent => node
  }
  outcome_rejected(Diagnostic { reason: ^infer_reason_primitive_without_declared_signature_authority, at: node_locus(node: at), correction: Unavailable { reason: CorrectionNotModeled } })
}

// arguments_decided: argument inhabitance returned no counted-undecidable obligation. Arrow
// elimination derives only then -- an application whose argument obligation is still undecided
// stays on the frontier rather than typing past it.
fn infer_transform_derived_optional(
  node: Node,
  partials: List<Node>,
  entries: Map<Node, List<InferredFacts>>,
  resolved: ResolvedTree,
  arguments_decided: Bool,
  instances: List<TypeVariableInstance>,
) -> Optional<Outcome<InferredFacts>> {
  if infer_transform_is_binary_infix_algebra_shape(node: node) {
    optional_present(value: infer_transform_binary_infix(node: node, partials: partials, entries: entries, resolved: resolved))
  } else if infer_transform_is_unary_prefix_algebra_shape(node: node) {
    optional_present(value: infer_transform_unary_prefix(node: node, partials: partials, entries: entries, resolved: resolved))
  } else if infer_transform_is_cast(node: node) {
    infer_transform_cast_optional(node: node, entries: entries, resolved: resolved)
  } else if arguments_decided {
    infer_transform_application_optional(node: node, entries: entries, instances: instances, declarations: resolved.resolved_declarations, bindings: resolved.symbol_index)
  } else {
    optional_absent()
  }
}

// ARROW ELIMINATION. `f(a)`, where the callee is an Arrow, has the type the Arrow DECLARES it
// returns (infer_arrow_declared_return_type: the return atom as written, never the composed
// evidence). The caller has already admitted argument inhabitance, and the callee must itself be
// derived -- so arrow introduction has checked its body against that return. An underived callee,
// a non-Arrow operator, or a return the language join does not denote stays on the counted
// frontier: Absent here, never an admission.
fn infer_transform_application_optional(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  instances: List<TypeVariableInstance>,
  declarations: SymbolIndex,
  bindings: SymbolIndex
) -> Optional<Outcome<InferredFacts>> {
  match infer_application_callee_arrow_with_facts(node: node, entries: entries) {
    Absent => optional_absent()
    Present { value: arrow } =>
      match infer_application_callee_use(node: node) {
        Absent => optional_absent()
        Present { value: callee_use } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: callee_use) {
        Absent => optional_absent()
        Present { value: arrow_facts } =>
          if !inferred_facts_grounding_derived(facts: arrow_facts) {
            optional_absent()
          } else {
            match infer_application_result_type(arrow: arrow, instances: instances, declarations: declarations, bindings: bindings) {
              Absent => optional_absent()
              Present { value: return_type } =>
                optional_present(
                  value: match infer_descent_witness_for_node(n: node) {
                    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
                    Holds { value: descent_proof } =>
                      infer_facts_instantiated(
                        o: inferred_facts_from_derived_type(
                          node: node,
                          derived_type: return_type,
                          descent: Holds { value: descent_proof }
                        ),
                        instances: instances
                      )
                  }
                )
            }
          }
      }
      }
  }
}

// A CAST `e as T` is Transform[coerce, e] + <cast-target> T (v2.std.type_binder). Its type is T, and
// it is admitted only when v2.std.coercion coercion_cast_crossing finds e's derived grounding
// crosses to T; otherwise it refuses with coercion's typed mismatch. An operand whose grounding is
// not derived leaves the cast on the counted frontier -- the crossing is not judged, and it is not
// admitted either.
fn infer_transform_is_cast(node: Node) -> Bool {
  match list_at_optional(xs: positional_child_target_nodes(node: node), index: 0) {
    Present { value: op } =>
      canonical_operation_wire_matches_operation(wire: op, operation: canonical_operation_op_coerce())
    Absent => false
  }
}

fn infer_transform_cast_optional(node: Node, entries: Map<Node, List<InferredFacts>>, resolved: ResolvedTree) -> Optional<Outcome<InferredFacts>> {
  if !infer_transform_is_cast(node: node) {
    optional_absent()
  } else {
    match cast_target_optional(n: node) {
      Absent => optional_present(value: outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node)))
      Present { value: target } =>
        match list_at_optional(xs: positional_child_target_nodes(node: node), index: 1) {
          Absent => optional_present(value: outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node)))
          Present { value: operand } =>
            match lookup_inferred_facts_in_entries(entries: entries, key: operand) {
              Absent => optional_present(value: outcome_rejected(infer_facts_lookup_miss_diagnostic(key: operand)))
              Present { value: operand_facts } =>
                match operand_facts.grounding {
                  GroundingNotDerived { node: _, site: _ } => optional_absent()
                  DerivedGrounding { grounding: g } =>
                    optional_present(value: bind_outcome(
                      o: coercion_cast_crossing(
                        source: g,
                        source_type: g.witness.structural.evidence,
                        source_declared_carrier: refinement_declared_carrier(index: resolved.resolved_declarations, source_type: g.witness.structural.evidence),
                        target: target
                      ),
                      f: fn(crossed) {
                        match infer_descent_witness_for_node(n: node) {
                          Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
                          Holds { value: descent_proof } =>
                            inferred_facts_from_derived_type(
                              node: node,
                              derived_type: crossed.target,
                              descent: Holds { value: descent_proof }
                            )
                        }
                      }
                    ))
                }
            }
        }
    }
  }
}

// This dispatch is TOTAL over the closed node vocabulary (6 connectives + 6 behaviors) with no
// wildcard arm -- the construction half of the wall. The wildcard it replaces let eight kinds fall
// silently into the self-grounding fabrication; enumerating them means a thirteenth kind cannot be
// added without deciding, at this site, whether it derives its type or joins the counted frontier
// -- never defaulted into by omission (DESIGN §4 closed vocabulary, §5 unwritable-by-construction).

fn infer_gather_fold_not_derived(n: Node, partials: List<Node>, kinds: List<RosterKindIndex>, resolved: ResolvedTree, instances: List<TypeVariableInstance>, binder_types: List<InferBinderType>, rigid_binders: List<Symbol>) -> InferGatherFoldAcc {
  infer_gather_transform_frontier_on_entries(
    node: n,
    entries: empty_map(),
    pending: None,
    partials: partials,
    kinds: kinds,
    resolved: resolved,
    instances: instances,
    binder_types: binder_types,
    rigid_binders: rigid_binders
  )
}

// THE CONJ ARM READS A RESOLVED CORPUS-DECLARATION REFERENCE FIRST, BECAUSE IT IS CONJ-SHAPED AND
// NOT A RECORD. Resolution carries a reference to a declaration as its declaring path
// (v2.compiler.resolve resolved_reference_node), a qualified-name spine that shares the Conj
// connective with a product; read as a product it would be typed as a two-field record of its own
// segments, silently. It is exactly what a bare Atom reference was to this fold before the carrier
// -- a grounding this fold does not derive -- and it takes that arm. Deriving the reference's type
// FROM its declaration by path is the end-state the roster lookups above already name as their
// dissolution, not this arm.
fn infer_gather_fold_init(n: Node, partials: List<Node>, kinds: List<RosterKindIndex>, resolved: ResolvedTree, instances: List<TypeVariableInstance>, binder_types: List<InferBinderType>, rigid_binders: List<Symbol>) -> InferGatherFoldAcc {
  match n.kind {
    ComputationNode { behavior: Branch } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_map(),
        pending: None,
        await_branch_row: true,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Match } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_map(),
        pending: None,
        await_branch_row: false,
        await_match_row: true,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Loop } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_map(),
        pending: None,
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: true,
        await_transform_row: false,
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Value } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
    ComputationNode { behavior: Transform } =>
      if length(xs: n.children) == 0 {
        infer_gather_transform_row_on_entries(
          node: n,
          entries: empty_map(),
          pending: None,
          partials: partials,
          kinds: kinds,
          resolved: resolved,
          expected: Absent,
          rigid_binders: rigid_binders
        )
      } else {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_map(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: true,
          children_remaining: length(xs: n.children)
        )
      }
    ComputationNode { behavior: Bind } =>
      if infer_bind_encodes_collection_fold(bind: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_map(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,
          children_remaining: length(xs: n.children)
        )
      } else {
      match type_annotation_optional(n: n) {
        Present { value: _ } =>
          infer_gather_fold_acc_ok(
            node: n,
            entries: empty_map(),
            pending: None,
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: length(xs: n.children)
          )
        Absent =>
          match bind_binder(n: n) {
            Present { value: _ } =>
              infer_gather_fold_acc_ok(
                node: n,
                entries: empty_map(),
                pending: None,
                await_branch_row: false,
                await_match_row: false,
                await_loop_row: false,
                await_transform_row: false,
                children_remaining: length(xs: n.children)
              )
            Absent => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
          }
      }
      }
    TypeNode { connective: Atom { identity: _ } } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
    TypeNode { connective: Conj } =>
      match declaration_reference_path_optional(node: n) {
        Present { value: _ } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
        Absent =>
      match parameter_reference_path_optional(node: n) {
        Present { value: _ } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
        Absent =>
      match lexical_reference_label_optional(node: n) {
        Present { value: _ } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
        Absent =>
      if infer_type_node_awaits_product_row(kinds: kinds, n: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_map(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,
          children_remaining: length(xs: n.children)
        )
      } else {
        infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
      }
      }
      }
      }
    TypeNode { connective: Disj } =>
      if infer_disj_is_named_sum(n: n) && !infer_node_declared_in_language_inhabitants_bool(kinds: kinds, n: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_map(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,
          children_remaining: length(xs: n.children)
        )
      } else {
        infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
      }
    TypeNode { connective: Arrow } =>
      if infer_type_node_awaits_product_row(kinds: kinds, n: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_map(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,
          children_remaining: length(xs: n.children)
        )
      } else {
        infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
      }
    TypeNode { connective: Instantiation } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types, rigid_binders: rigid_binders)
  }
}

fn infer_gather_failed_non_empty(acc: InferGatherFoldAcc) -> NonEmptyDiagnostics {
  match acc.pending {
    Some { diagnostics: nds } => nds
    None =>
      diagnostics_singleton(
        d: infer_canonical_grounding_incoherent_diagnostic(node: infer_gather_fold_failure_node())
      )
  }
}

// WHICH LITERAL FAMILY OWNS A PAYLOAD EDGE. An integer literal's type derives from its canonical
// representation, including its sole named magnitude subtree; a symbol literal's sole named name
// payload is its value, not a reference. Each derivation discharges only that edge's local type
// frontier (propagating it past the literal would report GroundingNotDerived after the literal was
// derived), and the payload's FACTS follow the same family: the decision is typed, so the payload
// fold below is told whose payload it is rather than assuming the integer shape (review 5348050288
// on #12549, where a Symbol name atom was typed DecimalDigit). Boolean literals are canonical only
// with no children, so no boolean payload can be discharged. Malformed literals remain
// GroundingNotDerived and retain every child diagnostic.
type InferLiteralPayload
  = InferIntMagnitudePayload
  | InferSymbolNamePayload
  | InferStringValuePayload
  | InferNotALiteralPayload

fn infer_literal_edge_payload(parent: Node, edge: Edge) -> InferLiteralPayload {
  match dag_canonical_literal_from_node(node: parent) {
    Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
      match edge.label {
        StructuralLabel { label: _ } => InferNotALiteralPayload
        Authored { name: field } =>
          if field == ^integer_literal_magnitude_field { InferIntMagnitudePayload } else { InferNotALiteralPayload }
        Positional => InferNotALiteralPayload
      }
    Accepted { value: DagCanonicalSymbolLiteral { symbol: _ }, diagnostics: _ } =>
      match edge.label {
        Authored { name: field } =>
          if field == ^symbol_literal_name_field { InferSymbolNamePayload } else { InferNotALiteralPayload }
        StructuralLabel { label: _ } => InferNotALiteralPayload
        Positional => InferNotALiteralPayload
      }
    Accepted { value: DagCanonicalBoolLiteral { value: _ }, diagnostics: _ } => InferNotALiteralPayload
    Accepted { value: DagCanonicalStringLiteral { value: _ }, diagnostics: _ } =>
      match edge.label {
        Authored { name: field } =>
          if field == ^string_literal_value_field { InferStringValuePayload } else { InferNotALiteralPayload }
        StructuralLabel { label: _ } => InferNotALiteralPayload
        Positional => InferNotALiteralPayload
      }
    Accepted { value: DagCanonicalFloatLiteral { lexeme: _ }, diagnostics: _ } => InferNotALiteralPayload
    Rejected { diagnostics: _ } => InferNotALiteralPayload
  }
}

// THE EMPTY DOMAIN OF A NULLARY ARROW IS THE EMPTY PRODUCT, AND IT IS GROUNDED BY THE ARROW'S
// POSITION, NOT BY ITS OWN SHAPE. body_lower_domain_from_param_list lowers `fn f()` to an Arrow
// whose domain is a childless Conj: the product of zero parameters. Its resolved type is what
// product introduction yields over zero children, the empty product: a fresh synthetic childless
// Conj. The domain lowering produces carries its parameter list's occurrence, so it is never the
// same node as that evidence. A domain that IS structurally the empty product (a synthetic
// childless Conj) meets the self-evidence wall in canonical_grounding_from_derived_type, and infer
// refuses it rather than typing a node as itself. The standalone childless-Conj rule deliberately
// still refuses (v2.test.claim.execution.infer_product_introduction
// product_introduction_leaves_childless_conj_on_the_frontier_holds): a childless Conj elsewhere
// is not known to be a product of anything, and parse residue has that shape too. What this adds
// is the one position whose meaning the Arrow fixes: its first child, the domain. Before
// 2026-09-23 every nullary fn stayed on the frontier through its domain, so the Arrow and every
// enclosing member did too, and gen-one's translate gate refused it.
fn infer_arrow_empty_domain_edge(parent: Node, edge: Edge, children_remaining: Int) -> Bool {
  match parent.kind {
    TypeNode { connective: Arrow } =>
      (children_remaining == length(xs: parent.children))
        && (edge.label == Positional)
        && infer_empty_product_shape(node: edge.target)
    TypeNode { connective: Atom { identity: _ } } => false
    TypeNode { connective: Conj } => false
    TypeNode { connective: Disj } => false
    TypeNode { connective: Instantiation } => false
    ComputationNode { behavior: _ } => false
  }
}

// THE EMPTY PRODUCT IS A CHILDLESS CONJ. Sum nullary payloads, an Arrow's empty domain, and a
// nullary coproduct-arm reference all ask this one shape; a marker on it must move every consumer.
fn infer_empty_product_shape(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } => length(xs: node.children) == 0
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}

fn infer_empty_product_entry(domain: Node) -> Outcome<InferredFactsEntry> {
  bind_outcome(
    o: inferred_facts_from_derived_type(
      node: domain,
      derived_type: Node {
        kind: TypeNode { connective: Conj },
        children: [],
        occurrence_id: OccurrenceSynthetic
      },
      descent: infer_descent_witness_for_node(n: domain)
    ),
    f: fn(facts) { admitted_inferred_facts_entry(node: domain, facts: facts) }
  )
}

// THE PAYLOAD'S FACTS FOLLOW THE DISCHARGE ABOVE, OR THE TWO DISAGREE. The literal's derivation
// already drops its magnitude subtree's frontier DIAGNOSTICS, and until 2026-09-23 it left that
// subtree's FACTS at GroundingNotDerived. Translate reads facts, not diagnostics, so the payload of
// every accepted int literal (its digit atoms and cons cells) refused emission at
// translate_rejected_grounding_not_derived: gen-one could not emit `data x: Int = 606060`, nor
// `fn f() -> Int { 606060 }`. The payload is the integer authority's canonical decimal
// representation (v2.std.integer integer_decimal_magnitude_node): a fold_list_node of digit atoms.
// So each payload node derives with ITS OWN TYPE in that authority as the resolved type: a digit
// atom is a DecimalDigit (integer_decimal_digit_type_node), and a cons cell or the empty tail is a
// FreeMonoid<DecimalDigit> (integer_decimal_digits_type_node). A symbol literal's payload is its
// name terminal, one childless atom whose identity IS the symbol, so it derives as v2.std.node
// Symbol (symbol_type_node) and never as a digit. The family is the typed InferLiteralPayload the
// edge decision returns, never inferred from the member's shape. The resolved-type field
// is never given the enclosing literal as a record of where the node came from (a meaning fork the
// first cut of this rule had). A payload node of any other shape stays on the frontier. Only the
// edge infer_literal_edge_payload assigns a family reaches here, so a malformed literal keeps
// every child on the frontier.
fn infer_literal_payload_member_type(family: InferLiteralPayload, member: Node) -> Optional<Node> {
  match family {
    InferIntMagnitudePayload =>
      match member.kind {
        TypeNode { connective: Atom { identity: _ } } =>
          optional_present(value: integer_decimal_digit_type_node())
        TypeNode { connective: Conj } =>
          optional_present(value: integer_decimal_digits_type_node())
        TypeNode { connective: Disj } => optional_absent()
        TypeNode { connective: Arrow } => optional_absent()
        TypeNode { connective: Instantiation } => optional_absent()
        ComputationNode { behavior: _ } => optional_absent()
      }
    InferSymbolNamePayload =>
      match member.kind {
        TypeNode { connective: Atom { identity: _ } } =>
          if length(xs: member.children) == 0 { optional_present(value: symbol_type_node()) } else { optional_absent() }
        TypeNode { connective: Conj } => optional_absent()
        TypeNode { connective: Disj } => optional_absent()
        TypeNode { connective: Arrow } => optional_absent()
        TypeNode { connective: Instantiation } => optional_absent()
        ComputationNode { behavior: _ } => optional_absent()
      }
    InferStringValuePayload =>
      match member.kind {
        TypeNode { connective: Atom { identity: _ } } =>
          if length(xs: member.children) == 0 { optional_present(value: host_text_type_node()) } else { optional_absent() }
        _ => optional_absent()
      }
    InferNotALiteralPayload => optional_absent()
  }
}

fn infer_literal_payload_member_facts(family: InferLiteralPayload, member: Node) -> Outcome<InferredFacts> {
  match infer_literal_payload_member_type(family: family, member: member) {
    Present { value: member_type } =>
      inferred_facts_from_derived_type(
        node: member,
        derived_type: member_type,
        descent: infer_descent_witness_for_node(n: member)
      )
    Absent =>
      inferred_facts_not_derived(site: LiteralPayloadMember, node: member, descent: infer_descent_witness_for_node(n: member))
  }
}

fn infer_literal_payload_entries(family: InferLiteralPayload, payload: Node) -> Outcome<Map<Node, List<InferredFacts>>> {
  fold(
    node_subtree_nodes(root: payload),
    init: Accepted { value: empty_map(), diagnostics: None },
    f: fn(acc, member) {
      bind_outcome(
        o: acc,
        f: fn(entries) {
          bind_outcome(
            o: infer_literal_payload_member_facts(family: family, member: member),
            f: fn(facts) {
              bind_outcome(
                o: admitted_inferred_facts_entry(node: member, facts: facts),
                f: fn(entry) {
                  outcome_accepted(value: inferred_facts_index_enter(index: entries, entry: entry))
                }
              )
            }
          )
        }
      )
    }
  )
}

fn infer_gather_acc_awaits_product_row(node: Node, entries: Map<Node, List<InferredFacts>>) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: node) {
        Absent => true
        Present { value: _ } => false
      }
    TypeNode { connective: Arrow } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: node) {
        Absent => true
        Present { value: _ } => false
      }
    TypeNode { connective: Disj } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: node) {
        Absent => true
        Present { value: _ } => false
      }
    TypeNode { connective: Atom { identity: _ } } => false
    TypeNode { connective: Instantiation } => false
    ComputationNode { behavior: _ } => false
  }
}

fn infer_gather_product_row_on_entries(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
  partials: List<Node>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  infer_gather_formed_facts_row(
    node: node,
    formed: infer_formation_facts_from_entries(
      node: node,
      entries: entries,
      partials: partials,
      resolved: resolved
    ),
    entries: entries,
    pending: pending
  )
}

// THE ROW A FORMED NODE ENTERS BY: its facts are admitted and appended, or the node fails with the
// refusal. Product introduction and record introduction form their facts differently and enter the
// same way.
fn infer_gather_formed_facts_row(
  node: Node,
  formed: Outcome<InferredFacts>,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
) -> InferGatherFoldAcc {
  match formed {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: node,
            entries: inferred_facts_index_enter(index: entries, entry: entry),
            pending: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: d),
              inner: ed
            ),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
      }
  }
}

// A PAYLOADLESS ALTERNATIVE IS THE EMPTY PRODUCT, AND IT IS GROUNDED BY ITS SUM, NOT BY ITS OWN
// SHAPE. A coproduct lowers to a Disj whose Named arms carry each alternative's payload, and a
// nullary alternative (`Allowed`) carries a childless Conj: the product of zero fields. The Disj fixes
// that meaning for its Named children the way an Arrow fixes its domain's
// (infer_arrow_empty_domain_edge), and the evidence is the same fresh synthetic empty product
// (infer_empty_product_entry). A childless Conj anywhere else still refuses: parse residue has that
// shape too, and a positional child of a Disj is not an alternative.
fn infer_sum_nullary_payload_edge(parent: Node, edge: Edge) -> Bool {
  match parent.kind {
    TypeNode { connective: Disj } =>
      (match edge.label {
        StructuralLabel { label: _ } => false
        Authored { name: _ } => true
        Positional => false
      })
        && infer_empty_product_shape(node: edge.target)
    _ => false
  }
}

// A DECLARATION'S BINDERS ARE NOT INFERRED. The <type-parameters> edge of a type-declaration wrapper
// (v2.std.type_binder type_decl_view: a generic member, an alias or an opaque declaration) carries the
// declaration's binder Conj -- names the binder authority checks and resolve scopes, not values -- so
// there is no type for its subtree to derive, and an EMPTY binder list is never a unit value. The
// wrapper carries the edge unchanged as its own evidence, the same shape as the Arrow's declared order
// (v2.std.node arrow_signature_order_edge). Asked through the view, never by the label alone, so the marker
// on an Arrow (a fn's type parameters) is not swept in.
fn infer_declaration_binder_edge(parent: Node, edge: Edge) -> Bool {
  declaration_binder_edge(parent: parent, edge: edge)
}

// A SUM IS FORMED ONLY OVER NAMED ALTERNATIVES: a Disj with no children, or with a positional child,
// is not a coproduct this rule knows how to read, and stays on the frontier.
fn infer_disj_is_named_sum(n: Node) -> Bool {
  (length(xs: n.children) > 0)
    && fold(n.children, init: true, f: fn(acc, e) {
      acc && match e.label {
        StructuralLabel { label: _ } => false
        Authored { name: _ } => true
        Positional => false
      }
    })
}

// AN ARROW'S DECLARED ORDER, AND ITS CONTRACT EDGES, ARE NOT INFERRED (contract edges:
// v2.std.node arrow_named_edge_is_contract -- effect claims, execution mode, resource requirements --
// state what the Arrow promises in labels or declaration references, never values). The ^arrow_signature_order_edge's subtree is a list of
// the domain's binder LABELS (v2.std.arrow_signature signature_order_edge), not values: there
// is no type for a label atom to derive, so walking it left every declared Arrow's order atoms on the
// frontier (infer_grounding_not_derived) and the Arrow itself NotDerived. The Arrow carries the edge
// as its own evidence (infer_product_child_evidence_edges), and the gather step below takes nothing
// from its subtree -- the same shape as infer_arrow_empty_domain_edge and the literal payload arm, where
// the parent's model, not the child's walk, says what the child is. The edge is classified by
// v2.std.node arrow_signature_order_edge, the one predicate v2.std.kind's roster index also asks.

// A MATCH ARM'S PATTERN IS A BINDING FORM, NOT A VALUE, so this step carries its edge the way it
// carries a declaration's binders (v2.std.node match_arm_pattern_edge). A fielded pattern is the
// construct shape with binders where a construction has values, and may name any subset of its
// constructor's fields; the match row reads it from the arm, and it is never judged as the
// construction it is shaped like. The same edge is outside v2.std.type_binder
// node_inferred_subtree_nodes.
// A WHERE-REFINEMENT'S PREDICATE CALLS ARE NOT JUDGED AS APPLICATIONS, AND EACH ONE SAYS SO. A predicate
// call (v2.compiler.body_lowering_fold body_lower_kept_where_clause) applies its declaration to the REFINED
// VALUE, which the clause never writes: `type Pos = Int where positive` lowers to a zero-argument call of
// `positive(x: Int)`. Judged as an ordinary named call through application_binding_plan it refuses
// application_positional_deficit on every refinement, and judged with the subject supplied it needs a slot no
// carrier has: which formal is the subject is stated only as an annotation in std.types, and `brand` takes no
// subject at all. So this is the SAME declared frontier RefinementDeclaration.where_clause carries -- the
// where clause is not yet consumed by infer -- extended to the calls inside it, not a second one.
//
// IT IS NOT A RUNG DROP. Before named calls were judged at all, a predicate call was accepted unjudged along
// with every other named call; what this arm keeps is that single shape at that rung, while every other named
// call stays judged (a positional deficit still refuses: v2.test.claim.parameter_reference_test
// pr_ordinary_named_call_deficit_still_refuses). IT IS LOUD, NOT SILENT: each predicate call emits
// inhabitance_undecidable_where_predicate_subject_unmodelled at its own locus, so the population is counted by
// execution over any compiled corpus rather than transcribed here. PARKED, with ONE INTERIM EXCEPTION:
// the literal-only demand (InferLiteralRefinementDemand, operator ruling 2026-10-23) infers a synthetic
// `predicate(literal)` of its own, never these in-clause calls. The 2026-10-02 ruling stands for everything else:
// refinements are being deleted, replaced by checked constructors returning Optional (gunbc.design_ruling where_refinements_retire_for_checked_constructors). NEXT TRIGGER, NAMING THE CAPABILITY: where-refinement clauses are removed from the language in
// favour of checked constructors returning Optional, SUFFICIENT FOR no where-predicate call to reach infer --
// then this arm and its reason are deleted with the clause.
fn infer_where_predicate_set_edge(parent: Node, edge: Edge) -> Bool {
  where_predicate_set_edge(parent: parent, edge: edge)
}

fn infer_where_predicate_calls_unjudged(set: Node) -> Diagnostics {
  fold(set.children, init: None, f: fn(acc, e) {
    diagnostics_merge(
      outer: acc,
      inner: Some {
        diagnostics: diagnostics_singleton(
          d: inhabitance_undecidable_diagnostic(application: e.target, reason: undecidable_where_predicate_subject_unmodelled())
        )
      }
    )
  })
}

fn infer_gather_fold_step(
  acc: InferGatherFoldAcc,
  edge: Edge,
  child: InferGatherFoldAcc,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  if acc.failed {
    acc
  } else if arrow_signature_order_edge(parent: acc.node, edge: edge)
    || arrow_named_edge_is_metadata(e: edge)
    || infer_declaration_binder_edge(parent: acc.node, edge: edge)
    || match_arm_pattern_edge(parent: acc.node, edge: edge)
    || bind_key_edge(parent: acc.node, edge: edge)
    || (resolved_reference_body_kind(target: acc.node) != NotMarkedReference) {
    infer_gather_fold_step_merged(
      acc: acc,
      merged_entries: acc.entries,
      merged_demands: acc.demands,
      merged_pending: acc.pending,
      partials: partials,
      kinds: kinds,
      resolved: resolved
    )
  } else if infer_where_predicate_set_edge(parent: acc.node, edge: edge) {
    infer_gather_fold_step_merged(
      acc: acc,
      merged_entries: acc.entries,
      merged_demands: acc.demands,
      merged_pending: diagnostics_merge(outer: acc.pending, inner: infer_where_predicate_calls_unjudged(set: edge.target)),
      partials: partials,
      kinds: kinds,
      resolved: resolved
    )
  } else if child.failed {
    infer_gather_fold_acc_failed(
      node: acc.node,
      pending: rejected_with_pending(
        pending: acc.pending,
        rejected: infer_gather_failed_non_empty(acc: child)
      ),
      await_branch_row: acc.await_branch_row,
      await_match_row: acc.await_match_row,
      await_loop_row: acc.await_loop_row,
      await_transform_row: acc.await_transform_row,
      children_remaining: acc.children_remaining
    )
  } else if infer_arrow_empty_domain_edge(parent: acc.node, edge: edge, children_remaining: acc.children_remaining)
    || infer_sum_nullary_payload_edge(parent: acc.node, edge: edge) {
    match infer_empty_product_entry(domain: edge.target) {
      Rejected { diagnostics: r } =>
        infer_gather_fold_acc_failed(
          node: acc.node,
          pending: rejected_with_pending(pending: acc.pending, rejected: r),
          await_branch_row: acc.await_branch_row,
          await_match_row: acc.await_match_row,
          await_loop_row: acc.await_loop_row,
          await_transform_row: acc.await_transform_row,
          children_remaining: acc.children_remaining
        )
      Accepted { value: domain_entry, diagnostics: _ } =>
        infer_gather_fold_step_merged(
          acc: acc,
          merged_entries: inferred_facts_index_enter(index: acc.entries, entry: domain_entry),
          merged_demands: acc.demands,
          merged_pending: acc.pending,
          partials: partials,
          kinds: kinds,
          resolved: resolved
        )
    }
  } else {
    infer_gather_fold_step_arm(acc: acc, edge: edge, child: child, partials: partials, kinds: kinds, resolved: resolved)
  }
}

// A settled child either is a branch arm whose root is open (HELD, carrying that open type) or continues unheld.
fn infer_gather_fold_step_arm(
  acc: InferGatherFoldAcc,
  edge: Edge,
  child: InferGatherFoldAcc,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  let open_arm = if acc.await_branch_row && infer_branch_has_arm(branch: acc.node, arm: edge.target) { infer_settled_arm_open_type(settled: child) } else { Absent }
  match open_arm {
    Present { value: open_type } =>
      infer_gather_fold_step_merged(
        acc: infer_gather_with_branch_hold(
          acc: acc,
          hold: InferBranchHold { held: list_snoc_item(xs: acc.branch_hold.held, item: InferHeldArm { edge: edge, settled: child, open_type: open_type }) }
        ),
        merged_entries: acc.entries,
        merged_demands: concat(acc.demands, child.demands),
        merged_pending: acc.pending,
        partials: partials,
        kinds: kinds,
        resolved: resolved
      )
    Absent => infer_gather_fold_step_unheld(acc: acc, edge: edge, child: child, partials: partials, kinds: kinds, resolved: resolved)
  }
}

fn infer_gather_fold_step_unheld(
  acc: InferGatherFoldAcc,
  edge: Edge,
  child: InferGatherFoldAcc,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  if !is_empty(xs: child.branch_hold.held) {
    infer_gather_unresolved_hand_up_refused(acc: acc, child: child)
  } else {
    let family = infer_literal_edge_payload(parent: acc.node, edge: edge)
    match family {
      InferNotALiteralPayload =>
        infer_gather_fold_step_merged(
          acc: acc,
          merged_entries: concat_inferred_facts_entries(a: acc.entries, b: child.entries),
          merged_demands: concat(acc.demands, child.demands),
          merged_pending: diagnostics_merge(outer: acc.pending, inner: child.pending),
          partials: partials,
          kinds: kinds,
          resolved: resolved
        )
      _ =>
        infer_gather_literal_payload_step(acc: acc, edge: edge, family: family, partials: partials, kinds: kinds, resolved: resolved)
    }
  }
}

// One literal payload edge folded into the gather: its members' facts derive for THIS family.
fn infer_gather_literal_payload_step(
  acc: InferGatherFoldAcc,
  edge: Edge,
  family: InferLiteralPayload,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  match infer_literal_payload_entries(family: family, payload: edge.target) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: acc.node,
        pending: rejected_with_pending(pending: acc.pending, rejected: r),
        await_branch_row: acc.await_branch_row,
        await_match_row: acc.await_match_row,
        await_loop_row: acc.await_loop_row,
        await_transform_row: acc.await_transform_row,
        children_remaining: acc.children_remaining
      )
    Accepted { value: payload_entries, diagnostics: _ } =>
      infer_gather_fold_step_merged(
        acc: acc,
        merged_entries: concat_inferred_facts_entries(a: acc.entries, b: payload_entries),
        merged_demands: acc.demands,
        merged_pending: acc.pending,
        partials: partials,
        kinds: kinds,
        resolved: resolved
      )
  }
}

// THE ONE FUNNEL A NODE'S SETTLED ROW IS REACHED THROUGH, so it is the one place the demands its
// children recorded join the row's own: every row below builds its acc from entries alone, and
// infer_gather_acc_with_demands puts the merged demands back on whatever acc the row returned, BESIDE the demands
// that row itself recorded (every row's acc is fresh, so an overwrite would drop the application row's own demand).
fn infer_gather_fold_step_merged(
  acc: InferGatherFoldAcc,
  merged_entries: Map<Node, List<InferredFacts>>,
  merged_demands: List<InferLiteralRefinementDemand>,
  merged_pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  infer_gather_acc_with_demands(
    acc: infer_gather_fold_step_row(
      acc: acc,
      merged_entries: merged_entries,
      merged_pending: merged_pending,
      partials: partials,
      kinds: kinds,
      resolved: resolved
    ),
    demands: merged_demands
  )
}

fn infer_gather_acc_with_demands(acc: InferGatherFoldAcc, demands: List<InferLiteralRefinementDemand>) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: acc.node,
    entries: acc.entries,
    failed: acc.failed,
    pending: acc.pending,
    await_branch_row: acc.await_branch_row,
    await_match_row: acc.await_match_row,
    await_loop_row: acc.await_loop_row,
    await_transform_row: acc.await_transform_row,
    children_remaining: acc.children_remaining,
    declared_position_expected: acc.declared_position_expected,
    rigid_binders: acc.rigid_binders,
    frame_instances: acc.frame_instances,
    demands: concat(acc.demands, demands),
    branch_hold: acc.branch_hold
  }
}

fn infer_gather_fold_step_row(
  acc: InferGatherFoldAcc,
  merged_entries: Map<Node, List<InferredFacts>>,
  merged_pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  let children_remaining = acc.children_remaining - 1
  if acc.await_branch_row && children_remaining == 0 {
    infer_gather_branch_join(acc: acc, merged_entries: merged_entries, merged_pending: merged_pending, partials: partials, kinds: kinds, resolved: resolved)
  } else if acc.await_match_row && children_remaining == 0 {
    infer_gather_match_row_on_entries(
      node: acc.node,
      entries: merged_entries,
      pending: merged_pending,
      partials: partials,
      resolved: resolved,
      expected: acc.declared_position_expected,
      rigid_binders: acc.rigid_binders
    )
  } else if acc.await_loop_row && children_remaining == 0 {
    infer_gather_loop_row_on_entries(
      node: acc.node,
      entries: merged_entries,
      pending: merged_pending,
      partials: partials
    )
  } else if acc.await_transform_row && children_remaining == 0 {
    infer_gather_transform_row_on_entries(
      node: acc.node,
      entries: merged_entries,
      pending: merged_pending,
      partials: partials,
      kinds: kinds,
      resolved: resolved,
      expected: acc.declared_position_expected,
      rigid_binders: acc.rigid_binders
    )
  } else if children_remaining == 0 {
    infer_gather_settled_row(acc: acc, merged_entries: merged_entries, merged_pending: merged_pending, partials: partials, kinds: kinds, resolved: resolved)
  } else {
    infer_gather_with_branch_hold(
      acc: infer_gather_stamp_declared_position_expected(
        acc: infer_gather_fold_acc_ok(
          node: acc.node,
          entries: merged_entries,
          pending: merged_pending,
          await_branch_row: acc.await_branch_row,
          await_match_row: acc.await_match_row,
          await_loop_row: acc.await_loop_row,
          await_transform_row: acc.await_transform_row,
          children_remaining: children_remaining
        ),
        expected: acc.declared_position_expected,
        rigid_binders: acc.rigid_binders,
        frame_instances: acc.frame_instances
      ),
      hold: acc.branch_hold
    )
  }
}

fn infer_gather_with_branch_hold(acc: InferGatherFoldAcc, hold: InferBranchHold) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: acc.node,
    entries: acc.entries,
    failed: acc.failed,
    pending: acc.pending,
    await_branch_row: acc.await_branch_row,
    await_match_row: acc.await_match_row,
    await_loop_row: acc.await_loop_row,
    await_transform_row: acc.await_transform_row,
    children_remaining: acc.children_remaining,
    declared_position_expected: acc.declared_position_expected,
    rigid_binders: acc.rigid_binders,
    frame_instances: acc.frame_instances,
    demands: acc.demands,
    branch_hold: hold
  }
}

// A branch arm is one of the branch node's positional children 1 and 2 (0 is the condition).
fn infer_branch_arm_sibling(branch: Node, arm: Node) -> Optional<Node> {
  let targets = positional_child_target_nodes(node: branch)
  match list_at_optional(xs: targets, index: 1) {
    Absent => Absent
    Present { value: then_target } =>
      match list_at_optional(xs: targets, index: 2) {
        Absent => Absent
        Present { value: else_target } =>
          if node_same_occurrence(a: arm, b: then_target) { Present { value: else_target } }
          else if node_same_occurrence(a: arm, b: else_target) { Present { value: then_target } }
          else { Absent }
      }
  }
}

fn infer_branch_has_arm(branch: Node, arm: Node) -> Bool {
  match infer_branch_arm_sibling(branch: branch, arm: arm) {
    Present { value: _ } => true
    Absent => false
  }
}

// An arm SETTLED UNDERIVED: its root carries no derived type (the only reason a root can lack one is
// infer_grounding_not_derived -- a type state, read off the settled facts, never off the arm's syntax).
fn infer_settled_arm_open_type(settled: InferGatherFoldAcc) -> Optional<Node> {
  if settled.failed {
    Absent
  } else {
    match lookup_inferred_facts_in_entries(entries: settled.entries, key: settled.node) {
      Absent => Absent
      Present { value: facts } =>
        match inferred_facts_resolved_type(facts: facts) {
          Holds { value: t } => if infer_type_is_open(t: t) { Present { value: t } } else { Absent }
          Violates { diagnostic: _ } => Absent
        }
    }
  }
}

type InferHoldResolution {
  entries: Map<Node, List<InferredFacts>>
  pending: Diagnostics
  refused: Optional<NonEmptyDiagnostics>
}

// THE JOIN RESOLVES EACH HELD ARM EXACTLY ONCE (see InferHeldArm).
// NO ARM DECLARES A TYPE HERE: THE ENCLOSING JOIN MAY. The branch's own type is its first held arm's (still open) type and its
// held arms stay held on the accumulator; the consumer either holds this branch as an arm of an enclosing branch (which closes
// it and everything it handed up at its sibling's type) or refuses it as infer_no_arm_declares_a_type
// (infer_gather_unresolved_hand_up_refused).
fn infer_gather_hand_up_failed(node: Node, start: InferHoldResolution, r: NonEmptyDiagnostics) -> InferGatherFoldAcc {
  infer_gather_fold_acc_failed(
    node: node,
    pending: rejected_with_pending(pending: start.pending, rejected: r),
    await_branch_row: false,
    await_match_row: false,
    await_loop_row: false,
    await_transform_row: false,
    children_remaining: 0
  )
}

// THE BRANCH'S OWN ADMISSION BEFORE ITS TYPE IS PUBLISHED: three positional children and a Bool condition. A hand-up
// (infer_gather_branch_hand_up) publishes its first held arm's type without the arm agreement of infer_branch_bool_if_else, but
// never without this judgment, so a non-Bool condition cannot be admitted because an enclosing join closes the arms.
fn infer_branch_condition_refusal(node: Node, entries: Map<Node, List<InferredFacts>>) -> Optional<Diagnostic> {
  if !all_edges_positional(children: node.children) {
    Present { value: infer_branch_shape_invalid_diagnostic(node: node) }
  } else {
    match branch_slot_target(n: node, slot: BranchConditionSlot) {
      Absent => Present { value: infer_branch_shape_invalid_diagnostic(node: node) }
      Present { value: cond_target } =>
        match lookup_inferred_facts_in_entries(entries: entries, key: cond_target) {
          Absent => Present { value: infer_facts_lookup_miss_diagnostic(key: cond_target) }
          Present { value: cond_facts } =>
            if infer_branch_cond_type_is_bool(cond_target: cond_target, cond_facts: cond_facts) { Absent } else { Present { value: infer_branch_cond_not_bool_diagnostic(node: node) } }
        }
    }
  }
}

fn infer_gather_branch_hand_up(acc: InferGatherFoldAcc, start: InferHoldResolution) -> InferGatherFoldAcc {
  match infer_branch_condition_refusal(node: acc.node, entries: start.entries) {
    Present { value: d } => infer_gather_hand_up_failed(node: acc.node, start: start, r: diagnostics_singleton(d: d))
    Absent => infer_gather_branch_hand_up_admitted(acc: acc, start: start)
  }
}

fn infer_gather_branch_hand_up_admitted(acc: InferGatherFoldAcc, start: InferHoldResolution) -> InferGatherFoldAcc {
  match list_at_optional(xs: acc.branch_hold.held, index: 0) {
    Absent => infer_gather_hand_up_failed(node: acc.node, start: start, r: diagnostics_singleton(d: infer_no_arm_declares_a_type_diagnostic(node: acc.node)))
    Present { value: first } =>
      match lookup_inferred_facts_in_entries(entries: first.settled.entries, key: first.settled.node) {
        Absent => infer_gather_hand_up_failed(node: acc.node, start: start, r: diagnostics_singleton(d: infer_no_arm_declares_a_type_diagnostic(node: acc.node)))
        Present { value: first_facts } =>
          match inferred_facts_resolved_type(facts: first_facts) {
            Violates { diagnostic: d } => infer_gather_hand_up_failed(node: acc.node, start: start, r: diagnostics_singleton(d: d))
            Holds { value: first_type } =>
              match infer_descent_witness_for_node(n: acc.node) {
                Violates { diagnostic: d } => infer_gather_hand_up_failed(node: acc.node, start: start, r: diagnostics_singleton(d: d))
                Holds { value: descent_proof } =>
                  match inferred_facts_from_derived_type(node: acc.node, derived_type: first_type, descent: Holds { value: descent_proof }) {
                    Rejected { diagnostics: r } => infer_gather_hand_up_failed(node: acc.node, start: start, r: r)
                    Accepted { value: facts, diagnostics: d } =>
                      match admitted_inferred_facts_entry(node: acc.node, facts: facts) {
                        Rejected { diagnostics: r } => infer_gather_hand_up_failed(node: acc.node, start: start, r: r)
                        Accepted { value: entry, diagnostics: ed } =>
                          infer_gather_with_branch_hold(
                            acc: infer_gather_fold_acc_ok(
                              node: acc.node,
                              entries: inferred_facts_index_enter(index: start.entries, entry: entry),
                              pending: diagnostics_merge(outer: diagnostics_merge(outer: start.pending, inner: d), inner: ed),
                              await_branch_row: false,
                              await_match_row: false,
                              await_loop_row: false,
                              await_transform_row: false,
                              children_remaining: 0
                            ),
                            hold: acc.branch_hold
                          )
                      }
                  }
              }
          }
      }
  }
}

fn infer_gather_unresolved_hand_up_refused(acc: InferGatherFoldAcc, child: InferGatherFoldAcc) -> InferGatherFoldAcc {
  infer_gather_fold_acc_failed(
    node: acc.node,
    pending: rejected_with_pending(pending: acc.pending, rejected: diagnostics_singleton(d: infer_no_arm_declares_a_type_diagnostic(node: child.node))),
    await_branch_row: acc.await_branch_row,
    await_match_row: acc.await_match_row,
    await_loop_row: acc.await_loop_row,
    await_transform_row: acc.await_transform_row,
    children_remaining: acc.children_remaining
  )
}

fn infer_gather_branch_join(
  acc: InferGatherFoldAcc,
  merged_entries: Map<Node, List<InferredFacts>>,
  merged_pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  let start = InferHoldResolution { entries: merged_entries, pending: merged_pending, refused: Absent }
  let handed_up = match acc.declared_position_expected {
    Present { value: _ } => false
    Absent =>
      fold(acc.branch_hold.held, init: false, f: fn(any, h) {
        any || match infer_held_arm_declaring_type(branch: acc.node, held: h, entries: start.entries) {
          Absent => true
          Present { value: _ } => false
        }
      })
  }
  if handed_up {
    infer_gather_branch_hand_up(acc: acc, start: start)
  } else {
  let r = match acc.declared_position_expected {
    Present { value: expected } =>
      match acc.branch_hold.held {
        Empty => start
        Cons { head: _, tail: _ } => infer_judge_branch_arms_at_expected(branch: acc.node, start: start, held: acc.branch_hold.held, expected: expected, resolved: resolved, rigid_binders: acc.rigid_binders)
      }
    Absent =>
      fold(acc.branch_hold.held, init: start, f: fn(cur, h) {
        match cur.refused {
          Present { value: _ } => cur
          Absent => infer_resolve_held_arm(branch: acc.node, cur: cur, held: h, resolved: resolved)
        }
      })
  }
  match r.refused {
    Present { value: refused } =>
      infer_gather_fold_acc_failed(
        node: acc.node,
        pending: rejected_with_pending(pending: r.pending, rejected: refused),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: 0
      )
    Absent =>
      infer_gather_branch_row_on_entries(node: acc.node, entries: r.entries, pending: r.pending, partials: partials, resolved: resolved)
  }
  }
}

// RULE A AT A BRANCH: WITH A DECLARED EXPECTED TYPE, EACH ARM IS JUDGED AGAINST IT, NOT AGAINST ITS SIBLING. The expected type
// reaches the branch through the frame (infer_gather_child_context keeps it across the then/else slots), and a branch holding an
// underived arm resolves every arm at that declared position by the one judge every declared position uses
// (infer_judge_declared_position_closing): a literal arm goes through the ordinary literal-at-expected judgement, a held arm is closed
// at the expected type, and a bare T at a T? position refuses (no implicit lift). The sibling-declaring join
// (infer_resolve_held_arm) is the answer only where there is no expected type to read.
fn infer_judge_branch_arms_at_expected(branch: Node, start: InferHoldResolution, held: List<InferHeldArm>, expected: Node, resolved: ResolvedTree, rigid_binders: List<Symbol>) -> InferHoldResolution {
  let held_entries = fold(held, init: start, f: fn(cur, h) {
    InferHoldResolution {
      entries: concat_inferred_facts_entries(a: cur.entries, b: h.settled.entries),
      pending: diagnostics_merge(outer: cur.pending, inner: h.settled.pending),
      refused: Absent
    }
  })
  fold(positional_child_target_nodes(node: branch), init: held_entries, f: fn(cur, arm) {
    match cur.refused {
      Present { value: _ } => cur
      Absent =>
        if !infer_branch_has_arm(branch: branch, arm: arm) {
          cur
        } else {
          match infer_judge_declared_position_closing(
            position: position_declared_return(),
            application: branch,
            entries: cur.entries,
            declarations: resolved.resolved_declarations,
            bindings: resolved.symbol_index,
            formal: InhabitanceFormal { parameter_identity: ^branch_arm, declared: expected },
            produced_at: arm,
            type_params: Empty,
            instances: infer_no_type_variable_instances(),
            rigid_binders: rigid_binders
          ) {
            Rejected { diagnostics: r } => InferHoldResolution { entries: cur.entries, pending: cur.pending, refused: Present { value: r } }
            Accepted { value: next, diagnostics: d } =>
              InferHoldResolution { entries: next, pending: diagnostics_merge(outer: cur.pending, inner: d), refused: Absent }
          }
        }
    }
  })
}

fn infer_resolve_held_arm(branch: Node, cur: InferHoldResolution, held: InferHeldArm, resolved: ResolvedTree) -> InferHoldResolution {
  match infer_held_arm_declaring_type(branch: branch, held: held, entries: cur.entries) {
    Absent =>
      InferHoldResolution {
        entries: cur.entries,
        pending: cur.pending,
        refused: Present { value: diagnostics_singleton(d: infer_no_arm_declares_a_type_diagnostic(node: branch)) }
      }
    Present { value: declaring } => infer_close_held_arm_at(declaring: declaring, cur: cur, held: held, resolved: resolved)
  }
}

// CLOSE ONE HELD ARM AT THE DECLARING TYPE, THEN EVERY ARM IT HANDED UP. A branch none of whose arms declares a type does not
// refuse (infer_gather_branch_join): it hands its held arms to the enclosing join, so the verdict does not depend on which side
// the declaring sibling stands (Present beside a nested Absent/Absent settles as Absent beside a nested Absent/Present). The
// enclosing join's declaring type then closes the handed-up arms at the same type, once each, by the one closing relation.
fn infer_close_held_arm_at(declaring: Node, cur: InferHoldResolution, held: InferHeldArm, resolved: ResolvedTree) -> InferHoldResolution {
  let own = infer_close_held_root_at(declaring: declaring, cur: cur, held: held, resolved: resolved)
  fold(held.settled.branch_hold.held, init: own, f: fn(acc, handed) {
    match acc.refused {
      Present { value: _ } => acc
      Absent => infer_close_held_arm_at(declaring: declaring, cur: acc, held: handed, resolved: resolved)
    }
  })
}

fn infer_close_held_root_at(declaring: Node, cur: InferHoldResolution, held: InferHeldArm, resolved: ResolvedTree) -> InferHoldResolution {
  match infer_join_arm_types(first: declaring, second: held.open_type, expected: Absent, resolved: resolved) {
    ArmTypesConflict =>
      InferHoldResolution { entries: cur.entries, pending: cur.pending, refused: Present { value: diagnostics_singleton(d: infer_arms_declare_conflicting_types_diagnostic(node: held.settled.node)) } }
    ArmTypesJoined { joined: _ } => infer_close_held_root_closed(declaring: declaring, cur: cur, held: held, resolved: resolved)
    ArmTypesNoneDeclare => InferHoldResolution { entries: cur.entries, pending: cur.pending, refused: Present { value: diagnostics_singleton(d: infer_no_arm_declares_a_type_diagnostic(node: held.settled.node)) } }
  }
}

// THE CLOSURE ITSELF, after the arm-agreement judgment (infer_join_arm_types, the one judgment the non-held join also uses) admitted the arm.
fn infer_close_held_root_closed(declaring: Node, cur: InferHoldResolution, held: InferHeldArm, resolved: ResolvedTree) -> InferHoldResolution {
  let arm_type = held.open_type
          match infer_close_produced_at_declared(declared: declaring, produced: arm_type, instances: Empty, declarations: resolved.resolved_declarations, bindings: resolved.symbol_index) {
            Empty => InferHoldResolution { entries: cur.entries, pending: cur.pending, refused: Present { value: diagnostics_singleton(d: infer_unsolved_constructor_type_variable_diagnostic(node: held.settled.node)) } }
            Cons { head: h0, tail: ht } =>
              match infer_descent_witness_for_node(n: held.settled.node) {
                Violates { diagnostic: d } =>
                  InferHoldResolution { entries: cur.entries, pending: cur.pending, refused: Present { value: diagnostics_singleton(d: d) } }
                Holds { value: descent_proof } =>
                  match inferred_facts_from_derived_type(
                    node: held.settled.node,
                    derived_type: infer_type_instantiated(t: arm_type, instances: Cons { head: h0, tail: ht }),
                    descent: Holds { value: descent_proof }
                  ) {
                    Rejected { diagnostics: r } =>
                      InferHoldResolution { entries: cur.entries, pending: cur.pending, refused: Present { value: r } }
                    Accepted { value: closed_facts, diagnostics: cd } =>
                      InferHoldResolution {
                        entries: map_insert(
                          m: concat_inferred_facts_entries(a: cur.entries, b: held.settled.entries),
                          key: held.settled.node,
                          value: [closed_facts]
                        ),
                        pending: diagnostics_merge(outer: diagnostics_merge(outer: cur.pending, inner: held.settled.pending), inner: cd),
                        refused: Absent
                      }
                  }
              }
          }
}

fn infer_held_arm_declaring_type(branch: Node, held: InferHeldArm, entries: Map<Node, List<InferredFacts>>) -> Optional<Node> {
  match infer_branch_arm_sibling(branch: branch, arm: held.settled.node) {
    Absent => Absent
    Present { value: sibling } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: sibling) {
        Absent => Absent
        Present { value: facts } =>
          match inferred_facts_resolved_type(facts: facts) {
            Holds { value: t } => Present { value: t }
            Violates { diagnostic: _ } => Absent
          }
      }
  }
}


// A RECORD CONSTRUCT IS ITS CONSTRUCTOR APPLIED BY NAME. `R { f: v }` is a Conj whose marked first
// edge targets the constructor's resolved reference (v2.std.node_query construct_tag_optional) and
// whose other edges are the field values. The formals it applies are the fields the record
// DECLARES and the type variables are the record's declared binders. From there it is the
// application's own route: the one binding plan pairs each declared field with the actual that
// fills it (v2.std.arrow_signature application_binding_plan_over), and the one judge decides each
// pair under one instantiation (infer_judge_formal_args). Nothing here compares a type.
//
// TWO READINGS OF ONE DECLARATION, EACH FROM THE INDEX THAT OWNS IT (v2.compiler.resolve
// ResolvedTree). symbol_index, the index resolution consulted, holds a declaration AS AUTHORED: it
// says which paths are records, which fields each declares and which binders it has -- facts about
// NAMES, so the field set is checked for every record a tag can resolve to. resolved_declarations
// holds the subject module's declarations WITH RESOLVED BODIES, and the judge compares resolved
// types, so a record found there is judged field by field. A record declared in another module has
// no resolved body this stage can read: each of its field values is a counted
// UndecidableFormalUnresolved obligation and the construct stays on the frontier -- never compared
// against the authored spelling, which would refuse for the wrong reason. That population and its
// trigger are rostered in gunbc.recurring_failure_mode
// construct_field_value_not_typed_against_the_record_declaration.
//
// ONLY A DECLARED RECORD OR VARIANT ARM IS READ HERE. The index says which kind of payload a path
// denotes (symbol_index_declared_payload_at); a tag the guarded reader does not answer for and a
// Conj with no tag at all are ConstructNotARecord and keep product introduction, where an underived
// tag leaves them on the counted frontier as before. A VARIANT ARM's construct is read at its own
// path (the arm declares the fields) and derives the VARIANT's type: the declaration reference of
// the arm path's parent (v2.compiler.body_lowering_fold variant_fields_unlowered_on_the_native_route
// is retired by this read plus the variant match row beside it).
type InferRecordFormals
  = RecordFormalsResolved { payload: Node }
  | RecordFormalsAuthored { payload: Node }

type InferRecordConstruct {
  record: Node
  path: QualifiedName
  formals: InferRecordFormals
  type_params: List<Symbol>
}

// A variant arm's construct carries the arm path it was read at and the variant path whose
// declaration reference names the construction's type. The arm's fields are the formals; the
// variant's declared type params are the ones its fields may cite.
type InferVariantArmConstruct {
  record: Node
  arm_path: QualifiedName
  variant_path: QualifiedName
  formals: InferRecordFormals
  type_params: List<Symbol>
}

type InferConstructRead
  = ConstructIsRecord { construct: InferRecordConstruct }
  | ConstructIsVariantArm { construct: InferVariantArmConstruct }
  | ConstructVariantArmIdentityUnavailable
  | ConstructVariantArmIdentityContested { claimants: FreeMonoid<QualifiedName> }
  | ConstructVariantArmBodyUnavailable
  | ConstructNotARecord

fn infer_record_formals(resolved: ResolvedTree, path: QualifiedName, authored: Node) -> InferRecordFormals {
  match infer_resolved_lookup(resolved: resolved, path: path) {
    Present { value: declaration } => RecordFormalsResolved { payload: declaration }
    Absent => RecordFormalsAuthored { payload: authored }
  }
}

fn infer_record_formals_payload(formals: InferRecordFormals) -> Node {
  match formals {
    RecordFormalsResolved { payload: payload } => payload
    RecordFormalsAuthored { payload: payload } => payload
  }
}

// THE COPRODUCT IS THE ARM'S DECLARING IDENTITY, NEVER THE PARENT OF ITS SPELLING. A unique-variant
// alias `std.process.ExitFailure` has parent `std.process` (a module). `qualified_name_init` of that
// spelling is not ProcessExit; using it made type_declaration_modifier_row_at look up `std` ×
// `process` and refuse Uncovered. symbol_index_declaring_path_of answers ProcessExit.ExitFailure
// when the index holds the alias's claimant. If that identity is not in the index, refuse — never
// fall back to the spelling's parent.
fn infer_coproduct_path_of_variant_arm(
  index: SymbolIndex,
  arm_path: QualifiedName
) -> Optional<QualifiedName> {
  infer_coproduct_path_of_variant_arm_joined(bindings: index, arm_path: arm_path)
}

// THE COPRODUCT PATH IS THE DECLARING IDENTITY'S PARENT, not a body lookup. Type parameters
// for an applied-open type live on symbol_index at that path. A missing Disj node is
// infer_reason_declaration_body_unavailable at the site that needs the body, not absence of the coproduct.
fn infer_coproduct_path_of_variant_arm_joined(
  bindings: SymbolIndex,
  arm_path: QualifiedName
) -> Optional<QualifiedName> {
  match symbol_index_declaring_path_of(index: bindings, target: arm_path) {
    MentionDeclaringUnavailable => optional_absent()
    MentionDeclaringContested { claimants: _ } => optional_absent()
    MentionDeclaringUnique { declaring: declaring } =>
      match qualified_name_init(qn: declaring) {
        Empty => optional_absent()
        Cons { head: _, tail: _ } =>
          let coproduct = qualified_name_init(qn: declaring)
          if symbol_index_is_module_root_at(index: bindings, qualified_path: coproduct) {
            optional_absent()
          } else {
            optional_present(value: coproduct)
          }
      }
  }
}

fn infer_declaration_identity_unavailable_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_declaration_identity_unavailable,
    at: node_locus(node: at),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn infer_declaration_identity_contested_fatal(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_declaration_identity_contested,
    at: node_locus(node: at),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn infer_declaration_identity_competing_diagnostic(claimant: QualifiedName) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_declaration_identity_competing,
    at: declaration_locus(declaration: claimant),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn infer_declaration_identity_contested_diagnostics(at: Node, claimants: FreeMonoid<QualifiedName>) -> NonEmptyDiagnostics {
  let fatal = infer_declaration_identity_contested_fatal(at: at)
  match claimants {
    Empty => NonEmptyDiagnostics { head: fatal, tail: Empty }
    Cons { head: first, tail: rest } =>
      NonEmptyDiagnostics {
        head: infer_declaration_identity_competing_diagnostic(claimant: first),
        tail: list_snoc_item(
          xs: list_map(xs: rest, f: fn(c) { infer_declaration_identity_competing_diagnostic(claimant: c) }),
          item: fatal
        )
      }
  }
}

fn infer_declaration_identity_contested_rejected<T>(at: Node, claimants: FreeMonoid<QualifiedName>) -> Outcome<T> {
  Rejected { diagnostics: infer_declaration_identity_contested_diagnostics(at: at, claimants: claimants) }
}

fn infer_declaration_body_unavailable_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_declaration_body_unavailable,
    at: node_locus(node: at),
    correction: Unavailable { reason: CorrectionNotModeled }
  }
}

fn infer_variant_arm_construct(
  reference: Node,
  resolved: ResolvedTree,
  declared_path: QualifiedName
) -> InferConstructRead {
  match infer_coproduct_path_of_variant_arm_joined(bindings: resolved.symbol_index, arm_path: declared_path) {
    Absent => ConstructVariantArmIdentityUnavailable
    Present { value: coproduct } =>
      match infer_resolved_lookup(resolved: resolved, path: declared_path) {
        Absent => ConstructVariantArmBodyUnavailable
        Present { value: resolved_decl } =>
          ConstructIsVariantArm {
            construct: InferVariantArmConstruct {
              record: reference,
              arm_path: declared_path,
              variant_path: coproduct,
              formals: infer_record_formals(resolved: resolved, path: declared_path, authored: resolved_decl),
              type_params: symbol_index_declared_type_params_at(
                index: resolved.symbol_index,
                qualified_path: coproduct
              )
            }
          }
      }
  }
}

// A CONSTRUCTION'S TAG IS A RESOLVED REFERENCE, BARE OR QUALIFIED ALIKE: resolve rewrites the tag
// to the declaration it binds (the qualified door and the atom walk meet in resolve_atom_bound, the
// same producer the bare door uses), so the variant's declaring path is the reference's own path --
// no second lookup beside it. Reads go through resolved_declarations: declarations with resolved
// bodies (gunbc#12629). The global bare index is dead as a mechanism (03_resolve at the global_bare
// comment) and names no read here. THE DECLARING PATH OF A VARIANT-ARM PAYLOAD PATH: for the
// variant's own row this is the row itself (no claimants); for its module-level alias the binding
// filed by symbol_index_fill_containment_node answers the variant's declaring path. One authority,
// no parallel carrier map.
fn infer_record_construct_read(node: Node, resolved: ResolvedTree) -> InferConstructRead {
  match construct_tag_optional(n: node) {
    Absent => ConstructNotARecord
    Present { value: reference } =>
      match declaration_reference_path_optional(node: reference) {
        Absent => ConstructNotARecord
        Present { value: path } =>
          match infer_resolved_payload(resolved: resolved, path: path) {
            Absent => ConstructNotARecord
            Present { value: kind } =>
              match kind {
                VariantArmPayload =>
                  match symbol_index_declaring_path_of(
                    index: resolved.symbol_index,
                    target: path
                  ) {
                    MentionDeclaringUnavailable => ConstructVariantArmIdentityUnavailable
                    MentionDeclaringContested { claimants: claimants } =>
                      ConstructVariantArmIdentityContested { claimants: claimants }
                    MentionDeclaringUnique { declaring: declaring } =>
                      infer_variant_arm_construct(
                        reference: reference,
                        resolved: resolved,
                        declared_path: declaring
                      )
                  }
                RecordTypePayload =>
                  match infer_resolved_lookup(resolved: resolved, path: path) {
                    Absent => ConstructNotARecord
                    Present { value: resolved_decl } =>
                      ConstructIsRecord {
                        construct: InferRecordConstruct {
                          record: reference,
                          path: path,
                          formals: infer_record_formals(resolved: resolved, path: path, authored: resolved_decl),
                          type_params: match symbol_index_declaring_path_of(index: resolved.symbol_index, target: path) {
                            MentionDeclaringUnique { declaring: declaring } =>
                              symbol_index_declared_type_params_at(index: resolved.symbol_index, qualified_path: declaring)
                            MentionDeclaringUnavailable => Empty
                            MentionDeclaringContested { claimants: _ } => Empty
                          }
                        }
                      }
                  }
              }
          }
      }
  }
}

// EVERY FIELD-SET REFUSAL NAMES THE RECORD AND THE FIELD. Located at the value for a field the
// record does not declare, names twice, or does not name at all; located at the construct for a
// declared field it leaves out, whose declared type rides beside its name.
fn infer_record_construct_refusal(reason: Symbol, at: Node, record: Node, field: Edge) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: at),
    correction: Suggested {
      node: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge { label: Authored { name: ^inhabitance_record }, target: record, declaration: NotADeclaration },
          field
        ],
        occurrence_id: at.occurrence_id
      }
    }
  }
}

// The binding plan's reasons, said of a record: an unknown label is a field the record does not
// declare, an unfilled slot a declared field left out, a slot filled twice a field named twice. Any
// other plan reason is passed through as it is, never renamed into one of these.
fn infer_record_construct_field_not_declared_reason() -> Symbol {
  ^record_construct_field_not_declared
}

fn infer_record_construct_field_missing_reason() -> Symbol {
  ^record_construct_field_missing
}

fn infer_record_construct_field_bound_twice_reason() -> Symbol {
  ^record_construct_field_bound_twice
}

fn infer_record_construct_binding_reason(plan_reason: Symbol) -> Symbol {
  if plan_reason == ^application_argument_label_unknown {
    infer_record_construct_field_not_declared_reason()
  } else if plan_reason == ^application_positional_deficit {
    infer_record_construct_field_missing_reason()
  } else if plan_reason == ^application_argument_slot_bound_twice {
    infer_record_construct_field_bound_twice_reason()
  } else {
    plan_reason
  }
}

fn infer_record_actual_label_set(actuals: List<Edge>) -> Map<Symbol, Bool> {
  fold(actuals, init: empty_map(), f: fn(m, e) {
    match e.label {
      Authored { name: label } => map_insert(m: m, key: label, value: true)
      StructuralLabel { label: _ } => m
      Positional => m
    }
  })
}

fn infer_record_first_missing_formal(formals: List<InhabitanceFormal>, actuals: List<Edge>) -> Optional<InhabitanceFormal> {
  let named = infer_record_actual_label_set(actuals: actuals)
  fold(formals, init: optional_absent(), f: fn(acc, formal) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match map_lookup(m: named, key: formal.parameter_identity) {
          Present { value: _ } => acc
          Absent => optional_present(value: formal)
        }
    }
  })
}

fn infer_record_first_positional_actual(actuals: List<Edge>) -> Optional<Edge> {
  fold(actuals, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match e.label {
          StructuralLabel { label: _ } => acc
          Positional => optional_present(value: e)
          Authored { name: _ } => acc
        }
    }
  })
}

fn infer_record_construct_binding_refusal(
  node: Node,
  record: Node,
  formals: List<InhabitanceFormal>,
  actuals: List<Edge>,
  plan_reason: Symbol,
  at: Int
) -> Diagnostic {
  let reason = infer_record_construct_binding_reason(plan_reason: plan_reason)
  if plan_reason == ^application_positional_deficit {
    match infer_record_first_missing_formal(formals: formals, actuals: actuals) {
      Present { value: missing } =>
        infer_record_construct_refusal(
          reason: reason,
          at: node,
          record: record,
          field: Edge { label: Authored { name: missing.parameter_identity }, target: missing.declared, declaration: NotADeclaration }
        )
      Absent => application_parameter_order_diagnostic(application: node, reason: application_parameter_order_malformed_reason())
    }
  } else {
    match list_at_optional(xs: actuals, index: at) {
      Present { value: actual } =>
        infer_record_construct_refusal(reason: reason, at: actual.target, record: record, field: actual)
      Absent => application_parameter_order_diagnostic(application: node, reason: application_parameter_order_malformed_reason())
    }
  }
}

// EACH DECLARED FIELD WITH THE VALUE THAT FILLS IT, OR THE REFUSAL. A construct's fields are named,
// so a field edge with no name is refused before the plan could bind it by position. A payload whose
// fields are not all named is not a field set this reads: RecordPayloadUnread, the counted frontier.
type InferRecordFieldBinding
  = RecordFieldsBound { pairs: List<InhabitanceFormalArg> }
  | RecordFieldsRefused { diagnostic: Diagnostic }
  | RecordPayloadUnread

fn infer_record_field_binding(node: Node, record: Node, formals: InferRecordFormals) -> InferRecordFieldBinding {
  match infer_formals_from_domain(domain: infer_record_formals_payload(formals: formals)) {
    Absent => RecordPayloadUnread
    Present { value: formal_list } =>
      let actuals = construct_field_edges(n: node)
      match infer_record_first_positional_actual(actuals: actuals) {
        Present { value: unnamed } =>
          RecordFieldsRefused {
            diagnostic: infer_record_construct_refusal(
              reason: ^record_construct_field_not_named,
              at: unnamed.target,
              record: record,
              field: unnamed
            )
          }
        Absent =>
          match application_binding_plan_over(labels: list_map(xs: formal_list, f: infer_formal_identity_key), actuals: actuals) {
            ApplicationBindingRefused { reason: reason, at: at } =>
              RecordFieldsRefused {
                diagnostic: infer_record_construct_binding_refusal(
                  node: node,
                  record: record,
                  formals: formal_list,
                  actuals: actuals,
                  plan_reason: reason,
                  at: at
                )
              }
            ApplicationBound { slots: slots } =>
              RecordFieldsBound { pairs: infer_formal_args_by_plan(formals: formal_list, slots: slots, actuals: actuals) }
          }
      }
  }
}

// RECORD INTRODUCTION IS NOMINAL. A construct whose every field value inhabits its declared field is
// a value of the DECLARED record, so its type is the record's declaration reference -- instantiated
// at the type each declared binder took from the field values, in binder order, when the record is
// generic (the carrier infer_freemonoid_type_of builds for a list) -- and never the product of its
// field types, which would make two records with the same fields one type. It derives only when
// every field obligation was decided and every binder was instantiated: a construct with a counted
// field obligation, or a binder no field value fixed, stays on the frontier, exactly as an
// application does (infer_transform_derived_optional arguments_decided).
// THE CONSTRUCTED TYPE WITH EACH TYPE PARAMETER LEFT AS ITS OWN VARIABLE: `Box<T>` for `Box { .. }`. The
// expected type at the construct's position matches against it (infer_match_generic_formal) to seed
// the instantiation, so `Box { items: [] }` at `Box<Int>` fixes T before any field is judged -- the same
// walk an application's declared return takes (infer_expected_return_seed).
fn infer_record_construct_pattern(type_path: QualifiedName, type_params: List<Symbol>) -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: fold(
      type_params,
      init: [Edge { label: Positional, target: declaration_reference_node(qn: type_path, occurrence_id: OccurrenceSynthetic), declaration: NotADeclaration }],
      f: fn(edges, binder) {
        list_snoc_item(
          xs: edges,
          item: Edge { label: Positional, target: Node { kind: TypeNode { connective: Atom { identity: binder } }, children: [], occurrence_id: OccurrenceSynthetic }, declaration: NotADeclaration }
        )
      }
    ),
    occurrence_id: OccurrenceSynthetic
  }
}

fn infer_record_construct_type(
  type_path: QualifiedName,
  type_params: List<Symbol>,
  instances: List<TypeVariableInstance>,
  decided: Bool
) -> Optional<Node> {
  if !decided {
    optional_absent()
  } else {
    let reference = declaration_reference_node(qn: type_path, occurrence_id: OccurrenceSynthetic)
    if length(xs: type_params) == 0 {
      optional_present(value: reference)
    } else {
      match fold(
        type_params,
        init: optional_present(value: [Edge { label: Positional, target: reference, declaration: NotADeclaration }]),
        f: fn(acc, binder) {
          match acc {
            Absent => acc
            Present { value: edges } =>
              match type_variable_instance_lookup(instances: instances, binder: binder) {
                Absent => optional_absent()
                Present { value: instance } =>
                  optional_present(
                    value: list_snoc_item(
                      xs: edges,
                      item: Edge { label: Positional, target: canonicalize_node_strip_provenance(n: instance), declaration: NotADeclaration }
                    )
                  )
              }
          }
        }
      ) {
        Absent => optional_absent()
        Present { value: edges } =>
          optional_present(
            value: Node {
              kind: TypeNode { connective: Instantiation },
              children: edges,
              occurrence_id: OccurrenceSynthetic
            }
          )
      }
    }
  }
}

type InferConstructedFacts {
  facts: InferredFacts
  entries: Map<Node, List<InferredFacts>>
  demands: List<InferLiteralRefinementDemand>
}

fn infer_constructed_from_facts(inner: Outcome<InferredFacts>, entries: Map<Node, List<InferredFacts>>) -> Outcome<InferConstructedFacts> {
  infer_constructed_from_facts_demanding(inner: inner, entries: entries, demands: Empty)
}

fn infer_constructed_from_facts_demanding(
  inner: Outcome<InferredFacts>,
  entries: Map<Node, List<InferredFacts>>,
  demands: List<InferLiteralRefinementDemand>,
) -> Outcome<InferConstructedFacts> {
  match inner {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: facts, diagnostics: d } =>
      Accepted { value: InferConstructedFacts { facts: facts, entries: entries, demands: demands }, diagnostics: d }
  }
}

// AFTER THE CONSTRUCT'S INSTANCES ARE SOLVED, FIELD VALUES CARRY THE INSTANTIATED TYPE. The child's
// first entry was the open applied coproduct (infer_coproduct_type_applied_open); inferred_facts_index_enter
// keeps that first entry, so a later snoc cannot displace it. This replaces the entry in place at the
// construct that knows the solution — one write, not a second reading. Emission and census then see
// FsList<Int>, not an unsolved T.
fn infer_entry_instantiate(entry: InferredFactsEntry, instances: List<TypeVariableInstance>) -> Outcome<InferredFactsEntry> {
  match instances {
    Empty => outcome_accepted(value: entry)
    Cons { head: _, tail: _ } =>
      match inferred_facts_resolved_type(facts: entry.facts) {
        Violates { diagnostic: _ } => outcome_accepted(value: entry)
        Holds { value: produced } =>
          match inferred_facts_from_derived_type(
            node: entry.node,
            derived_type: infer_type_instantiated(t: produced, instances: instances),
            descent: entry.facts.descent
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: next, diagnostics: d } =>
              Accepted {
                value: InferredFactsEntry {
                  node: entry.node,
                  facts: InferredFacts {
                    grounding: next.grounding,
                    descent: next.descent,
                    denotation: entry.facts.denotation,
                    type_instances: entry.facts.type_instances
                  }
                },
                diagnostics: d
              }
          }
      }
  }
}

fn infer_entries_instantiate_at(entries: Map<Node, List<InferredFacts>>, key: Node, instances: List<TypeVariableInstance>) -> Outcome<Map<Node, List<InferredFacts>>> {
  match map_lookup(m: entries, key: key) {
    Absent => Accepted { value: entries, diagnostics: None }
    Present { value: xs } =>
      match fold_list(xs: xs, empty: Accepted { value: [], diagnostics: None }, cons: fn(acc, facts) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: done, diagnostics: pd } =>
            match infer_entry_instantiate(entry: InferredFactsEntry { node: key, facts: facts }, instances: instances) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: e, diagnostics: d } =>
                match admitted_inferred_facts_entry(node: key, facts: e.facts) {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: admitted, diagnostics: ad } =>
                    Accepted {
                      value: list_snoc_item(xs: done, item: admitted.facts),
                      diagnostics: diagnostics_merge(outer: diagnostics_merge(outer: pd, inner: d), inner: ad)
                    }
                }
            }
        }
      }) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: next, diagnostics: d } =>
          Accepted { value: map_insert(m: entries, key: key, value: next), diagnostics: d }
      }
  }
}

fn infer_entries_instantiate_actuals(entries: Map<Node, List<InferredFacts>>, pairs: List<InhabitanceFormalArg>, instances: List<TypeVariableInstance>) -> Outcome<Map<Node, List<InferredFacts>>> {
  fold(pairs, init: Accepted { value: entries, diagnostics: None }, f: fn(acc, pair) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: es, diagnostics: pd } =>
        match infer_entries_instantiate_at(entries: es, key: pair.arg, instances: instances) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: next, diagnostics: d } =>
            Accepted { value: next, diagnostics: diagnostics_merge(outer: pd, inner: d) }
        }
    }
  })
}

fn infer_record_construct_facts(
  node: Node,
  construct: InferRecordConstruct,
  entries: Map<Node, List<InferredFacts>>,
  declarations: SymbolIndex,
  bindings: SymbolIndex,
  partials: List<Node>,
  expected: Optional<Node>,
  rigid_binders: List<Symbol>,
) -> Outcome<InferConstructedFacts> {
  infer_construct_facts_on_entries(
    node: node,
    record: construct.record,
    formals: construct.formals,
    type_path: construct.path,
    type_params: construct.type_params,
    entries: entries,
    declarations: declarations,
    bindings: bindings,
    partials: partials,
    expected: expected,
    rigid_binders: rigid_binders
  )
}

// A VARIANT ARM's construction derives the VARIANT's type (the arm path's parent declaration
// reference), with the arm's fields as the formals: `Boxed(41)` is a value of `Seal`, judged at the
// arm the construction names (v2.compiler.infer infer_record_construct_read reads the arm's path).
fn infer_variant_construct_facts(
  node: Node,
  construct: InferVariantArmConstruct,
  entries: Map<Node, List<InferredFacts>>,
  declarations: SymbolIndex,
  bindings: SymbolIndex,
  partials: List<Node>,
  expected: Optional<Node>,
  rigid_binders: List<Symbol>,
) -> Outcome<InferConstructedFacts> {
  infer_construct_facts_on_entries(
    node: node,
    record: construct.record,
    formals: construct.formals,
    type_path: construct.variant_path,
    type_params: construct.type_params,
    entries: entries,
    declarations: declarations,
    bindings: bindings,
    partials: partials,
    expected: expected,
    rigid_binders: rigid_binders
  )
}

fn infer_construct_facts_on_entries(
  node: Node,
  record: Node,
  formals: InferRecordFormals,
  type_path: QualifiedName,
  type_params: List<Symbol>,
  entries: Map<Node, List<InferredFacts>>,
  declarations: SymbolIndex,
  bindings: SymbolIndex,
  partials: List<Node>,
  expected: Optional<Node>,
  rigid_binders: List<Symbol>,
) -> Outcome<InferConstructedFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: node) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          match infer_record_field_binding(node: node, record: record, formals: formals) {
            RecordFieldsRefused { diagnostic: d } => outcome_rejected(d)
            RecordPayloadUnread =>
              infer_constructed_from_facts(
                inner: bind_outcome_accepted(od: cd, inner: inferred_facts_not_derived(site: ConstructFieldsUnbound, node: node, descent: Holds { value: descent_proof })),
                entries: entries
              )
            RecordFieldsBound { pairs: pairs } =>
              match formals {
                RecordFormalsAuthored { payload: _ } =>
                  infer_constructed_from_facts(
                    inner: bind_outcome_accepted(
                      od: diagnostics_merge(outer: cd, inner: infer_record_fields_unresolved_diagnostics(pairs: pairs)),
                      inner: inferred_facts_not_derived(site: ConstructFormalsAuthored, node: node, descent: Holds { value: descent_proof })
                    ),
                    entries: entries
                  )
                RecordFormalsResolved { payload: _ } =>
                  match infer_judge_formal_args(
                    position: position_record_field(record: record),
                    site: JudgedAtConstruct { pattern: infer_record_construct_pattern(type_path: type_path, type_params: type_params) },
                    entries: infer_entries_with_construct_callback_arity_refutations(pairs: pairs, type_params: type_params, entries: entries, declarations: declarations, bindings: bindings),
                    declarations: declarations,
                    bindings: bindings,
                    pairs: infer_pairs_callbacks_last(pairs: pairs),
                    type_params: type_params,
                    expected: expected,
                    rigid_binders: rigid_binders
                  ) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: instances, diagnostics: jd } =>
                      match infer_entries_instantiate_actuals(entries: entries, pairs: pairs, instances: instances) {
                        Rejected { diagnostics: r } => Rejected { diagnostics: r }
                        Accepted { value: instantiated_entries, diagnostics: id } =>
                          infer_constructed_from_facts_demanding(
                            inner: bind_outcome_accepted(
                              od: diagnostics_merge(outer: diagnostics_merge(outer: cd, inner: jd), inner: id),
                              inner: match infer_record_construct_type(
                                type_path: type_path,
                                type_params: type_params,
                                instances: instances,
                                decided: infer_diagnostics_none(d: jd)
                              ) {
                                Present { value: record_type } =>
                                  inferred_facts_from_derived_type(
                                    node: node,
                                    derived_type: record_type,
                                    descent: Holds { value: descent_proof }
                                  )
                                Absent =>
                                  inferred_facts_not_derived(site: ConstructTypeAbsent, node: node, descent: Holds { value: descent_proof })
                              }
                            ),
                            entries: instantiated_entries,
                            demands: infer_pairs_literal_demands(
                              position: position_record_field(record: record),
                              site: JudgedAtEachActual,
                              pairs: pairs,
                              entries: entries,
                              declarations: declarations,
                              bindings: bindings
                            )
                          )
                      }
                  }
              }
          }
      }
  }
}

// One counted obligation per field value of a record whose declaration this stage holds only as
// authored, located at the value it would have judged.
fn infer_record_fields_unresolved_diagnostics(pairs: List<InhabitanceFormalArg>) -> Diagnostics {
  fold(pairs, init: None, f: fn(acc, pair) {
    diagnostics_merge(
      outer: acc,
      inner: Some {
        diagnostics: diagnostics_singleton(
          d: inhabitance_undecidable_diagnostic(application: pair.arg, reason: undecidable_formal_unresolved())
        )
      }
    )
  })
}

fn infer_gather_constructed_facts_row(
  node: Node,
  formed: Outcome<InferConstructedFacts>,
  pending: Diagnostics,
) -> InferGatherFoldAcc {
  match formed {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: 0
      )
    Accepted { value: row, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: row.facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_acc_with_demands(
            acc: infer_gather_fold_acc_ok(
              node: node,
              entries: inferred_facts_index_enter(index: row.entries, entry: entry),
              pending: diagnostics_merge(
                outer: diagnostics_merge(outer: pending, inner: d),
                inner: ed
              ),
              await_branch_row: false,
              await_match_row: false,
              await_loop_row: false,
              await_transform_row: false,
              children_remaining: 0
            ),
            demands: row.demands
          )
      }
  }
}

fn infer_gather_record_construct_row_on_entries(
  node: Node,
  construct: InferRecordConstruct,
  entries: Map<Node, List<InferredFacts>>,
  declarations: SymbolIndex,
  bindings: SymbolIndex,
  pending: Diagnostics,
  partials: List<Node>,
  expected: Optional<Node>,
  rigid_binders: List<Symbol>,
) -> InferGatherFoldAcc {
  infer_gather_constructed_facts_row(
    node: node,
    formed: infer_record_construct_facts(node: node, construct: construct, entries: entries, declarations: declarations, bindings: bindings, partials: partials, expected: expected, rigid_binders: rigid_binders),
    pending: pending
  )
}

fn infer_gather_variant_construct_row_on_entries(
  node: Node,
  construct: InferVariantArmConstruct,
  entries: Map<Node, List<InferredFacts>>,
  declarations: SymbolIndex,
  bindings: SymbolIndex,
  pending: Diagnostics,
  partials: List<Node>,
  expected: Optional<Node>,
  rigid_binders: List<Symbol>,
) -> InferGatherFoldAcc {
  infer_gather_constructed_facts_row(
    node: node,
    formed: infer_variant_construct_facts(node: node, construct: construct, entries: entries, declarations: declarations, bindings: bindings, partials: partials, expected: expected, rigid_binders: rigid_binders),
    pending: pending
  )
}

// THE LAST CHILD OF A NODE NO BEHAVIOR ROW AWAITED. An annotated Bind (v2.std.type_binder
// type_annotation_optional) checks its bound value against the annotation; a product or Arrow still
// missing its own entry takes the product row; anything else stays as folded.
fn infer_gather_settled_row(
  acc: InferGatherFoldAcc,
  merged_entries: Map<Node, List<InferredFacts>>,
  merged_pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  if infer_bind_encodes_collection_fold(bind: acc.node) {
    infer_gather_fold_bind_row_on_entries(node: acc.node, entries: merged_entries, pending: merged_pending, partials: partials, kinds: kinds, resolved: resolved, rigid_binders: acc.rigid_binders)
  } else {
  match type_annotation_optional(n: acc.node) {
    Present { value: _ } =>
      infer_gather_bind_annotation_row_on_entries(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        partials: partials,
        kinds: kinds,
        resolved: resolved,
        rigid_binders: acc.rigid_binders
      )
    Absent =>
      if infer_is_let_bind(bind: acc.node) {
        match infer_unannotated_let_unsolved_refusal(node: acc.node, entries: merged_entries, resolved: resolved) {
          Rejected { diagnostics: r } =>
            infer_gather_fold_acc_failed(
              node: acc.node,
              pending: rejected_with_pending(pending: merged_pending, rejected: r),
              await_branch_row: false,
              await_match_row: false,
              await_loop_row: false,
              await_transform_row: false,
              children_remaining: 0
            )
          Accepted { value: next, diagnostics: _ } =>
            infer_gather_let_result_row(node: acc.node, entries: next, pending: merged_pending, partials: partials, kinds: kinds, resolved: resolved, rigid_binders: acc.rigid_binders)
        }
      } else {
      match infer_declared_position_check(node: acc.node, entries: merged_entries, declarations: resolved.resolved_declarations, bindings: resolved.symbol_index, rigid_binders: acc.rigid_binders, instances: acc.frame_instances) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: acc.node,
            pending: rejected_with_pending(pending: merged_pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
        Accepted { value: next, diagnostics: rd } =>
          infer_gather_settled_unannotated_row(
            acc: acc,
            merged_entries: next,
            merged_pending: diagnostics_merge(outer: merged_pending, inner: rd),
            partials: partials,
            resolved: resolved
          )
      }
      }
  }
  }
}

// THE DECLARED POSITIONS A SETTLED NODE OWES: a binder node's default is judged at the binder's declared
// type (infer_binder_default_check), and an Arrow's body at its declared return
// (infer_arrow_declared_return_check). Any other node owes nothing here.
fn infer_declared_position_check(node: Node, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex, rigid_binders: List<Symbol>, instances: List<TypeVariableInstance>) -> Outcome<Map<Node, List<InferredFacts>>> {
  match binder_node_parts(n: node) {
    Present { value: parts } => infer_binder_default_check(parts: parts, entries: entries, declarations: declarations, bindings: bindings, rigid_binders: rigid_binders)
    Absent =>
      bind_outcome(o: infer_generic_default_refusal(node: node), f: fn(_) {
        infer_arrow_declared_return_check(node: node, entries: entries, declarations: declarations, bindings: bindings, rigid_binders: rigid_binders, instances: instances)
      })
  }
}

// A DEFAULT UNDER A GENERIC DECLARATION REFUSES, LOCATED AT THE DEFAULT, until it is modeled
// (^infer_binder_default_generic_unmodeled; side-chat review on #12948). A default's binder node does not
// see its declaration's type parameters, and judged without them a default typed by one lands in
// InhabitanceUndecidable, which is an advisory acceptance -- fail-open. So the declaration that owns the
// type parameters -- a generic Arrow over its domain, a generic type declaration over its member --
// refuses each defaulted binder it carries. A non-generic declaration owes nothing here, and its
// defaults are judged at their binder (infer_binder_default_check).
fn infer_generic_default_refusal(node: Node) -> Outcome<Bool> {
  match type_param_names(n: node) {
    Empty => outcome_accepted(true)
    Cons { head: _, tail: _ } =>
      match infer_first_default_beneath(nodes: infer_declared_binder_scope(node: node)) {
        Absent => outcome_accepted(true)
        Present { value: default } => outcome_rejected(infer_binder_default_generic_unmodeled_diagnostic(default: default))
      }
  }
}

// THE SUBTREE A GENERIC DECLARATION'S TYPE PARAMETERS GOVERN: an Arrow's domain, or a generic type
// declaration's member. A default anywhere beneath it -- an immediate binder, or one nested in a record
// type, a coproduct arm's payload or an inline record -- is under those type parameters (side-chat review
// on #12948: `type Box<T> = Full { value: T = 1 } | Empty` nests its default in the Full payload).
fn infer_declared_binder_scope(node: Node) -> List<Node> {
  match node.kind {
    TypeNode { connective: Arrow } =>
      match list_at_optional(xs: positional_child_target_nodes(node: node), index: 0) {
        Present { value: domain } => [domain]
        Absent => []
      }
    _ =>
      match type_decl_view(target: node) {
        GenericTypeDecl { binders: _, member: m } => [m]
        _ => []
      }
  }
}

// The first binder default beneath the given nodes, in one depth-first traversal bounded to them.
fn infer_first_default_beneath(nodes: List<Node>) -> Optional<Node> {
  fold(nodes, init: optional_absent(), f: fn(acc, n) {
    match acc {
      Present { value: _ } => acc
      Absent => infer_first_default_in(node: n)
    }
  })
}

fn infer_first_default_in(node: Node) -> Optional<Node> {
  match binder_node_parts(n: node) {
    Present { value: parts } =>
      match parts.default {
        Present { value: d } => optional_present(value: d)
        Absent => infer_first_default_under(node: node)
      }
    Absent => infer_first_default_under(node: node)
  }
}

fn infer_first_default_under(node: Node) -> Optional<Node> {
  fold(node.children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => infer_first_default_in(node: e.target)
    }
  })
}

fn infer_binder_default_generic_unmodeled_diagnostic(default: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_binder_default_generic_unmodeled,
    at: node_locus(node: default),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// A BINDER'S DEFAULT IS JUDGED AT THE BINDER'S DECLARED TYPE (XL-2 PR2c-ii), through the same judge --
// and so the same relation -- an argument meets at its formal and a body at its declared return: the
// default must inhabit the type an omitted argument or field is declared to have. A binder with no
// default owes nothing. The default is judged with no type variables in scope, so a default whose
// type mentions the declaring Arrow's own type parameter does not inhabit an unrelated type by
// accident: it is refused, located at the default, not assumed.
fn infer_binder_default_check(parts: BinderParts, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex, rigid_binders: List<Symbol>) -> Outcome<Map<Node, List<InferredFacts>>> {
  match parts.default {
    Absent => outcome_accepted(entries)
    Present { value: default } =>
      infer_judge_declared_position_closing(
        position: position_binder_default(default: default),
        application: default,
        entries: entries,
        declarations: declarations,
        bindings: bindings,
        formal: InhabitanceFormal { parameter_identity: ^binder_default, declared: parts.type_node },
        produced_at: default,
        type_params: [],
        instances: infer_no_type_variable_instances(),
        rigid_binders: rigid_binders
      )
  }
}

// AN ARROW'S BODY IS JUDGED AT ITS DECLARED RETURN. A fn lowers to an Arrow whose second positional
// child is the declared return and whose ^arrow_body_edge is the body
// (v2.compiler.body_lowering_fold body_lower_fn_decl_arrow). By the Arrow's settled row every child
// has folded, so the body's derived type is in `entries`, and the body is judged at the declared
// return through the same judge -- and so the same relation -- an argument meets at its formal. The
// Arrow's own type parameters are the obligation's type variables: a return that mentions one stays
// UndecidableGenericFormal, counted. An Arrow with no body is a signature (a fn type, a census-grade
// declaration) and owes nothing here; one with two bodies, or a body but no declared return, is a
// malformed Arrow and refuses.
// A FUNCTION VALUE'S UNWRITTEN RETURN OWES NOTHING: lowering minted a fresh variable for it, and that variable MEANS
// the body's type (infer_function_value_facts reads it so), so judging the body against it only re-states the
// definition -- generically, as an undecidable obligation. An authored return is judged at the frame the value was
// entered under, so a return mentioning a fresh input is read at that input's instance.
fn infer_arrow_declared_return_check(node: Node, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex, rigid_binders: List<Symbol>, instances: List<TypeVariableInstance>) -> Outcome<Map<Node, List<InferredFacts>>> {
  match node.kind {
    TypeNode { connective: Arrow } =>
      match arrow_body_target_lookup(children: node.children) {
        Ambiguous => outcome_rejected(infer_arrow_declared_return_shape_diagnostic(node: node))
        Found { target: body } =>
          match list_at_optional(xs: positional_child_target_nodes(node: node), index: 1) {
            Absent => outcome_rejected(infer_arrow_declared_return_shape_diagnostic(node: node))
            Present { value: declared } =>
              if infer_node_is_function_value(n: node) && infer_callback_type_is_fresh(t: declared, callback: node) {
                outcome_accepted(entries)
              } else {
              infer_judge_declared_position_closing(
                position: position_declared_return(),
                application: body,
                entries: entries,
                declarations: declarations,
                bindings: bindings,
                formal: InhabitanceFormal { parameter_identity: ^declared_return, declared: infer_type_instantiated(t: declared, instances: instances) },
                produced_at: body,
                type_params: type_param_names(n: node),
                instances: instances,
                rigid_binders: rigid_binders
              )
              }
          }
        _ => outcome_accepted(entries)
      }
    _ => outcome_accepted(entries)
  }
}

fn infer_arrow_declared_return_shape_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_arrow_declared_return_shape_invalid,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// THE RESOLVED CARRIER REACHES THIS ROW BECAUSE THE PRODUCT ROW BENEATH IT ANSWERS A FIELD
// PROJECTION FIRST, and a projection needs the receiver's DECLARATION, which only the index in
// ResolvedTree supplies (infer_formation_facts_from_entries). Main introduced this row when it split
// the declared-return check out of infer_gather_settled_row; this lane had widened the product row it
// delegates to. The two are compatible -- the enclosing row already holds `resolved` -- and the
// parameter is threaded rather than reconstructed, so there is one carrier for the whole fold.
fn infer_gather_settled_unannotated_row(
  acc: InferGatherFoldAcc,
  merged_entries: Map<Node, List<InferredFacts>>,
  merged_pending: Diagnostics,
  partials: List<Node>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
      if infer_gather_acc_awaits_product_row(node: acc.node, entries: merged_entries) {
        match infer_record_construct_read(node: acc.node, resolved: resolved) {
          ConstructIsRecord { construct: construct } =>
            infer_gather_record_construct_row_on_entries(
              node: acc.node,
              construct: construct,
              entries: merged_entries,
              declarations: resolved.resolved_declarations,
              bindings: resolved.symbol_index,
              pending: merged_pending,
              partials: partials,
              expected: acc.declared_position_expected,
              rigid_binders: acc.rigid_binders
            )
          ConstructIsVariantArm { construct: construct } =>
            infer_gather_variant_construct_row_on_entries(
              node: acc.node,
              construct: construct,
              entries: merged_entries,
              declarations: resolved.resolved_declarations,
              bindings: resolved.symbol_index,
              pending: merged_pending,
              partials: partials,
              expected: acc.declared_position_expected,
              rigid_binders: acc.rigid_binders
            )
          ConstructVariantArmIdentityUnavailable =>
            infer_gather_fold_acc_failed(
              node: acc.node,
              pending: diagnostics_singleton(d: infer_declaration_identity_unavailable_diagnostic(at: acc.node)),
              await_branch_row: acc.await_branch_row,
              await_match_row: acc.await_match_row,
              await_loop_row: acc.await_loop_row,
              await_transform_row: acc.await_transform_row,
              children_remaining: acc.children_remaining
            )
          ConstructVariantArmIdentityContested { claimants: claimants } =>
            infer_gather_fold_acc_failed(
              node: acc.node,
              pending: infer_declaration_identity_contested_diagnostics(at: acc.node, claimants: claimants),
              await_branch_row: acc.await_branch_row,
              await_match_row: acc.await_match_row,
              await_loop_row: acc.await_loop_row,
              await_transform_row: acc.await_transform_row,
              children_remaining: acc.children_remaining
            )
          ConstructVariantArmBodyUnavailable =>
            infer_gather_fold_acc_failed(
              node: acc.node,
              pending: diagnostics_singleton(d: infer_declaration_body_unavailable_diagnostic(at: acc.node)),
              await_branch_row: acc.await_branch_row,
              await_match_row: acc.await_match_row,
              await_loop_row: acc.await_loop_row,
              await_transform_row: acc.await_transform_row,
              children_remaining: acc.children_remaining
            )
          ConstructNotARecord =>
            if infer_node_is_function_value(n: acc.node) {
              infer_gather_formed_facts_row(
                node: acc.node,
                formed: infer_function_value_facts(node: acc.node, entries: merged_entries, instances: acc.frame_instances),
                entries: merged_entries,
                pending: merged_pending
              )
            } else {
              infer_gather_product_row_on_entries(
                node: acc.node,
                entries: merged_entries,
                pending: merged_pending,
                partials: partials,
                resolved: resolved
              )
            }
        }
      } else {
        infer_gather_stamp_declared_position_expected(
          acc: infer_gather_fold_acc_ok(
            node: acc.node,
            entries: merged_entries,
            pending: merged_pending,
            await_branch_row: acc.await_branch_row,
            await_match_row: acc.await_match_row,
            await_loop_row: acc.await_loop_row,
            await_transform_row: acc.await_transform_row,
            children_remaining: 0
          ),
          expected: acc.declared_position_expected,
          rigid_binders: acc.rigid_binders,
          frame_instances: acc.frame_instances
        )
      }
}

// THE STAGE'S ONE WALK IS A DEPENDENT-CHILD FOLD (v2.std.node fold_node_dependent), because one behavior
// row needs a sibling's settled result before its other child can be judged: a collection fold's step
// member formal is the fresh type variable function-value lowering minted, and only the Loop DOMAIN's
// synthesized type says what it stands for (gunbc.recurring_failure_mode
// infer_child_context_cannot_depend_on_a_sibling_result). So a fold-realized Loop folds its domain FIRST and
// its step under a frame that instantiates that variable; every other node keeps its authored order and
// hands its children the frame it was given, unchanged, which is fold_node's walk exactly.
// THE FRAME IS LEXICAL AND SCOPED TO THE STEP SUBTREE. It is the same List<TypeVariableInstance> an
// application instantiates its callee's parameters with (v2.std.inhabitance), read at the one place a
// binder's declared type becomes a reference's type (infer_lexical_reference_facts); no second fact about
// the binder is minted, and no other route types a parameter.
type InferFrame {
  instances: List<TypeVariableInstance>
  binder_types: List<InferBinderType>
  entering: InferFrameEntry
  declared_position_expected: Optional<Node>
  rigid_binders: List<Symbol>
}

// A MATCH-PAYLOAD BINDER'S TYPE, KEYED BY ITS BINDER SITE. Resolve records only that a payload binder is
// owed its field's declared type (LexicalOwedFormal); the type itself needs the scrutinee's instantiated
// arguments, which exist only once the scrutinee has settled, so it is minted at arm entry and read at
// the reference. One row per binder occurrence; the frame is lexical, so a row is visible exactly in its
// arm's subtree.
type InferBinderType {
  site: NodeOccurrenceIdentity
  derived: Node
}

fn infer_no_binder_types() -> List<InferBinderType> {
  Empty
}

// What the frame brings INTO the subtree it opens, charged once at that subtree's root: nothing; a
// counted advisory that the member could not be instantiated (the variable stays uninstantiated, and the
// census sees why); or a located refusal (an authored member formal the member does not inhabit).
type InferFrameEntry
  = InferFrameEnteredPlain
  | InferFrameEnteredWith { advisory: NonEmptyDiagnostics }
  | InferFrameEnteredRefused { refused: NonEmptyDiagnostics }

fn infer_root_frame() -> InferFrame {
  InferFrame { instances: infer_no_type_variable_instances(), binder_types: infer_no_binder_types(), entering: InferFrameEnteredPlain, declared_position_expected: Absent, rigid_binders: Empty }
}

fn infer_frame_inherited(frame: InferFrame) -> InferFrame {
  InferFrame { instances: frame.instances, binder_types: frame.binder_types, entering: InferFrameEnteredPlain, declared_position_expected: Absent, rigid_binders: frame.rigid_binders }
}

// A MATCH ARM IS A BRANCH ARM: the expected type of the match reaches each arm body (F2), as infer_branch_arm_child_frame does for if.
fn infer_frame_with_declared_position_expected(frame: InferFrame, expected: Optional<Node>) -> InferFrame {
  InferFrame { instances: frame.instances, binder_types: frame.binder_types, entering: frame.entering, declared_position_expected: expected, rigid_binders: frame.rigid_binders }
}

fn infer_frame_keep_declared_position_expected(frame: InferFrame) -> InferFrame {
  InferFrame { instances: frame.instances, binder_types: frame.binder_types, entering: InferFrameEnteredPlain, declared_position_expected: frame.declared_position_expected, rigid_binders: frame.rigid_binders }
}

fn infer_nodes_same_occurrence(a: Node, b: Node) -> Bool {
  match node_occurrence_id_optional(node: a) {
    Absent => false
    Present { value: ia } =>
      match node_occurrence_id_optional(node: b) {
        Absent => false
        Present { value: ib } => occurrence_id_eq(left: ia, right: ib)
      }
  }
}

fn infer_arrow_body_child_frame(parent: Node, frame: InferFrame, edge: Edge) -> InferFrame {
  match parent.kind {
    TypeNode { connective: Arrow } =>
      match arrow_body_target_lookup(children: parent.children) {
        Found { target: _ } =>
          if edge_is_core(e: edge, marker: ArrowBodyEdge) {
            InferFrame {
              instances: frame.instances,
              binder_types: frame.binder_types,
              entering: InferFrameEnteredPlain,
              declared_position_expected: list_at_optional(xs: positional_child_target_nodes(node: parent), index: 1),
              rigid_binders: frame.rigid_binders
            }
          } else {
            infer_frame_inherited(frame: frame)
          }
        Ambiguous => infer_frame_inherited(frame: frame)
        NotFound => infer_frame_inherited(frame: frame)
      }
    TypeNode { connective: _ } => infer_frame_inherited(frame: frame)
    ComputationNode { behavior: _ } => infer_frame_inherited(frame: frame)
  }
}

// A binder's declared type, read through the frame: a type variable the frame instantiates IS its instance.
fn infer_frame_instantiated(declared: Node, instances: List<TypeVariableInstance>) -> Node {
  match node_atom_identity_optional(node: declared) {
    Present { value: id } =>
      match type_variable_instance_lookup(instances: instances, binder: id) {
        Present { value: instance } => instance
        Absent => declared
      }
    Absent => declared
  }
}

fn infer_loop_member_role(loop_node: Node) -> Optional<FoldMemberRole> {
  match loop_realized_declaration_target(children: loop_node.children) {
    Found { target: realized } => fold_realized_member_role(realized: realized)
    Ambiguous => Absent
    NotFound => Absent
  }
}

fn infer_loop_takes_collection_member(loop_node: Node) -> Bool {
  match infer_loop_member_role(loop_node: loop_node) {
    Present { value: FoldStepTakesCollectionMember } => true
    Present { value: FoldStepTakesNoMember } => false
    Absent => false
  }
}

fn infer_fold_member_advisory(reason: Symbol, at: Node) -> NonEmptyDiagnostics {
  diagnostics_singleton(d: Diagnostic {
    reason: reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: CorrectionNotModeled }
  })
}

fn infer_frame_with_advisory(frame: InferFrame, reason: Symbol, at: Node) -> InferFrame {
  InferFrame { instances: frame.instances, binder_types: frame.binder_types, entering: InferFrameEnteredWith { advisory: infer_fold_member_advisory(reason: reason, at: at) }, declared_position_expected: Absent, rigid_binders: frame.rigid_binders }
}

// THE DEPENDENT CHILD'S FRAME: the domain's settled type (already folded into `acc`, because the domain is
// scheduled first), its member by the fold realization's relation, and the step's member formal by ROLE.
// The domain type is read ALIAS-NORMALIZED: the collection relation is std.algebra FreeMonoid, and a
// domain declared through any alias of it -- std.types List, v2.std.collection List -- is that collection,
// so the member is never refused as not-a-collection for the alias a declaration happened to spell
// (v2.std.node Node.children is std.types List<Edge>).
// Every arm that cannot instantiate says so, typed and located, rather than leaving the variable to fall
// silently into the non-refusing ReceiverTypeUnderived arm.
fn infer_fold_member_frame(loop_node: Node, frame: InferFrame, acc: InferGatherFoldAcc, step: Node, resolved: ResolvedTree) -> InferFrame {
  match loop_domain_value_target(children: loop_node.children) {
    Found { target: domain } =>
      match lookup_inferred_facts_in_entries(entries: acc.entries, key: domain) {
        Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_type_not_derived, at: domain)
        Present { value: facts } =>
          match inferred_facts_resolved_type(facts: facts) {
            Violates { diagnostic: _ } => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_type_not_derived, at: domain)
            Holds { value: domain_type } =>
              match fold_collection_member_type(domain_type: infer_type_alias_normalized_at(t: domain_type, bodies: resolved.resolved_declarations, bindings: resolved.symbol_index)) {
                Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_not_a_collection, at: domain)
                Present { value: member } =>
                  match fold_step_member_formal(step: step) {
                    Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_formal_unread, at: step)
                    Present { value: formal } => infer_fold_member_formal_frame(frame: frame, formal: formal, member: member, step: step, resolved: resolved)
                  }
              }
          }
      }
    Ambiguous => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_type_not_derived, at: loop_node)
    NotFound => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_type_not_derived, at: loop_node)
  }
}

// A FRESH FORMAL IS INSTANTIATED; AN AUTHORED ONE IS JUDGED -- for the member formal against the domain's
// element, and for the carrier formal against init's type (infer_fold_carrier_frame), by one route. The member must inhabit an authored
// formal through the same declared_type_inhabitance fold an application argument meets at its formal, so
// `fn(acc, e: Int)` over a List<Edge> refuses at that formal rather than typing `e` as either.
fn infer_fold_member_formal_frame(frame: InferFrame, formal: FoldMemberFormal, member: Node, step: Node, resolved: ResolvedTree) -> InferFrame {
  match node_atom_identity_optional(node: formal.formal.type_node) {
    Present { value: variable } =>
      if formal.fresh {
        InferFrame {
          instances: list_snoc_item(xs: frame.instances, item: TypeVariableInstance { binder: variable, instance: member }),
          binder_types: frame.binder_types,
          entering: InferFrameEnteredPlain,
          declared_position_expected: Absent,
          rigid_binders: frame.rigid_binders
        }
      } else {
        infer_fold_member_judged_frame(frame: frame, formal: formal, member: member, step: step, resolved: resolved)
      }
    Absent => infer_fold_member_judged_frame(frame: frame, formal: formal, member: member, step: step, resolved: resolved)
  }
}

fn infer_fold_member_judged_frame(frame: InferFrame, formal: FoldMemberFormal, member: Node, step: Node, resolved: ResolvedTree) -> InferFrame {
  let obligation = infer_declared_type_obligation(position: PositionDirectCallArgument, parameter_identity: formal.formal.name, declared: infer_declared_type_denotation(declared: formal.formal.type_node), produced: member, application: formal.formal.type_node, type_variables: type_param_names(n: step), declarations: resolved.resolved_declarations, bindings: resolved.symbol_index)
  match declared_type_inhabitance(obligation: obligation) {
    Inhabits { homomorphism: _ } => InferFrame { instances: frame.instances, binder_types: frame.binder_types, entering: InferFrameEnteredPlain, declared_position_expected: Absent, rigid_binders: frame.rigid_binders }
    InhabitanceUndecidable { reason: _ } =>
      infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_formal_undecided, at: formal.formal.type_node)
    InhabitanceRefused { find_witness_reason: fw_reason } =>
      InferFrame {
        instances: frame.instances,
        binder_types: frame.binder_types,
        entering: InferFrameEnteredRefused {
          refused: diagnostics_singleton(d: application_argument_does_not_inhabit_diagnostic(obligation: obligation, find_witness_reason: fw_reason))
        },
        declared_position_expected: Absent,
        rigid_binders: frame.rigid_binders
      }
  }
}

// THE EXPECTED TYPE HOPS A BRANCH'S ARMS: the condition is a Bool position of its own and keeps nothing, the then/else slots are in the
// branch's declared position, so they keep the frame's expected type (a nested branch then reads it at its own join).
fn infer_branch_arm_child_frame(slot: ChildSlot, frame: InferFrame) -> InferFrame {
  match slot.ordinal {
    PositionalOrdinal { index: i } =>
      if i == 0 { infer_frame_inherited(frame: frame) } else { infer_frame_keep_declared_position_expected(frame: frame) }
    LabeledChild => infer_frame_inherited(frame: frame)
  }
}

// A DECLARATION'S OWN TYPE PARAMETERS ARE RIGID AND IN SCOPE BENEATH IT. Entering a node that declares type
// parameters (a generic fn's Arrow, a generic type declaration: v2.std.type_binder type_param_names) adds
// them to the frame its children see, so a type atom spelling one of them is that declaration's rigid
// variable everywhere beneath it -- its domain, codomain, body or member -- and nowhere else.
fn infer_gather_child_context(parent: Node, frame: InferFrame, acc: InferGatherFoldAcc, slot: ChildSlot, resolved: ResolvedTree) -> InferFrame {
  infer_frame_entering_declaration(
    frame: infer_gather_child_context_unscoped(parent: parent, frame: frame, acc: acc, slot: slot, resolved: resolved),
    parent: parent
  )
}

fn infer_frame_entering_declaration(frame: InferFrame, parent: Node) -> InferFrame {
  match type_param_names(n: parent) {
    Empty => frame
    Cons { head: _, tail: _ } =>
      InferFrame {
        instances: frame.instances,
        binder_types: frame.binder_types,
        entering: frame.entering,
        declared_position_expected: frame.declared_position_expected,
        rigid_binders: fold(type_param_names(n: parent), init: frame.rigid_binders, f: fn(acc, p) { list_snoc_item(xs: acc, item: p) })
      }
  }
}

// THE LEAF RULE (rigid binder): a type atom whose binding is a type parameter of an ENCLOSING declaration, and
// whose origin is rigid (v2.std.anonymous_binder type_variable_origin, the one origin reader; constructor-use and
// binder-minted variables keep their own handling), derives as itself: the rigid type variable, a childless
// Atom, so every composite over it (an Arrow, a product, an alias Id<T> = T) forms by its ordinary introduction.
// A rigid variable is equal only to itself; it never unifies with a concrete type. Outside its declaration the
// atom is not in the frame and stays on the frontier as before.
fn infer_atom_is_rigid_binder_in_scope(id: Symbol, rigid_binders: List<Symbol>) -> Bool {
  match type_variable_origin(sym: id) {
    TypeVariableRigid => contains(xs: rigid_binders, item: id, eq: fn(x, y) { x == y })
    TypeVariableOfBinder => false
    TypeVariableOfConstructorUse => false
  }
}

fn infer_gather_child_context_unscoped(parent: Node, frame: InferFrame, acc: InferGatherFoldAcc, slot: ChildSlot, resolved: ResolvedTree) -> InferFrame {
  let edge = slot.edge
  if infer_application_actual_is_callback(application: parent, edge: edge) {
    infer_callback_argument_frame(application: parent, frame: infer_frame_inherited(frame: frame), acc: acc, callback: edge.target, resolved: resolved)
  } else if infer_construct_field_is_callback(construct: parent, edge: edge) {
    infer_construct_callback_frame(construct: parent, frame: infer_frame_inherited(frame: frame), acc: acc, callback: edge.target, resolved: resolved)
  } else {
  match edge.label {
    Positional =>
      if infer_bind_encodes_collection_fold(bind: parent) && infer_loop_takes_collection_member(loop_node: edge.target) {
        infer_fold_carrier_frame(bind: parent, frame: infer_frame_inherited(frame: frame), acc: acc, loop_node: edge.target, resolved: resolved)
      } else if infer_loop_takes_collection_member(loop_node: parent) {
        infer_fold_member_frame(loop_node: parent, frame: infer_frame_inherited(frame: frame), acc: acc, step: edge.target, resolved: resolved)
      } else if infer_annotated_let_bound_slot(parent: parent, slot: slot) {
        infer_annotated_let_bound_frame(bind: parent, frame: frame)
      } else if infer_let_body_slot(parent: parent, slot: slot) {
        infer_let_body_frame(bind: parent, frame: infer_frame_keep_declared_position_expected(frame: frame), acc: acc)
      } else {
        match parent.kind {
          ComputationNode { behavior: Match } =>
            match slot.ordinal {
              PositionalOrdinal { index: i } =>
                match match_positional_slot(ordinal: i) {
                  MatchArmSlot => infer_frame_with_declared_position_expected(frame: infer_match_arm_child_frame(parent: parent, frame: frame, acc: acc, edge: edge, resolved: resolved), expected: frame.declared_position_expected)
                  MatchScrutineeSlot => infer_frame_inherited(frame: frame)
                }
              LabeledChild => infer_frame_inherited(frame: frame)
            }
          ComputationNode { behavior: Branch } => infer_branch_arm_child_frame(slot: slot, frame: frame)
          ComputationNode { behavior: _ } => infer_frame_inherited(frame: frame)
          TypeNode { connective: _ } => infer_frame_inherited(frame: frame)
        }
      }
    Authored { name: _ } => infer_frame_inherited(frame: frame)
    StructuralLabel { label: _ } => infer_arrow_body_child_frame(parent: parent, frame: frame, edge: edge)
  }
  }
}

// A CALLBACK ARGUMENT IS ENTERED AFTER ITS SIBLINGS HAVE SETTLED, under a frame that instantiates its
// fresh parameter variables from the formal it is passed to. This is the fold step's dependent-child
// frame (infer_fold_member_frame) at its second site, an application argument: function-value lowering
// minted one fresh variable per unannotated binder (v2.std.anonymous_binder fresh_type_variable), and
// without this frame the body read that variable as the binder's TYPE, so `need_int(n: x)` refused the
// placeholder rather than judging what `x` is (gunbc.recurring_failure_mode
// infer_child_context_cannot_depend_on_a_sibling_result). The callee and every non-callback actual are
// scheduled first (infer_gather_schedules_first), so `acc` holds their facts whichever order they were
// written in. No second parameter-typing route is minted: the instance is read at the one place a binder's
// declared type becomes a reference's type (infer_lexical_reference_facts, through infer_frame_instantiated).
//
// AN ACTUAL IS A CALLBACK when it is a function literal -- an Arrow carrying a body -- in argument
// position of an application; the callee edge (the application's first child) never is.
fn infer_application_actual_is_callback(application: Node, edge: Edge) -> Bool {
  match application.kind {
    ComputationNode { behavior: Transform } =>
      match infer_application_callee_use(node: application) {
        Absent => false
        Present { value: callee } => !node_same_occurrence(a: callee, b: edge.target) && infer_node_is_function_literal(n: edge.target)
      }
    ComputationNode { behavior: _ } => false
    TypeNode { connective: _ } => false
  }
}

// A RECORD FIELD IS A CALLBACK on the same terms: a function literal in field position of a construction, never the tag.
// The field's declared type is its formal, so it is entered after its sibling fields settle and under the frame
// the formal instantiates (infer_construct_callback_frame) -- the one callback reading an application argument gets.
fn infer_construct_field_is_callback(construct: Node, edge: Edge) -> Bool {
  match construct_tag_optional(n: construct) {
    Absent => false
    Present { value: tag } => !node_same_occurrence(a: tag, b: edge.target) && infer_node_is_function_literal(n: edge.target)
  }
}

fn infer_construct_callback_frame(construct: Node, frame: InferFrame, acc: InferGatherFoldAcc, callback: Node, resolved: ResolvedTree) -> InferFrame {
  match infer_record_construct_read(node: construct, resolved: resolved) {
    ConstructIsRecord { construct: record } =>
      match infer_record_field_binding(node: construct, record: record.record, formals: record.formals) {
        RecordFieldsBound { pairs: pairs } =>
          match infer_callback_expectation_over(pairs: pairs, type_params: record.type_params, callback: callback, entries: acc.entries, declarations: resolved.resolved_declarations, bindings: resolved.symbol_index) {
            Absent => frame
            Present { value: e } => infer_callback_formal_frame(frame: frame, expected: e.expected, callback: callback, type_params: e.type_params)
          }
        RecordFieldsRefused { diagnostic: _ } => frame
        RecordPayloadUnread => frame
      }
    ConstructNotARecord => frame
    ConstructIsVariantArm { construct: _ } => frame
    ConstructVariantArmIdentityUnavailable => frame
    ConstructVariantArmBodyUnavailable => frame
    ConstructVariantArmIdentityContested { claimants: _ } => frame
  }
}

fn infer_node_is_function_literal(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Arrow } =>
      match arrow_body_target_lookup(children: n.children) {
        Found { target: _ } => true
        Ambiguous => false
        NotFound => false
      }
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}

// THE CALLBACK'S EXPECTED SIGNATURE is its formal's declared type at this application's instances, the
// instances read off the settled actuals by the same generic matcher that judges them
// (infer_match_generic_formal_or_carrier). Knowing a formal's INPUT does not wait on its output: a type
// parameter only the callback's own result could fix (U in `fn(T) -> Res<U>`) is simply left
// uninstantiated, and only an input still mentioning an uninstantiated parameter is left unframed.
// Every arm that cannot read the formal is Absent: the frame is then inherited unchanged and the
// callback keeps the counted frontier, and the application row judging the same actuals afterwards owns
// every refusal. The frame (infer_callback_argument_frame) reads this expectation; the callback's own type is
// then assembled from that frame (infer_function_value_facts), so the type the body is checked with and the type
// the callback is judged at are one fact. The arity refutation (infer_callback_arity_refutation) is its one other
// reader.
type InferCallbackExpectation {
  expected: Node
  type_params: List<Symbol>
}

fn infer_callback_expectation(application: Node, callback: Node, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex) -> Optional<InferCallbackExpectation> {
  match infer_application_formals(node: application, entries: entries) {
    FormalsUnresolved => optional_absent()
    FormalsOrderRefused { reason: _ } => optional_absent()
    FormalsInDeclaredOrder { formals: formals } =>
      match infer_application_formal_args(node: application, formals: formals, entries: entries) {
        Rejected { diagnostics: _ } => optional_absent()
        Accepted { value: pairs, diagnostics: _ } =>
          infer_callback_expectation_at(
            pairs: pairs,
            type_params: infer_application_type_params(node: application, entries: entries),
            callback: callback,
            entries: entries,
            declarations: declarations,
            bindings: bindings,
            close: fn(instances) { infer_instances_with_bound_generators(application: application, entries: entries, declarations: declarations, bindings: bindings, instances: instances) }
          )
      }
  }
}

// THE EXPECTATION IS READ OFF THE SITE'S BOUND (formal, actual) PAIRS, whichever site bound them: an application's
// arguments or a record construction's fields are one pairing (InhabitanceFormalArg), so a callback in either is framed
// and judged by this one reading.
fn infer_callback_expectation_over(pairs: List<InhabitanceFormalArg>, type_params: List<Symbol>, callback: Node, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex) -> Optional<InferCallbackExpectation> {
  infer_callback_expectation_at(pairs: pairs, type_params: type_params, callback: callback, entries: entries, declarations: declarations, bindings: bindings, close: fn(instances) { instances })
}

// A GENERATOR IS FIXED BY ITS INHABITANT. A type parameter bounded by a structure (`M: FreeMonoid<E>`, the collection
// roster's carrier) is instantiated by its actual, and the structure's declared generator `E` is then not free: the one
// inhabitance authority -- the row of v2.extdeps.languages.dag dag_algebra_inhabitance_decls that the instance inhabits,
// read by infer_instance_structure_inhabitance_in, the same read the application's bound judgment makes
// (infer_application_structure_bounds) -- says what it is. So a generator the settled actuals did not fix is instantiated
// from that row before a callback is framed: `sort_by(xs, fn(x) { .. })` frames `x` at the element of xs's carrier. A
// generator already fixed is left as it is, and the bound judgment afterwards refuses a disagreement, located; an
// instance no row admits fixes nothing here, and that judgment refuses it.
fn infer_instances_with_bound_generators(application: Node, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex, instances: List<TypeVariableInstance>) -> List<TypeVariableInstance> {
  match infer_application_callee_arrow_with_facts(node: application, entries: entries) {
    Absent => instances
    Present { value: arrow } =>
      fold(arrow.children, init: instances, f: fn(acc, e) {
        if edge_is_type_params(e: e) {
          fold(e.target.children, init: acc, f: fn(inner, b) { infer_instances_with_binder_generator(binder: b, declarations: declarations, bindings: bindings, instances: inner) })
        } else {
          acc
        }
      })
  }
}

fn infer_instances_with_binder_generator(binder: Edge, declarations: SymbolIndex, bindings: SymbolIndex, instances: List<TypeVariableInstance>) -> List<TypeVariableInstance> {
  match binder.label {
    Authored { name: name } =>
      match type_param_bound(binder: binder.target) {
        StructureBound { structure: structure } =>
          match type_variable_instance_lookup(instances: instances, binder: name) {
            Absent => instances
            Present { value: instance } =>
              match free_monoid_structure_generator_declaration(inhabitance: structure) {
                GeneratorDeclared { generator: declared } =>
                  match node_atom_identity_optional(node: declared) {
                    Absent => instances
                    Present { value: generator_binder } =>
                      match type_variable_instance_lookup(instances: instances, binder: generator_binder) {
                        Present { value: _ } => instances
                        Absent =>
                          match infer_instance_structure_inhabitance_in(rows: dag_algebra_inhabitance_decls(), instance: instance, structure: structure, declarations: declarations, bindings: bindings) {
                            StructureInhabited { generator: Present { value: generator } } => list_snoc_item(xs: instances, item: TypeVariableInstance { binder: generator_binder, instance: generator })
                            StructureInhabited { generator: Absent } => instances
                            StructureNotInhabited => instances
                            StructureRowMalformed { cause: _ } => instances
                          }
                      }
                  }
                GeneratorNotDeclared => instances
                GeneratorMalformed { cause: _ } => instances
              }
          }
        KindBound { kind: _ } => instances
        Unbound => instances
      }
    StructuralLabel { label: _ } => instances
    Positional => instances
  }
}

fn infer_callback_expectation_at(pairs: List<InhabitanceFormalArg>, type_params: List<Symbol>, callback: Node, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex, close: fn(List<TypeVariableInstance>) -> List<TypeVariableInstance>) -> Optional<InferCallbackExpectation> {
  match infer_callback_formal_arg(pairs: pairs, callback: callback) {
    Absent => optional_absent()
    Present { value: pair } =>
      let instances = close(infer_settled_actual_instances(pairs: pairs, entries: entries, type_params: type_params, declarations: declarations, bindings: bindings))
      optional_present(value: InferCallbackExpectation {
        expected: infer_type_alias_normalized_at(t: infer_type_instantiated(t: pair.formal.declared, instances: instances), bodies: declarations, bindings: bindings),
        type_params: type_params
      })
  }
}

fn infer_callback_argument_frame(application: Node, frame: InferFrame, acc: InferGatherFoldAcc, callback: Node, resolved: ResolvedTree) -> InferFrame {
  match infer_callback_expectation(application: application, callback: callback, entries: acc.entries, declarations: resolved.resolved_declarations, bindings: resolved.symbol_index) {
    Absent => frame
    Present { value: e } => infer_callback_formal_frame(frame: frame, expected: e.expected, callback: callback, type_params: e.type_params)
  }
}

fn infer_callback_formal_arg(pairs: List<InhabitanceFormalArg>, callback: Node) -> Optional<InhabitanceFormalArg> {
  fold(pairs, init: optional_absent(), f: fn(found, pair) {
    match found {
      Present { value: _ } => found
      Absent => if node_same_occurrence(a: pair.arg, b: callback) { optional_present(value: pair) } else { found }
    }
  })
}

// The application's instances as far as its settled actuals fix them. Every actual is read at its own facts -- a
// function literal included, whose type is its own fact once it has settled (infer_function_value_facts), so
// `init: fn(Int) -> R` filled by `fn(n) { n + 1 }` fixes R as Int for a later `is_done: fn(R) -> Bool` through the
// matcher's Arrow arm (infer_match_generic_arrow), not through a second reading of its body. An actual not yet
// settled, whose type is not derived, or that does not match its formal's shape, contributes nothing here -- the row
// judging it afterwards reports that, typed and located.
fn infer_settled_actual_instances(pairs: List<InhabitanceFormalArg>, entries: Map<Node, List<InferredFacts>>, type_params: List<Symbol>, declarations: SymbolIndex, bindings: SymbolIndex) -> List<TypeVariableInstance> {
  fold(pairs, init: infer_no_type_variable_instances(), f: fn(instances, pair) {
      match lookup_inferred_facts_in_entries(entries: entries, key: pair.arg) {
        Absent => instances
        Present { value: facts } =>
          match inferred_facts_resolved_type(facts: facts) {
            Violates { diagnostic: _ } => instances
            Holds { value: produced } =>
              match infer_match_generic_formal_or_carrier(
                formal: infer_type_alias_normalized_at(t: pair.formal.declared, bodies: declarations, bindings: bindings),
                produced: infer_type_alias_normalized_at(t: produced, bodies: declarations, bindings: bindings),
                type_params: type_params,
                instances: instances,
                declarations: declarations,
                bindings: bindings
              ) {
                InferFormalMatched { instances: matched } => matched
                InferFormalShapeMismatch => instances
              }
          }
      }
  })
}

// POSITION BY POSITION, the callback's formal against the expected signature's formal at the same declared
// position (fold_step_formal_at, the one positional formal reader). A fresh formal is instantiated by the
// expected input; an authored one, and an arity disagreement, are decided by the application row's
// judgment of the callback's own type against its formal (infer_function_value_facts,
// infer_callback_arity_refutation). An expected input still naming an uninstantiated type parameter of
// the callee instantiates nothing: binding the variable to the callee's bare parameter would type the body
// with a name that means nothing in its scope.
type InferCallbackFrameWalk {
  position: Int
  instances: List<TypeVariableInstance>
}

fn infer_callback_formal_frame(frame: InferFrame, expected: Node, callback: Node, type_params: List<Symbol>) -> InferFrame {
  match arrow_declared_parameter_order(arrow: callback) {
    ArrowParameterOrderAbsent => frame
    ArrowParameterOrderMalformed => frame
    ArrowParameterOrderDeclared { labels: labels } =>
      InferFrame {
        instances: fold(labels, init: InferCallbackFrameWalk { position: 0, instances: frame.instances }, f: fn(walk, _) {
          InferCallbackFrameWalk {
            position: walk.position + 1,
            instances: infer_callback_formal_instance(instances: walk.instances, expected: expected, callback: callback, position: walk.position, type_params: type_params)
          }
        }).instances,
        binder_types: frame.binder_types,
        entering: InferFrameEnteredPlain,
        declared_position_expected: Absent,
        rigid_binders: frame.rigid_binders
      }
  }
}

fn infer_callback_formal_instance(instances: List<TypeVariableInstance>, expected: Node, callback: Node, position: Int, type_params: List<Symbol>) -> List<TypeVariableInstance> {
  match fold_step_formal_at(step: callback, position: position) {
    Absent => instances
    Present { value: own } =>
      if own.fresh {
        match node_atom_identity_optional(node: own.formal.type_node) {
          Absent => instances
          Present { value: variable } =>
            match infer_callback_expected_input(expected: expected, position: position, type_params: type_params) {
              Absent => instances
              Present { value: supplied } => list_snoc_item(xs: instances, item: TypeVariableInstance { binder: variable, instance: supplied })
            }
        }
      } else {
        instances
      }
  }
}

fn infer_callback_expected_input(expected: Node, position: Int, type_params: List<Symbol>) -> Optional<Node> {
  match fold_step_formal_at(step: expected, position: position) {
    Absent => optional_absent()
    Present { value: wanted } =>
      if inhabitance_node_mentions_type_variable(n: wanted.formal.type_node, type_variables: type_params) {
        optional_absent()
      } else {
        optional_present(value: wanted.formal.type_node)
      }
  }
}

// A FUNCTION VALUE'S TYPE IS A FACT ABOUT THE FUNCTION VALUE, derived where it settles and nowhere else
// (gunbc.recurring_failure_mode lambda_value_has_no_derived_type_in_v2_infer). Function-value lowering mints
// one fresh type variable per unannotated parameter and one for an unwritten return
// (v2.std.anonymous_binder fresh_type_variable); those minted variables are what mark an Arrow as a function
// value rather than a declaration, which never carries one. Its type, assembled through
// anonymous_signature_arrow -- the one bodiless signature encoding the Arrow arm of v2.std.inhabitance
// declared_type_inhabitance re-reads both sides through -- is:
//   a fresh input: the instance the frame it was entered under holds for that variable (frame_instances,
//     the same List<TypeVariableInstance> an application instantiates its callee's parameters with, and the
//     same instance its body's references to the parameter were typed with: infer_frame_instantiated);
//   an authored input: as written;
//   an unwritten return: the BODY's derived type, never an expected one; an authored return as written.
// A fresh variable no frame instantiated, or a body still typed by one, leaves the type UNDETERMINED: the
// value stays on the counted frontier at FunctionValueSignatureUndetermined, never a guessed type. Whichever
// position supplied the frame -- an application argument (infer_callback_argument_frame), a record field
// (infer_construct_callback_frame), a fold step (infer_fold_member_frame), or none (a `let`-bound or returned
// value with authored inputs) -- the type is read by every consumer from the value's own facts, so the
// type a body was checked with and the type its consumer judges are one fact.
fn infer_function_value_fresh_variables(n: Node) -> List<Symbol> {
  fold(type_param_names(n: n), init: Empty, f: fn(acc, p) {
    match type_variable_origin(sym: p) {
      TypeVariableOfBinder => list_snoc_item(xs: acc, item: p)
      TypeVariableRigid => acc
      TypeVariableOfConstructorUse => acc
    }
  })
}

fn infer_node_is_function_value(n: Node) -> Bool {
  infer_node_is_function_literal(n: n) && !is_empty(xs: infer_function_value_fresh_variables(n: n))
}

type InferFunctionValueDomainWalk {
  position: Int
  domain_types: Optional<List<Node>>
}

fn infer_function_value_signature(callback: Node, entries: Map<Node, List<InferredFacts>>, instances: List<TypeVariableInstance>) -> Optional<Node> {
  let fresh = infer_function_value_fresh_variables(n: callback)
  match arrow_declared_parameter_order(arrow: callback) {
    ArrowParameterOrderAbsent => optional_absent()
    ArrowParameterOrderMalformed => optional_absent()
    ArrowParameterOrderDeclared { labels: labels } =>
      let domain = fold(labels, init: InferFunctionValueDomainWalk { position: 0, domain_types: optional_present(value: Empty) }, f: fn(walk, _) {
        InferFunctionValueDomainWalk {
          position: walk.position + 1,
          domain_types: match walk.domain_types {
            Absent => optional_absent()
            Present { value: types } =>
              match infer_function_value_input_type(callback: callback, position: walk.position, instances: instances, fresh: fresh) {
                Absent => optional_absent()
                Present { value: t } => optional_present(value: list_snoc_item(xs: types, item: t))
              }
          }
        }
      }).domain_types
      match domain {
        Absent => optional_absent()
        Present { value: domain_types } =>
          match infer_callback_return_type(callback: callback, entries: entries) {
            Absent => optional_absent()
            Present { value: codomain } =>
              if inhabitance_node_mentions_type_variable(n: codomain, type_variables: fresh) {
                optional_absent()
              } else {
                optional_present(value: anonymous_signature_arrow(domain_types: domain_types, codomain: codomain, source: callback))
              }
          }
      }
  }
}

fn infer_function_value_input_type(callback: Node, position: Int, instances: List<TypeVariableInstance>, fresh: List<Symbol>) -> Optional<Node> {
  match fold_step_formal_at(step: callback, position: position) {
    Absent => optional_absent()
    Present { value: own } =>
      if own.fresh {
        let supplied = infer_frame_instantiated(declared: own.formal.type_node, instances: instances)
        if inhabitance_node_mentions_type_variable(n: supplied, type_variables: fresh) { optional_absent() } else { optional_present(value: supplied) }
      } else {
        optional_present(value: own.formal.type_node)
      }
  }
}

fn infer_function_value_facts(node: Node, entries: Map<Node, List<InferredFacts>>, instances: List<TypeVariableInstance>) -> Outcome<InferredFacts> {
  match infer_descent_witness_for_node(n: node) {
    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
    Holds { value: descent_proof } =>
      match infer_function_value_signature(callback: node, entries: entries, instances: instances) {
        Absent => inferred_facts_not_derived(site: FunctionValueSignatureUndetermined, node: node, descent: Holds { value: descent_proof })
        Present { value: callable } => inferred_facts_from_derived_type(node: node, derived_type: callable, descent: Holds { value: descent_proof })
      }
  }
}

// A KNOWN PARAMETER-COUNT DISAGREEMENT IS DECIDED, NOT DROPPED. `apply_int(f: fn(x, y) { .. })` against
// `fn(Int) -> ..`: the formal supplies no input for `y`, so the value's own type is undetermined and it stays
// on the frontier -- but its arity alone refutes the call, and leaving it undecidable would accept it. This is
// the one judgment read at the consuming position, and it is a relation between two parameter COUNTS, not a
// typing of the value: when both counts are readable and differ, the judgment sees a signature in which each
// position the formal supplies takes that input and every other keeps the value's OWN declared type -- its
// fresh variable, which asserts nothing -- and an underived body leaves its own declared codomain. No type is
// invented: the comparison then refuses on the domain's length, which those positions cannot change.
fn infer_callback_arity_differs(expected: Node, labels: List<Symbol>) -> Bool {
  match arrow_declared_parameter_order(arrow: expected) {
    ArrowParameterOrderDeclared { labels: expected_labels } => length(xs: expected_labels) != length(xs: labels)
    ArrowParameterOrderAbsent => false
    ArrowParameterOrderMalformed => false
  }
}

type InferCallbackSignatureWalk {
  position: Int
  domain_types: Optional<List<Node>>
}

fn infer_callback_arity_refutation(expectation: InferCallbackExpectation, callback: Node, entries: Map<Node, List<InferredFacts>>) -> Optional<Node> {
  match arrow_declared_parameter_order(arrow: callback) {
    ArrowParameterOrderAbsent => optional_absent()
    ArrowParameterOrderMalformed => optional_absent()
    ArrowParameterOrderDeclared { labels: labels } =>
      if infer_callback_arity_differs(expected: expectation.expected, labels: labels) {
        infer_callback_signature_of_other_arity(expectation: expectation, callback: callback, labels: labels, entries: entries)
      } else {
        optional_absent()
      }
  }
}

fn infer_callback_signature_of_other_arity(expectation: InferCallbackExpectation, callback: Node, labels: List<Symbol>, entries: Map<Node, List<InferredFacts>>) -> Optional<Node> {
  let domain = fold(labels, init: InferCallbackSignatureWalk { position: 0, domain_types: optional_present(value: Empty) }, f: fn(walk, _) {
    InferCallbackSignatureWalk {
      position: walk.position + 1,
      domain_types: match walk.domain_types {
        Absent => optional_absent()
        Present { value: types } =>
          match infer_callback_input_type(expectation: expectation, callback: callback, position: walk.position) {
            Present { value: t } => optional_present(value: list_snoc_item(xs: types, item: t))
            Absent =>
              match fold_step_formal_at(step: callback, position: walk.position) {
                Absent => optional_absent()
                Present { value: own } => optional_present(value: list_snoc_item(xs: types, item: own.formal.type_node))
              }
          }
      }
    }
  }).domain_types
  match domain {
    Absent => optional_absent()
    Present { value: domain_types } =>
      match infer_callback_return_type(callback: callback, entries: entries) {
        Present { value: codomain } => optional_present(value: anonymous_signature_arrow(domain_types: domain_types, codomain: codomain, source: callback))
        Absent =>
          match list_at_optional(xs: positional_child_target_nodes(node: callback), index: 1) {
            Absent => optional_absent()
            Present { value: own_codomain } => optional_present(value: anonymous_signature_arrow(domain_types: domain_types, codomain: own_codomain, source: callback))
          }
      }
  }
}

fn infer_callback_input_type(expectation: InferCallbackExpectation, callback: Node, position: Int) -> Optional<Node> {
  match fold_step_formal_at(step: callback, position: position) {
    Absent => optional_absent()
    Present { value: own } =>
      if own.fresh {
        infer_callback_expected_input(expected: expectation.expected, position: position, type_params: expectation.type_params)
      } else {
        optional_present(value: own.formal.type_node)
      }
  }
}

fn infer_callback_return_type(callback: Node, entries: Map<Node, List<InferredFacts>>) -> Optional<Node> {
  match list_at_optional(xs: positional_child_target_nodes(node: callback), index: 1) {
    Absent => optional_absent()
    Present { value: codomain } =>
      if infer_callback_type_is_fresh(t: codomain, callback: callback) {
        match arrow_body_target_lookup(children: callback.children) {
          Found { target: body } =>
            match lookup_inferred_facts_in_entries(entries: entries, key: body) {
              Absent => optional_absent()
              Present { value: facts } =>
                match inferred_facts_resolved_type(facts: facts) {
                  Violates { diagnostic: _ } => optional_absent()
                  Holds { value: t } => optional_present(value: t)
                }
            }
          Ambiguous => optional_absent()
          NotFound => optional_absent()
        }
      } else {
        optional_present(value: codomain)
      }
  }
}

fn infer_callback_type_is_fresh(t: Node, callback: Node) -> Bool {
  match node_atom_identity_optional(node: t) {
    Present { value: id } => fold(type_param_names(n: callback), init: false, f: fn(acc, v) { acc || (v == id) })
    Absent => false
  }
}

// THE JUDGMENT WALKS THE ACTUALS IN THE ORDER INFERENCE SETTLED THEM: every non-callback actual first, then
// the callbacks, each group in written order (infer_gather_schedules_first). The walk accumulates the call's
// instances, so a callback written before the actual that fixes its formal's type parameter
// (`apply(f: fn(x) { .. }, o: h())`) is judged with that parameter already instantiated -- the instances its
// frame was built from -- rather than before it, where the formal is still generic and the judgment can
// only answer undecidable.
fn infer_pairs_callbacks_last(pairs: List<InhabitanceFormalArg>) -> List<InhabitanceFormalArg> {
  concat(
    fold(pairs, init: [], f: fn(acc, pair) { if infer_node_is_function_literal(n: pair.arg) { acc } else { list_snoc_item(xs: acc, item: pair) } }),
    fold(pairs, init: [], f: fn(acc, pair) { if infer_node_is_function_literal(n: pair.arg) { list_snoc_item(xs: acc, item: pair) } else { acc } })
  )
}

// The entries an application's argument judgment reads: each callback actual whose arity refutes its formal
// is seen at that refutation (infer_callback_arity_refutation), ahead of the frontier entry its own formation
// left. Every other callback is read at its own facts. Local to the judgment: the value's facts are not
// rewritten.
fn infer_entries_with_callback_arity_refutations(application: Node, pairs: List<InhabitanceFormalArg>, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex) -> Map<Node, List<InferredFacts>> {
  fold(pairs, init: entries, f: fn(acc, pair) {
    if infer_node_is_function_literal(n: pair.arg) {
      infer_entries_at_callback_signature(
        acc: acc,
        callback: pair.arg,
        signature: match infer_callback_expectation(application: application, callback: pair.arg, entries: entries, declarations: declarations, bindings: bindings) {
          Absent => optional_absent()
          Present { value: e } => infer_callback_arity_refutation(expectation: e, callback: pair.arg, entries: entries)
        }
      )
    } else {
      acc
    }
  })
}

// The same reading for a record construction's fields: a callback field whose arity refutes its declared
// field type is seen at that refutation.
fn infer_entries_with_construct_callback_arity_refutations(pairs: List<InhabitanceFormalArg>, type_params: List<Symbol>, entries: Map<Node, List<InferredFacts>>, declarations: SymbolIndex, bindings: SymbolIndex) -> Map<Node, List<InferredFacts>> {
  fold(pairs, init: entries, f: fn(acc, pair) {
    if infer_node_is_function_literal(n: pair.arg) {
      infer_entries_at_callback_signature(
        acc: acc,
        callback: pair.arg,
        signature: match infer_callback_expectation_over(pairs: pairs, type_params: type_params, callback: pair.arg, entries: entries, declarations: declarations, bindings: bindings) {
          Absent => optional_absent()
          Present { value: e } => infer_callback_arity_refutation(expectation: e, callback: pair.arg, entries: entries)
        }
      )
    } else {
      acc
    }
  })
}

fn infer_entries_at_callback_signature(acc: Map<Node, List<InferredFacts>>, callback: Node, signature: Optional<Node>) -> Map<Node, List<InferredFacts>> {
  match signature {
    Absent => acc
    Present { value: callable } =>
      match inferred_facts_from_derived_type(node: callback, derived_type: callable, descent: infer_descent_witness_for_node(n: callback)) {
        Rejected { diagnostics: _ } => acc
        Accepted { value: facts, diagnostics: _ } =>
          match admitted_inferred_facts_entry(node: callback, facts: facts) {
            Rejected { diagnostics: _ } => acc
            Accepted { value: entry, diagnostics: _ } => inferred_facts_index_enter_first(index: acc, entry: entry)
          }
      }
  }
}

fn infer_append_binder_types(xs: List<InferBinderType>, ys: List<InferBinderType>) -> List<InferBinderType> {
  fold(ys, init: xs, f: fn(acc, y) { list_snoc_item(xs: acc, item: y) })
}

// THE MATCH ARM IS ENTERED AFTER THE SCRUTINEE HAS SETTLED. Resolve recorded each payload binder's
// standing (LexicalOwedFormal: owed the field's declared type); the scrutinee's instantiated arguments
// are the only thing that pays it, and they exist in `acc` exactly when the first positional child's
// facts are in. So the arm's frame carries one InferBinderType row per payload binder, and a binder whose
// field is a free formal the scrutinee's arguments do not instantiate REFUSES the arm (located), never
// types as the bare formal and never stays untyped to be accepted on the advisory frontier (section 5).
// A Match's scrutinee, read through the slot table (v2.std.node match_slot_target), which stops at it.
fn infer_match_scrutinee(match_node: Node) -> Optional<Node> {
  match_slot_target(n: match_node, slot: MatchScrutineeSlot)
}

fn infer_match_arm_child_frame(parent: Node, frame: InferFrame, acc: InferGatherFoldAcc, edge: Edge, resolved: ResolvedTree) -> InferFrame {
  match infer_match_scrutinee(match_node: parent) {
    Absent => infer_frame_inherited(frame: frame)
    Present { value: scrutinee } =>
      match lookup_inferred_facts_in_entries(entries: acc.entries, key: scrutinee) {
        Absent => infer_match_arm_unpaid_frame(frame: frame, arm: edge.target, resolved: resolved)
        Present { value: facts } =>
          match inferred_facts_resolved_type(facts: facts) {
            Violates { diagnostic: _ } => infer_match_arm_unpaid_frame(frame: frame, arm: edge.target, resolved: resolved)
            Holds { value: scrutinee_type } =>
              match infer_match_coproduct_of_type(scrutinee_type: scrutinee_type, resolved: resolved) {
                CoproductNotDeclared => infer_match_arm_unpaid_frame(frame: frame, arm: edge.target, resolved: resolved)
                CoproductArityMismatch => infer_match_arm_unpaid_frame(frame: frame, arm: edge.target, resolved: resolved)
                UninhabitedScrutinee => infer_match_arm_unpaid_frame(frame: frame, arm: edge.target, resolved: resolved)
                CoproductRead { coproduct: coproduct } => infer_match_arm_paid_frame(frame: frame, arm: edge.target, coproduct: coproduct, scrutinee_type: scrutinee_type)
              }
          }
      }
  }
}

fn infer_match_arm_paid_frame(frame: InferFrame, arm: Node, coproduct: InferMatchCoproduct, scrutinee_type: Node) -> InferFrame {
  match infer_match_arm_binder_types(arm: arm, coproduct: coproduct, owed: infer_no_owed_formals()) {
    MatchArmFormalUndischarged { at: at } => infer_match_arm_formal_refused(frame: frame, at: at)
    MatchArmBinders { rows: rows } =>
      InferFrame {
        instances: frame.instances,
        binder_types: infer_append_binder_types(xs: frame.binder_types, ys: infer_append_binder_types(xs: rows, ys: infer_match_arm_catch_all_binder_types(arm: arm, scrutinee_type: scrutinee_type))),
        entering: InferFrameEnteredPlain,
        declared_position_expected: Absent,
        rigid_binders: frame.rigid_binders
      }
  }
}

// A CATCH-ALL BINDER IS THE SCRUTINEE, so it takes the scrutinee's type exactly as derived -- not its
// alias-unfolded form (infer_match_coproduct_of_type unfolds only to read the alternatives), so an alias
// identity the scrutinee carries reaches every later read of the binder. Its row is keyed by the
// pattern's own occurrence, where resolve sited the binding (v2.compiler.resolve resolve_pattern_binders).
fn infer_match_arm_catch_all_binder_types(arm: Node, scrutinee_type: Node) -> List<InferBinderType> {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => infer_no_binder_types()
    Accepted { value: pat, diagnostics: _ } =>
      match infer_coproduct_arm_pattern(pat: pat) {
        ArmPatternBinder { name: _ } => [InferBinderType { site: pat.occurrence_id, derived: scrutinee_type }]
        // Workaround for gunbc.recurring_failure_mode accepted_source_emits_uncompilable_target (x): bind one field of an all-wildcard multi-field pattern; delete when the emitter keeps the braces.
        ArmPatternVariant { tag: _tag, fields: _ } => infer_no_binder_types()
        ArmPatternWildcard => infer_no_binder_types()
        ArmPatternUnread => infer_no_binder_types()
      }
  }
}

fn infer_match_arm_formal_refused(frame: InferFrame, at: Node) -> InferFrame {
  InferFrame {
    instances: frame.instances,
    binder_types: frame.binder_types,
    entering: InferFrameEnteredRefused {
      refused: diagnostics_singleton(d: Diagnostic {
        reason: ^infer_reason_pattern_payload_formal_uninstantiated,
        at: node_locus(node: at),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    },
    declared_position_expected: Absent,
    rigid_binders: frame.rigid_binders
  }
}

// The scrutinee's arguments are not known (its type is not derived, or not a declared coproduct): the arm
// is read against the arm's own declared coproduct with NO instances, so a payload binder that is a free
// formal refuses and a concrete one is typed from the RESOLVED declaration with nothing to instantiate --
// the same row a construction of the arm is judged at. Resolve no longer writes a concrete binder's type
// (v2.compiler.resolve resolve_pattern_binder_declared_type), so this row is its only type.
fn infer_match_arm_unpaid_frame(frame: InferFrame, arm: Node, resolved: ResolvedTree) -> InferFrame {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => infer_frame_inherited(frame: frame)
    Accepted { value: pat, diagnostics: _ } =>
      match construct_tag_path_optional(n: pat) {
        Absent => infer_frame_inherited(frame: frame)
        Present { value: arm_path } =>
          match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: qualified_name_init(qn: arm_path)) {
            Absent => infer_frame_inherited(frame: frame)
            Present { value: declared } =>
              match declared.kind {
                TypeNode { connective: Disj } =>
                  match infer_match_arm_binder_types(
                    arm: arm,
                    coproduct: InferMatchCoproduct { path: qualified_name_init(qn: arm_path), variants: declared, instances: infer_no_type_variable_instances() },
                    owed: symbol_index_declared_type_params_at(index: resolved.resolved_declarations, qualified_path: qualified_name_init(qn: arm_path))
                  ) {
                    MatchArmFormalUndischarged { at: at } => infer_match_arm_formal_refused(frame: frame, at: at)
                    MatchArmBinders { rows: rows } =>
                      InferFrame {
                        instances: frame.instances,
                        binder_types: infer_append_binder_types(xs: frame.binder_types, ys: rows),
                        entering: InferFrameEnteredPlain,
                        declared_position_expected: Absent,
                        rigid_binders: frame.rigid_binders
                      }
                  }
                TypeNode { connective: _ } => infer_frame_inherited(frame: frame)
                ComputationNode { behavior: _ } => infer_frame_inherited(frame: frame)
              }
          }
      }
  }
}

type InferMatchArmBinders
  = MatchArmBinders { rows: List<InferBinderType> }
  | MatchArmFormalUndischarged { at: Node }

fn infer_no_owed_formals() -> List<Symbol> {
  Empty
}

fn infer_match_arm_binders_empty() -> InferMatchArmBinders {
  MatchArmBinders { rows: infer_no_binder_types() }
}

fn infer_match_arm_binder_types(arm: Node, coproduct: InferMatchCoproduct, owed: List<Symbol>) -> InferMatchArmBinders {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => infer_match_arm_binders_empty()
    Accepted { value: pat, diagnostics: _ } =>
      match infer_coproduct_arm_pattern(pat: pat) {
        ArmPatternUnread => infer_match_arm_binders_empty()
        ArmPatternWildcard => infer_match_arm_binders_empty()
        ArmPatternBinder { name: _ } => infer_match_arm_binders_empty()
        ArmPatternVariant { tag: tag, fields: fields } =>
          match infer_match_variant_payload(variants: coproduct.variants, tag: tag) {
            Absent => infer_match_arm_binders_empty()
            Present { value: payload } =>
              fold(fields, init: infer_match_arm_binders_empty(), f: fn(acc, e) {
                match acc {
                  MatchArmFormalUndischarged { at: _ } => acc
                  MatchArmBinders { rows: rows } => infer_match_arm_field_binder(acc: acc, rows: rows, payload: payload, coproduct: coproduct, owed: owed, e: e)
                }
              })
          }
      }
  }
}

// A paid binder takes the field type the scrutinee's arguments instantiate. `owed` names the declaring
// type's formals NO argument instantiates (empty when the scrutinee settled): a binder whose field is
// one of them has nothing to be typed from and refuses the arm.
fn infer_match_arm_field_binder(acc: InferMatchArmBinders, rows: List<InferBinderType>, payload: Node, coproduct: InferMatchCoproduct, owed: List<Symbol>, e: Edge) -> InferMatchArmBinders {
  match e.label {
    Positional => acc
    StructuralLabel { label: _ } => acc
    Authored { name: field } =>
      if is_wildcard_pattern(pattern: e.target) {
        acc
      } else {
        match infer_conj_named_type_for_binding(domain: payload, binding: field) {
          Absent => acc
          Present { value: field_type } =>
            match infer_match_field_type_instantiated(field_type: field_type, instances: coproduct.instances) {
              Present { value: derived } =>
                MatchArmBinders { rows: list_snoc_item(xs: rows, item: InferBinderType { site: e.target.occurrence_id, derived: derived }) }
              Absent =>
                match node_atom_identity_optional(node: field_type) {
                  Present { value: id } =>
                    if contains(xs: owed, item: id, eq: fn(x, y) { x == y }) { MatchArmFormalUndischarged { at: e.target } } else { acc }
                  Absent => acc
                }
            }
        }
      }
  }
}

// THE FOLD ENCODING'S BIND: `Bind { slot := init, Loop { step, domain, .. } }` (v2.compiler.fold_lowering
// fold_recurrence_encoding), recognised by its body's realization role and never by shape alone.
fn infer_bind_encodes_collection_fold(bind: Node) -> Bool {
  match bind.kind {
    ComputationNode { behavior: Bind } =>
      match bind_slot_target(n: bind, slot: BindBodySlot) {
        Present { value: body } => infer_loop_takes_collection_member(loop_node: body)
        Absent => false
      }
    ComputationNode { behavior: Value } => false
    ComputationNode { behavior: Transform } => false
    ComputationNode { behavior: Branch } => false
    ComputationNode { behavior: Loop } => false
    ComputationNode { behavior: Match } => false
    TypeNode { connective: _ } => false
  }
}


// AN ORDINARY `let`: a Bind whose binder key v2.compiler.lexical_scope bind_binder reads -- the one reader
// resolve sites the binder with, so the frame row below is keyed exactly where resolve recorded the
// binding -- and that does not encode a collection fold (that Bind's binder is the fold carrier, typed by
// infer_fold_carrier_frame). An annotated let is one too; its annotation is a named edge beside the three
// positionals.
fn infer_is_let_bind(bind: Node) -> Bool {
  match bind_binder(n: bind) {
    Present { value: _ } => !infer_bind_encodes_collection_fold(bind: bind)
    Absent => false
  }
}


// AN ANNOTATED LET'S BOUND VALUE IS A DECLARED POSITION, entered under the annotation as the declared type
// it is judged at (infer_bind_annotation_check): the same expected type an Arrow's body carries, so an
// application there is seeded by it (infer_expected_return_seed). An unannotated let has no declared type
// and its value gets none.
fn infer_annotated_let_bound_slot(parent: Node, slot: ChildSlot) -> Bool {
  if infer_is_let_bind(bind: parent) {
    match type_annotation_optional(n: parent) {
      Absent => false
      Present { value: _ } =>
        match slot.ordinal {
          PositionalOrdinal { index: i } =>
            match bind_positional_slot(ordinal: i) {
              BindValueSlot => true
              BindBinderSlot => false
              BindBodySlot => false
            }
          LabeledChild => false
        }
    }
  } else {
    false
  }
}

fn infer_annotated_let_bound_frame(bind: Node, frame: InferFrame) -> InferFrame {
  InferFrame {
    instances: frame.instances,
    binder_types: frame.binder_types,
    entering: InferFrameEnteredPlain,
    declared_position_expected: type_annotation_optional(n: bind),
    rigid_binders: frame.rigid_binders
  }
}

// THE LET BODY CHILD, told by its slot (v2.std.node bind_positional_slot over the slot's positional ordinal): a body whose edge equals the value's
// is still the body, and the value is never mistaken for it.
fn infer_let_body_slot(parent: Node, slot: ChildSlot) -> Bool {
  if infer_is_let_bind(bind: parent) {
    match slot.ordinal {
      PositionalOrdinal { index: i } =>
        match bind_positional_slot(ordinal: i) {
          BindBodySlot => true
          BindBinderSlot => false
          BindValueSlot => false
        }
      LabeledChild => false
    }
  } else {
    false
  }
}

// THE LET BODY IS ENTERED AFTER THE VALUE HAS SETTLED, under a frame with one InferBinderType row at the
// binder's site: the dependent-child frame match arms and the fold carrier already use
// (gunbc.recurring_failure_mode bind_and_match_binders_not_typed_from_their_dependency_sibling). An
// annotated binder is typed by its annotation -- the declared type; the value is evidence judged against it
// at PositionLetAnnotation (infer_bind_annotation_check), never a second answer for the binder. An
// unannotated binder is typed by the value's settled type; a value with no derived type adds no row, so its
// references stay on the counted frontier rather than taking a guessed type. The value is read from the
// settled entries, never from resolve's LexicalValued node, which is the value before its own subtree was
// resolved and so is not an entry key.
fn infer_let_body_frame(bind: Node, frame: InferFrame, acc: InferGatherFoldAcc) -> InferFrame {
  match bind_binder(n: bind) {
    Absent => frame
    Present { value: b } =>
      match type_annotation_optional(n: bind) {
        Present { value: annotation } =>
          infer_frame_with_binder_type(frame: frame, row: InferBinderType { site: b.atom.occurrence_id, derived: infer_frame_instantiated(declared: annotation, instances: frame.instances) })
        Absent =>
          match bind_value(n: bind) {
            Absent => frame
            Present { value: value } =>
              match infer_settled_type_at(target: value, entries: acc.entries) {
                Absent => frame
                Present { value: t } => infer_frame_with_binder_type(frame: frame, row: InferBinderType { site: b.atom.occurrence_id, derived: t })
              }
          }
      }
  }
}

fn infer_frame_with_binder_type(frame: InferFrame, row: InferBinderType) -> InferFrame {
  InferFrame { instances: frame.instances, binder_types: list_snoc_item(xs: frame.binder_types, item: row), entering: frame.entering, declared_position_expected: frame.declared_position_expected, rigid_binders: frame.rigid_binders }
}

// THE LET IS ITS BODY: once the body has settled the Bind derives at the body's type -- not the
// annotation's, not the value's -- so the enclosing check (a declared return, an argument) judges what
// the let actually produces. A body with no derived type leaves the Bind on the counted frontier.
fn infer_gather_let_result_row(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  rigid_binders: List<Symbol>,
) -> InferGatherFoldAcc {
  match bind_slot_target(n: node, slot: BindBodySlot) {
    Absent => infer_gather_transform_frontier_on_entries(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, instances: infer_no_type_variable_instances(), binder_types: infer_no_binder_types(), rigid_binders: rigid_binders)
    Present { value: body } =>
      match infer_settled_type_at(target: body, entries: entries) {
        Absent => infer_gather_transform_frontier_on_entries(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, instances: infer_no_type_variable_instances(), binder_types: infer_no_binder_types(), rigid_binders: rigid_binders)
        Present { value: body_type } =>
          match infer_descent_witness_for_node(n: node) {
            Violates { diagnostic: d } =>
              infer_gather_formed_facts_row(node: node, formed: Rejected { diagnostics: diagnostics_singleton(d: d) }, entries: entries, pending: pending)
            Holds { value: descent_proof } =>
              infer_gather_formed_facts_row(
                node: node,
                formed: inferred_facts_from_derived_type(node: node, derived_type: body_type, descent: Holds { value: descent_proof }),
                entries: entries,
                pending: pending
              )
          }
      }
  }
}

// THE CARRIER FORMAL IS INSTANTIATED FROM INIT, as the member formal is from the domain: the Bind's value
// (init) is folded before its body in authored order, so its settled type is in `acc` when the Loop is
// entered, and the step's actual-0 formal -- read by ROLE -- stands for it throughout the Loop subtree.
fn infer_fold_carrier_frame(bind: Node, frame: InferFrame, acc: InferGatherFoldAcc, loop_node: Node, resolved: ResolvedTree) -> InferFrame {
  match bind_value(n: bind) {
    Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_carrier_type_not_derived, at: bind)
    Present { value: init } =>
      match infer_settled_type_at(target: init, entries: acc.entries) {
        Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_carrier_type_not_derived, at: init)
        Present { value: carrier } =>
          match fold_loop_step(loop_node: loop_node) {
            Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_formal_unread, at: loop_node)
            Present { value: step } =>
              match fold_step_carrier_formal(step: step) {
                Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_formal_unread, at: step)
                Present { value: formal } => infer_fold_member_formal_frame(frame: frame, formal: formal, member: carrier, step: step, resolved: resolved)
              }
          }
      }
  }
}

fn infer_settled_type_at(target: Node, entries: Map<Node, List<InferredFacts>>) -> Optional<Node> {
  match lookup_inferred_facts_in_entries(entries: entries, key: target) {
    Absent => Absent
    Present { value: facts } =>
      match infer_branch_operand_resolved_type(node: target, facts: facts) {
        Holds { value: t } => Present { value: t }
        Violates { diagnostic: _ } => Absent
      }
  }
}

// THE FOLD BIND'S ROW: what one step produces must inhabit the carrier. With a declared step return both
// judgements are made -- the body inhabits the declared return, and the declared return inhabits the carrier
// -- so a declared return can neither hide a body mismatch nor widen past the carrier. A side whose type is
// not derived is a counted advisory, never a pass.
fn infer_fold_bind_check(node: Node, entries: Map<Node, List<InferredFacts>>, resolved: ResolvedTree) -> Outcome<Bool> {
  match bind_value(n: node) {
    Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_carrier_type_not_derived, at: node) } }
    Present { value: init } =>
      match infer_settled_type_at(target: init, entries: entries) {
        Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_carrier_type_not_derived, at: init) } }
        Present { value: carrier } =>
          match bind_slot_target(n: node, slot: BindBodySlot) {
            Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_member_formal_unread, at: node) } }
            Present { value: loop_node } =>
              match fold_loop_step(loop_node: loop_node) {
                Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_member_formal_unread, at: loop_node) } }
                Present { value: step } =>
                  match fold_step_body_node(step: step) {
                    Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_member_formal_unread, at: step) } }
                    Present { value: body } =>
                      match infer_settled_type_at(target: body, entries: entries) {
                        Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_step_body_type_not_derived, at: body) } }
                        Present { value: produced } =>
                          match fold_step_declared_return(step: step) {
                            Absent => infer_fold_judge(declared: carrier, produced: produced, at: body, step: step, resolved: resolved)
                            Present { value: declared_return } =>
                              bind_outcome(
                                o: infer_fold_judge(declared: declared_return, produced: produced, at: body, step: step, resolved: resolved),
                                f: fn(_) { infer_fold_judge(declared: carrier, produced: infer_declared_type_denotation(declared: declared_return), at: declared_return, step: step, resolved: resolved) }
                              )
                          }
                      }
                  }
              }
          }
      }
  }
}

// THE CARRIER IS AN ARM OF THE FOLD, and an open one (`init: none`, `Absent`, `[]`) is closed once at the type the
// step produces, by the one closing relation every declared position and every branch join uses
// (infer_arm_type_closed_at): the step body declares, the init is the open arm. A carrier that is already
// closed is judged as written.
fn infer_fold_carrier_closed_at(declared: Node, produced: Node, resolved: ResolvedTree) -> Node {
  if infer_type_is_open(t: declared) {
    infer_arm_type_closed_at(t: declared, declaring: Present { value: produced }, resolved: resolved)
  } else {
    declared
  }
}

fn infer_fold_judge(declared: Node, produced: Node, at: Node, step: Node, resolved: ResolvedTree) -> Outcome<Bool> {
  let obligation = infer_declared_type_obligation(position: position_declared_return(), parameter_identity: ^fold_carrier, declared: infer_declared_type_denotation(declared: infer_fold_carrier_closed_at(declared: declared, produced: produced, resolved: resolved)), produced: produced, application: at, type_variables: type_param_names(n: step), declarations: resolved.resolved_declarations, bindings: resolved.symbol_index)
  match declared_type_inhabitance(obligation: obligation) {
    Inhabits { homomorphism: _ } => Accepted { value: true, diagnostics: None }
    InhabitanceUndecidable { reason: reason } => infer_inhabitance_undecidable_accepted(application: at, reason: reason)
    InhabitanceRefused { find_witness_reason: fw_reason } =>
      outcome_rejected(application_argument_does_not_inhabit_diagnostic(obligation: obligation, find_witness_reason: fw_reason))
  }
}

fn infer_gather_fold_bind_row_on_entries(
  node: Node,
  entries: Map<Node, List<InferredFacts>>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  rigid_binders: List<Symbol>,
) -> InferGatherFoldAcc {
  match infer_fold_bind_check(node: node, entries: entries, resolved: resolved) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: 0
      )
    Accepted { value: _, diagnostics: d } =>
      match infer_fold_init_closed(node: node, entries: entries, resolved: resolved) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
        Accepted { value: closed_entries, diagnostics: cd } =>
          infer_gather_transform_frontier_on_entries(
            node: node,
            entries: closed_entries,
            pending: diagnostics_merge(outer: diagnostics_merge(outer: pending, inner: d), inner: cd),
            partials: partials,
            kinds: kinds,
            resolved: resolved,
            instances: infer_no_type_variable_instances(),
            binder_types: infer_no_binder_types(),
            rigid_binders: rigid_binders
          )
      }
  }
}

// THE FOLD'S INIT FACT IS CLOSED WHERE THE FOLD CLOSES IT. infer_fold_bind_check closes an open carrier (`init: []`)
// at the type the step produces (infer_fold_carrier_closed_at) -- but only to JUDGE; the closed type was dropped and the
// init node kept the constructor-use variable it was minted with, which native emission then refuses as an unresolved type
// variable. Every other site that closes an open arm records the closure: a let annotation instantiates its bound value's
// fact (infer_judge_declared_position_closing) and a branch join replaces the held arm's root fact
// (infer_close_held_root_closed). The fold is one more declared position for its init, so it records the same closure through
// the same relation: the instances of the one closing relation, instantiated at the init's entry. A carrier already closed
// (a typed init) yields no instances and is left as written; so is a fold whose step type is not derived (the counted
// advisory infer_fold_bind_check already raised).
fn infer_fold_init_closed(node: Node, entries: Map<Node, List<InferredFacts>>, resolved: ResolvedTree) -> Outcome<Map<Node, List<InferredFacts>>> {
  match bind_value(n: node) {
    Absent => outcome_accepted(entries)
    Present { value: init } =>
      match infer_settled_type_at(target: init, entries: entries) {
        Absent => outcome_accepted(entries)
        Present { value: carrier } =>
          if infer_type_is_open(t: carrier) {
            match bind_slot_target(n: node, slot: BindBodySlot) {
              Absent => outcome_accepted(entries)
              Present { value: loop_node } =>
                match fold_loop_step(loop_node: loop_node) {
                  Absent => outcome_accepted(entries)
                  Present { value: step } =>
                    match infer_fold_step_produced(step: step, entries: entries) {
                      Absent => outcome_accepted(entries)
                      Present { value: produced } =>
                        match infer_close_produced_at_declared(declared: produced, produced: carrier, instances: Empty, declarations: resolved.resolved_declarations, bindings: resolved.symbol_index) {
                          Empty => outcome_accepted(entries)
                          Cons { head: h0, tail: ht } => infer_entries_instantiate_at(entries: entries, key: init, instances: Cons { head: h0, tail: ht })
                        }
                    }
                }
            }
          } else {
            outcome_accepted(entries)
          }
      }
  }
}

// What one step produces, as the fold carrier is judged against it: the declared return when the step has one (the
// second judgement of infer_fold_bind_check), else the settled type of the step body.
fn infer_fold_step_produced(step: Node, entries: Map<Node, List<InferredFacts>>) -> Optional<Node> {
  match fold_step_declared_return(step: step) {
    Present { value: declared_return } => Present { value: infer_declared_type_denotation(declared: declared_return) }
    Absent =>
      match fold_step_body_node(step: step) {
        Absent => Absent
        Present { value: body } => infer_settled_type_at(target: body, entries: entries)
      }
  }
}

fn infer_gather_schedules_first(parent: Node, slot: ChildSlot) -> Bool {
  infer_loop_schedules_first(parent: parent, edge: slot.edge)
    || infer_application_schedules_before_callbacks(parent: parent, edge: slot.edge)
    || infer_bind_schedules_key_and_value_first(parent: parent, slot: slot)
    || infer_match_schedules_scrutinee_first(parent: parent, slot: slot)
}

// A BIND SCHEDULES ITS KEY AND ITS VALUE BEFORE ITS BODY. The two are what the body's frame reads from the
// parent's accumulator -- infer_let_body_frame takes the unannotated binder's type from the VALUE's settled
// facts (infer_settled_type_at over acc.entries) and an annotated one from the annotation edge, never from a
// sibling -- so their position in the schedule is a dependency, and textual/child position establishes none
// (gunbc.plans.demand_engine_program 2.4, specimen "Inference's own sibling dependencies"). Which child is
// the key and which the value is not re-derived here: the key is the binder v2.compiler.lexical_scope
// bind_binder reads (the reader resolve sites the binder with, and infer_is_let_bind gates on), the value
// is v2.compiler.lexical_scope bind_value, and the body stays in the rest group, where infer_let_body_slot enters it. The
// predicate classifies the CHILD'S SLOT, not its edge or target (v2.std.node bind_positional_slot over the slot's positional ordinal): the
// normalized tree may share one node at several positions, so a value and a body -- or an annotation and a
// value -- can carry equal edges, and only the slot says which role a child plays. For the layouts
// v2.std.compilers.body_lowering lower_bind and lower_bind_annotated write -- key, value, body, then the
// annotation -- the first group is the stored prefix and the schedule is stored order; an admitted Bind
// with its annotation between key and value is reordered to key, value, annotation, body, which still puts
// the value before the body and changes no fact the body reads.
fn infer_bind_schedules_key_and_value_first(parent: Node, slot: ChildSlot) -> Bool {
  match bind_binder(n: parent) {
    Present { value: _ } =>
      match slot.ordinal {
        PositionalOrdinal { index: i } =>
          match bind_positional_slot(ordinal: i) {
            BindBinderSlot => true
            BindValueSlot => true
            BindBodySlot => false
          }
        LabeledChild => false
      }
    Absent => false
  }
}

// A MATCH SCHEDULES ITS SCRUTINEE BEFORE ITS ARMS. Each arm's frame -- infer_match_arm_child_frame -- reads
// the scrutinee's settled facts from the parent's accumulator, for the arm's coverage obligation and for
// the type a pattern binder is typed with; the frame reads the scrutinee through infer_match_scrutinee. The
// scrutinee is told from an arm by its SLOT (v2.std.node match_positional_slot over the slot's positional
// ordinal), so an arm whose edge equals the scrutinee's stays an arm. Arms stay in the rest group, in stored order;
// for the layout v2.std.compilers.body_lowering lower_match writes the schedule is the stored order.
fn infer_match_schedules_scrutinee_first(parent: Node, slot: ChildSlot) -> Bool {
  match parent.kind {
    ComputationNode { behavior: Match } =>
      match slot.ordinal {
        PositionalOrdinal { index: i } =>
          match match_positional_slot(ordinal: i) {
            MatchScrutineeSlot => true
            MatchArmSlot => false
          }
        LabeledChild => false
      }
    ComputationNode { behavior: _ } => false
    TypeNode { connective: _ } => false
  }
}

// An application with no callback actual keeps its authored order: every edge is in the first group.
fn infer_application_schedules_before_callbacks(parent: Node, edge: Edge) -> Bool {
  match parent.kind {
    ComputationNode { behavior: Transform } => !infer_application_actual_is_callback(application: parent, edge: edge)
    ComputationNode { behavior: _ } =>
      match construct_tag_optional(n: parent) {
        Absent => false
        Present { value: _ } => !infer_construct_field_is_callback(construct: parent, edge: edge)
      }
    TypeNode { connective: _ } => false
  }
}

fn infer_loop_schedules_first(parent: Node, edge: Edge) -> Bool {
  match loop_edge_role(e: edge) {
    LoopDomainValue => infer_loop_takes_collection_member(loop_node: parent)
    LoopIteratedBody => false
    LoopBoundMeasure => false
    LoopCarrierBinder => false
    LoopRealizedDeclaration => false
    LoopEdgeUnrecognized => false
  }
}

// The frame's entry is charged at the subtree root it opens, after that root's own init.
fn infer_gather_framed_init(acc: InferGatherFoldAcc, frame: InferFrame) -> InferGatherFoldAcc {
  let stamped = infer_gather_stamp_declared_position_expected(acc: acc, expected: frame.declared_position_expected, rigid_binders: frame.rigid_binders, frame_instances: frame.instances)
  match frame.entering {
    InferFrameEnteredPlain => stamped
    InferFrameEnteredWith { advisory: a } =>
      InferGatherFoldAcc {
        node: stamped.node,
        entries: stamped.entries,
        failed: stamped.failed,
        pending: diagnostics_merge(outer: Some { diagnostics: a }, inner: stamped.pending),
        await_branch_row: stamped.await_branch_row,
        await_match_row: stamped.await_match_row,
        await_loop_row: stamped.await_loop_row,
        await_transform_row: stamped.await_transform_row,
        children_remaining: stamped.children_remaining,
        declared_position_expected: stamped.declared_position_expected,
        rigid_binders: stamped.rigid_binders,
        frame_instances: stamped.frame_instances,
        demands: stamped.demands,
        branch_hold: stamped.branch_hold
      }
    InferFrameEnteredRefused { refused: r } =>
      infer_gather_fold_acc_failed(
        node: stamped.node,
        pending: rejected_with_pending(pending: stamped.pending, rejected: r),
        await_branch_row: stamped.await_branch_row,
        await_match_row: stamped.await_match_row,
        await_loop_row: stamped.await_loop_row,
        await_transform_row: stamped.await_transform_row,
        children_remaining: stamped.children_remaining
      )
  }
}

fn infer_gather_fold_algebra(partials: List<Node>, kinds: List<RosterKindIndex>, resolved: ResolvedTree) -> NodeFoldDependent<InferFrame, InferGatherFoldAcc> {
  NodeFoldDependent {
    init: fn(n0, frame) {
      infer_gather_framed_init(
        acc: infer_gather_fold_init(n: n0, partials: partials, kinds: kinds, resolved: resolved, instances: frame.instances, binder_types: frame.binder_types, rigid_binders: frame.rigid_binders),
        frame: frame
      )
    },
    first: fn(parent, s) { infer_gather_schedules_first(parent: parent, slot: s) },
    child_context: fn(parent, frame, acc, s) {
      infer_gather_child_context(parent: parent, frame: frame, acc: acc, slot: s, resolved: resolved)
    },
    step: fn(acc, e, child) {
      infer_gather_fold_step(acc: acc, edge: e, child: child, partials: partials, kinds: kinds, resolved: resolved)
    }
  }
}

fn infer_grounding_admits_infer_facts(grounding: CanonicalGrounding) -> Bool {
  canonical_grounding_admits_infer_facts(grounding: grounding)
}

fn infer_gather_for_tree(tree: ResolvedTree) -> InferGatherFoldAcc {
  let partials = partial_bounded_lattice_instances_in_tree(tree: tree.root)
  let kinds = infer_language_inhabitants_kind_index()
  fold_node_dependent(n: tree.root, ctx: infer_root_frame(), algebra: infer_gather_fold_algebra(partials: partials, kinds: kinds, resolved: tree))
}

fn infer_entries_for_tree(tree: ResolvedTree) -> Outcome<Map<Node, List<InferredFacts>>> {
  infer_gather_acc_to_outcome(acc: infer_gather_for_tree(tree: tree))
}
// INFER'S OUTPUT IS THE OBLIGATED FORM, never an InferredTree: v2.compiler.refinement_discharge
// discharge_refinement_obligations is the one route onward. The only obligation producer is the
// producer is the interim literal-only judgment (InferLiteralRefinementDemand): a literal at a
// where-refinement's carrier, as a call argument or a record field, records `predicate(literal)` for
// discharge to evaluate; every other tree discharges with nothing to evaluate.
// INFER ADMITS ONLY A WELL-FORMED TREE. Resolve refuses an ill-formed root, but infer is also entered
// directly with a ResolvedTree, so the Node-admission wall (v2.std.node well_formed -- including A4's
// Named-binder domain without an order edge) is held here too, and the rung is the same on every path.
fn infer(tree: ResolvedTree) -> Outcome<ObligatedInferredTree> {
  if !well_formed(n: tree.root) {
    outcome_rejected(infer_malformed_tree_diagnostic(n: tree.root))
  } else {
    infer_well_formed(tree: tree)
  }
}

fn infer_malformed_tree_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_malformed_tree,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// THE CALLER-ADMISSION WALL RUNS AFTER THE FACTS GATHER, with the gather's entries in hand: a
// callee is reached as a resolved reference (a Conj, not an Arrow), and the one authority for the
// arrow behind such a reference is the use's facts entry (infer_application_callee_arrow_with_facts)
// — the same accessor every other callee-arrow consumer (formals, type parameters, argument
// inhabitance) runs through. Before this reorder the wall read infer_operator_arrow on the
// reference itself and answered Absent for every name-resolved callee, admitting them unjudged —
// the exact silent widen DESIGN section 5 refuses. Refusal keeps the gather's diagnostics, so no
// evidence is dropped by the short-circuit.
fn infer_well_formed(tree: ResolvedTree) -> Outcome<ObligatedInferredTree> {
  let sealed = infer_sole_constructor_diags(tree: tree)
  let gathered = infer_gather_for_tree(tree: tree)
  match infer_gather_acc_to_outcome(acc: gathered) {
    Rejected { diagnostics: r } =>
      match sealed {
        None => Rejected { diagnostics: r }
        Some { diagnostics: sd } =>
          Rejected { diagnostics: non_empty_diagnostics_append(a: r, b: sd) }
      }
    Accepted { value: entries, diagnostics: d } =>
      match diagnostics_merge(
        outer: infer_caller_admission_diags(tree: tree, entries: entries),
        inner: sealed
      ) {
        Some { diagnostics: ned } =>
          match d {
            None => Rejected { diagnostics: ned }
            Some { diagnostics: da } =>
              Rejected { diagnostics: non_empty_diagnostics_append(a: da, b: ned) }
          }
        None =>
          match infer_demands_to_obligations(tree: tree, entries: entries, demands: gathered.demands) {
            Rejected { diagnostics: dr } =>
              match d {
                None => Rejected { diagnostics: dr }
                Some { diagnostics: da } => Rejected { diagnostics: non_empty_diagnostics_append(a: da, b: dr) }
              }
            Accepted { value: ready, diagnostics: dd } =>
              Accepted {
                value: ObligatedInferredTree {
                  root: tree.root,
                  facts: facts_partial_function_of_index(index: ready.entries),
                  obligations: ready.obligations
                },
                diagnostics: diagnostics_merge(outer: d, inner: dd)
              }
          }
      }
  }
}

type InferDemandsDischargeable {
  allocator: ScopedOccurrenceAllocator
  entries: Map<Node, List<InferredFacts>>
  obligations: List<RefinementObligation>
}

// THE OBLIGATION POST-PASS. Each demand becomes one RefinementObligation whose application is the closed call
// `predicate(literal)`, a synthetic Transform that is inferred through THIS stage's own gather fold (not read
// by a second route) so discharge evaluates it over real facts. Its occurrence is PROJECTED from the literal's
// authored occurrence by the existing allocator, computed once past the tree's ceiling; a literal with no
// authored occurrence cannot be placed and refuses, never drops its demand. The synthetic nodes' facts join the
// tree's index only where the tree holds none (the literal and the predicate callee may already have an entry).
// No demand, no work: the common tree returns its entries untouched.
fn infer_demands_to_obligations(
  tree: ResolvedTree,
  entries: Map<Node, List<InferredFacts>>,
  demands: List<InferLiteralRefinementDemand>,
) -> Outcome<InferDemandsDischargeable> {
  let fresh = InferDemandsDischargeable {
    allocator: scoped_occurrence_allocator(alloc: node_occurrence_allocator_after(root: tree.root), scope: content_hash(n: tree.root)),
    entries: entries,
    obligations: Empty
  }
  match demands {
    Empty => outcome_accepted(value: InferDemandsDischargeable { allocator: fresh.allocator, entries: entries, obligations: Empty })
    Cons { head: _, tail: _ } =>
      let partials = partial_bounded_lattice_instances_in_tree(tree: tree.root)
      let kinds = infer_language_inhabitants_kind_index()
      fold(
        demands,
        init: Accepted { value: fresh, diagnostics: None },
        f: fn(acc, demand) {
          match acc {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: state, diagnostics: pd } =>
              match authored_occurrence_id(n: demand.site) {
                Absent =>
                  outcome_rejected(Diagnostic {
                    reason: ^infer_reason_refinement_demand_site_unplaceable,
                    at: node_locus(node: demand.site),
                    correction: Unavailable { reason: CorrectionNotModeled }
                  })
                Present { value: source } =>
                  let allocated = alloc_projected_occurrence(allocator: state.allocator, source: source)
                  let application = node_with_occurrence_id(
                    kind: ComputationNode { behavior: Transform },
                    children: [
                      Edge { label: Positional, target: demand.predicate, declaration: NotADeclaration },
                      Edge { label: Positional, target: demand.site, declaration: NotADeclaration }
                    ],
                    occurrence_id: allocated.identity
                  )
                  match infer_gather_acc_to_outcome(
                    acc: fold_node_dependent(
                      n: application,
                      ctx: infer_root_frame(),
                      algebra: infer_gather_fold_algebra(partials: partials, kinds: kinds, resolved: tree)
                    )
                  ) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: inferred, diagnostics: sd } =>
                      Accepted {
                        value: InferDemandsDischargeable {
                          allocator: allocated.allocator,
                          entries: infer_entries_adopt_absent(into: state.entries, from: inferred),
                          obligations: list_snoc_item(xs: state.obligations, item: RefinementObligation {
                            site: demand.site,
                            application: application,
                            target: demand.target
                          })
                        },
                        diagnostics: diagnostics_merge(outer: pd, inner: sd)
                      }
                  }
              }
          }
        }
      )
  }
}

fn infer_entries_adopt_absent(
  into: Map<Node, List<InferredFacts>>,
  from: Map<Node, List<InferredFacts>>,
) -> Map<Node, List<InferredFacts>> {
  fold_list(xs: map_support_keys(m: from), empty: into, cons: fn(acc, key) {
    match map_lookup(m: acc, key: key) {
      Present { value: _ } => acc
      Absent =>
        match map_lookup(m: from, key: key) {
          Present { value: held } => map_insert(m: acc, key: key, value: held)
          Absent => acc
        }
    }
  })
}

// ===================================================================
// CALLER ADMISSION — the admit_callers wall.
//
// Restoration of the former drop gunbc.rung_drop.admit_callers_discarded_on_the_native_route:
// a v2 stage (this one) now checks caller admission on the native route from the fn's declared
// admit_callers list, refusing a call from a declaration outside it. The clause was parsed by
// the v2 grammar and carried onto the Arrow by v2.compiler.body_lowering_fold
// body_lower_fn_admit_clause_edges — the carrier added together with this consumer, as that
// former drop's trigger requires.
//
// THE SEMANTICS ARE THE SEED'S, copied symbol for symbol from v1's wall
// (src/v1/stage0/src/v1_compiler_infer.rs constructor_call_admission_diags, gated by
// constructor_reference_admission_enforced() -> true):
//   - a permitted caller is named by a decl_ref(module_path: "...", decl_name: "...") entry;
//     an entry that cannot be read as that call refuses (v1 AdmitCallersEntryNotDeclRef) rather
//     than shrinking the roster silently;
//   - the caller's coords are its enclosing declaration's (module, name) — v1's
//     caller_decl_coords read the enclosing fn scope; here the enclosing module member, keyed in
//     infer_admission_child_context — and membership is v1's decl_ref_coords_equal;
//   - a call under no declaration has no caller coords and refuses (v1's None arm, the recorded
//     behavior of gunbc.recurring_failure_mode
//     admit_callers_names_no_caller_for_a_data_declaration);
//   - no same-module or test-module exemption exists in the seed and none is added here: the
//     corpus's forged-proof probe modules are negative fixtures whose compile refusal is the
//     designed and enrolled behavior (measured, ruling C of lively-ram-153, 2026-10-02: all five
//     dag/test/probe modules refuse under the v1 seed with ConstructorCallAdmissionRefused among
//     their blocking errors).
// ===================================================================

// THE ADMITTED CALLER'S COORDS, AS THE CLAUSE AUTHORS THEM (the ROSTER ENTRY's image): the
// declaring module's dotted spelling and the declaration's name, both as interned lexemes. The
// module path is a plain Symbol, not an Optional: every authored entry names its module, so no
// Absent case can be WRITTEN here -- an entry whose module does not read is uninterpretable and
// refuses at the entry (the record demand), never silently skipped (review 77558: the dead
// `Absent => acc` arm the Optional invited).
type InferAdmitCallerCoords {
  module_path: Symbol
  decl_name: Symbol
}

// THE CALLER'S KEY, AS DESCENT KEYED IT: the innermost enclosing declaration's name. The caller's
// MODULE is the tree's module and is judged separately -- infer_admission_from_roster unwraps it
// first and refuses ^infer_reason_caller_admission_module_unreadable when the root carries none.
// A caller key without a module field cannot fall out of the judgment as a silent skip: the module
// comparison cannot be written wrong at the point of judgment.
type InferAdmissionCallerKey {
  decl_name: Symbol
}

type InferAdmissionCtx {
  caller: Optional<InferAdmissionCallerKey>
  module_symbol: Optional<Symbol>
}

type InferAdmitEntry
  = AdmitEntryCoords { coords: InferAdmitCallerCoords }
  | AdmitEntryUninterpretable

// THE RECORD SHAPE DEMAND: [ decl_ref -> atom(^decl_ref), module_path -> atom, decl_name -> atom ] —
// the AUTHORED operator edge demands the authored spelling (^decl_ref, v1's gate: only a decl_ref
// call states coordinates), and both atom identities must be present. Absent = the child is not such
// a record.
fn infer_admit_record_check(record: Node) -> Optional<InferAdmitCallerCoords> {
  match infer_admit_record_operator_spelling(record: record) {
    Absent => optional_absent()
    Present { value: _ } =>
      match infer_admit_entry_field_symbol(record: record, field: ^module_path) {
        Absent => optional_absent()
        Present { value: mp } =>
          match infer_admit_entry_field_symbol(record: record, field: ^decl_name) {
            Absent => optional_absent()
            Present { value: dn } =>
              optional_present(value: InferAdmitCallerCoords { module_path: mp, decl_name: dn })
          }
      }
  }
}

// THE RECORD'S OPERATOR SPELLING: the AUTHORED `decl_ref` edge the lowering carried from the authored
// call must name the ^decl_ref atom. A record without it is not a decl_ref call's image.
fn infer_admit_record_operator_spelling(record: Node) -> Optional<Symbol> {
  match named_child_lookup(root: record, name: ^decl_ref) {
    NamedChildFound { target: target } =>
      match infer_admit_atom_identity(node: target) {
        Absent => optional_absent()
        Present { value: op } =>
          if symbol_eq(a: op, b: ^decl_ref) {
            optional_present(value: op)
          } else {
            optional_absent()
          }
      }
    NamedChildMissing => optional_absent()
    NamedChildAmbiguous => optional_absent()
  }
}

// ONE ENTRY OF THE LIST, READ OR REFUSED. The carrier re-hung the authored call as a POSITIONAL
// record conj [ module_path -> atom, decl_name -> atom ]; the record's atom identities ARE the
// coords. Anything else is uninterpretable and refuses at the entry — an entry that cannot be
// interpreted would otherwise be dropped, silently shrinking the permitted-caller roster below
// what was authored.
fn infer_admit_entry_interpret(entry: Node) -> InferAdmitEntry {
  match infer_admit_record_check(record: entry) {
    Absent => AdmitEntryUninterpretable
    Present { value: coords } => AdmitEntryCoords { coords: coords }
  }
}

// THE ONE NAMED FIELD'S STRING VALUE, as an interned lexeme: the record conj's authored edge
// `field` carries an atom whose identity is the interned lexeme.
fn infer_admit_entry_field_symbol(record: Node, field: Symbol) -> Optional<Symbol> {
  match named_child_lookup(root: record, name: field) {
    NamedChildFound { target: target } => infer_admit_atom_identity(node: target)
    NamedChildMissing => optional_absent()
    NamedChildAmbiguous => optional_absent()
  }
}

fn infer_admit_atom_identity(node: Node) -> Optional<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
    TypeNode { connective: Conj } => optional_absent()
    TypeNode { connective: Disj } => optional_absent()
    TypeNode { connective: Arrow } => optional_absent()
    TypeNode { connective: Instantiation } => optional_absent()
    ComputationNode { behavior: _ } => optional_absent()
  }
}

// THE ROSTER'S RECORDS, read from the core edge target the carrier hung on the Arrow. The carrier
// re-hung each authored entry as a record conj in a left-named spine — @left carries the record, @right
// the rest, the empty conj root ends the spine (a conforming conj: every edge authored and distinct
// within its node). A decl_ref call's image is a record conj; an entry that reads but is not such a
// call is a marker record the record demand refuses at the entry (DESIGN §5: a failure arm must
// refuse, never widen). A target that is NOT a walkable spine is the carrier's fail-closed fallback —
// the authored spine did not read — and REFUSES with ^infer_reason_admit_callers_entries_unreadable
// at the clause: a malformed clause is never a shorter roster, and the refusal names the cause instead
// of the downstream refused-call verdict.
fn infer_admit_clause_entries(roster: Node) -> Outcome<List<Node>> {
  infer_admit_spine_entries(spine: roster)
}

fn infer_admit_spine_entries(spine: Node) -> Outcome<List<Node>> {
  match spine.kind {
    TypeNode { connective: Conj } =>
      if is_empty_conj_root(n: spine) {
        outcome_accepted(value: Empty)
      } else {
        match sugar_sequence_pair_optional(node: spine) {
          Absent =>
            outcome_rejected(Diagnostic {
              reason: ^infer_reason_admit_callers_entries_unreadable,
              at: node_locus(node: spine),
              correction: Unavailable { reason: ExternalContractUnknown }
            })
          Present { value: pair } =>
            match infer_admit_record_check(record: pair.left) {
              Absent =>
                outcome_rejected(Diagnostic {
                  reason: ^infer_reason_admit_callers_entry_not_decl_ref,
                  at: node_locus(node: pair.left),
                  correction: Unavailable { reason: UserInputBoundary }
                })
              Present { value: _ } =>
                match infer_admit_spine_entries(spine: pair.right) {
                  Rejected { diagnostics: d } => Rejected { diagnostics: d }
                  Accepted { value: rest, diagnostics: _ } =>
                    outcome_accepted(value: Cons { head: pair.left, tail: rest })
                }
            }
        }
      }
    TypeNode { connective: Atom { identity: _ } } =>
      outcome_rejected(Diagnostic {
        reason: ^infer_reason_admit_callers_entries_unreadable,
        at: node_locus(node: spine),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    TypeNode { connective: Arrow } =>
      outcome_rejected(Diagnostic {
        reason: ^infer_reason_admit_callers_entries_unreadable,
        at: node_locus(node: spine),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    TypeNode { connective: Instantiation } =>
      outcome_rejected(Diagnostic {
        reason: ^infer_reason_admit_callers_entries_unreadable,
        at: node_locus(node: spine),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    TypeNode { connective: Disj } =>
      outcome_rejected(Diagnostic {
        reason: ^infer_reason_admit_callers_entries_unreadable,
        at: node_locus(node: spine),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    ComputationNode { behavior: _ } =>
      outcome_rejected(Diagnostic {
        reason: ^infer_reason_admit_callers_entries_unreadable,
        at: node_locus(node: spine),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}

// EVERY DIAGNOSTIC THE LIST CARRIES, folded into the stage's Diagnostics carrier.
fn infer_admission_diags_of(ds: List<Diagnostic>) -> Diagnostics {
  fold(ds, init: None, f: fn(acc, d) {
    diagnostics_merge(
      outer: acc,
      inner: Some { diagnostics: NonEmptyDiagnostics { head: d, tail: [] } }
    )
  })
}

type InferAdmitJudgement {
  matched: Bool
  diags: List<Diagnostic>
}

// EVERY ENTRY PLACED, THEN THE LIST'S VERDICT: uninterpretable entries refuse beside whatever
// they sit with; the call refuses when no entry names its caller (v1: ConstructorCallAdmissionRefused).
fn infer_admission_judge_entries(
  application: Node,
  entries: List<Node>,
  caller: InferAdmissionCallerKey,
  module_symbol: Symbol
) -> Diagnostics {
  let j = fold(entries, init: InferAdmitJudgement { matched: false, diags: [] }, f: fn(acc, entry) {
    match infer_admit_entry_interpret(entry: entry) {
      AdmitEntryUninterpretable =>
        InferAdmitJudgement {
          matched: acc.matched,
          diags: list_snoc_item(
            xs: acc.diags,
            item: Diagnostic {
              reason: ^infer_reason_admit_callers_entry_not_decl_ref,
              at: node_locus(node: entry),
              correction: Unavailable { reason: UserInputBoundary }
            }
          )
        }
      AdmitEntryCoords { coords: coords } =>
        if symbol_eq(a: coords.module_path, b: module_symbol) && symbol_eq(a: coords.decl_name, b: caller.decl_name) {
          InferAdmitJudgement { matched: true, diags: acc.diags }
        } else {
          acc
        }
    }
  })
  if j.matched {
    infer_admission_diags_of(ds: j.diags)
  } else {
    infer_admission_diags_of(ds: list_snoc_item(
      xs: j.diags,
      item: Diagnostic {
        reason: ^infer_reason_caller_admission_refused,
        at: node_locus(node: application),
        correction: Unavailable { reason: UserInputBoundary }
      }
    ))
  }
}

// ONE APPLICATION'S VERDICT UNDER `caller`. Only a callee whose Arrow carries the admit edge is
// judged; an unrostered callee imposes nothing (scope rule: the clause rides the fn Arrow, and a
// fn whose Arrow does not carry it is not restricted). An Ambiguous admit edge refuses at the
// application. The entries come from the facts gather, so an imported callee's clause is read the
// same way a same-module one is.
fn infer_caller_admission_application_diags(
  application: Node,
  caller: Optional<InferAdmissionCallerKey>,
  module_symbol: Optional<Symbol>,
  entries: Map<Node, List<InferredFacts>>,
  declarations: SymbolIndex
) -> Diagnostics {
  match application.kind {
    TypeNode { connective: Instantiation } => None
    TypeNode { connective: _ } => infer_caller_admission_callee_diags(application: application, caller: caller, module_symbol: module_symbol, entries: entries, declarations: declarations)
    ComputationNode { behavior: _ } =>
      match list_introduction_elements_optional(node: application) {
        Present { value: _ } => None
        Absent => infer_caller_admission_callee_diags(application: application, caller: caller, module_symbol: module_symbol, entries: entries, declarations: declarations)
      }
  }
}

// A LIST INTRODUCTION IS NOT A CALL EITHER (above). Its head is the marked reference to the declaration of
// the free monoid (v2.std.list_introduction), which names a TYPE: nothing is applied and no admit
// clause can ride it, so reading it as a callee found a declaration whose Arrow is unreadable and
// refused (caller_admission_callee_unreadable). Every declared fn carries one -- its parameter-order
// list (v2.std.arrow_signature) -- so once the head carried its identity from construction
// (v2-namespace-cutover N2), every module with a fn refused here. Asked through the one reader of the
// form, never by the head's spelling.

// A TYPE INSTANTIATION IS NOT A CALL (above): `List<Pair>` names a declaration as its head exactly as a
// call names its callee, but no admit clause rides a type's declaration and nothing is applied, so
// judging it read the type's Disj/Conj as a callee whose Arrow was unreadable and refused every module
// that wrote a generic type in a signature.
fn infer_caller_admission_callee_diags(
  application: Node,
  caller: Optional<InferAdmissionCallerKey>,
  module_symbol: Optional<Symbol>,
  entries: Map<Node, List<InferredFacts>>,
  declarations: SymbolIndex
) -> Diagnostics {
  match infer_application_callee_arrow_with_facts(node: application, entries: entries) {
    Absent =>
      match list_at_optional(xs: positional_child_target_nodes(node: application), index: 0) {
        Absent => None
        Present { value: child0 } =>
          match resolved_reference_body_kind(target: child0) {
            NotMarkedReference => None
            MarkedReference { kind: DeclarationReferenceKind } =>
              if infer_callee_is_roster_primitive_call(callee_ref: child0) {
                None
              } else {
              match infer_callee_declaration_from_declarations(declarations: declarations, callee_ref: child0) {
                Absent =>
                  infer_admission_diags_of([
                    Diagnostic {
                      reason: ^infer_reason_caller_admission_callee_unresolved,
                      at: node_locus(node: application),
                      correction: Suggested { node: child0 }
                    }
                  ])
                Present { value: decl } =>
                  match infer_operator_arrow(operator: decl) {
                    Absent =>
                      infer_admission_diags_of([
                        Diagnostic {
                          reason: ^infer_reason_caller_admission_callee_unreadable,
                          at: node_locus(node: application),
                          correction: Suggested { node: child0 }
                        }
                      ])
                    Present { value: arrow } =>
                      infer_caller_admission_judged_diags(
                        application: application,
                        caller: caller,
                        module_symbol: module_symbol,
                        arrow: arrow,
                        declarations: declarations
                      )
                  }
              }
              }
            MarkedReference { kind: _ } => None
          }
      }
    Present { value: arrow } =>
      infer_caller_admission_judged_diags(
        application: application,
        caller: caller,
        module_symbol: module_symbol,
        arrow: arrow,
        declarations: declarations
      )
  }
}

// THE CALLEE'S DECLARATION FROM THE RESOLVED-DECLARATIONS INDEX: a cross-module callee's facts are
// never in the subject's gather (the gather walks the subject root), so the wall reads the callee's
// own declaration node from resolved_declarations -- declarations WITH RESOLVED BODIES, imported
// modules included. THE BOUNDARY BETWEEN NO JUDGMENT AND REFUSAL: an operator child that is not
// marked as a declaration reference is no judgment -- the ordinary grounding machinery owns that
// call, no clause can exist for it, the wall imposes nothing (NotMarkedReference). But a child
// MARKED as a declaration reference (MarkedReference{DeclarationReferenceKind}) whose path has no
// entry in the index is NOT "not declared": the mark asserts a declaration stands behind the
// reference, so an unavailable one is an unresolved admission authority and the caller admission
// REFUSES on it (RosterLookupUnresolved -> infer_reason_caller_admission_callee_unresolved, fail
// closed). A FOUND declaration whose arrow cannot be read is the same kind of failure one step
// later and refuses separately (infer_reason_caller_admission_callee_unreadable). The two are
// distinct facts about the world -- the declaration missing versus the declaration present but
// unreadable -- and both refuse; neither shortens the roster nor admits.
fn infer_callee_declaration_from_declarations(declarations: SymbolIndex, callee_ref: Node) -> Optional<Node> {
  match declaration_reference_path_optional(node: callee_ref) {
    Absent => optional_absent()
    Present { value: qn } => symbol_index_lookup(index: declarations, qualified_path: qn)
  }
}

// A ROSTER PRIMITIVE-CALL HEAD IS NOT AN INDEXED FN. Resolve mints a DeclarationReference to the
// row's path (std.algebra.collection_concat_shape) so infer can type the call from the roster
// signature; that path names the template VALUE, not a callable with an admit_callers clause, and
// the subject's symbol index often does not even contain it (one-module fixtures). Asking the
// admission wall to resolve that mark in the index is the wrong authority: it refuses
// caller_admission_callee_unresolved (or callee_unreadable if the template happens to be in
// scope). The row itself carries no admit roster, so the wall imposes nothing -- the same Absent
// as an unmarked callee.
fn infer_callee_is_roster_primitive_call(callee_ref: Node) -> Bool {
  match declaration_reference_path_optional(node: callee_ref) {
    Absent => false
    Present { value: qn } =>
      match collection_roster_primitive_call_signature_at(path: qualified_name_to_dotted_string(qn: qn)) {
        NotARosterPrimitiveCallRow => false
        RosterPrimitiveCallSignature { arrow: _ } => true
        RosterPrimitiveCallSignatureUnreadable => true
      }
  }
}

fn infer_caller_admission_judged_diags(
  application: Node,
  caller: Optional<InferAdmissionCallerKey>,
  module_symbol: Optional<Symbol>,
  arrow: Node,
  declarations: SymbolIndex
) -> Diagnostics {
  match core_edge_target_lookup(children: arrow.children, marker: AdmitCallersEdge) {
    Ambiguous =>
      infer_admission_diags_of([
        Diagnostic {
          reason: ^infer_reason_admit_callers_edge_ambiguous,
          at: node_locus(node: application),
          correction: Unavailable { reason: UserInputBoundary }
        }
      ])
    NotFound =>
      match infer_caller_admission_roster_from_declarations(
        application: application,
        declarations: declarations
      ) {
        RosterLookupAbsent => None
        RosterLookupAmbiguous =>
          infer_admission_diags_of([
            Diagnostic {
              reason: ^infer_reason_admit_callers_edge_ambiguous,
              at: node_locus(node: application),
              correction: Unavailable { reason: UserInputBoundary }
            }
          ])
        RosterLookupUnreadable =>
          infer_admission_diags_of([
            Diagnostic {
              reason: ^infer_reason_caller_admission_callee_unreadable,
              at: node_locus(node: application),
              correction: match list_at_optional(xs: positional_child_target_nodes(node: application), index: 0) {
                Absent => Unavailable { reason: ExternalContractUnknown }
                Present { value: callee_ref } => Suggested { node: callee_ref }
              }
            }
          ])
        RosterLookupUnresolved =>
          infer_admission_diags_of([
            Diagnostic {
              reason: ^infer_reason_caller_admission_callee_unresolved,
              at: node_locus(node: application),
              correction: match list_at_optional(xs: positional_child_target_nodes(node: application), index: 0) {
                Absent => Unavailable { reason: ExternalContractUnknown }
                Present { value: callee_ref } => Suggested { node: callee_ref }
              }
            }
          ])
        RosterLookupFound { target: roster } => infer_admission_from_roster(
          application: application,
          caller: caller,
          module_symbol: module_symbol,
          roster: roster
        )
      }
    Found { target: roster } => infer_admission_from_roster(
      application: application,
      caller: caller,
      module_symbol: module_symbol,
      roster: roster
    )
  }
}

// THE ADMIT ROSTER'S ONE HOME IS THE RESOLVED TREE'S ARROW. The facts arrow is infer's CANONICAL
// GROUNDING of the callee reference -- a rebuilt copy whose formals and body survive but whose core
// metadata edges (the carrier's AdmitCallersEdge among them) do not. When the facts copy is
// unmarked, read the roster off the resolved-declarations arrow for the same declared callee.
// Absent when the application's operator child is not a marked reference at all, or the resolved
// arrow carries no roster (a fn without the clause -- the legitimate admit). Unresolved when the
// child IS marked as a declaration reference but no declaration stands behind it: that is not
// "not declared", it is a grounding failure, and the caller admission refuses on it (fail closed).
type InferAdmitRosterLookup
  = RosterLookupAbsent
  | RosterLookupAmbiguous
  | RosterLookupUnreadable
  | RosterLookupUnresolved
  | RosterLookupFound { target: Node }

fn infer_caller_admission_roster_from_declarations(
  application: Node,
  declarations: SymbolIndex
) -> InferAdmitRosterLookup {
  match list_at_optional(xs: positional_child_target_nodes(node: application), index: 0) {
    Absent => RosterLookupAbsent
    Present { value: child0 } =>
      match resolved_reference_body_kind(target: child0) {
        NotMarkedReference => RosterLookupAbsent
        MarkedReference { kind: DeclarationReferenceKind } =>
          if infer_callee_is_roster_primitive_call(callee_ref: child0) {
            RosterLookupAbsent
          } else {
          match infer_callee_declaration_from_declarations(declarations: declarations, callee_ref: child0) {
            Absent => RosterLookupUnresolved
            Present { value: decl } =>
              match infer_operator_arrow(operator: decl) {
                Absent => RosterLookupUnreadable
                Present { value: resolved_arrow } =>
                  match core_edge_target_lookup(children: resolved_arrow.children, marker: AdmitCallersEdge) {
                    NotFound => RosterLookupAbsent
                    Ambiguous => RosterLookupAmbiguous
                    Found { target: roster } => RosterLookupFound { target: roster }
                  }
              }
          }
          }
        MarkedReference { kind: _ } => RosterLookupAbsent
      }
  }
}

// THE JUDGMENT FROM A MINTED ROSTER. THE MODULE CHECK HAPPENS HERE, AT THE POINT OF JUDGMENT:
// comparing the roster's entry coordinates against the caller's module is the judgment; a
// fn-rooted grounding context carries no tree module, so the comparison is undetermined and the
// call refuses (module_unreadable, located at the call) rather than judge with a fabricated
// module -- fail closed where it matters, never at the root (a root-level refusal would refuse
// every fn-rooted context wholesale).
fn infer_admission_from_roster(
  application: Node,
  caller: Optional<InferAdmissionCallerKey>,
  module_symbol: Optional<Symbol>,
  roster: Node
) -> Diagnostics {
  match infer_admit_clause_entries(roster: roster) {
    Rejected { diagnostics: d } => Some { diagnostics: d }
    Accepted { value: records, diagnostics: _ } =>
      match caller {
        Absent => infer_admission_diags_of([
          Diagnostic {
            reason: ^infer_reason_caller_admission_caller_unkeyed,
            at: node_locus(node: application),
            correction: Unavailable { reason: UserInputBoundary }
          }
        ])
        Present { value: coords } =>
          match module_symbol {
            Absent => infer_admission_diags_of([
              Diagnostic {
                reason: ^infer_reason_caller_admission_module_unreadable,
                at: node_locus(node: application),
                correction: Unavailable { reason: UserInputBoundary }
              }
            ])
            Present { value: tree_module } =>
              infer_admission_judge_entries(
                application: application,
                entries: records,
                caller: coords,
                module_symbol: tree_module
              )
          }
      }
  }
}

// DESCENT KEYING. The namespace graft DISSOLVES the declaration member wrap and re-hangs each
// member's Arrow DIRECTLY under the module body conj, under an authored edge named for the
// declaration (v2.compiler.body_lowering_fold body_lower_fn_decl_named_member_wrap: "the wrap is a
// carrier, not the image root ... re-hangs the Arrow under the module; the Arrow is what stands for
// the authored declaration in the admitted tree"). So an AUTHORED edge whose target is an Arrow
// inside the grafted body names the declaration the calls below it sit in — the same edge resolve
// harvests the binding from (v2.compiler.lexical_scope module_root_bindings /
// try_edge_declared_binding). Keying REPLACES the caller, so a nested declaration keys its own
// calls once the descent passes its authored edge (innermost enclosing declaration wins, which is
// the caller v1 judged). Descending through any other edge keeps the enclosing caller.
fn infer_admission_child_context(self: Node, ctx: InferAdmissionCtx, edge: Edge) -> InferAdmissionCtx {
  match edge.label {
    Authored { name: member_name } =>
      match edge.target.kind {
        TypeNode { connective: Arrow } =>
          InferAdmissionCtx {
            caller: Present {
              value: InferAdmissionCallerKey { decl_name: member_name }
            },
            module_symbol: ctx.module_symbol
          }
        TypeNode { connective: Atom { identity: _ } } => ctx
        TypeNode { connective: Conj } => ctx
        TypeNode { connective: Disj } => ctx
        TypeNode { connective: Instantiation } => ctx
        ComputationNode { behavior: _ } => ctx
      }
    Positional => ctx
    StructuralLabel { label: _ } => ctx
  }
}

// THE ROOT'S MODULE NAME, when the root is a module: the caller-module key for module-rooted
// trees. A sub-tree root (a fn-rooted grounding context) reads as no module and the wall still
// runs -- see the judgment-point check in infer_admission_from_roster.
fn infer_admission_root_module_symbol(root: Node) -> Optional<Symbol> {
  match qualified_name_from_module_node(root: root) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: module_qn, diagnostics: _ } =>
      optional_present(value: symbol_intern_lexeme(lexeme: qualified_name_to_dotted_string(qn: module_qn)))
  }
}

// THE WALL, over the whole resolved tree, top-down so each application is judged under the
// declaration it sits in. The tree is judged however it is rooted: a module-rooted tree carries
// its module name in the descent context (it keys the caller's module); a sub-tree root (a
// fn-rooted grounding context -- the cross-language and self-host fixtures run infer on slices)
// carries NO module name, and the wall still runs. Failure arms FAIL CLOSED (DESIGN.md §5:
// refuse, never widen) -- but where they fail matters: an unreadable module name is not a
// tree-level fault, it is unreadable only where a judgment needs it, so the refusal fires at the
// application being judged (module_unreadable, located at the call), never as a root-level
// precondition that would refuse every fn-rooted context wholesale.
fn infer_caller_admission_diags(tree: ResolvedTree, entries: Map<Node, List<InferredFacts>>) -> Diagnostics {
  fold_node_topdown(
    n: tree.root,
    ctx: InferAdmissionCtx {
      caller: Absent,
      module_symbol: infer_admission_root_module_symbol(root: tree.root)
    },
        algebra: NodeFoldTopDown {
          init: fn(self, ctx) {
            infer_caller_admission_application_diags(
              application: self,
              caller: ctx.caller,
              module_symbol: ctx.module_symbol,
              entries: entries,
              declarations: tree.resolved_declarations
            )
          },
          child_context: fn(self, ctx, edge) { infer_admission_child_context(self: self, ctx: ctx, edge: edge) },
          step: fn(acc, _edge, sub) { diagnostics_merge(outer: acc, inner: sub) }
        }
      )
}

// ===================================================================
// SOLE_CONSTRUCTOR — the construction wall.
//
// Native construction wall (retired the former native-route modifier-parse drop):
// v2 parse already mints TypeDeclModifier onto NormalizedTree.type_declaration_modifiers.
// This stage consumes that channel from ResolvedTree and refuses a construction of a
// sole_constructor type whose constructing MODULE is not the declaring module.
// Forms: record literal, `as` cast, variant construction of a sealed coproduct, and
// parameter-default expressions (BinderDefaultEdge is walked with the rest of the tree).
// A match-arm PATTERN is not construction: MatchArmPatternEdge subtrees are skipped
// (destructure of a received value does not mint one). The constructing MODULE is
// ResolvedTree.constructing_module, captured when the tree was resolved from a module
// root and copied through extraction (attempt_joined); it is not re-read from the
// current root. Unreadable modifier provenance or missing owner refuses (fail-closed).
// The channel is always Captured: a declaring module outside `covered` is unreadable,
// not open. A hand-built tree must name the modules it claims; `covered` Empty claims none.
type InferSoleCtorCtx {
  constructing_module: Optional<Symbol>
  in_pattern: Bool
}

fn infer_sole_constructor_child_context(ctx: InferSoleCtorCtx, edge: Edge) -> InferSoleCtorCtx {
  if ctx.in_pattern {
    ctx
  } else {
    if edge_is_core(e: edge, marker: MatchArmPatternEdge) {
      InferSoleCtorCtx { constructing_module: ctx.constructing_module, in_pattern: true }
    } else {
      ctx
    }
  }
}

fn infer_sole_constructor_diags(tree: ResolvedTree) -> Diagnostics {
  fold_node_topdown(
    n: tree.root,
    ctx: InferSoleCtorCtx {
      constructing_module: tree.constructing_module,
      in_pattern: false
    },
    algebra: NodeFoldTopDown {
      init: fn(self, ctx) {
        if ctx.in_pattern {
          None
        } else {
          infer_sole_constructor_node_diags(node: self, constructing_module: ctx.constructing_module, tree: tree)
        }
      },
      child_context: fn(_self, ctx, edge) { infer_sole_constructor_child_context(ctx: ctx, edge: edge) },
      step: fn(acc, _edge, sub) { diagnostics_merge(outer: acc, inner: sub) }
    }
  )
}

fn infer_sole_constructor_is_cast(node: Node) -> Bool {
  if infer_transform_is_cast(node: node) {
    true
  } else {
    match list_at_optional(xs: positional_child_target_nodes(node: node), index: 0) {
      Absent => false
      Present { value: op } =>
        match node_atom_identity_optional(node: op) {
          Absent => false
          Present { value: id } => id == ^dag_token_kw_as
        }
    }
  }
}

fn infer_sole_constructor_node_diags(
  node: Node,
  constructing_module: Optional<Symbol>,
  tree: ResolvedTree
) -> Diagnostics {
  if infer_sole_constructor_is_cast(node: node) {
    match cast_target_optional(n: node) {
      Absent =>
        infer_admission_diags_of([
          Diagnostic {
            reason: ^infer_reason_sole_constructor_target_unreadable,
            at: node_locus(node: node),
            correction: Unavailable { reason: UserInputBoundary }
          }
        ])
      Present { value: target } =>
        match infer_sole_constructor_head_path(n: target) {
          SealedPathAbsent => None
          SealedPathUnreadable =>
            infer_admission_diags_of([
              Diagnostic {
                reason: ^infer_reason_sole_constructor_target_unreadable,
                at: node_locus(node: node),
                correction: Suggested { node: target }
              }
            ])
          SealedPathFound { path: path } =>
            infer_sole_constructor_path_diags(
              at: node,
              type_path: path,
              constructing_module: constructing_module,
              tree: tree
            )
        }
    }
  } else {
    match infer_record_construct_read(node: node, resolved: tree) {
      ConstructIsRecord { construct: construct } =>
        infer_sole_constructor_path_diags(
          at: node,
          type_path: construct.path,
          constructing_module: constructing_module,
          tree: tree
        )
      ConstructIsVariantArm { construct: construct } =>
        infer_sole_constructor_path_diags(
          at: node,
          type_path: construct.variant_path,
          constructing_module: constructing_module,
          tree: tree
        )
      ConstructVariantArmIdentityUnavailable =>
        infer_admission_diags_of([
          infer_declaration_identity_unavailable_diagnostic(at: node)
        ])
      ConstructVariantArmIdentityContested { claimants: claimants } =>
        match infer_declaration_identity_contested_diagnostics(at: node, claimants: claimants) {
          NonEmptyDiagnostics { head: head, tail: tail } =>
            infer_admission_diags_of(Cons { head: head, tail: tail })
        }
      ConstructVariantArmBodyUnavailable =>
        infer_admission_diags_of([
          infer_declaration_body_unavailable_diagnostic(at: node)
        ])
      ConstructNotARecord =>
        match construct_tag_path_optional(n: node) {
          Absent => None
          Present { value: path } =>
            match symbol_index_declaring_path_of(index: tree.symbol_index, target: path) {
              MentionDeclaringContested { claimants: claimants } =>
                match infer_declaration_identity_contested_diagnostics(at: node, claimants: claimants) {
                  NonEmptyDiagnostics { head: head, tail: tail } =>
                    infer_admission_diags_of(Cons { head: head, tail: tail })
                }
              MentionDeclaringUnavailable =>
                infer_admission_diags_of([
                  infer_declaration_identity_unavailable_diagnostic(at: node)
                ])
              MentionDeclaringUnique { declaring: _ } =>
                match infer_coproduct_path_of_variant_arm_joined(bindings: tree.symbol_index, arm_path: path) {
                  Present { value: coproduct } =>
                    infer_sole_constructor_path_diags(
                      at: node,
                      type_path: coproduct,
                      constructing_module: constructing_module,
                      tree: tree
                    )
                  Absent =>
                    infer_admission_diags_of([
                      infer_declaration_identity_unavailable_diagnostic(at: node)
                    ])
                }
            }
        }
    }
  }
}

type InferSealedPathRead
  = SealedPathAbsent
  | SealedPathUnreadable
  | SealedPathFound { path: QualifiedName }

fn infer_sole_constructor_head_path(n: Node) -> InferSealedPathRead {
  match declaration_reference_path_optional(node: n) {
    Present { value: path } => SealedPathFound { path: path }
    Absent =>
      match resolved_reference_body_kind(target: n) {
        MarkedReference { kind: DeclarationReferenceKind } => SealedPathUnreadable
        MarkedReference { kind: _ } => SealedPathAbsent
        NotMarkedReference =>
          match n.kind {
            TypeNode { connective: Instantiation } =>
              match list_at_optional(xs: positional_child_target_nodes(node: n), index: 0) {
                Absent => SealedPathUnreadable
                Present { value: head } => infer_sole_constructor_head_path(n: head)
              }
            TypeNode { connective: _ } => SealedPathAbsent
            ComputationNode { behavior: _ } => SealedPathAbsent
          }
      }
  }
}

fn infer_sole_constructor_path_diags(
  at: Node,
  type_path: QualifiedName,
  constructing_module: Optional<Symbol>,
  tree: ResolvedTree
) -> Diagnostics {
  match symbol_index_declaring_path_of(index: tree.symbol_index, target: type_path) {
    MentionDeclaringUnavailable =>
      infer_admission_diags_of([
        infer_declaration_identity_unavailable_diagnostic(at: at)
      ])
    MentionDeclaringContested { claimants: claimants } =>
      match infer_declaration_identity_contested_diagnostics(at: at, claimants: claimants) {
        NonEmptyDiagnostics { head: head, tail: tail } =>
          infer_admission_diags_of(Cons { head: head, tail: tail })
      }
    MentionDeclaringUnique { declaring: declaring_path } =>
      match qualified_name_last_segment(qn: declaring_path) {
        Absent =>
          infer_admission_diags_of([
            Diagnostic {
              reason: ^infer_reason_sole_constructor_ownership_unreadable,
              at: node_locus(node: at),
              correction: Unavailable { reason: UserInputBoundary }
            }
          ])
        Present { value: name } =>
          let module = qualified_name_init(qn: declaring_path)
          match type_declaration_modifier_row_at(
            channel: tree.type_declaration_modifiers,
            module: module,
            name: name
          ) {
            TypeDeclModifierRowAbsent => None
            TypeDeclModifierModuleUncovered =>
              infer_admission_diags_of([
                Diagnostic {
                  reason: ^infer_reason_sole_constructor_modifiers_unreadable,
                  at: node_locus(node: at),
                  correction: Unavailable { reason: UserInputBoundary }
                }
              ])
            TypeDeclModifierRowPresent { modifiers: modifiers } =>
              infer_sole_constructor_owner_diags(
                at: at,
                declaring_module: module,
                modifiers: modifiers,
                constructing_module: constructing_module
              )
          }
      }
  }
}

fn infer_sole_constructor_owner_diags(
  at: Node,
  declaring_module: QualifiedName,
  modifiers: FreeMonoid<TypeDeclModifier>,
  constructing_module: Optional<Symbol>
) -> Diagnostics {
  if !type_decl_modifiers_include_sole_constructor(modifiers: modifiers) {
    None
  } else {
    match constructing_module {
      Absent =>
        infer_admission_diags_of([
          Diagnostic {
            reason: ^infer_reason_sole_constructor_ownership_unreadable,
            at: node_locus(node: at),
            correction: Unavailable { reason: UserInputBoundary }
          }
        ])
      Present { value: ctor_mod } =>
        if symbol_eq(
          a: ctor_mod,
          b: symbol_intern_lexeme(lexeme: qualified_name_to_dotted_string(qn: declaring_module))
        ) {
          None
        } else {
          infer_admission_diags_of([
            Diagnostic {
              reason: ^infer_reason_sole_constructor_refused,
              at: node_locus(node: at),
              correction: Unavailable { reason: UserInputBoundary }
            }
          ])
        }
    }
  }
}

data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow { subject: PathSubject { path: "infer_arrow_declared_return_check" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "infer_declared_binder_scope" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "infer_declared_position_undecidable_reason" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "infer_declared_type_denotation" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "infer_gather_fold_step" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "infer_literal_payload_member_type" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
  FrontierRow { subject: PathSubject { path: "infer_sum_nullary_payload_edge" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
]

// A VARIANT'S PAYLOAD IS THE TARGET OF ITS TAG EDGE, NOT A DECLARED FIELD. A coproduct is a Disj whose
// Authored edges are labelled by variant tag and target the payload Conj directly; declared_field_from_edge
// answers only for an edge whose target is a binder node (v2.std.node_query binder_node_parts), so reading a
// variant through it answered Absent for every tag once fields became binder nodes, and every match refused
// as infer_match_pattern_variant_not_declared. The payload's FIELDS are declared fields and keep that reader.
fn infer_match_variant_payload(variants: Node, tag: Symbol) -> Optional<Node> {
  fold(variants.children, init: Absent, f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match e.label {
          Authored { name: variant } => if variant == tag { optional_present(value: e.target) } else { Absent }
          StructuralLabel { label: _ } => Absent
          Positional => Absent
        }
    }
  })
}
