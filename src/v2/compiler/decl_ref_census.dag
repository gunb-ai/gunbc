module v2.compiler.decl_ref_census

import std.algebra { Cons, Empty, FreeMonoid, fold_list, length, list_head, list_append, list_reverse, list_snoc_item, map_lookup }
import std.decl_ref { DeclField, DeclarationRef, NamedField, TypeParameter, WholeDeclaration, declaration_ref_display_key, declaration_ref_eq }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.types { List, Map, NonEmptyStr }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.namespace_alias { AliasBindingRow }
import v2.compiler.name_resolve { ResolutionContext }
import v2.std.compilers.lexing { Token }
import v2.std.decl_ref_resolution {
  DeclarationRefDeclarationAbsent,
  DeclarationRefFieldAbsent,
  DeclarationRefModuleAbsent,
  DeclarationRefContested,
  DeclarationRefResolution,
  DeclarationRefResolved,
  resolve_declaration_ref
}
import v2.std.integer { Int }
import v2.extdeps.languages.dag { dag_string_literal_value_symbol_optional }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.type_binder { edge_is_type_alias, type_alias_wrapper_is, type_decl_wrapper_target }
import v2.std.node { Authored, Bind, Edge, Branch, ComputationNode, Loop, Match, Node, NodeFold, Positional, StructuralLabel, Transform, TypeNode, Value, fold_node, symbol_lexeme }
import v2.std.node_query { construct_field_edges, construct_tag_path_optional }
import v2.std.qualified_name { declaration_reference_path_optional, qualified_name_from_dotted_string, qualified_name_from_node, qualified_name_spine_shape_present, qualified_name_to_dotted_string }
import v2.compiler.decl_ref_disposition_roster { CitedDeclaration, CitedSpan, ComputedDeclName, DeclRefDisposition, DeclRefSubject, decl_ref_disposition_roster }
import gunbc.source_layout { layout_module_storage_path }
import v2.std.text { String, string_all_chars_in, string_any_char_in }

// THE DECLARATION-REFERENCE AND PROSE-SYMBOL CENSUS (a pure reader; the verb is
// v2.compiler.source_root_eval `decl-ref-census`). Two populations, one resolver:
//
//   * every `DeclarationRef { module_path: "..", decl_name: "..", field: .. }` literal of the RESOLVED
//     Node trees (constructs whose tag resolves to std.decl_ref DeclarationRef), resolved by v2.std.decl_ref_resolution against the native ingest's ResolutionContext;
//   * every backtick span inside a string literal of the files the caller scopes in (the
//     recurring-failure-mode and rung_drop ledgers), classified by the CLOSED grammar below.
//
// A span is exactly one of four, and the grammar is decidable on the span's characters alone:
//   SymbolShaped  -- dotted identifier segments whose first segment is a top-level namespace of
//                    gunbc.source_layout_namespaces (the caller passes that set); resolved by module
//                    then declaration (then field), and a span that does not resolve is a REFUSAL.
//   NotASymbol    -- carries a character outside the identifier alphabet (a path, flag, call, code),
//                    or is dotted with a first segment that is no namespace (a file name, a field path).
//   Unclassified  -- a bare identifier. Counted and reported, never resolved and never admitted as
//                    resolved: there is no module to key it by, so any answer would be a heuristic.
// Nothing here compares a count to a literal; the verb's exit is decided by the refusal population.

type CitedRef {
  file: Symbol
  ref: DeclarationRef
}

type SpanStanding
  = SpanResolves
  | SpanStale
  | SpanNotASymbol
  | SpanUnclassified

type ProseSpan {
  file: Symbol
  span: String
  standing: SpanStanding
}

type DeclRefCensus {
  refused_files: List<String>
  cited: List<CitedRef>
  resolutions: List<DeclarationRefResolution>
  prose: List<ProseSpan>
  sites: List<String>
  unreadable: List<String>
}

fn token_string_body(t: Token) -> Optional<String> {
  if t.class == ^dag_token_string_literal && t.lexeme.length() >= 2 {
    optional_present(value: t.lexeme.substring(start: 1, end: t.lexeme.length() - 1))
  } else {
    optional_absent()
  }
}

// A DeclarationRef literal is a record construct whose tag RESOLVES, by declaration identity, to
// std.decl_ref DeclarationRef; the census reads the resolved Node tree and never the lexer's tokens, so
// a spelling that merely looks like the literal (a return type, a pattern, a same-named type of another
// module) is not one, and an aliased spelling of the real one is. A construct with no string-literal
// module_path or decl_name is a computed construction, which cites nothing by spelling. A construct with
// one of the two that cannot be read whole is a typed refusal (unreadable), never an absence.
// A roster row's subject is a CitedDeclaration construct: it names a citation it dispositions and is not
// itself a citation, an identity-grain distinction (the tag resolves to the roster's own arm).
type LiteralScan {
  cited: List<CitedRef>
  unreadable: List<String>
}

data declaration_ref_path: String = "std.decl_ref.DeclarationRef"

data decl_ref_module: String = "std.decl_ref"

data cited_declaration_spelling: String = "CitedDeclaration"

// THE HEAD IS IDENTIFIED BY THE MODULE'S OWN TYPED IMPORT ROWS, NOT BY A RESOLVER. The authored tag of a
// construct is the spelling the author wrote; it denotes std.decl_ref DeclarationRef iff its first
// segment is bound by an AliasBindingRow whose target extends to that path, or it spells the qualified
// path, or the module is std.decl_ref itself. A bare DeclarationRef that no import row backs is NOT
// accepted silently: it is counted and listed by module (bare-head), because names resolve by global
// uniqueness today and the census must not read a spelling the module never bound as a citation.
type ImportPair {
  binding: String
  target: String
}

type LiteralCtx {
  self_module: String
  pairs: List<ImportPair>
}

fn import_pairs_of(rows: List<AliasBindingRow>) -> List<ImportPair> {
  fold_list(
    xs: rows,
    empty: [],
    cons: fn(acc, r) { list_snoc_item(xs: acc, item: ImportPair { binding: symbol_lexeme(sym: r.binding), target: qualified_name_to_dotted_string(qn: r.target) }) }
  )
}

fn pair_target(pairs: List<ImportPair>, binding: String) -> Optional<String> {
  fold_list(
    xs: pairs,
    empty: optional_absent(),
    cons: fn(acc, p) { if p.binding == binding { optional_present(value: p.target) } else { acc } }
  )
}

fn last_segment(spelling: String) -> String {
  fold_list(xs: spelling.split(delimiter: "."), empty: "", cons: fn(acc, s) { s })
}

// The dotted path a spelling denotes under the module's import rows; Absent for a bare spelling that
// nothing binds (and the module is not std.decl_ref).
fn expand_spelling(spelling: String, lc: LiteralCtx) -> Optional<String> {
  let segs = spelling.split(delimiter: ".")
  let first = span_first_segment(span: spelling)
  match pair_target(pairs: lc.pairs, binding: first) {
    Present { value: target } => optional_present(value: join_segments(segs: list_append(left: [target], right: drop_segments(segs: segs, k: 1))))
    Absent =>
      if length(xs: segs) > 1 {
        optional_present(value: spelling)
      } else if lc.self_module == decl_ref_module {
        optional_present(value: concat(decl_ref_module, ".", first))
      } else {
        optional_absent()
      }
  }
}

type HeadClass
  = HeadIsDeclarationRef
  | HeadOther
  | HeadBareUnbacked

fn head_class(spelling: String, lc: LiteralCtx) -> HeadClass {
  if last_segment(spelling: spelling) != "DeclarationRef" {
    HeadOther
  } else {
    match expand_spelling(spelling: spelling, lc: lc) {
      Present { value: path } => if path == declaration_ref_path { HeadIsDeclarationRef } else { HeadOther }
      Absent => HeadBareUnbacked
    }
  }
}

fn is_decl_field_variant(path: String, variant: String) -> Bool {
  path == concat(decl_ref_module, ".", variant) || path == concat(decl_ref_module, ".DeclField.", variant)
}

fn tag_path_text(n: Node) -> Optional<String> {
  match construct_tag_path_optional(n: n) {
    Absent => optional_absent()
    Present { value: p } => optional_present(value: qualified_name_to_dotted_string(qn: p))
  }
}

// The AUTHORED path of a node that is a construct tag or a bare reference (a nullary variant such as
// WholeDeclaration is a reference, not a construct).
fn authored_path_text(n: Node) -> Optional<String> {
  match tag_path_text(n: n) {
    Present { value: p } => optional_present(value: p)
    Absent =>
      match declaration_reference_path_optional(node: n) {
        Present { value: q } => optional_present(value: qualified_name_to_dotted_string(qn: q))
        Absent =>
          if qualified_name_spine_shape_present(root: n) {
            match qualified_name_from_node(root: n) {
              Accepted { value: q, diagnostics: _ } => optional_present(value: qualified_name_to_dotted_string(qn: q))
              Rejected { diagnostics: _ } => optional_absent()
            }
          } else {
            match node_atom_identity_optional(node: n) {
              Present { value: id } => optional_present(value: symbol_lexeme(sym: id))
              Absent => optional_absent()
            }
          }
      }
  }
}

fn field_target(n: Node, name: String) -> Optional<Node> {
  fold(
    construct_field_edges(n: n),
    init: optional_absent(),
    f: fn(acc, e) {
      match e.label {
        Authored { name: label } => if symbol_lexeme(sym: label) == name { optional_present(value: e.target) } else { acc }
        StructuralLabel { label: _ } => acc
        Positional => acc
      }
    }
  )
}

fn field_target_or_self(n: Node) -> Node {
  match field_target(n: n, name: "field") {
    Present { value: f } => f
    Absent => n
  }
}

fn string_value(n: Optional<Node>) -> Optional<String> {
  match n {
    Absent => optional_absent()
    Present { value: v } =>
      match dag_string_literal_value_symbol_optional(node: v) {
        Absent => optional_absent()
        Present { value: s } => optional_present(value: symbol_lexeme(sym: s))
      }
  }
}

fn declared_field_of(v: Optional<Node>, lc: LiteralCtx) -> Optional<DeclField> {
  match v {
    Absent => optional_absent()
    Present { value: f } =>
      match authored_path_text(n: f) {
        Absent => optional_absent()
        Present { value: spelled } =>
          match expand_spelling(spelling: spelled, lc: lc) {
            Absent => optional_absent()
            Present { value: p } =>
              if is_decl_field_variant(path: p, variant: "NamedField") {
                match string_value(n: field_target(n: f, name: "field_name")) {
                  Present { value: s } => optional_present(value: NamedField { field_name: s as NonEmptyStr })
                  Absent => optional_absent()
                }
              } else if is_decl_field_variant(path: p, variant: "TypeParameter") {
                match string_value(n: field_target(n: f, name: "name")) {
                  Present { value: s } => optional_present(value: TypeParameter { name: s as NonEmptyStr })
                  Absent => optional_absent()
                }
              } else if is_decl_field_variant(path: p, variant: "WholeDeclaration") {
                optional_present(value: WholeDeclaration)
              } else {
                optional_absent()
              }
          }
      }
  }
}

fn literal_unreadable(scan: LiteralScan, file: Symbol) -> LiteralScan {
  LiteralScan { cited: scan.cited, unreadable: list_snoc_item(xs: scan.unreadable, item: symbol_lexeme(sym: file)) }
}

fn literal_scan_add(scan: LiteralScan, file: Symbol, n: Node, lc: LiteralCtx) -> LiteralScan {
  match string_value(n: field_target(n: n, name: "module_path")) {
    Absent =>
      match string_value(n: field_target(n: n, name: "decl_name")) {
        Absent => scan
        Present { value: _ } => literal_unreadable(scan: scan, file: file)
      }
    Present { value: m } =>
      match string_value(n: field_target(n: n, name: "decl_name")) {
        Absent => LiteralScan { cited: scan.cited, unreadable: list_snoc_item(xs: scan.unreadable, item: subject_key(s: ComputedDeclName { file: symbol_lexeme(sym: file), module_path: m })) }
        Present { value: d } =>
          match declared_field_of(v: field_target(n: n, name: "field"), lc: lc) {
            Absent =>
              LiteralScan {
                cited: scan.cited,
                unreadable: list_snoc_item(xs: scan.unreadable, item: concat(symbol_lexeme(sym: file), concat(" field-tag=", match authored_path_text(n: field_target_or_self(n: n)) { Present { value: t } => t  Absent => "none" })))
              }
            Present { value: fld } =>
              LiteralScan {
                cited: list_snoc_item(xs: scan.cited, item: CitedRef { file: file, ref: DeclarationRef { module_path: m as NonEmptyStr, decl_name: d as NonEmptyStr, field: fld } }),
                unreadable: scan.unreadable
              }
          }
      }
  }
}

fn node_literal_scan_children(file: Symbol, n: Node, scan: LiteralScan, lc: LiteralCtx) -> LiteralScan {
  fold(n.children, init: scan, f: fn(acc, e) { node_literal_scan(file: file, n: e.target, scan: acc, lc: lc) })
}

// A DeclarationRef BUILT BY std.decl_ref's OWN CONSTRUCTORS is the same citation as the literal, and the
// literal-only reader left every one of them unjudged. The call is identified the way a literal's tag
// is: its head's spelling, expanded through the module's own import rows, is one of the constructors
// below. Its arguments are the named edges of the call, read as string literals exactly as a literal's
// fields are; a constructor whose module_path or decl_name is not a literal is a computed construction,
// the same ComputedDeclName/unreadable arm a literal takes.
type DeclRefConstructor
  = ConstructsWholeDeclaration
  | ConstructsNamedField
  | ConstructsTypeParameter

fn decl_ref_constructor_of(path: String) -> Optional<DeclRefConstructor> {
  if path == concat(decl_ref_module, ".decl_ref") {
    optional_present(value: ConstructsWholeDeclaration)
  } else if path == concat(decl_ref_module, ".decl_field_ref") {
    optional_present(value: ConstructsNamedField)
  } else if path == concat(decl_ref_module, ".decl_type_parameter_ref") {
    optional_present(value: ConstructsTypeParameter)
  } else {
    optional_absent()
  }
}

// The callee is the application's first edge; its atom identity is the spelling the author wrote.
fn callee_identity(children: List<Edge>) -> Optional<Symbol> {
  match list_head(xs: children) {
    Absent => optional_absent()
    Present { value: e } => edge_atom_identity(e: e)
  }
}

fn edge_atom_identity(e: Edge) -> Optional<Symbol> {
  node_atom_identity_optional(node: e.target)
}

fn call_constructor(n: Node, lc: LiteralCtx) -> Optional<DeclRefConstructor> {
  match n.kind {
    ComputationNode { behavior: Transform } =>
      match callee_identity(children: n.children) {
        Absent => optional_absent()
        Present { value: id } =>
          match expand_spelling(spelling: symbol_lexeme(sym: id), lc: lc) {
            Absent => optional_absent()
            Present { value: path } => decl_ref_constructor_of(path: path)
          }
      }
    ComputationNode { behavior: Value } => optional_absent()
    ComputationNode { behavior: Branch } => optional_absent()
    ComputationNode { behavior: Loop } => optional_absent()
    ComputationNode { behavior: Bind } => optional_absent()
    ComputationNode { behavior: Match } => optional_absent()
    TypeNode { connective: _ } => optional_absent()
  }
}

fn call_argument(n: Node, name: String) -> Optional<Node> {
  fold(
    n.children,
    init: optional_absent(),
    f: fn(acc, e) {
      match e.label {
        Authored { name: label } => if symbol_lexeme(sym: label) == name { optional_present(value: e.target) } else { acc }
        StructuralLabel { label: _ } => acc
        Positional => acc
      }
    }
  )
}

fn constructor_field(n: Node, ctor: DeclRefConstructor) -> Optional<DeclField> {
  match ctor {
    ConstructsWholeDeclaration => optional_present(value: WholeDeclaration)
    ConstructsNamedField =>
      match string_value(n: call_argument(n: n, name: "field_name")) {
        Present { value: s } => optional_present(value: NamedField { field_name: s as NonEmptyStr })
        Absent => optional_absent()
      }
    ConstructsTypeParameter =>
      match string_value(n: call_argument(n: n, name: "parameter")) {
        Present { value: s } => optional_present(value: TypeParameter { name: s as NonEmptyStr })
        Absent => optional_absent()
      }
  }
}

fn constructor_call_add(scan: LiteralScan, file: Symbol, n: Node, ctor: DeclRefConstructor) -> LiteralScan {
  match string_value(n: call_argument(n: n, name: "module_path")) {
    Absent =>
      match string_value(n: call_argument(n: n, name: "decl_name")) {
        Absent => literal_unreadable(scan: scan, file: file)
        Present { value: _ } => literal_unreadable(scan: scan, file: file)
      }
    Present { value: m } =>
      match string_value(n: call_argument(n: n, name: "decl_name")) {
        Absent => LiteralScan { cited: scan.cited, unreadable: list_snoc_item(xs: scan.unreadable, item: subject_key(s: ComputedDeclName { file: symbol_lexeme(sym: file), module_path: m })) }
        Present { value: d } =>
          match constructor_field(n: n, ctor: ctor) {
            Absent => LiteralScan { cited: scan.cited, unreadable: list_snoc_item(xs: scan.unreadable, item: concat(symbol_lexeme(sym: file), " constructor-field ", m, " ", d)) }
            Present { value: fld } =>
              LiteralScan {
                cited: list_snoc_item(xs: scan.cited, item: CitedRef { file: file, ref: DeclarationRef { module_path: m as NonEmptyStr, decl_name: d as NonEmptyStr, field: fld } }),
                unreadable: scan.unreadable
              }
          }
      }
  }
}

fn node_literal_scan(file: Symbol, n: Node, scan: LiteralScan, lc: LiteralCtx) -> LiteralScan {
  match call_constructor(n: n, lc: lc) {
    Present { value: ctor } => constructor_call_add(scan: scan, file: file, n: n, ctor: ctor)
    Absent => node_literal_scan_construct(file: file, n: n, scan: scan, lc: lc)
  }
}

fn node_literal_scan_construct(file: Symbol, n: Node, scan: LiteralScan, lc: LiteralCtx) -> LiteralScan {
  match tag_path_text(n: n) {
    Present { value: p } =>
      if last_segment(spelling: p) == cited_declaration_spelling {
        scan
      } else {
        match head_class(spelling: p, lc: lc) {
          HeadIsDeclarationRef => literal_scan_add(scan: scan, file: file, n: n, lc: lc)
          HeadBareUnbacked =>
            literal_scan_add(
              scan: LiteralScan { cited: scan.cited, unreadable: list_snoc_item(xs: scan.unreadable, item: concat(symbol_lexeme(sym: file), " bare-head ", p)) },
              file: file,
              n: n,
              lc: lc
            )
          HeadOther => node_literal_scan_children(file: file, n: n, scan: scan, lc: lc)
        }
      }
    Absent => node_literal_scan_children(file: file, n: n, scan: scan, lc: lc)
  }
}

// A module that spells DeclarationRef is a candidate (a necessary condition for a literal, since the
// language has no import renaming). An alias of it would hide a constructor from that filter, so a
// type alias whose own subtree spells it is reported and the census refuses naming the module.
data declaration_ref_spelling: String = "DeclarationRef"

fn node_is_declaration_ref_atom(n: Node) -> Bool {
  match node_atom_identity_optional(node: n) {
    Present { value: id } => symbol_lexeme(sym: id) == declaration_ref_spelling
    Absent => false
  }
}

fn root_aliases_declaration_ref(root: Node) -> Bool {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(self) { type_alias_wrapper_is(n: self) && node_is_declaration_ref_atom(n: type_decl_wrapper_target(wrapper: self, pick: fn(e) { edge_is_type_alias(e: e) })) },
      step: fn(acc, _e, sub) { acc || sub }
    }
  )
}

fn declaration_ref_literals(file: Symbol, root: Node, lc: LiteralCtx) -> LiteralScan {
  node_literal_scan(file: file, n: root, scan: LiteralScan { cited: [], unreadable: [] }, lc: lc)
}

// ---- prose --------------------------------------------------------------------------------

data prose_identifier_alphabet: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

data prose_dotted_alphabet: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_."

// The odd-indexed segments of a split on the backtick: the text between an opening and a closing tick.
// An unclosed tick yields no span (the final segment has no closer).
type SpanFold {
  index: Int
  spans: List<String>
}

fn backtick_spans(body: String) -> List<String> {
  let parts = body.split(delimiter: "`")
  let last = length(xs: parts) - 1
  let folded = fold_list(
    xs: parts,
    empty: SpanFold { index: 0, spans: [] },
    cons: fn(acc, part) {
      SpanFold {
        index: acc.index + 1,
        spans: if acc.index % 2 == 1 && acc.index < last { list_snoc_item(xs: acc.spans, item: part) } else { acc.spans }
      }
    }
  )
  folded.spans
}

fn span_first_segment(span: String) -> String {
  match list_head(xs: span.split(delimiter: ".")) {
    Present { value: s } => s
    Absent => ""
  }
}

fn contains_text(xs: List<String>, item: String) -> Bool {
  any(xs: xs, predicate: fn(x) { x == item })
}

// The longest module prefix of a dotted span that the ingest declared, with the segments after it.
type SpanSplit {
  module: String
  rest: List<String>
}

fn take_segments(segs: List<String>, k: Int) -> List<String> {
  fold_list(
    xs: segs,
    empty: Empty,
    cons: fn(acc, s) { if length(xs: acc) < k { list_snoc_item(xs: acc, item: s) } else { acc } }
  )
}

type SegmentFold {
  index: Int
  kept: List<String>
}

fn drop_segments(segs: List<String>, k: Int) -> List<String> {
  fold_list(
    xs: segs,
    empty: SegmentFold { index: 0, kept: [] },
    cons: fn(acc, s) {
      SegmentFold {
        index: acc.index + 1,
        kept: if acc.index >= k { list_snoc_item(xs: acc.kept, item: s) } else { acc.kept }
      }
    }
  ).kept
}

// A dotted span is split at EVERY k and judged at the longest k whose prefix is a declared module.
fn span_longest_module(segs: List<String>, k: Int, known: Map<String, Bool>) -> Optional<Int> {
  if k < 1 {
    optional_absent()
  } else {
    match map_lookup(m: known, key: join_segments(segs: take_segments(segs: segs, k: k))) {
      Present { value: _ } => optional_present(value: k)
      Absent => span_longest_module(segs: segs, k: k - 1, known: known)
    }
  }
}

fn join_segments(segs: List<String>) -> String {
  match segs {
    Empty => ""
    Cons { head: h, tail: t } => fold_list(xs: t, empty: h, cons: fn(acc, s) { concat(acc, ".", s) })
  }
}

fn symbol_span_standing(span: String, known: Map<String, Bool>, context: ResolutionContext) -> SpanStanding {
  let segs = span.split(delimiter: ".")
  match span_longest_module(segs: segs, k: length(xs: segs), known: known) {
    Absent => SpanStale
    Present { value: k } =>
      let rest = drop_segments(segs: segs, k: k)
      match rest {
        Empty => SpanResolves
        Cons { head: decl, tail: after } =>
          match after {
            Empty => ref_standing(module: join_segments(segs: take_segments(segs: segs, k: k)), decl: decl, field: WholeDeclaration, context: context)
            Cons { head: field, tail: more } =>
              match more {
                Empty => ref_standing(module: join_segments(segs: take_segments(segs: segs, k: k)), decl: decl, field: NamedField { field_name: field as NonEmptyStr }, context: context)
                Cons { head: _, tail: _ } => SpanStale
              }
          }
      }
  }
}

fn ref_standing(module: String, decl: String, field: DeclField, context: ResolutionContext) -> SpanStanding {
  match resolve_declaration_ref(
    ref: DeclarationRef { module_path: module as NonEmptyStr, decl_name: decl as NonEmptyStr, field: field },
    context: context
  ) {
    DeclarationRefResolved { declaration_identity: _ } => SpanResolves
    DeclarationRefModuleAbsent { reference: _ } => SpanStale
    DeclarationRefDeclarationAbsent { reference: _ } => SpanStale
    DeclarationRefFieldAbsent { reference: _ } => SpanStale
    DeclarationRefContested { reference: _, claimants: _ } => SpanStale
  }
}

fn span_standing(span: String, namespaces: List<String>, known: Map<String, Bool>, context: ResolutionContext) -> SpanStanding {
  if span.length() == 0 {
    SpanNotASymbol
  } else if !string_all_chars_in(s: span, alphabet: prose_dotted_alphabet) {
    SpanNotASymbol
  } else if string_all_chars_in(s: span.substring(start: span.length() - 1, end: span.length()), alphabet: "._") {
    SpanNotASymbol
  } else if !string_any_char_in(s: span, alphabet: ".") {
    SpanUnclassified
  } else if contains_text(xs: namespaces, item: span_first_segment(span: span)) {
    symbol_span_standing(span: span, known: known, context: context)
  } else {
    SpanNotASymbol
  }
}

// The module a symbol-shaped span names, if the storage lookup knows one: the same shape tests as
// span_standing, so the modules the census must load are exactly the ones it will resolve in.
fn span_target_module(span: String, namespaces: List<String>, known: Map<String, Bool>) -> Optional<String> {
  if span.length() == 0 {
    optional_absent()
  } else if !string_all_chars_in(s: span, alphabet: prose_dotted_alphabet) {
    optional_absent()
  } else if string_all_chars_in(s: span.substring(start: span.length() - 1, end: span.length()), alphabet: "._") {
    optional_absent()
  } else if !string_any_char_in(s: span, alphabet: ".") {
    optional_absent()
  } else if contains_text(xs: namespaces, item: span_first_segment(span: span)) {
    let segs = span.split(delimiter: ".")
    match span_longest_module(segs: segs, k: length(xs: segs), known: known) {
      Present { value: k } => optional_present(value: join_segments(segs: take_segments(segs: segs, k: k)))
      Absent => optional_absent()
    }
  } else {
    optional_absent()
  }
}

// The declaration name a span cites under its module: the segment after the longest declared module.
fn span_target_name(span: String, namespaces: List<String>, known: Map<String, Bool>) -> Optional<String> {
  match span_target_module(span: span, namespaces: namespaces, known: known) {
    Absent => optional_absent()
    Present { value: m } =>
      match list_head(xs: drop_segments(segs: span.split(delimiter: "."), k: length(xs: m.split(delimiter: ".")))) {
        Present { value: n } => optional_present(value: n)
        Absent => optional_absent()
      }
  }
}

fn prose_target_names(tokens: List<Token>, namespaces: List<String>, known: Map<String, Bool>) -> List<String> {
  fold_list(
    xs: tokens,
    empty: [],
    cons: fn(acc, t) {
      match token_string_body(t: t) {
        Absent => acc
        Present { value: body } =>
          fold_list(
            xs: backtick_spans(body: body),
            empty: acc,
            cons: fn(inner, span) {
              match span_target_name(span: span, namespaces: namespaces, known: known) {
                Present { value: n } => list_snoc_item(xs: inner, item: n)
                Absent => inner
              }
            }
          )
      }
    }
  )
}

fn prose_target_modules(tokens: List<Token>, namespaces: List<String>, known: Map<String, Bool>) -> List<String> {
  fold_list(
    xs: tokens,
    empty: [],
    cons: fn(acc, t) {
      match token_string_body(t: t) {
        Absent => acc
        Present { value: body } =>
          fold_list(
            xs: backtick_spans(body: body),
            empty: acc,
            cons: fn(inner, span) {
              match span_target_module(span: span, namespaces: namespaces, known: known) {
                Present { value: m } => list_snoc_item(xs: inner, item: m)
                Absent => inner
              }
            }
          )
      }
    }
  )
}

fn prose_spans_of(
  file: Symbol,
  tokens: List<Token>,
  namespaces: List<String>,
  known: Map<String, Bool>,
  context: ResolutionContext
) -> List<ProseSpan> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, t) {
      match token_string_body(t: t) {
        Absent => acc
        Present { value: body } =>
          fold_list(
            xs: backtick_spans(body: body),
            empty: acc,
            cons: fn(inner, span) {
              list_snoc_item(xs: inner, item: ProseSpan {
                file: file,
                span: span,
                standing: span_standing(span: span, namespaces: namespaces, known: known, context: context)
              })
            }
          )
      }
    }
  )
}

// ---- the report ---------------------------------------------------------------------------

// A stale span whose module prefix is a file refused at ingest was never judged (see ref_in_refused_file).
fn span_in_refused_file(span: String, refused: List<String>) -> Bool {
  fold_list(
    xs: span.split(delimiter: "."),
    empty: SegmentFold { index: 0, kept: [] },
    cons: fn(acc, seg) {
      let kept = list_snoc_item(xs: acc.kept, item: seg)
      SegmentFold {
        index: if acc.index == 1 || (length(xs: kept) >= 2 && module_file_is_refused(module: join_segments_with(segs: kept, sep: "."), refused: refused)) { 1 } else { 0 },
        kept: kept
      }
    }
  ).index == 1
}

// The single classification of a prose span, read by refusal, the printed line and the roster join,
// as resolution_arm is for resolutions. A stale span is Unjudged when its module prefix is a file
// refused at ingest, Rostered when a typed disposition names it, and Refused otherwise.
type SpanArm
  = SpanArmResolves
  | SpanArmNotASymbol
  | SpanArmUnclassified
  | SpanArmStaleUnjudged
  | SpanArmStaleRostered
  | SpanArmStaleRefused

fn span_arm(s: ProseSpan, refused: List<String>) -> SpanArm {
  match s.standing {
    SpanStale => if span_in_refused_file(span: s.span, refused: refused) { SpanArmStaleUnjudged } else if roster_has_span(span: s.span) { SpanArmStaleRostered } else { SpanArmStaleRefused }
    SpanResolves => SpanArmResolves
    SpanNotASymbol => SpanArmNotASymbol
    SpanUnclassified => SpanArmUnclassified
  }
}

// THE SEED LAYER, DISPOSITIONED AS A TYPE RATHER THAN REFUSED. `v1_compiler` and `v1_compiler_tests`
// name the seed's Rust crates (no .dag module exists to resolve), and `v1.*` names the seed's own .dag
// sources, which gunbc.source_layout holds outside the governed trees by design (the native ingest
// refuses src/v1 as a source root, and ci_layer_roots records its last-segment collisions with v2).
// A module-absent citation into one of these namespaces is counted, never resolved and never a
// refusal. dissolve-on: source_layout admits src/v1 (the namespace cut, gunbc#8282) and the seed's
// Rust layer is retired.
data seed_layer_namespaces: List<String> = ["v1", "v1_compiler", "v1_compiler_tests"]

fn ref_in_seed_layer(x: DeclarationRef) -> Bool {
  let first = list_head(xs: (x.module_path as String).split(delimiter: "."))
  match first {
    Present { value: head } => contains_text(xs: seed_layer_namespaces, item: head)
    Absent => false
  }
}

// UNCHECKABLE, DISPOSITIONED AS A TYPE RATHER THAN REFUSED. A module the index lacks because its own
// file was refused at ingest was never judged: the citation is neither resolved nor stale. The file
// is found by the name-to-path rule (module a.b.c is stored at <root>/a/b/c.dag). Counted per
// citation and each refused file is printed by the verb. dissolve-on: the native ingest admits every
// file of the governed trees, so no file is refused and none can hide a module.
fn ref_in_refused_file(x: DeclarationRef, refused: List<String>) -> Bool {
  module_file_is_refused(module: x.module_path as String, refused: refused)
}

// The module's file by the one name-to-path authority, gunbc.source_layout, compared for equality
// with the files refused at ingest: a module the layout gives no file is never excused.
fn module_file_is_refused(module: String, refused: List<String>) -> Bool {
  match layout_module_storage_path(module: module) {
    Present { value: path } => any(xs: refused, predicate: fn(f) { f == path })
    Absent => false
  }
}

fn join_segments_with(segs: List<String>, sep: String) -> String {
  match segs {
    Empty => ""
    Cons { head: h, tail: t } => fold_list(xs: t, empty: h, cons: fn(acc, s) { concat(acc, sep, s) })
  }
}

// One identity per subject, compared once: a fourth DeclRefSubject variant adds one arm here, not a predicate.
fn subject_key(s: DeclRefSubject) -> String {
  match s {
    CitedDeclaration { reference: x } => concat("decl|", declaration_ref_display_key(ref: x))
    CitedSpan { text: t } => concat("span|", t)
    ComputedDeclName { file: f, module_path: m } => concat("site|", concat(f, "|", m))
  }
}

fn subject_is(d: DeclRefDisposition, s: DeclRefSubject) -> Bool {
  subject_key(s: d.subject) == subject_key(s: s)
}

fn roster_subject_text(d: DeclRefDisposition) -> String {
  match d.subject {
    CitedDeclaration { reference: x } => declaration_ref_display_key(ref: x)
    CitedSpan { text: t } => t
    ComputedDeclName { file: f, module_path: m } => concat(f, " computed-decl ", m)
  }
}

fn unreadable_is_rostered(site: String) -> Bool {
  any(xs: decl_ref_disposition_roster, predicate: fn(d) { subject_key(s: d.subject) == site })
}

fn unrostered_unreadable(c: DeclRefCensus) -> List<String> {
  fold_list(xs: c.unreadable, empty: [], cons: fn(acc, u) { if unreadable_is_rostered(site: u) { acc } else { list_snoc_item(xs: acc, item: u) } })
}

fn roster_has_span(span: String) -> Bool {
  any(xs: decl_ref_disposition_roster, predicate: fn(d) { subject_is(d: d, s: CitedSpan { text: span }) })
}

fn resolution_reference(r: DeclarationRefResolution) -> Optional<DeclarationRef> {
  match r {
    DeclarationRefResolved { declaration_identity: _ } => optional_absent()
    DeclarationRefModuleAbsent { reference: x } => optional_present(value: x)
    DeclarationRefDeclarationAbsent { reference: x } => optional_present(value: x)
    DeclarationRefFieldAbsent { reference: x } => optional_present(value: x)
    DeclarationRefContested { reference: x, claimants: _ } => optional_present(value: x)
  }
}

fn roster_has_resolution(r: DeclarationRefResolution) -> Bool {
  match resolution_reference(r: r) {
    Absent => false
    Present { value: x } => any(xs: decl_ref_disposition_roster, predicate: fn(d) { subject_is(d: d, s: CitedDeclaration { reference: x }) })
  }
}

fn roster_row_matches_resolution(d: DeclRefDisposition, r: DeclarationRefResolution) -> Bool {
  match resolution_reference(r: r) {
    Absent => false
    Present { value: x } => subject_is(d: d, s: CitedDeclaration { reference: x })
  }
}

fn resolution_subject(r: DeclarationRefResolution) -> String {
  match r {
    DeclarationRefResolved { declaration_identity: i } => i.qualified_name
    DeclarationRefModuleAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefDeclarationAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefFieldAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefContested { reference: x, claimants: _ } => concat(x.module_path as String, " ", x.decl_name as String)
  }
}

fn resolution_is_unresolved(r: DeclarationRefResolution, refused: List<String>) -> Bool {
  match resolution_arm(r: r, refused: refused) {
    ArmResolved => false
    ArmSeedLayer => false
    ArmUncheckable => false
    ArmModuleAbsent => true
    ArmDeclarationAbsent => true
    ArmFieldAbsent => true
    ArmContested => true
  }
}

fn resolution_is_refusal(r: DeclarationRefResolution, refused: List<String>) -> Bool {
  resolution_is_unresolved(r: r, refused: refused) && !roster_has_resolution(r: r)
}

fn roster_row_matched(d: DeclRefDisposition, c: DeclRefCensus) -> Bool {
  any(xs: c.resolutions, predicate: fn(r) { resolution_is_unresolved(r: r, refused: c.refused_files) && roster_row_matches_resolution(d: d, r: r) })
    || any(
      xs: c.prose,
      predicate: fn(s) {
        match span_arm(s: s, refused: c.refused_files) {
          SpanArmStaleUnjudged => subject_is(d: d, s: CitedSpan { text: s.span })
          SpanArmStaleRostered => subject_is(d: d, s: CitedSpan { text: s.span })
          SpanArmStaleRefused => subject_is(d: d, s: CitedSpan { text: s.span })
          SpanArmResolves => false
          SpanArmNotASymbol => false
          SpanArmUnclassified => false
        }
      }
    )
    || any(xs: c.unreadable, predicate: fn(u) { subject_key(s: d.subject) == u })
}

fn unmatched_roster_rows(c: DeclRefCensus) -> List<DeclRefDisposition> {
  fold_list(xs: decl_ref_disposition_roster, empty: [], cons: fn(acc, d) { if roster_row_matched(d: d, c: c) { acc } else { list_snoc_item(xs: acc, item: d) } })
}

fn count_refused_resolutions(xs: List<DeclarationRefResolution>, refused: List<String>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, r) { if resolution_is_refusal(r: r, refused: refused) { acc + 1 } else { acc } })
}

fn count_refused_spans(xs: List<ProseSpan>, refused: List<String>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(acc, s) {
      match span_arm(s: s, refused: refused) {
        SpanArmStaleRefused => acc + 1
        SpanArmStaleUnjudged => acc
        SpanArmStaleRostered => acc
        SpanArmResolves => acc
        SpanArmNotASymbol => acc
        SpanArmUnclassified => acc
      }
    }
  )
}

type SpanCounts {
  resolves: Int
  stale: Int
  not_a_symbol: Int
  unclassified: Int
}

fn span_counts_add(acc: SpanCounts, standing: SpanStanding) -> SpanCounts {
  match standing {
    SpanResolves => SpanCounts { resolves: acc.resolves + 1, stale: acc.stale, not_a_symbol: acc.not_a_symbol, unclassified: acc.unclassified }
    SpanStale => SpanCounts { resolves: acc.resolves, stale: acc.stale + 1, not_a_symbol: acc.not_a_symbol, unclassified: acc.unclassified }
    SpanNotASymbol => SpanCounts { resolves: acc.resolves, stale: acc.stale, not_a_symbol: acc.not_a_symbol + 1, unclassified: acc.unclassified }
    SpanUnclassified => SpanCounts { resolves: acc.resolves, stale: acc.stale, not_a_symbol: acc.not_a_symbol, unclassified: acc.unclassified + 1 }
  }
}

fn span_counts(xs: List<ProseSpan>) -> SpanCounts {
  fold_list(xs: xs, empty: SpanCounts { resolves: 0, stale: 0, not_a_symbol: 0, unclassified: 0 }, cons: fn(acc, s) { span_counts_add(acc: acc, standing: s.standing) })
}

fn decl_ref_census_exit(c: DeclRefCensus) -> Int {
  if count_refused_resolutions(xs: c.resolutions, refused: c.refused_files) + count_refused_spans(xs: c.prose, refused: c.refused_files) + length(xs: unrostered_unreadable(c: c)) + length(xs: unmatched_roster_rows(c: c)) == 0 {
    0
  } else {
    1
  }
}

type ResolutionArm
  = ArmResolved
  | ArmModuleAbsent
  | ArmDeclarationAbsent
  | ArmFieldAbsent
  | ArmContested
  | ArmSeedLayer
  | ArmUncheckable

// The single classification of a resolution; refusal, the printed name and the counts all read it.
fn resolution_arm(r: DeclarationRefResolution, refused: List<String>) -> ResolutionArm {
  match r {
    DeclarationRefResolved { declaration_identity: _ } => ArmResolved
    DeclarationRefModuleAbsent { reference: x } => if ref_in_seed_layer(x: x) { ArmSeedLayer } else if ref_in_refused_file(x: x, refused: refused) { ArmUncheckable } else { ArmModuleAbsent }
    DeclarationRefDeclarationAbsent { reference: _ } => ArmDeclarationAbsent
    DeclarationRefFieldAbsent { reference: _ } => ArmFieldAbsent
    DeclarationRefContested { reference: _, claimants: _ } => ArmContested
  }
}

fn resolution_arm_name(r: DeclarationRefResolution, refused: List<String>) -> String {
  resolution_arm_name_of(a: resolution_arm(r: r, refused: refused))
}

fn resolution_arm_name_of(a: ResolutionArm) -> String {
  match a {
    ArmResolved => "resolved"
    ArmModuleAbsent => "module-absent"
    ArmDeclarationAbsent => "declaration-absent"
    ArmFieldAbsent => "field-absent"
    ArmContested => "contested"
    ArmSeedLayer => "seed-layer"
    ArmUncheckable => "uncheckable"
  }
}

// One fold over resolution_arm: each arm increments its own counter, so no equality over arms is needed.
type ArmCounts {
  module_absent: Int
  declaration_absent: Int
  field_absent: Int
  contested: Int
  seed_layer: Int
  uncheckable: Int
}

fn arm_counts_add(acc: ArmCounts, arm: ResolutionArm) -> ArmCounts {
  match arm {
    ArmResolved => acc
    ArmModuleAbsent => ArmCounts { module_absent: acc.module_absent + 1, declaration_absent: acc.declaration_absent, field_absent: acc.field_absent, contested: acc.contested, seed_layer: acc.seed_layer, uncheckable: acc.uncheckable }
    ArmDeclarationAbsent => ArmCounts { module_absent: acc.module_absent, declaration_absent: acc.declaration_absent + 1, field_absent: acc.field_absent, contested: acc.contested, seed_layer: acc.seed_layer, uncheckable: acc.uncheckable }
    ArmFieldAbsent => ArmCounts { module_absent: acc.module_absent, declaration_absent: acc.declaration_absent, field_absent: acc.field_absent + 1, contested: acc.contested, seed_layer: acc.seed_layer, uncheckable: acc.uncheckable }
    ArmContested => ArmCounts { module_absent: acc.module_absent, declaration_absent: acc.declaration_absent, field_absent: acc.field_absent, contested: acc.contested + 1, seed_layer: acc.seed_layer, uncheckable: acc.uncheckable }
    ArmSeedLayer => ArmCounts { module_absent: acc.module_absent, declaration_absent: acc.declaration_absent, field_absent: acc.field_absent, contested: acc.contested, seed_layer: acc.seed_layer + 1, uncheckable: acc.uncheckable }
    ArmUncheckable => ArmCounts { module_absent: acc.module_absent, declaration_absent: acc.declaration_absent, field_absent: acc.field_absent, contested: acc.contested, seed_layer: acc.seed_layer, uncheckable: acc.uncheckable + 1 }
  }
}

fn arm_counts(xs: List<DeclarationRefResolution>, refused: List<String>) -> ArmCounts {
  fold_list(
    xs: xs,
    empty: ArmCounts { module_absent: 0, declaration_absent: 0, field_absent: 0, contested: 0, seed_layer: 0, uncheckable: 0 },
    cons: fn(acc, r) { arm_counts_add(acc: acc, arm: resolution_arm(r: r, refused: refused)) }
  )
}

// One located line per refusal: a refused reference by arm and cited name, a stale span by file.
fn decl_ref_refusal_lines(c: DeclRefCensus) -> List<String> {
  list_append(
    left: fold_list(
      xs: c.resolutions,
      empty: [],
      cons: fn(acc, r) {
        if resolution_is_refusal(r: r, refused: c.refused_files) {
          list_snoc_item(xs: acc, item: concat("[decl-ref-census] ref ", resolution_arm_name(r: r, refused: c.refused_files), " ", resolution_subject(r: r)))
        } else { acc }
      }
    ),
    right: list_append(
      left: fold_list(
        xs: c.prose,
        empty: [],
        cons: fn(acc, s) {
          match span_arm(s: s, refused: c.refused_files) {
            SpanArmStaleRefused => list_snoc_item(xs: acc, item: concat("[decl-ref-census] span stale ", symbol_lexeme(sym: s.file), " `", s.span, "`"))
            SpanArmStaleUnjudged => acc
            SpanArmStaleRostered => acc
            SpanArmResolves => acc
            SpanArmNotASymbol => acc
            SpanArmUnclassified => acc
          }
        }
      ),
      right: fold_list(xs: unrostered_unreadable(c: c), empty: [], cons: fn(acc, f) { list_snoc_item(xs: acc, item: concat("[decl-ref-census] ref unreadable-literal ", f)) })
    )
  )
}

fn decl_ref_census_lines(c: DeclRefCensus) -> List<String> {
  list_append(
    left: [
      concat("[decl-ref-census] disposition_roster=", to_string(n: length(xs: decl_ref_disposition_roster)), " unmatched=", to_string(n: length(xs: unmatched_roster_rows(c: c)))),
      concat("[decl-ref-census] refs=", to_string(n: length(xs: c.cited)), " refused=", to_string(n: count_refused_resolutions(xs: c.resolutions, refused: c.refused_files)),
        " module_absent=", to_string(n: arm_counts(xs: c.resolutions, refused: c.refused_files).module_absent),
        " declaration_absent=", to_string(n: arm_counts(xs: c.resolutions, refused: c.refused_files).declaration_absent),
        " field_absent=", to_string(n: arm_counts(xs: c.resolutions, refused: c.refused_files).field_absent),
        " contested=", to_string(n: arm_counts(xs: c.resolutions, refused: c.refused_files).contested),
        " seed_layer=", to_string(n: arm_counts(xs: c.resolutions, refused: c.refused_files).seed_layer),
        " uncheckable=", to_string(n: arm_counts(xs: c.resolutions, refused: c.refused_files).uncheckable),
        " unreadable=", to_string(n: length(xs: unrostered_unreadable(c: c)))),
      concat("[decl-ref-census] prose spans=", to_string(n: length(xs: c.prose)),
        " resolves=", to_string(n: span_counts(xs: c.prose).resolves),
        " stale=", to_string(n: span_counts(xs: c.prose).stale),
        " refused=", to_string(n: count_refused_spans(xs: c.prose, refused: c.refused_files)),
        " not_a_symbol=", to_string(n: span_counts(xs: c.prose).not_a_symbol),
        " unclassified=", to_string(n: span_counts(xs: c.prose).unclassified))
    ],
    right: list_append(
      left: decl_ref_refusal_lines(c: c),
      right: list_append(
        left: fold_list(xs: c.sites, empty: [], cons: fn(acc, s) { list_snoc_item(xs: acc, item: concat("[decl-ref-census] site ", s)) }),
        right: fold_list(xs: unmatched_roster_rows(c: c), empty: [], cons: fn(acc, d) { list_snoc_item(xs: acc, item: concat("[decl-ref-census] roster row matches no unresolved citation: ", roster_subject_text(d: d))) })
      )
    )
  )
}

// ---- assembly -----------------------------------------------------------------------------

// One ingested file's tokens, and whether its string literals are in the prose scope.
fn top_level_namespaces(all: List<String>) -> List<String> {
  fold_list(
    xs: all,
    empty: [],
    cons: fn(acc, n) { if string_any_char_in(s: n, alphabet: ".") { acc } else { list_snoc_item(xs: acc, item: n) } }
  )
}

data empty_decl_ref_census: DeclRefCensus = DeclRefCensus { refused_files: [], cited: [], resolutions: [], prose: [], sites: [], unreadable: [] }

// ONE FILE'S CONTRIBUTION, reduced at once: the driver tokenizes a file, calls this and drops the
// tokens, so the census never holds the corpus's token lists (the whole-tree variant exhausted a
// 28 GiB cgroup). Prose is read only from the files the caller scopes in (the ledgers).
fn unresolved_site(c: CitedRef, context: ResolutionContext) -> List<String> {
  site_of_resolution(file: c.file, r: resolve_declaration_ref(ref: c.ref, context: context))
}

fn site_of_resolution(file: Symbol, r: DeclarationRefResolution) -> List<String> {
  if resolution_is_unresolved(r: r, refused: []) {
    [concat(symbol_lexeme(sym: file), " cites ", resolution_subject(r: r))]
  } else {
    []
  }
}

fn decl_ref_census_of_literals(literals: LiteralScan, context: ResolutionContext) -> DeclRefCensus {
  let cited = literals.cited
  DeclRefCensus {
    refused_files: [],
    cited: cited,
    resolutions: fold_list(
      xs: cited,
      empty: [],
      cons: fn(acc, c) { list_snoc_item(xs: acc, item: resolve_declaration_ref(ref: c.ref, context: context)) }
    ),
    prose: [],
    sites: fold_list(xs: cited, empty: [], cons: fn(acc, c) { list_append(left: acc, right: unresolved_site(c: c, context: context)) }),
    unreadable: literals.unreadable
  }
}

fn decl_ref_census_of_prose(
  file: Symbol,
  tokens: List<Token>,
  namespaces: List<String>,
  known: Map<String, Bool>,
  context: ResolutionContext
) -> DeclRefCensus {
  DeclRefCensus {
    refused_files: [],
    cited: [],
    resolutions: [],
    prose: prose_spans_of(file: file, tokens: tokens, namespaces: namespaces, known: known, context: context),
    sites: [],
    unreadable: []
  }
}

fn decl_ref_census_merge(left: DeclRefCensus, right: DeclRefCensus) -> DeclRefCensus {
  DeclRefCensus {
    refused_files: left.refused_files,
    cited: list_append(left: left.cited, right: right.cited),
    resolutions: list_append(left: left.resolutions, right: right.resolutions),
    prose: list_append(left: left.prose, right: right.prose),
    sites: list_append(left: left.sites, right: right.sites),
    unreadable: list_append(left: left.unreadable, right: right.unreadable)
  }
}
