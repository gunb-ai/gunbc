module v2.compiler.decl_ref_census

import std.algebra { Cons, Empty, FreeMonoid, fold_list, length, list_head, list_append, list_reverse, list_snoc_item, map_lookup, string_contains }
import std.decl_ref { DeclField, DeclarationRef, NamedField, WholeDeclaration }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.types { List, NonEmptyStr }
import v2.compiler.name_resolve { ResolutionContext }
import v2.std.compilers.lexing { Token }
import v2.std.decl_ref_resolution {
  DeclarationRefDeclarationAbsent,
  DeclarationRefFieldAbsent,
  DeclarationRefModuleAbsent,
  DeclarationRefContested,
  DeclarationRefResolution,
  DeclarationRefResolved,
  resolve_declaration_ref
}
import v2.std.integer { Int }
import v2.std.node { symbol_lexeme }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.compiler.decl_ref_disposition_roster { DeclRefDisposition, decl_ref_disposition_roster }
import v2.std.text { String, string_all_chars_in, string_any_char_in }

// THE DECLARATION-REFERENCE AND PROSE-SYMBOL CENSUS (a pure reader; the verb is
// v2.compiler.source_root_eval `decl-ref-census`). Two populations, one resolver:
//
//   * every `DeclarationRef { module_path: "..", decl_name: "..", field: .. }` literal in the ingested
//     source, resolved by v2.std.decl_ref_resolution against the native ingest's ResolutionContext;
//   * every backtick span inside a string literal of the files the caller scopes in (the
//     recurring-failure-mode and rung_drop ledgers), classified by the CLOSED grammar below.
//
// A span is exactly one of four, and the grammar is decidable on the span's characters alone:
//   SymbolShaped  -- dotted identifier segments whose first segment is a top-level namespace of
//                    gunbc.source_layout_namespaces (the caller passes that set); resolved by module
//                    then declaration (then field), and a span that does not resolve is a REFUSAL.
//   NotASymbol    -- carries a character outside the identifier alphabet (a path, flag, call, code),
//                    or is dotted with a first segment that is no namespace (a file name, a field path).
//   Unclassified  -- a bare identifier. Counted and reported, never resolved and never admitted as
//                    resolved: there is no module to key it by, so any answer would be a heuristic.
// Nothing here compares a count to a literal; the verb's exit is decided by the refusal population.

type CitedRef {
  file: Symbol
  ref: DeclarationRef
}

type SpanStanding
  = SpanResolves
  | SpanStale
  | SpanNotASymbol
  | SpanUnclassified

type ProseSpan {
  file: Symbol
  span: String
  standing: SpanStanding
}

type DeclRefCensus {
  refused_files: List<String>
  cited: List<CitedRef>
  resolutions: List<DeclarationRefResolution>
  prose: List<ProseSpan>
  sites: List<String>
  unreadable: List<String>
}

fn token_is_ident(t: Token, lexeme: String) -> Bool {
  t.class == ^dag_token_ident && t.lexeme == lexeme
}

fn token_string_body(t: Token) -> Optional<String> {
  if t.class == ^dag_token_string_literal && t.lexeme.length() >= 2 {
    optional_present(value: t.lexeme.substring(start: 1, end: t.lexeme.length() - 1))
  } else {
    optional_absent()
  }
}

// `ident : "string"`, with commas between fields skipped by the caller. Returns the string body and
// the tokens after it.
type StringField {
  value: String
  rest: List<Token>
}

fn drop_comma(toks: List<Token>) -> List<Token> {
  match toks {
    Cons { head: h, tail: rest } => if h.class == ^dag_token_comma { rest } else { toks }
    Empty => toks
  }
}

fn expect_string_field(toks: List<Token>, name: String) -> Optional<StringField> {
  match toks {
    Cons { head: a, tail: r1 } =>
      if token_is_ident(t: a, lexeme: name) {
        match r1 {
          Cons { head: c, tail: r2 } =>
            if c.class == ^dag_token_colon {
              match r2 {
                Cons { head: s, tail: r3 } =>
                  match token_string_body(t: s) {
                    Present { value: body } => optional_present(value: StringField { value: body, rest: drop_comma(toks: r3) })
                    Absent => optional_absent()
                  }
                Empty => optional_absent()
              }
            } else {
              optional_absent()
            }
          Empty => optional_absent()
        }
      } else {
        optional_absent()
      }
    Empty => optional_absent()
  }
}

fn citation_from(file: Symbol, toks: List<Token>) -> Optional<CitedRef> {
  match expect_string_field(toks: toks, name: "module_path") {
    Absent => optional_absent()
    Present { value: m } =>
      match expect_string_field(toks: m.rest, name: "decl_name") {
        Absent => optional_absent()
        Present { value: d } =>
          match d.rest {
            Cons { head: f, tail: r1 } =>
              if token_is_ident(t: f, lexeme: "field") {
                match r1 {
                  Cons { head: colon, tail: r2 } =>
                    if colon.class == ^dag_token_colon {
                      match r2 {
                        Cons { head: arm, tail: r3 } =>
                          if token_is_ident(t: arm, lexeme: "WholeDeclaration") {
                            optional_present(value: CitedRef {
                              file: file,
                              ref: DeclarationRef {
                                module_path: m.value as NonEmptyStr,
                                decl_name: d.value as NonEmptyStr,
                                field: WholeDeclaration
                              }
                            })
                          } else if token_is_ident(t: arm, lexeme: "NamedField") {
                            match r3 {
                              Cons { head: lb, tail: r4 } =>
                                if lb.class == ^dag_token_lbrace {
                                  match expect_string_field(toks: r4, name: "field_name") {
                                    Present { value: n } =>
                                      optional_present(value: CitedRef {
                                        file: file,
                                        ref: DeclarationRef {
                                          module_path: m.value as NonEmptyStr,
                                          decl_name: d.value as NonEmptyStr,
                                          field: NamedField { field_name: n.value as NonEmptyStr }
                                        }
                                      })
                                    Absent => optional_absent()
                                  }
                                } else {
                                  optional_absent()
                                }
                              Empty => optional_absent()
                            }
                          } else {
                            optional_absent()
                          }
                        Empty => optional_absent()
                      }
                    } else {
                      optional_absent()
                    }
                  Empty => optional_absent()
                }
              } else {
                optional_absent()
              }
            Empty => optional_absent()
          }
      }
  }
}

fn citations_of(file: Symbol, toks: List<Token>, acc: List<CitedRef>) -> List<CitedRef> {
  match toks {
    Empty => acc
    Cons { head: h, tail: rest } =>
      if token_is_ident(t: h, lexeme: "module_path") {
        match citation_from(file: file, toks: toks) {
          Present { value: c } => citations_of(file: file, toks: rest, acc: list_snoc_item(xs: acc, item: c))
          Absent => citations_of(file: file, toks: rest, acc: acc)
        }
      } else {
        citations_of(file: file, toks: rest, acc: acc)
      }
  }
}

// A `module_path` identifier followed by a colon and a string literal is a DeclarationRef literal
// in the token stream (a type declaration's `module_path: NonEmptyStr` carries no string literal). One
// that citation_from cannot read is a typed refusal, never an absence: a literal the census could not
// read was not judged.
fn literal_opens_at(toks: List<Token>) -> Bool {
  match toks {
    Cons { head: h, tail: r1 } =>
      if token_is_ident(t: h, lexeme: "module_path") {
        match r1 {
          Cons { head: colon, tail: r2 } =>
            if colon.class == ^dag_token_colon {
              match r2 {
                Cons { head: v, tail: _ } => v.class == ^dag_token_string_literal
                Empty => false
              }
            } else {
              false
            }
          Empty => false
        }
      } else {
        false
      }
    Empty => false
  }
}

fn unreadable_citations_of(file: Symbol, toks: List<Token>, acc: List<String>) -> List<String> {
  match toks {
    Empty => acc
    Cons { head: _, tail: rest } =>
      if literal_opens_at(toks: toks) {
        match citation_from(file: file, toks: toks) {
          Present { value: _ } => unreadable_citations_of(file: file, toks: rest, acc: acc)
          Absent => unreadable_citations_of(file: file, toks: rest, acc: list_snoc_item(xs: acc, item: symbol_lexeme(sym: file)))
        }
      } else {
        unreadable_citations_of(file: file, toks: rest, acc: acc)
      }
  }
}

fn declaration_ref_citations(file: Symbol, tokens: List<Token>) -> List<CitedRef> {
  citations_of(file: file, toks: tokens, acc: [])
}

// ---- prose --------------------------------------------------------------------------------

data prose_identifier_alphabet: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

data prose_dotted_alphabet: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_."

// The odd-indexed segments of a split on the backtick: the text between an opening and a closing tick.
// An unclosed tick yields no span (the final segment has no closer).
type SpanFold {
  index: Int
  spans: List<String>
}

fn backtick_spans(body: String) -> List<String> {
  let parts = body.split(delimiter: "`")
  let last = length(xs: parts) - 1
  let folded = fold_list(
    xs: parts,
    empty: SpanFold { index: 0, spans: [] },
    cons: fn(acc, part) {
      SpanFold {
        index: acc.index + 1,
        spans: if acc.index % 2 == 1 && acc.index < last { list_snoc_item(xs: acc.spans, item: part) } else { acc.spans }
      }
    }
  )
  folded.spans
}

fn span_first_segment(span: String) -> String {
  match list_head(xs: span.split(delimiter: ".")) {
    Present { value: s } => s
    Absent => ""
  }
}

fn contains_text(xs: List<String>, item: String) -> Bool {
  any(xs: xs, predicate: fn(x) { x == item })
}

// The longest module prefix of a dotted span that the ingest declared, with the segments after it.
type SpanSplit {
  module: String
  rest: List<String>
}

fn take_segments(segs: List<String>, k: Int) -> List<String> {
  fold_list(
    xs: segs,
    empty: Empty,
    cons: fn(acc, s) { if length(xs: acc) < k { list_snoc_item(xs: acc, item: s) } else { acc } }
  )
}

type SegmentFold {
  index: Int
  kept: List<String>
}

fn drop_segments(segs: List<String>, k: Int) -> List<String> {
  fold_list(
    xs: segs,
    empty: SegmentFold { index: 0, kept: [] },
    cons: fn(acc, s) {
      SegmentFold {
        index: acc.index + 1,
        kept: if acc.index >= k { list_snoc_item(xs: acc.kept, item: s) } else { acc.kept }
      }
    }
  ).kept
}

// A dotted span is split at EVERY k and judged at the longest k whose prefix is a declared module.
fn span_longest_module(segs: List<String>, k: Int, context: ResolutionContext) -> Optional<Int> {
  if k < 1 {
    optional_absent()
  } else {
    match map_lookup(
      m: context.roots.by_name,
      key: qualified_name_from_dotted_string(dotted: join_segments(segs: take_segments(segs: segs, k: k)))
    ) {
      Present { value: _ } => optional_present(value: k)
      Absent => span_longest_module(segs: segs, k: k - 1, context: context)
    }
  }
}

fn join_segments(segs: List<String>) -> String {
  match segs {
    Empty => ""
    Cons { head: h, tail: t } => fold_list(xs: t, empty: h, cons: fn(acc, s) { concat(acc, ".", s) })
  }
}

fn symbol_span_standing(span: String, context: ResolutionContext) -> SpanStanding {
  let segs = span.split(delimiter: ".")
  match span_longest_module(segs: segs, k: length(xs: segs), context: context) {
    Absent => SpanStale
    Present { value: k } =>
      let rest = drop_segments(segs: segs, k: k)
      match rest {
        Empty => SpanResolves
        Cons { head: decl, tail: after } =>
          match after {
            Empty => ref_standing(module: join_segments(segs: take_segments(segs: segs, k: k)), decl: decl, field: WholeDeclaration, context: context)
            Cons { head: field, tail: more } =>
              match more {
                Empty => ref_standing(module: join_segments(segs: take_segments(segs: segs, k: k)), decl: decl, field: NamedField { field_name: field as NonEmptyStr }, context: context)
                Cons { head: _, tail: _ } => SpanStale
              }
          }
      }
  }
}

fn ref_standing(module: String, decl: String, field: DeclField, context: ResolutionContext) -> SpanStanding {
  match resolve_declaration_ref(
    ref: DeclarationRef { module_path: module as NonEmptyStr, decl_name: decl as NonEmptyStr, field: field },
    context: context
  ) {
    DeclarationRefResolved { declaration_identity: _ } => SpanResolves
    DeclarationRefModuleAbsent { reference: _ } => SpanStale
    DeclarationRefDeclarationAbsent { reference: _ } => SpanStale
    DeclarationRefFieldAbsent { reference: _ } => SpanStale
    DeclarationRefContested { reference: _, claimants: _ } => SpanStale
  }
}

fn span_standing(span: String, namespaces: List<String>, context: ResolutionContext) -> SpanStanding {
  if span.length() == 0 {
    SpanNotASymbol
  } else if !string_all_chars_in(s: span, alphabet: prose_dotted_alphabet) {
    SpanNotASymbol
  } else if !string_any_char_in(s: span, alphabet: ".") {
    SpanUnclassified
  } else if contains_text(xs: namespaces, item: span_first_segment(span: span)) {
    symbol_span_standing(span: span, context: context)
  } else {
    SpanNotASymbol
  }
}

fn prose_spans_of(
  file: Symbol,
  tokens: List<Token>,
  namespaces: List<String>,
  context: ResolutionContext
) -> List<ProseSpan> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, t) {
      match token_string_body(t: t) {
        Absent => acc
        Present { value: body } =>
          fold_list(
            xs: backtick_spans(body: body),
            empty: acc,
            cons: fn(inner, span) {
              list_snoc_item(xs: inner, item: ProseSpan {
                file: file,
                span: span,
                standing: span_standing(span: span, namespaces: namespaces, context: context)
              })
            }
          )
      }
    }
  )
}

// ---- the report ---------------------------------------------------------------------------

// A stale span whose module prefix is a file refused at ingest was never judged (see ref_in_refused_file).
fn span_in_refused_file(span: String, refused: List<String>) -> Bool {
  let segs = span.split(delimiter: ".")
  any(
    xs: refused,
    predicate: fn(f) {
      fold_list(
        xs: segs,
        empty: SegmentFold { index: 0, kept: [] },
        cons: fn(acc, seg) {
          let kept = list_snoc_item(xs: acc.kept, item: seg)
          SegmentFold {
            index: if acc.index == 1 || (length(xs: kept) >= 2 && string_contains(s: f, pattern: concat("/", join_segments_with(segs: kept, sep: "/"), ".dag"))) { 1 } else { 0 },
            kept: kept
          }
        }
      ).index == 1
    }
  )
}

fn span_is_refusal(s: ProseSpan, refused: List<String>) -> Bool {
  match s.standing {
    SpanStale => !span_in_refused_file(span: s.span, refused: refused) && !roster_has(subject: s.span)
    SpanResolves => false
    SpanNotASymbol => false
    SpanUnclassified => false
  }
}

fn span_has_standing(s: ProseSpan, wanted: SpanStanding) -> Bool {
  match s.standing {
    SpanStale => match wanted { SpanStale => true, _ => false }
    SpanResolves => match wanted { SpanResolves => true, _ => false }
    SpanNotASymbol => match wanted { SpanNotASymbol => true, _ => false }
    SpanUnclassified => match wanted { SpanUnclassified => true, _ => false }
  }
}

// THE SEED LAYER, DISPOSITIONED AS A TYPE RATHER THAN REFUSED. `v1_compiler` and `v1_compiler_tests`
// name the seed's Rust crates (no .dag module exists to resolve), and `v1.*` names the seed's own .dag
// sources, which gunbc.source_layout holds outside the governed trees by design (the native ingest
// refuses src/v1 as a source root, and ci_layer_roots records its last-segment collisions with v2).
// A module-absent citation into one of these namespaces is counted, never resolved and never a
// refusal. dissolve-on: source_layout admits src/v1 (the namespace cut, gunbc#8282) and the seed's
// Rust layer is retired.
data seed_layer_namespaces: List<String> = ["v1", "v1_compiler", "v1_compiler_tests"]

fn ref_in_seed_layer(x: DeclarationRef) -> Bool {
  let first = list_head(xs: (x.module_path as String).split(delimiter: "."))
  match first {
    Present { value: head } => contains_text(xs: seed_layer_namespaces, item: head)
    Absent => false
  }
}

// UNCHECKABLE, DISPOSITIONED AS A TYPE RATHER THAN REFUSED. A module the index lacks because its own
// file was refused at ingest was never judged: the citation is neither resolved nor stale. The file
// is found by the name-to-path rule (module a.b.c is stored at <root>/a/b/c.dag). Counted per
// citation and each refused file is printed by the verb. dissolve-on: the native ingest admits every
// file of the governed trees, so no file is refused and none can hide a module.
fn ref_in_refused_file(x: DeclarationRef, refused: List<String>) -> Bool {
  let tail = concat("/", join_segments_with(segs: (x.module_path as String).split(delimiter: "."), sep: "/"), ".dag")
  any(xs: refused, predicate: fn(f) { string_contains(s: f, pattern: tail) })
}

fn join_segments_with(segs: List<String>, sep: String) -> String {
  match segs {
    Empty => ""
    Cons { head: h, tail: t } => fold_list(xs: t, empty: h, cons: fn(acc, s) { concat(acc, sep, s) })
  }
}

fn roster_has(subject: String) -> Bool {
  any(xs: decl_ref_disposition_roster, predicate: fn(d) { d.subject == subject })
}

fn resolution_subject(r: DeclarationRefResolution) -> String {
  match r {
    DeclarationRefResolved { declaration_identity: i } => i.qualified_name
    DeclarationRefModuleAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefDeclarationAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefFieldAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefContested { reference: x, claimants: _ } => concat(x.module_path as String, " ", x.decl_name as String)
  }
}

fn resolution_is_unresolved(r: DeclarationRefResolution, refused: List<String>) -> Bool {
  match resolution_arm(r: r, refused: refused) {
    ArmResolved => false
    ArmSeedLayer => false
    ArmUncheckable => false
    ArmModuleAbsent => true
    ArmDeclarationAbsent => true
    ArmFieldAbsent => true
    ArmContested => true
  }
}

fn resolution_is_refusal(r: DeclarationRefResolution, refused: List<String>) -> Bool {
  resolution_is_unresolved(r: r, refused: refused) && !roster_has(subject: resolution_subject(r: r))
}

fn roster_row_matched(d: DeclRefDisposition, c: DeclRefCensus) -> Bool {
  any(xs: c.resolutions, predicate: fn(r) { resolution_is_unresolved(r: r, refused: c.refused_files) && resolution_subject(r: r) == d.subject })
    || any(xs: c.prose, predicate: fn(s) { span_has_standing(s: s, wanted: SpanStale) && s.span == d.subject })
}

fn unmatched_roster_rows(c: DeclRefCensus) -> List<DeclRefDisposition> {
  fold_list(xs: decl_ref_disposition_roster, empty: [], cons: fn(acc, d) { if roster_row_matched(d: d, c: c) { acc } else { list_snoc_item(xs: acc, item: d) } })
}

fn count_refused_resolutions(xs: List<DeclarationRefResolution>, refused: List<String>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, r) { if resolution_is_refusal(r: r, refused: refused) { acc + 1 } else { acc } })
}

fn count_refused_spans(xs: List<ProseSpan>, refused: List<String>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, s) { if span_is_refusal(s: s, refused: refused) { acc + 1 } else { acc } })
}

fn count_spans_with(xs: List<ProseSpan>, wanted: SpanStanding) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, s) { if span_has_standing(s: s, wanted: wanted) { acc + 1 } else { acc } })
}

fn decl_ref_census_exit(c: DeclRefCensus) -> Int {
  if count_refused_resolutions(xs: c.resolutions, refused: c.refused_files) + count_refused_spans(xs: c.prose, refused: c.refused_files) + length(xs: c.unreadable) + length(xs: unmatched_roster_rows(c: c)) == 0 {
    0
  } else {
    1
  }
}

type ResolutionArm
  = ArmResolved
  | ArmModuleAbsent
  | ArmDeclarationAbsent
  | ArmFieldAbsent
  | ArmContested
  | ArmSeedLayer
  | ArmUncheckable

// The single classification of a resolution; refusal, the printed name and the counts all read it.
fn resolution_arm(r: DeclarationRefResolution, refused: List<String>) -> ResolutionArm {
  match r {
    DeclarationRefResolved { declaration_identity: _ } => ArmResolved
    DeclarationRefModuleAbsent { reference: x } => if ref_in_seed_layer(x: x) { ArmSeedLayer } else if ref_in_refused_file(x: x, refused: refused) { ArmUncheckable } else { ArmModuleAbsent }
    DeclarationRefDeclarationAbsent { reference: _ } => ArmDeclarationAbsent
    DeclarationRefFieldAbsent { reference: _ } => ArmFieldAbsent
    DeclarationRefContested { reference: _, claimants: _ } => ArmContested
  }
}

fn resolution_arm_name(r: DeclarationRefResolution, refused: List<String>) -> String {
  resolution_arm_name_of(a: resolution_arm(r: r, refused: refused))
}

fn arm_is(a: ResolutionArm, wanted: ResolutionArm) -> Bool {
  resolution_arm_name_of(a: a) == resolution_arm_name_of(a: wanted)
}

fn resolution_arm_name_of(a: ResolutionArm) -> String {
  match a {
    ArmResolved => "resolved"
    ArmModuleAbsent => "module-absent"
    ArmDeclarationAbsent => "declaration-absent"
    ArmFieldAbsent => "field-absent"
    ArmContested => "contested"
    ArmSeedLayer => "seed-layer"
    ArmUncheckable => "uncheckable"
  }
}

// The cited name of a refusal, "module decl"; a resolved resolution is not a refusal and cites nothing.
fn resolution_cited_name(r: DeclarationRefResolution) -> String {
  match r {
    DeclarationRefResolved { declaration_identity: i } => i.qualified_name
    DeclarationRefModuleAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefDeclarationAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefFieldAbsent { reference: x } => concat(x.module_path as String, " ", x.decl_name as String)
    DeclarationRefContested { reference: x, claimants: _ } => concat(x.module_path as String, " ", x.decl_name as String)
  }
}

fn count_resolutions_with_arm(xs: List<DeclarationRefResolution>, arm: ResolutionArm, refused: List<String>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(acc, r) { if arm_is(a: resolution_arm(r: r, refused: refused), wanted: arm) { acc + 1 } else { acc } })
}

// One located line per refusal: a refused reference by arm and cited name, a stale span by file.
fn decl_ref_refusal_lines(c: DeclRefCensus) -> List<String> {
  list_append(
    left: fold_list(
      xs: c.resolutions,
      empty: [],
      cons: fn(acc, r) {
        if resolution_is_refusal(r: r, refused: c.refused_files) {
          list_snoc_item(xs: acc, item: concat("[decl-ref-census] ref ", resolution_arm_name(r: r, refused: c.refused_files), " ", resolution_cited_name(r: r)))
        } else { acc }
      }
    ),
    right: list_append(
      left: fold_list(
        xs: c.prose,
        empty: [],
        cons: fn(acc, s) {
          if span_is_refusal(s: s, refused: c.refused_files) {
            list_snoc_item(xs: acc, item: concat("[decl-ref-census] span stale ", symbol_lexeme(sym: s.file), " `", s.span, "`"))
          } else { acc }
        }
      ),
      right: fold_list(xs: c.unreadable, empty: [], cons: fn(acc, f) { list_snoc_item(xs: acc, item: concat("[decl-ref-census] ref unreadable-literal ", f)) })
    )
  )
}

fn decl_ref_census_lines(c: DeclRefCensus) -> List<String> {
  list_append(
    left: [
      concat("[decl-ref-census] disposition_roster=", to_string(n: length(xs: decl_ref_disposition_roster)), " unmatched=", to_string(n: length(xs: unmatched_roster_rows(c: c)))),
      concat("[decl-ref-census] refs=", to_string(n: length(xs: c.cited)), " refused=", to_string(n: count_refused_resolutions(xs: c.resolutions, refused: c.refused_files)),
        " module_absent=", to_string(n: count_resolutions_with_arm(xs: c.resolutions, arm: ArmModuleAbsent, refused: c.refused_files)),
        " declaration_absent=", to_string(n: count_resolutions_with_arm(xs: c.resolutions, arm: ArmDeclarationAbsent, refused: c.refused_files)),
        " field_absent=", to_string(n: count_resolutions_with_arm(xs: c.resolutions, arm: ArmFieldAbsent, refused: c.refused_files)),
        " contested=", to_string(n: count_resolutions_with_arm(xs: c.resolutions, arm: ArmContested, refused: c.refused_files)),
        " seed_layer=", to_string(n: count_resolutions_with_arm(xs: c.resolutions, arm: ArmSeedLayer, refused: c.refused_files)),
        " uncheckable=", to_string(n: count_resolutions_with_arm(xs: c.resolutions, arm: ArmUncheckable, refused: c.refused_files)),
        " unreadable=", to_string(n: length(xs: c.unreadable))),
      concat("[decl-ref-census] prose spans=", to_string(n: length(xs: c.prose)),
        " resolves=", to_string(n: count_spans_with(xs: c.prose, wanted: SpanResolves)),
        " stale=", to_string(n: count_spans_with(xs: c.prose, wanted: SpanStale)),
        " refused=", to_string(n: count_refused_spans(xs: c.prose, refused: c.refused_files)),
        " not_a_symbol=", to_string(n: count_spans_with(xs: c.prose, wanted: SpanNotASymbol)),
        " unclassified=", to_string(n: count_spans_with(xs: c.prose, wanted: SpanUnclassified)))
    ],
    right: list_append(
      left: decl_ref_refusal_lines(c: c),
      right: list_append(
        left: fold_list(xs: c.sites, empty: [], cons: fn(acc, s) { list_snoc_item(xs: acc, item: concat("[decl-ref-census] site ", s)) }),
        right: fold_list(xs: unmatched_roster_rows(c: c), empty: [], cons: fn(acc, d) { list_snoc_item(xs: acc, item: concat("[decl-ref-census] roster row matches no unresolved citation: ", d.subject)) })
      )
    )
  )
}

// ---- assembly -----------------------------------------------------------------------------

// One ingested file's tokens, and whether its string literals are in the prose scope.
fn top_level_namespaces(all: List<String>) -> List<String> {
  fold_list(
    xs: all,
    empty: [],
    cons: fn(acc, n) { if string_any_char_in(s: n, alphabet: ".") { acc } else { list_snoc_item(xs: acc, item: n) } }
  )
}

data empty_decl_ref_census: DeclRefCensus = DeclRefCensus { refused_files: [], cited: [], resolutions: [], prose: [], sites: [], unreadable: [] }

// ONE FILE'S CONTRIBUTION, reduced at once: the driver tokenizes a file, calls this and drops the
// tokens, so the census never holds the corpus's token lists (the whole-tree variant exhausted a
// 28 GiB cgroup). Prose is read only from the files the caller scopes in (the ledgers).
fn unresolved_site(c: CitedRef, context: ResolutionContext) -> List<String> {
  site_of_resolution(file: c.file, r: resolve_declaration_ref(ref: c.ref, context: context))
}

fn site_of_resolution(file: Symbol, r: DeclarationRefResolution) -> List<String> {
  if resolution_is_unresolved(r: r, refused: []) {
    [concat(symbol_lexeme(sym: file), " cites ", resolution_subject(r: r))]
  } else {
    []
  }
}

fn decl_ref_census_of_file(
  file: Symbol,
  tokens: List<Token>,
  prose_scoped: Bool,
  namespaces: List<String>,
  context: ResolutionContext
) -> DeclRefCensus {
  let cited = declaration_ref_citations(file: file, tokens: tokens)
  DeclRefCensus {
    refused_files: [],
    cited: cited,
    resolutions: fold_list(
      xs: cited,
      empty: [],
      cons: fn(acc, c) { list_snoc_item(xs: acc, item: resolve_declaration_ref(ref: c.ref, context: context)) }
    ),
    prose: if prose_scoped {
      prose_spans_of(file: file, tokens: tokens, namespaces: namespaces, context: context)
    } else {
      []
    },
    sites: fold_list(xs: cited, empty: [], cons: fn(acc, c) { list_append(left: acc, right: unresolved_site(c: c, context: context)) }),
    unreadable: unreadable_citations_of(file: file, toks: tokens, acc: [])
  }
}

fn decl_ref_census_merge(left: DeclRefCensus, right: DeclRefCensus) -> DeclRefCensus {
  DeclRefCensus {
    refused_files: left.refused_files,
    cited: list_append(left: left.cited, right: right.cited),
    resolutions: list_append(left: left.resolutions, right: right.resolutions),
    prose: list_append(left: left.prose, right: right.prose),
    sites: list_append(left: left.sites, right: right.sites),
    unreadable: list_append(left: left.unreadable, right: right.unreadable)
  }
}
