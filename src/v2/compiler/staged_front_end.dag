module v2.compiler.staged_front_end

import std.types { List, SourceSpan }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { authored_normalized_capture, authored_parse_semantic, parse_module_authored }
import v2.compiler.resolve { ResolvedTree, resolve }
import v2.compiler.tokenize { tokenize_artifact }
import v2.extdeps.languages.dag { dag_language_model }
import extdeps.languages.dag.syntax { strip_line_comment_delimiter }
import std.algebra { Cons, Empty, FreeMonoid, list_snoc_item }
import std.list { first_where }
import std.source_annotation { region_contains, SourceAnnotationDebt, SourceAnnotationGraph, source_annotation_graph_rows }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import v2.std.compilers.lexing { LexArtifact, lex_artifact_semantic_tokens, token_stream_remaining_count, UnboundSourceAnnotation }
import v2.std.language_model { LanguageModel }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import v2.compiler.normalized_tree { NormalizedTree }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  DeclarerRefused,
  ExternalContractUnknown,
  Unavailable,
  diagnostics_singleton,
  invariant_port_locus,
  Diagnostics,
  None,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  diagnostics_merge,
  rejected_with_pending
}
import v2.std.node { Node, Symbol, node_subtree_count }

// One authority for the .dag front-end ORDER, two projections. The order tokenize -> parse ->
// normalize -> resolve was spelled once inside ingested_resolved_module_from_source as a nest of
// bind_outcome, which returns one Outcome<Node> for the whole front end and therefore cannot say
// WHICH stage a candidate died at. The acceptance harness needs exactly that fact per candidate,
// and re-inlining the four calls beside the existing arrow would have been a second copy of the
// order — the section-3 nickname class, and one that drifts silently because nothing makes the two
// copies disagree loudly. So the order moved HERE and both consumers project from it:
// front_end_run_outcome folds the staged run back to the Outcome<Node> the old arrow returned, and
// the acceptance harness reads the per-stage steps.

// The projection is a FOLD OF THE STAGED RESULT AND NOTHING ELSE — it never re-runs a stage, so it
// cannot disagree with the steps it reports. It reproduces bind_outcome's diagnostic threading
// exactly, which is the whole of the behavior it must preserve: accepted-stage diagnostics
// accumulate in stage order (diagnostics_merge), and a refusal carries the accumulated pending
// diagnostics ahead of its own (rejected_with_pending) — the two moves bind_outcome_accepted makes.
// A projection that dropped accepted-stage diagnostics would be silently lossy for every existing
// caller while still typechecking.

type FrontEndStage
  = FrontEndTokenize
  | FrontEndParse
  | FrontEndNormalize
  | FrontEndResolve

type FrontEndStageReceipt
  = TokenizedSource { token_count: Int }
  | ParsedModule { node_count: Int }
  | NormalizedModule { node_count: Int }
  | ResolvedModule { node_count: Int }

type FrontEndStageStep
  = FrontEndStagePassed {
      stage: FrontEndStage,
      receipt: FrontEndStageReceipt,
      diagnostics: Diagnostics
    }
  | FrontEndStageRejected {
      stage: FrontEndStage,
      diagnostics: NonEmptyDiagnostics
    }

type FrontEndCompletion
  = FrontEndResolvedModule { resolved: ResolvedTree }
  | FrontEndRefused
  | FrontEndBoundReached { last: FrontEndStage }

type FrontEndRun {
  steps: List<FrontEndStageStep>,
  completion: FrontEndCompletion
}

// A BOUNDED RUN IS A THIRD COMPLETION, NOT AN ABSENT NODE. run_front_end_to stops after the deepest
// stage its caller actually needs — the acceptance harness asks for exactly the depth its contract
// requires, so a contract requiring only tokenize never pays for resolve. Rendering that stop as
// 'no resolved node' would make it indistinguishable from a refusal at the last stage, which is the
// empty-observation narrow gunbc.design_argument::fail_closed names: an observation that could not express what
// happened read as the verdict that nothing happened. So the completion says WHICH stage the bound
// stopped at, and the whole-front-end projection refuses over it rather than answering.

fn front_end_stage_index(stage: FrontEndStage) -> Int {
  match stage {
    FrontEndTokenize => 1
    FrontEndParse => 2
    FrontEndNormalize => 3
    FrontEndResolve => 4
  }
}

data front_end_full_depth: Int = 4

fn front_end_passed(
  steps: List<FrontEndStageStep>,
  stage: FrontEndStage,
  receipt: FrontEndStageReceipt,
  diagnostics: Diagnostics
) -> List<FrontEndStageStep> {
  list_snoc_item(
    xs: steps,
    item: FrontEndStagePassed { stage: stage, receipt: receipt, diagnostics: diagnostics }
  )
}

fn front_end_stopped(
  steps: List<FrontEndStageStep>,
  stage: FrontEndStage,
  diagnostics: NonEmptyDiagnostics
) -> FrontEndRun {
  FrontEndRun {
    steps: list_snoc_item(
      xs: steps,
      item: FrontEndStageRejected { stage: stage, diagnostics: diagnostics }
    ),
    completion: FrontEndRefused
  }
}

fn run_front_end(source: String, file: Symbol) -> FrontEndRun {
  run_front_end_to(source: source, file: file, depth: front_end_full_depth)
}

fn run_front_end_to(source: String, file: Symbol, depth: Int) -> FrontEndRun {
  front_end_tokenize_step(source: source, file: file, lm: dag_language_model(), depth: depth)
}

fn front_end_bounded(
  steps: List<FrontEndStageStep>,
  stage: FrontEndStage
) -> FrontEndRun {
  FrontEndRun { steps: steps, completion: FrontEndBoundReached { last: stage } }
}

fn front_end_tokenize_step(source: String, file: Symbol, lm: LanguageModel, depth: Int) -> FrontEndRun {
  match tokenize_artifact(text: source, file: file, rules: lm.lex) {
    Rejected { diagnostics: r } =>
      front_end_stopped(steps: [], stage: FrontEndTokenize, diagnostics: r)
    Accepted { value: artifact, diagnostics: d } =>
      front_end_continue_parse(
        steps: front_end_passed(
          steps: [],
          stage: FrontEndTokenize,
          receipt: TokenizedSource {
            token_count: token_stream_remaining_count(stream: lex_artifact_semantic_tokens(artifact: artifact))
          },
          diagnostics: d
        ),
        artifact: artifact,
        lm: lm,
        depth: depth
      )
  }
}

fn front_end_continue_parse(
  steps: List<FrontEndStageStep>,
  artifact: LexArtifact,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  if depth <= front_end_stage_index(stage: FrontEndTokenize) {
    front_end_bounded(steps: steps, stage: FrontEndTokenize)
  } else {
    front_end_parse_step(steps: steps, artifact: artifact, lm: lm, depth: depth)
  }
}

// THE PARSE STAGE LEXES AUTHORED AND HANDS ON THE SEMANTIC HALF. The stage calls the authored sibling of
// parse_module -- the same semantic parse of the same one lex, plus every capture of that lex attached to its
// gap by the SHARED rule (std.source_annotation attach_annotations, the fold the v1 realization calls) -- and
// reads authored_parse_semantic of the artifact, which is the ParseArtifact parse_module returned before this
// change: the projection is a field read, so no emitted behaviour depends on the prose half.
// THE LOSS GUARD IS NOT CALLED HERE, AND THAT IS A MOVE WITH A NAMED EXIT, NOT A DELETION. The pair below
// (front_end_captures_all_covered calling front_end_capture_is_covered once per capture) answers ONE coverage
// question and, in the worst case, pays captures x rows calls to the borrowed
// std.source_annotation::region_contains. That is a proven cost-shape defect, and
// gunbc.design_argument::how_to_work does not let a proven cost shape ship because n is small today, while
// gunbc.design_argument::fail_closed is the reason the check exists at all -- so the check stays and the
// production call goes. The guard is executed BY NAME where the invariant is still decided, on the witnesses
// lane: v2.test.claim.staged_front_end front_end_annotation_guard_refuses_an_edge_loss_the_fold_dropped (the
// wrong case refused), ..._accepts_the_graph_the_fold_made_from_the_same_captures (the right case accepted) and
// ..._stays_silent_when_nothing_is_lost (the pair is not one-sided).
// IT RETURNS TO THIS PATH WHEN THE FOLD CARRIES THE PER-ROW CAPTURE COUNT. The exit is gunbc roadmap node
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A (source-annotation-fold-carries-absorbed-capture-count), the same identity
// front_end_capture_count_next_rung names beside the guard: with that count the authority answers the coverage
// question once per row instead of a consumer asking pair by pair. That is an exit, not an authorisation -- the
// scan is simply ABSENT from production until the count lands, and no dissolution condition here licenses
// creating the cost in the meantime.
// THE ROW LICENSES THE MOVE, in its own words: no field of parse-comment-gap-attachment-v2-consumed asks for a
// refusal in production. Its handback is exactly "A production route calls parse_module_authored -- fn
// front_end_parse_step in v2.compiler.staged_front_end -- and its consumer claim
// staged_front_end_produces_the_authored_parse_for_an_annotated_module passes by name."
// `annotation_text` is .dag's delimiter stripping, named at the .dag entry above (run_front_end_to
// already calls dag_language_model()); the parse itself names no annotation syntax.
fn front_end_parse_step(
  steps: List<FrontEndStageStep>,
  artifact: LexArtifact,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  match parse_module_authored(
    artifact: artifact,
    grammar: lm.grammar,
    annotation_text: fn(t) { strip_line_comment_delimiter(lexeme: t) }
  ) {
    Rejected { diagnostics: r } =>
      front_end_stopped(steps: steps, stage: FrontEndParse, diagnostics: r)
    Accepted { value: authored, diagnostics: d } =>
      let semantic = authored_parse_semantic(artifact: authored)
      front_end_continue_normalize(
        steps: front_end_passed(
          steps: steps,
          stage: FrontEndParse,
          receipt: ParsedModule { node_count: node_subtree_count(n: semantic.tree) },
          diagnostics: d
        ),
        parse_tree: semantic.tree,
        lm: lm,
        depth: depth
      )
  }
}

// WHAT THE GATED CLAIM READS, AND WHAT THAT READ CANNOT SEE. attach_annotations is total by
// construction: every capture lies in some gap, the file's at worst -- so a capture whose span NO row's
// origin covers was lost by the attachment itself. The fold, not the source, is wrong, and a compiler that
// silently drops authored prose at the parse stage is exactly what gunbc.design_argument::fail_closed
// refuses to let happen quietly. The check is language-neutral: it asks a coverage question, it does not
// interpret.
// IT OWNS NO GEOMETRY. Whether one span lies inside another is answered by the ONE predicate the authority
// that decides attachment already uses -- std.source_annotation::region_contains -- and the span a capture
// is measured against is the span the fold itself was given for it, taken through
// v2.compiler.parse::authored_normalized_capture (its `annotation_text` is the identity here because only
// `.origin` is read, never the text). No offset is compared anywhere in this module, so nothing in this
// module can disagree with the fold about containment (gunbc.design_argument::single_authority).
// WHAT IT CANNOT SEE, BOTH LIMITS STATED HERE AND CARRIED IN ONE TYPE BESIDE IT. (1) INTERIOR LOSS: an
// ADJACENT block joins into ONE row whose origin runs from its first capture's start to its last capture's
// end (std.source_annotation annotation_attach_step), so a capture lost in the MIDDLE of such a block leaves
// every capture's span still covered -- coverage is not multiplicity. (2) FILE-BLINDNESS: the predicate this
// guard borrows, std.source_annotation::region_contains, compares start and end only and reads no file field
// of either SourceSpan -- so a
// capture naming a DIFFERENT FILE than the row covering it reads as contained, which makes this a
// SINGLE-MODULE attach check and nothing more. Nothing in production refuses either case today; the moment
// they become checkable is declared in front_end_capture_interior_loss_next_rung, and the count that would
// make them checkable is the debt front_end_capture_count_next_rung names.
// WHAT IT ALSO DOES NOT SEE: WHICH gap a capture landed in. Placement is checked only by the v1/v2 agreement
// control (v2.test.claim.manual.annotation_gap_v1_v2_agreement), which publishes its identity AND its rung as
// carriers there -- this comment states no rung, because a status written twice is a status that can lie:
// probe_pair_rung_agrees_with_the_floors_own_admission re-derives it from v2.workflow.required_floor
// required_gate_admits. Read that carrier: while it reads ManualUngated, a placement divergence is caught only
// when someone runs the control by hand, so THIS guard is a loss guard and nothing more. The moment that
// changes is declared, not deferred: front_end_placement_control_next_rung
// (gunbc.design_argument::guarantee_ladder, no untracked stall).
// WHO EXECUTES THIS GUARD TODAY, AND WHERE IT WOULD GO BACK. Production no longer calls it (see
// front_end_parse_step): the pair's worst-case captures x rows cost is why, and v2.test.claim.staged_front_end
// is where it is executed by name, refusal AND acceptance, on the witnesses lane. The way back into
// front_end_parse_step is the fold carrying a per-row capture count -- gunbc roadmap node
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A (source-annotation-fold-carries-absorbed-capture-count) -- because with that
// count the coverage question is answered once per row by the authority that decides attachment, instead of
// pair by pair by a consumer (the debt front_end_capture_count_next_rung names).
fn front_end_capture_origin_as_the_fold_sees(capture: UnboundSourceAnnotation) -> SourceSpan {
  // Identity stripping, because only the span is read. Routing through the fold's own normalization is the
  // point: the guard measures a capture by the span attachment was handed, never by one it minted itself.
  authored_normalized_capture(capture: capture, annotation_text: fn(t) { t }).origin
}

// A capture is landed when SOME row's origin covers its span -- asked of the authority's own predicate, with no
// local comparison of offsets. THE SCAN IS THE REPO'S OWN SHORT-CIRCUITING ONE and the capture's span is built
// ONCE per capture rather than once per (capture, row) pair: std.list::first_where stops calling the predicate as
// soon as it holds a witness, so the rows stop being visited the moment the answer is known, and
// authored_normalized_capture runs exactly once per capture instead of once per pair.
// WHAT THIS DOES NOT REMOVE, stated rather than left to be inferred: with no ordering decision available from the
// authority -- std.source_annotation::region_contains answers containment for ONE pair and nothing else -- "does
// SOME row cover this span" must still be asked pair by pair in the worst case. Removing that residue is the
// fold's work, not a consumer's: it is the field front_end_capture_count_next_rung names, because a consumer that
// guessed where a row ends would be deciding std.source_annotation annotation_attach_step's join rule in a second
// place (gunbc.design_argument::single_authority, and how_to_work on a proven cost-shape defect being always
// fixed). The consumer's own waste -- one authority call per pair, and visits after the answer was known -- is
// what is fixed here.
fn front_end_capture_is_covered(
  capture: UnboundSourceAnnotation,
  rows: List<SourceAnnotationDebt>
) -> Bool {
  let origin = front_end_capture_origin_as_the_fold_sees(capture: capture)
  match first_where(xs: rows, keep: fn(row) {
    region_contains(extent: row.origin, origin: origin)
  }) {
    Present { value: _ } => true
    Absent => false
  }
}

// The outer scan short-circuits the same way: the FIRST capture no row covers decides the whole answer, so a
// module that is already refused does not pay for the captures that follow it.
fn front_end_captures_all_covered(
  captures: List<UnboundSourceAnnotation>,
  rows: List<SourceAnnotationDebt>
) -> Bool {
  match first_where(xs: captures, keep: fn(capture) {
    !front_end_capture_is_covered(capture: capture, rows: rows)
  }) {
    Present { value: _ } => false
    Absent => true
  }
}

// WHO REFUSED, IN A FORM A CENSUS CAN JOIN ON. An uncovered capture means the fold, not the source, is
// wrong, so the refusal names the declarer whose contract it depends on instead of shrugging with
// ExternalContractUnknown: std.source_annotation::annotation_attach_step, the fold that decides both the join
// rule and the containment predicate this guard borrows. Carried as the qualified path in SEGMENTS, exactly as
// DeclarationLocus carries one (v2.std.diagnostic NoCorrectionReason DeclarerRefused), so a census joins on the
// identity and never on the reason's prose. v2.test.claim.staged_front_end
// front_end_unlanded_capture_refusal_names_the_fold_as_the_refused_declarer pins it, and
// front_end_sibling_refusals_name_no_refused_declarer keeps the arm from being a default.
fn front_end_capture_authority_declarer() -> FreeMonoid<Symbol> {
  Cons {
    head: ^std,
    tail: Cons { head: ^source_annotation, tail: Cons { head: ^annotation_attach_step, tail: Empty } }
  }
}

fn front_end_unlanded_annotation_diagnostic(
  captures: List<UnboundSourceAnnotation>,
  graph: SourceAnnotationGraph
) -> Optional<Diagnostic> {
  if front_end_captures_all_covered(
    captures: captures,
    rows: source_annotation_graph_rows(graph: graph)
  ) {
    Absent
  } else {
    Present {
      value: Diagnostic {
        reason: ^staged_front_end_annotation_capture_unlanded,
        at: invariant_port_locus(
          port: ^staged_front_end_locus_port,
          invariant: ^staged_front_end_annotation_capture_unlanded
        ),
        correction: Unavailable { reason: DeclarerRefused { declarer: front_end_capture_authority_declarer() } }
      }
    }
  }
}

// THE DECLARED MOMENT TO GATE THE PLACEMENT HALF, not a promise in a comment: a dissolution condition, so a
// reader and a claim can both reach it. It is UNBOUND because nothing in the tree fires it -- the runner that
// judged this floor was deleted and no workflow passes a --required flag, so binding it to a declaration today
// would be a trigger that can never fire beside a control that is never run. v2.test.claim.staged_front_end
// front_end_placement_next_rung_is_declared_and_names_the_control reads it back and refuses if the condition is
// ever BOUND while no floor can execute -- which is the one thing here that a predicate can decide without
// re-typing this carrier's prose and grepping it.
data front_end_placement_control_next_rung: DissolutionCondition = unbound_dissolution(description: "GATE THE PLACEMENT HALF WHEN v2.test.claim.manual.annotation_gap_v1_v2_agreement is both enrolled by name in v2.workflow.required_floor required_gate_authored_modules on an operator ruling AND executed by some floor that can execute -- gunbc.rung_drop_amendment.manual_required_floor_runner_deleted records the required-floor runner as deleted (amended 2026-10-14) and no workflow passes a --required flag, so neither half holds today. Until both halves hold, front_end_unlanded_annotation_diagnostic checks loss only and placement is checked by hand. At that moment agreement_control_rung in that control must be restated, which v2.test.claim.manual.annotation_gap_v1_v2_agreement_probe_pair probe_pair_rung_agrees_with_the_floors_own_admission refuses if it is left stale.")

// THE LOSS CHECK IS INTERIM, AND SAYS SO IN A TYPE BESIDE IT. A capture COUNT read back out of the fold's rows
// would decide the join rule in a second place, which gunbc.design_argument::single_authority forbids, so this
// guard asks only a coverage question through the authority's own predicate. A weaker guard with a declared
// limit is honest; a counter deciding a separator is not. The two carriers below state where the guard stops and what moves the
// stop, so no reader has to infer either from this comment.
data front_end_capture_count_next_rung: DissolutionCondition = unbound_dissolution(description: "REBUILD THE LOSS CHECK ON A COUNT THE FOLD CARRIES WHEN dag/std/source_annotation.dag states how many lex captures each annotation row absorbed -- a field on SourceAnnotationDebt, or a count on SourceAnnotationGraph, set by annotation_attach_step -- so front_end_unlanded_annotation_diagnostic compares a multiplicity the model already carries instead of only coverage. The row carrying that obligation is source-annotation-fold-carries-absorbed-capture-count (rn_ZR45MIQ7KTC56XVLT23LXQ3W4A) in dag/gunbc/roadmap/roadmap_authority.dag, owner parse, carrier dag/std/source_annotation.dag, dispatch NotDispatchable until its discriminating pair has been executed. WHY THE COUNT MUST COME FROM THE FOLD AND NOT FROM THIS CONSUMER: a reader that counts line feeds back out of the rows to decide whether a parse is refused restates std.source_annotation annotation_attach_step's join rule in a second place, which gunbc.design_argument::single_authority forbids. So the obligation is a field the fold SETS, never a count a consumer computes.")

// BOTH BLIND SPOTS OF THE COVERAGE GUARD, IN THEIR OWN TYPE BESIDE THE RUNG ABOVE, because a limit that
// lives only in the guard's comment is a limit a later reader cites as protection. (1) An INTERIOR loss --
// the middle capture of a joined block dropped while its neighbours survive -- leaves every capture's span
// still covered, since one joined row's origin runs from its first capture's start to its last capture's end
// (std.source_annotation annotation_attach_step). (2) A CROSS-FILE capture reads as contained, since the
// borrowed predicate compares start and end only and never reads the file field. The claim
// v2.test.claim.staged_front_end front_end_annotation_guard_declares_both_limits_interior_loss_and_file_blindness
// PINS both by executing them, and says so in its own name; when the count lands those two conjuncts must be
// rewritten into refusals, and those rewrites are the executed signal that the limits moved.
data front_end_capture_interior_loss_next_rung: DissolutionCondition = unbound_dissolution(description: "REFUSE AN INTERIOR LOSS AND A CROSS-FILE CAPTURE WHEN the fold carries the count of lex captures each row absorbed (row source-annotation-fold-carries-absorbed-capture-count, rn_ZR45MIQ7KTC56XVLT23LXQ3W4A, carrier dag/std/source_annotation.dag), because whole-interval containment cannot see either one. LIMIT ONE, INTERIOR: an adjacent block joins into ONE row whose origin spans its whole block, so a capture lost in the MIDDLE of that block leaves every capture's span still covered and front_end_unlanded_annotation_diagnostic silent. LIMIT TWO, FILE-BLINDNESS: the predicate it borrows, std.source_annotation::region_contains, compares start and end only and reads no file field of either SourceSpan -- so a capture naming a DIFFERENT FILE than the row that covers it reads as contained and the guard is valid for SINGLE-MODULE attach only. Until that count exists this is a weaker guard with two declared limits, not a loss-free parse.")

fn front_end_continue_normalize(
  steps: List<FrontEndStageStep>,
  parse_tree: Node,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  if depth <= front_end_stage_index(stage: FrontEndParse) {
    front_end_bounded(steps: steps, stage: FrontEndParse)
  } else {
    front_end_normalize_step(steps: steps, parse_tree: parse_tree, lm: lm, depth: depth)
  }
}

fn front_end_normalize_step(
  steps: List<FrontEndStageStep>,
  parse_tree: Node,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  match normalize(parse_tree: parse_tree) {
    Rejected { diagnostics: r } =>
      front_end_stopped(steps: steps, stage: FrontEndNormalize, diagnostics: r)
    Accepted { value: normalized, diagnostics: d } =>
      front_end_continue_resolve(
        steps: front_end_passed(
          steps: steps,
          stage: FrontEndNormalize,
          receipt: NormalizedModule { node_count: node_subtree_count(n: normalized.root) },
          diagnostics: d
        ),
        normalized: normalized,
        lm: lm,
        depth: depth
      )
  }
}

fn front_end_continue_resolve(
  steps: List<FrontEndStageStep>,
  normalized: NormalizedTree,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  if depth <= front_end_stage_index(stage: FrontEndNormalize) {
    front_end_bounded(steps: steps, stage: FrontEndNormalize)
  } else {
    front_end_resolve_step(steps: steps, normalized: normalized, lm: lm)
  }
}

fn front_end_resolve_step(
  steps: List<FrontEndStageStep>,
  normalized: NormalizedTree,
  lm: LanguageModel
) -> FrontEndRun {
  match resolve(tree: normalized, lm: lm) {
    Rejected { diagnostics: r } =>
      front_end_stopped(steps: steps, stage: FrontEndResolve, diagnostics: r)
    Accepted { value: resolved, diagnostics: d } =>
      FrontEndRun {
        steps: front_end_passed(
          steps: steps,
          stage: FrontEndResolve,
          receipt: ResolvedModule { node_count: node_subtree_count(n: resolved.root) },
          diagnostics: d
        ),
        completion: FrontEndResolvedModule { resolved: resolved }
      }
  }
}

fn front_end_accumulated_diagnostics(steps: List<FrontEndStageStep>) -> Diagnostics {
  fold(steps, init: None, f: fn(acc, step) {
    match step {
      FrontEndStagePassed { stage: _, receipt: _, diagnostics: d } =>
        diagnostics_merge(outer: acc, inner: d)
      FrontEndStageRejected { stage: _, diagnostics: _ } => acc
    }
  })
}

fn front_end_first_refusal(steps: List<FrontEndStageStep>) -> Optional<NonEmptyDiagnostics> {
  fold(steps, init: optional_absent(), f: fn(acc, step) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match step {
          FrontEndStagePassed { stage: _, receipt: _, diagnostics: _ } => optional_absent()
          FrontEndStageRejected { stage: _, diagnostics: r } => optional_present(value: r)
        }
    }
  })
}

fn front_end_run_outcome(run: FrontEndRun) -> Outcome<ResolvedTree> {
  match front_end_first_refusal(steps: run.steps) {
    Present { value: r } =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: front_end_accumulated_diagnostics(steps: run.steps),
          rejected: r
        )
      }
    Absent =>
      match run.completion {
        FrontEndResolvedModule { resolved: resolved } =>
          Accepted {
            value: resolved,
            diagnostics: front_end_accumulated_diagnostics(steps: run.steps)
          }
        FrontEndBoundReached { last: last } =>
          Rejected { diagnostics: front_end_bounded_diagnostics(last: last) }
        FrontEndRefused =>
          Rejected { diagnostics: front_end_incomplete_diagnostics() }
      }
  }
}

// The no-refusal-and-no-resolved arm is unreachable by construction: run_front_end reaches
// FrontEndRun with Present resolved only through front_end_resolve_step's Accepted arm, and every
// other exit appends a FrontEndStageRejected. It refuses with a typed, located diagnostic rather
// than fabricating an Accepted over a node it does not have — an unreachable arm refuses, never
// fabricates (gunbc.design_argument::fail_closed).

fn front_end_bound_reason(stage: FrontEndStage) -> Symbol {
  match stage {
    FrontEndTokenize => ^staged_front_end_bounded_after_tokenize
    FrontEndParse => ^staged_front_end_bounded_after_parse
    FrontEndNormalize => ^staged_front_end_bounded_after_normalize
    FrontEndResolve => ^staged_front_end_bounded_after_resolve
  }
}

fn front_end_bounded_diagnostics(last: FrontEndStage) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: Diagnostic {
      reason: front_end_bound_reason(stage: last),
      at: invariant_port_locus(port: ^staged_front_end_locus_port, invariant: front_end_bound_reason(stage: last)),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}

fn front_end_incomplete_diagnostics() -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: Diagnostic {
      reason: ^staged_front_end_run_incomplete,
      at: invariant_port_locus(port: ^staged_front_end_locus_port, invariant: ^staged_front_end_run_incomplete),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}
