module v2.compiler.staged_front_end

import std.types { List }
import v2.compiler.normalize { normalize }
import v2.compiler.parse { authored_parse_annotations, authored_parse_semantic, parse_module_authored }
import v2.compiler.resolve { ResolvedTree, resolve }
import v2.compiler.tokenize { tokenize_artifact }
import v2.extdeps.languages.dag { dag_language_model }
import extdeps.languages.dag.syntax { strip_line_comment_delimiter }
import std.algebra { list_snoc_item, length }
import std.source_annotation { source_annotation_graph_rows }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import v2.std.compilers.lexing { LexArtifact, lex_artifact_semantic_tokens, token_stream_remaining_count }
import v2.std.language_model { LanguageModel }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }
import v2.compiler.normalized_tree { NormalizedTree }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Unavailable,
  diagnostics_singleton,
  invariant_port_locus,
  Diagnostics,
  None,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  diagnostics_merge,
  rejected_with_pending,
}
import v2.std.node { Node, Symbol, node_subtree_count }

// One authority for the .dag front-end ORDER, two projections. The order tokenize -> parse ->
// normalize -> resolve was spelled once inside ingested_resolved_module_from_source as a nest of
// bind_outcome, which returns one Outcome<Node> for the whole front end and therefore cannot say
// WHICH stage a candidate died at. The acceptance harness needs exactly that fact per candidate,
// and re-inlining the four calls beside the existing arrow would have been a second copy of the
// order — the section-3 nickname class, and one that drifts silently because nothing makes the two
// copies disagree loudly. So the order moved HERE and both consumers project from it:
// front_end_run_outcome folds the staged run back to the Outcome<Node> the old arrow returned, and
// the acceptance harness reads the per-stage steps.

// The projection is a FOLD OF THE STAGED RESULT AND NOTHING ELSE — it never re-runs a stage, so it
// cannot disagree with the steps it reports. It reproduces bind_outcome's diagnostic threading
// exactly, which is the whole of the behavior it must preserve: accepted-stage diagnostics
// accumulate in stage order (diagnostics_merge), and a refusal carries the accumulated pending
// diagnostics ahead of its own (rejected_with_pending) — the two moves bind_outcome_accepted makes.
// A projection that dropped accepted-stage diagnostics would be silently lossy for every existing
// caller while still typechecking.

type FrontEndStage
  = FrontEndTokenize
  | FrontEndParse
  | FrontEndNormalize
  | FrontEndResolve

type FrontEndStageReceipt
  = TokenizedSource { token_count: Int }
  | ParsedModule { node_count: Int, annotation_count: Int }
  | NormalizedModule { node_count: Int }
  | ResolvedModule { node_count: Int }

type FrontEndStageStep
  = FrontEndStagePassed {
      stage: FrontEndStage,
      receipt: FrontEndStageReceipt,
      diagnostics: Diagnostics
    }
  | FrontEndStageRejected {
      stage: FrontEndStage,
      diagnostics: NonEmptyDiagnostics
    }

type FrontEndCompletion
  = FrontEndResolvedModule { resolved: ResolvedTree }
  | FrontEndRefused
  | FrontEndBoundReached { last: FrontEndStage }

type FrontEndRun {
  steps: List<FrontEndStageStep>,
  completion: FrontEndCompletion
}

// A BOUNDED RUN IS A THIRD COMPLETION, NOT AN ABSENT NODE. run_front_end_to stops after the deepest
// stage its caller actually needs — the acceptance harness asks for exactly the depth its contract
// requires, so a contract requiring only tokenize never pays for resolve. Rendering that stop as
// 'no resolved node' would make it indistinguishable from a refusal at the last stage, which is the
// empty-observation narrow gunbc.design_argument::fail_closed names: an observation that could not express what
// happened read as the verdict that nothing happened. So the completion says WHICH stage the bound
// stopped at, and the whole-front-end projection refuses over it rather than answering.

fn front_end_stage_index(stage: FrontEndStage) -> Int {
  match stage {
    FrontEndTokenize => 1
    FrontEndParse => 2
    FrontEndNormalize => 3
    FrontEndResolve => 4
  }
}

data front_end_full_depth: Int = 4

fn front_end_passed(
  steps: List<FrontEndStageStep>,
  stage: FrontEndStage,
  receipt: FrontEndStageReceipt,
  diagnostics: Diagnostics
) -> List<FrontEndStageStep> {
  list_snoc_item(
    xs: steps,
    item: FrontEndStagePassed { stage: stage, receipt: receipt, diagnostics: diagnostics }
  )
}

fn front_end_stopped(
  steps: List<FrontEndStageStep>,
  stage: FrontEndStage,
  diagnostics: NonEmptyDiagnostics
) -> FrontEndRun {
  FrontEndRun {
    steps: list_snoc_item(
      xs: steps,
      item: FrontEndStageRejected { stage: stage, diagnostics: diagnostics }
    ),
    completion: FrontEndRefused
  }
}

fn run_front_end(source: String, file: Symbol) -> FrontEndRun {
  run_front_end_to(source: source, file: file, depth: front_end_full_depth)
}

fn run_front_end_to(source: String, file: Symbol, depth: Int) -> FrontEndRun {
  front_end_tokenize_step(source: source, file: file, lm: dag_language_model(), depth: depth)
}

fn front_end_bounded(
  steps: List<FrontEndStageStep>,
  stage: FrontEndStage
) -> FrontEndRun {
  FrontEndRun { steps: steps, completion: FrontEndBoundReached { last: stage } }
}

fn front_end_tokenize_step(source: String, file: Symbol, lm: LanguageModel, depth: Int) -> FrontEndRun {
  match tokenize_artifact(text: source, file: file, rules: lm.lex) {
    Rejected { diagnostics: r } =>
      front_end_stopped(steps: [], stage: FrontEndTokenize, diagnostics: r)
    Accepted { value: artifact, diagnostics: d } =>
      front_end_continue_parse(
        steps: front_end_passed(
          steps: [],
          stage: FrontEndTokenize,
          receipt: TokenizedSource {
            token_count: token_stream_remaining_count(stream: lex_artifact_semantic_tokens(artifact: artifact))
          },
          diagnostics: d
        ),
        artifact: artifact,
        lm: lm,
        depth: depth
      )
  }
}

fn front_end_continue_parse(
  steps: List<FrontEndStageStep>,
  artifact: LexArtifact,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  if depth <= front_end_stage_index(stage: FrontEndTokenize) {
    front_end_bounded(steps: steps, stage: FrontEndTokenize)
  } else {
    front_end_parse_step(steps: steps, artifact: artifact, lm: lm, depth: depth)
  }
}

// THE PARSE STAGE LEXES AUTHORED AND READS BOTH HALVES OF WHAT IT ATTACHED. The stage calls the authored
// sibling of parse_module -- the same semantic parse of the same one lex, plus every capture attached to its gap
// by the SHARED rule (std.source_annotation attach_annotations) -- and reads the semantic half forward through
// authored_parse_semantic, plus the annotation half ONCE, as a receipt quantity: annotation_count is
// length(xs:) over the fold's emitted rows (source_annotation_graph_rows of authored_parse_annotations), the
// same idiom as the lex stage's token_count. It is a RECEIPT number reported by the stage, NOT the fold's
// per-row absorbed-capture count and NOT the count that discharges gunbc roadmap node
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A -- and it judges nothing: no span is compared here, and the count is never
// compared against the capture count, which would decide std.source_annotation annotation_attach_step's join
// rule in a second place (gunbc.design_argument::single_authority). The named consumer that reads it back over
// an executing route is v2.test.claim.staged_front_end
// staged_front_end_produces_the_authored_parse_for_an_annotated_module, positive on a commented module and zero
// on an uncommented one.
// ANNOTATION-ATTACHMENT LOSS IS NOT CHECKED HERE, OR ANYWHERE ELSE. A guard for it stood in this module and
// then in its test module, where its only consumers were tests of itself; it was deleted rather than left
// asserting its own existence, and the hole it covered is tracked by the gunbc roadmap node
// rn_ZR45MIQ7KTC56XVLT23LXQ3W4A (source-annotation-fold-carries-absorbed-capture-count), whose carrier is
// dag/std/source_annotation.dag. The guard's cost shape -- captures x rows calls to the borrowed
// std.source_annotation::region_contains, a proven defect gunbc.design_argument::how_to_work does not allow to
// ship -- was MOVED OFF THE PARSE PATH, NOT FIXED. The concrete precondition for a loss check landing anywhere
// is the fold carrying the absorbed capture count, so the check costs one integer per row instead of a cross
// product; naming that precondition is what makes the deferral bounded rather than a wish.
// The row itself asks for no production refusal; its handback is "A production route calls
// parse_module_authored -- fn front_end_parse_step in v2.compiler.staged_front_end -- and its consumer claim
// staged_front_end_produces_the_authored_parse_for_an_annotated_module passes by name."
// `annotation_text` is .dag's delimiter stripping, named at the .dag entry above (run_front_end_to
// already calls dag_language_model()); the parse itself names no annotation syntax.
fn front_end_parse_step(
  steps: List<FrontEndStageStep>,
  artifact: LexArtifact,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  match parse_module_authored(
    artifact: artifact,
    grammar: lm.grammar,
    annotation_text: fn(t) { strip_line_comment_delimiter(lexeme: t) }
  ) {
    Rejected { diagnostics: r } =>
      front_end_stopped(steps: steps, stage: FrontEndParse, diagnostics: r)
    Accepted { value: authored, diagnostics: d } =>
      let semantic = authored_parse_semantic(artifact: authored)
      front_end_continue_normalize(
        steps: front_end_passed(
          steps: steps,
          stage: FrontEndParse,
          receipt: ParsedModule {
            node_count: node_subtree_count(n: semantic.tree),
            annotation_count: length(xs: source_annotation_graph_rows(graph: authored_parse_annotations(artifact: authored))),
          },
          diagnostics: d
        ),
        parse_tree: semantic.tree,
        lm: lm,
        depth: depth
      )
  }
}

// THE DECLARED MOMENT TO GATE THE PLACEMENT HALF, not a promise in a comment: a dissolution condition, so a
// reader and a claim can both reach it. It is UNBOUND because nothing in the tree fires it -- the runner that
// judged this floor was deleted and no workflow passes a --required flag, so binding it to a declaration today
// would be a trigger that can never fire beside a control that is never run. v2.test.claim.staged_front_end
// front_end_placement_next_rung_is_declared_and_names_the_control reads it back and refuses if the condition is
// ever BOUND while no floor can execute -- which is the one thing here that a predicate can decide without
// re-typing this carrier's prose and grepping it.
data front_end_placement_control_next_rung: DissolutionCondition = unbound_dissolution(description: "GATE THE PLACEMENT HALF WHEN v2.test.claim.manual.annotation_gap_v1_v2_agreement is both enrolled by name in v2.workflow.required_floor required_gate_authored_modules on an operator ruling AND executed by some floor that can execute -- gunbc.rung_drop_amendment.manual_required_floor_runner_deleted records the required-floor runner as deleted (amended 2026-10-14) and no workflow passes a --required flag, so neither half holds today. Until both halves hold, the agreement control stays manual and ungated, attachment loss is checked by nothing in the tree, and placement is checked by hand. At that moment agreement_control_rung in that control must be restated, which v2.test.claim.manual.annotation_gap_v1_v2_agreement_probe_pair probe_pair_rung_agrees_with_the_floors_own_admission refuses if it is left stale.")



fn front_end_continue_normalize(
  steps: List<FrontEndStageStep>,
  parse_tree: Node,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  if depth <= front_end_stage_index(stage: FrontEndParse) {
    front_end_bounded(steps: steps, stage: FrontEndParse)
  } else {
    front_end_normalize_step(steps: steps, parse_tree: parse_tree, lm: lm, depth: depth)
  }
}

fn front_end_normalize_step(
  steps: List<FrontEndStageStep>,
  parse_tree: Node,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  match normalize(parse_tree: parse_tree) {
    Rejected { diagnostics: r } =>
      front_end_stopped(steps: steps, stage: FrontEndNormalize, diagnostics: r)
    Accepted { value: normalized, diagnostics: d } =>
      front_end_continue_resolve(
        steps: front_end_passed(
          steps: steps,
          stage: FrontEndNormalize,
          receipt: NormalizedModule { node_count: node_subtree_count(n: normalized.root) },
          diagnostics: d
        ),
        normalized: normalized,
        lm: lm,
        depth: depth
      )
  }
}

fn front_end_continue_resolve(
  steps: List<FrontEndStageStep>,
  normalized: NormalizedTree,
  lm: LanguageModel,
  depth: Int
) -> FrontEndRun {
  if depth <= front_end_stage_index(stage: FrontEndNormalize) {
    front_end_bounded(steps: steps, stage: FrontEndNormalize)
  } else {
    front_end_resolve_step(steps: steps, normalized: normalized, lm: lm)
  }
}

fn front_end_resolve_step(
  steps: List<FrontEndStageStep>,
  normalized: NormalizedTree,
  lm: LanguageModel
) -> FrontEndRun {
  match resolve(tree: normalized, lm: lm) {
    Rejected { diagnostics: r } =>
      front_end_stopped(steps: steps, stage: FrontEndResolve, diagnostics: r)
    Accepted { value: resolved, diagnostics: d } =>
      FrontEndRun {
        steps: front_end_passed(
          steps: steps,
          stage: FrontEndResolve,
          receipt: ResolvedModule { node_count: node_subtree_count(n: resolved.root) },
          diagnostics: d
        ),
        completion: FrontEndResolvedModule { resolved: resolved }
      }
  }
}

fn front_end_accumulated_diagnostics(steps: List<FrontEndStageStep>) -> Diagnostics {
  fold(steps, init: None, f: fn(acc, step) {
    match step {
      FrontEndStagePassed { stage: _, receipt: _, diagnostics: d } =>
        diagnostics_merge(outer: acc, inner: d)
      FrontEndStageRejected { stage: _, diagnostics: _ } => acc
    }
  })
}

fn front_end_first_refusal(steps: List<FrontEndStageStep>) -> Optional<NonEmptyDiagnostics> {
  fold(steps, init: optional_absent(), f: fn(acc, step) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match step {
          FrontEndStagePassed { stage: _, receipt: _, diagnostics: _ } => optional_absent()
          FrontEndStageRejected { stage: _, diagnostics: r } => optional_present(value: r)
        }
    }
  })
}

fn front_end_run_outcome(run: FrontEndRun) -> Outcome<ResolvedTree> {
  match front_end_first_refusal(steps: run.steps) {
    Present { value: r } =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: front_end_accumulated_diagnostics(steps: run.steps),
          rejected: r
        )
      }
    Absent =>
      match run.completion {
        FrontEndResolvedModule { resolved: resolved } =>
          Accepted {
            value: resolved,
            diagnostics: front_end_accumulated_diagnostics(steps: run.steps)
          }
        FrontEndBoundReached { last: last } =>
          Rejected { diagnostics: front_end_bounded_diagnostics(last: last) }
        FrontEndRefused =>
          Rejected { diagnostics: front_end_incomplete_diagnostics() }
      }
  }
}

// The no-refusal-and-no-resolved arm is unreachable by construction: run_front_end reaches
// FrontEndRun with Present resolved only through front_end_resolve_step's Accepted arm, and every
// other exit appends a FrontEndStageRejected. It refuses with a typed, located diagnostic rather
// than fabricating an Accepted over a node it does not have — an unreachable arm refuses, never
// fabricates (gunbc.design_argument::fail_closed).

fn front_end_bound_reason(stage: FrontEndStage) -> Symbol {
  match stage {
    FrontEndTokenize => ^staged_front_end_bounded_after_tokenize
    FrontEndParse => ^staged_front_end_bounded_after_parse
    FrontEndNormalize => ^staged_front_end_bounded_after_normalize
    FrontEndResolve => ^staged_front_end_bounded_after_resolve
  }
}

fn front_end_bounded_diagnostics(last: FrontEndStage) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: Diagnostic {
      reason: front_end_bound_reason(stage: last),
      at: invariant_port_locus(port: ^staged_front_end_locus_port, invariant: front_end_bound_reason(stage: last)),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}

fn front_end_incomplete_diagnostics() -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: Diagnostic {
      reason: ^staged_front_end_run_incomplete,
      at: invariant_port_locus(port: ^staged_front_end_locus_port, invariant: ^staged_front_end_run_incomplete),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}
