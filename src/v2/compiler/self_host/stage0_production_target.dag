module v2.compiler.self_host.stage0_production_target

import std.types { List, Map }
import v2.extdeps.languages.rust { rust_binding_spellings, rust_closure_crate_target_model }
import v2.std.compilers.target_model { TargetModel }
import std.algebra { map_insert }

import v2.std.node { Symbol }
import v2.std.text { String }

// THE STAGE0 EMISSION BOUNDARY, AS A TARGET PROFILE.
//
// v2.extdeps.languages.rust owns what Rust IS. This module owns what the stage0 seed crate
// REQUIRES of a module emitted into it, which is a different fact and a policy one: the crate
// is an existing artifact with an existing ABI, and a module replacing one of its files has to
// meet that ABI or the crate stops compiling. Two selections are all that separates the
// production boundary from the direct-door fixture boundary today, and neither is a change to
// the Rust language model:
//
//   VISIBILITY. Every committed stage0 mirror declares its items `pub`, because the crate's
//   other modules call across module boundaries (gunbc_rust_decl_type_overlay's function is
//   called from v1_compiler_emit_rust). The .dag source spells no visibility, and Rust emission
//   in general must not: a private item is correct at a boundary with no external consumer.
//   So the keyword is a Rust row (rust_visibility_public_lex_rule) selected by the closure-crate profile
//   (rust_closure_crate_target_model), which this boundary takes whole.
//
//   INTEGER SPELLING, AND ONLY THE SPELLING. The committed stage0 ABI is i64 and the
//   direct-door fixtures are organized around i32. Relabelling the fixture target to i64 would
//   erase the distinction rather than model it, so this profile OVERLAYS the one key it changes
//   onto the Rust map instead of re-spelling the map or re-parameterizing it. The overlay is
//   what keeps the base map byte-identical, which matters beyond tidiness: every claim that
//   already shares one evaluation of rust_target_model keeps sharing exactly that evaluation,
//   so this selection charges no other witness.
//
//   WHAT THIS IS NOT is a selection of Rust's realization of the language's `Int`. Rust's
//   representation authority for a type atom is rust_target_atom_realization_catalog, and the
//   produced-declaration type-reference route does not consult it: it renders
//   ^dag_binding_type_int through binding_spellings, so that map is a second, weaker home for a
//   fact the catalog owns (the duplicate `bool` spelling is the same fork seen from the other
//   side, and an atom with no spelling there prints its symbol lexeme instead of refusing).
//   This profile therefore overlays the route that actually produces the tokens, and says so:
//   it is a bounded compatibility overlay for the stage0 boundary, not the canonical
//   representation repair. That repair -- produced-declaration type references resolving
//   through TargetAtomRealization, with a missing realization a typed refusal and neither
//   binding_spellings nor a symbol lexeme admitted as a fallback in a type position -- is its
//   own emission lane, and this overlay moves to the catalog when it lands.
//
// Everything else -- the bundle, the produced-declaration render schema, the runtime row, the
// authority source text -- is taken from rust_target_model unchanged, so this profile cannot
// drift into a second Rust emitter. It is a selection over one, and a Rust rule added upstream
// reaches this boundary without an edit here.

data stage0_production_int_spelling: String = "i64"

// The Rust map with one key replaced. A second map authored here would be a fork of a spelling
// authority (DESIGN section 3): every other spelling this boundary needs is Rust's own and must
// keep tracking it.
fn stage0_production_binding_spellings() -> Map<Symbol, String> {
  map_insert(rust_binding_spellings(), ^dag_binding_type_int, stage0_production_int_spelling)
}

// The stage0 boundary is the closure-crate profile (v2.extdeps.languages.rust rust_closure_crate_target_model:
// every module-level declaration `pub`) with the one integer spelling overlaid; the visibility rows are
// Rust's, not restated here.
fn stage0_production_target_model() -> TargetModel {
  let base = rust_closure_crate_target_model()
  TargetModel {
    primitive_realizations: base.primitive_realizations,
    produced_decl_support: base.produced_decl_support,
    bundle: base.bundle,
    lex: base.lex,
    binding_spellings: stage0_production_binding_spellings(),
    token_class_emit_transforms: base.token_class_emit_transforms,
    authority_source_text: base.authority_source_text,
    runtime_row: base.runtime_row
  }
}
