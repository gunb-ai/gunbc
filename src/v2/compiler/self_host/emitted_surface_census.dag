module v2.compiler.self_host.emitted_surface_census

import std.algebra { Cons, Empty }
import v2.std.algebra { any, count_where, filter, length }
import v2.std.collection { List }
import v2.std.diagnostic { Diagnostic, Outcome, outcome_accepted, outcome_rejected, textual_whole_file_diagnostic, Correction, Unavailable, NoCorrectionReason, ExternalContractUnknown }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }
import v2.std.integer { Int }

// CLOSURE SELECTS PRODUCTS; IT DOES NOT DEFINE PROVIDER INTERFACES.
//
// A closure may decide which modules a sealed artifact CONTAINS. A reusable module's export
// surface is declared by that module's own authority and is invariant under which entry
// requested it. A seed is a canonical provider for FUTURE closures, not an optimized
// projection of one PAST closure.
//
// This module OBSERVES and REFUSES. It does not decide what a module's canonical surface IS --
// that is a separate semantic authority, and selecting a winner here would destroy the very
// variation this census exists to report: once a canonical surface is installed, the semantic
// authority downstream would be derived from whatever this observation happened to pick.

// WHY THE CRATE ROOT IS A TYPED ARM AND NOT A FILTER.
//
// The crate root's `pub mod` list IS closure membership, which the law above expressly permits,
// so it varies legitimately across entries. A census without this distinction refuses every
// multi-entry tree on its first run and is switched off. Spelling the carve-out as a skip
// inside the comparator would make it indistinguishable from an oversight later, and an
// exemption that looks like an oversight is the surface a future defect hides behind. As a
// named arm on product kind, the crate root is excluded BY CONSTRUCTION rather than by a
// predicate someone must keep correct.
type ProductKind
  = CrateRoot
  | ProviderModule

// Identity of one emitted member, at the grain the join actually requires.
//
// NOT a basename. Two entry runs naming `v2_std_integer.rs` may be compiling different
// artifacts, so a pathname match is not an identity match and diagnostics keyed on
// `code @ basename : line : col` cannot be joined across entries at all.
type EmittedMemberIdentity {
  entry: Symbol
  source_module: String
  target_filename: Symbol
  member_digest: Symbol
  linkage_surface_digest: Symbol
  instrument_vintage: Symbol
  members: List<Symbol>
}

// THE JOIN KEY IS THE DOTTED AUTHORED NAME, NEVER THE TARGET FILENAME, AND THE TWO ARE CARRIED
// SEPARATELY BECAUSE THEY ARE DIFFERENT FACTS.
//
// module_to_filename is `name |> split(delimiter: ".") |> join(separator: "_")`, which is
// MANY-TO-ONE: `a.b_c` and `a_b.c` both render `a_b_c`. Joining this census on the filename would
// merge two distinct authored modules into one row, and their genuinely different surfaces would
// then be reported as one module carrying two linkage surfaces -- a false positive
// INDISTINGUISHABLE from the finding this carrier exists to report. That is worse than a miss,
// because the whole value of the refusal is that it means something specific.
//
// Measured rather than asserted: 4080 authored modules render 4080 distinct filenames today, so
// the live collision count is ZERO -- and 3456 of those names contain an underscore, so the
// collision fuel is the overwhelming majority of the corpus and today's zero is luck about segment
// placement rather than a property of the mapping. Keying on the authored name costs nothing while
// the population is clean; retrofitting an identity after a collision lands means re-auditing every
// comparison ever made.
//
// source_module is the identity the census joins and refuses on. target_filename is the locator a
// reader opens, and it is what the diagnostics point at, because a reader chasing a refusal opens a
// file. Reconstructing either from the other would be a derivation standing beside the fact it
// derives.
//
// The identity is a String rather than a Symbol because a dotted authored name has no symbol
// spelling here: the corpus carries dotted module names as String throughout and contains no dotted
// symbol literal anywhere. Spelling one would have made this the only such site in the tree, which
// is the same one-of-one that produced this module's container-arity resolve failure.

// WHY THE ROW CARRIES BOTH THE DIGEST AND THE MEMBERS, AND WHY THE EMITTER PUBLISHES ONLY THE
// LATTER.
//
// The digest is the comparison key; the members are the evidence. A digest alone is lossy in the
// one direction that matters: two differing surfaces collide to "differs" with no way back, so a
// refusal can name the MODULE and never the MEMBER. On the first live specimen the whole finding
// was WHICH member differed -- a foreign reexport of a name the module itself declares as a
// coproduct variant -- and a digest-only carrier would have reported that the module varies and
// stopped there, leaving the fabrication underneath it undiscovered.
//
// The emitter must publish the member SET rather than a digest of it for a separate reason: a
// digest published upstream would make the emitter the authority on the digest ALGORITHM, and this
// census would become a consumer that can only compare what another party already decided was
// comparable. Declaring what was decided is the emitter's job; deciding what counts as the same
// surface is this carrier's.
//
// WHICH HALF OF THE SURFACE ACTUALLY DISCRIMINATES, STATED SO IT IS NEVER CITED AS MORE.
//
// A member set has two kinds of row: the module's own DECLARATIONS and its REEXPORTS. For a
// ProviderModule the declarations come from that module's own source, which no closure touches, so
// they are ENTRY-INVARIANT BY CONSTRUCTION and cannot exhibit the variation this census exists to
// detect. Every bit of discriminating power sits in the reexports.
//
// Declarations are therefore carried as EVIDENCE AND CONTEXT, never as a second discriminator. The
// distinction is worth writing down because the opposite claim -- "declarations are compared too"
// -- would read as coverage for a class the comparison structurally cannot catch, which is the
// decoration failure: a check permanently green by construction is worse than an absent one,
// because it gets cited.
//
// Receipt from the first live measurement: the one varying provider module carried 164 declared
// items under BOTH entries and differed only in reexports, 11 against 10. The single case where
// declarations did vary was the crate root, 45 against 18 -- and there the varying fact is pub-mod
// closure membership, which the standing law permits and which the CrateRoot arm above admits.

// The OBSERVED union of exports across a sample. This is a migration candidate and nothing more.
//
// It may not inhabit a carrier named as the canonical surface: it is sample-dependent, it
// preserves accidental reexports, and it can introduce collisions between variants that were
// never compiled together. Its own fields carry the sample and vintage so that a reader cannot
// mistake it for a declaration.
type ObservedExportEnvelope {
  sample: List<Symbol>
  vintage: Symbol
  module: Symbol
  members: List<Symbol>
}

// WHY A VARIANCE VARIES, CARRIED AS A TYPED ARM WITH AN IGNORANCE MEMBER.
//
// A census that reports only THAT a module varies cannot tell anyone whether the obstruction is one
// mechanism or five, and that is the question an incremental-emit decision turns on: emission
// proportional to what changed is not well-defined while a module's bytes are a function of its
// closure rather than of itself.
//
// Unattributed is the FAIL-CLOSED DEFAULT and the only member an observation builder can author.
// Classification is a judgement made by reading two emitted trees, not a fact an observation
// carries, so a builder that guessed would be fabricating. An unclassified variance therefore
// renders as a FINDING rather than as an absence, and the carrier stays honest when the next
// variance matches none of the classified members.
type ClosureVarianceCause
  = ClosureMembership
  | EmittedPopulationManifest
  | FabricatedReexport
  | CollapsedTypeArgument
  | Unattributed

// THE FOUR CLASSIFIED MEMBERS COME FROM ONE HAND CLASSIFICATION, AND ITS SAMPLING FRAME IS STATED
// HERE BECAUSE A HAND TABLE WITHOUT ITS FRAME IS WHAT GETS QUOTED AS A CORPUS RESULT LATER.
//
// FRAME: three entries -- v2.std.node_query, v2.std.integer, v2.std.coercion -- forming a TOTAL
// CONTAINMENT CHAIN (node_query subset integer subset coercion), 46 shared modules. A chain CANNOT
// exhibit incomparable-closure effects, so any count of those from this sample is non-discriminating
// rather than zero. shared_types is closure-scoped and is not enumerated by this sample at all.
//
// WHAT IT FOUND: 4 modules varied by content, 2 by linkage surface. The 4 decompose as two
// LEGITIMATE and two DEFECTS, and the two defects share ONE ROOT with two faces.
//   lib.rs                ClosureMembership          the pub-mod list IS closure membership
//   emitted_population.rs EmittedPopulationManifest  declaring what this emit produced is its job
//   v2_std_node.rs        FabricatedReexport         a foreign Cardinality reexport synthesized
//   v2_std_collection.rs  CollapsedTypeArgument      map_get's return type erased to unit
//
// THE ROOT BOTH DEFECTS SHARE: a bare name owned by more than one declaration, resolved through a
// map folded over the TRANSITIVE closure, where the constructor-binding authority rules ownership a
// PER-FILE fact. Presence of a second claimant flips the answer. Cardinality is a type and a
// variant of Connective; Optional is a type and a variant of both Cardinality and a grammar
// expression. One face fabricates a public reexport, the other erases a type argument.
//
// THE COLLAPSE'S FIRING CONDITION AND ITS OPEN QUESTION, left checkable rather than as
// "unmeasured". The collapse fires when the SECOND claimant is ABSENT and does not fire when it is
// present. So the closure that would turn a latent fabrication into an executed one is:
//
//     contains a caller of v2.std.collection map_get
//     AND does not contain the second Optional claimant transitively
//
// Three real callers exist -- v2.lens.affected_set, v2.compiler.03_name_resolve and
// v2.std.compilers.cli_surface -- and none of the three closures in the frame above reaches any of
// them, which is why the collapsed function had ZERO callers when measured and compiled clean. In
// such a closure the outcome is a type error (loud) unless the caller's own types collapsed
// consistently, in which case it compiles and is silently wrong. That case has not been
// constructed. What the zero-caller measurement bounds is the HARM, not the defect: a fabricated
// signature is fabricated plausible output whether or not anyone calls it.

type SurfaceCensusRow {
  product: ProductKind
  cause: ClosureVarianceCause
  source_module: String
  target_filename: Symbol
  observations: List<EmittedMemberIdentity>
}

// THE CENSUS CARRIES ITS OWN SAMPLE, AND THAT IS WHAT MAKES ADMISSION HONEST.
//
// A bare list of rows cannot distinguish CENSUSED AND CLEAN from NOT CENSUSED. Both render as
// "no row varies", so an admission over rows alone answers a question it never asked -- the
// empty-observation narrow: an observation that could not express variation, reported as the
// verdict that there is none. That is worse than the widen DESIGN forbids, because a widen is
// merely expensive and a narrow is silently uncovered.
//
// Naming the sample makes two ignorance states representable and therefore refusable: a sample
// too small to exhibit variation at all, and a module the sample did not observe under every
// entry it claims to cover.
type SurfaceCensus {
  sample_entries: List<Symbol>
  rows: List<SurfaceCensusRow>
}

fn surface_digest_of(observation: EmittedMemberIdentity) -> Symbol {
  observation.linkage_surface_digest
}

fn observation_has_other_surface(a: EmittedMemberIdentity, b: EmittedMemberIdentity) -> Bool {
  surface_digest_of(observation: a) != surface_digest_of(observation: b)
}

// True when the row's observations do not all agree on one linkage surface.
//
// Asked over the row's OWN observations rather than by counting distinct digests globally: a
// module observed once trivially agrees, and a module observed N times disagrees exactly when
// some observation differs from the first.
fn row_surface_varies(row: SurfaceCensusRow) -> Bool {
  match row.observations {
    Empty => false
    Cons { head: first, tail: rest } =>
      any(xs: rest, predicate: other => observation_has_other_surface(a: first, b: other))
  }
}

// The refusal. A provider module carrying more than one linkage surface is not installable.
//
// The crate root is admitted by its own arm: its variation is closure membership, which the
// standing law permits. That is stated as a reason here, not hidden as a skip.
fn row_admissible(row: SurfaceCensusRow) -> Bool {
  match row.product {
    CrateRoot => true
    ProviderModule => row_surface_varies(row: row) == false
  }
}

// A census over fewer than two entries CANNOT exhibit an entry-conditioned surface. Admitting on
// one is not a clean result, it is the absence of a measurement wearing a verdict's clothes.
//
// This asks its question of the sample's LENGTH, which is only the number of DISTINCT entries
// once the sample is known to carry no repeat. That precondition is established by the refusal
// below rather than assumed here, and it is not an ordering nicety: a repeated entry defeats this
// check AND the coverage check together, which is exactly how it slipped through once already.
fn census_can_discriminate(census: SurfaceCensus) -> Bool {
  length(xs: census.sample_entries) >= 2
}

// A SAMPLE THAT NAMES ONE ENTRY TWICE IS MALFORMED, AND REFUSING IT IS NOT THE SAME AS DEDUPING IT.
//
// The damage a repeat does is not that it inflates a count. It is that it defeats BOTH guards at
// once, in the same direction, silently. `[A, A]` has length 2, so the sample passes for
// discriminating; and a row observed a single time under A satisfies row_observed_under_entry for
// BOTH slots, so count_where equals length and the row passes for covered. A census that observed
// exactly one entry then reaches the variation check, where a lone observation cannot disagree with
// anything, and is ADMITTED as clean. Both ignorance refusals are defeated by one duplicated
// identity.
//
// Silently deduping to `[A]` would fix the arithmetic and hide a broken producer: the observation
// builder is the only party that can author this sample, and a sample naming one entry twice means
// that builder is wrong. Tolerating its output would be the absorbing fallback with the failure
// frequency zeroed by construction. So this refuses with its own reason, pointing at the producer,
// rather than repairing the data on its behalf.
fn sample_repeats_an_entry(census: SurfaceCensus) -> Bool {
  any(xs: census.sample_entries, predicate: entry =>
    count_where(xs: census.sample_entries, predicate: other => other == entry) > 1)
}

fn row_observed_under_entry(row: SurfaceCensusRow, entry: Symbol) -> Bool {
  any(xs: row.observations, predicate: observation => observation.entry == entry)
}

// A module observed under only SOME of the sampled entries has fewer observations to disagree,
// so a MISSING observation renders as agreement. Coverage is therefore a precondition of the
// verdict rather than a quality note beside it.
fn row_covers_sample(row: SurfaceCensusRow, census: SurfaceCensus) -> Bool {
  count_where(xs: census.sample_entries, predicate: entry => row_observed_under_entry(row: row, entry: entry))
    == length(xs: census.sample_entries)
}

fn sample_repeated_entry_diagnostic(census: SurfaceCensus) -> Diagnostic {
  textual_whole_file_diagnostic(
    reason: ^surface_census_sample_names_one_entry_more_than_once,
    module_file: ^surface_census,
    correction: Unavailable { reason: ExternalContractUnknown }
  )
}

fn census_undiscriminating_diagnostic(census: SurfaceCensus) -> Diagnostic {
  textual_whole_file_diagnostic(
    reason: ^surface_census_sample_too_small_to_exhibit_variation,
    module_file: ^surface_census,
    correction: Unavailable { reason: ExternalContractUnknown }
  )
}

fn uncovered_row_diagnostic(row: SurfaceCensusRow) -> Diagnostic {
  textual_whole_file_diagnostic(
    reason: ^seed_module_not_observed_under_every_sampled_entry,
    module_file: row.target_filename,
    correction: Unavailable { reason: ExternalContractUnknown }
  )
}

fn entry_conditioned_surface_diagnostic(row: SurfaceCensusRow) -> Diagnostic {
  textual_whole_file_diagnostic(
    reason: ^seed_module_carries_more_than_one_linkage_surface,
    module_file: row.target_filename,
    correction: Unavailable { reason: ExternalContractUnknown }
  )
}

fn refused_rows(census: SurfaceCensus) -> List<SurfaceCensusRow> {
  filter(xs: census.rows, predicate: row => row_admissible(row: row) == false)
}

fn uncovered_rows(census: SurfaceCensus) -> List<SurfaceCensusRow> {
  filter(xs: census.rows, predicate: row => row_covers_sample(row: row, census: census) == false)
}

fn refused_row_count(census: SurfaceCensus) -> Int {
  count_where(xs: census.rows, predicate: row => row_admissible(row: row) == false)
}

// Canonical seed assembly admission.
//
// Fail-closed in FOUR directions, ordered so that a malformed sample is refused before ignorance,
// and ignorance before cleanliness is asserted. An admission means: the sample could have exhibited variation, every module was
// observed across the whole sample, and none offered two surfaces. It is never a claim that a
// canonical surface was chosen.
//
// The ordering is the content. Answering "no module varies" first would let both ignorance
// states pass as verdicts, which is exactly the defect this ordering exists to make
// unrepresentable.
fn canonical_seed_admission(census: SurfaceCensus) -> Outcome<SurfaceCensus> {
  if sample_repeats_an_entry(census: census) {
    outcome_rejected(d: sample_repeated_entry_diagnostic(census: census))
  } else if census_can_discriminate(census: census) == false {
    outcome_rejected(d: census_undiscriminating_diagnostic(census: census))
  } else {
    match uncovered_rows(census: census) {
      Cons { head: uncovered, tail: _ } =>
        outcome_rejected(d: uncovered_row_diagnostic(row: uncovered))
      Empty =>
        match refused_rows(census: census) {
          Empty => outcome_accepted(value: census)
          Cons { head: first, tail: _ } =>
            outcome_rejected(d: entry_conditioned_surface_diagnostic(row: first))
        }
    }
  }
}
