module v2.compiler.self_host.ancestry

import std.content_hash { Sha512Digest, content_hash_eq_sha512 }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.types { NonEmptyStr }
import v2.std.logic { Bool }
import v2.std.node { Hash, Symbol }
import v2.std.optional { Absent, Optional, Present }
import v2.std.text { String }
import v2.compiler.self_host.emitter_producer_provenance {
  EmitterProducer,
  RealizedEmitterClosure,
  V1SeedEmitter,
  V2EmitterNative,
  ProducerMintAdmitted,
  ProducerMintRefused,
  emitter_producer_mint_admission,
  seed_emit_rust_reachable
}
import v2.compiler.self_host.generation {
  ArtifactMaterialized,
  ArtifactNotMaterialized,
  GeneratedArtifactIdentity,
  GenerationIdentity,
  ObservedArtifactDigest
}

// THE SEED IS NEVER THE ORDINARY MISS PATH (operator design-review ruling 2026-09-11, C1).
//
// Before this module the native compiler had no ancestry relation at all: every
// acquisition of "the emitted compiler" ran the v1 seed in-process and emitted again, so
// the seed was not a migration step but the STANDING producer, reached on every miss. That
// shape cannot get off the seed, because nothing about it ever becomes unreachable — a
// route whose miss path is the thing being retired retires nothing, and the retirement
// keeps reporting as scheduled while the seed keeps executing. It is DESIGN section 5's
// absorbing fallback with the widened arm spelled "run v1 instead", and DESIGN section 3's
// replacement-migration doctrine names the surviving X as an attractor for exactly this
// reason.
//
// Ancestry replaces it with a relation that has precisely two constructors:
//
//   GenesisFromSeed   V1SeedEmitter        -> native generation 0      ONCE, then deleted
//   SucceedsNative    V2EmitterNative(N)   -> native generation N + 1  the only recurrence
//
// There is deliberately NO third constructor, and in particular no arm by which a missing
// or unverified ancestor resolves to the seed. Absence of an ancestor is a typed refusal
// (NativeAncestorMissing / NativeAncestorUnverified) that names the generation it expected;
// it is not a condition under which some other producer is selected. That is the
// difference between structural impossibility (DESIGN section 4b rung 4) and a policy that
// currently happens to prefer the native route: a fallback that is unwritable cannot be
// taken by a later author who finds the refusal inconvenient.
//
// The producer axis is NOT re-coined here. v2.compiler.self_host.emitter_producer_provenance
// already owns EmitterProducer, and native_generation_producer below PROJECTS this module's
// ancestry onto it rather than declaring a second producer coproduct beside it (DESIGN
// section 3). Equally, there is no used_seed Bool anywhere: a Boolean would carry the fact
// while leaving both the seed and the native route writable on either value, which is the
// carrier-without-a-wall failure emitter_producer_provenance's own note records.
type NativeAncestry
  = GenesisFromSeed { seed_binary: Sha512Digest }
  | SucceedsNative {
      parent_generation: Int
      parent_artifact: ObservedArtifactDigest
      produced_by_execution_of: ObservedArtifactDigest
    }

// A read-back is the artifact REPORTING ITS OWN IDENTITY after being built, which is what
// separates "cargo exited zero" from "the thing we built is the compiler we meant". The
// receipt therefore carries only what was OBSERVED — the digest the built artifact reported
// — and never a verdict. Divergence is derived by comparing that report against the
// generation's own observed artifact digest, so a "verified" state cannot be authored
// beside a report that contradicts it; there is exactly one representation of agreement
// (DESIGN section 2), and it is a fold, not a field.
type ReadBackReceipt
  = ReadBackUnperformed
  | ReadBackReported { reported_artifact: ObservedArtifactDigest }

// BUILD PATH IS AN INPUT THE GENERATION AXES DO NOT NAME. A Rust binary embeds its
// build directory, so identical source built in two directories yields different bytes
// while producer_compiler, source_closure, target_model, toolchain, build_configuration and
// required_lens_contract all agree (measured twice, gunbc#8181; registered as an obligation in
// gunbc.self_host_promotion_obligations artifact_axis_omits_build_path).
//
// For a one-time genesis run on one host, pinning the directory is an honest treatment:
// the axes are not a determinant, but nothing cross-host consumes the artifact either. For
// the RECURRING step the artifact is the ancestor a later generation acquires, and it is
// intended to be served across hosts, so an unresolved build path makes the ancestor's
// identity unfalsifiable exactly where it is load-bearing. Hence the asymmetry enforced by
// native_generation_mint_admission: genesis admits Pinned, the recurring step does not, and
// neither admits Unresolved.
//
// This type is the declaration the obligation's two named remedies were waiting for; it
// does NOT by itself discharge that obligation, because remapping is a property of the
// build that produces the bytes and not of a carrier describing it. The obligation stays
// unbound until the emitted-compiler build actually passes the remap and a two-directory
// control observes identical bytes — asserting otherwise here would be rung inflation
// (DESIGN section 4b meta-obligation 1).
type BuildPathTreatment
  = BuildPathRemapped { remap_prefix_from: String, remap_prefix_to: String }
  | BuildPathPinned { directory: String }
  | BuildPathUnresolved

type NativeGeneration {
  generation: Int
  ancestry: NativeAncestry
  identity: GenerationIdentity
  emitted_source: Hash
  read_back: ReadBackReceipt
  realized_closure: RealizedEmitterClosure
  build_path_treatment: BuildPathTreatment
}

// The projection onto the EXISTING producer authority. Genesis is produced by the seed;
// generation N + 1 is produced by the native compiler of generation N. V2EmitterInterpreted
// is reachable from no arm, which is the point: an interpreted emit is a development route,
// never an ancestor, and making it unprojectable is stronger than refusing it downstream.
fn native_generation_producer(g: NativeGeneration) -> EmitterProducer {
  match g.ancestry {
    GenesisFromSeed { seed_binary: _ } => V1SeedEmitter
    SucceedsNative {
      parent_generation: p,
      parent_artifact: _,
      produced_by_execution_of: _
    } =>
      V2EmitterNative { generation: p }
  }
}

data genesis_generation_number: Int = 0

// A MODULE-PATH CLOSURE CANNOT ESTABLISH NATIVENESS, AND AN EARLIER REVISION PRETENDED IT
// COULD. The native compiler IS those modules compiled, so the interpreted route and the native
// route name THE SAME MODULES: v2.compiler.self_host.candidate_generation mints
// V2EmitterInterpreted against realized_closure_for_v2_direct_rust_door_emit_run, and this
// module's own "native" fixture was byte-identical to it (review 63985). Every closure clause is
// therefore a NEGATIVE filter — it can say the seed did not participate, and it can never say
// the prior native generation did. A positive control built on closure membership alone is
// satisfiable by editing a declaration while the realization lies, which is precisely the tell
// DESIGN section 5 gives for validation standing where construction was available.
//
// So nativeness is bound to EXECUTED BYTES instead. produced_by_execution_of names the artifact
// that ran to produce this generation, and the mint requires it to be the very artifact the
// ancestry names as its parent. The interpreted route cannot honestly supply that: it has no
// ancestor binary, and any digest it offers is one the successor's own parent_artifact field
// must equal. The check is on two fields of one value, so it fires inside the mint rather than
// waiting for a join the mint cannot perform.
data ancestry_producer_execution_is_not_the_named_ancestor: String = "native generation mint refused: the artifact that executed to produce this generation is not the artifact its ancestry names as the parent — a closure naming native modules is not evidence that native bytes ran, because the interpreted route names the same modules"

data ancestry_genesis_not_generation_zero: String = "native generation mint refused: GenesisFromSeed is the migration step onto generation 0 and carries no other generation number"

// GENERATION 0 IS GENESIS-ONLY, AND ARITHMETIC ALONE DOES NOT ENFORCE IT. The successor clause
// checks generation == parent + 1, which a NEGATIVE parent satisfies at generation 0:
// SucceedsNative { parent_generation: -1 } mints generation 0 without ever passing genesis
// admission, so the one number the migration boundary is defined by becomes reachable from the
// recurring arm (review 64112). The remaining clauses do not catch it -- they ask about
// closures, build paths, read-backs and executed bytes, none of which are about WHERE IN THE
// CHAIN this generation sits.
//
// Refusing a negative parent closes it at the source rather than at the successor's own number:
// with parent >= 0 the successor is always >= 1 by construction, so generation 0 has exactly one
// constructor. Stated as its own cause because "the parent generation is not a generation" and
// "the numbering does not follow the parent" are different defects with different remedies, and
// collapsing them would report a fabricated chain position as an ordinary off-by-one.
data ancestry_successor_parent_generation_negative: String = "native generation mint refused: SucceedsNative names a negative parent generation, which is not a position in the chain — and at parent -1 the successor would number itself 0, the one generation reachable only through the genesis migration"

data ancestry_successor_not_parent_plus_one: String = "native generation mint refused: SucceedsNative(parent) must mint generation parent + 1; ancestry and generation number disagree"

data ancestry_artifact_not_materialized: String = "native generation mint refused: the materialized-artifact axis is ArtifactNotMaterialized, so no ancestor artifact exists to be acquired by a successor"

data ancestry_read_back_unperformed: String = "native generation mint refused: ReadBackUnperformed — cargo exiting zero is not the artifact reporting its own identity"

data ancestry_read_back_diverged: String = "native generation mint refused: the artifact reported an identity that is not the digest observed of the bytes that were built"

// RESTORED. These two rows were deleted by the clause move in 714b77f3 — an edit that sliced
// between two anchors and took everything between them, including these — and their absence was
// invisible for two pushes because every control asserting them stayed GREEN. That is the real
// lesson and it is recorded here rather than in a commit message: `^name` mints a Symbol from
// arbitrary text, so `cause: ^x` compares SPELLINGS, not declarations. A control asserting a
// refusal cause therefore cannot tell a declared row from a typo or from a row someone deleted,
// and the strongest-looking evidence in this module — a refusal matched by name — was the
// weakest against exactly the failure that occurred. Caught by review 64013, not by the suite.
data ancestry_build_path_unresolved: String = "native generation mint refused: BuildPathUnresolved leaves an input the six generation axes do not name, so the artifact axis cannot falsify anything"

data ancestry_successor_build_path_pinned: String = "native generation mint refused: BuildPathPinned is admissible only for the one-time genesis; a recurring generation's artifact is acquired as an ancestor and must not depend on the directory it was built in"

data ancestry_genesis_closure_omits_seed: String = "native generation mint refused: GenesisFromSeed names the seed as producer, so v1.compiler.emit_rust must be reachable in its realized closure — a genesis that did not run the seed is not a genesis"

type NativeGenerationMintAdmission
  = NativeGenerationAdmitted
  | NativeGenerationRefused { cause: Symbol }

fn read_back_agrees(
  read_back: ReadBackReceipt,
  artifact: GeneratedArtifactIdentity
) -> NativeGenerationMintAdmission {
  match read_back {
    ReadBackUnperformed =>
      NativeGenerationRefused { cause: ^ancestry_read_back_unperformed }
    ReadBackReported { reported_artifact: reported } =>
      match artifact {
        ArtifactNotMaterialized =>
          NativeGenerationRefused { cause: ^ancestry_artifact_not_materialized }
        ArtifactMaterialized { digest: observed } =>
          if content_hash_eq_sha512(
            left: reported.observed,
            right: observed.observed
          ) {
            NativeGenerationAdmitted
          } else {
            NativeGenerationRefused { cause: ^ancestry_read_back_diverged }
          }
      }
  }
}

// BUILD PATH IS ADMITTED ASYMMETRICALLY, and the asymmetry is the whole content of this fold.
// A one-time genesis runs on one host and nothing cross-host consumes its artifact, so pinning
// the directory is honest there. A RECURRING generation's artifact is acquired as an ancestor
// by a later generation, so an unremapped build path leaves an input the six generation axes do
// not name — the artifact axis stops being able to falsify anything precisely where it is load
// bearing. Unresolved is admitted for neither.
//
// This annotation previously described the native-producer CLOSURE wall, which decides nothing
// about build paths and has since moved to
// v2.compiler.self_host.emitter_producer_provenance v2_emitter_closure_admission. An annotation
// left attached to a fold it no longer describes is worse than none, because it is read as
// documentation of the code beneath it (review 64013).
// IT TAKES THE ANCESTRY, NOT A Bool, and that is this module's own rule applied to itself. An
// earlier revision's signature was (treatment, genesis: Bool), which re-expressed the
// NativeAncestry discriminant as a flag — the shape the opening note rejects for used_seed, for
// the same reason: a Boolean carries the fact while leaving BOTH arms writable on either value,
// so build_path_admission(treatment: pinned, genesis: true) against a SucceedsNative generation
// was an admissible call that silently granted the genesis-only pinned allowance. Both call
// sites happened to pass the right value, which makes it a latent hole rather than a live bug,
// and caller discipline is exactly what DESIGN section 5 says not to rely on when construction
// is available. Taking the ancestry means the discriminant is read from the value that carries
// it, one frame down from the match that already established it (review 64113).
fn build_path_admission(
  treatment: BuildPathTreatment,
  ancestry: NativeAncestry
) -> NativeGenerationMintAdmission {
  match treatment {
    BuildPathRemapped { remap_prefix_from: _, remap_prefix_to: _ } =>
      NativeGenerationAdmitted
    BuildPathPinned { directory: _ } =>
      match ancestry {
        GenesisFromSeed { seed_binary: _ } => NativeGenerationAdmitted
        SucceedsNative {
          parent_generation: _,
          parent_artifact: _,
          produced_by_execution_of: _
        } =>
          NativeGenerationRefused { cause: ^ancestry_successor_build_path_pinned }
      }
    BuildPathUnresolved =>
      NativeGenerationRefused { cause: ^ancestry_build_path_unresolved }
  }
}

// THE ONE ADMISSION FOLD. Every clause below is a total match on typed structure, and the
// order is significant only in which cause is reported first — no clause is skipped by an
// earlier one succeeding, because a refusal short-circuits to a NAMED cause rather than to
// a Bool that a later clause could re-derive differently.
fn native_generation_mint_admission(
  g: NativeGeneration
) -> NativeGenerationMintAdmission {
  match g.ancestry {
    GenesisFromSeed { seed_binary: _ } =>
      if g.generation != genesis_generation_number {
        NativeGenerationRefused { cause: ^ancestry_genesis_not_generation_zero }
      } else if !seed_emit_rust_reachable(closure: g.realized_closure) {
        NativeGenerationRefused { cause: ^ancestry_genesis_closure_omits_seed }
      } else {
        match build_path_admission(
          treatment: g.build_path_treatment,
          ancestry: g.ancestry
        ) {
          NativeGenerationRefused { cause: c } => NativeGenerationRefused { cause: c }
          NativeGenerationAdmitted =>
            read_back_agrees(
              read_back: g.read_back,
              artifact: g.identity.materialized_artifact
            )
        }
      }
    SucceedsNative {
      parent_generation: p,
      parent_artifact: parent,
      produced_by_execution_of: ran
    } =>
      if p < genesis_generation_number {
        NativeGenerationRefused {
          cause: ^ancestry_successor_parent_generation_negative
        }
      } else if g.generation != p + 1 {
        NativeGenerationRefused { cause: ^ancestry_successor_not_parent_plus_one }
      } else if !content_hash_eq_sha512(left: ran.observed, right: parent.observed) {
        NativeGenerationRefused {
          cause: ^ancestry_producer_execution_is_not_the_named_ancestor
        }
      } else {
        match emitter_producer_mint_admission(
          producer: native_generation_producer(g: g),
          closure: g.realized_closure
        ) {
          ProducerMintRefused { cause: c } => NativeGenerationRefused { cause: c }
          ProducerMintAdmitted =>
            match build_path_admission(
              treatment: g.build_path_treatment,
              ancestry: g.ancestry
            ) {
              NativeGenerationRefused { cause: c } => NativeGenerationRefused { cause: c }
              NativeGenerationAdmitted =>
                read_back_agrees(
                  read_back: g.read_back,
                  artifact: g.identity.materialized_artifact
                )
            }
        }
      }
  }
}

// GENESIS EXECUTES ONCE. Its standing is a state, not a counter: a second genesis is not
// "genesis with count 2", it is a refusal naming the genesis that already stands. The
// deletion trigger below is the condition under which the GenesisFromSeed constructor
// itself goes away, at which point this standing type collapses to a single inhabitant and
// is deleted with it.
type GenesisStanding
  = GenesisNotExecuted
  | GenesisExecuted { genesis: NativeGeneration }

data genesis_already_executed: String = "genesis refused: a native generation 0 already stands; the migration from the seed executes exactly once, and a second execution is a re-migration nobody asked for"

data genesis_candidate_is_not_a_genesis: String = "genesis refused: the candidate's ancestry is SucceedsNative, which is the recurring step and is admitted by the ordinary mint, not by the migration"

type GenesisAdmission
  = GenesisAdmitted
  | GenesisRefused { cause: Symbol }

fn admit_genesis(
  standing: GenesisStanding,
  candidate: NativeGeneration
) -> GenesisAdmission {
  match standing {
    GenesisExecuted { genesis: _ } =>
      GenesisRefused { cause: ^genesis_already_executed }
    GenesisNotExecuted =>
      match candidate.ancestry {
        SucceedsNative {
          parent_generation: _,
          parent_artifact: _,
          produced_by_execution_of: _
        } =>
          GenesisRefused { cause: ^genesis_candidate_is_not_a_genesis }
        GenesisFromSeed { seed_binary: _ } =>
          match native_generation_mint_admission(g: candidate) {
            NativeGenerationRefused { cause: c } => GenesisRefused { cause: c }
            NativeGenerationAdmitted => GenesisAdmitted
          }
      }
  }
}

// DELETION TRIGGER for the GenesisFromSeed constructor, stated at the grain of the
// CAPABILITY it restores rather than at the grain of an artifact that would contribute to
// one (DESIGN section 4b meta-obligation 3).
//
// The capability: minting an admitted NativeGeneration whose ancestry is SucceedsNative —
// that is, one execution of V2EmitterNative(N) producing generation N + 1, whose realized
// closure reaches neither v1.compiler.emit_rust nor v2.compiler.emit, whose build path is
// remapped, and whose read-back reports the digest observed of the bytes that were built —
// for the production compile entry over the head source closure. A green emit, a green
// cargo build, or a route receipt that merely records a native spawn are each strictly less
// than this and none of them retires the constructor.
//
// When that capability exists, GenesisFromSeed, GenesisStanding, admit_genesis and this row
// are deleted together, native_generation_producer loses its V1SeedEmitter arm, and
// NativeAncestry becomes a one-constructor relation — at which point "the seed produced this
// compiler" is unwritable rather than refused.
data genesis_migration_deletion_trigger: DissolutionCondition = unbound_dissolution(
  description: "delete GenesisFromSeed, GenesisStanding and admit_genesis when native_generation_mint_admission returns NativeGenerationAdmitted for a SucceedsNative generation of the production compile entry over the head source closure, EXECUTED rather than fixtured. Unbound deliberately: the condition is one execution verifying by read-back, which no declaration appearing or retiring can stand for — binding it to a decl ref would be a checkable trigger impersonating a decision, and would report fired on the day the decl was written." as NonEmptyStr
)

// ACQUISITION OF THE ONLY ADMISSIBLE PRODUCER. This is the surface the emitted-compiler
// route WILL consume in place of re-running the seed — see
// native_route_acquisition_frontier below for the consumer, the route and the trigger; as of
// this declaration the host route still calls the seed emitter, and saying otherwise here
// would be the present-tense claim DESIGN section 3c names as a tell.
//
// The shape: it asks for generation N, and the answer is either that generation or a refusal
// naming N. There is no arm carrying an alternative producer, so a caller cannot
// pattern-match its way back to the seed, and there is no Optional that a caller could treat
// as "absent, so do the other thing" — the refusal states WHICH generation was expected and
// WHY the candidate did not qualify.
// THE DECLARED FRONTIER for acquire_native_ancestor, stated here rather than in a pull
// request description, because a consumer described outside the diff is exactly the state
// DESIGN section 3c calls dangling ("consumption described in the PR body but absent from
// the diff"). As of this declaration acquire_native_ancestor's only executing consumers are
// the controls in v2.test.claim.self_host.ancestry_witness; the PRODUCTION consumer has not
// landed, and this row says so rather than letting the surrounding prose imply otherwise.
//
// CONSUMER: the emitted-compiler acquisition in the v2-native route harness — the host
// function that today answers "the emitted compiler is not present" by running the v1 seed
// in-process to emit it (prepare_emitted_compiler, whose seed call is compile_entry_emission).
//
// ROUTE AT EXECUTION: the route harness asks acquire_native_ancestor for the generation it
// expects; NativeAncestorAcquired supplies the ancestor artifact that is spawned, and
// NativeAncestorMissing / NativeAncestorUnverified become the harness's typed refusal naming
// that generation. No arm of that fold reaches an emitter, which is what removes the seed
// call rather than merely ranking it lower.
//
// TRIGGER: this frontier closes when prepare_emitted_compiler's compile_entry_emission call
// is replaced by acquire_native_ancestor, so that no v1 emitter is reachable from the route's
// acquisition path at all. That is a DIFFERENT condition from
// genesis_migration_deletion_trigger below, which retires the GenesisFromSeed CONSTRUCTOR
// once a successor generation has actually been minted — this one retires the seed CALL, and
// neither discharges the other.
data native_route_acquisition_frontier: DissolutionCondition = unbound_dissolution(
  description: "declared frontier for acquire_native_ancestor: its production consumer is the v2-native route's emitted-compiler acquisition, prepare_emitted_compiler, which today answers a missing compiler by running the v1 seed in-process through compile_entry_emission. The frontier closes when that call is replaced by acquire_native_ancestor, leaving no v1 emitter reachable from the acquisition path at all. Unbound deliberately: the condition is the REMOVAL of a call in a host realization, which is neither a declaration appearing nor one retiring." as NonEmptyStr
)

type NativeAncestorAcquisition
  = NativeAncestorAcquired { ancestor: NativeGeneration }
  | NativeAncestorMissing { expected_generation: Int }
  | NativeAncestorUnverified { expected_generation: Int, cause: Symbol }

data ancestor_generation_is_not_the_one_expected: String = "ancestor rejected: the available native generation is not the generation the successor names as its parent"

fn acquire_native_ancestor(
  expected_generation: Int,
  available: Optional<NativeGeneration>
) -> NativeAncestorAcquisition {
  match available {
    Absent => NativeAncestorMissing { expected_generation: expected_generation }
    Present { value: g } =>
      if g.generation != expected_generation {
        NativeAncestorUnverified {
          expected_generation: expected_generation,
          cause: ^ancestor_generation_is_not_the_one_expected
        }
      } else {
        match native_generation_mint_admission(g: g) {
          NativeGenerationRefused { cause: c } =>
            NativeAncestorUnverified {
              expected_generation: expected_generation,
              cause: c
            }
          NativeGenerationAdmitted => NativeAncestorAcquired { ancestor: g }
        }
      }
  }
}


data successor_ancestor_join_frontier: DissolutionCondition = unbound_dissolution(
  description: "declared frontier for successor_names_its_ancestor: its production consumer is the genesis-and-succession wiring in the v2-native route harness, which holds both the acquired ancestor and the successor being minted; the frontier closes when that wiring joins the two by artifact identity through this fold instead of trusting the generation number. Unbound deliberately: the condition is a call appearing in a host realization, which is neither a declaration appearing nor one retiring." as NonEmptyStr
)

// A TYPED VERDICT, NOT A Bool, and this module has no standing to argue otherwise. Its own
// opening note rejects a used_seed Bool on the ground that a Boolean carries the fact while
// leaving both routes writable on either value; a Bool here has the same defect one layer in.
// The caller that refuses a mint because succession does not join needs to say WHICH of four
// different things went wrong — the candidate is a genesis and has no parent at all, the
// generation numbers disagree, the ancestor was never built, or the successor names bytes the
// ancestor did not produce — and those have four different remedies. Collapsing them to false
// is the state-space conflation DESIGN section 5 names, and it would put this fold's caller in
// the position of re-deriving the cause it just discarded.
type SuccessionJoin
  = SuccessionJoined
  | SuccessionRefused { cause: Symbol }

data ancestry_succession_candidate_is_genesis: String = "succession refused: the candidate's ancestry is GenesisFromSeed, which names no parent generation — a genesis does not succeed anything, and asking whether it joins an ancestor is a category error rather than a failed join"

data ancestry_succession_parent_generation_mismatch: String = "succession refused: the successor names a parent generation number that is not the offered ancestor's own"

data ancestry_succession_ancestor_artifact_not_materialized: String = "succession refused: the offered ancestor's artifact axis is ArtifactNotMaterialized, so there are no bytes for the successor to have been produced by"

data ancestry_succession_parent_artifact_mismatch: String = "succession refused: the successor names a parent artifact digest that is not the offered ancestor's observed artifact, so 'produced by generation N' names bytes generation N did not produce"

// The successor's parent artifact must be the ancestor's OWN observed artifact, so a
// successor cannot name a generation number it never consumed. This is the identity join
// that makes "produced by generation N" falsifiable rather than declarative.
//
// IT LIVES HERE AND NOT IN THE MINT, and that placement is forced rather than stylistic.
// native_generation_mint_admission sees ONE generation, so it can read parent_artifact but
// has nothing to join it against; a mint clause asserting the parent artifact is the real
// parent's would be a refusal that cannot fire — a wall clause in appearance with the named
// state still writable, which DESIGN section 5 calls specification-without-execution. An
// earlier revision carried exactly that as an unread refusal cause and it is deleted. The
// join is decidable only where both generations are in hand, which is this fold.
fn successor_names_its_ancestor(
  successor: NativeGeneration,
  ancestor: NativeGeneration
) -> SuccessionJoin {
  match successor.ancestry {
    GenesisFromSeed { seed_binary: _ } =>
      SuccessionRefused { cause: ^ancestry_succession_candidate_is_genesis }
    SucceedsNative {
      parent_generation: p,
      parent_artifact: a,
      produced_by_execution_of: _
    } =>
      if p != ancestor.generation {
        SuccessionRefused { cause: ^ancestry_succession_parent_generation_mismatch }
      } else {
        match ancestor.identity.materialized_artifact {
          ArtifactNotMaterialized =>
            SuccessionRefused {
              cause: ^ancestry_succession_ancestor_artifact_not_materialized
            }
          ArtifactMaterialized { digest: observed } =>
            if content_hash_eq_sha512(left: a.observed, right: observed.observed) {
              SuccessionJoined
            } else {
              SuccessionRefused { cause: ^ancestry_succession_parent_artifact_mismatch }
            }
        }
      }
  }
}
