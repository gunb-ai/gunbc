data gate_a_executed_probe_entries_note: String = "Single authority for executed probe citations on Gate-A oracle rows. Each entry is enrolled on the Wet falsifier cadence via falsifier_self_host_wet_known_red_entries (expect_red quarantine, review #7199). witness_gate_a_probe_entries_enrolled_in_known_red cross-checks parity — this list is the oracle-side projection, not a fork."

data gate_a_oracle_note: String = "Gate-A construction wall (session valiant-crab-382, 2026-07-29): SelfEmitted disposition is reachable ONLY from a GateAExecutedProbeReceipt minted by gate_a_executed_probe_from_oracle_row against this registry — never from a hand-authored FrontierProbeReceipt with SelfEmitReady and ^measured_probe_self_emit_ready. The 2026-07-20 flip-wave proved authored dispositions lie: six modules were moved to SelfEmitted and reverted after curated_cargo_probe_one.sh showed 0/6 cargo-green. Each oracle row binds module_path to (a) the measured FrontierProbeReceipt and (b) an enrolled executed-probe witness citation. Dissolve-on: per-module receipts bind via frontier_probe_survey and rows graduate to ByDerivation membership in gunbc.roster_registry."

type GateAExecutedProbeReceipt {
  module_path: String
  measured_probe: FrontierProbeReceipt
  probe_entry: String
  probe_function: String
}

type GateASelfEmitOracleRow {
  module_path: String
  measured_probe: FrontierProbeReceipt
  probe_entry: String
  probe_function: String
}

fn gate_a_oracle_self_emit_ready_receipt(module_path: String) -> FrontierProbeReceipt {
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: SelfEmitReady,
    located_stage: ProbeStageEmit,
    located_reason: ^measured_probe_self_emit_ready
  }
}

fn gate_a_executed_probe_from_oracle_row(row: GateASelfEmitOracleRow) -> GateAExecutedProbeReceipt {
  GateAExecutedProbeReceipt {
    module_path: row.module_path,
    measured_probe: row.measured_probe,
    probe_entry: row.probe_entry,
    probe_function: row.probe_function
  }
}

