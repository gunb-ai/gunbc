module v2.compiler.self_host.gate_a_oracle

import v2.compiler.self_host.frontier_probe_types {
  FrontierProbeReceipt,
  FrontierProbeStage,
  ProbeStageEmit,
  SelfEmitReady
}
import v2.compiler.self_host.self_emitted_wet_known_red_entries {
  schedule_witness_entry_cited,
  self_emitted_wet_known_red_entries
}
import v2.std.algebra { any, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

data gate_a_oracle_note: String = "Gate-A construction wall (session valiant-crab-382, 2026-07-29): SelfEmitted disposition is reachable ONLY from a GateAExecutedProbeReceipt minted by gate_a_executed_probe_from_oracle_row against this registry — never from a hand-authored FrontierProbeReceipt with SelfEmitReady and ^measured_probe_self_emit_ready. The 2026-07-20 flip-wave proved authored dispositions lie: six modules were moved to SelfEmitted and reverted after curated_cargo_probe_one.sh showed 0/6 cargo-green. Each oracle row binds module_path to (a) the measured FrontierProbeReceipt and (b) a citation enrolled in self_emitted_wet_known_red_entries (single authority, consumed via wet_receipt_enrollment). Dissolve-on: per-module receipts bind via frontier_probe_survey and rows graduate to ByDerivation membership in gunbc.roster_registry."

type GateAExecutedProbeReceipt {
  module_path: String
  measured_probe: FrontierProbeReceipt
  probe_entry: String
  probe_function: String
}

type GateASelfEmitOracleRow {
  module_path: String
  measured_probe: FrontierProbeReceipt
  probe_entry: String
  probe_function: String
}

fn gate_a_oracle_self_emit_ready_receipt(module_path: String) -> FrontierProbeReceipt {
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: SelfEmitReady,
    located_stage: ProbeStageEmit,
    located_reason: ^measured_probe_self_emit_ready
  }
}

fn gate_a_executed_probe_from_oracle_row(row: GateASelfEmitOracleRow) -> GateAExecutedProbeReceipt {
  GateAExecutedProbeReceipt {
    module_path: row.module_path,
    measured_probe: row.measured_probe,
    probe_entry: row.probe_entry,
    probe_function: row.probe_function
  }
}

data gate_a_oracle_row_body_producer: GateASelfEmitOracleRow = GateASelfEmitOracleRow {
  module_path: "src/v2/compiler/03_body_producer.dag",
  measured_probe: gate_a_oracle_self_emit_ready_receipt(module_path: "src/v2/compiler/03_body_producer.dag"),
  probe_entry: "dag/test/claim/self_host_body_producer_behavioral_witness_test.dag",
  probe_function: "self_host_body_producer_behavioral_receipt_holds"
}

