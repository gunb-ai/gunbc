  module_path: "src/v2/compiler/00_compile.dag",
  measured_probe: gate_a_oracle_self_emit_ready_receipt(module_path: "src/v2/compiler/00_compile.dag"),
  probe_entry: "src/v2/test/claim/execution/does_not_exist_flip_wave_test.dag",
  probe_function: "fabricated_flip_wave_all_holds"
}

data gate_a_self_emit_oracle_rows: List<GateASelfEmitOracleRow> = [
  gate_a_oracle_row_body_producer,
  gate_a_oracle_row_03_normalize,
  gate_a_oracle_row_07_target_carriers,
  gate_a_oracle_row_discovery_enumeration,
  gate_a_oracle_row_parse_engine_hooks,
  gate_a_oracle_row_use_site_verdict
]

data gate_a_flip_wave_reverted_modules_note: String = "The six modules prematurely flipped to SelfEmitted on 2026-07-19 and reverted 2026-07-20 (honest_frontier_refresh_probe_note): 00_compile, 02_parse, 03_ingest, materialization_carriers, program_assembly, source_authority. curated_cargo_probe_one.sh measured 0/6 cargo-green and 0/6 emit-clean. These paths are the discriminating RED set — any SelfEmitted claim for them without an oracle row must refuse."

data gate_a_flip_wave_reverted_module_paths: List<String> = [
  "src/v2/compiler/00_compile.dag",
  "src/v2/compiler/02_parse.dag",
  "src/v2/compiler/03_ingest.dag",
  "src/v2/compiler/materialization_carriers.dag",
  "src/v2/compiler/program_assembly.dag",
  "src/v2/compiler/source_authority.dag"
]

data gate_a_oracle_probe_enrollment_note: String = "Construction, not a vibe check (DESIGN section 5): an oracle row's probe citation must name an entry in self_emitted_wet_known_red_entries — the single authority consumed by wet_receipt_enrollment as falsifier_self_host_wet_known_red_entries. A SelfEmitted claim whose citation is not enrolled is unbacked; gate_a_oracle_probe_is_enrolled is the discriminating check behind witness_flip_wave_dishonest_self_emit_reds."

fn gate_a_oracle_probe_is_enrolled(row: GateASelfEmitOracleRow) -> Bool {
  schedule_witness_entry_cited(
    probe_entry: row.probe_entry,
    probe_function: row.probe_function,
    entries: self_emitted_wet_known_red_entries
  )
}

fn gate_a_oracle_probe_receipt_matches(
  row: GateASelfEmitOracleRow,
  receipt: FrontierProbeReceipt
) -> Bool {
  (row.module_path == receipt.module_path)
    && (row.measured_probe.blocker_class == receipt.blocker_class)
    && (row.measured_probe.located_stage == receipt.located_stage)
    && (row.measured_probe.located_reason == receipt.located_reason)
}

fn gate_a_oracle_row_for_module(module_path: String) -> List<GateASelfEmitOracleRow> {
  fold(
    gate_a_self_emit_oracle_rows,
    init: [],
    f: fn(acc, row) {
      if row.module_path == module_path {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

fn gate_a_oracle_authorizes_self_emit(
  module_path: String,
  receipt: FrontierProbeReceipt
) -> Bool {
  any(
    xs: gate_a_oracle_row_for_module(module_path: module_path),
    predicate: fn(row) {
      gate_a_oracle_probe_receipt_matches(row: row, receipt: receipt)
        && gate_a_oracle_probe_is_enrolled(row: row)
    }
  )
}

fn gate_a_oracle_row_is_enrolled_backed(row: GateASelfEmitOracleRow) -> Bool {
  gate_a_oracle_probe_is_enrolled(row: row)
}

fn gate_a_enrollment_entry_has_oracle_row(probe_entry: String, probe_function: String) -> Bool {
  any(
    xs: gate_a_self_emit_oracle_rows,
    predicate: fn(row) {
      (row.probe_entry == probe_entry) && (row.probe_function == probe_function)
    }
  )
}

fn gate_a_oracle_rows_match_enrollment_holds() -> Bool {
  fold(
    gate_a_self_emit_oracle_rows,
    init: true,
    f: fn(ok, row) { ok && gate_a_oracle_probe_is_enrolled(row: row) }
  ) && fold(
    self_emitted_wet_known_red_entries,
    init: true,
    f: fn(ok, entry) {
      ok && gate_a_enrollment_entry_has_oracle_row(
        probe_entry: entry.entry,
        probe_function: entry.function
      )
    }
  )
}

fn gate_a_self_emit_oracle_rows_all_enrolled_holds() -> Bool {
  fold(
    gate_a_self_emit_oracle_rows,
    init: true,
    f: fn(ok, row) { ok && gate_a_oracle_row_is_enrolled_backed(row: row) }
  )
}

fn gate_a_self_emit_oracle_row_count() -> Int {
  length(xs: gate_a_self_emit_oracle_rows)
}

fn gate_a_flip_wave_module_has_oracle_row(module_path: String) -> Bool {
  length(xs: gate_a_oracle_row_for_module(module_path: module_path)) > 0
}

fn gate_a_flip_wave_reverted_modules_lack_oracle_holds() -> Bool {
  fold(
    gate_a_flip_wave_reverted_module_paths,
    init: true,
    f: fn(ok, path) { ok && !gate_a_flip_wave_module_has_oracle_row(module_path: path) }
  )
}

fn gate_a_fabricated_self_emit_ready_receipt(module_path: String) -> FrontierProbeReceipt {
  gate_a_oracle_self_emit_ready_receipt(module_path: module_path)
}
