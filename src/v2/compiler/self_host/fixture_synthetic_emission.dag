module v2.compiler.self_host.fixture_synthetic_emission



data fixture_synthetic_emission_note: String = "Parallel fixture-scoped emission authority (wise-ram-22 disposition PR1 containment): SyntheticEmittedArtifact / FixtureBehaviorReceipt carry FixtureEmissionQualification only — no constructor into ProducerEmissionReceipt or production EmissionQualification."

data fixture_synthetic_emission_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on disposition 1 (wise-ram-22 containment lane): real source-ingest qualification after infer(assemble(fixture ingest)) accepts without hand-authored DerivedGrounding. When that path greens, fixture mint on direct_rust_door_inferred_tree deletes and production ProvenancedRustArtifact subsumes the subject.")

type FixtureEmissionQualification
  = FixtureSourceProduced
  | FixtureCargoGreen
  | FixtureBehaviorallyEquivalent

type FixtureBehaviorReceipt {
  module_path: String
  emitted_source_identity: v2.std.node.Hash
  fixture_lane_tag: String
  qualifications: List<FixtureEmissionQualification>
  build_green: Bool
}

type SyntheticEmittedArtifact {
  source: extdeps.communication.medium.Medium<String>
  emitted: v2.std.node.Node
  fixture_receipt: FixtureBehaviorReceipt
}

type WrittenSyntheticEmittedArtifact {
  artifact: SyntheticEmittedArtifact
  write: v2.compiler.self_host.candidate_generation.RustWorkspaceWriteReceipt
}

data fixture_source_produced_qualifications: List<FixtureEmissionQualification> = [
  FixtureSourceProduced
]

data fixture_cargo_green_qualifications: List<FixtureEmissionQualification> = [
  FixtureSourceProduced,
  FixtureCargoGreen
]

fn fixture_emitted_source_identity_for_medium(source: extdeps.communication.medium.Medium<String>) -> v2.std.node.Hash {
  std.content_hash.content_hash_atom(value: source.carried)
}

fn fixture_emission_qualification_eq(
  left: FixtureEmissionQualification,
  right: FixtureEmissionQualification
) -> Bool {
  match left {
    FixtureSourceProduced =>
      match right {
        FixtureSourceProduced => true
        FixtureCargoGreen => false
        FixtureBehaviorallyEquivalent => false
      }
    FixtureCargoGreen =>
      match right {
        FixtureSourceProduced => false
        FixtureCargoGreen => true
        FixtureBehaviorallyEquivalent => false
      }
    FixtureBehaviorallyEquivalent =>
      match right {
        FixtureSourceProduced => false
        FixtureCargoGreen => false
        FixtureBehaviorallyEquivalent => true
      }
  }
}

fn fixture_emission_qualifications_list_contains(
  xs: List<FixtureEmissionQualification>,
  wanted: FixtureEmissionQualification
) -> Bool {
  v2.std.algebra.any(
    xs: xs,
    predicate: fn(q) {
      fixture_emission_qualification_eq(left: q, right: wanted)
    }
  )
}

fn mint_fixture_behavior_receipt(
  module_path: String,
  emitted_source: extdeps.communication.medium.Medium<String>,
  fixture_lane_tag: String
) -> FixtureBehaviorReceipt {
  FixtureBehaviorReceipt {
    module_path: module_path,
    emitted_source_identity: fixture_emitted_source_identity_for_medium(
      source: emitted_source
    ),
    fixture_lane_tag: fixture_lane_tag,
    qualifications: fixture_source_produced_qualifications,
    build_green: false
  }
}

fn fixture_behavior_receipt_admits_cargo_green_advance(
  receipt: FixtureBehaviorReceipt
) -> Bool {
  fixture_emission_qualifications_list_contains(
    xs: receipt.qualifications,
    wanted: FixtureSourceProduced
  )
    && !fixture_emission_qualifications_list_contains(
      xs: receipt.qualifications,
      wanted: FixtureCargoGreen
    )
    && !fixture_emission_qualifications_list_contains(
      xs: receipt.qualifications,
      wanted: FixtureBehaviorallyEquivalent
    )
}

fn advance_fixture_behavior_receipt_cargo_green(
  prior: FixtureBehaviorReceipt,
  cargo_green: Bool
) -> Optional<FixtureBehaviorReceipt> {
  if !cargo_green
    || !fixture_behavior_receipt_admits_cargo_green_advance(receipt: prior) {
    v2.std.optional.optional_absent()
  } else {
    v2.std.optional.optional_present(
      value: FixtureBehaviorReceipt {
        module_path: prior.module_path,
        emitted_source_identity: prior.emitted_source_identity,
        fixture_lane_tag: prior.fixture_lane_tag,
        qualifications: fixture_cargo_green_qualifications,
        build_green: true
      }
    )
  }
}

fn mint_synthetic_emitted_artifact_from_fixture_inferred(
  inferred: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel,
  module_path: String,
  fixture_lane_tag: String
) -> v2.std.diagnostic.Outcome<SyntheticEmittedArtifact> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.self_host.candidate_generation.generate_rust_emission_candidate(inferred: inferred, target: target),
    f: fn(candidate) {
      v2.std.diagnostic.outcome_accepted(
        value: SyntheticEmittedArtifact {
          source: candidate.source,
          emitted: candidate.emitted,
          fixture_receipt: mint_fixture_behavior_receipt(
            module_path: module_path,
            emitted_source: candidate.source,
            fixture_lane_tag: fixture_lane_tag
          )
        }
      )
    }
  )
}

fn mint_written_synthetic_emitted_artifact_from_fixture_inferred(
  inferred: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel,
  module_path: String,
  workspace_dir: String,
  fixture_lane_tag: String
) -> v2.std.diagnostic.Outcome<WrittenSyntheticEmittedArtifact> {
  v2.std.diagnostic.bind_outcome(
    o: mint_synthetic_emitted_artifact_from_fixture_inferred(
      inferred: inferred,
      target: target,
      module_path: module_path,
      fixture_lane_tag: fixture_lane_tag
    ),
    f: fn(artifact) {
      v2.std.diagnostic.outcome_accepted(
        value: WrittenSyntheticEmittedArtifact {
          artifact: artifact,
          write: v2.compiler.self_host.candidate_generation.write_rust_workspace(
            workspace_dir: workspace_dir,
            source: artifact.source
          )
        }
      )
    }
  )
}

fn advance_written_synthetic_emitted_artifact_cargo_green(
  written: WrittenSyntheticEmittedArtifact,
  cargo_green: Bool
) -> Optional<WrittenSyntheticEmittedArtifact> {
  match advance_fixture_behavior_receipt_cargo_green(
    prior: written.artifact.fixture_receipt,
    cargo_green: cargo_green
  ) {
    v2.std.optional.Present { value: receipt } =>
      v2.std.optional.optional_present(
        value: WrittenSyntheticEmittedArtifact {
          artifact: SyntheticEmittedArtifact {
            source: written.artifact.source,
            emitted: written.artifact.emitted,
            fixture_receipt: receipt
          },
          write: written.write
        }
      )
    v2.std.optional.Absent => v2.std.optional.optional_absent()
  }
}

fn written_synthetic_emitted_artifact_ok(
  written: WrittenSyntheticEmittedArtifact
) -> Bool {
  written.write.manifest_write_ok && written.write.main_write_ok
}

fn written_synthetic_emitted_artifact_has_fixture_cargo_green_qualification(
  written: WrittenSyntheticEmittedArtifact
) -> Bool {
  fixture_emission_qualifications_list_contains(
    xs: written.artifact.fixture_receipt.qualifications,
    wanted: FixtureCargoGreen
  )
}

fn written_synthetic_emitted_artifact_has_fixture_behaviorally_equivalent_qualification(
  written: WrittenSyntheticEmittedArtifact
) -> Bool {
  fixture_emission_qualifications_list_contains(
    xs: written.artifact.fixture_receipt.qualifications,
    wanted: FixtureBehaviorallyEquivalent
  )
}

fn synthetic_emitted_artifact_has_fixture_source_produced_only(
  artifact: SyntheticEmittedArtifact
) -> Bool {
  fixture_emission_qualifications_list_contains(
    xs: artifact.fixture_receipt.qualifications,
    wanted: FixtureSourceProduced
  )
    && !fixture_emission_qualifications_list_contains(
      xs: artifact.fixture_receipt.qualifications,
      wanted: FixtureCargoGreen
    )
    && !fixture_emission_qualifications_list_contains(
      xs: artifact.fixture_receipt.qualifications,
      wanted: FixtureBehaviorallyEquivalent
    )
}
