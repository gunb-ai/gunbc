module v2.compiler.self_host.compiler_closure_emit

import v2.compiler.infer { infer }
import v2.compiler.name_resolve { Admission }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.program_partition { emit_for_target }
import v2.compiler.source_authority { SourceRootIngest }
import extdeps.communication.medium { Medium }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.lens.affected_set { AffectedSetClosureAcc, affected_set_closure }
import v2.std.algebra { contains, length }
import v2.std.collection { List }
import v2.std.dependency {
  DependencyView,
  dependency_lens,
  ready_set,
  topological_layers
}
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.compilers.target_model { TargetModel }
import v2.std.node { Node }
import v2.std.program_segment {
  partition_boundary_fail_closed,
  program_segment_whole_program
}

type CompilerClosureEmitReceipt {
  closure_size: Int
  layer_count: Int
  ready_size: Int
  source: Medium<String>
}

fn compiler_import_closure_reading(root: Node) -> List<DependencyView> {
  dependency_lens(root: root)
}

fn compiler_import_closure(root: Node) -> AffectedSetClosureAcc {
  affected_set_closure(
    dependencies: compiler_import_closure_reading(root: root),
    edit_locus: root
  )
}

fn compiler_closure_layer_count(root: Node) -> Int {
  length(xs: topological_layers(graph_node: root))
}

fn compiler_closure_ready_count(root: Node) -> Int {
  length(xs: ready_set(graph_node: root))
}

fn compiler_closure_frontier_count(closure: AffectedSetClosureAcc) -> Int {
  length(xs: closure.frontier)
}

fn compiler_closure_frontier_subset_of_ready(root: Node, closure: AffectedSetClosureAcc) -> Bool {
  let ready = ready_set(graph_node: root)
  fold(closure.frontier, init: true, f: fn(ok, node) {
    ok && contains(xs: ready, item: node, eq: fn(left, right) { left == right })
  })
}

fn compiler_import_closure_is_acyclic(root: Node, closure: AffectedSetClosureAcc) -> Bool {
  (compiler_closure_layer_count(root: root) > 0)
    && (compiler_closure_frontier_count(closure: closure) > 0)
    && (compiler_closure_frontier_count(closure: closure) <= compiler_closure_ready_count(root: root))
    && compiler_closure_frontier_subset_of_ready(root: root, closure: closure)
}

fn compiler_closure_cyclic_diagnostic(root: Node) -> Diagnostic {
  Diagnostic {
    reason: ^compiler_import_closure_cyclic,
    at: node_locus(node: root),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_compiler_import_closure_from_ingest(
  ingest: SourceRootIngest,
  admission: Admission,
  target: TargetModel
) -> Outcome<CompilerClosureEmitReceipt> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm),
    f: fn(resolved) {
      bind_outcome(
        o: infer(tree: resolved),
        f: fn(inferred) {
          let closure = compiler_import_closure(root: inferred.root)
          if compiler_import_closure_is_acyclic(root: inferred.root, closure: closure) {
            bind_outcome(
              o: emit_for_target(
                program: inferred,
                segment: program_segment_whole_program(),
                target: target,
                boundary: partition_boundary_fail_closed()
              ),
              f: fn(source) {
                outcome_accepted(
                  value: CompilerClosureEmitReceipt {
                    closure_size: compiler_closure_frontier_count(closure: closure),
                    layer_count: compiler_closure_layer_count(root: inferred.root),
                    ready_size: compiler_closure_ready_count(root: inferred.root),
                    source: source
                  }
                )
              }
            )
          } else {
            outcome_rejected(d: compiler_closure_cyclic_diagnostic(root: inferred.root))
          }
        }
      )
    }
  )
}
