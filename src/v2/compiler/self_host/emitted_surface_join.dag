module v2.compiler.self_host.emitted_surface_join

import gunbc.stage0_emitted_export_surface_observation {
  EmittedModuleExportSurface,
  ExportSurfaceObservation,
  ExportSurfaceObserved,
  ExportSurfaceUnobserved
}
import v2.compiler.self_host.emitted_surface_census {
  EmittedMemberIdentity,
  ProductKind,
  CrateRoot,
  ProviderModule,
  ClosureVarianceCause,
  Unattributed,
  SurfaceCensus,
  SurfaceCensusRow
}
import std.content_hash { Fnv1a64Structural, content_hash_atom }
import std.algebra { Cons, Empty }
import v2.std.algebra {
  HeadAbsent,
  HeadFound,
  contains,
  filter,
  fold_list,
  is_empty,
  list_head,
  list_map,
  list_snoc_item
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// THE JOIN IS A SEPARATE MODULE FROM THE CENSUS ON PURPOSE.
//
// The census JUDGES a SurfaceCensus and knows nothing about where one came from. This module BUILDS
// one from a particular source -- the emitter's own export-surface manifest, read through
// `gunbc.stage0_emitted_export_surface_observation`. Fusing them would make the judgement a fact
// about one artifact format, so a second observation source could only be added by editing the
// comparator (DESIGN section 3: the dispatch that selects a realization is itself realization, and
// sits peripheral to the interface it serves).
//
// IT IS ALSO WHERE THE CENSUS'S THREE MISSING FACTS ARE SUPPLIED, AND THE ARTIFACT CANNOT SUPPLY
// THEM. A manifest is ONE emission: it does not know which entry requested it, which binary wrote
// it, or what any other emission produced. Entry and vintage are therefore properties of the
// READING context, and cause is a property of a COMPARISON -- a single observation has no second
// tree to disagree with, so any cause it carried would be fabricated. This module knows the entry
// because it was told, knows the vintage because one binary produced every observation in the
// frame, and attributes nothing.

// One entry's reading of one emitted manifest, with the entry it was taken under.
//
// The entry is carried BESIDE the observation rather than inside it because the artifact has no
// field for it and inventing one would put a reading-context fact inside a producer's carrier.
type EntryObservation {
  entry: String
  observation: ExportSurfaceObservation
}

// Expected membership is a separate fact from observation. The manifest reader reports what was
// emitted; it has neither the authority nor the information to assert what should have been
// emitted. Keeping the carriers separate also makes a missing expectation nameable rather than
// letting absence default to an empty roster.
type EntryExpectedMembership {
  entry: String
  source_modules: List<String>
}

// AN UNOBSERVED ARM REFUSES THE WHOLE BUILD; IT DOES NOT CONTRIBUTE ZERO ROWS.
//
// This is the empty-observation narrow at the exact seam where it would do the most damage. An
// entry whose manifest could not be read contributes no observations, so every module it should
// have covered is observed under FEWER entries -- and a module with fewer observations has fewer
// ways to disagree, so the missing read renders as AGREEMENT. The census's own coverage check
// cannot save it either, because that check compares against the sample it was given and a build
// that dropped an entry would simply hand it a smaller sample that is internally consistent.
type CensusBuild
  = CensusBuilt { census: SurfaceCensus }
  | CensusNotBuilt { detail: String }
  | CensusExpectationMissing { entry: String }
  | CensusExpectedModuleUnobserved { entry: String, source_module: String }

data surface_member_separator: String = " "

// The linkage surface as a comparable identity.
//
// Members are joined and hashed rather than compared as lists because the census compares digests,
// and a digest is what a producer can carry across a boundary. The separator is a space, which is
// the same separator the manifest itself uses between members, so a member containing one would
// already have broken the artifact's own grammar upstream of here.
fn surface_digest_of_members(members: List<String>) -> Fnv1a64Structural {
  content_hash_atom(value: concat("surface:", join(xs: members, separator: surface_member_separator)))
}

fn surfaces_for_module(modules: List<EmittedModuleExportSurface>, source_module: String) -> List<EmittedModuleExportSurface> {
  filter(xs: modules, predicate: surface => surface.source_module == source_module)
}

fn observed_modules(entry_observation: EntryObservation) -> List<EmittedModuleExportSurface> {
  match entry_observation.observation {
    ExportSurfaceObserved { modules: modules } => modules
    ExportSurfaceUnobserved { detail: _ } => []
  }
}

fn unreadable_entries(observations: List<EntryObservation>) -> List<EntryObservation> {
  filter(xs: observations, predicate: eo => match eo.observation {
    ExportSurfaceObserved { modules: _ } => false
    ExportSurfaceUnobserved { detail: _ } => true
  })
}

// EVERY ROW THIS BUILDER PRODUCES IS A ProviderModule, AND THAT IS A FACT ABOUT THE ARTIFACT.
//
// The manifest carries rows for AUTHORED .dag modules only: lib.rs, main.rs, v1_rt.rs and the
// emitter-synthesized closure stubs have no row at all. The crate root is therefore not something
// this source can describe, so this builder never mints CrateRoot.
//
// THAT IS NOT AN ARGUMENT FOR DELETING THE CrateRoot ARM, and the distinction is the one DESIGN
// draws between reachability and occupancy. The arm's mechanism exists, and it is reachable from
// the CENSUS's denominator -- a fixture authors one today, and a second observation source that did
// describe the crate root would produce one. It is unreachable only from THIS producer's fold.
// An arm's reachability is a property of the denominator of the operation that returns it, not of
// what one upstream source happens to observe.
fn product_kind_for_manifest_row() -> ProductKind {
  ProviderModule
}

// TYPED EMPTIES. A bare `[]` in a fold's `empty:` position carries no element type, and the
// compiler refuses it rather than guessing -- the empty list is the one literal whose type its own
// contents can never supply. A function's declared return type is the cheapest place to say it once.
fn no_source_modules() -> List<String> {
  []
}

fn no_member_identities() -> List<EmittedMemberIdentity> {
  []
}

fn no_members() -> List<String> {
  []
}

fn expectations_for_entry(expectations: List<EntryExpectedMembership>, entry: String) -> List<EntryExpectedMembership> {
  filter(xs: expectations, predicate: expectation => expectation.entry == entry)
}

fn expected_modules_under_entry(expectations: List<EntryExpectedMembership>, entry: String) -> List<String> {
  match list_head(xs: expectations_for_entry(expectations: expectations, entry: entry)) {
    HeadFound { value: expectation } => expectation.source_modules
    HeadAbsent => no_source_modules()
  }
}

fn entries_missing_expectation(observations: List<EntryObservation>, expectations: List<EntryExpectedMembership>) -> List<EntryObservation> {
  filter(
    xs: observations,
    predicate: eo => is_empty(xs: expectations_for_entry(expectations: expectations, entry: eo.entry))
  )
}

// One entry's observation of one module, or nothing when that entry did not emit the module.
//
// ABSENCE HERE IS CORRECT AND IS NOT AN IGNORANCE STATE. A module genuinely outside an entry's
// closure was not emitted by it, so there is no observation to make -- which is exactly what the
// census's coverage check is for: it refuses a module the sample did not observe under every entry
// rather than letting the missing observation read as agreement. The ignorance state -- an entry
// whose manifest could not be READ -- is refused earlier, before any row is built.
// Presence and both surfaces arrive in one producer-minted envelope. This module deliberately does
// not recover the population by folding projection rows: the reader has already preserved the exact
// per-module record the emitter produced, including an ordinary empty linkage list.
fn module_surfaces_under_entry(eo: EntryObservation, source_module: String) -> List<EmittedModuleExportSurface> {
  surfaces_for_module(modules: observed_modules(entry_observation: eo), source_module: source_module)
}

fn module_present_under_entry(eo: EntryObservation, source_module: String) -> Bool {
  is_empty(xs: module_surfaces_under_entry(eo: eo, source_module: source_module)) == false
}

fn reexport_members_under_entry(eo: EntryObservation, source_module: String) -> List<String> {
  match list_head(xs: module_surfaces_under_entry(eo: eo, source_module: source_module)) {
    HeadFound { value: surface } => surface.reexports
    HeadAbsent => no_members()
  }
}

fn target_filename_under_entry(eo: EntryObservation, source_module: String) -> String {
  match list_head(xs: module_surfaces_under_entry(eo: eo, source_module: source_module)) {
    HeadFound { value: surface } => surface.target_filename
    HeadAbsent => ""
  }
}

fn observations_of_module(observations: List<EntryObservation>, source_module: String, vintage: String) -> List<EmittedMemberIdentity> {
  fold_list(
    xs: observations,
    empty: no_member_identities(),
    cons: fn(acc, eo) {
      if module_present_under_entry(eo: eo, source_module: source_module) {
        list_snoc_item(
          xs: acc,
          item: EmittedMemberIdentity {
            entry: eo.entry,
            source_module: source_module,
            target_filename: target_filename_under_entry(eo: eo, source_module: source_module),
            member_digest: surface_digest_of_members(members: declared_members_for(observations: observations, entry: eo.entry, source_module: source_module)),
            linkage_surface_digest: surface_digest_of_members(members: reexport_members_under_entry(eo: eo, source_module: source_module)),
            instrument_vintage: vintage,
            members: reexport_members_under_entry(eo: eo, source_module: source_module)
          }
        )
      } else {
        acc
      }
    }
  )
}

fn declared_members_for(observations: List<EntryObservation>, entry: String, source_module: String) -> List<String> {
  fold_list(
    xs: filter(xs: observations, predicate: eo => eo.entry == entry),
    empty: no_members(),
    cons: fn(acc, eo) {
      match list_head(xs: module_surfaces_under_entry(eo: eo, source_module: source_module)) {
        HeadFound { value: surface } => surface.declarations
        HeadAbsent => acc
      }
    }
  )
}

fn census_row_for_module(observations: List<EntryObservation>, source_module: String, vintage: String) -> SurfaceCensusRow {
  SurfaceCensusRow {
    product: product_kind_for_manifest_row(),
    cause: Unattributed,
    source_module: source_module,
    target_filename: target_filename_for(observations: observations, source_module: source_module),
    observations: observations_of_module(observations: observations, source_module: source_module, vintage: vintage)
  }
}

fn target_filename_for(observations: List<EntryObservation>, source_module: String) -> String {
  fold_list(
    xs: observations,
    empty: "",
    cons: fn(acc, eo) {
      match list_head(xs: module_surfaces_under_entry(eo: eo, source_module: source_module)) {
        HeadFound { value: surface } => surface.target_filename
        HeadAbsent => acc
      }
    }
  )
}

// THE COMPARATIVE POPULATION COMES ONLY FROM EXPECTATION, NEVER FROM OBSERVATION.
//
// A module emitted under one entry and not another is not a defect. Entries have different closures,
// so most modules are genuinely absent from most entries -- measured on the declared frame, 37
// modules appear across the two entries and only 8 appear under both. Those 29 are not evidence of
// anything: there is no second surface to compare a lone observation against.
//
// Building a row for all 37 and letting the coverage refusal reject the 29 made the census answer a
// question nobody asked. Every build refused on unequal closure MEMBERSHIP before it ever reached
// the linkage-surface comparison, so the live std.algebra specimen -- which IS shared, and which the
// host path reports -- was unreachable through this path. The carrier refused for a true reason and
// the wrong one, which is worse than refusing for no reason, because the refusal looks like the
// finding.
//
// An independently supplied roster settles which modules are comparable. A module expected under
// every entry remains in the denominator even when one observation loses it; that mismatch refuses
// before the census is built. A module expected under only one entry remains legitimately outside
// the comparison. Observed membership therefore cannot make this census greener by shrinking its
// own denominator.
//
// THE COVERAGE REFUSAL DOWNSTREAM IS KEPT AND IS NOT NOW A DECORATION. It no longer fires on
// ordinary closure asymmetry, but its RED is still authorable where regression probes live: a
// fixture can hand the census a row observed under fewer entries than the sample names, and that
// is a producer defect this build could reintroduce. It guards the builder, not the corpus.
//
// AND IT IS NOT THE IGNORANCE ARM. A manifest that could not be READ is ExportSurfaceUnobserved and
// refuses the whole build above, before any module is considered. Absent-from-a-closure and
// could-not-be-observed stay separate states with separate arms, which is the distinction this
// module exists to preserve.
fn distinct_expected_source_modules(expectations: List<EntryExpectedMembership>) -> List<String> {
  fold_list(
    xs: expectations,
    empty: no_source_modules(),
    cons: fn(acc, expectation) {
      fold_list(
        xs: expectation.source_modules,
        empty: acc,
        cons: fn(inner, source_module) {
          if contains(xs: inner, item: source_module, eq: fn(a, b) { a == b }) {
            inner
          } else {
            list_snoc_item(xs: inner, item: source_module)
          }
        }
      )
    }
  )
}

fn module_expected_under_every_entry(observations: List<EntryObservation>, expectations: List<EntryExpectedMembership>, source_module: String) -> Bool {
  length(
    xs: filter(
      xs: observations,
      predicate: eo => contains(
        xs: expected_modules_under_entry(expectations: expectations, entry: eo.entry),
        item: source_module,
        eq: fn(a, b) { a == b }
      )
    )
  ) == length(xs: observations)
}

fn shared_source_modules(observations: List<EntryObservation>, expectations: List<EntryExpectedMembership>) -> List<String> {
  filter(
    xs: distinct_expected_source_modules(expectations: expectations),
    predicate: source_module => module_expected_under_every_entry(
      observations: observations,
      expectations: expectations,
      source_module: source_module
    )
  )
}

type MissingExpectedObservation {
  entry: String
  source_module: String
}

fn no_missing_expected_observations() -> List<MissingExpectedObservation> {
  []
}

fn expected_but_unobserved(observations: List<EntryObservation>, expectations: List<EntryExpectedMembership>) -> List<MissingExpectedObservation> {
  fold_list(
    xs: observations,
    empty: no_missing_expected_observations(),
    cons: fn(acc, eo) {
      fold_list(
        xs: expected_modules_under_entry(expectations: expectations, entry: eo.entry),
        empty: acc,
        cons: fn(inner, source_module) {
          if module_present_under_entry(eo: eo, source_module: source_module) {
            inner
          } else {
            list_snoc_item(
              xs: inner,
              item: MissingExpectedObservation { entry: eo.entry, source_module: source_module }
            )
          }
        }
      )
    }
  )
}

// THE BUILD. An unreadable entry, a missing expectation, or expected-but-unobserved membership
// refuses before any row exists. No observed membership fact can narrow the expected denominator.
//
// INSTRUMENT ONLY; THIS MUST NOT BE CITED AS PRODUCTION COVERAGE. Fixtures may author expectation
// facts and therefore exercise every arm, but no live independent supplier is bound here. The class
// climbs only when every sampled entry has an independently produced expected emitted-membership
// roster whose deciding stage is execution-proven and whose interpreter parse-per-member cost is
// bounded for the census frame.
fn census_from_entry_observations(observations: List<EntryObservation>, expectations: List<EntryExpectedMembership>, vintage: String) -> CensusBuild {
  match unreadable_entries(observations: observations) {
    Cons { head: bad, tail: _ } =>
      CensusNotBuilt {
        detail: concat("an entry's export-surface manifest could not be read, so its modules would be observed under fewer entries and the missing read would render as agreement: ", bad.entry)
      }
    Empty => match entries_missing_expectation(observations: observations, expectations: expectations) {
      Cons { head: missing, tail: _ } => CensusExpectationMissing { entry: missing.entry }
      Empty => match expected_but_unobserved(observations: observations, expectations: expectations) {
        Cons { head: missing, tail: _ } => CensusExpectedModuleUnobserved {
          entry: missing.entry,
          source_module: missing.source_module
        }
        Empty => CensusBuilt {
          census: SurfaceCensus {
            sample_entries: list_map(xs: observations, f: fn(eo) { eo.entry }),
            rows: list_map(
              xs: shared_source_modules(observations: observations, expectations: expectations),
              f: fn(source_module) { census_row_for_module(observations: observations, source_module: source_module, vintage: vintage) }
            )
          }
        }
      }
    }
  }
}
