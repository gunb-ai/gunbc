module v2.compiler.self_host.frontier_band_a_emit_readiness

import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

type BandAWave1EmitReadiness
  = FlippableNow
  | BodyProducerGated
  | OtherGate { migration_trigger: Symbol }

type BandAEmitReadinessRow {
  module_path: String
  gate: BandAWave1EmitReadiness
}

data compiler_frontier_band_a_emit_readiness_note: String = "Band A Wave-1-pre-flip recon: FlippableNow = no dependency on Wave 1 gates 1-3 (general body producer ingest, namespace SymbolIndex, FLAG D). Program policy sequences Band A after Wave 1 gate 4 (weak self-host behavioral receipt). BodyProducerGated count must remain 0 on this roster. OtherGate cites the matching compiler_frontier_row_* migration_trigger. Gate-4 follow-up (swift-lynx-212): pure-decl modules are NOT flippable before gate 4 — Rust Track A6 data_decl emit is absent (rust.dag has no data_decl rows; parse_engine_hooks is 100% data Symbol=^atom), frontier_probe_emit_from_ingest is unstaged (#6464), and no per-module SeedRetained->SelfEmitted receipt path exists today. TWO OF THOSE THREE BLOCKERS ARE STALE as of 2026-08-12, verified by resolving each symbol rather than by re-reading this note: v2.compiler.self_host.candidate_generation observe_provenanced_rust_emission_from_ingest exists and drives ingest through assemble, infer, rust emission candidate and artifact mint, so the emit-from-ingest probe is staged; and v2.compiler.self_host.emitter_producer_provenance mint_producer_emission_receipt together with v2.compiler.self_host.frontier mint_emitter_produced_frontier_promotion are the per-module receipt-to-promotion path this note says does not exist. The FIRST blocker still holds and was re-verified the same way: v2.extdeps.languages.rust rust_semantic_decl_surface_projection carries record and coproduct layouts only, with no value-declaration surface, so a module that is entirely `data <name>: Symbol = ^atom` has nothing to emit through. STAGE CORRECTION (2026-08-12, SH-A control): that surviving blocker is REAL but LATENT, and the sentence this replaces — that readiness turns on that one capability — was wrong. A module-level data declaration never reaches emission. SH-A measured it with a control holding wiring, artifact, compilation unit, module name and admission identical and varying only the declaration inside the module: a fn declaration reaches EmissionRejected with infer_grounding_not_derived, while a data declaration stops at ASSEMBLY with parse_grammar_choice_overlap_residue. The refusal fires two stages before the missing renderer would run, so building value-declaration emission now would produce a renderer that cannot execute once.\n\nThe binding constraint is therefore the grammar refusal, and it is already owned: v2.workflow.compile_door_ledger known_frontier_causes carries parse_grammar_choice_overlap_residue as MigrationOwned, dissolving by construction at phase-3 import-grammar deletion in the namespace-only resolution lane. Opening a second lane against it forks scheduled work. The row above already said this — its located_stage is ProbeStageAssemble and its located_reason is that cause — which is the point worth keeping: the stage was recorded correctly and was read past, so a reader who takes the missing-capability sentence as the schedule will price and sequence the wrong work. Wave 2 use_site_verdict pilot follow-up: wrap_decision_gate landed (#6776) and 06_translate routes through it (#6775); UseSiteVerdict enrolled in rust_sg_rc_use_site_ownership_catalog (owned-at-all-sites). Remaining FlippableNow rows (parse_engine_hooks, discovery_enumeration) still gated on rustc-green behavioral receipts and Track B body emit — not the ownership gate alone."

data compiler_frontier_band_a_row_parse_engine_hooks: BandAEmitReadinessRow = BandAEmitReadinessRow {
  module_path: "src/v2/compiler/parse_engine_hooks.dag",
  gate: FlippableNow
}

data compiler_frontier_band_a_row_use_site_verdict: BandAEmitReadinessRow = BandAEmitReadinessRow {
  module_path: "src/v2/compiler/use_site_verdict.dag",
  gate: FlippableNow
}

data compiler_frontier_band_a_row_discovery_enumeration: BandAEmitReadinessRow = BandAEmitReadinessRow {
  module_path: "src/v2/compiler/discovery_enumeration.dag",
  gate: FlippableNow
}

data compiler_frontier_band_a_row_self_host: BandAEmitReadinessRow = BandAEmitReadinessRow {
  module_path: "src/v2/compiler/self_host.dag",
  gate: OtherGate { migration_trigger: ^migrate_when_frontier_harness_repurposed }
}

data compiler_frontier_band_a_row_materialization_carriers: BandAEmitReadinessRow = BandAEmitReadinessRow {
  module_path: "src/v2/compiler/materialization_carriers.dag",
  gate: OtherGate { migration_trigger: ^migrate_when_closure_self_emits_cargo_green }
}

data compiler_frontier_band_a_row_07_target_carriers: BandAEmitReadinessRow = BandAEmitReadinessRow {
  module_path: "src/v2/compiler/07_target_carriers.dag",
  gate: FlippableNow
}

data compiler_frontier_band_a_emit_readiness_roster: List<BandAEmitReadinessRow> = [
  compiler_frontier_band_a_row_parse_engine_hooks,
  compiler_frontier_band_a_row_use_site_verdict,
  compiler_frontier_band_a_row_discovery_enumeration,
  compiler_frontier_band_a_row_self_host,
  compiler_frontier_band_a_row_materialization_carriers,
  compiler_frontier_band_a_row_07_target_carriers
]

fn compiler_frontier_band_a_body_producer_gated_count() -> Int {
  fold_list(
    xs: compiler_frontier_band_a_emit_readiness_roster,
    empty: 0,
    cons: fn(count, row) {
      match row.gate {
        BodyProducerGated => count + 1
        _ => count
      }
    }
  )
}

fn compiler_frontier_band_a_flippable_now_count() -> Int {
  fold_list(
    xs: compiler_frontier_band_a_emit_readiness_roster,
    empty: 0,
    cons: fn(count, row) {
      match row.gate {
        FlippableNow => count + 1
        _ => count
      }
    }
  )
}

fn compiler_frontier_band_a_other_gate_count() -> Int {
  fold_list(
    xs: compiler_frontier_band_a_emit_readiness_roster,
    empty: 0,
    cons: fn(count, row) {
      match row.gate {
        OtherGate { migration_trigger: _ } => count + 1
        _ => count
      }
    }
  )
}

fn compiler_frontier_band_a_emit_readiness_core_holds() -> Bool {
  let gate_total = compiler_frontier_band_a_flippable_now_count() + compiler_frontier_band_a_other_gate_count() + compiler_frontier_band_a_body_producer_gated_count()
  compiler_frontier_band_a_paths_unique_holds()
    && (compiler_frontier_band_a_body_producer_gated_count() == 0)
    && (compiler_frontier_band_a_flippable_now_count() == 4)
    && (compiler_frontier_band_a_other_gate_count() == 2)
    && (gate_total == length(xs: compiler_frontier_band_a_emit_readiness_roster))
}

fn count_band_a_emit_readiness_rows_with_path(
  xs: List<BandAEmitReadinessRow>,
  target: String
) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      if row.module_path == target { count + 1 } else { count }
    }
  )
}

fn compiler_frontier_band_a_paths_unique_holds() -> Bool {
  count_band_a_emit_readiness_rows_with_path(
    xs: compiler_frontier_band_a_emit_readiness_roster,
    target: "src/v2/compiler/parse_engine_hooks.dag"
  ) == 1
    && count_band_a_emit_readiness_rows_with_path(
      xs: compiler_frontier_band_a_emit_readiness_roster,
      target: "src/v2/compiler/use_site_verdict.dag"
    ) == 1
    && count_band_a_emit_readiness_rows_with_path(
      xs: compiler_frontier_band_a_emit_readiness_roster,
      target: "src/v2/compiler/discovery_enumeration.dag"
    ) == 1
    && count_band_a_emit_readiness_rows_with_path(
      xs: compiler_frontier_band_a_emit_readiness_roster,
      target: "src/v2/compiler/self_host.dag"
    ) == 1
    && count_band_a_emit_readiness_rows_with_path(
      xs: compiler_frontier_band_a_emit_readiness_roster,
      target: "src/v2/compiler/materialization_carriers.dag"
    ) == 1
    && count_band_a_emit_readiness_rows_with_path(
      xs: compiler_frontier_band_a_emit_readiness_roster,
      target: "src/v2/compiler/07_target_carriers.dag"
    ) == 1
}
