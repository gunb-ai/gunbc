data emit_coverage_frontier_family_count_expected: Int = 15

fn coverage_row_is_native(row: EmitCoverageFrontierRow) -> Bool {
  match row.disposition {
    SelfEmittedNative { backing_entry: _, backing_function: _ } => true
    InterpreterRetained { reason: _, dissolve_on: _ } => false
  }
}

fn self_emitted_native_rows() -> List<EmitCoverageFrontierRow> {
  fold(
    emit_coverage_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if coverage_row_is_native(row: row) {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

fn interpreter_retained_rows() -> List<EmitCoverageFrontierRow> {
  fold(
    emit_coverage_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if coverage_row_is_native(row: row) {
        acc
      } else {
        concat(acc, [row])
      }
    }
  )
}

fn coverage_subject_eq(a: DeclarationRef, b: DeclarationRef) -> Bool {
  (a.module_path == b.module_path) && (a.decl_name == b.decl_name)
}

fn coverage_frontier_row_for_subject(subject: DeclarationRef) -> List<EmitCoverageFrontierRow> {
  fold(
    emit_coverage_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if coverage_subject_eq(a: row.subject, b: subject) {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

fn coverage_frontier_total_holds() -> Bool {
  let split_total = length(xs: self_emitted_native_rows()) + length(xs: interpreter_retained_rows())
  length(xs: emit_coverage_frontier_roster) == emit_coverage_frontier_family_count_expected
    && split_total == emit_coverage_frontier_family_count_expected
}

fn schedule_entry_matches(entry: ScheduleWitnessEntry, backing_entry: String, backing_function: String) -> Bool {
  (entry.entry == backing_entry) && (entry.function == backing_function)
}

data emit_coverage_backing_check_note: String = "Construction, not a vibe check (DESIGN section 5): a SelfEmittedNative claim is only as good as its citation. coverage_row_backing_is_enrolled cross-references the row's backing_entry/backing_function against falsifier_self_host_wet_template_entries — the SAME enrolled-offline-witness roster wet_receipt_enrollment.dag already gates. A row claiming SelfEmittedNative whose backing citation is not enrolled there is unbacked and the check returns false; this is the discriminating oracle behind the RED probe in emit_coverage_frontier_test.dag."

fn coverage_row_backing_is_enrolled(row: EmitCoverageFrontierRow) -> Bool {
  match row.disposition {
    SelfEmittedNative { backing_entry: be, backing_function: bf } => any(
      xs: falsifier_self_host_wet_template_entries,
      predicate: fn(entry) { schedule_entry_matches(entry: entry, backing_entry: be, backing_function: bf) }
    )
    InterpreterRetained { reason: _, dissolve_on: _ } => true
  }
}

fn coverage_frontier_all_native_claims_backed() -> Bool {
  fold(
    emit_coverage_frontier_roster,
    init: true,
    f: fn(acc, row) { acc && coverage_row_backing_is_enrolled(row: row) }
  )
}
