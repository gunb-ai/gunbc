module v2.compiler.self_host.emit_coverage_frontier


data emit_coverage_frontier_note: String = "Kernel-D Stage 3 (session loyal-raven-94, 2026-07-24): a typed, counted roster over the emit_host_*/rust_*_equals_eval witness families tracking NATIVE-EVAL CONSTRUCT COVERAGE — each row is exactly one of SelfEmittedNative (a real ingest to emit to compile to run witness exists and its body is decoded stdout, eval() never called) or InterpreterRetained (the family's coverage witness is an equals_eval AGREEMENT test — it calls v1_interpreter eval() as one of its two legs, so the construct is not yet proven native standalone). This is a DIFFERENT authority from v2.compiler.self_host.native_routing_frontier (that frontier tracks CI EXECUTION ROUTING COST for agreement legs that already run native in the floor — a family can be InterpretedRetained there for cost reasons while its underlying construct is already SelfEmittedNative here, or vice versa) and from v2.compiler.self_host.frontier (that frontier tracks COMPILER MODULE self-emission, a meta-level fact about the host pipeline, not about witness bodies). Reused shape (DESIGN section 2, horizontal): DeclarationRef subject + disposition enum with reason/dissolve_on + count-based census, the same pattern as both siblings."

data emit_coverage_frontier_two_axis_note: String = "TWO AXES, do not conflate (parent-directed 2026-07-24): axis (a) witness-body-runs-native — does the construct's OWN discriminating test execute compiled-native code and read a real stdout/side-effect, never calling eval()? This frontier answers axis (a) only. Axis (b) — does the .dag HOST/COMPILER PIPELINE itself (ingest, infer, emit, the tooling that produces the witness) run as emitted-native code rather than the interpreted v1 seed? — is the Gate-1 self-host-frontier lane (v2.compiler.self_host.frontier, a sibling session's track), never claimed by a row here. A SelfEmittedNative row here says only: this CONSTRUCT's behavior has been proven native-executed at least once, by a real compile+run witness; it says nothing about which engine compiled or ran the compiler itself."

type EmitCoverageDisposition
  = SelfEmittedNative { backing_entry: String, backing_function: String }
  | InterpreterRetained { reason: String, dissolve_on: String }

type EmitCoverageFrontierRow {
  subject: DeclarationRef
  witness_entry: String
  witness_function: String
  disposition: EmitCoverageDisposition
}

fn coverage_subject(module_path: String, decl_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path,
    decl_name: decl_name,
    field: WholeDeclaration
  }
}

fn retained_via_eval_agreement(
  subject: DeclarationRef,
  entry: String,
  f: String
) -> EmitCoverageFrontierRow {
  EmitCoverageFrontierRow {
    subject: subject,
    witness_entry: entry,
    witness_function: f,
    disposition: InterpreterRetained {
      reason: "witness_body_calls_eval",
      dissolve_on: "a native_only-verdict-style witness (real ingest to emit to compile to run native, verdict decoded from stdout, eval() never called — the emit_host_native_only_verdict_test.dag pattern) lands for this family and is enrolled in falsifier_self_host_wet_template_entries"
    }
  }
}

