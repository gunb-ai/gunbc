module v2.compiler.self_host.compile_obligation_activation

import std.decl_ref { DeclarationRef, declaration_ref_display_key }
import v2.compiler.compile {
  CompileLens,
  required_compile_lens_roster,
  required_lens_roster_digest,
}
import v2.compiler.self_host.compile_obligation_ledger {
  ObligationLedger,
  ObligationLedgerObserved,
  ObligationLedgerUnobservable,
  rows_for_lens,
}
import v2.std.algebra { Cons, Empty, fold_list, list_reverse }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.text { String }

// WHAT IS SELF-HOST-SPECIFIC ABOUT ACTIVATING A COMPILE OBLIGATION, AND WHAT IS NOT.
//
// An earlier revision of this module declared a nine-arm ladder — Registered, Reached, Executed,
// Qualified, Observed, ClosureClosed, CandidateEnforced, SuccessorEnforced, SeedIndependent — and
// derived it from receipts. The derivation was right and the vocabulary was a FORK, which a §3
// check caught before it was ever pushed. Every one of those arms already had a preimage, and none
// of them here:
//
//   - CandidateEnforced / SuccessorEnforced / SeedIndependent are not states, they are PATHS.
//     `gunbc.guarantee_measurement` `GuaranteePath` carries exactly that axis, with
//     `PathRealization = InterpreterRealization | EmittedTarget { language }`.
//   - Registered / Reached / Executed / Qualified are a DISPOSITION PER PATH, whose vocabulary the
//     roadmap already fixes — Unmeasured, BelowFloor, FrontierAccepted, OnLadder,
//     OutsideModeledGuarantee — derived and never stored, folded by below-floor dominance, then
//     frontier, then unmeasured, then the MINIMUM rung across paths.
//   - Observed is a ledger fact and ClosureClosed is a findings fact; both have their own carriers.
//
// So nine names stood over five dispositions and a path axis, and a reader would have had to map
// them by hand — the second ladder DESIGN §4b's rungs exist to prevent. This module now declares
// none of that. It keeps only the two facts that are genuinely about SELF-HOSTING a compile
// obligation, and the disposition derivation lands in `gunbc.guarantee_measurement` first, because
// model-before-implement means the home precedes its consumer rather than the consumer minting a
// vocabulary while it waits.

// FACT ONE: WHICH OBLIGATIONS MUST CLIMB TOGETHER, AND WHY THAT IS NOT A PRESENTATION CHOICE.
//
// A bundle exists where an obligation's honest standing depends on a fact a SECOND authority owns,
// so reporting the gate alone overstates it:
//
//   - COMPLEXITY is the accumulator-copy gate AND the realization-cost fidelity join. A lens that
//     prices the declaration while the lane runs the realization can convict a correct construction
//     and acquit a quadratic one (gunbc.recurring_failure_mode
//     lens_prices_the_authority_while_the_lane_runs_the_realization), so the gate's standing is
//     worth no more than the cost authority underneath it.
//   - DETERMINISM is the gate AND the traversal-order facts for the operations it ranges over AND
//     non-primitive reachability. Absence from the declared roster is not evidence of determinism,
//     so the gate's silence is only as good as the roster's coverage.
//
// The membership is the fact this module owns. What a bundle's standing IS — the fold over its
// members — is the same minimum-across-paths law §4b(1) already states, so it is named here and
// computed where the dispositions live.
type ObligationBundle {
  bundle: DeclarationRef
  members: List<DeclarationRef>
}

type ObligationBundleCause
  = BundleMemberNotRegistered { member: DeclarationRef }
  | BundleWithoutMembers { bundle: DeclarationRef }
  | BundleRosterEmpty

type ObligationBundleCoverage
  = ObligationBundleCoverageClosed { roster_digest: String, bundles: Int, members: Int }
  | ObligationBundleCoverageRefused { cause: ObligationBundleCause }

fn lens_is_registered(wanted: DeclarationRef) -> Bool {
  fold_list(
    xs: required_compile_lens_roster(),
    empty: false,
    cons: fn(acc, lens) {
      acc
        || declaration_ref_display_key(ref: lens.identity)
          == declaration_ref_display_key(ref: wanted)
    }
  )
}

// A BUNDLE MEMBER THAT NAMES NO REGISTRATION IS A GROUPING OVER NOTHING, and an empty bundle is a
// name with no subject. Both refuse: a bundle exists to make one member's silence visible behind
// another's green, and a bundle whose membership is wrong cannot do that for anyone.
fn unregistered_members(bundles: List<ObligationBundle>) -> List<DeclarationRef> {
  list_reverse(xs: fold_list(xs: bundles, empty: Empty, cons: fn(acc, b) {
    fold_list(xs: b.members, empty: acc, cons: fn(inner, m) {
      if lens_is_registered(wanted: m) { inner } else { Cons { head: m, tail: inner } }
    })
  }))
}

fn empty_bundles(bundles: List<ObligationBundle>) -> List<DeclarationRef> {
  list_reverse(xs: fold_list(xs: bundles, empty: Empty, cons: fn(acc, b) {
    match b.members {
      Empty => Cons { head: b.bundle, tail: acc }
      Cons { head: _, tail: _ } => acc
    }
  }))
}

fn count_bundle_members(bundles: List<ObligationBundle>) -> Int {
  fold_list(xs: bundles, empty: 0, cons: fn(acc, b) {
    fold_list(xs: b.members, empty: acc, cons: fn(inner, _) { inner + 1 })
  })
}

fn obligation_bundle_coverage(bundles: List<ObligationBundle>) -> ObligationBundleCoverage {
  match bundles {
    Empty => ObligationBundleCoverageRefused { cause: BundleRosterEmpty }
    Cons { head: _, tail: _ } =>
      match empty_bundles(bundles: bundles) {
        Cons { head: b, tail: _ } =>
          ObligationBundleCoverageRefused { cause: BundleWithoutMembers { bundle: b } }
        Empty =>
          match unregistered_members(bundles: bundles) {
            Cons { head: m, tail: _ } =>
              ObligationBundleCoverageRefused { cause: BundleMemberNotRegistered { member: m } }
            Empty =>
              ObligationBundleCoverageClosed {
                roster_digest: required_lens_roster_digest(),
                bundles: fold_list(xs: bundles, empty: 0, cons: fn(acc, _) { acc + 1 }),
                members: count_bundle_members(bundles: bundles),
              }
          }
      }
  }
}

// FACT TWO: THE RECEIPTS THE SELF-HOST ROUTE PRODUCES, and nothing about what they add up to.
//
// These are observations this route can make about one obligation. They are deliberately NOT folded
// into a standing here: folding them is the disposition derivation, it is per path, and its home is
// gunbc.guarantee_measurement. Carrying the observations without the verdict is what lets that home
// land first and consume these unchanged.
//
// QUALIFICATION IS TWO OBSERVATIONS, NOT ONE, and the pair is the part most easily fudged: a gate
// that refuses every subject refuses the planted red too, so a caught red alone says nothing about
// discrimination. §4b(1) states the same requirement for a rung — a discriminating RED refused on
// the real acceptance path PLUS an accepted positive control — which is why both fields exist and
// why neither is a summary of the other.
type SelfHostObligationReceipts {
  obligation: DeclarationRef
  reached_on_route: Bool
  executed_with_witness: Bool
  planted_red_refused: Bool
  nearby_green_accepted: Bool
  ledger_rows_observed: Int
  findings_open: Int
  unclassifiable_present: Bool
  unclassifiable_carried_by_name: Bool
}

fn no_self_host_receipts(obligation: DeclarationRef) -> SelfHostObligationReceipts {
  SelfHostObligationReceipts {
    obligation: obligation,
    reached_on_route: false,
    executed_with_witness: false,
    planted_red_refused: false,
    nearby_green_accepted: false,
    ledger_rows_observed: 0,
    findings_open: 0,
    unclassifiable_present: false,
    unclassifiable_carried_by_name: false,
  }
}

// The two predicates a consumer needs that are facts about the RECEIPTS rather than judgments about
// the obligation: whether this route qualified it, and whether the findings it produced are closed.
// A consumer folds these per path; this module does not say what the fold answers.
fn receipts_qualify(r: SelfHostObligationReceipts) -> Bool {
  r.reached_on_route && r.executed_with_witness && r.planted_red_refused && r.nearby_green_accepted
}

// UNCLASSIFIABLE RESIDUE IS CLOSED ONLY WHEN CARRIED BY NAME. Silent residue leaves the closure
// open; named residue is open coverage someone can go and close, and the difference between them is
// the whole of "resolved or carried as open coverage by name" (DESIGN §5: a typed, located,
// countable diagnostic, never a silence).
fn receipts_close_the_closure(r: SelfHostObligationReceipts) -> Bool {
  r.findings_open == 0 && (!r.unclassifiable_present || r.unclassifiable_carried_by_name)
}

// THE LEDGER SUPPLIES THE OBSERVATION COUNT AND NOTHING ELSE: what it reports is what the obligation
// SAID, and whether the findings were repaired is a different fact with a different producer.
fn with_ledger_observation(
  r: SelfHostObligationReceipts,
  ledger: ObligationLedger
) -> SelfHostObligationReceipts {
  SelfHostObligationReceipts {
    obligation: r.obligation,
    reached_on_route: r.reached_on_route,
    executed_with_witness: r.executed_with_witness,
    planted_red_refused: r.planted_red_refused,
    nearby_green_accepted: r.nearby_green_accepted,
    ledger_rows_observed: observed_rows_for(ledger: ledger, obligation: r.obligation),
    findings_open: r.findings_open,
    unclassifiable_present: r.unclassifiable_present,
    unclassifiable_carried_by_name: r.unclassifiable_carried_by_name,
  }
}

fn observed_rows_for(ledger: ObligationLedger, obligation: DeclarationRef) -> Int {
  match ledger {
    ObligationLedgerUnobservable { at_grain: _ } => 0
    ObligationLedgerObserved { roster_digest: _, rows: rows } =>
      fold_list(
        xs: rows_for_lens(rows: rows, lens: obligation),
        empty: 0,
        cons: fn(acc, _) { acc + 1 }
      )
  }
}
