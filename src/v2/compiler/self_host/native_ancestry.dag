module v2.compiler.self_host.native_ancestry

import std.content_hash { content_hash_eq_sha512 }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.types { NonEmptyStr }
import v2.compiler.self_host.emitter_producer_provenance {
  EmitterProducer,
  ProducerMintAdmitted,
  ProducerMintRefused,
  RealizedEmitterClosure,
  V1SeedEmitter,
  V2EmitterInterpreted,
  V2EmitterNative,
  emitter_producer_eq,
  emitter_producer_mint_admission,
  realized_closure_contains_module,
  realized_closure_eq,
  seed_emit_rust_reachable,
  v2_interpreted_emitter_closure
}
import v2.compiler.self_host.generation {
  ArtifactMaterialized,
  GeneratedArtifactIdentity,
  GenerationIdentity,
  ObservedArtifactDigest,
  compiler_artifact_identity,
  generation_identity_agrees
}
import v2.std.algebra { fold_list, is_empty }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node { Hash }
import v2.std.optional { Absent, Optional, Present }
import v2.std.text { String }

// Native ancestry: THE SEED IS NEVER THE ORDINARY MISS PATH (operator ruling 2026-09-11).
// One genesis V1SeedEmitter → NativeGeneration 0, then only V2EmitterNative(N) → N+1.
// A missing, damaged or unverified ancestor is a typed refusal. EmitterProducer is
// reused; there is no second producer coproduct and no used_seed: Bool.

data v1_compile_qualified_module: String = "v1.compile"

data v1_interpreter_qualified_module: String = "v1_compiler.v1_interpreter"

fn admitted_native_producer_closure() -> RealizedEmitterClosure {
  v2_interpreted_emitter_closure
}

fn v1_interpreter_reachable(closure: RealizedEmitterClosure) -> Bool {
  realized_closure_contains_module(
    closure: closure,
    module: v1_interpreter_qualified_module
  )
}

fn v1_compile_reachable(closure: RealizedEmitterClosure) -> Bool {
  realized_closure_contains_module(
    closure: closure,
    module: v1_compile_qualified_module
  )
}

fn v1_route_reachable(closure: RealizedEmitterClosure) -> Bool {
  seed_emit_rust_reachable(closure: closure)
    || v1_compile_reachable(closure: closure)
    || v1_interpreter_reachable(closure: closure)
}

fn native_producer_closure_excludes_v1(closure: RealizedEmitterClosure) -> Bool {
  !v1_route_reachable(closure: closure)
    && !is_empty(xs: closure.emitter_module_paths)
    && match emitter_producer_mint_admission(
      producer: V2EmitterNative { generation: 0 },
      closure: closure
    ) {
      ProducerMintAdmitted => true
      ProducerMintRefused { cause: _ } => false
    }
}

fn old_route_absent_by_construction_holds(closure: RealizedEmitterClosure) -> Bool {
  realized_closure_eq(left: closure, right: admitted_native_producer_closure())
    && native_producer_closure_excludes_v1(closure: closure)
}

type ArtifactReadBackReceipt {
  subject: GenerationIdentity
  observed: ObservedArtifactDigest
}

fn read_back_verifies(
  identity: GenerationIdentity,
  read_back: ArtifactReadBackReceipt
) -> Bool {
  generation_identity_agrees(left: identity, right: read_back.subject)
    && match identity.materialized_artifact {
      ArtifactMaterialized { digest: d } =>
        content_hash_eq_sha512(left: d.observed, right: read_back.observed.observed)
      ArtifactNotMaterialized => false
    }
}

type NativeGenerationRecord {
  generation: Int
  producer: EmitterProducer
  identity: GenerationIdentity
  realized_closure: RealizedEmitterClosure
  emitted_source_identity: Hash
  read_back: ArtifactReadBackReceipt
}

type NativeGenesisReceipt {
  seed_binary_identity: Hash
  canonical_closure_identity: Hash
  target_model: Hash
  toolchain: Hash
  build_configuration: Hash
  emitted_source_identity: Hash
  built_artifact: GeneratedArtifactIdentity
  read_back: ArtifactReadBackReceipt
  realized_closure: RealizedEmitterClosure
  producer: EmitterProducer
  deletion_trigger: DissolutionCondition
}

data native_genesis_deletion_trigger: DissolutionCondition = unbound_dissolution(
  description: "the first V2EmitterNative(N) -> NativeGeneration(N+1) execution that verifies" as NonEmptyStr
)

type GenesisStanding
  = GenesisNotYetExecuted
  | GenesisExecuted { receipt: NativeGenesisReceipt }

type NativeGenesisRefusal
  = GenesisAlreadyExecuted
  | GenesisProducerMustBeSeed
  | GenesisReadBackFailed
  | GenesisV1RouteStillReachable

type NativeGenesisAdmission
  = NativeGenesisAdmitted { receipt: NativeGenesisReceipt }
  | NativeGenesisRefused { cause: NativeGenesisRefusal }

fn genesis_identity(receipt: NativeGenesisReceipt) -> GenerationIdentity {
  compiler_artifact_identity(
    producer_compiler: receipt.seed_binary_identity,
    source_closure: receipt.canonical_closure_identity,
    target_model: receipt.target_model,
    toolchain: receipt.toolchain,
    build_configuration: receipt.build_configuration,
    materialized_artifact: receipt.built_artifact
  )
}

fn genesis_producer_is_seed(producer: EmitterProducer) -> Bool {
  match producer {
    V1SeedEmitter => true
    V2EmitterInterpreted => false
    V2EmitterNative { generation: _ } => false
  }
}

fn admit_native_genesis(
  standing: GenesisStanding,
  attempt: NativeGenesisReceipt
) -> NativeGenesisAdmission {
  match standing {
    GenesisExecuted { receipt: _ } =>
      NativeGenesisRefused { cause: GenesisAlreadyExecuted }
    GenesisNotYetExecuted =>
      if !genesis_producer_is_seed(producer: attempt.producer) {
        NativeGenesisRefused { cause: GenesisProducerMustBeSeed }
      } else if !old_route_absent_by_construction_holds(closure: attempt.realized_closure) {
        NativeGenesisRefused { cause: GenesisV1RouteStillReachable }
      } else if !read_back_verifies(
        identity: genesis_identity(receipt: attempt),
        read_back: attempt.read_back
      ) {
        NativeGenesisRefused { cause: GenesisReadBackFailed }
      } else {
        NativeGenesisAdmitted { receipt: attempt }
      }
  }
}

type NativeAncestryStore {
  genesis: GenesisStanding
  generations: List<NativeGenerationRecord>
}

type NativeAcquisition
  = NativeAncestorAcquired { record: NativeGenerationRecord }
  | NativeAncestorMissing { expected_generation: Int }
  | NativeAncestorUnverified { expected_generation: Int }

fn generation_record_at(
  generations: List<NativeGenerationRecord>,
  generation: Int
) -> Optional<NativeGenerationRecord> {
  fold_list(
    xs: generations,
    empty: Absent,
    cons: fn(acc, record) {
      match acc {
        Present { value: found } => Present { value: found }
        Absent =>
          if record.generation == generation {
            Present { value: record }
          } else {
            Absent
          }
      }
    }
  )
}

fn acquire_native_ancestor(
  store: NativeAncestryStore,
  expected_generation: Int
) -> NativeAcquisition {
  match generation_record_at(generations: store.generations, generation: expected_generation) {
    Absent => NativeAncestorMissing { expected_generation: expected_generation }
    Present { value: record } =>
      if !read_back_verifies(identity: record.identity, read_back: record.read_back) {
        NativeAncestorUnverified { expected_generation: expected_generation }
      } else if v1_route_reachable(closure: record.realized_closure) {
        NativeAncestorUnverified { expected_generation: expected_generation }
      } else {
        NativeAncestorAcquired { record: record }
      }
  }
}

type NativeSuccessorRefusal
  = SuccessorProducerMustBeNativeAncestor
  | SuccessorGenerationNotNext
  | SuccessorInterpretedProducerRefused
  | SuccessorReadBackFailed
  | SuccessorV1RouteReachable

type NativeSuccessorAdmission
  = NativeSuccessorAdmitted { record: NativeGenerationRecord }
  | NativeSuccessorRefused { cause: NativeSuccessorRefusal }

fn recurring_producer(from_generation: Int) -> EmitterProducer {
  V2EmitterNative { generation: from_generation }
}

fn admit_native_successor(
  ancestor: NativeGenerationRecord,
  produced: NativeGenerationRecord
) -> NativeSuccessorAdmission {
  match produced.producer {
    V1SeedEmitter =>
      NativeSuccessorRefused { cause: SuccessorProducerMustBeNativeAncestor }
    V2EmitterInterpreted =>
      NativeSuccessorRefused { cause: SuccessorInterpretedProducerRefused }
    V2EmitterNative { generation: g } =>
      if !emitter_producer_eq(
        left: produced.producer,
        right: recurring_producer(from_generation: ancestor.generation)
      ) {
        NativeSuccessorRefused { cause: SuccessorProducerMustBeNativeAncestor }
      } else if produced.generation != (ancestor.generation + 1) {
        NativeSuccessorRefused { cause: SuccessorGenerationNotNext }
      } else if g != ancestor.generation {
        NativeSuccessorRefused { cause: SuccessorProducerMustBeNativeAncestor }
      } else if v1_route_reachable(closure: produced.realized_closure) {
        NativeSuccessorRefused { cause: SuccessorV1RouteReachable }
      } else if !read_back_verifies(identity: produced.identity, read_back: produced.read_back) {
        NativeSuccessorRefused { cause: SuccessorReadBackFailed }
      } else {
        NativeSuccessorAdmitted { record: produced }
      }
  }
}
