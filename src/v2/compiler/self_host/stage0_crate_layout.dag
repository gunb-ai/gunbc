  SeedRetainedScaffoldRegistration { basename: "v2_compiler_infer" }
]

fn intrinsic_pub_mod_basename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.has_pub_mod {
    [row.basename]
  } else {
    []
  }
}

fn intrinsic_stage0_filename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    []
  } else {
    [concat(row.basename, ".rs")]
  }
}

fn intrinsic_stage0_dir_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    [row.basename]
  } else {
    []
  }
}

fn seed_retained_intrinsic_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_pub_mod_basename_from_row(row: row))
    }
  )
}

fn seed_retained_intrinsic_stage0_files() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_stage0_filename_from_row(row: row))
    }
  )
}

fn seed_retained_scaffold_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [row.basename])
    }
  )
}

fn seed_retained_scaffold_stage0_files() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [concat(row.basename, ".rs")])
    }
  )
}

fn seed_retained_support_stage0_dirs() -> List<String> {
  fold(
    seed_retained_support_dir_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [row.basename])
    }
  )
}

fn hand_maintained_stage0_dirs() -> List<String> {
  concat(
    fold(
      seed_retained_intrinsic_registrations,
      init: [],
      f: fn(acc, row) {
        concat(acc, intrinsic_stage0_dir_from_row(row: row))
      }
    ),
    seed_retained_support_stage0_dirs()
  )
}

fn basename_to_pub_mod_decl(basename: String) -> String {
  concat("pub mod ", basename, ";")
}

fn dispatch_generated_macro_use_pub_mod_decl() -> String {
  "#[macro_use]\npub mod v1_interpreter_dispatch_generated;"
}

fn pub_mod_decl_lines_for_basename(basename: String) -> List<String> {
  if basename == "v1_interpreter" {
  [
    dispatch_generated_macro_use_pub_mod_decl(),
    basename_to_pub_mod_decl(basename: basename),
  ]
  } else if basename == "v1_interpreter_dispatch_generated" {
    []
  } else {
    [basename_to_pub_mod_decl(basename: basename)]
  }
}

fn format_pub_mod_declarations(basenames: List<String>) -> String {
  let lines = basenames |> flat_map(basename => pub_mod_decl_lines_for_basename(basename: basename))
  concat("\n", lines |> join(separator: "\n"))
}

fn basename_to_stage0_filename(basename: String) -> String {
  concat(basename, ".rs")
}

fn basenames_to_stage0_filenames(basenames: List<String>) -> List<String> {
  basenames |> map(basename_to_stage0_filename)
}

// These three keep their zero-arity shape deliberately. Their caller is
// generated_artifact_emit.dag's ~18-variant dispatch, one match whose every arm is a zero-arg
// generator returning String; giving them a parameter would force seventeen unrelated generators to
// accept an argument they cannot use. Changing their arity broke this lane once: dag/gunbc and
// dag/test/claim callers compile CLEAN at a stale arity because .dag does not arity-check these
// cross-module sites, so the breakage surfaces only at run time.

// TWO SOURCE-LIFECYCLE POPULATIONS AND ONE RENDERING UNION, kept apart because a consumer outside
// rendering asks a lifecycle question of the first.
//
// THIS FUNCTION KEEPS ITS MEANING AND ITS NAME. `v2.compiler.self_host.stage0_executable_assembly`
// consumes it as the RETAINED-MODULE POPULATION -- `stage0_live_retained_pub_mod_basenames` is
// literally this call -- and a basename in that population must resolve to a seed-retention row or
// the census refuses `RetainedModuleHasNoRetentionRow`. Widening it to "everything lib.rs declares"
// would feed a GENERATED artifact into a RETAINED-SOURCE classifier, whose three available outcomes
// are all wrong: the generated module falsely classifies as a retained host owner, or it refuses,
// or someone adds a false retention row to make the census green. A misleading name is a smaller
// defect than a population that answers a lifecycle question it cannot answer.
fn hand_maintained_pub_mod_basenames() -> List<String> {
  concat(seed_retained_intrinsic_pub_mod_basenames(), seed_retained_scaffold_pub_mod_basenames())
}

// THE RENDERING QUESTION AND THE ROOT-MODULE QUESTION ARE TWO QUESTIONS, and the narrow one may not
// wear the broad name. This population is what the ORDINARY `pub mod <basename>;` formatter folds
// over. It deliberately excludes the macro-spliced dispatch module, whose declaration this block
// does render but as a side effect of the v1_interpreter basename, not as a row of its own.
fn stage0_plain_pub_mod_basenames() -> List<String> {
  concat(hand_maintained_pub_mod_basenames(), wet_actuator_plain_pub_mod_basenames())
}

fn emit_stage0_lib_pub_mod_block() -> String {
  format_pub_mod_declarations(basenames: stage0_plain_pub_mod_basenames())
}

// EVERY MODULE `lib.rs` ACTUALLY DECLARES, which is a superset of the rendering population by
// exactly the macro-spliced row. A consumer asking "is this module a root module of the seed crate"
// must read this and not the rendering one: naming the narrow population `stage0_lib_...` would
// answer NO for v1_interpreter_dispatch_generated, which lib.rs plainly declares.
fn stage0_lib_declared_module_basenames() -> List<String> {
  concat(hand_maintained_pub_mod_basenames(), wet_actuator_lib_module_basenames())
}

// This stays the UNION of every excluded family, including emitter_produced_divergent_stage0_files,
// because its two Rust consumers ask a question the union answers exactly: which basenames must be
// skipped by the flat committed-tree walk, and which must be copied into the candidate tree.
// Splitting the union here instead of beside it would drop the divergent file out of the copy, so
// the candidate tree would carry the emitter's 552-line main.rs and no longer build — a destructive
// remedy offered to whoever hits the refusal. The split that matters is the SECOND projection
// below, which names the divergent population separately so it can be counted and enforced; the
// union carries the same rows for the mechanical purpose it always had.

fn hand_maintained_stage0_filenames() -> List<String> {
  concat(
    concat(
      concat(seed_retained_intrinsic_stage0_files(), seed_retained_scaffold_stage0_files()),
      wet_actuator_generated_stage0_files()
    ),
    emitter_produced_divergent_stage0_files()
  )
}

type EmitterProducedDivergentRegistration {
  basename: String
  reason: String
  restoration_trigger: String
}

data emitter_produced_divergent_note: String = "A DECLARED RUNG DROP (DESIGN section 4b), not a hand-authored file. These basenames ARE in compile_stage0()'s emitted population and what it emits DIVERGES from what is committed. Every other exclusion family above names a file the emitter does not produce at all, so for them exclusion from the regen comparison costs nothing; for these it suppresses a real authority-versus-artifact divergence. Declared rung: mitigatable — the divergence is measured, named and counted on every required-regen run, and the population is bounded by this list. Ceiling: structural impossibility — the file is decidable and fully modelled, so the reachable end state is that the emitter produces the committed bytes and this family is EMPTY, not that a check reports the gap. main was carried as a SeedRetainedIntrinsicRegistration, whose type asserts hand-authored source with no .dag authority; that is false of a file the emitter emits, and the false family is exactly what made the divergence unobservable. The consumer enforces this list in three directions rather than reading it as permission: an undeclared divergence FAILS (a new suppression cannot be added by editing Rust), a declared row that no longer diverges FAILS (the restoration trigger is mechanical, not prose), and a declared row the emitter no longer produces FAILS (a row cannot outlive its producer)."

// CROSS-DIVERGENCE CALL CONTRACT, §4b rung row. Invalid state: an emitted declaration and its
// hand-retained caller disagree in parameter arity or order across the declared main.rs divergence
// boundary. Current rung: mitigatable — rustc refuses the mismatch, but only when a consumer builds
// the composed crate. Ceiling: structural impossibility, because both sides are modeled corpus
// members. Next-rung capability trigger: the emitter renders, or a structural lens derives, the
// caller-side dispatch contract from the same authority that renders the generated carrier
// signature, so changing either arity or order cannot leave the retained call stale. At that point
// this row is deleted with the independently authored caller contract; adding one compile test does
// not satisfy the trigger because the lost relation is corpus-grain.
data emitter_produced_divergent_registrations: List<EmitterProducedDivergentRegistration> = [
  EmitterProducedDivergentRegistration {
    basename: "main",
    reason: "The complete shipped command grammar and realization selection now live in the ordinary generated gunbc_cli_dispatch_generated.rs carrier. main.rs retains only the host bodies behind CliDispatchHost and one generic delegation. Its remaining divergence from emit_main_rs is therefore the retained host boundary, not a second command population or verb-selection authority.",
    restoration_trigger: "Delete this row when every retained host body is emitted or moved behind an emitted boundary AND the emitter candidate main.rs is byte-equal to the committed main.rs. Formatting differences do not satisfy or defer the trigger."
  }
]

fn emitter_produced_divergent_stage0_files() -> List<String> {
  fold(
    emitter_produced_divergent_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [concat(row.basename, ".rs")])
    }
  )
}

// THE FIELD NAMES THE DECLARATION ROUTE, NOT THE PRESENCE OF A DECLARATION, and the distinction is
// not pedantic: a `has_pub_mod: false` on the dispatch row would be false in plain English, because
// that module DOES reach `lib.rs` -- through a `#[macro_use] pub mod` line the v1_interpreter row
// splices, which `pub_mod_decl_lines_for_basename` already special-cases. What separates the rows is
// WHO EMITS the declaration and in what form:
//
//   PathIncluded            not in lib.rs at all; a `#[path=...] mod` inside required_regen_host.rs
//                           reaches it (bootstrap).
//   MacroUsePubModSpliced   in lib.rs, but as a `#[macro_use] pub mod` line the v1_interpreter row
//                           renders, which `pub_mod_decl_lines_for_basename` already special-cases.
//   PlainPubMod             this projection renders an ordinary `pub mod <basename>;` line.
//
// The evaluation-budget consequence projection is the first wet-actuator artifact in the third
// class, because `cli_run` imports it as an ordinary module. Answering that with a
// SeedRetainedIntrinsicRegistration was available and would have been false: that type asserts
// hand-authored source with no .dag authority, the opposite of this file's lifecycle.
// THREE ROUTES AND NOT TWO, because the two non-plain rows do not share a mechanism. An earlier
// shape here collapsed both into one SplicedByAnotherRow arm on the reasoning that the projection
// only needs to know whether a row contributes an ordinary basename. That is true of the PROJECTION
// and false of the SUBJECT: the two rows differ in which declaration owns them and therefore in
// what breaks when that owner moves. v1_interpreter_dispatch_generated is declared inside lib.rs by
// a `#[macro_use] pub mod` line the v1_interpreter row emits -- delete that row and the module
// vanishes from the crate; bootstrap_stage0_crate_layout_generated is not in lib.rs at all, reached
// by a `#[path=...] mod` inside required_regen_host.rs -- delete THAT and lib.rs is unaffected while
// the regen host stops compiling. One arm covering both would answer "why is it excluded" with a
// fact about this fold instead of a fact about the crate.
type WetActuatorDeclarationRoute
  = PathIncluded
  | MacroUsePubModSpliced
  | PlainPubMod

type WetActuatorGeneratedRegistration {
  basename: String
  declaration_route: WetActuatorDeclarationRoute
}

data wet_actuator_generated_registrations: List<WetActuatorGeneratedRegistration> = [
  WetActuatorGeneratedRegistration { basename: "bootstrap_stage0_crate_layout_generated", declaration_route: PathIncluded },
  WetActuatorGeneratedRegistration { basename: "v1_interpreter_dispatch_generated", declaration_route: MacroUsePubModSpliced },
  WetActuatorGeneratedRegistration { basename: "evaluation_budget_consequence_generated", declaration_route: PlainPubMod }
]

// THE CRATE EXPOSURE IS ITS OWN ENROLLMENT, and that is why this projection exists rather than the
// filename one answering for both. Registry membership decides that the artifact is GENERATED and
// drift-adjudicated; it says nothing about whether the seed can import the module. A file could be
// generated, committed, drift-clean and still unreachable from `cli_run` -- an unused twin, which
// the plan's consumer bar rejects by name.
fn wet_actuator_plain_pub_mod_basenames() -> List<String> {
  fold(
    wet_actuator_generated_registrations,
    init: [],
    f: fn(acc, row) {
      match row.declaration_route {
        PlainPubMod => concat(acc, [row.basename])
        MacroUsePubModSpliced => acc
        PathIncluded => acc
      }
    }
  )
}

// THE ROOT-MODULE SUBSET OF THE WET FAMILY. PathIncluded is excluded and that exclusion is the
// content: the bootstrap layout artifact is reached by a `#[path=...] mod` nested inside
// required_regen_host.rs, so it is not a root module of lib.rs at all. Pulling nested path-included
// modules into a root-module census would silently widen it over a much larger pre-existing host
// population that this fold does not enumerate -- a separate cut, not a free generalization.
fn wet_actuator_lib_module_registrations() -> List<WetActuatorGeneratedRegistration> {
  fold(
    wet_actuator_generated_registrations,
    init: [],
    f: fn(acc, row) {
      match row.declaration_route {
        PlainPubMod => concat(acc, [row])
        MacroUsePubModSpliced => concat(acc, [row])
        PathIncluded => acc
      }
    }
  )
}

fn wet_actuator_lib_module_basenames() -> List<String> {
  fold(wet_actuator_lib_module_registrations(), init: [], f: fn(acc, row) { concat(acc, [row.basename]) })
}

data v1_interpreter_dispatch_generated_family_note: String = "MOVED here from seed_retained_scaffold_registrations 2026-08-21. It was never a quarantine scaffold: its own banner names its producer, dag/gunbc/v1/v1_interpreter_dispatch_emit.dag, a SECOND wet actuator with exactly the property this family exists to state — it reaches disk through main_wet and so structurally never appears in compile_stage0()'s emitted population, which is why it must stay in the filename exclusion. Verified NOT-EMITTED by execution 2026-08-21 alongside the other 34. The move is byte-neutral for the pub-mod block: pub_mod_decl_lines_for_basename returns the empty list for this basename because its declaration is spliced by the v1_interpreter row as a macro_use line, so leaving the scaffold family costs it no pub mod it previously had."

data wet_actuator_generated_files_note: String = "bootstrap_stage0_crate_layout_generated.rs is NOT hand-Rust — it IS modeled, by this exact module (v2.compiler.self_host.stage0_crate_layout), and its content (HAND_MAINTAINED_STAGE0_FILES and friends) is exactly what hand_maintained_stage0_filenames/stage0_plain_pub_mod_basenames above derive. It reaches disk through dag/gunbc/instruments/generated_artifact_gate.dag main_wet, a wet actuator distinct from the ordinary per-module Rust emit compile_stage0() performs, so it structurally never appears in compile_stage0()'s emitted population and would misreport as committed_not_emitted without this row. It gets its own registration type rather than folding into SeedRetainedIntrinsicRegistration because that type asserts hand-authored source with no .dag authority, which is false here; this row instead names the real reason — a second, wet-actuator generation path compile_stage0() does not observe. How a registration reaches the crate is now carried per row by declaration_route rather than assumed for the family: bootstrap_stage0_crate_layout_generated is PathIncluded (a #[path=...] mod inside required_regen_host.rs, never in lib.rs) and v1_interpreter_dispatch_generated is MacroUsePubModSpliced (a #[macro_use] pub mod line the v1_interpreter row emits into lib.rs), and evaluation_budget_consequence_generated is PlainPubMod, declared by lib.rs like any other module. Each arm drives a different derived population rather than labelling rows for a reader: PathIncluded reaches the filename exclusion only; MacroUsePubModSpliced additionally joins wet_actuator_lib_module_basenames, because lib.rs really does declare that module even though this block does not render its line; PlainPubMod joins that population AND stage0_plain_pub_mod_basenames. Neither route makes a generated module a RETAINED one, which is why the union is separate from hand_maintained_pub_mod_basenames."

fn wet_actuator_generated_stage0_files() -> List<String> {
  fold(
    wet_actuator_generated_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [concat(row.basename, ".rs")])
    }
  )
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
