module v2.compiler.self_host.stage0_crate_layout

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { RealizationDispatch }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// The stage0 crate's module layout, authored as registration rows.
//
// This module was carved out of v2.compiler.self_host.frontier when the
// 27-row self-host frontier roster was deleted (see
// stage0_crate_layout_carve_out_note). Crate layout is a separate concept
// from self-host progress; it lived in the frontier module only because the
// roster was once expected to contribute basenames to it, and by the time of
// the deletion it contributed none.

data stage0_crate_layout_carve_out_note: String = "CARVED OUT of v2.compiler.self_host.frontier at that module's deletion, and the carve-out is smaller than the old wiring because the roster term was provably empty. hand_maintained_pub_mod_basenames formerly appended compiler_frontier_emitter_produced_stage0_mod_basenames(), a fold over the roster admitting only EmitterProduced rows. All 27 roster rows were SeedRetained, so that fold returned the empty list at every call — the roster contributed nothing to crate layout on the day it was deleted, and dropping the term changes no emitted byte. The same argument retires hand_maintained_stage0_filenames' roster term and compiler_frontier_crate_layout_holds, whose one non-trivial conjunct counted EmitterProduced basenames against a baseline of zero. What survives here is what actually produced bytes: the intrinsic, scaffold and support-dir registration rows and their pub-mod / filename / dir projections."

type SeedRetainedIntrinsicRegistration {
  basename: String
  has_pub_mod: Bool
  is_dir: Bool
}

type SeedRetainedScaffoldRegistration {
  basename: String
}

type SeedRetainedSupportDirRegistration {
  basename: String
}

// THREE INTRINSIC ROWS ADDED 2026-08-19, AND THEIR ABSENCE WAS NOT A LAYOUT DETAIL --
// it was the reason `claim_executor --required-regen` produced no verdict at all on main.
// The regen host classifies the committed stage0 population by COMPLEMENT: every `.rs` under
// src/v1/stage0/src that is not on HAND_MAINTAINED_STAGE0_FILES is presumed to be output of the
// stage0 emit (`required_regen_host` `committed_generated_basenames`). So a hand-authored file
// that nobody registered here does not surface as an unregistered hand file -- it surfaces as a
// generated file the emitter failed to produce, and `validate_compared_populations` refuses the
// whole run before any byte is compared. Measured on e0c5e25444: eight names in
// `committed_not_emitted`, not one of them an emission defect.
//
// None of the three is `pub mod`: `required_regen_host` is declared inside `cli_run`,
// `bootstrap_stage0_crate_layout_generated` inside `required_regen_host`, and
// `cssl_seed_linked_closure_assembly` is reached by `#[path]` from the `cssl_assemble` bin --
// so registering them changes lib.rs by nothing and changes the regen population by everything.
//
// SIX EXISTING ROWS ALSO FLIPPED TO `has_pub_mod: true` in the same edit, for the reason stated
// on the scaffold registrations below: they are seed oracles that live shims import from the seed
// crate, and a module the crate does not declare cannot be imported from it.
//
// `bootstrap_stage0_crate_layout_generated` is generated, but by THIS module's own emitter rather
// than by the stage0 emit plan, so it is correctly outside the regen population. That it rides on
// a list named for hand maintenance is a residual conflation, recorded in the closing block of
// this module rather than fixed silently here.
data seed_retained_intrinsic_registrations: List<SeedRetainedIntrinsicRegistration> = [
  SeedRetainedIntrinsicRegistration { basename: "v1_interpreter", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "bounded_shell_host_drain", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "cli_run", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "codex_app_server_stdio_session", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "coproduct_reflection", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "data_initializer_identity", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "resolved_graph_cache", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "shared_typecheck_store", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "recorded_fixture", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "main", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "phase_profile", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "pre_push", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "census_exclude_derive", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "derived_realization_schedule", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "expected_red_roster_join", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "memory_governor", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "std_lens_verdict", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "module_path_index", has_pub_mod: true, is_dir: true },
  SeedRetainedIntrinsicRegistration { basename: "v2_compiler_body_producer", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "v2_compiler_normalize", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "v2_compiler_target_carriers", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "v2_compiler_discovery_enumeration", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "v2_compiler_parse_engine_hooks", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "v2_compiler_use_site_verdict", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "required_regen_host", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "bootstrap_stage0_crate_layout_generated", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "cssl_seed_linked_closure_assembly", has_pub_mod: false, is_dir: false }
]

data data_initializer_identity_seed_retained_note: String = "SeedRetained hand-Rust for resolved data-initializer projection marshaling (decl_facts initializer identity lane, PR #7924). Reason: marshal requires InterpContext typechecked subjects, inferred Node stamps, and owning type-item lookup not yet modeled in .dag. Migration trigger: v2.std.data_initializer_identity projection carriers self-emit and coproduct_reflection routes through the modeled marshal surface; then this module deletes with its SeedRetainedIntrinsicRegistration row. Frontier row schema lacks reason/trigger fields — this note is the counted scaffold until the schema lands."

data seed_retained_support_dir_registrations: List<SeedRetainedSupportDirRegistration> = [
  SeedRetainedSupportDirRegistration { basename: "cli_run" }
]

data seed_retained_quarantine_scaffold_stage0_files_note: String = "Review 44472: six quarantine modules (SeedRetained, emitter_produced_baseline=0) retain emitted .rs on disk for wet re-flip — listed in HAND_MAINTAINED_STAGE0_FILES so crate layout authority matches filesystem. CORRECTED 2026-08-19: this row read \"without pub mod (has_pub_mod: false)\", which was true when written and is now false. Retaining a file on disk and declaring it in the crate are two decisions, and collapsing them cost the behavioral receipts their seed side — the shims import v1_compiler::v2_compiler_X, which no undeclared module can satisfy. The rows now carry has_pub_mod: true; the quarantine they describe is about emitter production, not about crate membership. Dissolve-on: witness-realization enables EmitterProduced and rows return to the generated roster."
// THE SEED SIDE OF EVERY BEHAVIORAL-EQUIVALENCE RECEIPT, and it was unlinkable. Each
// `dag/tools/self_host_*_shims/witness_main.rs` compares `v1_compiled::v2_compiler_X` (the emitted
// artifact under test) against `v1_compiler::v2_compiler_X` (the seed oracle) -- and the second
// path resolves only if the seed crate DECLARES that module. `v2_compiler_compile`,
// `v2_compiler_program_assembly` and `v2_compiler_source_authority` carried no registration in
// this authority at all, and six intrinsic `v2_compiler_*` rows above carried `has_pub_mod: false`,
// so nine seed oracles named by live shims were absent from lib.rs. A promotion receipt cannot go
// green, or red, against a seed it cannot link; that is specification-without-execution
// (DESIGN section 5) sitting one layer below the harness that was believed to be the blocker.
data seed_retained_scaffold_registrations: List<SeedRetainedScaffoldRegistration> = [
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_algebra" },
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_collection" },
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_node" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_resolve" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_program_partition" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_tokenize" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_infer" },
  SeedRetainedScaffoldRegistration { basename: "v1_interpreter_dispatch_generated" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_compile" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_program_assembly" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_source_authority" }
]

fn intrinsic_pub_mod_basename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.has_pub_mod {
    [row.basename]
  } else {
    []
  }
}

fn intrinsic_stage0_filename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    []
  } else {
    [concat(row.basename, ".rs")]
  }
}

fn intrinsic_stage0_dir_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    [row.basename]
  } else {
    []
  }
}

fn seed_retained_intrinsic_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_pub_mod_basename_from_row(row: row))
    }
  )
}

fn seed_retained_intrinsic_stage0_files() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_stage0_filename_from_row(row: row))
    }
  )
}

fn seed_retained_scaffold_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [row.basename])
    }
  )
}

fn seed_retained_scaffold_stage0_files() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [concat(row.basename, ".rs")])
    }
  )
}

fn seed_retained_support_stage0_dirs() -> List<String> {
  fold(
    seed_retained_support_dir_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [row.basename])
    }
  )
}

fn hand_maintained_stage0_dirs() -> List<String> {
  concat(
    fold(
      seed_retained_intrinsic_registrations,
      init: [],
      f: fn(acc, row) {
        concat(acc, intrinsic_stage0_dir_from_row(row: row))
      }
    ),
    seed_retained_support_stage0_dirs()
  )
}

fn basename_to_pub_mod_decl(basename: String) -> String {
  concat("pub mod ", basename, ";")
}

fn dispatch_generated_macro_use_pub_mod_decl() -> String {
  "#[macro_use]\npub mod v1_interpreter_dispatch_generated;"
}

fn pub_mod_decl_lines_for_basename(basename: String) -> List<String> {
  if basename == "v1_interpreter" {
  [
    dispatch_generated_macro_use_pub_mod_decl(),
    basename_to_pub_mod_decl(basename: basename),
  ]
  } else if basename == "v1_interpreter_dispatch_generated" {
    []
  } else {
    [basename_to_pub_mod_decl(basename: basename)]
  }
}

fn format_pub_mod_declarations(basenames: List<String>) -> String {
  let lines = basenames |> flat_map(basename => pub_mod_decl_lines_for_basename(basename: basename))
  concat("\n", lines |> join(separator: "\n"))
}

fn basename_to_stage0_filename(basename: String) -> String {
  concat(basename, ".rs")
}

fn basenames_to_stage0_filenames(basenames: List<String>) -> List<String> {
  basenames |> map(basename_to_stage0_filename)
}

data stage0_crate_layout_arity_note: String = "These three keep their zero-arity shape deliberately. Their caller is generated_artifact_emit.dag's ~18-variant dispatch, one match whose every arm is a zero-arg generator returning String; giving them a parameter would force seventeen unrelated generators to accept an argument they cannot use. Changing their arity broke this lane once: dag/gunbc and dag/test/claim callers compile CLEAN at a stale arity because .dag does not arity-check these cross-module sites, so the breakage surfaces only at run time."

fn hand_maintained_pub_mod_basenames() -> List<String> {
  concat(seed_retained_intrinsic_pub_mod_basenames(), seed_retained_scaffold_pub_mod_basenames())
}

fn emit_hand_maintained_pub_mod_block() -> String {
  format_pub_mod_declarations(basenames: hand_maintained_pub_mod_basenames())
}

fn hand_maintained_stage0_filenames() -> List<String> {
  concat(seed_retained_intrinsic_stage0_files(), seed_retained_scaffold_stage0_files())
}

// THE EXCLUSION LIST IS NAMED FOR ONE OF ITS THREE REASONS, and that conflation is what let the
// gap above stay invisible. `HAND_MAINTAINED_STAGE0_FILES` is consumed by `required_regen_host` as
// "the files the stage0 emit does not produce", and membership now has three distinct causes:
// hand-authored Rust with a migration trigger (the intrinsic rows), hand-retained seed oracles and
// pilots awaiting their flip (the scaffold rows), and one file generated by a DIFFERENT authority
// (`bootstrap_stage0_crate_layout_generated`, emitted by this module). Only the first is literally
// hand-maintained. The consequence is not cosmetic: because the consumer classifies by complement,
// the only way to learn that a row is missing is a refused regen run naming it, which is exactly
// how these were found -- and a reader checking whether a file "should be hand-maintained" asks a
// question the list cannot answer for two of its three populations.
//
// NOT FIXED HERE, deliberately. Splitting the reasons means a per-row typed cause and a renamed
// emitted constant, which is a change to what the regen host reads; landing it in the same diff
// that first gives regen a verdict would mean the verdict and its input population changed
// together, and neither could be attributed. Next step: one typed `Stage0ExclusionCause` per row,
// projected into the same constant, with the regen host reading the cause rather than the name.
data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
