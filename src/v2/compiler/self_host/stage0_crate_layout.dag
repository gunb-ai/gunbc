data data_initializer_identity_seed_retained_note: String = "SeedRetained hand-Rust for resolved data-initializer projection marshaling (decl_facts initializer identity lane, PR #7924). Reason: marshal requires InterpContext typechecked subjects, inferred Node stamps, and owning type-item lookup not yet modeled in .dag. Migration trigger: v2.std.data_initializer_identity projection carriers self-emit and coproduct_reflection routes through the modeled marshal surface; then this module deletes with its SeedRetainedIntrinsicRegistration row. Frontier row schema lacks reason/trigger fields — this note is the counted scaffold until the schema lands."

data bootstrap_stage0_crate_layout_generated_seed_retained_note: String = "bootstrap_stage0_crate_layout_generated.rs is itself a generated artifact (Stage0CrateLayoutGeneratedRsArtifact, regenerated by dag/tools/generated_artifact_gate.dag main_wet from THIS module), but it is generated by a different pipeline than v1's compile_stage0 self-emit that required_regen exercises — it is included via a #[path] mod in required_regen_host.rs, never a lib.rs pub mod. From required_regen's narrower vantage (fresh emit of the src/v1 import closure) it is therefore correctly excluded, has_pub_mod: false to match that it carries no lib.rs pub mod line."

data cssl_seed_linked_closure_assembly_seed_retained_note: String = "cssl_seed_linked_closure_assembly.rs (tools.self_host_curated_seed_linked_harness, 5-arm design) is genuine host-only Rust: it shells out to build curated seed-linked crates and assert compile/link behavior, filesystem and subprocess work the .dag emitter structurally cannot produce. Declared mod (not pub mod) from src/v1/stage0/src/bin/cssl_assemble.rs — has_pub_mod: false matches that it carries no lib.rs pub mod line. Not an emitter target; has no corresponding self-emit dissolution trigger beyond the harness's own 5-arm migration, tracked at its own module header."

data required_regen_host_seed_retained_note: String = "required_regen_host.rs is the host realization of v2.workflow.required_regen itself — the required-regen check's own implementation (git HEAD read, subprocess compile_stage0 invocation, filesystem diff/write of the committed vs candidate tree). It is structurally unavoidable host glue: the .dag substrate cannot invoke its own compiler as a subprocess and diff a filesystem tree against committed bytes without a host realization boundary (DESIGN.md S3, transport/realization is peripheral by construction). Declared mod (not pub mod) from cli_run.rs — has_pub_mod: false matches that it carries no lib.rs pub mod line. This row's absence (not the module's absence) was the row-1-adjacent gap: the module existed and was real, only its crate-layout registration was missing, which is why it appeared in committed_not_emitted rather than as a genuine surface bug."

data compiler_tests_seed_retained_note: String = "compiler_tests.rs (3072 lines) is hand-authored Rust: a `#[cfg(test)] mod compiler_tests { .. }` unit-test suite exercising v1 compiler internals (tokenize/parse) directly against .dag fixture source, with helper fns like workspace_root()/read_dag() that walk the filesystem to locate .dag sources at test time. It carries no 'Generated by v1 compiler' header and has no corresponding dotted .dag source module (v1.compiler.compiler_tests does not exist) — required_regen's fresh compile_stage0 emit therefore cannot and structurally should not produce it. Declared `mod compiler_tests;` (not pub mod, and cfg(test)-gated) in lib.rs — has_pub_mod: false matches that it carries no lib.rs pub mod line. Distinct from v1_compiler_compiler_tests_rust.rs, an actually .dag-generated module (source: v1.compiler.compiler_tests_rust) with a similarly-shaped name but unrelated content and purpose — the two must not be conflated. Surfaced as a genuine committed_not_emitted row only after #8518 fixed the population gate's prior vacuous-refusal bug; not part of an original miscount."

data seed_retained_support_dir_registrations: List<SeedRetainedSupportDirRegistration> = [
  SeedRetainedSupportDirRegistration { basename: "cli_run" }
]

data seed_retained_quarantine_scaffold_stage0_files_note: String = "Review 44472: six quarantine modules (SeedRetained, emitter_produced_baseline=0) retain emitted .rs on disk for wet re-flip without pub mod — listed in HAND_MAINTAINED_STAGE0_FILES (has_pub_mod: false) so crate layout authority matches filesystem. Dissolve-on: witness-realization enables EmitterProduced and rows return to generated pub mod roster."
data seed_retained_scaffold_registrations: List<SeedRetainedScaffoldRegistration> = [
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_algebra" },
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_collection" },
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_node" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_resolve" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_program_partition" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_tokenize" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_infer" },
  SeedRetainedScaffoldRegistration { basename: "v1_interpreter_dispatch_generated" }
]

data gate_a_flip_lane_seed_retained_note: String = "CORRECTED (2026-08-19, msg_6f205102): v2_compiler_compile.rs / v2_compiler_program_assembly.rs / v2_compiler_source_authority.rs (Wave 2 / Gate-A flip lane, PR #6812) are hand-retained Rust oracles mirroring their .dag data notes (required_lens_grain_note in src/v2/compiler/00_compile.dag, program_assembly_prepare_once_note in src/v2/compiler/program_assembly.dag, source_authority_module_note in src/v2/compiler/source_authority.dag) — independent of the self-emitted artifact under test. A prior revision of this note claimed they were 'exactly like their already-registered v2_compiler_resolve/program_partition/tokenize/infer siblings' and registered them as SeedRetainedScaffoldRegistration (implicit pub mod). That claim was measured false: grepping src/v1/stage0/src/lib.rs on origin/main shows the four true siblings each carry exactly one `pub mod <name>;` line (control: v1_interpreter also 1), while these three carry zero, and no #[path] wiring exists for them anywhere in the crate — they are standalone CSSL oracles compiled via tools.self_host_curated_seed_linked_harness, never wired into the crate's mod tree, matching cssl_seed_linked_closure_assembly and required_regen_host above rather than the wired siblings. Reclassified as SeedRetainedIntrinsicRegistration, has_pub_mod: false to match the measured lib.rs state. #6812's per-module dissolution triggers (sc_scaffold_dissolution_trigger / spa_scaffold_dissolution_trigger / ssa_scaffold_dissolution_trigger) still govern individual retirement; only the crate-layout registration shape was wrong, not the retention decision itself."

fn intrinsic_pub_mod_basename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.has_pub_mod {
    [row.basename]
  } else {
    []
  }
}

fn intrinsic_stage0_filename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    []
  } else {
    [concat(row.basename, ".rs")]
  }
}

fn intrinsic_stage0_dir_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    [row.basename]
  } else {
    []
  }
}

fn seed_retained_intrinsic_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_pub_mod_basename_from_row(row: row))
    }
  )
}

fn seed_retained_intrinsic_stage0_files() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_stage0_filename_from_row(row: row))
    }
  )
}

fn seed_retained_scaffold_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [row.basename])
    }
  )
}

fn seed_retained_scaffold_stage0_files() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [concat(row.basename, ".rs")])
    }
  )
}

fn seed_retained_support_stage0_dirs() -> List<String> {
  fold(
    seed_retained_support_dir_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [row.basename])
    }
  )
}

fn hand_maintained_stage0_dirs() -> List<String> {
  concat(
    fold(
      seed_retained_intrinsic_registrations,
      init: [],
      f: fn(acc, row) {
        concat(acc, intrinsic_stage0_dir_from_row(row: row))
      }
    ),
    seed_retained_support_stage0_dirs()
  )
}

fn basename_to_pub_mod_decl(basename: String) -> String {
  concat("pub mod ", basename, ";")
}

fn dispatch_generated_macro_use_pub_mod_decl() -> String {
  "#[macro_use]\npub mod v1_interpreter_dispatch_generated;"
}

fn pub_mod_decl_lines_for_basename(basename: String) -> List<String> {
  if basename == "v1_interpreter" {
  [
    dispatch_generated_macro_use_pub_mod_decl(),
    basename_to_pub_mod_decl(basename: basename),
  ]
  } else if basename == "v1_interpreter_dispatch_generated" {
    []
  } else {
    [basename_to_pub_mod_decl(basename: basename)]
  }
}

fn format_pub_mod_declarations(basenames: List<String>) -> String {
  let lines = basenames |> flat_map(basename => pub_mod_decl_lines_for_basename(basename: basename))
  concat("\n", lines |> join(separator: "\n"))
}

fn basename_to_stage0_filename(basename: String) -> String {
  concat(basename, ".rs")
}

fn basenames_to_stage0_filenames(basenames: List<String>) -> List<String> {
  basenames |> map(basename_to_stage0_filename)
}

data stage0_crate_layout_arity_note: String = "These three keep their zero-arity shape deliberately. Their caller is generated_artifact_emit.dag's ~18-variant dispatch, one match whose every arm is a zero-arg generator returning String; giving them a parameter would force seventeen unrelated generators to accept an argument they cannot use. Changing their arity broke this lane once: dag/gunbc and dag/test/claim callers compile CLEAN at a stale arity because .dag does not arity-check these cross-module sites, so the breakage surfaces only at run time."

fn hand_maintained_pub_mod_basenames() -> List<String> {
  concat(seed_retained_intrinsic_pub_mod_basenames(), seed_retained_scaffold_pub_mod_basenames())
}

fn emit_hand_maintained_pub_mod_block() -> String {
  format_pub_mod_declarations(basenames: hand_maintained_pub_mod_basenames())
}

fn hand_maintained_stage0_filenames() -> List<String> {
  concat(seed_retained_intrinsic_stage0_files(), seed_retained_scaffold_stage0_files())
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
