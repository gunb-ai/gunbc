module v2.compiler.self_host.candidate_generation


type StageEmissionCandidate {
  emitted: Node
}

type RustEmissionCandidate {
  source: extdeps.communication.medium.Medium<String>
  emitted: Node
}

type ProvenancedRustArtifact {
  source: extdeps.communication.medium.Medium<String>
  emitted: Node
  producer_receipt: v2.compiler.self_host.emitter_producer_provenance.ProducerEmissionReceipt
}

type RustWorkspaceWriteReceipt {
  workspace_dir: String
  manifest_path: String
  main_rs_path: String
  manifest_write_ok: Bool
  main_write_ok: Bool
}

type WrittenProvenancedRustArtifact {
  artifact: ProvenancedRustArtifact
  write: RustWorkspaceWriteReceipt
}

data candidate_generation_serialize_target_note: String = "Lane B direct v2 Rust door: generate_rust_emission_candidate wires serialize_target composed with translate (v2.compiler.emit); mint_written_provenanced_rust_artifact writes Cargo.toml and src/main.rs through Filesystem.Write so ingest-assemble-infer-translate-serialize-write is one candidate_generation surface."

data direct_rust_door_scaffold_build_cause: v2.std.node.Symbol = ^direct_rust_door_scaffold_build

data direct_rust_door_awaiting_cargo_cause: v2.std.node.Symbol = ^direct_rust_door_awaiting_cargo

data direct_rust_door_behavioral_probe_note: String = "The direct-door receipt binds NO behavioral probe, and that is the observed fact rather than a gap left open. The door's production path is ingest -> assemble -> infer -> emit: it never compiles the emitted Rust, never runs it, and never compares behavior against the seed, so no witness in this repository stands as its behavioral probe. Two entries were pointed at these fields historically; the most recent was the acceptance group root, which folds source fidelity, producer identity, seed-emitter absence, qualification and missing-rule refusal and executes none of the three behavioral steps. Naming it here would have made the receipt's own self-description the first false claim in a chain that ProducerEmissionExecutedGreenReceipt matching and the BehavioralEquivalent advance later consume. Binding returns when the write -> Cargo -> behavior seam exists, which is the successor lane and is blocked behind the door reaching ArtifactProduced at all."

data direct_rust_door_cargo_toml_scaffold_note: String = "SCAFFOLD: feature:medium_structure_containment — direct_rust_door_cargo_toml is a hand-authored TOML medium piped into Filesystem.Write without grammar-emitted Cargo.toml serialization (transport-is-a-handler debt). dissolve-on: emit the fixture workspace manifest through the target-model / serialize_target path (or a cited Toml medium carrier) so write_rust_workspace stops writing a raw string literal; this note and direct_rust_door_cargo_toml delete together."

data direct_rust_door_cargo_toml: String = "[package]\nname = \"direct_rust_door_fixture\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[lib]\npath = \"src/lib.rs\""

fn generate_stage_candidate_from_ingest(
  ingest: v2.compiler.source_authority.SourceRootIngest,
  admission: v2.compiler.name_resolve.Admission,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<StageEmissionCandidate> {
  let lm = dag_language_model()
  bind_outcome(
    o: assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm),
    f: fn(resolved) {
      bind_outcome(
        o: infer(tree: resolved),
        f: fn(inferred) {
          bind_outcome(
            o: translate(tree: inferred, target: target),
            f: fn(emitted) {
              outcome_accepted(
                value: StageEmissionCandidate { emitted: emitted }
              )
            }
          )
        }
      )
    }
  )
}

fn generate_translate_self_emit_candidate(
  resolved_module: Node,
  dag_target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<StageEmissionCandidate> {
  bind_outcome(
    o: infer(tree: resolved_module),
    f: fn(inferred) {
      bind_outcome(
        o: translate(tree: inferred, target: dag_target),
        f: fn(emitted) {
          outcome_accepted(
            value: StageEmissionCandidate { emitted: emitted }
          )
        }
      )
    }
  )
}

fn generate_rust_emission_candidate(
  inferred: v2.compiler.infer.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<RustEmissionCandidate> {
  bind_outcome(
    o: v2.compiler.emit.emit(tree: inferred, target: target),
    f: fn(source) {
      outcome_accepted(
        value: RustEmissionCandidate {
          source: source,
          emitted: inferred.root
        }
      )
    }
  )
}

fn write_rust_workspace(
  workspace_dir: String,
  source: extdeps.communication.medium.Medium<String>
) -> RustWorkspaceWriteReceipt {
  let manifest_path = concat(workspace_dir, "/Cargo.toml")
  let main_rs_path = concat(workspace_dir, "/src/lib.rs")
  let manifest = Filesystem.Write(path: manifest_path, content: direct_rust_door_cargo_toml)
  let main_rs = Filesystem.Write(path: main_rs_path, content: source.carried)
  RustWorkspaceWriteReceipt {
    workspace_dir: workspace_dir,
    manifest_path: manifest_path,
    main_rs_path: main_rs_path,
    manifest_write_ok: manifest.success,
    main_write_ok: main_rs.success
  }
}

fn mint_artifact_from_rust_emission_candidate(
  candidate: RustEmissionCandidate,
  module_path: String
) -> v2.std.diagnostic.Outcome<ProvenancedRustArtifact> {
  let realized_closure = realized_closure_for_v2_direct_rust_door_emit_run()
  match mint_producer_emission_receipt(
    module_path: module_path,
    producer: V2EmitterInterpreted,
    qualifications: source_produced_qualifications,
    build_result: v2.compiler.self_host.emitter_producer_provenance.BuildRefused { cause: direct_rust_door_awaiting_cargo_cause },
    behavioral_probe: BehavioralProbeUnbound,
    realized_closure: realized_closure
  ) {
    Present { value: receipt } =>
      outcome_accepted(
        value: ProvenancedRustArtifact {
          source: candidate.source,
          emitted: candidate.emitted,
          producer_receipt: receipt
        }
      )
    Absent =>
      outcome_rejected(
        d: v2.std.diagnostic.Diagnostic {
          reason: ^direct_rust_door_producer_receipt_refused,
          at: port_locus(port: ^candidate_generation),
          correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
        }
      )
  }
}

fn mint_provenanced_rust_artifact(
  inferred: v2.compiler.infer.InferredTree,
  target: v2.std.compilers.target_model.TargetModel,
  module_path: String
) -> v2.std.diagnostic.Outcome<ProvenancedRustArtifact> {
  bind_outcome(
    o: generate_rust_emission_candidate(inferred: inferred, target: target),
    f: fn(candidate) {
      mint_artifact_from_rust_emission_candidate(
        candidate: candidate,
        module_path: module_path
      )
    }
  )
}

fn mint_written_provenanced_rust_artifact(
  inferred: v2.compiler.infer.InferredTree,
  target: v2.std.compilers.target_model.TargetModel,
  module_path: String,
  workspace_dir: String
) -> v2.std.diagnostic.Outcome<WrittenProvenancedRustArtifact> {
  bind_outcome(
    o: mint_provenanced_rust_artifact(
      inferred: inferred,
      target: target,
      module_path: module_path
    ),
    f: fn(artifact) {
      outcome_accepted(
        value: WrittenProvenancedRustArtifact {
          artifact: artifact,
          write: write_rust_workspace(
            workspace_dir: workspace_dir,
            source: artifact.source
          )
        }
      )
    }
  )
}

data provenanced_rust_emission_observation_note: String = "STAGE-LOCATED production observation for the ingest-path Rust door. Replaces the Outcome-only surface whose Rejected arm erased WHICH stage refused: assembly, inference, emission (translate composed with serialize_target, observed as one production seam because v2.compiler.emit is one composition and splitting it here would fork that composition), or producer-receipt mint. generate_provenanced_rust_candidate_from_ingest is now a PROJECTION of this observation, not a second traversal — the pipeline is walked exactly once per call and every existing caller keeps its Outcome shape."

type ProvenancedRustEmissionObservation
  = AssemblyRejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }
  | InferenceRejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }
  | EmissionRejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }
  | ProducerReceiptRejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }
  | ArtifactProduced { artifact: ProvenancedRustArtifact }

fn observe_provenanced_rust_emission_from_ingest(
  ingest: v2.compiler.source_authority.SourceRootIngest,
  admission: v2.compiler.name_resolve.Admission,
  target: v2.std.compilers.target_model.TargetModel,
  module_path: String
) -> ProvenancedRustEmissionObservation {
  let lm = dag_language_model()
  match assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm) {
    v2.std.diagnostic.Rejected { diagnostics: d } => AssemblyRejected { diagnostics: d }
    v2.std.diagnostic.Accepted { value: resolved, diagnostics: _ } =>
      match infer(tree: resolved) {
        v2.std.diagnostic.Rejected { diagnostics: d } => InferenceRejected { diagnostics: d }
        v2.std.diagnostic.Accepted { value: inferred, diagnostics: _ } =>
          match generate_rust_emission_candidate(inferred: inferred, target: target) {
            v2.std.diagnostic.Rejected { diagnostics: d } => EmissionRejected { diagnostics: d }
            v2.std.diagnostic.Accepted { value: candidate, diagnostics: _ } =>
              match mint_artifact_from_rust_emission_candidate(
                candidate: candidate,
                module_path: module_path
              ) {
                v2.std.diagnostic.Rejected { diagnostics: d } => ProducerReceiptRejected { diagnostics: d }
                v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
                  ArtifactProduced { artifact: artifact }
              }
          }
      }
  }
}

fn provenanced_rust_emission_observation_outcome(
  observation: ProvenancedRustEmissionObservation
) -> v2.std.diagnostic.Outcome<ProvenancedRustArtifact> {
  match observation {
    AssemblyRejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    InferenceRejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    EmissionRejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    ProducerReceiptRejected { diagnostics: d } => v2.std.diagnostic.Rejected { diagnostics: d }
    ArtifactProduced { artifact: a } => outcome_accepted(value: a)
  }
}

fn generate_provenanced_rust_candidate_from_ingest(
  ingest: v2.compiler.source_authority.SourceRootIngest,
  admission: v2.compiler.name_resolve.Admission,
  target: v2.std.compilers.target_model.TargetModel,
  module_path: String
) -> v2.std.diagnostic.Outcome<ProvenancedRustArtifact> {
  provenanced_rust_emission_observation_outcome(
    observation: observe_provenanced_rust_emission_from_ingest(
      ingest: ingest,
      admission: admission,
      target: target,
      module_path: module_path
    )
  )
}

fn advance_written_provenanced_rust_artifact_cargo_green(
  written: WrittenProvenancedRustArtifact,
  cargo_green: Bool
) -> Optional<WrittenProvenancedRustArtifact> {
  match advance_producer_emission_receipt_cargo_green(
    prior: written.artifact.producer_receipt,
    cargo_green: cargo_green
  ) {
    Present { value: receipt } =>
      optional_present(
        value: WrittenProvenancedRustArtifact {
          artifact: ProvenancedRustArtifact {
            source: written.artifact.source,
            emitted: written.artifact.emitted,
            producer_receipt: receipt
          },
          write: written.write
        }
      )
    Absent => optional_absent()
  }
}

fn generate_written_rust_candidate_from_ingest(
  ingest: v2.compiler.source_authority.SourceRootIngest,
  admission: v2.compiler.name_resolve.Admission,
  target: v2.std.compilers.target_model.TargetModel,
  module_path: String,
  workspace_dir: String
) -> v2.std.diagnostic.Outcome<WrittenProvenancedRustArtifact> {
  let lm = dag_language_model()
  bind_outcome(
    o: assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm),
    f: fn(resolved) {
      bind_outcome(
        o: infer(tree: resolved),
        f: fn(inferred) {
          mint_written_provenanced_rust_artifact(
            inferred: inferred,
            target: target,
            module_path: module_path,
            workspace_dir: workspace_dir
          )
        }
      )
    }
  )
}

data provenanced_rust_artifact_conjunct_split_note: String = "provenanced_rust_artifact_seed_independent is a CONJUNCTION of two independent facts, and fusing them made one of them unreportable: a wrong producer fails the conjunction and was named SeedEmitterReachable, citing a cause that did not hold. The two conjuncts are now separately readable, so each consumer names the fact that actually failed. The conjunction survives for callers that genuinely want both (mint admission, written-artifact ok), never as the only way to ask."

fn provenanced_rust_artifact_producer_is_v2_interpreted(
  artifact: ProvenancedRustArtifact
) -> Bool {
  artifact.producer_receipt.producer == V2EmitterInterpreted
}

fn provenanced_rust_artifact_seed_emitter_unreachable(
  artifact: ProvenancedRustArtifact
) -> Bool {
  !seed_emit_rust_reachable(closure: artifact.producer_receipt.realized_closure)
}

fn provenanced_rust_artifact_seed_independent(
  artifact: ProvenancedRustArtifact
) -> Bool {
  provenanced_rust_artifact_producer_is_v2_interpreted(artifact: artifact)
    && provenanced_rust_artifact_seed_emitter_unreachable(artifact: artifact)
}

fn written_provenanced_rust_artifact_ok(
  written: WrittenProvenancedRustArtifact
) -> Bool {
  written.write.manifest_write_ok && written.write.main_write_ok
    && provenanced_rust_artifact_seed_independent(artifact: written.artifact)
}
