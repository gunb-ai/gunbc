module v2.compiler.self_host.candidate_generation

import extdeps.communication.medium { Medium }
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.compiler.emit { emit }
import v2.compiler.infer { infer, InferredTree }
import v2.compiler.name_resolve { Admission }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.self_host.emitter_producer_provenance {
  advance_producer_emission_receipt_cargo_green,
  BehavioralProbeUnbound,
  mint_producer_emission_receipt,
  ProducerEmissionReceipt,
  realized_closure_for_v2_direct_rust_door_emit_run,
  seed_emit_rust_reachable,
  source_produced_qualifications,
  V2EmitterInterpreted,
  BuildRefused
}
import v2.compiler.source_authority { SourceRootIngest }
import v2.compiler.translate { translate }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  outcome_accepted,
  outcome_rejected,
  invariant_port_locus
}
import v2.std.node { Node, Symbol }
import v2.std.optional { Absent, Present, optional_absent, optional_present }
import v2.std.text { String }

type StageEmissionCandidate {
  emitted: Node
}

type RustEmissionCandidate {
  source: Medium<String>
  emitted: Node
}

type ProvenancedRustArtifact {
  source: Medium<String>
  emitted: Node
  producer_receipt: ProducerEmissionReceipt
}

type RustWorkspaceWriteReceipt {
  workspace_dir: String
  manifest_path: String
  main_rs_path: String
  manifest_write_ok: Bool
  main_write_ok: Bool
}

type WrittenProvenancedRustArtifact {
  artifact: ProvenancedRustArtifact
  write: RustWorkspaceWriteReceipt
}

// Lane B direct v2 Rust door: generate_rust_emission_candidate wires serialize_target composed with
// translate (v2.compiler.emit); mint_written_provenanced_rust_artifact writes Cargo.toml and
// src/main.rs through Filesystem.Write so ingest-assemble-infer-translate-serialize-write is one
// candidate_generation surface.

data direct_rust_door_scaffold_build_cause: Symbol = ^direct_rust_door_scaffold_build

data direct_rust_door_awaiting_cargo_cause: Symbol = ^direct_rust_door_awaiting_cargo

// The direct-door receipt binds NO behavioral probe — the observed fact, not a gap left open. The
// door's production path is ingest -> assemble -> infer -> emit: it never compiles the emitted
// Rust, runs it, or compares behavior against the seed, so no witness here stands as its behavioral
// probe. Two entries were pointed at these fields historically; the most recent was the acceptance
// group root, which folds source fidelity, producer identity, seed-emitter absence, qualification
// and missing-rule refusal and executes none of the three behavioral steps. Naming it would have
// made the receipt's self-description the first false claim in a chain that
// ProducerEmissionExecutedGreenReceipt matching and the BehavioralEquivalent advance later consume.
// Binding returns when the write -> Cargo -> behavior seam exists — the successor lane, blocked
// behind the door reaching ArtifactProduced at all.

// SCAFFOLD: direct_rust_door_cargo_toml is a hand-authored TOML medium piped into
// Filesystem.Write without grammar-emitted Cargo.toml serialization (transport-is-a-handler debt).
// THE TRIGGER IS STATED AS A CAPABILITY BECAUSE ITS PREDECESSOR NAMED A DELETED MECHANISM. This
// note previously read `feature:medium_structure_containment`, and that lens was deleted in #6831 --
// recorded by v2.std.compilers.target_model target_text_carrier_scaffold_note and by
// gunbc.plans.self_applying_lenses, neither of which any trigger citing it could see. A trigger
// retired by a mechanism that no longer exists is retired by nothing, which is the class filed as
// gunbc.recurring_failure_mode.dissolution_trigger_cites_a_mechanism_that_is_later_deleted.
// dissolve-on, at capability grain: a Cargo manifest AUTHORITY that produces this manifest
// structurally -- a TOML medium model serialized through the target-model / serialize_target path --
// so write_rust_workspace stops writing a raw string literal. THAT AUTHORITY DOES NOT EXIST TODAY,
// measured 2026-09-05: there is no TOML model under extdeps/formats or extdeps/languages, and every
// Cargo.toml this repository produces is string concatenation. So this is a stall whose next-rung
// trigger is an absent capability, not a scheduled edit; this note and direct_rust_door_cargo_toml
// delete together when it lands.

data direct_rust_door_cargo_toml: String = "[package]\nname = \"direct_rust_door_fixture\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[lib]\npath = \"src/lib.rs\""

fn generate_stage_candidate_from_ingest(
  ingest: SourceRootIngest,
  admission: Admission,
  target: TargetModel
) -> Outcome<StageEmissionCandidate> {
  let lm = dag_language_model()
  bind_outcome(
    o: assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm),
    f: fn(resolved) {
      bind_outcome(
        o: infer(tree: resolved),
        f: fn(inferred) {
          bind_outcome(
            o: translate(tree: inferred, target: target),
            f: fn(emitted) {
              outcome_accepted(
                value: StageEmissionCandidate { emitted: emitted }
              )
            }
          )
        }
      )
    }
  )
}

fn generate_translate_self_emit_candidate(
  resolved_module: Node,
  dag_target: TargetModel
) -> Outcome<StageEmissionCandidate> {
  bind_outcome(
    o: infer(tree: resolved_module),
    f: fn(inferred) {
      bind_outcome(
        o: translate(tree: inferred, target: dag_target),
        f: fn(emitted) {
          outcome_accepted(
            value: StageEmissionCandidate { emitted: emitted }
          )
        }
      )
    }
  )
}

fn generate_rust_emission_candidate(
  inferred: InferredTree,
  target: TargetModel
) -> Outcome<RustEmissionCandidate> {
  bind_outcome(
    o: emit(tree: inferred, target: target),
    f: fn(source) {
      outcome_accepted(
        value: RustEmissionCandidate {
          source: source,
          emitted: inferred.root
        }
      )
    }
  )
}

fn write_rust_workspace(
  workspace_dir: String,
  source: Medium<String>
) -> RustWorkspaceWriteReceipt {
  let manifest_path = concat(workspace_dir, "/Cargo.toml")
  let main_rs_path = concat(workspace_dir, "/src/lib.rs")
  let manifest = Filesystem.Write(path: manifest_path, content: direct_rust_door_cargo_toml)
  let main_rs = Filesystem.Write(path: main_rs_path, content: source.carried)
  RustWorkspaceWriteReceipt {
    workspace_dir: workspace_dir,
    manifest_path: manifest_path,
    main_rs_path: main_rs_path,
    manifest_write_ok: manifest.success,
    main_write_ok: main_rs.success
  }
}

fn mint_artifact_from_rust_emission_candidate(
  candidate: RustEmissionCandidate,
  module_path: String
) -> Outcome<ProvenancedRustArtifact> {
  let realized_closure = realized_closure_for_v2_direct_rust_door_emit_run()
  match mint_producer_emission_receipt(
    module_path: module_path,
    producer: V2EmitterInterpreted,
    qualifications: source_produced_qualifications,
    build_result: BuildRefused { cause: direct_rust_door_awaiting_cargo_cause },
    behavioral_probe: BehavioralProbeUnbound,
    realized_closure: realized_closure
  ) {
    Present { value: receipt } =>
      outcome_accepted(
        value: ProvenancedRustArtifact {
          source: candidate.source,
          emitted: candidate.emitted,
          producer_receipt: receipt
        }
      )
    Absent =>
      outcome_rejected(
        d: Diagnostic {
          reason: ^direct_rust_door_producer_receipt_refused,
          at: invariant_port_locus(port: ^candidate_generation, invariant: ^direct_rust_door_producer_receipt_refused),
          correction: Unavailable { reason: ExternalContractUnknown }
        }
      )
  }
}

fn mint_provenanced_rust_artifact(
  inferred: InferredTree,
  target: TargetModel,
  module_path: String
) -> Outcome<ProvenancedRustArtifact> {
  bind_outcome(
    o: generate_rust_emission_candidate(inferred: inferred, target: target),
    f: fn(candidate) {
      mint_artifact_from_rust_emission_candidate(
        candidate: candidate,
        module_path: module_path
      )
    }
  )
}

fn mint_written_provenanced_rust_artifact(
  inferred: InferredTree,
  target: TargetModel,
  module_path: String,
  workspace_dir: String
) -> Outcome<WrittenProvenancedRustArtifact> {
  bind_outcome(
    o: mint_provenanced_rust_artifact(
      inferred: inferred,
      target: target,
      module_path: module_path
    ),
    f: fn(artifact) {
      outcome_accepted(
        value: WrittenProvenancedRustArtifact {
          artifact: artifact,
          write: write_rust_workspace(
            workspace_dir: workspace_dir,
            source: artifact.source
          )
        }
      )
    }
  )
}

// STAGE-LOCATED production observation for the ingest-path Rust door. Replaces the Outcome-only
// surface whose Rejected arm erased WHICH stage refused: assembly, inference, emission (translate
// composed with serialize_target, observed as one production seam because v2.compiler.emit is one
// composition and splitting it here would fork it), or producer-receipt mint.
// generate_provenanced_rust_candidate_from_ingest is now a PROJECTION of this observation, not a
// second traversal — the pipeline is walked once per call and every existing caller keeps its
// Outcome shape.

type ProvenancedRustEmissionObservation
  = AssemblyRejected { diagnostics: NonEmptyDiagnostics }
  | InferenceRejected { diagnostics: NonEmptyDiagnostics }
  | EmissionRejected { diagnostics: NonEmptyDiagnostics }
  | ProducerReceiptRejected { diagnostics: NonEmptyDiagnostics }
  | ArtifactProduced { artifact: ProvenancedRustArtifact }

fn observe_provenanced_rust_emission_from_ingest(
  ingest: SourceRootIngest,
  admission: Admission,
  target: TargetModel,
  module_path: String
) -> ProvenancedRustEmissionObservation {
  let lm = dag_language_model()
  match assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm) {
    Rejected { diagnostics: d } => AssemblyRejected { diagnostics: d }
    Accepted { value: resolved, diagnostics: _ } =>
      match infer(tree: resolved) {
        Rejected { diagnostics: d } => InferenceRejected { diagnostics: d }
        Accepted { value: inferred, diagnostics: _ } =>
          match generate_rust_emission_candidate(inferred: inferred, target: target) {
            Rejected { diagnostics: d } => EmissionRejected { diagnostics: d }
            Accepted { value: candidate, diagnostics: _ } =>
              match mint_artifact_from_rust_emission_candidate(
                candidate: candidate,
                module_path: module_path
              ) {
                Rejected { diagnostics: d } => ProducerReceiptRejected { diagnostics: d }
                Accepted { value: artifact, diagnostics: _ } =>
                  ArtifactProduced { artifact: artifact }
              }
          }
      }
  }
}

fn provenanced_rust_emission_observation_outcome(
  observation: ProvenancedRustEmissionObservation
) -> Outcome<ProvenancedRustArtifact> {
  match observation {
    AssemblyRejected { diagnostics: d } => Rejected { diagnostics: d }
    InferenceRejected { diagnostics: d } => Rejected { diagnostics: d }
    EmissionRejected { diagnostics: d } => Rejected { diagnostics: d }
    ProducerReceiptRejected { diagnostics: d } => Rejected { diagnostics: d }
    ArtifactProduced { artifact: a } => outcome_accepted(value: a)
  }
}

fn generate_provenanced_rust_candidate_from_ingest(
  ingest: SourceRootIngest,
  admission: Admission,
  target: TargetModel,
  module_path: String
) -> Outcome<ProvenancedRustArtifact> {
  provenanced_rust_emission_observation_outcome(
    observation: observe_provenanced_rust_emission_from_ingest(
      ingest: ingest,
      admission: admission,
      target: target,
      module_path: module_path
    )
  )
}

fn advance_written_provenanced_rust_artifact_cargo_green(
  written: WrittenProvenancedRustArtifact,
  cargo_green: Bool
) -> Optional<WrittenProvenancedRustArtifact> {
  match advance_producer_emission_receipt_cargo_green(
    prior: written.artifact.producer_receipt,
    cargo_green: cargo_green
  ) {
    Present { value: receipt } =>
      optional_present(
        value: WrittenProvenancedRustArtifact {
          artifact: ProvenancedRustArtifact {
            source: written.artifact.source,
            emitted: written.artifact.emitted,
            producer_receipt: receipt
          },
          write: written.write
        }
      )
    Absent => optional_absent()
  }
}

fn generate_written_rust_candidate_from_ingest(
  ingest: SourceRootIngest,
  admission: Admission,
  target: TargetModel,
  module_path: String,
  workspace_dir: String
) -> Outcome<WrittenProvenancedRustArtifact> {
  let lm = dag_language_model()
  bind_outcome(
    o: assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm),
    f: fn(resolved) {
      bind_outcome(
        o: infer(tree: resolved),
        f: fn(inferred) {
          mint_written_provenanced_rust_artifact(
            inferred: inferred,
            target: target,
            module_path: module_path,
            workspace_dir: workspace_dir
          )
        }
      )
    }
  )
}

// provenanced_rust_artifact_seed_independent is a CONJUNCTION of two independent facts, and fusing
// them made one unreportable: a wrong producer failed the conjunction and was named
// SeedEmitterReachable, a cause that did not hold. The two conjuncts are now separately readable,
// so each consumer names the fact that actually failed. The conjunction survives for callers that
// want both (mint admission, written-artifact ok), never as the only way to ask.

fn provenanced_rust_artifact_producer_is_v2_interpreted(
  artifact: ProvenancedRustArtifact
) -> Bool {
  artifact.producer_receipt.producer == V2EmitterInterpreted
}

fn provenanced_rust_artifact_seed_emitter_unreachable(
  artifact: ProvenancedRustArtifact
) -> Bool {
  !seed_emit_rust_reachable(closure: artifact.producer_receipt.realized_closure)
}

fn provenanced_rust_artifact_seed_independent(
  artifact: ProvenancedRustArtifact
) -> Bool {
  provenanced_rust_artifact_producer_is_v2_interpreted(artifact: artifact)
    && provenanced_rust_artifact_seed_emitter_unreachable(artifact: artifact)
}

fn written_provenanced_rust_artifact_ok(
  written: WrittenProvenancedRustArtifact
) -> Bool {
  written.write.manifest_write_ok && written.write.main_write_ok
    && provenanced_rust_artifact_seed_independent(artifact: written.artifact)
}
