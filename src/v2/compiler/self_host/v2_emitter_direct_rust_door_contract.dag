module v2.compiler.self_host.v2_emitter_direct_rust_door_contract

import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
  ProvenancedRustArtifact,
  ProvenancedRustEmissionObservation,
  observe_provenanced_rust_emission_from_ingest,
  provenanced_rust_artifact_seed_independent
}
import v2.compiler.self_host.direct_rust_door_fixture {
  direct_rust_door_admission,
  direct_rust_door_expected_source,
  direct_rust_door_ingest,
  direct_rust_door_module_path,
  direct_rust_door_target_model
}
import v2.compiler.self_host.emitter_producer_provenance {
  emission_qualifications_list_contains,
  SourceProduced
}
import v2.compiler.translate {
  target_serialize_source_from_model,
  translate_diagnostic_reason_from_symbol,
  TargetBundleMalformed,
}
import v2.extdeps.languages.rust {
  rust_fixture_emitted_add_fn,
  rust_fn_add_lex,
}
import v2.std.algebra { any }
import v2.std.collection { empty_map, List }
import v2.std.compilers.target_model {
  TargetModel,
  target_model_emit_transforms_empty,
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node {
  Conj,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode,
}
import v2.std.optional { Absent, Present }
import v2.std.text { String }

data v2_emitter_direct_rust_door_contract_note: String = "THE CLOSING CONDITION for roadmap node v2-emitter-direct-rust-door. MissingTranslationRuleRefuses: a deliberately incomplete Rust TargetModel must refuse through target_serialize_source_from_model with TargetBundleMalformed rather than accepting guessed source — it is the one direct-door leaf OBSERVED independently of the production emission walk. The former second capability, WrittenSourceIndependentOfSeedEmitter, is DELETED with its fold: it named a single admission whose refusal arm answered for both a rejected pipeline and a seed-dependent artifact, and the fact it tried to carry is now the declared-producer-closure leaf projected from ProvenancedRustEmissionObservation, where a stop before the artifact reports LeafNotReached with its stage instead of a refusal."

data v2_emitter_direct_rust_door_contract_dissolution_note: String = "DISSOLVES BY GREENING, never deletion. When candidate_generation wires serialize_target and the seed-independent written-source check executes green, the unchanged closing witness greens; its QuarantineProbeExpectRed exclusion and known-red roster entry delete in the same change, promoting it to ordinary discovery as the permanent direct-rust-door regression wall."

data direct_rust_door_emitted_root: Node = rust_fixture_emitted_add_fn

data direct_rust_door_missing_rules_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence,
}

data direct_rust_door_missing_rules_target: TargetModel = TargetModel {
  bundle: direct_rust_door_missing_rules_bundle,
  lex: rust_fn_add_lex(),
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured,
}

type DirectRustDoorScenarioFailure
  = MissingRuleAcceptedDespiteGap
  | MissingRuleWrongDiagnostic
  | MissingRuleDiagnosticAbsent

type DirectRustDoorAdmission
  = DirectRustDoorEstablished
  | DirectRustDoorRefused {
      failure: DirectRustDoorScenarioFailure,
    }
  | DirectRustDoorUnavailable {
      trigger: String,
    }

fn refused(failure: DirectRustDoorScenarioFailure) -> DirectRustDoorAdmission {
  DirectRustDoorRefused { failure: failure }
}

fn assess_missing_translation_rule_refuses() -> DirectRustDoorAdmission {
  match target_serialize_source_from_model(
    target: direct_rust_door_missing_rules_target,
    emitted: direct_rust_door_emitted_root,
  ) {
    Accepted { value: _, diagnostics: _ } =>
      refused(failure: MissingRuleAcceptedDespiteGap)
    Rejected { diagnostics: r } =>
      match translate_diagnostic_reason_from_symbol(sym: r.head.reason) {
        Present { value: TargetBundleMalformed } => DirectRustDoorEstablished
        Present { value: _ } => refused(failure: MissingRuleWrongDiagnostic)
        Absent => refused(failure: MissingRuleDiagnosticAbsent)
      }
  }
}

data direct_rust_door_production_group_note: String = "THE CANONICAL ACCEPTANCE AUTHORITY for roadmap node v2-emitter-direct-rust-door, and the lane's first composition specimen. TWO independently OBSERVED facts are stored — the production emission observation and the independent missing-rule admission — and NOTHING derived is stored beside them: source fidelity, declared producer closure, and SourceProduced qualification are FUNCTIONS of the observation, so a group whose leaves contradict its observation is unconstructible rather than merely wrong. The expensive ingest-assemble-infer-emit walk happens EXACTLY ONCE per group value; every leaf and the higher-order expectation are pure projections that never re-walk it. A leaf production never reached reports LeafNotReached carrying the stage, never a false that would read as refuted. direct_rust_door_group_from_observations plants observations for the fast algebra controls, so the group algebra is discriminated WITHOUT paying a production walk."

data direct_rust_door_leaf_not_reached_assembly: Symbol = ^direct_rust_door_leaf_not_reached_assembly_rejected

data direct_rust_door_leaf_not_reached_inference: Symbol = ^direct_rust_door_leaf_not_reached_inference_rejected

data direct_rust_door_leaf_not_reached_emission: Symbol = ^direct_rust_door_leaf_not_reached_emission_rejected

data direct_rust_door_leaf_not_reached_receipt: Symbol = ^direct_rust_door_leaf_not_reached_producer_receipt_rejected

data direct_rust_door_source_mismatch_cause: Symbol = ^direct_rust_door_emitted_source_differs_from_expected

data direct_rust_door_declared_closure_seed_cause: Symbol = ^direct_rust_door_declared_producer_closure_contains_seed_emitter

data direct_rust_door_source_produced_missing_cause: Symbol = ^direct_rust_door_source_produced_qualification_missing

data direct_rust_door_missing_rule_refused_cause: Symbol = ^direct_rust_door_missing_rule_refusal_not_established

data direct_rust_door_missing_rule_unavailable_cause: Symbol = ^direct_rust_door_missing_rule_refusal_unavailable

type DirectRustDoorLeafResult
  = LeafEstablished
  | LeafRefused { cause: Symbol }
  | LeafNotReached { cause: Symbol }

type DirectRustDoorProductionGroup {
  emission: ProvenancedRustEmissionObservation
  missing_rule: DirectRustDoorAdmission
}

fn direct_rust_door_group_from_observations(
  emission: ProvenancedRustEmissionObservation,
  missing_rule: DirectRustDoorAdmission
) -> DirectRustDoorProductionGroup {
  DirectRustDoorProductionGroup { emission: emission, missing_rule: missing_rule }
}

fn direct_rust_door_production_group() -> DirectRustDoorProductionGroup {
  direct_rust_door_group_from_observations(
    emission: observe_provenanced_rust_emission_from_ingest(
      ingest: direct_rust_door_ingest(),
      admission: direct_rust_door_admission(),
      target: direct_rust_door_target_model(),
      module_path: direct_rust_door_module_path
    ),
    missing_rule: assess_missing_translation_rule_refuses()
  )
}

fn direct_rust_door_artifact_leaf(
  emission: ProvenancedRustEmissionObservation,
  holds: fn(ProvenancedRustArtifact) -> Bool,
  refusal_cause: Symbol
) -> DirectRustDoorLeafResult {
  match emission {
    ArtifactProduced { artifact: a } =>
      if holds(a) { LeafEstablished } else { LeafRefused { cause: refusal_cause } }
    AssemblyRejected { diagnostics: _ } =>
      LeafNotReached { cause: direct_rust_door_leaf_not_reached_assembly }
    InferenceRejected { diagnostics: _ } =>
      LeafNotReached { cause: direct_rust_door_leaf_not_reached_inference }
    EmissionRejected { diagnostics: _ } =>
      LeafNotReached { cause: direct_rust_door_leaf_not_reached_emission }
    ProducerReceiptRejected { diagnostics: _ } =>
      LeafNotReached { cause: direct_rust_door_leaf_not_reached_receipt }
  }
}

fn direct_rust_door_source_fidelity_leaf(
  group: DirectRustDoorProductionGroup
) -> DirectRustDoorLeafResult {
  direct_rust_door_artifact_leaf(
    emission: group.emission,
    holds: fn(a) { a.source.carried == direct_rust_door_expected_source },
    refusal_cause: direct_rust_door_source_mismatch_cause
  )
}

fn direct_rust_door_declared_producer_closure_leaf(
  group: DirectRustDoorProductionGroup
) -> DirectRustDoorLeafResult {
  direct_rust_door_artifact_leaf(
    emission: group.emission,
    holds: fn(a) { provenanced_rust_artifact_seed_independent(artifact: a) },
    refusal_cause: direct_rust_door_declared_closure_seed_cause
  )
}

fn direct_rust_door_source_produced_leaf(
  group: DirectRustDoorProductionGroup
) -> DirectRustDoorLeafResult {
  direct_rust_door_artifact_leaf(
    emission: group.emission,
    holds: fn(a) {
      emission_qualifications_list_contains(
        xs: a.producer_receipt.qualifications,
        wanted: SourceProduced
      )
    },
    refusal_cause: direct_rust_door_source_produced_missing_cause
  )
}

fn direct_rust_door_missing_rule_leaf(
  group: DirectRustDoorProductionGroup
) -> DirectRustDoorLeafResult {
  match group.missing_rule {
    DirectRustDoorEstablished => LeafEstablished
    DirectRustDoorRefused { failure: _ } =>
      LeafRefused { cause: direct_rust_door_missing_rule_refused_cause }
    DirectRustDoorUnavailable { trigger: _ } =>
      LeafNotReached { cause: direct_rust_door_missing_rule_unavailable_cause }
  }
}

fn direct_rust_door_group_leaves(
  group: DirectRustDoorProductionGroup
) -> List<DirectRustDoorLeafResult> {
  [
    direct_rust_door_source_fidelity_leaf(group: group),
    direct_rust_door_declared_producer_closure_leaf(group: group),
    direct_rust_door_source_produced_leaf(group: group),
    direct_rust_door_missing_rule_leaf(group: group),
  ]
}

fn direct_rust_door_production_group_holds(
  group: DirectRustDoorProductionGroup
) -> Bool {
  !(direct_rust_door_group_leaves(group: group)
    |> any(leaf => match leaf {
      LeafEstablished => false
      LeafRefused { cause: _ } => true
      LeafNotReached { cause: _ } => true
    }))
}
