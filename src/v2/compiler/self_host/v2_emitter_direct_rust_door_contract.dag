module v2.compiler.self_host.v2_emitter_direct_rust_door_contract

import v2.compiler.self_host.candidate_generation {
  candidate_generation_serializes_written_source,
}
import v2.compiler.self_host.emitter_producer_provenance {
  ProducerMintAdmitted,
  ProducerMintRefused,
  V2EmitterInterpreted,
  emitter_producer_mint_admission,
  mint_v2_interpreted_receipt_with_seed_closure_refuses,
  v2_emitter_production_routed_count,
  v2_interpreted_emitter_closure,
}
import v2.compiler.translate {
  target_serialize_source_from_model,
  translate_diagnostic_reason_from_symbol,
  TargetBundleMalformed,
}
import v2.extdeps.languages.rust {
  rust_fixture_emitted_add_fn,
  rust_fn_add_lex,
}
import v2.std.algebra { any, filter, length }
import v2.std.collection { empty_map, List }
import v2.std.compilers.target_model {
  TargetModel,
  target_model_emit_transforms_empty,
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Conj,
  Node,
  SyntheticOccurrence,
  TypeNode,
}
import v2.std.optional { Absent, Present }
import v2.std.logic { Bool }
import v2.std.integer { Int }
import v2.std.text { String }

data v2_emitter_direct_rust_door_contract_note: String = "THE CLOSING CONDITION for roadmap node v2-emitter-direct-rust-door, transcribed at the node's two-clause red control. MissingTranslationRuleRefuses: a deliberately incomplete Rust TargetModel must refuse through target_serialize_source_from_model with TargetBundleMalformed rather than accepting guessed source. WrittenSourceIndependentOfSeedEmitter: derives from producer provenance — the v2 interpreted closure must be mint-admissible without v1.compiler.emit_rust, a V2EmitterInterpreted claim in the seed-linked harness closure must refuse, candidate_generation must serialize written source, and v2-written modules must carry executed producer receipts — never a hand-asserted flag. Missing, refused, and unavailable evidence all remain in the derived frontier; duplicate admissions cannot erase a missing capability, and zero progress on the second clause stays red even when the first is already established."

data v2_emitter_direct_rust_door_contract_dissolution_note: String = "DISSOLVES BY GREENING, never deletion. When candidate_generation wires serialize_target and the seed-independent written-source check executes green, the unchanged closing witness greens; its QuarantineProbeExpectRed exclusion and known-red roster entry delete in the same change, promoting it to ordinary discovery as the permanent direct-rust-door regression wall."

data direct_rust_door_authority_module_path: String = "src/v2/compiler/self_host/candidate_generation.dag"

data direct_rust_door_emitted_root: Node = rust_fixture_emitted_add_fn

data direct_rust_door_missing_rules_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence,
}

data direct_rust_door_missing_rules_target: TargetModel = TargetModel {
  bundle: direct_rust_door_missing_rules_bundle,
  lex: rust_fn_add_lex(),
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured,
}

type DirectRustDoorCapability
  = MissingTranslationRuleRefuses
  | WrittenSourceIndependentOfSeedEmitter

type DirectRustDoorTrigger
  = CandidateGenerationSerializeTargetWiring
  | NoV2WrittenSourcePopulation
  | V2WrittenSourceExecutedReceiptWall

type DirectRustDoorScenarioFailure
  = MissingRuleAcceptedDespiteGap
  | MissingRuleWrongDiagnostic
  | MissingRuleDiagnosticAbsent
  | SeedEmitterRequiredForWrittenSource

type DirectRustDoorAdmission
  = DirectRustDoorEstablished {
      capability: DirectRustDoorCapability,
    }
  | DirectRustDoorRefused {
      capability: DirectRustDoorCapability,
      failure: DirectRustDoorScenarioFailure,
    }
  | DirectRustDoorUnavailable {
      capability: DirectRustDoorCapability,
      trigger: DirectRustDoorTrigger,
    }

fn established(capability: DirectRustDoorCapability) -> DirectRustDoorAdmission {
  DirectRustDoorEstablished { capability: capability }
}

fn refused(
  capability: DirectRustDoorCapability,
  failure: DirectRustDoorScenarioFailure,
) -> DirectRustDoorAdmission {
  DirectRustDoorRefused { capability: capability, failure: failure }
}

fn assess_missing_translation_rule_refuses() -> DirectRustDoorAdmission {
  match target_serialize_source_from_model(
    target: direct_rust_door_missing_rules_target,
    emitted: direct_rust_door_emitted_root,
  ) {
    Accepted { value: _, diagnostics: _ } =>
      refused(
        capability: MissingTranslationRuleRefuses,
        failure: MissingRuleAcceptedDespiteGap,
      )
    Rejected { diagnostics: r } =>
      match translate_diagnostic_reason_from_symbol(sym: r.head.reason) {
        Present { value: TargetBundleMalformed } =>
          established(capability: MissingTranslationRuleRefuses)
        Present { value: _ } =>
          refused(
            capability: MissingTranslationRuleRefuses,
            failure: MissingRuleWrongDiagnostic,
          )
        Absent =>
          refused(
            capability: MissingTranslationRuleRefuses,
            failure: MissingRuleDiagnosticAbsent,
          )
      }
  }
}

fn assess_written_source_independent_of_seed_emitter() -> DirectRustDoorAdmission {
  if !mint_v2_interpreted_receipt_with_seed_closure_refuses(
    module_path: direct_rust_door_authority_module_path,
  ) {
    refused(
      capability: WrittenSourceIndependentOfSeedEmitter,
      failure: SeedEmitterRequiredForWrittenSource,
    )
  } else {
    match emitter_producer_mint_admission(
      producer: V2EmitterInterpreted,
      closure: v2_interpreted_emitter_closure,
    ) {
      ProducerMintRefused { cause: _ } =>
        refused(
          capability: WrittenSourceIndependentOfSeedEmitter,
          failure: SeedEmitterRequiredForWrittenSource,
        )
      ProducerMintAdmitted =>
        if !candidate_generation_serializes_written_source() {
          DirectRustDoorUnavailable {
            capability: WrittenSourceIndependentOfSeedEmitter,
            trigger: CandidateGenerationSerializeTargetWiring,
          }
        } else if v2_emitter_production_routed_count() == 0 {
          DirectRustDoorUnavailable {
            capability: WrittenSourceIndependentOfSeedEmitter,
            trigger: NoV2WrittenSourcePopulation,
          }
        } else {
          DirectRustDoorUnavailable {
            capability: WrittenSourceIndependentOfSeedEmitter,
            trigger: V2WrittenSourceExecutedReceiptWall,
          }
        }
    }
  }
}

fn direct_rust_door_required_capabilities() -> List<DirectRustDoorCapability> {
  [
    MissingTranslationRuleRefuses,
    WrittenSourceIndependentOfSeedEmitter,
  ]
}

fn direct_rust_door_missing_capabilities(
  admissions: List<DirectRustDoorAdmission>,
) -> List<DirectRustDoorCapability> {
  direct_rust_door_required_capabilities()
    |> filter(required =>
      !(admissions |> any(admission => match admission {
        DirectRustDoorEstablished { capability } => capability == required
        DirectRustDoorRefused { capability: _, failure: _ } => false
        DirectRustDoorUnavailable { capability: _, trigger: _ } => false
      }))
        || admissions |> any(admission => match admission {
          DirectRustDoorEstablished { capability: _ } => false
          DirectRustDoorRefused { capability, failure: _ } => capability == required
          DirectRustDoorUnavailable { capability, trigger: _ } => capability == required
        })
    )
}

fn direct_rust_door_closing_frontier_count(
  admissions: List<DirectRustDoorAdmission>,
) -> Int {
  length(direct_rust_door_missing_capabilities(admissions: admissions))
}

fn v2_emitter_direct_rust_door_closing_contract_holds(
  admissions: List<DirectRustDoorAdmission>,
) -> Bool {
  direct_rust_door_closing_frontier_count(admissions: admissions) == 0
}

fn v2_emitter_direct_rust_door_acceptance_admissions() -> List<DirectRustDoorAdmission> {
  [
    assess_missing_translation_rule_refuses(),
    assess_written_source_independent_of_seed_emitter(),
  ]
}
