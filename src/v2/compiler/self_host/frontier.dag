fn compiler_frontier_roster_count() -> Int {
  length(xs: compiler_frontier_roster)
}

fn count_rows_with_module_path(xs: List<CompilerModuleFrontierRow>, target: String) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      if row.module_path == target { count + 1 } else { count }
    }
  )
}

fn compiler_frontier_roster_paths_unique_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && (count_rows_with_module_path(xs: compiler_frontier_roster, target: row.module_path) == 1)
    }
  )
}

fn count_self_emitted_frontier_rows(xs: List<CompilerModuleFrontierRow>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      match row.disposition {
        SelfEmitted => count + 1
        SeedRetained { reason: _, migration_trigger: _ } => count
      }
    }
  )
}

fn count_seed_retained_frontier_rows(xs: List<CompilerModuleFrontierRow>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      match row.disposition {
        SelfEmitted => count
        SeedRetained { reason: _, migration_trigger: _ } => count + 1
      }
    }
  )
}

fn compiler_frontier_self_emitted_count() -> Int {
  count_self_emitted_frontier_rows(xs: compiler_frontier_roster)
}

fn compiler_frontier_self_emitted_baseline_holds() -> Bool {
  compiler_frontier_self_emitted_count() == compiler_frontier_self_emitted_baseline
}

fn compiler_frontier_seed_retained_count() -> Int {
  count_seed_retained_frontier_rows(xs: compiler_frontier_roster)
}

fn compiler_frontier_known_module_path_exactly_once_holds() -> Bool {
  count_rows_with_module_path(
    xs: compiler_frontier_roster,
    target: "src/v2/compiler/00_compile.dag"
  ) == 1
}

fn compiler_frontier_phantom_module_path_absent_holds() -> Bool {
  count_rows_with_module_path(
    xs: compiler_frontier_roster,
    target: "src/v2/compiler/not_a_real_module.dag"
  ) == 0
}

fn frontier_located_reason_is_class_projection(reason: Symbol) -> Bool {
  reason == ^measured_probe_self_emit_ready
    || reason == ^measured_probe_name_resolution_gap
    || reason == ^measured_probe_emit_surface_gap
    || reason == ^measured_probe_realization_gap
}

fn compiler_frontier_roster_all_classified_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && match row.measured_probe.blocker_class {
        UnknownProbeCause { reason: _ } => false
        FixtureCemented => false
        SelfEmitReady => true
        NameResolutionGap => true
        EmitSurfaceGap => true
        RealizationGap => true
      }
    }
  )
}

fn compiler_frontier_roster_located_reason_not_class_projection_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && match row.disposition {
        SelfEmitted => true
        SeedRetained { reason: _, migration_trigger: _ } =>
          !frontier_located_reason_is_class_projection(reason: row.measured_probe.located_reason)
      }
    }
  )
}

fn compiler_frontier_self_emitted_located_reason_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && match row.disposition {
        SelfEmitted =>
          frontier_blocker_class_matches(
            blocker: row.measured_probe.blocker_class,
            target: SelfEmitReady
          )
            && (row.measured_probe.located_reason == ^measured_probe_self_emit_ready)
        SeedRetained { reason: _, migration_trigger: _ } => true
      }
    }
  )
}

fn compiler_frontier_roster_probe_paths_match_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && (row.module_path == row.measured_probe.module_path)
    }
  )
}

fn compiler_frontier_blocker_class_distribution_knowledge_attributed_holds() -> Bool {
  match compiler_frontier_census_attribution {
    ExecutionMeasured {
      probe_kernel_receipt: _,
      wave_label: _,
      blocker_class_distribution: blocker_class_distribution,
      gap_clustering: _
    } =>
      blocker_class_distribution.dissolution_trigger == ^migrate_when_frontier_per_module_probe_receipt_binds
    KnowledgeAttributed { dissolution_trigger: _ } => false
  }
}

fn compiler_frontier_gap_clustering_knowledge_attributed_holds() -> Bool {
  match compiler_frontier_census_attribution {
    ExecutionMeasured {
      probe_kernel_receipt: _,
      wave_label: _,
      blocker_class_distribution: _,
      gap_clustering: gap_clustering
    } =>
      gap_clustering.dissolution_trigger == ^migrate_when_frontier_located_reason_survey_binds
    KnowledgeAttributed { dissolution_trigger: _ } => false
  }
}

fn compiler_frontier_execution_measured_attribution_holds() -> Bool {
  match compiler_frontier_census_attribution {
    ExecutionMeasured {
      probe_kernel_receipt: probe_kernel_receipt,
      wave_label: wave_label,
      blocker_class_distribution: _,
      gap_clustering: _
    } =>
      probe_kernel_receipt == ^frontier_classify_unlisted_reason_refuses_holds
        && wave_label == ^wave2_post_resolver_6451_body_stage_a_6443
        && compiler_frontier_blocker_class_distribution_knowledge_attributed_holds()
        && compiler_frontier_gap_clustering_knowledge_attributed_holds()
        && compiler_frontier_roster_all_classified_holds()
        && compiler_frontier_roster_probe_paths_match_holds()
    KnowledgeAttributed { dissolution_trigger: _ } => false
  }
}

fn compiler_frontier_tractability_rank_for_path(target: String) -> Int {
  fold_list(
    xs: compiler_frontier_roster,
    empty: -1,
    cons: fn(rank, row) {
      if row.module_path == target { row.tractability_rank } else { rank }
    }
  )
}

type CompilerFrontierSweepRankWalkState {
  ok: Bool
  prev_rank: Int
}

data compiler_frontier_sweep_rank_walk_initial: CompilerFrontierSweepRankWalkState = CompilerFrontierSweepRankWalkState {
  ok: true,
  prev_rank: -1
}

fn compiler_frontier_sweep_rank_walk_step(
  state: CompilerFrontierSweepRankWalkState,
  path: String
) -> CompilerFrontierSweepRankWalkState {
  let rank = compiler_frontier_tractability_rank_for_path(target: path)
  CompilerFrontierSweepRankWalkState {
    ok: state.ok && ((state.prev_rank < 0) || (rank >= state.prev_rank)),
    prev_rank: rank
  }
}

fn compiler_frontier_sweep_order_paths_in_roster_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_sweep_order,
    empty: true,
    cons: fn(ok, path) {
      ok && (count_rows_with_module_path(xs: compiler_frontier_roster, target: path) == 1)
    }
  )
}

fn compiler_frontier_sweep_order_rank_nondecreasing_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_sweep_order,
    empty: compiler_frontier_sweep_rank_walk_initial,
    cons: fn(state, path) {
      compiler_frontier_sweep_rank_walk_step(state: state, path: path)
    }
  ).ok
}

fn compiler_frontier_sweep_order_matches_tractability_rank_holds() -> Bool {
  compiler_frontier_sweep_order_complete_holds()
    && compiler_frontier_sweep_order_paths_in_roster_holds()
    && compiler_frontier_sweep_order_rank_nondecreasing_holds()
}

fn compiler_frontier_sweep_order_complete_holds() -> Bool {
  length(xs: compiler_frontier_sweep_order) == compiler_frontier_roster_count()
}

fn band_a_emit_readiness_roster_row_trigger_matches(
  module_path: String,
  trigger: Symbol,
  row: CompilerModuleFrontierRow
) -> Bool {
  if module_path == row.module_path {
    match row.disposition {
      SeedRetained { reason: _, migration_trigger: expected } => trigger == expected
      SelfEmitted => false
    }
  } else {
    false
  }
}

fn band_a_emit_readiness_module_is_self_emitted(module_path: String) -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: false,
    cons: fn(matched, row) {
      if row.module_path == module_path {
        match row.disposition {
          SelfEmitted => true
          SeedRetained { reason: _, migration_trigger: _ } => false
        }
      } else {
        matched
      }
    }
  )
}

fn band_a_emit_readiness_other_gate_matches_frontier_row(row: BandAEmitReadinessRow) -> Bool {
  match row.gate {
    FlippableNow => true
    BodyProducerGated => false
    OtherGate { migration_trigger: trigger } =>
      band_a_emit_readiness_module_is_self_emitted(module_path: row.module_path)
        || band_a_emit_readiness_roster_row_trigger_matches(
        module_path: row.module_path,
        trigger: trigger,
        row: compiler_frontier_row_use_site_verdict
      )
        || band_a_emit_readiness_roster_row_trigger_matches(
          module_path: row.module_path,
          trigger: trigger,
          row: compiler_frontier_row_materialization_carriers
        )
        || band_a_emit_readiness_roster_row_trigger_matches(
          module_path: row.module_path,
          trigger: trigger,
          row: compiler_frontier_row_self_host
        )
  }
}

fn compiler_frontier_band_a_other_gate_triggers_match_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_band_a_emit_readiness_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && band_a_emit_readiness_other_gate_matches_frontier_row(row: row)
    }
  )
}

fn compiler_frontier_band_a_emit_readiness_holds() -> Bool {
  compiler_frontier_band_a_emit_readiness_core_holds()
    && compiler_frontier_band_a_other_gate_triggers_match_holds()
}

fn frontier_roster_row_blocker_matches_probe(
  row: CompilerModuleFrontierRow,
  receipt: FrontierProbeReceipt
) -> Bool {
  (row.module_path == receipt.module_path)
    && frontier_blocker_class_matches(
      blocker: row.measured_probe.blocker_class,
      target: receipt.blocker_class
    )
}

fn compiler_frontier_row_for_path_matches_probe(
  target: String,
  receipt: FrontierProbeReceipt
) -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: false,
    cons: fn(matched, row) {
      if row.module_path == target {
        frontier_roster_row_blocker_matches_probe(row: row, receipt: receipt)
      } else {
        matched
      }
    }
  )
}

fn compiler_frontier_roster_matches_survey_holds(survey: List<FrontierProbeReceipt>) -> Bool {
  fold_list(
    xs: survey,
    empty: true,
    cons: fn(ok, receipt) {
      ok && compiler_frontier_row_for_path_matches_probe(
        target: receipt.module_path,
        receipt: receipt
      )
    }
  )
}

data frontier_binding_projection_note: String = "Task 3 of docs/plans/module-identity-storage-binding-design.md: the path→module lookup is a PROJECTION off the derived binding authority (v2.compiler.source_authority ModuleStorageIndex), not a read of a hand table. The 27 hand FrontierQualifiedModuleBinding rows were the second authority §3 forbids; they survive in this PR only as the transition-parity oracle below and are deleted with it.

The index arrives as a PARAMETER rather than an import, and that is forced by the layer DAG: the live rows are host-supplied through v2.test.workflow.host_module_binding_manifest, and no src/v2/compiler module may import v2.test.* (imports point toward std, §3). So the compiler layer owns the pure lookup and the test layer supplies the index.

The distinction that decides whether this is a real dissolution or a relocated ledger is WHAT FLOWS IN, not the arity: passing a pure constant hand index would satisfy the signature and still be a parallel ledger. The live callers pass host_module_bindings."

data frontier_binding_refusal_note: String = "Two DISTINCT located causes, never one. The prior lookup returned \"\" on miss — a sentinel meaning BOTH 'no binding for this path' AND 'the module name is empty' (state-space conflation, a named recurring failure mode). Projected off an unavailable index that sentinel becomes actively dangerous: every lookup returns \"\", and rust_qualified_module_mod_basename would fabricate a basename from the empty string SILENTLY, so a gate reading an EMPTY carrier would report on names it invented (§5 fabricated plausible output — structurally the coverage_complete-over-Empty shape).

^frontier_binding_index_unavailable says the projection could not be computed (⊤-as-ignorance). ^frontier_binding_path_unbound says it was computed and this path genuinely has no module (a real answer). Their remedies differ — supply the index vs fix the roster or the tree — which is exactly why they are not one arm."

fn frontier_binding_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: port_locus(port: ^compiler_frontier_binding_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

data frontier_emitter_hand_row_debt_note: String = "TYPED, COUNTED DEBT — the emit path still reads the hand rows, and this is the one place that says so out loud.

WHY IT SURVIVES: dag/gunbc/stage0_crate_layout_emit.dag generates stage0_crate_layout_generated.dag, and it is reached through generated_artifact_emit.dag's dispatch — ONE match over ~18 artifact variants, every one a zero-arg generator returning String. Supplying a ModuleStorageIndex there would force 17 unrelated generators to accept a host artifact they cannot use — the same coupling refused when the layout conjunct left compiler_frontier_census_holds (frontier_census_layout_relocation_note). Refusing it in one direction and accepting it in the other would be incoherent.

COUNT: exactly ONE consumer chain — expected_stage0_crate_layout_generated_dag / _rs via hand_maintained_pub_mod_basenames, hand_maintained_stage0_filenames, emit_hand_maintained_pub_mod_block. Any NEW caller of the _hand_rows family is a regression, not a use.

WHY THIS IS AN HONEST INTERIM RATHER THAN THE FORK §3 FORBIDS: the two authorities are not merely both present, they are PARITY-GATED. transition_parity_host_index_agrees_with_hand_rows is a STANDING witness on the wet cadence (promoted from transition artifact, parent ruling 2026-07-19) that REDS the moment the derived index and the hand rows disagree. A marked, parity-gated, trigger-bound duality is an interim; the same duality without the standing witness is a silent fork.

dissolve-on: host-driven generation of the crate-layout artifact with the index supplied at the boundary (only host boundaries project paths, §2/§3) — its own designed lane, not a patch, because it touches the generated-artifact source and the same-PR regen discipline of the drift-gate chain. When it lands, this family, the 27 hand rows, FrontierQualifiedModuleBinding, and the parity witness are deleted TOGETHER."

fn frontier_hand_rows_qualified_module_for_path(target: String) -> String {
  fold_list(
    xs: compiler_frontier_qualified_module_bindings,
    empty: "",
    cons: fn(found, binding) {
      if found != "" {
        found
      } else if binding.module_path == target {
        binding.qualified_module
      } else {
        ""
      }
    }
  )
}

fn frontier_hand_rows_row_stage0_mod_basename(row: CompilerModuleFrontierRow) -> String {
  rust_qualified_module_mod_basename(
    qualified_module: frontier_hand_rows_qualified_module_for_path(target: row.module_path)
  )
}

fn frontier_hand_rows_self_emitted_row_basename(row: CompilerModuleFrontierRow) -> List<String> {
  match row.disposition {
    SelfEmitted => [frontier_hand_rows_row_stage0_mod_basename(row: row)]
    SeedRetained { reason: _, migration_trigger: _ } => []
  }
}

fn compiler_frontier_self_emitted_stage0_mod_basenames() -> List<String> {
  fold(
    compiler_frontier_roster,
    init: [],
    f: fn(acc, row) {
      concat(acc, frontier_hand_rows_self_emitted_row_basename(row: row))
    }
  )
}

fn compiler_frontier_qualified_module_for_path(
  index: ModuleStorageIndex,
  target: String
) -> Outcome<QualifiedName> {
  if length(xs: index) == 0 {
    outcome_rejected(d: frontier_binding_diagnostic(reason: ^frontier_binding_index_unavailable))
  } else {
    match module_storage_module_for_path(index: index, file_path: target) {
      Present { value: v } => outcome_accepted(value: v)
      Absent => outcome_rejected(d: frontier_binding_diagnostic(reason: ^frontier_binding_path_unbound))
    }
  }
}

fn compiler_frontier_qualified_module_dotted_for_path(
  index: ModuleStorageIndex,
  target: String
) -> Outcome<String> {
  bind_outcome(
    o: compiler_frontier_qualified_module_for_path(index: index, target: target),
    f: fn(qn) { outcome_accepted(value: qualified_name_to_dotted_string(qn: qn)) }
  )
}

fn compiler_frontier_qualified_module_bindings_unique_holds(index: ModuleStorageIndex) -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok
        && (match compiler_frontier_qualified_module_for_path(index: index, target: row.module_path) {
             Accepted { value: _, diagnostics: _ } => true
             Rejected { diagnostics: _ } => false
           })
        && (count_rows_with_module_path(xs: compiler_frontier_roster, target: row.module_path) == 1)
    }
  )
}

fn frontier_row_stage0_mod_basename(
  index: ModuleStorageIndex,
  row: CompilerModuleFrontierRow
) -> Outcome<String> {
  bind_outcome(
    o: compiler_frontier_qualified_module_dotted_for_path(index: index, target: row.module_path),
    f: fn(dotted) {
      outcome_accepted(value: rust_qualified_module_mod_basename(qualified_module: dotted))
    }
  )
}

data frontier_basename_refusal_drop_note: String = "A row whose basename cannot be projected contributes NOTHING to this list, and the caller detects that by COUNT, not by a sentinel entry. compiler_frontier_crate_layout_holds asserts the produced length equals compiler_frontier_self_emitted_count(), so a refused projection shortens the list and REDS the gate — it cannot pass with an invented name in place of a real one.

That count assertion is load-bearing rather than incidental: dropping a refusal silently is exactly the absorbing-drop shape §5 forbids (the pre-Phase-1 derivation made a failed module invisible to every downstream lookup), and the length check is what converts the drop back into a loud, counted failure. Do not weaken it to a subset test."

fn self_emitted_frontier_row_stage0_mod_basename(
  index: ModuleStorageIndex,
  row: CompilerModuleFrontierRow
) -> List<String> {
  match row.disposition {
    SelfEmitted => {
      match frontier_row_stage0_mod_basename(index: index, row: row) {
        Accepted { value: b, diagnostics: _ } => [b]
        Rejected { diagnostics: _ } => []
      }
    }
    SeedRetained { reason: _, migration_trigger: _ } => []
  }
}

fn compiler_frontier_self_emitted_stage0_mod_basenames_from_index(index: ModuleStorageIndex) -> List<String> {
  fold(
    compiler_frontier_roster,
    init: [],
    f: fn(acc, row) {
      concat(acc, self_emitted_frontier_row_stage0_mod_basename(index: index, row: row))
    }
  )
}

type SeedRetainedIntrinsicRegistration {
  basename: String
  has_pub_mod: Bool
  is_dir: Bool
}

type SeedRetainedScaffoldRegistration {
  basename: String
}

data seed_retained_intrinsic_registrations: List<SeedRetainedIntrinsicRegistration> = [
  SeedRetainedIntrinsicRegistration { basename: "v1_interpreter", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "cli_run", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "coproduct_reflection", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "resolved_graph_cache", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "shared_typecheck_store", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "recorded_fixture", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "main", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "phase_profile", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "pre_push", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "census_exclude_derive", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "memory_governor", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "std_lens_verdict", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "module_path_index", has_pub_mod: true, is_dir: true }
]

data seed_retained_scaffold_registrations: List<SeedRetainedScaffoldRegistration> = [
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_algebra" },
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_collection" },
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_node" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_resolve" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_program_partition" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_tokenize" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_infer" }
]

fn intrinsic_pub_mod_basename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.has_pub_mod {
    [row.basename]
  } else {
    []
  }
}

fn intrinsic_stage0_filename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    []
  } else {
    [concat(row.basename, ".rs")]
  }
}

fn intrinsic_stage0_dir_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    [row.basename]
  } else {
    []
  }
}

fn seed_retained_intrinsic_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_pub_mod_basename_from_row(row: row))
    }
  )
}

fn seed_retained_intrinsic_stage0_files() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_stage0_filename_from_row(row: row))
    }
  )
}

fn seed_retained_scaffold_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [row.basename])
    }
  )
}

fn seed_retained_scaffold_stage0_files() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [concat(row.basename, ".rs")])
    }
  )
}

fn hand_maintained_stage0_dirs() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_stage0_dir_from_row(row: row))
    }
  )
}

fn basename_to_pub_mod_decl(basename: String) -> String {
  concat("pub mod ", basename, ";")
}

fn format_pub_mod_declarations(basenames: List<String>) -> String {
  let lines = basenames |> map(basename_to_pub_mod_decl)
  concat("\n", lines |> join(separator: "\n"))
}

fn basename_to_stage0_filename(basename: String) -> String {
  concat(basename, ".rs")
}

fn basenames_to_stage0_filenames(basenames: List<String>) -> List<String> {
  basenames |> map(basename_to_stage0_filename)
}

data frontier_hand_maintained_arity_note: String = "These three keep their ORIGINAL zero-arity shape and read the hand rows, deliberately — they are the emit path described in frontier_emitter_hand_row_debt_note, and their caller (generated_artifact_emit.dag's ~18-variant dispatch) has no index to give them. Changing their arity is what broke this lane once: dag/gunbc and dag/test/claim callers compile CLEAN at a stale arity because .dag does not arity-check these cross-module sites, so the breakage surfaces only at run time."

fn hand_maintained_pub_mod_basenames() -> List<String> {
  concat(
    concat(seed_retained_intrinsic_pub_mod_basenames(), seed_retained_scaffold_pub_mod_basenames()),
    compiler_frontier_self_emitted_stage0_mod_basenames()
  )
}

fn emit_hand_maintained_pub_mod_block() -> String {
  format_pub_mod_declarations(basenames: hand_maintained_pub_mod_basenames())
}

fn hand_maintained_stage0_filenames() -> List<String> {
  concat(
    concat(seed_retained_intrinsic_stage0_files(), seed_retained_scaffold_stage0_files()),
    basenames_to_stage0_filenames(
      basenames: compiler_frontier_self_emitted_stage0_mod_basenames()
    )
  )
}

fn compiler_frontier_crate_layout_holds(index: ModuleStorageIndex) -> Bool {
  compiler_frontier_qualified_module_bindings_unique_holds(index: index)
    && (length(xs: compiler_frontier_self_emitted_stage0_mod_basenames_from_index(index: index)) == compiler_frontier_self_emitted_count())
}

fn compiler_frontier_census_holds() -> Bool {
  compiler_frontier_roster_paths_unique_holds()
    && compiler_frontier_self_emitted_baseline_holds()
    && compiler_frontier_execution_measured_attribution_holds()
    && compiler_frontier_blocker_class_distribution_knowledge_attributed_holds()
    && compiler_frontier_gap_clustering_knowledge_attributed_holds()
    && compiler_frontier_sweep_order_complete_holds()
    && compiler_frontier_sweep_order_matches_tractability_rank_holds()
    && compiler_frontier_roster_all_classified_holds()
    && compiler_frontier_roster_located_reason_not_class_projection_holds()
    && compiler_frontier_self_emitted_located_reason_holds()
    && compiler_frontier_roster_probe_paths_match_holds()
    && compiler_frontier_band_a_emit_readiness_holds()
}

data frontier_census_layout_relocation_note: String = "SCOPE CHANGE, stated loudly because it NARROWS this gate: compiler_frontier_crate_layout_holds is no longer a conjunct of compiler_frontier_census_holds. It is RELOCATED, not deleted, and the relocation lands in the same PR as this removal — never a removal now and an enrollment later, which would leave a window where nothing checks it.

WHY it cannot stay here: the layout gate now requires a ModuleStorageIndex, and the live index is host-supplied through v2.test.workflow.host_module_binding_manifest. compiler_frontier_census_holds is a pure zero-arity gate on the FAST lane with no way to obtain one, and the layer DAG forbids a compiler module importing v2.test.* to reach it. Threading an index through the whole census — whose other ~12 conjuncts have nothing to do with bindings — would make every unrelated census check depend on a host artifact, which is a worse coupling than the one being removed.

WHERE it went: v2.test.claim.self_host.crate_layout_witness_test, enrolled on the WET cadence (module_binding_supply_transport), where the real index exists. The fast-lane census keeps every conjunct that does not need one, so this narrows the fast lane by exactly one check and widens what that check can actually see — from 27 hand rows to the whole-tree derived index.

The honest cost: a PR that touches only the frontier roster no longer gets layout coverage in the fast lane; it gets it on the wet cadence instead. That is a real latency increase for that one signal, accepted deliberately rather than papered over."

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
