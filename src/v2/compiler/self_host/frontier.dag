data compiler_frontier_roster: List<CompilerModuleFrontierRow> = [
  compiler_frontier_row_00_compile,
  compiler_frontier_row_01_tokenize,
  compiler_frontier_row_02_parse,
  compiler_frontier_row_03_body_producer,
  compiler_frontier_row_03_ingest,
  compiler_frontier_row_03_name_resolve,
  compiler_frontier_row_03_normalize,
  compiler_frontier_row_03_resolve,
  compiler_frontier_row_04_infer,
  compiler_frontier_row_05_emit,
  compiler_frontier_row_05_emit_orchestration,
  compiler_frontier_row_05_eval,
  compiler_frontier_row_06_translate,
  compiler_frontier_row_07_target_carriers,
  compiler_frontier_row_discovery_enumeration,
  compiler_frontier_row_emit_host,
  compiler_frontier_row_emit_module,
  compiler_frontier_row_emit_produced,
  compiler_frontier_row_emit_semantic_decl,
  compiler_frontier_row_fold_lowering,
  compiler_frontier_row_materialization_carriers,
  compiler_frontier_row_parse_engine_hooks,
  compiler_frontier_row_program_assembly,
  compiler_frontier_row_program_partition,
  compiler_frontier_row_self_host,
  compiler_frontier_row_source_authority,
  compiler_frontier_row_use_site_verdict
]

fn compiler_frontier_roster_count() -> Int {
  length(xs: compiler_frontier_roster)
}

fn count_self_emitted_frontier_rows(xs: List<CompilerModuleFrontierRow>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      match row.disposition {
        SelfEmitted => count + 1
        SeedRetained { reason: _, migration_trigger: _ } => count
      }
    }
  )
}

fn count_seed_retained_frontier_rows(xs: List<CompilerModuleFrontierRow>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      match row.disposition {
        SelfEmitted => count
        SeedRetained { reason: _, migration_trigger: _ } => count + 1
      }
    }
  )
}

fn compiler_frontier_self_emitted_count() -> Int {
  count_self_emitted_frontier_rows(xs: compiler_frontier_roster)
}

fn compiler_frontier_seed_retained_count() -> Int {
  count_seed_retained_frontier_rows(xs: compiler_frontier_roster)
}

fn compiler_frontier_roster_complete_holds() -> Bool {
  compiler_frontier_roster_count() == compiler_frontier_module_count_expected
}

fn compiler_frontier_disposition_partition_holds() -> Bool {
  (compiler_frontier_self_emitted_count() + compiler_frontier_seed_retained_count()) == compiler_frontier_roster_count()
}

fn compiler_frontier_self_emitted_baseline_holds() -> Bool {
  compiler_frontier_self_emitted_count() == compiler_frontier_self_emitted_baseline
}

fn compiler_frontier_census_holds() -> Bool {
  compiler_frontier_roster_complete_holds()
    && compiler_frontier_disposition_partition_holds()
    && compiler_frontier_self_emitted_baseline_holds()
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
