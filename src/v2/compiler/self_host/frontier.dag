type CompilerFrontierCensusAttribution
  = KnowledgeAttributed { dissolution_trigger: Symbol }
  | ExecutionMeasured { probe_receipt: Symbol, wave_label: Symbol }

data compiler_frontier_per_module_ingest_manifest_scaffold_dissolution_trigger: String = "🟡 dissolve-on: per-module frontier emit probe survey — each roster row's measured_probe must be refreshed by executing frontier_probe_emit_from_ingest against that module's import-closure ingest manifest (discover_source_root_ingest today). DISSOLVES WHEN a .dag-native survey workflow enumerates compiler_frontier_roster and binds each row's measured_probe from a live probe receipt in one authority, retiring hand-refreshed census rows."

data compiler_frontier_census_attribution: CompilerFrontierCensusAttribution = ExecutionMeasured {
  probe_receipt: ^compiler_frontier_emit_probe_survey_holds,
  wave_label: ^wave2_post_resolver_6451_body_stage_a_6443
}

type SelfHostFrontierDisposition
  = SelfEmitted
  | SeedRetained { reason: Symbol, migration_trigger: Symbol }

type CompilerModuleFrontierRow {
  module_path: String
  disposition: SelfHostFrontierDisposition
  measured_probe: FrontierProbeReceipt
  tractability_rank: Int
}

data compiler_frontier_module_count_expected: Int = 27

data compiler_frontier_self_emitted_baseline: Int = 0

fn measured_reason_for_blocker(blocker: FrontierBlockerClass) -> Symbol {
  match blocker {
    SelfEmitReady => ^measured_probe_self_emit_ready
    NameResolutionGap => ^measured_probe_name_resolution_gap
    EmitSurfaceGap => ^measured_probe_emit_surface_gap
    RealizationGap => ^measured_probe_realization_gap
    UnclassifiedProbeReason { reason: reason } => reason
  }
}

fn measured_stage_for_blocker(blocker: FrontierBlockerClass) -> FrontierProbeStage {
  match blocker {
    NameResolutionGap => ProbeStageAssemble
    UnclassifiedProbeReason { reason: _ } => ProbeStageAssemble
    SelfEmitReady => ProbeStageEmit
    EmitSurfaceGap => ProbeStageEmit
    RealizationGap => ProbeStageEmit
  }
}

fn tractability_rank_for(closure_reads: Int, blocker: FrontierBlockerClass) -> Int {
  let base = frontier_probe_blocker_rank(blocker: blocker) * 1000
  base + closure_reads
}

fn execution_measured_seed_retained_row(
  module_path: String,
  closure_reads: Int,
  measured_blocker: FrontierBlockerClass,
  migration_trigger: Symbol
) -> CompilerModuleFrontierRow {
  CompilerModuleFrontierRow {
    module_path: module_path,
    disposition: SeedRetained {
      reason: measured_reason_for_blocker(blocker: measured_blocker),
      migration_trigger: migration_trigger
    },
    measured_probe: FrontierProbeReceipt {
      module_path: module_path,
      blocker_class: measured_blocker,
      located_stage: measured_stage_for_blocker(blocker: measured_blocker),
      located_reason: measured_reason_for_blocker(blocker: measured_blocker)
    },
    tractability_rank: tractability_rank_for(closure_reads: closure_reads, blocker: measured_blocker)
  }
}

