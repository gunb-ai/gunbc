module v2.compiler.self_host.frontier

import v2.lens.common.construction_justification { ConstructionJustification, WallAfterGrounding }
import std.disposition { RealizationDispatch }
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

type SelfHostFrontierDisposition
  = SelfEmitted
  | SeedRetained { reason: Symbol, migration_trigger: Symbol }

type CompilerModuleFrontierRow {
  module_path: String
  disposition: SelfHostFrontierDisposition
}

data compiler_frontier_module_count_expected: Int = 27

data compiler_frontier_self_emitted_baseline: Int = 0

fn seed_retained_compiler_frontier_row(
  module_path: String,
  reason: Symbol,
  migration_trigger: Symbol
) -> CompilerModuleFrontierRow {
  CompilerModuleFrontierRow {
    module_path: module_path,
    disposition: SeedRetained {
      reason: reason,
      migration_trigger: migration_trigger
    }
  }
}

data compiler_frontier_row_00_compile: CompilerModuleFrontierRow = seed_retained_compiler_frontier_row(
  module_path: "src/v2/compiler/00_compile.dag",
  reason: ^reason_v1_regen_stage0_authority,
  migration_trigger: ^migrate_when_closure_self_emits_cargo_green
)

