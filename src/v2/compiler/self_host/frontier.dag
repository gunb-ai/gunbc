  length(xs: compiler_frontier_roster)
}

fn count_rows_with_module_path(xs: List<CompilerModuleFrontierRow>, target: String) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      if row.module_path == target { count + 1 } else { count }
    }
  )
}

fn compiler_frontier_roster_paths_unique_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && (count_rows_with_module_path(xs: compiler_frontier_roster, target: row.module_path) == 1)
    }
  )
}

fn count_self_emitted_frontier_rows(xs: List<CompilerModuleFrontierRow>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      match row.disposition {
        SelfEmitted => count + 1
        SeedRetained { reason: _, migration_trigger: _ } => count
      }
    }
  )
}

fn count_seed_retained_frontier_rows(xs: List<CompilerModuleFrontierRow>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, row) {
      match row.disposition {
        SelfEmitted => count
        SeedRetained { reason: _, migration_trigger: _ } => count + 1
      }
    }
  )
}

fn compiler_frontier_self_emitted_count() -> Int {
  count_self_emitted_frontier_rows(xs: compiler_frontier_roster)
}

fn compiler_frontier_seed_retained_count() -> Int {
  count_seed_retained_frontier_rows(xs: compiler_frontier_roster)
}

fn compiler_frontier_roster_complete_holds() -> Bool {
  compiler_frontier_roster_count() == compiler_frontier_module_count_expected
}

fn compiler_frontier_known_module_path_exactly_once_holds() -> Bool {
  count_rows_with_module_path(
    xs: compiler_frontier_roster,
    target: "src/v2/compiler/00_compile.dag"
  ) == 1
}

fn compiler_frontier_phantom_module_path_absent_holds() -> Bool {
  count_rows_with_module_path(
    xs: compiler_frontier_roster,
    target: "src/v2/compiler/not_a_real_module.dag"
  ) == 0
}

fn compiler_frontier_self_emitted_baseline_holds() -> Bool {
  compiler_frontier_self_emitted_count() == compiler_frontier_self_emitted_baseline
}

fn frontier_located_reason_is_class_projection(reason: Symbol) -> Bool {
  reason == ^measured_probe_self_emit_ready
    || reason == ^measured_probe_name_resolution_gap
    || reason == ^measured_probe_emit_surface_gap
    || reason == ^measured_probe_realization_gap
}

fn compiler_frontier_roster_all_classified_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && match row.measured_probe.blocker_class {
        UnknownProbeCause { reason: _ } => false
        FixtureCemented => false
        SelfEmitReady => true
        NameResolutionGap => true
        EmitSurfaceGap => true
        RealizationGap => true
      }
    }
  )
}

fn compiler_frontier_roster_located_reason_not_class_projection_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && match row.disposition {
        SelfEmitted => true
        SeedRetained { reason: _, migration_trigger: _ } =>
          !frontier_located_reason_is_class_projection(reason: row.measured_probe.located_reason)
      }
    }
  )
}

fn compiler_frontier_self_emitted_located_reason_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && match row.disposition {
        SelfEmitted =>
          frontier_blocker_class_matches(
            blocker: row.measured_probe.blocker_class,
            target: SelfEmitReady
          )
            && (row.measured_probe.located_reason == ^measured_probe_self_emit_ready)
        SeedRetained { reason: _, migration_trigger: _ } => true
      }
    }
  )
}

fn compiler_frontier_roster_probe_paths_match_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && (row.module_path == row.measured_probe.module_path)
    }
  )
}

fn compiler_frontier_blocker_class_distribution_knowledge_attributed_holds() -> Bool {
  match compiler_frontier_census_attribution {
    ExecutionMeasured {
      probe_kernel_receipt: _,
      wave_label: _,
      blocker_class_distribution: blocker_class_distribution,
      gap_clustering: _
    } =>
      blocker_class_distribution.dissolution_trigger == ^migrate_when_frontier_per_module_probe_receipt_binds
    KnowledgeAttributed { dissolution_trigger: _ } => false
  }
}

fn compiler_frontier_gap_clustering_knowledge_attributed_holds() -> Bool {
  match compiler_frontier_census_attribution {
    ExecutionMeasured {
      probe_kernel_receipt: _,
      wave_label: _,
      blocker_class_distribution: _,
      gap_clustering: gap_clustering
    } =>
      gap_clustering.dissolution_trigger == ^migrate_when_frontier_located_reason_survey_binds
    KnowledgeAttributed { dissolution_trigger: _ } => false
  }
}

fn compiler_frontier_execution_measured_attribution_holds() -> Bool {
  match compiler_frontier_census_attribution {
    ExecutionMeasured {
      probe_kernel_receipt: probe_kernel_receipt,
      wave_label: wave_label,
      blocker_class_distribution: _,
      gap_clustering: _
    } =>
      probe_kernel_receipt == ^frontier_classify_unlisted_reason_refuses_holds
        && wave_label == ^wave2_post_resolver_6451_body_stage_a_6443
        && compiler_frontier_blocker_class_distribution_knowledge_attributed_holds()
        && compiler_frontier_gap_clustering_knowledge_attributed_holds()
        && compiler_frontier_roster_all_classified_holds()
        && compiler_frontier_roster_probe_paths_match_holds()
    KnowledgeAttributed { dissolution_trigger: _ } => false
  }
}

fn compiler_frontier_tractability_rank_for_path(target: String) -> Int {
  fold_list(
    xs: compiler_frontier_roster,
    empty: -1,
    cons: fn(rank, row) {
      if row.module_path == target { row.tractability_rank } else { rank }
    }
  )
}

type CompilerFrontierSweepRankWalkState {
  ok: Bool
  prev_rank: Int
}

data compiler_frontier_sweep_rank_walk_initial: CompilerFrontierSweepRankWalkState = CompilerFrontierSweepRankWalkState {
  ok: true,
  prev_rank: -1
}

fn compiler_frontier_sweep_rank_walk_step(
  state: CompilerFrontierSweepRankWalkState,
  path: String
) -> CompilerFrontierSweepRankWalkState {
  let rank = compiler_frontier_tractability_rank_for_path(target: path)
  CompilerFrontierSweepRankWalkState {
    ok: state.ok && ((state.prev_rank < 0) || (rank >= state.prev_rank)),
    prev_rank: rank
  }
}

fn compiler_frontier_sweep_order_paths_in_roster_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_sweep_order,
    empty: true,
    cons: fn(ok, path) {
      ok && (count_rows_with_module_path(xs: compiler_frontier_roster, target: path) == 1)
    }
  )
}

fn compiler_frontier_sweep_order_rank_nondecreasing_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_sweep_order,
    empty: compiler_frontier_sweep_rank_walk_initial,
    cons: fn(state, path) {
      compiler_frontier_sweep_rank_walk_step(state: state, path: path)
    }
  ).ok
}

fn compiler_frontier_sweep_order_matches_tractability_rank_holds() -> Bool {
  compiler_frontier_sweep_order_complete_holds()
    && compiler_frontier_sweep_order_paths_in_roster_holds()
    && compiler_frontier_sweep_order_rank_nondecreasing_holds()
}

fn compiler_frontier_sweep_order_complete_holds() -> Bool {
  length(xs: compiler_frontier_sweep_order) == compiler_frontier_module_count_expected
}

fn band_a_emit_readiness_roster_row_trigger_matches(
  module_path: String,
  trigger: Symbol,
  row: CompilerModuleFrontierRow
) -> Bool {
  if module_path == row.module_path {
    match row.disposition {
      SeedRetained { reason: _, migration_trigger: expected } => trigger == expected
      SelfEmitted => false
    }
  } else {
    false
  }
}

fn band_a_emit_readiness_other_gate_matches_frontier_row(row: BandAEmitReadinessRow) -> Bool {
  match row.gate {
    FlippableNow => true
    BodyProducerGated => false
    OtherGate { migration_trigger: trigger } =>
      band_a_emit_readiness_roster_row_trigger_matches(
        module_path: row.module_path,
        trigger: trigger,
        row: compiler_frontier_row_use_site_verdict
      )
        || band_a_emit_readiness_roster_row_trigger_matches(
          module_path: row.module_path,
          trigger: trigger,
          row: compiler_frontier_row_materialization_carriers
        )
        || band_a_emit_readiness_roster_row_trigger_matches(
          module_path: row.module_path,
          trigger: trigger,
          row: compiler_frontier_row_self_host
        )
  }
}

fn compiler_frontier_band_a_other_gate_triggers_match_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_band_a_emit_readiness_roster,
    empty: true,
    cons: fn(ok, row) {
      ok && band_a_emit_readiness_other_gate_matches_frontier_row(row: row)
    }
  )
}

fn compiler_frontier_band_a_emit_readiness_holds() -> Bool {
  compiler_frontier_band_a_emit_readiness_core_holds()
    && compiler_frontier_band_a_other_gate_triggers_match_holds()
}

fn frontier_roster_row_blocker_matches_probe(
  row: CompilerModuleFrontierRow,
  receipt: FrontierProbeReceipt
) -> Bool {
  (row.module_path == receipt.module_path)
    && frontier_blocker_class_matches(
      blocker: row.measured_probe.blocker_class,
      target: receipt.blocker_class
    )
}

fn compiler_frontier_row_for_path_matches_probe(
  target: String,
  receipt: FrontierProbeReceipt
) -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: false,
    cons: fn(matched, row) {
      if row.module_path == target {
        frontier_roster_row_blocker_matches_probe(row: row, receipt: receipt)
      } else {
        matched
      }
    }
  )
}

fn compiler_frontier_roster_matches_survey_holds(survey: List<FrontierProbeReceipt>) -> Bool {
  fold_list(
    xs: survey,
    empty: true,
    cons: fn(ok, receipt) {
      ok && compiler_frontier_row_for_path_matches_probe(
        target: receipt.module_path,
        receipt: receipt
      )
    }
  )
}

fn compiler_frontier_qualified_module_for_path(target: String) -> String {
  fold_list(
    xs: compiler_frontier_qualified_module_bindings,
    empty: "",
    cons: fn(found, binding) {
      if found != "" {
        found
      } else if binding.module_path == target {
        binding.qualified_module
      } else {
        ""
      }
    }
  )
}

fn compiler_frontier_qualified_module_bindings_complete_holds() -> Bool {
  length(xs: compiler_frontier_qualified_module_bindings) == compiler_frontier_module_count_expected
}

fn compiler_frontier_qualified_module_bindings_unique_holds() -> Bool {
  fold_list(
    xs: compiler_frontier_roster,
    empty: true,
    cons: fn(ok, row) {
      ok
        && (compiler_frontier_qualified_module_for_path(target: row.module_path) != "")
        && (count_rows_with_module_path(xs: compiler_frontier_roster, target: row.module_path) == 1)
    }
  )
}

fn frontier_row_stage0_mod_basename(row: CompilerModuleFrontierRow) -> String {
  rust_qualified_module_mod_basename(
    qualified_module: compiler_frontier_qualified_module_for_path(target: row.module_path)
  )
}

fn self_emitted_frontier_row_stage0_mod_basename(row: CompilerModuleFrontierRow) -> List<String> {
  match row.disposition {
    SelfEmitted => [frontier_row_stage0_mod_basename(row: row)]
    SeedRetained { reason: _, migration_trigger: _ } => []
  }
}

fn compiler_frontier_self_emitted_stage0_mod_basenames() -> List<String> {
  fold(
    compiler_frontier_roster,
    init: [],
    f: fn(acc, row) {
      concat(acc, self_emitted_frontier_row_stage0_mod_basename(row: row))
    }
  )
}

type SeedRetainedIntrinsicRegistration {
  basename: String
  has_pub_mod: Bool
  is_dir: Bool
}

type SeedRetainedScaffoldRegistration {
  basename: String
}

data seed_retained_intrinsic_registrations: List<SeedRetainedIntrinsicRegistration> = [
  SeedRetainedIntrinsicRegistration { basename: "v1_interpreter", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "cli_run", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "coproduct_reflection", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "resolved_graph_cache", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "shared_typecheck_store", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "recorded_fixture", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "main", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "phase_profile", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "pre_push", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "memory_governor", has_pub_mod: true, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "std_lens_verdict", has_pub_mod: false, is_dir: false },
  SeedRetainedIntrinsicRegistration { basename: "module_path_index", has_pub_mod: true, is_dir: true }
]

data seed_retained_scaffold_registrations: List<SeedRetainedScaffoldRegistration> = [
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_algebra" },
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_collection" },
  SeedRetainedScaffoldRegistration { basename: "usv_pilot_v2_std_node" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_resolve" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_program_assembly" },
  SeedRetainedScaffoldRegistration { basename: "v2_compiler_program_partition" }
]

fn intrinsic_pub_mod_basename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.has_pub_mod {
    [row.basename]
  } else {
    []
  }
}

fn intrinsic_stage0_filename_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    []
  } else {
    [concat(row.basename, ".rs")]
  }
}

fn intrinsic_stage0_dir_from_row(row: SeedRetainedIntrinsicRegistration) -> List<String> {
  if row.is_dir {
    [row.basename]
  } else {
    []
  }
}

fn seed_retained_intrinsic_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_pub_mod_basename_from_row(row: row))
    }
  )
}

fn seed_retained_intrinsic_stage0_files() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_stage0_filename_from_row(row: row))
    }
  )
}

fn seed_retained_scaffold_pub_mod_basenames() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [row.basename])
    }
  )
}

fn seed_retained_scaffold_stage0_files() -> List<String> {
  fold(
    seed_retained_scaffold_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, [concat(row.basename, ".rs")])
    }
  )
}

fn hand_maintained_stage0_dirs() -> List<String> {
  fold(
    seed_retained_intrinsic_registrations,
    init: [],
    f: fn(acc, row) {
      concat(acc, intrinsic_stage0_dir_from_row(row: row))
    }
  )
}

fn basename_to_pub_mod_decl(basename: String) -> String {
  concat("pub mod ", basename, ";")
}

fn format_pub_mod_declarations(basenames: List<String>) -> String {
  let lines = basenames |> map(basename_to_pub_mod_decl)
  concat("\n", lines |> join(separator: "\n"))
}

fn basename_to_stage0_filename(basename: String) -> String {
  concat(basename, ".rs")
}

fn basenames_to_stage0_filenames(basenames: List<String>) -> List<String> {
  basenames |> map(basename_to_stage0_filename)
}

fn hand_maintained_pub_mod_basenames() -> List<String> {
  concat(
    concat(seed_retained_intrinsic_pub_mod_basenames(), seed_retained_scaffold_pub_mod_basenames()),
    compiler_frontier_self_emitted_stage0_mod_basenames()
  )
}

fn emit_hand_maintained_pub_mod_block() -> String {
  format_pub_mod_declarations(basenames: hand_maintained_pub_mod_basenames())
}

fn hand_maintained_stage0_filenames() -> List<String> {
  concat(
    concat(seed_retained_intrinsic_stage0_files(), seed_retained_scaffold_stage0_files()),
    basenames_to_stage0_filenames(basenames: compiler_frontier_self_emitted_stage0_mod_basenames())
  )
}

fn compiler_frontier_crate_layout_holds() -> Bool {
  compiler_frontier_qualified_module_bindings_complete_holds()
    && compiler_frontier_qualified_module_bindings_unique_holds()
    && (length(xs: compiler_frontier_self_emitted_stage0_mod_basenames()) == compiler_frontier_self_emitted_count())
}

fn compiler_frontier_census_holds() -> Bool {
  compiler_frontier_roster_complete_holds()
    && compiler_frontier_roster_paths_unique_holds()
    && compiler_frontier_self_emitted_baseline_holds()
    && compiler_frontier_execution_measured_attribution_holds()
    && compiler_frontier_blocker_class_distribution_knowledge_attributed_holds()
    && compiler_frontier_gap_clustering_knowledge_attributed_holds()
    && compiler_frontier_sweep_order_complete_holds()
    && compiler_frontier_sweep_order_matches_tractability_rank_holds()
    && compiler_frontier_roster_all_classified_holds()
    && compiler_frontier_roster_located_reason_not_class_projection_holds()
    && compiler_frontier_self_emitted_located_reason_holds()
    && compiler_frontier_roster_probe_paths_match_holds()
    && compiler_frontier_band_a_emit_readiness_holds()
    && compiler_frontier_crate_layout_holds()
}

data construction_justification: ConstructionJustification = ConstructionJustification {
  class: WallAfterGrounding { dissolves_to: RealizationDispatch }
}
