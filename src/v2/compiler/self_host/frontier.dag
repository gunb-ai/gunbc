data compiler_frontier_crate_layout_note: String = "Single crate-organization authority (Wave 2 derived layout): self-emitted stage0 mod basenames derive from compiler_frontier_roster SelfEmitted rows via qualified_module bindings + rust_qualified_module_mod_basename (extdeps.languages.rust.emit). Seed-retained intrinsic kernel + pilot scaffolds compose via hand_maintained_pub_mod_basenames derived from SeedRetainedIntrinsicRegistration rows (single row per intrinsic; pub_mod / stage0_file / dir projections). v1 consumers read gunbc.stage0_crate_layout_generated (frontier-derived committed artifact; regen via generated_artifact_gate main_wet; drift wall = byte-identical gate + crate_layout_witness_test RED controls). Dissolve-on: layer boundary lifts and v1 regen closure imports frontier directly."

data compiler_frontier_crate_linkage_unit_generalization_trigger: String = "Rust realization of the agnostic linkage-unit / unit-of-separate-compilation concept (crate = C translation-unit = Go package = .NET assembly). Kept Rust-specific until a 2nd target realization staffs (full-C-target frontier row, eager-ferret lane, anti-fork constraint recorded there). GENERALIZES-WHEN: a 2nd realization exists — factor the agnostic CompilationUnit/TargetLinkageUnit shape then, with per-realization axes (acyclicity, monomorphization-boundary) NOT averaged away; partition POLICY is workflow-derived, not baked here."

data compiler_frontier_rust_linkage_unit_axis_acyclic_crates: String = "Rust-specific axis (not universal): crate graph must be acyclic; separate-compilation unit = one Cargo crate."

data compiler_frontier_rust_linkage_unit_axis_monomorphization_boundary: String = "Rust-specific axis (not universal): crate boundary = monomorphization / codegen partition boundary (generics instantiated per crate)."

fn measured_stage_for_blocker(blocker: FrontierBlockerClass) -> FrontierProbeStage {
  match blocker {
    NameResolutionGap => ProbeStageAssemble
    UnknownProbeCause { reason: _ } => ProbeStageAssemble
    FixtureCemented => ProbeStageEmit
    SelfEmitReady => ProbeStageEmit
    EmitSurfaceGap => ProbeStageEmit
    RealizationGap => ProbeStageEmit
  }
}

fn tractability_rank_for(closure_reads: Int, blocker: FrontierBlockerClass) -> Int {
  let base = frontier_probe_blocker_rank(blocker: blocker) * 1000
  base + closure_reads
}

data compiler_frontier_self_emitted_tractability_rank_note: String = "At SelfEmitted flip, tractability_rank retains the pre-flip blocker band (not recomputed from measured_probe.blocker_class SelfEmitReady) so compiler_frontier_sweep_order rank monotonicity is unchanged. SelfEmitReady rank would be closure_reads alone (e.g. 9), breaking sweep order vs neighboring EmitSurfaceGap rows (e.g. 1002, 1012)."

fn self_emitted_tractability_rank_at_flip(closure_reads: Int, pre_flip_blocker: FrontierBlockerClass) -> Int {
  tractability_rank_for(closure_reads: closure_reads, blocker: pre_flip_blocker)
}

fn execution_measured_seed_retained_row(
  module_path: String,
  closure_reads: Int,
  measured_blocker: FrontierBlockerClass,
  located_stage: FrontierProbeStage,
  located_reason: Symbol,
  migration_trigger: Symbol
) -> CompilerModuleFrontierRow {
  CompilerModuleFrontierRow {
    module_path: module_path,
    disposition: SeedRetained {
      reason: located_reason,
      migration_trigger: migration_trigger
    },
    measured_probe: FrontierProbeReceipt {
      module_path: module_path,
      blocker_class: measured_blocker,
      located_stage: located_stage,
      located_reason: located_reason
    },
    tractability_rank: tractability_rank_for(closure_reads: closure_reads, blocker: measured_blocker)
  }
}

fn execution_measured_seed_retained_row_from_probe_receipt(
  closure_reads: Int,
  receipt: FrontierProbeReceipt,
  migration_trigger: Symbol
) -> CompilerModuleFrontierRow {
  execution_measured_seed_retained_row(
    module_path: receipt.module_path,
    closure_reads: closure_reads,
    measured_blocker: receipt.blocker_class,
    located_stage: receipt.located_stage,
    located_reason: receipt.located_reason,
    migration_trigger: migration_trigger
  )
}

fn execution_measured_self_emitted_row(
  module_path: String,
  closure_reads: Int,
  measured_probe: FrontierProbeReceipt,
  tractability_rank: Int
) -> CompilerModuleFrontierRow {
  CompilerModuleFrontierRow {
    module_path: module_path,
    disposition: SelfEmitted,
    measured_probe: measured_probe,
    tractability_rank: tractability_rank
  }
}

fn knowledge_attributed_blocker_class_seed_retained_row(
  module_path: String,
  closure_reads: Int,
  measured_blocker: FrontierBlockerClass,
  migration_trigger: Symbol
) -> CompilerModuleFrontierRow {
  execution_measured_seed_retained_row(
    module_path: module_path,
    closure_reads: closure_reads,
    measured_blocker: measured_blocker,
    located_stage: measured_stage_for_blocker(blocker: measured_blocker),
    located_reason: ^frontier_located_reason_execution_unbound,
    migration_trigger: migration_trigger
  )
}

