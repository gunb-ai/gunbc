type CompilerFrontierAttributedDebt {
  dissolution_trigger: Symbol
}

type CompilerFrontierCensusAttribution
  = KnowledgeAttributed { dissolution_trigger: Symbol }
  | ExecutionMeasured {
      probe_kernel_receipt: Symbol,
      wave_label: Symbol,
      blocker_class_distribution: CompilerFrontierAttributedDebt,
      gap_clustering: CompilerFrontierAttributedDebt
    }

data compiler_frontier_blocker_class_distribution_attribution: CompilerFrontierAttributedDebt = CompilerFrontierAttributedDebt {
  dissolution_trigger: ^migrate_when_frontier_per_module_probe_receipt_binds
}

data compiler_frontier_gap_clustering_attribution: CompilerFrontierAttributedDebt = CompilerFrontierAttributedDebt {
  dissolution_trigger: ^migrate_when_frontier_located_reason_survey_binds
}

data compiler_frontier_census_attribution: CompilerFrontierCensusAttribution = ExecutionMeasured {
  probe_kernel_receipt: ^frontier_classify_unlisted_reason_refuses_holds,
  wave_label: ^wave2_post_resolver_6451_body_stage_a_6443,
  blocker_class_distribution: compiler_frontier_blocker_class_distribution_attribution,
  gap_clustering: compiler_frontier_gap_clustering_attribution
}

data compiler_frontier_probe_kernel_receipt_note: String = "probe_kernel_receipt binds the fail-closed classifier RED control (frontier_classify_unlisted_reason_refuses_holds), not per-module frontier_probe_emit_from_ingest execution. Structural census invariants are compiler_frontier_structural_census_invariants_holds; per-module receipts deferred via CompilerFrontierAttributedDebt dissolution triggers."

type SelfHostFrontierDisposition
  = SelfEmitted
  | SeedRetained { reason: Symbol, migration_trigger: Symbol }

type CompilerModuleFrontierRow {
  module_path: String
  disposition: SelfHostFrontierDisposition
  measured_probe: FrontierProbeReceipt
  tractability_rank: Int
}

type BandAWave1EmitReadiness
  = FlippableNow
  | BodyProducerGated
  | OtherGate { migration_trigger: Symbol }

type BandAEmitReadinessRow {
  module_path: String
  gate: BandAWave1EmitReadiness
}

data compiler_frontier_module_count_expected: Int = 27

data compiler_frontier_self_emitted_baseline: Int = 0

fn measured_stage_for_blocker(blocker: FrontierBlockerClass) -> FrontierProbeStage {
  match blocker {
    NameResolutionGap => ProbeStageAssemble
    UnclassifiedProbeReason { reason: _ } => ProbeStageAssemble
    SelfEmitReady => ProbeStageEmit
    EmitSurfaceGap => ProbeStageEmit
    RealizationGap => ProbeStageEmit
  }
}

fn tractability_rank_for(closure_reads: Int, blocker: FrontierBlockerClass) -> Int {
  let base = frontier_probe_blocker_rank(blocker: blocker) * 1000
  base + closure_reads
}

fn execution_measured_seed_retained_row(
  module_path: String,
  closure_reads: Int,
  measured_blocker: FrontierBlockerClass,
  located_stage: FrontierProbeStage,
  located_reason: Symbol,
  migration_trigger: Symbol
) -> CompilerModuleFrontierRow {
  CompilerModuleFrontierRow {
    module_path: module_path,
    disposition: SeedRetained {
      reason: located_reason,
      migration_trigger: migration_trigger
    },
    measured_probe: FrontierProbeReceipt {
      module_path: module_path,
      blocker_class: measured_blocker,
      located_stage: located_stage,
      located_reason: located_reason
    },
    tractability_rank: tractability_rank_for(closure_reads: closure_reads, blocker: measured_blocker)
  }
}

fn execution_measured_seed_retained_row_from_probe_receipt(
  closure_reads: Int,
  receipt: FrontierProbeReceipt,
  migration_trigger: Symbol
) -> CompilerModuleFrontierRow {
  execution_measured_seed_retained_row(
    module_path: receipt.module_path,
    closure_reads: closure_reads,
    measured_blocker: receipt.blocker_class,
    located_stage: receipt.located_stage,
    located_reason: receipt.located_reason,
    migration_trigger: migration_trigger
  )
}

fn knowledge_attributed_blocker_class_seed_retained_row(
  module_path: String,
  closure_reads: Int,
  measured_blocker: FrontierBlockerClass,
  migration_trigger: Symbol
) -> CompilerModuleFrontierRow {
  execution_measured_seed_retained_row(
    module_path: module_path,
    closure_reads: closure_reads,
    measured_blocker: measured_blocker,
    located_stage: measured_stage_for_blocker(blocker: measured_blocker),
    located_reason: ^frontier_located_reason_execution_unbound,
    migration_trigger: migration_trigger
  )
}

