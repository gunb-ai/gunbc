module v2.compiler.self_host.direct_rust_door_observation

import v2.compiler.self_host.candidate_generation {
  ArtifactProduced,
  AssemblyRejected,
  EmissionRejected,
  InferenceRejected,
  ProducerReceiptRejected,
}
import v2.compiler.self_host.v2_emitter_direct_rust_door_contract {
  DirectRustDoorLeafResult,
  DirectRustDoorProductionGroup,
  LeafEstablished,
  LeafNotReached,
  LeafRefused,
  direct_rust_door_producer_identity_leaf,
  direct_rust_door_production_group,
  direct_rust_door_seed_emitter_absence_leaf,
  direct_rust_door_source_fidelity_leaf,
  direct_rust_door_source_produced_leaf,
}
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

data direct_rust_door_observation_note: String = "FIRST-FAILURE PROJECTION of the canonical direct-door production group. This module used to run its own ingest-assemble-infer-mint composition, which made it a SECOND production authority answering the same question as v2_emitter_direct_rust_door_contract's group — two folds, two schedule occurrences, one fact. It now walks nothing: observe_direct_rust_door_provenance projects an already-computed group, so the expensive path is paid once by the group's own root and this vocabulary survives for consumers that want a single first-failure name rather than five independent leaves. The DirectRustDoorObservation variants are preserved verbatim so no consumer had to change."

data direct_rust_door_observation_arm_order_note: String = "ARM ORDER IS LOAD-BEARING and the reason it was load-bearing is now DISSOLVED (operator review 2026-08-04, discharged 2026-08-05). The original hazard: provenanced_rust_artifact_seed_independent is a CONJUNCTION over producer identity AND seed absence, so testing it first made WrongProducer unreachable — a wrong producer failed the conjunction and got reported as SeedEmitterReachable, naming a cause that did not hold. The conjuncts are now separate predicates behind separate leaves (producer_identity, seed_emitter_absence), so each arm consumes its OWN fact and neither can absorb the other. Ordering here is retained only to keep the first-failure vocabulary stable for consumers; correctness no longer depends on it. That discharges this note's own dissolve-on, which read: seed independence exposes its two conjuncts separately and each arm consumes its own predicate."

data direct_rust_door_observation_arm_split_scaffold_note: String = "SCAFFOLD RETIRED (was: CandidateRejected vs ReceiptRefused discriminated by comparing a head diagnostic reason against a Symbol, because mint returned one Outcome with no structural way to tell which boundary refused). The group's ProvenancedRustEmissionObservation now carries the refusing STAGE structurally, so both arms derive from the observation's own variant rather than from symbol identity. The dissolve-on named production stage carriers gaining a boundary tag; the stage-located observation is that tag."

data direct_rust_door_observation_measured_note: String = "MEASURED 2026-08-04 on main, and unchanged by the consolidation: assembly ACCEPTS, inference ACCEPTS, mint over the hand-authored fixture inferred tree ACCEPTS, and mint over the real infer(assemble(ingest)) REJECTS. Every stage passes in isolation; only the real composition fails, at emission."

type DirectRustDoorObservation
  = AssemblyRefused { reason: Symbol }
  | InferenceRefused { reason: Symbol }
  | CandidateRejected { reason: Symbol }
  | ReceiptRefused { reason: Symbol }
  | EmittedSourceMismatch
  | SeedEmitterReachable
  | WrongProducer
  | SourceProducedQualificationMissing
  | DirectRustDoorSourceProduced

fn direct_rust_door_leaf_is_refused(leaf: DirectRustDoorLeafResult) -> Bool {
  match leaf {
    LeafEstablished => false
    LeafRefused { cause: _ } => true
    LeafNotReached { cause: _ } => false
  }
}

fn project_direct_rust_door_observation(
  group: DirectRustDoorProductionGroup
) -> DirectRustDoorObservation {
  match group.emission {
    AssemblyRejected { diagnostics: ds } => AssemblyRefused { reason: ds.head.reason }
    InferenceRejected { diagnostics: ds } => InferenceRefused { reason: ds.head.reason }
    EmissionRejected { diagnostics: ds } => CandidateRejected { reason: ds.head.reason }
    ProducerReceiptRejected { diagnostics: ds } => ReceiptRefused { reason: ds.head.reason }
    ArtifactProduced { artifact: _ } =>
      if direct_rust_door_leaf_is_refused(
        leaf: direct_rust_door_source_fidelity_leaf(group: group)
      ) {
        EmittedSourceMismatch
      } else {
        if direct_rust_door_leaf_is_refused(
          leaf: direct_rust_door_producer_identity_leaf(group: group)
        ) {
          WrongProducer
        } else {
          if direct_rust_door_leaf_is_refused(
            leaf: direct_rust_door_seed_emitter_absence_leaf(group: group)
          ) {
            SeedEmitterReachable
          } else {
            if direct_rust_door_leaf_is_refused(
              leaf: direct_rust_door_source_produced_leaf(group: group)
            ) {
              SourceProducedQualificationMissing
            } else {
              DirectRustDoorSourceProduced
            }
          }
        }
      }
  }
}

fn observe_direct_rust_door_provenance() -> DirectRustDoorObservation {
  project_direct_rust_door_observation(group: direct_rust_door_production_group())
}

data direct_rust_door_observation_totality_note: String = "Total over DirectRustDoorObservation with no wildcard arm (DESIGN 6 non-fold residue). A `_ => false` arm here would make the coproduct grow in silence: a tenth observation variant would land as false and read as an honest negative rather than an unhandled case."

fn direct_rust_door_observation_establishes(o: DirectRustDoorObservation) -> Bool {
  match o {
    AssemblyRefused { reason: _ } => false
    InferenceRefused { reason: _ } => false
    CandidateRejected { reason: _ } => false
    ReceiptRefused { reason: _ } => false
    EmittedSourceMismatch => false
    SeedEmitterReachable => false
    WrongProducer => false
    SourceProducedQualificationMissing => false
    DirectRustDoorSourceProduced => true
  }
}

fn direct_rust_door_observation_is_candidate_rejection(o: DirectRustDoorObservation) -> Bool {
  match o {
    AssemblyRefused { reason: _ } => false
    InferenceRefused { reason: _ } => false
    CandidateRejected { reason: _ } => true
    ReceiptRefused { reason: _ } => false
    EmittedSourceMismatch => false
    SeedEmitterReachable => false
    WrongProducer => false
    SourceProducedQualificationMissing => false
    DirectRustDoorSourceProduced => false
  }
}
