module v2.compiler.self_host.parity_window

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data parity_window_note: String = "Parity window, DEMOTED to post-flip monitoring (2026-07-28; was the P6 pre-flip routing flip gate of 2026-07-22). Demotion ground is the routed_flip_reverted_note receipt in v2.compiler.self_host.native_routing_frontier: the pre-flip window PASSED for meet_join and complement (three consecutive green srv1 probe windows, parity_receipts_local) and the flip still redded WARM on main run 29963619401 — the pre-flip streak was not the operative protection; the live agreement leg in the per-PR floor plus the one-data-edit frontier revert was. The window observation law is unchanged (green = the family's equals_eval agreement leg passed AND the warm leg observed compile_skipped=true on the durable root; any red or divergence resets the trailing streak), but the verdict it feeds now MONITORS NativeRouted families AFTER the flip instead of gating the flip: the latest red cadence window yields ParityRevertRequired naming that window (typed, located — the loudness routed_flip_reverted_note demands), an empty observation history is ParityUnobserved (never conflated with holding — DESIGN section 5 state-space conflation), and only a trailing green streak is ParityHolding. The flip bar itself lives on the frontier rows: a no-evict cached agreement leg plus a warm green agreement receipt — see native_routing_frontier_note."

type ParityWindowReceipt {
  family: String
  cadence_window_id: String
  agreement_green: Bool
  warm_compile_skipped: Bool
}

type ParityMonitorVerdict
  = ParityHolding { family: String, consecutive_green: Int }
  | ParityRevertRequired { family: String, red_window_id: String }
  | ParityUnobserved { family: String }

fn receipt_is_green(r: ParityWindowReceipt) -> Bool {
  r.agreement_green && r.warm_compile_skipped
}

fn parity_monitor_verdict(
  family: String,
  receipts: List<ParityWindowReceipt>
) -> ParityMonitorVerdict {
  fold(
    receipts,
    init: ParityUnobserved { family: family },
    f: fn(acc, r) {
      if receipt_is_green(r: r) {
        match acc {
          ParityHolding { family: f, consecutive_green: n } =>
            ParityHolding { family: f, consecutive_green: n + 1 }
          ParityRevertRequired { family: f, red_window_id: _ } =>
            ParityHolding { family: f, consecutive_green: 1 }
          ParityUnobserved { family: f } =>
            ParityHolding { family: f, consecutive_green: 1 }
        }
      } else {
        ParityRevertRequired { family: family, red_window_id: r.cadence_window_id }
      }
    }
  )
}

fn parity_holding(family: String, receipts: List<ParityWindowReceipt>) -> Bool {
  match parity_monitor_verdict(family: family, receipts: receipts) {
    ParityHolding { family: _, consecutive_green: _ } => true
    ParityRevertRequired { family: _, red_window_id: _ } => false
    ParityUnobserved { family: _ } => false
  }
}

fn parity_revert_required(family: String, receipts: List<ParityWindowReceipt>) -> Bool {
  match parity_monitor_verdict(family: family, receipts: receipts) {
    ParityHolding { family: _, consecutive_green: _ } => false
    ParityRevertRequired { family: _, red_window_id: _ } => true
    ParityUnobserved { family: _ } => false
  }
}
