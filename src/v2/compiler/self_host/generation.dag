module v2.compiler.self_host.generation


// Generation identity is SIX independent axes, never one scalar. A single opaque
// compiler_identity digest can report THAT a generation went stale and cannot report
// WHICH fact moved, so every per-axis invalidation control collapses into one
// indistinguishable refusal — the state-space conflation DESIGN §5 forbids, and an
// absorbing fallback wearing a diagnostic. No composite digest is stored anywhere in
// this module: a composite is always a projection derived on demand, so an identity
// that disagrees with its own axes is unrepresentable rather than lens-caught.
type GenerationAxis
  = ProducerCompilerAxis
  | SourceClosureAxis
  | TargetModelAxis
  | ToolchainAxis
  | BuildConfigurationAxis
  | MaterializedArtifactAxis

// The artifact axis is first-class in the identity rather than a downstream field,
// because a generation whose artifact was never built is a DIFFERENT state from one
// whose artifact differs — and admission must refuse the former by naming it, never
// treat unbuilt as equivalent.
//
// The digest carrier is sole_constructor, so the artifact axis cannot be FORGED.
// An earlier revision typed it as Hash — that is v2.std.node's Fnv1a64Structural,
// which symbol_identity_digest mints from arbitrary text, so
// ArtifactMaterialized { digest: symbol_identity_digest(sym: ^anything) } typechecked
// and required no build, no file and no observation. The one axis whose entire
// purpose is to be filled from built bytes had no construction link to bytes. That is
// the donor's authored compile_skipped v2.std.logic.Bool wearing a different field name: an
// asserted fingerprint standing where an observation was owed. Because admission
// JOINS on this axis, a forged digest does not merely mislabel one generation — it
// makes every downstream stale-axis check agree when it should refuse.
//
// The mint takes an already-validated Sha512Digest rather than any particular
// observation record, deliberately. Binding it to one tool's observation coproduct
// would fuse the transport into the interface (DESIGN §3): the observer is a
// realization handler, one of N. Any observer that produces a Sha512Digest can mint —
// the sha512sum file path yields exactly that on its observed arm — and none can
// shortcut the validation, because Sha512Digest itself is reachable only through the
// length-and-lowercase-hex checked mints. It is also the cited cryptographic family
// the real transport already produces, so nothing has to be re-fingerprinted through
// fnv1a64, which would degrade a cryptographic digest to a 64-bit structural one and
// relabel arbitrary text as a digest — the exact move content_hash's constructor note
// forbids.
type ObservedArtifactDigest sole_constructor {
  observed: std.content_hash.Sha512Digest
}

fn observed_artifact_digest(observed: std.content_hash.Sha512Digest) -> ObservedArtifactDigest {
  ObservedArtifactDigest { observed: observed }
}

type GeneratedArtifactIdentity
  = ArtifactMaterialized { digest: ObservedArtifactDigest }
  | ArtifactNotMaterialized

// THESE SIX AXES DO NOT DETERMINE THE ARTIFACT, and the gap is named here rather than
// left to be rediscovered. A Rust debug binary embeds its build directory, so the same
// source compiled in two different directories yields different bytes while every axis
// below agrees; the same directory rebuilt yields byte-identical output. Measured by
// hand twice (gunbc#8181). So this identity identifies a generation UP TO BUILD
// LOCATION, and build path is an input that no axis names.
//
// It is an incompleteness in the promotion premise, not a caveat on comparison. Two
// honest remedies exist — remap the path out of the emitted artifact so the declared
// axes become an actual determinant, or name build path in build_configuration so the
// axis tells the truth about what it covers. Papering over it inside a comparison is
// the third option and is not available.
//
// The direction is fail-closed: relocating an identical build reports as a MOVED
// artifact rather than a spurious match, so nothing is silently admitted. That is why
// the first frontier flip may proceed by pinning the build directory. It is also why
// artifact-digest equality across hosts or workspaces must never be used as a
// reproducibility oracle. Registered as an obligation with its trigger in
// gunbc.self_host_promotion_obligations.
type GenerationIdentity {
  producer_compiler: v2.std.node.Hash
  source_closure: v2.std.node.Hash
  target_model: v2.std.node.Hash
  toolchain: v2.std.node.Hash
  build_configuration: v2.std.node.Hash
  materialized_artifact: GeneratedArtifactIdentity
}

// Three generations, three distinct TYPES. A candidate cannot be constructed without
// naming the seed that produced it, and a successor cannot be constructed without
// naming the candidate that produced it, so "seed-generated candidate" and
// "candidate-generated successor" are distinct facts by construction rather than by
// a producer label some caller could author either way.
type SeedGeneration {
  identity: GenerationIdentity
}

type CandidateGeneration {
  identity: GenerationIdentity
  produced_by_seed: SeedGeneration
}

type SuccessorGeneration {
  identity: GenerationIdentity
  produced_by_candidate: CandidateGeneration
}

type SourceClosureMember {
  identity: String
  content: v2.std.node.Hash
}

type SourceClosureRoster {
  members: List<SourceClosureMember>
}

// A source closure is a SET, so a digest folded over host traversal order is a
// false-refusal source: the same closure enumerated in a different order would
// report as a different generation. The roster is therefore required to arrive in
// canonical ascending member-identity order and REFUSES otherwise, rather than being
// silently re-sorted. Refusing is the stronger arm on three counts: it is linear
// where an in-carrier sort would be quadratic (DESIGN §6 bare-minimum cost — a
// cost-shape defect is fixed regardless of realized n); a silent re-sort would also
// launder a producer emitting DUPLICATE members, which strict ascent catches here;
// and normalizing someone else's disorder hides that their enumeration is
// order-unstable, which is exactly the deficit the refusal makes countable.
type RosterOrderVerdict
  = RosterCanonicallyOrdered
  | RosterNotAscending { at_member: String }
  | RosterDuplicateMember { at_member: String }
  | RosterMemberIdentityEmpty

type RosterScanAcc {
  verdict: RosterOrderVerdict
  previous: String
  started: v2.std.logic.Bool
}

fn roster_scan_step(acc: RosterScanAcc, member: SourceClosureMember) -> RosterScanAcc {
  match acc.verdict {
    RosterCanonicallyOrdered =>
      if string_is_empty(s: member.identity) {
        RosterScanAcc {
          verdict: RosterMemberIdentityEmpty,
          previous: member.identity,
          started: true
        }
      } else if !acc.started {
        RosterScanAcc {
          verdict: RosterCanonicallyOrdered,
          previous: member.identity,
          started: true
        }
      } else if acc.previous == member.identity {
        RosterScanAcc {
          verdict: RosterDuplicateMember { at_member: member.identity },
          previous: member.identity,
          started: true
        }
      } else if member.identity <= acc.previous {
        RosterScanAcc {
          verdict: RosterNotAscending { at_member: member.identity },
          previous: member.identity,
          started: true
        }
      } else {
        RosterScanAcc {
          verdict: RosterCanonicallyOrdered,
          previous: member.identity,
          started: true
        }
      }
    RosterNotAscending { at_member: m } =>
      RosterScanAcc {
        verdict: RosterNotAscending { at_member: m },
        previous: acc.previous,
        started: acc.started
      }
    RosterDuplicateMember { at_member: m } =>
      RosterScanAcc {
        verdict: RosterDuplicateMember { at_member: m },
        previous: acc.previous,
        started: acc.started
      }
    RosterMemberIdentityEmpty =>
      RosterScanAcc {
        verdict: RosterMemberIdentityEmpty,
        previous: acc.previous,
        started: acc.started
      }
  }
}

fn roster_order_verdict(roster: SourceClosureRoster) -> RosterOrderVerdict {
  fold_list(
    xs: roster.members,
    empty: RosterScanAcc {
      verdict: RosterCanonicallyOrdered,
      previous: "",
      started: false
    },
    cons: fn(acc, member) { roster_scan_step(acc: acc, member: member) }
  ).verdict
}

fn member_identity_digest(identity: String) -> v2.std.node.Hash {
  symbol_identity_digest(sym: identity)
}

fn source_closure_member_digest(member: SourceClosureMember) -> v2.std.node.Hash {
  combine_hash(
    a: member_identity_digest(identity: member.identity),
    b: member.content
  )
}

// Only reachable for a roster whose order verdict is canonical; the caller-facing
// surface is source_closure_axis_digest, which refuses first.
fn source_closure_roster_fold(roster: SourceClosureRoster) -> v2.std.node.Hash {
  fold_list(
    xs: roster.members,
    empty: symbol_identity_digest(sym: ^source_closure_roster_empty),
    cons: fn(acc, member) {
      combine_hash(a: acc, b: source_closure_member_digest(member: member))
    }
  )
}

type SourceClosureAxisOutcome
  = SourceClosureAxisDigest { digest: v2.std.node.Hash }
  | SourceClosureAxisRefused { verdict: RosterOrderVerdict }

fn source_closure_axis_digest(roster: SourceClosureRoster) -> SourceClosureAxisOutcome {
  match roster_order_verdict(roster: roster) {
    RosterCanonicallyOrdered =>
      SourceClosureAxisDigest { digest: source_closure_roster_fold(roster: roster) }
    RosterNotAscending { at_member: m } =>
      SourceClosureAxisRefused { verdict: RosterNotAscending { at_member: m } }
    RosterDuplicateMember { at_member: m } =>
      SourceClosureAxisRefused { verdict: RosterDuplicateMember { at_member: m } }
    RosterMemberIdentityEmpty =>
      SourceClosureAxisRefused { verdict: RosterMemberIdentityEmpty }
  }
}

// Two unbuilt artifacts are NOT equivalent. Neither side has an observed artifact,
// so that case is ⊥-as-ignorance, and answering `true` would report "we could not
// observe either artifact" as "the artifacts agree" — the empty-observation narrow
// DESIGN names beside the absorbing fallback. Admission refuses an unmaterialized
// axis separately and by name.
fn artifact_identity_agrees(left: GeneratedArtifactIdentity, right: GeneratedArtifactIdentity) -> v2.std.logic.Bool {
  match left {
    ArtifactMaterialized { digest: l } =>
      match right {
        ArtifactMaterialized { digest: r } =>
          std.content_hash.content_hash_eq_sha512(left: l.observed, right: r.observed)
        ArtifactNotMaterialized => false
      }
    ArtifactNotMaterialized =>
      match right {
        ArtifactMaterialized { digest: _ } => false
        ArtifactNotMaterialized => false
      }
  }
}

fn generation_axis_agrees(
  left: GenerationIdentity,
  right: GenerationIdentity,
  axis: GenerationAxis
) -> v2.std.logic.Bool {
  match axis {
    ProducerCompilerAxis => left.producer_compiler == right.producer_compiler
    SourceClosureAxis => left.source_closure == right.source_closure
    TargetModelAxis => left.target_model == right.target_model
    ToolchainAxis => left.toolchain == right.toolchain
    BuildConfigurationAxis => left.build_configuration == right.build_configuration
    MaterializedArtifactAxis =>
      artifact_identity_agrees(
        left: left.materialized_artifact,
        right: right.materialized_artifact
      )
  }
}

data generation_axes: List<GenerationAxis> = [
  ProducerCompilerAxis,
  SourceClosureAxis,
  TargetModelAxis,
  ToolchainAxis,
  BuildConfigurationAxis,
  MaterializedArtifactAxis
]

// Returns the axes that MOVED, so a stale refusal names its own axis rather than
// reporting an undifferentiated mismatch. This list is what makes SH-C's per-axis
// invalidation control discriminating: one planted perturbation per axis must
// produce exactly one named axis here, and any two axes that cannot be told apart
// are a defect in this carrier.
fn generation_identity_mismatched_axes(
  left: GenerationIdentity,
  right: GenerationIdentity
) -> List<GenerationAxis> {
  fold_list(
    xs: generation_axes,
    empty: freemonoid_empty(),
    cons: fn(acc, axis) {
      if generation_axis_agrees(left: left, right: right, axis: axis) {
        acc
      } else {
        list_snoc_item(xs: acc, item: axis)
      }
    }
  )
}

fn generation_axis_symbol(axis: GenerationAxis) -> v2.std.node.Symbol {
  match axis {
    ProducerCompilerAxis => ^generation_axis_producer_compiler
    SourceClosureAxis => ^generation_axis_source_closure
    TargetModelAxis => ^generation_axis_target_model
    ToolchainAxis => ^generation_axis_toolchain
    BuildConfigurationAxis => ^generation_axis_build_configuration
    MaterializedArtifactAxis => ^generation_axis_materialized_artifact
  }
}

fn generation_axis_stale_diagnostic(axis: GenerationAxis) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: generation_axis_symbol(axis: axis),
    at: port_locus(port: ^generation_identity_axis_port),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn generation_identity_agrees(
  left: GenerationIdentity,
  right: GenerationIdentity
) -> v2.std.logic.Bool {
  for_all(
    xs: generation_axes,
    predicate: fn(axis) {
      generation_axis_agrees(left: left, right: right, axis: axis)
    }
  )
}
