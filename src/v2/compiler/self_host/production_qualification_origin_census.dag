module v2.compiler.self_host.production_qualification_origin_census

import v2.compiler.self_host.emitter_producer_provenance {
  CargoGreen,
  EmissionQualification,
  ProductionRouted,
  SourceProduced,
  emission_qualification_eq
}
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }

data production_qualification_origin_census_note: String = "Fixture-origin production qualification census (session keen-lark-681, parent wise-ram-22 witness-evidence-lifecycle): closed registry of every live mint site that grants a production qualification (SourceProduced | CargoGreen | ProductionRouted — not BehavioralEquivalent, which is behavioral-evidence vocabulary). Each row names the evidence-origin axis: FixtureInferredTree (hand-built inferred tree, e.g. direct_rust_door_inferred_tree), FixtureIngestInline (ingest machinery over inline fixture source), or ExecutionMeasured (host-measured wet verdict — unwritable at baseline). Dissolve-on: origin becomes a construction field on ProducerEmissionReceipt mint; this hand registry deletes when mint refuses fixture-origin production qualifications without execution-measured evidence."

type ProductionQualificationEvidenceOrigin
  = FixtureInferredTreeOrigin
  | FixtureIngestInlineOrigin
  | ExecutionMeasuredOrigin

type ProductionQualificationMintSiteRow {
  site_id: Symbol
  mint_surface: String
  qualification: EmissionQualification
  evidence_origin: ProductionQualificationEvidenceOrigin
}

data production_qualification_mint_site_source_produced_ingest: ProductionQualificationMintSiteRow = ProductionQualificationMintSiteRow {
  site_id: ^production_qualification_mint_site_source_produced_ingest,
  mint_surface: "v2.compiler.self_host.candidate_generation.generate_provenanced_rust_candidate_from_ingest -> mint_provenanced_rust_artifact",
  qualification: SourceProduced,
  evidence_origin: FixtureIngestInlineOrigin
}

data production_qualification_mint_site_source_produced_inferred_tree: ProductionQualificationMintSiteRow = ProductionQualificationMintSiteRow {
  site_id: ^production_qualification_mint_site_source_produced_inferred_tree,
  mint_surface: "v2.compiler.self_host.candidate_generation.mint_provenanced_rust_artifact(direct_rust_door_inferred_tree)",
  qualification: SourceProduced,
  evidence_origin: FixtureInferredTreeOrigin
}

data production_qualification_mint_site_cargo_green_inferred_tree: ProductionQualificationMintSiteRow = ProductionQualificationMintSiteRow {
  site_id: ^production_qualification_mint_site_cargo_green_inferred_tree,
  mint_surface: "tools.direct_rust_door_transport.run_direct_rust_door_emit_write_compile_smoke -> advance_written_provenanced_rust_artifact_cargo_green",
  qualification: CargoGreen,
  evidence_origin: FixtureInferredTreeOrigin
}

data production_qualification_mint_sites: List<ProductionQualificationMintSiteRow> = [
  production_qualification_mint_site_source_produced_ingest,
  production_qualification_mint_site_source_produced_inferred_tree,
  production_qualification_mint_site_cargo_green_inferred_tree
]

data production_qualification_mint_sites_empty: List<ProductionQualificationMintSiteRow> = []

fn production_qualification_evidence_origin_eq(
  left: ProductionQualificationEvidenceOrigin,
  right: ProductionQualificationEvidenceOrigin
) -> Bool {
  match left {
    FixtureInferredTreeOrigin =>
      match right {
        FixtureInferredTreeOrigin => true
        FixtureIngestInlineOrigin => false
        ExecutionMeasuredOrigin => false
      }
    FixtureIngestInlineOrigin =>
      match right {
        FixtureInferredTreeOrigin => false
        FixtureIngestInlineOrigin => true
        ExecutionMeasuredOrigin => false
      }
    ExecutionMeasuredOrigin =>
      match right {
        FixtureInferredTreeOrigin => false
        FixtureIngestInlineOrigin => false
        ExecutionMeasuredOrigin => true
      }
  }
}

fn production_qualification_is_production_axis(
  qualification: EmissionQualification
) -> Bool {
  match qualification {
    SourceProduced => true
    CargoGreen => true
    BehavioralEquivalent => false
    ProductionRouted => true
  }
}

fn production_qualification_evidence_origin_is_fixture(
  origin: ProductionQualificationEvidenceOrigin
) -> Bool {
  match origin {
    FixtureInferredTreeOrigin => true
    FixtureIngestInlineOrigin => true
    ExecutionMeasuredOrigin => false
  }
}

fn production_qualification_mint_site_matches_origin(
  row: ProductionQualificationMintSiteRow,
  origin: ProductionQualificationEvidenceOrigin
) -> Bool {
  production_qualification_evidence_origin_eq(
    left: row.evidence_origin,
    right: origin
  )
}

fn production_qualification_mint_site_matches_qualification(
  row: ProductionQualificationMintSiteRow,
  qualification: EmissionQualification
) -> Bool {
  emission_qualification_eq(left: row.qualification, right: qualification)
}

fn count_production_qualification_mint_sites_with_origin(
  origin: ProductionQualificationEvidenceOrigin
) -> Int {
  fold_list(
    xs: production_qualification_mint_sites,
    empty: 0,
    cons: fn(count, row) {
      if production_qualification_mint_site_matches_origin(row: row, origin: origin) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_production_qualification_mint_sites_with_qualification(
  qualification: EmissionQualification
) -> Int {
  fold_list(
    xs: production_qualification_mint_sites,
    empty: 0,
    cons: fn(count, row) {
      if production_qualification_mint_site_matches_qualification(
        row: row,
        qualification: qualification
      ) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_fixture_origin_production_qualification_mint_sites() -> Int {
  fold_list(
    xs: production_qualification_mint_sites,
    empty: 0,
    cons: fn(count, row) {
      if production_qualification_is_production_axis(qualification: row.qualification)
        && production_qualification_evidence_origin_is_fixture(origin: row.evidence_origin) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_execution_measured_production_qualification_mint_sites() -> Int {
  count_production_qualification_mint_sites_with_origin(
    origin: ExecutionMeasuredOrigin
  )
}

fn production_qualification_mint_site_count() -> Int {
  length(xs: production_qualification_mint_sites)
}

data fixture_origin_production_qualification_baseline: Int = 3

data fixture_ingest_inline_origin_mint_site_baseline: Int = 1

data fixture_inferred_tree_origin_mint_site_baseline: Int = 2

data execution_measured_production_qualification_baseline: Int = 0

data production_routed_mint_site_baseline: Int = 0

fn fixture_origin_production_qualification_baseline_holds() -> Bool {
  count_fixture_origin_production_qualification_mint_sites()
    == fixture_origin_production_qualification_baseline
}

fn fixture_ingest_inline_origin_mint_site_baseline_holds() -> Bool {
  count_production_qualification_mint_sites_with_origin(
    origin: FixtureIngestInlineOrigin
  ) == fixture_ingest_inline_origin_mint_site_baseline
}

fn fixture_inferred_tree_origin_mint_site_baseline_holds() -> Bool {
  count_production_qualification_mint_sites_with_origin(
    origin: FixtureInferredTreeOrigin
  ) == fixture_inferred_tree_origin_mint_site_baseline
}

fn execution_measured_production_qualification_baseline_holds() -> Bool {
  count_execution_measured_production_qualification_mint_sites()
    == execution_measured_production_qualification_baseline
}

fn production_routed_mint_site_baseline_holds() -> Bool {
  count_production_qualification_mint_sites_with_qualification(
    qualification: ProductionRouted
  ) == production_routed_mint_site_baseline
}

fn production_qualification_origin_census_holds() -> Bool {
  fixture_origin_production_qualification_baseline_holds()
    && fixture_ingest_inline_origin_mint_site_baseline_holds()
    && fixture_inferred_tree_origin_mint_site_baseline_holds()
    && execution_measured_production_qualification_baseline_holds()
    && production_routed_mint_site_baseline_holds()
    && (production_qualification_mint_site_count() == fixture_origin_production_qualification_baseline)
}

fn production_qualification_mint_site_for_id(
  site_id: Symbol
) -> Optional<ProductionQualificationMintSiteRow> {
  fold_list(
    xs: production_qualification_mint_sites,
    empty: optional_absent(),
    cons: fn(found, row) {
      match found {
        Present { value: _ } => found
        Absent =>
          if row.site_id == site_id {
            optional_present(value: row)
          } else {
            optional_absent()
          }
      }
    }
  )
}
