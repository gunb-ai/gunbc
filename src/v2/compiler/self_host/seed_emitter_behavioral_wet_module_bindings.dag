module v2.compiler.self_host.seed_emitter_behavioral_wet_module_bindings

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.text { String }

data seed_emitter_behavioral_wet_module_bindings_note: String = "Cycle-free leaf for restored SelfHostWetReceiptBinding rows (review 44453/44455/44460/44468): shared by wet_receipt_enrollment for nightly green wet roster enrollment only. Authorization does NOT derive from this list — producer_emission_canonical_receipt_for_executed_verdict is unwritable at baseline until witness-realization lands. (This condition used to name frontier_probe_survey as a second requirement; that probe and the self-host frontier roster it surveyed are deleted, so witness-realization is now the whole trigger rather than half of it.)"

type SelfHostWetReceiptBinding {
  module_path: String
  entry: String
  function: String
}

data falsifier_self_host_wet_module_bindings_revocation_note: String = "2026-07-25: the six SelfEmitted wet bindings were RED on cadence run 30126573464. Dissolve-on (reviews 44441/44453/44455/44460/44468): local wet receipt greens → restore SelfHostWetReceiptBinding here for re-enrollment onto a cadence that executes -- WHICH FalsifierSelfHostWet PRESENTLY IS NOT, falsifier.yml having been deleted at 611fd02770 (#8283, 2026-08-15). THE TRIGGER'S OWN MIDDLE STEP IS THE DEFECT, and it is a sharper class than a trigger that has gone stale: this trigger can still be discharged exactly as written -- a local wet receipt greens, a binding is restored -- and what discharging it PRODUCES is a binding that is enrolled and dark. A trigger that cannot fire is inert. A trigger whose discharge manufactures a FALSE COVERAGE CLAIM is worse than the absence it would close, because the restored binding reads as restored coverage to every consumer downstream of it, and DESIGN 4b rates a decoration cited as coverage worse than nothing. So the trigger is not merely unsatisfiable today: satisfying it is the wrong act until witness_cadence_has_scheduled_route(FalsifierSelfHostWet) answers true, which is the capability the trigger should have named and did not (DESIGN 4b(3): a trigger names the CAPABILITY, never an artifact that would contribute to one). Censused in gunbc.deleted_cadence_reference_census → witness-realization enables producer_emission_canonical_receipt_for_executed_verdict with execution-measured verdict digests. The frontier rows this clause used to gate on are gone with the self-host frontier roster; what remains gating is the binding itself, which stays absent until that path is host-wired."

data falsifier_self_host_wet_module_bindings: List<SelfHostWetReceiptBinding> = []

fn wet_receipt_binding_if_path_matches(
  module_path: String,
  b: SelfHostWetReceiptBinding
) -> Optional<SelfHostWetReceiptBinding> {
  if b.module_path == module_path {
    optional_present(value: b)
  } else {
    optional_absent()
  }
}

fn find_wet_receipt_binding(module_path: String) -> Optional<SelfHostWetReceiptBinding> {
  fold(
    falsifier_self_host_wet_module_bindings,
    init: Absent,
    f: fn(acc, b) {
      match acc {
        Present { value: _ } => acc
        Absent => wet_receipt_binding_if_path_matches(module_path: module_path, b: b)
      }
    }
  )
}
