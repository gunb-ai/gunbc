module v2.compiler.self_host.seed_emitter_behavioral_wet_module_bindings

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.text { String }

data seed_emitter_behavioral_wet_module_bindings_note: String = "Cycle-free leaf for restored SelfHostWetReceiptBinding rows (review 44453/44455/44460): shared by wet_receipt_enrollment for nightly green wet roster enrollment only. Authorization does NOT derive from this list — BuildGreen requires witness-realization mint via producer_emission_canonical_receipt_for_executed_verdict with admissible wet_execution_digest."

type SelfHostWetReceiptBinding {
  module_path: String
  entry: String
  function: String
}

data falsifier_self_host_wet_module_bindings_revocation_note: String = "2026-07-25: the six SelfEmitted wet bindings were RED on cadence run 30126573464. Dissolve-on (reviews 44441/44453/44455/44460): local wet receipt greens → restore SelfHostWetReceiptBinding here for nightly re-enrollment → witness-realization mints producer_emission_canonical_receipt_for_executed_verdict with admissible wet_execution_digest for BuildGreen authorization. Frontier rows stay SeedRetained until that execution-derived path fires."

data falsifier_self_host_wet_module_bindings: List<SelfHostWetReceiptBinding> = []

fn wet_receipt_binding_if_path_matches(
  module_path: String,
  b: SelfHostWetReceiptBinding
) -> Optional<SelfHostWetReceiptBinding> {
  if b.module_path == module_path {
    optional_present(value: b)
  } else {
    optional_absent()
  }
}

fn find_wet_receipt_binding(module_path: String) -> Optional<SelfHostWetReceiptBinding> {
  fold(
    falsifier_self_host_wet_module_bindings,
    init: Absent,
    f: fn(acc, b) {
      match acc {
        Present { value: _ } => acc
        Absent => wet_receipt_binding_if_path_matches(module_path: module_path, b: b)
      }
    }
  )
}
