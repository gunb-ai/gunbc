  ),
  retained_parity_open(
    family: "fold_closure",
    entry: "src/v2/test/claim/execution/emit_host_fold_closure_equals_eval_test.dag",
    f: "emit_host_fold_closure_equals_eval_holds"
  ),
  NativeRoutingFrontierRow {
    family: "meet_join",
    agreement_entry: "src/v2/test/claim/execution/emit_on_demand_family_crate_witness_test.dag",
    agreement_function: "emit_on_demand_family_crate_pr_native_agreement_holds",
    disposition: InterpretedRetained {
      reason: "agreement_red_on_main",
      dissolve_on: "routed_flip_reverted_note receipt: divergence root-caused with member + both values NAMED (agreement loudness gap closed first), then a fresh warm per-host agreement receipt — re-flip via routed_via_family_crate"
    }
  },
  retained_parity_open(
    family: "variant_construct",
    entry: "src/v2/test/claim/execution/emit_host_variant_construct_equals_eval_test.dag",
