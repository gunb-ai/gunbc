fn routing_frontier_total_holds() -> Bool {
  let roster_len = length(xs: native_routing_frontier_roster)
  let split_total = length(xs: native_routed_rows()) + length(xs: interpreted_retained_rows())
  split_total == roster_len
}

fn routing_row_is_native(row: NativeRoutingFrontierRow) -> Bool {
  match row.disposition {
    NativeRouted => true
    InterpretedRetained { reason: _, dissolve_on: _ } => false
  }
}

fn native_routed_rows() -> List<NativeRoutingFrontierRow> {
  fold(
    native_routing_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if routing_row_is_native(row: row) {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

fn interpreted_retained_rows() -> List<NativeRoutingFrontierRow> {
  fold(
    native_routing_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if routing_row_is_native(row: row) {
        acc
      } else {
        concat(acc, [row])
      }
    }
  )
}

fn subject_eq(a: DeclarationRef, b: DeclarationRef) -> Bool {
  (a.module_path == b.module_path) && (a.decl_name == b.decl_name)
}

fn routing_frontier_row_for_subject(subject: DeclarationRef) -> List<NativeRoutingFrontierRow> {
  fold(
    native_routing_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if subject_eq(a: row.subject, b: subject) {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

fn string_eq_native_routing(a: String, b: String) -> Bool {
  a == b
}

fn routing_frontier_agreement_entries_distinct() -> List<String> {
  fold(
    native_routing_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if contains(xs: acc, item: row.agreement_entry, eq: string_eq_native_routing) {
        acc
      } else {
        concat(acc, [row.agreement_entry])
      }
    }
  )
}

fn subject_module_source_paths(
  subject: DeclarationRef,
  facts: List<ModuleDeclarationFact>
) -> List<String> {
  fold(
    facts,
    init: [],
    f: fn(acc, fact) {
      if fact.module == subject.module_path {
        concat(acc, [fact.path])
      } else {
        acc
      }
    }
  )
}

type NativeRoutingEntryClosure {
  entry: String
  closure: List<String>
}

fn native_routing_pool_closures(
  pool_entries: List<String>,
  pool_roots: List<String>
) -> List<NativeRoutingEntryClosure> {
  let edges = dependency_resolution_facts_live(
    pool_roots: pool_roots,
    importer_roots: pool_roots,
    exclude_substrings: []
  )
  let nodes = module_declaration_facts_live(pool_roots: pool_roots)
  let adjacency = build_dependency_adjacency(
    edges: edges,
    nodes: nodes
  )
  fold(
    pool_entries,
    init: [],
    f: fn(acc, entry) {
      concat(
        acc,
        [
          NativeRoutingEntryClosure {
            entry: entry,
            closure: import_closure_bfs_walk(
              state: ImportClosureBfsState { reached: [entry], queue: [entry] },
              adjacency: adjacency
            )
          }
        ]
      )
    }
  )
}

fn native_routing_closure_reaches_subject(
  closure: List<String>,
  subject: DeclarationRef,
  facts: List<ModuleDeclarationFact>
) -> Bool {
  any(
    xs: subject_module_source_paths(subject: subject, facts: facts),
    predicate: fn(p) {
      contains(xs: closure, item: p, eq: string_eq_native_routing)
    }
  )
}

fn native_routing_row_membership_derived(
  row: NativeRoutingFrontierRow,
  pool: List<NativeRoutingEntryClosure>,
  facts: List<ModuleDeclarationFact>
) -> List<String> {
  fold(
    pool,
    init: [],
    f: fn(acc, ec) {
      if native_routing_closure_reaches_subject(
        closure: ec.closure,
        subject: row.subject,
        facts: facts
      ) {
        concat(acc, [ec.entry])
      } else {
        acc
      }
    }
  )
}

fn native_routing_membership_facts_live(pool_roots: List<String>) -> List<ModuleDeclarationFact> {
  module_declaration_facts_live(pool_roots: pool_roots)
}
