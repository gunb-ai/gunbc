module v2.compiler.self_host.native_routing_frontier

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.algebra { length }

data native_routing_frontier_note: String = "Per-family execution-routing frontier (P6 cutover mechanism, planned 2026-07-22): each enrolled emit-on-demand witness family is EXACTLY one of NativeRouted (its equals_eval agreement legs run native in the per-PR floor via gunbc_pr_native_batch, warm against GUNBC_NATIVE_CACHE_ROOT) or InterpretedRetained (a declared row with reason + dissolve_on — countable, prioritizable, never a silent default; the self-host-frontier pattern applied to execution routing). The flip NativeRouted is DATA gated by the parity window (v2.compiler.self_host.parity_window): N consecutive green falsifier cadence windows (agreement + warm compile_skipped=true) are required evidence; a refusal or divergence resets the window. One authority decides both sides of the floor: the per-PR native batch enrolls NativeRouted families and interpreted discovery drops exactly those — no dual representation. All 9 families start InterpretedRetained with reason parity_window_open at landing; the PR ships the machine, receipts flip it."

type NativeRoutingDisposition
  = NativeRouted
  | InterpretedRetained { reason: String, dissolve_on: String }

type NativeRoutingFrontierRow {
  family: String
  agreement_entry: String
  agreement_function: String
  disposition: NativeRoutingDisposition
}

fn retained_parity_open(family: String, entry: String, f: String) -> NativeRoutingFrontierRow {
  NativeRoutingFrontierRow {
    family: family,
    agreement_entry: entry,
    agreement_function: f,
    disposition: InterpretedRetained {
      reason: "no_cached_no_evict_carrier",
      dissolve_on: "a no-evict cached agreement leg exists for this family (the family_crate pr_native pattern) AND its parity window is green per v2.compiler.self_host.parity_window; the equals_eval legs are UNCACHED (srv1 sweep receipt 2026-07-22: empty native-cache fields) so routing them would build every PR run"
    }
  }
}

data routed_flip_reverted_note: String = "FIRST FLIP REVERTED BY RECEIPT (2026-07-22): complement + meet_join were NativeRouted at #7069 landing; main run 29963619401 (2a226829f, srv2-05, 23:28Z) redded emit_on_demand_family_crate_pr_native_agreement_holds WARM — native-cache key=8f21f541808ddb22, compile_skipped=true on all three members, witness false in 496ms — so this is a genuine native-vs-eval divergence or member-run failure, NOT a cold cache. The frontier worked as designed: the revert is this one data edit, the investigation proceeds off the merge-critical path, and the falsifier cold control keeps exercising both legs. Named loudness gap to close BEFORE re-flipping: the agreement fn's false carries no located member and no value pair — a divergence receipt must NAME which member and both answers (DESIGN 5: typed, located). routed_via_family_crate below is retained as the re-flip constructor."

fn routed_via_family_crate(family: String) -> NativeRoutingFrontierRow {
  NativeRoutingFrontierRow {
    family: family,
    agreement_entry: "src/v2/test/claim/execution/emit_on_demand_family_crate_witness_test.dag",
    agreement_function: "emit_on_demand_family_crate_pr_native_agreement_holds",
    disposition: NativeRouted
  }
}

