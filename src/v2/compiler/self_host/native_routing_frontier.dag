module v2.compiler.self_host.native_routing_frontier

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.algebra { length, any, contains }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.lens.module_graph {
  ModuleDeclarationFact,
  module_declaration_facts_live,
  dependency_resolution_facts_live,
  build_dependency_adjacency,
  import_closure_bfs_walk,
  ImportClosureBfsState
}

data native_routing_frontier_note: String = "Per-family execution-routing frontier (P6 cutover mechanism, planned 2026-07-22): each enrolled emit-on-demand witness family is EXACTLY one of NativeRouted (its equals_eval agreement legs run native in the per-PR floor via gunbc_pr_native_batch, warm against GUNBC_NATIVE_CACHE_ROOT) or InterpretedRetained (a declared row with reason + dissolve_on — countable, prioritizable, never a silent default; the self-host-frontier pattern applied to execution routing). The flip NativeRouted is DATA, and since 2026-07-28 it is NOT pre-gated by a parity streak (demotion — see parity_window_note and routed_flip_reverted_note): the flip bar is a no-evict cached agreement leg for the family plus one warm green agreement receipt, and v2.compiler.self_host.parity_window monitors every NativeRouted family POST-flip — a red falsifier cadence window (agreement red, or warm compile_skipped=false) LATCHES ParityRevertRequired naming the first red window (a later green never clears it; only an explicit RevertAcknowledged observation opens a new epoch — operator rework ruling 2026-07-28), and the row reverts by one data edit while the investigation proceeds off the merge-critical path (the reverted-first-flip incident below, promoted to law). One authority decides both sides of the floor: the per-PR native batch enrolls NativeRouted families and interpreted discovery drops exactly those — no dual representation."

data native_routing_subject_key_note: String = "Subject re-key (group-of-units ruling 2026-07-22, gunbc.roster_registry): a family's identity is its SUBJECT — a DeclarationRef to the construct/fixture declaration the family exercises — never a bare family: String nickname. Membership is DERIVED: an agreement entry is a member of a family exactly when its dependency closure (import + reference edges, the v2.lens.module_graph authority) reaches the subject's module — native_routing_row_membership_derived below is the ByDerivation predicate gunbc.roster_registry names, witnessed by the equivalence receipt in native_routing_membership_receipt_test (derived membership == the bound agreement entry, per row, plus a RED control: an entry whose closure does not reach the subject is not a member). The parity-window receipts (parity_receipts_local) stay keyed by their falsifier-observation family names; the frontier test binds those receipts to subject-keyed rows explicitly — observation data, not a second row key."

type NativeRoutingDisposition
  = NativeRouted
  | InterpretedRetained { reason: String, dissolve_on: String }

type NativeRoutingFrontierRow {
  subject: DeclarationRef
  agreement_entry: String
  agreement_function: String
  disposition: NativeRoutingDisposition
}

fn family_subject(module_path: String, decl_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path,
    decl_name: decl_name,
    field: WholeDeclaration
  }
}

fn retained_no_cached_carrier(
  subject: DeclarationRef,
  entry: String,
  f: String
) -> NativeRoutingFrontierRow {
  NativeRoutingFrontierRow {
    subject: subject,
    agreement_entry: entry,
    agreement_function: f,
    disposition: InterpretedRetained {
      reason: "no_cached_no_evict_carrier",
      dissolve_on: "a no-evict cached agreement leg exists for this family (the family_crate pr_native pattern) with one warm green agreement receipt; the equals_eval legs are UNCACHED (srv1 sweep receipt 2026-07-22: empty native-cache fields) so routing them would build every PR run. On flip the family enrolls in post-flip monitoring per v2.compiler.self_host.parity_window (no pre-flip streak is required — demotion 2026-07-28)"
    }
  }
}

data routed_flip_reverted_note: String = "FIRST FLIP REVERTED BY RECEIPT (2026-07-22): complement + meet_join were NativeRouted at #7069 landing; main run 29963619401 (2a226829f, srv2-05, 23:28Z) redded emit_on_demand_family_crate_pr_native_agreement_holds WARM — native-cache key=8f21f541808ddb22, compile_skipped=true on all three members, witness false in 496ms — so this is a genuine native-vs-eval divergence or member-run failure, NOT a cold cache. The frontier worked as designed: the revert is this one data edit, the investigation proceeds off the merge-critical path, and the falsifier cold control keeps exercising both legs. Named loudness gap to close BEFORE re-flipping: the agreement fn's false carries no located member and no value pair — a divergence receipt must NAME which member and both answers (DESIGN 5: typed, located). routed_via_family_crate below is retained as the re-flip constructor. DEMOTION RECEIPT (2026-07-28): both families had SATISFIED the pre-flip parity streak (three green srv1 probe windows) and this red happened anyway — so the streak gate was not the operative protection, this revert mechanism was; parity_window is accordingly demoted to post-flip monitoring (parity_window_note), whose ParityRevertRequired verdict is exactly the demand this incident answered by hand."

fn routed_via_family_crate(subject: DeclarationRef) -> NativeRoutingFrontierRow {
  NativeRoutingFrontierRow {
    subject: subject,
    agreement_entry: "src/v2/test/claim/execution/emit_on_demand_family_crate_witness_test.dag",
    agreement_function: "emit_on_demand_family_crate_pr_native_agreement_holds",
    disposition: NativeRouted
  }
}

