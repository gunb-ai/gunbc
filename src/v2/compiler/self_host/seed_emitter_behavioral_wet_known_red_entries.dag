module v2.compiler.self_host.seed_emitter_behavioral_wet_known_red_entries

import std.realization_schedule { ScheduleWitnessEntry, ExecutionWitnessKind }
import v2.std.algebra { any, fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data seed_emitter_behavioral_wet_known_red_entries_note: String = "Single authority for the six V1SeedEmitter behavioral wet expect_red quarantine receipts (review #7199, re-homed under emitter_producer_provenance 2026-07-29). Consumed by v2.compiler.self_host.wet_receipt_enrollment (falsifier batch enrollment) and v2.compiler.self_host.emitter_producer_provenance (producer receipt citation gate). Cycle-free leaf: neither consumer is imported here."

fn seed_emitter_behavioral_wet_known_red_entry(entry: String, f: String) -> ScheduleWitnessEntry {
  ScheduleWitnessEntry { entry: entry, function: f, kind: ExecutionWitnessKind }
}

data seed_emitter_behavioral_wet_known_red_entries: List<ScheduleWitnessEntry> = [
  seed_emitter_behavioral_wet_known_red_entry(
