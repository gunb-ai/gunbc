fn schedule_witness_entry_eq(left: ScheduleWitnessEntry, right: ScheduleWitnessEntry) -> Bool {
  (left.entry == right.entry) && (left.function == right.function)
}

fn schedule_witness_entry_cited(
  probe_entry: String,
  probe_function: String,
  entries: List<ScheduleWitnessEntry>
) -> Bool {
  any(
    xs: entries,
    predicate: fn(entry) {
      (entry.entry == probe_entry) && (entry.function == probe_function)
    }
  )
}

fn schedule_witness_entries_structurally_equal(
  left: List<ScheduleWitnessEntry>,
  right: List<ScheduleWitnessEntry>
) -> Bool {
  if length(xs: left) != length(xs: right) {
    false
  } else {
    fold_list(
      left,
      empty: true,
      cons: fn(ok, left_entry) {
        ok && any(
          xs: right,
          predicate: fn(right_entry) {
            schedule_witness_entry_eq(left: left_entry, right: right_entry)
          }
        )
      }
    )
  }
}
