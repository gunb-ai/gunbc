module v2.compiler.self_host.witness_entry_eligibility_census

import v2.std.logic { Bool }
import v2.std.text { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.witness_execution_routing {
  WitnessExecutionDisposition,
  InterpretedRetained,
  EmitIneligible,
  BulkFlipPendingCensusIncomplete,
  HostFedCeiling,
  EmitOnDemandFamilyGrain,
  RetainedReadsLiveTreeCarrier,
  LongLaneScheduled,
  OfflineLocalRecipe,
  CensusPending
}

data witness_entry_eligibility_census_note: String = "Entry-grain eligibility census (ROADMAP 2a Lane B, 2026-07-23): mechanical roster of every discovery witness entry closure under dag/test/claim + src/v2/test/claim. Carrier: docs/probes/witness_entry_eligibility_census.tsv (regenerated by scripts/witness_entry_eligibility_census.sh). Histogram: docs/probes/witness_entry_eligibility_histogram.txt. Rows land in Derived Group form — subject_module + subject_decl cite the entry's module authority (witness_entry is the entry-grain subject until per-entry DeclarationRef subjects graduate from module_graph). first_error_class=CensusPending until the srvN cssl sweep names measured EmitIneligibleCause variants; the 16-entry witness_bulk_routing sample remains the stratified slice. Dissolve-on: witness_bulk_routing roster grows to totality (this count) and rows derive from TSV + module_graph closure membership."

data witness_entry_eligibility_census_tsv_path: String = "docs/probes/witness_entry_eligibility_census.tsv"

data witness_entry_eligibility_histogram_path: String = "docs/probes/witness_entry_eligibility_histogram.txt"

data witness_entry_eligibility_census_entry_count: Int = 760

data witness_entry_eligibility_census_stamp: String = "2026-07-23T05:16Z"

fn witness_entry_subject(entry_module: String) -> DeclarationRef {
  DeclarationRef {
    module_path: entry_module,
    decl_name: "witness_entry",
    field: WholeDeclaration
  }
}

fn census_pending_interpreted_retained(entry: String) -> WitnessExecutionDisposition {
  InterpretedRetained {
    reason: BulkFlipPendingCensusIncomplete,
    dissolve_on: "srvN cssl sweep receipt names first-error class for this entry; row flips to NativeRouted or EmitIneligible in bulk flip PR (ROADMAP 2a section 3)"
  }
}

fn census_emit_on_demand_family_grain(entry: String) -> WitnessExecutionDisposition {
  InterpretedRetained {
    reason: EmitOnDemandFamilyGrain,
    dissolve_on: "native_routing_frontier flips owning family to NativeRouted with warm per-PR agreement receipt; entry-grain row derives NativeRouted from family membership"
  }
}

fn census_long_lane_ineligible(entry: String) -> WitnessExecutionDisposition {
  EmitIneligible {
    cause: LongLaneScheduled,
    detail: "exceeds per-PR 5s fast-lane eval budget; scheduled falsifier/long-lane consumer only"
  }
}

fn census_offline_recipe_ineligible(entry: String) -> WitnessExecutionDisposition {
  EmitIneligible {
    cause: OfflineLocalRecipe,
    detail: "operator-ruled offline; explicit local claim_batch recipe is the executing consumer"
  }
}

fn witness_entry_eligibility_census_meets_floor() -> Bool {
  witness_entry_eligibility_census_entry_count > 0
    && witness_entry_eligibility_census_entry_count >= 744
}
