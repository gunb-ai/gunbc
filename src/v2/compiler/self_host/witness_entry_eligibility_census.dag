module v2.compiler.self_host.witness_entry_eligibility_census

import v2.std.logic { Bool }
import v2.std.text { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.witness_execution_routing {
  WitnessExecutionDisposition,
  NativeRouted,
  InterpretedRetained,
  EmitIneligible,
  BulkFlipPendingCensusIncomplete,
  HostFedCeiling,
  EmitOnDemandFamilyGrain,
  RetainedReadsLiveTreeCarrier,
  LongLaneScheduled,
  OfflineLocalRecipe,
  CensusPending
}

data witness_entry_eligibility_census_note: String = "Entry-grain eligibility census (ROADMAP 2a Lane B, 2026-07-23): mechanical roster of every discovery witness entry closure under dag/test/claim + src/v2/test/claim. Carrier: docs/probes/witness_entry_eligibility_census.tsv (regenerated by scripts/witness_entry_eligibility_census.sh → witness_entry_eligibility_census_emit host transport). Histogram: docs/probes/witness_entry_eligibility_histogram.txt. Classification authority lives HERE — disposition, reason, and execution_leg columns derive from census_* fns below; bash and cli_run must not re-implement these rules (review 41756). Rows land in Derived Group form — subject_module + subject_decl cite the entry's module authority (witness_entry is the entry-grain subject until per-entry DeclarationRef subjects graduate from module_graph). first_error_class=CensusPending until the srvN cssl sweep names measured EmitIneligibleCause variants; the 16-entry witness_bulk_routing sample remains the stratified slice. Dissolve-on: witness_bulk_routing roster grows to totality (this count) and rows derive from TSV + module_graph closure membership."

data witness_entry_eligibility_census_tsv_path: String = "docs/probes/witness_entry_eligibility_census.tsv"

data witness_entry_eligibility_census_histogram_path: String = "docs/probes/witness_entry_eligibility_histogram.txt"

data witness_entry_eligibility_census_entry_count: Int = 762

data witness_entry_eligibility_census_stamp: String = "2026-07-23T07:20Z"

fn witness_entry_subject(entry_module: String) -> DeclarationRef {
  DeclarationRef {
    module_path: entry_module,
    decl_name: "witness_entry",
    field: WholeDeclaration
  }
}

fn census_entry_path_contains(entry: String, pattern: String) -> Bool {
  string_contains(s: entry, pattern: pattern)
}

fn census_entry_path_matches_long_lane(entry: String) -> Bool {
  census_entry_path_contains(entry: entry, pattern: "/long/")
}

fn census_entry_path_matches_offline_recipe(entry: String) -> Bool {
  census_entry_path_contains(entry: entry, pattern: "/manual/")
    || census_entry_path_contains(entry: entry, pattern: "/complexity/")
}

fn census_entry_path_matches_host_fed_ceiling(entry: String) -> Bool {
  census_entry_path_contains(entry: entry, pattern: "effect_reach")
    || census_entry_path_contains(entry: entry, pattern: "uri_witness")
    || census_entry_path_contains(entry: entry, pattern: "install_media")
}

fn census_entry_path_matches_reads_live_tree_carrier(entry: String) -> Bool {
  census_entry_path_contains(entry: entry, pattern: "lens_module_gate")
    || census_entry_path_contains(entry: entry, pattern: "mandatory_tag")
}

fn census_entry_path_matches_emit_on_demand(entry: String) -> Bool {
  census_entry_path_contains(entry: entry, pattern: "emit_on_demand")
}

fn census_pending_interpreted_retained(entry: String) -> WitnessExecutionDisposition {
  InterpretedRetained {
    reason: BulkFlipPendingCensusIncomplete,
    dissolve_on: "srvN cssl sweep receipt names first-error class for this entry; row flips to NativeRouted or EmitIneligible in bulk flip PR (ROADMAP 2a section 3)"
  }
}

fn census_emit_on_demand_family_grain(entry: String) -> WitnessExecutionDisposition {
  InterpretedRetained {
    reason: EmitOnDemandFamilyGrain,
    dissolve_on: "native_routing_frontier flips owning family to NativeRouted with warm per-PR agreement receipt; entry-grain row derives NativeRouted from family membership"
  }
}

fn census_host_fed_ceiling_retained(entry: String) -> WitnessExecutionDisposition {
  InterpretedRetained {
    reason: HostFedCeiling,
    dissolve_on: "native host-effect transport lane retires host_fed ceiling; row reclassifies from InterpretedRetained"
  }
}

fn census_reads_live_tree_carrier_retained(entry: String) -> WitnessExecutionDisposition {
  InterpretedRetained {
    reason: RetainedReadsLiveTreeCarrier,
    dissolve_on: "G2 live-read classification + native host-effect transport retire ReadsLiveTree carrier rows"
  }
}

fn census_long_lane_ineligible(entry: String) -> WitnessExecutionDisposition {
  EmitIneligible {
    cause: LongLaneScheduled,
    detail: "exceeds per-PR 5s fast-lane eval budget; scheduled falsifier/long-lane consumer only"
  }
}

fn census_offline_recipe_ineligible(entry: String) -> WitnessExecutionDisposition {
  EmitIneligible {
    cause: OfflineLocalRecipe,
    detail: "operator-ruled offline; explicit local claim_batch recipe is the executing consumer"
  }
}

fn census_disposition_for_entry(entry: String) -> WitnessExecutionDisposition {
  if census_entry_path_matches_long_lane(entry: entry) {
    census_long_lane_ineligible(entry: entry)
  } else if census_entry_path_matches_offline_recipe(entry: entry) {
    census_offline_recipe_ineligible(entry: entry)
  } else if census_entry_path_matches_host_fed_ceiling(entry: entry) {
    census_host_fed_ceiling_retained(entry: entry)
  } else if census_entry_path_matches_reads_live_tree_carrier(entry: entry) {
    census_reads_live_tree_carrier_retained(entry: entry)
  } else if census_entry_path_matches_emit_on_demand(entry: entry) {
    census_emit_on_demand_family_grain(entry: entry)
  } else {
    census_pending_interpreted_retained(entry: entry)
  }
}

fn census_disposition_column_for_entry(entry: String) -> String {
  match census_disposition_for_entry(entry: entry) {
    NativeRouted => "NativeRouted"
    InterpretedRetained { reason: _, dissolve_on: _ } => "InterpretedRetained"
    EmitIneligible { cause: _, detail: _ } => "EmitIneligible"
  }
}

fn census_reason_column_for_entry(entry: String) -> String {
  match census_disposition_for_entry(entry: entry) {
    NativeRouted => "NativeRouted"
    InterpretedRetained { reason: reason, dissolve_on: _ } =>
      match reason {
        BulkFlipPendingCensusIncomplete => "BulkFlipPendingCensusIncomplete"
        HostFedCeiling => "HostFedCeiling"
        EmitOnDemandFamilyGrain => "EmitOnDemandFamilyGrain"
        RetainedPendingLongLane => "RetainedPendingLongLane"
        RetainedPendingOfflineRecipe => "RetainedPendingOfflineRecipe"
        RetainedReadsLiveTreeCarrier => "RetainedReadsLiveTreeCarrier"
      }
    EmitIneligible { cause: cause, detail: _ } =>
      match cause {
        LongLaneScheduled => "LongLaneScheduled"
        OfflineLocalRecipe => "OfflineLocalRecipe"
        HostEffectTransportMissing => "HostEffectTransportMissing"
        ReadsLiveTreeCarrier => "ReadsLiveTreeCarrier"
        EvalBudgetExceeded => "EvalBudgetExceeded"
        EmitAssembleRefuse => "EmitAssembleRefuse"
        ImportClosureCargoRefuse => "ImportClosureCargoRefuse"
        NamespaceQualifiedRustEmit => "NamespaceQualifiedRustEmit"
        TypeRefImportMissing => "TypeRefImportMissing"
        ClosureNameCollision => "ClosureNameCollision"
        CensusPending => "CensusPending"
        EmitIneligibleUnknown => "EmitIneligibleUnknown"
      }
  }
}

data census_native_family_crate_leg_label: String = concat(
  "NativeFamilyLeg{",
  concat("family_crate", "}")
)

data census_emit_on_demand_family_grain_leg_label: String = concat(
  "InterpretedLeg{",
  concat("EmitOnDemandFamilyGrain", "}")
)

data census_default_interpreted_leg_label: String = "InterpretedLeg"

fn census_execution_leg_label(entry: String) -> String {
  if census_entry_path_contains(entry: entry, pattern: "emit_on_demand_family_crate") {
    census_native_family_crate_leg_label
  } else if census_entry_path_matches_emit_on_demand(entry: entry) {
    census_emit_on_demand_family_grain_leg_label
  } else {
    census_default_interpreted_leg_label
  }
}

fn census_first_error_class_column() -> String {
  "CensusPending"
}

fn witness_entry_eligibility_census_meets_floor() -> Bool {
  witness_entry_eligibility_census_entry_count > 0
    && witness_entry_eligibility_census_entry_count >= 744
}
