module v2.compiler.self_host.frontier_probe_semantic_family_receipt


data semantic_family_receipt_note: String = "SH-D D1: what the five semantic-pipeline shards MEASURE at the v2 direct Rust door, as executed observations rather than expectations. Each row is one shard, and the two dispositions are not two flavours of the same answer: a shard whose closure fits the manifest transport produces a detailed cause, and a shard whose closure exceeds the inline row cap produces nothing at all — the manifest emits zero rows and an empty ingest, so there is no observation to record. Recording the second as a measurement with absent fields would make the cap look like a property of the module. The rows carry no verdict about the frontier roster; frontier.dag is the program lead's authority and this module supplies it evidence, never a correction."

data semantic_family_subject_note: String = "Provenance of these observations, so a reader can re-derive rather than trust them: source_commit 2bc11e0cd53, survey/probe binaries built from that tree, closures produced by discover_source_root_ingest against source roots src/v2 and dag, receipts read through frontier_probe_emit_from_ingest. The measured shards were read on UNPATCHED main for materialization_carriers, and for use_site_verdict with the annotation-channel hunk of gunbc#8149 (commit fa2576a9) applied locally, because on unpatched main that shard's closure refuses at the lexer before reaching the layer under study. Which side each row was read on is carried per row, not assumed."

type ShardObservationSide
  = ObservedOnMain
  | ObservedWithAnnotationChannelHunk { upstream_commit: String }

type ShardDoorDisposition
  = DetailedCauseObserved {
      located_reason: v2.std.node.Symbol,
      chain_length: v2.std.integer.Int,
      symbols_differing_from_head: v2.std.integer.Int,
      first_differing_symbol: String
    }
  | ClosureExceedsManifestCap { read_count: v2.std.integer.Int, cap: v2.std.integer.Int }

type SemanticFamilyShardRow {
  module_path: String
  closure_reads: v2.std.integer.Int
  side: ShardObservationSide
  disposition: ShardDoorDisposition
}

data shard_use_site_verdict: SemanticFamilyShardRow = SemanticFamilyShardRow {
  module_path: "src/v2/compiler/use_site_verdict.dag",
  closure_reads: 15,
  side: ObservedWithAnnotationChannelHunk { upstream_commit: "fa2576a9" },
  disposition: DetailedCauseObserved {
    located_reason: ^parse_grammar_choice_overlap_residue,
    chain_length: 126,
    symbols_differing_from_head: 120,
    first_differing_symbol: "body_lowering_reason_wrapper_retained_emitted"
  }
}

data shard_materialization_carriers: SemanticFamilyShardRow = SemanticFamilyShardRow {
  module_path: "src/v2/compiler/materialization_carriers.dag",
  closure_reads: 48,
  side: ObservedOnMain,
  disposition: DetailedCauseObserved {
    located_reason: ^parse_grammar_choice_overlap_residue,
    chain_length: 11,
    symbols_differing_from_head: 5,
    first_differing_symbol: "body_lowering_reason_wrapper_retained_emitted"
  }
}

data shard_03_resolve: SemanticFamilyShardRow = SemanticFamilyShardRow {
  module_path: "src/v2/compiler/03_resolve.dag",
  closure_reads: 71,
  side: ObservedOnMain,
  disposition: ClosureExceedsManifestCap { read_count: 71, cap: 64 }
}

data shard_04_infer: SemanticFamilyShardRow = SemanticFamilyShardRow {
  module_path: "src/v2/compiler/04_infer.dag",
  closure_reads: 75,
  side: ObservedOnMain,
  disposition: ClosureExceedsManifestCap { read_count: 75, cap: 64 }
}

data shard_03_name_resolve: SemanticFamilyShardRow = SemanticFamilyShardRow {
  module_path: "src/v2/compiler/03_name_resolve.dag",
  closure_reads: 143,
  side: ObservedOnMain,
  disposition: ClosureExceedsManifestCap { read_count: 143, cap: 64 }
}

data semantic_family_shard_rows: List<SemanticFamilyShardRow> = [
  shard_use_site_verdict,
  shard_materialization_carriers,
  shard_03_resolve,
  shard_04_infer,
  shard_03_name_resolve
]

data semantic_family_recorded_reason_correction_note: String = "CORRECTION (2026-08-13, vivid-bat-377 executed finding, mechanism re-verified here): the sentence this row used to carry — that the recorded reason is CONFIRMED at reason grain — is WITHDRAWN, and it was withdrawn for a stronger reason than being unproven. ^parse_grammar_choice_overlap_residue is not a per-module cause at all. v2.compiler.02_parse grammar_choice_ambiguity_roster_from_analysis folds over root.productions ALONE — no module, no source text, no closure is an input — so the roster is grammar-global and constant, and rejected_with_pending PREPENDS it to any later rejection. The head of a parse failure is therefore that residue for ANY module under the dag grammar, unconditionally. Agreement between a receipt and a frontier row on that symbol is agreement with a constant: it discriminates nothing, so it can neither confirm nor disconfirm the row. A population that is everything is not evidence.\n\nWHAT SURVIVES UNCHANGED, and why the distinction is not special pleading: every figure in the rows above is a TAIL read. first_differing_symbol is by construction the first chain symbol DIFFERING from the head, so the constant prefix is exactly what it skips; chain_length and symbols_differing_from_head are counts over the whole chain. The body-lowering finding was reached by going past the head, which is why it survived a defect that invalidated the head reading. What changed is the standing of the recorded ROW, not the standing of the measurement."

data semantic_family_masking_finding_note: String = "THE FINDING, at the grain the evidence supports. Both measurable shards refuse with a head of ^parse_grammar_choice_overlap_residue — a grammar-global constant that says nothing about either module (see the correction note above; an earlier revision of this row read that agreement as confirming the frontier rows, which it cannot). The cause in both is MaskedAssembleRefusal, and masked means that constant is standing in front of a further chain. Reading those chains: use_site_verdict carries 126 symbols of which 120 differ from the head, materialization_carriers carries 11 of which 5 differ, and in BOTH the first differing symbol is body_lowering_reason_wrapper_retained_emitted. So the recorded reason is neither confirmed nor terminal, and what the chains DO show is unaffected by that: the dominant refusal underneath is body-lowering wrapper-retained residue, whose named prerequisite is the general body producer. What this does NOT establish: that body lowering is the LAST layer. A chain read one symbol deep answers what the mask hides, not what that in turn hides, and nothing here has looked beneath the second layer."

data semantic_family_cap_finding_note: String = "The three shards above 64 reads were UNOBSERVED at commit 2bc11e0 because the inline-text carrier capped at MANIFEST_INLINE_LIST_MAX. Capless closure transport (SourceRef rows, read-through ingest) removes that transport ceiling; a fresh frontier_probe_survey at the current head is required to replace ClosureExceedsManifestCap dispositions with detailed causes. This note records the pre-capless measurement only."

data semantic_family_closure_drift_note: String = "OBSERVED DRIFT, reported and not acted on: the frontier roster records closure_reads 9 for use_site_verdict and 35 for materialization_carriers; discover_source_root_ingest measures 15 and 48 at this commit. The rows are the program lead's authority and are not edited from here. Stated precisely, because the two are different claims: what is established is that the closure sizes differ from the recorded ones at this commit, NOT that either row's blocker classification is wrong."

fn shard_count() -> v2.std.integer.Int {
  fold_list(xs: semantic_family_shard_rows, empty: 0, cons: fn(n, _r) { n + 1 })
}

fn measured_shard_count() -> v2.std.integer.Int {
  fold_list(
    xs: semantic_family_shard_rows,
    empty: 0,
    cons: fn(n, r) {
      match r.disposition {
        DetailedCauseObserved {
          located_reason: _,
          chain_length: _,
          symbols_differing_from_head: _,
          first_differing_symbol: _
        } => n + 1
        ClosureExceedsManifestCap { read_count: _, cap: _ } => n
      }
    }
  )
}

fn capped_shard_count() -> v2.std.integer.Int {
  fold_list(
    xs: semantic_family_shard_rows,
    empty: 0,
    cons: fn(n, r) {
      match r.disposition {
        ClosureExceedsManifestCap { read_count: _, cap: _ } => n + 1
        DetailedCauseObserved {
          located_reason: _,
          chain_length: _,
          symbols_differing_from_head: _,
          first_differing_symbol: _
        } => n
      }
    }
  )
}

fn shards_naming_body_lowering_beneath_the_mask() -> v2.std.integer.Int {
  fold_list(
    xs: semantic_family_shard_rows,
    empty: 0,
    cons: fn(n, r) {
      match r.disposition {
        DetailedCauseObserved {
          located_reason: _,
          chain_length: _,
          symbols_differing_from_head: _,
          first_differing_symbol: s
        } =>
          if s == "body_lowering_reason_wrapper_retained_emitted" { n + 1 } else { n }
        ClosureExceedsManifestCap { read_count: _, cap: _ } => n
      }
    }
  )
}

fn every_capped_shard_exceeds_its_own_cap() -> v2.std.logic.Bool {
  fold_list(
    xs: semantic_family_shard_rows,
    empty: true,
    cons: fn(ok, r) {
      match r.disposition {
        ClosureExceedsManifestCap { read_count: reads, cap: cap } => ok && (reads > cap)
        DetailedCauseObserved {
          located_reason: _,
          chain_length: _,
          symbols_differing_from_head: _,
          first_differing_symbol: _
        } => ok
      }
    }
  )
}

fn every_measured_chain_is_non_uniform() -> v2.std.logic.Bool {
  fold_list(
    xs: semantic_family_shard_rows,
    empty: true,
    cons: fn(ok, r) {
      match r.disposition {
        DetailedCauseObserved {
          located_reason: _,
          chain_length: len,
          symbols_differing_from_head: differing,
          first_differing_symbol: _
        } => ok && (differing > 0) && (differing < len)
        ClosureExceedsManifestCap { read_count: _, cap: _ } => ok
      }
    }
  )
}
