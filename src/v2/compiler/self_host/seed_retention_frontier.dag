type SeedRetentionCensusRow
  = RetainedRostered { crate_relative_path: String }
  | RetainedUnrostered { crate_relative_path: String }
  | RosterRowWithoutObservedPath { crate_relative_path: String }
  | RosteredPathIsCompared { crate_relative_path: String }

type SeedRetentionCensus {
  rostered: List<SeedRetentionCensusRow>
  unrostered: List<SeedRetentionCensusRow>
  stale_rows: List<SeedRetentionCensusRow>
  compared_collisions: List<SeedRetentionCensusRow>
}

data seed_retention_mutation_receipt_note: String = "MUTATION RECEIPT, executed 2026-08-24 on a linux/amd64 runner at branch head, claim_batch over v2.test.claim.self_host.seed_retention_frontier_test. Baseline: all eight witnesses PASS. Treatment: path_in's predicate rewritten from 'candidate == path' to 'candidate == candidate', which makes every membership question answer true and so collapses all three joins at once. Result: the five join probes go FAIL — control totality, control classification, and each of the three planted refusals — while the three roster-only probes (uniqueness, reason split, both populations non-empty) stay PASS, which is correct because none of them reaches path_in. So the refusals are load-bearing rather than green by construction, and the split tells which probe covers which mechanism. The receipt is a per-arm one and not a whole-file one on purpose: a mutation that reds EVERY probe proves only that the file was consulted."

fn path_in(path: String, paths: List<String>) -> Bool {
  v2.std.algebra.any(xs: paths, predicate: fn(candidate) { candidate == path })
}

fn roster_paths(roster: List<SeedRetentionFrontierRow>) -> List<String> {
  fold(
    roster,
    init: [],
    f: fn(acc, row) { concat(acc, [row.crate_relative_path]) }
  )
}

data census_takes_its_roster_note: String = "THE ROSTER IS A PARAMETER, and that is what makes the three refusals executable rather than specified. A census closed over seed_retention_frontier_roster could only be probed with a fixture that enumerates all 92 live paths — a measurement copied from the current tree, which DESIGN section 5 rejects as an oracle, and which would go red on every unrelated seed edit. Parameterized, the discriminating REDs are authored over a four-row synthetic roster: the probe supplies the world AND the roster, plants exactly one defect, and the assertion has a reachable opposite answer. seed_retention_frontier_census binds the live roster for consumers; nothing about the mechanism differs between the two."

fn seed_retention_census(
  roster: List<SeedRetentionFrontierRow>,
  observed_crate_rust_paths: List<String>,
  compared_crate_rust_paths: List<String>
) -> SeedRetentionCensus {
  let rostered_paths = roster_paths(roster: roster)
  let retained_rows = fold(
    observed_crate_rust_paths,
    init: SeedRetentionCensus { rostered: [], unrostered: [], stale_rows: [], compared_collisions: [] },
    f: fn(acc, path) {
      if path_in(path: path, paths: compared_crate_rust_paths) {
        acc
      } else {
        if path_in(path: path, paths: rostered_paths) {
          SeedRetentionCensus {
            rostered: concat(acc.rostered, [RetainedRostered { crate_relative_path: path }]),
            unrostered: acc.unrostered,
            stale_rows: acc.stale_rows,
            compared_collisions: acc.compared_collisions
          }
        } else {
          SeedRetentionCensus {
            rostered: acc.rostered,
            unrostered: concat(acc.unrostered, [RetainedUnrostered { crate_relative_path: path }]),
            stale_rows: acc.stale_rows,
            compared_collisions: acc.compared_collisions
          }
        }
      }
    }
  )
  fold(
    rostered_paths,
    init: retained_rows,
    f: fn(acc, path) {
      if path_in(path: path, paths: compared_crate_rust_paths) {
        SeedRetentionCensus {
          rostered: acc.rostered,
          unrostered: acc.unrostered,
          stale_rows: acc.stale_rows,
          compared_collisions: concat(
            acc.compared_collisions,
            [RosteredPathIsCompared { crate_relative_path: path }]
          )
        }
      } else {
        if path_in(path: path, paths: observed_crate_rust_paths) {
          acc
        } else {
          SeedRetentionCensus {
            rostered: acc.rostered,
            unrostered: acc.unrostered,
            stale_rows: concat(
              acc.stale_rows,
              [RosterRowWithoutObservedPath { crate_relative_path: path }]
            ),
            compared_collisions: acc.compared_collisions
          }
        }
      }
    }
  )
}

data seed_retention_total_holds_note: String = "The conjunct is the three refusal populations being EMPTY, never a count of the rostered ones. A count equality would be satisfied by two errors cancelling — a path dropped from the tree and a path added to it — and DESIGN section 5 rules that completeness is an identity join, not a count equality. Every disagreement here is at path identity."

fn seed_retention_frontier_total_holds(
  roster: List<SeedRetentionFrontierRow>,
  observed_crate_rust_paths: List<String>,
  compared_crate_rust_paths: List<String>
) -> Bool {
  let census = seed_retention_census(
    roster: roster,
    observed_crate_rust_paths: observed_crate_rust_paths,
    compared_crate_rust_paths: compared_crate_rust_paths
  )
  (v2.std.algebra.length(xs: census.unrostered) == 0)
    && (v2.std.algebra.length(xs: census.stale_rows) == 0)
    && (v2.std.algebra.length(xs: census.compared_collisions) == 0)
}

fn seed_retention_frontier_census(
  observed_crate_rust_paths: List<String>,
  compared_crate_rust_paths: List<String>
) -> SeedRetentionCensus {
  seed_retention_census(
    roster: seed_retention_frontier_roster,
    observed_crate_rust_paths: observed_crate_rust_paths,
    compared_crate_rust_paths: compared_crate_rust_paths
  )
}

data roster_path_uniqueness_note: String = "A duplicate path would make the roster answer twice for one file with possibly different causes — the fork DESIGN section 3 forbids — and every join above keys on path, so a duplicate is invisible to all three refusals: the path is observed, it is in the roster, and both rows resolve. This is the one property of the LIVE roster a fixture cannot reach, so it is asserted directly over it."

fn roster_path_occurrences(path: String) -> Int {
  fold(
    seed_retention_frontier_roster,
    init: 0,
    f: fn(acc, row) { if row.crate_relative_path == path { acc + 1 } else { acc } }
  )
}

fn seed_retention_roster_paths_unique() -> Bool {
  fold(
    seed_retention_frontier_roster,
    init: true,
    f: fn(acc, row) { acc && (roster_path_occurrences(path: row.crate_relative_path) == 1) }
  )
}

fn row_reason_is_undeclared(row: SeedRetentionFrontierRow) -> Bool {
  match row.reason {
    ReasonNotYetDeclared => true
    ReasonDeclaredHere { detail: _, dissolution: _ } => false
    ReasonDeclaredElsewhere { authority: _ } => false
  }
}

fn undeclared_reason_rows() -> List<SeedRetentionFrontierRow> {
  fold(
    seed_retention_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if row_reason_is_undeclared(row: row) { concat(acc, [row]) } else { acc }
    }
  )
}

fn declared_reason_rows() -> List<SeedRetentionFrontierRow> {
  fold(
    seed_retention_frontier_roster,
    init: [],
    f: fn(acc, row) {
      if row_reason_is_undeclared(row: row) { acc } else { concat(acc, [row]) }
    }
  )
}

fn seed_retention_reason_split_holds() -> Bool {
  (v2.std.algebra.length(xs: declared_reason_rows()) + v2.std.algebra.length(xs: undeclared_reason_rows()))
    == v2.std.algebra.length(xs: seed_retention_frontier_roster)
}

fn cited_reason_authorities() -> List<std.decl_ref.DeclarationRef> {
  fold(
    seed_retention_frontier_roster,
    init: [],
    f: fn(acc, row) {
      match row.reason {
        ReasonDeclaredElsewhere { authority: test.claim.roadmap_document.authority } => concat(acc, [test.claim.roadmap_document.authority])
        ReasonDeclaredHere { detail: _, dissolution: _ } => acc
        ReasonNotYetDeclared => acc
      }
    }
  )
}
