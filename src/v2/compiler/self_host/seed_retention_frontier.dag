module v2.compiler.self_host.seed_retention_frontier


// The third sibling of the two self-host frontiers already in tree
// (v2.compiler.self_host.emit_coverage_frontier, which tracks native-eval construct
// coverage, and v2.compiler.self_host.native_routing_frontier, which tracks CI
// execution routing). Neither answers the axis DESIGN section 7 states first: every
// module of the seed is either self-emitted or seed-retained, and a seed-retained
// module is a declared row with a reason and a migration trigger.
//
// This module is that axis, at file grain, over the stage0 crate.

data seed_retention_frontier_note: String = "SUBJECT, measured rather than asserted (2026-08-24, main at 79e0635e11): 92 .rs files in the stage0 crate, 116,478 lines — 41 percent of the 283,459 lines of Rust the crate contains (227 files) — never enter the required-regen comparison at all. Four disjoint mechanisms put them there and only one of them was ever visible: 36 top-level basenames are excluded by name through HAND_MAINTAINED_STAGE0_FILES; 9 more live inside the two hand-maintained directories, which the committed walk (required_regen_host committed_generated_basenames) never descends into; 31 host binaries live under src/bin, which that same top-level walk cannot see and which the emitter cannot produce because emitted Rust filenames are flat under src/ by construction; and 15 integration tests plus build.rs sit outside the crate's src/ tree entirely. THE GAP THIS CLOSES IS NOT THE EXCLUSION — it is that the excluded population carried no reason and no migration trigger, so it was uncountable and unprioritizable, which is exactly what DESIGN section 7 forbids of a seed-retained module. stage0_crate_layout's registration rows answer a DIFFERENT question (which basenames the crate's mod tree and the copy-into-candidate step must name); they are layout membership, they cover 45 of the 92, and their type asserts nothing about why the file is retained or what retires it. The one family that already carries reason and trigger, emitter_produced_divergent_registrations, is the precedent this roster generalizes."

data seed_retention_frontier_totality_note: String = "WHY THIS IS NOT A SECOND HAND LIST BESIDE THE FIRST (DESIGN section 2). A roster of retained paths authored by hand counts the files someone remembered to author, which DESIGN section 5 rejects as an oracle. The roster here is joined against an INDEPENDENTLY DISCOVERED, CLOSED universe — every .rs file the stage0 crate contains — and the census refuses in three directions rather than reporting a count: a retained path with no row REFUSES (a new hand-authored seed file cannot be added invisibly), a row naming a path the tree no longer contains REFUSES (a row cannot outlive its file), and a row claiming retention for a path required-regen DOES compare REFUSES (a row cannot silence a live comparison). The census is a pure function of the two observed populations, so its discriminating REDs are authorable as ordinary fixture lists and execute in the required floor; wiring the live observation is a separate arm and is deliberately not what this roster's evidence rests on."

data seed_retention_reason_undeclared_note: String = "ReasonNotYetDeclared IS THE POINT, not a hole in it. DESIGN section 4b(2) separates cannot-climb from can-climb-after-one-grounding from can-climb-now-but-unbuilt, and the honest state of most of these files is the third: nobody has written down why the seed retains them. Fabricating 60 plausible reasons would be the fabricated-plausible-output failure applied to the frontier's own self-description — worse than sitting low, because an invented reason never ranks for repair. So the variant carries no payload, undeclared_reason_rows counts it, and the count is the prioritizable debt. It is NOT a refusal arm and does not widen anything: every such row is still rostered, still joined, still covered by the three refusals above."

type SeedRetentionCause
  = SeedRetainedIntrinsicSource
  | QuarantineScaffoldSource
  | WetActuatorGeneratedSource
  | EmitterProducedDivergentSource
  | SupportDirectoryMemberSource
  | HostBinaryEntryPointSource
  | CrateTestHarnessSource
  | CargoBuildScriptSource

type SeedRetentionReason
  = ReasonDeclaredHere { detail: String, dissolution: std.dissolution.DissolutionCondition }
  | ReasonDeclaredElsewhere { authority: std.decl_ref.DeclarationRef }
  | ReasonNotYetDeclared

type SeedRetentionFrontierRow {
  crate_relative_path: String
  cause: SeedRetentionCause
  reason: SeedRetentionReason
}

data reason_declared_elsewhere_note: String = "ReasonDeclaredElsewhere carries a DeclarationRef and never a copy of the prose (DESIGN section 3). Five of these rows point at stage0_crate_layout notes that already state the reason and the trigger for their family; restating that text here would fork one fact into two carriers, and the fork is the failure mode this repository consolidates most often. The citation is symbolic — module and declaration name, never a line — per the section 3 standing rule."

fn retained_reason_undeclared(path: String, cause: SeedRetentionCause) -> SeedRetentionFrontierRow {
  SeedRetentionFrontierRow {
    crate_relative_path: path,
    cause: cause,
    reason: ReasonNotYetDeclared
  }
}

fn retained_reason_elsewhere(
  path: String,
  cause: SeedRetentionCause,
  module_path: String,
  decl_name: String
) -> SeedRetentionFrontierRow {
  SeedRetentionFrontierRow {
    crate_relative_path: path,
    cause: cause,
    reason: ReasonDeclaredElsewhere {
      authority: std.decl_ref.decl_ref(module_path: module_path, decl_name: decl_name)
    }
  }
}

fn retained_support_dir_member(path: String) -> SeedRetentionFrontierRow {
  SeedRetentionFrontierRow {
    crate_relative_path: path,
    cause: SupportDirectoryMemberSource,
    reason: ReasonDeclaredHere {
      detail: "Lives inside one of the two hand-maintained stage0 directories. required_regen_host committed_generated_basenames enumerates only the top level of the crate's src tree, so no file here is ever a member of either compared population — the exclusion is a property of the walk, not a named exemption, which is why no per-file row existed anywhere before this one.",
      dissolution: std.dissolution.unbound_dissolution(description: "the directory's owning module is modeled in .dag and emitted, at which point the directory has no hand-authored member left and every row of this family deletes with it")
    }
  }
}

fn retained_host_binary(path: String) -> SeedRetentionFrontierRow {
  SeedRetentionFrontierRow {
    crate_relative_path: path,
    cause: HostBinaryEntryPointSource,
    reason: ReasonDeclaredHere {
      detail: "A cargo binary target under src/bin. Emitted Rust filenames are flat under src/ by construction (v1.compiler.emit_core_support module_to_filename splits on '.' and joins with '_'), so the emitter cannot write a src/bin path at all: this family is outside the comparison because the emitter has no way to reach it, not because anything excluded it.",
      dissolution: std.dissolution.unbound_dissolution(description: "the emitter models binary targets — a target-relative artifact path that is not forced flat under src/ — so a bin entry point can be emitted and compared like any other module")
    }
  }
}

fn retained_test_harness(path: String) -> SeedRetentionFrontierRow {
  SeedRetentionFrontierRow {
    crate_relative_path: path,
    cause: CrateTestHarnessSource,
    reason: ReasonDeclaredHere {
      detail: "A cargo integration test outside the crate's src tree. Both compared populations are rooted at src/, so nothing under tests/ can join either one. Named here because this is the growth surface with the least friction in the whole seed: a new hand-authored Rust file lands under tests/ with no registration, no exclusion row, and no census that could see it.",
      dissolution: std.dissolution.unbound_dissolution(description: "the claim each of these tests makes is carried by a witness in the required floor and the .rs harness deletes, or the emitter models cargo test targets")
    }
  }
}

fn retained_build_script(path: String) -> SeedRetentionFrontierRow {
  SeedRetentionFrontierRow {
    crate_relative_path: path,
    cause: CargoBuildScriptSource,
    reason: ReasonDeclaredHere {
      detail: "The crate's cargo build script, at the crate root and outside src/. Same structural reason as the test harnesses: it cannot join a population rooted at src/.",
      dissolution: std.dissolution.unbound_dissolution(description: "the build-time facts this script computes are modeled and emitted, or the crate no longer needs a build script")
    }
  }
}

