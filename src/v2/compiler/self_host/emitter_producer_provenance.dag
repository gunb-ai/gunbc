  producer_emission_oracle_row_body_producer,
  producer_emission_oracle_row_03_normalize,
  producer_emission_oracle_row_07_target_carriers,
  producer_emission_oracle_row_discovery_enumeration,
  producer_emission_oracle_row_parse_engine_hooks,
  producer_emission_oracle_row_use_site_verdict
]

data producer_emission_oracle_rows_empty: List<ProducerEmissionOracleRow> = []

data producer_emission_flip_wave_reverted_module_paths: List<String> = [
  "src/v2/compiler/00_compile.dag",
  "src/v2/compiler/02_parse.dag",
  "src/v2/compiler/03_ingest.dag",
  "src/v2/compiler/materialization_carriers.dag",
  "src/v2/compiler/program_assembly.dag",
