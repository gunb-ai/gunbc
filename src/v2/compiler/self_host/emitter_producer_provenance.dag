]

fn emitter_producer_eq(left: EmitterProducer, right: EmitterProducer) -> Bool {
  match emitter_producer_axis(producer: left) {
    EmitterProducerV1Seed =>
      match emitter_producer_axis(producer: right) {
        EmitterProducerV1Seed => true
        EmitterProducerV2Interpreted => false
        EmitterProducerV2Native { generation: _ } => false
      }
    EmitterProducerV2Interpreted =>
      match emitter_producer_axis(producer: right) {
        EmitterProducerV1Seed => false
        EmitterProducerV2Interpreted => true
        EmitterProducerV2Native { generation: _ } => false
      }
    EmitterProducerV2Native { generation: left_generation } =>
      match emitter_producer_axis(producer: right) {
        EmitterProducerV1Seed => false
        EmitterProducerV2Interpreted => false
        EmitterProducerV2Native { generation: right_generation } =>
          left_generation == right_generation
      }
  }
}

fn emission_build_result_eq(left: EmissionBuildResult, right: EmissionBuildResult) -> Bool {
  match left {
    BuildGreen =>
      match right {
        BuildGreen => true
        BuildRefused { cause: _ } => false
      }
    BuildRefused { cause: left_cause } =>
      match right {
        BuildGreen => false
        BuildRefused { cause: right_cause } => left_cause == right_cause
      }
  }
}

fn qualifications_list_eq(
  left: List<EmissionQualification>,
  right: List<EmissionQualification>
) -> Bool {
  if length(xs: left) != length(xs: right) {
    false
  } else {
    fold_list(
      xs: left,
      empty: true,
      cons: fn(ok, left_q) {
        ok && any(
          xs: right,
          predicate: fn(right_q) { qualification_eq(left: left_q, right: right_q) }
        )
      }
    )
  }
}

fn realized_closure_eq(left: RealizedEmitterClosure, right: RealizedEmitterClosure) -> Bool {
  if length(xs: left.emitter_module_paths) != length(xs: right.emitter_module_paths) {
    false
  } else {
    fold_list(
      xs: left.emitter_module_paths,
      empty: true,
      cons: fn(ok, path) {
        ok && any(
          xs: right.emitter_module_paths,
          predicate: fn(right_path) { path == right_path }
        )
      }
    )
  }
}

fn producer_emission_receipt_eq(left: ProducerEmissionReceipt, right: ProducerEmissionReceipt) -> Bool {
  (left.module_path == right.module_path)
    && (left.module_source_digest == right.module_source_digest)
    && (left.emitter_source_digest == right.emitter_source_digest)
    && emitter_producer_eq(left: left.producer, right: right.producer)
    && qualifications_list_eq(left: left.qualifications, right: right.qualifications)
    && (left.rust_target_model_digest == right.rust_target_model_digest)
    && (left.emitted_source_digest == right.emitted_source_digest)
    && emission_build_result_eq(left: left.build_result, right: right.build_result)
    && (left.behavioral_probe_entry == right.behavioral_probe_entry)
    && (left.behavioral_probe_function == right.behavioral_probe_function)
    && realized_closure_eq(left: left.realized_closure, right: right.realized_closure)
}

fn producer_emission_oracle_probe_is_enrolled(row: ProducerEmissionOracleRow) -> Bool {
  schedule_witness_entry_cited(
    probe_entry: row.behavioral_probe_entry,
    probe_function: row.behavioral_probe_function,
    entries: seed_emitter_behavioral_wet_known_red_entries
  )
}

fn producer_emission_oracle_row_has_behavioral_transport_config(row: ProducerEmissionOracleRow) -> Bool {
  match module_behavioral_transport_config_for(module_path: row.module_path) {
    Present { value: _ } => true
    Absent => false
  }
}

fn producer_emission_oracle_rows_match_transport_roster_holds() -> Bool {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: true,
    cons: fn(ok, row) { ok && producer_emission_oracle_row_has_behavioral_transport_config(row: row) }
  )
}

fn producer_emission_oracle_row_for_module(module_path: String) -> List<ProducerEmissionOracleRow> {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: producer_emission_oracle_rows_empty,
    cons: fn(acc, row) {
      if row.module_path == module_path {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

data producer_emission_oracle_authorization_note: String = "Construction, not enrollment-only (reviews 44328/44333): authorization requires structural equality against the canonical receipt minted by producer_emission_receipt_from_oracle_row (never a hand-authored data-row receipt), BuildGreen on both sides, AND enrolled wet quarantine citation. Fabricated receipts with scaffold digests or BuildRefused cannot authorize."

fn producer_emission_oracle_authorizes_row(
  module_path: String,
  receipt: ProducerEmissionReceipt
) -> Bool {
  producer_emission_receipt_is_build_green(receipt: receipt)
    && any(
      xs: producer_emission_oracle_row_for_module(module_path: module_path),
      predicate: fn(row) {
        match producer_emission_canonical_receipt_for_oracle_row(row: row) {
          Present { value: canonical } =>
            producer_emission_receipt_eq(left: canonical, right: receipt)
              && producer_emission_oracle_probe_is_enrolled(row: row)
          Absent => false
        }
      }
    )
}

fn producer_emission_enrollment_entry_has_oracle_row(
  probe_entry: String,
  probe_function: String
) -> Bool {
  any(
    xs: producer_emission_oracle_rows,
    predicate: fn(row) {
      (row.behavioral_probe_entry == probe_entry)
        && (row.behavioral_probe_function == probe_function)
    }
  )
}

fn producer_emission_oracle_rows_match_enrollment_holds() -> Bool {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: true,
    cons: fn(ok, row) { ok && producer_emission_oracle_probe_is_enrolled(row: row) }
  ) && fold_list(
    xs: seed_emitter_behavioral_wet_known_red_entries,
    empty: true,
    cons: fn(ok, entry) {
      ok && producer_emission_enrollment_entry_has_oracle_row(
        probe_entry: entry.entry,
        probe_function: entry.function
      )
    }
  )
}

fn producer_emission_oracle_rows_all_enrolled_holds() -> Bool {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: true,
    cons: fn(ok, row) { ok && producer_emission_oracle_probe_is_enrolled(row: row) }
  )
}

fn producer_emission_oracle_row_count() -> Int {
  length(xs: producer_emission_oracle_rows)
}

fn producer_emission_flip_wave_module_has_oracle_row(module_path: String) -> Bool {
  length(xs: producer_emission_oracle_row_for_module(module_path: module_path)) > 0
}

fn producer_emission_flip_wave_reverted_modules_lack_oracle_holds() -> Bool {
  fold_list(
    xs: producer_emission_flip_wave_reverted_module_paths,
    empty: true,
    cons: fn(ok, path) { ok && !producer_emission_flip_wave_module_has_oracle_row(module_path: path) }
  )
}

fn fabricated_v1_seed_producer_receipt(module_path: String) -> ProducerEmissionReceipt {
  ProducerEmissionReceipt {
    module_path: module_path,
    module_source_digest: scaffold_digest_for_module_path(module_path: module_path),
    emitter_source_digest: scaffold_digest_for_module_path(module_path: v1_seed_emit_rust_qualified_module),
    producer: V1SeedEmitter,
    qualifications: behavioral_equivalent_qualifications,
    rust_target_model_digest: symbol_identity_digest(sym: ^rust_target_model_digest_scaffold),
    emitted_source_digest: scaffold_digest_for_module_path(module_path: module_path),
    build_result: BuildGreen,
    behavioral_probe_entry: "fabricated",
    behavioral_probe_function: "fabricated",
    realized_closure: cssl_harness_realized_closure
  }
}

fn fabricated_v2_interpreted_producer_receipt(module_path: String) -> ProducerEmissionReceipt {
  ProducerEmissionReceipt {
    module_path: module_path,
    module_source_digest: scaffold_digest_for_module_path(module_path: module_path),
    emitter_source_digest: scaffold_digest_for_module_path(module_path: v2_emit_interpreted_qualified_module),
    producer: V2EmitterInterpreted,
    qualifications: behavioral_equivalent_qualifications,
    rust_target_model_digest: symbol_identity_digest(sym: ^rust_target_model_digest_scaffold),
    emitted_source_digest: scaffold_digest_for_module_path(module_path: module_path),
    build_result: BuildGreen,
    behavioral_probe_entry: "fabricated",
    behavioral_probe_function: "fabricated",
    realized_closure: cssl_harness_realized_closure
  }
}

fn mint_v2_interpreted_receipt_with_seed_closure_refuses(
  module_path: String
) -> Bool {
  match mint_producer_emission_receipt(
    module_path: module_path,
    producer: V2EmitterInterpreted,
    qualifications: behavioral_equivalent_qualifications,
    build_result: BuildGreen,
    behavioral_probe_entry: "fabricated",
    behavioral_probe_function: "fabricated",
    realized_closure: cssl_harness_realized_closure
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn qualification_eq(left: EmissionQualification, right: EmissionQualification) -> Bool {
  match left {
    SourceProduced => match right { SourceProduced => true _ => false }
    CargoGreen => match right { CargoGreen => true _ => false }
    BehavioralEquivalent => match right { BehavioralEquivalent => true _ => false }
    ProductionRouted => match right { ProductionRouted => true _ => false }
  }
}

fn row_has_qualification(
  qualifications: List<EmissionQualification>,
  target: EmissionQualification
) -> Bool {
  any(
    xs: qualifications,
    predicate: fn(q) { qualification_eq(left: q, right: target) }
  )
}

fn producer_emission_row_is_seed_behavioral_green(row: ProducerEmissionOracleRow) -> Bool {
  match producer_emission_canonical_receipt_for_oracle_row(row: row) {
    Present { value: receipt } =>
      match emitter_producer_axis(producer: receipt.producer) {
        EmitterProducerV1Seed =>
          row_has_qualification(
            qualifications: receipt.qualifications,
            target: BehavioralEquivalent
          )
        EmitterProducerV2Interpreted => false
        EmitterProducerV2Native { generation: _ } => false
      }
    Absent => false
  }
}

fn producer_emission_row_is_v2_interpreted_behavioral_green(row: ProducerEmissionOracleRow) -> Bool {
  match producer_emission_canonical_receipt_for_oracle_row(row: row) {
    Present { value: receipt } =>
      match emitter_producer_axis(producer: receipt.producer) {
        EmitterProducerV1Seed => false
        EmitterProducerV2Interpreted =>
          row_has_qualification(
            qualifications: receipt.qualifications,
            target: BehavioralEquivalent
          )
        EmitterProducerV2Native { generation: _ } => false
      }
    Absent => false
  }
}

fn producer_emission_row_is_v2_native_behavioral_green(row: ProducerEmissionOracleRow) -> Bool {
  match producer_emission_canonical_receipt_for_oracle_row(row: row) {
    Present { value: receipt } =>
      match emitter_producer_axis(producer: receipt.producer) {
        EmitterProducerV1Seed => false
        EmitterProducerV2Interpreted => false
        EmitterProducerV2Native { generation: _ } =>
          row_has_qualification(
            qualifications: receipt.qualifications,
            target: BehavioralEquivalent
          )
      }
    Absent => false
  }
}

fn producer_emission_row_is_v2_production_routed(row: ProducerEmissionOracleRow) -> Bool {
  match producer_emission_canonical_receipt_for_oracle_row(row: row) {
    Present { value: receipt } =>
      match emitter_producer_axis(producer: receipt.producer) {
        EmitterProducerV1Seed => false
        EmitterProducerV2Interpreted =>
          row_has_qualification(
            qualifications: receipt.qualifications,
            target: ProductionRouted
          )
        EmitterProducerV2Native { generation: _ } =>
          row_has_qualification(
            qualifications: receipt.qualifications,
            target: ProductionRouted
          )
      }
    Absent => false
  }
}

data seed_emitter_behavioral_green_baseline: Int = 6

data v2_interpreted_emitter_behavioral_green_baseline: Int = 0

data v2_native_emitter_behavioral_green_baseline: Int = 0

data v2_emitter_production_routed_baseline: Int = 0

fn seed_emitter_behavioral_green_count() -> Int {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: 0,
    cons: fn(count, row) {
      if producer_emission_row_is_seed_behavioral_green(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn v2_interpreted_emitter_behavioral_green_count() -> Int {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: 0,
    cons: fn(count, row) {
      if producer_emission_row_is_v2_interpreted_behavioral_green(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn v2_native_emitter_behavioral_green_count() -> Int {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: 0,
    cons: fn(count, row) {
      if producer_emission_row_is_v2_native_behavioral_green(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn v2_emitter_production_routed_count() -> Int {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: 0,
    cons: fn(count, row) {
      if producer_emission_row_is_v2_production_routed(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn seed_emitter_behavioral_green_baseline_holds() -> Bool {
  seed_emitter_behavioral_green_count() == seed_emitter_behavioral_green_baseline
}

fn v2_interpreted_emitter_behavioral_green_baseline_holds() -> Bool {
  v2_interpreted_emitter_behavioral_green_count() == v2_interpreted_emitter_behavioral_green_baseline
}

fn v2_native_emitter_behavioral_green_baseline_holds() -> Bool {
  v2_native_emitter_behavioral_green_count() == v2_native_emitter_behavioral_green_baseline
}

fn v2_emitter_production_routed_baseline_holds() -> Bool {
  v2_emitter_production_routed_count() == v2_emitter_production_routed_baseline
}

fn producer_qualified_baselines_holds() -> Bool {
  seed_emitter_behavioral_green_baseline_holds()
    && v2_interpreted_emitter_behavioral_green_baseline_holds()
    && v2_native_emitter_behavioral_green_baseline_holds()
    && v2_emitter_production_routed_baseline_holds()
}
