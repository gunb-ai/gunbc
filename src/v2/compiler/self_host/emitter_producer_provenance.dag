module v2.compiler.self_host.emitter_producer_provenance

import v2.compiler.self_host.frontier_probe_types {
  FrontierProbeReceipt,
  FrontierProbeStage,
  ProbeStageEmit,
  SelfEmitReady
}
import tools.self_host_module_behavioral_transport_roster {
  module_behavioral_transport_config_for
}
import v2.compiler.self_host.seed_emitter_behavioral_wet_known_red_entries {
  schedule_witness_entry_cited,
  seed_emitter_behavioral_wet_known_red_entries
}
import v2.std.algebra { any, fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Hash, Symbol, combine_hash, symbol_identity_digest }
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.text { String }

data emitter_producer_provenance_note: String = "CompilerFixedPoint producer/qualification authority (session valiant-crab-382, calm-badger-682 ruling 2026-07-29): replaces SelfEmitted state-space conflation with orthogonal EmitterProducer x EmissionQualification axes. A frontier EmitterProduced row is reachable ONLY from a ProducerEmissionReceipt minted through mint_producer_emission_receipt — never from a hand-authored ProducerEmissionReceipt literal in a data row (review 44333). Oracle rows bind module_path to enrolled wet probe identity only; canonical receipts derive via producer_emission_receipt_from_oracle_row with BuildGreen. Wet execution proof: each enrolled probe witness runs tools.self_host_module_behavioral_transport_roster.compiler_module_behavioral_receipt_for. Structural wall: V2Emitter* is unwritable when v1.compiler.emit_rust is in the realized closure. Scaffold digests dissolve-on frontier_probe_survey."

type EmitterProducer
  = V1SeedEmitter
  | V2EmitterInterpreted
  | V2EmitterNative { generation: Int }

data emitter_producer_axis_note: String = "Canonical query surface for EmitterProducer (review 44328 predicate-dissolution rule): consumers classify through emitter_producer_axis once and match the tag — not a family of hand-rolled producer_is_* Bool predicates over the same coproduct."

type EmitterProducerAxis
  = EmitterProducerV1Seed
  | EmitterProducerV2Interpreted
  | EmitterProducerV2Native { generation: Int }

fn emitter_producer_axis(producer: EmitterProducer) -> EmitterProducerAxis {
  match producer {
    V1SeedEmitter => EmitterProducerV1Seed
    V2EmitterInterpreted => EmitterProducerV2Interpreted
    V2EmitterNative { generation: generation } => EmitterProducerV2Native { generation: generation }
  }
}

type EmissionQualification
  = SourceProduced
  | CargoGreen
  | BehavioralEquivalent
  | ProductionRouted

type EmissionBuildResult
  = BuildGreen
  | BuildRefused { cause: Symbol }

type RealizedEmitterClosure {
  emitter_module_paths: List<String>
}

type ProducerEmissionReceipt {
  module_path: String
  module_source_digest: Hash
  emitter_source_digest: Hash
  producer: EmitterProducer
  qualifications: List<EmissionQualification>
  rust_target_model_digest: Hash
  emitted_source_digest: Hash
  build_result: EmissionBuildResult
  behavioral_probe_entry: String
  behavioral_probe_function: String
  realized_closure: RealizedEmitterClosure
}

type ProducerEmissionOracleRow {
  module_path: String
  measured_probe: FrontierProbeReceipt
  behavioral_probe_entry: String
  behavioral_probe_function: String
}

data v1_seed_emit_rust_qualified_module: String = "v1.compiler.emit_rust"

data v2_emit_interpreted_qualified_module: String = "v2.compiler.emit"

data cssl_harness_realized_closure_note: String = "Structural authority for the cssl seed-linked behavioral harness (tools.self_host_curated_seed_linked_harness): gunbc compile routes through v1.compile -> v1.compiler.emit_rust. Any receipt minted from this closure MUST be V1SeedEmitter — V2Emitter* is unwritable by construction."

data cssl_harness_realized_closure: RealizedEmitterClosure = RealizedEmitterClosure {
  emitter_module_paths: [
    "v1.compile",
    v1_seed_emit_rust_qualified_module
  ]
}

data v2_interpreted_emitter_closure_note: String = "Future V2EmitterInterpreted closure shape: v2.compiler.emit (serialize_target composed with translate) without v1.compiler.emit_rust. First customer when generate_stage_candidate_from_ingest wires serialize_target."

data v2_interpreted_emitter_closure: RealizedEmitterClosure = RealizedEmitterClosure {
  emitter_module_paths: [
    v2_emit_interpreted_qualified_module,
    "v2.compiler.translate",
    "v2.compiler.candidate_generation"
  ]
}

fn realized_closure_contains_module(
  closure: RealizedEmitterClosure,
  module: String
) -> Bool {
  any(
    xs: closure.emitter_module_paths,
    predicate: fn(path) { path == module }
  )
}

fn seed_emit_rust_reachable(closure: RealizedEmitterClosure) -> Bool {
  realized_closure_contains_module(
    closure: closure,
    module: v1_seed_emit_rust_qualified_module
  )
}

fn v2_emitter_producer_admissible(
  producer: EmitterProducer,
  closure: RealizedEmitterClosure
) -> Bool {
  match producer {
    V1SeedEmitter => true
    V2EmitterInterpreted => !seed_emit_rust_reachable(closure: closure)
    V2EmitterNative { generation: _ } => !seed_emit_rust_reachable(closure: closure)
  }
}

data behavioral_equivalent_qualifications: List<EmissionQualification> = [BehavioralEquivalent]

fn scaffold_digest_for_module_path(module_path: String) -> Hash {
  combine_hash(
    a: symbol_identity_digest(sym: ^frontier_producer_receipt_scaffold_digest),
    b: symbol_identity_digest(sym: ^frontier_producer_receipt_module_path_scaffold)
  )
}

fn mint_producer_emission_receipt(
  module_path: String,
  producer: EmitterProducer,
  qualifications: List<EmissionQualification>,
  build_result: EmissionBuildResult,
  behavioral_probe_entry: String,
  behavioral_probe_function: String,
  realized_closure: RealizedEmitterClosure
) -> Optional<ProducerEmissionReceipt> {
  if v2_emitter_producer_admissible(producer: producer, closure: realized_closure) {
    optional_present(
      value: ProducerEmissionReceipt {
        module_path: module_path,
        module_source_digest: scaffold_digest_for_module_path(module_path: module_path),
        emitter_source_digest: scaffold_digest_for_module_path(
          module_path: match producer {
            V1SeedEmitter => v1_seed_emit_rust_qualified_module
            V2EmitterInterpreted => v2_emit_interpreted_qualified_module
            V2EmitterNative { generation: _ } => v2_emit_interpreted_qualified_module
          }
        ),
        producer: producer,
        qualifications: qualifications,
        rust_target_model_digest: symbol_identity_digest(sym: ^rust_target_model_digest_scaffold),
        emitted_source_digest: scaffold_digest_for_module_path(module_path: module_path),
        build_result: build_result,
        behavioral_probe_entry: behavioral_probe_entry,
        behavioral_probe_function: behavioral_probe_function,
        realized_closure: realized_closure
      }
    )
  } else {
    optional_absent()
  }
}

fn producer_emission_measured_probe_receipt(module_path: String) -> FrontierProbeReceipt {
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: SelfEmitReady,
    located_stage: ProbeStageEmit,
    located_reason: ^measured_probe_self_emit_ready
  }
}

data producer_emission_receipt_digest_scaffold_note: String = "SCAFFOLD (review 44333 partial landing): mint_producer_emission_receipt still keys digests on symbol_identity_digest scaffolds until frontier_probe_survey binds execution-measured module/emitter/emitted-source hashes. The construction wall landed here is: (1) no hand-authored ProducerEmissionReceipt in oracle data rows; (2) BuildRefused cannot authorize EmitterProduced; (3) every oracle row's probe has a matching compiler_module_behavioral_transport_roster row executed by its wet witness."

fn seed_emitter_behavioral_oracle_row(
  module_path: String,
  behavioral_probe_entry: String,
  behavioral_probe_function: String
) -> ProducerEmissionOracleRow {
  ProducerEmissionOracleRow {
    module_path: module_path,
    measured_probe: producer_emission_measured_probe_receipt(module_path: module_path),
    behavioral_probe_entry: behavioral_probe_entry,
    behavioral_probe_function: behavioral_probe_function
  }
}

fn producer_emission_receipt_from_oracle_row(
  row: ProducerEmissionOracleRow
) -> Optional<ProducerEmissionReceipt> {
  mint_producer_emission_receipt(
    module_path: row.module_path,
    producer: V1SeedEmitter,
    qualifications: behavioral_equivalent_qualifications,
    build_result: BuildGreen,
    behavioral_probe_entry: row.behavioral_probe_entry,
    behavioral_probe_function: row.behavioral_probe_function,
    realized_closure: cssl_harness_realized_closure
  )
}

fn producer_emission_receipt_is_build_green(receipt: ProducerEmissionReceipt) -> Bool {
  match receipt.build_result {
    BuildGreen => true
    BuildRefused { cause: _ } => false
  }
}

fn producer_emission_canonical_receipt_for_oracle_row(
  row: ProducerEmissionOracleRow
) -> Optional<ProducerEmissionReceipt> {
  match producer_emission_receipt_from_oracle_row(row: row) {
    Present { value: receipt } =>
      if producer_emission_receipt_is_build_green(receipt: receipt) {
        optional_present(value: receipt)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn producer_emission_oracle_row_frontier_receipt(
  row: ProducerEmissionOracleRow
) -> ProducerEmissionReceipt {
  match producer_emission_canonical_receipt_for_oracle_row(row: row) {
    Present { value: receipt } => receipt
    Absent =>
      match mint_producer_emission_receipt(
        module_path: row.module_path,
        producer: V1SeedEmitter,
        qualifications: behavioral_equivalent_qualifications,
        build_result: BuildRefused { cause: ^producer_emission_oracle_unmintable },
        behavioral_probe_entry: row.behavioral_probe_entry,
        behavioral_probe_function: row.behavioral_probe_function,
        realized_closure: cssl_harness_realized_closure
      ) {
        Present { value: receipt } => receipt
        Absent => fabricated_v1_seed_producer_receipt(module_path: row.module_path)
      }
  }
}

