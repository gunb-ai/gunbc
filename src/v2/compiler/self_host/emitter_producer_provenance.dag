type ProducerQualifiedCountAxis
  = ProducerCountSeedBehavioralGreen
  | ProducerCountV2InterpretedBehavioralGreen
  | ProducerCountV2NativeBehavioralGreen
  | ProducerCountV2ProductionRouted

data producer_qualified_count_axis_note: String = "Canonical query surface for producer-qualified census (review 44350 predicate-dissolution): classify once via producer_qualified_count_axis_for_receipt, count via count_oracle_rows_with_qualified_axis — not a family of hand-rolled producer_emission_row_is_* predicates."

fn producer_qualified_count_axis_eq(
  left: ProducerQualifiedCountAxis,
  right: ProducerQualifiedCountAxis
) -> Bool {
  match left {
    ProducerCountSeedBehavioralGreen =>
      match right {
        ProducerCountSeedBehavioralGreen => true
        ProducerCountV2InterpretedBehavioralGreen => false
        ProducerCountV2NativeBehavioralGreen => false
        ProducerCountV2ProductionRouted => false
      }
    ProducerCountV2InterpretedBehavioralGreen =>
      match right {
        ProducerCountSeedBehavioralGreen => false
        ProducerCountV2InterpretedBehavioralGreen => true
        ProducerCountV2NativeBehavioralGreen => false
        ProducerCountV2ProductionRouted => false
      }
    ProducerCountV2NativeBehavioralGreen =>
      match right {
        ProducerCountSeedBehavioralGreen => false
        ProducerCountV2InterpretedBehavioralGreen => false
        ProducerCountV2NativeBehavioralGreen => true
        ProducerCountV2ProductionRouted => false
      }
    ProducerCountV2ProductionRouted =>
      match right {
        ProducerCountSeedBehavioralGreen => false
        ProducerCountV2InterpretedBehavioralGreen => false
        ProducerCountV2NativeBehavioralGreen => false
        ProducerCountV2ProductionRouted => true
      }
  }
}

fn producer_qualified_count_axis_for_receipt(
  receipt: ProducerEmissionReceipt
) -> Optional<ProducerQualifiedCountAxis> {
  match receipt.build_result {
    BuildRefused { cause: _ } => optional_absent()
    BuildGreen =>
    match receipt.producer {
      V1SeedEmitter =>
        if emission_qualifications_list_contains(
          xs: receipt.qualifications,
          wanted: BehavioralEquivalent
        ) {
          optional_present(value: ProducerCountSeedBehavioralGreen)
        } else {
          optional_absent()
        }
      V2EmitterInterpreted =>
        if emission_qualifications_list_contains(
          xs: receipt.qualifications,
          wanted: BehavioralEquivalent
        ) {
          optional_present(value: ProducerCountV2InterpretedBehavioralGreen)
        } else {
          optional_absent()
        }
      V2EmitterNative { generation: _ } =>
        if emission_qualifications_list_contains(
          xs: receipt.qualifications,
          wanted: BehavioralEquivalent
        ) {
          optional_present(value: ProducerCountV2NativeBehavioralGreen)
        } else if emission_qualifications_list_contains(
          xs: receipt.qualifications,
          wanted: ProductionRouted
        ) {
          optional_present(value: ProducerCountV2ProductionRouted)
        } else {
          optional_absent()
        }
    }
  }
}

fn producer_qualified_count_axis_for_row(
  row: ProducerEmissionOracleRow
) -> Optional<ProducerQualifiedCountAxis> {
  match producer_emission_canonical_receipt_for_oracle_row(row: row) {
    Present { value: receipt } =>
      producer_qualified_count_axis_for_receipt(receipt: receipt)
    Absent => optional_absent()
  }
}

fn count_oracle_rows_with_qualified_axis(axis: ProducerQualifiedCountAxis) -> Int {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: 0,
    cons: fn(count, row) {
      match producer_qualified_count_axis_for_row(row: row) {
        Present { value: row_axis } =>
          if producer_qualified_count_axis_eq(left: row_axis, right: axis) {
            count + 1
          } else {
            count
          }
        Absent => count
      }
    }
  )
}

data seed_emitter_behavioral_green_baseline: Int = 0

data seed_emitter_behavioral_quarantine_baseline: Int = 6

data v2_interpreted_emitter_behavioral_green_baseline: Int = 0

data v2_native_emitter_behavioral_green_baseline: Int = 0

data v2_emitter_production_routed_baseline: Int = 0

fn seed_emitter_behavioral_quarantine_count() -> Int {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: 0,
    cons: fn(count, row) {
      if producer_emission_oracle_probe_is_known_red_quarantine(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn seed_emitter_behavioral_green_count() -> Int {
  count_oracle_rows_with_qualified_axis(axis: ProducerCountSeedBehavioralGreen)
}

fn v2_interpreted_emitter_behavioral_green_count() -> Int {
  count_oracle_rows_with_qualified_axis(axis: ProducerCountV2InterpretedBehavioralGreen)
}

fn v2_native_emitter_behavioral_green_count() -> Int {
  count_oracle_rows_with_qualified_axis(axis: ProducerCountV2NativeBehavioralGreen)
}

fn v2_emitter_production_routed_count() -> Int {
  count_oracle_rows_with_qualified_axis(axis: ProducerCountV2ProductionRouted)
}

fn seed_emitter_behavioral_quarantine_baseline_holds() -> Bool {
  seed_emitter_behavioral_quarantine_count() == seed_emitter_behavioral_quarantine_baseline
}

fn seed_emitter_behavioral_green_baseline_holds() -> Bool {
  seed_emitter_behavioral_green_count() == seed_emitter_behavioral_green_baseline
}

fn v2_interpreted_emitter_behavioral_green_baseline_holds() -> Bool {
  v2_interpreted_emitter_behavioral_green_count() == v2_interpreted_emitter_behavioral_green_baseline
}

fn v2_native_emitter_behavioral_green_baseline_holds() -> Bool {
  v2_native_emitter_behavioral_green_count() == v2_native_emitter_behavioral_green_baseline
}

fn v2_emitter_production_routed_baseline_holds() -> Bool {
  v2_emitter_production_routed_count() == v2_emitter_production_routed_baseline
}

fn producer_qualified_baselines_holds() -> Bool {
  seed_emitter_behavioral_green_baseline_holds()
    && seed_emitter_behavioral_quarantine_baseline_holds()
    && v2_interpreted_emitter_behavioral_green_baseline_holds()
    && v2_native_emitter_behavioral_green_baseline_holds()
    && v2_emitter_production_routed_baseline_holds()
}
