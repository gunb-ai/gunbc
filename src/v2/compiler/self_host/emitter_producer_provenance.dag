data producer_emission_oracle_rows: List<ProducerEmissionOracleRow> = [
  producer_emission_oracle_row_body_producer,
  producer_emission_oracle_row_03_normalize,
  producer_emission_oracle_row_07_target_carriers,
  producer_emission_oracle_row_discovery_enumeration,
  producer_emission_oracle_row_parse_engine_hooks,
  producer_emission_oracle_row_use_site_verdict
]

data producer_emission_flip_wave_reverted_module_paths: List<String> = [
  "src/v2/compiler/00_compile.dag",
  "src/v2/compiler/02_parse.dag",
  "src/v2/compiler/03_ingest.dag",
  "src/v2/compiler/materialization_carriers.dag",
  "src/v2/compiler/program_assembly.dag",
  "src/v2/compiler/source_authority.dag"
]

fn producer_emission_oracle_probe_is_enrolled(row: ProducerEmissionOracleRow) -> Bool {
  schedule_witness_entry_cited(
    probe_entry: row.receipt.behavioral_probe_entry,
    probe_function: row.receipt.behavioral_probe_function,
    entries: seed_emitter_behavioral_wet_known_red_entries
  )
}

fn producer_emission_oracle_row_for_module(module_path: String) -> List<ProducerEmissionOracleRow> {
  fold(
    producer_emission_oracle_rows,
    init: [],
    f: fn(acc, row) {
      if row.module_path == module_path {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

fn producer_emission_oracle_authorizes_row(
  module_path: String,
  receipt: ProducerEmissionReceipt
) -> Bool {
  any(
    xs: producer_emission_oracle_row_for_module(module_path: module_path),
    predicate: fn(row) {
      (row.receipt.module_path == receipt.module_path)
        && (row.receipt.producer == receipt.producer)
        && producer_emission_oracle_probe_is_enrolled(row: row)
    }
  )
}

fn producer_emission_enrollment_entry_has_oracle_row(
  probe_entry: String,
  probe_function: String
) -> Bool {
  any(
    xs: producer_emission_oracle_rows,
    predicate: fn(row) {
      (row.receipt.behavioral_probe_entry == probe_entry)
        && (row.receipt.behavioral_probe_function == probe_function)
    }
  )
}

fn producer_emission_oracle_rows_match_enrollment_holds() -> Bool {
  fold(
    producer_emission_oracle_rows,
    init: true,
    f: fn(ok, row) { ok && producer_emission_oracle_probe_is_enrolled(row: row) }
  ) && fold(
    seed_emitter_behavioral_wet_known_red_entries,
    init: true,
    f: fn(ok, entry) {
      ok && producer_emission_enrollment_entry_has_oracle_row(
        probe_entry: entry.entry,
        probe_function: entry.function
      )
    }
  )
}

fn producer_emission_oracle_rows_all_enrolled_holds() -> Bool {
  fold(
    producer_emission_oracle_rows,
    init: true,
    f: fn(ok, row) { ok && producer_emission_oracle_probe_is_enrolled(row: row) }
  )
}

fn producer_emission_oracle_row_count() -> Int {
  length(xs: producer_emission_oracle_rows)
}

fn producer_emission_flip_wave_module_has_oracle_row(module_path: String) -> Bool {
  length(xs: producer_emission_oracle_row_for_module(module_path: module_path)) > 0
}

fn producer_emission_flip_wave_reverted_modules_lack_oracle_holds() -> Bool {
  fold(
    producer_emission_flip_wave_reverted_module_paths,
    init: true,
    f: fn(ok, path) { ok && !producer_emission_flip_wave_module_has_oracle_row(module_path: path) }
  )
}

fn fabricated_v1_seed_producer_receipt(module_path: String) -> ProducerEmissionReceipt {
  ProducerEmissionReceipt {
    module_path: module_path,
    module_source_digest: scaffold_digest_for_module_path(module_path: module_path),
    emitter_source_digest: scaffold_digest_for_module_path(module_path: v1_seed_emit_rust_qualified_module),
    producer: V1SeedEmitter,
    qualifications: [BehavioralEquivalent],
    rust_target_model_digest: symbol_identity_digest(sym: ^rust_target_model_digest_scaffold),
    emitted_source_digest: scaffold_digest_for_module_path(module_path: module_path),
    build_result: BuildGreen,
    behavioral_probe_entry: "fabricated",
    behavioral_probe_function: "fabricated",
    realized_closure: cssl_harness_realized_closure
  }
}

fn fabricated_v2_interpreted_producer_receipt(module_path: String) -> ProducerEmissionReceipt {
  ProducerEmissionReceipt {
    module_path: module_path,
    module_source_digest: scaffold_digest_for_module_path(module_path: module_path),
    emitter_source_digest: scaffold_digest_for_module_path(module_path: v2_emit_interpreted_qualified_module),
    producer: V2EmitterInterpreted,
    qualifications: [BehavioralEquivalent],
    rust_target_model_digest: symbol_identity_digest(sym: ^rust_target_model_digest_scaffold),
    emitted_source_digest: scaffold_digest_for_module_path(module_path: module_path),
    build_result: BuildGreen,
    behavioral_probe_entry: "fabricated",
    behavioral_probe_function: "fabricated",
    realized_closure: cssl_harness_realized_closure
  }
}

fn mint_v2_interpreted_receipt_with_seed_closure_refuses(
  module_path: String
) -> Bool {
  match mint_producer_emission_receipt(
    module_path: module_path,
    producer: V2EmitterInterpreted,
    qualifications: [BehavioralEquivalent],
    build_result: BuildGreen,
    behavioral_probe_entry: "fabricated",
    behavioral_probe_function: "fabricated",
    realized_closure: cssl_harness_realized_closure
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

fn producer_is_v1_seed_emitter(producer: EmitterProducer) -> Bool {
  match producer {
    V1SeedEmitter => true
    V2EmitterInterpreted => false
    V2EmitterNative { generation: _ } => false
  }
}

fn producer_is_v2_interpreted(producer: EmitterProducer) -> Bool {
  match producer {
    V1SeedEmitter => false
    V2EmitterInterpreted => true
    V2EmitterNative { generation: _ } => false
  }
}

fn producer_is_v2_native(producer: EmitterProducer) -> Bool {
  match producer {
    V1SeedEmitter => false
    V2EmitterInterpreted => false
    V2EmitterNative { generation: _ } => true
  }
}

fn row_has_qualification(
  qualifications: List<EmissionQualification>,
  target: EmissionQualification
) -> Bool {
  any(
    xs: qualifications,
    predicate: fn(q) { q == target }
  )
}

fn producer_emission_row_is_seed_behavioral_green(row: ProducerEmissionOracleRow) -> Bool {
  producer_is_v1_seed_emitter(producer: row.receipt.producer)
    && row_has_qualification(
      qualifications: row.receipt.qualifications,
      target: BehavioralEquivalent
    )
}

fn producer_emission_row_is_v2_interpreted_behavioral_green(row: ProducerEmissionOracleRow) -> Bool {
  producer_is_v2_interpreted(producer: row.receipt.producer)
    && row_has_qualification(
      qualifications: row.receipt.qualifications,
      target: BehavioralEquivalent
    )
}

fn producer_emission_row_is_v2_native_behavioral_green(row: ProducerEmissionOracleRow) -> Bool {
  producer_is_v2_native(producer: row.receipt.producer)
    && row_has_qualification(
      qualifications: row.receipt.qualifications,
      target: BehavioralEquivalent
    )
}

fn producer_emission_row_is_v2_production_routed(row: ProducerEmissionOracleRow) -> Bool {
  (producer_is_v2_interpreted(producer: row.receipt.producer)
    || producer_is_v2_native(producer: row.receipt.producer))
    && row_has_qualification(
      qualifications: row.receipt.qualifications,
      target: ProductionRouted
    )
}

data seed_emitter_behavioral_green_baseline: Int = 6

data v2_interpreted_emitter_behavioral_green_baseline: Int = 0

data v2_native_emitter_behavioral_green_baseline: Int = 0

data v2_emitter_production_routed_baseline: Int = 0

fn seed_emitter_behavioral_green_count() -> Int {
  fold(
    producer_emission_oracle_rows,
    init: 0,
    f: fn(count, row) {
      if producer_emission_row_is_seed_behavioral_green(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn v2_interpreted_emitter_behavioral_green_count() -> Int {
  fold(
    producer_emission_oracle_rows,
    init: 0,
    f: fn(count, row) {
      if producer_emission_row_is_v2_interpreted_behavioral_green(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn v2_native_emitter_behavioral_green_count() -> Int {
  fold(
    producer_emission_oracle_rows,
    init: 0,
    f: fn(count, row) {
      if producer_emission_row_is_v2_native_behavioral_green(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn v2_emitter_production_routed_count() -> Int {
  fold(
    producer_emission_oracle_rows,
    init: 0,
    f: fn(count, row) {
      if producer_emission_row_is_v2_production_routed(row: row) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn seed_emitter_behavioral_green_baseline_holds() -> Bool {
  seed_emitter_behavioral_green_count() == seed_emitter_behavioral_green_baseline
}

fn v2_interpreted_emitter_behavioral_green_baseline_holds() -> Bool {
  v2_interpreted_emitter_behavioral_green_count() == v2_interpreted_emitter_behavioral_green_baseline
}

fn v2_native_emitter_behavioral_green_baseline_holds() -> Bool {
  v2_native_emitter_behavioral_green_count() == v2_native_emitter_behavioral_green_baseline
}

fn v2_emitter_production_routed_baseline_holds() -> Bool {
  v2_emitter_production_routed_count() == v2_emitter_production_routed_baseline
}

fn producer_qualified_baselines_holds() -> Bool {
  seed_emitter_behavioral_green_baseline_holds()
    && v2_interpreted_emitter_behavioral_green_baseline_holds()
    && v2_native_emitter_behavioral_green_baseline_holds()
    && v2_emitter_production_routed_baseline_holds()
}
