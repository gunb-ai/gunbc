fn hand_forged_emitter_produced_authorization_fails_mint_consistency_holds() -> Bool {
  let row = producer_emission_oracle_row_body_producer
  let fabricated = fabricated_v1_seed_producer_receipt(module_path: row.module_path)
  let executed = ProducerEmissionExecutedGreenReceipt {
    module_path: row.module_path,
    behavioral_probe_entry: row.behavioral_probe_entry,
    behavioral_probe_function: row.behavioral_probe_function,
    wet_execution_digest: content_hash_atom(value: row.behavioral_probe_entry)
  }
  let forged = AuthorizedEmitterProducedDisposition {
    authorization_token: content_hash_atom(value: "hand_forged_emitter_produced_authorization"),
    provenance: fabricated,
    executed_verdict: executed
  }
  !authorized_emitter_produced_disposition_mint_consistent(
    module_path: row.module_path,
    authorization: forged
  )
}

fn hand_forged_matching_token_unauthorized_still_fails_mint_consistency_holds() -> Bool {
  let row = producer_emission_oracle_row_body_producer
