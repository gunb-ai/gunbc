fn emitter_producer_eq(left: EmitterProducer, right: EmitterProducer) -> Bool {
  match left {
    V1SeedEmitter =>
      match right {
        V1SeedEmitter => true
        V2EmitterInterpreted => false
        V2EmitterNative { generation: _ } => false
      }
    V2EmitterInterpreted =>
      match right {
        V1SeedEmitter => false
        V2EmitterInterpreted => true
        V2EmitterNative { generation: _ } => false
      }
    V2EmitterNative { generation: left_generation } =>
      match right {
        V1SeedEmitter => false
        V2EmitterInterpreted => false
        V2EmitterNative { generation: right_generation } =>
          left_generation == right_generation
      }
  }
}

fn emission_build_result_eq(left: EmissionBuildResult, right: EmissionBuildResult) -> Bool {
  match left {
    BuildGreen =>
      match right {
        BuildGreen => true
        BuildRefused { cause: _ } => false
      }
    BuildRefused { cause: left_cause } =>
      match right {
        BuildGreen => false
        BuildRefused { cause: right_cause } => left_cause == right_cause
      }
  }
}

fn qualifications_list_eq(
  left: List<EmissionQualification>,
  right: List<EmissionQualification>
) -> Bool {
  if length(xs: left) != length(xs: right) {
    false
  } else {
    fold_list(
      xs: left,
      empty: true,
      cons: fn(ok, left_q) {
        ok && any(
          xs: right,
          predicate: fn(right_q) {
            emission_qualification_eq(left: left_q, right: right_q)
          }
        )
      }
    )
  }
}

fn realized_closure_eq(left: RealizedEmitterClosure, right: RealizedEmitterClosure) -> Bool {
  if length(xs: left.emitter_module_paths) != length(xs: right.emitter_module_paths) {
    false
  } else {
    fold_list(
      xs: left.emitter_module_paths,
      empty: true,
      cons: fn(ok, path) {
        ok && any(
          xs: right.emitter_module_paths,
          predicate: fn(right_path) { path == right_path }
        )
      }
    )
  }
}

fn producer_emission_receipt_eq(left: ProducerEmissionReceipt, right: ProducerEmissionReceipt) -> Bool {
  (left.module_path == right.module_path)
    && (left.module_source_digest == right.module_source_digest)
    && (left.emitter_source_digest == right.emitter_source_digest)
    && emitter_producer_eq(left: left.producer, right: right.producer)
    && qualifications_list_eq(left: left.qualifications, right: right.qualifications)
    && (left.rust_target_model_digest == right.rust_target_model_digest)
    && (left.emitted_source_digest == right.emitted_source_digest)
    && emission_build_result_eq(left: left.build_result, right: right.build_result)
    && behavioral_probe_binding_eq(left: left.behavioral_probe, right: right.behavioral_probe)
    && realized_closure_eq(left: left.realized_closure, right: right.realized_closure)
}

fn producer_emission_oracle_probe_is_enrolled(row: ProducerEmissionOracleRow) -> Bool {
  schedule_witness_entry_cited(
    probe_entry: row.behavioral_probe_entry,
    probe_function: row.behavioral_probe_function,
    entries: seed_emitter_behavioral_wet_known_red_entries
  )
}

fn producer_emission_oracle_rows_match_transport_roster_holds() -> Bool {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: true,
    cons: fn(ok, row) {
      ok && match module_behavioral_transport_config_for(module_path: row.module_path) {
        Present { value: _ } => true
        Absent => false
      }
    }
  )
}

fn producer_emission_oracle_row_for_module(module_path: String) -> List<ProducerEmissionOracleRow> {
  fold_list(
    xs: producer_emission_oracle_rows,
    empty: producer_emission_oracle_rows_empty,
    cons: fn(acc, row) {
      if row.module_path == module_path {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

data producer_emission_oracle_authorization_note: String = "Reviews 44328/44480: authorization is ONLY via producer_emission_canonical_receipt_for_executed_verdict (row + executed_verdict on EmitterProduced) — never producer_emission_canonical_receipt_for_oracle_row (static enrollment/quarantine only). producer_emission_executed_digest_is_execution_measured is false at baseline until witness-realization + frontier_probe_survey. Enrollment binds BuildRefused quarantine receipts + transport roster."

fn producer_emission_oracle_enrolls_row(
  module_path: String,
  receipt: ProducerEmissionReceipt
) -> Bool {
  any(
    xs: producer_emission_oracle_row_for_module(module_path: module_path),
    predicate: fn(row) {
      match producer_emission_receipt_from_oracle_row(row: row) {
        Present { value: canonical } =>
          producer_emission_receipt_eq(left: canonical, right: receipt)
            && producer_emission_oracle_probe_is_enrolled(row: row)
            && match module_behavioral_transport_config_for(module_path: row.module_path) {
              Present { value: _ } => true
              Absent => false
            }
        Absent => false
      }
    }
  )
}

fn producer_emission_oracle_authorizes_row(
  module_path: String,
  receipt: ProducerEmissionReceipt,
  executed: ProducerEmissionExecutedGreenReceipt
) -> Bool {
  match receipt.build_result {
    BuildGreen =>
      any(
        xs: producer_emission_oracle_row_for_module(module_path: module_path),
        predicate: fn(row) {
          match producer_emission_canonical_receipt_for_executed_verdict(row: row, executed: executed) {
            Present { value: canonical } =>
              producer_emission_receipt_eq(left: canonical, right: receipt)
                && match module_behavioral_transport_config_for(module_path: row.module_path) {
                  Present { value: _ } => true
                  Absent => false
                }
            Absent => false
          }
        }
      )
    BuildRefused { cause: _ } => false
  }
}

fn producer_emission_oracle_authorization_requires_executed_verdict_holds() -> Bool {
  let row = producer_emission_oracle_row_body_producer
  let fabricated = fabricated_v1_seed_producer_receipt(module_path: row.module_path)
  let executed = ProducerEmissionExecutedGreenReceipt {
    module_path: row.module_path,
    behavioral_probe_entry: row.behavioral_probe_entry,
    behavioral_probe_function: row.behavioral_probe_function,
    wet_execution_digest: content_hash_atom(value: row.behavioral_probe_entry)
  }
  !producer_emission_oracle_authorizes_row(
    module_path: row.module_path,
    receipt: fabricated,
    executed: executed
  )
}

data authorized_emitter_produced_disposition_note: String = "Reviews 44485/44487/44504/44509/44570: SelfHostFrontierDisposition.EmitterProduced carries authorization_binding in the variant — unauthorized tag-only rows are unrepresentable (review 44570). Mint path: mint_emitter_produced_frontier_promotion. Derivation: authorization_token from (module_path, provenance digests, executed wet_execution_digest); census requires mint_consistent per EmitterProduced roster row. Residual substrate limit: .dag records remain freely constructible if someone authors a forged binding literal — mint_consistent + authorize gates refuse at use. Live roster emitter_produced_baseline=0 and promotions empty at baseline."

fn authorized_emitter_produced_authorization_token(
  module_path: String,
  provenance: ProducerEmissionReceipt,
  executed_verdict: ProducerEmissionExecutedGreenReceipt
) -> Hash {
  combine_hash(
    a: symbol_identity_digest(sym: ^authorized_emitter_produced_disposition),
    b: combine_hash(
      a: content_hash_atom(value: module_path),
      b: combine_hash(
        a: provenance.module_source_digest,
        b: combine_hash(
          a: provenance.emitted_source_digest,
          b: executed_verdict.wet_execution_digest
        )
      )
    )
  )
}

type AuthorizedEmitterProducedDisposition {
  authorization_token: Hash
  provenance: ProducerEmissionReceipt
  executed_verdict: ProducerEmissionExecutedGreenReceipt
}

type EmitterProducedAuthorizationBinding {
  module_path: String
  authorization: AuthorizedEmitterProducedDisposition
}

data emitter_produced_authorization_binding_note: String = "Review 44504/44509/44570: authorization_binding lives inside EmitterProduced disposition (frontier.dag). Promotions store minted frontier rows only; the registry is a derived projection — never a parallel hand-edited authority. Dissolve-on: witness-realization appends promotions atomically with roster flips via mint_emitter_produced_frontier_promotion."

fn authorized_emitter_produced_disposition_mint_consistent(
  module_path: String,
  authorization: AuthorizedEmitterProducedDisposition
) -> Bool {
  authorized_emitter_produced_authorization_token(
    module_path: module_path,
    provenance: authorization.provenance,
    executed_verdict: authorization.executed_verdict
  ) == authorization.authorization_token
    && producer_emission_oracle_authorizes_row(
      module_path: module_path,
      receipt: authorization.provenance,
      executed: authorization.executed_verdict
    )
}

fn authorized_emitter_produced_provenance(
  authorization: AuthorizedEmitterProducedDisposition
) -> ProducerEmissionReceipt {
  authorization.provenance
}

fn authorized_emitter_produced_executed_verdict(
  authorization: AuthorizedEmitterProducedDisposition
) -> ProducerEmissionExecutedGreenReceipt {
  authorization.executed_verdict
}

fn mint_authorized_emitter_produced_disposition(
  module_path: String,
  provenance: ProducerEmissionReceipt,
  executed_verdict: ProducerEmissionExecutedGreenReceipt
) -> Optional<AuthorizedEmitterProducedDisposition> {
  if producer_emission_oracle_authorizes_row(
    module_path: module_path,
    receipt: provenance,
    executed: executed_verdict
  ) {
    optional_present(
      value: AuthorizedEmitterProducedDisposition {
        authorization_token: authorized_emitter_produced_authorization_token(
          module_path: module_path,
          provenance: provenance,
          executed_verdict: executed_verdict
        ),
        provenance: provenance,
        executed_verdict: executed_verdict
      }
    )
  } else {
    optional_absent()
  }
}

fn mint_emitter_produced_authorization_registry_binding(
  module_path: String,
  provenance: ProducerEmissionReceipt,
  executed_verdict: ProducerEmissionExecutedGreenReceipt
) -> Optional<EmitterProducedAuthorizationBinding> {
  match mint_authorized_emitter_produced_disposition(
    module_path: module_path,
    provenance: provenance,
    executed_verdict: executed_verdict
  ) {
    Present { value: authorization } =>
      optional_present(
        value: EmitterProducedAuthorizationBinding {
          module_path: module_path,
          authorization: authorization
        }
      )
    Absent => optional_absent()
  }
}

