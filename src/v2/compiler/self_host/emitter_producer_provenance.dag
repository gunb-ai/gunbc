  optional_present
}
import v2.std.text { String }

data emitter_producer_provenance_note: String = "CompilerFixedPoint producer/qualification authority (session valiant-crab-382, calm-badger-682 ruling 2026-07-29): replaces SelfEmitted state-space conflation with orthogonal EmitterProducer x EmissionQualification axes. A frontier EmitterProduced row is reachable ONLY from a ProducerEmissionReceipt minted through mint_producer_emission_receipt — never from a hand-authored ProducerEmissionReceipt literal in a data row (review 44333). Static oracle derivation never mints BuildGreen (reviews 44441/44455/44460/44468). producer_emission_canonical_receipt_for_executed_verdict is unwritable at baseline (always Absent) until witness-realization + frontier_probe_survey bind execution-measured verdict digests. Wet execution proof: each enrolled probe witness runs tools.self_host_module_behavioral_transport_roster.compiler_module_behavioral_receipt_for. Structural wall: V2Emitter* is unwritable when v1.compiler.emit_rust is in the realized closure."

type EmitterProducer
  = V1SeedEmitter
  | V2EmitterInterpreted
  | V2EmitterNative { generation: Int }

type EmissionQualification
  = SourceProduced
  | CargoGreen
  | BehavioralEquivalent
  | ProductionRouted

data emission_qualification_eq_note: String = "Canonical equality surface for EmissionQualification (reviews 44328/44481 predicate-dissolution): one total match over the substrate coproduct — membership and list-equality queries consume emission_qualification_eq, not hand-rolled has_* predicates."

fn emission_qualification_eq(
  left: EmissionQualification,
  right: EmissionQualification
) -> Bool {
  match left {
    SourceProduced =>
      match right {
        SourceProduced => true
        CargoGreen => false
        BehavioralEquivalent => false
        ProductionRouted => false
      }
    CargoGreen =>
      match right {
        SourceProduced => false
        CargoGreen => true
        BehavioralEquivalent => false
        ProductionRouted => false
      }
    BehavioralEquivalent =>
      match right {
        SourceProduced => false
        CargoGreen => false
        BehavioralEquivalent => true
        ProductionRouted => false
      }
    ProductionRouted =>
      match right {
        SourceProduced => false
        CargoGreen => false
        BehavioralEquivalent => false
        ProductionRouted => true
      }
  }
}

fn emission_qualifications_list_contains(
  xs: List<EmissionQualification>,
  wanted: EmissionQualification
) -> Bool {
  any(
    xs: xs,
    predicate: fn(q) { emission_qualification_eq(left: q, right: wanted) }
  )
}

type EmissionBuildResult
  = BuildGreen
  | BuildRefused { cause: Symbol }

type RealizedEmitterClosure {
  emitter_module_paths: List<String>
}

data behavioral_probe_binding_note: String = "A behavioral probe is a witness that COMPILES the emitted Rust, RUNS it, and COMPARES behavior against the seed. Carrying it as a bare pair of strings made every receipt claim one existed, because there is no unbound spelling of a String pair: an author with no such witness has to write something, and whatever is written becomes the subject that ProducerEmissionExecutedGreenReceipt matching and the BehavioralEquivalent advance later consume. That is the fabricated-plausible-output failure (DESIGN section 5) at the receipt's own self-description. BehavioralProbeUnbound is therefore a real state, not a null: a receipt that has produced source and nothing more says so, and binding becomes meaningful only where an actual compile/run/compare seam exists. The direct Rust door is exactly that case — it observes ingest through emission and stops, so it binds nothing. Dissolve-on: the ProducerEmissionOracleRow and ProducerEmissionExecutedGreenReceipt pairs migrate onto this carrier too, at which point the executed-verdict match keys on a binding rather than on two strings that may name no witness."

type BehavioralProbeBinding
  = BehavioralProbeUnbound
  | BehavioralProbeBound { entry: String, function: String }

fn behavioral_probe_binding_eq(left: BehavioralProbeBinding, right: BehavioralProbeBinding) -> Bool {
  match left {
    BehavioralProbeUnbound => match right {
      BehavioralProbeUnbound => true
      BehavioralProbeBound { entry: _, function: _ } => false
    }
    BehavioralProbeBound { entry: le, function: lf } => match right {
      BehavioralProbeUnbound => false
      BehavioralProbeBound { entry: re, function: rf } => (le == re) && (lf == rf)
    }
  }
}

type ProducerEmissionReceipt {
  module_path: String
  module_source_digest: Hash
  emitter_source_digest: Hash
  producer: EmitterProducer
  qualifications: List<EmissionQualification>
  rust_target_model_digest: Hash
  emitted_source_digest: Hash
  build_result: EmissionBuildResult
  behavioral_probe: BehavioralProbeBinding
  realized_closure: RealizedEmitterClosure
}

type ProducerEmissionOracleRow {
  module_path: String
  measured_probe: FrontierProbeReceipt
  behavioral_probe_entry: String
  behavioral_probe_function: String
}

type ProducerEmissionExecutedGreenReceipt {
  module_path: String
  behavioral_probe_entry: String
  behavioral_probe_function: String
  wet_execution_digest: Hash
}

data producer_emission_executed_green_receipts_note: String = "Witness-realization mint contract (reviews 44455/44460/44465/44468): ProducerEmissionExecutedGreenReceipt type names the future executed-verdict carrier. producer_emission_canonical_receipt_for_executed_verdict is unwritable at baseline (always Absent) — no synthesizable digest from declarative oracle fields can mint BuildGreen. Dissolve-on: frontier_probe_survey binds execution-measured verdict digests; witness-realization becomes the sole host minter. Static oracle derivation never mints BuildGreen."

data v1_seed_emit_rust_qualified_module: String = "v1.compiler.emit_rust"

data v2_emit_interpreted_qualified_module: String = "v2.compiler.emit"

data cssl_harness_realized_closure_note: String = "Structural authority for the cssl seed-linked behavioral harness (tools.self_host_curated_seed_linked_harness): gunbc compile routes through v1.compile -> v1.compiler.emit_rust. Any receipt minted from this closure MUST be V1SeedEmitter — V2Emitter* is unwritable by construction."

data cssl_harness_realized_closure: RealizedEmitterClosure = RealizedEmitterClosure {
  emitter_module_paths: [
    "v1.compile",
    v1_seed_emit_rust_qualified_module
  ]
}

data v2_interpreted_emitter_closure_note: String = "V2EmitterInterpreted closure for Lane B direct rust door: v2.compiler.emit (serialize_target composed with translate) plus v2.compiler.self_host.candidate_generation (mint_provenanced_rust_artifact entry), without v1.compiler.emit_rust. Landed as first customer in session bright-bear-372."

data v2_interpreted_emitter_closure: RealizedEmitterClosure = RealizedEmitterClosure {
  emitter_module_paths: [
    v2_emit_interpreted_qualified_module,
    "v2.compiler.translate",
    "v2.compiler.self_host.candidate_generation"
  ]
}

fn realized_closure_contains_module(
  closure: RealizedEmitterClosure,
  module: String
) -> Bool {
  any(
    xs: closure.emitter_module_paths,
    predicate: fn(path) { path == module }
  )
}

fn seed_emit_rust_reachable(closure: RealizedEmitterClosure) -> Bool {
  realized_closure_contains_module(
    closure: closure,
    module: v1_seed_emit_rust_qualified_module
  )
}

fn v2_interpreted_emitter_closure_seed_free_holds() -> Bool {
  !seed_emit_rust_reachable(closure: v2_interpreted_emitter_closure)
}

fn realized_closure_for_v2_direct_rust_door_emit_run() -> RealizedEmitterClosure {
  RealizedEmitterClosure {
    emitter_module_paths: [
      "v2.compiler.self_host.candidate_generation",
      v2_emit_interpreted_qualified_module,
      "v2.compiler.translate"
    ]
  }
}

data realized_closure_for_v2_direct_rust_door_emit_run_note: String = "Post-emit-run closure authority for Lane B direct rust door: mint_provenanced_rust_artifact calls this ONLY after generate_rust_emission_candidate (the serialize_target run) succeeds — never as a caller-supplied parameter. Paths name modules on the v2 interpreted emit route excluding v1.compiler.emit_rust."

fn v2_interpreted_emitter_closure_authority() -> RealizedEmitterClosure {
  realized_closure_for_v2_direct_rust_door_emit_run()
}

data v2_emitter_in_seed_emit_rust_closure: String = "V2Emitter* producer mint refused: realized_closure contains v1.compiler.emit_rust (structural construction wall, calm-badger-682 ruling 2026-07-29)"

type EmitterProducerMintAdmission
  = ProducerMintAdmitted
  | ProducerMintRefused { cause: Symbol }

data emitter_producer_mint_admission_note: String = "🟢 Canonical admission fold over EmitterProducer (review 44579 predicate-dissolution): emitter_producer_mint_admission is the ONLY total match classifying producer×realized_closure admissibility — mint_producer_emission_receipt consumes this surface; no parallel hand-rolled Bool admissibility predicates."

fn emitter_producer_mint_admission(
  producer: EmitterProducer,
  closure: RealizedEmitterClosure
) -> EmitterProducerMintAdmission {
  match producer {
    V1SeedEmitter => ProducerMintAdmitted
    V2EmitterInterpreted =>
      if seed_emit_rust_reachable(closure: closure) {
        ProducerMintRefused { cause: ^v2_emitter_in_seed_emit_rust_closure }
      } else {
        ProducerMintAdmitted
      }
    V2EmitterNative { generation: _ } =>
      if seed_emit_rust_reachable(closure: closure) {
        ProducerMintRefused { cause: ^v2_emitter_in_seed_emit_rust_closure }
      } else {
        ProducerMintAdmitted
      }
  }
}

data behavioral_equivalent_qualifications: List<EmissionQualification> = [BehavioralEquivalent]

data source_produced_qualifications: List<EmissionQualification> = [SourceProduced]

data cargo_green_qualifications: List<EmissionQualification> = [SourceProduced, CargoGreen]

data behavioral_equivalent_with_cargo_qualifications: List<EmissionQualification> = [
  SourceProduced,
  CargoGreen,
  BehavioralEquivalent
]

data behavioral_probe_qualification_admission_note: String = "THE ONE authority relating a probe binding to a qualification population, consumed by BOTH mint and the behavioral advance so neither can drift from the other. Without it, BehavioralProbeUnbound only DESCRIBED the absence of behavioral evidence while the strongest behavioral qualification stayed writable beside it: the advance predicate read build result and qualifications and never looked at the probe, and mint reconciled the producer against its closure but not the qualifications against the probe. A carrier that records a fact the consequential constructor does not consume is the recurring failure this whole lane exists to remove — the fact is present locally and the wall is absent. The relation: BehavioralEquivalent REQUIRES a bound probe, because that qualification asserts a run happened and a bound probe is the only thing that names what ran. SourceProduced and CargoGreen stay legal beside an unbound probe, because producing source and compiling it are exactly the states that precede behavioral evidence — walling those would make the ordinary pre-behavior receipt unwritable. This makes the newly introduced Unbound state non-promotable; it does NOT claim the Boolean advance argument is itself executed evidence, which remains the separate executed-verdict obligation."

data behavioral_equivalent_without_bound_probe: String = "BehavioralEquivalent refused: the receipt carries BehavioralProbeUnbound, so no witness names the compile/run/compare that qualification asserts"

type BehavioralProbeAdmission
  = BehavioralProbeConsistent
  | BehavioralProbeRefused { cause: Symbol }

fn behavioral_probe_qualification_admission(
  probe: BehavioralProbeBinding,
  qualifications: List<EmissionQualification>
) -> BehavioralProbeAdmission {
  match probe {
    BehavioralProbeBound { entry: _, function: _ } => BehavioralProbeConsistent
    BehavioralProbeUnbound =>
      if emission_qualifications_list_contains(
        xs: qualifications,
        wanted: BehavioralEquivalent
      ) {
        BehavioralProbeRefused { cause: ^behavioral_equivalent_without_bound_probe }
      } else {
        BehavioralProbeConsistent
      }
  }
}

fn producer_receipt_admits_cargo_green_advance(receipt: ProducerEmissionReceipt) -> Bool {
  emission_qualifications_list_contains(
    xs: receipt.qualifications,
    wanted: SourceProduced
  )
    && !emission_qualifications_list_contains(
      xs: receipt.qualifications,
      wanted: CargoGreen
    )
    && !emission_qualifications_list_contains(
      xs: receipt.qualifications,
      wanted: BehavioralEquivalent
    )
}

fn producer_receipt_admits_behavioral_equivalent_advance(
  receipt: ProducerEmissionReceipt
) -> Bool {
  match behavioral_probe_qualification_admission(
    probe: receipt.behavioral_probe,
    qualifications: behavioral_equivalent_with_cargo_qualifications
  ) {
    BehavioralProbeRefused { cause: _ } => false
    BehavioralProbeConsistent =>
      match receipt.build_result {
        BuildGreen =>
          emission_qualifications_list_contains(
            xs: receipt.qualifications,
            wanted: CargoGreen
          )
            && !emission_qualifications_list_contains(
              xs: receipt.qualifications,
              wanted: BehavioralEquivalent
            )
        BuildRefused { cause: _ } => false
      }
  }
}

fn advance_producer_emission_receipt_cargo_green(
  prior: ProducerEmissionReceipt,
  cargo_green: Bool
) -> Optional<ProducerEmissionReceipt> {
  if !cargo_green
    || !producer_receipt_admits_cargo_green_advance(receipt: prior) {
    optional_absent()
  } else {
    mint_producer_emission_receipt(
      module_path: prior.module_path,
      producer: prior.producer,
      qualifications: cargo_green_qualifications,
      build_result: BuildGreen,
      behavioral_probe: prior.behavioral_probe,
      realized_closure: prior.realized_closure
    )
  }
}

fn advance_producer_emission_receipt_behavioral_equivalent(
  prior: ProducerEmissionReceipt,
  behavioral_equivalent: Bool
) -> Optional<ProducerEmissionReceipt> {
  if !behavioral_equivalent
    || !producer_receipt_admits_behavioral_equivalent_advance(receipt: prior) {
    optional_absent()
  } else {
    mint_producer_emission_receipt(
      module_path: prior.module_path,
      producer: prior.producer,
      qualifications: behavioral_equivalent_with_cargo_qualifications,
      build_result: BuildGreen,
      behavioral_probe: prior.behavioral_probe,
      realized_closure: prior.realized_closure
    )
  }
}

fn scaffold_digest_for_module_path(module_path: String) -> Hash {
  combine_hash(
    a: symbol_identity_digest(sym: ^frontier_producer_receipt_scaffold_digest),
    b: content_hash_atom(value: module_path)
  )
}

fn mint_producer_emission_receipt(
  module_path: String,
  producer: EmitterProducer,
  qualifications: List<EmissionQualification>,
  build_result: EmissionBuildResult,
  behavioral_probe: BehavioralProbeBinding,
  realized_closure: RealizedEmitterClosure
) -> Optional<ProducerEmissionReceipt> {
  match behavioral_probe_qualification_admission(
    probe: behavioral_probe,
    qualifications: qualifications
  ) {
    BehavioralProbeRefused { cause: _ } => optional_absent()
    BehavioralProbeConsistent =>
  match emitter_producer_mint_admission(producer: producer, closure: realized_closure) {
    ProducerMintAdmitted =>
      optional_present(
        value: ProducerEmissionReceipt {
        module_path: module_path,
        module_source_digest: scaffold_digest_for_module_path(module_path: module_path),
        emitter_source_digest: scaffold_digest_for_module_path(
          module_path: match producer {
            V1SeedEmitter => v1_seed_emit_rust_qualified_module
            V2EmitterInterpreted => v2_emit_interpreted_qualified_module
            V2EmitterNative { generation: _ } => v2_emit_interpreted_qualified_module
          }
        ),
        producer: producer,
        qualifications: qualifications,
        rust_target_model_digest: symbol_identity_digest(sym: ^rust_target_model_digest_scaffold),
        emitted_source_digest: scaffold_digest_for_module_path(module_path: module_path),
        build_result: build_result,
        behavioral_probe: behavioral_probe,
        realized_closure: realized_closure
      }
    )
    ProducerMintRefused { cause: _ } => optional_absent()
  }
  }
}

fn producer_emission_measured_probe_receipt(module_path: String) -> FrontierProbeReceipt {
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: SelfEmitReady,
    located_stage: ProbeStageEmit,
    located_reason: ^measured_probe_self_emit_ready,
    detail: FrontierProbeDetailAbsent,
    assemble_detail: NoFrontierProbeDetail
  }
}

data producer_emission_receipt_digest_scaffold_note: String = "SCAFFOLD (review 44333 partial landing): mint_producer_emission_receipt still keys digests on symbol_identity_digest scaffolds until frontier_probe_survey binds execution-measured module/emitter/emitted-source hashes. The construction wall landed here is: (1) no hand-authored ProducerEmissionReceipt in oracle data rows; (2) BuildRefused cannot authorize EmitterProduced; (3) every oracle row's probe has a matching compiler_module_behavioral_transport_roster row executed by its wet witness."

fn seed_emitter_behavioral_oracle_row(
  module_path: String,
  behavioral_probe_entry: String,
  behavioral_probe_function: String
) -> ProducerEmissionOracleRow {
  ProducerEmissionOracleRow {
    module_path: module_path,
    measured_probe: producer_emission_measured_probe_receipt(module_path: module_path),
    behavioral_probe_entry: behavioral_probe_entry,
    behavioral_probe_function: behavioral_probe_function
  }
}

fn producer_emission_oracle_probe_is_known_red_quarantine(row: ProducerEmissionOracleRow) -> Bool {
  producer_emission_oracle_probe_is_enrolled(row: row)
}

data producer_emission_canonical_receipt_for_executed_verdict_note: String = "Executed-verdict authorization pipeline (reviews 44468/44477): matches oracle row + enrolled probe, refuses synthesizable declarative digests (44468), then requires producer_emission_executed_digest_is_execution_measured (false at baseline until witness-realization binds host-measured claim_executor verdict digests). Static oracle derivation never mints BuildGreen."

fn producer_emission_executed_receipt_matches_oracle_row(
  row: ProducerEmissionOracleRow,
  executed: ProducerEmissionExecutedGreenReceipt
) -> Bool {
  (row.module_path == executed.module_path)
    && (row.behavioral_probe_entry == executed.behavioral_probe_entry)
    && (row.behavioral_probe_function == executed.behavioral_probe_function)
}

fn producer_emission_executed_digest_is_synthesizable_from_declarative_inputs(
  row: ProducerEmissionOracleRow,
  executed: ProducerEmissionExecutedGreenReceipt
) -> Bool {
  let digest = executed.wet_execution_digest
  digest == content_hash_atom(value: row.behavioral_probe_entry)
    || digest == content_hash_atom(value: row.behavioral_probe_function)
    || digest == content_hash_atom(value: row.module_path)
    || digest == scaffold_digest_for_module_path(module_path: row.module_path)
    || digest == symbol_identity_digest(sym: ^frontier_producer_receipt_scaffold_digest)
}

data producer_emission_execution_measured_digest_admissible_note: String = "Construction wall (reviews 44468/44477): unwritable at baseline — witness-realization + frontier_probe_survey bind host-measured verdict digests. Refusing synthesizable declarative digests alone is insufficient (any other Hash is forgeable in-model); this predicate is the dissolve-on hook."

fn producer_emission_executed_digest_is_execution_measured(
  row: ProducerEmissionOracleRow,
  executed: ProducerEmissionExecutedGreenReceipt
) -> Bool {
  false
}

fn producer_emission_canonical_receipt_for_executed_verdict(
  row: ProducerEmissionOracleRow,
  executed: ProducerEmissionExecutedGreenReceipt
) -> Optional<ProducerEmissionReceipt> {
  if !producer_emission_executed_receipt_matches_oracle_row(row: row, executed: executed) {
    optional_absent()
  } else if !producer_emission_oracle_probe_is_enrolled(row: row) {
    optional_absent()
  } else if producer_emission_executed_digest_is_synthesizable_from_declarative_inputs(
    row: row,
    executed: executed
  ) {
    optional_absent()
  } else if !producer_emission_executed_digest_is_execution_measured(row: row, executed: executed) {
    optional_absent()
  } else {
    match mint_producer_emission_receipt(
      module_path: row.module_path,
      producer: V1SeedEmitter,
      qualifications: behavioral_equivalent_qualifications,
      build_result: BuildGreen,
      behavioral_probe: BehavioralProbeBound {
        entry: row.behavioral_probe_entry,
        function: row.behavioral_probe_function
      },
      realized_closure: cssl_harness_realized_closure
    ) {
      Present { value: receipt } =>
        match receipt.build_result {
          BuildGreen => optional_present(value: receipt)
          BuildRefused { cause: _ } => optional_absent()
        }
      Absent => optional_absent()
    }
  }
}

fn producer_emission_build_result_for_oracle_row(row: ProducerEmissionOracleRow) -> EmissionBuildResult {
  if producer_emission_oracle_probe_is_known_red_quarantine(row: row) {
    BuildRefused { cause: ^cssl_harness_assemble_red }
  } else {
    BuildRefused { cause: ^producer_emission_probe_not_executed_green }
  }
}

fn producer_emission_receipt_from_oracle_row(
  row: ProducerEmissionOracleRow
) -> Optional<ProducerEmissionReceipt> {
  mint_producer_emission_receipt(
    module_path: row.module_path,
    producer: V1SeedEmitter,
    qualifications: behavioral_equivalent_qualifications,
    build_result: producer_emission_build_result_for_oracle_row(row: row),
    behavioral_probe: BehavioralProbeBound {
      entry: row.behavioral_probe_entry,
      function: row.behavioral_probe_function
    },
    realized_closure: cssl_harness_realized_closure
  )
}

fn producer_emission_canonical_receipt_for_oracle_row(
  row: ProducerEmissionOracleRow
) -> Optional<ProducerEmissionReceipt> {
  match producer_emission_receipt_from_oracle_row(row: row) {
    Present { value: receipt } =>
      match receipt.build_result {
        BuildGreen => optional_present(value: receipt)
        BuildRefused { cause: _ } => optional_absent()
      }
    Absent => optional_absent()
  }
}

