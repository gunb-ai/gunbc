data producer_emission_oracle_row_00_compile_flip_wave_red_note: String = "Secondary regression (2026-07-20 flip-wave): synthetic row for 00_compile dishonest claim replay — NEVER in live registry."

data producer_emission_oracle_row_00_compile_flip_wave_red: ProducerEmissionOracleRow = ProducerEmissionOracleRow {
  module_path: "src/v2/compiler/00_compile.dag",
  measured_probe: producer_emission_measured_probe_receipt(module_path: "src/v2/compiler/00_compile.dag"),
  receipt: ProducerEmissionReceipt {
    module_path: "src/v2/compiler/00_compile.dag",
    module_source_digest: scaffold_digest_for_module_path(module_path: "src/v2/compiler/00_compile.dag"),
    emitter_source_digest: scaffold_digest_for_module_path(module_path: v1_seed_emit_rust_qualified_module),
    producer: V1SeedEmitter,
    qualifications: [BehavioralEquivalent],
    rust_target_model_digest: symbol_identity_digest(sym: ^rust_target_model_digest_scaffold),
