data producer_emission_oracle_row_00_compile_flip_wave_red_note: String = "Secondary regression (2026-07-20 flip-wave): synthetic row for 00_compile dishonest claim replay — NEVER in live registry."

data producer_emission_oracle_row_00_compile_flip_wave_red: ProducerEmissionOracleRow = ProducerEmissionOracleRow {
