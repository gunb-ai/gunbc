data seed_emitter_behavioral_wet_green_entries_note: String = "Positive-authority roster for V1SeedEmitter behavioral wet probes that executed green (review 44435). BuildGreen is reachable ONLY via citation here — absence from seed_emitter_behavioral_wet_known_red_entries is NOT sufficient (fail-closed: deleting a quarantine row without landing here keeps BuildRefused). Promotion path: wet witness greens → add row here AND delete the matching known-red row. Cycle-free leaf beside seed_emitter_behavioral_wet_known_red_entries."

fn seed_emitter_behavioral_wet_green_entry(entry: String, f: String) -> ScheduleWitnessEntry {
  ScheduleWitnessEntry { entry: entry, function: f, kind: ExecutionWitnessKind }
}

data seed_emitter_behavioral_wet_green_entries: List<ScheduleWitnessEntry> = []
