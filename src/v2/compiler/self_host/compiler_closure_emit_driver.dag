module v2.compiler.self_host.compiler_closure_emit_driver

import v2.compiler.name_resolve { Admission }
import v2.compiler.self_host.compiler_closure_emit {
  CompilerClosureEmitReceipt,
  emit_compiler_import_closure_from_ingest
}
import v2.compiler.source_authority {
  DiscoveredSourceRefsDigest,
  SourceRef,
  SourceRootIngest,
  SourceRootIngestBuildOk,
  SourceRootIngestBuildReadFailed,
  SourceRootProvenanceCoverageReceipt,
  discovered_source_refs_digest_eq,
  discovered_source_refs_digest_for_refs,
  source_root_closure_ref_transport_complete,
  source_root_ref_carrier_coverage_is_complete,
  source_root_ingest_build_from_source_refs
}
import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.compilers.lexing { symbol_intern_lexeme }
import v2.std.compilers.target_model { TargetModel }
import v2.std.node { Symbol }
import v2.std.diagnostic {
  CorrectionNotModeled,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  outcome_rejected,
  textual_whole_file_diagnostic
}
import v2.std.logic { Bool }

// WHY THIS EXISTS, and why it is not a second path beside the emitter.
//
// emit_compiler_import_closure_from_ingest is total over whatever ingest it is
// handed, which is correct for an emitter and useless as an acceptance claim:
// an EMPTY ingest emits an empty program and reports Accepted. The only
// existing caller folded a failed read into Empty, so a read failure and a
// clean corpus produced the same Accepted receipt -- the empty-observation
// narrow, bottom-as-answer conflated with bottom-as-ignorance.
//
// So the acceptance criterion lives HERE, ahead of the emitter, and every arm
// below refuses BEFORE the emitter is reached. There is exactly one producer
// (source_root_ingest_build_from_source_refs), exactly one consumer
// (emit_compiler_import_closure_from_ingest), and exactly one population hash
// (discovered_source_refs_digest_for_refs), so no arm can answer from a
// population a different arm did not see.

fn closure_emit_driver_locus_file(refs: List<SourceRef>) -> Symbol {
  match refs {
    Empty => symbol_intern_lexeme(lexeme: "<empty-closure-ref-population>")
    Cons { head: head, tail: _ } => symbol_intern_lexeme(lexeme: head.path)
  }
}

fn closure_emit_driver_refusal(
  reason: Symbol,
  refs: List<SourceRef>
) -> Diagnostic {
  textual_whole_file_diagnostic(
    reason: reason,
    module_file: closure_emit_driver_locus_file(refs: refs),
    correction: Unavailable { reason: CorrectionNotModeled }
  )
}

fn closure_emit_driver_population_agrees(
  receipt: SourceRootProvenanceCoverageReceipt,
  refs: List<SourceRef>
) -> Bool {
  discovered_source_refs_digest_eq(
    left: receipt.discovered_source_refs_digest,
    right: discovered_source_refs_digest_for_refs(refs: refs)
  )
}

// The admission decision is its own total function, separate from the drive,
// for two reasons. It is the whole acceptance criterion, so it must be
// assertable without paying for an emission -- a witness that had to emit the
// compiler to check that an empty population is refused would be priced out of
// the floor and the refusal would go unexercised. And the refusal REASON is
// carried, not a Bool: a driver that answered "not admitted" would conflate
// five distinguishable causes whose remedies differ.
type ClosureEmitPopulationAdmission
  = ClosureEmitPopulationAdmitted { ingest: SourceRootIngest }
  | ClosureEmitPopulationRefused { reason: Symbol }

fn closure_emit_population_admission(
  refs: List<SourceRef>,
  receipt: SourceRootProvenanceCoverageReceipt
) -> ClosureEmitPopulationAdmission {
  if receipt.ingest_read_count == 0 {
    ClosureEmitPopulationRefused { reason: ^closure_emit_driver_empty_population }
  } else {
    if !source_root_ref_carrier_coverage_is_complete(coverage: receipt.coverage) {
      ClosureEmitPopulationRefused { reason: ^closure_emit_driver_coverage_incomplete }
    } else {
      if !source_root_closure_ref_transport_complete(receipt: receipt, refs: refs) {
        ClosureEmitPopulationRefused { reason: ^closure_emit_driver_partial_population }
      } else {
        if !closure_emit_driver_population_agrees(receipt: receipt, refs: refs) {
          ClosureEmitPopulationRefused {
            reason: ^closure_emit_driver_population_digest_mismatch
          }
        } else {
          match source_root_ingest_build_from_source_refs(refs: refs) {
            SourceRootIngestBuildReadFailed { result: _ } =>
              ClosureEmitPopulationRefused {
                reason: ^closure_emit_driver_source_read_failed
              }
            SourceRootIngestBuildOk { ingest: ingest } =>
              if length(xs: ingest) != receipt.ingest_read_count {
                ClosureEmitPopulationRefused {
                  reason: ^closure_emit_driver_ingest_row_shortfall
                }
              } else {
                ClosureEmitPopulationAdmitted { ingest: ingest }
              }
          }
        }
      }
    }
  }
}

fn drive_compiler_closure_emit(
  refs: List<SourceRef>,
  receipt: SourceRootProvenanceCoverageReceipt,
  admission: Admission,
  target: TargetModel
) -> Outcome<CompilerClosureEmitReceipt> {
  match closure_emit_population_admission(refs: refs, receipt: receipt) {
    ClosureEmitPopulationRefused { reason: reason } =>
      outcome_rejected(d: closure_emit_driver_refusal(reason: reason, refs: refs))
    ClosureEmitPopulationAdmitted { ingest: ingest } =>
      emit_compiler_import_closure_from_ingest(
        ingest: ingest,
        admission: admission,
        target: target
      )
  }
}
