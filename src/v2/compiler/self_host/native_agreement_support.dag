module v2.compiler.self_host.native_agreement_support


fn native_agreement_divergence_from_run<Subj>(
  member_id: String,
  run: v2.compiler.eval.TestClaimRun<Subj, v2.std.runtime.RuntimeValue>
) -> v2.std.optional.Optional<v2.std.native_agreement.NativeAgreementDivergence> {
  match run.verdict {
    v2.std.verdict.Pass => v2.std.optional.Absent
    v2.std.verdict.SemanticMismatch {
      actual: v2.std.diagnostic.Accepted { value: native_val, diagnostics: None },
      falsification: v2.std.optional.Present {
        value: receipt
      }
    } =>
      v2.std.optional.Present {
        value: v2.std.native_agreement.NativeAgreementDivergence {
          member_id: member_id,
          interpreted_value: v2.std.native_agreement.runtime_value_octet_label(value: receipt.expected),
          native_value: v2.std.native_agreement.runtime_value_octet_label(value: native_val)
        }
      }
    v2.std.verdict.SemanticMismatch { actual: _, falsification: v2.std.optional.Absent } =>
      v2.std.optional.Present {
        value: v2.std.native_agreement.NativeAgreementDivergence {
          member_id: member_id,
          interpreted_value: "?",
          native_value: "?"
        }
      }
    v2.std.verdict.BuildFailed { actual: _, diagnostic: _ } =>
      v2.std.optional.Present {
        value: v2.std.native_agreement.NativeAgreementDivergence {
          member_id: member_id,
          interpreted_value: "build_failed",
          native_value: "build_failed"
        }
      }
    v2.std.verdict.RunFailed { actual: _, diagnostic: _ } =>
      v2.std.optional.Present {
        value: v2.std.native_agreement.NativeAgreementDivergence {
          member_id: member_id,
          interpreted_value: "run_failed",
          native_value: "run_failed"
        }
      }
    v2.std.verdict.Deferred { actual: _, diagnostic: _ } =>
      v2.std.optional.Present {
        value: v2.std.native_agreement.NativeAgreementDivergence {
          member_id: member_id,
          interpreted_value: "deferred",
          native_value: "deferred"
        }
      }
  }
}
