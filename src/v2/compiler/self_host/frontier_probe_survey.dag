module v2.compiler.self_host.frontier_probe_survey

import std.dissolution { DissolutionCondition, unbound_dissolution }

import v2.compiler.self_host.frontier_probe {
  frontier_probe_emit_from_ingest
}
import v2.compiler.self_host.frontier_probe_types {
  EmitSurfaceGap,
  FrontierBlockerClass,
  FrontierProbeReceipt,
  FrontierSurveyManifest,
  FrontierSurveySubject,
  NameResolutionGap,
  RealizationGap,
  SelfEmitReady,
  UnknownProbeCause,
  FixtureCemented,
  UpstreamSemanticRefusal,
  frontier_blocker_class_matches,
  frontier_survey_commit_tree_binding_holds,
  frontier_survey_executable_sha256_holds,
  frontier_survey_source_roots_digest_holds,
  frontier_probe_policy_revision,
  frontier_probe_receipt_blocker_class,
  frontier_probe_receipt_located_reason,
  frontier_probe_receipt_module_path
}
import std.realization_schedule { scoped_witness_exact_head_text_holds }
import std.content_hash { ContentHash, compare_content_hash, ContentHashEqual }
import v2.compiler.name_resolve { Admission }
import v2.compiler.source_authority { SourceRootIngest }
import v2.std.algebra { Cons, Empty, fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

type FrontierGapClusterVerdict
  = CommonRoot {
      dominant_located_reason: Symbol,
      dominant_module_count: Int,
      module_count: Int
    }
  | HeterogeneousGaps {
      distinct_located_reason_count: Int,
      module_count: Int
    }

fn frontier_probe_receipt_located_reason_eq(left: Symbol, right: Symbol) -> Bool {
  left == right
}

fn count_receipts_with_located_reason(
  xs: List<FrontierProbeReceipt>,
  target: Symbol
) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      if frontier_probe_receipt_located_reason_eq(
        left: frontier_probe_receipt_located_reason(receipt: receipt),
        right: target
      ) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_receipts_with_blocker(
  xs: List<FrontierProbeReceipt>,
  target: FrontierBlockerClass
) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      if frontier_blocker_class_matches(
        blocker: frontier_probe_receipt_blocker_class(receipt: receipt),
        target: target
      ) {
        count + 1
      } else {
        count
      }
    }
  )
}

data frontier_probe_survey_has_unclassified_dispatch_note: String = "frontier_probe_survey_has_unclassified survives predicate dissolution because it is the existential UnknownProbeCause witness gate (any receipt still in the host-deferred / unclassified bucket), not a variant nickname for a single arm. The long-lane survey witness requires !has_unclassified before roster binding; dissolves when measured receipts eliminate the host UnknownProbeCause residue or the gate reads a typed survey-completeness carrier."

fn frontier_probe_receipt_is_unknown_probe_cause(receipt: FrontierProbeReceipt) -> Bool {
  match frontier_probe_receipt_blocker_class(receipt: receipt) {
    UnknownProbeCause { reason: _ } => true
    _ => false
  }
}

fn frontier_probe_receipt_is_upstream_semantic_refusal(receipt: FrontierProbeReceipt) -> Bool {
  match frontier_probe_receipt_blocker_class(receipt: receipt) {
    UpstreamSemanticRefusal { diagnostic_class: _, diagnostic_name: _ } => true
    _ => false
  }
}

fn frontier_probe_survey_has_unclassified(xs: List<FrontierProbeReceipt>) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(found, receipt) {
      found || frontier_probe_receipt_is_unknown_probe_cause(receipt: receipt)
    }
  )
}

fn frontier_probe_receipt_for_module(
  module_path: String,
  ingest: SourceRootIngest,
  admission: Admission
) -> FrontierProbeReceipt {
  frontier_probe_emit_from_ingest(
    module_path: module_path,
    ingest: ingest,
    admission: admission
  )
}

fn count_upstream_semantic_refusal_receipts(xs: List<FrontierProbeReceipt>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      if frontier_probe_receipt_is_upstream_semantic_refusal(receipt: receipt) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_unknown_probe_cause_receipts(xs: List<FrontierProbeReceipt>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      if frontier_probe_receipt_is_unknown_probe_cause(receipt: receipt) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_fixture_cemented_receipts(xs: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: xs, target: FixtureCemented)
}

data frontier_probe_receipt_totality_wall_note: String = "Receipt-totality wall (Lane E still-dove-191): every survey receipt must partition the module count across the closed FrontierBlockerClass vocabulary; survey module paths must be unique, non-empty, and match the frontier roster exactly once each way. Stale located_reason symbols on knowledge-attributed rows (e.g. gate_a_flip_probe_witness_std_dup after the 2026-07-23 extinction receipt) must be zero — the wall is what stops the next cleanup pass from reintroducing mislocated EmitSurfaceGap rows. Vocabulary + wall land before a second measurement pass rewrites the 27 roster rows.\n\nSILENT-NARROW REFUSAL (operator still-bat-561, 2026-08-04): if a closure exceeds a transport cap and the ingest manifest elides rows to Empty, the survey receipt must REFUSE with a typed counted diagnostic — never attribute a downstream stage failure (e.g. NameResolutionGap / ^resolve_module_not_found) as though the measurement succeeded. Lane 3 (#7762) fixes the MANIFEST_INLINE_LIST_MAX instance; this wall states the general property: the survey cannot silently narrow (⊥-as-ignorance conflated with ⊥-as-answer). A receipt that reports a blocker class without proving the full closure was admitted is a fabricated attribution."

data frontier_roster_measurement_status_vocabulary_note: String = "STATUS VOCABULARY (operator correction still-bat-561, 2026-08-04): do not use Closed/Open/Surveyed for frontier rows — those words misread as SelfEmitReady or EmitterProduced. Four orthogonal axes, each with its head when execution-measured:\n\nROSTER POPULATION (27): every module in compiler_frontier_sweep_order.\n\nEXECUTION MEASUREMENT: a frontier_probe_emit_from_ingest receipt at a pinned FrontierSurveySubject, recorded in host_frontier_probe_survey_manifest with matching subject identity on every row. Count without a head is unreportable. Prior dated receipt at 9f978aa8df counted 17 modules (zero self_emit_ready=yes); it is superseded, not combinable with a later head.\n\nNO EXECUTION MEASUREMENT: roster row whose measured_probe is knowledge-attributed or oracle-derived without a manifest receipt at the current pinned head — not 'open', not 'closed'.\n\nSELF_EMIT_READY (probe readiness): measured_probe.blocker_class == SelfEmitReady at the pinned head — this exact module reached and passed the self-emit readiness bar on the probe slice. Distinct from execution measurement (a measured row can still be SeedRetained) and from roster disposition. Live count: 0 at every head measured to date.\n\nEMITTER_PRODUCED (authorized roster promotion): disposition == EmitterProduced via mint_emitter_produced_frontier_promotion only — the roster disposition was atomically authorized. The direct door can hold SourceProduced, CargoGreen, and BehavioralEquivalent without any frontier row becoming EmitterProduced; that separation is why these axes exist. Live count: 0 (emitter_produced_frontier_promotions is empty).\n\nDo not round an unmeasured row to any blocker class. Do not report a count without its head."

data frontier_roster_measurement_census_at_9f978aa8df_note: String = "Dated census at source_head 9f978aa8df only (a probe TSV deleted 2026-08-16 (operator: delete anything not actively derived); probe pre-#7762 — three NameResolutionGap rows are suspect manifest-elision artifacts, not name-resolution facts). Probe invocation used --source-root src/v2 only; authoritative closeout uses src/v2 + dag (different source_roots_digest even at the same commit). At that head: execution_measurement=17, no_execution_measurement=10, self_emit_ready=0, emitter_produced=0. All 27 rows remain SeedRetained disposition. Not combinable with any later head or changed source-root set; superseded by post-#7762 27/27 rerun."

data frontier_probe_exact_head_closeout_note: String = "Lane 1 exact-current-head closeout (sleek-pike-668): LAST of four — #7776 vocabulary, #7762 final, and #7767 assemble diagnostic payloads are merged on main; authoritative 27/27 remains on operator hold (not predecessor blockers). ADMISSION CONTRACT FOR THE AUTHORITATIVE SURVEY (operator ruling, 2026-08-06). Stated as CONDITIONS ON THE TREE, deliberately naming no PR number, no head SHA, no draft state and no control tally. A receipt that names those is a second mutable copy of the board: it is wrong again every time the board moves, and it has to be patched by hand each time — which is the SAME defect class frontier_roster_provenance_constructor_inflation_note files one layer down, a claim asserted in a place that cannot check it. So this note does not commit it. THE AUTHORITATIVE SURVEY MAY START ONLY WHEN ALL FOUR HOLD: (1) whole-tree hard diagnostics equals zero; (2) ConstructorReferenceAdmission has ONE authority and NO known-red control; (3) all seven partition crates are continuously checked; (4) FrontierEvidenceProvenance is CONSTRUCTION-ENFORCED. Each is decidable against whatever head is current, so the contract stays true as heads move and changes land. For WHICH change currently carries which condition, read the board — not this receipt. Two conditions are easy to under-read and are therefore spelled out. Condition (2) is not discharged by a de-fork landing while a control remains inverted: one authority AND no known-red are both required, because a partially admitted constructor authority means a survey measures a tree in which a sealed constructor is reachable without admission. Condition (4) is what stops the survey writing all 27 roster rows through the provenance-conflating constructor; it is a construction wall to be BUILT, and this receipt does not build it — this receipt RECORDS the provenance defect, and the separate FrontierEvidenceProvenance change FIXES it.\n\nEXECUTION MODEL — 27 INDEPENDENT JOBS, NOT ONE PROCESS (operator ruling, superseding any single-process retry): one pinned survey subject; 27 independent module jobs; ONE RECEIPT ARTIFACT PER MODULE; one final exact-subject aggregator. A killed module job yields an interrupted ROW and is rerun independently — twenty-six completed rows must not be lost because the twenty-seventh receives SIGKILL. This is designed out of the failure this receipt records: the monolithic run lost everything each time it died, six times. Do NOT retry a monolithic 27-module process in the same opaque session envelope; the ancestor killer is still there and still unobservable from inside, so the response is independent jobs with a visible kill boundary, never a bigger cap. Every receipt carries the same exact subject and a killed job is RERUN, never hand-reconciled into the manifest — reconciling a job that ran against a different subject is what turns a partial survey into a fabricated one.\n\nREQUIRED OUTPUT SHAPE: frontier population 27; exact-head measured 27; SelfEmitReady N; EmitterProduced 0; blocker groups BY DETAILED CAUSE. The last is load-bearing and is not a table of high-level reason strings: the 14 modules that shared ^parse_grammar_choice_overlap_residue at 9f978aa8df must have their detailed causes separated, because the next phase picks the lowest-cost module in the largest DETAILED group on the premise that one root governs many. A high-level grouping cannot rank that. #7762 ref-population gap closed on main — do not forge subjects on today's probe. Definitive run: clean detached worktree; build receipt binding commit, tree, compiler sources, probe executable digest, source-root set, and probe-policy revision; every shard carries complete FrontierSurveySubject; all 27 subjects must compare exactly equal before aggregation. Prior interim audit at 9f978aa8df recorded execution_measurement=17, no_execution_measurement=10, self_emit_ready=0, emitter_produced=0 at that head only. Closeout completes when host_frontier_probe_survey_manifest is a well-formed FrontierSurveyManifest with 27 receipts at one subject, frontier.dag rows hand-authored from that manifest, compiler_frontier_per_module_probe_survey_holds greens, and the offline claim_batch recipe passes."

data frontier_probe_run_interruption_note: String = "EXECUTED RECEIPT OF AN INTERRUPTED RUN, rehearsal at source_head 2be88489b1303357a10b135dd90704103ea93b0e (tidy-bee-50, 2026-08-06; receipt docs/probes/frontier_probe_run_interrupted_2026-08-06.md). The authoritative 27/27 did NOT run and this note carries no frontier counts. frontier_probe_emit_from_ingest was SIGKILLed before emitting a receipt for ANY module: six invocations, six kills, zero receipts — one-shot over all 27 (killed during module 1 of 27), plus 03_normalize, 03_resolve and 01_tokenize individually at --source-root src/v2 + dag, plus 03_normalize at --source-root src/v2 alone, plus a later 01_tokenize retry under low host load that survived to 3.5 minutes at about 2.0 GB before being killed anyway. Host cgroup memory.max = 33578549248 (31.3 GiB). Every death is located identically: immediately after the per-module probe begins, inside the interpreted evaluation, with the ingest closure already read to completion — so it is not an ingest or discovery failure.\n\nINSTRUMENT CONTROL, AND THE MISATTRIBUTION IT CAUGHT. cgroup memory.events oom_kill incremented 1 through 5, one per killed run, in exact lockstep — which establishes these were real kernel kills of processes in this cgroup, and establishes NOTHING about what killed them. The full counter set: memory.max 33578549248 (31.3 GiB), memory.peak 9136902144 (8.5 GiB), memory.events max 0 / oom 0 / oom_kill 8. max 0 means allocation NEVER reached memory.max; oom 0 means the CGROUP oom killer was never invoked; and in cgroup v2 oom_kill also counts tasks reaped by the GLOBAL killer. The cgroup never exceeded 27 percent of its cap at any point. THEREFORE these kills came from host-level pressure on a shared machine, not from this cgroup limit and not from the probe working set — the probe was killed at or below 8.5 GiB cgroup-wide, which is not a runaway signature.\n\nTWO CLAIMS WITHDRAWN AS REFUTED, both asserted by an earlier revision of this note: (1) that the probe requires more than 31 GiB — refuted by memory.peak 8.5 GiB; (2) that this host cannot cold-build v1-compiler — refuted by an independent same-fleet control under a byte-identical memory.max of 33578549248, which cold-built the crate (sccache cache hits 0, 1 compilation, 163s rustc) in 2m59s at a 3.26 GiB peak with oom_kill 0. The crate needs about 3.3 GiB, not 31. The oom_kill counter is a sound control for 'was this a kill' and a worthless one for 'what hit the limit'; memory.events max/oom and memory.peak answer the second and were available throughout.\n\nTWO HYPOTHESES REFUTED BY EXECUTION, both plausible, neither reported as a cause. (a) 'the 10 never-measured modules are the memory-bound ones' — refused by 01_tokenize, which is one of the 17 that DID measure at 9f978aa8df and OOMs now. (b) 'the widened src/v2 + dag root set is the cause' — refused by 03_normalize OOMing at src/v2 alone. Cause is neither module identity nor root set, and remains OPEN.\n\nREGRESSION-VS-CAPACITY UNRESOLVED, CAUSE IS CONTENTION NOT CAPACITY: the discriminating run (build the probe at 9f978aa8df, where 17 modules measured cleanly, and probe here) did not complete — three builds at that head were killed under sccache (Compiler killed by signal 9): release at CARGO_BUILD_JOBS=15 (oom_kill 6), release at CARGO_BUILD_JOBS=1 (oom_kill 7), debug profile (oom_kill 9 incl. a later gunbc compile). Those three are VICTIMS, NOT DIAGNOSES: none reached this cgroup limit, and the same-cap control above cold-builds the crate at 3.26 GiB, so they died to host pressure they did not cause and say nothing about the crate. The tempting inference — one rustc died, therefore one rustc needs the whole cap — is invalid, because a process reaped by an EXTERNAL oom killer reports the machine at that moment, not itself. The condition is retryable rather than blocking; per operator direction it is reported, not chased, and the probe is not trimmed to fit. Preserve the distinction when assessing: 15 parallel rustc processes collectively reaching the cap is ordinary; ONE probe process reaching it for ONE module is not, and only the second is evidence about the probe.\n\nCANDIDATE, NOT A DIAGNOSIS: #7762 closed the manifest-elision silent-narrow, so the probe now admits the full closure where it previously elided rows. Closing a narrowing that implicitly bounded memory would produce this shape (DESIGN precedent: removing the scan-all-keys fail-open exposed 8 deficits its silence had hidden). Untested; to be assessed by that change's owner, not diagnosed from outside.\n\nCONSEQUENCE, STATED AT THE SCOPE THE EVIDENCE SUPPORTS: 27/27 DID NOT COMPLETE in this window on either documented path — the one-shot or the per-module fallback docs/probes/run_frontier_probe_survey_per_module.sh — but 'unreachable' is NOT established and an earlier revision of this note wrongly said so. Since no run reached the cgroup limit, nothing here shows the probe cannot fit; the runs were interrupted by external pressure. Retry under low host load before concluding anything about probe cost, and treat any per-module cost claim as unmeasured until a run completes or a kill is attributable to this cgroup. Operator direction: the probe must NOT be trimmed to fit the host; a probe shrunk to fit a box measures a different question. Dissolve-on, BOTH conditions: the probe emits a receipt for at least one module at a pinned FrontierSurveySubject AND roster row provenance becomes structural — then this note and its receipt delete together. Both are required because the bound receipt also carries frontier_roster_provenance_constructor_inflation_note as an additional work, so the emit condition alone would delete a finding that is still live; this matches the dissolution on the HandAuthoredDocBind for slug frontier_probe_run_interrupted_2026-08-06 in gunbc.doc_graph_roots, which is the single authority for when that doc deletes."

data frontier_roster_provenance_constructor_inflation_note: String = "RUNG INFLATION in the roster carrier itself (DESIGN 4b), found 2026-08-06 (tidy-bee-50), independent of the run interruption above and not caused by it. v2.compiler.self_host.frontier declares knowledge_attributed_blocker_class_seed_retained_row — the constructor whose name honestly marks a row knowledge-attributed rather than measured — and it has ZERO call sites: repo-wide the only occurrence of that symbol is its own definition. Meanwhile all 10 roster modules never execution-measured at any head are authored through execution_measured_seed_retained_row, whose name asserts execution measurement: 8 directly, and 03_normalize plus 03_body_producer via quarantine_seed_retained_row_from_oracle, which itself delegates to it. The 10, derived by joining compiler_frontier_sweep_order against the interim TSV module column: 03_body_producer, 03_name_resolve, 03_normalize, 03_resolve, 05_emit_orchestration, emit_host, emit_module, emit_produced, emit_semantic_decl, program_assembly.\n\nMECHANISM MATTERS MORE THAN THE COUNT: execution_measured_seed_retained_row takes measured_blocker, located_stage and located_reason as ordinary parameters, so it CANNOT distinguish a measured row from an attributed one — the constructor NAME asserts a provenance the TYPE does not carry, and no care at the call site can make that claim checkable. This is why a carrier reading 'execution_measured' is not evidence of measurement, and why a status report derived from constructor names overstates the frontier. The DESIGN 5 construction fix is a provenance carrier making an attributed row unrepresentable as measured; the honest-constructor-plus-discipline approach has already been tried here and produced zero adoption in the live roster.\n\nNAMED SUCCESSOR (operator-authored, 2026-08-06) — FrontierEvidenceProvenance = ExecutionMeasured { subject: FrontierSurveySubject, receipt: FrontierProbeReceipt } | KnowledgeAttributed { source: DeclarationRef, dissolution: unbound_dissolution(description: DeclarationRef)} | OracleDerived { oracle: DeclarationRef }. The load-bearing detail is that ExecutionMeasured requires a TYPED SUBJECT AND A TYPED RECEIPT rather than free-form fields, and the row constructor must CONSUME the variant — so a row cannot claim execution-measured provenance without carrying the receipt that proves it. Operator words: a constructor named execution_measured_* that accepts ordinary caller-provided blocker fields is a name-level claim, not evidence. That is exactly the defect above, made unwritable rather than merely documented, and it lands BEFORE the authoritative survey so the survey cannot rewrite the 27 rows through the conflating constructor.\n\nNO roster row is edited by this note — frontier.dag is load-bearing and the successor is a model change, flagged for routing rather than landed here. Dissolve-on: FrontierEvidenceProvenance lands, row provenance becomes structural, and the unused knowledge-attributed constructor deletes with the transition."

fn frontier_survey_probe_policy_revision_holds(revision: ContentHash) -> Bool {
  match compare_content_hash(left: revision, right: frontier_probe_policy_revision()) {
    ContentHashEqual => true
    _ => false
  }
}

fn frontier_survey_subject_well_formed_holds(subject: FrontierSurveySubject) -> Bool {
  scoped_witness_exact_head_text_holds(head: subject.source_commit)
    && frontier_survey_executable_sha256_holds(digest: subject.survey_executable)
    && frontier_survey_source_roots_digest_holds(digest: subject.source_roots_digest)
    && frontier_survey_probe_policy_revision_holds(revision: subject.probe_policy_revision)
    && frontier_survey_commit_tree_binding_holds(commit: subject.source_commit, tree: subject.source_tree)
}

fn frontier_survey_manifest_receipts_nonempty_holds(manifest: FrontierSurveyManifest) -> Bool {
  length(xs: manifest.receipts) > 0
}

fn frontier_survey_manifest_well_formed_holds(manifest: FrontierSurveyManifest) -> Bool {
  frontier_survey_subject_well_formed_holds(subject: manifest.subject)
    && frontier_survey_manifest_receipts_nonempty_holds(manifest: manifest)
}

fn frontier_survey_manifest_blocker_partition_totality_holds(manifest: FrontierSurveyManifest) -> Bool {
  frontier_survey_manifest_well_formed_holds(manifest: manifest)
    && frontier_probe_survey_blocker_partition_totality_holds(
      receipts: manifest.receipts,
      module_count: length(xs: manifest.receipts)
    )
}

fn frontier_survey_manifest_roster_bidirectional_totality_holds(
  manifest: FrontierSurveyManifest,
  roster_paths: List<String>,
  roster_count: Int
) -> Bool {
  frontier_survey_manifest_well_formed_holds(manifest: manifest)
    && frontier_probe_survey_roster_bidirectional_totality_holds(
      survey: manifest.receipts,
      roster_paths: roster_paths,
      roster_count: roster_count
    )
}

fn frontier_probe_survey_blocker_partition_totality_holds(
  receipts: List<FrontierProbeReceipt>,
  module_count: Int
) -> Bool {
  let ready = count_receipts_with_blocker(xs: receipts, target: SelfEmitReady)
  let upstream = count_upstream_semantic_refusal_receipts(xs: receipts)
  let emit = count_receipts_with_blocker(xs: receipts, target: EmitSurfaceGap)
  let name = count_receipts_with_blocker(xs: receipts, target: NameResolutionGap)
  let real = count_receipts_with_blocker(xs: receipts, target: RealizationGap)
  let fixture = count_fixture_cemented_receipts(xs: receipts)
  let unknown = count_unknown_probe_cause_receipts(xs: receipts)
  (ready + upstream + emit + name + real + fixture + unknown) == module_count
}

fn frontier_probe_survey_module_paths_unique_holds(xs: List<FrontierProbeReceipt>) -> Bool {
  fold_list(
    xs: xs,
    empty: true,
    cons: fn(ok, receipt) {
      ok
        && (frontier_probe_receipt_module_path(receipt: receipt) != "")
        && (count_receipts_with_module_path(
          xs: xs,
          target: frontier_probe_receipt_module_path(receipt: receipt)
        ) == 1)
    }
  )
}

fn count_receipts_with_module_path(
  xs: List<FrontierProbeReceipt>,
  target: String
) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      if frontier_probe_receipt_module_path(receipt: receipt) == target {
        count + 1
      } else {
        count
      }
    }
  )
}

fn frontier_probe_survey_roster_bidirectional_totality_holds(
  survey: List<FrontierProbeReceipt>,
  roster_paths: List<String>,
  roster_count: Int
) -> Bool {
  (length(xs: survey) == roster_count)
    && frontier_probe_survey_module_paths_unique_holds(xs: survey)
    && frontier_probe_survey_receipt_paths_match(xs: survey)
    && frontier_probe_survey_every_roster_path_has_receipt_holds(
      survey: survey,
      roster_paths: roster_paths
    )
    && frontier_probe_survey_every_receipt_in_roster_holds(
      survey: survey,
      roster_paths: roster_paths
    )
}

fn frontier_probe_survey_every_roster_path_has_receipt_holds(
  survey: List<FrontierProbeReceipt>,
  roster_paths: List<String>
) -> Bool {
  fold_list(
    xs: roster_paths,
    empty: true,
    cons: fn(ok, path) {
      ok && (count_receipts_with_module_path(xs: survey, target: path) == 1)
    }
  )
}

fn frontier_probe_survey_every_receipt_in_roster_holds(
  survey: List<FrontierProbeReceipt>,
  roster_paths: List<String>
) -> Bool {
  fold_list(
    xs: survey,
    empty: true,
    cons: fn(ok, receipt) {
      ok && roster_contains_module_path(
        paths: roster_paths,
        target: frontier_probe_receipt_module_path(receipt: receipt)
      )
    }
  )
}

fn roster_contains_module_path(paths: List<String>, target: String) -> Bool {
  fold_list(
    xs: paths,
    empty: false,
    cons: fn(found, path) {
      found || (path == target)
    }
  )
}

fn frontier_probe_survey_receipt_paths_match(
  xs: List<FrontierProbeReceipt>
) -> Bool {
  fold_list(
    xs: xs,
    empty: true,
    cons: fn(ok, receipt) {
      ok && (frontier_probe_receipt_module_path(receipt: receipt) != "")
    }
  )
}

data frontier_gap_clustering_derivation_note: String = "The dominant reason is READ OFF the receipts, never supplied by the branch that fired. Before this, clustering counted blocker CLASSES and then wrote a hardcoded located_reason literal per branch (^parse_grammar_choice_overlap_residue for the realization branch, and so on), so a verdict reported a reason no receipt had to carry: two modules whose measured refusals differ were indistinguishable, and the one measured survey to date carries ^tokenize_lex_e1_unrecognized_char, which no branch could ever name. count_receipts_with_located_reason existed with zero callers throughout. CommonRoot now requires UNANIMITY rather than a plurality: any plurality bar is a threshold, and a threshold is the smuggled heuristic a closed system never needs — a survey where one reason covers every receipt has a common root, and one where it does not is heterogeneous with its true distinct count. An empty survey has no measured reason, so it cannot be a CommonRoot; it reports a distinct count of zero, which says exactly that. Cost: distinct reasons are collected in one pass and counted once each, so the fold is d*n over the distinct set rather than n*n over the receipts. The tally runs only on the unanimous arm, where its result is consumed; the heterogeneous arm needs the distinct count alone and computing a tally it discards would be a cost-shape defect regardless of how small the survey is (review 51421)."

type FrontierReasonTally = ReasonTally { reason: Symbol, count: Int }

fn symbol_list_contains(xs: List<Symbol>, target: Symbol) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(found, s) { found || (s == target) }
  )
}

fn distinct_located_reasons(xs: List<FrontierProbeReceipt>) -> List<Symbol> {
  fold_list(
    xs: xs,
    empty: Empty,
    cons: fn(seen, receipt) {
      let reason = frontier_probe_receipt_located_reason(receipt: receipt)
      if symbol_list_contains(xs: seen, target: reason) {
        seen
      } else {
        Cons { head: reason, tail: seen }
      }
    }
  )
}

fn dominant_located_reason_tally(xs: List<FrontierProbeReceipt>) -> FrontierReasonTally {
  fold_list(
    xs: distinct_located_reasons(xs: xs),
    empty: ReasonTally { reason: ^frontier_survey_no_measured_reason, count: 0 },
    cons: fn(best, reason) {
      let c = count_receipts_with_located_reason(xs: xs, target: reason)
      if c > best.count {
        ReasonTally { reason: reason, count: c }
      } else {
        best
      }
    }
  )
}

fn common_root_from_tally(top: FrontierReasonTally, module_count: Int) -> FrontierGapClusterVerdict {
  CommonRoot {
    dominant_located_reason: top.reason,
    dominant_module_count: top.count,
    module_count: module_count
  }
}

fn frontier_gap_clustering_from_receipts(
  xs: List<FrontierProbeReceipt>,
  module_count: Int
) -> FrontierGapClusterVerdict {
  let distinct_count = length(xs: distinct_located_reasons(xs: xs))
  if distinct_count == 1 {
    common_root_from_tally(
      top: dominant_located_reason_tally(xs: xs),
      module_count: module_count
    )
  } else {
    HeterogeneousGaps {
      distinct_located_reason_count: distinct_count,
      module_count: module_count
    }
  }
}

fn frontier_wave2_realization_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: receipts, target: RealizationGap)
}

fn frontier_wave2_emit_surface_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: receipts, target: EmitSurfaceGap)
}

fn frontier_wave2_name_resolution_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: receipts, target: NameResolutionGap)
}

fn frontier_wave2_upstream_semantic_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_upstream_semantic_refusal_receipts(xs: receipts)
}

fn frontier_wave2_self_emit_ready_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: receipts, target: SelfEmitReady)
}

data frontier_probe_survey_dissolution_note: String = "Per-module receipts bind via host_frontier_probe_survey manifest generated by frontier_probe_survey bin; roster rows migrate from knowledge_attributed to execution_measured_seed_retained_row_from_probe_receipt when survey witness compiler_frontier_per_module_probe_survey_holds is green."

data frontier_probe_survey_blocker_variant_emit_rust_gate_note: String = "HAND-RUST GATE receipt (review 46941 / v1.00_core compiler_diagnostic_seed_projection_note class): Lane E adds `UpstreamSemanticRefusal` to `FrontierBlockerClass`, which forces one new arm in `frontier_probe_survey.rs` `blocker_variant_emit` (+12 LOC mechanical coproduct exhaustiveness for manifest serialization). This arm deletes when the bin deletes on `^migrate_when_frontier_per_module_probe_receipt_binds`; no separate dissolution schedule."

data frontier_probe_survey_transport_scaffold_note: String = "SCAFFOLD (§7 seed-retained HAND-RUST, P5 gate): `frontier_probe_survey` seed bin is the host-effect loop that runs `frontier_probe_emit_from_ingest` per `compiler_frontier_sweep_order` entry (single authority on `frontier.dag`, not a parallel Rust roster). CHECKABLE RECEIPT — census before=27 knowledge-attributed roster rows (`compiler_frontier_roster_count` on `frontier.dag`); census after shrink=0 hand-Rust LOC when all 27 rows bind execution-measured `FrontierProbeReceipt` via `host_frontier_probe_survey_manifest` (witness `compiler_frontier_per_module_probe_survey_holds` on `v2.test.long.compiler_frontier_per_module_probe`). Bin footprint: origin/main@821 LOC → 1088 LOC on this PR (+267 LOC: `assemble_detail_emit` / `assemble_rejection_cause_emit`, `overlap_roster_detail_from_assemble_detail`, `rejection_chain_from_assemble_detail`, `non_empty_grammar_rows_emit` / `grammar_choice_ambiguity_row_emit`, dual `detail` + `assemble_detail` manifest emission and TSV columns — measured `wc -l` on `src/v1/stage0/src/bin/frontier_probe_survey.rs` at merge-base vs HEAD). Prior main history was 546→821 (+275) before this Lane 2 increment. The +12 `UpstreamSemanticRefusal` serialize arm is an earlier Lane E slice already on main (see `frontier_probe_survey_blocker_variant_emit_rust_gate_note`). CONCRETE DEFERRAL ROW — `gunbc.plans.wave2_prep_design` §2.3 census ratchet discipline + `gunbc.plans.v2_self_hosting` LANDED mechanism (#6464); dissolution trigger `^migrate_when_frontier_per_module_probe_receipt_binds` on `compiler_frontier_blocker_class_distribution_attribution`. Then delete this bin and fold transport into floor-enrolled `v2.workflow.frontier_probe_survey_transport` or a self-emitted survey kernel."

data frontier_probe_survey_dissolve_on: DissolutionCondition = unbound_dissolution(description: "every roster row migrates from knowledge_attributed to execution_measured_seed_retained_row_from_probe_receipt, i.e. the survey witness executes for each module and the host_frontier_probe_survey manifest binds every per-module receipt")
