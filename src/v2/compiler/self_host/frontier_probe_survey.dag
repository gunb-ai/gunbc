module v2.compiler.self_host.frontier_probe_survey

import v2.compiler.self_host.frontier_probe {
  frontier_probe_emit_from_ingest
}
import v2.compiler.self_host.frontier_probe_types {
  EmitSurfaceGap,
  FrontierBlockerClass,
  FrontierProbeReceipt,
  NameResolutionGap,
  RealizationGap,
  SelfEmitReady,
  UnknownProbeCause,
  FixtureCemented,
  UpstreamSemanticRefusal,
  frontier_blocker_class_matches
}
import v2.compiler.name_resolve { Admission }
import v2.compiler.source_authority { SourceRootIngest }
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.text { String }

type FrontierGapClusterVerdict
  = CommonRoot {
      dominant_located_reason: Symbol,
      dominant_module_count: Int,
      module_count: Int
    }
  | HeterogeneousGaps {
      distinct_located_reason_count: Int,
      module_count: Int
    }

fn frontier_probe_receipt_located_reason_eq(left: Symbol, right: Symbol) -> Bool {
  left == right
}

fn count_receipts_with_located_reason(
  xs: List<FrontierProbeReceipt>,
  target: Symbol
) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      if frontier_probe_receipt_located_reason_eq(left: receipt.located_reason, right: target) {
        count + 1
      } else {
        count
      }
    }
  )
}

fn count_receipts_with_blocker(
  xs: List<FrontierProbeReceipt>,
  target: FrontierBlockerClass
) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      if frontier_blocker_class_matches(blocker: receipt.blocker_class, target: target) {
        count + 1
      } else {
        count
      }
    }
  )
}

data frontier_probe_survey_has_unclassified_dispatch_note: String = "frontier_probe_survey_has_unclassified survives predicate dissolution because it is the existential UnknownProbeCause witness gate (any receipt still in the host-deferred / unclassified bucket), not a variant nickname for a single arm. The long-lane survey witness requires !has_unclassified before roster binding; dissolves when measured receipts eliminate the host UnknownProbeCause residue or the gate reads a typed survey-completeness carrier."

fn frontier_probe_survey_has_unclassified(xs: List<FrontierProbeReceipt>) -> Bool {
  fold_list(
    xs: xs,
    empty: false,
    cons: fn(found, receipt) {
      found || match receipt.blocker_class {
        UnknownProbeCause { reason: _ } => true
        FixtureCemented => false
        SelfEmitReady => false
        NameResolutionGap => false
        EmitSurfaceGap => false
        RealizationGap => false
        UpstreamSemanticRefusal { diagnostic_class: _, diagnostic_name: _ } => false
      }
    }
  )
}

fn frontier_probe_receipt_for_module(
  module_path: String,
  ingest: SourceRootIngest,
  admission: Admission
) -> FrontierProbeReceipt {
  frontier_probe_emit_from_ingest(
    module_path: module_path,
    ingest: ingest,
    admission: admission
  )
}

fn count_upstream_semantic_refusal_receipts(xs: List<FrontierProbeReceipt>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      match receipt.blocker_class {
        UpstreamSemanticRefusal { diagnostic_class: _, diagnostic_name: _ } => count + 1
        _ => count
      }
    }
  )
}

fn count_unknown_probe_cause_receipts(xs: List<FrontierProbeReceipt>) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      match receipt.blocker_class {
        UnknownProbeCause { reason: _ } => count + 1
        _ => count
      }
    }
  )
}

fn count_fixture_cemented_receipts(xs: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: xs, target: FixtureCemented)
}

data frontier_probe_receipt_totality_wall_note: String = "Receipt-totality wall (Lane E still-dove-191): every survey receipt must partition the module count across the closed FrontierBlockerClass vocabulary; survey module paths must be unique, non-empty, and match the frontier roster exactly once each way. Stale located_reason symbols on knowledge-attributed rows (e.g. gate_a_flip_probe_witness_std_dup after the 2026-07-23 extinction receipt) must be zero — the wall is what stops the next cleanup pass from reintroducing mislocated EmitSurfaceGap rows. Vocabulary + wall land before a second measurement pass rewrites the 27 roster rows."

data frontier_roster_measurement_status_vocabulary_note: String = "STATUS VOCABULARY (operator correction still-bat-561, 2026-08-04): do not use Closed/Open/Surveyed for frontier rows — those words misread as SelfEmitReady or EmitterProduced. Four orthogonal axes, each with its head when execution-measured:\n\nROSTER POPULATION (27): every module in compiler_frontier_sweep_order.\n\nEXECUTION MEASUREMENT: a frontier_probe_emit_from_ingest receipt at a pinned source head, recorded in host_frontier_probe_survey_manifest with matching subject identity on every row. Count without a head is unreportable. Prior dated receipt at 9f978aa8df counted 17 modules (zero self_emit_ready=yes); it is superseded, not combinable with a later head.\n\nNO EXECUTION MEASUREMENT: roster row whose measured_probe is knowledge-attributed or oracle-derived without a manifest receipt at the current pinned head — not 'open', not 'closed'.\n\nSELF_EMIT_READY (probe readiness): measured_probe.blocker_class == SelfEmitReady at the pinned head — this exact module reached and passed the self-emit readiness bar on the probe slice. Distinct from execution measurement (a measured row can still be SeedRetained) and from roster disposition. Live count: 0 at every head measured to date.\n\nEMITTER_PRODUCED (authorized roster promotion): disposition == EmitterProduced via mint_emitter_produced_frontier_promotion only — the roster disposition was atomically authorized. The direct door can hold SourceProduced, CargoGreen, and BehavioralEquivalent without any frontier row becoming EmitterProduced; that separation is why these axes exist. Live count: 0 (emitter_produced_frontier_promotions is empty).\n\nDo not round an unmeasured row to any blocker class. Do not report a count without its head."

data frontier_roster_measurement_census_at_9f978aa8df_note: String = "Dated census at source_head 9f978aa8df only (docs/probes/frontier_probe_exact_head_survey_2026-08-03.tsv). At that head: execution_measurement=17, no_execution_measurement=10, self_emit_ready=0, emitter_produced=0. All 27 rows remain SeedRetained disposition. Not combinable with any later head."

data frontier_probe_exact_head_closeout_note: String = "Lane 1 exact-current-head closeout (sleek-pike-668): supersedes interim audit note after #7697 merged. CLOSEOUT NOT COMPLETE — prior interim audit at 9f978aa8df recorded execution_measurement=17, no_execution_measurement=10, self_emit_ready=0, emitter_produced=0 at that head only (docs/probes/frontier_probe_exact_head_survey_2026-08-03.tsv); not combinable with a later head. host_frontier_probe_survey_manifest remains stub (module_count=0); totality wall and compiler_frontier_per_module_probe_survey_holds are not green until all 27 have execution_measurement at one pinned head, rows hand-authored, and offline claim_batch recipe passes. Remaining 10 no_execution_measurement: 03_normalize, 03_resolve, 03_name_resolve, emit_module, 05_emit_orchestration, emit_semantic_decl, emit_host, emit_produced, 03_body_producer, program_assembly."

fn frontier_probe_survey_blocker_partition_totality_holds(
  receipts: List<FrontierProbeReceipt>,
  module_count: Int
) -> Bool {
  let ready = count_receipts_with_blocker(xs: receipts, target: SelfEmitReady)
  let upstream = count_upstream_semantic_refusal_receipts(xs: receipts)
  let emit = count_receipts_with_blocker(xs: receipts, target: EmitSurfaceGap)
  let name = count_receipts_with_blocker(xs: receipts, target: NameResolutionGap)
  let real = count_receipts_with_blocker(xs: receipts, target: RealizationGap)
  let fixture = count_fixture_cemented_receipts(xs: receipts)
  let unknown = count_unknown_probe_cause_receipts(xs: receipts)
  (ready + upstream + emit + name + real + fixture + unknown) == module_count
}

fn frontier_probe_survey_module_paths_unique_holds(xs: List<FrontierProbeReceipt>) -> Bool {
  fold_list(
    xs: xs,
    empty: true,
    cons: fn(ok, receipt) {
      ok
        && (receipt.module_path != "")
        && (count_receipts_with_module_path(xs: xs, target: receipt.module_path) == 1)
    }
  )
}

fn count_receipts_with_module_path(
  xs: List<FrontierProbeReceipt>,
  target: String
) -> Int {
  fold_list(
    xs: xs,
    empty: 0,
    cons: fn(count, receipt) {
      if receipt.module_path == target {
        count + 1
      } else {
        count
      }
    }
  )
}

fn frontier_probe_survey_roster_bidirectional_totality_holds(
  survey: List<FrontierProbeReceipt>,
  roster_paths: List<String>,
  roster_count: Int
) -> Bool {
  (length(xs: survey) == roster_count)
    && frontier_probe_survey_module_paths_unique_holds(xs: survey)
    && frontier_probe_survey_receipt_paths_match(xs: survey)
    && frontier_probe_survey_every_roster_path_has_receipt_holds(
      survey: survey,
      roster_paths: roster_paths
    )
    && frontier_probe_survey_every_receipt_in_roster_holds(
      survey: survey,
      roster_paths: roster_paths
    )
}

fn frontier_probe_survey_every_roster_path_has_receipt_holds(
  survey: List<FrontierProbeReceipt>,
  roster_paths: List<String>
) -> Bool {
  fold_list(
    xs: roster_paths,
    empty: true,
    cons: fn(ok, path) {
      ok && (count_receipts_with_module_path(xs: survey, target: path) == 1)
    }
  )
}

fn frontier_probe_survey_every_receipt_in_roster_holds(
  survey: List<FrontierProbeReceipt>,
  roster_paths: List<String>
) -> Bool {
  fold_list(
    xs: survey,
    empty: true,
    cons: fn(ok, receipt) {
      ok && roster_contains_module_path(paths: roster_paths, target: receipt.module_path)
    }
  )
}

fn roster_contains_module_path(paths: List<String>, target: String) -> Bool {
  fold_list(
    xs: paths,
    empty: false,
    cons: fn(found, path) {
      found || (path == target)
    }
  )
}

fn frontier_probe_survey_receipt_paths_match(
  xs: List<FrontierProbeReceipt>
) -> Bool {
  fold_list(
    xs: xs,
    empty: true,
    cons: fn(ok, receipt) {
      ok && (receipt.module_path != "")
    }
  )
}

fn frontier_gap_clustering_from_receipts(
  xs: List<FrontierProbeReceipt>,
  module_count: Int
) -> FrontierGapClusterVerdict {
  let emit_surface_count = count_receipts_with_blocker(xs: xs, target: EmitSurfaceGap)
  let name_resolution_count = count_receipts_with_blocker(xs: xs, target: NameResolutionGap)
  let realization_count = count_receipts_with_blocker(xs: xs, target: RealizationGap)
  let self_emit_ready_count = count_receipts_with_blocker(xs: xs, target: SelfEmitReady)
  if self_emit_ready_count == module_count {
    CommonRoot {
      dominant_located_reason: ^probe_stage_emit_ok,
      dominant_module_count: module_count,
      module_count: module_count
    }
  } else if realization_count >= emit_surface_count
    && realization_count >= name_resolution_count
    && realization_count > 0
  {
    CommonRoot {
      dominant_located_reason: ^parse_grammar_choice_overlap_residue,
      dominant_module_count: realization_count,
      module_count: module_count
    }
  } else if emit_surface_count >= name_resolution_count && emit_surface_count > 0 {
    CommonRoot {
      dominant_located_reason: ^measured_probe_emit_surface_gap,
      dominant_module_count: emit_surface_count,
      module_count: module_count
    }
  } else if name_resolution_count > emit_surface_count {
    CommonRoot {
      dominant_located_reason: ^measured_probe_name_resolution_gap,
      dominant_module_count: name_resolution_count,
      module_count: module_count
    }
  } else {
    HeterogeneousGaps {
      distinct_located_reason_count: module_count,
      module_count: module_count
    }
  }
}

fn frontier_wave2_realization_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: receipts, target: RealizationGap)
}

fn frontier_wave2_emit_surface_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: receipts, target: EmitSurfaceGap)
}

fn frontier_wave2_name_resolution_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: receipts, target: NameResolutionGap)
}

fn frontier_wave2_upstream_semantic_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_upstream_semantic_refusal_receipts(xs: receipts)
}

fn frontier_wave2_self_emit_ready_module_count(receipts: List<FrontierProbeReceipt>) -> Int {
  count_receipts_with_blocker(xs: receipts, target: SelfEmitReady)
}

data frontier_probe_survey_dissolution_note: String = "Per-module receipts bind via host_frontier_probe_survey manifest generated by frontier_probe_survey bin; roster rows migrate from knowledge_attributed to execution_measured_seed_retained_row_from_probe_receipt when survey witness compiler_frontier_per_module_probe_survey_holds is green."

data frontier_probe_survey_blocker_variant_emit_rust_gate_note: String = "HAND-RUST GATE receipt (review 46941 / v1.00_core compiler_diagnostic_seed_projection_note class): Lane E adds `UpstreamSemanticRefusal` to `FrontierBlockerClass`, which forces one new arm in `frontier_probe_survey.rs` `blocker_variant_emit` (+12 LOC mechanical coproduct exhaustiveness for manifest serialization). This arm deletes when the bin deletes on `^migrate_when_frontier_per_module_probe_receipt_binds`; no separate dissolution schedule."

data frontier_probe_survey_transport_scaffold_note: String = "SCAFFOLD (§7 seed-retained HAND-RUST, P5 gate): `frontier_probe_survey` seed bin is the host-effect loop that runs `frontier_probe_emit_from_ingest` per `compiler_frontier_sweep_order` entry (single authority on `frontier.dag`, not a parallel Rust roster). CHECKABLE RECEIPT — census before=27 knowledge-attributed roster rows (`compiler_frontier_roster_count` on `frontier.dag`); census after shrink=0 hand-Rust LOC when all 27 rows bind execution-measured `FrontierProbeReceipt` via `host_frontier_probe_survey_manifest` (witness `compiler_frontier_per_module_probe_survey_holds` on `v2.test.long.compiler_frontier_per_module_probe`). Bin footprint: main@546 LOC baseline → 821 LOC on this PR (+275 LOC: overlay manifest generation `write_probe_overlay_manifest`, `FrontierProbeDetail` serialization `detail_variant_emit`, per-module probe orchestration `run_probe_for_module` / `write_probe_overlay_manifest` path — measured `wc -l` on `src/v1/stage0/src/bin/frontier_probe_survey.rs` at merge-base vs HEAD). The +12 `UpstreamSemanticRefusal` serialize arm is one slice of that delta (see `frontier_probe_survey_blocker_variant_emit_rust_gate_note`). CONCRETE DEFERRAL ROW — `gunbc.plans.wave2_prep_design` §2.3 census ratchet discipline + `gunbc.plans.v2_self_hosting` LANDED mechanism (#6464); dissolution trigger `^migrate_when_frontier_per_module_probe_receipt_binds` on `compiler_frontier_blocker_class_distribution_attribution`. Then delete this bin and fold transport into floor-enrolled `v2.workflow.frontier_probe_survey_transport` or a self-emitted survey kernel."
