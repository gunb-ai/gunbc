module v2.compiler.self_host.direct_rust_door_fixture


data direct_rust_door_fixture_note: String = "Self-host fixture for v2-emitter-direct-rust-door: rust add inferred tree lives in compiler self_host (not v2.test) so closing-contract admission can execute without layer inversion."

data direct_rust_door_module_path: String = "src/v2/compiler/self_host/direct_rust_door_fixture.dag"

data direct_rust_door_expected_source: String = rust_source_text

data direct_rust_door_dag_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

data direct_rust_door_ingest_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^direct_rust_door_ingest_artifact,
  file_path: "src/v2/compiler/self_host/direct_rust_door_ingest_fixture.dag"
}

data direct_rust_door_ingest_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium { carried: direct_rust_door_dag_module_source, fidelity: Lossless },
  artifact: direct_rust_door_ingest_artifact,
  compilation_unit: ^direct_rust_door_add_probe_cu,
  source_root: V2Tree
}

fn direct_rust_door_ingest() -> SourceRootIngest {
  Cons { head: direct_rust_door_ingest_read, tail: Empty }
}

fn direct_rust_door_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: Cons { head: ^add_probe, tail: Empty }
    },
    imports: Empty
  }
}

fn direct_rust_door_i32_facts_node() -> Node {
  rust_integer_facts_node(facts: rust_facts_i32)
}

fn direct_rust_door_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn direct_rust_door_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == rust_fixture_emitted_add_fn {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_fixture_i32_inhabitant {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_inhabitant_i32) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_fixture_i32_inhabitant
      )
    }
  } else if node == direct_rust_door_i32_facts_node() {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_surface_spelling_i32) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_std_projection_int32) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_int_kind_node(kind: Signed) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_int_width_node(width: Bits32) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_i32_overflow_disposition_node() {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_i32_scalar_node() {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_scalar_int) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_signed) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_bits32) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_overflow_node(overflow: PanicOnOverflow) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_overflow_node(overflow: TwoComplementWrap) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_panic_on_overflow) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_overflow_node(overflow: PanicOnOverflow)
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_two_complement_wrap) {
    Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_overflow_node(overflow: TwoComplementWrap)
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^direct_rust_door_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn direct_rust_door_inferred_facts_for(node: Node) -> Optional<InferredFacts> {
  match direct_rust_door_canonical_grounding_for(node: node) {
    Violates { diagnostic: _ } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: _ } => optional_absent()
        Holds { value: proof } =>
          optional_present(
            value: InferredFacts {
              grounding: DerivedGrounding { grounding: grounding },
              descent: Holds { value: proof }
            }
          )
      }
  }
}

fn direct_rust_door_facts_lookup(key: Node) -> Optional<InferredFacts> {
  direct_rust_door_inferred_facts_for(node: key)
}

data direct_rust_door_inferred_tree: InferredTree = InferredTree {
  root: rust_fixture_emitted_add_fn,
  facts: Map {
    lookup: direct_rust_door_facts_lookup
  }
}

fn direct_rust_door_target_model() -> TargetModel {
  rust_target_model()
}

