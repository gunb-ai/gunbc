module v2.compiler.self_host.direct_rust_door_fixture


data direct_rust_door_fixture_note: String = "Self-host fixture for v2-emitter-direct-rust-door: rust add inferred tree lives in compiler self_host (not v2.test) so closing-contract admission can execute without layer inversion."

data direct_rust_door_module_path: String = "src/v2/compiler/self_host/direct_rust_door_fixture.dag"

data direct_rust_door_expected_source: String = rust_source_text

data direct_rust_door_dag_module_source: String = "module add_probe\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

data direct_rust_door_ingest_artifact: v2.std.artifact.Artifact = v2.std.artifact.Artifact {
  kind: SourceFile,
  id: ^direct_rust_door_ingest_artifact,
  file_path: "src/v2/compiler/self_host/direct_rust_door_ingest_fixture.dag"
}

data direct_rust_door_ingest_read: v2.compiler.source_authority.DagSourceReadWitness = v2.compiler.source_authority.DagSourceReadWitness {
  source: extdeps.communication.medium.Medium { carried: direct_rust_door_dag_module_source, fidelity: extdeps.communication.medium.Lossless },
  artifact: direct_rust_door_ingest_artifact,
  compilation_unit: ^direct_rust_door_add_probe_cu,
  source_root: V2Tree
}

fn direct_rust_door_ingest() -> v2.compiler.source_authority.SourceRootIngest {
  std.algebra.Cons { head: direct_rust_door_ingest_read, tail: std.algebra.Empty }
}

fn direct_rust_door_admission() -> v2.compiler.name_resolve.Admission {
  v2.compiler.name_resolve.Admission {
    subject: v2.compiler.name_resolve.ResolutionSubject {
      name: std.algebra.Cons { head: ^add_probe, tail: std.algebra.Empty }
    },
    imports: std.algebra.Empty
  }
}

fn direct_rust_door_i32_facts_node() -> Node {
  rust_integer_facts_node(facts: rust_facts_i32)
}

fn direct_rust_door_canonical_grounding(
  node: Node,
  algebra: Node
) -> v2.std.constraints.CanonicalGrounding {
  v2.std.constraints.CanonicalGrounding {
    node: node,
    witness: v2.std.constraints.CanonicalGroundingWitness {
      structural: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: v2.std.witness.StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn direct_rust_door_canonical_grounding_for(node: Node) -> Witness<v2.std.constraints.CanonicalGrounding> {
  if node == rust_fixture_emitted_add_fn {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_fixture_i32_inhabitant {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_inhabitant_i32) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_fixture_i32_inhabitant
      )
    }
  } else if node == direct_rust_door_i32_facts_node() {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_surface_spelling_i32) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_std_projection_int32) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_int_kind_node(kind: v2.extdeps.languages.rust.Signed) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_int_width_node(width: v2.extdeps.languages.rust.Bits32) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: direct_rust_door_i32_facts_node()
      )
    }
  } else if node == rust_i32_overflow_disposition_node() {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_i32_scalar_node() {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_scalar_int) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_signed) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_bits32) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_scalar_node()
      )
    }
  } else if node == rust_overflow_node(overflow: v2.extdeps.languages.rust.PanicOnOverflow) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_overflow_node(overflow: v2.extdeps.languages.rust.TwoComplementWrap) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_panic_on_overflow) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_overflow_node(overflow: v2.extdeps.languages.rust.PanicOnOverflow)
      )
    }
  } else if node == rust_inhabitant_atom(id: ^rust_tag_two_complement_wrap) {
    v2.std.witness.Holds {
      value: direct_rust_door_canonical_grounding(
        node: node,
        algebra: rust_overflow_node(overflow: v2.extdeps.languages.rust.TwoComplementWrap)
      )
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^direct_rust_door_grounding_miss,
        at: node_locus(node: node),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn direct_rust_door_inferred_facts_for(node: Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  match direct_rust_door_canonical_grounding_for(node: node) {
    Violates { diagnostic: _ } => optional_absent()
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: _ } => optional_absent()
        Holds { value: proof } =>
          optional_present(
            value: v2.compiler.inferred_tree.InferredFacts {
              grounding: v2.compiler.inferred_tree.DerivedGrounding { grounding: grounding },
              descent: Holds { value: proof }
            }
          )
      }
  }
}

fn direct_rust_door_facts_lookup(key: Node) -> Optional<v2.compiler.inferred_tree.InferredFacts> {
  direct_rust_door_inferred_facts_for(node: key)
}

data direct_rust_door_inferred_tree: v2.compiler.inferred_tree.InferredTree = v2.compiler.inferred_tree.InferredTree {
  root: rust_fixture_emitted_add_fn,
  facts: std.types.Map {
    lookup: direct_rust_door_facts_lookup
  }
}

fn direct_rust_door_target_model() -> v2.std.compilers.target_model.TargetModel {
  rust_target_model()
}

