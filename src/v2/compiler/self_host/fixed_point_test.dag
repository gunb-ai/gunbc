// src/v2/compiler/self_host/fixed_point_test.dag
// Scope: the ONLY live-executed self-host coverage. Discovered + run by the live CI gate
//   (.github/workflows/ci.yml:79: claim_batch --source-root src/v2 --roster-from-discovery --scan-dir src/v2/test).
//   IMPORTANT: `test fn` discovery scans the WHOLE --source-root (src/v2) recursively — NOT just
//   --scan-dir (that flag governs only the separate `unified_claim_*` data scan). So this file is
//   discovered at its compiler/self_host/ path, not because it lives under src/v2/test. The gate
//   runs each `test fn () -> Bool` (GREEN pass = true; PERTURB pass = body must flip to false).
// Status:
//   - fixed-point predicate (self_host_fixed_point_digests_match) de-risked on FIXTURE stages;
//   - Stage-A structural pre-check (stage_emission_equality) executed here;
//   - whole-compiler runner asserted FAIL-CLOSED (the honest current contract until stage C).
// ⚠️ NOT SELF-HOSTING ACHIEVED. These greens prove the comparison machinery on hand-built FIXTURE
//   nodes and the fail-closed runner contract — nothing more. The north-star self-host fixed point
//   (whole v2 compiler emitting bit-identical stage1==stage2 over real merkle digests) is stage C,
//   gated on candidate generation; when it lands, self_host_fixed_point_fails_closed_until_substrate
//   flips to assert Accepted + self_host_fixed_point_digests_match over the real emitted stages.

module v2.test.self_host.fixed_point

import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  Edge,
  Node,
  Positional,
  TypeNode,
  SyntheticOccurrence
}
import v2.compiler.self_host {
  self_host_fixed_point_digests_match,
  self_host_fixed_point_validate,
  stage_emission_equality,
  SourceModels
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.witness { Holds, Violates }


// Fixture "emitted stage" artifacts: well-formed canonical Nodes standing in for stage1/stage2
// emitted artifacts. content_hash and structural equality both exclude occurrence_id, so the
// reference and the matching candidate are built independently and still compare EQUAL.
fn stage_emission_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^stage_emission_fixture_leaf } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}
fn stage_reference_emitted() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: stage_emission_leaf() },
      Edge { label: Positional, target: stage_emission_leaf() },
      Edge { label: Positional, target: stage_emission_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}
fn stage_candidate_equal_emitted() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: stage_emission_leaf() },
      Edge { label: Positional, target: stage_emission_leaf() },
      Edge { label: Positional, target: stage_emission_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}
// Perturbed candidate — divergent arity (a dropped artifact): the discriminating red.
fn stage_candidate_perturbed_emitted() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: stage_emission_leaf() },
      Edge { label: Positional, target: stage_emission_leaf() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}


// Fixed-point predicate GREEN: bit-identical emitted stages share a merkle digest.
test fn self_host_fixed_point_digests_match_on_equal() -> Bool {
  self_host_fixed_point_digests_match(
    emitted_stage1: stage_reference_emitted(),
    emitted_stage2: stage_candidate_equal_emitted()
  )
}


// Fixed-point predicate discriminating RED: a divergent emitted stage has a different digest.
test fn self_host_fixed_point_digests_diverge_on_perturbed() -> Bool {
  self_host_fixed_point_digests_match(
    emitted_stage1: stage_reference_emitted(),
    emitted_stage2: stage_candidate_perturbed_emitted()
  ) == false
}


// Stage-A GREEN: a structurally-equal emitted candidate yields Holds.
test fn stage_emission_equality_holds_on_equal() -> Bool {
  match stage_emission_equality(
    emitted_candidate: stage_candidate_equal_emitted(),
    reference_stage1: stage_reference_emitted()
  ) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}


// Stage-A discriminating RED: a divergent emitted candidate yields Violates (located diff).
test fn stage_emission_equality_violates_on_perturbed() -> Bool {
  match stage_emission_equality(
    emitted_candidate: stage_candidate_perturbed_emitted(),
    reference_stage1: stage_reference_emitted()
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}


// Whole-compiler runner contract: fail-closed until the execution substrate + candidate
// generation land (stage C). Asserts the TRUE current behaviour — a located rejection carrying
// self_host_runner_not_realized — not a fabricated green. This is the carrier that flips to assert
// Accepted + self_host_fixed_point_digests_match when stage C wires real stage emission in.
test fn self_host_fixed_point_fails_closed_until_substrate() -> Bool {
  match self_host_fixed_point_validate(
    stage1_candidate: stage_emission_leaf(),
    source_models: SourceModels { model_corpus: [] },
    reference_stage1: stage_emission_leaf()
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^self_host_runner_not_realized
    Accepted { value: _, diagnostics: _ } => false
  }
}
