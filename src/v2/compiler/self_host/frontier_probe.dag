module v2.compiler.self_host.frontier_probe

import v2.compiler.self_host.compiler_closure_emit {
  emit_compiler_import_closure_from_ingest
}
import v2.compiler.name_resolve {
  Admission,
  ResolutionSubject,
  admission_from_module_root,
  resolve_diagnostics
}
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.self_host.frontier_probe_types {
  FrontierProbeClosurePopulationRefused,
  FrontierProbeCoverageRefused,
  FrontierProbeDetail,
  FrontierProbeDetailAbsent,
  FrontierProbeReceipt,
  MissingModule,
  ProbeStageEmit,
  SourceRefContentHashMismatch,
  SourceRefReadRefused,
  SourceRootManifestElidedProbe,
  UnknownProbeCause,
  frontier_classify_rejection_reason,
  frontier_probe_located_stage_for_assemble_outcome,
  frontier_probe_located_stage_for_emit_outcome
}
import v2.compiler.source_authority {
  DagSourceReadWitness,
  SourceRef,
  SourceRootCoverage,
  SourceRootCoverageComplete,
  SourceRootIngest,
  SourceRootManifestAbsent,
  SourceRootManifestElided,
  SourceRootRowsMissing,
  source_ref_content_hash_mismatch,
  source_ref_count_in_list,
  source_ref_eq,
  source_ref_list_has_duplicate,
  source_ref_read_refused,
  dag_source_observed_content_hash_for_ref,
  source_root_ingest_from_source_refs
}
import v2.extdeps.languages.dag { dag_language_model }
import v2.extdeps.languages.rust { rust_target_model }
import v2.lens.reference_deps { reference_deps_ingest_source_text }
import std.algebra { Cons, Empty }
import std.content_hash { ContentHash }
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.std.diagnostic {
  Accepted,
  LocusAnchor,
  NonEmptyDiagnostics,
  Outcome,
  PortLocus,
  Rejected,
  Textual,
  diagnostics_singleton,
  port_locus
}
import v2.std.qualified_name {
  qualified_name_from_dotted_string,
  qualified_name_to_dotted_string
}
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.text { String }

data frontier_probe_closure_duplicate_ref_reason: Symbol = ^frontier_probe_closure_duplicate_ref

data frontier_probe_closure_count_mismatch_reason: Symbol = ^frontier_probe_closure_count_mismatch

data frontier_probe_entry_binding_refused_reason: Symbol = ^frontier_probe_entry_binding_refused

data frontier_probe_coverage_refused_reason: Symbol = ^frontier_probe_coverage_refused

type FrontierProbeCoverageGate
  = FrontierProbeCoveragePermitted
  | FrontierProbeCoverageBlocked { coverage: SourceRootCoverage }

data frontier_probe_ingest_subject_note: String = "Single ingest authority for frontier probe (operator ruling 2026-08-04): FrontierProbeReferencedClosure reads through modeled SourceRef rows with content-hash verification and proves closure population identity (no duplicate refs, entry exactly once, count matches ingest_read_count) before read-through. Receipt module_path is derived from entry.path only. FrontierProbeFixture is explicit hermetic harness ingest."

type FrontierProbeIngestSubject
  = FrontierProbeReferencedClosure {
      refs: List<SourceRef>,
      coverage: SourceRootCoverage,
      ingest_read_count: Int,
      entry: SourceRef
    }
  | FrontierProbeFixture {
      ingest: SourceRootIngest,
      admission: Admission
    }

fn frontier_probe_source_ref_for_path(
  refs: List<SourceRef>,
  path: String
) -> Optional<SourceRef> {
  fold_list(
    xs: refs,
    empty: optional_absent(),
    cons: fn(acc, ref) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if ref.path == path {
            optional_present(value: ref)
          } else {
            optional_absent()
          }
      }
    }
  )
}

fn frontier_probe_source_ref_for_read_diagnostic(
  refs: List<SourceRef>,
  d: NonEmptyDiagnostics
) -> Optional<SourceRef> {
  match d.head.at {
    Textual { file: module_file, extent: _ } =>
      frontier_probe_source_ref_for_path(
        refs: refs,
        path: symbol_lexeme(sym: module_file)
      )
    _ => optional_absent()
  }
}

fn frontier_probe_diagnostic_tail_port_lexeme(d: NonEmptyDiagnostics) -> String {
  match d.tail {
    [] => ""
    [tail_ne] =>
      match tail_ne.head.at {
        PortLocus { anchor: LocusAnchor { at: port } } =>
          symbol_lexeme(sym: port)
        _ => ""
      }
  }
}

fn frontier_probe_detail_from_diagnostic(
  reason: Symbol,
  d: NonEmptyDiagnostics
) -> FrontierProbeDetail {
  if reason == ^resolve_module_not_found {
    match d.head.at {
      Textual { file: module_file, extent: _ } =>
        MissingModule {
          requested: qualified_name_from_dotted_string(
            dotted: symbol_lexeme(sym: module_file)
          )
        }
      _ => FrontierProbeDetailAbsent
    }
  } else {
    FrontierProbeDetailAbsent
  }
}

fn frontier_probe_detail_from_ingest_read_rejected(
  refs: List<SourceRef>,
  d: NonEmptyDiagnostics
) -> FrontierProbeDetail {
  match frontier_probe_source_ref_for_read_diagnostic(refs: refs, d: d) {
    Absent => FrontierProbeDetailAbsent
    Present { value: ref } =>
      if d.head.reason == source_ref_content_hash_mismatch {
        match dag_source_observed_content_hash_for_ref(ref: ref) {
          Present { value: observed } =>
            SourceRefContentHashMismatch {
              source_ref: ref,
              expected: ref.content_hash,
              observed: observed
            }
          Absent => FrontierProbeDetailAbsent
        }
      } else if d.head.reason == source_ref_read_refused {
        SourceRefReadRefused {
          source_ref: ref,
          error: frontier_probe_diagnostic_tail_port_lexeme(d: d)
        }
      } else {
        FrontierProbeDetailAbsent
      }
  }
}

fn frontier_probe_receipt_from_reason_only(
  module_path: String,
  reason: Symbol,
  detail: FrontierProbeDetail
) -> FrontierProbeReceipt {
  let blocker = frontier_classify_rejection_reason(reason: reason)
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: blocker,
    located_stage: frontier_probe_located_stage_for_assemble_outcome(blocker: blocker),
    located_reason: reason,
    detail: detail
  }
}

fn frontier_probe_receipt_from_ingest_read_rejected(
  module_path: String,
  refs: List<SourceRef>,
  d: NonEmptyDiagnostics
) -> FrontierProbeReceipt {
  let reason = d.head.reason
  let blocker = frontier_classify_rejection_reason(reason: reason)
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: blocker,
    located_stage: ProbeStageAssemble,
    located_reason: reason,
    detail: frontier_probe_detail_from_ingest_read_rejected(refs: refs, d: d)
  }
}

fn frontier_probe_receipt_from_population_refused(
  module_path: String,
  cause: Symbol
) -> FrontierProbeReceipt {
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: UnknownProbeCause { reason: cause },
    located_stage: ProbeStageAssemble,
    located_reason: cause,
    detail: FrontierProbeClosurePopulationRefused { cause: cause }
  }
}

fn frontier_probe_receipt_from_coverage_refused(
  module_path: String,
  coverage: SourceRootCoverage
) -> FrontierProbeReceipt {
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: UnknownProbeCause { reason: frontier_probe_coverage_refused_reason },
    located_stage: ProbeStageAssemble,
    located_reason: frontier_probe_coverage_refused_reason,
    detail: FrontierProbeCoverageRefused { coverage: coverage }
  }
}

fn frontier_probe_entry_read_witness(
  ingest: SourceRootIngest,
  module_path: String
) -> Optional<DagSourceReadWitness> {
  fold_list(
    xs: ingest,
    empty: optional_absent(),
    cons: fn(acc, read) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if read.artifact.file_path == module_path {
            optional_present(value: read)
          } else {
            optional_absent()
          }
      }
    }
  )
}

fn frontier_probe_admission_from_ingest(
  ingest: SourceRootIngest,
  module_path: String
) -> Outcome<Admission> {
  match frontier_probe_entry_read_witness(ingest: ingest, module_path: module_path) {
    Present { value: read } =>
      match reference_deps_ingest_source_text(
        source_text: read.source.carried,
        file: symbol_intern_lexeme(lexeme: module_path)
      ) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: parse_root, diagnostics: _ } =>
          admission_from_module_root(root: parse_root)
      }
    Absent =>
      Rejected { diagnostics: resolve_diagnostics(reason: ^resolve_module_not_found) }
  }
}

fn frontier_probe_coverage_gate(
  coverage: SourceRootCoverage,
  refs: List<SourceRef>,
  ingest_read_count: Int
) -> FrontierProbeCoverageGate {
  match coverage {
    SourceRootCoverageComplete =>
      if length(xs: refs) == ingest_read_count {
        FrontierProbeCoveragePermitted
      } else {
        FrontierProbeCoverageBlocked { coverage: coverage }
      }
    SourceRootManifestElided { read_count: elided_reads, cap: _ } =>
      if length(xs: refs) == elided_reads && elided_reads == ingest_read_count {
        FrontierProbeCoveragePermitted
      } else {
        FrontierProbeCoverageBlocked { coverage: coverage }
      }
    SourceRootRowsMissing { read_count: _, produced_row_count: _ } =>
      FrontierProbeCoverageBlocked { coverage: coverage }
    SourceRootManifestAbsent =>
      FrontierProbeCoverageBlocked { coverage: coverage }
  }
}

fn frontier_probe_receipt_from_referenced_closure(
  refs: List<SourceRef>,
  coverage: SourceRootCoverage,
  ingest_read_count: Int,
  entry: SourceRef
) -> FrontierProbeReceipt {
  let module_path = entry.path
  if source_ref_count_in_list(refs: refs, target: entry) != 1 {
    frontier_probe_receipt_from_population_refused(
      module_path: module_path,
      cause: frontier_probe_entry_binding_refused_reason
    )
  } else if source_ref_list_has_duplicate(refs: refs) {
    frontier_probe_receipt_from_population_refused(
      module_path: module_path,
      cause: frontier_probe_closure_duplicate_ref_reason
    )
  } else if length(xs: refs) != ingest_read_count {
    frontier_probe_receipt_from_population_refused(
      module_path: module_path,
      cause: frontier_probe_closure_count_mismatch_reason
    )
  } else {
    match frontier_probe_coverage_gate(
      coverage: coverage,
      refs: refs,
      ingest_read_count: ingest_read_count
    ) {
      FrontierProbeCoverageBlocked { coverage: blocked } =>
        frontier_probe_receipt_from_coverage_refused(
          module_path: module_path,
          coverage: blocked
        )
      FrontierProbeCoveragePermitted =>
        match source_root_ingest_from_source_refs(refs: refs) {
          Rejected { diagnostics: d } =>
            frontier_probe_receipt_from_ingest_read_rejected(
              module_path: module_path,
              refs: refs,
              d: d
            )
          Accepted { value: ingest, diagnostics: _ } =>
            match frontier_probe_admission_from_ingest(
              ingest: ingest,
              module_path: module_path
            ) {
              Rejected { diagnostics: d } =>
                frontier_probe_receipt_from_admission_diagnostic_rejected(
                  module_path: module_path,
                  d: d
                )
              Accepted { value: admission, diagnostics: _ } =>
                frontier_probe_emit_from_ingest(
                  module_path: module_path,
                  ingest: ingest,
                  admission: admission
                )
            }
        }
    }
  }
}

fn frontier_probe_receipt_from_admission_diagnostic_rejected(
  module_path: String,
  d: NonEmptyDiagnostics
) -> FrontierProbeReceipt {
  let reason = d.head.reason
  let blocker = frontier_classify_rejection_reason(reason: reason)
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: blocker,
    located_stage: frontier_probe_located_stage_for_assemble_outcome(blocker: blocker),
    located_reason: reason,
    detail: frontier_probe_detail_from_diagnostic(reason: reason, d: d)
  }
}

fn frontier_probe_receipt_for_subject(
  subject: FrontierProbeIngestSubject,
  fixture_module_path: String
) -> FrontierProbeReceipt {
  match subject {
    FrontierProbeFixture { ingest: ingest, admission: admission } =>
      frontier_probe_emit_from_ingest(
        module_path: fixture_module_path,
        ingest: ingest,
        admission: admission
      )
    FrontierProbeReferencedClosure {
      refs: refs,
      coverage: coverage,
      ingest_read_count: read_count,
      entry: entry_ref
    } =>
      frontier_probe_receipt_from_referenced_closure(
        refs: refs,
        coverage: coverage,
        ingest_read_count: read_count,
        entry: entry_ref
      )
  }
}

fn frontier_probe_emit_from_ingest(
  module_path: String,
  ingest: SourceRootIngest,
  admission: Admission
) -> FrontierProbeReceipt {
  match assemble_program_from_ingest(
    ingest: ingest,
    admission: admission,
    lm: dag_language_model()
  ) {
    Rejected { diagnostics: d } => {
      let blocker = frontier_classify_rejection_reason(reason: d.head.reason)
      FrontierProbeReceipt {
        module_path: module_path,
        blocker_class: blocker,
        located_stage: frontier_probe_located_stage_for_assemble_outcome(blocker: blocker),
        located_reason: d.head.reason,
        detail: frontier_probe_detail_from_diagnostic(reason: d.head.reason, d: d)
      }
    }
    Accepted { value: _, diagnostics: _ } =>
      match emit_compiler_import_closure_from_ingest(
        ingest: ingest,
        admission: admission,
        target: rust_target_model()
      ) {
        Accepted { value: _, diagnostics: _ } =>
          FrontierProbeReceipt {
            module_path: module_path,
            blocker_class: UnknownProbeCause {
              reason: ^probe_emit_accept_self_host_bar_unbound
            },
            located_stage: ProbeStageEmit,
            located_reason: ^probe_emit_accept_self_host_bar_unbound,
            detail: FrontierProbeDetailAbsent
          }
        Rejected { diagnostics: d } => {
          let blocker = frontier_classify_rejection_reason(reason: d.head.reason)
          FrontierProbeReceipt {
            module_path: module_path,
            blocker_class: blocker,
            located_stage: frontier_probe_located_stage_for_emit_outcome(blocker: blocker),
            located_reason: d.head.reason,
            detail: FrontierProbeDetailAbsent
          }
        }
      }
  }
}
