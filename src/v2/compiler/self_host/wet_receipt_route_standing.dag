fn wet_receipt_standing_is_executable(standing: WetReceiptRouteStanding) -> Bool {
  match standing {
    WetReceiptExecutable { receipt: _, driver: _, binding: _, expected_fault_marker: _ } => true
    WetReceiptBindingUnavailable { receipt: _, cause: _ } => false
    WetReceiptObsolete { receipt: _, cause: _ } => false
  }
}

fn wet_receipt_standing_receipt(standing: WetReceiptRouteStanding) -> WetReceiptIdentity {
  match standing {
    WetReceiptExecutable { receipt: r, driver: _, binding: _, expected_fault_marker: _ } => r
    WetReceiptBindingUnavailable { receipt: r, cause: _ } => r
    WetReceiptObsolete { receipt: r, cause: _ } => r
  }
}

// THE MARKER DERIVATION IS ASKABLE WITHOUT A BINDING, and has to be. expected_fault_marker is
// carried only on the Executable arm, so with the binding roster empty no row exposes one and the
// derivation would be untestable exactly when it most needs a control. "What marker would this
// module's driver print on the fault path" is a property of the transport, not the enrolment, so
// it is answerable for all sixteen module rows today.
fn wet_receipt_expected_fault_marker_for_module(module_path: String) -> String {
  match module_behavioral_transport_config_for(module_path: module_path) {
    Absent => ""
    Present { value: cfg } => wet_receipt_fault_marker(pass_marker: cfg.pass_marker)
  }
}

fn wet_receipt_standing_for(receipt: WetReceiptIdentity) -> Optional<WetReceiptRouteStanding> {
  fold_list(
    wet_receipt_route_standings,
    empty: optional_absent(),
    cons: fn(acc, standing) {
      match acc {
        Present { value: _ } => acc
        Absent => {
          let r = wet_receipt_standing_receipt(standing: standing)
          if r.entry == receipt.entry && r.function == receipt.function {
            optional_present(value: standing)
          } else {
            optional_absent()
          }
        }
      }
    }
  )
}

fn wet_receipt_standing_is_revoked_on_measured_red(standing: WetReceiptRouteStanding) -> Bool {
  match standing {
    WetReceiptExecutable { receipt: _, driver: _, binding: _, expected_fault_marker: _ } => false
    WetReceiptObsolete { receipt: _, cause: _ } => false
    WetReceiptBindingUnavailable { receipt: _, cause: c } => {
      match c {
        BindingRevokedOnMeasuredRed { cadence_run: _ } => true
        BindingNeverEstablished => false
      }
    }
  }
}

fn wet_receipt_standing_is_never_established(standing: WetReceiptRouteStanding) -> Bool {
  match standing {
    WetReceiptExecutable { receipt: _, driver: _, binding: _, expected_fault_marker: _ } => false
    WetReceiptObsolete { receipt: _, cause: _ } => false
    WetReceiptBindingUnavailable { receipt: _, cause: c } => {
      match c {
        BindingRevokedOnMeasuredRed { cadence_run: _ } => false
        BindingNeverEstablished => true
      }
    }
  }
}
