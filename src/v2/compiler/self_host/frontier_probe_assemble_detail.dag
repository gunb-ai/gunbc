module v2.compiler.self_host.frontier_probe_assemble_detail

import std.algebra { FreeMonoid }
import v2.std.algebra {
  Empty,
  HeadAbsent,
  HeadFound,
  TailAbsent,
  TailFound,
  fold_list,
  is_empty,
  list_head,
  list_snoc_item,
  list_tail
}
import v2.compiler.parse_diagnostic {
  NoParseDiagnosticEvidence,
  NonEmptyParseStageDiagnostics,
  ParseStageDiagnostic,
  grammar_choice_ambiguity_rows_from_non_empty_parse_stage,
  list_head_value_or_self_parse_stage,
  list_tail_or_empty_parse_stage,
  non_empty_grammar_choice_ambiguity_rows_from_parse_stage,
  parse_overlap_residue_stage_diagnostic_at,
  parse_stage_diagnostic_from_diagnostic_only
}
import v2.std.grammar_choice_ambiguity { GrammarChoiceAmbiguityRow }
import v2.compiler.self_host.frontier_probe_types {
  AssembleMissingModule,
  AssembleRejectionCause,
  AssembleRejectionDetail,
  FrontierBlockerClass,
  FrontierProbeAssembleDetail,
  FrontierProbeDetail,
  FrontierProbeReceipt,
  GrammarChoiceOverlap,
  MaskedAssembleRefusal,
  MaskedAssembleRefusalWithoutEvidence,
  MissingModuleIdentityUnavailable,
  NonEmptySymbolChain,
  OtherAssembleRefusal,
  frontier_probe_cause_location_from_locus,
  ProbeStageAssemble
}
import v2.std.diagnostic { Diagnostic, NonEmptyDiagnostics }
import v2.std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.qualified_name { QualifiedName }
import v2.std.text { String }

fn non_empty_symbol_chain_from_non_empty_parse_stage(
  d: NonEmptyParseStageDiagnostics
) -> NonEmptySymbolChain {
  NonEmptySymbolChain {
    head: d.head.diagnostic.reason,
    tail: fold_list(
      xs: d.tail,
      empty: Empty,
      cons: fn(acc, item) { list_snoc_item(xs: acc, item: item.diagnostic.reason) }
    )
  }
}

fn non_empty_symbol_chain_from_non_empty_diagnostics(
  d: NonEmptyDiagnostics
) -> NonEmptySymbolChain {
  NonEmptySymbolChain {
    head: d.head.reason,
    tail: fold_list(
      xs: d.tail,
      empty: Empty,
      cons: fn(acc, diag) { list_snoc_item(xs: acc, item: diag.reason) }
    )
  }
}

fn diagnostic_module_root_missing_qn_optional(d: Diagnostic) -> Optional<QualifiedName> {
  optional_absent()
}

data diagnostic_module_root_missing_qn_stub_note: String = "diagnostic_module_root_missing_qn_optional is deliberately unavailable in this PR — it always returns Absent, so resolve_module_not_found assemble causes classify as MissingModuleIdentityUnavailable rather than AssembleMissingModule { requested }. FrontierProbeDetail.MissingModule (#7762) carries the structural QualifiedName on receipt.detail when frontier_probe_detail_from_diagnostic binds it. Parse-stage AssembleMissingModule awaits ModuleRootMissingEvidence on ParseDiagnosticEvidence without reintroducing the diagnostic.dag ↔ qualified_name import cycle. Dissolve trigger: wire parse-stage diagnostics to carry that evidence; then replace optional_absent() with extraction from ParseStageDiagnostic.evidence and map Present -> AssembleMissingModule { requested }."

fn assemble_rejection_cause_from_parse_stage(
  d: NonEmptyParseStageDiagnostics
) -> AssembleRejectionCause {
  if !is_empty(xs: d.tail) && (d.head.diagnostic.reason == ^parse_grammar_choice_overlap_residue) {
    match non_empty_grammar_choice_ambiguity_rows_from_parse_stage(
      d: NonEmptyParseStageDiagnostics { head: d.head, tail: Empty }
    ) {
      Present { value: overlap_evidence } =>
        MaskedAssembleRefusal {
          overlap_evidence: overlap_evidence,
          remaining_chain: non_empty_symbol_chain_from_parse_stage_head(
            head: list_head_value_or_self_parse_stage(head: d.head, tail: d.tail),
            tail: list_tail_or_empty_parse_stage(tail: d.tail)
          )
        }
      Absent =>
        MaskedAssembleRefusalWithoutEvidence {
          remaining_chain: non_empty_symbol_chain_from_parse_stage_head(
            head: list_head_value_or_self_parse_stage(head: d.head, tail: d.tail),
            tail: list_tail_or_empty_parse_stage(tail: d.tail)
          )
        }
    }
  } else if d.head.diagnostic.reason == ^resolve_module_not_found {
    match diagnostic_module_root_missing_qn_optional(d: d.head.diagnostic) {
      Present { value: requested } => AssembleMissingModule { requested: requested }
      Absent => MissingModuleIdentityUnavailable
    }
  } else {
    match non_empty_grammar_choice_ambiguity_rows_from_parse_stage(d: d) {
      Present { value: rows } => GrammarChoiceOverlap { rows: rows }
      Absent => OtherAssembleRefusal { reason: d.head.diagnostic.reason }
    }
  }
}

fn non_empty_symbol_chain_from_parse_stage_head(
  head: ParseStageDiagnostic,
  tail: FreeMonoid<ParseStageDiagnostic>
) -> NonEmptySymbolChain {
  NonEmptySymbolChain {
    head: head.diagnostic.reason,
    tail: fold_list(
      xs: tail,
      empty: Empty,
      cons: fn(acc, item) { list_snoc_item(xs: acc, item: item.diagnostic.reason) }
    )
  }
}

fn diagnostic_reason_is_overlap_residue(d: Diagnostic) -> Bool {
  d.reason == ^parse_grammar_choice_overlap_residue
}

fn all_overlap_residue_diagnostic_list(xs: FreeMonoid<Diagnostic>) -> Bool {
  fold_list(
    xs: xs,
    empty: true,
    cons: fn(acc, diag) { acc && diagnostic_reason_is_overlap_residue(d: diag) }
  )
}

fn all_overlap_residue_non_empty_diagnostics(d: NonEmptyDiagnostics) -> Bool {
  diagnostic_reason_is_overlap_residue(d: d.head)
    && all_overlap_residue_diagnostic_list(xs: d.tail)
}

data overlap_diagnostic_row_queue_merge_note: String = "parse_stage_head_from_overlap_row_queue_and_diagnostic and parse_stage_tail_from_overlap_row_queue_and_diagnostics pair plain NonEmptyDiagnostics overlap residues against a GrammarChoiceAmbiguityRow queue from overlap_residue_stage. Both sides derive from the same ambiguity_roster in grammar_validate_and_analyze today — count mismatch is unreachable in-tree. HeadAbsent arms silently narrow to NoParseDiagnosticEvidence (empty-observation narrow at this boundary if parallel representation diverges). Dissolve trigger: carry overlap evidence only on parse-stage diagnostics and delete this queue-merge path; then refuse on evidence deficit instead of narrowing."

type OverlapQueueMergeAcc {
  stages: FreeMonoid<ParseStageDiagnostic>
  row_queue: FreeMonoid<GrammarChoiceAmbiguityRow>
}

fn overlap_row_queue_tail_after_pop(
  row_queue: FreeMonoid<GrammarChoiceAmbiguityRow>
) -> FreeMonoid<GrammarChoiceAmbiguityRow> {
  match list_tail(xs: row_queue) {
    TailAbsent => Empty
    TailFound { tail: rest } => rest
  }
}

fn overlap_queue_merge_acc_step(acc: OverlapQueueMergeAcc, diag: Diagnostic) -> OverlapQueueMergeAcc {
  if diagnostic_reason_is_overlap_residue(d: diag) {
    match list_head(xs: acc.row_queue) {
      HeadFound { value: row } =>
        OverlapQueueMergeAcc {
          stages: list_snoc_item(
            xs: acc.stages,
            item: parse_overlap_residue_stage_diagnostic_at(at: diag.at, row: row)
          ),
          row_queue: overlap_row_queue_tail_after_pop(row_queue: acc.row_queue)
        }
      HeadAbsent =>
        OverlapQueueMergeAcc {
          stages: list_snoc_item(
            xs: acc.stages,
            item: parse_stage_diagnostic_from_diagnostic_only(d: diag)
          ),
          row_queue: acc.row_queue
        }
    }
  } else {
    OverlapQueueMergeAcc {
      stages: list_snoc_item(
        xs: acc.stages,
        item: parse_stage_diagnostic_from_diagnostic_only(d: diag)
      ),
      row_queue: acc.row_queue
    }
  }
}

fn parse_stage_tail_from_overlap_row_queue_and_diagnostics(
  tail: FreeMonoid<Diagnostic>,
  row_queue: FreeMonoid<GrammarChoiceAmbiguityRow>
) -> FreeMonoid<ParseStageDiagnostic> {
  fold_list(
    xs: tail,
    empty: OverlapQueueMergeAcc { stages: Empty, row_queue: row_queue },
    cons: fn(acc, diag) { overlap_queue_merge_acc_step(acc: acc, diag: diag) }
  ).stages
}

fn parse_stage_head_from_overlap_row_queue_and_diagnostic(
  diag: Diagnostic,
  row_queue: FreeMonoid<GrammarChoiceAmbiguityRow>
) -> ParseStageDiagnostic {
  if diagnostic_reason_is_overlap_residue(d: diag) {
    match list_head(xs: row_queue) {
      HeadFound { value: row } =>
        parse_overlap_residue_stage_diagnostic_at(at: diag.at, row: row)
      HeadAbsent => parse_stage_diagnostic_from_diagnostic_only(d: diag)
    }
  } else {
    parse_stage_diagnostic_from_diagnostic_only(d: diag)
  }
}

fn overlap_row_queue_after_overlap_head(
  diag: Diagnostic,
  row_queue: FreeMonoid<GrammarChoiceAmbiguityRow>
) -> FreeMonoid<GrammarChoiceAmbiguityRow> {
  if diagnostic_reason_is_overlap_residue(d: diag) {
    overlap_row_queue_tail_after_pop(row_queue: row_queue)
  } else {
    row_queue
  }
}

fn non_empty_parse_stage_diagnostics_from_rejection_and_overlap_stage(
  d: NonEmptyDiagnostics,
  overlap_stage: NonEmptyParseStageDiagnostics
) -> NonEmptyParseStageDiagnostics {
  let row_queue = grammar_choice_ambiguity_rows_from_non_empty_parse_stage(d: overlap_stage)
  let head = parse_stage_head_from_overlap_row_queue_and_diagnostic(
    diag: d.head,
    row_queue: row_queue
  )
  let row_queue_after_head = overlap_row_queue_after_overlap_head(diag: d.head, row_queue: row_queue)
  NonEmptyParseStageDiagnostics {
    head: head,
    tail: parse_stage_tail_from_overlap_row_queue_and_diagnostics(
      tail: d.tail,
      row_queue: row_queue_after_head
    )
  }
}

fn non_empty_parse_stage_diagnostics_merged(
  d: NonEmptyDiagnostics,
  overlap_stage: NonEmptyParseStageDiagnostics
) -> NonEmptyParseStageDiagnostics {
  if all_overlap_residue_non_empty_diagnostics(d: d) {
    overlap_stage
  } else {
    non_empty_parse_stage_diagnostics_from_rejection_and_overlap_stage(
      d: d,
      overlap_stage: overlap_stage
    )
  }
}

fn assemble_rejection_cause_from_diagnostics(
  d: NonEmptyDiagnostics
) -> AssembleRejectionCause {
  if !is_empty(xs: d.tail) && (d.head.reason == ^parse_grammar_choice_overlap_residue) {
    MaskedAssembleRefusalWithoutEvidence {
      remaining_chain: non_empty_symbol_chain_from_diagnostic_list(
        head_diag: list_head_value_or_self(head: d.head, tail: d.tail),
        tail: list_tail_or_empty_diagnostics(tail: d.tail)
      )
    }
  } else if d.head.reason == ^resolve_module_not_found {
    match diagnostic_module_root_missing_qn_optional(d: d.head) {
      Present { value: requested } => AssembleMissingModule { requested: requested }
      Absent => MissingModuleIdentityUnavailable
    }
  } else {
    OtherAssembleRefusal { reason: d.head.reason }
  }
}

fn non_empty_symbol_chain_from_diagnostic_list(
  head_diag: Diagnostic,
  tail: FreeMonoid<Diagnostic>
) -> NonEmptySymbolChain {
  NonEmptySymbolChain {
    head: head_diag.reason,
    tail: fold_list(
      xs: tail,
      empty: Empty,
      cons: fn(acc, diag) { list_snoc_item(xs: acc, item: diag.reason) }
    )
  }
}

fn list_head_value_or_self(head: Diagnostic, tail: FreeMonoid<Diagnostic>) -> Diagnostic {
  match list_head(xs: tail) {
    HeadFound { value: diag } => diag
    HeadAbsent => head
  }
}

fn list_tail_or_empty_diagnostics(tail: FreeMonoid<Diagnostic>) -> FreeMonoid<Diagnostic> {
  match list_tail(xs: tail) {
    TailAbsent => Empty
    TailFound { tail: rest } => rest
  }
}

fn frontier_probe_assemble_detail_from_parse_stage(
  d: NonEmptyParseStageDiagnostics
) -> FrontierProbeAssembleDetail {
  AssembleRejectionDetail {
    rejection_chain: non_empty_symbol_chain_from_non_empty_parse_stage(d: d),
    cause: assemble_rejection_cause_from_parse_stage(d: d),
    at: frontier_probe_cause_location_from_locus(at: d.head.diagnostic.at)
  }
}

fn frontier_probe_assemble_detail_from_rejection(
  d: NonEmptyDiagnostics
) -> FrontierProbeAssembleDetail {
  AssembleRejectionDetail {
    rejection_chain: non_empty_symbol_chain_from_non_empty_diagnostics(d: d),
    cause: assemble_rejection_cause_from_diagnostics(d: d),
    at: frontier_probe_cause_location_from_locus(at: d.head.at)
  }
}

fn frontier_probe_assemble_detail_from_rejection_with_overlap_stage(
  d: NonEmptyDiagnostics,
  overlap_residue_stage: Optional<NonEmptyParseStageDiagnostics>
) -> FrontierProbeAssembleDetail {
  match overlap_residue_stage {
    Absent => frontier_probe_assemble_detail_from_rejection(d: d)
    Present { value: stage } =>
      AssembleRejectionDetail {
        rejection_chain: non_empty_symbol_chain_from_non_empty_diagnostics(d: d),
        cause: assemble_rejection_cause_from_parse_stage(
          d: non_empty_parse_stage_diagnostics_merged(d: d, overlap_stage: stage)
        ),
        at: frontier_probe_cause_location_from_locus(at: d.head.at)
      }
  }
}

fn frontier_probe_receipt_from_assemble_rejection(
  module_path: String,
  blocker: FrontierBlockerClass,
  diagnostics: NonEmptyDiagnostics,
  detail: FrontierProbeDetail,
  overlap_residue_stage: Optional<NonEmptyParseStageDiagnostics>
) -> FrontierProbeReceipt {
  FrontierProbeReceipt {
    module_path: module_path,
    blocker_class: blocker,
    located_stage: ProbeStageAssemble,
    located_reason: diagnostics.head.reason,
    detail: detail,
    assemble_detail: frontier_probe_assemble_detail_from_rejection_with_overlap_stage(
      d: diagnostics,
      overlap_residue_stage: overlap_residue_stage
    )
  }
}
