// ANSWERS ROSTER MEMBERSHIP ONLY, AS ITS NAME SAYS. Until the cadence flag was cut it conjoined
// `falsifier_self_host_wet_cadence_is_active()` onto the fold below, so one predicate answered two
// questions -- is this identity enrolled, AND does the lane run -- and a false could not be
// attributed. The second question has a single authority (std.witness_admission
// witness_cadence_has_scheduled_route). The flag stood at true, so dropping the conjunct changes no
// result today; it separates the state-space, per DESIGN's state-space-conflation failure mode.

// Returns false: the R1 bijection identity has been rehomed from FalsifierSelfHostWet to
// LocalRepoWetLane (2026-09-06, dashboard node adhoc-cf84ab88-8dc). It is no longer on
// falsifier_self_host_wet_template_entries and is instead enrolled in
// v2.workflow.local_repo_wet_terminal local_repo_wet_schedule. The fold below returns false
// because the entry was removed from the roster — this is computed from the data, not hardcoded.
fn dispatch_bijection_real_roster_red_enrolled_on_falsifier_self_host_wet() -> Bool {
  fold(
    falsifier_self_host_wet_template_entries,
    init: false,
    f: fn(acc, row) {
      acc
        || (
          row.entry == "dag/test/claim/interpreter_dispatch_bijection_real_roster_witness_test.dag"
            && row.function == "interpreter_dispatch_bijection_real_roster_red_holds"
        )
    }
  )
}

