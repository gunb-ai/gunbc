fn dispatch_bijection_real_roster_red_enrolled_on_falsifier_self_host_wet() -> Bool {
  falsifier_self_host_wet_cadence_is_active()
    && fold(
      falsifier_self_host_wet_template_entries,
      init: false,
      f: fn(acc, row) {
        acc
          || (
            row.entry == "dag/test/claim/interpreter_dispatch_bijection_real_roster_witness_test.dag"
              && row.function == "interpreter_dispatch_bijection_real_roster_red_holds"
          )
      }
    )
}

data falsifier_native_cache_cold_roster_note: String = "Cold-control roster (GUNBC_CI_NATIVE_CACHE_COLD_CONTROL falsifier step): COLD-VALID emit_host_*_equals_eval agreement legs — emit->build->run->equals-oracle with no compile_skipped assertion. Eleven entry files; meet_join enrolls both peer primaries (emit_host_meet_equals_eval_holds and emit_host_join_equals_eval_holds) so dissolving the former `_all_holds` umbrella does not drop join (review 43336). The one-build family aggregates must NOT run here: their warm legs assert compile_skipped=true, which the control deliberately falsifies (probe receipt 2026-07-21). Re-authored 2026-07-22 after the one-build migration (#7042) deleted the per-witness agreement/native_cold fns the prior roster named. Extended 2026-07-23 (neat-carp-312, Lane C) with filesystem_read/shell_exec_run, the two native host-effect transport families added alongside EmittedEffectFamily — same COLD-VALID shape, no compile_skipped assertion."

