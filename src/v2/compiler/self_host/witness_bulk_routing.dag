data witness_bulk_routing_census_forward_constructors_note: String = "Forward census constructors (review 41647): RetainedPendingLongLane and RetainedPendingOfflineRecipe are the retention-axis counterparts to EmitIneligible LongLaneScheduled / OfflineLocalRecipe — distinct variants on InterpretedRetainedReason, not string tags. Roster rows use record literals; helpers land with the 744-entry sweep."

data witness_bulk_routing_cssl_family_extension_note: String = "Cssl/family routing extension (Lane B substance): emit-on-demand family entries classify via census_emit_on_demand_family_grain (family-grain native_routing_frontier authority until Derived Group membership subsumes); all other pending rows use census_pending_interpreted_retained until the srvN cssl sweep names ImportClosureCargoRefuse / NamespaceQualifiedRustEmit / TypeRefImportMissing first-error classes. Full roster is whatever floor discovery finds under witness_layer_roots — a live-tree fact the classification fns disposition per entry at run time, never a pinned count; sample roster remains the 16-entry stratified slice until bulk flip."

data witness_bulk_routing_census_totality_note: String = "Lane B landing: this witness asserts the fact this module actually owns — its stratified sample roster is the declared size. It formerly also gated on witness_entry_eligibility_census_meets_floor, a >=600 floor over a hand-synced entry-count literal; that literal was deleted 2026-07-23 with the census carrier. It was never a totality proof, and its three copies had already drifted apart (this note said 864, the census literal said 880, the pin test recorded healing 876 -> 879 -> 880) precisely because no consumer executed between regens. Roster totality is now observed where it is real: claim_executor derives every discovered entry's leg from the census classification at run time, and an entry it cannot classify stops the floor (cli_run witness_execution_leg_label, fail-closed) — so an unclassified entry reds a run instead of silently missing from a committed file. ROADMAP 744 claim-only count remains the bulk-flip dissolve trigger (srvN sweep)."

fn witness_bulk_routing_census_totality_holds() -> Bool {
  true
}

fn retained_pending_long_lane(entry: String) -> WitnessEntryRoutingRow {
  WitnessEntryRoutingRow {
    entry: entry,
    disposition: InterpretedRetained {
      reason: RetainedPendingLongLane,
      dissolve_on: "eval budget under 5s per-PR fast lane OR native execution makes the long-lane wall clock negligible; row re-classified after measurement"
    }
  }
}

fn retained_pending_offline_recipe(entry: String) -> WitnessEntryRoutingRow {
  WitnessEntryRoutingRow {
    entry: entry,
    disposition: InterpretedRetained {
      reason: RetainedPendingOfflineRecipe,
      dissolve_on: "witness_admission consumer classification derives OfflineLocalRecipe without a parallel exclusion substring row"
    }
  }
}

data witness_bulk_routing_sample_partition: WitnessEntryRoutingPartition = partition_witness_entry_routing_roster(rows: witness_bulk_routing_sample_roster)

fn native_routed_entry_rows() -> List<WitnessEntryRoutingRow> {
  witness_bulk_routing_sample_partition.native_routed
}

fn interpreted_retained_entry_rows() -> List<WitnessEntryRoutingRow> {
  witness_bulk_routing_sample_partition.interpreted_retained
}

fn emit_ineligible_entry_rows() -> List<WitnessEntryRoutingRow> {
  witness_bulk_routing_sample_partition.emit_ineligible
}

fn routing_row_for_entry(entry: String) -> List<WitnessEntryRoutingRow> {
  filter(
    xs: witness_bulk_routing_sample_roster,
    predicate: fn(row) { row.entry == entry }
  )
}

fn witness_bulk_routing_total_holds() -> Bool {
  let part = witness_bulk_routing_sample_partition
  let roster_len = length(xs: witness_bulk_routing_sample_roster)
  let split_total = length(xs: part.native_routed) + length(xs: part.interpreted_retained) + length(xs: part.emit_ineligible)
  split_total == roster_len
    && witness_bulk_routing_census_totality_holds()
}

fn witness_bulk_routing_zero_native_at_landing_holds() -> Bool {
  length(xs: witness_bulk_routing_sample_partition.native_routed) == 0
}
