module v2.compiler.lexical_scope

import std.types { List }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.algebra { list_snoc_item }
import v2.std.algebra { list_map }
import v2.std.integer { Int }
import v2.std.node {
  Arrow,
  ArrowResourceRequirementsEdge,
  ArrowSignatureOrderEdge,
  Atom,
  Authored,
  Bind,
  ComputationNode,
  Conj,
  Edge,
  FirstPositionalAbsent,
  FirstPositionalFound,
  Node,
  Positional,
  StructuralLabel,
  Symbol,
  TypeNode,
  arrow_first_positional_target,
  arrow_named_edge_is_metadata,
  edge_is_core,
  positional_child_count,
  positional_edges
}
import v2.std.type_binder { edge_is_cast_target, edge_is_type_annotation, edge_is_type_params }
import v2.compiler.namespace_graft { namespace_graft_module_body_optional }
import v2.extdeps.languages.dag { namespace_graft_node_is_module_body }

// WHERE A NAME IS BOUND LEXICALLY, AS ONE FACT. Resolution decides what a name means at a site by the
// frames that enclose the site; module acquisition decides whether a dotted spelling at a site can name
// a module by the same frames, because a spelling whose head a frame binds is a projection off that
// binder and names no module. These are the two questions v2.compiler.resolve and
// v2.compiler.module_acquisition ask of the SAME tree, so the answer they share is declared here once and
// each reads it: which names a binding construct introduces, and which of its children each name is
// visible in. Neither stage restates the other's table.
//
// The module is a pure reading of one Node and imports only std, v2.std and the module-body marker's
// producer (v2.compiler.namespace_graft), none of which import a stage that reads it, so resolution and
// acquisition both import it and no import cycle can form.

type DeclaredBinding {
  name: Symbol
}

fn try_edge_declared_binding(e: Edge) -> DeclaredBinding? {
  match e.label {
    Authored { name: sym } => Present { value: DeclaredBinding { name: sym } }
    StructuralLabel { label: _ } => Absent
    Positional => Absent
  }
}

// ---- Arrow ---------------------------------------------------------------------------------------------

// An Arrow's value binders are the AUTHORED Named edges of its domain Conj, in the domain's declared
// order, each with the edge that carries its declared type (v2.std.node A4: a domain is a Conj of Named
// binders). Only a Named binder binds.
type ArrowDomainBinder {
  name: Symbol
  edge: Edge
}

fn arrow_domain_binders(n: Node) -> List<ArrowDomainBinder> {
  match n.kind {
    TypeNode { connective: Arrow } =>
      match arrow_first_positional_target(children: n.children) {
        FirstPositionalFound { target: domain } => conj_declared_binders(root: domain)
        FirstPositionalAbsent => []
      }
    TypeNode { connective: _ } => []
    ComputationNode { behavior: _ } => []
  }
}

fn conj_declared_binders(root: Node) -> List<ArrowDomainBinder> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: [], f: fn(acc, e) {
        match try_edge_declared_binding(e: e) {
          Present { value: b } => list_snoc_item(xs: acc, item: ArrowDomainBinder { name: b.name, edge: e })
          Absent => acc
        }
      })
    TypeNode { connective: _ } => []
    ComputationNode { behavior: _ } => []
  }
}

fn arrow_domain_binder_names(n: Node) -> List<Symbol> {
  list_map(xs: arrow_domain_binders(n: n), f: fn(b) { b.name })
}

// THE SLOT AN ARROW'S CHILD OCCUPIES, decided from the edge and its ordinal among ALL of the Arrow's
// children (resolution counts every preceding child, authored or structural, not only positional ones).
// The branches are ordered: an edge that is both a type-parameter edge and something else is a
// type-parameter edge.
type ArrowSlot
  = ArrowTypeParamsSlot
  | ArrowCarriedSlot
  | ArrowResourceRequirementsSlot
  | ArrowBodyOrNamedSlot
  | ArrowAuthoredSlot
  | ArrowDomainSlot
  | ArrowCodomainSlot

fn arrow_slot(e: Edge, ordinal: Int) -> ArrowSlot {
  match e.label {
    StructuralLabel { label: _ } =>
      if edge_is_type_params(e: e) {
        ArrowTypeParamsSlot
      } else if edge_is_core(e: e, marker: ArrowSignatureOrderEdge) {
        ArrowCarriedSlot
      } else if edge_is_core(e: e, marker: ArrowResourceRequirementsEdge) {
        ArrowResourceRequirementsSlot
      } else if arrow_named_edge_is_metadata(e: e) {
        ArrowCarriedSlot
      } else {
        ArrowBodyOrNamedSlot
      }
    Authored { name: _ } => ArrowAuthoredSlot
    Positional =>
      if ordinal == 0 {
        ArrowDomainSlot
      } else {
        ArrowCodomainSlot
      }
  }
}

// THE FRAME EACH SLOT IS WALKED UNDER, relative to the scope the Arrow was reached under. The type
// parameters bind types only, so a slot that sees them and no value parameter (the domain, the resource
// requirements) still sees every value binder that encloses the Arrow. The value parameters are visible
// in the codomain, the body and the authored edges, and in no part of the signature before them.
type ArrowSlotScope
  = SlotScopeOuter
  | SlotScopeTypeParams
  | SlotScopeParamsOverTypeParams
  | SlotScopeParamsOverOuter

fn arrow_slot_scope(slot: ArrowSlot) -> ArrowSlotScope {
  match slot {
    ArrowTypeParamsSlot => SlotScopeOuter
    ArrowCarriedSlot => SlotScopeOuter
    ArrowResourceRequirementsSlot => SlotScopeTypeParams
    ArrowDomainSlot => SlotScopeTypeParams
    ArrowCodomainSlot => SlotScopeParamsOverTypeParams
    ArrowBodyOrNamedSlot => SlotScopeParamsOverOuter
    ArrowAuthoredSlot => SlotScopeParamsOverOuter
  }
}

fn arrow_slot_scope_binds_value_params(scope: ArrowSlotScope) -> Bool {
  match scope {
    SlotScopeOuter => false
    SlotScopeTypeParams => false
    SlotScopeParamsOverTypeParams => true
    SlotScopeParamsOverOuter => true
  }
}

// ---- Bind ----------------------------------------------------------------------------------------------

// A `let`'s binder is its FIRST positional child when that child is an atom and the Bind carries its
// three positional children (binder, value, body).
type BindBinder {
  name: Symbol
  atom: Node
}

fn bind_binder(n: Node) -> Optional<BindBinder> {
  match n.kind {
    ComputationNode { behavior: Bind } =>
      if positional_child_count(children: n.children) == 3 {
        match first(positional_edges(children: n.children)) {
          Present { value: e0 } =>
            match e0.target.kind {
              TypeNode { connective: Atom { identity: sym } } => optional_present(value: BindBinder { name: sym, atom: e0.target })
              TypeNode { connective: _ } => optional_absent()
              ComputationNode { behavior: _ } => optional_absent()
            }
          Absent => optional_absent()
        }
      } else {
        optional_absent()
      }
    TypeNode { connective: _ } => optional_absent()
    ComputationNode { behavior: _ } => optional_absent()
  }
}

// THE SLOT A BIND'S POSITIONAL CHILD OCCUPIES, by its ordinal among the POSITIONAL children only: the
// type-annotation edge may stand anywhere among the children, so counting it would shift the value into
// the binder's inner scope. The binder is visible in the body and nowhere else.
type BindSlot
  = BindBinderSlot
  | BindValueSlot
  | BindBodySlot

fn bind_positional_slot(ordinal: Int) -> BindSlot {
  if ordinal == 0 {
    BindBinderSlot
  } else if ordinal == 1 {
    BindValueSlot
  } else {
    BindBodySlot
  }
}

fn bind_slot_sees_binder(slot: BindSlot) -> Bool {
  match slot {
    BindBinderSlot => false
    BindValueSlot => false
    BindBodySlot => true
  }
}

// ---- The value binders a child sees --------------------------------------------------------------------

// WHICH VALUE BINDERS EACH CHILD OF A NODE SEES, as one fact derived from the slot tables above. A walk
// that carries the value binders in scope (module acquisition's reference-site collector) asks it per child
// instead of re-deciding where an Arrow's parameters and a `let`'s binder are visible. It names the value
// binders these two constructs introduce and no others: a match arm's pattern binders, a loop's carriers and
// the type parameters of an Arrow are bound by constructs whose binder-versus-constructor or kind decision
// needs the resolution namespace, so a walk that reads only this table sees a SUBSET of the names resolution
// sees, never a superset. A name this table does not bind is therefore not known to be unbound.
type ValueFrame
  = NoValueFrame
  | ArrowValueFrame { params: List<Symbol> }
  | BindValueFrame { binder: Symbol }

fn node_value_frame(n: Node) -> ValueFrame {
  match n.kind {
    TypeNode { connective: Arrow } => ArrowValueFrame { params: arrow_domain_binder_names(n: n) }
    ComputationNode { behavior: Bind } =>
      match bind_binder(n: n) {
        Present { value: b } => BindValueFrame { binder: b.name }
        Absent => NoValueFrame
      }
    TypeNode { connective: _ } => NoValueFrame
    ComputationNode { behavior: _ } => NoValueFrame
  }
}

type ChildValueScope
  = ChildSeesParentValues
  | ChildSeesNoValues
  | ChildSeesParentValuesAnd { names: List<Symbol> }

// A TYPE-ROLE EDGE is resolved in the type scope, which holds type parameters and no value binder
// (v2.compiler.resolve resolve_type_role_target), so a child on one sees no value at all. The Arrow's
// ordinal counts ALL of its children and the Bind's counts its POSITIONAL children only, exactly as the
// slot tables above are keyed.
fn child_value_scope(frame: ValueFrame, edge: Edge, ordinal: Int, positional_ordinal: Int) -> ChildValueScope {
  if edge_is_cast_target(e: edge) || edge_is_type_annotation(e: edge) {
    ChildSeesNoValues
  } else {
    match frame {
      NoValueFrame => ChildSeesParentValues
      ArrowValueFrame { params: ps } =>
        if arrow_slot_scope_binds_value_params(scope: arrow_slot_scope(slot: arrow_slot(e: edge, ordinal: ordinal))) {
          ChildSeesParentValuesAnd { names: ps }
        } else {
          ChildSeesParentValues
        }
      BindValueFrame { binder: name } =>
        match edge.label {
          Positional =>
            if bind_slot_sees_binder(slot: bind_positional_slot(ordinal: positional_ordinal)) {
              ChildSeesParentValuesAnd { names: list_snoc_item(xs: [], item: name) }
            } else {
              ChildSeesParentValues
            }
          Authored { name: _ } => ChildSeesParentValues
          StructuralLabel { label: _ } => ChildSeesParentValues
        }
    }
  }
}

// ---- Module root ---------------------------------------------------------------------------------------

// WHAT A MODULE ROOT BINDS, as one producer. The names a module's own tree introduces at its root are the
// AUTHORED Named edges of the root Conj and of the module body the namespace graft stamped, each with the
// declaration it names (v2.compiler.symbol_index_fill indexes edge.target as that declaration). A service
// namespace the body declares is a path segment, never a bare binding, so it is not a member: its members
// stay reachable by their qualified paths. Resolution builds its root frame from this list
// (v2.compiler.resolve namespace_bindings_augment_from_module_atoms), and module acquisition reads which of
// those declarations name a value from the same list.
type ModuleRootBinding {
  name: Symbol
  declaration: Node
}

fn module_binding_edge_is_namespace_body(e: Edge) -> Bool {
  match e.label {
    Authored { name: _ } => namespace_graft_node_is_module_body(node: e.target)
    StructuralLabel { label: _ } => false
    Positional => false
  }
}

fn module_root_bindings(root: Node) -> List<ModuleRootBinding> {
  let at_root = module_node_root_bindings(root: root, acc: [])
  match namespace_graft_module_body_optional(root: root) {
    Present { value: body } => module_node_root_bindings(root: body, acc: at_root)
    Absent => at_root
  }
}

// Only a Conj root has named members to bind; every other node kind binds nothing at the module root.
fn module_node_root_bindings(root: Node, acc: List<ModuleRootBinding>) -> List<ModuleRootBinding> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: acc, f: fn(a, e) {
        if module_binding_edge_is_namespace_body(e: e) {
          a
        } else {
          match try_edge_declared_binding(e: e) {
            Present { value: b } => list_snoc_item(xs: a, item: ModuleRootBinding { name: b.name, declaration: e.target })
            Absent => a
          }
        }
      })
    TypeNode { connective: _ } => acc
    ComputationNode { behavior: _ } => acc
  }
}

// A DECLARATION NAMES A VALUE EXACTLY WHEN IT IS AN ARROW. Body lowering realizes a `data` item as the
// nullary function that returns it (v2.compiler.body_lowering_fold body_lower_data_decl_to_member), so a
// module-level value is an Arrow declaration, while a type or a namespace is not. A name bound at a module
// root whose declaration names a value is the head of a field projection exactly as a frame binder is.
fn declaration_names_value(declaration: Node) -> Bool {
  match declaration.kind {
    TypeNode { connective: Arrow } => true
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}
