module v2.test.round_trip.source_authority_debug

import v2.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree
}
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_grammar_production_mvp1_fn_add,
  dag_grammar_production_mvp1_fn_bind,
  dag_language_model_wave1,
  dag_mvp1_bind_source_text,
  dag_mvp1_source_text
}
import v2.std.diagnostic { Accepted, Rejected, port_locus }
import v2.std.grammar { GrammarRoot, grammar_empty_sync_tokens }
import v2.std.logic { Bool }

fn debug_comprep_add_parse() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: dag_mvp1_source_text,
    file: ^debug_comprep_add_source,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      let root = GrammarRoot {
        start: ^dag_production_mvp1_fn_add,
        productions: [dag_grammar_production_mvp1_fn_add()],
        sync_tokens: grammar_empty_sync_tokens()
      }
      match grammar_validate_for_parse(root: root, at: port_locus(port: ^parse_stage_locus_port)) {
        Accepted { value: validated, diagnostics: _ } =>
          match parse_production_tree(
            tokens: token_stream.tokens,
            validated: validated,
            production_name: ^dag_production_mvp1_fn_add
          ) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn debug_comprep_bind_parse() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: dag_mvp1_bind_source_text,
    file: ^debug_comprep_bind_source,
    rules: lm.lex
  ) {
    Accepted { value: token_stream, diagnostics: _ } =>
      let root = GrammarRoot {
        start: ^dag_production_mvp1_fn_bind,
        productions: [dag_grammar_production_mvp1_fn_bind()],
        sync_tokens: grammar_empty_sync_tokens()
      }
      match grammar_validate_for_parse(root: root, at: port_locus(port: ^parse_stage_locus_port)) {
        Accepted { value: validated, diagnostics: _ } =>
          match parse_production_tree(
            tokens: token_stream.tokens,
            validated: validated,
            production_name: ^dag_production_mvp1_fn_bind
          ) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
