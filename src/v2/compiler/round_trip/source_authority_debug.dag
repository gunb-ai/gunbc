module v2.test.round_trip.source_authority_debug

import v2.test.manual.emit_ingest_type_decl_round_trip {
  type_decl_perturbed_row_breaks_source_roundtrip_holds,
  type_decl_perturbed_rules_for_point_source,
  type_decl_point_source_text,
  type_decl_source_text_emit_round_trip_holds,
  type_decl_source_text_emit_round_trip_with_rules
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn debug_green() -> Bool {
  type_decl_source_text_emit_round_trip_holds(source: type_decl_point_source_text)
}

fn debug_perturb_rules_accepts() -> Bool {
  match type_decl_perturbed_rules_for_point_source() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn debug_perturb_red() -> Bool {
  type_decl_perturbed_row_breaks_source_roundtrip_holds()
}

fn debug_perturbed_roundtrip() -> Bool {
  match type_decl_perturbed_rules_for_point_source() {
    Accepted { value: rules, diagnostics: _ } =>
      type_decl_source_text_emit_round_trip_with_rules(
        rules: rules,
        source: type_decl_point_source_text
      )
    Rejected { diagnostics: _ } => false
  }
}
