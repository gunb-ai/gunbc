module v2.test.round_trip.source_authority_debug

import v2.test.manual.emit_ingest_type_decl_round_trip {
  type_decl_emit_source_text,
  type_decl_point_source_text,
  type_decl_reparse_emitted_from_source
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn debug_type_decl_source_only_roundtrip() -> Bool {
  match type_decl_reparse_emitted_from_source(source: type_decl_point_source_text) {
    Accepted { value: node, diagnostics: _ } =>
      match type_decl_emit_source_text(emitted: node) {
        Accepted { value: text, diagnostics: _ } => text == type_decl_point_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
