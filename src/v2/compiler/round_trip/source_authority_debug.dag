module v2.test.round_trip.source_authority_debug

import v2.test.complexity_gate.comprep_wave1_bind_subject_producer {
  comprep_source_bridged_bind_arrow_with_body,
  comprep_source_bridged_bind_wrong_value_arrow_with_body,
  comprep_source_resolved_bind_arrow,
  comprep_source_resolved_bind_wrong_value_arrow
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

fn debug_correct_bridged_accepts() -> Bool {
  match comprep_source_bridged_bind_arrow_with_body() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn debug_wrong_bridged_accepts() -> Bool {
  match comprep_source_bridged_bind_wrong_value_arrow_with_body() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn debug_correct_resolved_accepts() -> Bool {
  match comprep_source_resolved_bind_arrow() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn debug_wrong_resolved_accepts() -> Bool {
  match comprep_source_resolved_bind_wrong_value_arrow() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
