// Wave 3c-F FINISH-LINE-A: gate real-source round-trip on bind (non-add construct).
// GREEN: REAL parse (comprep tokenize→parse→resolve→body_producer) → emit canonical
//        matches authority serializer output (source-string equality on .carried).
// RED: naive input-text equality (emit.carried == dag_mvp1_bind_source_text) is false —
//      discriminates that equality is against canonical authority, not input echo.

module v2.test.round_trip.source_authority_contract_test

import v2.compiler.emit { emit }
import v2.compiler.infer { InferredTree }
import v2.compiler.translate { target_serialize_source_from_model }
import v2.extdeps.languages.dag {
  dag_mvp1_bind_source_text,
  dag_mvp1_bind_target_model,
  dag_mvp1_fixture_emitted_bind_fn
}
import v2.test.complexity_gate.comprep_wave1_bind_subject_producer {
  comprep_source_bridged_bind_arrow_with_body
}
import v2.test.manual.comprep_bind_round_trip {
  comprep_bind_round_trip_inferred_facts_for
}
import v2.std.collection { Map }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.compilers.target_model { TargetModel }

fn real_bind_target_model() -> TargetModel {
  dag_mvp1_bind_target_model()
}

fn inferred_tree_for_real_bind(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: fn(key) {
        comprep_bind_round_trip_inferred_facts_for(node: key)
      }
    }
  }
}

fn real_bind_emit_from_parsed_source() -> Outcome<String> {
  let target = real_bind_target_model()
  bind_outcome(
    o: comprep_source_bridged_bind_arrow_with_body(),
    f: fn(root) {
      bind_outcome(
        o: emit(tree: inferred_tree_for_real_bind(root: root), target: target),
        f: fn(source) {
          Accepted { value: source.carried, diagnostics: None }
        }
      )
    }
  )
}

fn real_bind_authority_source_text() -> Outcome<String> {
  bind_outcome(
    o: target_serialize_source_from_model(
      target: real_bind_target_model(),
      emitted: dag_mvp1_fixture_emitted_bind_fn
    ),
    f: fn(authority) {
      Accepted { value: authority.carried, diagnostics: None }
    }
  )
}

// Promoted from ungated `canonical_dag_source_parse_print_boundary_holds` — REAL parse on bind
// with canonical source-string equality; discoverable CI floor witness.
test fn canonical_dag_source_bind_parse_print_boundary_holds() -> Bool {
  match real_bind_authority_source_text() {
    Accepted { value: authority, diagnostics: _ } =>
      match real_bind_emit_from_parsed_source() {
        Accepted { value: canonical, diagnostics: _ } => canonical == authority
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// RED (discriminating): requiring emit.carried == input literal would be vacuous/wrong —
// serializer canonical text is the authority, not necessarily byte-identical to input.
fn red_naive_input_source_string_equality_fails() -> Bool {
  match real_bind_emit_from_parsed_source() {
    Accepted { value: canonical, diagnostics: _ } =>
      canonical != dag_mvp1_bind_source_text
    Rejected { diagnostics: _ } => true
  }
}

test fn canonical_dag_source_bind_real_parse_round_trip_holds() -> Bool {
  canonical_dag_source_bind_parse_print_boundary_holds()
    && red_naive_input_source_string_equality_fails()
}