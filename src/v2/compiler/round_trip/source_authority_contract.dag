// Scope: Branch H.7.2 contract visibility claim plus Branch B-min Bmin.4-Bmin.5
// canonical `.dag` source parse/print law.
// Status: shape claim; executable source-law receipts require substrate ParseTree/ResolvedTree
// equality plus a canonical `.dag` TargetModel row.

module v2.test.round_trip.source_authority_contract

import extdeps.communication.medium { Lossless, Medium }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }

import v2.compiler.source_authority {
  CanonicalDagSourceEmissionLaw,
  SourceAuthorityRoundTripLaw,
  canonical_dag_source_parse_print_law,
  source_authority_round_trip
}
import v2.std.collection { empty_map }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.compilers.lexing { VoidLexRules }
import v2.std.logic { Bool }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.compilers.target_model { TargetModel, target_model_emit_transforms_empty }
import v2.std.witness { Holds, Violates }
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}
data source_authority_contract_source: Medium<String> = Medium { carried: "", fidelity: Lossless }
data source_authority_contract_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^source_authority_contract_subject_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data source_authority_contract_target_model: TargetModel = TargetModel {
  bundle: source_authority_contract_subject,
  lex: VoidLexRules,
  binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: source_authority_contract_source.carried,
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn source_authority_contract_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^source_authority_contract_pass_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn source_authority_contract_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^source_authority_contract_fail_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn source_authority_contract_claim_input(ok: Bool) -> Node {
  if ok {
    source_authority_contract_pass_node()
  } else {
    source_authority_contract_fail_node()
  }
}

fn source_authority_round_trip_boundary_holds() -> Bool {
  match source_authority_round_trip(
    source: source_authority_contract_source,
    canonical_source_target: source_authority_contract_target_model
  ) {
    Accepted { value: witness, diagnostics: _ } =>
      match witness {
        Holds { value: _law } => true
        Violates { diagnostic: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


fn canonical_dag_source_parse_print_boundary_holds() -> Bool {
  match canonical_dag_source_parse_print_law(
    source: source_authority_contract_source,
    canonical_source_target: source_authority_contract_target_model
  ) {
    Accepted { value: witness, diagnostics: _ } =>
      match witness {
        Holds { value: _law } => true
        Violates { diagnostic: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


data claim_source_authority_contract_compiles: TestClaim = CompilesClaim {
  label: "Branch H.7.2 source-authority round-trip shape contract compiles without JSON IR authority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: source_authority_contract_claim_input(ok: source_authority_round_trip_boundary_holds()),
  expected_value: source_authority_contract_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}


data claim_bmin_canonical_dag_source_parse_print_law: TestClaim = CompilesClaim {
  label: "B-min canonical .dag source law: deterministic serializer plus normalized source-AST parse/print, excluding JSON IR",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: source_authority_contract_claim_input(ok: canonical_dag_source_parse_print_boundary_holds()),
  expected_value: source_authority_contract_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
