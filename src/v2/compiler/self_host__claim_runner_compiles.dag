
module v2.test.self_host.claim_runner_compiles

import v2.compiler.self_host {
  self_host_fixed_point_validate
}
import v2.std.diagnostic { Accepted, None }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.verification {
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  RoundTripClaim,
  manual_claim_anchor
}
data runner_compiles_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^runner_compiles_subject_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}


data claim_runner_compiles: TestClaim = CompilesClaim {
  label: "self-host fixed-point runner shape compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: runner_compiles_subject,
  expected_value: runner_compiles_subject,
  classification: TestClassification { tier: Tier1, layer: Integration }
}
