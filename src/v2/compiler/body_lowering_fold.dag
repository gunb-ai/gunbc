fn body_lower_loop_expr(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_unwrap_captured(shell: shell) {
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    v2.std.optional.Present { value: captured } =>
      match body_lower_try_loop_expr_from_captured(captured: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            v2.std.optional.Present { value: lowered } =>
              v2.std.diagnostic.Accepted { value: lowered, diagnostics: d }
            v2.std.optional.Absent =>
              v2.std.diagnostic.outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

