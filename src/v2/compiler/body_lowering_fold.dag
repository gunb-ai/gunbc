module v2.compiler.body_lowering_fold



data body_lowering_fold_note: String = "Forward body producer fold (general-body-producer Stage A remainder + B/C/D): production-identity dispatch in normalize AFTER child-fold, BEFORE sugar (body_lower_finish in 03_normalize.dag). INTERIM scaffold — dissolves into v2.compiler.body_producer_forward GrammarRelationRow forward fold (general-body-producer-design §3) once Slice 4 deletes this module; match/if/body_try hand-walker scaffolds dissolved into body_producer_forward + body_lower_fold. COMPLEMENTS #6443 fold_lowering.dag — does NOT re-fork it. Seam: fold_lowering owns fold-CALL semantic desugar (callee-head keyed: ^fold/^v2.std.algebra.fold_list/… → seam Loop via v2.compiler.fold_lowering.fold_call_to_loop); body_lowering_fold owns fn-BODY shape lowering (fn_decl→v2.std.node.Arrow+domain, infix→v2.std.node.Transform, let→Bind, …). The only overlap point is body_lower_try_fold_loop which DELEGATES to v2.compiler.fold_lowering.fold_call_to_loop — one authority, no parallel fold→Loop path. Pass-through expr wrappers unwrap; ^dag_surface_fn_body is deferred (shell retained until parent fn_decl lowers); metadata (module/import/qn) preserved; core substrate (v2.std.node.Arrow, v2.std.node.ComputationNode) is a positive terminal; out-of-scope emitted identities land wrapper-retained with typed diagnostic ^body_lowering_reason_wrapper_retained_emitted (general-body-producer-design Stage A frontier: lowered | wrapper-retained cause, counted — never silent shell accept)."

data body_lowering_fold_dissolution_contract: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "FLAG E dissolution DELETES this module — coverage lives in v2.compiler.body_producer_forward forward rows + GrammarRelationRow slot-map apply (general-body-producer-design §3). The hand-authored families (body_lower_deep_unwrap*, body_lower_operand_ref*, body_lower_operator_tail/infix*, body_lower_postfix_projection*) are receipt scaffolding only. Acceptance: this file is gone and coverage lives in forward rows + existing witnesses. match/if/body_try hand-walker scaffolds LANDED: body_lower_try_body_lowered delegates behavior productions to body_lower_fold; body_producer_forward owns the forward row table.")

data body_lowering_rejection_propagation_note: String = "GENUINE REJECTION PROPAGATES; RETENTION IS PRODUCED, NEVER INFERRED FROM FAILURE (2026-08-11). body_lower_finish_for_normalize previously matched EVERY v2.std.diagnostic.Rejected from body_lower_after_children and returned a wrapper-retained v2.std.diagnostic.Accepted instead, binding the rejection diagnostics to _ and discarding them. That conflated four different states behind one arm: this lowering strategy does not apply, this valid form has no producer yet, this form is malformed, and an invariant was violated. It is the inverse of the not-applicable-versus-malformed conflation #6558 already ruled on, moved out to the outer seam.\n\nThe repair is a deletion rather than a new mechanism, because the legitimate case was already explicit: body_lower_production_emitted's final arm returns body_lower_wrapper_retained_shell for an emitted identity with no registered producer. That IS the declared lowered | wrapper-retained frontier, produced deliberately at the point where not-applicable is known. The outer catch was therefore a second, inferential source of retention standing beside the real one, and it could only fire on outcomes the strategy functions had already judged. So retention now has exactly one producer, and the outer v2.std.diagnostic.Outcome owns genuine rejection with its diagnostics preserved through v2.std.diagnostic.rejected_with_pending.\n\nWHAT THIS DOES NOT DO: it does not scope, weaken or relocate normalize's recursive well_formed gate, which #6520 established as the sole structural wall and which stays unchanged. Modules whose retained bodies still fail that gate continue to fail it; this change only stops a real refusal from being relabelled as a counted frontier state on its way there."

data body_lowering_interim_scaffold_dissolved_note: String = "Wave 1 Gate 1 Track B: match/if/body_try interim hand-walker scaffolds dissolved into body_producer_forward (forward row table + production-identity dispatch via body_lower_fold). body_lowering_interim_scaffold_seed_retained_count is pinned at 0 — RED if any SeedRetained scaffold reappears."

data body_lowering_domain_construction_disposition_note: String = "Wave 1 Gate 1 A1/B1: param-name domain harvesting is terminal param-list-walk (declaration reading, not v2.std.symbol_index.SymbolIndex resolution). BodyLoweringDomainSymbolIndexResolved deleted in B1 — uninhabited variant with no migration trigger (operator ruling 2026-07-14)."

fn body_lowering_interim_scaffold_seed_retained_count() -> Int {
  0
}

fn body_lowering_forward_behavior_row_count() -> Int {
  v2.compiler.body_producer_forward.body_producer_forward_row_count()
}

fn body_lower_fold_behavior_surface_identities() -> List<v2.std.node.Symbol> {
  v2.compiler.body_producer_forward.body_producer_forward_surface_identities()
}

fn body_lowering_surface_identity_list_contains(xs: List<v2.std.node.Symbol>, target: v2.std.node.Symbol) -> Bool {
  fold(xs, init: false, f: fn(acc, id) { acc || id == target })
}

fn body_lowering_forward_fold_surface_identities_agree() -> Bool {
  let forward = v2.compiler.body_producer_forward.body_producer_forward_surface_identities()
  let fold_ids = body_lower_fold_behavior_surface_identities()
  if v2.std.algebra.length(xs: forward) != v2.std.algebra.length(xs: fold_ids) {
    false
  } else {
    fold(forward, init: true, f: fn(acc, id) {
      acc && body_lowering_surface_identity_list_contains(xs: fold_ids, target: id)
    })
  }
}

data body_lowering_frontier_three_state_note: String = "THE FRONTIER OBSERVER MUST SPAN THE STATE SPACE THE PRODUCER CAN REACH. It carried two arms over three reachable states, and the missing arm failed OPEN: every v2.std.diagnostic.Rejected outcome fell to the else branch and reported BodyLoweringLowered — a body that failed to lower, counted as one that lowered. That is the instrument used to measure the body-lowering gap reporting failures as successes, so every population derived through it undercounted by exactly the refusals. Reachability is not hypothetical: body_lower_finish_for_normalize propagates genuine rejection through v2.std.diagnostic.rejected_with_pending by construction (see the rejection-propagation note above), so the arm this classifier lacked is the one that repair deliberately created.\n\nRecognition also read the diagnostic HEAD alone. Retention travels through v2.std.diagnostic.diagnostics_merge and v2.std.diagnostic.rejected_with_pending, which place OUTER diagnostics first, so a retained body behind any pending diagnostic classified as Lowered — the same fail-open by a second route. It now scans the whole diagnostic list for the retained reason.\n\nRESIDUE, declared rather than closed: recognition still reads diagnostics rather than the producer returning a variant, so this is a classifier over an encoding, not a structural read. It is correct for every encoding the single retention producer (body_lower_wrapper_retained_shell) can emit, and it would be wrong if a second producer ever emitted retention differently — which is why retention keeps exactly one producer. Dissolve-on: body_lower_after_children returns BodyLoweringFrontierDisposition directly, at which point this function is the identity and disappears with the encoding."

type BodyLoweringFrontierDisposition
  = BodyLoweringLowered
  | BodyLoweringWrapperRetained { reason: v2.std.node.Symbol }
  | BodyLoweringRejected { diagnostics: v2.std.diagnostic.NonEmptyDiagnostics }

fn body_lowering_diagnostic_is_wrapper_retained(d: v2.std.diagnostic.Diagnostic) -> Bool {
  d.reason == ^body_lowering_reason_wrapper_retained_emitted
}

fn body_lowering_any_diagnostic_is_wrapper_retained(ne: v2.std.diagnostic.NonEmptyDiagnostics) -> Bool {
  v2.std.algebra.fold_list(
    xs: ne.tail,
    empty: body_lowering_diagnostic_is_wrapper_retained(d: ne.head),
    cons: fn(found, d) { found || body_lowering_diagnostic_is_wrapper_retained(d: d) }
  )
}

fn body_lowering_diagnostics_carry_wrapper_retention(d: v2.std.diagnostic.Diagnostics) -> Bool {
  match d {
    v2.std.diagnostic.None => false
    v2.std.diagnostic.Some { diagnostics: ne } => body_lowering_any_diagnostic_is_wrapper_retained(ne: ne)
  }
}

fn body_lower_outcome_is_wrapper_retained(o: v2.std.diagnostic.Outcome<v2.std.node.Node>) -> Bool {
  match o {
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } =>
      match d {
        v2.std.diagnostic.Some { diagnostics: ne } => body_lowering_any_diagnostic_is_wrapper_retained(ne: ne)
        v2.std.diagnostic.None => false
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn body_lower_outcome_frontier_disposition(o: v2.std.diagnostic.Outcome<v2.std.node.Node>) -> BodyLoweringFrontierDisposition {
  match o {
    v2.std.diagnostic.Rejected { diagnostics: r } => BodyLoweringRejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: _, diagnostics: d } =>
      match d {
        v2.std.diagnostic.Some { diagnostics: ne } =>
          if body_lowering_any_diagnostic_is_wrapper_retained(ne: ne) {
            BodyLoweringWrapperRetained { reason: ^body_lowering_reason_wrapper_retained_emitted }
          } else {
            BodyLoweringLowered
          }
        v2.std.diagnostic.None => BodyLoweringLowered
      }
  }
}

fn body_lower_seq_child(node: v2.std.node.Node, name: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.node_query.find_named_child(root: node, name: name) {
    v2.std.diagnostic.Accepted { value: child, diagnostics: _ } => v2.std.optional.Present { value: child }
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
  }
}

fn body_lower_fn_decl_ident_from_captured(captured: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  match body_lower_seq_child(node: captured, name: ^grammar_sequence_right_node_projection) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: after_kw_fn } =>
      match body_lower_seq_child(node: after_kw_fn, name: ^grammar_sequence_left_node_projection) {
        v2.std.optional.Absent => v2.std.optional.Absent
        v2.std.optional.Present { value: ident_node } =>
          match v2.extdeps.languages.dag.dag_binding_branded_atom_identity(node: ident_node) {
            v2.std.optional.Present { value: binding } => v2.std.optional.Present { value: binding }
            v2.std.optional.Absent =>
              match node_atom_identity_optional(node: ident_node) {
                v2.std.optional.Present { value: sym } =>
                  if v2.extdeps.languages.dag.dag_lex_token_symbol(sym: sym) {
                    v2.std.optional.optional_absent()
                  } else {
                    v2.std.optional.optional_present(value: sym)
                  }
                v2.std.optional.Absent => v2.std.optional.optional_absent()
              }
          }
      }
  }
}

fn body_lower_arrow_domain_named_bindings(root: v2.std.node.Node) -> List<v2.std.node.Symbol> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(root.children, init: std.algebra.Empty, f: fn(acc, e) {
        match e.label {
          v2.std.node.Named { name: sym } => std.algebra.Cons { head: sym, tail: acc }
          v2.std.node.Positional => acc
        }
      })
    _ => std.algebra.Empty
  }
}

fn body_lower_binding_symbol_lists_match(
  expected: List<v2.std.node.Symbol>,
  actual: List<v2.std.node.Symbol>
) -> Bool {
  v2.std.algebra.zip_eq(a: expected, b: actual, eq: fn(left, right) { left == right })
}

fn body_lower_param_binding_symbols_from_param_list(param_list: v2.std.node.Node) -> List<v2.std.node.Symbol> {
  match body_lower_param_list_comma_spine_optional(param_list_captured: param_list) {
    v2.std.optional.Absent => std.algebra.Empty
    v2.std.optional.Present { value: comma_spine } =>
      fold(
        body_lower_collect_param_edges(sequence_capture: comma_spine),
        init: std.algebra.Empty,
        f: fn(acc, e) {
          match e.label {
            v2.std.node.Named { name: sym } => std.algebra.Cons { head: sym, tail: acc }
            v2.std.node.Positional => acc
          }
        }
      )
  }
}

fn body_lower_param_binding_symbols_from_fn_captured(captured: v2.std.node.Node) -> List<v2.std.node.Symbol> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_param_list) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: param_list } =>
      body_lower_param_binding_symbols_from_param_list(param_list: param_list)
    v2.extdeps.languages.dag.ParseSubtreeAbsent => std.algebra.Empty
  }
}

fn body_lower_param_binding_symbols_from_fn_decl_module(root: v2.std.node.Node) -> List<v2.std.node.Symbol> {
  match body_lower_find_captured(root: root, emitted: ^dag_surface_fn_decl) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: captured } =>
      body_lower_param_binding_symbols_from_fn_captured(captured: captured)
    v2.extdeps.languages.dag.ParseSubtreeAbsent => std.algebra.Empty
  }
}

fn body_lower_arrow_domain_binding_symbols(arrow: v2.std.node.Node) -> List<v2.std.node.Symbol> {
  match count(arrow.children) >= 1 {
    true =>
      match first(arrow.children) {
        v2.std.optional.Present { value: domain_edge } =>
          body_lower_arrow_domain_named_bindings(root: domain_edge.target)
        v2.std.optional.Absent => std.algebra.Empty
      }
    false => std.algebra.Empty
  }
}

fn body_lower_arrow_domain_matches_ingest_param_bindings(
  arrow: v2.std.node.Node,
  ingest_bindings: List<v2.std.node.Symbol>
) -> Bool {
  body_lower_binding_symbol_lists_match(
    expected: ingest_bindings,
    actual: body_lower_arrow_domain_binding_symbols(arrow: arrow)
  )
}

fn body_lower_frontend_symbol_index_from_module(tree: v2.std.node.Node) -> v2.std.symbol_index.SymbolIndex {
  v2.compiler.symbol_index_fill.symbol_index_fill_module_root(index: v2.std.symbol_index.empty_symbol_index(), root: tree)
}

fn body_lower_arrow_domain_matches_frontend_symbol_index(
  arrow: v2.std.node.Node,
  module_tree: v2.std.node.Node,
  fn_name: v2.std.node.Symbol
) -> Bool {
  match v2.extdeps.languages.dag.qualified_name_from_module_node(root: module_tree) {
    v2.std.diagnostic.Accepted { value: module_qn, diagnostics: _ } =>
      let fn_path = v2.std.qualified_name.qualified_name_snoc(qn: module_qn, segment: fn_name)
      let idx = body_lower_frontend_symbol_index_from_module(tree: module_tree)
      fold(
        body_lower_arrow_domain_binding_symbols(arrow: arrow),
        init: true,
        f: fn(ok, binding) {
          if ok {
            match v2.std.symbol_index.symbol_index_lookup(
              index: idx,
              qualified_path: v2.std.qualified_name.qualified_name_snoc(qn: fn_path, segment: binding)
            ) {
              v2.std.optional.Present { value: _ } => true
              v2.std.optional.Absent => false
            }
          } else {
            false
          }
        }
      )
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn body_lower_diagnostic(reason: v2.std.node.Symbol, n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn body_lower_wrapper_retained_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  body_lower_diagnostic(reason: ^body_lowering_reason_wrapper_retained_emitted, n: n)
}

fn body_lower_canonical_type_binding_optional(sym: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  if sym == v2.extdeps.languages.dag.dag_int_type_binding() {
    v2.std.optional.optional_present(value: sym)
  } else if v2.std.compilers.lexing.symbol_lexeme(sym: sym) == "Int" {
    v2.std.optional.optional_present(value: v2.extdeps.languages.dag.dag_int_type_binding())
  } else if v2.std.compilers.lexing.symbol_lexeme(sym: sym) == "Bool" {
    v2.std.optional.optional_present(value: ^bool_node_symbol)
  } else {
    v2.std.optional.optional_absent()
  }
}

fn body_lower_resolved_type_binding(sym: v2.std.node.Symbol) -> v2.std.node.Symbol {
  match body_lower_canonical_type_binding_optional(sym: sym) {
    v2.std.optional.Present { value: canonical } => canonical
    v2.std.optional.Absent => sym
  }
}

fn body_lower_type_atom_node(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: body_lower_resolved_type_binding(sym: sym) } },
    children: []
  )
}

fn body_lower_wrapper_retained_shell(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Accepted {
    value: shell,
    diagnostics: v2.std.diagnostic.Some {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(d: body_lower_wrapper_retained_diagnostic(n: shell))
    }
  }
}

fn body_lower_is_core_substrate(node: v2.std.node.Node) -> Bool {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } => true
    v2.std.node.ComputationNode { behavior: _ } => true
    _ => false
  }
}

fn body_lower_is_pass_through_emitted(emitted: v2.std.node.Symbol) -> Bool {
  (emitted == ^dag_surface_expr)
    || (emitted == ^dag_surface_binary_expr)
    || (emitted == ^dag_surface_unary_expr)
    || (emitted == ^dag_surface_postfix_expr)
    || (emitted == ^dag_surface_block_expr)
    || (emitted == ^dag_surface_stmt)
    || (emitted == ^dag_surface_stmt_seq)
    || (emitted == ^dag_surface_arg)
}

fn body_lower_is_identity_projection_edge(edge: v2.std.node.Edge) -> Bool {
  match edge.label {
    v2.std.node.Named { name: n } => n == ^grammar_production_identity_node_projection
    v2.std.node.Positional => false
  }
}

fn body_lower_operand_fold_children_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  fold(node.children, init: v2.std.optional.Absent, f: fn(acc, e) {
    match acc {
      v2.std.optional.Present { value: _ } => acc
      v2.std.optional.Absent =>
        if body_lower_is_identity_projection_edge(edge: e) {
          v2.std.optional.Absent
        } else {
          body_lower_operand_ref_optional(node: e.target)
        }
    }
  })
}

fn body_lower_is_deferred_lower_emitted(emitted: v2.std.node.Symbol) -> Bool {
  (emitted == ^dag_surface_pattern)
    || (emitted == ^dag_surface_match_arm)
    || (emitted == ^dag_surface_match_arm_stmt_body)
}

fn body_lower_is_deferred_lower_at_normalize(emitted: v2.std.node.Symbol, under_fn_decl: Bool) -> Bool {
  if emitted == ^dag_surface_fn_body {
    under_fn_decl
  } else {
    body_lower_is_deferred_lower_emitted(emitted: emitted)
  }
}

fn body_lower_is_metadata_preserved_emitted(emitted: v2.std.node.Symbol) -> Bool {
  (emitted == ^dag_surface_module)
    || (emitted == ^dag_surface_module_header)
    || (emitted == ^dag_surface_import_decl)
    || (emitted == ^dag_surface_alias_decl)
    || (emitted == ^dag_surface_qualified_name)
    || (emitted == ^dag_surface_top_level_item)
    || (emitted == ^dag_surface_generic_params)
    || (emitted == ^dag_surface_param_list)
    || (emitted == ^dag_surface_type_expr)
    || (emitted == ^dag_surface_type_decl)
    || (emitted == ^dag_surface_data_decl)
    || (emitted == ^dag_surface_import_block)
}

fn body_lower_param_ref_atom(source: v2.std.node.Node, identity: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.node_with_occurrence_id(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: source.occurrence_id
  )
}

fn body_lower_find_captured_prunable(id: v2.std.node.Symbol) -> Bool {
  (id == ^dag_surface_module_header)
    || (id == ^dag_surface_qualified_name)
    || (id == ^dag_surface_type_expr)
}

fn body_lower_find_captured_under_children(root: v2.std.node.Node, emitted: v2.std.node.Symbol) -> v2.extdeps.languages.dag.ParseSubtreeFind {
  fold(root.children, init: v2.extdeps.languages.dag.ParseSubtreeAbsent, f: fn(acc, edge) {
    match acc {
      v2.extdeps.languages.dag.ParseSubtreeFound { captured: _ } => acc
      v2.extdeps.languages.dag.ParseSubtreeAbsent => body_lower_find_captured(root: edge.target, emitted: emitted)
    }
  })
}

fn body_lower_find_captured(root: v2.std.node.Node, emitted: v2.std.node.Symbol) -> v2.extdeps.languages.dag.ParseSubtreeFind {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: root) {
    v2.std.optional.Present { value: id } =>
      if id == emitted {
        match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: root) {
          v2.std.optional.Present { value: captured } => v2.extdeps.languages.dag.ParseSubtreeFound { captured: captured }
          v2.std.optional.Absent => body_lower_find_captured_under_children(root: root, emitted: emitted)
        }
      } else if body_lower_find_captured_prunable(id: id) {
        v2.extdeps.languages.dag.ParseSubtreeAbsent
      } else {
        body_lower_find_captured_under_children(root: root, emitted: emitted)
      }
    v2.std.optional.Absent => body_lower_find_captured_under_children(root: root, emitted: emitted)
  }
}

fn body_lower_find_production_shell_under_children(
  root: v2.std.node.Node,
  emitted: v2.std.node.Symbol
) -> v2.std.optional.Optional<v2.std.node.Node> {
  fold(root.children, init: v2.std.optional.Absent, f: fn(acc, edge) {
    match acc {
      v2.std.optional.Present { value: _ } => acc
      v2.std.optional.Absent => body_lower_find_production_shell_optional(root: edge.target, emitted: emitted)
    }
  })
}

fn body_lower_find_production_shell_optional(root: v2.std.node.Node, emitted: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: root) {
    v2.std.optional.Present { value: id } =>
      match id == emitted {
        true => v2.std.optional.Present { value: root }
        false =>
          match body_lower_find_captured_prunable(id: id) {
            true => v2.std.optional.Absent
            false => body_lower_find_production_shell_under_children(root: root, emitted: emitted)
          }
      }
    v2.std.optional.Absent =>
      body_lower_find_production_shell_under_children(root: root, emitted: emitted)
  }
}

fn body_lower_int_literal_with_magnitude_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let unwrapped = body_lower_deep_unwrap_for_int_literal(node: node)
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: unwrapped) {
    match v2.extdeps.languages.dag.dag_int_literal_magnitude_node_optional(node: unwrapped) {
      v2.std.optional.Present { value: _ } => v2.std.optional.optional_present(value: unwrapped)
      v2.std.optional.Absent => v2.std.optional.optional_absent()
    }
  } else {
    v2.std.optional.optional_absent()
  }
}

fn body_lower_operand_from_shell_optional(shell: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: shell) {
    v2.std.optional.Present { value: captured } =>
      match body_lower_try_operand_or_reject(shell: shell, captured: captured) {
        v2.std.diagnostic.Accepted { value: op, diagnostics: _ } => v2.std.optional.optional_present(value: op)
        v2.std.diagnostic.Rejected { diagnostics: _ } =>
          match body_lower_int_literal_with_magnitude_optional(node: captured) {
            v2.std.optional.Present { value: lit } => v2.std.optional.Present { value: lit }
            v2.std.optional.Absent => v2.std.optional.optional_absent()
          }
      }
    v2.std.optional.Absent =>
      match body_lower_try_operand_or_reject(shell: shell, captured: shell) {
        v2.std.diagnostic.Accepted { value: op, diagnostics: _ } => v2.std.optional.optional_present(value: op)
        v2.std.diagnostic.Rejected { diagnostics: _ } => body_lower_int_literal_with_magnitude_optional(node: shell)
      }
  }
}

fn body_lower_operand_ref_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_is_core_substrate(node: node) {
    true => v2.std.optional.Present { value: node }
    false =>
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    v2.std.optional.Present { value: _emitted } =>
      match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
        v2.std.optional.Present { value: captured } =>
          match body_lower_operand_ref_optional(node: captured) {
            v2.std.optional.Present { value: op } => v2.std.optional.Present { value: op }
            v2.std.optional.Absent => body_lower_operand_fold_children_optional(node: node)
          }
        v2.std.optional.Absent => body_lower_operand_fold_children_optional(node: node)
      }
    v2.std.optional.Absent =>
      match v2.extdeps.languages.dag.dag_binding_branded_atom_identity(node: node) {
        v2.std.optional.Present { value: binding } =>
          v2.std.optional.Present { value: body_lower_param_ref_atom(source: node, identity: binding) }
        v2.std.optional.Absent =>
          match node_atom_identity_optional(node: node) {
            v2.std.optional.Present { value: id } =>
              if v2.extdeps.languages.dag.dag_lex_token_symbol(sym: id) {
                if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                  v2.std.optional.optional_present(value: body_lower_param_ref_atom(source: node, identity: id))
                } else {
                  body_lower_int_literal_with_magnitude_optional(node: node)
                }
              } else {
                v2.std.optional.optional_present(value: body_lower_param_ref_atom(source: node, identity: id))
              }
            v2.std.optional.Absent =>
              match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: node) {
                v2.std.optional.Present { value: pair } => body_lower_operand_ref_optional(node: pair.left)
                v2.std.optional.Absent =>
                  match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
                    v2.std.optional.Present { value: captured } =>
                      body_lower_operand_ref_optional(node: captured)
                    v2.std.optional.Absent => body_lower_operand_fold_children_optional(node: node)
                  }
              }
          }
      }
  }
  }
}

fn body_lower_operator_atom_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match node_atom_identity_optional(node: node) {
    v2.std.optional.Present { value: id } =>
      if v2.extdeps.languages.dag.dag_lex_token_symbol(sym: id) {
        v2.std.optional.optional_present(
          value: v2.std.node.node_synthetic(
            kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
            children: []
          )
        )
      } else {
        v2.std.optional.optional_absent()
      }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn body_lower_unwrap_captured(shell: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  v2.extdeps.languages.dag.parse_production_captured_child_optional(node: shell)
}

fn body_lower_infix_from_operator_seq(left: v2.std.node.Node, op_seq: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: op_seq)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: pair } =>
      match body_lower_operator_atom_optional(node: pair.left) {
        v2.std.optional.Absent => v2.std.optional.Absent
        v2.std.optional.Present { value: operator } =>
          match body_lower_operand_ref_optional(node: pair.right) {
            v2.std.optional.Absent => v2.std.optional.Absent
            v2.std.optional.Present { value: right } =>
              v2.std.optional.Present {
                value: v2.std.compilers.body_lowering.lower_binary_infix(left: left, operator: operator, right: right)
              }
          }
      }
  }
}

fn body_lower_infix_from_operator_tail(left: v2.std.node.Node, tail: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: tail) {
    v2.std.optional.Present { value: pair } =>
      match body_lower_infix_from_operator_seq(left: left, op_seq: pair.left) {
        v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
        v2.std.optional.Absent => body_lower_infix_from_operator_tail(left: left, tail: pair.right)
      }
    v2.std.optional.Absent =>
      match v2.std.node_query.find_named_child(root: tail, name: ^grammar_repeat_element_node_projection) {
        v2.std.diagnostic.Accepted { value: repeat_elem, diagnostics: _ } =>
          body_lower_infix_from_repeat_element(left: left, repeat_elem: repeat_elem)
        v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
      }
  }
}

fn body_lower_infix_from_repeat_element(left: v2.std.node.Node, repeat_elem: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: pair } =>
      match body_lower_operator_atom_optional(node: pair.left) {
        v2.std.optional.Present { value: operator } =>
          match body_lower_operand_ref_optional(node: pair.right) {
            v2.std.optional.Absent => v2.std.optional.Absent
            v2.std.optional.Present { value: right } =>
              v2.std.optional.Present {
                value: v2.std.compilers.body_lowering.lower_binary_infix(left: left, operator: operator, right: right)
              }
          }
        v2.std.optional.Absent =>
          match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: pair.right) {
            v2.std.optional.Present { value: inner } =>
              match body_lower_operator_atom_optional(node: inner.left) {
                v2.std.optional.Present { value: operator } =>
                  match body_lower_operand_ref_optional(node: inner.right) {
                    v2.std.optional.Absent => v2.std.optional.Absent
                    v2.std.optional.Present { value: right } =>
                      v2.std.optional.Present {
                        value: v2.std.compilers.body_lowering.lower_binary_infix(
                          left: left,
                          operator: operator,
                          right: right
                        )
                      }
                  }
                v2.std.optional.Absent => v2.std.optional.Absent
              }
            v2.std.optional.Absent => v2.std.optional.Absent
          }
      }
  }
}

fn body_lower_try_infix_from_sequence(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: pair } =>
      match body_lower_operand_ref_optional(node: pair.left) {
        v2.std.optional.Absent => v2.std.optional.Absent
        v2.std.optional.Present { value: left } =>
          body_lower_infix_from_operator_tail(left: left, tail: pair.right)
      }
  }
}

fn body_lower_try_infix_transform(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match body_lower_try_infix_from_sequence(node: stripped) {
    v2.std.optional.Present { value: transform } => v2.std.optional.Present { value: transform }
    v2.std.optional.Absent =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
        v2.std.optional.Present { value: pair } =>
          match body_lower_try_infix_transform(node: pair.left) {
            v2.std.optional.Present { value: transform } => v2.std.optional.Present { value: transform }
            v2.std.optional.Absent => body_lower_try_infix_transform(node: pair.right)
          }
        v2.std.optional.Absent =>
          match v2.std.node_query.find_named_child(root: stripped, name: ^grammar_repeat_element_node_projection) {
            v2.std.diagnostic.Accepted { value: repeat_elem, diagnostics: _ } =>
              match body_lower_try_infix_transform(node: repeat_elem) {
                v2.std.optional.Present { value: transform } => v2.std.optional.Present { value: transform }
                v2.std.optional.Absent =>
                  match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: stripped) {
                    v2.std.optional.Present { value: captured } =>
                      body_lower_try_infix_transform(node: captured)
                    v2.std.optional.Absent =>
                      fold(stripped.children, init: v2.std.optional.Absent, f: fn(acc, e) {
                        match acc {
                          v2.std.optional.Present { value: _ } => acc
                          v2.std.optional.Absent => body_lower_try_infix_transform(node: e.target)
                        }
                      })
                  }
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } =>
              match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: stripped) {
                v2.std.optional.Present { value: captured } => body_lower_try_infix_transform(node: captured)
                v2.std.optional.Absent =>
                  fold(stripped.children, init: v2.std.optional.Absent, f: fn(acc, e) {
                    match acc {
                      v2.std.optional.Present { value: _ } => acc
                      v2.std.optional.Absent => body_lower_try_infix_transform(node: e.target)
                    }
                  })
              }
          }
      }
  }
}

fn body_lower_try_fold_loop_search(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    v2.std.optional.Present { value: id } =>
      if id == ^dag_surface_primary_expr {
        match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
          v2.std.optional.Present { value: captured } => body_lower_try_fold_loop(node: captured)
          v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: id) {
        match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
          v2.std.optional.Present { value: captured } => body_lower_try_fold_loop(node: captured)
          v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        }
      } else {
        v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
      }
    v2.std.optional.Absent =>
      fold(node.children, init: v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent()), f: fn(acc, e) {
        match acc {
          v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          v2.std.diagnostic.Accepted { value: found, diagnostics: _ } =>
            match found {
              v2.std.optional.Present { value: _ } => acc
              v2.std.optional.Absent => body_lower_try_fold_loop(node: e.target)
            }
        }
      })
  }
}

fn body_lower_try_fold_loop(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match v2.compiler.fold_lowering.fold_call_head_symbol(fold_call: node) {
    v2.std.optional.Present { value: head } =>
      if v2.compiler.fold_lowering.fold_family_head(sym: head) {
        match v2.compiler.fold_lowering.fold_call_to_loop(fold_call: node) {
          v2.std.diagnostic.Accepted { value: loop_node, diagnostics: _ } =>
            v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_present(value: loop_node))
          v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        }
      } else {
        body_lower_try_fold_loop_search(node: node)
      }
    v2.std.optional.Absent => body_lower_try_fold_loop_search(node: node)
  }
}

fn body_lower_type_atom_from_expr(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    v2.std.optional.Present { value: id } =>
      if id == ^dag_surface_type_expr {
        match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
          v2.std.optional.Present { value: captured } => body_lower_type_atom_from_expr(node: captured)
          v2.std.optional.Absent => v2.std.optional.optional_absent()
        }
      } else if id == ^dag_surface_qualified_name {
        match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
          v2.std.optional.Present { value: captured } =>
            match node_atom_identity_optional(node: captured) {
              v2.std.optional.Present { value: sym } =>
                v2.std.optional.optional_present(value: body_lower_type_atom_node(sym: sym))
              v2.std.optional.Absent => body_lower_type_atom_from_expr(node: captured)
            }
          v2.std.optional.Absent => v2.std.optional.optional_absent()
        }
      } else {
        v2.std.optional.Absent
      }
    v2.std.optional.Absent =>
      match v2.extdeps.languages.dag.dag_binding_branded_atom_identity(node: node) {
        v2.std.optional.Present { value: binding } =>
          v2.std.optional.Present { value: body_lower_type_atom_node(sym: binding) }
        v2.std.optional.Absent =>
          match node_atom_identity_optional(node: node) {
            v2.std.optional.Present { value: sym } =>
              if v2.extdeps.languages.dag.dag_lex_token_symbol(sym: sym) {
                v2.std.optional.optional_absent()
              } else {
                v2.std.optional.optional_present(value: body_lower_type_atom_node(sym: sym))
              }
            v2.std.optional.Absent =>
              match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: node) {
                v2.std.optional.Present { value: pair } =>
                  match body_lower_type_atom_from_expr(node: pair.left) {
                    v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                    v2.std.optional.Absent => body_lower_type_atom_from_expr(node: pair.right)
                  }
                v2.std.optional.Absent =>
                  fold(node.children, init: v2.std.optional.Absent, f: fn(acc, e) {
                    match acc {
                      v2.std.optional.Present { value: _ } => acc
                      v2.std.optional.Absent => body_lower_type_atom_from_expr(node: e.target)
                    }
                  })
              }
          }
      }
  }
}

fn body_lower_unwrap_surface_shell(node: v2.std.node.Node) -> v2.std.node.Node {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    v2.std.optional.Present { value: emitted } =>
      if body_lower_is_pass_through_emitted(emitted: emitted) {
        match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
          v2.std.optional.Present { value: captured } => body_lower_unwrap_surface_shell(node: captured)
          v2.std.optional.Absent => node
        }
      } else {
        node
      }
    v2.std.optional.Absent => node
  }
}

fn body_lower_after_comma_tail_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: node) {
    v2.std.optional.Absent => v2.std.optional.optional_absent()
    v2.std.optional.Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        v2.std.optional.Present { value: id } =>
          if id == ^dag_token_comma {
            v2.std.optional.optional_present(value: pair.right)
          } else {
            v2.std.optional.optional_absent()
          }
        v2.std.optional.Absent => v2.std.optional.optional_absent()
      }
  }
}

fn body_lower_typed_param_from_comma_seq(sequence_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Edge> {
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: sequence_capture) {
    v2.std.optional.Present { value: pair } =>
      match body_lower_typed_param_edge(param_capture: pair.right) {
        v2.std.optional.Present { value: edge } => v2.std.optional.Present { value: edge }
        v2.std.optional.Absent => body_lower_typed_param_edge(param_capture: pair.left)
      }
    v2.std.optional.Absent => body_lower_typed_param_edge(param_capture: sequence_capture)
  }
}

fn body_lower_collect_param_edges_from_repeat_tail(repeat_capture: v2.std.node.Node) -> List<v2.std.node.Edge> {
  if v2.std.node.is_empty_conj_root(n: repeat_capture) {
    std.algebra.Empty
  } else {
    match v2.std.node_query.find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      v2.std.diagnostic.Accepted { value: head_sequence, diagnostics: _ } =>
        match body_lower_typed_param_from_comma_seq(sequence_capture: head_sequence) {
          v2.std.optional.Present { value: edge } =>
            match v2.std.node_query.find_named_child(
              root: repeat_capture,
              name: ^grammar_sequence_right_node_projection
            ) {
              v2.std.diagnostic.Accepted { value: tail, diagnostics: _ } =>
                v2.std.algebra.list_append(
                  left: [edge],
                  right: body_lower_collect_param_edges_from_repeat_tail(repeat_capture: tail)
                )
              v2.std.diagnostic.Rejected { diagnostics: _ } => [edge]
            }
          v2.std.optional.Absent =>
            match v2.std.node_query.find_named_child(
              root: repeat_capture,
              name: ^grammar_sequence_right_node_projection
            ) {
              v2.std.diagnostic.Accepted { value: tail, diagnostics: _ } =>
                body_lower_collect_param_edges_from_repeat_tail(repeat_capture: tail)
              v2.std.diagnostic.Rejected { diagnostics: _ } => std.algebra.Empty
            }
        }
      v2.std.diagnostic.Rejected { diagnostics: _ } => std.algebra.Empty
    }
  }
}

fn body_lower_collect_param_edges(sequence_capture: v2.std.node.Node) -> List<v2.std.node.Edge> {
  match v2.std.node_query.find_named_child(root: sequence_capture, name: ^grammar_sequence_left_node_projection) {
    v2.std.diagnostic.Accepted { value: first, diagnostics: _ } =>
      let first_edges = match body_lower_typed_param_edge(param_capture: first) {
        v2.std.optional.Present { value: edge } => [edge]
        v2.std.optional.Absent => std.algebra.Empty
      }
      match v2.std.node_query.find_named_child(root: sequence_capture, name: ^grammar_sequence_right_node_projection) {
        v2.std.diagnostic.Accepted { value: outer_right, diagnostics: _ } =>
          match v2.std.node_query.find_named_child(root: outer_right, name: ^grammar_sequence_left_node_projection) {
            v2.std.diagnostic.Accepted { value: repeat_capture, diagnostics: _ } =>
              v2.std.algebra.list_append(
                left: first_edges,
                right: body_lower_collect_param_edges_from_repeat_tail(
                  repeat_capture: repeat_capture
                )
              )
            v2.std.diagnostic.Rejected { diagnostics: _ } => first_edges
          }
        v2.std.diagnostic.Rejected { diagnostics: _ } => first_edges
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      match body_lower_typed_param_edge(param_capture: sequence_capture) {
        v2.std.optional.Present { value: edge } => [edge]
        v2.std.optional.Absent =>
          match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: sequence_capture) {
            v2.std.optional.Absent => std.algebra.Empty
            v2.std.optional.Present { value: pair } =>
              match body_lower_typed_param_edge(param_capture: pair.left) {
                v2.std.optional.Present { value: edge } =>
                  match body_lower_after_comma_tail_optional(node: pair.right) {
                    v2.std.optional.Present { value: tail } =>
                      v2.std.algebra.list_append(
                        left: [edge],
                        right: body_lower_collect_param_edges(sequence_capture: tail)
                      )
                    v2.std.optional.Absent => [edge]
                  }
                v2.std.optional.Absent =>
                  match body_lower_after_comma_tail_optional(node: pair.right) {
                    v2.std.optional.Present { value: tail } => body_lower_collect_param_edges(sequence_capture: tail)
                    v2.std.optional.Absent => std.algebra.Empty
                  }
              }
          }
      }
  }
}

fn body_lower_param_binding_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  match v2.extdeps.languages.dag.dag_binding_branded_atom_identity(node: node) {
    v2.std.optional.Present { value: binding } => v2.std.optional.Present { value: binding }
    v2.std.optional.Absent =>
      match node_atom_identity_optional(node: node) {
        v2.std.optional.Present { value: sym } =>
          if v2.extdeps.languages.dag.dag_lex_token_symbol(sym: sym) {
            v2.std.optional.optional_absent()
          } else {
            v2.std.optional.optional_present(value: sym)
          }
        v2.std.optional.Absent =>
          match body_lower_operand_ref_optional(node: node) {
            v2.std.optional.Present { value: ref_node } =>
              match node_atom_identity_optional(node: ref_node) {
                v2.std.optional.Present { value: sym } => v2.std.optional.optional_present(value: sym)
                v2.std.optional.Absent => v2.std.optional.optional_absent()
              }
            v2.std.optional.Absent => v2.std.optional.optional_absent()
          }
      }
  }
}

fn body_lower_typed_param_edge(param_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Edge> {
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: param_capture) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        v2.std.optional.Absent => v2.std.optional.Absent
        v2.std.optional.Present { value: binding } =>
          match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: pair.right) {
            v2.std.optional.Absent => v2.std.optional.Absent
            v2.std.optional.Present { value: after_colon } =>
              match body_lower_type_atom_from_expr(node: after_colon.right) {
                v2.std.optional.Absent => v2.std.optional.Absent
                v2.std.optional.Present { value: type_node } =>
                  v2.std.optional.Present {
                    value: v2.std.node.Edge {
                      label: v2.std.node.Named { name: binding },
                      target: type_node
                    }
                  }
              }
          }
      }
  }
}

fn body_lower_deep_unwrap_optional(node: v2.std.node.Node) -> v2.std.node.Node {
  match v2.std.node_query.find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    v2.std.diagnostic.Accepted { value: child, diagnostics: _ } =>
      body_lower_deep_unwrap_optional(node: child)
    v2.std.diagnostic.Rejected { diagnostics: _ } => node
  }
}

fn body_lower_deep_unwrap_for_int_literal(node: v2.std.node.Node) -> v2.std.node.Node {
  match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
    v2.std.optional.Present { value: captured } =>
      body_lower_deep_unwrap_for_int_literal(node: captured)
    v2.std.optional.Absent => body_lower_deep_unwrap_optional(node: node)
  }
}

fn body_lower_unwrap_optional_element(node: v2.std.node.Node) -> v2.std.node.Node {
  match v2.std.node_query.find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    v2.std.diagnostic.Accepted { value: child, diagnostics: _ } => child
    v2.std.diagnostic.Rejected { diagnostics: _ } => node
  }
}

fn body_lower_param_list_comma_spine_optional(param_list_captured: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: param_list_captured) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: pair } =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: pair.right) {
        v2.std.optional.Absent => v2.std.optional.Absent
        v2.std.optional.Present { value: inner } =>
          v2.std.optional.Present {
            value: body_lower_unwrap_optional_element(node: inner.left)
          }
      }
  }
}

fn body_lower_type_atom_from_arrow_seq_right(right: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_find_captured(
    root: right,
    emitted: ^dag_surface_type_expr
  ) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: type_expr } =>
      body_lower_type_atom_from_expr(node: type_expr)
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: right) {
        v2.std.optional.Present { value: emitted } =>
          match emitted == ^dag_surface_type_expr {
            true =>
              match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: right) {
                v2.std.optional.Present { value: captured } =>
                  body_lower_type_atom_from_expr(node: captured)
                v2.std.optional.Absent => v2.std.optional.Absent
              }
            false => v2.std.optional.Absent
          }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
  }
}

fn body_lower_arrow_seq_return_type(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.node_query.find_named_child(root: node, name: ^grammar_sequence_left_node_projection) {
    v2.std.diagnostic.Accepted { value: left, diagnostics: _ } =>
      match body_lower_sequence_head_is_arrow(node: left) {
        true =>
          match v2.std.node_query.find_named_child(root: node, name: ^grammar_sequence_right_node_projection) {
            v2.std.diagnostic.Accepted { value: right, diagnostics: _ } =>
              body_lower_type_atom_from_arrow_seq_right(right: right)
            v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
          }
        false => v2.std.optional.Absent
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
  }
}

fn body_lower_return_type_after_arrow_walk(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  match body_lower_arrow_seq_return_type(node: stripped) {
    v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
    v2.std.optional.Absent =>
      match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: stripped) {
        v2.std.optional.Present { value: captured } =>
          match body_lower_return_type_after_arrow_walk(node: captured) {
            v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
            v2.std.optional.Absent =>
              fold(stripped.children, init: v2.std.optional.Absent, f: fn(acc, e) {
                match acc {
                  v2.std.optional.Present { value: _ } => acc
                  v2.std.optional.Absent => body_lower_return_type_after_arrow_walk(node: e.target)
                }
              })
          }
        v2.std.optional.Absent =>
          fold(stripped.children, init: v2.std.optional.Absent, f: fn(acc, e) {
            match acc {
              v2.std.optional.Present { value: _ } => acc
              v2.std.optional.Absent => body_lower_return_type_after_arrow_walk(node: e.target)
            }
          })
      }
  }
}

fn body_lower_domain_from_param_list(param_list: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_param_list_comma_spine_optional(param_list_captured: param_list) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: comma_spine } =>
      let edges = body_lower_collect_param_edges(sequence_capture: comma_spine)
      if count(edges) == 0 {
        v2.std.optional.Present {
          value: v2.std.node.node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Conj }, children: [])
        }
      } else {
        v2.std.optional.Present {
          value: v2.std.node.node_synthetic(
            kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
            children: edges
          )
        }
      }
  }
}

fn body_lower_sequence_head_is_arrow(node: v2.std.node.Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    v2.std.optional.Present { value: id } => id == ^dag_token_arrow
    v2.std.optional.Absent =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: node) {
        v2.std.optional.Present { value: pair } => body_lower_sequence_head_is_arrow(node: pair.left)
        v2.std.optional.Absent => false
      }
  }
}

fn body_lower_type_expr_after_arrow(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: node) {
    v2.std.optional.Present { value: pair } =>
      if body_lower_sequence_head_is_arrow(node: pair.left) {
        match body_lower_find_captured(
          root: pair.right,
          emitted: ^dag_surface_type_expr
        ) {
          v2.extdeps.languages.dag.ParseSubtreeFound { captured: type_expr } => v2.std.optional.Present { value: type_expr }
          v2.extdeps.languages.dag.ParseSubtreeAbsent =>
            match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: pair.right) {
              v2.std.optional.Present { value: after_arrow } =>
                match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: after_arrow.left) {
                  v2.std.optional.Present { value: emitted } =>
                    if emitted == ^dag_surface_type_expr {
                      v2.std.optional.optional_present(value: after_arrow.left)
                    } else {
                      body_lower_type_expr_after_arrow(node: pair.right)
                    }
                  v2.std.optional.Absent => body_lower_type_expr_after_arrow(node: pair.right)
                }
              v2.std.optional.Absent => v2.std.optional.Absent
            }
        }
      } else {
        match body_lower_type_expr_after_arrow(node: pair.left) {
          v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
          v2.std.optional.Absent => body_lower_type_expr_after_arrow(node: pair.right)
        }
      }
    v2.std.optional.Absent =>
      match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
        v2.std.optional.Present { value: _ } =>
          match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: node) {
            v2.std.optional.Present { value: captured } => body_lower_type_expr_after_arrow(node: captured)
            v2.std.optional.Absent => v2.std.optional.Absent
          }
        v2.std.optional.Absent =>
          fold(node.children, init: v2.std.optional.Absent, f: fn(acc, e) {
            match acc {
              v2.std.optional.Present { value: _ } => acc
              v2.std.optional.Absent => body_lower_type_expr_after_arrow(node: e.target)
            }
          })
      }
  }
}

fn body_lower_return_type_from_fn_captured(captured: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  body_lower_return_type_after_arrow_walk(node: captured)
}

fn body_lower_find_core_substrate_optional(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  if body_lower_is_core_substrate(node: root) {
    v2.std.optional.optional_present(value: root)
  } else {
    fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent => body_lower_find_core_substrate_optional(root: e.target)
      }
    })
  }
}

fn body_lower_try_fold_behavior_optional(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_fold(node: node) {
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: folded, diagnostics: fd } =>
      if body_lower_is_core_substrate(node: folded) {
        outcome_with_diagnostics(value: v2.std.optional.optional_present(value: folded), diagnostics: fd)
      } else {
        outcome_with_diagnostics(value: v2.std.optional.optional_absent(), diagnostics: fd)
      }
  }
}

fn body_lower_try_body_lowered(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  if body_lower_is_core_substrate(node: node) {
    v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_present(value: node))
  } else {
    match body_lower_try_fold_behavior_optional(node: node) {
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      v2.std.diagnostic.Accepted { value: fold_found, diagnostics: fd } =>
        match fold_found {
          v2.std.optional.Present { value: lowered } =>
            outcome_with_diagnostics(value: v2.std.optional.optional_present(value: lowered), diagnostics: fd)
          v2.std.optional.Absent =>
                    match body_lower_try_let_in_from_node(node: node) {
                      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                      v2.std.diagnostic.Accepted { value: let_found, diagnostics: ld } =>
                        match let_found {
                          v2.std.optional.Present { value: lowered } =>
                            outcome_with_diagnostics(
                              value: v2.std.optional.optional_present(value: lowered),
                              diagnostics: ld
                            )
                          v2.std.optional.Absent =>
                            match body_lower_try_loop_expr_from_node(node: node) {
                              v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                              v2.std.diagnostic.Accepted { value: loop_found, diagnostics: lcd } =>
                                match loop_found {
                                  v2.std.optional.Present { value: lowered } =>
                                    outcome_with_diagnostics(
                                      value: v2.std.optional.optional_present(value: lowered),
                                      diagnostics: lcd
                                    )
                                  v2.std.optional.Absent =>
                        match body_lower_try_fold_loop(node: node) {
                          v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                          v2.std.diagnostic.Accepted { value: fold_result, diagnostics: fd } =>
                            match fold_result {
                              v2.std.optional.Present { value: lowered } =>
                                outcome_with_diagnostics(
                                  value: v2.std.optional.optional_present(value: lowered),
                                  diagnostics: fd
                                )
                              v2.std.optional.Absent =>
                        match body_lower_try_primary_ident_call(node: node) {
                          v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                          v2.std.diagnostic.Accepted { value: primary_call, diagnostics: pcd } =>
                            match primary_call {
                              v2.std.optional.Present { value: lowered } =>
                                outcome_with_diagnostics(
                                  value: v2.std.optional.optional_present(value: lowered),
                                  diagnostics: pcd
                                )
                              v2.std.optional.Absent =>
                                match body_lower_try_postfix_projection(node: node) {
                                  v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                                  v2.std.diagnostic.Accepted { value: projection, diagnostics: pd } =>
                                    match projection {
                                      v2.std.optional.Present { value: lowered } =>
                                        outcome_with_diagnostics(
                                          value: v2.std.optional.optional_present(value: lowered),
                                          diagnostics: pd
                                        )
                                      v2.std.optional.Absent =>
                                        match body_lower_try_infix_transform(node: node) {
                                          v2.std.optional.Present { value: lowered } =>
                                            v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_present(value: lowered))
                                          v2.std.optional.Absent =>
                                                    let stripped = body_lower_unwrap_surface_shell(node: node)
                                                    match body_lower_try_postfix_projection(node: stripped) {
                                                      v2.std.diagnostic.Rejected { diagnostics: r } =>
                                                        v2.std.diagnostic.Rejected { diagnostics: r }
                                                      v2.std.diagnostic.Accepted { value: stripped_proj, diagnostics: spd } =>
                                                        match stripped_proj {
                                                          v2.std.optional.Present { value: lowered } =>
                                                            outcome_with_diagnostics(
                                                              value: v2.std.optional.optional_present(value: lowered),
                                                              diagnostics: spd
                                                            )
                                                          v2.std.optional.Absent =>
                                                            match body_lower_try_fold_loop(node: stripped) {
                                                              v2.std.diagnostic.Rejected { diagnostics: r } =>
                                                                v2.std.diagnostic.Rejected { diagnostics: r }
                                                              v2.std.diagnostic.Accepted { value: stripped_fold, diagnostics: sfd } =>
                                                                match stripped_fold {
                                                                  v2.std.optional.Present { value: lowered } =>
                                                                    outcome_with_diagnostics(
                                                                      value: v2.std.optional.optional_present(value: lowered),
                                                                      diagnostics: sfd
                                                                    )
                                                                  v2.std.optional.Absent =>
                                                            match body_lower_try_primary_ident_call(node: stripped) {
                                                              v2.std.diagnostic.Rejected { diagnostics: r } =>
                                                                v2.std.diagnostic.Rejected { diagnostics: r }
                                                              v2.std.diagnostic.Accepted { value: stripped_call, diagnostics: scd } =>
                                                                match stripped_call {
                                                                  v2.std.optional.Present { value: lowered } =>
                                                                    outcome_with_diagnostics(
                                                                      value: v2.std.optional.optional_present(value: lowered),
                                                                      diagnostics: scd
                                                                    )
                                                                  v2.std.optional.Absent =>
                                                                    match body_lower_try_infix_transform(node: stripped) {
                                                                      v2.std.optional.Present { value: lowered } =>
                                                                        v2.std.diagnostic.outcome_accepted(
                                                                          value: v2.std.optional.optional_present(value: lowered)
                                                                        )
                                                                      v2.std.optional.Absent =>
                                                                        v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
                                                                    }
                                                                }
                                                            }
                                                            }
                                                        }
                                                    }
                                                }
                                        }
                                    }
                                }
                            }
                        }
                            }
                          }
                        }
                    }
                }
            }
        }
    }
  }
}

fn body_lower_reduce_passthrough(folded: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: folded) {
    v2.std.optional.Present { value: child } => v2.std.diagnostic.outcome_accepted(value: child)
    v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: folded)
  }
}

fn body_lower_reduce_or_keep(o: v2.std.diagnostic.Outcome<v2.std.node.Node>, folded: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match o {
    v2.std.diagnostic.Accepted { value: v, diagnostics: d } => v2.std.diagnostic.Accepted { value: v, diagnostics: d }
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.rejected_with_pending(pending: v2.std.diagnostic.None, rejected: r) }
  }
}

fn body_lower_reduce_emitted(folded: v2.std.node.Node, emitted: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
    v2.std.diagnostic.outcome_accepted(value: folded)
  } else if emitted == ^dag_surface_binary_expr {
    match body_lower_try_infix_transform(node: folded) {
      v2.std.optional.Present { value: transform } => v2.std.diagnostic.outcome_accepted(value: transform)
      v2.std.optional.Absent => body_lower_reduce_passthrough(folded: folded)
    }
  } else if emitted == ^dag_surface_postfix_expr {
    body_lower_reduce_or_keep(o: body_lower_postfix_expr(shell: folded), folded: folded)
  } else if emitted == ^dag_surface_primary_expr {
    body_lower_reduce_or_keep(o: body_lower_primary_expr(shell: folded), folded: folded)
  } else if body_lower_is_pass_through_emitted(emitted: emitted) {
    body_lower_reduce_passthrough(folded: folded)
  } else if emitted == ^dag_surface_fn_decl {
    body_lower_reduce_or_keep(o: body_lower_fn_decl_to_arrow(shell: folded), folded: folded)
  } else {
    v2.std.diagnostic.outcome_accepted(value: folded)
  }
}

fn body_lower_reduce(folded: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if body_lower_is_core_substrate(node: folded) {
    v2.std.diagnostic.outcome_accepted(value: folded)
  } else if v2.extdeps.languages.dag.dag_resolve_preserve_module_metadata_subtree(node: folded) {
    v2.std.diagnostic.outcome_accepted(value: folded)
  } else {
    match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: folded) {
      v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: folded)
      v2.std.optional.Present { value: emitted } => body_lower_reduce_emitted(folded: folded, emitted: emitted)
    }
  }
}

fn body_lower_fold_children(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  fold(node.children, init: v2.std.diagnostic.outcome_accepted(value: v2.std.node.node_rebuild(n: node, children: [])), f: fn(acc, e) {
    match acc {
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      v2.std.diagnostic.Accepted { value: shell, diagnostics: ad } =>
        match body_lower_fold(node: e.target) {
          v2.std.diagnostic.Rejected { diagnostics: cr } =>
            v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: cr) }
          v2.std.diagnostic.Accepted { value: child, diagnostics: cd } =>
            v2.std.diagnostic.Accepted {
              value: v2.std.node.node_rebuild(
                n: shell,
                children: v2.std.algebra.list_snoc_item(xs: shell.children, item: v2.std.node.Edge { label: e.label, target: child })
              ),
              diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: cd)
            }
        }
    }
  })
}

fn body_lower_fold_identity_absent(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if body_lower_match_capture_heads_spine(
    spine: body_lower_unwrap_surface_shell(node: node)
  ) {
    match body_lower_try_match_from_captured(captured: node) {
      v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      v2.std.diagnostic.Accepted { value: lowered_opt, diagnostics: d } =>
        match lowered_opt {
          v2.std.optional.Present { value: lowered } => v2.std.diagnostic.Accepted { value: lowered, diagnostics: d }
          v2.std.optional.Absent => body_lower_fold_reduce(node: node)
        }
    }
  } else {
    body_lower_fold_reduce(node: node)
  }
}

fn body_lower_fold(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if body_lower_is_core_substrate(node: node) {
    v2.std.diagnostic.outcome_accepted(value: node)
  } else {
    match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
      v2.std.optional.Present { value: emitted } =>
        if emitted == ^dag_surface_match_expr {
          body_lower_match_expr(shell: node)
        } else if emitted == ^dag_surface_if_expr {
          body_lower_if_expr(shell: node)
        } else if emitted == ^dag_surface_loop_expr {
          body_lower_loop_expr(shell: node)
        } else if emitted == ^dag_surface_let_expr {
          body_lower_let_expr(shell: node)
        } else if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
          v2.std.diagnostic.outcome_accepted(value: node)
        } else if body_lower_is_deferred_lower_emitted(emitted: emitted) {
          v2.std.diagnostic.outcome_accepted(value: node)
        } else {
          body_lower_fold_reduce(node: node)
        }
      v2.std.optional.Absent => body_lower_fold_identity_absent(node: node)
    }
  }
}

fn body_lower_fold_reduce(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_fold_children(node: node) {
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: folded, diagnostics: d } =>
      match body_lower_reduce(folded: folded) {
        v2.std.diagnostic.Rejected { diagnostics: r } =>
          v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.rejected_with_pending(pending: d, rejected: r) }
        v2.std.diagnostic.Accepted { value: reduced, diagnostics: rd } =>
          v2.std.diagnostic.Accepted { value: reduced, diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d, inner: rd) }
      }
  }
}

fn body_lower_body_subtree_lower_from_primary(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_primary_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: primary } =>
      match body_lower_primary_expr(shell: primary) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: lowered, diagnostics: d } =>
          outcome_with_diagnostics(
            value: v2.std.optional.optional_present(value: lowered),
            diagnostics: d
          )
      }
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_stmt) {
        v2.extdeps.languages.dag.ParseSubtreeFound { captured: stmt } =>
          body_lower_body_subtree_lower(captured: stmt)
        v2.extdeps.languages.dag.ParseSubtreeAbsent =>
          match body_lower_find_core_substrate_optional(root: captured) {
            v2.std.optional.Present { value: lowered } =>
              v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_present(value: lowered))
            v2.std.optional.Absent =>
              body_lower_try_body_lowered(
                node: body_lower_unwrap_surface_shell(node: captured)
              )
          }
      }
  }
}

fn body_lower_body_subtree_lower_from_postfix(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_postfix_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: postfix } =>
      match body_lower_try_body_lowered(node: postfix) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: found, diagnostics: d } =>
          match found {
            v2.std.optional.Present { value: lowered } =>
              outcome_with_diagnostics(
                value: v2.std.optional.optional_present(value: lowered),
                diagnostics: d
              )
            v2.std.optional.Absent => body_lower_body_subtree_lower_from_primary(captured: captured)
          }
      }
    v2.extdeps.languages.dag.ParseSubtreeAbsent => body_lower_body_subtree_lower_from_primary(captured: captured)
  }
}

fn body_lower_body_subtree_lower_from_expr(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: expr } =>
      match body_lower_try_body_lowered(node: expr) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: found, diagnostics: d } =>
          match found {
            v2.std.optional.Present { value: lowered } =>
              outcome_with_diagnostics(
                value: v2.std.optional.optional_present(value: lowered),
                diagnostics: d
              )
            v2.std.optional.Absent => body_lower_body_subtree_lower_from_postfix(captured: captured)
          }
      }
    v2.extdeps.languages.dag.ParseSubtreeAbsent => body_lower_body_subtree_lower_from_postfix(captured: captured)
  }
}

fn body_lower_body_subtree_lower_from_binary(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_binary_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: binary } =>
      match body_lower_try_body_lowered(node: binary) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: found, diagnostics: d } =>
          match found {
            v2.std.optional.Present { value: lowered } =>
              outcome_with_diagnostics(
                value: v2.std.optional.optional_present(value: lowered),
                diagnostics: d
              )
            v2.std.optional.Absent => body_lower_body_subtree_lower_from_expr(captured: captured)
          }
      }
    v2.extdeps.languages.dag.ParseSubtreeAbsent => body_lower_body_subtree_lower_from_expr(captured: captured)
  }
}

fn body_lower_body_subtree_lower(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_try_body_lowered(node: captured) {
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: found, diagnostics: _ } =>
      match found {
        v2.std.optional.Present { value: lowered } => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_present(value: lowered))
        v2.std.optional.Absent =>
          match body_lower_find_captured(
            root: captured,
            emitted: ^dag_surface_if_expr
          ) {
            v2.extdeps.languages.dag.ParseSubtreeFound { captured: if_capture } =>
              body_lower_try_if_from_captured(captured: if_capture)
            v2.extdeps.languages.dag.ParseSubtreeAbsent =>
          match body_lower_find_captured(
            root: captured,
            emitted: ^dag_surface_match_expr
          ) {
            v2.extdeps.languages.dag.ParseSubtreeFound { captured: match_capture } =>
              body_lower_try_match_from_captured(captured: match_capture)
            v2.extdeps.languages.dag.ParseSubtreeAbsent =>
          match body_lower_find_captured(
            root: captured,
            emitted: ^dag_surface_loop_expr
          ) {
            v2.extdeps.languages.dag.ParseSubtreeFound { captured: loop_capture } =>
              body_lower_try_loop_expr_from_captured(captured: loop_capture)
            v2.extdeps.languages.dag.ParseSubtreeAbsent =>
          match body_lower_find_captured(
            root: captured,
            emitted: ^dag_surface_let_expr
          ) {
            v2.extdeps.languages.dag.ParseSubtreeFound { captured: let_capture } =>
              body_lower_try_let_in_from_captured(captured: let_capture)
            v2.extdeps.languages.dag.ParseSubtreeAbsent =>
              body_lower_body_subtree_lower_from_binary(captured: captured)
          }
          }
          }
          }
      }
  }
}

fn body_lower_body_from_fn_captured(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_fn_body) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: body } => body_lower_body_subtree_lower(captured: body)
    v2.extdeps.languages.dag.ParseSubtreeAbsent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
  }
}

fn body_lower_reify_operand_node(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_operand_ref_optional(node: node) {
    v2.std.optional.Present { value: op } => v2.std.optional.Present { value: op }
    v2.std.optional.Absent => body_lower_operand_from_shell_optional(shell: node)
  }
}

fn body_lower_reify_transform_edge(
  done: List<v2.std.node.Edge>,
  e: v2.std.node.Edge
) -> v2.std.diagnostic.Outcome<List<v2.std.node.Edge>> {
  if v2.std.algebra.length(xs: done) == 0 {
    v2.std.diagnostic.outcome_accepted(
      value: v2.std.algebra.list_snoc_item(
        xs: done,
        item: v2.std.node.Edge { label: e.label, target: e.target }
      )
    )
  } else {
    match body_lower_reify_operand_node(node: e.target) {
      v2.std.optional.Present { value: reified } =>
        v2.std.diagnostic.outcome_accepted(
          value: v2.std.algebra.list_snoc_item(
            xs: done,
            item: v2.std.node.Edge { label: e.label, target: reified }
          )
        )
      v2.std.optional.Absent =>
        v2.std.diagnostic.outcome_rejected(
          d: body_lower_diagnostic(
            reason: ^body_lowering_reason_unsupported_form,
            n: e.target
          )
        )
    }
  }
}

fn body_lower_reify_transform_body(body: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body.kind {
    v2.std.node.ComputationNode { behavior: v2.std.node.Transform } =>
      match fold(body.children, init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty), f: fn(acc, e) {
        match acc {
          v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          v2.std.diagnostic.Accepted { value: done, diagnostics: d } =>
            match body_lower_reify_transform_edge(done: done, e: e) {
              v2.std.diagnostic.Rejected { diagnostics: r } =>
                v2.std.diagnostic.Rejected {
                  diagnostics: v2.std.diagnostic.rejected_with_pending(pending: d, rejected: r)
                }
              v2.std.diagnostic.Accepted { value: next, diagnostics: ed } =>
                v2.std.diagnostic.Accepted {
                  value: next,
                  diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d, inner: ed)
                }
            }
        }
      }) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: children, diagnostics: d } =>
          outcome_with_diagnostics(
            value: v2.std.node.node_synthetic(
              kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
              children: children
            ),
            diagnostics: d
          )
      }
    _ => v2.std.diagnostic.outcome_accepted(value: body)
  }
}

fn body_lower_fn_decl_named_member_wrap(arrow: v2.std.node.Node, fn_name: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: fn_name }, target: arrow }
    ]
  )
}

fn body_lower_fn_decl_to_arrow(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_unwrap_captured(shell: shell) {
    v2.std.optional.Absent => body_lower_wrapper_retained_shell(shell: shell)
    v2.std.optional.Present { value: captured } =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_param_list) {
        v2.extdeps.languages.dag.ParseSubtreeAbsent => body_lower_wrapper_retained_shell(shell: shell)
        v2.extdeps.languages.dag.ParseSubtreeFound { captured: param_list } =>
          match body_lower_domain_from_param_list(param_list: param_list) {
            v2.std.optional.Absent => body_lower_wrapper_retained_shell(shell: shell)
            v2.std.optional.Present { value: domain } =>
              match body_lower_body_from_fn_captured(captured: captured) {
                v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                v2.std.diagnostic.Accepted { value: body_opt, diagnostics: bd0 } =>
                  match body_opt {
                    v2.std.optional.Absent => body_lower_wrapper_retained_shell(shell: shell)
                    v2.std.optional.Present { value: body } =>
                      match body_lower_reify_arrow_body(body: body) {
                        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                        v2.std.diagnostic.Accepted { value: reified_body, diagnostics: bd } =>
                          match body_lower_return_type_from_fn_captured(captured: captured) {
                            v2.std.optional.Absent => body_lower_wrapper_retained_shell(shell: shell)
                            v2.std.optional.Present { value: return_type } =>
                              match body_lower_fn_decl_ident_from_captured(captured: captured) {
                                v2.std.optional.Absent => body_lower_wrapper_retained_shell(shell: shell)
                                v2.std.optional.Present { value: fn_name } =>
                                  let arrow = v2.std.node.node_synthetic(
                                    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
                                    children: [
                                      v2.std.node.Edge { label: v2.std.node.Positional, target: domain },
                                      v2.std.node.Edge { label: v2.std.node.Positional, target: return_type },
                                      v2.std.node.Edge { label: v2.std.node.Positional, target: return_type },
                                      v2.std.node.Edge {
                                        label: v2.std.node.Named { name: ^arrow_body_edge },
                                        target: reified_body
                                      }
                                    ]
                                  )
                                  outcome_with_diagnostics(
                                    value: body_lower_fn_decl_named_member_wrap(
                                      arrow: arrow,
                                      fn_name: fn_name
                                    ),
                                    diagnostics: v2.std.diagnostic.diagnostics_merge(outer: bd0, inner: bd)
                                  )
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

fn body_lower_literal_bool_atom_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let unwrapped = body_lower_deep_unwrap_optional(node: node)
  match node_atom_identity_optional(node: unwrapped) {
    v2.std.optional.Present { value: id } =>
      if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
        v2.std.optional.optional_present(value: body_lower_param_ref_atom(source: unwrapped, identity: id))
      } else {
        body_lower_int_literal_with_magnitude_optional(node: unwrapped)
      }
    v2.std.optional.Absent =>
      fold(node.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => body_lower_literal_bool_atom_optional(node: e.target)
        }
      })
  }
}

fn body_lower_literal_int_atom_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_int_literal_with_magnitude_optional(node: node) {
    v2.std.optional.Present { value: lit } => v2.std.optional.Present { value: lit }
    v2.std.optional.Absent =>
      fold(node.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent =>
            if body_lower_is_identity_projection_edge(edge: e) {
              v2.std.optional.Absent
            } else {
              body_lower_literal_int_atom_optional(node: e.target)
            }
        }
      })
  }
}

fn body_lower_operand_ref_acceptable_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_operand_ref_optional(node: node) {
    v2.std.optional.Present { value: operand } =>
      match body_lower_int_literal_with_magnitude_optional(node: operand) {
        v2.std.optional.Present { value: lit } => v2.std.optional.Present { value: lit }
        v2.std.optional.Absent =>
          match v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: operand) {
            true => v2.std.optional.Absent
            false => v2.std.optional.Present { value: operand }
          }
      }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn body_lower_try_operand_or_reject(shell: v2.std.node.Node, captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_operand_ref_acceptable_optional(node: captured) {
    v2.std.optional.Present { value: operand } => v2.std.diagnostic.outcome_accepted(value: operand)
    v2.std.optional.Absent =>
      match body_lower_literal_bool_atom_optional(node: captured) {
        v2.std.optional.Present { value: lit } => v2.std.diagnostic.outcome_accepted(value: lit)
        v2.std.optional.Absent =>
          match body_lower_literal_int_atom_optional(node: captured) {
            v2.std.optional.Present { value: lit } => v2.std.diagnostic.outcome_accepted(value: lit)
            v2.std.optional.Absent =>
              match body_lower_pattern_first_atom_optional(node: captured) {
                v2.std.optional.Present { value: pat_atom } => v2.std.diagnostic.outcome_accepted(value: pat_atom)
                v2.std.optional.Absent =>
                  v2.std.diagnostic.outcome_rejected(
                    d: body_lower_diagnostic(
                      reason: ^body_lowering_reason_unsupported_form,
                      n: shell
                    )
                  )
              }
          }
      }
  }
}

fn body_lower_unwrap_pass_through(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_unwrap_captured(shell: shell) {
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    v2.std.optional.Present { value: captured } => v2.std.diagnostic.outcome_accepted(value: captured)
  }
}

fn body_lower_transform_call(operator: v2.std.node.Node, args: List<v2.std.node.Node>) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: v2.std.algebra.list_append(
      left: [v2.std.node.Edge { label: v2.std.node.Positional, target: operator }],
      right: fold(args, init: std.algebra.Empty, f: fn(acc, arg) {
        v2.std.algebra.list_snoc_item(xs: acc, item: v2.std.node.Edge { label: v2.std.node.Positional, target: arg })
      })
    )
  )
}

fn body_lower_method_operator_atom(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: []
  )
}

fn body_lower_arg_operand_optional(arg_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_find_captured(root: arg_capture, emitted: ^dag_surface_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: expr } => body_lower_operand_ref_optional(node: expr)
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: arg_capture) {
        v2.std.optional.Present { value: emitted } =>
          if emitted == ^dag_surface_expr {
            match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: arg_capture) {
              v2.std.optional.Present { value: captured } => body_lower_operand_ref_optional(node: captured)
              v2.std.optional.Absent => v2.std.optional.Absent
            }
          } else {
            body_lower_operand_ref_optional(node: arg_capture)
          }
        v2.std.optional.Absent => body_lower_operand_ref_optional(node: arg_capture)
      }
  }
}

fn body_lower_named_arg_value_optional(arg_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: arg_capture) {
    v2.std.optional.Absent =>
      match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: arg_capture) {
        v2.std.optional.Present { value: emitted } =>
          if emitted == ^dag_surface_arg {
            match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: arg_capture) {
              v2.std.optional.Present { value: captured } =>
                body_lower_named_arg_value_optional(arg_capture: captured)
              v2.std.optional.Absent => v2.std.optional.optional_absent()
            }
          } else {
            v2.std.optional.optional_absent()
          }
        v2.std.optional.Absent => v2.std.optional.optional_absent()
      }
    v2.std.optional.Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        v2.std.optional.Absent => v2.std.optional.optional_absent()
        v2.std.optional.Present { value: _binding } =>
          match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: pair.right) {
            v2.std.optional.Absent => v2.std.optional.optional_absent()
            v2.std.optional.Present { value: after_name } =>
              match node_atom_identity_optional(node: after_name.left) {
                v2.std.optional.Present { value: colon } =>
                  if colon == ^dag_token_colon {
                    body_lower_arg_operand_optional(arg_capture: after_name.right)
                  } else {
                    v2.std.optional.optional_absent()
                  }
                v2.std.optional.Absent => v2.std.optional.optional_absent()
              }
          }
      }
  }
}

fn body_lower_call_arg_edge_optional(arg_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_named_arg_value_optional(arg_capture: arg_capture) {
    v2.std.optional.Present { value: operand } => v2.std.optional.Present { value: operand }
    v2.std.optional.Absent => body_lower_arg_operand_optional(arg_capture: arg_capture)
  }
}

fn body_lower_call_arg_operand_from_repeat_elem(repeat_elem: v2.std.node.Node) -> List<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Present { value: pair } =>
      match body_lower_call_arg_edge_optional(
        arg_capture: body_lower_postfix_optional_unwrap(node: pair.right)
      ) {
        v2.std.optional.Present { value: operand } => [operand]
        v2.std.optional.Absent => std.algebra.Empty
      }
    v2.std.optional.Absent =>
      match body_lower_call_arg_edge_optional(arg_capture: stripped) {
        v2.std.optional.Present { value: operand } => [operand]
        v2.std.optional.Absent => std.algebra.Empty
      }
  }
}

fn body_lower_extract_comma_list_operand(node: v2.std.node.Node) -> List<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  match body_lower_call_arg_edge_optional(arg_capture: stripped) {
    v2.std.optional.Present { value: operand } => [operand]
    v2.std.optional.Absent =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
        v2.std.optional.Present { value: pair } =>
          let left_ops = body_lower_call_arg_operand_from_repeat_elem(repeat_elem: pair.left)
          if count(left_ops) > 0 {
            left_ops
          } else {
            body_lower_call_arg_operand_from_repeat_elem(repeat_elem: stripped)
          }
        v2.std.optional.Absent => body_lower_call_arg_operand_from_repeat_elem(repeat_elem: stripped)
      }
  }
}

fn body_lower_collect_call_arg_operands_from_repeat_tail(repeat_capture: v2.std.node.Node) -> List<v2.std.node.Node> {
  if v2.std.node.is_empty_conj_root(n: repeat_capture) {
    std.algebra.Empty
  } else {
    match v2.std.node_query.find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      v2.std.diagnostic.Accepted { value: head, diagnostics: _ } =>
        let operands = body_lower_extract_comma_list_operand(node: head)
        match v2.std.node_query.find_named_child(root: repeat_capture, name: ^grammar_sequence_right_node_projection) {
          v2.std.diagnostic.Accepted { value: tail, diagnostics: _ } =>
            v2.std.algebra.list_append(
              left: operands,
              right: body_lower_collect_call_arg_operands_from_repeat_tail(repeat_capture: tail)
            )
          v2.std.diagnostic.Rejected { diagnostics: _ } => operands
        }
      v2.std.diagnostic.Rejected { diagnostics: _ } => std.algebra.Empty
    }
  }
}

fn body_lower_collect_call_arg_operands(sequence_capture: v2.std.node.Node) -> List<v2.std.node.Node> {
  let unwrapped = body_lower_postfix_optional_unwrap(node: sequence_capture)
  match v2.std.node_query.find_named_child(root: unwrapped, name: ^grammar_sequence_left_node_projection) {
    v2.std.diagnostic.Accepted { value: first, diagnostics: _ } =>
      let first_operands = match body_lower_call_arg_edge_optional(arg_capture: first) {
        v2.std.optional.Present { value: operand } => [operand]
        v2.std.optional.Absent => body_lower_call_arg_operand_from_repeat_elem(repeat_elem: first)
      }
      match v2.std.node_query.find_named_child(root: unwrapped, name: ^grammar_sequence_right_node_projection) {
        v2.std.diagnostic.Accepted { value: tail, diagnostics: _ } =>
          v2.std.algebra.list_append(
            left: first_operands,
            right: body_lower_collect_call_arg_operands_from_repeat_tail(repeat_capture: tail)
          )
        v2.std.diagnostic.Rejected { diagnostics: _ } => first_operands
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      match body_lower_call_arg_edge_optional(arg_capture: unwrapped) {
        v2.std.optional.Present { value: operand } => [operand]
        v2.std.optional.Absent =>
          match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: unwrapped) {
            v2.std.optional.Present { value: pair } =>
              match body_lower_call_arg_edge_optional(arg_capture: pair.left) {
                v2.std.optional.Present { value: operand } =>
                  match body_lower_after_comma_tail_optional(node: pair.right) {
                    v2.std.optional.Present { value: tail } =>
                      v2.std.algebra.list_append(
                        left: [operand],
                        right: body_lower_collect_call_arg_operands(sequence_capture: tail)
                      )
                    v2.std.optional.Absent => [operand]
                  }
                v2.std.optional.Absent =>
                  match body_lower_after_comma_tail_optional(node: pair.right) {
                    v2.std.optional.Present { value: tail } => body_lower_collect_call_arg_operands(sequence_capture: tail)
                    v2.std.optional.Absent => std.algebra.Empty
                  }
              }
            v2.std.optional.Absent => std.algebra.Empty
          }
      }
  }
}

fn body_lower_call_args_from_capture(args_capture: v2.std.node.Node) -> List<v2.std.node.Node> {
  match body_lower_param_list_comma_spine_optional(param_list_captured: args_capture) {
    v2.std.optional.Present { value: comma_spine } =>
      body_lower_collect_call_arg_operands(sequence_capture: comma_spine)
    v2.std.optional.Absent => body_lower_collect_call_arg_operands(sequence_capture: args_capture)
  }
}

fn body_lower_primary_call_suffix_optional(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: root)
  match body_lower_postfix_call_suffix_args(call_suffix: stripped) {
    v2.std.optional.Present { value: _ } => v2.std.optional.optional_present(value: stripped)
    v2.std.optional.Absent =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => body_lower_primary_call_suffix_optional(root: e.target)
        }
      })
  }
}

fn body_lower_try_primary_ident_call(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
    v2.std.optional.Present { value: pair } =>
      match body_lower_operand_ref_optional(node: pair.left) {
        v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        v2.std.optional.Present { value: callee_atom } =>
          match body_lower_primary_call_suffix_optional(root: pair.right) {
            v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
            v2.std.optional.Present { value: call_suffix } =>
              match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
                v2.std.optional.Present { value: args } =>
                  v2.std.diagnostic.outcome_accepted(
                    value: v2.std.optional.optional_present(
                      value: body_lower_transform_call(
                        operator: callee_atom,
                        args: args
                      )
                    )
                  )
                v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
              }
          }
      }
  }
}

fn body_lower_postfix_call_suffix_args(call_suffix: v2.std.node.Node) -> v2.std.optional.Optional<List<v2.std.node.Node>> {
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: call_suffix) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        v2.std.optional.Present { value: id } =>
          if id == ^dag_token_lparen {
            match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: pair.right) {
              v2.std.optional.Absent => v2.std.optional.optional_present(value: std.algebra.Empty)
              v2.std.optional.Present { value: inner } =>
                v2.std.optional.optional_present(
                  value: body_lower_call_args_from_capture(
                    args_capture: body_lower_postfix_optional_unwrap(node: inner.left)
                  )
                )
            }
          } else {
            v2.std.optional.Absent
          }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
  }
}

fn body_lower_postfix_projection_step(repeat_elem: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Absent => v2.std.optional.Absent
    v2.std.optional.Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        v2.std.optional.Present { value: id } =>
          if id == ^dag_token_dot {
            match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: pair.right) {
              v2.std.optional.Absent => v2.std.optional.Absent
              v2.std.optional.Present { value: after_dot } =>
                match body_lower_param_binding_optional(node: after_dot.left) {
                  v2.std.optional.Present { value: method } => v2.std.optional.optional_present(value: method)
                  v2.std.optional.Absent => v2.std.optional.Absent
                }
            }
          } else {
            v2.std.optional.Absent
          }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
  }
}

fn body_lower_postfix_optional_unwrap(node: v2.std.node.Node) -> v2.std.node.Node {
  match v2.std.node_query.find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    v2.std.diagnostic.Accepted { value: child, diagnostics: _ } => child
    v2.std.diagnostic.Rejected { diagnostics: _ } => node
  }
}

fn body_lower_postfix_method_suffix_optional(repeat_elem: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Absent => v2.std.optional.optional_absent()
    v2.std.optional.Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        v2.std.optional.Present { value: id } =>
          if id == ^dag_token_dot {
            match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: pair.right) {
              v2.std.optional.Absent => v2.std.optional.optional_absent()
              v2.std.optional.Present { value: after_dot } =>
                v2.std.optional.optional_present(
                  value: body_lower_postfix_optional_unwrap(node: after_dot.right)
                )
            }
          } else {
            v2.std.optional.optional_absent()
          }
        v2.std.optional.Absent => v2.std.optional.optional_absent()
      }
  }
}

fn body_lower_postfix_projection_args(repeat_elem: v2.std.node.Node) -> List<v2.std.node.Node> {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    v2.std.optional.Absent => std.algebra.Empty
    v2.std.optional.Present { value: call_suffix } =>
      match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
        v2.std.optional.Present { value: args } => args
        v2.std.optional.Absent => std.algebra.Empty
      }
  }
}

fn body_lower_postfix_projection_has_call_suffix(repeat_elem: v2.std.node.Node) -> Bool {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: call_suffix } =>
      match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
        v2.std.optional.Present { value: _ } => true
        v2.std.optional.Absent => false
      }
  }
}

fn body_lower_postfix_projection_call_suffix_capture(repeat_elem: v2.std.node.Node) -> v2.std.node.Node {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    v2.std.optional.Absent => repeat_elem
    v2.std.optional.Present { value: call_suffix } => call_suffix
  }
}

fn body_lower_postfix_repeat_head_optional(repeat_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  if v2.std.node.is_empty_conj_root(n: repeat_capture) {
    v2.std.optional.optional_absent()
  } else {
    match v2.std.node_query.find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      v2.std.diagnostic.Accepted { value: elem, diagnostics: _ } => v2.std.optional.optional_present(value: elem)
      v2.std.diagnostic.Rejected { diagnostics: _ } =>
        match v2.std.node_query.find_named_child(root: repeat_capture, name: ^grammar_repeat_element_node_projection) {
          v2.std.diagnostic.Accepted { value: elem, diagnostics: _ } => v2.std.optional.optional_present(value: elem)
          v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.optional_absent()
        }
    }
  }
}

fn body_lower_try_postfix_projection(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
    v2.std.optional.Present { value: pair } =>
      match body_lower_operand_ref_optional(node: pair.left) {
        v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        v2.std.optional.Present { value: receiver } =>
          match body_lower_postfix_repeat_head_optional(repeat_capture: pair.right) {
            v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
            v2.std.optional.Present { value: repeat_elem } =>
              match body_lower_postfix_projection_step(repeat_elem: repeat_elem) {
                v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
                v2.std.optional.Present { value: method } =>
                  if body_lower_postfix_projection_has_call_suffix(repeat_elem: repeat_elem) {
                    let args = body_lower_postfix_projection_args(repeat_elem: repeat_elem)
                    v2.std.diagnostic.outcome_accepted(
                      value: v2.std.optional.optional_present(
                        value: body_lower_transform_call(
                          operator: body_lower_method_operator_atom(sym: method),
                          args: v2.std.algebra.list_append(
                            left: [receiver],
                            right: args
                          )
                        )
                      )
                    )
                  } else {
                    v2.std.diagnostic.outcome_rejected(
                      d: body_lower_diagnostic(
                        reason: ^body_lowering_reason_postfix_field_access_refused,
                        n: node
                      )
                    )
                  }
              }
          }
      }
  }
}

fn body_lower_match_arm_wire(pat_node: v2.std.node.Node, body: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Named { name: v2.std.node.match_arm_pattern }, target: pat_node },
      v2.std.node.Edge { label: v2.std.node.Named { name: v2.std.node.match_arm_body }, target: body }
    ]
  )
}

fn body_lower_pattern_leaf_atom_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  match v2.extdeps.languages.dag.dag_binding_branded_atom_identity(node: stripped) {
    v2.std.optional.Present { value: binding } =>
      v2.std.optional.optional_present(value: body_lower_param_ref_atom(source: stripped, identity: binding))
    v2.std.optional.Absent =>
      match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: stripped) {
        v2.std.optional.Present { value: emitted } =>
          match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: stripped) {
            v2.std.optional.Present { value: captured } => body_lower_pattern_leaf_atom_optional(node: captured)
            v2.std.optional.Absent =>
              if emitted == ^dag_surface_pattern {
                fold(stripped.children, init: v2.std.optional.Absent, f: fn(acc, e) {
                  match acc {
                    v2.std.optional.Present { value: _ } => acc
                    v2.std.optional.Absent => body_lower_pattern_leaf_atom_optional(node: e.target)
                  }
                })
              } else {
                v2.std.optional.optional_absent()
              }
          }
        v2.std.optional.Absent =>
          match node_atom_identity_optional(node: stripped) {
            v2.std.optional.Present { value: id } =>
              if v2.extdeps.languages.dag.dag_lex_token_symbol(sym: id) {
                if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                  v2.std.optional.optional_present(value: body_lower_param_ref_atom(source: stripped, identity: id))
                } else {
                  body_lower_int_literal_with_magnitude_optional(node: stripped)
                }
              } else {
                v2.std.optional.optional_present(value: body_lower_param_ref_atom(source: stripped, identity: id))
              }
            v2.std.optional.Absent =>
              fold(stripped.children, init: v2.std.optional.Absent, f: fn(acc, e) {
                match acc {
                  v2.std.optional.Present { value: _ } => acc
                  v2.std.optional.Absent => body_lower_pattern_leaf_atom_optional(node: e.target)
                }
              })
          }
      }
  }
}

fn body_lower_pattern_first_atom_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_pattern_leaf_atom_optional(node: node) {
    v2.std.optional.Present { value: atom } => v2.std.optional.Present { value: atom }
    v2.std.optional.Absent =>
      fold(node.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => body_lower_pattern_first_atom_optional(node: e.target)
        }
      })
  }
}

fn body_lower_pattern_atom_optional(pattern_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  body_lower_pattern_first_atom_optional(node: pattern_capture)
}

fn body_lower_match_arm_navigation_reject(arm_capture: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_match_arm_navigation_refused,
      n: arm_capture
    )
  )
}

fn body_lower_match_arm_body_capture_optional(stripped: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_find_captured(root: stripped, emitted: ^dag_surface_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: expr } => v2.std.optional.optional_present(value: expr)
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      match body_lower_find_captured(
        root: stripped,
        emitted: ^dag_surface_primary_expr
      ) {
        v2.extdeps.languages.dag.ParseSubtreeFound { captured: primary } => v2.std.optional.optional_present(value: primary)
        v2.extdeps.languages.dag.ParseSubtreeAbsent =>
          match body_lower_find_captured(
            root: stripped,
            emitted: ^dag_surface_postfix_expr
          ) {
            v2.extdeps.languages.dag.ParseSubtreeFound { captured: postfix } => v2.std.optional.optional_present(value: postfix)
            v2.extdeps.languages.dag.ParseSubtreeAbsent => v2.std.optional.optional_absent()
          }
      }
  }
}

fn body_lower_match_arm_body_optional(body_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_find_captured(root: body_capture, emitted: ^dag_surface_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: expr } => body_lower_operand_from_shell_optional(shell: expr)
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: body_capture) {
        v2.std.optional.Present { value: emitted } =>
          if emitted == ^dag_surface_expr {
            match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: body_capture) {
              v2.std.optional.Present { value: captured } =>
                body_lower_match_arm_body_optional(body_capture: captured)
              v2.std.optional.Absent => v2.std.optional.optional_absent()
            }
          } else if emitted == ^dag_surface_match_arm_stmt_body {
            match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: body_capture) {
              v2.std.optional.Present { value: captured } =>
                body_lower_match_arm_body_optional(body_capture: captured)
              v2.std.optional.Absent => v2.std.optional.optional_absent()
            }
          } else {
            body_lower_operand_from_shell_optional(shell: body_capture)
          }
        v2.std.optional.Absent =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: body_capture)) {
            v2.std.optional.Present { value: id } =>
              if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                v2.std.optional.optional_present(
                  value: body_lower_param_ref_atom(source: body_capture, identity: id)
                )
              } else if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(
                node: body_lower_deep_unwrap_optional(node: body_capture)
              ) {
                body_lower_int_literal_with_magnitude_optional(node: body_capture)
              } else if v2.extdeps.languages.dag.dag_lex_token_symbol(sym: id) {
                v2.std.optional.optional_absent()
              } else {
                v2.std.optional.optional_present(
                  value: body_lower_param_ref_atom(source: body_capture, identity: id)
                )
              }
            v2.std.optional.Absent => body_lower_operand_from_shell_optional(shell: body_capture)
          }
      }
  }
}

fn body_lower_match_arm_wire_from_sequence(stripped: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_find_captured(
    root: stripped,
    emitted: ^dag_surface_pattern
  ) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: pat_capture } =>
      match body_lower_pattern_atom_optional(pattern_capture: pat_capture) {
        v2.std.optional.Present { value: pat_node } =>
          match body_lower_match_arm_body_capture_optional(stripped: stripped) {
            v2.std.optional.Present { value: body_capture } =>
              match body_lower_match_arm_body_optional(body_capture: body_capture) {
                v2.std.optional.Present { value: body } =>
                  v2.std.diagnostic.outcome_accepted(
                    value: body_lower_match_arm_wire(pat_node: pat_node, body: body)
                  )
                v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
              }
            v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
          }
        v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
      }
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      match body_lower_match_spine_left(spine: stripped) {
        v2.std.optional.Present { value: left } =>
          match body_lower_match_spine_right(spine: stripped) {
            v2.std.optional.Present { value: right } =>
              match body_lower_pattern_atom_optional(pattern_capture: left) {
                v2.std.optional.Present { value: pat_node } =>
                  match body_lower_match_spine_left(spine: right) {
                    v2.std.optional.Present { value: arrow_node } =>
                      match node_atom_identity_optional(node: arrow_node) {
                        v2.std.optional.Present { value: arrow } =>
                          if arrow == ^dag_token_fat_arrow {
                            match body_lower_match_spine_right(spine: right) {
                              v2.std.optional.Present { value: body_capture } =>
                                match body_lower_match_arm_body_optional(
                                  body_capture: body_capture
                                ) {
                                  v2.std.optional.Present { value: body } =>
                                    v2.std.diagnostic.outcome_accepted(
                                      value: body_lower_match_arm_wire(
                                        pat_node: pat_node,
                                        body: body
                                      )
                                    )
                                  v2.std.optional.Absent =>
                                    body_lower_match_arm_navigation_reject(arm_capture: stripped)
                                }
                              v2.std.optional.Absent =>
                                body_lower_match_arm_navigation_reject(arm_capture: stripped)
                            }
                          } else {
                            body_lower_match_arm_navigation_reject(arm_capture: stripped)
                          }
                        v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
                      }
                    v2.std.optional.Absent =>
                      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: right) {
                        v2.std.optional.Present { value: after_pattern } =>
                          match node_atom_identity_optional(node: after_pattern.left) {
                            v2.std.optional.Present { value: arrow } =>
                              if arrow == ^dag_token_fat_arrow {
                                match body_lower_match_arm_body_optional(
                                  body_capture: after_pattern.right
                                ) {
                                  v2.std.optional.Present { value: body } =>
                                    v2.std.diagnostic.outcome_accepted(
                                      value: body_lower_match_arm_wire(
                                        pat_node: pat_node,
                                        body: body
                                      )
                                    )
                                  v2.std.optional.Absent =>
                                    body_lower_match_arm_navigation_reject(arm_capture: stripped)
                                }
                              } else {
                                body_lower_match_arm_navigation_reject(arm_capture: stripped)
                              }
                            v2.std.optional.Absent =>
                              body_lower_match_arm_navigation_reject(arm_capture: stripped)
                          }
                        v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
                      }
                  }
                v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
              }
            v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
          }
        v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
      }
  }
}

fn body_lower_is_match_arm_navigate_emitted(emitted: v2.std.node.Symbol) -> Bool {
  (emitted == ^dag_surface_pattern)
    || (emitted == ^dag_surface_primary_expr)
    || (emitted == ^dag_surface_match_arm_stmt_body)
    || body_lower_is_pass_through_emitted(emitted: emitted)
}

fn body_lower_match_arm_from_comma_repeat_elem(repeat_elem: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: stripped) {
    v2.std.optional.Present { value: pair } =>
      body_lower_wire_match_arm_capture(
        arm_capture: body_lower_postfix_optional_unwrap(node: pair.right)
      )
    v2.std.optional.Absent =>
      body_lower_wire_match_arm_capture(arm_capture: stripped)
  }
}

fn body_lower_extract_comma_list_arm_head(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  match body_lower_wire_match_arm_capture(arm_capture: stripped) {
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      body_lower_match_arm_from_comma_repeat_elem(repeat_elem: stripped)
    v2.std.diagnostic.Accepted { value: arm, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: arm, diagnostics: d }
  }
}

fn body_lower_wire_match_arm_capture(arm_capture: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let stripped = body_lower_deep_unwrap_optional(node: arm_capture)
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: stripped) {
    v2.std.optional.Present { value: emitted } =>
      if emitted == ^dag_surface_match_arm {
        match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: stripped) {
          v2.std.optional.Present { value: captured } =>
            body_lower_wire_match_arm_capture(arm_capture: captured)
          v2.std.optional.Absent => body_lower_match_arm_wire_from_sequence(stripped: stripped)
        }
      } else if body_lower_is_match_arm_navigate_emitted(emitted: emitted) {
        match v2.extdeps.languages.dag.parse_production_captured_child_optional(node: stripped) {
          v2.std.optional.Present { value: captured } =>
            body_lower_wire_match_arm_capture(arm_capture: captured)
          v2.std.optional.Absent => body_lower_match_arm_navigation_reject(arm_capture: arm_capture)
        }
      } else {
        body_lower_match_arm_navigation_reject(arm_capture: arm_capture)
      }
    v2.std.optional.Absent => body_lower_match_arm_wire_from_sequence(stripped: stripped)
  }
}

fn body_lower_collect_match_arms_from_repeat_tail(repeat_capture: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Node>> {
  if v2.std.node.is_empty_conj_root(n: repeat_capture) {
    v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty)
  } else {
    match v2.std.node_query.find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      v2.std.diagnostic.Accepted { value: head, diagnostics: _ } =>
        match body_lower_extract_comma_list_arm_head(node: head) {
          v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          v2.std.diagnostic.Accepted { value: arm, diagnostics: d } =>
            match v2.std.node_query.find_named_child(root: repeat_capture, name: ^grammar_sequence_right_node_projection) {
              v2.std.diagnostic.Accepted { value: tail, diagnostics: _ } =>
                match body_lower_collect_match_arms_from_repeat_tail(repeat_capture: tail) {
                  v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                  v2.std.diagnostic.Accepted { value: rest, diagnostics: rd } =>
                    v2.std.diagnostic.Accepted {
                      value: v2.std.algebra.list_append(left: [arm], right: rest),
                      diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d, inner: rd)
                    }
                }
              v2.std.diagnostic.Rejected { diagnostics: _ } =>
                v2.std.diagnostic.Accepted { value: [arm], diagnostics: d }
            }
        }
      v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty)
    }
  }
}

fn body_lower_collect_match_arms(sequence_capture: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Node>> {
  let unwrapped = body_lower_postfix_optional_unwrap(node: sequence_capture)
  match v2.std.node_query.find_named_child(root: unwrapped, name: ^grammar_sequence_left_node_projection) {
    v2.std.diagnostic.Accepted { value: first, diagnostics: _ } =>
      match body_lower_extract_comma_list_arm_head(node: first) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: arm, diagnostics: d } =>
          match v2.std.node_query.find_named_child(root: unwrapped, name: ^grammar_sequence_right_node_projection) {
            v2.std.diagnostic.Accepted { value: tail, diagnostics: _ } =>
              match body_lower_collect_match_arms_from_repeat_tail(repeat_capture: tail) {
                v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                v2.std.diagnostic.Accepted { value: rest, diagnostics: rd } =>
                  v2.std.diagnostic.Accepted {
                    value: v2.std.algebra.list_append(left: [arm], right: rest),
                    diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d, inner: rd)
                  }
              }
            v2.std.diagnostic.Rejected { diagnostics: _ } =>
              v2.std.diagnostic.Accepted { value: [arm], diagnostics: d }
          }
      }
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: unwrapped) {
        v2.std.optional.Present { value: pair } =>
          match body_lower_extract_comma_list_arm_head(node: pair.left) {
            v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
            v2.std.diagnostic.Accepted { value: arm, diagnostics: d } =>
              match body_lower_after_comma_tail_optional(node: pair.right) {
                v2.std.optional.Present { value: tail } =>
                  match body_lower_collect_match_arms(sequence_capture: tail) {
                    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                    v2.std.diagnostic.Accepted { value: rest, diagnostics: rd } =>
                      v2.std.diagnostic.Accepted {
                        value: v2.std.algebra.list_append(left: [arm], right: rest),
                        diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d, inner: rd)
                      }
                  }
                v2.std.optional.Absent => v2.std.diagnostic.Accepted { value: [arm], diagnostics: d }
              }
          }
        v2.std.optional.Absent =>
          match body_lower_extract_comma_list_arm_head(node: unwrapped) {
            v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
            v2.std.diagnostic.Accepted { value: arm, diagnostics: d } =>
              v2.std.diagnostic.Accepted { value: [arm], diagnostics: d }
          }
      }
  }
}

fn body_lower_reify_branch_target(node: v2.std.node.Node) -> v2.std.node.Node {
  match body_lower_materialize_int_literal_operand_optional(node: node) {
    v2.std.optional.Present { value: reified } => reified
    v2.std.optional.Absent =>
      match body_lower_literal_bool_atom_optional(node: node) {
        v2.std.optional.Present { value: reified } => reified
        v2.std.optional.Absent =>
          match body_lower_reify_operand_node(node: node) {
            v2.std.optional.Present { value: reified } => reified
            v2.std.optional.Absent => node
          }
      }
  }
}

fn body_lower_reify_branch_body(body: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body.kind {
    v2.std.node.ComputationNode { behavior: v2.std.node.Branch } =>
      match fold(body.children, init: v2.std.diagnostic.outcome_accepted(value: std.algebra.Empty), f: fn(acc, e) {
        match acc {
          v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          v2.std.diagnostic.Accepted { value: done, diagnostics: d } =>
            outcome_with_diagnostics(
              value: v2.std.algebra.list_snoc_item(
                xs: done,
                item: v2.std.node.Edge {
                  label: e.label,
                  target: body_lower_reify_branch_target(node: e.target)
                }
              ),
              diagnostics: d
            )
        }
      }) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: children, diagnostics: d } =>
          outcome_with_diagnostics(
            value: v2.std.node.node_synthetic(
              kind: v2.std.node.ComputationNode { behavior: v2.std.node.Branch },
              children: children
            ),
            diagnostics: d
          )
      }
    _ => v2.std.diagnostic.outcome_accepted(value: body)
  }
}

fn body_lower_reify_arrow_body(body: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body.kind {
    v2.std.node.ComputationNode { behavior: v2.std.node.Transform } => body_lower_reify_transform_body(body: body)
    v2.std.node.ComputationNode { behavior: v2.std.node.Branch } => body_lower_reify_branch_body(body: body)
    _ => v2.std.diagnostic.outcome_accepted(value: body)
  }
}

fn body_lower_if_navigation_reject(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_if_navigation_refused,
      n: captured
    )
  )
}

fn body_lower_materialize_int_literal_operand_optional(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_int_literal_with_magnitude_optional(node: node) {
    v2.std.optional.Present { value: lit } => v2.std.optional.Present { value: lit }
    v2.std.optional.Absent =>
      match body_lower_literal_int_atom_optional(node: node) {
        v2.std.optional.Present { value: lit } => v2.std.optional.Present { value: lit }
        v2.std.optional.Absent =>
          match body_lower_unwrap_captured(shell: node) {
            v2.std.optional.Present { value: captured } =>
              body_lower_materialize_int_literal_operand_optional(node: captured)
            v2.std.optional.Absent =>
              let deep = body_lower_deep_unwrap_for_int_literal(node: node)
              match node_atom_identity_optional(node: deep) {
                v2.std.optional.Present { value: id } =>
                  match v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: deep) {
                    true =>
                      body_lower_int_literal_with_magnitude_optional(node: deep)
                    false =>
                      match v2.std.integer.integer_string_to_decimal_digits_optional(s: v2.std.compilers.lexing.symbol_lexeme(sym: id)) {
                        v2.std.optional.Present { value: _ } =>
                          match v2.extdeps.languages.dag.dag_int_literal_node_from_lexeme(
                            lexeme: v2.std.compilers.lexing.symbol_lexeme(sym: id),
                            occurrence_id: node.occurrence_id
                          ) {
                            v2.std.diagnostic.Accepted { value: lit, diagnostics: _ } => v2.std.optional.optional_present(value: lit)
                            v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.optional_absent()
                          }
                        v2.std.optional.Absent => v2.std.optional.optional_absent()
                      }
                  }
                v2.std.optional.Absent => v2.std.optional.optional_absent()
              }
          }
      }
  }
}

fn body_lower_arm_operand_resolved_optional(arm: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_materialize_int_literal_operand_optional(node: arm) {
    v2.std.optional.Present { value: lit } => v2.std.optional.Present { value: lit }
    v2.std.optional.Absent =>
      match body_lower_literal_bool_atom_optional(node: arm) {
        v2.std.optional.Present { value: b } => v2.std.optional.Present { value: b }
        v2.std.optional.Absent =>
          match body_lower_operand_from_shell_optional(shell: arm) {
            v2.std.optional.Present { value: op } =>
              match body_lower_materialize_int_literal_operand_optional(node: op) {
                v2.std.optional.Present { value: lit } => v2.std.optional.Present { value: lit }
                v2.std.optional.Absent =>
                  match body_lower_int_literal_with_magnitude_optional(node: op) {
                    v2.std.optional.Present { value: lit } => v2.std.optional.Present { value: lit }
                    v2.std.optional.Absent =>
                      if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(
                        node: body_lower_deep_unwrap_for_int_literal(node: op)
                      ) {
                        v2.std.optional.optional_absent()
                      } else {
                        v2.std.optional.optional_present(value: op)
                      }
                  }
              }
            v2.std.optional.Absent => v2.std.optional.optional_absent()
          }
      }
  }
}

fn body_lower_if_arm_operand_optional(arm_capture: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: arm_capture) {
    v2.std.optional.Present { value: emitted } =>
      if emitted == ^dag_surface_if_expr {
        match body_lower_unwrap_captured(shell: arm_capture) {
          v2.std.optional.Present { value: captured } =>
            match body_lower_try_if_from_captured(captured: captured) {
              v2.std.diagnostic.Rejected { diagnostics: _ } => v2.std.optional.Absent
              v2.std.diagnostic.Accepted { value: lowered_opt, diagnostics: _ } =>
                match lowered_opt {
                  v2.std.optional.Present { value: lowered } => v2.std.optional.Present { value: lowered }
                  v2.std.optional.Absent => v2.std.optional.Absent
                }
            }
          v2.std.optional.Absent => v2.std.optional.Absent
        }
      } else if emitted == ^dag_surface_fn_body {
        match body_lower_find_production_shell_optional(
          root: arm_capture,
          emitted: ^dag_surface_stmt
        ) {
          v2.std.optional.Present { value: shell } =>
            body_lower_operand_from_shell_optional(shell: shell)
          v2.std.optional.Absent =>
            match body_lower_find_production_shell_optional(
              root: arm_capture,
              emitted: ^dag_surface_expr
            ) {
              v2.std.optional.Present { value: shell } =>
                body_lower_operand_from_shell_optional(shell: shell)
              v2.std.optional.Absent =>
                match body_lower_find_production_shell_optional(
                  root: arm_capture,
                  emitted: ^dag_surface_primary_expr
                ) {
                  v2.std.optional.Present { value: shell } =>
                    body_lower_operand_from_shell_optional(shell: shell)
                  v2.std.optional.Absent =>
                    body_lower_match_arm_body_optional(body_capture: arm_capture)
                }
            }
        }
      } else {
        body_lower_match_arm_body_optional(body_capture: arm_capture)
      }
    v2.std.optional.Absent => body_lower_match_arm_body_optional(body_capture: arm_capture)
  }
}

fn body_lower_if_expr_capture_optional(spine: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_find_captured(root: spine, emitted: ^dag_surface_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: expr } => v2.std.optional.Present { value: expr }
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      if v2.std.node.is_empty_conj_root(n: spine) {
        v2.std.optional.Absent
      } else {
        match body_lower_match_spine_left(spine: spine) {
          v2.std.optional.Present { value: left } =>
            match body_lower_match_spine_right(spine: spine) {
              v2.std.optional.Present { value: right } =>
                match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
                  v2.std.optional.Present { value: id } =>
                    match (id == ^dag_token_kw_if) || (id == ^dag_token_kw_then) || (id == ^dag_token_kw_else) {
                      true => body_lower_if_expr_capture_optional(spine: right)
                      false =>
                        match body_lower_if_expr_capture_optional(spine: left) {
                          v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                          v2.std.optional.Absent => body_lower_if_expr_capture_optional(spine: right)
                        }
                    }
                  v2.std.optional.Absent =>
                    match body_lower_if_expr_capture_optional(spine: left) {
                      v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                      v2.std.optional.Absent => body_lower_if_expr_capture_optional(spine: right)
                    }
                }
              v2.std.optional.Absent => v2.std.optional.Absent
            }
          v2.std.optional.Absent => v2.std.optional.Absent
        }
      }
  }
}

fn body_lower_if_fn_body_capture_optional(spine: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_find_captured(root: spine, emitted: ^dag_surface_fn_body) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: body } => v2.std.optional.Present { value: body }
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      if v2.std.node.is_empty_conj_root(n: spine) {
        v2.std.optional.Absent
      } else {
        match body_lower_match_spine_left(spine: spine) {
          v2.std.optional.Present { value: left } =>
            match body_lower_match_spine_right(spine: spine) {
              v2.std.optional.Present { value: right } =>
                match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
                  v2.std.optional.Present { value: id } =>
                    match id == ^dag_token_kw_else {
                      true => body_lower_if_fn_body_capture_optional(spine: right)
                      false =>
                        match body_lower_if_fn_body_capture_optional(spine: left) {
                          v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                          v2.std.optional.Absent => body_lower_if_fn_body_capture_optional(spine: right)
                        }
                    }
                  v2.std.optional.Absent =>
                    match body_lower_if_fn_body_capture_optional(spine: left) {
                      v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                      v2.std.optional.Absent => body_lower_if_fn_body_capture_optional(spine: right)
                    }
                }
              v2.std.optional.Absent => v2.std.optional.Absent
            }
          v2.std.optional.Absent => v2.std.optional.Absent
        }
      }
  }
}

fn body_lower_if_then_fn_body_optional(captured: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_if_fn_body_capture_optional(spine: spine) {
    v2.std.optional.Present { value: first } =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_fn_body) {
        v2.extdeps.languages.dag.ParseSubtreeFound { captured: only } => v2.std.optional.Present { value: only }
        v2.extdeps.languages.dag.ParseSubtreeAbsent => v2.std.optional.Present { value: first }
      }
    v2.std.optional.Absent => v2.std.optional.Absent
  }
}

fn body_lower_if_else_capture_optional(captured: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match v2.std.node.is_empty_conj_root(n: spine) {
    true => v2.std.optional.Absent
    false =>
      match body_lower_match_spine_left(spine: spine) {
      v2.std.optional.Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          v2.std.optional.Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              v2.std.optional.Present { value: id } =>
                match id == ^dag_token_kw_else {
                  true =>
                    match body_lower_find_captured(root: right, emitted: ^dag_surface_if_expr) {
                      v2.extdeps.languages.dag.ParseSubtreeFound { captured: nested } => v2.std.optional.Present { value: nested }
                      v2.extdeps.languages.dag.ParseSubtreeAbsent =>
                        match body_lower_if_fn_body_capture_optional(spine: right) {
                          v2.std.optional.Present { value: body } => v2.std.optional.Present { value: body }
                          v2.std.optional.Absent =>
                            match body_lower_if_expr_capture_optional(spine: right) {
                              v2.std.optional.Present { value: expr } => v2.std.optional.Present { value: expr }
                              v2.std.optional.Absent => v2.std.optional.Absent
                            }
                        }
                    }
                  false =>
                    match body_lower_if_else_capture_optional(captured: left) {
                      v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                      v2.std.optional.Absent => body_lower_if_else_capture_optional(captured: right)
                    }
                }
              v2.std.optional.Absent =>
                match body_lower_if_else_capture_optional(captured: left) {
                  v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                  v2.std.optional.Absent => body_lower_if_else_capture_optional(captured: right)
                }
            }
          v2.std.optional.Absent => v2.std.optional.Absent
        }
      v2.std.optional.Absent =>
        fold(spine.children, init: v2.std.optional.Absent, f: fn(acc, e) {
          match acc {
            v2.std.optional.Present { value: _ } => acc
            v2.std.optional.Absent => body_lower_if_else_capture_optional(captured: e.target)
          }
        })
      }
  }
}

fn body_lower_if_condition_optional(captured: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match v2.std.node.is_empty_conj_root(n: spine) {
    true => v2.std.optional.Absent
    false =>
      match body_lower_match_spine_left(spine: spine) {
      v2.std.optional.Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          v2.std.optional.Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              v2.std.optional.Present { value: id } =>
                match id == ^dag_token_kw_if {
                  true => body_lower_if_expr_capture_optional(spine: right)
                  false =>
                    match body_lower_if_condition_optional(captured: left) {
                      v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                      v2.std.optional.Absent => body_lower_if_condition_optional(captured: right)
                    }
                }
              v2.std.optional.Absent =>
                match body_lower_operand_ref_optional(node: left) {
                  v2.std.optional.Present { value: op } => v2.std.optional.Present { value: op }
                  v2.std.optional.Absent =>
                    match body_lower_if_condition_optional(captured: left) {
                      v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
                      v2.std.optional.Absent => body_lower_if_condition_optional(captured: right)
                    }
                }
            }
          v2.std.optional.Absent => v2.std.optional.Absent
        }
      v2.std.optional.Absent => body_lower_if_expr_capture_optional(spine: spine)
      }
  }
}

fn body_lower_if_then_arm_optional(captured: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
