fn body_lower_try_let_in_from_captured(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_let_in_body_capture_optional(captured: captured) {
    v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
    v2.std.optional.Present { value: _ } =>
    match body_lower_let_in_key_binding_optional(captured: captured) {
      v2.std.optional.Present { value: key_binding } =>
        match body_lower_let_in_value_capture_optional(captured: captured) {
          v2.std.optional.Present { value: value_capture } =>
            match body_lower_let_in_body_capture_optional(captured: captured) {
              v2.std.optional.Present { value: body_capture } =>
                match body_lower_materialize_int_literal_operand_optional(node: value_capture) {
                  v2.std.optional.Present { value: value } =>
                    match body_lower_operand_ref_optional(node: body_capture) {
                      v2.std.optional.Present { value: body_ref } =>
                        v2.std.diagnostic.outcome_accepted(
                          value: v2.std.optional.optional_present(
                            value: v2.std.compilers.body_lowering.lower_bind(
                              key_binding: body_lower_type_atom_node(sym: key_binding),
                              value: value,
                              body_binding: body_ref
                            )
                          )
                        )
                      v2.std.optional.Absent =>
                        match body_lower_arm_operand_resolved_optional(arm: body_capture) {
                          v2.std.optional.Present { value: body_ref } =>
                            v2.std.diagnostic.outcome_accepted(
                              value: v2.std.optional.optional_present(
                                value: v2.std.compilers.body_lowering.lower_bind(
                                  key_binding: body_lower_type_atom_node(sym: key_binding),
                                  value: value,
                                  body_binding: body_ref
                                )
                              )
                            )
                          v2.std.optional.Absent => body_lower_let_navigation_reject(captured: captured)
                        }
                    }
                  v2.std.optional.Absent =>
                    match body_lower_arm_operand_resolved_optional(arm: value_capture) {
                      v2.std.optional.Present { value: value } =>
                        match body_lower_operand_ref_optional(node: body_capture) {
                          v2.std.optional.Present { value: body_ref } =>
                            v2.std.diagnostic.outcome_accepted(
                              value: v2.std.optional.optional_present(
                                value: v2.std.compilers.body_lowering.lower_bind(
                                  key_binding: body_lower_type_atom_node(sym: key_binding),
                                  value: value,
                                  body_binding: body_ref
                                )
                              )
                            )
                          v2.std.optional.Absent =>
                            match body_lower_arm_operand_resolved_optional(arm: body_capture) {
                              v2.std.optional.Present { value: body_ref } =>
                                v2.std.diagnostic.outcome_accepted(
                                  value: v2.std.optional.optional_present(
                                    value: v2.std.compilers.body_lowering.lower_bind(
                                      key_binding: body_lower_type_atom_node(sym: key_binding),
                                      value: value,
                                      body_binding: body_ref
                                    )
                                  )
                                )
                              v2.std.optional.Absent => body_lower_let_navigation_reject(captured: captured)
                            }
                        }
                      v2.std.optional.Absent => body_lower_let_navigation_reject(captured: captured)
                    }
                }
              v2.std.optional.Absent => body_lower_let_navigation_reject(captured: captured)
            }
          v2.std.optional.Absent => body_lower_let_navigation_reject(captured: captured)
        }
      v2.std.optional.Absent => body_lower_let_navigation_reject(captured: captured)
    }
  }
}

fn body_lower_try_let_in_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    v2.std.optional.Present { value: emitted } =>
      if emitted == ^dag_surface_let_expr {
        match body_lower_unwrap_captured(shell: node) {
          v2.std.optional.Present { value: captured } =>
            body_lower_try_let_in_from_captured(captured: captured)
          v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: emitted) {
        match body_lower_unwrap_captured(shell: node) {
          v2.std.optional.Present { value: captured } => body_lower_try_let_in_from_node(node: captured)
          v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        }
      } else {
        v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
      }
    v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
  }
}

fn body_lower_try_loop_expr_from_captured(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  body_lower_try_loop_keyword_from_captured(captured: captured)
