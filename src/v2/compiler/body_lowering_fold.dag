      }
  }
}

fn body_lower_try_loop_keyword_from_captured(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    v2.std.optional.Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        v2.std.optional.Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            v2.std.optional.Present { value: id } =>
              if id == ^dag_token_kw_loop {
                match body_lower_materialize_int_literal_operand_optional(node: right) {
                  v2.std.optional.Present { value: lit } =>
                    v2.std.diagnostic.outcome_accepted(
                      value: v2.std.optional.optional_present(
                        value: v2.std.compilers.body_lowering.lower_loop(value: lit, bound: v2.extdeps.languages.dag.dag_loop_measure_node())
                      )
                    )
                  v2.std.optional.Absent =>
                    match body_lower_arm_operand_resolved_optional(arm: right) {
                      v2.std.optional.Present { value: lit } =>
                        v2.std.diagnostic.outcome_accepted(
                          value: v2.std.optional.optional_present(
                            value: v2.std.compilers.body_lowering.lower_loop(value: lit, bound: v2.extdeps.languages.dag.dag_loop_measure_node())
                          )
                        )
                      v2.std.optional.Absent => body_lower_loop_navigation_reject(captured: captured)
                    }
                }
              } else {
                match body_lower_try_loop_keyword_from_captured(captured: left) {
                  v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                  v2.std.diagnostic.Accepted { value: left_found, diagnostics: ld } =>
                    match left_found {
                      v2.std.optional.Present { value: lowered } =>
                        outcome_with_diagnostics(
                          value: v2.std.optional.optional_present(value: lowered),
                          diagnostics: ld
                        )
                      v2.std.optional.Absent => body_lower_try_loop_keyword_from_captured(captured: right)
                    }
                }
              }
            v2.std.optional.Absent =>
              match body_lower_try_loop_keyword_from_captured(captured: left) {
                v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                v2.std.diagnostic.Accepted { value: left_found, diagnostics: ld } =>
                  match left_found {
                    v2.std.optional.Present { value: lowered } =>
                      outcome_with_diagnostics(
                        value: v2.std.optional.optional_present(value: lowered),
                        diagnostics: ld
                      )
                    v2.std.optional.Absent => body_lower_try_loop_keyword_from_captured(captured: right)
                  }
              }
          }
        v2.std.optional.Absent =>
          match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: spine) {
            v2.std.optional.Present { value: pair } =>
              match body_lower_try_loop_keyword_from_captured(captured: pair.left) {
                v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                v2.std.diagnostic.Accepted { value: left_found, diagnostics: ld } =>
                  match left_found {
                    v2.std.optional.Present { value: lowered } =>
                      outcome_with_diagnostics(
                        value: v2.std.optional.optional_present(value: lowered),
                        diagnostics: ld
                      )
                    v2.std.optional.Absent => body_lower_try_loop_keyword_from_captured(captured: pair.right)
                  }
              }
            v2.std.optional.Absent =>
              fold(spine.children, init: v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent()), f: fn(acc, e) {
                match acc {
                  v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                  v2.std.diagnostic.Accepted { value: found, diagnostics: _ } =>
                    match found {
                      v2.std.optional.Present { value: _ } => acc
                      v2.std.optional.Absent => body_lower_try_loop_keyword_from_captured(captured: e.target)
                    }
                }
              })
          }
      }
    v2.std.optional.Absent =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: spine) {
        v2.std.optional.Present { value: pair } =>
          match body_lower_try_loop_keyword_from_captured(captured: pair.left) {
            v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
            v2.std.diagnostic.Accepted { value: left_found, diagnostics: ld } =>
              match left_found {
                v2.std.optional.Present { value: lowered } =>
                  outcome_with_diagnostics(
                    value: v2.std.optional.optional_present(value: lowered),
                    diagnostics: ld
                  )
                v2.std.optional.Absent => body_lower_try_loop_keyword_from_captured(captured: pair.right)
              }
          }
        v2.std.optional.Absent =>
          fold(spine.children, init: v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent()), f: fn(acc, e) {
            match acc {
              v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
              v2.std.diagnostic.Accepted { value: found, diagnostics: _ } =>
                match found {
                  v2.std.optional.Present { value: _ } => acc
                  v2.std.optional.Absent => body_lower_try_loop_keyword_from_captured(captured: e.target)
                }
            }
          })
      }
  }
}

fn body_lower_try_loop_keyword_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    v2.std.optional.Present { value: emitted } =>
      if emitted == ^dag_surface_loop_expr {
        match body_lower_unwrap_captured(shell: node) {
          v2.std.optional.Present { value: captured } =>
            body_lower_try_loop_keyword_from_captured(captured: captured)
          v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        }
      } else if emitted == ^dag_surface_primary_expr {
        match body_lower_unwrap_captured(shell: node) {
          v2.std.optional.Present { value: captured } =>
            body_lower_try_loop_keyword_from_captured(captured: captured)
          v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: emitted) {
        match body_lower_unwrap_captured(shell: node) {
          v2.std.optional.Present { value: captured } => body_lower_try_loop_keyword_from_node(node: captured)
          v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        }
      } else {
        v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
      }
    v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
  }
}

fn body_lower_try_if_from_captured(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_if_condition_optional(captured: captured) {
    v2.std.optional.Present { value: condition_capture } =>
      match body_lower_if_then_arm_optional(captured: captured) {
        v2.std.optional.Present { value: then_capture } =>
          match body_lower_if_else_capture_optional(captured: captured) {
            v2.std.optional.Present { value: else_capture } =>
              match body_lower_if_arm_operand_optional(arm_capture: condition_capture) {
                v2.std.optional.Present { value: condition_raw } =>
                  match body_lower_arm_operand_resolved_optional(arm: condition_raw) {
                    v2.std.optional.Present { value: condition } =>
                      match body_lower_if_arm_operand_optional(arm_capture: then_capture) {
                        v2.std.optional.Present { value: then_raw } =>
                          match body_lower_arm_operand_resolved_optional(arm: then_raw) {
                            v2.std.optional.Present { value: then_arm } =>
                              match body_lower_if_arm_operand_optional(arm_capture: else_capture) {
                                v2.std.optional.Present { value: else_raw } =>
                                  match body_lower_arm_operand_resolved_optional(arm: else_raw) {
                                    v2.std.optional.Present { value: else_arm } =>
                                      v2.std.diagnostic.outcome_accepted(
                                        value: v2.std.optional.optional_present(
                                          value: v2.std.compilers.body_lowering.lower_branch(
                                            condition: condition,
                                            then_arm: then_arm,
                                            else_arm: else_arm
                                          )
                                        )
                                      )
                                    v2.std.optional.Absent => body_lower_if_navigation_reject(captured: else_capture)
                                  }
                                v2.std.optional.Absent => body_lower_if_navigation_reject(captured: else_capture)
                              }
                            v2.std.optional.Absent => body_lower_if_navigation_reject(captured: then_capture)
                          }
                        v2.std.optional.Absent => body_lower_if_navigation_reject(captured: then_capture)
                      }
                    v2.std.optional.Absent => body_lower_if_navigation_reject(captured: condition_capture)
                  }
                v2.std.optional.Absent => body_lower_if_navigation_reject(captured: condition_capture)
              }
            v2.std.optional.Absent => body_lower_if_navigation_reject(captured: captured)
          }
        v2.std.optional.Absent => body_lower_if_navigation_reject(captured: captured)
      }
    v2.std.optional.Absent => body_lower_if_navigation_reject(captured: captured)
  }
}

fn body_lower_if_expr(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_unwrap_captured(shell: shell) {
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    v2.std.optional.Present { value: captured } =>
      match body_lower_try_if_from_captured(captured: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            v2.std.optional.Present { value: lowered } =>
              v2.std.diagnostic.Accepted { value: lowered, diagnostics: d }
            v2.std.optional.Absent =>
              v2.std.diagnostic.outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

fn body_lower_match_arms_from_brace_interior(interior: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.node.Node>> {
  let unwrapped = body_lower_postfix_optional_unwrap(node: interior)
  match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: unwrapped) {
    v2.std.optional.Present { value: pair } =>
      body_lower_collect_match_arms(
        sequence_capture: body_lower_unwrap_optional_element(node: pair.left)
      )
    v2.std.optional.Absent =>
      body_lower_collect_match_arms(sequence_capture: unwrapped)
  }
}

fn body_lower_match_spine_left(spine: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.node_query.find_named_child(root: spine, name: ^grammar_sequence_left_node_projection) {
    v2.std.diagnostic.Accepted { value: left, diagnostics: _ } => v2.std.optional.Present { value: left }
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: spine) {
        v2.std.optional.Present { value: pair } => v2.std.optional.Present { value: pair.left }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
  }
}

fn body_lower_match_spine_right(spine: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match v2.std.node_query.find_named_child(root: spine, name: ^grammar_sequence_right_node_projection) {
    v2.std.diagnostic.Accepted { value: right, diagnostics: _ } => v2.std.optional.Present { value: right }
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: spine) {
        v2.std.optional.Present { value: pair } => v2.std.optional.Present { value: pair.right }
        v2.std.optional.Absent => v2.std.optional.Absent
      }
  }
}

fn body_lower_match_scrutinee_on_token(id: v2.std.node.Symbol, left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match id == ^dag_token_lbrace {
    true => v2.std.optional.Absent
    false =>
      match id == ^dag_token_kw_match {
        true => body_lower_match_scrutinee_from_spine(spine: right)
        false =>
          match body_lower_operand_ref_optional(node: left) {
            v2.std.optional.Present { value: op } => v2.std.optional.Present { value: op }
            v2.std.optional.Absent => body_lower_match_scrutinee_from_spine(spine: right)
          }
      }
  }
}

fn body_lower_match_scrutinee_from_spine(spine: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  if v2.std.node.is_empty_conj_root(n: spine) {
    v2.std.optional.Absent
  } else {
    match body_lower_match_spine_left(spine: spine) {
      v2.std.optional.Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          v2.std.optional.Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              v2.std.optional.Present { value: id } =>
                body_lower_match_scrutinee_on_token(id: id, left: left, right: right)
              v2.std.optional.Absent =>
                match body_lower_operand_ref_optional(node: left) {
                  v2.std.optional.Present { value: op } => v2.std.optional.Present { value: op }
                  v2.std.optional.Absent => body_lower_match_scrutinee_from_spine(spine: right)
                }
            }
          v2.std.optional.Absent => v2.std.optional.Absent
        }
      v2.std.optional.Absent => v2.std.optional.Absent
    }
  }
}

fn body_lower_match_scrutinee_optional(captured: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_binary_expr) {
    v2.extdeps.languages.dag.ParseSubtreeFound { captured: binary } =>
      body_lower_operand_ref_optional(node: binary)
    v2.extdeps.languages.dag.ParseSubtreeAbsent =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_postfix_expr) {
        v2.extdeps.languages.dag.ParseSubtreeFound { captured: postfix } =>
          body_lower_operand_ref_optional(node: postfix)
        v2.extdeps.languages.dag.ParseSubtreeAbsent =>
          body_lower_match_scrutinee_from_spine(
            spine: body_lower_unwrap_surface_shell(node: captured)
          )
      }
  }
}

fn body_lower_match_arms_on_lbrace_token(id: v2.std.node.Symbol, right: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<List<v2.std.node.Node>>> {
  match id == ^dag_token_lbrace {
    true =>
      match body_lower_match_arms_from_brace_interior(interior: right) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: arms, diagnostics: d } =>
          if count(arms) > 0 {
            v2.std.diagnostic.Accepted {
              value: v2.std.optional.optional_present(value: arms),
              diagnostics: d
            }
          } else {
            v2.std.diagnostic.outcome_rejected(
              d: body_lower_diagnostic(
                reason: ^body_lowering_reason_match_arm_navigation_refused,
                n: right
              )
            )
          }
      }
    false => body_lower_match_arms_after_lbrace_optional(spine: right)
  }
}

fn body_lower_match_arms_after_lbrace_optional(spine: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<List<v2.std.node.Node>>> {
  if v2.std.node.is_empty_conj_root(n: spine) {
    v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
  } else {
    match body_lower_match_spine_left(spine: spine) {
      v2.std.optional.Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          v2.std.optional.Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              v2.std.optional.Present { value: id } =>
                body_lower_match_arms_on_lbrace_token(id: id, right: right)
              v2.std.optional.Absent =>
                body_lower_match_arms_after_lbrace_optional(spine: right)
            }
          v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
        }
      v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: v2.std.optional.optional_absent())
    }
  }
}

fn body_lower_match_arms_optional(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<List<v2.std.node.Node>>> {
  body_lower_match_arms_after_lbrace_optional(
    spine: body_lower_unwrap_surface_shell(node: captured)
  )
}

fn body_lower_try_match_from_captured(captured: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match body_lower_match_scrutinee_optional(captured: captured) {
    v2.std.optional.Present { value: scrutinee } =>
      match body_lower_match_arms_optional(captured: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: arms_opt, diagnostics: d } =>
          match arms_opt {
            v2.std.optional.Present { value: arms } =>
              if count(arms) > 0 {
                v2.std.diagnostic.Accepted {
                  value: v2.std.optional.optional_present(value: v2.std.compilers.body_lowering.lower_match(scrutinee: scrutinee, arms: arms)),
                  diagnostics: d
                }
              } else {
                v2.std.diagnostic.outcome_rejected(
                  d: body_lower_diagnostic(
                    reason: ^body_lowering_reason_match_arm_navigation_refused,
                    n: captured
                  )
                )
              }
            v2.std.optional.Absent =>
              v2.std.diagnostic.outcome_rejected(
                d: body_lower_diagnostic(
                  reason: ^body_lowering_reason_match_arm_navigation_refused,
                  n: captured
                )
              )
          }
      }
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: body_lower_diagnostic(
          reason: ^body_lowering_reason_match_arm_navigation_refused,
          n: captured
        )
      )
  }
}

fn body_lower_match_capture_heads_spine(spine: v2.std.node.Node) -> Bool {
  match body_lower_match_spine_left(spine: spine) {
    v2.std.optional.Present { value: left } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
        v2.std.optional.Present { value: id } => id == ^dag_token_kw_match
        v2.std.optional.Absent => false
      }
    v2.std.optional.Absent => false
  }
}

fn body_lowering_match_spine_identity_absent_fixture_spine() -> v2.std.node.Node {
  let match_kw = v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_token_kw_match } },
    children: []
  )
  let tail = v2.std.node.node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Conj }, children: [])
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^grammar_sequence_left_node_projection },
        target: match_kw
      },
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^grammar_sequence_right_node_projection },
        target: tail
      }
    ]
  )
}

fn body_lowering_match_spine_identity_absent_sniff_holds() -> Bool {
  body_lower_match_capture_heads_spine(
    spine: body_lowering_match_spine_identity_absent_fixture_spine()
  )
}

fn body_lowering_match_spine_identity_absent_dispatch_holds() -> Bool {
  let fixture = body_lowering_match_spine_identity_absent_fixture_spine()
  if !body_lower_match_capture_heads_spine(spine: fixture) {
    false
  } else {
    match body_lower_fold_reduce(node: fixture) {
      v2.std.diagnostic.Rejected { diagnostics: _ } => false
      v2.std.diagnostic.Accepted { value: reduced, diagnostics: _ } =>
        match body_lower_fold_identity_absent(node: fixture) {
          v2.std.diagnostic.Rejected { diagnostics: _ } => true
          v2.std.diagnostic.Accepted { value: dispatched, diagnostics: _ } =>
            body_lower_is_core_substrate(node: dispatched) || dispatched != reduced
        }
    }
  }
}

fn body_lower_match_expr(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_unwrap_captured(shell: shell) {
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    v2.std.optional.Present { value: captured } =>
      match body_lower_try_match_from_captured(captured: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            v2.std.optional.Present { value: lowered } =>
              v2.std.diagnostic.Accepted { value: lowered, diagnostics: d }
            v2.std.optional.Absent =>
              v2.std.diagnostic.outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

fn body_lower_postfix_expr(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_unwrap_captured(shell: shell) {
    v2.std.optional.Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    v2.std.optional.Present { value: captured } =>
      match body_lower_pattern_first_atom_optional(node: captured) {
        v2.std.optional.Present { value: atom } => v2.std.diagnostic.outcome_accepted(value: atom)
        v2.std.optional.Absent =>
      match body_lower_try_postfix_projection(node: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } =>
          match body_lower_literal_bool_atom_optional(node: captured) {
            v2.std.optional.Present { value: lit } => v2.std.diagnostic.outcome_accepted(value: lit)
            v2.std.optional.Absent =>
              match body_lower_pattern_first_atom_optional(node: captured) {
                v2.std.optional.Present { value: atom } => v2.std.diagnostic.outcome_accepted(value: atom)
                v2.std.optional.Absent => v2.std.diagnostic.Rejected { diagnostics: r }
              }
          }
        v2.std.diagnostic.Accepted { value: found, diagnostics: d } =>
          match found {
            v2.std.optional.Present { value: transform } =>
              v2.std.diagnostic.Accepted { value: transform, diagnostics: d }
            v2.std.optional.Absent =>
              match body_lower_try_infix_transform(node: captured) {
                v2.std.optional.Present { value: transform } => v2.std.diagnostic.outcome_accepted(value: transform)
                v2.std.optional.Absent =>
                  match body_lower_try_fold_loop(node: captured) {
                    v2.std.diagnostic.Rejected { diagnostics: _ } =>
                      body_lower_try_operand_or_reject(shell: shell, captured: captured)
                    v2.std.diagnostic.Accepted { value: fold_result, diagnostics: _ } =>
                      match fold_result {
                        v2.std.optional.Present { value: loop_node } => v2.std.diagnostic.outcome_accepted(value: loop_node)
                        v2.std.optional.Absent => body_lower_try_operand_or_reject(shell: shell, captured: captured)
                      }
                  }
              }
          }
      }
      }
  }
}

fn body_lower_primary_expr(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let captured = match body_lower_unwrap_captured(shell: shell) {
    v2.std.optional.Present { value: inner } => inner
    v2.std.optional.Absent => shell
  }
  match body_lower_literal_int_atom_optional(node: captured) {
        v2.std.optional.Present { value: lit } => v2.std.diagnostic.outcome_accepted(value: lit)
        v2.std.optional.Absent =>
      match body_lower_try_loop_keyword_from_captured(captured: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: loop_opt, diagnostics: ld } =>
          match loop_opt {
            v2.std.optional.Present { value: loop_node } =>
              v2.std.diagnostic.Accepted { value: loop_node, diagnostics: ld }
            v2.std.optional.Absent =>
      match body_lower_pattern_first_atom_optional(node: captured) {
        v2.std.optional.Present { value: atom } => v2.std.diagnostic.outcome_accepted(value: atom)
        v2.std.optional.Absent =>
      match body_lower_try_primary_ident_call(node: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: primary_call, diagnostics: d } =>
          match primary_call {
            v2.std.optional.Present { value: transform } =>
              v2.std.diagnostic.Accepted { value: transform, diagnostics: d }
            v2.std.optional.Absent =>
      match body_lower_try_postfix_projection(node: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } =>
          match body_lower_literal_bool_atom_optional(node: captured) {
            v2.std.optional.Present { value: lit } => v2.std.diagnostic.outcome_accepted(value: lit)
            v2.std.optional.Absent =>
              match body_lower_pattern_first_atom_optional(node: captured) {
                v2.std.optional.Present { value: atom } => v2.std.diagnostic.outcome_accepted(value: atom)
                v2.std.optional.Absent => v2.std.diagnostic.Rejected { diagnostics: r }
              }
          }
        v2.std.diagnostic.Accepted { value: found, diagnostics: d2 } =>
          match found {
            v2.std.optional.Present { value: transform } =>
              v2.std.diagnostic.Accepted { value: transform, diagnostics: d2 }
            v2.std.optional.Absent =>
              match body_lower_try_infix_transform(node: captured) {
                v2.std.optional.Present { value: transform } => v2.std.diagnostic.outcome_accepted(value: transform)
                v2.std.optional.Absent =>
                  match body_lower_try_fold_loop(node: captured) {
                    v2.std.diagnostic.Rejected { diagnostics: _ } =>
                      body_lower_try_operand_or_reject(shell: shell, captured: captured)
                    v2.std.diagnostic.Accepted { value: fold_result, diagnostics: _ } =>
                      match fold_result {
                        v2.std.optional.Present { value: loop_node } => v2.std.diagnostic.outcome_accepted(value: loop_node)
                        v2.std.optional.Absent => body_lower_try_operand_or_reject(shell: shell, captured: captured)
                      }
                  }
              }
          }
      }
      }
      }
      }
      }
      }
  }
}

fn body_lower_fn_body_shell(shell: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_unwrap_captured(shell: shell) {
    v2.std.optional.Absent => body_lower_wrapper_retained_shell(shell: shell)
    v2.std.optional.Present { value: captured } =>
      match body_lower_body_subtree_lower(captured: captured) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            v2.std.optional.Present { value: lowered } => outcome_with_diagnostics(value: lowered, diagnostics: d)
            v2.std.optional.Absent => body_lower_wrapper_retained_shell(shell: shell)
          }
      }
  }
}

fn body_lower_forward_row_apply(shell: v2.std.node.Node, emitted: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if emitted == ^dag_surface_fn_decl {
    body_lower_fn_decl_to_arrow(shell: shell)
  } else if emitted == ^dag_surface_fn_body {
    body_lower_fn_body_shell(shell: shell)
  } else if emitted == ^dag_surface_match_expr {
    body_lower_match_expr(shell: shell)
  } else if emitted == ^dag_surface_if_expr {
    body_lower_if_expr(shell: shell)
  } else if emitted == ^dag_surface_loop_expr {
    body_lower_loop_expr(shell: shell)
  } else if emitted == ^dag_surface_let_expr {
    body_lower_let_expr(shell: shell)
  } else {
    body_lower_wrapper_retained_shell(shell: shell)
  }
}

fn body_lower_production_emitted(shell: v2.std.node.Node, emitted: v2.std.node.Symbol, fn_body_pass_through: Bool) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
    v2.std.diagnostic.outcome_accepted(value: shell)
  } else if emitted == ^dag_surface_fn_body && fn_body_pass_through {
    v2.std.diagnostic.outcome_accepted(value: shell)
  } else if body_lower_is_deferred_lower_emitted(emitted: emitted) {
    v2.std.diagnostic.outcome_accepted(value: shell)
  } else if v2.compiler.body_producer_forward.body_producer_forward_is_registered_surface_identity(surface_identity: emitted) {
    body_lower_forward_row_apply(shell: shell, emitted: emitted)
  } else if emitted == ^dag_surface_postfix_expr {
    body_lower_postfix_expr(shell: shell)
  } else if body_lower_is_pass_through_emitted(emitted: emitted) {
    body_lower_unwrap_pass_through(shell: shell)
  } else if emitted == ^dag_surface_primary_expr {
    body_lower_primary_expr(shell: shell)
  } else {
    body_lower_wrapper_retained_shell(shell: shell)
  }
}

fn body_lower_after_children(folded: v2.std.node.Node, fn_body_pass_through: Bool) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if body_lower_is_core_substrate(node: folded) {
    v2.std.diagnostic.outcome_accepted(value: folded)
  } else if v2.extdeps.languages.dag.dag_resolve_preserve_module_metadata_subtree(node: folded) {
    v2.std.diagnostic.outcome_accepted(value: folded)
  } else {
    match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: folded) {
      v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(value: folded)
      v2.std.optional.Present { value: emitted } =>
        body_lower_production_emitted(
          shell: folded,
          emitted: emitted,
          fn_body_pass_through: fn_body_pass_through
        )
    }
  }
}

fn body_lower_finish(n: v2.std.node.Node, folded: v2.std.node.Node, cd: v2.std.diagnostic.Diagnostics) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  body_lower_finish_for_normalize(
    n: n,
    folded: folded,
    cd: cd,
    fn_body_pass_through: false
  )
}

fn body_lower_finish_for_normalize(
  n: v2.std.node.Node,
  folded: v2.std.node.Node,
  cd: v2.std.diagnostic.Diagnostics,
  fn_body_pass_through: Bool
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body_lower_after_children(folded: folded, fn_body_pass_through: fn_body_pass_through) {
    v2.std.diagnostic.Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.rejected_with_pending(pending: cd, rejected: r) }
    v2.std.diagnostic.Accepted { value: lowered, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: lowered,
        diagnostics: v2.std.diagnostic.diagnostics_merge(outer: cd, inner: d)
      }
  }
}

