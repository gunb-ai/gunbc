data body_lowering_fold_note: String = "Forward body producer fold (general-body-producer Stage A remainder + B/C/D): production-identity dispatch in normalize AFTER child-fold, BEFORE sugar (body_lower_finish in 03_normalize.dag). INTERIM scaffold — dissolves into v2.compiler.body_producer_forward GrammarRelationRow forward fold (general-body-producer-design §3) once Slice 4 deletes this module; match/if/body_try hand-walker scaffolds dissolved into body_producer_forward + body_lower_fold. COMPLEMENTS #6443 fold_lowering.dag — does NOT re-fork it. Seam: fold_lowering owns fold-CALL semantic desugar (callee-head keyed: ^fold/^fold_list/… → the fold encoding via fold_call_lowering and fold_recurrence_encoding); body_lowering_fold owns fn-BODY shape lowering (fn_decl→Arrow+domain, infix→Transform, let→Bind, …). The only overlap point is body_lower_try_fold_loop which DELEGATES to fold_call_lowering — one authority, no parallel fold→Loop path. Pass-through expr wrappers unwrap; ^dag_surface_fn_body is deferred (shell retained until parent fn_decl lowers); metadata (module/import/qn) preserved; core substrate (Arrow, ComputationNode) is a positive terminal; out-of-scope emitted identities land wrapper-retained as the typed BodyWrapperRetained variant (general-body-producer-design Stage A frontier: lowered | wrapper-retained, refused at the retained shell by the normalized-tree door — never silent shell accept)."

data body_lowering_fold_dissolution_contract: DissolutionCondition = unbound_dissolution(description: "FLAG E dissolution DELETES this module — coverage lives in v2.compiler.body_producer_forward forward rows + GrammarRelationRow slot-map apply (general-body-producer-design §3). The hand-authored families (body_lower_deep_unwrap*, body_lower_operand_ref*, body_lower_operator_tail/infix*, body_lower_postfix_projection*) are receipt scaffolding only. Acceptance: this file is gone and coverage lives in forward rows + existing witnesses. match/if/body_try hand-walker scaffolds LANDED: body_lower_try_body_lowered delegates behavior productions to body_lower_fold; body_producer_forward owns the forward row table.")

data body_lowering_rejection_propagation_note: String = "GENUINE REJECTION PROPAGATES; RETENTION IS PRODUCED, NEVER INFERRED FROM FAILURE (2026-08-11). body_lower_finish_for_normalize previously matched EVERY Rejected from body_lower_after_children and returned a wrapper-retained Accepted instead, binding the rejection diagnostics to _ and discarding them. That conflated four different states behind one arm: this lowering strategy does not apply, this valid form has no producer yet, this form is malformed, and an invariant was violated. It is the inverse of the not-applicable-versus-malformed conflation #6558 already ruled on, moved out to the outer seam.\n\nThe repair is a deletion rather than a new mechanism, because the legitimate case was already explicit: body_lower_production_emitted's final arm returns body_lower_wrapper_retained_shell for an emitted identity with no registered producer. That IS the declared lowered | wrapper-retained frontier, produced deliberately at the point where not-applicable is known. The outer catch was therefore a second, inferential source of retention standing beside the real one, and it could only fire on outcomes the strategy functions had already judged. So retention now has exactly one producer, and the outer Outcome owns genuine rejection with its diagnostics preserved through rejected_with_pending.\n\nWHAT THIS DOES NOT DO: it does not scope, weaken or relocate normalize's recursive well_formed gate, which #6520 established as the sole structural wall and which stays unchanged. Modules whose retained bodies still fail that gate continue to fail it; this change only stops a real refusal from being relabelled as a counted frontier state on its way there."

data body_lowering_interim_scaffold_dissolved_note: String = "Wave 1 Gate 1 Track B: match/if/body_try interim hand-walker scaffolds dissolved into body_producer_forward (forward row table + production-identity dispatch via body_lower_fold). body_lowering_interim_scaffold_seed_retained_count is pinned at 0 — RED if any SeedRetained scaffold reappears."

// Wave 1 Gate 1 A1/B1: param-name domain harvesting is terminal param-list-walk (declaration
// reading, not SymbolIndex resolution). BodyLoweringDomainSymbolIndexResolved deleted in B1 —
// uninhabited variant with no migration trigger (operator ruling 2026-07-14).

fn body_lowering_interim_scaffold_seed_retained_count() -> Int {
  0
}

fn body_lowering_forward_behavior_row_count() -> Int {
  body_producer_forward_row_count()
}

fn body_lower_fold_behavior_surface_identities() -> List<Symbol> {
  body_producer_forward_surface_identities()
}

fn body_lowering_surface_identity_list_contains(xs: List<Symbol>, target: Symbol) -> Bool {
  fold(xs, init: false, f: fn(acc, id) { acc || id == target })
}

fn body_lowering_forward_fold_surface_identities_agree() -> Bool {
  let forward = body_producer_forward_surface_identities()
  let fold_ids = body_lower_fold_behavior_surface_identities()
  if length(xs: forward) != length(xs: fold_ids) {
    false
  } else {
    fold(forward, init: true, f: fn(acc, id) {
      acc && body_lowering_surface_identity_list_contains(xs: fold_ids, target: id)
    })
  }
}

// WRAPPER RETENTION IS A TYPED VALUE, NOT A DIAGNOSTIC REASON (MQ-4). A shell this lowering has no
// producer for is RETAINED: it stays in the tree as its parse shell, and the module that holds it
// must not be admitted as normalized. Retention used to travel as an advisory Diagnostic whose
// reason was body_lowering_reason_wrapper_retained_emitted, and every reader -- the NormalizedTree
// door, the census door, the frontier classifier -- recovered it by scanning diagnostic REASONS: a
// classifier over an encoding, correct only while exactly one producer spelled the reason exactly
// one way, and silently wrong the moment a helper merged diagnostics with `_`.
//
// It is now a variant of the lowering's own result. WrapperRetention is minted ONLY by
// body_lower_wrapper_retained_shell (sole_constructor confines the construction to this module, and
// that function is its one call site here), and a retained result is the BodyWrapperRetained arm of
// BodyLowering, so no reader can take the lowered Node without matching the arm that is not one.
// That is the drop guarantee, stated at its honest rung: .dag has no module-private declarations,
// so a discard is still WRITABLE -- by a match arm that names BodyWrapperRetained and drops it, or
// by any reader that projects BodyLoweredTree.node and ignores .retained -- but never by a silent
// `diagnostics: _`. The arms that exist are exactly three: the value-position
// unwrap below REFUSES, the frontier classifier REPORTS, and v2.compiler.normalize threads the
// retention into its accumulator (BodyLoweredTree) for v2.compiler.normalized_tree to refuse at the
// retained shell's own locus.
type WrapperRetention sole_constructor {
  shell: Node,
}

type BodyLowering
  = BodyLowered { node: Node }
  | BodyWrapperRetained { retention: WrapperRetention }

// THE LOWERING OF A SUBTREE, with every retention found beneath it. This is normalize's accumulator,
// declared here beside the variant it accumulates. Its two fields are one fact -- `node` is admitted
// only when `retained` is empty -- so the only readers are the combinators below, which always carry
// `retained` forward, and v2.compiler.normalized_tree admit_retention_free, the one place a Node
// leaves it.
type BodyLoweredTree sole_constructor {
  node: Node,
  retained: FreeMonoid<WrapperRetention>,
}

// The one refusal cause for a retained wrapper, located at the retained SHELL rather than at the
// module root. It is the cause v2.workflow.compile_door_cause_ownership already rosters for the
// normalized-tree door, because the refusal is the same fact wherever it fires.
fn wrapper_retention_diagnostic(r: WrapperRetention) -> Diagnostic {
  body_lower_diagnostic(reason: ^normalized_tree_reason_wrapper_retention_not_normalized, n: r.shell)
}

// Earlier retentions first, so the typed population stays in structural order; an empty later list, the
// common case, costs nothing.
fn wrapper_retentions_concat(
  earlier: FreeMonoid<WrapperRetention>,
  later: FreeMonoid<WrapperRetention>
) -> FreeMonoid<WrapperRetention> {
  match later {
    Empty => earlier
    Cons { head: _, tail: _ } => list_append(left: earlier, right: later)
  }
}

fn no_wrapper_retentions() -> FreeMonoid<WrapperRetention> {
  Empty
}

// A lowering that cannot retain, lifted. Safe in one direction only: nothing is discarded.
fn body_lowering_lowered(o: Outcome<Node>) -> Outcome<BodyLowering> {
  match o {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: n, diagnostics: d } => Accepted { value: BodyLowered { node: n }, diagnostics: d }
  }
}

// VALUE POSITION REFUSES A RETENTION. The bottom-up value fold (body_lower_reduce_emitted) reaches
// the declaration producers, and its result is read as a lowered value by the walker, which has no
// channel to carry a retention and whose helpers merge diagnostics with `_`. So a retention reaching
// value position is refused here, at its shell, with the door's own cause.
fn body_lowering_refuse_retained(o: Outcome<BodyLowering>) -> Outcome<Node> {
  match o {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: lowering, diagnostics: d } =>
      match lowering {
        BodyLowered { node: n } => Accepted { value: n, diagnostics: d }
        BodyWrapperRetained { retention: r } =>
          Rejected {
            diagnostics: rejected_with_pending(
              pending: d,
              rejected: diagnostics_singleton(d: wrapper_retention_diagnostic(r: r))
            )
          }
      }
  }
}

// Diagnostics already gathered before a lowering step ride in front of its result, whichever arm it
// takes -- a retention does not discard what was found before it.
fn body_lowering_after_pending(pending: Diagnostics, o: Outcome<BodyLowering>) -> Outcome<BodyLowering> {
  match o {
    Rejected { diagnostics: r } => Rejected { diagnostics: rejected_with_pending(pending: pending, rejected: r) }
    Accepted { value: lowering, diagnostics: d } =>
      Accepted { value: lowering, diagnostics: diagnostics_merge(outer: pending, inner: d) }
  }
}

// One subtree's lowering as a tree: a retained shell stands in the tree AND in its retained list.
fn body_lowered_tree_of(lowering: BodyLowering) -> BodyLoweredTree {
  match lowering {
    BodyLowered { node: n } => BodyLoweredTree { node: n, retained: no_wrapper_retentions() }
    BodyWrapperRetained { retention: r } =>
      BodyLoweredTree { node: r.shell, retained: Cons { head: r, tail: Empty } }
  }
}

// A node rebuilt over its lowered children, carrying every retention they found.
fn body_lowered_tree_over(node: Node, retained: FreeMonoid<WrapperRetention>) -> BodyLoweredTree {
  BodyLoweredTree { node: node, retained: retained }
}

fn body_lowered_tree_retained(t: BodyLoweredTree) -> FreeMonoid<WrapperRetention> {
  t.retained
}

// Continue a tree's node through one more lowering step, keeping every retention already found and
// adding any the step finds. A retained node is not continued (there is no lowered node to continue).
fn body_lowered_tree_then(
  t: BodyLoweredTree,
  f: fn(Node) -> Outcome<BodyLowering>
) -> Outcome<BodyLoweredTree> {
  match f(t.node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: lowering, diagnostics: d } =>
      match lowering {
        BodyLowered { node: n } =>
          Accepted { value: BodyLoweredTree { node: n, retained: t.retained }, diagnostics: d }
        BodyWrapperRetained { retention: r } =>
          Accepted {
            value: BodyLoweredTree {
              node: r.shell,
              retained: wrapper_retentions_concat(earlier: t.retained, later: Cons { head: r, tail: Empty })
            },
            diagnostics: d
          }
      }
  }
}

// The one place a Node leaves a BodyLoweredTree while the tree is only partly built: a step that
// needs the node to decide what to do next (the graft, the sugar key) reads it through here and
// hands the tree back, so the retained list cannot be dropped on the way.
fn body_lowered_tree_map_node(t: BodyLoweredTree, f: fn(Node) -> Outcome<Node>) -> Outcome<BodyLoweredTree> {
  match f(t.node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: n, diagnostics: d } =>
      Accepted { value: BodyLoweredTree { node: n, retained: t.retained }, diagnostics: d }
  }
}

// THE FRONTIER CLASSIFIER is now a read of the variant. It used to scan diagnostic reasons (and
// before that only the head, which failed open behind any pending diagnostic); with retention a
// variant there is no encoding left to misread.
type BodyLoweringFrontierDisposition
  = BodyLoweringLowered
  | BodyLoweringWrapperRetained { retention: WrapperRetention }
  | BodyLoweringRejected { diagnostics: NonEmptyDiagnostics }

fn body_lower_outcome_frontier_disposition(o: Outcome<BodyLowering>) -> BodyLoweringFrontierDisposition {
  match o {
    Rejected { diagnostics: r } => BodyLoweringRejected { diagnostics: r }
    Accepted { value: lowering, diagnostics: _ } =>
      match lowering {
        BodyLowered { node: _ } => BodyLoweringLowered
        BodyWrapperRetained { retention: r } => BodyLoweringWrapperRetained { retention: r }
      }
  }
}

fn body_lower_outcome_is_wrapper_retained(o: Outcome<BodyLowering>) -> Bool {
  match body_lower_outcome_frontier_disposition(o: o) {
    BodyLoweringWrapperRetained { retention: _ } => true
    BodyLoweringLowered => false
    BodyLoweringRejected { diagnostics: _ } => false
  }
}

fn body_lower_seq_child(node: Node, name: Symbol) -> Optional<Node> {
  match find_named_child(root: node, name: name) {
    Accepted { value: child, diagnostics: _ } => Present { value: child }
    Rejected { diagnostics: _ } => Absent
  }
}

fn body_lower_arrow_domain_named_bindings(root: Node) -> List<Symbol> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: Empty, f: fn(acc, e) {
        match e.label {
          StructuralLabel { label: _ } => acc
          Authored { name: sym } => Cons { head: sym, tail: acc }
          Positional => acc
        }
      })
    TypeNode { connective: Atom { identity: _ } } => Empty
    TypeNode { connective: Disj } => Empty
    TypeNode { connective: Arrow } => Empty
    TypeNode { connective: Cardinality } => Empty
    TypeNode { connective: Instantiation } => Empty
    ComputationNode { behavior: _ } => Empty
  }
}

fn body_lower_binding_symbol_lists_match(
  expected: List<Symbol>,
  actual: List<Symbol>
) -> Bool {
  zip_eq(a: expected, b: actual, eq: fn(left, right) { left == right })
}

// Absent where the list does not read: a list that refused has no binding list to compare against.
fn body_lower_param_binding_symbols_from_param_list(param_list: Node) -> Optional<List<Symbol>> {
  match body_lower_param_list_comma_spine_optional(param_list_captured: param_list) {
    Absent => Present { value: Empty }
    Present { value: comma_spine } =>
      match body_lower_param_edges(sequence_capture: comma_spine) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: edges, diagnostics: _ } =>
          Present {
            value: fold(edges, init: Empty, f: fn(acc, e) {
              match e.label {
                StructuralLabel { label: _ } => acc
                Authored { name: sym } => Cons { head: sym, tail: acc }
                Positional => acc
              }
            })
          }
      }
  }
}

// The binder atoms of one param_list production, read by the slot walk its domain lowers through
// (body_lower_collect_typed_param_slots). Absent where the list's comma spine cannot be read, OR where
// any one slot is unreadable: all or nothing, so an unread binder is a refusal, never a shorter list.
fn body_lower_param_list_binder_atoms(param_list: Node) -> Optional<List<Node>> {
  match body_lower_param_list_comma_spine_optional(param_list_captured: param_list) {
    Absent => Absent
    Present { value: comma_spine } =>
      match body_lower_collect_typed_params(sequence_capture: comma_spine) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: params, diagnostics: _ } => Present { value: list_map(xs: params, f: fn(p) { p.binder }) }
      }
  }
}

fn body_lower_param_binding_symbols_from_fn_captured(captured: Node) -> Optional<List<Symbol>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_param_list) {
    ParseSubtreeFound { captured: param_list } =>
      body_lower_param_binding_symbols_from_param_list(param_list: param_list)
    ParseSubtreeAbsent => Present { value: Empty }
  }
}

fn body_lower_param_binding_symbols_from_fn_decl_module(root: Node) -> Optional<List<Symbol>> {
  match body_lower_find_captured(root: root, emitted: ^dag_surface_fn_decl) {
    ParseSubtreeFound { captured: captured } =>
      body_lower_param_binding_symbols_from_fn_captured(captured: captured)
    ParseSubtreeAbsent => Present { value: Empty }
  }
}

fn body_lower_arrow_domain_binding_symbols(arrow: Node) -> List<Symbol> {
  match count(arrow.children) >= 1 {
    true =>
      match first(arrow.children) {
        Present { value: domain_edge } =>
          body_lower_arrow_domain_named_bindings(root: domain_edge.target)
        Absent => Empty
      }
    false => Empty
  }
}

fn body_lower_arrow_domain_matches_ingest_param_bindings(
  arrow: Node,
  ingest_bindings: List<Symbol>
) -> Bool {
  body_lower_binding_symbol_lists_match(
    expected: ingest_bindings,
    actual: body_lower_arrow_domain_binding_symbols(arrow: arrow)
  )
}

fn body_lower_frontend_symbol_index_from_module(
  tree: Node,
  record_declarations: FreeMonoid<Symbol>
) -> SymbolIndex {
  symbol_index_fill_module_root(
    index: empty_symbol_index(),
    root: tree,
    record_declarations: record_declarations,
    resource_declarations: Empty
  )
}

fn body_lower_arrow_domain_matches_frontend_symbol_index(
  arrow: Node,
  module_tree: Node,
  record_declarations: FreeMonoid<Symbol>,
  fn_name: Symbol
) -> Bool {
  match qualified_name_from_module_node(root: module_tree) {
    Accepted { value: module_qn, diagnostics: _ } =>
      let fn_path = qualified_name_snoc(qn: module_qn, segment: fn_name)
      let idx = body_lower_frontend_symbol_index_from_module(
        tree: module_tree,
        record_declarations: record_declarations
      )
      fold(
        body_lower_arrow_domain_binding_symbols(arrow: arrow),
        init: true,
        f: fn(ok, binding) {
          if ok {
            match symbol_index_lookup(
              index: idx,
              qualified_path: qualified_name_snoc(qn: fn_path, segment: binding)
            ) {
              Present { value: _ } => true
              Absent => false
            }
          } else {
            false
          }
        }
      )
    Rejected { diagnostics: _ } => false
  }
}

fn body_lower_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// THE SOURCE IS THE AUTHORED TYPE NAME, and it is a parameter rather than an omission. This atom is
// the lowered form of a type the author wrote -- `Bool` in `fn f() -> Bool` -- so it stands at that
// text's position and keeps that text's occurrence. Built synthetic, it was a node an
// `infer_grounding_not_derived` diagnostic anchors on with no occurrence to look up, which is how a
// fatal ends up naming no file at all. Every caller already holds the node it read the symbol from,
// so the source is supplied rather than searched for -- searching the tree for an equal node would
// be the plausible guess DESIGN section 5 forbids.
fn body_lower_type_atom_node(sym: Symbol, source: Node) -> Node {
  node_lowered_from(
    kind: TypeNode { connective: Atom { identity: sym } },
    children: [],
    source: source
  )
}

// THE SOLE MINTER OF WrapperRetention. It emits no diagnostic: the retention IS the result, and the
// refusal is minted from it by whichever reader consumes it (wrapper_retention_diagnostic).
fn body_lower_wrapper_retained_shell(shell: Node) -> Outcome<BodyLowering> {
  Accepted {
    value: BodyWrapperRetained { retention: WrapperRetention { shell: shell } },
    diagnostics: None
  }
}

// THE QUALIFIED-NAME SPINE IS LOWERED SUBSTRATE. body_lower_reduce runs bottom-up, so by the time
// a fn declaration's body is read, a dotted chain in it has already been lowered to the spine
// body_lower_qualified_name_spine_node builds -- a TypeNode Conj under the fold_list labels that no
// grammar production emits. Before this arm the spine was not recognised as lowered, and the
// expression-body readers (body_lower_eq_expr_to_body through body_lower_operand_ref_optional)
// decomposed it to its FIRST ATOM: `fn f() -> Bool = wall.peer.peer_leaf` reached the arrow body
// as the atom `wall`, measured on the normalize route by
// v2.test.claim.body_lowering_qualified_path, while a call through the same chain survived only
// because a Transform already counted as substrate. One shape, one verdict: what the spine
// builder emits, every later reader keeps.
// A CONSTRUCT IS LOWERED SUBSTRATE. The record-literal producer answers a Conj (v2.std.node_query
// construct_node: tag edge, then field edges), and every reducer above it -- the postfix reduce
// first -- must pass it through as it passes an Arrow or a Transform; the first-atom fallback
// they otherwise take would answer the construct's tag and drop its fields, which is exactly how
// `data d: R = R { .. }` reached the graft as the atom R before this arm.
// A FIELD PROJECTION IS LOWERED SUBSTRATE, for the construct's reason. The postfix chain fold
// answers `f(x).a` as v2.std.node_query field_projection_node, a two-edge Conj (base, field), and
// until this arm nothing above the postfix reduce recognised it: an operator operand, a paren
// group or a unary operand re-read the Conj as unlowered, and the first-child descent answered its
// BASE -- `p + g(x).a` lowered to `p + g(x)` with no diagnostic, silent wrongness below the ladder
// (DESIGN 4b). The producer and this predicate now agree on one shape, field_projection_optional,
// the same reader the projection's consumers use.
// A LOWERED INT LITERAL IS SUBSTRATE, AND ITS PAYLOAD IS NOT A NAME. body_lower_int_literal_with_magnitude_optional
// produces an Atom(dag_token_int_literal) carrying the integer authority's decimal digit list as
// its magnitude field, and that list is a FreeMonoid cons spine: the same head/tail shape
// qualified_name_spine_shape_present recognizes. Until 2026-09-23 the literal atom was not
// recognized here and its payload was, so a deep search from a `= expr` body (a data initializer,
// or `fn f() -> Int = 606060`) stepped past the literal and returned its digit list as the body,
// which resolve then refused as an unbound qualified name. Recognizing the literal stops every
// search at the literal, before it reaches the payload.
fn body_lower_is_core_substrate_leaf(node: Node) -> Bool {
  (match body_lower_int_literal_with_magnitude_optional(node: node) { Present { value: lit } => lit == node  Absent => false })
    || (match body_lower_string_literal_value_optional(node: node) { Present { value: lit } => lit == node  Absent => false })
    || (match dag_symbol_literal_name_optional(node: node) { Present { value: _ } => true  Absent => false })
    || qualified_name_spine_shape_present(root: node)
    || (match construct_tag_reading(n: node) { ConstructTagAuthored { reference: _ } => true  ConstructTagElided => true  NotAConstruct => false })
    || (match field_projection_optional(n: node) { Present { value: _ } => true  Absent => false })
}

fn body_lower_is_core_substrate(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Arrow } => true
    ComputationNode { behavior: _ } => true
    TypeNode { connective: Atom { identity: _ } } =>
      body_lower_is_core_substrate_leaf(node: node)
    TypeNode { connective: Conj } =>
      body_lower_is_core_substrate_leaf(node: node)
    TypeNode { connective: Disj } =>
      body_lower_is_core_substrate_leaf(node: node)
    TypeNode { connective: Cardinality } =>
      body_lower_is_core_substrate_leaf(node: node)
    TypeNode { connective: Instantiation } =>
      body_lower_is_core_substrate_leaf(node: node)
  }
}

// A LOWERED SHAPE THE ALLOWLIST DOES NOT NAME REFUSES; IT IS NEVER RE-READ AS RAW PARSE. Every reader
// that consults body_lower_is_core_substrate used to treat a node it did not recognise as unlowered
// and walk it again with the parse readers, whose first-match descents answered a PART of it -- the
// silent part-for-whole truncation behind the #12145 class (gunbc.recurring_failure_mode
// lowered_output_reread_as_raw_parse_at_v2_body_lowering); #12269's field projection was one
// instance, closed by growing the allowlist. The raw parse tree is recognisable by construction: every
// non-atom node the parser emits carries at least one parse projection edge, and the roster of those
// edges is v2.compiler.parse parse_tree_projection_edge (a production's identity or capture, a
// sequence's sides -- what the parse stage's grammar_named_edge sites mint), while a producer's
// output carries none. So a non-atom node with children that the allowlist rejects and
// that carries no grammar projection edge is lowered output that no reader recognises, and it refuses
// here, located at that node, instead of being re-read. The MQ-5 census (wise-ant-748, 2026-09-30:
// the same test at these sites over the native population, positive control verified, baseline
// identical) found no site taking the re-read today, so this refusal changes no verdict; it makes the
// NEXT unrecognised shape loud. RUNG, HONESTLY: the diagnostic names the node, not its producer --
// nothing on a Node says which lowering built it. The producer-declared shape (LoweredShape carried
// in a BodyTerm through the reducers, neat-boar-16 ruling 2026-09-30) is the next rung, and it
// deletes both this test and the allowlist.
fn body_lower_has_grammar_projection_edge(node: Node) -> Bool {
  fold(node.children, init: false, f: fn(acc, e) {
    acc || (match e.label {
      Authored { name: n } => parse_tree_projection_edge(name: n)
      StructuralLabel { label: _ } => false
      Positional => false
    })
  })
}

fn body_lower_is_unrecognised_lowered_shape(node: Node) -> Bool {
  if body_lower_is_core_substrate(node: node) {
    false
  } else {
    match node.kind {
      TypeNode { connective: Atom { identity: _ } } => false
      _ => (length(xs: node.children) > 0) && !body_lower_has_grammar_projection_edge(node: node)
    }
  }
}

fn body_lower_unrecognised_lowered_shape_diagnostics(node: Node) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_unrecognised_lowered_shape, n: node)
  )
}

// The node body_lower_find_core_substrate_optional would step PAST on its own first-match path --
// an unrecognised lowered node -- to answer a recognised DESCENDANT of it: a part for the whole.
fn body_lower_find_core_substrate_passes_unrecognised(root: Node) -> Optional<Node> {
  if body_lower_is_core_substrate(node: root) {
    optional_absent()
  } else {
    match body_lower_find_core_substrate_optional(root: root) {
      Absent => optional_absent()
      Present { value: _ } =>
        if body_lower_is_unrecognised_lowered_shape(node: root) {
          optional_present(value: root)
        } else {
          match body_lower_find_core_substrate_first_hit_child(root: root) {
            Absent => optional_absent()
            Present { value: child } => body_lower_find_core_substrate_passes_unrecognised(root: child)
          }
        }
    }
  }
}

fn body_lower_find_core_substrate_first_hit_child(root: Node) -> Optional<Node> {
  fold(root.children, init: Absent, f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match body_lower_find_core_substrate_optional(root: e.target) {
          Present { value: _ } => optional_present(value: e.target)
          Absent => optional_absent()
        }
    }
  })
}

fn body_lower_is_pass_through_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_expr)
    || (emitted == ^dag_surface_binary_expr)
    || (emitted == ^dag_surface_unary_expr)
    || (emitted == ^dag_surface_postfix_expr)
    || (emitted == ^dag_surface_block_expr)
    || (emitted == ^dag_surface_stmt)
    || (emitted == ^dag_surface_lambda_let_stmt)
    || (emitted == ^dag_surface_stmt_seq)
    || (emitted == ^dag_surface_arg)
}

fn body_lower_is_identity_projection_edge(edge: Edge) -> Bool {
  match edge.label {
    StructuralLabel { label: _ } => false
    Authored { name: n } => n == ^grammar_production_identity_node_projection
    Positional => false
  }
}

// The children are tried in order until one is an operand; a refused child ends the search, because
// a later sibling's reading would stand in for the whole node.
fn body_lower_operand_fold_children_read(node: Node) -> OperandRefRead {
  fold(node.children, init: OperandRefAbsent, f: fn(acc, e) {
    match acc {
      OperandRefAbsent =>
        if body_lower_is_identity_projection_edge(edge: e) {
          OperandRefAbsent
        } else {
          body_lower_operand_ref_read(node: e.target)
        }
      OperandRefLowered { lowered: _ } => acc
      OperandRefRefused { diagnostics: _ } => acc
    }
  })
}

// A FUNCTION VALUE'S INTERIOR IS NOT FOLDED FROM OUTSIDE IT. `p => body` and `fn(..) { .. }` are
// lowered as a unit, from their raw parse, by body_lower_function_value -- which body_lower_fold
// dispatches to on meeting one, before this deferral is consulted. The deferral itself governs
// normalize over a module's data initializers (body_lower_is_deferred_lower_at_normalize): there the
// shell is kept raw for the field-initializer reader to lower, never folded from outside.
fn body_lower_is_deferred_lower_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_pattern)
    || (emitted == ^dag_surface_match_arm)
    || (emitted == ^dag_surface_arrow_lambda)
    || (emitted == ^dag_surface_fn_literal)
}

// A service or resource declaration lowers from its UNFOLDED parse subtree (body_lower_service_decl,
// body_lower_resource_decl): its members are interface or set-aside facts, never bodies, so folding
// them first would retain each one.
fn body_lower_is_deferred_lower_at_normalize(emitted: Symbol, under_fn_decl: Bool) -> Bool {
  if (emitted == ^dag_surface_service_decl) || (emitted == ^dag_surface_resource_decl) {
    true
  } else if emitted == ^dag_surface_fn_body {
    under_fn_decl
  } else {
    body_lower_is_deferred_lower_emitted(emitted: emitted)
  }
}

fn body_lower_is_metadata_preserved_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_module)
    || (emitted == ^dag_surface_module_header)
    || (emitted == ^dag_surface_import_decl)
    || (emitted == ^dag_surface_alias_decl)
    || (emitted == ^dag_surface_qualified_name)
    || (emitted == ^dag_surface_top_level_item)
    || (emitted == ^dag_surface_generic_params)
    || (emitted == ^dag_surface_param_list)
    || (emitted == ^dag_surface_type_expr)
    || (emitted == ^dag_surface_type_decl)
    || (emitted == ^dag_surface_import_block)
}

// THE SAME SHAPE AS #8828, ONE NODE CLASS OVER: a shell with no body to lower FROM ITS OWN NODE was
// arriving at the unregistered-producer arm, so 'this production has no body-producer yet' and
// 'this production is structure, not a body' were one state. The identities
// body_lower_is_structure_preserved_emitted enumerates are declaration and literal STRUCTURE:
// type syntax with no Behavior to lower to, and expression shells whose children the
// bottom-up fold has already lowered, so preserving the shell preserves a lowered child,
// never an unlowered one. Preserving is what
// body_lower_is_metadata_preserved_emitted already does for the OUTER declarations these sit inside
// (dag_surface_type_decl, dag_surface_data_decl) -- the classification was written per node and the
// fold reaches inside, so every interior of an already-preserved declaration re-entered the
// dispatch and fell to the else arm.
//
// FOLD ORDER IS THE LOAD-BEARING ASSUMPTION FOR dag_surface_field_init. The two function-value
// shells (dag_surface_arrow_lambda, dag_surface_fn_literal) are listed here too, but for a different
// reason: they are DEFERRED (body_lower_is_deferred_lower_emitted), so dispatch reaches them
// UNFOLDED and preserving the shell preserves their raw parse for the function-value producer and
// fold_lowering to read -- never a folded interior.
// Type syntax is safe by what it IS -- no Behavior to lower to. field_init
// is safe by WHEN this dispatch reaches it: normalize_node_ctx
// folds children first and passes the FOLDED node to body_lower_finish_for_normalize. There is a
// live path in that same function where dispatch sees an UNFOLDED node -- the deferred arm passes
// `folded: n` and does not fold children -- so adding these identities to
// body_lower_is_deferred_lower_at_normalize, or otherwise dispatching before the child fold, would
// preserve a shell around an UNLOWERED expression. NONE OF THE THREE WITNESSES WOULD CATCH THAT
// for field_init: their field values are the literal 1, which lowers to itself, so the reordered
// and the current fold produce the same tree for exactly those sources. Stated here rather than covered for field_init, because an assumption named in
// the carrier is worth more than a witness that does not actually cover it.
// RUNG: this is a scope correction to a classifier, not a climb. The retained arm remains the
// counted frontier for a body shape with no producer, and that is the discriminating control: an
// emitted identity in none of these lists still retains, so the arm is not widened into an
// absorbing accept. Next-rung trigger: the preserved/structure classification derived from the
// grammar's own productions (a nonterminal reachable from dag_production_type_decl without crossing
// dag_production_expr is type syntax by construction) rather than enumerated here beside them.

fn body_lower_is_structure_preserved_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_type_variant)
    || (emitted == ^dag_surface_type_alias_rhs)
    || (emitted == ^dag_surface_type_alias_rhs_lead)
    || (emitted == ^dag_surface_field_decl_block)
    || (emitted == ^dag_surface_positional_variant_payload)
    || (emitted == ^dag_surface_admit_callers_clause)
    || (emitted == ^dag_surface_uses_clause)
    || (emitted == ^dag_surface_default_value)
    || (emitted == ^dag_surface_uses_entry)
    || (emitted == ^dag_surface_fn_type)
    || (emitted == ^dag_surface_field_init)
    || (emitted == ^dag_surface_field_init_string_key)
    || (emitted == ^dag_surface_where_refinement_clause)
    || (emitted == ^dag_surface_where_predicate)
    || (emitted == ^dag_surface_arrow_lambda)
    || (emitted == ^dag_surface_fn_literal)
}

// A where-clause on a type-variant is a parse-projection sibling of the base
// type-expr. namespace_graft treats every `_node_projection` edge as
// transparent at the module body, so a preserved production shell is unfolded
// and the clause identity is dissolved. Rehome a present clause onto a Named
// edge that is not a projection (the emitted surface symbol) so graft keeps
// the refined Conj and parse_subtree_find still sees the production.
fn body_lower_type_variant_suffix_pair_optional(captured: Node) -> Optional<SugarSequencePair> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => optional_absent()
    Present { value: pair } => sugar_sequence_pair_optional(node: pair.right)
  }
}

// A WHERE CLAUSE LOWERS TO ITS PREDICATES, EVERY ONE, EACH A CALL-SHAPED NODE RESOLVE BINDS.
// `where range(min: 0, max: 5), brand("X")` carries two predicates, and each keeps its authored
// name atom -- the ident's own occurrence -- as a Transform's operator, so v2 resolve binds that
// atom to the predicate's declaration by ordinary name lookup (std.types range, std.types brand)
// and refuses a spelling nothing declares (resolve_reason_where_predicate_unbound). The value being
// refined is the declaration's first parameter and is never written in the clause. Labelled
// arguments bind to the declaration's parameters BY LABEL, so they are carried as ONE record whose
// field names are the labels (`min: 0, max: 5` is Conj { min: 0, max: 5 }): a Transform admits a
// single named edge, and the label, not the position, is what binds. Positional arguments
// (`brand("X")`) stay positional. The predicates of one clause are a Conj labelled by predicate
// spelling, so a clause naming one predicate twice is not a well-formed tree and refuses here,
// located, instead of one copy silently standing for both.
//
// What this used to do, recorded because it was the defect: it kept the FIRST atom found under the
// clause -- a production-identity projection when there was one -- as a bare Atom at the clause's
// occurrence, so the predicate's own atom reached no node and every predicate after the first was
// dropped (the retired drop's control: v2.test.claim.namespace_xl0.reference_conservation
// the_where_refinement_predicates_are_conserved_holds).

fn body_lower_where_leaf_atom_optional(node: Node) -> Optional<Node> {
  match node.kind {
    TypeNode { connective: Atom { identity: _ } } => optional_present(value: node)
    _ =>
      fold(node.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent =>
            match e.label {
              Authored { name: sym } =>
                if sym == ^grammar_production_identity_node_projection {
                  acc
                } else {
                  body_lower_where_leaf_atom_optional(node: e.target)
                }
              StructuralLabel { label: _ } => body_lower_where_leaf_atom_optional(node: e.target)
              Positional => body_lower_where_leaf_atom_optional(node: e.target)
            }
        }
      })
  }
}

fn body_lower_where_predicate_productions(node: Node) -> List<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_where_predicate {
        [node]
      } else {
        body_lower_where_predicate_productions_below(node: node)
      }
    Absent => body_lower_where_predicate_productions_below(node: node)
  }
}

fn body_lower_where_predicate_productions_below(node: Node) -> List<Node> {
  fold(node.children, init: Empty, f: fn(acc, e) {
    match e.label {
      Authored { name: sym } =>
        if sym == ^grammar_production_identity_node_projection {
          acc
        } else {
          list_append(left: acc, right: body_lower_where_predicate_productions(node: e.target))
        }
      StructuralLabel { label: _ } => list_append(left: acc, right: body_lower_where_predicate_productions(node: e.target))
      Positional => list_append(left: acc, right: body_lower_where_predicate_productions(node: e.target))
    }
  })
}

fn body_lower_where_unread(n: Node) -> Diagnostic {
  body_lower_diagnostic(reason: ^body_lowering_reason_where_predicate_unread, n: n)
}

// One argument: `label: <int>` is a labelled argument, anything else a positional leaf.
type WherePredicateArgument
  = WhereArgumentLabelled { label: Symbol, value: Node }
  | WhereArgumentPositional { value: Node }

fn body_lower_where_argument(item: Node) -> Outcome<WherePredicateArgument> {
  let raw = body_lower_deep_unwrap_optional(node: item)
  match sugar_sequence_pair_optional(node: raw) {
    Absent =>
      match body_lower_where_leaf_atom_optional(node: raw) {
        Present { value: leaf } => outcome_accepted(value: WhereArgumentPositional { value: leaf })
        Absent => outcome_rejected(d: body_lower_where_unread(n: item))
      }
    Present { value: pair } =>
      match body_lower_where_leaf_atom_optional(node: pair.left) {
        Absent => outcome_rejected(d: body_lower_where_unread(n: item))
        Present { value: name } =>
          match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: pair.right)) {
            Absent => outcome_accepted(value: WhereArgumentPositional { value: name })
            Present { value: colon_value } =>
              match body_lower_where_leaf_atom_optional(node: colon_value.right) {
                Absent => outcome_rejected(d: body_lower_where_unread(n: item))
                Present { value: value } =>
                  match name.kind {
                    TypeNode { connective: Atom { identity: label } } =>
                      outcome_accepted(value: WhereArgumentLabelled { label: label, value: value })
                    _ => outcome_rejected(d: body_lower_where_unread(n: item))
                  }
              }
          }
      }
  }
}

fn body_lower_where_arguments(items: List<Node>) -> Outcome<List<WherePredicateArgument>> {
  match items {
    Empty => outcome_accepted(value: Empty)
    Cons { head: item, tail: rest } =>
      bind_outcome(
        o: body_lower_where_argument(item: item),
        f: fn(arg) {
          bind_outcome(
            o: body_lower_where_arguments(items: rest),
            f: fn(args) { outcome_accepted(value: Cons { head: arg, tail: args }) }
          )
        }
      )
  }
}

// `(` args `)` or nothing: the optional suffix after the predicate name.
fn body_lower_where_argument_items(suffix: Node) -> Outcome<List<Node>> {
  let inner = body_lower_deep_unwrap_optional(node: suffix)
  if is_empty_conj_root(n: inner) {
    outcome_accepted(value: Empty)
  } else {
    match sugar_sequence_pair_optional(node: inner) {
      Absent => outcome_rejected(d: body_lower_where_unread(n: suffix))
      Present { value: paren_rest } =>
        match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: paren_rest.right)) {
          Absent => outcome_rejected(d: body_lower_where_unread(n: suffix))
          Present { value: list_close } =>
            body_lower_comma_list_items(
              list_capture: list_close.left,
              shape_refusal: ^body_lowering_reason_where_predicate_unread
            )
        }
    }
  }
}

fn body_lower_where_labelled_record(args: List<WherePredicateArgument>, at: Node) -> List<Edge> {
  let labelled = fold(args, init: Empty, f: fn(acc, a) {
    match a {
      WhereArgumentLabelled { label: label, value: value } =>
        list_snoc_item(xs: acc, item: Edge { label: Authored { name: label }, target: value })
      WhereArgumentPositional { value: _ } => acc
    }
  })
  match labelled {
    Empty => Empty
    Cons { head: _, tail: _ } =>
      [Edge {
        label: Positional,
        target: node_with_occurrence_id(
          kind: TypeNode { connective: Conj },
          children: labelled,
          occurrence_id: at.occurrence_id
        )
      }]
  }
}

fn body_lower_where_positional_edges(args: List<WherePredicateArgument>) -> List<Edge> {
  fold(args, init: Empty, f: fn(acc, a) {
    match a {
      WhereArgumentPositional { value: value } =>
        list_snoc_item(xs: acc, item: Edge { label: Positional, target: value })
      WhereArgumentLabelled { label: _, value: _ } => acc
    }
  })
}

type LoweredWherePredicate {
  spelling: Symbol
  call: Node
}

fn body_lower_where_predicate(pred: Node) -> Outcome<LoweredWherePredicate> {
  match parse_production_captured_child_optional(node: pred) {
    Absent => outcome_rejected(d: body_lower_where_unread(n: pred))
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => outcome_rejected(d: body_lower_where_unread(n: pred))
        Present { value: pair } =>
          match body_lower_where_leaf_atom_optional(node: pair.left) {
            Absent => outcome_rejected(d: body_lower_where_unread(n: pred))
            Present { value: name } =>
              match name.kind {
                TypeNode { connective: Atom { identity: spelling } } =>
                  bind_outcome(
                    o: body_lower_where_argument_items(suffix: pair.right),
                    f: fn(items) {
                      bind_outcome(
                        o: body_lower_where_arguments(items: items),
                        f: fn(args) {
                          outcome_accepted(value: LoweredWherePredicate {
                            spelling: spelling,
                            call: close_lowered_image(root: node_with_occurrence_id(
                              kind: ComputationNode { behavior: Transform },
                              children: list_append(
                                left: Cons { head: Edge { label: Positional, target: name }, tail: body_lower_where_positional_edges(args: args) },
                                right: body_lower_where_labelled_record(args: args, at: pred)
                              ),
                              occurrence_id: pred.occurrence_id
                            ))
                          })
                        }
                      )
                    }
                  )
                _ => outcome_rejected(d: body_lower_where_unread(n: pred))
              }
          }
      }
  }
}

fn body_lower_where_predicates(preds: List<Node>, done: List<Edge>) -> Outcome<List<Edge>> {
  match preds {
    Empty => outcome_accepted(value: done)
    Cons { head: pred, tail: rest } =>
      bind_outcome(
        o: body_lower_where_predicate(pred: pred),
        f: fn(lowered) {
          if fold(done, init: false, f: fn(seen, e) {
            seen || match e.label {
              Authored { name: n } => n == lowered.spelling
              StructuralLabel { label: _ } => false
              Positional => false
            }
          }) {
            outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_where_predicate_repeated, n: pred))
          } else {
            body_lower_where_predicates(
              preds: rest,
              done: list_snoc_item(xs: done, item: Edge { label: Authored { name: lowered.spelling }, target: lowered.call })
            )
          }
        }
      )
  }
}

fn body_lower_where_predicate_set(where_clause: Node) -> Outcome<Node> {
  match body_lower_where_predicate_productions(node: where_clause) {
    Empty => outcome_rejected(d: body_lower_where_unread(n: where_clause))
    Cons { head: first, tail: rest } =>
      bind_outcome(
        o: body_lower_where_predicates(preds: Cons { head: first, tail: rest }, done: Empty),
        f: fn(edges) {
          outcome_accepted(value: node_with_occurrence_id(
            kind: TypeNode { connective: Conj },
            children: edges,
            occurrence_id: where_clause.occurrence_id
          ))
        }
      )
  }
}

// Conj is LabeledEdges: every child must be labeled. The clause is a production-shaped Conj whose
// captured child is the predicate set above. The clause and each predicate call are images of their
// sources, closed at the root each returns (v2.std.node close_lowered_image).
fn body_lower_kept_where_clause(where_clause: Node) -> Outcome<Node> {
  bind_outcome(
    o: body_lower_where_predicate_set(where_clause: where_clause),
    f: fn(predicates) {
      let production = node_with_occurrence_id(
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Authored { name: ^grammar_production_identity_node_projection },
            target: node_with_occurrence_id(
              kind: TypeNode { connective: Atom { identity: ^dag_surface_where_refinement_clause } },
              children: [],
              occurrence_id: where_clause.occurrence_id
            )
          },
          Edge {
            label: Authored { name: ^grammar_production_captured_node_projection },
            target: predicates
          }
        ],
        occurrence_id: where_clause.occurrence_id
      )
      outcome_accepted(value: close_lowered_image(root: node_with_occurrence_id(
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: dag_surface_edge_label(edge: ^dag_surface_where_refinement_clause),
            target: production
          }
        ],
        occurrence_id: where_clause.occurrence_id
      )))
    }
  )
}

fn body_lower_type_variant_children_with_where(
  base: Node,
  kept_clause: Node,
  fields: Node
) -> List<Edge> {
  let with_clause = [
    Edge { label: Authored { name: ^dag_surface_type_expr }, target: base },
    Edge {
      label: dag_surface_edge_label(edge: ^dag_surface_where_refinement_clause),
      target: kept_clause
    }
  ]
  if is_empty_conj_root(n: fields) {
    with_clause
  } else {
    list_snoc_item(
      xs: with_clause,
      item: Edge { label: Authored { name: ^dag_surface_field_decl_block }, target: fields }
    )
  }
}

// VARIANT AND RECORD FIELDS LOWER HERE, INTO DECLARED FIELD IDENTITIES. The seed's model
// (v1.compiler.core make_field_node; v1.compiler.parse parse_positional_variant_type_fields)
// and its v2 home (v2.std.node_query DeclaredField) agree: a field is a Named edge on the
// payload Conj, the label its identity, the target its type; `Name(T)` is the one Required
// field "0"; a nullary variant is the empty payload Conj. Both spellings lower through the same
// two functions, so the record and positional halves of
// gunbc.rung_drop variant_fields_unlowered_on_the_native_route close together, and a field
// whose declaration cannot be read is a typed, located refusal -- never a residual shell.
// A field declaration is `name: T`, the shape of a typed parameter, so it is read into the same
// record (BodyLowerTypedParam): the binder atom keeps its token's occurrence, and the field Edge is the
// record's projection.
fn body_lower_field_decl_optional(item: Node) -> Optional<BodyLowerTypedParam> {
  body_lower_field_decl_head_optional(capture: body_lower_deep_unwrap_optional(node: item))
}

// Every field item of a list, each read as its field and its `[from "key"] [= default]` tail, or
// Absent if any one is unreadable: the all-or-nothing read every field-bearing block lowers through.
// ONE FIELD GRAMMAR (dag_grammar_field_decl_list_helper admits v1 parse_field's tail on every field),
// so a record field and a service io field are read by the same reader (body_lower_io_item_optional).
fn body_lower_field_items_optional(items: List<Node>) -> Optional<List<BodyLowerIoItem>> {
  fold(items, init: Present { value: Empty }, f: fn(acc, item) {
    match acc {
      Absent => Absent
      Present { value: fields } =>
        match body_lower_io_item_optional(item: item) {
          Absent => Absent
          Present { value: f } => Present { value: list_snoc_item(xs: fields, item: f) }
        }
    }
  })
}

// THE FIRST FIELD THAT CARRIES A WIRE KEY (`from "key"`), if any. A wire key is a realization fact (the
// decode projection of one transport's observation), which has no carrier until the realization
// binding (XL-2 PR3), so a record field carrying one refuses at its tail. A field's DEFAULT is not a
// tail refusal any more: it lowers onto the field's binder (body_lower_field_binder_edges).
fn body_lower_first_field_wire_key_optional(fields: List<BodyLowerIoItem>) -> Optional<Node> {
  fold(fields, init: optional_absent(), f: fn(acc, io) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if body_lower_io_field_wire_key_present(tail: io.tail) {
          optional_present(value: io.tail)
        } else {
          optional_absent()
        }
    }
  })
}

// Each field's binder, carrying the default its tail holds when it has one.
fn body_lower_field_binder_edges(fields: List<BodyLowerIoItem>) -> Outcome<List<Edge>> {
  fold(fields, init: outcome_accepted(value: Empty), f: fn(acc, io) {
    bind_outcome(o: acc, f: fn(edges) {
      bind_outcome(o: body_lower_binder_edge_read(param: io.field, default: body_lower_io_field_default_optional(tail: io.tail)), f: fn(edge) {
        outcome_accepted(value: list_snoc_item(xs: edges, item: edge))
      })
    })
  })
}

// `{ f: T, g: U }`: the block's captured is seq(`{`, seq(list, `}`)); its field items.
fn body_lower_field_decl_block_items_optional(captured: Node) -> Optional<List<Node>> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Absent
    Present { value: pair } =>
      match sugar_sequence_pair_optional(node: pair.right) {
        Absent => Absent
        Present { value: inner } => body_lower_comma_list_items_optional(list_capture: inner.left)
      }
  }
}

// The binder atoms of one field_decl_block production, read by the reader its payload lowers through.
fn body_lower_field_decl_block_binder_atoms(captured: Node) -> Optional<List<Node>> {
  match body_lower_field_decl_block_items_optional(captured: captured) {
    Absent => Absent
    Present { value: items } =>
      match body_lower_field_items_optional(items: items) {
        Absent => Absent
        Present { value: fields } => Present { value: list_map(xs: fields, f: fn(io) { io.field.binder }) }
      }
  }
}

fn body_lower_payload_node(edges: List<Edge>, source: Node) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: edges,
    occurrence_id: source.occurrence_id
  )
}

// `{ f: T, g: U }` -> Conj { f: T, g: U }. The block's captured is seq(`{`, seq(list, `}`)).
fn body_lower_field_decl_block_payload(block_shell: Node) -> Outcome<Node> {
  let refuse = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: block_shell)
  )
  match parse_production_captured_child_optional(node: block_shell) {
    Absent => refuse
    Present { value: captured } =>
      match body_lower_field_decl_block_items_optional(captured: captured) {
        Absent => refuse
        Present { value: items } =>
          match body_lower_field_items_optional(items: items) {
            Absent => refuse
            Present { value: fields } =>
              match body_lower_first_field_wire_key_optional(fields: fields) {
                Present { value: tail } =>
                  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_interface_member_unmodeled, n: tail))
                Absent =>
                  bind_outcome(o: body_lower_field_binder_edges(fields: fields), f: fn(edges) {
                    outcome_accepted(value: body_lower_payload_node(edges: edges, source: block_shell))
                  })
              }
          }
      }
  }
}

// `(T)` -> Conj { 0: T }. The payload's captured is seq(`(`, seq(type_expr, `)`)); arity is one
// by the grammar row itself (dag_grammar_positional_variant_payload_expr), as in the seed.
fn body_lower_positional_payload(payload_shell: Node) -> Outcome<Node> {
  let refuse = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: payload_shell)
  )
  match parse_production_captured_child_optional(node: payload_shell) {
    Absent => refuse
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => refuse
        Present { value: pair } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => refuse
            Present { value: inner } =>
              match body_lower_type_expr_lowered_optional(node: inner.left) {
                Absent => refuse
                Present { value: type_node } =>
                  outcome_accepted(
                    value: body_lower_payload_node(
                      edges: [binder_edge(name: positional_payload_field_name(), type_node: type_node)],
                      source: payload_shell
                    )
                  )
              }
          }
      }
  }
}

type VariantPayloadShell
  = VariantPayloadAbsent
  | VariantPayloadShell { shell: Node }
  | VariantPayloadUnrecognized

fn body_lower_variant_payload_shell(suffix: Node) -> VariantPayloadShell {
  let stripped = body_lower_deep_unwrap_optional(node: suffix)
  if is_empty_conj_root(n: stripped) {
    VariantPayloadAbsent
  } else {
    match parse_production_emitted_identity_optional(node: stripped) {
      Present { value: id } =>
        if (id == ^dag_surface_field_decl_block) || (id == ^dag_surface_positional_variant_payload) {
          VariantPayloadShell { shell: stripped }
        } else {
          VariantPayloadUnrecognized
        }
      Absent => VariantPayloadUnrecognized
    }
  }
}

fn body_lower_variant_payload(shell: Node) -> Outcome<Node> {
  match parse_production_emitted_identity_optional(node: shell) {
    Present { value: id } =>
      if id == ^dag_surface_positional_variant_payload {
        body_lower_positional_payload(payload_shell: shell)
      } else {
        body_lower_field_decl_block_payload(block_shell: shell)
      }
    Absent =>
      outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell))
  }
}

// The variant's label is its head type expression, which must be one bare name: a dotted or
// generic head in variant position is not a variant the seed admits either.
fn body_lower_variant_label_optional(head: Node) -> Optional<Symbol> {
  match body_lower_type_atom_from_expr(node: head) {
    Absent => Absent
    Present { value: atom } => node_atom_identity_optional(node: atom)
  }
}

fn body_lower_fielded_type_variant(shell: Node, head: Node, payload_shell: Node) -> Outcome<Node> {
  match body_lower_variant_label_optional(head: head) {
    Absent =>
      outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell))
    Present { value: label } =>
      match body_lower_variant_payload(shell: payload_shell) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: payload, diagnostics: d } =>
          Accepted {
            value: variant_declaration_node(label: label, payload: payload, source: shell),
            diagnostics: d
          }
      }
  }
}

// A WHERE-REFINED HEAD IS A TYPE, LOWERED BY THE ONE TYPE-EXPRESSION LOWERING that signatures and
// cast targets use (body_lower_type_expr_lowered_optional), so resolve binds the carrier in type role
// like any other type. Carried as the raw parse sequence, the head reached resolve as a
// dag_surface_qualified_name shell, which v2.compiler.resolve preserves UNCHANGED as module metadata
// (v2.extdeps.languages.dag dag_resolve_preserve_module_metadata_subtree): the declaration named its
// carrier in a vocabulary no stage resolved. A head the lowering cannot read refuses at the head, as an
// unreadable annotation does. The other declaration-body type positions (alias right-hand side, field
// and payload types) are the same defect and a declared frontier
// (gunbc.recurring_failure_mode declaration_body_type_shell_preserved_unresolved).
// A variant shell is seq(type_expr, seq(optional(where), optional(payload))). A bare head is left
// as parsed: whether `type T = U` names an alias or a one-variant sum is decided where the
// alternatives are counted (v2.std.compilers.sugar sugar_fold_coproduct_pipe_chain, the seed's
// parse_type_body_after_eq rule), and lowering a bare head here would erase an alias's reference
// to its target. A payload lowers to a declared variant; a where clause beside a payload is a
// spelling the seed's try_where_clause never reaches (it refines the alias arm only), so it
// refuses here rather than carrying the payload unlowered.
fn body_lower_type_variant(shell: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => outcome_accepted(value: shell)
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => outcome_accepted(value: shell)
        Present { value: pair } =>
          match body_lower_type_variant_suffix_pair_optional(captured: captured) {
            Absent => outcome_accepted(value: shell)
            Present { value: suffixes } =>
              match body_lower_variant_payload_shell(suffix: suffixes.right) {
                VariantPayloadShell { shell: payload_shell } =>
                  if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: suffixes.left)) {
                    body_lower_fielded_type_variant(shell: shell, head: pair.left, payload_shell: payload_shell)
                  } else {
                    outcome_rejected(
                      d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell)
                    )
                  }
                VariantPayloadUnrecognized =>
                  outcome_rejected(
                    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell)
                  )
                VariantPayloadAbsent =>
                  match parse_production_emitted_identity_optional(node: suffixes.left) {
                    Absent => outcome_accepted(value: shell)
                    Present { value: suffix_id } =>
                      if suffix_id == ^dag_surface_where_refinement_clause {
                        match body_lower_type_expr_lowered_optional(node: pair.left) {
                          Absent =>
                            outcome_rejected(
                              d: body_lower_diagnostic(reason: ^body_lowering_reason_type_annotation_not_carried, n: pair.left)
                            )
                          Present { value: carrier } =>
                            bind_outcome(
                              o: body_lower_kept_where_clause(where_clause: suffixes.left),
                              f: fn(kept) {
                                outcome_accepted(
                                  value: node_with_occurrence_id(
                                    kind: TypeNode { connective: Conj },
                                    children: body_lower_type_variant_children_with_where(
                                      base: carrier,
                                      kept_clause: kept,
                                      fields: suffixes.right
                                    ),
                                    occurrence_id: shell.occurrence_id
                                  )
                                )
                              }
                            )
                        }
                      } else {
                        outcome_accepted(value: shell)
                      }
                  }
              }
          }
      }
  }
}

fn body_lower_param_ref_atom(source: Node, identity: Symbol) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: source.occurrence_id
  )
}

// A NESTED FUNCTION VALUE IS A SCOPE BOUNDARY FOR EVERY DEEP SEARCH HERE. `p => body` and
// `fn(..) { .. }` own their bodies; a control form, a fn_body or an else-less-if statement inside
// one belongs to that function value, which lowers it through body_lower_function_value_arrow.
// Searching past the boundary answered an OUTER body `filter(xs: xs, predicate: fn(x) { let y = ..
// y })` with the literal's `let` (body_lower_find_control_form_optional is pre-order and deep), so
// the enclosing fn_decl lowered to nothing and was wrapper-retained; whether it did depended on
// which callee the literal sat under, because a fold-family call is lowered before the search runs.
fn body_lower_find_captured_prunable(id: Symbol) -> Bool {
  (id == ^dag_surface_module_header)
    || (id == ^dag_surface_qualified_name)
    || (id == ^dag_surface_type_expr)
    || (id == ^dag_surface_arrow_lambda)
    || (id == ^dag_surface_fn_literal)
}

fn body_lower_find_captured_under_children(root: Node, emitted: Symbol) -> ParseSubtreeFind {
  fold(root.children, init: ParseSubtreeAbsent, f: fn(acc, edge) {
    match acc {
      ParseSubtreeFound { captured: _ } => acc
      ParseSubtreeAbsent => body_lower_find_captured(root: edge.target, emitted: emitted)
    }
  })
}

fn body_lower_find_captured(root: Node, emitted: Symbol) -> ParseSubtreeFind {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      if id == emitted {
        match parse_production_captured_child_optional(node: root) {
          Present { value: captured } => ParseSubtreeFound { captured: captured }
          Absent => body_lower_find_captured_under_children(root: root, emitted: emitted)
        }
      } else if body_lower_find_captured_prunable(id: id) {
        ParseSubtreeAbsent
      } else {
        body_lower_find_captured_under_children(root: root, emitted: emitted)
      }
    Absent => body_lower_find_captured_under_children(root: root, emitted: emitted)
  }
}

fn body_lower_find_production_shell_under_children(
  root: Node,
  emitted: Symbol
) -> Optional<Node> {
  fold(root.children, init: Absent, f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => body_lower_find_production_shell_optional(root: edge.target, emitted: emitted)
    }
  })
}

fn body_lower_find_production_shell_optional(root: Node, emitted: Symbol) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      match id == emitted {
        true => Present { value: root }
        false =>
          match body_lower_find_captured_prunable(id: id) {
            true => Absent
            false => body_lower_find_production_shell_under_children(root: root, emitted: emitted)
          }
      }
    Absent =>
      body_lower_find_production_shell_under_children(root: root, emitted: emitted)
  }
}

fn body_lower_int_literal_with_magnitude_optional(node: Node) -> Optional<Node> {
  let unwrapped = body_lower_deep_unwrap_for_int_literal(node: node)
  if dag_node_is_int_literal_atom(node: unwrapped) {
    match dag_int_literal_magnitude_node_optional(node: unwrapped) {
      Present { value: _ } => optional_present(value: unwrapped)
      Absent => optional_absent()
    }
  } else {
    optional_absent()
  }
}

// A refused operand is the shell's refusal: only a shell this reader does not recognise at all falls
// to the int-literal reading.
fn body_lower_operand_from_shell_read(shell: Node) -> OperandRefRead {
  let captured = match parse_production_captured_child_optional(node: shell) {
    Present { value: inner } => inner
    Absent => shell
  }
  match body_lower_operand_or_atom_read(captured: captured) {
    OperandRefAbsent =>
      body_lower_operand_ref_read_of(found: body_lower_int_literal_with_magnitude_optional(node: captured))
    OperandRefLowered { lowered: lowered } => OperandRefLowered { lowered: lowered }
    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
  }
}


// A SEQUENCE WITH A NON-EMPTY RIGHT IS NEVER NARROWED TO ITS LEFT ELEMENT. When pair.right is the
// empty conj the sequence is one element and its left IS the operand; otherwise the sequence is an
// operator expression, read whole by body_lower_read_operator_expression, or it is not an operand
// this reader recognises. The arm this replaces returned pair.left for every sequence, so `a && b`
// read as `a` and `!a` read as `!` (gunbc.recurring_failure_mode
// lowering_accessor_collapses_a_sequence_operand). An operator expression the tower reader refuses is
// a refusal here too, carrying the tower reader's cause at its position.
fn body_lower_operand_ref_sequence_read(node: Node) -> OperandRefRead {
  match body_lower_read_operator_expression(node: node) {
    OperatorExpressionRead { lowered: lowered } => OperandRefLowered { lowered: lowered }
    OperatorExpressionRefused { diagnostics: d } => OperandRefRefused { diagnostics: d }
    OperatorExpressionAbsent => OperandRefAbsent
  }
}

// AN OPERAND READ HAS THREE ANSWERS, AND THE ACCESSOR USED TO HAVE TWO. It is the operand whole
// (OperandRefLowered), a located refusal (OperandRefRefused -- an operator expression under it was
// read and a position under that operator was not), or not an operand this reader recognises
// (OperandRefAbsent). As an Optional the middle answer read as the third, so a caller that asked what
// a value IS and heard Absent went on to a first-match fallback: the let-value route answered
// `let x = b && (u)` with the first atom `b`, and `u` reached no reference site. A refusal is carried
// up through every recursion below and never replaced by a sibling's or a part's reading.
type OperandRefRead
  = OperandRefAbsent
  | OperandRefLowered { lowered: Node }
  | OperandRefRefused { diagnostics: NonEmptyDiagnostics }

fn body_lower_operand_ref_read_of(found: Optional<Node>) -> OperandRefRead {
  match found {
    Present { value: lowered } => OperandRefLowered { lowered: lowered }
    Absent => OperandRefAbsent
  }
}

// A THREE-VALUED READ CARRIED INTO AN OUTCOME WITHOUT LOSS: lowered is present, not-an-operand is
// absent, and a located refusal stays a refusal. It is the carrier for a position that returns
// Outcome<Optional<Node>>. It replaces the Optional projections of OperandRefRead, which forgot the
// refusal and were removed, so no reader of an operand can hear a refusal as Absent.
fn body_lower_operand_read_outcome(read: OperandRefRead, diagnostics: Diagnostics) -> Outcome<Optional<Node>> {
  match read {
    OperandRefLowered { lowered: lowered } => outcome_with_diagnostics(value: optional_present(value: lowered), diagnostics: diagnostics)
    OperandRefAbsent => outcome_with_diagnostics(value: optional_absent(), diagnostics: diagnostics)
    OperandRefRefused { diagnostics: r } => Rejected { diagnostics: rejected_with_pending(pending: diagnostics, rejected: r) }
  }
}



// An int literal is an atom with a magnitude child, and it is not a binding: the operand reader
// reads it whole before the branded-atom arm rebuilds an atom with no children -- which is what
// happened to every literal argument (`f(1)` carried a bare dag_token_int_literal) until that
// arm was ordered first.
fn body_lower_operand_ref_read(node: Node) -> OperandRefRead {
  if body_lower_is_unrecognised_lowered_shape(node: node) {
    OperandRefRefused { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: node) }
  } else {
  match body_lower_is_core_substrate(node: node) {
    true => OperandRefLowered { lowered: node }
    false =>
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: _emitted } =>
      match parse_production_captured_child_optional(node: node) {
        Present { value: captured } =>
          match body_lower_operand_ref_read(node: captured) {
            OperandRefAbsent => body_lower_operand_fold_children_read(node: node)
            OperandRefLowered { lowered: lowered } => OperandRefLowered { lowered: lowered }
            OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
          }
        Absent => body_lower_operand_fold_children_read(node: node)
      }
    Absent =>
      match dag_node_is_int_literal_atom(node: node) {
        true => body_lower_operand_ref_read_of(found: body_lower_int_literal_with_magnitude_optional(node: node))
        false =>
      match dag_binding_branded_atom_identity(node: node) {
        Present { value: binding } =>
          OperandRefLowered { lowered: body_lower_param_ref_atom(source: node, identity: binding) }
        Absent =>
          match node_atom_identity_optional(node: node) {
            Present { value: id } =>
              if dag_lex_token_symbol(sym: id) {
                if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                  OperandRefLowered { lowered: body_lower_param_ref_atom(source: node, identity: id) }
                } else {
                  body_lower_operand_ref_read_of(found: body_lower_int_literal_with_magnitude_optional(node: node))
                }
              } else {
                OperandRefLowered { lowered: body_lower_param_ref_atom(source: node, identity: id) }
              }
            Absent =>
              match sugar_sequence_pair_optional(node: node) {
                Present { value: pair } =>
                  match body_lower_cast_chain_read(node: node) {
                    OperandRefLowered { lowered: cast } => OperandRefLowered { lowered: cast }
                    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
                    OperandRefAbsent =>
                  match body_lower_dotted_reference_optional(node: node) {
                    Present { value: spine } => OperandRefLowered { lowered: spine }
                    Absent =>
                      if is_empty_conj_root(n: pair.right) {
                        body_lower_operand_ref_read(node: pair.left)
                      } else {
                        match body_lower_paren_group_inner_optional(node: node) {
                          Present { value: inner } => body_lower_operand_ref_read(node: inner)
                          Absent => body_lower_operand_ref_sequence_read(node: node)
                        }
                      }
                  }
                  }
                Absent =>
                  match parse_production_captured_child_optional(node: node) {
                    Present { value: captured } =>
                      body_lower_operand_ref_read(node: captured)
                    Absent => body_lower_operand_fold_children_read(node: node)
                  }
              }
          }
      }
  }
  }
  }
  }
}

fn body_lower_is_block_delimiter_token(id: Symbol) -> Bool {
  (id == ^dag_token_lbrace) || (id == ^dag_token_rbrace)
}

// A CARET SYMBOL (`^name`) IS dag_grammar_caret_symbol_expr: seq(`^`, name), whose name terminal is
// lexeme-stamped. It lowers to a symbol literal (v2.extdeps.languages.dag dag_symbol_literal_node):
// the caret atom, at the `^` token's occurrence, carrying the name terminal -- its own occurrence
// kept -- as its one named payload. Before MQ-1 PR-2 every value position answered it with the bare
// `^` token (two symbols, one node), then PR-1 refused it here; this is the lowered form both lacked.
fn body_lower_symbol_literal_at_caret(caret: Node, name: Node) -> Node {
  dag_symbol_literal_node(name: name, occurrence_id: caret.occurrence_id)
}

fn body_lower_caret_symbol_literal_optional(captured: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(
    node: body_lower_unwrap_surface_shell(node: captured)
  ) {
    Absent => Absent
    Present { value: pair } =>
      match node_atom_identity_optional(
        node: body_lower_deep_unwrap_optional(node: pair.left)
      ) {
        Present { value: id } =>
          if id == ^dag_token_caret {
            optional_present(
              value: body_lower_symbol_literal_at_caret(
                caret: body_lower_deep_unwrap_optional(node: pair.left),
                name: body_lower_deep_unwrap_optional(node: pair.right)
              )
            )
          } else {
            optional_absent()
          }
        Absent => Absent
      }
  }
}

fn body_lower_sequence_left_is_lbrace(captured: Node) -> Bool {
  match sugar_sequence_pair_optional(
    node: body_lower_unwrap_surface_shell(node: captured)
  ) {
    Absent => false
    Present { value: pair } =>
      match node_atom_identity_optional(
        node: body_lower_deep_unwrap_optional(node: pair.left)
      ) {
        Present { value: id } => id == ^dag_token_lbrace
        Absent => false
      }
  }
}

// THE DOT IS NOT AN OPERATOR, AND READING IT AS ONE WAS THE EARLIEST UNJUSTIFIED BOUNDARY OF THE
// CROSS-MODULE REFERENCE CLASS (DESIGN section 6b). The grammar owns the dot as
// dag_grammar_postfix_dot_suffix_expr, one suffix of a postfix chain, and never as an infix
// production. This reader accepted ANY lex token as a binary operator, so `v2.test.p.value` lowered
// to Transform(dot, v2, test) with every later segment DROPPED -- a fabricated plausible body
// (DESIGN section 5) that no consumer reads and that the resolver refuses as an unbound `v2`.
// Measured on the production route (v2.test.claim.namespace_xl0.call_argument_mention_survival) before
// this arm existed. A dotted chain is lowered by body_lower_dotted_reference_optional below. The
// block delimiters are excluded for the sibling reason (gunbc#11595): a brace is a body boundary,
// not an operator, and reading it as one dropped the call inside a brace-bodied fn.
fn body_lower_operator_atom_optional(node: Node) -> Optional<Node> {
  match node_atom_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_token_dot {
        optional_absent()
      } else if dag_lex_token_symbol(sym: id) && !body_lower_is_block_delimiter_token(id: id) {
        optional_present(
          value: node_lowered_from(
            kind: TypeNode { connective: Atom { identity: id } },
            children: [],
            source: node
          )
        )
      } else {
        optional_absent()
      }
    Absent => Absent
  }
}

fn body_lower_unwrap_captured(shell: Node) -> Optional<Node> {
  parse_production_captured_child_optional(node: shell)
}

// AN OPERATOR EXPRESSION IS READ OFF THE GRAMMAR'S OWN PRECEDENCE TOWER, WHOLE, AND A POSITION THE
// READER CANNOT READ REFUSES.
//
// v2.extdeps.languages.dag dag_grammar_binary_expr_expr is a tower of seven levels, each
//   level = sequence(next_level, tail)
// whose tail is a REPEAT of sequence(operator, next_level) for the pipe, or, and, additive and
// multiplicative levels and an OPTIONAL of the same for equality and comparison. The parse captures
// a repeat as a cons spine -- sequence(element, rest), ending in the empty conj -- and an optional
// as its element or the empty conj, so a tail is exactly one of
//   the empty conj                              (no operator at this level)
//   sequence(operator, operand)                 (an optional that matched)
//   sequence(sequence(operator, operand), rest) (a repeat element and the rest of the repeat)
// and the bottom of the tower is dag_grammar_unary_expr_expr: a prefix `!` or `-` over another
// unary, or a postfix expression.
//
// THE READER IT REPLACES READ ONE OPERATOR AND DROPPED THE REST, SILENTLY. It lowered the first
// sequence(operator, operand) it found and returned, so `a && b && c` lowered to `a && b` with `c`
// gone; its operand reader, body_lower_operand_ref_optional, narrowed any other sequence to its
// LEFT element, so `!a && b` lost `a` (read as the bare `!`) and, in a body the bottom-up fold had
// not lowered, `a && b` became `a`. Measured on the real tokenize -> parse -> normalize route: an
// atom only on the right of those shapes reached no reference site
// (gunbc.recurring_failure_mode lowering_accessor_collapses_a_sequence_operand). Every operand is
// now lowered and folded left-associatively, and an unreadable position is a located refusal.
type OperatorExpressionRead
  = OperatorExpressionAbsent
  | OperatorExpressionRead { lowered: Node }
  | OperatorExpressionRefused { diagnostics: NonEmptyDiagnostics }

// THE OPERATOR SETS ARE READ OFF THE GRAMMAR, NOT LISTED BESIDE IT. Every terminal of
// dag_grammar_binary_expr_expr is an operator -- its nonterminals are the unary operands -- and every
// terminal of dag_grammar_unary_expr_expr is a prefix operator, so collecting the terminals of those
// two expressions IS the operator set. An operator the grammar gains is recognised here with no edit;
// a hand-copied list would have answered OperatorExpressionAbsent for it and let the expression fall
// to the other lowering routes (review 70545).
fn body_lower_grammar_terminals(expr: GrammarExpr) -> List<Symbol> {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, _stamp) { [token_class] },
      literal_terminal: fn(token_class, _lexeme) { [token_class] },
      nonterminal: fn(_production) { Empty },
      sequence: fn(l, r) { list_append(left: l, right: r) },
      choice: fn(l, r) { list_append(left: l, right: r) },
      optional: fn(e) { e },
      repeat: fn(e) { e },
      expect: fn(e, _reason) { e },
      refuse_on_match: fn(e, _reason) { e },
      after_line_break: fn(e) { e },
      not_predicate: fn(_e) { Empty }
    }
  )
}

// Nullary, pure and reifying to symbols, so both sets are enrolled WARM in
// v2.workflow.floor_pure_producer_share: building the grammar expressions per claim frame cost
// ~11.4k eval steps and pushed v2.test.manual.body_lowering_normalize_add over the new-witness
// budget on this PR's first floor run.
fn body_lower_binary_operator_tokens() -> List<Symbol> {
  body_lower_grammar_terminals(expr: dag_grammar_binary_expr_expr())
}

fn body_lower_prefix_operator_tokens() -> List<Symbol> {
  body_lower_grammar_terminals(expr: dag_grammar_unary_expr_expr())
}

// Read once per frame through these rows; the floor serves the producers above from its warm tier.
data body_lower_binary_operators: List<Symbol> = body_lower_binary_operator_tokens()

data body_lower_prefix_operators: List<Symbol> = body_lower_prefix_operator_tokens()

fn body_lower_symbol_listed(id: Symbol, xs: List<Symbol>) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, x) { acc || (x == id) })
}

fn body_lower_is_binary_operator_token(id: Symbol) -> Bool {
  body_lower_symbol_listed(id: id, xs: body_lower_binary_operators)
}

fn body_lower_is_prefix_operator_token(id: Symbol) -> Bool {
  body_lower_symbol_listed(id: id, xs: body_lower_prefix_operators)
}

fn body_lower_operator_token_optional(node: Node, binary: Bool) -> Optional<Node> {
  match node_atom_identity_optional(node: node) {
    Present { value: id } =>
      if (binary && body_lower_is_binary_operator_token(id: id))
        || (!binary && body_lower_is_prefix_operator_token(id: id)) {
        optional_present(value: node_synthetic(kind: TypeNode { connective: Atom { identity: id } }, children: []))
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

// A tower level with no operator is sequence(next_level, empty): the level is its next level.
fn body_lower_strip_operator_free_levels(node: Node) -> Node {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Present { value: pair } =>
      if is_empty_conj_root(n: pair.right) {
        body_lower_strip_operator_free_levels(node: pair.left)
      } else {
        stripped
      }
    Absent => stripped
  }
}

// Whether a tail carries an operator: its first element is one, or is sequence(operator, operand).
fn body_lower_tail_has_binary_operator(tail: Node) -> Bool {
  match sugar_sequence_pair_optional(node: tail) {
    Absent => false
    Present { value: pair } =>
      match body_lower_operator_token_optional(node: pair.left, binary: true) {
        Present { value: _ } => true
        Absent =>
          match sugar_sequence_pair_optional(node: pair.left) {
            Present { value: element } =>
              match body_lower_operator_token_optional(node: element.left, binary: true) {
                Present { value: _ } => true
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lower_operator_refusal(reason: Symbol, at: Node) -> OperatorExpressionRead {
  OperatorExpressionRefused { diagnostics: diagnostics_singleton(d: body_lower_diagnostic(reason: reason, n: at)) }
}

// One operand of an operator expression, lowered whole or refused at the operand.
fn body_lower_operator_operand(node: Node) -> Outcome<Node> {
  let operand = body_lower_strip_operator_free_levels(node: node)
  match body_lower_read_operator_expression(node: operand) {
    OperatorExpressionRead { lowered: lowered } => outcome_accepted(value: lowered)
    OperatorExpressionRefused { diagnostics: r } => Rejected { diagnostics: r }
    OperatorExpressionAbsent =>
      if body_lower_is_core_substrate(node: operand) {
        outcome_accepted(value: operand)
      } else if body_lower_is_unrecognised_lowered_shape(node: operand) {
        Rejected { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: operand) }
      } else {
        match body_lower_try_body_lowered(node: operand) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: Present { value: lowered }, diagnostics: d } =>
            outcome_with_diagnostics(value: lowered, diagnostics: d)
          Accepted { value: Absent, diagnostics: _ } =>
            match body_lower_operand_ref_read(node: operand) {
              OperandRefLowered { lowered: lowered } => outcome_accepted(value: lowered)
              OperandRefAbsent =>
                outcome_rejected(
                  d: body_lower_diagnostic(reason: ^body_lowering_reason_operator_operand_unread, n: operand)
                )
              OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
            }
        }
      }
  }
}

// ONE OPERATOR APPLIED TO THE ACCUMULATED LEFT OPERAND. `xs |> fold(init, step)` is a fold whose
// receiver the pipe supplies: the fold template is receiver-first, so the pipe's left operand IS the
// collection, and it lowers to the fold encoding with that operand as its domain
// (v2.compiler.fold_lowering fold_call_lowering_piped). A pipe into anything else, and a fold whose
// step this stage cannot read (a step by name), stays the ordinary infix Transform it always was.
fn body_lower_binary_apply(acc: Node, operator: Node, right: Node) -> Outcome<Node> {
  match body_lower_piped_fold_optional(acc: acc, operator: operator, right: right) {
    Present { value: lowered } => lowered
    Absent =>
      match body_lower_operator_operand(node: right) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: operand, diagnostics: d } =>
          outcome_with_diagnostics(value: lower_binary_infix(left: acc, operator: operator, right: operand), diagnostics: d)
      }
  }
}

fn body_lower_operator_is_pipe(operator: Node) -> Bool {
  match node_atom_identity_optional(node: operator) {
    Present { value: id } => id == ^dag_token_pipe_gt
    Absent => false
  }
}

fn body_lower_piped_fold_optional(acc: Node, operator: Node, right: Node) -> Optional<Outcome<Node>> {
  if body_lower_operator_is_pipe(operator: operator) {
    match body_lower_fold_call_beneath(node: body_lower_strip_operator_free_levels(node: right)) {
      Absent => optional_absent()
      Present { value: call } =>
        match fold_call_lowering_piped(fold_call: call, receiver: acc) {
          FoldCallLowered { operands: operands } =>
            optional_present(value: body_lower_fold_encoding_from(operands: operands, collection: outcome_accepted(value: acc)))
          FoldCallCallbackLowered { operands: operands } =>
            optional_present(value: body_lower_callback_encoding_from(operands: operands, collection: outcome_accepted(value: acc)))
          FoldCallStepShapeInvalid { diagnostic: d } => optional_present(value: outcome_rejected(d: d))
          FoldCallOperandAbsent { diagnostic: d } => optional_present(value: outcome_rejected(d: d))
          FoldCallStepFormUnresolved { diagnostic: _ } => optional_absent()
          FoldCallNotAFold { diagnostic: _ } => optional_absent()
        }
    }
  } else {
    optional_absent()
  }
}

// The fold-family call an operand is, reached down its captured-child chain exactly as
// body_lower_fold_family_call_first reads a call: the captured child whose head is a fold-family
// head. Absent for any other operand.
fn body_lower_fold_call_beneath(node: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: node) {
    Absent => optional_absent()
    Present { value: captured } =>
      match fold_call_head_symbol(fold_call: captured) {
        Present { value: head } =>
          match fold_family_realization(head: head) {
            Present { value: _ } => optional_present(value: captured)
            Absent => body_lower_fold_call_beneath(node: captured)
          }
        Absent => body_lower_fold_call_beneath(node: captured)
      }
  }
}

// Whether a tower tail element is `|> <fold-family call>`: the element is sequence(operator, operand).
fn body_lower_tail_element_pipes_into_fold(element: Node) -> Bool {
  match sugar_sequence_pair_optional(node: element) {
    Absent => false
    Present { value: e } =>
      match body_lower_operator_token_optional(node: e.left, binary: true) {
        Absent => false
        Present { value: operator } =>
          if body_lower_operator_is_pipe(operator: operator) {
            match body_lower_fold_call_beneath(node: body_lower_strip_operator_free_levels(node: e.right)) {
              Present { value: _ } => true
              Absent => false
            }
          } else {
            false
          }
      }
  }
}

// Whether a tower tail -- empty, sequence(operator, operand), or a repeat spine
// sequence(sequence(operator, operand), rest) -- pipes into a fold-family call anywhere along it.
fn body_lower_tail_pipes_into_fold(tail: Node) -> Bool {
  if is_empty_conj_root(n: tail) {
    false
  } else if body_lower_tail_element_pipes_into_fold(element: tail) {
    true
  } else {
    match sugar_sequence_pair_optional(node: tail) {
      Absent => false
      Present { value: pair } =>
        body_lower_tail_element_pipes_into_fold(element: pair.left) || body_lower_tail_pipes_into_fold(tail: pair.right)
    }
  }
}

// Whether a node is the `|>` token: one identity comparison, no operator-list scan.
fn body_lower_node_is_pipe_token(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => id == ^dag_token_pipe_gt
    Absent => false
  }
}

// Whether a tail's FIRST element is headed by `|>`: the tail is sequence(operator, operand) or
// sequence(sequence(operator, operand), rest), read from the node's own shape.
fn body_lower_tail_starts_with_pipe(tail: Node) -> Bool {
  match sugar_sequence_pair_optional(node: tail) {
    Absent => false
    Present { value: pair } =>
      if body_lower_node_is_pipe_token(node: pair.left) {
        true
      } else {
        match sugar_sequence_pair_optional(node: pair.left) {
          Absent => false
          Present { value: element } => body_lower_node_is_pipe_token(node: element.left)
        }
      }
  }
}

// THE ROOT OF A PIPE TOWER, DECIDED FROM THE NODE'S OWN SHAPE BY IDENTITY COMPARISONS ALONE.
// body_lower_fold runs at every node, so this guard reads only the node's own sequence pair and
// compares token identities with `|>`: no walk, and no scan of the operator roster (the first
// constant-time cut asked body_lower_operator_token_optional, whose roster fold ran several times
// per node and doubled the native route's context phase -- 918s at base against 1892s, census
// gunbc#12550). The pipe is the outermost level of v2.extdeps.languages.dag
// dag_grammar_binary_expr_expr, so a sequence whose tail starts with `|>` is a pipe tower; a
// repeat-spine node inside that tail, sequence(sequence(`|>`, operand), rest), is excluded by its
// left element starting with `|>`, so the tower is decided once, at its root.
fn body_lower_is_pipe_tower_root(node: Node) -> Bool {
  match sugar_sequence_pair_optional(node: node) {
    Absent => false
    Present { value: pair } =>
      if body_lower_tail_starts_with_pipe(tail: pair.left) {
        false
      } else {
        body_lower_tail_starts_with_pipe(tail: pair.right)
      }
  }
}

// A TOWER THAT PIPES INTO A FOLD IS READ WHOLE, BEFORE ITS OPERANDS ARE FOLDED. The bottom-up fold
// lowers an operator expression's children first, so the fold call on the right of `|>` would be
// lowered on its own -- with no collection, since the pipe supplies it -- before the tower could hand
// it the pipe's input. So such a tower -- recognised at its ROOT by structure (body_lower_is_pipe_tower_root,
// constant time), whatever production identity the node carries, since the value reader unwraps shells
// before folding; only a root then pays the tail scan below, once per tower -- is read by the
// raw tower reader, whose binary step
// (body_lower_binary_apply) builds the fold encoding with the accumulated left operand as the
// collection. Every other tower takes the ordinary bottom-up path unchanged.
fn body_lower_tower_pipes_into_fold(node: Node) -> Bool {
  match sugar_sequence_pair_optional(node: body_lower_strip_operator_free_levels(node: node)) {
    Absent => false
    Present { value: pair } => body_lower_tail_pipes_into_fold(tail: pair.right)
  }
}

fn body_lower_fold_operator_tail(acc: Node, tail: Node) -> OperatorExpressionRead {
  if is_empty_conj_root(n: tail) {
    OperatorExpressionRead { lowered: acc }
  } else {
    match sugar_sequence_pair_optional(node: tail) {
      Absent => body_lower_operator_refusal(reason: ^body_lowering_reason_operator_tail_unread, at: tail)
      Present { value: pair } =>
        match body_lower_operator_token_optional(node: pair.left, binary: true) {
          Present { value: operator } =>
            match body_lower_binary_apply(acc: acc, operator: operator, right: pair.right) {
              Rejected { diagnostics: r } => OperatorExpressionRefused { diagnostics: r }
              Accepted { value: applied, diagnostics: _ } => OperatorExpressionRead { lowered: applied }
            }
          Absent =>
            match sugar_sequence_pair_optional(node: pair.left) {
              Absent => body_lower_operator_refusal(reason: ^body_lowering_reason_operator_tail_unread, at: tail)
              Present { value: element } =>
                match body_lower_operator_token_optional(node: element.left, binary: true) {
                  Absent => body_lower_operator_refusal(reason: ^body_lowering_reason_operator_tail_unread, at: tail)
                  Present { value: operator } =>
                    match body_lower_binary_apply(acc: acc, operator: operator, right: element.right) {
                      Rejected { diagnostics: r } => OperatorExpressionRefused { diagnostics: r }
                      Accepted { value: applied, diagnostics: _ } =>
                        body_lower_fold_operator_tail(acc: applied, tail: pair.right)
                    }
                }
            }
        }
    }
  }
}

// Absent: this node is not an operator expression -- no prefix operator heads it and no operator
// sits in its tower tail. Read: every operand lowered. Refused: an operator was read and a position
// under it was not.
fn body_lower_read_operator_expression(node: Node) -> OperatorExpressionRead {
  let stripped = body_lower_strip_operator_free_levels(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => OperatorExpressionAbsent
    Present { value: pair } =>
      match body_lower_operator_token_optional(node: pair.left, binary: false) {
        Present { value: operator } =>
          match body_lower_operator_operand(node: pair.right) {
            Rejected { diagnostics: r } => OperatorExpressionRefused { diagnostics: r }
            Accepted { value: operand, diagnostics: _ } =>
              OperatorExpressionRead { lowered: lower_unary_prefix(operator: operator, operand: operand) }
          }
        Absent =>
          if body_lower_tail_has_binary_operator(tail: pair.right) {
            match body_lower_operator_operand(node: pair.left) {
              Rejected { diagnostics: r } => OperatorExpressionRefused { diagnostics: r }
              Accepted { value: left, diagnostics: _ } =>
                body_lower_fold_operator_tail(acc: left, tail: pair.right)
            }
          } else {
            OperatorExpressionAbsent
          }
      }
  }
}

fn body_lower_try_infix_transform(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_read_operator_expression(node: node) {
    OperatorExpressionAbsent => outcome_accepted(value: optional_absent())
    OperatorExpressionRead { lowered: lowered } => outcome_accepted(value: optional_present(value: lowered))
    OperatorExpressionRefused { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn body_lower_try_fold_loop_search(node: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_primary_expr {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_try_fold_loop(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: id) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_try_fold_loop(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent => outcome_accepted(value: optional_absent())
  }
}

// FoldCallStepFormUnresolved is a COUNTED FRONTIER STATE HERE, not a refusal,
// and this is the one place in the corpus that reads it that way. The stage
// cannot resolve the callee (see fold_call_lowering's note), so it cannot know
// whether a fold-family call with no fn literal is malformed or merely carries
// its step by name. It therefore reports "no loop produced" with the typed,
// located diagnostic attached rather than refusing on a judgement it has not
// earned -- and produces no Loop, exactly as the refusal did. A retained shell
// that is genuinely broken still meets normalize's recursive well_formed gate,
// which #6520 established as the sole structural wall and which is untouched.
// FoldCallStepShapeInvalid stays a refusal: there the fn literal is in hand.
fn body_lower_try_fold_loop(node: Node) -> Outcome<Optional<Node>> {
  match fold_call_head_symbol(fold_call: node) {
    Present { value: head } =>
      match fold_family_realization(head: head) {
        Present { value: _ } =>
        match fold_call_lowering(fold_call: node) {
          FoldCallLowered { operands: operands } =>
            match body_lower_fold_encoding(operands: operands) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: encoding, diagnostics: d } =>
                outcome_with_diagnostics(value: optional_present(value: encoding), diagnostics: d)
            }
          FoldCallCallbackLowered { operands: operands } =>
            match body_lower_callback_encoding(operands: operands) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: encoding, diagnostics: d } =>
                outcome_with_diagnostics(value: optional_present(value: encoding), diagnostics: d)
            }
          FoldCallOperandAbsent { diagnostic: d } => outcome_rejected(d: d)
          FoldCallStepFormUnresolved { diagnostic: d } =>
            outcome_with_diagnostics(
              value: optional_absent(),
              diagnostics: Some { diagnostics: diagnostics_singleton(d: d) }
            )
          FoldCallNotAFold { diagnostic: d } => outcome_rejected(d: d)
          FoldCallStepShapeInvalid { diagnostic: d } => outcome_rejected(d: d)
        }
        Absent =>
        body_lower_try_fold_loop_search(node: node)
      }
    Absent => body_lower_try_fold_loop_search(node: node)
  }
}

fn body_lower_type_atom_from_expr(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_type_expr {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_type_atom_from_expr(node: captured)
          Absent => optional_absent()
        }
      } else if id == ^dag_surface_qualified_name {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } =>
            match node_atom_identity_optional(node: captured) {
              Present { value: sym } =>
                optional_present(value: body_lower_type_atom_node(sym: sym, source: captured))
              Absent =>
                match body_lower_qualified_name_production_spine_optional(node: node, captured: captured) {
                  Present { value: spine } => Present { value: spine }
                  Absent => body_lower_type_atom_from_expr(node: captured)
                }
            }
          Absent => optional_absent()
        }
      } else {
        Absent
      }
    Absent =>
      match dag_binding_branded_atom_identity(node: node) {
        Present { value: binding } =>
          Present { value: body_lower_type_atom_node(sym: binding, source: node) }
        Absent =>
          match node_atom_identity_optional(node: node) {
            Present { value: sym } =>
              if dag_lex_token_symbol(sym: sym) {
                optional_absent()
              } else {
                optional_present(value: body_lower_type_atom_node(sym: sym, source: node))
              }
            Absent =>
              match sugar_sequence_pair_optional(node: node) {
                Present { value: pair } =>
                  match body_lower_type_atom_from_expr(node: pair.left) {
                    Present { value: found } => Present { value: found }
                    Absent => body_lower_type_atom_from_expr(node: pair.right)
                  }
                Absent =>
                  fold(node.children, init: Absent, f: fn(acc, e) {
                    match acc {
                      Present { value: _ } => acc
                      Absent => body_lower_type_atom_from_expr(node: e.target)
                    }
                  })
              }
          }
      }
  }
}

fn body_lower_unwrap_surface_shell(node: Node) -> Node {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if body_lower_is_pass_through_emitted(emitted: emitted) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_unwrap_surface_shell(node: captured)
          Absent => node
        }
      } else {
        node
      }
    Absent => node
  }
}

fn body_lower_after_comma_tail_optional(node: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: node) {
    Absent => optional_absent()
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Present { value: id } =>
          if id == ^dag_token_comma {
            optional_present(value: pair.right)
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

// ONE PARAMETER AS AUTHORED: the binder atom, lowered from the token it was read from so it keeps
// its minted occurrence (body_lower_param_binding_atom_optional), and the lowered type. The
// parameter Edge is this record's projection (body_lower_binder_edge_read), and so is the binder
// list v2.compiler.occurrence_role reads (body_lower_param_list_binder_atoms): one reader, two views.
type BodyLowerTypedParam {
  binder: Node,
  name: Symbol,
  type_node: Node,
  default: Optional<Node>,
}

fn body_lower_collect_param_edges(sequence_capture: Node) -> Outcome<List<Edge>> {
  bind_outcome(o: body_lower_collect_typed_params(sequence_capture: sequence_capture), f: fn(params) {
    fold(params, init: outcome_accepted(value: Empty), f: fn(acc, param) {
      bind_outcome(o: acc, f: fn(edges) {
        bind_outcome(o: body_lower_binder_edge_read(param: param, default: param.default), f: fn(edge) {
          outcome_accepted(value: list_snoc_item(xs: edges, item: edge))
        })
      })
    })
  })
}

// A repeat element is seq(`,`, param): the parameter is its RIGHT element, read by position. It used
// to try the right and, on Absent, the left -- the `,` token -- a second reader standing in for the
// first's failure.
fn body_lower_typed_param_from_comma_seq(sequence_capture: Node) -> Outcome<BodyLowerTypedParam> {
  match sugar_sequence_pair_optional(node: sequence_capture) {
    Present { value: pair } => body_lower_typed_param_slot(param_capture: pair.right)
    Absent => body_lower_typed_param_slot(param_capture: sequence_capture)
  }
}

// ONE PARAMETER SLOT, READ OR REFUSED: a slot the typed-parameter reader cannot read refuses
// body_lowering_reason_parameter_unlowered, located at the slot. It is never skipped.
fn body_lower_typed_param_slot(param_capture: Node) -> Outcome<BodyLowerTypedParam> {
  match body_lower_typed_param_optional(param_capture: param_capture) {
    Present { value: param } => outcome_accepted(value: param)
    Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_parameter_unlowered, n: param_capture))
  }
}

// ONE ENTRY PER PARAMETER SLOT THE LIST WRITES, each read or refused (body_lower_typed_param_slot).
// The walk never drops a slot, and neither does its one view (body_lower_collect_typed_params): the
// first refused slot refuses the whole list. Lowering's domain and the binder list
// v2.compiler.occurrence_role reads are the same read, so a parameter can no longer be missing from
// the domain while present in the source (gunbc.recurring_failure_mode
// lowering_accessor_collapses_a_sequence_operand, the binder route).
fn body_lower_collect_typed_param_slots_from_repeat_tail(repeat_capture: Node) -> List<Outcome<BodyLowerTypedParam>> {
  if is_empty_conj_root(n: repeat_capture) {
    Empty
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: head_sequence, diagnostics: _ } =>
        let slot = body_lower_typed_param_from_comma_seq(sequence_capture: head_sequence)
        match find_named_child(root: repeat_capture, name: ^grammar_sequence_right_node_projection) {
          Accepted { value: tail, diagnostics: _ } =>
            list_append(left: [slot], right: body_lower_collect_typed_param_slots_from_repeat_tail(repeat_capture: tail))
          Rejected { diagnostics: _ } => [slot]
        }
      Rejected { diagnostics: _ } => Empty
    }
  }
}

fn body_lower_collect_typed_param_slots(sequence_capture: Node) -> List<Outcome<BodyLowerTypedParam>> {
  match find_named_child(root: sequence_capture, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: first, diagnostics: _ } =>
      let first_slots = [body_lower_typed_param_slot(param_capture: first)]
      match find_named_child(root: sequence_capture, name: ^grammar_sequence_right_node_projection) {
        Accepted { value: outer_right, diagnostics: _ } =>
          match find_named_child(root: outer_right, name: ^grammar_sequence_left_node_projection) {
            Accepted { value: repeat_capture, diagnostics: _ } =>
              list_append(left: first_slots, right: body_lower_collect_typed_param_slots_from_repeat_tail(repeat_capture: repeat_capture))
            Rejected { diagnostics: _ } => first_slots
          }
        Rejected { diagnostics: _ } => first_slots
      }
    Rejected { diagnostics: _ } =>
      match body_lower_typed_param_optional(param_capture: sequence_capture) {
        Present { value: param } => [outcome_accepted(value: param)]
        Absent =>
          match sugar_sequence_pair_optional(node: sequence_capture) {
            Absent =>
              if is_empty_conj_root(n: sequence_capture) {
                Empty
              } else {
                [body_lower_typed_param_slot(param_capture: sequence_capture)]
              }
            Present { value: pair } =>
              let slot = body_lower_typed_param_slot(param_capture: pair.left)
              match body_lower_after_comma_tail_optional(node: pair.right) {
                Present { value: tail } => list_append(left: [slot], right: body_lower_collect_typed_param_slots(sequence_capture: tail))
                Absent => [slot]
              }
          }
      }
  }
}

// THE ONE VIEW: every slot's parameter, in order, or the first slot's refusal.
fn body_lower_collect_typed_params(sequence_capture: Node) -> Outcome<List<BodyLowerTypedParam>> {
  fold(body_lower_collect_typed_param_slots(sequence_capture: sequence_capture), init: outcome_accepted(value: Empty), f: fn(acc, slot) {
    match acc {
      Rejected { diagnostics: _ } => acc
      Accepted { value: params, diagnostics: _ } =>
        match slot {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: param, diagnostics: _ } => outcome_accepted(value: list_snoc_item(xs: params, item: param))
        }
    }
  })
}

// A PARAMETER LIST'S EDGES, WITH EVERY ANONYMOUS SLOT MINTED. The raw collector below recurses over
// the comma spine and cannot know a slot's position; the mint needs the whole list, so it runs once
// here, and both the domain (body_lower_domain_from_param_list) and the ingest-side binding list the
// domain is checked against (body_lower_param_binding_symbols_from_param_list) read through it.
fn body_lower_param_list(sequence_capture: Node) -> Outcome<DeclaredParameterList> {
  bind_outcome(o: body_lower_collect_param_edges(sequence_capture: sequence_capture), f: fn(edges) {
    outcome_accepted(value: anonymous_binder_mint_parameter_list(edges: edges))
  })
}

fn body_lower_param_edges(sequence_capture: Node) -> Outcome<List<Edge>> {
  bind_outcome(o: body_lower_param_list(sequence_capture: sequence_capture), f: fn(minted) {
    outcome_accepted(value: minted.edges)
  })
}

fn body_lower_param_binding_optional(node: Node) -> Optional<Symbol> {
  match body_lower_param_binding_atom_optional(node: node) {
    Present { value: atom } => node_atom_identity_optional(node: atom)
    Absent => optional_absent()
  }
}

// The same read, answered as the atom that carries the name: lowered from the token it was read
// from (v2.std.node node_lowered_from), so a caller that places the name in the tree keeps its
// minted occurrence. The name-only reader above is this one's projection, not a second reader.
// A BINDER IS A NAME, SO IT IS READ AS A NAME AND NEVER AS AN OPERAND. Every binder position the
// grammar writes -- a parameter, a field, a named argument's label, a let key, a type parameter, a
// projection's member -- is an identifier, possibly under shells whose value is that one atom. The
// reader peels exactly those shells (a production's captured child, an optional element, a sequence
// whose right projection is empty) and answers the atom; anything else is not a binder, and each
// caller refuses at its own locus. It used to fall back to the operand reader, which could answer a
// PART of an operator expression, and whose refusal it had to map to Absent (the binder route of
// gunbc.recurring_failure_mode lowering_accessor_collapses_a_sequence_operand): a name reader has no
// such arm to collapse.
fn body_lower_param_binding_atom_optional(node: Node) -> Optional<Node> {
  match dag_binding_branded_atom_identity(node: node) {
    Present { value: binding } =>
      optional_present(value: node_lowered_from(kind: TypeNode { connective: Atom { identity: binding } }, children: [], source: node))
    Absent =>
      match node_atom_identity_optional(node: node) {
        Present { value: sym } =>
          if dag_lex_token_symbol(sym: sym) {
            optional_absent()
          } else {
            optional_present(value: node_lowered_from(kind: TypeNode { connective: Atom { identity: sym } }, children: [], source: node))
          }
        Absent => body_lower_binder_name_behind_shell_optional(node: node)
      }
  }
}

// The one peel a name admits: a shell whose value IS its single child.
fn body_lower_binder_name_behind_shell_optional(node: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: node) {
    Present { value: inner } => body_lower_param_binding_atom_optional(node: inner)
    Absent =>
      let peeled = body_lower_deep_unwrap_optional(node: node)
      if peeled != node {
        body_lower_param_binding_atom_optional(node: peeled)
      } else {
        match sugar_sequence_pair_optional(node: node) {
          Present { value: pair } =>
            if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
              body_lower_param_binding_atom_optional(node: pair.left)
            } else {
              optional_absent()
            }
          Absent => optional_absent()
        }
      }
  }
}

// `name: <after colon>`, the head a typed parameter and a field declaration share: the binder atom,
// its name, and what follows the colon, which each reader below reads by its own grammar.
type BodyLowerTypedHead {
  binder: Node,
  name: Symbol,
  after_colon: Node,
}

fn body_lower_typed_head_optional(capture: Node) -> Optional<BodyLowerTypedHead> {
  match sugar_sequence_pair_optional(node: capture) {
    Absent => Absent
    Present { value: pair } =>
      match body_lower_param_binding_atom_optional(node: pair.left) {
        Absent => Absent
        Present { value: binder } =>
          match node_atom_identity_optional(node: binder) {
            Absent => Absent
            Present { value: binding } =>
              match sugar_sequence_pair_optional(node: pair.right) {
                Absent => Absent
                Present { value: after_colon } =>
                  Present { value: BodyLowerTypedHead { binder: binder, name: binding, after_colon: after_colon.right } }
              }
          }
      }
  }
}

// A TYPED PARAMETER: `name: T` then an optional tail (v2.extdeps.languages.dag
// dag_grammar_typed_param_expr, left-factored), so what follows the colon is always the pair of the
// type and the tail. An empty tail is a plain parameter; a tail holding the default production is a
// defaulted one, its default kept RAW and lowered by body_lower_binder_edge_read, so it reaches the
// binder (XL-2 PR2c-ii) rather than being refused or dropped. A where-clause refinement is refused
// before this reader runs (body_lower_param_refinement_refusal_optional), so a tail here carries only
// a default.
fn body_lower_typed_param_optional(param_capture: Node) -> Optional<BodyLowerTypedParam> {
  match body_lower_typed_head_optional(capture: param_capture) {
    Absent => Absent
    Present { value: head } =>
      match sugar_sequence_pair_optional(node: head.after_colon) {
        Absent => Absent
        Present { value: type_and_tail } =>
          match body_lower_type_expr_lowered_optional(node: type_and_tail.left) {
            Absent => Absent
            Present { value: type_node } =>
              Present {
                value: BodyLowerTypedParam {
                  binder: head.binder,
                  name: head.name,
                  type_node: type_node,
                  default: body_lower_find_production_shell_optional(root: type_and_tail.right, emitted: ^dag_surface_default_value)
                }
              }
          }
      }
  }
}

// A FIELD DECLARATION is `name: T` with nothing after the type (dag_grammar_field_decl_expr; a field's
// `[from "key"] [= default]` tail sits beside it, read by body_lower_io_item_optional), so what follows
// the colon is the type.
fn body_lower_field_decl_head_optional(capture: Node) -> Optional<BodyLowerTypedParam> {
  match body_lower_typed_head_optional(capture: capture) {
    Absent => Absent
    Present { value: head } =>
      match body_lower_type_expr_lowered_optional(node: head.after_colon) {
        Absent => Absent
        Present { value: type_node } =>
          Present { value: BodyLowerTypedParam { binder: head.binder, name: head.name, type_node: type_node, default: Absent } }
      }
  }
}

// A DEFAULT'S VALUE: the default production `= expr` (dag_grammar_default_value_expr) lowered through
// the one value reader every value position uses, refused at the value under that reader's own cause.
fn body_lower_default_value_read(default_shell: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: default_shell) {
    Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_value_unlowered, n: default_shell))
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_value_unlowered, n: default_shell))
        Present { value: eq_and_expr } => body_lower_value_read(value: eq_and_expr.right)
      }
  }
}

// THE BINDER A TYPED PARAMETER OR FIELD LOWERS TO: its type, and its default when it has one, lowered.
// `default` overrides the parameter's own (a record or io field's default sits in the field's tail,
// beside the field declaration, not inside it).
fn body_lower_binder_edge_read(param: BodyLowerTypedParam, default: Optional<Node>) -> Outcome<Edge> {
  match default {
    Absent => outcome_accepted(value: binder_edge(name: param.name, type_node: param.type_node))
    Present { value: default_shell } =>
      bind_outcome(o: body_lower_default_value_read(default_shell: default_shell), f: fn(value) {
        outcome_accepted(value: binder_edge_with_default(name: param.name, type_node: param.type_node, default: value))
      })
  }
}

fn body_lower_deep_unwrap_optional(node: Node) -> Node {
  match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    Accepted { value: child, diagnostics: _ } =>
      body_lower_deep_unwrap_optional(node: child)
    Rejected { diagnostics: _ } => node
  }
}

fn body_lower_deep_unwrap_for_int_literal(node: Node) -> Node {
  match parse_production_captured_child_optional(node: node) {
    Present { value: captured } =>
      body_lower_deep_unwrap_for_int_literal(node: captured)
    Absent => body_lower_deep_unwrap_optional(node: node)
  }
}

fn body_lower_unwrap_optional_element(node: Node) -> Node {
  match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    Accepted { value: child, diagnostics: _ } => child
    Rejected { diagnostics: _ } => node
  }
}



// THE WHOLE TYPE EXPRESSION, NOT ITS HEAD ATOM. dag_grammar_qualified_type_expr is
// seq(seq(qualified_name, optional(`<` type_list `>`)), optional(`?`)). The head lowers as
// before (a binding atom or a qualified-name spine); a generic application becomes the
// Instantiation connective with the head as its first positional child and each argument
// after it (the shape v2.std.compilers.target_model reads the head from, index 0); a trailing
// `?` wraps the result in the Cardinality connective, v2's authority for an optional field
// (v2.std.node_query DeclaredField.cardinality, decoded once at declared_field_cardinality_of_target). Before this reader a param or field typed
// `List<Int>` or `Int?` lowered to the bare head atom, silently.
fn body_lower_type_generic_args_optional(generic_capture: Node) -> Optional<List<Node>> {
  let stripped = body_lower_deep_unwrap_optional(node: generic_capture)
  if is_empty_conj_root(n: stripped) {
    optional_present(value: Empty)
  } else {
    match sugar_sequence_pair_optional(node: stripped) {
      Absent => Absent
      Present { value: pair } =>
        match node_atom_identity_optional(node: pair.left) {
          Present { value: lt } =>
            if lt == ^dag_token_lt {
              match sugar_sequence_pair_optional(node: pair.right) {
                Absent => Absent
                Present { value: inner } =>
                  match body_lower_comma_list_items_optional(list_capture: inner.left) {
                    Absent => Absent
                    Present { value: items } =>
                      fold(items, init: Present { value: Empty }, f: fn(acc, item) {
                        match acc {
                          Absent => Absent
                          Present { value: args } =>
                            match body_lower_type_expr_lowered_optional(node: item) {
                              Absent => Absent
                              Present { value: arg } => Present { value: list_snoc_item(xs: args, item: arg) }
                            }
                        }
                      })
                  }
              }
            } else {
              Absent
            }
          Absent => Absent
        }
    }
  }
}

// Closes the image body_lower_type_wrap_instantiation_image builds: its returned node is the named root (v2.std.node
// close_lowered_image).
fn body_lower_type_wrap_instantiation(head: Node, args: List<Node>, source: Node) -> Node {
  close_lowered_image(root: body_lower_type_wrap_instantiation_image(head: head, args: args, source: source))
}

fn body_lower_type_wrap_instantiation_image(head: Node, args: List<Node>, source: Node) -> Node {
  if count(args) == 0 {
    head
  } else {
    node_with_occurrence_id(
      kind: TypeNode { connective: Instantiation },
      children: fold(
        list_append(left: [head], right: args),
        init: Empty,
        f: fn(acc, t) { list_snoc_item(xs: acc, item: Edge { label: Positional, target: t }) }
      ),
      occurrence_id: source.occurrence_id
    )
  }
}

fn body_lower_type_wrap_cardinality(base: Node, question_capture: Node, source: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: question_capture)
  if is_empty_conj_root(n: stripped) {
    optional_present(value: base)
  } else {
    match node_atom_identity_optional(node: stripped) {
      Present { value: q } =>
        match q == ^dag_token_question {
          true =>
            optional_present(
              value: close_lowered_image(root: node_with_occurrence_id(
                kind: TypeNode { connective: Cardinality },
                children: [Edge { label: Positional, target: base }],
                occurrence_id: source.occurrence_id
              ))
            )
          false => optional_absent()
        }
      Absent => Absent
    }
  }
}

// A FUNCTION TYPE `fn(T0, T1) -> U` is the Arrow the target model reads as its positional wire
// (v2.std.compilers.target_model TargetTypeExprArrowPositionalWire, target_type_expr_arrow_emitted):
// the inputs, then the output, all positional; no body edge. The captured is
// seq(`fn`, seq(`(`, seq(type_list, seq(`)`, seq(`->`, type_expr))))).
fn body_lower_fn_type_lowered_optional(fn_type_shell: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: fn_type_shell) {
    Absent => Absent
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => Absent
        Present { value: after_fn } =>
          match sugar_sequence_pair_optional(node: after_fn.right) {
            Absent => Absent
            Present { value: after_lparen } =>
              match sugar_sequence_pair_optional(node: after_lparen.right) {
                Absent => Absent
                Present { value: after_list } =>
                  match sugar_sequence_pair_optional(node: after_list.right) {
                    Absent => Absent
                    Present { value: after_rparen } =>
                      match sugar_sequence_pair_optional(node: after_rparen.right) {
                        Absent => Absent
                        Present { value: after_arrow } =>
                          match body_lower_comma_list_items_optional(list_capture: after_list.left) {
                            Absent => Absent
                            Present { value: items } =>
                              match fold(items, init: Present { value: Empty }, f: fn(acc, item) {
                                match acc {
                                  Absent => Absent
                                  Present { value: domain_types } =>
                                    match body_lower_type_expr_lowered_optional(node: item) {
                                      Absent => Absent
                                      Present { value: t } => Present { value: list_snoc_item(xs: domain_types, item: t) }
                                    }
                                }
                              }) {
                                Absent => Absent
                                Present { value: domain_types } =>
                                  match body_lower_type_expr_lowered_optional(node: after_arrow.right) {
                                    Absent => Absent
                                    Present { value: codomain_type } =>
                                      optional_present(
                                        value: close_lowered_image(root: anonymous_signature_arrow(
                                          domain_types: domain_types,
                                          codomain: codomain_type,
                                          source: fn_type_shell
                                        ))
                                      )
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// AN ANONYMOUS RECORD TYPE IS THE SAME CONJ A RECORD DECLARATION'S BODY IS. `-> { success: Bool }`
// is a type expression whose captured is a field_decl_block, and a field block already has one
// reader: body_lower_field_decl_block_payload, which `type R { ... }` and a variant's record payload
// lower through, giving Conj { success: Bool }. Before this arm the reader had no case for the block,
// answered Absent, and every fn whose signature carried one was retained whole at the fn_decl shell
// (gen-two census: gunbc.tools.cron_tag upsert_tagged_cron_tab). A block whose fields cannot be read
// still answers Absent here and so still retains -- this reader is Optional by contract, and the
// retention is the counted frontier, not a silent accept.
fn body_lower_anonymous_record_type_optional(block_shell: Node) -> Optional<Node> {
  match body_lower_field_decl_block_payload(block_shell: block_shell) {
    Accepted { value: payload, diagnostics: _ } => optional_present(value: payload)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn body_lower_type_expr_lowered_optional(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_type_expr {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_type_expr_lowered_optional(node: captured)
          Absent => Absent
        }
      } else if id == ^dag_surface_fn_type {
        body_lower_fn_type_lowered_optional(fn_type_shell: node)
      } else if id == ^dag_surface_field_decl_block {
        body_lower_anonymous_record_type_optional(block_shell: node)
      } else {
        body_lower_type_atom_from_expr(node: node)
      }
    Absent =>
      match sugar_sequence_pair_optional(node: node) {
        Absent => body_lower_type_atom_from_expr(node: node)
        Present { value: outer } =>
          match sugar_sequence_pair_optional(node: outer.left) {
            Absent => body_lower_type_atom_from_expr(node: node)
            Present { value: inner } =>
              match body_lower_type_atom_from_expr(node: inner.left) {
                Absent => Absent
                Present { value: head } =>
                  match body_lower_type_generic_args_optional(generic_capture: inner.right) {
                    Absent => Absent
                    Present { value: args } =>
                      body_lower_type_wrap_cardinality(
                        base: body_lower_type_wrap_instantiation(head: head, args: args, source: node),
                        question_capture: outer.right,
                        source: node
                      )
                  }
              }
          }
      }
  }
}

fn body_lower_param_list_comma_spine_optional(param_list_captured: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: param_list_captured) {
    Absent => Absent
    Present { value: pair } =>
      match sugar_sequence_pair_optional(node: pair.right) {
        Absent => Absent
        Present { value: inner } =>
          Present {
            value: body_lower_unwrap_optional_element(node: inner.left)
          }
      }
  }
}

fn body_lower_type_atom_from_arrow_seq_right(right: Node) -> Optional<Node> {
  match body_lower_find_captured(
    root: right,
    emitted: ^dag_surface_type_expr
  ) {
    ParseSubtreeFound { captured: type_expr } =>
      body_lower_type_expr_lowered_optional(node: type_expr)
    ParseSubtreeAbsent =>
      match parse_production_emitted_identity_optional(node: right) {
        Present { value: emitted } =>
          match emitted == ^dag_surface_type_expr {
            true =>
              match parse_production_captured_child_optional(node: right) {
                Present { value: captured } =>
                  body_lower_type_expr_lowered_optional(node: captured)
                Absent => Absent
              }
            false => Absent
          }
        Absent => Absent
      }
  }
}

fn body_lower_arrow_seq_return_type(node: Node) -> Optional<Node> {
  match find_named_child(root: node, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: left, diagnostics: _ } =>
      match body_lower_sequence_head_is_arrow(node: left) {
        true =>
          match find_named_child(root: node, name: ^grammar_sequence_right_node_projection) {
            Accepted { value: right, diagnostics: _ } =>
              body_lower_type_atom_from_arrow_seq_right(right: right)
            Rejected { diagnostics: _ } => Absent
          }
        false => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

// A DECLARED DOMAIN AND ITS DECLARED ORDER, from one mint (v2.std.anonymous_binder
// anonymous_binder_mint_parameter_list). The Conj carries the binders keyed by name; `order` carries
// the sequence the author wrote, which the Conj cannot.
type BodyLowerDeclaredDomain {
  domain: Node
  order: List<Symbol>
}

// Rejected where a parameter slot refuses (body_lower_typed_param_slot); Absent where the list has no
// comma spine to read.
fn body_lower_declared_domain_from_param_list(param_list: Node) -> Outcome<Optional<BodyLowerDeclaredDomain>> {
  match body_lower_param_list_comma_spine_optional(param_list_captured: param_list) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: comma_spine } =>
      bind_outcome(o: body_lower_param_list(sequence_capture: comma_spine), f: fn(minted) {
        outcome_accepted(
          value: optional_present(
            value: BodyLowerDeclaredDomain {
              domain: node_lowered_from(kind: TypeNode { connective: Conj }, children: minted.edges, source: param_list),
              order: minted.order
            }
          )
        )
      })
  }
}

fn body_lower_domain_from_param_list(param_list: Node) -> Outcome<Optional<Node>> {
  bind_outcome(o: body_lower_declared_domain_from_param_list(param_list: param_list), f: fn(declared) {
    match declared {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: d } => outcome_accepted(value: optional_present(value: d.domain))
    }
  })
}

fn body_lower_sequence_head_is_arrow(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => id == ^dag_token_arrow
    Absent =>
      match sugar_sequence_pair_optional(node: node) {
        Present { value: pair } => body_lower_sequence_head_is_arrow(node: pair.left)
        Absent => false
      }
  }
}

// The return type of a `fn` is a POSITIONAL fact of the fn_decl production, not a shape to go
// looking for. `dag_grammar_fn_decl_expr` is one right-nested sequence:
//   seq(kw_fn, seq(name, seq(opt(generic_params), seq(param_list, seq(RET, BODY)))))
// where RET is `opt(seq(arrow, type_expr))`. So RET is the LEFT of the FOURTH right-projection
// from the production's captured child, at a fixed depth. An elided `optional` still yields
// grammar_empty_node (v2.compiler.parse parse_expr_optional returns one on the rejected arm), so
// the spine positions do NOT shift when the generic params or the arrow clause are absent --
// that is what makes reading by position sound rather than a guess about layout.
//
// THE DEPTH IS VERIFIED AGAINST THE PRODUCTION, NOT SAMPLED FROM SPECIMENS. That production has
// exactly TWO optionals and only generic_params precedes the return clause, so generic_params is
// the entire risk surface for this depth; both it and the `= expr` body arm are held by
// executing falsifiers (`nfbcp_falsifier_generic_fn_return_type_holds`,
// `nfbcp_falsifier_eq_body_fn_return_type_holds`). The reciprocal note lives on the carrier that
// owns the shape, beside dag_grammar_fn_decl_expr, because the person who would break this is
// editing the grammar and not this reader.
//
// THIS REPLACES A SILENTLY WRONG READING, AND THAT IS WHY IT IS NOT AN OPTIMISATION.
// The deleted reading (body_lower_return_type_after_arrow_walk, #10929) walked the whole fn
// subtree looking for any sequence(arrow, ...) with no prune, so it descended into the PARAMETER
// LIST and answered with the first arrow it met there. For `fn g(h: fn(Int) -> Int) -> Bool`
// -- which parses today, because fn_type is a type_expr alternative -- it returned
// dag_binding_type_int for a function declared to return Bool. A wrong answer with no diagnostic
// is DESIGN section 5's forbidden class, not a cost finding. The positional read cannot reach a
// parameter's type at all, so the invalid state is unwritable rather than checked for
// (DESIGN section 4b: construction over validation). Its sibling
// body_lower_type_expr_after_arrow, a second blind arrow hunt with no consumer on main, is
// deleted with it rather than left standing as a second authority for the same question.
// Discriminating red: test.claim.parse_test_fn_decl_return_clause
// `nfbcp_hazard_return_type_is_positional_holds`, which fails on the deleted reading and holds
// on this one; `nfbcp_hazard_specimen_parses_holds` beside it separates "no hazard" from
// "specimen does not parse", so the red cannot go green by the specimen ceasing to compile.
fn body_lower_fn_decl_spine_right(node: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: node)) {
    Present { value: pair } => optional_present(value: pair.right)
    Absent => optional_absent()
  }
}

fn body_lower_fn_decl_return_clause_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: captured) {
    Absent => optional_absent()
    Present { value: after_kw_fn } =>
      match body_lower_fn_decl_spine_right(node: after_kw_fn) {
        Absent => optional_absent()
        Present { value: after_name } =>
          match body_lower_fn_decl_spine_right(node: after_name) {
            Absent => optional_absent()
            Present { value: after_generics } =>
              match body_lower_fn_decl_spine_right(node: after_generics) {
                Absent => optional_absent()
                Present { value: after_params } =>
                  match sugar_sequence_pair_optional(
                    node: body_lower_deep_unwrap_optional(node: after_params)
                  ) {
                    Absent => optional_absent()
                    Present { value: pair } =>
                      optional_present(
                        value: body_lower_unwrap_optional_element(node: pair.left)
                      )
                  }
              }
          }
      }
  }
}

// THE `<T>` LIST IS A POSITIONAL FACT OF THE SAME SPINE: it is the LEFT of the THIRD
// right-projection (seq(kw_fn, seq(name, seq(opt(generic_params), ...)))), and an elided list
// is grammar_empty_node, which carries no generic_params production. The production is looked
// for ONLY inside that slot, so a generic list anywhere else in the declaration -- a parameter's
// type, the body -- can never be read as this fn's binders.
fn body_lower_decl_generic_params_slot_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: captured) {
    Absent => optional_absent()
    Present { value: after_kw_fn } =>
      match body_lower_fn_decl_spine_right(node: after_kw_fn) {
        Absent => optional_absent()
        Present { value: after_name } =>
          match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: after_name)) {
            Absent => optional_absent()
            Present { value: pair } => optional_present(value: pair.left)
          }
      }
  }
}

// ONE TYPE PARAMETER AS AUTHORED: the item it was read from, the binder atom (lowered from its token,
// so it keeps its minted occurrence) and the name. The type-parameter Edge is its projection
// (body_lower_generic_param_edge_of), and so is the binder list v2.compiler.occurrence_role reads
// (body_lower_generic_params_binder_atoms).
//
// `kind` is the lowered kind of a kinded parameter (`bits: WidthResolution`, v2.extdeps.languages.dag
// dag_grammar_generic_param_expr), Absent for a bare one. A kind that is written and does not lower
// makes the whole binder unreadable, so the list refuses (TypeParamsUnreadable) rather than dropping it.
type BodyLowerGenericBinder {
  item: Node,
  binder: Node,
  name: Symbol,
  kind: Optional<Node>,
}

// generic_param is seq(name, optional(seq(`:`, kind))); an absent kind captures as the empty Conj.
fn body_lower_generic_param_binder_optional(item: Node) -> Optional<BodyLowerGenericBinder> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: item)) {
    Absent => optional_absent()
    Present { value: name_then_kind } =>
      let suffix = body_lower_deep_unwrap_optional(node: name_then_kind.right)
      if is_empty_conj_root(n: suffix) {
        body_lower_generic_param_named_optional(item: item, name_node: name_then_kind.left, kind: optional_absent())
      } else {
        match sugar_sequence_pair_optional(node: suffix) {
          Absent => optional_absent()
          Present { value: colon_then_kind } =>
            match body_lower_type_expr_lowered_optional(node: colon_then_kind.right) {
              Absent => optional_absent()
              Present { value: kind } => body_lower_generic_param_named_optional(item: item, name_node: name_then_kind.left, kind: optional_present(value: kind))
            }
        }
      }
  }
}

fn body_lower_generic_param_named_optional(item: Node, name_node: Node, kind: Optional<Node>) -> Optional<BodyLowerGenericBinder> {
  match body_lower_param_binding_atom_optional(node: body_lower_deep_unwrap_optional(node: name_node)) {
    Absent => optional_absent()
    Present { value: binder } =>
      match node_atom_identity_optional(node: binder) {
        Absent => optional_absent()
        Present { value: name } => optional_present(value: BodyLowerGenericBinder { item: item, binder: binder, name: name, kind: kind })
      }
  }
}

// The binder Atom, carrying the kind as its one BinderTypeEdge when the parameter declares one
// (v2.std.node type_binder_conforms).
fn body_lower_generic_param_edge_of(b: BodyLowerGenericBinder) -> Edge {
  let atom = body_lower_param_ref_atom(source: b.item, identity: b.name)
  match b.kind {
    Absent => Edge { label: Authored { name: b.name }, target: atom }
    Present { value: k } =>
      Edge {
        label: Authored { name: b.name },
        target: node_with_occurrence_id(kind: atom.kind, children: [core_edge(marker: BinderTypeEdge, target: k)], occurrence_id: atom.occurrence_id)
      }
  }
}

// The repeat tail of comma_list(item): each element is seq(opt(comma), item).
fn body_lower_no_type_param_edges() -> List<Edge> {
  Empty
}

fn body_lower_generic_param_binders_from_repeat_tail(repeat_capture: Node) -> Optional<List<BodyLowerGenericBinder>> {
  if is_empty_conj_root(n: repeat_capture) {
    optional_present(value: Empty)
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Rejected { diagnostics: _ } => optional_absent()
      Accepted { value: element, diagnostics: _ } =>
        match sugar_sequence_pair_optional(node: element) {
          Absent => optional_absent()
          Present { value: comma_then_item } =>
            match body_lower_generic_param_binder_optional(item: comma_then_item.right) {
              Absent => optional_absent()
              Present { value: binder } =>
                match find_named_child(root: repeat_capture, name: ^grammar_sequence_right_node_projection) {
                  Rejected { diagnostics: _ } => optional_present(value: [binder])
                  Accepted { value: tail, diagnostics: _ } =>
                    match body_lower_generic_param_binders_from_repeat_tail(repeat_capture: tail) {
                      Absent => optional_absent()
                      Present { value: rest } => optional_present(value: list_append(left: [binder], right: rest))
                    }
                }
            }
        }
    }
  }
}

// comma_list(item) = seq(item, seq(repeat(seq(opt(comma), item)), opt(comma))).
fn body_lower_generic_param_edges(comma_list: Node) -> Optional<List<Edge>> {
  match body_lower_generic_param_binders(comma_list: comma_list) {
    Absent => optional_absent()
    Present { value: binders } => optional_present(value: list_map(xs: binders, f: fn(b) { body_lower_generic_param_edge_of(b: b) }))
  }
}

fn body_lower_generic_param_binders(comma_list: Node) -> Optional<List<BodyLowerGenericBinder>> {
  match sugar_sequence_pair_optional(node: comma_list) {
    Absent => optional_absent()
    Present { value: head_rest } =>
      match body_lower_generic_param_binder_optional(item: head_rest.left) {
        Absent => optional_absent()
        Present { value: first } =>
          match sugar_sequence_pair_optional(node: head_rest.right) {
            Absent => optional_absent()
            Present { value: repeat_then_comma } =>
              match body_lower_generic_param_binders_from_repeat_tail(repeat_capture: repeat_then_comma.left) {
                Absent => optional_absent()
                Present { value: rest } => optional_present(value: list_append(left: [first], right: rest))
              }
          }
      }
  }
}

// WHAT THE ARROW CARRIES FOR `<T, U>`. NoTypeParams when the slot is elided; TypeParams with the
// Conj v2.std.node type_binder_conj_conforms admits when every name is recovered; and
// TypeParamsUnreadable when the slot holds a generic list whose names cannot all be read. The
// third arm is why this is not an Optional: a list that is present and unreadable must REFUSE
// the declaration, never lower as if it declared nothing -- that silent drop is the class this
// carrier exists to close.
type DeclTypeParams
  = NoTypeParams
  | TypeParams { conj: Node }
  | TypeParamsUnreadable

// generic_params' captured child is seq(`<`, seq(comma_list, `>`)).
fn body_lower_generic_params_comma_list_optional(generic_params: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: generic_params) {
    Absent => optional_absent()
    Present { value: lt_rest } =>
      match sugar_sequence_pair_optional(node: lt_rest.right) {
        Absent => optional_absent()
        Present { value: list_gt } => optional_present(value: list_gt.left)
      }
  }
}

// The binder atoms of one generic_params production, read by the reader body_lower_decl_type_params
// lowers them through. Absent where that reader refuses the list.
fn body_lower_generic_params_binder_atoms(generic_params: Node) -> Optional<List<Node>> {
  match body_lower_generic_params_comma_list_optional(generic_params: generic_params) {
    Absent => optional_absent()
    Present { value: comma_list } =>
      match body_lower_generic_param_binders(comma_list: comma_list) {
        Absent => optional_absent()
        Present { value: binders } => optional_present(value: list_map(xs: binders, f: fn(b) { b.binder }))
      }
  }
}

fn body_lower_decl_type_params(captured: Node) -> DeclTypeParams {
  match body_lower_decl_generic_params_slot_optional(captured: captured) {
    Absent => TypeParamsUnreadable
    Present { value: slot } =>
      match body_lower_find_captured(root: slot, emitted: ^dag_surface_generic_params) {
        ParseSubtreeAbsent => NoTypeParams
        ParseSubtreeFound { captured: generic_params } =>
          match body_lower_generic_params_comma_list_optional(generic_params: generic_params) {
            Absent => TypeParamsUnreadable
            Present { value: comma_list } =>
              match body_lower_generic_param_edges(comma_list: comma_list) {
                Absent => TypeParamsUnreadable
                Present { value: edges } =>
                  TypeParams {
                    conj: close_lowered_image(root: node_lowered_from(
                      kind: TypeNode { connective: Conj },
                      children: type_binder_set_children(binders: edges, source: generic_params),
                      source: generic_params
                    ))
                  }
              }
          }
      }
  }
}

fn body_lower_type_params_unreadable_diagnostic(shell: Node) -> Diagnostic {
  Diagnostic {
    reason: ^body_lowering_reason_type_params_unreadable,
    at: node_locus(node: shell),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn body_lower_return_type_from_fn_captured(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_return_clause_optional(captured: captured) {
    Absent => optional_absent()
    Present { value: clause } => body_lower_arrow_seq_return_type(node: clause)
  }
}

fn body_lower_find_core_substrate_optional(root: Node) -> Optional<Node> {
  if body_lower_is_core_substrate(node: root) {
    optional_present(value: root)
  } else {
    fold(root.children, init: Absent, f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent => body_lower_find_core_substrate_optional(root: e.target)
      }
    })
  }
}

// THE FOLD'S ANSWER IS CARRIED, NOT RE-DEMANDED. The reducers leave a lowered node behind
// pass-through shells (body_lower_lowered_behind_shells_read), so testing only the ROOT for core
// substrate discarded a fold that had already lowered the node; every later strategy in
// body_lower_try_body_lowered then re-read the RAW node, and the call-argument reader
// (body_lower_value_lowered) folded each argument a second time -- body_lower_fold demanded exactly
// twice per input, once under body_lower_fold_children here and once from the value reader
// (DESIGN section 2: the least common ancestor computes once and carries the value). The peel is
// the value reader's own, so both readers answer one fold the same way.
fn body_lower_try_fold_behavior_optional(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_fold(node: node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: folded, diagnostics: fd } =>
      body_lower_operand_read_outcome(read: body_lower_lowered_behind_shells_read(node: folded), diagnostics: fd)
  }
}

// A brace-headed sequence is a block delimiter. This matcher must not
// claim it as a call or infix: those arms would mint Transform with `{`
// as operator and drop the interior. Absent here means not this strategy;
// every call site then walks the interior. `{` is also unwritable as an
// infix operator in body_lower_operator_atom_optional.
fn body_lower_try_body_lowered(node: Node) -> Outcome<Optional<Node>> {
  if body_lower_is_core_substrate(node: node) {
    outcome_accepted(value: optional_present(value: node))
  } else if body_lower_is_unrecognised_lowered_shape(node: node) {
    Rejected { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: node) }
  } else if body_lower_sequence_left_is_lbrace(captured: node) {
    outcome_accepted(value: optional_absent())
  } else {
    match body_lower_dotted_chain_lowered_optional(node: node) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: Present { value: spine }, diagnostics: _ } =>
        outcome_accepted(value: optional_present(value: spine))
      Accepted { value: Absent, diagnostics: _ } =>
    match body_lower_try_fold_behavior_optional(node: node) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: fold_found, diagnostics: fd } =>
        match fold_found {
          Present { value: lowered } =>
            outcome_with_diagnostics(value: optional_present(value: lowered), diagnostics: fd)
          Absent =>
                            match body_lower_try_loop_expr_from_node(node: node) {
                              Rejected { diagnostics: r } => Rejected { diagnostics: r }
                              Accepted { value: loop_found, diagnostics: lcd } =>
                                match loop_found {
                                  Present { value: lowered } =>
                                    outcome_with_diagnostics(
                                      value: optional_present(value: lowered),
                                      diagnostics: lcd
                                    )
                                  Absent =>
                        match body_lower_try_fold_loop(node: node) {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: fold_result, diagnostics: fd } =>
                            match fold_result {
                              Present { value: lowered } =>
                                outcome_with_diagnostics(
                                  value: optional_present(value: lowered),
                                  diagnostics: fd
                                )
                              Absent =>
                        match body_lower_try_primary_ident_call(node: node) {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: primary_call, diagnostics: pcd } =>
                            match primary_call {
                              Present { value: lowered } =>
                                outcome_with_diagnostics(
                                  value: optional_present(value: lowered),
                                  diagnostics: pcd
                                )
                              Absent =>
                                match body_lower_try_infix_transform(node: node) {
                                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                          Accepted { value: Present { value: lowered }, diagnostics: _ } =>
                                            outcome_accepted(value: optional_present(value: lowered))
                                          Accepted { value: Absent, diagnostics: _ } =>
                                            outcome_accepted(value: optional_absent())
                                        }
                            }
                        }
                            }
                          }
                        }
                    }
        }
    }
    }
  }
}

fn body_lower_reduce_passthrough(folded: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: folded) {
    Present { value: child } => outcome_accepted(value: child)
    Absent => outcome_accepted(value: folded)
  }
}

fn body_lower_reduce_or_keep(o: Outcome<Node>, folded: Node) -> Outcome<Node> {
  match o {
    Accepted { value: v, diagnostics: d } => Accepted { value: v, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: rejected_with_pending(pending: None, rejected: r) }
  }
}

fn body_lower_reduce_emitted(folded: Node, emitted: Symbol) -> Outcome<Node> {
  if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
    outcome_accepted(value: folded)
  } else if emitted == ^dag_surface_binary_expr {
    match body_lower_try_infix_transform(node: folded) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: Present { value: transform }, diagnostics: _ } => outcome_accepted(value: transform)
      Accepted { value: Absent, diagnostics: _ } => body_lower_reduce_passthrough(folded: folded)
    }
  } else if emitted == ^dag_surface_postfix_expr {
    body_lower_reduce_or_keep(o: body_lower_postfix_expr(shell: folded), folded: folded)
  } else if emitted == ^dag_surface_primary_expr {
    body_lower_reduce_or_keep(o: body_lower_primary_expr(shell: folded), folded: folded)
  } else if body_lower_is_pass_through_emitted(emitted: emitted) {
    body_lower_reduce_passthrough(folded: folded)
  } else if emitted == ^dag_surface_fn_decl {
    body_lower_reduce_or_keep(o: body_lowering_refuse_retained(o: body_lower_fn_decl_to_arrow(shell: folded)), folded: folded)
  } else if emitted == ^dag_surface_test_fn_decl {
    body_lower_reduce_or_keep(o: body_lowering_refuse_retained(o: body_lower_test_fn_decl_to_member(shell: folded)), folded: folded)
  } else if emitted == ^dag_surface_data_decl {
    body_lower_reduce_or_keep(o: body_lowering_refuse_retained(o: body_lower_data_decl_to_member(shell: folded)), folded: folded)
  } else {
    outcome_accepted(value: folded)
  }
}

fn body_lower_reduce(folded: Node) -> Outcome<Node> {
  if body_lower_is_core_substrate(node: folded) {
    outcome_accepted(value: folded)
  } else if dag_resolve_preserve_module_metadata_subtree(node: folded) {
    outcome_accepted(value: folded)
  } else if body_lower_is_unrecognised_lowered_shape(node: folded) {
    Rejected { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: folded) }
  } else {
    match parse_production_emitted_identity_optional(node: folded) {
      Absent => outcome_accepted(value: folded)
      Present { value: emitted } => body_lower_reduce_emitted(folded: folded, emitted: emitted)
    }
  }
}

fn body_lower_fold_children(node: Node) -> Outcome<Node> {
  fold(node.children, init: outcome_accepted(value: node_rebuild(n: node, children: [])), f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: shell, diagnostics: ad } =>
        match body_lower_fold(node: e.target) {
          Rejected { diagnostics: cr } =>
            Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
          Accepted { value: child, diagnostics: cd } =>
            Accepted {
              value: node_rebuild(
                n: shell,
                children: list_snoc_item(xs: shell.children, item: Edge { label: e.label, target: child })
              ),
              diagnostics: diagnostics_merge(outer: ad, inner: cd)
            }
        }
    }
  })
}

fn body_lower_fold_identity_absent(node: Node) -> Outcome<Node> {
  if body_lower_match_capture_heads_spine(
    spine: body_lower_unwrap_surface_shell(node: node)
  ) {
    match body_lower_try_match_from_captured(captured: node) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: lowered_opt, diagnostics: d } =>
        match lowered_opt {
          Present { value: lowered } => Accepted { value: lowered, diagnostics: d }
          Absent => body_lower_fold_reduce(node: node)
        }
    }
  } else {
    body_lower_fold_reduce(node: node)
  }
}

// THE BOTTOM-UP FOLD LOWERS A FUNCTION VALUE WHERE IT MEETS IT, AND A FOLD-FAMILY CALL BEFORE ITS
// CHILDREN. A function value (`p => body`, `fn(..) { .. }`) reaches this dispatch UNFOLDED -- the
// fold descends top-down and a child is dispatched before anything folds it -- so its producer,
// body_lower_function_value, reads its own raw parse once and lowers its body once, through its own
// captured slots (gunbc.recurring_failure_mode producer_reenters_a_general_subtree_walker). Because
// the fold now lowers function values, a fold-family call is tried on its RAW node first, while its
// step argument is still the literal fold_lowering reads; a call that is not a fold, or whose step
// is not an inline literal, folds as any other expression.
fn body_lower_fold(node: Node) -> Outcome<Node> {
  if body_lower_is_core_substrate(node: node) {
    outcome_accepted(value: node)
  } else if body_lower_is_unrecognised_lowered_shape(node: node) {
    Rejected { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: node) }
  } else if body_lower_is_pipe_tower_root(node: node) && body_lower_tower_pipes_into_fold(node: node) {
    match body_lower_read_operator_expression(node: node) {
      OperatorExpressionRead { lowered: lowered } => outcome_accepted(value: lowered)
      OperatorExpressionRefused { diagnostics: r } => Rejected { diagnostics: r }
      OperatorExpressionAbsent => body_lower_fold_by_identity(node: node)
    }
  } else {
    body_lower_fold_by_identity(node: node)
  }
}

fn body_lower_fold_by_identity(node: Node) -> Outcome<Node> {
    match parse_production_emitted_identity_optional(node: node) {
      Present { value: emitted } =>
        if (emitted == ^dag_surface_arrow_lambda) || (emitted == ^dag_surface_fn_literal) {
          body_lower_function_value_in_fold(node: node)
        } else {
          match body_lower_fold_family_call_first(node: node) {
            Present { value: lowered } => lowered
            Absent => body_lower_fold_dispatch(node: node, emitted: emitted)
          }
        }
      Absent => body_lower_fold_identity_absent(node: node)
    }
}

fn body_lower_function_value_in_fold(node: Node) -> Outcome<Node> {
  let unread: Outcome<Node> = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_function_value_shape_unread, n: node)
  )
  match body_lower_function_value_captured_optional(node: node) {
    Absent => unread
    Present { value: capture } =>
      match body_lower_function_value(shell: node, capture: capture) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: Present { value: arrow }, diagnostics: d } => outcome_with_diagnostics(value: arrow, diagnostics: d)
        Accepted { value: Absent, diagnostics: _ } => unread
      }
  }
}

// A FOLD-FAMILY CALL LOWERS TO THE FOLD ENCODING, BUILT ONCE FROM ITS LOWERED OPERANDS.
// v2.compiler.fold_lowering fold_call_lowering locates the operands on the call's raw node: head,
// collection, init and the step as a function value. Each one is lowered here in its own slot -- the
// collection and init by the value-position reader body_lower_value_read, which peels the shells a
// bare body_lower_fold leaves behind, and the step by the function-value producer -- and
// fold_recurrence_encoding assembles Bind { carrier := init, Loop { step, domain: collection, carrier,
// bound, realized: head } } from the results. Nothing is lowered and then thrown away, and nothing is
// re-supplied from side context. So a refusal owned by any operand (`fold(map(s, <unlowerable>), ..)`,
// v2.test.claim.namespace_xl0.value_read_refusal) propagates from the operand that owns it, and every
// authored reference the call carried stands in the encoding at its own occurrence. The head stays
// the authored atom; resolve checks it (v2.compiler.resolve resolve_realized_declaration).
fn body_lower_fold_encoding(operands: FoldCallOperands) -> Outcome<Node> {
  body_lower_fold_encoding_from(operands: operands, collection: body_lower_value_read(value: operands.collection))
}

// The same assembly with the collection already lowered: a piped fold's receiver is the pipe's left
// operand, which the operator tower has lowered before it reaches the call.
fn body_lower_fold_encoding_from(operands: FoldCallOperands, collection: Outcome<Node>) -> Outcome<Node> {
  bind_outcome(o: collection, f: fn(collection) {
    bind_outcome(o: body_lower_value_read(value: operands.init), f: fn(init) {
      bind_outcome(o: body_lower_function_value_in_fold(node: operands.step), f: fn(step) {
        outcome_accepted(value: fold_recurrence_encoding(operands: FoldCallOperands {
          head: operands.head,
          collection: collection,
          init: init,
          step: step,
          carrier: operands.carrier
        }))
      })
    })
  })
}

// A COLLECTION CALLBACK OPERATION LOWERS TO THE SAME FOLD ENCODING, its step synthesized around the
// callback (v2.compiler.fold_lowering CallbackRealization names each operation's step and init). The
// callback is read by the one function-value reader, its body lowered by the one body reader, and its
// AUTHORED binder becomes the synthesized step's member formal (actual 1), so v2.compiler.infer types it
// from the domain element by role and nothing applies a lambda value. The accumulator formal (actual 0) is
// minted by v2.std.anonymous_binder fresh_fold_accumulator. The Arrow is built by the one function-value
// Arrow producer, so the step is an ordinary callable with fresh type variables like any other.
//
// The constructors the step and init name (Cons, Empty) are referenced by their declaring path,
// std.algebra, never by a bare spelling the calling module might bind differently or not at all.
//
// OCCURRENCES. The init stands for no authored text, so it is synthetic. The step's nodes are members of
// the callback's IMAGE (v2.std.node node_lowered_from): the step Arrow closes that image, so each member
// becomes pending and normalize allocates it its own projected occurrence, which is the key a lexical
// reference to the accumulator or the member is recorded by (v2.compiler.resolve
// resolve_lexical_reference). The callback's own body keeps its authored occurrences.
//
// AN AUTHORED CALLBACK RETURN TYPE IS NOT READ HERE and refuses as shape_unread: the synthesized step's
// return is the carrier, not the callback's, so carrying the annotation would put it on the wrong
// position, and dropping it would discard an authored fact.
fn body_lower_callback_encoding(operands: CallbackCallOperands) -> Outcome<Node> {
  body_lower_callback_encoding_from(operands: operands, collection: body_lower_value_read(value: operands.collection))
}

fn body_lower_algebra_constructor_reference(name: Symbol, source: Node) -> Node {
  body_lower_qualified_name_spine_node(
    segments: [
      node_lowered_from(kind: TypeNode { connective: Atom { identity: ^std } }, children: [], source: source),
      node_lowered_from(kind: TypeNode { connective: Atom { identity: ^algebra } }, children: [], source: source),
      node_lowered_from(kind: TypeNode { connective: Atom { identity: name } }, children: [], source: source)
    ],
    source: source
  )
}

fn body_lower_callback_cons(head: Node, tail: Node, source: Node) -> Node {
  close_lowered_image(root: construct_node(
    reference: body_lower_algebra_constructor_reference(name: ^Cons, source: source),
    field_edges: [Edge { label: Authored { name: ^head }, target: head }, Edge { label: Authored { name: ^tail }, target: tail }],
    source: source
  ))
}

fn body_lower_callback_operator(token: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: token } }, children: [])
}

fn body_lower_callback_init(realization: CallbackRealization, source: Node) -> Node {
  match realization {
    CallbackMapsToCons => body_lower_algebra_constructor_reference(name: ^Empty, source: source)
    CallbackAllByAnd => body_lower_param_ref_atom(source: source, identity: ^dag_token_kw_true)
  }
}

fn body_lower_callback_step_body(realization: CallbackRealization, accumulator: Symbol, body: Node, source: Node) -> Node {
  let acc_ref = body_lower_param_ref_atom(source: source, identity: accumulator)
  match realization {
    CallbackMapsToCons => body_lower_callback_cons(head: body, tail: acc_ref, source: source)
    CallbackAllByAnd => lower_binary_infix(left: acc_ref, operator: body_lower_callback_operator(token: ^dag_token_and_and), right: body)
  }
}

fn body_lower_callback_encoding_from(operands: CallbackCallOperands, collection: Outcome<Node>) -> Outcome<Node> {
  let callback_node = operands.callback
  let synthetic = node_synthetic(kind: TypeNode { connective: Conj }, children: [])
  let unread: Outcome<Node> = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_function_value_shape_unread, n: callback_node)
  )
  bind_outcome(o: collection, f: fn(collection) {
    match body_lower_function_value_captured_optional(node: callback_node) {
      Absent => unread
      Present { value: capture } =>
        match function_value_parts_optional(captured: capture.captured, kind: capture.kind) {
          Absent => unread
          Present { value: parts } =>
            match parts.binders {
              Cons { head: member, tail: Empty } =>
                match body_lower_function_value_codomain_optional(ret: parts.return_clause) {
                  Present { value: CodomainElided } =>
                    match body_lower_function_value_body(body: parts.body) {
                      Rejected { diagnostics: r } => Rejected { diagnostics: r }
                      Accepted { value: Absent, diagnostics: _ } =>
                        outcome_rejected(
                          d: body_lower_diagnostic(
                            reason: ^body_lowering_reason_function_value_body_unread,
                            n: body_lower_function_value_body_node(body: parts.body)
                          )
                        )
                      Accepted { value: Present { value: body }, diagnostics: d } =>
                        let accumulator = fresh_fold_accumulator(callback_digest: content_hash(n: callback_node).digest as String)
                        let accumulator_binder = FunctionValueBinder {
                          name: accumulator,
                          at: node_synthetic(kind: TypeNode { connective: Atom { identity: accumulator } }, children: [])
                        }
                        match body_lower_function_value_arrow(
                          shell: callback_node,
                          binders: [accumulator_binder, member],
                          codomain: CodomainElided,
                          body: body_lower_callback_step_body(realization: operands.realization, accumulator: accumulator, body: body, source: callback_node)
                        ) {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: step, diagnostics: ad } =>
                            outcome_with_diagnostics(
                              value: fold_recurrence_encoding(operands: FoldCallOperands {
                                head: operands.head,
                                collection: collection,
                                init: body_lower_callback_init(realization: operands.realization, source: synthetic),
                                step: step,
                                carrier: accumulator
                              }),
                              diagnostics: diagnostics_merge(outer: d, inner: ad)
                            )
                        }
                    }
                  Present { value: CodomainAuthored { type_node: _ } } => unread
                  Absent => unread
                }
              _ => unread
            }
        }
    }
  })
}

// A fold-family call, read off the node's own captured sequence (fold_lowering fold_call_head_symbol
// reads its head atom directly -- no search), lowered to the fold encoding while its step is raw.
fn body_lower_fold_family_call_first(node: Node) -> Optional<Outcome<Node>> {
  match parse_production_captured_child_optional(node: node) {
    Absent => optional_absent()
    Present { value: captured } =>
      match fold_call_head_symbol(fold_call: captured) {
        Absent => optional_absent()
        Present { value: head } =>
          match fold_family_realization(head: head) {
            Present { value: _ } =>
            match fold_call_lowering(fold_call: captured) {
              FoldCallLowered { operands: operands } => optional_present(value: body_lower_fold_encoding(operands: operands))
              FoldCallCallbackLowered { operands: operands } => optional_present(value: body_lower_callback_encoding(operands: operands))
              FoldCallStepShapeInvalid { diagnostic: d } => optional_present(value: outcome_rejected(d: d))
              FoldCallOperandAbsent { diagnostic: d } => optional_present(value: outcome_rejected(d: d))
              FoldCallStepFormUnresolved { diagnostic: _ } => optional_absent()
              FoldCallNotAFold { diagnostic: _ } => optional_absent()
            }
            Absent =>
            optional_absent()
          }
      }
  }
}

fn body_lower_fold_dispatch(node: Node, emitted: Symbol) -> Outcome<Node> {
        if emitted == ^dag_surface_match_expr {
          body_lower_match_expr(shell: node)
        } else if emitted == ^dag_surface_if_expr {
          body_lower_if_expr(shell: node)
        } else if emitted == ^dag_surface_loop_expr {
          body_lower_loop_expr(shell: node)
        } else if emitted == ^dag_surface_let_expr {
          body_lower_let_expr(shell: node)
        } else if emitted == ^dag_surface_stmt_seq {
          body_lower_stmt_seq(shell: node)
        } else if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
          outcome_accepted(value: node)
        } else if body_lower_is_deferred_lower_emitted(emitted: emitted) {
          outcome_accepted(value: node)
        } else {
          body_lower_fold_reduce(node: node)
        }
}

fn body_lower_fold_reduce(node: Node) -> Outcome<Node> {
  match body_lower_fold_children(node: node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: folded, diagnostics: d } =>
      match body_lower_reduce(folded: folded) {
        Rejected { diagnostics: r } =>
          Rejected { diagnostics: rejected_with_pending(pending: d, rejected: r) }
        Accepted { value: reduced, diagnostics: rd } =>
          Accepted { value: reduced, diagnostics: diagnostics_merge(outer: d, inner: rd) }
      }
  }
}

fn body_lower_body_subtree_lower_from_primary(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_primary_expr) {
    ParseSubtreeFound { captured: primary } =>
      match body_lower_primary_expr(shell: primary) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered, diagnostics: d } =>
          outcome_with_diagnostics(
            value: optional_present(value: lowered),
            diagnostics: d
          )
      }
    ParseSubtreeAbsent =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_stmt) {
        ParseSubtreeFound { captured: stmt } =>
          body_lower_body_subtree_lower(captured: stmt)
        ParseSubtreeAbsent =>
          match body_lower_find_core_substrate_passes_unrecognised(root: captured) {
            Present { value: passed } =>
              Rejected { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: passed) }
            Absent =>
            match body_lower_find_core_substrate_optional(root: captured) {
              Present { value: lowered } =>
                outcome_accepted(value: optional_present(value: lowered))
              Absent =>
                body_lower_try_body_lowered(
                  node: body_lower_unwrap_surface_shell(node: captured)
                )
            }
          }
      }
  }
}

fn body_lower_body_subtree_lower_from_postfix(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_postfix_expr) {
    ParseSubtreeFound { captured: postfix } =>
      match body_lower_try_body_lowered(node: postfix) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: found, diagnostics: d } =>
          match found {
            Present { value: lowered } =>
              outcome_with_diagnostics(
                value: optional_present(value: lowered),
                diagnostics: d
              )
            Absent => body_lower_body_subtree_lower_from_primary(captured: captured)
          }
      }
    ParseSubtreeAbsent => body_lower_body_subtree_lower_from_primary(captured: captured)
  }
}

fn body_lower_body_subtree_lower_from_expr(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_expr) {
    ParseSubtreeFound { captured: expr } =>
      match body_lower_try_body_lowered(node: expr) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: found, diagnostics: d } =>
          match found {
            Present { value: lowered } =>
              outcome_with_diagnostics(
                value: optional_present(value: lowered),
                diagnostics: d
              )
            Absent => body_lower_body_subtree_lower_from_postfix(captured: captured)
          }
      }
    ParseSubtreeAbsent => body_lower_body_subtree_lower_from_postfix(captured: captured)
  }
}

fn body_lower_body_subtree_lower_from_binary(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_binary_expr) {
    ParseSubtreeFound { captured: binary } =>
      match body_lower_try_body_lowered(node: binary) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: found, diagnostics: d } =>
          match found {
            Present { value: lowered } =>
              outcome_with_diagnostics(
                value: optional_present(value: lowered),
                diagnostics: d
              )
            Absent => body_lower_body_subtree_lower_from_expr(captured: captured)
          }
      }
    ParseSubtreeAbsent => body_lower_body_subtree_lower_from_expr(captured: captured)
  }
}

fn body_lower_body_subtree_lower(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_try_statement_spine(captured: captured) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: bound, diagnostics: bd } =>
      match bound {
        Present { value: lowered } =>
          outcome_with_diagnostics(
            value: optional_present(value: lowered),
            diagnostics: bd
          )
        Absent => body_lower_body_subtree_lower_rest(captured: captured)
      }
  }
}

// A CONTROL FORM IS TAKEN ONLY WHEN IT IS THE EXPRESSION. The walk descends through what does not
// change the expression -- a production to its captured child, a sequence whose right side is an
// empty tail, and a lone opening or closing delimiter around it (`( .. )`, `{ .. }`) -- and stops
// anywhere else. It used to walk the whole capture pre-order and answer the FIRST if / match / loop /
// let anywhere beneath it, so `t && match w {..}`, `f(a: match ..)`, `x + if c {..} else {..}` and
// `R { v: if .. }` each lowered to the nested block alone and the enclosing operator, call or record
// was dropped with no diagnostic (gunbc.recurring_failure_mode
// expression_enclosing_a_block_headed_operand_lowers_to_that_block). An expression that is not a
// control form goes whole to body_lower_body_subtree_lower_from_binary, and a block nested inside it
// is reached as that expression's operand, argument or field value.
type ControlFormFound {
  emitted: Symbol
  captured: Node
}

fn body_lower_is_control_form_emitted(id: Symbol) -> Bool {
  (id == ^dag_surface_if_expr)
    || (id == ^dag_surface_match_expr)
    || (id == ^dag_surface_loop_expr)
    || (id == ^dag_surface_let_expr)
}

fn body_lower_node_is_delimiter_atom(n: Node, opening: Bool) -> Bool {
  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: n)) {
    Present { value: id } =>
      if opening { (id == ^dag_token_lparen) || (id == ^dag_token_lbrace) } else { (id == ^dag_token_rparen) || (id == ^dag_token_rbrace) }
    Absent => false
  }
}

fn body_lower_find_control_form_optional(root: Node) -> Optional<ControlFormFound> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      match parse_production_captured_child_optional(node: root) {
        Absent => optional_absent()
        Present { value: captured } =>
          if body_lower_is_control_form_emitted(id: id) {
            optional_present(value: ControlFormFound { emitted: id, captured: captured })
          } else if body_lower_find_captured_prunable(id: id) {
            optional_absent()
          } else {
            body_lower_find_control_form_optional(root: captured)
          }
      }
    Absent =>
      match sugar_sequence_pair_optional(node: root) {
        Absent => optional_absent()
        Present { value: pair } =>
          if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
            body_lower_find_control_form_optional(root: pair.left)
          } else if body_lower_node_is_delimiter_atom(n: pair.right, opening: false) {
            body_lower_find_control_form_optional(root: pair.left)
          } else if body_lower_node_is_delimiter_atom(n: pair.left, opening: true) {
            body_lower_find_control_form_optional(root: pair.right)
          } else {
            optional_absent()
          }
      }
  }
}

fn body_lower_body_subtree_lower_control_forms(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_control_form_optional(root: captured) {
    Absent => body_lower_body_subtree_lower_from_binary(captured: captured)
    Present { value: found } =>
      if found.emitted == ^dag_surface_if_expr {
        body_lower_try_if_from_captured(captured: found.captured)
      } else if found.emitted == ^dag_surface_match_expr {
        body_lower_try_match_from_captured(captured: found.captured)
      } else if found.emitted == ^dag_surface_loop_expr {
        body_lower_try_loop_expr_from_captured(captured: found.captured)
      } else {
        outcome_accepted(value: optional_absent())
      }
  }
}

fn body_lower_body_subtree_lower_rest(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_try_body_lowered(node: captured) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: found, diagnostics: _ } =>
      match found {
        Present { value: lowered } =>
          outcome_accepted(value: optional_present(value: lowered))
        Absent => body_lower_body_subtree_lower_control_forms(captured: captured)
      }
  }
}

fn body_lower_node_is_eq_token(n: Node) -> Bool {
  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: n)) {
    Present { value: id } => id == ^dag_token_eq
    Absent => false
  }
}

fn body_lower_eq_body_fold_init() -> Optional<Node> {
  optional_absent()
}

fn body_lower_last_child_fold_step(_acc: Optional<Node>, e: Edge) -> Optional<Node> {
  optional_present(value: e.target)
}

fn body_lower_last_child_optional(n: Node) -> Optional<Node> {
  fold(n.children, init: body_lower_eq_body_fold_init(), f: body_lower_last_child_fold_step)
}

fn body_lower_atom_body_read(expr: Node) -> OperandRefRead {
  match body_lower_materialize_int_literal_operand_optional(node: expr) {
    Present { value: lit } => OperandRefLowered { lowered: lit }
    Absent => body_lower_operand_ref_read(node: expr)
  }
}

fn body_lower_eq_expr_to_body(expr: Node) -> Outcome<Optional<Node>> {
  match body_lower_body_subtree_lower(captured: expr) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: body_opt, diagnostics: d } =>
      match body_opt {
        Present { value: lowered } =>
          outcome_with_diagnostics(
            value: optional_present(value: lowered),
            diagnostics: d
          )
        Absent =>
          match body_lower_atom_body_read(expr: expr) {
            OperandRefLowered { lowered: atom } =>
              outcome_with_diagnostics(
                value: optional_present(value: atom),
                diagnostics: d
              )
            OperandRefAbsent =>
              match body_lower_last_child_optional(n: expr) {
                Absent => outcome_with_diagnostics(value: optional_absent(), diagnostics: d)
                Present { value: last } =>
                  match body_lower_atom_body_read(expr: last) {
                    OperandRefLowered { lowered: atom } =>
                      outcome_with_diagnostics(
                        value: optional_present(value: atom),
                        diagnostics: d
                      )
                    OperandRefAbsent => body_lower_eq_expr_to_body(expr: last)
                    OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
                  }
              }
            OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
          }
      }
  }
}

fn body_lower_body_from_fn_captured(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_fn_body) {
    ParseSubtreeFound { captured: body } => body_lower_body_subtree_lower(captured: body)
    ParseSubtreeAbsent =>
      match body_lower_body_after_eq_token(captured: captured) {
        Present { value: expr } => body_lower_eq_expr_to_body(expr: expr)
        Absent => outcome_accepted(value: optional_absent())
      }
  }
}

fn body_lower_eq_body_fold_step(acc: Optional<Node>, e: Edge) -> Optional<Node> {
  match acc {
    Present { value: n } =>
      if body_lower_node_is_eq_token(n: n) {
        optional_present(value: e.target)
      } else {
        optional_present(value: n)
      }
    Absent =>
      if body_lower_node_is_eq_token(n: e.target) {
        optional_present(value: e.target)
      } else {
        body_lower_body_after_eq_token(captured: e.target)
      }
  }
}

fn body_lower_body_after_eq_token(captured: Node) -> Optional<Node> {
  match fold(captured.children, init: body_lower_eq_body_fold_init(), f: body_lower_eq_body_fold_step) {
    Absent => optional_absent()
    Present { value: n } =>
      if body_lower_node_is_eq_token(n: n) {
        optional_absent()
      } else {
        optional_present(value: n)
      }
  }
}

// Reify runs over branch targets the fold has ALREADY lowered. A target is read as an operand
// whole, or, when the operand reader has no reading for it, as a production shell. Either reader's
// REFUSAL is the target's refusal and propagates with its own cause and locus: it used to become
// Absent, so a refused operand fell through to the shell reader and, failing that, surfaced as
// unsupported_form at the target -- the refusal-forgetting projection of
// gunbc.recurring_failure_mode lowering_accessor_collapses_a_sequence_operand, on the reify route.
// Only a target neither reader reads is unsupported_form, located at it.
fn body_lower_reify_operand_read(node: Node) -> Outcome<Node> {
  match body_lower_operand_ref_read(node: node) {
    OperandRefLowered { lowered: op } => outcome_accepted(value: op)
    OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
    OperandRefAbsent =>
      match body_lower_operand_from_shell_read(shell: node) {
        OperandRefLowered { lowered: op } => outcome_accepted(value: op)
        OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
        OperandRefAbsent =>
          outcome_rejected(
            d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: node)
          )
      }
  }
}

// The head (positional 0) and a Named edge are kept as authored: the named edge is a
// v2.std.type_binder marker (a cast's target type), never an operand to reify.
fn body_lower_reify_transform_edge(
  done: List<Edge>,
  e: Edge
) -> Outcome<List<Edge>> {
  if (length(xs: done) == 0) || !is_positional(e: e) {
    outcome_accepted(
      value: list_snoc_item(
        xs: done,
        item: Edge { label: e.label, target: e.target }
      )
    )
  } else {
    bind_outcome(o: body_lower_reify_operand_read(node: e.target), f: fn(reified) {
      outcome_accepted(
        value: list_snoc_item(
          xs: done,
          item: Edge { label: e.label, target: reified }
        )
      )
    })
  }
}

fn body_lower_reify_transform_body(body: Node) -> Outcome<Node> {
  match body.kind {
    ComputationNode { behavior: Transform } =>
      match fold(body.children, init: outcome_accepted(value: Empty), f: fn(acc, e) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: done, diagnostics: d } =>
            match body_lower_reify_transform_edge(done: done, e: e) {
              Rejected { diagnostics: r } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: d, rejected: r)
                }
              Accepted { value: next, diagnostics: ed } =>
                Accepted {
                  value: next,
                  diagnostics: diagnostics_merge(outer: d, inner: ed)
                }
            }
        }
      }) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: children, diagnostics: d } =>
          outcome_with_diagnostics(
            value: node_lowered_from(
              kind: ComputationNode { behavior: Transform },
              children: children,
              source: body
            ),
            diagnostics: d
          )
      }
    TypeNode { connective: Atom { identity: _ } } => outcome_accepted(value: body)
    TypeNode { connective: Conj } => outcome_accepted(value: body)
    TypeNode { connective: Disj } => outcome_accepted(value: body)
    TypeNode { connective: Arrow } => outcome_accepted(value: body)
    TypeNode { connective: Cardinality } => outcome_accepted(value: body)
    TypeNode { connective: Instantiation } => outcome_accepted(value: body)
    ComputationNode { behavior: Value } => outcome_accepted(value: body)
    ComputationNode { behavior: Branch } => outcome_accepted(value: body)
    ComputationNode { behavior: Loop } => outcome_accepted(value: body)
    ComputationNode { behavior: Bind } => outcome_accepted(value: body)
    ComputationNode { behavior: Match } => outcome_accepted(value: body)
  }
}

// The wrap stands at the same authored text as the arrow it wraps -- one `fn` declaration -- so it
// takes that declaration's occurrence rather than being a fresh anonymous node between the module
// body and the arrow.
// THE WRAP IS A CARRIER, NOT THE IMAGE ROOT. It names the member for the namespace graft, which
// dissolves it and re-hangs the Arrow under the module; the Arrow is what stands for the authored
// declaration in the admitted tree, so the Arrow's builder closes the image and names it root.
fn body_lower_fn_decl_named_member_wrap(arrow: Node, fn_name: Symbol, source: Node) -> Node {
  node_lowered_from(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Authored { name: fn_name }, target: arrow }
    ],
    source: source
  )
}

// A `test fn` declaration lowers to the SAME named-member arrow a plain `fn` lowers to: the
// production is the contextual `sequence(test, fn_decl)`, its marker the grammar's exact word `test`
// (see dag_grammar_test_fn_decl_expr for why `test` is not a reserved keyword), the fold has already
// lowered the nested fn_decl child by the time this shell reduces, and this arm lifts the member out
// of the sequence's right projection. Another marker word never reaches this arm: it refuses at parse
// (DeclarationMarkerNotTest), so there is no spelling to check here. The TEST-NESS marker is deliberately not reified into the
// member node: it rides its own channel beside the semantic tree (the DESIGN section 4c shape),
// v2.compiler.test_marker_capture over the same parse tree, so the semantic member stays identical
// to a plain fn's.
//
// TWO PRODUCERS OF TEST-NESS STAND TODAY, AND THIS NAMES BOTH RATHER THAN DROPPING ONE.
// (1) The capture above, the compiler's. (2) The floor's witness universe, derived by
// v2.workflow.floor_discovery_source_authority discover_floor_rows_for_source, a line scan for
// `test fn ` / `test data ` over source text that deliberately neither parses nor resolves
// (v2.workflow.floor_naming_hygiene names it a second parser). TRIGGER for converging it onto this
// channel: the floor preparing a parse artifact for each discovered source, at which point discovery
// reads the marks from that parse instead of rescanning the bytes. A third producer,
// v2.workflow.realization_attempt's line-rewriting capture, was deleted in the change that added
// this channel: its only reason was a grammar that could not parse the marker.
fn body_lower_test_fn_decl_to_member(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_seq_child(node: captured, name: ^grammar_sequence_right_node_projection) {
        Absent => body_lower_wrapper_retained_shell(shell: shell)
        Present { value: member } => body_lowering_lowered(o: outcome_accepted(value: member))
      }
  }
}

// THE WALL SITS AT THE FN, NOT ONLY AT THE STATEMENT. A fn body is lowered DEFERRED, from the raw
// parse subtree by this function's own navigation, so its statements never pass through
// body_lower_after_children one by one; body_lower_body_subtree_lower_from_primary would instead
// find the first primary expression inside an else-less `if` -- its condition -- and return THAT as
// the body, silently discarding the guard and every statement after it. So the fn reads its exits
// first, from the raw parse: an else-less `if` or a return that its tail reading does not admit
// refuses the whole declaration, located at it (body_lower_exit_outside_tail_optional); an admitted
// guard reaches the statement spine, which lowers it to a Branch.
// A fn declaration's exits: its own fn_body (the first fn_body shell in its captured sequence, the
// search body_lower_body_from_fn_captured makes) is walked as the function's tail; a declaration
// with no fn_body is walked with no tail.
fn body_lower_fn_decl_exit_refusal_optional(captured: Node) -> Optional<Outcome<Node>> {
  match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_fn_body) {
    Present { value: fn_body } => body_lower_exit_outside_tail_optional(node: fn_body, tail: true)
    Absent => body_lower_exit_outside_tail_optional(node: captured, tail: false)
  }
}

// A FN THAT DECLARES A `uses` CLAUSE REFUSES, LOCATED AT THE CLAUSE, ON EVERY ROUTE. The clause is
// the fn's resource (effect) requirement and v2 has no carrier for it yet
// (gunbc.recurring_failure_mode uses_clause_has_no_carrier), so lowering the fn would drop the
// requirement. Both arms -- the full arrow and the census arrow -- ask this first, because the
// requirement is part of the signature both of them read.
// A `pattern` IS A FN WITH v1's NARROWER FORM (dag syntax dag_item_forms: has_type_params false,
// body_kind BlockBody), sharing the one fn_decl production. The grammar cannot express the narrowing
// without changing the spine depth the positional readers walk, so it is held here, on both arms: a
// pattern-headed declaration that writes generic params, or an `= expr` body, refuses located at
// what it wrote (body_lowering_reason_pattern_form_not_admitted) and never lowers as a fn. The head
// is told apart by its token: `fn` is the keyword token, `pattern` a literal identifier.
fn body_lower_pattern_form_refusal_optional(captured: Node) -> Optional<Outcome<Node>> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: captured)) {
    Absent => optional_absent()
    Present { value: head_rest } =>
      if body_lower_token_is(node: head_rest.left, token: ^dag_token_kw_fn) {
        optional_absent()
      } else {
        match body_lower_pattern_generics_optional(captured: captured) {
          Present { value: generics } =>
            optional_present(value: outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_form_not_admitted, n: generics)))
          Absent =>
            match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_fn_body) {
              Present { value: _ } => optional_absent()
              Absent =>
                optional_present(value: outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_form_not_admitted, n: captured)))
            }
        }
      }
  }
}

// The generic_params production in the declaration's own `<T>` slot, if the source wrote one.
fn body_lower_pattern_generics_optional(captured: Node) -> Optional<Node> {
  match body_lower_decl_generic_params_slot_optional(captured: captured) {
    Absent => optional_absent()
    Present { value: slot } => body_lower_find_production_shell_optional(root: slot, emitted: ^dag_surface_generic_params)
  }
}

// The signature refusals both arms ask before reading anything: a pattern head written in a form v1
// does not admit, then a `uses` clause v2 has no carrier for.
fn body_lower_first_signature_refusal_optional(captured: Node) -> Optional<Outcome<Node>> {
  match body_lower_pattern_form_refusal_optional(captured: captured) {
    Present { value: refused } => optional_present(value: refused)
    Absent =>
      match body_lower_param_list_refusal_optional(captured: captured) {
        Present { value: refused } => optional_present(value: refused)
        Absent => body_lower_fn_uses_refusal_optional(captured: captured)
      }
  }
}

// A PARAMETER WHOSE TYPE IS REFINED BY A WHERE CLAUSE REFUSES, LOCATED AT THE CLAUSE. The only
// reader of a where clause (body_lower_kept_where_clause) serves a type variant; a parameter's type
// is read by body_lower_type_expr_lowered_optional, which would keep the base type and drop the
// refinement. So until a parameter's type can carry its refinement the fn refuses
// (gunbc.recurring_failure_mode parameter_refinement_has_no_carrier). The clause is searched only
// inside this declaration's own param_list.
// A parameter's DEFAULT is not refused here any more: it lowers onto the parameter's binder
// (body_lower_typed_param_optional, body_lower_binder_edge_read; XL-2 PR2c-ii).
fn body_lower_param_list_refusal_optional(captured: Node) -> Optional<Outcome<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_param_list) {
    ParseSubtreeAbsent => optional_absent()
    ParseSubtreeFound { captured: param_list } => body_lower_param_refinement_refusal_optional(param_list: param_list)
  }
}

fn body_lower_param_refinement_refusal_optional(param_list: Node) -> Optional<Outcome<Node>> {
  match body_lower_find_production_shell_optional(root: param_list, emitted: ^dag_surface_where_refinement_clause) {
    Absent => optional_absent()
    Present { value: clause } =>
      optional_present(value: outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_parameter_refinement_unmodeled, n: clause)))
  }
}

fn body_lower_fn_uses_refusal_optional(captured: Node) -> Optional<Outcome<Node>> {
  match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_uses_clause) {
    Absent => optional_absent()
    Present { value: clause } =>
      optional_present(value: outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_uses_clause_unmodeled, n: clause)))
  }
}

fn body_lower_fn_decl_to_arrow(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_first_signature_refusal_optional(captured: captured) {
        Present { value: refused } => body_lowering_lowered(o: refused)
        Absent =>
          match body_lower_fn_decl_exit_refusal_optional(captured: captured) {
            Present { value: refused } => body_lowering_lowered(o: refused)
            Absent => body_lower_fn_decl_to_arrow_admitted(shell: shell, captured: captured)
          }
      }
  }
}

// THE SIGNATURE OF A FN DECLARATION, READ ONCE FOR BOTH GRADES. The full arm and the census arm build
// one Arrow from one set of reads; only whether a body edge follows differs. So the reads live here
// and the Arrow is built by body_lower_fn_decl_arrow, which projects this signature onto the one
// callable-Arrow constructor (body_lower_callable_arrow) with the body edge present or absent, and
// "census grade is the same signature" holds
// by construction rather than by two copies staying in step. Absent means a signature this lowering
// cannot read, which both arms retain as the shell.
type BodyLowerFnSignature {
  domain: Node,
  order: List<Symbol>,
  return_type: Node,
  fn_name: Symbol,
  type_params: DeclTypeParams,
}

// Rejected where a parameter slot refuses; Absent for a signature this lowering cannot read, which
// the fn declaration retains as its shell.
fn body_lower_fn_signature_optional(captured: Node) -> Outcome<Optional<BodyLowerFnSignature>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_param_list) {
    ParseSubtreeAbsent => outcome_accepted(value: optional_absent())
    ParseSubtreeFound { captured: param_list } =>
      match body_lower_declared_domain_from_param_list(param_list: param_list) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: Absent, diagnostics: _ } => outcome_accepted(value: optional_absent())
        Accepted { value: Present { value: declared }, diagnostics: _ } =>
          outcome_accepted(value: body_lower_fn_signature_after_domain(captured: captured, declared: declared))
      }
  }
}

fn body_lower_fn_signature_after_domain(captured: Node, declared: BodyLowerDeclaredDomain) -> Optional<BodyLowerFnSignature> {
  match body_lower_return_type_from_fn_captured(captured: captured) {
    Absent => Absent
    Present { value: return_type } =>
      match dag_surface_kw_then_ident_from_captured(captured: captured) {
        Absent => Absent
        Present { value: fn_name } =>
          Present {
            value: BodyLowerFnSignature {
              domain: declared.domain,
              order: declared.order,
              return_type: return_type,
              fn_name: fn_name,
              type_params: body_lower_decl_type_params(captured: captured)
            }
          }
      }
  }
}

// The type-parameter edge is part of the SIGNATURE, so the census grade carries it exactly as the
// full grade does. A sig whose type parameters are TypeParamsUnreadable never reaches this builder:
// both arms refuse it first (body_lower_fn_signature_refusal).
fn body_lower_fn_decl_type_params_edges(sig: BodyLowerFnSignature) -> List<Edge> {
  match sig.type_params {
    TypeParams { conj: c } => [type_params_edge(conj: c)]
    NoTypeParams => body_lower_no_type_param_edges()
    TypeParamsUnreadable => body_lower_no_type_param_edges()
  }
}

// A SIGNATURE THIS LOWERING READ BUT CANNOT BUILD refuses here, at the signature, before either arm
// builds the Arrow. Two facts qualify: unreadable type parameters (above), and a parameter binding
// the domain cannot key. The domain is a Conj keyed by binding name (v2.std.node all_names_distinct;
// the offending edge is read from v2.std.node_query repeated_name_edges),
// so a repeated binding has no well-formed domain. Before this arm the lowering built that Conj
// anyway and normalize's recursive well_formed gate refused the module AT ITS ROOT with no locus
// (gen-two census: std.key_relation global_key_scope_eq, gunbc.provider_readiness_claim_evidence
// provider_readiness_independence_claim). The refusal now lands at the second binding's type node.
//
// A repeated `_` never reaches this arm: every anonymous slot carries its own minted binder
// (v2.std.anonymous_binder, via body_lower_param_edges), so two `_` parameters are two distinct
// keys. What remains is two parameters claiming one authored name, which no realization admits.
fn body_lower_fn_signature_refusal(shell: Node, sig: BodyLowerFnSignature) -> Optional<Outcome<Node>> {
  match sig.type_params {
    TypeParamsUnreadable =>
      optional_present(value: Rejected {
        diagnostics: diagnostics_singleton(d: body_lower_type_params_unreadable_diagnostic(shell: shell))
      })
    NoTypeParams => body_lower_fn_signature_bindings_refusal(shell: shell, sig: sig)
    TypeParams { conj: _ } => body_lower_fn_signature_bindings_refusal(shell: shell, sig: sig)
  }
}

fn body_lower_fn_signature_bindings_refusal(shell: Node, sig: BodyLowerFnSignature) -> Optional<Outcome<Node>> {
  match first(repeated_name_edges(children: sig.domain.children)) {
    Absent => optional_absent()
    Present { value: second } =>
      optional_present(value: Rejected {
        diagnostics: diagnostics_singleton(d: body_lower_repeated_param_binding_diagnostic(edge: second))
      })
  }
}

// A BINDER'S REFUSAL IS LOCATED AT ITS DECLARED TYPE, the authored node that discriminates it (XL-2
// PR2b-3: the edge's target is a synthetic binder node, which no author wrote). A member that is not a
// binder is located at its target.
fn body_lower_binder_locus(edge: Edge) -> Node {
  match member_edge_type_node(e: edge) {
    Present { value: t } => t
    Absent => edge.target
  }
}

fn body_lower_repeated_param_binding_diagnostic(edge: Edge) -> Diagnostic {
  Diagnostic {
    reason: ^body_lowering_reason_arrow_domain_param_binding_repeated,
    at: node_locus(node: body_lower_binder_locus(edge: edge)),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// A `data` DECLARATION LOWERS TO THE SAME NAMED MEMBER A NULLARY `fn` DOES: `data x: T = e` is
// Conj { x: Arrow(<empty domain>, T, T, body: e) }. Until 2026-09-23 dag_surface_data_decl sat in
// body_lower_is_metadata_preserved_emitted, so the declaration's interior reached infer as SURFACE
// SYNTAX -- namespace_graft named the member `x -> <the parse tail ': T = e'>` -- and infer was
// asked to ground `:` and `=` tokens and the type's spelling. Nothing could ground those, so every
// data declaration stayed on the grounding frontier and gen-one's translate gate refused the
// one-line door probe (fixture.native_cli_door.door_probe). A constant is the nullary function that
// returns it: that is the seed's own realization (v1.compiler.emit_rust emits a data item as a
// nullary fn and calls it at every reference), and it lets the existing Arrow, product and literal
// derivations ground the member with no data-specific infer rule. The data-versus-fn distinction a
// reference site needs is not carried by this shape; it lives in the declaration index
// (v2.std.decl_index data_decl_type_facts), which reads the parse, not this tree. A shell whose
// name, declared type or value is not reachable is retained as the counted frontier, exactly as
// the fn arm retains, never guessed.
// THE INITIALIZER IS ALREADY LOWERED WHEN THIS ARM RUNS. normalize_node_ctx folds a declaration's
// children before it dispatches the declaration, so the node after `=` is the folded initializer: a
// literal atom, a construct, a Transform. It is taken as it stands. Re-lowering it through
// body_lower_eq_expr_to_body would walk an already-lowered tree with the deep first-match searches,
// which retain on shapes they do not recognize (a record literal whose field is a fn literal).
// Only an initializer that is not yet substrate goes through that reader.
fn body_lower_data_initializer_body(expr: Node) -> Outcome<Optional<Node>> {
  if body_lower_is_core_substrate(node: expr) {
    outcome_accepted(value: optional_present(value: expr))
  } else if body_lower_is_unrecognised_lowered_shape(node: expr) {
    Rejected { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: expr) }
  } else {
    body_lower_eq_expr_to_body(expr: expr)
  }
}

fn body_lower_data_decl_to_member(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_type_expr) {
        ParseSubtreeAbsent => body_lower_wrapper_retained_shell(shell: shell)
        ParseSubtreeFound { captured: type_expr } =>
          match body_lower_type_expr_lowered_optional(node: type_expr) {
            Absent => body_lower_wrapper_retained_shell(shell: shell)
            Present { value: declared_type } =>
              match body_lower_body_after_eq_token(captured: captured) {
                Absent => body_lower_wrapper_retained_shell(shell: shell)
                Present { value: expr } =>
                  match body_lower_exit_outside_tail_optional(node: expr, tail: false) {
                    Present { value: refused } => body_lowering_lowered(o: refused)
                    Absent =>
                  match body_lower_data_initializer_body(expr: expr) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: body_opt, diagnostics: bd0 } =>
                      match body_opt {
                        Absent => body_lowering_after_pending(pending: bd0, o: body_lower_wrapper_retained_shell(shell: shell))
                        Present { value: body } =>
                          match body_lower_reify_arrow_body(body: body) {
                            Rejected { diagnostics: r } => Rejected { diagnostics: r }
                            Accepted { value: reified_body, diagnostics: bd } =>
                              match dag_surface_kw_then_ident_from_captured(captured: captured) {
                                Absent => body_lowering_after_pending(
                                  pending: diagnostics_merge(outer: bd0, inner: bd),
                                  o: body_lower_wrapper_retained_shell(shell: shell)
                                )
                                Present { value: data_name } =>
                                  let signature = declared_signature(params: [], source: shell)
                                  let arrow = body_lower_callable_arrow(
                                    source: shell,
                                    domain: signature.domain,
                                    codomain: declared_type,
                                    order_edge: signature.order,
                                    type_param_edges: body_lower_no_type_param_edges(),
                                    body: optional_present(
                                      value: body_lower_position_function_values(node: reified_body, path: body_lower_unpositioned_path())
                                    )
                                  )
                                  body_lowering_lowered(
                                    o: outcome_with_diagnostics(
                                      value: body_lower_fn_decl_named_member_wrap(
                                        arrow: arrow,
                                        fn_name: data_name,
                                        source: shell
                                      ),
                                      diagnostics: diagnostics_merge(outer: bd0, inner: bd)
                                    )
                                  )
                              }
                          }
                      }
                  }
                  }
              }
          }
      }
  }
}

// THE DECLARED ORDER, CARRIED ON THE ARROW. Every Arrow built from a declared signature carries one
// ^arrow_signature_order_edge (v2.std.arrow_signature signature_order_edge) whose target is
// the language's canonical FreeMonoid introduction (lower_list_introduction) of the parameter labels as childless
// Atoms, in declared order: arity 0 is the empty introduction, arity 1 a singleton. It is the ONE
// place positional binding reads parameter order (v2.std.node arrow_declared_parameter_order).
// Resolve does not walk it (v2.compiler.resolve resolve_arrow_node): its atoms are labels, not
//
// THE ONE CALLABLE ARROW. A lambda is surface sugar over the same Arrow a named `fn` declares, so the
// child LAYOUT of a callable Arrow -- which children exist, in which order, under which labels -- is
// decided here and nowhere else: the three callables (a named `fn` declaration, a `data` declaration
// as the nullary case, and a function value written `fn(..) { .. }` or `x => e`) differ only in what
// they can READ, never in what they build. Before this constructor the layout was authored three
// times, so a change to it -- notably removing the duplicated codomain below -- was three edits that
// had to stay in step, and nothing made them.
//
// WHAT EACH CALLER STILL DECIDES, because it is a fact about the caller and not about the Arrow: the
// domain and order edges arrive built, since a declared signature mints both from ONE
// anonymous-binder pass (v2.std.arrow_signature declared_signature) at the occurrence of the text
// that spelled the parameters, which is not always this Arrow's own shell; the type-parameter edges
// arrive as the 0-or-1 list each caller's own type-parameter fact projects to, because a declaration
// carries the Conj the parse captured while a function value mints one for its elided types; and the
// body arrives already prepared, because a declaration's lowering is the only place that holds the
// declaration's body root and can therefore position its fresh type variables
// (body_lower_position_function_values), while a function value nested inside one is positioned by
// that same walk from above rather than here. Absent body is the census grade and the signature-only
// arm, not a callable without one.
//
// THE CODOMAIN IS EMITTED TWICE, AS POSITIONAL CHILDREN 1 AND 2. No reader reads an Arrow's
// positional index 2; it is retained because changing the layout reaches every Arrow reader in the
// corpus, and that cut is owned by gunbc#12625 (Program P: one Arrow encoding). Its value here is
// that after this consolidation the duplication has ONE producer, so that cut is one edit.
fn body_lower_callable_arrow(
  source: Node,
  domain: Edge,
  codomain: Node,
  order_edge: Edge,
  type_param_edges: List<Edge>,
  body: Optional<Node>
) -> Node {
  let no_edges: List<Edge> = []
  let body_edges: List<Edge> = match body {
    Absent => no_edges
    Present { value: b } => [Edge { label: core_edge_label(marker: ArrowBodyEdge), target: b }]
  }
  close_lowered_image(root: node_lowered_from(
    source: source,
    kind: TypeNode { connective: Arrow },
    children: list_append(
      left: list_append(
        left: [
          domain,
          Edge { label: Positional, target: codomain },
          Edge { label: Positional, target: codomain },
          order_edge
        ],
        right: type_param_edges
      ),
      right: body_edges
    )
  ))
}
fn body_lower_fn_decl_arrow(shell: Node, sig: BodyLowerFnSignature, body: Optional<Node>) -> Node {

  body_lower_fn_decl_named_member_wrap(
    arrow: body_lower_callable_arrow(
      source: shell,
      domain: Edge { label: Positional, target: sig.domain },
      codomain: sig.return_type,
      order_edge: signature_order_edge(order: sig.order, source: shell),
      type_param_edges: list_append(left: body_lower_fn_decl_type_params_edges(sig: sig), right: body_lower_fn_admit_clause_edges(shell: shell)),
      body: match body {
        Absent => optional_absent()
        Present { value: b } =>
          optional_present(value: body_lower_position_function_values(node: b, path: body_lower_unpositioned_path()))
      }
    ),
    fn_name: sig.fn_name,
    source: shell
  )
}

// THE ADMIT_CALLERS CARRIER, ONE BUILD PER CLAUSE. The generic dispatch (body_lower_after_children)
// reaches the clause shell BOTTOM-UP, so the clause's OWN production case is where the authored
// encoding is consumed: body_lower_admit_clause_image reads the roster off the raw spine (the reader
// needs the parse encoding) and the image REPLACES the shell, so the raw token subtree never enters
// the tree. The fn declaration's Arrow then finds the image by the shell's own identity (kept in
// body_lower_admit_clause_image) and hangs it under the core marker AdmitCallersEdge — one build,
// one fact, one place (DESIGN section 3).
//
// WHY THE ROSTER IS RE-HUNG AT ALL: a raw grammar-sequence encoding is token atoms, and token atoms
// do not ground, so a raw roster in a subject's own module would refuse the whole fixture at
// infer_grounding_not_derived before any wall could judge it (pinned by probe 2026-10-04) — the same
// reason the where-clause lowering does not carry predicates raw.
//
// FALLBACK, FAIL-CLOSED: if the authored spine does not read, the carrier hangs a MARKER atom at
// the clause's own occurrence instead of a roster. The reader demands a roster conj and REFUSES
// (^infer_reason_admit_callers_entries_unreadable at the clause) — a malformed clause is never a
// shorter roster (DESIGN section 5: a failure arm must refuse, never widen).
// THE CARRIER (v2 body lowering): a fn's authored `admit_callers` clause becomes one AdmitCallersEdge
// on the fn's Arrow, whose target is the clause's lowered image. The outer Absent (no clause
// captured) is the only silence: a fn without the clause has nothing to judge. Once a clause IS
// captured, every failure to read it hangs the clause-fallback marker instead -- the reader refuses
// it as ^infer_reason_admit_callers_entries_unreadable at the clause (DESIGN §5: a failure arm must
// refuse, never widen). A grammar or graft change that reshapes the clause shell switches the wall
// to REFUSING, never off.
fn body_lower_fn_admit_clause_edges(shell: Node) -> List<Edge> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => []
    Present { value: captured } =>
      match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_admit_callers_clause) {
        Absent =>
          [core_edge(
            marker: AdmitCallersEdge,
            target: sugar_type_node(connective: Atom { identity: ^infer_reason_admit_callers_entries_unreadable }, children: [], n: captured)
          )]
        Present { value: image } =>
          match sugar_named_child_optional(root: image, name: ^admit_callers_clause_body) {
            Absent =>
              [core_edge(
                marker: AdmitCallersEdge,
                target: sugar_type_node(connective: Atom { identity: ^infer_reason_admit_callers_entries_unreadable }, children: [], n: image)
              )]
            Present { value: roster } => [core_edge(marker: AdmitCallersEdge, target: roster)]
          }
      }
  }
}

// THE CLAUSE'S LOWERED IMAGE: the shell's own kind and occurrence (so the Arrow finds it), carrying
// the roster as one named value edge. The reused occurrence is legal BECAUSE the shell it came from
// leaves the tree with this replacement, together with the whole raw spine (occurrence wall: a
// minted id on two nodes with different content refuses). The production-identity projection is
// KEPT verbatim, so body_lower_find_production_shell_optional and every graft that recognizes the
// shell still do; only the value encoding is swapped.
fn body_lower_admit_clause_image(clause: Node) -> Node {
  let roster = match body_lower_admit_roster_node(clause: clause) {
    Absent => sugar_type_node(connective: Atom { identity: ^infer_reason_admit_callers_entries_unreadable }, children: [], n: clause)
    Present { value: r } => r
  }
  node_lowered_from(
    source: clause,
    kind: clause.kind,
    children: list_append(
      left: keep_production_projections(children: clause.children),
      right: [Edge { label: Authored { name: ^admit_callers_clause_body }, target: roster }]
    )
  )
}

// The projection edges that are part of the shell's identity (the production-identity projection and
// its peers), kept so the image remains a recognized production shell.
fn keep_production_projections(children: List<Edge>) -> List<Edge> {
  fold(
    xs: children,
    init: Empty,
    f: fn(acc, e) {
      if label_is_projection(e: e) { list_append(left: acc, right: [e]) } else { acc }
    }
  )
}

fn label_is_projection(e: Edge) -> Bool {
  match e.label {
    Authored { name: name } =>
      (name == ^grammar_production_identity_node_projection)
        || (name == ^grammar_optional_element_node_projection)
    Positional => false
    StructuralLabel { label: _ } => true
  }
}

fn body_lower_admit_roster_node(clause: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: clause) {
    Absent => optional_absent()
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: captured)) {
        Absent => optional_absent()
        Present { value: head_pair } =>
          match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: head_pair.right)) {
            Absent => optional_absent()
            Present { value: colon_pair } =>
              match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: colon_pair.right)) {
                Absent => optional_absent()
                Present { value: bracket_pair } =>
                  match body_lower_comma_list_items_optional(list_capture: bracket_pair.right) {
                    Absent => optional_absent()
                    Present { value: entries } =>
                      body_lower_admit_roster_from_entries(entries: entries, template: bracket_pair.right)
                  }
              }
          }
      }
  }
}

fn body_lower_admit_roster_from_entries(entries: List<Node>, template: Node) -> Optional<Node> {
  match body_lower_admit_record_spine(entries: entries, template: template) {
    Absent => optional_absent()
    Present { value: spine } =>
      optional_present(value: close_lowered_image(root: spine))
  }
}

// THE CONFORMING ROSTER: a left-nested conj spine, one record per entry, under NAMED edges —
// @left carries the record, @right carries the rest, the empty conj root ends the spine. Every edge
// is authored and distinct within its node, so connective_edges_conform accepts it, and an empty
// authored list lowers to the empty conj root without refusing. All built nodes share the template's
// minted occurrence (the template left the tree with the swap); close_lowered_image marks every
// member below the root OccurrencePending so allocation gives each a real id after normalization.
fn body_lower_admit_record_spine(entries: List<Node>, template: Node) -> Optional<Node> {
  fold(
    xs: entries,
    init: optional_present(value: sugar_type_node(connective: Conj, children: [], n: template)),
    f: fn(acc, entry) {
      match acc {
        Absent => optional_absent()
        Present { value: rest } =>
          match body_lower_admit_entry_edge(entry: entry, template: template) {
            Absent => optional_absent()
            Present { value: record_edge } =>
              optional_present(
                value: sugar_type_node(
                  connective: Conj,
                  children: [
                    Edge { label: Authored { name: ^left }, target: record_edge.target },
                    Edge { label: Authored { name: ^right }, target: rest }
                  ],
                  n: template
                )
              )
          }
      }
    }
  )
}

// ONE ENTRY -> ONE RECORD CONJ IN THE SPINE, ALWAYS GROUNDABLE. A decl_ref(module_path, decl_name)
// call lowers to a record conj whose authored edges carry the operator spelling (^decl_ref) and the two
// string lexemes as plain atoms keeping the literals' own occurrences (the where-clause lowering's
// precedent). An entry that READS but is not such a call lowers to a marker record the reader refuses
// at the entry (^infer_reason_admit_callers_entry_not_decl_ref) — never dropped, never a raw token
// subtree. Only a spine the reader cannot walk returns Absent, failing the whole roster into the clause
// fallback's refusal. The record conj itself is minted with the roster template's id (pending below the
// spine root), never with the call's: a conj and the atom under it cannot share one minted id.
fn body_lower_admit_entry_edge(entry: Node, template: Node) -> Optional<Edge> {
  match body_lower_admit_entry_call_optional(item: entry) {
    Absent => optional_absent()
    Present { value: call } =>
      match call.kind {
        ComputationNode { behavior: Transform } =>
          match body_lower_admit_operator_edge(children: call.children) {
            Absent => optional_present(value: body_lower_admit_entry_marker(node: entry, template: template))
            Present { value: op_edge } =>
              match op_edge.target.kind {
                TypeNode { connective: Atom { identity: op } } =>
                  if symbol_eq(a: op, b: ^decl_ref) {
                    match body_lower_admit_string_field_edge(call: call, field: ^module_path) {
                      Absent => optional_present(value: body_lower_admit_entry_marker(node: entry, template: template))
                      Present { value: mp_edge } =>
                        match body_lower_admit_string_field_edge(call: call, field: ^decl_name) {
                          Absent => optional_present(value: body_lower_admit_entry_marker(node: entry, template: template))
                          Present { value: dn_edge } =>
                            optional_present(
                              value: Edge {
                                label: Authored { name: ^admit_callers_clause_body },
                                target: sugar_type_node(
                                  connective: Conj,
                                  children: [op_edge, mp_edge, dn_edge],
                                  n: template
                                )
                              }
                            )
                        }
                    }
                  } else {
                    optional_present(value: body_lower_admit_entry_marker(node: entry, template: template))
                  }
                _ => optional_present(value: body_lower_admit_entry_marker(node: entry, template: template))
              }
          }
        _ => optional_present(value: body_lower_admit_entry_marker(node: entry, template: template))
      }
  }
}

// THE UNINTERPRETABLE-ENTRY MARKER: a record conj whose single edge names the refusal the reader
// raises at the entry. The conj is minted with the template's id (close_lowered_image marks it
// pending, allocation gives it a real id); the atom keeps the entry's own occurrence — the entry
// left the tree in the swap, and no two built nodes share one minted id.
fn body_lower_admit_entry_marker(node: Node, template: Node) -> Edge {
  Edge {
    label: Authored { name: ^uninterpretable },
    target: sugar_type_node(
      connective: Conj,
      children: [Edge {
        label: Authored { name: ^infer_reason_admit_callers_entry_not_decl_ref },
        target: sugar_type_node(connective: Atom { identity: ^infer_reason_admit_callers_entry_not_decl_ref }, children: [], n: node)
      }],
      n: template
    )
  }
}

// The entry item is the parse spine of the call expression: nested sequence pairs whose every right
// component is empty (a call has no operator tail), bottoming at the lowered comp:transform. Descend
// the left spine to the leaf; a non-empty tail is not an entry shape this reader admits.
fn body_lower_admit_entry_call_optional(item: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: item)) {
    Absent => optional_present(value: body_lower_deep_unwrap_optional(node: item))
    Present { value: pair } =>
      if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
        body_lower_admit_entry_call_optional(item: pair.left)
      } else {
        optional_absent()
      }
  }
}

fn body_lower_admit_operator_edge(children: List<Edge>) -> Optional<Edge> {
  fold(children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent =>
        match e.label {
          Positional => optional_present(value: e)
          _ => optional_absent()
        }
    }
  })
}

// @field -> string-literal atom -> the value lexeme as an interned symbol, hung as the record's
// authored field edge so the atom KEEPS THE LITERAL'S OWN OCCURRENCE (the where-clause lowering's
// precedent: authored atoms ride their authored occurrences, so resolve and infer see the lexeme
// the module wrote).
fn body_lower_admit_string_field_edge(call: Node, field: Symbol) -> Optional<Edge> {
  match sugar_named_child_optional(root: call, name: field) {
    Absent => optional_absent()
    Present { value: literal } =>
      match dag_string_literal_value_symbol_optional(node: literal) {
        Absent => optional_absent()
        Present { value: lexeme } =>
          optional_present(
            value: Edge {
              label: Authored { name: field },
              target: sugar_type_node(connective: Atom { identity: lexeme }, children: [], n: literal)
            }
          )
      }
  }
}

// CENSUS GRADE: THE SIGNATURE, NEVER THE BODY. A module outside the compiled closure is read only for
// what resolution asks of it -- declaration paths and payload kinds -- and the symbol-index fill
// descends into an Arrow's domain alone. So the census arm builds the full arm's Arrow from the same
// signature and omits the ^arrow_body_edge: the body subtree is never lowered, so a body the
// lowering cannot yet read cannot refuse a module nobody compiles. What it does NOT relax: a
// signature this arm cannot read still retains, which the census door
// (v2.compiler.normalized_tree admit_census_tree) refuses exactly as the full door does. Omitting the
// edge rather than lowering the body tolerantly also removes the three incidental body reads a
// census root would otherwise feed: the subtree-wide Disj count, the alias scan, and the Arrow the
// index stores at the fn's path.
fn body_lower_fn_decl_to_census_arrow(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_first_signature_refusal_optional(captured: captured) {
        Present { value: refused } => body_lowering_lowered(o: refused)
        Absent =>
          match body_lower_fn_signature_optional(captured: captured) {
            Rejected { diagnostics: r } => body_lowering_lowered(o: Rejected { diagnostics: r })
            Accepted { value: Absent, diagnostics: _ } => body_lower_wrapper_retained_shell(shell: shell)
            Accepted { value: Present { value: sig }, diagnostics: _ } =>
              match body_lower_fn_signature_refusal(shell: shell, sig: sig) {
                Present { value: refused } => body_lowering_lowered(o: refused)
                Absent =>
                  body_lowering_lowered(
                    o: outcome_accepted(value: body_lower_fn_decl_arrow(shell: shell, sig: sig, body: Absent))
                  )
              }
          }
      }
  }
}

// The signature is read before the body is lowered. A declaration whose signature cannot be read
// AND whose body refuses therefore now reports retention rather than the body's cause; both refuse,
// and the signature is the earlier fact.
fn body_lower_fn_decl_to_arrow_admitted(shell: Node, captured: Node) -> Outcome<BodyLowering> {
  match body_lower_fn_signature_optional(captured: captured) {
    Rejected { diagnostics: r } => body_lowering_lowered(o: Rejected { diagnostics: r })
    Accepted { value: Absent, diagnostics: _ } => body_lower_wrapper_retained_shell(shell: shell)
    Accepted { value: Present { value: sig }, diagnostics: _ } =>
      match body_lower_fn_signature_refusal(shell: shell, sig: sig) {
        Present { value: refused } => body_lowering_lowered(o: refused)
        Absent =>
          match body_lower_body_from_fn_captured(captured: captured) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: body_opt, diagnostics: bd0 } =>
              match body_opt {
                Absent => body_lowering_after_pending(pending: bd0, o: body_lower_wrapper_retained_shell(shell: shell))
                Present { value: body } =>
                  match body_lower_reify_arrow_body(body: body) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: reified_body, diagnostics: bd } =>
                      body_lowering_lowered(
                        o: outcome_with_diagnostics(
                          value: body_lower_fn_decl_arrow(
                            shell: shell,
                            sig: sig,
                            body: Present { value: reified_body }
                          ),
                          diagnostics: diagnostics_merge(outer: bd0, inner: bd)
                        )
                      )
                  }
              }
          }
      }
  }
}

// A LITERAL READER ANSWERS ONLY A NODE THAT IS THE LITERAL WHOLE. It descends only where the node and
// its inner node are one value -- a production shell's captured child, a one-element sequence -- and
// never into a proper part. The descent was a first-match search over every child, so any node with a
// `true`, `false` or int literal anywhere under it read as that literal: the `else if` chain of
// `if a { a } else if a { false } else { u }` lowered to `false`, and `u` reached no reference site.
fn body_lower_whole_inner_optional(node: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: node) {
    Present { value: captured } => optional_present(value: captured)
    Absent =>
      match sugar_sequence_pair_optional(node: node) {
        Present { value: pair } =>
          if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
            optional_present(value: pair.left)
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

fn body_lower_literal_bool_atom_optional(node: Node) -> Optional<Node> {
  let unwrapped = body_lower_deep_unwrap_optional(node: node)
  match node_atom_identity_optional(node: unwrapped) {
    Present { value: id } =>
      if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
        optional_present(value: body_lower_param_ref_atom(source: unwrapped, identity: id))
      } else {
        body_lower_int_literal_with_magnitude_optional(node: unwrapped)
      }
    Absent =>
      match body_lower_whole_inner_optional(node: unwrapped) {
        Present { value: inner } => body_lower_literal_bool_atom_optional(node: inner)
        Absent => optional_absent()
      }
  }
}

fn body_lower_literal_int_atom_optional(node: Node) -> Optional<Node> {
  match body_lower_int_literal_with_magnitude_optional(node: node) {
    Present { value: lit } => Present { value: lit }
    Absent =>
      match body_lower_whole_inner_optional(node: body_lower_deep_unwrap_optional(node: node)) {
        Present { value: inner } => body_lower_literal_int_atom_optional(node: inner)
        Absent => optional_absent()
      }
  }
}

fn body_lower_operand_ref_acceptable_read(node: Node) -> OperandRefRead {
  match body_lower_operand_ref_read(node: node) {
    OperandRefLowered { lowered: operand } =>
      match body_lower_int_literal_with_magnitude_optional(node: operand) {
        Present { value: lit } => OperandRefLowered { lowered: lit }
        Absent =>
          match dag_node_is_int_literal_atom(node: operand) {
            true => OperandRefAbsent
            false => OperandRefLowered { lowered: operand }
          }
      }
    OperandRefAbsent => OperandRefAbsent
    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
  }
}

// A REFUSED OPERAND IS THIS READER'S REFUSAL. Reaching a deep first-match search for an operand the
// operator reader refused answered the operand's first atom: `b && (u)` lowered to `b`. The last
// arm is body_lower_value_sole_atom_optional, not a search: a capture that is not itself one atom
// answers Absent and the caller refuses (unsupported_form).
fn body_lower_operand_or_atom_read(captured: Node) -> OperandRefRead {
  match body_lower_operand_ref_acceptable_read(node: captured) {
    OperandRefAbsent =>
      match body_lower_literal_bool_atom_optional(node: captured) {
        Present { value: lit } => OperandRefLowered { lowered: lit }
        Absent =>
          match body_lower_literal_int_atom_optional(node: captured) {
            Present { value: lit } => OperandRefLowered { lowered: lit }
            Absent =>
              match body_lower_value_sole_atom_optional(node: captured) {
                Present { value: leaf } =>
                  if body_lower_atom_is_keyword_token(node: leaf) { OperandRefAbsent } else { OperandRefLowered { lowered: leaf } }
                Absent => OperandRefAbsent
              }
          }
      }
    OperandRefLowered { lowered: lowered } => OperandRefLowered { lowered: lowered }
    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
  }
}

// A LEXER KEYWORD TOKEN IS NEVER AN OPERAND. The first-atom fallback in
// body_lower_operand_or_atom_read (above) answered a shell with its
// first atom whatever it was, so a function literal `fn(y) { zz }` in an if arm lowered to the atom
// dag_token_kw_fn and the literal was erased (gunbc.recurring_failure_mode
// body_type_annotation_dropped_before_resolve_in_v2). `true` / `false` are keyword tokens that ARE
// literal operands, and they need no exception here: body_lower_literal_bool_atom_optional reads them
// in body_lower_operand_or_atom_read BEFORE this fallback, so a boolean the fallback would meet is the
// first atom of something larger, and standing it in for the whole is the part-for-whole erasure this
// guard exists to refuse. The keyword/operand distinction is the lex rules' alone.
// KEYWORD, not token: an int literal reaches this fallback as an atom whose identity is the token CLASS
// dag_token_int_literal (`let x = 1` binds exactly that), so asking whether the atom is any lexer
// token refused every such literal. The keyword classes are the rules lexed by a KeywordPattern
// (v2.extdeps.languages.dag dag_lex_keyword_symbol).
fn body_lower_atom_is_keyword_token(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => dag_lex_keyword_symbol(sym: id)
    Absent => false
  }
}

fn body_lower_try_operand_or_reject(shell: Node, captured: Node) -> Outcome<Node> {
  match body_lower_operand_or_atom_read(captured: captured) {
    OperandRefLowered { lowered: operand } => outcome_accepted(value: operand)
    OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
    OperandRefAbsent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
  }
}

fn body_lower_unwrap_pass_through(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } => outcome_accepted(value: captured)
  }
}

fn body_lower_transform_call(operator: Node, args: List<Edge>) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: list_append(left: [Edge { label: Positional, target: operator }], right: args)
  )
}

fn body_lower_arg_operand_read(arg_capture: Node) -> OperandRefRead {
  match body_lower_find_captured(root: arg_capture, emitted: ^dag_surface_expr) {
    ParseSubtreeFound { captured: expr } => body_lower_operand_ref_read(node: expr)
    ParseSubtreeAbsent =>
      match parse_production_emitted_identity_optional(node: arg_capture) {
        Present { value: emitted } =>
          if emitted == ^dag_surface_expr {
            match parse_production_captured_child_optional(node: arg_capture) {
              Present { value: captured } => body_lower_operand_ref_read(node: captured)
              Absent => OperandRefAbsent
            }
          } else {
            body_lower_operand_ref_read(node: arg_capture)
          }
        Absent => body_lower_operand_ref_read(node: arg_capture)
      }
  }
}

// A NAMED ARGUMENT'S LABEL AND ITS VALUE CAPTURE -- `name` and what follows `name :`, the value
// unlowered. Absent when the capture is not that shape. The label is the binding key: the callee's
// domain is name-keyed (gunbc#12054), so it is carried onto the lowered application as the edge's
// Named label (body_lower_call_arg_edge), never read and dropped.
type BodyLowerNamedArg {
  label: Symbol
  value: Node
}

fn body_lower_named_arg_capture_optional(arg_capture: Node) -> Optional<BodyLowerNamedArg> {
  match sugar_sequence_pair_optional(node: arg_capture) {
    Absent =>
      match parse_production_emitted_identity_optional(node: arg_capture) {
        Present { value: emitted } =>
          if emitted == ^dag_surface_arg {
            match parse_production_captured_child_optional(node: arg_capture) {
              Present { value: captured } =>
                body_lower_named_arg_capture_optional(arg_capture: captured)
              Absent => optional_absent()
            }
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
    Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        Absent => optional_absent()
        Present { value: label } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => optional_absent()
            Present { value: after_name } =>
              match node_atom_identity_optional(node: after_name.left) {
                Present { value: colon } =>
                  if colon == ^dag_token_colon {
                    optional_present(value: BodyLowerNamedArg { label: label, value: after_name.right })
                  } else {
                    optional_absent()
                  }
                Absent => optional_absent()
              }
          }
      }
  }
}

// THE NAMED ARM IS DECIDED BY THE ARGUMENT'S SHAPE, NOT BY WHETHER ITS VALUE LOWERED. A
// dag_surface_arg captures either `name : expr` or `expr` (v2.extdeps.languages.dag
// dag_grammar_arg_expr). The reader this replaces tried the named value first and, when that
// answered Absent, re-read the WHOLE capture as a positional operand -- and the operand reader,
// handed the `name : expr` sequence, answers its left atom, so an unlowerable named value became a
// reference to the parameter NAME with no diagnostic.
fn body_lower_call_arg_capture_is_named(arg_capture: Node) -> Bool {
  let captured = match parse_production_emitted_identity_optional(node: arg_capture) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_arg {
        match parse_production_captured_child_optional(node: arg_capture) {
          Present { value: inner } => inner
          Absent => arg_capture
        }
      } else {
        arg_capture
      }
    Absent => arg_capture
  }
  match sugar_sequence_pair_optional(node: captured) {
    Absent => false
    Present { value: pair } =>
      match sugar_sequence_pair_optional(node: pair.right) {
        Absent => false
        Present { value: after_name } =>
          match node_atom_identity_optional(node: after_name.left) {
            Present { value: colon } => colon == ^dag_token_colon
            Absent => false
          }
      }
  }
}

// THE VALUE READER'S ONLY ANSWERING FORM: THE VALUE, LOWERED, OR A LOCATED REFUSAL. There was a
// third answer, body_lower_value_lowered_or_carried, which handed back the unlowered SHELL under the
// head-grain advisory body_lowering_reason_value_carried_unlowered and let the file Accept. Nothing
// downstream refused that shell before consuming it as lowered: it reached resolve, whose scope has
// no binder for a carried function literal, and refused there at the WRONG atom -- the literal's own
// parameter (gunbc.recurring_failure_mode
// carried_unlowered_value_accepted_as_an_advisory_refuses_downstream_at_the_wrong_atom). A widened
// answer is not a refusal (DESIGN section 5), so the carry is deleted and every value position --
// field initializer, if condition and arms, let value, each statement of a block, match arm body --
// asks this reader and refuses AT THE VALUE, under the value's own cause, when it cannot lower it.
// A refusal the reader itself raises (an inner call argument, a list literal) is the value's
// refusal and passes through unchanged; it is never relabelled as the enclosing form's navigation.
fn body_lower_value_read(value: Node) -> Outcome<Node> {
  match body_lower_value_lowered(node: value) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Present { value: lowered }, diagnostics: d } =>
      outcome_with_diagnostics(value: lowered, diagnostics: d)
    Accepted { value: Absent, diagnostics: _ } =>
      outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_value_unlowered, n: value))
  }
}

// COST SHAPE: ONE BOTTOM-UP FOLD PER VALUE, THE WALKER ONLY AS THE FALLBACK. A raw value is first
// folded once (body_lower_fold, linear in its size: nested calls, records and literals lower with
// their children already lowered) and the result peeled; only a value the fold cannot bring to a
// lowered node enters the top-down walker. Entering the walker first is exponential in nesting
// depth: each walker attempt (body_lower_body_subtree_lower_rest and the from_binary / from_expr /
// from_postfix retries) re-folds the subtree through body_lower_try_body_lowered and re-enters
// this reader for every nested argument, so a call nested d deep is folded on the order of 5^d
// times. The instrument that re-derives this is the native lane's per-file phase clock: the
// emitted driver's `adjudicate` (std.compiler_entry SourceRootEvalDriver, absorbed by
// v2.compiler.compile native_test_context_absorb) prints one row per ingested file carrying
// `normalize_nanos`; sum and sort it over the workload closure, baseline against candidate.
//
// A FOLD THAT REFUSES IS THE VALUE'S REFUSAL, AND IT PROPAGATES. It used to hand the value to the
// walker instead, and the walker answers with the first lowerable SUBTREE it finds -- which is not
// the value. Measured on dag/extdeps/linux/proc_mountinfo.dag mountinfo_mount_points: the fold
// refused `let folded = fold(filter(map(split(..), l => trim(l)), ..), init: .., f: fn(acc, line) {..})`
// at the lambda (call_argument_unread), the walker answered with the BODY of the `f:` literal, and the
// Bind carried that body as `folded`'s value -- the fold call, the filter/map/split chain, `init` and
// the literal's binders all gone, and the module Accepted. That is a wrong answer where a located
// refusal was owed (DESIGN section 5), found by the full-corpus census on the PR that removed the
// value carry: nine files refusing call_argument_unread at base were Accepted this way. The walker is
// still the reader for a value the fold ACCEPTS but leaves unpeelable.
fn body_lower_value_lowered(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_lowered_behind_shells_read(node: node) {
    OperandRefLowered { lowered: lowered } => outcome_accepted(value: optional_present(value: lowered))
    OperandRefAbsent =>
      let raw = body_lower_deep_unwrap_optional(node: node)
      match body_lower_fold(node: raw) {
        Accepted { value: folded, diagnostics: d } =>
          match body_lower_lowered_behind_shells_read(node: folded) {
            OperandRefLowered { lowered: lowered } =>
              outcome_with_diagnostics(value: optional_present(value: lowered), diagnostics: d)
            OperandRefAbsent => body_lower_body_subtree_lower(captured: raw)
            OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
  }
}

// A value the bottom-up fold has already reduced sits behind what the reducers leave: a
// pass-through shell around the lowered child, or the binary_expr precedence spine -- one
// left-nested sequence per precedence level, each right projection an empty repeat -- with the
// lowered operand at its leftmost leaf (body_lower_reduce_passthrough strips the shells and keeps
// the spine). Both are peeled to the lowered node first; a spine with a non-empty right
// projection is an unlowered operator tail and is not peeled.
fn body_lower_lowered_behind_shells_read(node: Node) -> OperandRefRead {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  if body_lower_is_core_substrate(node: stripped) {
    OperandRefLowered { lowered: stripped }
  } else if body_lower_is_unrecognised_lowered_shape(node: stripped) {
    OperandRefRefused { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: stripped) }
  } else if body_lower_node_is_lowered_atom(node: stripped) {
    body_lower_operand_ref_read(node: stripped)
  } else {
    match parse_production_emitted_identity_optional(node: stripped) {
      Present { value: _ } =>
        match parse_production_captured_child_optional(node: stripped) {
          Absent => OperandRefAbsent
          Present { value: captured } => body_lower_lowered_behind_shells_read(node: captured)
        }
      Absent =>
        match sugar_sequence_pair_optional(node: stripped) {
          Absent => OperandRefAbsent
          Present { value: pair } =>
            if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
              body_lower_lowered_behind_shells_read(node: pair.left)
            } else {
              OperandRefAbsent
            }
        }
    }
  }
}

// ONE VALUE READER FOR FIELD INITIALIZERS, MATCH-ARM BODIES AND IF CONDITIONS. A value reaches
// these readers in one of two states: already lowered (the bottom-up fold has run over it, as
// under a data initializer, or it is core substrate) or raw (inside a fn body the fn_decl producer
// walks the parse top-down, so a value is still its `expr` shell). A lowered atom is read as the
// operand it is; anything else goes to body_lower_body_subtree_lower, the same entry the fn body
// itself is lowered by, so a nested call, an infix or a control form in value position lowers as it
// would in body position. Absent means this reader could not lower the value.
//
// CALL ARGUMENTS DO NOT GO THROUGH IT. gunbc#12108 is the authority for call-argument lowering
// (body_lower_call_args_from_capture -> body_lower_call_arg_edges -> body_lower_call_arg_edge), and this reader once also served
// arguments; that route was dropped at the merge rather than kept beside #12108's. The two differ in
// strength: #12108's per-argument read goes through body_lower_operand_ref_optional, which narrows a
// sequence operand to its head (gunbc.recurring_failure_mode
// lowering_accessor_collapses_a_sequence_operand, its own trigger). Routing arguments through this
// reader is that failure mode's repair to make, not a second path to add here.
fn body_lower_node_is_lowered_atom(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: _ } => false
    Absent =>
      match node_atom_identity_optional(node: node) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

// A LAMBDA IN VALUE POSITION LOWERS TO THE ARROW A NAMED FN LOWERS TO. `p => body` and
// `(a, b, ..) => body` in argument or field position become the Arrow a generic named fn lowers to:
//   Arrow [ Conj { p: 'p, .. }, 'return, 'return, <type-parameters>: Conj { 'p: 'p, .. }, arrow_body_edge: body ]
// so `p => body` means `<'p>(p: 'p) => body` -- each parameter's unwritten type is a FRESH TYPE
// PARAMETER of that lambda's own Arrow (body_lower_function_value_arrow mints them, on v2.std.type_binder type_params_edge). The binders are
// the one binder model resolve already scopes (03_resolve resolve_arrow_node: value parameters for
// the body, type parameters as a frame over the signature), so the body resolves with its parameters
// bound and an undeclared name in it refuses at its own atom; and infer reads the type variables as
// it reads any generic Arrow's, never as a named type. The binders are read off
// dag_grammar_arrow_lambda_expr's two alternatives, the same reading fold_lowering's
// arrow_lambda_is_parenthesised makes: bare
//   seq(ident, seq(`=>`, expr))
// and parenthesised, two or more binders,
//   seq(`(`, seq(ident, seq(`,`, seq(ident, seq(repeat(seq(`,`, ident)), seq(`)`, seq(`=>`, expr)))))))
// A shape outside those, or a body the value reader cannot lower, is a located refusal: the lambda is
// never narrowed to its parameter and never carried as an unlowered shell. A lambda inside a
// fold-family call is still fold_lowering's (body_lower_fold_family_call_first takes the call on its
// raw node before any argument is lowered), so this is the lambda's only other lowering, not a second one.
// The function-value production a value is, with its captured child: `p => body` or `fn(..) { .. }`.
type FunctionValueCapture {
  kind: FunctionValueKind
  captured: Node
}

fn body_lower_function_value_captured_optional(node: Node) -> Optional<FunctionValueCapture> {
  let stripped = body_lower_unwrap_surface_shell(node: body_lower_deep_unwrap_optional(node: node))
  match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: id } =>
      match function_value_kind_of(emitted: id) {
        Absent => optional_absent()
        Present { value: kind } =>
          match parse_production_captured_child_optional(node: stripped) {
            Present { value: captured } => optional_present(value: FunctionValueCapture { kind: kind, captured: captured })
            Absent => optional_absent()
          }
      }
    Absent => optional_absent()
  }
}

fn body_lower_lambda_token_is(node: Node, token: Symbol) -> Bool {
  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: node)) {
    Present { value: id } => id == token
    Absent => false
  }
}

// A function value's return type: the one its source wrote, lowered as a named fn's is, or none --
// in which case body_lower_function_value_arrow mints a fresh type parameter for it.
type FunctionValueCodomain
  = CodomainAuthored { type_node: Node }
  | CodomainElided

// opt(seq(`->`, type_expr)), the return clause v2.compiler.fold_lowering function_value_parts_optional
// reads (a lambda's is the empty conj). Present-but-unreadable is Absent, and refuses.
fn body_lower_function_value_codomain_optional(ret: Node) -> Optional<FunctionValueCodomain> {
  let r = body_lower_deep_unwrap_optional(node: ret)
  if is_empty_conj_root(n: r) {
    optional_present(value: CodomainElided)
  } else {
    match sugar_sequence_pair_optional(node: r) {
      Absent => optional_absent()
      Present { value: pair } =>
        if body_lower_lambda_token_is(node: pair.left, token: ^dag_token_arrow) {
          match body_lower_type_expr_lowered_optional(node: pair.right) {
            Absent => optional_absent()
            Present { value: t } => optional_present(value: CodomainAuthored { type_node: t })
          }
        } else {
          optional_absent()
        }
    }
  }
}

// THE BODY, BY ITS FORM, THROUGH ITS OWN SLOT AND NOTHING ELSE. An expression body (`p => e`) is
// folded once and peeled of the pass-through shells the fold leaves; a block body (`fn(..) { .. }`)
// is its fn_body's stmt_seq slot -- fn_body = seq(`{`, seq(stmt_seq, `}`)), read positionally -- lowered
// by the statement spine (body_lower_stmt_seq: lets as Binds, the last statement folded), the same
// authority a named fn's multi-statement body uses. Neither route enters the general walker
// (body_lower_body_subtree_lower) or searches the subtree: a body the fold cannot bring to a lowered
// node is Absent, and the caller refuses it located at the body
// (gunbc.recurring_failure_mode producer_reenters_a_general_subtree_walker).
fn body_lower_function_value_body(body: FunctionLiteralBody) -> Outcome<Optional<Node>> {
  match body {
    FunctionLiteralExprBody { expr: e } => body_lower_function_value_lowered_whole(o: body_lower_fold(node: body_lower_deep_unwrap_optional(node: e)))
    FunctionLiteralBlockBody { fn_body: b } =>
      match body_lower_exit_outside_tail_optional(node: b, tail: true) {
        Present { value: refused } => body_lower_function_value_lowered_whole(o: refused)
        Absent =>
          match body_lower_fn_body_stmt_seq_optional(fn_body: b) {
            Absent => outcome_accepted(value: optional_absent())
            Present { value: stmt_seq } => body_lower_function_value_lowered_whole(o: body_lower_stmt_seq(shell: stmt_seq))
          }
      }
    FunctionLiteralStatementBody { body: b } =>
      match body_lower_exit_outside_tail_optional(node: b, tail: true) {
        Present { value: refused } => body_lower_function_value_lowered_whole(o: refused)
        Absent => body_lower_function_value_lowered_whole(o: body_lower_stmt_seq(shell: b))
      }
  }
}

fn body_lower_function_value_lowered_whole(o: Outcome<Node>) -> Outcome<Optional<Node>> {
  match o {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: folded, diagnostics: d } =>
      body_lower_operand_read_outcome(read: body_lower_lowered_behind_shells_read(node: folded), diagnostics: d)
  }
}

// fn_body's captured child is seq(`{`, seq(stmt_seq, `}`)); the stmt_seq production is the LEFT of
// its right projection.
fn body_lower_fn_body_stmt_seq_optional(fn_body: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: body_lower_deep_unwrap_optional(node: fn_body)) {
    Absent => optional_absent()
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => optional_absent()
        Present { value: brace_rest } =>
          match sugar_sequence_pair_optional(node: brace_rest.right) {
            Absent => optional_absent()
            Present { value: seq_close } => optional_present(value: body_lower_deep_unwrap_optional(node: seq_close.left))
          }
      }
  }
}

fn body_lower_function_value_body_node(body: FunctionLiteralBody) -> Node {
  match body {
    FunctionLiteralExprBody { expr: e } => e
    FunctionLiteralBlockBody { fn_body: b } => b
    FunctionLiteralStatementBody { body: b } => b
  }
}

// A FUNCTION VALUE IN VALUE POSITION. Its binders, return clause and body are read by the one reader
// of the two function-value productions, v2.compiler.fold_lowering function_value_parts_optional,
// which fold_lowering's own fold step also projects; the Arrow is built by
// body_lower_function_value_arrow. A shape that reader declines, an unreadable return clause, or a
// body neither body reader lowers is a located refusal: the value is never narrowed to its parameter
// and never carried as an unlowered shell.
fn body_lower_function_value(shell: Node, capture: FunctionValueCapture) -> Outcome<Optional<Node>> {
  let unread: Outcome<Optional<Node>> = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_function_value_shape_unread, n: shell)
  )
  match function_value_parts_optional(captured: capture.captured, kind: capture.kind) {
    Absent => unread
    Present { value: parts } =>
      match body_lower_function_value_codomain_optional(ret: parts.return_clause) {
        Absent => unread
        Present { value: codomain } =>
          match body_lower_function_value_body(body: parts.body) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: Absent, diagnostics: _ } =>
              outcome_rejected(
                d: body_lower_diagnostic(
                  reason: ^body_lowering_reason_function_value_body_unread,
                  n: body_lower_function_value_body_node(body: parts.body)
                )
              )
            Accepted { value: Present { value: body }, diagnostics: d } =>
              match body_lower_function_value_arrow(shell: shell, binders: parts.binders, codomain: codomain, body: body) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: arrow, diagnostics: ad } =>
                  outcome_with_diagnostics(
                    value: optional_present(value: arrow),
                    diagnostics: diagnostics_merge(outer: d, inner: ad)
                  )
              }
          }
      }
  }
}

// THE ONE FUNCTION-VALUE ARROW PRODUCER. Every function value in value position -- `p => body` and
// `fn(a, b) -> R { .. }` -- builds its Arrow through this, from its authored binders, its codomain
// and its ALREADY LOWERED body, so there is one Arrow shape.
//
// AN UNWRITTEN TYPE IS A FRESH TYPE PARAMETER OF THIS ARROW (gunbc#12217's binder model): each
// parameter the source leaves unannotated, and an unwritten return, is typed by a type parameter
// minted by v2.std.anonymous_binder fresh_type_variable from the binder's label (after the
// anonymous-slot mint, so labels are distinct). The producer mints it UNPOSITIONED (an empty path);
// the enclosing declaration's lowering positions every function value's variables by its structural
// path (body_lower_position_function_values), which makes them unique across nested and sibling
// function values without any occurrence entering the type. The spelling is unauthorable, so it never
// shadows or collides with an authored name.
type FunctionValueSignature {
  domain: List<Edge>
  type_params: List<Edge>
  order: List<Symbol>
}

// A fresh type variable is minted by the compiler, not authored, so it is a SYNTHETIC atom: it must
// not wear the binder's authored occurrence under a different spelling, which the reference
// conservation census reads as the authored binder dropped (a projected occurrence is XL-2's
// prerequisite, not modeled yet).
fn body_lower_function_value_type_var_atom(tv: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: tv } }, children: [])
}

// THE DOMAIN AND ITS DECLARED ORDER COME OUT OF THE ONE PARAMETER-LIST MINT (v2.std.anonymous_binder
// anonymous_binder_mint_parameter_list), exactly as a named fn's do: every binder the author spelled
// `_` is relabelled `<anonymous-parameter-N>` by its slot, every other binder keeps its name, and the
// labels' authored order is carried beside the domain, because the domain is a Conj -- a set of
// labelled binders that canonicalization sorts by label -- and cannot carry it. The minted labels then key both the domain edge and its fresh type parameter.
// The mint relabels Named edges and passes any other edge through unchanged, so every edge here is
// Named; one that were not would be kept in the domain as is, where v2.std.node edges_conform refuses
// a Positional edge in a record -- loudly.
fn body_lower_function_value_signature(binders: List<FunctionValueBinder>) -> FunctionValueSignature {
  let no_edges: List<Edge> = []
  let authored = fold(binders, init: no_edges, f: fn(acc, b) {
    list_snoc_item(xs: acc, item: binder_edge(name: b.name, type_node: b.at))
  })
  let minted: DeclaredParameterList = anonymous_binder_mint_parameter_list(edges: authored)
  fold(minted.edges, init: FunctionValueSignature { domain: no_edges, type_params: no_edges, order: minted.order }, f: fn(acc, e) {
    match e.label {
      StructuralLabel { label: _ } =>
        FunctionValueSignature { domain: list_snoc_item(xs: acc.domain, item: e), type_params: acc.type_params, order: acc.order }
      Authored { name: label } =>
        let tv = fresh_type_variable(path: body_lower_unpositioned_path(), label: label)
        FunctionValueSignature {
          domain: list_snoc_item(xs: acc.domain, item: binder_edge(name: label, type_node: body_lower_function_value_type_var_atom(tv: tv))),
          type_params: list_snoc_item(xs: acc.type_params, item: Edge { label: Authored { name: tv }, target: body_lower_function_value_type_var_atom(tv: tv) }),
          order: acc.order
        }
      Positional =>
        FunctionValueSignature { domain: list_snoc_item(xs: acc.domain, item: e), type_params: acc.type_params, order: acc.order }
    }
  })
}

fn body_lower_unpositioned_path() -> List<Int> {
  let unpositioned: List<Int> = []
  unpositioned
}

// POSITIONING FRESH TYPE VARIABLES BY STRUCTURAL PATH, ONCE PER DECLARATION. A function value is
// lowered through the general fold, which does not know where in its declaration it sits, so its
// fresh type variables are minted unpositioned. The declaration's lowering, the one place that holds
// the declaration's body root, walks that body ONCE, top-down, carrying the child-position path as a
// value, and renames each function-value Arrow's variables to the positioned mint
// (fresh_type_variable(path, label)). The rename is local to the Arrow: its variables occur only in
// its own domain targets, codomain and type-parameter list -- a body carries no type position -- so
// no reference elsewhere needs rewriting. Linear in the body: each node is visited once.
type FunctionValuePositionAcc {
  index: Int
  edges: List<Edge>
}

fn body_lower_position_function_values(node: Node, path: List<Int>) -> Node {
  let here = body_lower_position_function_value_arrow(node: node, path: path)
  let no_edges: List<Edge> = []
  let rebuilt = fold(here.children, init: FunctionValuePositionAcc { index: 0, edges: no_edges }, f: fn(acc, e) {
    FunctionValuePositionAcc {
      index: acc.index + 1,
      edges: list_snoc_item(xs: acc.edges, item: Edge {
          label: e.label,
          target: body_lower_position_function_values(node: e.target, path: list_snoc_item(xs: path, item: acc.index))
        })
    }
  })
  node_with_occurrence_id(kind: here.kind, children: rebuilt.edges, occurrence_id: here.occurrence_id)
}

// An Arrow whose type parameters are unpositioned fresh variables is a function value's; any other
// node is returned as is. Its renaming: each domain edge's variable becomes
// fresh_type_variable(path, the edge's label); an unwritten return becomes
// fresh_return_type_variable(path).
fn body_lower_position_function_value_arrow(node: Node, path: List<Int>) -> Node {
  match node.kind {
    TypeNode { connective: Arrow } =>
      let renames = body_lower_fresh_type_variable_renames(arrow: node, path: path)
      if body_lower_arrow_declares_a_renamed_type_param(arrow: node, renames: renames) {
        node_with_occurrence_id(
          kind: node.kind,
          children: fold(node.children, init: body_lower_no_type_param_edges(), f: fn(acc, e) {
            list_snoc_item(xs: acc, item: Edge { label: e.label, target: body_lower_rename_fresh_type_variables(node: e.target, renames: renames, arrow_body: body_lower_edge_is_arrow_body(e: e)) })
          }),
          occurrence_id: node.occurrence_id
        )
      } else {
        node
      }
    TypeNode { connective: Atom { identity: _ } } => node
    TypeNode { connective: Conj } => node
    TypeNode { connective: Disj } => node
    TypeNode { connective: Cardinality } => node
    TypeNode { connective: Instantiation } => node
    ComputationNode { behavior: _ } => node
  }
}

// WHETHER AN ARROW IS AN UNPOSITIONED FUNCTION VALUE IS DECIDED BY CONSTRUCTION, NOT BY READING A
// NAME BACK. The rename map is built from the Arrow's OWN domain labels: its keys are exactly the
// unpositioned variables the producer minted for those binders (and for an unwritten return). The
// Arrow is renamed when it declares one of those keys as a type parameter -- symbol equality with
// names built from its structure, never a parse of a spelling. A named fn's authored `<T>` can never
// equal one: the minted spelling is unauthorable.
fn body_lower_arrow_declares_a_renamed_type_param(arrow: Node, renames: Map<Symbol, Symbol>) -> Bool {
  fold(type_param_names(n: arrow), init: false, f: fn(acc, name) {
    acc || (match map_lookup(m: renames, key: name) {
      Present { value: _ } => true
      Absent => false
    })
  })
}

fn body_lower_edge_is_arrow_body(e: Edge) -> Bool {
  edge_is_core(e: e, marker: ArrowBodyEdge)
}

fn body_lower_fresh_type_variable_renames(arrow: Node, path: List<Int>) -> Map<Symbol, Symbol> {
  let with_return: Map<Symbol, Symbol> = map_insert(
    m: empty_map(),
    key: fresh_return_type_variable(path: body_lower_unpositioned_path()),
    value: fresh_return_type_variable(path: path)
  )
  match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
    Present { value: domain } => body_lower_fresh_type_variable_domain_renames(edges: domain.children, path: path, init: with_return)
    Absent => with_return
  }
}

fn body_lower_fresh_type_variable_domain_renames(edges: List<Edge>, path: List<Int>, init: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  fold(edges, init: init, f: fn(acc, e) {
    match e.label {
      StructuralLabel { label: _ } => acc
      Authored { name: l } =>
        map_insert(m: acc, key: fresh_type_variable(path: body_lower_unpositioned_path(), label: l), value: fresh_type_variable(path: path, label: l))
      Positional => acc
    }
  })
}

// Renames fresh variables in the Arrow's own signature: an atom, a record's edge targets, and the
// type-parameter list's labels and targets. The body edge is left to the outer walk.
//
// A TYPE-PARAMETER BINDER SET IS RE-MINTED, NOT EDITED. Its declared order (one
// ^arrow_signature_order_edge, v2.std.node type_binder_conj_conforms) is a projection of its binder
// labels; renaming the labels in place while leaving that projection alone produced a set whose order
// named the unpositioned variables and whose binders named the positioned ones, so every function
// value and fold step failed post-normalize well-formedness (the #13038 regression, reverted by
// #13293). The renamed binders go back through type_binder_set_children, the one mint of a set and
// its order, so the two are one fact again.
fn body_lower_rename_fresh_type_variables(node: Node, renames: Map<Symbol, Symbol>, arrow_body: Bool) -> Node {
  if arrow_body {
    node
  } else {
    match node.kind {
      TypeNode { connective: Atom { identity: id } } =>
        match map_lookup(m: renames, key: id) {
          Present { value: renamed } => node_synthetic(kind: TypeNode { connective: Atom { identity: renamed } }, children: [])
          Absent => node
        }
      TypeNode { connective: Conj } =>
        let renamed_edges = fold(node.children, init: body_lower_no_type_param_edges(), f: fn(acc, e) {
          if edge_is_core(e: e, marker: ArrowSignatureOrderEdge) {
            acc
          } else {
            let label = match e.label {
              StructuralLabel { label: _ } => e.label
              Authored { name: n } =>
                match map_lookup(m: renames, key: n) {
                  Present { value: renamed } => Authored { name: renamed }
                  Absent => e.label
                }
              Positional => e.label
            }
            list_snoc_item(xs: acc, item: Edge { label: label, target: body_lower_rename_fresh_type_variables(node: e.target, renames: renames, arrow_body: false) })
          }
        })
        node_with_occurrence_id(
          kind: node.kind,
          children: if body_lower_conj_carries_declared_order(node: node) { type_binder_set_children(binders: renamed_edges, source: node) } else { renamed_edges },
          occurrence_id: node.occurrence_id
        )
      TypeNode { connective: Disj } => node
      TypeNode { connective: Arrow } => node
      TypeNode { connective: Cardinality } => node
      TypeNode { connective: Instantiation } => node
      ComputationNode { behavior: _ } => node
    }
  }
}

fn body_lower_conj_carries_declared_order(node: Node) -> Bool {
  fold(node.children, init: false, f: fn(acc, e) { acc || edge_is_core(e: e, marker: ArrowSignatureOrderEdge) })
}

fn body_lower_function_value_arrow(
  shell: Node,
  binders: List<FunctionValueBinder>,
  codomain: FunctionValueCodomain,
  body: Node
) -> Outcome<Node> {
  match body_lower_reify_arrow_body(body: body) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: reified, diagnostics: bd } =>
      let sig = body_lower_function_value_signature(binders: binders)
      let return_tv = fresh_return_type_variable(path: body_lower_unpositioned_path())
      let codomain_node = match codomain {
        CodomainAuthored { type_node: t } => t
        CodomainElided => body_lower_function_value_type_var_atom(tv: return_tv)
      }
      let type_params = match codomain {
        CodomainAuthored { type_node: _ } => sig.type_params
        CodomainElided =>
          list_append(
            left: sig.type_params,
            right: [Edge { label: Authored { name: return_tv }, target: codomain_node }]
          )
      }
      let no_edges: List<Edge> = []
      let type_param_edges: List<Edge> = match type_params {
        Empty => no_edges
        Cons { head: _, tail: _ } =>
          [type_params_edge(conj: close_lowered_image(root: node_lowered_from(kind: TypeNode { connective: Conj }, children: type_binder_set_children(binders: type_params, source: shell), source: shell)))]
      }
      outcome_with_diagnostics(
        value: body_lower_callable_arrow(
          source: shell,
          domain: Edge {
            label: Positional,
            target: node_lowered_from(kind: TypeNode { connective: Conj }, children: sig.domain, source: shell)
          },
          codomain: codomain_node,
          order_edge: signature_order_edge(order: sig.order, source: shell),
          type_param_edges: type_param_edges,
          body: optional_present(value: reified)
        ),
        diagnostics: bd
      )
  }
}

// CALL ARGUMENTS ARE READ OFF THE GRAMMAR'S OWN COMMA-LIST SHAPE, AND AN UNREAD ARGUMENT REFUSES.
//
// The argument list a call suffix captures is v2.extdeps.languages.dag dag_grammar_arg_list_helper:
// an optional dag_grammar_comma_list_expr over dag_production_arg. So its parse is exactly
//   list   = sequence(first_arg, sequence(repeat, optional trailing comma))
//   repeat = sequence(sequence(optional comma, arg), repeat) | the empty conj
// and each arg is a dag_surface_arg capture, named (`probe: x`) or positional (`x`). The reader
// below walks that shape and nothing else, and every position it cannot read is a located refusal.
//
// THE READER IT REPLACES DROPPED EVERY ARGUMENT OF A PLAIN CALL, SILENTLY. It first asked
// body_lower_param_list_comma_spine_optional -- a reader for a PARAMETER list, whose capture still
// carries its parentheses -- to find a comma spine. An argument capture arrives with the
// parentheses already consumed by body_lower_postfix_call_suffix_args, so that reader answered
// Present on the first argument's own inner sequence, and the guessing collector beneath it then
// found no argument there and returned Empty. Measured on the real tokenize -> parse route at
// b8e0cc4eb9: `{ g(probe: x) }` and `{ g(x) }` both lowered to a call with zero arguments, and
// collecting the same capture without the spine step yielded one. Every Absent arm of that
// collector folded to Empty or to a skipped element, so nothing downstream -- the reference-site
// collector, the resolver -- could see a name used only as a call argument
// (gunbc.recurring_failure_mode call_expression_erased_at_v2_body_lowering).
//
// AN ARGUMENT'S VALUE IS LOWERED AS A VALUE, NOT READ AS AN OPERAND. The operand reader recognises
// atoms, literals, dotted references and operator expressions; a nested call, a list or record
// literal, a caret symbol or a parenthesised group is not an operand, so when gunbc#12145 stopped
// that reader narrowing a sequence to its left element -- which had answered `h(q: a)` with `h`
// and `[a]` with `[` -- every such argument became call_argument_unread and its whole module
// refused normalize. The value goes through body_lower_value_lowered, the reader field
// initializers and if-conditions use (the bottom-up fold, then the walker), and the operand reader
// only for what that declines; an argument neither reads is still a located refusal, and a
// refusal either raises is the argument's.
//
// A LIST LITERAL IN THE VALUE LOWERS WITH IT. An argument whose value is or contains `[e1, .., en]`
// once refused its whole module (body_lowering_reason_list_literal_unlowered), because body lowering
// had no lowered form for the literal. The literal's producer is now body_lower_list_literal, reached
// from body_lower_primary_expr, so the value reader below lowers it here exactly as in any other
// value position; no argument-specific list handling remains.
fn body_lower_arg_value_read(arg_capture: Node, value_capture: Node) -> Outcome<Node> {
  match body_lower_value_lowered(node: value_capture) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Present { value: lowered }, diagnostics: d } =>
      outcome_with_diagnostics(value: lowered, diagnostics: d)
    Accepted { value: Absent, diagnostics: _ } =>
      match body_lower_arg_operand_read(arg_capture: value_capture) {
        OperandRefLowered { lowered: operand } => outcome_accepted(value: operand)
        OperandRefAbsent =>
          outcome_rejected(
            d: body_lower_diagnostic(reason: ^body_lowering_reason_call_argument_unread, n: arg_capture)
          )
        OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
      }
  }
}

// ONE ACTUAL, AS THE EDGE THE APPLICATION CARRIES IT ON: `name: value` is a Named edge whose label is
// the parameter name, `value` a Positional edge. Named arguments reuse the Named edge the Arrow
// domain already keys its binders by -- no new edge kind (ruling neat-boar-16 via gentle-koi-724,
// 2026-09-26). Before this the label was read and dropped -- a declared reference-conservation drop,
// retired with this change -- and every actual bound by position.
fn body_lower_call_arg_edge(arg_capture: Node) -> Outcome<Edge> {
  if body_lower_call_arg_capture_is_named(arg_capture: arg_capture) {
    match body_lower_named_arg_capture_optional(arg_capture: arg_capture) {
      Present { value: named } =>
        bind_outcome(
          o: body_lower_arg_value_read(arg_capture: arg_capture, value_capture: named.value),
          f: fn(value) { outcome_accepted(value: Edge { label: Authored { name: named.label }, target: value }) }
        )
      Absent =>
        outcome_rejected(
          d: body_lower_diagnostic(reason: ^body_lowering_reason_call_argument_unread, n: arg_capture)
        )
    }
  } else {
    bind_outcome(
      o: body_lower_arg_value_read(arg_capture: arg_capture, value_capture: arg_capture),
      f: fn(value) { outcome_accepted(value: Edge { label: Positional, target: value }) }
    )
  }
}

// THE COMMA-LIST SHAPE, READ ONCE. Every dag_grammar_comma_list_expr parse -- call arguments, field
// declarations, field patterns, field initializers, positional patterns, fn-type domains -- is
//   list   = sequence(first_item, sequence(repeat, optional trailing comma))
//   repeat = sequence(sequence(optional comma, item), repeat) | the empty conj
// and this walker reads that shape and nothing else, answering the raw item captures in order. Each
// consumer maps its own item. A position it cannot read refuses with the caller's shape cause, so
// call arguments keep body_lowering_reason_call_argument_list_shape_unread exactly as gunbc#12108
// introduced it. The walk was #12108's, fused with argument lowering; it is split out so field and
// pattern lists read the same shape through the same code instead of a second walker.
fn body_lower_comma_list_child(list: Node, name: Symbol, shape_refusal: Symbol) -> Outcome<Node> {
  match find_named_child(root: list, name: name) {
    Accepted { value: child, diagnostics: _ } =>
      outcome_accepted(value: body_lower_deep_unwrap_optional(node: child))
    Rejected { diagnostics: _ } =>
      outcome_rejected(d: body_lower_diagnostic(reason: shape_refusal, n: list))
  }
}

fn body_lower_comma_list_repeat_items(repeat_capture: Node, shape_refusal: Symbol) -> Outcome<List<Node>> {
  if is_empty_conj_root(n: repeat_capture) {
    outcome_accepted(value: Empty)
  } else {
    bind_outcome(
      o: body_lower_comma_list_child(list: repeat_capture, name: ^grammar_sequence_left_node_projection, shape_refusal: shape_refusal),
      f: fn(element) {
        bind_outcome(
          o: body_lower_comma_list_child(list: element, name: ^grammar_sequence_right_node_projection, shape_refusal: shape_refusal),
          f: fn(item) {
            bind_outcome(
              o: body_lower_comma_list_child(list: repeat_capture, name: ^grammar_sequence_right_node_projection, shape_refusal: shape_refusal),
              f: fn(rest) {
                bind_outcome(
                  o: body_lower_comma_list_repeat_items(repeat_capture: rest, shape_refusal: shape_refusal),
                  f: fn(items) { outcome_accepted(value: Cons { head: item, tail: items }) }
                )
              }
            )
          }
        )
      }
    )
  }
}

fn body_lower_comma_list_items(list_capture: Node, shape_refusal: Symbol) -> Outcome<List<Node>> {
  let list = body_lower_deep_unwrap_optional(node: list_capture)
  if is_empty_conj_root(n: list) {
    outcome_accepted(value: Empty)
  } else {
    bind_outcome(
      o: body_lower_comma_list_child(list: list, name: ^grammar_sequence_left_node_projection, shape_refusal: shape_refusal),
      f: fn(first) {
        bind_outcome(
          o: body_lower_comma_list_child(list: list, name: ^grammar_sequence_right_node_projection, shape_refusal: shape_refusal),
          f: fn(after_first) {
            bind_outcome(
              o: body_lower_comma_list_child(list: after_first, name: ^grammar_sequence_left_node_projection, shape_refusal: shape_refusal),
              f: fn(repeat_capture) {
                bind_outcome(
                  o: body_lower_comma_list_repeat_items(repeat_capture: repeat_capture, shape_refusal: shape_refusal),
                  f: fn(rest) { outcome_accepted(value: Cons { head: first, tail: rest }) }
                )
              }
            )
          }
        )
      }
    )
  }
}

// The consumers that refuse under their own cause read the shape through this adapter: Absent is
// "not a comma list", and each such caller already turns Absent into its own located refusal.
fn body_lower_comma_list_items_optional(list_capture: Node) -> Optional<List<Node>> {
  match body_lower_comma_list_items(list_capture: list_capture, shape_refusal: ^body_lowering_reason_call_argument_list_shape_unread) {
    Accepted { value: items, diagnostics: _ } => optional_present(value: items)
    Rejected { diagnostics: _ } => Absent
  }
}

// Call arguments: the shape is read first, then each argument lowers in order and the first that
// cannot refuses. (Before the split, a shape defect after an unreadable argument reported the
// argument first; with both present the shape refusal now reports first. Either is a refusal.)
// THE ACTUALS, IN AUTHORED ORDER: a positional prefix, then named actuals (v2.std.node Transform
// discipline PositionalPrefixThenLabeled). Two shapes have no well-formed application and refuse
// here, each located at the actual that makes it so: a positional actual after a named one (its slot
// would depend on which names came before it -- v1 eval_call refuses the same conflict at binding),
// and a label written twice. An unknown label is not decidable here -- it needs the callee's domain
// -- and refuses at infer.
type BodyLowerCallArgsAcc {
  edges: List<Edge>
  labels: List<Symbol>
  seen_named: Bool
}

fn body_lower_call_arg_edges(items: List<Node>) -> Outcome<List<Edge>> {
  bind_outcome(
    o: fold(items, init: outcome_accepted(value: BodyLowerCallArgsAcc { edges: Empty, labels: Empty, seen_named: false }), f: fn(acc, item) {
      bind_outcome(o: acc, f: fn(state) {
        bind_outcome(o: body_lower_call_arg_edge(arg_capture: item), f: fn(edge) {
          match edge.label {
            StructuralLabel { label: _ } =>
              outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_call_argument_list_shape_unread, n: item)
              )
            Positional =>
              if state.seen_named {
                outcome_rejected(
                  d: body_lower_diagnostic(reason: ^body_lowering_reason_positional_argument_after_named, n: item)
                )
              } else {
                outcome_accepted(value: BodyLowerCallArgsAcc {
                  edges: list_snoc_item(xs: state.edges, item: edge),
                  labels: state.labels,
                  seen_named: false
                })
              }
            Authored { name: label } =>
              if body_lowering_surface_identity_list_contains(xs: state.labels, target: label) {
                outcome_rejected(
                  d: body_lower_diagnostic(reason: ^body_lowering_reason_argument_label_repeated, n: item)
                )
              } else {
                outcome_accepted(value: BodyLowerCallArgsAcc {
                  edges: list_snoc_item(xs: state.edges, item: edge),
                  labels: list_snoc_item(xs: state.labels, item: label),
                  seen_named: true
                })
              }
          }
        })
      })
    }),
    f: fn(state) { outcome_accepted(value: state.edges) }
  )
}

fn body_lower_call_args_from_capture(args_capture: Node) -> Outcome<List<Edge>> {
  bind_outcome(
    o: body_lower_comma_list_items(list_capture: args_capture, shape_refusal: ^body_lowering_reason_call_argument_list_shape_unread),
    f: fn(items) { body_lower_call_arg_edges(items: items) }
  )
}

fn body_lower_primary_call_suffix_optional(root: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: root)
  match body_lower_postfix_call_suffix_args(call_suffix: stripped) {
    Present { value: _ } => optional_present(value: stripped)
    Absent =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_primary_call_suffix_optional(root: e.target)
        }
      })
  }
}

fn body_lower_call_sequence_node(node: Node) -> Node {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_primary_expr {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } => captured
          Absent => stripped
        }
      } else {
        stripped
      }
    Absent => stripped
  }
}

fn body_lower_call_callee_read(node: Node) -> OperandRefRead {
  match body_lower_operand_ref_read(node: node) {
    OperandRefAbsent => OperandRefAbsent
    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
    OperandRefLowered { lowered: callee } =>
      match node_atom_identity_optional(node: callee) {
        Present { value: id } =>
          if dag_lex_token_symbol(sym: id) {
            OperandRefAbsent
          } else {
            OperandRefLowered { lowered: callee }
          }
        Absent => OperandRefLowered { lowered: callee }
      }
  }
}

fn body_lower_try_primary_ident_call(node: Node) -> Outcome<Optional<Node>> {
  let stripped = body_lower_call_sequence_node(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: pair } =>
      match body_lower_call_callee_read(node: pair.left) {
        OperandRefAbsent => outcome_accepted(value: optional_absent())
        OperandRefLowered { lowered: callee_atom } =>
          match body_lower_primary_call_suffix_optional(root: pair.right) {
            Absent => outcome_accepted(value: optional_absent())
            Present { value: call_suffix } =>
              match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
                Present { value: args_read } =>
                  bind_outcome(
                    o: args_read,
                    f: fn(args) {
                      outcome_accepted(
                        value: optional_present(
                          value: body_lower_transform_call(
                            operator: callee_atom,
                            args: args
                          )
                        )
                      )
                    }
                  )
                Absent => outcome_accepted(value: optional_absent())
              }
          }
        OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
      }
  }
}

// Absent: not a call suffix. Present: a call suffix, whose arguments are read or refused.
fn body_lower_postfix_call_suffix_args(call_suffix: Node) -> Optional<Outcome<List<Edge>>> {
  match sugar_sequence_pair_optional(node: call_suffix) {
    Absent => Absent
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Present { value: id } =>
          if id == ^dag_token_lparen {
            match sugar_sequence_pair_optional(node: pair.right) {
              Absent =>
                optional_present(
                  value: outcome_rejected(
                    d: body_lower_diagnostic(
                      reason: ^body_lowering_reason_call_argument_list_shape_unread,
                      n: call_suffix
                    )
                  )
                )
              Present { value: inner } =>
                optional_present(
                  value: body_lower_call_args_from_capture(
                    args_capture: body_lower_postfix_optional_unwrap(node: inner.left)
                  )
                )
            }
          } else {
            Absent
          }
        Absent => Absent
      }
  }
}

// The step's method or field name alone, for a reader that needs only the spelling (the
// complexity lens). A projection of the step reader below, not a second reader of the step.
fn body_lower_postfix_projection_step_name(repeat_elem: Node) -> Optional<Symbol> {
  match body_lower_postfix_projection_step(repeat_elem: repeat_elem) {
    Present { value: atom } => node_atom_identity_optional(node: atom)
    Absent => optional_absent()
  }
}

fn body_lower_postfix_projection_step(repeat_elem: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => Absent
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Present { value: id } =>
          if id == ^dag_token_dot {
            match sugar_sequence_pair_optional(node: pair.right) {
              Absent => Absent
              Present { value: after_dot } =>
                match body_lower_param_binding_atom_optional(node: after_dot.left) {
                  Present { value: method } => optional_present(value: method)
                  Absent => Absent
                }
            }
          } else {
            Absent
          }
        Absent => Absent
      }
  }
}

// A DOTTED REFERENCE IS ONE MENTION, AND ITS LOWERED SHAPE IS THE QUALIFIED-NAME SPINE.
//
// `v2.test.p.value` in a body and `v2.test.p.T` in a type position are the same thing the language
// model already names for the module header and every hand-built resolver fixture: a qualified name,
// carried as the fold_list spine v2.std.qualified_name qualified_name_from_node folds and
// v2.compiler.resolve try_resolve_qualified_name_node resolves. Before these readers nothing in the
// v2 front end constructed that spine from source -- a body chain lowered to a two-operand infix
// over the first dot and a type-position chain to its first atom -- so the resolver's qualified arm
// and v2.compiler.reference_site_collector's qualified class had a consumer and no producer.
//
// LOWERING DOES NOT DECIDE WHAT THE CHAIN DENOTES. `r.v` over a parameter and `a.b.C` over a
// module path are one relation, syntactic containment (docs/plans/namespace-resolution-design.md
// section 3), and the resolver's unique-on-chain rule (section 13) resolves the FIRST segment on
// the ancestor chain and projects the rest. Deciding here would be a second resolver with no scope
// to consult. So every chain of bare segments lowers to the one spine, and the resolver is where
// the answer lives.
//
// WHAT THE RESOLVER ANSWERS TODAY, STATED AT ITS ACTUAL RUNG (reviews 67513, 67651 and 67708 on
// gunbc#11582): the spine REACHES try_resolve_qualified_name_node and every verdict it raises is a
// located refusal -- the module-path class is FOUND by the corpus-root absolute lookup and then
// refused identity-unrepresentable (a fn is a declaration, not a symbol, and the resolver carries
// no exact declaring identity yet); a chain whose head is bound on the ancestor chain refuses
// Unbound (the unique-on-chain projection is UNFIRED) or Ambiguous when the absolute read also
// hits (section 13's two binders), never the absolute read silently winning. Nothing Accepts a
// qualified chain today. Neither refusal is a regression of this arm: on the production route
// `r.v` never reached the projection refusal below -- the infix arm preempted it, lowered it to
// Transform(dot, r, v), and resolve refused the bare `v`. Both standings are enrolled in
// v2.test.claim.namespace_xl0.cross_module_reference_resolution; the local-receiver row there is a
// NEGATIVE control (`Bool` has no child `v`) and is retired by nothing. The lowering does not
// compensate by keeping a local-receiver chain out of the spine: that would be the second
// resolver this header refuses to be.
//
// THE SHAPE IS BUILT BY fold_list_node AND NOWHERE ELSE, so a spine label rename cannot fork the
// producer from the fold that reads it. The spine root carries the source occurrence, because the
// resolver's canonical atom takes its occurrence from the root it replaces; the segment atoms are
// the mention's spelling, not mentions of their own (the collector says the same).
//
// SCOPE, STATED SO THE NEXT CLASS IS NOT MISTAKEN FOR THIS ONE. The walk below admits a chain whose
// every suffix slot is EMPTY (the spine) and a chain whose LAST segment carries a CALL suffix
// (`a.b.f(x)`: a Transform whose operator is the spine, the call class
// gunbc.recurring_failure_mode call_expression_erased_at_v2_body_lowering read off the same walk).
// A call on a NON-final segment (`a.f().b`) is named by the walk and DECLINED: it is live corpus
// idiom the existing arms still erase (the receipt is on the class row; see DottedChainTailRead).
// A brace record suffix (`a.b.C { f: v }`) is a construction, lowered by the chain fold's
// PostfixRecord step, and an `as` suffix is a cast step; neither is read by this head reader.
fn body_lower_dotted_head_atom_optional(node: Node) -> Optional<Node> {
  match node_atom_identity_optional(node: node) {
    Present { value: sym } =>
      if dag_lex_token_symbol(sym: sym) {
        optional_absent()
      } else {
        optional_present(value: node_lowered_from(kind: TypeNode { connective: Atom { identity: sym } }, children: [], source: node))
      }
    Absent =>
      match parse_production_emitted_identity_optional(node: node) {
        Present { value: id } =>
          if id == ^dag_surface_primary_expr {
            match parse_production_captured_child_optional(node: node) {
              Present { value: captured } =>
                match sugar_sequence_pair_optional(node: captured) {
                  Present { value: pair } =>
                    if is_empty_conj_root(n: body_lower_postfix_optional_unwrap(node: pair.right)) {
                      body_lower_dotted_head_atom_optional(node: pair.left)
                    } else {
                      optional_absent()
                    }
                  Absent => body_lower_dotted_head_atom_optional(node: captured)
                }
              Absent => optional_absent()
            }
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

// ONE WALK OVER THE CHAIN'S TAIL, READ BY EVERY DOTTED READER. Every repeat element must be a
// dot-projection step; its suffix slot is either EMPTY (a bare segment) or a PAREN CALL (an
// argument row). A brace record suffix is the PostfixRecord step, and any other suffix kind is
// not this shape and the walk declines so the existing arms run unchanged.
//
// WHAT CHANGED HERE AND WHY (gunbc#12033's PR2, DESIGN 6b). The walk used to admit a call ONLY on
// the FINAL segment and answered DottedChainCallBeforeEnd for anything else, which the readers
// declined to the pre-existing arms. Those arms read ONE repeat element and then decided, so the
// declined chains lost everything after the first step: `shell.Env.Get(name: n).value` reached the
// old body_lower_try_postfix_projection, whose first element `.Env` carries no call suffix, and
// REFUSED postfix_field_access_refused; `fields.skip(n: i).first()` built Transform(skip, fields, i)
// and DROPPED `.first()` with no diagnostic at all. One boundary, two outcomes, and the silent one
// is the worse: DESIGN 4b puts silent wrongness below the ladder rather than on it. The repair is
// not a guard at either symptom -- it is that a postfix chain is a SEQUENCE of steps and was being
// read as one step. This walk now collects the whole sequence and body_lower_postfix_chain_fold
// folds it left-associatively, so both outcomes are removed by the same construction.
//
// A SECOND WALKER WOULD BE A SECOND AUTHORITY for "this is a dotted chain" (review 67903 on
// gunbc#11612 refused exactly that fork), so the operand reading, the spine reading and the
// general fold all consume THIS answer and differ only in what they build from it.
//
// A CAST IS A STEP OF THE SAME SEQUENCE. postfix_expr's repeat is choice(dot_suffix, as_suffix), so
// `a.b as T`, `(x as T).f` and `x as A as B` are chains whose steps interleave projections and
// casts, and the fold eliminates the accumulator with each in order: a cast step wraps what
// precedes it in the typed cast node (body_lower_cast_node). The step carries the AUTHORED type
// expression; the fold lowers it, and a type expression the lowering cannot read refuses
// body_lowering_reason_type_annotation_not_carried located at it, never dropped.
type PostfixStep
  = PostfixProjection { segment: Node, call_elem: Optional<Node> }
  | PostfixCast { target: Node }
  | PostfixRecord { segment: Node, items: List<Node> }

// THE THIRD ARM CARRIES THE SUFFIX KINDS THIS LOWERING CANNOT READ. A dot-projection step whose
// suffix slot is neither empty, a paren call, nor a brace record body reaches PostfixChainSuffixCarried.
// The brace record body is NOT in that arm any more: `a.b.C { f: v }` is a PostfixRecord step, and
// the chain fold builds the construct whose tag is the whole path (v2.std.node_query construct_node),
// the same builder `C { f: v }` reaches from primary_expr -- one production for both heads. What the
// door does with a carried suffix is stated once, on body_lower_postfix_chain_steps_grow below.
//
// WHETHER EVERY STEP IS BARE IS DECIDED ONCE, BY THE READ (review 70331). The read already knows
// each step's suffix kind as it meets it, so it carries that fact in its accumulator
// (PostfixChainAcc) and answers PostfixChainBare with the segments alone when no step carries a
// call. A reader then MATCHES the arm, rather than a Bool predicate over each step's Optional
// re-deriving afterwards what the read had in hand.
type PostfixChainRead
  = PostfixChainBare { segments: List<Node> }
  | PostfixChainFound { steps: List<PostfixStep> }
  | PostfixChainNotThisShape
  | PostfixChainSuffixCarried { at: Node }

// AN UNLOWERED SUFFIX KIND DECLINES, IT DOES NOT REFUSE, AND THE PRECEDENT IS #11683's.
// Refusing a step suffix this lowering cannot read was MEASURED to turn 32 modules that ACCEPT on base
// into refusals, so a carried suffix declines to the pre-existing arms and is COUNTED, not silent:
// the door emits body_lowering_reason_postfix_suffix_carried at HEAD grain (review 70078 on
// gunbc#12057), and the drop from the base refusal is declared as gunbc.rung_drop
// postfix_suffix_step_declined_to_the_pre_existing_arms. The brace record body left this population
// when the construct tag became a reference that can carry a qualified path
// (docs/plans/construct-tag-reference-design.md); what remains is re-derived by the workload
// adjudicate, which is that drop's trigger.
fn body_lower_postfix_chain_steps_grow(
  repeat_capture: Node,
  grown: PostfixChainAcc
) -> PostfixChainRead {
  match body_lower_seq_child(node: repeat_capture, name: ^grammar_sequence_right_node_projection) {
    Present { value: rest_capture } =>
      body_lower_postfix_chain_steps_read(repeat_capture: rest_capture, acc: grown)
    Absent => body_lower_postfix_chain_acc_finish(acc: grown)
  }
}

// The read's accumulator: every step so far bare (the segments alone), or a call seen (the steps).
type PostfixChainAcc
  = PostfixChainAccBare { segments: List<Node> }
  | PostfixChainAccCalled { steps: List<PostfixStep> }

fn body_lower_postfix_bare_steps(segments: List<Node>) -> List<PostfixStep> {
  fold(segments, init: Empty, f: fn(acc, segment) {
    list_snoc_item(xs: acc, item: PostfixProjection { segment: segment, call_elem: optional_absent() })
  })
}

fn body_lower_postfix_chain_acc_bare_step(acc: PostfixChainAcc, segment: Node) -> PostfixChainAcc {
  match acc {
    PostfixChainAccBare { segments: segments } =>
      PostfixChainAccBare { segments: list_snoc_item(xs: segments, item: segment) }
    PostfixChainAccCalled { steps: steps } =>
      PostfixChainAccCalled {
        steps: list_snoc_item(xs: steps, item: PostfixProjection { segment: segment, call_elem: optional_absent() })
      }
  }
}

fn body_lower_postfix_chain_acc_call_step(
  acc: PostfixChainAcc,
  segment: Node,
  call_elem: Node
) -> PostfixChainAcc {
  let step = PostfixProjection { segment: segment, call_elem: optional_present(value: call_elem) }
  match acc {
    PostfixChainAccBare { segments: segments } =>
      PostfixChainAccCalled {
        steps: list_snoc_item(xs: body_lower_postfix_bare_steps(segments: segments), item: step)
      }
    PostfixChainAccCalled { steps: steps } =>
      PostfixChainAccCalled { steps: list_snoc_item(xs: steps, item: step) }
  }
}

// A cast closes a bare spine the way a call does: what follows it is a value, never a path segment.
fn body_lower_postfix_chain_acc_cast_step(acc: PostfixChainAcc, target: Node) -> PostfixChainAcc {
  body_lower_postfix_chain_acc_closing_step(acc: acc, step: PostfixCast { target: target })
}

// A record body closes the spine too: `a.b.C { f: v }` is a construct VALUE whose tag is the whole
// path, and any step after it eliminates that value.
fn body_lower_postfix_chain_acc_closing_step(acc: PostfixChainAcc, step: PostfixStep) -> PostfixChainAcc {
  match acc {
    PostfixChainAccBare { segments: segments } =>
      PostfixChainAccCalled {
        steps: list_snoc_item(xs: body_lower_postfix_bare_steps(segments: segments), item: step)
      }
    PostfixChainAccCalled { steps: steps } =>
      PostfixChainAccCalled { steps: list_snoc_item(xs: steps, item: step) }
  }
}

fn body_lower_postfix_chain_acc_finish(acc: PostfixChainAcc) -> PostfixChainRead {
  match acc {
    PostfixChainAccBare { segments: segments } => PostfixChainBare { segments: segments }
    PostfixChainAccCalled { steps: steps } => PostfixChainFound { steps: steps }
  }
}

fn body_lower_postfix_chain_steps_read(
  repeat_capture: Node,
  acc: PostfixChainAcc
) -> PostfixChainRead {
  if is_empty_conj_root(n: repeat_capture) {
    body_lower_postfix_chain_acc_finish(acc: acc)
  } else {
    match body_lower_postfix_repeat_head_optional(repeat_capture: repeat_capture) {
      Absent => PostfixChainNotThisShape
      Present { value: repeat_elem } =>
        match body_lower_as_suffix_type_optional(repeat_elem: repeat_elem) {
          Present { value: target } =>
            body_lower_postfix_chain_steps_grow(
              repeat_capture: repeat_capture,
              grown: body_lower_postfix_chain_acc_cast_step(acc: acc, target: target)
            )
          Absent =>
        match body_lower_postfix_projection_step(repeat_elem: repeat_elem) {
          Absent => PostfixChainNotThisShape
          Present { value: segment } =>
            match body_lower_postfix_suffix_read(repeat_elem: repeat_elem) {
              PostfixSuffixNone => PostfixChainNotThisShape
              PostfixSuffixUnlowered => PostfixChainSuffixCarried { at: repeat_elem }
              PostfixSuffixEmpty =>
                body_lower_postfix_chain_steps_grow(
                  repeat_capture: repeat_capture,
                  grown: body_lower_postfix_chain_acc_bare_step(acc: acc, segment: segment)
                )
              PostfixSuffixCall =>
                body_lower_postfix_chain_steps_grow(
                  repeat_capture: repeat_capture,
                  grown: body_lower_postfix_chain_acc_call_step(
                    acc: acc,
                    segment: segment,
                    call_elem: repeat_elem
                  )
                )
              PostfixSuffixRecord { items: items } =>
                body_lower_postfix_chain_steps_grow(
                  repeat_capture: repeat_capture,
                  grown: body_lower_postfix_chain_acc_closing_step(
                    acc: acc,
                    step: PostfixRecord { segment: segment, items: items }
                  )
                )
            }
        }
        }
    }
  }
}

// THE SPINE IS AN IMAGE OF ITS SOURCE, SO IT CLOSES (v2.std.node close_lowered_image). The root
// keeps the whole mention's minted occurrence. A segment lowered from that same token -- the
// one-segment reference body_lower_bare_tag_reference builds, where the tag token is both the
// mention and its only segment -- is a structurally different member under that one occurrence,
// so it becomes pending and is allocated an OccurrenceProjected caused by the root. Segments lowered
// from their own tokens carry their own minted occurrences and are not members of this image.
fn body_lower_qualified_name_spine_node(segments: List<Node>, source: Node) -> Node {
  close_lowered_image(root: qualified_name_spine_of_atoms(atoms: segments, occurrence_id: source.occurrence_id))
}

fn body_lower_postfix_chain_read(node: Node) -> PostfixChainRead {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => PostfixChainNotThisShape
    Present { value: pair } =>
      match body_lower_postfix_chain_steps_read(
        repeat_capture: pair.right,
        acc: PostfixChainAccBare { segments: Empty }
      ) {
        PostfixChainNotThisShape => PostfixChainNotThisShape
        PostfixChainSuffixCarried { at: at } => PostfixChainSuffixCarried { at: at }
        PostfixChainFound { steps: steps } => PostfixChainFound { steps: steps }
        PostfixChainBare { segments: segments } =>
          match segments {
            Empty => PostfixChainNotThisShape
            Cons { head: _, tail: _ } => PostfixChainBare { segments: segments }
          }
      }
  }
}

// The operand reader's presentation: the spine alone. A call is an expression, not
// an operand reference, and the expression sites read those through
// body_lower_dotted_chain_lowered_optional. A chain with a computed head is likewise not an
// operand reference: the head is an expression.
//
// WHERE THE CARRIED-SUFFIX RESIDUE IS COUNTED, AND WHERE IT IS NOT (review 70146, non-blocking).
// This reader answers PostfixChainSuffixCarried with optional_absent() and NO diagnostic: its
// Optional<Node> return has no slot for one, and its single caller
// (body_lower_operand_ref_optional) then falls back to reading the chain's HEAD, so a
// brace-suffixed chain reached ONLY through operand position is truncated silently rather than
// counted. The counting site is the expression door, which emits
// body_lowering_reason_postfix_suffix_carried once per occurrence; that is deliberate, because
// counting at both would double-count the same residue. NEITHER THE REVIEWER NOR THIS AUTHOR
// COULD CONSTRUCT A ROUTE where the operand reader is the SOLE reader of such a chain, so the
// gap is stated rather than closed: closing it means giving this reader an Outcome, which is a
// type change across every operand site and is not warranted for a route nobody can reach. If
// such a route is ever exhibited, this is the sentence that says what to do about it.
fn body_lower_dotted_reference_optional(node: Node) -> Optional<Node> {
  match body_lower_postfix_chain_read(node: node) {
    PostfixChainNotThisShape => optional_absent()
    PostfixChainSuffixCarried { at: _ } => optional_absent()
    PostfixChainFound { steps: _ } => optional_absent()
    PostfixChainBare { segments: segments } =>
      match body_lower_dotted_head_atom_optional(
        node: body_lower_postfix_chain_head_or_self(node: node)
      ) {
        Absent => optional_absent()
        Present { value: head } =>
          optional_present(
            value: body_lower_qualified_name_spine_node(
              segments: Cons { head: head, tail: segments },
              source: node
            )
          )
      }
  }
}

fn body_lower_postfix_chain_head_or_self(node: Node) -> Node {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => stripped
    Present { value: pair } => pair.left
  }
}

// THE ACCUMULATOR. A chain is read left to right and each step folds onto what precedes it.
// While no call has been seen and the head was a bare symbol the accumulator is a SPINE of
// segments -- that is today's contract, and it is kept exactly: `a.b.c` is one qualified name and
// v2.compiler.resolve try_resolve_qualified_name_node decides what its head denotes, because
// deciding here would be a second resolver with no scope to consult. The FIRST call suffix closes
// the spine into a Transform through it (`a.b.f(x)`: the whole path is the callee, today's
// final-segment rule applied to the prefix instead of only to the whole chain). After that the
// accumulator is a VALUE, and every further step is an elimination of it: a call suffix is a
// method call whose first operand is the accumulated value, an empty suffix is a FIELD PROJECTION
// (v2.std.node_query field_projection_node).
//
// WHY A PROJECTION OFF A VALUE CANNOT BE A SPINE CASE, which is the cheaper repair a reader will
// reach for: a spine is a path of NAME segments (v2.std.qualified_name QualifiedName is
// FreeMonoid<Symbol>; the spine carries each segment as the atom lowered from its token), and a
// computed root is not a name at all. This is a separate construct by the structure of the
// carrier, not by preference.
type PostfixAccum
  = PostfixAccumSpine { segments: List<Node> }
  | PostfixAccumValue { node: Node }

fn body_lower_postfix_accum_node(acc: PostfixAccum, source: Node) -> Node {
  match acc {
    PostfixAccumSpine { segments: segments } =>
      body_lower_qualified_name_spine_node(segments: segments, source: source)
    PostfixAccumValue { node: n } => n
  }
}

fn body_lower_postfix_chain_fold_step(
  acc: Outcome<PostfixAccum>,
  step: PostfixStep,
  source: Node
) -> Outcome<PostfixAccum> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: state, diagnostics: ad } =>
      match step {
        PostfixCast { target: target } =>
          match body_lower_type_expr_lowered_optional(node: target) {
            Absent => body_lower_postfix_cast_target_not_carried(at: target)
            Present { value: target_type } =>
              outcome_with_diagnostics(
                value: PostfixAccumValue {
                  node: body_lower_cast_node(
                    operand: body_lower_postfix_accum_node(acc: state, source: source),
                    target_type: target_type,
                    source: source
                  )
                },
                diagnostics: ad
              )
          }
        PostfixRecord { segment: step_segment, items: items } =>
          match state {
            PostfixAccumSpine { segments: segments } =>
              match body_lower_record_construct(
                reference: body_lower_qualified_name_spine_node(
                  segments: list_snoc_item(xs: segments, item: step_segment),
                  source: source
                ),
                items: items,
                source: source
              ) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: construct, diagnostics: cd } =>
                  outcome_with_diagnostics(
                    value: PostfixAccumValue { node: construct },
                    diagnostics: diagnostics_merge(outer: ad, inner: cd)
                  )
              }
            PostfixAccumValue { node: _ } =>
              outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: step_segment))
          }
        PostfixProjection { segment: step_segment, call_elem: step_call_elem } =>
      match step_call_elem {
        Absent =>
          match state {
            PostfixAccumSpine { segments: segments } =>
              outcome_with_diagnostics(
                value: PostfixAccumSpine {
                  segments: list_snoc_item(xs: segments, item: step_segment)
                },
                diagnostics: ad
              )
            PostfixAccumValue { node: base } =>
              outcome_with_diagnostics(
                value: PostfixAccumValue {
                  node: field_projection_node(base: base, field: step_segment, source: source)
                },
                diagnostics: ad
              )
          }
        Present { value: call_elem } =>
          match body_lower_postfix_projection_args(repeat_elem: call_elem) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: args, diagnostics: cd } =>
              match state {
                PostfixAccumSpine { segments: segments } =>
                  outcome_with_diagnostics(
                    value: PostfixAccumValue {
                      node: body_lower_transform_call(
                        operator: body_lower_qualified_name_spine_node(
                          segments: list_snoc_item(xs: segments, item: step_segment),
                          source: source
                        ),
                        args: args
                      )
                    },
                    diagnostics: diagnostics_merge(outer: ad, inner: cd)
                  )
                PostfixAccumValue { node: receiver } =>
                  outcome_with_diagnostics(
                    value: PostfixAccumValue {
                      node: body_lower_transform_call(
                        operator: step_segment,
                        args: list_append(left: [Edge { label: Positional, target: receiver }], right: args)
                      )
                    },
                    diagnostics: diagnostics_merge(outer: ad, inner: cd)
                  )
              }
          }
      }
  }
      }
}

// THE ONE DOOR THE EXPRESSION SITES CONSULT, AND IT SITS ABOVE THE FIRST-ATOM FALLBACK. Its
// population is now EVERY postfix chain whose steps are dot projections with an empty or a paren
// call suffix -- the bare chain, the call through a path, the method on a value, the field off a
// computed receiver, and any interleaving of them. Nothing else claims a chain this door admits
// before it has answered. The order is the construction (review 67903 on gunbc#11612):
// body_lower_pattern_first_atom_optional, consulted first, claimed the chain's head atom and the
// rest of the chain vanished, so a guard beside the fallback asking "is this dotted?" would have
// been a second authority for what this reader already decides.
//
// A HEAD THE READER CANNOT LOWER IS DECLINED, NOT REFUSED, so the existing arms run unchanged for
// it and this change introduces no new refusal class. That is the honest statement of the
// remaining gap: an arbitrary parenthesised expression in head position is still read by whatever
// arm claims it, and body_lower_operand_ref_optional is the boundary of what this door admits as
// a computed head.
fn body_lower_dotted_chain_lowered_optional(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_postfix_chain_read(node: node) {
    PostfixChainNotThisShape =>
      if body_lower_postfix_chain_carries_as_suffix(node: node) {
        outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: node))
      } else {
        outcome_accepted(value: optional_absent())
      }
    PostfixChainSuffixCarried { at: at } =>
      if body_lower_postfix_chain_carries_as_suffix(node: node) {
        outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_postfix_suffix_carried, n: at))
      } else {
      outcome_with_diagnostics(
        value: optional_absent(),
        diagnostics: Some {
          diagnostics: diagnostics_singleton(
            d: body_lower_diagnostic(
              reason: ^body_lowering_reason_postfix_suffix_carried,
              n: at
            )
          )
        }
      )
      }
    PostfixChainBare { segments: segments } =>
      body_lower_postfix_chain_lowered_from_steps(
        node: node,
        steps: body_lower_postfix_bare_steps(segments: segments)
      )
    PostfixChainFound { steps: steps } =>
      body_lower_postfix_chain_lowered_from_steps(node: node, steps: steps)
  }
}

// The expression door's fold over a read chain, for either arm: the head is a spine segment when it
// is a bare name and a lowered value otherwise, and every step then eliminates the accumulator.
fn body_lower_postfix_chain_lowered_from_steps(
  node: Node,
  steps: List<PostfixStep>
) -> Outcome<Optional<Node>> {
  let head_node = body_lower_postfix_chain_head_or_self(node: node)
  match body_lower_postfix_chain_head_atom_for_steps(head_node: head_node, steps: steps) {
    Present { value: head } =>
      body_lower_postfix_chain_fold_from(
        steps: steps,
        init: PostfixAccumSpine { segments: [head] },
        source: node
      )
    Absent =>
      match body_lower_operand_ref_read(node: head_node) {
        OperandRefAbsent =>
          if body_lower_postfix_steps_carry_cast(steps: steps)
            || body_lower_postfix_head_is_call(head_node: head_node) {
            body_lower_postfix_cast_chain_computed_head(head_node: head_node, steps: steps, source: node)
          } else {
            outcome_accepted(value: optional_absent())
          }
        OperandRefLowered { lowered: head_value } =>
          body_lower_postfix_chain_fold_from(
            steps: steps,
            init: PostfixAccumValue { node: head_value },
            source: node
          )
        OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
      }
  }
}

// A CHAIN CARRYING A CAST, OR HEADED BY A CALL, NEVER DECLINES. Every arm after this door reads the primary and ignores
// the suffixes, so declining `g(v: x) as T` answered it with `g(v: x)` and dropped the cast --
// Accepted with no cast node (measured). A head the operand reader does not read (a call, a group)
// is lowered as the primary expression it is; a head that does not lower refuses with that
// lowering's own diagnostic.
// A CALL HEAD takes the same path for the same reason (gunbc.recurring_failure_mode
// call_expression_erased_at_v2_body_lowering, the call-then-field residue): on the top-down walker
// route `f(x).a.b` still carries its head as a raw primary with its call suffix, which the operand
// reader does not read, so the door declined and the chain fell to arms that refused it
// (operator_operand_unread, warm-bear-132's c02590) or kept the call alone.
fn body_lower_postfix_head_is_call(head_node: Node) -> Bool {
  match body_lower_primary_call_suffix_optional(root: head_node) {
    Present { value: _ } => true
    Absent => false
  }
}

fn body_lower_postfix_cast_chain_computed_head(
  head_node: Node,
  steps: List<PostfixStep>,
  source: Node
) -> Outcome<Optional<Node>> {
  match body_lower_primary_expr(shell: head_node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: head_value, diagnostics: hd } =>
      match body_lower_postfix_chain_fold_from(steps: steps, init: PostfixAccumValue { node: head_value }, source: source) {
        Rejected { diagnostics: r } => Rejected { diagnostics: rejected_with_pending(pending: hd, rejected: r) }
        Accepted { value: v, diagnostics: d } => outcome_with_diagnostics(value: v, diagnostics: diagnostics_merge(outer: hd, inner: d))
      }
  }
}

// A bare head starts a SPINE only when a projection follows it (`a.b`); a head cast directly
// (`x as T`) is an operand, read by the operand reader like any other value.
fn body_lower_postfix_chain_head_atom_for_steps(head_node: Node, steps: List<PostfixStep>) -> Optional<Node> {
  match steps {
    Cons { head: first, tail: _ } =>
      match first {
        PostfixCast { target: _ } => optional_absent()
        PostfixProjection { segment: _, call_elem: _ } => body_lower_dotted_head_atom_optional(node: head_node)
        PostfixRecord { segment: _, items: _ } => body_lower_dotted_head_atom_optional(node: head_node)
      }
    Empty => body_lower_dotted_head_atom_optional(node: head_node)
  }
}

fn body_lower_postfix_cast_target_not_carried(at: Node) -> Outcome<PostfixAccum> {
  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_type_annotation_not_carried, n: at))
}

// THE OPERAND READERS' CAST DOOR. A postfix chain carrying a cast step is lowered whole through the
// chain fold (body_lower_dotted_chain_lowered_optional); any other node is not this reader's.
fn body_lower_cast_chain_read(node: Node) -> OperandRefRead {
  if body_lower_postfix_chain_carries_as_suffix(node: node) {
    match body_lower_dotted_chain_lowered_optional(node: node) {
      Rejected { diagnostics: r } => OperandRefRefused { diagnostics: r }
      Accepted { value: Present { value: lowered }, diagnostics: _ } => OperandRefLowered { lowered: lowered }
      Accepted { value: Absent, diagnostics: _ } =>
        OperandRefRefused {
          diagnostics: diagnostics_singleton(d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: node))
        }
    }
  } else {
    OperandRefAbsent
  }
}

fn body_lower_postfix_steps_carry_cast(steps: List<PostfixStep>) -> Bool {
  fold(steps, init: false, f: fn(acc, step) {
    acc || match step {
      PostfixCast { target: _ } => true
      PostfixProjection { segment: _, call_elem: _ } => false
      PostfixRecord { segment: _, items: _ } => false
    }
  })
}

// THE TYPED CAST NODE. `e as T` is Transform[kw_as, e] with the v2.std.type_binder <cast-target>
// edge -> T beside its positionals, appended after them. The operator is the surface token, as
// every lowered infix operator is; v2.compiler.resolve canonicalizes it to the coercion
// CanonicalOperation (v2.extdeps.languages.dag dag_surface_operator_canonicalization_lookup) and
// binds T in type role. The named edge is never an operand: readers take a Transform's operands
// through its positional children.
fn body_lower_cast_node(operand: Node, target_type: Node, source: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: node_synthetic(kind: TypeNode { connective: Atom { identity: ^dag_token_kw_as } }, children: []) },
      Edge { label: Positional, target: operand },
      cast_target_edge(target_type: target_type)
    ]
  )
}

fn body_lower_postfix_chain_fold_from(
  steps: List<PostfixStep>,
  init: PostfixAccum,
  source: Node
) -> Outcome<Optional<Node>> {
  match fold(steps, init: outcome_accepted(value: init), f: fn(acc, step) {
    body_lower_postfix_chain_fold_step(acc: acc, step: step, source: source)
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: state, diagnostics: d } =>
      outcome_with_diagnostics(
        value: optional_present(value: close_lowered_image_of(root: body_lower_postfix_accum_node(acc: state, source: source), source: source)),
        diagnostics: d
      )
  }
}

// The type-position twin: a dag_surface_qualified_name production with more than one segment
// lowers to the same spine. A single segment keeps the atom path above it, which is where the
// Int / Bool canonical bindings are applied.
fn body_lower_qualified_name_production_spine_optional(node: Node, captured: Node) -> Optional<Node> {
  match parse_qualified_name_segment_atoms_from_capture(qn_capture: captured, root: node) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: segments, diagnostics: _ } =>
      if length(xs: segments) > 1 {
        optional_present(value: body_lower_qualified_name_spine_node(segments: segments, source: node))
      } else {
        optional_absent()
      }
  }
}

fn body_lower_postfix_optional_unwrap(node: Node) -> Node {
  match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    Accepted { value: child, diagnostics: _ } => child
    Rejected { diagnostics: _ } => node
  }
}

fn body_lower_postfix_method_suffix_optional(repeat_elem: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => optional_absent()
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Present { value: id } =>
          if id == ^dag_token_dot {
            match sugar_sequence_pair_optional(node: pair.right) {
              Absent => optional_absent()
              Present { value: after_dot } =>
                optional_present(
                  value: body_lower_postfix_optional_unwrap(node: after_dot.right)
                )
            }
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

// Called only where body_lower_postfix_projection_has_call_suffix holds or the dotted-chain walk
// has named the call element, so the two Absent arms are "no call here", not a lost argument.
fn body_lower_postfix_projection_args(repeat_elem: Node) -> Outcome<List<Edge>> {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    Absent => outcome_accepted(value: Empty)
    Present { value: call_suffix } =>
      match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
        Present { value: args_read } => args_read
        Absent => outcome_accepted(value: Empty)
      }
  }
}

fn body_lower_postfix_projection_call_suffix_capture(repeat_elem: Node) -> Node {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    Absent => repeat_elem
    Present { value: call_suffix } => call_suffix
  }
}

// Kept for v2.lens.complexity_accumulator_copy.analyze, which reads it directly; the chain walk
// itself consumes body_lower_postfix_suffix_read below instead, because a boolean cannot separate
// an absent slot from an unlowered one.
fn body_lower_postfix_projection_has_call_suffix(repeat_elem: Node) -> Bool {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    Absent => false
    Present { value: call_suffix } =>
      match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

// THE SUFFIX SLOT IS A THREE-WAY READ, AND COLLAPSING IT TO A BOOLEAN PAIR OVER-REFUSES.
// body_lower_dotted_suffix_slot_is_empty and body_lower_postfix_projection_has_call_suffix BOTH
// answer false when the slot is ABSENT, so "neither empty nor a call" conflates two different
// facts: a slot that is PRESENT carrying a suffix kind this lowering cannot read (the brace
// suffix `a.b.C { f: v }`, an `as` suffix), which must REFUSE, and NO SLOT AT ALL, which is
// simply not this shape and must DECLINE to the existing arms exactly as the pre-PR2 walk did.
// Measured: refusing the absent case as well took the workload from 0 to 103 refusing rows over
// ordinary modules -- src/v2/compiler/01_tokenize.dag, src/v2/std/artifact.dag and 101 others --
// which is DESIGN section 5 inverted, a decline widened into a refusal rather than a widen
// narrowed into one.
type PostfixSuffixRead
  = PostfixSuffixNone
  | PostfixSuffixEmpty
  | PostfixSuffixCall
  | PostfixSuffixRecord { items: List<Node> }
  | PostfixSuffixUnlowered

// A PAREN CALL IS DECIDED BY THE ONE READER OF A CALL SUFFIX (#12108's comma-list route):
// body_lower_postfix_call_suffix_args answers Present exactly when the suffix opens with `(`,
// whether or not its argument list then reads. A malformed list is still a CALL here, so the fold
// reaches that reader and it refuses located rather than this read declining it.
fn body_lower_postfix_suffix_read(repeat_elem: Node) -> PostfixSuffixRead {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    Absent => PostfixSuffixNone
    Present { value: suffix } =>
      if is_empty_conj_root(n: suffix) {
        PostfixSuffixEmpty
      } else {
        match body_lower_postfix_call_suffix_args(call_suffix: suffix) {
          Present { value: _ } => PostfixSuffixCall
          Absent =>
            match body_lower_record_brace_items_optional(brace: suffix) {
              Present { value: items } => PostfixSuffixRecord { items: items }
              Absent => PostfixSuffixUnlowered
            }
        }
      }
  }
}

fn body_lower_postfix_repeat_head_optional(repeat_capture: Node) -> Optional<Node> {
  if is_empty_conj_root(n: repeat_capture) {
    optional_absent()
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: elem, diagnostics: _ } => optional_present(value: elem)
      Rejected { diagnostics: _ } =>
        match find_named_child(root: repeat_capture, name: ^grammar_repeat_element_node_projection) {
          Accepted { value: elem, diagnostics: _ } => optional_present(value: elem)
          Rejected { diagnostics: _ } => optional_absent()
        }
    }
  }
}

fn body_lower_match_arm_wire(pat_node: Node, body: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: core_edge_label(marker: MatchArmPatternEdge), target: pat_node },
      Edge { label: core_edge_label(marker: MatchArmBodyEdge), target: body }
    ]
  )
}

// The same ordering as body_lower_operand_ref_optional: an int literal is read whole before the
// branded-atom arm, which would rebuild it without its magnitude (the postfix reduce reaches
// this reader for every literal operand).
// ONE ATOM, CLASSIFIED ONCE. A node that IS a single atom (after optional elements) is read here: an
// int literal with its magnitude, a branded binding, `true`/`false`, or a reference. Both readers
// below call it, so the classification has one home.
fn body_lower_atom_node_lowered_optional(stripped: Node) -> Optional<Node> {
  match body_lower_string_literal_value_optional(node: stripped) {
    Present { value: literal } => optional_present(value: literal)
    Absent =>
  match dag_node_is_int_literal_atom(node: stripped) {
    true => body_lower_int_literal_with_magnitude_optional(node: stripped)
    false =>
  match dag_binding_branded_atom_identity(node: stripped) {
    Present { value: binding } =>
      optional_present(value: body_lower_param_ref_atom(source: stripped, identity: binding))
    Absent =>
      match node_atom_identity_optional(node: stripped) {
        Present { value: id } =>
          if dag_lex_token_symbol(sym: id) {
            if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
              optional_present(value: body_lower_param_ref_atom(source: stripped, identity: id))
            } else {
              body_lower_int_literal_with_magnitude_optional(node: stripped)
            }
          } else {
            optional_present(value: body_lower_param_ref_atom(source: stripped, identity: id))
          }
        Absent => optional_absent()
      }
  }
  }
  }
}

// A STRING LITERAL IS READ WHOLE, value payload and occurrence kept: the parser built it carrying
// its decoded value (v2.extdeps.languages.dag dag_string_literal_node_from_lexeme), and rebuilding
// it as a bare atom would drop that value, which is the defect this arm exists to prevent.
fn body_lower_string_literal_value_optional(node: Node) -> Optional<Node> {
  match dag_string_literal_value_symbol_optional(node: node) {
    Present { value: _ } => optional_present(value: node)
    Absent => optional_absent()
  }
}

// THE PATTERN READER: an atom, or the first atom a pattern capture's children yield. A pattern
// capture such as `A { x: v }` is a sequence whose first atom IS its tag, so the child search is this
// reader's contract (the pattern claims of v2.test.claim.body_lowering.single_arm_match and
// v2.test.manual.body_lowering_match go red without it).
fn body_lower_pattern_leaf_atom_optional(node: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  match body_lower_atom_node_lowered_optional(stripped: stripped) {
    Present { value: atom } => optional_present(value: atom)
    Absent =>
      match parse_production_emitted_identity_optional(node: stripped) {
        Present { value: emitted } =>
          match parse_production_captured_child_optional(node: stripped) {
            Present { value: captured } => body_lower_pattern_leaf_atom_optional(node: captured)
            Absent =>
              if emitted == ^dag_surface_pattern {
                fold(stripped.children, init: Absent, f: fn(acc, e) {
                  match acc {
                    Present { value: _ } => acc
                    Absent => body_lower_pattern_leaf_atom_optional(node: e.target)
                  }
                })
              } else {
                optional_absent()
              }
          }
        Absent =>
          fold(stripped.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lower_pattern_leaf_atom_optional(node: e.target)
            }
          })
      }
  }
}

// THE VALUE READER'S ATOM: the node is its atom only if, through optional elements, production
// shells and empty-tail sequences (an operator-free tower level, the peel
// body_lower_find_control_form_optional also makes), it IS one atom; anything with more structure is
// Absent, so the caller refuses. The primary,
// postfix and operand fall-backs used the pattern reader's child search here, and answered a map
// literal `{ "k": v }` with its `{` token and a qualified constructor `a.b.T { f: v }` with `a`
// (gunbc.recurring_failure_mode unrecognized_primary_expression_lowers_to_its_first_atom_at_v2_body_lowering).
fn body_lower_value_sole_atom_optional(node: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  match body_lower_atom_node_lowered_optional(stripped: stripped) {
    Present { value: atom } => optional_present(value: atom)
    Absent =>
      match parse_production_captured_child_optional(node: stripped) {
        Present { value: captured } => body_lower_value_sole_atom_optional(node: captured)
        Absent =>
          match sugar_sequence_pair_optional(node: stripped) {
            Present { value: pair } =>
              if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
                body_lower_value_sole_atom_optional(node: pair.left)
              } else {
                optional_absent()
              }
            Absent => optional_absent()
          }
      }
  }
}

fn body_lower_pattern_first_atom_optional(node: Node) -> Optional<Node> {
  match body_lower_pattern_leaf_atom_optional(node: node) {
    Present { value: atom } => Present { value: atom }
    Absent =>
      fold(node.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_pattern_first_atom_optional(node: e.target)
        }
      })
  }
}

fn body_lower_pattern_atom_optional(pattern_capture: Node) -> Optional<Node> {
  body_lower_pattern_first_atom_optional(node: pattern_capture)
}

fn body_lower_match_arm_navigation_reject(arm_capture: Node) -> Outcome<Node> {
  outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_match_arm_navigation_refused,
      n: arm_capture
    )
  )
}

// THE ARM BODY IS READ FROM ITS GRAMMAR POSITION: match_arm is seq(pattern, seq(`=>`, body)), so the
// body is the right of the `=>`. It was the first dag_surface_expr, then primary_expr, then
// postfix_expr found anywhere in the arm (body_lower_find_captured, a pre-order first match). For
// an arm whose body is a statement sequence -- `X => let t = v` then `e` -- the first expr is the
// let's value, so the arm lowered to `v`, and the binder and every later statement were gone with no
// diagnostic (gunbc.recurring_failure_mode
// match_arm_statement_body_lowers_to_its_first_expression_at_v2_body_lowering). An arm whose `=>`
// is not at its position answers Absent, and its caller refuses the arm's navigation.
fn body_lower_match_arm_body_capture_optional(stripped: Node) -> Optional<Node> {
  match body_lower_match_spine_right(spine: stripped) {
    Absent => optional_absent()
    Present { value: after_pattern } =>
      match body_lower_match_spine_left(spine: after_pattern) {
        Absent => optional_absent()
        Present { value: arrow_node } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: arrow_node)) {
            Absent => optional_absent()
            Present { value: arrow } =>
              if arrow == ^dag_token_fat_arrow {
                body_lower_match_spine_right(spine: after_pattern)
              } else {
                optional_absent()
              }
          }
      }
  }
}

// A PATTERN LOWERS TO THE SHAPE IT ELIMINATES. A constructor pattern is
// seq(qualified_name, optional(`{` field_pattern,* `}` | `(` pattern,* `)`)). With no suffix it is
// the atom it always was (a nullary variant, a binder, or a literal -- which of the first two is
// the resolver's to decide, as in the seed's 04_patterns). With a suffix it is the CONSTRUCT
// (v2.std.node_query construct_node): the tag edge names the constructor, and each declared field
// the pattern names is a Named edge from that field to the sub-pattern it binds -- `A(x)` binds
// field "0" (v1.compiler.parse parse_variant_pattern), `A { v: x }` binds field v, and the
// shorthand `A { v }` binds field v to the binder v. So `Fnv1a64(left_structural) =>` lowers to
// Conj { Fnv1a64: Atom(Fnv1a64), 0: Atom(left_structural) }, the same shape the language
// authority's fixture pattern dag_variant_holds_pattern_node has, and the binder reaches the
// resolver instead of vanishing (the loss gunbc#11998 turned into
// body_lowering_reason_positional_pattern_binder_unlowered, retired here). Positional arity is
// one, as the seed's parse admits; more refuses with a located cause.
fn body_lower_pattern_reject<T>(pattern_capture: Node) -> Outcome<T> {
  outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_unlowered, n: pattern_capture)
  )
}

// A field pattern is ONE shape, `(name, optional(: pattern))` (v2.extdeps.languages.dag
// dag_grammar_field_pattern_expr, left-factored): an empty suffix is the pun `name`, which binds the
// field to the binder of the same name.
fn body_lower_field_pattern_edge(item: Node) -> Outcome<Edge> {
  let stripped = body_lower_deep_unwrap_optional(node: item)
  let captured = match parse_production_captured_child_optional(node: stripped) {
    Present { value: c } => c
    Absent => stripped
  }
  match sugar_sequence_pair_optional(node: captured) {
    Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_unlowered, n: item))
    Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_unlowered, n: item))
        Present { value: field_name } =>
          let suffix = body_lower_deep_unwrap_optional(node: pair.right)
          if is_empty_conj_root(n: suffix) {
            outcome_accepted(
              value: Edge {
                label: Authored { name: field_name },
                target: body_lower_param_ref_atom(source: pair.left, identity: field_name)
              }
            )
          } else {
            match sugar_sequence_pair_optional(node: suffix) {
              Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_unlowered, n: item))
              Present { value: after_colon } =>
                match body_lower_pattern_lowered(pattern_capture: after_colon.right) {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: sub, diagnostics: d } =>
                    Accepted { value: Edge { label: Authored { name: field_name }, target: sub }, diagnostics: d }
                }
            }
          }
      }
  }
}

fn body_lower_pattern_field_edges(items: List<Node>, braced: Bool, witness: Node) -> Outcome<List<Edge>> {
  if braced {
    fold(items, init: outcome_accepted(value: Empty), f: fn(acc, item) {
      bind_outcome(o: acc, f: fn(edges) {
        bind_outcome(o: body_lower_field_pattern_edge(item: item), f: fn(e) {
          outcome_accepted(value: list_snoc_item(xs: edges, item: e))
        })
      })
    })
  } else {
    if count(items) == 1 {
      match list_at_optional(xs: items, index: 0) {
        Absent => body_lower_pattern_reject(pattern_capture: witness)
        Present { value: only } =>
          bind_outcome(o: body_lower_pattern_lowered(pattern_capture: only), f: fn(sub) {
            outcome_accepted(
              value: [Edge { label: Authored { name: positional_payload_field_name() }, target: sub }]
            )
          })
      }
    } else {
      body_lower_pattern_reject(pattern_capture: witness)
    }
  }
}

// A CONSTRUCTOR PATTERN'S HEAD IS ITS WHOLE qualified_name, the same reference a construction carries:
// every authored segment, lowered from its own token, as the spine. The first-atom reader that stood
// here answered `v2` for `v2.std.diagnostic.Rejected { .. }`, so a qualified pattern silently took
// its first segment as its constructor. A head with no qualified_name is not a constructor pattern
// and refuses located rather than falling back to an atom search.
fn body_lower_pattern_head_segments_optional(head: Node) -> Optional<List<Node>> {
  match body_lower_find_captured(root: head, emitted: ^dag_surface_qualified_name) {
    ParseSubtreeAbsent => optional_absent()
    ParseSubtreeFound { captured: qn } =>
      match parse_qualified_name_segment_atoms_from_capture(qn_capture: qn, root: head) {
        Rejected { diagnostics: _ } => optional_absent()
        Accepted { value: segments, diagnostics: _ } =>
          match segments {
            Empty => optional_absent()
            Cons { head: _, tail: _ } => optional_present(value: segments)
          }
      }
  }
}

fn body_lower_pattern_head_reference_optional(head: Node) -> Optional<Node> {
  match body_lower_pattern_head_segments_optional(head: head) {
    Absent => optional_absent()
    Present { value: segments } =>
      optional_present(value: body_lower_qualified_name_spine_node(segments: segments, source: head))
  }
}

// A NULLARY PATTERN WITH A QUALIFIED HEAD IS A REFERENCE, NOT A BINDER. `v2.std.diagnostic.None =>`
// names a declaration by its path; only a one-segment head can be a binder, and whether it is one is
// the resolver's to decide, so a one-segment head answers Absent here and stays the atom it always
// was. The first-atom reader answered `v2` for the qualified form -- a binder named `v2` that matched
// everything.
fn body_lower_pattern_qualified_reference_optional(head: Node) -> Optional<Node> {
  match body_lower_pattern_head_segments_optional(head: head) {
    Absent => optional_absent()
    Present { value: segments } =>
      if length(xs: segments) > 1 {
        optional_present(value: body_lower_qualified_name_spine_node(segments: segments, source: head))
      } else {
        optional_absent()
      }
  }
}

fn body_lower_pattern_suffix_lowered(head: Node, suffix: Node, pattern_capture: Node) -> Outcome<Node> {
  match sugar_sequence_pair_optional(node: suffix) {
    Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
        Present { value: open } =>
          if (open == ^dag_token_lparen) || (open == ^dag_token_lbrace) {
            match sugar_sequence_pair_optional(node: pair.right) {
              Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
              Present { value: inner } =>
                match body_lower_comma_list_items_optional(list_capture: inner.left) {
                  Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
                  Present { value: items } =>
                    match body_lower_pattern_head_reference_optional(head: head) {
                      Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
                      Present { value: reference } =>
                        bind_outcome(
                          o: body_lower_pattern_field_edges(
                            items: items,
                            braced: open == ^dag_token_lbrace,
                            witness: pattern_capture
                          ),
                          f: fn(edges) {
                            outcome_accepted(
                              value: close_lowered_image(root: construct_node(reference: reference, field_edges: edges, source: pattern_capture))
                            )
                          }
                        )
                    }
                }
            }
          } else {
            body_lower_pattern_reject(pattern_capture: pattern_capture)
          }
      }
  }
}

fn body_lower_pattern_lowered(pattern_capture: Node) -> Outcome<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: pattern_capture)
  let captured = match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: id } =>
      if id == ^dag_surface_pattern {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: c } => c
          Absent => stripped
        }
      } else {
        stripped
      }
    Absent => stripped
  }
  match sugar_sequence_pair_optional(node: captured) {
    Present { value: pair } =>
      if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
        match body_lower_pattern_qualified_reference_optional(head: pair.left) {
          Present { value: reference } => outcome_accepted(value: reference)
          Absent =>
            match body_lower_pattern_atom_optional(pattern_capture: pair.left) {
              Present { value: atom } => outcome_accepted(value: body_lower_pattern_atom_form(atom: atom))
              Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
            }
        }
      } else {
        body_lower_pattern_suffix_lowered(
          head: pair.left,
          suffix: body_lower_deep_unwrap_optional(node: pair.right),
          pattern_capture: pattern_capture
        )
      }
    Absent =>
      match body_lower_pattern_atom_optional(pattern_capture: captured) {
        Present { value: atom } => outcome_accepted(value: body_lower_pattern_atom_form(atom: atom))
        Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
      }
  }
}

// A BARE PATTERN ATOM IS A NAME OR THE WILDCARD, and only the wildcard changes form here: an authored
// `_` lowers to the minted wildcard pattern (v2.std.node_query wildcard_pattern_identity) at the `_`'s
// own occurrence, so no reader downstream sees a name it would look up. A name stays the atom it is,
// a constructor or a binder for the resolver to decide.
fn body_lower_pattern_atom_form(atom: Node) -> Node {
  match node_atom_identity_optional(node: atom) {
    Present { value: id } =>
      if id == pattern_wildcard_name() {
        body_lower_param_ref_atom(source: atom, identity: wildcard_pattern_identity())
      } else {
        atom
      }
    Absent => atom
  }
}

// THE ARM BODY IS A VALUE, READ BY THE VALUE READER AND BY NOTHING ELSE. It was read by an operand
// reader (body_lower_match_arm_body_optional, deleted) that answered a nested `match` or `if` in arm
// position with that form's first atom -- how every arm of std.content_hash compare_content_hash lost
// its inner match -- and then kept as the FALLBACK for what the value reader declined, where its own
// Absent was reported as match_arm_navigation_refused. That relabel is how an unlowered fn literal in
// an arm body (a fold call's `f: fn(acc, x) { .. }`) surfaced as a navigation failure of the arm.
// An arm body now lowers through body_lower_match_arm_body_lowered on both routes -- the
// pattern-capture route and the spine route below -- which is the value reader for an expression
// body and the statement authority for a statement body, so its refusal is the value's or the
// statement's, located there; the navigation refusal is left to exactly what it names: an arm whose
// pattern or `=>` cannot be found.
// AN ARM BODY THAT IS A STATEMENT SEQUENCE LOWERS THROUGH THE STATEMENT AUTHORITY. The grammar's
// match_arm_stmt_body (v2.extdeps.languages.dag dag_grammar_match_arm_stmt_body_expr) is parsed by
// its own production, so a statement body is recognized by its production stamp, and its captured
// child is the statement spine `stmt stmt*` (the arm-head predicates guarding each statement
// capture nothing). It lowers through body_lower_stmt_spine, the reader a fn body and an if arm use:
// a let binds the rest, the last statement is the value, and any other statement that precedes
// another refuses located. An expression body sits under its own expr production and is read by the
// value reader, as before.
fn body_lower_match_arm_statement_spine_optional(body_capture: Node) -> Optional<Node> {
  let shell = body_lower_deep_unwrap_optional(node: body_capture)
  match parse_production_emitted_identity_optional(node: shell) {
    Absent => optional_absent()
    Present { value: emitted } =>
      if emitted == ^dag_surface_match_arm_stmt_body {
        parse_production_captured_child_optional(node: shell)
      } else {
        optional_absent()
      }
  }
}

// AN EMPTY ARM BODY HAS NO STATEMENT (v2.extdeps.languages.dag dag_grammar_empty_block_body_expr), so
// it refuses as an empty block's spine always has: headless, at the body.
fn body_lower_match_arm_empty_body_optional(body_capture: Node) -> Optional<Node> {
  let shell = body_lower_deep_unwrap_optional(node: body_capture)
  match parse_production_emitted_identity_optional(node: shell) {
    Present { value: emitted } => if emitted == ^dag_surface_empty_block_body { optional_present(value: shell) } else { optional_absent() }
    Absent => optional_absent()
  }
}

fn body_lower_match_arm_body_lowered(body_capture: Node) -> Outcome<Node> {
  match body_lower_match_arm_empty_body_optional(body_capture: body_capture) {
    Present { value: empty } =>
      outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_statement_spine_headless, n: empty))
    Absent => body_lower_match_arm_nonempty_body_lowered(body_capture: body_capture)
  }
}

fn body_lower_match_arm_nonempty_body_lowered(body_capture: Node) -> Outcome<Node> {
  match body_lower_match_arm_statement_spine_optional(body_capture: body_capture) {
    Present { value: spine } => body_lower_stmt_spine(spine: spine)
    Absent => body_lower_tail_statement_read(stmt: body_capture)
  }
}

fn body_lower_match_arm_wire_read(pat_node: Node, body_capture: Node) -> Outcome<Node> {
  match body_lower_match_arm_body_lowered(body_capture: body_capture) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: body, diagnostics: d } =>
      outcome_with_diagnostics(value: body_lower_match_arm_wire(pat_node: pat_node, body: body), diagnostics: d)
  }
}

fn body_lower_match_arm_wire_from_sequence(stripped: Node) -> Outcome<Node> {
  match body_lower_find_captured(
    root: stripped,
    emitted: ^dag_surface_pattern
  ) {
    ParseSubtreeFound { captured: pat_capture } =>
      match body_lower_pattern_lowered(pattern_capture: pat_capture) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: pat_node, diagnostics: _ } =>
          match body_lower_match_arm_body_capture_optional(stripped: stripped) {
            Present { value: body_capture } =>
              body_lower_match_arm_wire_read(pat_node: pat_node, body_capture: body_capture)
            Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
          }
      }
    ParseSubtreeAbsent =>
      match body_lower_match_spine_left(spine: stripped) {
        Present { value: left } =>
          match body_lower_match_spine_right(spine: stripped) {
            Present { value: right } =>
              match body_lower_pattern_atom_optional(pattern_capture: left) {
                Present { value: pat_node } =>
                  match body_lower_match_spine_left(spine: right) {
                    Present { value: arrow_node } =>
                      match node_atom_identity_optional(node: arrow_node) {
                        Present { value: arrow } =>
                          if arrow == ^dag_token_fat_arrow {
                            match body_lower_match_spine_right(spine: right) {
                              Present { value: body_capture } =>
                                body_lower_match_arm_wire_read(pat_node: pat_node, body_capture: body_capture)
                              Absent =>
                                body_lower_match_arm_navigation_reject(arm_capture: stripped)
                            }
                          } else {
                            body_lower_match_arm_navigation_reject(arm_capture: stripped)
                          }
                        Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
                      }
                    Absent =>
                      match sugar_sequence_pair_optional(node: right) {
                        Present { value: after_pattern } =>
                          match node_atom_identity_optional(node: after_pattern.left) {
                            Present { value: arrow } =>
                              if arrow == ^dag_token_fat_arrow {
                                body_lower_match_arm_wire_read(pat_node: pat_node, body_capture: after_pattern.right)
                              } else {
                                body_lower_match_arm_navigation_reject(arm_capture: stripped)
                              }
                            Absent =>
                              body_lower_match_arm_navigation_reject(arm_capture: stripped)
                          }
                        Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
                      }
                  }
                Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
              }
            Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
          }
        Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
      }
  }
}

fn body_lower_is_match_arm_navigate_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_pattern)
    || (emitted == ^dag_surface_primary_expr)
    || body_lower_is_pass_through_emitted(emitted: emitted)
}



fn body_lower_wire_match_arm_capture(arm_capture: Node) -> Outcome<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: arm_capture)
  match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_match_arm {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } =>
            body_lower_wire_match_arm_capture(arm_capture: captured)
          Absent => body_lower_match_arm_wire_from_sequence(stripped: stripped)
        }
      } else if body_lower_is_match_arm_navigate_emitted(emitted: emitted) {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } =>
            body_lower_wire_match_arm_capture(arm_capture: captured)
          Absent => body_lower_match_arm_navigation_reject(arm_capture: arm_capture)
        }
      } else {
        body_lower_match_arm_navigation_reject(arm_capture: arm_capture)
      }
    Absent => body_lower_match_arm_wire_from_sequence(stripped: stripped)
  }
}




// A branch target the fold already lowered: a literal reifies to its canonical atom, an operand to
// its whole reading, and a target neither reader reads is kept AS LOWERED (identity, never a part).
// An operand reader's refusal is the target's refusal and propagates; it used to keep the target as
// if it had read nothing (gunbc.recurring_failure_mode lowering_accessor_collapses_a_sequence_operand).
fn body_lower_reify_branch_target(node: Node) -> Outcome<Node> {
  match body_lower_materialize_int_literal_operand_optional(node: node) {
    Present { value: reified } => outcome_accepted(value: reified)
    Absent =>
      match body_lower_literal_bool_atom_optional(node: node) {
        Present { value: reified } => outcome_accepted(value: reified)
        Absent =>
          match body_lower_operand_ref_read(node: node) {
            OperandRefLowered { lowered: op } => outcome_accepted(value: op)
            OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
            OperandRefAbsent =>
              match body_lower_operand_from_shell_read(shell: node) {
                OperandRefLowered { lowered: op } => outcome_accepted(value: op)
                OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
                OperandRefAbsent => outcome_accepted(value: node)
              }
          }
      }
  }
}

fn body_lower_reify_branch_body(body: Node) -> Outcome<Node> {
  match body.kind {
    ComputationNode { behavior: Branch } =>
      match fold(body.children, init: outcome_accepted(value: Empty), f: fn(acc, e) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: done, diagnostics: d } =>
            match body_lower_reify_branch_target(node: e.target) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: target, diagnostics: _ } =>
                outcome_with_diagnostics(
                  value: list_snoc_item(
                    xs: done,
                    item: Edge { label: e.label, target: target }
                  ),
                  diagnostics: d
                )
            }
        }
      }) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: children, diagnostics: d } =>
          outcome_with_diagnostics(
            value: node_synthetic(
              kind: ComputationNode { behavior: Branch },
              children: children
            ),
            diagnostics: d
          )
      }
    TypeNode { connective: Atom { identity: _ } } => outcome_accepted(value: body)
    TypeNode { connective: Conj } => outcome_accepted(value: body)
    TypeNode { connective: Disj } => outcome_accepted(value: body)
    TypeNode { connective: Arrow } => outcome_accepted(value: body)
    TypeNode { connective: Cardinality } => outcome_accepted(value: body)
    TypeNode { connective: Instantiation } => outcome_accepted(value: body)
    ComputationNode { behavior: Value } => outcome_accepted(value: body)
    ComputationNode { behavior: Transform } => outcome_accepted(value: body)
    ComputationNode { behavior: Loop } => outcome_accepted(value: body)
    ComputationNode { behavior: Bind } => outcome_accepted(value: body)
    ComputationNode { behavior: Match } => outcome_accepted(value: body)
  }
}

// A BODY THAT IS ITSELF A FUNCTION VALUE (`fn f() -> fn(A) -> B { fn(a) { .. } }`, `x => y => ..`)
// passes through as its lowered Arrow: v2.std.node classify_arrow_body_form admits it as the
// v2.std.node ArrowBodyForm arm (not the grammar-level body sum of v2.compiler.fold_lowering), and
// the inner Arrow is well-formed by its own Arrow arm.
fn body_lower_reify_arrow_body(body: Node) -> Outcome<Node> {
  match body.kind {
    ComputationNode { behavior: Transform } => body_lower_reify_transform_body(body: body)
    ComputationNode { behavior: Branch } => body_lower_reify_branch_body(body: body)
    TypeNode { connective: Atom { identity: _ } } => outcome_accepted(value: body)
    TypeNode { connective: Conj } => outcome_accepted(value: body)
    TypeNode { connective: Disj } => outcome_accepted(value: body)
    TypeNode { connective: Arrow } => outcome_accepted(value: body)
    TypeNode { connective: Cardinality } => outcome_accepted(value: body)
    TypeNode { connective: Instantiation } => outcome_accepted(value: body)
    ComputationNode { behavior: Value } => outcome_accepted(value: body)
    ComputationNode { behavior: Loop } => outcome_accepted(value: body)
    ComputationNode { behavior: Bind } => outcome_accepted(value: body)
    ComputationNode { behavior: Match } => outcome_accepted(value: body)
  }
}

fn body_lower_if_navigation_reject<T>(captured: Node) -> Outcome<T> {
  outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_if_navigation_refused,
      n: captured
    )
  )
}

fn body_lower_materialize_int_literal_operand_optional(node: Node) -> Optional<Node> {
  match body_lower_int_literal_with_magnitude_optional(node: node) {
    Present { value: lit } => Present { value: lit }
    Absent =>
      match body_lower_literal_int_atom_optional(node: node) {
        Present { value: lit } => Present { value: lit }
        Absent =>
          match body_lower_unwrap_captured(shell: node) {
            Present { value: captured } =>
              body_lower_materialize_int_literal_operand_optional(node: captured)
            Absent =>
              let deep = body_lower_deep_unwrap_for_int_literal(node: node)
              match node_atom_identity_optional(node: deep) {
                Present { value: id } =>
                  match dag_node_is_int_literal_atom(node: deep) {
                    true =>
                      body_lower_int_literal_with_magnitude_optional(node: deep)
                    false =>
                      match integer_string_to_decimal_digits_optional(s: symbol_lexeme(sym: id)) {
                        Present { value: _ } =>
                          match dag_int_literal_node_from_lexeme(
                            lexeme: symbol_lexeme(sym: id),
                            occurrence_id: node.occurrence_id
                          ) {
                            Accepted { value: lit, diagnostics: _ } => optional_present(value: lit)
                            Rejected { diagnostics: _ } => optional_absent()
                          }
                        Absent => optional_absent()
                      }
                  }
                Absent => optional_absent()
              }
          }
      }
  }
}

// A refused operand under the arm is the arm's refusal (OperandRefRefused), never Absent: a caller
// that heard Absent tried the next reader, and the first-atom search behind it answered a part of the
// arm for the whole -- `b && (u)` read as `b`.
// A CAST IS READ WHOLE, NEVER AS ITS OPERAND: a reader that answered `x as Q` with `x` dropped `Q`
// (gunbc.recurring_failure_mode as_cast_has_no_lowered_form). The arm's postfix chain is lowered
// through the one chain fold, which builds the typed cast node or refuses at the authored type.
fn body_lower_arm_operand_resolved_read(arm: Node) -> OperandRefRead {
  match body_lower_find_captured(root: arm, emitted: ^dag_surface_postfix_expr) {
    ParseSubtreeFound { captured: postfix } =>
      match body_lower_cast_chain_read(node: postfix) {
        OperandRefAbsent => body_lower_arm_operand_resolved_uncast_read(arm: arm)
        OperandRefLowered { lowered: l } => OperandRefLowered { lowered: l }
        OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
      }
    ParseSubtreeAbsent => body_lower_arm_operand_resolved_uncast_read(arm: arm)
  }
}

fn body_lower_arm_operand_resolved_uncast_read(arm: Node) -> OperandRefRead {
  match body_lower_materialize_int_literal_operand_optional(node: arm) {
    Present { value: lit } => OperandRefLowered { lowered: lit }
    Absent =>
      match body_lower_literal_bool_atom_optional(node: arm) {
        Present { value: b } => OperandRefLowered { lowered: b }
        Absent =>
          match body_lower_operand_from_shell_read(shell: arm) {
            OperandRefLowered { lowered: op } =>
              match body_lower_materialize_int_literal_operand_optional(node: op) {
                Present { value: lit } => OperandRefLowered { lowered: lit }
                Absent =>
                  match body_lower_int_literal_with_magnitude_optional(node: op) {
                    Present { value: lit } => OperandRefLowered { lowered: lit }
                    Absent =>
                      if dag_node_is_int_literal_atom(
                        node: body_lower_deep_unwrap_for_int_literal(node: op)
                      ) {
                        OperandRefAbsent
                      } else {
                        OperandRefLowered { lowered: op }
                      }
                  }
              }
            OperandRefAbsent => OperandRefAbsent
            OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
          }
      }
  }
}


fn body_lower_if_expr_capture_optional(spine: Node) -> Optional<Node> {
  match body_lower_find_captured(root: spine, emitted: ^dag_surface_expr) {
    ParseSubtreeFound { captured: expr } => Present { value: expr }
    ParseSubtreeAbsent =>
      if is_empty_conj_root(n: spine) {
        Absent
      } else {
        match body_lower_match_spine_left(spine: spine) {
          Present { value: left } =>
            match body_lower_match_spine_right(spine: spine) {
              Present { value: right } =>
                match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
                  Present { value: id } =>
                    match (id == ^dag_token_kw_if) || (id == ^dag_token_kw_then) || (id == ^dag_token_kw_else) {
                      true => body_lower_if_expr_capture_optional(spine: right)
                      false =>
                        match body_lower_if_expr_capture_optional(spine: left) {
                          Present { value: found } => Present { value: found }
                          Absent => body_lower_if_expr_capture_optional(spine: right)
                        }
                    }
                  Absent =>
                    match body_lower_if_expr_capture_optional(spine: left) {
                      Present { value: found } => Present { value: found }
                      Absent => body_lower_if_expr_capture_optional(spine: right)
                    }
                }
              Absent => Absent
            }
          Absent => Absent
        }
      }
  }
}

// THE if_expr ROW IS READ BY POSITION, NEVER SEARCHED. v2.extdeps.languages.dag dag_grammar_if_expr_expr
// reads the head once and offers two forms after it: the block form seq(`if`, seq(cond, seq(fn_body,
// <else slot>))), whose else slot is seq(`else`, if_expr | fn_body) or the EMPTY node of an absent
// optional, and the then form seq(`if`, seq(cond, seq(`then`, seq(expr, seq(`else`, expr))))). Each
// arm is the element at its own slot, and an empty else slot answers IfRowNoElse -- said, never
// searched for and never read as a value (operator ruling 2026-10-03: an else-less if has no value). The readers this replaces SEARCHED the capture -- the else
// reader recursed into the LEFT subtree before the right whenever the token there was not `else`, so
// for `if b { if c { X } else { Y } } else { Z }` it entered the then-arm and answered the NESTED if's
// else `{ Y }` as the OUTER if's else: Z was dropped, Y lowered twice, and the module was ACCEPTED
// (gunbc.recurring_failure_mode else_arm_lowered_as_an_if_nested_inside_it, capture side). A capture
// that is neither row is Absent, and every caller refuses it as navigation, never guesses.
type IfRowElse
  = IfRowElsePart { else_part: Node }
  | IfRowNoElse

// `then_slot` is the arm's production shell as it stands in the row; `then_arm` its captured child,
// which the arm readers answer.
type IfRowArms {
  condition: Node,
  then_slot: Node,
  then_arm: Node,
  else_slot: IfRowElse,
}

fn body_lower_if_row_arms_optional(captured: Node) -> Optional<IfRowArms> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_if_row_slot_after_token(seq: spine, token: ^dag_token_kw_if) {
    Absent => optional_absent()
    Present { value: after_if } =>
      match body_lower_match_spine_right(spine: after_if) {
        Absent => optional_absent()
        Present { value: after_cond } =>
          match body_lower_if_row_slot_after_token(seq: after_cond, token: ^dag_token_kw_then) {
            Present { value: after_then } =>
              match body_lower_match_spine_left(spine: after_then) {
                Absent => optional_absent()
                Present { value: then_expr } =>
                  match body_lower_match_spine_right(spine: after_then) {
                    Absent => optional_absent()
                    Present { value: else_seq } =>
                      match body_lower_match_spine_left(spine: after_if) {
                        Absent => optional_absent()
                        Present { value: condition } =>
                          body_lower_if_row_with_else(condition: condition, then_slot: then_expr, else_seq: else_seq)
                      }
                  }
              }
            Absent =>
              match body_lower_match_spine_left(spine: after_cond) {
                Absent => optional_absent()
                Present { value: then_body } =>
                  match body_lower_match_spine_right(spine: after_cond) {
                    Absent => optional_absent()
                    Present { value: else_slot } =>
                      match body_lower_match_spine_left(spine: after_if) {
                        Absent => optional_absent()
                        Present { value: condition } =>
                          if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: else_slot)) {
                            optional_present(value: IfRowArms {
                              condition: condition,
                              then_slot: then_body,
                              then_arm: body_lower_if_row_captured(node: then_body),
                              else_slot: IfRowNoElse
                            })
                          } else {
                            body_lower_if_row_with_else(condition: condition, then_slot: then_body, else_seq: else_slot)
                          }
                      }
                  }
              }
          }
      }
  }
}

// seq(`else`, else_part): the else part, read as the arm readers have always answered it.
fn body_lower_if_row_with_else(condition: Node, then_slot: Node, else_seq: Node) -> Optional<IfRowArms> {
  match body_lower_if_row_slot_after_token(seq: else_seq, token: ^dag_token_kw_else) {
    Absent => optional_absent()
    Present { value: else_part } =>
      optional_present(value: IfRowArms {
        condition: condition,
        then_slot: then_slot,
        then_arm: body_lower_if_row_captured(node: then_slot),
        else_slot: IfRowElsePart { else_part: body_lower_if_row_else_arm(else_part: else_part) }
      })
  }
}

// seq(<token>, rest) -> rest, when the left element is exactly that keyword token.
fn body_lower_if_row_slot_after_token(seq: Node, token: Symbol) -> Optional<Node> {
  match body_lower_match_spine_left(spine: seq) {
    Absent => optional_absent()
    Present { value: left } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
        Present { value: id } =>
          if id == token { body_lower_match_spine_right(spine: seq) } else { optional_absent() }
        Absent => optional_absent()
      }
  }
}

// An arm slot holds one production (fn_body or expr); the arm readers answer its captured child.
fn body_lower_if_row_captured(node: Node) -> Node {
  let shell = body_lower_deep_unwrap_optional(node: node)
  match parse_production_captured_child_optional(node: shell) {
    Present { value: captured } => captured
    Absent => shell
  }
}

// An `else if` arm is answered as its if_expr SHELL, so body_lower_if_arm_lowered sees an if and
// lowers it whole; any other else part is its production's captured child.
fn body_lower_if_row_else_arm(else_part: Node) -> Node {
  match body_lower_else_part_if_expr_optional(else_part: else_part) {
    Present { value: nested } => nested
    Absent => body_lower_if_row_captured(node: else_part)
  }
}

// WHAT FOLLOWS `else` IS AN `else if` ONLY WHEN ITS FIRST PRODUCTION IS AN if_expr. The grammar
// makes the else part either an if_expr or a fn_body, so the first production shell under it -- found
// without descending into any production -- decides which. A deep search for any if_expr answered
// `else { match k { A => .. B => if c {..} else {..} } }` with the if NESTED in the match arm, and the
// arm lowered to that if alone: the scrutinee, the other arms and the patterns were dropped and the
// module accepted (gunbc.recurring_failure_mode else_arm_lowered_as_an_if_nested_inside_it).
fn body_lower_else_part_if_expr_optional(else_part: Node) -> Optional<Node> {
  match body_lower_first_production_shell_optional(root: else_part) {
    Present { value: shell } =>
      match parse_production_emitted_identity_optional(node: shell) {
        Present { value: id } => if id == ^dag_surface_if_expr { optional_present(value: shell) } else { optional_absent() }
        Absent => optional_absent()
      }
    Absent => optional_absent()
  }
}

// The first production shell under `root` in pre-order, never descending into a production.
fn body_lower_first_production_shell_optional(root: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: _ } => optional_present(value: root)
    Absent =>
      fold(root.children, init: optional_absent(), f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_first_production_shell_optional(root: e.target)
        }
      })
  }
}

fn body_lower_if_else_capture_optional(captured: Node) -> Optional<Node> {
  match body_lower_if_row_arms_optional(captured: captured) {
    Present { value: arms } => body_lower_if_row_else_part_optional(slot: arms.else_slot)
    Absent => optional_absent()
  }
}

fn body_lower_if_row_else_part_optional(slot: IfRowElse) -> Optional<Node> {
  match slot {
    IfRowElsePart { else_part: e } => optional_present(value: e)
    IfRowNoElse => optional_absent()
  }
}

// NAVIGATION ONLY: this finds the condition's CAPTURE, which body_lower_if_condition_lowered then lowers
// through the value reader. It used to answer a composite left element through the operand reader,
// handing back a LOWERED node where a capture is owed (and forgetting any refusal the operand reader
// made); the lowering belongs to the one value reader downstream, so that branch is deleted.
fn body_lower_if_condition_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match is_empty_conj_root(n: spine) {
    true => Absent
    false =>
      match body_lower_match_spine_left(spine: spine) {
      Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              Present { value: id } =>
                match id == ^dag_token_kw_if {
                  true => body_lower_if_expr_capture_optional(spine: right)
                  false =>
                    match body_lower_if_condition_optional(captured: left) {
                      Present { value: found } => Present { value: found }
                      Absent => body_lower_if_condition_optional(captured: right)
                    }
                }
              Absent =>
                match body_lower_if_condition_optional(captured: left) {
                  Present { value: found } => Present { value: found }
                  Absent => body_lower_if_condition_optional(captured: right)
                }
            }
          Absent => Absent
        }
      Absent => body_lower_if_expr_capture_optional(spine: spine)
      }
  }
}

fn body_lower_if_then_arm_optional(captured: Node) -> Optional<Node> {
  match body_lower_if_row_arms_optional(captured: captured) {
    Present { value: arms } => optional_present(value: arms.then_arm)
    Absent => optional_absent()
  }
}

fn body_lower_loop_navigation_reject(captured: Node) -> Outcome<Optional<Node>> {
  outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_loop_navigation_refused,
      n: captured
    )
  )
}

fn body_lower_let_navigation_reject(captured: Node) -> Outcome<Optional<Node>> {
  outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_let_navigation_refused,
      n: captured
    )
  )
}

// The binding name is the FIRST element of what follows `let` -- `let NAME = value` -- read off
// that position, never off the operand reader: body_lower_operand_ref_optional no longer narrows a
// sequence to its left element, which is what this reader used to lean on to find NAME.
fn body_lower_let_name_position(after_let: Node) -> Node {
  match sugar_sequence_pair_optional(node: after_let) {
    Present { value: pair } => pair.left
    Absent => after_let
  }
}

// v1's OTHER SPELLINGS OF A STATEMENT LET (v2.extdeps.languages.dag dag_grammar_let_sugar_expr):
// `node x: e` / `node x = e` and a bare `x = e`. Each names a binder and a value exactly as `let x = e`
// does and writes no annotation, so the three statement-let readers below consult this first and
// read the same two positions from it -- one reader of a let's parts, three spellings.
type BodyLowerLetSugar {
  name: Node,
  value: Node,
}

// Read by SHAPE, not by the head's spelling: the `node` head is a literal terminal, whose parse atom
// carries its token class rather than its lexeme. The two shapes are disjoint -- a bare assignment is
// seq(name, seq(`=`, value)); the node form is seq(head, seq(name, seq(`:`|`=`, value))) -- and the
// node form's head is required NOT to be `let`, so `let x: T = e` is never read as sugar (its
// annotation would otherwise be taken for the value).
fn body_lower_let_sugar_optional(captured: Node) -> Optional<BodyLowerLetSugar> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: body_lower_unwrap_surface_shell(node: captured))) {
    Absent => optional_absent()
    Present { value: head } =>
      match body_lower_let_sugar_after_name(name: head.left, rest: head.right, colon_admitted: false) {
        Present { value: bare } => optional_present(value: bare)
        Absent =>
          if body_lower_token_is(node: head.left, token: ^dag_token_kw_let) {
            optional_absent()
          } else {
            match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: head.right)) {
              Absent => optional_absent()
              Present { value: name_rest } => body_lower_let_sugar_after_name(name: name_rest.left, rest: name_rest.right, colon_admitted: true)
            }
          }
      }
  }
}

fn body_lower_token_is(node: Node, token: Symbol) -> Bool {
  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: node)) {
    Present { value: id } => id == token
    Absent => false
  }
}

// seq(separator, expr) after the name: `=` always, `:` only in the `node` form.
fn body_lower_let_sugar_after_name(name: Node, rest: Node, colon_admitted: Bool) -> Optional<BodyLowerLetSugar> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: rest)) {
    Absent => optional_absent()
    Present { value: sep_value } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: sep_value.left)) {
        Absent => optional_absent()
        Present { value: sep } =>
          if (sep == ^dag_token_eq) || (colon_admitted && (sep == ^dag_token_colon)) {
            match body_lower_param_binding_atom_optional(node: body_lower_deep_unwrap_optional(node: name)) {
              Absent => optional_absent()
              Present { value: _ } => optional_present(value: BodyLowerLetSugar { name: name, value: sep_value.right })
            }
          } else {
            optional_absent()
          }
      }
  }
}


// The let's key binding. The name is the projection of the binder atom below, which is lowered from
// the token it was read from so it keeps its minted occurrence (v2.compiler.occurrence_role reads it).
fn body_lower_let_in_key_binding_optional(captured: Node) -> Optional<Symbol> {
  match body_lower_let_in_key_binding_atom_optional(captured: captured) {
    Present { value: binder } => node_atom_identity_optional(node: binder)
    Absent => Absent
  }
}

fn body_lower_let_in_key_binding_atom_optional(captured: Node) -> Optional<Node> {
  match body_lower_let_sugar_optional(captured: captured) {
    Present { value: sugar } => body_lower_param_binding_atom_optional(node: body_lower_deep_unwrap_optional(node: sugar.name))
    Absent => body_lower_let_keyword_key_binding_atom_optional(captured: captured)
  }
}

fn body_lower_let_keyword_key_binding_atom_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            Present { value: id } =>
              if id == ^dag_token_kw_let {
                match body_lower_param_binding_atom_optional(node: body_lower_let_name_position(after_let: right)) {
                  Present { value: binder } => Present { value: binder }
                  Absent =>
                    match dag_binding_branded_atom_identity(node: right) {
                      Present { value: binding } =>
                        Present { value: node_lowered_from(kind: TypeNode { connective: Atom { identity: binding } }, children: [], source: right) }
                      Absent => Absent
                    }
                }
              } else {
                match body_lower_let_keyword_key_binding_atom_optional(captured: left) {
                  Present { value: found } => Present { value: found }
                  Absent => body_lower_let_keyword_key_binding_atom_optional(captured: right)
                }
              }
            Absent =>
              match body_lower_let_keyword_key_binding_atom_optional(captured: left) {
                Present { value: found } => Present { value: found }
                Absent => body_lower_let_keyword_key_binding_atom_optional(captured: right)
              }
          }
        Absent =>
          match body_lower_let_keyword_key_binding_atom_optional(captured: left) {
            Present { value: found } => Present { value: found }
            Absent => Absent
          }
      }
    Absent =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } =>
          match body_lower_let_keyword_key_binding_atom_optional(captured: pair.left) {
            Present { value: found } => Present { value: found }
            Absent => body_lower_let_keyword_key_binding_atom_optional(captured: pair.right)
          }
        Absent =>
          fold(spine.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lower_let_keyword_key_binding_atom_optional(captured: e.target)
            }
          })
      }
  }
}

fn body_lower_try_loop_expr_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  body_lower_try_loop_keyword_from_captured(captured: captured)
}

fn body_lower_try_loop_expr_from_node(node: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_loop_expr {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } =>
            body_lower_try_loop_expr_from_captured(captured: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: emitted) {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } => body_lower_try_loop_expr_from_node(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent => outcome_accepted(value: optional_absent())
  }
}

fn body_lower_loop_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_try_loop_expr_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              Accepted { value: lowered, diagnostics: d }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

// TWO REFUSALS, TWO CAUSES. This function had ONE reason standing over two
// states whose remedies differ, and that conflation is what made the
// boundary-4 door read as a malformed-input defect for as long as it did:
//
//   - a let node with NO captured child is malformed, and unsupported_form is
//     the honest cause;
//   - a WELL-FORMED statement-form let reaching here alone is not malformed at
//     all. Its body is its enclosing statement spine's remainder, which this
//     node cannot see, so it is "not lowerable FROM HERE", not "not lowerable".
//
// The statement form is lowered at dag_surface_stmt_seq, where both halves of
// the Bind are visible (body_lower_stmt_spine). Reaching this arm therefore
// means a statement-form let was met outside a statement spine, and the
// diagnostic now says so rather than accusing the source of being malformed.
//
// This is #8801's split (FoldCallStepFormUnresolved vs FoldCallStepShapeInvalid)
// on the neighbouring form. It is spelled as two reasons rather than as a
// four-state coproduct with a two-state projection because there is exactly
// ONE consumer of this result and it does not branch on the distinction --
// only the diagnostic does. A coproduct whose sole consumer immediately
// collapses it would be a second representation of a fact the reason symbol
// already carries.
// AN ANNOTATION BODY LOWERING CANNOT CARRY REFUSES; IT IS NEVER DROPPED. Dropping one made it
// invisible to v2.compiler.resolve, so `let y: Q = x` was Accepted with `Q` declared nowhere
// (gunbc.recurring_failure_mode body_type_annotation_dropped_before_resolve_in_v2). A statement
// let's annotation is now CARRIED on its Bind (v2.std.type_binder <type-annotation>, see
// body_lower_let_annotation_lowered); a type expression the lowering cannot read still refuses
// here, located at it. A fn literal's return annotation, that row's other route, is CARRIED as the
// literal's Arrow codomain (body_lower_function_value, gunbc#12210), so it is not refused.
fn body_lower_type_annotation_not_carried(at: Node) -> Outcome<Node> {
  outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_type_annotation_not_carried, n: at)
  )
}

// `let NAME : type_expr = value` -- the colon is the first element after NAME, read positionally the
// way the `<T>` slot is; the unannotated arm has `=` there.
fn body_lower_let_annotation_optional(captured: Node) -> Optional<Node> {
  match body_lower_let_sugar_optional(captured: captured) {
    Present { value: _ } => optional_absent()
    Absent => body_lower_let_keyword_annotation_optional(captured: captured)
  }
}

fn body_lower_let_keyword_annotation_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: body_lower_unwrap_surface_shell(node: captured)) {
    Absent => optional_absent()
    Present { value: after_let } =>
      match body_lower_fn_decl_spine_right(node: after_let) {
        Absent => optional_absent()
        Present { value: after_name } =>
          match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: after_name)) {
            Absent => optional_absent()
            Present { value: pair } =>
              match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: pair.left)) {
                Present { value: id } =>
                  if id == ^dag_token_colon {
                    match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: pair.right)) {
                      Present { value: type_rest } => optional_present(value: type_rest.left)
                      Absent => optional_present(value: pair.right)
                    }
                  } else {
                    optional_absent()
                  }
                Absent => optional_absent()
              }
          }
      }
  }
}

// A STATEMENT LET'S ANNOTATION, LOWERED AS A TYPE EXPRESSION -- the reader the cast target uses
// (body_lower_type_expr_lowered_optional). Absent when the let is unannotated; a written annotation
// the lowering cannot read refuses located at it, so an annotation is carried or refused, never lost.
fn body_lower_let_annotation_lowered(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_let_annotation_optional(captured: captured) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: annotation } =>
      match body_lower_type_expr_lowered_optional(node: annotation) {
        Absent =>
          outcome_rejected(
            d: body_lower_diagnostic(reason: ^body_lowering_reason_type_annotation_not_carried, n: annotation)
          )
        Present { value: lowered } => outcome_accepted(value: optional_present(value: lowered))
      }
  }
}

fn body_lower_let_bind(key_binding: Node, value: Node, body_binding: Node, annotation: Optional<Node>) -> Node {
  match annotation {
    Absent => lower_bind(key_binding: key_binding, value: value, body_binding: body_binding)
    Present { value: t } =>
      lower_bind_annotated(key_binding: key_binding, value: value, body_binding: body_binding, annotation: t)
  }
}

fn body_lower_let_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: _ } =>
      outcome_rejected(
        d: body_lower_diagnostic(
          reason: ^body_lowering_reason_let_body_not_reachable_from_node,
          n: shell
        )
      )
  }
}

// STATEMENT-FORM LET: THE BIND WHOSE BODY IS NOT INSIDE THE LET NODE.
//
// dag_grammar_let_expr is a CHOICE of two alternatives: `let n = e in e`,
// which carries its own body, and `let n [: T] = e`, which does not. The
// second is the ordinary statement form the corpus is written in, and its
// body is the REMAINDER OF THE ENCLOSING STATEMENT SEQUENCE -- a sibling of
// the let, not a descendant of it.
//
// body_lower_let_expr is handed the let node alone, so for the statement form
// it is being asked a question its input cannot answer: it looks for the `in`
// atom, does not find one, and reports the absence as unsupported_form. That
// is the boundary-4 door-holder on the compiler's own closure, measured
// through the transaction's diagnostic ledger.
//
// So the lowering belongs HERE, at dag_surface_stmt_seq, which is the only
// node from which both halves of the Bind are reachable. The spine the parser
// produces for a statement repeat is right-nested:
//
//   stmt_seq.captured = Conj
//     grammar_sequence_left_node_projection  -> stmt
//     grammar_sequence_right_node_projection -> Conj (the same shape, or empty)
//
// (executed against the real grammar, not inferred from the production rows).
// A let-headed spine becomes lower_bind(key, value, <the rest lowered>); the
// last statement in a spine is the block's value and lowers as it always has.
// The `in` form is untouched: it still carries its own body and still lowers
// through body_lower_let_expr, so this ADDS the missing case rather than
// forking the one that works.
fn body_lower_stmt_spine_head_optional(spine: Node) -> Optional<Node> {
  match find_named_child(root: spine, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: head, diagnostics: _ } => optional_present(value: head)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn body_lower_stmt_spine_rest_optional(spine: Node) -> Optional<Node> {
  match find_named_child(root: spine, name: ^grammar_sequence_right_node_projection) {
    Accepted { value: rest, diagnostics: _ } => optional_present(value: rest)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

// The captured child of a stmt shell, ONLY when it is a let production. Every let is a statement
// let: the `in` form was dropped from the grammar (v2.extdeps.languages.dag dag_grammar_let_expr).
fn body_lower_statement_let_captured_optional(stmt: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: stmt) {
    Absent => optional_absent()
    Present { value: inner } =>
      match parse_production_emitted_identity_optional(node: inner) {
        Absent => optional_absent()
        Present { value: emitted } =>
          if emitted == ^dag_surface_let_expr {
            match body_lower_unwrap_captured(shell: inner) {
              Absent => optional_absent()
              Present { value: captured } => optional_present(value: captured)
            }
          } else {
            optional_absent()
          }
      }
  }
}

// The value is whatever follows the FIRST `=` on the let's own spine, the one reader of that
// position.
fn body_lower_let_statement_value_optional(captured: Node) -> Optional<Node> {
  match body_lower_let_sugar_optional(captured: captured) {
    Present { value: sugar } => optional_present(value: sugar.value)
    Absent => body_lower_let_keyword_statement_value_optional(captured: captured)
  }
}

fn body_lower_let_keyword_statement_value_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Absent => optional_absent()
    Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        Absent => optional_absent()
        Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            Present { value: id } =>
              if id == ^dag_token_eq {
                optional_present(value: right)
              } else {
                body_lower_let_keyword_statement_value_optional(captured: right)
              }
            Absent => body_lower_let_keyword_statement_value_optional(captured: right)
          }
      }
  }
}


// AN ADMITTED GUARD LOWERS TO A BRANCH WHOSE ELSE IS THE REST OF THE SPINE: `if c { ..; return e }`
// followed by statements is Branch(c, <arm>, <rest>). Admission has two halves, owned in two places.
// That the arm ENDS IN A RETURN is checked here, by construction: the spine matches a guard only
// through body_lower_admitted_guard_optional and refuses any other else-less `if` it meets. That the
// guard sits in a TAIL spine is NOT checked here; it is established only by the wall
// (body_lower_exit_outside_tail_optional) having run first with tail: true, at the fn declaration and
// the fn value block body. A data initializer runs the same wall with tail: false, so any exit there
// refuses and no guard is admitted. Given both halves, the arm's value and the rest's value are each
// the enclosing function's result.
fn body_lower_guard_branch(guard: BodyLowerGuard, rest: Node) -> Outcome<Node> {
  bind_outcome(o: body_lower_value_read(value: guard.condition), f: fn(condition) {
    let arm_lowered = match body_lower_fn_body_stmt_seq_optional(fn_body: guard.arm) {
      Present { value: stmt_seq } => body_lower_stmt_seq(shell: stmt_seq)
      Absent => body_lower_else_less_if_reject(shell: guard.shell)
    }
    bind_outcome(o: arm_lowered, f: fn(then_arm) {
      bind_outcome(o: body_lower_stmt_spine(spine: rest), f: fn(else_arm) {
        outcome_accepted(value: lower_branch(condition: condition, then_arm: then_arm, else_arm: else_arm))
      })
    })
  })
}

// A LET WHOSE VALUE IS A MATCH WITH RETURNING ARMS, HEADING A TAIL SPINE, LOWERS TO THAT MATCH WITH
// THE REST OF THE SPINE UNDER ITS ONE BINDING ARM. `let x = match s { P { value: v } => v \n Absent =>
// return e }` followed by `rest` is Match(s, P { value: p } => Bind(x, p, rest), Absent => e): an arm
// whose tail is a return exits with its value, which in a tail spine IS the function's result -- the
// same fact the guard lowers through Branch (body_lower_guard_branch) -- and the binding arm binds x
// and continues; the Bind carries MatchArmScopeExitEdge, so resolve keeps the arm's binders out of
// the rest (body_lower_let_match_binding_arm_continued).
// `rest` is lowered ONCE and appears once, under the one binding arm, and the
// scrutinee is evaluated once; no new behavior kind and no carrier type. The language models the
// form: v1 infer leaves a diverging arm out of the match's join
// (test.claim.diverging_match_arm_join_witness). TWO OR MORE binding arms would each need `rest`, so
// rather than copy it per arm (a cost-shape defect) the form refuses
// multi_binding_arm_early_return_needs_join_point, located at the let; its trigger is v2 infer typing
// a local fn value, which admits one shared join point. A let-match with NO binding arm, a let-match
// outside a tail spine, and a return anywhere else in the let keep refusing return_not_in_tail_position.
type BodyLowerLetMatchArm {
  arm: Node
  body: Node
  exits: Bool
}

type BodyLowerLetMatchExit {
  scrutinee: Node
  arms: List<BodyLowerLetMatchArm>
}

// Peels a let value down to a match_expr shell when the match IS the whole value (no operator, no
// postfix after it); any other shape answers Absent and the let reads as an ordinary let.
fn body_lower_whole_match_shell_optional(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_match_expr {
        optional_present(value: node)
      } else if body_lower_is_pass_through_emitted(emitted: id) || (id == ^dag_surface_primary_expr) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: child } => body_lower_whole_match_shell_optional(node: child)
          Absent => optional_absent()
        }
      } else {
        optional_absent()
      }
    Absent =>
      let peeled = body_lower_deep_unwrap_optional(node: node)
      if peeled != node {
        body_lower_whole_match_shell_optional(node: peeled)
      } else {
        match sugar_sequence_pair_optional(node: node) {
          Present { value: pair } =>
            if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
              body_lower_whole_match_shell_optional(node: pair.left)
            } else {
              optional_absent()
            }
          Absent => optional_absent()
        }
      }
  }
}

// An arm exits when its body's tail statement is a return: the body itself for an expression body,
// the last statement of a statement body.
fn body_lower_match_arm_body_exits(body: Node) -> Bool {
  let tail_stmt = match body_lower_match_arm_statement_spine_optional(body_capture: body) {
    Present { value: spine } => body_lower_stmt_spine_last_optional(spine: spine)
    Absent => optional_present(value: body)
  }
  match tail_stmt {
    Absent => false
    Present { value: stmt } =>
      match body_lower_return_statement_expr_optional(stmt: stmt) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

// The raw arms of a let value's whole match, each with its body and whether it exits; Absent when
// the value is not a whole match, an arm or the scrutinee cannot be read (the ordinary let path and
// its wall then answer), or no arm exits.
fn body_lower_let_match_exit_plan_optional(value: Node) -> Optional<BodyLowerLetMatchExit> {
  match body_lower_whole_match_shell_optional(node: value) {
    Absent => optional_absent()
    Present { value: shell } =>
      match body_lower_unwrap_captured(shell: shell) {
        Absent => optional_absent()
        Present { value: captured } =>
          match body_lower_match_scrutinee_raw_optional(captured: captured) {
            Absent => optional_absent()
            Present { value: scrutinee } =>
              match body_lower_match_arm_items_after_lbrace_optional(spine: body_lower_unwrap_surface_shell(node: captured)) {
                Rejected { diagnostics: _ } => optional_absent()
                Accepted { value: Absent, diagnostics: _ } => optional_absent()
                Accepted { value: Present { value: items }, diagnostics: _ } =>
                  let read = fold(items, init: optional_present(value: Empty), f: fn(acc, item) {
                    match acc {
                      Absent => acc
                      Present { value: arms } =>
                        match body_lower_match_arm_body_capture_optional(stripped: body_lower_match_arm_stripped(arm: body_lower_deep_unwrap_optional(node: item))) {
                          Absent => optional_absent()
                          Present { value: body } =>
                            optional_present(value: list_snoc_item(xs: arms, item: BodyLowerLetMatchArm {
                              arm: item,
                              body: body,
                              exits: body_lower_match_arm_body_exits(body: body)
                            }))
                        }
                    }
                  })
                  match read {
                    Absent => optional_absent()
                    Present { value: arms } =>
                      if body_lower_let_match_exit_count(arms: arms) > 0 {
                        optional_present(value: BodyLowerLetMatchExit { scrutinee: scrutinee, arms: arms })
                      } else {
                        optional_absent()
                      }
                  }
              }
          }
      }
  }
}

fn body_lower_let_match_exit_count(arms: List<BodyLowerLetMatchArm>) -> Int {
  fold(arms, init: 0, f: fn(n, a) { if a.exits { n + 1 } else { n } })
}

fn body_lower_let_match_binding_count(plan: BodyLowerLetMatchExit) -> Int {
  count(plan.arms) - body_lower_let_match_exit_count(arms: plan.arms)
}

// The plan of a spine head that is a let whose value is a match with an exiting arm.
fn body_lower_let_match_exit_of_stmt_optional(stmt: Node) -> Optional<BodyLowerLetMatchExit> {
  match body_lower_statement_let_captured_optional(stmt: stmt) {
    Absent => optional_absent()
    Present { value: captured } =>
      match body_lower_let_statement_value_optional(captured: captured) {
        Absent => optional_absent()
        Present { value: value } => body_lower_let_match_exit_plan_optional(value: value)
      }
  }
}

// The lowered let-match: `lowered` is the value's lowered Match, its arms in the plan's order; the
// one binding arm continues into `rest` and every exiting arm keeps its value. Any other shape
// refuses -- the wall admitted exactly one binding arm, so a mismatch here is a lowering the plan
// does not describe, never a fallback.
fn body_lower_let_match_exit_join(plan: BodyLowerLetMatchExit, lowered: Node, at: Node, key_binding: Node, annotation: Optional<Node>, rest: Node) -> Outcome<Node> {
  if body_lower_let_match_binding_count(plan: plan) != 1 {
    outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_multi_binding_arm_early_return_needs_join_point, n: at))
  } else {
    if body_lower_is_match_node(node: lowered) {
        match node_positional_child_targets(node: lowered) {
          Empty => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_match_arm_navigation_refused, n: at))
          Cons { head: scrutinee, tail: wires } =>
            if count(wires) != count(plan.arms) {
              outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_match_arm_navigation_refused, n: at))
            } else {
              let joined = fold(wires, init: outcome_accepted(value: Empty), f: fn(acc, wire) {
                bind_outcome(o: acc, f: fn(done) {
                  match list_at_optional(xs: plan.arms, index: count(done)) {
                    Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_match_arm_navigation_refused, n: at))
                    Present { value: arm } =>
                      if arm.exits {
                        outcome_accepted(value: list_snoc_item(xs: done, item: wire))
                      } else {
                        bind_outcome(
                          o: body_lower_let_match_binding_arm_continued(wire: wire, at: at, key_binding: key_binding, annotation: annotation, rest: rest),
                          f: fn(continued) { outcome_accepted(value: list_snoc_item(xs: done, item: continued)) }
                        )
                      }
                  }
                })
              })
              bind_outcome(o: joined, f: fn(arms) { outcome_accepted(value: lower_match(scrutinee: scrutinee, arms: arms)) })
            }
        }
    } else {
      outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_match_arm_navigation_refused, n: at))
    }
  }
}

// Whether a lowered node is a Match computation; every kind is named, so a new behavior or connective
// is a compile error here rather than a silent no.
fn body_lower_is_match_node(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: _ } => false
    ComputationNode { behavior: b } =>
      match b {
        Match => true
        Value => false
        Transform => false
        Branch => false
        Loop => false
        Bind => false
      }
  }
}

// THE BINDING ARM CONTINUES INTO THE REST WITHOUT ITS PATTERN'S BINDERS REACHING IT. In the source
// the arm's binders are scoped to the arm's value, and the rest of the spine never sees them. The
// arm is lowered to Bind(x, value, rest) carrying v2.std.node MatchArmScopeExitEdge, and the pattern
// is left exactly as authored: whether a bare name in it is a binder or a nullary constructor is
// resolve's judgment, so lowering neither classifies nor renames it. Resolve
// (resolve_match_arm_admitted) resolves the value in the arm's scope and the binder and rest in the
// scope enclosing the match, judging both binder admissions against those authored scopes.
fn body_lower_let_match_binding_arm_continued(wire: Node, at: Node, key_binding: Node, annotation: Optional<Node>, rest: Node) -> Outcome<Node> {
  match list_at_optional(xs: wire.children, index: 0) {
    Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_match_arm_navigation_refused, n: at))
    Present { value: pat } =>
      match list_at_optional(xs: wire.children, index: 1) {
        Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_match_arm_navigation_refused, n: at))
        Present { value: body } =>
          outcome_accepted(value: body_lower_match_arm_wire(
            pat_node: pat.target,
            body: body_lower_arm_scope_exit_bind(
              bind: body_lower_let_bind(key_binding: key_binding, value: body.target, body_binding: rest, annotation: annotation)
            )
          ))
      }
  }
}

// The Bind with its MatchArmScopeExitEdge marker beside its positionals.
fn body_lower_arm_scope_exit_bind(bind: Node) -> Node {
  node_rebuild(
    n: bind,
    children: list_snoc_item(xs: bind.children, item: core_edge(marker: MatchArmScopeExitEdge, target: node_synthetic(kind: TypeNode { connective: Conj }, children: [])))
  )
}

fn body_lower_stmt_spine(spine: Node) -> Outcome<Node> {
  match body_lower_stmt_spine_head_optional(spine: spine) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(
          reason: ^body_lowering_reason_statement_spine_headless,
          n: spine
        )
      )
    Present { value: head } =>
      match body_lower_stmt_spine_rest_optional(spine: spine) {
        Absent => body_lower_tail_statement_read(stmt: head)
        Present { value: rest } =>
          match body_lower_stmt_spine_head_optional(spine: rest) {
            Absent => body_lower_tail_statement_read(stmt: head)
            Present { value: _ } =>
              match body_lower_admitted_guard_optional(stmt: head) {
                Present { value: guard } => body_lower_guard_branch(guard: guard, rest: rest)
                Absent =>
              match body_lower_guard_optional(stmt: head) {
                Present { value: unadmitted } => body_lower_else_less_if_reject(shell: unadmitted.shell)
                Absent =>
              match body_lower_statement_let_captured_optional(stmt: head) {
                Absent =>
                  outcome_rejected(
                    d: body_lower_diagnostic(
                      reason: match body_lower_return_statement_expr_optional(stmt: head) {
                        Present { value: _ } => ^body_lowering_reason_return_not_in_tail_position
                        Absent => ^body_lowering_reason_statement_precedes_without_binding
                      },
                      n: head
                    )
                  )
                Present { value: let_captured } =>
                  match body_lower_let_in_key_binding_optional(captured: let_captured) {
                    Absent =>
                      outcome_rejected(
                        d: body_lower_diagnostic(
                          reason: ^body_lowering_reason_let_binding_name_absent,
                          n: head
                        )
                      )
                    Present { value: key } =>
                      match body_lower_let_statement_value_optional(captured: let_captured) {
                        Absent =>
                          outcome_rejected(
                            d: body_lower_diagnostic(
                              reason: ^body_lowering_reason_let_bound_value_absent,
                              n: head
                            )
                          )
                        Present { value: value_capture } =>
                          bind_outcome(
                            o: body_lower_let_annotation_lowered(captured: let_captured),
                            f: fn(annotation) {
                              bind_outcome(
                                o: body_lower_value_read(value: value_capture),
                                f: fn(value) {
                                  bind_outcome(
                                    o: body_lower_stmt_spine(spine: rest),
                                    f: fn(body) {
                                      let key_binding = body_lower_type_atom_node(sym: key, source: let_captured)
                                      match body_lower_let_match_exit_plan_optional(value: value_capture) {
                                        Present { value: plan } =>
                                          body_lower_let_match_exit_join(plan: plan, lowered: value, at: head, key_binding: key_binding, annotation: annotation, rest: body)
                                        Absent =>
                                          outcome_accepted(
                                            value: body_lower_let_bind(
                                              key_binding: key_binding,
                                              value: value,
                                              body_binding: body,
                                              annotation: annotation
                                            )
                                          )
                                      }
                                    }
                                  )
                                }
                              )
                            }
                          )
                      }
                  }
              }
              }
              }
          }
      }
  }
}

// A SPINE WITH A FOLLOWING STATEMENT BELONGS TO body_lower_stmt_spine, WHATEVER ITS HEAD IS. The
// guard used to admit only a let-headed spine, so `{ c \n x }` fell to the expression walkers,
// which read the first statement and dropped `x` with no refusal -- an undeclared `x` resolved.
// body_lower_stmt_spine already owns the multi-statement answer: a let binds the rest, and any other
// statement that precedes another refuses as statement_precedes_without_binding, located at it. A
// one-statement spine keeps the path it had.
fn body_lower_stmt_spine_has_successor(spine: Node) -> Bool {
  match body_lower_stmt_spine_rest_optional(spine: spine) {
    Absent => false
    Present { value: rest } =>
      match body_lower_stmt_spine_head_optional(spine: rest) {
        Absent => false
        Present { value: _ } => true
      }
  }
}

// The fn-body walker's entry into the same lowering. body_lower_fold reaches
// a stmt_seq node directly; this path is handed the fn_body and has to find
// the spine first. Both end in body_lower_stmt_spine, so there is one
// statement-sequence authority and not two.
// A BODY THAT IS ONE FUNCTION VALUE -- `fn f(..) -> fn(A) -> B { fn(a) { .. } }` or `{ a => .. }` --
// lowers through the function-value producer, as the same value does as a tail statement or a let
// value (the fold lowers it through body_lower_function_value). The walker below reads expressions,
// so without this arm a body that is only a function value lowered to nothing and the fn retained.
fn body_lower_sole_function_value_statement(spine: Node) -> Outcome<Optional<Node>> {
  match body_lower_stmt_spine_head_optional(spine: spine) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: head } =>
      match body_lower_function_value_captured_optional(node: head) {
        Absent => outcome_accepted(value: optional_absent())
        Present { value: _ } =>
          bind_outcome(
            o: body_lower_value_read(value: head),
            f: fn(lowered) { outcome_accepted(value: optional_present(value: lowered)) }
          )
      }
  }
}

// A one-statement spine whose statement is a return is read by the spine, which recognises it,
// rather than by the expression walkers, which search past the keyword.
fn body_lower_stmt_spine_head_is_return(spine: Node) -> Bool {
  match body_lower_stmt_spine_head_optional(spine: spine) {
    Present { value: head } =>
      match body_lower_return_statement_expr_optional(stmt: head) {
        Present { value: _ } => true
        Absent => false
      }
    Absent => false
  }
}

fn body_lower_try_statement_spine(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_stmt_seq) {
    ParseSubtreeAbsent => outcome_accepted(value: optional_absent())
    ParseSubtreeFound { captured: spine } =>
      if body_lower_stmt_spine_has_successor(spine: spine) || body_lower_stmt_spine_head_is_return(spine: spine) {
        bind_outcome(
          o: body_lower_stmt_spine(spine: spine),
          f: fn(lowered) { outcome_accepted(value: optional_present(value: lowered)) }
        )
      } else {
        body_lower_sole_function_value_statement(spine: spine)
      }
  }
}

fn body_lower_stmt_seq(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(
          reason: ^body_lowering_reason_statement_spine_headless,
          n: shell
        )
      )
    Present { value: captured } => body_lower_stmt_spine(spine: captured)
  }
}

fn body_lower_try_loop_keyword_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            Present { value: id } =>
              if id == ^dag_token_kw_loop {
                match body_lower_materialize_int_literal_operand_optional(node: right) {
                  Present { value: lit } =>
                    outcome_accepted(
                      value: optional_present(
                        value: lower_loop(value: lit, bound: dag_loop_measure_node())
                      )
                    )
                  Absent =>
                    match body_lower_arm_operand_resolved_read(arm: right) {
                      OperandRefLowered { lowered: lit } =>
                        outcome_accepted(
                          value: optional_present(
                            value: lower_loop(value: lit, bound: dag_loop_measure_node())
                          )
                        )
                      OperandRefAbsent => body_lower_loop_navigation_reject(captured: captured)
                      OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
                    }
                }
              } else {
                match body_lower_try_loop_keyword_from_captured(captured: left) {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: left_found, diagnostics: ld } =>
                    match left_found {
                      Present { value: lowered } =>
                        outcome_with_diagnostics(
                          value: optional_present(value: lowered),
                          diagnostics: ld
                        )
                      Absent => body_lower_try_loop_keyword_from_captured(captured: right)
                    }
                }
              }
            Absent =>
              match body_lower_try_loop_keyword_from_captured(captured: left) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: left_found, diagnostics: ld } =>
                  match left_found {
                    Present { value: lowered } =>
                      outcome_with_diagnostics(
                        value: optional_present(value: lowered),
                        diagnostics: ld
                      )
                    Absent => body_lower_try_loop_keyword_from_captured(captured: right)
                  }
              }
          }
        Absent =>
          match sugar_sequence_pair_optional(node: spine) {
            Present { value: pair } =>
              match body_lower_try_loop_keyword_from_captured(captured: pair.left) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: left_found, diagnostics: ld } =>
                  match left_found {
                    Present { value: lowered } =>
                      outcome_with_diagnostics(
                        value: optional_present(value: lowered),
                        diagnostics: ld
                      )
                    Absent => body_lower_try_loop_keyword_from_captured(captured: pair.right)
                  }
              }
            Absent =>
              fold(spine.children, init: outcome_accepted(value: optional_absent()), f: fn(acc, e) {
                match acc {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: found, diagnostics: _ } =>
                    match found {
                      Present { value: _ } => acc
                      Absent => body_lower_try_loop_keyword_from_captured(captured: e.target)
                    }
                }
              })
          }
      }
    Absent =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } =>
          match body_lower_try_loop_keyword_from_captured(captured: pair.left) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: left_found, diagnostics: ld } =>
              match left_found {
                Present { value: lowered } =>
                  outcome_with_diagnostics(
                    value: optional_present(value: lowered),
                    diagnostics: ld
                  )
                Absent => body_lower_try_loop_keyword_from_captured(captured: pair.right)
              }
          }
        Absent =>
          fold(spine.children, init: outcome_accepted(value: optional_absent()), f: fn(acc, e) {
            match acc {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: found, diagnostics: _ } =>
                match found {
                  Present { value: _ } => acc
                  Absent => body_lower_try_loop_keyword_from_captured(captured: e.target)
                }
            }
          })
      }
  }
}

fn body_lower_try_loop_keyword_from_node(node: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_loop_expr {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } =>
            body_lower_try_loop_keyword_from_captured(captured: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if emitted == ^dag_surface_primary_expr {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } =>
            body_lower_try_loop_keyword_from_captured(captured: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: emitted) {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } => body_lower_try_loop_keyword_from_node(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent => outcome_accepted(value: optional_absent())
  }
}

// The condition is a value: lowered by the value reader, or refused at the condition under the
// value's own cause. An operand-reader fallback read a call condition
// `if content_hash_eq_structural(left: a, right: b) {..}` as its first argument atom, and its Absent
// was reported as if_navigation_refused; both are gone.
fn body_lower_if_condition_lowered(condition_capture: Node) -> Outcome<Optional<Node>> {
  match body_lower_value_read(value: condition_capture) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: condition, diagnostics: d } =>
      outcome_with_diagnostics(value: optional_present(value: condition), diagnostics: d)
  }
}

// AN ARM IS A STATEMENT SEQUENCE, SO IT LOWERS THROUGH THE STATEMENT AUTHORITY. The arms were read
// by body_lower_if_arm_operand_optional alone, the operand reader, which reads a call `g(p: x)` as
// `g`: an undeclared `x` in either arm reached no reference site, and a block arm kept only its
// first statement. An arm is `{` stmt_seq `}`, and body_lower_stmt_spine is the one authority for a
// statement sequence: one statement is folded whole, a let binds the rest, and any other statement
// followed by another refuses located. Its refusal is the arm's refusal. An `else if` arm is an
// if_expr, not a brace body -- a statement-sequence search there would find the nested then-arm --
// so it lowers through the if reader, and the nested if's refusal is the arm's refusal. It was read
// through body_lower_if_arm_operand_optional, which answers a refused nested if as Absent, so
// `else if a && (u) { .. }` lost `u` and the module resolved. There is no operand-reader fallback:
// body_lower_stmt_spine answers each statement through the value reader, so an arm is lowered or
// refused at the statement that did not lower.
fn body_lower_if_arm_lowered(arm_capture: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: arm_capture) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_if_expr {
        match body_lower_unwrap_captured(shell: arm_capture) {
          Present { value: captured } => body_lower_try_if_from_captured(captured: captured)
          Absent =>
            outcome_rejected(
              d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: arm_capture)
            )
        }
      } else {
        body_lower_if_arm_statements_lowered(arm_capture: arm_capture)
      }
    Absent => body_lower_if_arm_statements_lowered(arm_capture: arm_capture)
  }
}

fn body_lower_if_arm_statements_lowered(arm_capture: Node) -> Outcome<Optional<Node>> {
  let lowered = match body_lower_find_captured(root: arm_capture, emitted: ^dag_surface_stmt_seq) {
    ParseSubtreeFound { captured: spine } => body_lower_stmt_spine(spine: spine)
    ParseSubtreeAbsent => body_lower_value_read(value: arm_capture)
  }
  match lowered {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: arm, diagnostics: d } => outcome_with_diagnostics(value: optional_present(value: arm), diagnostics: d)
  }
}

fn body_lower_try_if_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_if_condition_optional(captured: captured) {
    Present { value: condition_capture } =>
      match body_lower_if_then_arm_optional(captured: captured) {
        Present { value: then_capture } =>
          match body_lower_if_else_capture_optional(captured: captured) {
            Present { value: else_capture } =>
              match body_lower_if_condition_lowered(condition_capture: condition_capture) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: condition_opt, diagnostics: _ } =>
                  match condition_opt {
                    Present { value: condition } =>
                      match body_lower_if_arm_lowered(arm_capture: then_capture) {
                        Rejected { diagnostics: r } => Rejected { diagnostics: r }
                        Accepted { value: then_opt, diagnostics: _ } =>
                          match then_opt {
                            Present { value: then_arm } =>
                              match body_lower_if_arm_lowered(arm_capture: else_capture) {
                                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                Accepted { value: else_opt, diagnostics: _ } =>
                                  match else_opt {
                                    Present { value: else_arm } =>
                                      outcome_accepted(
                                        value: optional_present(
                                          value: lower_branch(
                                            condition: condition,
                                            then_arm: then_arm,
                                            else_arm: else_arm
                                          )
                                        )
                                      )
                                    Absent => body_lower_if_navigation_reject(captured: else_capture)
                                  }
                              }
                            Absent => body_lower_if_navigation_reject(captured: then_capture)
                          }
                      }
                    Absent => body_lower_if_navigation_reject(captured: condition_capture)
                  }
              }
            Absent => body_lower_if_navigation_reject(captured: captured)
          }
        Absent => body_lower_if_navigation_reject(captured: captured)
      }
    Absent => body_lower_if_navigation_reject(captured: captured)
  }
}

fn body_lower_if_expr(shell: Node) -> Outcome<Node> {
  match body_lower_else_less_if_parts_optional(if_shell: shell) {
    Present { value: _ } => body_lower_else_less_if_reject(shell: shell)
    Absent => body_lower_if_expr_valued(shell: shell)
  }
}

fn body_lower_if_expr_valued(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_try_if_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              Accepted { value: lowered, diagnostics: d }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

fn body_lower_match_arm_items_from_brace_interior(interior: Node) -> Outcome<List<Node>> {
  let unwrapped = body_lower_postfix_optional_unwrap(node: interior)
  match sugar_sequence_pair_optional(node: unwrapped) {
    Present { value: pair } =>
      body_lower_match_arms_from_list(list_capture: body_lower_unwrap_optional_element(node: pair.left))
    Absent => body_lower_match_arms_from_list(list_capture: unwrapped)
  }
}

// THE ARM LIST IS A COMMA LIST, READ BY THE ONE COMMA-LIST READER. The grammar builds a match's
// arms with dag_grammar_comma_list_expr, the same production call arguments use, so
// body_lower_comma_list_items reads it: the first arm, then every element of the repeat (its
// optional comma and its arm), then the optional trailing comma, and a shape it cannot read refuses
// under match_arm_navigation_refused. It answers the RAW arms, in source order: the lowering wires
// each once (body_lower_match_arms_wired) and its Rejected stands, and the let-match exit plan
// (body_lower_let_match_exit_plan_optional) reads the same arms for which of them return -- one
// navigation, two readers. A hand-rolled collector used to re-decode this spine beside that reader,
// and it took the repeat's whole spine as ONE arm, so from the third arm on every arm was dropped
// with no diagnostic and the module accepted
// (gunbc.recurring_failure_mode match_arms_after_the_second_are_dropped_at_v2_body_lowering).
fn body_lower_match_arms_from_list(list_capture: Node) -> Outcome<List<Node>> {
  bind_outcome(
    o: body_lower_comma_list_items(
      list_capture: list_capture,
      shape_refusal: ^body_lowering_reason_match_arm_navigation_refused
    ),
    f: fn(items) {
      outcome_accepted(
        value: fold(items, init: Empty, f: fn(acc, item) {
          list_snoc_item(xs: acc, item: body_lower_postfix_optional_unwrap(node: item))
        })
      )
    }
  )
}

fn body_lower_match_arms_wired(items: List<Node>) -> Outcome<List<Node>> {
  fold_list(
    xs: items,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, item) {
      bind_outcome(
        o: acc,
        f: fn(arms) {
          bind_outcome(
            o: body_lower_wire_match_arm_capture(arm_capture: item),
            f: fn(arm) { outcome_accepted(value: list_snoc_item(xs: arms, item: arm)) }
          )
        }
      )
    }
  )
}

fn body_lower_match_spine_left(spine: Node) -> Optional<Node> {
  match find_named_child(root: spine, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: left, diagnostics: _ } => Present { value: left }
    Rejected { diagnostics: _ } =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } => Present { value: pair.left }
        Absent => Absent
      }
  }
}

fn body_lower_match_spine_right(spine: Node) -> Optional<Node> {
  match find_named_child(root: spine, name: ^grammar_sequence_right_node_projection) {
    Accepted { value: right, diagnostics: _ } => Present { value: right }
    Rejected { diagnostics: _ } =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } => Present { value: pair.right }
        Absent => Absent
      }
  }
}

// THE SCRUTINEE IS A VALUE, READ AS ONE. It was read by the operand reader alone, which before
// gunbc#12145 narrowed a call scrutinee `match nat_compare(a: x, b: y) {..}` to `nat_compare`,
// dropping its arguments, and after it answered Absent, so the whole match refused as
// match_arm_navigation_refused. The value goes through body_lower_value_lowered first -- the reader
// call arguments, field initializers and if-conditions use -- and the operand reader only for what
// that declines; a refusal either raises is the scrutinee's.
fn body_lower_match_scrutinee_value(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_value_lowered(node: node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Present { value: lowered }, diagnostics: d } =>
      outcome_with_diagnostics(value: optional_present(value: lowered), diagnostics: d)
    Accepted { value: Absent, diagnostics: _ } =>
      body_lower_operand_read_outcome(read: body_lower_operand_ref_read(node: node), diagnostics: None)
  }
}

// THE SCRUTINEE IS READ FROM ITS GRAMMAR POSITION: match_expr is seq(`match`, seq(binary_expr,
// seq(`{`, ..))), so it is the left of the spine's right, after the `match` keyword. It was found by
// searching the whole match subtree for the first binary_expr, then postfix_expr. On a fn body that
// is the scrutinee, because the parse is unfolded. A data initializer is folded bottom-up before its
// declaration is dispatched (body_lower_data_initializer_body), so its scrutinee's shell is already
// reduced, and the search found the next binary_expr, inside the first arm's body: `data d: Bool =
// match h(a) { X => true .. }` lowered to a match on `true` with `h` and `a` gone and the module
// accepted (gunbc.recurring_failure_mode
// data_initializer_match_reads_its_scrutinee_from_an_arm_at_v2_body_lowering). The position holds on
// both routes, and body_lower_match_scrutinee_value reads an unfolded shell and an already-lowered
// node alike (body_lower_value_lowered peels a lowered node first). A match whose spine is not headed
// by `match` answers Absent, which its caller refuses as match_arm_navigation_refused.
fn body_lower_match_scrutinee_optional(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_match_scrutinee_raw_optional(captured: captured) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: scrutinee } => body_lower_match_scrutinee_value(node: scrutinee)
  }
}

// The scrutinee's raw parse, at its grammar position; the lowering reads it as a value above, and
// the exit wall walks it as a non-tail position (body_lower_exit_walk_let_match).
fn body_lower_match_scrutinee_raw_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Absent => optional_absent()
    Present { value: head } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: head)) {
        Absent => optional_absent()
        Present { value: id } =>
          if id == ^dag_token_kw_match {
            match body_lower_match_spine_right(spine: spine) {
              Absent => optional_absent()
              Present { value: after_keyword } => body_lower_match_spine_left(spine: after_keyword)
            }
          } else {
            optional_absent()
          }
      }
  }
}

fn body_lower_match_arm_items_on_lbrace_token(id: Symbol, right: Node) -> Outcome<Optional<List<Node>>> {
  match id == ^dag_token_lbrace {
    true =>
      match body_lower_match_arm_items_from_brace_interior(interior: right) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: arms, diagnostics: d } =>
          if count(arms) > 0 {
            Accepted {
              value: optional_present(value: arms),
              diagnostics: d
            }
          } else {
            outcome_rejected(
              d: body_lower_diagnostic(
                reason: ^body_lowering_reason_match_arm_navigation_refused,
                n: right
              )
            )
          }
      }
    false => body_lower_match_arm_items_after_lbrace_optional(spine: right)
  }
}

fn body_lower_match_arm_items_after_lbrace_optional(spine: Node) -> Outcome<Optional<List<Node>>> {
  if is_empty_conj_root(n: spine) {
    outcome_accepted(value: optional_absent())
  } else {
    match body_lower_match_spine_left(spine: spine) {
      Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              Present { value: id } =>
                body_lower_match_arm_items_on_lbrace_token(id: id, right: right)
              Absent =>
                body_lower_match_arm_items_after_lbrace_optional(spine: right)
            }
          Absent => outcome_accepted(value: optional_absent())
        }
      Absent => outcome_accepted(value: optional_absent())
    }
  }
}

// The arms after the `{`, each wired once; a raw arm list the reader cannot find answers Absent.
fn body_lower_match_arms_after_lbrace_optional(spine: Node) -> Outcome<Optional<List<Node>>> {
  bind_outcome(o: body_lower_match_arm_items_after_lbrace_optional(spine: spine), f: fn(items_opt) {
    match items_opt {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: items } =>
        bind_outcome(o: body_lower_match_arms_wired(items: items), f: fn(arms) {
          outcome_accepted(value: optional_present(value: arms))
        })
    }
  })
}

fn body_lower_match_arms_optional(captured: Node) -> Outcome<Optional<List<Node>>> {
  body_lower_match_arms_after_lbrace_optional(
    spine: body_lower_unwrap_surface_shell(node: captured)
  )
}

fn body_lower_try_match_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_match_scrutinee_optional(captured: captured) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Absent, diagnostics: _ } =>
      outcome_rejected(
        d: body_lower_diagnostic(
          reason: ^body_lowering_reason_match_arm_navigation_refused,
          n: captured
        )
      )
    Accepted { value: Present { value: scrutinee }, diagnostics: _ } =>
      match body_lower_match_arms_optional(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: arms_opt, diagnostics: d } =>
          match arms_opt {
            Present { value: arms } =>
              if count(arms) > 0 {
                Accepted {
                  value: optional_present(value: lower_match(scrutinee: scrutinee, arms: arms)),
                  diagnostics: d
                }
              } else {
                outcome_rejected(
                  d: body_lower_diagnostic(
                    reason: ^body_lowering_reason_match_arm_navigation_refused,
                    n: captured
                  )
                )
              }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(
                  reason: ^body_lowering_reason_match_arm_navigation_refused,
                  n: captured
                )
              )
          }
      }
  }
}

fn body_lower_match_spine_has_lbrace(spine: Node) -> Bool {
  match body_lower_match_arm_items_after_lbrace_optional(spine: spine) {
    Rejected { diagnostics: _ } => true
    Accepted { value: arms_opt, diagnostics: _ } =>
      match arms_opt {
        Present { value: _ } => true
        Absent => false
      }
  }
}

fn body_lower_match_capture_heads_spine(spine: Node) -> Bool {
  match body_lower_match_spine_left(spine: spine) {
    Present { value: left } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
        Present { value: id } =>
          if id == ^dag_token_kw_match {
            match body_lower_match_spine_right(spine: spine) {
              Present { value: right } => body_lower_match_spine_has_lbrace(spine: right)
              Absent => false
            }
          } else {
            false
          }
        Absent => false
      }
    Absent => false
  }
}

fn body_lowering_match_spine_identity_absent_fixture_spine() -> Node {
  let match_kw = node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^dag_token_kw_match } },
    children: []
  )
  let lbrace = node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^dag_token_lbrace } },
    children: []
  )
  let empty_interior = node_synthetic(kind: TypeNode { connective: Conj }, children: [])
  let braced = node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Authored { name: ^grammar_sequence_left_node_projection },
        target: lbrace
      },
      Edge {
        label: Authored { name: ^grammar_sequence_right_node_projection },
        target: empty_interior
      }
    ]
  )
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Authored { name: ^grammar_sequence_left_node_projection },
        target: match_kw
      },
      Edge {
        label: Authored { name: ^grammar_sequence_right_node_projection },
        target: braced
      }
    ]
  )
}

fn body_lowering_match_spine_identity_absent_sniff_holds() -> Bool {
  body_lower_match_capture_heads_spine(
    spine: body_lowering_match_spine_identity_absent_fixture_spine()
  )
}

fn body_lowering_match_field_name_spine() -> Node {
  let match_kw = node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^dag_token_kw_match } },
    children: []
  )
  let empty_suffix = node_synthetic(kind: TypeNode { connective: Conj }, children: [])
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Authored { name: ^grammar_sequence_left_node_projection },
        target: match_kw
      },
      Edge {
        label: Authored { name: ^grammar_sequence_right_node_projection },
        target: empty_suffix
      }
    ]
  )
}

fn body_lowering_match_field_name_spine_does_not_sniff_holds() -> Bool {
  !body_lower_match_capture_heads_spine(spine: body_lowering_match_field_name_spine())
}

fn body_lowering_match_spine_identity_absent_dispatch_holds() -> Bool {
  let fixture = body_lowering_match_spine_identity_absent_fixture_spine()
  if !body_lower_match_capture_heads_spine(spine: fixture) {
    false
  } else {
    match body_lower_fold_reduce(node: fixture) {
      Rejected { diagnostics: _ } => false
      Accepted { value: reduced, diagnostics: _ } =>
        match body_lower_fold_identity_absent(node: fixture) {
          Rejected { diagnostics: _ } => true
          Accepted { value: dispatched, diagnostics: _ } =>
            body_lower_is_core_substrate(node: dispatched) || dispatched != reduced
        }
    }
  }
}

fn body_lower_match_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_try_match_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              Accepted { value: lowered, diagnostics: d }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

// A postfix with NO suffix over an already-lowered primary is that primary: a construct (or any
// core substrate) the primary produced passes through whole, instead of the first-atom fallback
// below answering its tag.
fn body_lower_postfix_lowered_primary_optional(captured: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Absent
    Present { value: pair } =>
      if body_lower_is_core_substrate(node: pair.left)
        && is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
        optional_present(value: pair.left)
      } else {
        optional_absent()
      }
  }
}

// A CAST IN A CHAIN THIS READ DECLINES IS REFUSED, NOT DECLINED: the arms behind the door read the
// head and not the suffixes, so declining would drop the cast. The carried suffix is the refusal's
// cause and locus.
fn body_lower_postfix_chain_carries_as_suffix(node: Node) -> Bool {
  match sugar_sequence_pair_optional(node: body_lower_unwrap_surface_shell(node: node)) {
    Absent => false
    Present { value: pair } => body_lower_postfix_repeat_carries_as_suffix(repeat_capture: pair.right)
  }
}

fn body_lower_postfix_repeat_carries_as_suffix(repeat_capture: Node) -> Bool {
  if is_empty_conj_root(n: repeat_capture) {
    false
  } else {
    match body_lower_postfix_repeat_head_optional(repeat_capture: repeat_capture) {
      Absent => false
      Present { value: repeat_elem } =>
        match body_lower_as_suffix_type_optional(repeat_elem: repeat_elem) {
          Present { value: _ } => true
          Absent =>
            match body_lower_seq_child(node: repeat_capture, name: ^grammar_sequence_right_node_projection) {
              Present { value: rest } => body_lower_postfix_repeat_carries_as_suffix(repeat_capture: rest)
              Absent => false
            }
        }
    }
  }
}

// as_suffix = seq(kw_as, type_expr): answers the type expression when the element is a cast.
fn body_lower_as_suffix_type_optional(repeat_elem: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: repeat_elem)) {
    Absent => optional_absent()
    Present { value: pair } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: pair.left)) {
        Present { value: id } =>
          if id == ^dag_token_kw_as { optional_present(value: pair.right) } else { optional_absent() }
        Absent => optional_absent()
      }
  }
}

fn body_lower_postfix_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_postfix_lowered_primary_optional(captured: captured) {
        Present { value: lowered } => outcome_accepted(value: lowered)
        Absent =>
      match body_lower_dotted_chain_lowered_optional(node: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: Present { value: spine }, diagnostics: _ } => outcome_accepted(value: spine)
        Accepted { value: Absent, diagnostics: _ } =>
      match body_lower_value_sole_atom_optional(node: captured) {
        Present { value: atom } => outcome_accepted(value: atom)
        Absent =>
      match body_lower_try_infix_transform(node: captured) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: Present { value: transform }, diagnostics: _ } => outcome_accepted(value: transform)
                Accepted { value: Absent, diagnostics: _ } =>
                  match body_lower_try_fold_loop(node: captured) {
                    Rejected { diagnostics: _ } =>
                      body_lower_try_operand_or_reject(shell: shell, captured: captured)
                    Accepted { value: fold_result, diagnostics: fd } =>
                      match fold_result {
                        Present { value: loop_node } =>
                          outcome_with_diagnostics(value: loop_node, diagnostics: fd)
                        Absent =>
                          match body_lower_try_operand_or_reject(shell: shell, captured: captured) {
                            Rejected { diagnostics: r } =>
                              Rejected { diagnostics: rejected_with_pending(pending: fd, rejected: r) }
                            Accepted { value: v, diagnostics: od } =>
                              outcome_with_diagnostics(
                                value: v,
                                diagnostics: diagnostics_merge(outer: fd, inner: od)
                              )
                          }
                      }
                  }
              }
      }
  }
  }
  }
}


// A RECORD LITERAL LOWERS TO THE CONSTRUCT. primary_expr's captured for `R { f: e, .. }` is
// seq(name, seq(`{`, seq(field_init,*, `}`))); each field_init shell, preserved by the child fold
// around its already-lowered value, is seq(name, seq(`:`, value)). The result is
// v2.std.node_query construct_node -- Conj { R: Atom(R), f: e, .. } -- the RecordConstructBody
// shape v2.std.node admits and the shape a fielded pattern lowers to, so `Rec { n: 1 }` and
// `Rec { n: x } =>` are one shape read in two directions. A dotted head (`m.R { .. }`) is a postfix
// chain and reaches the same builder, body_lower_record_construct, through its PostfixRecord step.
// A STRING-KEYED INIT IS NOT A RECORD FIELD, AND THE PARSE SAYS SO. The key's kind is the grammar's
// choice, carried as the production identity ^dag_surface_field_init_string_key
// (v2.extdeps.languages.dag dag_grammar_field_init_expr), so a record literal refuses it at the item
// rather than reading `{ "n": true }` as field `n`. Admitting a quoted key whose decoded text names a
// declared field is a declared frontier (gunbc#12740); a map literal's entry is the map arm's
// (gunbc#12758), which dispatches on this same identity.
fn body_lower_field_init_is_string_keyed(item: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: body_lower_deep_unwrap_optional(node: item)) {
    Present { value: id } => id == ^dag_surface_field_init_string_key
    Absent => false
  }
}

fn body_lower_field_init_edge(item: Node) -> Outcome<Edge> {
  let stripped = body_lower_deep_unwrap_optional(node: item)
  let captured = match parse_production_captured_child_optional(node: stripped) {
    Present { value: c } => c
    Absent => stripped
  }
  let refuse = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_init_unlowered, n: item)
  )
  if body_lower_field_init_is_string_keyed(item: captured) {
    body_lower_map_literal_entry_edge_from_item(captured: captured, item: item, refuse: refuse)
  } else {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => refuse
    Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        Absent => refuse
        Present { value: field_name } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => refuse
            Present { value: after_colon } =>
              match body_lower_value_read(value: after_colon.right) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: value, diagnostics: d } =>
                  outcome_with_diagnostics(
                    value: Edge { label: Authored { name: field_name }, target: value },
                    diagnostics: d
                  )
              }
          }
      }
  }
  }
}

// A STRING-KEYED ITEM `"k": v` (a map literal's entry), recognised by the grammar's own production
// (body_lower_field_init_is_string_keyed, the one reader). Its key is lowered as the VALUE any string
// literal lowers to, never read as a field name, so the key's kind survives to resolve
// (docs/plans/map-literal-introduction-design.md).
fn body_lower_map_literal_entry_edge_from_item(captured: Node, item: Node, refuse: Outcome<Edge>) -> Outcome<Edge> {
  match sugar_sequence_pair_optional(node: parse_production_captured_child_optional_or_self(node: captured)) {
    Absent => refuse
    Present { value: pair } =>
      match body_lower_value_read(value: pair.left) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: key, diagnostics: _ } => body_lower_map_literal_entry_edge(key: key, after_key: pair.right, item: item, refuse: refuse)
      }
  }
}

fn parse_production_captured_child_optional_or_self(node: Node) -> Node {
  match parse_production_captured_child_optional(node: body_lower_deep_unwrap_optional(node: node)) {
    Present { value: c } => c
    Absent => node
  }
}

// The entry edge: v2.std.node CoreEdgeLabel MapLiteralEntryEdge, targeting a tag-elided construct
// carrying `key` and `value`. Only resolve's map arm reads it.
fn body_lower_map_literal_entry_edge(key: Node, after_key: Node, item: Node, refuse: Outcome<Edge>) -> Outcome<Edge> {
  match sugar_sequence_pair_optional(node: after_key) {
    Absent => refuse
    Present { value: after_colon } =>
      match body_lower_value_read(value: after_colon.right) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: value, diagnostics: d } =>
          outcome_with_diagnostics(
            value: Edge {
              label: core_edge_label(marker: MapLiteralEntryEdge),
              target: close_lowered_image(root: construct_node_elided(
                field_edges: [
                  Edge { label: Authored { name: ^key }, target: key },
                  Edge { label: Authored { name: ^value }, target: value }
                ],
                source: item
              ))
            },
            diagnostics: d
          )
      }
  }
}

// A brace already known to be all string keys (body_lower_brace_key_kinds_refusal_optional ran
// first) carries its pairs on ONE edge, a list literal of them in authored order; any other brace
// is returned as it is.
fn body_lower_map_literal_entries_collapsed(edges: List<Edge>, source: Node) -> List<Edge> {
  let pairs = fold(edges, init: [], f: fn(acc, e) {
    if labeled_core_is(x: e, label_of: edge_label_of, wanted: MapLiteralEntryEdge) { list_snoc_item(xs: acc, item: e.target) } else { acc }
  })
  match pairs {
    Empty => edges
    Cons { head: _, tail: _ } =>
      [core_edge(marker: MapLiteralEntriesEdge, target: lower_list_introduction(elements: pairs, source: source))]
  }
}

// ONE KIND OF KEY PER BRACE, AND STRING KEYS ONLY WITHOUT A HEAD. Lowering does not choose record or
// map, but it can see a brace no choice could type: a constructor head over string keys
// (`R { "k": v }`), or a headless brace mixing name keys and string keys. Each refuses at the first
// item of the offending kind.
fn body_lower_brace_key_kinds_refusal_optional(reference: Node, edges: List<Edge>) -> Optional<Edge> {
  let headless = match construct_tag_reading_of_target(target: reference) {
    ConstructTagElided => true
    ConstructTagAuthored { reference: _ } => false
    NotAConstruct => false
  }
  let first_entry = fold(edges, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => if labeled_core_is(x: e, label_of: edge_label_of, wanted: MapLiteralEntryEdge) { optional_present(value: e) } else { optional_absent() }
    }
  })
  let first_field = fold(edges, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => if labeled_core_is(x: e, label_of: edge_label_of, wanted: MapLiteralEntryEdge) { optional_absent() } else { optional_present(value: e) }
    }
  })
  match first_entry {
    Absent => optional_absent()
    Present { value: entry } =>
      if headless {
        first_field
      } else {
        optional_present(value: entry)
      }
  }
}

// The field items of a brace record body, `{ field_init, .. }`. One reader for both heads: a bare
// name's brace suffix (primary_expr) and a dotted chain's final brace suffix
// (dag_grammar_postfix_dot_suffix_expr takes the same ident suffix), so the qualified and the
// unqualified construct read their fields through one production.
fn body_lower_record_brace_items_optional(brace: Node) -> Optional<List<Node>> {
  match sugar_sequence_pair_optional(node: brace) {
    Absent => Absent
    Present { value: brace_seq } =>
      match node_atom_identity_optional(node: brace_seq.left) {
        Absent => Absent
        Present { value: open } =>
          if open == ^dag_token_lbrace {
            match sugar_sequence_pair_optional(node: brace_seq.right) {
              Absent => Absent
              Present { value: inner } =>
                match node_atom_identity_optional(node: inner.right) {
                  Absent => Absent
                  Present { value: close } =>
                    if close == ^dag_token_rbrace {
                      body_lower_comma_list_items_optional(list_capture: inner.left)
                    } else {
                      Absent
                    }
                }
            }
          } else {
            Absent
          }
      }
  }
}

fn body_lower_record_literal_field_items_optional(captured: Node) -> Optional<List<Node>> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Absent
    Present { value: pair } => body_lower_record_brace_items_optional(brace: pair.right)
  }
}

// THE ONE CONSTRUCT BUILDER, AND IT CLOSES ITS IMAGE (v2.std.node close_lowered_image): the Conj keeps
// the source's minted occurrence, and a member built from that same source -- the elided tag
// reference and its empty target (v2.std.node_query construct_tag_elided_reference) -- becomes
// pending and is allocated an OccurrenceProjected. The close sits here and not in construct_node,
// because resolve's map arm (v2.std.map_introduction lower_map_introduction) also builds constructs,
// after normalize's allocator has run. Every record construction reaches it with its constructor REFERENCE
// already built from the authored segments -- a one-segment spine for `R { .. }`, the whole path for
// `a.b.R { .. }` -- so the tag is never trimmed to its last segment and never resolved here;
// v2.compiler.resolve binds it by identity.
fn body_lower_record_construct(reference: Node, items: List<Node>, source: Node) -> Outcome<Node> {
  match fold(items, init: outcome_accepted(value: Empty), f: fn(acc, item) {
    bind_outcome(o: acc, f: fn(edges) {
      bind_outcome(o: body_lower_field_init_edge(item: item), f: fn(e) {
        outcome_accepted(value: list_snoc_item(xs: edges, item: e))
      })
    })
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: edges, diagnostics: d } =>
      match body_lower_brace_key_kinds_refusal_optional(reference: reference, edges: edges) {
        Present { value: offending } =>
          outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_brace_key_kind_mismatch, n: offending.target))
        Absent =>
      Accepted {
        value: close_lowered_image(root: construct_node(reference: reference, field_edges: body_lower_map_literal_entries_collapsed(edges: edges, source: source), source: source)),
        diagnostics: d
      }
      }
  }
}

// A bare constructor name is the one-segment case of the reference: the segment atom is lowered from
// the tag token, and the spine root carries that token's occurrence, which is the locus a resolved
// reference keeps.
fn body_lower_bare_tag_reference(tag: Symbol, at: Node) -> Node {
  body_lower_qualified_name_spine_node(
    segments: [node_lowered_from(kind: TypeNode { connective: Atom { identity: tag } }, children: [], source: at)],
    source: at
  )
}

// The tag is read with the atom it was read from, so the construct's tag atom can be lowered from
// that token rather than from the whole capture (v2.std.node_query construct_tag_edge).
type RecordLiteralTag {
  tag: Symbol
  at: Node
}

fn body_lower_record_literal_tag_optional(captured: Node) -> Optional<RecordLiteralTag> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Absent
    Present { value: pair } =>
      match dag_binding_branded_atom_identity(node: pair.left) {
        Present { value: tag } =>
          match dag_lex_token_symbol(sym: tag) {
            true => optional_absent()
            false => optional_present(value: RecordLiteralTag { tag: tag, at: pair.left })
          }
        Absent => Absent
      }
  }
}

// AN ANONYMOUS RECORD LITERAL `{ f: v }` names no constructor, and lowering does not choose one:
// the constructor is the EXPECTED type's, which only resolve reads from an authored annotation. So
// it lowers through the one construct builder with its tag ELIDED
// (v2.std.node_query construct_tag_elided_reference), and resolve's construct-tag writer either
// writes the expected record's reference or refuses located
// (docs/plans/anonymous-record-literal-design.md). The field set is never consulted to choose. A
// string-keyed brace (a map literal) carries its pairs on one MapLiteralEntriesEdge edge; resolve's map arm reads
// it (docs/plans/map-literal-introduction-design.md).
fn body_lower_try_headless_record_literal(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_record_brace_items_optional(brace: captured) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: items } =>
      bind_outcome(
        o: body_lower_record_construct(
          reference: construct_tag_elided_reference(source: captured),
          items: items,
          source: captured
        ),
        f: fn(construct) { outcome_accepted(value: optional_present(value: construct)) }
      )
  }
}

fn body_lower_try_record_literal(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_record_literal_tag_optional(captured: captured) {
    Absent => body_lower_try_headless_record_literal(captured: captured)
    Present { value: read } =>
      match body_lower_record_literal_field_items_optional(captured: captured) {
        Absent => outcome_accepted(value: optional_absent())
        Present { value: items } =>
          match body_lower_record_construct(
            reference: body_lower_bare_tag_reference(tag: read.tag, at: read.at),
            items: items,
            source: captured
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: construct, diagnostics: d } =>
              Accepted { value: optional_present(value: construct), diagnostics: d }
          }
      }
  }
}

// The literal probe at the head is SHALLOW on purpose: it answers a primary whose captured IS
// an int literal, through production shells and optionals only. The deep search that stood
// here answered the first literal anywhere under the captured, so `f(1)`, `A(1)` and
// `R { v: 1 }` each lowered to the literal 1 with the callee, constructor and fields dropped.
// A PARENTHESISED GROUP IS ITS INNER EXPRESSION. dag_grammar_primary_expr_core writes it as
// seq(lparen, seq(expr, rparen)); this answers the expr when the node is exactly that shape. Before it
// was read, body_lower_primary_expr answered the group with body_lower_pattern_first_atom_optional --
// its first atom, the `(` token -- so `(u)` lowered to `(` and `u` reached no reference site.
fn body_lower_node_is_token(node: Node, token: Symbol) -> Bool {
  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: node)) {
    Present { value: id } => id == token
    Absent => false
  }
}

fn body_lower_paren_group_inner_optional(node: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_unwrap_surface_shell(node: node)) {
    Absent => optional_absent()
    Present { value: pair } =>
      if body_lower_node_is_token(node: pair.left, token: ^dag_token_lparen) {
        match sugar_sequence_pair_optional(node: pair.right) {
          Absent => optional_absent()
          Present { value: rest } =>
            if body_lower_node_is_token(node: rest.right, token: ^dag_token_rparen) {
              optional_present(value: rest.left)
            } else {
              optional_absent()
            }
        }
      } else {
        optional_absent()
      }
  }
}

// The group's inner expression has already been through the bottom-up fold, so it is read as the
// value it lowered to; one it did not lower refuses at the group.
fn body_lower_paren_group_lowered(group: Node, inner: Node) -> Outcome<Node> {
  match body_lower_lowered_behind_shells_read(node: inner) {
    OperandRefLowered { lowered: lowered } => outcome_accepted(value: lowered)
    OperandRefAbsent =>
      match body_lower_operand_ref_read(node: inner) {
        OperandRefLowered { lowered: operand } => outcome_accepted(value: operand)
        OperandRefAbsent =>
          outcome_rejected(
            d: body_lower_diagnostic(reason: ^body_lowering_reason_paren_group_unread, n: group)
          )
        OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
      }
    OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
  }
}

// A LIST LITERAL IS THE FLAT FREE-MONOID INTRODUCTION (DESIGN section 4). `List<T>` is
// std.algebra FreeMonoid<T> (dag/std/algebra.dag), and `[e1, .., en]` lowers to ONE Transform whose
// head is the reference to that declaration and whose remaining positional children are the
// elements in order; `[]` is the Transform with the head alone. The authority for the shape is
// std.literal_elaboration UnicodeScalarSequenceUnfold, which carries a text's image as "the
// language's canonical FreeMonoid introduction (the list-literal node)" with one element per
// operand and REJECTS a cons^n nesting: O(n^2) under a sequence-backed carrier, and n deep it
// exceeds the emitter's bounded recursion fuel on ordinary literals. (gunbc#12208 first lowered to a
// right-nested list_append over singletons; that forked this authority and was reversed.) The head
// is the declaring qualified name as a spine -- resolve binds it through its qualified door and
// mints it as a resolved reference -- and it names std.algebra, NOT v2.std.algebra: v2.std.algebra
// imports v2.std.node, so a list literal in v2.std.node referring to v2.std.algebra would close a
// node -> algebra -> node cycle, and v2 collapses onto dag/std, not the reverse. The Transform is
// not an application: 04_infer types it by its one introduction case
// (v2.compiler.infer infer_transform_freemonoid_introduction), every element unifying to one T. The
// shape itself -- head path, constructor and reader -- is v2.std.list_introduction
// lower_list_introduction and list_introduction_elements_optional, one authority for both sides.
// The grammar writes the literal as seq(`[`, seq(optional comma_list(expr), `]`))
// (v2.extdeps.languages.dag dag_grammar_primary_expr_core); its items are read by the one
// comma-list walker. Every element is lowered WHOLE through body_lower_value_lowered, the value
// reader every value position uses, so a call, record, nested list or operator expression in
// element position lowers as it would anywhere else. An element that reader cannot lower refuses
// located at that element. Before this producer body_lower_primary_expr answered the literal with
// its `[` atom and every element was dropped; call arguments refused the whole module instead
// (body_lowering_reason_list_literal_unlowered).
fn body_lower_list_literal_items_capture_optional(captured: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_unwrap_surface_shell(node: captured)) {
    Absent => optional_absent()
    Present { value: pair } =>
      if body_lower_node_is_token(node: pair.left, token: ^dag_token_lbracket) {
        match sugar_sequence_pair_optional(node: pair.right) {
          Absent => optional_absent()
          Present { value: rest } =>
            if body_lower_node_is_token(node: rest.right, token: ^dag_token_rbracket) {
              optional_present(value: rest.left)
            } else {
              optional_absent()
            }
        }
      } else {
        optional_absent()
      }
  }
}

fn body_lower_list_literal_element(item: Node) -> Outcome<Node> {
  match body_lower_value_lowered(node: item) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Present { value: lowered }, diagnostics: d } =>
      outcome_with_diagnostics(value: lowered, diagnostics: d)
    Accepted { value: Absent, diagnostics: _ } =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_list_element_unlowered, n: item)
      )
  }
}

fn body_lower_list_literal(literal: Node, items_capture: Node) -> Outcome<Node> {
  bind_outcome(
    o: body_lower_comma_list_items(
      list_capture: items_capture,
      shape_refusal: ^body_lowering_reason_list_literal_shape_unread
    ),
    f: fn(items) {
      bind_outcome(
        o: fold(items, init: outcome_accepted(value: Empty), f: fn(acc, item) {
          bind_outcome(o: acc, f: fn(elements) {
            bind_outcome(o: body_lower_list_literal_element(item: item), f: fn(element) {
              outcome_accepted(value: list_snoc_item(xs: elements, item: element))
            })
          })
        }),
        f: fn(elements) { outcome_accepted(value: close_lowered_image(root: lower_list_introduction(elements: elements, source: literal))) }
      )
    }
  )
}

// A CAPTURE THE FOLD ALREADY LOWERED IS THE PRIMARY'S VALUE. body_lower_fold_reduce folds a node's
// children before reducing it, so a primary whose capture is a control form -- `match w {..}`,
// `if c {..} else {..}` in operand, argument or field position -- reaches this reducer holding the
// lowered Match or Branch, not syntax. The strategy readers below read raw syntax: handed a lowered
// node, one of them answered it with its first child, so `t && match w {..}` lowered to `t && w`
// with every arm dropped (the value reader on the match_expr node itself was correct; on its primary
// parent it was not). The postfix reducer already passes a lowered primary through
// (body_lower_postfix_lowered_primary_optional); this is the same rule one level down.
fn body_lower_primary_expr(shell: Node) -> Outcome<Node> {
  let captured = match body_lower_unwrap_captured(shell: shell) {
    Present { value: inner } => inner
    Absent => shell
  }
  if body_lower_is_core_substrate(node: captured) {
    outcome_accepted(value: captured)
  } else if body_lower_is_unrecognised_lowered_shape(node: captured) {
    Rejected { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: captured) }
  } else {
  match body_lower_int_literal_with_magnitude_optional(node: captured) {
        Present { value: lit } => outcome_accepted(value: lit)
        Absent =>
      match body_lower_list_literal_items_capture_optional(captured: captured) {
        Present { value: items_capture } =>
          body_lower_list_literal(literal: captured, items_capture: items_capture)
        Absent =>
      match body_lower_try_record_literal(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: record_opt, diagnostics: cd } =>
          match record_opt {
            Present { value: construct } => Accepted { value: construct, diagnostics: cd }
            Absent =>
      match body_lower_try_loop_keyword_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: loop_opt, diagnostics: ld } =>
          match loop_opt {
            Present { value: loop_node } =>
              Accepted { value: loop_node, diagnostics: ld }
            Absent =>
      match body_lower_try_primary_ident_call(node: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: primary_call, diagnostics: d } =>
          match primary_call {
            Present { value: transform } =>
              Accepted { value: transform, diagnostics: d }
            Absent =>
      match body_lower_dotted_chain_lowered_optional(node: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: Present { value: spine }, diagnostics: _ } => outcome_accepted(value: spine)
        Accepted { value: Absent, diagnostics: _ } =>
      match body_lower_paren_group_inner_optional(node: captured) {
        Present { value: inner } => body_lower_paren_group_lowered(group: captured, inner: inner)
        Absent =>
      match body_lower_caret_symbol_literal_optional(captured: captured) {
        Present { value: literal } => outcome_accepted(value: literal)
        Absent =>
      match body_lower_value_sole_atom_optional(node: captured) {
        Present { value: atom } => outcome_accepted(value: atom)
        Absent =>
      match body_lower_try_infix_transform(node: captured) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: Present { value: transform }, diagnostics: _ } => outcome_accepted(value: transform)
                Accepted { value: Absent, diagnostics: _ } =>
                  match body_lower_try_fold_loop(node: captured) {
                    Rejected { diagnostics: _ } =>
                      body_lower_try_operand_or_reject(shell: shell, captured: captured)
                    Accepted { value: fold_result, diagnostics: fd } =>
                      match fold_result {
                        Present { value: loop_node } =>
                          outcome_with_diagnostics(value: loop_node, diagnostics: fd)
                        Absent =>
                          match body_lower_try_operand_or_reject(shell: shell, captured: captured) {
                            Rejected { diagnostics: r } =>
                              Rejected { diagnostics: rejected_with_pending(pending: fd, rejected: r) }
                            Accepted { value: v, diagnostics: od } =>
                              outcome_with_diagnostics(
                                value: v,
                                diagnostics: diagnostics_merge(outer: fd, inner: od)
                              )
                          }
                      }
                  }
              }
      }
      }
      }
      }
      }
      }
          }
      }
  }
      }
      }
      }
  }
}

fn body_lower_fn_body_shell(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_body_subtree_lower(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              body_lowering_lowered(o: outcome_with_diagnostics(value: lowered, diagnostics: d))
            Absent => body_lowering_after_pending(pending: d, o: body_lower_wrapper_retained_shell(shell: shell))
          }
      }
  }
}

fn body_lower_forward_row_apply(shell: Node, emitted: Symbol) -> Outcome<BodyLowering> {
  if emitted == ^dag_surface_fn_decl {
    body_lower_fn_decl_to_arrow(shell: shell)
  } else if emitted == ^dag_surface_test_fn_decl {
    body_lower_test_fn_decl_to_member(shell: shell)
  } else if emitted == ^dag_surface_data_decl {
    body_lower_data_decl_to_member(shell: shell)
  } else if emitted == ^dag_surface_fn_body {
    body_lower_fn_body_shell(shell: shell)
  } else if emitted == ^dag_surface_match_expr {
    body_lowering_lowered(o: body_lower_match_expr(shell: shell))
  } else if emitted == ^dag_surface_if_expr {
    body_lowering_lowered(o: body_lower_if_expr(shell: shell))
  } else if emitted == ^dag_surface_loop_expr {
    body_lowering_lowered(o: body_lower_loop_expr(shell: shell))
  } else if emitted == ^dag_surface_let_expr {
    body_lowering_lowered(o: body_lower_let_expr(shell: shell))
  } else {
    body_lower_wrapper_retained_shell(shell: shell)
  }
}

fn body_lower_edge_names_where_clause(e: Edge) -> Bool {
  dag_surface_edge_is(e: e, edge: ^dag_surface_where_refinement_clause)
}

fn body_lower_find_where_host_conj(root: Node) -> Optional<Node> {
  match fold(root.children, init: false, f: fn(found, e) {
    found || body_lower_edge_names_where_clause(e: e)
  }) {
    true => Present { value: root }
    false =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_find_where_host_conj(root: e.target)
        }
      })
  }
}

// A RECORD DECLARATION rehomes exactly the way a where-alias does: `type R { f: T }` becomes
// Conj { R: Conj { f: T } }, a Named member the graft flatten keeps, so the record's fields are
// declared identities (module.R.f in the containment index) instead of a residual shell. The
// block shell reaches this dispatch preserved by the child fold; after a coproduct's variants
// have lowered no block shell remains under the unit, so a remaining one is the record spelling.
// Generic parameters ARE carried, on the member, by body_lower_type_decl_member below; the
// type-decl modifiers are not carried by this rehome, as they are not by the where-alias rehome
// beside it.
// A RECORD REHOMES TO Conj{ R: payload }, AND THAT SHAPE DOES NOT SAY IT IS A RECORD. The graft
// flattens this the same way it flattens a where-alias, so downstream of the graft a record
// declaration and a where-alias are indistinguishable, and the record/where-alias distinction is
// last held HERE, in body_lower_type_decl's arms.
//
// SO IT IS CARRIED FROM HERE, not recovered downstream: body_lower_type_decl_record_name_optional
// (below) is the one predicate that says which type_decl is a record; this dispatch and
// v2.compiler.normalize record_declaration_capture both ask it, and the capture rides to the symbol
// index on NormalizedTree type_declaration_kinds (its record projection), where the pattern-binder
// classifier reads it (Pkg16).
// The record-versus-where-alias control is v2.test.claim.match_arm_binder_frame
// mab_where_alias_is_not_a_record.
fn body_lower_record_type_decl(shell: Node, type_name: Symbol, block_shell: Node, type_params: DeclTypeParams) -> Outcome<Node> {
  match body_lower_field_decl_block_payload(block_shell: block_shell) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: payload, diagnostics: d } =>
      Accepted {
        value: body_lower_type_decl_member(shell: shell, type_name: type_name, body: payload, type_params: type_params),
        diagnostics: d
      }
  }
}

// A TYPE DECLARATION'S `<T>` RIDES ON THE DECLARATION, BESIDE ITS MEMBER: the graft keeps the Named
// declaration edge, and for a generic declaration its target is v2.std.type_binder type_decl_wrapper
// -- Conj { <type-parameters>: binders, <type-body>: member } -- so the member (the record's field
// Conj, the coproduct's variant Disj) keeps exactly its authored children. v2.compiler.resolve opens
// the binders' frame over the wrapper, so it covers the member and cannot reach a sibling
// declaration. Both labels are unauthorable. Without this the `<T>` list was dropped (records) or
// left in the graft target as parse residue walked as ordinary names (coproducts), and `T` resolved
// through the module's ordinary name chain (gunbc.recurring_failure_mode
// generic_type_parameter_resolved_as_an_ordinary_atom_in_v2).
fn body_lower_type_decl_member_body(body: Node, type_params: DeclTypeParams) -> Node {
  match type_params {
    TypeParams { conj: c } => type_decl_wrapper(binders: c, member: body)
    NoTypeParams => body
    TypeParamsUnreadable => body
  }
}

fn body_lower_type_decl_member(shell: Node, type_name: Symbol, body: Node, type_params: DeclTypeParams) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Authored { name: type_name },
        target: body_lower_type_decl_member_body(body: body, type_params: type_params)
      }
    ],
    occurrence_id: shell.occurrence_id
  )
}

// THE `=` ARM'S LOWERED RIGHT-HAND SIDE: seq(kw_type, seq(name, seq(opt(generic_params),
// seq(modifiers, opt(choice(field_decl_block, seq(eq, type_alias_rhs_lead))))))), read positionally
// the way the `<T>` slot is. Only a GENERIC declaration asks for it.
fn body_lower_type_decl_eq_rhs_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: captured) {
    Absent => optional_absent()
    Present { value: after_kw } =>
      match body_lower_fn_decl_spine_right(node: after_kw) {
        Absent => optional_absent()
        Present { value: after_name } =>
          match body_lower_fn_decl_spine_right(node: after_name) {
            Absent => optional_absent()
            Present { value: after_params } =>
              match body_lower_fn_decl_spine_right(node: after_params) {
                Absent => optional_absent()
                Present { value: body_choice } =>
                  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: body_choice)) {
                    Absent => optional_absent()
                    Present { value: eq_rhs } => optional_present(value: body_lower_deep_unwrap_optional(node: eq_rhs.right))
                  }
              }
          }
      }
  }
}

// EVERY `=` OR BODYLESS DECLARATION LOWERS HERE, GENERIC OR NOT, and carries its binders in a wrapper
// beside what it declares, never mixed into it (v2.std.type_binder). Three shapes, each with its own
// wrapper label, decided here from the parse and never later from a target's kind:
//   a MEMBER -- a Disj, or a lowered Conj (a fielded variant, a where-refined body) -- rides under
//   <type-body> (type_decl_wrapper) when the declaration is generic, and is the declaration target
//   itself when it is not, exactly as a record's is;
//   an ALIAS -- a single variant with no payload, no where clause and no separator, which
//   v1.compiler.parse parse_type_body_after_eq reads as type_item_from_alias_rhs -- rides under
//   <type-alias> (type_alias_wrapper), its right-hand side lowered by the ONE type-expression
//   lowering fn signatures use, body_lower_type_expr_lowered_optional;
//   a BODYLESS declaration (`type MachineWidth<bits>`, `type PointerWidth`) carries its binders
//   alone (type_opaque_wrapper) -- never an empty member, which would assert a record with no fields.
// An alias or bodyless declaration with no type parameters carries an EMPTY binder Conj
// (body_lower_decl_binders): one alias form and one opaque form, whose binder list may be empty.
// UNTIL THIS WAS ONE PATH, a non-generic alias or bodyless declaration was returned as its unlowered
// parse shell and accepted (gunbc.recurring_failure_mode plain_type_alias_left_as_a_parse_shell_in_v2),
// so infer met grammar tokens where a declaration should stand. What refuses
// body_lowering_reason_type_decl_member_uncarried is a right-hand side this lowering cannot read as
// one of the three. A single variant written after a leading `|` is a one-variant coproduct, not an
// alias: v2.std.compilers.sugar sugar_separated_rhs_as_coproduct has already made it a Disj by the
// time this lowering runs, so it takes the member arm.
fn body_lower_eq_type_decl(shell: Node, captured: Node, type_name: Symbol, type_params: DeclTypeParams) -> Outcome<Node> {
  match body_lower_type_decl_eq_rhs_optional(captured: captured) {
    Present { value: rhs } =>
      match rhs.kind {
        TypeNode { connective: Disj } =>
          outcome_accepted(value: body_lower_type_decl_member(shell: shell, type_name: type_name, body: rhs, type_params: type_params))
        TypeNode { connective: Conj } =>
          if body_lower_node_is_production_shell(n: rhs) {
            body_lower_alias_type_decl(shell: shell, type_name: type_name, rhs: rhs, type_params: type_params)
          } else {
            outcome_accepted(value: body_lower_type_decl_member(shell: shell, type_name: type_name, body: rhs, type_params: type_params))
          }
        TypeNode { connective: Atom { identity: _ } } => body_lower_alias_type_decl(shell: shell, type_name: type_name, rhs: rhs, type_params: type_params)
        TypeNode { connective: Arrow } => body_lower_alias_type_decl(shell: shell, type_name: type_name, rhs: rhs, type_params: type_params)
        TypeNode { connective: Cardinality } => body_lower_alias_type_decl(shell: shell, type_name: type_name, rhs: rhs, type_params: type_params)
        TypeNode { connective: Instantiation } => body_lower_alias_type_decl(shell: shell, type_name: type_name, rhs: rhs, type_params: type_params)
        ComputationNode { behavior: _ } => body_lower_alias_type_decl(shell: shell, type_name: type_name, rhs: rhs, type_params: type_params)
      }
    Absent =>
      match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_type_alias_rhs_lead) {
        Present { value: _ } => body_lower_type_decl_uncarried(shell: shell)
        Absent =>
          match body_lower_decl_binders(shell: shell, type_params: type_params) {
            Present { value: binders } =>
              outcome_accepted(value: body_lower_type_decl_declared(shell: shell, type_name: type_name, target: type_opaque_wrapper(binders: binders)))
            Absent => body_lower_type_decl_uncarried(shell: shell)
          }
      }
  }
}

fn body_lower_alias_type_decl(shell: Node, type_name: Symbol, rhs: Node, type_params: DeclTypeParams) -> Outcome<Node> {
  match body_lower_decl_binders(shell: shell, type_params: type_params) {
    Absent => body_lower_type_decl_uncarried(shell: shell)
    Present { value: binders } =>
      match body_lower_alias_rhs_optional(rhs: rhs) {
        Present { value: aliased } =>
          outcome_accepted(value: body_lower_type_decl_declared(shell: shell, type_name: type_name, target: type_alias_wrapper(binders: binders, aliased: aliased)))
        Absent => body_lower_type_decl_uncarried(shell: shell)
      }
  }
}

// The binder Conj a wrapper carries: the declared parameters, or an EMPTY Conj located at the
// declaration when it declares none. Absent only when the parameters could not be read, which refuses.
fn body_lower_decl_binders(shell: Node, type_params: DeclTypeParams) -> Optional<Node> {
  match type_params {
    TypeParams { conj: c } => optional_present(value: c)
    NoTypeParams => optional_present(value: node_lowered_from(kind: TypeNode { connective: Conj }, children: [], source: shell))
    TypeParamsUnreadable => optional_absent()
  }
}

// The aliased type expression, lowered; Absent for anything that is not exactly one: a parse shell with
// no type expression to lower, or a node that is not a type.
fn body_lower_alias_rhs_optional(rhs: Node) -> Optional<Node> {
  if body_lower_node_is_production_shell(n: rhs) {
    match body_lower_find_captured(root: rhs, emitted: ^dag_surface_type_expr) {
      ParseSubtreeFound { captured: type_expr } => body_lower_type_expr_lowered_optional(node: type_expr)
      ParseSubtreeAbsent => optional_absent()
    }
  } else {
    match rhs.kind {
      TypeNode { connective: _ } => optional_present(value: rhs)
      ComputationNode { behavior: _ } => optional_absent()
    }
  }
}

// A declaration edge `Conj { Name: target }` whose target is already a v2.std.type_binder wrapper.
// Closes the image body_lower_type_decl_declared_image builds: its returned node is the named root (v2.std.node
// close_lowered_image).
fn body_lower_type_decl_declared(shell: Node, type_name: Symbol, target: Node) -> Node {
  close_lowered_image(root: body_lower_type_decl_declared_image(shell: shell, type_name: type_name, target: target))
}

fn body_lower_type_decl_declared_image(shell: Node, type_name: Symbol, target: Node) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Authored { name: type_name }, target: target }],
    occurrence_id: shell.occurrence_id
  )
}

fn body_lower_node_is_production_shell(n: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: _ } => true
    Absent => false
  }
}

fn body_lower_type_decl_uncarried(shell: Node) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(d: Diagnostic {
      reason: ^body_lowering_reason_type_decl_member_uncarried,
      at: node_locus(node: shell),
      correction: Unavailable { reason: UserInputBoundary }
    })
  }
}

// A type declaration this lowering cannot read -- no captured child, or no declared name -- refuses,
// located. It was returned as its parse shell and accepted, which is the widening arm DESIGN section 5
// forbids: every later stage then met grammar tokens where a declaration should stand.
fn body_lower_type_decl_unreadable(shell: Node) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(d: Diagnostic {
      reason: ^body_lowering_reason_type_decl_unreadable,
      at: node_locus(node: shell),
      correction: Unavailable { reason: UserInputBoundary }
    })
  }
}

// WHICH type_decl IS A RECORD, ASKED ONCE. The record rehome below writes a record as
// `Conj { R: payload }`, which is the same shape a where-alias rehome writes and the same shape the
// graft builds for a module spine, so after this stage nothing can tell a record from those. The
// pattern-binder classifier needs exactly that distinction (v2.compiler.resolve
// resolve_pattern_atom_names_constructor: a record type spelled as a field-target atom is a
// constructor, a module is not), so it is read HERE, where it is still held, and carried on
// v2.compiler.normalized_tree NormalizedTree record_declarations by v2.compiler.normalize.
//
// The rule is the grammar's (v2.extdeps.languages.dag dag_grammar_type_decl_expr): a record is the
// type_decl whose body is the field_decl_block arm of the choice, not the `=` arm. Asking for the
// block alone is not enough on the PARSE tree, where every fielded variant of a coproduct still
// carries one (dag_grammar_type_variant_expr). Every `=` body reaches a type_alias_rhs -- the
// optional leading pipe's _lead wrapper is sugared away, the rhs is structure-preserved
// (body_lower_is_structure_preserved_emitted) -- so excluding it gives the same answer on the parse
// tree normalize captures from and on the lowered shell this stage rehomes: the rehome and the
// capture cannot disagree. On the lowered shell the exclusion changes nothing the old block-only
// test answered, because a lowered coproduct's variants no longer carry a block.
fn body_lower_type_decl_record_block_optional(captured: Node) -> Optional<Node> {
  match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_type_alias_rhs) {
    Present { value: _ } => Absent
    Absent => body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_field_decl_block)
  }
}

fn body_lower_type_decl_record_name_optional(shell: Node) -> Optional<Symbol> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => Absent
    Present { value: captured } =>
      match body_lower_type_decl_record_block_optional(captured: captured) {
        Absent => Absent
        Present { value: _ } => dag_surface_kw_then_ident_from_captured(captured: captured)
      }
  }
}

// WHICH KIND OF PLAIN-CONJ DECLARATION A type_decl IS, ASKED ONCE, BY THE ARMS body_lower_type_decl_by_body
// TAKES. After lowering, a record, a where-refinement and a payload-bearing single variant share the
// Conj { Name: payload } shape, so the kind is read HERE, on the parse, and carried on
// v2.compiler.normalized_tree NormalizedTree type_declaration_kinds. One value per declaration: a record
// and a refinement are authored alternatives, so the carrier has no state naming one declaration as
// both. A record is what body_lower_type_decl_record_name_optional says; otherwise a where clause --
// here still its dag_surface_where_refinement_clause production shell, the parse-level form of the arm
// the by-body dispatch finds as a Named edge -- makes a refinement; anything else carries no kind, and
// a plain Conj member without one is undecided downstream, never inferred.
type DeclaredTypeKind
  = DeclaredRecord { name: Symbol }
  | DeclaredRefinement { name: Symbol }
  | DeclaredResource { name: Symbol }

fn body_lower_type_decl_declared_kind_optional(shell: Node) -> Optional<DeclaredTypeKind> {
  match body_lower_type_decl_record_name_optional(shell: shell) {
    Present { value: name } => Present { value: DeclaredRecord { name: name } }
    Absent =>
      match parse_production_captured_child_optional(node: shell) {
        Absent => Absent
        Present { value: captured } =>
          match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_where_refinement_clause) {
            Absent => Absent
            Present { value: _ } =>
              match dag_surface_kw_then_ident_from_captured(captured: captured) {
                Absent => Absent
                Present { value: name } => Present { value: DeclaredRefinement { name: name } }
              }
          }
      }
  }
}

// The record names among a module's declaration kinds: the projection every record-only consumer (the
// symbol-index fill, the pattern-binder classifier, the census) reads, so records have one authority.
fn declared_record_names(kinds: FreeMonoid<DeclaredTypeKind>) -> FreeMonoid<Symbol> {
  fold_list(
    xs: kinds,
    empty: Empty,
    cons: fn(acc, k) {
      match k {
        DeclaredRecord { name: n } => list_snoc_item(xs: acc, item: n)
        DeclaredRefinement { name: _ } => acc
        DeclaredResource { name: _ } => acc
      }
    }
  )
}

// The resource names among a module's declaration kinds: what v2.compiler.symbol_index_fill marks as
// declared resources, so "is this path a resource" has one authority (the captured kind), exactly as
// declared_record_names is for records.
fn declared_resource_names(kinds: FreeMonoid<DeclaredTypeKind>) -> FreeMonoid<Symbol> {
  fold_list(
    xs: kinds,
    empty: Empty,
    cons: fn(acc, k) {
      match k {
        DeclaredRecord { name: _ } => acc
        DeclaredRefinement { name: _ } => acc
        DeclaredResource { name: n } => list_snoc_item(xs: acc, item: n)
      }
    }
  )
}

// THE TYPE-DECLARATION MODIFIER SLOT, CARRIED. `type X <modifier> = Y` -- the slot
// v2.extdeps.languages.dag dag_grammar_type_decl_modifiers_expr admits between the name (and its
// `<T>`) and the body -- was consumed and minted nothing on this route
// (gunbc.rung_drop g0_type_decl_modifier_parse_without_sealing_property), so no reader of a lowered
// declaration could tell `type X nominal_opaque = Y` from `type X = Y`. It is read HERE, on the parse,
// for the reason DeclaredTypeKind is: lowering leaves no trace of it in the node.
//
// A CLOSED VOCABULARY, NOT A FLAG PER SPELLING. The slot is where the ruled nominal-type plan
// (docs/plans/nominal-type-declaration-plan.md S1) puts constructor and view visibility, so a later
// modifier is a new variant here and a new terminal in the grammar's slot, never a second carrier.
// Carrying a modifier ENFORCES nothing: the sealing property v1 parsed_sole_constructor_properties
// mints is still not checked on this route, which is the half of that drop this does not restore.
type TypeDeclModifier
  = NominalOpaqueModifier
  | SoleConstructorModifier

// One row per declaration that carries at least one modifier, in slot order. A declaration with an
// empty slot has no row: absence of a row is the empty modifier set, never "unknown", because the
// reader below refuses every slot it cannot read.
type DeclaredTypeModifiers {
  name: Symbol
  modifiers: FreeMonoid<TypeDeclModifier>
}

type TypeDeclModifierSlotRead
  = TypeDeclModifierSlotEmpty
  | TypeDeclModifierSlotCarries { modifier: TypeDeclModifier }
  | TypeDeclModifierSlotUnreadable { at: Node }

// One optional terminal of the slot, as the parse leaves it: the keyword atom itself when present (an
// atom named by its token class), an empty Conj when absent. Anything else in the slot -- another
// atom, a Conj with children -- is unreadable and refuses, located: the grammar admits nothing else
// there, so that arm is the reader's own fail-closed boundary, never read as an empty slot.
fn body_lower_type_decl_modifier_slot(slot: Node) -> TypeDeclModifierSlotRead {
  let element = body_lower_deep_unwrap_optional(node: slot)
  match node_atom_identity_optional(node: element) {
    Present { value: id } =>
      if id == ^dag_token_kw_nominal_opaque {
        TypeDeclModifierSlotCarries { modifier: NominalOpaqueModifier }
      } else if id == ^dag_token_kw_sole_constructor {
        TypeDeclModifierSlotCarries { modifier: SoleConstructorModifier }
      } else {
        TypeDeclModifierSlotUnreadable { at: element }
      }
    Absent =>
      match element.kind {
        TypeNode { connective: c } =>
          match c {
            Conj =>
              if count(element.children) == 0 { TypeDeclModifierSlotEmpty } else { TypeDeclModifierSlotUnreadable { at: element } }
            Atom { identity: _ } => TypeDeclModifierSlotUnreadable { at: element }
            Disj => TypeDeclModifierSlotUnreadable { at: element }
            Arrow => TypeDeclModifierSlotUnreadable { at: element }
            Cardinality => TypeDeclModifierSlotUnreadable { at: element }
            Instantiation => TypeDeclModifierSlotUnreadable { at: element }
          }
        ComputationNode { behavior: _ } => TypeDeclModifierSlotUnreadable { at: element }
      }
  }
}

type TypeDeclModifiersRead
  = TypeDeclModifiersRead { modifiers: FreeMonoid<TypeDeclModifier> }
  | TypeDeclModifiersUnreadable { at: Node }

fn body_lower_type_decl_modifier_snoc(acc: TypeDeclModifiersRead, slot: Node) -> TypeDeclModifiersRead {
  match acc {
    TypeDeclModifiersUnreadable { at: a } => TypeDeclModifiersUnreadable { at: a }
    TypeDeclModifiersRead { modifiers: ms } =>
      match body_lower_type_decl_modifier_slot(slot: slot) {
        TypeDeclModifierSlotEmpty => TypeDeclModifiersRead { modifiers: ms }
        TypeDeclModifierSlotCarries { modifier: m } => TypeDeclModifiersRead { modifiers: list_snoc_item(xs: ms, item: m) }
        TypeDeclModifierSlotUnreadable { at: a } => TypeDeclModifiersUnreadable { at: a }
      }
  }
}

// seq(kw_type, seq(name, seq(opt(generic_params), seq(modifiers, body)))): the modifiers are the LEFT
// of the fourth spine node, the same positional read body_lower_type_decl_eq_rhs_optional makes of its
// right. modifiers = seq(opt(kw_nominal_opaque), opt(kw_sole_constructor)).
fn body_lower_type_decl_modifiers_read(shell: Node, captured: Node) -> TypeDeclModifiersRead {
  match body_lower_fn_decl_spine_right(node: captured) {
    Absent => TypeDeclModifiersUnreadable { at: shell }
    Present { value: after_kw } =>
      match body_lower_fn_decl_spine_right(node: after_kw) {
        Absent => TypeDeclModifiersUnreadable { at: shell }
        Present { value: after_name } =>
          match body_lower_fn_decl_spine_right(node: after_name) {
            Absent => TypeDeclModifiersUnreadable { at: shell }
            Present { value: after_params } =>
              match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: after_params)) {
                Absent => TypeDeclModifiersUnreadable { at: shell }
                Present { value: slot_and_body } =>
                  match sugar_sequence_pair_optional(node: slot_and_body.left) {
                    Absent => TypeDeclModifiersUnreadable { at: slot_and_body.left }
                    Present { value: slots } =>
                      body_lower_type_decl_modifier_snoc(
                        acc: body_lower_type_decl_modifier_snoc(acc: TypeDeclModifiersRead { modifiers: Empty }, slot: slots.left),
                        slot: slots.right
                      )
                  }
              }
          }
      }
  }
}

fn body_lower_type_decl_modifiers_unreadable_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^body_lowering_reason_type_decl_modifier_unreadable,
    at: node_locus(node: at),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

type DeclaredTypeModifiersCapture
  = DeclaredTypeModifiersAbsent
  | DeclaredTypeModifiersPresent { row: DeclaredTypeModifiers }

// THE ONE QUESTION normalize asks of a type_decl shell. A shell this cannot name or read refuses; the
// declaration's own lowering refuses an unreadable shell too, so the two decisions cannot disagree.
fn body_lower_type_decl_declared_modifiers(shell: Node) -> Outcome<DeclaredTypeModifiersCapture> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => Rejected { diagnostics: diagnostics_singleton(d: body_lower_type_decl_modifiers_unreadable_diagnostic(at: shell)) }
    Present { value: captured } =>
      match dag_surface_kw_then_ident_from_captured(captured: captured) {
        Absent => Rejected { diagnostics: diagnostics_singleton(d: body_lower_type_decl_modifiers_unreadable_diagnostic(at: shell)) }
        Present { value: name } =>
          match body_lower_type_decl_modifiers_read(shell: shell, captured: captured) {
            TypeDeclModifiersUnreadable { at: a } =>
              Rejected { diagnostics: diagnostics_singleton(d: body_lower_type_decl_modifiers_unreadable_diagnostic(at: a)) }
            TypeDeclModifiersRead { modifiers: ms } =>
              match ms {
                Empty => outcome_accepted(value: DeclaredTypeModifiersAbsent)
                Cons { head: _, tail: _ } =>
                  outcome_accepted(value: DeclaredTypeModifiersPresent { row: DeclaredTypeModifiers { name: name, modifiers: ms } })
              }
          }
      }
  }
}

fn body_lower_type_decl(shell: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => body_lower_type_decl_unreadable(shell: shell)
    Present { value: captured } =>
      match dag_surface_kw_then_ident_from_captured(captured: captured) {
        Absent => body_lower_type_decl_unreadable(shell: shell)
        Present { value: type_name } =>
          body_lower_type_decl_named(shell: shell, captured: captured, type_name: type_name, type_params: body_lower_decl_type_params(captured: captured))
      }
  }
}

fn body_lower_type_decl_named(shell: Node, captured: Node, type_name: Symbol, type_params: DeclTypeParams) -> Outcome<Node> {
  match type_params {
    TypeParamsUnreadable =>
      Rejected { diagnostics: diagnostics_singleton(d: body_lower_type_params_unreadable_diagnostic(shell: shell)) }
    NoTypeParams => body_lower_type_decl_by_body(shell: shell, captured: captured, type_name: type_name, type_params: type_params)
    TypeParams { conj: _ } => body_lower_type_decl_by_body(shell: shell, captured: captured, type_name: type_name, type_params: type_params)
  }
}

fn body_lower_type_decl_by_body(shell: Node, captured: Node, type_name: Symbol, type_params: DeclTypeParams) -> Outcome<Node> {
  match body_lower_type_decl_record_block_optional(captured: captured) {
    Present { value: block_shell } =>
      body_lower_record_type_decl(shell: shell, type_name: type_name, block_shell: block_shell, type_params: type_params)
    Absent =>
      match body_lower_find_where_host_conj(root: captured) {
        Present { value: host } =>
          outcome_accepted(value: body_lower_type_decl_member(shell: shell, type_name: type_name, body: host, type_params: type_params))
        Absent => body_lower_eq_type_decl(shell: shell, captured: captured, type_name: type_name, type_params: type_params)
      }
  }
}

// SERVICE DECLARATIONS, AT DECLARATION GRADE. A service is an interface (DESIGN section 3): a named
// product of function types. `service S { operation Op { input { a: A } output { b: B } } }` lowers
// onto existing connectives only -- `Conj { S: Conj { Op: Arrow(Conj { operation_input: Conj { a: A } },
// Conj { b: B }, order [operation_input]) } }`, a one-parameter declared signature whose parameter is
// the input record (body_lower_operation_params) -- so the graft flattens it like a record and the
// symbol index sees the service, its operations and their payload fields under
// `S.Op.operation_input`. No new node kind (ruling on gunbc adhoc-c537b0c6-a6e: no v2.std.node change, and
// node_minimal's TransportSlot is NOT promoted: transport is a realization handler, not a node field).
//
// WHAT IS NOT LOWERED IS SET ASIDE, TYPED AND LOCATED, UNDER TWO COUNTED REASONS:
//  - body_lowering_reason_realization_member_set_aside: transport / config / exit / response /
//    mock_response. config binds the transport's endpoint and authentication.
//    Realization per DESIGN section 3, never part of the interface, so the interface lowers without it.
//  - body_lowering_reason_interface_member_unmodeled: readonly / idempotent / hermetic and an io
//    field's `from "key"` / `= default` tail. These ARE interface facts (idempotent governs retry,
//    DESIGN section 4b) with no typed carrier yet, so they rank for modeling under their own reason
//    instead of hiding in the realization bucket (rfm service_interface_member_has_no_carrier).
// A set-aside member is UNREACHABLE AS LOWERED: only census grade admits them (v2.compiler.normalize
// normalize_census, whose carrier has no route to eval or emission); every other route refuses the
// service (body_lower_service_decl), so no stage that would need a service's realization can be
// handed a service and assume a transport. The set-aside population is a typed list the lowering
// builds, never a scan of diagnostic reasons. A member this lowering cannot read refuses, located.
//
// THE NAME IS ONE LABEL, THE WHOLE DECLARED SPELLING (`shell.Find`), not a per-segment spine. A
// spine collides at the module (dag/extdeps/shell.dag declares sixteen services under `shell`) and
// needs a prefix merge in namespace_graft. FRONTIER, stated: the dotted label hides named parts
// (DESIGN section 2) and a dotted reference to it does not resolve; the trigger is v2 resolving
// service CALLS, at which point the spine plus a graft prefix merge becomes the required shape and
// this label migrates in one transition.
type ServiceSetAsideKind
  = RealizationMemberSetAside
  | InterfaceMemberUnmodeled

type ServiceSetAside {
  kind: ServiceSetAsideKind,
  member: Node,
}

fn service_set_aside_reason(kind: ServiceSetAsideKind) -> Symbol {
  match kind {
    RealizationMemberSetAside => ^body_lowering_reason_realization_member_set_aside
    InterfaceMemberUnmodeled => ^body_lowering_reason_interface_member_unmodeled
  }
}

fn service_set_aside_diagnostics(xs: List<ServiceSetAside>) -> Diagnostics {
  fold(xs, init: None, f: fn(acc, x) {
    diagnostics_merge(
      outer: acc,
      inner: Some { diagnostics: diagnostics_singleton(d: body_lower_diagnostic(reason: service_set_aside_reason(kind: x.kind), n: x.member)) }
    )
  })
}

// The production shells directly beneath a node, looking through the choice wrappers
// (service_body_entry, operation_body_entry, resource_body_entry) that carry no fact of their own.
fn body_lower_service_member_shells(root: Node) -> List<Node> {
  fold(root.children, init: Empty, f: fn(acc, e) {
    list_append(left: acc, right: body_lower_service_member_shells_at(node: e.target))
  })
}

fn body_lower_service_member_shells_at(node: Node) -> List<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if (id == ^dag_surface_service_body_entry) || (id == ^dag_surface_operation_body_entry) || (id == ^dag_surface_resource_body_entry) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: inner } => body_lower_service_member_shells_at(node: inner)
          Absent => [node]
        }
      } else {
        [node]
      }
    Absent => body_lower_service_member_shells(root: node)
  }
}

// An io field's `[from "key"] [= default]` tail is present when either optional captured anything.
// A field tail is seq(opt(`from "key"`), opt(default)). Its default is the default production when the
// tail holds one; its wire key is the first part when that is not empty.
fn body_lower_io_field_default_optional(tail: Node) -> Optional<Node> {
  body_lower_find_production_shell_optional(root: tail, emitted: ^dag_surface_default_value)
}

fn body_lower_io_field_wire_key_present(tail: Node) -> Bool {
  match sugar_sequence_pair_optional(node: tail) {
    Present { value: pair } => is_empty_conj_root(n: pair.left) == false
    Absent =>
      match body_lower_io_field_default_optional(tail: tail) {
        Present { value: _ } => false
        Absent => is_empty_conj_root(n: tail) == false
      }
  }
}

fn body_lower_io_field_tail_present(tail: Node) -> Bool {
  match sugar_sequence_pair_optional(node: tail) {
    Absent => (is_empty_conj_root(n: tail) == false)
    Present { value: pair } =>
      (is_empty_conj_root(n: pair.left) == false) || (is_empty_conj_root(n: pair.right) == false)
  }
}


type BodyLowerIoBlock {
  payload: Node,
  set_aside: List<ServiceSetAside>,
  rows: List<Edge>,
  row_items: List<Node>,
}

fn body_lower_io_block(shell: Node) -> Outcome<BodyLowerIoBlock> {
  let refuse = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell)
  )
  match parse_production_captured_child_optional(node: shell) {
    Absent => refuse
    Present { value: captured } =>
      match body_lower_io_block_items_optional(captured: captured) {
        Absent => refuse
        Present { value: items } =>
          bind_outcome(
            o: fold(items, init: outcome_accepted(value: IoAcc { edges: Empty, set_aside: Empty, rows: Empty, row_items: Empty }), f: fn(acc, item) {
              bind_outcome(o: acc, f: fn(a) { body_lower_io_item_step(a: a, item: item) })
            }),
            f: fn(a) {
              outcome_accepted(
                value: BodyLowerIoBlock { payload: body_lower_payload_node(edges: a.edges, source: shell), set_aside: a.set_aside, rows: a.rows, row_items: a.row_items }
              )
            }
          )
      }
  }
}

// ONE IO FIELD: its binder, carrying its default when the tail holds one (lowered, XL-2 PR2c-ii). A wire
// key in its tail is a REALIZATION fact (XL-2 PR3b-i): it lowers to one projection row `field -> "key"`
// of the operation's realization entry (v2.compiler.service_realization), never into the interface. A
// field this reader cannot read refuses the block, located; so does a wire key that is not one string
// literal.
fn body_lower_io_item_step(a: IoAcc, item: Node) -> Outcome<IoAcc> {
  match body_lower_io_item_optional(item: item) {
    Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: item))
    Present { value: io } =>
      bind_outcome(o: body_lower_binder_edge_read(param: io.field, default: body_lower_io_field_default_optional(tail: io.tail)), f: fn(edge) {
        if body_lower_io_field_wire_key_present(tail: io.tail) {
          match body_lower_io_field_wire_key_node_optional(tail: io.tail) {
            Present { value: key } =>
              outcome_accepted(value: IoAcc {
                edges: list_snoc_item(xs: a.edges, item: edge),
                set_aside: a.set_aside,
                rows: list_snoc_item(xs: a.rows, item: Edge { label: Authored { name: io.field.name }, target: key }),
                row_items: list_snoc_item(xs: a.row_items, item: item)
              })
            Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_wire_key_unlowered, n: item))
          }
        } else {
          outcome_accepted(value: IoAcc { edges: list_snoc_item(xs: a.edges, item: edge), set_aside: a.set_aside, rows: a.rows, row_items: a.row_items })
        }
      })
  }
}

// The wire key's string literal: the one string literal in the tail's `from "key"` part.
fn body_lower_io_field_wire_key_node_optional(tail: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: tail) {
    Present { value: pair } => body_lower_first_string_literal_optional(root: pair.left)
    Absent => body_lower_first_string_literal_optional(root: tail)
  }
}

fn body_lower_first_string_literal_optional(root: Node) -> Optional<Node> {
  fold(node_subtree_nodes(root: root), init: optional_absent(), f: fn(acc, m) {
    match acc {
      Present { value: _ } => acc
      Absent => body_lower_string_literal_value_optional(node: m)
    }
  })
}

fn body_lower_first_int_literal_optional(root: Node) -> Optional<Node> {
  fold(node_subtree_nodes(root: root), init: optional_absent(), f: fn(acc, m) {
    match acc {
      Present { value: _ } => acc
      Absent => if dag_node_is_int_literal_atom(node: m) { optional_present(value: m) } else { optional_absent() }
    }
  })
}

// An io block's captured is seq(`input`|`output`, seq(`{`, seq(opt(comma_list), `}`))); its items.
fn body_lower_io_block_items_optional(captured: Node) -> Optional<List<Node>> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Absent
    Present { value: kw } =>
      match sugar_sequence_pair_optional(node: kw.right) {
        Absent => Absent
        Present { value: brace } =>
          match sugar_sequence_pair_optional(node: brace.right) {
            Absent => Absent
            Present { value: inner } => body_lower_comma_list_items_optional(list_capture: inner.left)
          }
      }
  }
}

// An io item is seq(field_decl, tail): its field declaration and its `[from "key"] [= default]` tail.
type BodyLowerIoItem {
  field: BodyLowerTypedParam,
  tail: Node,
}

fn body_lower_io_item_optional(item: Node) -> Optional<BodyLowerIoItem> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: item)) {
    Absent => Absent
    Present { value: pair } =>
      match body_lower_field_decl_optional(item: pair.left) {
        Absent => Absent
        Present { value: field } => Present { value: BodyLowerIoItem { field: field, tail: pair.right } }
      }
  }
}

// The binder atoms of one input_block or output_block production, read by the reader
// body_lower_io_block lowers its payload through.
fn body_lower_io_block_binder_atoms(captured: Node) -> Optional<List<Node>> {
  match body_lower_io_block_items_optional(captured: captured) {
    Absent => Absent
    Present { value: items } =>
      fold(items, init: Present { value: Empty }, f: fn(acc, item) {
        match acc {
          Absent => Absent
          Present { value: atoms } =>
            match body_lower_io_item_optional(item: item) {
              Absent => Absent
              Present { value: io } => Present { value: list_snoc_item(xs: atoms, item: io.field.binder) }
            }
        }
      })
  }
}

type IoAcc {
  edges: List<Edge>,
  set_aside: List<ServiceSetAside>,
  rows: List<Edge>,
  row_items: List<Node>,
}

type BodyLowerOperationAcc {
  input: Optional<Node>,
  output: Optional<Node>,
  requires: Optional<Node>,
  claims: BodyLowerOperationClaims,
  set_aside: List<ServiceSetAside>,
  realization: BodyLowerRealizationAcc,
}

// AN OPERATION'S REALIZATION FACTS (XL-2 PR3b-i; v2.compiler.service_realization). Its transport KIND,
// its exit or response arms, its mock_response arms and its wire-key projection rows lower into one
// realization ENTRY beside the interface, never into the operation's Arrow. `members` are the authored
// members those facts came from, kept so a reader with no realization sibling (a resource capability)
// refuses them exactly as it refused them before, as set-aside members.
// FRONTIER, declared: a transport's FIELDS (argv, path, method, ...) are not lowered; the transport
// member stays set aside (body_lowering_reason_realization_member_set_aside) and only its kind enters
// the entry. TRIGGER: XL-2 PR3b-ii lowers transport fields through the template model, at which point
// the transport is no longer set aside.
type BodyLowerRealizationAcc {
  transport: Optional<Node>,
  status_arms: Optional<Node>,
  mock_arms: Optional<Node>,
  rows: List<Edge>,
  members: List<ServiceSetAside>,
}

fn body_lower_realization_acc_empty() -> BodyLowerRealizationAcc {
  BodyLowerRealizationAcc { transport: optional_absent(), status_arms: optional_absent(), mock_arms: optional_absent(), rows: Empty, members: Empty }
}

fn body_lower_operation_acc_with_realization(a: BodyLowerOperationAcc, r: BodyLowerRealizationAcc) -> BodyLowerOperationAcc {
  BodyLowerOperationAcc { input: a.input, output: a.output, requires: a.requires, claims: a.claims, set_aside: a.set_aside, realization: r }
}

// AN OPERATION'S DECLARED CLAIMS (XL-2 PR2c-i): its effect claims (`readonly`, `idempotent`: std.effects
// EffectClaim) and its execution-mode claim (`hermetic`: std.execution_mode ExecutionMode), read from the
// surface modifiers in authored order. They lower onto the operation Arrow's contract edges
// (^arrow_effect_claims_edge, ^arrow_execution_mode_claim_edge), each present only when declared.
type BodyLowerOperationClaims {
  effects: List<Symbol>,
  mode: Optional<Symbol>,
}

fn body_lower_operation_member(acc: Outcome<BodyLowerOperationAcc>, member: Node) -> Outcome<BodyLowerOperationAcc> {
  bind_outcome(o: acc, f: fn(a) {
    match parse_production_emitted_identity_optional(node: member) {
      Absent => body_lower_service_member_unread(member: member)
      Present { value: id } =>
        if (id == ^dag_surface_input_block) || (id == ^dag_surface_output_block) {
          bind_outcome(o: body_lower_io_block(shell: member), f: fn(io) {
            if id == ^dag_surface_input_block {
              match a.input {
                Present { value: _ } =>
                  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_io_block_repeated, n: member))
                Absent =>
                  outcome_accepted(value: BodyLowerOperationAcc { input: Present { value: io.payload }, output: a.output, requires: a.requires, claims: a.claims, set_aside: list_append(left: a.set_aside, right: io.set_aside), realization: body_lower_realization_with_rows(r: a.realization, io: io) })
              }
            } else {
              match a.output {
                Present { value: _ } =>
                  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_io_block_repeated, n: member))
                Absent =>
                  outcome_accepted(value: BodyLowerOperationAcc { input: a.input, output: Present { value: io.payload }, requires: a.requires, claims: a.claims, set_aside: list_append(left: a.set_aside, right: io.set_aside), realization: body_lower_realization_with_rows(r: a.realization, io: io) })
              }
            }
          })
        } else if id == ^dag_surface_op_modifier {
          body_lower_operation_modifier(a: a, member: member)
        } else if id == ^dag_surface_op_requires {
          match a.requires {
            Present { value: _ } =>
              outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_operation_requires_repeated, n: member))
            Absent =>
              bind_outcome(o: body_lower_operation_requires(shell: member), f: fn(target) {
                outcome_accepted(value: BodyLowerOperationAcc { input: a.input, output: a.output, requires: Present { value: target }, claims: a.claims, set_aside: a.set_aside, realization: a.realization })
              })
          }
        } else if id == ^dag_surface_transport {
          body_lower_operation_transport(a: a, member: member)
        } else if (id == ^dag_surface_exit_block) || (id == ^dag_surface_response_block) {
          body_lower_operation_status_arms(a: a, member: member, mock: false)
        } else if id == ^dag_surface_mock_response_block {
          body_lower_operation_status_arms(a: a, member: member, mock: true)
        } else {
          body_lower_service_member_unread(member: member)
        }
    }
  })
}

// `requires R, ..` (v2.extdeps.languages.dag dag_grammar_op_requires_expr) lowers to the target of the
// operation Arrow's ArrowResourceRequirementsEdge: a Conj with one Authored edge per member, labelled
// by the member's spelling as written and targeting its type reference, lowered by the one type-position
// reader (body_lower_type_expr_lowered_optional) a parameter's type goes through. The label is only the
// Conj's discipline (v2.std.node LabeledEdges: named, distinct), so a spelling written twice is
// ill-formed here; a member's IDENTITY is its resolved declaration, which v2.compiler.resolve checks is
// a declared resource and is not repeated under another spelling. A member that is not a readable type
// expression refuses at the member.
// `requires none` and `requires opaque` lower to a single childless Atom on the same edge, so the one
// carrier has three declared states (v2.std.node CoreEdgeLabel ArrowResourceRequirementsEdge); an operation with
// no clause carries no edge, which D13 step (b) reads as Undecided, never as none.
fn body_lower_operation_requires(shell: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_operation_requires_unread, n: shell))
    Present { value: captured } =>
      match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_op_requires_none) {
        Present { value: word } => outcome_accepted(value: node_with_occurrence_id(kind: TypeNode { connective: Atom { identity: ^requirements_declared_none } }, children: [], occurrence_id: word.occurrence_id))
        Absent =>
          match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_op_requires_opaque) {
            Present { value: word } => outcome_accepted(value: node_with_occurrence_id(kind: TypeNode { connective: Atom { identity: ^requirements_opaque } }, children: [], occurrence_id: word.occurrence_id))
            Absent => body_lower_operation_requires_members(shell: shell, captured: captured)
          }
      }
  }
}

fn body_lower_operation_requires_members(shell: Node, captured: Node) -> Outcome<Node> {
      bind_outcome(
        o: fold(body_lower_service_member_shells(root: captured), init: outcome_accepted(value: Empty), f: fn(acc, member) {
          bind_outcome(o: acc, f: fn(edges) {
            match body_lower_type_expr_lowered_optional(node: member) {
              Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_operation_requires_unread, n: member))
              Present { value: type_node } =>
                match body_lower_operation_requires_member_label_optional(member: member, type_node: type_node) {
                  Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_operation_requires_unread, n: member))
                  Present { value: label } =>
                    if body_lower_edges_carry_name(edges: edges, name: label) {
                      outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_operation_requirement_repeated, n: member))
                    } else {
                      outcome_accepted(value: list_snoc_item(xs: edges, item: Edge { label: Authored { name: label }, target: type_node }))
                    }
                }
            }
          })
        }),
        f: fn(edges) {
          match edges {
            Empty => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_operation_requires_unread, n: shell))
            Cons { head: _, tail: _ } =>
              outcome_accepted(value: node_with_occurrence_id(kind: TypeNode { connective: Conj }, children: edges, occurrence_id: shell.occurrence_id))
          }
        }
      )
}

// A member's spelling as written, read off the LOWERED type node rather than re-searched in the
// parse: a single-segment name lowers to an Atom whose identity IS that spelling, and a dotted one to
// the qualified-name spine (body_lower_qualified_name_spine_node), read back as its dotted string. A
// member that is neither (a generic application, an anonymous record) has no requirement spelling and
// refuses at the member.
fn body_lower_operation_requires_member_label_optional(member: Node, type_node: Node) -> Optional<Symbol> {
  match node_atom_identity_optional(node: type_node) {
    Present { value: id } => optional_present(value: id)
    Absent =>
      if qualified_name_spine_shape_present(root: type_node) {
        match qualified_name_from_node(root: type_node) {
          Accepted { value: qn, diagnostics: _ } => optional_present(value: symbol_intern_lexeme(lexeme: qualified_name_to_dotted_string(qn: qn)))
          Rejected { diagnostics: _ } => optional_absent()
        }
      } else {
        optional_absent()
      }
  }
}

fn body_lower_edges_carry_name(edges: List<Edge>, name: Symbol) -> Bool {
  fold(edges, init: false, f: fn(seen, e) {
    match e.label {
      Authored { name: n } => seen || (n == name)
      StructuralLabel { label: _ } => seen
      Positional => seen
    }
  })
}

// The requirements edge rides on the Arrow beside its signature edges, present only when declared: an
// operation with no `requires` carries no edge, so its Arrow -- and its identity -- is unchanged.
fn body_lower_operation_arrow_children(signature_edges: List<Edge>, requires: Optional<Node>, claims: BodyLowerOperationClaims) -> List<Edge> {
  let with_requires = match requires {
    Absent => signature_edges
    Present { value: target } => list_snoc_item(xs: signature_edges, item: core_edge(marker: ArrowResourceRequirementsEdge, target: target))
  }
  let with_effects = match claims.effects {
    Empty => with_requires
    Cons { head: _, tail: _ } => list_snoc_item(xs: with_requires, item: core_edge(marker: ArrowEffectClaimsEdge, target: body_lower_effect_claims_node(labels: claims.effects)))
  }
  match claims.mode {
    Absent => with_effects
    Present { value: mode } => list_snoc_item(xs: with_effects, item: core_edge(marker: ArrowExecutionModeClaimEdge, target: node_synthetic(kind: TypeNode { connective: Atom { identity: mode } }, children: [])))
  }
}

// The effect-claims target: a Conj of self-named childless Atoms, one per declared claim
// (v2.std.arrow_contract arrow_effect_claims_target_conforms checks it against std.effects EffectClaim).
fn body_lower_effect_claims_node(labels: List<Symbol>) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: fold(labels, init: Empty, f: fn(acc, l) {
      list_snoc_item(xs: acc, item: Edge { label: Authored { name: l }, target: node_synthetic(kind: TypeNode { connective: Atom { identity: l } }, children: []) })
    })
  )
}

// ONE SURFACE MODIFIER, PROJECTED TO ITS HOME (XL-2 PR2c-i; ruling 2026-10-01). The modifier's own
// production says which keyword was written (v2.extdeps.languages.dag dag_grammar_op_modifier_expr);
// `readonly` and `idempotent` are std.effects EffectClaim arms and `hermetic` the std.execution_mode
// Hermetic arm, each spelled by v2.std.arrow_contract, never here. A claim declared twice, or a second
// mode, refuses at the repeated modifier (^body_lowering_reason_operation_modifier_repeated); a modifier
// whose production names no home refuses as an unread member.
type OperationModifierClaim
  = ModifierEffectClaim { claim: EffectClaim }
  | ModifierModeClaim

fn body_lower_operation_modifier_claim_optional(member: Node) -> Optional<OperationModifierClaim> {
  match body_lower_find_production_shell_optional(root: member, emitted: ^dag_surface_op_modifier_readonly) {
    Present { value: _ } => optional_present(value: ModifierEffectClaim { claim: ReadonlyClaim })
    Absent =>
      match body_lower_find_production_shell_optional(root: member, emitted: ^dag_surface_op_modifier_idempotent) {
        Present { value: _ } => optional_present(value: ModifierEffectClaim { claim: IdempotentClaim })
        Absent =>
          match body_lower_find_production_shell_optional(root: member, emitted: ^dag_surface_op_modifier_hermetic) {
            Present { value: _ } => optional_present(value: ModifierModeClaim)
            Absent => optional_absent()
          }
      }
  }
}

fn body_lower_operation_modifier(a: BodyLowerOperationAcc, member: Node) -> Outcome<BodyLowerOperationAcc> {
  match body_lower_operation_modifier_claim_optional(member: member) {
    Absent => body_lower_service_member_unread(member: member)
    Present { value: claim } =>
      match claim {
        ModifierEffectClaim { claim: c } =>
          body_lower_operation_effect_claim(a: a, label: effect_claim_label(claim: c), member: member)
        ModifierModeClaim =>
          match a.claims.mode {
            Present { value: _ } =>
              outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_operation_modifier_repeated, n: member))
            Absent =>
              outcome_accepted(value: body_lower_operation_acc_with_claims(a: a, claims: BodyLowerOperationClaims { effects: a.claims.effects, mode: Present { value: hermetic_claim_label() } }))
          }
      }
  }
}

fn body_lower_operation_effect_claim(a: BodyLowerOperationAcc, label: Symbol, member: Node) -> Outcome<BodyLowerOperationAcc> {
  if fold(a.claims.effects, init: false, f: fn(seen, l) { seen || (l == label) }) {
    outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_operation_modifier_repeated, n: member))
  } else {
    outcome_accepted(value: body_lower_operation_acc_with_claims(a: a, claims: BodyLowerOperationClaims { effects: list_snoc_item(xs: a.claims.effects, item: label), mode: a.claims.mode }))
  }
}

fn body_lower_operation_acc_with_claims(a: BodyLowerOperationAcc, claims: BodyLowerOperationClaims) -> BodyLowerOperationAcc {
  BodyLowerOperationAcc { input: a.input, output: a.output, requires: a.requires, claims: claims, set_aside: a.set_aside, realization: a.realization }
}

fn body_lower_operation_acc_set_aside(a: BodyLowerOperationAcc, kind: ServiceSetAsideKind, n: Node) -> Outcome<BodyLowerOperationAcc> {
  outcome_accepted(
    value: BodyLowerOperationAcc {
      input: a.input,
      output: a.output,
      requires: a.requires,
      claims: a.claims,
      set_aside: list_snoc_item(xs: a.set_aside, item: ServiceSetAside { kind: kind, member: n }),
      realization: a.realization
    }
  )
}

fn body_lower_realization_with_rows(r: BodyLowerRealizationAcc, io: BodyLowerIoBlock) -> BodyLowerRealizationAcc {
  BodyLowerRealizationAcc {
    transport: r.transport,
    status_arms: r.status_arms,
    mock_arms: r.mock_arms,
    rows: list_append(left: r.rows, right: io.rows),
    members: list_append(left: r.members, right: body_lower_set_aside_of(kind: InterfaceMemberUnmodeled, members: io.row_items))
  }
}

fn body_lower_set_aside_of(kind: ServiceSetAsideKind, members: List<Node>) -> List<ServiceSetAside> {
  fold(members, init: Empty, f: fn(acc, m) { list_snoc_item(xs: acc, item: ServiceSetAside { kind: kind, member: m }) })
}

// A REALIZATION BLOCK IS DECLARED ONCE PER OPERATION: a second transport, a second exit or response
// block, or a second mock_response block refuses at the second.
fn body_lower_realization_block_repeated<T>(member: Node) -> Outcome<T> {
  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_realization_block_repeated, n: member))
}

// THE TRANSPORT'S KIND enters the entry (`<realization-transport> -> { <transport-kind> -> kind }`); its
// fields stay set aside at the 3b-ii frontier (BodyLowerRealizationAcc).
fn body_lower_operation_transport(a: BodyLowerOperationAcc, member: Node) -> Outcome<BodyLowerOperationAcc> {
  match a.realization.transport {
    Present { value: _ } => body_lower_realization_block_repeated(member: member)
    Absent =>
      match body_lower_transport_kind_label_optional(member: member) {
        Absent => body_lower_service_member_unread(member: member)
        Present { value: kind } =>
          body_lower_operation_acc_set_aside(
            a: body_lower_operation_acc_with_realization(a: a, r: BodyLowerRealizationAcc {
              transport: optional_present(value: body_lower_transport_kind_node(kind: kind)),
              status_arms: a.realization.status_arms,
              mock_arms: a.realization.mock_arms,
              rows: a.realization.rows,
              members: a.realization.members
            }),
            kind: RealizationMemberSetAside,
            n: member
          )
      }
  }
}

// The kind as written, read from the emitting production (v2.extdeps.languages.dag
// dag_grammar_transport_kind_expr: one production per kind).
fn body_lower_transport_kind_label_optional(member: Node) -> Optional<Symbol> {
  if body_lower_has_production(root: member, emitted: ^dag_surface_transport_kind_shell) { optional_present(value: symbol_intern_lexeme(lexeme: "shell")) }
  else if body_lower_has_production(root: member, emitted: ^dag_surface_transport_kind_rest) { optional_present(value: symbol_intern_lexeme(lexeme: "rest")) }
  else if body_lower_has_production(root: member, emitted: ^dag_surface_transport_kind_file) { optional_present(value: symbol_intern_lexeme(lexeme: "file")) }
  else if body_lower_has_production(root: member, emitted: ^dag_surface_transport_kind_local) { optional_present(value: symbol_intern_lexeme(lexeme: "local")) }
  else { optional_absent() }
}

fn body_lower_has_production(root: Node, emitted: Symbol) -> Bool {
  match body_lower_find_production_shell_optional(root: root, emitted: emitted) {
    Present { value: _ } => true
    Absent => false
  }
}

fn body_lower_transport_kind_node(kind: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Authored { name: realization_transport_kind_label() }, target: node_synthetic(kind: TypeNode { connective: Atom { identity: kind } }, children: Empty) }]
  )
}

// EXIT, RESPONSE AND MOCK_RESPONSE ARMS (`pattern => payload ["doc"]`), each a Positional arm of the
// entry's <status-arms> or <mock-arms> Conj in authored order. An exit or response payload is a TYPE,
// lowered by the one type-position reader; a mock payload is a VALUE, lowered by the one value reader,
// so its references reach resolution. The doc string rides as the arm's <arm-doc>.
fn body_lower_operation_status_arms(a: BodyLowerOperationAcc, member: Node, mock: Bool) -> Outcome<BodyLowerOperationAcc> {
  let prior = if mock { a.realization.mock_arms } else { a.realization.status_arms }
  match prior {
    Present { value: _ } => body_lower_realization_block_repeated(member: member)
    Absent =>
      bind_outcome(o: body_lower_status_arms_node(block: member, mock: mock), f: fn(arms) {
        outcome_accepted(value: body_lower_operation_acc_with_realization(a: a, r: BodyLowerRealizationAcc {
          transport: a.realization.transport,
          status_arms: if mock { a.realization.status_arms } else { optional_present(value: arms) },
          mock_arms: if mock { optional_present(value: arms) } else { a.realization.mock_arms },
          rows: a.realization.rows,
          members: list_snoc_item(xs: a.realization.members, item: ServiceSetAside { kind: RealizationMemberSetAside, member: member })
        }))
      })
  }
}

// An ordered block of arms is a LIST (v2.std.list_introduction lower_list_introduction), never a Conj:
// a Conj's edges are named and distinct, so positional arms there are ill-formed.
fn body_lower_status_arms_node(block: Node, mock: Bool) -> Outcome<Node> {
  bind_outcome(
    o: fold(body_lower_status_entry_shells(block: block), init: outcome_accepted(value: body_lower_node_list_empty()), f: fn(acc, entry) {
      bind_outcome(o: acc, f: fn(arms) {
        bind_outcome(o: body_lower_status_arm(entry: entry, mock: mock), f: fn(arm) { outcome_accepted(value: list_snoc_item(xs: arms, item: arm)) })
      })
    }),
    f: fn(arms) { outcome_accepted(value: lower_list_introduction(elements: arms, source: node_synthetic(kind: TypeNode { connective: Conj }, children: Empty))) }
  )
}

fn body_lower_node_list_empty() -> List<Node> {
  Empty
}

fn body_lower_edge_list_empty() -> List<Edge> {
  Empty
}

fn body_lower_status_entry_shells(block: Node) -> List<Node> {
  match parse_production_captured_child_optional(node: block) {
    Absent => Empty
    Present { value: captured } =>
      fold(body_lower_service_member_shells(root: captured), init: Empty, f: fn(acc, shell) {
        match parse_production_emitted_identity_optional(node: shell) {
          Present { value: id } =>
            if (id == ^dag_surface_status_type_entry) || (id == ^dag_surface_status_expr_entry) { list_snoc_item(xs: acc, item: shell) } else { acc }
          Absent => acc
        }
      })
  }
}

// An entry's captured is seq(status_pattern, seq(`=>`, seq(payload, opt(doc string)))).
fn body_lower_status_arm(entry: Node, mock: Bool) -> Outcome<Node> {
  let refuse = outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_status_arm_unlowered, n: entry))
  match parse_production_captured_child_optional(node: entry) {
    Absent => refuse
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => refuse
        Present { value: p1 } =>
          match sugar_sequence_pair_optional(node: p1.right) {
            Absent => refuse
            Present { value: p2 } =>
              match sugar_sequence_pair_optional(node: p2.right) {
                Absent => refuse
                Present { value: p3 } =>
                  match body_lower_status_pattern_node_optional(pattern: p1.left) {
                    Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_status_pattern_unlowered, n: p1.left))
                    Present { value: pat } =>
                      bind_outcome(o: body_lower_arm_payload(payload: p3.left, mock: mock), f: fn(payload) {
                        outcome_accepted(value: node_synthetic(kind: TypeNode { connective: Conj }, children: body_lower_arm_children(pat: pat, payload: payload, doc: body_lower_first_string_literal_optional(root: p3.right))))
                      })
                  }
              }
          }
      }
  }
}

fn body_lower_arm_children(pat: Node, payload: Node, doc: Optional<Node>) -> List<Edge> {
  let core = [
    Edge { label: Authored { name: realization_arm_pattern_label() }, target: pat },
    Edge { label: Authored { name: realization_arm_payload_label() }, target: payload }
  ]
  match doc {
    Present { value: d } => list_snoc_item(xs: core, item: Edge { label: Authored { name: realization_arm_doc_label() }, target: d })
    Absent => core
  }
}

fn body_lower_arm_payload(payload: Node, mock: Bool) -> Outcome<Node> {
  if mock {
    body_lower_value_read(value: payload)
  } else {
    match body_lower_type_expr_lowered_optional(node: payload) {
      Present { value: t } => outcome_accepted(value: t)
      Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_status_arm_unlowered, n: payload))
    }
  }
}

// THE PATTERN, read from the emitting production (dag_grammar_status_pattern_expr: one per form). A class
// `5xx` lowers to the self-identified Atom spelled as written; an exact code to { <status-code> -> int
// literal }; a name (`nonzero`) to its self-identified Atom. Which forms a transport admits is the
// realization wall's decision, not this reader's.
fn body_lower_status_pattern_node_optional(pattern: Node) -> Optional<Node> {
  match body_lower_find_production_shell_optional(root: pattern, emitted: ^dag_surface_status_pattern_class) {
    Present { value: shell } => body_lower_status_class_atom_optional(shell: shell)
    Absent =>
      match body_lower_find_production_shell_optional(root: pattern, emitted: ^dag_surface_status_pattern_code) {
        Present { value: shell } =>
          match body_lower_first_int_literal_optional(root: shell) {
            Present { value: lit } =>
              optional_present(value: node_synthetic(kind: TypeNode { connective: Conj }, children: [Edge { label: Authored { name: realization_status_code_label() }, target: lit }]))
            Absent => optional_absent()
          }
        Absent =>
          match body_lower_find_production_shell_optional(root: pattern, emitted: ^dag_surface_status_pattern_name) {
            Present { value: shell } => body_lower_status_name_atom_optional(shell: shell)
            Absent => optional_absent()
          }
      }
  }
}

fn body_lower_status_class_atom_optional(shell: Node) -> Optional<Node> {
  match body_lower_first_int_literal_optional(root: shell) {
    Present { value: lit } =>
      match dag_int_literal_magnitude_int_from_node(node: lit) {
        Accepted { value: n, diagnostics: _ } =>
          optional_present(value: node_synthetic(kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: concat(to_string(n), "xx")) } }, children: Empty))
        Rejected { diagnostics: _ } => optional_absent()
      }
    Absent => optional_absent()
  }
}

fn body_lower_status_name_atom_optional(shell: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: shell) {
    Present { value: captured } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: captured)) {
        Present { value: id } => optional_present(value: node_synthetic(kind: TypeNode { connective: Atom { identity: id } }, children: Empty))
        Absent => optional_absent()
      }
    Absent => optional_absent()
  }
}

// THE ENTRY an operation's realization facts lower to, or Absent when it authored none.
fn body_lower_realization_entry_optional(r: BodyLowerRealizationAcc) -> Optional<Node> {
  let edges = list_append(
    left: list_append(
      left: list_append(
        left: body_lower_entry_edge(label: realization_transport_label(), node: r.transport),
        right: body_lower_entry_edge(label: realization_status_arms_label(), node: r.status_arms)
      ),
      right: body_lower_entry_edge(label: realization_mock_arms_label(), node: r.mock_arms)
    ),
    right: body_lower_rows_edge(rows: r.rows)
  )
  match edges {
    Empty => optional_absent()
    Cons { head: _, tail: _ } => optional_present(value: node_synthetic(kind: TypeNode { connective: Conj }, children: edges))
  }
}

fn body_lower_entry_edge(label: Symbol, node: Optional<Node>) -> List<Edge> {
  match node {
    Present { value: n } => [Edge { label: Authored { name: label }, target: n }]
    Absent => Empty
  }
}

fn body_lower_rows_edge(rows: List<Edge>) -> List<Edge> {
  match rows {
    Empty => Empty
    Cons { head: _, tail: _ } => [Edge { label: Authored { name: realization_projection_label() }, target: node_synthetic(kind: TypeNode { connective: Conj }, children: rows) }]
  }
}

// SERVICE CONFIGURATION (`config { endpoint: e, .. }`) lowers to the leaf's <realization-config>: a Conj
// of the authored fields, each named as written (read from its emitting production,
// dag_grammar_service_config_field_name_expr) and valued by the one value reader.
fn body_lower_service_config_node(member: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: member) {
    Absent => body_lower_service_member_unread(member: member)
    Present { value: captured } =>
      bind_outcome(
        o: fold(body_lower_service_member_shells(root: captured), init: outcome_accepted(value: body_lower_edge_list_empty()), f: fn(acc, field) {
          bind_outcome(o: acc, f: fn(edges) {
            bind_outcome(o: body_lower_service_config_field(field: field), f: fn(e) { outcome_accepted(value: list_snoc_item(xs: edges, item: e)) })
          })
        }),
        f: fn(edges) { outcome_accepted(value: node_synthetic(kind: TypeNode { connective: Conj }, children: edges)) }
      )
  }
}

fn body_lower_service_config_field(field: Node) -> Outcome<Edge> {
  let refuse = outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_config_field_unlowered, n: field))
  match body_lower_service_config_field_name_optional(field: field) {
    Absent => refuse
    Present { value: name } =>
      match parse_production_captured_child_optional(node: field) {
        Absent => refuse
        Present { value: captured } =>
          match sugar_sequence_pair_optional(node: captured) {
            Absent => refuse
            Present { value: p1 } =>
              match sugar_sequence_pair_optional(node: p1.right) {
                Absent => refuse
                Present { value: p2 } =>
                  bind_outcome(o: body_lower_value_read(value: p2.right), f: fn(value) {
                    outcome_accepted(value: Edge { label: Authored { name: name }, target: value })
                  })
              }
          }
      }
  }
}

fn body_lower_service_config_field_name_optional(field: Node) -> Optional<Symbol> {
  if body_lower_has_production(root: field, emitted: ^dag_surface_service_config_field_name_endpoint) { optional_present(value: symbol_intern_lexeme(lexeme: "endpoint")) }
  else if body_lower_has_production(root: field, emitted: ^dag_surface_service_config_field_name_auth_input) { optional_present(value: symbol_intern_lexeme(lexeme: "auth_input")) }
  else if body_lower_has_production(root: field, emitted: ^dag_surface_service_config_field_name_auth_source) { optional_present(value: symbol_intern_lexeme(lexeme: "auth_source")) }
  else if body_lower_has_production(root: field, emitted: ^dag_surface_service_config_field_name_auth) { optional_present(value: symbol_intern_lexeme(lexeme: "auth")) }
  else if body_lower_has_production(root: field, emitted: ^dag_surface_service_config_field_name_rate_limit) { optional_present(value: symbol_intern_lexeme(lexeme: "rate_limit")) }
  else { optional_absent() }
}

// A member this lowering cannot read REFUSES, located at the member: a partially read service has
// no representation, so nothing is kept and nothing is dropped.
fn body_lower_service_member_unread<T>(member: Node) -> Outcome<T> {
  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_member_unread, n: member))
}

// An operation that declares no input (or no output) block exchanges the empty product.
// AN OPERATION TAKES ONE INPUT, OF A RECORD TYPE: its domain is a parameter list with the one binder
// ^operation_input whose target is the input payload, never the payload's fields standing in the
// domain's place. A payload Conj at domain position reads, to every domain reader (v2.std.node
// arrow_domain_binder_labels, v2.compiler.resolve arrow_domain_frame_binders), as one parameter
// per field -- bound by name, with no declared order, and scoped as locals of an Arrow that has no
// body. Built through v2.std.arrow_signature declared_signature like every other signature,
// so the operation's domain and its order come from one mint. An operation with no input block has
// an empty parameter list, not an empty payload argument.
fn body_lower_operation_params(input: Optional<Node>) -> List<Edge> {
  match input {
    Present { value: payload } => [binder_edge(name: ^operation_input, type_node: payload)]
    Absent => []
  }
}

fn body_lower_io_payload_or_empty(o: Optional<Node>, source: Node) -> Node {
  match o {
    Present { value: payload } => payload
    Absent => body_lower_payload_node(edges: Empty, source: source)
  }
}

type BodyLowerOperation {
  edge: Edge,
  set_aside: List<ServiceSetAside>,
  entry: Optional<Node>,
  realization_members: List<ServiceSetAside>,
}

fn body_lower_operation(shell: Node) -> Outcome<BodyLowerOperation> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => body_lower_service_member_unread(member: shell)
    Present { value: captured } =>
      match dag_surface_kw_then_ident_from_captured(captured: captured) {
        Absent => body_lower_service_member_unread(member: shell)
        Present { value: op_name } =>
          bind_outcome(
            o: fold(
              body_lower_service_member_shells(root: captured),
              init: outcome_accepted(value: BodyLowerOperationAcc { input: Absent, output: Absent, requires: Absent, claims: BodyLowerOperationClaims { effects: Empty, mode: Absent }, set_aside: Empty, realization: body_lower_realization_acc_empty() }),
              f: fn(acc, member) { body_lower_operation_member(acc: acc, member: member) }
            ),
            f: fn(a) {
              let signature = declared_signature(params: body_lower_operation_params(input: a.input), source: shell)
              outcome_accepted(
                value: BodyLowerOperation {
                  edge: Edge {
                    label: Authored { name: op_name },
                    target: close_lowered_image(root: node_with_occurrence_id(
                      kind: TypeNode { connective: Arrow },
                      children: body_lower_operation_arrow_children(
                        signature_edges: [
                          signature.domain,
                          Edge { label: Positional, target: body_lower_io_payload_or_empty(o: a.output, source: shell) },
                          signature.order
                        ],
                        requires: a.requires,
                        claims: a.claims
                      ),
                      occurrence_id: shell.occurrence_id
                    ))
                  },
                  set_aside: a.set_aside,
                  entry: body_lower_realization_entry_optional(r: a.realization),
                  realization_members: a.realization.members
                }
              )
            }
          )
      }
  }
}

type BodyLowerServiceAcc {
  operations: List<Edge>,
  operation_shells: List<Node>,
  set_aside: List<ServiceSetAside>,
  entries: List<Edge>,
  config: Optional<Node>,
}

fn body_lower_service_member(acc: Outcome<BodyLowerServiceAcc>, member: Node) -> Outcome<BodyLowerServiceAcc> {
  bind_outcome(o: acc, f: fn(a) {
    match parse_production_emitted_identity_optional(node: member) {
      Absent => body_lower_service_member_unread(member: member)
      Present { value: id } =>
        if id == ^dag_surface_qualified_name {
          outcome_accepted(value: a)
        } else if id == ^dag_surface_operation {
          bind_outcome(o: body_lower_operation(shell: member), f: fn(op) {
            outcome_accepted(
              value: BodyLowerServiceAcc {
                operations: list_snoc_item(xs: a.operations, item: op.edge),
                operation_shells: list_snoc_item(xs: a.operation_shells, item: member),
                set_aside: list_append(left: a.set_aside, right: op.set_aside),
                entries: body_lower_service_entry_with(entries: a.entries, op: op),
                config: a.config
              }
            )
          })
        } else if id == ^dag_surface_service_config {
          match a.config {
            Present { value: _ } => body_lower_realization_block_repeated(member: member)
            Absent =>
              bind_outcome(o: body_lower_service_config_node(member: member), f: fn(config) {
                outcome_accepted(value: BodyLowerServiceAcc { operations: a.operations, operation_shells: a.operation_shells, set_aside: a.set_aside, entries: a.entries, config: optional_present(value: config) })
              })
          }
        } else if id == ^dag_surface_transport {
          outcome_accepted(
            value: BodyLowerServiceAcc {
              operations: a.operations,
              operation_shells: a.operation_shells,
              set_aside: list_snoc_item(xs: a.set_aside, item: ServiceSetAside { kind: RealizationMemberSetAside, member: member }),
              entries: a.entries,
              config: a.config
            }
          )
        } else {
          body_lower_service_member_unread(member: member)
        }
    }
  })
}

fn body_lower_service_name_optional(captured: Node) -> Optional<List<Symbol>> {
  match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_qualified_name) {
    Absent => Absent
    Present { value: qn_shell } =>
      match parse_production_captured_child_optional(node: qn_shell) {
        Absent => Absent
        Present { value: qn_capture } =>
          match parse_qualified_name_segments_from_capture(qn_capture: qn_capture, root: qn_shell) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: segments, diagnostics: _ } => optional_present(value: segments)
          }
      }
  }
}

// THE TWO GRADES DIFFER ONLY IN WHAT A SET-ASIDE MEMBER MEANS. At census grade
// (v2.compiler.normalize normalize_census, whose carrier has no route past the symbol index) the
// interface is admitted and each set-aside member rides as a located advisory. On every other route
// the lowered service would reach resolution, eval or emission, each of which would have to assume
// the set-aside facts, so it REFUSES at the service with every member's own located diagnostic
// pending: a set-aside realization is unreachable as lowered by construction, not by a door that
// scans reasons.
fn body_lower_service_decl(shell: Node, admit_set_aside: Bool) -> Outcome<BodyLowering> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_service_name_optional(captured: captured) {
        Absent => body_lower_wrapper_retained_shell(shell: shell)
        Present { value: service_name } =>
          match fold(
            body_lower_service_member_shells(root: captured),
            init: outcome_accepted(value: BodyLowerServiceAcc { operations: Empty, operation_shells: Empty, set_aside: Empty, entries: Empty, config: optional_absent() }),
            f: fn(acc, member) { body_lower_service_member(acc: acc, member: member) }
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: a, diagnostics: _ } =>
              match first(repeated_name_edges(children: a.operations)) {
                Present { value: repeated } =>
                  outcome_rejected(
                    d: body_lower_diagnostic(
                      reason: ^body_lowering_reason_service_operation_repeated,
                      n: body_lower_service_second_operation_shell(operations: a.operations, shells: a.operation_shells, label: repeated.label, service: shell)
                    )
                  )
                Absent =>
              match body_lower_service_realization_refusal_optional(shell: shell, a: a) {
                Present { value: refused } => Rejected { diagnostics: diagnostics_singleton(d: refused) }
                Absent =>
              match a.set_aside {
                Empty =>
                  match body_lower_service_realization_leaf_optional(a: a) {
                    Absent => body_lowering_lowered(o: outcome_accepted(value: body_lower_service_node(shell: shell, service_path: service_name, operations: a.operations, realization: optional_absent())))
                    Present { value: _ } => body_lower_service_held(shell: shell, service_path: service_name, a: a, admit_set_aside: admit_set_aside)
                  }
                Cons { head: _, tail: _ } => body_lower_service_held(shell: shell, service_path: service_name, a: a, admit_set_aside: admit_set_aside)
              }
              }
              }
          }
      }
  }
}

// A SERVICE THAT CARRIES A REALIZATION IS HELD OFF THE FULL ROUTE UNTIL XL-2 PR3c gives each stage that
// cannot yet consume the sibling its own located cause: held whenever ANY member is set aside OR a
// realization leaf is present -- a config-only service sets nothing aside, so the leaf alone must keep
// the full route closed. At census grade the service is admitted with its sibling and its set-aside
// members as advisories; on every other route it refuses as service_realization_unreachable, with each
// set-aside member's own diagnostic pending.
fn body_lower_service_held(shell: Node, service_path: List<Symbol>, a: BodyLowerServiceAcc, admit_set_aside: Bool) -> Outcome<BodyLowering> {
  if admit_set_aside {
    Accepted {
      value: BodyLowered { node: body_lower_service_node(shell: shell, service_path: service_path, operations: a.operations, realization: body_lower_service_realization_leaf_optional(a: a)) },
      diagnostics: service_set_aside_diagnostics(xs: a.set_aside)
    }
  } else {
    match a.set_aside {
      Empty => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_realization_unreachable, n: shell))
      Cons { head: _, tail: _ } =>
        Rejected {
          diagnostics: rejected_with_pending(
            pending: service_set_aside_diagnostics(xs: a.set_aside),
            rejected: diagnostics_singleton(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_realization_unreachable, n: shell))
          )
        }
    }
  }
}

// AN OPERATION NAME IS DECLARED ONCE PER SERVICE. The repeat is read once, over the finished
// operation list, from v2.std.node_query repeated_name_edges; this only locates it, at the SECOND
// operation shell carrying that name, so the refusal names the declaration that repeated it.
type BodyLowerServiceRepeatScan {
  shells: List<Node>,
  matched: Int,
  located: Optional<Node>,
}

fn body_lower_service_second_operation_shell(operations: List<Edge>, shells: List<Node>, label: EdgeLabel, service: Node) -> Node {
  let scanned = fold(operations, init: BodyLowerServiceRepeatScan { shells: shells, matched: 0, located: Absent }, f: fn(acc, e) {
    match acc.shells {
      Empty => acc
      Cons { head: sh, tail: more } =>
        if (e.label == label) && (acc.matched == 1) {
          BodyLowerServiceRepeatScan { shells: more, matched: 2, located: Present { value: sh } }
        } else if e.label == label {
          BodyLowerServiceRepeatScan { shells: more, matched: acc.matched + 1, located: acc.located }
        } else {
          BodyLowerServiceRepeatScan { shells: more, matched: acc.matched, located: acc.located }
        }
    }
  })
  match scanned.located {
    Absent => service
    Present { value: sh } => sh
  }
}

// A SERVICE LOWERS UNDER ITS NAME AS A SPINE, ONE SEGMENT PER DOTTED PART (XL-2 service spine; ruling
// 2026-10-01): `service shell.Find { operation Run .. }` is `shell -> <namespace body { Find -> payload
// { Run -> Arrow } }>`, so its operation's declaration path is <module>.shell.Find.Run. Every segment but
// the last is a MARKED namespace body (v2.extdeps.languages.dag namespace_graft_namespace_body_node), so
// v2.compiler.namespace_graft merges the bodies of services sharing a prefix (the sixteen shell.* services
// of dag/extdeps/shell.dag) into one namespace rather than refusing the repeated `shell`. The last segment
// carries the operations' payload, which is not a namespace and never merges. A one-segment name (a
// resource, `service S`) is the single edge it always was.
// Closes the image body_lower_service_node_image builds: its returned node is the named root (v2.std.node
// close_lowered_image).
fn body_lower_service_node(shell: Node, service_path: List<Symbol>, operations: List<Edge>, realization: Optional<Node>) -> Node {
  close_lowered_image(root: body_lower_service_node_image(shell: shell, service_path: service_path, operations: operations, realization: realization))
}

// The service's interface spine and, when it authored any realization facts, its realization sibling: the
// MIRROR of the same path under the unspellable <realization> root (v2.compiler.service_realization),
// whose every prefix is a marked namespace body, so the graft merges the siblings of services that share
// a prefix exactly as it merges their interfaces.
fn body_lower_service_node_image(shell: Node, service_path: List<Symbol>, operations: List<Edge>, realization: Optional<Node>) -> Node {
  let interface = body_lower_service_spine_edge(shell: shell, path: service_path, leaf: body_lower_payload_node(edges: operations, source: shell))
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: match realization {
      Present { value: leaf } => [interface, body_lower_service_spine_edge(shell: shell, path: Cons { head: realization_root_label(), tail: service_path }, leaf: leaf)]
      Absent => [interface]
    },
    occurrence_id: shell.occurrence_id
  )
}

// The realization leaf: one entry per operation that authored realization facts, keyed by the
// operation's name, and the service's <realization-config> when it has one. Absent when empty.
fn body_lower_service_realization_leaf_optional(a: BodyLowerServiceAcc) -> Optional<Node> {
  let edges = match a.config {
    Present { value: c } => list_snoc_item(xs: a.entries, item: Edge { label: Authored { name: realization_config_label() }, target: c })
    Absent => a.entries
  }
  match edges {
    Empty => optional_absent()
    Cons { head: _, tail: _ } => optional_present(value: node_synthetic(kind: TypeNode { connective: Conj }, children: edges))
  }
}

fn body_lower_service_entry_with(entries: List<Edge>, op: BodyLowerOperation) -> List<Edge> {
  match op.entry {
    Present { value: entry } => list_snoc_item(xs: entries, item: Edge { label: op.edge.label, target: entry })
    Absent => entries
  }
}

// THE REALIZATION WALL RUNS ON EVERY LOWERED SERVICE (v2.compiler.service_realization
// service_realization_refusal): a leaf that does not conform refuses the service, located at the
// offending node, on every route.
fn body_lower_service_realization_refusal_optional(shell: Node, a: BodyLowerServiceAcc) -> Optional<Diagnostic> {
  match body_lower_service_realization_leaf_optional(a: a) {
    Absent => optional_absent()
    Present { value: leaf } =>
      match service_realization_refusal(interface: body_lower_payload_node(edges: a.operations, source: shell), realization: leaf) {
        Present { value: r } => optional_present(value: realization_refusal_diagnostic(r: r))
        Absent => optional_absent()
      }
  }
}

fn body_lower_service_spine_edge(shell: Node, path: List<Symbol>, leaf: Node) -> Edge {
  match path {
    Empty => Edge { label: Positional, target: leaf }
    Cons { head: segment, tail: rest } =>
      match rest {
        Empty => Edge { label: Authored { name: segment }, target: leaf }
        Cons { head: _, tail: _ } =>
          Edge {
            label: Authored { name: segment },
            target: namespace_graft_namespace_body_node(edges: [body_lower_service_spine_edge(shell: shell, path: rest, leaf: leaf)], source: shell)
          }
      }
  }
}

// A RESOURCE DECLARATION (v2.extdeps.languages.dag dag_grammar_resource_decl_expr). Its capabilities
// are operations of the resource and lower through the one operation reader (body_lower_operation:
// the same kw-then-ident name and input/output blocks), so a capability is an operation Arrow on the
// payload exactly as a service's operation is, and the declaration node is the service's
// Conj { Name: payload } shape. Its kind, mode, expires and acquire entries are read here against
// their homes (v2.std.resource_declaration) and refuse at the entry when they do not inhabit them, but
// they are NOT carried: no consumer reads them yet, so only the declaration's name rides on the
// captured DeclaredResource. That gap is declared, with its trigger, as gunbc.recurring_failure_mode
// resource_contract_validated_but_not_carried. Nothing is skipped: every entry is read or the
// declaration refuses at the entry.
// `kind` and `mode` are required because every live declaration authors both and no default for
// either exists; a repeated entry refuses at its second occurrence.
type BodyLowerResourceAcc {
  capabilities: List<Edge>,
  capability_shells: List<Node>,
  kind: Optional<ResourceKind>,
  mode: Optional<ResourceMode>,
  expires: Optional<Bool>,
  acquire_read: Bool,
  release_read: Bool,
}

type BodyLowerResource {
  name: Symbol,
  capabilities: List<Edge>,
}

fn body_lower_resource_entry_refused<T>(reason: Symbol, entry: Node) -> Outcome<T> {
  outcome_rejected(d: body_lower_diagnostic(reason: reason, n: entry))
}

// The value of `keyword: value`: the right of the right of the captured sequence spine.
fn body_lower_resource_property_value_optional(entry: Node) -> Optional<Symbol> {
  match parse_production_captured_child_optional(node: entry) {
    Absent => Absent
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => Absent
        Present { value: kw } =>
          match sugar_sequence_pair_optional(node: kw.right) {
            Absent => Absent
            Present { value: colon } => node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: colon.right))
          }
      }
  }
}

// `acquire { [hermetic] }`: the optional between the braces is elided to the empty node when absent,
// and a present one is the `hermetic` literal, the only word the grammar admits there. Answers whether
// the body claims it; Absent when the entry's spine cannot be read, which refuses at the entry.
fn body_lower_resource_acquire_claims_hermetic_optional(entry: Node) -> Optional<Bool> {
  match parse_production_captured_child_optional(node: entry) {
    Absent => Absent
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => Absent
        Present { value: kw } =>
          match sugar_sequence_pair_optional(node: kw.right) {
            Absent => Absent
            Present { value: brace } =>
              match sugar_sequence_pair_optional(node: brace.right) {
                Absent => Absent
                Present { value: inner } =>
                  optional_present(value: !is_empty_conj_root(n: inner.left))
              }
          }
      }
  }
}

fn body_lower_resource_with_kind(a: BodyLowerResourceAcc, entry: Node) -> Outcome<BodyLowerResourceAcc> {
  match a.kind {
    Present { value: _ } => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_repeated, entry: entry)
    Absent =>
      match body_lower_resource_property_value_optional(entry: entry) {
        Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: entry)
        Present { value: label } =>
          match resource_kind_of_label(label: label) {
            Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_value_unknown, entry: entry)
            Present { value: k } =>
              outcome_accepted(value: BodyLowerResourceAcc { capabilities: a.capabilities, capability_shells: a.capability_shells, kind: optional_present(value: k), mode: a.mode, expires: a.expires, acquire_read: a.acquire_read, release_read: a.release_read })
          }
      }
  }
}

fn body_lower_resource_with_mode(a: BodyLowerResourceAcc, entry: Node) -> Outcome<BodyLowerResourceAcc> {
  match a.mode {
    Present { value: _ } => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_repeated, entry: entry)
    Absent =>
      match body_lower_resource_property_value_optional(entry: entry) {
        Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: entry)
        Present { value: label } =>
          match resource_mode_of_label(label: label) {
            Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_value_unknown, entry: entry)
            Present { value: m } =>
              outcome_accepted(value: BodyLowerResourceAcc { capabilities: a.capabilities, capability_shells: a.capability_shells, kind: a.kind, mode: optional_present(value: m), expires: a.expires, acquire_read: a.acquire_read, release_read: a.release_read })
          }
      }
  }
}

fn body_lower_resource_with_expires(a: BodyLowerResourceAcc, entry: Node) -> Outcome<BodyLowerResourceAcc> {
  match a.expires {
    Present { value: _ } => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_repeated, entry: entry)
    Absent =>
      match body_lower_resource_property_value_optional(entry: entry) {
        Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: entry)
        Present { value: token } =>
          if token == ^dag_token_kw_true {
            outcome_accepted(value: BodyLowerResourceAcc { capabilities: a.capabilities, capability_shells: a.capability_shells, kind: a.kind, mode: a.mode, expires: optional_present(value: true), acquire_read: a.acquire_read, release_read: a.release_read })
          } else if token == ^dag_token_kw_false {
            outcome_accepted(value: BodyLowerResourceAcc { capabilities: a.capabilities, capability_shells: a.capability_shells, kind: a.kind, mode: a.mode, expires: optional_present(value: false), acquire_read: a.acquire_read, release_read: a.release_read })
          } else {
            body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: entry)
          }
      }
  }
}

fn body_lower_resource_with_acquire(a: BodyLowerResourceAcc, entry: Node) -> Outcome<BodyLowerResourceAcc> {
  if a.acquire_read {
    body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_repeated, entry: entry)
  } else {
    match body_lower_resource_acquire_claims_hermetic_optional(entry: entry) {
      Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: entry)
      Present { value: _ } =>
        outcome_accepted(value: BodyLowerResourceAcc { capabilities: a.capabilities, capability_shells: a.capability_shells, kind: a.kind, mode: a.mode, expires: a.expires, acquire_read: true, release_read: a.release_read })
    }
  }
}

fn body_lower_resource_with_release(a: BodyLowerResourceAcc, entry: Node) -> Outcome<BodyLowerResourceAcc> {
  if a.release_read {
    body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_repeated, entry: entry)
  } else {
    outcome_accepted(value: BodyLowerResourceAcc { capabilities: a.capabilities, capability_shells: a.capability_shells, kind: a.kind, mode: a.mode, expires: a.expires, acquire_read: a.acquire_read, release_read: true })
  }
}

// A CAPABILITY'S io TAILS ARE THE SERVICE'S, AND REFUSE THE SERVICE'S WAY. A capability reads its
// input/output blocks through the shared io field grammar, which admits a `from "key"` wire key and an
// `= expr` default; body_lower_operation sets each aside as interface_member_unmodeled, located at the
// io item. A resource then refuses exactly as a service with a set-aside member does on a route past
// the census: the owned fatal cause service_realization_unreachable, at the capability, with each
// member's own located diagnostic pending. So body_lowering_reason_resource_entry_unread is reached
// only by a malformed entry, never by a well-formed tail.
fn body_lower_resource_with_capability(a: BodyLowerResourceAcc, entry: Node) -> Outcome<BodyLowerResourceAcc> {
  bind_outcome(o: body_lower_operation(shell: entry), f: fn(op) {
    match list_append(left: op.set_aside, right: op.realization_members) {
      Empty =>
        outcome_accepted(value: BodyLowerResourceAcc { capabilities: list_snoc_item(xs: a.capabilities, item: op.edge), capability_shells: list_snoc_item(xs: a.capability_shells, item: entry), kind: a.kind, mode: a.mode, expires: a.expires, acquire_read: a.acquire_read, release_read: a.release_read })
      Cons { head: _, tail: _ } =>
        Rejected {
          diagnostics: rejected_with_pending(
            pending: service_set_aside_diagnostics(xs: list_append(left: op.set_aside, right: op.realization_members)),
            rejected: diagnostics_singleton(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_realization_unreachable, n: entry))
          )
        }
    }
  })
}

fn body_lower_resource_entry(acc: Outcome<BodyLowerResourceAcc>, entry: Node) -> Outcome<BodyLowerResourceAcc> {
  bind_outcome(o: acc, f: fn(a) {
    match parse_production_emitted_identity_optional(node: entry) {
      Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: entry)
      Present { value: id } =>
        if id == ^dag_surface_resource_kind {
          body_lower_resource_with_kind(a: a, entry: entry)
        } else if id == ^dag_surface_resource_mode {
          body_lower_resource_with_mode(a: a, entry: entry)
        } else if id == ^dag_surface_resource_expires {
          body_lower_resource_with_expires(a: a, entry: entry)
        } else if id == ^dag_surface_resource_acquire {
          body_lower_resource_with_acquire(a: a, entry: entry)
        } else if id == ^dag_surface_resource_release {
          body_lower_resource_with_release(a: a, entry: entry)
        } else if id == ^dag_surface_capability {
          body_lower_resource_with_capability(a: a, entry: entry)
        } else {
          body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: entry)
        }
    }
  })
}

fn body_lower_resource_read(shell: Node) -> Outcome<BodyLowerResource> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: shell)
    Present { value: captured } =>
      match dag_surface_kw_then_ident_from_captured(captured: captured) {
        Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_unread, entry: shell)
        Present { value: name } =>
          bind_outcome(
            o: fold(
              body_lower_service_member_shells(root: captured),
              init: outcome_accepted(value: BodyLowerResourceAcc { capabilities: Empty, capability_shells: Empty, kind: Absent, mode: Absent, expires: Absent, acquire_read: false, release_read: false }),
              f: fn(acc, entry) { body_lower_resource_entry(acc: acc, entry: entry) }
            ),
            f: fn(a) { body_lower_resource_finish(shell: shell, name: name, a: a) }
          )
      }
  }
}

fn body_lower_resource_finish(shell: Node, name: Symbol, a: BodyLowerResourceAcc) -> Outcome<BodyLowerResource> {
  match first(repeated_name_edges(children: a.capabilities)) {
    Present { value: repeated } =>
      body_lower_resource_entry_refused(
        reason: ^body_lowering_reason_resource_entry_repeated,
        entry: body_lower_service_second_operation_shell(operations: a.capabilities, shells: a.capability_shells, label: repeated.label, service: shell)
      )
    Absent =>
      match a.kind {
        Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_missing, entry: shell)
        Present { value: _ } =>
          match a.mode {
            Absent => body_lower_resource_entry_refused(reason: ^body_lowering_reason_resource_entry_missing, entry: shell)
            Present { value: _ } =>
              outcome_accepted(value: BodyLowerResource { name: name, capabilities: a.capabilities })
          }
      }
  }
}

fn body_lower_resource_decl(shell: Node) -> Outcome<BodyLowering> {
  bind_outcome(o: body_lower_resource_read(shell: shell), f: fn(r) {
    body_lowering_lowered(o: outcome_accepted(value: body_lower_service_node(shell: shell, service_path: [r.name], operations: r.capabilities, realization: optional_absent())))
  })
}

// The captured kind of a resource declaration is its NAME, read by the same kw-then-ident decoder the
// lowering uses, and nothing else: re-running the entry reader here would validate every entry a
// second time for a result the lowering already decided. The capture never needs that verdict, because
// a declaration the lowering refuses refuses its whole module, so no captured name outlives a refused
// declaration on any route that reads the capture.
fn body_lower_resource_decl_declared_kind_optional(shell: Node) -> Optional<DeclaredTypeKind> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => optional_absent()
    Present { value: captured } =>
      match dag_surface_kw_then_ident_from_captured(captured: captured) {
        Absent => optional_absent()
        Present { value: name } => optional_present(value: DeclaredResource { name: name })
      }
  }
}

// AN `alias` DECLARATION REFUSES, AT ITSELF, UNTIL ITS BINDING ROW IS CARRIED (operator ruling via
// stern-bear-500, 2026-10-05). The `alias Name = a.b.C` form (dag_grammar_alias_decl_expr, keyword
// kw_alias) is NOT a type alias `type X = Y`, which lowers as a type declaration. Lowered as metadata,
// the declaration was grafted as a member named Name whose row nothing read from the normalized tree,
// so Name resolved to its own grafted node instead of a.b.C: a silent wrong answer (DESIGN section 5).
// No .dag source declares one. The carry is gunbc.recurring_failure_mode
// alias_declaration_binding_row_not_carried; when it lands this arm is deleted.
fn body_lower_alias_decl_refused(shell: Node) -> Outcome<Node> {
  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_alias_binding_row_not_carried, n: shell))
}

fn body_lower_production_emitted(shell: Node, emitted: Symbol, fn_body_pass_through: Bool) -> Outcome<BodyLowering> {
  if emitted == ^dag_surface_service_decl {
    body_lower_service_decl(shell: shell, admit_set_aside: false)
  } else if emitted == ^dag_surface_resource_decl {
    body_lower_resource_decl(shell: shell)
  } else if emitted == ^dag_surface_type_decl {
    body_lowering_lowered(o: body_lower_type_decl(shell: shell))
  } else if emitted == ^dag_surface_alias_decl {
    body_lowering_lowered(o: body_lower_alias_decl_refused(shell: shell))
  } else if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
    body_lowering_lowered(o: outcome_accepted(value: shell))
  } else if emitted == ^dag_surface_type_variant {
    body_lowering_lowered(o: body_lower_type_variant(shell: shell))
  } else if emitted == ^dag_surface_admit_callers_clause {
    body_lowering_lowered(o: outcome_accepted(value: body_lower_admit_clause_image(clause: shell)))
  } else if body_lower_is_structure_preserved_emitted(emitted: emitted) {
    body_lowering_lowered(o: outcome_accepted(value: shell))
  } else if emitted == ^dag_surface_fn_body && fn_body_pass_through {
    body_lowering_lowered(o: outcome_accepted(value: shell))
  } else if body_lower_is_deferred_lower_emitted(emitted: emitted) {
    body_lowering_lowered(o: outcome_accepted(value: shell))
  } else if body_producer_forward_is_registered_surface_identity(surface_identity: emitted) {
    body_lower_forward_row_apply(shell: shell, emitted: emitted)
  } else if emitted == ^dag_surface_postfix_expr {
    body_lowering_lowered(o: body_lower_postfix_expr(shell: shell))
  } else if body_lower_is_pass_through_emitted(emitted: emitted) {
    body_lowering_lowered(o: body_lower_unwrap_pass_through(shell: shell))
  } else if emitted == ^dag_surface_primary_expr {
    body_lowering_lowered(o: body_lower_primary_expr(shell: shell))
  } else {
    body_lower_wrapper_retained_shell(shell: shell)
  }
}

// AN ELSE-LESS `if` IS LOWERED ONLY AS A GUARD, AND REFUSED EVERYWHERE ELSE, NEVER DROPPED. A guard
// -- `if c { ..; return e }` heading a tail spine with a following statement -- lowers to
// Branch(c, arm, rest of the spine) (body_lower_guard_branch); body_lower_exit_outside_tail_optional
// admits it. An else-less `if` whose arm falls through, or that has no following statement, or that
// sits outside a tail spine, is a typed, located, counted refusal.
fn body_lower_else_less_if_reject(shell: Node) -> Outcome<Node> {
  outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_else_less_if_unlowered, n: shell)
  )
}

// A `return` IS RECOGNISED, NEVER SEARCHED PAST. The dag grammar's stmt admits seq(`return`, expr)
// (v2.extdeps.languages.dag dag_grammar_stmt_expr), and no reader here named the keyword: a deep
// first-match search answered the statement with its expression, so the exit was dropped. In tail
// position that was the right value by luck; anywhere else it was a wrong answer -- `let x = if c {
// return j } else { k }` lowered to x = Branch(c, j, k), the function continuing where it should
// have exited (gunbc.recurring_failure_mode return_lowered_as_its_operand_outside_the_function_tail).
//
// So a return lowers only in TAIL POSITION, where "exit with e" and "the block's value is e" are the
// same fact: the tail statement of a function's own body (a fn declaration's, or a fn value's block
// body), of an arm of a tail if or match, and of an admitted guard's arm (body_lower_exit_outside_tail_optional,
// read top-down from the raw parse before any reader runs). Every other return refuses, located at
// it, as return_not_in_tail_position.
// Answers the returned expression when `stmt` -- a stmt shell or its captured sequence -- is one.
fn body_lower_return_statement_expr_optional(stmt: Node) -> Optional<Node> {
  let captured = match parse_production_captured_child_optional(node: stmt) {
    Present { value: c } => c
    Absent => stmt
  }
  match sugar_sequence_pair_optional(node: body_lower_unwrap_surface_shell(node: captured)) {
    Absent => optional_absent()
    Present { value: pair } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: pair.left)) {
        Present { value: id } =>
          if id == ^dag_token_kw_return { optional_present(value: pair.right) } else { optional_absent() }
        Absent => optional_absent()
      }
  }
}

// AN ELSE-LESS `if`'S PARTS, read positionally: dag_grammar_if_expr_expr's block form without its
// optional else captures seq(`if`, seq(condition, seq(fn_body, <empty>))). The expression form and a
// block form with an else do not have that shape, so this reader answers exactly the `if` that has
// no value (operator ruling 2026-10-03). At statement position it is a guard when its arm's last
// statement is a return (body_lower_admitted_guard_optional), so the guard exits exactly when it is
// taken; an arm that falls through (`if c { log() }`) is not a guard and refuses else_less_if_unlowered,
// as does every else-less `if` where a value is owed.
type BodyLowerGuard {
  shell: Node
  condition: Node
  arm: Node
}

fn body_lower_else_less_if_parts_optional(if_shell: Node) -> Optional<BodyLowerGuard> {
  match body_lower_unwrap_captured(shell: if_shell) {
    Absent => optional_absent()
    Present { value: captured } =>
      match body_lower_if_row_arms_optional(captured: captured) {
        Absent => optional_absent()
        Present { value: arms } =>
          match arms.else_slot {
            IfRowNoElse =>
              if body_lower_is_fn_body_shell(node: body_lower_deep_unwrap_optional(node: arms.then_slot)) {
                optional_present(value: BodyLowerGuard { shell: if_shell, condition: arms.condition, arm: arms.then_slot })
              } else {
                optional_absent()
              }
            IfRowElsePart { else_part: _ } => optional_absent()
          }
      }
  }
}

fn body_lower_is_fn_body_shell(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } => id == ^dag_surface_fn_body
    Absent => false
  }
}

// The `if` a statement IS, when the whole statement is one `if`: the statement's production shells
// and the operator spines whose tail is empty are passed through, as body_lower_exit_walk passes
// them; anything else -- an `if` that is an operand, a call, a literal -- is not one.
fn body_lower_statement_sole_if_optional(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_if_expr {
        optional_present(value: node)
      } else if body_lower_is_pass_through_emitted(emitted: id) || (id == ^dag_surface_primary_expr) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_statement_sole_if_optional(node: captured)
          Absent => optional_absent()
        }
      } else {
        optional_absent()
      }
    Absent =>
      let peeled = body_lower_deep_unwrap_optional(node: node)
      if peeled != node {
        body_lower_statement_sole_if_optional(node: peeled)
      } else {
        match sugar_sequence_pair_optional(node: node) {
          Present { value: pair } =>
            if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
              body_lower_statement_sole_if_optional(node: pair.left)
            } else {
              optional_absent()
            }
          Absent => optional_absent()
        }
      }
  }
}

fn body_lower_guard_optional(stmt: Node) -> Optional<BodyLowerGuard> {
  match body_lower_statement_sole_if_optional(node: stmt) {
    Present { value: if_shell } => body_lower_else_less_if_parts_optional(if_shell: if_shell)
    Absent => optional_absent()
  }
}

fn body_lower_admitted_guard_optional(stmt: Node) -> Optional<BodyLowerGuard> {
  match body_lower_guard_optional(stmt: stmt) {
    Absent => optional_absent()
    Present { value: guard } =>
      match body_lower_fn_body_stmt_seq_optional(fn_body: guard.arm) {
        Absent => optional_absent()
        Present { value: stmt_seq } =>
          match body_lower_unwrap_captured(shell: stmt_seq) {
            Absent => optional_absent()
            Present { value: spine } =>
              match body_lower_stmt_spine_last_optional(spine: spine) {
                Present { value: last } =>
                  match body_lower_return_statement_expr_optional(stmt: last) {
                    Present { value: _ } => optional_present(value: guard)
                    Absent => optional_absent()
                  }
                Absent => optional_absent()
              }
          }
      }
  }
}

// The last statement of a statement spine (body_lower_stmt_spine's shape).
fn body_lower_stmt_spine_last_optional(spine: Node) -> Optional<Node> {
  match body_lower_stmt_spine_head_optional(spine: spine) {
    Absent => optional_absent()
    Present { value: head } =>
      if body_lower_stmt_spine_has_successor(spine: spine) {
        match body_lower_stmt_spine_rest_optional(spine: spine) {
          Present { value: rest } => body_lower_stmt_spine_last_optional(spine: rest)
          Absent => optional_present(value: head)
        }
      } else {
        optional_present(value: head)
      }
  }
}

// THE EXITS OF A FUNCTION BODY ARE ADMITTED BY ONE TOP-DOWN WALK OF ITS RAW PARSE, carrying whether
// the node's value is the function's result (`tail`). Two exits are admitted, only in tail position:
// a `return e`, which then lowers to `e` (the block's value IS the function's result), and a guard
// -- a statement-form else-less `if c { ..; return e }` heading a tail spine with a following
// statement -- which lowers to Branch(c, arm, rest of the spine). The tail passes to a fn_body's
// statements, a spine's LAST statement, each arm of an `if` or `match`, an admitted guard's arm, and
// through a shell whose value is its one child; everything else -- a condition, a scrutinee, a let
// value, an operand, a statement followed by another -- is not a tail, and neither is anything under
// it. The walk answers the FIRST exit in pre-order that is not admitted, as a located refusal
// (return_not_in_tail_position, or else_less_if_unlowered), and it runs before any reader, so the
// readers that lower a return to its operand, or a guard to a Branch, only ever meet admitted exits.
// A nested function value owns its own exits. A shape the walk does not recognise passes no tail,
// so an unrecognised position refuses -- it never widens
// (gunbc.recurring_failure_mode return_lowered_as_its_operand_outside_the_function_tail). One pass,
// no site lists and no membership scans: each node is visited once.
fn body_lower_exit_outside_tail_optional(node: Node, tail: Bool) -> Optional<Outcome<Node>> {
  body_lower_exit_walk(node: node, tail: tail, arm_tail: false)
}

fn body_lower_exit_refused(reason: Symbol, at: Node) -> Optional<Outcome<Node>> {
  optional_present(value: outcome_rejected(d: body_lower_diagnostic(reason: reason, n: at)))
}

// The first refusal among `children`, each walked with the same flags.
fn body_lower_exit_walk_children(node: Node, tail: Bool, arm_tail: Bool) -> Optional<Outcome<Node>> {
  fold(node.children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => body_lower_exit_walk(node: e.target, tail: tail, arm_tail: arm_tail)
    }
  })
}

fn body_lower_exit_first(first: Optional<Outcome<Node>>, next_arm: Node, tail: Bool) -> Optional<Outcome<Node>> {
  match first {
    Present { value: _ } => first
    Absent => body_lower_exit_walk(node: next_arm, tail: tail, arm_tail: false)
  }
}

// `arm_tail` is the tail a `match` hands to the match_arm shells below it; it crosses only the
// unnamed sequence nodes between the match and its arms, and any other production resets it.
fn body_lower_exit_walk(node: Node, tail: Bool, arm_tail: Bool) -> Optional<Outcome<Node>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if body_lower_find_captured_prunable(id: id) {
        optional_absent()
      } else if id == ^dag_surface_stmt {
        match body_lower_return_statement_expr_optional(stmt: node) {
          Present { value: operand } =>
            if tail {
              body_lower_exit_walk(node: operand, tail: false, arm_tail: false)
            } else {
              body_lower_exit_refused(reason: ^body_lowering_reason_return_not_in_tail_position, at: node)
            }
          Absent => body_lower_exit_walk_children(node: node, tail: tail, arm_tail: false)
        }
      } else if id == ^dag_surface_stmt_seq {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: spine } => body_lower_exit_walk_spine(spine: spine, tail: tail)
          Absent => optional_absent()
        }
      } else if id == ^dag_surface_match_arm_stmt_body || id == ^dag_surface_lambda_stmt_body {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: spine } => body_lower_exit_walk_spine(spine: spine, tail: tail)
          Absent => optional_absent()
        }
      } else if id == ^dag_surface_fn_body {
        match body_lower_fn_body_stmt_seq_optional(fn_body: node) {
          Present { value: stmt_seq } => body_lower_exit_walk(node: stmt_seq, tail: tail, arm_tail: false)
          Absent => body_lower_exit_walk_children(node: node, tail: false, arm_tail: false)
        }
      } else if id == ^dag_surface_if_expr {
        body_lower_exit_walk_if(shell: node, tail: tail)
      } else if id == ^dag_surface_match_expr {
        body_lower_exit_walk_children(node: node, tail: false, arm_tail: tail)
      } else if id == ^dag_surface_match_arm {
        match body_lower_match_arm_body_capture_optional(stripped: body_lower_match_arm_stripped(arm: node)) {
          Present { value: body } => body_lower_exit_walk(node: body, tail: arm_tail, arm_tail: false)
          Absent => body_lower_exit_walk_children(node: node, tail: false, arm_tail: false)
        }
      } else if body_lower_is_pass_through_emitted(emitted: id) || (id == ^dag_surface_primary_expr) {
        body_lower_exit_walk_children(node: node, tail: tail, arm_tail: false)
      } else {
        body_lower_exit_walk_children(node: node, tail: false, arm_tail: false)
      }
    Absent =>
      let peeled = body_lower_deep_unwrap_optional(node: node)
      if peeled != node {
        body_lower_exit_walk(node: peeled, tail: tail, arm_tail: arm_tail)
      } else {
        match sugar_sequence_pair_optional(node: node) {
          Present { value: pair } =>
            if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
              body_lower_exit_walk(node: pair.left, tail: tail, arm_tail: arm_tail)
            } else {
              body_lower_exit_walk_children(node: node, tail: false, arm_tail: arm_tail)
            }
          Absent => body_lower_exit_walk_children(node: node, tail: false, arm_tail: arm_tail)
        }
      }
  }
}

// A match_arm shell's own sequence, peeled as body_lower_wire_match_arm_capture peels it.
fn body_lower_match_arm_stripped(arm: Node) -> Node {
  match parse_production_captured_child_optional(node: arm) {
    Present { value: captured } => body_lower_deep_unwrap_optional(node: captured)
    Absent => body_lower_deep_unwrap_optional(node: arm)
  }
}

// An `if`: its condition is not a tail; each arm is the if's own tail. The three reads cover the
// whole if -- the rest of it is keywords -- and an if they cannot read is walked with no tail.
fn body_lower_exit_walk_if(shell: Node, tail: Bool) -> Optional<Outcome<Node>> {
  match body_lower_else_less_if_parts_optional(if_shell: shell) {
    Present { value: _ } => body_lower_exit_refused(reason: ^body_lowering_reason_else_less_if_unlowered, at: shell)
    Absent => body_lower_exit_walk_if_valued(shell: shell, tail: tail)
  }
}

fn body_lower_exit_walk_if_valued(shell: Node, tail: Bool) -> Optional<Outcome<Node>> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_exit_walk_children(node: shell, tail: false, arm_tail: false)
    Present { value: captured } =>
      match body_lower_if_condition_optional(captured: captured) {
        Absent => body_lower_exit_walk_children(node: shell, tail: false, arm_tail: false)
        Present { value: condition } =>
          let after_condition = match body_lower_if_then_arm_optional(captured: captured) {
            Present { value: arm } => body_lower_exit_first(first: body_lower_exit_walk(node: condition, tail: false, arm_tail: false), next_arm: body_lower_if_arm_as_node(arm: arm), tail: tail)
            Absent => body_lower_exit_walk_children(node: shell, tail: false, arm_tail: false)
          }
          match body_lower_if_else_capture_optional(captured: captured) {
            Present { value: arm } => body_lower_exit_first(first: after_condition, next_arm: body_lower_if_arm_as_node(arm: arm), tail: tail)
            Absent => after_condition
          }
      }
  }
}

// An if arm reader answers either a production shell (an `else if`'s if_expr) or a fn_body's
// captured sequence seq(`{`, seq(stmt_seq, `}`)); the second is read to its stmt_seq, positionally,
// as body_lower_fn_body_stmt_seq_optional reads it below its shell.
fn body_lower_if_arm_as_node(arm: Node) -> Node {
  match parse_production_emitted_identity_optional(node: arm) {
    Present { value: _ } => arm
    Absent =>
      match sugar_sequence_pair_optional(node: body_lower_unwrap_surface_shell(node: arm)) {
        Absent => arm
        Present { value: brace_rest } =>
          match sugar_sequence_pair_optional(node: brace_rest.right) {
            Absent => arm
            Present { value: seq_close } => body_lower_deep_unwrap_optional(node: seq_close.left)
          }
      }
  }
}

// A spine: a statement followed by another is not a tail, except an admitted guard heading a tail
// spine, whose condition is not a tail and whose arm is; the last statement is the spine's tail.
fn body_lower_exit_walk_spine(spine: Node, tail: Bool) -> Optional<Outcome<Node>> {
  match body_lower_stmt_spine_head_optional(spine: spine) {
    Absent => optional_absent()
    Present { value: head } =>
      if body_lower_stmt_spine_has_successor(spine: spine) {
        let here = match body_lower_admitted_guard_optional(stmt: head) {
          Present { value: guard } =>
            if tail {
              body_lower_exit_first(first: body_lower_exit_walk(node: guard.condition, tail: false, arm_tail: false), next_arm: guard.arm, tail: true)
            } else {
              body_lower_exit_walk(node: head, tail: false, arm_tail: false)
            }
          Absent =>
            match body_lower_let_match_exit_of_stmt_optional(stmt: head) {
              Present { value: plan } =>
                if tail { body_lower_exit_walk_let_match(plan: plan, at: head) } else { body_lower_exit_walk(node: head, tail: false, arm_tail: false) }
              Absent => body_lower_exit_walk(node: head, tail: false, arm_tail: false)
            }
        }
        match here {
          Present { value: _ } => here
          Absent =>
            match body_lower_stmt_spine_rest_optional(spine: spine) {
              Present { value: rest } => body_lower_exit_walk_spine(spine: rest, tail: tail)
              Absent => optional_absent()
            }
        }
      } else {
        body_lower_exit_walk(node: head, tail: tail, arm_tail: false)
      }
  }
}

// A let-match heading a tail spine (body_lower_let_match_exit_plan_optional): exactly one binding
// arm is admitted. Its scrutinee and its binding arm are not tails -- a return there would exit from
// inside the value x is bound to -- and each exiting arm is the function's tail. Two or more binding
// arms refuse at the let; none falls to the ordinary walk, which refuses the first return.
fn body_lower_exit_walk_let_match(plan: BodyLowerLetMatchExit, at: Node) -> Optional<Outcome<Node>> {
  let bindings = body_lower_let_match_binding_count(plan: plan)
  if bindings > 1 {
    body_lower_exit_refused(reason: ^body_lowering_reason_multi_binding_arm_early_return_needs_join_point, at: at)
  } else if bindings == 0 {
    body_lower_exit_walk(node: at, tail: false, arm_tail: false)
  } else {
    fold(plan.arms, init: body_lower_exit_walk(node: plan.scrutinee, tail: false, arm_tail: false), f: fn(acc, a) {
      match acc {
        Present { value: _ } => acc
        Absent => body_lower_exit_walk(node: a.body, tail: a.exits, arm_tail: false)
      }
    })
  }
}

// A statement read as a value in the tail of a function body: a return lowers to what it returns.
fn body_lower_tail_statement_read(stmt: Node) -> Outcome<Node> {
  match body_lower_return_statement_expr_optional(stmt: stmt) {
    Present { value: e } => body_lower_value_read(value: e)
    Absent => body_lower_value_read(value: stmt)
  }
}

fn body_lower_after_children(folded: Node, fn_body_pass_through: Bool) -> Outcome<BodyLowering> {
  if body_lower_is_core_substrate(node: folded) {
    body_lowering_lowered(o: outcome_accepted(value: folded))
  } else if dag_resolve_preserve_module_metadata_subtree(node: folded) {
    body_lowering_lowered(o: outcome_accepted(value: folded))
  } else if body_lower_is_unrecognised_lowered_shape(node: folded) {
    body_lowering_lowered(o: Rejected { diagnostics: body_lower_unrecognised_lowered_shape_diagnostics(node: folded) })
  } else {
    match parse_production_emitted_identity_optional(node: folded) {
      Absent => body_lowering_lowered(o: outcome_accepted(value: folded))
      Present { value: emitted } =>
        body_lower_production_emitted(
          shell: folded,
          emitted: emitted,
          fn_body_pass_through: fn_body_pass_through
        )
    }
  }
}

fn body_lower_finish(n: Node, folded: Node, cd: Diagnostics) -> Outcome<BodyLowering> {
  body_lower_finish_for_normalize(
    n: n,
    folded: folded,
    cd: cd,
    fn_body_pass_through: false
  )
}

fn body_lower_finish_for_normalize(
  n: Node,
  folded: Node,
  cd: Diagnostics,
  fn_body_pass_through: Bool
) -> Outcome<BodyLowering> {
  body_lowering_after_pending(
    pending: cd,
    o: body_lower_after_children(folded: folded, fn_body_pass_through: fn_body_pass_through)
  )
}

