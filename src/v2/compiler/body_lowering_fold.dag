data body_lowering_fold_note: String = "Forward body producer fold (general-body-producer Stage A remainder + B/C/D): production-identity dispatch in normalize AFTER child-fold, BEFORE sugar (body_lower_finish in 03_normalize.dag). INTERIM scaffold — dissolves into v2.compiler.body_producer_forward GrammarRelationRow forward fold (general-body-producer-design §3) once Slice 4 deletes this module; match/if/body_try hand-walker scaffolds dissolved into body_producer_forward + body_lower_fold. COMPLEMENTS #6443 fold_lowering.dag — does NOT re-fork it. Seam: fold_lowering owns fold-CALL semantic desugar (callee-head keyed: ^fold/^fold_list/… → seam Loop via fold_call_to_loop); body_lowering_fold owns fn-BODY shape lowering (fn_decl→Arrow+domain, infix→Transform, let→Bind, …). The only overlap point is body_lower_try_fold_loop which DELEGATES to fold_call_to_loop — one authority, no parallel fold→Loop path. Pass-through expr wrappers unwrap; ^dag_surface_fn_body is deferred (shell retained until parent fn_decl lowers); metadata (module/import/qn) preserved; core substrate (Arrow, ComputationNode) is a positive terminal; out-of-scope emitted identities land wrapper-retained as the typed BodyWrapperRetained variant (general-body-producer-design Stage A frontier: lowered | wrapper-retained, refused at the retained shell by the normalized-tree door — never silent shell accept)."

data body_lowering_fold_dissolution_contract: DissolutionCondition = unbound_dissolution(description: "FLAG E dissolution DELETES this module — coverage lives in v2.compiler.body_producer_forward forward rows + GrammarRelationRow slot-map apply (general-body-producer-design §3). The hand-authored families (body_lower_deep_unwrap*, body_lower_operand_ref*, body_lower_operator_tail/infix*, body_lower_postfix_projection*) are receipt scaffolding only. Acceptance: this file is gone and coverage lives in forward rows + existing witnesses. match/if/body_try hand-walker scaffolds LANDED: body_lower_try_body_lowered delegates behavior productions to body_lower_fold; body_producer_forward owns the forward row table.")

data body_lowering_rejection_propagation_note: String = "GENUINE REJECTION PROPAGATES; RETENTION IS PRODUCED, NEVER INFERRED FROM FAILURE (2026-08-11). body_lower_finish_for_normalize previously matched EVERY Rejected from body_lower_after_children and returned a wrapper-retained Accepted instead, binding the rejection diagnostics to _ and discarding them. That conflated four different states behind one arm: this lowering strategy does not apply, this valid form has no producer yet, this form is malformed, and an invariant was violated. It is the inverse of the not-applicable-versus-malformed conflation #6558 already ruled on, moved out to the outer seam.\n\nThe repair is a deletion rather than a new mechanism, because the legitimate case was already explicit: body_lower_production_emitted's final arm returns body_lower_wrapper_retained_shell for an emitted identity with no registered producer. That IS the declared lowered | wrapper-retained frontier, produced deliberately at the point where not-applicable is known. The outer catch was therefore a second, inferential source of retention standing beside the real one, and it could only fire on outcomes the strategy functions had already judged. So retention now has exactly one producer, and the outer Outcome owns genuine rejection with its diagnostics preserved through rejected_with_pending.\n\nWHAT THIS DOES NOT DO: it does not scope, weaken or relocate normalize's recursive well_formed gate, which #6520 established as the sole structural wall and which stays unchanged. Modules whose retained bodies still fail that gate continue to fail it; this change only stops a real refusal from being relabelled as a counted frontier state on its way there."

data body_lowering_interim_scaffold_dissolved_note: String = "Wave 1 Gate 1 Track B: match/if/body_try interim hand-walker scaffolds dissolved into body_producer_forward (forward row table + production-identity dispatch via body_lower_fold). body_lowering_interim_scaffold_seed_retained_count is pinned at 0 — RED if any SeedRetained scaffold reappears."

// Wave 1 Gate 1 A1/B1: param-name domain harvesting is terminal param-list-walk (declaration
// reading, not SymbolIndex resolution). BodyLoweringDomainSymbolIndexResolved deleted in B1 —
// uninhabited variant with no migration trigger (operator ruling 2026-07-14).

fn body_lowering_interim_scaffold_seed_retained_count() -> Int {
  0
}

fn body_lowering_forward_behavior_row_count() -> Int {
  body_producer_forward_row_count()
}

fn body_lower_fold_behavior_surface_identities() -> List<Symbol> {
  body_producer_forward_surface_identities()
}

fn body_lowering_surface_identity_list_contains(xs: List<Symbol>, target: Symbol) -> Bool {
  fold(xs, init: false, f: fn(acc, id) { acc || id == target })
}

fn body_lowering_forward_fold_surface_identities_agree() -> Bool {
  let forward = body_producer_forward_surface_identities()
  let fold_ids = body_lower_fold_behavior_surface_identities()
  if length(xs: forward) != length(xs: fold_ids) {
    false
  } else {
    fold(forward, init: true, f: fn(acc, id) {
      acc && body_lowering_surface_identity_list_contains(xs: fold_ids, target: id)
    })
  }
}

// WRAPPER RETENTION IS A TYPED VALUE, NOT A DIAGNOSTIC REASON (MQ-4). A shell this lowering has no
// producer for is RETAINED: it stays in the tree as its parse shell, and the module that holds it
// must not be admitted as normalized. Retention used to travel as an advisory Diagnostic whose
// reason was body_lowering_reason_wrapper_retained_emitted, and every reader -- the NormalizedTree
// door, the census door, the frontier classifier -- recovered it by scanning diagnostic REASONS: a
// classifier over an encoding, correct only while exactly one producer spelled the reason exactly
// one way, and silently wrong the moment a helper merged diagnostics with `_`.
//
// It is now a variant of the lowering's own result. WrapperRetention is minted ONLY by
// body_lower_wrapper_retained_shell (sole_constructor confines the construction to this module, and
// that function is its one call site here), and a retained result is the BodyWrapperRetained arm of
// BodyLowering, so no reader can take the lowered Node without matching the arm that is not one.
// That is the drop guarantee, stated at its honest rung: .dag has no module-private declarations,
// so a discard is still WRITABLE -- by a match arm that names BodyWrapperRetained and drops it, or
// by any reader that projects BodyLoweredTree.node and ignores .retained -- but never by a silent
// `diagnostics: _`. The arms that exist are exactly three: the value-position
// unwrap below REFUSES, the frontier classifier REPORTS, and v2.compiler.normalize threads the
// retention into its accumulator (BodyLoweredTree) for v2.compiler.normalized_tree to refuse at the
// retained shell's own locus.
type WrapperRetention sole_constructor {
  shell: Node,
}

type BodyLowering
  = BodyLowered { node: Node }
  | BodyWrapperRetained { retention: WrapperRetention }

// THE LOWERING OF A SUBTREE, with every retention found beneath it. This is normalize's accumulator,
// declared here beside the variant it accumulates. Its two fields are one fact -- `node` is admitted
// only when `retained` is empty -- so the only readers are the combinators below, which always carry
// `retained` forward, and v2.compiler.normalized_tree admit_retention_free, the one place a Node
// leaves it.
type BodyLoweredTree sole_constructor {
  node: Node,
  retained: FreeMonoid<WrapperRetention>,
}

// The one refusal cause for a retained wrapper, located at the retained SHELL rather than at the
// module root. It is the cause v2.workflow.compile_door_cause_ownership already rosters for the
// normalized-tree door, because the refusal is the same fact wherever it fires.
fn wrapper_retention_diagnostic(r: WrapperRetention) -> Diagnostic {
  body_lower_diagnostic(reason: ^normalized_tree_reason_wrapper_retention_not_normalized, n: r.shell)
}

// Earlier retentions first, so the typed population stays in structural order; an empty later list, the
// common case, costs nothing.
fn wrapper_retentions_concat(
  earlier: FreeMonoid<WrapperRetention>,
  later: FreeMonoid<WrapperRetention>
) -> FreeMonoid<WrapperRetention> {
  match later {
    Empty => earlier
    Cons { head: _, tail: _ } => list_append(left: earlier, right: later)
  }
}

fn no_wrapper_retentions() -> FreeMonoid<WrapperRetention> {
  Empty
}

// A lowering that cannot retain, lifted. Safe in one direction only: nothing is discarded.
fn body_lowering_lowered(o: Outcome<Node>) -> Outcome<BodyLowering> {
  match o {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: n, diagnostics: d } => Accepted { value: BodyLowered { node: n }, diagnostics: d }
  }
}

// VALUE POSITION REFUSES A RETENTION. The bottom-up value fold (body_lower_reduce_emitted) reaches
// the declaration producers, and its result is read as a lowered value by the walker, which has no
// channel to carry a retention and whose helpers merge diagnostics with `_`. So a retention reaching
// value position is refused here, at its shell, with the door's own cause.
fn body_lowering_refuse_retained(o: Outcome<BodyLowering>) -> Outcome<Node> {
  match o {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: lowering, diagnostics: d } =>
      match lowering {
        BodyLowered { node: n } => Accepted { value: n, diagnostics: d }
        BodyWrapperRetained { retention: r } =>
          Rejected {
            diagnostics: rejected_with_pending(
              pending: d,
              rejected: diagnostics_singleton(d: wrapper_retention_diagnostic(r: r))
            )
          }
      }
  }
}

// Diagnostics already gathered before a lowering step ride in front of its result, whichever arm it
// takes -- a retention does not discard what was found before it.
fn body_lowering_after_pending(pending: Diagnostics, o: Outcome<BodyLowering>) -> Outcome<BodyLowering> {
  match o {
    Rejected { diagnostics: r } => Rejected { diagnostics: rejected_with_pending(pending: pending, rejected: r) }
    Accepted { value: lowering, diagnostics: d } =>
      Accepted { value: lowering, diagnostics: diagnostics_merge(outer: pending, inner: d) }
  }
}

// One subtree's lowering as a tree: a retained shell stands in the tree AND in its retained list.
fn body_lowered_tree_of(lowering: BodyLowering) -> BodyLoweredTree {
  match lowering {
    BodyLowered { node: n } => BodyLoweredTree { node: n, retained: no_wrapper_retentions() }
    BodyWrapperRetained { retention: r } =>
      BodyLoweredTree { node: r.shell, retained: Cons { head: r, tail: Empty } }
  }
}

// A node rebuilt over its lowered children, carrying every retention they found.
fn body_lowered_tree_over(node: Node, retained: FreeMonoid<WrapperRetention>) -> BodyLoweredTree {
  BodyLoweredTree { node: node, retained: retained }
}

fn body_lowered_tree_retained(t: BodyLoweredTree) -> FreeMonoid<WrapperRetention> {
  t.retained
}

// Continue a tree's node through one more lowering step, keeping every retention already found and
// adding any the step finds. A retained node is not continued (there is no lowered node to continue).
fn body_lowered_tree_then(
  t: BodyLoweredTree,
  f: fn(Node) -> Outcome<BodyLowering>
) -> Outcome<BodyLoweredTree> {
  match f(t.node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: lowering, diagnostics: d } =>
      match lowering {
        BodyLowered { node: n } =>
          Accepted { value: BodyLoweredTree { node: n, retained: t.retained }, diagnostics: d }
        BodyWrapperRetained { retention: r } =>
          Accepted {
            value: BodyLoweredTree {
              node: r.shell,
              retained: wrapper_retentions_concat(earlier: t.retained, later: Cons { head: r, tail: Empty })
            },
            diagnostics: d
          }
      }
  }
}

// The one place a Node leaves a BodyLoweredTree while the tree is only partly built: a step that
// needs the node to decide what to do next (the graft, the sugar key) reads it through here and
// hands the tree back, so the retained list cannot be dropped on the way.
fn body_lowered_tree_map_node(t: BodyLoweredTree, f: fn(Node) -> Outcome<Node>) -> Outcome<BodyLoweredTree> {
  match f(t.node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: n, diagnostics: d } =>
      Accepted { value: BodyLoweredTree { node: n, retained: t.retained }, diagnostics: d }
  }
}

// THE FRONTIER CLASSIFIER is now a read of the variant. It used to scan diagnostic reasons (and
// before that only the head, which failed open behind any pending diagnostic); with retention a
// variant there is no encoding left to misread.
type BodyLoweringFrontierDisposition
  = BodyLoweringLowered
  | BodyLoweringWrapperRetained { retention: WrapperRetention }
  | BodyLoweringRejected { diagnostics: NonEmptyDiagnostics }

fn body_lower_outcome_frontier_disposition(o: Outcome<BodyLowering>) -> BodyLoweringFrontierDisposition {
  match o {
    Rejected { diagnostics: r } => BodyLoweringRejected { diagnostics: r }
    Accepted { value: lowering, diagnostics: _ } =>
      match lowering {
        BodyLowered { node: _ } => BodyLoweringLowered
        BodyWrapperRetained { retention: r } => BodyLoweringWrapperRetained { retention: r }
      }
  }
}

fn body_lower_outcome_is_wrapper_retained(o: Outcome<BodyLowering>) -> Bool {
  match body_lower_outcome_frontier_disposition(o: o) {
    BodyLoweringWrapperRetained { retention: _ } => true
    BodyLoweringLowered => false
    BodyLoweringRejected { diagnostics: _ } => false
  }
}

fn body_lower_seq_child(node: Node, name: Symbol) -> Optional<Node> {
  match find_named_child(root: node, name: name) {
    Accepted { value: child, diagnostics: _ } => Present { value: child }
    Rejected { diagnostics: _ } => Absent
  }
}

fn body_lower_arrow_domain_named_bindings(root: Node) -> List<Symbol> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: Empty, f: fn(acc, e) {
        match e.label {
          Named { name: sym } => Cons { head: sym, tail: acc }
          Positional => acc
        }
      })
    _ => Empty
  }
}

fn body_lower_binding_symbol_lists_match(
  expected: List<Symbol>,
  actual: List<Symbol>
) -> Bool {
  zip_eq(a: expected, b: actual, eq: fn(left, right) { left == right })
}

fn body_lower_param_binding_symbols_from_param_list(param_list: Node) -> List<Symbol> {
  match body_lower_param_list_comma_spine_optional(param_list_captured: param_list) {
    Absent => Empty
    Present { value: comma_spine } =>
      fold(
        body_lower_param_edges(sequence_capture: comma_spine),
        init: Empty,
        f: fn(acc, e) {
          match e.label {
            Named { name: sym } => Cons { head: sym, tail: acc }
            Positional => acc
          }
        }
      )
  }
}

fn body_lower_param_binding_symbols_from_fn_captured(captured: Node) -> List<Symbol> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_param_list) {
    ParseSubtreeFound { captured: param_list } =>
      body_lower_param_binding_symbols_from_param_list(param_list: param_list)
    ParseSubtreeAbsent => Empty
  }
}

fn body_lower_param_binding_symbols_from_fn_decl_module(root: Node) -> List<Symbol> {
  match body_lower_find_captured(root: root, emitted: ^dag_surface_fn_decl) {
    ParseSubtreeFound { captured: captured } =>
      body_lower_param_binding_symbols_from_fn_captured(captured: captured)
    ParseSubtreeAbsent => Empty
  }
}

fn body_lower_arrow_domain_binding_symbols(arrow: Node) -> List<Symbol> {
  match count(arrow.children) >= 1 {
    true =>
      match first(arrow.children) {
        Present { value: domain_edge } =>
          body_lower_arrow_domain_named_bindings(root: domain_edge.target)
        Absent => Empty
      }
    false => Empty
  }
}

fn body_lower_arrow_domain_matches_ingest_param_bindings(
  arrow: Node,
  ingest_bindings: List<Symbol>
) -> Bool {
  body_lower_binding_symbol_lists_match(
    expected: ingest_bindings,
    actual: body_lower_arrow_domain_binding_symbols(arrow: arrow)
  )
}

fn body_lower_frontend_symbol_index_from_module(
  tree: Node,
  record_declarations: FreeMonoid<Symbol>
) -> SymbolIndex {
  symbol_index_fill_module_root(
    index: empty_symbol_index(),
    root: tree,
    record_declarations: record_declarations
  )
}

fn body_lower_arrow_domain_matches_frontend_symbol_index(
  arrow: Node,
  module_tree: Node,
  record_declarations: FreeMonoid<Symbol>,
  fn_name: Symbol
) -> Bool {
  match qualified_name_from_module_node(root: module_tree) {
    Accepted { value: module_qn, diagnostics: _ } =>
      let fn_path = qualified_name_snoc(qn: module_qn, segment: fn_name)
      let idx = body_lower_frontend_symbol_index_from_module(
        tree: module_tree,
        record_declarations: record_declarations
      )
      fold(
        body_lower_arrow_domain_binding_symbols(arrow: arrow),
        init: true,
        f: fn(ok, binding) {
          if ok {
            match symbol_index_lookup(
              index: idx,
              qualified_path: qualified_name_snoc(qn: fn_path, segment: binding)
            ) {
              Present { value: _ } => true
              Absent => false
            }
          } else {
            false
          }
        }
      )
    Rejected { diagnostics: _ } => false
  }
}

fn body_lower_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn body_lower_canonical_type_binding_optional(sym: Symbol) -> Optional<Symbol> {
  if sym == dag_int_type_binding() {
    optional_present(value: sym)
  } else if symbol_lexeme(sym: sym) == "Int" {
    optional_present(value: dag_int_type_binding())
  } else if symbol_lexeme(sym: sym) == "Bool" {
    optional_present(value: ^bool_node_symbol)
  } else {
    optional_absent()
  }
}

fn body_lower_resolved_type_binding(sym: Symbol) -> Symbol {
  match body_lower_canonical_type_binding_optional(sym: sym) {
    Present { value: canonical } => canonical
    Absent => sym
  }
}

// THE SOURCE IS THE AUTHORED TYPE NAME, and it is a parameter rather than an omission. This atom is
// the lowered form of a type the author wrote -- `Bool` in `fn f() -> Bool` -- so it stands at that
// text's position and keeps that text's occurrence. Built synthetic, it was a node an
// `infer_grounding_not_derived` diagnostic anchors on with no occurrence to look up, which is how a
// fatal ends up naming no file at all. Every caller already holds the node it read the symbol from,
// so the source is supplied rather than searched for -- searching the tree for an equal node would
// be the plausible guess DESIGN section 5 forbids.
fn body_lower_type_atom_node(sym: Symbol, source: Node) -> Node {
  node_lowered_from(
    kind: TypeNode { connective: Atom { identity: body_lower_resolved_type_binding(sym: sym) } },
    children: [],
    source: source
  )
}

// THE SOLE MINTER OF WrapperRetention. It emits no diagnostic: the retention IS the result, and the
// refusal is minted from it by whichever reader consumes it (wrapper_retention_diagnostic).
fn body_lower_wrapper_retained_shell(shell: Node) -> Outcome<BodyLowering> {
  Accepted {
    value: BodyWrapperRetained { retention: WrapperRetention { shell: shell } },
    diagnostics: None
  }
}

// THE QUALIFIED-NAME SPINE IS LOWERED SUBSTRATE. body_lower_reduce runs bottom-up, so by the time
// a fn declaration's body is read, a dotted chain in it has already been lowered to the spine
// body_lower_qualified_name_spine_node builds -- a TypeNode Conj under the fold_list labels that no
// grammar production emits. Before this arm the spine was not recognised as lowered, and the
// expression-body readers (body_lower_eq_expr_to_body through body_lower_operand_ref_optional)
// decomposed it to its FIRST ATOM: `fn f() -> Bool = wall.peer.peer_leaf` reached the arrow body
// as the atom `wall`, measured on the normalize route by
// v2.test.claim.body_lowering_qualified_path, while a call through the same chain survived only
// because a Transform already counted as substrate. One shape, one verdict: what the spine
// builder emits, every later reader keeps.
// A CONSTRUCT IS LOWERED SUBSTRATE. The record-literal producer answers a Conj (v2.std.node_query
// construct_node: tag edge, then field edges), and every reducer above it -- the postfix reduce
// first -- must pass it through as it passes an Arrow or a Transform; the first-atom fallback
// they otherwise take would answer the construct's tag and drop its fields, which is exactly how
// `data d: R = R { .. }` reached the graft as the atom R before this arm.
// A LOWERED INT LITERAL IS SUBSTRATE, AND ITS PAYLOAD IS NOT A NAME. body_lower_int_literal_with_magnitude_optional
// produces an Atom(dag_token_int_literal) carrying the integer authority's decimal digit list as
// its magnitude field, and that list is a FreeMonoid cons spine: the same head/tail shape
// qualified_name_spine_shape_present recognizes. Until 2026-09-23 the literal atom was not
// recognized here and its payload was, so a deep search from a `= expr` body (a data initializer,
// or `fn f() -> Int = 606060`) stepped past the literal and returned its digit list as the body,
// which resolve then refused as an unbound qualified name. Recognizing the literal stops every
// search at the literal, before it reaches the payload.
fn body_lower_is_core_substrate(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Arrow } => true
    ComputationNode { behavior: _ } => true
    _ =>
      (match body_lower_int_literal_with_magnitude_optional(node: node) { Present { value: lit } => lit == node  Absent => false })
        || qualified_name_spine_shape_present(root: node)
        || (match construct_tag_optional(n: node) { Present { value: _ } => true  Absent => false })
  }
}

fn body_lower_is_pass_through_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_expr)
    || (emitted == ^dag_surface_binary_expr)
    || (emitted == ^dag_surface_unary_expr)
    || (emitted == ^dag_surface_postfix_expr)
    || (emitted == ^dag_surface_block_expr)
    || (emitted == ^dag_surface_stmt)
    || (emitted == ^dag_surface_stmt_seq)
    || (emitted == ^dag_surface_arg)
}

fn body_lower_is_identity_projection_edge(edge: Edge) -> Bool {
  match edge.label {
    Named { name: n } => n == ^grammar_production_identity_node_projection
    Positional => false
  }
}

// The children are tried in order until one is an operand; a refused child ends the search, because
// a later sibling's reading would stand in for the whole node.
fn body_lower_operand_fold_children_read(node: Node) -> OperandRefRead {
  fold(node.children, init: OperandRefAbsent, f: fn(acc, e) {
    match acc {
      OperandRefAbsent =>
        if body_lower_is_identity_projection_edge(edge: e) {
          OperandRefAbsent
        } else {
          body_lower_operand_ref_read(node: e.target)
        }
      OperandRefLowered { lowered: _ } => acc
      OperandRefRefused { diagnostics: _ } => acc
    }
  })
}

fn body_lower_is_deferred_lower_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_pattern)
    || (emitted == ^dag_surface_match_arm)
    || (emitted == ^dag_surface_match_arm_stmt_body)
}

// A service declaration lowers from its UNFOLDED parse subtree (body_lower_service_decl): its members
// are interface or set-aside facts, never bodies, so folding them first would retain each one.
fn body_lower_is_deferred_lower_at_normalize(emitted: Symbol, under_fn_decl: Bool) -> Bool {
  if emitted == ^dag_surface_service_decl {
    true
  } else if emitted == ^dag_surface_fn_body {
    under_fn_decl
  } else {
    body_lower_is_deferred_lower_emitted(emitted: emitted)
  }
}

fn body_lower_is_metadata_preserved_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_module)
    || (emitted == ^dag_surface_module_header)
    || (emitted == ^dag_surface_import_decl)
    || (emitted == ^dag_surface_alias_decl)
    || (emitted == ^dag_surface_qualified_name)
    || (emitted == ^dag_surface_top_level_item)
    || (emitted == ^dag_surface_generic_params)
    || (emitted == ^dag_surface_param_list)
    || (emitted == ^dag_surface_type_expr)
    || (emitted == ^dag_surface_type_decl)
    || (emitted == ^dag_surface_import_block)
}

// THE SAME SHAPE AS #8828, ONE NODE CLASS OVER: a shell with no body to lower FROM ITS OWN NODE was
// arriving at the unregistered-producer arm, so 'this production has no body-producer yet' and
// 'this production is structure, not a body' were one state. The identities
// body_lower_is_structure_preserved_emitted enumerates are declaration and literal STRUCTURE:
// type syntax with no Behavior to lower to, and expression shells whose children the
// bottom-up fold has already lowered, so preserving the shell preserves a lowered child,
// never an unlowered one. Preserving is what
// body_lower_is_metadata_preserved_emitted already does for the OUTER declarations these sit inside
// (dag_surface_type_decl, dag_surface_data_decl) -- the classification was written per node and the
// fold reaches inside, so every interior of an already-preserved declaration re-entered the
// dispatch and fell to the else arm.
//
// FOLD ORDER IS THE LOAD-BEARING ASSUMPTION FOR dag_surface_field_init, AND FOR THE TWO
// FUNCTION-VALUE SHELLS THAT SIT IN EXPRESSION POSITION (dag_surface_arrow_lambda,
// dag_surface_fn_literal). Those two were arriving at the unregistered-producer arm from a
// data initializer, so a lambda that already lowers as a call argument or fn-body field produced
// wrapper-retention diagnostics only because the DATA declaration's interior re-entered
// dispatch. Preserving the shell after the child fold keeps the production identity later
// consumers (fold_lowering's fn_literal search) still find, and does not emit retention.
// Type syntax is safe by what it IS -- no Behavior to lower to. field_init
// and the function-value shells are safe by WHEN this dispatch reaches them: normalize_node_ctx
// folds children first and passes the FOLDED node to body_lower_finish_for_normalize. There is a
// live path in that same function where dispatch sees an UNFOLDED node -- the deferred arm passes
// `folded: n` and does not fold children -- so adding these identities to
// body_lower_is_deferred_lower_at_normalize, or otherwise dispatching before the child fold, would
// preserve a shell around an UNLOWERED expression. NONE OF THE THREE WITNESSES WOULD CATCH THAT
// for field_init: their field values are the literal 1, which lowers to itself, so the reordered
// and the current fold produce the same tree for exactly those sources. The function-value rows
// would catch it. Stated here rather than covered for field_init, because an assumption named in
// the carrier is worth more than a witness that does not actually cover it.
// RUNG: this is a scope correction to a classifier, not a climb. The retained arm remains the
// counted frontier for a body shape with no producer, and that is the discriminating control: an
// emitted identity in none of these lists still retains, so the arm is not widened into an
// absorbing accept. Next-rung trigger: the preserved/structure classification derived from the
// grammar's own productions (a nonterminal reachable from dag_production_type_decl without crossing
// dag_production_expr is type syntax by construction) rather than enumerated here beside them.

fn body_lower_is_structure_preserved_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_type_variant)
    || (emitted == ^dag_surface_type_alias_rhs)
    || (emitted == ^dag_surface_type_alias_rhs_lead)
    || (emitted == ^dag_surface_field_decl_block)
    || (emitted == ^dag_surface_positional_variant_payload)
    || (emitted == ^dag_surface_admit_callers_clause)
    || (emitted == ^dag_surface_fn_type)
    || (emitted == ^dag_surface_field_init)
    || (emitted == ^dag_surface_where_refinement_clause)
    || (emitted == ^dag_surface_where_predicate)
    || (emitted == ^dag_surface_arrow_lambda)
    || (emitted == ^dag_surface_fn_literal)
}

// A where-clause on a type-variant is a parse-projection sibling of the base
// type-expr. namespace_graft treats every `_node_projection` edge as
// transparent at the module body, so a preserved production shell is unfolded
// and the clause identity is dissolved. Rehome a present clause onto a Named
// edge that is not a projection (the emitted surface symbol) so graft keeps
// the refined Conj and parse_subtree_find still sees the production.
fn body_lower_type_variant_suffix_pair_optional(captured: Node) -> Optional<SugarSequencePair> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => optional_absent()
    Present { value: pair } => sugar_sequence_pair_optional(node: pair.right)
  }
}

fn body_lower_where_skip_token(id: Symbol) -> Bool {
  (id == ^dag_token_kw_where)
    || (id == ^dag_token_lparen)
    || (id == ^dag_token_rparen)
    || (id == ^dag_token_comma)
    || (id == ^dag_token_colon)
}

fn body_lower_where_predicate_ident_optional(node: Node) -> Optional<Symbol> {
  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: node)) {
    Present { value: id } =>
      match body_lower_where_skip_token(id: id) {
        true =>
          fold(node.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lower_where_predicate_ident_optional(node: e.target)
            }
          })
        false => Present { value: id }
      }
    Absent =>
      fold(node.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_where_predicate_ident_optional(node: e.target)
        }
      })
  }
}

fn body_lower_where_predicate_atom(where_clause: Node) -> Node {
  match body_lower_where_predicate_ident_optional(node: where_clause) {
    Present { value: id } =>
      node_with_occurrence_id(
        kind: TypeNode { connective: Atom { identity: id } },
        children: [],
        occurrence_id: where_clause.occurrence_id
      )
    Absent =>
      node_with_occurrence_id(
        kind: TypeNode { connective: Conj },
        children: [],
        occurrence_id: where_clause.occurrence_id
      )
  }
}

// Conj is LabeledEdges: every child must be Named. A parse-shell captured of
// `where brand("...")` is not admitted by well_formed, so the clause is a
// production-shaped Conj whose captured child is a bare predicate Atom.
fn body_lower_kept_where_clause(where_clause: Node) -> Node {
  let production = node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^grammar_production_identity_node_projection },
        target: node_with_occurrence_id(
          kind: TypeNode { connective: Atom { identity: ^dag_surface_where_refinement_clause } },
          children: [],
          occurrence_id: where_clause.occurrence_id
        )
      },
      Edge {
        label: Named { name: ^grammar_production_captured_node_projection },
        target: body_lower_where_predicate_atom(where_clause: where_clause)
      }
    ],
    occurrence_id: where_clause.occurrence_id
  )
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^dag_surface_where_refinement_clause },
        target: production
      }
    ],
    occurrence_id: where_clause.occurrence_id
  )
}

fn body_lower_type_variant_children_with_where(
  base: Node,
  where_clause: Node,
  fields: Node
) -> List<Edge> {
  let with_clause = [
    Edge { label: Named { name: ^dag_surface_type_expr }, target: base },
    Edge {
      label: Named { name: ^dag_surface_where_refinement_clause },
      target: body_lower_kept_where_clause(where_clause: where_clause)
    }
  ]
  if is_empty_conj_root(n: fields) {
    with_clause
  } else {
    list_snoc_item(
      xs: with_clause,
      item: Edge { label: Named { name: ^dag_surface_field_decl_block }, target: fields }
    )
  }
}

// VARIANT AND RECORD FIELDS LOWER HERE, INTO DECLARED FIELD IDENTITIES. The seed's model
// (v1.compiler.core make_field_node; v1.compiler.parse parse_positional_variant_type_fields)
// and its v2 home (v2.std.node_query DeclaredField) agree: a field is a Named edge on the
// payload Conj, the label its identity, the target its type; `Name(T)` is the one Required
// field "0"; a nullary variant is the empty payload Conj. Both spellings lower through the same
// two functions, so the record and positional halves of
// gunbc.rung_drop variant_fields_unlowered_on_the_native_route close together, and a field
// whose declaration cannot be read is a typed, located refusal -- never a residual shell.
fn body_lower_field_decl_edge_optional(item: Node) -> Optional<Edge> {
  let stripped = body_lower_deep_unwrap_optional(node: item)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => Absent
    Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        Absent => Absent
        Present { value: field_name } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => Absent
            Present { value: after_colon } =>
              match body_lower_type_expr_lowered_optional(node: after_colon.right) {
                Absent => Absent
                Present { value: type_node } =>
                  Present { value: Edge { label: Named { name: field_name }, target: type_node } }
              }
          }
      }
  }
}

fn body_lower_payload_node(edges: List<Edge>, source: Node) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: edges,
    occurrence_id: source.occurrence_id
  )
}

// `{ f: T, g: U }` -> Conj { f: T, g: U }. The block's captured is seq(`{`, seq(list, `}`)).
fn body_lower_field_decl_block_payload(block_shell: Node) -> Outcome<Node> {
  let refuse = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: block_shell)
  )
  match parse_production_captured_child_optional(node: block_shell) {
    Absent => refuse
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => refuse
        Present { value: pair } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => refuse
            Present { value: inner } =>
              match body_lower_comma_list_items_optional(list_capture: inner.left) {
                Absent => refuse
                Present { value: items } =>
                  match fold(items, init: Present { value: Empty }, f: fn(acc, item) {
                    match acc {
                      Absent => Absent
                      Present { value: edges } =>
                        match body_lower_field_decl_edge_optional(item: item) {
                          Absent => Absent
                          Present { value: e } => Present { value: list_snoc_item(xs: edges, item: e) }
                        }
                    }
                  }) {
                    Absent => refuse
                    Present { value: edges } =>
                      outcome_accepted(value: body_lower_payload_node(edges: edges, source: block_shell))
                  }
              }
          }
      }
  }
}

// `(T)` -> Conj { 0: T }. The payload's captured is seq(`(`, seq(type_expr, `)`)); arity is one
// by the grammar row itself (dag_grammar_positional_variant_payload_expr), as in the seed.
fn body_lower_positional_payload(payload_shell: Node) -> Outcome<Node> {
  let refuse = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: payload_shell)
  )
  match parse_production_captured_child_optional(node: payload_shell) {
    Absent => refuse
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => refuse
        Present { value: pair } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => refuse
            Present { value: inner } =>
              match body_lower_type_expr_lowered_optional(node: inner.left) {
                Absent => refuse
                Present { value: type_node } =>
                  outcome_accepted(
                    value: body_lower_payload_node(
                      edges: [Edge { label: Named { name: positional_payload_field_name() }, target: type_node }],
                      source: payload_shell
                    )
                  )
              }
          }
      }
  }
}

type VariantPayloadShell
  = VariantPayloadAbsent
  | VariantPayloadShell { shell: Node }
  | VariantPayloadUnrecognized

fn body_lower_variant_payload_shell(suffix: Node) -> VariantPayloadShell {
  let stripped = body_lower_deep_unwrap_optional(node: suffix)
  if is_empty_conj_root(n: stripped) {
    VariantPayloadAbsent
  } else {
    match parse_production_emitted_identity_optional(node: stripped) {
      Present { value: id } =>
        if (id == ^dag_surface_field_decl_block) || (id == ^dag_surface_positional_variant_payload) {
          VariantPayloadShell { shell: stripped }
        } else {
          VariantPayloadUnrecognized
        }
      Absent => VariantPayloadUnrecognized
    }
  }
}

fn body_lower_variant_payload(shell: Node) -> Outcome<Node> {
  match parse_production_emitted_identity_optional(node: shell) {
    Present { value: id } =>
      if id == ^dag_surface_positional_variant_payload {
        body_lower_positional_payload(payload_shell: shell)
      } else {
        body_lower_field_decl_block_payload(block_shell: shell)
      }
    Absent =>
      outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell))
  }
}

// The variant's label is its head type expression, which must be one bare name: a dotted or
// generic head in variant position is not a variant the seed admits either.
fn body_lower_variant_label_optional(head: Node) -> Optional<Symbol> {
  match body_lower_type_atom_from_expr(node: head) {
    Absent => Absent
    Present { value: atom } => node_atom_identity_optional(node: atom)
  }
}

fn body_lower_fielded_type_variant(shell: Node, head: Node, payload_shell: Node) -> Outcome<Node> {
  match body_lower_variant_label_optional(head: head) {
    Absent =>
      outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell))
    Present { value: label } =>
      match body_lower_variant_payload(shell: payload_shell) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: payload, diagnostics: d } =>
          Accepted {
            value: variant_declaration_node(label: label, payload: payload, source: shell),
            diagnostics: d
          }
      }
  }
}

// A variant shell is seq(type_expr, seq(optional(where), optional(payload))). A bare head is left
// as parsed: whether `type T = U` names an alias or a one-variant sum is decided where the
// alternatives are counted (v2.std.compilers.sugar sugar_fold_coproduct_pipe_chain, the seed's
// parse_type_body_after_eq rule), and lowering a bare head here would erase an alias's reference
// to its target. A payload lowers to a declared variant; a where clause beside a payload is a
// spelling the seed's try_where_clause never reaches (it refines the alias arm only), so it
// refuses here rather than carrying the payload unlowered.
fn body_lower_type_variant(shell: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => outcome_accepted(value: shell)
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => outcome_accepted(value: shell)
        Present { value: pair } =>
          match body_lower_type_variant_suffix_pair_optional(captured: captured) {
            Absent => outcome_accepted(value: shell)
            Present { value: suffixes } =>
              match body_lower_variant_payload_shell(suffix: suffixes.right) {
                VariantPayloadShell { shell: payload_shell } =>
                  if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: suffixes.left)) {
                    body_lower_fielded_type_variant(shell: shell, head: pair.left, payload_shell: payload_shell)
                  } else {
                    outcome_rejected(
                      d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell)
                    )
                  }
                VariantPayloadUnrecognized =>
                  outcome_rejected(
                    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell)
                  )
                VariantPayloadAbsent =>
                  match parse_production_emitted_identity_optional(node: suffixes.left) {
                    Absent => outcome_accepted(value: shell)
                    Present { value: suffix_id } =>
                      if suffix_id == ^dag_surface_where_refinement_clause {
                        outcome_accepted(
                          value: node_with_occurrence_id(
                            kind: TypeNode { connective: Conj },
                            children: body_lower_type_variant_children_with_where(
                              base: pair.left,
                              where_clause: suffixes.left,
                              fields: suffixes.right
                            ),
                            occurrence_id: shell.occurrence_id
                          )
                        )
                      } else {
                        outcome_accepted(value: shell)
                      }
                  }
              }
          }
      }
  }
}

fn body_lower_param_ref_atom(source: Node, identity: Symbol) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: source.occurrence_id
  )
}

fn body_lower_find_captured_prunable(id: Symbol) -> Bool {
  (id == ^dag_surface_module_header)
    || (id == ^dag_surface_qualified_name)
    || (id == ^dag_surface_type_expr)
}

fn body_lower_find_captured_under_children(root: Node, emitted: Symbol) -> ParseSubtreeFind {
  fold(root.children, init: ParseSubtreeAbsent, f: fn(acc, edge) {
    match acc {
      ParseSubtreeFound { captured: _ } => acc
      ParseSubtreeAbsent => body_lower_find_captured(root: edge.target, emitted: emitted)
    }
  })
}

fn body_lower_find_captured(root: Node, emitted: Symbol) -> ParseSubtreeFind {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      if id == emitted {
        match parse_production_captured_child_optional(node: root) {
          Present { value: captured } => ParseSubtreeFound { captured: captured }
          Absent => body_lower_find_captured_under_children(root: root, emitted: emitted)
        }
      } else if body_lower_find_captured_prunable(id: id) {
        ParseSubtreeAbsent
      } else {
        body_lower_find_captured_under_children(root: root, emitted: emitted)
      }
    Absent => body_lower_find_captured_under_children(root: root, emitted: emitted)
  }
}

fn body_lower_find_production_shell_under_children(
  root: Node,
  emitted: Symbol
) -> Optional<Node> {
  fold(root.children, init: Absent, f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => body_lower_find_production_shell_optional(root: edge.target, emitted: emitted)
    }
  })
}

fn body_lower_find_production_shell_optional(root: Node, emitted: Symbol) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      match id == emitted {
        true => Present { value: root }
        false =>
          match body_lower_find_captured_prunable(id: id) {
            true => Absent
            false => body_lower_find_production_shell_under_children(root: root, emitted: emitted)
          }
      }
    Absent =>
      body_lower_find_production_shell_under_children(root: root, emitted: emitted)
  }
}

fn body_lower_int_literal_with_magnitude_optional(node: Node) -> Optional<Node> {
  let unwrapped = body_lower_deep_unwrap_for_int_literal(node: node)
  if dag_node_is_int_literal_atom(node: unwrapped) {
    match dag_int_literal_magnitude_node_optional(node: unwrapped) {
      Present { value: _ } => optional_present(value: unwrapped)
      Absent => optional_absent()
    }
  } else {
    optional_absent()
  }
}

// A refused operand is the shell's refusal: only a shell this reader does not recognise at all falls
// to the int-literal reading.
fn body_lower_operand_from_shell_read(shell: Node) -> OperandRefRead {
  let captured = match parse_production_captured_child_optional(node: shell) {
    Present { value: inner } => inner
    Absent => shell
  }
  match body_lower_operand_or_atom_read(captured: captured) {
    OperandRefAbsent =>
      body_lower_operand_ref_read_of(found: body_lower_int_literal_with_magnitude_optional(node: captured))
    OperandRefLowered { lowered: lowered } => OperandRefLowered { lowered: lowered }
    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
  }
}

fn body_lower_operand_from_shell_optional(shell: Node) -> Optional<Node> {
  body_lower_operand_ref_read_optional(read: body_lower_operand_from_shell_read(shell: shell))
}

// A SEQUENCE WITH A NON-EMPTY RIGHT IS NEVER NARROWED TO ITS LEFT ELEMENT. When pair.right is the
// empty conj the sequence is one element and its left IS the operand; otherwise the sequence is an
// operator expression, read whole by body_lower_read_operator_expression, or it is not an operand
// this reader recognises. The arm this replaces returned pair.left for every sequence, so `a && b`
// read as `a` and `!a` read as `!` (gunbc.recurring_failure_mode
// lowering_accessor_collapses_a_sequence_operand). An operator expression the tower reader refuses is
// a refusal here too, carrying the tower reader's cause at its position.
fn body_lower_operand_ref_sequence_read(node: Node) -> OperandRefRead {
  match body_lower_read_operator_expression(node: node) {
    OperatorExpressionRead { lowered: lowered } => OperandRefLowered { lowered: lowered }
    OperatorExpressionRefused { diagnostics: d } => OperandRefRefused { diagnostics: d }
    OperatorExpressionAbsent => OperandRefAbsent
  }
}

// AN OPERAND READ HAS THREE ANSWERS, AND THE ACCESSOR USED TO HAVE TWO. It is the operand whole
// (OperandRefLowered), a located refusal (OperandRefRefused -- an operator expression under it was
// read and a position under that operator was not), or not an operand this reader recognises
// (OperandRefAbsent). As an Optional the middle answer read as the third, so a caller that asked what
// a value IS and heard Absent went on to a first-match fallback: the let-value route answered
// `let x = b && (u)` with the first atom `b`, and `u` reached no reference site. A refusal is carried
// up through every recursion below and never replaced by a sibling's or a part's reading.
type OperandRefRead
  = OperandRefAbsent
  | OperandRefLowered { lowered: Node }
  | OperandRefRefused { diagnostics: NonEmptyDiagnostics }

fn body_lower_operand_ref_read_of(found: Optional<Node>) -> OperandRefRead {
  match found {
    Present { value: lowered } => OperandRefLowered { lowered: lowered }
    Absent => OperandRefAbsent
  }
}

// THE PROJECTION FOR CALLERS THAT ASK ONLY WHETHER A NODE IS AN OPERAND and try another reader when it
// is not. It forgets a refusal, so a caller whose fallback could stand a proper part in for the whole
// reads the OperandRefRead instead.
fn body_lower_operand_ref_read_optional(read: OperandRefRead) -> Optional<Node> {
  match read {
    OperandRefLowered { lowered: lowered } => optional_present(value: lowered)
    _ => optional_absent()
  }
}

fn body_lower_operand_ref_optional(node: Node) -> Optional<Node> {
  body_lower_operand_ref_read_optional(read: body_lower_operand_ref_read(node: node))
}

// An int literal is an atom with a magnitude child, and it is not a binding: the operand reader
// reads it whole before the branded-atom arm rebuilds an atom with no children -- which is what
// happened to every literal argument (`f(1)` carried a bare dag_token_int_literal) until that
// arm was ordered first.
fn body_lower_operand_ref_read(node: Node) -> OperandRefRead {
  match body_lower_is_core_substrate(node: node) {
    true => OperandRefLowered { lowered: node }
    false =>
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: _emitted } =>
      match parse_production_captured_child_optional(node: node) {
        Present { value: captured } =>
          match body_lower_operand_ref_read(node: captured) {
            OperandRefAbsent => body_lower_operand_fold_children_read(node: node)
            OperandRefLowered { lowered: lowered } => OperandRefLowered { lowered: lowered }
            OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
          }
        Absent => body_lower_operand_fold_children_read(node: node)
      }
    Absent =>
      match dag_node_is_int_literal_atom(node: node) {
        true => body_lower_operand_ref_read_of(found: body_lower_int_literal_with_magnitude_optional(node: node))
        false =>
      match dag_binding_branded_atom_identity(node: node) {
        Present { value: binding } =>
          OperandRefLowered { lowered: body_lower_param_ref_atom(source: node, identity: binding) }
        Absent =>
          match node_atom_identity_optional(node: node) {
            Present { value: id } =>
              if dag_lex_token_symbol(sym: id) {
                if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                  OperandRefLowered { lowered: body_lower_param_ref_atom(source: node, identity: id) }
                } else {
                  body_lower_operand_ref_read_of(found: body_lower_int_literal_with_magnitude_optional(node: node))
                }
              } else {
                OperandRefLowered { lowered: body_lower_param_ref_atom(source: node, identity: id) }
              }
            Absent =>
              match sugar_sequence_pair_optional(node: node) {
                Present { value: pair } =>
                  match body_lower_cast_chain_read(node: node) {
                    OperandRefLowered { lowered: cast } => OperandRefLowered { lowered: cast }
                    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
                    OperandRefAbsent =>
                  match body_lower_dotted_reference_optional(node: node) {
                    Present { value: spine } => OperandRefLowered { lowered: spine }
                    Absent =>
                      if is_empty_conj_root(n: pair.right) {
                        body_lower_operand_ref_read(node: pair.left)
                      } else {
                        match body_lower_paren_group_inner_optional(node: node) {
                          Present { value: inner } => body_lower_operand_ref_read(node: inner)
                          Absent => body_lower_operand_ref_sequence_read(node: node)
                        }
                      }
                  }
                  }
                Absent =>
                  match parse_production_captured_child_optional(node: node) {
                    Present { value: captured } =>
                      body_lower_operand_ref_read(node: captured)
                    Absent => body_lower_operand_fold_children_read(node: node)
                  }
              }
          }
      }
  }
  }
  }
}

fn body_lower_is_block_delimiter_token(id: Symbol) -> Bool {
  (id == ^dag_token_lbrace) || (id == ^dag_token_rbrace)
}

fn body_lower_sequence_left_is_lbrace(captured: Node) -> Bool {
  match sugar_sequence_pair_optional(
    node: body_lower_unwrap_surface_shell(node: captured)
  ) {
    Absent => false
    Present { value: pair } =>
      match node_atom_identity_optional(
        node: body_lower_deep_unwrap_optional(node: pair.left)
      ) {
        Present { value: id } => id == ^dag_token_lbrace
        Absent => false
      }
  }
}

// THE DOT IS NOT AN OPERATOR, AND READING IT AS ONE WAS THE EARLIEST UNJUSTIFIED BOUNDARY OF THE
// CROSS-MODULE REFERENCE CLASS (DESIGN section 6b). The grammar owns the dot as
// dag_grammar_postfix_dot_suffix_expr, one suffix of a postfix chain, and never as an infix
// production. This reader accepted ANY lex token as a binary operator, so `v2.test.p.value` lowered
// to Transform(dot, v2, test) with every later segment DROPPED -- a fabricated plausible body
// (DESIGN section 5) that no consumer reads and that the resolver refuses as an unbound `v2`.
// Measured on the production route (v2.test.claim.namespace_xl0.call_argument_mention_survival) before
// this arm existed. A dotted chain is lowered by body_lower_dotted_reference_optional below. The
// block delimiters are excluded for the sibling reason (gunbc#11595): a brace is a body boundary,
// not an operator, and reading it as one dropped the call inside a brace-bodied fn.
fn body_lower_operator_atom_optional(node: Node) -> Optional<Node> {
  match node_atom_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_token_dot {
        optional_absent()
      } else if dag_lex_token_symbol(sym: id) && !body_lower_is_block_delimiter_token(id: id) {
        optional_present(
          value: node_lowered_from(
            kind: TypeNode { connective: Atom { identity: id } },
            children: [],
            source: node
          )
        )
      } else {
        optional_absent()
      }
    Absent => Absent
  }
}

fn body_lower_unwrap_captured(shell: Node) -> Optional<Node> {
  parse_production_captured_child_optional(node: shell)
}

// AN OPERATOR EXPRESSION IS READ OFF THE GRAMMAR'S OWN PRECEDENCE TOWER, WHOLE, AND A POSITION THE
// READER CANNOT READ REFUSES.
//
// v2.extdeps.languages.dag dag_grammar_binary_expr_expr is a tower of seven levels, each
//   level = sequence(next_level, tail)
// whose tail is a REPEAT of sequence(operator, next_level) for the pipe, or, and, additive and
// multiplicative levels and an OPTIONAL of the same for equality and comparison. The parse captures
// a repeat as a cons spine -- sequence(element, rest), ending in the empty conj -- and an optional
// as its element or the empty conj, so a tail is exactly one of
//   the empty conj                              (no operator at this level)
//   sequence(operator, operand)                 (an optional that matched)
//   sequence(sequence(operator, operand), rest) (a repeat element and the rest of the repeat)
// and the bottom of the tower is dag_grammar_unary_expr_expr: a prefix `!` or `-` over another
// unary, or a postfix expression.
//
// THE READER IT REPLACES READ ONE OPERATOR AND DROPPED THE REST, SILENTLY. It lowered the first
// sequence(operator, operand) it found and returned, so `a && b && c` lowered to `a && b` with `c`
// gone; its operand reader, body_lower_operand_ref_optional, narrowed any other sequence to its
// LEFT element, so `!a && b` lost `a` (read as the bare `!`) and, in a body the bottom-up fold had
// not lowered, `a && b` became `a`. Measured on the real tokenize -> parse -> normalize route: an
// atom only on the right of those shapes reached no reference site
// (gunbc.recurring_failure_mode lowering_accessor_collapses_a_sequence_operand). Every operand is
// now lowered and folded left-associatively, and an unreadable position is a located refusal.
type OperatorExpressionRead
  = OperatorExpressionAbsent
  | OperatorExpressionRead { lowered: Node }
  | OperatorExpressionRefused { diagnostics: NonEmptyDiagnostics }

// THE OPERATOR SETS ARE READ OFF THE GRAMMAR, NOT LISTED BESIDE IT. Every terminal of
// dag_grammar_binary_expr_expr is an operator -- its nonterminals are the unary operands -- and every
// terminal of dag_grammar_unary_expr_expr is a prefix operator, so collecting the terminals of those
// two expressions IS the operator set. An operator the grammar gains is recognised here with no edit;
// a hand-copied list would have answered OperatorExpressionAbsent for it and let the expression fall
// to the other lowering routes (review 70545).
fn body_lower_grammar_terminals(expr: GrammarExpr) -> List<Symbol> {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, _stamp) { [token_class] },
      literal_terminal: fn(token_class, _lexeme) { [token_class] },
      nonterminal: fn(_production) { Empty },
      sequence: fn(l, r) { list_append(left: l, right: r) },
      choice: fn(l, r) { list_append(left: l, right: r) },
      optional: fn(e) { e },
      repeat: fn(e) { e }
    }
  )
}

// Nullary, pure and reifying to symbols, so both sets are enrolled WARM in
// v2.workflow.floor_pure_producer_share: building the grammar expressions per claim frame cost
// ~11.4k eval steps and pushed v2.test.manual.body_lowering_normalize_add over the new-witness
// budget on this PR's first floor run.
fn body_lower_binary_operator_tokens() -> List<Symbol> {
  body_lower_grammar_terminals(expr: dag_grammar_binary_expr_expr())
}

fn body_lower_prefix_operator_tokens() -> List<Symbol> {
  body_lower_grammar_terminals(expr: dag_grammar_unary_expr_expr())
}

// Read once per frame through these rows; the floor serves the producers above from its warm tier.
data body_lower_binary_operators: List<Symbol> = body_lower_binary_operator_tokens()

data body_lower_prefix_operators: List<Symbol> = body_lower_prefix_operator_tokens()

fn body_lower_symbol_listed(id: Symbol, xs: List<Symbol>) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, x) { acc || (x == id) })
}

fn body_lower_is_binary_operator_token(id: Symbol) -> Bool {
  body_lower_symbol_listed(id: id, xs: body_lower_binary_operators)
}

fn body_lower_is_prefix_operator_token(id: Symbol) -> Bool {
  body_lower_symbol_listed(id: id, xs: body_lower_prefix_operators)
}

fn body_lower_operator_token_optional(node: Node, binary: Bool) -> Optional<Node> {
  match node_atom_identity_optional(node: node) {
    Present { value: id } =>
      if (binary && body_lower_is_binary_operator_token(id: id))
        || (!binary && body_lower_is_prefix_operator_token(id: id)) {
        optional_present(value: node_synthetic(kind: TypeNode { connective: Atom { identity: id } }, children: []))
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

// A tower level with no operator is sequence(next_level, empty): the level is its next level.
fn body_lower_strip_operator_free_levels(node: Node) -> Node {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Present { value: pair } =>
      if is_empty_conj_root(n: pair.right) {
        body_lower_strip_operator_free_levels(node: pair.left)
      } else {
        stripped
      }
    Absent => stripped
  }
}

// Whether a tail carries an operator: its first element is one, or is sequence(operator, operand).
fn body_lower_tail_has_binary_operator(tail: Node) -> Bool {
  match sugar_sequence_pair_optional(node: tail) {
    Absent => false
    Present { value: pair } =>
      match body_lower_operator_token_optional(node: pair.left, binary: true) {
        Present { value: _ } => true
        Absent =>
          match sugar_sequence_pair_optional(node: pair.left) {
            Present { value: element } =>
              match body_lower_operator_token_optional(node: element.left, binary: true) {
                Present { value: _ } => true
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn body_lower_operator_refusal(reason: Symbol, at: Node) -> OperatorExpressionRead {
  OperatorExpressionRefused { diagnostics: diagnostics_singleton(d: body_lower_diagnostic(reason: reason, n: at)) }
}

// One operand of an operator expression, lowered whole or refused at the operand.
fn body_lower_operator_operand(node: Node) -> Outcome<Node> {
  let operand = body_lower_strip_operator_free_levels(node: node)
  match body_lower_read_operator_expression(node: operand) {
    OperatorExpressionRead { lowered: lowered } => outcome_accepted(value: lowered)
    OperatorExpressionRefused { diagnostics: r } => Rejected { diagnostics: r }
    OperatorExpressionAbsent =>
      if body_lower_is_core_substrate(node: operand) {
        outcome_accepted(value: operand)
      } else {
        match body_lower_try_body_lowered(node: operand) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: Present { value: lowered }, diagnostics: d } =>
            outcome_with_diagnostics(value: lowered, diagnostics: d)
          Accepted { value: Absent, diagnostics: _ } =>
            match body_lower_operand_ref_optional(node: operand) {
              Present { value: lowered } => outcome_accepted(value: lowered)
              Absent =>
                outcome_rejected(
                  d: body_lower_diagnostic(reason: ^body_lowering_reason_operator_operand_unread, n: operand)
                )
            }
        }
      }
  }
}

fn body_lower_fold_operator_tail(acc: Node, tail: Node) -> OperatorExpressionRead {
  if is_empty_conj_root(n: tail) {
    OperatorExpressionRead { lowered: acc }
  } else {
    match sugar_sequence_pair_optional(node: tail) {
      Absent => body_lower_operator_refusal(reason: ^body_lowering_reason_operator_tail_unread, at: tail)
      Present { value: pair } =>
        match body_lower_operator_token_optional(node: pair.left, binary: true) {
          Present { value: operator } =>
            match body_lower_operator_operand(node: pair.right) {
              Rejected { diagnostics: r } => OperatorExpressionRefused { diagnostics: r }
              Accepted { value: right, diagnostics: _ } =>
                OperatorExpressionRead { lowered: lower_binary_infix(left: acc, operator: operator, right: right) }
            }
          Absent =>
            match sugar_sequence_pair_optional(node: pair.left) {
              Absent => body_lower_operator_refusal(reason: ^body_lowering_reason_operator_tail_unread, at: tail)
              Present { value: element } =>
                match body_lower_operator_token_optional(node: element.left, binary: true) {
                  Absent => body_lower_operator_refusal(reason: ^body_lowering_reason_operator_tail_unread, at: tail)
                  Present { value: operator } =>
                    match body_lower_operator_operand(node: element.right) {
                      Rejected { diagnostics: r } => OperatorExpressionRefused { diagnostics: r }
                      Accepted { value: right, diagnostics: _ } =>
                        body_lower_fold_operator_tail(
                          acc: lower_binary_infix(left: acc, operator: operator, right: right),
                          tail: pair.right
                        )
                    }
                }
            }
        }
    }
  }
}

// Absent: this node is not an operator expression -- no prefix operator heads it and no operator
// sits in its tower tail. Read: every operand lowered. Refused: an operator was read and a position
// under it was not.
fn body_lower_read_operator_expression(node: Node) -> OperatorExpressionRead {
  let stripped = body_lower_strip_operator_free_levels(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => OperatorExpressionAbsent
    Present { value: pair } =>
      match body_lower_operator_token_optional(node: pair.left, binary: false) {
        Present { value: operator } =>
          match body_lower_operator_operand(node: pair.right) {
            Rejected { diagnostics: r } => OperatorExpressionRefused { diagnostics: r }
            Accepted { value: operand, diagnostics: _ } =>
              OperatorExpressionRead { lowered: lower_unary_prefix(operator: operator, operand: operand) }
          }
        Absent =>
          if body_lower_tail_has_binary_operator(tail: pair.right) {
            match body_lower_operator_operand(node: pair.left) {
              Rejected { diagnostics: r } => OperatorExpressionRefused { diagnostics: r }
              Accepted { value: left, diagnostics: _ } =>
                body_lower_fold_operator_tail(acc: left, tail: pair.right)
            }
          } else {
            OperatorExpressionAbsent
          }
      }
  }
}

fn body_lower_try_infix_transform(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_read_operator_expression(node: node) {
    OperatorExpressionAbsent => outcome_accepted(value: optional_absent())
    OperatorExpressionRead { lowered: lowered } => outcome_accepted(value: optional_present(value: lowered))
    OperatorExpressionRefused { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn body_lower_try_fold_loop_search(node: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_primary_expr {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_try_fold_loop(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: id) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_try_fold_loop(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent =>
      fold(node.children, init: outcome_accepted(value: optional_absent()), f: fn(acc, e) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: found, diagnostics: carried } =>
            match found {
              Present { value: _ } => acc
              Absent =>
                match body_lower_try_fold_loop(node: e.target) {
                  Rejected { diagnostics: r } =>
                    Rejected { diagnostics: rejected_with_pending(pending: carried, rejected: r) }
                  Accepted { value: next, diagnostics: nd } =>
                    outcome_with_diagnostics(
                      value: next,
                      diagnostics: diagnostics_merge(outer: carried, inner: nd)
                    )
                }
            }
        }
      })
  }
}

// FoldCallStepFormUnresolved is a COUNTED FRONTIER STATE HERE, not a refusal,
// and this is the one place in the corpus that reads it that way. The stage
// cannot resolve the callee (see fold_call_lowering's note), so it cannot know
// whether a fold-family call with no fn literal is malformed or merely carries
// its step by name. It therefore reports "no loop produced" with the typed,
// located diagnostic attached rather than refusing on a judgement it has not
// earned -- and produces no Loop, exactly as the refusal did. A retained shell
// that is genuinely broken still meets normalize's recursive well_formed gate,
// which #6520 established as the sole structural wall and which is untouched.
// FoldCallStepShapeInvalid stays a refusal: there the fn literal is in hand.
fn body_lower_try_fold_loop(node: Node) -> Outcome<Optional<Node>> {
  match fold_call_head_symbol(fold_call: node) {
    Present { value: head } =>
      if fold_family_head(sym: head) {
        match fold_call_lowering(fold_call: node) {
          FoldCallLowered { seam_loop: loop_node } =>
            outcome_accepted(value: optional_present(value: loop_node))
          FoldCallStepFormUnresolved { diagnostic: d } =>
            outcome_with_diagnostics(
              value: optional_absent(),
              diagnostics: Some { diagnostics: diagnostics_singleton(d: d) }
            )
          FoldCallNotAFold { diagnostic: d } => outcome_rejected(d: d)
          FoldCallStepShapeInvalid { diagnostic: d } => outcome_rejected(d: d)
        }
      } else {
        body_lower_try_fold_loop_search(node: node)
      }
    Absent => body_lower_try_fold_loop_search(node: node)
  }
}

fn body_lower_type_atom_from_expr(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_type_expr {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_type_atom_from_expr(node: captured)
          Absent => optional_absent()
        }
      } else if id == ^dag_surface_qualified_name {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } =>
            match node_atom_identity_optional(node: captured) {
              Present { value: sym } =>
                optional_present(value: body_lower_type_atom_node(sym: sym, source: captured))
              Absent =>
                match body_lower_qualified_name_production_spine_optional(node: node, captured: captured) {
                  Present { value: spine } => Present { value: spine }
                  Absent => body_lower_type_atom_from_expr(node: captured)
                }
            }
          Absent => optional_absent()
        }
      } else {
        Absent
      }
    Absent =>
      match dag_binding_branded_atom_identity(node: node) {
        Present { value: binding } =>
          Present { value: body_lower_type_atom_node(sym: binding, source: node) }
        Absent =>
          match node_atom_identity_optional(node: node) {
            Present { value: sym } =>
              if dag_lex_token_symbol(sym: sym) {
                optional_absent()
              } else {
                optional_present(value: body_lower_type_atom_node(sym: sym, source: node))
              }
            Absent =>
              match sugar_sequence_pair_optional(node: node) {
                Present { value: pair } =>
                  match body_lower_type_atom_from_expr(node: pair.left) {
                    Present { value: found } => Present { value: found }
                    Absent => body_lower_type_atom_from_expr(node: pair.right)
                  }
                Absent =>
                  fold(node.children, init: Absent, f: fn(acc, e) {
                    match acc {
                      Present { value: _ } => acc
                      Absent => body_lower_type_atom_from_expr(node: e.target)
                    }
                  })
              }
          }
      }
  }
}

fn body_lower_unwrap_surface_shell(node: Node) -> Node {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if body_lower_is_pass_through_emitted(emitted: emitted) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_unwrap_surface_shell(node: captured)
          Absent => node
        }
      } else {
        node
      }
    Absent => node
  }
}

fn body_lower_after_comma_tail_optional(node: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: node) {
    Absent => optional_absent()
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Present { value: id } =>
          if id == ^dag_token_comma {
            optional_present(value: pair.right)
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

fn body_lower_typed_param_from_comma_seq(sequence_capture: Node) -> Optional<Edge> {
  match sugar_sequence_pair_optional(node: sequence_capture) {
    Present { value: pair } =>
      match body_lower_typed_param_edge(param_capture: pair.right) {
        Present { value: edge } => Present { value: edge }
        Absent => body_lower_typed_param_edge(param_capture: pair.left)
      }
    Absent => body_lower_typed_param_edge(param_capture: sequence_capture)
  }
}

fn body_lower_collect_param_edges_from_repeat_tail(repeat_capture: Node) -> List<Edge> {
  if is_empty_conj_root(n: repeat_capture) {
    Empty
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: head_sequence, diagnostics: _ } =>
        match body_lower_typed_param_from_comma_seq(sequence_capture: head_sequence) {
          Present { value: edge } =>
            match find_named_child(
              root: repeat_capture,
              name: ^grammar_sequence_right_node_projection
            ) {
              Accepted { value: tail, diagnostics: _ } =>
                list_append(
                  left: [edge],
                  right: body_lower_collect_param_edges_from_repeat_tail(repeat_capture: tail)
                )
              Rejected { diagnostics: _ } => [edge]
            }
          Absent =>
            match find_named_child(
              root: repeat_capture,
              name: ^grammar_sequence_right_node_projection
            ) {
              Accepted { value: tail, diagnostics: _ } =>
                body_lower_collect_param_edges_from_repeat_tail(repeat_capture: tail)
              Rejected { diagnostics: _ } => Empty
            }
        }
      Rejected { diagnostics: _ } => Empty
    }
  }
}

fn body_lower_collect_param_edges(sequence_capture: Node) -> List<Edge> {
  match find_named_child(root: sequence_capture, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: first, diagnostics: _ } =>
      let first_edges = match body_lower_typed_param_edge(param_capture: first) {
        Present { value: edge } => [edge]
        Absent => Empty
      }
      match find_named_child(root: sequence_capture, name: ^grammar_sequence_right_node_projection) {
        Accepted { value: outer_right, diagnostics: _ } =>
          match find_named_child(root: outer_right, name: ^grammar_sequence_left_node_projection) {
            Accepted { value: repeat_capture, diagnostics: _ } =>
              list_append(
                left: first_edges,
                right: body_lower_collect_param_edges_from_repeat_tail(
                  repeat_capture: repeat_capture
                )
              )
            Rejected { diagnostics: _ } => first_edges
          }
        Rejected { diagnostics: _ } => first_edges
      }
    Rejected { diagnostics: _ } =>
      match body_lower_typed_param_edge(param_capture: sequence_capture) {
        Present { value: edge } => [edge]
        Absent =>
          match sugar_sequence_pair_optional(node: sequence_capture) {
            Absent => Empty
            Present { value: pair } =>
              match body_lower_typed_param_edge(param_capture: pair.left) {
                Present { value: edge } =>
                  match body_lower_after_comma_tail_optional(node: pair.right) {
                    Present { value: tail } =>
                      list_append(
                        left: [edge],
                        right: body_lower_collect_param_edges(sequence_capture: tail)
                      )
                    Absent => [edge]
                  }
                Absent =>
                  match body_lower_after_comma_tail_optional(node: pair.right) {
                    Present { value: tail } => body_lower_collect_param_edges(sequence_capture: tail)
                    Absent => Empty
                  }
              }
          }
      }
  }
}

// A PARAMETER LIST'S EDGES, WITH EVERY ANONYMOUS SLOT MINTED. The raw collector below recurses over
// the comma spine and cannot know a slot's position; the mint needs the whole list, so it runs once
// here, and both the domain (body_lower_domain_from_param_list) and the ingest-side binding list the
// domain is checked against (body_lower_param_binding_symbols_from_param_list) read through it.
fn body_lower_param_edges(sequence_capture: Node) -> List<Edge> {
  anonymous_binder_mint_domain(edges: body_lower_collect_param_edges(sequence_capture: sequence_capture))
}

fn body_lower_param_binding_optional(node: Node) -> Optional<Symbol> {
  match dag_binding_branded_atom_identity(node: node) {
    Present { value: binding } => Present { value: binding }
    Absent =>
      match node_atom_identity_optional(node: node) {
        Present { value: sym } =>
          if dag_lex_token_symbol(sym: sym) {
            optional_absent()
          } else {
            optional_present(value: sym)
          }
        Absent =>
          match body_lower_operand_ref_optional(node: node) {
            Present { value: ref_node } =>
              match node_atom_identity_optional(node: ref_node) {
                Present { value: sym } => optional_present(value: sym)
                Absent => optional_absent()
              }
            Absent => optional_absent()
          }
      }
  }
}

fn body_lower_typed_param_edge(param_capture: Node) -> Optional<Edge> {
  match sugar_sequence_pair_optional(node: param_capture) {
    Absent => Absent
    Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        Absent => Absent
        Present { value: binding } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => Absent
            Present { value: after_colon } =>
              match body_lower_type_expr_lowered_optional(node: after_colon.right) {
                Absent => Absent
                Present { value: type_node } =>
                  Present {
                    value: Edge {
                      label: Named { name: binding },
                      target: type_node
                    }
                  }
              }
          }
      }
  }
}

fn body_lower_deep_unwrap_optional(node: Node) -> Node {
  match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    Accepted { value: child, diagnostics: _ } =>
      body_lower_deep_unwrap_optional(node: child)
    Rejected { diagnostics: _ } => node
  }
}

fn body_lower_deep_unwrap_for_int_literal(node: Node) -> Node {
  match parse_production_captured_child_optional(node: node) {
    Present { value: captured } =>
      body_lower_deep_unwrap_for_int_literal(node: captured)
    Absent => body_lower_deep_unwrap_optional(node: node)
  }
}

fn body_lower_unwrap_optional_element(node: Node) -> Node {
  match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    Accepted { value: child, diagnostics: _ } => child
    Rejected { diagnostics: _ } => node
  }
}



// THE WHOLE TYPE EXPRESSION, NOT ITS HEAD ATOM. dag_grammar_qualified_type_expr is
// seq(seq(qualified_name, optional(`<` type_list `>`)), optional(`?`)). The head lowers as
// before (a binding atom or a qualified-name spine); a generic application becomes the
// Instantiation connective with the head as its first positional child and each argument
// after it (the shape v2.std.compilers.target_model reads the head from, index 0); a trailing
// `?` wraps the result in the Cardinality connective, v2's authority for an optional field
// (v2.std.node_query DeclaredField.cardinality, decoded once at declared_field_cardinality_of_target). Before this reader a param or field typed
// `List<Int>` or `Int?` lowered to the bare head atom, silently.
fn body_lower_type_generic_args_optional(generic_capture: Node) -> Optional<List<Node>> {
  let stripped = body_lower_deep_unwrap_optional(node: generic_capture)
  if is_empty_conj_root(n: stripped) {
    optional_present(value: Empty)
  } else {
    match sugar_sequence_pair_optional(node: stripped) {
      Absent => Absent
      Present { value: pair } =>
        match node_atom_identity_optional(node: pair.left) {
          Present { value: lt } =>
            if lt == ^dag_token_lt {
              match sugar_sequence_pair_optional(node: pair.right) {
                Absent => Absent
                Present { value: inner } =>
                  match body_lower_comma_list_items_optional(list_capture: inner.left) {
                    Absent => Absent
                    Present { value: items } =>
                      fold(items, init: Present { value: Empty }, f: fn(acc, item) {
                        match acc {
                          Absent => Absent
                          Present { value: args } =>
                            match body_lower_type_expr_lowered_optional(node: item) {
                              Absent => Absent
                              Present { value: arg } => Present { value: list_snoc_item(xs: args, item: arg) }
                            }
                        }
                      })
                  }
              }
            } else {
              Absent
            }
          Absent => Absent
        }
    }
  }
}

fn body_lower_type_wrap_instantiation(head: Node, args: List<Node>, source: Node) -> Node {
  if count(args) == 0 {
    head
  } else {
    node_with_occurrence_id(
      kind: TypeNode { connective: Instantiation },
      children: fold(
        list_append(left: [head], right: args),
        init: Empty,
        f: fn(acc, t) { list_snoc_item(xs: acc, item: Edge { label: Positional, target: t }) }
      ),
      occurrence_id: source.occurrence_id
    )
  }
}

fn body_lower_type_wrap_cardinality(base: Node, question_capture: Node, source: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: question_capture)
  if is_empty_conj_root(n: stripped) {
    optional_present(value: base)
  } else {
    match node_atom_identity_optional(node: stripped) {
      Present { value: q } =>
        match q == ^dag_token_question {
          true =>
            optional_present(
              value: node_with_occurrence_id(
                kind: TypeNode { connective: Cardinality },
                children: [Edge { label: Positional, target: base }],
                occurrence_id: source.occurrence_id
              )
            )
          false => optional_absent()
        }
      Absent => Absent
    }
  }
}

// A FUNCTION TYPE `fn(T0, T1) -> U` is the Arrow the target model reads as its positional wire
// (v2.std.compilers.target_model TargetTypeExprArrowPositionalWire, target_type_expr_arrow_emitted):
// the inputs, then the output, all positional; no body edge. The captured is
// seq(`fn`, seq(`(`, seq(type_list, seq(`)`, seq(`->`, type_expr))))).
fn body_lower_fn_type_lowered_optional(fn_type_shell: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: fn_type_shell) {
    Absent => Absent
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => Absent
        Present { value: after_fn } =>
          match sugar_sequence_pair_optional(node: after_fn.right) {
            Absent => Absent
            Present { value: after_lparen } =>
              match sugar_sequence_pair_optional(node: after_lparen.right) {
                Absent => Absent
                Present { value: after_list } =>
                  match sugar_sequence_pair_optional(node: after_list.right) {
                    Absent => Absent
                    Present { value: after_rparen } =>
                      match sugar_sequence_pair_optional(node: after_rparen.right) {
                        Absent => Absent
                        Present { value: after_arrow } =>
                          match body_lower_comma_list_items_optional(list_capture: after_list.left) {
                            Absent => Absent
                            Present { value: items } =>
                              match fold(items, init: Present { value: Empty }, f: fn(acc, item) {
                                match acc {
                                  Absent => Absent
                                  Present { value: domain_types } =>
                                    match body_lower_type_expr_lowered_optional(node: item) {
                                      Absent => Absent
                                      Present { value: t } => Present { value: list_snoc_item(xs: domain_types, item: t) }
                                    }
                                }
                              }) {
                                Absent => Absent
                                Present { value: domain_types } =>
                                  match body_lower_type_expr_lowered_optional(node: after_arrow.right) {
                                    Absent => Absent
                                    Present { value: codomain_type } =>
                                      optional_present(
                                        value: node_with_occurrence_id(
                                          kind: TypeNode { connective: Arrow },
                                          children: fold(
                                            list_append(left: domain_types, right: [codomain_type]),
                                            init: Empty,
                                            f: fn(acc, t) { list_snoc_item(xs: acc, item: Edge { label: Positional, target: t }) }
                                          ),
                                          occurrence_id: fn_type_shell.occurrence_id
                                        )
                                      )
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// AN ANONYMOUS RECORD TYPE IS THE SAME CONJ A RECORD DECLARATION'S BODY IS. `-> { success: Bool }`
// is a type expression whose captured is a field_decl_block, and a field block already has one
// reader: body_lower_field_decl_block_payload, which `type R { ... }` and a variant's record payload
// lower through, giving Conj { success: Bool }. Before this arm the reader had no case for the block,
// answered Absent, and every fn whose signature carried one was retained whole at the fn_decl shell
// (gen-two census: gunbc.tools.cron_tag upsert_tagged_cron_tab). A block whose fields cannot be read
// still answers Absent here and so still retains -- this reader is Optional by contract, and the
// retention is the counted frontier, not a silent accept.
fn body_lower_anonymous_record_type_optional(block_shell: Node) -> Optional<Node> {
  match body_lower_field_decl_block_payload(block_shell: block_shell) {
    Accepted { value: payload, diagnostics: _ } => optional_present(value: payload)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn body_lower_type_expr_lowered_optional(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_type_expr {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_type_expr_lowered_optional(node: captured)
          Absent => Absent
        }
      } else if id == ^dag_surface_fn_type {
        body_lower_fn_type_lowered_optional(fn_type_shell: node)
      } else if id == ^dag_surface_field_decl_block {
        body_lower_anonymous_record_type_optional(block_shell: node)
      } else {
        body_lower_type_atom_from_expr(node: node)
      }
    Absent =>
      match sugar_sequence_pair_optional(node: node) {
        Absent => body_lower_type_atom_from_expr(node: node)
        Present { value: outer } =>
          match sugar_sequence_pair_optional(node: outer.left) {
            Absent => body_lower_type_atom_from_expr(node: node)
            Present { value: inner } =>
              match body_lower_type_atom_from_expr(node: inner.left) {
                Absent => Absent
                Present { value: head } =>
                  match body_lower_type_generic_args_optional(generic_capture: inner.right) {
                    Absent => Absent
                    Present { value: args } =>
                      body_lower_type_wrap_cardinality(
                        base: body_lower_type_wrap_instantiation(head: head, args: args, source: node),
                        question_capture: outer.right,
                        source: node
                      )
                  }
              }
          }
      }
  }
}

fn body_lower_param_list_comma_spine_optional(param_list_captured: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: param_list_captured) {
    Absent => Absent
    Present { value: pair } =>
      match sugar_sequence_pair_optional(node: pair.right) {
        Absent => Absent
        Present { value: inner } =>
          Present {
            value: body_lower_unwrap_optional_element(node: inner.left)
          }
      }
  }
}

fn body_lower_type_atom_from_arrow_seq_right(right: Node) -> Optional<Node> {
  match body_lower_find_captured(
    root: right,
    emitted: ^dag_surface_type_expr
  ) {
    ParseSubtreeFound { captured: type_expr } =>
      body_lower_type_expr_lowered_optional(node: type_expr)
    ParseSubtreeAbsent =>
      match parse_production_emitted_identity_optional(node: right) {
        Present { value: emitted } =>
          match emitted == ^dag_surface_type_expr {
            true =>
              match parse_production_captured_child_optional(node: right) {
                Present { value: captured } =>
                  body_lower_type_expr_lowered_optional(node: captured)
                Absent => Absent
              }
            false => Absent
          }
        Absent => Absent
      }
  }
}

fn body_lower_arrow_seq_return_type(node: Node) -> Optional<Node> {
  match find_named_child(root: node, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: left, diagnostics: _ } =>
      match body_lower_sequence_head_is_arrow(node: left) {
        true =>
          match find_named_child(root: node, name: ^grammar_sequence_right_node_projection) {
            Accepted { value: right, diagnostics: _ } =>
              body_lower_type_atom_from_arrow_seq_right(right: right)
            Rejected { diagnostics: _ } => Absent
          }
        false => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

fn body_lower_domain_from_param_list(param_list: Node) -> Optional<Node> {
  match body_lower_param_list_comma_spine_optional(param_list_captured: param_list) {
    Absent => Absent
    Present { value: comma_spine } =>
      let edges = body_lower_param_edges(sequence_capture: comma_spine)
      if count(edges) == 0 {
        Present {
          value: node_lowered_from(
            kind: TypeNode { connective: Conj },
            children: [],
            source: param_list
          )
        }
      } else {
        Present {
          value: node_lowered_from(
            kind: TypeNode { connective: Conj },
            children: edges,
            source: param_list
          )
        }
      }
  }
}

fn body_lower_sequence_head_is_arrow(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => id == ^dag_token_arrow
    Absent =>
      match sugar_sequence_pair_optional(node: node) {
        Present { value: pair } => body_lower_sequence_head_is_arrow(node: pair.left)
        Absent => false
      }
  }
}

// The return type of a `fn` is a POSITIONAL fact of the fn_decl production, not a shape to go
// looking for. `dag_grammar_fn_decl_expr` is one right-nested sequence:
//   seq(kw_fn, seq(name, seq(opt(generic_params), seq(param_list, seq(RET, BODY)))))
// where RET is `opt(seq(arrow, type_expr))`. So RET is the LEFT of the FOURTH right-projection
// from the production's captured child, at a fixed depth. An elided `optional` still yields
// grammar_empty_node (v2.compiler.parse parse_expr_optional returns one on the rejected arm), so
// the spine positions do NOT shift when the generic params or the arrow clause are absent --
// that is what makes reading by position sound rather than a guess about layout.
//
// THE DEPTH IS VERIFIED AGAINST THE PRODUCTION, NOT SAMPLED FROM SPECIMENS. That production has
// exactly TWO optionals and only generic_params precedes the return clause, so generic_params is
// the entire risk surface for this depth; both it and the `= expr` body arm are held by
// executing falsifiers (`nfbcp_falsifier_generic_fn_return_type_holds`,
// `nfbcp_falsifier_eq_body_fn_return_type_holds`). The reciprocal note lives on the carrier that
// owns the shape, beside dag_grammar_fn_decl_expr, because the person who would break this is
// editing the grammar and not this reader.
//
// THIS REPLACES A SILENTLY WRONG READING, AND THAT IS WHY IT IS NOT AN OPTIMISATION.
// The deleted reading (body_lower_return_type_after_arrow_walk, #10929) walked the whole fn
// subtree looking for any sequence(arrow, ...) with no prune, so it descended into the PARAMETER
// LIST and answered with the first arrow it met there. For `fn g(h: fn(Int) -> Int) -> Bool`
// -- which parses today, because fn_type is a type_expr alternative -- it returned
// dag_binding_type_int for a function declared to return Bool. A wrong answer with no diagnostic
// is DESIGN section 5's forbidden class, not a cost finding. The positional read cannot reach a
// parameter's type at all, so the invalid state is unwritable rather than checked for
// (DESIGN section 4b: construction over validation). Its sibling
// body_lower_type_expr_after_arrow, a second blind arrow hunt with no consumer on main, is
// deleted with it rather than left standing as a second authority for the same question.
// Discriminating red: test.claim.parse_test_fn_decl_return_clause
// `nfbcp_hazard_return_type_is_positional_holds`, which fails on the deleted reading and holds
// on this one; `nfbcp_hazard_specimen_parses_holds` beside it separates "no hazard" from
// "specimen does not parse", so the red cannot go green by the specimen ceasing to compile.
fn body_lower_fn_decl_spine_right(node: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: node)) {
    Present { value: pair } => optional_present(value: pair.right)
    Absent => optional_absent()
  }
}

fn body_lower_fn_decl_return_clause_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: captured) {
    Absent => optional_absent()
    Present { value: after_kw_fn } =>
      match body_lower_fn_decl_spine_right(node: after_kw_fn) {
        Absent => optional_absent()
        Present { value: after_name } =>
          match body_lower_fn_decl_spine_right(node: after_name) {
            Absent => optional_absent()
            Present { value: after_generics } =>
              match body_lower_fn_decl_spine_right(node: after_generics) {
                Absent => optional_absent()
                Present { value: after_params } =>
                  match sugar_sequence_pair_optional(
                    node: body_lower_deep_unwrap_optional(node: after_params)
                  ) {
                    Absent => optional_absent()
                    Present { value: pair } =>
                      optional_present(
                        value: body_lower_unwrap_optional_element(node: pair.left)
                      )
                  }
              }
          }
      }
  }
}

// THE `<T>` LIST IS A POSITIONAL FACT OF THE SAME SPINE: it is the LEFT of the THIRD
// right-projection (seq(kw_fn, seq(name, seq(opt(generic_params), ...)))), and an elided list
// is grammar_empty_node, which carries no generic_params production. The production is looked
// for ONLY inside that slot, so a generic list anywhere else in the declaration -- a parameter's
// type, the body -- can never be read as this fn's binders.
fn body_lower_decl_generic_params_slot_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: captured) {
    Absent => optional_absent()
    Present { value: after_kw_fn } =>
      match body_lower_fn_decl_spine_right(node: after_kw_fn) {
        Absent => optional_absent()
        Present { value: after_name } =>
          match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: after_name)) {
            Absent => optional_absent()
            Present { value: pair } => optional_present(value: pair.left)
          }
      }
  }
}

fn body_lower_generic_param_binder_edge(item: Node) -> Optional<Edge> {
  match body_lower_param_binding_optional(node: body_lower_deep_unwrap_optional(node: item)) {
    Absent => optional_absent()
    Present { value: name } =>
      optional_present(value: Edge {
        label: Named { name: name },
        target: body_lower_param_ref_atom(source: item, identity: name)
      })
  }
}

// The repeat tail of comma_list(item): each element is seq(opt(comma), item).
fn body_lower_no_type_param_edges() -> List<Edge> {
  Empty
}

fn body_lower_generic_param_edges_from_repeat_tail(repeat_capture: Node) -> Optional<List<Edge>> {
  if is_empty_conj_root(n: repeat_capture) {
    optional_present(value: body_lower_no_type_param_edges())
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Rejected { diagnostics: _ } => optional_absent()
      Accepted { value: element, diagnostics: _ } =>
        match sugar_sequence_pair_optional(node: element) {
          Absent => optional_absent()
          Present { value: comma_then_item } =>
            match body_lower_generic_param_binder_edge(item: comma_then_item.right) {
              Absent => optional_absent()
              Present { value: edge } =>
                match find_named_child(root: repeat_capture, name: ^grammar_sequence_right_node_projection) {
                  Rejected { diagnostics: _ } => optional_present(value: [edge])
                  Accepted { value: tail, diagnostics: _ } =>
                    match body_lower_generic_param_edges_from_repeat_tail(repeat_capture: tail) {
                      Absent => optional_absent()
                      Present { value: rest } => optional_present(value: list_append(left: [edge], right: rest))
                    }
                }
            }
        }
    }
  }
}

// comma_list(item) = seq(item, seq(repeat(seq(opt(comma), item)), opt(comma))).
fn body_lower_generic_param_edges(comma_list: Node) -> Optional<List<Edge>> {
  match sugar_sequence_pair_optional(node: comma_list) {
    Absent => optional_absent()
    Present { value: head_rest } =>
      match body_lower_generic_param_binder_edge(item: head_rest.left) {
        Absent => optional_absent()
        Present { value: first } =>
          match sugar_sequence_pair_optional(node: head_rest.right) {
            Absent => optional_absent()
            Present { value: repeat_then_comma } =>
              match body_lower_generic_param_edges_from_repeat_tail(repeat_capture: repeat_then_comma.left) {
                Absent => optional_absent()
                Present { value: rest } => optional_present(value: list_append(left: [first], right: rest))
              }
          }
      }
  }
}

// WHAT THE ARROW CARRIES FOR `<T, U>`. NoTypeParams when the slot is elided; TypeParams with the
// Conj v2.std.node type_binder_conj_conforms admits when every name is recovered; and
// TypeParamsUnreadable when the slot holds a generic list whose names cannot all be read. The
// third arm is why this is not an Optional: a list that is present and unreadable must REFUSE
// the declaration, never lower as if it declared nothing -- that silent drop is the class this
// carrier exists to close.
type DeclTypeParams
  = NoTypeParams
  | TypeParams { conj: Node }
  | TypeParamsUnreadable

fn body_lower_decl_type_params(captured: Node) -> DeclTypeParams {
  match body_lower_decl_generic_params_slot_optional(captured: captured) {
    Absent => TypeParamsUnreadable
    Present { value: slot } =>
      match body_lower_find_captured(root: slot, emitted: ^dag_surface_generic_params) {
        ParseSubtreeAbsent => NoTypeParams
        ParseSubtreeFound { captured: generic_params } =>
          match sugar_sequence_pair_optional(node: generic_params) {
            Absent => TypeParamsUnreadable
            Present { value: lt_rest } =>
              match sugar_sequence_pair_optional(node: lt_rest.right) {
                Absent => TypeParamsUnreadable
                Present { value: list_gt } =>
                  match body_lower_generic_param_edges(comma_list: list_gt.left) {
                    Absent => TypeParamsUnreadable
                    Present { value: edges } =>
                      TypeParams {
                        conj: node_lowered_from(
                          kind: TypeNode { connective: Conj },
                          children: edges,
                          source: generic_params
                        )
                      }
                  }
              }
          }
      }
  }
}

fn body_lower_type_params_unreadable_diagnostic(shell: Node) -> Diagnostic {
  Diagnostic {
    reason: ^body_lowering_reason_type_params_unreadable,
    at: node_locus(node: shell),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn body_lower_return_type_from_fn_captured(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_return_clause_optional(captured: captured) {
    Absent => optional_absent()
    Present { value: clause } => body_lower_arrow_seq_return_type(node: clause)
  }
}

fn body_lower_find_core_substrate_optional(root: Node) -> Optional<Node> {
  if body_lower_is_core_substrate(node: root) {
    optional_present(value: root)
  } else {
    fold(root.children, init: Absent, f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent => body_lower_find_core_substrate_optional(root: e.target)
      }
    })
  }
}

fn body_lower_try_fold_behavior_optional(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_fold(node: node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: folded, diagnostics: fd } =>
      if body_lower_is_core_substrate(node: folded) {
        outcome_with_diagnostics(value: optional_present(value: folded), diagnostics: fd)
      } else {
        outcome_with_diagnostics(value: optional_absent(), diagnostics: fd)
      }
  }
}

// A brace-headed sequence is a block delimiter. This matcher must not
// claim it as a call or infix: those arms would mint Transform with `{`
// as operator and drop the interior. Absent here means not this strategy;
// every call site then walks the interior. `{` is also unwritable as an
// infix operator in body_lower_operator_atom_optional.
fn body_lower_try_body_lowered(node: Node) -> Outcome<Optional<Node>> {
  if body_lower_is_core_substrate(node: node) {
    outcome_accepted(value: optional_present(value: node))
  } else if body_lower_sequence_left_is_lbrace(captured: node) {
    outcome_accepted(value: optional_absent())
  } else {
    match body_lower_dotted_chain_lowered_optional(node: node) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: Present { value: spine }, diagnostics: _ } =>
        outcome_accepted(value: optional_present(value: spine))
      Accepted { value: Absent, diagnostics: _ } =>
    match body_lower_try_fold_behavior_optional(node: node) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: fold_found, diagnostics: fd } =>
        match fold_found {
          Present { value: lowered } =>
            outcome_with_diagnostics(value: optional_present(value: lowered), diagnostics: fd)
          Absent =>
                    match body_lower_try_let_in_from_node(node: node) {
                      Rejected { diagnostics: r } => Rejected { diagnostics: r }
                      Accepted { value: let_found, diagnostics: ld } =>
                        match let_found {
                          Present { value: lowered } =>
                            outcome_with_diagnostics(
                              value: optional_present(value: lowered),
                              diagnostics: ld
                            )
                          Absent =>
                            match body_lower_try_loop_expr_from_node(node: node) {
                              Rejected { diagnostics: r } => Rejected { diagnostics: r }
                              Accepted { value: loop_found, diagnostics: lcd } =>
                                match loop_found {
                                  Present { value: lowered } =>
                                    outcome_with_diagnostics(
                                      value: optional_present(value: lowered),
                                      diagnostics: lcd
                                    )
                                  Absent =>
                        match body_lower_try_fold_loop(node: node) {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: fold_result, diagnostics: fd } =>
                            match fold_result {
                              Present { value: lowered } =>
                                outcome_with_diagnostics(
                                  value: optional_present(value: lowered),
                                  diagnostics: fd
                                )
                              Absent =>
                        match body_lower_try_primary_ident_call(node: node) {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: primary_call, diagnostics: pcd } =>
                            match primary_call {
                              Present { value: lowered } =>
                                outcome_with_diagnostics(
                                  value: optional_present(value: lowered),
                                  diagnostics: pcd
                                )
                              Absent =>
                                match body_lower_try_infix_transform(node: node) {
                                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                          Accepted { value: Present { value: lowered }, diagnostics: _ } =>
                                            outcome_accepted(value: optional_present(value: lowered))
                                          Accepted { value: Absent, diagnostics: _ } =>
                                                    let stripped = body_lower_unwrap_surface_shell(node: node)
                                                    match body_lower_try_fold_loop(node: stripped) {
                                                              Rejected { diagnostics: r } =>
                                                                Rejected { diagnostics: r }
                                                              Accepted { value: stripped_fold, diagnostics: sfd } =>
                                                                match stripped_fold {
                                                                  Present { value: lowered } =>
                                                                    outcome_with_diagnostics(
                                                                      value: optional_present(value: lowered),
                                                                      diagnostics: sfd
                                                                    )
                                                                  Absent =>
                                                            match body_lower_try_primary_ident_call(node: stripped) {
                                                              Rejected { diagnostics: r } =>
                                                                Rejected { diagnostics: r }
                                                              Accepted { value: stripped_call, diagnostics: scd } =>
                                                                match stripped_call {
                                                                  Present { value: lowered } =>
                                                                    outcome_with_diagnostics(
                                                                      value: optional_present(value: lowered),
                                                                      diagnostics: scd
                                                                    )
                                                                  Absent =>
                                                                    match body_lower_try_infix_transform(node: stripped) {
                                                                      Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                                                      Accepted { value: Present { value: lowered }, diagnostics: _ } =>
                                                                        outcome_accepted(
                                                                          value: optional_present(value: lowered)
                                                                        )
                                                                      Accepted { value: Absent, diagnostics: _ } =>
                                                                        outcome_accepted(value: optional_absent())
                                                                    }
                                                                }
                                                            }
                                                            }
                                                        }
                                        }
                            }
                        }
                            }
                          }
                        }
                    }
                }
            }
        }
    }
    }
  }
}

fn body_lower_reduce_passthrough(folded: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: folded) {
    Present { value: child } => outcome_accepted(value: child)
    Absent => outcome_accepted(value: folded)
  }
}

fn body_lower_reduce_or_keep(o: Outcome<Node>, folded: Node) -> Outcome<Node> {
  match o {
    Accepted { value: v, diagnostics: d } => Accepted { value: v, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: rejected_with_pending(pending: None, rejected: r) }
  }
}

fn body_lower_reduce_emitted(folded: Node, emitted: Symbol) -> Outcome<Node> {
  if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
    outcome_accepted(value: folded)
  } else if emitted == ^dag_surface_binary_expr {
    match body_lower_try_infix_transform(node: folded) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: Present { value: transform }, diagnostics: _ } => outcome_accepted(value: transform)
      Accepted { value: Absent, diagnostics: _ } => body_lower_reduce_passthrough(folded: folded)
    }
  } else if emitted == ^dag_surface_postfix_expr {
    body_lower_reduce_or_keep(o: body_lower_postfix_expr(shell: folded), folded: folded)
  } else if emitted == ^dag_surface_primary_expr {
    body_lower_reduce_or_keep(o: body_lower_primary_expr(shell: folded), folded: folded)
  } else if body_lower_is_pass_through_emitted(emitted: emitted) {
    body_lower_reduce_passthrough(folded: folded)
  } else if emitted == ^dag_surface_fn_decl {
    body_lower_reduce_or_keep(o: body_lowering_refuse_retained(o: body_lower_fn_decl_to_arrow(shell: folded)), folded: folded)
  } else if emitted == ^dag_surface_test_fn_decl {
    body_lower_reduce_or_keep(o: body_lowering_refuse_retained(o: body_lower_test_fn_decl_to_member(shell: folded)), folded: folded)
  } else if emitted == ^dag_surface_data_decl {
    body_lower_reduce_or_keep(o: body_lowering_refuse_retained(o: body_lower_data_decl_to_member(shell: folded)), folded: folded)
  } else {
    outcome_accepted(value: folded)
  }
}

fn body_lower_reduce(folded: Node) -> Outcome<Node> {
  if body_lower_is_core_substrate(node: folded) {
    outcome_accepted(value: folded)
  } else if dag_resolve_preserve_module_metadata_subtree(node: folded) {
    outcome_accepted(value: folded)
  } else {
    match parse_production_emitted_identity_optional(node: folded) {
      Absent => outcome_accepted(value: folded)
      Present { value: emitted } => body_lower_reduce_emitted(folded: folded, emitted: emitted)
    }
  }
}

fn body_lower_fold_children(node: Node) -> Outcome<Node> {
  fold(node.children, init: outcome_accepted(value: node_rebuild(n: node, children: [])), f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: shell, diagnostics: ad } =>
        match body_lower_fold(node: e.target) {
          Rejected { diagnostics: cr } =>
            Rejected { diagnostics: rejected_with_pending(pending: ad, rejected: cr) }
          Accepted { value: child, diagnostics: cd } =>
            Accepted {
              value: node_rebuild(
                n: shell,
                children: list_snoc_item(xs: shell.children, item: Edge { label: e.label, target: child })
              ),
              diagnostics: diagnostics_merge(outer: ad, inner: cd)
            }
        }
    }
  })
}

fn body_lower_fold_identity_absent(node: Node) -> Outcome<Node> {
  if body_lower_match_capture_heads_spine(
    spine: body_lower_unwrap_surface_shell(node: node)
  ) {
    match body_lower_try_match_from_captured(captured: node) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: lowered_opt, diagnostics: d } =>
        match lowered_opt {
          Present { value: lowered } => Accepted { value: lowered, diagnostics: d }
          Absent => body_lower_fold_reduce(node: node)
        }
    }
  } else {
    body_lower_fold_reduce(node: node)
  }
}

fn body_lower_fold(node: Node) -> Outcome<Node> {
  if body_lower_is_core_substrate(node: node) {
    outcome_accepted(value: node)
  } else {
    match parse_production_emitted_identity_optional(node: node) {
      Present { value: emitted } =>
        if emitted == ^dag_surface_match_expr {
          body_lower_match_expr(shell: node)
        } else if emitted == ^dag_surface_if_expr {
          body_lower_if_expr(shell: node)
        } else if emitted == ^dag_surface_loop_expr {
          body_lower_loop_expr(shell: node)
        } else if emitted == ^dag_surface_let_expr {
          body_lower_let_expr(shell: node)
        } else if emitted == ^dag_surface_stmt_seq {
          body_lower_stmt_seq(shell: node)
        } else if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
          outcome_accepted(value: node)
        } else if body_lower_is_deferred_lower_emitted(emitted: emitted) {
          outcome_accepted(value: node)
        } else {
          body_lower_fold_reduce(node: node)
        }
      Absent => body_lower_fold_identity_absent(node: node)
    }
  }
}

fn body_lower_fold_reduce(node: Node) -> Outcome<Node> {
  match body_lower_fold_children(node: node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: folded, diagnostics: d } =>
      match body_lower_reduce(folded: folded) {
        Rejected { diagnostics: r } =>
          Rejected { diagnostics: rejected_with_pending(pending: d, rejected: r) }
        Accepted { value: reduced, diagnostics: rd } =>
          Accepted { value: reduced, diagnostics: diagnostics_merge(outer: d, inner: rd) }
      }
  }
}

fn body_lower_body_subtree_lower_from_primary(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_primary_expr) {
    ParseSubtreeFound { captured: primary } =>
      match body_lower_primary_expr(shell: primary) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered, diagnostics: d } =>
          outcome_with_diagnostics(
            value: optional_present(value: lowered),
            diagnostics: d
          )
      }
    ParseSubtreeAbsent =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_stmt) {
        ParseSubtreeFound { captured: stmt } =>
          body_lower_body_subtree_lower(captured: stmt)
        ParseSubtreeAbsent =>
          match body_lower_find_core_substrate_optional(root: captured) {
            Present { value: lowered } =>
              outcome_accepted(value: optional_present(value: lowered))
            Absent =>
              body_lower_try_body_lowered(
                node: body_lower_unwrap_surface_shell(node: captured)
              )
          }
      }
  }
}

fn body_lower_body_subtree_lower_from_postfix(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_postfix_expr) {
    ParseSubtreeFound { captured: postfix } =>
      match body_lower_try_body_lowered(node: postfix) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: found, diagnostics: d } =>
          match found {
            Present { value: lowered } =>
              outcome_with_diagnostics(
                value: optional_present(value: lowered),
                diagnostics: d
              )
            Absent => body_lower_body_subtree_lower_from_primary(captured: captured)
          }
      }
    ParseSubtreeAbsent => body_lower_body_subtree_lower_from_primary(captured: captured)
  }
}

fn body_lower_body_subtree_lower_from_expr(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_expr) {
    ParseSubtreeFound { captured: expr } =>
      match body_lower_try_body_lowered(node: expr) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: found, diagnostics: d } =>
          match found {
            Present { value: lowered } =>
              outcome_with_diagnostics(
                value: optional_present(value: lowered),
                diagnostics: d
              )
            Absent => body_lower_body_subtree_lower_from_postfix(captured: captured)
          }
      }
    ParseSubtreeAbsent => body_lower_body_subtree_lower_from_postfix(captured: captured)
  }
}

fn body_lower_body_subtree_lower_from_binary(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_binary_expr) {
    ParseSubtreeFound { captured: binary } =>
      match body_lower_try_body_lowered(node: binary) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: found, diagnostics: d } =>
          match found {
            Present { value: lowered } =>
              outcome_with_diagnostics(
                value: optional_present(value: lowered),
                diagnostics: d
              )
            Absent => body_lower_body_subtree_lower_from_expr(captured: captured)
          }
      }
    ParseSubtreeAbsent => body_lower_body_subtree_lower_from_expr(captured: captured)
  }
}

fn body_lower_body_subtree_lower(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_try_statement_spine(captured: captured) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: bound, diagnostics: bd } =>
      match bound {
        Present { value: lowered } =>
          outcome_with_diagnostics(
            value: optional_present(value: lowered),
            diagnostics: bd
          )
        Absent => body_lower_body_subtree_lower_rest(captured: captured)
      }
  }
}

// THE OUTERMOST CONTROL FORM, NOT THE FIRST OF A FIXED KIND. The four control productions were
// searched one kind at a time, each search deep, so a body `match c { A(x) => if p { .. } .. }`
// was answered by the `if` inside its arm -- the whole match, both arms and the binder, gone --
// because `if` was searched before `match`. One pre-order walk over the four kinds finds the
// form nearest the root, which on an expression spine is the one that owns the body.
type ControlFormFound {
  emitted: Symbol
  captured: Node
}

fn body_lower_is_control_form_emitted(id: Symbol) -> Bool {
  (id == ^dag_surface_if_expr)
    || (id == ^dag_surface_match_expr)
    || (id == ^dag_surface_loop_expr)
    || (id == ^dag_surface_let_expr)
}

fn body_lower_find_control_form_optional(root: Node) -> Optional<ControlFormFound> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      match body_lower_is_control_form_emitted(id: id) {
        true =>
          match parse_production_captured_child_optional(node: root) {
            Present { value: captured } =>
              optional_present(value: ControlFormFound { emitted: id, captured: captured })
            Absent => body_lower_find_control_form_under_children(root: root)
          }
        false =>
          match body_lower_find_captured_prunable(id: id) {
            true => optional_absent()
            false => body_lower_find_control_form_under_children(root: root)
          }
      }
    Absent => body_lower_find_control_form_under_children(root: root)
  }
}

fn body_lower_find_control_form_under_children(root: Node) -> Optional<ControlFormFound> {
  fold(root.children, init: Absent, f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => body_lower_find_control_form_optional(root: edge.target)
    }
  })
}

fn body_lower_body_subtree_lower_control_forms(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_control_form_optional(root: captured) {
    Absent => body_lower_body_subtree_lower_from_binary(captured: captured)
    Present { value: found } =>
      if found.emitted == ^dag_surface_if_expr {
        body_lower_try_if_from_captured(captured: found.captured)
      } else if found.emitted == ^dag_surface_match_expr {
        body_lower_try_match_from_captured(captured: found.captured)
      } else if found.emitted == ^dag_surface_loop_expr {
        body_lower_try_loop_expr_from_captured(captured: found.captured)
      } else {
        body_lower_try_let_in_from_captured(captured: found.captured)
      }
  }
}

fn body_lower_body_subtree_lower_rest(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_try_body_lowered(node: captured) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: found, diagnostics: _ } =>
      match found {
        Present { value: lowered } =>
          outcome_accepted(value: optional_present(value: lowered))
        Absent => body_lower_body_subtree_lower_control_forms(captured: captured)
      }
  }
}

fn body_lower_node_is_eq_token(n: Node) -> Bool {
  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: n)) {
    Present { value: id } => id == ^dag_token_eq
    Absent => false
  }
}

fn body_lower_eq_body_fold_init() -> Optional<Node> {
  optional_absent()
}

fn body_lower_last_child_fold_step(_acc: Optional<Node>, e: Edge) -> Optional<Node> {
  optional_present(value: e.target)
}

fn body_lower_last_child_optional(n: Node) -> Optional<Node> {
  fold(n.children, init: body_lower_eq_body_fold_init(), f: body_lower_last_child_fold_step)
}

fn body_lower_atom_body_optional(expr: Node) -> Optional<Node> {
  match body_lower_materialize_int_literal_operand_optional(node: expr) {
    Present { value: lit } => Present { value: lit }
    Absent => body_lower_operand_ref_optional(node: expr)
  }
}

fn body_lower_eq_expr_to_body(expr: Node) -> Outcome<Optional<Node>> {
  match body_lower_body_subtree_lower(captured: expr) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: body_opt, diagnostics: d } =>
      match body_opt {
        Present { value: lowered } =>
          outcome_with_diagnostics(
            value: optional_present(value: lowered),
            diagnostics: d
          )
        Absent =>
          match body_lower_atom_body_optional(expr: expr) {
            Present { value: atom } =>
              outcome_with_diagnostics(
                value: optional_present(value: atom),
                diagnostics: d
              )
            Absent =>
              match body_lower_last_child_optional(n: expr) {
                Absent => outcome_with_diagnostics(value: optional_absent(), diagnostics: d)
                Present { value: last } =>
                  match body_lower_atom_body_optional(expr: last) {
                    Present { value: atom } =>
                      outcome_with_diagnostics(
                        value: optional_present(value: atom),
                        diagnostics: d
                      )
                    Absent => body_lower_eq_expr_to_body(expr: last)
                  }
              }
          }
      }
  }
}

fn body_lower_body_from_fn_captured(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_fn_body) {
    ParseSubtreeFound { captured: body } => body_lower_body_subtree_lower(captured: body)
    ParseSubtreeAbsent =>
      match body_lower_body_after_eq_token(captured: captured) {
        Present { value: expr } => body_lower_eq_expr_to_body(expr: expr)
        Absent => outcome_accepted(value: optional_absent())
      }
  }
}

fn body_lower_eq_body_fold_step(acc: Optional<Node>, e: Edge) -> Optional<Node> {
  match acc {
    Present { value: n } =>
      if body_lower_node_is_eq_token(n: n) {
        optional_present(value: e.target)
      } else {
        optional_present(value: n)
      }
    Absent =>
      if body_lower_node_is_eq_token(n: e.target) {
        optional_present(value: e.target)
      } else {
        body_lower_body_after_eq_token(captured: e.target)
      }
  }
}

fn body_lower_body_after_eq_token(captured: Node) -> Optional<Node> {
  match fold(captured.children, init: body_lower_eq_body_fold_init(), f: body_lower_eq_body_fold_step) {
    Absent => optional_absent()
    Present { value: n } =>
      if body_lower_node_is_eq_token(n: n) {
        optional_absent()
      } else {
        optional_present(value: n)
      }
  }
}

fn body_lower_reify_operand_node(node: Node) -> Optional<Node> {
  match body_lower_operand_ref_optional(node: node) {
    Present { value: op } => Present { value: op }
    Absent => body_lower_operand_from_shell_optional(shell: node)
  }
}

// The head (positional 0) and a Named edge are kept as authored: the named edge is a
// v2.std.type_binder marker (a cast's target type), never an operand to reify.
fn body_lower_reify_transform_edge(
  done: List<Edge>,
  e: Edge
) -> Outcome<List<Edge>> {
  if (length(xs: done) == 0) || !is_positional(e: e) {
    outcome_accepted(
      value: list_snoc_item(
        xs: done,
        item: Edge { label: e.label, target: e.target }
      )
    )
  } else {
    match body_lower_reify_operand_node(node: e.target) {
      Present { value: reified } =>
        outcome_accepted(
          value: list_snoc_item(
            xs: done,
            item: Edge { label: e.label, target: reified }
          )
        )
      Absent =>
        outcome_rejected(
          d: body_lower_diagnostic(
            reason: ^body_lowering_reason_unsupported_form,
            n: e.target
          )
        )
    }
  }
}

fn body_lower_reify_transform_body(body: Node) -> Outcome<Node> {
  match body.kind {
    ComputationNode { behavior: Transform } =>
      match fold(body.children, init: outcome_accepted(value: Empty), f: fn(acc, e) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: done, diagnostics: d } =>
            match body_lower_reify_transform_edge(done: done, e: e) {
              Rejected { diagnostics: r } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: d, rejected: r)
                }
              Accepted { value: next, diagnostics: ed } =>
                Accepted {
                  value: next,
                  diagnostics: diagnostics_merge(outer: d, inner: ed)
                }
            }
        }
      }) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: children, diagnostics: d } =>
          outcome_with_diagnostics(
            value: node_lowered_from(
              kind: ComputationNode { behavior: Transform },
              children: children,
              source: body
            ),
            diagnostics: d
          )
      }
    _ => outcome_accepted(value: body)
  }
}

// The wrap stands at the same authored text as the arrow it wraps -- one `fn` declaration -- so it
// takes that declaration's occurrence rather than being a fresh anonymous node between the module
// body and the arrow.
fn body_lower_fn_decl_named_member_wrap(arrow: Node, fn_name: Symbol, source: Node) -> Node {
  node_lowered_from(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: fn_name }, target: arrow }
    ],
    source: source
  )
}

// A `test fn` declaration lowers to the SAME named-member arrow a plain `fn` lowers to: the
// production is the contextual `sequence(ident("test"), fn_decl)` (see dag_grammar_test_fn_decl_expr
// for why `test` is not a reserved keyword), the fold has already lowered the nested fn_decl child
// by the time this shell reduces, and this arm lifts the member out of the sequence's right
// projection after checking the marker lexeme really is "test". A non-"test" marker is a typed
// refusal, never a retained wrapper. The TEST-NESS marker is deliberately not reified into the
// member node: it rides its own channel beside the semantic tree (the DESIGN section 4c shape),
// v2.compiler.test_marker_capture over the same parse tree, so the semantic member stays identical
// to a plain fn's.
//
// TWO PRODUCERS OF TEST-NESS STAND TODAY, AND THIS NAMES BOTH RATHER THAN DROPPING ONE.
// (1) The capture above, the compiler's. (2) The floor's witness universe, derived by
// v2.workflow.floor_discovery_source_authority discover_floor_rows_for_source, a line scan for
// `test fn ` / `test data ` over source text that deliberately neither parses nor resolves
// (v2.workflow.floor_naming_hygiene names it a second parser). TRIGGER for converging it onto this
// channel: the floor preparing a parse artifact for each discovered source, at which point discovery
// reads the marks from that parse instead of rescanning the bytes. A third producer,
// v2.workflow.realization_attempt's line-rewriting capture, was deleted in the change that added
// this channel: its only reason was a grammar that could not parse the marker.
fn body_lower_test_fn_decl_to_member(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_seq_child(node: captured, name: ^grammar_sequence_left_node_projection) {
        Absent => body_lower_wrapper_retained_shell(shell: shell)
        Present { value: marker_node } =>
          match dag_binding_branded_atom_identity(node: marker_node) {
            Present { value: marker } =>
              if marker == ^test {
                match body_lower_seq_child(node: captured, name: ^grammar_sequence_right_node_projection) {
                  Absent => body_lower_wrapper_retained_shell(shell: shell)
                  Present { value: member } => body_lowering_lowered(o: outcome_accepted(value: member))
                }
              } else {
                body_lowering_lowered(
                  o: outcome_rejected(
                    d: body_lower_diagnostic(reason: ^body_lowering_reason_test_marker_not_test, n: marker_node)
                  )
                )
              }
            Absent => body_lower_wrapper_retained_shell(shell: shell)
          }
      }
  }
}

// THE WALL SITS AT THE FN, NOT ONLY AT THE STATEMENT. A fn body is lowered DEFERRED, from the raw
// parse subtree by this function's own navigation, so its statements never pass through
// body_lower_after_children one by one; body_lower_body_subtree_lower_from_primary would instead
// find the first primary expression inside an else-less `if` -- its condition -- and return THAT as
// the body, silently discarding the guard and every statement after it. So the fn refuses the whole
// declaration when its subtree holds one, with the same typed cause the statement arm raises.
fn body_lower_fn_decl_to_arrow(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_else_less_if_stmt) {
        ParseSubtreeFound { captured: guard } => body_lowering_lowered(o: body_lower_else_less_if_reject(shell: guard))
        ParseSubtreeAbsent => body_lower_fn_decl_to_arrow_admitted(shell: shell, captured: captured)
      }
  }
}

// THE SIGNATURE OF A FN DECLARATION, READ ONCE FOR BOTH GRADES. The full arm and the census arm build
// one Arrow from one set of reads; only whether a body edge follows differs. So the reads live here
// and the Arrow is built by body_lower_fn_decl_arrow -- its ONE child list, with the body edge
// present or absent -- and "census grade is the same signature" holds
// by construction rather than by two copies staying in step. Absent means a signature this lowering
// cannot read, which both arms retain as the shell.
type BodyLowerFnSignature {
  domain: Node,
  return_type: Node,
  fn_name: Symbol,
  type_params: DeclTypeParams,
}

fn body_lower_fn_signature_optional(captured: Node) -> Optional<BodyLowerFnSignature> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_param_list) {
    ParseSubtreeAbsent => Absent
    ParseSubtreeFound { captured: param_list } =>
      match body_lower_domain_from_param_list(param_list: param_list) {
        Absent => Absent
        Present { value: domain } =>
          match body_lower_return_type_from_fn_captured(captured: captured) {
            Absent => Absent
            Present { value: return_type } =>
              match dag_surface_kw_then_ident_from_captured(captured: captured) {
                Absent => Absent
                Present { value: fn_name } =>
                  Present {
                    value: BodyLowerFnSignature {
                      domain: domain,
                      return_type: return_type,
                      fn_name: fn_name,
                      type_params: body_lower_decl_type_params(captured: captured)
                    }
                  }
              }
          }
      }
  }
}

// The type-parameter edge is part of the SIGNATURE, so the census grade carries it exactly as the
// full grade does. A sig whose type parameters are TypeParamsUnreadable never reaches this builder:
// both arms refuse it first (body_lower_fn_signature_refusal).
fn body_lower_fn_decl_type_params_edges(sig: BodyLowerFnSignature) -> List<Edge> {
  match sig.type_params {
    TypeParams { conj: c } => [type_params_edge(conj: c)]
    NoTypeParams => body_lower_no_type_param_edges()
    TypeParamsUnreadable => body_lower_no_type_param_edges()
  }
}

// A SIGNATURE THIS LOWERING READ BUT CANNOT BUILD refuses here, at the signature, before either arm
// builds the Arrow. Two facts qualify: unreadable type parameters (above), and a parameter binding
// the domain cannot key. The domain is a Conj keyed by binding name (v2.std.node all_names_distinct;
// the offending edge is read from v2.std.node_query repeated_name_edges),
// so a repeated binding has no well-formed domain. Before this arm the lowering built that Conj
// anyway and normalize's recursive well_formed gate refused the module AT ITS ROOT with no locus
// (gen-two census: std.key_relation global_key_scope_eq, gunbc.provider_readiness_claim_evidence
// provider_readiness_independence_claim). The refusal now lands at the second binding's type node.
//
// A repeated `_` never reaches this arm: every anonymous slot carries its own minted binder
// (v2.std.anonymous_binder, via body_lower_param_edges), so two `_` parameters are two distinct
// keys. What remains is two parameters claiming one authored name, which no realization admits.
fn body_lower_fn_signature_refusal(shell: Node, sig: BodyLowerFnSignature) -> Optional<Outcome<Node>> {
  match sig.type_params {
    TypeParamsUnreadable =>
      optional_present(value: Rejected {
        diagnostics: diagnostics_singleton(d: body_lower_type_params_unreadable_diagnostic(shell: shell))
      })
    NoTypeParams => body_lower_fn_signature_bindings_refusal(shell: shell, sig: sig)
    TypeParams { conj: _ } => body_lower_fn_signature_bindings_refusal(shell: shell, sig: sig)
  }
}

fn body_lower_fn_signature_bindings_refusal(shell: Node, sig: BodyLowerFnSignature) -> Optional<Outcome<Node>> {
  match first(repeated_name_edges(children: sig.domain.children)) {
    Absent => optional_absent()
    Present { value: second } =>
      optional_present(value: Rejected {
        diagnostics: diagnostics_singleton(d: body_lower_repeated_param_binding_diagnostic(edge: second))
      })
  }
}

fn body_lower_repeated_param_binding_diagnostic(edge: Edge) -> Diagnostic {
  Diagnostic {
    reason: ^body_lowering_reason_arrow_domain_param_binding_repeated,
    at: node_locus(node: edge.target),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// A `data` DECLARATION LOWERS TO THE SAME NAMED MEMBER A NULLARY `fn` DOES: `data x: T = e` is
// Conj { x: Arrow(<empty domain>, T, T, body: e) }. Until 2026-09-23 dag_surface_data_decl sat in
// body_lower_is_metadata_preserved_emitted, so the declaration's interior reached infer as SURFACE
// SYNTAX -- namespace_graft named the member `x -> <the parse tail ': T = e'>` -- and infer was
// asked to ground `:` and `=` tokens and the type's spelling. Nothing could ground those, so every
// data declaration stayed on the grounding frontier and gen-one's translate gate refused the
// one-line door probe (fixture.native_cli_door.door_probe). A constant is the nullary function that
// returns it: that is the seed's own realization (v1.compiler.emit_rust emits a data item as a
// nullary fn and calls it at every reference), and it lets the existing Arrow, product and literal
// derivations ground the member with no data-specific infer rule. The data-versus-fn distinction a
// reference site needs is not carried by this shape; it lives in the declaration index
// (v2.std.decl_index data_decl_type_facts), which reads the parse, not this tree. A shell whose
// name, declared type or value is not reachable is retained as the counted frontier, exactly as
// the fn arm retains, never guessed.
// THE INITIALIZER IS ALREADY LOWERED WHEN THIS ARM RUNS. normalize_node_ctx folds a declaration's
// children before it dispatches the declaration, so the node after `=` is the folded initializer: a
// literal atom, a construct, a Transform. It is taken as it stands. Re-lowering it through
// body_lower_eq_expr_to_body would walk an already-lowered tree with the deep first-match searches,
// which retain on shapes they do not recognize (a record literal whose field is a fn literal).
// Only an initializer that is not yet substrate goes through that reader.
fn body_lower_data_initializer_body(expr: Node) -> Outcome<Optional<Node>> {
  if body_lower_is_core_substrate(node: expr) {
    outcome_accepted(value: optional_present(value: expr))
  } else {
    body_lower_eq_expr_to_body(expr: expr)
  }
}

fn body_lower_data_decl_to_member(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_type_expr) {
        ParseSubtreeAbsent => body_lower_wrapper_retained_shell(shell: shell)
        ParseSubtreeFound { captured: type_expr } =>
          match body_lower_type_expr_lowered_optional(node: type_expr) {
            Absent => body_lower_wrapper_retained_shell(shell: shell)
            Present { value: declared_type } =>
              match body_lower_body_after_eq_token(captured: captured) {
                Absent => body_lower_wrapper_retained_shell(shell: shell)
                Present { value: expr } =>
                  match body_lower_data_initializer_body(expr: expr) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: body_opt, diagnostics: bd0 } =>
                      match body_opt {
                        Absent => body_lowering_after_pending(pending: bd0, o: body_lower_wrapper_retained_shell(shell: shell))
                        Present { value: body } =>
                          match body_lower_reify_arrow_body(body: body) {
                            Rejected { diagnostics: r } => Rejected { diagnostics: r }
                            Accepted { value: reified_body, diagnostics: bd } =>
                              match dag_surface_kw_then_ident_from_captured(captured: captured) {
                                Absent => body_lowering_after_pending(
                                  pending: diagnostics_merge(outer: bd0, inner: bd),
                                  o: body_lower_wrapper_retained_shell(shell: shell)
                                )
                                Present { value: data_name } =>
                                  let arrow = node_lowered_from(
                                    source: shell,
                                    kind: TypeNode { connective: Arrow },
                                    children: [
                                      Edge {
                                        label: Positional,
                                        target: node_lowered_from(
                                          kind: TypeNode { connective: Conj },
                                          children: [],
                                          source: type_expr
                                        )
                                      },
                                      Edge { label: Positional, target: declared_type },
                                      Edge { label: Positional, target: declared_type },
                                      Edge {
                                        label: Named { name: ^arrow_body_edge },
                                        target: reified_body
                                      }
                                    ]
                                  )
                                  body_lowering_lowered(
                                    o: outcome_with_diagnostics(
                                      value: body_lower_fn_decl_named_member_wrap(
                                        arrow: arrow,
                                        fn_name: data_name,
                                        source: shell
                                      ),
                                      diagnostics: diagnostics_merge(outer: bd0, inner: bd)
                                    )
                                  )
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

fn body_lower_fn_decl_arrow(shell: Node, sig: BodyLowerFnSignature, body: Optional<Node>) -> Node {
  let signature = list_append(
    left: [
      Edge { label: Positional, target: sig.domain },
      Edge { label: Positional, target: sig.return_type },
      Edge { label: Positional, target: sig.return_type }
    ],
    right: body_lower_fn_decl_type_params_edges(sig: sig)
  )
  body_lower_fn_decl_named_member_wrap(
    arrow: node_lowered_from(
      source: shell,
      kind: TypeNode { connective: Arrow },
      children: match body {
        Absent => signature
        Present { value: b } =>
          list_append(left: signature, right: [Edge { label: Named { name: ^arrow_body_edge }, target: b }])
      }
    ),
    fn_name: sig.fn_name,
    source: shell
  )
}

// CENSUS GRADE: THE SIGNATURE, NEVER THE BODY. A module outside the compiled closure is read only for
// what resolution asks of it -- declaration paths and payload kinds -- and the symbol-index fill
// descends into an Arrow's domain alone. So the census arm builds the full arm's Arrow from the same
// signature and omits the ^arrow_body_edge: the body subtree is never lowered, so a body the
// lowering cannot yet read cannot refuse a module nobody compiles. What it does NOT relax: a
// signature this arm cannot read still retains, which the census door
// (v2.compiler.normalized_tree admit_census_tree) refuses exactly as the full door does. Omitting the
// edge rather than lowering the body tolerantly also removes the three incidental body reads a
// census root would otherwise feed: the subtree-wide Disj count, the alias scan, and the Arrow the
// index stores at the fn's path.
fn body_lower_fn_decl_to_census_arrow(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_fn_signature_optional(captured: captured) {
        Absent => body_lower_wrapper_retained_shell(shell: shell)
        Present { value: sig } =>
          match body_lower_fn_signature_refusal(shell: shell, sig: sig) {
            Present { value: refused } => body_lowering_lowered(o: refused)
            Absent =>
              body_lowering_lowered(
                o: outcome_accepted(value: body_lower_fn_decl_arrow(shell: shell, sig: sig, body: Absent))
              )
          }
      }
  }
}

// The signature is read before the body is lowered. A declaration whose signature cannot be read
// AND whose body refuses therefore now reports retention rather than the body's cause; both refuse,
// and the signature is the earlier fact.
fn body_lower_fn_decl_to_arrow_admitted(shell: Node, captured: Node) -> Outcome<BodyLowering> {
  match body_lower_fn_signature_optional(captured: captured) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: sig } =>
      match body_lower_fn_signature_refusal(shell: shell, sig: sig) {
        Present { value: refused } => body_lowering_lowered(o: refused)
        Absent =>
          match body_lower_body_from_fn_captured(captured: captured) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: body_opt, diagnostics: bd0 } =>
              match body_opt {
                Absent => body_lowering_after_pending(pending: bd0, o: body_lower_wrapper_retained_shell(shell: shell))
                Present { value: body } =>
                  match body_lower_reify_arrow_body(body: body) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: reified_body, diagnostics: bd } =>
                      body_lowering_lowered(
                        o: outcome_with_diagnostics(
                          value: body_lower_fn_decl_arrow(
                            shell: shell,
                            sig: sig,
                            body: Present { value: reified_body }
                          ),
                          diagnostics: diagnostics_merge(outer: bd0, inner: bd)
                        )
                      )
                  }
              }
          }
      }
  }
}

// A LITERAL READER ANSWERS ONLY A NODE THAT IS THE LITERAL WHOLE. It descends only where the node and
// its inner node are one value -- a production shell's captured child, a one-element sequence -- and
// never into a proper part. The descent was a first-match search over every child, so any node with a
// `true`, `false` or int literal anywhere under it read as that literal: the `else if` chain of
// `if a { a } else if a { false } else { u }` lowered to `false`, and `u` reached no reference site.
fn body_lower_whole_inner_optional(node: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: node) {
    Present { value: captured } => optional_present(value: captured)
    Absent =>
      match sugar_sequence_pair_optional(node: node) {
        Present { value: pair } =>
          if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
            optional_present(value: pair.left)
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

fn body_lower_literal_bool_atom_optional(node: Node) -> Optional<Node> {
  let unwrapped = body_lower_deep_unwrap_optional(node: node)
  match node_atom_identity_optional(node: unwrapped) {
    Present { value: id } =>
      if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
        optional_present(value: body_lower_param_ref_atom(source: unwrapped, identity: id))
      } else {
        body_lower_int_literal_with_magnitude_optional(node: unwrapped)
      }
    Absent =>
      match body_lower_whole_inner_optional(node: unwrapped) {
        Present { value: inner } => body_lower_literal_bool_atom_optional(node: inner)
        Absent => optional_absent()
      }
  }
}

fn body_lower_literal_int_atom_optional(node: Node) -> Optional<Node> {
  match body_lower_int_literal_with_magnitude_optional(node: node) {
    Present { value: lit } => Present { value: lit }
    Absent =>
      match body_lower_whole_inner_optional(node: body_lower_deep_unwrap_optional(node: node)) {
        Present { value: inner } => body_lower_literal_int_atom_optional(node: inner)
        Absent => optional_absent()
      }
  }
}

fn body_lower_operand_ref_acceptable_read(node: Node) -> OperandRefRead {
  match body_lower_operand_ref_read(node: node) {
    OperandRefLowered { lowered: operand } =>
      match body_lower_int_literal_with_magnitude_optional(node: operand) {
        Present { value: lit } => OperandRefLowered { lowered: lit }
        Absent =>
          match dag_node_is_int_literal_atom(node: operand) {
            true => OperandRefAbsent
            false => OperandRefLowered { lowered: operand }
          }
      }
    OperandRefAbsent => OperandRefAbsent
    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
  }
}

// A REFUSED OPERAND IS THIS READER'S REFUSAL. The literal and pattern readers below are deep
// first-match searches, so reaching them for an operand the operator reader refused answered the
// operand's first atom: `b && (u)` lowered to `b`. They stay the readers for what is not an operand.
fn body_lower_operand_or_atom_read(captured: Node) -> OperandRefRead {
  match body_lower_operand_ref_acceptable_read(node: captured) {
    OperandRefAbsent =>
      match body_lower_literal_bool_atom_optional(node: captured) {
        Present { value: lit } => OperandRefLowered { lowered: lit }
        Absent =>
          match body_lower_literal_int_atom_optional(node: captured) {
            Present { value: lit } => OperandRefLowered { lowered: lit }
            Absent =>
              match body_lower_pattern_first_atom_optional(node: captured) {
                Present { value: first } =>
                  if body_lower_atom_is_keyword_token(node: first) { OperandRefAbsent } else { OperandRefLowered { lowered: first } }
                Absent => OperandRefAbsent
              }
          }
      }
    OperandRefLowered { lowered: lowered } => OperandRefLowered { lowered: lowered }
    OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
  }
}

// A LEXER KEYWORD TOKEN IS NEVER AN OPERAND. The first-atom fallback in
// body_lower_operand_or_atom_read (above) answered a shell with its
// first atom whatever it was, so a function literal `fn(y) { zz }` in an if arm lowered to the atom
// dag_token_kw_fn and the literal was erased (gunbc.recurring_failure_mode
// body_type_annotation_dropped_before_resolve_in_v2). `true` / `false` are keyword tokens that ARE
// literal operands, and they need no exception here: body_lower_literal_bool_atom_optional reads them
// in body_lower_operand_or_atom_read BEFORE this fallback, so a boolean the fallback would meet is the
// first atom of something larger, and standing it in for the whole is the part-for-whole erasure this
// guard exists to refuse. The keyword/operand distinction is the lex rules' alone.
// KEYWORD, not token: an int literal reaches this fallback as an atom whose identity is the token CLASS
// dag_token_int_literal (`let x = 1 in x` binds exactly that), so asking whether the atom is any lexer
// token refused every such literal (v2.test.claim.body_lowering.statement_let_bind
// let_in_form_unchanged_holds). The keyword classes are the rules lexed by a KeywordPattern
// (v2.extdeps.languages.dag dag_lex_keyword_symbol).
fn body_lower_atom_is_keyword_token(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => dag_lex_keyword_symbol(sym: id)
    Absent => false
  }
}

fn body_lower_try_operand_or_reject(shell: Node, captured: Node) -> Outcome<Node> {
  match body_lower_operand_or_atom_read(captured: captured) {
    OperandRefLowered { lowered: operand } => outcome_accepted(value: operand)
    OperandRefRefused { diagnostics: r } => Rejected { diagnostics: r }
    OperandRefAbsent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
  }
}

fn body_lower_unwrap_pass_through(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } => outcome_accepted(value: captured)
  }
}

fn body_lower_transform_call(operator: Node, args: List<Node>) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: list_append(
      left: [Edge { label: Positional, target: operator }],
      right: fold(args, init: Empty, f: fn(acc, arg) {
        list_snoc_item(xs: acc, item: Edge { label: Positional, target: arg })
      })
    )
  )
}

fn body_lower_method_operator_atom(sym: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: sym } },
    children: []
  )
}

fn body_lower_arg_operand_optional(arg_capture: Node) -> Optional<Node> {
  match body_lower_find_captured(root: arg_capture, emitted: ^dag_surface_expr) {
    ParseSubtreeFound { captured: expr } => body_lower_operand_ref_optional(node: expr)
    ParseSubtreeAbsent =>
      match parse_production_emitted_identity_optional(node: arg_capture) {
        Present { value: emitted } =>
          if emitted == ^dag_surface_expr {
            match parse_production_captured_child_optional(node: arg_capture) {
              Present { value: captured } => body_lower_operand_ref_optional(node: captured)
              Absent => Absent
            }
          } else {
            body_lower_operand_ref_optional(node: arg_capture)
          }
        Absent => body_lower_operand_ref_optional(node: arg_capture)
      }
  }
}

// The VALUE CAPTURE of a named argument -- what follows `name :` -- unlowered. Absent when the
// capture is not that shape.
fn body_lower_named_arg_value_capture_optional(arg_capture: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: arg_capture) {
    Absent =>
      match parse_production_emitted_identity_optional(node: arg_capture) {
        Present { value: emitted } =>
          if emitted == ^dag_surface_arg {
            match parse_production_captured_child_optional(node: arg_capture) {
              Present { value: captured } =>
                body_lower_named_arg_value_capture_optional(arg_capture: captured)
              Absent => optional_absent()
            }
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
    Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        Absent => optional_absent()
        Present { value: _binding } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => optional_absent()
            Present { value: after_name } =>
              match node_atom_identity_optional(node: after_name.left) {
                Present { value: colon } =>
                  if colon == ^dag_token_colon {
                    optional_present(value: after_name.right)
                  } else {
                    optional_absent()
                  }
                Absent => optional_absent()
              }
          }
      }
  }
}

// THE NAMED ARM IS DECIDED BY THE ARGUMENT'S SHAPE, NOT BY WHETHER ITS VALUE LOWERED. A
// dag_surface_arg captures either `name : expr` or `expr` (v2.extdeps.languages.dag
// dag_grammar_arg_expr). The reader this replaces tried the named value first and, when that
// answered Absent, re-read the WHOLE capture as a positional operand -- and the operand reader,
// handed the `name : expr` sequence, answers its left atom, so an unlowerable named value became a
// reference to the parameter NAME with no diagnostic.
fn body_lower_call_arg_capture_is_named(arg_capture: Node) -> Bool {
  let captured = match parse_production_emitted_identity_optional(node: arg_capture) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_arg {
        match parse_production_captured_child_optional(node: arg_capture) {
          Present { value: inner } => inner
          Absent => arg_capture
        }
      } else {
        arg_capture
      }
    Absent => arg_capture
  }
  match sugar_sequence_pair_optional(node: captured) {
    Absent => false
    Present { value: pair } =>
      match sugar_sequence_pair_optional(node: pair.right) {
        Absent => false
        Present { value: after_name } =>
          match node_atom_identity_optional(node: after_name.left) {
            Present { value: colon } => colon == ^dag_token_colon
            Absent => false
          }
      }
  }
}

// The value, lowered, or carried as its shell under the counted advisory.
fn body_lower_value_lowered_or_carried(value: Node) -> Outcome<Node> {
  match body_lower_value_lowered(node: value) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: found, diagnostics: d } =>
      match found {
        Present { value: lowered } => Accepted { value: lowered, diagnostics: d }
        Absent =>
          outcome_with_diagnostics(
            value: value,
            diagnostics: diagnostics_merge(
              outer: d,
              inner: Some {
                diagnostics: diagnostics_singleton(
                  d: body_lower_diagnostic(
                    reason: ^body_lowering_reason_value_carried_unlowered,
                    n: value
                  )
                )
              }
            )
          )
      }
  }
}

// COST SHAPE: ONE BOTTOM-UP FOLD PER VALUE, THE WALKER ONLY AS THE FALLBACK. A raw value is first
// folded once (body_lower_fold, linear in its size: nested calls, records and literals lower with
// their children already lowered) and the result peeled; only a value the fold cannot bring to a
// lowered node enters the top-down walker. Entering the walker first is exponential in nesting
// depth: each walker attempt (body_lower_body_subtree_lower_rest and the from_binary / from_expr /
// from_postfix retries) re-folds the subtree through body_lower_try_body_lowered and re-enters
// this reader for every nested argument, so a call nested d deep is folded on the order of 5^d
// times. The instrument that re-derives this is the native lane's per-file phase clock: the
// emitted driver's `adjudicate` (std.compiler_entry SourceRootEvalDriver, absorbed by
// v2.compiler.compile native_test_context_absorb) prints one row per ingested file carrying
// `normalize_nanos`; sum and sort it over the workload closure, baseline against candidate. A fold
// that refuses hands the value to the walker rather than propagating: these positions were read
// by the walker before, and its verdict on them is the one this change does not alter.
fn body_lower_value_lowered(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_lowered_behind_shells_optional(node: node) {
    Present { value: lowered } => outcome_accepted(value: optional_present(value: lowered))
    Absent =>
      if body_lower_value_is_function_value_shell(node: node) {
        outcome_accepted(value: optional_absent())
      } else {
        let raw = body_lower_deep_unwrap_optional(node: node)
        match body_lower_fold(node: raw) {
          Accepted { value: folded, diagnostics: d } =>
            match body_lower_lowered_behind_shells_optional(node: folded) {
              Present { value: lowered } =>
                outcome_with_diagnostics(value: optional_present(value: lowered), diagnostics: d)
              Absent => body_lower_body_subtree_lower(captured: raw)
            }
          Rejected { diagnostics: _ } => body_lower_body_subtree_lower(captured: raw)
        }
      }
  }
}

// A value the bottom-up fold has already reduced sits behind what the reducers leave: a
// pass-through shell around the lowered child, or the binary_expr precedence spine -- one
// left-nested sequence per precedence level, each right projection an empty repeat -- with the
// lowered operand at its leftmost leaf (body_lower_reduce_passthrough strips the shells and keeps
// the spine). Both are peeled to the lowered node first; a spine with a non-empty right
// projection is an unlowered operator tail and is not peeled.
fn body_lower_lowered_behind_shells_optional(node: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  if body_lower_is_core_substrate(node: stripped) {
    optional_present(value: stripped)
  } else if body_lower_node_is_lowered_atom(node: stripped) {
    body_lower_operand_ref_optional(node: stripped)
  } else {
    match parse_production_emitted_identity_optional(node: stripped) {
      Present { value: _ } =>
        match parse_production_captured_child_optional(node: stripped) {
          Absent => optional_absent()
          Present { value: captured } => body_lower_lowered_behind_shells_optional(node: captured)
        }
      Absent =>
        match sugar_sequence_pair_optional(node: stripped) {
          Absent => optional_absent()
          Present { value: pair } =>
            if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
              body_lower_lowered_behind_shells_optional(node: pair.left)
            } else {
              optional_absent()
            }
        }
    }
  }
}

// ONE VALUE READER FOR FIELD INITIALIZERS, MATCH-ARM BODIES AND IF CONDITIONS. A value reaches
// these readers in one of two states: already lowered (the bottom-up fold has run over it, as
// under a data initializer, or it is core substrate) or raw (inside a fn body the fn_decl producer
// walks the parse top-down, so a value is still its `expr` shell). A lowered atom is read as the
// operand it is; anything else goes to body_lower_body_subtree_lower, the same entry the fn body
// itself is lowered by, so a nested call, an infix or a control form in value position lowers as it
// would in body position. Absent means this reader could not lower the value.
//
// CALL ARGUMENTS DO NOT GO THROUGH IT. gunbc#12108 is the authority for call-argument lowering
// (body_lower_call_args_from_capture -> body_lower_call_arg_value), and this reader once also served
// arguments; that route was dropped at the merge rather than kept beside #12108's. The two differ in
// strength: #12108's per-argument read goes through body_lower_operand_ref_optional, which narrows a
// sequence operand to its head (gunbc.recurring_failure_mode
// lowering_accessor_collapses_a_sequence_operand, its own trigger). Routing arguments through this
// reader is that failure mode's repair to make, not a second path to add here.
fn body_lower_node_is_lowered_atom(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: _ } => false
    Absent =>
      match node_atom_identity_optional(node: node) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

// A function value in argument or field position -- `c => body`, `fn(a) { body }` -- has no
// producer on this route (dag_surface_arrow_lambda and dag_surface_fn_literal are preserved
// structure, lowered only by fold_lowering inside a fold-family call). The body walker would
// answer such a value with its body's first primary, so it is named here and declined: the
// caller carries the shell under its advisory instead of a truncation.
fn body_lower_value_is_function_value_shell(node: Node) -> Bool {
  let stripped = body_lower_unwrap_surface_shell(node: body_lower_deep_unwrap_optional(node: node))
  match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: id } => (id == ^dag_surface_arrow_lambda) || (id == ^dag_surface_fn_literal)
    Absent => false
  }
}

// CALL ARGUMENTS ARE READ OFF THE GRAMMAR'S OWN COMMA-LIST SHAPE, AND AN UNREAD ARGUMENT REFUSES.
//
// The argument list a call suffix captures is v2.extdeps.languages.dag dag_grammar_arg_list_helper:
// an optional dag_grammar_comma_list_expr over dag_production_arg. So its parse is exactly
//   list   = sequence(first_arg, sequence(repeat, optional trailing comma))
//   repeat = sequence(sequence(optional comma, arg), repeat) | the empty conj
// and each arg is a dag_surface_arg capture, named (`probe: x`) or positional (`x`). The reader
// below walks that shape and nothing else, and every position it cannot read is a located refusal.
//
// THE READER IT REPLACES DROPPED EVERY ARGUMENT OF A PLAIN CALL, SILENTLY. It first asked
// body_lower_param_list_comma_spine_optional -- a reader for a PARAMETER list, whose capture still
// carries its parentheses -- to find a comma spine. An argument capture arrives with the
// parentheses already consumed by body_lower_postfix_call_suffix_args, so that reader answered
// Present on the first argument's own inner sequence, and the guessing collector beneath it then
// found no argument there and returned Empty. Measured on the real tokenize -> parse route at
// b8e0cc4eb9: `{ g(probe: x) }` and `{ g(x) }` both lowered to a call with zero arguments, and
// collecting the same capture without the spine step yielded one. Every Absent arm of that
// collector folded to Empty or to a skipped element, so nothing downstream -- the reference-site
// collector, the resolver -- could see a name used only as a call argument
// (gunbc.recurring_failure_mode call_expression_erased_at_v2_body_lowering).
//
// AN ARGUMENT'S VALUE IS LOWERED AS A VALUE, NOT READ AS AN OPERAND. The operand reader recognises
// atoms, literals, dotted references and operator expressions; a nested call, a list or record
// literal, a caret symbol or a parenthesised group is not an operand, so when gunbc#12145 stopped
// that reader narrowing a sequence to its left element -- which had answered `h(q: a)` with `h`
// and `[a]` with `[` -- every such argument became call_argument_unread and its whole module
// refused normalize. The value goes through body_lower_value_lowered, the reader field
// initializers and if-conditions use (the bottom-up fold, then the walker), and the operand reader
// only for what that declines; an argument neither reads is still a located refusal, and a
// refusal either raises is the argument's.
//
// A LIST LITERAL IN THE VALUE LOWERS WITH IT. An argument whose value is or contains `[e1, .., en]`
// once refused its whole module (body_lowering_reason_list_literal_unlowered), because body lowering
// had no lowered form for the literal. The literal's producer is now body_lower_list_literal, reached
// from body_lower_primary_expr, so the value reader below lowers it here exactly as in any other
// value position; no argument-specific list handling remains.
fn body_lower_arg_value_read(arg_capture: Node, value_capture: Node) -> Outcome<Node> {
  match body_lower_value_lowered(node: value_capture) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Present { value: lowered }, diagnostics: d } =>
      outcome_with_diagnostics(value: lowered, diagnostics: d)
    Accepted { value: Absent, diagnostics: _ } =>
      match body_lower_arg_operand_optional(arg_capture: value_capture) {
        Present { value: operand } => outcome_accepted(value: operand)
        Absent =>
          outcome_rejected(
            d: body_lower_diagnostic(reason: ^body_lowering_reason_call_argument_unread, n: arg_capture)
          )
      }
  }
}

fn body_lower_call_arg_value(arg_capture: Node) -> Outcome<Node> {
  if body_lower_call_arg_capture_is_named(arg_capture: arg_capture) {
    match body_lower_named_arg_value_capture_optional(arg_capture: arg_capture) {
      Present { value: value_capture } =>
        body_lower_arg_value_read(arg_capture: arg_capture, value_capture: value_capture)
      Absent =>
        outcome_rejected(
          d: body_lower_diagnostic(reason: ^body_lowering_reason_call_argument_unread, n: arg_capture)
        )
    }
  } else {
    body_lower_arg_value_read(arg_capture: arg_capture, value_capture: arg_capture)
  }
}

// THE COMMA-LIST SHAPE, READ ONCE. Every dag_grammar_comma_list_expr parse -- call arguments, field
// declarations, field patterns, field initializers, positional patterns, fn-type domains -- is
//   list   = sequence(first_item, sequence(repeat, optional trailing comma))
//   repeat = sequence(sequence(optional comma, item), repeat) | the empty conj
// and this walker reads that shape and nothing else, answering the raw item captures in order. Each
// consumer maps its own item. A position it cannot read refuses with the caller's shape cause, so
// call arguments keep body_lowering_reason_call_argument_list_shape_unread exactly as gunbc#12108
// introduced it. The walk was #12108's, fused with argument lowering; it is split out so field and
// pattern lists read the same shape through the same code instead of a second walker.
fn body_lower_comma_list_child(list: Node, name: Symbol, shape_refusal: Symbol) -> Outcome<Node> {
  match find_named_child(root: list, name: name) {
    Accepted { value: child, diagnostics: _ } =>
      outcome_accepted(value: body_lower_deep_unwrap_optional(node: child))
    Rejected { diagnostics: _ } =>
      outcome_rejected(d: body_lower_diagnostic(reason: shape_refusal, n: list))
  }
}

fn body_lower_comma_list_repeat_items(repeat_capture: Node, shape_refusal: Symbol) -> Outcome<List<Node>> {
  if is_empty_conj_root(n: repeat_capture) {
    outcome_accepted(value: Empty)
  } else {
    bind_outcome(
      o: body_lower_comma_list_child(list: repeat_capture, name: ^grammar_sequence_left_node_projection, shape_refusal: shape_refusal),
      f: fn(element) {
        bind_outcome(
          o: body_lower_comma_list_child(list: element, name: ^grammar_sequence_right_node_projection, shape_refusal: shape_refusal),
          f: fn(item) {
            bind_outcome(
              o: body_lower_comma_list_child(list: repeat_capture, name: ^grammar_sequence_right_node_projection, shape_refusal: shape_refusal),
              f: fn(rest) {
                bind_outcome(
                  o: body_lower_comma_list_repeat_items(repeat_capture: rest, shape_refusal: shape_refusal),
                  f: fn(items) { outcome_accepted(value: Cons { head: item, tail: items }) }
                )
              }
            )
          }
        )
      }
    )
  }
}

fn body_lower_comma_list_items(list_capture: Node, shape_refusal: Symbol) -> Outcome<List<Node>> {
  let list = body_lower_deep_unwrap_optional(node: list_capture)
  if is_empty_conj_root(n: list) {
    outcome_accepted(value: Empty)
  } else {
    bind_outcome(
      o: body_lower_comma_list_child(list: list, name: ^grammar_sequence_left_node_projection, shape_refusal: shape_refusal),
      f: fn(first) {
        bind_outcome(
          o: body_lower_comma_list_child(list: list, name: ^grammar_sequence_right_node_projection, shape_refusal: shape_refusal),
          f: fn(after_first) {
            bind_outcome(
              o: body_lower_comma_list_child(list: after_first, name: ^grammar_sequence_left_node_projection, shape_refusal: shape_refusal),
              f: fn(repeat_capture) {
                bind_outcome(
                  o: body_lower_comma_list_repeat_items(repeat_capture: repeat_capture, shape_refusal: shape_refusal),
                  f: fn(rest) { outcome_accepted(value: Cons { head: first, tail: rest }) }
                )
              }
            )
          }
        )
      }
    )
  }
}

// The consumers that refuse under their own cause read the shape through this adapter: Absent is
// "not a comma list", and each such caller already turns Absent into its own located refusal.
fn body_lower_comma_list_items_optional(list_capture: Node) -> Optional<List<Node>> {
  match body_lower_comma_list_items(list_capture: list_capture, shape_refusal: ^body_lowering_reason_call_argument_list_shape_unread) {
    Accepted { value: items, diagnostics: _ } => optional_present(value: items)
    Rejected { diagnostics: _ } => Absent
  }
}

// Call arguments: the shape is read first, then each argument lowers in order and the first that
// cannot refuses. (Before the split, a shape defect after an unreadable argument reported the
// argument first; with both present the shape refusal now reports first. Either is a refusal.)
fn body_lower_call_arg_values(items: List<Node>) -> Outcome<List<Node>> {
  match items {
    Empty => outcome_accepted(value: Empty)
    Cons { head: item, tail: rest } =>
      bind_outcome(
        o: body_lower_call_arg_value(arg_capture: item),
        f: fn(operand) {
          bind_outcome(
            o: body_lower_call_arg_values(items: rest),
            f: fn(operands) { outcome_accepted(value: Cons { head: operand, tail: operands }) }
          )
        }
      )
  }
}

fn body_lower_call_args_from_capture(args_capture: Node) -> Outcome<List<Node>> {
  bind_outcome(
    o: body_lower_comma_list_items(list_capture: args_capture, shape_refusal: ^body_lowering_reason_call_argument_list_shape_unread),
    f: fn(items) { body_lower_call_arg_values(items: items) }
  )
}

fn body_lower_primary_call_suffix_optional(root: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: root)
  match body_lower_postfix_call_suffix_args(call_suffix: stripped) {
    Present { value: _ } => optional_present(value: stripped)
    Absent =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_primary_call_suffix_optional(root: e.target)
        }
      })
  }
}

fn body_lower_call_sequence_node(node: Node) -> Node {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_primary_expr {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } => captured
          Absent => stripped
        }
      } else {
        stripped
      }
    Absent => stripped
  }
}

fn body_lower_call_callee_optional(node: Node) -> Optional<Node> {
  match body_lower_operand_ref_optional(node: node) {
    Absent => optional_absent()
    Present { value: callee } =>
      match node_atom_identity_optional(node: callee) {
        Present { value: id } =>
          if dag_lex_token_symbol(sym: id) {
            optional_absent()
          } else {
            optional_present(value: callee)
          }
        Absent => optional_present(value: callee)
      }
  }
}

fn body_lower_try_primary_ident_call(node: Node) -> Outcome<Optional<Node>> {
  let stripped = body_lower_call_sequence_node(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: pair } =>
      match body_lower_call_callee_optional(node: pair.left) {
        Absent => outcome_accepted(value: optional_absent())
        Present { value: callee_atom } =>
          match body_lower_primary_call_suffix_optional(root: pair.right) {
            Absent => outcome_accepted(value: optional_absent())
            Present { value: call_suffix } =>
              match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
                Present { value: args_read } =>
                  bind_outcome(
                    o: args_read,
                    f: fn(args) {
                      outcome_accepted(
                        value: optional_present(
                          value: body_lower_transform_call(
                            operator: callee_atom,
                            args: args
                          )
                        )
                      )
                    }
                  )
                Absent => outcome_accepted(value: optional_absent())
              }
          }
      }
  }
}

// Absent: not a call suffix. Present: a call suffix, whose arguments are read or refused.
fn body_lower_postfix_call_suffix_args(call_suffix: Node) -> Optional<Outcome<List<Node>>> {
  match sugar_sequence_pair_optional(node: call_suffix) {
    Absent => Absent
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Present { value: id } =>
          if id == ^dag_token_lparen {
            match sugar_sequence_pair_optional(node: pair.right) {
              Absent =>
                optional_present(
                  value: outcome_rejected(
                    d: body_lower_diagnostic(
                      reason: ^body_lowering_reason_call_argument_list_shape_unread,
                      n: call_suffix
                    )
                  )
                )
              Present { value: inner } =>
                optional_present(
                  value: body_lower_call_args_from_capture(
                    args_capture: body_lower_postfix_optional_unwrap(node: inner.left)
                  )
                )
            }
          } else {
            Absent
          }
        Absent => Absent
      }
  }
}

fn body_lower_postfix_projection_step(repeat_elem: Node) -> Optional<Symbol> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => Absent
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Present { value: id } =>
          if id == ^dag_token_dot {
            match sugar_sequence_pair_optional(node: pair.right) {
              Absent => Absent
              Present { value: after_dot } =>
                match body_lower_param_binding_optional(node: after_dot.left) {
                  Present { value: method } => optional_present(value: method)
                  Absent => Absent
                }
            }
          } else {
            Absent
          }
        Absent => Absent
      }
  }
}

// A DOTTED REFERENCE IS ONE MENTION, AND ITS LOWERED SHAPE IS THE QUALIFIED-NAME SPINE.
//
// `v2.test.p.value` in a body and `v2.test.p.T` in a type position are the same thing the language
// model already names for the module header and every hand-built resolver fixture: a qualified name,
// carried as the fold_list spine v2.std.qualified_name qualified_name_from_node folds and
// v2.compiler.resolve try_resolve_qualified_name_node resolves. Before these readers nothing in the
// v2 front end constructed that spine from source -- a body chain lowered to a two-operand infix
// over the first dot and a type-position chain to its first atom -- so the resolver's qualified arm
// and v2.compiler.reference_site_collector's qualified class had a consumer and no producer.
//
// LOWERING DOES NOT DECIDE WHAT THE CHAIN DENOTES. `r.v` over a parameter and `a.b.C` over a
// module path are one relation, syntactic containment (docs/plans/namespace-resolution-design.md
// section 3), and the resolver's unique-on-chain rule (section 13) resolves the FIRST segment on
// the ancestor chain and projects the rest. Deciding here would be a second resolver with no scope
// to consult. So every chain of bare segments lowers to the one spine, and the resolver is where
// the answer lives.
//
// WHAT THE RESOLVER ANSWERS TODAY, STATED AT ITS ACTUAL RUNG (reviews 67513, 67651 and 67708 on
// gunbc#11582): the spine REACHES try_resolve_qualified_name_node and every verdict it raises is a
// located refusal -- the module-path class is FOUND by the corpus-root absolute lookup and then
// refused identity-unrepresentable (a fn is a declaration, not a symbol, and the resolver carries
// no exact declaring identity yet); a chain whose head is bound on the ancestor chain refuses
// Unbound (the unique-on-chain projection is UNFIRED) or Ambiguous when the absolute read also
// hits (section 13's two binders), never the absolute read silently winning. Nothing Accepts a
// qualified chain today. Neither refusal is a regression of this arm: on the production route
// `r.v` never reached the projection refusal below -- the infix arm preempted it, lowered it to
// Transform(dot, r, v), and resolve refused the bare `v`. Both standings are enrolled in
// v2.test.claim.namespace_xl0.cross_module_reference_resolution; the local-receiver row there is a
// NEGATIVE control (`Bool` has no child `v`) and is retired by nothing. The lowering does not
// compensate by keeping a local-receiver chain out of the spine: that would be the second
// resolver this header refuses to be.
//
// THE SHAPE IS BUILT BY fold_list_node AND NOWHERE ELSE, so a spine label rename cannot fork the
// producer from the fold that reads it. The spine root carries the source occurrence, because the
// resolver's canonical atom takes its occurrence from the root it replaces; the segment atoms are
// the mention's spelling, not mentions of their own (the collector says the same).
//
// SCOPE, STATED SO THE NEXT CLASS IS NOT MISTAKEN FOR THIS ONE. The walk below admits a chain whose
// every suffix slot is EMPTY (the spine) and a chain whose LAST segment carries a CALL suffix
// (`a.b.f(x)`: a Transform whose operator is the spine, the call class
// gunbc.recurring_failure_mode call_expression_erased_at_v2_body_lowering read off the same walk).
// A call on a NON-final segment (`a.f().b`) is named by the walk and DECLINED: it is live corpus
// idiom the existing arms still erase (the receipt is on the class row; see DottedChainTailRead).
// A brace suffix (`a.b.C { f: v }`) and an `as` suffix answer Absent and the existing arms run
// unchanged for them.
fn body_lower_dotted_head_symbol_optional(node: Node) -> Optional<Symbol> {
  match node_atom_identity_optional(node: node) {
    Present { value: sym } =>
      if dag_lex_token_symbol(sym: sym) {
        optional_absent()
      } else {
        optional_present(value: sym)
      }
    Absent =>
      match parse_production_emitted_identity_optional(node: node) {
        Present { value: id } =>
          if id == ^dag_surface_primary_expr {
            match parse_production_captured_child_optional(node: node) {
              Present { value: captured } =>
                match sugar_sequence_pair_optional(node: captured) {
                  Present { value: pair } =>
                    if is_empty_conj_root(n: body_lower_postfix_optional_unwrap(node: pair.right)) {
                      body_lower_dotted_head_symbol_optional(node: pair.left)
                    } else {
                      optional_absent()
                    }
                  Absent => body_lower_dotted_head_symbol_optional(node: captured)
                }
              Absent => optional_absent()
            }
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

// ONE WALK OVER THE CHAIN'S TAIL, READ BY EVERY DOTTED READER. Every repeat element must be a
// dot-projection step; its suffix slot is either EMPTY (a bare segment) or a PAREN CALL (an
// argument row). Any other suffix kind -- a brace suffix `a.b.C { f: v }`, an `as` suffix -- is
// not this shape and the walk declines so the existing arms run unchanged.
//
// WHAT CHANGED HERE AND WHY (gunbc#12033's PR2, DESIGN 6b). The walk used to admit a call ONLY on
// the FINAL segment and answered DottedChainCallBeforeEnd for anything else, which the readers
// declined to the pre-existing arms. Those arms read ONE repeat element and then decided, so the
// declined chains lost everything after the first step: `shell.Env.Get(name: n).value` reached the
// old body_lower_try_postfix_projection, whose first element `.Env` carries no call suffix, and
// REFUSED postfix_field_access_refused; `fields.skip(n: i).first()` built Transform(skip, fields, i)
// and DROPPED `.first()` with no diagnostic at all. One boundary, two outcomes, and the silent one
// is the worse: DESIGN 4b puts silent wrongness below the ladder rather than on it. The repair is
// not a guard at either symptom -- it is that a postfix chain is a SEQUENCE of steps and was being
// read as one step. This walk now collects the whole sequence and body_lower_postfix_chain_fold
// folds it left-associatively, so both outcomes are removed by the same construction.
//
// A SECOND WALKER WOULD BE A SECOND AUTHORITY for "this is a dotted chain" (review 67903 on
// gunbc#11612 refused exactly that fork), so the operand reading, the spine reading and the
// general fold all consume THIS answer and differ only in what they build from it.
//
// A CAST IS A STEP OF THE SAME SEQUENCE. postfix_expr's repeat is choice(dot_suffix, as_suffix), so
// `a.b as T`, `(x as T).f` and `x as A as B` are chains whose steps interleave projections and
// casts, and the fold eliminates the accumulator with each in order: a cast step wraps what
// precedes it in the typed cast node (body_lower_cast_node). The step carries the AUTHORED type
// expression; the fold lowers it, and a type expression the lowering cannot read refuses
// body_lowering_reason_type_annotation_not_carried located at it, never dropped.
type PostfixStep
  = PostfixProjection { segment: Symbol, call_elem: Optional<Node> }
  | PostfixCast { target: Node }

// THE THIRD ARM CARRIES THE SUFFIX KINDS THIS LOWERING CANNOT READ. A dot-projection step whose
// suffix slot is neither empty nor a paren call -- today the BRACE suffix, the module-qualified
// record construction `a.b.C { f: v }`, and an `as` suffix -- reaches PostfixChainSuffixCarried.
// That shape is NOT lowered by this change: a construct's tag is a Symbol (v2.std.node_query
// construct_node) and a module-qualified tag has no representation in it, so lowering it would
// mean changing the construct shape, which is a wider package than this one. What the door DOES
// with this arm -- decline to the pre-existing arms and emit a counted head-grain advisory rather
// than refuse -- is stated once, on body_lower_postfix_chain_steps_grow below, and is not
// restated here.
//
// WHETHER EVERY STEP IS BARE IS DECIDED ONCE, BY THE READ (review 70331). The read already knows
// each step's suffix kind as it meets it, so it carries that fact in its accumulator
// (PostfixChainAcc) and answers PostfixChainBare with the segments alone when no step carries a
// call. A reader then MATCHES the arm, rather than a Bool predicate over each step's Optional
// re-deriving afterwards what the read had in hand.
type PostfixChainRead
  = PostfixChainBare { segments: List<Symbol> }
  | PostfixChainFound { steps: List<PostfixStep> }
  | PostfixChainNotThisShape
  | PostfixChainSuffixCarried { at: Node }

// AN UNLOWERED SUFFIX KIND DECLINES, IT DOES NOT REFUSE, AND THE PRECEDENT IS #11683's.
// Refusing a step suffix this lowering cannot read is the DESIGN section 5 reading, and it was
// MEASURED against the workload: it turned 32 modules that ACCEPT at base into refusals -- 28
// directly under the refusal, and 4 more as match_arm_navigation_refused, where the rejection
// propagated out of a match scrutinee and surfaced under a reason this change never touched.
// #11683 faced exactly this choice for the call-before-end class and declined for the same
// reason. So the brace suffix (`a.b.C { f: v }`, the module-qualified record construction) and
// the `as` suffix decline to the pre-existing arms and behave exactly as they do on base. Their
// erasure REMAINS and this package does not claim otherwise: the receipt is on
// gunbc.recurring_failure_mode call_expression_erased_at_v2_body_lowering, and lowering them
// needs a construct tag able to carry a qualified name, which is a wider package than this one.
//
// BUT THE DECLINE IS COUNTED, NOT SILENT, AND THAT IS WHAT KEEPS IT ON THE LADDER. Review 70078
// on gunbc#12057 found the gap this closes: on base these shapes reached a LOUD located refusal
// (postfix_field_access_refused, deleted here), so declining them silently would have moved the
// class from mitigatable to BELOW the ladder -- DESIGN section 4b's silent wrongness, which is
// forbidden outright rather than droppable. 8 of the 42 base-refusing files carry a brace suffix,
// so the population is real and not hypothetical. The door therefore declines to the existing
// arms AND emits body_lowering_reason_postfix_suffix_carried at HEAD grain, the same shape
// #12033 used for value_carried_unlowered: the file still Accepts, so no module that accepts on
// base regresses, and the residue is located and countable instead of vanishing.
fn body_lower_postfix_chain_steps_grow(
  repeat_capture: Node,
  grown: PostfixChainAcc
) -> PostfixChainRead {
  match body_lower_seq_child(node: repeat_capture, name: ^grammar_sequence_right_node_projection) {
    Present { value: rest_capture } =>
      body_lower_postfix_chain_steps_read(repeat_capture: rest_capture, acc: grown)
    Absent => body_lower_postfix_chain_acc_finish(acc: grown)
  }
}

// The read's accumulator: every step so far bare (the segments alone), or a call seen (the steps).
type PostfixChainAcc
  = PostfixChainAccBare { segments: List<Symbol> }
  | PostfixChainAccCalled { steps: List<PostfixStep> }

fn body_lower_postfix_bare_steps(segments: List<Symbol>) -> List<PostfixStep> {
  fold(segments, init: Empty, f: fn(acc, segment) {
    list_snoc_item(xs: acc, item: PostfixProjection { segment: segment, call_elem: optional_absent() })
  })
}

fn body_lower_postfix_chain_acc_bare_step(acc: PostfixChainAcc, segment: Symbol) -> PostfixChainAcc {
  match acc {
    PostfixChainAccBare { segments: segments } =>
      PostfixChainAccBare { segments: list_snoc_item(xs: segments, item: segment) }
    PostfixChainAccCalled { steps: steps } =>
      PostfixChainAccCalled {
        steps: list_snoc_item(xs: steps, item: PostfixProjection { segment: segment, call_elem: optional_absent() })
      }
  }
}

fn body_lower_postfix_chain_acc_call_step(
  acc: PostfixChainAcc,
  segment: Symbol,
  call_elem: Node
) -> PostfixChainAcc {
  let step = PostfixProjection { segment: segment, call_elem: optional_present(value: call_elem) }
  match acc {
    PostfixChainAccBare { segments: segments } =>
      PostfixChainAccCalled {
        steps: list_snoc_item(xs: body_lower_postfix_bare_steps(segments: segments), item: step)
      }
    PostfixChainAccCalled { steps: steps } =>
      PostfixChainAccCalled { steps: list_snoc_item(xs: steps, item: step) }
  }
}

// A cast closes a bare spine the way a call does: what follows it is a value, never a path segment.
fn body_lower_postfix_chain_acc_cast_step(acc: PostfixChainAcc, target: Node) -> PostfixChainAcc {
  let step = PostfixCast { target: target }
  match acc {
    PostfixChainAccBare { segments: segments } =>
      PostfixChainAccCalled {
        steps: list_snoc_item(xs: body_lower_postfix_bare_steps(segments: segments), item: step)
      }
    PostfixChainAccCalled { steps: steps } =>
      PostfixChainAccCalled { steps: list_snoc_item(xs: steps, item: step) }
  }
}

fn body_lower_postfix_chain_acc_finish(acc: PostfixChainAcc) -> PostfixChainRead {
  match acc {
    PostfixChainAccBare { segments: segments } => PostfixChainBare { segments: segments }
    PostfixChainAccCalled { steps: steps } => PostfixChainFound { steps: steps }
  }
}

fn body_lower_postfix_chain_steps_read(
  repeat_capture: Node,
  acc: PostfixChainAcc
) -> PostfixChainRead {
  if is_empty_conj_root(n: repeat_capture) {
    body_lower_postfix_chain_acc_finish(acc: acc)
  } else {
    match body_lower_postfix_repeat_head_optional(repeat_capture: repeat_capture) {
      Absent => PostfixChainNotThisShape
      Present { value: repeat_elem } =>
        match body_lower_as_suffix_type_optional(repeat_elem: repeat_elem) {
          Present { value: target } =>
            body_lower_postfix_chain_steps_grow(
              repeat_capture: repeat_capture,
              grown: body_lower_postfix_chain_acc_cast_step(acc: acc, target: target)
            )
          Absent =>
        match body_lower_postfix_projection_step(repeat_elem: repeat_elem) {
          Absent => PostfixChainNotThisShape
          Present { value: segment } =>
            match body_lower_postfix_suffix_read(repeat_elem: repeat_elem) {
              PostfixSuffixNone => PostfixChainNotThisShape
              PostfixSuffixUnlowered => PostfixChainSuffixCarried { at: repeat_elem }
              PostfixSuffixEmpty =>
                body_lower_postfix_chain_steps_grow(
                  repeat_capture: repeat_capture,
                  grown: body_lower_postfix_chain_acc_bare_step(acc: acc, segment: segment)
                )
              PostfixSuffixCall =>
                body_lower_postfix_chain_steps_grow(
                  repeat_capture: repeat_capture,
                  grown: body_lower_postfix_chain_acc_call_step(
                    acc: acc,
                    segment: segment,
                    call_elem: repeat_elem
                  )
                )
            }
        }
        }
    }
  }
}

fn body_lower_qualified_name_spine_node(segments: List<Symbol>, source: Node) -> Node {
  qualified_name_spine_node(qn: segments, occurrence_id: source.occurrence_id)
}

fn body_lower_postfix_chain_read(node: Node) -> PostfixChainRead {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => PostfixChainNotThisShape
    Present { value: pair } =>
      match body_lower_postfix_chain_steps_read(
        repeat_capture: pair.right,
        acc: PostfixChainAccBare { segments: Empty }
      ) {
        PostfixChainNotThisShape => PostfixChainNotThisShape
        PostfixChainSuffixCarried { at: at } => PostfixChainSuffixCarried { at: at }
        PostfixChainFound { steps: steps } => PostfixChainFound { steps: steps }
        PostfixChainBare { segments: segments } =>
          match segments {
            Empty => PostfixChainNotThisShape
            Cons { head: _, tail: _ } => PostfixChainBare { segments: segments }
          }
      }
  }
}

// The operand reader's presentation: the spine alone. A call is an expression, not
// an operand reference, and the expression sites read those through
// body_lower_dotted_chain_lowered_optional. A chain with a computed head is likewise not an
// operand reference: the head is an expression.
//
// WHERE THE CARRIED-SUFFIX RESIDUE IS COUNTED, AND WHERE IT IS NOT (review 70146, non-blocking).
// This reader answers PostfixChainSuffixCarried with optional_absent() and NO diagnostic: its
// Optional<Node> return has no slot for one, and its single caller
// (body_lower_operand_ref_optional) then falls back to reading the chain's HEAD, so a
// brace-suffixed chain reached ONLY through operand position is truncated silently rather than
// counted. The counting site is the expression door, which emits
// body_lowering_reason_postfix_suffix_carried once per occurrence; that is deliberate, because
// counting at both would double-count the same residue. NEITHER THE REVIEWER NOR THIS AUTHOR
// COULD CONSTRUCT A ROUTE where the operand reader is the SOLE reader of such a chain, so the
// gap is stated rather than closed: closing it means giving this reader an Outcome, which is a
// type change across every operand site and is not warranted for a route nobody can reach. If
// such a route is ever exhibited, this is the sentence that says what to do about it.
fn body_lower_dotted_reference_optional(node: Node) -> Optional<Node> {
  match body_lower_postfix_chain_read(node: node) {
    PostfixChainNotThisShape => optional_absent()
    PostfixChainSuffixCarried { at: _ } => optional_absent()
    PostfixChainFound { steps: _ } => optional_absent()
    PostfixChainBare { segments: segments } =>
      match body_lower_dotted_head_symbol_optional(
        node: body_lower_postfix_chain_head_or_self(node: node)
      ) {
        Absent => optional_absent()
        Present { value: head } =>
          optional_present(
            value: body_lower_qualified_name_spine_node(
              segments: Cons { head: head, tail: segments },
              source: node
            )
          )
      }
  }
}

fn body_lower_postfix_chain_head_or_self(node: Node) -> Node {
  let stripped = body_lower_unwrap_surface_shell(node: node)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => stripped
    Present { value: pair } => pair.left
  }
}

// THE ACCUMULATOR. A chain is read left to right and each step folds onto what precedes it.
// While no call has been seen and the head was a bare symbol the accumulator is a SPINE of
// segments -- that is today's contract, and it is kept exactly: `a.b.c` is one qualified name and
// v2.compiler.resolve try_resolve_qualified_name_node decides what its head denotes, because
// deciding here would be a second resolver with no scope to consult. The FIRST call suffix closes
// the spine into a Transform through it (`a.b.f(x)`: the whole path is the callee, today's
// final-segment rule applied to the prefix instead of only to the whole chain). After that the
// accumulator is a VALUE, and every further step is an elimination of it: a call suffix is a
// method call whose first operand is the accumulated value, an empty suffix is a FIELD PROJECTION
// (v2.std.node_query field_projection_node).
//
// WHY A PROJECTION OFF A VALUE CANNOT BE A SPINE CASE, which is the cheaper repair a reader will
// reach for: v2.std.qualified_name QualifiedName is FreeMonoid<Symbol>. It has no slot for a Node,
// so a computed root is not representable in it at all. This is a separate construct by the
// structure of the carrier, not by preference.
type PostfixAccum
  = PostfixAccumSpine { segments: List<Symbol> }
  | PostfixAccumValue { node: Node }

fn body_lower_postfix_accum_node(acc: PostfixAccum, source: Node) -> Node {
  match acc {
    PostfixAccumSpine { segments: segments } =>
      body_lower_qualified_name_spine_node(segments: segments, source: source)
    PostfixAccumValue { node: n } => n
  }
}

fn body_lower_postfix_chain_fold_step(
  acc: Outcome<PostfixAccum>,
  step: PostfixStep,
  source: Node
) -> Outcome<PostfixAccum> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: state, diagnostics: ad } =>
      match step {
        PostfixCast { target: target } =>
          match body_lower_type_expr_lowered_optional(node: target) {
            Absent => body_lower_postfix_cast_target_not_carried(at: target)
            Present { value: target_type } =>
              outcome_with_diagnostics(
                value: PostfixAccumValue {
                  node: body_lower_cast_node(
                    operand: body_lower_postfix_accum_node(acc: state, source: source),
                    target_type: target_type,
                    source: source
                  )
                },
                diagnostics: ad
              )
          }
        PostfixProjection { segment: step_segment, call_elem: step_call_elem } =>
      match step_call_elem {
        Absent =>
          match state {
            PostfixAccumSpine { segments: segments } =>
              outcome_with_diagnostics(
                value: PostfixAccumSpine {
                  segments: list_snoc_item(xs: segments, item: step_segment)
                },
                diagnostics: ad
              )
            PostfixAccumValue { node: base } =>
              outcome_with_diagnostics(
                value: PostfixAccumValue {
                  node: field_projection_node(base: base, field: step_segment, source: source)
                },
                diagnostics: ad
              )
          }
        Present { value: call_elem } =>
          match body_lower_postfix_projection_args(repeat_elem: call_elem) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: args, diagnostics: cd } =>
              match state {
                PostfixAccumSpine { segments: segments } =>
                  outcome_with_diagnostics(
                    value: PostfixAccumValue {
                      node: body_lower_transform_call(
                        operator: body_lower_qualified_name_spine_node(
                          segments: list_snoc_item(xs: segments, item: step_segment),
                          source: source
                        ),
                        args: args
                      )
                    },
                    diagnostics: diagnostics_merge(outer: ad, inner: cd)
                  )
                PostfixAccumValue { node: receiver } =>
                  outcome_with_diagnostics(
                    value: PostfixAccumValue {
                      node: body_lower_transform_call(
                        operator: body_lower_method_operator_atom(sym: step_segment),
                        args: list_append(left: [receiver], right: args)
                      )
                    },
                    diagnostics: diagnostics_merge(outer: ad, inner: cd)
                  )
              }
          }
      }
  }
      }
}

// THE ONE DOOR THE EXPRESSION SITES CONSULT, AND IT SITS ABOVE THE FIRST-ATOM FALLBACK. Its
// population is now EVERY postfix chain whose steps are dot projections with an empty or a paren
// call suffix -- the bare chain, the call through a path, the method on a value, the field off a
// computed receiver, and any interleaving of them. Nothing else claims a chain this door admits
// before it has answered. The order is the construction (review 67903 on gunbc#11612):
// body_lower_pattern_first_atom_optional, consulted first, claimed the chain's head atom and the
// rest of the chain vanished, so a guard beside the fallback asking "is this dotted?" would have
// been a second authority for what this reader already decides.
//
// A HEAD THE READER CANNOT LOWER IS DECLINED, NOT REFUSED, so the existing arms run unchanged for
// it and this change introduces no new refusal class. That is the honest statement of the
// remaining gap: an arbitrary parenthesised expression in head position is still read by whatever
// arm claims it, and body_lower_operand_ref_optional is the boundary of what this door admits as
// a computed head.
fn body_lower_dotted_chain_lowered_optional(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_postfix_chain_read(node: node) {
    PostfixChainNotThisShape =>
      if body_lower_postfix_chain_carries_as_suffix(node: node) {
        outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: node))
      } else {
        outcome_accepted(value: optional_absent())
      }
    PostfixChainSuffixCarried { at: at } =>
      if body_lower_postfix_chain_carries_as_suffix(node: node) {
        outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_postfix_suffix_carried, n: at))
      } else {
      outcome_with_diagnostics(
        value: optional_absent(),
        diagnostics: Some {
          diagnostics: diagnostics_singleton(
            d: body_lower_diagnostic(
              reason: ^body_lowering_reason_postfix_suffix_carried,
              n: at
            )
          )
        }
      )
      }
    PostfixChainBare { segments: segments } =>
      body_lower_postfix_chain_lowered_from_steps(
        node: node,
        steps: body_lower_postfix_bare_steps(segments: segments)
      )
    PostfixChainFound { steps: steps } =>
      body_lower_postfix_chain_lowered_from_steps(node: node, steps: steps)
  }
}

// The expression door's fold over a read chain, for either arm: the head is a spine segment when it
// is a bare name and a lowered value otherwise, and every step then eliminates the accumulator.
fn body_lower_postfix_chain_lowered_from_steps(
  node: Node,
  steps: List<PostfixStep>
) -> Outcome<Optional<Node>> {
  let head_node = body_lower_postfix_chain_head_or_self(node: node)
  match body_lower_postfix_chain_head_symbol_for_steps(head_node: head_node, steps: steps) {
    Present { value: head } =>
      body_lower_postfix_chain_fold_from(
        steps: steps,
        init: PostfixAccumSpine { segments: [head] },
        source: node
      )
    Absent =>
      match body_lower_operand_ref_optional(node: head_node) {
        Absent =>
          if body_lower_postfix_steps_carry_cast(steps: steps) {
            body_lower_postfix_cast_chain_computed_head(head_node: head_node, steps: steps, source: node)
          } else {
            outcome_accepted(value: optional_absent())
          }
        Present { value: head_value } =>
          body_lower_postfix_chain_fold_from(
            steps: steps,
            init: PostfixAccumValue { node: head_value },
            source: node
          )
      }
  }
}

// A CHAIN CARRYING A CAST NEVER DECLINES. Every arm after this door reads the primary and ignores
// the suffixes, so declining `g(v: x) as T` answered it with `g(v: x)` and dropped the cast --
// Accepted with no cast node (measured). A head the operand reader does not read (a call, a group)
// is lowered as the primary expression it is; a head that does not lower refuses with that
// lowering's own diagnostic.
fn body_lower_postfix_cast_chain_computed_head(
  head_node: Node,
  steps: List<PostfixStep>,
  source: Node
) -> Outcome<Optional<Node>> {
  match body_lower_primary_expr(shell: head_node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: head_value, diagnostics: hd } =>
      match body_lower_postfix_chain_fold_from(steps: steps, init: PostfixAccumValue { node: head_value }, source: source) {
        Rejected { diagnostics: r } => Rejected { diagnostics: rejected_with_pending(pending: hd, rejected: r) }
        Accepted { value: v, diagnostics: d } => outcome_with_diagnostics(value: v, diagnostics: diagnostics_merge(outer: hd, inner: d))
      }
  }
}

// A bare head starts a SPINE only when a projection follows it (`a.b`); a head cast directly
// (`x as T`) is an operand, read by the operand reader like any other value.
fn body_lower_postfix_chain_head_symbol_for_steps(head_node: Node, steps: List<PostfixStep>) -> Optional<Symbol> {
  match steps {
    Cons { head: first, tail: _ } =>
      match first {
        PostfixCast { target: _ } => optional_absent()
        PostfixProjection { segment: _, call_elem: _ } => body_lower_dotted_head_symbol_optional(node: head_node)
      }
    Empty => body_lower_dotted_head_symbol_optional(node: head_node)
  }
}

fn body_lower_postfix_cast_target_not_carried(at: Node) -> Outcome<PostfixAccum> {
  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_type_annotation_not_carried, n: at))
}

// THE OPERAND READERS' CAST DOOR. A postfix chain carrying a cast step is lowered whole through the
// chain fold (body_lower_dotted_chain_lowered_optional); any other node is not this reader's.
fn body_lower_cast_chain_read(node: Node) -> OperandRefRead {
  if body_lower_postfix_chain_carries_as_suffix(node: node) {
    match body_lower_dotted_chain_lowered_optional(node: node) {
      Rejected { diagnostics: r } => OperandRefRefused { diagnostics: r }
      Accepted { value: Present { value: lowered }, diagnostics: _ } => OperandRefLowered { lowered: lowered }
      Accepted { value: Absent, diagnostics: _ } =>
        OperandRefRefused {
          diagnostics: diagnostics_singleton(d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: node))
        }
    }
  } else {
    OperandRefAbsent
  }
}

fn body_lower_postfix_steps_carry_cast(steps: List<PostfixStep>) -> Bool {
  fold(steps, init: false, f: fn(acc, step) {
    acc || match step {
      PostfixCast { target: _ } => true
      PostfixProjection { segment: _, call_elem: _ } => false
    }
  })
}

// THE TYPED CAST NODE. `e as T` is Transform[kw_as, e] with the v2.std.type_binder <cast-target>
// edge -> T beside its positionals, appended after them. The operator is the surface token, as
// every lowered infix operator is; v2.compiler.resolve canonicalizes it to the coercion
// CanonicalOperation (v2.extdeps.languages.dag dag_surface_operator_canonicalization_lookup) and
// binds T in type role. The named edge is never an operand: readers take a Transform's operands
// through its positional children.
fn body_lower_cast_node(operand: Node, target_type: Node, source: Node) -> Node {
  node_synthetic(
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: body_lower_method_operator_atom(sym: ^dag_token_kw_as) },
      Edge { label: Positional, target: operand },
      cast_target_edge(target_type: target_type)
    ]
  )
}

fn body_lower_postfix_chain_fold_from(
  steps: List<PostfixStep>,
  init: PostfixAccum,
  source: Node
) -> Outcome<Optional<Node>> {
  match fold(steps, init: outcome_accepted(value: init), f: fn(acc, step) {
    body_lower_postfix_chain_fold_step(acc: acc, step: step, source: source)
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: state, diagnostics: d } =>
      outcome_with_diagnostics(
        value: optional_present(value: body_lower_postfix_accum_node(acc: state, source: source)),
        diagnostics: d
      )
  }
}

// The type-position twin: a dag_surface_qualified_name production with more than one segment
// lowers to the same spine. A single segment keeps the atom path above it, which is where the
// Int / Bool canonical bindings are applied.
fn body_lower_qualified_name_production_spine_optional(node: Node, captured: Node) -> Optional<Node> {
  match parse_qualified_name_segments_from_capture(qn_capture: captured, root: node) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: segments, diagnostics: _ } =>
      if length(xs: segments) > 1 {
        optional_present(value: body_lower_qualified_name_spine_node(segments: segments, source: node))
      } else {
        optional_absent()
      }
  }
}

fn body_lower_postfix_optional_unwrap(node: Node) -> Node {
  match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
    Accepted { value: child, diagnostics: _ } => child
    Rejected { diagnostics: _ } => node
  }
}

fn body_lower_postfix_method_suffix_optional(repeat_elem: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match sugar_sequence_pair_optional(node: stripped) {
    Absent => optional_absent()
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Present { value: id } =>
          if id == ^dag_token_dot {
            match sugar_sequence_pair_optional(node: pair.right) {
              Absent => optional_absent()
              Present { value: after_dot } =>
                optional_present(
                  value: body_lower_postfix_optional_unwrap(node: after_dot.right)
                )
            }
          } else {
            optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

// Called only where body_lower_postfix_projection_has_call_suffix holds or the dotted-chain walk
// has named the call element, so the two Absent arms are "no call here", not a lost argument.
fn body_lower_postfix_projection_args(repeat_elem: Node) -> Outcome<List<Node>> {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    Absent => outcome_accepted(value: Empty)
    Present { value: call_suffix } =>
      match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
        Present { value: args_read } => args_read
        Absent => outcome_accepted(value: Empty)
      }
  }
}

fn body_lower_postfix_projection_call_suffix_capture(repeat_elem: Node) -> Node {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    Absent => repeat_elem
    Present { value: call_suffix } => call_suffix
  }
}

// Kept for v2.lens.complexity_accumulator_copy.analyze, which reads it directly; the chain walk
// itself consumes body_lower_postfix_suffix_read below instead, because a boolean cannot separate
// an absent slot from an unlowered one.
fn body_lower_postfix_projection_has_call_suffix(repeat_elem: Node) -> Bool {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    Absent => false
    Present { value: call_suffix } =>
      match body_lower_postfix_call_suffix_args(call_suffix: call_suffix) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

// THE SUFFIX SLOT IS A THREE-WAY READ, AND COLLAPSING IT TO A BOOLEAN PAIR OVER-REFUSES.
// body_lower_dotted_suffix_slot_is_empty and body_lower_postfix_projection_has_call_suffix BOTH
// answer false when the slot is ABSENT, so "neither empty nor a call" conflates two different
// facts: a slot that is PRESENT carrying a suffix kind this lowering cannot read (the brace
// suffix `a.b.C { f: v }`, an `as` suffix), which must REFUSE, and NO SLOT AT ALL, which is
// simply not this shape and must DECLINE to the existing arms exactly as the pre-PR2 walk did.
// Measured: refusing the absent case as well took the workload from 0 to 103 refusing rows over
// ordinary modules -- src/v2/compiler/01_tokenize.dag, src/v2/std/artifact.dag and 101 others --
// which is DESIGN section 5 inverted, a decline widened into a refusal rather than a widen
// narrowed into one.
type PostfixSuffixRead
  = PostfixSuffixNone
  | PostfixSuffixEmpty
  | PostfixSuffixCall
  | PostfixSuffixUnlowered

// A PAREN CALL IS DECIDED BY THE ONE READER OF A CALL SUFFIX (#12108's comma-list route):
// body_lower_postfix_call_suffix_args answers Present exactly when the suffix opens with `(`,
// whether or not its argument list then reads. A malformed list is still a CALL here, so the fold
// reaches that reader and it refuses located rather than this read declining it.
fn body_lower_postfix_suffix_read(repeat_elem: Node) -> PostfixSuffixRead {
  match body_lower_postfix_method_suffix_optional(repeat_elem: repeat_elem) {
    Absent => PostfixSuffixNone
    Present { value: suffix } =>
      if is_empty_conj_root(n: suffix) {
        PostfixSuffixEmpty
      } else {
        match body_lower_postfix_call_suffix_args(call_suffix: suffix) {
          Present { value: _ } => PostfixSuffixCall
          Absent => PostfixSuffixUnlowered
        }
      }
  }
}

fn body_lower_postfix_repeat_head_optional(repeat_capture: Node) -> Optional<Node> {
  if is_empty_conj_root(n: repeat_capture) {
    optional_absent()
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: elem, diagnostics: _ } => optional_present(value: elem)
      Rejected { diagnostics: _ } =>
        match find_named_child(root: repeat_capture, name: ^grammar_repeat_element_node_projection) {
          Accepted { value: elem, diagnostics: _ } => optional_present(value: elem)
          Rejected { diagnostics: _ } => optional_absent()
        }
    }
  }
}

fn body_lower_match_arm_wire(pat_node: Node, body: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: match_arm_pattern }, target: pat_node },
      Edge { label: Named { name: match_arm_body }, target: body }
    ]
  )
}

// The same ordering as body_lower_operand_ref_optional: an int literal is read whole before the
// branded-atom arm, which would rebuild it without its magnitude (the postfix reduce reaches
// this reader for every literal operand).
fn body_lower_pattern_leaf_atom_optional(node: Node) -> Optional<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  match dag_node_is_int_literal_atom(node: stripped) {
    true => body_lower_int_literal_with_magnitude_optional(node: stripped)
    false =>
  match dag_binding_branded_atom_identity(node: stripped) {
    Present { value: binding } =>
      optional_present(value: body_lower_param_ref_atom(source: stripped, identity: binding))
    Absent =>
      match parse_production_emitted_identity_optional(node: stripped) {
        Present { value: emitted } =>
          match parse_production_captured_child_optional(node: stripped) {
            Present { value: captured } => body_lower_pattern_leaf_atom_optional(node: captured)
            Absent =>
              if emitted == ^dag_surface_pattern {
                fold(stripped.children, init: Absent, f: fn(acc, e) {
                  match acc {
                    Present { value: _ } => acc
                    Absent => body_lower_pattern_leaf_atom_optional(node: e.target)
                  }
                })
              } else {
                optional_absent()
              }
          }
        Absent =>
          match node_atom_identity_optional(node: stripped) {
            Present { value: id } =>
              if dag_lex_token_symbol(sym: id) {
                if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                  optional_present(value: body_lower_param_ref_atom(source: stripped, identity: id))
                } else {
                  body_lower_int_literal_with_magnitude_optional(node: stripped)
                }
              } else {
                optional_present(value: body_lower_param_ref_atom(source: stripped, identity: id))
              }
            Absent =>
              fold(stripped.children, init: Absent, f: fn(acc, e) {
                match acc {
                  Present { value: _ } => acc
                  Absent => body_lower_pattern_leaf_atom_optional(node: e.target)
                }
              })
          }
      }
  }
  }
}

fn body_lower_pattern_first_atom_optional(node: Node) -> Optional<Node> {
  match body_lower_pattern_leaf_atom_optional(node: node) {
    Present { value: atom } => Present { value: atom }
    Absent =>
      fold(node.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_pattern_first_atom_optional(node: e.target)
        }
      })
  }
}

fn body_lower_pattern_atom_optional(pattern_capture: Node) -> Optional<Node> {
  body_lower_pattern_first_atom_optional(node: pattern_capture)
}

fn body_lower_match_arm_navigation_reject(arm_capture: Node) -> Outcome<Node> {
  outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_match_arm_navigation_refused,
      n: arm_capture
    )
  )
}

fn body_lower_match_arm_body_capture_optional(stripped: Node) -> Optional<Node> {
  match body_lower_find_captured(root: stripped, emitted: ^dag_surface_expr) {
    ParseSubtreeFound { captured: expr } => optional_present(value: expr)
    ParseSubtreeAbsent =>
      match body_lower_find_captured(
        root: stripped,
        emitted: ^dag_surface_primary_expr
      ) {
        ParseSubtreeFound { captured: primary } => optional_present(value: primary)
        ParseSubtreeAbsent =>
          match body_lower_find_captured(
            root: stripped,
            emitted: ^dag_surface_postfix_expr
          ) {
            ParseSubtreeFound { captured: postfix } => optional_present(value: postfix)
            ParseSubtreeAbsent => optional_absent()
          }
      }
  }
}

fn body_lower_match_arm_body_optional(body_capture: Node) -> Optional<Node> {
  match body_lower_find_captured(root: body_capture, emitted: ^dag_surface_expr) {
    ParseSubtreeFound { captured: expr } => body_lower_operand_from_shell_optional(shell: expr)
    ParseSubtreeAbsent =>
      match parse_production_emitted_identity_optional(node: body_capture) {
        Present { value: emitted } =>
          if emitted == ^dag_surface_expr {
            match parse_production_captured_child_optional(node: body_capture) {
              Present { value: captured } =>
                body_lower_match_arm_body_optional(body_capture: captured)
              Absent => optional_absent()
            }
          } else if emitted == ^dag_surface_match_arm_stmt_body {
            match parse_production_captured_child_optional(node: body_capture) {
              Present { value: captured } =>
                body_lower_match_arm_body_optional(body_capture: captured)
              Absent => optional_absent()
            }
          } else {
            body_lower_operand_from_shell_optional(shell: body_capture)
          }
        Absent =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: body_capture)) {
            Present { value: id } =>
              if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                optional_present(
                  value: body_lower_param_ref_atom(source: body_capture, identity: id)
                )
              } else if dag_node_is_int_literal_atom(
                node: body_lower_deep_unwrap_optional(node: body_capture)
              ) {
                body_lower_int_literal_with_magnitude_optional(node: body_capture)
              } else if dag_lex_token_symbol(sym: id) {
                optional_absent()
              } else {
                optional_present(
                  value: body_lower_param_ref_atom(source: body_capture, identity: id)
                )
              }
            Absent => body_lower_operand_from_shell_optional(shell: body_capture)
          }
      }
  }
}

// A PATTERN LOWERS TO THE SHAPE IT ELIMINATES. A constructor pattern is
// seq(qualified_name, optional(`{` field_pattern,* `}` | `(` pattern,* `)`)). With no suffix it is
// the atom it always was (a nullary variant, a binder, or a literal -- which of the first two is
// the resolver's to decide, as in the seed's 04_patterns). With a suffix it is the CONSTRUCT
// (v2.std.node_query construct_node): the tag edge names the constructor, and each declared field
// the pattern names is a Named edge from that field to the sub-pattern it binds -- `A(x)` binds
// field "0" (v1.compiler.parse parse_variant_pattern), `A { v: x }` binds field v, and the
// shorthand `A { v }` binds field v to the binder v. So `Fnv1a64(left_structural) =>` lowers to
// Conj { Fnv1a64: Atom(Fnv1a64), 0: Atom(left_structural) }, the same shape the language
// authority's fixture pattern dag_variant_holds_pattern_node has, and the binder reaches the
// resolver instead of vanishing (the loss gunbc#11998 turned into
// body_lowering_reason_positional_pattern_binder_unlowered, retired here). Positional arity is
// one, as the seed's parse admits; more refuses with a located cause.
fn body_lower_pattern_reject<T>(pattern_capture: Node) -> Outcome<T> {
  outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_unlowered, n: pattern_capture)
  )
}

fn body_lower_field_pattern_edge(item: Node) -> Outcome<Edge> {
  let stripped = body_lower_deep_unwrap_optional(node: item)
  let captured = match parse_production_captured_child_optional(node: stripped) {
    Present { value: c } => c
    Absent => stripped
  }
  match sugar_sequence_pair_optional(node: captured) {
    Absent =>
      match body_lower_param_binding_optional(node: captured) {
        Present { value: field_name } =>
          outcome_accepted(
            value: Edge {
              label: Named { name: field_name },
              target: body_lower_param_ref_atom(source: captured, identity: field_name)
            }
          )
        Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_unlowered, n: item))
      }
    Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_unlowered, n: item))
        Present { value: field_name } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_pattern_unlowered, n: item))
            Present { value: after_colon } =>
              match body_lower_pattern_lowered(pattern_capture: after_colon.right) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: sub, diagnostics: d } =>
                  Accepted { value: Edge { label: Named { name: field_name }, target: sub }, diagnostics: d }
              }
          }
      }
  }
}

fn body_lower_pattern_field_edges(items: List<Node>, braced: Bool, witness: Node) -> Outcome<List<Edge>> {
  if braced {
    fold(items, init: outcome_accepted(value: Empty), f: fn(acc, item) {
      bind_outcome(o: acc, f: fn(edges) {
        bind_outcome(o: body_lower_field_pattern_edge(item: item), f: fn(e) {
          outcome_accepted(value: list_snoc_item(xs: edges, item: e))
        })
      })
    })
  } else {
    if count(items) == 1 {
      match list_at_optional(xs: items, index: 0) {
        Absent => body_lower_pattern_reject(pattern_capture: witness)
        Present { value: only } =>
          bind_outcome(o: body_lower_pattern_lowered(pattern_capture: only), f: fn(sub) {
            outcome_accepted(
              value: [Edge { label: Named { name: positional_payload_field_name() }, target: sub }]
            )
          })
      }
    } else {
      body_lower_pattern_reject(pattern_capture: witness)
    }
  }
}

fn body_lower_pattern_suffix_lowered(head: Node, suffix: Node, pattern_capture: Node) -> Outcome<Node> {
  match sugar_sequence_pair_optional(node: suffix) {
    Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
    Present { value: pair } =>
      match node_atom_identity_optional(node: pair.left) {
        Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
        Present { value: open } =>
          if (open == ^dag_token_lparen) || (open == ^dag_token_lbrace) {
            match sugar_sequence_pair_optional(node: pair.right) {
              Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
              Present { value: inner } =>
                match body_lower_comma_list_items_optional(list_capture: inner.left) {
                  Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
                  Present { value: items } =>
                    match body_lower_pattern_leaf_atom_optional(node: head) {
                      Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
                      Present { value: tag_atom } =>
                        match node_atom_identity_optional(node: tag_atom) {
                          Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
                          Present { value: tag } =>
                        bind_outcome(
                          o: body_lower_pattern_field_edges(
                            items: items,
                            braced: open == ^dag_token_lbrace,
                            witness: pattern_capture
                          ),
                          f: fn(edges) {
                            outcome_accepted(
                              value: construct_node(tag: tag, tag_source: tag_atom, field_edges: edges, source: pattern_capture)
                            )
                          }
                        )
                        }
                    }
                }
            }
          } else {
            body_lower_pattern_reject(pattern_capture: pattern_capture)
          }
      }
  }
}

fn body_lower_pattern_lowered(pattern_capture: Node) -> Outcome<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: pattern_capture)
  let captured = match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: id } =>
      if id == ^dag_surface_pattern {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: c } => c
          Absent => stripped
        }
      } else {
        stripped
      }
    Absent => stripped
  }
  match sugar_sequence_pair_optional(node: captured) {
    Present { value: pair } =>
      if is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
        match body_lower_pattern_atom_optional(pattern_capture: pair.left) {
          Present { value: atom } => outcome_accepted(value: atom)
          Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
        }
      } else {
        body_lower_pattern_suffix_lowered(
          head: pair.left,
          suffix: body_lower_deep_unwrap_optional(node: pair.right),
          pattern_capture: pattern_capture
        )
      }
    Absent =>
      match body_lower_pattern_atom_optional(pattern_capture: captured) {
        Present { value: atom } => outcome_accepted(value: atom)
        Absent => body_lower_pattern_reject(pattern_capture: pattern_capture)
      }
  }
}

// THE ARM BODY IS LOWERED BY THE BODY WALKER FIRST. The arm-body reader
// (body_lower_match_arm_body_optional) is an operand reader: it answers a nested `match` or `if`
// in arm position with that form's first atom (`dag_token_kw_if`), which is how every arm of
// std.content_hash compare_content_hash lost its inner match. body_lower_value_lowered enters
// the same walker the fn body itself is lowered by, so an arm body lowers as a body would; the
// operand reader stays as the fallback for the shapes the walker declines.
fn body_lower_match_arm_wire_from_sequence(stripped: Node) -> Outcome<Node> {
  match body_lower_find_captured(
    root: stripped,
    emitted: ^dag_surface_pattern
  ) {
    ParseSubtreeFound { captured: pat_capture } =>
      match body_lower_pattern_lowered(pattern_capture: pat_capture) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: pat_node, diagnostics: _ } =>
          match body_lower_match_arm_body_capture_optional(stripped: stripped) {
            Present { value: body_capture } =>
              match body_lower_value_lowered(node: body_capture) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: lowered_opt, diagnostics: d } =>
                  match lowered_opt {
                    Present { value: body } =>
                      outcome_with_diagnostics(
                        value: body_lower_match_arm_wire(pat_node: pat_node, body: body),
                        diagnostics: d
                      )
                    Absent =>
                      match body_lower_match_arm_body_optional(body_capture: body_capture) {
                        Present { value: body } =>
                          outcome_accepted(
                            value: body_lower_match_arm_wire(pat_node: pat_node, body: body)
                          )
                        Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
                      }
                  }
              }
            Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
          }
      }
    ParseSubtreeAbsent =>
      match body_lower_match_spine_left(spine: stripped) {
        Present { value: left } =>
          match body_lower_match_spine_right(spine: stripped) {
            Present { value: right } =>
              match body_lower_pattern_atom_optional(pattern_capture: left) {
                Present { value: pat_node } =>
                  match body_lower_match_spine_left(spine: right) {
                    Present { value: arrow_node } =>
                      match node_atom_identity_optional(node: arrow_node) {
                        Present { value: arrow } =>
                          if arrow == ^dag_token_fat_arrow {
                            match body_lower_match_spine_right(spine: right) {
                              Present { value: body_capture } =>
                                match body_lower_match_arm_body_optional(
                                  body_capture: body_capture
                                ) {
                                  Present { value: body } =>
                                    outcome_accepted(
                                      value: body_lower_match_arm_wire(
                                        pat_node: pat_node,
                                        body: body
                                      )
                                    )
                                  Absent =>
                                    body_lower_match_arm_navigation_reject(arm_capture: stripped)
                                }
                              Absent =>
                                body_lower_match_arm_navigation_reject(arm_capture: stripped)
                            }
                          } else {
                            body_lower_match_arm_navigation_reject(arm_capture: stripped)
                          }
                        Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
                      }
                    Absent =>
                      match sugar_sequence_pair_optional(node: right) {
                        Present { value: after_pattern } =>
                          match node_atom_identity_optional(node: after_pattern.left) {
                            Present { value: arrow } =>
                              if arrow == ^dag_token_fat_arrow {
                                match body_lower_match_arm_body_optional(
                                  body_capture: after_pattern.right
                                ) {
                                  Present { value: body } =>
                                    outcome_accepted(
                                      value: body_lower_match_arm_wire(
                                        pat_node: pat_node,
                                        body: body
                                      )
                                    )
                                  Absent =>
                                    body_lower_match_arm_navigation_reject(arm_capture: stripped)
                                }
                              } else {
                                body_lower_match_arm_navigation_reject(arm_capture: stripped)
                              }
                            Absent =>
                              body_lower_match_arm_navigation_reject(arm_capture: stripped)
                          }
                        Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
                      }
                  }
                Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
              }
            Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
          }
        Absent => body_lower_match_arm_navigation_reject(arm_capture: stripped)
      }
  }
}

fn body_lower_is_match_arm_navigate_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_pattern)
    || (emitted == ^dag_surface_primary_expr)
    || (emitted == ^dag_surface_match_arm_stmt_body)
    || body_lower_is_pass_through_emitted(emitted: emitted)
}

fn body_lower_match_arm_from_comma_repeat_elem(repeat_elem: Node) -> Outcome<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: repeat_elem)
  match sugar_sequence_pair_optional(node: stripped) {
    Present { value: pair } =>
      body_lower_wire_match_arm_capture(
        arm_capture: body_lower_postfix_optional_unwrap(node: pair.right)
      )
    Absent =>
      body_lower_wire_match_arm_capture(arm_capture: stripped)
  }
}

fn body_lower_extract_comma_list_arm_head(node: Node) -> Outcome<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  match body_lower_wire_match_arm_capture(arm_capture: stripped) {
    Rejected { diagnostics: _ } =>
      body_lower_match_arm_from_comma_repeat_elem(repeat_elem: stripped)
    Accepted { value: arm, diagnostics: d } =>
      Accepted { value: arm, diagnostics: d }
  }
}

fn body_lower_wire_match_arm_capture(arm_capture: Node) -> Outcome<Node> {
  let stripped = body_lower_deep_unwrap_optional(node: arm_capture)
  match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_match_arm {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } =>
            body_lower_wire_match_arm_capture(arm_capture: captured)
          Absent => body_lower_match_arm_wire_from_sequence(stripped: stripped)
        }
      } else if body_lower_is_match_arm_navigate_emitted(emitted: emitted) {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } =>
            body_lower_wire_match_arm_capture(arm_capture: captured)
          Absent => body_lower_match_arm_navigation_reject(arm_capture: arm_capture)
        }
      } else {
        body_lower_match_arm_navigation_reject(arm_capture: arm_capture)
      }
    Absent => body_lower_match_arm_wire_from_sequence(stripped: stripped)
  }
}

// A comma-list Repeat tail is Seq(Repeat(optional-comma + item), optional trailing comma).
// One arm leaves that Repeat empty (empty Conj) and the trailing comma Optional empty.
// Those nodes are skipped BEFORE extract, so an extract refusal is never discarded and an
// unknown shape never becomes "no arm here" (review 63228: default-true exhausted was a
// silent dropped arm). Skip is only: empty Conj, a comma atom, Optional whose element skips,
// or a sequence whose both sides skip. Anything else is handed to extract, and its Rejected stands.
fn body_lower_match_arm_repeat_elem_is_separator(node: Node) -> Bool {
  let stripped = body_lower_deep_unwrap_optional(node: node)
  if is_empty_conj_root(n: stripped) {
    true
  } else {
    match node_atom_identity_optional(node: stripped) {
      Present { value: id } => id == ^dag_token_comma
      Absent =>
        match sugar_sequence_pair_optional(node: stripped) {
          Present { value: pair } =>
            body_lower_match_arm_repeat_elem_is_separator(node: pair.left)
              && body_lower_match_arm_repeat_elem_is_separator(node: pair.right)
          Absent =>
            match find_named_child(
              root: stripped,
              name: ^grammar_optional_element_node_projection
            ) {
              Accepted { value: child, diagnostics: _ } =>
                body_lower_match_arm_repeat_elem_is_separator(node: child)
              Rejected { diagnostics: _ } => false
            }
        }
    }
  }
}

fn body_lower_collect_match_arms_from_repeat_tail(repeat_capture: Node) -> Outcome<List<Node>> {
  if is_empty_conj_root(n: repeat_capture) {
    outcome_accepted(value: Empty)
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: head, diagnostics: _ } =>
        if body_lower_match_arm_repeat_elem_is_separator(node: head) {
          match find_named_child(
            root: repeat_capture,
            name: ^grammar_sequence_right_node_projection
          ) {
            Accepted { value: tail, diagnostics: _ } =>
              body_lower_collect_match_arms_from_repeat_tail(repeat_capture: tail)
            Rejected { diagnostics: _ } => outcome_accepted(value: Empty)
          }
        } else {
          match body_lower_extract_comma_list_arm_head(node: head) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: arm, diagnostics: d } =>
              match find_named_child(
                root: repeat_capture,
                name: ^grammar_sequence_right_node_projection
              ) {
                Accepted { value: tail, diagnostics: _ } =>
                  match body_lower_collect_match_arms_from_repeat_tail(repeat_capture: tail) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: rest, diagnostics: rd } =>
                      Accepted {
                        value: list_append(left: [arm], right: rest),
                        diagnostics: diagnostics_merge(outer: d, inner: rd)
                      }
                  }
                Rejected { diagnostics: _ } =>
                  Accepted { value: [arm], diagnostics: d }
              }
          }
        }
      Rejected { diagnostics: _ } => outcome_accepted(value: Empty)
    }
  }
}

fn body_lower_collect_match_arms(sequence_capture: Node) -> Outcome<List<Node>> {
  let unwrapped = body_lower_postfix_optional_unwrap(node: sequence_capture)
  match find_named_child(root: unwrapped, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: first, diagnostics: _ } =>
      match body_lower_extract_comma_list_arm_head(node: first) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: arm, diagnostics: d } =>
          match find_named_child(root: unwrapped, name: ^grammar_sequence_right_node_projection) {
            Accepted { value: tail, diagnostics: _ } =>
              match body_lower_collect_match_arms_from_repeat_tail(repeat_capture: tail) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: rest, diagnostics: rd } =>
                  Accepted {
                    value: list_append(left: [arm], right: rest),
                    diagnostics: diagnostics_merge(outer: d, inner: rd)
                  }
              }
            Rejected { diagnostics: _ } =>
              Accepted { value: [arm], diagnostics: d }
          }
      }
    Rejected { diagnostics: _ } =>
      match sugar_sequence_pair_optional(node: unwrapped) {
        Present { value: pair } =>
          match body_lower_extract_comma_list_arm_head(node: pair.left) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: arm, diagnostics: d } =>
              match body_lower_after_comma_tail_optional(node: pair.right) {
                Present { value: tail } =>
                  match body_lower_collect_match_arms(sequence_capture: tail) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: rest, diagnostics: rd } =>
                      Accepted {
                        value: list_append(left: [arm], right: rest),
                        diagnostics: diagnostics_merge(outer: d, inner: rd)
                      }
                  }
                Absent => Accepted { value: [arm], diagnostics: d }
              }
          }
        Absent =>
          match body_lower_extract_comma_list_arm_head(node: unwrapped) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: arm, diagnostics: d } =>
              Accepted { value: [arm], diagnostics: d }
          }
      }
  }
}

fn body_lower_reify_branch_target(node: Node) -> Node {
  match body_lower_materialize_int_literal_operand_optional(node: node) {
    Present { value: reified } => reified
    Absent =>
      match body_lower_literal_bool_atom_optional(node: node) {
        Present { value: reified } => reified
        Absent =>
          match body_lower_reify_operand_node(node: node) {
            Present { value: reified } => reified
            Absent => node
          }
      }
  }
}

fn body_lower_reify_branch_body(body: Node) -> Outcome<Node> {
  match body.kind {
    ComputationNode { behavior: Branch } =>
      match fold(body.children, init: outcome_accepted(value: Empty), f: fn(acc, e) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: done, diagnostics: d } =>
            outcome_with_diagnostics(
              value: list_snoc_item(
                xs: done,
                item: Edge {
                  label: e.label,
                  target: body_lower_reify_branch_target(node: e.target)
                }
              ),
              diagnostics: d
            )
        }
      }) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: children, diagnostics: d } =>
          outcome_with_diagnostics(
            value: node_synthetic(
              kind: ComputationNode { behavior: Branch },
              children: children
            ),
            diagnostics: d
          )
      }
    _ => outcome_accepted(value: body)
  }
}

fn body_lower_reify_arrow_body(body: Node) -> Outcome<Node> {
  match body.kind {
    ComputationNode { behavior: Transform } => body_lower_reify_transform_body(body: body)
    ComputationNode { behavior: Branch } => body_lower_reify_branch_body(body: body)
    _ => outcome_accepted(value: body)
  }
}

fn body_lower_if_navigation_reject<T>(captured: Node) -> Outcome<T> {
  outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_if_navigation_refused,
      n: captured
    )
  )
}

fn body_lower_materialize_int_literal_operand_optional(node: Node) -> Optional<Node> {
  match body_lower_int_literal_with_magnitude_optional(node: node) {
    Present { value: lit } => Present { value: lit }
    Absent =>
      match body_lower_literal_int_atom_optional(node: node) {
        Present { value: lit } => Present { value: lit }
        Absent =>
          match body_lower_unwrap_captured(shell: node) {
            Present { value: captured } =>
              body_lower_materialize_int_literal_operand_optional(node: captured)
            Absent =>
              let deep = body_lower_deep_unwrap_for_int_literal(node: node)
              match node_atom_identity_optional(node: deep) {
                Present { value: id } =>
                  match dag_node_is_int_literal_atom(node: deep) {
                    true =>
                      body_lower_int_literal_with_magnitude_optional(node: deep)
                    false =>
                      match integer_string_to_decimal_digits_optional(s: symbol_lexeme(sym: id)) {
                        Present { value: _ } =>
                          match dag_int_literal_node_from_lexeme(
                            lexeme: symbol_lexeme(sym: id),
                            occurrence_id: node.occurrence_id
                          ) {
                            Accepted { value: lit, diagnostics: _ } => optional_present(value: lit)
                            Rejected { diagnostics: _ } => optional_absent()
                          }
                        Absent => optional_absent()
                      }
                  }
                Absent => optional_absent()
              }
          }
      }
  }
}

// A refused operand under the arm is the arm's refusal (OperandRefRefused), never Absent: a caller
// that heard Absent tried the next reader, and the first-atom search behind it answered a part of the
// arm for the whole -- `b && (u)` read as `b`.
// A CAST IS READ WHOLE, NEVER AS ITS OPERAND: a reader that answered `x as Q` with `x` dropped `Q`
// (gunbc.recurring_failure_mode as_cast_has_no_lowered_form). The arm's postfix chain is lowered
// through the one chain fold, which builds the typed cast node or refuses at the authored type.
fn body_lower_arm_operand_resolved_read(arm: Node) -> OperandRefRead {
  match body_lower_find_captured(root: arm, emitted: ^dag_surface_postfix_expr) {
    ParseSubtreeFound { captured: postfix } =>
      match body_lower_cast_chain_read(node: postfix) {
        OperandRefAbsent => body_lower_arm_operand_resolved_uncast_read(arm: arm)
        OperandRefLowered { lowered: l } => OperandRefLowered { lowered: l }
        OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
      }
    ParseSubtreeAbsent => body_lower_arm_operand_resolved_uncast_read(arm: arm)
  }
}

fn body_lower_arm_operand_resolved_uncast_read(arm: Node) -> OperandRefRead {
  match body_lower_materialize_int_literal_operand_optional(node: arm) {
    Present { value: lit } => OperandRefLowered { lowered: lit }
    Absent =>
      match body_lower_literal_bool_atom_optional(node: arm) {
        Present { value: b } => OperandRefLowered { lowered: b }
        Absent =>
          match body_lower_operand_from_shell_read(shell: arm) {
            OperandRefLowered { lowered: op } =>
              match body_lower_materialize_int_literal_operand_optional(node: op) {
                Present { value: lit } => OperandRefLowered { lowered: lit }
                Absent =>
                  match body_lower_int_literal_with_magnitude_optional(node: op) {
                    Present { value: lit } => OperandRefLowered { lowered: lit }
                    Absent =>
                      if dag_node_is_int_literal_atom(
                        node: body_lower_deep_unwrap_for_int_literal(node: op)
                      ) {
                        OperandRefAbsent
                      } else {
                        OperandRefLowered { lowered: op }
                      }
                  }
              }
            OperandRefAbsent => OperandRefAbsent
            OperandRefRefused { diagnostics: r } => OperandRefRefused { diagnostics: r }
          }
      }
  }
}

fn body_lower_arm_operand_resolved_optional(arm: Node) -> Optional<Node> {
  body_lower_operand_ref_read_optional(read: body_lower_arm_operand_resolved_read(arm: arm))
}

fn body_lower_if_arm_operand_optional(arm_capture: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: arm_capture) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_if_expr {
        match body_lower_unwrap_captured(shell: arm_capture) {
          Present { value: captured } =>
            match body_lower_try_if_from_captured(captured: captured) {
              Rejected { diagnostics: _ } => Absent
              Accepted { value: lowered_opt, diagnostics: _ } =>
                match lowered_opt {
                  Present { value: lowered } => Present { value: lowered }
                  Absent => Absent
                }
            }
          Absent => Absent
        }
      } else if emitted == ^dag_surface_fn_body {
        match body_lower_find_production_shell_optional(
          root: arm_capture,
          emitted: ^dag_surface_stmt
        ) {
          Present { value: shell } =>
            body_lower_operand_from_shell_optional(shell: shell)
          Absent =>
            match body_lower_find_production_shell_optional(
              root: arm_capture,
              emitted: ^dag_surface_expr
            ) {
              Present { value: shell } =>
                body_lower_operand_from_shell_optional(shell: shell)
              Absent =>
                match body_lower_find_production_shell_optional(
                  root: arm_capture,
                  emitted: ^dag_surface_primary_expr
                ) {
                  Present { value: shell } =>
                    body_lower_operand_from_shell_optional(shell: shell)
                  Absent =>
                    body_lower_match_arm_body_optional(body_capture: arm_capture)
                }
            }
        }
      } else {
        body_lower_match_arm_body_optional(body_capture: arm_capture)
      }
    Absent => body_lower_match_arm_body_optional(body_capture: arm_capture)
  }
}

fn body_lower_if_expr_capture_optional(spine: Node) -> Optional<Node> {
  match body_lower_find_captured(root: spine, emitted: ^dag_surface_expr) {
    ParseSubtreeFound { captured: expr } => Present { value: expr }
    ParseSubtreeAbsent =>
      if is_empty_conj_root(n: spine) {
        Absent
      } else {
        match body_lower_match_spine_left(spine: spine) {
          Present { value: left } =>
            match body_lower_match_spine_right(spine: spine) {
              Present { value: right } =>
                match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
                  Present { value: id } =>
                    match (id == ^dag_token_kw_if) || (id == ^dag_token_kw_then) || (id == ^dag_token_kw_else) {
                      true => body_lower_if_expr_capture_optional(spine: right)
                      false =>
                        match body_lower_if_expr_capture_optional(spine: left) {
                          Present { value: found } => Present { value: found }
                          Absent => body_lower_if_expr_capture_optional(spine: right)
                        }
                    }
                  Absent =>
                    match body_lower_if_expr_capture_optional(spine: left) {
                      Present { value: found } => Present { value: found }
                      Absent => body_lower_if_expr_capture_optional(spine: right)
                    }
                }
              Absent => Absent
            }
          Absent => Absent
        }
      }
  }
}

fn body_lower_if_fn_body_capture_optional(spine: Node) -> Optional<Node> {
  match body_lower_find_captured(root: spine, emitted: ^dag_surface_fn_body) {
    ParseSubtreeFound { captured: body } => Present { value: body }
    ParseSubtreeAbsent =>
      if is_empty_conj_root(n: spine) {
        Absent
      } else {
        match body_lower_match_spine_left(spine: spine) {
          Present { value: left } =>
            match body_lower_match_spine_right(spine: spine) {
              Present { value: right } =>
                match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
                  Present { value: id } =>
                    match id == ^dag_token_kw_else {
                      true => body_lower_if_fn_body_capture_optional(spine: right)
                      false =>
                        match body_lower_if_fn_body_capture_optional(spine: left) {
                          Present { value: found } => Present { value: found }
                          Absent => body_lower_if_fn_body_capture_optional(spine: right)
                        }
                    }
                  Absent =>
                    match body_lower_if_fn_body_capture_optional(spine: left) {
                      Present { value: found } => Present { value: found }
                      Absent => body_lower_if_fn_body_capture_optional(spine: right)
                    }
                }
              Absent => Absent
            }
          Absent => Absent
        }
      }
  }
}

fn body_lower_if_then_fn_body_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_if_fn_body_capture_optional(spine: spine) {
    Present { value: first } =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_fn_body) {
        ParseSubtreeFound { captured: only } => Present { value: only }
        ParseSubtreeAbsent => Present { value: first }
      }
    Absent => Absent
  }
}

// AN `else if` ARM IS ANSWERED AS ITS if_expr SHELL, so body_lower_if_arm_lowered can see it is an
// if and lower it whole. Answering the shell's captured content instead hid the if_expr identity, and
// the arm's statement-sequence search found the nested then-arm: `if a { b } else if c { d } else { u }`
// lowered to Branch(a, b, d), and both the nested condition and its else reached no reference site.
fn body_lower_if_else_capture_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match is_empty_conj_root(n: spine) {
    true => Absent
    false =>
      match body_lower_match_spine_left(spine: spine) {
      Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              Present { value: id } =>
                match id == ^dag_token_kw_else {
                  true =>
                    match body_lower_find_production_shell_optional(root: right, emitted: ^dag_surface_if_expr) {
                      Present { value: nested } => Present { value: nested }
                      Absent =>
                        match body_lower_if_fn_body_capture_optional(spine: right) {
                          Present { value: body } => Present { value: body }
                          Absent =>
                            match body_lower_if_expr_capture_optional(spine: right) {
                              Present { value: expr } => Present { value: expr }
                              Absent => Absent
                            }
                        }
                    }
                  false =>
                    match body_lower_if_else_capture_optional(captured: left) {
                      Present { value: found } => Present { value: found }
                      Absent => body_lower_if_else_capture_optional(captured: right)
                    }
                }
              Absent =>
                match body_lower_if_else_capture_optional(captured: left) {
                  Present { value: found } => Present { value: found }
                  Absent => body_lower_if_else_capture_optional(captured: right)
                }
            }
          Absent => Absent
        }
      Absent =>
        fold(spine.children, init: Absent, f: fn(acc, e) {
          match acc {
            Present { value: _ } => acc
            Absent => body_lower_if_else_capture_optional(captured: e.target)
          }
        })
      }
  }
}

fn body_lower_if_condition_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match is_empty_conj_root(n: spine) {
    true => Absent
    false =>
      match body_lower_match_spine_left(spine: spine) {
      Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              Present { value: id } =>
                match id == ^dag_token_kw_if {
                  true => body_lower_if_expr_capture_optional(spine: right)
                  false =>
                    match body_lower_if_condition_optional(captured: left) {
                      Present { value: found } => Present { value: found }
                      Absent => body_lower_if_condition_optional(captured: right)
                    }
                }
              Absent =>
                match body_lower_operand_ref_optional(node: left) {
                  Present { value: op } => Present { value: op }
                  Absent =>
                    match body_lower_if_condition_optional(captured: left) {
                      Present { value: found } => Present { value: found }
                      Absent => body_lower_if_condition_optional(captured: right)
                    }
                }
            }
          Absent => Absent
        }
      Absent => body_lower_if_expr_capture_optional(spine: spine)
      }
  }
}

fn body_lower_if_then_arm_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_find_captured(root: spine, emitted: ^dag_surface_fn_body) {
    ParseSubtreeFound { captured: body } => Present { value: body }
    ParseSubtreeAbsent =>
      match body_lower_if_then_fn_body_optional(captured: captured) {
        Present { value: body } => Present { value: body }
        Absent =>
          match body_lower_match_spine_left(spine: spine) {
            Present { value: left } =>
              match body_lower_match_spine_right(spine: spine) {
                Present { value: right } =>
                  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
                    Present { value: id } =>
                      match id == ^dag_token_kw_then {
                        true => body_lower_if_expr_capture_optional(spine: right)
                        false =>
                          match body_lower_if_then_arm_optional(captured: left) {
                            Present { value: found } => Present { value: found }
                            Absent => body_lower_if_then_arm_optional(captured: right)
                          }
                      }
                    Absent =>
                      match body_lower_if_then_arm_optional(captured: left) {
                        Present { value: found } => Present { value: found }
                        Absent => body_lower_if_then_arm_optional(captured: right)
                      }
                  }
                Absent => Absent
              }
            Absent => Absent
          }
      }
  }
}

fn body_lower_loop_navigation_reject(captured: Node) -> Outcome<Optional<Node>> {
  outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_loop_navigation_refused,
      n: captured
    )
  )
}

fn body_lower_let_navigation_reject(captured: Node) -> Outcome<Optional<Node>> {
  outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_let_navigation_refused,
      n: captured
    )
  )
}

fn body_lower_let_in_body_capture_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            Present { value: id } =>
              if id == ^dag_token_kw_in {
                optional_present(value: right)
              } else {
                match body_lower_let_in_body_capture_optional(captured: left) {
                  Present { value: found } => optional_present(value: found)
                  Absent =>
                    match body_lower_let_in_body_capture_optional(captured: right) {
                      Present { value: found } => optional_present(value: found)
                      Absent => optional_absent()
                    }
                }
              }
            Absent =>
              match body_lower_let_in_body_capture_optional(captured: left) {
                Present { value: found } => optional_present(value: found)
                Absent => body_lower_let_in_body_capture_optional(captured: right)
              }
          }
        Absent => body_lower_let_in_body_capture_optional(captured: left)
      }
    Absent =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } =>
          match body_lower_let_in_body_capture_optional(captured: pair.left) {
            Present { value: found } => optional_present(value: found)
            Absent => body_lower_let_in_body_capture_optional(captured: pair.right)
          }
        Absent =>
          fold(spine.children, init: optional_absent(), f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lower_let_in_body_capture_optional(captured: e.target)
            }
          })
      }
  }
}

fn body_lower_let_in_prefix_before_in_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            Present { value: id } =>
              if id == ^dag_token_kw_in {
                optional_absent()
              } else {
                match body_lower_let_in_prefix_before_in_optional(captured: left) {
                  Present { value: found } => optional_present(value: found)
                  Absent =>
                    match body_lower_let_in_prefix_before_in_optional(captured: right) {
                      Present { value: found } => optional_present(value: found)
                      Absent => optional_present(value: captured)
                    }
                }
              }
            Absent =>
              match body_lower_let_in_prefix_before_in_optional(captured: left) {
                Present { value: found } => Present { value: found }
                Absent => body_lower_let_in_prefix_before_in_optional(captured: right)
              }
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn body_lower_let_in_value_capture_optional(captured: Node) -> Optional<Node> {
  match body_lower_let_in_prefix_before_in_optional(captured: captured) {
    Absent => Absent
    Present { value: prefix } =>
      let spine = body_lower_unwrap_surface_shell(node: prefix)
      match body_lower_match_spine_left(spine: spine) {
        Present { value: left } =>
          match body_lower_match_spine_right(spine: spine) {
            Present { value: right } =>
              match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
                Present { value: id } =>
                  if id == ^dag_token_eq {
                    optional_present(value: right)
                  } else {
                    body_lower_let_in_value_capture_optional(captured: right)
                  }
                Absent => body_lower_let_in_value_capture_optional(captured: right)
              }
            Absent => Absent
          }
        Absent => Absent
      }
  }
}

// The binding name is the FIRST element of what follows `let` -- `let NAME = value` -- read off
// that position, never off the operand reader: body_lower_operand_ref_optional no longer narrows a
// sequence to its left element, which is what this reader used to lean on to find NAME.
fn body_lower_let_name_position(after_let: Node) -> Node {
  match sugar_sequence_pair_optional(node: after_let) {
    Present { value: pair } => pair.left
    Absent => after_let
  }
}

fn body_lower_let_in_key_binding_optional(captured: Node) -> Optional<Symbol> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            Present { value: id } =>
              if id == ^dag_token_kw_let {
                match body_lower_param_binding_optional(node: body_lower_let_name_position(after_let: right)) {
                  Present { value: binding } => Present { value: binding }
                  Absent =>
                    match dag_binding_branded_atom_identity(node: right) {
                      Present { value: binding } => Present { value: binding }
                      Absent => Absent
                    }
                }
              } else {
                match body_lower_let_in_key_binding_optional(captured: left) {
                  Present { value: found } => Present { value: found }
                  Absent => body_lower_let_in_key_binding_optional(captured: right)
                }
              }
            Absent =>
              match body_lower_let_in_key_binding_optional(captured: left) {
                Present { value: found } => Present { value: found }
                Absent => body_lower_let_in_key_binding_optional(captured: right)
              }
          }
        Absent =>
          match body_lower_let_in_key_binding_optional(captured: left) {
            Present { value: found } => Present { value: found }
            Absent => Absent
          }
      }
    Absent =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } =>
          match body_lower_let_in_key_binding_optional(captured: pair.left) {
            Present { value: found } => Present { value: found }
            Absent => body_lower_let_in_key_binding_optional(captured: pair.right)
          }
        Absent =>
          fold(spine.children, init: Absent, f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => body_lower_let_in_key_binding_optional(captured: e.target)
            }
          })
      }
  }
}

fn body_lower_try_let_in_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_let_in_body_capture_optional(captured: captured) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: _ } =>
    match body_lower_let_in_key_binding_optional(captured: captured) {
      Present { value: key_binding } =>
        match body_lower_let_in_value_capture_optional(captured: captured) {
          Present { value: value_capture } =>
            match body_lower_let_in_body_capture_optional(captured: captured) {
              Present { value: body_capture } =>
                match body_lower_materialize_int_literal_operand_optional(node: value_capture) {
                  Present { value: value } =>
                    match body_lower_operand_ref_optional(node: body_capture) {
                      Present { value: body_ref } =>
                        outcome_accepted(
                          value: optional_present(
                            value: lower_bind(
                              key_binding: body_lower_type_atom_node(sym: key_binding, source: captured),
                              value: value,
                              body_binding: body_ref
                            )
                          )
                        )
                      Absent =>
                        match body_lower_arm_operand_resolved_optional(arm: body_capture) {
                          Present { value: body_ref } =>
                            outcome_accepted(
                              value: optional_present(
                                value: lower_bind(
                                  key_binding: body_lower_type_atom_node(sym: key_binding, source: captured),
                                  value: value,
                                  body_binding: body_ref
                                )
                              )
                            )
                          Absent => body_lower_let_navigation_reject(captured: captured)
                        }
                    }
                  Absent =>
                    match body_lower_arm_operand_resolved_optional(arm: value_capture) {
                      Present { value: value } =>
                        match body_lower_operand_ref_optional(node: body_capture) {
                          Present { value: body_ref } =>
                            outcome_accepted(
                              value: optional_present(
                                value: lower_bind(
                                  key_binding: body_lower_type_atom_node(sym: key_binding, source: captured),
                                  value: value,
                                  body_binding: body_ref
                                )
                              )
                            )
                          Absent =>
                            match body_lower_arm_operand_resolved_optional(arm: body_capture) {
                              Present { value: body_ref } =>
                                outcome_accepted(
                                  value: optional_present(
                                    value: lower_bind(
                                      key_binding: body_lower_type_atom_node(sym: key_binding, source: captured),
                                      value: value,
                                      body_binding: body_ref
                                    )
                                  )
                                )
                              Absent => body_lower_let_navigation_reject(captured: captured)
                            }
                        }
                      Absent => body_lower_let_navigation_reject(captured: captured)
                    }
                }
              Absent => body_lower_let_navigation_reject(captured: captured)
            }
          Absent => body_lower_let_navigation_reject(captured: captured)
        }
      Absent => body_lower_let_navigation_reject(captured: captured)
    }
  }
}

fn body_lower_try_let_in_from_node(node: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_let_expr {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } =>
            body_lower_try_let_in_from_captured(captured: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: emitted) {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } => body_lower_try_let_in_from_node(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent => outcome_accepted(value: optional_absent())
  }
}

fn body_lower_try_loop_expr_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  body_lower_try_loop_keyword_from_captured(captured: captured)
}

fn body_lower_try_loop_expr_from_node(node: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_loop_expr {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } =>
            body_lower_try_loop_expr_from_captured(captured: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: emitted) {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } => body_lower_try_loop_expr_from_node(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent => outcome_accepted(value: optional_absent())
  }
}

fn body_lower_loop_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_try_loop_expr_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              Accepted { value: lowered, diagnostics: d }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

// TWO REFUSALS, TWO CAUSES. This function had ONE reason standing over two
// states whose remedies differ, and that conflation is what made the
// boundary-4 door read as a malformed-input defect for as long as it did:
//
//   - a let node with NO captured child is malformed, and unsupported_form is
//     the honest cause;
//   - a WELL-FORMED statement-form let reaching here alone is not malformed at
//     all. Its body is its enclosing statement spine's remainder, which this
//     node cannot see, so the absence reported by body_lower_try_let_in_from_captured
//     is "not lowerable FROM HERE", not "not lowerable".
//
// The statement form is lowered at dag_surface_stmt_seq, where both halves of
// the Bind are visible (body_lower_stmt_spine). Reaching this arm therefore
// means a statement-form let was met outside a statement spine, and the
// diagnostic now says so rather than accusing the source of being malformed.
//
// This is #8801's split (FoldCallStepFormUnresolved vs FoldCallStepShapeInvalid)
// on the neighbouring form. It is spelled as two reasons rather than as a
// four-state coproduct with a two-state projection because there is exactly
// ONE consumer of this result and it does not branch on the distinction --
// only the diagnostic does. A coproduct whose sole consumer immediately
// collapses it would be a second representation of a fact the reason symbol
// already carries.
// A LET ANNOTATION BODY LOWERING CANNOT CARRY REFUSES; IT IS NEVER DROPPED. `let y: T = e` lowers
// to Bind[binder, value, body], which has no position for `T`, so dropping the annotation made it
// invisible to v2.compiler.resolve and `let y: Q = x` was Accepted with `Q` declared nowhere
// (gunbc.recurring_failure_mode body_type_annotation_dropped_before_resolve_in_v2). It refuses
// body_lowering_reason_type_annotation_not_carried, located at the annotation, until a Bind
// annotation carrier exists. A fn literal's return annotation is that row's other route; it refuses
// the same way in body_lower_bound_value until gunbc#12210 lowers function values to Arrows.
fn body_lower_type_annotation_not_carried(at: Node) -> Outcome<Node> {
  outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_type_annotation_not_carried, n: at)
  )
}

// `let NAME : type_expr = value` -- the colon is the first element after NAME, read positionally the
// way the `<T>` slot is; the unannotated arm has `=` there.
fn body_lower_let_annotation_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: body_lower_unwrap_surface_shell(node: captured)) {
    Absent => optional_absent()
    Present { value: after_let } =>
      match body_lower_fn_decl_spine_right(node: after_let) {
        Absent => optional_absent()
        Present { value: after_name } =>
          match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: after_name)) {
            Absent => optional_absent()
            Present { value: pair } =>
              match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: pair.left)) {
                Present { value: id } =>
                  if id == ^dag_token_colon {
                    match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: pair.right)) {
                      Present { value: type_rest } => optional_present(value: type_rest.left)
                      Absent => optional_present(value: pair.right)
                    }
                  } else {
                    optional_absent()
                  }
                Absent => optional_absent()
              }
          }
      }
  }
}

fn body_lower_let_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_try_let_in_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              Accepted { value: lowered, diagnostics: d }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(
                  reason: ^body_lowering_reason_let_body_not_reachable_from_node,
                  n: shell
                )
              )
          }
      }
  }
}

// STATEMENT-FORM LET: THE BIND WHOSE BODY IS NOT INSIDE THE LET NODE.
//
// dag_grammar_let_expr is a CHOICE of two alternatives: `let n = e in e`,
// which carries its own body, and `let n [: T] = e`, which does not. The
// second is the ordinary statement form the corpus is written in, and its
// body is the REMAINDER OF THE ENCLOSING STATEMENT SEQUENCE -- a sibling of
// the let, not a descendant of it.
//
// body_lower_let_expr is handed the let node alone, so for the statement form
// it is being asked a question its input cannot answer: it looks for the `in`
// atom, does not find one, and reports the absence as unsupported_form. That
// is the boundary-4 door-holder on the compiler's own closure, measured
// through the transaction's diagnostic ledger.
//
// So the lowering belongs HERE, at dag_surface_stmt_seq, which is the only
// node from which both halves of the Bind are reachable. The spine the parser
// produces for a statement repeat is right-nested:
//
//   stmt_seq.captured = Conj
//     grammar_sequence_left_node_projection  -> stmt
//     grammar_sequence_right_node_projection -> Conj (the same shape, or empty)
//
// (executed against the real grammar, not inferred from the production rows).
// A let-headed spine becomes lower_bind(key, value, <the rest lowered>); the
// last statement in a spine is the block's value and lowers as it always has.
// The `in` form is untouched: it still carries its own body and still lowers
// through body_lower_let_expr, so this ADDS the missing case rather than
// forking the one that works.
fn body_lower_stmt_spine_head_optional(spine: Node) -> Optional<Node> {
  match find_named_child(root: spine, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: head, diagnostics: _ } => optional_present(value: head)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn body_lower_stmt_spine_rest_optional(spine: Node) -> Optional<Node> {
  match find_named_child(root: spine, name: ^grammar_sequence_right_node_projection) {
    Accepted { value: rest, diagnostics: _ } => optional_present(value: rest)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

// The captured child of a stmt shell, ONLY when it is a let production in the
// statement form. An `in`-form let returns Absent here and keeps its existing
// path; so does any other statement.
fn body_lower_statement_let_captured_optional(stmt: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: stmt) {
    Absent => optional_absent()
    Present { value: inner } =>
      match parse_production_emitted_identity_optional(node: inner) {
        Absent => optional_absent()
        Present { value: emitted } =>
          if emitted == ^dag_surface_let_expr {
            match body_lower_unwrap_captured(shell: inner) {
              Absent => optional_absent()
              Present { value: captured } =>
                match body_lower_let_in_body_capture_optional(captured: captured) {
                  Present { value: _ } => optional_absent()
                  Absent => optional_present(value: captured)
                }
            }
          } else {
            optional_absent()
          }
      }
  }
}

// The value is whatever follows the FIRST `=` on the let's own spine, which
// is the same navigation body_lower_let_in_value_capture_optional performs
// once its `in` prefix search has run. It is written separately rather than
// reused because that function's first move is to locate the prefix BEFORE
// the `in`, and there is no `in` here -- reusing it would mean relying on
// what its search happens to return in a case it was not written for.
fn body_lower_let_statement_value_optional(captured: Node) -> Optional<Node> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Absent => optional_absent()
    Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        Absent => optional_absent()
        Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            Present { value: id } =>
              if id == ^dag_token_eq {
                optional_present(value: right)
              } else {
                body_lower_let_statement_value_optional(captured: right)
              }
            Absent => body_lower_let_statement_value_optional(captured: right)
          }
      }
  }
}

// A BOUND VALUE IS AN EXPRESSION, SO IT LOWERS WHOLE THROUGH THE FOLD -- the same authority the
// statement spine uses for its last statement. It was read by the operand reader first, whose
// first-match readers stand a part in for the whole: `let x = g(p: u)` bound the callee `g`, and
// `let x = b && (u)` bound `b`, so `u` reached no reference site and the module resolved. The fold's
// refusal is the statement's refusal.
//
// A FN LITERAL'S RETURN ANNOTATION IS REFUSED BEFORE THE LITERAL IS LOWERED. The operand reader
// used to answer a fn-literal shell with its first token (body_lower_atom_is_keyword_token now
// declines that), erasing the literal -- so `let g = fn(y) -> Q { y }` was Accepted with `Q`
// declared nowhere. Nothing on this route carries a literal's written return type, so the annotation
// refuses body_lowering_reason_type_annotation_not_carried at the authored type expression first. The
// literal's parameters are bare identifiers in the grammar (dag_grammar_untyped_params_helper) and
// an arrow lambda's likewise, so the return annotation is the only annotation a function literal
// can carry. The unannotated literal keeps its existing disposition.
fn body_lower_bound_value(node: Node) -> Outcome<Node> {
  match body_lower_fn_literal_value_return_annotation_optional(node: node) {
    Present { value: annotation } => body_lower_type_annotation_not_carried(at: annotation)
    Absent => body_lower_fold(node: node)
  }
}

// fn_literal = seq(kw_fn, seq(lparen, seq(opt(params), seq(rparen, seq(opt(seq(arrow, type_expr)),
// fn_body))))): the return clause is the LEFT of the fifth right-projection; an elided clause
// carries no arrow. Answers the authored type expression.
fn body_lower_fn_literal_return_annotation_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: captured) {
    Absent => optional_absent()
    Present { value: a1 } =>
      match body_lower_fn_decl_spine_right(node: a1) {
        Absent => optional_absent()
        Present { value: a2 } =>
          match body_lower_fn_decl_spine_right(node: a2) {
            Absent => optional_absent()
            Present { value: a3 } =>
              match body_lower_fn_decl_spine_right(node: a3) {
                Absent => optional_absent()
                Present { value: a4 } =>
                  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: a4)) {
                    Absent => optional_absent()
                    Present { value: clause_body } =>
                      match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: clause_body.left)) {
                        Absent => optional_absent()
                        Present { value: arrow_type } =>
                          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: arrow_type.left)) {
                            Present { value: id } =>
                              if id == ^dag_token_arrow { optional_present(value: arrow_type.right) } else { optional_absent() }
                            Absent => optional_absent()
                          }
                      }
                  }
              }
          }
      }
  }
}

fn body_lower_fn_literal_value_return_annotation_optional(node: Node) -> Optional<Node> {
  let stripped = body_lower_unwrap_surface_shell(node: body_lower_deep_unwrap_optional(node: node))
  match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: id } =>
      if id == ^dag_surface_fn_literal {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } => body_lower_fn_literal_return_annotation_optional(captured: captured)
          Absent => optional_absent()
        }
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn body_lower_stmt_spine(spine: Node) -> Outcome<Node> {
  match body_lower_stmt_spine_head_optional(spine: spine) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(
          reason: ^body_lowering_reason_statement_spine_headless,
          n: spine
        )
      )
    Present { value: head } =>
      match body_lower_stmt_spine_rest_optional(spine: spine) {
        Absent => body_lower_fold(node: head)
        Present { value: rest } =>
          match body_lower_stmt_spine_head_optional(spine: rest) {
            Absent => body_lower_fold(node: head)
            Present { value: _ } =>
              match body_lower_statement_let_captured_optional(stmt: head) {
                Absent =>
                  outcome_rejected(
                    d: body_lower_diagnostic(
                      reason: ^body_lowering_reason_statement_precedes_without_binding,
                      n: head
                    )
                  )
                Present { value: let_captured } =>
                  match body_lower_let_in_key_binding_optional(captured: let_captured) {
                    Absent =>
                      outcome_rejected(
                        d: body_lower_diagnostic(
                          reason: ^body_lowering_reason_let_binding_name_absent,
                          n: head
                        )
                      )
                    Present { value: key } =>
                      match body_lower_let_annotation_optional(captured: let_captured) {
                      Present { value: annotation } => body_lower_type_annotation_not_carried(at: annotation)
                      Absent =>
                      match body_lower_let_statement_value_optional(captured: let_captured) {
                        Absent =>
                          outcome_rejected(
                            d: body_lower_diagnostic(
                              reason: ^body_lowering_reason_let_bound_value_absent,
                              n: head
                            )
                          )
                        Present { value: value_capture } =>
                          bind_outcome(
                            o: body_lower_bound_value(node: value_capture),
                            f: fn(value) {
                              bind_outcome(
                                o: body_lower_stmt_spine(spine: rest),
                                f: fn(body) {
                                  outcome_accepted(
                                    value: lower_bind(
                                      key_binding: body_lower_type_atom_node(sym: key, source: let_captured),
                                      value: value,
                                      body_binding: body
                                    )
                                  )
                                }
                              )
                            }
                          )
                      }
                      }
                  }
              }
          }
      }
  }
}

// A SPINE WITH A FOLLOWING STATEMENT BELONGS TO body_lower_stmt_spine, WHATEVER ITS HEAD IS. The
// guard used to admit only a let-headed spine, so `{ c \n x }` fell to the expression walkers,
// which read the first statement and dropped `x` with no refusal -- an undeclared `x` resolved.
// body_lower_stmt_spine already owns the multi-statement answer: a let binds the rest, and any other
// statement that precedes another refuses as statement_precedes_without_binding, located at it. A
// one-statement spine keeps the path it had.
fn body_lower_stmt_spine_has_successor(spine: Node) -> Bool {
  match body_lower_stmt_spine_rest_optional(spine: spine) {
    Absent => false
    Present { value: rest } =>
      match body_lower_stmt_spine_head_optional(spine: rest) {
        Absent => false
        Present { value: _ } => true
      }
  }
}

// The fn-body walker's entry into the same lowering. body_lower_fold reaches
// a stmt_seq node directly; this path is handed the fn_body and has to find
// the spine first. Both end in body_lower_stmt_spine, so there is one
// statement-sequence authority and not two.
fn body_lower_try_statement_spine(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_stmt_seq) {
    ParseSubtreeAbsent => outcome_accepted(value: optional_absent())
    ParseSubtreeFound { captured: spine } =>
      if body_lower_stmt_spine_has_successor(spine: spine) {
        bind_outcome(
          o: body_lower_stmt_spine(spine: spine),
          f: fn(lowered) { outcome_accepted(value: optional_present(value: lowered)) }
        )
      } else {
        outcome_accepted(value: optional_absent())
      }
  }
}

fn body_lower_stmt_seq(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(
          reason: ^body_lowering_reason_statement_spine_headless,
          n: shell
        )
      )
    Present { value: captured } => body_lower_stmt_spine(spine: captured)
  }
}

fn body_lower_try_loop_keyword_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  let spine = body_lower_unwrap_surface_shell(node: captured)
  match body_lower_match_spine_left(spine: spine) {
    Present { value: left } =>
      match body_lower_match_spine_right(spine: spine) {
        Present { value: right } =>
          match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
            Present { value: id } =>
              if id == ^dag_token_kw_loop {
                match body_lower_materialize_int_literal_operand_optional(node: right) {
                  Present { value: lit } =>
                    outcome_accepted(
                      value: optional_present(
                        value: lower_loop(value: lit, bound: dag_loop_measure_node())
                      )
                    )
                  Absent =>
                    match body_lower_arm_operand_resolved_optional(arm: right) {
                      Present { value: lit } =>
                        outcome_accepted(
                          value: optional_present(
                            value: lower_loop(value: lit, bound: dag_loop_measure_node())
                          )
                        )
                      Absent => body_lower_loop_navigation_reject(captured: captured)
                    }
                }
              } else {
                match body_lower_try_loop_keyword_from_captured(captured: left) {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: left_found, diagnostics: ld } =>
                    match left_found {
                      Present { value: lowered } =>
                        outcome_with_diagnostics(
                          value: optional_present(value: lowered),
                          diagnostics: ld
                        )
                      Absent => body_lower_try_loop_keyword_from_captured(captured: right)
                    }
                }
              }
            Absent =>
              match body_lower_try_loop_keyword_from_captured(captured: left) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: left_found, diagnostics: ld } =>
                  match left_found {
                    Present { value: lowered } =>
                      outcome_with_diagnostics(
                        value: optional_present(value: lowered),
                        diagnostics: ld
                      )
                    Absent => body_lower_try_loop_keyword_from_captured(captured: right)
                  }
              }
          }
        Absent =>
          match sugar_sequence_pair_optional(node: spine) {
            Present { value: pair } =>
              match body_lower_try_loop_keyword_from_captured(captured: pair.left) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: left_found, diagnostics: ld } =>
                  match left_found {
                    Present { value: lowered } =>
                      outcome_with_diagnostics(
                        value: optional_present(value: lowered),
                        diagnostics: ld
                      )
                    Absent => body_lower_try_loop_keyword_from_captured(captured: pair.right)
                  }
              }
            Absent =>
              fold(spine.children, init: outcome_accepted(value: optional_absent()), f: fn(acc, e) {
                match acc {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: found, diagnostics: _ } =>
                    match found {
                      Present { value: _ } => acc
                      Absent => body_lower_try_loop_keyword_from_captured(captured: e.target)
                    }
                }
              })
          }
      }
    Absent =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } =>
          match body_lower_try_loop_keyword_from_captured(captured: pair.left) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: left_found, diagnostics: ld } =>
              match left_found {
                Present { value: lowered } =>
                  outcome_with_diagnostics(
                    value: optional_present(value: lowered),
                    diagnostics: ld
                  )
                Absent => body_lower_try_loop_keyword_from_captured(captured: pair.right)
              }
          }
        Absent =>
          fold(spine.children, init: outcome_accepted(value: optional_absent()), f: fn(acc, e) {
            match acc {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: found, diagnostics: _ } =>
                match found {
                  Present { value: _ } => acc
                  Absent => body_lower_try_loop_keyword_from_captured(captured: e.target)
                }
            }
          })
      }
  }
}

fn body_lower_try_loop_keyword_from_node(node: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_loop_expr {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } =>
            body_lower_try_loop_keyword_from_captured(captured: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if emitted == ^dag_surface_primary_expr {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } =>
            body_lower_try_loop_keyword_from_captured(captured: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: emitted) {
        match body_lower_unwrap_captured(shell: node) {
          Present { value: captured } => body_lower_try_loop_keyword_from_node(node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent => outcome_accepted(value: optional_absent())
  }
}

// The condition is lowered by the body walker first (a call condition
// `if content_hash_eq_structural(left: a, right: b) {..}` read by the operand readers below is
// its first argument atom); the operand readers remain the fallback for what the walker declines.
fn body_lower_if_condition_lowered(condition_capture: Node) -> Outcome<Optional<Node>> {
  match body_lower_value_lowered(node: condition_capture) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: found, diagnostics: d } =>
      match found {
        Present { value: condition } => outcome_with_diagnostics(value: optional_present(value: condition), diagnostics: d)
        Absent =>
          match body_lower_if_arm_operand_optional(arm_capture: condition_capture) {
            Present { value: condition_raw } =>
              outcome_with_diagnostics(
                value: body_lower_arm_operand_resolved_optional(arm: condition_raw),
                diagnostics: d
              )
            Absent => outcome_with_diagnostics(value: optional_absent(), diagnostics: d)
          }
      }
  }
}

// AN ARM IS A STATEMENT SEQUENCE, SO IT LOWERS THROUGH THE STATEMENT AUTHORITY. The arms were read
// by body_lower_if_arm_operand_optional alone, the operand reader, which reads a call `g(p: x)` as
// `g`: an undeclared `x` in either arm reached no reference site, and a block arm kept only its
// first statement. An arm is `{` stmt_seq `}`, and body_lower_stmt_spine is the one authority for a
// statement sequence: one statement is folded whole, a let binds the rest, and any other statement
// followed by another refuses located. Its refusal is the arm's refusal. An `else if` arm is an
// if_expr, not a brace body -- a statement-sequence search there would find the nested then-arm --
// so it lowers through the if reader, and the nested if's refusal is the arm's refusal. It was read
// through body_lower_if_arm_operand_optional, which answers a refused nested if as Absent, so
// `else if a && (u) { .. }` lost `u` and the module resolved. The operand reader stays the fallback
// for an arm whose lowered statement leaves no lowered node behind its shells.
fn body_lower_if_arm_lowered(arm_capture: Node) -> Outcome<Optional<Node>> {
  match parse_production_emitted_identity_optional(node: arm_capture) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_if_expr {
        match body_lower_unwrap_captured(shell: arm_capture) {
          Present { value: captured } => body_lower_try_if_from_captured(captured: captured)
          Absent =>
            outcome_rejected(
              d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: arm_capture)
            )
        }
      } else {
        body_lower_if_arm_statements_lowered(arm_capture: arm_capture)
      }
    Absent => body_lower_if_arm_statements_lowered(arm_capture: arm_capture)
  }
}

fn body_lower_if_arm_statements_lowered(arm_capture: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: arm_capture, emitted: ^dag_surface_stmt_seq) {
    ParseSubtreeAbsent =>
      outcome_accepted(value: body_lower_if_arm_operand_resolved_optional(arm_capture: arm_capture))
    ParseSubtreeFound { captured: spine } =>
      match body_lower_stmt_spine(spine: spine) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered, diagnostics: d } =>
          match body_lower_lowered_behind_shells_optional(node: lowered) {
            Present { value: arm } => outcome_with_diagnostics(value: optional_present(value: arm), diagnostics: d)
            Absent =>
              outcome_with_diagnostics(
                value: body_lower_if_arm_operand_resolved_optional(arm_capture: arm_capture),
                diagnostics: d
              )
          }
      }
  }
}

fn body_lower_if_arm_operand_resolved_optional(arm_capture: Node) -> Optional<Node> {
  match body_lower_if_arm_operand_optional(arm_capture: arm_capture) {
    Present { value: raw } => body_lower_arm_operand_resolved_optional(arm: raw)
    Absent => optional_absent()
  }
}

fn body_lower_try_if_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_if_condition_optional(captured: captured) {
    Present { value: condition_capture } =>
      match body_lower_if_then_arm_optional(captured: captured) {
        Present { value: then_capture } =>
          match body_lower_if_else_capture_optional(captured: captured) {
            Present { value: else_capture } =>
              match body_lower_if_condition_lowered(condition_capture: condition_capture) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: condition_opt, diagnostics: _ } =>
                  match condition_opt {
                    Present { value: condition } =>
                      match body_lower_if_arm_lowered(arm_capture: then_capture) {
                        Rejected { diagnostics: r } => Rejected { diagnostics: r }
                        Accepted { value: then_opt, diagnostics: _ } =>
                          match then_opt {
                            Present { value: then_arm } =>
                              match body_lower_if_arm_lowered(arm_capture: else_capture) {
                                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                Accepted { value: else_opt, diagnostics: _ } =>
                                  match else_opt {
                                    Present { value: else_arm } =>
                                      outcome_accepted(
                                        value: optional_present(
                                          value: lower_branch(
                                            condition: condition,
                                            then_arm: then_arm,
                                            else_arm: else_arm
                                          )
                                        )
                                      )
                                    Absent => body_lower_if_navigation_reject(captured: else_capture)
                                  }
                              }
                            Absent => body_lower_if_navigation_reject(captured: then_capture)
                          }
                      }
                    Absent => body_lower_if_navigation_reject(captured: condition_capture)
                  }
              }
            Absent => body_lower_if_navigation_reject(captured: captured)
          }
        Absent => body_lower_if_navigation_reject(captured: captured)
      }
    Absent => body_lower_if_navigation_reject(captured: captured)
  }
}

fn body_lower_if_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_try_if_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              Accepted { value: lowered, diagnostics: d }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

fn body_lower_match_arms_from_brace_interior(interior: Node) -> Outcome<List<Node>> {
  let unwrapped = body_lower_postfix_optional_unwrap(node: interior)
  match sugar_sequence_pair_optional(node: unwrapped) {
    Present { value: pair } =>
      body_lower_collect_match_arms(
        sequence_capture: body_lower_unwrap_optional_element(node: pair.left)
      )
    Absent =>
      body_lower_collect_match_arms(sequence_capture: unwrapped)
  }
}

fn body_lower_match_spine_left(spine: Node) -> Optional<Node> {
  match find_named_child(root: spine, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: left, diagnostics: _ } => Present { value: left }
    Rejected { diagnostics: _ } =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } => Present { value: pair.left }
        Absent => Absent
      }
  }
}

fn body_lower_match_spine_right(spine: Node) -> Optional<Node> {
  match find_named_child(root: spine, name: ^grammar_sequence_right_node_projection) {
    Accepted { value: right, diagnostics: _ } => Present { value: right }
    Rejected { diagnostics: _ } =>
      match sugar_sequence_pair_optional(node: spine) {
        Present { value: pair } => Present { value: pair.right }
        Absent => Absent
      }
  }
}

fn body_lower_match_scrutinee_on_token(id: Symbol, left: Node, right: Node) -> Optional<Node> {
  match id == ^dag_token_lbrace {
    true => Absent
    false =>
      match id == ^dag_token_kw_match {
        true => body_lower_match_scrutinee_from_spine(spine: right)
        false =>
          match body_lower_operand_ref_optional(node: left) {
            Present { value: op } => Present { value: op }
            Absent => body_lower_match_scrutinee_from_spine(spine: right)
          }
      }
  }
}

fn body_lower_match_scrutinee_from_spine(spine: Node) -> Optional<Node> {
  if is_empty_conj_root(n: spine) {
    Absent
  } else {
    match body_lower_match_spine_left(spine: spine) {
      Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              Present { value: id } =>
                body_lower_match_scrutinee_on_token(id: id, left: left, right: right)
              Absent =>
                match body_lower_operand_ref_optional(node: left) {
                  Present { value: op } => Present { value: op }
                  Absent => body_lower_match_scrutinee_from_spine(spine: right)
                }
            }
          Absent => Absent
        }
      Absent => Absent
    }
  }
}

// THE SCRUTINEE IS A VALUE, READ AS ONE. It was read by the operand reader alone, which before
// gunbc#12145 narrowed a call scrutinee `match nat_compare(a: x, b: y) {..}` to `nat_compare`,
// dropping its arguments, and after it answered Absent, so the whole match refused as
// match_arm_navigation_refused. The value goes through body_lower_value_lowered first -- the reader
// call arguments, field initializers and if-conditions use -- and the operand reader only for what
// that declines; a refusal either raises is the scrutinee's.
fn body_lower_match_scrutinee_value(node: Node) -> Outcome<Optional<Node>> {
  match body_lower_value_lowered(node: node) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Present { value: lowered }, diagnostics: d } =>
      outcome_with_diagnostics(value: optional_present(value: lowered), diagnostics: d)
    Accepted { value: Absent, diagnostics: _ } =>
      outcome_accepted(value: body_lower_operand_ref_optional(node: node))
  }
}

fn body_lower_match_scrutinee_optional(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_find_captured(root: captured, emitted: ^dag_surface_binary_expr) {
    ParseSubtreeFound { captured: binary } => body_lower_match_scrutinee_value(node: binary)
    ParseSubtreeAbsent =>
      match body_lower_find_captured(root: captured, emitted: ^dag_surface_postfix_expr) {
        ParseSubtreeFound { captured: postfix } => body_lower_match_scrutinee_value(node: postfix)
        ParseSubtreeAbsent =>
          outcome_accepted(
            value: body_lower_match_scrutinee_from_spine(
              spine: body_lower_unwrap_surface_shell(node: captured)
            )
          )
      }
  }
}

fn body_lower_match_arms_on_lbrace_token(id: Symbol, right: Node) -> Outcome<Optional<List<Node>>> {
  match id == ^dag_token_lbrace {
    true =>
      match body_lower_match_arms_from_brace_interior(interior: right) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: arms, diagnostics: d } =>
          if count(arms) > 0 {
            Accepted {
              value: optional_present(value: arms),
              diagnostics: d
            }
          } else {
            outcome_rejected(
              d: body_lower_diagnostic(
                reason: ^body_lowering_reason_match_arm_navigation_refused,
                n: right
              )
            )
          }
      }
    false => body_lower_match_arms_after_lbrace_optional(spine: right)
  }
}

fn body_lower_match_arms_after_lbrace_optional(spine: Node) -> Outcome<Optional<List<Node>>> {
  if is_empty_conj_root(n: spine) {
    outcome_accepted(value: optional_absent())
  } else {
    match body_lower_match_spine_left(spine: spine) {
      Present { value: left } =>
        match body_lower_match_spine_right(spine: spine) {
          Present { value: right } =>
            match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
              Present { value: id } =>
                body_lower_match_arms_on_lbrace_token(id: id, right: right)
              Absent =>
                body_lower_match_arms_after_lbrace_optional(spine: right)
            }
          Absent => outcome_accepted(value: optional_absent())
        }
      Absent => outcome_accepted(value: optional_absent())
    }
  }
}

fn body_lower_match_arms_optional(captured: Node) -> Outcome<Optional<List<Node>>> {
  body_lower_match_arms_after_lbrace_optional(
    spine: body_lower_unwrap_surface_shell(node: captured)
  )
}

fn body_lower_try_match_from_captured(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_match_scrutinee_optional(captured: captured) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Absent, diagnostics: _ } =>
      outcome_rejected(
        d: body_lower_diagnostic(
          reason: ^body_lowering_reason_match_arm_navigation_refused,
          n: captured
        )
      )
    Accepted { value: Present { value: scrutinee }, diagnostics: _ } =>
      match body_lower_match_arms_optional(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: arms_opt, diagnostics: d } =>
          match arms_opt {
            Present { value: arms } =>
              if count(arms) > 0 {
                Accepted {
                  value: optional_present(value: lower_match(scrutinee: scrutinee, arms: arms)),
                  diagnostics: d
                }
              } else {
                outcome_rejected(
                  d: body_lower_diagnostic(
                    reason: ^body_lowering_reason_match_arm_navigation_refused,
                    n: captured
                  )
                )
              }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(
                  reason: ^body_lowering_reason_match_arm_navigation_refused,
                  n: captured
                )
              )
          }
      }
  }
}

fn body_lower_match_spine_has_lbrace(spine: Node) -> Bool {
  match body_lower_match_arms_after_lbrace_optional(spine: spine) {
    Rejected { diagnostics: _ } => true
    Accepted { value: arms_opt, diagnostics: _ } =>
      match arms_opt {
        Present { value: _ } => true
        Absent => false
      }
  }
}

fn body_lower_match_capture_heads_spine(spine: Node) -> Bool {
  match body_lower_match_spine_left(spine: spine) {
    Present { value: left } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: left)) {
        Present { value: id } =>
          if id == ^dag_token_kw_match {
            match body_lower_match_spine_right(spine: spine) {
              Present { value: right } => body_lower_match_spine_has_lbrace(spine: right)
              Absent => false
            }
          } else {
            false
          }
        Absent => false
      }
    Absent => false
  }
}

fn body_lowering_match_spine_identity_absent_fixture_spine() -> Node {
  let match_kw = node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^dag_token_kw_match } },
    children: []
  )
  let lbrace = node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^dag_token_lbrace } },
    children: []
  )
  let empty_interior = node_synthetic(kind: TypeNode { connective: Conj }, children: [])
  let braced = node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^grammar_sequence_left_node_projection },
        target: lbrace
      },
      Edge {
        label: Named { name: ^grammar_sequence_right_node_projection },
        target: empty_interior
      }
    ]
  )
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^grammar_sequence_left_node_projection },
        target: match_kw
      },
      Edge {
        label: Named { name: ^grammar_sequence_right_node_projection },
        target: braced
      }
    ]
  )
}

fn body_lowering_match_spine_identity_absent_sniff_holds() -> Bool {
  body_lower_match_capture_heads_spine(
    spine: body_lowering_match_spine_identity_absent_fixture_spine()
  )
}

fn body_lowering_match_field_name_spine() -> Node {
  let match_kw = node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^dag_token_kw_match } },
    children: []
  )
  let empty_suffix = node_synthetic(kind: TypeNode { connective: Conj }, children: [])
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^grammar_sequence_left_node_projection },
        target: match_kw
      },
      Edge {
        label: Named { name: ^grammar_sequence_right_node_projection },
        target: empty_suffix
      }
    ]
  )
}

fn body_lowering_match_field_name_spine_does_not_sniff_holds() -> Bool {
  !body_lower_match_capture_heads_spine(spine: body_lowering_match_field_name_spine())
}

fn body_lowering_match_spine_identity_absent_dispatch_holds() -> Bool {
  let fixture = body_lowering_match_spine_identity_absent_fixture_spine()
  if !body_lower_match_capture_heads_spine(spine: fixture) {
    false
  } else {
    match body_lower_fold_reduce(node: fixture) {
      Rejected { diagnostics: _ } => false
      Accepted { value: reduced, diagnostics: _ } =>
        match body_lower_fold_identity_absent(node: fixture) {
          Rejected { diagnostics: _ } => true
          Accepted { value: dispatched, diagnostics: _ } =>
            body_lower_is_core_substrate(node: dispatched) || dispatched != reduced
        }
    }
  }
}

fn body_lower_match_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_try_match_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              Accepted { value: lowered, diagnostics: d }
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
              )
          }
      }
  }
}

// A postfix with NO suffix over an already-lowered primary is that primary: a construct (or any
// core substrate) the primary produced passes through whole, instead of the first-atom fallback
// below answering its tag.
fn body_lower_postfix_lowered_primary_optional(captured: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Absent
    Present { value: pair } =>
      if body_lower_is_core_substrate(node: pair.left)
        && is_empty_conj_root(n: body_lower_deep_unwrap_optional(node: pair.right)) {
        optional_present(value: pair.left)
      } else {
        optional_absent()
      }
  }
}

// A CAST IN A CHAIN THIS READ DECLINES IS REFUSED, NOT DECLINED: the arms behind the door read the
// head and not the suffixes, so declining would drop the cast. The carried suffix is the refusal's
// cause and locus.
fn body_lower_postfix_chain_carries_as_suffix(node: Node) -> Bool {
  match sugar_sequence_pair_optional(node: body_lower_unwrap_surface_shell(node: node)) {
    Absent => false
    Present { value: pair } => body_lower_postfix_repeat_carries_as_suffix(repeat_capture: pair.right)
  }
}

fn body_lower_postfix_repeat_carries_as_suffix(repeat_capture: Node) -> Bool {
  if is_empty_conj_root(n: repeat_capture) {
    false
  } else {
    match body_lower_postfix_repeat_head_optional(repeat_capture: repeat_capture) {
      Absent => false
      Present { value: repeat_elem } =>
        match body_lower_as_suffix_type_optional(repeat_elem: repeat_elem) {
          Present { value: _ } => true
          Absent =>
            match body_lower_seq_child(node: repeat_capture, name: ^grammar_sequence_right_node_projection) {
              Present { value: rest } => body_lower_postfix_repeat_carries_as_suffix(repeat_capture: rest)
              Absent => false
            }
        }
    }
  }
}

// as_suffix = seq(kw_as, type_expr): answers the type expression when the element is a cast.
fn body_lower_as_suffix_type_optional(repeat_elem: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: repeat_elem)) {
    Absent => optional_absent()
    Present { value: pair } =>
      match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: pair.left)) {
        Present { value: id } =>
          if id == ^dag_token_kw_as { optional_present(value: pair.right) } else { optional_absent() }
        Absent => optional_absent()
      }
  }
}

fn body_lower_postfix_expr(shell: Node) -> Outcome<Node> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
      )
    Present { value: captured } =>
      match body_lower_postfix_lowered_primary_optional(captured: captured) {
        Present { value: lowered } => outcome_accepted(value: lowered)
        Absent =>
      match body_lower_dotted_chain_lowered_optional(node: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: Present { value: spine }, diagnostics: _ } => outcome_accepted(value: spine)
        Accepted { value: Absent, diagnostics: _ } =>
      match body_lower_pattern_first_atom_optional(node: captured) {
        Present { value: atom } => outcome_accepted(value: atom)
        Absent =>
      match body_lower_try_infix_transform(node: captured) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: Present { value: transform }, diagnostics: _ } => outcome_accepted(value: transform)
                Accepted { value: Absent, diagnostics: _ } =>
                  match body_lower_try_fold_loop(node: captured) {
                    Rejected { diagnostics: _ } =>
                      body_lower_try_operand_or_reject(shell: shell, captured: captured)
                    Accepted { value: fold_result, diagnostics: fd } =>
                      match fold_result {
                        Present { value: loop_node } =>
                          outcome_with_diagnostics(value: loop_node, diagnostics: fd)
                        Absent =>
                          match body_lower_try_operand_or_reject(shell: shell, captured: captured) {
                            Rejected { diagnostics: r } =>
                              Rejected { diagnostics: rejected_with_pending(pending: fd, rejected: r) }
                            Accepted { value: v, diagnostics: od } =>
                              outcome_with_diagnostics(
                                value: v,
                                diagnostics: diagnostics_merge(outer: fd, inner: od)
                              )
                          }
                      }
                  }
              }
      }
  }
  }
  }
}


// A RECORD LITERAL LOWERS TO THE CONSTRUCT. primary_expr's captured for `R { f: e, .. }` is
// seq(name, seq(`{`, seq(field_init,*, `}`))); each field_init shell, preserved by the child fold
// around its already-lowered value, is seq(name, seq(`:`, value)). The result is
// v2.std.node_query construct_node -- Conj { R: Atom(R), f: e, .. } -- the RecordConstructBody
// shape v2.std.node admits and the shape a fielded pattern lowers to, so `Rec { n: 1 }` and
// `Rec { n: x } =>` are one shape read in two directions. A dotted head (`m.R { .. }`) is not a
// bare name and falls through to the arms below unchanged.
fn body_lower_field_init_edge(item: Node) -> Outcome<Edge> {
  let stripped = body_lower_deep_unwrap_optional(node: item)
  let captured = match parse_production_captured_child_optional(node: stripped) {
    Present { value: c } => c
    Absent => stripped
  }
  let refuse = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_init_unlowered, n: item)
  )
  match sugar_sequence_pair_optional(node: captured) {
    Absent => refuse
    Present { value: pair } =>
      match body_lower_param_binding_optional(node: pair.left) {
        Absent => refuse
        Present { value: field_name } =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Absent => refuse
            Present { value: after_colon } =>
              match body_lower_value_lowered_or_carried(value: after_colon.right) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: value, diagnostics: d } =>
                  outcome_with_diagnostics(
                    value: Edge { label: Named { name: field_name }, target: value },
                    diagnostics: d
                  )
              }
          }
      }
  }
}

fn body_lower_record_literal_field_items_optional(captured: Node) -> Optional<List<Node>> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Absent
    Present { value: pair } =>
      match sugar_sequence_pair_optional(node: pair.right) {
        Absent => Absent
        Present { value: brace_seq } =>
          match node_atom_identity_optional(node: brace_seq.left) {
            Absent => Absent
            Present { value: open } =>
              if open == ^dag_token_lbrace {
                match sugar_sequence_pair_optional(node: brace_seq.right) {
                  Absent => Absent
                  Present { value: inner } =>
                    match node_atom_identity_optional(node: inner.right) {
                      Absent => Absent
                      Present { value: close } =>
                        if close == ^dag_token_rbrace {
                          body_lower_comma_list_items_optional(list_capture: inner.left)
                        } else {
                          Absent
                        }
                    }
                }
              } else {
                Absent
              }
          }
      }
  }
}

// The tag is read with the atom it was read from, so the construct's tag atom can be lowered from
// that token rather than from the whole capture (v2.std.node_query construct_tag_edge).
type RecordLiteralTag {
  tag: Symbol
  at: Node
}

fn body_lower_record_literal_tag_optional(captured: Node) -> Optional<RecordLiteralTag> {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => Absent
    Present { value: pair } =>
      match dag_binding_branded_atom_identity(node: pair.left) {
        Present { value: tag } =>
          match dag_lex_token_symbol(sym: tag) {
            true => optional_absent()
            false => optional_present(value: RecordLiteralTag { tag: tag, at: pair.left })
          }
        Absent => Absent
      }
  }
}

fn body_lower_try_record_literal(captured: Node) -> Outcome<Optional<Node>> {
  match body_lower_record_literal_tag_optional(captured: captured) {
    Absent => outcome_accepted(value: optional_absent())
    Present { value: read } =>
      match body_lower_record_literal_field_items_optional(captured: captured) {
        Absent => outcome_accepted(value: optional_absent())
        Present { value: items } =>
          match fold(items, init: outcome_accepted(value: Empty), f: fn(acc, item) {
            bind_outcome(o: acc, f: fn(edges) {
              bind_outcome(o: body_lower_field_init_edge(item: item), f: fn(e) {
                outcome_accepted(value: list_snoc_item(xs: edges, item: e))
              })
            })
          }) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: edges, diagnostics: d } =>
              Accepted {
                value: optional_present(value: construct_node(tag: read.tag, tag_source: read.at, field_edges: edges, source: captured)),
                diagnostics: d
              }
          }
      }
  }
}

// The literal probe at the head is SHALLOW on purpose: it answers a primary whose captured IS
// an int literal, through production shells and optionals only. The deep search that stood
// here answered the first literal anywhere under the captured, so `f(1)`, `A(1)` and
// `R { v: 1 }` each lowered to the literal 1 with the callee, constructor and fields dropped.
// A PARENTHESISED GROUP IS ITS INNER EXPRESSION. dag_grammar_primary_expr_core writes it as
// seq(lparen, seq(expr, rparen)); this answers the expr when the node is exactly that shape. Before it
// was read, body_lower_primary_expr answered the group with body_lower_pattern_first_atom_optional --
// its first atom, the `(` token -- so `(u)` lowered to `(` and `u` reached no reference site.
fn body_lower_node_is_token(node: Node, token: Symbol) -> Bool {
  match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(node: node)) {
    Present { value: id } => id == token
    Absent => false
  }
}

fn body_lower_paren_group_inner_optional(node: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_unwrap_surface_shell(node: node)) {
    Absent => optional_absent()
    Present { value: pair } =>
      if body_lower_node_is_token(node: pair.left, token: ^dag_token_lparen) {
        match sugar_sequence_pair_optional(node: pair.right) {
          Absent => optional_absent()
          Present { value: rest } =>
            if body_lower_node_is_token(node: rest.right, token: ^dag_token_rparen) {
              optional_present(value: rest.left)
            } else {
              optional_absent()
            }
        }
      } else {
        optional_absent()
      }
  }
}

// The group's inner expression has already been through the bottom-up fold, so it is read as the
// value it lowered to; one it did not lower refuses at the group.
fn body_lower_paren_group_lowered(group: Node, inner: Node) -> Outcome<Node> {
  match body_lower_lowered_behind_shells_optional(node: inner) {
    Present { value: lowered } => outcome_accepted(value: lowered)
    Absent =>
      match body_lower_operand_ref_optional(node: inner) {
        Present { value: operand } => outcome_accepted(value: operand)
        Absent =>
          outcome_rejected(
            d: body_lower_diagnostic(reason: ^body_lowering_reason_paren_group_unread, n: group)
          )
      }
  }
}

// A LIST LITERAL IS THE FLAT FREE-MONOID INTRODUCTION (DESIGN section 4). `List<T>` is
// std.algebra FreeMonoid<T> (dag/std/algebra.dag), and `[e1, .., en]` lowers to ONE Transform whose
// head is the reference to that declaration and whose remaining positional children are the
// elements in order; `[]` is the Transform with the head alone. The authority for the shape is
// std.literal_elaboration UnicodeScalarSequenceUnfold, which carries a text's image as "the
// language's canonical FreeMonoid introduction (the list-literal node)" with one element per
// operand and REJECTS a cons^n nesting: O(n^2) under a sequence-backed carrier, and n deep it
// exceeds the emitter's bounded recursion fuel on ordinary literals. (gunbc#12208 first lowered to a
// right-nested list_append over singletons; that forked this authority and was reversed.) The head
// is the declaring qualified name as a spine -- resolve binds it through its qualified door and
// mints it as a resolved reference -- and it names std.algebra, NOT v2.std.algebra: v2.std.algebra
// imports v2.std.node, so a list literal in v2.std.node referring to v2.std.algebra would close a
// node -> algebra -> node cycle, and v2 collapses onto dag/std, not the reverse. The Transform is
// not an application: 04_infer types it by its one introduction case
// (v2.compiler.infer infer_transform_freemonoid_introduction), every element unifying to one T. The
// shape itself -- head path, constructor and reader -- is v2.std.compilers.body_lowering
// lower_list_introduction and list_introduction_elements_optional, one authority for both sides.
// The grammar writes the literal as seq(`[`, seq(optional comma_list(expr), `]`))
// (v2.extdeps.languages.dag dag_grammar_primary_expr_core); its items are read by the one
// comma-list walker. Every element is lowered WHOLE through body_lower_value_lowered, the value
// reader every value position uses, so a call, record, nested list or operator expression in
// element position lowers as it would anywhere else. An element that reader cannot lower refuses
// located at that element. Before this producer body_lower_primary_expr answered the literal with
// its `[` atom and every element was dropped; call arguments refused the whole module instead
// (body_lowering_reason_list_literal_unlowered).
fn body_lower_list_literal_items_capture_optional(captured: Node) -> Optional<Node> {
  match sugar_sequence_pair_optional(node: body_lower_unwrap_surface_shell(node: captured)) {
    Absent => optional_absent()
    Present { value: pair } =>
      if body_lower_node_is_token(node: pair.left, token: ^dag_token_lbracket) {
        match sugar_sequence_pair_optional(node: pair.right) {
          Absent => optional_absent()
          Present { value: rest } =>
            if body_lower_node_is_token(node: rest.right, token: ^dag_token_rbracket) {
              optional_present(value: rest.left)
            } else {
              optional_absent()
            }
        }
      } else {
        optional_absent()
      }
  }
}

fn body_lower_list_literal_element(item: Node) -> Outcome<Node> {
  match body_lower_value_lowered(node: item) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: Present { value: lowered }, diagnostics: d } =>
      outcome_with_diagnostics(value: lowered, diagnostics: d)
    Accepted { value: Absent, diagnostics: _ } =>
      outcome_rejected(
        d: body_lower_diagnostic(reason: ^body_lowering_reason_list_element_unlowered, n: item)
      )
  }
}

fn body_lower_list_literal(literal: Node, items_capture: Node) -> Outcome<Node> {
  bind_outcome(
    o: body_lower_comma_list_items(
      list_capture: items_capture,
      shape_refusal: ^body_lowering_reason_list_literal_shape_unread
    ),
    f: fn(items) {
      bind_outcome(
        o: fold(items, init: outcome_accepted(value: Empty), f: fn(acc, item) {
          bind_outcome(o: acc, f: fn(elements) {
            bind_outcome(o: body_lower_list_literal_element(item: item), f: fn(element) {
              outcome_accepted(value: list_snoc_item(xs: elements, item: element))
            })
          })
        }),
        f: fn(elements) { outcome_accepted(value: lower_list_introduction(elements: elements, source: literal)) }
      )
    }
  )
}

fn body_lower_primary_expr(shell: Node) -> Outcome<Node> {
  let captured = match body_lower_unwrap_captured(shell: shell) {
    Present { value: inner } => inner
    Absent => shell
  }
  match body_lower_int_literal_with_magnitude_optional(node: captured) {
        Present { value: lit } => outcome_accepted(value: lit)
        Absent =>
      match body_lower_list_literal_items_capture_optional(captured: captured) {
        Present { value: items_capture } =>
          body_lower_list_literal(literal: captured, items_capture: items_capture)
        Absent =>
      match body_lower_try_record_literal(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: record_opt, diagnostics: cd } =>
          match record_opt {
            Present { value: construct } => Accepted { value: construct, diagnostics: cd }
            Absent =>
      match body_lower_try_loop_keyword_from_captured(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: loop_opt, diagnostics: ld } =>
          match loop_opt {
            Present { value: loop_node } =>
              Accepted { value: loop_node, diagnostics: ld }
            Absent =>
      match body_lower_try_primary_ident_call(node: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: primary_call, diagnostics: d } =>
          match primary_call {
            Present { value: transform } =>
              Accepted { value: transform, diagnostics: d }
            Absent =>
      match body_lower_dotted_chain_lowered_optional(node: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: Present { value: spine }, diagnostics: _ } => outcome_accepted(value: spine)
        Accepted { value: Absent, diagnostics: _ } =>
      match body_lower_paren_group_inner_optional(node: captured) {
        Present { value: inner } => body_lower_paren_group_lowered(group: captured, inner: inner)
        Absent =>
      match body_lower_pattern_first_atom_optional(node: captured) {
        Present { value: atom } => outcome_accepted(value: atom)
        Absent =>
      match body_lower_try_infix_transform(node: captured) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: Present { value: transform }, diagnostics: _ } => outcome_accepted(value: transform)
                Accepted { value: Absent, diagnostics: _ } =>
                  match body_lower_try_fold_loop(node: captured) {
                    Rejected { diagnostics: _ } =>
                      body_lower_try_operand_or_reject(shell: shell, captured: captured)
                    Accepted { value: fold_result, diagnostics: fd } =>
                      match fold_result {
                        Present { value: loop_node } =>
                          outcome_with_diagnostics(value: loop_node, diagnostics: fd)
                        Absent =>
                          match body_lower_try_operand_or_reject(shell: shell, captured: captured) {
                            Rejected { diagnostics: r } =>
                              Rejected { diagnostics: rejected_with_pending(pending: fd, rejected: r) }
                            Accepted { value: v, diagnostics: od } =>
                              outcome_with_diagnostics(
                                value: v,
                                diagnostics: diagnostics_merge(outer: fd, inner: od)
                              )
                          }
                      }
                  }
              }
      }
      }
      }
      }
      }
      }
          }
      }
  }
      }
      }
}

fn body_lower_fn_body_shell(shell: Node) -> Outcome<BodyLowering> {
  match body_lower_unwrap_captured(shell: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_body_subtree_lower(captured: captured) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: lowered_opt, diagnostics: d } =>
          match lowered_opt {
            Present { value: lowered } =>
              body_lowering_lowered(o: outcome_with_diagnostics(value: lowered, diagnostics: d))
            Absent => body_lowering_after_pending(pending: d, o: body_lower_wrapper_retained_shell(shell: shell))
          }
      }
  }
}

fn body_lower_forward_row_apply(shell: Node, emitted: Symbol) -> Outcome<BodyLowering> {
  if emitted == ^dag_surface_fn_decl {
    body_lower_fn_decl_to_arrow(shell: shell)
  } else if emitted == ^dag_surface_test_fn_decl {
    body_lower_test_fn_decl_to_member(shell: shell)
  } else if emitted == ^dag_surface_data_decl {
    body_lower_data_decl_to_member(shell: shell)
  } else if emitted == ^dag_surface_fn_body {
    body_lower_fn_body_shell(shell: shell)
  } else if emitted == ^dag_surface_match_expr {
    body_lowering_lowered(o: body_lower_match_expr(shell: shell))
  } else if emitted == ^dag_surface_if_expr {
    body_lowering_lowered(o: body_lower_if_expr(shell: shell))
  } else if emitted == ^dag_surface_loop_expr {
    body_lowering_lowered(o: body_lower_loop_expr(shell: shell))
  } else if emitted == ^dag_surface_let_expr {
    body_lowering_lowered(o: body_lower_let_expr(shell: shell))
  } else {
    body_lower_wrapper_retained_shell(shell: shell)
  }
}

fn body_lower_edge_names_where_clause(e: Edge) -> Bool {
  match e.label {
    Named { name: n } => n == ^dag_surface_where_refinement_clause
    Positional => false
  }
}

fn body_lower_find_where_host_conj(root: Node) -> Optional<Node> {
  match fold(root.children, init: false, f: fn(found, e) {
    found || body_lower_edge_names_where_clause(e: e)
  }) {
    true => Present { value: root }
    false =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => body_lower_find_where_host_conj(root: e.target)
        }
      })
  }
}

// A RECORD DECLARATION rehomes exactly the way a where-alias does: `type R { f: T }` becomes
// Conj { R: Conj { f: T } }, a Named member the graft flatten keeps, so the record's fields are
// declared identities (module.R.f in the containment index) instead of a residual shell. The
// block shell reaches this dispatch preserved by the child fold; after a coproduct's variants
// have lowered no block shell remains under the unit, so a remaining one is the record spelling.
// Generic parameters ARE carried, on the member, by body_lower_type_decl_member below; the
// type-decl modifiers are not carried by this rehome, as they are not by the where-alias rehome
// beside it.
// A RECORD REHOMES TO Conj{ R: payload }, AND THAT SHAPE DOES NOT SAY IT IS A RECORD. The graft
// flattens this the same way it flattens a where-alias, so downstream of the graft a record
// declaration and a where-alias are indistinguishable, and the record/where-alias distinction is
// last held HERE, in body_lower_type_decl's arms.
//
// SO IT IS CARRIED FROM HERE, not recovered downstream: body_lower_type_decl_record_name_optional
// (below) is the one predicate that says which type_decl is a record; this dispatch and
// v2.compiler.normalize record_declaration_capture both ask it, and the capture rides to the symbol
// index on NormalizedTree record_declarations, where the pattern-binder classifier reads it (Pkg16).
// The record-versus-where-alias control is v2.test.claim.match_arm_binder_frame
// mab_where_alias_is_not_a_record.
fn body_lower_record_type_decl(shell: Node, type_name: Symbol, block_shell: Node, type_params: DeclTypeParams) -> Outcome<Node> {
  match body_lower_field_decl_block_payload(block_shell: block_shell) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: payload, diagnostics: d } =>
      Accepted {
        value: body_lower_type_decl_member(shell: shell, type_name: type_name, body: payload, type_params: type_params),
        diagnostics: d
      }
  }
}

// A TYPE DECLARATION'S `<T>` RIDES ON THE DECLARATION, BESIDE ITS MEMBER: the graft keeps the Named
// declaration edge, and for a generic declaration its target is v2.std.type_binder type_decl_wrapper
// -- Conj { <type-parameters>: binders, <type-body>: member } -- so the member (the record's field
// Conj, the coproduct's variant Disj) keeps exactly its authored children. v2.compiler.resolve opens
// the binders' frame over the wrapper, so it covers the member and cannot reach a sibling
// declaration. Both labels are unauthorable. Without this the `<T>` list was dropped (records) or
// left in the graft target as parse residue walked as ordinary names (coproducts), and `T` resolved
// through the module's ordinary name chain (gunbc.recurring_failure_mode
// generic_type_parameter_resolved_as_an_ordinary_atom_in_v2).
fn body_lower_type_decl_member_body(body: Node, type_params: DeclTypeParams) -> Node {
  match type_params {
    TypeParams { conj: c } => type_decl_wrapper(binders: c, member: body)
    NoTypeParams => body
    TypeParamsUnreadable => body
  }
}

fn body_lower_type_decl_member(shell: Node, type_name: Symbol, body: Node, type_params: DeclTypeParams) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: type_name },
        target: body_lower_type_decl_member_body(body: body, type_params: type_params)
      }
    ],
    occurrence_id: shell.occurrence_id
  )
}

// THE `=` ARM'S LOWERED RIGHT-HAND SIDE: seq(kw_type, seq(name, seq(opt(generic_params),
// seq(modifiers, opt(choice(field_decl_block, seq(eq, type_alias_rhs_lead))))))), read positionally
// the way the `<T>` slot is. Only a GENERIC declaration asks for it.
fn body_lower_type_decl_eq_rhs_optional(captured: Node) -> Optional<Node> {
  match body_lower_fn_decl_spine_right(node: captured) {
    Absent => optional_absent()
    Present { value: after_kw } =>
      match body_lower_fn_decl_spine_right(node: after_kw) {
        Absent => optional_absent()
        Present { value: after_name } =>
          match body_lower_fn_decl_spine_right(node: after_name) {
            Absent => optional_absent()
            Present { value: after_params } =>
              match body_lower_fn_decl_spine_right(node: after_params) {
                Absent => optional_absent()
                Present { value: body_choice } =>
                  match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: body_choice)) {
                    Absent => optional_absent()
                    Present { value: eq_rhs } => optional_present(value: body_lower_deep_unwrap_optional(node: eq_rhs.right))
                  }
              }
          }
      }
  }
}

// A GENERIC `=` DECLARATION CARRIES ITS BINDERS IN A WRAPPER BESIDE WHAT IT DECLARES, never mixed into
// it (v2.std.type_binder). Three shapes, each with its own wrapper label, decided here from the parse
// and never later from a target's kind:
//   a MEMBER -- a Disj, or a lowered Conj (a fielded variant, a where-refined body) -- rides under
//   <type-body> (type_decl_wrapper);
//   an ALIAS -- a single variant with no payload, no where clause and no separator, which
//   v1.compiler.parse parse_type_body_after_eq reads as type_item_from_alias_rhs -- rides under
//   <type-alias> (type_alias_wrapper), its right-hand side lowered by the ONE type-expression
//   lowering fn signatures use, body_lower_type_expr_lowered_optional;
//   a BODYLESS declaration (`type MachineWidth<bits>`) carries its binders alone
//   (type_opaque_wrapper).
// The first cut accepted only the member and refused the rest, because it carried binders AMONG a
// member's children, which only a Conj or Disj has; the wrapper (gunbc#12240 review 71065) removed
// that constraint, and nine corpus files -- v2.std.collection's List<T> among them -- refused with it.
// What still refuses body_lowering_reason_generic_type_decl_member_uncarried is a right-hand side this
// lowering cannot read as one of the three. A single variant written after a leading `|` is a
// one-variant coproduct, not an alias: v2.std.compilers.sugar sugar_separated_rhs_as_coproduct has
// already made it a Disj by the time this lowering runs, so it takes the member arm.
fn body_lower_generic_eq_type_decl(shell: Node, captured: Node, type_name: Symbol, type_params: DeclTypeParams) -> Outcome<Node> {
  match body_lower_type_decl_eq_rhs_optional(captured: captured) {
    Present { value: rhs } =>
      match rhs.kind {
        TypeNode { connective: Disj } =>
          outcome_accepted(value: body_lower_type_decl_member(shell: shell, type_name: type_name, body: rhs, type_params: type_params))
        TypeNode { connective: Conj } =>
          if body_lower_node_is_production_shell(n: rhs) {
            body_lower_generic_alias_type_decl(shell: shell, type_name: type_name, rhs: rhs, type_params: type_params)
          } else {
            outcome_accepted(value: body_lower_type_decl_member(shell: shell, type_name: type_name, body: rhs, type_params: type_params))
          }
        _ => body_lower_generic_alias_type_decl(shell: shell, type_name: type_name, rhs: rhs, type_params: type_params)
      }
    Absent =>
      match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_type_alias_rhs_lead) {
        Present { value: _ } => body_lower_generic_type_decl_uncarried(shell: shell)
        Absent =>
          match type_params {
            TypeParams { conj: c } =>
              outcome_accepted(value: body_lower_type_decl_declared(shell: shell, type_name: type_name, target: type_opaque_wrapper(binders: c)))
            NoTypeParams => body_lower_generic_type_decl_uncarried(shell: shell)
            TypeParamsUnreadable => body_lower_generic_type_decl_uncarried(shell: shell)
          }
      }
  }
}

fn body_lower_generic_alias_type_decl(shell: Node, type_name: Symbol, rhs: Node, type_params: DeclTypeParams) -> Outcome<Node> {
  match type_params {
    TypeParams { conj: c } =>
      match body_lower_generic_alias_rhs_optional(rhs: rhs) {
        Present { value: aliased } =>
          outcome_accepted(value: body_lower_type_decl_declared(shell: shell, type_name: type_name, target: type_alias_wrapper(binders: c, aliased: aliased)))
        Absent => body_lower_generic_type_decl_uncarried(shell: shell)
      }
    NoTypeParams => body_lower_generic_type_decl_uncarried(shell: shell)
    TypeParamsUnreadable => body_lower_generic_type_decl_uncarried(shell: shell)
  }
}

// The aliased type expression, lowered; Absent for anything that is not exactly one: a parse shell with
// no type expression to lower, or a node that is not a type.
fn body_lower_generic_alias_rhs_optional(rhs: Node) -> Optional<Node> {
  if body_lower_node_is_production_shell(n: rhs) {
    match body_lower_find_captured(root: rhs, emitted: ^dag_surface_type_expr) {
      ParseSubtreeFound { captured: type_expr } => body_lower_type_expr_lowered_optional(node: type_expr)
      ParseSubtreeAbsent => optional_absent()
    }
  } else {
    match rhs.kind {
      TypeNode { connective: _ } => optional_present(value: rhs)
      ComputationNode { behavior: _ } => optional_absent()
    }
  }
}

// A declaration edge `Conj { Name: target }` whose target is already a v2.std.type_binder wrapper.
fn body_lower_type_decl_declared(shell: Node, type_name: Symbol, target: Node) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Named { name: type_name }, target: target }],
    occurrence_id: shell.occurrence_id
  )
}

fn body_lower_node_is_production_shell(n: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: _ } => true
    Absent => false
  }
}

fn body_lower_generic_type_decl_uncarried(shell: Node) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(d: Diagnostic {
      reason: ^body_lowering_reason_generic_type_decl_member_uncarried,
      at: node_locus(node: shell),
      correction: Unavailable { reason: UserInputBoundary }
    })
  }
}

// WHICH type_decl IS A RECORD, ASKED ONCE. The record rehome below writes a record as
// `Conj { R: payload }`, which is the same shape a where-alias rehome writes and the same shape the
// graft builds for a module spine, so after this stage nothing can tell a record from those. The
// pattern-binder classifier needs exactly that distinction (v2.compiler.resolve
// resolve_pattern_atom_names_constructor: a record type spelled as a field-target atom is a
// constructor, a module is not), so it is read HERE, where it is still held, and carried on
// v2.compiler.normalized_tree NormalizedTree record_declarations by v2.compiler.normalize.
//
// The rule is the grammar's (v2.extdeps.languages.dag dag_grammar_type_decl_expr): a record is the
// type_decl whose body is the field_decl_block arm of the choice, not the `=` arm. Asking for the
// block alone is not enough on the PARSE tree, where every fielded variant of a coproduct still
// carries one (dag_grammar_type_variant_expr). Every `=` body reaches a type_alias_rhs -- the
// optional leading pipe's _lead wrapper is sugared away, the rhs is structure-preserved
// (body_lower_is_structure_preserved_emitted) -- so excluding it gives the same answer on the parse
// tree normalize captures from and on the lowered shell this stage rehomes: the rehome and the
// capture cannot disagree. On the lowered shell the exclusion changes nothing the old block-only
// test answered, because a lowered coproduct's variants no longer carry a block.
fn body_lower_type_decl_record_block_optional(captured: Node) -> Optional<Node> {
  match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_type_alias_rhs) {
    Present { value: _ } => Absent
    Absent => body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_field_decl_block)
  }
}

fn body_lower_type_decl_record_name_optional(shell: Node) -> Optional<Symbol> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => Absent
    Present { value: captured } =>
      match body_lower_type_decl_record_block_optional(captured: captured) {
        Absent => Absent
        Present { value: _ } => dag_surface_kw_then_ident_from_captured(captured: captured)
      }
  }
}

fn body_lower_type_decl(shell: Node) -> Outcome<Node> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => outcome_accepted(value: shell)
    Present { value: captured } =>
      match dag_surface_kw_then_ident_from_captured(captured: captured) {
        Absent => outcome_accepted(value: shell)
        Present { value: type_name } =>
          body_lower_type_decl_named(shell: shell, captured: captured, type_name: type_name, type_params: body_lower_decl_type_params(captured: captured))
      }
  }
}

fn body_lower_type_decl_named(shell: Node, captured: Node, type_name: Symbol, type_params: DeclTypeParams) -> Outcome<Node> {
  match type_params {
    TypeParamsUnreadable =>
      Rejected { diagnostics: diagnostics_singleton(d: body_lower_type_params_unreadable_diagnostic(shell: shell)) }
    NoTypeParams => body_lower_type_decl_by_body(shell: shell, captured: captured, type_name: type_name, type_params: type_params)
    TypeParams { conj: _ } => body_lower_type_decl_by_body(shell: shell, captured: captured, type_name: type_name, type_params: type_params)
  }
}

fn body_lower_type_decl_by_body(shell: Node, captured: Node, type_name: Symbol, type_params: DeclTypeParams) -> Outcome<Node> {
  match body_lower_type_decl_record_block_optional(captured: captured) {
    Present { value: block_shell } =>
      body_lower_record_type_decl(shell: shell, type_name: type_name, block_shell: block_shell, type_params: type_params)
    Absent =>
      match body_lower_find_where_host_conj(root: captured) {
        Present { value: host } =>
          outcome_accepted(value: body_lower_type_decl_member(shell: shell, type_name: type_name, body: host, type_params: type_params))
        Absent =>
          match type_params {
            TypeParams { conj: _ } =>
              body_lower_generic_eq_type_decl(shell: shell, captured: captured, type_name: type_name, type_params: type_params)
            NoTypeParams => outcome_accepted(value: shell)
            TypeParamsUnreadable => outcome_accepted(value: shell)
          }
      }
  }
}

// SERVICE DECLARATIONS, AT DECLARATION GRADE. A service is an interface (DESIGN section 3): a named
// product of function types. `service S { operation Op { input { a: A } output { b: B } } }` lowers
// onto existing connectives only -- `Conj { S: Conj { Op: Arrow(Conj { a: A }, Conj { b: B }) } }`,
// the same Arrow a function TYPE lowers to (body_lower_fn_type_lowered_optional) -- so the graft
// flattens it like a record and the symbol index sees the service, its operations and their
// payload fields. No new node kind (ruling on gunbc adhoc-c537b0c6-a6e: no v2.std.node change, and
// node_minimal's TransportSlot is NOT promoted: transport is a realization handler, not a node field).
//
// WHAT IS NOT LOWERED IS SET ASIDE, TYPED AND LOCATED, UNDER TWO COUNTED REASONS:
//  - body_lowering_reason_realization_member_set_aside: transport / config / exit / response /
//    mock_response. config binds the transport's endpoint and authentication.
//    Realization per DESIGN section 3, never part of the interface, so the interface lowers without it.
//  - body_lowering_reason_interface_member_unmodeled: readonly / idempotent / hermetic and an io
//    field's `from "key"` / `= default` tail. These ARE interface facts (idempotent governs retry,
//    DESIGN section 4b) with no typed carrier yet, so they rank for modeling under their own reason
//    instead of hiding in the realization bucket (rfm service_interface_member_has_no_carrier).
// A set-aside member is UNREACHABLE AS LOWERED: only census grade admits them (v2.compiler.normalize
// normalize_census, whose carrier has no route to eval or emission); every other route refuses the
// service (body_lower_service_decl), so no stage that would need a service's realization can be
// handed a service and assume a transport. The set-aside population is a typed list the lowering
// builds, never a scan of diagnostic reasons. A member this lowering cannot read refuses, located.
//
// THE NAME IS ONE LABEL, THE WHOLE DECLARED SPELLING (`shell.Find`), not a per-segment spine. A
// spine collides at the module (dag/extdeps/shell.dag declares sixteen services under `shell`) and
// needs a prefix merge in namespace_graft. FRONTIER, stated: the dotted label hides named parts
// (DESIGN section 2) and a dotted reference to it does not resolve; the trigger is v2 resolving
// service CALLS, at which point the spine plus a graft prefix merge becomes the required shape and
// this label migrates in one transition.
type ServiceSetAsideKind
  = RealizationMemberSetAside
  | InterfaceMemberUnmodeled

type ServiceSetAside {
  kind: ServiceSetAsideKind,
  member: Node,
}

fn service_set_aside_reason(kind: ServiceSetAsideKind) -> Symbol {
  match kind {
    RealizationMemberSetAside => ^body_lowering_reason_realization_member_set_aside
    InterfaceMemberUnmodeled => ^body_lowering_reason_interface_member_unmodeled
  }
}

fn service_set_aside_diagnostics(xs: List<ServiceSetAside>) -> Diagnostics {
  fold(xs, init: None, f: fn(acc, x) {
    diagnostics_merge(
      outer: acc,
      inner: Some { diagnostics: diagnostics_singleton(d: body_lower_diagnostic(reason: service_set_aside_reason(kind: x.kind), n: x.member)) }
    )
  })
}

// The production shells directly beneath a node, looking through the two choice wrappers
// (service_body_entry, operation_body_entry) that carry no fact of their own.
fn body_lower_service_member_shells(root: Node) -> List<Node> {
  fold(root.children, init: Empty, f: fn(acc, e) {
    list_append(left: acc, right: body_lower_service_member_shells_at(node: e.target))
  })
}

fn body_lower_service_member_shells_at(node: Node) -> List<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if (id == ^dag_surface_service_body_entry) || (id == ^dag_surface_operation_body_entry) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: inner } => body_lower_service_member_shells_at(node: inner)
          Absent => [node]
        }
      } else {
        [node]
      }
    Absent => body_lower_service_member_shells(root: node)
  }
}

// An io field's `[from "key"] [= default]` tail is present when either optional captured anything.
fn body_lower_io_field_tail_present(tail: Node) -> Bool {
  match sugar_sequence_pair_optional(node: tail) {
    Absent => (is_empty_conj_root(n: tail) == false)
    Present { value: pair } =>
      (is_empty_conj_root(n: pair.left) == false) || (is_empty_conj_root(n: pair.right) == false)
  }
}


type BodyLowerIoBlock {
  payload: Node,
  set_aside: List<ServiceSetAside>,
}

fn body_lower_io_block(shell: Node) -> Outcome<BodyLowerIoBlock> {
  let refuse = outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_field_decl_unlowered, n: shell)
  )
  match parse_production_captured_child_optional(node: shell) {
    Absent => refuse
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Absent => refuse
        Present { value: kw } =>
          match sugar_sequence_pair_optional(node: kw.right) {
            Absent => refuse
            Present { value: brace } =>
              match sugar_sequence_pair_optional(node: brace.right) {
                Absent => refuse
                Present { value: inner } =>
                  match body_lower_comma_list_items_optional(list_capture: inner.left) {
                    Absent => refuse
                    Present { value: items } =>
                      match fold(items, init: Present { value: IoAcc { edges: Empty, set_aside: Empty } }, f: fn(acc, item) {
                        match acc {
                          Absent => Absent
                          Present { value: a } =>
                            match sugar_sequence_pair_optional(node: body_lower_deep_unwrap_optional(node: item)) {
                              Absent => Absent
                              Present { value: field } =>
                                match body_lower_field_decl_edge_optional(item: field.left) {
                                  Absent => Absent
                                  Present { value: edge } =>
                                    Present {
                                      value: IoAcc {
                                        edges: list_snoc_item(xs: a.edges, item: edge),
                                        set_aside: if body_lower_io_field_tail_present(tail: field.right) {
                                          list_snoc_item(xs: a.set_aside, item: ServiceSetAside { kind: InterfaceMemberUnmodeled, member: item })
                                        } else {
                                          a.set_aside
                                        }
                                      }
                                    }
                                }
                            }
                        }
                      }) {
                        Absent => refuse
                        Present { value: a } =>
                          outcome_accepted(
                            value: BodyLowerIoBlock { payload: body_lower_payload_node(edges: a.edges, source: shell), set_aside: a.set_aside }
                          )
                      }
                  }
              }
          }
      }
  }
}

type IoAcc {
  edges: List<Edge>,
  set_aside: List<ServiceSetAside>,
}

type BodyLowerOperationAcc {
  input: Optional<Node>,
  output: Optional<Node>,
  set_aside: List<ServiceSetAside>,
}

fn body_lower_operation_member(acc: Outcome<BodyLowerOperationAcc>, member: Node) -> Outcome<BodyLowerOperationAcc> {
  bind_outcome(o: acc, f: fn(a) {
    match parse_production_emitted_identity_optional(node: member) {
      Absent => body_lower_service_member_unread(member: member)
      Present { value: id } =>
        if (id == ^dag_surface_input_block) || (id == ^dag_surface_output_block) {
          bind_outcome(o: body_lower_io_block(shell: member), f: fn(io) {
            if id == ^dag_surface_input_block {
              match a.input {
                Present { value: _ } =>
                  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_io_block_repeated, n: member))
                Absent =>
                  outcome_accepted(value: BodyLowerOperationAcc { input: Present { value: io.payload }, output: a.output, set_aside: list_append(left: a.set_aside, right: io.set_aside) })
              }
            } else {
              match a.output {
                Present { value: _ } =>
                  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_io_block_repeated, n: member))
                Absent =>
                  outcome_accepted(value: BodyLowerOperationAcc { input: a.input, output: Present { value: io.payload }, set_aside: list_append(left: a.set_aside, right: io.set_aside) })
              }
            }
          })
        } else if id == ^dag_surface_op_modifier {
          body_lower_operation_acc_set_aside(a: a, kind: InterfaceMemberUnmodeled, n: member)
        } else if (id == ^dag_surface_transport)
          || (id == ^dag_surface_exit_block)
          || (id == ^dag_surface_response_block)
          || (id == ^dag_surface_mock_response_block) {
          body_lower_operation_acc_set_aside(a: a, kind: RealizationMemberSetAside, n: member)
        } else {
          body_lower_service_member_unread(member: member)
        }
    }
  })
}

fn body_lower_operation_acc_set_aside(a: BodyLowerOperationAcc, kind: ServiceSetAsideKind, n: Node) -> Outcome<BodyLowerOperationAcc> {
  outcome_accepted(
    value: BodyLowerOperationAcc {
      input: a.input,
      output: a.output,
      set_aside: list_snoc_item(xs: a.set_aside, item: ServiceSetAside { kind: kind, member: n })
    }
  )
}

// A member this lowering cannot read REFUSES, located at the member: a partially read service has
// no representation, so nothing is kept and nothing is dropped.
fn body_lower_service_member_unread<T>(member: Node) -> Outcome<T> {
  outcome_rejected(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_member_unread, n: member))
}

// An operation that declares no input (or no output) block exchanges the empty product.
fn body_lower_io_payload_or_empty(o: Optional<Node>, source: Node) -> Node {
  match o {
    Present { value: payload } => payload
    Absent => body_lower_payload_node(edges: Empty, source: source)
  }
}

type BodyLowerOperation {
  edge: Edge,
  set_aside: List<ServiceSetAside>,
}

fn body_lower_operation(shell: Node) -> Outcome<BodyLowerOperation> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => body_lower_service_member_unread(member: shell)
    Present { value: captured } =>
      match dag_surface_kw_then_ident_from_captured(captured: captured) {
        Absent => body_lower_service_member_unread(member: shell)
        Present { value: op_name } =>
          bind_outcome(
            o: fold(
              body_lower_service_member_shells(root: captured),
              init: outcome_accepted(value: BodyLowerOperationAcc { input: Absent, output: Absent, set_aside: Empty }),
              f: fn(acc, member) { body_lower_operation_member(acc: acc, member: member) }
            ),
            f: fn(a) {
              outcome_accepted(
                value: BodyLowerOperation {
                  edge: Edge {
                    label: Named { name: op_name },
                    target: node_with_occurrence_id(
                      kind: TypeNode { connective: Arrow },
                      children: [
                        Edge { label: Positional, target: body_lower_io_payload_or_empty(o: a.input, source: shell) },
                        Edge { label: Positional, target: body_lower_io_payload_or_empty(o: a.output, source: shell) }
                      ],
                      occurrence_id: shell.occurrence_id
                    )
                  },
                  set_aside: a.set_aside
                }
              )
            }
          )
      }
  }
}

type BodyLowerServiceAcc {
  operations: List<Edge>,
  operation_shells: List<Node>,
  set_aside: List<ServiceSetAside>,
}

fn body_lower_service_member(acc: Outcome<BodyLowerServiceAcc>, member: Node) -> Outcome<BodyLowerServiceAcc> {
  bind_outcome(o: acc, f: fn(a) {
    match parse_production_emitted_identity_optional(node: member) {
      Absent => body_lower_service_member_unread(member: member)
      Present { value: id } =>
        if id == ^dag_surface_qualified_name {
          outcome_accepted(value: a)
        } else if id == ^dag_surface_operation {
          bind_outcome(o: body_lower_operation(shell: member), f: fn(op) {
            outcome_accepted(
              value: BodyLowerServiceAcc {
                operations: list_snoc_item(xs: a.operations, item: op.edge),
                operation_shells: list_snoc_item(xs: a.operation_shells, item: member),
                set_aside: list_append(left: a.set_aside, right: op.set_aside)
              }
            )
          })
        } else if (id == ^dag_surface_transport) || (id == ^dag_surface_service_config) {
          outcome_accepted(
            value: BodyLowerServiceAcc {
              operations: a.operations,
              operation_shells: a.operation_shells,
              set_aside: list_snoc_item(xs: a.set_aside, item: ServiceSetAside { kind: RealizationMemberSetAside, member: member })
            }
          )
        } else {
          body_lower_service_member_unread(member: member)
        }
    }
  })
}

fn body_lower_service_name_optional(captured: Node) -> Optional<Symbol> {
  match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_qualified_name) {
    Absent => Absent
    Present { value: qn_shell } =>
      match parse_production_captured_child_optional(node: qn_shell) {
        Absent => Absent
        Present { value: qn_capture } =>
          match parse_qualified_name_segments_from_capture(qn_capture: qn_capture, root: qn_shell) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: segments, diagnostics: _ } =>
              optional_present(value: symbol_intern_lexeme(lexeme: qualified_name_to_dotted_string(qn: segments)))
          }
      }
  }
}

// THE TWO GRADES DIFFER ONLY IN WHAT A SET-ASIDE MEMBER MEANS. At census grade
// (v2.compiler.normalize normalize_census, whose carrier has no route past the symbol index) the
// interface is admitted and each set-aside member rides as a located advisory. On every other route
// the lowered service would reach resolution, eval or emission, each of which would have to assume
// the set-aside facts, so it REFUSES at the service with every member's own located diagnostic
// pending: a set-aside realization is unreachable as lowered by construction, not by a door that
// scans reasons.
fn body_lower_service_decl(shell: Node, admit_set_aside: Bool) -> Outcome<BodyLowering> {
  match parse_production_captured_child_optional(node: shell) {
    Absent => body_lower_wrapper_retained_shell(shell: shell)
    Present { value: captured } =>
      match body_lower_service_name_optional(captured: captured) {
        Absent => body_lower_wrapper_retained_shell(shell: shell)
        Present { value: service_name } =>
          match fold(
            body_lower_service_member_shells(root: captured),
            init: outcome_accepted(value: BodyLowerServiceAcc { operations: Empty, operation_shells: Empty, set_aside: Empty }),
            f: fn(acc, member) { body_lower_service_member(acc: acc, member: member) }
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: a, diagnostics: _ } =>
              match first(repeated_name_edges(children: a.operations)) {
                Present { value: repeated } =>
                  outcome_rejected(
                    d: body_lower_diagnostic(
                      reason: ^body_lowering_reason_service_operation_repeated,
                      n: body_lower_service_second_operation_shell(operations: a.operations, shells: a.operation_shells, label: repeated.label, service: shell)
                    )
                  )
                Absent =>
              match a.set_aside {
                Empty => body_lowering_lowered(o: outcome_accepted(value: body_lower_service_node(shell: shell, service_name: service_name, operations: a.operations)))
                Cons { head: _, tail: _ } =>
                  if admit_set_aside {
                    Accepted {
                      value: BodyLowered { node: body_lower_service_node(shell: shell, service_name: service_name, operations: a.operations) },
                      diagnostics: service_set_aside_diagnostics(xs: a.set_aside)
                    }
                  } else {
                    Rejected {
                      diagnostics: rejected_with_pending(
                        pending: service_set_aside_diagnostics(xs: a.set_aside),
                        rejected: diagnostics_singleton(d: body_lower_diagnostic(reason: ^body_lowering_reason_service_realization_unreachable, n: shell))
                      )
                    }
                  }
              }
              }
          }
      }
  }
}

// AN OPERATION NAME IS DECLARED ONCE PER SERVICE. The repeat is read once, over the finished
// operation list, from v2.std.node_query repeated_name_edges; this only locates it, at the SECOND
// operation shell carrying that name, so the refusal names the declaration that repeated it.
type BodyLowerServiceRepeatScan {
  shells: List<Node>,
  matched: Int,
  located: Optional<Node>,
}

fn body_lower_service_second_operation_shell(operations: List<Edge>, shells: List<Node>, label: EdgeLabel, service: Node) -> Node {
  let scanned = fold(operations, init: BodyLowerServiceRepeatScan { shells: shells, matched: 0, located: Absent }, f: fn(acc, e) {
    match acc.shells {
      Empty => acc
      Cons { head: sh, tail: more } =>
        if (e.label == label) && (acc.matched == 1) {
          BodyLowerServiceRepeatScan { shells: more, matched: 2, located: Present { value: sh } }
        } else if e.label == label {
          BodyLowerServiceRepeatScan { shells: more, matched: acc.matched + 1, located: acc.located }
        } else {
          BodyLowerServiceRepeatScan { shells: more, matched: acc.matched, located: acc.located }
        }
    }
  })
  match scanned.located {
    Absent => service
    Present { value: sh } => sh
  }
}

fn body_lower_service_node(shell: Node, service_name: Symbol, operations: List<Edge>) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: service_name }, target: body_lower_payload_node(edges: operations, source: shell) }
    ],
    occurrence_id: shell.occurrence_id
  )
}

fn body_lower_production_emitted(shell: Node, emitted: Symbol, fn_body_pass_through: Bool) -> Outcome<BodyLowering> {
  if emitted == ^dag_surface_service_decl {
    body_lower_service_decl(shell: shell, admit_set_aside: false)
  } else if emitted == ^dag_surface_type_decl {
    body_lowering_lowered(o: body_lower_type_decl(shell: shell))
  } else if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
    body_lowering_lowered(o: outcome_accepted(value: shell))
  } else if emitted == ^dag_surface_type_variant {
    body_lowering_lowered(o: body_lower_type_variant(shell: shell))
  } else if body_lower_is_structure_preserved_emitted(emitted: emitted) {
    body_lowering_lowered(o: outcome_accepted(value: shell))
  } else if emitted == ^dag_surface_fn_body && fn_body_pass_through {
    body_lowering_lowered(o: outcome_accepted(value: shell))
  } else if body_lower_is_deferred_lower_emitted(emitted: emitted) {
    body_lowering_lowered(o: outcome_accepted(value: shell))
  } else if body_producer_forward_is_registered_surface_identity(surface_identity: emitted) {
    body_lower_forward_row_apply(shell: shell, emitted: emitted)
  } else if emitted == ^dag_surface_postfix_expr {
    body_lowering_lowered(o: body_lower_postfix_expr(shell: shell))
  } else if body_lower_is_pass_through_emitted(emitted: emitted) {
    body_lowering_lowered(o: body_lower_unwrap_pass_through(shell: shell))
  } else if emitted == ^dag_surface_primary_expr {
    body_lowering_lowered(o: body_lower_primary_expr(shell: shell))
  } else {
    body_lower_wrapper_retained_shell(shell: shell)
  }
}

// AN ELSE-LESS `if` IS REFUSED, NEVER DROPPED OR REWRITTEN. It is an early exit
// (v2.extdeps.languages.dag dag_grammar_else_less_if_stmt_expr), and the v2 core has no lowering for
// early exit yet; lowering it to Branch(cond, then, rest-of-block) is a separate control-flow model.
// Until that lands the statement is a typed, located, counted refusal.
fn body_lower_else_less_if_reject(shell: Node) -> Outcome<Node> {
  outcome_rejected(
    d: body_lower_diagnostic(reason: ^body_lowering_reason_else_less_if_unlowered, n: shell)
  )
}

fn body_lower_after_children(folded: Node, fn_body_pass_through: Bool) -> Outcome<BodyLowering> {
  if body_lower_is_core_substrate(node: folded) {
    body_lowering_lowered(o: outcome_accepted(value: folded))
  } else if dag_resolve_preserve_module_metadata_subtree(node: folded) {
    body_lowering_lowered(o: outcome_accepted(value: folded))
  } else {
    match parse_production_emitted_identity_optional(node: folded) {
      Absent => body_lowering_lowered(o: outcome_accepted(value: folded))
      Present { value: emitted } =>
        if emitted == ^dag_surface_else_less_if_stmt {
          body_lowering_lowered(o: body_lower_else_less_if_reject(shell: folded))
        } else {
          body_lower_production_emitted(
            shell: folded,
            emitted: emitted,
            fn_body_pass_through: fn_body_pass_through
          )
        }
    }
  }
}

fn body_lower_finish(n: Node, folded: Node, cd: Diagnostics) -> Outcome<BodyLowering> {
  body_lower_finish_for_normalize(
    n: n,
    folded: folded,
    cd: cd,
    fn_body_pass_through: false
  )
}

fn body_lower_finish_for_normalize(
  n: Node,
  folded: Node,
  cd: Diagnostics,
  fn_body_pass_through: Bool
) -> Outcome<BodyLowering> {
  body_lowering_after_pending(
    pending: cd,
    o: body_lower_after_children(folded: folded, fn_body_pass_through: fn_body_pass_through)
  )
}

