  node_subtree_count
}
import v2.std.node_query { find_named_child }

data body_lowering_fold_note: String = "Forward body producer fold (general-body-producer Stage A remainder + B/C/D): production-identity dispatch in normalize AFTER child-fold, BEFORE sugar (body_lower_finish in 03_normalize.dag). INTERIM scaffold — dissolves into FLAG E one SugarKey table (general-body-producer-design §9) once Slices 0–1 receipts land; no permanent sibling hand-inlined arm. COMPLEMENTS #6443 fold_lowering.dag — does NOT re-fork it. Seam: fold_lowering owns fold-CALL semantic desugar (callee-head keyed: ^fold/^fold_list/… → seam Loop via fold_call_to_loop); body_lowering_fold owns fn-BODY shape lowering (fn_decl→Arrow+domain, infix→Transform, let→Bind, …). The only overlap point is body_lower_try_fold_loop which DELEGATES to fold_call_to_loop — one authority, no parallel fold→Loop path. Pass-through expr wrappers unwrap; ^dag_surface_fn_body is deferred (shell retained until parent fn_decl lowers); metadata (module/import/qn) preserved; core substrate (Arrow, ComputationNode) is a positive terminal; out-of-scope emitted identities land wrapper-retained with typed diagnostic ^body_lowering_reason_wrapper_retained_emitted (general-body-producer-design Stage A frontier: lowered | wrapper-retained cause, counted — never silent shell accept)."

data body_lowering_fold_dissolution_contract: String = "FLAG E dissolution DELETES this module — do NOT port its interim walker arms into the SugarKey table. The hand-authored families (body_lower_deep_unwrap*, body_lower_operand_ref*, body_lower_operator_tail/infix*, body_lower_postfix_projection*) are receipt scaffolding only; the row-selected GrammarRelationRow forward fold (general-body-producer-design §3) replaces them wholesale. Acceptance: this file is gone and coverage lives in forward rows + existing witnesses."

type BodyLoweringInterimScaffoldDisposition
  = SeedRetained { reason: Symbol, migration_trigger: Symbol }

type BodyLoweringInterimScaffoldRow {
  site: Symbol
  disposition: BodyLoweringInterimScaffoldDisposition
}

data body_lowering_interim_scaffold_row_match_hand_walker: BodyLoweringInterimScaffoldRow = BodyLoweringInterimScaffoldRow {
  site: ^body_lower_try_match_from_node,
  disposition: SeedRetained {
    reason: ^body_lowering_match_interim_hand_walker_reason,
    migration_trigger: ^migrate_when_general_body_producer_lands
  }
}

fn body_lowering_interim_scaffold_rows() -> List<BodyLoweringInterimScaffoldRow> {
  Cons {
    head: body_lowering_interim_scaffold_row_match_hand_walker,
    tail: Empty
  }
}

fn body_lowering_interim_scaffold_seed_retained_count() -> Int {
  length(xs: body_lowering_interim_scaffold_rows())
}

fn body_lower_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn body_lower_wrapper_retained_diagnostic(n: Node) -> Diagnostic {
  body_lower_diagnostic(reason: ^body_lowering_reason_wrapper_retained_emitted, n: n)
}

fn body_lower_canonical_type_binding_optional(sym: Symbol) -> Optional<Symbol> {
  if sym == dag_int_type_binding() {
    optional_present(value: sym)
  } else if symbol_lexeme(sym: sym) == "Int" {
    optional_present(value: dag_int_type_binding())
  } else if symbol_lexeme(sym: sym) == "Bool" {
    optional_present(value: ^bool_node_symbol)
  } else {
    optional_absent()
  }
}

fn body_lower_resolved_type_binding(sym: Symbol) -> Symbol {
  match body_lower_canonical_type_binding_optional(sym: sym) {
    Present { value: canonical } => canonical
    Absent => sym
  }
}

fn body_lower_type_atom_node(sym: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: body_lower_resolved_type_binding(sym: sym) } },
    children: []
  )
}

fn body_lower_wrapper_retained_shell(remaining: Int, shell: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    Accepted {
      value: shell,
      diagnostics: Some {
        diagnostics: diagnostics_singleton(d: body_lower_wrapper_retained_diagnostic(n: shell))
      }
    }
  }
}

fn body_lower_is_core_substrate(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Arrow } => true
    ComputationNode { behavior: _ } => true
    _ => false
  }
}

fn body_lower_is_pass_through_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_expr)
    || (emitted == ^dag_surface_binary_expr)
    || (emitted == ^dag_surface_unary_expr)
    || (emitted == ^dag_surface_postfix_expr)
    || (emitted == ^dag_surface_block_expr)
    || (emitted == ^dag_surface_stmt)
    || (emitted == ^dag_surface_stmt_seq)
    || (emitted == ^dag_surface_arg)
}

fn body_lower_is_deferred_lower_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_fn_body)
    || (emitted == ^dag_surface_pattern)
    || (emitted == ^dag_surface_match_arm)
    || (emitted == ^dag_surface_match_arm_stmt_body)
}

fn body_lower_is_metadata_preserved_emitted(emitted: Symbol) -> Bool {
  (emitted == ^dag_surface_module)
    || (emitted == ^dag_surface_module_header)
    || (emitted == ^dag_surface_import_decl)
    || (emitted == ^dag_surface_qualified_name)
    || (emitted == ^dag_surface_top_level_item)
    || (emitted == ^dag_surface_generic_params)
    || (emitted == ^dag_surface_param_list)
    || (emitted == ^dag_surface_type_expr)
    || (emitted == ^dag_surface_type_decl)
    || (emitted == ^dag_surface_data_decl)
    || (emitted == ^dag_surface_import_block)
}

fn body_lower_param_ref_atom(identity: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: []
  )
}

fn body_lower_operand_ref_optional(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match parse_production_emitted_identity_optional(node: node) {
      Present { value: emitted } =>
        if body_lower_is_pass_through_emitted(emitted: emitted) {
          match parse_production_captured_child_optional(node: node) {
            Present { value: captured } =>
              body_lower_operand_ref_optional(remaining: remaining - 1, node: captured)
            Absent => outcome_accepted(value: optional_absent())
          }
        } else if emitted == ^dag_surface_primary_expr {
          match parse_production_captured_child_optional(node: node) {
            Present { value: captured } =>
              body_lower_operand_ref_optional(remaining: remaining - 1, node: captured)
            Absent => outcome_accepted(value: optional_absent())
          }
        } else {
          outcome_accepted(value: optional_absent())
        }
      Absent =>
        match dag_binding_branded_atom_identity(node: node) {
          Present { value: binding } =>
            outcome_accepted(value: optional_present(value: body_lower_param_ref_atom(identity: binding)))
          Absent =>
            match node_atom_identity_optional(node: node) {
              Present { value: id } =>
                if dag_lex_token_symbol(sym: id) {
                  if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                    outcome_accepted(value: optional_present(value: body_lower_param_ref_atom(identity: id)))
                  } else {
                    outcome_accepted(value: optional_absent())
                  }
                } else {
                  outcome_accepted(value: optional_present(value: body_lower_param_ref_atom(identity: id)))
                }
              Absent =>
                match sugar_sequence_pair_optional(node: node) {
                  Present { value: pair } =>
                    body_lower_operand_ref_optional(remaining: remaining - 1, node: pair.left)
                  Absent =>
                    match parse_production_captured_child_optional(node: node) {
                      Present { value: captured } =>
                        body_lower_operand_ref_optional(remaining: remaining - 1, node: captured)
                      Absent =>
                        fold(node.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
                          match acc_outcome {
                            Rejected { diagnostics: r } => Rejected { diagnostics: r }
                            Accepted { value: acc, diagnostics: _ } =>
                              match acc {
                                Present { value: _ } => acc_outcome
                                Absent =>
                                  body_lower_operand_ref_optional(remaining: remaining - 1, node: e.target)
                              }
                          }
                        })
                    }
                }
            }
        }
    }
  }
}

fn body_lower_operator_atom_optional(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match node_atom_identity_optional(node: node) {
      Present { value: id } =>
        if dag_lex_token_symbol(sym: id) {
          outcome_accepted(
            value: optional_present(
              value: node_synthetic(
                kind: TypeNode { connective: Atom { identity: id } },
                children: []
              )
            )
          )
        } else {
          outcome_accepted(value: optional_absent())
        }
      Absent => outcome_accepted(value: optional_absent())
    }
  }
}

fn body_lower_unwrap_captured(remaining: Int, shell: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    outcome_accepted(value: parse_production_captured_child_optional(node: shell))
  }
}

fn body_lower_infix_from_operator_seq(remaining: Int, left: Node, op_seq: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: op_seq))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: op_seq)
    match sugar_sequence_pair_optional(node: stripped) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_operator_atom_optional(remaining: remaining - 1, node: pair.left),
          f: fn(op_opt) {
            match op_opt {
              Absent => outcome_accepted(value: optional_absent())
              Present { value: operator } =>
                bind_outcome(
                  o: body_lower_operand_ref_optional(remaining: remaining - 1, node: pair.right),
                  f: fn(right_opt) {
                    match right_opt {
                      Absent => outcome_accepted(value: optional_absent())
                      Present { value: right } =>
                        outcome_accepted(
                          value: optional_present(
                            value: lower_binary_infix(left: left, operator: operator, right: right)
                          )
                        )
                    }
                  }
                )
            }
          }
        )
    }
  }
}

fn body_lower_infix_from_operator_tail(remaining: Int, left: Node, tail: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: tail))
  } else {
    match sugar_sequence_pair_optional(node: tail) {
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_infix_from_operator_seq(remaining: remaining - 1, left: left, op_seq: pair.left),
          f: fn(found_opt) {
            match found_opt {
              Present { value: found } => outcome_accepted(value: optional_present(value: found))
              Absent =>
                body_lower_infix_from_operator_tail(remaining: remaining - 1, left: left, tail: pair.right)
            }
          }
        )
      Absent =>
        match find_named_child(root: tail, name: ^grammar_repeat_element_node_projection) {
          Accepted { value: repeat_elem, diagnostics: _ } =>
            body_lower_infix_from_repeat_element(remaining: remaining - 1, left: left, repeat_elem: repeat_elem)
          Rejected { diagnostics: _ } => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_infix_from_repeat_element(remaining: Int, left: Node, repeat_elem: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_elem))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: repeat_elem)
    match sugar_sequence_pair_optional(node: stripped) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_operator_atom_optional(remaining: remaining - 1, node: pair.left),
          f: fn(op_opt) {
            match op_opt {
              Present { value: operator } =>
                bind_outcome(
                  o: body_lower_operand_ref_optional(remaining: remaining - 1, node: pair.right),
                  f: fn(right_opt) {
                    match right_opt {
                      Absent => outcome_accepted(value: optional_absent())
                      Present { value: right } =>
                        outcome_accepted(
                          value: optional_present(
                            value: lower_binary_infix(left: left, operator: operator, right: right)
                          )
                        )
                    }
                  }
                )
              Absent =>
                match sugar_sequence_pair_optional(node: pair.right) {
                  Present { value: inner } =>
                    bind_outcome(
                      o: body_lower_operator_atom_optional(remaining: remaining - 1, node: inner.left),
                      f: fn(inner_op_opt) {
                        match inner_op_opt {
                          Present { value: operator } =>
                            bind_outcome(
                              o: body_lower_operand_ref_optional(remaining: remaining - 1, node: inner.right),
                              f: fn(right_opt) {
                                match right_opt {
                                  Absent => outcome_accepted(value: optional_absent())
                                  Present { value: right } =>
                                    outcome_accepted(
                                      value: optional_present(
                                        value: lower_binary_infix(
                                          left: left,
                                          operator: operator,
                                          right: right
                                        )
                                      )
                                    )
                                }
                              }
                            )
                          Absent => outcome_accepted(value: optional_absent())
                        }
                      }
                    )
                  Absent => outcome_accepted(value: optional_absent())
                }
            }
          }
        )
    }
  }
}

fn body_lower_try_infix_from_sequence(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    let stripped = body_lower_unwrap_surface_shell(remaining: remaining - 1, node: node)
    match sugar_sequence_pair_optional(node: stripped) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_operand_ref_optional(remaining: remaining - 1, node: pair.left),
          f: fn(left_opt) {
            match left_opt {
              Absent => outcome_accepted(value: optional_absent())
              Present { value: left } =>
                body_lower_infix_from_operator_tail(remaining: remaining - 1, left: left, tail: pair.right)
            }
          }
        )
    }
  }
}

fn body_lower_try_infix_transform(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    let stripped = body_lower_unwrap_surface_shell(remaining: remaining - 1, node: node)
    bind_outcome(
      o: body_lower_try_infix_from_sequence(remaining: remaining - 1, node: stripped),
      f: fn(seq_opt) {
        match seq_opt {
          Present { value: transform } => outcome_accepted(value: optional_present(value: transform))
          Absent =>
            match sugar_sequence_pair_optional(node: stripped) {
              Present { value: pair } =>
                bind_outcome(
                  o: body_lower_try_infix_transform(remaining: remaining - 1, node: pair.left),
                  f: fn(left_opt) {
                    match left_opt {
                      Present { value: transform } =>
                        outcome_accepted(value: optional_present(value: transform))
                      Absent => body_lower_try_infix_transform(remaining: remaining - 1, node: pair.right)
                    }
                  }
                )
              Absent =>
                match find_named_child(root: stripped, name: ^grammar_repeat_element_node_projection) {
                  Accepted { value: repeat_elem, diagnostics: _ } =>
                    bind_outcome(
                      o: body_lower_try_infix_transform(remaining: remaining - 1, node: repeat_elem),
                      f: fn(repeat_opt) {
                        match repeat_opt {
                          Present { value: transform } =>
                            outcome_accepted(value: optional_present(value: transform))
                          Absent =>
                            match parse_production_captured_child_optional(node: stripped) {
                              Present { value: captured } =>
                                body_lower_try_infix_transform(remaining: remaining - 1, node: captured)
                              Absent =>
                                fold(stripped.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
                                  match acc_outcome {
                                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                    Accepted { value: acc, diagnostics: _ } =>
                                      match acc {
                                        Present { value: _ } => acc_outcome
                                        Absent =>
                                          body_lower_try_infix_transform(remaining: remaining - 1, node: e.target)
                                      }
                                  }
                                })
                            }
                        }
                      }
                    )
                  Rejected { diagnostics: _ } =>
                    match parse_production_captured_child_optional(node: stripped) {
                      Present { value: captured } =>
                        body_lower_try_infix_transform(remaining: remaining - 1, node: captured)
                      Absent =>
                        fold(stripped.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
                          match acc_outcome {
                            Rejected { diagnostics: r } => Rejected { diagnostics: r }
                            Accepted { value: acc, diagnostics: _ } =>
                              match acc {
                                Present { value: _ } => acc_outcome
                                Absent =>
                                  body_lower_try_infix_transform(remaining: remaining - 1, node: e.target)
                              }
                          }
                        })
                    }
                }
            }
        }
      }
    )
  }
}

fn body_lower_try_fold_loop_search(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_primary_expr {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_try_fold_loop(remaining: remaining - 1, node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else if body_lower_is_pass_through_emitted(emitted: id) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_try_fold_loop(remaining: remaining - 1, node: captured)
          Absent => outcome_accepted(value: optional_absent())
        }
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent =>
      fold(node.children, init: outcome_accepted(value: optional_absent()), f: fn(acc, e) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: found, diagnostics: _ } =>
            match found {
              Present { value: _ } => acc
              Absent => body_lower_try_fold_loop(remaining: remaining - 1, node: e.target)
            }
        }
      })
    }
}
}

fn body_lower_try_fold_loop(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match fold_call_head_symbol(fold_call: node) {
    Present { value: head } =>
      if fold_family_head(sym: head) {
        match fold_call_to_loop(fold_call: node) {
          Accepted { value: loop_node, diagnostics: _ } =>
            outcome_accepted(value: optional_present(value: loop_node))
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
        }
      } else {
        body_lower_try_fold_loop_search(remaining: remaining - 1, node: node)
      }
    Absent => body_lower_try_fold_loop_search(remaining: remaining - 1, node: node)
    }
}
}

fn body_lower_type_atom_from_expr(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match parse_production_emitted_identity_optional(node: node) {
      Present { value: id } =>
        if id == ^dag_surface_type_expr {
          match parse_production_captured_child_optional(node: node) {
            Present { value: captured } =>
              body_lower_type_atom_from_expr(remaining: remaining - 1, node: captured)
            Absent => outcome_accepted(value: optional_absent())
          }
        } else if id == ^dag_surface_qualified_name {
          match parse_production_captured_child_optional(node: node) {
            Present { value: captured } =>
              match node_atom_identity_optional(node: captured) {
                Present { value: sym } =>
                  outcome_accepted(value: optional_present(value: body_lower_type_atom_node(sym: sym)))
                Absent => body_lower_type_atom_from_expr(remaining: remaining - 1, node: captured)
              }
            Absent => outcome_accepted(value: optional_absent())
          }
        } else {
          outcome_accepted(value: optional_absent())
        }
      Absent =>
        match dag_binding_branded_atom_identity(node: node) {
          Present { value: binding } =>
            outcome_accepted(value: optional_present(value: body_lower_type_atom_node(sym: binding)))
          Absent =>
            match node_atom_identity_optional(node: node) {
              Present { value: sym } =>
                if dag_lex_token_symbol(sym: sym) {
                  outcome_accepted(value: optional_absent())
                } else {
                  outcome_accepted(value: optional_present(value: body_lower_type_atom_node(sym: sym)))
                }
              Absent =>
                match sugar_sequence_pair_optional(node: node) {
                  Present { value: pair } =>
                    bind_outcome(
                      o: body_lower_type_atom_from_expr(remaining: remaining - 1, node: pair.left),
                      f: fn(left_opt) {
                        match left_opt {
                          Present { value: found } => outcome_accepted(value: optional_present(value: found))
                          Absent => body_lower_type_atom_from_expr(remaining: remaining - 1, node: pair.right)
                        }
                      }
                    )
                  Absent =>
                    fold(node.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
                      match acc_outcome {
                        Rejected { diagnostics: r } => Rejected { diagnostics: r }
                        Accepted { value: acc, diagnostics: _ } =>
                          match acc {
                            Present { value: _ } => acc_outcome
                            Absent =>
                              body_lower_type_atom_from_expr(remaining: remaining - 1, node: e.target)
                          }
                      }
                    })
                }
            }
        }
    }
  }
}

fn body_lower_unwrap_surface_shell(remaining: Int, node: Node) -> Node {
  match remaining <= 0 {
    true => node
    false =>
      match parse_production_emitted_identity_optional(node: node) {
      Present { value: emitted } =>
      if body_lower_is_pass_through_emitted(emitted: emitted) {
        match parse_production_captured_child_optional(node: node) {
          Present { value: captured } => body_lower_unwrap_surface_shell(remaining: remaining - 1, node: captured)
          Absent => node
        }
      } else {
        node
      }
      Absent => node
  }
  }
}

fn body_lower_after_comma_tail_optional(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match sugar_sequence_pair_optional(node: node) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        match node_atom_identity_optional(node: pair.left) {
          Present { value: id } =>
            if id == ^dag_token_comma {
              outcome_accepted(value: optional_present(value: pair.right))
            } else {
              outcome_accepted(value: optional_absent())
            }
          Absent => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_typed_param_from_comma_seq(remaining: Int, sequence_capture: Node) -> Outcome<Optional<Edge>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: sequence_capture))
  } else {
    match sugar_sequence_pair_optional(node: sequence_capture) {
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_typed_param_edge(remaining: remaining - 1, param_capture: pair.right),
          f: fn(right_opt) {
            match right_opt {
              Present { value: edge } => outcome_accepted(value: optional_present(value: edge))
              Absent => body_lower_typed_param_edge(remaining: remaining - 1, param_capture: pair.left)
            }
          }
        )
      Absent => body_lower_typed_param_edge(remaining: remaining - 1, param_capture: sequence_capture)
    }
  }
}

fn body_lower_collect_param_edges_from_repeat_tail(remaining: Int, repeat_capture: Node) -> Outcome<List<Edge>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_capture))
  } else if is_empty_conj_root(n: repeat_capture) {
    outcome_accepted(value: Empty)
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: head_sequence, diagnostics: _ } =>
        bind_outcome(
          o: body_lower_typed_param_from_comma_seq(remaining: remaining - 1, sequence_capture: head_sequence),
          f: fn(edge_opt) {
            match edge_opt {
              Present { value: edge } =>
                match find_named_child(
                  root: repeat_capture,
                  name: ^grammar_sequence_right_node_projection
                ) {
                  Accepted { value: tail, diagnostics: _ } =>
                    bind_outcome(
                      o: body_lower_collect_param_edges_from_repeat_tail(
                        remaining: remaining - 1,
                        repeat_capture: tail
                      ),
                      f: fn(rest) {
                        outcome_accepted(value: list_append(left: [edge], right: rest))
                      }
                    )
                  Rejected { diagnostics: _ } => outcome_accepted(value: [edge])
                }
              Absent =>
                match find_named_child(
                  root: repeat_capture,
                  name: ^grammar_sequence_right_node_projection
                ) {
                  Accepted { value: tail, diagnostics: _ } =>
                    body_lower_collect_param_edges_from_repeat_tail(
                      remaining: remaining - 1,
                      repeat_capture: tail
                    )
                  Rejected { diagnostics: _ } => outcome_accepted(value: Empty)
                }
            }
          }
        )
      Rejected { diagnostics: _ } => outcome_accepted(value: Empty)
    }
  }
}

fn body_lower_collect_param_edges(remaining: Int, sequence_capture: Node) -> Outcome<List<Edge>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: sequence_capture))
  } else {
    match find_named_child(root: sequence_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: first, diagnostics: _ } =>
        bind_outcome(
          o: body_lower_typed_param_edge(remaining: remaining - 1, param_capture: first),
          f: fn(first_opt) {
            let first_edges = match first_opt {
              Present { value: edge } => [edge]
              Absent => Empty
            }
            match find_named_child(root: sequence_capture, name: ^grammar_sequence_right_node_projection) {
              Accepted { value: outer_right, diagnostics: _ } =>
                match find_named_child(root: outer_right, name: ^grammar_sequence_left_node_projection) {
                  Accepted { value: repeat_capture, diagnostics: _ } =>
                    bind_outcome(
                      o: body_lower_collect_param_edges_from_repeat_tail(
                        remaining: remaining - 1,
                        repeat_capture: repeat_capture
                      ),
                      f: fn(rest) {
                        outcome_accepted(value: list_append(left: first_edges, right: rest))
                      }
                    )
                  Rejected { diagnostics: _ } => outcome_accepted(value: first_edges)
                }
              Rejected { diagnostics: _ } => outcome_accepted(value: first_edges)
            }
          }
        )
      Rejected { diagnostics: _ } =>
        bind_outcome(
          o: body_lower_typed_param_edge(remaining: remaining - 1, param_capture: sequence_capture),
          f: fn(edge_opt) {
            match edge_opt {
              Present { value: edge } => outcome_accepted(value: [edge])
              Absent =>
                match sugar_sequence_pair_optional(node: sequence_capture) {
                  Absent => outcome_accepted(value: Empty)
                  Present { value: pair } =>
                    bind_outcome(
                      o: body_lower_typed_param_edge(remaining: remaining - 1, param_capture: pair.left),
                      f: fn(left_opt) {
                        match left_opt {
                          Present { value: edge } =>
                            bind_outcome(
                              o: body_lower_after_comma_tail_optional(remaining: remaining - 1, node: pair.right),
                              f: fn(tail_opt) {
                                match tail_opt {
                                  Present { value: tail } =>
                                    bind_outcome(
                                      o: body_lower_collect_param_edges(remaining: remaining - 1, sequence_capture: tail),
                                      f: fn(rest) {
                                        outcome_accepted(value: list_append(left: [edge], right: rest))
                                      }
                                    )
                                  Absent => outcome_accepted(value: [edge])
                                }
                              }
                            )
                          Absent =>
                            bind_outcome(
                              o: body_lower_after_comma_tail_optional(remaining: remaining - 1, node: pair.right),
                              f: fn(tail_opt) {
                                match tail_opt {
                                  Present { value: tail } =>
                                    body_lower_collect_param_edges(remaining: remaining - 1, sequence_capture: tail)
                                  Absent => outcome_accepted(value: Empty)
                                }
                              }
                            )
                        }
                      }
                    )
                }
            }
          }
        )
    }
  }
}

fn body_lower_param_binding_optional(remaining: Int, node: Node) -> Outcome<Optional<Symbol>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match dag_binding_branded_atom_identity(node: node) {
      Present { value: binding } =>
        outcome_accepted(value: optional_present(value: binding))
      Absent =>
        match node_atom_identity_optional(node: node) {
          Present { value: sym } =>
            if dag_lex_token_symbol(sym: sym) {
              outcome_accepted(value: optional_absent())
            } else {
              outcome_accepted(value: optional_present(value: sym))
            }
          Absent =>
            bind_outcome(
              o: body_lower_operand_ref_optional(remaining: remaining - 1, node: node),
              f: fn(ref_opt) {
                match ref_opt {
                  Present { value: ref_node } =>
                    match node_atom_identity_optional(node: ref_node) {
                      Present { value: sym } => outcome_accepted(value: optional_present(value: sym))
                      Absent => outcome_accepted(value: optional_absent())
                    }
                  Absent => outcome_accepted(value: optional_absent())
                }
              }
            )
        }
    }
  }
}

fn body_lower_typed_param_edge(remaining: Int, param_capture: Node) -> Outcome<Optional<Edge>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: param_capture))
  } else {
    match sugar_sequence_pair_optional(node: param_capture) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_param_binding_optional(remaining: remaining - 1, node: pair.left),
          f: fn(binding_opt) {
            match binding_opt {
              Absent => outcome_accepted(value: optional_absent())
              Present { value: binding } =>
                match sugar_sequence_pair_optional(node: pair.right) {
                  Absent => outcome_accepted(value: optional_absent())
                  Present { value: after_colon } =>
                    bind_outcome(
                      o: body_lower_type_atom_from_expr(remaining: remaining - 1, node: after_colon.right),
                      f: fn(type_opt) {
                        match type_opt {
                          Absent => outcome_accepted(value: optional_absent())
                          Present { value: type_node } =>
                            outcome_accepted(
                              value: optional_present(
                                value: Edge {
                                  label: Named { name: binding },
                                  target: type_node
                                }
                              )
                            )
                        }
                      }
                    )
                }
            }
          }
        )
    }
  }
}

fn body_lower_deep_unwrap_optional(remaining: Int, node: Node) -> Node {
  match remaining <= 0 {
    true => node
    false =>
      match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
      Accepted { value: child, diagnostics: _ } =>
      body_lower_deep_unwrap_optional(remaining: remaining - 1, node: child)
      Rejected { diagnostics: _ } => node
  }
  }
}

fn body_lower_unwrap_optional_element(remaining: Int, node: Node) -> Node {
  match remaining <= 0 {
    true => node
    false =>
      match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
      Accepted { value: child, diagnostics: _ } => child
      Rejected { diagnostics: _ } => node
  }
  }
}

fn body_lower_param_list_comma_spine_budgeted(remaining: Int, param_list_captured: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: param_list_captured))
  } else {
    bind_outcome(
      o: body_lower_budget_outcome(remaining: remaining, at: param_list_captured),
      f: fn(rem) {
        match sugar_sequence_pair_optional(node: param_list_captured) {
          Absent => outcome_accepted(value: optional_absent())
          Present { value: pair } =>
            bind_outcome(
              o: body_lower_budget_outcome(remaining: rem - 1, at: param_list_captured),
              f: fn(rem2) {
                match sugar_sequence_pair_optional(node: pair.right) {
                  Absent => outcome_accepted(value: optional_absent())
                  Present { value: inner } =>
                    bind_outcome(
                      o: body_lower_budget_outcome(remaining: rem2 - 1, at: param_list_captured),
                      f: fn(rem3) {
                        outcome_accepted(
                          value: optional_present(
                            value: body_lower_unwrap_optional_element(remaining: rem3 - 1, node: inner.left)
                          )
                        )
                      }
                    )
                }
              }
            )
        }
      }
    )
  }
}

fn body_lower_type_atom_from_arrow_seq_right(remaining: Int, right: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: right))
  } else {
    match parse_subtree_find_production_captured(
      root: right,
      emitted: ^dag_surface_type_expr
    ) {
      ParseSubtreeFound { captured: type_expr } =>
        body_lower_type_atom_from_expr(remaining: remaining - 1, node: type_expr)
      ParseSubtreeAbsent =>
        match parse_production_emitted_identity_optional(node: right) {
          Present { value: emitted } =>
            if emitted == ^dag_surface_type_expr {
              match parse_production_captured_child_optional(node: right) {
                Present { value: captured } =>
                  body_lower_type_atom_from_expr(remaining: remaining - 1, node: captured)
                Absent => outcome_accepted(value: optional_absent())
              }
            } else {
              outcome_accepted(value: optional_absent())
            }
          Absent => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_arrow_seq_return_type(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match find_named_child(root: node, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: left, diagnostics: _ } =>
        if body_lower_sequence_head_is_arrow(remaining: remaining - 1, node: left) {
          match find_named_child(root: node, name: ^grammar_sequence_right_node_projection) {
            Accepted { value: right, diagnostics: _ } =>
              body_lower_type_atom_from_arrow_seq_right(remaining: remaining - 1, right: right)
            Rejected { diagnostics: _ } => outcome_accepted(value: optional_absent())
          }
        } else {
          outcome_accepted(value: optional_absent())
        }
      Rejected { diagnostics: _ } => outcome_accepted(value: optional_absent())
    }
  }
}

fn body_lower_return_type_after_arrow_walk(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: node)
    bind_outcome(
      o: body_lower_arrow_seq_return_type(remaining: remaining - 1, node: stripped),
      f: fn(arrow_opt) {
        match arrow_opt {
          Present { value: found } => outcome_accepted(value: optional_present(value: found))
          Absent =>
            match parse_production_captured_child_optional(node: stripped) {
              Present { value: captured } =>
                bind_outcome(
                  o: body_lower_return_type_after_arrow_walk(remaining: remaining - 1, node: captured),
                  f: fn(found) {
                    match found {
                      Present { value: _ } => outcome_accepted(value: found)
                      Absent =>
                        body_lower_return_type_after_arrow_walk_children(
                          remaining: remaining - 1,
                          at: node,
                          children: stripped.children
                        )
                    }
                  }
                )
              Absent =>
                body_lower_return_type_after_arrow_walk_children(
                  remaining: remaining - 1,
                  at: node,
                  children: stripped.children
                )
            }
        }
      }
    )
  }
}

fn body_lower_return_type_after_arrow_walk_children(
  remaining: Int,
  at: Node,
  children: List<Edge>
) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: at))
  } else {
    fold(children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
      match acc_outcome {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: acc, diagnostics: _ } =>
          match acc {
            Present { value: _ } => acc_outcome
            Absent => body_lower_return_type_after_arrow_walk(remaining: remaining - 1, node: e.target)
          }
      }
    })
  }
}

fn body_lower_domain_from_param_list(remaining: Int, param_list: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: param_list))
  } else {
    bind_outcome(
      o: body_lower_param_list_comma_spine_budgeted(remaining: remaining - 1, param_list_captured: param_list),
      f: fn(comma_opt) {
        match comma_opt {
          Absent => outcome_accepted(value: optional_absent())
          Present { value: comma_spine } =>
            bind_outcome(
              o: body_lower_budget_outcome(remaining: remaining - 1, at: comma_spine),
              f: fn(edge_budget) {
                bind_outcome(
                  o: body_lower_collect_param_edges(remaining: edge_budget, sequence_capture: comma_spine),
                  f: fn(edges) {
                    if count(edges) == 0 {
                      outcome_accepted(
                        value: optional_present(
                          value: node_synthetic(kind: TypeNode { connective: Conj }, children: [])
                        )
                      )
                    } else {
                      outcome_accepted(
                        value: optional_present(
                          value: node_synthetic(
                            kind: TypeNode { connective: Conj },
                            children: edges
                          )
                        )
                      )
                    }
                  }
                )
              }
            )
        }
      }
    )
  }
}

fn body_lower_sequence_head_is_arrow(remaining: Int, node: Node) -> Bool {
  match remaining <= 0 {
    true => false
    false =>
      match node_atom_identity_optional(node: node) {
      Present { value: id } => id == ^dag_token_arrow
      Absent =>
      match sugar_sequence_pair_optional(node: node) {
        Present { value: pair } => body_lower_sequence_head_is_arrow(remaining: remaining - 1, node: pair.left)
        Absent => false
      }
  }
  }
}

fn body_lower_type_expr_after_arrow(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match sugar_sequence_pair_optional(node: node) {
      Present { value: pair } =>
        if body_lower_sequence_head_is_arrow(remaining: remaining - 1, node: pair.left) {
          match parse_subtree_find_production_captured(
            root: pair.right,
            emitted: ^dag_surface_type_expr
          ) {
            ParseSubtreeFound { captured: type_expr } =>
              outcome_accepted(value: optional_present(value: type_expr))
            ParseSubtreeAbsent =>
              match sugar_sequence_pair_optional(node: pair.right) {
                Present { value: after_arrow } =>
                  match parse_production_emitted_identity_optional(node: after_arrow.left) {
                    Present { value: emitted } =>
                      if emitted == ^dag_surface_type_expr {
                        outcome_accepted(value: optional_present(value: after_arrow.left))
                      } else {
                        body_lower_type_expr_after_arrow(remaining: remaining - 1, node: pair.right)
                      }
                    Absent => body_lower_type_expr_after_arrow(remaining: remaining - 1, node: pair.right)
                  }
                Absent => outcome_accepted(value: optional_absent())
              }
          }
        } else {
          bind_outcome(
            o: body_lower_type_expr_after_arrow(remaining: remaining - 1, node: pair.left),
            f: fn(left_opt) {
              match left_opt {
                Present { value: found } => outcome_accepted(value: optional_present(value: found))
                Absent => body_lower_type_expr_after_arrow(remaining: remaining - 1, node: pair.right)
              }
            }
          )
        }
      Absent =>
        match parse_production_emitted_identity_optional(node: node) {
          Present { value: _ } =>
            match parse_production_captured_child_optional(node: node) {
              Present { value: captured } =>
                body_lower_type_expr_after_arrow(remaining: remaining - 1, node: captured)
              Absent => outcome_accepted(value: optional_absent())
            }
          Absent =>
            fold(node.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
              match acc_outcome {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: acc, diagnostics: _ } =>
                  match acc {
                    Present { value: _ } => acc_outcome
                    Absent => body_lower_type_expr_after_arrow(remaining: remaining - 1, node: e.target)
                  }
              }
            })
        }
    }
  }
}

fn body_lower_return_type_from_fn_captured(remaining: Int, captured: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: captured))
  } else {
    bind_outcome(
      o: body_lower_budget_outcome(remaining: remaining - 1, at: captured),
      f: fn(walk_budget) {
        body_lower_return_type_after_arrow_walk(remaining: walk_budget, node: captured)
      }
    )
  }
}

fn body_lower_find_core_substrate_optional(remaining: Int, root: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: root))
  } else if body_lower_is_core_substrate(node: root) {
    outcome_accepted(value: optional_present(value: root))
  } else {
    fold(root.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
      match acc_outcome {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: acc, diagnostics: _ } =>
          match acc {
            Present { value: _ } => acc_outcome
            Absent => body_lower_find_core_substrate_optional(remaining: remaining - 1, root: e.target)
          }
      }
    })
  }
}

fn body_lower_try_body_lowered(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    if body_lower_is_core_substrate(node: node) {
    outcome_accepted(value: optional_present(value: node))
    } else {
      match body_lower_try_match_from_node(remaining: remaining - 1, node: node) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: match_found, diagnostics: md } =>
      match match_found {
        Present { value: lowered } =>
          outcome_accepted(value: optional_present(value: lowered), diagnostics: md)
        Absent =>
          match body_lower_try_postfix_projection(remaining: remaining - 1, node: node) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: projection, diagnostics: pd } =>
              match projection {
                Present { value: lowered } =>
                  outcome_accepted(value: optional_present(value: lowered), diagnostics: pd)
                Absent =>
                  bind_outcome(
                    o: body_lower_try_infix_transform(remaining: remaining - 1, node: node),
                    f: fn(infix_opt) {
                      match infix_opt {
                        Present { value: lowered } =>
                          outcome_accepted(value: optional_present(value: lowered))
                        Absent =>
                          match body_lower_try_fold_loop(remaining: remaining - 1, node: node) {
                            Rejected { diagnostics: r } => Rejected { diagnostics: r }
                            Accepted { value: fold_result, diagnostics: _ } =>
                              match fold_result {
                                Present { value: lowered } =>
                                  outcome_accepted(value: optional_present(value: lowered))
                                Absent =>
                                  bind_outcome(
                                    o: body_lower_try_postfix_projection(
                                      remaining: remaining - 1,
                                      node: body_lower_unwrap_surface_shell(remaining: remaining - 1, node: node)
                                    ),
                                    f: fn(stripped_proj) {
                                      match stripped_proj {
                                        Present { value: lowered } =>
                                          outcome_accepted(value: optional_present(value: lowered))
                                        Absent =>
                                          bind_outcome(
                                            o: body_lower_try_infix_transform(
                                              remaining: remaining - 1,
                                              node: body_lower_unwrap_surface_shell(remaining: remaining - 1, node: node)
                                            ),
                                            f: fn(stripped_infix) {
                                              match stripped_infix {
                                                Present { value: lowered } =>
                                                  outcome_accepted(value: optional_present(value: lowered))
                                                Absent =>
                                                  body_lower_try_fold_loop(
                                                    remaining: remaining - 1,
                                                    node: body_lower_unwrap_surface_shell(remaining: remaining - 1, node: node)
                                                  )
                                              }
                                            }
                                          )
                                      }
                                    }
                                  )
                              }
                          }
                      }
                    }
                  )
              }
          }
      }
      }
    }
}
}

fn body_lower_body_subtree_lower(remaining: Int, captured: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: captured))
  } else {
    match body_lower_try_body_lowered(remaining: remaining - 1, node: captured) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: found, diagnostics: _ } =>
      match found {
        Present { value: lowered } => outcome_accepted(value: optional_present(value: lowered))
        Absent =>
          match parse_subtree_find_production_captured(
            root: captured,
            emitted: ^dag_surface_match_expr
          ) {
            ParseSubtreeFound { captured: match_capture } =>
              body_lower_try_match_from_captured(remaining: remaining - 1, captured: match_capture)
            ParseSubtreeAbsent =>
          match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_binary_expr) {
            ParseSubtreeFound { captured: binary } =>
              body_lower_try_body_lowered(remaining: remaining - 1, node: binary)
            ParseSubtreeAbsent =>
              match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_expr) {
                ParseSubtreeFound { captured: expr } =>
                  body_lower_try_body_lowered(remaining: remaining - 1, node: expr)
                ParseSubtreeAbsent =>
                  match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_postfix_expr) {
                    ParseSubtreeFound { captured: postfix } =>
                      body_lower_try_body_lowered(remaining: remaining - 1, node: postfix)
                    ParseSubtreeAbsent =>
                      match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_primary_expr) {
                        ParseSubtreeFound { captured: primary } =>
                          body_lower_try_body_lowered(remaining: remaining - 1, node: primary)
                        ParseSubtreeAbsent =>
                          match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_stmt) {
                            ParseSubtreeFound { captured: stmt } =>
                              body_lower_body_subtree_lower(remaining: remaining - 1, captured: stmt)
                            ParseSubtreeAbsent =>
                              bind_outcome(
                                o: body_lower_find_core_substrate_optional(remaining: remaining - 1, root: captured),
                                f: fn(substrate_opt) {
                                  match substrate_opt {
                                    Present { value: lowered } =>
                                      outcome_accepted(value: optional_present(value: lowered))
                                    Absent =>
                                      body_lower_try_body_lowered(
                                        remaining: remaining - 1,
                                        node: body_lower_unwrap_surface_shell(remaining: remaining - 1, node: captured)
                                      )
                                  }
                                }
                              )
                          }
                      }
                  }
              }
          }
          }
      }
    }
}
}

fn body_lower_body_from_fn_captured(remaining: Int, captured: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: captured))
  } else {
    match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_fn_body) {
    ParseSubtreeFound { captured: body } => body_lower_body_subtree_lower(remaining: remaining - 1, captured: body)
    ParseSubtreeAbsent => outcome_accepted(value: optional_absent())
    }
}
}

fn body_lower_reify_operand_node(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    body_lower_operand_ref_optional(remaining: remaining - 1, node: node)
  }
}

fn body_lower_reify_transform_edge(remaining: Int, 
  done: List<Edge>,
  e: Edge
) -> Outcome<List<Edge>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: e.target))
  } else {
    if length(xs: done) == 0 {
    outcome_accepted(
      value: list_snoc_item(
        xs: done,
        item: Edge { label: e.label, target: e.target }
      )
    )
    } else {
      bind_outcome(
        o: body_lower_reify_operand_node(remaining: remaining - 1, node: e.target),
        f: fn(reified_opt) {
          match reified_opt {
            Present { value: reified } =>
              outcome_accepted(
                value: list_snoc_item(
                  xs: done,
                  item: Edge { label: e.label, target: reified }
                )
              )
            Absent =>
              outcome_rejected(
                d: body_lower_diagnostic(
                  reason: ^body_lowering_reason_unsupported_form,
                  n: e.target
                )
              )
          }
        }
      )
    }
}
}

fn body_lower_reify_transform_body(remaining: Int, body: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: body))
  } else {
    match body.kind {
    ComputationNode { behavior: Transform } =>
      match fold(body.children, init: outcome_accepted(value: Empty), f: fn(acc, e) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: done, diagnostics: d } =>
            match body_lower_reify_transform_edge(remaining: remaining - 1, done: done, e: e) {
              Rejected { diagnostics: r } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: d, rejected: r)
                }
              Accepted { value: next, diagnostics: ed } =>
                Accepted {
                  value: next,
                  diagnostics: diagnostics_merge(outer: d, inner: ed)
                }
            }
        }
      }) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: children, diagnostics: d } =>
          outcome_accepted(
            value: node_synthetic(
              kind: ComputationNode { behavior: Transform },
              children: children
            ),
            diagnostics: d
          )
      }
    _ => outcome_accepted(value: body)
    }
}
}

fn body_lower_fn_decl_to_arrow(remaining: Int, shell: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    bind_outcome(
      o: body_lower_unwrap_captured(remaining: remaining - 1, shell: shell),
      f: fn(captured_opt) {
        match captured_opt {
          Absent => body_lower_wrapper_retained_shell(remaining: remaining - 1, shell: shell)
          Present { value: captured } =>
            match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_param_list) {
              ParseSubtreeAbsent => body_lower_wrapper_retained_shell(remaining: remaining - 1, shell: shell)
              ParseSubtreeFound { captured: param_list } =>
                bind_outcome(
                  o: body_lower_domain_from_param_list(remaining: remaining - 1, param_list: param_list),
                  f: fn(domain_opt) {
                    match domain_opt {
                      Absent => body_lower_wrapper_retained_shell(remaining: remaining - 1, shell: shell)
                      Present { value: domain } =>
                        match body_lower_body_from_fn_captured(remaining: remaining - 1, captured: captured) {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: body_opt, diagnostics: bd0 } =>
                            match body_opt {
                              Absent => body_lower_wrapper_retained_shell(remaining: remaining - 1, shell: shell)
                              Present { value: body } =>
                                match body_lower_reify_transform_body(remaining: remaining - 1, body: body) {
                                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                  Accepted { value: reified_body, diagnostics: bd } =>
                                    bind_outcome(
                                      o: body_lower_return_type_from_fn_captured(remaining: remaining - 1, captured: captured),
                                      f: fn(return_opt) {
                                        match return_opt {
                                          Absent => body_lower_wrapper_retained_shell(remaining: remaining - 1, shell: shell)
                                          Present { value: return_type } =>
                                            outcome_accepted(
                                              value: node_synthetic(
                                                kind: TypeNode { connective: Arrow },
                                                children: [
                                                  Edge { label: Positional, target: domain },
                                                  Edge { label: Positional, target: return_type },
                                                  Edge { label: Positional, target: return_type },
                                                  Edge { label: Named { name: ^arrow_body_edge }, target: reified_body }
                                                ]
                                              ),
                                              diagnostics: diagnostics_merge(outer: bd0, inner: bd)
                                            )
                                        }
                                      }
                                    )
                                }
                            }
                        }
                    }
                  }
                )
            }
        }
      }
    )
  }
}

fn body_lower_literal_bool_atom_optional(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match node_atom_identity_optional(node: body_lower_deep_unwrap_optional(remaining: remaining - 1, node: node)) {
      Present { value: id } =>
        if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
          outcome_accepted(value: optional_present(value: body_lower_param_ref_atom(identity: id)))
        } else {
          outcome_accepted(value: optional_absent())
        }
      Absent =>
        fold(node.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
          match acc_outcome {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: acc, diagnostics: _ } =>
              match acc {
                Present { value: _ } => acc_outcome
                Absent => body_lower_literal_bool_atom_optional(remaining: remaining - 1, node: e.target)
              }
          }
        })
    }
  }
}

fn body_lower_try_operand_or_reject(remaining: Int, shell: Node, captured: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    bind_outcome(
      o: body_lower_operand_ref_optional(remaining: remaining - 1, node: captured),
      f: fn(operand_opt) {
        match operand_opt {
          Present { value: operand } => outcome_accepted(value: operand)
          Absent =>
            bind_outcome(
              o: body_lower_literal_bool_atom_optional(remaining: remaining - 1, node: captured),
              f: fn(lit_opt) {
                match lit_opt {
                  Present { value: lit } => outcome_accepted(value: lit)
                  Absent =>
                    bind_outcome(
                      o: body_lower_pattern_first_atom_optional(remaining: remaining - 1, node: captured),
                      f: fn(pat_opt) {
                        match pat_opt {
                          Present { value: pat_atom } => outcome_accepted(value: pat_atom)
                          Absent =>
                            outcome_rejected(
                              d: body_lower_diagnostic(
                                reason: ^body_lowering_reason_unsupported_form,
                                n: shell
                              )
                            )
                        }
                      }
                    )
                }
              }
            )
        }
      }
    )
  }
}

fn body_lower_unwrap_pass_through(remaining: Int, shell: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    bind_outcome(
      o: body_lower_unwrap_captured(remaining: remaining - 1, shell: shell),
      f: fn(captured_opt) {
        match captured_opt {
          Absent =>
            outcome_rejected(
              d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
            )
          Present { value: captured } => outcome_accepted(value: captured)
        }
      }
    )
}
}

fn body_lower_transform_call(remaining: Int, operator: Node, args: List<Node>) -> Node {
  match remaining <= 0 {
    true => operator
    false =>
      node_synthetic(
      kind: ComputationNode { behavior: Transform },
      children: list_append(
      left: [Edge { label: Positional, target: operator }],
      right: fold(args, init: Empty, f: fn(acc, arg) {
        list_snoc_item(xs: acc, item: Edge { label: Positional, target: arg })
      })
      )
      )
  }
}

fn body_lower_method_operator_atom(sym: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: sym } },
    children: []
  )
}

fn body_lower_arg_operand_optional(remaining: Int, arg_capture: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: arg_capture))
  } else {
    match parse_subtree_find_production_captured(root: arg_capture, emitted: ^dag_surface_expr) {
      ParseSubtreeFound { captured: expr } =>
        body_lower_operand_ref_optional(remaining: remaining - 1, node: expr)
      ParseSubtreeAbsent =>
        match parse_production_emitted_identity_optional(node: arg_capture) {
          Present { value: emitted } =>
            if emitted == ^dag_surface_expr {
              match parse_production_captured_child_optional(node: arg_capture) {
                Present { value: captured } =>
                  body_lower_operand_ref_optional(remaining: remaining - 1, node: captured)
                Absent => outcome_accepted(value: optional_absent())
              }
            } else {
              body_lower_operand_ref_optional(remaining: remaining - 1, node: arg_capture)
            }
          Absent => body_lower_operand_ref_optional(remaining: remaining - 1, node: arg_capture)
        }
    }
  }
}

fn body_lower_named_arg_value_optional(remaining: Int, arg_capture: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: arg_capture))
  } else {
    match sugar_sequence_pair_optional(node: arg_capture) {
      Absent =>
        match parse_production_emitted_identity_optional(node: arg_capture) {
          Present { value: emitted } =>
            if emitted == ^dag_surface_arg {
              match parse_production_captured_child_optional(node: arg_capture) {
                Present { value: captured } =>
                  body_lower_named_arg_value_optional(remaining: remaining - 1, arg_capture: captured)
                Absent => outcome_accepted(value: optional_absent())
              }
            } else {
              outcome_accepted(value: optional_absent())
            }
          Absent => outcome_accepted(value: optional_absent())
        }
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_param_binding_optional(remaining: remaining - 1, node: pair.left),
          f: fn(binding_opt) {
            match binding_opt {
              Absent => outcome_accepted(value: optional_absent())
              Present { value: _binding } =>
                match sugar_sequence_pair_optional(node: pair.right) {
                  Absent => outcome_accepted(value: optional_absent())
                  Present { value: after_name } =>
                    match node_atom_identity_optional(node: after_name.left) {
                      Present { value: colon } =>
                        if colon == ^dag_token_colon {
                          body_lower_arg_operand_optional(remaining: remaining - 1, arg_capture: after_name.right)
                        } else {
                          outcome_accepted(value: optional_absent())
                        }
                      Absent => outcome_accepted(value: optional_absent())
                    }
                }
            }
          }
        )
    }
  }
}

fn body_lower_call_arg_edge_optional(remaining: Int, arg_capture: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: arg_capture))
  } else {
    bind_outcome(
      o: body_lower_named_arg_value_optional(remaining: remaining - 1, arg_capture: arg_capture),
      f: fn(named_opt) {
        match named_opt {
          Present { value: operand } => outcome_accepted(value: optional_present(value: operand))
          Absent => body_lower_arg_operand_optional(remaining: remaining - 1, arg_capture: arg_capture)
        }
      }
    )
  }
}

fn body_lower_call_arg_operand_from_repeat_elem(remaining: Int, repeat_elem: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_elem))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: repeat_elem)
    match sugar_sequence_pair_optional(node: stripped) {
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_call_arg_edge_optional(
            remaining: remaining - 1,
            arg_capture: body_lower_postfix_optional_unwrap(remaining: remaining - 1, node: pair.right)
          ),
          f: fn(op_opt) {
            match op_opt {
              Present { value: operand } => outcome_accepted(value: [operand])
              Absent => outcome_accepted(value: Empty)
            }
          }
        )
      Absent =>
        bind_outcome(
          o: body_lower_call_arg_edge_optional(remaining: remaining - 1, arg_capture: stripped),
          f: fn(op_opt) {
            match op_opt {
              Present { value: operand } => outcome_accepted(value: [operand])
              Absent => outcome_accepted(value: Empty)
            }
          }
        )
    }
  }
}

fn body_lower_extract_comma_list_operand(remaining: Int, node: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: node)
    bind_outcome(
      o: body_lower_call_arg_edge_optional(remaining: remaining - 1, arg_capture: stripped),
      f: fn(op_opt) {
        match op_opt {
          Present { value: operand } => outcome_accepted(value: [operand])
          Absent =>
            match sugar_sequence_pair_optional(node: stripped) {
              Present { value: pair } =>
                bind_outcome(
                  o: body_lower_call_arg_operand_from_repeat_elem(remaining: remaining - 1, repeat_elem: pair.left),
                  f: fn(left_ops) {
                    if count(left_ops) > 0 {
                      outcome_accepted(value: left_ops)
                    } else {
                      body_lower_call_arg_operand_from_repeat_elem(remaining: remaining - 1, repeat_elem: stripped)
                    }
                  }
                )
              Absent =>
                body_lower_call_arg_operand_from_repeat_elem(remaining: remaining - 1, repeat_elem: stripped)
            }
        }
      }
    )
  }
}

fn body_lower_collect_call_arg_operands_from_repeat_tail(remaining: Int, repeat_capture: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_capture))
  } else if is_empty_conj_root(n: repeat_capture) {
    outcome_accepted(value: Empty)
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: head, diagnostics: _ } =>
        bind_outcome(
          o: body_lower_extract_comma_list_operand(remaining: remaining - 1, node: head),
          f: fn(operands) {
            match find_named_child(root: repeat_capture, name: ^grammar_sequence_right_node_projection) {
              Accepted { value: tail, diagnostics: _ } =>
                bind_outcome(
                  o: body_lower_collect_call_arg_operands_from_repeat_tail(
                    remaining: remaining - 1,
                    repeat_capture: tail
                  ),
                  f: fn(rest) {
                    outcome_accepted(value: list_append(left: operands, right: rest))
                  }
                )
              Rejected { diagnostics: _ } => outcome_accepted(value: operands)
            }
          }
        )
      Rejected { diagnostics: _ } => outcome_accepted(value: Empty)
    }
  }
}

fn body_lower_collect_call_arg_operands(remaining: Int, sequence_capture: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: sequence_capture))
  } else {
    let unwrapped = body_lower_postfix_optional_unwrap(remaining: remaining - 1, node: sequence_capture)
    match find_named_child(root: unwrapped, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: first, diagnostics: _ } =>
        bind_outcome(
          o: body_lower_call_arg_edge_optional(remaining: remaining - 1, arg_capture: first),
          f: fn(first_opt) {
            bind_outcome(
              o: match first_opt {
                Present { value: operand } => outcome_accepted(value: [operand])
                Absent => body_lower_call_arg_operand_from_repeat_elem(remaining: remaining - 1, repeat_elem: first)
              },
              f: fn(first_operands) {
                match find_named_child(root: unwrapped, name: ^grammar_sequence_right_node_projection) {
                  Accepted { value: tail, diagnostics: _ } =>
                    bind_outcome(
                      o: body_lower_collect_call_arg_operands_from_repeat_tail(
                        remaining: remaining - 1,
                        repeat_capture: tail
                      ),
                      f: fn(rest) {
                        outcome_accepted(value: list_append(left: first_operands, right: rest))
                      }
                    )
                  Rejected { diagnostics: _ } => outcome_accepted(value: first_operands)
                }
              }
            )
          }
        )
      Rejected { diagnostics: _ } =>
        bind_outcome(
          o: body_lower_call_arg_edge_optional(remaining: remaining - 1, arg_capture: unwrapped),
          f: fn(unwrapped_opt) {
            match unwrapped_opt {
              Present { value: operand } => outcome_accepted(value: [operand])
              Absent =>
                match sugar_sequence_pair_optional(node: unwrapped) {
                  Present { value: pair } =>
                    bind_outcome(
                      o: body_lower_call_arg_edge_optional(remaining: remaining - 1, arg_capture: pair.left),
                      f: fn(left_opt) {
                        match left_opt {
                          Present { value: operand } =>
                            bind_outcome(
                              o: body_lower_after_comma_tail_optional(remaining: remaining - 1, node: pair.right),
                              f: fn(tail_opt) {
                                match tail_opt {
                                  Present { value: tail } =>
                                    bind_outcome(
                                      o: body_lower_collect_call_arg_operands(
                                        remaining: remaining - 1,
                                        sequence_capture: tail
                                      ),
                                      f: fn(rest) {
                                        outcome_accepted(value: list_append(left: [operand], right: rest))
                                      }
                                    )
                                  Absent => outcome_accepted(value: [operand])
                                }
                              }
                            )
                          Absent =>
                            bind_outcome(
                              o: body_lower_after_comma_tail_optional(remaining: remaining - 1, node: pair.right),
                              f: fn(tail_opt) {
                                match tail_opt {
                                  Present { value: tail } =>
                                    body_lower_collect_call_arg_operands(
                                      remaining: remaining - 1,
                                      sequence_capture: tail
                                    )
                                  Absent => outcome_accepted(value: Empty)
                                }
                              }
                            )
                        }
                      }
                    )
                  Absent => outcome_accepted(value: Empty)
                }
            }
          }
        )
    }
  }
}

fn body_lower_call_args_from_capture(remaining: Int, args_capture: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: args_capture))
  } else {
    bind_outcome(
      o: body_lower_param_list_comma_spine_budgeted(remaining: remaining - 1, param_list_captured: args_capture),
      f: fn(comma_opt) {
        match comma_opt {
          Present { value: comma_spine } =>
            body_lower_collect_call_arg_operands(remaining: remaining - 1, sequence_capture: comma_spine)
          Absent =>
            body_lower_collect_call_arg_operands(remaining: remaining - 1, sequence_capture: args_capture)
        }
      }
    )
  }
}

fn body_lower_postfix_call_suffix_args(remaining: Int, call_suffix: Node) -> Outcome<Optional<List<Node>>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: call_suffix))
  } else {
    match sugar_sequence_pair_optional(node: call_suffix) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        match node_atom_identity_optional(node: pair.left) {
          Present { value: id } =>
            if id == ^dag_token_lparen {
              match sugar_sequence_pair_optional(node: pair.right) {
                Absent => outcome_accepted(value: optional_present(value: Empty))
                Present { value: inner } =>
                  bind_outcome(
                    o: body_lower_call_args_from_capture(
                      remaining: remaining - 1,
                      args_capture: body_lower_postfix_optional_unwrap(remaining: remaining - 1, node: inner.left)
                    ),
                    f: fn(args) {
                      outcome_accepted(value: optional_present(value: args))
                    }
                  )
              }
            } else {
              outcome_accepted(value: optional_absent())
            }
          Absent => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_postfix_projection_step(remaining: Int, repeat_elem: Node) -> Outcome<Optional<Symbol>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_elem))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: repeat_elem)
    match sugar_sequence_pair_optional(node: stripped) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        match node_atom_identity_optional(node: pair.left) {
          Present { value: id } =>
            if id == ^dag_token_dot {
              match sugar_sequence_pair_optional(node: pair.right) {
                Absent => outcome_accepted(value: optional_absent())
                Present { value: after_dot } =>
                  bind_outcome(
                    o: body_lower_param_binding_optional(remaining: remaining - 1, node: after_dot.left),
                    f: fn(method_opt) {
                      match method_opt {
                        Present { value: method } =>
                          outcome_accepted(value: optional_present(value: method))
                        Absent => outcome_accepted(value: optional_absent())
                      }
                    }
                  )
              }
            } else {
              outcome_accepted(value: optional_absent())
            }
          Absent => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_postfix_optional_unwrap(remaining: Int, node: Node) -> Node {
  match remaining <= 0 {
    true => node
    false =>
      match find_named_child(root: node, name: ^grammar_optional_element_node_projection) {
      Accepted { value: child, diagnostics: _ } => child
      Rejected { diagnostics: _ } => node
  }
  }
}

fn body_lower_postfix_method_suffix_optional(remaining: Int, repeat_elem: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_elem))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: repeat_elem)
    match sugar_sequence_pair_optional(node: stripped) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        match node_atom_identity_optional(node: pair.left) {
          Present { value: id } =>
            if id == ^dag_token_dot {
              match sugar_sequence_pair_optional(node: pair.right) {
                Absent => outcome_accepted(value: optional_absent())
                Present { value: after_dot } =>
                  outcome_accepted(
                    value: optional_present(
                      value: body_lower_postfix_optional_unwrap(remaining: remaining - 1, node: after_dot.right)
                    )
                  )
              }
            } else {
              outcome_accepted(value: optional_absent())
            }
          Absent => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_postfix_projection_args(remaining: Int, repeat_elem: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_elem))
  } else {
    bind_outcome(
      o: body_lower_postfix_method_suffix_optional(remaining: remaining - 1, repeat_elem: repeat_elem),
      f: fn(suffix_opt) {
        match suffix_opt {
          Absent => outcome_accepted(value: Empty)
          Present { value: call_suffix } =>
            bind_outcome(
              o: body_lower_postfix_call_suffix_args(remaining: remaining - 1, call_suffix: call_suffix),
              f: fn(args_opt) {
                match args_opt {
                  Present { value: args } => outcome_accepted(value: args)
                  Absent => outcome_accepted(value: Empty)
                }
              }
            )
        }
      }
    )
  }
}

fn body_lower_postfix_projection_has_call_suffix(remaining: Int, repeat_elem: Node) -> Outcome<Bool> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_elem))
  } else {
    bind_outcome(
      o: body_lower_postfix_method_suffix_optional(remaining: remaining - 1, repeat_elem: repeat_elem),
      f: fn(suffix_opt) {
        match suffix_opt {
          Absent => outcome_accepted(value: false)
          Present { value: call_suffix } =>
            bind_outcome(
              o: body_lower_postfix_call_suffix_args(remaining: remaining - 1, call_suffix: call_suffix),
              f: fn(args_opt) {
                match args_opt {
                  Present { value: _ } => outcome_accepted(value: true)
                  Absent => outcome_accepted(value: false)
                }
              }
            )
        }
      }
    )
  }
}

fn body_lower_postfix_projection_call_suffix_capture(remaining: Int, repeat_elem: Node) -> Node {
  match remaining <= 0 {
    true => repeat_elem
    false =>
      match body_lower_postfix_method_suffix_optional(remaining: remaining - 1, repeat_elem: repeat_elem) {
        Rejected { diagnostics: _ } => repeat_elem
        Accepted { value: suffix_opt, diagnostics: _ } =>
          match suffix_opt {
            Absent => repeat_elem
            Present { value: call_suffix } => call_suffix
          }
      }
  }
}

fn body_lower_postfix_repeat_head_optional(remaining: Int, repeat_capture: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_capture))
  } else if is_empty_conj_root(n: repeat_capture) {
    outcome_accepted(value: optional_absent())
  } else {
    match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: elem, diagnostics: _ } =>
        outcome_accepted(value: optional_present(value: elem))
      Rejected { diagnostics: _ } =>
        match find_named_child(root: repeat_capture, name: ^grammar_repeat_element_node_projection) {
          Accepted { value: elem, diagnostics: _ } =>
            outcome_accepted(value: optional_present(value: elem))
          Rejected { diagnostics: _ } => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_try_postfix_projection(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    let stripped = body_lower_unwrap_surface_shell(remaining: remaining - 1, node: node)
    match sugar_sequence_pair_optional(node: stripped) {
      Absent => outcome_accepted(value: optional_absent())
      Present { value: pair } =>
        bind_outcome(
          o: body_lower_operand_ref_optional(remaining: remaining - 1, node: pair.left),
          f: fn(receiver_opt) {
            match receiver_opt {
              Absent => outcome_accepted(value: optional_absent())
              Present { value: receiver } =>
                bind_outcome(
                  o: body_lower_postfix_repeat_head_optional(remaining: remaining - 1, repeat_capture: pair.right),
                  f: fn(repeat_opt) {
                    match repeat_opt {
                      Absent => outcome_accepted(value: optional_absent())
                      Present { value: repeat_elem } =>
                        bind_outcome(
                          o: body_lower_postfix_projection_step(remaining: remaining - 1, repeat_elem: repeat_elem),
                          f: fn(method_opt) {
                            match method_opt {
                              Absent => outcome_accepted(value: optional_absent())
                              Present { value: method } =>
                                bind_outcome(
                                  o: body_lower_postfix_projection_has_call_suffix(
                                    remaining: remaining - 1,
                                    repeat_elem: repeat_elem
                                  ),
                                  f: fn(has_suffix) {
                                    if has_suffix {
                                      bind_outcome(
                                        o: body_lower_postfix_projection_args(
                                          remaining: remaining - 1,
                                          repeat_elem: repeat_elem
                                        ),
                                        f: fn(args) {
                                          outcome_accepted(
                                            value: optional_present(
                                              value: body_lower_transform_call(
                                                remaining: remaining - 1,
                                                operator: body_lower_method_operator_atom(sym: method),
                                                args: list_append(left: [receiver], right: args)
                                              )
                                            )
                                          )
                                        }
                                      )
                                    } else {
                                      outcome_rejected(
                                        d: body_lower_diagnostic(
                                          reason: ^body_lowering_reason_postfix_field_access_refused,
                                          n: node
                                        )
                                      )
                                    }
                                  }
                                )
                            }
                          }
                        )
                    }
                  }
                )
            }
          }
        )
    }
  }
}

fn body_lower_match_arm_wire(pat_node: Node, body: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: match_arm_pattern }, target: pat_node },
      Edge { label: Named { name: match_arm_body }, target: body }
    ]
  )
}

fn body_lower_pattern_leaf_atom_optional(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: node)
    match dag_binding_branded_atom_identity(node: stripped) {
      Present { value: binding } =>
        outcome_accepted(value: optional_present(value: body_lower_param_ref_atom(identity: binding)))
      Absent =>
        match parse_production_emitted_identity_optional(node: stripped) {
          Present { value: emitted } =>
            match parse_production_captured_child_optional(node: stripped) {
              Present { value: captured } =>
                body_lower_pattern_leaf_atom_optional(remaining: remaining - 1, node: captured)
              Absent =>
                if emitted == ^dag_surface_pattern {
                  fold(stripped.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
                    match acc_outcome {
                      Rejected { diagnostics: r } => Rejected { diagnostics: r }
                      Accepted { value: acc, diagnostics: _ } =>
                        match acc {
                          Present { value: _ } => acc_outcome
                          Absent =>
                            body_lower_pattern_leaf_atom_optional(remaining: remaining - 1, node: e.target)
                        }
                    }
                  })
                } else {
                  outcome_accepted(value: optional_absent())
                }
            }
          Absent =>
            match node_atom_identity_optional(node: stripped) {
              Present { value: id } =>
                if dag_lex_token_symbol(sym: id) {
                  if (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false) {
                    outcome_accepted(value: optional_present(value: body_lower_param_ref_atom(identity: id)))
                  } else {
                    outcome_accepted(value: optional_absent())
                  }
                } else {
                  outcome_accepted(value: optional_present(value: body_lower_param_ref_atom(identity: id)))
                }
              Absent =>
                fold(stripped.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
                  match acc_outcome {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: acc, diagnostics: _ } =>
                      match acc {
                        Present { value: _ } => acc_outcome
                        Absent =>
                          body_lower_pattern_leaf_atom_optional(remaining: remaining - 1, node: e.target)
                      }
                  }
                })
            }
        }
    }
  }
}

fn body_lower_pattern_first_atom_optional(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    bind_outcome(
      o: body_lower_pattern_leaf_atom_optional(remaining: remaining - 1, node: node),
      f: fn(leaf_opt) {
        match leaf_opt {
          Present { value: atom } => outcome_accepted(value: optional_present(value: atom))
          Absent =>
            fold(node.children, init: outcome_accepted(value: optional_absent()), f: fn(acc_outcome, e) {
              match acc_outcome {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: acc, diagnostics: _ } =>
                  match acc {
                    Present { value: _ } => acc_outcome
                    Absent => body_lower_pattern_first_atom_optional(remaining: remaining - 1, node: e.target)
                  }
              }
            })
        }
      }
    )
  }
}

fn body_lower_pattern_atom_optional(remaining: Int, pattern_capture: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: pattern_capture))
  } else {
    body_lower_pattern_first_atom_optional(remaining: remaining - 1, node: pattern_capture)
  }
}

fn body_lower_match_arm_navigation_reject(remaining: Int, arm_capture: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: arm_capture))
  } else {
    outcome_rejected(
    d: body_lower_diagnostic(
      reason: ^body_lowering_reason_match_arm_navigation_refused,
      n: arm_capture
    )
  )
}
}

fn body_lower_match_arm_body_capture_optional(remaining: Int, stripped: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: stripped))
  } else {
    match parse_subtree_find_production_captured(root: stripped, emitted: ^dag_surface_expr) {
      ParseSubtreeFound { captured: expr } =>
        outcome_accepted(value: optional_present(value: expr))
      ParseSubtreeAbsent =>
        match parse_subtree_find_production_captured(
          root: stripped,
          emitted: ^dag_surface_primary_expr
        ) {
          ParseSubtreeFound { captured: primary } =>
            outcome_accepted(value: optional_present(value: primary))
          ParseSubtreeAbsent =>
            match parse_subtree_find_production_captured(
              root: stripped,
              emitted: ^dag_surface_postfix_expr
            ) {
              ParseSubtreeFound { captured: postfix } =>
                outcome_accepted(value: optional_present(value: postfix))
              ParseSubtreeAbsent => outcome_accepted(value: optional_absent())
            }
        }
    }
  }
}

fn body_lower_match_arm_body_optional(remaining: Int, body_capture: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: body_capture))
  } else {
    match parse_subtree_find_production_captured(root: body_capture, emitted: ^dag_surface_expr) {
      ParseSubtreeFound { captured: expr } =>
        body_lower_operand_ref_optional(remaining: remaining - 1, node: expr)
      ParseSubtreeAbsent =>
        match parse_production_emitted_identity_optional(node: body_capture) {
          Present { value: emitted } =>
            if emitted == ^dag_surface_expr {
              match parse_production_captured_child_optional(node: body_capture) {
                Present { value: captured } =>
                  body_lower_match_arm_body_optional(remaining: remaining - 1, body_capture: captured)
                Absent => outcome_accepted(value: optional_absent())
              }
            } else if emitted == ^dag_surface_match_arm_stmt_body {
              match parse_production_captured_child_optional(node: body_capture) {
                Present { value: captured } =>
                  body_lower_match_arm_body_optional(remaining: remaining - 1, body_capture: captured)
                Absent => outcome_accepted(value: optional_absent())
              }
            } else {
              body_lower_operand_ref_optional(remaining: remaining - 1, node: body_capture)
            }
          Absent =>
            match node_atom_identity_optional(
              node: body_lower_deep_unwrap_optional(remaining: remaining - 1, node: body_capture)
            ) {
              Present { value: id } =>
                if dag_lex_token_symbol(sym: id) {
                  outcome_accepted(value: optional_present(value: body_lower_param_ref_atom(identity: id)))
                } else {
                  body_lower_operand_ref_optional(remaining: remaining - 1, node: body_capture)
                }
              Absent => body_lower_operand_ref_optional(remaining: remaining - 1, node: body_capture)
            }
        }
    }
  }
}

fn body_lower_match_arm_wire_from_pat_and_body(
  remaining: Int,
  stripped: Node,
  pat_node: Node,
  body_capture: Node
) -> Outcome<Node> {
  bind_outcome(
    o: body_lower_match_arm_body_optional(remaining: remaining - 1, body_capture: body_capture),
    f: fn(body_opt) {
      match body_opt {
        Present { value: body } =>
          outcome_accepted(value: body_lower_match_arm_wire(pat_node: pat_node, body: body))
        Absent => body_lower_match_arm_navigation_reject(remaining: remaining - 1, arm_capture: stripped)
      }
    }
  )
}

fn body_lower_match_arm_wire_from_sequence(remaining: Int, stripped: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: stripped))
  } else {
    match parse_subtree_find_production_captured(
      root: stripped,
      emitted: ^dag_surface_pattern
    ) {
      ParseSubtreeFound { captured: pat_capture } =>
        bind_outcome(
          o: body_lower_pattern_atom_optional(remaining: remaining - 1, pattern_capture: pat_capture),
          f: fn(pat_opt) {
            match pat_opt {
              Absent => body_lower_match_arm_navigation_reject(remaining: remaining - 1, arm_capture: stripped)
              Present { value: pat_node } =>
                bind_outcome(
                  o: body_lower_match_arm_body_capture_optional(remaining: remaining - 1, stripped: stripped),
                  f: fn(body_cap_opt) {
                    match body_cap_opt {
                      Absent => body_lower_match_arm_navigation_reject(remaining: remaining - 1, arm_capture: stripped)
                      Present { value: body_capture } =>
                        body_lower_match_arm_wire_from_pat_and_body(
                          remaining: remaining,
                          stripped: stripped,
                          pat_node: pat_node,
                          body_capture: body_capture
                        )
                    }
                  }
                )
            }
          }
        )
      ParseSubtreeAbsent =>
        bind_outcome(
          o: body_lower_match_spine_left(remaining: remaining - 1, spine: stripped),
          f: fn(left_opt) {
            match left_opt {
              Absent => body_lower_match_arm_navigation_reject(remaining: remaining - 1, arm_capture: stripped)
              Present { value: left } =>
                bind_outcome(
                  o: body_lower_match_spine_right(remaining: remaining - 1, spine: stripped),
                  f: fn(right_opt) {
                    match right_opt {
                      Absent => body_lower_match_arm_navigation_reject(remaining: remaining - 1, arm_capture: stripped)
                      Present { value: right } =>
                        bind_outcome(
                          o: body_lower_pattern_atom_optional(remaining: remaining - 1, pattern_capture: left),
                          f: fn(pat_opt) {
                            match pat_opt {
                              Absent =>
                                body_lower_match_arm_navigation_reject(remaining: remaining - 1, arm_capture: stripped)
                              Present { value: pat_node } =>
                                bind_outcome(
                                  o: body_lower_match_spine_left(remaining: remaining - 1, spine: right),
                                  f: fn(arrow_opt) {
                                    match arrow_opt {
                                      Present { value: arrow_node } =>
                                        match node_atom_identity_optional(node: arrow_node) {
                                          Present { value: arrow } =>
                                            if arrow == ^dag_token_fat_arrow {
                                              bind_outcome(
                                                o: body_lower_match_spine_right(remaining: remaining - 1, spine: right),
                                                f: fn(body_cap_opt) {
                                                  match body_cap_opt {
                                                    Absent =>
                                                      body_lower_match_arm_navigation_reject(
                                                        remaining: remaining - 1,
                                                        arm_capture: stripped
                                                      )
                                                    Present { value: body_capture } =>
                                                      body_lower_match_arm_wire_from_pat_and_body(
                                                        remaining: remaining,
                                                        stripped: stripped,
                                                        pat_node: pat_node,
                                                        body_capture: body_capture
                                                      )
                                                  }
                                                }
                                              )
                                            } else {
                                              body_lower_match_arm_navigation_reject(
                                                remaining: remaining - 1,
                                                arm_capture: stripped
                                              )
                                            }
                                          Absent =>
                                            body_lower_match_arm_navigation_reject(
                                              remaining: remaining - 1,
                                              arm_capture: stripped
                                            )
                                        }
                                      Absent =>
                                        match sugar_sequence_pair_optional(node: right) {
                                          Present { value: after_pattern } =>
                                            match node_atom_identity_optional(node: after_pattern.left) {
                                              Present { value: arrow } =>
                                                if arrow == ^dag_token_fat_arrow {
                                                  body_lower_match_arm_wire_from_pat_and_body(
                                                    remaining: remaining,
                                                    stripped: stripped,
                                                    pat_node: pat_node,
                                                    body_capture: after_pattern.right
                                                  )
                                                } else {
                                                  body_lower_match_arm_navigation_reject(
                                                    remaining: remaining - 1,
                                                    arm_capture: stripped
                                                  )
                                                }
                                              Absent =>
                                                body_lower_match_arm_navigation_reject(
                                                  remaining: remaining - 1,
                                                  arm_capture: stripped
                                                )
                                            }
                                          Absent =>
                                            body_lower_match_arm_navigation_reject(
                                              remaining: remaining - 1,
                                              arm_capture: stripped
                                            )
                                        }
                                    }
                                  }
                                )
                            }
                          }
                        )
                    }
                  }
                )
            }
          }
        )
    }
  }
}

fn body_lower_is_match_arm_navigate_emitted(remaining: Int, emitted: Symbol) -> Bool {
  match remaining <= 0 {
    true => false
    false =>
      (emitted == ^dag_surface_pattern)
      || (emitted == ^dag_surface_primary_expr)
      || (emitted == ^dag_surface_match_arm_stmt_body)
      || body_lower_is_pass_through_emitted(emitted: emitted)
  }
}

fn body_lower_match_arm_from_comma_repeat_elem(remaining: Int, repeat_elem: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_elem))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: repeat_elem)
    match sugar_sequence_pair_optional(node: stripped) {
    Present { value: pair } =>
      body_lower_wire_match_arm_capture(remaining: remaining - 1, arm_capture: body_lower_postfix_optional_unwrap(remaining: remaining - 1, node: pair.right)
      )
    Absent =>
      body_lower_wire_match_arm_capture(remaining: remaining - 1, arm_capture: stripped)
    }
}
}

fn body_lower_extract_comma_list_arm_head(remaining: Int, node: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: node)
    match body_lower_wire_match_arm_capture(remaining: remaining - 1, arm_capture: stripped) {
    Rejected { diagnostics: _ } =>
      body_lower_match_arm_from_comma_repeat_elem(remaining: remaining - 1, repeat_elem: stripped)
    Accepted { value: arm, diagnostics: d } =>
      Accepted { value: arm, diagnostics: d }
    }
}
}

fn body_lower_wire_match_arm_capture(remaining: Int, arm_capture: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: arm_capture))
  } else {
    let stripped = body_lower_deep_unwrap_optional(remaining: remaining - 1, node: arm_capture)
    match parse_production_emitted_identity_optional(node: stripped) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_match_arm {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } =>
            body_lower_wire_match_arm_capture(remaining: remaining - 1, arm_capture: captured)
          Absent => body_lower_match_arm_wire_from_sequence(remaining: remaining - 1, stripped: stripped)
        }
      } else if body_lower_is_match_arm_navigate_emitted(remaining: remaining - 1, emitted: emitted) {
        match parse_production_captured_child_optional(node: stripped) {
          Present { value: captured } =>
            body_lower_wire_match_arm_capture(remaining: remaining - 1, arm_capture: captured)
          Absent => body_lower_match_arm_navigation_reject(remaining: remaining - 1, arm_capture: arm_capture)
        }
      } else {
        body_lower_match_arm_navigation_reject(remaining: remaining - 1, arm_capture: arm_capture)
      }
    Absent => body_lower_match_arm_wire_from_sequence(remaining: remaining - 1, stripped: stripped)
    }
}
}

fn body_lower_collect_match_arms_from_repeat_tail(remaining: Int, repeat_capture: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: repeat_capture))
  } else {
    if is_empty_conj_root(n: repeat_capture) {
    outcome_accepted(value: Empty)
    } else {
      match find_named_child(root: repeat_capture, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: head, diagnostics: _ } =>
        match body_lower_extract_comma_list_arm_head(remaining: remaining - 1, node: head) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: arm, diagnostics: d } =>
            match find_named_child(root: repeat_capture, name: ^grammar_sequence_right_node_projection) {
              Accepted { value: tail, diagnostics: _ } =>
                match body_lower_collect_match_arms_from_repeat_tail(remaining: remaining - 1, repeat_capture: tail) {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: rest, diagnostics: rd } =>
                    Accepted {
                      value: list_append(left: [arm], right: rest),
                      diagnostics: diagnostics_merge(outer: d, inner: rd)
                    }
                }
              Rejected { diagnostics: _ } =>
                Accepted { value: [arm], diagnostics: d }
            }
        }
      Rejected { diagnostics: _ } => outcome_accepted(value: Empty)
      }
    }
}
}

fn body_lower_collect_match_arms(remaining: Int, sequence_capture: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: sequence_capture))
  } else {
    let unwrapped = body_lower_postfix_optional_unwrap(remaining: remaining - 1, node: sequence_capture)
    match find_named_child(root: unwrapped, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: first, diagnostics: _ } =>
      match body_lower_extract_comma_list_arm_head(remaining: remaining - 1, node: first) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: arm, diagnostics: d } =>
          match find_named_child(root: unwrapped, name: ^grammar_sequence_right_node_projection) {
            Accepted { value: tail, diagnostics: _ } =>
              match body_lower_collect_match_arms_from_repeat_tail(remaining: remaining - 1, repeat_capture: tail) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: rest, diagnostics: rd } =>
                  Accepted {
                    value: list_append(left: [arm], right: rest),
                    diagnostics: diagnostics_merge(outer: d, inner: rd)
                  }
              }
            Rejected { diagnostics: _ } =>
              Accepted { value: [arm], diagnostics: d }
          }
      }
    Rejected { diagnostics: _ } =>
      match sugar_sequence_pair_optional(node: unwrapped) {
        Present { value: pair } =>
          match body_lower_extract_comma_list_arm_head(remaining: remaining - 1, node: pair.left) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: arm, diagnostics: d } =>
              bind_outcome(
                o: body_lower_after_comma_tail_optional(remaining: remaining - 1, node: pair.right),
                f: fn(tail_opt) {
                  match tail_opt {
                    Present { value: tail } =>
                      match body_lower_collect_match_arms(remaining: remaining - 1, sequence_capture: tail) {
                        Rejected { diagnostics: r } => Rejected { diagnostics: r }
                        Accepted { value: rest, diagnostics: rd } =>
                          Accepted {
                            value: list_append(left: [arm], right: rest),
                            diagnostics: diagnostics_merge(outer: d, inner: rd)
                          }
                      }
                    Absent => Accepted { value: [arm], diagnostics: d }
                  }
                }
              )
          }
        Absent =>
          match body_lower_extract_comma_list_arm_head(remaining: remaining - 1, node: unwrapped) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: arm, diagnostics: d } =>
              Accepted { value: [arm], diagnostics: d }
          }
      }
    }
}
}

fn body_lower_match_arms_from_brace_interior(remaining: Int, interior: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: interior))
  } else {
    let unwrapped = body_lower_postfix_optional_unwrap(remaining: remaining - 1, node: interior)
    match sugar_sequence_pair_optional(node: unwrapped) {
    Present { value: pair } =>
      body_lower_collect_match_arms(remaining: remaining - 1, sequence_capture: body_lower_unwrap_optional_element(remaining: remaining - 1, node: pair.left)
      )
    Absent =>
      body_lower_collect_match_arms(remaining: remaining - 1, sequence_capture: unwrapped)
    }
}
}

fn body_lower_match_spine_left(remaining: Int, spine: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: spine))
  } else {
    match find_named_child(root: spine, name: ^grammar_sequence_left_node_projection) {
      Accepted { value: left, diagnostics: _ } =>
        outcome_accepted(value: optional_present(value: left))
      Rejected { diagnostics: _ } =>
        match sugar_sequence_pair_optional(node: spine) {
          Present { value: pair } => outcome_accepted(value: optional_present(value: pair.left))
          Absent => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_match_spine_right(remaining: Int, spine: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: spine))
  } else {
    match find_named_child(root: spine, name: ^grammar_sequence_right_node_projection) {
      Accepted { value: right, diagnostics: _ } =>
        outcome_accepted(value: optional_present(value: right))
      Rejected { diagnostics: _ } =>
        match sugar_sequence_pair_optional(node: spine) {
          Present { value: pair } => outcome_accepted(value: optional_present(value: pair.right))
          Absent => outcome_accepted(value: optional_absent())
        }
    }
  }
}

fn body_lower_match_scrutinee_on_token(remaining: Int, id: Symbol, left: Node, right: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: left))
  } else if id == ^dag_token_lbrace {
    outcome_accepted(value: optional_absent())
  } else if id == ^dag_token_kw_match {
    body_lower_match_scrutinee_from_spine(remaining: remaining - 1, spine: right)
  } else {
    bind_outcome(
      o: body_lower_operand_ref_optional(remaining: remaining - 1, node: left),
      f: fn(op_opt) {
        match op_opt {
          Present { value: op } => outcome_accepted(value: optional_present(value: op))
          Absent => body_lower_match_scrutinee_from_spine(remaining: remaining - 1, spine: right)
        }
      }
    )
  }
}

fn body_lower_match_scrutinee_from_spine(remaining: Int, spine: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: spine))
  } else if is_empty_conj_root(n: spine) {
    outcome_accepted(value: optional_absent())
  } else {
    bind_outcome(
      o: body_lower_match_spine_left(remaining: remaining - 1, spine: spine),
      f: fn(left_opt) {
        match left_opt {
          Absent => outcome_accepted(value: optional_absent())
          Present { value: left } =>
            bind_outcome(
              o: body_lower_match_spine_right(remaining: remaining - 1, spine: spine),
              f: fn(right_opt) {
                match right_opt {
                  Absent => outcome_accepted(value: optional_absent())
                  Present { value: right } =>
                    match node_atom_identity_optional(
                      node: body_lower_deep_unwrap_optional(remaining: remaining - 1, node: left)
                    ) {
                      Present { value: id } =>
                        body_lower_match_scrutinee_on_token(
                          remaining: remaining - 1,
                          id: id,
                          left: left,
                          right: right
                        )
                      Absent =>
                        bind_outcome(
                          o: body_lower_operand_ref_optional(remaining: remaining - 1, node: left),
                          f: fn(op_opt) {
                            match op_opt {
                              Present { value: op } => outcome_accepted(value: optional_present(value: op))
                              Absent =>
                                body_lower_match_scrutinee_from_spine(remaining: remaining - 1, spine: right)
                            }
                          }
                        )
                    }
                }
              }
            )
        }
      }
    )
  }
}

fn body_lower_match_scrutinee_optional(remaining: Int, captured: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: captured))
  } else {
    match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_binary_expr) {
      ParseSubtreeFound { captured: binary } =>
        body_lower_operand_ref_optional(remaining: remaining - 1, node: binary)
      ParseSubtreeAbsent =>
        match parse_subtree_find_production_captured(root: captured, emitted: ^dag_surface_postfix_expr) {
          ParseSubtreeFound { captured: postfix } =>
            body_lower_operand_ref_optional(remaining: remaining - 1, node: postfix)
          ParseSubtreeAbsent =>
            body_lower_match_scrutinee_from_spine(
              remaining: remaining - 1,
              spine: body_lower_unwrap_surface_shell(remaining: remaining - 1, node: captured)
            )
        }
    }
  }
}

fn body_lower_match_arms_on_lbrace_token(remaining: Int, id: Symbol, right: Node) -> Outcome<Optional<List<Node>>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: right))
  } else {
    match id == ^dag_token_lbrace {
    true =>
      match body_lower_match_arms_from_brace_interior(remaining: remaining - 1, interior: right) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: arms, diagnostics: d } =>
          if count(arms) > 0 {
            Accepted {
              value: optional_present(value: arms),
              diagnostics: d
            }
          } else {
            outcome_rejected(
              d: body_lower_diagnostic(
                reason: ^body_lowering_reason_match_arm_navigation_refused,
                n: right
              )
            )
          }
      }
    false => body_lower_match_arms_after_lbrace_optional(remaining: remaining - 1, spine: right)
    }
}
}

fn body_lower_match_arms_after_lbrace_optional(remaining: Int, spine: Node) -> Outcome<Optional<List<Node>>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: spine))
  } else {
    if is_empty_conj_root(n: spine) {
      outcome_accepted(value: optional_absent())
    } else {
      bind_outcome(
        o: body_lower_match_spine_left(remaining: remaining - 1, spine: spine),
        f: fn(left_opt) {
          match left_opt {
            Absent => outcome_accepted(value: optional_absent())
            Present { value: left } =>
              bind_outcome(
                o: body_lower_match_spine_right(remaining: remaining - 1, spine: spine),
                f: fn(right_opt) {
                  match right_opt {
                    Absent => outcome_accepted(value: optional_absent())
                    Present { value: right } =>
                      match node_atom_identity_optional(
                        node: body_lower_deep_unwrap_optional(remaining: remaining - 1, node: left)
                      ) {
                        Present { value: id } =>
                          body_lower_match_arms_on_lbrace_token(remaining: remaining - 1, id: id, right: right)
                        Absent =>
                          body_lower_match_arms_after_lbrace_optional(remaining: remaining - 1, spine: right)
                      }
                  }
                }
              )
          }
        }
      )
    }
}
}

fn body_lower_match_arms_optional(remaining: Int, captured: Node) -> Outcome<Optional<List<Node>>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: captured))
  } else {
    body_lower_match_arms_after_lbrace_optional(remaining: remaining - 1, spine: body_lower_unwrap_surface_shell(remaining: remaining - 1, node: captured)
    )
}
}

fn body_lower_try_match_from_captured(remaining: Int, captured: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: captured))
  } else {
    bind_outcome(
      o: body_lower_match_scrutinee_optional(remaining: remaining - 1, captured: captured),
      f: fn(scrutinee_opt) {
        match scrutinee_opt {
          Absent =>
            outcome_rejected(
              d: body_lower_diagnostic(
                reason: ^body_lowering_reason_match_arm_navigation_refused,
                n: captured
              )
            )
          Present { value: scrutinee } =>
            match body_lower_match_arms_optional(remaining: remaining - 1, captured: captured) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: arms_opt, diagnostics: d } =>
                match arms_opt {
                  Present { value: arms } =>
                    if count(arms) > 0 {
                      Accepted {
                        value: optional_present(value: lower_match(scrutinee: scrutinee, arms: arms)),
                        diagnostics: d
                      }
                    } else {
                      outcome_rejected(
                        d: body_lower_diagnostic(
                          reason: ^body_lowering_reason_match_arm_navigation_refused,
                          n: captured
                        )
                      )
                    }
                  Absent =>
                    outcome_rejected(
                      d: body_lower_diagnostic(
                        reason: ^body_lowering_reason_match_arm_navigation_refused,
                        n: captured
                      )
                    )
                }
            }
        }
      }
    )
}
}

fn body_lower_match_capture_heads_spine(remaining: Int, spine: Node) -> Bool {
  match remaining <= 0 {
    true => false
    false =>
      match body_lower_match_spine_left(remaining: remaining - 1, spine: spine) {
        Rejected { diagnostics: _ } => false
        Accepted { value: left_opt, diagnostics: _ } =>
          match left_opt {
            Absent => false
            Present { value: left } =>
              match node_atom_identity_optional(
                node: body_lower_deep_unwrap_optional(remaining: remaining - 1, node: left)
              ) {
                Present { value: id } => id == ^dag_token_kw_match
                Absent => false
              }
          }
      }
  }
}

fn body_lower_try_match_from_node(remaining: Int, node: Node) -> Outcome<Optional<Node>> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: node))
  } else {
    match parse_production_emitted_identity_optional(node: node) {
    Present { value: emitted } =>
      if emitted == ^dag_surface_match_expr {
        bind_outcome(
          o: body_lower_unwrap_captured(remaining: remaining - 1, shell: node),
          f: fn(captured_opt) {
            match captured_opt {
              Present { value: captured } =>
                body_lower_try_match_from_captured(remaining: remaining - 1, captured: captured)
              Absent => outcome_accepted(value: optional_absent())
            }
          }
        )
      } else {
        outcome_accepted(value: optional_absent())
      }
    Absent =>
      if body_lower_match_capture_heads_spine(remaining: remaining - 1, spine: body_lower_unwrap_surface_shell(remaining: remaining - 1, node: node)
      ) {
        body_lower_try_match_from_captured(remaining: remaining - 1, captured: node)
      } else {
        outcome_accepted(value: optional_absent())
      }
    }
}
}

fn body_lower_match_expr(remaining: Int, shell: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    bind_outcome(
      o: body_lower_unwrap_captured(remaining: remaining - 1, shell: shell),
      f: fn(captured_opt) {
        match captured_opt {
          Absent =>
            outcome_rejected(
              d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
            )
          Present { value: captured } =>
            match body_lower_try_match_from_captured(remaining: remaining - 1, captured: captured) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: lowered_opt, diagnostics: d } =>
                match lowered_opt {
                  Present { value: lowered } =>
                    Accepted { value: lowered, diagnostics: d }
                  Absent =>
                    outcome_rejected(
                      d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
                    )
                }
            }
        }
      }
    )
}
}

fn body_lower_postfix_expr(remaining: Int, shell: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    bind_outcome(
      o: body_lower_unwrap_captured(remaining: remaining - 1, shell: shell),
      f: fn(captured_opt) {
        match captured_opt {
          Absent =>
            outcome_rejected(
              d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
            )
          Present { value: captured } =>
            bind_outcome(
              o: body_lower_pattern_first_atom_optional(remaining: remaining - 1, node: captured),
              f: fn(pat_opt) {
                match pat_opt {
                  Present { value: atom } => outcome_accepted(value: atom)
                  Absent =>
                    match body_lower_try_postfix_projection(remaining: remaining - 1, node: captured) {
                      Rejected { diagnostics: r } =>
                        bind_outcome(
                          o: body_lower_literal_bool_atom_optional(remaining: remaining - 1, node: captured),
                          f: fn(lit_opt) {
                            match lit_opt {
                              Present { value: lit } => outcome_accepted(value: lit)
                              Absent =>
                                bind_outcome(
                                  o: body_lower_pattern_first_atom_optional(remaining: remaining - 1, node: captured),
                                  f: fn(retry_opt) {
                                    match retry_opt {
                                      Present { value: atom } => outcome_accepted(value: atom)
                                      Absent => Rejected { diagnostics: r }
                                    }
                                  }
                                )
                            }
                          }
                        )
                      Accepted { value: found, diagnostics: d } =>
                        match found {
                          Present { value: transform } =>
                            Accepted { value: transform, diagnostics: d }
                          Absent =>
                            bind_outcome(
                              o: body_lower_try_infix_transform(remaining: remaining - 1, node: captured),
                              f: fn(infix_opt) {
                                match infix_opt {
                                  Present { value: transform } =>
                                    outcome_accepted(value: transform)
                                  Absent =>
                                    match body_lower_try_fold_loop(remaining: remaining - 1, node: captured) {
                                      Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                      Accepted { value: fold_result, diagnostics: _ } =>
                                        match fold_result {
                                          Present { value: loop_node } =>
                                            outcome_accepted(value: loop_node)
                                          Absent =>
                                            body_lower_try_operand_or_reject(
                                              remaining: remaining - 1,
                                              shell: shell,
                                              captured: captured
                                            )
                                        }
                                    }
                                }
                              }
                            )
                        }
                    }
                }
              }
            )
        }
      }
    )
}
}

fn body_lower_primary_expr(remaining: Int, shell: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    bind_outcome(
      o: body_lower_unwrap_captured(remaining: remaining - 1, shell: shell),
      f: fn(captured_opt) {
        match captured_opt {
          Absent =>
            outcome_rejected(
              d: body_lower_diagnostic(reason: ^body_lowering_reason_unsupported_form, n: shell)
            )
          Present { value: captured } =>
            bind_outcome(
              o: body_lower_pattern_first_atom_optional(remaining: remaining - 1, node: captured),
              f: fn(pat_opt) {
                match pat_opt {
                  Present { value: atom } => outcome_accepted(value: atom)
                  Absent =>
                    match body_lower_try_postfix_projection(remaining: remaining - 1, node: captured) {
                      Rejected { diagnostics: r } =>
                        bind_outcome(
                          o: body_lower_literal_bool_atom_optional(remaining: remaining - 1, node: captured),
                          f: fn(lit_opt) {
                            match lit_opt {
                              Present { value: lit } => outcome_accepted(value: lit)
                              Absent =>
                                bind_outcome(
                                  o: body_lower_pattern_first_atom_optional(remaining: remaining - 1, node: captured),
                                  f: fn(retry_opt) {
                                    match retry_opt {
                                      Present { value: atom } => outcome_accepted(value: atom)
                                      Absent => Rejected { diagnostics: r }
                                    }
                                  }
                                )
                            }
                          }
                        )
                      Accepted { value: found, diagnostics: d } =>
                        match found {
                          Present { value: transform } =>
                            Accepted { value: transform, diagnostics: d }
                          Absent =>
                            bind_outcome(
                              o: body_lower_try_infix_transform(remaining: remaining - 1, node: captured),
                              f: fn(infix_opt) {
                                match infix_opt {
                                  Present { value: transform } =>
                                    outcome_accepted(value: transform)
                                  Absent =>
                                    match body_lower_try_fold_loop(remaining: remaining - 1, node: captured) {
                                      Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                      Accepted { value: fold_result, diagnostics: _ } =>
                                        match fold_result {
                                          Present { value: loop_node } =>
                                            outcome_accepted(value: loop_node)
                                          Absent =>
                                            body_lower_try_operand_or_reject(
                                              remaining: remaining - 1,
                                              shell: shell,
                                              captured: captured
                                            )
                                        }
                                    }
                                }
                              }
                            )
                        }
                    }
                }
              }
            )
        }
      }
    )
}
}

fn body_lower_production_emitted(remaining: Int, shell: Node, emitted: Symbol) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: shell))
  } else {
    if body_lower_is_metadata_preserved_emitted(emitted: emitted) {
    outcome_accepted(value: shell)
    } else if emitted == ^dag_surface_fn_decl {
    body_lower_fn_decl_to_arrow(remaining: remaining - 1, shell: shell)
    } else if emitted == ^dag_surface_postfix_expr {
    body_lower_postfix_expr(remaining: remaining - 1, shell: shell)
    } else if emitted == ^dag_surface_match_expr {
    body_lower_match_expr(remaining: remaining - 1, shell: shell)
    } else if body_lower_is_pass_through_emitted(emitted: emitted) {
    body_lower_unwrap_pass_through(remaining: remaining - 1, shell: shell)
    } else if emitted == ^dag_surface_primary_expr {
    body_lower_primary_expr(remaining: remaining - 1, shell: shell)
    } else if body_lower_is_deferred_lower_emitted(emitted: emitted) {
    outcome_accepted(value: shell)
    } else {
      body_lower_wrapper_retained_shell(remaining: remaining - 1, shell: shell)
      }
}
}

fn body_lower_after_children(remaining: Int, folded: Node) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(d: body_lower_descent_not_proven_diagnostic(n: folded))
  } else {
    if body_lower_is_core_substrate(node: folded) {
    outcome_accepted(value: folded)
    } else if dag_resolve_preserve_module_metadata_subtree(node: folded) {
    outcome_accepted(value: folded)
    } else {
      match parse_production_emitted_identity_optional(node: folded) {
      Absent => outcome_accepted(value: folded)
      Present { value: emitted } => body_lower_production_emitted(remaining: remaining - 1, shell: folded, emitted: emitted)
      }
    }
}
}

fn body_lower_finish(n: Node, folded: Node, cd: Diagnostics) -> Outcome<Node> {
  let budget = node_subtree_count(n: folded)
  match body_lower_after_children(remaining: budget, folded: folded) {
    Rejected { diagnostics: r } =>
      Rejected {
        diagnostics: rejected_with_pending(pending: cd, rejected: r)
      }
    Accepted { value: lowered, diagnostics: d } =>
      Accepted {
        value: lowered,
        diagnostics: diagnostics_merge(outer: cd, inner: d)
      }
  }
}
