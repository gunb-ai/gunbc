            v2.std.optional.Present { value: id } =>
              if id == ^dag_token_kw_in {
                v2.std.optional.optional_present(value: right)
              } else {
                match body_lower_let_in_body_capture_optional(captured: left) {
                  v2.std.optional.Present { value: found } => v2.std.optional.optional_present(value: found)
                  v2.std.optional.Absent =>
                    match body_lower_let_in_body_capture_optional(captured: right) {
                      v2.std.optional.Present { value: found } => v2.std.optional.optional_present(value: found)
                      v2.std.optional.Absent => v2.std.optional.optional_absent()
                    }
                }
              }
            v2.std.optional.Absent =>
              match body_lower_let_in_body_capture_optional(captured: left) {
                v2.std.optional.Present { value: found } => v2.std.optional.optional_present(value: found)
                v2.std.optional.Absent => body_lower_let_in_body_capture_optional(captured: right)
              }
          }
        v2.std.optional.Absent => body_lower_let_in_body_capture_optional(captured: left)
      }
    v2.std.optional.Absent =>
      match v2.std.compilers.sugar.sugar_sequence_pair_optional(node: spine) {
        v2.std.optional.Present { value: pair } =>
          match body_lower_let_in_body_capture_optional(captured: pair.left) {
            v2.std.optional.Present { value: found } => v2.std.optional.optional_present(value: found)
            v2.std.optional.Absent => body_lower_let_in_body_capture_optional(captured: pair.right)
          }
        v2.std.optional.Absent =>
          fold(spine.children, init: v2.std.optional.optional_absent(), f: fn(acc, e) {
            match acc {
              v2.std.optional.Present { value: _ } => acc
              v2.std.optional.Absent => body_lower_let_in_body_capture_optional(captured: e.target)
            }
