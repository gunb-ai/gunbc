module v2.compiler.use_site_verdict

import v2.std.algebra { list_snoc_item }
import v2.std.collection { List }
import v2.std.node {
  Absent,
  Ambiguous,
  Atom,
  Edge,
  Found,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  named_edge_target_lookup,
  node_rebuild,
  node_synthetic
}

type UseSiteVerdict
  = MoveWhole
  | MoveField { field: Symbol }
  | Borrow
  | CloneShared
  | Unclassified

type UseSiteVerdictLookup
  = VerdictFound { verdict: UseSiteVerdict }
  | VerdictAbsent
  | VerdictAmbiguous

data use_site_verdict_edge: Symbol = ^use_site_verdict
data use_site_verdict_field_edge: Symbol = ^use_site_verdict_field
data use_site_verdict_move_whole_tag: Symbol = ^use_site_verdict_move_whole
data use_site_verdict_move_field_tag: Symbol = ^use_site_verdict_move_field
data use_site_verdict_borrow_tag: Symbol = ^use_site_verdict_borrow
data use_site_verdict_clone_shared_tag: Symbol = ^use_site_verdict_clone_shared
data use_site_verdict_unclassified_tag: Symbol = ^use_site_verdict_unclassified

fn use_site_verdict_atom(tag: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: tag } }, children: [])
}

fn use_site_verdict_to_node(verdict: UseSiteVerdict) -> Node {
  match verdict {
    MoveWhole => use_site_verdict_atom(tag: use_site_verdict_move_whole_tag)
    MoveField { field: f } =>
      node_synthetic(
        kind: TypeNode { connective: Atom { identity: use_site_verdict_move_field_tag } },
        children: [
          Edge { label: Named { name: use_site_verdict_field_edge }, target: use_site_verdict_atom(tag: f) }
        ]
      )
    Borrow => use_site_verdict_atom(tag: use_site_verdict_borrow_tag)
    CloneShared => use_site_verdict_atom(tag: use_site_verdict_clone_shared_tag)
    Unclassified => use_site_verdict_atom(tag: use_site_verdict_unclassified_tag)
  }
}

fn use_site_verdict_move_field_of(children: List<Edge>) -> UseSiteVerdict {
  match named_edge_target_lookup(children: children, name: use_site_verdict_field_edge) {
    Found { target: field_node } =>
      match field_node.kind {
        TypeNode { connective: Atom { identity: f } } => MoveField { field: f }
        _ => Unclassified
      }
    Absent => Unclassified
    Ambiguous => Unclassified
  }
}

fn use_site_verdict_of_node(target: Node) -> UseSiteVerdict {
  match target.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      if sym == use_site_verdict_move_whole_tag {
        MoveWhole
      } else if sym == use_site_verdict_borrow_tag {
        Borrow
      } else if sym == use_site_verdict_clone_shared_tag {
        CloneShared
      } else if sym == use_site_verdict_move_field_tag {
        use_site_verdict_move_field_of(children: target.children)
      } else {
        Unclassified
      }
    _ => Unclassified
  }
}

fn use_site_verdict_lookup(node: Node) -> UseSiteVerdictLookup {
  match named_edge_target_lookup(children: node.children, name: use_site_verdict_edge) {
    Found { target: t } => VerdictFound { verdict: use_site_verdict_of_node(target: t) }
    Absent => VerdictAbsent
    Ambiguous => VerdictAmbiguous
  }
}

fn attach_use_site_verdict(node: Node, verdict: UseSiteVerdict) -> Node {
  node_rebuild(
    n: node,
    children: list_snoc_item(
      xs: node.children,
      item: Edge { label: Named { name: use_site_verdict_edge }, target: use_site_verdict_to_node(verdict: verdict) }
    )
  )
}
