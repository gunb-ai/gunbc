module v2.compiler.namespace_graft


data namespace_graft_qn_reader_home_note: String = "The QN readers (qualified_name_from_module_node — graft-aware, single authority — plus the graft-spine walk cluster) live in v2.extdeps.languages.dag: the grafted module shape is a fact of the dag language surface, and homing the spine walk beside the header readers keeps one collapsed reader with no compiler-layer import (the former qualified_name_from_module_node_graft_aware Scaffold and its extdeps-coupling sibling dissolved to that SingleAuthority). This module keeps only the graft TRANSFORM (pre-graft tree -> containment spine) and its edge dispositions."

type ModuleRootEdgeDisposition
  = ModuleRootEdgeDissolve
  | ModuleRootEdgeGraftBody
  | ModuleRootEdgeRehomeProvenance

data namespace_graft_edge_disposition_note: String = "Module-root edge census (pre-graft working tree; none silently dropped): dag_surface_module_header + dag_surface_module_header_qualified_name → DISSOLVE (metadata; QN read once for graft). grammar_production_identity_node_projection → RE-HOME on output ModuleShell (^dag_surface_module provenance only). grammar_production_captured_node_projection → DISSOLVE (unwrap before graft). grammar_sequence/repeat *_node_projection, ^dag_surface_top_level_item shells, fn/data/type/import decl Named edges, Positional repeat spines, and every other non-metadata child → GRAFT_BODY (entire declaration forest under innermost Conj; extent is never an export subset)."

fn namespace_graft_module_root_edge_disposition(name: v2.std.node.Symbol) -> ModuleRootEdgeDisposition {
  if v2.extdeps.languages.dag.dag_surface_module_header_metadata_edge(name: name) {
    ModuleRootEdgeDissolve
  } else if name == ^grammar_production_identity_node_projection {
    ModuleRootEdgeRehomeProvenance
  } else if name == ^grammar_production_captured_node_projection {
    ModuleRootEdgeDissolve
  } else {
    ModuleRootEdgeGraftBody
  }
}

fn namespace_graft_is_metadata_edge(name: v2.std.node.Symbol) -> Bool {
  v2.extdeps.languages.dag.dag_surface_module_header_metadata_edge(name: name)
}

fn namespace_graft_is_module_shell(root: v2.std.node.Node) -> Bool {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: root) {
    v2.std.collection.Present { value: id } => id == ^dag_surface_module
    v2.std.collection.Absent => false
  }
}

fn namespace_graft_parse_projection_edge(name: v2.std.node.Symbol) -> Bool {
  (name == ^grammar_production_identity_node_projection)
    || (name == ^grammar_production_captured_node_projection)
    || ends_with(s: v2.std.compilers.lexing.symbol_lexeme(sym: name), suffix: "_node_projection")
}

fn namespace_graft_is_module_header_subtree(node: v2.std.node.Node) -> Bool {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    v2.std.collection.Present { value: id } => id == ^dag_surface_module_header
    v2.std.collection.Absent => false
  }
}

fn namespace_graft_is_transparent_sequence_spine(node: v2.std.node.Node) -> Bool {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      if count(node.children) == 0 {
        false
      } else {
        fold(node.children, init: true, f: fn(ok, e) {
          if !ok {
            false
          } else {
            match e.label {
              v2.std.node.Named { name: sym } => namespace_graft_parse_projection_edge(name: sym)
              v2.std.node.Positional => true
            }
          }
        })
      }
    _ => false
  }
}

fn namespace_graft_collect_body_edge(acc: List<v2.std.node.Edge>, edge: v2.std.node.Edge) -> List<v2.std.node.Edge> {
  match edge.label {
    v2.std.node.Named { name: sym } =>
      if namespace_graft_is_metadata_edge(name: sym) {
        acc
      } else if namespace_graft_parse_projection_edge(name: sym) {
        concat(acc, namespace_graft_collect_body_edges_from_node(node: edge.target))
      } else if namespace_graft_is_module_header_subtree(node: edge.target) {
        acc
      } else if namespace_graft_is_transparent_sequence_spine(node: edge.target) {
        concat(acc, namespace_graft_collect_body_edges_from_node(node: edge.target))
      } else {
        v2.std.algebra.list_snoc_item(xs: acc, item: edge)
      }
    v2.std.node.Positional =>
      if namespace_graft_is_module_header_subtree(node: edge.target) {
        acc
      } else if namespace_graft_is_transparent_sequence_spine(node: edge.target) {
        concat(acc, namespace_graft_collect_body_edges_from_node(node: edge.target))
      } else {
        v2.std.algebra.list_snoc_item(xs: acc, item: edge)
      }
  }
}

fn namespace_graft_collect_body_edges_from_node(node: v2.std.node.Node) -> List<v2.std.node.Edge> {
  fold(node.children, init: [], f: fn(acc, edge) {
    namespace_graft_collect_body_edge(acc: acc, edge: edge)
  })
}

fn namespace_graft_is_graft_candidate(root: v2.std.node.Node) -> Bool {
  if v2.extdeps.languages.dag.namespace_graft_already_grafted(root: root) {
    false
  } else if namespace_graft_is_module_shell(root: root) {
    true
  } else {
    v2.extdeps.languages.dag.namespace_graft_has_module_header(root: root)
  }
}

fn namespace_graft_collect_body_edges(root: v2.std.node.Node) -> List<v2.std.node.Edge> {
  namespace_graft_collect_body_edges_from_node(
    node: v2.extdeps.languages.dag.namespace_graft_unwrap_module_working_root(root: root)
  )
}

// The empty-observation narrow made unwritable (operator ruling msg_d18a55de): a
// collector that cannot express a module's declarations must not report "this module
// has none". A pre-graft tree that carries top-level declarations (the
// dag_surface_top_level_item identity atoms survive the normalize fold on every
// measured shape) while the collected body is EMPTY is the collector failing to
// carry the forest — a decidable comparison of two trees in hand, refused loudly.
// A module with no declarations at all (header only) keeps its legitimate empty
// body: the discriminant is declaration presence, not body emptiness alone. This
// guard covers total dissolution; partial-drop fidelity is the deeper graft repair.
fn namespace_graft_subtree_contains_atom(n: v2.std.node.Node, sym: v2.std.node.Symbol) -> Bool {
  match n.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      if id == sym {
        true
      } else {
        namespace_graft_children_contain_atom(n: n, sym: sym)
      }
    _ => namespace_graft_children_contain_atom(n: n, sym: sym)
  }
}

fn namespace_graft_children_contain_atom(n: v2.std.node.Node, sym: v2.std.node.Symbol) -> Bool {
  fold(n.children, init: false, f: fn(found, e) {
    if found {
      true
    } else {
      namespace_graft_subtree_contains_atom(n: e.target, sym: sym)
    }
  })
}

fn namespace_graft_body_dissolved(root: v2.std.node.Node, body_edges: List<v2.std.node.Edge>) -> Bool {
  if count(body_edges) == 0 {
    namespace_graft_subtree_contains_atom(
      n: v2.extdeps.languages.dag.namespace_graft_unwrap_module_working_root(root: root),
      sym: ^dag_surface_top_level_item
    )
  } else {
    false
  }
}

fn namespace_graft_build_body_conj(edges: List<v2.std.node.Edge>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: edges,
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn namespace_graft_wrap_segment(segment: v2.std.node.Symbol, inner: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: segment },
        target: inner
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn namespace_graft_fold_spine(qn: v2.std.qualified_name.QualifiedName, body: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.algebra.fold_list_right(
    xs: qn,
    empty: body,
    snoc: fn(inner, segment) {
      namespace_graft_wrap_segment(segment: segment, inner: inner)
    }
  )
}

fn namespace_graft_atom_node(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn namespace_graft_wrap_module_shell(captured: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.extdeps.languages.dag.dag_named_edge(
        name: ^grammar_production_identity_node_projection,
        target: namespace_graft_atom_node(id: ^dag_surface_module)
      ),
      v2.extdeps.languages.dag.dag_named_edge(
        name: ^grammar_production_captured_node_projection,
        target: captured
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn namespace_graft_has_explicit_braced_container(root: v2.std.node.Node, first_segment: v2.std.node.Symbol) -> Bool {
  let working = v2.extdeps.languages.dag.namespace_graft_unwrap_module_working_root(root: root)
  fold(
    working.children,
    init: false,
    f: fn(found, edge) {
      if found {
        true
      } else {
        match edge.label {
          v2.std.node.Named { name: sym } =>
            if namespace_graft_is_metadata_edge(name: sym) {
              false
            } else if sym == first_segment {
              match edge.target.kind {
                v2.std.node.TypeNode { connective: v2.std.node.Conj } => true
                _ => false
              }
            } else {
              false
            }
          v2.std.node.Positional => false
        }
      }
    }
  )
}

fn namespace_graft_dual_position_refused(root: v2.std.node.Node) -> Bool {
  if !namespace_graft_is_graft_candidate(root: root) {
    false
  } else {
    match v2.extdeps.languages.dag.qualified_name_from_module_node(root: root) {
      v2.std.diagnostic.Rejected { diagnostics: _ } => false
      v2.std.diagnostic.Accepted { value: qn, diagnostics: _ } =>
        match qn {
          std.algebra.Empty => false
          std.algebra.Cons { head: first, tail: _ } =>
            namespace_graft_has_explicit_braced_container(root: root, first_segment: first)
        }
    }
  }
}

fn module_header_containment_graft(root: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if v2.extdeps.languages.dag.namespace_graft_already_grafted(root: root) {
    v2.std.diagnostic.outcome_accepted(value: root)
  } else if namespace_graft_dual_position_refused(root: root) {
    v2.std.diagnostic.outcome_rejected(v2.std.diagnostic.Diagnostic {
      reason: ^namespace_graft_dual_position_refused,
      at: v2.std.diagnostic.node_locus(node: root),
      correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
    })
  } else if !namespace_graft_is_graft_candidate(root: root) {
    v2.std.diagnostic.outcome_accepted(value: root)
  } else {
    match v2.extdeps.languages.dag.qualified_name_from_module_node(root: root) {
      v2.std.diagnostic.Rejected { diagnostics: diags } => v2.std.diagnostic.Rejected { diagnostics: diags }
      v2.std.diagnostic.Accepted { value: qn, diagnostics: _ } =>
        match qn {
          std.algebra.Empty =>
            v2.std.diagnostic.outcome_rejected(v2.std.diagnostic.Diagnostic {
              reason: ^qualified_name_structure_invalid,
              at: v2.std.diagnostic.node_locus(node: root),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            })
          std.algebra.Cons { head: _, tail: _ } => {
            let body_edges = namespace_graft_collect_body_edges(root: root)
            if namespace_graft_body_dissolved(root: root, body_edges: body_edges) {
              v2.std.diagnostic.outcome_rejected(v2.std.diagnostic.Diagnostic {
                reason: ^namespace_graft_body_dissolved_refused,
                at: v2.std.diagnostic.node_locus(node: root),
                correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
              })
            } else {
              let body = namespace_graft_build_body_conj(edges: body_edges)
              let spine = namespace_graft_fold_spine(qn: qn, body: body)
              v2.std.diagnostic.outcome_accepted(value: namespace_graft_wrap_module_shell(captured: spine))
            }
          }
        }
    }
  }
}

fn namespace_graft_strip_provenance_marker(root: v2.std.node.Node) -> v2.std.node.Node {
  v2.extdeps.languages.dag.namespace_graft_unwrap_module_working_root(root: root)
}
