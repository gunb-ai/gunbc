module v2.compiler.namespace_graft

import std.occurrence_identity { OccurrenceSynthetic }
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list, fold_list_right, list_append, list_head, list_snoc_item, list_tail, HeadAbsent, HeadFound, TailAbsent, TailFound }
import v2.std.collection { Absent, List, Present, optional_absent, optional_present }
import v2.std.compilers.sugar { sugar_sequence_pair_optional, sugar_unwrap_production_shell }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Atom,
  Cardinality,
  Conj,
  Disj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  node_rebuild,
  node_synthetic,
}
import v2.std.qualified_name { QualifiedName }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.grammar {
  GrammarExpr,
  GrammarExprFold,
  GrammarProduction,
  fold_grammar_expr,
  node_atom_identity_optional
}
import v2.extdeps.languages.dag {
  dag_binding_branded_atom_identity,
  dag_lex_token_symbol,
  dag_named_edge,
  dag_surface_module_header_metadata_edge,
  dag_grammar_root,
  dag_grammar_top_level_item_expr,
  namespace_graft_already_grafted,
  namespace_graft_has_module_header,
  namespace_graft_unwrap_module_working_root,
  parse_production_captured_child_optional,
  parse_production_emitted_identity_optional,
  qualified_name_from_module_node
}

// The QN readers (qualified_name_from_module_node — graft-aware, single authority — plus the
// graft-spine walk cluster) live in v2.extdeps.languages.dag: the grafted module shape is a fact of
// the dag language surface, and homing the spine walk beside the header readers keeps one collapsed
// reader with no compiler-layer import (the former qualified_name_from_module_node_graft_aware
// Scaffold and its extdeps-coupling sibling dissolved to that SingleAuthority). This module keeps
// only the graft TRANSFORM (pre-graft tree -> containment spine) and its edge dispositions.

type ModuleRootEdgeDisposition
  = ModuleRootEdgeDissolve
  | ModuleRootEdgeGraftBody
  | ModuleRootEdgeRehomeProvenance

// Module-root edge census (pre-graft working tree; none silently dropped):
// dag_surface_module_header + dag_surface_module_header_qualified_name → DISSOLVE (metadata; QN
// read once for graft). grammar_production_identity_node_projection → RE-HOME on output ModuleShell
// (^dag_surface_module provenance only). grammar_production_captured_node_projection → DISSOLVE
// (unwrap before graft). grammar_sequence/repeat *_node_projection, ^dag_surface_top_level_item
// shells, fn/data/type/import decl Named edges, Positional repeat spines, and every other
// non-metadata child → GRAFT_BODY (entire declaration forest under innermost Conj; extent is never
// an export subset).

fn namespace_graft_module_root_edge_disposition(name: Symbol) -> ModuleRootEdgeDisposition {
  if dag_surface_module_header_metadata_edge(name: name) {
    ModuleRootEdgeDissolve
  } else if name == ^grammar_production_identity_node_projection {
    ModuleRootEdgeRehomeProvenance
  } else if name == ^grammar_production_captured_node_projection {
    ModuleRootEdgeDissolve
  } else {
    ModuleRootEdgeGraftBody
  }
}

fn namespace_graft_is_metadata_edge(name: Symbol) -> Bool {
  dag_surface_module_header_metadata_edge(name: name)
}

fn namespace_graft_is_module_shell(root: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } => id == ^dag_surface_module
    Absent => false
  }
}

fn namespace_graft_parse_projection_edge(name: Symbol) -> Bool {
  (name == ^grammar_production_identity_node_projection)
    || (name == ^grammar_production_captured_node_projection)
    || ends_with(s: symbol_lexeme(sym: name), suffix: "_node_projection")
}

fn namespace_graft_is_module_header_subtree(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      (id == ^dag_surface_module_header) || (id == ^dag_surface_qualified_name)
    Absent => false
  }
}

fn namespace_graft_is_transparent_sequence_spine(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } =>
      if count(node.children) == 0 {
        false
      } else {
        fold(node.children, init: true, f: fn(ok, e) {
          if !ok {
            false
          } else {
            match e.label {
              Named { name: sym } => namespace_graft_parse_projection_edge(name: sym)
              Positional => true
            }
          }
        })
      }
    _ => false
  }
}

fn namespace_graft_collect_body_edge(acc: List<Edge>, edge: Edge) -> List<Edge> {
  match edge.label {
    Named { name: sym } =>
      if namespace_graft_is_metadata_edge(name: sym) {
        acc
      } else if namespace_graft_parse_projection_edge(name: sym) {
        concat(acc, namespace_graft_collect_body_edges_from_node(node: edge.target))
      } else if namespace_graft_is_module_header_subtree(node: edge.target) {
        acc
      } else if namespace_graft_is_transparent_sequence_spine(node: edge.target) {
        concat(acc, namespace_graft_collect_body_edges_from_node(node: edge.target))
      } else {
        list_snoc_item(xs: acc, item: edge)
      }
    Positional =>
      if namespace_graft_is_module_header_subtree(node: edge.target) {
        acc
      } else if namespace_graft_is_transparent_sequence_spine(node: edge.target) {
        concat(acc, namespace_graft_collect_body_edges_from_node(node: edge.target))
      } else {
        list_snoc_item(xs: acc, item: edge)
      }
  }
}

fn namespace_graft_collect_body_edges_from_node(node: Node) -> List<Edge> {
  fold(node.children, init: [], f: fn(acc, edge) {
    namespace_graft_collect_body_edge(acc: acc, edge: edge)
  })
}

fn namespace_graft_grammar_expr_nonterminal_productions(expr: GrammarExpr) -> List<Symbol> {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_, _) { [] },
      nonterminal: fn(production) { [production] },
      sequence: fn(left, right) { list_append(left: left, right: right) },
      choice: fn(left, right) { list_append(left: left, right: right) },
      optional: fn(xs) { xs },
      repeat: fn(xs) { xs }
    }
  )
}

fn namespace_graft_production_emitted_identity_optional(production: GrammarProduction) -> Symbol? {
  node_atom_identity_optional(node: production.emitted)
}

fn namespace_graft_emitted_identity_for_production_name(name: Symbol) -> Symbol? {
  fold_list(
    xs: dag_grammar_root().productions,
    empty: optional_absent(),
    cons: fn(acc, production) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match production.name == name {
            true => namespace_graft_production_emitted_identity_optional(production: production)
            false => optional_absent()
          }
      }
    }
  )
}

fn namespace_graft_top_level_item_alternative_emitted_ids() -> List<Symbol> {
  fold_list(
    xs: namespace_graft_grammar_expr_nonterminal_productions(expr: dag_grammar_top_level_item_expr()),
    empty: [],
    cons: fn(acc, production_name) {
      match namespace_graft_emitted_identity_for_production_name(name: production_name) {
        Present { value: emitted } => list_snoc_item(xs: acc, item: emitted)
        Absent => acc
      }
    }
  )
}

fn namespace_graft_id_is_top_level_item_unit(id: Symbol, unit_ids: List<Symbol>) -> Bool {
  fold_list(
    xs: unit_ids,
    empty: false,
    cons: fn(found, emitted) {
      found || (emitted == id)
    }
  )
}

fn namespace_graft_collect_unit_nodes(node: Node) -> List<Node> {
  namespace_graft_collect_unit_nodes_against(
    node: node,
    unit_ids: namespace_graft_top_level_item_alternative_emitted_ids()
  )
}

fn namespace_graft_collect_unit_nodes_against(node: Node, unit_ids: List<Symbol>) -> List<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if namespace_graft_id_is_top_level_item_unit(id: id, unit_ids: unit_ids) {
        [node]
      } else {
        fold(node.children, init: [], f: fn(acc, edge) {
          concat(acc, namespace_graft_collect_unit_nodes_against(node: edge.target, unit_ids: unit_ids))
        })
      }
    Absent =>
      fold(node.children, init: [], f: fn(acc, edge) {
        concat(acc, namespace_graft_collect_unit_nodes_against(node: edge.target, unit_ids: unit_ids))
      })
  }
}

fn namespace_graft_reconstruct_unit_edge(node: Node) -> Edge {
  Edge {
    label: Positional,
    target: node
  }
}

fn namespace_graft_reconstruct_declaration_forest(units: List<Node>) -> List<Edge> {
  [
    Edge {
      label: Named { name: ^dag_surface_top_level_item },
      target: Node {
        kind: TypeNode { connective: Cardinality },
        children: fold(units, init: [], f: fn(acc, unit) {
          list_snoc_item(xs: acc, item: namespace_graft_reconstruct_unit_edge(node: unit))
        }),
        occurrence_id: OccurrenceSynthetic
      }
    }
  ]
}

fn namespace_graft_ident_from_node(node: Node) -> Symbol? {
  let stripped = sugar_unwrap_production_shell(node: node)
  match dag_binding_branded_atom_identity(node: stripped) {
    Present { value: binding } => optional_present(value: binding)
    Absent =>
      match node_atom_identity_optional(node: stripped) {
        Present { value: sym } =>
          if dag_lex_token_symbol(sym: sym) {
            fold(stripped.children, init: optional_absent(), f: fn(acc, e) {
              match acc {
                Present { value: _ } => acc
                Absent => namespace_graft_ident_from_node(node: e.target)
              }
            })
          } else {
            optional_present(value: sym)
          }
        Absent =>
          fold(stripped.children, init: optional_absent(), f: fn(acc, e) {
            match acc {
              Present { value: _ } => acc
              Absent => namespace_graft_ident_from_node(node: e.target)
            }
          })
      }
  }
}

fn namespace_graft_kw_then_ident(captured: Node) -> Symbol? {
  match sugar_sequence_pair_optional(node: captured) {
    Absent => namespace_graft_ident_from_node(node: captured)
    Present { value: pair } =>
      match namespace_graft_ident_from_node(node: pair.left) {
        Present { value: _ } => namespace_graft_ident_from_node(node: pair.right)
        Absent =>
          match sugar_sequence_pair_optional(node: pair.right) {
            Present { value: rest } => namespace_graft_ident_from_node(node: rest.left)
            Absent => namespace_graft_ident_from_node(node: pair.right)
          }
      }
  }
}

fn namespace_graft_find_emitted(node: Node, emitted: Symbol) -> Node? {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == emitted {
        optional_present(value: node)
      } else {
        fold(node.children, init: optional_absent(), f: fn(acc, e) {
          match acc {
            Present { value: _ } => acc
            Absent => namespace_graft_find_emitted(node: e.target, emitted: emitted)
          }
        })
      }
    Absent =>
      fold(node.children, init: optional_absent(), f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => namespace_graft_find_emitted(node: e.target, emitted: emitted)
        }
      })
  }
}

fn namespace_graft_find_disj(node: Node) -> Node? {
  match node.kind {
    TypeNode { connective: Disj } => optional_present(value: node)
    _ =>
      fold(node.children, init: optional_absent(), f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => namespace_graft_find_disj(node: e.target)
        }
      })
  }
}

fn namespace_graft_is_machinery_symbol(sym: Symbol) -> Bool {
  if dag_lex_token_symbol(sym: sym) {
    true
  } else {
    let lex = symbol_lexeme(sym: sym)
    starts_with(s: lex, prefix: "dag_") || starts_with(s: lex, prefix: "grammar_")
  }
}

fn namespace_graft_user_atom_ident(node: Node) -> Symbol? {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: _ } => optional_absent()
    Absent =>
      match node_atom_identity_optional(node: sugar_unwrap_production_shell(node: node)) {
        Present { value: id } =>
          if namespace_graft_is_machinery_symbol(sym: id) {
            optional_absent()
          } else {
            optional_present(value: id)
          }
        Absent => optional_absent()
      }
  }
}

fn namespace_graft_collect_user_atom_idents(node: Node) -> List<Symbol> {
  match namespace_graft_user_atom_ident(node: node) {
    Present { value: id } => [id]
    Absent =>
      fold(node.children, init: [], f: fn(acc, e) {
        concat(acc, namespace_graft_collect_user_atom_idents(node: e.target))
      })
  }
}

fn namespace_graft_field_edges_from_syms(syms: List<Symbol>) -> List<Edge> {
  match list_head(xs: syms) {
    HeadAbsent => []
    HeadFound { value: field_name } =>
      match list_tail(xs: syms) {
        TailAbsent => []
        TailFound { tail: after_name } =>
          match list_head(xs: after_name) {
            HeadAbsent => []
            HeadFound { value: type_sym } =>
              let edge = Edge {
                label: Named { name: field_name },
                target: namespace_graft_atom_node(id: type_sym)
              }
              match list_tail(xs: after_name) {
                TailAbsent => [edge]
                TailFound { tail: more } =>
                  concat([edge], namespace_graft_field_edges_from_syms(syms: more))
              }
          }
      }
  }
}

fn namespace_graft_collect_field_edges(node: Node) -> List<Edge> {
  namespace_graft_field_edges_from_syms(
    syms: namespace_graft_collect_user_atom_idents(node: node)
  )
}

fn namespace_graft_type_decl_target(captured: Node) -> Node {
  match namespace_graft_find_disj(node: captured) {
    Present { value: disj } => disj
    Absent =>
      match namespace_graft_find_emitted(node: captured, emitted: ^dag_surface_field_decl_block) {
        Present { value: block } =>
          node_synthetic(
            kind: TypeNode { connective: Cardinality },
            children: namespace_graft_collect_field_edges(node: block)
          )
        Absent =>
          match list_tail(xs: namespace_graft_collect_user_atom_idents(node: captured)) {
            TailAbsent =>
              node_synthetic(kind: TypeNode { connective: Cardinality }, children: [])
            TailFound { tail: field_syms } =>
              node_synthetic(
                kind: TypeNode { connective: Cardinality },
                children: namespace_graft_field_edges_from_syms(syms: field_syms)
              )
          }
      }
  }
}

fn namespace_graft_unit_captured(unit: Node) -> Node? {
  parse_production_captured_child_optional(node: unit)
}

fn namespace_graft_type_decl_name(unit: Node) -> Symbol? {
  match namespace_graft_unit_captured(unit: unit) {
    Present { value: captured } =>
      match namespace_graft_kw_then_ident(captured: captured) {
        Present { value: name } => optional_present(value: name)
        Absent => namespace_graft_ident_from_node(node: unit)
      }
    Absent => namespace_graft_ident_from_node(node: unit)
  }
}

fn namespace_graft_type_decl_named_edge(unit: Node) -> Edge? {
  match namespace_graft_type_decl_name(unit: unit) {
    Absent => optional_absent()
    Present { value: type_name } =>
      optional_present(
        value: Edge {
          label: Named { name: type_name },
          target: namespace_graft_type_decl_target(captured: unit)
        }
      )
  }
}

fn namespace_graft_data_decl_named_edge(unit: Node) -> Edge? {
  match namespace_graft_unit_captured(unit: unit) {
    Absent => optional_absent()
    Present { value: captured } =>
      match namespace_graft_kw_then_ident(captured: captured) {
        Absent => optional_absent()
        Present { value: data_name } =>
          optional_present(
            value: Edge {
              label: Named { name: data_name },
              target: captured
            }
          )
      }
  }
}

fn namespace_graft_named_edge_from_unit(unit: Node) -> Edge? {
  match parse_production_emitted_identity_optional(node: unit) {
    Present { value: id } =>
      match id == ^dag_surface_type_decl {
        true => namespace_graft_type_decl_named_edge(unit: unit)
        false =>
          match id == ^dag_surface_data_decl {
            true => namespace_graft_data_decl_named_edge(unit: unit)
            false => optional_absent()
          }
      }
    Absent => optional_absent()
  }
}

fn namespace_graft_named_edges_from_units(units: List<Node>) -> List<Edge> {
  fold(units, init: [], f: fn(acc, unit) {
    match namespace_graft_named_edge_from_unit(unit: unit) {
      Present { value: edge } => list_snoc_item(xs: acc, item: edge)
      Absent => acc
    }
  })
}

type NamespaceGraftDeclWalk {
  pending: Symbol?
  edges: List<Edge>
}

fn namespace_graft_decl_walk_init() -> NamespaceGraftDeclWalk {
  NamespaceGraftDeclWalk {
    pending: optional_absent(),
    edges: []
  }
}

fn namespace_graft_bind_pending_field_block(
  acc: NamespaceGraftDeclWalk,
  node: Node
) -> NamespaceGraftDeclWalk? {
  match acc.pending {
    Absent => optional_absent()
    Present { value: type_name } =>
      match namespace_graft_find_emitted(node: node, emitted: ^dag_surface_field_decl_block) {
        Absent => optional_absent()
        Present { value: block } =>
          optional_present(
            value: NamespaceGraftDeclWalk {
              pending: optional_absent(),
              edges: list_snoc_item(
                xs: acc.edges,
                item: Edge {
                  label: Named { name: type_name },
                  target: node_synthetic(
                    kind: TypeNode { connective: Cardinality },
                    children: namespace_graft_collect_field_edges(node: block)
                  )
                }
              )
            }
          )
      }
  }
}

fn namespace_graft_decl_walk_step(
  acc: NamespaceGraftDeclWalk,
  node: Node
) -> NamespaceGraftDeclWalk {
  if namespace_graft_is_module_header_subtree(node: node) {
    acc
  } else {
    match namespace_graft_named_edge_from_unit(unit: node) {
      Present { value: edge } =>
        NamespaceGraftDeclWalk {
          pending: optional_absent(),
          edges: list_snoc_item(xs: acc.edges, item: edge)
        }
      Absent =>
        match namespace_graft_bind_pending_field_block(acc: acc, node: node) {
          Present { value: bound } => bound
          Absent =>
            match namespace_graft_ident_from_node(node: node) {
              Present { value: ident } =>
                match acc.pending {
                  Present { value: _ } => namespace_graft_decl_walk_children(acc: acc, node: node)
                  Absent =>
                    if namespace_graft_is_machinery_symbol(sym: ident) {
                      namespace_graft_decl_walk_children(acc: acc, node: node)
                    } else {
                      namespace_graft_decl_walk_children(
                        acc: NamespaceGraftDeclWalk {
                          pending: optional_present(value: ident),
                          edges: acc.edges
                        },
                        node: node
                      )
                    }
                }
              Absent => namespace_graft_decl_walk_children(acc: acc, node: node)
            }
        }
    }
  }
}

fn namespace_graft_decl_walk_children(
  acc: NamespaceGraftDeclWalk,
  node: Node
) -> NamespaceGraftDeclWalk {
  fold(node.children, init: acc, f: fn(inner, e) {
    namespace_graft_decl_walk_step(acc: inner, node: e.target)
  })
}

fn namespace_graft_decl_edges_from_node(node: Node) -> List<Edge> {
  namespace_graft_decl_walk_step(acc: namespace_graft_decl_walk_init(), node: node).edges
}

// Flattening to Named declaration edges is what symbol_index_fill consumes. A fn_decl
// arrives already rehomed by body_lower_fn_decl_to_arrow; type_decl and data_decl did
// not, so flatten was empty for a type-only module (reconstruct kept raw shells —
// resolve walked On/Off as bare mentions) and nonempty when a fn sat beside them
// (the type shell was dropped). Neither arm is a refusal. Rehome type/data onto
// Named containment first; reconstruct remains only when nothing first-class
// survived (import-only and the lost-forest refusal still sit on that empty path).
fn namespace_graft_is_declaration_target(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Arrow } => true
    TypeNode { connective: Conj } => true
    TypeNode { connective: Disj } => true
    _ =>
      fold(node.children, init: false, f: fn(found, e) {
        found || namespace_graft_is_declaration_target(node: e.target)
      })
  }
}

fn namespace_graft_keep_flattened_member_edge(edge: Edge) -> Bool {
  match edge.label {
    Named { name: sym } =>
      if namespace_graft_parse_projection_edge(name: sym) {
        false
      } else if namespace_graft_is_metadata_edge(name: sym) {
        false
      } else if namespace_graft_is_machinery_symbol(sym: sym) {
        false
      } else {
        namespace_graft_is_declaration_target(node: edge.target)
      }
    Positional => false
  }
}

fn namespace_graft_flattened_member_edges(edges: List<Edge>) -> List<Edge> {
  fold(edges, init: [], f: fn(acc, edge) {
    if namespace_graft_keep_flattened_member_edge(edge: edge) {
      list_snoc_item(xs: acc, item: edge)
    } else {
      acc
    }
  })
}

fn namespace_graft_body_edges_for_graft(root: Node) -> List<Edge> {
  let working = namespace_graft_unwrap_module_working_root(root: root)
  let units = namespace_graft_collect_unit_nodes(node: working)
  let from_decls = namespace_graft_decl_edges_from_node(node: working)
  let flattened = namespace_graft_flattened_member_edges(
    edges: namespace_graft_collect_body_edges_from_node(node: working)
  )
  let combined = concat(from_decls, flattened)
  if count(combined) == 0 {
    if count(units) == 0 {
      []
    } else {
      namespace_graft_reconstruct_declaration_forest(units: units)
    }
  } else {
    combined
  }
}

fn namespace_graft_is_graft_candidate(root: Node) -> Bool {
  if namespace_graft_already_grafted(root: root) {
    false
  } else if namespace_graft_is_module_shell(root: root) {
    true
  } else {
    namespace_graft_has_module_header(root: root)
  }
}

fn namespace_graft_collect_body_edges(root: Node) -> List<Edge> {
  namespace_graft_collect_body_edges_from_node(
    node: namespace_graft_unwrap_module_working_root(root: root)
  )
}

// The empty-observation narrow made unwritable (operator ruling msg_d18a55de): a
// collector that cannot express a module's declarations must not report "this module
// has none". Flattening parse-projection / transparent-sequence spines into a
// declaration's CHILDREN dropped type/data/import/fn shells (every child is itself
// a projection), so a module whose declarations contribute no function body looked
// identical to a LOST forest. Conj body edges must be uniquely Named (well_formed). Flattening
// already produces that shape for a nonempty forest, so a nonempty flatten is kept as-is.
// An empty flatten with surviving top-level-item alternatives reconstructs one Named forest
// (Cardinality of those units as Positional children, interiors kept). Empty flatten, no units,
// and a leftover dag_surface_top_level_item is a genuine loss and still refuses.
fn namespace_graft_subtree_contains_atom(n: Node, sym: Symbol) -> Bool {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == sym {
        true
      } else {
        namespace_graft_children_contain_atom(n: n, sym: sym)
      }
    _ => namespace_graft_children_contain_atom(n: n, sym: sym)
  }
}

fn namespace_graft_children_contain_atom(n: Node, sym: Symbol) -> Bool {
  fold(n.children, init: false, f: fn(found, e) {
    if found {
      true
    } else {
      namespace_graft_subtree_contains_atom(n: e.target, sym: sym)
    }
  })
}

fn namespace_graft_body_dissolved(root: Node, body_edges: List<Edge>) -> Bool {
  if count(body_edges) == 0 {
    namespace_graft_subtree_contains_atom(
      n: namespace_graft_unwrap_module_working_root(root: root),
      sym: ^dag_surface_top_level_item
    )
  } else {
    false
  }
}

fn namespace_graft_build_body_conj(edges: List<Edge>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: edges,
    occurrence_id: OccurrenceSynthetic
  }
}

fn namespace_graft_wrap_segment(segment: Symbol, inner: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: segment },
        target: inner
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn namespace_graft_fold_spine(qn: QualifiedName, body: Node) -> Node {
  fold_list_right(
    xs: qn,
    empty: body,
    snoc: fn(inner, segment) {
      namespace_graft_wrap_segment(segment: segment, inner: inner)
    }
  )
}

fn namespace_graft_atom_node(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn namespace_graft_wrap_module_shell(captured: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^grammar_production_identity_node_projection,
        target: namespace_graft_atom_node(id: ^dag_surface_module)
      ),
      dag_named_edge(
        name: ^grammar_production_captured_node_projection,
        target: captured
      )
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn namespace_graft_has_explicit_braced_container(root: Node, first_segment: Symbol) -> Bool {
  let working = namespace_graft_unwrap_module_working_root(root: root)
  fold(
    working.children,
    init: false,
    f: fn(found, edge) {
      if found {
        true
      } else {
        match edge.label {
          Named { name: sym } =>
            if namespace_graft_is_metadata_edge(name: sym) {
              false
            } else if sym == first_segment {
              match edge.target.kind {
                TypeNode { connective: Conj } => true
                _ => false
              }
            } else {
              false
            }
          Positional => false
        }
      }
    }
  )
}

fn namespace_graft_dual_position_refused(root: Node) -> Bool {
  if !namespace_graft_is_graft_candidate(root: root) {
    false
  } else {
    match qualified_name_from_module_node(root: root) {
      Rejected { diagnostics: _ } => false
      Accepted { value: qn, diagnostics: _ } =>
        match qn {
          Empty => false
          Cons { head: first, tail: _ } =>
            namespace_graft_has_explicit_braced_container(root: root, first_segment: first)
        }
    }
  }
}

fn module_header_containment_graft(root: Node) -> Outcome<Node> {
  if namespace_graft_already_grafted(root: root) {
    outcome_accepted(value: root)
  } else if namespace_graft_dual_position_refused(root: root) {
    outcome_rejected(Diagnostic {
      reason: ^namespace_graft_dual_position_refused,
      at: node_locus(node: root),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  } else if !namespace_graft_is_graft_candidate(root: root) {
    outcome_accepted(value: root)
  } else {
    match qualified_name_from_module_node(root: root) {
      Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
      Accepted { value: qn, diagnostics: _ } =>
        match qn {
          Empty =>
            outcome_rejected(Diagnostic {
              reason: ^qualified_name_structure_invalid,
              at: node_locus(node: root),
              correction: Unavailable { reason: ExternalContractUnknown }
            })
          Cons { head: _, tail: _ } => {
            let body_edges = namespace_graft_body_edges_for_graft(root: root)
            if namespace_graft_body_dissolved(root: root, body_edges: body_edges) {
              outcome_rejected(Diagnostic {
                reason: ^namespace_graft_body_dissolved_refused,
                at: node_locus(node: root),
                correction: Unavailable { reason: ExternalContractUnknown }
              })
            } else {
              let body = namespace_graft_build_body_conj(edges: body_edges)
              let spine = namespace_graft_fold_spine(qn: qn, body: body)
              outcome_accepted(value: namespace_graft_wrap_module_shell(captured: spine))
            }
          }
        }
    }
  }
}

fn namespace_graft_strip_provenance_marker(root: Node) -> Node {
  namespace_graft_unwrap_module_working_root(root: root)
}
