type ImportVisibility
  = ImportVisible
  | ImportHidden

type Import {
  target: QualifiedName
  visibility: ImportVisibility
}

type ResolutionSubject {
  name: QualifiedName
}

type Admission {
  subject: ResolutionSubject
  imports: FreeMonoid<Import>
}

// Shared by every subject admitted against the same language and root collection.
// The Outcome stays with the caller so validation diagnostics retain their original
// per-subject refusal boundary when the context is constructed before admission.
// `test_code` is every root's test-marker channel keyed by the paths resolution binds to, built in
// the same pass that names the roots, so no root can be resolvable while its markers are unread.
type ValidatedModuleRoots {
  roots: FreeMonoid<NormalizedTree>
  by_name: Map<QualifiedName, NormalizedTree>
  test_code: TestCodeIndex
}

// ONE PER INGEST (gunbc#11401 R1), AND THE HOME OF WHAT THAT INGEST'S RESOLUTION PRODUCES ONCE.
// The fields above `namespaces` are fixed when the context is built: the language, the validated roots,
// the corpus index, and the three admission inputs every subject of this ingest is admitted under
// (the source-root index, the active roots, the name-resolution policy). Binding them here is what makes
// a module's QualifiedName a COMPLETE key for its namespace: nothing a namespace depends on varies per
// demand except the admission's imports, and those are stored beside the value and compared.
//
// `namespaces` IS THE MODULE NAMESPACE PROVIDER (docs/plans/declaration-body-resolution-provider.md,
// P1). A module's admitted namespace is produced AT MOST ONCE PER INGEST, on first demand, by
// resolution_context_namespace -- the only caller of the builder namespace_for_subject_root -- and
// every later demand reads the stored value. Until this cut every resolve rebuilt its subject's
// namespace from scratch and carried it nowhere, so no second consumer could read the one the first
// built. A pure substrate has no mutable cache, so the provider is THREADED: every resolve returns the
// context it ended with (ContextResolved, ContextWalk), and a caller holding one context across
// subjects binds the returned one. A caller that drops it does not get a stale answer -- it pays the
// build again -- and `namespaces_built` is what makes that countable: it increments on every miss, so
// a context that resolved N distinct subjects and reports more than N builds rebuilt one
// (v2.test.name_resolve.admission_fail_closed
// namespace_provider_builds_each_module_at_most_once_per_context).
//
// `declaration_bodies` IS THE DECLARATION-BODY PROVIDER (the same plan, P2), threaded the same way:
// a module's declarations with every type position resolved in its own namespace, produced AT MOST
// ONCE PER INGEST by resolution_context_declaration_bodies on first demand -- from the module's own
// resolve, or from another module's resolve that reaches one of its declarations -- and
// `declaration_bodies_built` counts the misses exactly as `namespaces_built` does.
//
// SCOPE: the modules this ingest read. A demand for a module outside `roots` refuses at the provider
// (resolve_module_not_found, located at the requested name), is recorded like any other outcome, and
// is never rebuilt from anywhere else.
type ResolutionContext {
  lm: LanguageModel
  roots: ValidatedModuleRoots
  symbol_index: SymbolIndex
  index: SourceRootIndex
  active_roots: FreeMonoid<SourceRootRef>
  policy: NameResolutionPolicy
  namespaces: Map<QualifiedName, NamespaceProviderEntry>
  namespaces_built: Int
  declaration_bodies: Map<QualifiedName, Outcome<DeclarationBodies>>
  declaration_bodies_built: Int
}

// One stored production: the admission it was produced under, and its outcome -- a refusal is
// produced once too, so a subject whose admission refused is not re-admitted by a second demand.
type NamespaceProviderEntry {
  admission: Admission
  admitted: Outcome<AdmittedSubject>
}

fn resolution_context(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy
) -> Outcome<ResolutionContext> {
  match validate_module_roots(roots: roots) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: validated_roots, diagnostics: d } =>
      Accepted {
        value: resolution_context_of_validated(
          lm: lm,
          roots: validated_roots,
          symbol_index: symbol_index_fill_module_roots(
            index: empty_symbol_index(),
            roots: normalized_tree_roots_to_binding_sources(roots: validated_roots.roots)
          ),
          index: index,
          active_roots: active_roots,
          policy: policy
        ),
        diagnostics: d
      }
  }
}

// The context over roots a caller has already validated and indexed, with an empty provider.
fn resolution_context_of_validated(
  lm: LanguageModel,
  roots: ValidatedModuleRoots,
  symbol_index: SymbolIndex,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy
) -> ResolutionContext {
  ResolutionContext {
    lm: lm,
    roots: roots,
    symbol_index: symbol_index,
    index: index,
    active_roots: active_roots,
    policy: policy,
    namespaces: empty_map(),
    namespaces_built: 0,
    declaration_bodies: empty_map(),
    declaration_bodies_built: 0
  }
}

type AdmittedSubject {
  namespace: Namespace
  subject_root: NormalizedTree
}

type AdmissionState
  = AdmissionAccepted {
      bindings: Map<Symbol, Symbol>,
      origins: Map<Symbol, QualifiedName>
    }
  | AdmissionRejected { diagnostics: NonEmptyDiagnostics }

type ModuleRootValidateState
  = ModuleRootsValid { seen: Map<QualifiedName, NormalizedTree>, test_code: TestCodeIndex, diagnostics: Diagnostics }
  | ModuleRootsDuplicate { diagnostics: Diagnostics }
  | ModuleRootsProjectionRejected { diagnostics: NonEmptyDiagnostics }

fn resolve_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: invariant_port_locus(port: ^resolve_diagnostic_port, invariant: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn resolve_diagnostics(reason: Symbol) -> NonEmptyDiagnostics {
  diagnostics_singleton(d: resolve_diagnostic(reason: reason))
}

// module_root_find refuses with the exact QualifiedName sought — rendered as a dotted string on the Textual diagnostic file locus (§3: structural QN is identity; dotted form is projection for display). ModuleRootLookup is the structural authority; diagnostics project from ModuleRootMissing rather than parsing display text back.
type ModuleRootLookup
  = ModuleRootFound { root: NormalizedTree }
  | ModuleRootMissing { requested: QualifiedName }
  | ModuleRootAmbiguous { requested: QualifiedName }
  | ModuleRootLookupRejected { diagnostics: NonEmptyDiagnostics }

fn resolve_module_not_found_diagnostic_from_missing(
  requested: QualifiedName
) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: textual_whole_file_diagnostic(
      reason: ^resolve_module_not_found,
      module_file: symbol_intern_lexeme(
        lexeme: qualified_name_to_dotted_string(qn: requested)
      ),
      correction: Unavailable { reason: ExternalContractUnknown }
    )
  )
}

fn resolve_module_not_found_diagnostic(name: QualifiedName) -> NonEmptyDiagnostics {
  resolve_module_not_found_diagnostic_from_missing(requested: name)
}

fn admission_initial(base: Namespace) -> AdmissionState {
  AdmissionAccepted {
    bindings: base.bindings,
    origins: empty_map()
  }
}

fn admit_export_symbol(
  sym: Symbol,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: b, origins: os } =>

      match v2.std.collection.map_get(os, sym) {
        Accepted { value: opt, diagnostics: _ } => match opt {
          Present { value: _ } =>
            AdmissionRejected {
              diagnostics: resolve_diagnostics(reason: ^resolve_ambiguous_export)
            }
          Absent =>
            AdmissionAccepted {
              bindings: map_insert(m: b, key: sym, value: sym),
              origins: map_insert(m: os, key: sym, value: origin)
            }
        }
        Rejected { diagnostics: d } => AdmissionRejected { diagnostics: d }
      }
  }
}

fn validate_module_roots(roots: FreeMonoid<NormalizedTree>) -> Outcome<ValidatedModuleRoots> {
  match fold_list(
    xs: roots,
    empty: ModuleRootsValid { seen: empty_map(), test_code: test_code_index_empty(), diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, root) {
      match acc {
        ModuleRootsDuplicate { diagnostics: d } =>
          ModuleRootsDuplicate { diagnostics: d }
        ModuleRootsProjectionRejected { diagnostics: d } =>
          ModuleRootsProjectionRejected { diagnostics: d }
        ModuleRootsValid { seen: prior, test_code: prior_test_code, diagnostics: acc_diag } =>
          if well_formed(n: root.root) {
            match qualified_name_from_module_node(root: root.root) {
              Rejected { diagnostics: d } =>
                ModuleRootsProjectionRejected {
                  diagnostics: rejected_with_pending(pending: acc_diag, rejected: d)
                }
              Accepted { value: name, diagnostics: proj_diag } =>
                let merged_diag = diagnostics_merge(outer: acc_diag, inner: proj_diag)
                match map_lookup(m: prior, key: name) {
                  Absent =>
                    ModuleRootsValid {
                      seen: map_insert(m: prior, key: name, value: root),
                      test_code: test_code_index_add_module(
                        index: prior_test_code,
                        module_qn: name,
                        channel: root.test_markers
                      ),
                      diagnostics: merged_diag
                    }
                  Present { value: _ } =>
                    ModuleRootsDuplicate { diagnostics: merged_diag }
                }
            }
          } else {
            ModuleRootsProjectionRejected {
              diagnostics: rejected_with_pending(
                pending: acc_diag,
                rejected: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
              )
            }
          }
      }
    }
  ) {
    ModuleRootsValid { seen: by_name, test_code: test_code, diagnostics: d } =>
      Accepted { value: ValidatedModuleRoots { roots: roots, by_name: by_name, test_code: test_code }, diagnostics: d }
    ModuleRootsDuplicate { diagnostics: d } =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: d,
          rejected: resolve_diagnostics(reason: ^resolve_duplicate_module_name)
        )
      }
    ModuleRootsProjectionRejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

// Typed lookup result beside module_root_find diagnostics. ModuleRootMissing and
// ModuleRootAmbiguous preserve the exact QualifiedName sought; diagnostics are projections of these
// results for consumers that still read the Outcome directly.

fn module_root_lookup(
  roots: FreeMonoid<NormalizedTree>,
  name: QualifiedName
) -> ModuleRootLookup {
  match fold_list(
    xs: roots,
    empty: Accepted { value: NoPassingCandidate, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, root) {
      match acc {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: fold_state, diagnostics: _ } =>
          match fold_state {
            ManyPassingCandidates =>
              Accepted { value: ManyPassingCandidates, diagnostics: v2.std.diagnostic.None }
            _ =>
              match qualified_name_from_module_node(root: root.root) {
                Rejected { diagnostics: d } =>
                  Rejected { diagnostics: d }
                Accepted { value: candidate, diagnostics: _ } =>
                  Accepted {
                    value: match candidate == name {
                      true =>
                        match fold_state {
                          NoPassingCandidate => OnePassingCandidate { candidate: root }
                          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
                          ManyPassingCandidates => ManyPassingCandidates
                        }
                      false => fold_state
                    },
                    diagnostics: v2.std.diagnostic.None
                  }
              }
          }
      }
    }
  ) {
    Rejected { diagnostics: d } =>
      ModuleRootLookupRejected { diagnostics: d }
    Accepted { value: fold_state, diagnostics: _ } =>
      match fold_state {
        NoPassingCandidate =>
          ModuleRootMissing { requested: name }
        OnePassingCandidate { candidate: root } =>
          ModuleRootFound { root: root }
        ManyPassingCandidates =>
          ModuleRootAmbiguous { requested: name }
      }
  }
}

fn module_root_find(
  roots: FreeMonoid<NormalizedTree>,
  name: QualifiedName
) -> Outcome<NormalizedTree> {
  match module_root_lookup(roots: roots, name: name) {
    ModuleRootFound { root: root } =>
      Accepted { value: root, diagnostics: v2.std.diagnostic.None }
    ModuleRootMissing { requested: requested } =>
      Rejected {
        diagnostics: resolve_module_not_found_diagnostic_from_missing(
          requested: requested
        )
      }
    ModuleRootAmbiguous { requested: _ } =>
      Rejected { diagnostics: resolve_diagnostics(reason: ^resolve_duplicate_module_name) }
    ModuleRootLookupRejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

// Parse-projection edges (identity / captured projections, sequence spines) are
// machinery, not exports -- the same rule symbol_index_fill_containment_edge
// applies. The body's identity projection reaches this fold as a direct child.
fn try_admitted_export_binding(e: Edge) -> DeclaredBinding? {
  match try_edge_declared_binding(e: e) {
    Present { value: b } =>
      if dag_surface_module_header_metadata_edge(name: b.name) {
        optional_absent()
      } else if parse_tree_projection_edge(name: b.name) {
        optional_absent()
      } else {
        optional_present(value: b)
      }
    Absent => optional_absent()
  }
}

type AdmitExportsFold {
  origin: QualifiedName
  state: AdmissionState
  at_conj: Bool
}

fn admit_named_export_edge(
  edge: Edge,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match try_admitted_export_binding(e: edge) {
    Present { value: b } =>
      admit_export_symbol(sym: b.name, origin: origin, state: state)
    Absent => state
  }
}

fn named_exports_topdown_algebra() -> NodeFoldTopDown<AdmitExportsFold, AdmitExportsFold> {
  NodeFoldTopDown {
    init: fn(n, fold) {
      AdmitExportsFold {
        origin: fold.origin,
        state: fold.state,
        at_conj: match n.kind {
          TypeNode { connective: Conj } => true
          _ => false
        }
      }
    },
    child_context: fn(n, fold, e) { fold },
    step: fn(acc, e, child_r) {
      if acc.at_conj {
        AdmitExportsFold {
          origin: acc.origin,
          state: admit_named_export_edge(
            edge: e,
            origin: acc.origin,
            state: acc.state
          ),
          at_conj: true
        }
      } else {
        child_r
      }
    }
  }
}

fn admit_named_exports(
  root: Node,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  let working = namespace_graft_module_body_root(root: root)
  match working.kind {
    TypeNode { connective: Conj } =>
      match fold_node_topdown(
        n: working,
        ctx: AdmitExportsFold {
          origin: origin,
          state: state,
          at_conj: false
        },
        algebra: named_exports_topdown_algebra()
      ) {
        AdmitExportsFold { state: folded_state, origin: _, at_conj: _ } =>
          folded_state
      }
    _ => state
  }
}

fn admit_import_root_find(
  found: Outcome<NormalizedTree>,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match found {
    Rejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    Accepted { value: imported_root, diagnostics: _ } =>
      if well_formed(n: imported_root.root) {
        admit_named_exports(
          root: imported_root.root,
          origin: origin,
          state: state
        )
      } else {
        AdmissionRejected {
          diagnostics: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
        }
      }
  }
}

fn admit_import_visible_entry(
  roots: FreeMonoid<NormalizedTree>,
  import_edge: Import,
  state: AdmissionState
) -> AdmissionState {
  admit_import_root_find(
    found: module_root_find(
      roots: roots,
      name: import_edge.target
    ),
    origin: import_edge.target,
    state: state
  )
}

fn admit_import_entry(
  roots: FreeMonoid<NormalizedTree>,
  import_edge: Import,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: _, origins: _ } =>
      match import_edge.visibility {
        ImportHidden =>
          AdmissionRejected {
            diagnostics: resolve_diagnostics(reason: ^resolve_import_not_visible)
          }
        ImportVisible =>
          match v2.std.cross_tree.resolution.cross_tree_edge_decision(
            index: index,
            from_qn: subject_qn,
            to_qn: import_edge.target,
            active_roots: active_roots
          ) {
            EdgeNormalResolution =>
              admit_import_visible_entry(roots: roots, import_edge: import_edge, state: state)
            EdgeCrossAdmitted =>
              admit_import_visible_entry(roots: roots, import_edge: import_edge, state: state)
            EdgeCrossDenied =>
              AdmissionRejected {
                diagnostics: resolve_diagnostics(reason: ^resolve_cross_tree_import_denied)
              }
            EdgeCrossAmbiguous =>
              AdmissionRejected {
                diagnostics: resolve_diagnostics(reason: ^resolve_cross_tree_import_ambiguous)
              }
          }
      }
  }
}

fn admit_imports(
  roots: FreeMonoid<NormalizedTree>,
  imports: FreeMonoid<Import>,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  fold_list(
    xs: imports,
    empty: state,
    cons: fn(acc, import_edge) {
      admit_import_entry(
        roots: roots,
        import_edge: import_edge,
        state: acc,
        subject_qn: subject_qn,
        index: index,
        active_roots: active_roots
      )
    }
  )
}

fn admission_namespace_base(canonical_symbols: PointwisePower<Symbol>) -> Namespace {
  Namespace {
    bindings: empty_map(),
    canonical_symbols: canonical_symbols,
    symbol_index: empty_symbol_index(),
    module_qn: Empty,
    test_code: test_code_index_empty(),
    declared_in: Empty,
    imported_origins: empty_map()
  }
}

// The shared context consumes only the map emitted by successful validation. General
// module_root_lookup still diagnoses ambiguity and projection errors before validation.
fn subject_module_root_for_name(
  roots: ValidatedModuleRoots,
  name: QualifiedName
) -> Outcome<NormalizedTree> {
  match map_lookup(m: roots.by_name, key: name) {
    Present { value: root } => Accepted { value: root, diagnostics: v2.std.diagnostic.None }
    Absent => Rejected { diagnostics: resolve_module_not_found_diagnostic_from_missing(requested: name) }
  }
}

fn namespace_admission_initial_state(
  policy: NameResolutionPolicy,
  canonical_symbols: PointwisePower<Symbol>,
  subject_module_root: NormalizedTree,
  subject_qn: QualifiedName
) -> AdmissionState {
  let base = admission_namespace_base(canonical_symbols: canonical_symbols)
  match policy {
    NamespaceOnlyY =>
      admission_initial(base: base)
    ImportScoped =>
      admit_named_exports(
        root: subject_module_root.root,
        origin: subject_qn,
        state: admission_initial(base: base)
      )
  }
}

fn admitted_subject_from_bindings(
  bindings: Map<Symbol, Symbol>,
  base: Namespace,
  subject_module_root: NormalizedTree,
  symbol_index: SymbolIndex,
  module_qn: QualifiedName,
  origins: Map<Symbol, QualifiedName>,
  test_code: TestCodeIndex
) -> AdmittedSubject {
  AdmittedSubject {
    namespace: Namespace {
      bindings: namespace_bindings_augment_from_module_atoms(
        root: subject_module_root.root,
        bindings: bindings
      ),
      canonical_symbols: base.canonical_symbols,
      symbol_index: symbol_index,
      module_qn: module_qn,
      test_code: test_code,
      declared_in: module_qn,
      imported_origins: origins
    },
    subject_root: subject_module_root
  }
}

// THE NAMESPACE PROVIDER'S ONE DOOR: the stored namespace of the admission's subject, or -- on the
// first demand in this ingest -- the one namespace_for_subject_root produces, stored before it is
// returned. A demand whose imports differ from the stored admission's REFUSES rather than being
// served a namespace produced from different inputs, and rather than overwriting the stored one
// (resolve_reason_namespace_provider_admission_conflict, located at the subject's name).
type NamespaceDemand {
  admitted: Outcome<AdmittedSubject>
  context: ResolutionContext
}

fn resolution_context_namespace(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  admission: Admission
) -> NamespaceDemand {
  match map_lookup(m: shared.namespaces, key: admission.subject.name) {
    Present { value: entry } =>
      if entry.admission == admission {
        NamespaceDemand { admitted: entry.admitted, context: shared }
      } else {
        NamespaceDemand {
          admitted: Rejected { diagnostics: namespace_provider_admission_conflict_diagnostic(name: admission.subject.name) },
          context: shared
        }
      }
    Absent =>
      let admitted = namespace_for_subject_produced(shared: shared, validate_diag: validate_diag, admission: admission)
      NamespaceDemand {
        admitted: admitted,
        context: ResolutionContext {
          lm: shared.lm,
          roots: shared.roots,
          symbol_index: shared.symbol_index,
          index: shared.index,
          active_roots: shared.active_roots,
          policy: shared.policy,
          namespaces: map_insert(
            m: shared.namespaces,
            key: admission.subject.name,
            value: NamespaceProviderEntry { admission: admission, admitted: admitted }
          ),
          namespaces_built: shared.namespaces_built + 1,
          declaration_bodies: shared.declaration_bodies,
          declaration_bodies_built: shared.declaration_bodies_built
        }
      }
  }
}

fn namespace_provider_admission_conflict_diagnostic(name: QualifiedName) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: textual_whole_file_diagnostic(
      reason: ^resolve_reason_namespace_provider_admission_conflict,
      module_file: symbol_intern_lexeme(lexeme: qualified_name_to_dotted_string(qn: name)),
      correction: Unavailable { reason: ExternalContractUnknown }
    )
  )
}

// ONE MODULE'S DECLARATIONS WITH EVERY TYPE POSITION RESOLVED IN ITS OWN NAMESPACE: the root the
// provider's DeclarationTypesOnly walk produced (its value bodies carried unwalked, so every
// declaration reference in it sits in a type position), the top-level declarations cut from it by
// declaring path (the module's own resolve grafts these), and the index readers ask by full path.
// All three are read off ONE walk; none is resolved again.
type DeclarationBodies {
  root: Node
  declarations: Map<QualifiedName, Node>
  index: SymbolIndex
}

type DeclarationBodiesDemand {
  bodies: Outcome<DeclarationBodies>
  context: ResolutionContext
}

// The admission a module is resolved under in this ingest: the one its namespace is stored with, or
// -- before any demand -- the import-free admission every production driver admits a member with
// (v2.compiler.compile native_test_module_admission; a member's imports are read off its own root).
// So a module first reached through another module's declaration is admitted exactly as its own
// resolve will admit it, and its namespace is not produced twice under two admissions.
fn resolution_context_module_admission(shared: ResolutionContext, module: QualifiedName) -> Admission {
  match map_lookup(m: shared.namespaces, key: module) {
    Present { value: entry } => entry.admission
    Absent => Admission { subject: ResolutionSubject { name: module }, imports: Empty }
  }
}

// THE DECLARATION-BODY PROVIDER'S ONE DOOR. Stored, or produced once on the first demand and stored
// before it is returned. A refusal is stored too, so a module whose declarations refused is not
// re-walked by the next demand. A module outside the ingest refuses at P1 (resolve_module_not_found,
// located at its name) and that refusal is what is stored.
fn resolution_context_declaration_bodies(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  module: QualifiedName
) -> DeclarationBodiesDemand {
  match map_lookup(m: shared.declaration_bodies, key: module) {
    Present { value: stored } => DeclarationBodiesDemand { bodies: stored, context: shared }
    Absent =>
      let demand = resolution_context_namespace(
        shared: shared,
        validate_diag: validate_diag,
        admission: resolution_context_module_admission(shared: shared, module: module)
      )
      let produced = declaration_bodies_produced(context: demand.context, admitted: demand.admitted, module: module)
      DeclarationBodiesDemand {
        bodies: produced,
        context: resolution_context_with_declaration_bodies(shared: demand.context, module: module, bodies: produced)
      }
  }
}

fn resolution_context_with_declaration_bodies(
  shared: ResolutionContext,
  module: QualifiedName,
  bodies: Outcome<DeclarationBodies>
) -> ResolutionContext {
  ResolutionContext {
    lm: shared.lm,
    roots: shared.roots,
    symbol_index: shared.symbol_index,
    index: shared.index,
    active_roots: shared.active_roots,
    policy: shared.policy,
    namespaces: shared.namespaces,
    namespaces_built: shared.namespaces_built,
    declaration_bodies: map_insert(m: shared.declaration_bodies, key: module, value: bodies),
    declaration_bodies_built: shared.declaration_bodies_built + 1
  }
}

// The provider's miss arm: ONE WALK of the module in its own namespace, selecting declaration types.
fn declaration_bodies_produced(
  context: ResolutionContext,
  admitted: Outcome<AdmittedSubject>,
  module: QualifiedName
) -> Outcome<DeclarationBodies> {
  match admitted {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: a, diagnostics: namespace_diag } =>
      match resolve_walk_outcome(w: resolve_walk_prefix_pending(
        pending: namespace_diag,
        w: resolve_walk_selected(
          tree: a.subject_root,
          namespace: a.namespace,
          lm: context.lm,
          policy: context.policy,
          selection: DeclarationTypesOnly,
          provided: empty_map()
        )
      )) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: root, diagnostics: d } =>
          Accepted {
            value: DeclarationBodies {
              root: root,
              declarations: resolve_declaration_targets(root: root, module_qn: module),
              index: resolved_declaration_index_of(root: root)
            },
            diagnostics: d
          }
      }
  }
}

// THE SNAPSHOT A RESOLVED MODULE CARRIES TO INFER: every module its resolved root reaches through a
// declaration reference, and every module THOSE modules' resolved declarations reach, to a fixpoint
// -- each one's provided index, never re-resolved. A reference whose declaring path no ingested
// module owns refuses, located at the reference (resolve_reason_declaration_outside_ingest); a module
// whose declarations refused refuses the snapshot with its own diagnostics. Nothing widens.
type DeclarationClosureDemand {
  snapshot: Outcome<ResolvedDeclarations>
  context: ResolutionContext
}

type DeclarationOwners
  = DeclarationOwnersRead { modules: FreeMonoid<QualifiedName>, seen: Map<QualifiedName, Bool> }
  | DeclarationOwnerOutsideIngest { at: Node }

fn declaration_closure(shared: ResolutionContext, validate_diag: Diagnostics, root: Node) -> DeclarationClosureDemand {
  match declaration_owners(by_name: shared.roots.by_name, n: root, acc: DeclarationOwnersRead { modules: Empty, seen: empty_map() }) {
    DeclarationOwnerOutsideIngest { at: at } =>
      DeclarationClosureDemand { snapshot: Rejected { diagnostics: declaration_outside_ingest_diagnostic(at: at) }, context: shared }
    DeclarationOwnersRead { modules: modules, seen: _ } =>
      declaration_closure_walk(shared: shared, validate_diag: validate_diag, queue: modules, snapshot: resolved_declarations_empty())
  }
}

// Terminates: a module is demanded only while the snapshot lacks it and is added once demanded, every
// queued module is the owner of a path in a finite ingest, and each step consumes one queue entry.
fn declaration_closure_walk(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  queue: FreeMonoid<QualifiedName>,
  snapshot: ResolvedDeclarations
) -> DeclarationClosureDemand {
  match queue {
    Empty => DeclarationClosureDemand { snapshot: Accepted { value: snapshot, diagnostics: None }, context: shared }
    Cons { head: module, tail: rest } =>
      if resolved_declarations_has_module(d: snapshot, module: module) {
        declaration_closure_walk(shared: shared, validate_diag: validate_diag, queue: rest, snapshot: snapshot)
      } else {
        let demand = resolution_context_declaration_bodies(shared: shared, validate_diag: validate_diag, module: module)
        match demand.bodies {
          Rejected { diagnostics: r } => DeclarationClosureDemand { snapshot: Rejected { diagnostics: r }, context: demand.context }
          Accepted { value: bodies, diagnostics: _ } =>
            match declaration_owners(by_name: shared.roots.by_name, n: bodies.root, acc: DeclarationOwnersRead { modules: Empty, seen: empty_map() }) {
              DeclarationOwnerOutsideIngest { at: at } =>
                DeclarationClosureDemand { snapshot: Rejected { diagnostics: declaration_outside_ingest_diagnostic(at: at) }, context: demand.context }
              DeclarationOwnersRead { modules: reached, seen: _ } =>
                declaration_closure_walk(
                  shared: demand.context,
                  validate_diag: validate_diag,
                  queue: list_append(left: rest, right: reached),
                  snapshot: resolved_declarations_with_module(d: snapshot, module: module, index: bodies.index)
                )
            }
        }
      }
  }
}

// The owning modules of every declaration reference under `n`, each once, in walk order. A reference
// is read whole and not descended into (its spine's tails are spine-shaped too); a parameter
// reference names a binder of its own declaration and pulls no module.
fn declaration_owners(by_name: Map<QualifiedName, NormalizedTree>, n: Node, acc: DeclarationOwners) -> DeclarationOwners {
  match acc {
    DeclarationOwnerOutsideIngest { at: _ } => acc
    DeclarationOwnersRead { modules: modules, seen: seen } =>
      match declaration_reference_path_optional(node: n) {
        Present { value: path } =>
          match qualified_name_longest_keyed_prefix(keys: by_name, path: path) {
            Absent => DeclarationOwnerOutsideIngest { at: n }
            Present { value: owner } =>
              match map_lookup(m: seen, key: owner) {
                Present { value: _ } => acc
                Absent => DeclarationOwnersRead { modules: list_snoc_item(xs: modules, item: owner), seen: map_insert(m: seen, key: owner, value: true) }
              }
          }
        Absent =>
          match parameter_reference_path_optional(node: n) {
            Present { value: _ } => acc
            Absent =>
              fold(n.children, init: acc, f: fn(a, e) {
                declaration_owners(by_name: by_name, n: e.target, acc: a)
              })
          }
      }
  }
}

fn declaration_outside_ingest_diagnostic(at: Node) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: Diagnostic {
      reason: ^resolve_reason_declaration_outside_ingest,
      at: node_locus(node: at),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}

// The provider's miss arm and nothing else: the subject's root, located, then its admission.
fn namespace_for_subject_produced(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  admission: Admission
) -> Outcome<AdmittedSubject> {
  match subject_module_root_for_name(roots: shared.roots, name: admission.subject.name) {
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: rejected_with_pending(pending: validate_diag, rejected: r) }
    Accepted { value: subject_module_root, diagnostics: _ } =>
      namespace_for_subject_root(
        shared: shared,
        validate_diag: validate_diag,
        subject_module_root: subject_module_root,
        admission: admission,
        index: shared.index,
        active_roots: shared.active_roots,
        policy: shared.policy
      )
  }
}

// Subject-local namespace work is observed separately from root lookup and traversal.
fn namespace_for_subject_root(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  subject_module_root: NormalizedTree,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy
) -> Outcome<AdmittedSubject> {
  let validated_roots = shared.roots
  if well_formed(n: subject_module_root.root) {
    let base = admission_namespace_base(canonical_symbols: shared.lm.canonical_symbols)
    let initial = namespace_admission_initial_state(
      policy: policy,
      canonical_symbols: shared.lm.canonical_symbols,
      subject_module_root: subject_module_root,
      subject_qn: admission.subject.name
    )
    match policy {
      NamespaceOnlyY =>
        match initial {
          AdmissionRejected { diagnostics: d } =>
            Rejected {
              diagnostics: rejected_with_pending(pending: validate_diag, rejected: d)
            }
          AdmissionAccepted { bindings: b, origins: o } =>
            Accepted {
              value: admitted_subject_from_bindings(
                bindings: b,
                base: base,
                subject_module_root: subject_module_root,
                symbol_index: shared.symbol_index,
                module_qn: admission.subject.name,
                origins: o,
                test_code: shared.roots.test_code
              ),
              diagnostics: validate_diag
            }
        }
      ImportScoped =>
        match admit_imports(
          roots: validated_roots.roots,
          imports: admission.imports,
          state: initial,
          subject_qn: admission.subject.name,
          index: index,
          active_roots: active_roots
        ) {
          AdmissionAccepted { bindings: b, origins: o } =>
            Accepted {
              value: admitted_subject_from_bindings(
                bindings: b,
                base: base,
                subject_module_root: subject_module_root,
                symbol_index: shared.symbol_index,
                module_qn: admission.subject.name,
                origins: o,
                test_code: shared.roots.test_code
              ),
              diagnostics: validate_diag
            }
          AdmissionRejected { diagnostics: d } =>
            Rejected {
              diagnostics: rejected_with_pending(pending: validate_diag, rejected: d)
            }
        }
    }
  } else {
    Rejected {
      diagnostics: rejected_with_pending(
        pending: validate_diag,
        rejected: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
      )
    }
  }
}

// ONE SUBJECT IN A FRESH CONTEXT: the context is built here and dropped here, so its provider serves
// exactly this resolution. A caller resolving more than one subject over one ingest holds a context
// and goes through resolve_in_context instead.
fn resolve_with_admission_policy(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy
) -> Outcome<ResolvedTree> {
  resolve_in_context(
    context: resolution_context(lm: lm, roots: roots, index: index, active_roots: active_roots, policy: policy),
    admission: admission
  ).resolved
}

// A resolution over a held context, and the context it ends with.
type ContextResolved {
  resolved: Outcome<ResolvedTree>
  context: Outcome<ResolutionContext>
}

type ContextWalk {
  walk: ResolveNodeWalk
  context: Outcome<ResolutionContext>
}

// The admitted namespace is built over the context's own index, so that index is the one this
// resolution consulted. An accepted walk's tree carries the declaration snapshot
// (declaration_closure); a refused context resolved nothing.
fn resolve_in_context(context: Outcome<ResolutionContext>, admission: Admission) -> ContextResolved {
  let walked = resolve_walk_in_context(context: context, admission: admission)
  match walked.context {
    Rejected { diagnostics: r } => ContextResolved { resolved: Rejected { diagnostics: r }, context: walked.context }
    Accepted { value: shared, diagnostics: validate_diag } =>
      match walked.walk {
        ResolveWalkRefused { first: f, rest: _, observation: _ } =>
          ContextResolved { resolved: Rejected { diagnostics: f }, context: walked.context }
        ResolveWalkAccepted { value: root, diagnostics: d } =>
          resolved_tree_in_context(shared: shared, validate_diag: validate_diag, root: root, diagnostics: d)
      }
  }
}

// AN ACCEPTED WALK'S ROOT AS THE STAGE'S OUTPUT: the tree with its declaration snapshot, and the
// context the snapshot's demands ended with. Every route that resolves over a held context ends here,
// so no resolved tree leaves a context without the declarations it reaches.
fn resolved_tree_in_context(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  root: Node,
  diagnostics: Diagnostics
) -> ContextResolved {
  let closure = declaration_closure(shared: shared, validate_diag: validate_diag, root: root)
  ContextResolved {
    resolved: match closure.snapshot {
      Rejected { diagnostics: r } => Rejected { diagnostics: rejected_with_pending(pending: diagnostics, rejected: r) }
      Accepted { value: snapshot, diagnostics: _ } =>
        Accepted { value: ResolvedTree { root: root, symbol_index: shared.symbol_index, declarations: snapshot }, diagnostics: diagnostics }
    },
    context: Accepted { value: closure.context, diagnostics: validate_diag }
  }
}

// THE SUBJECT'S WHOLE RESOLUTION OBSERVATION, every independent failure chain in walk order.
// resolve_in_context is its projection. A context or namespace refusal means the walk was never
// entered, so none of the subject's sites were observed: that is recorded as ObservationIncomplete,
// never as a complete observation holding one refusal.
//
// THE SUBJECT GRAFTS ITS OWN PROVIDED DECLARATIONS. Before walking, it demands its own declaration
// bodies from the provider and walks with them as the graft (v2.compiler.resolve WalkSelection), so
// its declarations' type positions are the provider's values, resolved once. If its own declarations
// refused, the graft is empty and the walk observes those same refusals at their own sites -- the
// same positions resolved the same way -- so the population stays the subject's whole observation.
fn resolve_walk_in_context(context: Outcome<ResolutionContext>, admission: Admission) -> ContextWalk {
  match context {
    Rejected { diagnostics: r } =>
      ContextWalk {
        walk: ResolveWalkRefused {
          first: r,
          rest: [],
          observation: ObservationIncomplete { reason: ^resolve_observation_context_refused }
        },
        context: context
      }
    Accepted { value: shared, diagnostics: validate_diag } =>
      let demand = resolution_context_namespace(shared: shared, validate_diag: validate_diag, admission: admission)
      match demand.admitted {
        Accepted { value: admitted, diagnostics: namespace_diag } =>
          let own = resolution_context_declaration_bodies(shared: demand.context, validate_diag: validate_diag, module: admission.subject.name)
          ContextWalk {
            walk: resolve_walk_prefix_pending(
              pending: namespace_diag,
              w: resolve_walk_selected(
                tree: admitted.subject_root,
                namespace: admitted.namespace,
                lm: shared.lm,
                policy: shared.policy,
                selection: WholeModule,
                provided: match own.bodies {
                  Accepted { value: bodies, diagnostics: _ } => bodies.declarations
                  Rejected { diagnostics: _ } => empty_map()
                }
              )
            ),
            context: Accepted { value: own.context, diagnostics: validate_diag }
          }
        Rejected { diagnostics: r } =>
          ContextWalk {
            walk: ResolveWalkRefused {
              first: r,
              rest: [],
              observation: ObservationIncomplete { reason: ^resolve_observation_namespace_refused }
            },
            context: Accepted { value: demand.context, diagnostics: validate_diag }
          }
      }
  }
}

fn resolve_with_admission(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  admission: Admission
) -> Outcome<ResolvedTree> {
  resolve_with_admission_policy(
    lm: lm,
    roots: roots,
    admission: admission,
    index: v2.std.cross_tree.resolution.source_root_index_empty(),
    active_roots: Empty,
    policy: default_name_resolution_policy()
  )
}

fn resolve_with_admission_grounded(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> Outcome<ResolvedTree> {
  resolve_with_admission_policy(
    lm: lm,
    roots: roots,
    admission: admission,
    index: index,
    active_roots: active_roots,
    policy: default_name_resolution_policy()
  )
}
