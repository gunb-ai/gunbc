module v2.compiler.name_resolve
import v2.std.language_model { LanguageModel }

import v2.compiler.normalize { NormalizedTree }
import v2.compiler.resolve {
  DeclaredBinding,
  Namespace,
  ResolvedTree,
  resolve_with_namespace,
  try_edge_declared_binding
}
import v2.extdeps.languages.dag {
  dag_language_model_canonical_symbols,
  dag_surface_module_header_metadata_edge,
  qualified_name_from_module_node
}
import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list }
import v2.std.collection { Absent, Map, Present, empty_map, map_get, map_insert, optional_absent, optional_present }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  Diagnostics,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_merge,
  diagnostics_singleton,
  port_locus,
  rejected_with_pending
}
import v2.std.node {
  Conj,
  Edge,
  Node,
  NodeFoldTopDown,
  Symbol,
  TypeNode,
  fold_node_topdown,
  well_formed
}
import v2.std.passing_candidate_fold {
  ManyPassingCandidates,
  NoPassingCandidate,
  OnePassingCandidate,
  PassingCandidateFold
}
import v2.std.cross_tree.import_model {
  SourceRootRef
}
import v2.std.cross_tree.resolution {
  EdgeCrossAdmitted,
  EdgeCrossAmbiguous,
  EdgeCrossDenied,
  EdgeNormalResolution,
  SourceRootIndex,
  cross_tree_edge_decision,
  source_root_index_empty
}
import v2.std.qualified_name { QualifiedName }

type ImportVisibility
  = ImportVisible
  | ImportHidden

type Import {
  target: QualifiedName
  visibility: ImportVisibility
}

type ResolutionSubject {
  name: QualifiedName
}

type Admission {
  subject: ResolutionSubject
  imports: FreeMonoid<Import>
}

type AdmittedSubject {
  namespace: Namespace
  subject_root: NormalizedTree
}

type AdmissionState
  = AdmissionAccepted {
      bindings: Map<Symbol, Symbol>,
      origins: Map<Symbol, QualifiedName>
    }
  | AdmissionRejected { diagnostics: NonEmptyDiagnostics }

type ModuleRootValidateState
  = ModuleRootsValid { seen: FreeMonoid<QualifiedName>, diagnostics: Diagnostics }
  | ModuleRootsDuplicate { diagnostics: Diagnostics }
  | ModuleRootsProjectionRejected { diagnostics: NonEmptyDiagnostics }

type ModuleRootNameFindState
  = ModuleRootNameNotFound
  | ModuleRootNameFoundOnce
  | ModuleRootNameFoundDuplicate

fn resolve_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: port_locus(port: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn resolve_diagnostics(reason: Symbol) -> NonEmptyDiagnostics {
  diagnostics_singleton(d: resolve_diagnostic(reason: reason))
}

fn admission_initial(base: Namespace) -> AdmissionState {
  AdmissionAccepted {
    bindings: base.bindings,
    origins: empty_map()
  }
}

fn admit_export_symbol(
  sym: Symbol,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: b, origins: os } =>

      match map_get(os, sym) {
        Accepted { value: opt, diagnostics: _ } => match opt {
          Present { value: _ } =>
            AdmissionRejected {
              diagnostics: resolve_diagnostics(reason: ^resolve_ambiguous_export)
            }
          Absent =>
            AdmissionAccepted {
              bindings: map_insert(m: b, key: sym, value: sym),
              origins: map_insert(m: os, key: sym, value: origin)
            }
        }
        Rejected { diagnostics: d } => AdmissionRejected { diagnostics: d }
      }
  }
}

fn module_root_name_find_fold(
  names: FreeMonoid<QualifiedName>,
  name: QualifiedName,
  acc: ModuleRootNameFindState
) -> ModuleRootNameFindState {
  fold_list(
    xs: names,
    empty: acc,
    cons: fn(st, candidate) {
      if candidate == name {
        match st {
          ModuleRootNameNotFound => ModuleRootNameFoundOnce
          ModuleRootNameFoundOnce => ModuleRootNameFoundDuplicate
          ModuleRootNameFoundDuplicate => ModuleRootNameFoundDuplicate
        }
      } else {
        st
      }
    }
  )
}

fn validate_module_roots(roots: FreeMonoid<Node>) -> Outcome<FreeMonoid<Node>> {
  match fold_list(
    xs: roots,
    empty: ModuleRootsValid { seen: Empty, diagnostics: None },
    cons: fn(acc, root) {
      match acc {
        ModuleRootsDuplicate { diagnostics: d } =>
          ModuleRootsDuplicate { diagnostics: d }
        ModuleRootsProjectionRejected { diagnostics: d } =>
          ModuleRootsProjectionRejected { diagnostics: d }
        ModuleRootsValid { seen: prior, diagnostics: acc_diag } =>
          if well_formed(n: root) {
            match qualified_name_from_module_node(root: root) {
              Rejected { diagnostics: d } =>
                ModuleRootsProjectionRejected {
                  diagnostics: rejected_with_pending(pending: acc_diag, rejected: d)
                }
              Accepted { value: name, diagnostics: proj_diag } =>
                let merged_diag = diagnostics_merge(outer: acc_diag, inner: proj_diag)
                match module_root_name_find_fold(
                  names: prior,
                  name: name,
                  acc: ModuleRootNameNotFound
                ) {
                  ModuleRootNameNotFound =>
                    ModuleRootsValid {
                      seen: Cons { head: name, tail: prior },
                      diagnostics: merged_diag
                    }
                  ModuleRootNameFoundOnce =>
                    ModuleRootsDuplicate { diagnostics: merged_diag }
                  ModuleRootNameFoundDuplicate =>
                    ModuleRootsDuplicate { diagnostics: merged_diag }
                }
            }
          } else {
            ModuleRootsProjectionRejected {
              diagnostics: rejected_with_pending(
                pending: acc_diag,
                rejected: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
              )
            }
          }
      }
    }
  ) {
    ModuleRootsValid { seen: _, diagnostics: d } =>
      Accepted { value: roots, diagnostics: d }
    ModuleRootsDuplicate { diagnostics: d } =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: d,
          rejected: resolve_diagnostics(reason: ^resolve_duplicate_module_name)
        )
      }
    ModuleRootsProjectionRejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn module_root_find(
  roots: FreeMonoid<Node>,
  name: QualifiedName
) -> Outcome<Node> {
  match fold_list(
    xs: roots,
    empty: Accepted { value: NoPassingCandidate, diagnostics: None },
    cons: fn(acc, root) {
      match acc {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: fold_state, diagnostics: _ } =>
          match fold_state {
            ManyPassingCandidates =>
              Accepted { value: ManyPassingCandidates, diagnostics: None }
            _ =>
              match qualified_name_from_module_node(root: root) {
                Rejected { diagnostics: d } =>
                  Rejected { diagnostics: d }
                Accepted { value: candidate, diagnostics: _ } =>
                  Accepted {
                    value: match candidate == name {
                      true =>
                        match fold_state {
                          NoPassingCandidate => OnePassingCandidate { candidate: root }
                          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
                          ManyPassingCandidates => ManyPassingCandidates
                        }
                      false => fold_state
                    },
                    diagnostics: None
                  }
              }
          }
      }
    }
  ) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: fold_state, diagnostics: _ } =>
      match fold_state {
        NoPassingCandidate =>
          Rejected { diagnostics: resolve_diagnostics(reason: ^resolve_module_not_found) }
        OnePassingCandidate { candidate: root } =>
          Accepted { value: root, diagnostics: None }
        ManyPassingCandidates =>
          Rejected { diagnostics: resolve_diagnostics(reason: ^resolve_duplicate_module_name) }
      }
  }
}

fn try_admitted_export_binding(e: Edge) -> DeclaredBinding? {
  match try_edge_declared_binding(e: e) {
    Present { value: b } =>
      if dag_surface_module_header_metadata_edge(name: b.name) {
        optional_absent()
      } else {
        optional_present(value: b)
      }
    Absent => optional_absent()
  }
}

type AdmitExportsFold {
  origin: QualifiedName
  state: AdmissionState
  at_conj: Bool
}

fn admit_named_export_edge(
  edge: Edge,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match try_admitted_export_binding(e: edge) {
    Present { value: b } =>
      admit_export_symbol(sym: b.name, origin: origin, state: state)
    Absent => state
  }
}

fn named_exports_topdown_algebra() -> NodeFoldTopDown<AdmitExportsFold, AdmitExportsFold> {
  NodeFoldTopDown {
    init: fn(n, fold) {
      AdmitExportsFold {
        origin: fold.origin,
        state: fold.state,
        at_conj: match n.kind {
          TypeNode { connective: Conj } => true
          _ => false
        }
      }
    },
    child_context: fn(n, fold, e) { fold },
    step: fn(acc, e, child_r) {
      if acc.at_conj {
        AdmitExportsFold {
          origin: acc.origin,
          state: admit_named_export_edge(
            edge: e,
            origin: acc.origin,
            state: acc.state
          ),
          at_conj: true
        }
      } else {
        child_r
      }
    }
  }
}

fn admit_named_exports(
  root: Node,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match root.kind {
    TypeNode { connective: Conj } =>
      match fold_node_topdown(
        n: root,
        ctx: AdmitExportsFold {
          origin: origin,
          state: state,
          at_conj: false
        },
        algebra: named_exports_topdown_algebra()
      ) {
        AdmitExportsFold { state: folded_state, origin: _, at_conj: _ } =>
          folded_state
      }
    _ => state
  }
}

fn admit_import_root_find(
  found: Outcome<Node>,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match found {
    Rejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    Accepted { value: imported_root, diagnostics: _ } =>
      if well_formed(n: imported_root) {
        admit_named_exports(
          root: imported_root,
          origin: origin,
          state: state
        )
      } else {
        AdmissionRejected {
          diagnostics: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
        }
      }
  }
}

fn admit_import_visible_entry(
  roots: FreeMonoid<Node>,
  import_edge: Import,
  state: AdmissionState
) -> AdmissionState {
  admit_import_root_find(
    found: module_root_find(
      roots: roots,
      name: import_edge.target
    ),
    origin: import_edge.target,
    state: state
  )
}

fn admit_import_entry(
  roots: FreeMonoid<Node>,
  import_edge: Import,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: _, origins: _ } =>
      match import_edge.visibility {
        ImportHidden =>
          AdmissionRejected {
            diagnostics: resolve_diagnostics(reason: ^resolve_import_not_visible)
          }
        ImportVisible =>
          match cross_tree_edge_decision(
            index: index,
            from_qn: subject_qn,
            to_qn: import_edge.target,
            active_roots: active_roots
          ) {
            EdgeNormalResolution =>
              admit_import_visible_entry(roots: roots, import_edge: import_edge, state: state)
            EdgeCrossAdmitted =>
              admit_import_visible_entry(roots: roots, import_edge: import_edge, state: state)
            EdgeCrossDenied =>
              AdmissionRejected {
                diagnostics: resolve_diagnostics(reason: ^resolve_cross_tree_import_denied)
              }
            EdgeCrossAmbiguous =>
              AdmissionRejected {
                diagnostics: resolve_diagnostics(reason: ^resolve_cross_tree_import_ambiguous)
              }
          }
      }
  }
}

fn admit_imports(
  roots: FreeMonoid<Node>,
  imports: FreeMonoid<Import>,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  fold_list(
    xs: imports,
    empty: state,
    cons: fn(acc, import_edge) {
      admit_import_entry(
        roots: roots,
        import_edge: import_edge,
        state: acc,
        subject_qn: subject_qn,
        index: index,
        active_roots: active_roots
      )
    }
  )
}

fn admission_namespace_base(lm: LanguageModel) -> Namespace {
  Namespace {
    bindings: empty_map(),
    canonical_symbols: dag_language_model_canonical_symbols(lm: lm)
  }
}

fn subject_module_root_for_name(
  roots: FreeMonoid<Node>,
  name: QualifiedName
) -> Outcome<Node> {
  module_root_find(roots: roots, name: name)
}

fn namespace_for_subject(
  lm: LanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> Outcome<AdmittedSubject> {
  match validate_module_roots(roots: roots) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: validated_roots, diagnostics: validate_diag } =>
      match subject_module_root_for_name(
        roots: validated_roots,
        name: admission.subject.name
      ) {
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: validate_diag, rejected: r)
          }
        Accepted { value: subject_module_root, diagnostics: _ } =>
          if well_formed(n: subject_module_root) {
            let base = admission_namespace_base(lm: lm)
            match admit_imports(
              roots: validated_roots,
              imports: admission.imports,
              state: admit_named_exports(
                root: subject_module_root,
                origin: admission.subject.name,
                state: admission_initial(base: base)
              ),
              subject_qn: admission.subject.name,
              index: index,
              active_roots: active_roots
            ) {
              AdmissionAccepted { bindings: b, origins: _ } =>
                Accepted {
                  value: AdmittedSubject {
                    namespace: Namespace {
                      bindings: b,
                      canonical_symbols: base.canonical_symbols
                    },
                    subject_root: subject_module_root
                  },
                  diagnostics: validate_diag
                }
              AdmissionRejected { diagnostics: d } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: validate_diag, rejected: d)
                }
            }
          } else {
            Rejected {
              diagnostics: rejected_with_pending(
                pending: validate_diag,
                rejected: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
              )
            }
          }
      }
  }
}

fn resolve_with_admission_policy(
  lm: LanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> Outcome<ResolvedTree> {
  match namespace_for_subject(
    lm: lm,
    roots: roots,
    admission: admission,
    index: index,
    active_roots: active_roots
  ) {
    Accepted { value: admitted, diagnostics: namespace_diag } =>
      match resolve_with_namespace(
        tree: admitted.subject_root,
        namespace: admitted.namespace,
        lm: lm
      ) {
        Accepted { value: resolved, diagnostics: resolve_diag } =>
          Accepted {
            value: resolved,
            diagnostics: diagnostics_merge(outer: namespace_diag, inner: resolve_diag)
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: namespace_diag, rejected: r)
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn resolve_with_admission(
  lm: LanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission
) -> Outcome<ResolvedTree> {
  resolve_with_admission_policy(
    lm: lm,
    roots: roots,
    admission: admission,
    index: source_root_index_empty(),
    active_roots: Empty
  )
}

fn resolve_with_admission_grounded(
  lm: LanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> Outcome<ResolvedTree> {
  resolve_with_admission_policy(
    lm: lm,
    roots: roots,
    admission: admission,
    index: index,
    active_roots: active_roots
  )
}
