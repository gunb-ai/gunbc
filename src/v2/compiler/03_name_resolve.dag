// src/v2/compiler/03_name_resolve.dag
//
// Scope: Stage 3c — module-root admission for cross-file resolution.
// Status: T-28-B modeled — graph admission is outside K-1 single-tree resolver.
// Anchor: https://en.wikipedia.org/wiki/Name_resolution_(programming_languages)

module v2.compiler.name_resolve
import v2.std.language_model { LanguageModel }


import v2.compiler.normalize { NormalizedTree }
import v2.compiler.resolve {
  DeclaredBinding,
  Namespace,
  ResolvedTree,
  resolve_with_namespace,
  try_edge_declared_binding
}
import v2.extdeps.languages.dag {
  dag_language_model_canonical_symbols,
  dag_surface_module_header_metadata_edge,
  qualified_name_from_module_node
}
import v2.std.algebra { Cons, Empty, FreeMonoid, fold_list }
import v2.std.collection { Absent, Map, Present, empty_map, map_get, map_insert, optional_absent, optional_prefer_first_present, optional_present }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  Diagnostics,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_merge,
  diagnostics_singleton,
  outcome_accepted,
  port_locus,
  rejected_with_pending
}
import v2.std.node {
  Conj,
  Edge,
  Node,
  NodeFoldTopDown,
  Symbol,
  TypeNode,
  fold_node_topdown,
  well_formed
}
import v2.std.passing_candidate_fold {
  ManyPassingCandidates,
  NoPassingCandidate,
  OnePassingCandidate,
  PassingCandidateFold
}
import v2.std.cross_tree.import_model {
  CrossTreeAdmitted,
  CrossTreeDenied,
  FundamentalityUnknown,
  SourceRootRef,
  TreeFundamentalityOrder
}
import v2.std.cross_tree.resolution {
  cross_tree_import_admitted_qualified,
  cross_tree_import_admitted_trees,
  cross_tree_import_is_same_tree,
  cross_tree_import_is_same_tree_trees,
  source_root_set_from_module_roots
}
import v2.std.qualified_name {
  QualifiedName,
  qualified_name_eq
}


// Route C Phase C — grounded module→tree binding from host-tagged ingest witnesses.
type ModuleSourceRootBinding {
  module_qn: QualifiedName
  source_root: SourceRootRef
}


// 🟢 coproduct dissolution — T-28-B admission visibility is a closed alternative: a declared import is either admitted into the subject namespace or rejected as hidden; no third visibility state is modeled.
type ImportVisibility
  = ImportVisible
  | ImportHidden


type Import {
  target: QualifiedName
  visibility: ImportVisibility
}


type ResolutionSubject {
  name: QualifiedName
}


type Admission {
  subject: ResolutionSubject
  imports: FreeMonoid<Import>
}


// 🟢 coproduct dissolution — T-28-B admitted subject pairs authoritative module root with its namespace.
type AdmittedSubject {
  namespace: Namespace
  subject_root: NormalizedTree
}


// 🟡 gated — feature:T-28-B-admission-state-outcome — internal fold state mirrors Outcome while carrying accepted namespace bindings plus origin facts for ambiguity checks; dissolve-on: generic Outcome fold/traverse can carry the accepted admission accumulator directly without losing the origin map.
type AdmissionState
  = AdmissionAccepted {
      bindings: Map<Symbol, Symbol>,
      origins: Map<Symbol, QualifiedName>
    }
  | AdmissionRejected { diagnostics: NonEmptyDiagnostics }


// 🟢 coproduct dissolution — T-QN-1 Change 2 module-root validate accumulator.
type ModuleRootValidateState
  = ModuleRootsValid { seen: FreeMonoid<QualifiedName>, diagnostics: Diagnostics }
  | ModuleRootsDuplicate { diagnostics: Diagnostics }
  | ModuleRootsProjectionRejected { diagnostics: NonEmptyDiagnostics }


// 🟡 coproduct dissolution — dissolve-on-arrival: PassingCandidateFold<T> generalization (T=QualifiedName; blocked by T=Node hardcode in passing_candidate_fold.dag); T-QN-1 Change 2 module-root name-find accumulator.
type ModuleRootNameFindState
  = ModuleRootNameNotFound
  | ModuleRootNameFoundOnce
  | ModuleRootNameFoundDuplicate




fn resolve_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: port_locus(port: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn resolve_diagnostics(reason: Symbol) -> NonEmptyDiagnostics {
  diagnostics_singleton(d: resolve_diagnostic(reason: reason))
}


fn admission_initial(base: Namespace) -> AdmissionState {
  AdmissionAccepted {
    bindings: base.bindings,
    origins: empty_map()
  }
}


fn admit_export_symbol(
  sym: Symbol,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: b, origins: os } =>
      // 🟡 gated — bootstrap-limitation interim — feature:B-LOOKUP-1 — map_get(Option<V>); dissolve-on: bootstrap Witness<V> generic dispatch for Map.lookup (substrate already Witness at v2.std.collection:27); site: admit_export_symbol origins
      match map_get(os, sym) {
        Accepted { value: opt, diagnostics: _ } => match opt {
          Present { value: _ } =>
            AdmissionRejected {
              diagnostics: resolve_diagnostics(reason: ^resolve_ambiguous_export)
            }
          Absent =>
            AdmissionAccepted {
              bindings: map_insert(m: b, key: sym, value: sym),
              origins: map_insert(m: os, key: sym, value: origin)
            }
        }
        Rejected { diagnostics: d } => AdmissionRejected { diagnostics: d }
      }
  }
}


fn module_root_name_find_fold(
  names: FreeMonoid<QualifiedName>,
  name: QualifiedName,
  acc: ModuleRootNameFindState
) -> ModuleRootNameFindState {
  fold_list(
    xs: names,
    empty: acc,
    cons: fn(st, candidate) {
      if qualified_name_eq(a: candidate, b: name) {
        match st {
          ModuleRootNameNotFound => ModuleRootNameFoundOnce
          ModuleRootNameFoundOnce => ModuleRootNameFoundDuplicate
          ModuleRootNameFoundDuplicate => ModuleRootNameFoundDuplicate
        }
      } else {
        st
      }
    }
  )
}


fn validate_module_roots(roots: FreeMonoid<Node>) -> Outcome<FreeMonoid<Node>> {
  match fold_list(
    xs: roots,
    empty: ModuleRootsValid { seen: Empty, diagnostics: None },
    cons: fn(acc, root) {
      match acc {
        ModuleRootsDuplicate { diagnostics: d } =>
          ModuleRootsDuplicate { diagnostics: d }
        ModuleRootsProjectionRejected { diagnostics: d } =>
          ModuleRootsProjectionRejected { diagnostics: d }
        ModuleRootsValid { seen: prior, diagnostics: acc_diag } =>
          if well_formed(n: root) {
            match qualified_name_from_module_node(root: root) {
              Rejected { diagnostics: d } =>
                ModuleRootsProjectionRejected {
                  diagnostics: rejected_with_pending(pending: acc_diag, rejected: d)
                }
              Accepted { value: name, diagnostics: proj_diag } =>
                let merged_diag = diagnostics_merge(outer: acc_diag, inner: proj_diag)
                match module_root_name_find_fold(
                  names: prior,
                  name: name,
                  acc: ModuleRootNameNotFound
                ) {
                  ModuleRootNameNotFound =>
                    ModuleRootsValid {
                      seen: Cons { head: name, tail: prior },
                      diagnostics: merged_diag
                    }
                  ModuleRootNameFoundOnce =>
                    ModuleRootsDuplicate { diagnostics: merged_diag }
                  ModuleRootNameFoundDuplicate =>
                    ModuleRootsDuplicate { diagnostics: merged_diag }
                }
            }
          } else {
            ModuleRootsProjectionRejected {
              diagnostics: rejected_with_pending(
                pending: acc_diag,
                rejected: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
              )
            }
          }
      }
    }
  ) {
    ModuleRootsValid { seen: _, diagnostics: d } =>
      Accepted { value: roots, diagnostics: d }
    ModuleRootsDuplicate { diagnostics: d } =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: d,
          rejected: resolve_diagnostics(reason: ^resolve_duplicate_module_name)
        )
      }
    ModuleRootsProjectionRejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}


fn module_root_find(
  roots: FreeMonoid<Node>,
  name: QualifiedName
) -> Outcome<Node> {
  match fold_list(
    xs: roots,
    empty: Accepted { value: NoPassingCandidate, diagnostics: None },
    cons: fn(acc, root) {
      match acc {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: fold_state, diagnostics: _ } =>
          match fold_state {
            ManyPassingCandidates =>
              Accepted { value: ManyPassingCandidates, diagnostics: None }
            _ =>
              match qualified_name_from_module_node(root: root) {
                Rejected { diagnostics: d } =>
                  Rejected { diagnostics: d }
                Accepted { value: candidate, diagnostics: _ } =>
                  Accepted {
                    value: match qualified_name_eq(a: candidate, b: name) {
                      true =>
                        match fold_state {
                          NoPassingCandidate => OnePassingCandidate { candidate: root }
                          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
                          ManyPassingCandidates => ManyPassingCandidates
                        }
                      false => fold_state
                    },
                    diagnostics: None
                  }
              }
          }
      }
    }
  ) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: fold_state, diagnostics: _ } =>
      match fold_state {
        NoPassingCandidate =>
          Rejected { diagnostics: resolve_diagnostics(reason: ^resolve_module_not_found) }
        OnePassingCandidate { candidate: root } =>
          Accepted { value: root, diagnostics: None }
        ManyPassingCandidates =>
          Rejected { diagnostics: resolve_diagnostics(reason: ^resolve_duplicate_module_name) }
      }
  }
}


fn try_admitted_export_binding(e: Edge) -> DeclaredBinding? {
  match try_edge_declared_binding(e: e) {
    Present { value: b } =>
      if dag_surface_module_header_metadata_edge(name: b.name) {
        optional_absent()
      } else {
        optional_present(value: b)
      }
    Absent => optional_absent()
  }
}


type AdmitExportsFold {
  origin: QualifiedName
  state: AdmissionState
  at_conj: Bool
}


fn admit_named_export_edge(
  edge: Edge,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match try_admitted_export_binding(e: edge) {
    Present { value: b } =>
      admit_export_symbol(sym: b.name, origin: origin, state: state)
    Absent => state
  }
}


fn named_exports_topdown_algebra() -> NodeFoldTopDown<AdmitExportsFold, AdmitExportsFold> {
  NodeFoldTopDown {
    init: fn(n, fold) {
      AdmitExportsFold {
        origin: fold.origin,
        state: fold.state,
        at_conj: match n.kind {
          TypeNode { connective: Conj } => true
          _ => false
        }
      }
    },
    child_context: fn(n, fold, e) { fold },
    step: fn(acc, e, child_r) {
      if acc.at_conj {
        AdmitExportsFold {
          origin: acc.origin,
          state: admit_named_export_edge(
            edge: e,
            origin: acc.origin,
            state: acc.state
          ),
          at_conj: true
        }
      } else {
        child_r
      }
    }
  }
}


fn admit_named_exports(
  root: Node,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match root.kind {
    TypeNode { connective: Conj } =>
      match fold_node_topdown(
        n: root,
        ctx: AdmitExportsFold {
          origin: origin,
          state: state,
          at_conj: false
        },
        algebra: named_exports_topdown_algebra()
      ) {
        AdmitExportsFold { state: folded_state, origin: _, at_conj: _ } =>
          folded_state
      }
    _ => state
  }
}


fn admit_import_root_find(
  found: Outcome<Node>,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match found {
    Rejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    Accepted { value: imported_root, diagnostics: _ } =>
      if well_formed(n: imported_root) {
        admit_named_exports(
          root: imported_root,
          origin: origin,
          state: state
        )
      } else {
        AdmissionRejected {
          diagnostics: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
        }
      }
  }
}


fn source_root_for_qn_in_bindings(
  bindings: FreeMonoid<ModuleSourceRootBinding>,
  qn: QualifiedName
) -> Outcome<SourceRootRef> {
  match fold_list(
    xs: bindings,
    empty: Absent,
    cons: fn(found, binding) {
      optional_prefer_first_present(
        left: found,
        right: if qualified_name_eq(a: binding.module_qn, b: qn) {
          optional_present(value: binding.source_root)
        } else {
          Absent
        }
      )
    }
  ) {
    Present { value: tree } => outcome_accepted(value: tree)
    Absent =>
      outcome_rejected(
        d: resolve_diagnostics(reason: ^resolve_cross_tree_import_denied)
      )
  }
}


fn admit_import_entry(
  roots: FreeMonoid<Node>,
  import_edge: Import,
  state: AdmissionState,
  subject_qn: QualifiedName,
  order: TreeFundamentalityOrder,
  active_roots: FreeMonoid<SourceRootRef>,
  bindings: FreeMonoid<ModuleSourceRootBinding>
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: _, origins: _ } =>
      match import_edge.visibility {
        ImportHidden =>
          AdmissionRejected {
            diagnostics: resolve_diagnostics(reason: ^resolve_import_not_visible)
          }
        ImportVisible =>
          match source_root_for_qn_in_bindings(bindings: bindings, qn: subject_qn) {
            Accepted { value: subject_tree, diagnostics: _ } =>
              match source_root_for_qn_in_bindings(bindings: bindings, qn: import_edge.target) {
                Accepted { value: target_tree, diagnostics: _ } =>
                  if cross_tree_import_is_same_tree_trees(from_tree: subject_tree, to_tree: target_tree) {
                    admit_import_root_find(
                      found: module_root_find(
                        roots: roots,
                        name: import_edge.target
                      ),
                      origin: import_edge.target,
                      state: state
                    )
                  } else {
                    match cross_tree_import_admitted_trees(
                      from_tree: subject_tree,
                      from_qn: subject_qn,
                      to_tree: target_tree,
                      to_qn: import_edge.target,
                      roots: active_roots,
                      order: order
                    ) {
                      CrossTreeAdmitted =>
                        admit_import_root_find(
                          found: module_root_find(
                            roots: roots,
                            name: import_edge.target
                          ),
                          origin: import_edge.target,
                          state: state
                        )
                      CrossTreeDenied { reason: _ } =>
                        AdmissionRejected {
                          diagnostics: resolve_diagnostics(reason: ^resolve_cross_tree_import_denied)
                        }
                    }
                  }
                Rejected { diagnostics: _ } =>
                  admit_import_entry_qn_fallback(
                    roots: roots,
                    import_edge: import_edge,
                    state: state,
                    subject_qn: subject_qn,
                    order: order,
                    active_roots: active_roots
                  )
              }
            Rejected { diagnostics: _ } =>
              admit_import_entry_qn_fallback(
                roots: roots,
                import_edge: import_edge,
                state: state,
                subject_qn: subject_qn,
                order: order,
                active_roots: active_roots
              )
          }
      }
  }
}


// Synthetic-witness fallback when ingest bindings are absent (QN-prefix tree inference).
fn admit_import_entry_qn_fallback(
  roots: FreeMonoid<Node>,
  import_edge: Import,
  state: AdmissionState,
  subject_qn: QualifiedName,
  order: TreeFundamentalityOrder,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: _, origins: _ } =>
      match import_edge.visibility {
        ImportHidden =>
          AdmissionRejected {
            diagnostics: resolve_diagnostics(reason: ^resolve_import_not_visible)
          }
        ImportVisible =>
          if cross_tree_import_is_same_tree(from_qn: subject_qn, to_qn: import_edge.target) {
            admit_import_root_find(
              found: module_root_find(
                roots: roots,
                name: import_edge.target
              ),
              origin: import_edge.target,
              state: state
            )
          } else {
            match cross_tree_import_admitted_qualified(
              from_qn: subject_qn,
              to_qn: import_edge.target,
              roots: active_roots,
              order: order
            ) {
              CrossTreeAdmitted =>
                admit_import_root_find(
                  found: module_root_find(
                    roots: roots,
                    name: import_edge.target
                  ),
                  origin: import_edge.target,
                  state: state
                )
              CrossTreeDenied { reason: _ } =>
                AdmissionRejected {
                  diagnostics: resolve_diagnostics(reason: ^resolve_cross_tree_import_denied)
                }
            }
          }
      }
  }
}


fn admit_imports(
  roots: FreeMonoid<Node>,
  imports: FreeMonoid<Import>,
  state: AdmissionState,
  subject_qn: QualifiedName,
  order: TreeFundamentalityOrder,
  active_roots: FreeMonoid<SourceRootRef>,
  bindings: FreeMonoid<ModuleSourceRootBinding>
) -> AdmissionState {
  fold_list(
    xs: imports,
    empty: state,
    cons: fn(acc, import_edge) {
      admit_import_entry(
        roots: roots,
        import_edge: import_edge,
        state: acc,
        subject_qn: subject_qn,
        order: order,
        active_roots: active_roots,
        bindings: bindings
      )
    }
  )
}


fn admission_namespace_base(lm: LanguageModel) -> Namespace {
  Namespace {
    bindings: empty_map(),
    canonical_symbols: dag_language_model_canonical_symbols(lm: lm)
  }
}


fn subject_module_root_for_name(
  roots: FreeMonoid<Node>,
  name: QualifiedName
) -> Outcome<Node> {
  module_root_find(roots: roots, name: name)
}


fn namespace_for_subject(
  lm: LanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission,
  order: TreeFundamentalityOrder,
  active_roots: FreeMonoid<SourceRootRef>,
  bindings: FreeMonoid<ModuleSourceRootBinding>
) -> Outcome<AdmittedSubject> {
  match validate_module_roots(roots: roots) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: validated_roots, diagnostics: validate_diag } =>
      match subject_module_root_for_name(
        roots: validated_roots,
        name: admission.subject.name
      ) {
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: validate_diag, rejected: r)
          }
        Accepted { value: subject_module_root, diagnostics: _ } =>
          if well_formed(n: subject_module_root) {
            let base = admission_namespace_base(lm: lm)
            match admit_imports(
              roots: validated_roots,
              imports: admission.imports,
              state: admit_named_exports(
                root: subject_module_root,
                origin: admission.subject.name,
                state: admission_initial(base: base)
              ),
              subject_qn: admission.subject.name,
              order: order,
              active_roots: active_roots,
              bindings: bindings
            ) {
              AdmissionAccepted { bindings: b, origins: _ } =>
                Accepted {
                  value: AdmittedSubject {
                    namespace: Namespace {
                      bindings: b,
                      canonical_symbols: base.canonical_symbols
                    },
                    subject_root: subject_module_root
                  },
                  diagnostics: validate_diag
                }
              AdmissionRejected { diagnostics: d } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: validate_diag, rejected: d)
                }
            }
          } else {
            Rejected {
              diagnostics: rejected_with_pending(
                pending: validate_diag,
                rejected: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
              )
            }
          }
      }
  }
}


fn resolve_with_admission_policy(
  lm: LanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission,
  order: TreeFundamentalityOrder,
  active_roots: FreeMonoid<SourceRootRef>,
  bindings: FreeMonoid<ModuleSourceRootBinding>
) -> Outcome<ResolvedTree> {
  match namespace_for_subject(
    lm: lm,
    roots: roots,
    admission: admission,
    order: order,
    active_roots: active_roots,
    bindings: bindings
  ) {
    Accepted { value: admitted, diagnostics: namespace_diag } =>
      match resolve_with_namespace(
        tree: admitted.subject_root,
        namespace: admitted.namespace,
        lm: lm
      ) {
        Accepted { value: resolved, diagnostics: resolve_diag } =>
          Accepted {
            value: resolved,
            diagnostics: diagnostics_merge(outer: namespace_diag, inner: resolve_diag)
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: namespace_diag, rejected: r)
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}


// Extract QualifiedNames from raw module root Nodes (SCAFFOLD — dissolves with grounded source_root).
fn module_root_nodes_to_qns(roots: FreeMonoid<Node>) -> FreeMonoid<QualifiedName> {
  fold_list(
    xs: roots,
    empty: Empty,
    cons: fn(acc, root) {
      match qualified_name_from_module_node(root: root) {
        Accepted { value: qn, diagnostics: _ } => Cons { head: qn, tail: acc }
        Rejected { diagnostics: _ } => acc
      }
    }
  )
}


// Fail-closed default: FundamentalityUnknown denies all cross-tree imports.
fn resolve_with_admission(
  lm: LanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission
) -> Outcome<ResolvedTree> {
  resolve_with_admission_grounded(
    lm: lm,
    roots: roots,
    admission: admission,
    order: FundamentalityUnknown,
    active_roots: source_root_set_from_module_roots(qns: module_root_nodes_to_qns(roots: roots)),
    bindings: Empty
  )
}


// Route C Phase C — ingest-grounded source_root bindings for cross-tree admission.
fn resolve_with_admission_grounded(
  lm: LanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission,
  order: TreeFundamentalityOrder,
  active_roots: FreeMonoid<SourceRootRef>,
  bindings: FreeMonoid<ModuleSourceRootBinding>
) -> Outcome<ResolvedTree> {
  resolve_with_admission_policy(
    lm: lm,
    roots: roots,
    admission: admission,
    order: order,
    active_roots: active_roots,
    bindings: bindings
  )
}
