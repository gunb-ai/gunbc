fn orch_emit_facts_lookup(key: Node) -> Optional<InferredFacts> {
  optional_absent()
}

data orch_emit_unsupported_step_anchor: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^orch_emit_unsupported_step } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn orch_emit_registry_emitted_root(
  medium: OrchestrationEmitMedium,
  construct_tag: Symbol
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(
      target: medium.authority,
      edge_name: ^target_model_edge_orchestration_emit
    ),
    f: fn(registry) {
      find_named_child(root: registry, name: construct_tag)
    }
  )
}

fn orch_emit_from_registry(
  medium: OrchestrationEmitMedium,
  construct_tag: Symbol,
  target: TargetModel
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_registry_emitted_root(medium: medium, construct_tag: construct_tag),
    f: fn(emitted_root) {
      emit(
        tree: InferredTree {
          root: emitted_root,
          facts: Map { lookup: orch_emit_facts_lookup }
        },
        target: target
      )
    }
  )
}

fn orch_emit_node_spelling(emitted_root: Node, target: TargetModel) -> Outcome<String> {
  bind_outcome(
    o: emit(
      tree: InferredTree {
        root: emitted_root,
        facts: Map { lookup: orch_emit_facts_lookup }
      },
      target: target
    ),
    f: fn(m) { outcome_accepted(m.carried) }
  )
}

data orch_shell_unquoted_path_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./-@"

fn orch_shell_unquoted_path_char_ok(ch: String) -> Bool {
  string_length(s: ch) == 1 && string_contains(s: orch_shell_unquoted_path_alphabet, pattern: ch)
}

fn orch_shell_unquoted_path_ok_at(path: String, i: Int, n: Int) -> Bool {
  if i >= n {
    true
  } else {
    let ch = char_at(s: path, pos: i)
    if !orch_shell_unquoted_path_char_ok(ch: ch) {
      false
    } else {
      orch_shell_unquoted_path_ok_at(path: path, i: i + 1, n: n)
    }
  }
}

fn orch_shell_unquoted_path_ok(path: String) -> Bool {
  let n = string_length(s: path)
  if n == 0 {
    false
  } else {
    orch_shell_unquoted_path_ok_at(path: path, i: 0, n: n)
  }
}

fn orch_emit_redir_suffix(r: RedirectSpec) -> Outcome<String> {
  match r {
    DiscardAll => outcome_accepted(bash_redir_stdout_and_stderr_null_source_text)
    DiscardErr => outcome_accepted(bash_redir_stderr_null_source_text)
    StdoutAndStderr => outcome_accepted(bash_redir_stdout_to_stderr_source_text)
    ToFile { path: p } =>
      if !orch_shell_unquoted_path_ok(path: p) {
        outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_to_file_path_invalid))
      } else {
        outcome_accepted(bash_redir_to_file_source_text(path: p))
      }
  }
}

fn orch_emit_run_core(r: Run, medium: OrchestrationEmitMedium) -> Outcome<String> {
  match list_head(xs: r.env) {
    HeadAbsent =>
      bind_outcome(
        o: orch_emit_from_registry(
          medium: medium,
          construct_tag: orch_construct_run_rawline,
          target: medium.realize_run_rawline(r.command)
        ),
        f: fn(m) { outcome_accepted(m.carried) }
      )
    HeadFound { value: _ } =>
      bind_outcome(
        o: orch_emit_run_from_plan(plan: medium.run_env_plan(r), medium: medium),
        f: fn(m) { outcome_accepted(m.carried) }
      )
  }
}

fn orch_emit_run_with_redir(stmt: String, redir: RedirectSpec) -> Outcome<String> {
  bind_outcome(
    o: orch_emit_redir_suffix(r: redir),
    f: fn(suffix) {
      orch_emit_node_spelling(
        emitted_root: bash_stmt_with_redir_emitted,
        target: bash_stmt_with_redir_target_model(stmt: stmt, redir: suffix)
      )
    }
  )
}

data orch_shell_ident_start_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"

data orch_shell_ident_continue_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789"

fn orch_shell_ident_start_char_ok(ch: String) -> Bool {
  string_length(s: ch) == 1 && string_contains(s: orch_shell_ident_start_alphabet, pattern: ch)
}

fn orch_shell_ident_continue_char_ok(ch: String) -> Bool {
  string_length(s: ch) == 1 && string_contains(s: orch_shell_ident_continue_alphabet, pattern: ch)
}

fn orch_shell_ident_ok_at(binder: String, i: Int, n: Int) -> Bool {
  if i >= n {
    true
  } else {
    let ch = char_at(s: binder, pos: i)
    let ok = if i == 0 {
      orch_shell_ident_start_char_ok(ch: ch)
    } else {
      orch_shell_ident_continue_char_ok(ch: ch)
    }
    if !ok {
      false
    } else {
      orch_shell_ident_ok_at(binder: binder, i: i + 1, n: n)
    }
  }
}

fn orch_shell_ident_ok(binder: String) -> Bool {
  let n = string_length(s: binder)
  if n == 0 {
    false
  } else {
    orch_shell_ident_ok_at(binder: binder, i: 0, n: n)
  }
}

fn orch_emit_exit_status_bind(stmt: String, binder: String, medium: OrchestrationEmitMedium) -> Outcome<String> {
  if !orch_shell_ident_ok(binder: binder) {
    outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_exit_status_binder_invalid))
  } else {
    bind_outcome(
      o: orch_emit_join2(left: stmt, right: concat(binder, "=$?"), medium: medium),
      f: fn(m) { outcome_accepted(m.carried) }
    )
  }
}

fn orch_emit_apply_capture(stmt: String, capture: CaptureSpec, medium: OrchestrationEmitMedium) -> Outcome<String> {
  match capture {
    IgnoreFail =>
      bind_outcome(
        o: bash_stmt_or_ignore_fail_target_model(stmt: stmt),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: bash_stmt_or_ignore_fail_emitted,
            target: target
          )
        }
      )
    ExitStatus { binder: b } =>
      orch_emit_exit_status_bind(stmt: stmt, binder: b, medium: medium)
    TeeTo { log: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_run_capture_unsupported))
    CmdSubst =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_run_capture_unsupported))
  }
}

fn orch_emit_run_spelling(r: Run, medium: OrchestrationEmitMedium) -> Outcome<String> {
  bind_outcome(
    o: orch_emit_run_core(r: r, medium: medium),
    f: fn(core) {
      match r.redirect {
        Absent =>
          match r.capture {
            Absent => outcome_accepted(core)
            Present { value: cap } =>
              orch_emit_apply_capture(stmt: core, capture: cap, medium: medium)
          }
        Present { value: redir } =>
          bind_outcome(
            o: orch_emit_run_with_redir(stmt: core, redir: redir),
            f: fn(with_redir) {
              match r.capture {
                Absent => outcome_accepted(with_redir)
                Present { value: cap } =>
                  orch_emit_apply_capture(stmt: with_redir, capture: cap, medium: medium)
              }
            }
          )
      }
    }
  )
}

fn orch_emit_run(r: Run, medium: OrchestrationEmitMedium) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_run_spelling(r: r, medium: medium),
    f: fn(spelling) { outcome_accepted(lossless_source(text: spelling)) }
  )
}

fn orch_emit_run_from_plan(
  plan: OrchRunEmitPlan,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: plan.construct_tag,
    target: plan.target
  )
}

fn orch_emit_join2(
  left: String,
  right: String,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: orch_construct_seq2,
    target: medium.realize_seq2(left, right)
  )
}

fn orch_emit_predicate(p: Predicate, medium: OrchestrationEmitMedium) -> Outcome<String> {
  match p {
    ExitZero { run: r } =>
      orch_emit_run_spelling(r: r, medium: medium)
    StrEq { lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: bash_test_str_eq_target_model(lhs: lhs, rhs: rhs),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: bash_test_str_eq_emitted,
            target: target
          )
        }
      )
    StrEmpty { operand: operand } =>
      bind_outcome(
        o: bash_test_str_empty_target_model(operand: operand),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: bash_test_str_empty_emitted,
            target: target
          )
        }
      )
    StrNonempty { operand: operand } =>
      bind_outcome(
        o: bash_test_str_nonempty_target_model(operand: operand),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: bash_test_str_nonempty_emitted,
            target: target
          )
        }
      )
    LogMatches { source: source, pattern: pattern } =>
      bind_outcome(
        o: bash_log_matches_grep_target_model(
          pattern: concat("'", concat(pattern, "'")),
          source: source
        ),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: bash_log_matches_grep_emitted,
            target: target
          )
        }
      )
    Not { inner: inner } =>
      bind_outcome(
        o: orch_emit_predicate(p: inner, medium: medium),
        f: fn(spelling) {
          orch_emit_node_spelling(
            emitted_root: bash_stmt_negation_emitted,
            target: bash_stmt_negation_target_model(inner: spelling)
          )
        }
      )
    And { lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: orch_emit_predicate(p: lhs, medium: medium),
        f: fn(left) {
          bind_outcome(
            o: orch_emit_predicate(p: rhs, medium: medium),
            f: fn(right) {
              orch_emit_node_spelling(
                emitted_root: bash_stmt_andor_emitted,
                target: bash_stmt_andor_target_model(left: left, op: "&&", right: right)
              )
            }
          )
        }
      )
    Or { lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: orch_emit_predicate(p: lhs, medium: medium),
        f: fn(left) {
          bind_outcome(
            o: orch_emit_predicate(p: rhs, medium: medium),
            f: fn(right) {
              orch_emit_node_spelling(
                emitted_root: bash_stmt_andor_emitted,
                target: bash_stmt_andor_target_model(left: left, op: "||", right: right)
              )
            }
          )
        }
      )
  }
}

fn orch_emit_call_args(args: List<String>) -> String {
  fold(args, init: "", f: fn(acc, a) {
    if acc == "" { a } else { concat(acc, concat(" ", a)) }
  })
}

fn orch_emit_cmdsubst_command_spelling(callee: String, args: List<String>) -> String {
  concat(callee, concat(" ", orch_emit_call_args(args: args)))
}

fn orch_emit_cmdsubst_word_spelling(callee: String, args: List<String>) -> String {
  concat("$(", concat(orch_emit_cmdsubst_command_spelling(callee: callee, args: args), ")"))
}

fn orch_emit_expr_spelling(e: Expr, medium: OrchestrationEmitMedium) -> Outcome<String> {
  match e {
    ExprLit { spelling: s } => outcome_accepted(s)
    ExprVarRef { name: n } => outcome_accepted(concat("$", n))
    ExprCmdSubst { callee: c, args: args } =>
      outcome_accepted(orch_emit_cmdsubst_word_spelling(callee: c, args: args))
  }
}

fn orch_emit_let_step(
  name: String,
  value: Expr,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match value {
    ExprCmdSubst { callee: c, args: args } =>
      orch_emit_from_registry(
        medium: medium,
        construct_tag: orch_construct_cmdsubst_assign,
        target: medium.realize_cmdsubst_assign(
          name,
          orch_emit_cmdsubst_command_spelling(callee: c, args: args)
        )
      )
    _ =>
      bind_outcome(
        o: orch_emit_expr_spelling(e: value, medium: medium),
        f: fn(value_spelling) {
          orch_emit_from_registry(
            medium: medium,
            construct_tag: orch_construct_let_assign,
            target: medium.realize_let_assign(name, value_spelling)
          )
        }
      )
  }
}

fn orch_emit_call_step(
  callee: String,
  args: List<String>,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: orch_construct_call,
    target: medium.realize_call(callee, orch_emit_call_args(args: args))
  )
}

fn orch_emit_procedure(
  proc: Procedure,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_pipeline(p: proc.body, medium: medium),
    f: fn(body_medium) {
      orch_emit_from_registry(
        medium: medium,
        construct_tag: orch_construct_procedure,
        target: medium.realize_procedure(proc.name, body_medium.carried)
      )
    }
  )
}

data orch_if_block_form_note: String = "bash_stmt_if_(else_)_tokens (bash_orch_if.dag / bash.dag) spell their then/else bodies with no newline tokens, so a body is inherently a single line. orch_emit_pipeline newline-joins every step of a multi-step then_/else_ Pipeline (orch_seq2) before this fn binds .carried into the row; a >1-step body glued into the single-line row is bash-valid (newline is an ordinary statement separator inside a then/else arm — verified, not a carriage bug) but byte-diverges from a block-formatted expectation. Multi-statement then_/else_ arms are legitimate orchestration intent (if-ladders), so the fix is a second, block-spelled row (bash_stmt_if_block_tokens / bash_stmt_if_else_block_tokens) selected when either arm needs it — never a refusal of the legitimate shape. Single- and zero-step arms keep the original inline row byte-for-byte (orch_pipeline_needs_block_body is false), so every existing consumer's emitted bytes are unchanged."

fn orch_pipeline_needs_block_body(then_: Pipeline, else_: Optional<Pipeline>) -> Bool {
  if length(xs: then_.steps) > 1 {
    true
  } else {
    match else_ {
      Absent => false
      Present { value: else_pipeline } => length(xs: else_pipeline.steps) > 1
    }
  }
}

data orch_if_empty_arm_note: String = "A Pipeline arm with zero steps emits \"\" (orch_emit_pipeline's HeadAbsent case); threaded raw into the if-body token slot that produces invalid bash (\"if COND; then ; fi\" -- then requires >=1 command before the closing separator). orch_if_arm_body_or_noop substitutes the bash no-op \":\" for an empty arm's body, uniformly across the inline and block dispatch and regardless of whether the OTHER arm is also empty -- see pipeline_steps_empty_arm_note (v2.std.orchestration) for why both-empty is real intent, not refused."

fn orch_if_arm_body_or_noop(carried: String) -> String {
  if carried == "" {
    ":"
  } else {
    carried
  }
}

fn orch_emit_if_step(
  cond: Predicate,
  then_: Pipeline,
  else_: Optional<Pipeline>,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  let block_body = orch_pipeline_needs_block_body(then_: then_, else_: else_)
  bind_outcome(
    o: orch_emit_predicate(p: cond, medium: medium),
    f: fn(cond_spelling) {
      bind_outcome(
        o: orch_emit_pipeline(p: then_, medium: medium),
        f: fn(then_medium) {
          let then_body = orch_if_arm_body_or_noop(carried: then_medium.carried)
          match else_ {
            Absent =>
              bind_outcome(
                o: if block_body {
                  medium.realize_if_block(cond_spelling, then_body)
                } else {
                  medium.realize_if(cond_spelling, then_body)
                },
                f: fn(target) {
                  orch_emit_from_registry(
                    medium: medium,
                    construct_tag: if block_body { orch_construct_if_block } else { orch_construct_if },
                    target: target
                  )
                }
              )
            Present { value: else_pipeline } =>
              bind_outcome(
                o: orch_emit_pipeline(p: else_pipeline, medium: medium),
                f: fn(else_medium) {
                  let else_body = orch_if_arm_body_or_noop(carried: else_medium.carried)
                  bind_outcome(
                    o: if block_body {
                      medium.realize_if_else_block(
                        cond_spelling,
                        then_body,
                        else_body
                      )
                    } else {
                      medium.realize_if_else(
                        cond_spelling,
                        then_body,
                        else_body
                      )
                    },
                    f: fn(target) {
                      orch_emit_from_registry(
                        medium: medium,
                        construct_tag: if block_body { orch_construct_if_else_block } else { orch_construct_if_else },
                        target: target
                      )
                    }
                  )
                }
              )
          }
        }
      )
    }
  )
}

fn orch_emit_while_step(
  cond: Predicate,
  body: Pipeline,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_predicate(p: cond, medium: medium),
    f: fn(cond_spelling) {
      bind_outcome(
        o: orch_emit_pipeline(p: body, medium: medium),
        f: fn(body_medium) {
          bind_outcome(
            o: medium.realize_while(cond_spelling, body_medium.carried),
            f: fn(target) {
              orch_emit_from_registry(
                medium: medium,
                construct_tag: orch_construct_while,
                target: target
              )
            }
          )
        }
      )
    }
  )
}

fn orch_emit_bounded_poll_step(
  max_attempts: v2.std.nat.Nat,
  body: Pipeline,
  success: Predicate,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_pipeline(p: body, medium: medium),
    f: fn(body_medium) {
      bind_outcome(
        o: orch_emit_predicate(p: success, medium: medium),
        f: fn(success_spelling) {
          bind_outcome(
            o: medium.realize_bounded_poll(
              integer_nat_to_decimal_string(value: max_attempts),
              body_medium.carried,
              success_spelling
            ),
            f: fn(target) {
              orch_emit_from_registry(
                medium: medium,
                construct_tag: orch_construct_bounded_poll,
                target: target
              )
            }
          )
        }
      )
    }
  )
}

fn orch_emit_step(s: PipelineStep, medium: OrchestrationEmitMedium) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match s {
    Do { run: r } => orch_emit_run(r: r, medium: medium)
    Comment { text: t } =>
      if string_contains(s: t, pattern: "\n") || string_contains(s: t, pattern: "\r") {
        outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_comment_multiline_refused))
      } else {
        orch_emit_from_registry(
          medium: medium,
          construct_tag: orch_construct_run_rawline,
          target: medium.realize_run_rawline(concat("# ", t))
        )
      }
    If { cond: c, then_: t, else_: e } =>
      orch_emit_if_step(cond: c, then_: t, else_: e, medium: medium)
    For { binder: _, over: _, body: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_step_for_unsupported))
    While { cond: c, body: b } =>
      orch_emit_while_step(cond: c, body: b, medium: medium)
    BoundedPoll { max_attempts: m, body: b, success: s } =>
      orch_emit_bounded_poll_step(max_attempts: m, body: b, success: s, medium: medium)
    Retry { body: b, escalations: e, on_exhausted: x } =>
      orch_emit_retry(body: b, escalations: e, on_exhausted: x, medium: medium)
    Let { name: n, value: v } =>
      orch_emit_let_step(name: n, value: v, medium: medium)
    Call { callee: c, args: a } =>
      orch_emit_call_step(callee: c, args: a, medium: medium)
  }
}

fn orch_retry_run_redirect_capture_admitted(r: Run) -> Bool {
  match r.redirect {
    Absent =>
      match r.capture {
        Absent => true
        Present { value: TeeTo { log: _ } } => true
        Present { value: CmdSubst } => false
        Present { value: IgnoreFail } => false
        Present { value: ExitStatus { binder: _ } } => false
      }
    Present { value: StdoutAndStderr } =>
      match r.capture {
        Absent => true
        Present { value: TeeTo { log: _ } } => true
        Present { value: CmdSubst } => false
        Present { value: IgnoreFail } => false
        Present { value: ExitStatus { binder: _ } } => false
      }
    Present { value: DiscardAll } => false
    Present { value: DiscardErr } => false
    Present { value: ToFile { path: _ } } => false
  }
}

fn orch_retry_step_command(s: PipelineStep) -> Optional<String> {
  match s {
    Do { run: r } =>
      if orch_retry_run_redirect_capture_admitted(r: r) {
        Present { value: r.command }
      } else {
        Absent
      }
    Comment { text: _ } => Absent
    If { cond: _, then_: _, else_: _ } => Absent
    For { binder: _, over: _, body: _ } => Absent
    While { cond: _, body: _ } => Absent
    BoundedPoll { max_attempts: _, body: _, success: _ } => Absent
    Retry { body: _, escalations: _, on_exhausted: _ } => Absent
    Let { name: _, value: _ } => Absent
    Call { callee: _, args: _ } => Absent
  }
}

fn orch_retry_body_command(body: Pipeline) -> Optional<String> {
  match list_head(xs: body.steps) {
    HeadFound { value: s } => orch_retry_step_command(s: s)
    HeadAbsent => Absent
  }
}

fn orch_emit_retry_run(
  command: String,
  env: FreeMonoid<EnvBinding>,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  orch_emit_run(
    r: Run { command: command, env: env, redirect: Absent, capture: Absent },
    medium: medium
  )
}

fn orch_emit_retry_2level(
  command: String,
  pattern1: String,
  pattern2: String,
  warn1: String,
  warn2: String,
  env1: FreeMonoid<EnvBinding>,
  env2: FreeMonoid<EnvBinding>,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_retry_run(command: command, env: [], medium: medium),
    f: fn(m1) {
      bind_outcome(
        o: orch_emit_retry_run(command: command, env: env1, medium: medium),
        f: fn(m2) {
          bind_outcome(
            o: orch_emit_retry_run(command: command, env: env2, medium: medium),
            f: fn(m3) {
              orch_emit_from_registry(
                medium: medium,
                construct_tag: orch_construct_retry,
                target: medium.realize_retry(
                  m1.carried,
                  m2.carried,
                  m3.carried,
                  pattern1,
                  pattern2,
                  warn1,
                  warn2,
                  exhausted
                )
              )
            }
          )
        }
      )
    }
  )
}

fn orch_emit_retry_1level(
  command: String,
  level: EscalationLevel,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match level.detect {
    LogMatches { source: _, pattern: grep_pat } =>
      bind_outcome(
        o: orch_emit_retry_run(command: command, env: [], medium: medium),
        f: fn(m1) {
          bind_outcome(
            o: orch_emit_retry_run(command: command, env: level.env, medium: medium),
            f: fn(m2) {
              orch_emit_from_registry(
                medium: medium,
                construct_tag: orch_construct_retry_1level,
                target: medium.realize_retry_1level(
                  m1.carried,
                  m2.carried,
                  grep_pat,
                  level.warning.message,
                  exhausted
                )
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches))
  }
}

fn orch_emit_retry_run_spelling(
  command: String,
  env: FreeMonoid<EnvBinding>,
  medium: OrchestrationEmitMedium
) -> Outcome<String> {
  bind_outcome(
    o: orch_emit_retry_run(command: command, env: env, medium: medium),
    f: fn(m) { outcome_accepted(m.carried) }
  )
}

fn orch_emit_retry_escalation_final(
  command: String,
  env: FreeMonoid<EnvBinding>,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<String> {
  bind_outcome(
    o: orch_emit_retry_run_spelling(command: command, env: env, medium: medium),
    f: fn(occ) {
      bind_outcome(
        o: orch_emit_from_registry(
          medium: medium,
          construct_tag: orch_construct_retry_escalation_final,
          target: medium.realize_retry_escalation_final(occ, exhausted)
        ),
        f: fn(m) { outcome_accepted(m.carried) }
      )
    }
  )
}

fn orch_emit_retry_escalation_step_for_level(
  command: String,
  level: EscalationLevel,
  grep_pat: String,
  inner: String,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<String> {
  bind_outcome(
    o: orch_emit_retry_run_spelling(command: command, env: level.env, medium: medium),
    f: fn(occ) {
      bind_outcome(
        o: orch_emit_from_registry(
          medium: medium,
          construct_tag: orch_construct_retry_escalation_step,
          target: medium.realize_retry_escalation_step(
            occ,
            grep_pat,
            level.warning.message,
            inner,
            exhausted
          )
        ),
        f: fn(m) { outcome_accepted(m.carried) }
      )
    }
  )
}

fn orch_emit_retry_escalation_tail(
  command: String,
  levels: List<EscalationLevel>,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<String> {
  match list_head(xs: levels) {
    HeadAbsent => outcome_accepted(exhausted)
    HeadFound { value: level } =>
      match level.detect {
        LogMatches { source: _, pattern: grep_pat } =>
          match list_tail(xs: levels) {
            TailAbsent =>
              orch_emit_retry_escalation_final(
                command: command,
                env: level.env,
                exhausted: exhausted,
                medium: medium
              )
            TailFound { tail: rest } =>
              match is_empty(rest) {
                true =>
                  orch_emit_retry_escalation_final(
                    command: command,
                    env: level.env,
                    exhausted: exhausted,
                    medium: medium
                  )
                false =>
                  bind_outcome(
                    o: orch_emit_retry_escalation_tail(
                      command: command,
                      levels: rest,
                      exhausted: exhausted,
                      medium: medium
                    ),
                    f: fn(inner) {
                      orch_emit_retry_escalation_step_for_level(
                        command: command,
                        level: level,
                        grep_pat: grep_pat,
                        inner: inner,
                        exhausted: exhausted,
                        medium: medium
                      )
                    }
                  )
              }
          }
        _ =>
          outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level2_not_logmatches))
      }
  }
}

fn orch_emit_retry_multilevel(
  command: String,
  level1: EscalationLevel,
  rest: List<EscalationLevel>,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match level1.detect {
    LogMatches { source: _, pattern: grep_pat1 } =>
      bind_outcome(
        o: orch_emit_retry_run(command: command, env: [], medium: medium),
        f: fn(m1) {
          bind_outcome(
            o: orch_emit_retry_escalation_tail(
              command: command,
              levels: rest,
              exhausted: exhausted,
              medium: medium
            ),
            f: fn(tail) {
              orch_emit_from_registry(
                medium: medium,
                construct_tag: orch_construct_retry_1level,
                target: medium.realize_retry_1level(
                  m1.carried,
                  tail,
                  grep_pat1,
                  level1.warning.message,
                  exhausted
                )
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches))
  }
}

fn orch_emit_retry_levels(
  command: String,
  level1: EscalationLevel,
  level2: EscalationLevel,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match level1.detect {
    LogMatches { source: _, pattern: p1 } =>
      match level2.detect {
        LogMatches { source: _, pattern: p2 } =>
          orch_emit_retry_2level(
            command: command,
            pattern1: p1,
            pattern2: p2,
            warn1: level1.warning.message,
            warn2: level2.warning.message,
            env1: level1.env,
            env2: level2.env,
            exhausted: exhausted,
            medium: medium
          )
        _ => outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level2_not_logmatches))
      }
    _ => outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches))
  }
}

fn orch_emit_retry_dispatch(
  command: String,
  escalations: FreeMonoid<EscalationLevel>,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match list_head(xs: escalations) {
    HeadAbsent =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
    HeadFound { value: l1 } =>
      match list_tail(xs: escalations) {
        TailAbsent =>
          orch_emit_retry_1level(
            command: command,
            level: l1,
            exhausted: exhausted,
            medium: medium
          )
        TailFound { tail: rest } =>
          match is_empty(rest) {
            true =>
              orch_emit_retry_1level(
                command: command,
                level: l1,
                exhausted: exhausted,
                medium: medium
              )
            false =>
              match list_head(xs: rest) {
                HeadFound { value: l2 } =>
                  match list_tail(xs: rest) {
                    TailFound { tail: more } =>
                      match is_empty(more) {
                        true =>
                          orch_emit_retry_levels(
                            command: command,
                            level1: l1,
                            level2: l2,
                            exhausted: exhausted,
                            medium: medium
                          )
                        false =>
                          orch_emit_retry_multilevel(
                            command: command,
                            level1: l1,
                            rest: concat([l2], more),
                            exhausted: exhausted,
                            medium: medium
                          )
                      }
                    TailAbsent =>
                      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
                  }
                HeadAbsent =>
                  outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
              }
          }
      }
  }
}

fn orch_emit_retry(
  body: Pipeline,
  escalations: FreeMonoid<EscalationLevel>,
  on_exhausted: Pipeline,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match orch_retry_body_command(body: body) {
    Present { value: command } =>
      bind_outcome(
        o: orch_emit_pipeline(p: on_exhausted, medium: medium),
        f: fn(exhausted_medium) {
          orch_emit_retry_dispatch(
            command: command,
            escalations: escalations,
            exhausted: exhausted_medium.carried,
            medium: medium
          )
        }
      )
    Absent =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
  }
}

fn orch_emit_unsupported_step_diagnostics(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: orch_emit_unsupported_step_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn orch_emit_steps_from(
  head_str: String,
  rest: List<PipelineStep>,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match list_head(xs: rest) {
    HeadAbsent =>
      outcome_accepted(lossless_source(text: head_str))
    HeadFound { value: next } =>
      bind_outcome(
        o: orch_emit_step(s: next, medium: medium),
        f: fn(next_medium) {
          bind_outcome(
            o: orch_emit_join2(left: head_str, right: next_medium.carried, medium: medium),
            f: fn(joined) {
              match list_tail(xs: rest) {
                TailFound { tail: t } =>
                  orch_emit_steps_from(head_str: joined.carried, rest: t, medium: medium)
                TailAbsent => outcome_accepted(joined)
              }
            }
          )
        }
      )
  }
}

fn orch_emit_pipeline(
  p: Pipeline,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  match list_head(xs: p.steps) {
    HeadAbsent =>
      outcome_accepted(lossless_source(text: ""))
    HeadFound { value: first } =>
      bind_outcome(
        o: orch_emit_step(s: first, medium: medium),
        f: fn(first_medium) {
          match list_tail(xs: p.steps) {
            TailFound { tail: t } =>
              orch_emit_steps_from(
                head_str: first_medium.carried,
                rest: t,
                medium: medium
              )
            TailAbsent =>
              outcome_accepted(first_medium)
          }
        }
      )
  }
}
