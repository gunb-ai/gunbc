fn orch_emit_facts_lookup(key: Node) -> Optional<InferredFacts> {
  optional_absent()
}

data orch_emit_unsupported_step_anchor: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^orch_emit_unsupported_step } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

fn orch_emit_registry_emitted_root(
  medium: OrchestrationEmitMedium,
  construct_tag: Symbol
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(
      target: medium.authority,
      edge_name: ^target_model_edge_orchestration_emit
    ),
    f: fn(registry) {
      find_named_child(root: registry, name: construct_tag)
    }
  )
}

// THE PREPARED ROW FOR ONE CONSTRUCT, taken from the call that first demanded it.
//
// What this re-derives is exactly what the medium's rows already fixed (DESIGN §6b chain
// re-derivation): the registry resolve (one authority bundle walk plus one named-child find),
// the translate pass over the row (its only target reads are the projection-presence check,
// which is absent for every realize target these rows produce, and the grammar match against
// the target's translation rules -- both payload-independent), the serializer's second row
// selection, and the rules budget the measure walk re-counts. The payload spellings are read
// only later, at serialize time, by the per-call target.
fn orch_emit_prepare_row(
  medium: OrchestrationEmitMedium,
  construct_tag: Symbol,
  target: TargetModel
) -> Outcome<OrchEmitPreparedRow> {
  bind_outcome(
    o: orch_emit_registry_emitted_root(medium: medium, construct_tag: construct_tag),
    f: fn(emitted_root) {
      bind_outcome(
        o: translate(
          tree: InferredTree {
            root: emitted_root,
            facts: PartialFunction { lookup: orch_emit_facts_lookup }
          },
          target: target
        ),
        f: fn(translated) {
          bind_outcome(
            o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
            f: fn(rules) {
              bind_outcome(
                o: grammar_relation_row_for_emitted(rules: rules, emitted: translated),
                f: fn(selected_row) {
                  bind_outcome(
                    o: target_translation_rules_budget(target: target),
                    f: fn(rules_budget) {
                      outcome_accepted(OrchEmitPreparedRow {
                        translated: translated,
                        selected_row: selected_row,
                        rules_budget: rules_budget
                      })
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

// THE REGISTRY PAYS PER PLAN, NOT PER CALL. A hit serializes from the prepared row through
// target_serialize_source_from_selected_row -- the entry that keeps the recursion budget, the
// refusals and the generic nonterminal selection, and drops only the second row selection. A
// miss prepares from this call's own target (which carries the same grammar facts every later
// call will) and threads the grown plan back to the fold.
fn orch_emit_from_prepared(
  prepared: OrchEmitPrepared,
  medium: OrchestrationEmitMedium,
  construct_tag: Symbol,
  target: TargetModel
) -> Outcome<OrchEmitCarried> {
  match map_lookup(m: prepared.rows, key: construct_tag) {
    Present { value: row } =>
      bind_outcome(
        o: target_serialize_source_from_selected_row(
          target: target,
          emitted: row.translated,
          row: row.selected_row,
          rules_budget: row.rules_budget
        ),
        f: fn(m) { outcome_accepted(OrchEmitCarried { text: m.carried, prepared: prepared }) }
      )
    Absent =>
      bind_outcome(
        o: orch_emit_prepare_row(medium: medium, construct_tag: construct_tag, target: target),
        f: fn(row) {
          bind_outcome(
            o: target_serialize_source_from_selected_row(
              target: target,
              emitted: row.translated,
              row: row.selected_row,
              rules_budget: row.rules_budget
            ),
            f: fn(m) {
              outcome_accepted(OrchEmitCarried {
                text: m.carried,
                prepared: OrchEmitPrepared {
                  rows: map_insert(m: prepared.rows, key: construct_tag, value: row)
                }
              })
            }
          )
        }
      )
  }
}

data orch_emit_prepared_empty: OrchEmitPrepared = OrchEmitPrepared { rows: empty_map() }

// A spelling emitted outside the registry (the direct-row door: predicates, with_redir, capture,
// exit) carries the plan through unchanged -- it re-derives nothing the plan holds.
fn orch_emit_carried_from_spelling(
  o: Outcome<String>,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  bind_outcome(
    o: o,
    f: fn(text) { outcome_accepted(OrchEmitCarried { text: text, prepared: prepared }) }
  )
}

fn orch_emit_node_spelling(emitted_root: Node, target: TargetModel) -> Outcome<String> {
  bind_outcome(
    o: emit(
      tree: InferredTree {
        root: emitted_root,
        facts: PartialFunction { lookup: orch_emit_facts_lookup }
      },
      target: target
    ),
    f: fn(m) { outcome_accepted(m.carried) }
  )
}

data orch_shell_unquoted_path_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./-@"

// The empty path is refused by the Cons arm rather than by a length test: emptiness is the shape
// of the carrier here, not a number this function has to compute and compare.
//
// THE VARIANTS ARE QUALIFIED RATHER THAN IMPORTED, AND THAT IS NOT STYLE. Adding `Cons, Empty` to
// this module's std.algebra import changed what the BARE `Empty` denotes at `env: Empty` inside
// orch_emit_retry_1level and orch_emit_retry_2level -- two functions this change has no business
// touching -- and the namespace-wave-admission phase refused the head for exactly that:
// `AuthoredReferenceResolution binding ... base {} -> head {std.algebra}`, twice, unadjudicated.
// An import list reaches every bare occurrence in the module, not the lines its author wrote.
// Qualifying here confines the new reference to the arm that needs it and leaves those two
// occurrences binding what they bound before. Re-adding the import re-opens both deltas.
fn orch_shell_unquoted_path_ok(path: String) -> Bool {
  match path {
    std.algebra.Empty => false
    std.algebra.Cons { head: _, tail: _ } =>
      string_all_chars_in(s: path, alphabet: orch_shell_unquoted_path_alphabet)
  }
}

// The redirect suffix is emitted through the same door as every row: the redir rows' grammar
// (emitted row + target model), via the direct-row door the with_redir and capture paths use.
// The match chooses WHICH row the spec names; the bytes come from the row, not from a parallel
// string table. ToFile keeps its shell-safety gate ahead of the row's path binding.
fn orch_emit_redir_suffix(r: RedirectSpec) -> Outcome<String> {
  match r {
    DiscardAll =>
      orch_emit_node_spelling(
        emitted_root: bash_redir_stdout_and_stderr_null_emitted,
        target: bash_redir_stdout_and_stderr_null_target_model()
      )
    DiscardErr =>
      orch_emit_node_spelling(
        emitted_root: bash_redir_stderr_null_emitted,
        target: bash_redir_stderr_null_target_model()
      )
    DiscardOut =>
      orch_emit_node_spelling(
        emitted_root: bash_redir_stdout_null_emitted,
        target: bash_redir_stdout_null_target_model()
      )
    StdoutAndStderr =>
      orch_emit_node_spelling(
        emitted_root: bash_redir_stdout_to_stderr_emitted,
        target: bash_redir_stdout_to_stderr_target_model()
      )
    ToFile { path: p } =>
      if !orch_shell_unquoted_path_ok(path: p) {
        outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_to_file_path_invalid))
      } else {
        orch_emit_node_spelling(
          emitted_root: bash_redir_to_file_emitted,
          target: bash_redir_to_file_target_model(path: p)
        )
      }
  }
}

fn orch_emit_run_core(
  r: Run,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match list_head(xs: r.env) {
    HeadAbsent =>
      orch_emit_from_prepared(
        prepared: prepared,
        medium: medium,
        construct_tag: orch_construct_run_rawline,
        target: medium.realize_run_rawline(r.command)
      )
    HeadFound { value: _ } =>
      orch_emit_run_from_plan(plan: medium.run_env_plan(r), medium: medium, prepared: prepared)
  }
}

fn orch_emit_run_with_redir(stmt: String, redir: RedirectSpec) -> Outcome<String> {
  bind_outcome(
    o: orch_emit_redir_suffix(r: redir),
    f: fn(suffix) {
      orch_emit_node_spelling(
        emitted_root: bash_stmt_with_redir_emitted,
        target: bash_stmt_with_redir_target_model(stmt: stmt, redir: suffix)
      )
    }
  )
}

// THE BINDER RULE WAS A BYTE-IDENTICAL FORK OF THE POSIX NAME RULE and is now read from its one
// home. This module carried orch_shell_ident_ok with its own two alphabet rows spelling exactly
// what extdeps.posix.shell_command_language posix_name_start_alphabet and
// posix_name_continue_alphabet already spelled; that module's own annotation states the rule lives
// there and is read at each site rather than respelled, and v2.extdeps.languages.bash_orch_if and
// v2.workflow.effect_plan_bash_materialize already read it. `binder` renders bare in `name=$?`, so
// it is a POSIX name in exactly the sense XBD 3.235 defines -- the fork was a second name for one
// fact (DESIGN section 3), not a different rule.
fn orch_emit_exit_status_bind(
  stmt: String,
  binder: String,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  if !posix_name_ok(name: binder) {
    outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_exit_status_binder_invalid))
  } else {
    orch_emit_join2(left: stmt, right: concat(binder, "=$?"), medium: medium, prepared: prepared)
  }
}

fn orch_emit_apply_capture(
  stmt: String,
  capture: CaptureSpec,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match capture {
    IgnoreFail =>
      bind_outcome(
        o: bash_stmt_or_ignore_fail_target_model(stmt: stmt),
        f: fn(target) {
          bind_outcome(
            o: orch_emit_node_spelling(
              emitted_root: bash_stmt_or_ignore_fail_emitted,
              target: target
            ),
            f: fn(text) { outcome_accepted(OrchEmitCarried { text: text, prepared: prepared }) }
          )
        }
      )
    ExitStatus { binder: b } =>
      orch_emit_exit_status_bind(stmt: stmt, binder: b, medium: medium, prepared: prepared)
    TeeTo { log: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_run_capture_unsupported))
    CmdSubst =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_run_capture_unsupported))
  }
}

fn orch_emit_run_spelling(
  r: Run,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  bind_outcome(
    o: orch_emit_run_core(r: r, medium: medium, prepared: prepared),
    f: fn(core) {
      match r.redirect {
        Absent =>
          match r.capture {
            Absent => outcome_accepted(core)
            Present { value: cap } =>
              orch_emit_apply_capture(stmt: core.text, capture: cap, medium: medium, prepared: core.prepared)
          }
        Present { value: redir } =>
          bind_outcome(
            o: orch_emit_run_with_redir(stmt: core.text, redir: redir),
            f: fn(with_redir) {
              match r.capture {
                Absent =>
                  outcome_accepted(OrchEmitCarried { text: with_redir, prepared: core.prepared })
                Present { value: cap } =>
                  orch_emit_apply_capture(stmt: with_redir, capture: cap, medium: medium, prepared: core.prepared)
              }
            }
          )
      }
    }
  )
}

fn orch_emit_run(r: Run, medium: OrchestrationEmitMedium) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_run_spelling(r: r, medium: medium, prepared: orch_emit_prepared_empty),
    f: fn(c) { outcome_accepted(lossless_source(text: c.text)) }
  )
}

fn orch_emit_run_from_plan(
  plan: OrchRunEmitPlan,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  orch_emit_from_prepared(
    prepared: prepared,
    medium: medium,
    construct_tag: plan.construct_tag,
    target: plan.target
  )
}

fn orch_emit_join2(
  left: String,
  right: String,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  orch_emit_from_prepared(
    prepared: prepared,
    medium: medium,
    construct_tag: orch_construct_seq2,
    target: medium.realize_seq2(left, right)
  )
}

fn orch_emit_predicate(
  p: Predicate,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match p {
    ExitZero { run: r } =>
      orch_emit_run_spelling(r: r, medium: medium, prepared: prepared)
    StrEq { lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: bash_test_str_eq_target_model(lhs: lhs, rhs: rhs),
        f: fn(target) {
          orch_emit_carried_from_spelling(
            o: orch_emit_node_spelling(emitted_root: bash_test_str_eq_emitted, target: target),
            prepared: prepared
          )
        }
      )
    StrEmpty { operand: operand } =>
      bind_outcome(
        o: bash_test_str_empty_target_model(operand: operand),
        f: fn(target) {
          orch_emit_carried_from_spelling(
            o: orch_emit_node_spelling(emitted_root: bash_test_str_empty_emitted, target: target),
            prepared: prepared
          )
        }
      )
    StrNonempty { operand: operand } =>
      bind_outcome(
        o: bash_test_str_nonempty_target_model(operand: operand),
        f: fn(target) {
          orch_emit_carried_from_spelling(
            o: orch_emit_node_spelling(emitted_root: bash_test_str_nonempty_emitted, target: target),
            prepared: prepared
          )
        }
      )
    IntNe { lhs: lhs, rhs: rhs } =>
      if !orch_shell_test_operand_ok(operand: lhs) || !orch_shell_test_operand_ok(operand: rhs) {
        outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_int_ne_operand_invalid))
      } else {
        bind_outcome(
          o: bash_test_int_ne_target_model(lhs: lhs, rhs: rhs),
          f: fn(target) {
            orch_emit_carried_from_spelling(
              o: orch_emit_node_spelling(emitted_root: bash_test_int_ne_emitted, target: target),
              prepared: prepared
            )
          }
        )
      }
    LogMatches { source: source, pattern: pattern } =>
      bind_outcome(
        o: bash_log_matches_grep_target_model(
          pattern: concat("'", concat(pattern, "'")),
          source: source
        ),
        f: fn(target) {
          orch_emit_carried_from_spelling(
            o: orch_emit_node_spelling(emitted_root: bash_log_matches_grep_emitted, target: target),
            prepared: prepared
          )
        }
      )
    Not { inner: inner } =>
      bind_outcome(
        o: orch_emit_predicate(p: inner, medium: medium, prepared: prepared),
        f: fn(inner_carried) {
          orch_emit_carried_from_spelling(
            o: orch_emit_node_spelling(
              emitted_root: bash_stmt_negation_emitted,
              target: bash_stmt_negation_target_model(inner: inner_carried.text)
            ),
            prepared: inner_carried.prepared
          )
        }
      )
    And { lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: orch_emit_predicate(p: lhs, medium: medium, prepared: prepared),
        f: fn(left) {
          bind_outcome(
            o: orch_emit_predicate(p: rhs, medium: medium, prepared: left.prepared),
            f: fn(right) {
              orch_emit_carried_from_spelling(
                o: orch_emit_node_spelling(
                  emitted_root: bash_stmt_andor_emitted,
                  target: bash_stmt_andor_target_model(left: left.text, op: "&&", right: right.text)
                ),
                prepared: right.prepared
              )
            }
          )
        }
      )
    Or { lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: orch_emit_predicate(p: lhs, medium: medium, prepared: prepared),
        f: fn(left) {
          bind_outcome(
            o: orch_emit_predicate(p: rhs, medium: medium, prepared: left.prepared),
            f: fn(right) {
              orch_emit_carried_from_spelling(
                o: orch_emit_node_spelling(
                  emitted_root: bash_stmt_andor_emitted,
                  target: bash_stmt_andor_target_model(left: left.text, op: "||", right: right.text)
                ),
                prepared: right.prepared
              )
            }
          )
        }
      )
  }
}

fn orch_emit_call_args(args: List<String>) -> String {
  fold(args, init: "", f: fn(acc, a) {
    if acc == "" { a } else { concat(acc, concat(" ", a)) }
  })
}

fn orch_emit_cmdsubst_command_spelling(callee: String, args: List<String>) -> String {
  concat(callee, concat(" ", orch_emit_call_args(args: args)))
}

fn orch_emit_cmdsubst_word_spelling(callee: String, args: List<String>) -> String {
  concat("$(", concat(orch_emit_cmdsubst_command_spelling(callee: callee, args: args), ")"))
}

fn orch_emit_expr_spelling(e: Expr, medium: OrchestrationEmitMedium) -> Outcome<String> {
  match e {
    ExprLit { spelling: s } => outcome_accepted(s)
    ExprVarRef { name: n } => outcome_accepted(concat("$", n))
    ExprCmdSubst { callee: c, args: args } =>
      outcome_accepted(orch_emit_cmdsubst_word_spelling(callee: c, args: args))
  }
}

fn orch_emit_let_step(
  name: String,
  value: Expr,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match value {
    ExprCmdSubst { callee: c, args: args } =>
      orch_emit_from_prepared(
        prepared: prepared,
        medium: medium,
        construct_tag: orch_construct_cmdsubst_assign,
        target: medium.realize_cmdsubst_assign(
          name,
          orch_emit_cmdsubst_command_spelling(callee: c, args: args)
        )
      )
    _ =>
      bind_outcome(
        o: orch_emit_expr_spelling(e: value, medium: medium),
        f: fn(value_spelling) {
          orch_emit_from_prepared(
            prepared: prepared,
            medium: medium,
            construct_tag: orch_construct_let_assign,
            target: medium.realize_let_assign(name, value_spelling)
          )
        }
      )
  }
}

fn orch_emit_call_step(
  callee: String,
  args: List<String>,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  orch_emit_from_prepared(
    prepared: prepared,
    medium: medium,
    construct_tag: orch_construct_call,
    target: medium.realize_call(callee, orch_emit_call_args(args: args))
  )
}

fn orch_emit_procedure_prepared(
  proc: Procedure,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  bind_outcome(
    o: orch_emit_pipeline_prepared(p: proc.body, medium: medium, prepared: prepared),
    f: fn(body) {
      orch_emit_from_prepared(
        prepared: body.prepared,
        medium: medium,
        construct_tag: orch_construct_procedure,
        target: medium.realize_procedure(proc.name, body.text)
      )
    }
  )
}

fn orch_emit_procedure(
  proc: Procedure,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_procedure_prepared(proc: proc, medium: medium, prepared: orch_emit_prepared_empty),
    f: fn(c) { outcome_accepted(lossless_source(text: c.text)) }
  )
}

// bash_stmt_if_(else_)_tokens (bash_orch_if.dag / bash.dag) spell their then/else bodies with no
// newline tokens, so a body is inherently a single line. orch_emit_pipeline newline-joins every
// step of a multi-step then_/else_ Pipeline (orch_seq2) before this fn binds .carried into the row;
// a >1-step body glued into the single-line row is bash-valid (newline is an ordinary statement
// separator inside a then/else arm — verified, not a carriage bug) but byte-diverges from a
// block-formatted expectation. Multi-statement then_/else_ arms are legitimate orchestration intent
// (if-ladders), so the fix is a second, block-spelled row (bash_stmt_if_block_tokens /
// bash_stmt_if_else_block_tokens) selected when either arm needs it — never a refusal of the
// legitimate shape. Single- and zero-step arms keep the original inline row byte-for-byte
// (orch_pipeline_needs_block_body is false), so every existing consumer's emitted bytes are
// unchanged.

fn orch_pipeline_needs_block_body(then_: Pipeline, else_: Optional<Pipeline>) -> Bool {
  if length(xs: then_.steps) > 1 {
    true
  } else {
    match else_ {
      Absent => false
      Present { value: else_pipeline } => length(xs: else_pipeline.steps) > 1
    }
  }
}

// A Pipeline arm with zero steps emits "" (orch_emit_pipeline's HeadAbsent case); threaded raw into
// the if-body token slot that produces invalid bash ("if COND; then ; fi" -- then requires >=1
// command before the closing separator). orch_if_arm_body_or_noop substitutes the bash no-op ":"
// for an empty arm's body, uniformly across the inline and block dispatch and regardless of whether
// the OTHER arm is also empty -- see pipeline_steps_empty_arm_note (v2.std.orchestration) for why
// both-empty is real intent, not refused.

fn orch_if_arm_body_or_noop(carried: String) -> String {
  if carried == "" {
    ":"
  } else {
    carried
  }
}

fn orch_emit_if_step(
  cond: Predicate,
  then_: Pipeline,
  else_: Optional<Pipeline>,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  let block_body = orch_pipeline_needs_block_body(then_: then_, else_: else_)
  bind_outcome(
    o: orch_emit_predicate(p: cond, medium: medium, prepared: prepared),
    f: fn(cond_carried) {
      bind_outcome(
        o: orch_emit_pipeline_prepared(p: then_, medium: medium, prepared: cond_carried.prepared),
        f: fn(then_carried) {
          let then_body = orch_if_arm_body_or_noop(carried: then_carried.text)
          match else_ {
            Absent =>
              bind_outcome(
                o: if block_body {
                  medium.realize_if_block(cond_carried.text, then_body)
                } else {
                  medium.realize_if(cond_carried.text, then_body)
                },
                f: fn(target) {
                  orch_emit_from_prepared(
                    prepared: then_carried.prepared,
                    medium: medium,
                    construct_tag: if block_body { orch_construct_if_block } else { orch_construct_if },
                    target: target
                  )
                }
              )
            Present { value: else_pipeline } =>
              bind_outcome(
                o: orch_emit_pipeline_prepared(p: else_pipeline, medium: medium, prepared: then_carried.prepared),
                f: fn(else_carried) {
                  let else_body = orch_if_arm_body_or_noop(carried: else_carried.text)
                  bind_outcome(
                    o: if block_body {
                      medium.realize_if_else_block(
                        cond_carried.text,
                        then_body,
                        else_body
                      )
                    } else {
                      medium.realize_if_else(
                        cond_carried.text,
                        then_body,
                        else_body
                      )
                    },
                    f: fn(target) {
                      orch_emit_from_prepared(
                        prepared: else_carried.prepared,
                        medium: medium,
                        construct_tag: if block_body { orch_construct_if_else_block } else { orch_construct_if_else },
                        target: target
                      )
                    }
                  )
                }
              )
          }
        }
      )
    }
  )
}

fn orch_emit_while_step(
  cond: Predicate,
  body: Pipeline,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  bind_outcome(
    o: orch_emit_predicate(p: cond, medium: medium, prepared: prepared),
    f: fn(cond_carried) {
      bind_outcome(
        o: orch_emit_pipeline_prepared(p: body, medium: medium, prepared: cond_carried.prepared),
        f: fn(body_carried) {
          bind_outcome(
            o: medium.realize_while(cond_carried.text, body_carried.text),
            f: fn(target) {
              orch_emit_from_prepared(
                prepared: body_carried.prepared,
                medium: medium,
                construct_tag: orch_construct_while,
                target: target
              )
            }
          )
        }
      )
    }
  )
}

// A `#` comment ends at the first line break, so a comment carrying one would emit a second bash
// line outside the construct. The question is whether ANY character of the text is a line break --
// character membership in a two-character alphabet -- which the two substring searches this
// replaced asked twice, once per needle, each walking the whole text.
data orch_shell_line_break_alphabet: String = "\n\r"

data orch_shell_test_operand_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./-@$\"{}"

fn orch_shell_test_operand_ok(operand: String) -> Bool {
  match operand {
    std.algebra.Empty => false
    std.algebra.Cons { head: _, tail: _ } =>
      string_all_chars_in(s: operand, alphabet: orch_shell_test_operand_alphabet)
  }
}

fn orch_shell_exit_status_ok(status: String) -> Bool {
  orch_shell_test_operand_ok(operand: status)
}

fn orch_emit_exit_step(status: String) -> Outcome<extdeps.communication.medium.Medium<String>> {
  if !orch_shell_exit_status_ok(status: status) {
    outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_exit_status_operand_invalid))
  } else {
    bind_outcome(
      o: orch_emit_node_spelling(
        emitted_root: bash_stmt_exit_emitted,
        target: bash_stmt_exit_target_model(code: status)
      ),
      f: fn(spelling) { outcome_accepted(lossless_source(text: spelling)) }
    )
  }
}

// THE SINGLE-STEP DOOR. A caller emitting one step starts from the empty plan: the step's first
// registry demand prepares what it needs from its own target, so the cost is what the unprepared
// path paid -- no more, because nothing here is re-derived for a plan nobody shares.
fn orch_emit_step(s: PipelineStep, medium: OrchestrationEmitMedium) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_step_prepared(s: s, medium: medium, prepared: orch_emit_prepared_empty),
    f: fn(c) { outcome_accepted(lossless_source(text: c.text)) }
  )
}

fn orch_emit_step_prepared(
  s: PipelineStep,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match s {
    Do { run: r } => orch_emit_run_spelling(r: r, medium: medium, prepared: prepared)
    Comment { text: t } =>
      if string_any_char_in(s: t, alphabet: orch_shell_line_break_alphabet) {
        outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_comment_multiline_refused))
      } else {
        orch_emit_from_prepared(
          prepared: prepared,
          medium: medium,
          construct_tag: orch_construct_run_rawline,
          target: medium.realize_run_rawline(concat("# ", t))
        )
      }
    Exit { status: st } =>
      bind_outcome(
        o: orch_emit_exit_step(status: st),
        f: fn(m) { outcome_accepted(OrchEmitCarried { text: m.carried, prepared: prepared }) }
      )
    If { cond: c, then_: t, else_: e } =>
      orch_emit_if_step(cond: c, then_: t, else_: e, medium: medium, prepared: prepared)
    For { binder: _, over: _, body: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_step_for_unsupported))
    While { cond: c, body: b } =>
      orch_emit_while_step(cond: c, body: b, medium: medium, prepared: prepared)
    Retry { body: b, escalations: e, on_exhausted: x } =>
      orch_emit_retry(body: b, escalations: e, on_exhausted: x, medium: medium, prepared: prepared)
    Let { name: n, value: v } =>
      orch_emit_let_step(name: n, value: v, medium: medium, prepared: prepared)
    Call { callee: c, args: a } =>
      orch_emit_call_step(callee: c, args: a, medium: medium, prepared: prepared)
  }
}

data orch_retry_outer_log_var: String = "BUILD_LOG"

data orch_retry_nested_log_var: String = "RETRY_LOG"

// Retry bash templates hardcode tee/grep log vars (BUILD_LOG outer, RETRY_LOG nested).
// LogMatches.source is admitted only when it equals that template var — a changed source must
// refuse (^orch_emit_retry_log_source_mismatch), never silently emit the hardcoded name. 🟡
// dissolve-on: thread source into the grammar rows so the declared name is the emitted name.

fn orch_emit_retry_require_log_source(
  source: String,
  expected: String
) -> Outcome<String> {
  match source == expected {
    true => outcome_accepted(source)
    false =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_log_source_mismatch))
  }
}

fn orch_retry_step_run(s: PipelineStep) -> Outcome<Run> {
  match s {
    Do { run: r } => outcome_accepted(r)
    Comment { text: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    Exit { status: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    If { cond: _, then_: _, else_: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    For { binder: _, over: _, body: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    While { cond: _, body: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    Retry { body: _, escalations: _, on_exhausted: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    Let { name: _, value: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    Call { callee: _, args: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
  }
}

// orch_retry_body_command returns Outcome<Run>: multi-step bodies refuse
// (^orch_emit_retry_body_multi_step); empty/non-Do (incl. Comment/Exit) refuse
// (^orch_emit_retry_body_not_run); a single Do returns the Run intact so orch_emit_retry_run can
// refuse Present redirect/capture (^orch_emit_retry_redirect_present /
// ^orch_emit_retry_capture_present) rather than silently dropping them. orch_emit_retry refuses
// nonempty body Run.env (^orch_emit_retry_body_env_present) — the retry bash templates hardcode the
// first occurrence without body env, so a nonempty env must refuse, never silently drop.
// Tee/redirect semantics for retry live in the bash retry templates, not on the body Run.
// Supersedes the Optional<String> Absent conflation interim from PR2a.

fn orch_retry_body_command(body: Pipeline) -> Outcome<Run> {
  match list_head(xs: body.steps) {
    HeadAbsent =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    HeadFound { value: s } =>
      match list_tail(xs: body.steps) {
        TailFound { tail: rest } =>
          match is_empty(rest) {
            false =>
              outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_multi_step))
            true =>
              orch_retry_step_run(s: s)
          }
        TailAbsent =>
          orch_retry_step_run(s: s)
      }
  }
}

fn orch_emit_retry_run(
  command: String,
  env: FreeMonoid<EnvBinding>,
  redirect: Optional<RedirectSpec>,
  capture: Optional<CaptureSpec>,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match redirect {
    Present { value: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_redirect_present))
    Absent =>
      match capture {
        Present { value: _ } =>
          outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_capture_present))
        Absent =>
          orch_emit_run_spelling(
            r: Run { command: command, env: env, redirect: Absent, capture: Absent },
            medium: medium,
            prepared: prepared
          )
      }
  }
}

fn orch_emit_retry_2level(
  command: String,
  redirect: Optional<RedirectSpec>,
  capture: Optional<CaptureSpec>,
  pattern1: String,
  pattern2: String,
  warn1: String,
  warn2: String,
  env1: FreeMonoid<EnvBinding>,
  env2: FreeMonoid<EnvBinding>,
  exhausted: String,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  bind_outcome(
    o: orch_emit_retry_run(
      command: command,
      env: Empty,
      redirect: redirect,
      capture: capture,
      medium: medium,
      prepared: prepared
    ),
    f: fn(c1) {
      bind_outcome(
        o: orch_emit_retry_run(
          command: command,
          env: env1,
          redirect: redirect,
          capture: capture,
          medium: medium,
          prepared: c1.prepared
        ),
        f: fn(c2) {
          bind_outcome(
            o: orch_emit_retry_run(
              command: command,
              env: env2,
              redirect: redirect,
              capture: capture,
              medium: medium,
              prepared: c2.prepared
            ),
            f: fn(c3) {
              orch_emit_from_prepared(
                prepared: c3.prepared,
                medium: medium,
                construct_tag: orch_construct_retry,
                target: medium.realize_retry(
                  c1.text,
                  c2.text,
                  c3.text,
                  pattern1,
                  pattern2,
                  warn1,
                  warn2,
                  exhausted
                )
              )
            }
          )
        }
      )
    }
  )
}

fn orch_emit_retry_1level(
  command: String,
  redirect: Optional<RedirectSpec>,
  capture: Optional<CaptureSpec>,
  level: EscalationLevel,
  exhausted: String,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match level.detect {
    LogMatches { source: src, pattern: grep_pat } =>
      bind_outcome(
        o: orch_emit_retry_require_log_source(source: src, expected: orch_retry_outer_log_var),
        f: fn(_) {
          bind_outcome(
            o: orch_emit_retry_run(
              command: command,
              env: Empty,
              redirect: redirect,
              capture: capture,
              medium: medium,
              prepared: prepared
            ),
            f: fn(c1) {
              bind_outcome(
                o: orch_emit_retry_run(
                  command: command,
                  env: level.env,
                  redirect: redirect,
                  capture: capture,
                  medium: medium,
                  prepared: c1.prepared
                ),
                f: fn(c2) {
                  orch_emit_from_prepared(
                    prepared: c2.prepared,
                    medium: medium,
                    construct_tag: orch_construct_retry_1level,
                    target: medium.realize_retry_1level(
                      c1.text,
                      c2.text,
                      grep_pat,
                      level.warning.message,
                      exhausted
                    )
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches))
  }
}

// Three-or-more escalation levels previously reused realize_retry_1level and stuffed rest into occ2
// via escalation_tail — silently dropping level1.env (3level golden had E2=1 after w1, never E1=1)
// and the final level's LogMatches.pattern. Same DESIGN §5 class as the PR2b silent drops. Refuse
// (^orch_emit_retry_multilevel_unsupported) until a faithful N-level template threads each level's
// env with the next level's detect (as orch_emit_retry_2level does). 🟡 dissolve-on: that template +
// reclaim of escalation_step/final rows under a correct cross-level fold.

fn orch_emit_retry_multilevel(
  command: String,
  redirect: Optional<RedirectSpec>,
  capture: Optional<CaptureSpec>,
  level1: EscalationLevel,
  rest: List<EscalationLevel>,
  exhausted: String,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_multilevel_unsupported))
}

fn orch_emit_retry_levels(
  command: String,
  redirect: Optional<RedirectSpec>,
  capture: Optional<CaptureSpec>,
  level1: EscalationLevel,
  level2: EscalationLevel,
  exhausted: String,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match level1.detect {
    LogMatches { source: src1, pattern: p1 } =>
      bind_outcome(
        o: orch_emit_retry_require_log_source(source: src1, expected: orch_retry_outer_log_var),
        f: fn(_) {
          match level2.detect {
            LogMatches { source: src2, pattern: p2 } =>
              bind_outcome(
                o: orch_emit_retry_require_log_source(source: src2, expected: orch_retry_nested_log_var),
                f: fn(_) {
                  orch_emit_retry_2level(
                    command: command,
                    redirect: redirect,
                    capture: capture,
                    pattern1: p1,
                    pattern2: p2,
                    warn1: level1.warning.message,
                    warn2: level2.warning.message,
                    env1: level1.env,
                    env2: level2.env,
                    exhausted: exhausted,
                    medium: medium,
                    prepared: prepared
                  )
                }
              )
            _ =>
              outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level2_not_logmatches))
          }
        }
      )
    _ => outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches))
  }
}

fn orch_emit_retry_dispatch(
  command: String,
  redirect: Optional<RedirectSpec>,
  capture: Optional<CaptureSpec>,
  escalations: FreeMonoid<EscalationLevel>,
  exhausted: String,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match list_head(xs: escalations) {
    HeadAbsent =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
    HeadFound { value: l1 } =>
      match list_tail(xs: escalations) {
        TailAbsent =>
          orch_emit_retry_1level(
            command: command,
            redirect: redirect,
            capture: capture,
            level: l1,
            exhausted: exhausted,
            medium: medium,
            prepared: prepared
          )
        TailFound { tail: rest } =>
          match is_empty(rest) {
            true =>
              orch_emit_retry_1level(
                command: command,
                redirect: redirect,
                capture: capture,
                level: l1,
                exhausted: exhausted,
                medium: medium,
                prepared: prepared
              )
            false =>
              match list_head(xs: rest) {
                HeadFound { value: l2 } =>
                  match list_tail(xs: rest) {
                    TailFound { tail: more } =>
                      match is_empty(more) {
                        true =>
                          orch_emit_retry_levels(
                            command: command,
                            redirect: redirect,
                            capture: capture,
                            level1: l1,
                            level2: l2,
                            exhausted: exhausted,
                            medium: medium,
                            prepared: prepared
                          )
                        false =>
                          orch_emit_retry_multilevel(
                            command: command,
                            redirect: redirect,
                            capture: capture,
                            level1: l1,
                            rest: concat([l2], more),
                            exhausted: exhausted,
                            medium: medium,
                            prepared: prepared
                          )
                      }
                    TailAbsent =>
                      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
                  }
                HeadAbsent =>
                  outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
              }
          }
      }
  }
}

fn orch_emit_retry(
  body: Pipeline,
  escalations: FreeMonoid<EscalationLevel>,
  on_exhausted: Pipeline,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match orch_retry_body_command(body: body) {
    Accepted { value: body_run, diagnostics: _ } =>
      match is_empty(body_run.env) {
        false =>
          outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_env_present))
        true =>
          bind_outcome(
            o: orch_emit_pipeline_prepared(p: on_exhausted, medium: medium, prepared: prepared),
            f: fn(exhausted) {
              orch_emit_retry_dispatch(
                command: body_run.command,
                redirect: body_run.redirect,
                capture: body_run.capture,
                escalations: escalations,
                exhausted: exhausted.text,
                medium: medium,
                prepared: exhausted.prepared
              )
            }
          )
      }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn orch_emit_unsupported_step_diagnostics(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: orch_emit_unsupported_step_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// THE PRODUCTION FOLD. The plan threads through every step and every seq2 join: the first
// demand of a construct prepares its row once for the whole production, and every later step
// and join serializes from that row instead of re-deriving it.
fn orch_emit_steps_from_prepared(
  head: OrchEmitCarried,
  rest: List<PipelineStep>,
  medium: OrchestrationEmitMedium
) -> Outcome<OrchEmitCarried> {
  match list_head(xs: rest) {
    HeadAbsent => outcome_accepted(head)
    HeadFound { value: next } =>
      bind_outcome(
        o: orch_emit_step_prepared(s: next, medium: medium, prepared: head.prepared),
        f: fn(next_carried) {
          bind_outcome(
            o: orch_emit_join2(
              left: head.text,
              right: next_carried.text,
              medium: medium,
              prepared: next_carried.prepared
            ),
            f: fn(joined) {
              match list_tail(xs: rest) {
                TailFound { tail: t } =>
                  orch_emit_steps_from_prepared(head: joined, rest: t, medium: medium)
                TailAbsent => outcome_accepted(joined)
              }
            }
          )
        }
      )
  }
}

fn orch_emit_pipeline_prepared(
  p: Pipeline,
  medium: OrchestrationEmitMedium,
  prepared: OrchEmitPrepared
) -> Outcome<OrchEmitCarried> {
  match list_head(xs: p.steps) {
    HeadAbsent => outcome_accepted(OrchEmitCarried { text: "", prepared: prepared })
    HeadFound { value: first } =>
      bind_outcome(
        o: orch_emit_step_prepared(s: first, medium: medium, prepared: prepared),
        f: fn(first_carried) {
          match list_tail(xs: p.steps) {
            TailFound { tail: t } =>
              orch_emit_steps_from_prepared(
                head: first_carried,
                rest: t,
                medium: medium
              )
            TailAbsent => outcome_accepted(first_carried)
          }
        }
      )
  }
}

fn orch_emit_pipeline(
  p: Pipeline,
  medium: OrchestrationEmitMedium
) -> Outcome<extdeps.communication.medium.Medium<String>> {
  bind_outcome(
    o: orch_emit_pipeline_prepared(p: p, medium: medium, prepared: orch_emit_prepared_empty),
    f: fn(c) { outcome_accepted(lossless_source(text: c.text)) }
  )
}
