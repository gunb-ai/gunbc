module v2.compiler.emit_orchestration



fn orch_emit_facts_lookup(key: v2.std.node.Node) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.optional.optional_absent()
}

data orch_emit_unsupported_step_anchor: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^orch_emit_unsupported_step } },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

fn orch_emit_registry_emitted_root(
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium,
  construct_tag: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.translate.target_bundle_child(
      target: medium.authority,
      edge_name: ^target_model_edge_orchestration_emit
    ),
    f: fn(registry) {
      v2.std.node_query.find_named_child(root: registry, name: construct_tag)
    }
  )
}

fn orch_emit_from_registry(
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium,
  construct_tag: v2.std.node.Symbol,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: orch_emit_registry_emitted_root(medium: medium, construct_tag: construct_tag),
    f: fn(emitted_root) {
      v2.compiler.emit.emit(
        tree: v2.compiler.inferred_tree.InferredTree {
          root: emitted_root,
          facts: PartialFunction { lookup: orch_emit_facts_lookup }
        },
        target: target
      )
    }
  )
}

fn orch_emit_node_spelling(emitted_root: v2.std.node.Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.emit.emit(
      tree: v2.compiler.inferred_tree.InferredTree {
        root: emitted_root,
        facts: PartialFunction { lookup: orch_emit_facts_lookup }
      },
      target: target
    ),
    f: fn(m) { v2.std.diagnostic.outcome_accepted(m.carried) }
  )
}

data orch_shell_unquoted_path_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./-@"

fn orch_shell_unquoted_path_char_ok(ch: String) -> Bool {
  string_length(s: ch) == 1 && string_contains(s: orch_shell_unquoted_path_alphabet, pattern: ch)
}

fn orch_shell_unquoted_path_ok_at(path: String, i: Int, n: Int) -> Bool {
  if i >= n {
    true
  } else {
    let ch = char_at(s: path, pos: i)
    if !orch_shell_unquoted_path_char_ok(ch: ch) {
      false
    } else {
      orch_shell_unquoted_path_ok_at(path: path, i: i + 1, n: n)
    }
  }
}

fn orch_shell_unquoted_path_ok(path: String) -> Bool {
  let n = string_length(s: path)
  if n == 0 {
    false
  } else {
    orch_shell_unquoted_path_ok_at(path: path, i: 0, n: n)
  }
}

fn orch_emit_redir_suffix(r: v2.std.orchestration.RedirectSpec) -> v2.std.diagnostic.Outcome<String> {
  match r {
    v2.std.orchestration.DiscardAll => v2.std.diagnostic.outcome_accepted(v2.extdeps.languages.bash.bash_redir_stdout_and_stderr_null_source_text)
    v2.std.orchestration.DiscardErr => v2.std.diagnostic.outcome_accepted(v2.extdeps.languages.bash.bash_redir_stderr_null_source_text)
    v2.std.orchestration.DiscardOut => v2.std.diagnostic.outcome_accepted(v2.extdeps.languages.bash.bash_redir_stdout_null_source_text)
    v2.std.orchestration.StdoutAndStderr => v2.std.diagnostic.outcome_accepted(v2.extdeps.languages.bash.bash_redir_stdout_to_stderr_source_text)
    v2.std.orchestration.ToFile { path: p } =>
      if !orch_shell_unquoted_path_ok(path: p) {
        v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_to_file_path_invalid))
      } else {
        v2.std.diagnostic.outcome_accepted(v2.extdeps.languages.bash.bash_redir_to_file_source_text(path: p))
      }
  }
}

fn orch_emit_run_core(r: v2.std.orchestration.Run, medium: v2.std.orchestration_emit.OrchestrationEmitMedium) -> v2.std.diagnostic.Outcome<String> {
  match v2.std.algebra.list_head(xs: r.env) {
    v2.std.algebra.HeadAbsent =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_from_registry(
          medium: medium,
          construct_tag: v2.std.orchestration_emit.orch_construct_run_rawline,
          target: medium.realize_run_rawline(r.command)
        ),
        f: fn(m) { v2.std.diagnostic.outcome_accepted(m.carried) }
      )
    v2.std.algebra.HeadFound { value: _ } =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_run_from_plan(plan: medium.run_env_plan(r), medium: medium),
        f: fn(m) { v2.std.diagnostic.outcome_accepted(m.carried) }
      )
  }
}

fn orch_emit_run_with_redir(stmt: String, redir: v2.std.orchestration.RedirectSpec) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: orch_emit_redir_suffix(r: redir),
    f: fn(suffix) {
      orch_emit_node_spelling(
        emitted_root: v2.extdeps.languages.bash.bash_stmt_with_redir_emitted,
        target: v2.extdeps.languages.bash.bash_stmt_with_redir_target_model(stmt: stmt, redir: suffix)
      )
    }
  )
}

data orch_shell_ident_start_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"

data orch_shell_ident_continue_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789"

fn orch_shell_ident_start_char_ok(ch: String) -> Bool {
  string_length(s: ch) == 1 && string_contains(s: orch_shell_ident_start_alphabet, pattern: ch)
}

fn orch_shell_ident_continue_char_ok(ch: String) -> Bool {
  string_length(s: ch) == 1 && string_contains(s: orch_shell_ident_continue_alphabet, pattern: ch)
}

fn orch_shell_ident_ok_at(binder: String, i: Int, n: Int) -> Bool {
  if i >= n {
    true
  } else {
    let ch = char_at(s: binder, pos: i)
    let ok = if i == 0 {
      orch_shell_ident_start_char_ok(ch: ch)
    } else {
      orch_shell_ident_continue_char_ok(ch: ch)
    }
    if !ok {
      false
    } else {
      orch_shell_ident_ok_at(binder: binder, i: i + 1, n: n)
    }
  }
}

fn orch_shell_ident_ok(binder: String) -> Bool {
  let n = string_length(s: binder)
  if n == 0 {
    false
  } else {
    orch_shell_ident_ok_at(binder: binder, i: 0, n: n)
  }
}

fn orch_emit_exit_status_bind(stmt: String, binder: String, medium: v2.std.orchestration_emit.OrchestrationEmitMedium) -> v2.std.diagnostic.Outcome<String> {
  if !orch_shell_ident_ok(binder: binder) {
    v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_exit_status_binder_invalid))
  } else {
    v2.std.diagnostic.bind_outcome(
      o: orch_emit_join2(left: stmt, right: concat(binder, "=$?"), medium: medium),
      f: fn(m) { v2.std.diagnostic.outcome_accepted(m.carried) }
    )
  }
}

fn orch_emit_apply_capture(stmt: String, capture: v2.std.orchestration.CaptureSpec, medium: v2.std.orchestration_emit.OrchestrationEmitMedium) -> v2.std.diagnostic.Outcome<String> {
  match capture {
    v2.std.orchestration.IgnoreFail =>
      v2.std.diagnostic.bind_outcome(
        o: v2.extdeps.languages.bash_orch_if.bash_stmt_or_ignore_fail_target_model(stmt: stmt),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: v2.extdeps.languages.bash_orch_if.bash_stmt_or_ignore_fail_emitted,
            target: target
          )
        }
      )
    v2.std.orchestration.ExitStatus { binder: b } =>
      orch_emit_exit_status_bind(stmt: stmt, binder: b, medium: medium)
    v2.std.orchestration.TeeTo { log: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_run_capture_unsupported))
    v2.std.orchestration.CmdSubst =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_run_capture_unsupported))
  }
}

fn orch_emit_run_spelling(r: v2.std.orchestration.Run, medium: v2.std.orchestration_emit.OrchestrationEmitMedium) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: orch_emit_run_core(r: r, medium: medium),
    f: fn(core) {
      match r.redirect {
        v2.std.optional.Absent =>
          match r.capture {
            v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(core)
            v2.std.optional.Present { value: cap } =>
              orch_emit_apply_capture(stmt: core, capture: cap, medium: medium)
          }
        v2.std.optional.Present { value: redir } =>
          v2.std.diagnostic.bind_outcome(
            o: orch_emit_run_with_redir(stmt: core, redir: redir),
            f: fn(with_redir) {
              match r.capture {
                v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(with_redir)
                v2.std.optional.Present { value: cap } =>
                  orch_emit_apply_capture(stmt: with_redir, capture: cap, medium: medium)
              }
            }
          )
      }
    }
  )
}

fn orch_emit_run(r: v2.std.orchestration.Run, medium: v2.std.orchestration_emit.OrchestrationEmitMedium) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: orch_emit_run_spelling(r: r, medium: medium),
    f: fn(spelling) { v2.std.diagnostic.outcome_accepted(v2.compiler.target_carriers.lossless_source(text: spelling)) }
  )
}

fn orch_emit_run_from_plan(
  plan: v2.std.orchestration_emit.OrchRunEmitPlan,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: plan.construct_tag,
    target: plan.target
  )
}

fn orch_emit_join2(
  left: String,
  right: String,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: v2.std.orchestration_emit.orch_construct_seq2,
    target: medium.realize_seq2(left, right)
  )
}

fn orch_emit_predicate(p: v2.std.orchestration.Predicate, medium: v2.std.orchestration_emit.OrchestrationEmitMedium) -> v2.std.diagnostic.Outcome<String> {
  match p {
    v2.std.orchestration.ExitZero { run: r } =>
      orch_emit_run_spelling(r: r, medium: medium)
    v2.std.orchestration.StrEq { lhs: lhs, rhs: rhs } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.extdeps.languages.bash_orch_if.bash_test_str_eq_target_model(lhs: lhs, rhs: rhs),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: v2.extdeps.languages.bash_orch_if.bash_test_str_eq_emitted,
            target: target
          )
        }
      )
    v2.std.orchestration.StrEmpty { operand: operand } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.extdeps.languages.bash_orch_if.bash_test_str_empty_target_model(operand: operand),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: v2.extdeps.languages.bash_orch_if.bash_test_str_empty_emitted,
            target: target
          )
        }
      )
    v2.std.orchestration.StrNonempty { operand: operand } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.extdeps.languages.bash_orch_if.bash_test_str_nonempty_target_model(operand: operand),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: v2.extdeps.languages.bash_orch_if.bash_test_str_nonempty_emitted,
            target: target
          )
        }
      )
    v2.std.orchestration.IntNe { lhs: lhs, rhs: rhs } =>
      if !orch_shell_test_operand_ok(operand: lhs) || !orch_shell_test_operand_ok(operand: rhs) {
        v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_int_ne_operand_invalid))
      } else {
        v2.std.diagnostic.bind_outcome(
          o: v2.extdeps.languages.bash_orch_if.bash_test_int_ne_target_model(lhs: lhs, rhs: rhs),
          f: fn(target) {
            orch_emit_node_spelling(
              emitted_root: v2.extdeps.languages.bash_orch_if.bash_test_int_ne_emitted,
              target: target
            )
          }
        )
      }
    v2.std.orchestration.LogMatches { source: source, pattern: pattern } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.extdeps.languages.bash_orch_if.bash_log_matches_grep_target_model(
          pattern: concat("'", concat(pattern, "'")),
          source: source
        ),
        f: fn(target) {
          orch_emit_node_spelling(
            emitted_root: v2.extdeps.languages.bash_orch_if.bash_log_matches_grep_emitted,
            target: target
          )
        }
      )
    v2.std.orchestration.Not { inner: inner } =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_predicate(p: inner, medium: medium),
        f: fn(spelling) {
          orch_emit_node_spelling(
            emitted_root: v2.extdeps.languages.bash.bash_stmt_negation_emitted,
            target: v2.extdeps.languages.bash.bash_stmt_negation_target_model(inner: spelling)
          )
        }
      )
    v2.std.orchestration.And { lhs: lhs, rhs: rhs } =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_predicate(p: lhs, medium: medium),
        f: fn(left) {
          v2.std.diagnostic.bind_outcome(
            o: orch_emit_predicate(p: rhs, medium: medium),
            f: fn(right) {
              orch_emit_node_spelling(
                emitted_root: v2.extdeps.languages.bash.bash_stmt_andor_emitted,
                target: v2.extdeps.languages.bash.bash_stmt_andor_target_model(left: left, op: "&&", right: right)
              )
            }
          )
        }
      )
    v2.std.orchestration.Or { lhs: lhs, rhs: rhs } =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_predicate(p: lhs, medium: medium),
        f: fn(left) {
          v2.std.diagnostic.bind_outcome(
            o: orch_emit_predicate(p: rhs, medium: medium),
            f: fn(right) {
              orch_emit_node_spelling(
                emitted_root: v2.extdeps.languages.bash.bash_stmt_andor_emitted,
                target: v2.extdeps.languages.bash.bash_stmt_andor_target_model(left: left, op: "||", right: right)
              )
            }
          )
        }
      )
  }
}

fn orch_emit_call_args(args: List<String>) -> String {
  fold(args, init: "", f: fn(acc, a) {
    if acc == "" { a } else { concat(acc, concat(" ", a)) }
  })
}

fn orch_emit_cmdsubst_command_spelling(callee: String, args: List<String>) -> String {
  concat(callee, concat(" ", orch_emit_call_args(args: args)))
}

fn orch_emit_cmdsubst_word_spelling(callee: String, args: List<String>) -> String {
  concat("$(", concat(orch_emit_cmdsubst_command_spelling(callee: callee, args: args), ")"))
}

fn orch_emit_expr_spelling(e: v2.std.orchestration.Expr, medium: v2.std.orchestration_emit.OrchestrationEmitMedium) -> v2.std.diagnostic.Outcome<String> {
  match e {
    v2.std.orchestration.ExprLit { spelling: s } => v2.std.diagnostic.outcome_accepted(s)
    v2.std.orchestration.ExprVarRef { name: n } => v2.std.diagnostic.outcome_accepted(concat("$", n))
    v2.std.orchestration.ExprCmdSubst { callee: c, args: args } =>
      v2.std.diagnostic.outcome_accepted(orch_emit_cmdsubst_word_spelling(callee: c, args: args))
  }
}

fn orch_emit_let_step(
  name: String,
  value: v2.std.orchestration.Expr,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match value {
    v2.std.orchestration.ExprCmdSubst { callee: c, args: args } =>
      orch_emit_from_registry(
        medium: medium,
        construct_tag: v2.std.orchestration_emit.orch_construct_cmdsubst_assign,
        target: medium.realize_cmdsubst_assign(
          name,
          orch_emit_cmdsubst_command_spelling(callee: c, args: args)
        )
      )
    _ =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_expr_spelling(e: value, medium: medium),
        f: fn(value_spelling) {
          orch_emit_from_registry(
            medium: medium,
            construct_tag: v2.std.orchestration_emit.orch_construct_let_assign,
            target: medium.realize_let_assign(name, value_spelling)
          )
        }
      )
  }
}

fn orch_emit_call_step(
  callee: String,
  args: List<String>,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: v2.std.orchestration_emit.orch_construct_call,
    target: medium.realize_call(callee, orch_emit_call_args(args: args))
  )
}

fn orch_emit_procedure(
  proc: v2.std.orchestration.Procedure,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: orch_emit_pipeline(p: proc.body, medium: medium),
    f: fn(body_medium) {
      orch_emit_from_registry(
        medium: medium,
        construct_tag: v2.std.orchestration_emit.orch_construct_procedure,
        target: medium.realize_procedure(proc.name, body_medium.carried)
      )
    }
  )
}

data orch_if_block_form_note: String = "bash_stmt_if_(else_)_tokens (bash_orch_if.dag / bash.dag) spell their then/else bodies with no newline tokens, so a body is inherently a single line. orch_emit_pipeline newline-joins every step of a multi-step then_/else_ Pipeline (orch_seq2) before this fn binds .carried into the row; a >1-step body glued into the single-line row is bash-valid (newline is an ordinary statement separator inside a then/else arm — verified, not a carriage bug) but byte-diverges from a block-formatted expectation. Multi-statement then_/else_ arms are legitimate orchestration intent (if-ladders), so the fix is a second, block-spelled row (bash_stmt_if_block_tokens / bash_stmt_if_else_block_tokens) selected when either arm needs it — never a refusal of the legitimate shape. Single- and zero-step arms keep the original inline row byte-for-byte (orch_pipeline_needs_block_body is false), so every existing consumer's emitted bytes are unchanged."

fn orch_pipeline_needs_block_body(then_: v2.std.orchestration.Pipeline, else_: v2.std.optional.Optional<v2.std.orchestration.Pipeline>) -> Bool {
  if v2.std.algebra.length(xs: then_.steps) > 1 {
    true
  } else {
    match else_ {
      v2.std.optional.Absent => false
      v2.std.optional.Present { value: else_pipeline } => v2.std.algebra.length(xs: else_pipeline.steps) > 1
    }
  }
}

data orch_if_empty_arm_note: String = "A Pipeline arm with zero steps emits \"\" (orch_emit_pipeline's HeadAbsent case); threaded raw into the if-body token slot that produces invalid bash (\"if COND; then ; fi\" -- then requires >=1 command before the closing separator). orch_if_arm_body_or_noop substitutes the bash no-op \":\" for an empty arm's body, uniformly across the inline and block dispatch and regardless of whether the OTHER arm is also empty -- see pipeline_steps_empty_arm_note (v2.std.orchestration) for why both-empty is real intent, not refused."

fn orch_if_arm_body_or_noop(carried: String) -> String {
  if carried == "" {
    ":"
  } else {
    carried
  }
}

fn orch_emit_if_step(
  cond: v2.std.orchestration.Predicate,
  then_: v2.std.orchestration.Pipeline,
  else_: v2.std.optional.Optional<v2.std.orchestration.Pipeline>,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  let block_body = orch_pipeline_needs_block_body(then_: then_, else_: else_)
  v2.std.diagnostic.bind_outcome(
    o: orch_emit_predicate(p: cond, medium: medium),
    f: fn(cond_spelling) {
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_pipeline(p: then_, medium: medium),
        f: fn(then_medium) {
          let then_body = orch_if_arm_body_or_noop(carried: then_medium.carried)
          match else_ {
            v2.std.optional.Absent =>
              v2.std.diagnostic.bind_outcome(
                o: if block_body {
                  medium.realize_if_block(cond_spelling, then_body)
                } else {
                  medium.realize_if(cond_spelling, then_body)
                },
                f: fn(target) {
                  orch_emit_from_registry(
                    medium: medium,
                    construct_tag: if block_body { v2.std.orchestration_emit.orch_construct_if_block } else { v2.std.orchestration_emit.orch_construct_if },
                    target: target
                  )
                }
              )
            v2.std.optional.Present { value: else_pipeline } =>
              v2.std.diagnostic.bind_outcome(
                o: orch_emit_pipeline(p: else_pipeline, medium: medium),
                f: fn(else_medium) {
                  let else_body = orch_if_arm_body_or_noop(carried: else_medium.carried)
                  v2.std.diagnostic.bind_outcome(
                    o: if block_body {
                      medium.realize_if_else_block(
                        cond_spelling,
                        then_body,
                        else_body
                      )
                    } else {
                      medium.realize_if_else(
                        cond_spelling,
                        then_body,
                        else_body
                      )
                    },
                    f: fn(target) {
                      orch_emit_from_registry(
                        medium: medium,
                        construct_tag: if block_body { v2.std.orchestration_emit.orch_construct_if_else_block } else { v2.std.orchestration_emit.orch_construct_if_else },
                        target: target
                      )
                    }
                  )
                }
              )
          }
        }
      )
    }
  )
}

fn orch_emit_while_step(
  cond: v2.std.orchestration.Predicate,
  body: v2.std.orchestration.Pipeline,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: orch_emit_predicate(p: cond, medium: medium),
    f: fn(cond_spelling) {
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_pipeline(p: body, medium: medium),
        f: fn(body_medium) {
          v2.std.diagnostic.bind_outcome(
            o: medium.realize_while(cond_spelling, body_medium.carried),
            f: fn(target) {
              orch_emit_from_registry(
                medium: medium,
                construct_tag: v2.std.orchestration_emit.orch_construct_while,
                target: target
              )
            }
          )
        }
      )
    }
  )
}

data orch_shell_test_operand_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./-@$\"{}"

fn orch_shell_test_operand_char_ok(ch: String) -> Bool {
  string_length(s: ch) == 1 && string_contains(s: orch_shell_test_operand_alphabet, pattern: ch)
}

fn orch_shell_test_operand_ok_at(operand: String, i: Int, n: Int) -> Bool {
  if i >= n {
    true
  } else {
    let ch = char_at(s: operand, pos: i)
    if !orch_shell_test_operand_char_ok(ch: ch) {
      false
    } else {
      orch_shell_test_operand_ok_at(operand: operand, i: i + 1, n: n)
    }
  }
}

fn orch_shell_test_operand_ok(operand: String) -> Bool {
  let n = string_length(s: operand)
  if n == 0 {
    false
  } else {
    orch_shell_test_operand_ok_at(operand: operand, i: 0, n: n)
  }
}

fn orch_shell_exit_status_ok(status: String) -> Bool {
  orch_shell_test_operand_ok(operand: status)
}

fn orch_emit_exit_step(status: String) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  if !orch_shell_exit_status_ok(status: status) {
    v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_exit_status_operand_invalid))
  } else {
    v2.std.diagnostic.bind_outcome(
      o: orch_emit_node_spelling(
        emitted_root: v2.extdeps.languages.bash.bash_stmt_exit_emitted,
        target: v2.extdeps.languages.bash.bash_stmt_exit_target_model(code: status)
      ),
      f: fn(spelling) { v2.std.diagnostic.outcome_accepted(v2.compiler.target_carriers.lossless_source(text: spelling)) }
    )
  }
}

fn orch_emit_step(s: v2.std.orchestration.PipelineStep, medium: v2.std.orchestration_emit.OrchestrationEmitMedium) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match s {
    v2.std.orchestration.Do { run: r } => orch_emit_run(r: r, medium: medium)
    v2.std.orchestration.Comment { text: t } =>
      if string_contains(s: t, pattern: "\n") || string_contains(s: t, pattern: "\r") {
        v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_comment_multiline_refused))
      } else {
        orch_emit_from_registry(
          medium: medium,
          construct_tag: v2.std.orchestration_emit.orch_construct_run_rawline,
          target: medium.realize_run_rawline(concat("# ", t))
        )
      }
    v2.std.orchestration.Exit { status: st } => orch_emit_exit_step(status: st)
    v2.std.orchestration.If { cond: c, then_: t, else_: e } =>
      orch_emit_if_step(cond: c, then_: t, else_: e, medium: medium)
    For { binder: _, over: _, body: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_step_for_unsupported))
    v2.std.orchestration.While { cond: c, body: b } =>
      orch_emit_while_step(cond: c, body: b, medium: medium)
    Retry { body: b, escalations: e, on_exhausted: x } =>
      orch_emit_retry(body: b, escalations: e, on_exhausted: x, medium: medium)
    v2.std.orchestration.Let { name: n, value: v } =>
      orch_emit_let_step(name: n, value: v, medium: medium)
    v2.std.orchestration.Call { callee: c, args: a } =>
      orch_emit_call_step(callee: c, args: a, medium: medium)
  }
}

data orch_retry_outer_log_var: String = "BUILD_LOG"

data orch_retry_nested_log_var: String = "RETRY_LOG"

data orch_retry_log_source_fidelity_note: String = "Retry bash templates hardcode tee/grep log vars (BUILD_LOG outer, RETRY_LOG nested). LogMatches.source is admitted only when it equals that template var — a changed source must refuse (^orch_emit_retry_log_source_mismatch), never silently emit the hardcoded name. 🟡 dissolve-on: thread source into the grammar rows so the declared name is the emitted name."

fn orch_emit_retry_require_log_source(
  source: String,
  expected: String
) -> v2.std.diagnostic.Outcome<String> {
  match source == expected {
    true => v2.std.diagnostic.outcome_accepted(source)
    false =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_log_source_mismatch))
  }
}

fn orch_retry_step_run(s: v2.std.orchestration.PipelineStep) -> v2.std.diagnostic.Outcome<v2.std.orchestration.Run> {
  match s {
    v2.std.orchestration.Do { run: r } => v2.std.diagnostic.outcome_accepted(r)
    v2.std.orchestration.Comment { text: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    v2.std.orchestration.Exit { status: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    v2.std.orchestration.If { cond: _, then_: _, else_: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    For { binder: _, over: _, body: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    v2.std.orchestration.While { cond: _, body: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    Retry { body: _, escalations: _, on_exhausted: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    v2.std.orchestration.Let { name: _, value: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    v2.std.orchestration.Call { callee: _, args: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
  }
}

data orch_retry_body_command_note: String = "orch_retry_body_command returns Outcome<Run>: multi-step bodies refuse (^orch_emit_retry_body_multi_step); empty/non-Do (incl. Comment/Exit) refuse (^orch_emit_retry_body_not_run); a single Do returns the Run intact so orch_emit_retry_run can refuse Present redirect/capture (^orch_emit_retry_redirect_present / ^orch_emit_retry_capture_present) rather than silently dropping them. orch_emit_retry refuses nonempty body Run.env (^orch_emit_retry_body_env_present) — the retry bash templates hardcode the first occurrence without body env, so a nonempty env must refuse, never silently drop. Tee/redirect semantics for retry live in the bash retry templates, not on the body Run. Supersedes the Optional<String> Absent conflation interim from PR2a."

fn orch_retry_body_command(body: v2.std.orchestration.Pipeline) -> v2.std.diagnostic.Outcome<v2.std.orchestration.Run> {
  match v2.std.algebra.list_head(xs: body.steps) {
    v2.std.algebra.HeadAbsent =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
    v2.std.algebra.HeadFound { value: s } =>
      match v2.std.algebra.list_tail(xs: body.steps) {
        v2.std.algebra.TailFound { tail: rest } =>
          match v2.std.algebra.is_empty(rest) {
            false =>
              v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_multi_step))
            true =>
              orch_retry_step_run(s: s)
          }
        v2.std.algebra.TailAbsent =>
          orch_retry_step_run(s: s)
      }
  }
}

fn orch_emit_retry_run(
  command: String,
  env: std.algebra.FreeMonoid<v2.std.orchestration.EnvBinding>,
  redirect: v2.std.optional.Optional<v2.std.orchestration.RedirectSpec>,
  capture: v2.std.optional.Optional<v2.std.orchestration.CaptureSpec>,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match redirect {
    v2.std.optional.Present { value: _ } =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_redirect_present))
    v2.std.optional.Absent =>
      match capture {
        v2.std.optional.Present { value: _ } =>
          v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_capture_present))
        v2.std.optional.Absent =>
          orch_emit_run(
            r: v2.std.orchestration.Run { command: command, env: env, redirect: v2.std.optional.Absent, capture: v2.std.optional.Absent },
            medium: medium
          )
      }
  }
}

fn orch_emit_retry_2level(
  command: String,
  redirect: v2.std.optional.Optional<v2.std.orchestration.RedirectSpec>,
  capture: v2.std.optional.Optional<v2.std.orchestration.CaptureSpec>,
  pattern1: String,
  pattern2: String,
  warn1: String,
  warn2: String,
  env1: std.algebra.FreeMonoid<v2.std.orchestration.EnvBinding>,
  env2: std.algebra.FreeMonoid<v2.std.orchestration.EnvBinding>,
  exhausted: String,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: orch_emit_retry_run(
      command: command,
      env: Empty,
      redirect: redirect,
      capture: capture,
      medium: medium
    ),
    f: fn(m1) {
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_retry_run(
          command: command,
          env: env1,
          redirect: redirect,
          capture: capture,
          medium: medium
        ),
        f: fn(m2) {
          v2.std.diagnostic.bind_outcome(
            o: orch_emit_retry_run(
              command: command,
              env: env2,
              redirect: redirect,
              capture: capture,
              medium: medium
            ),
            f: fn(m3) {
              orch_emit_from_registry(
                medium: medium,
                construct_tag: v2.std.orchestration_emit.orch_construct_retry,
                target: medium.realize_retry(
                  m1.carried,
                  m2.carried,
                  m3.carried,
                  pattern1,
                  pattern2,
                  warn1,
                  warn2,
                  exhausted
                )
              )
            }
          )
        }
      )
    }
  )
}

fn orch_emit_retry_1level(
  command: String,
  redirect: v2.std.optional.Optional<v2.std.orchestration.RedirectSpec>,
  capture: v2.std.optional.Optional<v2.std.orchestration.CaptureSpec>,
  level: v2.std.orchestration.EscalationLevel,
  exhausted: String,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match level.detect {
    v2.std.orchestration.LogMatches { source: src, pattern: grep_pat } =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_retry_require_log_source(source: src, expected: orch_retry_outer_log_var),
        f: fn(_) {
          v2.std.diagnostic.bind_outcome(
            o: orch_emit_retry_run(
              command: command,
              env: Empty,
              redirect: redirect,
              capture: capture,
              medium: medium
            ),
            f: fn(m1) {
              v2.std.diagnostic.bind_outcome(
                o: orch_emit_retry_run(
                  command: command,
                  env: level.env,
                  redirect: redirect,
                  capture: capture,
                  medium: medium
                ),
                f: fn(m2) {
                  orch_emit_from_registry(
                    medium: medium,
                    construct_tag: v2.std.orchestration_emit.orch_construct_retry_1level,
                    target: medium.realize_retry_1level(
                      m1.carried,
                      m2.carried,
                      grep_pat,
                      level.warning.message,
                      exhausted
                    )
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches))
  }
}

data orch_emit_retry_multilevel_unsupported_note: String = "Three-or-more escalation levels previously reused realize_retry_1level and stuffed rest into occ2 via escalation_tail — silently dropping level1.env (3level golden had E2=1 after w1, never E1=1) and the final level's LogMatches.pattern. Same DESIGN §5 class as the PR2b silent drops. Refuse (^orch_emit_retry_multilevel_unsupported) until a faithful N-level template threads each level's env with the next level's detect (as orch_emit_retry_2level does). 🟡 dissolve-on: that template + reclaim of escalation_step/final rows under a correct cross-level fold."

fn orch_emit_retry_multilevel(
  command: String,
  redirect: v2.std.optional.Optional<v2.std.orchestration.RedirectSpec>,
  capture: v2.std.optional.Optional<v2.std.orchestration.CaptureSpec>,
  level1: v2.std.orchestration.EscalationLevel,
  rest: List<v2.std.orchestration.EscalationLevel>,
  exhausted: String,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_multilevel_unsupported))
}

fn orch_emit_retry_levels(
  command: String,
  redirect: v2.std.optional.Optional<v2.std.orchestration.RedirectSpec>,
  capture: v2.std.optional.Optional<v2.std.orchestration.CaptureSpec>,
  level1: v2.std.orchestration.EscalationLevel,
  level2: v2.std.orchestration.EscalationLevel,
  exhausted: String,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match level1.detect {
    v2.std.orchestration.LogMatches { source: src1, pattern: p1 } =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_retry_require_log_source(source: src1, expected: orch_retry_outer_log_var),
        f: fn(_) {
          match level2.detect {
            v2.std.orchestration.LogMatches { source: src2, pattern: p2 } =>
              v2.std.diagnostic.bind_outcome(
                o: orch_emit_retry_require_log_source(source: src2, expected: orch_retry_nested_log_var),
                f: fn(_) {
                  orch_emit_retry_2level(
                    command: command,
                    redirect: redirect,
                    capture: capture,
                    pattern1: p1,
                    pattern2: p2,
                    warn1: level1.warning.message,
                    warn2: level2.warning.message,
                    env1: level1.env,
                    env2: level2.env,
                    exhausted: exhausted,
                    medium: medium
                  )
                }
              )
            _ =>
              v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level2_not_logmatches))
          }
        }
      )
    _ => v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches))
  }
}

fn orch_emit_retry_dispatch(
  command: String,
  redirect: v2.std.optional.Optional<v2.std.orchestration.RedirectSpec>,
  capture: v2.std.optional.Optional<v2.std.orchestration.CaptureSpec>,
  escalations: std.algebra.FreeMonoid<v2.std.orchestration.EscalationLevel>,
  exhausted: String,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match v2.std.algebra.list_head(xs: escalations) {
    v2.std.algebra.HeadAbsent =>
      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
    v2.std.algebra.HeadFound { value: l1 } =>
      match v2.std.algebra.list_tail(xs: escalations) {
        v2.std.algebra.TailAbsent =>
          orch_emit_retry_1level(
            command: command,
            redirect: redirect,
            capture: capture,
            level: l1,
            exhausted: exhausted,
            medium: medium
          )
        v2.std.algebra.TailFound { tail: rest } =>
          match v2.std.algebra.is_empty(rest) {
            true =>
              orch_emit_retry_1level(
                command: command,
                redirect: redirect,
                capture: capture,
                level: l1,
                exhausted: exhausted,
                medium: medium
              )
            false =>
              match v2.std.algebra.list_head(xs: rest) {
                v2.std.algebra.HeadFound { value: l2 } =>
                  match v2.std.algebra.list_tail(xs: rest) {
                    v2.std.algebra.TailFound { tail: more } =>
                      match v2.std.algebra.is_empty(more) {
                        true =>
                          orch_emit_retry_levels(
                            command: command,
                            redirect: redirect,
                            capture: capture,
                            level1: l1,
                            level2: l2,
                            exhausted: exhausted,
                            medium: medium
                          )
                        false =>
                          orch_emit_retry_multilevel(
                            command: command,
                            redirect: redirect,
                            capture: capture,
                            level1: l1,
                            rest: concat([l2], more),
                            exhausted: exhausted,
                            medium: medium
                          )
                      }
                    v2.std.algebra.TailAbsent =>
                      v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
                  }
                v2.std.algebra.HeadAbsent =>
                  v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
              }
          }
      }
  }
}

fn orch_emit_retry(
  body: v2.std.orchestration.Pipeline,
  escalations: std.algebra.FreeMonoid<v2.std.orchestration.EscalationLevel>,
  on_exhausted: v2.std.orchestration.Pipeline,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match orch_retry_body_command(body: body) {
    v2.std.diagnostic.Accepted { value: body_run, diagnostics: _ } =>
      match v2.std.algebra.is_empty(body_run.env) {
        false =>
          v2.std.diagnostic.outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_env_present))
        true =>
          v2.std.diagnostic.bind_outcome(
            o: orch_emit_pipeline(p: on_exhausted, medium: medium),
            f: fn(exhausted_medium) {
              orch_emit_retry_dispatch(
                command: body_run.command,
                redirect: body_run.redirect,
                capture: body_run.capture,
                escalations: escalations,
                exhausted: exhausted_medium.carried,
                medium: medium
              )
            }
          )
      }
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      v2.std.diagnostic.Rejected { diagnostics: d }
  }
}

fn orch_emit_unsupported_step_diagnostics(reason: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: orch_emit_unsupported_step_anchor),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn orch_emit_steps_from(
  head_str: String,
  rest: List<v2.std.orchestration.PipelineStep>,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match v2.std.algebra.list_head(xs: rest) {
    v2.std.algebra.HeadAbsent =>
      v2.std.diagnostic.outcome_accepted(v2.compiler.target_carriers.lossless_source(text: head_str))
    v2.std.algebra.HeadFound { value: next } =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_step(s: next, medium: medium),
        f: fn(next_medium) {
          v2.std.diagnostic.bind_outcome(
            o: orch_emit_join2(left: head_str, right: next_medium.carried, medium: medium),
            f: fn(joined) {
              match v2.std.algebra.list_tail(xs: rest) {
                v2.std.algebra.TailFound { tail: t } =>
                  orch_emit_steps_from(head_str: joined.carried, rest: t, medium: medium)
                v2.std.algebra.TailAbsent => v2.std.diagnostic.outcome_accepted(joined)
              }
            }
          )
        }
      )
  }
}

fn orch_emit_pipeline(
  p: v2.std.orchestration.Pipeline,
  medium: v2.std.orchestration_emit.OrchestrationEmitMedium
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  match v2.std.algebra.list_head(xs: p.steps) {
    v2.std.algebra.HeadAbsent =>
      v2.std.diagnostic.outcome_accepted(v2.compiler.target_carriers.lossless_source(text: ""))
    v2.std.algebra.HeadFound { value: first } =>
      v2.std.diagnostic.bind_outcome(
        o: orch_emit_step(s: first, medium: medium),
        f: fn(first_medium) {
          match v2.std.algebra.list_tail(xs: p.steps) {
            v2.std.algebra.TailFound { tail: t } =>
              orch_emit_steps_from(
                head_str: first_medium.carried,
                rest: t,
                medium: medium
              )
            v2.std.algebra.TailAbsent =>
              v2.std.diagnostic.outcome_accepted(first_medium)
          }
        }
      )
  }
}
