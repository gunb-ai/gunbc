module v2.compiler.emit_orchestration

import extdeps.communication.medium { Medium }
import v2.std.orchestration_emit {
  OrchestrationEmitHandlers,
  OrchestrationEmitRegistry,
  OrchestrationMedium,
  orchestration_emit_registry_lookup
}
import v2.std.orchestration {
  Run,
  Step,
  Do,
  Pipeline,
  EscalationLevel,
  LogMatches,
  EnvBinding
}
import v2.std.algebra { FreeMonoid, list_head, list_tail, HeadFound, HeadAbsent, TailFound, TailAbsent }
import v2.std.collection { List, Optional, Present, Absent }
import v2.compiler.target_carriers { lossless_source }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.node { Node, Symbol }

fn orch_emit_unsupported_medium_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^orch_emit_unsupported_medium,
    at: node_locus(node: ^orch_emit_unsupported_medium),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn orch_emit_handlers_for_medium(
  registry: OrchestrationEmitRegistry,
  medium: OrchestrationMedium
) -> Outcome<OrchestrationEmitHandlers> {
  match orchestration_emit_registry_lookup(registry: registry, medium: medium) {
    Present { value: handlers } => outcome_accepted(value: handlers)
    Absent => outcome_rejected(orch_emit_unsupported_medium_diagnostic())
  }
}

fn orch_emit_run_with_handlers(
  r: Run,
  handlers: OrchestrationEmitHandlers
) -> Outcome<Medium<String>> {
  match handlers {
    OrchestrationEmitHandlers { emit_run: emit_run, emit_join2: _, emit_retry_2level: _, unsupported_step_anchor: _ } =>
      emit_run(r: r)
  }
}

fn orch_emit_join2_with_handlers(
  left: String,
  right: String,
  handlers: OrchestrationEmitHandlers
) -> Outcome<Medium<String>> {
  match handlers {
    OrchestrationEmitHandlers { emit_run: _, emit_join2: emit_join2, emit_retry_2level: _, unsupported_step_anchor: _ } =>
      emit_join2(left: left, right: right)
  }
}

fn orch_emit_retry_2level_with_handlers(
  command: String,
  pattern1: String,
  pattern2: String,
  warn1: String,
  warn2: String,
  env1: FreeMonoid<EnvBinding>,
  env2: FreeMonoid<EnvBinding>,
  handlers: OrchestrationEmitHandlers
) -> Outcome<Medium<String>> {
  match handlers {
    OrchestrationEmitHandlers { emit_run: _, emit_join2: _, emit_retry_2level: emit_retry_2level, unsupported_step_anchor: _ } =>
      emit_retry_2level(
        command: command,
        pattern1: pattern1,
        pattern2: pattern2,
        warn1: warn1,
        warn2: warn2,
        env1: env1,
        env2: env2
      )
  }
}

fn orch_emit_unsupported_step_diagnostics(
  reason: Symbol,
  handlers: OrchestrationEmitHandlers
) -> Diagnostic {
  match handlers {
    OrchestrationEmitHandlers { emit_run: _, emit_join2: _, emit_retry_2level: _, unsupported_step_anchor: anchor } =>
      Diagnostic {
        reason: reason,
        at: node_locus(node: anchor),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
  }
}

fn orch_emit_step_with_handlers(
  s: Step,
  handlers: OrchestrationEmitHandlers
) -> Outcome<Medium<String>> {
  match s {
    Do { run: r } => orch_emit_run_with_handlers(r: r, handlers: handlers)
    If { cond: _, then_: _, else_: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_step_if_unsupported, handlers: handlers))
    For { binder: _, over: _, body: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_step_for_unsupported, handlers: handlers))
    While { cond: _, body: _, bound: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_step_while_unsupported, handlers: handlers))
    Retry { body: b, escalations: e, on_exhausted: _ } =>
      orch_emit_retry_with_handlers(body: b, escalations: e, handlers: handlers)
  }
}

fn orch_retry_step_command(s: Step) -> Optional<String> {
  match s {
    Do { run: r } => Present { value: r.command }
    If { cond: _, then_: _, else_: _ } => Absent
    For { binder: _, over: _, body: _ } => Absent
    While { cond: _, body: _, bound: _ } => Absent
    Retry { body: _, escalations: _, on_exhausted: _ } => Absent
  }
}

fn orch_retry_body_command(body: Pipeline) -> Optional<String> {
  match list_head(xs: body.steps) {
    HeadFound { value: s } => orch_retry_step_command(s: s)
    HeadAbsent => Absent
  }
}

fn orch_emit_retry_levels_with_handlers(
  command: String,
  level1: EscalationLevel,
  level2: EscalationLevel,
  handlers: OrchestrationEmitHandlers
) -> Outcome<Medium<String>> {
  match level1.detect {
    LogMatches { source: _, pattern: p1 } =>
      match level2.detect {
        LogMatches { source: _, pattern: p2 } =>
          orch_emit_retry_2level_with_handlers(
            command: command,
            pattern1: p1,
            pattern2: p2,
            warn1: level1.warning.message,
            warn2: level2.warning.message,
            env1: level1.env,
            env2: level2.env,
            handlers: handlers
          )
        _ =>
          outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level2_not_logmatches, handlers: handlers))
      }
    _ =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches, handlers: handlers))
  }
}

fn orch_emit_retry_with_handlers(
  body: Pipeline,
  escalations: FreeMonoid<EscalationLevel>,
  handlers: OrchestrationEmitHandlers
) -> Outcome<Medium<String>> {
  match orch_retry_body_command(body: body) {
    Present { value: command } =>
      match list_head(xs: escalations) {
        HeadFound { value: l1 } =>
          match list_tail(xs: escalations) {
            TailFound { tail: t } =>
              match list_head(xs: t) {
                HeadFound { value: l2 } =>
                  orch_emit_retry_levels_with_handlers(command: command, level1: l1, level2: l2, handlers: handlers)
                HeadAbsent =>
                  outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_needs_two_levels, handlers: handlers))
              }
            TailAbsent =>
              outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_needs_two_levels, handlers: handlers))
          }
        HeadAbsent =>
          outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations, handlers: handlers))
      }
    Absent =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run, handlers: handlers))
  }
}

fn orch_emit_steps_from_with_handlers(
  head_str: String,
  rest: List<Step>,
  handlers: OrchestrationEmitHandlers
) -> Outcome<Medium<String>> {
  match list_head(xs: rest) {
    HeadAbsent =>
      outcome_accepted(lossless_source(text: head_str))
    HeadFound { value: next } =>
      bind_outcome(
        o: orch_emit_step_with_handlers(s: next, handlers: handlers),
        f: fn(next_medium) {
          bind_outcome(
            o: orch_emit_join2_with_handlers(left: head_str, right: next_medium.carried, handlers: handlers),
            f: fn(joined) {
              match list_tail(xs: rest) {
                TailFound { tail: t } =>
                  orch_emit_steps_from_with_handlers(head_str: joined.carried, rest: t, handlers: handlers)
                TailAbsent => outcome_accepted(joined)
              }
            }
          )
        }
      )
  }
}

fn orch_emit_pipeline_with_handlers(
  p: Pipeline,
  handlers: OrchestrationEmitHandlers
) -> Outcome<Medium<String>> {
  match list_head(xs: p.steps) {
    HeadAbsent =>
      outcome_accepted(lossless_source(text: ""))
    HeadFound { value: first } =>
      bind_outcome(
        o: orch_emit_step_with_handlers(s: first, handlers: handlers),
        f: fn(first_medium) {
          match list_tail(xs: p.steps) {
            TailFound { tail: t } =>
              orch_emit_steps_from_with_handlers(head_str: first_medium.carried, rest: t, handlers: handlers)
            TailAbsent =>
              outcome_accepted(first_medium)
          }
        }
      )
  }
}

fn orch_emit_run_dispatch(
  r: Run,
  registry: OrchestrationEmitRegistry,
  medium: OrchestrationMedium
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: orch_emit_handlers_for_medium(registry: registry, medium: medium),
    f: fn(handlers) {
      orch_emit_run_with_handlers(r: r, handlers: handlers)
    }
  )
}

fn orch_emit_step_dispatch(
  s: Step,
  registry: OrchestrationEmitRegistry,
  medium: OrchestrationMedium
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: orch_emit_handlers_for_medium(registry: registry, medium: medium),
    f: fn(handlers) {
      orch_emit_step_with_handlers(s: s, handlers: handlers)
    }
  )
}

fn orch_emit_pipeline_dispatch(
  p: Pipeline,
  registry: OrchestrationEmitRegistry,
  medium: OrchestrationMedium
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: orch_emit_handlers_for_medium(registry: registry, medium: medium),
    f: fn(handlers) {
      orch_emit_pipeline_with_handlers(p: p, handlers: handlers)
    }
  )
}
