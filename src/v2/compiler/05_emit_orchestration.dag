module v2.compiler.emit_orchestration

import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Medium }
import v2.compiler.translate { target_bundle_child }
import v2.std.node_query { find_named_child }
import v2.std.orchestration_emit {
  OrchestrationEmitMedium,
  OrchRunEmitPlan,
  orch_construct_run_rawline,
  orch_construct_retry,
  orch_construct_seq2,
  orch_construct_if,
  orch_construct_if_else,
  orch_construct_procedure,
  orch_construct_call,
  orch_construct_cmdsubst_assign,
  orch_construct_let_assign,
  orch_construct_arith
}
import v2.extdeps.languages.bash {
  bash_stmt_negation_emitted,
  bash_stmt_negation_target_model,
  bash_stmt_andor_emitted,
  bash_stmt_andor_target_model,
  bash_stmt_with_redir_emitted,
  bash_stmt_with_redir_target_model,
  bash_redir_stdout_and_stderr_null_source_text,
  bash_redir_stderr_null_source_text,
  bash_redir_stdout_to_stderr_source_text
}
import v2.extdeps.languages.bash_orch_tier2 {
  bash_orch_call_emitted
}
import v2.extdeps.languages.bash_orch_if {
  bash_test_str_eq_emitted,
  bash_test_str_eq_target_model,
  bash_test_str_empty_emitted,
  bash_test_str_empty_target_model,
  bash_test_str_nonempty_emitted,
  bash_test_str_nonempty_target_model,
  bash_log_matches_grep_emitted,
  bash_log_matches_grep_target_model,
  bash_stmt_or_ignore_fail_emitted,
  bash_stmt_or_ignore_fail_target_model
}
import v2.std.orchestration {
  Run,
  PipelineStep,
  Do,
  If,
  Let,
  Call,
  Pipeline,
  Procedure,
  Expr,
  ExprLit,
  ExprVarRef,
  ExprArith,
  ExprCmdSubst,
  ArithAdd,
  ArithSub,
  EscalationLevel,
  Predicate,
  ExitZero,
  LogMatches,
  StrEq,
  StrEmpty,
  StrNonempty,
  Not,
  And,
  Or,
  RedirectSpec,
  CaptureSpec,
  DiscardAll,
  DiscardErr,
  StdoutAndStderr,
  IgnoreFail,
  EnvBinding
}
import std.algebra { FreeMonoid }
import v2.std.algebra { list_head, list_tail, HeadFound, HeadAbsent, TailFound, TailAbsent }
import v2.std.collection { List, Map, Optional, Present, Absent }
import v2.compiler.target_carriers { lossless_source }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.compilers.target_model { TargetModel }
import v2.std.node { Node, TypeNode, Conj, Atom, SyntheticOccurrence, Symbol }
import v2.std.text { String }
import v2.std.witness { Violates, Witness }

fn orch_emit_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^orch_emit_facts_unexpected_consultation,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

data orch_emit_unsupported_step_anchor: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^orch_emit_unsupported_step } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn orch_emit_registry_emitted_root(
  medium: OrchestrationEmitMedium,
  construct_tag: Symbol
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(
      target: medium.authority,
      edge_name: ^target_model_edge_orchestration_emit
    ),
    f: fn(registry) {
      find_named_child(root: registry, name: construct_tag)
    }
  )
}

fn orch_emit_from_registry(
  medium: OrchestrationEmitMedium,
  construct_tag: Symbol,
  target: TargetModel
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: orch_emit_registry_emitted_root(medium: medium, construct_tag: construct_tag),
    f: fn(emitted_root) {
      emit(
        tree: InferredTree {
          root: emitted_root,
          facts: Map { lookup: orch_emit_facts_lookup }
        },
        target: target
      )
    }
  )
}

fn orch_emit_node_spelling(emitted_root: Node, target: TargetModel) -> Outcome<String> {
  bind_outcome(
    o: emit(
      tree: InferredTree {
        root: emitted_root,
        facts: Map { lookup: orch_emit_facts_lookup }
      },
      target: target
    ),
    f: fn(m) { outcome_accepted(m.carried) }
  )
}

fn orch_emit_redir_suffix(r: RedirectSpec) -> String {
  match r {
    DiscardAll => bash_redir_stdout_and_stderr_null_source_text
    DiscardErr => bash_redir_stderr_null_source_text
    StdoutAndStderr => bash_redir_stdout_to_stderr_source_text
  }
}

fn orch_emit_run_core(r: Run, medium: OrchestrationEmitMedium) -> Outcome<String> {
  match list_head(xs: r.env) {
    HeadAbsent =>
      bind_outcome(
        o: orch_emit_from_registry(
          medium: medium,
          construct_tag: orch_construct_run_rawline,
          target: medium.realize_run_rawline(r.command)
        ),
        f: fn(m) { outcome_accepted(m.carried) }
      )
    HeadFound { value: _ } =>
      bind_outcome(
        o: orch_emit_run_from_plan(plan: medium.run_env_plan(r), medium: medium),
        f: fn(m) { outcome_accepted(m.carried) }
      )
  }
}

fn orch_emit_run_with_redir(stmt: String, redir: RedirectSpec) -> Outcome<String> {
  orch_emit_node_spelling(
    emitted_root: bash_stmt_with_redir_emitted,
    target: bash_stmt_with_redir_target_model(stmt: stmt, redir: orch_emit_redir_suffix(r: redir))
  )
}

fn orch_emit_run_spelling(r: Run, medium: OrchestrationEmitMedium) -> Outcome<String> {
  bind_outcome(
    o: orch_emit_run_core(r: r, medium: medium),
    f: fn(core) {
      match r.redirect {
        Absent =>
          match r.capture {
            Absent => outcome_accepted(core)
            Present { value: IgnoreFail } =>
              orch_emit_node_spelling(
                emitted_root: bash_stmt_or_ignore_fail_emitted,
                target: bash_stmt_or_ignore_fail_target_model(stmt: core)
              )
            Present { value: _ } =>
              outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_run_capture_unsupported))
          }
        Present { value: redir } =>
          bind_outcome(
            o: orch_emit_run_with_redir(stmt: core, redir: redir),
            f: fn(with_redir) {
              match r.capture {
                Absent => outcome_accepted(with_redir)
                Present { value: IgnoreFail } =>
                  orch_emit_node_spelling(
                    emitted_root: bash_stmt_or_ignore_fail_emitted,
                    target: bash_stmt_or_ignore_fail_target_model(stmt: with_redir)
                  )
                Present { value: _ } =>
                  outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_run_capture_unsupported))
              }
            }
          )
      }
    }
  )
}

fn orch_emit_run(r: Run, medium: OrchestrationEmitMedium) -> Outcome<Medium<String>> {
  bind_outcome(
    o: orch_emit_run_spelling(r: r, medium: medium),
    f: fn(spelling) { outcome_accepted(lossless_source(text: spelling)) }
  )
}

fn orch_emit_run_from_plan(
  plan: OrchRunEmitPlan,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: plan.construct_tag,
    target: plan.target
  )
}

fn orch_emit_join2(
  left: String,
  right: String,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: orch_construct_seq2,
    target: medium.realize_seq2(left, right)
  )
}

fn orch_emit_predicate(p: Predicate, medium: OrchestrationEmitMedium) -> Outcome<String> {
  match p {
    ExitZero { run: r } =>
      orch_emit_run_spelling(r: r, medium: medium)
    StrEq { lhs: lhs, rhs: rhs } =>
      orch_emit_node_spelling(
        emitted_root: bash_test_str_eq_emitted,
        target: bash_test_str_eq_target_model(lhs: lhs, rhs: rhs)
      )
    StrEmpty { operand: operand } =>
      orch_emit_node_spelling(
        emitted_root: bash_test_str_empty_emitted,
        target: bash_test_str_empty_target_model(operand: operand)
      )
    StrNonempty { operand: operand } =>
      orch_emit_node_spelling(
        emitted_root: bash_test_str_nonempty_emitted,
        target: bash_test_str_nonempty_target_model(operand: operand)
      )
    LogMatches { source: source, pattern: pattern } =>
      orch_emit_node_spelling(
        emitted_root: bash_log_matches_grep_emitted,
        target: bash_log_matches_grep_target_model(
          pattern: concat("'", concat(pattern, "'")),
          source: source
        )
      )
    Not { inner: inner } =>
      bind_outcome(
        o: orch_emit_predicate(p: inner, medium: medium),
        f: fn(spelling) {
          orch_emit_node_spelling(
            emitted_root: bash_stmt_negation_emitted,
            target: bash_stmt_negation_target_model(inner: spelling)
          )
        }
      )
    And { lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: orch_emit_predicate(p: lhs, medium: medium),
        f: fn(left) {
          bind_outcome(
            o: orch_emit_predicate(p: rhs, medium: medium),
            f: fn(right) {
              orch_emit_node_spelling(
                emitted_root: bash_stmt_andor_emitted,
                target: bash_stmt_andor_target_model(left: left, op: "&&", right: right)
              )
            }
          )
        }
      )
    Or { lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: orch_emit_predicate(p: lhs, medium: medium),
        f: fn(left) {
          bind_outcome(
            o: orch_emit_predicate(p: rhs, medium: medium),
            f: fn(right) {
              orch_emit_node_spelling(
                emitted_root: bash_stmt_andor_emitted,
                target: bash_stmt_andor_target_model(left: left, op: "||", right: right)
              )
            }
          )
        }
      )
  }
}

fn orch_emit_call_args(args: List<String>) -> String {
  fold(args, init: "", f: fn(acc, a) {
    if acc == "" { a } else { concat(acc, concat(" ", a)) }
  })
}

fn orch_emit_expr_spelling(e: Expr, medium: OrchestrationEmitMedium) -> Outcome<String> {
  match e {
    ExprLit { spelling: s } => outcome_accepted(s)
    ExprVarRef { name: n } => outcome_accepted(concat("$", n))
    ExprArith { op: op, lhs: lhs, rhs: rhs } =>
      bind_outcome(
        o: orch_emit_expr_spelling(e: lhs, medium: medium),
        f: fn(lhs_spelling) {
          bind_outcome(
            o: orch_emit_expr_spelling(e: rhs, medium: medium),
            f: fn(rhs_spelling) {
              bind_outcome(
                o: match op {
                  ArithAdd =>
                    orch_emit_from_registry(
                      medium: medium,
                      construct_tag: orch_construct_arith,
                      target: medium.realize_arith(lhs_spelling, "+", rhs_spelling)
                    )
                  ArithSub =>
                    orch_emit_from_registry(
                      medium: medium,
                      construct_tag: orch_construct_arith,
                      target: medium.realize_arith(lhs_spelling, "-", rhs_spelling)
                    )
                },
                f: fn(m) { outcome_accepted(m.carried) }
              )
            }
          )
        }
      )
    ExprCmdSubst { callee: c, args: args } =>
      outcome_accepted(concat(c, concat(" ", orch_emit_call_args(args: args))))
  }
}

fn orch_emit_let_step(
  name: String,
  value: Expr,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  match value {
    ExprCmdSubst { callee: c, args: args } =>
      orch_emit_from_registry(
        medium: medium,
        construct_tag: orch_construct_cmdsubst_assign,
        target: medium.realize_cmdsubst_assign(
          name,
          concat(c, concat(" ", orch_emit_call_args(args: args)))
        )
      )
    _ =>
      bind_outcome(
        o: orch_emit_expr_spelling(e: value, medium: medium),
        f: fn(value_spelling) {
          orch_emit_from_registry(
            medium: medium,
            construct_tag: orch_construct_let_assign,
            target: medium.realize_let_assign(name, value_spelling)
          )
        }
      )
  }
}

fn orch_emit_call_step(
  callee: String,
  args: List<String>,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  orch_emit_from_registry(
    medium: medium,
    construct_tag: orch_construct_call,
    target: medium.realize_call(callee, orch_emit_call_args(args: args))
  )
}

fn orch_emit_procedure(
  proc: Procedure,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: orch_emit_pipeline(p: proc.body, medium: medium),
    f: fn(body_medium) {
      orch_emit_from_registry(
        medium: medium,
        construct_tag: orch_construct_procedure,
        target: medium.realize_procedure(proc.name, body_medium.carried)
      )
    }
  )
}

fn orch_emit_if_step(
  cond: Predicate,
  then_: Pipeline,
  else_: Optional<Pipeline>,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: orch_emit_predicate(p: cond, medium: medium),
    f: fn(cond_spelling) {
      bind_outcome(
        o: orch_emit_pipeline(p: then_, medium: medium),
        f: fn(then_medium) {
          match else_ {
            Absent =>
              orch_emit_from_registry(
                medium: medium,
                construct_tag: orch_construct_if,
                target: medium.realize_if(cond_spelling, then_medium.carried)
              )
            Present { value: else_pipeline } =>
              bind_outcome(
                o: orch_emit_pipeline(p: else_pipeline, medium: medium),
                f: fn(else_medium) {
                  orch_emit_from_registry(
                    medium: medium,
                    construct_tag: orch_construct_if_else,
                    target: medium.realize_if_else(
                      cond_spelling,
                      then_medium.carried,
                      else_medium.carried
                    )
                  )
                }
              )
          }
        }
      )
    }
  )
}

fn orch_emit_step(s: PipelineStep, medium: OrchestrationEmitMedium) -> Outcome<Medium<String>> {
  match s {
    Do { run: r } => orch_emit_run(r: r, medium: medium)
    If { cond: c, then_: t, else_: e } =>
      orch_emit_if_step(cond: c, then_: t, else_: e, medium: medium)
    For { binder: _, over: _, body: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_step_for_unsupported))
    While { cond: _, body: _, bound: _ } =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_step_while_unsupported))
    Retry { body: b, escalations: e, on_exhausted: x } =>
      orch_emit_retry(body: b, escalations: e, on_exhausted: x, medium: medium)
    Let { name: n, value: v } =>
      orch_emit_let_step(name: n, value: v, medium: medium)
    Call { callee: c, args: a } =>
      orch_emit_call_step(callee: c, args: a, medium: medium)
  }
}

fn orch_retry_step_command(s: PipelineStep) -> Optional<String> {
  match s {
    Do { run: r } => Present { value: r.command }
    If { cond: _, then_: _, else_: _ } => Absent
    For { binder: _, over: _, body: _ } => Absent
    While { cond: _, body: _, bound: _ } => Absent
    Retry { body: _, escalations: _, on_exhausted: _ } => Absent
    Let { name: _, value: _ } => Absent
    Call { callee: _, args: _ } => Absent
  }
}

fn orch_retry_body_command(body: Pipeline) -> Optional<String> {
  match list_head(xs: body.steps) {
    HeadFound { value: s } => orch_retry_step_command(s: s)
    HeadAbsent => Absent
  }
}

fn orch_emit_retry_run(
  command: String,
  env: FreeMonoid<EnvBinding>,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  orch_emit_run(
    r: Run { command: command, env: env, redirect: Absent, capture: Absent },
    medium: medium
  )
}

fn orch_emit_retry_2level(
  command: String,
  pattern1: String,
  pattern2: String,
  warn1: String,
  warn2: String,
  env1: FreeMonoid<EnvBinding>,
  env2: FreeMonoid<EnvBinding>,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: orch_emit_retry_run(command: command, env: [], medium: medium),
    f: fn(m1) {
      bind_outcome(
        o: orch_emit_retry_run(command: command, env: env1, medium: medium),
        f: fn(m2) {
          bind_outcome(
            o: orch_emit_retry_run(command: command, env: env2, medium: medium),
            f: fn(m3) {
              orch_emit_from_registry(
                medium: medium,
                construct_tag: orch_construct_retry,
                target: medium.realize_retry(
                  m1.carried,
                  m2.carried,
                  m3.carried,
                  pattern1,
                  pattern2,
                  warn1,
                  warn2,
                  exhausted
                )
              )
            }
          )
        }
      )
    }
  )
}

fn orch_emit_retry_levels(
  command: String,
  level1: EscalationLevel,
  level2: EscalationLevel,
  exhausted: String,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  match level1.detect {
    LogMatches { source: _, pattern: p1 } =>
      match level2.detect {
        LogMatches { source: _, pattern: p2 } =>
          orch_emit_retry_2level(
            command: command,
            pattern1: p1,
            pattern2: p2,
            warn1: level1.warning.message,
            warn2: level2.warning.message,
            env1: level1.env,
            env2: level2.env,
            exhausted: exhausted,
            medium: medium
          )
        _ => outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level2_not_logmatches))
      }
    _ => outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_level1_not_logmatches))
  }
}

fn orch_emit_retry(
  body: Pipeline,
  escalations: FreeMonoid<EscalationLevel>,
  on_exhausted: Pipeline,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  match orch_retry_body_command(body: body) {
    Present { value: command } =>
      match list_head(xs: escalations) {
        HeadFound { value: l1 } =>
          match list_tail(xs: escalations) {
            TailFound { tail: t } =>
              match list_head(xs: t) {
                HeadFound { value: l2 } =>
                  bind_outcome(
                    o: orch_emit_pipeline(p: on_exhausted, medium: medium),
                    f: fn(exhausted_medium) {
                      orch_emit_retry_levels(
                        command: command,
                        level1: l1,
                        level2: l2,
                        exhausted: exhausted_medium.carried,
                        medium: medium
                      )
                    }
                  )
                HeadAbsent =>
                  outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_needs_two_levels))
              }
            TailAbsent =>
              outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_needs_two_levels))
          }
        HeadAbsent =>
          outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_no_escalations))
      }
    Absent =>
      outcome_rejected(orch_emit_unsupported_step_diagnostics(reason: ^orch_emit_retry_body_not_run))
  }
}

fn orch_emit_unsupported_step_diagnostics(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: orch_emit_unsupported_step_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn orch_emit_steps_from(
  head_str: String,
  rest: List<PipelineStep>,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  match list_head(xs: rest) {
    HeadAbsent =>
      outcome_accepted(lossless_source(text: head_str))
    HeadFound { value: next } =>
      bind_outcome(
        o: orch_emit_step(s: next, medium: medium),
        f: fn(next_medium) {
          bind_outcome(
            o: orch_emit_join2(left: head_str, right: next_medium.carried, medium: medium),
            f: fn(joined) {
              match list_tail(xs: rest) {
                TailFound { tail: t } =>
                  orch_emit_steps_from(head_str: joined.carried, rest: t, medium: medium)
                TailAbsent => outcome_accepted(joined)
              }
            }
          )
        }
      )
  }
}

fn orch_emit_pipeline(
  p: Pipeline,
  medium: OrchestrationEmitMedium
) -> Outcome<Medium<String>> {
  match list_head(xs: p.steps) {
    HeadAbsent =>
      outcome_accepted(lossless_source(text: ""))
    HeadFound { value: first } =>
      bind_outcome(
        o: orch_emit_step(s: first, medium: medium),
        f: fn(first_medium) {
          match list_tail(xs: p.steps) {
            TailFound { tail: t } =>
              orch_emit_steps_from(
                head_str: first_medium.carried,
                rest: t,
                medium: medium
              )
            TailAbsent =>
              outcome_accepted(first_medium)
          }
        }
      )
  }
}
