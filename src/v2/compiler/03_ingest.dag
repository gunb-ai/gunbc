module v2.compiler.ingest


data ingest_module_note: String = "Gate-A flip wave lane: v2.compiler.ingest is the parse-tree-to-target bridge (neutralize → infer → emit over CoreNode). Curated seed-linked behavioral receipt compares this module-authority constant until full ingest-tree oracle greens under std_dup-resolved cargo."

fn parse_atom_frontier_class(atom_identity: v2.std.node.Symbol, binding_to_class: Map<v2.std.node.Symbol, v2.std.node.Symbol>) -> v2.std.node.Symbol {
  match v2.std.collection.map_get(binding_to_class, atom_identity) {
    Accepted { value: opt, diagnostics: _ } =>
      match opt {
        Present { value: token_class } => token_class
        Absent => atom_identity
      }
    Rejected { diagnostics: _ } => atom_identity
  }
}

fn binding_class_map_merge_tokens(
  acc: Map<v2.std.node.Symbol, v2.std.node.Symbol>,
  tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> std.types.Map<v2.std.node.Symbol, v2.std.node.Symbol> {
  fold(
    tokens,
    init: acc,
    f: fn(a, t) {
      match t {
        BoundToken { token_class: c, binding: b } => v2.std.collection.map_insert(m: a, key: b, value: c)
        FixedToken { token_class: _ } => a
      }
    }
  )
}

fn binding_class_map_merge_row(acc: Map<v2.std.node.Symbol, v2.std.node.Symbol>, row: v2.std.node.Node) -> std.types.Map<v2.std.node.Symbol, v2.std.node.Symbol> {
  match row_token_spine_tokens(row: row) {
    Rejected { diagnostics: _ } => acc
    Accepted { value: tokens, diagnostics: _ } =>
      binding_class_map_merge_tokens(acc: acc, tokens: tokens)
  }
}

fn grammar_relation_binding_to_token_class_map(rules: v2.std.node.Node) -> std.types.Map<v2.std.node.Symbol, v2.std.node.Symbol> {
  match rules.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      fold(
        rules.children,
        init: v2.std.collection.empty_map(),
        f: fn(acc, e) {
          match e.label {
            Named { name: _ } => binding_class_map_merge_row(acc: acc, row: e.target)
            Positional => acc
          }
        }
      )
    _ => v2.std.collection.empty_map()
  }
}

fn row_token_spine_tokens(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<List<v2.std.compilers.target_model.ConcreteSyntaxToken>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root)
    }
  )
}

fn operational_parse_tree_project_to_formal_captures(
  captured: v2.std.node.Node,
  binding_to_class: Map<v2.std.node.Symbol, v2.std.node.Symbol>
) -> List<v2.std.node.Symbol> {
  match v2.std.grammar.node_atom_identity_optional(node: captured) {
    Present { value: id } =>
      v2.std.algebra.list_append(
        left: std.algebra.Empty,
        right: [parse_atom_frontier_class(atom_identity: id, binding_to_class: binding_to_class)]
      )
    Absent =>
      fold(
        captured.children,
        init: std.algebra.Empty,
        f: fn(acc, edge) {
          match edge.label {
            Named { name: n } =>
              if n == ^grammar_production_identity_node_projection {
                acc
              } else {
                v2.std.algebra.list_append(
                  left: acc,
                  right: operational_parse_tree_project_to_formal_captures(
                    captured: edge.target,
                    binding_to_class: binding_to_class
                  )
                )
              }
            Positional =>
              v2.std.algebra.list_append(
                left: acc,
                right: operational_parse_tree_project_to_formal_captures(
                  captured: edge.target,
                  binding_to_class: binding_to_class
                )
              )
          }
        }
      )
  }
}

fn grammar_relation_row_forward_selection(frontier: List<v2.std.node.Symbol>, rules: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.grammar.grammar_relation_row_forward_token_spine_selection(frontier: frontier, rules: rules)
}

fn concrete_syntax_token_spine_classes(tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>) -> List<v2.std.node.Symbol> {
  fold(
    tokens,
    init: std.algebra.Empty,
    f: fn(acc, t) {
      v2.std.algebra.list_append(left: acc, right: [v2.std.compilers.target_model.concrete_syntax_token_class(token: t)])
    }
  )
}

fn grammar_relation_row_forward_token_selection(
  tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>,
  rules: v2.std.node.Node,
  start_lhs: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let frontier = concrete_syntax_token_spine_classes(tokens: tokens)
  match grammar_relation_row_forward_selection(frontier: frontier, rules: rules) {
    Accepted { value: emitted, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: emitted, diagnostics: d }
    Rejected { diagnostics: _ } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.std.grammar.grammar_relation_rules_formal_productions(rules: rules),
        f: fn(productions) {
          match v2.std.grammar.grammar_relation_emitted_rebuild_from_token_spine(
            productions: productions,
            lhs: start_lhs,
            tokens: tokens
          ) {
            Holds { value: emitted } => v2.std.diagnostic.outcome_accepted(value: emitted)
            Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d)
          }
        }
      )
  }
}

fn parse_tree_to_emitted_node(parse_tree: v2.std.grammar.ParseTree, source_model: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.translate.target_bundle_child(target: source_model, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      let binding_to_class = grammar_relation_binding_to_token_class_map(rules: rules)
      let frontier = operational_parse_tree_project_to_formal_captures(
        captured: parse_tree,
        binding_to_class: binding_to_class
      )
      grammar_relation_row_forward_selection(frontier: frontier, rules: rules)
    }
  )
}

fn parse_tree_to_target_model_bridge(parse_tree: v2.std.grammar.ParseTree, source_model: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.compiler.compile.CoreNode> {
  v2.std.diagnostic.bind_outcome(
    o: parse_tree_to_emitted_node(parse_tree: parse_tree, source_model: source_model),
    f: fn(emitted) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.infer.infer(tree: emitted),
        f: fn(inferred) {
          v2.std.diagnostic.bind_outcome(
            o: v2.compiler.translate.coerce_grounded_node(source: emitted, tree: inferred, target: source_model),
            f: fn(result) { v2.std.diagnostic.outcome_accepted(value: result.target) }
          )
        }
      )
    }
  )
}

fn cross_language_compile(
  parse_tree: v2.std.grammar.ParseTree,
  source_model: v2.std.compilers.target_model.TargetModel,
  target_model: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: parse_tree_to_target_model_bridge(parse_tree: parse_tree, source_model: source_model),
    f: fn(core) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.inhabitant_neutralization.neutralize_core_for_target(core: core, target: target_model),
        f: fn(neutralized) {
          v2.std.diagnostic.bind_outcome(
            o: v2.compiler.infer.infer(tree: neutralized),
            f: fn(inferred) {
              v2.compiler.emit.emit(tree: inferred, target: target_model)
            }
          )
        }
      )
    }
  )
}
