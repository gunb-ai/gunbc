module v2.compiler.ingest

import std.algebra { Empty }
import v2.std.algebra { list_append }
import v2.std.collection {
  Absent,
  List,
  Map,
  Present,
  empty_map,
  map_get,
  map_insert
}
import v2.std.grammar {
  ParseTree,
  grammar_relation_emitted_rebuild_from_token_spine,
  grammar_relation_row_forward_token_spine_selection,
  grammar_relation_rules_formal_productions,
  node_atom_identity_optional
}
import v2.std.witness { Holds, Violates }
import v2.std.node_query { find_named_child }
import v2.std.compilers.target_model {
  TargetModel,
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  concrete_syntax_token_class,
  concrete_syntax_token_list_from_node,
}
import v2.compiler.compile { CoreNode }
import v2.compiler.infer { InferredTree, infer }
import v2.compiler.emit { emit }
import extdeps.communication.medium { Medium }
import v2.compiler.translate {
  coerce_grounded_node,
  target_bundle_child
}
import v2.std.inhabitant_neutralization { neutralize_core_for_target }
import v2.std.node { Edge, Named, Node, Positional, Symbol, TypeNode, Conj }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}

data ingest_module_note: String = "Gate-A flip wave lane: v2.compiler.ingest is the parse-tree-to-target bridge (neutralize → infer → emit over CoreNode). Curated seed-linked behavioral receipt compares this module-authority constant until full ingest-tree oracle greens under std_dup-resolved cargo."

fn parse_atom_frontier_class_unrecoverable(atom: Node) -> Outcome<Symbol> {
  outcome_rejected(
    Diagnostic {
      reason: ^parse_tree_atom_token_class_not_recoverable,
      at: node_locus(node: atom),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}

fn parse_atom_frontier_class_direct(
  atom: Node,
  atom_identity: Symbol,
  token_classes: Map<Symbol, Symbol>
) -> Outcome<Symbol> {
  bind_outcome(
    o: map_get(token_classes, atom_identity),
    f: fn(direct) {
      match direct {
        Present { value: token_class } => outcome_accepted(value: token_class)
        Absent => parse_atom_frontier_class_unrecoverable(atom: atom)
      }
    }
  )
}

fn parse_atom_frontier_class(
  atom: Node,
  atom_identity: Symbol,
  binding_to_class: Map<Symbol, Symbol>,
  token_classes: Map<Symbol, Symbol>
) -> Outcome<Symbol> {
  bind_outcome(
    o: map_get(binding_to_class, atom_identity),
    f: fn(bound) {
      match bound {
        Present { value: token_class } => outcome_accepted(value: token_class)
        Absent =>
          parse_atom_frontier_class_direct(
            atom: atom,
            atom_identity: atom_identity,
            token_classes: token_classes
          )
      }
    }
  )
}

fn binding_class_map_merge_tokens(
  acc: Map<Symbol, Symbol>,
  tokens: List<ConcreteSyntaxToken>
) -> Map<Symbol, Symbol> {
  fold(
    tokens,
    init: acc,
    f: fn(a, t) {
      match t {
        BoundToken { token_class: c, binding: b } => map_insert(m: a, key: b, value: c)
        FixedToken { token_class: _ } => a
      }
    }
  )
}

fn binding_class_map_merge_row(acc: Map<Symbol, Symbol>, row: Node) -> Map<Symbol, Symbol> {
  match row_token_spine_tokens(row: row) {
    Rejected { diagnostics: _ } => acc
    Accepted { value: tokens, diagnostics: _ } =>
      binding_class_map_merge_tokens(acc: acc, tokens: tokens)
  }
}

fn grammar_relation_binding_to_token_class_map(rules: Node) -> Map<Symbol, Symbol> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      fold(
        rules.children,
        init: empty_map(),
        f: fn(acc, e) {
          match e.label {
            Named { name: _ } => binding_class_map_merge_row(acc: acc, row: e.target)
            Positional => acc
          }
        }
      )
    _ => empty_map()
  }
}

fn token_class_set_merge_row(acc: Map<Symbol, Symbol>, row: Node) -> Map<Symbol, Symbol> {
  match row_token_spine_tokens(row: row) {
    Rejected { diagnostics: _ } => acc
    Accepted { value: tokens, diagnostics: _ } =>
      fold(
        tokens,
        init: acc,
        f: fn(a, t) {
          let c = concrete_syntax_token_class(token: t)
          map_insert(m: a, key: c, value: c)
        }
      )
  }
}

fn grammar_relation_token_class_set(rules: Node) -> Map<Symbol, Symbol> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      fold(
        rules.children,
        init: empty_map(),
        f: fn(acc, e) {
          match e.label {
            Named { name: _ } => token_class_set_merge_row(acc: acc, row: e.target)
            Positional => acc
          }
        }
      )
    _ => empty_map()
  }
}

fn row_token_spine_tokens(row: Node) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      concrete_syntax_token_list_from_node(list_node: tokens_root)
    }
  )
}

fn parse_tree_frontier_extend(
  prefix: List<Symbol>,
  child: Node,
  binding_to_class: Map<Symbol, Symbol>,
  token_classes: Map<Symbol, Symbol>
) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: operational_parse_tree_project_to_formal_captures(
      captured: child,
      binding_to_class: binding_to_class,
      token_classes: token_classes
    ),
    f: fn(rest) { outcome_accepted(value: list_append(left: prefix, right: rest)) }
  )
}

fn operational_parse_tree_project_to_formal_captures(
  captured: Node,
  binding_to_class: Map<Symbol, Symbol>,
  token_classes: Map<Symbol, Symbol>
) -> Outcome<List<Symbol>> {
  match node_atom_identity_optional(node: captured) {
    Present { value: id } =>
      bind_outcome(
        o: parse_atom_frontier_class(
          atom: captured,
          atom_identity: id,
          binding_to_class: binding_to_class,
          token_classes: token_classes
        ),
        f: fn(token_class) {
          outcome_accepted(value: list_append(left: Empty, right: [token_class]))
        }
      )
    Absent =>
      fold(
        captured.children,
        init: outcome_accepted(value: Empty),
        f: fn(acc, edge) {
          bind_outcome(
            o: acc,
            f: fn(prefix) {
              match edge.label {
                Named { name: n } =>
                  if n == ^grammar_production_identity_node_projection {
                    outcome_accepted(value: prefix)
                  } else {
                    parse_tree_frontier_extend(
                      prefix: prefix,
                      child: edge.target,
                      binding_to_class: binding_to_class,
                      token_classes: token_classes
                    )
                  }
                Positional =>
                  parse_tree_frontier_extend(
                    prefix: prefix,
                    child: edge.target,
                    binding_to_class: binding_to_class,
                    token_classes: token_classes
                  )
              }
            }
          )
        }
      )
  }
}

fn grammar_relation_row_forward_selection(frontier: List<Symbol>, rules: Node) -> Outcome<Node> {
  grammar_relation_row_forward_token_spine_selection(frontier: frontier, rules: rules)
}

fn concrete_syntax_token_spine_classes(tokens: List<ConcreteSyntaxToken>) -> List<Symbol> {
  fold(
    tokens,
    init: Empty,
    f: fn(acc, t) {
      list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
    }
  )
}

fn grammar_relation_row_forward_token_selection(
  tokens: List<ConcreteSyntaxToken>,
  rules: Node,
  start_lhs: Symbol
) -> Outcome<Node> {
  let frontier = concrete_syntax_token_spine_classes(tokens: tokens)
  match grammar_relation_row_forward_selection(frontier: frontier, rules: rules) {
    Accepted { value: emitted, diagnostics: d } =>
      Accepted { value: emitted, diagnostics: d }
    Rejected { diagnostics: _ } =>
      bind_outcome(
        o: grammar_relation_rules_formal_productions(rules: rules),
        f: fn(productions) {
          match grammar_relation_emitted_rebuild_from_token_spine(
            productions: productions,
            lhs: start_lhs,
            tokens: tokens
          ) {
            Holds { value: emitted } => outcome_accepted(value: emitted)
            Violates { diagnostic: d } => outcome_rejected(d)
          }
        }
      )
  }
}

fn parse_tree_to_emitted_node(parse_tree: ParseTree, source_model: TargetModel) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: source_model, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: operational_parse_tree_project_to_formal_captures(
          captured: parse_tree,
          binding_to_class: grammar_relation_binding_to_token_class_map(rules: rules),
          token_classes: grammar_relation_token_class_set(rules: rules)
        ),
        f: fn(frontier) {
          grammar_relation_row_forward_selection(frontier: frontier, rules: rules)
        }
      )
    }
  )
}

fn parse_tree_to_target_model_bridge(parse_tree: ParseTree, source_model: TargetModel) -> Outcome<CoreNode> {
  bind_outcome(
    o: parse_tree_to_emitted_node(parse_tree: parse_tree, source_model: source_model),
    f: fn(emitted) {
      bind_outcome(
        o: infer(tree: emitted),
        f: fn(inferred) {
          bind_outcome(
            o: coerce_grounded_node(source: emitted, tree: inferred, target: source_model),
            f: fn(result) { outcome_accepted(value: result.target) }
          )
        }
      )
    }
  )
}

fn cross_language_compile(
  parse_tree: ParseTree,
  source_model: TargetModel,
  target_model: TargetModel
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: parse_tree_to_target_model_bridge(parse_tree: parse_tree, source_model: source_model),
    f: fn(core) {
      bind_outcome(
        o: neutralize_core_for_target(core: core, target: target_model),
        f: fn(neutralized) {
          bind_outcome(
            o: infer(tree: neutralized),
            f: fn(inferred) {
              emit(tree: inferred, target: target_model)
            }
          )
        }
      )
    }
  )
}
