module v2.compiler.ingest

import v2.std.algebra { Empty, list_append, zip_eq }
import v2.std.collection {
  Absent,
  List,
  Map,
  Present,
  empty_map,
  map_get,
  map_insert
}
import v2.std.grammar {
  ParseTree,
  grammar_relation_emitted_rebuild_from_token_spine,
  grammar_relation_rules_formal_productions,
  node_atom_identity_optional
}
import v2.std.witness { Holds, Violates }
import v2.std.node_query { find_named_child }
import v2.std.compilers.target_model {
  TargetModel,
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  concrete_syntax_token_class,
  concrete_syntax_token_list_from_node,
}
import v2.compiler.compile { CoreNode }
import v2.compiler.infer { infer }
import v2.compiler.emit { emit }
import extdeps.communication.medium { Medium }
import v2.compiler.translate {
  coerce_grounded_node,
  target_bundle_child
}
import v2.std.inhabitant_neutralization { neutralize_core_for_target }
import v2.std.node { Edge, Named, Node, Positional, Symbol, TypeNode, Conj }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}

fn parse_atom_frontier_class(atom_identity: Symbol, binding_to_class: Map<Symbol, Symbol>) -> Symbol {
  match map_get(binding_to_class, atom_identity) {
    Accepted { value: opt, diagnostics: _ } =>
      match opt {
        Present { value: token_class } => token_class
        Absent => atom_identity
      }
    Rejected { diagnostics: _ } => atom_identity
  }
}

fn binding_class_map_merge_tokens(
  acc: Map<Symbol, Symbol>,
  tokens: List<ConcreteSyntaxToken>
) -> Map<Symbol, Symbol> {
  fold(
    tokens,
    init: acc,
    f: fn(a, t) {
      match t {
        BoundToken { token_class: c, binding: b } => map_insert(m: a, key: b, value: c)
        FixedToken { token_class: _ } => a
      }
    }
  )
}

fn binding_class_map_merge_row(acc: Map<Symbol, Symbol>, row: Node) -> Map<Symbol, Symbol> {
  match row_token_spine_tokens(row: row) {
    Rejected { diagnostics: _ } => acc
    Accepted { value: tokens, diagnostics: _ } =>
      binding_class_map_merge_tokens(acc: acc, tokens: tokens)
  }
}

fn grammar_relation_binding_to_token_class_map(rules: Node) -> Map<Symbol, Symbol> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      fold(
        rules.children,
        init: empty_map(),
        f: fn(acc, e) {
          match e.label {
            Named { name: _ } => binding_class_map_merge_row(acc: acc, row: e.target)
            Positional => acc
          }
        }
      )
    _ => empty_map()
  }
}

fn row_token_spine_tokens(row: Node) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      concrete_syntax_token_list_from_node(list_node: tokens_root)
    }
  )
}

fn operational_parse_tree_project_to_formal_captures(
  captured: Node,
  binding_to_class: Map<Symbol, Symbol>
) -> List<Symbol> {
  match node_atom_identity_optional(node: captured) {
    Present { value: id } =>
      list_append(
        left: Empty,
        right: [parse_atom_frontier_class(atom_identity: id, binding_to_class: binding_to_class)]
      )
    Absent =>
      fold(
        captured.children,
        init: Empty,
        f: fn(acc, edge) {
          match edge.label {
            Named { name: n } =>
              if n == ^grammar_production_identity_node_projection {
                acc
              } else {
                list_append(
                  left: acc,
                  right: operational_parse_tree_project_to_formal_captures(
                    captured: edge.target,
                    binding_to_class: binding_to_class
                  )
                )
              }
            Positional =>
              list_append(
                left: acc,
                right: operational_parse_tree_project_to_formal_captures(
                  captured: edge.target,
                  binding_to_class: binding_to_class
                )
              )
          }
        }
      )
  }
}

fn row_token_spine_classes(row: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: Empty,
            f: fn(acc, t) {
              list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

type ForwardRowSelection
  = ForwardRowNone
  | ForwardRowOne { emitted: Node }
  | ForwardRowMany

fn forward_row_select_step(acc: ForwardRowSelection, frontier: List<Symbol>, row: Node) -> ForwardRowSelection {
  match row_token_spine_classes(row: row) {
    Rejected { diagnostics: _ } => acc
    Accepted { value: spine, diagnostics: _ } =>
      if zip_eq(a: frontier, b: spine, eq: fn(x, y) { x == y }) {
        match find_named_child(root: row, name: ^grammar_relation_field_emitted) {
          Rejected { diagnostics: _ } => acc
          Accepted { value: row_emitted, diagnostics: _ } =>
            match acc {
              ForwardRowNone => ForwardRowOne { emitted: row_emitted }
              ForwardRowOne { emitted: _ } => ForwardRowMany
              ForwardRowMany => ForwardRowMany
            }
        }
      } else {
        acc
      }
  }
}

fn grammar_relation_row_forward_selection(frontier: List<Symbol>, rules: Node) -> Outcome<Node> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      match fold(
        rules.children,
        init: ForwardRowNone,
        f: fn(acc, e) {
          match e.label {
            Named { name: _ } => forward_row_select_step(acc: acc, frontier: frontier, row: e.target)
            Positional => acc
          }
        }
      ) {
        ForwardRowOne { emitted: emitted } => outcome_accepted(value: emitted)
        ForwardRowMany =>
          outcome_rejected(d: Diagnostic {
            reason: ^parse_tree_to_emitted_node_ambiguous_row,
            at: node_locus(node: rules),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
        ForwardRowNone =>
          outcome_rejected(d: Diagnostic {
            reason: ^parse_tree_to_emitted_node_no_matching_row,
            at: node_locus(node: rules),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
      }
    _ =>
      outcome_rejected(d: Diagnostic {
        reason: ^parse_tree_to_emitted_node_no_matching_row,
        at: node_locus(node: rules),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}

fn concrete_syntax_token_spine_classes(tokens: List<ConcreteSyntaxToken>) -> List<Symbol> {
  fold(
    tokens,
    init: Empty,
    f: fn(acc, t) {
      list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
    }
  )
}

fn grammar_relation_row_forward_token_selection(
  tokens: List<ConcreteSyntaxToken>,
  rules: Node,
  start_lhs: Symbol
) -> Outcome<Node> {
  let frontier = concrete_syntax_token_spine_classes(tokens: tokens)
  match grammar_relation_row_forward_selection(frontier: frontier, rules: rules) {
    Accepted { value: emitted, diagnostics: d } =>
      Accepted { value: emitted, diagnostics: d }
    Rejected { diagnostics: _ } =>
      bind_outcome(
        o: grammar_relation_rules_formal_productions(rules: rules),
        f: fn(productions) {
          match grammar_relation_emitted_rebuild_from_token_spine(
            productions: productions,
            lhs: start_lhs,
            tokens: tokens
          ) {
            Holds { value: emitted } => outcome_accepted(value: emitted)
            Violates { diagnostic: d } => outcome_rejected(d)
          }
        }
      )
  }
}

fn parse_tree_to_emitted_node(parse_tree: ParseTree, source_model: TargetModel) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: source_model, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      let binding_to_class = grammar_relation_binding_to_token_class_map(rules: rules)
      let frontier = operational_parse_tree_project_to_formal_captures(
        captured: parse_tree,
        binding_to_class: binding_to_class
      )
      grammar_relation_row_forward_selection(frontier: frontier, rules: rules)
    }
  )
}

fn parse_tree_to_target_model_bridge(parse_tree: ParseTree, source_model: TargetModel) -> Outcome<CoreNode> {
  bind_outcome(
    o: parse_tree_to_emitted_node(parse_tree: parse_tree, source_model: source_model),
    f: fn(emitted) {
      bind_outcome(
        o: infer(tree: emitted),
        f: fn(inferred) {
          bind_outcome(
            o: coerce_grounded_node(source: emitted, tree: inferred, target: source_model),
            f: fn(result) { outcome_accepted(value: result.target) }
          )
        }
      )
    }
  )
}

fn cross_language_compile(
  parse_tree: ParseTree,
  source_model: TargetModel,
  target_model: TargetModel
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: parse_tree_to_target_model_bridge(parse_tree: parse_tree, source_model: source_model),
    f: fn(core) {
      bind_outcome(
        o: neutralize_core_for_target(core: core, target: target_model),
        f: fn(neutralized) {
          bind_outcome(
            o: infer(tree: neutralized),
            f: fn(inferred) { emit(tree: inferred, target: target_model) }
          )
        }
      )
    }
  )
}
