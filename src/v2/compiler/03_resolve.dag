// RESOLVE'S OUTPUT IS THE RESOLVED ROOT AND THE INDEX IT WAS RESOLVED AGAINST, one record. A later
// stage that needs a reference's declaration asks the SAME authority resolution asked
// (v2.std.symbol_index symbol_index_lookup) instead of reconstructing it from the tree: the index is
// the Namespace.symbol_index the walk ran under, minted beside the root on the Accepted arm only, so
// a refusal carries no index and no stage can read one for a tree that did not resolve.
// CONSUMERS: .root is read by every stage after resolve (infer's gather reads it at its entry).
// .symbol_index is the table resolve resolves against; no later stage reads it. A later stage that needs
// a declaration reads .resolved_declarations below: v2.compiler.infer infer_parameter_reference_facts
// grounds a named fn's parameter reference (minted by resolve_frame_bound_reference) by
// symbol_index_lookup there at its path, and refinement_declaration (gunbc#12407) asks it for the
// refinement declaration a cast operand's type references.
// TWO INDEXES OVER THE SAME DECLARATIONS AT DIFFERENT PHASES, NEVER ONE QUESTION TWICE.
// symbol_index is THE INDEX RESOLUTION CONSULTED: declarations as authored, before resolve, the table
// resolve looks references up in. resolved_declarations is DECLARATIONS WITH RESOLVED BODIES: the same
// module fold (v2.compiler.symbol_index_fill symbol_index_fill_module_declarations) run over the
// RESOLVED root, so a declaration's body carries the identities resolve bound in it -- a where-refined
// carrier `Int` is the kernel binding, a carrier naming a corpus type is its declaration reference. A
// reader that needs a body's resolved type reads resolved_declarations; nothing reads symbol_index for
// a body type (neat-boar-16 ruling), so the two never answer the same question.
// lexical_bindings is WHICH BINDER ANSWERED EACH LEXICAL REFERENCE, keyed by the reference's own
// minted occurrence: the record resolve's Lexical frames made while walking (LexicalBinding). It is
// the lexical counterpart of resolved_declarations for a parameter reference -- a consumer reads it
// and never re-derives scope.
type ResolvedTree {
  root: Node
  symbol_index: SymbolIndex
  resolved_declarations: SymbolIndex
  lexical_bindings: Map<OccurrenceId, LexicalBinding>
  unavailable_providers: List<ClosureProviderRefusal>
  member_kinds: MemberKindChannel
}

// A CLOSURE ROOT WHOSE OWN RESOLVE REFUSED, AND WHY. v2.compiler.name_resolve closure_declarations_demand
// resolves every root in the closure to fill the index inference reads; a root that refuses contributes no
// declarations, and until this carrier that absence was SILENT -- a receiver typed by one of its records
// refused as a bare lookup miss (infer_reason_projection_receiver_declaration_unavailable) with nothing to
// say the provider never resolved, so the provider's real defect never ranked (DESIGN section 5, the
// absorbing fallback's signal loss). The roster rides on the tree so every lookup miss can name its cause.
type ClosureProviderRefusal {
  module: QualifiedName
  refusal: NonEmptyDiagnostics
}

// THE ONE READ every closure-index miss consults: the refused provider whose module path is a prefix of
// the missed declaration's path, if any. A miss with no refused provider over it stays the bare miss.
fn resolved_tree_unavailable_provider(tree: ResolvedTree, path: QualifiedName) -> Optional<ClosureProviderRefusal> {
  fold(tree.unavailable_providers, init: optional_absent(), f: fn(acc, p) {
    match acc {
      Present { value: _ } => acc
      Absent => if qualified_name_is_proper_prefix(prefix: p.module, path: path) { optional_present(value: p) } else { acc }
    }
  })
}

fn qualified_name_is_proper_prefix(prefix: QualifiedName, path: QualifiedName) -> Bool {
  match prefix {
    Empty =>
      match path {
        Empty => false
        Cons { head: _, tail: _ } => true
      }
    Cons { head: ph, tail: pt } =>
      match path {
        Empty => false
        Cons { head: h, tail: t } => ph == h && qualified_name_is_proper_prefix(prefix: pt, path: t)
      }
  }
}

// The resolved root's declarations, by the same module fold the pre-resolve index uses: the module's
// qualified name is read from the root's own header, so a declaration is keyed at its full path (p.Pos).
// A root whose module name cannot be read yields the empty index -- every lookup through it refuses.
fn resolved_declarations_of(root: Node) -> SymbolIndex {
  symbol_index_fill_module_declarations(index: empty_symbol_index(), root: root, record_declarations: Empty, resource_declarations: Empty)
}

// THE ONE CONSTRUCTOR of an accepted resolution's carrier: the root, the index it was resolved
// against, its declarations as resolved, and the lexical bindings its walk recorded.
// THE INDEX INFERENCE READS SPANS THE CLOSURE, NOT ONE MODULE, and that is the capability this constructor
// previously could not supply. resolved_declarations_of walks ONE resolved root -- the subject's -- so a
// record an imported provider declares was absent from it BY CONSTRUCTION, and v2.compiler.infer
// infer_projection_receiver could not retrieve the declaration for any imported receiver type.
//
// MEASURED, one variable moved: v2.test.claim.field_projection.field_projection_stages
// fps_a_same_module_record_projection_infers passed while fps_a_cross_module_record_projection_infers failed
// over byte-identical records projected off a plain parameter. Two further rows separated the cause from its
// neighbours -- fps_dbg_same_module_in_two_root_ingest PASSES, so a multi-root ingest is not the defect and
// the subject really is cross-module retrieval.
//
// SO THE CALLER SUPPLIES THE CLOSURE'S RESOLVED DECLARATIONS, which keeps this a constructor rather than
// making it a second resolver: the facts come from the resolutions that actually happened, and whoever
// performed them owns them. The alternative considered and REFUSED was reading
// ResolutionContext.symbol_index instead, which is filled from NORMALIZED roots: it would have made
// imported field typing appear to work off AUTHORED declarations rather than resolved ones, which is the
// authored/resolved fork this carrier exists to keep apart (see the resolved_declarations header above).
fn resolved_tree_of(
  root: Node,
  symbol_index: SymbolIndex,
  closure_declarations: SymbolIndex,
  unavailable_providers: List<ClosureProviderRefusal>,
  member_kinds: MemberKindChannel,
  lexical: List<LexicalBindingEntry>
) -> ResolvedTree {
  ResolvedTree {
    root: root,
    symbol_index: symbol_index,
    resolved_declarations: resolved_declarations_over(closure: closure_declarations, subject: root),
    lexical_bindings: fold(lexical, init: empty_map(), f: fn(m, e) { map_insert(m, e.reference, e.binding) }),
    unavailable_providers: unavailable_providers,
    member_kinds: member_kinds
  }
}

// THE SUBJECT'S MEMBER-KIND CHANNEL, keyed by the DECLARING path (this module's qualified name + the member's
// name). The channel covers the subject module only -- the one root mandatory_tag runs on -- so resolve pays
// one pass over one module's members, not one per root in the closure. A tree normalize read no members for
// (a hand-built root) is Unavailable, never an empty captured list. Roots are unique by name already
// (ModuleRootsDuplicate refuses a second root for one module), so the only merge that can conflict is two
// members of one module sharing a name: that refuses, located at the root, and is never first-wins.
fn member_kind_channel_of_tree(tree: NormalizedTree) -> Outcome<MemberKindChannel> {
  match tree.member_declarations {
    MemberDeclarationsNotRead => Accepted { value: no_member_declaration_kinds(), diagnostics: None }
    MemberDeclarationsRead { members: members } =>
      match qualified_name_from_module_node(root: tree.root) {
        Rejected { diagnostics: _ } => Accepted { value: no_member_declaration_kinds(), diagnostics: None }
        Accepted { value: module_qn, diagnostics: _ } =>
          let duplicated = declared_members_have_duplicate(members: members)
          if duplicated {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: Diagnostic {
                  reason: ^resolve_reason_member_kind_duplicate_declaration,
                  at: node_locus(node: tree.root),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }
              )
            }
          } else {
            Accepted {
              value: MemberKindsCaptured {
                covered: [module_qn],
                members: fold_list(
                  xs: members,
                  empty: [],
                  cons: fn(acc, m) { list_snoc_item(xs: acc, item: QualifiedDeclaredMember { module: module_qn, name: m.name, kind: m.kind }) }
                )
              },
              diagnostics: None
            }
          }
      }
  }
}

// The binding that answered a lexical reference node, read through its own occurrence. Absent for a
// node that is not a lexical reference this tree's resolve recorded.
fn resolved_tree_lexical_binding(tree: ResolvedTree, reference: Node) -> Optional<LexicalBinding> {
  match reference.occurrence_id {
    OccurrenceMinted { id: id } => map_lookup(m: tree.lexical_bindings, key: id)
    OccurrenceProjected { id: id, caused_by: _ } => map_lookup(m: tree.lexical_bindings, key: id)
    OccurrenceSynthetic => optional_absent()
    OccurrencePending { caused_by: _ } => optional_absent()
  }
}

// THE CLOSURE INDEX IS PRODUCED ONCE PER CONTEXT (v2.compiler.name_resolve closure_declarations_demand) and
// only the SUBJECT is filled here. symbol_index_fill_module_declarations keys every declaration at its OWN
// module's qualified name, so filling the subject over the closure index is total and order-independent.
//
// THE SUBJECT IS FILLED UNCONDITIONALLY. It is normally already in the closure index, but a caller that holds
// no closure passes empty_symbol_index(), and this still answers exactly what it answered before: the
// subject's own declarations. So the change cannot take a capability away from a caller that has not yet been
// given the closure.
fn resolved_declarations_over(closure: SymbolIndex, subject: Node) -> SymbolIndex {
  symbol_index_fill_module_declarations(
    index: closure,
    root: subject,
    record_declarations: Empty,
    resource_declarations: Empty
  )
}

// `test_code`, `declared_in` and `imported_origins` exist for one decision: whether a reference binds
// to test code (owner ruling 2026-09-16/17). Root-scope bindings come from exactly two sources: the
// subject's own declarations, which live under `declared_in`, and admitted imports, whose origin
// module `imported_origins` records. So a root hit is judged by the same qualified path a
// symbol-index hit answers with.
type Namespace {
  bindings: Map<Symbol, Symbol>
  canonical_symbols: PointwisePower<Symbol>
  symbol_index: SymbolIndex
  module_qn: QualifiedName
  test_code: TestCodeIndex
  declared_in: QualifiedName
  imported_origins: Map<Symbol, QualifiedName>
}

type Scope
  = ScopeRoot { module: Namespace }
  | ScopeFrame { locals: Map<Symbol, Symbol>, outer: Scope, kind: FrameKind }

// WHAT A FRAME'S BINDERS ARE, DECIDED ONCE WHERE THE FRAME IS BUILT AND NEVER RE-READ FROM SHAPE.
// A frame opened over the domain of an Arrow the containment walk reaches -- a declared fn, whose
// parameters v2.compiler.symbol_index_fill indexes at <declaring path>.<label> -- is a
// ParameterFrame carrying that declaring path, and a reference it answers is minted as a
// path-keyed parameter reference (resolve_frame_bound_reference). A `let`, a match arm and a
// lambda's own Arrow are Lexical: their binders are not declarations (see the match-arm frame below),
// so a reference they answer is minted as a lexical reference keyed by its own occurrence, with the
// binder that answered it recorded in ResolvedTree.lexical_bindings (LexicalBinding). A type-parameter
// frame is TypeParameterFrame: it binds a type, not a value, and a name it answers stays the bare
// canonical atom, which is how v2.compiler.infer recognizes a type variable (type_param_names).
// Every consumer of a value reference therefore reads which binder answered it from resolve, and
// none searches scope again: the lambda frontier this carrier used to declare -- infer's parameter
// scope search -- is closed by the lexical reference, not
// by an index path for anonymous Arrows (a lambda parameter is not a declaration, so the occurrence
// of its Arrow, not a path, is its key).
type FrameKind
  = ParameterFrame { arrow_path: QualifiedName }
  | LexicalFrame { binders: Map<Symbol, LexicalBinding> }
  | TypeParameterFrame

// A LEXICAL BINDER, AS THE FRAME THAT INTRODUCES IT RECORDED IT. A `let`, a match-arm pattern binder
// and a lambda's parameter are not declarations: nothing indexes them at a path, so the frame keys
// each by its SITE -- the minted occurrence (std.occurrence_identity) of the node that introduces
// it: the binder atom for a `let` or a pattern binder, the lambda's Arrow for a parameter its domain
// carries as an edge label. Its standing is LexicalDeclared at a lambda domain edge (read through
// v2.std.node_query member_edge_type_node), LexicalValued at a let, LexicalOwedFormal at a
// match-payload formal, LexicalUntyped otherwise.
// A reference this frame answers is minted as v2.std.qualified_name lexical_reference_node and its
// binding is recorded in ResolvedTree.lexical_bindings under the REFERENCE's own occurrence, so a
// consumer reads which binder answered and never searches scope again: resolve decided it here.
//
// A lexical binder's standing is ONE case, not a bag of independent Optionals: a declared type, a
// let's value, an unpaid match-payload formal, or none. A binder that is both declared and owed is
// unwritable. LexicalOwedFormal is a match-arm payload field typed by the DECLARING coproduct's own
// formal: resolve cannot know the scrutinee's arguments, so it records the obligation and
// v2.compiler.infer discharges it from the scrutinee's settled type at arm entry or refuses it
// located. Minting the formal as the binder's type would fabricate one (DESIGN 5), and recording
// the binder untyped would let the match frontier accept the arm (fail-open); the distinct case is
// what keeps both unwritable.
type LexicalBinderStanding
  = LexicalDeclared { node: Node }
  | LexicalValued { node: Node }
  | LexicalOwedFormal { field_type: Node }
  | LexicalUntyped

type LexicalBinding {
  binder_site: NodeOccurrenceIdentity
  standing: LexicalBinderStanding
}

// One answered lexical reference: the reference's own minted occurrence and the binding that
// answered it. The walk accumulates these beside the tree it builds (ResolveWalkAccepted.lexical).
type LexicalBindingEntry {
  reference: OccurrenceId
  binding: LexicalBinding
}

// type_scope IS THE TYPE-ROLE FRAME: the scope a name in a TYPE position resolves in. It is the
// enclosing Arrows' type-parameter frames over the namespace root, and it never carries a value
// binder (a parameter, a `let`, an arm binder), so a type position cannot bind a value and a value
// position -- which resolves in `scope` -- cannot bind a type parameter. resolve_arrow_node opens a
// fn's <T> on it over the WHOLE Arrow, signature and body; only type-role walks consult it
// (resolve_type_role_target).
type ResolveContext {
  scope: Scope
  type_scope: Scope
  namespace: Namespace
  policy: NameResolutionPolicy
  position: QualifiedName
  lm: LanguageModel
  under_module_root: Bool
  declaring: DeclaringPosition
}

// WHERE THE WALK STANDS IN THE CONTAINMENT TREE, IN THE PATH v2.compiler.symbol_index_fill KEYS
// DECLARATIONS BY. It is not `position`, which is a LOOKUP position and counts every named edge; the
// fill's path skips parse-tree projection edges and module-header metadata, and at a namespace spine
// it jumps to the module body without extending the path. The step below asks the fill's own
// predicates (v2.compiler.parse parse_tree_projection_edge, v2.extdeps.languages.dag
// dag_surface_module_header_metadata_edge and namespace_graft_spine_body_optional), so the two
// cannot disagree about where a declaration lives. DeclaringInSpine carries the spine's module body:
// until the walk reaches it, no edge extends the path. Below an Arrow nothing is containment
// (NotDeclaring), so an Arrow met there -- a lambda -- opens a LexicalFrame.
type DeclaringPosition
  = DeclaringAt { path: QualifiedName }
  | DeclaringInSpine { path: QualifiedName, body: Node }
  | NotDeclaring

type DeclaredBinding {
  name: Symbol
}

fn empty_edge_list() -> List<Edge> {
  []
}

fn empty_namespace() -> Namespace {
  Namespace {
    bindings: empty_map(),
    canonical_symbols: empty_canonical_symbol_set(),
    symbol_index: empty_symbol_index(),
    module_qn: Empty,
    test_code: test_code_index_empty(),
    declared_in: Empty,
    imported_origins: empty_map()
  }
}

fn empty_canonical_symbol_set() -> PointwisePower<Symbol> {
  PointwisePower {
    member: fn(_) {
      false
    }
  }
}

fn try_edge_declared_binding(e: Edge) -> DeclaredBinding? {
  match e.label {
    Authored { name: sym } => optional_present(value: DeclaredBinding { name: sym })
    StructuralLabel { label: _ } => optional_absent()
    Positional => optional_absent()
  }
}

// THE ONE ADMISSION FOR A VALUE BINDER, whatever spelling introduced it: an Arrow's parameters, a
// `let`, a match-arm binder, a loop carrier. Before this, each site harvested its own names straight
// into a ScopeFrame and no site judged them, so two questions had no owner at all -- whether a frame
// binds one name twice, and whether a binder hides a value that is already visible. The type-parameter
// frame already answered the second for TYPE binders
// (resolve_reason_type_parameter_shadows_visible_name, refused at the binder); this is the same
// discipline for value binders, in one place rather than four.
//
// WHAT COUNTS AS HIDING IS A LEXICAL FACT, AND ONLY A LEXICAL FACT. The chain answers BoundInFrame for
// an enclosing binder and BoundAtRoot for a module-namespace binding (lookup_chain / ScopeBinding), and
// ONLY BoundInFrame refuses. So a binder spelled like a declaration in some other module -- imported or
// not -- is admitted: an unrelated declaration elsewhere in the corpus may not decide whether a local
// binder is legal, which is the defect this slice was opened on. A binder spelled like a name at the
// module root is likewise admitted; shadowing a root declaration is ordinary, hiding an enclosing
// BINDER is not.
//
// IT RETURNS A VERDICT RATHER THAN A MAP, so a refusal is located at the binder and cannot be silently
// widened into an empty frame -- an empty frame would leave the binder unbound and send its uses to the
// global lookup, which is exactly how `found` in a fold step came to be read as a name declared in
// several modules.
type BinderAdmission
  = BindersAdmitted { locals: Map<Symbol, Symbol> }
  | BinderDuplicateInFrame { binder: Symbol }
  | BinderHidesVisibleValue { binder: Symbol }

fn admit_value_binders(names: List<Symbol>, outer: Scope) -> BinderAdmission {
  fold(names, init: BindersAdmitted { locals: empty_map() }, f: fn(acc, name) {
    match acc {
      BinderDuplicateInFrame { binder: b } => BinderDuplicateInFrame { binder: b }
      BinderHidesVisibleValue { binder: b } => BinderHidesVisibleValue { binder: b }
      BindersAdmitted { locals: m } =>
        match v2.std.collection.map_lookup(m: m, key: name) {
          Present { value: _ } => BinderDuplicateInFrame { binder: name }
          Absent => admit_one_value_binder(locals: m, name: name, outer: outer)
        }
    }
  })
}

// AN ANONYMOUS SLOT HIDES NOTHING. Hiding is the risk that a body reference silently rebinds to the
// inner binder; an anonymous slot's label is unauthorable (v2.std.anonymous_binder), so no reference
// can name it. Its label is its position in its OWN list (ruled there), so nested Arrows each mint
// `<anonymous-parameter-1>`: `fn(Int) -> fn(Int) -> Int` was refused as hiding. It still enters the
// frame, so the duplicate-in-frame check above applies to it.
fn admit_one_value_binder(locals: Map<Symbol, Symbol>, name: Symbol, outer: Scope) -> BinderAdmission {
  if is_anonymous_param_label(sym: name) {
    BindersAdmitted { locals: map_insert(locals, name, name) }
  } else {
    admit_one_named_value_binder(locals: locals, name: name, outer: outer)
  }
}

fn admit_one_named_value_binder(locals: Map<Symbol, Symbol>, name: Symbol, outer: Scope) -> BinderAdmission {
  match lookup_chain(s: outer, name: name) {
    Rejected { diagnostics: _ } => BindersAdmitted { locals: map_insert(locals, name, name) }
    Accepted { value: bound, diagnostics: _ } =>
      match bound {
        BoundInFrame { canonical: _, kind: _ } => BinderHidesVisibleValue { binder: name }
        BoundAtRoot { canonical: _ } => BindersAdmitted { locals: map_insert(locals, name, name) }
        ScopeUnbound => BindersAdmitted { locals: map_insert(locals, name, name) }
      }
  }
}

fn binder_duplicate_in_frame_diagnostic(binder: Symbol, at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_binder_duplicate_in_frame,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn binder_hides_visible_value_diagnostic(binder: Symbol, at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_binder_hides_visible_value,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// THE NAMES EACH BINDER SITE INTRODUCES, as LISTS rather than maps, because a map cannot answer the
// question the admission asks. map_insert silently overwrites, so a frame built by insertion cannot tell
// a duplicate binder from a single one -- the duplicate is exactly what must refuse. These collectors
// mirror the frame builders beside them (arrow_domain_frame_binders, resolve_pattern_binders,
// bind_frame_binders): an Arrow's list is the AUTHORED Named binders of its domain Conj, the same edges
// arrow_domain_frame_binders binds.
fn arrow_domain_binder_name_list(n: Node) -> List<Symbol> {
  match n.kind {
    TypeNode { connective: Arrow } =>
      match arrow_first_positional_target(children: n.children) {
        FirstPositionalFound { target: domain } => conj_named_binder_name_list(root: domain)
        FirstPositionalAbsent => []
      }
    TypeNode { connective: _ } => []
    ComputationNode { behavior: _ } => []
  }
}

fn conj_named_binder_name_list(root: Node) -> List<Symbol> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: [], f: fn(acc, e) {
        match try_edge_declared_binding(e: e) {
          Present { value: b } => list_snoc_item(xs: acc, item: b.name)
          Absent => acc
        }
      })
    TypeNode { connective: _ } => []
    ComputationNode { behavior: _ } => []
  }
}

// A match arm's list mirrors resolve_pattern_binders exactly, including its two exclusions: a wildcard
// binds nothing, and a field target that names a CONSTRUCTOR is a nested pattern, not a binder.
fn pattern_binder_name_list(ctx: ResolveContext, pat: Node) -> List<Symbol> {
  match construct_tag_optional(n: pat) {
    Absent => []
    Present { value: _ } =>
      fold(construct_field_edges(n: pat), init: [], f: fn(acc, e) {
        match e.target.kind {
          TypeNode { connective: Atom { identity: id } } =>
            if is_wildcard_pattern(pattern: e.target) {
              acc
            } else if resolve_pattern_atom_names_constructor(ctx: ctx, id: id) {
              acc
            } else {
              list_snoc_item(xs: acc, item: id)
            }
          TypeNode { connective: _ } => concat(acc, pattern_binder_name_list(ctx: ctx, pat: e.target))
          ComputationNode { behavior: _ } => concat(acc, pattern_binder_name_list(ctx: ctx, pat: e.target))
        }
      })
  }
}

// A `let`'s list mirrors bind_frame_binders: the binder is the FIRST positional child, and that
// subtree's atoms are collected. For an ordinary `let x = e` that subtree is the single binder atom.
fn bind_binder_name_list(n: Node) -> List<Symbol> {
  match n.kind {
    ComputationNode { behavior: Bind } =>
      if positional_child_count(children: n.children) == 3 {
        match first(positional_edges(children: n.children)) {
          Present { value: e0 } => atom_name_list(root: e0.target)
          Absent => []
        }
      } else {
        []
      }
    TypeNode { connective: _ } => []
    ComputationNode { behavior: _ } => []
  }
}

fn atom_name_list(root: Node) -> List<Symbol> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(n0) {
        match n0.kind {
          TypeNode { connective: Atom { identity: sym } } => [sym]
          TypeNode { connective: _ } => []
          ComputationNode { behavior: _ } => []
        }
      },
      step: fn(acc, _e, child) { concat(acc, child) }
    }
  )
}

// THE ADMISSION AS A GATE OVER A SITE'S OWN FRAME. Each site keeps the frame its harvester already built
// -- so an admitted binder resolves exactly as it did before this change -- and the gate only decides
// whether the site proceeds at all. That separation is deliberate: it makes the new behaviour purely a
// set of refusals, with no chance of silently changing which name a body binds to.
type BinderGate
  = BinderGateAdmitted
  | BinderGateRefused { diagnostic: Diagnostic }

fn gate_value_binders(names: List<Symbol>, outer: Scope, at: Node) -> BinderGate {
  match admit_value_binders(names: names, outer: outer) {
    BindersAdmitted { locals: _ } => BinderGateAdmitted
    BinderDuplicateInFrame { binder: b } =>
      BinderGateRefused { diagnostic: binder_duplicate_in_frame_diagnostic(binder: b, at: at) }
    BinderHidesVisibleValue { binder: b } =>
      BinderGateRefused { diagnostic: binder_hides_visible_value_diagnostic(binder: b, at: at) }
  }
}

fn harvest_conj_named_bindings(root: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: acc, f: fn(a, e) {
        match try_edge_declared_binding(e: e) {
          Present { value: b } => map_insert(a, b.name, b.name)
          Absent => a
        }
      })
    TypeNode { connective: Atom { identity: _ } } => acc
    TypeNode { connective: Disj } => acc
    TypeNode { connective: Arrow } => acc
    TypeNode { connective: Cardinality } => acc
    TypeNode { connective: Instantiation } => acc
    ComputationNode { behavior: Value } => acc
    ComputationNode { behavior: Transform } => acc
    ComputationNode { behavior: Branch } => acc
    ComputationNode { behavior: Loop } => acc
    ComputationNode { behavior: Bind } => acc
    ComputationNode { behavior: Match } => acc
  }
}

data resolve_variant_visibility_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.compiler.symbol_index_fill",
    decl_name: "symbol_index_fill_containment_node",
    field: WholeDeclaration
  }
}

// THE ONE ANSWER TO "WHAT DOES THIS MODULE'S ROOT BIND", for every door that builds a Namespace. A module
// root's own declarations live under its grafted body, not as direct children of the root, so the harvest
// reads both: the root's direct named members and, where the graft collected one, the body's. Two doors
// built a Namespace -- build_program_namespace grafted the body, v2.compiler.name_resolve
// admitted_subject_from_bindings did not -- so on the admission route a module's own `data` value was
// absent from the scope chain and `cfg.field` answered ScopeUnbound. One harvest here is what keeps the two
// from disagreeing again.
fn namespace_bindings_augment_from_module_atoms(
  root: Node,
  bindings: Map<Symbol, Symbol>
) -> Map<Symbol, Symbol> {
  let root_bindings = harvest_module_root_named_bindings(root: root, acc: bindings)
  match namespace_graft_module_body_optional(root: root) {
    Present { value: body } => harvest_module_root_named_bindings(root: body, acc: root_bindings)
    Absent => root_bindings
  }
}

// A MODULE ROOT'S BARE BINDINGS OMIT ITS SERVICE NAMESPACES (the operator's nesting ban; XL-2 service
// spine). A named edge whose target is a marked namespace body -- the prefix `s` of `service s.F` -- is a
// path segment, never a lexical binding: its members stay reachable by their qualified paths through the
// symbol index, and v2.std.symbol_index NamespaceBodyDeclared keeps the index walk from answering with
// it. This is the same classification at the module root's binding harvest, which resolve consults
// before the index. Module-root only: an Arrow domain's binders (add_arrow_domain_named_params) are
// harvested by harvest_conj_named_bindings, unchanged.
fn harvest_module_root_named_bindings(root: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  match root.kind {
    TypeNode { connective: c } =>
      match c {
        Conj => harvest_module_root_conj_bindings(root: root, acc: acc)
        Atom { identity: _ } => acc
        Disj => acc
        Arrow => acc
        Cardinality => acc
        Instantiation => acc
      }
    ComputationNode { behavior: _ } => acc
  }
}

// Only a Conj root has named members to harvest; every other node kind binds nothing at the module root.
fn harvest_module_root_conj_bindings(root: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  fold(root.children, init: acc, f: fn(a, e) {
    if module_binding_edge_is_namespace_body(e: e) {
      a
    } else {
      match try_edge_declared_binding(e: e) {
        Present { value: b } => map_insert(a, b.name, b.name)
        Absent => a
      }
    }
  })
}

fn module_binding_edge_is_namespace_body(e: Edge) -> Bool {
  match e.label {
    Authored { name: _ } => namespace_graft_node_is_module_body(node: e.target)
    StructuralLabel { label: _ } => false
    Positional => false
  }
}

// A FRAME'S BINDERS, BUILT ONCE: the name each binder answers (locals, what lookup_chain reads) and,
// for a Lexical frame, the binding its references are keyed to. One builder fills both, so the set a
// frame answers for and the set it can key are the same set by construction.
type FrameBinders {
  locals: Map<Symbol, Symbol>
  binders: Map<Symbol, LexicalBinding>
}

fn frame_binders_empty() -> FrameBinders {
  FrameBinders { locals: empty_map(), binders: empty_map() }
}

fn frame_binders_add(fb: FrameBinders, name: Symbol, binding: LexicalBinding) -> FrameBinders {
  FrameBinders {
    locals: map_insert(fb.locals, name, name),
    binders: map_insert(fb.binders, name, binding)
  }
}

fn lexical_frame(fb: FrameBinders, outer: Scope) -> Scope {
  ScopeFrame { locals: fb.locals, outer: outer, kind: LexicalFrame { binders: fb.binders } }
}

// An Arrow's domain binders: each Named domain edge, sited at the Arrow (the label is not a node),
// with its declared type. Only a Named binder binds (v2.std.node A4: a domain is a Conj of Named
// binders with its declared order).
fn arrow_domain_frame_binders(n: Node) -> FrameBinders {
  match n.kind {
    TypeNode { connective: Arrow } =>
      match arrow_first_positional_target(children: n.children) {
        FirstPositionalFound { target: domain } =>
          match domain.kind {
            TypeNode { connective: Conj } =>
              fold(domain.children, init: frame_binders_empty(), f: fn(fb, e) {
                match try_edge_declared_binding(e: e) {
                  Present { value: b } =>
                    frame_binders_add(
                      fb: fb,
                      name: b.name,
                      binding: LexicalBinding {
                        binder_site: n.occurrence_id,
                        standing: match member_edge_type_node(e: e) {
                          Present { value: t } => LexicalDeclared { node: t }
                          Absent => LexicalUntyped
                        }
                      }
                    )
                  Absent => fb
                }
              })
            _ => frame_binders_empty()
          }
        FirstPositionalAbsent => frame_binders_empty()
      }
    _ => frame_binders_empty()
  }
}

// A `let`'s binder: its first positional child, an atom, sited at itself.
fn bind_frame_binders(n: Node) -> FrameBinders {
  match n.kind {
    ComputationNode { behavior: Bind } =>
      if positional_child_count(children: n.children) == 3 {
        match first(positional_edges(children: n.children)) {
          Present { value: e0 } =>
            match e0.target.kind {
              TypeNode { connective: Atom { identity: sym } } =>
                frame_binders_add(
                  fb: frame_binders_empty(),
                  name: sym,
                  binding: LexicalBinding {
                    binder_site: e0.target.occurrence_id,
                    standing: match list_at_optional(xs: node_positional_child_targets(node: n), index: 1) {
                      Present { value: v } => LexicalValued { node: v }
                      Absent => LexicalUntyped
                    }
                  }
                )
              _ => frame_binders_empty()
            }
          Absent => frame_binders_empty()
        }
      } else {
        frame_binders_empty()
      }
    _ => frame_binders_empty()
  }
}

// THE MODULE'S OWN DECLARATIONS BIND AT THE ROOT OF A SINGLE-TREE NAMESPACE. A grafted module
// keeps them in its marked body under the containment spine, not as the root's named edges, so
// harvesting the root alone left every module-level declaration unbound on this route: a module's
// own `type Int` fell through to the kernel spelling and was silently bound to the kernel Int
// (review 5342739525 on #12540). The body is selected by the graft's own mark
// (v2.compiler.namespace_graft namespace_graft_module_body_optional), never by walking names, so
// a missing or ambiguous step stops and a record that shares a segment's name is not a body.
// A SINGLE TREE'S INDEX IS ITS OWN DECLARATIONS, BY THE ONE FILL. The program route's symbol_index is
// the corpus fill; a single tree's is the same fold (v2.compiler.symbol_index_fill
// symbol_index_fill_module_declarations) over its one root, keyed at its module's paths. Parameter
// references are verified against it (resolve_frame_bound_reference), so both routes verify against
// the index each resolves through -- one authority, not a second table beside it.
// THE INDEX'S KEYS AND THE LOOKUP'S POSITION ARE THE SAME PATH. The fill keys every declaration under
// the module's own path, so module_qn -- the position an index lookup starts from -- is that path too,
// as it is for the admitted subject. With module_qn left Empty, a name that is not a root binding (a
// variant in value position) was looked up from the corpus root and refused unbound. And the fill takes
// the record names the tree carries, as it takes its resource names: with Empty, no declaration was
// marked RecordTypePayload, so every headless record literal refused as not a record.
fn build_program_namespace(tree: NormalizedTree, lm: LanguageModel) -> Namespace {
  let declared_in = namespace_tree_module_qn(tree: tree)
  let bindings = namespace_bindings_augment_from_module_atoms(
    root: tree.root,
    bindings: empty_map()
  )
  Namespace {
    bindings: bindings,
    canonical_symbols: lm.canonical_symbols,
    symbol_index: symbol_index_fill_module_declarations(index: empty_symbol_index(), root: tree.root, record_declarations: normalized_tree_record_declarations(t: tree), resource_declarations: normalized_tree_resource_declarations(t: tree)),
    module_qn: declared_in,
    test_code: test_code_index_add_module(
      index: test_code_index_empty(),
      module_qn: declared_in,
      channel: tree.test_markers
    ),
    declared_in: declared_in,
    imported_origins: empty_map()
  }
}

// The path a single tree's declarations live under: its module_qn, its index keys and its test-code
// index all read it. A root that names no module keys them under Empty, which is the same key both
// sides of the lookup use.
fn namespace_tree_module_qn(tree: NormalizedTree) -> QualifiedName {
  match qualified_name_from_module_node(root: tree.root) {
    Accepted { value: qn, diagnostics: _ } => qn
    Rejected { diagnostics: _ } => Empty
  }
}

fn scope_from_namespace(namespace: Namespace) -> Scope {
  ScopeRoot { module: namespace }
}

fn scope_root_module(s: Scope) -> Namespace {
  match s {
    ScopeFrame { outer: o, locals: _, kind: _ } => scope_root_module(s: o)
    ScopeRoot { module: m } => m
  }
}

fn resolve_ctx_init(
  namespace: Namespace,
  lm: LanguageModel,
  policy: NameResolutionPolicy
) -> ResolveContext {
  ResolveContext {
    scope: scope_from_namespace(namespace: namespace),
    type_scope: scope_from_namespace(namespace: namespace),
    namespace: namespace,
    policy: policy,
    position: namespace.module_qn,
    lm: lm,
    under_module_root: false,
    declaring: resolve_declaring_root(namespace: namespace)
  }
}

fn resolve_ctx_with_scope(ctx: ResolveContext, scope: Scope) -> ResolveContext {
  ResolveContext {
    scope: scope,
    type_scope: ctx.type_scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: ctx.position,
    lm: ctx.lm,
    under_module_root: ctx.under_module_root,
    declaring: ctx.declaring
  }
}

fn resolve_ctx_with_type_scope(ctx: ResolveContext, type_scope: Scope) -> ResolveContext {
  ResolveContext {
    scope: ctx.scope,
    type_scope: type_scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: ctx.position,
    lm: ctx.lm,
    under_module_root: ctx.under_module_root,
    declaring: ctx.declaring
  }
}

// THE ONE TYPE-ROLE ENTRY. A type expression carried in a body -- a cast's target
// (v2.std.type_binder <cast-target>) or a let's annotation (<type-annotation>) -- resolves here: in the type-role
// frame, so the enclosing fn's <T> binds it and no value binder can, and an undeclared name refuses
// located at that name.
fn resolve_type_role_target(ctx: ResolveContext, target: Node) -> ResolveNodeWalk {
  resolve_node_walk(ctx: resolve_ctx_with_scope(ctx: ctx, scope: ctx.type_scope), n: target)
}

fn resolve_ctx_snoc_position(ctx: ResolveContext, segment: Symbol) -> ResolveContext {
  ResolveContext {
    scope: ctx.scope,
    type_scope: ctx.type_scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: qualified_name_snoc(qn: ctx.position, segment: segment),
    lm: ctx.lm,
    under_module_root: ctx.under_module_root,
    declaring: ctx.declaring
  }
}

fn resolve_ctx_leaving_containment(ctx: ResolveContext) -> ResolveContext {
  ResolveContext {
    scope: ctx.scope,
    type_scope: ctx.type_scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: ctx.position,
    lm: ctx.lm,
    under_module_root: ctx.under_module_root,
    declaring: NotDeclaring
  }
}

// THE WALK STARTS DECLARING ONLY WHERE THE FILL STARTS INDEXING: at a root whose module name reads
// (v2.compiler.symbol_index_fill symbol_index_fill_module_declarations indexes nothing otherwise),
// which the namespace records as a non-empty declared_in. A tree with no module -- a bare Arrow
// handed to resolve -- declares nothing, so its Arrow's frame is Lexical, never a ParameterFrame over
// a path no index can hold.
fn resolve_declaring_root(namespace: Namespace) -> DeclaringPosition {
  match namespace.declared_in {
    Empty => NotDeclaring
    Cons { head: _, tail: _ } => DeclaringAt { path: namespace.declared_in }
  }
}

fn resolve_ctx_with_declaring(ctx: ResolveContext, declaring: DeclaringPosition) -> ResolveContext {
  ResolveContext {
    scope: ctx.scope,
    type_scope: ctx.type_scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: ctx.position,
    lm: ctx.lm,
    under_module_root: ctx.under_module_root,
    declaring: declaring
  }
}

// ONE NAMED EDGE'S STEP, AS THE FILL TAKES IT (v2.compiler.symbol_index_fill
// symbol_index_fill_containment_edge): metadata and projection edges keep the path, every other
// label extends it.
fn resolve_declaring_across_named_edge(declaring: DeclaringPosition, e: Edge) -> DeclaringPosition {
  match declaring {
    DeclaringAt { path: path } =>
      match e.label {
        StructuralLabel { label: _ } =>
          if dag_surface_module_header_metadata_edge(e: e) || binder_node_edge(e: e) {
            declaring
          } else {
            DeclaringAt { path: qualified_name_snoc(qn: path, segment: label_sort_key(label: e.label)) }
          }
        Authored { name: name } =>
          if parse_tree_projection_edge(name: name) {
            declaring
          } else {
            DeclaringAt { path: qualified_name_snoc(qn: path, segment: name) }
          }
        Positional => declaring
      }
    DeclaringInSpine { path: _, body: _ } => declaring
    NotDeclaring => declaring
  }
}

// ENTERING A NODE, AS THE FILL ENTERS IT (symbol_index_fill_containment_node): a Conj whose namespace
// spine ends at a module body keeps the path until that body is reached, and reaching it resumes.
fn resolve_declaring_entering(declaring: DeclaringPosition, n: Node) -> DeclaringPosition {
  match declaring {
    DeclaringAt { path: path } =>
      match n.kind {
        TypeNode { connective: Conj } =>
          match namespace_graft_spine_body_optional(node: n) {
            Present { value: body } => DeclaringInSpine { path: path, body: body }
            Absent => declaring
          }
        _ => declaring
      }
    DeclaringInSpine { path: path, body: body } =>
      if n == body { DeclaringAt { path: path } } else { declaring }
    NotDeclaring => declaring
  }
}

fn resolve_ctx_with_under_module_root(ctx: ResolveContext, under_module_root: Bool) -> ResolveContext {
  ResolveContext {
    scope: ctx.scope,
    type_scope: ctx.type_scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: ctx.position,
    lm: ctx.lm,
    under_module_root: under_module_root,
    declaring: ctx.declaring
  }
}

// Which scope answered a name, in the one walk that finds it. A local binder shadows the module
// scope, so only a ROOT hit can be a reference to a module-level declaration, and the test-code wall
// (resolve_atom_bound) reads that distinction from here rather than re-walking the chain.
type ScopeBinding
  = BoundInFrame { canonical: Symbol, kind: FrameKind }
  | BoundAtRoot { canonical: Symbol }
  | ScopeUnbound

fn lookup_chain(s: Scope, name: Symbol) -> Outcome<ScopeBinding> {
  match s {
    ScopeFrame { locals: m, outer: o, kind: kind } =>
      match v2.std.collection.map_get_checked(m, name) {
        Accepted { value: opt, diagnostics: d_here } => match opt {
          Present { value: v } =>
            Accepted { value: BoundInFrame { canonical: v, kind: kind }, diagnostics: d_here }
          Absent =>
            match lookup_chain(s: o, name: name) {
              Accepted { value: found, diagnostics: d_outer } =>
                Accepted {
                  value: found,
                  diagnostics: diagnostics_merge(outer: d_here, inner: d_outer)
                }
              Rejected { diagnostics: ds } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: d_here, rejected: ds)
                }
            }
        }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    ScopeRoot { module: mod } =>
      match v2.std.collection.map_get_checked(mod.bindings, name) {
        Accepted { value: opt, diagnostics: d } => match opt {
          Present { value: v } => Accepted { value: BoundAtRoot { canonical: v }, diagnostics: d }
          Absent => Accepted { value: ScopeUnbound, diagnostics: d }
        }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
  }
}

// THE RESOLVE STAGE'S FATAL REFUSAL-REASON VOCABULARY, CLOSED (v2.std.parse_refusal_reason's shape,
// homed in the stage that refuses). A reason is FATAL when it can stand last in a rejection -- the
// cause that refused; the advisories that ride in front of one (declared elsewhere, the ambiguity
// class, the competing declarations) are not members. The type is the roster the frontier
// ownership join reflects (gunbc.refusal_reason_ownership_join), so a resolve refusal that no
// variant names is not producible by that join's reckoning. The producers still spell the Symbol
// directly; each moves onto this vocabulary in the stage's replacement cut, which deletes the
// literal in the same change.
type ResolveRefusalReason
  = ResolveMalformedTree
  | ResolveUnboundSymbol
  | ResolveAnonymousParameterReferenced
  | ResolveTypeParameterInValuePosition
  | ResolveFloatLiteralNotLowered
  | ResolveAmbiguousSymbol
  | ResolveTestCodeReferenced
  | ResolveKernelTypeSpellingNamesAForeignDeclaration
  | ResolveObservationIncomplete
  | ResolveTypeParameterShadowsVisibleName

// The diagnostic identity each reason refuses under (`v2.std.diagnostic` `Diagnostic.reason`).
fn resolve_refusal_reason_symbol(reason: ResolveRefusalReason) -> Symbol {
  match reason {
    ResolveMalformedTree => ^resolve_reason_malformed_tree
    ResolveUnboundSymbol => ^resolve_reason_unbound_symbol
    ResolveAnonymousParameterReferenced => ^resolve_reason_anonymous_parameter_referenced
    ResolveTypeParameterInValuePosition => ^resolve_reason_type_parameter_in_value_position
    ResolveFloatLiteralNotLowered => ^float_literal_not_lowered
    ResolveAmbiguousSymbol => ^resolve_reason_ambiguous_symbol
    ResolveTestCodeReferenced => ^resolve_reason_test_code_referenced
    ResolveKernelTypeSpellingNamesAForeignDeclaration => ^resolve_reason_kernel_type_spelling_names_a_foreign_declaration
    ResolveObservationIncomplete => ^resolve_reason_observation_incomplete
    ResolveTypeParameterShadowsVisibleName => ^resolve_reason_type_parameter_shadows_visible_name
  }
}

fn malformed_tree_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_malformed_tree,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn unbound_symbol_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_unbound_symbol,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// A `_` IN VALUE POSITION NAMES NOTHING, AND THE REFUSAL SAYS WHY. An anonymous parameter slot is
// bound under a minted label no source can spell (v2.std.anonymous_binder), so a `_` reaching an
// atom lookup finds no binder by construction -- the slot is never referenceable. The generic
// unbound-symbol refusal would be true but would send the author looking for a missing declaration;
// this cause names the actual rule. It is located at the mention's own occurrence, never at the
// slot's label, which carries none.
fn anonymous_parameter_referenced_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_anonymous_parameter_referenced,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// AN UNBOUND NAME THE CORPUS DOES DECLARE IS A MISSING BINDING, NOT A TYPO, AND THE REFUSAL SAYS SO.
// Deleting the corpus-wide spelling search makes a reference refuse when nothing on its chain binds
// it -- correct, and the point of the package -- but on its own it hands the author of a module
// that was quietly relying on that search a bare "unbound symbol here". That population is not
// hypothetical: a lane with no knowledge of this work (gunbc#12035) found a production reference
// resolving with nothing importing it, confirmed by a mutation that reds. Every such module starts
// refusing when the search goes, and the difference between a diagnostic they can act on and a
// puzzle is whether the refusal names where the name IS declared.
//
// THE ORACLE IS THE RIGHT SOURCE FOR THIS AND THE WRONG SOURCE FOR RESOLUTION, which is the whole
// distinction docs/plans/namespace-resolution-design.md section 13 draws when it keeps global_bare
// as a migration oracle after deleting it as a mechanism. Asking the corpus "does this spelling
// exist anywhere" may not CHOOSE a meaning -- that is the defect -- but it is exactly the right
// question for explaining an absence. So the advisory rides in front and the fatal stays last, the
// carriage order every consumer folds to; the advisory carries a DeclarationLocus so the author is
// pointed at a declaration rather than a spelling.
//
// IT DISCRIMINATES THE TWO CAUSES, which is why the third arm exists rather than defaulting: a name
// no module declares gets NO advisory, because the honest reading there is a typo or a deleted
// declaration and pointing anywhere would be fabrication.
// A TYPE PARAMETER NAMED IN A VALUE POSITION is not an unknown name: the type-role frame binds it,
// and the value scope deliberately does not. It refuses with its own reason, located at the use.
fn type_parameter_in_value_position_optional(ctx: ResolveContext, n: Node, name: Symbol) -> Optional<Diagnostic> {
  match lookup_chain(s: ctx.type_scope, name: name) {
    Accepted { value: BoundInFrame { canonical: _, kind: _ }, diagnostics: _ } =>
      optional_present(
        value: Diagnostic {
          reason: ^resolve_reason_type_parameter_in_value_position,
          at: node_locus(node: n),
          correction: Unavailable { reason: UserInputBoundary }
        }
      )
    Accepted { value: BoundAtRoot { canonical: _ }, diagnostics: _ } => optional_absent()
    Accepted { value: ScopeUnbound, diagnostics: _ } => optional_absent()
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn unbound_symbol_diagnostics(ctx: ResolveContext, n: Node, name: Symbol) -> NonEmptyDiagnostics {
  match type_parameter_in_value_position_optional(ctx: ctx, n: n, name: name) {
    Present { value: d } => NonEmptyDiagnostics { head: d, tail: [] }
    Absent => unbound_symbol_diagnostics_of_value_name(ctx: ctx, n: n, name: name)
  }
}

fn unbound_symbol_diagnostics_of_value_name(ctx: ResolveContext, n: Node, name: Symbol) -> NonEmptyDiagnostics {
  let fatal = unbound_symbol_diagnostic(n: n)
  match symbol_index_global_unique_lookup(index: ctx.namespace.symbol_index, name: name) {
    GlobalBareHit { node: _, path: path } =>
      NonEmptyDiagnostics {
        head: Diagnostic {
          reason: ^resolve_unbound_name_is_declared_elsewhere,
          at: declaration_locus(declaration: path),
          correction: Unavailable { reason: UserInputBoundary }
        },
        tail: [fatal]
      }
    GlobalBareLookupAmbiguous { paths: _ } =>
      NonEmptyDiagnostics {
        head: Diagnostic {
          reason: ^resolve_unbound_name_is_declared_in_several_modules,
          at: node_locus(node: n),
          correction: Unavailable { reason: UserInputBoundary }
        },
        tail: [fatal]
      }
    GlobalBareLookupUnbound => NonEmptyDiagnostics { head: fatal, tail: [] }
  }
}

fn float_literal_not_lowered_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^float_literal_not_lowered,
    at: node_locus(node: n),
    correction: Unavailable { reason: CorrectionNotModeled }
  }
}

fn ambiguous_symbol_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_ambiguous_symbol,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// WHICH LOOKUP WAS AMBIGUOUS, AND BETWEEN WHAT. The three lookups that can answer "two binders"
// are different questions -- the lexical chain from the referencing position upward, the
// corpus-wide bare-name index, and a dotted path whose head is bound on the chain while the
// whole path also hits absolutely -- and a reader repairing the reference needs to know which
// one, because the repair differs (qualify the reference; rename one declaration; drop the
// shadowing binder). The competing declarations ride WHERE THE LOOKUP RETAINED THEM: the lexical
// collector keeps every candidate's path; the qualified case names the absolute path that
// competed. Collapsing them to one bare SymbolIndexAtomAmbiguous was where the class and the
// candidates were dropped -- one symbol standing where the resolver had a list.
//
// THE THIRD ARM IS GONE WITH ITS MECHANISM. AmbiguousOnGlobalBare reported an ambiguity found by
// searching the corpus for a spelling, and it was the one arm that could name NO competing
// declaration, because the bare index had already collapsed its binders at fill time. Deleting the
// search deleted the arm: every ambiguity the resolver can now reach was found among candidates it
// still holds, so "competing declarations where available" is no longer a caveat this type needs.
type AmbiguousLookupClass
  = AmbiguousOnLexicalChain { candidates: FreeMonoid<LexicalBindingCandidate> }
  | AmbiguousAtBindingPosition { candidates: FreeMonoid<LexicalBindingCandidate> }
  | AmbiguousQualifiedHeadShadowsAbsolute { path: QualifiedName }

fn ambiguous_lookup_class_diagnostic(n: Node, reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// A COMPETING DECLARATION IS NAMED BY ITS QUALIFIED IDENTITY, NOT CARRIED AS ITS NODE. The index
// holds each binder's declaration node, and locating the row there would drag the binder's whole
// body into every persisted row that reports the ambiguity; DeclarationLocus is the citation form
// (DESIGN section 3: name the symbol, not the position), and it is all a reader needs to find it.
fn ambiguous_competing_declaration_diagnostic(path: QualifiedName) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_ambiguous_competing_declaration,
    at: declaration_locus(declaration: path),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// THE ORDER IS CARRIAGE ORDER: class first, competing declarations next, the refusal LAST. The
// fatal diagnostic of a rejection is its last one (rejected_with_pending prepends what rode
// along; every consumer that folds to the cause folds to the tail), so the class row and the
// candidate rows sit in the advisory position and resolve_reason_ambiguous_symbol keeps its place
// as the reason every roster owns. A consumer that read the HEAD as the cause read an advisory
// whenever any pending diagnostic was merged in front; that reading was never the contract.
fn ambiguous_symbol_diagnostics(n: Node, class: AmbiguousLookupClass) -> NonEmptyDiagnostics {
  let fatal = ambiguous_symbol_diagnostic(n: n)
  match class {
    AmbiguousOnLexicalChain { candidates: candidates } =>
      NonEmptyDiagnostics {
        head: ambiguous_lookup_class_diagnostic(n: n, reason: ^resolve_ambiguous_on_lexical_chain),
        tail: list_snoc_item(
          xs: fold_list(
            xs: candidates,
            empty: Empty,
            cons: fn(acc, candidate) {
              list_snoc_item(xs: acc, item: ambiguous_competing_declaration_diagnostic(path: candidate.path))
            }
          ),
          item: fatal
        )
      }
    AmbiguousAtBindingPosition { candidates: candidates } =>
      NonEmptyDiagnostics {
        head: ambiguous_lookup_class_diagnostic(n: n, reason: ^resolve_ambiguous_at_binding_position),
        tail: list_snoc_item(
          xs: fold_list(
            xs: candidates,
            empty: Empty,
            cons: fn(acc, candidate) {
              list_snoc_item(xs: acc, item: ambiguous_competing_declaration_diagnostic(path: candidate.path))
            }
          ),
          item: fatal
        )
      }
    AmbiguousQualifiedHeadShadowsAbsolute { path: path } =>
      NonEmptyDiagnostics {
        head: ambiguous_lookup_class_diagnostic(n: n, reason: ^resolve_ambiguous_qualified_head_shadows_absolute),
        tail: [ambiguous_competing_declaration_diagnostic(path: path), fatal]
      }
  }
}

fn namespace_has_canonical_symbol(namespace: Namespace, name: Symbol) -> Bool {
  namespace.canonical_symbols.member(name)
}

fn canonical_atom(identity: Symbol, occurrence_id: NodeOccurrenceIdentity) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: occurrence_id
  )
}

fn symbol_index_lookup_position(ctx: ResolveContext) -> QualifiedName {
  match ctx.policy {
    NamespaceOnlyY => ctx.position
    ImportScoped => ctx.namespace.module_qn
  }
}

// WHAT A RESOLVED REFERENCE IS, DECIDED ONCE. A reference that binds to a corpus declaration is
// carried as that declaration's containment path -- the identity the index key, the candidate
// rows, DeclarationLocus and DeclarationRef already name -- and never as its leaf: two declarations
// spelled `run` in two modules are two paths, and a leaf would collapse them silently (the class
// gunbc.recurring_failure_mode refusal_reason_minted_as_canonical_identity records, whose interim
// refusal resolve_reason_qualified_target_identity_unrepresentable stood where this carrier now
// stands). A reference whose LEAF is a kernel canonical symbol resolves to the kernel atom, as it did
// before this carrier: the language model owns those names, they are not free for the corpus to
// re-declare, and every downstream kernel judgment (infer's Bool and Int checks, translate's
// binding spellings) is keyed on the canonical symbol. That arm is the whole of what stays
// spelling-keyed here, on a closed set the language model declares; a corpus twin of a kernel name
// is a pre-existing fork beside this seam, not one this decision widens.
type ResolvedReferenceIdentity
  = ResolvedToKernelSymbol { symbol: Symbol }
  | ResolvedToDeclaration { path: QualifiedName }

fn resolved_reference_identity(ctx: ResolveContext, path: QualifiedName) -> ResolvedReferenceIdentity {
  match qualified_name_last_segment(qn: path) {
    Present { value: leaf } =>
      if namespace_has_canonical_symbol(namespace: ctx.namespace, name: leaf) {
        ResolvedToKernelSymbol { symbol: leaf }
      } else {
        ResolvedToDeclaration { path: path }
      }
    Absent => ResolvedToDeclaration { path: path }
  }
}

// THE ONE PRODUCER OF A RESOLVED CORPUS REFERENCE. Both doors that bind a module-level name -- the
// bare door (resolve_atom_bound) and the qualified door (try_resolve_qualified_name_node) -- mint
// through here, so the carrier cannot differ by how the reference was spelled. The rung this buys
// (DESIGN section 4b) is structurally guaranteed, not impossible: an Atom naming a corpus
// declaration is still constructible by a fixture or a hand-built node, but no Accepted resolved
// body contains one, because this module is the only producer of resolved bodies and its remaining
// canonical_atom sites are the frame-local binder, the literal, and the kernel arm above.
fn resolved_reference_node(identity: ResolvedReferenceIdentity, occurrence_id: NodeOccurrenceIdentity) -> Node {
  match identity {
    ResolvedToKernelSymbol { symbol: symbol } => canonical_atom(identity: symbol, occurrence_id: occurrence_id)
    ResolvedToDeclaration { path: path } => declaration_reference_node(qn: path, occurrence_id: occurrence_id)
  }
}

type SymbolIndexAtomLookup
  = SymbolIndexAtomHit { path: QualifiedName }
  | SymbolIndexAtomAmbiguous { class: AmbiguousLookupClass }
  | SymbolIndexAtomUnbound

// NOTHING FOLLOWS AN EXHAUSTED CHAIN, which is what the LexicalUnbound arm below now says by
// answering SymbolIndexAtomUnbound. That arm used to ask the corpus-wide bare-name index under
// NamespaceOnlyY, and that question has no answer it is entitled to give: a name the reference's
// own ancestor chain does not bind has no meaning AT THE REFERENCE, whatever else the corpus spells
// the same way. docs/plans/namespace-resolution-design.md section 13 deletes the tier by name --
// "global_bare dies as a mechanism" -- and the reference model this corpus grounds lookup in agrees
// by ABSENCE: [basic.lookup.unqual] walks outward to the parent scope and, exhausted, the program
// is ill-formed; there is no clause that searches a whole program for a unique declaration.
//
// WHAT REPLACES THE TIER IS NOT A WEAKER ANSWER BUT A BINDING THE AUTHOR WROTE. An import is
// transmuted into a row at the importing position (v2.extdeps.languages.dag
// import_binding_rows_from_decl_node, bound by v2.compiler.symbol_index_fill), so the names a
// module actually uses are ON its chain and the lexical collector finds them there. Deleting the
// tier without that transmutation would not have made these references resolve; it would have made
// them unbound, which is why the two are one change.
//
// THE INDEX'S global_bare MAP SURVIVES, and only as what section 13 leaves it: a migration oracle
// for the divergence census. No resolution path reaches it.
fn lookup_symbol_index_atom_identity(
  ctx: ResolveContext,
  name: Symbol
) -> SymbolIndexAtomLookup {
  match symbol_index_lexical_lookup(
    index: ctx.namespace.symbol_index,
    position: symbol_index_lookup_position(ctx: ctx),
    name: name
  ) {
    LexicalHit { node: _, path: path } => SymbolIndexAtomHit { path: path }
    LexicalAmbiguous { candidates: candidates } =>
      SymbolIndexAtomAmbiguous { class: AmbiguousOnLexicalChain { candidates: candidates } }
    LexicalUnbound => SymbolIndexAtomUnbound
  }
}

// feature:indexed-variant-path-projectable acceptance condition at the producer seam, required for conformance with docs/plans/namespace-resolution-design.md section 13 unique-on-chain: resolve the reference's FIRST segment to the unique binder on its ancestor chain, then project every remaining segment downward through the containment tree. try_resolve_qualified_name_node must therefore accept an authored Type.Variant path by projecting it from the referencing position onto the type-to-variant containment path that symbol_index_fill_containment_node already indexes. The feature is UNFIRED while this function sends the authored path directly to symbol_index_lookup as though every dotted path were corpus-root absolute: UpdateVersionPersistence.Persistent therefore refuses even though the full module.UpdateVersionPersistence.Persistent path is indexed. It fires only when an executing positive control resolves the type-relative path to that exact indexed variant; zero binders produces a located unresolved refusal; two or more binders produces a located Ambiguous refusal carrying the full candidate list rather than picking; and shadowing refuses rather than silently rebinding. This belongs to the namespace-only-resolution lane's producer-side changeover, not to a consumer workaround or a new syntax preference.
// A HIT IS NEVER STAMPED WITH A REFUSAL REASON, AND IT IS NOT MINTED FROM A LEAF EITHER. This
// arm's fallback identity used to be ^resolve_reason_unbound_symbol, so a qualified path that FOUND
// a non-atom declaration (an Arrow -- every fn) was Accepted carrying a diagnostic symbol as its
// canonical identity: a fabricated plausible output (DESIGN section 5) that no witness could have
// caught, because no v2 route produced the qualified spine this arm consumes until body lowering
// began to (see body_lower_dotted_reference_optional). One revision of gunbc#11582 replaced the
// reason with the path's last segment; the side-chat ruling on that head found the leaf equally
// fabricated -- two declarations named `run` in two modules collapse to one Atom -- so a hit whose
// declaration was not itself an Atom REFUSED (resolve_reason_qualified_target_identity_unrepresentable)
// until resolution carried exact declaring identity. It now does: the hit is minted through
// resolved_reference_node as the declaration's path, the same producer the bare door uses, and the
// interim refusal is deleted with nothing left for it to guard -- every index hit IS a path, so a
// control for a refusal with no authorable red would be a decoration (DESIGN section 4b). Measured:
// a cross-module reference to a fn came back Accepted with identity resolve_reason_unbound_symbol
// before the first repair.
// THE HALF OF UNIQUE-ON-CHAIN THAT CAN BE HONEST BEFORE THE PROJECTION EXISTS (review 67651 on
// gunbc#11582). Section 13 resolves a chain's FIRST segment on the ancestor chain and projects the
// rest; the projection is unfired here, and this arm reads the whole path as corpus-root
// absolute. What must not happen meanwhile is the absolute read SILENTLY WINNING over a binder
// that is on the chain: `fn f(v2: Bool) -> Bool { v2.test.p.g }` bound `v2` and the absolute
// path both answer, which section 13 names as two binders and refuses as Ambiguous -- it may not
// pick the root and Accept a meaning the source did not spell. So the head is looked up on the
// chain first. Head bound and absolute hit: Ambiguous. Head bound and no absolute hit: the
// projection this arm cannot yet perform, refused Unbound rather than fabricated. Head not bound:
// the absolute arm as before. The positive projection (`r.v` resolving through r's type) is a
// capability NO enrolled row waits on yet: the local-receiver row in
// v2.test.claim.namespace_xl0.cross_module_reference_resolution is `Bool.v`, a permanent negative
// control (`Bool` has no child `v`), and the positive `Rec.v` specimen needs declaration grafting
// as well as this projection and is owned by those lanes. This check only closes the fail-open
// arm beside the projection.
// THE DECISION BETWEEN A DECLARATION PATH AND A VALUE PROJECTION, CARRIED AT THE GRAIN THAT DECIDES IT.
// This answered Bool, collapsing BoundInFrame and BoundAtRoot to `true`, and that Bool was the SOLE
// discriminator its caller used to choose between reading a dotted path as a field projection and reading
// it as a qualified declaration name. The two questions are different: "is this head bound anywhere on the
// chain" is not "is this head a lexical value a field can be projected from". A module-level name bound at
// the root is a DECLARATION or a namespace segment, so a path THROUGH it is a qualified name.
//
// NO NATIVE RECEIPT IS CLAIMED FOR THIS CHANGE, and an earlier revision of this header claimed one that
// was false. It attributed the native refusal of v2.test.parse.expression_bodied_fn_decl_parse to a
// fully-qualified annotation being read as nested field projections through this collapsed Bool. That was
// read off a diagnostic CHAIN HEAD and was wrong twice: the native eight measured identically before and
// after the change, and the actual cause entry in that chain anchors a genuine two-edge field projection
// (`e.target`) whose base is a fold-step binder -- a subject this function never sees. The specimen is an
// inference-side join, not a resolution one.
//
// WHAT JUSTIFIES THE CHANGE IS THE READING ITSELF, which needs no incident: one Bool cannot carry a
// discriminator its consumer must make between two readings, and a consumer forced to re-derive what it was
// handed is DESIGN section 5's validation standing where construction was available. The controls in
// v2.test.claim.field_projection.field_projection_stages establish the rule; no claim is made here about the
// eight, about wall 3d, or about any native refusal consuming this arm.
//
// WHY THE ANSWER IS ScopeBinding AND NOT A SECOND Bool. lookup_chain already computes the distinction and
// already returns it; collapsing it here and then trying to recover it downstream is what forced the
// earlier repair attempt into the wrong link -- a `projects_fields` gate inside the projection builder,
// which could only turn the case into an unbound refusal because the declaration door is in the CALLER and
// not reachable from there. Carrying the value this function was handed is the construction; re-deriving it
// later was the validation standing where construction was available.
fn qualified_head_scope_binding(ctx: ResolveContext, path: QualifiedName) -> Outcome<ScopeBinding> {
  match path {
    Cons { head: head, tail: _ } => lookup_chain(s: ctx.scope, name: head)
    Empty => Accepted { value: ScopeUnbound, diagnostics: None }
  }
}

// THE PROJECTION THIS ARM COULD NOT PERFORM, now performed. A dotted chain whose HEAD is bound on the
// scope chain and whose whole path names no declaration is not an unbound name: it is a field access
// off that binding. Body lowering deliberately declines to decide -- v2.compiler.body_lowering_fold
// PostfixAccum keeps `a.b.c` as one spine and says why: "deciding here would be a second resolver with
// no scope to consult", naming THIS function as the decider. So the spine arriving here is not a
// producer defect; answering Unbound for it was this function accepting the job and not doing it, and
// the two causes -- a bound head needing projection, and a genuinely unbound head -- were reported
// identically.
//
// THE HEAD BECOMES ITS BINDER, THE REST BECOME SUCCESSIVE PROJECTIONS, left to right, which is the
// same association the postfix lowering gives a projection off a value: `b.x.y` is `(b.x).y`. Each
// step is v2.std.node_query field_projection_node over the segment's OWN node, so every field keeps
// the occurrence of the token it was lowered from and a later diagnostic about one field lands on that
// field rather than on the whole chain -- which is why this reads segment NODES
// (qualified_name_spine_segment_nodes) rather than rebuilding atoms from the name's symbols.
//
// WHAT THIS DOES NOT DECIDE, and must not: whether the projected field EXISTS on the receiver's type.
// That check needs a type, resolve has none, and v2.std.node_query field_projection_node's own header
// already assigns it to the stage over this node. So this arm is structural: it commits to the reading
// "field access", and a field no type declares is refused later by the stage that can see the type.
// Admitting the shape is therefore not admitting the access, and the absent-field control in
// v2.test.claim.field_projection.field_projection_stages is what holds that line.
//
// THE HEAD IS RESOLVED AS THE FRAME-LOCAL BINDER IT IS, through canonical_atom on the canonical symbol
// lookup_chain returned -- the same producer every other bound bare use goes through, so a projection
// base is not a second spelling of a binder reference.
fn resolve_bound_head_projection(
  ctx: ResolveContext,
  n: Node,
  pending: Diagnostics
) -> Outcome<ResolvedAtom> {
  match qualified_name_spine_segment_nodes(root: n) {
    Absent =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: pending,
          rejected: diagnostics_singleton(d: unbound_symbol_diagnostic(n: n))
        )
      }
    Present { value: segments } =>
      match segments {
        Empty =>
          Rejected {
            diagnostics: rejected_with_pending(
              pending: pending,
              rejected: diagnostics_singleton(d: unbound_symbol_diagnostic(n: n))
            )
          }
        Cons { head: head_segment, tail: field_segments } =>
          match resolve_projection_base(ctx: ctx, head_segment: head_segment) {
            Absent =>
              Rejected {
                diagnostics: rejected_with_pending(
                  pending: pending,
                  rejected: diagnostics_singleton(d: unbound_symbol_diagnostic(n: n))
                )
              }
            Present { value: Rejected { diagnostics: r } } =>
              Rejected { diagnostics: rejected_with_pending(pending: pending, rejected: r) }
            Present { value: Accepted { value: base, diagnostics: _ } } =>
              outcome_with_diagnostics(
                value: ResolvedAtom {
                  node: fold_list(
                    xs: field_segments,
                    empty: base.node,
                    cons: fn(acc, field_segment) {
                      field_projection_node(base: acc, field: field_segment, source: n)
                    }
                  ),
                  lexical: base.lexical
                },
                diagnostics: pending
              )
          }
      }
  }
}

// THE BASE OF A PROJECTION IS WHATEVER THE HEAD SEGMENT IS BOUND TO, AND THIS FUNCTION NO LONGER DECIDES
// WHETHER A PROJECTION IS THE RIGHT READING AT ALL. That decision is resolve_dotted_path_reading's, made
// from the head's ScopeBinding and the corpus's declarations before this is ever called, so by the time a
// head segment arrives here the caller has already committed to the projection reading and this function's
// only job is to produce the base node.
//
// A `projects_fields` GATE STOOD HERE AND WAS THE WRONG LINK, recorded because the reasoning that put it
// here is the reasoning worth not repeating. It refused a root-bound head whenever field segments followed,
// which looks like the same rule the caller now applies and is not: refusing HERE can only produce an
// unbound-symbol diagnostic, because the declaration-path door is in the caller and unreachable from this
// function, so it could only ever convert one wrong answer into another. The native eight measured
// identically with it and without it, which is consistent with the gate being inert on that path AND with
// the path never having been this function's subject at all; the later receipt established the second. Its
// deletion is therefore a correctness repair on this function's own contract, claiming nothing about the
// eight.
//
// EVERY FRAME-BOUND HEAD IS THE SAME REFERENCE A BARE USE OF THAT BINDER IS, because it is minted by the
// same producer: resolve_frame_bound_reference, by the frame's own kind. A ParameterFrame head is the
// path-keyed parameter_reference_node infer grounds through the resolved declarations
// (v2.compiler.infer infer_parameter_reference_facts); a LexicalFrame head -- a let, match-arm or lambda
// binder -- is the lexical_reference_node whose binding is recorded by its occurrence, carried out of this
// route as ResolvedAtom.lexical so the walk records it exactly as it records a bare use; a type-parameter
// head stays the canonical atom that frame mints for any use. The Lexical arm was the canonical atom while
// this route carried no lexical entries, and a projection off a lambda binder (`fn(found, e) { e.target }`)
// then reached infer as a bare atom nothing had typed -- the receiver landed in the non-refusing
// ReceiverTypeUnderived arm, so the binder's declared type never reached the field it was projected through.
fn resolve_projection_base(ctx: ResolveContext, head_segment: Node) -> Optional<Outcome<ResolvedAtom>> {
  match head_segment.kind {
    TypeNode { connective: Atom { identity: name } } =>
      match lookup_chain(s: ctx.scope, name: name) {
        Rejected { diagnostics: _ } => optional_absent()
        Accepted { value: found, diagnostics: _ } =>
          match found {
            BoundInFrame { canonical: canonical, kind: kind } =>
              optional_present(value: resolve_frame_bound_reference(
                ctx: ctx,
                n: head_segment,
                canonical: canonical,
                kind: kind,
                pending: None
              ))
            BoundAtRoot { canonical: canonical } =>
              optional_present(value: resolved_atom_plain(o: resolve_atom_bound(
                ctx: ctx,
                n: head_segment,
                path: root_binding_declaration_path(namespace: ctx.namespace, name: canonical),
                pending: None
              )))
            ScopeUnbound => optional_absent()
          }
      }
    TypeNode { connective: _ } => optional_absent()
    ComputationNode { behavior: _ } => optional_absent()
  }
}

// THE CHAIN WINS, WHICH IS SECTION 13'S RULE AND NOT A NEW ONE. A chain's FIRST segment resolves on
// the ancestor chain and the rest projects, so a bound head is answered by the binder the author wrote
// and the absolute candidates are not consulted at all.
//
// THE AMBIGUOUS ARM THAT STOOD HERE WAS AN INTERIM GUARD WHOSE REASON IS GONE. qualified_head_bound_-
// on_chain's own header said what it was: "the half of unique-on-chain that can be honest BEFORE THE
// PROJECTION EXISTS", refusing AmbiguousQualifiedHeadShadowsAbsolute precisely because this arm could
// not project and therefore must not let the absolute read silently win. The projection now exists
// (resolve_bound_head_projection), so the guard DISSOLVES rather than weakens -- DESIGN section 4b(4),
// which also says the evidence does not retire: its discriminating control stays enrolled, flipped to
// assert that a bound head answers with its binder's projection.
//
// SO THIS IS NOT A REFUSAL BEING RELAXED. The state the refusal forbade -- the absolute read winning
// over a binder the source spelled -- is still forbidden; it is now answered correctly instead of
// refused, which is the climb the interim arm was waiting for.
fn try_resolve_qualified_name_node(ctx: ResolveContext, n: Node) -> Optional<Outcome<ResolvedAtom>> {
  match qualified_name_from_node(root: n) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: path, diagnostics: pending } =>
      if length(xs: path) > 1 {
        match qualified_head_scope_binding(ctx: ctx, path: path) {
          Rejected { diagnostics: r } =>
            optional_present(value: Rejected { diagnostics: rejected_with_pending(pending: pending, rejected: r) })
          Accepted { value: head_binding, diagnostics: chain_pending } =>
            optional_present(
              value: resolve_dotted_path_reading(
                ctx: ctx,
                n: n,
                path: path,
                head_binding: head_binding,
                pending: diagnostics_merge(outer: pending, inner: chain_pending)
              )
            )
        }
      } else {
        optional_absent()
      }
  }
}

// BOTH READINGS OF A DOTTED PATH, DECIDED IN ONE PLACE, which is what makes this a decision rather than a
// gate. A path of two or more segments is either a FIELD PROJECTION off a value or a QUALIFIED DECLARATION
// NAME, and the discriminator is the head's ScopeBinding together with whether the corpus actually declares
// the path.
//
// BoundInFrame IS THE PROJECTION, UNCONDITIONALLY, and that is Section 13's chain-wins rule unchanged: a
// head the author bound lexically answers with that binder, and the absolute candidates are not consulted
// at all. A frame binder shadowing a module path is the author's own name winning, which is the rule.
//
// ScopeUnbound IS THE DECLARATION PATH, with no fallback: there is no value to project from, so an
// undeclared path is an unbound name and says so.
//
// BoundAtRoot DEPENDS ON WHAT THE ROOT NAME DECLARES. A name bound at the module root is a declaration or a
// namespace segment, and a path THROUGH a type or a namespace is a qualified name; when the corpus declares
// no such name the answer is an unbound symbol with its own locus, and NOT a re-reading of the path as a
// projection -- see resolve_declared_path_reading for why that fallback is forbidden. A root name whose
// declaration is a VALUE (`data cfg: Config = ...`, realized as an Arrow; root_binding_names_value) is the
// head of a projection, exactly as a frame binder is: `cfg.field` projects. That is decided up front from
// the declaration the binding names, not tried after the declaration reading fails, so it is a reading and
// not a fallback. Held by v2.test.claim.field_projection.field_projection_stages
// fps_a_root_bound_data_value_projects (the value projects) and
// fps_a_root_bound_type_projected_as_value_refuses (a type still does not).
//
// FIELD INFERENCE IS NOT RELAXED BY ANY OF THIS. Committing to the projection reading commits to the SHAPE
// only; whether the field exists on the receiver's type is still refused later by the stage that can see
// the type, exactly as resolve_bound_head_projection's own header says. A path admitted here as a
// projection off a fieldless receiver still refuses at infer -- this change moves which paths are READ as
// projections, and changes nothing about what a projection must satisfy.
// A ROOT BINDING NAMES A VALUE EXACTLY WHEN THE DECLARATION IT NAMES IS AN ARROW. Body lowering realizes a
// `data` item as the nullary function that returns it (v2.compiler.body_lowering_fold
// body_lower_data_decl_to_member), so a module-level value is an Arrow declaration, while a type or a
// namespace is not. The kind is READ OFF THE DECLARATION the binding already names -- the same declaring path
// resolve_atom_bound mints from -- and is not stored beside the binding, so the two cannot drift. A root head
// whose path has no indexed declaration names no value and keeps the declaration reading.
fn root_binding_names_value(namespace: Namespace, canonical: Symbol) -> Bool {
  match symbol_index_entry_at(
    index: namespace.symbol_index,
    qualified_path: root_binding_declaration_path(namespace: namespace, name: canonical)
  ) {
    Absent => false
    Present { value: decl } =>
      match decl.kind {
        TypeNode { connective: Arrow } => true
        TypeNode { connective: _ } => false
        ComputationNode { behavior: _ } => false
      }
  }
}

fn root_binding_declaration_path(namespace: Namespace, name: Symbol) -> QualifiedName {
  qualified_name_snoc(qn: root_binding_origin(namespace: namespace, name: name), segment: name)
}

fn resolve_dotted_path_reading(
  ctx: ResolveContext,
  n: Node,
  path: QualifiedName,
  head_binding: ScopeBinding,
  pending: Diagnostics
) -> Outcome<ResolvedAtom> {
  match head_binding {
    BoundInFrame { canonical: _, kind: _ } => resolve_bound_head_projection(ctx: ctx, n: n, pending: pending)
    BoundAtRoot { canonical: canonical } =>
      if root_binding_names_value(namespace: ctx.namespace, canonical: canonical) {
        resolve_bound_head_projection(ctx: ctx, n: n, pending: pending)
      } else {
        resolved_atom_plain(o: resolve_declared_path_reading(ctx: ctx, n: n, path: path, pending: pending))
      }
    ScopeUnbound => resolved_atom_plain(o: resolve_declared_path_reading(ctx: ctx, n: n, path: path, pending: pending))
  }
}

// A DECLARATION PATH THAT NAMES NOTHING REFUSES, AND MAY NOT WIDEN TO THE PROJECTION READING. This arm
// held a fallback -- no candidate for the path, so re-read it as a field projection off the root binding --
// and that fallback is the absorbing arm DESIGN section 5 forbids, written into the very repair that was
// meant to remove a misreading.
//
// WHY A FALLBACK IS FORBIDDEN HERE, STATED AS THE RULE AND NOT AS AN INCIDENT. When the declaration
// reading cannot be established, the tempting arm substitutes the other reading, so nothing is ever
// reported as unresolvable. That is DESIGN section 5's absorbing fallback: the precise answer was
// unavailable and the arm widened to a superset reading, which both fabricates a derivation the source does
// not support and destroys the signal that the declaration evidence was missing. An earlier revision of
// this change shipped exactly that fallback and then attributed a native refusal to it; the attribution was
// falsified by measurement, and the fallback was wrong independently of whether anything consumed it.
//
// SO THE ARM REFUSES, and BoundAtRoot and ScopeUnbound reach the same reading: a path of two or more
// segments whose head is not a LEXICAL binder is a declaration name, and if the corpus declares no such
// name that is an unbound symbol with its own locus. Only BoundInFrame projects. The single-segment
// root-bound annotation that made deleting BoundAtRoot wrong earlier never arrives here -- the caller's
// length > 1 guard keeps it out -- so this costs that form nothing.
fn resolve_declared_path_reading(
  ctx: ResolveContext,
  n: Node,
  path: QualifiedName,
  pending: Diagnostics
) -> Outcome<Node> {
  match symbol_index_absolute_candidates(index: ctx.namespace.symbol_index, qualified_path: path) {
    Empty =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: pending,
          rejected: diagnostics_singleton(d: unbound_symbol_diagnostic(n: n))
        )
      }
    Cons { head: candidate, tail: rest } =>
      resolve_declared_path_candidates(ctx: ctx, n: n, candidate: candidate, rest: rest, pending: pending)
  }
}

// ONE CANDIDATE IS THE ANSWER AND SEVERAL ARE AMBIGUOUS. Factored out because both arms above reach it and
// a second copy of an ambiguity refusal is the duplicated authority DESIGN section 2 prices -- the two arms
// differ in what they do with an EMPTY candidate list, not in how they read a non-empty one.
fn resolve_declared_path_candidates(
  ctx: ResolveContext,
  n: Node,
  candidate: LexicalBindingCandidate,
  rest: FreeMonoid<LexicalBindingCandidate>,
  pending: Diagnostics
) -> Outcome<Node> {
  match rest {
    Empty => resolve_atom_bound(ctx: ctx, n: n, path: candidate.path, pending: pending)
    Cons { head: _, tail: _ } =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: pending,
          rejected: ambiguous_symbol_diagnostics(
            n: n,
            class: AmbiguousAtBindingPosition { candidates: Cons { head: candidate, tail: rest } }
          )
        )
      }
  }
}

fn root_binding_origin(namespace: Namespace, name: Symbol) -> QualifiedName {
  match map_lookup(m: namespace.imported_origins, key: name) {
    Present { value: origin } => origin
    Absent => namespace.declared_in
  }
}

fn test_code_referenced_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// THE WALL (owner ruling 2026-09-16/17): `test` segregates test code from serving code, and no code
// may reference a test-marked declaration, a test fn in the same module included. It is decided here,
// where the reference binds, from the path it bound to, and it refuses with the reference's own locus.
// ONE ENFORCEMENT SITE, ONE DECISION. Every door that binds a module-level name -- the root scope,
// the symbol index, and the qualified-path door (try_resolve_qualified_name_node) -- accepts through
// this function, which asks test_code_reach over ctx.namespace.test_code and then mints the resolved
// reference through the one producer, resolved_reference_node, from the DECLARING path the door
// selected. The qualified door used to refuse inline because its accepted arm had to read the
// resolved node's kind first; the carrier no longer depends on the kind, so that second site is
// gone. The path a door hands in is the declaration's own (the candidate rows name claimants by
// declaring path, v2.std.symbol_index symbol_index_candidates_at), never the binding position it
// was seen at -- an import or alias position would have minted one declaration into as many
// identities as it has importers. What a later door must not do is bind a module-level name
// without passing through here -- the per-door reds in
// v2.test.claim.name_resolve.test_code_reference_wall are what hold that, one per door.
fn resolve_atom_bound(
  ctx: ResolveContext,
  n: Node,
  path: QualifiedName,
  pending: Diagnostics
) -> Outcome<Node> {
  match test_code_reach(index: ctx.namespace.test_code, path: path) {
    ReachesNoTestCode =>
      Accepted {
        value: resolved_reference_node(
          identity: resolved_reference_identity(ctx: ctx, path: path),
          occurrence_id: n.occurrence_id
        ),
        diagnostics: pending
      }
    ReachesTestMarkedDeclaration =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: pending,
          rejected: diagnostics_singleton(d: test_code_referenced_diagnostic(reason: ^resolve_reason_test_code_referenced, n: n))
        )
      }
  }
}

// A KERNEL TYPE SPELLING IS READ BY THE DECLARATION IT RESOLVED TO. Once a door (the root's import,
// or the symbol index) has selected a declaration, v2.extdeps.languages.dag
// dag_kernel_type_declaration_binding_optional decides: one of the kernel's own declarations takes
// the canonical binding. The referencing module's own declaration of that spelling shadows it. Any
// other declaration of a kernel spelling REFUSES, typed and located, because binding it to the
// kernel would judge the value against a type the author did not name. An ambiguous name binds the
// kernel only when every candidate is a kernel declaration (resolve_kernel_type_ambiguity_optional).
// Only an unbound name reads the spelling table. This used to run in body lowering, before any scope
// existed, where it captured every declaration of `Int` as the kernel Int
// (gunbc.recurring_failure_mode kernel_type_spelling_captured_a_module_declaration).
type KernelTypeReading
  = KernelTypeBinding { canonical: Symbol }
  | KernelSpellingForeignDeclaration
  | NotAKernelTypeReading

fn resolve_kernel_type_reading(identity: Symbol, path: QualifiedName, declared_here: Bool) -> KernelTypeReading {
  match dag_kernel_type_binding_optional(sym: identity) {
    Absent => NotAKernelTypeReading
    Present { value: spelled } =>
      match dag_kernel_type_declaration_binding_optional(path: path) {
        Present { value: canonical } => KernelTypeBinding { canonical: canonical }
        Absent =>
          if declared_here {
            NotAKernelTypeReading
          } else {
            match dag_kernel_type_foreign_declaration(canonical: spelled) {
              ForeignDeclarationRefuses => KernelSpellingForeignDeclaration
              ForeignDeclarationBinds => NotAKernelTypeReading
            }
          }
      }
  }
}

fn kernel_type_spelling_foreign_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_kernel_type_spelling_names_a_foreign_declaration,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// WHETHER A DECLARATION IS THE REFERENCING MODULE'S OWN, read from where the namespace records its
// owner. declared_in is that owner on both namespace routes: build_program_namespace (single tree)
// and the admitted subject, and on both it equals module_qn. root_binding_origin
// reads the same field, so the root door and the symbol-index door agree on ownership.
fn namespace_owns_declaration(namespace: Namespace, path: QualifiedName) -> Bool {
  qualified_name_init(qn: path) == namespace.declared_in
}

// One door's declaration, read for a kernel spelling before it is bound.
fn resolve_atom_declared(
  ctx: ResolveContext,
  n: Node,
  identity: Symbol,
  path: QualifiedName,
  pending: Diagnostics
) -> Outcome<Node> {
  match resolve_kernel_type_reading(
    identity: identity,
    path: path,
    declared_here: namespace_owns_declaration(namespace: ctx.namespace, path: path)
  ) {
    KernelTypeBinding { canonical: canonical } =>
      Accepted {
        value: canonical_atom(identity: canonical, occurrence_id: n.occurrence_id),
        diagnostics: pending
      }
    KernelSpellingForeignDeclaration =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: pending,
          rejected: diagnostics_singleton(d: kernel_type_spelling_foreign_diagnostic(n: n))
        )
      }
    NotAKernelTypeReading => resolve_atom_bound(ctx: ctx, n: n, path: path, pending: pending)
  }
}

// AN AMBIGUOUS KERNEL SPELLING TAKES THE KERNEL BINDING ONLY WHEN EVERY CANDIDATE IS A KERNEL
// DECLARATION OF IT. Two declarations of the standard type (v2.std.integer Int beside std.integer
// Int) are one kernel type, so the canonical binding is the answer. Any other candidate means the
// author may have named that declaration, so the name refuses as ambiguous (the ordinary ambiguity
// diagnostic) rather than defaulting to the kernel.
fn resolve_kernel_type_ambiguity_optional(
  ctx: ResolveContext,
  n: Node,
  identity: Symbol,
  class: AmbiguousLookupClass
) -> Optional<Node> {
  match dag_kernel_type_binding_optional(sym: identity) {
    Absent => optional_absent()
    Present { value: canonical } =>
      if resolve_kernel_candidates_all_denote(ctx: ctx, class: class, canonical: canonical) {
        optional_present(value: canonical_atom(identity: canonical, occurrence_id: n.occurrence_id))
      } else {
        optional_absent()
      }
  }
}

fn resolve_kernel_candidates_all_denote(ctx: ResolveContext, class: AmbiguousLookupClass, canonical: Symbol) -> Bool {
  match class {
    AmbiguousOnLexicalChain { candidates: cs } => resolve_kernel_candidate_list_denotes(ctx: ctx, cs: cs, canonical: canonical)
    AmbiguousAtBindingPosition { candidates: cs } => resolve_kernel_candidate_list_denotes(ctx: ctx, cs: cs, canonical: canonical)
    AmbiguousQualifiedHeadShadowsAbsolute { path: _ } => false
  }
}

fn resolve_kernel_candidate_list_denotes(ctx: ResolveContext, cs: FreeMonoid<LexicalBindingCandidate>, canonical: Symbol) -> Bool {
  fold_list(xs: cs, empty: true, cons: fn(acc, c) {
    acc && match dag_kernel_type_declaration_binding_optional(
      path: symbol_index_declaring_path_of(index: ctx.namespace.symbol_index, target: c.path)
    ) {
      Present { value: k } => k == canonical
      Absent => false
    }
  })
}

fn resolve_kernel_type_atom_optional(n: Node, identity: Symbol) -> Optional<Node> {
  match dag_kernel_type_binding_optional(sym: identity) {
    Present { value: canonical } =>
      optional_present(value: canonical_atom(identity: canonical, occurrence_id: n.occurrence_id))
    Absent => optional_absent()
  }
}

fn resolve_atom_unbound(ctx: ResolveContext, n: Node, identity: Symbol, pending: Diagnostics) -> Outcome<Node> {
  if namespace_has_canonical_symbol(
    namespace: ctx.namespace,
    name: identity
  ) {
    Accepted {
      value: canonical_atom(identity: identity, occurrence_id: n.occurrence_id),
      diagnostics: pending
    }
  } else if identity == pattern_wildcard_name() {
    Rejected {
      diagnostics: rejected_with_pending(
        pending: pending,
        rejected: diagnostics_singleton(d: anonymous_parameter_referenced_diagnostic(n: n))
      )
    }
  } else {
    Rejected {
      diagnostics: rejected_with_pending(
        pending: pending,
        rejected: unbound_symbol_diagnostics(ctx: ctx, n: n, name: identity)
      )
    }
  }
}

// A FRAME-BOUND REFERENCE IS MINTED BY ITS FRAME'S KIND, WHICH WAS FIXED WHEN THE FRAME WAS BUILT.
// A Lexical frame's binder stays the bare canonical atom. A ParameterFrame's binder is the parameter
// v2.compiler.symbol_index_fill indexed at <arrow_path>.<label>, and the reference is minted over
// exactly that path -- after the index confirms it. A path the index does not hold means the
// resolver's containment position and the fill's disagree about where this fn is declared; that is
// a located refusal, never a quiet fall back to the bare atom, which would leave the parameter
// grounded by nothing the index can key.
fn resolve_frame_bound_reference(
  ctx: ResolveContext,
  n: Node,
  canonical: Symbol,
  kind: FrameKind,
  pending: Diagnostics
) -> Outcome<ResolvedAtom> {
  match kind {
    TypeParameterFrame =>
      Accepted {
        value: ResolvedAtom { node: canonical_atom(identity: canonical, occurrence_id: n.occurrence_id), lexical: [] },
        diagnostics: pending
      }
    LexicalFrame { binders: binders } =>
      resolve_lexical_reference(n: n, canonical: canonical, binding: map_lookup(m: binders, key: canonical), pending: pending)
    ParameterFrame { arrow_path: arrow_path } =>
      let path = qualified_name_snoc(qn: arrow_path, segment: canonical)
      match symbol_index_lookup(index: ctx.namespace.symbol_index, qualified_path: path) {
        Present { value: _ } =>
          Accepted {
            value: ResolvedAtom { node: parameter_reference_node(qn: path, occurrence_id: n.occurrence_id), lexical: [] },
            diagnostics: pending
          }
        Absent =>
          Rejected {
            diagnostics: rejected_with_pending(
              pending: pending,
              rejected: diagnostics_singleton(d: Diagnostic {
                reason: ^resolve_reason_parameter_path_not_indexed,
                at: node_locus(node: n),
                correction: Unavailable { reason: UserInputBoundary }
              })
            )
          }
      }
  }
}

// A LEXICAL REFERENCE IS MINTED UNDER ITS MARKER AND ITS BINDING RECORDED BY THE REFERENCE'S OWN
// OCCURRENCE (ResolvedTree.lexical_bindings). A reference with no minted occurrence has no key a
// consumer could read its binding back by, so it refuses, typed and located, rather than becoming a
// lexical reference whose binder nobody can find. A frame that answers a name its binders do not
// record is a resolver defect, and refuses as one.
fn resolve_lexical_reference(
  n: Node,
  canonical: Symbol,
  binding: Optional<LexicalBinding>,
  pending: Diagnostics
) -> Outcome<ResolvedAtom> {
  let unkeyed = Rejected {
    diagnostics: rejected_with_pending(pending: pending, rejected: diagnostics_singleton(d: Diagnostic {
      reason: ^resolve_reason_lexical_reference_unkeyed,
      at: node_locus(node: n),
      correction: Unavailable { reason: UserInputBoundary }
    }))
  }
  match binding {
    Absent => unkeyed
    Present { value: b } =>
      match n.occurrence_id {
        OccurrenceSynthetic => unkeyed
        OccurrencePending { caused_by: _ } => unkeyed
        OccurrenceMinted { id: id } => resolve_lexical_reference_keyed(n: n, canonical: canonical, id: id, binding: b, pending: pending)
        OccurrenceProjected { id: id, caused_by: _ } => resolve_lexical_reference_keyed(n: n, canonical: canonical, id: id, binding: b, pending: pending)
      }
  }
}

fn resolve_lexical_reference_keyed(
  n: Node,
  canonical: Symbol,
  id: OccurrenceId,
  binding: LexicalBinding,
  pending: Diagnostics
) -> Outcome<ResolvedAtom> {
  Accepted {
    value: ResolvedAtom {
      node: lexical_reference_node(label: canonical, occurrence_id: n.occurrence_id),
      lexical: [LexicalBindingEntry { reference: id, binding: binding }]
    },
    diagnostics: pending
  }
}

// AN ATOM'S ANSWER: the node it resolves to and, when a Lexical frame answered it, the binding the
// walk records. Every other answer records nothing.
type ResolvedAtom {
  node: Node
  lexical: List<LexicalBindingEntry>
}

fn resolved_atom_plain(o: Outcome<Node>) -> Outcome<ResolvedAtom> {
  match o {
    Accepted { value: v, diagnostics: d } => Accepted { value: ResolvedAtom { node: v, lexical: [] }, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

// THE NODE-ONLY PROJECTION, for callers that place no value reference into the tree: type-role and
// type-parameter lookups (whose scope carries no value binder) and a construct tag (which refuses a
// non-constructor). The walk reads resolve_atom_answer and keeps the binding.
fn resolve_atom(ctx: ResolveContext, n: Node, identity: Symbol) -> Outcome<Node> {
  resolved_atom_node(o: resolve_atom_answer(ctx: ctx, n: n, identity: identity))
}

// An atom's answer with its binding dropped, for a caller that places no value reference into the tree.
fn resolved_atom_node(o: Outcome<ResolvedAtom>) -> Outcome<Node> {
  match o {
    Accepted { value: a, diagnostics: d } => Accepted { value: a.node, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn resolve_walk_of_atom(o: Outcome<ResolvedAtom>) -> ResolveNodeWalk {
  match o {
    Accepted { value: a, diagnostics: d } => ResolveWalkAccepted { value: a.node, diagnostics: d, lexical: a.lexical }
    Rejected { diagnostics: r } => resolve_walk_refused_one(chain: r)
  }
}

// A symbol literal is a value, returned whole: its payload is never looked up as a reference.
fn resolve_atom_answer(ctx: ResolveContext, n: Node, identity: Symbol) -> Outcome<ResolvedAtom> {
  match dag_symbol_literal_name_optional(node: n) {
    Present { value: _ } => resolved_atom_plain(o: Accepted { value: n, diagnostics: None })
    Absent => resolve_atom_not_symbol_literal(ctx: ctx, n: n, identity: identity)
  }
}

// A string literal carrying its value is a value, returned whole: its payload is never looked up.
fn resolve_atom_not_symbol_literal(ctx: ResolveContext, n: Node, identity: Symbol) -> Outcome<ResolvedAtom> {
  match dag_string_literal_value_symbol_optional(node: n) {
    Present { value: _ } => resolved_atom_plain(o: Accepted { value: n, diagnostics: None })
    Absent => resolve_atom_not_string_literal(ctx: ctx, n: n, identity: identity)
  }
}

fn resolve_atom_not_string_literal(ctx: ResolveContext, n: Node, identity: Symbol) -> Outcome<ResolvedAtom> {
  if dag_node_is_int_literal_atom(node: n) {
    resolved_atom_plain(o: Accepted { value: n, diagnostics: None })
  } else if dag_node_is_float_literal_atom(node: n) {
    Rejected {
      diagnostics: diagnostics_singleton(d: float_literal_not_lowered_diagnostic(n: n))
    }
  } else {
    match lookup_chain(s: ctx.scope, name: identity) {
      Accepted { value: found, diagnostics: pending } => match found {
        BoundInFrame { canonical: canonical, kind: kind } =>
          resolve_frame_bound_reference(ctx: ctx, n: n, canonical: canonical, kind: kind, pending: pending)
        BoundAtRoot { canonical: _ } => resolved_atom_plain(o: resolve_atom_declared(
            ctx: ctx,
            n: n,
            identity: identity,
            path: qualified_name_snoc(qn: root_binding_origin(namespace: ctx.namespace, name: identity), segment: identity),
            pending: pending
          ))
        ScopeUnbound => resolved_atom_plain(o: resolve_atom_unscoped(ctx: ctx, n: n, identity: identity, pending: pending))
      }
      Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
    }
  }
}

// A NAME NO FRAME AND NO ROOT BINDING ANSWERS: the symbol index, then the kernel types, then a primitive-call
// row of the one collection roster (v2.compiler.fold_lowering collection_roster_rows: concat), then unbound.
// The roster is asked LAST, so any declaration that claims the name -- a local, an import, an indexed
// declaration -- takes precedence and the row never shadows the corpus.
fn resolve_atom_unscoped(ctx: ResolveContext, n: Node, identity: Symbol, pending: Diagnostics) -> Outcome<Node> {
  match lookup_symbol_index_atom_identity(ctx: ctx, name: identity) {
    SymbolIndexAtomHit { path: path } =>
      resolve_atom_declared(ctx: ctx, n: n, identity: identity, path: path, pending: pending)
    SymbolIndexAtomAmbiguous { class: class } =>
      match resolve_kernel_type_ambiguity_optional(ctx: ctx, n: n, identity: identity, class: class) {
        Present { value: kernel } => Accepted { value: kernel, diagnostics: pending }
        Absent =>
          Rejected {
            diagnostics: rejected_with_pending(
              pending: pending,
              rejected: ambiguous_symbol_diagnostics(n: n, class: class)
            )
          }
      }
    SymbolIndexAtomUnbound =>
      match resolve_kernel_type_atom_optional(n: n, identity: identity) {
        Present { value: kernel } => Accepted { value: kernel, diagnostics: pending }
        Absent =>
          match collection_roster_primitive_call_row_optional(head: identity) {
            Present { value: r } => resolve_atom_bound(ctx: ctx, n: n, path: declaration_ref_path(r: r.row), pending: pending)
            Absent => resolve_atom_primitive_authority(ctx: ctx, n: n, identity: identity, pending: pending)
          }
      }
  }
}

// THE LAST TIER: a free kernel primitive binds to its std.primitives contract row (v2.compiler.primitive_authority),
// asked only after the frame, the imports, the indexed declarations, the kernel types and the collection roster
// have all declined the name, so an ordinary declaration (a local fn, an imported v2.std.algebra any/filter) always
// wins. A canonical symbol is not a primitive and keeps its own answer. A name no authority declares stays the
// typed resolve_reason_unbound_symbol refusal. The found row is JOINED on its own `name` field: a row whose declaration
// name disagrees with its name field is the typed resolve_reason_primitive_row_name_disagrees refusal, not a spelling bind.
fn resolve_atom_primitive_authority(ctx: ResolveContext, n: Node, identity: Symbol, pending: Diagnostics) -> Outcome<Node> {
  if namespace_has_canonical_symbol(namespace: ctx.namespace, name: identity) {
    resolve_atom_unbound(ctx: ctx, n: n, identity: identity, pending: pending)
  } else {
    let path = primitive_authority_path(head: identity)
    if symbol_index_declares_primitive_contract_at(index: ctx.namespace.symbol_index, qualified_path: path) {
      match symbol_index_lookup(index: ctx.namespace.symbol_index, qualified_path: path) {
        Present { value: row } =>
          if primitive_authority_row_names_head(row: row, head: identity) {
            resolve_atom_bound(ctx: ctx, n: n, path: path, pending: pending)
          } else {
            Rejected {
              diagnostics: rejected_with_pending(
                pending: pending,
                rejected: diagnostics_singleton(d: Diagnostic {
                  reason: ^resolve_reason_primitive_row_name_disagrees,
                  at: node_locus(node: n),
                  correction: Unavailable { reason: CorrectionNotModeled }
                })
              )
            }
          }
        Absent => resolve_atom_unbound(ctx: ctx, n: n, identity: identity, pending: pending)
      }
    } else {
      resolve_atom_unbound(ctx: ctx, n: n, identity: identity, pending: pending)
    }
  }
}

fn resolve_surface_operator_atom(
  ctx: ResolveContext,
  n: Node,
  identity: Symbol
) -> Outcome<ResolvedAtom> {
  match dag_surface_operator_canonicalization_lookup(lm: ctx.lm, surface_token: identity) {
    Accepted { value: canonical_op, diagnostics: pending } => {
      let wire = target_model_canonical_operation_wire_node(operation: canonical_op)
      resolved_atom_plain(o: Accepted {
        value: node_with_occurrence_id(
          kind: wire.kind,
          children: wire.children,
          occurrence_id: n.occurrence_id
        ),
        diagnostics: pending
      })
    }
    Rejected { diagnostics: _ } =>
      resolve_atom_answer(ctx: ctx, n: n, identity: identity)
  }
}

// ── THE CHILD WALK: ONE OBSERVATION FOR THE FOUR CHILD FOLDS ─────────────────────────────────
//
// WHAT WAS WRONG. Each of the four walks below folded an Outcome<List<Edge>> and returned the
// accumulator untouched once it went Rejected. That is not a policy choice about how much to
// report -- the accumulator CONFLATES the successful output with the refusal state, so the moment
// it rejects, the edge list is gone and there is no value left to continue accumulating into.
// Stopping was forced by the carrier's shape. A module with two independent post-cut refusals
// therefore recorded the first and never observed the second: truthful at MODULE grain, an
// undercount at OCCURRENCE grain, which is the grain XL-2's rehearsal residual needs
// (gunbc.compiler_frontend_program_status ExactOccurrenceResidualCensus).
//
// WHY THE POPULATION IS A LIST OF CHAINS AND NOT ONE LONGER CHAIN. NonEmptyDiagnostics means
// "pending advisories followed by exactly ONE fatal" -- v2.std.diagnostic diagnostics_fatal reads
// the LAST element as the cause, and says so as the single authority for that ordering.
// Concatenating N independent failures into one chain would make the Nth arbitrarily "the" cause
// and silently change what every consumer of diagnostics_fatal answers. So each independent failure
// keeps its own chain, where that contract stays true, and the walk carries an ORDERED POPULATION
// of them.
//
// WHY THE POPULATION CROSSES EVERY NODE BOUNDARY. A population collected per fold and projected back
// to one Outcome at each node survives exactly one level: the parent fold sees a single chain from
// each refused child and the rest are gone before the module root. So every recursive step returns
// ResolveNodeWalk, the refused arm carries the whole population upward, and the ONE projection to
// Outcome sits at the legacy entries (resolve_node, resolve_with_namespace_policy,
// resolve_in_context), which keep answering what they answered.
//
// WHY ORDINAL IS CARRIED SEPARATELY, and it is load-bearing rather than tidy: resolve_transform_children
// used `length(done) == 0` to mean "this is the operator child" -- the accumulated EDGE LIST
// standing in for the child index. Once a refused child stops appending, that proxy promotes the
// SECOND child to operator position whenever the first refuses. resolve_bind_edges had already
// found this and threaded its own `idx`; the other three had not. The ordinal advances on every
// arm, refused or not.
//
// WHY CONTINUING IS SOUND, checkable rather than assumed: a child's scope is fixed BEFORE the fold
// runs -- one ctx, a child_ctx computed above the fold, or scope_outer/scope_inner as parameters --
// with ONE exception, and the exception is recorded rather than guessed through. A Bind's inner
// scope is bind_frame_binders over its FIRST child, so when that binder is itself refused the
// inner scope would be built from a binder the walk just rejected. resolve_bind_edges therefore
// marks the site that scope would have governed ObservationIncomplete instead of resolving it: an
// unobserved site is reported as unobserved, never as clean, and never as a refusal it may not own.
type ObservationCompleteness
  = ObservationComplete
  | ObservationIncomplete { reason: Symbol }

fn observation_meet(a: ObservationCompleteness, b: ObservationCompleteness) -> ObservationCompleteness {
  match a {
    ObservationIncomplete { reason: _ } => a
    ObservationComplete => b
  }
}

// ONE RESOLUTION OBSERVATION OF ONE NODE. The refused arm carries the ORDERED POPULATION of
// independent failure chains, `first` then `rest`, so "refused with no chain" has no constructor;
// the accepted arm carries no completeness because incompleteness only ever follows a refusal, so
// "an accepted tree that skipped a site" has no constructor either. Each chain is its own
// NonEmptyDiagnostics: pending advisories followed by exactly ONE fatal, which is what
// v2.std.diagnostic diagnostics_fatal reads as the LAST element.
//
// ORDER IS WALK ORDER -- depth first, children in edge order. Membership is the identity content
// (each chain's fatal and its locus); reversing sibling order reverses those chains' positions and
// changes nothing else. `first` is therefore the one the old short-circuiting walk would have
// stopped at, which is what makes the legacy projection below answer exactly what it answered.
type ResolveNodeWalk
  = ResolveWalkAccepted { value: Node, diagnostics: Diagnostics, lexical: List<LexicalBindingEntry> }
  | ResolveWalkRefused {
      first: NonEmptyDiagnostics
      rest: List<NonEmptyDiagnostics>
      observation: ObservationCompleteness
    }

fn resolve_walk_refused_one(chain: NonEmptyDiagnostics) -> ResolveNodeWalk {
  ResolveWalkRefused { first: chain, rest: [], observation: ObservationComplete }
}

fn resolve_walk_of_outcome(o: Outcome<Node>) -> ResolveNodeWalk {
  match o {
    Accepted { value: v, diagnostics: d } => ResolveWalkAccepted { value: v, diagnostics: d, lexical: [] }
    Rejected { diagnostics: r } => resolve_walk_refused_one(chain: r)
  }
}

// THE LEGACY PROJECTION. resolve's Outcome carries ONE chain, and the population's FIRST chain is
// projected -- the chain the previous walk produced, because it stopped at that same child with the
// same advisories before it. The remaining chains are not discarded: census-resolve reads the walk
// itself through resolve_walk_in_context.
fn resolve_walk_outcome(w: ResolveNodeWalk) -> Outcome<Node> {
  match w {
    ResolveWalkAccepted { value: v, diagnostics: d, lexical: _ } => Accepted { value: v, diagnostics: d }
    ResolveWalkRefused { first: f, rest: _, observation: _ } => Rejected { diagnostics: f }
  }
}

// The stage exit: the same projection, with the index resolution consulted minted beside the root.
fn resolved_tree_outcome(
  w: ResolveNodeWalk,
  symbol_index: SymbolIndex,
  closure_declarations: SymbolIndex,
  unavailable_providers: List<ClosureProviderRefusal>,
  member_kinds: MemberKindChannel
) -> Outcome<ResolvedTree> {
  match w {
    ResolveWalkAccepted { value: v, diagnostics: d, lexical: l } =>
      Accepted {
        value: resolved_tree_of(root: v, symbol_index: symbol_index, closure_declarations: closure_declarations, unavailable_providers: unavailable_providers, member_kinds: member_kinds, lexical: l),
        diagnostics: d
      }
    ResolveWalkRefused { first: f, rest: _, observation: _ } => Rejected { diagnostics: f }
  }
}

// PENDING ADVISORIES STAY WITH THEIR OWN FATAL. A refused child's chains arrive intact; the walk
// prefixes the advisories accepted siblings raised SINCE THE PREVIOUS REFUSAL onto the child's
// first chain only, then resets them. So every advisory lands in at most one chain, the one whose
// fatal it preceded, and the first chain carries exactly the advisories main's walk carried.
// Advisories raised after the last refusal are dropped with the rejected tree, as they were.
fn resolve_walk_prefix_pending(pending: Diagnostics, w: ResolveNodeWalk) -> ResolveNodeWalk {
  match w {
    ResolveWalkAccepted { value: v, diagnostics: d, lexical: l } =>
      ResolveWalkAccepted { value: v, diagnostics: diagnostics_merge(outer: pending, inner: d), lexical: l }
    ResolveWalkRefused { first: f, rest: r, observation: o } =>
      ResolveWalkRefused {
        first: rejected_with_pending(pending: pending, rejected: f),
        rest: r,
        observation: o
      }
  }
}

type ChildWalk {
  ordinal: Int
  edges: List<Edge>
  pending: Diagnostics
  failures: List<NonEmptyDiagnostics>
  observation: ObservationCompleteness
  scope_prerequisite_refused: Bool
  lexical: List<LexicalBindingEntry>
}

fn child_walk_init() -> ChildWalk {
  ChildWalk {
    ordinal: 0,
    edges: empty_edge_list(),
    pending: None,
    failures: [],
    observation: ObservationComplete,
    scope_prerequisite_refused: false,
    lexical: []
  }
}

// ONE CONCATENATION PER REFUSED CHILD, NOT ONE PUSH PER CHAIN (review 70392): a child's `rest`
// arrives already built, so it is joined whole rather than re-walked at every level it crosses on
// its way to the module root. list_snoc_item and list_append are the persistent carrier's push and
// concat (v2.std.algebra), neither of which copies its left operand.
fn child_walk_refused(
  w: ChildWalk,
  first: NonEmptyDiagnostics,
  rest: List<NonEmptyDiagnostics>,
  observation: ObservationCompleteness
) -> ChildWalk {
  ChildWalk {
    ordinal: w.ordinal + 1,
    edges: w.edges,
    pending: None,
    failures: list_append(
      left: list_snoc_item(xs: w.failures, item: rejected_with_pending(pending: w.pending, rejected: first)),
      right: rest
    ),
    observation: observation_meet(a: w.observation, b: observation),
    scope_prerequisite_refused: w.scope_prerequisite_refused,
    lexical: w.lexical
  }
}

fn child_walk_accepted(w: ChildWalk, edge: Edge, d: Diagnostics, lexical: List<LexicalBindingEntry>) -> ChildWalk {
  ChildWalk {
    ordinal: w.ordinal + 1,
    edges: list_snoc_item(xs: w.edges, item: edge),
    pending: diagnostics_merge(outer: w.pending, inner: d),
    failures: w.failures,
    observation: w.observation,
    scope_prerequisite_refused: w.scope_prerequisite_refused,
    lexical: list_append(left: w.lexical, right: lexical)
  }
}

// THE SITE WHOSE SCOPE COULD NOT BE BUILT IS RECORDED AS UNOBSERVED, NOT AS CLEAN AND NOT AS A
// REFUSAL: it is not resolved at all, because resolving it under a scope built from a refused
// prerequisite would report whatever that invented scope happens to answer.
fn child_walk_unobservable(w: ChildWalk, reason: Symbol) -> ChildWalk {
  ChildWalk {
    ordinal: w.ordinal + 1,
    edges: w.edges,
    pending: w.pending,
    failures: w.failures,
    observation: ObservationIncomplete { reason: reason },
    scope_prerequisite_refused: w.scope_prerequisite_refused,
    lexical: w.lexical
  }
}

fn child_walk_step(w: ChildWalk, e: Edge, r: ResolveNodeWalk) -> ChildWalk {
  match r {
    ResolveWalkRefused { first: f, rest: rs, observation: o } =>
      child_walk_refused(w: w, first: f, rest: rs, observation: o)
    ResolveWalkAccepted { value: t, diagnostics: ed, lexical: l } =>
      child_walk_accepted(w: w, edge: Edge { label: e.label, target: t }, d: ed, lexical: l)
  }
}

// THE SCOPE-PRODUCING PREREQUISITE: identical to child_walk_step, and additionally remembers that
// the child every later inner-scope site depends on was refused.
fn child_walk_step_prerequisite(w: ChildWalk, e: Edge, r: ResolveNodeWalk) -> ChildWalk {
  let stepped = child_walk_step(w: w, e: e, r: r)
  ChildWalk {
    ordinal: stepped.ordinal,
    edges: stepped.edges,
    pending: stepped.pending,
    failures: stepped.failures,
    observation: stepped.observation,
    scope_prerequisite_refused: match r {
      ResolveWalkRefused { first: _, rest: _, observation: _ } => true
      ResolveWalkAccepted { value: _, diagnostics: _, lexical: _ } => false
    },
    lexical: stepped.lexical
  }
}

// THE ACCEPTED ARM IS REACHABLE ONLY WHEN THE POPULATION IS EMPTY, so "never return a partially
// accepted tree" is enforced by this match rather than by a caller's discipline. An incomplete
// observation with no refusal does not arise today (an unobservable site only follows a refused
// prerequisite, which is itself a chain); should a future walk produce one, the node is still not
// reported accepted -- it refuses with its own reason rather than borrowing another refusal's.
fn child_walk_node(w: ChildWalk, n: Node) -> ResolveNodeWalk {
  match w.failures {
    Empty =>
      match w.observation {
        ObservationComplete =>
          ResolveWalkAccepted {
            value: node_with_occurrence_id(kind: n.kind, children: w.edges, occurrence_id: n.occurrence_id),
            diagnostics: w.pending,
            lexical: w.lexical
          }
        ObservationIncomplete { reason: _ } =>
          resolve_walk_refused_one(chain: diagnostics_singleton(d: Diagnostic {
            reason: ^resolve_reason_observation_incomplete,
            at: node_locus(node: n),
            correction: Unavailable { reason: UserInputBoundary }
          }))
      }
    Cons { head: first, tail: rest } =>
      ResolveWalkRefused { first: first, rest: rest, observation: w.observation }
  }
}

fn resolve_transform_operator_child(
  ctx: ResolveContext,
  n: Node
) -> ResolveNodeWalk {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      resolve_walk_of_atom(o: resolve_surface_operator_atom(ctx: ctx, n: n, identity: id))
    _ => resolve_node_walk(ctx: ctx, n: n)
  }
}

fn resolve_transform_children(
  ctx: ResolveContext,
  n: Node
) -> ResolveNodeWalk {
  child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
    child_walk_step(
      w: acc,
      e: e,
      r: match e.label {
        Positional =>
          if acc.ordinal == 0 {
            resolve_transform_operator_child(ctx: ctx, n: e.target)
          } else {
            resolve_node_walk(ctx: ctx, n: e.target)
          }
        StructuralLabel { label: _ } =>
          if edge_is_cast_target(e: e) {
            resolve_type_role_target(ctx: ctx, target: e.target)
          } else {
            resolve_node_walk(ctx: ctx, n: e.target)
          }
        Authored { name: _ } => resolve_node_walk(ctx: ctx, n: e.target)
      }
    )
  }))
}


// A MATCH ARM'S BINDERS ARE A LEXICAL FRAME, LIKE PARAMETERS AND `let`. Normalize lowers a pat
// over a fielded variant to the construct shape (v2.std.node_query construct_node): a tag edge that
// names the constructor and one edge per field the pat names, whose target is the
// sub-pat -- a binder atom, `_`, a literal, or a nested construct. The arm's BODY resolves
// under one ScopeFrame holding those binders (name -> name, as arrow_domain_frame_binders
// does); the scrutinee and the sibling arms keep the outer scope, so a binder neither leaks to a
// sibling nor past the match. lookup_chain answers a frame local BoundInFrame before it reaches the
// root or the symbol index, so a binder that spells an outer name shadows it -- a lexical frame,
// deliberately not a namespace binding: a namespace claimant at the same position would be the
// located ambiguity the namespace chain refuses (docs/plans/namespace-resolution-design.md section
// 13), which is right for containment positions and wrong for binders. WHICH FIELD-TARGET ATOMS
// ARE BINDERS: the seed's rule (v1.compiler.04_patterns) -- an atom the symbol index binds to a
// declared payload is a nullary constructor and stays a reference, a canonical symbol is a
// constant; any other atom is a binder (a fn or data of the same name does not make it one); `_`
// binds nothing. The constructor TAG is never a binder: it resolves as
// an ordinary reference, so a misspelled variant in a pat refuses instead of quietly becoming
// a binder that matches everything. A pat that is not a construct (a bare atom, a literal)
// binds nothing and resolves as before.
// WHAT THE NAME DENOTES IS ASKED OF THE INDEX, NOT OF THE NODE (Pkg16). Three shape predicates stood
// here in turn -- the bare Conj connective, the construct tag with an `Absent => true` default, and
// declared-field coverage -- and each classified a MODULE container as a constructor, because a
// declared payload, a module container and a declaration parse-rest node are all Conj with Named
// edges: the shape does not carry the fact.
//
// WHAT THE FILED SPECIMEN CLAIMED, AND WHAT MEASUREMENT SAYS, because this package was filed on a
// route that does not execute and the correction belongs beside the code rather than in a PR body.
// The claim was that `Present { value: node } =>` in v2.std.symbol_index reaches the MODULE
// v2.std.node by lexical ascent and reads it -- Accepted, wrong, silent. Ascent cannot reach a
// module: v2.compiler.symbol_index_fill symbol_index_fill_containment_node DESCENDS module spine
// segments (namespace_graft_spine_segment_edge_optional) without inserting a path, so a module name
// is never an index entry and never a LexicalHit. Measured at fixture scale beside a live control
// (v2.test.claim.match_arm_binder_frame): the reachable route for that spelling is the global-bare
// lookup, which answers Ambiguous and REFUSES, located, rather than accepting a wrong value. The
// specimen itself has not been observed on the native route -- that needs the emitted compiler,
// which does not build on main -- so this states what the corpus shows and not more.
//
// The fact is held by the writers that know what they inserted: v2.compiler.symbol_index_fill marks
// a variant arm and its unique alias as it inserts them, and marks a record from the carrier
// normalize captured before the record rehome erased the distinction (v2.compiler.normalized_tree
// NormalizedTree record_declarations). Both are keyed by DECLARING path, which is the path a lexical
// or global-unique hit returns (for an import binding, the declaration's own path). So a module, a
// data row, a fn and an alias are never constructors here -- not because a predicate excludes them,
// but because nothing marks them.

// The seed's rule, at this resolver's grain: a field-target atom is a constructor when the symbol
// index binds it to a declared payload (a variant arm, module.Type.Variant or its unique alias,
// resolves to its payload Conj; so does a record type), or when it is a canonical symbol (`true`,
// `false`). A fn or data declaration of the same name does NOT make it a constructor: the seed
// binds `x` in `A(x)` even when a fn x exists, and so does this frame.
//
// THE LexicalUnbound BRANCH IS NOT A BRIDGE ANY MORE, AND WHY IT STAYS. It was first written as
// DISSOLVE-ON gunbc#12009: before imports were bindings on the lexical chain, an imported
// constructor in pattern position was reachable only through the corpus-wide spelling census.
// #12009 closed unmerged, but its content landed on main inside gunbc#12048 (stacked on it), so
// imports ARE chain bindings now and an imported constructor hits lexically. That trigger has
// fired. What survives it is a different job: the census here never CHOOSES a meaning that
// succeeds. A LexicalUnbound atom it classifies as a constructor is resolved as a reference by
// resolve_pattern_node, finds nothing on the chain, and REFUSES as unbound, carrying main's
// declared-elsewhere advisory (unbound_symbol_diagnostics). So the census only decides between
// "binder" and "refuse". That is the oracle role docs/plans/namespace-resolution-design.md
// section 13 keeps for global_bare -- explaining an absence -- and not the resolution mechanism
// #12048 deleted. EXECUTED, not only read: gunbc#12082's v2.test.claim.match_arm_binder_frame
// mab_unimported_constructor_in_a_pattern_refuses_rather_than_binding (`None` declared in one
// module, not imported, `A(None) => None` in another) refuses resolve_reason_unbound_symbol. The
// route is GlobalBareLookupAmbiguous (a variant's containment path plus its unique alias), not
// GlobalBareHit: the claim reds with the Ambiguous arm forced to binder and stays green with the
// payload fact forced false.
//
// DELETING IT, the retirement this marker used to promise, would be the wrong move: with
// `LexicalUnbound => namespace_has_canonical_symbol(..)`, an unimported constructor spelling
// (`None` with no import of it) becomes a fresh binder that matches every value. That is Accepted,
// wrong, and silent, which DESIGN section 5 forbids. The cost of keeping it is an
// over-prohibition, stated so it can be priced (DESIGN section 4d): a genuinely fresh binder whose
// spelling is a variant declared somewhere in the corpus refuses, loudly, and the author renames
// it. The branch retires when an unbound pattern atom that spells a declared constructor has its
// own typed refusal that does not consult the corpus-wide census.
// ONE QUESTION PER DECLARING PATH, AND AMBIGUITY ASKS IT OF EVERY CLAIMANT. An ambiguous spelling is
// a constructor when ANY of its candidates is a declared payload -- the fail-closed direction for a
// real payload ambiguity (`None` as a variant and as its unique alias, the mab_* claims), where
// binding would be the silent wrong answer -- and a binder when NONE is. Reading every ambiguity as
// a constructor, as this did before, refused an ordinary binder `d` in
// `Rejected { diagnostics: d }` because several unrelated modules declare non-payloads named `d`:
// an over-prohibition the paragraph above did not price, since it priced only a binder spelled like
// a VARIANT.
fn resolve_path_is_declared_payload(ctx: ResolveContext, path: QualifiedName) -> Bool {
  match symbol_index_declared_payload_at(index: ctx.namespace.symbol_index, qualified_path: path) {
    Present { value: VariantArmPayload } => true
    Present { value: RecordTypePayload } => true
    Absent => false
  }
}

fn resolve_pattern_atom_names_constructor(ctx: ResolveContext, id: Symbol) -> Bool {
  match symbol_index_lexical_lookup(
    index: ctx.namespace.symbol_index,
    position: symbol_index_lookup_position(ctx: ctx),
    name: id
  ) {
    LexicalHit { node: _, path: path } => resolve_path_is_declared_payload(ctx: ctx, path: path)
    LexicalAmbiguous { candidates: candidates } =>
      any(xs: candidates, predicate: fn(c) { resolve_path_is_declared_payload(ctx: ctx, path: c.path) })
    LexicalUnbound =>
      match symbol_index_global_unique_lookup(index: ctx.namespace.symbol_index, name: id) {
        GlobalBareHit { node: _, path: path } => resolve_path_is_declared_payload(ctx: ctx, path: path)
        GlobalBareLookupAmbiguous { paths: paths } =>
          any(xs: paths, predicate: fn(p) { resolve_path_is_declared_payload(ctx: ctx, path: p) })
        GlobalBareLookupUnbound => namespace_has_canonical_symbol(namespace: ctx.namespace, name: id)
      }
  }
}

fn resolve_pattern_binders(ctx: ResolveContext, pat: Node, acc: FrameBinders) -> FrameBinders {
  match construct_tag_optional(n: pat) {
    Absent => acc
    Present { value: _ } =>
      fold(construct_field_edges(n: pat), init: acc, f: fn(fb, e) {
        match node_atom_identity_optional(node: e.target) {
          Present { value: id } =>
            if is_wildcard_pattern(pattern: e.target) {
              fb
            } else if resolve_pattern_atom_names_constructor(ctx: ctx, id: id) {
              fb
            } else {
              frame_binders_add(
                fb: fb,
                name: id,
                binding: LexicalBinding {
                  binder_site: e.target.occurrence_id,
                  standing: match resolve_pattern_binder_declared_type(ctx: ctx, pat: pat, field: e) {
                    PatternBinderFormal { field_type: ft } => LexicalOwedFormal { field_type: ft }
                    PatternBinderTyped { node: t } => LexicalDeclared { node: t }
                    PatternBinderUntyped => LexicalUntyped
                  }
                }
              )
            }
          Absent => resolve_pattern_binders(ctx: ctx, pat: e.target, acc: fb)
        }
      })
  }
}

// A PATTERN BINDER'S TYPE IS THE VARIANT FIELD IT CAPTURES (v2.compiler.body_lowering_fold
// body_lower_field_decl_optional). The arm the pattern's tag names declares the field -- positional
// "0" and named alike, one grammar -- and the binder's declared type is that field's type node, so
// the body's reference derives from its binding (v2.compiler.infer infer_lexical_reference_facts)
// instead of staying on the frontier with the match spine. A tag that names no declared arm, or a
// field the arm does not declare, leaves the binder untyped exactly as before: the match row judges
// the pattern against the scrutinee's coproduct and refuses the mismatch at the arm row.
//
// A field whose type names the DECLARING TYPE's formal is neither typed nor untyped: it is OWED
// (LexicalBinderStanding.LexicalOwedFormal carries the field type) and infer pays it from the
// scrutinee's arguments or refuses.
type PatternBinderDeclared
  = PatternBinderTyped { node: Node }
  | PatternBinderUntyped
  | PatternBinderFormal { field_type: Node }

// A payload field whose type still names the declaring type's formal is detected against the
// declaring type's OWN parameter list -- `symbol_index_declared_type_params_at` at the arm's
// parent path -- so a concrete user type or another declaration's parameter never trips this gate.
fn resolve_payload_field_type_holds_declaring_formal(
  ctx: ResolveContext,
  arm_path: QualifiedName,
  t: Node
) -> Bool {
  resolve_type_node_mentions_any_name(
    t: t,
    names: symbol_index_declared_type_params_at(
      index: ctx.namespace.symbol_index,
      qualified_path: qualified_name_init(qn: arm_path)
    )
  )
}

fn resolve_type_node_mentions_any_name(t: Node, names: List<Symbol>) -> Bool {
  match t.kind {
    TypeNode { connective: Atom { identity: id } } =>
      any(xs: names, predicate: fn(n) { n == id })
    TypeNode { connective: _ } =>
      any(
        xs: node_positional_child_targets(node: t),
        predicate: fn(c) { resolve_type_node_mentions_any_name(t: c, names: names) }
      )
    ComputationNode { behavior: _ } =>
      any(
        xs: node_positional_child_targets(node: t),
        predicate: fn(c) { resolve_type_node_mentions_any_name(t: c, names: names) }
      )
  }
}

fn resolve_pattern_binder_declared_type(ctx: ResolveContext, pat: Node, field: Edge) -> PatternBinderDeclared {
  match resolve_pattern_tag_declared_payload_path_optional(ctx: ctx, pat: pat) {
    Absent => PatternBinderUntyped
    Present { value: arm_path } =>
      match symbol_index_lookup(index: ctx.namespace.symbol_index, qualified_path: arm_path) {
        Absent => PatternBinderUntyped
        Present { value: payload } =>
          match field.label {
            Authored { name: field_name } =>
              match declared_field_named(payload: payload, name: field_name) {
                Present { value: f } =>
                  if resolve_payload_field_type_holds_declaring_formal(
                    ctx: ctx,
                    arm_path: arm_path,
                    t: f.type_node
                  ) {
                    PatternBinderFormal { field_type: f.type_node }
                  } else {
                    PatternBinderTyped { node: f.type_node }
                  }
                Absent => PatternBinderUntyped
              }
            StructuralLabel { label: _ } => PatternBinderUntyped
            Positional => PatternBinderUntyped
          }
      }
  }
}

// The declared arm a pattern's tag names, read BEFORE the walk (the binders mint first, so a
// refused pattern never leaves the body under an invented scope). A one-segment tag looks up
// lexically exactly as resolve_pattern_atom_names_constructor does; a qualified tag looks up
// absolutely; only a candidate the declared-payload authority answers for names an arm.
fn resolve_pattern_tag_declared_payload_path_optional(ctx: ResolveContext, pat: Node) -> Optional<QualifiedName> {
  match construct_tag_path_optional(n: pat) {
    Absent => optional_absent()
    Present { value: path } =>
      match path {
        Cons { head: only, tail: rest } =>
          match rest {
            Empty => resolve_declared_payload_path_lookup(ctx: ctx, name: only)
            Cons { head: _, tail: _ } => resolve_qualified_tag_declared_payload(ctx: ctx, path: path)
          }
        Empty => resolve_qualified_tag_declared_payload(ctx: ctx, path: path)
      }
  }
}

// A tag naming more than one segment is a qualified path; a zero-segment tag cannot happen at a
// pattern (the parser requires a tag), so both non-solo shapes share this lookup.
fn resolve_qualified_tag_declared_payload(ctx: ResolveContext, path: List<Symbol>) -> Optional<QualifiedName> {
  match resolve_declared_payload_candidates(
    ctx: ctx,
    paths: list_map(
      xs: symbol_index_absolute_candidates(index: ctx.namespace.symbol_index, qualified_path: path),
      f: fn(c) { c.path }
    )
  ) {
    Cons { head: only, tail: rest } =>
      match rest {
        Empty => optional_present(value: only)
        Cons { head: _, tail: _ } => optional_absent()
      }
    Empty => optional_absent()
  }
}

fn resolve_declared_payload_path_lookup(ctx: ResolveContext, name: Symbol) -> Optional<QualifiedName> {
  match symbol_index_lexical_lookup(
    index: ctx.namespace.symbol_index,
    position: symbol_index_lookup_position(ctx: ctx),
    name: name
  ) {
    LexicalHit { node: _, path: path } =>
      if resolve_path_is_declared_payload(ctx: ctx, path: path) {
        optional_present(value: path)
      } else {
        optional_absent()
      }
    LexicalAmbiguous { candidates: candidates } =>
      resolve_sole_declared_payload_path(ctx: ctx, paths: list_map(xs: candidates, f: fn(c) { c.path }))
    LexicalUnbound =>
      match symbol_index_global_unique_lookup(index: ctx.namespace.symbol_index, name: name) {
        GlobalBareHit { node: _, path: path } =>
          if resolve_path_is_declared_payload(ctx: ctx, path: path) {
            optional_present(value: path)
          } else {
            optional_absent()
          }
        GlobalBareLookupAmbiguous { paths: paths } => resolve_sole_declared_payload_path(ctx: ctx, paths: paths)
        GlobalBareLookupUnbound => optional_absent()
      }
  }
}

// The declared-payload paths among a candidate set, in lookup order.
fn resolve_declared_payload_candidates(ctx: ResolveContext, paths: FreeMonoid<QualifiedName>) -> FreeMonoid<QualifiedName> {
  match paths {
    Empty => Empty
    Cons { head: p, tail: rest } =>
      if resolve_path_is_declared_payload(ctx: ctx, path: p) {
        Cons { head: p, tail: resolve_declared_payload_candidates(ctx: ctx, paths: rest) }
      } else {
        resolve_declared_payload_candidates(ctx: ctx, paths: rest)
      }
  }
}

// An ambiguous tag must not name an arm by candidate order: a binder typed by the first of several
// declared payloads fabricates a plausible output (DESIGN §5 -- a failure arm refuses, never
// widens). Exactly one declared-payload candidate names the arm; a wider set leaves the binder
// untyped, the behaviour that preceded binder typing. The arm the binder means is settled by the
// scrutinee's coproduct at infer, not by name order here.
fn resolve_sole_declared_payload_path(ctx: ResolveContext, paths: List<QualifiedName>) -> Optional<QualifiedName> {
  match resolve_declared_payload_candidates(ctx: ctx, paths: paths) {
    Cons { head: only, tail: rest } =>
      match rest {
        Empty => optional_present(value: only)
        Cons { head: _, tail: _ } => optional_absent()
      }
    Empty => optional_absent()
  }
}

// The pat resolves under the ARM frame: the tag and any nested constructor resolve as
// references, a binder answers BoundInFrame and stays itself, and the wildcard is kept as it is.
//
// THESE ARE WALKS, ON gunbc#12116's CHILD WALK (XL-2 P4). A pattern, an arm and a match each fold
// their children through child_walk_step and close with child_walk_node, so every independent
// refusal under a match -- a misspelled tag in one arm, an unbound reference in another arm's body
// -- is its own chain in the population, in walk order, and the node is never reported accepted
// while any chain stands. No scope here is built from a resolved child: the arm frame's binders
// come from resolve_pattern_binders over the pattern's SYNTAX and the symbol index, before the
// fold runs, so a refused pattern does not leave the body under an invented scope and no site is
// marked unobservable (P4's one exception, a Bind's binder, has no counterpart here).
//
// A pattern is the arm's whole `pat` or a constructor field's target, and the wildcard is the same
// pattern FORM in both (v2.std.node_query is_wildcard_pattern): it binds nothing and names nothing,
// so it is kept as it is at every depth. Lowering mints it, so it is recognised by form, never by
// comparing an atom's spelling to `_`.
fn resolve_pattern_node_walk(ctx: ResolveContext, pat: Node) -> ResolveNodeWalk {
  if is_wildcard_pattern(pattern: pat) {
    ResolveWalkAccepted { value: pat, diagnostics: None, lexical: [] }
  } else {
    match construct_tag_optional(n: pat) {
      Absent => resolve_node_walk(ctx: ctx, n: pat)
      Present { value: reference } =>
        resolve_construct_walk(ctx: ctx, n: pat, reference: reference, field: fn(e, _) {
          resolve_pattern_node_walk(ctx: ctx, pat: e.target)
        })
    }
  }
}

// A CONSTRUCT RESOLVES ITS TAG AS A REFERENCE AND ITS FIELDS AS THEIR ROLE DEMANDS. The tag edge
// (v2.std.node CoreEdgeLabel ConstructTagEdge) targets the constructor's authored path; it is resolved here,
// once, for a construction and a pattern alike, and the field edges are walked by the caller's
// own rule (a value field as an ordinary child, a pattern field as a sub-pattern). The marker label
// is a role, not a declaration segment, so it never extends the lookup position.
fn resolve_construct_walk(
  ctx: ResolveContext,
  n: Node,
  reference: Node,
  field: fn(Edge, Optional<QualifiedName>) -> ResolveNodeWalk
) -> ResolveNodeWalk {
  resolve_construct_walk_with_tag(
    n: n,
    tag: resolve_construct_tag_walk(ctx: ctx, reference: reference),
    field: field
  )
}

// THE TAG IS WALKED ONCE, BEFORE THE FIELDS, and its resolved declaration path is handed to the
// field rule: a value field under a record construct is walked with that record's authored field
// type as its expectation (resolve_expected_edge), which is how a headless literal nested under an
// authored OR elaborated head elaborates. A tag that did not resolve to a declaration hands Absent,
// and the fields walk as ordinary children.
fn resolve_construct_walk_with_tag(
  n: Node,
  tag: ResolveNodeWalk,
  field: fn(Edge, Optional<QualifiedName>) -> ResolveNodeWalk
) -> ResolveNodeWalk {
  let tag_path = match tag {
    ResolveWalkAccepted { value: resolved, diagnostics: _, lexical: _ } => declaration_reference_path_optional(node: resolved)
    ResolveWalkRefused { first: _, rest: _, observation: _ } => Absent
  }
  child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
    if edge_is_core(e: e, marker: ConstructTagEdge) {
      child_walk_step(w: acc, e: e, r: tag)
    } else {
      child_walk_step(w: acc, e: e, r: field(e, tag_path))
    }
  }))
}

// AN ANONYMOUS RECORD LITERAL IS ELABORATED FROM AN AUTHORED ANNOTATION, OR REFUSED
// (docs/plans/anonymous-record-literal-design.md). `{ f: v }` lowers to a construct whose tag is
// ELIDED (v2.std.node_query construct_tag_reading answers ConstructTagElided). Its constructor is the record the EXPECTED
// type names, and the expectation is an explicit parameter handed by three position rules --
// an Arrow's body under its declared return (which covers a `data` initializer), a record field
// under its authored field type, and a list element under its annotated list's element type -- and
// never ambient context. So a headless literal reached by ANY other edge (a call argument, a let
// without an annotation, a match-arm body) meets resolve_node_walk, which has no expectation to give
// and refuses resolve_anonymous_record_no_expected_type. Nothing is inferred, unified or substituted
// here: the expectation is peeled SYNTACTICALLY from what was written, its head resolved through
// the existing lexical lookup, and the choice is the existing declared-payload authority's
// RecordTypePayload answer. The literal's field set is never an input to the choice; infer checks
// the fields afterwards, exactly as it checks an authored tag.
fn resolve_anonymous_record_refused(n: Node, reason: Symbol) -> ResolveNodeWalk {
  resolve_walk_refused_one(chain: diagnostics_singleton(d: Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }))
}

// THE HEAD OF AN AUTHORED TYPE EXPRESSION, peeled syntactically: a bare name, or the head of an
// instantiation `H<A, ..>`. Anything else -- an optional `T?`, a function type, an anonymous record
// type -- has no head a record could be read from, and answers Absent.
fn resolve_expected_head_node_optional(t: Node) -> Optional<Node> {
  match t.kind {
    TypeNode { connective: Atom { identity: _ } } => optional_present(value: t)
    TypeNode { connective: Instantiation } =>
      match list_at_optional(xs: node_positional_child_targets(node: t), index: 0) {
        Present { value: head } =>
          match head.kind {
            TypeNode { connective: Atom { identity: _ } } => optional_present(value: head)
            _ => optional_absent()
          }
        Absent => optional_absent()
      }
    _ => optional_absent()
  }
}

// THE HEAD IS RESOLVED BY THE SAME ROUTE THE ANNOTATION ITSELF IS. An annotation written in the
// literal's own module (a data declaration's type, a fn's return, a list element type taken from one)
// resolves its head through resolve_atom in this context -- scope chain, root bindings, the index,
// the kernel -- so the expectation can never bind a head to a different declaration than the one
// the annotation denotes. A field type is written in the RECORD's module, whose scope and bindings
// this context does not carry, so it is looked up at the record's own position through the index's
// lexical lookup (NamespaceOnlyY: lookup by containment position). A head that is a binder, a kernel
// symbol, or unbound gives no declaration path, and answers Absent.
// WHERE AN EXPECTED TYPE'S HEAD LEADS: a declaration, nowhere, or round a cycle of aliases.
type ExpectedHead
  = ExpectedHeadAt { path: QualifiedName }
  | ExpectedHeadAbsent
  | ExpectedHeadAliasCycle

fn resolve_expected_head_path(ctx: ResolveContext, x: ResolveExpectation) -> ExpectedHead {
  match resolve_expected_head_path_as_written(ctx: ctx, x: x) {
    Absent => ExpectedHeadAbsent
    Present { value: path } => resolve_expected_rename_chain(ctx: ctx, path: path, visited: [])
  }
}

// A PURE-RENAMING ALIAS IS FOLLOWED; NO OTHER ALIAS IS (docs/plans/anonymous-record-literal-design.md,
// section Pure-renaming aliases). Whether an alias is a
// pure renaming -- `type A<p1..pn> = H<p1..pn>`, or `type A = H` -- was decided once, on its
// declaration, and recorded in the index (v2.std.type_binder type_alias_renaming,
// v2.std.symbol_index symbol_index_renaming_alias_at); this reads that fact and does not re-derive
// it. Following a renaming substitutes nothing: the annotation's own arguments stay in the positions
// they were written. This is how `List<R>` (type List<element> = FreeMonoid<element>) reaches the list
// head. Chains are followed transitively, each renamed head looked up at the alias's own position
// through the existing lexical lookup, and a path met twice is a cycle, refused located rather than
// followed. Any other alias is not recorded as a renaming and is the declaration the head names,
// which is not a record, so the literal refuses.
fn resolve_expected_rename_chain(ctx: ResolveContext, path: QualifiedName, visited: List<QualifiedName>) -> ExpectedHead {
  if any(xs: visited, predicate: fn(v) { v == path }) {
    ExpectedHeadAliasCycle
  } else {
    match symbol_index_renaming_alias_at(index: ctx.namespace.symbol_index, qualified_path: path) {
      Absent => ExpectedHeadAt { path: path }
      Present { value: head } =>
        match symbol_index_lexical_lookup(index: ctx.namespace.symbol_index, position: path, name: head) {
          LexicalHit { node: _, path: renamed } =>
            resolve_expected_rename_chain(ctx: ctx, path: renamed, visited: list_snoc_item(xs: visited, item: path))
          _ => ExpectedHeadAbsent
        }
    }
  }
}

fn resolve_expected_head_path_as_written(ctx: ResolveContext, x: ResolveExpectation) -> Optional<QualifiedName> {
  match resolve_expected_head_node_optional(t: x.expected) {
    Absent => optional_absent()
    Present { value: head } =>
      match head.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if x.at_use_site {
            match resolve_atom(ctx: resolve_ctx_with_scope(ctx: ctx, scope: ctx.type_scope), n: head, identity: id) {
              Accepted { value: resolved, diagnostics: _ } => declaration_reference_path_optional(node: resolved)
              Rejected { diagnostics: _ } => optional_absent()
            }
          } else {
            match symbol_index_lexical_lookup(index: ctx.namespace.symbol_index, position: x.position, name: id) {
              LexicalHit { node: _, path: path } => optional_present(value: path)
              _ => optional_absent()
            }
          }
        _ => optional_absent()
      }
  }
}

// An expected type, and the position its names are read at.
type ResolveExpectation {
  expected: Node
  position: QualifiedName
  at_use_site: Bool
}

// A value edge walked under an expectation. Only three node shapes consume one -- a headless
// literal, an authored construct (whose fields take their own), and a list literal -- and every
// other node is walked exactly as resolve_child_edge would, so the expectation stops here.
fn resolve_expected_edge(ctx: ResolveContext, e: Edge, x: ResolveExpectation) -> ResolveNodeWalk {
  match construct_tag_reading(n: e.target) {
    ConstructTagElided => resolve_elided_construct_walk(ctx: ctx, n: e.target, x: x)
    ConstructTagAuthored { reference: _ } => resolve_child_edge(ctx: ctx, e: e)
    NotAConstruct =>
      match list_introduction_elements_optional(node: e.target) {
        Present { value: _ } => resolve_list_literal_expected(ctx: ctx, n: e.target, x: x)
        Absent => resolve_child_edge(ctx: ctx, e: e)
      }
  }
}

fn resolve_elided_construct_walk(ctx: ResolveContext, n: Node, x: ResolveExpectation) -> ResolveNodeWalk {
  match resolve_expected_head_path(ctx: ctx, x: x) {
    ExpectedHeadAbsent =>
      if resolve_elided_construct_is_map_literal(n: n) {
        resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_map_expected_type_not_map)
      } else {
        resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_record_expected_type_not_record)
      }
    ExpectedHeadAliasCycle => resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_record_alias_cycle)
    ExpectedHeadAt { path: path } =>
      if map_introduction_expected_head_is_map(path: path) {
        resolve_map_literal_walk(ctx: ctx, n: n, x: x)
      } else if resolve_elided_construct_is_map_literal(n: n) {
        resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_map_expected_type_not_map)
      } else {
      match symbol_index_declared_payload_at(index: ctx.namespace.symbol_index, qualified_path: path) {
        Present { value: RecordTypePayload } =>
          match construct_tag_optional_edge_target(n: n) {
            Absent => resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_record_expected_type_not_record)
            Present { value: elided } =>
              resolve_construct_walk_with_tag(
                n: n,
                tag: ResolveWalkAccepted {
                  value: declaration_reference_node(qn: path, occurrence_id: elided.occurrence_id),
                  diagnostics: None,
                  lexical: []
                },
                field: fn(e, record) { resolve_record_field_edge(ctx: ctx, e: e, record: record) }
              )
          }
        _ => resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_record_expected_type_not_record)
      }
      }
  }
}

// THE MAP ARM OF THE ONE ELABORATION WRITER. A
// headless brace whose authored expected head is, by declaration identity, a Map
// (v2.std.map_introduction map_introduction_expected_head_is_map) elaborates to the one
// introduction v2.std.map_introduction lower_map_introduction builds, or refuses located:
//
//   - the expectation must be a closed `Map<K, V>` instantiation, peeled syntactically; else
//     resolve_anonymous_map_expected_type_not_closed at the literal;
//   - every item must be string-keyed; a name-keyed brace under a Map head refuses
//     resolve_anonymous_map_name_key at its first item;
//   - K must be the type a string literal denotes: the kernel text binding an unimported String
//     takes (v2.extdeps.languages.dag dag_kernel_type_binding_optional), never a declaration (a K resolving to any declaration -- the structural v2.std.text String
//     included -- is a text crossing no route declares here); else
//     resolve_anonymous_map_key_kind_mismatch at the first key;
//   - no key may repeat, judged by the key type's equality -- for string literals, decoded text
//     (the decoder gunbc#12759 lands; until then no key has text and the arm refuses at it) -- through the ONE key law,
//     v2.std.map_introduction map_introduction_duplicate_key; a repeat refuses
//     resolve_anonymous_map_duplicate_key at its SECOND occurrence. Never last-wins.
//
// Each value is walked under V (the fifth position rule beside #12711's four), so a nested headless
// value elaborates through this same writer; each key is walked as the ordinary child it is.
// Nothing is unified here, and infer still checks every value against V afterwards.
fn resolve_elided_construct_is_map_literal(n: Node) -> Bool {
  match map_literal_entries(n: n) {
    MapLiteralEntriesNone => false
    MapLiteralEntriesPresent { pairs: _ } => true
    MapLiteralEntriesMalformed => true
  }
}


fn resolve_map_literal_walk(ctx: ResolveContext, n: Node, x: ResolveExpectation) -> ResolveNodeWalk {
  let type_args = node_positional_child_targets(node: x.expected)
  match list_at_optional(xs: type_args, index: 1) {
    Absent => resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_map_expected_type_not_closed)
    Present { value: key_type } =>
      match list_at_optional(xs: type_args, index: 2) {
        Absent => resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_map_expected_type_not_closed)
        Present { value: value_type } =>
          match resolve_map_first_name_keyed_item(items: skip(xs: n.children, n: 1)) {
            Present { value: offending } => resolve_anonymous_record_refused(n: offending, reason: ^resolve_anonymous_map_name_key)
            Absent =>
              match resolve_map_literal_pairs(n: n) {
                ResolveMapPairMalformed { at: p } => resolve_anonymous_record_refused(n: p, reason: ^resolve_anonymous_map_entry_malformed)
                ResolveMapPairsRead { entries: entries } =>
                  if resolve_map_key_type_is_string_literal_type(ctx: ctx, position: x.position, t: key_type) {
                    resolve_map_literal_entries(ctx: ctx, n: n, entries: entries, value_x: ResolveExpectation { expected: value_type, position: x.position, at_use_site: x.at_use_site })
                  } else {
                    match list_at_optional(xs: entries, index: 0) {
                      Present { value: first } => resolve_anonymous_record_refused(n: first.key, reason: ^resolve_anonymous_map_key_kind_mismatch)
                      Absent => resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_map_key_kind_mismatch)
                    }
                  }
              }
          }
      }
  }
}

fn resolve_map_first_name_keyed_item(items: List<Edge>) -> Optional<Node> {
  fold(items, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => if labeled_core_is(x: e, label_of: edge_label_of, wanted: MapLiteralEntriesEdge) { optional_absent() } else { optional_present(value: e.target) }
    }
  })
}

fn resolve_map_key_type_is_string_literal_type(ctx: ResolveContext, position: QualifiedName, t: Node) -> Bool {
  match t.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match symbol_index_lexical_lookup(index: ctx.namespace.symbol_index, position: position, name: id) {
        LexicalUnbound =>
          dag_kernel_string_type_spelling(sym: id) && match dag_kernel_type_binding_optional(sym: id) {
            Present { value: _ } => true
            Absent => false
          }
        _ => false
      }
    _ => false
  }
}

// A pair is a tag-elided construct carrying `key` and `value` (body lowering
// body_lower_map_literal_entry_edge); these read them back.
fn resolve_map_entry_field(entry: Node, field: Symbol) -> Optional<Node> {
  match named_child_lookup(root: entry, name: field) {
    NamedChildFound { target: t } => optional_present(value: t)
    NamedChildMissing => optional_absent()
    NamedChildAmbiguous => optional_absent()
  }
}

// A KEY'S TEXT, OR NONE, read through the ONE string decoder: a string literal lowers to a terminal
// carrying its decoded text (gunbc#12759, v2.extdeps.languages.dag dag_string_literal_value_optional;
// a malformed escape already refused at lowering). A key without that payload has no text, and the
// arm refuses at it rather than compare it -- payload-less keys would all compare equal.
fn resolve_map_key_text_optional(key: Node) -> Optional<String> {
  dag_string_literal_value_optional(node: key)
}

// THE PAIRS, READ TOTALLY. A pair is a tag-elided construct carrying `key` and `value` (body lowering
// body_lower_map_literal_entry_edge). Either every pair carries both, and the entries come back typed
// (key, value, source), or the first pair that does not is named -- never substituted: DESIGN 5 forbids
// a fabricated default, so a missing field is a located refusal
// (resolve_anonymous_map_entry_malformed), however unlikely lowering is to produce one.
type ResolveMapPairs
  = ResolveMapPairsRead { entries: List<MapIntroductionEntryNodes> }
  | ResolveMapPairMalformed { at: Node }

fn resolve_map_pairs(pairs: List<Node>) -> ResolveMapPairs {
  fold(pairs, init: ResolveMapPairsRead { entries: [] }, f: fn(acc, p) {
    match acc {
      ResolveMapPairMalformed { at: _ } => acc
      ResolveMapPairsRead { entries: es } =>
        match resolve_map_entry_field(entry: p, field: ^key) {
          Absent => ResolveMapPairMalformed { at: p }
          Present { value: k } =>
            match resolve_map_entry_field(entry: p, field: ^value) {
              Absent => ResolveMapPairMalformed { at: p }
              Present { value: v } =>
                ResolveMapPairsRead { entries: list_snoc_item(xs: es, item: MapIntroductionEntryNodes { key: k, value: v, source: p }) }
            }
        }
    }
  })
}

fn resolve_map_pair_targets(items: List<Edge>) -> List<Node> {
  fold(items, init: [], f: fn(acc, e) { list_snoc_item(xs: acc, item: e.target) })
}

// The literal's pairs, read through v2.std.map_introduction map_literal_entries: `{}` has none, and a
// malformed entries carrier refuses at the literal rather than reading as empty.
fn resolve_map_literal_pairs(n: Node) -> ResolveMapPairs {
  match map_literal_entries(n: n) {
    MapLiteralEntriesNone => ResolveMapPairsRead { entries: [] }
    MapLiteralEntriesMalformed => ResolveMapPairMalformed { at: n }
    MapLiteralEntriesPresent { pairs: pairs } => resolve_map_pairs(pairs: pairs)
  }
}

// THE KEYS' TEXTS, READ TOTALLY: one text per entry, in order, or the first key with no text, named.
type ResolveMapKeyTexts
  = ResolveMapKeyTextsRead { texts: List<String> }
  | ResolveMapKeyTextless { at: Node }

fn resolve_map_key_texts(entries: List<MapIntroductionEntryNodes>) -> ResolveMapKeyTexts {
  fold(entries, init: ResolveMapKeyTextsRead { texts: [] }, f: fn(acc, e) {
    match acc {
      ResolveMapKeyTextless { at: _ } => acc
      ResolveMapKeyTextsRead { texts: ts } =>
        match resolve_map_key_text_optional(key: e.key) {
          Present { value: t } => ResolveMapKeyTextsRead { texts: list_snoc_item(xs: ts, item: t) }
          Absent => ResolveMapKeyTextless { at: e.key }
        }
    }
  })
}

// The key law sees one text per entry, so its indices are entry indices.
// The pairs are walked under a Transform carrier (positional edges only) that never leaves this
// arm; the resolved pairs are read again through resolve_map_pairs, never defaulted.
fn resolve_map_literal_entries(ctx: ResolveContext, n: Node, entries: List<MapIntroductionEntryNodes>, value_x: ResolveExpectation) -> ResolveNodeWalk {
  match resolve_map_key_texts(entries: entries) {
    ResolveMapKeyTextless { at: key } => resolve_anonymous_record_refused(n: key, reason: ^resolve_anonymous_map_key_text_unavailable)
    ResolveMapKeyTextsRead { texts: texts } =>
      match map_introduction_duplicate_key(keys: texts) {
        MapIntroductionKeyRepeated { first_index: _, second_index: second } =>
          match list_at_optional(xs: entries, index: second) {
            Present { value: e } => resolve_anonymous_record_refused(n: e.key, reason: ^resolve_anonymous_map_duplicate_key)
            Absent => resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_map_duplicate_key)
          }
        MapIntroductionKeysDistinct =>
          let walked = fold(entries, init: child_walk_init(), f: fn(acc, e) {
            child_walk_step(w: acc, e: Edge { label: Positional, target: e.source }, r: resolve_map_entry_walk(ctx: ctx, entry: e.source, value_x: value_x))
          })
          let carrier = node_with_occurrence_id(kind: ComputationNode { behavior: Transform }, children: [], occurrence_id: n.occurrence_id)
          match child_walk_node(w: walked, n: carrier) {
            ResolveWalkRefused { first: f, rest: r, observation: o } => ResolveWalkRefused { first: f, rest: r, observation: o }
            ResolveWalkAccepted { value: resolved, diagnostics: d, lexical: l } =>
              match resolve_map_pairs(pairs: resolve_map_pair_targets(items: resolved.children)) {
                ResolveMapPairMalformed { at: p } => resolve_anonymous_record_refused(n: p, reason: ^resolve_anonymous_map_entry_malformed)
                ResolveMapPairsRead { entries: resolved_entries } =>
                  ResolveWalkAccepted { value: lower_map_introduction(entries: resolved_entries, source: n), diagnostics: d, lexical: l }
              }
          }
      }
  }
}

// One entry: its key walked as an ordinary child, its value under V. The pair keeps its elided tag
// edge untouched; it never leaves this arm.
fn resolve_map_entry_walk(ctx: ResolveContext, entry: Node, value_x: ResolveExpectation) -> ResolveNodeWalk {
  child_walk_node(n: entry, w: fold(entry.children, init: child_walk_init(), f: fn(acc, e) {
    if acc.ordinal == 0 {
      child_walk_step(w: acc, e: e, r: ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] })
    } else {
      match e.label {
        Authored { name: nm } =>
          if symbol_eq(a: nm, b: ^value) {
            child_walk_step(w: acc, e: e, r: resolve_expected_edge(ctx: ctx, e: e, x: value_x))
          } else {
            child_walk_step(w: acc, e: e, r: resolve_child_edge(ctx: ctx, e: e))
          }
        StructuralLabel { label: _ } => child_walk_step(w: acc, e: e, r: resolve_child_edge(ctx: ctx, e: e))
        Positional => child_walk_step(w: acc, e: e, r: resolve_child_edge(ctx: ctx, e: e))
      }
    }
  }))
}

fn construct_tag_optional_edge_target(n: Node) -> Optional<Node> {
  match list_at_optional(xs: n.children, index: 0) {
    Present { value: e } => optional_present(value: e.target)
    Absent => optional_absent()
  }
}

// A FIELD OF A RECORD CONSTRUCT carries its authored field type as its expectation. The field type
// is read from the record's own declaration (symbol_index_lookup, type_decl_view) and its names are
// resolved at the record's path, where they were written. A field with no declared type found --
// an unknown field, which infer refuses at the field -- walks as an ordinary child.
fn resolve_record_field_edge(ctx: ResolveContext, e: Edge, record: Optional<QualifiedName>) -> ResolveNodeWalk {
  match record {
    Absent => resolve_child_edge(ctx: ctx, e: e)
    Present { value: path } =>
      match e.label {
        StructuralLabel { label: _ } => resolve_child_edge(ctx: ctx, e: e)
        Positional => resolve_child_edge(ctx: ctx, e: e)
        Authored { name: field } =>
          match resolve_record_field_type_optional(ctx: ctx, record: path, field: field) {
            Absent => resolve_child_edge(ctx: ctx, e: e)
            Present { value: t } =>
              resolve_expected_edge(ctx: ctx, e: e, x: ResolveExpectation { expected: t, position: path, at_use_site: false })
          }
      }
  }
}

fn resolve_record_field_type_optional(ctx: ResolveContext, record: QualifiedName, field: Symbol) -> Optional<Node> {
  match symbol_index_lookup(index: ctx.namespace.symbol_index, qualified_path: record) {
    Absent => optional_absent()
    Present { value: decl } =>
      let member = match type_decl_view(target: decl) {
        PlainTypeDecl { member: m } => optional_present(value: m)
        GenericTypeDecl { binders: _, member: m } => optional_present(value: m)
        _ => optional_absent()
      }
      match member {
        Absent => optional_absent()
        Present { value: m } =>
          fold_list(xs: m.children, empty: optional_absent(), cons: fn(acc, fe) {
            match acc {
              Present { value: _ } => acc
              Absent =>
                match declared_field_from_edge(e: fe) {
                  Present { value: binder } => if symbol_eq(a: binder.name, b: field) { optional_present(value: binder.type_node) } else { optional_absent() }
                  Absent => optional_absent()
                }
            }
          })
      }
  }
}

// A LIST LITERAL UNDER AN ANNOTATED LIST TYPE passes its element type to each element. The list is
// recognised by the ONE authority infer types list literals with (v2.std.list_introduction
// list_introduction_head_path): the annotation's head must reach exactly that declaration, directly
// or through pure-renaming aliases (resolve_expected_rename_chain; `List<R>` is one). A head that
// reaches it only through any other alias passes no expectation, and a headless element then refuses
// resolve_anonymous_record_no_expected_type.
fn resolve_list_literal_expected(ctx: ResolveContext, n: Node, x: ResolveExpectation) -> ResolveNodeWalk {
  match resolve_expected_head_path(ctx: ctx, x: x) {
    ExpectedHeadAliasCycle => resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_record_alias_cycle)
    ExpectedHeadAbsent => resolve_node_walk(ctx: ctx, n: n)
    ExpectedHeadAt { path: path } =>
      if path == list_introduction_head_path() {
        resolve_list_elements_expected(ctx: ctx, n: n, x: x, element_type: list_at_optional(xs: node_positional_child_targets(node: x.expected), index: 1))
      } else {
        resolve_node_walk(ctx: ctx, n: n)
      }
  }
}

fn resolve_list_elements_expected(ctx: ResolveContext, n: Node, x: ResolveExpectation, element_type: Optional<Node>) -> ResolveNodeWalk {
  match element_type {
    Absent => resolve_node_walk(ctx: ctx, n: n)
    Present { value: et } =>
      child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
        if acc.ordinal == 0 {
          child_walk_step(w: acc, e: e, r: resolve_child_edge(ctx: ctx, e: e))
        } else {
          child_walk_step(w: acc, e: e, r: resolve_expected_edge(ctx: ctx, e: e, x: ResolveExpectation { expected: et, position: x.position, at_use_site: x.at_use_site }))
        }
      }))
  }
}

// ONE ROUTE FOR THE TAG, THROUGH THE DOORS EVERY OTHER REFERENCE USES. The authored path is read
// whole (v2.std.qualified_name qualified_name_from_node) and dispatched by its length only: two or
// more segments go to the qualified door (try_resolve_qualified_name_node), one segment to the bare
// door (resolve_atom on that segment, with the spine root's occurrence, which is the tag's locus).
// Both mint through resolved_reference_node, so a qualified and an unqualified constructor naming
// one declaration resolve to one node. The path is never trimmed: `m.R` is looked up as `m.R`.
//
// WHAT IT RESOLVES TO MUST BE A CONSTRUCTOR. A declaration reference whose path is not a declared
// payload -- a coproduct TYPE rather than one of its variants, a function, a data row -- refuses
// resolve_reason_construct_tag_not_a_constructor, located at the tag. The variant is its own
// declaration (symbol_index_declared_payload_at answers VariantArmPayload for the variant, not for
// its coproduct), so the check is by identity, never by spelling. A tag bound to a kernel canonical
// symbol carries no declaration path and is accepted as that symbol, as a bare atom always was. Any
// other answer -- a field projection, if the qualified door reads the first segment as a local value
// (whether a dotted path is a name or a projection is decided in that door, by the first segment's
// scope, and nowhere here) -- is not a constructor and refuses the same way.
fn resolve_construct_tag_walk(ctx: ResolveContext, reference: Node) -> ResolveNodeWalk {
  match qualified_name_from_node(root: reference) {
    Rejected { diagnostics: r } => resolve_walk_of_outcome(o: Rejected { diagnostics: r })
    Accepted { value: path, diagnostics: _ } =>
      resolve_walk_of_outcome(o: bind_outcome(
        o: resolve_construct_tag_reference(ctx: ctx, reference: reference, path: path),
        f: fn(resolved) { resolve_construct_tag_names_constructor(ctx: ctx, reference: reference, resolved: resolved) }
      ))
  }
}

fn resolve_construct_tag_reference(ctx: ResolveContext, reference: Node, path: QualifiedName) -> Outcome<Node> {
  match path {
    Cons { head: only, tail: Empty } =>
      resolve_atom(ctx: ctx, n: reference, identity: only)
    Cons { head: _, tail: Cons { head: _, tail: _ } } =>
      match try_resolve_qualified_name_node(ctx: ctx, n: reference) {
        Present { value: outcome } => resolved_atom_node(o: outcome)
        Absent => Rejected { diagnostics: diagnostics_singleton(d: unbound_symbol_diagnostic(n: reference)) }
      }
    Empty => Rejected { diagnostics: diagnostics_singleton(d: unbound_symbol_diagnostic(n: reference)) }
  }
}

fn resolve_construct_tag_names_constructor(ctx: ResolveContext, reference: Node, resolved: Node) -> Outcome<Node> {
  match declaration_reference_path_optional(node: resolved) {
    Absent =>
      match resolved.kind {
        TypeNode { connective: Atom { identity: _ } } => Accepted { value: resolved, diagnostics: None }
        _ => resolve_construct_tag_not_a_constructor(reference: reference)
      }
    Present { value: declared } =>
      if resolve_path_is_declared_payload(ctx: ctx, path: declared) {
        Accepted { value: resolved, diagnostics: None }
      } else {
        resolve_construct_tag_not_a_constructor(reference: reference)
      }
  }
}

fn resolve_construct_tag_not_a_constructor(reference: Node) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(d: Diagnostic {
      reason: ^resolve_reason_construct_tag_not_a_constructor,
      at: node_locus(node: reference),
      correction: Unavailable { reason: UserInputBoundary }
    })
  }
}

fn resolve_match_arm_walk(ctx: ResolveContext, arm: Node) -> ResolveNodeWalk {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => resolve_children_homogeneous_scope(ctx: ctx, n: arm)
    Accepted { value: pat, diagnostics: _ } =>
      match gate_value_binders(names: pattern_binder_name_list(ctx: ctx, pat: pat), outer: ctx.scope, at: pat) {
        BinderGateRefused { diagnostic: d } => resolve_walk_refused_one(chain: diagnostics_singleton(d: d))
        BinderGateAdmitted =>
          resolve_match_arm_admitted(ctx: ctx, arm: arm, pat: pat, fb: resolve_pattern_binders(ctx: ctx, pat: pat, acc: frame_binders_empty()))
      }
  }
}

fn resolve_match_arm_admitted(ctx: ResolveContext, arm: Node, pat: Node, fb: FrameBinders) -> ResolveNodeWalk {
  let arm_ctx = resolve_ctx_with_scope(
    ctx: ctx,
    scope: lexical_frame(fb: fb, outer: ctx.scope)
  )
  child_walk_node(n: arm, w: fold(arm.children, init: child_walk_init(), f: fn(acc, e) {
    child_walk_step(
      w: acc,
      e: e,
      r: if edge_is_core(e: e, marker: MatchArmPatternEdge) {
        resolve_pattern_node_walk(ctx: arm_ctx, pat: e.target)
      } else if bind_carries_arm_scope_exit(n: e.target) {
        resolve_arm_scope_exit_bind(arm_ctx: arm_ctx, outer_ctx: ctx, n: e.target)
      } else {
        resolve_node_walk(ctx: arm_ctx, n: e.target)
      }
    )
  }))
}

// A MATCH ARM'S BINDERS END AT ITS LET'S BODY (v2.std.node MatchArmScopeExitEdge). The arm's body is
// a Bind lowered from `let x = match s { .. }` heading a spine
// (v2.compiler.body_lowering_fold body_lower_let_match_binding_arm_continued): its VALUE resolves in
// the arm's scope and sees the pattern's binders, and its BINDER and BODY -- the rest of the spine --
// resolve in the scope enclosing the match, exactly the scopes the source wrote. Both admissions are
// judged against those authored scopes: the pattern by resolve_match_arm_walk against the enclosing
// scope as for every arm, and the let's binder here against that same enclosing scope. The marker
// edge itself is a declaration about scope, not a value, and is carried unwalked.
fn bind_carries_arm_scope_exit(n: Node) -> Bool {
  match n.kind {
    ComputationNode { behavior: Bind } =>
      fold(n.children, init: false, f: fn(acc, e) { acc || edge_is_core(e: e, marker: MatchArmScopeExitEdge) })
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}

fn resolve_arm_scope_exit_bind(arm_ctx: ResolveContext, outer_ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  if positional_child_count(children: n.children) == 3 {
    match gate_value_binders(names: bind_binder_name_list(n: n), outer: outer_ctx.scope, at: n) {
      BinderGateRefused { diagnostic: d } => resolve_walk_refused_one(chain: diagnostics_singleton(d: d))
      BinderGateAdmitted =>
        child_walk_node(n: n, w: fold(
          named_edges(children: n.children),
          init: resolve_bind_positional_edges(
            ctx: arm_ctx,
            edges: positional_edges(children: n.children),
            scope_outer: arm_ctx.scope,
            scope_inner: lexical_frame(fb: bind_frame_binders(n: n), outer: outer_ctx.scope)
          ),
          f: fn(acc, e) {
            if edge_is_core(e: e, marker: MatchArmScopeExitEdge) {
              child_walk_step(w: acc, e: e, r: ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] })
            } else if edge_is_type_annotation(e: e) {
              child_walk_step(w: acc, e: e, r: resolve_type_role_target(ctx: outer_ctx, target: e.target))
            } else {
              child_walk_step(w: acc, e: e, r: resolve_node_walk(ctx: arm_ctx, n: e.target))
            }
          }
        ))
    }
  } else {
    resolve_walk_refused_one(chain: diagnostics_singleton(d: malformed_tree_diagnostic(n: n)))
  }
}

// children[0] is the scrutinee (outer scope); every later child is an arm. The ordinal advances on
// every child, refused or not, so a refused scrutinee never promotes the first arm into its place.
fn resolve_match_node_walk(ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
    child_walk_step(
      w: acc,
      e: e,
      r: if acc.ordinal == 0 {
        resolve_node_walk(ctx: ctx, n: e.target)
      } else {
        resolve_match_arm_walk(ctx: ctx, arm: e.target)
      }
    )
  }))
}

// THE LEGACY ENTRY: one node, one chain. Every caller that asks for an Outcome keeps the answer
// the short-circuiting walk gave; the population is resolve_node_walk.
fn resolve_node(
  ctx: ResolveContext,
  n: Node
) -> Outcome<Node> {
  resolve_walk_outcome(w: resolve_node_walk(ctx: ctx, n: n))
}

fn resolve_node_walk(
  ctx: ResolveContext,
  n: Node
) -> ResolveNodeWalk {
  resolve_node_walk_entered(
    ctx: resolve_ctx_with_declaring(ctx: ctx, declaring: resolve_declaring_entering(declaring: ctx.declaring, n: n)),
    n: n
  )
}

fn resolve_node_walk_entered(
  ctx: ResolveContext,
  n: Node
) -> ResolveNodeWalk {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      resolve_walk_of_atom(o: resolve_atom_answer(ctx: ctx, n: n, identity: id))
    TypeNode { connective: Arrow } =>
      resolve_arrow_node(ctx: ctx, n: n)
    ComputationNode { behavior: Bind } =>
      resolve_bind_node(ctx: ctx, n: n)
    ComputationNode { behavior: Match } =>
      resolve_match_node_walk(ctx: ctx, n: n)
    ComputationNode { behavior: Loop } =>
      resolve_loop_node(ctx: ctx, n: n)
    ComputationNode { behavior: Transform } =>
      resolve_transform_children(ctx: ctx, n: n)
    TypeNode { connective: Conj } =>
      if resolve_is_where_refinement_clause(n: n) {
        resolve_where_refinement_clause(ctx: ctx, n: n)
      } else {
        match construct_tag_reading(n: n) {
          ConstructTagElided =>
            if resolve_elided_construct_is_map_literal(n: n) {
              resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_map_no_expected_type)
            } else {
              resolve_anonymous_record_refused(n: n, reason: ^resolve_anonymous_record_no_expected_type)
            }
          ConstructTagAuthored { reference: reference } =>
            resolve_construct_walk(ctx: ctx, n: n, reference: reference, field: fn(e, record) {
              resolve_record_field_edge(ctx: ctx, e: e, record: record)
            })
          NotAConstruct =>
            match field_projection_optional(n: n) {
              Present { value: _ } => resolve_value_projection_walk(ctx: ctx, n: n)
              Absent =>
                match try_resolve_qualified_name_node(ctx: ctx, n: n) {
                  Present { value: outcome } => resolve_walk_of_atom(o: outcome)
                  Absent => resolve_children_homogeneous_scope(ctx: ctx, n: n)
                }
            }
        }
      }
    TypeNode { connective: Instantiation } =>
      resolve_type_application(ctx: ctx, walked: resolve_children_homogeneous_scope(ctx: ctx, n: n))
    TypeNode { connective: _ } =>
      resolve_children_homogeneous_scope(ctx: ctx, n: n)
    ComputationNode { behavior: _ } =>
      resolve_children_homogeneous_scope(ctx: ctx, n: n)
  }
}

// A TYPE APPLICATION BINDS ITS DECLARATION'S TYPE PARAMETERS IN EXACT BIJECTION, AND EACH ARGUMENT
// INHABITS ITS PARAMETER'S KIND. Checked here, at the head->declaration join, once the head and
// arguments have resolved: the head names a corpus declaration by path, the index carries that
// declaration's binders (v2.std.symbol_index symbol_index_declared_binders_at), and the verdict is
// v2.std.type_binder type_application_conformance's -- the one authority. A refusal is located at the
// application for arity and at the argument for kind, as v1 04_resolve type_param_kind_diagnostics
// locates it.
//
// POPULATION, STATED. A head that is not a corpus declaration reference -- a kernel canonical atom, or a
// type parameter applied as a head -- has no indexed binders, so it is outside this check rather than
// passed by it; a head whose path the index does not hold is contested, and resolve refuses that
// ambiguity where the head resolved.
fn resolve_type_application(ctx: ResolveContext, walked: ResolveNodeWalk) -> ResolveNodeWalk {
  match walked {
    ResolveWalkAccepted { value: resolved, diagnostics: _, lexical: _ } =>
      match resolve_type_application_refusal_optional(ctx: ctx, n: resolved) {
        Absent => walked
        Present { value: d } => resolve_walk_refused_one(chain: diagnostics_singleton(d: d))
      }
    ResolveWalkRefused { first: _, rest: _, observation: _ } => walked
  }
}

fn resolve_type_application_refusal_optional(ctx: ResolveContext, n: Node) -> Optional<Diagnostic> {
  match node_positional_child_targets(node: n) {
    Empty => optional_absent()
    Cons { head: head, tail: arguments } =>
      match declaration_reference_path_optional(node: head) {
        Absent => optional_absent()
        Present { value: path } =>
          match symbol_index_lookup(index: ctx.namespace.symbol_index, qualified_path: path) {
            Absent => optional_absent()
            Present { value: _ } =>
              resolve_type_application_verdict(
                n: n,
                verdict: type_application_conformance(
                  binders: resolve_declared_binders_or_none(ctx: ctx, path: path, at: n),
                  arguments: arguments,
                  inhabits: fn(argument, kind) { resolve_kind_inhabitance(ctx: ctx, declaration: path, argument: argument, kind: kind) }
                )
              )
          }
      }
  }
}

// A declaration that binds no type parameters is applied to none: its binders are the empty Conj.
fn resolve_declared_binders_or_none(ctx: ResolveContext, path: QualifiedName, at: Node) -> Node {
  match symbol_index_declared_binders_at(index: ctx.namespace.symbol_index, qualified_path: path) {
    Present { value: b } => b
    Absent => node_with_occurrence_id(kind: TypeNode { connective: Conj }, children: [], occurrence_id: at.occurrence_id)
  }
}

fn resolve_type_application_verdict(n: Node, verdict: TypeApplicationConformance) -> Optional<Diagnostic> {
  match verdict {
    TypeApplicationConforms => optional_absent()
    TypeApplicationArityMismatch { declared: _, supplied: _ } =>
      optional_present(value: resolve_type_application_diagnostic(reason: ^resolve_reason_type_application_arity_mismatch, at: n))
    TypeApplicationKindNotInhabited { argument: a, kind: _ } =>
      optional_present(value: resolve_type_application_diagnostic(reason: ^resolve_reason_type_argument_kind_not_inhabited, at: a))
    TypeApplicationKindUnresolved { argument: a, kind: _ } =>
      optional_present(value: resolve_type_application_diagnostic(reason: ^resolve_reason_type_parameter_kind_unresolved, at: a))
    TypeApplicationBinderOrderMalformed =>
      optional_present(value: resolve_type_application_diagnostic(reason: ^resolve_reason_type_parameter_order_malformed, at: n))
  }
}

fn resolve_type_application_diagnostic(reason: Symbol, at: Node) -> Diagnostic {
  Diagnostic { reason: reason, at: node_locus(node: at), correction: Unavailable { reason: UserInputBoundary } }
}

// WHETHER A RESOLVED ARGUMENT INHABITS A KIND AS AUTHORED ON `declaration`'s BINDER. The kind is the
// lowered binder's own node, so its name resolves from the DECLARATION's position, never the use's;
// it must name a coproduct, and an argument inhabits it exactly when the argument resolves to one of
// that coproduct's variants -- by the DECLARATION the index holds, never by leaf spelling. A unique
// variant referenced bare resolves to its module-level path (p.Pointer), which
// v2.compiler.symbol_index_fill symbol_index_fill_containment_node files as a BINDING to the
// variant's declaring path (p.Resolution.Pointer) -- the repair the receipt
// a_binding_position_recorded_as_a_declaring_identity names, landed here: the alias was a second
// ENTRY over the same arm node, which was the double-entry defect that row describes, and
// symbol_index_declaring_path_of now relates the two paths with no parallel carrier map. A Nat literal and a type
// parameter of an enclosing declaration are not judged (v2.std.type_binder KindInhabitance).
fn resolve_kind_inhabitance(ctx: ResolveContext, declaration: QualifiedName, argument: Node, kind: Node) -> KindInhabitance {
  if dag_node_is_int_literal_atom(node: argument) {
    ArgumentLiteralUnjudged
  } else if resolve_argument_is_type_parameter(ctx: ctx, argument: argument) {
    ArgumentTypeParameterUnjudged
  } else {
    match resolve_kind_variant_paths_optional(ctx: ctx, declaration: declaration, kind: kind) {
      Absent => KindUnresolved
      Present { value: variants } =>
        match declaration_reference_path_optional(node: argument) {
          Absent => ArgumentOutsideKind
          Present { value: arg_path } =>
            match symbol_index_lookup(index: ctx.namespace.symbol_index, qualified_path: arg_path) {
              Absent => ArgumentOutsideKind
              Present { value: arg_decl } =>
                if any(xs: variants, predicate: fn(v) { resolve_path_declares_node(ctx: ctx, path: v, declared: arg_decl) }) { ArgumentInhabitsKind } else { ArgumentOutsideKind }
            }
        }
    }
  }
}

fn resolve_argument_is_type_parameter(ctx: ResolveContext, argument: Node) -> Bool {
  match type_binder_atom_identity_optional(n: argument) {
    Absent => false
    Present { value: id } =>
      resolve_scope_binds_type_parameter(s: ctx.type_scope, name: id) || resolve_scope_binds_type_parameter(s: ctx.scope, name: id)
  }
}

fn resolve_scope_binds_type_parameter(s: Scope, name: Symbol) -> Bool {
  match lookup_chain(s: s, name: name) {
    Accepted { value: found, diagnostics: _ } =>
      match found {
        BoundInFrame { canonical: _, kind: k } =>
          match k {
            TypeParameterFrame => true
            ParameterFrame { arrow_path: _ } => false
            LexicalFrame { binders: _ } => false
          }
        BoundAtRoot { canonical: _ } => false
        ScopeUnbound => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn resolve_path_declares_node(ctx: ResolveContext, path: QualifiedName, declared: Node) -> Bool {
  match symbol_index_lookup(index: ctx.namespace.symbol_index, qualified_path: path) {
    Present { value: n } => n == declared
    Absent => false
  }
}

// The variant paths of the coproduct a kind atom names, looked up lexically from the declaration.
fn resolve_kind_variant_paths_optional(ctx: ResolveContext, declaration: QualifiedName, kind: Node) -> Optional<List<QualifiedName>> {
  match type_binder_atom_identity_optional(n: kind) {
    Absent => optional_absent()
    Present { value: kind_name } =>
      match symbol_index_lexical_lookup(index: ctx.namespace.symbol_index, position: declaration, name: kind_name) {
        LexicalHit { node: kind_decl, path: kind_binding } =>
          let kind_path = symbol_index_declaring_path_of(index: ctx.namespace.symbol_index, target: kind_binding)
          match kind_decl.kind {
            TypeNode { connective: Disj } =>
              optional_present(value: fold(kind_decl.children, init: Empty, f: fn(acc, e) {
                match e.label {
                  Authored { name: v } => list_snoc_item(xs: acc, item: qualified_name_snoc(qn: kind_path, segment: v))
                  StructuralLabel { label: _ } => acc
                  Positional => acc
                }
              }))
            TypeNode { connective: _ } => optional_absent()
            ComputationNode { behavior: _ } => optional_absent()
          }
        LexicalAmbiguous { candidates: _ } => optional_absent()
        LexicalUnbound => optional_absent()
      }
  }
}

// A LOOP RESOLVES ITS EDGES AS ANY NODE DOES, EXCEPT TWO. The domain and body walk through
// resolve_child_edge as ordinary expressions. ^loop_realized_declaration_edge (v2.std.node
// LoopRealizedDeclaration) is a CLAIM made by a desugaring about which declaration the author's head
// names; resolve checks that claim and does not take it on trust. ^loop_carrier_edge
// (LoopCarrierBinder) is a BINDER, never a value (v2.compiler.fold_lowering fold_recurrence_encoding):
// it names the enclosing Bind's binder, which a desugaring wrote as a synthetic atom. It is checked
// against that frame and kept as the binder atom, exactly as the Bind's own binder is
// (resolve_bind_binder_target); minting it as a lexical reference would read a binder as a use.
// THIS LANE'S CARRIER FRAME IS DISSOLVED, AND THE REASON BELONGS HERE. The pre-#12550 fold seam built a
// BARE Loop with no enclosing Bind, so the carrier was bound by nothing and the step body's use of it
// reached the bare-name census; opening a frame at the Loop repaired that, and the native eight moved off
// their `found` refusal because of it. #12550 then replaced the seam with
// Bind { carrier := init, Loop { step, domain, carrier, bound, realized } }, which binds the carrier where
// the role model always said it lived -- the annotation above states it: the carrier resolves against the
// ENCLOSING Bind's frame.
//
// The frame then became redundant and harmful at once: the Loop re-admitted a name the Bind above it had
// already bound, and this lane's own value-binder admission refused it as hiding a visible binding. That is
// what the native eight reported at a synthetic occurrence, and what reds five of #12550's own claims.
// So the repair was correct for a structure that no longer exists and is DELETED rather than guarded -- a
// guard would have been this walk encoding a fact about which producer built the Loop (DESIGN section 6b),
// and the dissolution-on-climb rule asks for the obsolete production handling to go while the evidence
// stays (section 4b(4)).
fn resolve_loop_node(ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
    match loop_edge_role(e: e) {
      LoopRealizedDeclaration => child_walk_step(w: acc, e: e, r: resolve_walk_of_outcome(o: resolve_realized_declaration(ctx: ctx, head: e.target)))
      LoopCarrierBinder => child_walk_step(w: acc, e: e, r: resolve_loop_carrier_binder(ctx: ctx, carrier: e.target))
      _ => child_walk_step(w: acc, e: e, r: resolve_child_edge(ctx: ctx, e: e))
    }
  }))
}

// The carrier, bound by a frame, stays the atom it names; any other answer is what resolve_atom
// gives any name, so an unbound carrier refuses exactly as before.
fn resolve_loop_carrier_binder(ctx: ResolveContext, carrier: Node) -> ResolveNodeWalk {
  match carrier.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match lookup_chain(s: ctx.scope, name: id) {
        Accepted { value: BoundInFrame { canonical: canonical, kind: _ }, diagnostics: pending } =>
          ResolveWalkAccepted { value: canonical_atom(identity: canonical, occurrence_id: carrier.occurrence_id), diagnostics: pending, lexical: [] }
        _ => resolve_walk_of_outcome(o: resolve_atom(ctx: ctx, n: carrier, identity: id))
      }
    _ => resolve_node_walk(ctx: ctx, n: carrier)
  }
}

fn realized_declaration_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn realized_declaration_refused(reason: Symbol, n: Node, pending: Diagnostics) -> Outcome<Node> {
  Rejected {
    diagnostics: rejected_with_pending(
      pending: pending,
      rejected: diagnostics_singleton(d: realized_declaration_diagnostic(reason: reason, n: n))
    )
  }
}

fn declaration_ref_path(r: DeclarationRef) -> QualifiedName {
  qualified_name_snoc(
    qn: qualified_name_from_dotted_string(dotted: r.module_path),
    segment: symbol_intern_lexeme(lexeme: r.decl_name)
  )
}

// What the author's head binds to, asked exactly as resolve_atom asks it for any reference (the
// frame, the module root, then the imports on the symbol index). Absent means that nothing binds it.
type RealizedHeadLookup
  = RealizedHeadBound { path: QualifiedName }
  | RealizedHeadBoundLocally
  | RealizedHeadAmbiguous { class: AmbiguousLookupClass }
  | RealizedHeadUnbound

fn realized_head_lookup(ctx: ResolveContext, identity: Symbol) -> Outcome<RealizedHeadLookup> {
  match lookup_chain(s: ctx.scope, name: identity) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: found, diagnostics: pending } =>
      match found {
        BoundInFrame { canonical: _, kind: _ } => Accepted { value: RealizedHeadBoundLocally, diagnostics: pending }
        BoundAtRoot { canonical: _ } =>
          Accepted {
            value: RealizedHeadBound {
              path: qualified_name_snoc(qn: root_binding_origin(namespace: ctx.namespace, name: identity), segment: identity)
            },
            diagnostics: pending
          }
        ScopeUnbound =>
          match lookup_symbol_index_atom_identity(ctx: ctx, name: identity) {
            SymbolIndexAtomHit { path: path } => Accepted { value: RealizedHeadBound { path: path }, diagnostics: pending }
            SymbolIndexAtomAmbiguous { class: class } => Accepted { value: RealizedHeadAmbiguous { class: class }, diagnostics: pending }
            SymbolIndexAtomUnbound => Accepted { value: RealizedHeadUnbound, diagnostics: pending }
          }
      }
  }
}

// THE CHECK, and the order matters. A ROSTER OPERATION (collection `fold`) has no corpus
// declaration, so if the head's chain binds its spelling at all -- a local, a module-level `fn fold`,
// an import -- the author wrote a call to THAT declaration, and the desugar is refused at the head
// (^resolve_reason_realized_declaration_shadowed). Only an unbound head binds, and it binds to the
// row's declaring function. It never falls back to treating the head as the builtin. A CORPUS
// DECLARATION (fold_list) must be bound by the chain to exactly that declaration; anything else,
// unbound included, refuses (^resolve_reason_realized_declaration_mismatch). A head the family does
// not know refuses the same way, because a Loop claiming a declaration nobody can check is the
// fabricated claim this edge exists to stop.
fn resolve_realized_declaration(ctx: ResolveContext, head: Node) -> Outcome<Node> {
  match head.kind {
    TypeNode { connective: Atom { identity: identity } } =>
      match realized_head_lookup(ctx: ctx, identity: identity) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: found, diagnostics: pending } =>
          match fold_family_realization(head: identity) {
            Absent => realized_declaration_refused(reason: ^resolve_reason_realized_declaration_mismatch, n: head, pending: pending)
            Present { value: FoldRealizesRosterOperation { template: t, row: row, slots: _ } } =>
              match found {
                RealizedHeadUnbound =>
                  if symbol_lexeme(sym: identity) == t.name {
                    resolve_atom_bound(ctx: ctx, n: head, path: declaration_ref_path(r: row), pending: pending)
                  } else {
                    realized_declaration_refused(reason: ^resolve_reason_realized_declaration_mismatch, n: head, pending: pending)
                  }
                RealizedHeadBound { path: _ } => realized_declaration_refused(reason: ^resolve_reason_realized_declaration_shadowed, n: head, pending: pending)
                RealizedHeadBoundLocally => realized_declaration_refused(reason: ^resolve_reason_realized_declaration_shadowed, n: head, pending: pending)
                RealizedHeadAmbiguous { class: _ } => realized_declaration_refused(reason: ^resolve_reason_realized_declaration_shadowed, n: head, pending: pending)
              }
            Present { value: FoldRealizesDeclaration { declaration: d, slots: _ } } =>
              match found {
                RealizedHeadBound { path: path } =>
                  if qualified_name_to_dotted_string(qn: path) == qualified_name_to_dotted_string(qn: declaration_ref_path(r: d)) {
                    resolve_atom_bound(ctx: ctx, n: head, path: path, pending: pending)
                  } else {
                    realized_declaration_refused(reason: ^resolve_reason_realized_declaration_mismatch, n: head, pending: pending)
                  }
                RealizedHeadBoundLocally => realized_declaration_refused(reason: ^resolve_reason_realized_declaration_mismatch, n: head, pending: pending)
                RealizedHeadAmbiguous { class: _ } => realized_declaration_refused(reason: ^resolve_reason_realized_declaration_mismatch, n: head, pending: pending)
                RealizedHeadUnbound => realized_declaration_refused(reason: ^resolve_reason_realized_declaration_mismatch, n: head, pending: pending)
              }
          }
      }
    _ => Rejected { diagnostics: diagnostics_singleton(d: malformed_tree_diagnostic(n: head)) }
  }
}

// A WHERE-REFINEMENT PREDICATE BINDS TO ITS DECLARATION, OR THE CLAUSE REFUSES. Lowering
// (v2.compiler.body_lowering_fold body_lower_kept_where_clause) carries the clause as a production
// Conj whose captured child holds one call-shaped Transform per predicate, the predicate's own name
// atom as operator. The operator resolves by ORDINARY name lookup -- the same resolve_atom every
// reference takes, so the NAME has one authority, the declaration (std.types string_non_empty /
// gt_zero / range, std.content_hash lower_hex_*), and there is no second predicate namespace. The
// predicate's MEANING is still stated twice until v1's enforcement tables can consult the
// declaration (feature:where-refinement-predicate-declaration-authority, the next change); the drift
// between them is held by test.claim.where_refinement_predicate_vocabulary_witness_test. A spelling nothing declares refuses as resolve_reason_where_predicate_unbound,
// located at the predicate's own atom: an unbound predicate is not an unbound value reference, and
// the author looking for it needs to know a where clause named it. `brand` binds to its declared
// nominal marker (std.types brand -> WherePredicateMarker), so it too is bound and never silent.
// What resolve does NOT do is judge a predicate: it binds, and nothing here evaluates.
fn resolve_is_where_refinement_clause(n: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: emitted } => emitted == ^dag_surface_where_refinement_clause
    Absent => false
  }
}

fn where_predicate_unbound_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_where_predicate_unbound,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn resolve_where_predicate_operator(ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match resolve_atom(ctx: ctx, n: n, identity: id) {
        Rejected { diagnostics: d } =>
          if diagnostics_fatal_reason(d: d) == ^resolve_reason_unbound_symbol {
            resolve_walk_refused_one(chain: diagnostics_singleton(d: where_predicate_unbound_diagnostic(n: n)))
          } else {
            resolve_walk_of_outcome(o: Rejected { diagnostics: d })
          }
        Accepted { value: v, diagnostics: d } => resolve_walk_of_outcome(o: Accepted { value: v, diagnostics: d })
      }
    _ => resolve_walk_refused_one(chain: diagnostics_singleton(d: malformed_tree_diagnostic(n: n)))
  }
}

fn resolve_where_predicate_call(ctx: ResolveContext, call: Node) -> ResolveNodeWalk {
  child_walk_node(n: call, w: fold(call.children, init: child_walk_init(), f: fn(acc, e) {
    child_walk_step(
      w: acc,
      e: e,
      r: if acc.ordinal == 0 {
        resolve_where_predicate_operator(ctx: ctx, n: e.target)
      } else {
        resolve_node_walk(ctx: ctx, n: e.target)
      }
    )
  }))
}

fn resolve_where_predicate_set(ctx: ResolveContext, set: Node) -> ResolveNodeWalk {
  child_walk_node(n: set, w: fold(set.children, init: child_walk_init(), f: fn(acc, e) {
    child_walk_step(w: acc, e: e, r: resolve_where_predicate_call(ctx: ctx, call: e.target))
  }))
}

fn resolve_where_refinement_clause(ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
    child_walk_step(
      w: acc,
      e: e,
      r: match e.label {
        Authored { name: sym } =>
          if sym == ^grammar_production_captured_node_projection {
            resolve_where_predicate_set(ctx: ctx, set: e.target)
          } else {
            ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] }
          }
        StructuralLabel { label: _ } => ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] }
        Positional => resolve_walk_refused_one(chain: diagnostics_singleton(d: malformed_tree_diagnostic(n: e.target)))
      }
    )
  }))
}

fn resolve_preserve_module_root_named_edge(e: Edge) -> Bool {
  dag_surface_module_header_metadata_edge(e: e)
    || dag_resolve_preserve_module_metadata_subtree(node: e.target)
    || labeled_named_is(x: e, label_of: edge_label_of, wanted: ^grammar_production_identity_node_projection)
}


// ONE EDGE'S TARGET, OBSERVED. A preserved metadata edge is accepted as its own target unchanged,
// so the caller rebuilding Edge { label, target } reproduces the edge exactly.
fn resolve_child_edge(
  ctx: ResolveContext,
  e: Edge
) -> ResolveNodeWalk {
  match e.label {
    Authored { name: _ } => resolve_labeled_child_edge(ctx: ctx, e: e)
    StructuralLabel { label: _ } => resolve_labeled_child_edge(ctx: ctx, e: e)
    Positional =>
      if ctx.under_module_root
        && dag_resolve_preserve_module_metadata_subtree(node: e.target) {
        ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] }
      } else {
        resolve_node_walk(ctx: ctx, n: e.target)
      }
  }
}

// A labeled edge under the module root extends the lexical position by the label's scope segment
// (label_sort_key), except a preserved metadata edge, which is accepted as its own target.
fn resolve_labeled_child_edge(ctx: ResolveContext, e: Edge) -> ResolveNodeWalk {
  if ctx.under_module_root && resolve_preserve_module_root_named_edge(e: e) {
    ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] }
  } else {
    let child_ctx = if ctx.under_module_root && !dag_surface_module_header_metadata_edge(e: e) && !binder_node_edge(e: e) {
      resolve_ctx_snoc_position(ctx: ctx, segment: label_sort_key(label: e.label))
    } else {
      ctx
    }
    resolve_node_walk(
      ctx: resolve_ctx_with_declaring(ctx: child_ctx, declaring: resolve_declaring_across_named_edge(declaring: ctx.declaring, e: e)),
      n: e.target
    )
  }
}

data arrow_domain_param_scoping_note: String = "Wave 1 Gate 1 A1: param scoping is arrow_domain_frame_binders over lowered Arrow domain Named edges (general-body-producer-design Stage A). dag_fn_decl_param_binding_atoms and scope_with_fn_decl_params dissolved. fn_decl ident now routes through StampLexeme and SymbolIndex fill carries module_qn.fn.param (parity proven by execution); domain construction remains interim param-list-walk (body_lower_domain_from_param_list) until domain is built from SymbolIndex lookup rather than walked from the param list."

// Whether an Arrow scopes its domain's binders is v2.std.node arrow_domain_binds_a_name, the same
// answer Node admission reads (A4). The retired Atom-domain arm is gone: under the one Arrow encoding
// (gunbc#12625) a domain is a Conj of binders, and an Atom in domain position is a type, never a local.
fn arrow_domain_has_named_bindings(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Arrow } => arrow_domain_binds_a_name(children: n.children)
    _ => false
  }
}

// A PROJECTION OFF A VALUE RESOLVES ITS BASE AND NOT ITS FIELD. Body lowering builds
// v2.std.node_query field_projection_node over a base that is already a value -- a call result
// (`diagnostics_fatal(d: d).reason`), a cast, a construct -- where a bound-name head instead stays a
// spine for resolve_bound_head_projection. Walked as an ordinary Conj, the FIELD atom was resolved as a
// free name and refused unbound (or bound to an unrelated declaration of the same spelling); a field is
// not a reference -- whether the base's type declares it is infer's judgement over the receiver's type,
// exactly as for the bound-head projection resolve builds itself.
fn resolve_value_projection_walk(ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
    match field_projection_edge_field_optional(e: e) {
      Present { value: _ } => child_walk_step(w: acc, e: e, r: ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] })
      Absent => child_walk_step(w: acc, e: e, r: resolve_child_edge(ctx: ctx, e: e))
    }
  }))
}

fn resolve_children_homogeneous_scope(
  ctx: ResolveContext,
  n: Node
) -> ResolveNodeWalk {
  let at_module_root = ctx.under_module_root || dag_node_is_module_root_conj(n: n)
  let scope_type = resolve_type_param_frame(n: n, outer: ctx.scope)
  let scope_here = match arrow_domain_has_named_bindings(n: n) {
    true => lexical_frame(fb: arrow_domain_frame_binders(n: n), outer: scope_type)
    false => scope_type
  }
  let child_ctx = resolve_ctx_with_scope(
    ctx: resolve_ctx_with_under_module_root(ctx: ctx, under_module_root: at_module_root),
    scope: scope_here
  )
  child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
    if edge_is_type_params(e: e) {
      child_walk_step(w: acc, e: e, r: resolve_type_params_conj(ctx: ctx, conj: e.target))
    } else {
      child_walk_step(w: acc, e: e, r: resolve_child_edge(ctx: child_ctx, e: e))
    }
  }))
}

// AN ARROW'S TYPE PARAMETERS ARE A LEXICAL FRAME OVER ITS SIGNATURE. `fn f<T>(x: T) -> T` binds
// `T` for the domain and the codomain -- the same frame mechanism as a value parameter, a `let`
// binder and a match-arm binder, in the type role.
//
// THE BODY IS OUTSIDE IT, AND THAT IS MEASURED, NOT CHOSEN FOR TIDINESS. A frame answers a name
// without knowing its position, and v2.compiler.body_lowering_fold carries no TYPE position into a
// body then (a `let` lowered to Bind[binder, value, body], its annotation not carried; lambdas are
// not lowered). So every `T` a body can contain is a VALUE-position use, and a frame over the body
// admitted exactly one new program: `fn f<T>(x: T) -> T { T }`, a type used as a value, Accepted.
// Kept off the body, that refuses as it did before. The trigger for widening the frame is the
// first body type position the lowering carries, and it must arrive position-aware: a type-role
// frame answering in type positions only. A lambda's own Arrow opens its own frame through this
// same function, so a fresh type parameter scoped to a lambda does not wait on that trigger.
//
// Without the frame the domain resolved in the declaration's
// OUTER scope, and `T` fell through to the ordinary name chain: refused as unbound where nothing
// spelled it, and -- silent wrongness -- bound to whatever declaration did
// (gunbc.recurring_failure_mode generic_type_parameter_resolved_as_an_ordinary_atom_in_v2). An
// Arrow declaring no type parameters walks exactly as before: its type frame is empty.
//
// A TYPE DECLARATION'S PARAMETERS ARE THE SAME FRAME OVER ITS MEMBER. `type Box<T> = Full { value: T }
// | Empty` lowers to the wrapper Conj { <type-parameters>: binders, <type-body>: member }
// (v2.std.type_binder type_decl_wrapper), and resolve_children_homogeneous_scope opens this frame over
// the wrapper -- so over the member -- and checks its binders through resolve_type_params_conj: the
// helpers below, shared with resolve_arrow_node, not copied.
// A type declaration has no body of VALUE positions, so its frame covers the whole member.
//
// NO SHADOWING. A type parameter whose spelling already names something visible at the
// declaration REFUSES resolve_reason_type_parameter_shadows_visible_name, located at the binder.
// It is not a style rule: v2.compiler.infer recognizes a type variable by the callee Arrow's own
// type-parameter edge (v2.std.type_binder type_param_names), and that reading is sound only because
// no `T` inside the Arrow can mean anything but its binder.
fn resolve_type_param_frame(n: Node, outer: Scope) -> Scope {
  match type_param_names(n: n) {
    Empty => outer
    Cons { head: _, tail: _ } =>
      ScopeFrame {
        locals: fold(type_param_names(n: n), init: empty_map(), f: fn(acc, name) {
          map_insert(acc, name, name)
        }),
        outer: outer,
        kind: TypeParameterFrame
      }
  }
}

fn type_param_shadows_visible_name_diagnostic(binder: Node) -> Diagnostic {
  Diagnostic {
    reason: ^resolve_reason_type_parameter_shadows_visible_name,
    at: node_locus(node: binder),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// A binder is admitted exactly when its spelling, looked up from the declaration's own scope,
// is unbound. Any other answer -- a binding, an ambiguity, a test-code wall -- is a visible name.
fn resolve_type_param_binder(ctx: ResolveContext, binder: Node) -> ResolveNodeWalk {
  match node_atom_identity_optional(node: binder) {
    Present { value: id } =>
      match resolve_atom(ctx: ctx, n: binder, identity: id) {
        Rejected { diagnostics: d } =>
          if diagnostics_fatal_reason(d: d) == ^resolve_reason_unbound_symbol {
            resolve_type_param_binder_kind(ctx: ctx, binder: binder, identity: id)
          } else {
            resolve_walk_refused_one(chain: diagnostics_singleton(d: type_param_shadows_visible_name_diagnostic(binder: binder)))
          }
        Accepted { value: _, diagnostics: _ } =>
          resolve_walk_refused_one(chain: diagnostics_singleton(d: type_param_shadows_visible_name_diagnostic(binder: binder)))
      }
    Absent => resolve_walk_refused_one(chain: diagnostics_singleton(d: malformed_tree_diagnostic(n: binder)))
  }
}

// AN ADMITTED BINDER KEEPS ITS KIND, RESOLVED. The kind is an ordinary type expression in the
// declaration's scope (v2.std.type_binder type_param_kind_optional), so it resolves as any type
// position does and a kind that names nothing refuses here, at the kind.
fn resolve_type_param_binder_kind(ctx: ResolveContext, binder: Node, identity: Symbol) -> ResolveNodeWalk {
  match type_param_kind_optional(binder: binder) {
    Absent =>
      ResolveWalkAccepted { value: canonical_atom(identity: identity, occurrence_id: binder.occurrence_id), diagnostics: None, lexical: [] }
    Present { value: kind } =>
      match resolve_node_walk(ctx: ctx, n: kind) {
        ResolveWalkAccepted { value: resolved_kind, diagnostics: d, lexical: l } =>
          ResolveWalkAccepted {
            value: node_with_occurrence_id(
              kind: TypeNode { connective: Atom { identity: identity } },
              children: [core_edge(marker: BinderTypeEdge, target: resolved_kind)],
              occurrence_id: binder.occurrence_id
            ),
            diagnostics: d,
            lexical: l
          }
        ResolveWalkRefused { first: f, rest: r, observation: o } => ResolveWalkRefused { first: f, rest: r, observation: o }
      }
  }
}

// The set's declared-order edge is label metadata (v2.std.node type_binder_conj_conforms), not a
// binder: it is carried through unchanged, never resolved as one.
fn resolve_type_params_conj(ctx: ResolveContext, conj: Node) -> ResolveNodeWalk {
  child_walk_node(n: conj, w: fold(conj.children, init: child_walk_init(), f: fn(acc, e) {
    if edge_is_core(e: e, marker: ArrowSignatureOrderEdge) {
      child_walk_step(w: acc, e: e, r: ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] })
    } else {
      child_walk_step(w: acc, e: e, r: resolve_type_param_binder(ctx: ctx, binder: e.target))
    }
  }))
}

// THE ARROW'S DOMAIN IS NOT A SCOPE-PRODUCING PREREQUISITE in the sense the Bind binder is: its
// parameter names are read syntactically by arrow_domain_frame_binders (and its type parameters by
// v2.std.type_binder type_param_names), so a domain that refuses
// to RESOLVE a parameter's type still binds the parameter's name, and the codomain's scope is not
// invented by that refusal.
fn resolve_arrow_node(ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  resolve_arrow_node_in(
    outer_ctx: ctx,
    ctx: resolve_ctx_with_type_scope(ctx: ctx, type_scope: resolve_type_param_frame(n: n, outer: ctx.type_scope)),
    n: n
  )
}


// THE BODY OF AN ARROW IS WALKED UNDER ITS DECLARED RETURN, as authored: a `data x: T = e` lowers to
// Arrow(<empty domain>, T, T, body: e) and a `fn f(..) -> T { e }` to the same shape, so this one
// rule is both the data-initializer and the declared-return position of
// docs/plans/anonymous-record-literal-design.md. Only a headless literal or a list literal consumes
// the expectation; every other body walks exactly as it did.
fn resolve_arrow_body_or_named_edge(ctx: ResolveContext, arrow: Node, e: Edge) -> ResolveNodeWalk {
  if resolve_edge_is_arrow_body(e: e) && resolve_node_consumes_expectation(n: e.target) {
    match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 1) {
      Present { value: declared } =>
        resolve_expected_edge(
          ctx: ctx,
          e: e,
          x: ResolveExpectation { expected: declared, position: symbol_index_lookup_position(ctx: ctx), at_use_site: true }
        )
      Absent => resolve_node_walk(ctx: ctx, n: e.target)
    }
  } else {
    resolve_node_walk(ctx: ctx, n: e.target)
  }
}

fn resolve_edge_is_arrow_body(e: Edge) -> Bool {
  edge_is_core(e: e, marker: ArrowBodyEdge)
}

fn resolve_node_consumes_expectation(n: Node) -> Bool {
  match construct_tag_reading(n: n) {
    ConstructTagElided => true
    ConstructTagAuthored { reference: _ } => false
    NotAConstruct =>
      match list_introduction_elements_optional(node: n) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

// The Arrow's own <T> binders are checked from the OUTER context: the frame they open must not
// answer for them, or every binder would read as shadowing itself.
// THE DECLARED ORDER IS LABELS, NOT REFERENCES. The ^arrow_signature_order_edge's atoms name the
// domain's binders (v2.std.arrow_signature signature_order_edge); walking them
// under scope_body would resolve each against a parameter or, spelled like a free name, against the
// enclosing scope, and a minted anonymous label against nothing. It is carried unwalked; the Arrow
// wall (v2.std.node arrow_signature_order_conforms) is its check.
//
// THE FRAME'S KIND IS DECIDED HERE, ONCE. An Arrow reached while the walk still stands at a declaring
// path (DeclaringAt) is the declaration there -- the path v2.compiler.symbol_index_fill indexes its
// parameters under -- so its value frame is a ParameterFrame over that path. Nothing below an Arrow
// is containment: its body, codomain and domain walk NotDeclaring, so an Arrow met there (a lambda)
// opens a LexicalFrame.
// THE DECLARED PERMITTED-CALLERS CLAUSE IS CARRIED UNWALKED, like the declared order below it:
// its target is the clause's preserved spelling, evidence about the source rather than value
// content, and walking it would resolve the list's decl_ref constructor as a reference. Its
// reader is the caller-admission consumer (v2.compiler.infer infer_caller_admission_diags) and
// its structural check is the Arrow wall's at-most-once guard
// (v2.std.node arrow_signature_edges_conform).
fn resolve_arrow_node_in(outer_ctx: ResolveContext, ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  match gate_value_binders(names: arrow_domain_binder_name_list(n: n), outer: ctx.scope, at: n) {
    BinderGateRefused { diagnostic: d } => resolve_walk_refused_one(chain: diagnostics_singleton(d: d))
    BinderGateAdmitted => resolve_arrow_node_admitted(outer_ctx: outer_ctx, ctx: ctx, n: n)
  }
}

fn resolve_arrow_node_admitted(outer_ctx: ResolveContext, ctx: ResolveContext, n: Node) -> ResolveNodeWalk {
  let scope_type = resolve_type_param_frame(n: n, outer: ctx.scope)
  let value_params = arrow_domain_frame_binders(n: n)
  let frame_kind = match ctx.declaring {
    DeclaringAt { path: path } => ParameterFrame { arrow_path: path }
    DeclaringInSpine { path: _, body: _ } => LexicalFrame { binders: value_params.binders }
    NotDeclaring => LexicalFrame { binders: value_params.binders }
  }
  let scope_codomain = ScopeFrame { locals: value_params.locals, outer: scope_type, kind: frame_kind }
  let scope_body = ScopeFrame { locals: value_params.locals, outer: ctx.scope, kind: frame_kind }
  let inner_ctx = resolve_ctx_leaving_containment(ctx: ctx)
  child_walk_node(n: n, w: fold(n.children, init: child_walk_init(), f: fn(acc, e) {
    match e.label {
      StructuralLabel { label: _ } =>
        if edge_is_type_params(e: e) {
          child_walk_step(w: acc, e: e, r: resolve_type_params_conj(ctx: outer_ctx, conj: e.target))
        } else if edge_is_core(e: e, marker: ArrowSignatureOrderEdge) {
          child_walk_step(w: acc, e: e, r: ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] })
        } else if edge_is_core(e: e, marker: ArrowResourceRequirementsEdge) {
          child_walk_step(w: acc, e: e, r: resolve_arrow_resource_requirements(ctx: resolve_ctx_with_scope(ctx: inner_ctx, scope: scope_type), requirements: e.target))
        } else if arrow_named_edge_is_metadata(e: e) {
          child_walk_step(w: acc, e: e, r: ResolveWalkAccepted { value: e.target, diagnostics: None, lexical: [] })
        } else {
          child_walk_step(
            w: acc,
            e: e,
            r: resolve_arrow_body_or_named_edge(
              ctx: resolve_ctx_with_scope(ctx: inner_ctx, scope: scope_body),
              arrow: n,
              e: e
            )
          )
        }
      Authored { name: _ } =>
        child_walk_step(
          w: acc,
          e: e,
          r: resolve_node_walk(ctx: resolve_ctx_with_scope(ctx: ctx, scope: scope_body), n: e.target)
        )
      Positional =>
        if acc.ordinal == 0 {
          child_walk_step(
            w: acc,
            e: e,
            r: resolve_arrow_domain_walk(
              type_ctx: resolve_ctx_with_scope(ctx: inner_ctx, scope: scope_type),
              default_ctx: inner_ctx,
              domain: e.target
            )
          )
        } else {
          child_walk_step(
            w: acc,
            e: e,
            r: resolve_node_walk(ctx: resolve_ctx_with_scope(ctx: inner_ctx, scope: scope_codomain), n: e.target)
          )
        }
    }
  }))
}

// AN ARROW'S DOMAIN: each binder's TYPE resolves in the Arrow's type-parameter frame (type_ctx), as the
// whole domain did; each binder's DEFAULT (v2.std.node_query binder_node_parts) resolves in the
// ENCLOSING value scope (default_ctx: the Arrow's own context, before its parameters), with the
// type-parameter frame only as its type_scope. So a default sees an outer value, never a sibling
// parameter, and a type parameter's spelling is not a value it can bind (XL-2 PR2c-ii, side-chat review
// on #12948). A domain member that is not a binder node walks in type_ctx exactly as before.
fn resolve_arrow_domain_walk(type_ctx: ResolveContext, default_ctx: ResolveContext, domain: Node) -> ResolveNodeWalk {
  match domain.kind {
    TypeNode { connective: Conj } =>
      child_walk_node(n: domain, w: fold(domain.children, init: child_walk_init(), f: fn(acc, e) {
        child_walk_step(w: acc, e: e, r: resolve_arrow_domain_member(type_ctx: type_ctx, default_ctx: default_ctx, member: e.target))
      }))
    _ => resolve_node_walk(ctx: type_ctx, n: domain)
  }
}

fn resolve_arrow_domain_member(type_ctx: ResolveContext, default_ctx: ResolveContext, member: Node) -> ResolveNodeWalk {
  match binder_node_parts(n: member) {
    Absent => resolve_node_walk(ctx: type_ctx, n: member)
    Present { value: _ } =>
      child_walk_node(n: member, w: fold(member.children, init: child_walk_init(), f: fn(acc, be) {
        child_walk_step(w: acc, e: be, r: resolve_binder_part(type_ctx: type_ctx, default_ctx: default_ctx, part: be))
      }))
  }
}

fn resolve_binder_part(type_ctx: ResolveContext, default_ctx: ResolveContext, part: Edge) -> ResolveNodeWalk {
  if edge_is_core(e: part, marker: BinderDefaultEdge) {
    resolve_node_walk(ctx: default_ctx, n: part.target)
  } else {
    resolve_node_walk(ctx: type_ctx, n: part.target)
  }
}

// AN ARROW'S CONTRACT EDGES ARE NOT VALUES (v2.std.node arrow_named_edge_is_contract). The effect-claims
// and execution-mode edges hold self-named atoms of a closed vocabulary that v2.std.arrow_contract has
// already checked; they are carried unwalked, like the declared order. The resource-requirements edge
// alone holds REFERENCES (`requires Network`), so it is walked -- in the Arrow's type scope, which sees
// its type parameters and not its value parameters, because a requirement is a fact about the
// operation, never about an argument -- and each member must then name a declared resource
// (v2.std.symbol_index symbol_index_declares_resource_at, marked from the normalize-captured
// resource declarations), at most once by resolved declaration. A member naming anything else, or a
// declaration a second spelling already named, refuses at that member.
fn resolve_arrow_resource_requirements(ctx: ResolveContext, requirements: Node) -> ResolveNodeWalk {
  match requirements.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      ResolveWalkAccepted { value: requirements, diagnostics: None, lexical: [] }
    _ => resolve_arrow_resource_requirement_members(ctx: ctx, requirements: requirements)
  }
}

// `requires none` and `requires opaque` are declared words, not references, so the Atom forms are
// carried unwalked (v2.std.arrow_contract has already checked their identity); only the member Conj
// names declarations.
fn resolve_arrow_resource_requirement_members(ctx: ResolveContext, requirements: Node) -> ResolveNodeWalk {
  match resolve_node_walk(ctx: ctx, n: requirements) {
    ResolveWalkRefused { first: f, rest: rs, observation: o } => ResolveWalkRefused { first: f, rest: rs, observation: o }
    ResolveWalkAccepted { value: resolved, diagnostics: d, lexical: l } =>
      match resolve_requirement_member_refusal_optional(index: ctx.namespace.symbol_index, members: resolved.children) {
        Present { value: refusal } => resolve_walk_refused_one(chain: diagnostics_singleton(d: refusal))
        Absent => ResolveWalkAccepted { value: resolved, diagnostics: d, lexical: l }
      }
  }
}

type ResolveRequirementScan {
  seen: List<QualifiedName>
  refusal: Optional<Diagnostic>
}

// THE REQUIREMENT DECISION, over the resolved members and the index alone: it reads nothing else of the
// resolution context, so it takes nothing else, and its refusals can be exercised at this interface
// with supplied members (v2.test.claim.normalize.operation_requires_edge) while the full route stays
// exercised by that module's resolving claims.
fn resolve_requirement_member_refusal_optional(index: SymbolIndex, members: List<Edge>) -> Optional<Diagnostic> {
  fold(members, init: ResolveRequirementScan { seen: Empty, refusal: optional_absent() }, f: fn(acc, e) {
    match acc.refusal {
      Present { value: _ } => acc
      Absent =>
        match declaration_reference_path_optional(node: e.target) {
          Absent => ResolveRequirementScan { seen: acc.seen, refusal: optional_present(value: resolve_requirement_diagnostic(reason: ^resolve_reason_requirement_not_a_resource, n: e.target)) }
          Present { value: path } =>
            if !symbol_index_declares_resource_at(index: index, qualified_path: path) {
              ResolveRequirementScan { seen: acc.seen, refusal: optional_present(value: resolve_requirement_diagnostic(reason: ^resolve_reason_requirement_not_a_resource, n: e.target)) }
            } else if fold(acc.seen, init: false, f: fn(found, p) { found || (p == path) }) {
              ResolveRequirementScan { seen: acc.seen, refusal: optional_present(value: resolve_requirement_diagnostic(reason: ^resolve_reason_requirement_repeated, n: e.target)) }
            } else {
              ResolveRequirementScan { seen: list_snoc_item(xs: acc.seen, item: path), refusal: optional_absent() }
            }
        }
    }
  }).refusal
}

fn resolve_requirement_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn resolve_bind_binder_target(t: Node) -> ResolveNodeWalk {
  match t.kind {
    TypeNode { connective: Atom { identity: id } } =>
      ResolveWalkAccepted { value: canonical_atom(identity: id, occurrence_id: t.occurrence_id), diagnostics: None, lexical: [] }
    _ =>
      resolve_walk_refused_one(chain: diagnostics_singleton(d: malformed_tree_diagnostic(n: t)))
  }
}

// ORDINAL 0 IS THE BINDER, AND IT PRODUCES THE INNER SCOPE. Ordinal 1 resolves under the outer
// scope, which the binder does not touch, so it is observed whatever the binder did. Ordinal 2 and
// beyond resolve under the scope the binder produced; when the binder was refused that scope would
// be invented, so those sites are recorded ObservationIncomplete and NOT resolved. The ordinal is a
// POSITIONAL slot: resolve_bind_edges hands this walker the positionals only.
fn resolve_bind_positional_edges(
  ctx: ResolveContext,
  edges: List<Edge>,
  scope_outer: Scope,
  scope_inner: Scope
) -> ChildWalk {
  fold(edges, init: child_walk_init(), f: fn(acc, e) {
    if acc.ordinal == 0 {
      child_walk_step_prerequisite(w: acc, e: e, r: resolve_bind_binder_target(t: e.target))
    } else if acc.ordinal == 1 {
      child_walk_step(
        w: acc,
        e: e,
        r: resolve_node_walk(ctx: resolve_ctx_with_scope(ctx: ctx, scope: scope_outer), n: e.target)
      )
    } else if acc.scope_prerequisite_refused {
      child_walk_unobservable(w: acc, reason: ^resolve_observation_bind_scope_prerequisite_refused)
    } else {
      child_walk_step(
        w: acc,
        e: e,
        r: resolve_node_walk(ctx: resolve_ctx_with_scope(ctx: ctx, scope: scope_inner), n: e.target)
      )
    }
  })
}

// A BIND'S SLOTS ARE ITS POSITIONAL EDGES, NEVER ITS EDGE ORDINALS. The <type-annotation> edge
// (v2.std.type_binder) may stand anywhere among a producer's children -- content_hash canonicalizes
// it last, but resolve walks the tree as produced -- so counting it would shift the value into the
// binder's inner scope and admit an initializer that names its own binder. The positionals are
// walked first under their slot rules; the annotation after, in the type-role frame.
fn resolve_bind_edges(
  ctx: ResolveContext,
  edges: List<Edge>,
  scope_outer: Scope,
  scope_inner: Scope
) -> ChildWalk {
  fold(
    named_edges(children: edges),
    init: resolve_bind_positional_edges(
      ctx: ctx,
      edges: positional_edges(children: edges),
      scope_outer: scope_outer,
      scope_inner: scope_inner
    ),
    f: fn(acc, e) {
      if edge_is_type_annotation(e: e) {
        child_walk_step(w: acc, e: e, r: resolve_type_role_target(ctx: ctx, target: e.target))
      } else {
        child_walk_step(
          w: acc,
          e: e,
          r: resolve_node_walk(ctx: resolve_ctx_with_scope(ctx: ctx, scope: scope_outer), n: e.target)
        )
      }
    }
  )
}

// A Bind carrying MatchArmScopeExitEdge is admitted only as a match arm's body
// (resolve_match_arm_admitted); reached anywhere else its scope claim has no arm to exit, so it is a
// malformed tree rather than an ordinary let.
fn resolve_bind_node(
  ctx: ResolveContext,
  n: Node
) -> ResolveNodeWalk {
  if bind_carries_arm_scope_exit(n: n) {
    resolve_walk_refused_one(chain: diagnostics_singleton(d: malformed_tree_diagnostic(n: n)))
  } else if positional_child_count(children: n.children) == 3 {
    match gate_value_binders(names: bind_binder_name_list(n: n), outer: ctx.scope, at: n) {
      BinderGateRefused { diagnostic: d } => resolve_walk_refused_one(chain: diagnostics_singleton(d: d))
      BinderGateAdmitted =>
        child_walk_node(n: n, w: resolve_bind_edges(
          ctx: ctx,
          edges: n.children,
          scope_outer: ctx.scope,
          scope_inner: lexical_frame(fb: bind_frame_binders(n: n), outer: ctx.scope)
        ))
    }
  } else {
    resolve_walk_refused_one(chain: diagnostics_singleton(d: malformed_tree_diagnostic(n: n)))
  }
}

fn resolve(tree: NormalizedTree, lm: LanguageModel) -> Outcome<ResolvedTree> {
  resolve_with_namespace(
    tree: tree,
    namespace: build_program_namespace(tree: tree, lm: lm),
    lm: lm
  )
}

fn resolve_with_namespace(
  tree: NormalizedTree,
  namespace: Namespace,
  lm: LanguageModel
) -> Outcome<ResolvedTree> {
  resolve_with_namespace_policy(
    tree: tree,
    namespace: namespace,
    lm: lm,
    policy: default_name_resolution_policy()
  )
}

fn resolve_with_namespace_policy(
  tree: NormalizedTree,
  namespace: Namespace,
  lm: LanguageModel,
  policy: NameResolutionPolicy
) -> Outcome<ResolvedTree> {
  match member_kind_channel_of_tree(tree: tree) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: channel, diagnostics: _ } =>
      resolved_tree_outcome(
    w: resolve_walk_with_namespace_policy(
      tree: tree,
      namespace: namespace,
      lm: lm,
      policy: policy
    ),
    symbol_index: namespace.symbol_index,
    closure_declarations: empty_symbol_index(),
    unavailable_providers: [],
    member_kinds: channel
  )
  }
}

fn resolve_walk_with_namespace_policy(
  tree: NormalizedTree,
  namespace: Namespace,
  lm: LanguageModel,
  policy: NameResolutionPolicy
) -> ResolveNodeWalk {
  if well_formed(n: tree.root) && type_binder_labels_conform(root: tree.root) {
    resolve_node_walk(
      ctx: resolve_ctx_init(namespace: namespace, lm: lm, policy: policy),
      n: tree.root
    )
  } else {
    resolve_walk_refused_one(chain: diagnostics_singleton(d: malformed_tree_diagnostic(
      n: if well_formed(n: tree.root) {
        match type_binder_first_mislabelled(root: tree.root) {
          Present { value: at } => at
          Absent => tree.root
        }
      } else {
        tree.root
      }
    )))
  }
}
