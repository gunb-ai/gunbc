module v2.compiler.resolve


type ResolvedTree = v2.std.node.Node

type Namespace {
  bindings: Map<v2.std.node.Symbol, v2.std.node.Symbol>
  canonical_symbols: std.algebra.PointwisePower<v2.std.node.Symbol>
  symbol_index: v2.std.symbol_index.SymbolIndex
  module_qn: v2.std.qualified_name.QualifiedName
}

type Scope
  = ScopeRoot { module: Namespace }
  | ScopeFrame { locals: Map<v2.std.node.Symbol, v2.std.node.Symbol>, outer: Scope }

type ResolveContext {
  scope: Scope
  namespace: Namespace
  policy: v2.std.resolution_policy.NameResolutionPolicy
  position: v2.std.qualified_name.QualifiedName
  lm: v2.std.language_model.LanguageModel
  under_module_root: Bool
}

type EdgeResolveAcc
  = EdgeResolveAccMk { have_seen_first: Bool, acc: v2.std.diagnostic.Outcome<List<v2.std.node.Edge>> }

type BindEdgeAcc
  = BindEdgeAccMk { idx: Int, acc: v2.std.diagnostic.Outcome<List<v2.std.node.Edge>> }

type DeclaredBinding {
  name: v2.std.node.Symbol
}

fn empty_edge_list() -> List<v2.std.node.Edge> {
  []
}

fn empty_namespace() -> Namespace {
  Namespace {
    bindings: v2.std.collection.empty_map(),
    canonical_symbols: empty_canonical_symbol_set(),
    symbol_index: v2.std.symbol_index.empty_symbol_index(),
    module_qn: std.algebra.Empty
  }
}

fn empty_canonical_symbol_set() -> std.algebra.PointwisePower<v2.std.node.Symbol> {
  std.algebra.PointwisePower {
    member: fn(_) {
      false
    }
  }
}

fn try_edge_declared_binding(e: v2.std.node.Edge) -> DeclaredBinding? {
  match e.label {
    v2.std.node.Named { name: sym } => v2.std.optional.optional_present(value: DeclaredBinding { name: sym })
    v2.std.node.Positional => v2.std.optional.optional_absent()
  }
}

fn direct_atom_binding_fold(base: Map<v2.std.node.Symbol, v2.std.node.Symbol>) -> v2.std.node.NodeFold<Map<v2.std.node.Symbol, v2.std.node.Symbol>> {
  v2.std.node.NodeFold {
    init: fn(n0) {
      match n0.kind {
        v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } } =>
          v2.std.collection.map_insert(base, sym, sym)
        _ => base
      }
    },
    step: fn(acc, _, _) {
      acc
    }
  }
}

fn harvest_conj_named_bindings(root: v2.std.node.Node, acc: Map<v2.std.node.Symbol, v2.std.node.Symbol>) -> Map<v2.std.node.Symbol, v2.std.node.Symbol> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(root.children, init: acc, f: fn(a, e) {
        match try_edge_declared_binding(e: e) {
          v2.std.optional.Present { value: b } => v2.std.collection.map_insert(a, b.name, b.name)
          v2.std.optional.Absent => a
        }
      })
    _ => acc
  }
}

fn harvest_direct_atom_binding(root: v2.std.node.Node, acc: Map<v2.std.node.Symbol, v2.std.node.Symbol>) -> Map<v2.std.node.Symbol, v2.std.node.Symbol> {
  v2.std.node.fold_node(
    n: root,
    algebra: direct_atom_binding_fold(base: acc)
  )
}

data resolve_variant_visibility_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.compiler.symbol_index_fill",
    decl_name: "symbol_index_fill_unique_variant_aliases",
    field: std.decl_ref.WholeDeclaration
  }
}

fn namespace_bindings_augment_from_module_atoms(
  root: v2.std.node.Node,
  bindings: Map<v2.std.node.Symbol, v2.std.node.Symbol>
) -> Map<v2.std.node.Symbol, v2.std.node.Symbol> {
  harvest_conj_named_bindings(root: root, acc: bindings)
}

fn add_arrow_domain_named_params(n: v2.std.node.Node, acc: Map<v2.std.node.Symbol, v2.std.node.Symbol>) -> Map<v2.std.node.Symbol, v2.std.node.Symbol> {
  match n.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
      if count(n.children) >= 1 {
        match first(n.children) {
          v2.std.optional.Present { value: e0 } =>
            harvest_direct_atom_binding(
              root: e0.target,
              acc: harvest_conj_named_bindings(root: e0.target, acc: acc)
            )
          v2.std.optional.Absent => acc
        }
      } else {
        acc
      }
    _ => acc
  }
}

fn add_bind_atom_binder(n: v2.std.node.Node, acc: Map<v2.std.node.Symbol, v2.std.node.Symbol>) -> Map<v2.std.node.Symbol, v2.std.node.Symbol> {
  match n.kind {
    v2.std.node.ComputationNode { behavior: v2.std.node.Bind } =>
      if count(n.children) == 3 {
        match first(n.children) {
          v2.std.optional.Present { value: e0 } =>
            harvest_direct_atom_binding(root: e0.target, acc: acc)
          v2.std.optional.Absent => acc
        }
      } else {
        acc
      }
    _ => acc
  }
}

fn build_program_namespace(tree: v2.compiler.normalized_tree.NormalizedTree, lm: v2.std.language_model.LanguageModel) -> Namespace {
  Namespace {
    bindings: namespace_bindings_augment_from_module_atoms(
      root: tree.root,
      bindings: v2.std.collection.empty_map()
    ),
    canonical_symbols: v2.extdeps.languages.dag.dag_language_model_canonical_symbols(lm: lm),
    symbol_index: v2.std.symbol_index.empty_symbol_index(),
    module_qn: std.algebra.Empty
  }
}

fn scope_from_namespace(namespace: Namespace) -> Scope {
  ScopeRoot { module: namespace }
}

fn scope_root_module(s: Scope) -> Namespace {
  match s {
    ScopeFrame { outer: o, locals: _ } => scope_root_module(s: o)
    ScopeRoot { module: m } => m
  }
}

fn resolve_ctx_init(
  namespace: Namespace,
  lm: v2.std.language_model.LanguageModel,
  policy: v2.std.resolution_policy.NameResolutionPolicy
) -> ResolveContext {
  ResolveContext {
    scope: scope_from_namespace(namespace: namespace),
    namespace: namespace,
    policy: policy,
    position: namespace.module_qn,
    lm: lm,
    under_module_root: false
  }
}

fn resolve_ctx_with_scope(ctx: ResolveContext, scope: Scope) -> ResolveContext {
  ResolveContext {
    scope: scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: ctx.position,
    lm: ctx.lm,
    under_module_root: ctx.under_module_root
  }
}

fn resolve_ctx_snoc_position(ctx: ResolveContext, segment: v2.std.node.Symbol) -> ResolveContext {
  ResolveContext {
    scope: ctx.scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: v2.std.qualified_name.qualified_name_snoc(qn: ctx.position, segment: segment),
    lm: ctx.lm,
    under_module_root: ctx.under_module_root
  }
}

fn resolve_ctx_with_under_module_root(ctx: ResolveContext, under_module_root: Bool) -> ResolveContext {
  ResolveContext {
    scope: ctx.scope,
    namespace: ctx.namespace,
    policy: ctx.policy,
    position: ctx.position,
    lm: ctx.lm,
    under_module_root: under_module_root
  }
}

fn lookup_chain(s: Scope, name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol?> {
  match s {
    ScopeFrame { locals: m, outer: o } =>
      match v2.std.collection.map_get(m, name) {
        v2.std.diagnostic.Accepted { value: opt, diagnostics: d_here } => match opt {
          v2.std.optional.Present { value: v } =>
            v2.std.diagnostic.Accepted { value: v2.std.optional.optional_present(value: v), diagnostics: d_here }
          v2.std.optional.Absent =>
            match lookup_chain(s: o, name: name) {
              v2.std.diagnostic.Accepted { value: found, diagnostics: d_outer } =>
                v2.std.diagnostic.Accepted {
                  value: found,
                  diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d_here, inner: d_outer)
                }
              Rejected { diagnostics: ds } =>
                Rejected {
                  diagnostics: v2.std.diagnostic.rejected_with_pending(pending: d_here, rejected: ds)
                }
            }
        }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    ScopeRoot { module: mod } =>
      match v2.std.collection.map_get(mod.bindings, name) {
        v2.std.diagnostic.Accepted { value: opt, diagnostics: d } => match opt {
          v2.std.optional.Present { value: v } => v2.std.diagnostic.Accepted { value: v2.std.optional.optional_present(value: v), diagnostics: d }
          v2.std.optional.Absent => v2.std.diagnostic.Accepted { value: v2.std.optional.optional_absent(), diagnostics: d }
        }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
  }
}

fn malformed_tree_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^resolve_reason_malformed_tree,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn unbound_symbol_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^resolve_reason_unbound_symbol,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn ambiguous_symbol_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^resolve_reason_ambiguous_symbol,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn namespace_has_canonical_symbol(namespace: Namespace, name: v2.std.node.Symbol) -> Bool {
  namespace.canonical_symbols.member(name)
}

fn canonical_atom(identity: v2.std.node.Symbol, occurrence_id: v2.std.node.NodeOccurrenceId) -> v2.std.node.Node {
  v2.std.node.node_with_occurrence_id(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: identity } },
    children: [],
    occurrence_id: occurrence_id
  )
}

fn symbol_index_lookup_position(ctx: ResolveContext) -> v2.std.qualified_name.QualifiedName {
  match ctx.policy {
    v2.std.resolution_policy.NamespaceOnlyY => ctx.position
    v2.std.resolution_policy.ImportScoped => ctx.namespace.module_qn
  }
}

fn symbol_index_node_identity(node: v2.std.node.Node, fallback: v2.std.node.Symbol) -> v2.std.node.Symbol {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } } => sym
    _ => fallback
  }
}

type SymbolIndexAtomLookup
  = SymbolIndexAtomHit { canonical: v2.std.node.Symbol }
  | SymbolIndexAtomAmbiguous
  | SymbolIndexAtomUnbound

fn lookup_symbol_index_atom_identity(
  ctx: ResolveContext,
  name: v2.std.node.Symbol
) -> SymbolIndexAtomLookup {
  match v2.std.symbol_index.symbol_index_lexical_lookup(
    index: ctx.namespace.symbol_index,
    position: symbol_index_lookup_position(ctx: ctx),
    name: name
  ) {
    v2.std.symbol_index.LexicalHit { node: node, path: _ } =>
      SymbolIndexAtomHit {
        canonical: symbol_index_node_identity(node: node, fallback: name)
      }
    v2.std.symbol_index.LexicalAmbiguous { candidates: _ } => SymbolIndexAtomAmbiguous
    v2.std.symbol_index.LexicalUnbound =>
      match ctx.policy {
        v2.std.resolution_policy.NamespaceOnlyY =>
          match v2.std.symbol_index.symbol_index_global_unique_lookup(
            index: ctx.namespace.symbol_index,
            name: name
          ) {
            v2.std.symbol_index.GlobalBareHit { node } =>
              SymbolIndexAtomHit {
                canonical: symbol_index_node_identity(node: node, fallback: name)
              }
            v2.std.symbol_index.GlobalBareLookupAmbiguous => SymbolIndexAtomAmbiguous
            v2.std.symbol_index.GlobalBareLookupUnbound => SymbolIndexAtomUnbound
          }
        v2.std.resolution_policy.ImportScoped => SymbolIndexAtomUnbound
      }
  }
}

// feature:indexed-variant-path-projectable acceptance condition at the producer seam, required for conformance with docs/plans/namespace-resolution-design.md section 13 unique-on-chain: resolve the reference's FIRST segment to the unique binder on its ancestor chain, then project every remaining segment downward through the containment tree. try_resolve_qualified_name_node must therefore accept an authored Type.Variant path by projecting it from the referencing position onto the type-to-variant containment path that symbol_index_fill_containment_node already indexes. The feature is UNFIRED while this function sends the authored path directly to symbol_index_lookup as though every dotted path were corpus-root absolute: UpdateVersionPersistence.Persistent therefore refuses even though the full module.UpdateVersionPersistence.Persistent path is indexed. It fires only when an executing positive control resolves the type-relative path to that exact indexed variant; zero binders produces a located unresolved refusal; two or more binders produces a located Ambiguous refusal carrying the full candidate list rather than picking; and shadowing refuses rather than silently rebinding. This belongs to the namespace-only-resolution lane's producer-side changeover, not to a consumer workaround or a new syntax preference.
fn try_resolve_qualified_name_node(ctx: ResolveContext, n: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.diagnostic.Outcome<v2.std.node.Node>> {
  match v2.std.qualified_name.qualified_name_from_node(root: n) {
    Rejected { diagnostics: _ } => v2.std.optional.optional_absent()
    v2.std.diagnostic.Accepted { value: path, diagnostics: pending } =>
      if v2.std.algebra.length(xs: path) > 1 {
        match v2.std.symbol_index.symbol_index_lookup(index: ctx.namespace.symbol_index, qualified_path: path) {
          v2.std.optional.Present { value: resolved_node } =>
            v2.std.optional.optional_present(
              value: v2.std.diagnostic.Accepted {
                value: canonical_atom(
                  identity: symbol_index_node_identity(
                    node: resolved_node,
                    fallback: ^resolve_reason_unbound_symbol
                  ),
                  occurrence_id: n.occurrence_id
                ),
                diagnostics: pending
              }
            )
          v2.std.optional.Absent =>
            v2.std.optional.optional_present(
              value: Rejected {
                diagnostics: v2.std.diagnostic.rejected_with_pending(
                  pending: pending,
                  rejected: v2.std.diagnostic.diagnostics_singleton(d: unbound_symbol_diagnostic(n: n))
                )
              }
            )
        }
      } else {
        v2.std.optional.optional_absent()
      }
  }
}

fn resolve_atom(ctx: ResolveContext, n: v2.std.node.Node, identity: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: n) {
    v2.std.diagnostic.Accepted { value: n, diagnostics: v2.std.diagnostic.None }
  } else {
    match lookup_chain(s: ctx.scope, name: identity) {
      v2.std.diagnostic.Accepted { value: found, diagnostics: pending } => match found {
        v2.std.optional.Present { value: canonical } =>
          v2.std.diagnostic.Accepted {
            value: canonical_atom(identity: canonical, occurrence_id: n.occurrence_id),
            diagnostics: pending
          }
        v2.std.optional.Absent =>
          match lookup_symbol_index_atom_identity(ctx: ctx, name: identity) {
            SymbolIndexAtomHit { canonical: canonical } =>
              v2.std.diagnostic.Accepted {
                value: canonical_atom(identity: canonical, occurrence_id: n.occurrence_id),
                diagnostics: pending
              }
            SymbolIndexAtomAmbiguous =>
              Rejected {
                diagnostics: v2.std.diagnostic.rejected_with_pending(
                  pending: pending,
                  rejected: v2.std.diagnostic.diagnostics_singleton(d: ambiguous_symbol_diagnostic(n: n))
                )
              }
            SymbolIndexAtomUnbound =>
              if namespace_has_canonical_symbol(
                namespace: ctx.namespace,
                name: identity
              ) {
                v2.std.diagnostic.Accepted {
                  value: canonical_atom(identity: identity, occurrence_id: n.occurrence_id),
                  diagnostics: pending
                }
              } else {
                Rejected {
                  diagnostics: v2.std.diagnostic.rejected_with_pending(
                    pending: pending,
                    rejected: v2.std.diagnostic.diagnostics_singleton(d: unbound_symbol_diagnostic(n: n))
                  )
                }
              }
          }
      }
      Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
    }
  }
}

fn resolve_surface_operator_atom(
  ctx: ResolveContext,
  n: v2.std.node.Node,
  identity: v2.std.node.Symbol
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.extdeps.languages.dag.dag_surface_operator_canonicalization_lookup(lm: ctx.lm, surface_token: identity) {
    v2.std.diagnostic.Accepted { value: canonical_op, diagnostics: pending } => {
      let wire = v2.std.compilers.target_model.target_model_canonical_operation_wire_node(operation: canonical_op)
      v2.std.diagnostic.Accepted {
        value: v2.std.node.node_with_occurrence_id(
          kind: wire.kind,
          children: wire.children,
          occurrence_id: n.occurrence_id
        ),
        diagnostics: pending
      }
    }
    Rejected { diagnostics: _ } =>
      resolve_atom(ctx: ctx, n: n, identity: identity)
  }
}

fn resolve_transform_operator_child(
  ctx: ResolveContext,
  n: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match n.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      resolve_surface_operator_atom(ctx: ctx, n: n, identity: id)
    _ => resolve_node(ctx: ctx, n: n)
  }
}

fn resolve_transform_children(
  ctx: ResolveContext,
  n: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match fold(n.children, init: v2.std.diagnostic.Accepted { value: empty_edge_list(), diagnostics: v2.std.diagnostic.None }, f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: r } =>
        Rejected { diagnostics: r }
      v2.std.diagnostic.Accepted { value: done, diagnostics: ad } =>
        match e.label {
          v2.std.node.Positional =>

            if v2.std.algebra.length(xs: done) == 0 {
              match resolve_transform_operator_child(
                ctx: ctx,
                n: e.target
              ) {
                Rejected { diagnostics: r } =>
                  Rejected {
                    diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                  }
                v2.std.diagnostic.Accepted { value: resolved_target, diagnostics: ed } =>
                  v2.std.diagnostic.Accepted {
                    value: v2.std.algebra.list_snoc_item(xs: done, item: v2.std.node.Edge {
                      label: e.label,
                      target: resolved_target
                    }),
                    diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
                  }
              }
            } else {
              match resolve_node(ctx: ctx, n: e.target) {
                Rejected { diagnostics: r } =>
                  Rejected {
                    diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                  }
                v2.std.diagnostic.Accepted { value: resolved_target, diagnostics: ed } =>
                  v2.std.diagnostic.Accepted {
                    value: v2.std.algebra.list_snoc_item(xs: done, item: v2.std.node.Edge {
                      label: e.label,
                      target: resolved_target
                    }),
                    diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
                  }
              }
            }
          _ =>
            match resolve_node(ctx: ctx, n: e.target) {
              Rejected { diagnostics: r } =>
                Rejected {
                  diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                }
              v2.std.diagnostic.Accepted { value: resolved_target, diagnostics: ed } =>
                v2.std.diagnostic.Accepted {
                  value: v2.std.algebra.list_snoc_item(xs: done, item: v2.std.node.Edge {
                    label: e.label,
                    target: resolved_target
                  }),
                  diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
                }
            }
        }
    }
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: resolved_children, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: v2.std.node.node_with_occurrence_id(kind: n.kind, children: resolved_children, occurrence_id: n.occurrence_id),
        diagnostics: d
      }
  }
}

fn resolve_node(
  ctx: ResolveContext,
  n: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match n.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      resolve_atom(ctx: ctx, n: n, identity: id)
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
      match resolve_edges_first_outer_then_inner(
        ctx: ctx,
        edges: n.children,
        scope_outer: ctx.scope,
        scope_inner: ScopeFrame {
          locals: add_arrow_domain_named_params(n: n, acc: v2.std.collection.empty_map()),
          outer: ctx.scope
        }
      ) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: resolved_children, diagnostics: d } =>
          v2.std.diagnostic.Accepted {
            value: v2.std.node.node_with_occurrence_id(kind: n.kind, children: resolved_children, occurrence_id: n.occurrence_id),
            diagnostics: d
          }
      }
    v2.std.node.ComputationNode { behavior: v2.std.node.Bind } =>
      resolve_bind_node(ctx: ctx, n: n)
    v2.std.node.ComputationNode { behavior: v2.std.node.Transform } =>
      resolve_transform_children(ctx: ctx, n: n)
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      match try_resolve_qualified_name_node(ctx: ctx, n: n) {
        v2.std.optional.Present { value: outcome } => outcome
        v2.std.optional.Absent => resolve_children_homogeneous_scope(ctx: ctx, n: n)
      }
    v2.std.node.TypeNode { connective: _ } =>
      resolve_children_homogeneous_scope(ctx: ctx, n: n)
    v2.std.node.ComputationNode { behavior: _ } =>
      resolve_children_homogeneous_scope(ctx: ctx, n: n)
  }
}

fn resolve_preserve_module_root_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> Bool {
  if v2.extdeps.languages.dag.dag_surface_module_header_metadata_edge(name: name) {
    true
  } else if v2.extdeps.languages.dag.dag_resolve_preserve_module_metadata_subtree(node: target) {
    true
  } else if name == ^grammar_production_identity_node_projection {
    true
  } else {
    false
  }
}

fn resolve_child_edge(
  ctx: ResolveContext,
  e: v2.std.node.Edge
) -> v2.std.diagnostic.Outcome<v2.std.node.Edge> {
  match e.label {
    v2.std.node.Named { name: sym } =>
      if ctx.under_module_root
        && resolve_preserve_module_root_named_edge(name: sym, target: e.target) {
        v2.std.diagnostic.Accepted { value: e, diagnostics: v2.std.diagnostic.None }
      } else {
        let child_ctx = if ctx.under_module_root
          && !v2.extdeps.languages.dag.dag_surface_module_header_metadata_edge(name: sym) {
          resolve_ctx_snoc_position(ctx: ctx, segment: sym)
        } else {
          ctx
        }
        match resolve_node(ctx: child_ctx, n: e.target) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          v2.std.diagnostic.Accepted { value: resolved_target, diagnostics: d } =>
            v2.std.diagnostic.Accepted {
              value: v2.std.node.Edge { label: e.label, target: resolved_target },
              diagnostics: d
            }
        }
      }
    v2.std.node.Positional =>
      if ctx.under_module_root
        && v2.extdeps.languages.dag.dag_resolve_preserve_module_metadata_subtree(node: e.target) {
        v2.std.diagnostic.Accepted { value: e, diagnostics: v2.std.diagnostic.None }
      } else {
        match resolve_node(ctx: ctx, n: e.target) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          v2.std.diagnostic.Accepted { value: resolved_target, diagnostics: d } =>
            v2.std.diagnostic.Accepted {
              value: v2.std.node.Edge { label: e.label, target: resolved_target },
              diagnostics: d
            }
        }
      }
  }
}

data arrow_domain_param_scoping_note: String = "Wave 1 Gate 1 A1: param scoping is add_arrow_domain_named_params over lowered Arrow domain Named edges (general-body-producer-design Stage A). dag_fn_decl_param_binding_atoms and scope_with_fn_decl_params dissolved. fn_decl ident now routes through StampLexeme and SymbolIndex fill carries module_qn.fn.param (parity proven by execution); domain construction remains interim param-list-walk (body_lower_domain_from_param_list) until domain is built from SymbolIndex lookup rather than walked from the param list."

fn domain_root_has_named_bindings(root: v2.std.node.Node) -> Bool {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(root.children, init: false, f: fn(acc, e) {
        if acc {
          acc
        } else {
          match try_edge_declared_binding(e: e) {
            v2.std.optional.Present { value: _ } => true
            v2.std.optional.Absent => false
          }
        }
      })
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: _ } } => true
    _ => false
  }
}

fn arrow_domain_has_named_bindings(n: v2.std.node.Node) -> Bool {
  match n.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
      if count(n.children) >= 1 {
        match first(n.children) {
          v2.std.optional.Present { value: e0 } => domain_root_has_named_bindings(root: e0.target)
          v2.std.optional.Absent => false
        }
      } else {
        false
      }
    _ => false
  }
}

fn resolve_children_homogeneous_scope(
  ctx: ResolveContext,
  n: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let at_module_root = ctx.under_module_root || v2.extdeps.languages.dag.dag_node_is_module_root_conj(n: n)
  let scope_here = match arrow_domain_has_named_bindings(n: n) {
    true =>
      ScopeFrame {
        locals: add_arrow_domain_named_params(n: n, acc: v2.std.collection.empty_map()),
        outer: ctx.scope
      }
    false => ctx.scope
  }
  let child_ctx = resolve_ctx_with_scope(
    ctx: resolve_ctx_with_under_module_root(ctx: ctx, under_module_root: at_module_root),
    scope: scope_here
  )
  match fold(n.children, init: v2.std.diagnostic.Accepted { value: empty_edge_list(), diagnostics: v2.std.diagnostic.None }, f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: r } =>
        Rejected { diagnostics: r }
      v2.std.diagnostic.Accepted { value: done, diagnostics: ad } =>
        match resolve_child_edge(ctx: child_ctx, e: e) {
          Rejected { diagnostics: r } =>
            Rejected {
              diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
            }
          v2.std.diagnostic.Accepted { value: resolved_edge, diagnostics: ed } =>
            v2.std.diagnostic.Accepted {
              value: v2.std.algebra.list_snoc_item(xs: done, item: resolved_edge),
              diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
            }
        }
    }
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: resolved_children, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: v2.std.node.node_with_occurrence_id(kind: n.kind, children: resolved_children, occurrence_id: n.occurrence_id),
        diagnostics: d
      }
  }
}

fn resolve_edges_first_outer_then_inner(
  ctx: ResolveContext,
  edges: List<v2.std.node.Edge>,
  scope_outer: Scope,
  scope_inner: Scope
) -> v2.std.diagnostic.Outcome<List<v2.std.node.Edge>> {
  match fold(
    edges,
    init: EdgeResolveAccMk {
      have_seen_first: false,
      acc: v2.std.diagnostic.Accepted { value: empty_edge_list(), diagnostics: v2.std.diagnostic.None }
    },
    f: fn(state, e) {
      match state {
        EdgeResolveAccMk { have_seen_first: seen, acc: acc_state } =>
          match acc_state {
            Rejected { diagnostics: r } =>
              EdgeResolveAccMk {
                have_seen_first: true,
                acc: Rejected { diagnostics: r }
              }
            v2.std.diagnostic.Accepted { value: done, diagnostics: ad } =>
              if seen {
                match resolve_node(
                  ctx: resolve_ctx_with_scope(ctx: ctx, scope: scope_inner),
                  n: e.target
                ) {
                  Rejected { diagnostics: r } =>
                    EdgeResolveAccMk {
                      have_seen_first: true,
                      acc: Rejected {
                        diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                      }
                    }
                  v2.std.diagnostic.Accepted { value: resolved_target, diagnostics: ed } =>
                    EdgeResolveAccMk {
                      have_seen_first: true,
                      acc: v2.std.diagnostic.Accepted {
                        value: v2.std.algebra.list_snoc_item(xs: done, item: v2.std.node.Edge {
                            label: e.label,
                            target: resolved_target
                          }),
                        diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
                      }
                    }
                }
              } else {
                match resolve_node(
                  ctx: resolve_ctx_with_scope(ctx: ctx, scope: scope_outer),
                  n: e.target
                ) {
                  Rejected { diagnostics: r } =>
                    EdgeResolveAccMk {
                      have_seen_first: true,
                      acc: Rejected {
                        diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                      }
                    }
                  v2.std.diagnostic.Accepted { value: resolved_target, diagnostics: ed } =>
                    EdgeResolveAccMk {
                      have_seen_first: true,
                      acc: v2.std.diagnostic.Accepted {
                        value: v2.std.algebra.list_snoc_item(xs: done, item: v2.std.node.Edge {
                            label: e.label,
                            target: resolved_target
                          }),
                        diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
                      }
                    }
                }
              }
          }
      }
    }
  ) {
    EdgeResolveAccMk { acc: acc_state, have_seen_first: _ } => acc_state
  }
}

fn resolve_bind_binder_target(t: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match t.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      v2.std.diagnostic.Accepted { value: canonical_atom(identity: id, occurrence_id: t.occurrence_id), diagnostics: v2.std.diagnostic.None }
    _ =>
      Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: malformed_tree_diagnostic(n: t)) }
  }
}

fn resolve_bind_edges(
  ctx: ResolveContext,
  edges: List<v2.std.node.Edge>,
  scope_outer: Scope,
  scope_inner: Scope
) -> v2.std.diagnostic.Outcome<List<v2.std.node.Edge>> {
  match fold(
    edges,
    init: BindEdgeAccMk {
      idx: 0,
      acc: v2.std.diagnostic.Accepted { value: empty_edge_list(), diagnostics: v2.std.diagnostic.None }
    },
    f: fn(state, e) {
      match state {
        BindEdgeAccMk { idx: i, acc: acc_state } =>
          match acc_state {
            Rejected { diagnostics: r } =>
              BindEdgeAccMk {
                idx: i + 1,
                acc: Rejected { diagnostics: r }
              }
            v2.std.diagnostic.Accepted { value: done, diagnostics: ad } =>
              if i == 0 {
                match resolve_bind_binder_target(t: e.target) {
                  Rejected { diagnostics: r } =>
                    BindEdgeAccMk {
                      idx: i + 1,
                      acc: Rejected {
                        diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                      }
                    }
                  v2.std.diagnostic.Accepted { value: rt, diagnostics: ed } =>
                    BindEdgeAccMk {
                      idx: i + 1,
                      acc: v2.std.diagnostic.Accepted {
                        value: v2.std.algebra.list_snoc_item(xs: done, item: v2.std.node.Edge {
                            label: e.label,
                            target: rt
                          }),
                        diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
                      }
                    }
                }
              } else {
                if i == 1 {
                  match resolve_node(
                    ctx: resolve_ctx_with_scope(ctx: ctx, scope: scope_outer),
                    n: e.target
                  ) {
                    Rejected { diagnostics: r } =>
                      BindEdgeAccMk {
                        idx: i + 1,
                        acc: Rejected {
                          diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                        }
                      }
                    v2.std.diagnostic.Accepted { value: rt, diagnostics: ed } =>
                      BindEdgeAccMk {
                        idx: i + 1,
                        acc: v2.std.diagnostic.Accepted {
                          value: v2.std.algebra.list_snoc_item(xs: done, item: v2.std.node.Edge {
                              label: e.label,
                              target: rt
                            }),
                          diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
                        }
                      }
                  }
                } else {
                  match resolve_node(
                    ctx: resolve_ctx_with_scope(ctx: ctx, scope: scope_inner),
                    n: e.target
                  ) {
                    Rejected { diagnostics: r } =>
                      BindEdgeAccMk {
                        idx: i + 1,
                        acc: Rejected {
                          diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                        }
                      }
                    v2.std.diagnostic.Accepted { value: rt, diagnostics: ed } =>
                      BindEdgeAccMk {
                        idx: i + 1,
                        acc: v2.std.diagnostic.Accepted {
                          value: v2.std.algebra.list_snoc_item(xs: done, item: v2.std.node.Edge {
                              label: e.label,
                              target: rt
                            }),
                          diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: ed)
                        }
                      }
                  }
                }
              }
          }
      }
    }
  ) {
    BindEdgeAccMk { acc: acc_state, idx: _ } => acc_state
  }
}

fn resolve_bind_node(
  ctx: ResolveContext,
  n: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if count(n.children) == 3 {
    match resolve_bind_edges(
      ctx: ctx,
      edges: n.children,
      scope_outer: ctx.scope,
      scope_inner: ScopeFrame {
        locals: add_bind_atom_binder(n: n, acc: v2.std.collection.empty_map()),
        outer: ctx.scope
      }
    ) {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      v2.std.diagnostic.Accepted { value: resolved_children, diagnostics: d } =>
        v2.std.diagnostic.Accepted {
          value: v2.std.node.node_with_occurrence_id(kind: n.kind, children: resolved_children, occurrence_id: n.occurrence_id),
          diagnostics: d
        }
    }
  } else {
    Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: malformed_tree_diagnostic(n: n)) }
  }
}

fn resolve(tree: v2.compiler.normalized_tree.NormalizedTree, lm: v2.std.language_model.LanguageModel) -> v2.std.diagnostic.Outcome<ResolvedTree> {
  resolve_with_namespace(
    tree: tree,
    namespace: build_program_namespace(tree: tree, lm: lm),
    lm: lm
  )
}

fn resolve_with_namespace(
  tree: v2.compiler.normalized_tree.NormalizedTree,
  namespace: Namespace,
  lm: v2.std.language_model.LanguageModel
) -> v2.std.diagnostic.Outcome<ResolvedTree> {
  resolve_with_namespace_policy(
    tree: tree,
    namespace: namespace,
    lm: lm,
    policy: v2.std.resolution_policy.default_name_resolution_policy()
  )
}

fn resolve_with_namespace_policy(
  tree: v2.compiler.normalized_tree.NormalizedTree,
  namespace: Namespace,
  lm: v2.std.language_model.LanguageModel,
  policy: v2.std.resolution_policy.NameResolutionPolicy
) -> v2.std.diagnostic.Outcome<ResolvedTree> {
  if v2.std.node.well_formed(n: tree.root) {
    resolve_node(
      ctx: resolve_ctx_init(namespace: namespace, lm: lm, policy: policy),
      n: tree.root
    )
  } else {
    Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: malformed_tree_diagnostic(n: tree.root)) }
  }
}
