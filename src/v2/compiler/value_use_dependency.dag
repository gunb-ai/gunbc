module v2.compiler.value_use_dependency

// WHAT A NAME USE WAITS ON. Authority: gunbc.plans.demand_engine_program section 2.4 (operator ruling
// 2026-10-18): a use of a let-bound name depends on that binding's VALUE, and on nothing else in the
// let's body; textual position creates no dependency. resolve already decided which binder answered
// each reference and recorded it in ResolvedTree.occurrence_bindings (v2.compiler.resolve
// OccurrenceBindingRecord); this module READS that record and turns its valued arm into a demand
// relation. It decides nothing about scope: no name lookup, no frame walk, no second scope table.
//
// BESIDE Contains, never instead of it. v2.std.dependency dependency_lens emits only parent->child
// Contains edges; the DataDependsOn rows here are derived BESIDE those edges (plan section 2.4), and
// nothing here re-orients, edits or consumes Contains. The production consumer is the named later
// change A4 (v2.program's run reads these rows and the hand-written program_run_dependencies row is
// deleted) — a declared frontier, not a gap in this module.
//
// THE SURFACE IS THREE THINGS: the types below, value_use_dispositions, and value_use_views
// (DESIGN section 3c: a production module is consumed for what a consumer reads). Everything else
// here is a step of the derivation, reached only from value_use_dispositions. Judgements a claim
// makes ABOUT the output — counting the populations, comparing two nodes, asking whether an edge
// crosses between two values — live in v2.test.claim.value_use_dependency, which is where they are
// consumed (DESIGN section 3).
//
// ONE DISPOSITION PER ENTRY, NEVER A SILENT SKIP (DESIGN section 5). The fold's domain is
// map_support_keys(tree.occurrence_bindings) — the records' own support — and every arm of
// value_use_dispose returns a population, so no key is dropped. The three lengths therefore sum to
// the domain's length, which is the totaliser a claim states over each fixture.
//
// COST IS FIXED IN SHAPE (DESIGN section 6). The tree is walked ONCE (value_use_reference_index) into
// a Map<OccurrenceId, Node>, and each record is disposed with two map lookups: O(N + K log N) for N
// nodes and K records, where the naive form — a subtree walk per key — is O(K x N) and quadratic once
// resolve records an entry per reference, which it does. A4's consumer is a whole-program run, so
// whole-corpus scale is the intended input, not a hypothetical.

import std.algebra { empty_map, fold_list, int_total_order, list_snoc_item, list_sort_by_key, map_insert, map_lookup, map_support_keys }
import std.occurrence_identity { OccurrenceId }
import std.optional { Absent, Optional, Present, optional_absent }
import std.types { Bool, List, Map }
import v2.std.dependency { DataDependsOn, DependencyView }
import v2.std.node { Node, node_subtree_nodes }
import v2.std.provenance { node_occurrence_id_optional }
import v2.std.qualified_name { declaration_reference_path_optional, lexical_reference_label_optional, parameter_reference_path_optional }
import v2.compiler.resolve {
  BoundAmbient,
  BoundByExpectedType,
  BoundByGeneratedReference,
  BoundByLexicalBinder,
  BoundToDeclaration,
  BoundToParameter,
  BoundToTypeParameter,
  LexicalBinderStanding,
  LexicalDeclared,
  LexicalOwedFormal,
  LexicalUntyped,
  LexicalValued,
  OccurrenceBinding,
  OccurrenceBindingRecord,
  ResolvedTree
}

// THE RELATIONS POPULATION — one DataDependsOn row per use whose binding is valued. source = the
// binding's VALUE node (what the use waits on); dependent = the reference occurrence's node;
// usage_site = that same reference occurrence, because a usage edge's site is where the use happens
// (DESIGN section 6), not the value's own position.
type ValueUseRelation {
  occurrence: OccurrenceId
  view: DependencyView
}

// WHY THERE IS NO RELATION FOR THIS OCCURRENCE, as a closed coproduct rather than a string. The
// standing is carried as resolve's OWN LexicalBinderStanding, so a consumer matches on the case
// instead of comparing text, and the one case this module adds — a valued binding whose use is not in
// the tree — is a declared variant, not a string that only this file knows about.
type NotDerivedReason
  = NotDerivedStanding { standing: LexicalBinderStanding }
  | ValuedUseNotLocated { value: Node }
  | RecordAbsent

// NOT DERIVED YET, NAMED. A lexical binder that is not a let's value carries no value node in its
// record — LexicalDeclared is a member-edge type, LexicalOwedFormal an unpaid match-payload formal,
// LexicalUntyped a binder with neither — so guessing a source would invent an edge the record does not
// carry.
type ValueUseNotDerived {
  occurrence: OccurrenceId
  reason: NotDerivedReason
}

// INPUT, NOT AN IN-BODY PRODUCER. A parameter, a type parameter, a corpus declaration, an ambient
// stopgap, an expected-type stopgap or a compiler-generated reference: the producer is not a value node
// in a lexical body, so there is no use->value edge here. The row carries resolve's OWN
// OccurrenceBinding, which already says which of the six it is — a string naming it would be a second
// representation of one fact (DESIGN section 3). Returned rather than dropped, so its absence from the
// relation list is a disposition and not a silent skip.
type ValueUseInput {
  occurrence: OccurrenceId
  binding: OccurrenceBinding
}

// THE ONE RESULT: the three populations and nothing else. Every entry of the input tree's
// occurrence_bindings is in exactly one of them.
type ValueUseDependencies {
  relations: List<ValueUseRelation>
  not_derived: List<ValueUseNotDerived>
  inputs: List<ValueUseInput>
}

// THE ONE TREE WALK: every reference node, indexed by the occurrence resolve keyed its record under.
// resolve mints each reference record keyed by that reference's OWN occurrence (v2.compiler.resolve
// resolved_reference_node / lexical_reference_node) and the reference node carries that id as its
// node.occurrence_id, so one pass over the subtree pairs the two — no second index enters the compiler
// and no key is disposed by searching the tree again.
fn value_use_reference_index(tree: ResolvedTree) -> Map<OccurrenceId, Node> {
  fold_list(
    xs: node_subtree_nodes(root: tree.root),
    empty: empty_map(),
    cons: fn(acc, n) {
      match value_use_reference_occurrence(node: n) {
        Present { value: id } => map_insert(m: acc, key: id, value: n)
        Absent => acc
      }
    }
  )
}

// THE OCCURRENCE THIS NODE IS RECORDED UNDER, if it is a use of a name at all. The three carriers a
// reference is recognised by (v2.std.qualified_name); a node that is none of them is not a use, so it
// enters the index not at all — which is why the binder atom of a `let` is not mistaken for a use.
fn value_use_reference_occurrence(node: Node) -> Optional<OccurrenceId> {
  if value_use_is_reference(node: node) {
    node_occurrence_id_optional(node: node)
  } else {
    optional_absent()
  }
}

fn value_use_is_reference(node: Node) -> Bool {
  match lexical_reference_label_optional(node: node) {
    Present { value: _ } => true
    Absent =>
      match parameter_reference_path_optional(node: node) {
        Present { value: _ } => true
        Absent => match declaration_reference_path_optional(node: node) {
          Present { value: _ } => true
          Absent => false
        }
      }
  }
}

// THE DISPOSITIONS, one per recorded occurrence binding, in occurrence order so the populations are
// reproducible. The domain is the map's own support, so a record cannot be missed; each arm of
// value_use_dispose_record returns a population, so none can be counted twice.
fn value_use_dispositions(tree: ResolvedTree) -> ValueUseDependencies {
  let index = value_use_reference_index(tree: tree)
  fold_list(
    xs: value_use_ordered_keys(tree: tree),
    empty: ValueUseDependencies { relations: [], not_derived: [], inputs: [] },
    cons: fn(acc, key) { value_use_dispose(acc: acc, tree: tree, index: index, key: key) }
  )
}

fn value_use_ordered_keys(tree: ResolvedTree) -> List<OccurrenceId> {
  list_sort_by_key(
    xs: map_support_keys(m: tree.occurrence_bindings),
    key: fn(id) { id.value },
    order: int_total_order()
  )
}

// A RECORD, IF THE SUPPORT HAS ONE FOR THIS KEY — the support is that map's own, so lookup is total
// here and the Absent arm exists to be honest, not to be taken: it reports a RecordAbsent row rather
// than dropping the key, so the totality claim has no hole in it.
fn value_use_dispose(
  acc: ValueUseDependencies,
  tree: ResolvedTree,
  index: Map<OccurrenceId, Node>,
  key: OccurrenceId
) -> ValueUseDependencies {
  match map_lookup(m: tree.occurrence_bindings, key: key) {
    Present { value: record } => value_use_dispose_record(acc: acc, index: index, key: key, record: record)
    Absent =>
      ValueUseDependencies {
        relations: acc.relations,
        not_derived: snoc_not_derived(
          acc.not_derived,
          ValueUseNotDerived { occurrence: key, reason: RecordAbsent }
        ),
        inputs: acc.inputs
      }
  }
}

// ONE RECORD, ONE POPULATION.
fn value_use_dispose_record(
  acc: ValueUseDependencies,
  index: Map<OccurrenceId, Node>,
  key: OccurrenceId,
  record: OccurrenceBindingRecord
) -> ValueUseDependencies {
  match record.binding {
    BoundByLexicalBinder { binding: lexical } =>
      match lexical.standing {
        LexicalValued { node: value } =>
          match map_lookup(m: index, key: key) {
            Present { value: use } =>
              ValueUseDependencies {
                relations: snoc_relation(
                  acc.relations,
                  ValueUseRelation { occurrence: key, view: value_use_relation(value: value, use: use) }
                ),
                not_derived: acc.not_derived,
                inputs: acc.inputs
              }
            // The binding is valued but its use names no reference node in this tree, so there is no
            // dependent and no usage_site to name: an edge with a fabricated endpoint would be a
            // stronger claim than the record supports.
            Absent =>
              ValueUseDependencies {
                relations: acc.relations,
                not_derived: snoc_not_derived(
                  acc.not_derived,
                  ValueUseNotDerived { occurrence: key, reason: ValuedUseNotLocated { value: value } }
                ),
                inputs: acc.inputs
              }
          }
        LexicalDeclared { node: _ } =>
          value_use_not_derived_standing(acc: acc, key: key, standing: lexical.standing)
        LexicalOwedFormal { field_type: _ } =>
          value_use_not_derived_standing(acc: acc, key: key, standing: lexical.standing)
        LexicalUntyped =>
          value_use_not_derived_standing(acc: acc, key: key, standing: lexical.standing)
      }
    BoundToParameter { path: _ } => value_use_as_input(acc: acc, key: key, binding: record.binding)
    BoundToTypeParameter { canonical: _ } => value_use_as_input(acc: acc, key: key, binding: record.binding)
    BoundToDeclaration { identity: _ } => value_use_as_input(acc: acc, key: key, binding: record.binding)
    BoundAmbient { table: _, identity: _ } => value_use_as_input(acc: acc, key: key, binding: record.binding)
    BoundByExpectedType { identity: _ } => value_use_as_input(acc: acc, key: key, binding: record.binding)
    BoundByGeneratedReference { identity: _ } => value_use_as_input(acc: acc, key: key, binding: record.binding)
  }
}

// THE RELATION. source is the value node — the thing the use waits on — never the binder, never the
// enclosing let, never a sibling's value. dependent and usage_site are both the reference occurrence:
// the use is where the waiting happens.
fn value_use_relation(value: Node, use: Node) -> DependencyView {
  DependencyView {
    source: value,
    dependent: use,
    kind: DataDependsOn,
    usage_site: use
  }
}

// THE RELATIONS AS v2.std.dependency Rows, so a consumer (A4's v2.program run) reads the same rows its
// claims check and never a parallel shape.
fn value_use_views(d: ValueUseDependencies) -> List<DependencyView> {
  fold_list(
    xs: d.relations,
    empty: [],
    cons: fn(acc, r) { list_snoc_item(xs: acc, item: r.view) }
  )
}

// THE APPENDERS, each named for the population it grows, so no arm can append to the wrong list.
fn snoc_relation(xs: List<ValueUseRelation>, item: ValueUseRelation) -> List<ValueUseRelation> {
  list_snoc_item(xs: xs, item: item)
}

fn snoc_not_derived(xs: List<ValueUseNotDerived>, item: ValueUseNotDerived) -> List<ValueUseNotDerived> {
  list_snoc_item(xs: xs, item: item)
}

// A BINDING WITH NO VALUE TO WAIT ON: the standing itself is the reason, carried as resolve's own
// variant so no text stands in for it and a consumer matches on the case.
fn value_use_not_derived_standing(
  acc: ValueUseDependencies,
  key: OccurrenceId,
  standing: LexicalBinderStanding
) -> ValueUseDependencies {
  ValueUseDependencies {
    relations: acc.relations,
    not_derived: snoc_not_derived(
      acc.not_derived,
      ValueUseNotDerived { occurrence: key, reason: NotDerivedStanding { standing: standing } }
    ),
    inputs: acc.inputs
  }
}

// AN INPUT, NOT AN IN-BODY PRODUCER: the row carries resolve's own OccurrenceBinding, which already
// names which of the six it is.
fn value_use_as_input(
  acc: ValueUseDependencies,
  key: OccurrenceId,
  binding: OccurrenceBinding
) -> ValueUseDependencies {
  ValueUseDependencies {
    relations: acc.relations,
    not_derived: acc.not_derived,
    inputs: list_snoc_item(xs: acc.inputs, item: ValueUseInput { occurrence: key, binding: binding })
  }
}
