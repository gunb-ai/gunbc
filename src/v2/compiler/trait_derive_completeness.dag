module v2.compiler.trait_derive_completeness

import v2.std.algebra { Cons, Empty, fold_list }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Disj,
  Edge,
  Node,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.compilers.target_model {
  RequiredTraitWitness,
  TargetCollectionWitnessEq,
  TargetCollectionWitnessHash,
  TargetCollectionWitnessOrd
}

data trait_derive_completeness_note: String = "Gate-1 sub-wall #2: structure-driven trait-derive completeness authority (Clone/arith/serde/ord). Agnostic predicate on modeled Node shapes — consumed by rust.dag surface-binding rows and v1 emit derive/impl selection. Fail-closed: unknown shapes refuse. NOT in target_model.dag (emit/ingest fold); mirrors wrap_decision.dag placement (#6776). Dissolve-on: three emit arms + layer-boundary mock test wire through this module."

type ReprGroundingDeriveTrait
  = ReprDeriveClone
  | ReprDeriveCopy
  | ReprDerivePartialEq
  | ReprDeriveEq
  | ReprDerivePartialOrd
  | ReprDeriveOrd
  | ReprDeriveSerialize
  | ReprDeriveDeserialize
  | ReprDeriveAdd
  | ReprDeriveSub
  | ReprDeriveMul
  | ReprDeriveDiv
  | ReprDeriveRem
  | ReprDeriveNeg

type ReprGroundingDeriveElemShape
  = ReprDeriveElemKernelString
  | ReprDeriveElemKernelInt
  | ReprDeriveElemKernelBool
  | ReprDeriveElemKernelUnit
  | ReprDeriveElemNullaryEnumCopy
  | ReprDeriveElemUnknown

type TraitDeriveCompletenessGate
  = TraitDeriveCompletenessSatisfied
  | TraitDeriveCompletenessIncomplete

fn trait_derive_int_kernel_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^int_kernel_type_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn trait_derive_unit_kernel_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^unit_kernel_type_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn trait_derive_variant_edge_has_payload(edge: Edge) -> Bool {
  match edge.target.kind {
    TypeNode { connective: Conj } =>
      match edge.target.children {
        Empty => false
        Cons { head: _, tail: _ } => true
      }
    _ => false
  }
}

fn trait_derive_coproduct_all_variants_nullary(edges: List<Edge>) -> Bool {
  fold_list(
    xs: edges,
    empty: true,
    cons: fn(acc, edge) {
      acc && !trait_derive_variant_edge_has_payload(edge: edge)
    }
  )
}

fn repr_grounding_derive_elem_shape(elem: Node) -> ReprGroundingDeriveElemShape {
  match elem.kind {
    TypeNode { connective: Disj } =>
      if trait_derive_coproduct_all_variants_nullary(edges: elem.children) {
        ReprDeriveElemNullaryEnumCopy
      } else {
        ReprDeriveElemUnknown
      }
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_collection_kernel_string || id == ^symbol_kernel_type_atom {
        ReprDeriveElemKernelString
      } else {
        if id == ^target_collection_kernel_int || id == ^int_kernel_type_atom {
          ReprDeriveElemKernelInt
        } else {
          if id == ^target_collection_kernel_bool || id == ^bool_node_symbol {
            ReprDeriveElemKernelBool
          } else {
            if id == ^target_collection_kernel_unit || id == ^unit_kernel_type_atom {
              ReprDeriveElemKernelUnit
            } else {
              ReprDeriveElemUnknown
            }
          }
        }
      }
    _ => ReprDeriveElemUnknown
  }
}

fn repr_grounding_derive_shape_has_trait(
  shape: ReprGroundingDeriveElemShape,
  trait: ReprGroundingDeriveTrait
) -> Bool {
  match shape {
    ReprDeriveElemKernelString =>
      match trait {
        ReprDeriveClone => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemKernelInt =>
      match trait {
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        ReprDeriveAdd => true
        ReprDeriveSub => true
        ReprDeriveMul => true
        ReprDeriveDiv => true
        ReprDeriveRem => true
        ReprDeriveNeg => true
      }
    ReprDeriveElemKernelBool =>
      match trait {
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemKernelUnit =>
      match trait {
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemNullaryEnumCopy =>
      match trait {
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemUnknown => false
  }
}

fn repr_grounding_derive_trait_satisfied(
  trait: ReprGroundingDeriveTrait,
  elem: Node
) -> Bool {
  repr_grounding_derive_shape_has_trait(
    shape: repr_grounding_derive_elem_shape(elem: elem),
    trait: trait
  )
}

fn repr_grounding_derive_completeness_predicate(
  required: List<ReprGroundingDeriveTrait>,
  elem: Node
) -> Bool {
  fold_list(
    xs: required,
    empty: true,
    cons: fn(acc, trait) {
      acc && repr_grounding_derive_trait_satisfied(trait: trait, elem: elem)
    }
  )
}

fn repr_grounding_derive_traits_for_collection_witness(
  witness: RequiredTraitWitness
) -> List<ReprGroundingDeriveTrait> {
  match witness {
    TargetCollectionWitnessOrd { type_param: _ } =>
      Cons {
        head: ReprDeriveOrd,
        tail: Cons {
          head: ReprDerivePartialOrd,
          tail: Cons {
            head: ReprDeriveEq,
            tail: Cons {
              head: ReprDerivePartialEq,
              tail: Cons { head: ReprDeriveClone, tail: Empty }
            }
          }
        }
      }
    TargetCollectionWitnessHash { type_param: _ } =>
      Cons {
        head: ReprDeriveEq,
        tail: Cons {
          head: ReprDerivePartialEq,
          tail: Cons { head: ReprDeriveClone, tail: Empty }
        }
      }
    TargetCollectionWitnessEq { type_param: _ } =>
      Cons {
        head: ReprDeriveEq,
        tail: Cons {
          head: ReprDerivePartialEq,
          tail: Cons { head: ReprDeriveClone, tail: Empty }
        }
      }
  }
}

fn trait_derive_completeness_gate(
  required: List<ReprGroundingDeriveTrait>,
  elem: Node
) -> TraitDeriveCompletenessGate {
  if repr_grounding_derive_completeness_predicate(required: required, elem: elem) {
    TraitDeriveCompletenessSatisfied
  } else {
    TraitDeriveCompletenessIncomplete
  }
}

fn trait_derive_completeness_gate_for_collection_witness(
  witness: RequiredTraitWitness,
  elem: Node
) -> TraitDeriveCompletenessGate {
  trait_derive_completeness_gate(
    required: repr_grounding_derive_traits_for_collection_witness(witness: witness),
    elem: elem
  )
}

fn trait_derive_completeness_gate_is_satisfied(
  required: List<ReprGroundingDeriveTrait>,
  elem: Node
) -> Bool {
  match trait_derive_completeness_gate(required: required, elem: elem) {
    TraitDeriveCompletenessSatisfied => true
    TraitDeriveCompletenessIncomplete => false
  }
}
