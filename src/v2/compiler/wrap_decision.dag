module v2.compiler.wrap_decision


type WrapDecisionBundleChildLookup
  = WrapDecisionBundleChildMissing
  | WrapDecisionBundleChildFound { value: Node }
  | WrapDecisionBundleChildDuplicate
  | WrapDecisionBundleChildInvalidEdge

fn wrap_decision_bundle_child_lookup_step(
  acc: WrapDecisionBundleChildLookup,
  e: v2.std.node.Edge,
  edge_name: v2.std.node.Symbol
) -> WrapDecisionBundleChildLookup {
  match acc {
    WrapDecisionBundleChildInvalidEdge => acc
    WrapDecisionBundleChildDuplicate => acc
    WrapDecisionBundleChildMissing =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            WrapDecisionBundleChildFound { value: e.target }
          } else {
            acc
          }
        Positional => WrapDecisionBundleChildInvalidEdge
      }
    WrapDecisionBundleChildFound { value: _ } =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            WrapDecisionBundleChildDuplicate
          } else {
            acc
          }
        Positional => WrapDecisionBundleChildInvalidEdge
      }
  }
}

fn wrap_decision_bundle_optional_child(
  target: v2.std.compilers.target_model.TargetModel,
  edge_name: v2.std.node.Symbol
) -> Outcome<Optional<Node>> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.bundle.children,
        init: WrapDecisionBundleChildMissing,
        f: fn(acc, e) {
          wrap_decision_bundle_child_lookup_step(
            acc: acc,
            e: e,
            edge_name: edge_name
          )
        }
      ) {
        WrapDecisionBundleChildFound { value: child } =>
          outcome_accepted(optional_present(value: child))
        WrapDecisionBundleChildMissing =>
          outcome_accepted(optional_absent())
        WrapDecisionBundleChildDuplicate =>
          outcome_rejected(
            v2.std.diagnostic.Diagnostic {
              reason: ^wrap_decision_bundle_duplicate_edge,
              at: node_locus(node: target.bundle),
              correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
            }
          )
        WrapDecisionBundleChildInvalidEdge =>
          outcome_rejected(
            v2.std.diagnostic.Diagnostic {
              reason: ^wrap_decision_bundle_malformed,
              at: node_locus(node: target.bundle),
              correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
            }
          )
      }
    _ =>
      outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^wrap_decision_bundle_malformed,
          at: node_locus(node: target.bundle),
          correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
        }
      )
  }
}

fn wrap_decision_bundle_edge_present(
  target: v2.std.compilers.target_model.TargetModel,
  edge_name: v2.std.node.Symbol
) -> Outcome<Bool> {
  match wrap_decision_bundle_optional_child(target: target, edge_name: edge_name) {
    Accepted { value: optional_child, diagnostics: _ } =>
      match optional_child {
        Absent => outcome_accepted(false)
        Present { value: _ } => outcome_accepted(true)
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn wrap_decision_sg_rc_bundle_partial_diagnostic(source_carrier: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^wrap_decision_sg_rc_bundle_partial,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}


fn wrap_decision_position_disagreement_diagnostic(source_carrier: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^wrap_decision_position_disagreement,
    at: node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn wrap_decision_gates_agree(
  producer: v2.std.compilers.target_model.WrapDecisionGate,
  consumer: v2.std.compilers.target_model.WrapDecisionGate
) -> Bool {
  match producer {
    WrapGateInapplicable =>
      match consumer {
        WrapGateInapplicable => true
        WrapGateDecided { decision: _ } => false
      }
    WrapGateDecided { decision: p } =>
      match consumer {
        WrapGateInapplicable => false
        WrapGateDecided { decision: c } => wrap_decisions_equal(a: p, c: c)
      }
  }
}

fn wrap_decisions_equal(a: v2.std.compilers.target_model.WrapDecision, c: v2.std.compilers.target_model.WrapDecision) -> Bool {
  match a {
    WrapByValue =>
      match c {
        WrapByValue => true
        WrapByReference { layer: _ } => false
      }
    WrapByReference { layer: al } =>
      match c {
        WrapByValue => false
        WrapByReference { layer: cl } => al == cl
      }
  }
}

// R1's construction half. wrap_decision_gate answers ONE position at a time, and every consumer of
// it — here and in v1's seed emitter — then acts on that answer alone. A value does not live at
// one position: it is produced at one and consumed at another, and when the two answers differ the
// emitted program carries a type error that no compiler stage located, because no stage ever
// compared them. Measured on the emitted corpus that defect is ten types and fourteen occurrences,
// every one wrapped at every signature occurrence and bare at one or more field occurrences, and
// it produces BOTH error directions from one inconsistency: a producer's Rc<T> assigned into a
// bare consumer is the over-wrap, a bare producer read into an Rc<T> consumer is the under-wrap.
// So the flow, not the position, is the unit that has to be decided. wrap_decision_flow_gate is
// that unit: it projects the SAME authority at both ends — one function over one catalog, so no
// second OPINION exists to drift — and refuses, typed and located, when that one authority's
// answers for the two positions differ. Stated precisely because the loose form is an overclaim
// worth not making: this is two traversals of one catalog, not one traversal, and what it rules
// out is a divergent authority rather than a repeated read. The repeated read is a real cost shape
// — two folds over the row list where a per-carrier policy built once would serve both ends — and
// it is named here rather than dismissed as small, per DESIGN section 6's rule that a proven cost
// shape is fixed regardless of the realized n. It is not fixed in this change because the policy
// carrier is the same carrier change the next rung needs, and building half of it here to save one
// fold would fork the thing the transition work has to own; the trigger is that carrier landing.
// RUNG (DESIGN 4b), stated honestly because the distance to the ceiling is the point: this moves
// the class from silent wrongness (outside the ladder — emitted, compiled, wrong, discovered only
// if rustc happens to catch it downstream) to MITIGATABLE — the line stops with a located refusal
// naming the carrier. It does NOT reach structural impossibility and must not be read as doing so:
// the invalid state is still writable, because a catalog may still legitimately state different
// layers at two positions and this function's only answer to that is to refuse the flow. The next
// rung is a modeled layer TRANSITION — the value expression carrying its current layer, and a
// total raise/lower/refuse function over (from, to) — at which point an agreeing flow is derived
// rather than checked and this refusal narrows to the genuinely unconvertible pairs. That is
// deliberately not built here: it needs TargetValueExpression to carry its layer, which is a
// carrier change, and DESIGN's model-before-implement discipline puts that ahead of the pipeline
// edit rather than inside it. NOT WIRED INTO 06_translate BY THIS CHANGE: the seams that would
// consume it are the ones the ruling scoped, and wiring them is a separate motion with its own
// emitted-corpus evidence. What lands here is the authority and its executing controls in both
// directions.
fn wrap_decision_flow_gate(
  target: v2.std.compilers.target_model.TargetModel,
  source_carrier: Node,
  producer_site: v2.std.compilers.target_model.TargetOwnershipUseSite,
  consumer_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> Outcome<v2.std.compilers.target_model.WrapDecisionGate> {
  bind_outcome(
    o: wrap_decision_gate(
      target: target,
      source_carrier: source_carrier,
      use_site: producer_site
    ),
    f: fn(producer_gate) {
      bind_outcome(
        o: wrap_decision_gate(
          target: target,
          source_carrier: source_carrier,
          use_site: consumer_site
        ),
        f: fn(consumer_gate) {
          if wrap_decision_gates_agree(
            producer: producer_gate,
            consumer: consumer_gate
          ) {
            outcome_accepted(producer_gate)
          } else {
            outcome_rejected(
              wrap_decision_position_disagreement_diagnostic(
                source_carrier: source_carrier
              )
            )
          }
        }
      )
    }
  )
}

fn wrap_decision_sg_rc_bundle_apply_disposition(
  target: v2.std.compilers.target_model.TargetModel,
  source_carrier: Node
) -> Outcome<Bool> {
  bind_outcome(
    o: wrap_decision_bundle_edge_present(
      target: target,
      edge_name: ^target_model_edge_use_site_ownership_realizations
    ),
    f: fn(has_catalog) {
      bind_outcome(
        o: wrap_decision_bundle_edge_present(
          target: target,
          edge_name: ^target_model_edge_reference_layer_tokens
        ),
        f: fn(has_tokens) {
          if has_catalog == false && has_tokens == false {
            outcome_accepted(false)
          } else {
            if has_catalog && has_tokens {
              outcome_accepted(true)
            } else {
              outcome_rejected(
                wrap_decision_sg_rc_bundle_partial_diagnostic(
                  source_carrier: source_carrier
                )
              )
            }
          }
        }
      )
    }
  )
}

fn wrap_decision_gate(
  target: v2.std.compilers.target_model.TargetModel,
  source_carrier: Node,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> Outcome<v2.std.compilers.target_model.WrapDecisionGate> {
  match wrap_decision_sg_rc_bundle_apply_disposition(
    target: target,
    source_carrier: source_carrier
  ) {
    Accepted { value: false, diagnostics: _ } =>
      outcome_accepted(WrapGateInapplicable)
    Accepted { value: true, diagnostics: _ } =>
      bind_outcome(
        o: wrap_decision_bundle_optional_child(
          target: target,
          edge_name: ^target_model_edge_use_site_ownership_realizations
        ),
        f: fn(optional_catalog) {
          match optional_catalog {
            Absent =>
              outcome_rejected(
                wrap_decision_sg_rc_bundle_partial_diagnostic(
                  source_carrier: source_carrier
                )
              )
            Present { value: catalog_node } =>
              bind_outcome(
                o: wrap_decision_bundle_optional_child(
                  target: target,
                  edge_name: ^target_model_edge_value_semantics_carriers
                ),
                f: fn(optional_carriers) {
                  let value_semantics_carriers = match optional_carriers {
                    Absent => Empty
                    Present { value: node } =>
                      target_value_semantics_carriers_from_node(node: node)
                  }
                  bind_outcome(
                    o: wrap_decision_lookup_in_catalog_node(
                      catalog: catalog_node,
                      value_semantics_carriers: value_semantics_carriers,
                      source_carrier: source_carrier,
                      use_site: use_site
                    ),
                    f: fn(decision) {
                      outcome_accepted(
                        v2.std.compilers.target_model.WrapGateDecided { decision: decision }
                      )
                    }
                  )
                }
              )
          }
        }
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
