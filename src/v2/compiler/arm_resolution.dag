module v2.compiler.arm_resolution

import std.optional { Absent, Optional, Present, optional_present }
import std.decl_ref { DeclarationRef, decl_ref }
import std.types { List }
import std.algebra { PartialFunction, is_empty, list_at_optional }
import v2.std.node { Authored, Node, Positional, StructuralLabel, Symbol, positional_child_target_nodes, symbol_lexeme }
import v2.std.grammar { node_atom_identity_optional }
import v2.std.qualified_name { QualifiedName, qualified_name_init, qualified_name_last_segment, qualified_name_to_dotted_string }
import v2.std.diagnostic { Diagnostic, ExternalContractUnknown, Outcome, Unavailable, node_locus, outcome_accepted, outcome_rejected }

// THE RESOLVED ARM OF AN `x is V` TEST: the fact elaboration derives by matching V's spelling against the
// declared roster of x's type. It is a compiler fact about one elaborated node, not a std concept
// (std.primitives ConstructorTag is the arm IDENTITY a realization mints; this is the arm RESOLUTION
// that realization is decided from). sole_constructor confines construction to this module and
// resolve_is_arm is its one call site, so an authored program holds no way to spell one: there is no
// grammar row for it, and a record literal or a call to anything but resolve_is_arm cannot produce it.
//
// The arm is keyed by DeclarationRef, never by position or by spelling alone. Whether the arm is a unit
// arm is read from the declaration when the realization is decided and is not stored beside it.
type ResolvedArm sole_constructor {
  owner_decl: DeclarationRef
  owner_type: Node
  arm: DeclarationRef
  realization: ArmRealization
}

// THE REALIZATION IS DECIDED WITH THE FACT, so eval and each emitter map one decided fact and none
// re-derives the decision (the std.operator_realization precedent). A payload arm has no arm-reference
// value to hand tag_of; it is an explicit typed cause, never a wildcard match or a fallback, until the
// arm-reference entry (R1 PR2) mints the tag for both kinds on one path.
// What infer concluded about one arm test it met: a decided ResolvedArm, or the counted frontier (operand
// type not derived). A coproduct rather than Optional<ResolvedArm> so a Map value is never a nested optional.
type ArmTestDecision
  = ArmDecided { arm: ResolvedArm }
  | ArmUndecided

type ArmRealization
  = UnitArmSameArm
  | PayloadArmReferenceAwaited

fn arm_resolution_not_declared_diagnostic(arm: Node) -> Diagnostic {
  Diagnostic {
    reason: ^arm_resolution_reason_arm_not_declared_by_owner,
    at: node_locus(node: arm),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn arm_resolution_owner_unreadable_diagnostic(arm: Node) -> Diagnostic {
  Diagnostic {
    reason: ^arm_resolution_reason_owner_path_unreadable,
    at: node_locus(node: arm),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn arm_resolution_unreadable_diagnostic(arm: Node) -> Diagnostic {
  Diagnostic {
    reason: ^arm_resolution_reason_arm_spelling_unreadable,
    at: node_locus(node: arm),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// THE ONLY MINT. `owner_path` and `variants` are the owner type's declaring path and its declared
// roster (a Disj), read by the caller from the same declaration index every other roster reader uses;
// `arm` is the authored spelling node, which is what a refusal locates at. A spelling the roster does
// not declare -- misspelt, or an arm of another type -- refuses with one cause located at the spelling.
fn resolve_is_arm(owner_path: QualifiedName, owner_type: Node, variants: Node, arm: Node) -> Outcome<ResolvedArm> {
  match node_atom_identity_optional(node: arm) {
    Absent => outcome_rejected(arm_resolution_unreadable_diagnostic(arm: arm))
    Present { value: name } =>
      match infer_match_variant_payload(variants: variants, tag: name) {
        Absent => outcome_rejected(arm_resolution_not_declared_diagnostic(arm: arm))
        Present { value: payload } =>
          match qualified_name_last_segment(qn: owner_path) {
            Absent => outcome_rejected(arm_resolution_owner_unreadable_diagnostic(arm: arm))
            Present { value: owner_name } =>
              outcome_accepted(value: ResolvedArm {
                owner_decl: decl_ref(
                  module_path: qualified_name_to_dotted_string(qn: qualified_name_init(qn: owner_path)),
                  decl_name: symbol_lexeme(sym: owner_name)
                ),
                owner_type: owner_type,
                arm: decl_ref(
                  module_path: qualified_name_to_dotted_string(qn: owner_path),
                  decl_name: symbol_lexeme(sym: name)
                ),
                realization: if is_empty(xs: payload.children) { UnitArmSameArm } else { PayloadArmReferenceAwaited }
              })
          }
      }
  }
}

// A VARIANT'S PAYLOAD IS THE TARGET OF ITS TAG EDGE, NOT A DECLARED FIELD. A coproduct is a Disj whose
// Authored edges are labelled by variant tag and target the payload Conj directly; declared_field_from_edge
// answers only for an edge whose target is a binder node (v2.std.node_query binder_node_parts), so reading a
// variant through it answered Absent for every tag once fields became binder nodes, and every match refused
// as infer_match_pattern_variant_not_declared. The payload's FIELDS are declared fields and keep that reader.
fn infer_match_variant_payload(variants: Node, tag: Symbol) -> Optional<Node> {
  fold(variants.children, init: Absent, f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match e.label {
          Authored { name: variant } => if variant == tag { optional_present(value: e.target) } else { Absent }
          StructuralLabel { label: _ } => Absent
          Positional => Absent
        }
    }
  })
}

// THE ARM TEST OPERATOR: Transform[kw_is, x, V] (v2.compiler.body_lowering_fold body_lower_is_node).
fn node_is_arm_test(node: Node) -> Bool {
  match list_at_optional(xs: positional_child_target_nodes(node: node), index: 0) {
    Present { value: op } =>
      match node_atom_identity_optional(node: op) {
        Present { value: id } => id == ^dag_token_kw_is
        Absent => false
      }
    Absent => false
  }
}

// WHERE `x is V` EXECUTES: nowhere yet. The decided fact would realize as same_arm(tag: tag_of(v: V), v: x)
// (std.primitives), and v2 has no realization of tag_of/same_arm in eval or native emit, so the ONE table
// both realizers read answers a typed refusal naming that missing capability, located at the test. A test
// carrying no ResolvedArm entry refuses with its own cause: nothing decided what it means. Dissolves when
// the v2 realization of tag_of/same_arm lands and eval and emit map UnitArmSameArm to it.
fn arm_test_realization_refusal(tests: List<Node>, decided: PartialFunction<Node, ResolvedArm>) -> Optional<Diagnostic> {
  fold(tests, init: Absent, f: fn(acc, n) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match decided.lookup(n) {
          Present { value: _ } => optional_present(value: arm_test_realization_awaited_diagnostic(test: n))
          Absent => optional_present(value: arm_test_without_resolution_diagnostic(test: n))
        }
    }
  })
}

fn arm_test_realization_awaited_diagnostic(test: Node) -> Diagnostic {
  Diagnostic {
    reason: ^arm_test_awaiting_v2_realization_of_tag_of_same_arm,
    at: node_locus(node: test),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn arm_test_without_resolution_diagnostic(test: Node) -> Diagnostic {
  Diagnostic {
    reason: ^arm_test_without_resolved_arm,
    at: node_locus(node: test),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
