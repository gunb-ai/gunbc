// Scope: lens-unit RED — module missing extdeps_stable_authority_anchor.

module v2.test.extdeps_stable_authority.lens_unit.missing_anchor_red

import v2.lens.extdeps_stable_authority {
  AnchorAbsent,
  ExtdepsStableAuthorityFact,
  extdeps_stable_authority_violation_count
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data missing_anchor_facts: List<ExtdepsStableAuthorityFact> = [
  ExtdepsStableAuthorityFact {
    path: "dsl/extdeps/fixture/plant.dag",
    module: "extdeps.fixture.plant",
    status: AnchorAbsent
  }
]

test fn missing_anchor_is_red_holds() -> Bool {
  extdeps_stable_authority_violation_count(facts: missing_anchor_facts) == 1
}
