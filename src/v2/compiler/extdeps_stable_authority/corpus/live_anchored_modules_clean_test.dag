// Scope: live-tree GREEN — real derived extdeps roster projects clean (slice 1).

module v2.test.extdeps_stable_authority.corpus.live_anchored_modules_clean

import v2.lens.extdeps_stable_authority {
  extdeps_stable_authority_live_clean_tree_holds,
  extdeps_stable_authority_live_roster_module_count
}
import v2.std.logic { Bool }

test fn corpus_live_clean_tree_holds() -> Bool {
  extdeps_stable_authority_live_clean_tree_holds()
    && extdeps_stable_authority_live_roster_module_count() > 150
}

test fn corpus_live_anchored_modules_clean_holds() -> Bool {
  extdeps_stable_authority_live_clean_tree_holds()
}
