module v2.compiler.effect_pair_census

import std.algebra { Cons, Empty, FreeMonoid, list_snoc_item, fold_list, length, empty_map, map_insert, map_lookup }
import std.types { Bool, List, Map }
import std.optional { Absent, Optional, Present }
import v2.std.integer { Int }
import v2.std.qualified_name { QualifiedName }
import v2.std.text { String }
import std.occurrence_identity { OccurrenceId }
import v2.compiler.dependency_demand_census { FactCallSite, FactBodySites }
import v2.compiler.dependency_demand {
  CalleeOutsideClosure, DemandDerived, DemandDidNotSettle, DemandUndecided, DependencyDemandRow, FunctionFact,
  FunctionValueCalled, OpaqueOperationCalled, OperationFact, RequiresNone, RequiresOpaque, RequiresResources,
  RequiresUndeclared, UndeclaredOperationCalled, UndecidedCause, dependency_demand_of
}

// THE EFFECT-PAIR CENSUS (DESIGN D16 TRIGGER, gunbc.plans.demand_engine_program): per function body,
// every pair of effect-reaching call occurrences that no derived relation orders. It is MEASUREMENT
// ONLY and changes no behaviour. THE COUNT OVER-COUNTS ON PURPOSE: resource identity is not modelled
// (D16 part 3), so every unordered pair of reaching sites is a possible conflict, whatever resources
// its sites touch. "Not ordered by a derived relation" is not "independent": the derivations'
// not-derived rows are reported beside each body with a pair.

// WHY A SITE REACHES AN EFFECT. The leaf predicate is v2.compiler.effect_demand's
// PrimitiveExecutionSemantics (ObservesHost | ActuatesHost | ExecutionSemanticsUnknown reach; Pure |
// ReadsBoundInput do not); the rest is v2.compiler.dependency_demand's call facts, propagated over its
// FunctionFact callees.
type ReachReason
  = ReachesHostObservation
  | ReachesHostActuation
  | ReachesExecutionSemanticsUnknown
  | ReachesDeclaredResource { operation: QualifiedName }
  | ReachesOpaqueOperation { operation: QualifiedName }
  | ReachesUndeclaredOperation { operation: QualifiedName }
  | ReachesFunctionValueCall { function: QualifiedName }
  | ReachesUnresolvedCallee { callee: QualifiedName }
  | ReachesThroughCallee { callee: QualifiedName }

// One effect-reaching call OCCURRENCE (nested ones included; containment in an effectful parent
// orders nothing).
type EffectSite {
  occurrence: Int
  callee: QualifiedName
  reason: ReachReason
}

// What the derivations say about the two sites' resources. Distinct never means independent.
type SharedPathStanding
  = SharedDeclaredPath { paths: List<QualifiedName> }
  | DistinctDeclaredPaths
  | AliasUnknown

type EffectPairRow {
  module: QualifiedName
  function: QualifiedName
  first: EffectSite
  second: EffectSite
  resource_standing: SharedPathStanding
}

// A pair the body orders by construction: the two sites are alternatives of one Branch/Match.
type ExclusivePairRow {
  module: QualifiedName
  function: QualifiedName
  first: EffectSite
  second: EffectSite
}

// A reaching site that runs more than once (enclosing Loop or lambda-argument template).
type RepeatedEffectSite {
  module: QualifiedName
  function: QualifiedName
  site: EffectSite
  repetition_source: String
}

type ModuleEffectPairTotals {
  module: QualifiedName
  bodies_scanned: Int
  bodies_with_pairs: Int
  pairs: Int
  exclusive_pairs: Int
}

// ONE BODY'S EXTRACTED FACTS. `sites` are the effect-reaching call occurrences in preorder; `orders`
// are the derived relations between occurrences (value use, activation, operand-to-consuming-call),
// each from an earlier occurrence to the one that depends on it; `exclusive` are alternatives of one
// Branch/Match. An ambiguous endpoint never contributes an order (the over-count direction).
type OrderEdge {
  from: Int
  to: Int
}

type BodyEffectFacts {
  module: QualifiedName
  function: QualifiedName
  sites: List<EffectSite>
  orders: List<OrderEdge>
  exclusive: List<OrderEdge>
}

type BodyPairs {
  pairs: List<EffectPairRow>
  exclusive_pairs: List<ExclusivePairRow>
}

fn pair_adjacency(edges: List<OrderEdge>) -> Map<Int, List<Int>> {
  fold_list(xs: edges, empty: empty_map(), cons: fn(m, e) {
    match map_lookup(m: m, key: e.from) {
      Present { value: tos } => map_insert(m: m, key: e.from, value: list_snoc_item(xs: tos, item: e.to))
      Absent => map_insert(m: m, key: e.from, value: list_snoc_item(xs: Empty, item: e.to))
    }
  })
}

// Is `target` reachable from `start` along orders? Fuel is the edge count, so the walk is bounded.
fn pair_reaches(adj: Map<Int, List<Int>>, frontier: List<Int>, target: Int, fuel: Int) -> Bool {
  if fuel < 0 {
    false
  } else {
    if fold_list(xs: frontier, empty: false, cons: fn(hit, n) { hit || (n == target) }) {
      true
    } else {
      let next = fold_list(xs: frontier, empty: Empty, cons: fn(acc, n) {
        match map_lookup(m: adj, key: n) {
          Present { value: tos } => fold_list(xs: tos, empty: acc, cons: fn(a, t) { list_snoc_item(xs: a, item: t) })
          Absent => acc
        }
      })
      if length(xs: next) == 0 { false } else { pair_reaches(adj: adj, frontier: next, target: target, fuel: fuel - 1) }
    }
  }
}

fn pair_ordered(adj: Map<Int, List<Int>>, a: Int, b: Int, fuel: Int) -> Bool {
  pair_reaches(adj: adj, frontier: list_snoc_item(xs: Empty, item: a), target: b, fuel: fuel)
    || pair_reaches(adj: adj, frontier: list_snoc_item(xs: Empty, item: b), target: a, fuel: fuel)
}

fn pair_exclusive(exclusive: List<OrderEdge>, a: Int, b: Int) -> Bool {
  fold_list(xs: exclusive, empty: false, cons: fn(hit, e) { hit || ((e.from == a) && (e.to == b)) || ((e.from == b) && (e.to == a)) })
}

// The per-body reducer. Cost is per body (sites^2 over reaching sites only), never over a module.
fn body_effect_pairs(facts: BodyEffectFacts) -> BodyPairs {
  let adj = pair_adjacency(edges: facts.orders)
  let fuel = length(xs: facts.orders)
  let seed = BodyPairs { pairs: Empty, exclusive_pairs: Empty }
  fold_list(xs: facts.sites, empty: seed, cons: fn(acc, a) {
    fold_list(xs: facts.sites, empty: acc, cons: fn(inner, b) {
      if a.occurrence < b.occurrence {
        if pair_exclusive(exclusive: facts.exclusive, a: a.occurrence, b: b.occurrence) {
          BodyPairs { pairs: inner.pairs, exclusive_pairs: list_snoc_item(xs: inner.exclusive_pairs, item: ExclusivePairRow { module: facts.module, function: facts.function, first: a, second: b }) }
        } else {
          if pair_ordered(adj: adj, a: a.occurrence, b: b.occurrence, fuel: fuel) {
            inner
          } else {
            BodyPairs { pairs: list_snoc_item(xs: inner.pairs, item: EffectPairRow { module: facts.module, function: facts.function, first: a, second: b, resource_standing: AliasUnknown }), exclusive_pairs: inner.exclusive_pairs }
          }
        }
      } else {
        inner
      }
    })
  })
}

// A value-use relation reduced to the two occurrences a body can join on: the bound value node's and
// the reference's. An endpoint with no occurrence cannot be joined and so orders nothing.
type UseEdge {
  source: Optional<OccurrenceId>
  dependent: Optional<OccurrenceId>
}

fn extract_occurrence_key(o: Optional<OccurrenceId>) -> Optional<Int> {
  match o {
    Present { value: id } => Present { value: id.value }
    Absent => Absent
  }
}

// site-by-occurrence index; a duplicated occurrence is ambiguous and is dropped, never guessed.
fn extract_site_index(sites: List<FactCallSite>) -> Map<Int, Optional<FactCallSite>> {
  fold_list(xs: sites, empty: empty_map(), cons: fn(m, site) {
    match extract_occurrence_key(o: site.occurrence) {
      Absent => m
      Present { value: k } =>
        match map_lookup(m: m, key: k) {
          Present { value: _ } => map_insert(m: m, key: k, value: Absent)
          Absent => map_insert(m: m, key: k, value: Present { value: site })
        }
    }
  })
}

fn extract_site_at(index: Map<Int, Optional<FactCallSite>>, o: Optional<OccurrenceId>) -> Optional<FactCallSite> {
  match extract_occurrence_key(o: o) {
    Absent => Absent
    Present { value: k } =>
      match map_lookup(m: index, key: k) {
        Present { value: slot } => slot
        Absent => Absent
      }
  }
}

// ORDER EDGES of one body, keyed by a site's `enter`: (a) an operand that is itself a call orders
// before its consumer; (b) a value-use whose dependent is an operand of the consumer orders the
// site that IS the bound value before the consumer. A bound value that merely CONTAINS a call, or an
// ambiguous endpoint, orders nothing: that direction over-counts.
fn extract_order_edges(sites: List<FactCallSite>, uses: List<UseEdge>) -> List<OrderEdge> {
  let index = extract_site_index(sites: sites)
  fold_list(xs: sites, empty: Empty, cons: fn(acc, consumer) {
    fold_list(xs: consumer.operands, empty: acc, cons: fn(a, operand) {
      let direct = match extract_site_at(index: index, o: operand) {
        Present { value: x } => list_snoc_item(xs: a, item: OrderEdge { from: x.enter, to: consumer.enter })
        Absent => a
      }
      fold_list(xs: uses, empty: direct, cons: fn(b, u) {
        if extract_same_occurrence(left: u.dependent, right: operand) {
          match extract_site_at(index: index, o: u.source) {
            Present { value: x } => list_snoc_item(xs: b, item: OrderEdge { from: x.enter, to: consumer.enter })
            Absent => b
          }
        } else {
          b
        }
      })
    })
  })
}

fn extract_same_occurrence(left: Optional<OccurrenceId>, right: Optional<OccurrenceId>) -> Bool {
  match extract_occurrence_key(o: left) {
    Present { value: l } =>
      match extract_occurrence_key(o: right) {
        Present { value: r } => l == r
        Absent => false
      }
    Absent => false
  }
}

// The body's facts. `reason_of` says whether a callee reaches an effect and why; only reaching
// sites are the pair population, but the order graph keeps every site so a chain through a pure
// call still orders its ends.
fn body_effect_facts(module: QualifiedName, body: FactBodySites, uses: List<UseEdge>, reason_of: fn(QualifiedName) -> Optional<ReachReason>) -> BodyEffectFacts {
  BodyEffectFacts {
    module: module,
    function: body.function,
    sites: fold_list(xs: body.sites, empty: Empty, cons: fn(acc, s) {
      match reason_of(s.callee) {
        Present { value: r } => list_snoc_item(xs: acc, item: EffectSite { occurrence: s.enter, callee: s.callee, reason: r })
        Absent => acc
      }
    }),
    orders: extract_order_edges(sites: body.sites, uses: uses),
    exclusive: Empty
  }
}

// WHICH CALLEES REACH AN EFFECT, by reusing D13's reducer unchanged over a TRANSFORMED operation
// table: every operation that is not declared RequiresNone becomes RequiresOpaque, so a function's
// demand is Undecided exactly when some call chain from it reaches an operation, an opaque or
// undeclared one, a function value or a callee outside the closure. No second call graph.
// An operation declared RequiresNone is the one thing that does not reach; whether its execution
// semantics row says otherwise is reported by the census, never promoted here.
type EffectReachTable {
  reasons: Map<QualifiedName, ReachReason>
  known: Map<QualifiedName, Bool>
}

fn reach_operation_table(operations: List<OperationFact>) -> List<OperationFact> {
  fold_list(xs: operations, empty: Empty, cons: fn(acc, op) {
    match op.requirement {
      RequiresNone => list_snoc_item(xs: acc, item: op)
      RequiresResources { resources: _ } => list_snoc_item(xs: acc, item: OperationFact { path: op.path, requirement: RequiresOpaque })
      RequiresOpaque => list_snoc_item(xs: acc, item: op)
      RequiresUndeclared => list_snoc_item(xs: acc, item: OperationFact { path: op.path, requirement: RequiresOpaque })
    }
  })
}

fn reach_reason_of_cause(cause: UndecidedCause) -> ReachReason {
  match cause {
    OpaqueOperationCalled { operation: o } => ReachesOpaqueOperation { operation: o }
    UndeclaredOperationCalled { operation: o } => ReachesUndeclaredOperation { operation: o }
    FunctionValueCalled { function: f } => ReachesFunctionValueCall { function: f }
    CalleeOutsideClosure { callee: c } => ReachesUnresolvedCallee { callee: c }
    DemandDidNotSettle { function: f } => ReachesThroughCallee { callee: f }
  }
}

fn reach_operation_reason(op: OperationFact) -> Optional<ReachReason> {
  match op.requirement {
    RequiresNone => Absent
    RequiresResources { resources: _ } => Present { value: ReachesDeclaredResource { operation: op.path } }
    RequiresOpaque => Present { value: ReachesOpaqueOperation { operation: op.path } }
    RequiresUndeclared => Present { value: ReachesUndeclaredOperation { operation: op.path } }
  }
}

fn effect_reach_table(functions: List<FunctionFact>, operations: List<OperationFact>) -> EffectReachTable {
  let rows = dependency_demand_of(functions: functions, operations: reach_operation_table(operations: operations))
  let from_functions = fold_list(xs: rows, empty: empty_map(), cons: fn(m, r) {
    match r.demand {
      DemandDerived { resources: _ } => m
      DemandUndecided { cause: c } => map_insert(m: m, key: r.function, value: reach_reason_of_cause(cause: c))
    }
  })
  let with_ops = fold_list(xs: operations, empty: from_functions, cons: fn(m, op) {
    match reach_operation_reason(op: op) {
      Present { value: r } => map_insert(m: m, key: op.path, value: r)
      Absent => m
    }
  })
  let known_fns = fold_list(xs: functions, empty: empty_map(), cons: fn(m, f) { map_insert(m: m, key: f.path, value: true) })
  let known = fold_list(xs: operations, empty: known_fns, cons: fn(m, op) { map_insert(m: m, key: op.path, value: true) })
  EffectReachTable { reasons: with_ops, known: known }
}

// A callee with no fact row at all is outside the closure and reaches by definition.
fn effect_reach_reason(table: EffectReachTable, callee: QualifiedName) -> Optional<ReachReason> {
  match map_lookup(m: table.reasons, key: callee) {
    Present { value: r } => Present { value: r }
    Absent =>
      match map_lookup(m: table.known, key: callee) {
        Present { value: _ } => Absent
        Absent => Present { value: ReachesUnresolvedCallee { callee: callee } }
      }
  }
}
