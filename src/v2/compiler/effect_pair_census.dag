module v2.compiler.effect_pair_census

import std.algebra { list_head, list_tail, Cons, Empty, FreeMonoid, list_snoc_item, fold_list, length, empty_map, map_insert, map_lookup }
import std.types { Bool, List, Map }
import std.optional { Absent, Optional, Present }
import v2.std.integer { Int }
import v2.std.qualified_name { QualifiedName }
import v2.std.text { String }
import std.occurrence_identity { OccurrenceId }
import v2.std.node { Node }
import v2.std.provenance { node_occurrence_id_optional }
import v2.std.qualified_name { qualified_name_to_dotted_string }
import v2.compiler.value_use_dependency {
  NotDerivedReason, NotDerivedStanding, RecordAbsent, ValuedBinderNotLocated, ValuedBinderSiteUnkeyed,
  ValuedUseNotLocated, ValueUseDependencies, ValueUseNotDerived, ValueUseRelation
}
import v2.compiler.effect_demand {
  ActuatesHost, ExecutionSemanticsUnknown, ObservesHost, Pure, PrimitiveExecutionSemantics, ReadsBoundInput,
  effect_demand_operation_classifications
}
import std.primitive_projection { primitive_projection_roster }
import v2.compiler.dependency_demand_census { FactCallSite, FactBodySites, FactGroup, FactSpan }
import v2.compiler.dependency_demand {
  CalleeOutsideClosure, DemandDerived, DemandDidNotSettle, DemandUndecided, DependencyDemandRow, FunctionFact,
  FunctionValueCalled, OpaqueOperationCalled, OperationFact, RequiresNone, RequiresOpaque, RequiresResources,
  RequiresUndeclared, UndeclaredOperationCalled, UndecidedCause, dependency_demand_of
}

// THE EFFECT-PAIR CENSUS (DESIGN D16 TRIGGER, gunbc.plans.demand_engine_program): per function body,
// every pair of effect-reaching call occurrences that no derived relation orders. It is MEASUREMENT
// ONLY and changes no behaviour. THE COUNT OVER-COUNTS ON PURPOSE: resource identity is not modelled
// (D16 part 3), so every unordered pair of reaching sites is a possible conflict, whatever resources
// its sites touch. "Not ordered by a derived relation" is not "independent": the derivations'
// not-derived rows are reported beside each body with a pair.

// WHY A SITE REACHES AN EFFECT. The leaf predicate is v2.compiler.effect_demand's
// PrimitiveExecutionSemantics (ObservesHost | ActuatesHost | ExecutionSemanticsUnknown reach; Pure |
// ReadsBoundInput do not); the rest is v2.compiler.dependency_demand's call facts, propagated over its
// FunctionFact callees.
type ReachReason
  = ReachesHostObservation
  | ReachesHostActuation
  | ReachesExecutionSemanticsUnknown
  | ReachesDeclaredResource { operation: QualifiedName }
  | ReachesOpaqueOperation { operation: QualifiedName }
  | ReachesUndeclaredOperation { operation: QualifiedName }
  | ReachesFunctionValueCall { function: QualifiedName }
  | ReachesUnresolvedCallee { callee: QualifiedName }
  | ReachesThroughCallee { callee: QualifiedName }

// One effect-reaching call OCCURRENCE (nested ones included; containment in an effectful parent
// orders nothing).
type EffectSite {
  occurrence: Int
  callee: QualifiedName
  reason: ReachReason
}

// What the derivations say about the two sites' resources. Distinct never means independent.
type SharedPathStanding
  = SharedDeclaredPath { paths: List<QualifiedName> }
  | DistinctDeclaredPaths
  | AliasUnknown

type EffectPairRow {
  module: QualifiedName
  function: QualifiedName
  first: EffectSite
  second: EffectSite
  resource_standing: SharedPathStanding
}

// A pair the body orders by construction: the two sites are alternatives of one Branch/Match.
type ExclusivePairRow {
  module: QualifiedName
  function: QualifiedName
  first: EffectSite
  second: EffectSite
}

// A reaching site that runs more than once (enclosing Loop or lambda-argument template).
type RepeatedEffectSite {
  module: QualifiedName
  function: QualifiedName
  site: EffectSite
  repetition_source: String
}

type ModuleEffectPairTotals {
  module: QualifiedName
  bodies_scanned: Int
  bodies_with_pairs: Int
  pairs: Int
  exclusive_pairs: Int
}

// ONE BODY'S EXTRACTED FACTS. `sites` are the effect-reaching call occurrences in preorder; `orders`
// are the derived relations between occurrences (value use, activation, operand-to-consuming-call),
// each from an earlier occurrence to the one that depends on it; `exclusive` are alternatives of one
// Branch/Match. An ambiguous endpoint never contributes an order (the over-count direction).
type OrderEdge {
  from: Int
  to: Int
}

type BodyEffectFacts {
  module: QualifiedName
  function: QualifiedName
  sites: List<EffectSite>
  orders: List<OrderEdge>
  exclusive: List<OrderEdge>
}

type BodyPairs {
  pairs: List<EffectPairRow>
  exclusive_pairs: List<ExclusivePairRow>
}

fn pair_adjacency(edges: List<OrderEdge>) -> Map<Int, List<Int>> {
  fold_list(xs: edges, empty: empty_map(), cons: fn(m, e) {
    match map_lookup(m: m, key: e.from) {
      Present { value: tos } => map_insert(m: m, key: e.from, value: list_snoc_item(xs: tos, item: e.to))
      Absent => map_insert(m: m, key: e.from, value: list_snoc_item(xs: Empty, item: e.to))
    }
  })
}

// Is `target` reachable from `start` along orders? Fuel is the edge count, so the walk is bounded.
fn pair_reaches(adj: Map<Int, List<Int>>, frontier: List<Int>, target: Int, fuel: Int) -> Bool {
  if fuel < 0 {
    false
  } else {
    if fold_list(xs: frontier, empty: false, cons: fn(hit, n) { hit || (n == target) }) {
      true
    } else {
      let next = fold_list(xs: frontier, empty: Empty, cons: fn(acc, n) {
        match map_lookup(m: adj, key: n) {
          Present { value: tos } => fold_list(xs: tos, empty: acc, cons: fn(a, t) { list_snoc_item(xs: a, item: t) })
          Absent => acc
        }
      })
      if length(xs: next) == 0 { false } else { pair_reaches(adj: adj, frontier: next, target: target, fuel: fuel - 1) }
    }
  }
}

fn pair_ordered(adj: Map<Int, List<Int>>, a: Int, b: Int, fuel: Int) -> Bool {
  pair_reaches(adj: adj, frontier: list_snoc_item(xs: Empty, item: a), target: b, fuel: fuel)
    || pair_reaches(adj: adj, frontier: list_snoc_item(xs: Empty, item: b), target: a, fuel: fuel)
}

fn pair_exclusive(exclusive: List<OrderEdge>, a: Int, b: Int) -> Bool {
  fold_list(xs: exclusive, empty: false, cons: fn(hit, e) { hit || ((e.from == a) && (e.to == b)) || ((e.from == b) && (e.to == a)) })
}

// The per-body reducer. Cost is per body (sites^2 over reaching sites only), never over a module.
fn body_effect_pairs(facts: BodyEffectFacts) -> BodyPairs {
  let adj = pair_adjacency(edges: facts.orders)
  let fuel = length(xs: facts.orders)
  let seed = BodyPairs { pairs: Empty, exclusive_pairs: Empty }
  fold_list(xs: facts.sites, empty: seed, cons: fn(acc, a) {
    fold_list(xs: facts.sites, empty: acc, cons: fn(inner, b) {
      if a.occurrence < b.occurrence {
        if pair_exclusive(exclusive: facts.exclusive, a: a.occurrence, b: b.occurrence) {
          BodyPairs { pairs: inner.pairs, exclusive_pairs: list_snoc_item(xs: inner.exclusive_pairs, item: ExclusivePairRow { module: facts.module, function: facts.function, first: a, second: b }) }
        } else {
          if pair_ordered(adj: adj, a: a.occurrence, b: b.occurrence, fuel: fuel) {
            inner
          } else {
            BodyPairs { pairs: list_snoc_item(xs: inner.pairs, item: EffectPairRow { module: facts.module, function: facts.function, first: a, second: b, resource_standing: AliasUnknown }), exclusive_pairs: inner.exclusive_pairs }
          }
        }
      } else {
        inner
      }
    })
  })
}

// A value-use relation reduced to the two occurrences a body can join on: the bound value node's and
// the reference's. An endpoint with no occurrence cannot be joined and so orders nothing.
type UseEdge {
  source: Optional<OccurrenceId>
  dependent: Optional<OccurrenceId>
}

fn extract_occurrence_key(o: Optional<OccurrenceId>) -> Optional<Int> {
  match o {
    Present { value: id } => Present { value: id.value }
    Absent => Absent
  }
}

// site-by-occurrence index; a duplicated occurrence is ambiguous and is dropped, never guessed.
fn extract_site_index(sites: List<FactCallSite>) -> Map<Int, Optional<FactCallSite>> {
  fold_list(xs: sites, empty: empty_map(), cons: fn(m, site) {
    match extract_occurrence_key(o: site.occurrence) {
      Absent => m
      Present { value: k } =>
        match map_lookup(m: m, key: k) {
          Present { value: _ } => map_insert(m: m, key: k, value: Absent)
          Absent => map_insert(m: m, key: k, value: Present { value: site })
        }
    }
  })
}

fn extract_site_at(index: Map<Int, Optional<FactCallSite>>, o: Optional<OccurrenceId>) -> Optional<FactCallSite> {
  match extract_occurrence_key(o: o) {
    Absent => Absent
    Present { value: k } =>
      match map_lookup(m: index, key: k) {
        Present { value: slot } => slot
        Absent => Absent
      }
  }
}

// The module's value-use relations indexed once by the DEPENDENT occurrence, so a body joins each
// operand in one lookup rather than scanning every relation.
fn extract_use_index(uses: List<UseEdge>) -> Map<Int, List<Optional<OccurrenceId>>> {
  fold_list(xs: uses, empty: empty_map(), cons: fn(m, u) {
    match extract_occurrence_key(o: u.dependent) {
      Absent => m
      Present { value: k } =>
        match map_lookup(m: m, key: k) {
          Present { value: sources } => map_insert(m: m, key: k, value: list_snoc_item(xs: sources, item: u.source))
          Absent => map_insert(m: m, key: k, value: list_snoc_item(xs: Empty, item: u.source))
        }
    }
  })
}

// ORDER EDGES of one body, keyed by a site's `enter`: (a) an operand that is itself a call orders
// before its consumer; (b) a value-use whose dependent is an operand of the consumer orders the
// site that IS the bound value before the consumer. A bound value that merely CONTAINS a call, or an
// ambiguous endpoint, orders nothing: that direction over-counts.
fn extract_order_edges(sites: List<FactCallSite>, use_index: Map<Int, List<Optional<OccurrenceId>>>) -> List<OrderEdge> {
  let index = extract_site_index(sites: sites)
  fold_list(xs: sites, empty: Empty, cons: fn(acc, consumer) {
    fold_list(xs: consumer.operands, empty: acc, cons: fn(a, operand) {
      let direct = match extract_site_at(index: index, o: operand) {
        Present { value: x } => list_snoc_item(xs: a, item: OrderEdge { from: x.enter, to: consumer.enter })
        Absent => a
      }
      match extract_occurrence_key(o: operand) {
        Absent => direct
        Present { value: k } =>
          match map_lookup(m: use_index, key: k) {
            Absent => direct
            Present { value: sources } =>
              fold_list(xs: sources, empty: direct, cons: fn(b, src) {
                match extract_site_at(index: index, o: src) {
                  Present { value: x } => list_snoc_item(xs: b, item: OrderEdge { from: x.enter, to: consumer.enter })
                  Absent => b
                }
              })
          }
      }
    })
  })
}

// One body with its order edges already derived. The edges are module-local (value use never crosses
// a module), so they are computed in the streaming per-module step and the tree is dropped; the reach
// table needs the WHOLE closure's facts, so reach is applied once at the end.
type BodyOrdered {
  module: QualifiedName
  function: QualifiedName
  sites: List<FactCallSite>
  orders: List<OrderEdge>
  exclusive: List<OrderEdge>
  not_derived: List<NotDerivedKey>
  repeated: List<RepeatedOccurrence>
}

type RepeatedOccurrence {
  occurrence: Int
  source: String
}

// A value-use row the derivation could NOT produce, keyed by the occurrence it was asked about.
// Absent is not independent: a body with a pair carries the rows that touch its own sites.
type NotDerivedKey {
  key: Int
  reason: String
}

// ACTIVATION of one Branch/Match: the first child span is the selector, so every site in it orders before
// every site in an arm; sites in two different arms are alternatives and never both run. Per body,
// bounded by the body's own sites.
fn activation_in_span(s: FactCallSite, span: FactSpan) -> Bool {
  (s.enter >= span.enter) && (s.enter < span.exit)
}

fn activation_arm_sites(sites: List<FactCallSite>, span: FactSpan) -> List<Int> {
  fold_list(xs: sites, empty: Empty, cons: fn(acc, s) { if activation_in_span(s: s, span: span) { list_snoc_item(xs: acc, item: s.enter) } else { acc } })
}

type ActivationEdges {
  orders: List<OrderEdge>
  exclusive: List<OrderEdge>
}

fn activation_edges(sites: List<FactCallSite>, groups: List<FactGroup>) -> ActivationEdges {
  fold_list(xs: groups, empty: ActivationEdges { orders: Empty, exclusive: Empty }, cons: fn(acc, g) {
   match g.repetition {
    Present { value: _ } => acc
    Absent => {
    let spans = fold_list(xs: g.children, empty: Empty, cons: fn(a, sp) { list_snoc_item(xs: a, item: activation_arm_sites(sites: sites, span: sp)) })
    let selector = match list_head(xs: spans) {
      Present { value: x } => x
      Absent => Empty
    }
    let arms = activation_tail(xs: spans)
    let ordered = fold_list(xs: arms, empty: acc.orders, cons: fn(o, arm) {
      fold_list(xs: selector, empty: o, cons: fn(o2, a) { fold_list(xs: arm, empty: o2, cons: fn(o3, b) { list_snoc_item(xs: o3, item: OrderEdge { from: a, to: b }) }) })
    })
    let alt = activation_exclusive(arms: arms, acc: acc.exclusive)
    ActivationEdges { orders: ordered, exclusive: alt }
    }
   }
  })
}

fn activation_tail<T>(xs: List<T>) -> List<T> {
  match list_tail(xs: xs) {
    Present { value: t } => t
    Absent => Empty
  }
}

fn activation_exclusive(arms: List<List<Int>>, acc: List<OrderEdge>) -> List<OrderEdge> {
  match list_head(xs: arms) {
    Absent => acc
    Present { value: arm } =>
      activation_exclusive(arms: activation_tail(xs: arms), acc: fold_list(xs: activation_tail(xs: arms), empty: acc, cons: fn(o, other) {
        fold_list(xs: arm, empty: o, cons: fn(o2, a) { fold_list(xs: other, empty: o2, cons: fn(o3, b) { list_snoc_item(xs: o3, item: OrderEdge { from: a, to: b }) }) })
      }))
  }
}

// The module's not-derived rows indexed once by the occurrence they were asked about, so a body reads
// only the keys its own sites and operands name, never the module's whole row list.
fn not_derived_index(rows: List<NotDerivedKey>) -> Map<Int, List<String>> {
  fold_list(xs: rows, empty: empty_map(), cons: fn(m, r) {
    match map_lookup(m: m, key: r.key) {
      Present { value: seen } => map_insert(m: m, key: r.key, value: list_snoc_item(xs: seen, item: r.reason))
      Absent => map_insert(m: m, key: r.key, value: list_snoc_item(xs: Empty, item: r.reason))
    }
  })
}

fn body_not_derived_at(index: Map<Int, List<String>>, o: Optional<OccurrenceId>, acc: List<NotDerivedKey>) -> List<NotDerivedKey> {
  match extract_occurrence_key(o: o) {
    Absent => acc
    Present { value: k } =>
      match map_lookup(m: index, key: k) {
        Absent => acc
        Present { value: reasons } => fold_list(xs: reasons, empty: acc, cons: fn(a, r) { list_snoc_item(xs: a, item: NotDerivedKey { key: k, reason: r }) })
      }
  }
}

fn body_not_derived(sites: List<FactCallSite>, index: Map<Int, List<String>>) -> List<NotDerivedKey> {
  fold_list(xs: sites, empty: Empty, cons: fn(acc, site) {
    fold_list(xs: site.operands, empty: body_not_derived_at(index: index, o: site.occurrence, acc: acc), cons: fn(a, o) { body_not_derived_at(index: index, o: o, acc: a) })
  })
}

// Occurrences inside a Loop or lambda-template extent run more than once; one entry per (site, source).
fn repeated_occurrences(sites: List<FactCallSite>, groups: List<FactGroup>) -> List<RepeatedOccurrence> {
  fold_list(xs: groups, empty: Empty, cons: fn(acc, g) {
    match g.repetition {
      Absent => acc
      Present { value: source } =>
        fold_list(xs: g.children, empty: acc, cons: fn(a, sp) {
          fold_list(xs: activation_arm_sites(sites: sites, span: sp), empty: a, cons: fn(a2, o) { list_snoc_item(xs: a2, item: RepeatedOccurrence { occurrence: o, source: source }) })
        })
    }
  })
}

fn module_ordered_bodies(module: QualifiedName, bodies: List<FactBodySites>, uses: List<UseEdge>, not_derived: List<NotDerivedKey>) -> List<BodyOrdered> {
  let use_index = extract_use_index(uses: uses)
  let nd_index = not_derived_index(rows: not_derived)
  fold_list(xs: bodies, empty: Empty, cons: fn(acc, body) {
    let act = activation_edges(sites: body.sites, groups: body.groups)
    list_snoc_item(xs: acc, item: BodyOrdered { module: module, function: body.function, sites: body.sites, orders: fold_list(xs: act.orders, empty: extract_order_edges(sites: body.sites, use_index: use_index), cons: fn(a, e) { list_snoc_item(xs: a, item: e) }), exclusive: act.exclusive, not_derived: body_not_derived(sites: body.sites, index: nd_index), repeated: repeated_occurrences(sites: body.sites, groups: body.groups) })
  })
}

// The body's facts under a reach table: only reaching sites are the pair population, but the order
// graph keeps every site so a chain through a pure call still orders its ends.
fn body_effect_facts(body: BodyOrdered, table: EffectReachTable) -> BodyEffectFacts {
  BodyEffectFacts {
    module: body.module,
    function: body.function,
    sites: fold_list(xs: body.sites, empty: Empty, cons: fn(acc, s) {
      match effect_reach_reason(table: table, callee: s.callee) {
        Present { value: r } => list_snoc_item(xs: acc, item: EffectSite { occurrence: s.enter, callee: s.callee, reason: r })
        Absent => acc
      }
    }),
    orders: body.orders,
    exclusive: body.exclusive
  }
}

// ONE MODULE'S result, run at the end over the closure-wide reach table; the caller concatenates modules,
// so no list is searched per body.
type BodyNotDerived {
  module: QualifiedName
  function: QualifiedName
  rows: List<NotDerivedKey>
}

type ModuleEffectPairCensus {
  not_derived: List<BodyNotDerived>
  pairs: List<EffectPairRow>
  exclusive_pairs: List<ExclusivePairRow>
  repeated: List<RepeatedEffectSite>
  totals: ModuleEffectPairTotals
}

// One row per reaching site that sits in a repetition extent: the site runs more than once, so it
// conflicts with its own other iterations, a pair the single-occurrence reducer cannot see.
fn body_repeated_sites(body: BodyOrdered, table: EffectReachTable) -> List<RepeatedEffectSite> {
  let facts = body_effect_facts(body: body, table: table)
  fold_list(xs: body.repeated, empty: Empty, cons: fn(acc, r) {
    fold_list(xs: facts.sites, empty: acc, cons: fn(a, s) {
      if s.occurrence == r.occurrence { list_snoc_item(xs: a, item: RepeatedEffectSite { module: body.module, function: body.function, site: s, repetition_source: r.source }) } else { a }
    })
  })
}

fn effect_pair_census_of_module(module: QualifiedName, bodies: List<BodyOrdered>, table: EffectReachTable) -> ModuleEffectPairCensus {
  let seed = ModuleEffectPairCensus {
    not_derived: Empty,
    pairs: Empty,
    exclusive_pairs: Empty,
    repeated: Empty,
    totals: ModuleEffectPairTotals { module: module, bodies_scanned: 0, bodies_with_pairs: 0, pairs: 0, exclusive_pairs: 0 }
  }
  fold_list(xs: bodies, empty: seed, cons: fn(acc, body) {
    let found = body_effect_pairs(facts: body_effect_facts(body: body, table: table))
    let n = length(xs: found.pairs)
    ModuleEffectPairCensus {
      not_derived: if n > 0 { list_snoc_item(xs: acc.not_derived, item: BodyNotDerived { module: module, function: body.function, rows: body.not_derived }) } else { acc.not_derived },
      pairs: fold_list(xs: found.pairs, empty: acc.pairs, cons: fn(a, p) { list_snoc_item(xs: a, item: p) }),
      exclusive_pairs: fold_list(xs: found.exclusive_pairs, empty: acc.exclusive_pairs, cons: fn(a, p) { list_snoc_item(xs: a, item: p) }),
      repeated: fold_list(xs: body_repeated_sites(body: body, table: table), empty: acc.repeated, cons: fn(a, r) { list_snoc_item(xs: a, item: r) }),
      totals: ModuleEffectPairTotals {
        module: module,
        bodies_scanned: acc.totals.bodies_scanned + 1,
        bodies_with_pairs: acc.totals.bodies_with_pairs + (if n > 0 { 1 } else { 0 }),
        pairs: acc.totals.pairs + n,
        exclusive_pairs: acc.totals.exclusive_pairs + length(xs: found.exclusive_pairs)
      }
    }
  })
}

// WHICH CALLEES REACH AN EFFECT, by reusing D13's reducer unchanged over a TRANSFORMED operation
// table: every operation that reaches becomes RequiresOpaque, so a function's demand is Undecided
// exactly when some call chain from it reaches one, an opaque or undeclared operation, a function
// value or a callee outside the closure. No second call graph.
// An operation reaches when D13 does not declare it RequiresNone, OR when it is RequiresNone but its
// PrimitiveExecutionSemantics (v2.compiler.effect_demand) is ObservesHost, ActuatesHost or Unknown. An
// operation with no semantics row is Unknown and reaches: it is also COUNTED (`unclassified`), because
// treating it as pure would be the under-count D16 forbids and treating it as reaching silently would
// hide how much of the population is unclassified.
type EffectReachTable {
  reasons: Map<QualifiedName, ReachReason>
  known: Map<QualifiedName, Bool>
  unclassified: List<QualifiedName>
}

// The semantics join: operation declaration -> primitive slug (std.primitive_projection roster) ->
// semantics (effect_demand classifications). Both maps are built once per table, never per operation.
type OperationSemanticsIndex {
  slug_of_declaration: Map<String, String>
  semantics_of_slug: Map<String, PrimitiveExecutionSemantics>
}

fn operation_semantics_index() -> OperationSemanticsIndex {
  OperationSemanticsIndex {
    slug_of_declaration: fold_list(xs: primitive_projection_roster(), empty: empty_map(), cons: fn(m, row) {
      map_insert(m: m, key: concat(row.declaration.module_path as String, ".", row.declaration.decl_name as String), value: row.primitive.slug as String)
    }),
    semantics_of_slug: fold_list(xs: effect_demand_operation_classifications, empty: empty_map(), cons: fn(m, c) {
      map_insert(m: m, key: c.operation.slug as String, value: c.semantics)
    })
  }
}

fn operation_semantics(index: OperationSemanticsIndex, path: QualifiedName) -> Optional<PrimitiveExecutionSemantics> {
  match map_lookup(m: index.slug_of_declaration, key: qualified_name_to_dotted_string(qn: path)) {
    Absent => Absent
    Present { value: slug } => map_lookup(m: index.semantics_of_slug, key: slug)
  }
}

fn reach_reason_of_semantics(s: PrimitiveExecutionSemantics) -> Optional<ReachReason> {
  match s {
    Pure => Absent
    ReadsBoundInput { input_identity: _ } => Absent
    ObservesHost { operation_identity: _ } => Present { value: ReachesHostObservation }
    ActuatesHost { operation_identity: _ } => Present { value: ReachesHostActuation }
    ExecutionSemanticsUnknown => Present { value: ReachesExecutionSemanticsUnknown }
  }
}

fn reach_operation_reason(index: OperationSemanticsIndex, op: OperationFact) -> Optional<ReachReason> {
  match op.requirement {
    RequiresNone =>
      match operation_semantics(index: index, path: op.path) {
        Present { value: s } => reach_reason_of_semantics(s: s)
        Absent => Present { value: ReachesExecutionSemanticsUnknown }
      }
    RequiresResources { resources: _ } => Present { value: ReachesDeclaredResource { operation: op.path } }
    RequiresOpaque => Present { value: ReachesOpaqueOperation { operation: op.path } }
    RequiresUndeclared => Present { value: ReachesUndeclaredOperation { operation: op.path } }
  }
}

fn reach_operation_table(index: OperationSemanticsIndex, operations: List<OperationFact>) -> List<OperationFact> {
  fold_list(xs: operations, empty: Empty, cons: fn(acc, op) {
    match reach_operation_reason(index: index, op: op) {
      Absent => list_snoc_item(xs: acc, item: op)
      Present { value: _ } =>
        match op.requirement {
          RequiresOpaque => list_snoc_item(xs: acc, item: op)
          _ => list_snoc_item(xs: acc, item: OperationFact { path: op.path, requirement: RequiresOpaque })
        }
    }
  })
}

fn reach_reason_of_cause(cause: UndecidedCause) -> ReachReason {
  match cause {
    OpaqueOperationCalled { operation: o } => ReachesOpaqueOperation { operation: o }
    UndeclaredOperationCalled { operation: o } => ReachesUndeclaredOperation { operation: o }
    FunctionValueCalled { function: f } => ReachesFunctionValueCall { function: f }
    CalleeOutsideClosure { callee: c } => ReachesUnresolvedCallee { callee: c }
    DemandDidNotSettle { function: f } => ReachesThroughCallee { callee: f }
  }
}

fn effect_reach_table(functions: List<FunctionFact>, operations: List<OperationFact>) -> EffectReachTable {
  let index = operation_semantics_index()
  let rows = dependency_demand_of(functions: functions, operations: reach_operation_table(index: index, operations: operations))
  let from_functions = fold_list(xs: rows, empty: empty_map(), cons: fn(m, r) {
    match r.demand {
      DemandDerived { resources: _ } => m
      DemandUndecided { cause: c } => map_insert(m: m, key: r.function, value: reach_reason_of_cause(cause: c))
    }
  })
  let with_ops = fold_list(xs: operations, empty: from_functions, cons: fn(m, op) {
    match reach_operation_reason(index: index, op: op) {
      Present { value: r } => map_insert(m: m, key: op.path, value: r)
      Absent => m
    }
  })
  let known_fns = fold_list(xs: functions, empty: empty_map(), cons: fn(m, f) { map_insert(m: m, key: f.path, value: true) })
  let known = fold_list(xs: operations, empty: known_fns, cons: fn(m, op) { map_insert(m: m, key: op.path, value: true) })
  let unclassified = fold_list(xs: operations, empty: Empty, cons: fn(acc, op) {
    match operation_semantics(index: index, path: op.path) {
      Present { value: _ } => acc
      Absent => list_snoc_item(xs: acc, item: op.path)
    }
  })
  EffectReachTable { reasons: with_ops, known: known, unclassified: unclassified }
}

// A callee with no fact row at all is outside the closure and reaches by definition.
fn effect_reach_reason(table: EffectReachTable, callee: QualifiedName) -> Optional<ReachReason> {
  match map_lookup(m: table.reasons, key: callee) {
    Present { value: r } => Present { value: r }
    Absent =>
      match map_lookup(m: table.known, key: callee) {
        Present { value: _ } => Absent
        Absent => Present { value: ReachesUnresolvedCallee { callee: callee } }
      }
  }
}

// ---- THE VALUE-USE DERIVATION, REDUCED. One module's relations as occurrence pairs, and its not-derived
// rows keyed by occurrence with a closed word for why (the same coproduct, not text). A Node without an
// occurrence yields an Absent endpoint, which orders nothing.
fn use_edges_of(deps: ValueUseDependencies) -> List<UseEdge> {
  fold_list(xs: deps.relations, empty: Empty, cons: fn(acc, r) {
    list_snoc_item(xs: acc, item: UseEdge { source: node_occurrence_id_optional(node: r.view.source), dependent: node_occurrence_id_optional(node: r.view.dependent) })
  })
}

fn not_derived_word(r: NotDerivedReason) -> String {
  match r {
    NotDerivedStanding { standing: _ } => "binder_standing_has_no_value"
    ValuedUseNotLocated { value: _, why: _ } => "valued_use_not_located"
    ValuedBinderSiteUnkeyed { value: _ } => "valued_binder_site_unkeyed"
    ValuedBinderNotLocated { value: _, why: _ } => "valued_binder_not_located"
    RecordAbsent => "record_absent"
  }
}

fn not_derived_keys_of(deps: ValueUseDependencies) -> List<NotDerivedKey> {
  fold_list(xs: deps.not_derived, empty: Empty, cons: fn(acc, r) {
    list_snoc_item(xs: acc, item: NotDerivedKey { key: r.occurrence.value, reason: not_derived_word(r: r.reason) })
  })
}

// ---- THE UNOBSERVED POPULATION, GROUPED BY ROOT. A module that did not resolve is never a module with
// zero pairs: it is counted here under the first refused file and cause that stranded it (or, when the
// census names none, under its own resolve reason), so one run says how many modules each root strands.
type UnobservedRoot {
  root: String
  cause: String
  modules: Int
  example: QualifiedName
}

fn unobserved_roots_add(roots: List<UnobservedRoot>, root: String, cause: String, module: QualifiedName) -> List<UnobservedRoot> {
  let known = fold_list(xs: roots, empty: false, cons: fn(hit, r) { hit || ((r.root == root) && (r.cause == cause)) })
  if known {
    fold_list(xs: roots, empty: Empty, cons: fn(acc, r) {
      if (r.root == root) && (r.cause == cause) {
        list_snoc_item(xs: acc, item: UnobservedRoot { root: r.root, cause: r.cause, modules: r.modules + 1, example: r.example })
      } else {
        list_snoc_item(xs: acc, item: r)
      }
    })
  } else {
    list_snoc_item(xs: roots, item: UnobservedRoot { root: root, cause: cause, modules: 1, example: module })
  }
}

type EffectPairCensusReport {
  modules: List<ModuleEffectPairCensus>
  roots: List<UnobservedRoot>
  unobserved_modules: Int
  unclassified_operations: Int
  file_refusals: Int
  unreadable_files: Int
}

fn epc_text(parts: List<String>) -> String {
  fold_list(xs: parts, empty: "", cons: fn(acc, p) { concat(acc, p) })
}

fn epc_reason_word(r: ReachReason) -> String {
  match r {
    ReachesHostObservation => "host_observation"
    ReachesHostActuation => "host_actuation"
    ReachesExecutionSemanticsUnknown => "execution_semantics_unknown"
    ReachesDeclaredResource { operation: o } => concat("declared_resource:", qualified_name_to_dotted_string(qn: o))
    ReachesOpaqueOperation { operation: o } => concat("opaque_operation:", qualified_name_to_dotted_string(qn: o))
    ReachesUndeclaredOperation { operation: o } => concat("undeclared_operation:", qualified_name_to_dotted_string(qn: o))
    ReachesFunctionValueCall { function: f } => concat("function_value_call:", qualified_name_to_dotted_string(qn: f))
    ReachesUnresolvedCallee { callee: c } => concat("unresolved_callee:", qualified_name_to_dotted_string(qn: c))
    ReachesThroughCallee { callee: c } => concat("through_callee:", qualified_name_to_dotted_string(qn: c))
  }
}

fn epc_site_text(s: EffectSite) -> String {
  epc_text(parts: [qualified_name_to_dotted_string(qn: s.callee), "@", to_string(s.occurrence), "(", epc_reason_word(r: s.reason), ")"])
}

fn epc_pair_line(p: EffectPairRow) -> String {
  epc_text(parts: [
    "[effect-pair] module=", qualified_name_to_dotted_string(qn: p.module),
    " function=", qualified_name_to_dotted_string(qn: p.function),
    " first=", epc_site_text(s: p.first), " second=", epc_site_text(s: p.second),
    " resource_standing=alias_unknown"
  ])
}

fn epc_not_derived_lines(b: BodyNotDerived) -> List<String> {
  fold_list(xs: b.rows, empty: Empty, cons: fn(acc, r) {
    list_snoc_item(xs: acc, item: epc_text(parts: [
      "[effect-pair-not-derived] module=", qualified_name_to_dotted_string(qn: b.module),
      " function=", qualified_name_to_dotted_string(qn: b.function),
      " occurrence=", to_string(r.key), " reason=", r.reason
    ]))
  })
}

fn epc_totals(r: EffectPairCensusReport) -> ModuleEffectPairTotals {
  fold_list(xs: r.modules, empty: ModuleEffectPairTotals { module: Empty, bodies_scanned: 0, bodies_with_pairs: 0, pairs: 0, exclusive_pairs: 0 }, cons: fn(t, m) {
    ModuleEffectPairTotals {
      module: t.module,
      bodies_scanned: t.bodies_scanned + m.totals.bodies_scanned,
      bodies_with_pairs: t.bodies_with_pairs + m.totals.bodies_with_pairs,
      pairs: t.pairs + m.totals.pairs,
      exclusive_pairs: t.exclusive_pairs + m.totals.exclusive_pairs
    }
  })
}

fn epc_repeated_count(r: EffectPairCensusReport) -> Int {
  fold_list(xs: r.modules, empty: 0, cons: fn(n, m) { n + length(xs: m.repeated) })
}

fn epc_repeated_line(p: RepeatedEffectSite) -> String {
  epc_text(parts: [
    "[effect-pair-repeated] module=", qualified_name_to_dotted_string(qn: p.module),
    " function=", qualified_name_to_dotted_string(qn: p.function),
    " site=", epc_site_text(s: p.site), " repetition_source=", p.repetition_source,
    " resource_standing=alias_unknown"
  ])
}

fn effect_pair_census_lines(r: EffectPairCensusReport) -> List<String> {
  let t = epc_totals(r: r)
  let head = [epc_text(parts: [
    "[effect-pair-census] OVER-COUNTS: resource identity is not modelled (D16 part 3), so every pair of effect-reaching sites with no derived order counts as a possible conflict; absent is not independent.",
    " modules_observed=", to_string(length(xs: r.modules)),
    " modules_unobserved=", to_string(r.unobserved_modules),
    " unclassified_operations=", to_string(r.unclassified_operations),
    " file_refusals=", to_string(r.file_refusals),
    " unreadable_files=", to_string(r.unreadable_files),
    " bodies_scanned=", to_string(t.bodies_scanned),
    " bodies_with_pairs=", to_string(t.bodies_with_pairs),
    " pairs=", to_string(t.pairs),
    " exclusive_pairs=", to_string(t.exclusive_pairs),
    " repeated_sites=", to_string(epc_repeated_count(r: r))
  ])]
  let roots = fold_list(xs: r.roots, empty: head, cons: fn(acc, x) {
    list_snoc_item(xs: acc, item: epc_text(parts: ["[effect-pair-root] root=", x.root, " cause=", x.cause, " modules=", to_string(x.modules), " example=", qualified_name_to_dotted_string(qn: x.example)]))
  })
  fold_list(xs: r.modules, empty: roots, cons: fn(acc, m) {
    let with_pairs = fold_list(xs: m.repeated, empty: fold_list(xs: m.pairs, empty: acc, cons: fn(a, p) { list_snoc_item(xs: a, item: epc_pair_line(p: p)) }), cons: fn(a, p) { list_snoc_item(xs: a, item: epc_repeated_line(p: p)) })
    fold_list(xs: m.not_derived, empty: with_pairs, cons: fn(a, b) {
      fold_list(xs: epc_not_derived_lines(b: b), empty: a, cons: fn(a2, l) { list_snoc_item(xs: a2, item: l) })
    })
  })
}

// Held (0) when the census observed at least one module; no observation (2) when it observed none, so a
// route that strands the whole pool can never exit green. Whether the CONTROLS agree is judged by the
// claim files, not here.
fn effect_pair_census_exit(r: EffectPairCensusReport) -> Int {
  if length(xs: r.modules) > 0 { 0 } else { 2 }
}
