module v2.compiler.build_transport_admission


data build_transport_admission_note: String = "P-B enforcement decision (docs/plans/effect-namespace-grants.md 6, owned silent-ibex-417): whether a build transport may run in the replay/hermetic lane is DERIVED from its own declared structure, not a mode bit. build_transport_admissible projects each declared effect of a HostTransportDescriptor onto a NamespacePosition and runs std.effect_grant.admit_effect against the SINGLE build-envelope authority (v2.compiler.build_workspace_grant.build_workspace_grant_envelope -- consumed, never re-minted, DESIGN 3): a build that would touch anything outside that envelope is a located EffectOutsideGrant, never silently widened (DESIGN 5). This is the .dag half of the seam; the named consumer is the emit-host build transport (src/v2/compiler/emit_host.emit_host_run_transport, a v1_interpreter.rs intrinsic) which today refuses ALL hermetic builds by a blanket is_hermetic() early-return -- it becomes 'run only on an Admitted verdict', with the intrinsic's existing relative-path escape guard staying as the realization-side belt derived from this same containment. The build's reads of its own workspace (emitted sources + produced intermediates) are admitted because the authority grants the workspace Read+Write -- the ownership-implies-read resolution this seam settled. Two containment refinements fold in here: (1) a `..` PATH SEGMENT escapes but a `..` substring inside a filename (foo..bar) does not -- rel_path_is_workspace_contained brackets the path with slashes and matches the `/../` segment, so it no longer false-refuses well-formed names (review 39707); (2) an invocation's declared ARGS are checked too, not just its program -- a WorkspacePath/ProducedArtifact arg reads a workspace-relative position, so an escaping arg path is a located refusal on the same envelope (review 39684), while a LiteralArg carries no path and is the fold identity."

data build_transport_workspace_segment: String = "workspace"
data build_transport_toolchain_segment: String = "toolchain"
data build_transport_closure_segment: String = "closure"

data build_transport_frame: Frame = Frame {
  name: "build-transport",
  kind: SharedStateFrame
}

data build_transport_workspace_root: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: [build_transport_workspace_segment]
}

data build_transport_toolchain_root: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: [build_transport_toolchain_segment]
}

data build_transport_closure_root: NamespacePosition = NamespacePosition {
  tree: FilesystemPathTree,
  path: [build_transport_closure_segment]
}

fn build_transport_envelope() -> Envelope {
  build_workspace_grant_envelope(
    workspace_root: build_transport_workspace_root,
    substrate_closure_root: build_transport_closure_root,
    toolchain_root: build_transport_toolchain_root,
    frame: build_transport_frame
  )
}

fn rel_path_is_workspace_contained(p: RelPath) -> Bool {
  !starts_with(s: p, prefix: "/") && !rel_path_has_parent_segment(p: p)
}

fn build_transport_rel_position(rel: RelPath) -> NamespacePosition {
  if rel_path_is_workspace_contained(p: rel) {
    NamespacePosition {
      tree: FilesystemPathTree,
      path: [build_transport_workspace_segment, rel]
    }
  } else {
    NamespacePosition {
      tree: FilesystemPathTree,
      path: [rel]
    }
  }
}

fn build_transport_toolchain_position(executable: String) -> NamespacePosition {
  NamespacePosition {
    tree: FilesystemPathTree,
    path: [build_transport_toolchain_segment, executable]
  }
}

fn build_program_read_position(program: ProcessProgram) -> NamespacePosition {
  match program {
    HostToolProgram { executable: executable } =>
      build_transport_toolchain_position(executable: executable)
    ProducedProgram { path: path } =>
      build_transport_rel_position(rel: path)
  }
}

fn admission_first_refusal(a: EffectAdmission, b: EffectAdmission) -> EffectAdmission {
  match a {
    EffectOutsideGrant { verb: v, target: t, frame: f } => a
    Admitted { via_root: r } => b
  }
}

fn build_workspace_write_admission(env: Envelope, file: WorkspaceFile) -> EffectAdmission {
  admit_effect(
    env: env,
    verb: Write,
    target: build_transport_rel_position(rel: file.path)
  )
}

fn build_program_read_admission(env: Envelope, invocation: ProcessInvocation) -> EffectAdmission {
  admit_effect(
    env: env,
    verb: Read,
    target: build_program_read_position(program: invocation.program)
  )
}

fn build_invocation_arg_read_admission(env: Envelope, arg: InvocationArg) -> EffectAdmission {
  match arg {
    LiteralArg { text: text } => Admitted { via_root: build_transport_workspace_root }
    WorkspacePath { path: path } =>
      admit_effect(env: env, verb: Read, target: build_transport_rel_position(rel: path))
    ProducedArtifact { path: path } =>
      admit_effect(env: env, verb: Read, target: build_transport_rel_position(rel: path))
  }
}

fn build_invocation_args_read_admission(env: Envelope, invocation: ProcessInvocation) -> EffectAdmission {
  fold(
    invocation.args,
    init: Admitted { via_root: build_transport_workspace_root },
    f: (acc, arg) =>
      admission_first_refusal(a: acc, b: build_invocation_arg_read_admission(env: env, arg: arg))
  )
}

fn build_invocation_admission(env: Envelope, invocation: ProcessInvocation) -> EffectAdmission {
  admission_first_refusal(
    a: build_program_read_admission(env: env, invocation: invocation),
    b: build_invocation_args_read_admission(env: env, invocation: invocation)
  )
}

fn build_transport_admissible(transport: HostTransportDescriptor) -> EffectAdmission {
  let env = build_transport_envelope()
  let writes_admission = fold(
    transport.workspace,
    init: Admitted { via_root: build_transport_workspace_root },
    f: (acc, file) =>
      admission_first_refusal(a: acc, b: build_workspace_write_admission(env: env, file: file))
  )
  let build_admission = fold(
    transport.build,
    init: Admitted { via_root: build_transport_toolchain_root },
    f: (acc, invocation) =>
      admission_first_refusal(a: acc, b: build_invocation_admission(env: env, invocation: invocation))
  )
  let run_admission = build_invocation_admission(env: env, invocation: transport.run)
  admission_first_refusal(
    a: admission_first_refusal(a: writes_admission, b: build_admission),
    b: run_admission
  )
}
