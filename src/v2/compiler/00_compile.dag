// THIS MODULE IS THE COMPILER PIPELINE ENTRY. It carries the fact rather than being recognised
// by name: the emitter selected its entry-point arm by matching "v1.compiler.compile", a
// literal this module could never satisfy, so a crate emitted from this corpus was rendered
// with the no-entry-point refusal main no matter what it contained.
//
// SourceRootEvalDriver, and the difference from both siblings is a fact about what the emitted
// binary is FOR. RetainedHostCliKernel is unrenderable here (a crate emitted from this corpus
// does not contain v1_compiler.cli_run). DirectIngestDriver renders a one-source translate
// probe -- a census instrument for the standalone front door, which cannot resolve a module
// against its real peers and so cannot execute a repository test. SourceRootEvalDriver renders
// the repository test-execution route: the host reads the declared source roots and a universe
// of qualified test identities, and the pipeline assembles the ingest once, prepares each
// module (resolve + infer), and Evals each named test body, one typed verdict row per member.
// The driver functions below are the contract the rendered main calls.

data compiler_pipeline_entry: CompilerEntryDriver = SourceRootEvalDriver

type CoreNode = Node

type RuntimeTarget = Node

type CompileMode
  = TranslateTo { target: TargetModel }
  | Eval { runtime: RuntimeTarget }

type CompileOutput
  = TranslateResult { source: Medium<String> }
  | EvalResult { value: Medium<Node> }

type CompileLensOutcome = Outcome<Witness<Node>>

type CompileLensGate = fn(InferredTree) -> CompileLensOutcome

type CompileLens {
  gate: CompileLensGate
}

type CompileLensMode
  = CompileLensEnforce
  | CompileLensIntrospect

type LensGateWitness {
  witness: Witness<Node>
}

type Validated<T> {
  value: T
  lens_witnesses: List<LensGateWitness>
}

fn compile_pipeline_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^compile_pipeline_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_lens_gate_rejected_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^compile_lens_gate_rejected,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_eval_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^compile_eval_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

data fact_density_lens: CompileLens = CompileLens { gate: fact_density_hollow_alias_compile_gate }

data unit_modeling_lens: CompileLens = CompileLens { gate: unit_modeling_compile_gate }

data lifecycle_carrier_lens: CompileLens = CompileLens { gate: lifecycle_carrier_compile_gate }

fn always_required_lenses() -> List<CompileLens> {
  [fact_density_lens, unit_modeling_lens, lifecycle_carrier_lens]
}

data required_lens_grain_note: String = "Two required-roster grains, one door (validate_then_compile is the single gate authority; per sharp-bee-290 contract 2026-07-13 no second gate surface exists). always_required_lenses runs PER SUBTREE NODE (node-local predicates: fact_density, unit_modeling — each gate reads only the node's direct children; a nested subtree walk inside the gate would stack with run_required_lens_gates_on_subtree's fold_node and be O(n^2)). always_required_root_lenses runs ONCE at the tree root — the grain for rooted whole-tree walks (accumulator-copy carrier threading), where per-node invocation would be O(n^2): the enforcement of the complexity lens must not itself violate the complexity lens (DESIGN 7 self-application). Witness accumulation on the subtree fold uses prepend-then-reverse, not append-in-step. Root-required lenses fire on every validate_then_compile call regardless of caller-supplied lenses, exactly like the subtree roster."

data accumulator_copy_lens: CompileLens = CompileLens { gate: accumulator_copy_root_gate }

data determinism_lens: CompileLens = CompileLens { gate: determinism_root_gate }

data machine_shape_lens: CompileLens = CompileLens { gate: machine_shape_root_gate }
data undecidable_verdict_collapse_lens: CompileLens = CompileLens { gate: undecidable_verdict_collapse_root_gate }

data mandatory_tag_lens: CompileLens = CompileLens { gate: mandatory_tag_root_gate }

// always_required_root_lenses is TREE-GRAIN only: every enrolled gate is a pure fold over the
// InferredTree being compiled (accumulator_copy, determinism, machine_shape, mandatory_tag read
// tree.root and nothing else). lens_module_gate was DE-ENROLLED here (census follow-on to run
// 29892063728 receipts): its compile_gate wrapper discarded the tree argument and ran the nullary
// corpus scan lens_module_gate_blocking_holds - a live walk of src/v2/lens on every compile, making
// every compile-importing entry reach a live-read carrier and putting 31 SubstrateInputsOnly
// witness stamps in the lying_substrate_inputs_only_stamp_census red class. Enforcement is NOT
// reduced: the invariant executes per-PR via its honestly-stamped consumer
// v2.test.claim.enforcement.lens_module_gate_witness (live_tree_disposition: ReadsLiveTree, never
// predict-skips), which reds the floor when registry completeness breaks. A corpus-grain invariant
// enrolls on the corpus cadence with a ReadsLiveTree stamp, never in the per-tree door -
// re-enrolling a nullary gate here re-opens the census class.

fn always_required_root_lenses() -> List<CompileLens> {
  [
    accumulator_copy_lens,
    determinism_lens,
    machine_shape_lens,
    mandatory_tag_lens,
    undecidable_verdict_collapse_lens
  ]
}

fn accumulator_copy_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  accumulator_copy_compile_gate(node: tree.root)
}

fn determinism_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  determinism_compile_gate(node: tree.root)
}

fn machine_shape_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  machine_shape_compile_gate(node: tree.root)
}

fn mandatory_tag_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  mandatory_tag_compile_gate(node: tree.root)
}

fn undecidable_verdict_collapse_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  undecidable_verdict_collapse_compile_gate(node: tree.root)
}

fn fact_density_hollow_alias_compile_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  fact_density_hollow_alias_gate(node: tree.root)
}

fn unit_modeling_compile_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  unit_modeling_gate(node: tree.root)
}

fn lifecycle_carrier_compile_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  lifecycle_carrier_gate(node: tree.root)
}

fn run_compile_lens_gate(lens: CompileLens, inferred: InferredTree) -> Outcome<Witness<Node>> {
  lens.gate(inferred)
}

fn apply_compile_lens_introspect(
  lens: CompileLens,
  inferred: InferredTree
) -> Outcome<Witness<Node>> {
  match run_compile_lens_gate(lens: lens, inferred: inferred) {
    Accepted { value: w, diagnostics: od } =>
      outcome_with_diagnostics(value: w, diagnostics: od)
    Rejected { diagnostics: d } =>
      outcome_with_diagnostics(
        value: witness_violates(diagnostic: d.head),
        diagnostics: Some { diagnostics: d }
      )
  }
}

fn apply_compile_lens(
  lens: CompileLens,
  inferred: InferredTree,
  mode: CompileLensMode
) -> Outcome<Witness<Node>> {
  match mode {
    CompileLensEnforce => run_compile_lens_gate(lens: lens, inferred: inferred)
    CompileLensIntrospect => apply_compile_lens_introspect(lens: lens, inferred: inferred)
  }
}

fn prepend_lens_gate_witness(
  witnesses: List<LensGateWitness>,
  witness: Witness<Node>
) -> List<LensGateWitness> {
  Cons { head: LensGateWitness { witness: witness }, tail: witnesses }
}

fn empty_lens_gate_witnesses() -> List<LensGateWitness> {
  []
}

fn run_required_lens_gates(
  inferred: InferredTree,
  lenses: List<CompileLens>
) -> Outcome<List<LensGateWitness>> {
  bind_outcome(
    o: fold(
      lenses,
      init: outcome_accepted(value: empty_lens_gate_witnesses()),
      f: fn(acc_outcome, lens) {
        match acc_outcome {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: witnesses, diagnostics: od } =>
            bind_outcome_accepted(
              od: od,
              inner: bind_outcome(
                o: apply_compile_lens(lens: lens, inferred: inferred, mode: CompileLensEnforce),
                f: fn(w) {
                  outcome_accepted(
                    value: prepend_lens_gate_witness(
                      witnesses: witnesses,
                      witness: w
                    )
                  )
                }
              )
            )
        }
      }
    ),
    f: fn(collected) { outcome_accepted(value: list_reverse(xs: collected)) }
  )
}

fn run_required_lens_gates_on_subtree(
  inferred: InferredTree,
  lenses: List<CompileLens>
) -> Outcome<List<LensGateWitness>> {
  bind_outcome(
    o: fold_node(
      n: inferred.root,
      algebra: NodeFold {
        init: fn(n0) {
          run_required_lens_gates(
            inferred: InferredTree { root: n0, facts: inferred.facts },
            lenses: lenses
          )
        },
        step: fn(acc, _, child) {
          bind_outcome(o: acc, f: fn(ws) {
            bind_outcome(
              o: child,
              f: fn(child_ws) {
                outcome_accepted(value: list_append(left: child_ws, right: ws))
              }
            )
          })
        }
      }
    ),
    f: fn(collected) { outcome_accepted(value: list_reverse(xs: collected)) }
  )
}

fn compile_inferred_translate(
  inferred: InferredTree,
  target: TargetModel
) -> Outcome<Medium<String>> {
  emit(tree: inferred, target: target)
}

fn compile_inferred(
  inferred: InferredTree,
  mode: CompileMode
) -> Outcome<CompileOutput> {
  match mode {
    TranslateTo { target } =>
      bind_outcome(
        o: compile_inferred_translate(
          inferred: inferred,
          target: target
        ),
        f: fn(target_source) {
          outcome_accepted(TranslateResult { source: target_source })
        }
      )
    Eval { runtime: runtime } =>
      bind_outcome(
        o: eval_node(
          tree: inferred,
          inputs: inputs_root_only(root: runtime)
        ),
        f: fn(value) {
          outcome_accepted(
            EvalResult {
              value: Medium { carried: value, fidelity: Lossless }
            }
          )
        }
      )
  }
}

fn compile(
  source: CoreNode,
  mode: CompileMode
) -> Outcome<CompileOutput> {
  bind_outcome(
    o: infer(tree: source),
    f: fn(inferred) {
      compile_inferred(inferred: inferred, mode: mode)
    }
  )
}

fn validated_from_compile_output(
  output: CompileOutput,
  lens_witnesses: List<LensGateWitness>
) -> Validated<CompileOutput> {
  Validated {
    value: output,
    lens_witnesses: lens_witnesses
  }
}

fn validate_then_compile(
  source: CoreNode,
  lenses: List<CompileLens>,
  mode: CompileMode
) -> Outcome<Validated<CompileOutput>> {
  bind_outcome(
    o: infer(tree: source),
    f: fn(inferred) {
      bind_outcome(
        o: run_required_lens_gates_on_subtree(inferred: inferred, lenses: always_required_lenses()),
        f: fn(required_lens_witnesses) {
          bind_outcome(
            o: run_required_lens_gates(
              inferred: inferred,
              lenses: list_append(left: always_required_root_lenses(), right: lenses)
            ),
            f: fn(caller_lens_witnesses) {
              bind_outcome(
                o: compile_inferred(
                  inferred: inferred,
                  mode: mode
                ),
                f: fn(compile_out) {
                  outcome_accepted(
                    value: validated_from_compile_output(
                      output: compile_out,
                      lens_witnesses: list_append(
                        left: required_lens_witnesses,
                        right: caller_lens_witnesses
                      )
                    )
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn compile_ingest_with_admission(
  source: Medium<String>,
  target: TargetModel,
  peer_roots: FreeMonoid<NormalizedTree>,
  admission: Admission
) -> Outcome<Medium<String>> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          bind_outcome(
            o: normalize(parse_tree: parse_tree),
            f: fn(normalized) {
              let roots = Cons { head: normalized, tail: peer_roots }
              bind_outcome(
                o: resolve_with_admission(
                  lm: lm,
                  roots: roots,
                  admission: admission
                ),
                f: fn(resolved) {
                  bind_outcome(
                    o: validate_then_compile(
                      source: resolved,
                      lenses: [],
                      mode: TranslateTo { target: target }
                    ),
                    f: fn(validated) {
                      match validated.value {
                        TranslateResult { source: target_source } =>
                          outcome_accepted(target_source)
                        EvalResult { value: _ } =>
                          outcome_rejected(
                            compile_eval_not_realized_diagnostic(
                              at: invariant_port_locus(port: ^compile_stage_locus_port, invariant: ^compile_eval_not_realized)
                            )
                          )
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}


// THE ENTRY A COMMAND LINE CAN BE WIRED TO, MODELLED HERE RATHER THAN AUTHORED IN THE EMITTER.
//
// compile_ingest_with_admission is the transaction a compiler driver wants -- source text and a
// target in, emitted text out -- but it takes four arguments whose values are facts about HOW a
// driver is admitting a single standalone source, not facts a command line supplies. Modelling
// that binding here keeps the emitted `main` a thin argv shim: DESIGN section 6 lists a
// hand-authored projection the model should generate as a scaffold tell, and every line of driver
// logic authored as Rust string literals in the emitter is seed that has to shrink later.
//
// ONE SOURCE, NO PEERS, AND THE SUBJECT IS THIS DRIVER'S OWN. peer_roots is Empty because a
// standalone source has no sibling roots admitted alongside it; widening that later is a change to
// this function, not to the emitted main.

fn compile_dag_source_to_target_text(source_text: String) -> Outcome<Medium<String>> {
  compile_ingest_with_admission(
    source: Medium { carried: source_text, fidelity: Lossless },
    target: dag_target_model(),
    peer_roots: Empty,
    admission: Admission {
      subject: ResolutionSubject {
        name: Cons { head: ^compile_driver_subject, tail: Empty }
      },
      imports: Empty
    }
  )
}

fn compile_source_root_ingest_with_admission(
  ingest: SourceRootIngest,
  admission: Admission,
  target: TargetModel
) -> Outcome<Medium<String>> {
  let lm = dag_language_model()
  bind_outcome(
    o: assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm),
    f: fn(resolved) {
      bind_outcome(
        o: validate_then_compile(
          source: resolved,
          lenses: [],
          mode: TranslateTo { target: target }
        ),
        f: fn(validated) {
          match validated.value {
            TranslateResult { source: target_source } =>
              outcome_accepted(target_source)
            EvalResult { value: _ } =>
              outcome_rejected(
                compile_eval_not_realized_diagnostic(
                  at: invariant_port_locus(port: ^compile_stage_locus_port, invariant: ^compile_eval_not_realized)
                )
              )
          }
        }
      )
    }
  )
}

fn stage_tokenize(lm: LanguageModel) -> fn(Medium<String>) -> Outcome<TokenStream> {
  fn(source) {
    tokenize(
      text: source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    )
  }
}

fn stage_parse(lm: LanguageModel) -> fn(TokenStream) -> Outcome<ParseTree> {
  fn(token_stream) { parse(tokens: token_stream, grammar: lm.grammar) }
}

fn stage_normalize() -> fn(ParseTree) -> Outcome<NormalizedTree> {
  fn(parse_tree) { normalize(parse_tree: parse_tree) }
}

fn stage_resolve(lm: LanguageModel) -> fn(NormalizedTree) -> Outcome<ResolvedTree> {
  fn(normalized) { resolve(tree: normalized, lm: lm) }
}

fn resolve_cache_miss(normalized: NormalizedTree) -> CacheProbe<ResolvedTree> {
  Miss
}

fn stage_translate(target: TargetModel) -> fn(ResolvedTree) -> Outcome<Medium<String>> {
  fn(resolved) {
    bind_outcome(
      o: validate_then_compile(
        source: resolved,
        lenses: [],
        mode: TranslateTo { target: target }
      ),
      f: fn(validated) {
        match validated.value {
          TranslateResult { source: target_source } =>
            outcome_accepted(target_source)
          EvalResult { value: _ } =>
            outcome_rejected(
              compile_eval_not_realized_diagnostic(
                at: invariant_port_locus(port: ^compile_stage_locus_port, invariant: ^compile_eval_not_realized)
              )
            )
        }
      }
    )
  }
}

fn compile_ingest_staging(source: Medium<String>, target: TargetModel) -> Outcome<Medium<String>> {
  let lm = dag_language_model()
  let pipeline = then_outcome(
      f: stage_tokenize(lm: lm),
      g: then_outcome(
        f: stage_parse(lm: lm),
        g: then_outcome(
          f: stage_normalize(),
          g: then_outcome(
            f: cached_stage_governed(
              realization: cached_stage_realization(),
              lookup: resolve_cache_miss,
              stage: stage_resolve(lm: lm)
            ),
            g: stage_translate(target: target)
          )
        )
      )
    )
  pipeline(source)
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE SOURCE-ROOT EVAL DRIVER — the terminal route `claim_executor --v2-native-route` executes.
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// THE TERMINAL SUBJECT IS A TEST VERDICT, NOT A TRANSLATION. DirectIngestDriver answers "the
// native compiler accepted this standalone source for translation"; this driver answers "this
// exact test identity, resolved against its real source roots, reached a native Eval verdict".
// The route mirrors the floor's execution mode — locate the named declaration, evaluate its
// body, require a Boolean — with the v2 pipeline's own evaluator standing in for the seed
// interpreter.
//
// THREE FUNCTIONS, ONE PER COST GRAIN. native_test_context_from_ingest pays the whole-ingest
// fold (tokenize/parse/normalize every source) ONCE per lane; it rejects only on a LANE-LEVEL
// defect (a grammar that fails to prepare), never on corpus data. native_test_prepare_module
// pays resolve + infer ONCE per module. native_test_eval_one pays entry resolution +
// evaluation per declaration and NEVER rejects: every failure it can reach is a typed
// NativeTestRefused verdict carrying the stage and the diagnostic's head reason, so a census
// over observations has no silent remainder.
//
// THE PREPARE GRAIN IS TWO HALVES, AND THE SEAM IS THE PORTABILITY BOUNDARY. A seed-interpreted
// witness that drives this route evaluates in the required floor's per-claim frame, and the
// only value that crosses that frame is one the cross-claim pure tier can reify
// (v2.workflow.floor_pure_producer_share): the resolved tree is closure-free, the InferredTree
// one stage up carries the facts PartialFunction and is not — the same share point
// v2.compiler.self_host.direct_rust_door_fixture names for the same reason. So
// native_test_resolve_module and native_test_infer_resolved are the two halves, and
// native_test_prepare_module is their composition: the emitted lane harness keeps calling the
// composition, and a witness fixture shares at the resolved seam.
//
// THE PER-FILE FRONT-END REFUSAL IS CENSUS DATA, NOT A WHOLE-CONTEXT REFUSAL. The program
// assembly fold (v2.compiler.program_assembly) is wholesale fail-closed — one unparseable
// source fails the program — which is the right door for COMPILATION and the wrong shape for
// this census: the v2 front-end has a live corpus frontier (v2.workflow.compile_door_ledger),
// and a wholesale fold would let one frontier file deny verdict rows for every other member —
// the absorbing fallback in ingest form (DESIGN 5: the deficit's frequency reads zero because
// the whole lane is red). So the context fold below collects each source's tokenize/parse/
// normalize refusal as a NativeTestFileRefusal row and keeps folding. Nothing is thereby
// WIDENED: a refused file contributes no root, so its module is absent from the index, every
// test identity living in it surfaces as a Context-stage refusal row minted by the lane host
// from exactly these rows, and a module that PARSED but imports a refused file fails at
// Prepare with the resolver's own diagnostic. The lane's admission still refuses over any
// unattributed row — collection changes the grain of the refusal, never its force.
//
// NO LENS GATES ON THIS ROUTE, deliberately. validate_then_compile's required lenses are the
// COMPILE door's corpus invariants; the floor's seed-interpreter route does not run them per
// test either, and running them here would conflate the modeling door with the execution route
// and multiply their whole-tree cost by the test population.

type NativeTestContext {
  roots: FreeMonoid<NormalizedTree>
  index: SourceRootIndex
  active_roots: FreeMonoid<SourceRootRef>
  file_refusals: FreeMonoid<NativeTestFileRefusal>
}

type NativeTestPreparedModule {
  module: QualifiedName
  inferred: InferredTree
}

type NativeTestContextFoldState {
  roots: FreeMonoid<NormalizedTree>
  index: SourceRootIndex
  file_refusals: FreeMonoid<NativeTestFileRefusal>
}

// The LAST diagnostic is the cause that actually refused the file; the head is the advisory
// that rode along. Both are carried because ownership is keyed by grain.
fn native_test_fatal_reason(d: NonEmptyDiagnostics) -> Symbol {
  fold_list(xs: d.tail, empty: d.head.reason, cons: fn(_acc, diag) { diag.reason })
}

fn native_test_file_refusal(path: Symbol, d: NonEmptyDiagnostics) -> NativeTestFileRefusal {
  NativeTestFileRefusal {
    path: path,
    head_reason: d.head.reason,
    fatal_reason: native_test_fatal_reason(d: d)
  }
}

fn native_test_context_fold_step(
  state: NativeTestContextFoldState,
  read: DagSourceReadWitness,
  lm: LanguageModel,
  prepared: PreparedGrammar,
  residue: Diagnostics
) -> NativeTestContextFoldState {
  match program_assembly_read_to_normalized_root_prepared(read: read, lm: lm, prepared: prepared, residue: residue) {
    Rejected { diagnostics: d } =>
      NativeTestContextFoldState {
        roots: state.roots,
        index: state.index,
        file_refusals: list_snoc_item(
          xs: state.file_refusals,
          item: native_test_file_refusal(path: read.compilation_unit, d: d)
        )
      }
    Accepted { value: root, diagnostics: _ } =>
      match qualified_name_from_module_node(root: root.root) {
        Rejected { diagnostics: d } =>
          NativeTestContextFoldState {
            roots: state.roots,
            index: state.index,
            file_refusals: list_snoc_item(
              xs: state.file_refusals,
              item: native_test_file_refusal(path: read.compilation_unit, d: d)
            )
          }
        Accepted { value: qn, diagnostics: _ } =>
          NativeTestContextFoldState {
            roots: list_snoc_item(xs: state.roots, item: root),
            index: source_root_index_insert(index: state.index, module: qn, root: read.source_root),
            file_refusals: state.file_refusals
          }
      }
  }
}

// One language model for the whole fold: dag_language_model() rebuilds the grammar, lex rules
// and canonical-symbol set on every call, and calling it inside the cons closure paid that
// once PER FILE — measured at ~0.3s/file of the context fold's wall time (2026-09-09,
// v2-native route work), a pure recompute with no per-file dependency.
fn native_test_context_from_ingest(ingest: SourceRootIngest) -> Outcome<NativeTestContext> {
  let lm = dag_language_model()
  match prepare_grammar(grammar: lm.grammar) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prepared, diagnostics: residue } => {
      let folded = fold_list(
        xs: ingest,
        empty: NativeTestContextFoldState {
          roots: Empty,
          index: source_root_index_empty(),
          file_refusals: Empty
        },
        cons: fn(state, read) {
          native_test_context_fold_step(
            state: state,
            read: read,
            lm: lm,
            prepared: prepared,
            residue: residue
          )
        }
      )
      outcome_accepted(value: NativeTestContext {
        roots: folded.roots,
        index: folded.index,
        active_roots: source_root_set_from_ingest(ingest: ingest),
        file_refusals: folded.file_refusals
      })
    }
  }
}

fn native_test_resolve_module(
  context: NativeTestContext,
  module: QualifiedName
) -> Outcome<ResolvedTree> {
  resolve_with_admission_grounded(
    lm: dag_language_model(),
    roots: context.roots,
    admission: Admission {
      subject: ResolutionSubject { name: module },
      imports: Empty
    },
    index: context.index,
    active_roots: context.active_roots
  )
}

fn native_test_infer_resolved(
  module: QualifiedName,
  resolved: ResolvedTree
) -> Outcome<NativeTestPreparedModule> {
  bind_outcome(
    o: infer(tree: resolved),
    f: fn(inferred) {
      outcome_accepted(value: NativeTestPreparedModule {
        module: module,
        inferred: inferred
      })
    }
  )
}

fn native_test_prepare_module(
  context: NativeTestContext,
  module: QualifiedName
) -> Outcome<NativeTestPreparedModule> {
  bind_outcome(
    o: native_test_resolve_module(context: context, module: module),
    f: fn(resolved) { native_test_infer_resolved(module: module, resolved: resolved) }
  )
}

// THE DECLARATION SEARCH IS EXACT: a test identity names a top-level declaration of one prepared
// module, so the search first resolves that module's scope node — unwrapping the module
// production wrapper through the namespace-graft authority, then walking one Named spine edge per
// qualified-name segment — and then matches DIRECT CHILDREN of the scope only. Descending into
// nested Named edges could select a same-named graft segment or an edge nested inside a
// declaration body and evaluate it under the requested identity. A scope walk that fails is a
// graft-shape surprise and surfaces as its own entry reason, deliberately absent from
// native_route_entry_limit_reasons so the surprise reds the lane instead of excluding tests.

fn native_test_module_scope_go(at: Node, segments: QualifiedName) -> Outcome<Node> {
  match segments {
    Empty => outcome_accepted(value: at)
    Cons { head: segment, tail: rest } =>
      bind_outcome(
        o: find_named_child(root: at, name: segment),
        f: fn(child) { native_test_module_scope_go(at: child, segments: rest) }
      )
  }
}

fn native_test_module_scope_node(root: Node, module: QualifiedName) -> Outcome<Node> {
  native_test_module_scope_go(
    at: namespace_graft_unwrap_module_working_root(root: root),
    segments: module
  )
}

fn native_test_decl_in_children(children: List<Edge>, name: Symbol) -> Optional<Node> {
  fold(children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: v } => optional_present(value: v)
      Absent =>
        match e.label {
          Named { name: edge_name } =>
            if edge_name == name {
              optional_present(value: e.target)
            } else {
              optional_absent()
            }
          Positional => optional_absent()
        }
    }
  })
}

fn native_test_observation_refused(
  module: QualifiedName,
  declaration: Symbol,
  stage: NativeTestStage,
  reason: Symbol
) -> NativeTestObservation {
  NativeTestObservation {
    module: module,
    declaration: declaration,
    verdict: NativeTestRefused { stage: stage, reason: reason }
  }
}

fn native_test_eval_body(
  prepared: NativeTestPreparedModule,
  declaration: Symbol,
  body: Node
) -> NativeTestObservation {
  match eval(
    tree: prepared.inferred,
    interpretation: eval_default_interpretation(),
    inputs: inputs_root_only(root: body)
  ) {
    Rejected { diagnostics: d } =>
      native_test_observation_refused(
        module: prepared.module,
        declaration: declaration,
        stage: NativeTestStageEval,
        reason: native_test_fatal_reason(d: d)
      )
    Accepted { value: rv, diagnostics: _ } =>
      if v2_eval_runtime_bool_is_true(value: rv) {
        NativeTestObservation {
          module: prepared.module,
          declaration: declaration,
          verdict: NativeTestPassed
        }
      } else if v2_eval_runtime_bool_is_false(value: rv) {
        NativeTestObservation {
          module: prepared.module,
          declaration: declaration,
          verdict: NativeTestReturnedFalse
        }
      } else {
        NativeTestObservation {
          module: prepared.module,
          declaration: declaration,
          verdict: NativeTestReturnedOther
        }
      }
  }
}

fn native_test_eval_one(
  prepared: NativeTestPreparedModule,
  declaration: Symbol
) -> NativeTestObservation {
  match native_test_module_scope_node(root: prepared.inferred.root, module: prepared.module) {
    Rejected { diagnostics: _ } =>
      native_test_observation_refused(
        module: prepared.module,
        declaration: declaration,
        stage: NativeTestStageEntry,
        reason: ^native_test_entry_module_scope_unresolved
      )
    Accepted { value: scope, diagnostics: _ } =>
      match native_test_decl_in_children(children: scope.children, name: declaration) {
        Absent =>
          native_test_observation_refused(
            module: prepared.module,
            declaration: declaration,
            stage: NativeTestStageEntry,
            reason: ^native_test_entry_declaration_not_found
          )
        Present { value: target } =>
          match target.kind {
            TypeNode { connective: Arrow } =>
              match find_arrow_body_child(root: target) {
                Rejected { diagnostics: d } =>
                  native_test_observation_refused(
                    module: prepared.module,
                    declaration: declaration,
                    stage: NativeTestStageEntry,
                    reason: native_test_fatal_reason(d: d)
                  )
                Accepted { value: body, diagnostics: _ } =>
                  native_test_eval_body(
                    prepared: prepared,
                    declaration: declaration,
                    body: body
                  )
              }
            _ =>
              native_test_observation_refused(
                module: prepared.module,
                declaration: declaration,
                stage: NativeTestStageEntry,
                reason: ^native_test_entry_declaration_not_arrow
              )
          }
      }
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE LANE'S OWN ADJUDICATION — DERIVED UNIVERSE, OBSERVED POPULATION, JUDGED RECEIPT.
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// WHAT MOVED HERE, AND WHAT THE ROUTE THEREFORE CLAIMS. The claim is NATIVE UNIVERSE DERIVATION,
// NATIVE EVALUATION, NATIVE RECEIPT CONSTRUCTION AND NATIVE ADMISSION over a SEED-PREPARED COMPILER
// ARTIFACT — not an interpreter-free process end to end, which would be false while the v1 process
// emits the compiler this fold runs inside (operator design review 2026-09-11). What moved is every
// SEMANTIC decision; what remains in v1 is the preparation of the artifact, named rather than
// counted as absent, and owned by the native ancestry acquisition lane. Until this section existed the lane was
// interpreter-bracketed on both ends: the seed folded the floor's discovery producer over every
// source through the v1 interpreter to derive the universe (~4 minutes interpreted), and then
// evaluated native_route_admission through the interpreter to judge the receipt — so the lane
// that exists to prove a pristine v2 process could not run without the v1 interpreter at all.
// Both brackets are folds this module can reach natively, so they are declared here and
// COMPILED; the seed's remaining job is emit + cargo, and every semantic decision the lane makes
// is executed by the binary the route is about (operator ruling 2026-09-10). The route is invoked
// by an operator rather than by a required job since #11003 deleted that job; what it proves about
// the route is unchanged by where it is invoked from.
//
// THE JOIN IS NOT MADE TAUTOLOGICAL BY THE MOVE. The driver's earlier contract note — a binary
// that discovered its own population would make the host-side join tautological — was about a
// join between two PROCESSES. The join admission actually performs is between the DISCOVERY
// authority's answer (what the corpus declares a test, read textually per source) and the
// EXECUTION route's answer (what reached a verdict through the whole front end): two independent
// folds over two different readings of the same bytes. A universe member with no observation row
// is still an omission and a row with no member is still foreign; what the move removes is the
// process boundary between them, which was never what made the join discriminating.

// The lane's own refusal carrier. A refusal reaching here is a LANE-level defect (the corpus
// refused discovery outright), so it stops the line rather than shrinking the universe; the
// producer's own reason text is interned as the second diagnostic so the refusal that the
// process prints names what discovery actually said, not merely that it said something.
fn native_lane_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: invariant_port_locus(port: ^compile_stage_locus_port, invariant: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn native_lane_refused<T>(reason: Symbol, detail: String) -> Outcome<T> {
  Rejected {
    diagnostics: NonEmptyDiagnostics {
      head: native_lane_diagnostic(reason: reason),
      tail: [native_lane_diagnostic(reason: symbol_intern_lexeme(lexeme: detail))]
    }
  }
}

// THE MODULE→PATH RELATION IS READ FROM THE HEADER TEXT, NOT FROM THE PARSE, and that is the
// point rather than an approximation: a source whose front end refused carries no normalized root
// and no qualified name, so a parse-derived relation would silently drop exactly the files whose
// test identities must surface as Context-stage refusals — the population would shrink instead of
// refusing. The seed answered this same question at this same grain (cli_run's module index) and
// is deleted with the interpreted derivation; this is that fact's `.dag` home. One consumer, per
// the facts-before-abstraction discipline: promote it when a second inhabits it.
fn native_lane_declared_module_name(content: String) -> String {
  fold(
    split(s: content, delimiter: "\n"),
    init: "",
    f: fn(acc, line) {
      if acc != "" {
        acc
      } else {
        let trimmed = trim(line)
        if starts_with(s: trimmed, prefix: "module ") {
          trim(substring(s: trimmed, start: 7, end: string_length(s: trimmed)))
        } else {
          ""
        }
      }
    }
  )
}

// ONE SOURCE, READ ONCE, IN BOTH DIRECTIONS. The discovery producer's per-file authority and the
// module header are answered in the SAME pass, so the universe never needs a path → module join
// afterwards: the row and the module that owns it are minted together. The seed paid that join as
// a hash lookup per row; a fold-based lookup here would be quadratic over the whole inventory,
// which the standing bare-minimum-cost ruling prices as a defect at any realized n.
// THE IMPORT EDGES ARE READ FROM THE SAME TEXT, FOR THE SAME REASON. The route must know which
// sources the universe's modules transitively need BEFORE it pays a front end on any of them, so
// the edge cannot come from a parse without paying the cost the closure exists to avoid. This is
// the module-header scan's sibling and carries its shape: one line, one edge, no interpretation
// beyond the qualified name. It is deliberately CONSERVATIVE about nothing — a line that begins
// with `import ` names exactly one module, and a file that spells a dependency any other way is a
// closure miss that surfaces as a located resolve refusal inside the route rather than as a silent
// narrowing, because the module it needed was never ingested and the resolver says so by name.
// NEXT-RUNG TRIGGER: the closure is computed from the front end's own import edges after a cheap
// parse of the seed set, at which point this scan deletes rather than being kept beside it.
fn native_lane_declared_imports(content: String) -> List<String> {
  fold(
    split(s: content, delimiter: "\n"),
    init: [],
    f: fn(acc, line) {
      let trimmed = trim(line)
      if starts_with(s: trimmed, prefix: "import ") {
        let rest = trim(substring(s: trimmed, start: 7, end: string_length(s: trimmed)))
        let name = floor_discovery_first_token_before_space(seg: rest)
        if name == "" { acc } else { list_snoc_item(xs: acc, item: name) }
      } else {
        acc
      }
    }
  )
}

type NativeLaneSourceFacts {
  module: String
  path: Symbol
  imports: List<String>
  discovery: FloorDiscoveryWalkState
}

fn native_lane_source_facts(ingest: SourceRootIngest) -> List<NativeLaneSourceFacts> {
  fold_list(
    xs: ingest,
    empty: [],
    cons: fn(acc, read) {
      list_snoc_item(xs: acc, item: NativeLaneSourceFacts {
        module: native_lane_declared_module_name(content: read.source.carried),
        path: read.compilation_unit,
        imports: native_lane_declared_imports(content: read.source.carried),
        discovery: discover_floor_rows_for_source(
          repo_path: symbol_lexeme(sym: read.compilation_unit),
          content: read.source.carried
        )
      })
    }
  )
}

// ONE UNIVERSE MEMBER'S MODULE: the identities discovery enrolled for it, and the path they were
// read from. Declarations stay grouped by module because prepare (resolve + infer) is paid once
// per module and every declaration of a module shares its outcome.
type NativeLaneUniverseModule {
  module: String
  path: Symbol
  declarations: List<String>
}

type NativeLaneUniverse {
  modules: List<NativeLaneUniverseModule>
  identities: List<NativeRouteTestIdentity>
  module_sources: List<NativeRouteModuleSource>
}

fn native_lane_universe_module_for_source(facts: NativeLaneSourceFacts) -> List<NativeLaneUniverseModule> {
  if native_route_universe_member(module_qn: facts.module) {
    let declarations = fold_list(
      xs: facts.discovery.rows,
      empty: [],
      cons: fn(acc, row) { list_snoc_item(xs: acc, item: row.function) }
    )
    if length(xs: declarations) == 0 {
      []
    } else {
      [NativeLaneUniverseModule {
        module: facts.module,
        path: facts.path,
        declarations: declarations
      }]
    }
  } else {
    []
  }
}

// THE DERIVATION IS THE FLOOR'S OWN PRODUCER, FINALIZED THE FLOOR'S OWN WAY. The per-source
// states are handed to floor_discovery_finalize_source_outcomes untouched — so a walk failure, a
// disposition refusal or a sidecar violation ANYWHERE in the inventory refuses the derivation
// exactly as it refuses the required floor's — and only then are the universe-prefixed modules
// kept. Filtering first and finalizing the remainder would have made the lane blind to a sidecar
// violation outside `v2.test.*`, which is a corpus refusal, not a lane exclusion.
// A SOURCE THAT ENROLS ROWS AND DECLARES NO MODULE IS A REFUSAL, NOT A DROP. Discovery reads the
// path and the bytes, so it can enrol test identities for a file whose own header names no module
// — and such an identity cannot be routed, because the driver resolves by module. The seed refused
// this state by name (UniverseEntryOutsideSubject) when its module index did not hold a row's
// entry; keeping the refusal is what stops the derivation from quietly shrinking the universe.
fn native_lane_unowned_row_path(facts: List<NativeLaneSourceFacts>) -> String {
  fold_list(
    xs: facts,
    empty: "",
    cons: fn(acc, f) {
      if acc != "" {
        acc
      } else if (f.module == "") && (length(xs: f.discovery.rows) > 0) {
        symbol_lexeme(sym: f.path)
      } else {
        ""
      }
    }
  )
}

fn native_lane_universe(ingest: SourceRootIngest) -> Outcome<NativeLaneUniverse> {
  let facts = native_lane_source_facts(ingest: ingest)
  let unowned = native_lane_unowned_row_path(facts: facts)
  if unowned != "" {
    return native_lane_refused(
      reason: ^native_lane_universe_entry_outside_subject,
      detail: unowned
    )
  }
  match floor_discovery_finalize_source_outcomes(
    outcomes: fold_list(xs: facts, empty: [], cons: fn(acc, f) { list_snoc_item(xs: acc, item: f.discovery) })
  ) {
    FloorDiscoveryRefused { reason: reason } =>
      native_lane_refused(reason: ^native_lane_universe_derivation_refused, detail: reason)
    FloorDiscoveryAccepted { rows: _ } => {
      let modules = fold_list(
        xs: facts,
        empty: [],
        cons: fn(acc, f) {
          fold_list(
            xs: native_lane_universe_module_for_source(facts: f),
            empty: acc,
            cons: fn(inner, m) { list_snoc_item(xs: inner, item: m) }
          )
        }
      )
      outcome_accepted(value: NativeLaneUniverse {
        modules: modules,
        identities: fold_list(
          xs: modules,
          empty: [],
          cons: fn(acc, m) {
            fold_list(
              xs: m.declarations,
              empty: acc,
              cons: fn(inner, d) {
                list_snoc_item(xs: inner, item: NativeRouteTestIdentity { module: m.module, declaration: d })
              }
            )
          }
        ),
        module_sources: fold_list(
          xs: modules,
          empty: [],
          cons: fn(acc, m) {
            list_snoc_item(xs: acc, item: NativeRouteModuleSource { module: m.module, path: m.path })
          }
        )
      })
    }
  }
}

// ── the closure the route actually ingests ─────────────────────────────────────────────────
//
// THE ROUTE INGESTS THE UNIVERSE'S IMPORT CLOSURE, NEVER THE CORPUS (operator ruling 2026-09-11,
// on a measurement: the emitted binary given a TWO-row universe ran 64 minutes single-threaded and
// folded 2909 file refusals, because it tokenized, parsed and normalized all 5433 corpus sources
// before evaluating anything — a fixed cost independent of the population it was asked about).
// DESIGN section 2: minimize the demand graph before materializing its answers. A file that no
// universe module transitively imports is not read into the front end, is not folded, and its
// refusal is NOT a row in this receipt.
//
// THAT IS A NARROWING OF THE SUBJECT, AND IT IS STATED RATHER THAN SLID IN. The corpus-wide
// front-end histogram is a different subject with a different consumer, and it keeps its producer:
// the census mode, which ingests everything and reports every per-file refusal. The adjudication
// receipt's file_refusals now mean "refusals among the sources this population needed", which is
// exactly what the Context-stage classification joins against — a refusal outside the closure
// could never have explained a member's verdict, so carrying it here was never evidence.
// Membership over module names. `contains` takes the equality it uses rather than assuming one, so
// the name comparison is supplied here once instead of at each of the three call sites.
fn native_lane_module_named(xs: List<String>, name: String) -> Bool {
  contains(xs: xs, item: name, eq: fn(a, b) { a == b })
}

// THE WALK'S BUDGET IS A REFUSAL, NEVER A TRUNCATION (review 63719, DESIGN section 5). The
// reachable set decides what the front end is given, so a walk that stopped early and answered
// with what it had seen would hand the route a narrowed ingest whose missing modules surface only
// as unexplained resolve refusals downstream — the absorbing arm in its narrowing form. Exhaustion
// therefore refuses the whole universe derivation, and the refusal carries what a reader needs to
// decide whether the budget or the graph is wrong: the budget, the frontier still unexpanded, and
// the first module on it. The budget is rounds of breadth-first expansion, so it bounds import
// DEPTH, not closure size; a closure finishing on exactly its last round is accepted, because the
// empty-frontier arm is asked before the budget arm. The value is a POLICY budget, not a
// measurement of today's corpus: an acyclic import graph of N modules is at most N rounds deep, so
// any budget is a statement of how deep a chain the route agrees to pay for before asking whether
// the graph is wrong, and a real chain that deep is itself the finding. Its RED and its boundary
// are enrolled in v2.test.v2_native_route.
data native_lane_closure_round_budget: Int = 512

fn native_lane_closure_exhausted_detail(budget: Int, frontier: List<String>) -> String {
  let first = match frontier {
    Empty => ""
    Cons { head: h, tail: _ } => h
  }
  concat(
    "import-closure walk exhausted its budget of ",
    integer_int_to_decimal_string(value: budget),
    " rounds with ",
    integer_int_to_decimal_string(value: length(xs: frontier)),
    " module(s) still unexpanded, first: ",
    first
  )
}

fn native_lane_module_reachable(
  facts: List<NativeLaneSourceFacts>,
  frontier: List<String>,
  seen: List<String>,
  fuel: Int,
  budget: Int
) -> Outcome<List<String>> {
  if is_empty(xs: frontier) {
    outcome_accepted(value: seen)
  } else if fuel <= 0 {
    native_lane_refused(
      reason: ^native_lane_closure_budget_exhausted,
      detail: native_lane_closure_exhausted_detail(budget: budget, frontier: frontier)
    )
  } else {
    let next = fold_list(
      xs: frontier,
      empty: [],
      cons: fn(acc, needed) {
        fold_list(
          xs: facts,
          empty: acc,
          cons: fn(inner, f) {
            if f.module == needed {
              fold_list(
                xs: f.imports,
                empty: inner,
                cons: fn(grown, imported) { list_snoc_item(xs: grown, item: imported) }
              )
            } else {
              inner
            }
          }
        )
      }
    )
    let unseen = fold_list(
      xs: next,
      empty: [],
      cons: fn(acc, candidate) {
        if native_lane_module_named(xs: seen, name: candidate) || native_lane_module_named(xs: acc, name: candidate) {
          acc
        } else {
          list_snoc_item(xs: acc, item: candidate)
        }
      }
    )
    native_lane_module_reachable(
      facts: facts,
      frontier: unseen,
      seen: fold_list(
        xs: unseen,
        empty: seen,
        cons: fn(acc, m) { list_snoc_item(xs: acc, item: m) }
      ),
      fuel: fuel - 1,
      budget: budget
    )
  }
}

// The seed set is every universe module plus the module the authority's live-verdict controls live
// in: the controls are executed by this route, so their own closure is part of what it needs.
fn native_lane_closure_seed_modules(universe: NativeLaneUniverse) -> List<String> {
  list_snoc_item(
    xs: fold_list(
      xs: universe.modules,
      empty: [],
      cons: fn(acc, m) { list_snoc_item(xs: acc, item: m.module) }
    ),
    item: native_route_live_control_module
  )
}

fn native_lane_closure_modules(
  facts: List<NativeLaneSourceFacts>,
  universe: NativeLaneUniverse,
  budget: Int
) -> Outcome<List<String>> {
  let seeds = native_lane_closure_seed_modules(universe: universe)
  native_lane_module_reachable(facts: facts, frontier: seeds, seen: seeds, fuel: budget, budget: budget)
}

// The ingest restricted to that closure, in the order the reads arrived. A source whose header
// declares no module is not in any closure by construction: nothing can import it.
fn native_lane_closure_ingest(
  ingest: SourceRootIngest,
  closure: List<String>
) -> SourceRootIngest {
  fold_list(
    xs: ingest,
    empty: Empty,
    cons: fn(acc, read) {
      let declared = native_lane_declared_module_name(content: read.source.carried)
      if (declared != "") && native_lane_module_named(xs: closure, name: declared) {
        list_snoc_item(xs: acc, item: read)
      } else {
        acc
      }
    }
  )
}

// THE INGEST RECEIPT IS THE ACCEPTANCE SURFACE FOR THE CLOSURE, and it exists because a faster
// clock is not evidence (operator ruling 2026-09-11): a hidden whole-corpus prepass survives a
// timer improvement, and only a POPULATION with a discriminating RED catches it.
//
// TWO POPULATIONS, NAMED SEPARATELY BECAUSE THEY COST DIFFERENT THINGS. `scanned` is what the route
// OPENED for textual discovery — the corpus, because discovery is a floor authority whose subject
// is the corpus and a `test`-marked declaration outside a sidecar must still be found. `ingested`
// is what it TOKENIZED, PARSED AND FOLDED, and the acceptance is an identity join on that one: it
// equals the transitive import closure of the universe's modules plus the controls' module,
// exactly. The RED is a module OUTSIDE that closure, malformed or expensive, whose edits change
// neither a verdict nor `ingested` — and which never appears in a refusal row, because it is never
// tokenized.
//
// TWO OBLIGATIONS THIS SHAPE OWES, recorded so they are not lost to the fact that it currently
// works. FIRST: the universe is one of the artifact forms the provider spine will key by corpus
// content, so `native_lane_universe` is written as its PRODUCER and not as an inline step the route
// must always pay — when that spine lands, the scan becomes a miss-path cost and a hit reads
// nothing. SECOND: the textual reads here are a REALIZATION of the discovery authority, never a
// second authority, so they owe a witness joining this route's universe against the discovery
// producer's own population at identity grain on the same tree. That witness is the wall and it is
// NOT yet built; until it is, the same-universe property is diligence rather than a check.
type NativeLaneIngestReceipt {
  closure_modules: List<String>
  ingested_paths: List<String>
  scanned_paths: List<String>
}

fn native_lane_ingest_receipt(
  facts: List<NativeLaneSourceFacts>,
  closure: List<String>,
  ingest: SourceRootIngest
) -> NativeLaneIngestReceipt {
  NativeLaneIngestReceipt {
    closure_modules: closure,
    ingested_paths: fold_list(
      xs: ingest,
      empty: [],
      cons: fn(acc, read) { list_snoc_item(xs: acc, item: symbol_lexeme(sym: read.compilation_unit)) }
    ),
    scanned_paths: fold_list(
      xs: facts,
      empty: [],
      cons: fn(acc, f) { list_snoc_item(xs: acc, item: symbol_lexeme(sym: f.path)) }
    )
  }
}

// THE JOIN THE ACCEPTANCE ASKS FOR, ASKED BY THE ROUTE ITSELF rather than by a reader comparing two
// logs: every ingested source's declared module is in the closure, and every closure module that
// any source declares was ingested. A source whose header declares no module cannot be in a closure
// and cannot be reached by an import, so its presence in the ingest would be exactly the hidden
// prepass this check exists to refuse.
fn native_lane_ingest_matches_closure(
  facts: List<NativeLaneSourceFacts>,
  receipt: NativeLaneIngestReceipt,
  ingest: SourceRootIngest
) -> Bool {
  let every_ingested_in_closure = fold_list(
    xs: ingest,
    empty: true,
    cons: fn(acc, read) {
      let declared = native_lane_declared_module_name(content: read.source.carried)
      acc && (declared != "") && native_lane_module_named(xs: receipt.closure_modules, name: declared)
    }
  )
  let ingested_modules = fold_list(
    xs: ingest,
    empty: [],
    cons: fn(acc, read) {
      list_snoc_item(xs: acc, item: native_lane_declared_module_name(content: read.source.carried))
    }
  )
  let every_declared_closure_module_ingested = fold_list(
    xs: facts,
    empty: true,
    cons: fn(acc, f) {
      if native_lane_module_named(xs: receipt.closure_modules, name: f.module) {
        acc && native_lane_module_named(xs: ingested_modules, name: f.module)
      } else {
        acc
      }
    }
  )
  every_ingested_in_closure && every_declared_closure_module_ingested
}

// ── the observed population ────────────────────────────────────────────────────────────────
//
// THE PREPARE-REFUSAL FAN-OUT AND THE CONTEXT RECLASSIFICATION ARE ONE FOLD, HERE. Both used to
// live outside the route: the fan-out in the emitted main's rendered Rust, the reclassification
// in the seed's harness. They are the same per-module decision — what verdict every declaration
// of a module gets when the module never reached evaluation — and splitting them across two
// hosts is what let the seed's join query the relation off-key and silently never reclassify.
// A module whose own file the context fold refused gets Context-stage rows carrying THAT FILE'S
// fatal reason; a module whose file loaded but failed resolve/infer gets Prepare-stage rows
// carrying the resolver's own fatal reason. Every declaration gets exactly one row either way,
// so the population has no silent remainder to explain.

fn native_lane_file_refusal_for_path(refusals: FreeMonoid<NativeTestFileRefusal>, path: Symbol) -> Optional<NativeTestFileRefusal> {
  fold_list(
    xs: refusals,
    empty: optional_absent(),
    cons: fn(acc, fr) {
      match acc {
        Present { value: _ } => acc
        Absent => if fr.path == path { optional_present(value: fr) } else { optional_absent() }
      }
    }
  )
}

fn native_lane_member_row(module: String, declaration: String, verdict: NativeTestVerdict) -> NativeRouteMemberRow {
  NativeRouteMemberRow {
    identity: NativeRouteTestIdentity { module: module, declaration: declaration },
    verdict: verdict
  }
}

// WHAT THE POPULATION↔UNIVERSE JOIN STILL DISCRIMINATES, STATED RATHER THAN ASSUMED. Every
// universe member gets exactly one row, so admission's omission and foreign-row clauses cannot fire
// from in-process drift the way they could when a second process echoed a universe file back. That
// is a rung statement, not a hole: the fact those clauses protected — a DISCOVERED identity the
// execution route cannot reach — is not lost, it MOVES, and it moves to a better-located carrier.
// The route refuses such an identity at the Entry stage
// (native_test_entry_declaration_not_found / native_test_entry_module_scope_unresolved), the
// exclusion taxonomy classifies that refusal, and an unclassified one still blocks admission by
// name. The clauses stay enrolled because the receipt is a data shape a future producer can still
// violate; the discriminating evidence for the class now lives on the exclusion clauses.

// THE PER-MODULE DECISION IS SPLIT AT ITS TWO COST GRAINS, and the split is load-bearing rather
// than cosmetic. Preparation (resolve + infer) is paid ONCE per module; evaluation is paid per
// declaration. A caller that must PRICE them separately — the rendered main, which owns the clock
// the substrate does not have — needs to enter each one itself, so the decision returns either the
// prepared module or the rows already decided without it, and evaluation is a second call per
// identity. Composing them here instead would hand the host one opaque call and force it to label
// the whole thing with one phase name, which is the measurement defect this shape exists to avoid.
type NativeLaneModulePreparation
  = NativeLaneModulePrepared { prepared: NativeTestPreparedModule }
  | NativeLaneModuleRowsDecided { rows: List<NativeRouteMemberRow> }

fn native_lane_module_preparation(
  context: NativeTestContext,
  entry: NativeLaneUniverseModule
) -> NativeLaneModulePreparation {
  match native_lane_file_refusal_for_path(refusals: context.file_refusals, path: entry.path) {
    Present { value: fr } =>
      NativeLaneModuleRowsDecided {
        rows: fold_list(
          xs: entry.declarations,
          empty: [],
          cons: fn(acc, d) {
            list_snoc_item(xs: acc, item: native_lane_member_row(
              module: entry.module,
              declaration: d,
              verdict: NativeTestRefused { stage: NativeTestStageContext, reason: fr.fatal_reason }
            ))
          }
        )
      }
    Absent =>
      match native_test_prepare_module(
        context: context,
        module: qualified_name_from_dotted_string(dotted: entry.module)
      ) {
        Rejected { diagnostics: d } =>
          NativeLaneModuleRowsDecided {
            rows: fold_list(
              xs: entry.declarations,
              empty: [],
              cons: fn(acc, decl) {
                list_snoc_item(xs: acc, item: native_lane_member_row(
                  module: entry.module,
                  declaration: decl,
                  verdict: NativeTestRefused {
                    stage: NativeTestStagePrepare,
                    reason: native_test_fatal_reason(d: d)
                  }
                ))
              }
            )
          }
        Accepted { value: prepared, diagnostics: _ } =>
          NativeLaneModulePrepared { prepared: prepared }
      }
  }
}

// ONE IDENTITY, EVALUATED. The per-declaration grain the profile lane prices: this call and nothing
// else is what identity_evaluation measures.
fn native_lane_identity_row(
  prepared: NativeTestPreparedModule,
  module: String,
  declaration: String
) -> NativeRouteMemberRow {
  let observation = native_test_eval_one(
    prepared: prepared,
    declaration: symbol_intern_lexeme(lexeme: declaration)
  )
  native_lane_member_row(
    module: module,
    declaration: declaration,
    verdict: observation.verdict
  )
}

// THE LIVE-VERDICT CONTROLS, EXECUTED BY THE SAME ROUTE AS EVERY MEMBER. They sit outside the
// universe prefix, so discovery enrols nothing for them and the authority's own declaration is
// what names them; a verdict is Absent exactly when the route could not produce one, which is the
// state the false/true clauses refuse. BOTH are answered from ONE prepare: they share a module,
// and resolve + infer over the whole context is the per-module cost this fold exists to pay once.
type NativeLaneControls {
  false_control: Optional<NativeTestVerdict>
  true_control: Optional<NativeTestVerdict>
}

fn native_lane_controls(context: NativeTestContext) -> NativeLaneControls {
  match native_test_prepare_module(
    context: context,
    module: qualified_name_from_dotted_string(dotted: native_route_live_control_module)
  ) {
    Rejected { diagnostics: _ } =>
      NativeLaneControls { false_control: optional_absent(), true_control: optional_absent() }
    Accepted { value: prepared, diagnostics: _ } =>
      {
        let false_observation = native_test_eval_one(
          prepared: prepared,
          declaration: symbol_intern_lexeme(lexeme: native_route_live_control_false_declaration)
        )
        let true_observation = native_test_eval_one(
          prepared: prepared,
          declaration: symbol_intern_lexeme(lexeme: native_route_live_control_true_declaration)
        )
        NativeLaneControls {
          false_control: optional_present(value: false_observation.verdict),
          true_control: optional_present(value: true_observation.verdict)
        }
      }
  }
}

// ── the receipt, minted and judged inside the route ────────────────────────────────────────
//
// THE HOST FACTS ARE THE ONLY THING THE ROUTE CANNOT OBSERVE OF ITSELF: which seed PREPARED the
// compiler artifact, what the closure's and the executable's content identities are, HOW the old
// route's fallback was closed, and what the malformed specimen's own run observed. They are
// received as data and recorded verbatim; every other field of the receipt is this process's own
// observation, and the admission that judges it is the authority's, evaluated here.
//
// THE OLD-ROUTE CONTROL ARRIVES AS THE AUTHORITY'S OWN COPRODUCT rather than as a path plus an
// assumption about what the host did with it. The harness withdrew an executable, or found none at
// the path for the whole window; both are observations and the authority names both, so the host
// cannot report one while the other held (operator design review 2026-09-11, C5: the harness must
// not REQUIRE the old route to exist so that it can move it).
type NativeLaneHostFacts {
  tested_tree: String
  preparation_seed_identity: String
  emitted_closure_identity: String
  executable_path: String
  executable_identity: String
  old_route_control: NativeRouteOldRouteControl
  malformed_control: NativeRouteMalformedControl
}

fn native_lane_receipt(
  context: NativeTestContext,
  universe: NativeLaneUniverse,
  population: List<NativeRouteMemberRow>,
  controls: NativeLaneControls,
  facts: NativeLaneHostFacts
) -> NativeRouteReceipt {
  NativeRouteReceipt {
    job: required_v2_native_job_name,
    tested_tree: facts.tested_tree,
    preparation_seed_identity: facts.preparation_seed_identity,
    emitted_closure_identity: facts.emitted_closure_identity,
    executable_path: facts.executable_path,
    executable_identity: facts.executable_identity,
    universe: universe.identities,
    module_source_index: universe.module_sources,
    population: population,
    file_refusals: context.file_refusals,
    false_control: controls.false_control,
    true_control: controls.true_control,
    malformed_control: facts.malformed_control,
    old_route_control: facts.old_route_control
  }
}
