module v2.compiler.compile


type CoreNode = Node

type RuntimeTarget = Node

type CompileMode
  = TranslateTo { target: v2.std.compilers.target_model.TargetModel }
  | Eval { runtime: RuntimeTarget }

type CompileOutput
  = TranslateResult { source: extdeps.communication.medium.Medium<String> }
  | EvalResult { value: extdeps.communication.medium.Medium<Node> }

type CompileLensOutcome = v2.std.diagnostic.Outcome<v2.std.witness.Witness<v2.std.node.Node>>

// THE GATE TYPE IS WRITTEN INLINE, AND THIS IS AN INTERIM AGAINST A LOCATED COMPILER DEFECT --
// NOT A STYLE CHOICE, AND NOT A CLAIM THAT THE DEFECT IS FIXED. A record field whose declared
// type is an ALIAS to a `fn` type loses its declared argument contract when the method is called
// from another module, so `lens.gate(inferred)` in
// v2.test.claim.long.mandatory_tag_gate_witness_test refused with "no declared argument contract
// is available for this method call" -- at RESOLVE time, which refuses preparation for the whole
// prepared subject and therefore takes every witness in the required floor down with it, not
// just its own. The bisect, the mechanism, and the next-rung trigger are one place:
// v2.test.claim.cross_module_alias_fn_field_contract_test, whose positive control executes.
//
// WHAT MAKES THIS DEFENSIBLE RATHER THAN A DODGE: the alias was declared once and used once, so
// inlining removes a second name for one shape (DESIGN section 2) and changes no type -- an
// alias and its expansion ARE the same type. I am stating the real reason anyway, because a
// change made to route around a substrate deficit is a workaround whatever else is true of it,
// and the DESIGN section 5 rule is that noticing that is the line-stop signal. The line stopped:
// the defect is root-caused to a minimal pair rather than guessed at, and the repair is named.
//
// DISSOLVES WHEN declared_arg_types_for_method (src/v1/04_lookup.dag) is given a TypeEnv and
// expands the field's declared type before answering ContractUnavailable, and that authority is
// regenerated into the seed mirror. At that point this becomes an ordinary free choice and the
// alias may return. It is NOT dissolved by anyone editing the .rs mirror by hand.
type CompileLens {
  gate: fn(v2.compiler.inferred_tree.InferredTree) -> CompileLensOutcome
}

type CompileLensMode
  = CompileLensEnforce
  | CompileLensIntrospect

type LensGateWitness {
  witness: Witness<Node>
}

type Validated<T> {
  value: T
  lens_witnesses: List<LensGateWitness>
}

fn compile_pipeline_not_realized_diagnostic(at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^compile_pipeline_not_realized,
    at: at,
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_lens_gate_rejected_diagnostic(at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^compile_lens_gate_rejected,
    at: at,
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_eval_not_realized_diagnostic(at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^compile_eval_not_realized,
    at: at,
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

data fact_density_lens: CompileLens = CompileLens { gate: fact_density_hollow_alias_compile_gate }

data unit_modeling_lens: CompileLens = CompileLens { gate: unit_modeling_compile_gate }

data lifecycle_carrier_lens: CompileLens = CompileLens { gate: lifecycle_carrier_compile_gate }

fn always_required_lenses() -> List<CompileLens> {
  [fact_density_lens, unit_modeling_lens, lifecycle_carrier_lens]
}

data required_lens_grain_note: String = "Two required-roster grains, one door (validate_then_compile is the single gate authority; per sharp-bee-290 contract 2026-07-13 no second gate surface exists). always_required_lenses runs PER SUBTREE NODE (node-local predicates: fact_density, unit_modeling — each gate reads only the node's direct children; a nested subtree walk inside the gate would stack with run_required_lens_gates_on_subtree's fold_node and be O(n^2)). always_required_root_lenses runs ONCE at the tree root — the grain for rooted whole-tree walks (accumulator-copy carrier threading), where per-node invocation would be O(n^2): the enforcement of the complexity lens must not itself violate the complexity lens (DESIGN 7 self-application). Witness accumulation on the subtree fold uses prepend-then-reverse, not append-in-step. Root-required lenses fire on every validate_then_compile call regardless of caller-supplied lenses, exactly like the subtree roster."

data accumulator_copy_lens: CompileLens = CompileLens { gate: accumulator_copy_root_gate }

data determinism_lens: CompileLens = CompileLens { gate: determinism_root_gate }

data machine_shape_lens: CompileLens = CompileLens { gate: machine_shape_root_gate }

data mandatory_tag_lens: CompileLens = CompileLens { gate: mandatory_tag_root_gate }

data door_roster_tree_grain_note: String = "always_required_root_lenses is TREE-GRAIN only: every enrolled gate is a pure fold over the InferredTree being compiled (accumulator_copy, determinism, machine_shape, mandatory_tag all read tree.root and nothing else). lens_module_gate was DE-ENROLLED here (census follow-on to run 29892063728 receipts): its compile_gate wrapper discarded the tree argument and ran the nullary corpus scan lens_module_gate_blocking_holds - a live walk of src/v2/lens on every compile, which made every compile-importing entry reach a live-read carrier and put 31 SubstrateInputsOnly witness stamps in the lying_substrate_inputs_only_stamp_census red class. Enforcement is NOT reduced: the same invariant executes per-PR via its own honestly-stamped consumer, v2.test.claim.enforcement.lens_module_gate_witness (live_tree_disposition: ReadsLiveTree, never predict-skips), which reds the floor when registry completeness breaks. A corpus-grain invariant enrolls on the corpus cadence with a ReadsLiveTree stamp, never in the per-tree door - re-enrolling a nullary gate here re-opens the census class."

fn always_required_root_lenses() -> List<CompileLens> {
  [accumulator_copy_lens, determinism_lens, machine_shape_lens, mandatory_tag_lens]
}

fn accumulator_copy_root_gate(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  accumulator_copy_compile_gate(node: tree.root)
}

fn determinism_root_gate(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  determinism_compile_gate(node: tree.root)
}

fn machine_shape_root_gate(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  machine_shape_compile_gate(node: tree.root)
}

fn mandatory_tag_root_gate(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  mandatory_tag_compile_gate(node: tree.root)
}

fn fact_density_hollow_alias_compile_gate(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  fact_density_hollow_alias_gate(node: tree.root)
}

fn unit_modeling_compile_gate(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  unit_modeling_gate(node: tree.root)
}

fn lifecycle_carrier_compile_gate(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  lifecycle_carrier_gate(node: tree.root)
}

fn run_compile_lens_gate(lens: CompileLens, inferred: v2.compiler.inferred_tree.InferredTree) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  lens.gate(inferred)
}

fn apply_compile_lens_introspect(
  lens: CompileLens,
  inferred: v2.compiler.inferred_tree.InferredTree
) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  match run_compile_lens_gate(lens: lens, inferred: inferred) {
    Accepted { value: w, diagnostics: od } =>
      outcome_with_diagnostics(value: w, diagnostics: od)
    Rejected { diagnostics: d } =>
      outcome_with_diagnostics(
        value: v2.std.witness.Violates { diagnostic: d.head },
        diagnostics: v2.std.diagnostic.Some { diagnostics: d }
      )
  }
}

fn apply_compile_lens(
  lens: CompileLens,
  inferred: v2.compiler.inferred_tree.InferredTree,
  mode: CompileLensMode
) -> v2.std.diagnostic.Outcome<Witness<Node>> {
  match mode {
    CompileLensEnforce => run_compile_lens_gate(lens: lens, inferred: inferred)
    CompileLensIntrospect => apply_compile_lens_introspect(lens: lens, inferred: inferred)
  }
}

fn prepend_lens_gate_witness(
  witnesses: List<LensGateWitness>,
  witness: Witness<Node>
) -> List<LensGateWitness> {
  std.algebra.Cons { head: LensGateWitness { witness: witness }, tail: witnesses }
}

fn empty_lens_gate_witnesses() -> List<LensGateWitness> {
  []
}

fn run_required_lens_gates(
  inferred: v2.compiler.inferred_tree.InferredTree,
  lenses: List<CompileLens>
) -> v2.std.diagnostic.Outcome<List<LensGateWitness>> {
  bind_outcome(
    o: fold(
      lenses,
      init: outcome_accepted(value: empty_lens_gate_witnesses()),
      f: fn(acc_outcome, lens) {
        match acc_outcome {
          Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          Accepted { value: witnesses, diagnostics: od } =>
            bind_outcome_accepted(
              od: od,
              inner: bind_outcome(
                o: apply_compile_lens(lens: lens, inferred: inferred, mode: CompileLensEnforce),
                f: fn(w) {
                  outcome_accepted(
                    value: prepend_lens_gate_witness(
                      witnesses: witnesses,
                      witness: w
                    )
                  )
                }
              )
            )
        }
      }
    ),
    f: fn(collected) { outcome_accepted(value: list_reverse(xs: collected)) }
  )
}

fn run_required_lens_gates_on_subtree(
  inferred: v2.compiler.inferred_tree.InferredTree,
  lenses: List<CompileLens>
) -> v2.std.diagnostic.Outcome<List<LensGateWitness>> {
  bind_outcome(
    o: fold_node(
      n: inferred.root,
      algebra: v2.std.node.NodeFold {
        init: fn(n0) {
          run_required_lens_gates(
            inferred: v2.compiler.inferred_tree.InferredTree { root: n0, facts: inferred.facts },
            lenses: lenses
          )
        },
        step: fn(acc, _, child) {
          bind_outcome(o: acc, f: fn(ws) {
            bind_outcome(
              o: child,
              f: fn(child_ws) {
                outcome_accepted(value: list_append(left: child_ws, right: ws))
              }
            )
          })
        }
      }
    ),
    f: fn(collected) { outcome_accepted(value: list_reverse(xs: collected)) }
  )
}

fn compile_inferred_translate(
  inferred: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.emit.emit(tree: inferred, target: target)
}

fn compile_inferred(
  inferred: v2.compiler.inferred_tree.InferredTree,
  mode: CompileMode
) -> v2.std.diagnostic.Outcome<CompileOutput> {
  match mode {
    TranslateTo { target } =>
      bind_outcome(
        o: compile_inferred_translate(
          inferred: inferred,
          target: target
        ),
        f: fn(target_source) {
          outcome_accepted(TranslateResult { source: target_source })
        }
      )
    Eval { runtime: runtime } =>
      bind_outcome(
        o: eval_node(
          tree: inferred,
          inputs: inputs_root_only(root: runtime)
        ),
        f: fn(value) {
          outcome_accepted(
            EvalResult {
              value: extdeps.communication.medium.Medium { carried: value, fidelity: extdeps.communication.medium.Lossless }
            }
          )
        }
      )
  }
}

fn compile(
  source: CoreNode,
  mode: CompileMode
) -> v2.std.diagnostic.Outcome<CompileOutput> {
  bind_outcome(
    o: infer(tree: source),
    f: fn(inferred) {
      compile_inferred(inferred: inferred, mode: mode)
    }
  )
}

fn validated_from_compile_output(
  output: CompileOutput,
  lens_witnesses: List<LensGateWitness>
) -> Validated<CompileOutput> {
  Validated {
    value: output,
    lens_witnesses: lens_witnesses
  }
}

fn validate_then_compile(
  source: CoreNode,
  lenses: List<CompileLens>,
  mode: CompileMode
) -> v2.std.diagnostic.Outcome<Validated<CompileOutput>> {
  bind_outcome(
    o: infer(tree: source),
    f: fn(inferred) {
      bind_outcome(
        o: run_required_lens_gates_on_subtree(inferred: inferred, lenses: always_required_lenses()),
        f: fn(required_lens_witnesses) {
          bind_outcome(
            o: run_required_lens_gates(
              inferred: inferred,
              lenses: list_append(left: always_required_root_lenses(), right: lenses)
            ),
            f: fn(caller_lens_witnesses) {
              bind_outcome(
                o: compile_inferred(
                  inferred: inferred,
                  mode: mode
                ),
                f: fn(compile_out) {
                  outcome_accepted(
                    value: validated_from_compile_output(
                      output: compile_out,
                      lens_witnesses: list_append(
                        left: required_lens_witnesses,
                        right: caller_lens_witnesses
                      )
                    )
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn compile_ingest_with_admission(
  source: extdeps.communication.medium.Medium<String>,
  target: v2.std.compilers.target_model.TargetModel,
  peer_roots: FreeMonoid<v2.compiler.normalized_tree.NormalizedTree>,
  admission: v2.compiler.name_resolve.Admission
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          bind_outcome(
            o: normalize(parse_tree: parse_tree),
            f: fn(normalized) {
              let roots = std.algebra.Cons { head: normalized, tail: peer_roots }
              bind_outcome(
                o: resolve_with_admission(
                  lm: lm,
                  roots: roots,
                  admission: admission
                ),
                f: fn(resolved) {
                  bind_outcome(
                    o: validate_then_compile(
                      source: resolved,
                      lenses: [],
                      mode: TranslateTo { target: target }
                    ),
                    f: fn(validated) {
                      match validated.value {
                        TranslateResult { source: target_source } =>
                          outcome_accepted(target_source)
                        EvalResult { value: _ } =>
                          outcome_rejected(
                            compile_eval_not_realized_diagnostic(
                              at: port_locus(port: ^compile_stage_locus_port)
                            )
                          )
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn compile_source_root_ingest_with_admission(
  ingest: v2.compiler.source_authority.SourceRootIngest,
  admission: v2.compiler.name_resolve.Admission,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  let lm = dag_language_model()
  bind_outcome(
    o: assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm),
    f: fn(resolved) {
      bind_outcome(
        o: validate_then_compile(
          source: resolved,
          lenses: [],
          mode: TranslateTo { target: target }
        ),
        f: fn(validated) {
          match validated.value {
            TranslateResult { source: target_source } =>
              outcome_accepted(target_source)
            EvalResult { value: _ } =>
              outcome_rejected(
                compile_eval_not_realized_diagnostic(
                  at: port_locus(port: ^compile_stage_locus_port)
                )
              )
          }
        }
      )
    }
  )
}

fn stage_tokenize(lm: v2.std.language_model.LanguageModel) -> fn(extdeps.communication.medium.Medium<String>) -> v2.std.diagnostic.Outcome<TokenStream> {
  fn(source) {
    tokenize(
      text: source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    )
  }
}

fn stage_parse(lm: v2.std.language_model.LanguageModel) -> fn(TokenStream) -> v2.std.diagnostic.Outcome<ParseTree> {
  fn(token_stream) { parse(tokens: token_stream, grammar: lm.grammar) }
}

fn stage_normalize() -> fn(ParseTree) -> v2.std.diagnostic.Outcome<NormalizedTree> {
  fn(parse_tree) { normalize(parse_tree: parse_tree) }
}

fn stage_resolve(lm: v2.std.language_model.LanguageModel) -> fn(NormalizedTree) -> v2.std.diagnostic.Outcome<ResolvedTree> {
  fn(normalized) { v2.compiler.resolve.resolve(tree: normalized, lm: lm) }
}

fn resolve_cache_miss(normalized: v2.compiler.normalized_tree.NormalizedTree) -> CacheProbe<v2.compiler.resolve.ResolvedTree> {
  v2.std.staging.Miss
}

fn stage_translate(target: v2.std.compilers.target_model.TargetModel) -> fn(ResolvedTree) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  fn(resolved) {
    bind_outcome(
      o: validate_then_compile(
        source: resolved,
        lenses: [],
        mode: TranslateTo { target: target }
      ),
      f: fn(validated) {
        match validated.value {
          TranslateResult { source: target_source } =>
            outcome_accepted(target_source)
          EvalResult { value: _ } =>
            outcome_rejected(
              compile_eval_not_realized_diagnostic(
                at: port_locus(port: ^compile_stage_locus_port)
              )
            )
        }
      }
    )
  }
}

fn compile_ingest_staging(source: extdeps.communication.medium.Medium<String>, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  let lm = dag_language_model()
  let pipeline = then_outcome(
      f: stage_tokenize(lm: lm),
      g: then_outcome(
        f: stage_parse(lm: lm),
        g: then_outcome(
          f: stage_normalize(),
          g: then_outcome(
            f: cached_stage_governed(
              realization: cached_stage_realization(),
              lookup: resolve_cache_miss,
              stage: stage_resolve(lm: lm)
            ),
            g: stage_translate(target: target)
          )
        )
      )
    )
  pipeline(source)
}
