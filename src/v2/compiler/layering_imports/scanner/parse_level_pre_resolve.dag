module v2.test.layering_imports.scanner.parse_level_pre_resolve

import v2.lens.layering_imports { layering_imports_violation_count }
import v2.std.logic { Bool }
import v2.test.workflow.host_layering_import_manifest { host_layer_import_facts }

fn scanner_parse_level_pre_resolve_detects_holds() -> Bool {
  layering_imports_violation_count(facts: host_layer_import_facts) == 1
}
