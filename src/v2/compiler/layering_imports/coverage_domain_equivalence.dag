// Scope: coverage-domain-equivalence witness (zesty sign=CUTOVER). This .dag proves the
//        COVERING half by-execution — coverage_domain_equivalence_argument_holds() asserts the
//        perturb roster spans EACH enumerated layer-root and EACH forbidden form (drift-resistant:
//        a coverage-breaking roster edit goes RED, not merely count-shrink).
// Authority: the (deleted) python layering gate's domain at daf95e49, git-recoverable. The v3
//        generation has since been removed; this witness now covers the v2 layering domain only.
//        (dsl/std is enforced by the lens root-independently but is not enumerated here — its
//        former scanner row was v3/manifest-coupled and was retired with v3.)
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v2.test.layering_imports.coverage_domain_equivalence

import v2.std.algebra { any, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

// Domain (post-v3-removal): 3 enumerated layer roots × 2 forbidden forms (v2.compiler exact +
// prefix), leading-import, *.dag only.

data layer_root_src_v2_std: String = "src/v2/std"
data layer_root_src_v2_extdeps: String = "src/v2/extdeps"
data layer_root_dsl_extdeps: String = "dsl/extdeps"

data layer_roots: List<String> = [
  layer_root_src_v2_std,
  layer_root_src_v2_extdeps,
  layer_root_dsl_extdeps
]

data form_v2_compiler_exact: String = "v2.compiler exact"
data form_v2_compiler_prefix: String = "v2.compiler.* prefix"

data forbidden_forms: List<String> = [
  form_v2_compiler_exact,
  form_v2_compiler_prefix
]

type LayeringImportsScannerPerturbReceiptRow {
  label: String
  layer_root: String
  forbidden_form: String
  scanner_entry: String
  scanner_function: String
}

// Scanner-execution perturb roster (host plant → REAL scan → witness; NOT hardcoded facts).
data perturb_row_std_prefix: LayeringImportsScannerPerturbReceiptRow = LayeringImportsScannerPerturbReceiptRow {
  label: "src/v2/std × v2.compiler.* prefix",
  layer_root: layer_root_src_v2_std,
  forbidden_form: form_v2_compiler_prefix,
  scanner_entry: "src/v2/compiler/layering_imports/scanner/std_v4_prefix.dag",
  scanner_function: "scanner_std_v4_prefix_detects_holds"
}

data perturb_row_extdeps_prefix: LayeringImportsScannerPerturbReceiptRow = LayeringImportsScannerPerturbReceiptRow {
  label: "src/v2/extdeps × v2.compiler.* prefix",
  layer_root: layer_root_src_v2_extdeps,
  forbidden_form: form_v2_compiler_prefix,
  scanner_entry: "src/v2/compiler/layering_imports/scanner/extdeps_v4_prefix.dag",
  scanner_function: "scanner_extdeps_v4_prefix_detects_holds"
}

data perturb_row_dsl_extdeps_exact: LayeringImportsScannerPerturbReceiptRow = LayeringImportsScannerPerturbReceiptRow {
  label: "dsl/extdeps × v2.compiler exact",
  layer_root: layer_root_dsl_extdeps,
  forbidden_form: form_v2_compiler_exact,
  scanner_entry: "src/v2/compiler/layering_imports/scanner/dsl_extdeps_v4_exact.dag",
  scanner_function: "scanner_dsl_extdeps_v4_exact_detects_holds"
}

data perturb_row_parse_level_pre_resolve: LayeringImportsScannerPerturbReceiptRow = LayeringImportsScannerPerturbReceiptRow {
  label: "src/v2/std parse-level pre-resolve text scan",
  layer_root: layer_root_src_v2_std,
  forbidden_form: form_v2_compiler_prefix,
  scanner_entry: "src/v2/compiler/layering_imports/scanner/parse_level_pre_resolve.dag",
  scanner_function: "scanner_parse_level_pre_resolve_detects_holds"
}

data layering_imports_scanner_perturb_receipt_rows: List<LayeringImportsScannerPerturbReceiptRow> = [
  perturb_row_std_prefix,
  perturb_row_extdeps_prefix,
  perturb_row_dsl_extdeps_exact,
  perturb_row_parse_level_pre_resolve
]

// COVERING: for EACH enumerated layer-root some row carries it, and for EACH forbidden form some
// row carries it. A coverage-breaking roster edit (drop/duplicate-away a root or form) leaves a
// cell uncovered → this goes RED. The form-check is ROOT-INDEPENDENT by lens structure
// (is_layering_violation applies is_forbidden_compiler_import unconditionally —
// src/v2/lens/layering_imports.dag), so per-root × per-form coverage ⇒ all classes.

fn rows_cover_root(root: String) -> Bool {
  any(
    xs: layering_imports_scanner_perturb_receipt_rows,
    predicate: fn(row) { row.layer_root == root }
  )
}

fn rows_cover_form(form: String) -> Bool {
  any(
    xs: layering_imports_scanner_perturb_receipt_rows,
    predicate: fn(row) { row.forbidden_form == form }
  )
}

fn coverage_domain_equivalence_argument_holds() -> Bool {
  rows_cover_root(root: layer_root_src_v2_std)
    && rows_cover_root(root: layer_root_src_v2_extdeps)
    && rows_cover_root(root: layer_root_dsl_extdeps)
    && rows_cover_form(form: form_v2_compiler_exact)
    && rows_cover_form(form: form_v2_compiler_prefix)
    && length(xs: layer_roots) == 3
    && length(xs: forbidden_forms) == 2
    && length(xs: layering_imports_scanner_perturb_receipt_rows) == 4
}
