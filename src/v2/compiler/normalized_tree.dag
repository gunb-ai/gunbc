module v2.compiler.normalized_tree


// A NormalizedTree is the ADMITTED product of normalize: a root whose own
// lowering left no wrapper behind. It was an alias for Node until BL-1; the
// alias is why retention evidence reached resolve as a bare Node and was
// dropped there. Sealing the carrier is what makes the drop unwritable.
type NormalizedTree sole_constructor {
  root: Node,
}

data normalized_tree_admission_rung_note: String = "Rung: ACCEPTED REFINEMENT WITH EXECUTING REFUSAL, not structural impossibility. The invalid state -- a root carrying wrapper-retention diagnostics presented as normalized -- remains describable; what changed is that admit_normalized_tree is the sole constructor, so no Accepted program reaches the carrier while holding retention evidence. Next-rung trigger: the retention disposition riding in the carrier's own type rather than being decided at the door."

fn normalized_tree_retention_diagnostic(root: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^normalized_tree_reason_wrapper_retention_not_normalized,
    at: node_locus(node: root),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn admit_normalized_tree(root: Node, diagnostics: v2.std.diagnostic.Diagnostics) -> Outcome<NormalizedTree> {
  if body_lowering_diagnostics_carry_wrapper_retention(d: diagnostics) {
    v2.std.diagnostic.Rejected {
      diagnostics: rejected_with_pending(
        pending: diagnostics,
        rejected: diagnostics_singleton(d: normalized_tree_retention_diagnostic(root: root))
      )
    }
  } else {
    v2.std.diagnostic.Accepted { value: NormalizedTree { root: root }, diagnostics: diagnostics }
  }
}

// Projection out of the sealed carrier for consumers that are genuinely about
// Node structure and not about admission -- the symbol-index fill, for one.
// Order-preserving: a symbol index built from a reordered root list is a
// different index.
fn normalized_tree_roots_to_nodes(roots: FreeMonoid<NormalizedTree>) -> FreeMonoid<Node> {
  fold_list(
    xs: roots,
    empty: std.algebra.Empty,
    cons: fn(acc, root) { list_snoc_item(xs: acc, item: root.root) }
  )
}

// The plural door. Admitting a list of roots is not a new decision -- it is the
// same one per element, refusing as a whole so a partially admitted list has no
// representation.
//
// The threading is explicit rather than bind_outcome because bind_outcome MERGES
// the accumulated diagnostics with each step's, and every step here carries the
// same shared diagnostics -- so threading them would accumulate N+1 copies of one
// set. The decision is still made per element (it is the same verdict each time,
// since it reads only the shared diagnostics), the refusal carries its pending
// set exactly once via admit_normalized_tree, and the accepted diagnostics are
// attached once at the end.
fn admit_normalized_roots(
  roots: FreeMonoid<Node>,
  diagnostics: v2.std.diagnostic.Diagnostics
) -> Outcome<FreeMonoid<NormalizedTree>> {
  match fold_list(
    xs: roots,
    empty: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: None },
    cons: fn(acc, root) {
      match acc {
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        Accepted { value: admitted, diagnostics: _ } =>
          match admit_normalized_tree(root: root, diagnostics: diagnostics) {
            Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
            Accepted { value: one, diagnostics: _ } =>
              v2.std.diagnostic.Accepted {
                value: list_snoc_item(xs: admitted, item: one),
                diagnostics: None
              }
          }
      }
    }
  ) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: all, diagnostics: _ } =>
      v2.std.diagnostic.Accepted { value: all, diagnostics: diagnostics }
  }
}
