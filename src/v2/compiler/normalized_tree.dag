module v2.compiler.normalized_tree

import v2.compiler.body_lowering_fold { body_lowering_diagnostics_carry_wrapper_retention }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  Diagnostics,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  bind_outcome,
  diagnostics_singleton,
  Unavailable,
  node_locus,
  rejected_with_pending
}
import std.algebra { Empty, FreeMonoid }
import v2.std.algebra { fold_list, list_snoc_item }
import v2.std.node { Node }
import v2.std.declaration_marker { TestMarkerChannel, test_marker_channel_empty }

// A NormalizedTree is the ADMITTED product of normalize: a root whose own lowering left no wrapper
// behind. It was an alias for Node until BL-1, which is why retention evidence reached resolve as a
// bare Node and was dropped there. Sealing the carrier makes the drop unwritable.
//
// `test_markers` is the DESIGN section 4c channel for the authored `test` marker, sealed beside the
// root rather than inside it: `root` is byte-identical for a `test fn` and a plain `fn`, and every
// consumer about Node structure reads `root` alone. Name resolution is the channel's consumer.
type NormalizedTree sole_constructor {
  root: Node,
  test_markers: TestMarkerChannel,
}

// Rung: ACCEPTED REFINEMENT WITH EXECUTING REFUSAL, not structural impossibility. The invalid state
// — a root carrying wrapper-retention diagnostics presented as normalized — remains describable;
// admit_normalized_tree is now the sole constructor, so no Accepted program reaches the carrier
// while holding retention evidence. Next-rung trigger: the retention disposition riding in the
// carrier's own type rather than decided at the door.

fn normalized_tree_retention_diagnostic(root: Node) -> Diagnostic {
  Diagnostic {
    reason: ^normalized_tree_reason_wrapper_retention_not_normalized,
    at: node_locus(node: root),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn admit_normalized_tree(
  root: Node,
  test_markers: TestMarkerChannel,
  diagnostics: Diagnostics
) -> Outcome<NormalizedTree> {
  if body_lowering_diagnostics_carry_wrapper_retention(d: diagnostics) {
    Rejected {
      diagnostics: rejected_with_pending(
        pending: diagnostics,
        rejected: diagnostics_singleton(d: normalized_tree_retention_diagnostic(root: root))
      )
    }
  } else {
    Accepted { value: NormalizedTree { root: root, test_markers: test_markers }, diagnostics: diagnostics }
  }
}

// Projection out of the sealed carrier for consumers genuinely about Node structure, not admission
// — the symbol-index fill, for one. Order-preserving: a symbol index built from a reordered root
// list is a different index.
fn normalized_tree_roots_to_nodes(roots: FreeMonoid<NormalizedTree>) -> FreeMonoid<Node> {
  fold_list(
    xs: roots,
    empty: Empty,
    cons: fn(acc, root) { list_snoc_item(xs: acc, item: root.root) }
  )
}

// THE UNMARKED DOOR, AND ITS NAME SAYS SO. Its roots arrive as already-lowered Nodes, from which the
// authored `test` marker cannot be recovered (lowering erases it by design), so every root is admitted
// with an empty marker channel. That is a statement about the caller's input, not a default: a caller
// holding source goes through v2.compiler.normalize, which captures the channel from the parse tree.
//
// The plural door: the same decision per element, refusing as a whole so a partially admitted list
// has no representation.
//
// Threading is explicit rather than bind_outcome because bind_outcome MERGES the accumulated
// diagnostics with each step's, and every step here carries the same shared diagnostics — threading
// would accumulate N+1 copies of one set. The decision is still per element (the same verdict each
// time, reading only the shared diagnostics), the refusal carries its pending set exactly once via
// admit_normalized_tree, and the accepted diagnostics attach once at the end.
fn admit_unmarked_normalized_roots(
  roots: FreeMonoid<Node>,
  diagnostics: Diagnostics
) -> Outcome<FreeMonoid<NormalizedTree>> {
  match fold_list(
    xs: roots,
    empty: Accepted { value: Empty, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, root) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: admitted, diagnostics: _ } =>
          match admit_normalized_tree(root: root, test_markers: test_marker_channel_empty(), diagnostics: diagnostics) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: one, diagnostics: _ } =>
              Accepted {
                value: list_snoc_item(xs: admitted, item: one),
                diagnostics: v2.std.diagnostic.None
              }
          }
      }
    }
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: all, diagnostics: _ } =>
      Accepted { value: all, diagnostics: diagnostics }
  }
}
