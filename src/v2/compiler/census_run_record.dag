module v2.compiler.census_run_record

import std.algebra {
  Cons,
  Empty,
  FreeSemigroup,
  fold_list,
  list_append,
  list_snoc_item
}
import std.content_hash {
  Fnv1a64Structural,
  content_hash_atom,
  content_hash_combine_structural,
  content_hash_eq_structural
}
import std.occurrence_identity { OccurrenceId }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.types { Bool, List, NonEmptyStr, String }
import gunbc.guarantee_measurement { ContentFingerprint, GitRevision, MeasurementRevision }
import v2.compiler.compile {
  NativeCensusCauseFrontEnd,
  NativeCensusCauseInfer,
  NativeCensusCauseResolve,
  NativeCensusCauseStage,
  NativeCensusScope,
  NativeCensusScopeBlocked,
  NativeCensusScopeClosed,
  NativeInferCensusFileRefused,
  NativeInferCensusInferRefused,
  NativeInferCensusInferred,
  NativeInferCensusOutcome,
  NativeInferCensusResolveRefused
}
import v2.compiler.module_acquisition {
  CensusBlock,
  CensusEdgeBlock,
  CensusMemberBlock,
  CensusMemberFrontEndRefused,
  CensusMemberIdentityDisagrees,
  CensusMemberRefusal,
  CensusMemberSitesUnreadable
}
import v2.compiler.native_test_vocabulary {
  FileRefusalAt,
  FileRefusalAtDeclaration,
  FileRefusalAtInvariant,
  FileRefusalAtLine,
  FileRefusalAtOtherFile,
  FileRefusalAtUnresolvedNode,
  FileRefusalAtWholeFile,
  FileRefusalLink,
  NativeTestFileRefusal,
  native_test_file_refusal_fatal_link,
  native_test_file_refusal_fatal_reason
}
import v2.compiler.source_authority { ModuleFileRef }
import v2.std.collection { Map, empty_map, map_contains_key, map_insert, map_lookup }
import v2.std.diagnostic {
  ByteRange,
  DeclarationLocus,
  Extent,
  InvariantPortLocus,
  Locus,
  NodeLocus,
  NonEmptyDiagnostics,
  SourcePortLocus,
  Textual,
  WholeFile,
  diagnostics_fatal
}
import v2.std.node { Symbol }
import v2.std.provenance { node_occurrence_id_optional }

// THE OBLIGATION GRAIN: one row per module and NativeCensusCauseStage (FrontEnd, Resolve, Infer).
// CONSUMER (DESIGN §3c): the scoped-census publication half (parent calm-eagle-670 / host
// native-lane runner) prints a CensusRunRecord and reads it back through census_run_diff.
// Declared frontier; trigger: that half lands on CensusRunRecord rather than an ad-hoc encoding.
// Claims in v2.test.claim.native_census.census_run_diff pin the grain; they are not the production
// consumer.

type CensusObligationRefusalEvidence
  = CensusRefusalDiagnostics { first: NonEmptyDiagnostics, rest: List<NonEmptyDiagnostics> }
  | CensusRefusalFileLinks { chain: FreeSemigroup<FileRefusalLink> }
  | CensusRefusalMemberFile { file: ModuleFileRef }
  | CensusRefusalUnlocated

type CensusObligationOutcome
  = CensusObligationPassed
  | CensusObligationRefused {
      reason: Symbol
      at: FileRefusalAt
      evidence: CensusObligationRefusalEvidence
      occurrence: Optional<OccurrenceId>
    }
  | CensusObligationUnobservedBehindStage { stage: NativeCensusCauseStage }
  | CensusObligationUnobservedBehindAcquisitionBlock

type CensusObligationRow {
  module: String
  stage: NativeCensusCauseStage
  outcome: CensusObligationOutcome
}

type CensusModuleObligations {
  front_end: Optional<CensusObligationRow>
  resolve: Optional<CensusObligationRow>
  infer: Optional<CensusObligationRow>
}

type CensusRunCompletion
  = CensusRunComplete
  | CensusRunIncomplete

type CensusRunRecord {
  subject: String
  revision: MeasurementRevision
  scope: NativeCensusScope
  population: List<String>
  population_digest: Fnv1a64Structural
  obligations: List<CensusObligationRow>
  completion: CensusRunCompletion
}

type CensusRunDiffFinding
  = CensusDiffClearedAndNewlyExposed {
      cleared: CensusObligationRow
      newly_exposed: CensusObligationRow
    }
  | CensusDiffNowUnobservedBehindEarlierStage {
      before: CensusObligationRow
      behind: NativeCensusCauseStage
    }
  | CensusDiffScopeChanged { member: String }
  | CensusDiffUnobservedNotScopeChanged { member: String }
  | CensusDiffNewlyObservedNotRegression {
      member: String
      refusal: CensusObligationRow
    }
  | CensusDiffNewlyRefusing { after: CensusObligationRow }
  | CensusDiffIncompleteEvidence { member: Optional<String> }
  | CensusDiffLocationUpdate { before: CensusObligationRow, after: CensusObligationRow }
  | CensusDiffMemberAdded { member: String }
  | CensusDiffMemberRemoved { member: String }

type CensusRunDiff {
  revision_changed: Bool
  before_revision: MeasurementRevision
  after_revision: MeasurementRevision
  members_added: List<String>
  members_removed: List<String>
  findings: List<CensusRunDiffFinding>
}

type CensusRunDiffResult
  = CensusRunDiffSubjectRefused { before: String, after: String }
  | CensusRunDiffCompared { diff: CensusRunDiff }

fn census_population_digest(members: List<String>) -> Fnv1a64Structural {
  fold_list(
    xs: members,
    empty: content_hash_atom(value: "census-run-population-empty" as NonEmptyStr),
    cons: fn(acc, name) {
      content_hash_combine_structural(
        left: acc,
        right: content_hash_atom(value: name as NonEmptyStr)
      )
    }
  )
}

fn census_run_record(
  subject: String,
  revision: MeasurementRevision,
  scope: NativeCensusScope,
  population: List<String>,
  obligations: List<CensusObligationRow>,
  completion: CensusRunCompletion
) -> CensusRunRecord {
  CensusRunRecord {
    subject: subject,
    revision: revision,
    scope: scope,
    population: population,
    population_digest: census_population_digest(members: population),
    obligations: obligations,
    completion: completion
  }
}

fn census_obligation_row(module: String, stage: NativeCensusCauseStage, outcome: CensusObligationOutcome) -> CensusObligationRow {
  CensusObligationRow { module: module, stage: stage, outcome: outcome }
}

fn census_occurrence_from_locus(at: Locus) -> Optional<OccurrenceId> {
  match at {
    NodeLocus { anchor: a } => node_occurrence_id_optional(node: a.at)
    _ => optional_absent()
  }
}

fn census_extent_file_refusal_at(extent: Extent) -> FileRefusalAt {
  match extent {
    WholeFile => FileRefusalAtWholeFile
    ByteRange { start: _, end: _ } => FileRefusalAtUnresolvedNode
  }
}

fn census_file_refusal_at_from_locus(at: Locus) -> FileRefusalAt {
  match at {
    Textual { file: _, extent: e } => census_extent_file_refusal_at(extent: e)
    SourcePortLocus { anchor: _, file: _, extent: e } => census_extent_file_refusal_at(extent: e)
    InvariantPortLocus { anchor: _, invariant: inv } => FileRefusalAtInvariant { invariant: inv }
    DeclarationLocus { declaration: q } => FileRefusalAtDeclaration { declaration: q }
    NodeLocus { anchor: _ } => FileRefusalAtUnresolvedNode
  }
}

fn census_refused_from_diagnostics(first: NonEmptyDiagnostics, rest: List<NonEmptyDiagnostics>) -> CensusObligationOutcome {
  let fatal = diagnostics_fatal(d: first)
  CensusObligationRefused {
    reason: fatal.reason,
    at: census_file_refusal_at_from_locus(at: fatal.at),
    evidence: CensusRefusalDiagnostics { first: first, rest: rest },
    occurrence: census_occurrence_from_locus(at: fatal.at)
  }
}

fn census_refused_from_file_refusal(fr: NativeTestFileRefusal) -> CensusObligationOutcome {
  let link = native_test_file_refusal_fatal_link(fr: fr)
  CensusObligationRefused {
    reason: native_test_file_refusal_fatal_reason(fr: fr),
    at: link.at,
    evidence: CensusRefusalFileLinks { chain: fr.chain },
    occurrence: optional_absent()
  }
}

fn census_file_refused_without_chain() -> CensusObligationOutcome {
  CensusObligationRefused {
    reason: ^census_obligation_file_refused,
    at: FileRefusalAtUnresolvedNode,
    evidence: CensusRefusalUnlocated,
    occurrence: optional_absent()
  }
}

fn census_three_stage_rows(
  module: String,
  front_end: CensusObligationOutcome,
  resolve: CensusObligationOutcome,
  infer: CensusObligationOutcome
) -> List<CensusObligationRow> {
  [
    census_obligation_row(module: module, stage: NativeCensusCauseFrontEnd, outcome: front_end),
    census_obligation_row(module: module, stage: NativeCensusCauseResolve, outcome: resolve),
    census_obligation_row(module: module, stage: NativeCensusCauseInfer, outcome: infer)
  ]
}

fn census_unobserved_behind(stage: NativeCensusCauseStage) -> CensusObligationOutcome {
  CensusObligationUnobservedBehindStage { stage: stage }
}

// ONE MODULE'S NativeInferCensusOutcome PROJECTS TO THREE OBLIGATION ROWS. A front-end refused
// file is FrontEnd refused; Resolve and Infer are unobserved behind FrontEnd. A resolve refusal
// leaves FrontEnd passed and Infer unobserved behind Resolve. An inferred module passed every
// stage. An infer refusal passed FrontEnd and Resolve.
fn census_obligation_rows_from_infer(
  module: String,
  outcome: NativeInferCensusOutcome,
  file_refusal: Optional<NativeTestFileRefusal>
) -> List<CensusObligationRow> {
  match outcome {
    NativeInferCensusFileRefused =>
      let refused = match file_refusal {
        Present { value: fr } => census_refused_from_file_refusal(fr: fr)
        Absent => census_file_refused_without_chain()
      }
      census_three_stage_rows(
        module: module,
        front_end: refused,
        resolve: census_unobserved_behind(stage: NativeCensusCauseFrontEnd),
        infer: census_unobserved_behind(stage: NativeCensusCauseFrontEnd)
      )
    NativeInferCensusResolveRefused { first: first, rest: rest, observation: _ } =>
      census_three_stage_rows(
        module: module,
        front_end: CensusObligationPassed,
        resolve: census_refused_from_diagnostics(first: first, rest: rest),
        infer: census_unobserved_behind(stage: NativeCensusCauseResolve)
      )
    NativeInferCensusInferred { resolved: _, inferred: _ } =>
      census_three_stage_rows(
        module: module,
        front_end: CensusObligationPassed,
        resolve: CensusObligationPassed,
        infer: CensusObligationPassed
      )
    NativeInferCensusInferRefused { resolved: _, chain: chain } =>
      census_three_stage_rows(
        module: module,
        front_end: CensusObligationPassed,
        resolve: CensusObligationPassed,
        infer: census_refused_from_diagnostics(first: chain, rest: [])
      )
  }
}

fn census_member_block_front_end(refusal: CensusMemberRefusal) -> CensusObligationOutcome {
  match refusal {
    CensusMemberFrontEndRefused { file: _, diagnostics: d } =>
      census_refused_from_diagnostics(first: d, rest: [])
    CensusMemberSitesUnreadable { file: f } =>
      CensusObligationRefused {
        reason: ^census_member_sites_unreadable,
        at: FileRefusalAtUnresolvedNode,
        evidence: CensusRefusalMemberFile { file: f },
        occurrence: optional_absent()
      }
    CensusMemberIdentityDisagrees { file: f, declared: _ } =>
      CensusObligationRefused {
        reason: ^census_member_identity_disagrees,
        at: FileRefusalAtUnresolvedNode,
        evidence: CensusRefusalMemberFile { file: f },
        occurrence: optional_absent()
      }
  }
}

// A CensusMemberBlock is observed as FrontEnd refused; later stages are unobserved behind that
// block. An edge block is not a module row: it is the record's Blocked-scope incompleteness.
fn census_obligation_rows_from_member_block(block: CensusBlock) -> Optional<List<CensusObligationRow>> {
  match block {
    CensusEdgeBlock { refusal: _ } => optional_absent()
    CensusMemberBlock { module: m, refusal: r, content: _, host_directory: _, requesters: _ } =>
      optional_present(value: census_three_stage_rows(
        module: m,
        front_end: census_member_block_front_end(refusal: r),
        resolve: CensusObligationUnobservedBehindAcquisitionBlock,
        infer: CensusObligationUnobservedBehindAcquisitionBlock
      ))
  }
}

fn census_name_set(names: List<String>) -> Map<String, Bool> {
  fold_list(xs: names, empty: empty_map(), cons: fn(acc, n) { map_insert(m: acc, key: n, value: true) })
}

fn census_names_only_in(left: List<String>, right: Map<String, Bool>) -> List<String> {
  fold_list(xs: left, empty: Empty, cons: fn(acc, n) {
    if map_contains_key(m: right, key: n) {
      acc
    } else {
      list_snoc_item(xs: acc, item: n)
    }
  })
}

fn census_empty_module_obligations() -> CensusModuleObligations {
  CensusModuleObligations {
    front_end: optional_absent(),
    resolve: optional_absent(),
    infer: optional_absent()
  }
}

fn census_put_obligation(triple: CensusModuleObligations, row: CensusObligationRow) -> CensusModuleObligations {
  match row.stage {
    NativeCensusCauseFrontEnd =>
      CensusModuleObligations { front_end: optional_present(value: row), resolve: triple.resolve, infer: triple.infer }
    NativeCensusCauseResolve =>
      CensusModuleObligations { front_end: triple.front_end, resolve: optional_present(value: row), infer: triple.infer }
    NativeCensusCauseInfer =>
      CensusModuleObligations { front_end: triple.front_end, resolve: triple.resolve, infer: optional_present(value: row) }
  }
}

fn census_obligation_index(rows: List<CensusObligationRow>) -> Map<String, CensusModuleObligations> {
  fold_list(xs: rows, empty: empty_map(), cons: fn(acc, row) {
    match map_lookup(m: acc, key: row.module) {
      Absent => map_insert(m: acc, key: row.module, value: census_put_obligation(triple: census_empty_module_obligations(), row: row))
      Present { value: triple } => map_insert(m: acc, key: row.module, value: census_put_obligation(triple: triple, row: row))
    }
  })
}

fn census_index_stage(triple: CensusModuleObligations, stage: NativeCensusCauseStage) -> Optional<CensusObligationRow> {
  match stage {
    NativeCensusCauseFrontEnd => triple.front_end
    NativeCensusCauseResolve => triple.resolve
    NativeCensusCauseInfer => triple.infer
  }
}

fn census_first_refusal_in_triple(triple: CensusModuleObligations) -> Optional<CensusObligationRow> {
  match triple.front_end {
    Present { value: row } =>
      match row.outcome {
        CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } => optional_present(value: row)
        _ =>
          match triple.resolve {
            Present { value: rrow } =>
              match rrow.outcome {
                CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } => optional_present(value: rrow)
                _ =>
                  match triple.infer {
                    Present { value: irow } =>
                      match irow.outcome {
                        CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } => optional_present(value: irow)
                        _ => optional_absent()
                      }
                    Absent => optional_absent()
                  }
              }
            Absent =>
              match triple.infer {
                Present { value: irow } =>
                  match irow.outcome {
                    CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } => optional_present(value: irow)
                    _ => optional_absent()
                  }
                Absent => optional_absent()
              }
          }
      }
    Absent =>
      match triple.resolve {
        Present { value: rrow } =>
          match rrow.outcome {
            CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } => optional_present(value: rrow)
            _ =>
              match triple.infer {
                Present { value: irow } =>
                  match irow.outcome {
                    CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } => optional_present(value: irow)
                    _ => optional_absent()
                  }
                Absent => optional_absent()
              }
          }
        Absent =>
          match triple.infer {
            Present { value: irow } =>
              match irow.outcome {
                CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } => optional_present(value: irow)
                _ => optional_absent()
              }
            Absent => optional_absent()
          }
      }
  }
}

fn census_run_revision_eq(left: MeasurementRevision, right: MeasurementRevision) -> Bool {
  match left {
    GitRevision { commit: c } =>
      match right {
        GitRevision { commit: d } => c == d
        ContentFingerprint { digest: _ } => false
      }
    ContentFingerprint { digest: x } =>
      match right {
        ContentFingerprint { digest: y } => content_hash_eq_structural(left: x, right: y)
        GitRevision { commit: _ } => false
      }
  }
}

fn census_file_refusal_at_eq(left: FileRefusalAt, right: FileRefusalAt) -> Bool {
  match left {
    FileRefusalAtLine { line: ll, byte_column: lc } =>
      match right {
        FileRefusalAtLine { line: rl, byte_column: rc } => ll == rl && lc.value == rc.value
        _ => false
      }
    FileRefusalAtWholeFile =>
      match right {
        FileRefusalAtWholeFile => true
        _ => false
      }
    FileRefusalAtOtherFile { file: lf } =>
      match right {
        FileRefusalAtOtherFile { file: rf } => lf == rf
        _ => false
      }
    FileRefusalAtInvariant { invariant: li } =>
      match right {
        FileRefusalAtInvariant { invariant: ri } => li == ri
        _ => false
      }
    FileRefusalAtDeclaration { declaration: ld } =>
      match right {
        FileRefusalAtDeclaration { declaration: rd } => ld == rd
        _ => false
      }
    FileRefusalAtUnresolvedNode =>
      match right {
        FileRefusalAtUnresolvedNode => true
        _ => false
      }
  }
}

fn census_occurrence_eq(left: Optional<OccurrenceId>, right: Optional<OccurrenceId>) -> Bool {
  match left {
    Absent =>
      match right {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: a } =>
      match right {
        Absent => false
        Present { value: b } => a.value == b.value
      }
  }
}

fn census_diff_absent_member_findings(member: String, after: CensusRunRecord) -> List<CensusRunDiffFinding> {
  let removed = [CensusDiffMemberRemoved { member: member }]
  match after.completion {
    CensusRunIncomplete =>
      list_append(removed, [CensusDiffIncompleteEvidence { member: optional_present(value: member) }])
    CensusRunComplete =>
      match after.scope {
        NativeCensusScopeBlocked { subject: _, members: _, blocked_first: _, blocked_rest: _ } =>
          list_append(removed, [CensusDiffUnobservedNotScopeChanged { member: member }])
        NativeCensusScopeClosed { subject: _, members: _ } =>
          list_append(removed, [CensusDiffScopeChanged { member: member }])
      }
  }
}

fn census_diff_added_member_findings(
  member: String,
  after_index: Map<String, CensusModuleObligations>
) -> List<CensusRunDiffFinding> {
  let added = [CensusDiffMemberAdded { member: member }]
  match map_lookup(m: after_index, key: member) {
    Absent => added
    Present { value: triple } =>
      match census_first_refusal_in_triple(triple: triple) {
        Absent => added
        Present { value: row } =>
          list_append(added, [CensusDiffNewlyObservedNotRegression { member: member, refusal: row }])
      }
  }
}

fn census_diff_stage_pair(before_row: CensusObligationRow, after_row: CensusObligationRow) -> List<CensusRunDiffFinding> {
  match before_row.outcome {
    CensusObligationRefused { reason: br, at: ba, evidence: _, occurrence: bo } =>
      match after_row.outcome {
        CensusObligationUnobservedBehindStage { stage: behind } =>
          [CensusDiffNowUnobservedBehindEarlierStage { before: before_row, behind: behind }]
        CensusObligationUnobservedBehindAcquisitionBlock =>
          [CensusDiffNowUnobservedBehindEarlierStage { before: before_row, behind: NativeCensusCauseFrontEnd }]
        CensusObligationRefused { reason: ar, at: aa, evidence: _, occurrence: ao } =>
          if br == ar {
            if census_file_refusal_at_eq(left: ba, right: aa) && census_occurrence_eq(left: bo, right: ao) {
              []
            } else {
              [CensusDiffLocationUpdate { before: before_row, after: after_row }]
            }
          } else {
            [CensusDiffNewlyRefusing { after: after_row }]
          }
        CensusObligationPassed => []
      }
    CensusObligationPassed =>
      match after_row.outcome {
        CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } =>
          [CensusDiffNewlyRefusing { after: after_row }]
        _ => []
      }
    CensusObligationUnobservedBehindStage { stage: _ } => []
    CensusObligationUnobservedBehindAcquisitionBlock => []
  }
}

fn census_stage_behind_matches(outcome: CensusObligationOutcome, earlier: NativeCensusCauseStage) -> Bool {
  match outcome {
    CensusObligationUnobservedBehindAcquisitionBlock =>
      match earlier {
        NativeCensusCauseFrontEnd => true
        _ => false
      }
    CensusObligationUnobservedBehindStage { stage: s } =>
      match earlier {
        NativeCensusCauseFrontEnd =>
          match s {
            NativeCensusCauseFrontEnd => true
            _ => false
          }
        NativeCensusCauseResolve =>
          match s {
            NativeCensusCauseResolve => true
            _ => false
          }
        NativeCensusCauseInfer =>
          match s {
            NativeCensusCauseInfer => true
            _ => false
          }
      }
    _ => false
  }
}

fn census_diff_cleared_pair(
  before_earlier: Optional<CensusObligationRow>,
  after_earlier: Optional<CensusObligationRow>,
  before_later: Optional<CensusObligationRow>,
  after_later: Optional<CensusObligationRow>,
  earlier: NativeCensusCauseStage
) -> List<CensusRunDiffFinding> {
  match before_earlier {
    Absent => []
    Present { value: be } =>
      match after_earlier {
        Absent => []
        Present { value: ae } =>
          match be.outcome {
            CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } =>
              match ae.outcome {
                CensusObligationPassed =>
                  match before_later {
                    Absent => []
                    Present { value: bl } =>
                      match after_later {
                        Absent => []
                        Present { value: al } =>
                          if census_stage_behind_matches(outcome: bl.outcome, earlier: earlier) {
                            match al.outcome {
                              CensusObligationRefused { reason: _, at: _, evidence: _, occurrence: _ } =>
                                [CensusDiffClearedAndNewlyExposed { cleared: be, newly_exposed: al }]
                              _ => []
                            }
                          } else {
                            []
                          }
                      }
                  }
                _ => []
              }
            _ => []
          }
      }
  }
}

fn census_diff_cleared_and_exposed(before_t: CensusModuleObligations, after_t: CensusModuleObligations) -> List<CensusRunDiffFinding> {
  list_append(
    census_diff_cleared_pair(
      before_earlier: before_t.front_end,
      after_earlier: after_t.front_end,
      before_later: before_t.resolve,
      after_later: after_t.resolve,
      earlier: NativeCensusCauseFrontEnd
    ),
    list_append(
      census_diff_cleared_pair(
        before_earlier: before_t.resolve,
        after_earlier: after_t.resolve,
        before_later: before_t.infer,
        after_later: after_t.infer,
        earlier: NativeCensusCauseResolve
      ),
      census_diff_cleared_pair(
        before_earlier: before_t.front_end,
        after_earlier: after_t.front_end,
        before_later: before_t.infer,
        after_later: after_t.infer,
        earlier: NativeCensusCauseFrontEnd
      )
    )
  )
}

fn census_diff_lookup_pair(
  module: String,
  stage: NativeCensusCauseStage,
  before_t: CensusModuleObligations,
  after_t: CensusModuleObligations
) -> List<CensusRunDiffFinding> {
  match census_index_stage(triple: before_t, stage: stage) {
    Absent => [CensusDiffIncompleteEvidence { member: optional_present(value: module) }]
    Present { value: before_row } =>
      match census_index_stage(triple: after_t, stage: stage) {
        Absent => [CensusDiffIncompleteEvidence { member: optional_present(value: module) }]
        Present { value: after_row } => census_diff_stage_pair(before_row: before_row, after_row: after_row)
      }
  }
}

fn census_diff_common_member(
  module: String,
  before_t: CensusModuleObligations,
  after_t: CensusModuleObligations
) -> List<CensusRunDiffFinding> {
  list_append(
    list_append(
      census_diff_lookup_pair(module: module, stage: NativeCensusCauseFrontEnd, before_t: before_t, after_t: after_t),
      list_append(
        census_diff_lookup_pair(module: module, stage: NativeCensusCauseResolve, before_t: before_t, after_t: after_t),
        census_diff_lookup_pair(module: module, stage: NativeCensusCauseInfer, before_t: before_t, after_t: after_t)
      )
    ),
    census_diff_cleared_and_exposed(before_t: before_t, after_t: after_t)
  )
}

fn census_run_diff(before: CensusRunRecord, after: CensusRunRecord) -> CensusRunDiffResult {
  if before.subject != after.subject {
    CensusRunDiffSubjectRefused { before: before.subject, after: after.subject }
  } else {
    let before_set = census_name_set(names: before.population)
    let after_set = census_name_set(names: after.population)
    let added = census_names_only_in(left: after.population, right: before_set)
    let removed = census_names_only_in(left: before.population, right: after_set)
    let digest_changed = !content_hash_eq_structural(left: before.population_digest, right: after.population_digest)
    let before_index = census_obligation_index(rows: before.obligations)
    let after_index = census_obligation_index(rows: after.obligations)
    let added_findings = if digest_changed {
      fold_list(xs: added, empty: Empty, cons: fn(acc, m) {
        list_append(acc, census_diff_added_member_findings(member: m, after_index: after_index))
      })
    } else {
      Empty
    }
    let removed_findings = if digest_changed {
      fold_list(xs: removed, empty: Empty, cons: fn(acc, m) {
        list_append(acc, census_diff_absent_member_findings(member: m, after: after))
      })
    } else {
      Empty
    }
    let common = fold_list(xs: before.population, empty: Empty, cons: fn(acc, m) {
      if map_contains_key(m: after_set, key: m) {
        match map_lookup(m: before_index, key: m) {
          Absent => list_snoc_item(xs: acc, item: CensusDiffIncompleteEvidence { member: optional_present(value: m) })
          Present { value: before_t } =>
            match map_lookup(m: after_index, key: m) {
              Absent => list_snoc_item(xs: acc, item: CensusDiffIncompleteEvidence { member: optional_present(value: m) })
              Present { value: after_t } => list_append(acc, census_diff_common_member(module: m, before_t: before_t, after_t: after_t))
            }
        }
      } else {
        acc
      }
    })
    let incomplete = match before.completion {
      CensusRunIncomplete => [CensusDiffIncompleteEvidence { member: optional_absent() }]
      CensusRunComplete =>
        match after.completion {
          CensusRunIncomplete => [CensusDiffIncompleteEvidence { member: optional_absent() }]
          CensusRunComplete => Empty
        }
    }
    CensusRunDiffCompared {
      diff: CensusRunDiff {
        revision_changed: !census_run_revision_eq(left: before.revision, right: after.revision),
        before_revision: before.revision,
        after_revision: after.revision,
        members_added: added,
        members_removed: removed,
        findings: list_append(incomplete, list_append(added_findings, list_append(removed_findings, common)))
      }
    }
  }
}
