// SCRATCH — uncommitted local probe for SG2 arrow projection/serialize divergence. Delete before commit.
module v2.test.manual.sg2_scratch_probe

import v2.compiler.translate {
  translate_type_expression_project,
  target_serialize_source_from_model
}
import v2.extdeps.languages.rust {
  rust_sg2_arrow_source_type_node,
  rust_sg2_arrow_xy_emitted,
  rust_type_expression_projection,
  rust_sg2_type_expr_projection_probe_target_model
}
import v2.std.compilers.target_model {
  TargetModel,
  target_type_expr_emitted_kind,
  TypeExprKindAuthority,
  TypeExprKindNotEmitted,
  TypeExprKindAuthorityInvalid
}
import v2.std.node { Node, Symbol, content_hash }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }

data probe_target: TargetModel = rust_sg2_type_expr_projection_probe_target_model()

fn probe_arrow_projection_accepts() -> Bool {
  match translate_type_expression_project(
    node: rust_sg2_arrow_source_type_node(),
    target: probe_target,
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn probe_arrow_projection_reject_reason() -> Symbol {
  match translate_type_expression_project(
    node: rust_sg2_arrow_source_type_node(),
    target: probe_target,
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: _, diagnostics: _ } => ^probe_not_rejected
    Rejected { diagnostics: r } => r.head.reason
  }
}

// Probe the kind-authority detection on the GOLDEN node directly.
fn probe_golden_kind_is_authority() -> Bool {
  match target_type_expr_emitted_kind(node: rust_sg2_arrow_xy_emitted()) {
    TypeExprKindAuthority { value: _ } => true
    TypeExprKindNotEmitted => false
    TypeExprKindAuthorityInvalid => false
  }
}

fn probe_golden_kind_is_not_emitted() -> Bool {
  match target_type_expr_emitted_kind(node: rust_sg2_arrow_xy_emitted()) {
    TypeExprKindAuthority { value: _ } => false
    TypeExprKindNotEmitted => true
    TypeExprKindAuthorityInvalid => false
  }
}

// Does the golden arrow node serialize-accept through the probe target (empty rules)?
fn probe_golden_serialize_accepts() -> Bool {
  match target_serialize_source_from_model(
    target: probe_target,
    emitted: rust_sg2_arrow_xy_emitted()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
