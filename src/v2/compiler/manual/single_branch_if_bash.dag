module v2.test.manual.single_branch_if_bash

import v2.std.orchestration {
  Step,
  If,
  Do,
  Run,
  Pipeline,
  ExitZero,
  FailFast
}
import v2.std.collection { Absent }

data single_branch_if_marker_path: String = "marker"

data single_branch_if_then_command: String = "echo ok"

fn single_branch_if_cond_run() -> Run {
  Run {
    command: concat("test -f ", single_branch_if_marker_path),
    env: [],
    redirect: Absent,
    capture: Absent
  }
}

fn single_branch_if_then_run() -> Run {
  Run {
    command: single_branch_if_then_command,
    env: [],
    redirect: Absent,
    capture: Absent
  }
}

fn single_branch_if_intent() -> Step {
  If {
    cond: ExitZero { run: single_branch_if_cond_run() },
    then_: Pipeline {
      steps: [Do { run: single_branch_if_then_run() }],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn single_branch_if_hand_authored() -> String {
  concat(
    "if test -f ",
    concat(
      single_branch_if_marker_path,
      concat("; then ", concat(single_branch_if_then_command, "; fi"))
    )
  )
}
