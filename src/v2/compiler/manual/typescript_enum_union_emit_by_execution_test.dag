module v2.test.manual.typescript_enum_union_emit_by_execution

import v2.compiler.translate {
  translate_type_expression_project,
  target_serialize_source_from_model
}
import v2.extdeps.languages.typescript {
  ts_sg2_conj_xy_emitted,
  ts_sg2_disj_source_type_node,
  ts_sg2_sum_xy_emitted,
  ts_sg2_type_expr_target_model,
  ts_type_expression_projection
}
import v2.std.compilers.target_model {
  TargetTypeExprVariantSlot,
  target_type_expr_atom_emitted,
  target_type_expr_sum_emitted
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }

data ts_enum_union_canonical_source_text: String = "X | Y"
data ts_enum_union_emit_rejected_text: String = "TS_ENUM_UNION_EMIT_REJECTED"

fn ts_enum_union_serialized_text(emitted: Node) -> String {
  match target_serialize_source_from_model(
    target: ts_sg2_type_expr_target_model(),
    emitted: emitted
  ) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => ts_enum_union_emit_rejected_text
  }
}

fn ts_enum_union_projected_emitted() -> Node {
  match translate_type_expression_project(
    node: ts_sg2_disj_source_type_node(),
    target: ts_sg2_type_expr_target_model(),
    projection: ts_type_expression_projection()
  ) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => ts_sg2_conj_xy_emitted()
  }
}

fn ts_enum_union_swapped_variants_emitted() -> Node {
  target_type_expr_sum_emitted(
    form: ts_type_expression_projection().disj_form,
    variants: [
      TargetTypeExprVariantSlot {
        label: ^ts_binding_sg2_y,
        type_expr: target_type_expr_atom_emitted(
          form: ts_type_expression_projection().atom_form,
          identity: ^ts_binding_sg2_y
        )
      },
      TargetTypeExprVariantSlot {
        label: ^ts_binding_sg2_x,
        type_expr: target_type_expr_atom_emitted(
          form: ts_type_expression_projection().atom_form,
          identity: ^ts_binding_sg2_x
        )
      }
    ]
  )
}

test fn ts_enum_union_emit_by_execution_exact_holds() -> Bool {
  ts_enum_union_serialized_text(emitted: ts_sg2_sum_xy_emitted())
    == ts_enum_union_canonical_source_text
}

test fn ts_enum_union_projected_pipeline_emit_holds() -> Bool {
  ts_enum_union_serialized_text(emitted: ts_enum_union_projected_emitted())
    == ts_enum_union_canonical_source_text
}

test fn ts_enum_union_swapped_variants_discriminates_holds() -> Bool {
  (ts_enum_union_serialized_text(emitted: ts_sg2_sum_xy_emitted())
    == ts_enum_union_canonical_source_text)
    && (ts_enum_union_serialized_text(emitted: ts_enum_union_swapped_variants_emitted())
      != ts_enum_union_canonical_source_text)
    && (ts_enum_union_serialized_text(emitted: ts_enum_union_swapped_variants_emitted())
      != ts_enum_union_emit_rejected_text)
}

test fn ts_enum_union_construct_distinct_from_record_holds() -> Bool {
  ts_enum_union_serialized_text(emitted: ts_sg2_conj_xy_emitted())
    != ts_enum_union_canonical_source_text
}
