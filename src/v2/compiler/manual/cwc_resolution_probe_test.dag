// BOUNDARY-RECEIPT — v2 front-end n-ary-coproduct normalization gap (blocks C.i).
//
// WHAT THIS PROVES (green by execution today): the v2 front-end
// (tokenize→parse→normalize) lowers a coproduct `type` decl with **≤2 variants** but
// **rejects 3+ variants**. So no resolver-produced tree can carry a real multi-variant
// enum (e.g. github ReviewEvent = Approve|RequestChanges|Comment|Pending) — which is the
// input C.i ("v2 emit: module enum through fold into serde rename_all", node
// adhoc-e6f251cb-02a) needs to flow a real enum + its CoproductWireContract through the
// 06_translate fold into the rust_wire_serde serialize. C.i is therefore blocked UPSTREAM.
//
// THE GAP IS NOT a Disj well_formedness cap — Disj already accepts n-ary LabeledEdges with
// no arity bound (src/v2/std/node.dag:466). The gap is the coproduct-RHS lowering of the
// right-recursive `|` chain: dag_production_type_alias_rhs +
// dag_production_type_alias_rhs_repeat_suffix (src/v2/extdeps/languages/dag.dag:1496-1517)
// is NOT folded into a single n-ary Disj. Fix home: a normalize/sugar reduction in
// 03_normalize.dag / std.compilers.sugar (sugar_rule_type's SugarUnwrapPositionalChild
// unwraps the single RHS child and is NOT the arity gate).
//
// DISSOLUTION TRIGGER: when this witness flips RED, the chain→Disj fold has landed and 3+
// variant coproducts now normalize => C.i is UNBLOCKED. That red is EXPECTED, not a
// regression: go re-enable C.i (real enum + CoproductWireContract through the translate
// fold arm), then delete this receipt. (Probe receipt for the gate-conclusion under PR
// #5195; full method: drive tokenize→parse→normalize from a Source string via
// dag_language_model_wave1().)

module v2.test.manual.cwc_resolution_probe

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }
import v2.compiler.normalize { normalize }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.diagnostic { Accepted, Rejected, Outcome, bind_outcome }
import v2.std.logic { Bool }
import v2.std.node { Disj, Node, NodeFold, TypeNode, fold_node }

// ≤2-variant coproducts normalize; 3+ do not (the boundary this receipt locks).
data cwc_src_type_two: String = "module probe\ntype T = A | B\n"
data cwc_src_type_three: String = "module probe\ntype T = A | B | C\n"
data cwc_src_type_four: String = "module probe\ntype T = A | B | C | D\n"
data cwc_src_type_review: String = "module probe\ntype ReviewEvent = Approve | RequestChanges | Comment | Pending\n"

fn cwc_norm_of(src: String) -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(text: src, file: ^cwc_probe_file, rules: lm.lex),
    f: fn(toks) {
      bind_outcome(o: parse(tokens: toks, grammar: lm.grammar), f: fn(ptree) {
        normalize(parse_tree: ptree)
      })
    }
  )
}

fn cwc_norm_accepts(src: String) -> Bool {
  match cwc_norm_of(src: src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn cwc_norm_two_variant_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_two)
}

test fn cwc_norm_three_variant_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_three)
}

test fn cwc_norm_four_variant_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_four)
}

fn cwc_tree_has_disj(n: Node) -> Bool {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(_) { false },
      step: fn(acc, _edge, child_acc) {
        if acc {
          true
        } else if child_acc {
          true
        } else {
          match n.kind {
            TypeNode { connective: Disj } => true
            _ => false
          }
        }
      }
    }
  )
}

fn cwc_disj_arm_count(n: Node) -> Int {
  match n.kind {
    TypeNode { connective: Disj } => count(n.children)
    _ =>
      fold_node(
        n: n,
        algebra: NodeFold {
          init: fn(_) { 0 },
          step: fn(acc, _edge, child_count) {
            if acc > 0 {
              acc
            } else {
              child_count
            }
          }
        }
      )
  }
}

test fn cwc_norm_review_event_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_review)
}

test fn cwc_review_normalized_has_disj() -> Bool {
  match cwc_norm_of(src: cwc_src_type_review) {
    Accepted { value: root, diagnostics: _ } => cwc_tree_has_disj(n: root)
    Rejected { diagnostics: _ } => false
  }
}

test fn cwc_review_disj_has_four_arms() -> Bool {
  match cwc_norm_of(src: cwc_src_type_review) {
    Accepted { value: root, diagnostics: _ } => cwc_disj_arm_count(n: root) == 4
    Rejected { diagnostics: _ } => false
  }
}

// GREEN today (no Disj fold yet); flips when chain→Disj fold lands (see header).
test fn cwc_nary_coproduct_normalize_boundary_holds() -> Bool {
  cwc_norm_two_variant_accepts()
    && cwc_norm_three_variant_accepts()
    && (cwc_review_normalized_has_disj() == false)
    && (cwc_review_disj_has_four_arms() == false)
}
