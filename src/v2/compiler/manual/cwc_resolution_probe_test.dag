fn cwc_serialize_review_disj_accepts(target: TargetModel) -> Bool {
  let text = cwc_serialized_sum_text(src: cwc_src_cwc_module, target: target)
  text != ""
}

test fn cwc_review_disj_closedness_holds() -> Bool {
  match cwc_inferred_of(src: cwc_src_type_review) {
    Accepted { value: tree, diagnostics: _ } =>
      match cwc_optional_review_event_disj(n: tree.root) {
        Present { value: disj } =>
          match type_expression_projection_from_target(
            target: rust_wire_serde_screaming_snake_target
          ) {
            Accepted { value: base, diagnostics: _ } =>
              match type_expr_projection_row_closedness_from_target(
                target: rust_wire_serde_screaming_snake_target,
                projection: base,
                connective: Disj
              ) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn cwc_node_connective_tag(n: Node) -> Symbol {
  match n.kind {
    TypeNode { connective: Atom { identity: _ } } => ^Atom
    TypeNode { connective: Conj } => ^Conj
    TypeNode { connective: Disj } => ^Disj
    TypeNode { connective: Arrow } => ^Arrow
    TypeNode { connective: Cardinality } => ^Cardinality
    TypeNode { connective: Instantiation } => ^Instantiation
    ComputationNode { behavior: _ } => ^ComputationNode
  }
}

fn cwc_disj_first_variant_target_optional(n: Node) -> Optional<Node> {
  fold(
    n.children,
    init: optional_absent(),
    f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent => optional_present(value: e.target)
      }
    }
  )
}

test fn cwc_review_disj_first_variant_atom_sym_holds() -> Bool {
  match cwc_inferred_of(src: cwc_src_type_review) {
    Accepted { value: tree, diagnostics: _ } =>
      match cwc_optional_review_event_disj(n: tree.root) {
        Present { value: disj } =>
          match cwc_disj_first_variant_target_optional(n: disj) {
            Present { value: target } =>
              match tepe_atom_sym_optional(node: target) {
                Present { value: _ } => true
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

