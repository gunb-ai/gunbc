test fn cwc_enrichment_contract_naming_tag_holds() -> Bool {
  match cwc_inferred_of(src: cwc_src_cwc_module) {
    Accepted { value: tree, diagnostics: _ } =>
      match cwc_optional_review_event_disj(n: tree.root) {
        Present { value: disj } =>
          match tepe_build_coproduct_wire_contract_index(
            root: tree.root,
            field_coproduct: ^coproduct,
            field_encoding: ^encoding,
            type_coproduct_wire_contract: ^CoproductWireContract
          ) {
            Accepted { value: rows, diagnostics: _ } =>
              match tepe_contract_row_for_disj_anchor(
                rows: rows,
                root: tree.root,
                disj_anchor: disj
              ) {
                Present { value: contract } =>
                  match contract {
                    CoproductWireContractIndexRow { coproduct_sym: _, naming_tag: tag, decl: _ } =>
                      tag == ^ScreamingSnakeCase
                  }
                Absent => false
              }
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

