// BOUNDARY-RECEIPT — v2 front-end n-ary-coproduct normalization (unblocks C.i emit slice).
//
// WHAT THIS PROVES: tokenize→parse→normalize folds a multi-variant coproduct `type`
// alias RHS (`A | B | C | …`) into a single kernel Disj (not a parse Conj/pipe chain).
// C.i ("module enum through fold into serde rename_all") needs this Disj to flow a real
// enum + CoproductWireContract through 06_translate into rust_wire_serde serialize.
//
// Fix home: std.compilers.sugar `sugar_fold_coproduct_pipe_chain`, invoked from
// v2.compiler.normalize when the parse production identity is dag_surface_type_alias_rhs.

module v2.test.manual.cwc_resolution_probe

import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }
import v2.compiler.normalize { normalize }
import v2.compiler.resolve { resolve }
import v2.compiler.infer { infer, InferredTree }
import v2.compiler.translate {
  translate_type_expression_project,
  target_serialize_source_from_model,
  target_serialize_source_from_model_with_projection
}
import v2.compiler.type_expression_projection_enrichment {
  type_expression_projection_for_translate,
  tepe_data_decl_parts_present,
  tepe_data_decl_type_sym_optional,
  tepe_data_decl_field_value_optional,
  tepe_data_decl_coproduct_ref_sym_accepts,
  tepe_data_decl_encoding_naming_tag_accepts,
  tepe_data_decl_coproduct_row_present,
  tepe_wire_contract_index_nonempty,
  tepe_collect_data_decl_nodes,
  tepe_build_coproduct_wire_contract_index,
  tepe_target_bundle_optional_child,
  tepe_atom_sym_optional,
  tepe_disj_form_from_catalog,
  tepe_enum_sym_for_disj,
  tepe_lookup_contract_row,
  tepe_contract_row_for_disj_anchor
}
import v2.std.compilers.sugar { sugar_unwrap_production_shell }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.extdeps.languages.rust {
  rust_sg2_sum_xy_emitted,
  rust_sg2_type_expr_target_model
}
import v2.extdeps.languages.rust_wire_serde {
  rust_wire_serde_screaming_snake_target,
  rust_wire_serde_snake_case_target
}
import v2.std.compilers.target_model {
  TargetModel,
  type_expression_projection_from_target,
  type_expr_projection_row_closedness_from_target,
  target_type_expr_emitted_kind,
  TypeExprKindAuthority
}
import v2.std.algebra { is_empty }
import v2.std.collection {
  Absent,
  Optional,
  Present,
  list_at_optional,
  optional_absent,
  optional_present
}
import v2.std.diagnostic { Accepted, Rejected, Outcome, bind_outcome }
import v2.std.node { Disj, Node, NodeFold, TypeNode, fold_node }
import v2.std.node_query { find_named_child }
import v2.std.text { String }

// Multi-variant coproduct sources exercised by the n-ary Disj fold witnesses below.
data cwc_src_type_two: String = "module probe\ntype T = A | B\n"
data cwc_src_type_three: String = "module probe\ntype T = A | B | C\n"
data cwc_src_type_review: String = "module probe\ntype ReviewEvent = Approve | RequestChanges | Comment | Pending\n"

// Non-coproduct RHS: single type reference, not a pipe chain — fold is not-applicable.
data cwc_src_type_scalar: String = "module probe\ntype T = Int\n"

// Malformed n-ary coproduct: record variant without a top-level atom identity (≥2 arms).
data cwc_src_type_malformed_coproduct: String = "module probe\ntype T = { x: Int } | B | C\n"

// DeclarationRef as ident (parse stamps ^ReviewEvent); quoted string literal is forward work.
data cwc_src_cwc_module: String = "module probe\ntype VariantNaming = AsAuthored | ScreamingSnakeCase\ntype VariantEncoding = StringVariant { naming: VariantNaming }\ntype CoproductWireContract { coproduct: String, encoding: VariantEncoding }\ntype ReviewEvent = Approve | RequestChanges | Comment | Pending\ndata review_event_wire_contract: CoproductWireContract = { coproduct: ReviewEvent, encoding: StringVariant { naming: ScreamingSnakeCase } }\n"

// Present-but-broken wire contract: CoproductWireContract row missing coproduct field.
data cwc_src_malformed_wire_contract: String = "module probe\ntype VariantNaming = ScreamingSnakeCase\ntype VariantEncoding = StringVariant { naming: VariantNaming }\ntype CoproductWireContract { coproduct: String, encoding: VariantEncoding }\ntype ReviewEvent = Approve | RequestChanges\ndata review_event_wire_contract: CoproductWireContract = { encoding: StringVariant { naming: ScreamingSnakeCase } }\n"

data cwc_expected_sum_regression_text: String = "X | Y"

fn cwc_norm_of(src: String) -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(text: src, file: ^cwc_probe_file, rules: lm.lex),
    f: fn(toks) {
      bind_outcome(o: parse(tokens: toks, grammar: lm.grammar), f: fn(ptree) {
        normalize(parse_tree: ptree)
      })
    }
  )
}

fn cwc_norm_accepts(src: String) -> Bool {
  match cwc_norm_of(src: src) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn cwc_norm_two_variant_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_two)
}

test fn cwc_norm_three_variant_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_three)
}

fn cwc_tree_has_disj(n: Node) -> Bool {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(node) {
        match node.kind {
          TypeNode { connective: Disj } => true
          _ => false
        }
      },
      step: fn(acc, _edge, child_acc) {
        if acc {
          true
        } else {
          child_acc
        }
      }
    }
  )
}

fn cwc_disj_arm_count(n: Node) -> Int {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(node) {
        match node.kind {
          TypeNode { connective: Disj } => count(node.children)
          _ => 0
        }
      },
      step: fn(acc, _edge, child_acc) {
        if acc > 0 {
          acc
        } else {
          child_acc
        }
      }
    }
  )
}

fn cwc_norm_rejects(src: String) -> Bool {
  match cwc_norm_of(src: src) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

test fn cwc_non_coproduct_rhs_passes_through() -> Bool {
  match cwc_norm_of(src: cwc_src_type_scalar) {
    Accepted { value: root, diagnostics: _ } => !cwc_tree_has_disj(n: root)
    Rejected { diagnostics: _ } => false
  }
}

test fn cwc_malformed_nary_coproduct_normalize_rejects() -> Bool {
  // Rejected carries NonEmptyDiagnostics (located by type); goes RED if swallow returns Accepted.
  cwc_norm_rejects(src: cwc_src_type_malformed_coproduct)
}

// §5 red control (bundled only — must NOT be a standalone test fn: discovery expects PASS=true).
fn cwc_malformed_nary_coproduct_fail_open_control() -> Bool {
  !cwc_norm_rejects(src: cwc_src_type_malformed_coproduct)
}

test fn cwc_norm_review_event_accepts() -> Bool {
  cwc_norm_accepts(src: cwc_src_type_review)
}

fn cwc_resolve_accepts(src: String) -> Bool {
  let lm = dag_language_model_wave1()
  match cwc_norm_of(src: src) {
    Accepted { value: tree, diagnostics: _ } =>
      match resolve(tree: tree, lm: lm) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// C.i gate: full module with enum + CoproductWireContract resolves after n-ary Disj fold.
test fn cwc_cwc_module_resolve_accepts() -> Bool {
  cwc_resolve_accepts(src: cwc_src_cwc_module)
}

test fn cwc_review_normalized_has_disj() -> Bool {
  match cwc_norm_of(src: cwc_src_type_review) {
    Accepted { value: root, diagnostics: _ } => cwc_tree_has_disj(n: root)
    Rejected { diagnostics: _ } => false
  }
}

test fn cwc_review_disj_has_four_arms() -> Bool {
  match cwc_norm_of(src: cwc_src_type_review) {
    Accepted { value: root, diagnostics: _ } => cwc_disj_arm_count(n: root) == 4
    Rejected { diagnostics: _ } => false
  }
}

// GREEN when chain→Disj fold lands: multi-variant coproduct normalizes to kernel Disj.
test fn cwc_nary_coproduct_normalize_boundary_holds() -> Bool {
  cwc_norm_two_variant_accepts()
    && cwc_norm_three_variant_accepts()
    && cwc_review_normalized_has_disj()
    && cwc_review_disj_has_four_arms()
    && cwc_cwc_module_resolve_accepts()
    && cwc_non_coproduct_rhs_passes_through()
    && cwc_malformed_nary_coproduct_normalize_rejects()
    && !cwc_malformed_nary_coproduct_fail_open_control()
}

fn cwc_inferred_of(src: String) -> Outcome<InferredTree> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: cwc_norm_of(src: src),
    f: fn(tree) {
      bind_outcome(
        o: resolve(tree: tree, lm: lm),
        f: fn(resolved) {
          infer(tree: resolved)
        }
      )
    }
  )
}

fn cwc_optional_review_event_disj(n: Node) -> Optional<Node> {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(node) {
        match node.kind {
          TypeNode { connective: Disj } =>
            if cwc_disj_arm_count(n: node) == 4 {
              optional_present(value: node)
            } else {
              optional_absent()
            }
          _ => optional_absent()
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } => acc
          Absent => child_acc
        }
      }
    }
  )
}

fn cwc_translate_project_disj_accepts(src: String, target: TargetModel) -> Bool {
  match cwc_inferred_of(src: src) {
    Accepted { value: tree, diagnostics: _ } =>
      match cwc_optional_review_event_disj(n: tree.root) {
        Present { value: disj } =>
          match type_expression_projection_for_translate(
            tree: tree,
            target: target,
            node: disj
          ) {
            Accepted { value: projection, diagnostics: _ } =>
              match translate_type_expression_project(
                node: disj,
                target: target,
                projection: projection
              ) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn cwc_inferred_review_disj_present() -> Bool {
  match cwc_inferred_of(src: cwc_src_cwc_module) {
    Accepted { value: tree, diagnostics: _ } =>
      match cwc_optional_review_event_disj(n: tree.root) {
        Present { value: _ } => true
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}

