fn cwc_serialized_sum_text_for_src(src: String, target: TargetModel) -> String {
  match cwc_inferred_of(src: src) {
    Accepted { value: tree, diagnostics: _ } =>
      match cwc_optional_review_event_disj(n: tree.root) {
        Present { value: disj } =>
          match type_expression_projection_for_translate(
            tree: tree,
            target: target,
            node: disj
          ) {
            Accepted { value: projection, diagnostics: _ } =>
              match translate_type_expression_project(
                node: disj,
                target: target,
                projection: projection
              ) {
                Accepted { value: emitted, diagnostics: _ } =>
                  match target_serialize_source_from_model_with_projection(
                    target: target,
                    emitted: emitted,
                    projection: projection
                  ) {
                    Accepted { value: source, diagnostics: _ } => source.carried
                    Rejected { diagnostics: _ } => ""
                  }
                Rejected { diagnostics: _ } => ""
              }
            Rejected { diagnostics: _ } => ""
          }
        Absent => ""
      }
    Rejected { diagnostics: _ } => ""
  }
}

fn cwc_serialized_sum_text(src: String, target: TargetModel) -> String {
  cwc_serialized_sum_text_for_src(src: src, target: target)
}

fn cwc_sg2_module_sum_text() -> String {
  cwc_serialized_sum_text_for_src(
    src: cwc_src_cwc_module,
    target: rust_sg2_type_expr_target_model()
  )
}

fn cwc_wire_serde_base_body_text(target: TargetModel) -> String {
  match cwc_inferred_of(src: cwc_src_cwc_module) {
    Accepted { value: tree, diagnostics: _ } =>
      match cwc_optional_review_event_disj(n: tree.root) {
        Present { value: disj } =>
          match type_expression_projection_from_target(target: target) {
            Accepted { value: base, diagnostics: _ } =>
              match translate_type_expression_project(
                node: disj,
                target: target,
                projection: base
              ) {
                Accepted { value: emitted, diagnostics: _ } =>
                  match target_serialize_source_from_model_with_projection(
                    target: target,
                    emitted: emitted,
                    projection: base
                  ) {
                    Accepted { value: source, diagnostics: _ } => source.carried
                    Rejected { diagnostics: _ } => ""
                  }
                Rejected { diagnostics: _ } => ""
              }
            Rejected { diagnostics: _ } => ""
          }
        Absent => ""
      }
    Rejected { diagnostics: _ } => ""
  }
}

fn cwc_wire_serde_enriched_sum_text(target: TargetModel) -> String {
  cwc_serialized_sum_text(src: cwc_src_cwc_module, target: target)
}

test fn cwc_translate_serde_rename_all_holds() -> Bool {
  let screaming = cwc_wire_serde_enriched_sum_text(
    target: rust_wire_serde_screaming_snake_target
  )
  let body = cwc_wire_serde_base_body_text(
    target: rust_wire_serde_screaming_snake_target
  )
  screaming != "" && body != "" && screaming != body
}

test fn cwc_translate_serde_wrong_naming_red() -> Bool {
  let snake = cwc_wire_serde_enriched_sum_text(target: rust_wire_serde_snake_case_target)
  let body = cwc_wire_serde_base_body_text(target: rust_wire_serde_snake_case_target)
  snake != "" && body != "" && snake != body
}

fn cwc_translate_serde_fail_open_control() -> Bool {
  let screaming = cwc_wire_serde_enriched_sum_text(
    target: rust_wire_serde_screaming_snake_target
  )
  cwc_sg2_module_sum_text() == screaming
}

test fn cwc_translate_malformed_wire_contract_rejects() -> Bool {
  !cwc_translate_project_disj_accepts(
    src: cwc_src_malformed_wire_contract,
    target: rust_wire_serde_screaming_snake_target
  )
}

fn cwc_sg2_sum_serialized_text() -> String {
  match target_serialize_source_from_model(
    target: rust_sg2_type_expr_target_model(),
    emitted: rust_sg2_sum_xy_emitted()
  ) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => ""
  }
}

test fn cwc_sum_leading_tokens_regression_byte_unchanged() -> Bool {
  cwc_sg2_sum_serialized_text() == cwc_expected_sum_regression_text
}

test fn cwc_translate_serde_boundary_holds() -> Bool {
  cwc_translate_serde_rename_all_holds()
    && cwc_translate_serde_wrong_naming_red()
    && !cwc_translate_serde_fail_open_control()
    && cwc_translate_malformed_wire_contract_rejects()
    && cwc_sum_leading_tokens_regression_byte_unchanged()
}
