fn cwc_disj_all_variant_targets_are_atoms(n: Node) -> Bool {
  fold(
    n.children,
    init: true,
    f: fn(acc, e) {
      if acc {
        match e.target.kind {
          TypeNode { connective: Atom { identity: _ } } => true
          _ => false
        }
      } else {
        false
      }
    }
  )
}

