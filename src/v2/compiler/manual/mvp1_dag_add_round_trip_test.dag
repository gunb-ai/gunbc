module v2.test.manual.mvp1_dag_add_round_trip

import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.translate {
  coerce_grounded_node,
  grammar_inverse_source_validated,
  target_serialize_source_from_model,
  translate_emitted_node
}
import v2.extdeps.languages.dag {
  dag_inhabitant_atom,
  dag_mvp1_arrow_domain_conj_node,
  dag_mvp1_fixture_emitted_add_fn,
  dag_mvp1_fixture_int_inhabitant,
  dag_mvp1_target_model
}
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
import v2.std.cardinality { termination_proof_witness_for_node }
import v2.std.collection { Map }
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.coercion { CoercionQuality, Exact, Identity, Widened }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.compilers.target_model { TargetModel }
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }

import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
data mvp1_dag_emitted_root: Node = dag_mvp1_fixture_emitted_add_fn

data mvp1_dag_target_model: TargetModel = dag_mvp1_target_model()

fn mvp1_dag_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn mvp1_dag_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == dag_mvp1_fixture_emitted_add_fn {
    Holds {
      value: mvp1_dag_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == dag_mvp1_fixture_int_inhabitant {
    Holds {
      value: mvp1_dag_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_inhabitant_int) {
    Holds {
      value: mvp1_dag_canonical_grounding(
        node: node,
        algebra: dag_mvp1_fixture_int_inhabitant
      )
    }
  } else if node == dag_inhabitant_atom(id: ^dag_surface_spelling_int) {
    Holds {
      value: mvp1_dag_canonical_grounding(
        node: node,
        algebra: dag_mvp1_fixture_int_inhabitant
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^mvp1_dag_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn mvp1_dag_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match mvp1_dag_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn mvp1_dag_facts_lookup(key: Node) -> Witness<InferredFacts> {
  mvp1_dag_inferred_facts_for(node: key)
}

data mvp1_dag_inferred_tree: InferredTree = InferredTree {
  root: mvp1_dag_emitted_root,
  facts: Map {
    lookup: mvp1_dag_facts_lookup
  }
}

fn anchor_mvp1_dag_emit_accepts() -> Outcome<Medium<String>> {
  emit(tree: mvp1_dag_inferred_tree, target: mvp1_dag_target_model)
}

data mvp1_dag_emit_receipt: Outcome<Medium<String>> = anchor_mvp1_dag_emit_accepts()

fn mvp1_dag_coercion_quality_is_faithful(q: CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

test fn mvp1_dag_emit_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: mvp1_dag_target_model,
    emitted: mvp1_dag_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match mvp1_dag_emit_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: mvp1_dag_target_model,
    emitted: mvp1_dag_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: mvp1_dag_emitted_root,
    tree: mvp1_dag_inferred_tree,
    target: mvp1_dag_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_mvp1_fixture_emitted_add_fn)
        && mvp1_dag_coercion_quality_is_faithful(q: result.quality)
        && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_add_domain_coerce_accepts_holds() -> Bool {
  match coerce_grounded_node(
    source: dag_mvp1_arrow_domain_conj_node(),
    tree: mvp1_dag_inferred_tree,
    target: mvp1_dag_target_model
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_add_domain_translate_accepts_holds() -> Bool {
  match translate_emitted_node(
    tree: InferredTree {
      root: dag_mvp1_arrow_domain_conj_node(),
      facts: Map { lookup: mvp1_dag_facts_lookup }
    },
    target: mvp1_dag_target_model
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_translate_accepts_holds() -> Bool {
  match translate_emitted_node(tree: mvp1_dag_inferred_tree, target: mvp1_dag_target_model) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_emit_add_fn_accepts_holds() -> Bool {
  mvp1_dag_emit_matches_serialize_holds()
}

test fn mvp1_dag_add_emit_ingest_round_trip_holds() -> Bool {
  mvp1_dag_emit_add_fn_accepts_holds()
    && mvp1_dag_grammar_inverse_holds()
    && mvp1_dag_ingest_via_coerce_matches_canonical()
}
