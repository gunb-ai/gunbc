// §5 negative control: explicit type mismatch must fail inference (fail-closed).
module v2.test.manual.pbp_body_producer_wrong_type_repro

import v2.compiler.body_producer { produce_mvp1_add_arrow_with_body_from_resolved }
import v2.std.logic { Bool }
import v2.std.text { String }

type Refined<T> {
  base: T
}
type UserId = Refined<String>
type AccountId = Refined<String>

fn take_acct(acct: AccountId) -> String {
  ""
}

fn pbp_wrong() -> Bool {
  let uid = Refined { base: "" }
  take_acct(acct: uid) == ""
}
