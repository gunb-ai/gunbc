// Ephemeral probe — delete after sunny-bat-350 relay.
module v2.test.manual.parse_hang_probe

import v2.compiler.parse { parse, parse_module }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model_wave1, dag_mvp1_source_text }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Symbol }

data probe_file: Symbol = probe_file
data probe_fn_add: String = dag_mvp1_source_text
data probe_module_fn: String = "module probe_mod\nfn fna(x:Int, y:Int) -> Int { x + y }"
data probe_module_data: String = "module probe_peer\ndata probe_export: Symbol = probe_export"

test fn probe_tokenize_fn_add_holds() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: probe_fn_add, file: probe_file, rules: lm.lex) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn probe_parse_module_fn_add_holds() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: probe_fn_add, file: probe_file, rules: lm.lex) {
    Accepted { value: stream, diagnostics: _ } =>
      match parse_module(tokens: stream, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn probe_parse_fn_add_holds() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: probe_fn_add, file: probe_file, rules: lm.lex) {
    Accepted { value: stream, diagnostics: _ } =>
      match parse(tokens: stream, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn probe_parse_module_multi_decl_holds() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(text: probe_module_data, file: probe_file, rules: lm.lex) {
    Accepted { value: stream, diagnostics: _ } =>
      match parse_module(tokens: stream, grammar: lm.grammar) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
