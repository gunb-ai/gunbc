module v2.test.manual.emit_directive_gha

import v2.compiler.emit { emit }
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Medium }
import v2.extdeps.languages.bash {
  emit_directive_bash_emitted_command,
  emit_directive_bash_target_model
}
import v2.extdeps.github.diagnostic_emit { emit_directive_gha_target_model }
import v2.std.collection { Map }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  EmitDirective,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  SeverityError,
  SeverityWarning,
  Unavailable,
  node_locus
}
import v2.std.node { Node }
import v2.std.witness { Violates, Witness }

fn emit_directive_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^emit_directive_gha_facts_unexpected_consultation,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

data emit_directive_gha_error_example: EmitDirective = EmitDirective {
  severity: SeverityError,
  message: "build verification failed"
}

data emit_directive_gha_warning_example: EmitDirective = EmitDirective {
  severity: SeverityWarning,
  message: "build verification failed"
}

data emit_directive_gha_other_example: EmitDirective = EmitDirective {
  severity: SeverityError,
  message: "cache corruption"
}

data emit_directive_gha_error_expected: String = "'echo' '::error::build verification failed' >&2"
data emit_directive_gha_warning_expected: String = "'echo' '::warning::build verification failed' >&2"
data emit_directive_gha_other_expected: String = "'echo' '::error::cache corruption' >&2"

fn emit_directive_gha_emit(d: EmitDirective) -> Outcome<Medium<String>> {
  emit(
    tree: InferredTree {
      root: emit_directive_bash_emitted_command,
      facts: Map { lookup: emit_directive_facts_lookup }
    },
    target: emit_directive_gha_target_model(d: d)
  )
}

fn emit_directive_bash_emit(d: EmitDirective) -> Outcome<Medium<String>> {
  emit(
    tree: InferredTree {
      root: emit_directive_bash_emitted_command,
      facts: Map { lookup: emit_directive_facts_lookup }
    },
    target: emit_directive_bash_target_model(d: d)
  )
}

test fn emit_directive_gha_error_emits_error_annotation_holds() -> Bool {
  match emit_directive_gha_emit(d: emit_directive_gha_error_example) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == emit_directive_gha_error_expected) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_directive_gha_warning_emits_warning_annotation_holds() -> Bool {
  match emit_directive_gha_emit(d: emit_directive_gha_warning_example) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == emit_directive_gha_warning_expected) && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_directive_gha_severity_variant_holds() -> Bool {
  match emit_directive_gha_emit(d: emit_directive_gha_error_example) {
    Accepted { value: se, diagnostics: _ } =>
      match emit_directive_gha_emit(d: emit_directive_gha_warning_example) {
        Accepted { value: sw, diagnostics: _ } => se.carried != sw.carried
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_directive_gha_message_flows_holds() -> Bool {
  match emit_directive_gha_emit(d: emit_directive_gha_error_example) {
    Accepted { value: s1, diagnostics: _ } =>
      match emit_directive_gha_emit(d: emit_directive_gha_other_example) {
        Accepted { value: s2, diagnostics: _ } =>
          (s2.carried == emit_directive_gha_other_expected) && (s1.carried != s2.carried)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_directive_gha_distinct_from_bash_holds() -> Bool {
  match emit_directive_gha_emit(d: emit_directive_gha_error_example) {
    Accepted { value: g, diagnostics: _ } =>
      match emit_directive_bash_emit(d: emit_directive_gha_error_example) {
        Accepted { value: b, diagnostics: _ } => g.carried != b.carried
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
