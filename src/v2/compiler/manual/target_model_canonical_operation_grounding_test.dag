module v2.test.manual.target_model_canonical_operation_grounding

import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.compilers.target_model {
  CanonicalOperation,
  InfixToken,
  canonical_operation_op_add,
  canonical_operation_op_sub,
  canonical_operation_op_mul,
  canonical_operation_op_div,
  canonical_operation_op_and,
  canonical_operation_op_or,
  canonical_operation_op_not,
  canonical_operation_op_less,
  canonical_operation_op_less_or_equal,
  canonical_operation_op_greater,
  canonical_operation_op_greater_or_equal,
  canonical_operation_op_equal,
  canonical_operation_op_not_equal,
  canonical_operation_equal,
  canonical_operation_from_wire_node,
  target_model_canonical_operation_wire_node,
  target_operator_realization_catalog_lookup,
  target_operator_realization_node,
  target_operator_realizations_catalog_node
}

fn op_round_trips(op: CanonicalOperation) -> Bool {
  match canonical_operation_from_wire_node(
    wire: target_model_canonical_operation_wire_node(operation: op)
  ) {
    Accepted { value: decoded, diagnostics: _ } =>
      canonical_operation_equal(left: decoded, right: op)
    Rejected { diagnostics: _ } => false
  }
}

fn ops_distinct(left: CanonicalOperation, right: CanonicalOperation) -> Bool {
  match canonical_operation_equal(left: left, right: right) {
    true => false
    false => true
  }
}

fn mul_only_catalog() -> Node {
  target_operator_realizations_catalog_node(
    rows: [
      target_operator_realization_node(
        operation: canonical_operation_op_mul(),
        shape: InfixToken { token: ^rust_token_star }
      )
    ]
  )
}

test fn arith_ops_round_trip() -> Bool {
  op_round_trips(op: canonical_operation_op_add()) &&
  op_round_trips(op: canonical_operation_op_sub()) &&
  op_round_trips(op: canonical_operation_op_mul()) &&
  op_round_trips(op: canonical_operation_op_div())
}

test fn boolean_ops_round_trip() -> Bool {
  op_round_trips(op: canonical_operation_op_and()) &&
  op_round_trips(op: canonical_operation_op_or()) &&
  op_round_trips(op: canonical_operation_op_not())
}

test fn comparison_ops_round_trip() -> Bool {
  op_round_trips(op: canonical_operation_op_less()) &&
  op_round_trips(op: canonical_operation_op_less_or_equal()) &&
  op_round_trips(op: canonical_operation_op_greater()) &&
  op_round_trips(op: canonical_operation_op_greater_or_equal()) &&
  op_round_trips(op: canonical_operation_op_equal()) &&
  op_round_trips(op: canonical_operation_op_not_equal())
}

test fn distinct_algebra_fields_discriminate() -> Bool {
  ops_distinct(left: canonical_operation_op_add(), right: canonical_operation_op_sub()) &&
  ops_distinct(left: canonical_operation_op_add(), right: canonical_operation_op_mul()) &&
  ops_distinct(left: canonical_operation_op_mul(), right: canonical_operation_op_div()) &&
  ops_distinct(left: canonical_operation_op_and(), right: canonical_operation_op_or())
}

test fn shared_compare_field_relations_discriminate() -> Bool {
  ops_distinct(left: canonical_operation_op_less(), right: canonical_operation_op_less_or_equal()) &&
  ops_distinct(left: canonical_operation_op_less(), right: canonical_operation_op_greater()) &&
  ops_distinct(left: canonical_operation_op_equal(), right: canonical_operation_op_not_equal()) &&
  ops_distinct(left: canonical_operation_op_greater(), right: canonical_operation_op_greater_or_equal())
}

test fn cross_family_ops_discriminate() -> Bool {
  ops_distinct(left: canonical_operation_op_add(), right: canonical_operation_op_less()) &&
  ops_distinct(left: canonical_operation_op_equal(), right: canonical_operation_op_add())
}

test fn same_op_is_equal() -> Bool {
  canonical_operation_equal(
    left: canonical_operation_op_less_or_equal(),
    right: canonical_operation_op_less_or_equal()
  ) &&
  canonical_operation_equal(
    left: canonical_operation_op_sub(),
    right: canonical_operation_op_sub()
  )
}

test fn catalog_lookup_accepts_grounded_op() -> Bool {
  match target_operator_realization_catalog_lookup(
    catalog: mul_only_catalog(),
    canonical_op: canonical_operation_op_mul()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn catalog_lookup_misses_absent_op() -> Bool {
  match target_operator_realization_catalog_lookup(
    catalog: mul_only_catalog(),
    canonical_op: canonical_operation_op_add()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
