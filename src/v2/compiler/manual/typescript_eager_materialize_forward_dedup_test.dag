// FINISH-LINE-B Arc 1 — dedup-cutover forward selection (isolated entry: avoids OOM from fat test closure).
module v2.test.manual.typescript_eager_materialize_forward_dedup

import v2.extdeps.languages.typescript {
  ts_named_edge,
  ts_wave2a_task_type_alias_emitted,
  ts_wave2a_task_type_alias_relation_row_witness
}
import v2.std.algebra { Empty, list_append, zip_eq }
import v2.std.collection { List }
import v2.std.compilers.target_model {
  concrete_syntax_token_class,
  concrete_syntax_token_list_from_node
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node {
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.node_query { find_named_child }
import v2.std.witness { Holds, Violates }

fn ts_arc1_row_token_spine_classes(row: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: Empty,
            f: fn(acc, t) {
              list_append(
                left: acc,
                right: [concrete_syntax_token_class(token: t)]
              )
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

type TsArc1ForwardRowSelection
  = TsArc1ForwardRowNone
  | TsArc1ForwardRowOne { emitted: Node }
  | TsArc1ForwardRowMany

fn ts_arc1_forward_row_select_step(
  acc: TsArc1ForwardRowSelection,
  frontier: List<Symbol>,
  row: Node
) -> TsArc1ForwardRowSelection {
  match ts_arc1_row_token_spine_classes(row: row) {
    Rejected { diagnostics: _ } => acc
    Accepted { value: spine, diagnostics: _ } =>
      if zip_eq(a: frontier, b: spine, eq: fn(x, y) { x == y }) {
        match find_named_child(root: row, name: ^grammar_relation_field_emitted) {
          Rejected { diagnostics: _ } => acc
          Accepted { value: row_emitted, diagnostics: _ } =>
            match acc {
              TsArc1ForwardRowNone => TsArc1ForwardRowOne { emitted: row_emitted }
              TsArc1ForwardRowOne { emitted: _ } => TsArc1ForwardRowMany
              TsArc1ForwardRowMany => TsArc1ForwardRowMany
            }
        }
      } else {
        acc
      }
  }
}

fn ts_arc1_grammar_relation_row_forward_selection(
  frontier: List<Symbol>,
  rules: Node
) -> Outcome<Node> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      match fold(
        rules.children,
        init: TsArc1ForwardRowNone,
        f: fn(acc, e) {
          match e.label {
            Named { name: _ } =>
              ts_arc1_forward_row_select_step(acc: acc, frontier: frontier, row: e.target)
            Positional => acc
          }
        }
      ) {
        TsArc1ForwardRowOne { emitted: emitted } => outcome_accepted(value: emitted)
        TsArc1ForwardRowMany =>
          outcome_rejected(d: Diagnostic {
            reason: ^parse_tree_to_emitted_node_ambiguous_row,
            at: node_locus(node: rules),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
        TsArc1ForwardRowNone =>
          outcome_rejected(d: Diagnostic {
            reason: ^parse_tree_to_emitted_node_no_matching_row,
            at: node_locus(node: rules),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
      }
    _ =>
      outcome_rejected(d: Diagnostic {
        reason: ^parse_tree_to_emitted_node_no_matching_row,
        at: node_locus(node: rules),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}

fn ts_arc1_wave2a_rules_with_duplicate_spine_rows() -> Node {
  match ts_wave2a_task_type_alias_relation_row_witness() {
    Holds { value: eager_row } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ts_named_edge(
            name: ^ts_relation_rule_type_alias_task,
            target: eager_row
          ),
          ts_named_edge(
            name: ^ts_arc1_forward_row_many_collision_dup,
            target: eager_row
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    Violates { diagnostic: _ } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn ts_arc1_wave2a_dedup_cutover_rules() -> Node {
  match ts_wave2a_task_type_alias_relation_row_witness() {
    Holds { value: eager_row } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ts_named_edge(
            name: ^ts_relation_rule_type_alias_task,
            target: eager_row
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    Violates { diagnostic: _ } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn ts_arc1_forward_row_many_without_dedup_red_holds() -> Bool {
  match ts_wave2a_task_type_alias_relation_row_witness() {
    Holds { value: row } =>
      match ts_arc1_row_token_spine_classes(row: row) {
        Accepted { value: frontier, diagnostics: _ } =>
          match ts_arc1_grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: ts_arc1_wave2a_rules_with_duplicate_spine_rows()
          ) {
            Accepted { value: _, diagnostics: _ } => false
            Rejected { diagnostics: _ } => true
          }
        Rejected { diagnostics: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn ts_arc1_forward_row_dedup_cutover_green_holds() -> Bool {
  match ts_wave2a_task_type_alias_relation_row_witness() {
    Holds { value: row } =>
      match ts_arc1_row_token_spine_classes(row: row) {
        Accepted { value: frontier, diagnostics: _ } =>
          match ts_arc1_grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: ts_arc1_wave2a_dedup_cutover_rules()
          ) {
            Accepted { value: emitted, diagnostics: d } =>
              (d == None) && (emitted == ts_wave2a_task_type_alias_emitted())
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

test fn ts_arc1_forward_row_many_without_dedup_red_holds() -> Bool {
  ts_arc1_forward_row_many_without_dedup_red_holds()
}

test fn ts_arc1_forward_row_dedup_cutover_green_holds() -> Bool {
  ts_arc1_forward_row_dedup_cutover_green_holds()
}
