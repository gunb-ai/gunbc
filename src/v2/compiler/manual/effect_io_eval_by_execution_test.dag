module v2.test.manual.effect_io_eval_by_execution

import v2.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  effect_io_roundtrip_transform,
  eval_context_with_effect_io,
  eval_context_with_semantics,
  eval_diagnostic,
  eval_test_claim_subject,
  eval_with_context,
  inputs_root_only,
  run_test_claim
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.runtimes.v2_effect_io_pure {
  FileResourceBackend,
  effect_io_pure_empty_fixture_store,
  effect_io_pure_unit_type_node
}
import v2.test.lens_common.infer_fixture {
  claim_inferred_facts_from_nodes,
  claim_inferred_tree
}
import v2.std.cardinality { RankingDimension, TerminationProof }
import v2.std.collection { List, Map }
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  diagnostics_singleton
}
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  Value,
  SyntheticOccurrence
}
import v2.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  UnifiedTestClaim,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds, Violates, Witness }

fn effect_io_eval_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn effect_io_eval_type_node() -> Node {
  effect_io_eval_atom(s: ^effect_io_eval_type_symbol)
}

fn effect_io_eval_algebra_node() -> Node {
  effect_io_eval_atom(s: ^effect_io_eval_algebra_symbol)
}

fn effect_io_eval_termination_proof() -> TerminationProof {
  TerminationProof {
    non_increasing: [],
    strict: RankingDimension { measured: ^effect_io_eval_descent_dimension }
  }
}

fn effect_io_eval_literal_value() -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: effect_io_pure_unit_type_node(),
      bytes: []
    }
  }
}

data effect_io_eval_locator_literal: Node = Node {
  kind: ComputationNode { behavior: Value },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data effect_io_eval_payload_literal: Node = Node {
  kind: ComputationNode { behavior: Value },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data effect_io_eval_roundtrip_node: Node = effect_io_roundtrip_transform(
  locator: effect_io_eval_locator_literal,
  payload: effect_io_eval_payload_literal
)

fn effect_io_eval_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Accepted { value: effect_io_eval_literal_value(), diagnostics: None }
}

fn effect_io_eval_reject_primitive(
  node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^effect_io_eval_primitive_rejected, node: node)
    )
  }
}

fn effect_io_eval_reject_branch(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^effect_io_eval_primitive_rejected, node: node)
    )
  }
}

fn effect_io_eval_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^effect_io_eval_primitive_rejected, node: node)
    )
  }
}

fn effect_io_eval_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn effect_io_eval_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter { allocate_literal: effect_io_eval_allocate_literal },
    transform: TransformInterpreter { call_primitive: effect_io_eval_reject_primitive },
    branch: BranchInterpreter { choose_branch: effect_io_eval_reject_branch },
    loop: LoopInterpreter { step_loop: effect_io_eval_step_loop },
    bind: BindInterpreter { bind_value: effect_io_eval_bind_value },
    match: MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn effect_io_eval_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^effect_io_eval_allocate_literal_sym,
    call_primitive: ^effect_io_eval_reject_primitive_sym,
    choose_branch: ^effect_io_eval_reject_branch_sym,
    step_loop: ^effect_io_eval_step_loop_sym,
    bind_value: ^effect_io_eval_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn effect_io_eval_context_bound() -> EvalContext {
  eval_context_with_effect_io(
    runtime_identity: ^effect_io_eval_runtime_id,
    interpretation: effect_io_eval_interpretation(),
    structure_witness: effect_io_eval_structure_witness(),
    backend: FileResourceBackend,
    store: effect_io_pure_empty_fixture_store(backend: FileResourceBackend)
  )
}

fn effect_io_eval_context_unbound() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^effect_io_eval_runtime_id,
    interpretation: effect_io_eval_interpretation(),
    structure_witness: effect_io_eval_structure_witness()
  )
}

fn effect_io_eval_facts_for(node: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: effect_io_pure_unit_type_node(),
    descent: Holds { value: effect_io_eval_termination_proof() }
  )
}

fn effect_io_eval_fact_lookup(node: Node) -> Witness<InferredFacts> {
  if node == effect_io_eval_roundtrip_node {
    Holds { value: effect_io_eval_facts_for(node: effect_io_eval_roundtrip_node) }
  } else if node == effect_io_eval_locator_literal {
    Holds { value: effect_io_eval_facts_for(node: effect_io_eval_locator_literal) }
  } else if node == effect_io_eval_payload_literal {
    Holds { value: effect_io_eval_facts_for(node: effect_io_eval_payload_literal) }
  } else {
    Violates {
      diagnostic: eval_diagnostic(reason: ^effect_io_eval_facts_miss, node: node)
    }
  }
}

fn effect_io_eval_tree() -> InferredTree {
  InferredTree {
    root: effect_io_eval_roundtrip_node,
    facts: Map { lookup: effect_io_eval_fact_lookup }
  }
}

test fn effect_io_eval_roundtrip_holds() -> Bool {
  match eval_with_context(
    tree: effect_io_eval_tree(),
    context: effect_io_eval_context_bound(),
    inputs: inputs_root_only(root: effect_io_eval_roundtrip_node)
  ) {
    Accepted { value: v, diagnostics: None } => v == effect_io_eval_literal_value()
    _ => false
  }
}

test fn effect_io_eval_unbound_fail_closed_holds() -> Bool {
  match eval_with_context(
    tree: effect_io_eval_tree(),
    context: effect_io_eval_context_unbound(),
    inputs: inputs_root_only(root: effect_io_eval_roundtrip_node)
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^effect_io_eval_primitive_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

data claim_effect_io_eval_roundtrip: TestClaim = EqualsClaim {
  label: "V4-EFFECTS-IO: eval yields ReadResource→WriteResource round-trip through handler binding",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: effect_io_eval_roundtrip_node,
  rhs: effect_io_eval_payload_literal,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data subject_effect_io_eval_roundtrip: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_effect_io_eval_roundtrip,
  context: effect_io_eval_context_bound(),
  tree: effect_io_eval_tree(),
  evaluator_pin: ^effect_io_eval_pin
)

data run_effect_io_eval_roundtrip: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_effect_io_eval_roundtrip
)
