module v2.test.manual.sg_collection_projection

import v2.compiler.translate {
  translate_type_expression_project,
  target_serialize_source_from_model
}
import v2.extdeps.languages.rust {
  rust_sg2_type_expr_target_model,
  rust_type_expression_projection
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Atom, Edge, Instantiation, Node, Positional, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.compilers.target_model {
  target_carrier_free_monoid_node,
  target_carrier_node_node
}
import v2.std.text { String }
import v2.std.verification {
  Boundary,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  manual_claim_anchor
}
data sg_collection_expected_vec_rc_node: String = "Vec<Rc<Node>>"

fn sg_collection_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg_collection_pass_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg_collection_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^sg_collection_fail_sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn sg_collection_claim_input(ok: Bool) -> Node {
  if ok {
    sg_collection_pass_node()
  } else {
    sg_collection_fail_node()
  }
}

fn sg_collection_free_monoid_node_source_type() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: target_carrier_free_monoid_node() },
      Edge { label: Positional, target: target_carrier_node_node() }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn sg_collection_free_monoid_vec_rc_projection_holds() -> Bool {
  match translate_type_expression_project(
    node: sg_collection_free_monoid_node_source_type(),
    target: rust_sg2_type_expr_target_model(),
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: projected, diagnostics: _ } =>
      match target_serialize_source_from_model(
        target: rust_sg2_type_expr_target_model(),
        emitted: projected
      ) {
        Accepted { value: source, diagnostics: _ } => source.carried == sg_collection_expected_vec_rc_node
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data claim_sg_collection_free_monoid_vec_rc_projection: TestClaim = EqualsClaim {
  label: "manual/sg-collection: FreeMonoid<Node> projects to Vec<Rc<Node>>",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: sg_collection_claim_input(ok: sg_collection_free_monoid_vec_rc_projection_holds()),
  rhs: sg_collection_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
