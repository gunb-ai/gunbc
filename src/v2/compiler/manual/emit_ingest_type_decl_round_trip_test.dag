// Status: EXECUTED Bool witness — grammar-inverse free-name-slot emit for structural type decls.
//
// Keystone (#5098): structurally built `type Point { x: Int, y: Int }` and `type Pixel { px: Int,
// py: Int }` with NO per-type fixture rows — wave-1 free-ident productions + derive-at-emit.
// Spelling authority: symbol interning (case a); binding_spellings empty.

module v2.test.manual.emit_ingest_type_decl_round_trip

import v2.compiler.ingest {
  grammar_relation_row_forward_selection,
  grammar_relation_row_forward_token_selection
}
import v2.compiler.translate {
  grammar_relation_row_for_emitted,
  grammar_relation_row_tokens_root,
  serialize_concrete_syntax_tokens_to_source
}
import v2.extdeps.languages.dag {
  dag_inhabitant_atom,
  dag_type_decl_productions_only_translation_rules,
  dag_type_decl_structural_formal_productions,
  dag_type_decl_structural_target_model
}
import v2.std.algebra { Empty, fold_list, list_append }
import v2.std.collection { List }
import v2.std.compilers.target_model {
  ConcreteSyntaxToken,
  TargetModel,
  concrete_syntax_token_class,
  concrete_syntax_token_list_from_node
}
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.grammar { formal_productions_catalog_to_node }
import v2.std.logic { Bool }
import v2.std.node {
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.node_query { find_named_child }
import v2.std.witness { Holds, Violates }

data type_decl_round_trip_foreign_binding: Symbol = ^type_decl_round_trip_foreign_binding

data type_decl_point_source_text: String = "type Point { x: Int, y: Int }"
data type_decl_pixel_source_text: String = "type Pixel { px: Int, py: Int }"

fn type_decl_rules() -> Node {
  dag_type_decl_productions_only_translation_rules()
}

fn type_decl_target() -> TargetModel {
  dag_type_decl_structural_target_model()
}

fn type_decl_qualified_name_emitted(name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: dag_inhabitant_atom(id: name) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_type_expr_emitted(type_name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: type_decl_qualified_name_emitted(name: type_name)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_field_list_suffix_empty() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_two_field_list_emitted(
  f1: Symbol,
  t1: Symbol,
  f2: Symbol,
  t2: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: dag_inhabitant_atom(id: f1) },
      Edge { label: Positional, target: type_decl_type_expr_emitted(type_name: t1) },
      Edge { label: Positional, target: dag_inhabitant_atom(id: f2) },
      Edge { label: Positional, target: type_decl_type_expr_emitted(type_name: t2) },
      Edge { label: Positional, target: type_decl_field_list_suffix_empty() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_field_block_emitted(fields: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: fields }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_record_emitted(name: Symbol, fields: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: dag_inhabitant_atom(id: name) },
      Edge { label: Positional, target: type_decl_field_block_emitted(fields: fields) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_point_emitted() -> Node {
  type_decl_record_emitted(
    name: ^Point,
    fields: type_decl_two_field_list_emitted(f1: ^x, t1: ^Int, f2: ^y, t2: ^Int)
  )
}

fn type_decl_pixel_emitted() -> Node {
  type_decl_record_emitted(
    name: ^Pixel,
    fields: type_decl_two_field_list_emitted(f1: ^px, t1: ^Int, f2: ^py, t2: ^Int)
  )
}

fn type_decl_foreign_emitted() -> Node {
  type_decl_record_emitted(
    name: ^type_decl_round_trip_foreign_binding,
    fields: type_decl_two_field_list_emitted(f1: ^x, t1: ^Int, f2: ^y, t2: ^Int)
  )
}

fn type_decl_row_token_spine_classes(row: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold_list(
            xs: tokens,
            empty: Empty,
            cons: fn(acc, t) {
              list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn type_decl_emit_source_text(emitted: Node) -> Outcome<String> {
  let rules = type_decl_rules()
  let target = type_decl_target()
  bind_outcome(
    o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              serialize_concrete_syntax_tokens_to_source(target: target, tokens: tokens)
            }
          )
        }
      )
    }
  )
}

fn type_decl_emit_tokens(emitted: Node) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          concrete_syntax_token_list_from_node(list_node: tokens_root)
        }
      )
    }
  )
}

fn type_decl_emit_frontier(emitted: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted),
    f: fn(row) { type_decl_row_token_spine_classes(row: row) }
  )
}

// Keystone (1/3): forward ingest on emit-derived bound token spine recovers the structural node.
fn type_decl_emit_then_parse_identity_holds(emitted: Node) -> Bool {
  match type_decl_emit_tokens(emitted: emitted) {
    Accepted { value: tokens, diagnostics: _ } =>
      match grammar_relation_row_forward_token_selection(
        tokens: tokens,
        rules: type_decl_rules(),
        start_lhs: ^dag_production_type_decl
      ) {
        Accepted { value: recovered, diagnostics: _ } => recovered == emitted
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_derived_row_preserves_emitted_holds(emitted: Node) -> Bool {
  match grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted) {
    Accepted { value: row, diagnostics: _ } =>
      match find_named_child(root: row, name: ^grammar_relation_field_emitted) {
        Accepted { value: row_emitted, diagnostics: _ } => row_emitted == emitted
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_emit_derive_idempotent_holds(emitted: Node) -> Bool {
  match grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted) {
    Accepted { value: row1, diagnostics: _ } =>
      match grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: emitted) {
        Accepted { value: row2, diagnostics: _ } => row1 == row2
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_row_with_foreign_emitted_fixture(canonical_row: Node, foreign: Node) -> Outcome<Node> {
  bind_outcome(
    o: find_named_child(root: canonical_row, name: ^grammar_relation_field_production),
    f: fn(production) {
      bind_outcome(
        o: find_named_child(root: canonical_row, name: ^grammar_relation_field_tokens),
        f: fn(tokens) {
          outcome_accepted(
            value: Node {
              kind: TypeNode { connective: Conj },
              children: [
                Edge {
                  label: Named { name: ^grammar_relation_field_production },
                  target: production
                },
                Edge {
                  label: Named { name: ^grammar_relation_field_emitted },
                  target: foreign
                },
                Edge {
                  label: Named { name: ^grammar_relation_field_tokens },
                  target: tokens
                }
              ],
              occurrence_id: SyntheticOccurrence
            }
          )
        }
      )
    }
  )
}

fn type_decl_translation_rules_with_row(row: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^grammar_relation_rules_formal_productions },
        target: formal_productions_catalog_to_node(
          productions: dag_type_decl_structural_formal_productions()
        )
      },
      Edge {
        label: Named { name: ^type_decl_round_trip_foreign_binding },
        target: row
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// Discriminating control: foreign emitted fixture on a row; structural reverse-parse must still match n.
fn type_decl_emit_structural_not_fixture_lookup_holds() -> Bool {
  match grammar_relation_row_for_emitted(rules: type_decl_rules(), emitted: type_decl_point_emitted()) {
    Accepted { value: canonical_row, diagnostics: _ } =>
      match type_decl_row_with_foreign_emitted_fixture(
        canonical_row: canonical_row,
        foreign: type_decl_foreign_emitted()
      ) {
        Accepted { value: perturbed_row, diagnostics: _ } =>
          match grammar_relation_row_for_emitted(
            rules: type_decl_translation_rules_with_row(row: perturbed_row),
            emitted: type_decl_point_emitted()
          ) {
            Accepted { value: selected, diagnostics: _ } => selected == perturbed_row
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Invertibility guard: Point and Pixel share the same token-class frontier — class forward must fail-closed.
fn type_decl_forward_class_spine_ambiguous_rejects_holds() -> Bool {
  match type_decl_emit_frontier(emitted: type_decl_point_emitted()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(frontier: frontier, rules: type_decl_rules()) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

// Keystone (2/3): spaced source text from general serialize path.
fn type_decl_point_emit_source_text_holds() -> Bool {
  match type_decl_emit_source_text(emitted: type_decl_point_emitted()) {
    Accepted { value: text, diagnostics: _ } => text == type_decl_point_source_text
    Rejected { diagnostics: _ } => false
  }
}

// Keystone (3/3): distinct free names -> distinct surface text.
fn type_decl_point_pixel_emit_distinct_holds() -> Bool {
  match type_decl_emit_source_text(emitted: type_decl_point_emitted()) {
    Accepted { value: point_text, diagnostics: _ } =>
      match type_decl_emit_source_text(emitted: type_decl_pixel_emitted()) {
        Accepted { value: pixel_text, diagnostics: _ } =>
          point_text != pixel_text && pixel_text == type_decl_pixel_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn emit_ingest_type_decl_round_trip_holds() -> Bool {
  type_decl_point_emit_source_text_holds()
    && type_decl_point_pixel_emit_distinct_holds()
    && type_decl_emit_then_parse_identity_holds(emitted: type_decl_point_emitted())
    && type_decl_emit_then_parse_identity_holds(emitted: type_decl_pixel_emitted())
    && type_decl_derived_row_preserves_emitted_holds(emitted: type_decl_point_emitted())
    && type_decl_emit_derive_idempotent_holds(emitted: type_decl_point_emitted())
    && type_decl_emit_structural_not_fixture_lookup_holds()
    && type_decl_forward_class_spine_ambiguous_rejects_holds()
}
