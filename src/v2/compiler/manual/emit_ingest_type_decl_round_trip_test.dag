// Status: EXECUTED Bool witness — grammar-inverse realized for a type-decl Conj node.
//
// Proves parse(emit(n)) ≡ n by execution for ONE shape: the `.dag` record type declaration
// `type Task { id: TaskId, title: String, status: TaskStatus }`, whose emitted core node is a
// Conj (name-binding atom + nested field-decl-block nonterminal) — distinct from the flat
// `fn add` keystone already covered by emit_ingest_grammar_relation_round_trip_test.
//
// This is NOT a new unparser. Emission and ingestion are the two directions of ONE authority:
// a grammar-relation row carries both grammar_relation_field_emitted (the core node) and
// grammar_relation_field_tokens (its concrete token spine). emit(n) = the backward selector
// v2.compiler.translate.grammar_relation_row_for_emitted (structural reverse-parse fold over
// grammar_relation_field_production — NOT exact fixture lookup on grammar_relation_field_emitted;
// read the row's tokens). parse(spine) = the forward selector v2.compiler.ingest.grammar_relation_row_forward_selection
// (key the row's token-spine CLASSES against the frontier, return the row's emitted). The
// round trip emit ∘ parse is therefore the bijectivity of the two selectors over the SAME row,
// not a second structural walker.

module v2.test.manual.emit_ingest_type_decl_round_trip

import v2.compiler.ingest { grammar_relation_row_forward_selection }
import v2.compiler.translate { grammar_relation_row_for_emitted }
import v2.extdeps.languages.dag {
  dag_wave2a_field_decl_block_emitted,
  dag_wave2a_task_type_decl_emitted,
  dag_wave2a_type_decl_formal_productions,
  dag_wave2a_type_decl_record_emitted,
  dag_wave2a_type_decl_translation_rules_witness
}
import v2.std.algebra { Empty, list_append }
import v2.std.collection { List }
import v2.std.compilers.target_model {
  concrete_syntax_token_class,
  concrete_syntax_token_list_from_node
}
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.grammar { formal_productions_catalog_to_node }
import v2.std.logic { Bool }
import v2.std.node {
  Edge,
  Named,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.node_query { find_named_child }
import v2.std.witness { Holds, Violates }

// UNDECLARED binding: declared by no grammar-relation row — fail-closed control for emit.
data type_decl_round_trip_foreign_binding: Symbol = ^type_decl_round_trip_foreign_binding

// n: the type-decl Conj node under test (`.dag` `type Task { ... }`).
fn type_decl_emitted() -> Node {
  dag_wave2a_task_type_decl_emitted()
}

// UNDECLARED-node: same field block as n, but a binding atom absent from every row's production.
fn type_decl_undeclared_emitted() -> Node {
  dag_wave2a_type_decl_record_emitted(
    name_binding: ^type_decl_round_trip_foreign_binding,
    field_block: dag_wave2a_field_decl_block_emitted()
  )
}

fn type_decl_translation_rules_with_row(row: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^grammar_relation_rules_formal_productions },
        target: formal_productions_catalog_to_node(
          productions: dag_wave2a_type_decl_formal_productions()
        )
      },
      Edge {
        label: Named { name: ^dag_relation_rule_wave2a_type_decl_task },
        target: row
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// Perturb a row's grammar_relation_field_emitted fixture while keeping production + tokens —
// exact fixture lookup would miss; structural reverse-parse fold must still select the row.
fn type_decl_row_with_foreign_emitted_fixture(canonical_row: Node, foreign: Node) -> Outcome<Node> {
  bind_outcome(
    o: find_named_child(root: canonical_row, name: ^grammar_relation_field_production),
    f: fn(production) {
      bind_outcome(
        o: find_named_child(root: canonical_row, name: ^grammar_relation_field_tokens),
        f: fn(tokens) {
          outcome_accepted(
            value: Node {
              kind: TypeNode { connective: Conj },
              children: [
                Edge {
                  label: Named { name: ^grammar_relation_field_production },
                  target: production
                },
                Edge {
                  label: Named { name: ^grammar_relation_field_emitted },
                  target: foreign
                },
                Edge {
                  label: Named { name: ^grammar_relation_field_tokens },
                  target: tokens
                }
              ],
              occurrence_id: SyntheticOccurrence
            }
          )
        }
      )
    }
  )
}

// Project a grammar-relation row's token spine to ordered token CLASSES (bindings dropped) —
// exactly the frontier the forward selector keys on (mirrors v2.compiler.ingest row_token_spine_classes).
fn type_decl_row_token_spine_classes(row: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: ^grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: Empty,
            f: fn(acc, t) {
              list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

// emit(n): backward-select the row whose production structurally matches n (reverse parse fold),
// then read its token-spine frontier.
fn type_decl_emit_frontier(rules: Node, emitted: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
    f: fn(row) { type_decl_row_token_spine_classes(row: row) }
  )
}

// parse(emit(n)) ≡ n: emit n to its token frontier, then forward-select recovers exactly n.
fn type_decl_emit_then_parse_identity_holds() -> Bool {
  match dag_wave2a_type_decl_translation_rules_witness() {
    Holds { value: rules } =>
      match type_decl_emit_frontier(rules: rules, emitted: type_decl_emitted()) {
        Accepted { value: frontier, diagnostics: _ } =>
          match grammar_relation_row_forward_selection(frontier: frontier, rules: rules) {
            Accepted { value: recovered, diagnostics: _ } =>
              recovered == type_decl_emitted()
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

// ingest(parse(n)) ≡ row: forward-select n's frontier, backward-select its emitted recovers the
// same row's emitted — the reverse-direction half of selector bijectivity.
fn type_decl_parse_then_emit_identity_holds() -> Bool {
  match dag_wave2a_type_decl_translation_rules_witness() {
    Holds { value: rules } =>
      match type_decl_emit_frontier(rules: rules, emitted: type_decl_emitted()) {
        Accepted { value: frontier, diagnostics: _ } =>
          match grammar_relation_row_forward_selection(frontier: frontier, rules: rules) {
            Accepted { value: recovered, diagnostics: _ } =>
              match grammar_relation_row_for_emitted(rules: rules, emitted: recovered) {
                Accepted { value: row, diagnostics: _ } =>
                  match type_decl_row_token_spine_classes(row: row) {
                    Accepted { value: refrontier, diagnostics: _ } =>
                      frontier == refrontier
                    Rejected { diagnostics: _ } => false
                  }
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

// UNDECLARED-node fail-closed: emit must Reject — never fabricate a plausible row.
// Goes RED if backward selection reverts to exact fixture lookup that accidentally aliases.
fn type_decl_emit_rejects_undeclared_emitted_holds() -> Bool {
  match dag_wave2a_type_decl_translation_rules_witness() {
    Holds { value: rules } =>
      match grammar_relation_row_for_emitted(rules: rules, emitted: type_decl_undeclared_emitted()) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Violates { diagnostic: _ } => false
  }
}

// Discriminating control (#5098): row carries a foreign emitted fixture but the canonical
// production still structurally matches n — exact fixture lookup would Reject; reverse-parse fold
// must Accept. Goes RED if emit reverts to grammar_relation_field_emitted equality.
fn type_decl_emit_structural_not_fixture_lookup_holds() -> Bool {
  match dag_wave2a_type_decl_translation_rules_witness() {
    Holds { value: rules } =>
      match grammar_relation_row_for_emitted(rules: rules, emitted: type_decl_emitted()) {
        Accepted { value: canonical_row, diagnostics: _ } =>
          match type_decl_row_with_foreign_emitted_fixture(
            canonical_row: canonical_row,
            foreign: type_decl_undeclared_emitted()
          ) {
            Accepted { value: perturbed_row, diagnostics: _ } =>
              match grammar_relation_row_for_emitted(
                rules: type_decl_translation_rules_with_row(row: perturbed_row),
                emitted: type_decl_emitted()
              ) {
                Accepted { value: selected, diagnostics: _ } => selected == perturbed_row
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

test fn emit_ingest_type_decl_round_trip_holds() -> Bool {
  type_decl_emit_then_parse_identity_holds()
    && type_decl_parse_then_emit_identity_holds()
    && type_decl_emit_rejects_undeclared_emitted_holds()
    && type_decl_emit_structural_not_fixture_lookup_holds()
}
