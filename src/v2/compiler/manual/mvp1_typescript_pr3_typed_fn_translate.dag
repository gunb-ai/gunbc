module v2.test.manual.mvp1_typescript_pr3_typed_fn_translate

import v2.compiler.emit { emit }
import v2.compiler.compile {
  CompileOutput,
  TranslateResult,
  TranslateTo,
  compile_inferred
}
import v2.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  run_test_claim_assert,
  test_claim_cache_receipt,
  test_claim_typed_input_node
}
import v2.compiler.translate { target_serialize_source_from_model }
import v2.extdeps.languages.typescript {
  ts_inhabitant_atom,
  ts_pr3_identity_source_text,
  ts_pr3_identity_typed_fn_emitted,
  ts_pr3_identity_target_model_witness
}
import v2.compiler.infer { InferredFacts, InferredTree }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.compilers.target_model { TargetModel }
import v2.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v2.std.collection { Map, empty_map }
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v2.std.node { Conj, Node, Symbol, TypeNode, content_hash }
import v2.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
import v2.test.lens_common.infer_fixture { claim_inferred_facts_witness }
data mvp1_ts_pr3_emitted_root: Node = ts_pr3_identity_typed_fn_emitted()

fn mvp1_ts_pr3_target_model_for_emit() -> Witness<TargetModel> {
  ts_pr3_identity_target_model_witness()
}

fn mvp1_ts_pr3_canonical_grounding(node: Node, algebra: Node) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn mvp1_ts_pr3_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == mvp1_ts_pr3_emitted_root {
    Holds {
      value: mvp1_ts_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_token_ty_number) {
    Holds {
      value: mvp1_ts_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_binding_pr3_identity) {
    Holds {
      value: mvp1_ts_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_binding_param_x) {
    Holds {
      value: mvp1_ts_pr3_canonical_grounding(node: node, algebra: node)
    }
  } else if content_hash(n: node) == content_hash(n: mvp1_ts_pr3_emitted_root) {
    Holds {
      value: mvp1_ts_pr3_canonical_grounding(node: node, algebra: mvp1_ts_pr3_emitted_root)
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^mvp1_ts_pr3_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn mvp1_ts_pr3_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match mvp1_ts_pr3_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn mvp1_ts_pr3_facts_lookup(key: Node) -> Witness<InferredFacts> {
  mvp1_ts_pr3_inferred_facts_for(node: key)
}

data mvp1_ts_pr3_inferred_tree: InferredTree = InferredTree {
  root: mvp1_ts_pr3_emitted_root,
  facts: Map { lookup: mvp1_ts_pr3_facts_lookup }
}

fn anchor_mvp1_ts_pr3_emit_accepts() -> Outcome<Medium<String>> {
  match mvp1_ts_pr3_target_model_for_emit() {
    Holds { value: target } => emit(tree: mvp1_ts_pr3_inferred_tree, target: target)
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn anchor_mvp1_ts_pr3_compile_inferred_accepts() -> Outcome<CompileOutput> {
  match mvp1_ts_pr3_target_model_for_emit() {
    Holds { value: target } =>
      compile_inferred(
        inferred: mvp1_ts_pr3_inferred_tree,
        mode: TranslateTo { target: target }
      )
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

data mvp1_ts_pr3_emit_receipt: Outcome<Medium<String>> = anchor_mvp1_ts_pr3_emit_accepts()

data mvp1_ts_pr3_compile_inferred_receipt: Outcome<CompileOutput> = anchor_mvp1_ts_pr3_compile_inferred_accepts()

fn mvp1_ts_pr3_emit_claim_outcome() -> Outcome<Node> {
  match mvp1_ts_pr3_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      if (source.carried == ts_pr3_identity_source_text) && (d == None) {
        Accepted { value: mvp1_ts_pr3_emitted_root, diagnostics: None }
      } else {
        Rejected {
          diagnostics: diagnostics_singleton(
            d: Diagnostic {
              reason: ^mvp1_ts_pr3_emit_source_mismatch,
              at: node_locus(node: mvp1_ts_pr3_emitted_root),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn mvp1_ts_pr3_compile_inferred_claim_outcome() -> Outcome<Node> {
  match mvp1_ts_pr3_compile_inferred_receipt {
    Accepted { value: compile_result, diagnostics: d } =>
      match compile_result {
        TranslateResult { source } =>
          if (source.carried == ts_pr3_identity_source_text) && (d == None) {
            Accepted { value: mvp1_ts_pr3_emitted_root, diagnostics: None }
          } else {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: Diagnostic {
                  reason: ^mvp1_ts_pr3_compile_source_mismatch,
                  at: node_locus(node: mvp1_ts_pr3_emitted_root),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }
              )
            }
          }
        _ =>
          Rejected {
            diagnostics: diagnostics_singleton(
              d: Diagnostic {
                reason: ^mvp1_ts_pr3_compile_source_mismatch,
                at: node_locus(node: mvp1_ts_pr3_emitted_root),
                correction: Unavailable { reason: ExternalContractUnknown }
              }
            )
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

data claim_mvp1_ts_pr3_typed_fn_emit_accepts: TestClaim = CompilesClaim {
  label: "manual/mvp1: pr3 identity typed-fn emit round-trips via derive grammar-relation row",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: mvp1_ts_pr3_emitted_root,
  expected_value: mvp1_ts_pr3_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_mvp1_ts_pr3_typed_fn_compile_accepts: TestClaim = CompilesClaim {
  label: "manual/mvp1 G3: compile_inferred emits canonical identity typed-fn through grammar inverse production ts_production_pr3_typed_fn_decl",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: mvp1_ts_pr3_emitted_root,
  expected_value: mvp1_ts_pr3_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data run_mvp1_ts_pr3_typed_fn_emit_accepts: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(
    subject: TestClaimEvalSubject {
      claim: claim_mvp1_ts_pr3_typed_fn_emit_accepts,
      context: mvp1_ts_pr3_emitted_root,
      tree: mvp1_ts_pr3_inferred_tree,
      input: test_claim_typed_input_node(
        evaluator_input: mvp1_ts_pr3_emitted_root,
        evaluator_pin: mvp1_ts_pr3_emitted_root
      )
    }
  ),
  verdict: run_test_claim_assert(
    claim: claim_mvp1_ts_pr3_typed_fn_emit_accepts,
    actual: mvp1_ts_pr3_emit_claim_outcome(),
    at: mvp1_ts_pr3_emitted_root
  )
}
