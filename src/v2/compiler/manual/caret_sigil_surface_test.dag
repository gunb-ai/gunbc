module v2.test.manual.caret_sigil_surface

import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
type CaretProbeShape
  = CaretAlpha { x: Int }
  | CaretBeta { y: Int }

test fn caret_sigil_surface_witness_holds() -> Bool {
  let opaque_tag = ^caret_opaque_tag
  let spelling_is_opaque = opaque_tag == ^caret_opaque_tag

  let alpha = CaretAlpha { x: 1 }
  let beta = CaretBeta { y: 1 }
  let sugar_matches_intrinsic = ^(alpha) == discriminant(v: alpha)
  let sugar_distinct_across_arms = (^(alpha) == ^(beta)) == false

  spelling_is_opaque && sugar_matches_intrinsic && sugar_distinct_across_arms
}
