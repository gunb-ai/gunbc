module v2.test.manual.typescript_import_emit_by_execution

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, outcome_accepted }
import v2.std.collection {
  Absent,
  Map,
  Present,
  empty_map,
  map_get,
  map_insert
}
import v2.std.algebra { Cons, Empty, fold_list, fold_list_node, list_append }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.node_query { find_named_child, node_positional_child_targets }
import v2.std.qualified_name {
  QnCons,
  QnEmpty,
  QualifiedName,
  qualified_name_from_node
}
import v2.std.compilers.lexing {
  LexRuleSet,
  LiteralPattern,
  ModeledLexRules,
  TokenRule
}
import v2.std.compilers.target_model {
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  TargetModel,
  target_model_emit_transforms_empty,
  target_node_atom_identity
}
import extdeps.communication.medium { Medium }
import v2.compiler.translate { serialize_concrete_syntax_tokens_to_source }
import v2.std.logic { Bool }
import v2.std.text { String }

data ts_import_canonical_source_text: String = "import { Cons, Empty } from \"v2/std/algebra\";"

fn ts_import_symbol_atom(sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_empty_conj() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_block_node(names: List<Symbol>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: names,
      empty: [],
      cons: fn(acc, sym) {
        list_append(
          left: acc,
          right: [Edge { label: Positional, target: ts_import_symbol_atom(sym: sym) }]
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_qn_node(segments: List<Symbol>) -> Node {
  fold_list_node(xs: segments, item_node: fn(sym) { ts_import_symbol_atom(sym: sym) })
}

fn ts_import_carrier_node(segments: List<Symbol>, names: List<Symbol>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^dag_surface_import_decl },
        target: ts_import_symbol_atom(sym: ^dag_surface_import_decl)
      },
      Edge {
        label: Named { name: ^dag_surface_import_decl_qualified_name },
        target: ts_import_qn_node(segments: segments)
      },
      Edge {
        label: Named { name: ^dag_surface_import_decl_block },
        target: ts_import_block_node(names: names)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_missing_qn_carrier_node(names: List<Symbol>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^dag_surface_import_decl },
        target: ts_import_symbol_atom(sym: ^dag_surface_import_decl)
      },
      Edge {
        label: Named { name: ^dag_surface_import_decl_block },
        target: ts_import_block_node(names: names)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_import_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(
          map_insert(
            map_insert(empty_map(), ^seg_v2, "v2"),
            ^seg_std, "std"
          ),
          ^seg_algebra, "algebra"
        ),
        ^seg_collection, "collection"
      ),
      ^name_cons, "Cons"
    ),
    ^name_empty, "Empty"
  )
}

fn ts_import_spell_sym(spellings: Map<Symbol, String>, sym: Symbol) -> String {
  match map_get(spellings, sym) {
    Accepted { value: Present { value: s }, diagnostics: _ } => s
    Accepted { value: Absent, diagnostics: _ } => "?MISSING_SPELLING?"
    Rejected { diagnostics: _ } => "?SPELLING_ERROR?"
  }
}

fn ts_import_qn_path(qn: QualifiedName, spellings: Map<Symbol, String>) -> String {
  match qn {
    QnEmpty => ""
    QnCons { head: h, tail: t } =>
      match t {
        QnEmpty => ts_import_spell_sym(spellings: spellings, sym: h)
        QnCons { head: _, tail: _ } =>
          concat(
            ts_import_spell_sym(spellings: spellings, sym: h),
            concat("/", ts_import_qn_path(qn: t, spellings: spellings))
          )
      }
  }
}

fn ts_import_quoted_path(qn: QualifiedName, spellings: Map<Symbol, String>) -> String {
  concat("\"", concat(ts_import_qn_path(qn: qn, spellings: spellings), "\""))
}

fn ts_import_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      TokenRule { token_class: ^ts_import_kw, pattern: LiteralPattern { text: "import " } },
      TokenRule { token_class: ^ts_import_lbrace, pattern: LiteralPattern { text: "{ " } },
      TokenRule { token_class: ^ts_import_rbrace, pattern: LiteralPattern { text: " } " } },
      TokenRule { token_class: ^ts_import_kw_from, pattern: LiteralPattern { text: "from " } },
      TokenRule { token_class: ^ts_import_comma, pattern: LiteralPattern { text: ", " } },
      TokenRule { token_class: ^ts_import_semicolon, pattern: LiteralPattern { text: ";" } }
    ]
  }
}

fn ts_import_target_model(spellings: Map<Symbol, String>) -> TargetModel {
  TargetModel {
    bundle: ts_import_empty_conj(),
    lex: ModeledLexRules { root: ts_import_lex_rules() },
    binding_spellings: spellings,
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn ts_import_names_tokens(name_nodes: List<Node>) -> Outcome<List<ConcreteSyntaxToken>> {
  fold_list(
    xs: name_nodes,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, nd) {
      bind_outcome(
        o: acc,
        f: fn(toks) {
          bind_outcome(
            o: target_node_atom_identity(node: nd),
            f: fn(sym) {
              match toks {
                Empty =>
                  outcome_accepted(value: [BoundToken { token_class: ^ts_token_ident, binding: sym }])
                Cons { head: _, tail: _ } =>
                  outcome_accepted(
                    value: list_append(
                      left: toks,
                      right: [
                        FixedToken { token_class: ^ts_import_comma },
                        BoundToken { token_class: ^ts_token_ident, binding: sym }
                      ]
                    )
                  )
              }
            }
          )
        }
      )
    }
  )
}

fn ts_emit_import_from_carrier(
  carrier: Node,
  spellings: Map<Symbol, String>
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: find_named_child(root: carrier, name: ^dag_surface_import_decl_qualified_name),
    f: fn(qn_node) {
      bind_outcome(
        o: qualified_name_from_node(root: qn_node),
        f: fn(qn) {
          bind_outcome(
            o: find_named_child(root: carrier, name: ^dag_surface_import_decl_block),
            f: fn(block) {
              bind_outcome(
                o: ts_import_names_tokens(name_nodes: node_positional_child_targets(node: block)),
                f: fn(name_toks) {
                  serialize_concrete_syntax_tokens_to_source(
                    target: ts_import_target_model(
                      spellings: map_insert(
                        spellings,
                        ^ts_import_path_binding,
                        ts_import_quoted_path(qn: qn, spellings: spellings)
                      )
                    ),
                    tokens: list_append(
                      left: [
                        FixedToken { token_class: ^ts_import_kw },
                        FixedToken { token_class: ^ts_import_lbrace }
                      ],
                      right: list_append(
                        left: name_toks,
                        right: [
                          FixedToken { token_class: ^ts_import_rbrace },
                          FixedToken { token_class: ^ts_import_kw_from },
                          BoundToken { token_class: ^ts_import_path, binding: ^ts_import_path_binding },
                          FixedToken { token_class: ^ts_import_semicolon }
                        ]
                      )
                    )
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn ts_import_emit_text(carrier: Node) -> String {
  match ts_emit_import_from_carrier(carrier: carrier, spellings: ts_import_spellings()) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => "TS_IMPORT_EMIT_REJECTED"
  }
}

fn ts_import_canonical_carrier() -> Node {
  ts_import_carrier_node(
    segments: [^seg_v2, ^seg_std, ^seg_algebra],
    names: [^name_cons, ^name_empty]
  )
}

fn ts_import_swapped_names_carrier() -> Node {
  ts_import_carrier_node(
    segments: [^seg_v2, ^seg_std, ^seg_algebra],
    names: [^name_empty, ^name_cons]
  )
}

fn ts_import_other_path_carrier() -> Node {
  ts_import_carrier_node(
    segments: [^seg_v2, ^seg_std, ^seg_collection],
    names: [^name_cons, ^name_empty]
  )
}

fn ts_import_missing_qn_carrier() -> Node {
  ts_import_missing_qn_carrier_node(names: [^name_cons, ^name_empty])
}

test fn ts_import_emit_by_execution_exact_holds() -> Bool {
  ts_import_emit_text(carrier: ts_import_canonical_carrier()) == ts_import_canonical_source_text
}

test fn ts_import_emit_swapped_names_discriminates_holds() -> Bool {
  (ts_import_emit_text(carrier: ts_import_canonical_carrier()) == ts_import_canonical_source_text)
    && (ts_import_emit_text(carrier: ts_import_swapped_names_carrier()) != ts_import_canonical_source_text)
    && (ts_import_emit_text(carrier: ts_import_swapped_names_carrier()) != "TS_IMPORT_EMIT_REJECTED")
}

test fn ts_import_emit_other_path_discriminates_holds() -> Bool {
  (ts_import_emit_text(carrier: ts_import_canonical_carrier()) == ts_import_canonical_source_text)
    && (ts_import_emit_text(carrier: ts_import_other_path_carrier()) != ts_import_canonical_source_text)
    && (ts_import_emit_text(carrier: ts_import_other_path_carrier()) != "TS_IMPORT_EMIT_REJECTED")
}

test fn ts_import_emit_missing_qn_fails_closed_holds() -> Bool {
  match ts_emit_import_from_carrier(
    carrier: ts_import_missing_qn_carrier(),
    spellings: ts_import_spellings()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}
