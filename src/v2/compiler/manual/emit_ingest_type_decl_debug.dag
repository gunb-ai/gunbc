module v2.test.manual.emit_ingest_type_decl_debug

import v2.compiler.translate { grammar_relation_row_for_emitted, serialize_concrete_syntax_tokens_to_source, grammar_relation_row_tokens_root }
import v2.extdeps.languages.dag {
  dag_inhabitant_atom,
  dag_type_decl_productions_only_translation_rules,
  dag_type_decl_structural_target_model
}
import v2.std.compilers.target_model { concrete_syntax_token_list_from_node }
import v2.std.algebra { list_append }
import v2.std.logic { Bool }
import v2.std.node { Edge, Node, Positional, Symbol, SyntheticOccurrence, TypeNode }

fn type_decl_qualified_name_emitted(name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: dag_inhabitant_atom(id: name) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_type_expr_emitted(type_name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: type_decl_qualified_name_emitted(name: type_name)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_field_list_suffix_empty() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_two_field_list_emitted(
  f1: Symbol,
  t1: Symbol,
  f2: Symbol,
  t2: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: dag_inhabitant_atom(id: f1) },
      Edge { label: Positional, target: type_decl_type_expr_emitted(type_name: t1) },
      Edge { label: Positional, target: dag_inhabitant_atom(id: f2) },
      Edge { label: Positional, target: type_decl_type_expr_emitted(type_name: t2) },
      Edge { label: Positional, target: type_decl_field_list_suffix_empty() }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_field_block_emitted(fields: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: fields }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn type_decl_record_emitted(name: Symbol, fields: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: dag_inhabitant_atom(id: name) },
      Edge { label: Positional, target: type_decl_field_block_emitted(fields: fields) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

data type_decl_point_text_spaced: String = "type Point { x: Int, y: Int }"

data type_decl_point_text_v1: String = "typePoint{ x: Int, y: Int }"

data type_decl_point_text_v2: String = "type Point{ x: Int, y: Int }"

data type_decl_point_text_v3: String = "typePoint { x: Int, y: Int }"

fn type_decl_point_emitted() -> Node {
  type_decl_record_emitted(
    name: ^Point,
    fields: type_decl_two_field_list_emitted(f1: ^x, t1: ^Int, f2: ^y, t2: ^Int)
  )
}

test fn type_decl_full_row_derive_accepts_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: dag_type_decl_productions_only_translation_rules(),
    emitted: type_decl_point_emitted()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn type_decl_serialize_accepts_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: dag_type_decl_productions_only_translation_rules(),
    emitted: type_decl_point_emitted()
  ) {
    Accepted { value: row, diagnostics: _ } =>
      match grammar_relation_row_tokens_root(row: row) {
        Accepted { value: tokens_root, diagnostics: _ } =>
          match concrete_syntax_token_list_from_node(list_node: tokens_root) {
            Accepted { value: tokens, diagnostics: _ } =>
              match serialize_concrete_syntax_tokens_to_source(
                target: dag_type_decl_structural_target_model(),
                tokens: tokens
              ) {
                Accepted { value: _, diagnostics: _ } => true
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn type_decl_emit_text_equals(expected: String) -> Bool {
  match grammar_relation_row_for_emitted(
    rules: dag_type_decl_productions_only_translation_rules(),
    emitted: type_decl_point_emitted()
  ) {
    Accepted { value: row, diagnostics: _ } =>
      match grammar_relation_row_tokens_root(row: row) {
        Accepted { value: tokens_root, diagnostics: _ } =>
          match concrete_syntax_token_list_from_node(list_node: tokens_root) {
            Accepted { value: tokens, diagnostics: _ } =>
              match serialize_concrete_syntax_tokens_to_source(
                target: dag_type_decl_structural_target_model(),
                tokens: tokens
              ) {
                Accepted { value: text, diagnostics: _ } => text == expected
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn type_decl_emit_text_holds() -> Bool {
  type_decl_emit_text_equals(expected: type_decl_point_text_spaced)
}

test fn type_decl_emit_text_v1_holds() -> Bool {
  type_decl_emit_text_equals(expected: type_decl_point_text_v1)
}

test fn type_decl_emit_text_v2_holds() -> Bool {
  type_decl_emit_text_equals(expected: type_decl_point_text_v2)
}

fn type_decl_point_expected_tight() -> String {
  let s0 = list_append(left: "type", right: "Point")
  let s1 = list_append(left: s0, right: "{")
  let s2 = list_append(left: s1, right: "x")
  let s3 = list_append(left: s2, right: ":")
  let s4 = list_append(left: s3, right: "Int")
  let s5 = list_append(left: s4, right: ",")
  let s6 = list_append(left: s5, right: "y")
  let s7 = list_append(left: s6, right: ":")
  let s8 = list_append(left: s7, right: "Int")
  list_append(left: s8, right: "}")
}

fn type_decl_point_expected_spaced() -> String {
  let s0 = list_append(left: "type", right: " ")
  let s1 = list_append(left: s0, right: "Point")
  let s2 = list_append(left: s1, right: " { ")
  let s3 = list_append(left: s2, right: "x")
  let s4 = list_append(left: s3, right: ": ")
  let s5 = list_append(left: s4, right: "Int")
  let s6 = list_append(left: s5, right: ", ")
  let s7 = list_append(left: s6, right: "y")
  let s8 = list_append(left: s7, right: ": ")
  let s9 = list_append(left: s8, right: "Int")
  list_append(left: s9, right: " }")
}

test fn type_decl_emit_text_spaced_built_holds() -> Bool {
  type_decl_emit_text_equals(expected: type_decl_point_expected_spaced())
}
