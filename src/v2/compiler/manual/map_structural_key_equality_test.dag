// Scope: a finite Map<K,V> is a finite set of key→value pairs, so whole-map `==` is
//        extensional set equality — decidable even when K is a structural (non-String)
//        key. The v2 interpreter realizes such maps natively (keyed by the single
//        Value-equality authority), so a structural-key map equals itself and equals an
//        independently-built map with the same key→latest-value mapping, while distinct
//        keys / distinct latest-values stay unequal.
// Anchor: regression for the closure-form Map==-is-always-false bug — a non-String key
//        used to drop the native fast path into a `Map { lookup: fn }` record whose
//        `Closure` field has no PartialEq arm, so any structural-key `Map ==` (even vs
//        itself) was false. Mirrors the affected_set frontier `==` receipts.

module v2.test.manual.map_structural_key_equality

import v2.std.logic { Bool }
import v2.std.collection { Map, empty_map, map_insert }


import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
type SKey {
  a: Int
  b: Int
}

type SKeyMap = Map<SKey, Int>

fn one_entry(a: Int, b: Int, v: Int) -> SKeyMap {
  map_insert(m: empty_map(), key: SKey { a: a, b: b }, value: v)
}

// Discriminating (the core bug): a structural-key map equals ITSELF. Closure-form
// `Map ==` returned false here (Closure has no PartialEq arm) even for a value vs itself.
fn struct_key_self_eq() -> Bool {
  let m = one_entry(a: 1, b: 2, v: 7)
  m == m
}

// Two independently-built maps with the same single entry are equal.
fn struct_key_equal_eq() -> Bool {
  one_entry(a: 1, b: 2, v: 7) == one_entry(a: 1, b: 2, v: 7)
}

// Discriminating: distinct structural keys are NOT equal (== is not vacuously true).
fn struct_key_distinct_neq() -> Bool {
  (one_entry(a: 1, b: 2, v: 7) == one_entry(a: 1, b: 9, v: 7)) == false
}

// Discriminating: distinct values at the same key are NOT equal.
fn struct_key_value_neq() -> Bool {
  (one_entry(a: 1, b: 2, v: 7) == one_entry(a: 1, b: 2, v: 8)) == false
}

// Extensional: re-inserting the same key keeps the latest value, so a shadowed map
// equals the single-entry map with that latest value (insertion history is invisible).
fn struct_key_shadow_latest_eq() -> Bool {
  let shadowed = map_insert(m: one_entry(a: 1, b: 2, v: 7), key: SKey { a: 1, b: 2 }, value: 9)
  shadowed == one_entry(a: 1, b: 2, v: 9)
}

// Rostered entry: one Bool combining the discriminating equalities with the not-equal
// (The native-map raw-value → Witness `Holds`/`Violates` bridges that this representation
// also requires are covered by manual/map_lookup_miss_witness_violates.dag.)
test fn map_structural_key_equality_holds() -> Bool {
  struct_key_self_eq()
    && struct_key_equal_eq()
    && struct_key_distinct_neq()
    && struct_key_value_neq()
    && struct_key_shadow_latest_eq()
}
