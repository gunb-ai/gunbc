// Scope: §3 python-emit IC — keystone emit receipt for python_mvp1 add-fn through the
//   grammar-inverse fold (grammar-relation → token-spine serialization).
//   GREEN: emit(add) matches target_serialize_source authority (python_mvp1_source_text).
//   RED: perturbed binding spellings (x→"a", y→"b") produce distinct source text.
// Anchor: §3 emit-breadth MoA — N data rows NOT N×M hand-arms; new spelling variant = data.

module v2.test.manual.comprep_add_body_emit_python

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.compiler.emit { emit }
import v2.compiler.infer { InferredTree }
import v2.compiler.target_carriers { TargetSource }
import v2.compiler.translate { target_serialize_source_from_model }
import v2.extdeps.languages.python {
  python_mvp1_emitted_add_fn_node,
  python_mvp1_source_text,
  python_mvp1_target_model,
  python_mvp1_target_model_node,
  python_wave1_lex
}
import v2.test.manual.mvp1_python_add_translate {
  mvp1_python_inferred_tree
}
import v2.std.collection { Map, empty_map, map_insert }
import v2.std.compilers.target_model { TargetModel }
import v2.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.text { String }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

// Perturbed spellings: param_x→"a", param_y→"b" instead of "x"/"y".
// Produces distinct source text; fn_add spelling ("add") is unchanged.
data comprep_python_add_emit_perturbed_source_text: String = "def add(a, b): return a + b"

fn comprep_python_add_emit_perturbed_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^python_binding_fn_add, "add"),
      ^python_binding_param_x,
      "a"
    ),
    ^python_binding_param_y,
    "b"
  )
}

fn comprep_python_add_emit_perturbed_target_model() -> TargetModel {
  TargetModel {
    bundle: python_mvp1_target_model_node(),
    lex: python_wave1_lex(),
    binding_spellings: comprep_python_add_emit_perturbed_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: python_mvp1_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn comprep_python_add_emit_from_tree(target: TargetModel) -> Outcome<TargetSource> {
  emit(tree: mvp1_python_inferred_tree, target: target)
}

// GREEN: emit with canonical target matches the grammar-inverse authority serialization.
fn comprep_python_add_emit_holds() -> Bool {
  match target_serialize_source_from_model(
    target: python_mvp1_target_model(),
    emitted: python_mvp1_emitted_add_fn_node()
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match comprep_python_add_emit_from_tree(target: python_mvp1_target_model()) {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// RED: perturbed binding spellings produce a distinct source text (not the canonical one).
fn comprep_python_add_emit_perturbed_spellings_discriminates() -> Bool {
  match comprep_python_add_emit_from_tree(target: python_mvp1_target_model()) {
    Accepted { value: canonical, diagnostics: dc } =>
      match comprep_python_add_emit_from_tree(
        target: comprep_python_add_emit_perturbed_target_model()
      ) {
        Accepted { value: perturbed, diagnostics: dp } =>
          (perturbed != canonical)
            && (perturbed == comprep_python_add_emit_perturbed_source_text)
            && (dc == None)
            && (dp == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn comprep_python_add_emit_keystone_holds() -> Bool {
  comprep_python_add_emit_holds() && comprep_python_add_emit_perturbed_spellings_discriminates()
}
