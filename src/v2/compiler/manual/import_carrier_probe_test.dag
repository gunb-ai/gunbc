module v2.test.manual.import_carrier_probe

import v2.extdeps.languages.dag { emit_import_decl_emitted_node, qualified_name_from_node }
import v2.std.algebra { Cons, Empty, fold_list_node }
import v2.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v2.std.node_query { find_named_child }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.collection { Absent }
import v2.std.qualified_name { QnCons, QnEmpty, QualifiedName, qualified_name_eq }
import v2.std.logic { Bool }

fn icp_sym_node(sym: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: sym } }, children: [], occurrence_id: SyntheticOccurrence }
}

fn icp_qn_node() -> Node {
  fold_list_node(xs: Cons { head: ^icp_a, tail: Cons { head: ^icp_b, tail: Empty } }, item_node: fn(sym) { icp_sym_node(sym: sym) })
}

fn icp_import_decl() -> Node {
  emit_import_decl_emitted_node(qualified_name: icp_qn_node(), import_block: Absent)
}

fn icp_expected_qn() -> QualifiedName {
  QnCons { head: ^icp_a, tail: QnCons { head: ^icp_b, tail: QnEmpty } }
}

test fn icp_import_decl_carries_readable_qn() -> Bool {
  match find_named_child(root: icp_import_decl(), name: ^dag_surface_import_decl_qualified_name) {
    Accepted { value: qn_node, diagnostics: _ } =>
      match qualified_name_from_node(root: qn_node) {
        Accepted { value: qn, diagnostics: _ } => qualified_name_eq(a: qn, b: icp_expected_qn())
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
