module v2.compiler.manual.ts_constructs_probe

import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.collection { Map, empty_map, map_insert }
import v2.std.node { Symbol }
import v2.std.compilers.target_model {
  ConcreteSyntaxToken,
  TargetModel,
  TargetValueExpression,
  TargetValueExprFieldInitSlot,
  target_value_expression_binding_ref,
  target_value_expression_record_construct,
  target_value_expression_field_access,
  target_value_expression_to_concrete_tokens,
  target_model_emit_transforms_empty
}
import extdeps.communication.medium { Lossless, Medium }
import v2.compiler.translate { serialize_concrete_syntax_tokens_to_source }
import v2.extdeps.languages.typescript {
  ts_mvp1_target_model_node,
  ts_operator_realizations_catalog_node,
  ts_value_expression_projection,
  ts_wave1_lex
}

fn probe_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(
          map_insert(empty_map(), ^probe_type_point, "Point"),
          ^probe_field_x, "x"
        ),
        ^probe_field_y, "y"
      ),
      ^probe_val_a, "1"
    ),
    ^probe_val_b, "2"
  )
}

fn probe_target_model() -> TargetModel {
  TargetModel {
    bundle: ts_mvp1_target_model_node(),
    lex: ts_wave1_lex(),
    binding_spellings: probe_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn probe_record_expr() -> TargetValueExpression {
  target_value_expression_record_construct(
    type_name: ^probe_type_point,
    fields: [
      TargetValueExprFieldInitSlot {
        label: ^probe_field_x,
        value: target_value_expression_binding_ref(binding: ^probe_val_a)
      },
      TargetValueExprFieldInitSlot {
        label: ^probe_field_y,
        value: target_value_expression_binding_ref(binding: ^probe_val_b)
      }
    ]
  )
}

fn probe_field_access_expr() -> TargetValueExpression {
  target_value_expression_field_access(
    base: target_value_expression_binding_ref(binding: ^probe_val_a),
    field_name: ^probe_field_x
  )
}

fn emit_source(expr: TargetValueExpression) -> String {
  match bind_outcome(
    o: target_value_expression_to_concrete_tokens(
      expr: expr,
      projection: ts_value_expression_projection(),
      catalog: ts_operator_realizations_catalog_node()
    ),
    f: fn(tokens) {
      serialize_concrete_syntax_tokens_to_source(
        target: probe_target_model(),
        tokens: tokens
      )
    }
  ) {
    Accepted { value: source, diagnostics: _ } => source.carried
    Rejected { diagnostics: _ } => "REJECTED"
  }
}

fn probe_record_source() -> String {
  emit_source(expr: probe_record_expr())
}

fn probe_field_access_source() -> String {
  emit_source(expr: probe_field_access_expr())
}
