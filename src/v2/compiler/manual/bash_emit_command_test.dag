
module v2.test.manual.bash_emit_command

// Execution witness for the bash emit TARGET (src/v2/extdeps/languages/bash.dag).
// Slice 1: fixed-token command (#5155). Slice 2: bound-word emit-time quoting.
// Slice 3: source-root-ingest gate fixed two-word command (live transport migration).
//
// Run:
//   gunbc run --source-root src/v2 \
//     --entry src/v2/compiler/manual/bash_emit_command_test.dag \
//     --function bash_emit_command_accepts_holds --claim-run

import v2.compiler.emit { emit }
import v2.compiler.translate { target_serialize_source_from_model }
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.compiler.target_carriers { TargetSource }
import v2.std.compilers.target_model { TargetModel, target_model_emit_transforms_empty }
import v2.extdeps.languages.bash {
  bash_mvp1_emitted_command,
  bash_mvp1_source_text,
  bash_mvp1_lex,
  bash_mvp1_target_model,
  bash_bound_words_target_model,
  bash_embedded_quote_target_model,
  bash_bound_words_emitted_command,
  bash_bound_words_source_text,
  bash_embedded_quote_emitted_command,
  bash_embedded_quote_source_text,
  bash_source_root_ingest_gate_emitted_command,
  bash_source_root_ingest_gate_source_text,
  bash_source_root_ingest_gate_target_model
}
import v2.std.collection { Map, empty_map }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.node { Conj, Node, SyntheticOccurrence, TypeNode }
import v2.std.witness { Violates, Witness }

// The bash emit anchor matches its grammar relation row by exact fixture equality, so `translate`'s
// grammar-first short-circuit returns the node raw and NEVER consults facts. This lookup is
// therefore never called; it fails-closed (Violates) so any unexpected facts consultation surfaces
// as a rejection rather than fabricated data.
fn bash_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: ^bash_emit_facts_unexpected_consultation,
      at: node_locus(node: key),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

data bash_emit_inferred_tree: InferredTree = InferredTree {
  root: bash_mvp1_emitted_command,
  facts: Map {
    lookup: bash_facts_lookup
  }
}

fn anchor_bash_emit_accepts() -> Outcome<TargetSource> {
  emit(tree: bash_emit_inferred_tree, target: bash_mvp1_target_model())
}

data bash_emit_receipt: Outcome<TargetSource> = anchor_bash_emit_accepts()

// Keystone — emit(intent, Bash) must produce the canonical single-quoted command source
// (`'git' 'rev-parse' '--show-toplevel'`). Discriminating: any quoting/word/layout drift in the lex
// rules changes the emitted string and turns this RED.
test fn bash_emit_command_accepts_holds() -> Bool {
  match bash_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source == bash_mvp1_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

// Fail-closed control — a bundle whose Conj carries no `target_model_edge_translation_rules` edge
// must be REJECTED by the serialize path (no fabricated empty/plausible output).
data bash_empty_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data bash_missing_rules_target: TargetModel = TargetModel {
  bundle: bash_empty_bundle,
  lex: bash_mvp1_lex(),
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}

fn anchor_bash_serialize_rejects_missing_rules() -> Outcome<TargetSource> {
  target_serialize_source_from_model(
    target: bash_missing_rules_target,
    emitted: bash_mvp1_emitted_command
  )
}

data bash_serialize_reject_receipt: Outcome<TargetSource> = anchor_bash_serialize_rejects_missing_rules()

test fn bash_emit_missing_rules_rejects_holds() -> Bool {
  match bash_serialize_reject_receipt {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

data bash_bound_words_emit_inferred_tree: InferredTree = InferredTree {
  root: bash_bound_words_emitted_command,
  facts: Map {
    lookup: bash_facts_lookup
  }
}

fn anchor_bash_bound_words_emit() -> Outcome<TargetSource> {
  emit(tree: bash_bound_words_emit_inferred_tree, target: bash_bound_words_target_model())
}

data bash_bound_words_emit_receipt: Outcome<TargetSource> = anchor_bash_bound_words_emit()

// Slice 2 keystone — VarRef double-quoted + Lit single-quoted via emit-time transforms.
// Byte-identical to serialize_bash(command([var_ref("ROOT"), lit("ROOT")])) => "$ROOT" 'ROOT'
test fn bash_emit_bound_words_holds() -> Bool {
  match bash_bound_words_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source == bash_bound_words_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

data bash_embedded_quote_emit_inferred_tree: InferredTree = InferredTree {
  root: bash_embedded_quote_emitted_command,
  facts: Map {
    lookup: bash_facts_lookup
  }
}

fn anchor_bash_embedded_quote_emit() -> Outcome<TargetSource> {
  emit(tree: bash_embedded_quote_emit_inferred_tree, target: bash_embedded_quote_target_model())
}

data bash_embedded_quote_emit_receipt: Outcome<TargetSource> = anchor_bash_embedded_quote_emit()

// Discriminating — embedded `'` in a bound lit must use the canonical POSIX '\'' escape.
test fn bash_emit_embedded_quote_holds() -> Bool {
  match bash_embedded_quote_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source == bash_embedded_quote_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

data bash_source_root_ingest_gate_emit_inferred_tree: InferredTree = InferredTree {
  root: bash_source_root_ingest_gate_emitted_command,
  facts: Map {
    lookup: bash_facts_lookup
  }
}

fn anchor_bash_source_root_ingest_gate_emit() -> Outcome<TargetSource> {
  emit(
    tree: bash_source_root_ingest_gate_emit_inferred_tree,
    target: bash_source_root_ingest_gate_target_model()
  )
}

data bash_source_root_ingest_gate_emit_receipt: Outcome<TargetSource> = anchor_bash_source_root_ingest_gate_emit()

// Slice 3 keystone — first live transport command via row-driven bash emit.
// Byte-identical to serialize_bash(command([lit("bash"), lit("scripts/source-root-ingest-gate.sh")]))
// modulo the sidecar trailing newline.
test fn bash_emit_source_root_ingest_gate_holds() -> Bool {
  match bash_source_root_ingest_gate_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source == bash_source_root_ingest_gate_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}
