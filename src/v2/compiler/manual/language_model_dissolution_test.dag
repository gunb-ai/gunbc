// src/v2/compiler/manual/language_model_dissolution_test.dag
// Scope: discriminating by-execution witness for the Wave 3a-C dissolution of the 13 per-language
//        *LanguageModel type forks into the single std authority `v2.std.language_model.LanguageModel`.
// Status: runnable `test fn` roster (auto-enrolled by the source-root floor pass).
//
// What it pins (§5 fail-closed, discriminating):
//   - A SUBSET language (a field not yet modeled at its wave) inhabits the std carrier by supplying the
//     CANONICAL void/empty inhabitant — NOT a fabricated plausible value. dag has no `core` of its own →
//     `wave1_void()`; swift has no `lex`/`grammar` of its own → `VoidLexRules`/`VoidGrammar`. If a
//     constructor silently fabricated content for an absent field, the subset assertions go RED.
//   - A FULL-SHAPE language (go) carries REAL content for those same fields. If the dissolution had
//     collapsed a modeled field to void, the content-preserved assertions go RED.
// The two directions together discriminate honest-void from both fabrication and content-loss.

module v2.test.manual.language_model_dissolution

import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.model_core { model_core_first_primitive_substrate, wave1_void }
import v2.std.compilers.lexing { lex_rules_to_node, VoidLexRules }
import v2.std.grammar { grammar_to_node, VoidGrammar }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.extdeps.languages.swift { swift_language_model_wave1 }
import v2.extdeps.languages.go { go_language_model_wave1 }

fn void_core_node() -> Node {
  model_core_first_primitive_substrate(core: wave1_void())
}

fn void_lex_node() -> Node {
  lex_rules_to_node(rules: VoidLexRules)
}

fn void_grammar_node() -> Node {
  grammar_to_node(grammar: VoidGrammar)
}

// SUBSET honesty: dag's absent `core` is the canonical void core, not a fabricated one.
test fn dag_subset_core_is_canonical_void() -> Bool {
  !(model_core_first_primitive_substrate(core: dag_language_model_wave1().core) == void_core_node())
}

// SUBSET honesty: swift's absent `lex`/`grammar` are the canonical void inhabitants.
test fn swift_subset_lex_is_canonical_void() -> Bool {
  lex_rules_to_node(rules: swift_language_model_wave1().lex) == void_lex_node()
}

test fn swift_subset_grammar_is_canonical_void() -> Bool {
  grammar_to_node(grammar: swift_language_model_wave1().grammar) == void_grammar_node()
}

// CONTENT preserved (control): go is full-shape — its modeled `core` is NOT void.
// A regression that collapsed a real field to void flips this RED.
test fn go_full_shape_core_is_not_void() -> Bool {
  model_core_first_primitive_substrate(core: go_language_model_wave1().core) == void_core_node()
}

// CONTENT preserved (control): go's modeled `grammar` is NOT void.
test fn go_full_shape_grammar_is_not_void() -> Bool {
  !(grammar_to_node(grammar: go_language_model_wave1().grammar) == void_grammar_node())
}
