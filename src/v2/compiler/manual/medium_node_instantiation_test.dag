// Wave 3a-A foothold: first Medium<Node> instantiation in src/v2.
// Proves cross-tree `import extdeps.communication.medium` resolves in v2 and Medium<Node> can be constructed.
//
// GREEN: Medium<Node>{carried=bool_literal_pin, fidelity=Lossless} — both fields asserted by
//        match/equality (not golden string). Lossy-tagged Medium<Node> correctly NOT-matches Lossless.
// RED (discriminating): perturbing fidelity: Lossless→Lossy in medium_node_lossless() makes
//        medium_node_fidelity_is_lossless() return false → test flips false. Reverting restores.
//
// Run: gunbc run --source-root src/v2 --source-root dsl --entry src/v2/compiler/manual/medium_node_instantiation_test.dag --function medium_node_instantiation_holds --claim-run

module v2.test.manual.medium_node_instantiation

import extdeps.communication.medium { DecodeFidelity, Lossless, Lossy, Medium }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.extdeps.runtimes.v2_evaluator { v2_eval_wave1_bool_literal_pin }

// A real Node used as the carried idea. Reuses the wave-1 bool literal pin (an established
// synthetic atom Node in the corpus) rather than minting a fresh one (§2 DFS re-use).
fn medium_node_lossless() -> Medium<Node> {
  Medium { carried: v2_eval_wave1_bool_literal_pin, fidelity: Lossless }
}

// GREEN: carried field reads back as the exact Node we put in.
fn medium_node_carried_is_expected() -> Bool {
  medium_node_lossless().carried == v2_eval_wave1_bool_literal_pin
}

// GREEN: fidelity field reads back as Lossless (asserted by match, not golden string).
fn medium_node_fidelity_is_lossless() -> Bool {
  match medium_node_lossless().fidelity {
    Lossless => true
    Lossy => false
  }
}

// Discriminating control: a Lossy-tagged Medium<Node> does NOT match Lossless.
// If the fidelity field were fabricated-always-Lossless, this returns false → test fails.
fn medium_node_lossy_tag_not_lossless() -> Bool {
  match (Medium { carried: v2_eval_wave1_bool_literal_pin, fidelity: Lossy }).fidelity {
    Lossless => false
    Lossy => true
  }
}

test fn medium_node_instantiation_holds() -> Bool {
  medium_node_carried_is_expected()
    && medium_node_fidelity_is_lossless()
    && medium_node_lossy_tag_not_lossless()
}
