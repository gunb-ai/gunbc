  InferredFacts,
  InferredFactsEntry,
  InferredTree,
  admitted_inferred_facts_entry,
  facts_map_from_entries
}
import extdeps.communication.medium { Medium }
import v2.compiler.translate {
  serialize_concrete_syntax_tokens_to_source,
  translate_project_transform_in_arrow_scope
}
import v2.lens.application { subterm_at }
import std.algebra { Empty }
import v2.std.algebra { any, fold_list, list_append, list_snoc_item }
import v2.std.collection {
  List,
  Map
}
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_present
}
import v2.std.compilers.target_model {
  TargetModel,
  TargetOwnershipUseSite,
  TargetUseSiteOwnershipRealization,
  OwnershipAtBindingProjection,
  OwnershipAtFunctionParameter,
  OwnershipAtFunctionReturn,
  OwnershipAtStructField,
  ReferenceLayerOwned,
  UseSiteOwnershipExactCarrier,
  target_carrier_type_node,
  target_model_augment_use_site_ownership_catalog,
  target_model_augment_value_semantics_carriers,
  target_project_arrow_body_to_value_expression,
  target_value_expr_arrow_has_value_expression_body,
  target_value_expression_projection_from_target,
  target_value_expression_tokens_from_target
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected,
  port_locus
}
