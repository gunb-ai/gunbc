module v2.compiler.ingested_fixture_arrows


data ingested_fixture_arrows_note: String = "Wave 1 Gate 1 Stage D: census-ingest Arrow fixtures replacing produce_* flat-token MVP producers. Every arrow is tokenize→parse_module→normalize→resolve→extract. dissolve-on: general body producer fully subsumes produce_* and flat-token StampBinding tables (wave-2). Well-formedness + behavior-kind: long/wave1_gate1_d_mvp_subsumption_witness_test.dag; ingested bind/loop execution+RED: long/wave1_gate1_d_ingested_bind_loop_eval_witness_test.dag; add/pick/match execution: long/wave1_gate1_general_body_producer_witness_test.dag and execution/pick_ingested_*."

data ingested_add_module_source: String = "module m\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"
data ingested_add_swapped_operands_module_source: String = "module m\n\nfn add(x: Int, y: Int) -> Int { y + x }\n"

data ingested_pick_module_source: String = "module m\n\nfn pick() -> Int { if true { 1 } else { 2 } }\n"
data ingested_pick_false_module_source: String = "module m\n\nfn pick() -> Int { if false { 1 } else { 2 } }\n"
data ingested_pick_swapped_arms_module_source: String = "module m\n\nfn pick() -> Int { if true { 2 } else { 1 } }\n"

data ingested_loop_module_source: String = "module m\n\nfn one() -> Int { loop 1 }\n"
data ingested_loop_wrong_value_module_source: String = "module m\n\nfn one() -> Int { loop 2 }\n"

data ingested_bind_module_source: String = "module m\n\nfn one() -> Int { let x = 1 in x }\n"
data ingested_bind_wrong_value_module_source: String = "module m\n\nfn one() -> Int { let x = 2 in x }\n"

data ingested_match_module_source: String = "module m\n\nfn classical_not(a: Int) -> Int {\n  match a {\n    true => false,\n    false => true\n  }\n}\n"
data ingested_match_swapped_arms_module_source: String = "module m\n\nfn classical_not(a: Int) -> Int {\n  match a {\n    true => true,\n    false => false\n  }\n}\n"

data ingested_id_module_source: String = "module m\n\nfn id(x: Int) -> Int { x }\n"
data ingested_zero_module_source: String = "module m\n\nfn zero() -> Int { 0 }\n"

fn ingested_fixture_diagnostic(reason: v2.std.node.Symbol, n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn ingested_find_arrow_in_module(root: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  match root.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } => v2.std.optional.Present { value: root }
    _ =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          v2.std.optional.Present { value: _ } => acc
          v2.std.optional.Absent => ingested_find_arrow_in_module(root: e.target)
        }
      })
  }
}

data ingested_resolved_module_projection_note: String = "THIS IS NOW A PROJECTION, NOT AN IMPLEMENTATION. The tokenize -> parse -> normalize -> resolve order it used to spell as a nest of bind_outcome lives in v2.compiler.staged_front_end, which mints per-stage evidence; this arrow folds that staged run back to the single Outcome<Node> its callers have always received. It does not re-run a stage, does not re-derive the answer by a second route, and has no order of its own to drift from the one it projects — which is the whole reason the front end moved rather than being copied (DESIGN section 3)."

fn ingested_resolved_module_from_source(source: String, file: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.compiler.staged_front_end.front_end_run_outcome(run: v2.compiler.staged_front_end.run_front_end(source: source, file: file))
}

fn ingested_arrow_from_source(source: String, file: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: ingested_resolved_module_from_source(source: source, file: file),
    f: fn(resolved) {
      match ingested_find_arrow_in_module(root: resolved) {
        v2.std.optional.Present { value: arrow } =>
          if v2.std.node.well_formed(n: arrow) {
            v2.std.diagnostic.outcome_accepted(value: arrow)
          } else {
            v2.std.diagnostic.outcome_rejected(
              d: ingested_fixture_diagnostic(
                reason: ^ingested_fixture_reason_arrow_not_well_formed,
                n: arrow
              )
            )
          }
        v2.std.optional.Absent =>
          v2.std.diagnostic.outcome_rejected(
            d: ingested_fixture_diagnostic(
              reason: ^ingested_fixture_reason_arrow_missing,
              n: resolved
            )
          )
      }
    }
  )
}

fn ingested_add_arrow_with_body() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  ingested_arrow_from_source(
    source: ingested_add_module_source,
    file: ^ingested_fixture_add_file
  )
}

fn ingested_add_arrow_with_body_swapped_operands() -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  ingested_arrow_from_source(
    source: ingested_add_swapped_operands_module_source,
    file: ^ingested_fixture_add_swapped_file
  )
}

