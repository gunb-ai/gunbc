module v2.compiler.reference_site_collector

import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { fold_list, is_empty, length, list_snoc_item }
import v2.std.diagnostic { Accepted, Locus, Rejected, node_locus }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v2.std.optional { Absent, Present }
import v2.std.qualified_name {
  QualifiedName,
  qualified_name_from_node,
  qualified_name_snoc
}
import v2.compiler.resolution_provenance { ReferenceSite }
import v2.extdeps.languages.dag {
  dag_node_is_int_literal_atom,
  dag_surface_module_header_metadata_edge,
  namespace_graft_spine_segment_edge_optional,
  qualified_name_from_module_node
}

// THE MENTION PRODUCER v2.compiler.resolution_provenance HAS BEEN MISSING SINCE IT WAS WRITTEN.
// That module models one name resolved at one position answering with its target and the module
// that contains it, and it models the dependency fold over those answers -- but nothing in the
// corpus produced a ReferenceSite. The only constructors were five hand-authored fixture rows in
// one witness, which makes a well-shaped module dangling in DESIGN section 3c's exact sense: a
// declaration whose consumers are described rather than executed. This module is that producer.
//
// ONE COLLECTOR, TWO STAGES -- AND THAT CLAIM WAS FALSE AS FIRST WRITTEN, SO IT IS RESTATED HERE
// RATHER THAN QUIETLY DROPPED.
//
// This header said "the site enumeration is here, once, and both stages consume it". It is not
// once. v2.lens.reference_deps reference_sites_collect_node ALREADY enumerates reference sites,
// from the PARSED tree, via ^dag_surface_qualified_name productions -- and its own dissolution note
// describes the successor in terms that name this module's territory: "dissolves when
// symbol_index_fill projects reference edges from the filled containment tree and non-import
// qualified-name sites require the parsed census path". I did not find it before writing this
// module, which is the section 6 move -- DFS the concept DAG before inventing vocabulary -- skipped
// at the one point it mattered most.
//
// THE OVERLAP IS REAL BUT NARROWER THAN I FIRST WROTE, AND I CHECKED THE SECOND TIME. I claimed
// the lens recognises "exactly the class this collector misses -- a qualified cross-module
// reference in a body". THAT IS FALSE. The lens keys on ^dag_surface_qualified_name and the import
// productions and NOTHING ELSE -- it carries no dot or field-access handling at all. A qualified
// reference in a BODY parses as a field access, not a qualified-name production, so the lens misses
// it too. What the lens does see is a qualified name in a TYPE position, where the production
// survives.
//
// SO NEITHER INSTRUMENT SEES A QUALIFIED BODY REFERENCE, and the overlap between them is the
// type-position qualified name rather than the whole qualified class. That is also why
// warm-ibex-518's deleted parse walk was genuinely a duplicate: it keyed on the same production.
//
// THE CONSOLIDATION IS RULED AND IT IS NOT "CONSUME THE LENS". The authority for reference sites is
// the collector over the tree THE RESOLVER CONSUMES -- a site must be something resolution
// resolves, and the lens reads the parse tree. The lens is itself a declared SCAFFOLD whose own
// dissolution names a symbol_index_fill-derived projection, so consuming its recogniser would be
// building on a scaffold. Its disposition is repointed at this module instead, and the overlap is
// recorded as a DECLARED FRONTIER rather than as consolidated: two enumerators stand today, on two
// trees, and this one becomes the single authority when it covers qualified sites -- which waits on
// the dotted-reference capability, still under verification and NOT escalated to another lane.
// WHAT COUNTS AS A MENTION, AND WHY A DECLARATION IS NOT ONE. In the v2 containment tree a
// declaration's NAME is an EDGE LABEL (v2.compiler.symbol_index_fill binds at
// Named { name } edges and indexes edge.target as the declaration), so a declared name never
// appears as a node. An Atom node is therefore a reference by construction rather than by a filter
// that could be wrong -- there is no declaration-shaped Atom for this walk to have to exclude.
//
// ONE DELIBERATE EXCLUSION, AND IT IS NOT A FILTER ON ELIGIBILITY. Module-header metadata subtrees
// carry the module's OWN qualified name, which is a declaration of position and not a mention of
// anything. It is recognised by the SAME predicate v2.compiler.symbol_index_fill consults, never by
// a second spelling of it.
//
// A SECOND EXCLUSION STOOD HERE AND WAS DELETED BY MEASUREMENT. It skipped every `_node_projection`
// edge, on the reasoning that such an edge carries a parse projection of source already visited and
// descending would double-count. THAT DOUBLE-COUNT WAS NEVER DEMONSTRATED, and the guard's real
// effect was the opposite of its intent: on the tree the production ingest yields, a module's
// content hangs under exactly those edges, so the exclusion returned ZERO sites for the whole
// corpus while hand-built fixtures -- which carry no such edge -- stayed green. Isolated by
// disabling the arm and re-running the same fixture. The lesson is kept here rather than in a
// commit message because the guard looks obviously correct in isolation: a speculative exclusion
// over a shape the author has not observed is indistinguishable from a blackout until something
// executes against the real tree.

// SPINE UNWRAPPING IS A MODULE-BOUNDARY MOVE AND IS DONE ONCE, AT THE ROOT, IN
// module_reference_sites BELOW. It used to run on EVERY node, which was wrong for a reason worth
// stating: namespace_graft_spine_segment_edge_optional recognises ANY single named edge targeting a
// Conj, not specifically a module-prefix spine segment, so applying it recursively silently dropped
// ordinary nested declaration and field labels from the position while continuing to walk -- which
// yields a mention recorded at a containment chain it does not sit at, and therefore resolved
// against the wrong lexical scope. A mislocated mention is worse than a missing one: it is a
// fabricated plausible answer (DESIGN section 5) rather than an absence someone can count.
//
// POSITION IS THE CONTAINMENT CHAIN OF THE MENTION, AND IT IS NOT THE INDEX'S PATH RULE.
// v2.compiler.symbol_index_fill specialises Disj (variant paths) and Arrow (domain only) because
// it is deciding WHERE A BINDING LIVES. This walk is deciding where a MENTION SITS, and a mention
// in an arrow's codomain sits exactly where its containment chain says it does -- so the rule here
// is uniform over edges: a named edge extends the position by its label, a positional edge does
// not. The two rules agree wherever a binding and a mention coincide and differ only where the
// index deliberately stops walking, which is the difference between the two questions rather than
// a divergence between two answers to one question.
// THE O(1) REJECT THAT KEEPS THIS WALK LINEAR IS INSIDE qualified_name_from_node ITSELF.
//
// qualified_name_from_node FOLDS AN ENTIRE SUBTREE before it can answer, and this walk then
// descends into that same subtree -- so asking it at every Conj made the traversal quadratic in
// nesting depth. DESIGN section 6 rules a proven cost-shape defect is always fixed regardless of
// the realised n, so a cheap precondition is required; the question was WHERE IT LIVES.
//
// IT WAS WRITTEN HERE FIRST AND THAT WAS A SECOND RECOGNISER FOR ONE CONCEPT. Two places deciding
// what a qualified-name spine looks like is section 3's nickname at the meaning layer, and the
// failure is silent and lands on exactly this PR's subject: widen the accepted spine in
// qualified_name and a prefilter sitting over here answers `false`, so this walk falls through to
// the children and emits every segment of `a.b.C` as its own BARE SAME-MODULE mention -- which is
// the cross-module class XL-0's denominator is made of, quietly turned into local noise.
//
// It was written here first, then moved beside that fold as a pair of Bool predicates, and is now
// the fold's OWN FIRST STEP -- because a Bool sitting beside the Outcome was still a second surface
// deciding the same thing, and section 2's test is net CONCEPTS rather than net files. This module
// matches the Outcome and gets the linear behaviour for free.
fn reference_sites_in_edge(
  acc: ReferenceSiteCollection,
  position: QualifiedName,
  inside_import: Bool,
  edge: Edge
) -> ReferenceSiteCollection {
  match edge.label {
    Named { name: sym } =>
      if dag_surface_module_header_metadata_edge(name: sym) {
        acc
      } else {
        reference_sites_in_node(
          acc: acc,
          position: qualified_name_snoc(qn: position, segment: sym),
          inside_import: inside_import || edge_enters_import_surface(name: sym),
          node: edge.target
        )
      }
    Positional =>
      reference_sites_in_node(
        acc: acc,
        position: position,
        inside_import: inside_import,
        node: edge.target
      )
  }
}

fn reference_sites_in_children(
  acc: ReferenceSiteCollection,
  position: QualifiedName,
  inside_import: Bool,
  node: Node
) -> ReferenceSiteCollection {
  fold(node.children, init: acc, f: fn(inner, edge) {
    reference_sites_in_edge(
      acc: inner,
      position: position,
      inside_import: inside_import,
      edge: edge
    )
  })
}

fn collection_snoc_site(
  acc: ReferenceSiteCollection,
  inside_import: Bool,
  site: ReferenceSite
) -> ReferenceSiteCollection {
  if inside_import {
    ReferenceSiteCollection {
      sites: acc.sites,
      import_sites: list_snoc_item(xs: acc.import_sites, item: site),
      unreadable_roots: acc.unreadable_roots
    }
  } else {
    ReferenceSiteCollection {
      sites: list_snoc_item(xs: acc.sites, item: site),
      import_sites: acc.import_sites,
      unreadable_roots: acc.unreadable_roots
    }
  }
}

// THE ACCUMULATOR IS THREADED, NEVER APPENDED. A walk that built a list per node and concatenated
// on the way up is the copied-accumulator cost shape DESIGN section 6 rules is always fixed
// regardless of the realised n, so the single list is carried down and snoc'd at the two emit
// points. Every recursion below therefore takes `acc` and returns the same list grown.
// A DOTTED MENTION IS ONE SITE, NOT ONE PER SEGMENT. `qualified_name_from_node` accepts only the
// fold-list-of-atoms shape an authored qualified spelling has, so a Conj it accepts IS the mention
// and its segment atoms are that mention's spelling rather than mentions of their own. Descending
// after emitting would count `a.b.C` four times.
//
// AN INT LITERAL ATOM CARRIES A VALUE, NOT A NAME: the resolver's own atom arm short-circuits it
// before any lookup, so admitting it here would manufacture an unbound mention the resolver never
// asks about.
fn reference_sites_in_node(
  acc: ReferenceSiteCollection,
  position: QualifiedName,
  inside_import: Bool,
  node: Node
) -> ReferenceSiteCollection {
  match qualified_name_from_node(root: node) {
    Accepted { value: qn, diagnostics: _ } =>
      if is_empty(xs: qn) {
        reference_sites_in_children(
          acc: acc,
          position: position,
          inside_import: inside_import,
          node: node
        )
      } else {
        collection_snoc_site(
          acc: acc,
          inside_import: inside_import,
          site: ReferenceSite { position: position, spelling: qn }
        )
      }
    Rejected { diagnostics: _ } =>
      match node.kind {
        TypeNode { connective: Atom { identity: sym } } =>
          if dag_node_is_int_literal_atom(node: node) {
            acc
          } else {
            collection_snoc_site(
              acc: acc,
              inside_import: inside_import,
              site: ReferenceSite {
                position: position,
                spelling: Cons { head: sym, tail: Empty }
              }
            )
          }
        _ =>
          reference_sites_in_children(
            acc: acc,
            position: position,
            inside_import: inside_import,
            node: node
          )
      }
  }
}

type UnreadableModuleRoot {
  locus: Locus
}

// The collector's answer is the pair, never the sites alone, so a caller cannot take the population
// without also taking what was lost producing it. That is the shape section 5 asks for: the refusal
// travels WITH the result rather than beside it where it can be ignored.
// IMPORT-STATEMENT MENTIONS ARE THEIR OWN ARM, NEITHER MIXED IN NOR DROPPED.
//
// They used to arrive in `sites` as ordinary mentions, and that was a defect with two heads. For
// XL-0 it pollutes the denominator with the very import surface the cut DELETES -- an import is the
// thing being removed, not a reference needing respelling. And it makes every spelling-match
// unable to tell an import from a use: this collector's own witness asserted "a type-position name
// reaches" and was GREEN ON THE IMPORT LINE, which is how the defect was found.
//
// A TYPED ARM RATHER THAN AN EXCLUSION, DELIBERATELY. Dropping them at the producer would destroy
// information every consumer might want -- the import surface is exactly what XL-5's rewrites and
// XL-7's grammar deletion operate on -- and a silent drop is the shape DESIGN section 5 forbids.
// Carrying them classified lets each consumer choose without re-walking, which is the point: XL-4
// was filtering import-decl sites by position on ITS side while XL-0 was not, so one question had
// two policies in two lanes. It is answered once, here.
type ReferenceSiteCollection {
  sites: FreeMonoid<ReferenceSite>
  import_sites: FreeMonoid<ReferenceSite>
  unreadable_roots: FreeMonoid<UnreadableModuleRoot>
}

fn empty_reference_site_collection() -> ReferenceSiteCollection {
  ReferenceSiteCollection { sites: Empty, import_sites: Empty, unreadable_roots: Empty }
}

// The import surface is recognised by the grammar's OWN emitted production identities, not by a
// shape guess and not by a spelling: a mention is an import mention exactly when it sits under one
// of these, which is the same vocabulary the parser stamps.
fn edge_enters_import_surface(name: Symbol) -> Bool {
  (name == ^dag_surface_import_decl)
    || (name == ^dag_surface_import_block)
    || (name == ^dag_surface_import_decl_block)
    || (name == ^dag_surface_import_decl_qualified_name)
}

fn reference_site_collection_is_total(collection: ReferenceSiteCollection) -> Bool {
  is_empty(xs: collection.unreadable_roots)
}

// THE SPINE IS ONE WRAPPER PER SEGMENT, SO ONE UNWRAP WAS WRONG BY length(module_qn) - 1.
//
// v2.compiler.namespace_graft namespace_graft_fold_spine folds the module's qualified name and
// wraps ONCE PER SEGMENT. Unwrapping a single level left the remaining wrappers standing, and the
// generic named-edge rule below then walked them as ordinary containment -- re-appending those very
// segments to a position that already carried them, so a mention in `a.b.c` was recorded at
// `a.b.c.b.c`. A mislocated mention is a fabricated plausible answer (DESIGN section 5), and it
// changes which lexical scope the resolver walks, so it is worse than an absent one.
//
// THE COUNT IS DERIVED, NOT GUESSED. It is the length of the module qualified name this same walk
// already resolved from the header -- the identical value the spine was folded from -- rather than
// "keep unwrapping while the shape matches". That distinction is load-bearing:
// namespace_graft_spine_segment_edge_optional recognises ANY single named edge targeting a Conj, so
// a shape-driven loop would happily eat a genuine one-declaration module body. Consuming the count
// makes over-unwrapping unwritable rather than merely unlikely.
fn module_spine_unwrapped(root: Node, segments_remaining: Int) -> Node {
  if segments_remaining <= 0 {
    root
  } else {
    match namespace_graft_spine_segment_edge_optional(node: root) {
      Present { value: spine_edge } =>
        module_spine_unwrapped(
          root: spine_edge.target,
          segments_remaining: segments_remaining - 1
        )
      Absent => root
    }
  }
}

fn module_reference_sites(
  acc: ReferenceSiteCollection,
  root: Node
) -> ReferenceSiteCollection {
  match qualified_name_from_module_node(root: root) {
    Accepted { value: module_qn, diagnostics: _ } =>
      reference_sites_in_node(
        acc: acc,
        position: module_qn,
        inside_import: false,
        node: module_spine_unwrapped(
          root: root,
          segments_remaining: length(xs: module_qn)
        )
      )
    Rejected { diagnostics: _ } =>
      ReferenceSiteCollection {
        sites: acc.sites,
        import_sites: acc.import_sites,
        unreadable_roots: list_snoc_item(
          xs: acc.unreadable_roots,
          item: UnreadableModuleRoot { locus: node_locus(node: root) }
        )
      }
  }
}

fn collect_module_reference_sites(root: Node) -> ReferenceSiteCollection {
  module_reference_sites(acc: empty_reference_site_collection(), root: root)
}

fn collect_reference_sites(roots: FreeMonoid<Node>) -> ReferenceSiteCollection {
  fold_list(
    xs: roots,
    empty: empty_reference_site_collection(),
    cons: fn(acc, root) {
      module_reference_sites(acc: acc, root: root)
    }
  )
}
