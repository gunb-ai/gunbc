module v2.compiler.eval


type InterpretationCacheAuthority {
  runtime_identity: v2.std.node.Symbol,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  semantics_digest: v2.std.node.Hash,
  structure_witness: v2.std.runtime.InterpretationStructureWitness
}

type Inputs {
  root: v2.std.node.Node

  expected_eval_root: v2.std.optional.Optional<v2.std.node.Node>

  host_claim_pin: v2.std.optional.Optional<v2.std.node.Node>
}

fn inputs_root_only(root: v2.std.node.Node) -> Inputs {
  Inputs {
    root: root,
    expected_eval_root: v2.std.optional.optional_absent(),
    host_claim_pin: v2.std.optional.optional_absent()
  }
}

fn symbol_atom_node(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn inputs_for_emit_host(
  claim_input_root: v2.std.node.Node,
  expected_eval_root: v2.std.node.Node,
  claim_pin: v2.std.node.Symbol
) -> Inputs {
  Inputs {
    root: claim_input_root,
    expected_eval_root: v2.std.optional.optional_present(value: expected_eval_root),
    host_claim_pin: v2.std.optional.optional_present(value: symbol_atom_node(sym: claim_pin))
  }
}

type EffectIoEvalBundle {
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend
  store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
  handlers: v2.std.runtime.EffectHandlerBinding
  receipt_log: v2.std.runtime.EffectReceiptLog
}

type EffectIoYieldOutcome {
  bundle: EffectIoEvalBundle
  value: v2.std.runtime.RuntimeValue
}

type EffectIoEvalContext
  = EffectIoEvalAbsent
  | EffectIoEvalPresent { bundle: EffectIoEvalBundle }

type EvalContext {
  cache_authority: InterpretationCacheAuthority
  effect_io: EffectIoEvalContext
}

fn eval_context_effect_io(context: EvalContext) -> EffectIoEvalContext {
  context.effect_io
}

fn eval_context_with_semantics(
  runtime_identity: v2.std.node.Symbol,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  structure_witness: v2.std.runtime.InterpretationStructureWitness
) -> EvalContext {
  EvalContext {
    cache_authority: InterpretationCacheAuthority {
      runtime_identity: runtime_identity,
      interpretation: interpretation,
      semantics_digest: interpretation_registry_semantics_digest(
        runtime_identity: runtime_identity,
        interpretation: interpretation,
        structure_witness: structure_witness
      ),
      structure_witness: structure_witness
    },
    effect_io: EffectIoEvalAbsent
  }
}

fn eval_context_with_effect_io(
  runtime_identity: v2.std.node.Symbol,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  structure_witness: v2.std.runtime.InterpretationStructureWitness,
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
) -> EvalContext {
  let handler_bundle = v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_handler_binding(store: store)
  EvalContext {
    cache_authority: InterpretationCacheAuthority {
      runtime_identity: runtime_identity,
      interpretation: interpretation,
      semantics_digest: interpretation_registry_semantics_digest(
        runtime_identity: runtime_identity,
        interpretation: interpretation,
        structure_witness: structure_witness
      ),
      structure_witness: structure_witness
    },
    effect_io: EffectIoEvalPresent {
      bundle: EffectIoEvalBundle {
        backend: backend,
        store: store,
        handlers: handler_bundle.handlers,
        receipt_log: v2.std.runtime.EffectReceiptLog { entries: std.algebra.Empty }
      }
    }
  }
}

fn eval_context_v4_evaluator() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^v2_evaluator_runtime_id,
    interpretation: v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation(),
    structure_witness: v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation_structure_witness()
  )
}

fn interpretation_structure_witness_slots_digest(w: v2.std.runtime.InterpretationStructureWitness) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: v2.std.node.combine_hash(
      a: v2.std.node.combine_hash(
        a: v2.std.node.combine_hash(
          a: test_claim_symbol_digest(sym: w.allocate_literal),
          b: test_claim_symbol_digest(sym: w.call_primitive)
        ),
        b: test_claim_symbol_digest(sym: w.choose_branch)
      ),
      b: v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: w.step_loop),
        b: test_claim_symbol_digest(sym: w.bind_value)
      )
    ),
    b: test_claim_symbol_digest(sym: w.choose_arm)
  )
}

fn interpretation_structure_witness_digest(
  runtime_identity: v2.std.node.Symbol,
  structure_witness: v2.std.runtime.InterpretationStructureWitness
) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: test_claim_symbol_digest(sym: runtime_identity),
    b: interpretation_structure_witness_slots_digest(w: structure_witness)
  )
}

fn interpretation_value_interpreter_executed_digest(v: v2.std.runtime.ValueInterpreter) -> v2.std.node.Hash {
  test_claim_symbol_digest(sym: v.identity)
}

fn interpretation_transform_interpreter_executed_digest(t: v2.std.runtime.TransformInterpreter) -> v2.std.node.Hash {
  test_claim_symbol_digest(sym: t.identity)
}

fn interpretation_branch_interpreter_executed_digest(b: v2.std.runtime.BranchInterpreter) -> v2.std.node.Hash {
  test_claim_symbol_digest(sym: b.identity)
}

fn interpretation_loop_interpreter_executed_digest(l: v2.std.runtime.LoopInterpreter) -> v2.std.node.Hash {
  test_claim_symbol_digest(sym: l.identity)
}

fn interpretation_bind_interpreter_executed_digest(b: v2.std.runtime.BindInterpreter) -> v2.std.node.Hash {
  test_claim_symbol_digest(sym: b.identity)
}

fn interpretation_match_interpreter_executed_digest(m: v2.std.runtime.MatchInterpreter) -> v2.std.node.Hash {
  test_claim_symbol_digest(sym: m.identity)
}

fn interpretation_value_interpreter_slot_coherent(v: v2.std.runtime.ValueInterpreter, witness_sym: v2.std.node.Symbol) -> Bool {
  v.identity == witness_sym
}

fn interpretation_transform_interpreter_slot_coherent(t: v2.std.runtime.TransformInterpreter, witness_sym: v2.std.node.Symbol) -> Bool {
  t.identity == witness_sym
}

fn interpretation_branch_interpreter_slot_coherent(b: v2.std.runtime.BranchInterpreter, witness_sym: v2.std.node.Symbol) -> Bool {
  b.identity == witness_sym
}

fn interpretation_loop_interpreter_slot_coherent(l: v2.std.runtime.LoopInterpreter, witness_sym: v2.std.node.Symbol) -> Bool {
  l.identity == witness_sym
}

fn interpretation_bind_interpreter_slot_coherent(b: v2.std.runtime.BindInterpreter, witness_sym: v2.std.node.Symbol) -> Bool {
  b.identity == witness_sym
}

fn interpretation_match_interpreter_slot_coherent(m: v2.std.runtime.MatchInterpreter, witness_sym: v2.std.node.Symbol) -> Bool {
  m.identity == witness_sym}

fn interpretation_structure_witness_coherent(
  interpretation: v2.std.runtime.InterpretationAlgebra,
  structure_witness: v2.std.runtime.InterpretationStructureWitness
) -> Bool {
  interpretation_value_interpreter_slot_coherent(v: interpretation.value, witness_sym: structure_witness.allocate_literal)
    && interpretation_transform_interpreter_slot_coherent(t: interpretation.transform, witness_sym: structure_witness.call_primitive)
    && interpretation_branch_interpreter_slot_coherent(b: interpretation.branch, witness_sym: structure_witness.choose_branch)
    && interpretation_loop_interpreter_slot_coherent(l: interpretation.loop, witness_sym: structure_witness.step_loop)
    && interpretation_bind_interpreter_slot_coherent(b: interpretation.bind, witness_sym: structure_witness.bind_value)
    && interpretation_match_interpreter_slot_coherent(m: interpretation.match, witness_sym: structure_witness.choose_arm)
}

fn interpretation_algebra_executed_slots_digest(interpretation: v2.std.runtime.InterpretationAlgebra) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: v2.std.node.combine_hash(
      a: v2.std.node.combine_hash(
        a: v2.std.node.combine_hash(
          a: interpretation_value_interpreter_executed_digest(v: interpretation.value),
          b: interpretation_transform_interpreter_executed_digest(t: interpretation.transform)
        ),
        b: interpretation_branch_interpreter_executed_digest(b: interpretation.branch)
      ),
      b: v2.std.node.combine_hash(
        a: interpretation_loop_interpreter_executed_digest(l: interpretation.loop),
        b: interpretation_bind_interpreter_executed_digest(b: interpretation.bind)
      )
    ),
    b: interpretation_match_interpreter_executed_digest(m: interpretation.match)
  )
}

fn interpretation_algebra_executed_structure_digest(
  runtime_identity: v2.std.node.Symbol,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  structure_witness: v2.std.runtime.InterpretationStructureWitness
) -> v2.std.node.Hash {
  let executed = v2.std.node.combine_hash(
    a: test_claim_symbol_digest(sym: runtime_identity),
    b: interpretation_algebra_executed_slots_digest(interpretation: interpretation)
  )
  if interpretation_structure_witness_coherent(
    interpretation: interpretation,
    structure_witness: structure_witness
  ) {
    executed
  } else {
    v2.std.node.combine_hash(
      a: executed,
      b: interpretation_structure_witness_digest(
        runtime_identity: runtime_identity,
        structure_witness: structure_witness
      )
    )
  }
}

fn interpretation_v4_evaluator_registry_semantics_digest(
  interpretation: v2.std.runtime.InterpretationAlgebra
) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: test_claim_symbol_digest(sym: ^v2_evaluator_runtime_id),
    b: interpretation_algebra_executed_slots_digest(interpretation: interpretation)
  )
}

fn interpretation_registry_semantics_digest(
  runtime_identity: v2.std.node.Symbol,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  _structure_witness: v2.std.runtime.InterpretationStructureWitness
) -> v2.std.node.Hash {
  if runtime_identity == ^v2_evaluator_runtime_id {
    if interpretation == v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation() {
      interpretation_v4_evaluator_registry_semantics_digest(interpretation: interpretation)
    } else {
      test_claim_symbol_digest(sym: ^test_claim_cache_interpretation_semantics_mismatch_tag)
    }
  } else {
    interpretation_algebra_executed_slots_digest(interpretation: interpretation)
  }
}

fn eval_context_interpretation(context: EvalContext) -> v2.std.runtime.InterpretationAlgebra {
  context.cache_authority.interpretation
}

type TestClaimTypedInput<T> {
  evaluator_input: T
  evaluator_pin: v2.std.node.Symbol
}

type TestClaimEvalSubject<T> {
  claim: v2.std.verification.TestClaim
  context: EvalContext
  tree: v2.compiler.inferred_tree.InferredTree
  input: TestClaimTypedInput<T>
}

type TestClaimCacheKey<T> {
  eval_subject: TestClaimEvalSubject<T>
}

fn test_claim_cache_key_claim_hash<T>(key: TestClaimCacheKey<T>) -> v2.std.node.Hash {
  test_claim_claim_hash_digest(c: key.eval_subject.claim)
}

fn test_claim_cache_key_interpretation_hash_node(key: TestClaimCacheKey<v2.std.node.Node>) -> v2.std.node.Hash {
  test_claim_cache_interpretation_hash_node(subject: key.eval_subject)
}

type TestClaimCacheReceipt<T> {
  key: TestClaimCacheKey<T>
}

type TestClaimRun<S, A> {
  cache: TestClaimCacheReceipt<S>
  verdict: v2.std.verdict.Verdict<TestClaimEvalSubject<S>, A>
}

fn test_claim_cache_key_claim<T>(key: TestClaimCacheKey<T>) -> v2.std.verification.TestClaim {
  key.eval_subject.claim
}

fn test_claim_cache_receipt_claim<T>(receipt: TestClaimCacheReceipt<T>) -> v2.std.verification.TestClaim {
  test_claim_cache_key_claim(key: receipt.key)
}

fn test_claim_run_claim<S, A>(run: TestClaimRun<S, A>) -> v2.std.verification.TestClaim {
  test_claim_cache_receipt_claim(receipt: run.cache)
}

fn test_claim_run_verdict<S, A>(run: TestClaimRun<S, A>) -> v2.std.verdict.Verdict<TestClaimEvalSubject<S>, A> {
  run.verdict
}

type EvalFoldState {
  node: v2.std.node.Node
  progress: EvalProgress
  structural: v2.std.diagnostic.Outcome<v2.std.node.Node>
  child_values: v2.std.diagnostic.Outcome<List<v2.std.runtime.RuntimeValue>>
  value: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
}

type EvalProgress
  = AwaitingChildren { processed: Int }
  | ReadyToInterpret
  | Interpreted

fn test_claim_typed_input_node(evaluator_input: v2.std.node.Node, evaluator_pin: v2.std.node.Symbol) -> TestClaimTypedInput<v2.std.node.Node> {
  TestClaimTypedInput {
    evaluator_input: evaluator_input,
    evaluator_pin: evaluator_pin
  }
}

fn test_claim_cache_digest_tag_node(tag: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: tag } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn test_claim_evaluation_nodes_digest(c: v2.std.verification.TestClaim) -> v2.std.node.Hash {
  v2.std.algebra.fold_list(
    xs: v2.std.verification.test_claim_evaluation_nodes(c: c),
    empty: v2.std.node.content_hash(n: test_claim_cache_digest_tag_node(tag: ^test_claim_cache_claim_digest_tag)),
    cons: fn(acc, n) {
      v2.std.node.combine_hash(a: acc, b: v2.std.node.content_hash(n: n))
    }
  )
}

fn no_correction_reason_digest(reason: v2.std.diagnostic.NoCorrectionReason) -> v2.std.node.Hash {
  match reason {
    UserInputBoundary =>
      test_claim_symbol_digest(sym: ^test_claim_no_correction_user_input_boundary_tag)
    AmbiguousIntent =>
      test_claim_symbol_digest(sym: ^test_claim_no_correction_ambiguous_intent_tag)
    ExternalContractUnknown =>
      test_claim_symbol_digest(sym: ^test_claim_no_correction_external_contract_unknown_tag)
    CorrectionNotModeled =>
      test_claim_symbol_digest(sym: ^test_claim_no_correction_correction_not_modeled_tag)
  }
}

fn correction_verdict_digest(c: v2.std.diagnostic.Correction) -> v2.std.node.Hash {
  match c {
    Suggested { node: n } =>
      v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: ^test_claim_cache_correction_suggested_tag),
        b: v2.std.node.content_hash(n: n)
      )
    Unavailable { reason: r } =>
      v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: ^test_claim_cache_correction_unavailable_tag),
        b: no_correction_reason_digest(reason: r)
      )
  }
}

fn byte_offset_cache_key_extent_component(key: v2.std.node.ByteOffsetCacheKey) -> v2.std.node.Hash {
  match key {
    ByteOffsetCacheEligible { digest: digest } => digest
    ByteOffsetCacheIneligible {
      boundary_tag: boundary_tag,
      witness: witness
    } =>
      v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: ^test_claim_cache_byte_offset_cache_ineligible_tag),
        b: v2.std.node.combine_hash(
          a: test_claim_symbol_digest(sym: boundary_tag),
          b: witness
        )
      )
  }
}

fn extent_cache_digest(e: v2.std.diagnostic.Extent) -> v2.std.node.Hash {
  match e {
    WholeFile =>
      test_claim_symbol_digest(sym: ^test_claim_cache_extent_whole_file_tag)
    ByteRange { start: sa, end: ea } =>
      v2.std.node.combine_hash(
        a: v2.std.node.combine_hash(
          a: test_claim_symbol_digest(sym: ^test_claim_cache_extent_byte_range_tag),
          b: byte_offset_cache_key_extent_component(key: v2.std.node.byte_offset_cache_key(i: sa))
        ),
        b: byte_offset_cache_key_extent_component(key: v2.std.node.byte_offset_cache_key(i: ea))
      )
  }
}

fn locus_cache_digest(at: v2.std.diagnostic.Locus) -> v2.std.node.Hash {
  match at {
    NodeLocus { anchor: a } =>
      v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: ^test_claim_cache_locus_node_tag),
        b: v2.std.node.content_hash(n: a.at)
      )
    PortLocus { anchor: a } =>
      v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: ^test_claim_cache_locus_port_tag),
        b: test_claim_symbol_digest(sym: a.at)
      )
    Textual { file: f, extent: e } =>
      v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: ^test_claim_cache_locus_textual_tag),
        b: v2.std.node.combine_hash(
          a: test_claim_symbol_digest(sym: f),
          b: extent_cache_digest(e: e)
        )
      )
  }
}

fn diagnostic_cache_digest(d: v2.std.diagnostic.Diagnostic) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: locus_cache_digest(at: d.at),
    b: v2.std.node.combine_hash(
      a: test_claim_symbol_digest(sym: d.reason),
      b: correction_verdict_digest(c: d.correction)
    )
  )
}

fn diagnostic_tail_bag_cache_digest(xs: List<v2.std.diagnostic.Diagnostic>) -> v2.std.node.Hash {
  v2.std.node.bag_hash_digest(
    empty: test_claim_symbol_digest(sym: ^test_claim_cache_diagnostic_tail_bag_empty_tag),
    xs: map(xs, diag => diagnostic_cache_digest(d: diag))
  )
}

fn non_empty_diagnostics_cache_digest(d: v2.std.diagnostic.NonEmptyDiagnostics) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: diagnostic_cache_digest(d: d.head),
    b: diagnostic_tail_bag_cache_digest(xs: d.tail)
  )
}

fn test_claim_variant_cache_digest(c: v2.std.verification.TestClaim) -> v2.std.node.Hash {
  match v2.std.verification.test_claim_coproduct_variant(c: c) {
    TestClaimCompilesClaimVariant =>
      test_claim_symbol_digest(sym: ^test_claim_cache_variant_compiles_tag)
    TestClaimDiagnosticClaimVariant =>
      test_claim_symbol_digest(sym: ^test_claim_cache_variant_diagnostic_tag)
    TestClaimEqualsClaimVariant =>
      test_claim_symbol_digest(sym: ^test_claim_cache_variant_equals_tag)
    TestClaimStructuralEqualsClaimVariant =>
      test_claim_symbol_digest(sym: ^test_claim_cache_variant_structural_equals_tag)
    TestClaimRoundTripClaimVariant =>
      test_claim_symbol_digest(sym: ^test_claim_cache_variant_roundtrip_tag)
  }
}

fn test_claim_claim_body_cache_digest(c: v2.std.verification.TestClaim) -> v2.std.node.Hash {
  let nodes_digest = test_claim_evaluation_nodes_digest(c: c)
  match c {
    CompilesClaim { label: _, anchor: _, input: _, expected_value: _, classification: _ } =>
      nodes_digest
    DiagnosticClaim { expected_rejection: e, label: _, anchor: _, classification: _, input: _ } =>
      v2.std.node.combine_hash(a: nodes_digest, b: non_empty_diagnostics_cache_digest(d: e))
    EqualsClaim { label: _, anchor: _, lhs: _, rhs: _, classification: _ } =>
      nodes_digest
    StructuralEqualsClaim { label: _, anchor: _, lhs: _, rhs: _, classification: _ } =>
      nodes_digest
    RoundTripClaim { label: _, anchor: _, input: _, classification: _ } =>
      nodes_digest
  }
}

fn test_claim_claim_hash_digest(c: v2.std.verification.TestClaim) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: test_claim_variant_cache_digest(c: c),
    b: test_claim_claim_body_cache_digest(c: c)
  )
}

fn test_claim_symbol_digest(sym: v2.std.node.Symbol) -> v2.std.node.Hash {
  v2.std.node.content_hash(n: test_claim_cache_digest_tag_node(tag: sym))
}

fn structural_property_witness_digest(w: v2.std.witness.StructuralPropertyWitness) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: test_claim_symbol_digest(sym: w.property),
    b: v2.std.node.content_hash(n: w.evidence)
  )
}

fn ranking_dimension_digest(d: v2.std.cardinality.RankingDimension) -> v2.std.node.Hash {
  test_claim_symbol_digest(sym: d.measured)
}

fn termination_proof_digest(proof: v2.std.cardinality.TerminationProof) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: ranking_dimension_digest(d: proof.strict),
    b: v2.std.algebra.fold_list(
      xs: proof.non_increasing,
      empty: test_claim_symbol_digest(sym: ^test_claim_cache_termination_non_increasing_empty_tag),
      cons: fn(acc, d) {
        v2.std.node.combine_hash(a: acc, b: ranking_dimension_digest(d: d))
      }
    )
  )
}

fn witness_cache_holds_digest(payload: v2.std.node.Hash) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: test_claim_symbol_digest(sym: ^test_claim_cache_witness_holds_tag),
    b: payload
  )
}

fn witness_cache_violates_digest(diag: v2.std.diagnostic.Diagnostic) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: test_claim_symbol_digest(sym: ^test_claim_cache_witness_violates_tag),
    b: diagnostic_cache_digest(d: diag)
  )
}

fn descent_witness_digest(d: v2.std.witness.Witness<v2.std.cardinality.TerminationProof>) -> v2.std.node.Hash {
  match d {
    Holds { value: proof } =>
      witness_cache_holds_digest(payload: termination_proof_digest(proof: proof))
    Violates { diagnostic: diag } => witness_cache_violates_digest(diag: diag)
  }
}

fn eval_grounding_not_derived_digest_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^eval_grounding_not_derived_digest_tag } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn inferred_facts_digest(facts: v2.compiler.inferred_tree.InferredFacts) -> v2.std.node.Hash {
  match facts.grounding {
    DerivedGrounding { grounding: g } =>
      v2.std.node.combine_hash(
        a: v2.std.node.content_hash(n: g.node),
        b: v2.std.node.combine_hash(
          a: v2.std.node.combine_hash(
            a: structural_property_witness_digest(w: g.witness.structural),
            b: structural_property_witness_digest(w: g.witness.closedness)
          ),
          b: descent_witness_digest(d: v2.compiler.infer.inferred_facts_descent(facts: facts))
        )
      )
    GroundingNotDerived { node: n } =>
      v2.std.node.combine_hash(
        a: v2.std.node.combine_hash(
          a: v2.std.node.content_hash(n: eval_grounding_not_derived_digest_node()),
          b: v2.std.node.content_hash(n: n)
        ),
        b: descent_witness_digest(d: v2.compiler.infer.inferred_facts_descent(facts: facts))
      )
  }
}

fn inferred_node_facts_cache_digest(tree: v2.compiler.inferred_tree.InferredTree, node: v2.std.node.Node) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: v2.std.node.content_hash(n: node),
    b: match inferred_facts_witness_for_eval(tree: tree, node: node) {
      Holds { value: facts } =>
        witness_cache_holds_digest(payload: inferred_facts_digest(facts: facts))
      Violates { diagnostic: diag } => witness_cache_violates_digest(diag: diag)
    }
  )
}

fn inferred_tree_evaluated_facts_digest(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.node.Hash {
  v2.std.node.fold_node(
    n: tree.root,
    algebra: v2.std.node.NodeFold {
      init: fn(n0) {
        inferred_node_facts_cache_digest(tree: tree, node: n0)
      },
      step: fn(acc, e, child) {
        v2.std.node.combine_hash(a: acc, b: child)
      }
    }
  )
}

fn inferred_tree_digest(tree: v2.compiler.inferred_tree.InferredTree) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: v2.std.node.content_hash(n: tree.root),
    b: inferred_tree_evaluated_facts_digest(tree: tree)
  )
}

type InterpretationCacheDigestAuthority
  = InterpretationCacheRegistered {
      runtime_identity: v2.std.node.Symbol,
      semantics_witness: v2.std.node.Hash
    }
  | InterpretationCacheIneligible {
      runtime_identity: v2.std.node.Symbol,
      registry_witness: v2.std.node.Hash,
      structure_digest: v2.std.node.Hash
    }

fn test_claim_interpretation_cache_digest_authority(context: EvalContext) -> InterpretationCacheDigestAuthority {
  let authority = context.cache_authority
  let registry_witness = interpretation_registry_semantics_digest(
    runtime_identity: authority.runtime_identity,
    interpretation: authority.interpretation,
    structure_witness: authority.structure_witness
  )
  let registered_semantics = interpretation_v4_evaluator_registry_semantics_digest(
    interpretation: v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation()
  )
  let registry_mismatch = test_claim_symbol_digest(sym: ^test_claim_cache_interpretation_semantics_mismatch_tag)
  if authority.runtime_identity == ^v2_evaluator_runtime_id
    && authority.interpretation == v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation()
    && authority.semantics_digest == registered_semantics
    && registry_witness == registered_semantics
    && registry_witness != registry_mismatch {
    InterpretationCacheRegistered {
      runtime_identity: authority.runtime_identity,
      semantics_witness: registry_witness
    }
  } else {
    InterpretationCacheIneligible {
      runtime_identity: authority.runtime_identity,
      registry_witness: registry_witness,
      structure_digest: interpretation_algebra_executed_structure_digest(
        runtime_identity: authority.runtime_identity,
        interpretation: authority.interpretation,
        structure_witness: authority.structure_witness
      )
    }
  }
}

fn interpretation_cache_digest_authority_hash(auth: InterpretationCacheDigestAuthority) -> v2.std.node.Hash {
  match auth {
    InterpretationCacheRegistered {
      runtime_identity: runtime_identity,
      semantics_witness: semantics_witness
    } =>
      v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: ^test_claim_cache_interpretation_registered_tag),
        b: v2.std.node.combine_hash(
          a: test_claim_symbol_digest(sym: runtime_identity),
          b: semantics_witness
        )
      )
    InterpretationCacheIneligible {
      runtime_identity: runtime_identity,
      registry_witness: registry_witness,
      structure_digest: structure_digest
    } =>
      v2.std.node.combine_hash(
        a: test_claim_symbol_digest(sym: ^test_claim_cache_interpretation_cache_ineligible_tag),
        b: v2.std.node.combine_hash(
          a: v2.std.node.combine_hash(
            a: test_claim_symbol_digest(sym: runtime_identity),
            b: registry_witness
          ),
          b: structure_digest
        )
      )
  }
}

fn test_claim_interpretation_cache_digest(context: EvalContext) -> v2.std.node.Hash {
  interpretation_cache_digest_authority_hash(
    auth: test_claim_interpretation_cache_digest_authority(context: context)
  )
}

fn test_claim_evaluator_input_digest_node(input: TestClaimTypedInput<v2.std.node.Node>) -> v2.std.node.Hash {
  v2.std.node.content_hash(n: input.evaluator_input)
}

fn test_claim_evaluator_digest_node(input: TestClaimTypedInput<v2.std.node.Node>) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: test_claim_symbol_digest(sym: input.evaluator_pin),
    b: test_claim_evaluator_input_digest_node(input: input)
  )
}

fn test_claim_cache_interpretation_hash_node(subject: TestClaimEvalSubject<v2.std.node.Node>) -> v2.std.node.Hash {
  v2.std.node.combine_hash(
    a: inferred_tree_digest(tree: subject.tree),
    b: v2.std.node.combine_hash(
      a: test_claim_interpretation_cache_digest(context: subject.context),
      b: test_claim_evaluator_digest_node(input: subject.input)
    )
  )
}

fn test_claim_cache_receipt_node(subject: TestClaimEvalSubject<v2.std.node.Node>) -> TestClaimCacheReceipt<v2.std.node.Node> {
  TestClaimCacheReceipt {
    key: TestClaimCacheKey {
      eval_subject: subject
    }
  }
}

fn test_claim_cache_receipt(subject: TestClaimEvalSubject<v2.std.node.Node>) -> TestClaimCacheReceipt<v2.std.node.Node> {
  test_claim_cache_receipt_node(subject: subject)
}

fn eval_diagnostic(reason: v2.std.node.Symbol, node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
  }
}

fn runtime_binding_lookup_miss(key: v2.std.runtime.EnvironmentBindingKey) -> v2.std.optional.Optional<v2.std.runtime.RuntimeValue> {
  v2.std.optional.optional_absent()
}

fn empty_runtime_bindings() -> std.algebra.PartialFunction<v2.std.runtime.EnvironmentBindingKey, v2.std.runtime.RuntimeValue> {
  std.algebra.PartialFunction {
    lookup: runtime_binding_lookup_miss
  }
}

fn empty_evaluation_environment() -> v2.std.runtime.EvaluationEnvironment {
  v2.std.runtime.EvaluationEnvironment {
    bindings: empty_runtime_bindings()
  }
}

fn eval_runtime() -> v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime {
  v2.extdeps.runtimes.v2_evaluator.v2_evaluator_runtime()
}

fn eval_default_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.extdeps.runtimes.v2_evaluator.v2_evaluator_interpretation()
}

fn inferred_facts_witness_for_eval(tree: v2.compiler.inferred_tree.InferredTree, node: v2.std.node.Node) -> v2.std.witness.Witness<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.witness.witness_from_optional(opt: tree.facts.lookup(node), absent: v2.compiler.infer.infer_facts_lookup_miss_diagnostic(key: node))
}

fn inferred_facts_for_eval(tree: v2.compiler.inferred_tree.InferredTree, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  match inferred_facts_witness_for_eval(tree: tree, node: node) {
    Holds { value: facts } =>
      if !v2.compiler.infer.inferred_facts_grounding_derived(facts: facts) {
        v2.std.diagnostic.Rejected {
          diagnostics: v2.std.diagnostic.diagnostics_singleton(
            d: eval_diagnostic(reason: ^eval_rejected_grounding_not_derived, node: node)
          )
        }
      } else if !v2.compiler.infer.inferred_facts_cover_node(facts: facts, node: node) {
        v2.std.diagnostic.Rejected {
          diagnostics: v2.std.diagnostic.diagnostics_singleton(
            d: eval_diagnostic(reason: ^eval_rejected_grounding_node_mismatch, node: node)
          )
        }
      } else if !v2.compiler.infer.inferred_facts_canonical_admitted(facts: facts) {
        v2.std.diagnostic.Rejected {
          diagnostics: v2.std.diagnostic.diagnostics_singleton(
            d: eval_diagnostic(reason: ^eval_rejected_canonical_mismatch, node: node)
          )
        }
      } else {
        match v2.compiler.infer.inferred_facts_descent(facts: facts) {
          Holds { value: _ } =>
            v2.std.diagnostic.Accepted { value: facts, diagnostics: v2.std.diagnostic.None }
          Violates { diagnostic: d } =>
            v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: d) }
        }
      }
    Violates { diagnostic: d } =>
      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: d) }
  }
}

fn eval_structural_node_for_eval(tree: v2.compiler.inferred_tree.InferredTree, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: inferred_facts_for_eval(tree: tree, node: node),
    f: fn(_facts) {
      v2.std.diagnostic.Accepted { value: node, diagnostics: v2.std.diagnostic.None }
    }
  )
}

fn eval_short_circuit_policy() -> v2.std.diagnostic.StageDiagnosticPolicy {
  v2.std.diagnostic.StageDiagnosticPolicy { accumulation: ShortCircuit }
}

fn eval_absorb_structural_child(
  acc: v2.std.diagnostic.Outcome<v2.std.node.Node>,
  child: v2.std.diagnostic.Outcome<v2.std.node.Node>
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.absorb_outcome_diagnostics(
    acc: acc,
    child: child,
    policy: eval_short_circuit_policy()
  )
}

fn control_transfer_value(
  control: v2.std.runtime.ControlTransfer,
  node: v2.std.node.Node,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  environment: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  runtime.execution.control.terminal_value(
    control,
    v2.std.runtime.EvaluationFrame { current: node, environment: environment }
  )
}

type RuntimeValueAcceptanceWitness {
  resolved_type: v2.std.witness.Witness<v2.std.node.Node>
  inhabitance: v2.std.witness.Witness<v2.compiler.inferred_tree.InferredFacts>
  canonical: v2.std.witness.Witness<v2.compiler.inferred_tree.InferredFacts>
}

fn eval_runtime_value_acceptance_witness(
  node: v2.std.node.Node,
  facts: v2.compiler.inferred_tree.InferredFacts,
  value: v2.std.runtime.RuntimeValue
) -> RuntimeValueAcceptanceWitness {
  RuntimeValueAcceptanceWitness {
    resolved_type: match v2.compiler.infer.inferred_facts_resolved_type(facts: facts) {
      Violates { diagnostic: _ } =>
        v2.std.witness.Violates {
          diagnostic: eval_diagnostic(reason: ^eval_rejected_grounding_not_derived, node: node)
        }
      Holds { value: declared } =>
        if declared == v2.std.runtime.runtime_value_resolved_type(value: value) {
          v2.std.witness.Holds { value: v2.std.runtime.runtime_value_resolved_type(value: value) }
        } else {
          v2.std.witness.Violates {
            diagnostic: eval_diagnostic(reason: ^eval_rejected_resolved_type_mismatch, node: node)
          }
        }
    },
    inhabitance: if v2.compiler.infer.inferred_facts_canonical_admitted(facts: facts) {
      v2.std.witness.Holds { value: facts }
    } else {
      v2.std.witness.Violates {
        diagnostic: eval_diagnostic(reason: ^eval_rejected_inhabitance_mismatch, node: node)
      }
    },
    canonical: if v2.compiler.infer.inferred_facts_canonical_admitted(facts: facts) {
      v2.std.witness.Holds { value: facts }
    } else {
      v2.std.witness.Violates {
        diagnostic: eval_diagnostic(reason: ^eval_rejected_canonical_mismatch, node: node)
      }
    }
  }
}

fn eval_accept_runtime_value_with_facts(
  node: v2.std.node.Node,
  facts: v2.compiler.inferred_tree.InferredFacts,
  value: v2.std.runtime.RuntimeValue
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  let witness = eval_runtime_value_acceptance_witness(node: node, facts: facts, value: value)
  match witness.resolved_type {
    Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d: d)
    Holds { value: _ } => match witness.inhabitance {
      Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d: d)
      Holds { value: _ } => match witness.canonical {
        Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d: d)
        Holds { value: _ } => v2.std.diagnostic.Accepted { value: value, diagnostics: v2.std.diagnostic.None }
      }
    }
  }
}

fn eval_witness_outcome<T>(witness: v2.std.witness.Witness<T>) -> v2.std.diagnostic.Outcome<T> {
  match witness {
    Holds { value: v } => v2.std.diagnostic.Accepted { value: v, diagnostics: v2.std.diagnostic.None }
    Violates { diagnostic: d } => v2.std.diagnostic.outcome_rejected(d: d)
  }
}

fn eval_first_runtime_argument(args: List<v2.std.runtime.RuntimeValue>, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  eval_witness_outcome(
    witness: v2.std.collection.list_nth(
      xs: args,
      wanted: 0,
      absent: eval_diagnostic(reason: ^eval_rejected_branch_argument_absent, node: node)
    )
  )
}

fn eval_bind_value_argument(args: List<v2.std.runtime.RuntimeValue>, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  eval_witness_outcome(
    witness: v2.std.collection.list_nth(
      xs: args,
      wanted: 1,
      absent: eval_diagnostic(reason: ^eval_rejected_bind_value_absent, node: node)
    )
  )
}

fn eval_nth_child(node: v2.std.node.Node, wanted: Int, absent_reason: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Edge> {
  eval_witness_outcome(
    witness: v2.std.collection.list_nth(
      xs: node.children,
      wanted: wanted,
      absent: eval_diagnostic(reason: absent_reason, node: node)
    )
  )
}

fn eval_branch_condition_edge(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Edge> {
  eval_nth_child(
    node: node,
    wanted: 0,
    absent_reason: ^eval_rejected_branch_argument_absent
  )
}

fn eval_bind_key(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.runtime.EnvironmentBindingKey> {
  v2.std.diagnostic.bind_outcome(
    o: eval_nth_child(
      node: node,
      wanted: 0,
      absent_reason: ^eval_rejected_bind_key_absent
    ),
    f: fn(e) {
      eval_environment_binding_key_from_node(declaration: e.target)
    }
  )
}

fn eval_bind_value_edge(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Edge> {
  eval_nth_child(
    node: node,
    wanted: 1,
    absent_reason: ^eval_rejected_bind_value_absent
  )
}

fn eval_bind_body(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: eval_nth_child(
      node: node,
      wanted: 2,
      absent_reason: ^eval_rejected_bind_body_absent
    ),
    f: fn(e) {
      v2.std.diagnostic.Accepted { value: e.target, diagnostics: v2.std.diagnostic.None }
    }
  )
}

fn eval_binding_key_node(sym: v2.std.node.Symbol) -> v2.std.node.Node {
  symbol_atom_node(sym: sym)
}

fn eval_binding_key_from_atom(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.runtime.EnvironmentBindingKey> {
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      v2.std.optional.optional_present(value: v2.std.runtime.environment_binding_key_for_symbol(sym: sym))
    _ => v2.std.optional.optional_absent()
  }
}

fn eval_environment_binding_key_from_node(declaration: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.runtime.EnvironmentBindingKey> {
  match eval_binding_key_from_atom(node: declaration) {
    Present { value: key } =>
      v2.std.diagnostic.Accepted { value: key, diagnostics: v2.std.diagnostic.None }
    Absent =>
      v2.std.diagnostic.outcome_rejected(
        d: eval_diagnostic(reason: ^eval_rejected_bind_key_absent, node: declaration)
      )
  }
}

fn eval_runtime_binding_lookup(node: v2.std.node.Node, environment: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.bind_outcome(
    o: eval_environment_binding_key_from_node(declaration: node),
    f: fn(key) {
      eval_witness_outcome(
        witness: v2.std.witness.witness_from_optional(
          opt: environment.bindings.lookup(key),
          absent: eval_diagnostic(
            reason: ^eval_rejected_runtime_binding_lookup_miss,
            node: symbol_atom_node(sym: key.identity)
          )
        )
      )
    }
  )
}

fn eval_type_node_atom(
  node: v2.std.node.Node,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match node.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      if v2.extdeps.runtimes.v2_evaluator.v2_eval_is_literal_shaped_node(node: node) {
        interpretation.value.allocate_literal(node, environment)
      } else {
        match eval_runtime_binding_lookup(node: node, environment: environment) {
          Accepted { value: v, diagnostics: d } =>
            v2.std.diagnostic.Accepted { value: v, diagnostics: d }
          Rejected { diagnostics: bind_ds } =>
            match interpretation.value.allocate_literal(node, environment) {
              Accepted { value: v, diagnostics: d } =>
                v2.std.diagnostic.Accepted { value: v, diagnostics: d }
              Rejected { diagnostics: _ } =>
                v2.std.diagnostic.Rejected { diagnostics: bind_ds }
            }
        }
      }
    TypeNode { connective: _ } =>
      interpretation.value.allocate_literal(node, environment)
    ComputationNode { behavior: _ } =>
      v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
  }
}

type EvalParamBindAcc {
  idx: Int
  acc: v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment>
}

fn eval_bind_param_edge_step(
  state: EvalParamBindAcc,
  param_edge: v2.std.node.Edge,
  args: List<v2.std.runtime.RuntimeValue>,
  bind: v2.std.runtime.BindInterpreter,
  node: v2.std.node.Node
) -> EvalParamBindAcc {
  match state.acc {
    Rejected { diagnostics: r } =>
      EvalParamBindAcc { idx: state.idx + 1, acc: v2.std.diagnostic.Rejected { diagnostics: r } }
    Accepted { value: env, diagnostics: _ } =>
      match param_edge.label {
        Named { name: binding_id } =>
          EvalParamBindAcc {
            idx: state.idx + 1,
            acc: v2.std.diagnostic.bind_outcome(
              o: eval_witness_outcome(
                witness: v2.std.collection.list_nth(
                  xs: args,
                  wanted: state.idx,
                  absent: eval_diagnostic(reason: ^eval_rejected_argument_bind_absent, node: node)
                )
              ),
              f: fn(value) {
                bind.bind_value(
                  v2.std.runtime.environment_binding_key_for_symbol(sym: binding_id),
                  value,
                  env
                )
              }
            )
          }
        Positional =>
          EvalParamBindAcc { idx: state.idx, acc: v2.std.diagnostic.Accepted { value: env, diagnostics: v2.std.diagnostic.None } }
      }
  }
}

fn eval_bind_arrow_params(
  arrow: v2.std.node.Node,
  args: List<v2.std.runtime.RuntimeValue>,
  environment: v2.std.runtime.EvaluationEnvironment,
  bind: v2.std.runtime.BindInterpreter,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.bind_outcome(
    o: eval_nth_child(node: arrow, wanted: 0, absent_reason: ^eval_rejected_callee_absent),
    f: fn(domain_edge) {
      match v2.std.algebra.fold_list(
        xs: domain_edge.target.children,
        empty: EvalParamBindAcc { idx: 0, acc: v2.std.diagnostic.Accepted { value: environment, diagnostics: v2.std.diagnostic.None } },
        cons: fn(state, param_edge) {
          eval_bind_param_edge_step(
            state: state,
            param_edge: param_edge,
            args: args,
            bind: bind,
            node: node
          )
        }
      ) {
        EvalParamBindAcc { idx: param_count, acc: bound } =>
          if eval_actual_present(args: args, wanted: param_count, node: node) {
            v2.std.diagnostic.outcome_rejected(
              d: eval_diagnostic(reason: ^eval_rejected_argument_arity_excess, node: node)
            )
          } else {
            bound
          }
      }
    }
  )
}

fn eval_actual_present(args: List<v2.std.runtime.RuntimeValue>, wanted: Int, node: v2.std.node.Node) -> Bool {
  match v2.std.collection.list_nth(
    xs: args,
    wanted: wanted,
    absent: eval_diagnostic(reason: ^eval_rejected_argument_bind_absent, node: node)
  ) {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

fn eval_transform_callee_edge(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Edge> {
  eval_nth_child(
    node: node,
    wanted: 0,
    absent_reason: ^eval_rejected_callee_absent
  )
}

fn eval_node_is_arrow(node: v2.std.node.Node) -> Bool {
  match node.kind {
    TypeNode { connective: Arrow } => true
    _ => false
  }
}

fn eval_node_is_callee_reference(node: v2.std.node.Node) -> Bool {
  match node.kind {
    TypeNode { connective: Arrow } => true
    TypeNode { connective: Atom { identity: _ } } => true
    _ => false
  }
}

fn eval_child_absent(node: v2.std.node.Node, wanted: Int) -> Bool {
  match eval_nth_child(
    node: node,
    wanted: wanted,
    absent_reason: ^eval_rejected_unsupported_callee
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn eval_arrow_admits_callee_dispatch(arrow: v2.std.node.Node) -> Bool {

  match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: arrow), index: 3) {
    Present { value: _ } => false
    Absent => true
  }
}

fn eval_transform_has_callee_reference(node: v2.std.node.Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: v2.std.node.Transform } =>
      match eval_nth_child(
        node: node,
        wanted: 0,
        absent_reason: ^eval_rejected_callee_absent
      ) {
        Accepted { value: e0, diagnostics: _ } =>
          match e0.label {
            Positional => eval_node_is_callee_reference(node: e0.target)
            Named { name: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    _ => false
  }
}

fn eval_node_is_branch(node: v2.std.node.Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Branch } => true
    _ => false
  }
}

fn eval_node_is_loop(node: v2.std.node.Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Loop } => true
    _ => false
  }
}

fn effect_io_roundtrip_transform(locator: v2.std.node.Node, payload: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: v2.std.node.Transform },
    children: [
      v2.std.node.Edge { label: Positional, target: locator },
      v2.std.node.Edge { label: Positional, target: payload }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn eval_node_is_effect_io_roundtrip(node: v2.std.node.Node, effect_io: EffectIoEvalContext) -> Bool {
  match effect_io {
    EffectIoEvalAbsent => false
    EffectIoEvalPresent { bundle: _ } =>
      match node.kind {
        ComputationNode { behavior: v2.std.node.Transform } =>
          !eval_transform_has_callee_reference(node: node) && count(node.children) == 2
        _ => false
      }
  }
}

fn eval_invoke_effect_handler(
  bundle: EffectIoEvalBundle,
  request: v2.std.runtime.EffectRequest
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  let handler = v2.std.runtime.effect_handler_for_kind(binding: bundle.handlers, kind: request.kind)
  v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_invoke_handler(handler: handler, request: request)
}

fn eval_bundle_with_receipt_appended(
  bundle: EffectIoEvalBundle,
  request: v2.std.runtime.EffectRequest,
  result: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
) -> EffectIoEvalBundle {
  EffectIoEvalBundle {
    backend: bundle.backend,
    store: bundle.store,
    handlers: bundle.handlers,
    receipt_log: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_append_receipt(
      log: bundle.receipt_log,
      request: request,
      result: result
    )
  }
}

fn eval_yield_effect_request(
  bundle: EffectIoEvalBundle,
  request: v2.std.runtime.EffectRequest
) -> v2.std.diagnostic.Outcome<EffectIoYieldOutcome> {
  let result = eval_invoke_effect_handler(bundle: bundle, request: request)
  let logged_bundle = eval_bundle_with_receipt_appended(
    bundle: bundle,
    request: request,
    result: result
  )
  match result {
    v2.std.diagnostic.Accepted { value: v, diagnostics: ds } =>
      v2.std.diagnostic.Accepted {
        value: EffectIoYieldOutcome { bundle: logged_bundle, value: v },
        diagnostics: ds
      }
    Rejected { diagnostics: ds } => v2.std.diagnostic.Rejected { diagnostics: ds }
  }
}

fn eval_effect_io_roundtrip_args_present(args: List<v2.std.runtime.RuntimeValue>) -> Bool {
  eval_actual_present(args: args, wanted: 0, node: symbol_atom_node(sym: ^effect_io_roundtrip_marker))
    && eval_actual_present(args: args, wanted: 1, node: symbol_atom_node(sym: ^effect_io_roundtrip_marker))
}

fn eval_effect_io_roundtrip(
  bundle: EffectIoEvalBundle,
  args: List<v2.std.runtime.RuntimeValue>,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if eval_effect_io_roundtrip_args_present(args: args) {
    v2.std.diagnostic.bind_outcome(
      o: eval_first_runtime_argument(args: args, node: node),
      f: fn(locator_arg) {
        v2.std.diagnostic.bind_outcome(
          o: eval_bind_value_argument(args: args, node: node),
          f: fn(payload) {
            let write_args = std.algebra.Cons {
              head: locator_arg,
              tail: std.algebra.Cons { head: payload, tail: std.algebra.Empty }
            }
            let write_request = v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_write_request(args: write_args)
            v2.std.diagnostic.bind_outcome(
              o: eval_yield_effect_request(bundle: bundle, request: write_request),
              f: fn(write_yield) {
                let written = write_yield.value
                if written == payload {
                  match v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_locator_from_args(
                    backend: bundle.backend,
                    args: write_args
                  ) {
                    Holds { value: locator } =>
                      let store1 = v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_apply_write(
                        store: bundle.store,
                        locator: locator,
                        payload: written
                      )
                      let rebound = v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_handler_binding(store: store1)
                      let read_bundle = EffectIoEvalBundle {
                        backend: bundle.backend,
                        store: store1,
                        handlers: rebound.handlers,
                        receipt_log: write_yield.bundle.receipt_log
                      }
                      let read_args = std.algebra.Cons { head: locator_arg, tail: std.algebra.Empty }
                      let read_request = v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_read_request(args: read_args)
                      v2.std.diagnostic.bind_outcome(
                        o: eval_yield_effect_request(bundle: read_bundle, request: read_request),
                        f: fn(read_yield) {
                          v2.std.diagnostic.Accepted { value: read_yield.value, diagnostics: v2.std.diagnostic.None }
                        }
                      )
                    Violates { diagnostic: d } =>
                      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: d) }
                  }
                } else {
                  v2.std.diagnostic.outcome_rejected(
                    d: eval_diagnostic(reason: ^eval_rejected_effect_io_write_payload_mismatch, node: node)
                  )
                }
              }
            )
          }
        )
      }
    )
  } else {
    v2.std.diagnostic.outcome_rejected(
      d: eval_diagnostic(reason: ^eval_rejected_effect_io_roundtrip_arity, node: node)
    )
  }
}

fn eval_value_node(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _facts: v2.compiler.inferred_tree.InferredFacts,
  _tree: v2.compiler.inferred_tree.InferredTree,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  _runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match interpreter {
    ValueRuntimeInterpreter { interpreter: value } =>
      value.allocate_literal(node, environment)
    _ => v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
  }
}

fn eval_transform_node(
  node: v2.std.node.Node,
  args: List<v2.std.runtime.RuntimeValue>,
  _facts: v2.compiler.inferred_tree.InferredFacts,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match interpreter {
    TransformRuntimeInterpreter { interpreter: transform } =>
      if eval_node_is_effect_io_roundtrip(node: node, effect_io: effect_io) {
        match effect_io {
          EffectIoEvalPresent { bundle: b } =>
            eval_effect_io_roundtrip(bundle: b, args: args, node: node)

          EffectIoEvalAbsent =>
            v2.std.diagnostic.outcome_rejected(
              d: eval_diagnostic(reason: ^eval_rejected_effect_io_unbound, node: node)
            )
        }
      } else if eval_transform_has_callee_reference(node: node) {
        v2.std.diagnostic.bind_outcome(
          o: eval_transform_callee_edge(node: node),
          f: fn(callee_edge) {
            match v2.std.node_query.find_arrow_body_child(root: callee_edge.target) {
              Accepted { value: body, diagnostics: _ } =>
                let body_form = v2.std.node.classify_arrow_body_form(target: body)
                if eval_arrow_admits_callee_dispatch(arrow: callee_edge.target)
                  && v2.std.node.arrow_body_admits_eval_entry(form: body_form) {
                  v2.std.diagnostic.bind_outcome(
                    o: eval_bind_arrow_params(
                      arrow: callee_edge.target,
                      args: args,
                      environment: environment,
                      bind: interpretation.bind,
                      node: node
                    ),
                    f: fn(call_environment) {
                      match body_form {
                        DirectAtomBody =>
                          eval_type_node_atom(
                            node: body,
                            interpretation: interpretation,
                            environment: call_environment
                          )
                        _ =>
                          eval_runtime_node(
                            node: body,
                            tree: tree,
                            interpretation: interpretation,
                            environment: call_environment,
                            runtime: runtime,
                            effect_io: effect_io
                          )
                      }
                    }
                  )
                } else {
                  v2.std.diagnostic.outcome_rejected(
                    d: eval_diagnostic(reason: ^eval_rejected_unsupported_callee, node: callee_edge.target)
                  )
                }
              Rejected { diagnostics: _ } =>
                if eval_node_is_arrow(node: callee_edge.target) {
                  v2.std.diagnostic.outcome_rejected(
                    d: eval_diagnostic(reason: ^eval_rejected_unsupported_callee, node: callee_edge.target)
                  )
                } else {
                  transform.call_primitive(node, args, environment)
                }
            }
          }
        )
      } else {
        transform.call_primitive(node, args, environment)
      }
    _ => v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
  }
}

fn eval_branch_node_eval(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match interpreter {
    BranchRuntimeInterpreter { interpreter: branch } =>
      v2.std.diagnostic.bind_outcome(
        o: eval_branch_condition_edge(node: node),
        f: fn(cond_edge) {
          v2.std.diagnostic.bind_outcome(
            o: eval_runtime_node(
              node: cond_edge.target,
              tree: tree,
              interpretation: interpretation,
              environment: environment,
              runtime: runtime,
              effect_io: effect_io
            ),
            f: fn(condition) {
              v2.std.diagnostic.bind_outcome(
                o: branch.choose_branch(node, condition, environment),
                f: fn(chosen) {
                  eval_runtime_node(
                    node: chosen,
                    tree: tree,
                    interpretation: interpretation,
                    environment: environment,
                    runtime: runtime,
                    effect_io: effect_io
                  )
                }
              )
            }
          )
        }
      )
    _ => v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
  }
}

fn eval_branch_node(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _facts: v2.compiler.inferred_tree.InferredFacts,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  eval_branch_node_eval(
    node: node,
    tree: tree,
    interpretation: interpretation,
    interpreter: interpreter,
    environment: environment,
    runtime: runtime,
    effect_io: effect_io
  )
}

fn eval_loop_node(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _facts: v2.compiler.inferred_tree.InferredFacts,
  _tree: v2.compiler.inferred_tree.InferredTree,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match interpreter {
    LoopRuntimeInterpreter { interpreter: loop_interpreter } =>
      v2.std.diagnostic.bind_outcome(
        o: loop_interpreter.step_loop(node, environment),
        f: fn(control) {
          control_transfer_value(
            control: control,
            node: node,
            runtime: runtime,
            environment: environment
          )
        }
      )
    _ => v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
  }
}

fn eval_bind_node_eval(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match interpreter {
    ValueRuntimeInterpreter { interpreter: _ } =>
      v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
    TransformRuntimeInterpreter { interpreter: _ } =>
      v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
    BranchRuntimeInterpreter { interpreter: _ } =>
      v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
    LoopRuntimeInterpreter { interpreter: _ } =>
      v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
    MatchRuntimeInterpreter { interpreter: _ } =>
      v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
    BindRuntimeInterpreter { interpreter: bind } =>
      v2.std.diagnostic.bind_outcome(
        o: eval_bind_key(node: node),
        f: fn(key) {
          v2.std.diagnostic.bind_outcome(
            o: eval_bind_value_edge(node: node),
            f: fn(value_edge) {
              v2.std.diagnostic.bind_outcome(
                o: eval_runtime_node(
                  node: value_edge.target,
                  tree: tree,
                  interpretation: interpretation,
                  environment: environment,
                  runtime: runtime,
                  effect_io: effect_io
                ),
                f: fn(bound_value) {
                  v2.std.diagnostic.bind_outcome(
                    o: bind.bind_value(key, bound_value, environment),
                    f: fn(bound_environment) {
                      v2.std.diagnostic.bind_outcome(
                        o: eval_bind_body(node: node),
                        f: fn(body) {
                          eval_runtime_node(
                            node: body,
                            tree: tree,
                            interpretation: interpretation,
                            environment: bound_environment,
                            runtime: runtime,
                            effect_io: effect_io
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
  }
}

fn eval_bind_node(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _facts: v2.compiler.inferred_tree.InferredFacts,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  eval_bind_node_eval(
    node: node,
    tree: tree,
    interpretation: interpretation,
    interpreter: interpreter,
    environment: environment,
    runtime: runtime,
    effect_io: effect_io
  )
}

fn eval_match_scrutinee_edge(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Edge> {
  eval_nth_child(
    node: node,
    wanted: 0,
    absent_reason: ^eval_rejected_branch_argument_absent
  )
}

fn eval_match_node_eval(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match interpreter {
    MatchRuntimeInterpreter { interpreter: match_interpreter } =>
      v2.std.diagnostic.bind_outcome(
        o: eval_match_scrutinee_edge(node: node),
        f: fn(scrutinee_edge) {
          v2.std.diagnostic.bind_outcome(
            o: eval_runtime_node(
              node: scrutinee_edge.target,
              tree: tree,
              interpretation: interpretation,
              environment: environment,
              runtime: runtime,
              effect_io: effect_io
            ),
            f: fn(scrutinee_value) {
              v2.std.diagnostic.bind_outcome(
                o: match_interpreter.choose_arm(node, scrutinee_value, environment),
                f: fn(chosen) {
                  eval_runtime_node(
                    node: chosen,
                    tree: tree,
                    interpretation: interpretation,
                    environment: environment,
                    runtime: runtime,
                    effect_io: effect_io
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(
        eval_diagnostic(reason: ^eval_rejected_type_node, node: node)
      )
  }
}

fn eval_match_node(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _facts: v2.compiler.inferred_tree.InferredFacts,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  interpreter: v2.std.runtime.RuntimeBehaviorInterpreter,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  eval_match_node_eval(
    node: node,
    tree: tree,
    interpretation: interpretation,
    interpreter: interpreter,
    environment: environment,
    runtime: runtime,
    effect_io: effect_io
  )
}

fn eval_computation_node(
  behavior: v2.std.node.Behavior,
  node: v2.std.node.Node,
  args: List<v2.std.runtime.RuntimeValue>,
  facts: v2.compiler.inferred_tree.InferredFacts,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  let dispatch = v2.std.runtime.interpretation_behavior_dispatch(
    interpretation: interpretation,
    behavior: behavior
  )
  v2.std.diagnostic.bind_outcome(
    o: match dispatch {
      ValueRuntimeInterpreter { interpreter: _ } =>
        eval_value_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime
        )
      TransformRuntimeInterpreter { interpreter: _ } =>
        eval_transform_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpretation: interpretation,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime,
          effect_io: effect_io
        )
      BranchRuntimeInterpreter { interpreter: _ } =>
        eval_branch_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpretation: interpretation,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime,
          effect_io: effect_io
        )
      LoopRuntimeInterpreter { interpreter: _ } =>
        eval_loop_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime
        )
      BindRuntimeInterpreter { interpreter: _ } =>
        eval_bind_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpretation: interpretation,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime,
          effect_io: effect_io
        )
      MatchRuntimeInterpreter { interpreter: _ } =>
        eval_match_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpretation: interpretation,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime,
          effect_io: effect_io
        )
    },
    f: fn(value) {
      eval_accept_runtime_value_with_facts(node: node, facts: facts, value: value)
    }
  )
}

fn eval_interpret_node(
  node: v2.std.node.Node,
  args: List<v2.std.runtime.RuntimeValue>,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.bind_outcome(
    o: inferred_facts_for_eval(tree: tree, node: node),
    f: fn(facts) {
      match node.kind {
        ComputationNode { behavior: b } =>
          eval_computation_node(
            behavior: b,
            node: node,
            args: args,
            facts: facts,
            tree: tree,
            interpretation: interpretation,
            environment: environment,
            runtime: runtime,
            effect_io: effect_io
          )
        TypeNode { connective: _ } =>
          eval_type_node_atom(
            node: node,
            interpretation: interpretation,
            environment: environment
          )
      }
    }
  )
}

fn empty_runtime_values() -> List<v2.std.runtime.RuntimeValue> {
  []
}

fn eval_edge_is_runtime_argument(parent: v2.std.node.Node, progress: EvalProgress, edge: v2.std.node.Edge) -> Bool {
  if eval_transform_has_callee_reference(node: parent) {
    match progress {
      AwaitingChildren { processed: p } =>
        if gunbc.plans.md_helpers.p == 0 { false } else { v2.std.node.is_positional(e: edge) }
      ReadyToInterpret => v2.std.node.is_positional(e: edge)
      Interpreted => v2.std.node.is_positional(e: edge)
    }
  } else if eval_node_is_branch(node: parent) {
    match progress {
      AwaitingChildren { processed: p } =>
        if gunbc.plans.md_helpers.p == 0 { v2.std.node.is_positional(e: edge) } else { false }
      ReadyToInterpret => false
      Interpreted => false
    }
  } else if eval_node_is_loop(node: parent) {
    false
  } else {
    v2.std.node.is_positional(e: edge)
  }
}

fn eval_fold_state_value(state: EvalFoldState) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  state.value
}

fn eval_absorb_child_diagnostics(
  acc: v2.std.diagnostic.Outcome<List<v2.std.runtime.RuntimeValue>>,
  child: v2.std.diagnostic.Outcome<v2.std.node.Node>
) -> v2.std.diagnostic.Outcome<List<v2.std.runtime.RuntimeValue>> {
  v2.std.diagnostic.absorb_outcome_diagnostics(
    acc: acc,
    child: child,
    policy: eval_short_circuit_policy()
  )
}

fn eval_append_child_value(
  acc: v2.std.diagnostic.Outcome<List<v2.std.runtime.RuntimeValue>>,
  child: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
) -> v2.std.diagnostic.Outcome<List<v2.std.runtime.RuntimeValue>> {
  v2.std.diagnostic.append_outcome_value(
    acc: acc,
    child: child,
    policy: eval_short_circuit_policy()
  )
}

fn eval_fold_init(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> EvalFoldState {
  let progress = if count(node.children) == 0 { ReadyToInterpret } else { AwaitingChildren { processed: 0 } }
  EvalFoldState {
    node: node,
    progress: progress,
    structural: eval_structural_node_for_eval(tree: tree, node: node),
    child_values: v2.std.diagnostic.Accepted { value: empty_runtime_values(), diagnostics: v2.std.diagnostic.None },
    value: if count(node.children) == 0 {
      eval_interpret_node(
        node: node,
        args: empty_runtime_values(),
        tree: tree,
        interpretation: interpretation,
        environment: environment,
        runtime: runtime,
        effect_io: effect_io
      )
    } else {
      v2.std.diagnostic.outcome_rejected(
        d: eval_diagnostic(reason: ^eval_rejected_pending_children, node: node)
      )
    }
  }
}

fn eval_fold_control_transfer_state(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> EvalFoldState {
  EvalFoldState {
    node: node,
    progress: Interpreted,
    structural: eval_structural_node_for_eval(tree: tree, node: node),
    child_values: v2.std.diagnostic.Accepted { value: empty_runtime_values(), diagnostics: v2.std.diagnostic.None },
    value: eval_runtime_control_node(
      node: node,
      tree: tree,
      interpretation: interpretation,
      environment: environment,
      runtime: runtime,
      effect_io: effect_io
    )
  }
}

fn eval_fold_is_callee_reference_edge(
  parent: v2.std.node.Node,
  progress: EvalProgress,
  edge: v2.std.node.Edge
) -> Bool {
  if eval_transform_has_callee_reference(node: parent) {
    match progress {
      AwaitingChildren { processed: p } => gunbc.plans.md_helpers.p == 0 && v2.std.node.is_positional(e: edge)
      ReadyToInterpret => false
      Interpreted => false
    }
  } else {
    false
  }
}

fn eval_fold_callee_reference_child_state(
  edge: v2.std.node.Edge,
  tree: v2.compiler.inferred_tree.InferredTree
) -> EvalFoldState {
  EvalFoldState {
    node: edge.target,
    progress: Interpreted,
    structural: eval_structural_node_for_eval(tree: tree, node: edge.target),
    child_values: v2.std.diagnostic.Accepted { value: empty_runtime_values(), diagnostics: v2.std.diagnostic.None },
    value: v2.std.diagnostic.outcome_rejected(
      d: eval_diagnostic(reason: ^eval_rejected_pending_children, node: edge.target)
    )
  }
}

data eval_closure_argument_note: String = "A closure passed as a runtime argument is an Arrow TypeNode in argument position (fold's transform child 3). Its value is the closure itself — the captured arrow plus the environment it closes over — NOT the value of its body, whose parameters (fold acc/h) are unbound until the callee applies it. So the walk materializes RuntimeClosure here and does not descend into the arrow's children; descending would evaluate the body against an environment that cannot bind its parameters. This is the same structural-child seam as eval_fold_is_callee_reference_edge (a child the walk must not value-evaluate), at edge grain so an Arrow in CALLEE or root position still evaluates normally — only a runtime-argument edge is a closure. Carrier is the existing v2.std.runtime authority (RuntimeClosureValue); no literal-atom roster is extended."

fn eval_fold_is_closure_argument_edge(
  parent: v2.std.node.Node,
  progress: EvalProgress,
  edge: v2.std.node.Edge
) -> Bool {
  eval_edge_is_runtime_argument(parent: parent, progress: progress, edge: edge)
    && eval_node_is_arrow(node: edge.target)
}

fn eval_fold_closure_argument_child_state(
  edge: v2.std.node.Edge,
  tree: v2.compiler.inferred_tree.InferredTree,
  environment: v2.std.runtime.EvaluationEnvironment
) -> EvalFoldState {
  EvalFoldState {
    node: edge.target,
    progress: Interpreted,
    structural: eval_structural_node_for_eval(tree: tree, node: edge.target),
    child_values: v2.std.diagnostic.Accepted { value: empty_runtime_values(), diagnostics: v2.std.diagnostic.None },
    value: v2.std.diagnostic.Accepted {
      value: v2.std.runtime.RuntimeClosure {
        value: v2.std.runtime.RuntimeClosureValue {
          arrow_type: edge.target,
          arrow: edge.target,
          environment: environment
        }
      },
      diagnostics: v2.std.diagnostic.None
    }
  }
}

fn eval_fold_child_for_edge(
  acc: EvalFoldState,
  edge: v2.std.node.Edge,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> EvalFoldState {
  if eval_fold_is_callee_reference_edge(
    parent: acc.node,
    progress: acc.progress,
    edge: edge
  ) {
    eval_fold_callee_reference_child_state(edge: edge, tree: tree)
  } else if eval_fold_is_closure_argument_edge(
    parent: acc.node,
    progress: acc.progress,
    edge: edge
  ) {
    eval_fold_closure_argument_child_state(
      edge: edge,
      tree: tree,
      environment: environment
    )
  } else {
    eval_fold_tree(
      n: edge.target,
      tree: tree,
      interpretation: interpretation,
      environment: environment,
      runtime: runtime,
      effect_io: effect_io
    )
  }
}

fn eval_fold_child_edge_step(
  acc: EvalFoldState,
  edge: v2.std.node.Edge,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> EvalFoldState {
  eval_fold_step(
    acc: acc,
    edge: edge,
    child: eval_fold_child_for_edge(
      acc: acc,
      edge: edge,
      tree: tree,
      interpretation: interpretation,
      environment: environment,
      runtime: runtime,
      effect_io: effect_io
    ),
    tree: tree,
    interpretation: interpretation,
    environment: environment,
    runtime: runtime,
    effect_io: effect_io
  )
}

fn eval_fold_tree(
  n: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> EvalFoldState {
  if eval_runtime_node_is_control_transfer(node: n) {
    eval_fold_control_transfer_state(
      node: n,
      tree: tree,
      interpretation: interpretation,
      environment: environment,
      runtime: runtime,
      effect_io: effect_io
    )
  } else {
    v2.std.algebra.fold_list(
      xs: n.children,
      empty: eval_fold_init(
        node: n,
        tree: tree,
        interpretation: interpretation,
        environment: environment,
        runtime: runtime,
        effect_io: effect_io
      ),
      cons: fn(acc, e) {
        eval_fold_child_edge_step(
          acc: acc,
          edge: e,
          tree: tree,
          interpretation: interpretation,
          environment: environment,
          runtime: runtime,
          effect_io: effect_io
        )
      }
    )
  }
}

fn eval_maybe_complete_node(
  node: v2.std.node.Node,
  progress: EvalProgress,
  args: List<v2.std.runtime.RuntimeValue>,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext,
  pending: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match progress {
    ReadyToInterpret =>
      eval_interpret_node(
        node: node,
        args: args,
        tree: tree,
        interpretation: interpretation,
        environment: environment,
        runtime: runtime,
        effect_io: effect_io
      )
    Interpreted => pending
    AwaitingChildren { processed: _ } => pending
  }
}

fn eval_advance_progress(progress: EvalProgress, node: v2.std.node.Node) -> EvalProgress {
  match progress {
    AwaitingChildren { processed: p } => {
      let processed = gunbc.plans.md_helpers.p + 1
      if processed == count(node.children) { ReadyToInterpret } else { AwaitingChildren { processed: processed } }
    }
    ReadyToInterpret => Interpreted
    Interpreted => Interpreted
  }
}

fn eval_fold_step(
  acc: EvalFoldState,
  edge: v2.std.node.Edge,
  child: EvalFoldState,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> EvalFoldState {
  let structural = eval_absorb_structural_child(acc: acc.structural, child: child.structural)
  let next_args = if eval_edge_is_runtime_argument(parent: acc.node, progress: acc.progress, edge: edge) {
    eval_append_child_value(acc: acc.child_values, child: child.value)
  } else {
    eval_absorb_child_diagnostics(acc: acc.child_values, child: child.structural)
  }
  let progress = eval_advance_progress(progress: acc.progress, node: acc.node)
  EvalFoldState {
    node: acc.node,
    progress: progress,
    structural: structural,
    child_values: next_args,
    value: v2.std.diagnostic.bind_outcome(
      o: structural,
      f: fn(_) {
        v2.std.diagnostic.bind_outcome(
          o: next_args,
          f: fn(args) {
            eval_maybe_complete_node(
              node: acc.node,
              progress: progress,
              args: args,
              tree: tree,
              interpretation: interpretation,
              environment: environment,
              runtime: runtime,
              effect_io: effect_io,
              pending: acc.value
            )
          }
        )
      }
    )
  }
}

fn eval_runtime_node_is_control_transfer(node: v2.std.node.Node) -> Bool {
  match node.kind {
    ComputationNode { behavior: Branch } => true
    ComputationNode { behavior: Loop } => true
    ComputationNode { behavior: v2.std.node.Bind } => true
    ComputationNode { behavior: Match } => true
    _ => false
  }
}

fn eval_runtime_control_node(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.bind_outcome(
    o: inferred_facts_for_eval(tree: tree, node: node),
    f: fn(facts) {
      let dispatch = match node.kind {
        ComputationNode { behavior: b } =>
          v2.std.runtime.interpretation_behavior_dispatch(interpretation: interpretation, behavior: b)
        _ =>
          v2.std.runtime.TransformRuntimeInterpreter {
            interpreter: interpretation.transform
          }
      }
      v2.std.diagnostic.bind_outcome(
        o: match node.kind {
          ComputationNode { behavior: Branch } =>
            eval_branch_node_eval(
              node: node,
              tree: tree,
              interpretation: interpretation,
              interpreter: dispatch,
              environment: environment,
              runtime: runtime,
              effect_io: effect_io
            )
          ComputationNode { behavior: Loop } =>
            eval_loop_node(
              node: node,
              args: empty_runtime_values(),
              facts: facts,
              tree: tree,
              interpreter: dispatch,
              environment: environment,
              runtime: runtime
            )
          ComputationNode { behavior: v2.std.node.Bind } =>
            eval_bind_node_eval(
              node: node,
              tree: tree,
              interpretation: interpretation,
              interpreter: dispatch,
              environment: environment,
              runtime: runtime,
              effect_io: effect_io
            )
          ComputationNode { behavior: Match } =>
            eval_match_node_eval(
              node: node,
              tree: tree,
              interpretation: interpretation,
              interpreter: dispatch,
              environment: environment,
              runtime: runtime,
              effect_io: effect_io
            )
          _ =>
            v2.std.diagnostic.outcome_rejected(d: eval_diagnostic(reason: ^eval_rejected_type_node, node: node))
        },
        f: fn(value) {
          eval_accept_runtime_value_with_facts(node: node, facts: facts, value: value)
        }
      )
    }
  )
}

fn eval_runtime_node_via_data_flow_fold(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  let folded = eval_fold_tree(
    n: node,
    tree: tree,
    interpretation: interpretation,
    environment: environment,
    runtime: runtime,
    effect_io: effect_io
  )
  eval_fold_state_value(state: folded)
}

fn eval_runtime_node(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  environment: v2.std.runtime.EvaluationEnvironment,
  runtime: v2.extdeps.runtimes.v2_evaluator.V4EvaluatorRuntime,
  effect_io: EffectIoEvalContext
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if eval_runtime_node_is_control_transfer(node: node) {
    eval_runtime_control_node(
      node: node,
      tree: tree,
      interpretation: interpretation,
      environment: environment,
      runtime: runtime,
      effect_io: effect_io
    )
  } else {
    eval_runtime_node_via_data_flow_fold(
      node: node,
      tree: tree,
      interpretation: interpretation,
      environment: environment,
      runtime: runtime,
      effect_io: effect_io
    )
  }
}

fn eval_with_context(
  tree: v2.compiler.inferred_tree.InferredTree,
  context: EvalContext,
  inputs: Inputs
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if v2.std.node.well_formed(n: tree.root) {
    if v2.std.node.well_formed(n: inputs.root) {
      eval_runtime_node(
        node: inputs.root,
        tree: tree,
        interpretation: eval_context_interpretation(context: context),
        environment: empty_evaluation_environment(),
        runtime: eval_runtime(),
        effect_io: eval_context_effect_io(context: context)
      )
    } else {
      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: eval_diagnostic(reason: ^eval_rejected_invalid_node, node: inputs.root)) }
    }
  } else {
    v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: eval_diagnostic(reason: ^eval_rejected_invalid_node, node: tree.root)) }
  }
}

fn eval(tree: v2.compiler.inferred_tree.InferredTree, interpretation: v2.std.runtime.InterpretationAlgebra, inputs: Inputs) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if v2.std.node.well_formed(n: tree.root) {
    if v2.std.node.well_formed(n: inputs.root) {
      eval_runtime_node(
        node: inputs.root,
        tree: tree,
        interpretation: interpretation,
        environment: empty_evaluation_environment(),
        runtime: eval_runtime(),
        effect_io: EffectIoEvalAbsent
      )
    } else {
      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: eval_diagnostic(reason: ^eval_rejected_invalid_node, node: inputs.root)) }
    }
  } else {
    v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: eval_diagnostic(reason: ^eval_rejected_invalid_node, node: tree.root)) }
  }
}

fn eval_node(tree: v2.compiler.inferred_tree.InferredTree, inputs: Inputs) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: eval(tree: tree, interpretation: eval_default_interpretation(), inputs: inputs),
    f: fn(value) {
      match v2.std.runtime.runtime_value_node_projection(value: value) {
        RuntimeValueNodeProjected { node: n } =>
          v2.std.diagnostic.Accepted { value: n, diagnostics: v2.std.diagnostic.None }
        RuntimeValueNodeUnrepresentable =>
          v2.std.diagnostic.outcome_rejected(
            d: eval_diagnostic(
              reason: ^eval_rejected_runtime_value_node_unrepresentable,
              node: inputs.root
            )
          )
      }
    }
  )
}

fn eval_round_trip_claim_input_for_verdict(input: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if v2.std.node.well_formed(n: input) {
    v2.std.diagnostic.Accepted { value: input, diagnostics: v2.std.diagnostic.None }
  } else {
    v2.std.diagnostic.Rejected {
      diagnostics: v2.std.diagnostic.diagnostics_singleton(
        d: eval_diagnostic(reason: ^eval_rejected_invalid_node, node: input)
      )
    }
  }
}

fn run_test_claim_round_trip_verdict(
  actual: v2.std.diagnostic.Outcome<v2.std.node.Node>,
  at: v2.std.node.Node
) -> v2.std.verdict.Verdict<TestClaimEvalSubject<v2.std.node.Node>, v2.std.node.Node> {
  match actual {
    Rejected { diagnostics: _ } => v2.std.verdict.verdict_fail(actual: actual)
    Accepted { value: _, diagnostics: _ } =>
      if v2.extdeps.languages.dag.dag_round_trip_authorities_ready() {
        Pass
      } else {
        v2.std.verdict.verdict_fail(
          actual: v2.std.diagnostic.outcome_rejected(
            d: eval_diagnostic(reason: ^eval_rejected_roundtrip_precondition, node: at)
          )
        )
      }
  }
}

fn run_test_claim_round_trip_verdict_runtime(
  actual: v2.std.diagnostic.Outcome<v2.std.node.Node>,
  at: v2.std.node.Node
) -> v2.std.verdict.Verdict<TestClaimEvalSubject<v2.std.node.Node>, v2.std.runtime.RuntimeValue> {
  match actual {
    Rejected { diagnostics: _ } =>
      v2.std.verdict.verdict_fail(
        actual: v2.std.diagnostic.outcome_rejected(
          d: eval_diagnostic(reason: ^eval_rejected_invalid_node, node: at)
        )
      )
    Accepted { value: _, diagnostics: _ } =>
      if v2.extdeps.languages.dag.dag_round_trip_authorities_ready() {
        Pass
      } else {
        v2.std.verdict.verdict_fail(
          actual: v2.std.diagnostic.outcome_rejected(
            d: eval_diagnostic(reason: ^eval_rejected_roundtrip_precondition, node: at)
          )
        )
      }
  }
}

fn run_test_claim_assert(
  claim: v2.std.verification.TestClaim,
  actual: v2.std.diagnostic.Outcome<v2.std.node.Node>,
  at: v2.std.node.Node
) -> v2.std.verdict.Verdict<TestClaimEvalSubject<v2.std.node.Node>, v2.std.node.Node> {
  run_test_claim_assert_decided(claim: claim, actual: actual, at: at)
}

fn run_test_claim_structural_equals_verdict(
  actual: v2.std.diagnostic.Outcome<v2.std.node.Node>,
  rhs: v2.std.node.Node,
  at: v2.std.node.Node
) -> v2.std.verdict.Verdict<TestClaimEvalSubject<v2.std.node.Node>, v2.std.runtime.RuntimeValue> {
  match actual {
    Rejected { diagnostics: _ } =>
      v2.std.verdict.verdict_fail(
        actual: v2.std.diagnostic.outcome_rejected(
          d: eval_diagnostic(reason: ^eval_rejected_invalid_node, node: at)
        )
      )
    Accepted { value: admitted, diagnostics: _ } =>
      if v2.std.diagnostic.outcome_node_eq(
        a: v2.std.diagnostic.Accepted { value: admitted, diagnostics: v2.std.diagnostic.None },
        b: v2.std.diagnostic.Accepted { value: rhs, diagnostics: v2.std.diagnostic.None }
      ) {
        Pass
      } else {
        v2.std.verdict.verdict_fail(
          actual: v2.std.diagnostic.outcome_rejected(
            d: eval_diagnostic(reason: ^eval_structural_equals_mismatch, node: at)
          )
        )
      }
  }
}

fn run_test_claim_assert_decided(
  claim: v2.std.verification.TestClaim,
  actual: v2.std.diagnostic.Outcome<v2.std.node.Node>,
  at: v2.std.node.Node
) -> v2.std.verdict.Verdict<TestClaimEvalSubject<v2.std.node.Node>, v2.std.node.Node> {
  match claim {
    EqualsClaim { rhs: rhs, label: _, anchor: _, lhs: _, classification: _ } =>
      if v2.std.diagnostic.outcome_node_eq(a: actual, b: v2.std.diagnostic.Accepted { value: rhs, diagnostics: v2.std.diagnostic.None }) {
        Pass
      } else {
        v2.std.verdict.verdict_fail(actual: actual)
      }
    StructuralEqualsClaim { rhs: rhs, label: _, anchor: _, lhs: _, classification: _ } =>
      if v2.std.diagnostic.outcome_node_eq(a: actual, b: v2.std.diagnostic.Accepted { value: rhs, diagnostics: v2.std.diagnostic.None }) {
        Pass
      } else {
        v2.std.verdict.verdict_fail(actual: actual)
      }
    CompilesClaim { expected_value: expected, label: _, anchor: _, input: _, classification: _ } =>
      if v2.std.diagnostic.outcome_node_eq(
        a: actual,
        b: v2.std.diagnostic.Accepted { value: expected, diagnostics: v2.std.diagnostic.None }
      ) {
        Pass
      } else {
        v2.std.verdict.verdict_fail(actual: actual)
      }
    RoundTripClaim { label: _, anchor: _, input: input, classification: _ } =>
      run_test_claim_round_trip_verdict(
        actual: eval_round_trip_claim_input_for_verdict(input: input),
        at: at
      )
    DiagnosticClaim { expected_rejection: expected, input: input, label: _, anchor: _, classification: _ } =>
      match actual {
        Rejected { diagnostics: _ } =>
          if v2.std.diagnostic.outcome_node_eq(a: actual, b: v2.std.diagnostic.Rejected { diagnostics: expected }) {
            Pass
          } else {
            v2.std.verdict.verdict_fail(actual: actual)
          }
        _ => v2.std.verdict.verdict_fail(actual: actual)
      }
  }
}

fn runtime_value_eq(a: v2.std.runtime.RuntimeValue, b: v2.std.runtime.RuntimeValue) -> Bool {
  a == b
}

fn outcome_runtime_value_eq(a: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>, b: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>) -> Bool {
  v2.std.diagnostic.outcome_eq(a: a, b: b, payload_eq: runtime_value_eq)
}

fn accepted_runtime_value_outcome_eq(a: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>, b: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>) -> Bool {
  match b {
    Accepted { value: _, diagnostics: _ } => outcome_runtime_value_eq(a: a, b: b)
    Rejected { diagnostics: _ } => false
  }
}

fn run_test_claim_runtime_assert(
  claim: v2.std.verification.TestClaim,
  tree: v2.compiler.inferred_tree.InferredTree,
  interpretation: v2.std.runtime.InterpretationAlgebra,
  actual: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  at: v2.std.node.Node
) -> v2.std.verdict.Verdict<TestClaimEvalSubject<v2.std.node.Node>, v2.std.runtime.RuntimeValue> {
  match claim {
    EqualsClaim { rhs: rhs, label: _, anchor: _, lhs: _, classification: _ } => {
      let expected = eval(tree: tree, interpretation: interpretation, inputs: inputs_root_only(root: rhs))
      if accepted_runtime_value_outcome_eq(a: actual, b: expected) {
        Pass
      } else {
        v2.std.verdict.verdict_fail(actual: actual)
      }
    }

    StructuralEqualsClaim { rhs: rhs, label: _, anchor: _, lhs: _, classification: _ } => {
      let expected = eval(tree: tree, interpretation: interpretation, inputs: inputs_root_only(root: rhs))
      if accepted_runtime_value_outcome_eq(a: actual, b: expected) {
        Pass
      } else {
        v2.std.verdict.verdict_fail(actual: actual)
      }
    }
    CompilesClaim { expected_value: expected, label: _, anchor: _, input: _, classification: _ } => {
      let expected_outcome = eval(tree: tree, interpretation: interpretation, inputs: inputs_root_only(root: expected))
      if accepted_runtime_value_outcome_eq(a: actual, b: expected_outcome) {
        Pass
      } else {
        v2.std.verdict.verdict_fail(actual: actual)
      }
    }
    RoundTripClaim { label: _, anchor: _, input: input, classification: _ } =>
      run_test_claim_round_trip_verdict_runtime(
        actual: eval_round_trip_claim_input_for_verdict(input: input),
        at: at
      )
    DiagnosticClaim { expected_rejection: expected, input: _, label: _, anchor: _, classification: _ } =>
      match actual {
        Rejected { diagnostics: _ } =>
          if outcome_runtime_value_eq(a: actual, b: v2.std.diagnostic.Rejected { diagnostics: expected }) {
            Pass
          } else {
            v2.std.verdict.verdict_fail(actual: actual)
          }
        _ => v2.std.verdict.verdict_fail(actual: actual)
      }
  }
}

fn aggregate_verdicts<S, T>(
  rs: List<v2.std.verdict.Verdict<TestClaimEvalSubject<S>, T>>,
  at: v2.std.node.Node
) -> v2.std.verdict.Verdict<TestClaimEvalSubject<S>, T> {
  v2.std.verdict.verdict_fold(
    rs: rs,
    empty_verdict: v2.std.verdict.verdict_fail(
      actual: v2.std.diagnostic.outcome_rejected(
        d: eval_diagnostic(reason: ^eval_empty_verdict_list, node: at)
      )
    )
  )
}

fn run_test_claim(
  subject: TestClaimEvalSubject<v2.std.node.Node>
) -> TestClaimRun<v2.std.node.Node, v2.std.runtime.RuntimeValue> {
  let at = v2.std.verification.test_claim_input(c: subject.claim)
  match subject.claim {
    RoundTripClaim { label: _, anchor: _, input: _, classification: _ } =>
      TestClaimRun {
        cache: test_claim_cache_receipt_node(subject: subject),
        verdict: run_test_claim_round_trip_verdict_runtime(
          actual: eval_round_trip_claim_input_for_verdict(
            input: subject.input.evaluator_input
          ),
          at: at
        )
      }

    StructuralEqualsClaim { rhs: rhs, label: _, anchor: _, lhs: _, classification: _ } =>
      TestClaimRun {
        cache: test_claim_cache_receipt_node(subject: subject),
        verdict: run_test_claim_structural_equals_verdict(
          actual: eval_round_trip_claim_input_for_verdict(
            input: subject.input.evaluator_input
          ),
          rhs: rhs,
          at: at
        )
      }
    _ => {
      let actual = eval_with_context(
        tree: subject.tree,
        context: subject.context,
        inputs: inputs_root_only(root: subject.input.evaluator_input)
      )
      TestClaimRun {
        cache: test_claim_cache_receipt_node(subject: subject),
        verdict: aggregate_verdicts(
          rs: [
            run_test_claim_runtime_assert(
              claim: subject.claim,
              tree: subject.tree,
              interpretation: eval_context_interpretation(context: subject.context),
              actual: actual,
              at: at
            )
          ],
          at: at
        )
      }
    }
  }
}

fn eval_test_claim_subject(
  claim: v2.std.verification.TestClaim,
  context: EvalContext,
  tree: v2.compiler.inferred_tree.InferredTree,
  evaluator_pin: v2.std.node.Symbol
) -> TestClaimEvalSubject<v2.std.node.Node> {
  let input = v2.std.verification.test_claim_input(c: claim)
  TestClaimEvalSubject {
    claim: claim,
    context: context,
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: evaluator_pin
    )
  }
}
