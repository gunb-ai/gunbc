module v2.compiler.emit


fn serialize_source_for_emitted(
  emitted: v2.compiler.translate.TargetNodeTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.compiler.translate.target_serialize_source_from_model(target: target, emitted: emitted)
}
fn serialize_target(tree: v2.compiler.translate.TargetNodeTree, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  serialize_source_for_emitted(emitted: tree, target: target)
}
fn emit(
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.translate.translate(tree: tree, target: target),
    f: fn(target_tree) {
      serialize_target(tree: target_tree, target: target)
    }
  )
}
