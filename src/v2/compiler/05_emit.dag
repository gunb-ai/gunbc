module v2.compiler.emit

import extdeps.communication.medium { Medium }
import v2.compiler.infer { InferredTree }
import v2.compiler.translate {
  TargetNodeTree,
  target_serialize_source_from_model,
  translate
}
import v2.std.diagnostic {
  Outcome,
  bind_outcome
}
import v2.std.compilers.target_model { TargetModel }

fn serialize_source_for_emitted(
  emitted: TargetNodeTree,
  target: TargetModel
) -> Outcome<Medium<String>> {
  target_serialize_source_from_model(target: target, emitted: emitted)
}
fn serialize_target(tree: TargetNodeTree, target: TargetModel) -> Outcome<Medium<String>> {
  serialize_source_for_emitted(emitted: tree, target: target)
}
fn emit(
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: translate(tree: tree, target: target),
    f: fn(target_tree) {
      serialize_target(tree: target_tree, target: target)
    }
  )
}
