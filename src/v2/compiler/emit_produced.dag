module v2.compiler.emit_produced

import v2.compiler.emit_module { emit_module_decl_separator }
import v2.compiler.translate { target_serialize_bodied_arrow_from_model }
import v2.compiler.target_carriers { target_source_medium }
import v2.std.compilers.target_model {
  ProducedDeclUnwired,
  ProducedDeclWired,
  TargetModel,
  produced_decl_render_from_rows,
  render_target_text,
  target_model_with_produced_scaffold
}
import extdeps.communication.medium { Medium }
import v2.std.collection { Absent, List, Present, list_at_optional }
import v2.std.algebra { fold_list, FreeMonoid, list_append, list_snoc_item }
import std.algebra { Cons, Empty }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  node_locus,
  outcome_rejected
}
import v2.std.node { Arrow, Conj, Edge, Named, Node, node_synthetic, Positional, Symbol, TypeNode }
import v2.std.logic { Bool }
import v2.std.node_query { find_arrow_body_child }
import v2.extdeps.languages.dag { namespace_graft_node_is_module_body }
import v2.std.integer { Int }
import v2.std.text { String }

fn emit_produced_decl_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_produced_decl_inner_arrow(decl: Node) -> Outcome<Node> {
  match decl.kind {
    TypeNode { connective: Conj } =>
      match list_at_optional(xs: decl.children, index: 0) {
        Present { value: edge } =>
          match edge.label {
            Named { name: _ } => Accepted { value: edge.target, diagnostics: None }
            Positional =>
              Rejected {
                diagnostics: diagnostics_singleton(
                  d: emit_produced_decl_diagnostic(reason: ^emit_produced_decl_unnamed, node: decl)
                )
              }
          }
        Absent =>
          Rejected {
            diagnostics: diagnostics_singleton(
              d: emit_produced_decl_diagnostic(reason: ^emit_produced_decl_empty, node: decl)
            )
          }
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: emit_produced_decl_diagnostic(reason: ^emit_produced_decl_not_conj, node: decl)
        )
      }
  }
}

// WHERE PRODUCED DECLARATIONS COME FROM. A declaration in a resolved module is the NAMED EDGE
// INTO AN ARROW, never a node: the module shell is a Conj carrying one such edge per declaration,
// and no separate per-declaration node exists in the tree to collect. The previous walk looked for
// a decl-shaped NODE — a Conj whose FIRST child is a Named edge into an Arrow — and that predicate
// cannot tell an N-declaration shell from a 1-declaration one, because both have the same first
// child. So the shell itself matched, collection stopped there, and emission (which reads
// children[0]) published declaration 1 and SILENTLY DROPPED declarations 2..N. A one-declaration
// module was correct only by coincidence, shell and declaration being the same node at N=1.
// Measured on the production ingest path 2026-09-09: a two-declaration module emitted exactly its
// first declaration and reported Accepted.
// The walk is therefore edge-driven and total: descend an edge that is not a declaration, record
// one declaration per edge that is, and never descend INTO a declaration (an arrow body's inner
// named arrows are not module declarations). Order is source order. The single-edge Conj this
// projects per declaration is the declaration's canonical node form — the same shape
// v2.compiler.ingested_fixture_arrows ingested_add_decl_node builds — so emit_produced_decl and
// produced_decl_subject_from_decl keep consuming a Node.
// STANDING §3 FORK, NOT CLOSED HERE: v2.workflow.realization_attempt collect_arrows answers this
// same question for itself, and answered it CORRECTLY per-edge while this authority did not, which
// is why the census lane never saw the drop. Consolidating it onto this collector is a separate
// change against a separate consumer (it walks a RESOLVED tree and searches for the first arrow
// BELOW an edge rather than requiring the edge to target one), and merging the two without
// measuring that difference would trade a silent drop for a silent empty population.
// How many declarations a composition expects, and what an empty population means, is the
// caller's admission policy — never a silent filter here.
// The label/kind match lives behind a declared Edge parameter because the v1 seed stamps pattern
// variables from a declared parameter type, not from a field-access scrutinee.
fn produced_decl_edge_is_decl(edge: Edge) -> Bool {
  match edge.label {
    Named { name: _ } =>
      match edge.target.kind {
        TypeNode { connective: Arrow } => true
        _ => false
      }
    Positional => false
  }
}

fn produced_decl_node_for_edge(edge: Edge) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [edge]
  )
}

fn produced_decl_conjs_in_children(
  children: FreeMonoid<Edge>,
  acc: FreeMonoid<Node>
) -> FreeMonoid<Node> {
  match children {
    Empty => acc
    Cons { head: e, tail: rest } =>
      produced_decl_conjs_in_children(
        children: rest,
        acc: if produced_decl_edge_is_decl(edge: e) {
          list_snoc_item(xs: acc, item: produced_decl_node_for_edge(edge: e))
        } else {
          produced_decl_conjs_in_children(children: e.target.children, acc: acc)
        }
      )
  }
}

fn produced_decl_conjs_in_tree(root: Node) -> FreeMonoid<Node> {
  produced_decl_conjs_in_children(children: root.children, acc: Empty)
}

fn produced_module_member_is_bodied_decl(edge: Edge) -> Bool {
  match edge.label {
    Named { name: n } =>
      if n == ^grammar_production_identity_node_projection {
        true
      } else {
        match edge.target.kind {
          TypeNode { connective: Arrow } =>
            match find_arrow_body_child(root: edge.target) {
              Accepted { value: _, diagnostics: _ } => true
              Rejected { diagnostics: _ } => false
            }
          _ => false
        }
      }
    Positional => false
  }
}

// Counts module bodies found and module bodies holding a member that is not a bodied declaration.
type ProducedModuleCensus { bodies: Int, unrenderable: Int }

fn produced_module_census(node: Node, acc: ProducedModuleCensus) -> ProducedModuleCensus {
  if namespace_graft_node_is_module_body(node: node) {
    ProducedModuleCensus {
      bodies: acc.bodies + 1,
      unrenderable: if fold(node.children, init: true, f: fn(ok, e) {
        ok && produced_module_member_is_bodied_decl(edge: e)
      }) {
        acc.unrenderable
      } else {
        acc.unrenderable + 1
      }
    }
  } else {
    fold(node.children, init: acc, f: fn(a, e) { produced_module_census(node: e.target, acc: a) })
  }
}

// A TREE IS RENDERED AS A MODULE ONLY WHEN EVERY MEMBER OF EVERY MODULE BODY IN IT IS A BODIED
// DECLARATION. The module body is the node the dag language authority marks
// (`v2.extdeps.languages.dag` `namespace_graft_node_is_module_body`), and a member is a bodied
// declaration exactly when `emit_produced_module` renders it through the target's declared rows
// (DESIGN section 4: the rows read backward, never a second emitter). The whole-body condition is the
// wall: the declaration collector skips a member that is not an arrow, so a module declaring
// `type Pair { .. }` beside `fn add` would otherwise emit `fn add` alone and drop the type with
// nothing refusing. Such a module is NOT admitted here; it reaches the type-expression translate,
// which refuses it typed and located (`translate_module_not_a_type_expression`).
fn produced_module_declares_bodied_members(root: Node) -> Bool {
  let census = produced_module_census(node: root, acc: ProducedModuleCensus { bodies: 0, unrenderable: 0 })
  (census.bodies > 0) && (census.unrenderable == 0)
}

fn emit_produced_decl_with_target(
  decl: Node,
  target: TargetModel
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: emit_produced_decl_inner_arrow(decl: decl),
    f: fn(arrow) {
      bind_outcome(
        o: target_serialize_bodied_arrow_from_model(target: target, emitted: arrow),
        f: fn(text) {
          target_source_medium(text: render_target_text(t: text), target: target)
        }
      )
    }
  )
}

// The compiler reads the TARGET's declared rendering rows and folds them into a
// bodied-arrow scaffold. It does not know whether the signature leads with a keyword or
// a return type, which side of a parameter the type sits on, whether a return arrow
// exists, or how the declaration closes -- every one of those is a row the target
// declares. A target that registered no rows refuses with a typed, located
// produced_decl_target_unwired:
// never a widen, never a fabricated default (DESIGN section 5).
fn emit_produced_decl(decl: Node, target: TargetModel) -> Outcome<Medium<String>> {
  match target.produced_decl_support {
    ProducedDeclUnwired =>
      outcome_rejected(
        d: emit_produced_decl_diagnostic(reason: ^produced_decl_target_unwired, node: decl)
      )
    ProducedDeclWired {
      render_rows: rows,
      scaffold_relation_rule_name: rule_name,
      scaffold_base_row: base_row
    } =>
      bind_outcome(
        o: produced_decl_render_from_rows(rows: rows, decl: decl),
        f: fn(scaffold) {
          emit_produced_decl_with_target(
            decl: decl,
            target: target_model_with_produced_scaffold(
              target: target,
              rule_name: rule_name,
              base_row: base_row,
              scaffold: scaffold
            )
          )
        }
      )
  }
}

fn emit_produced_module_append(
  partial: String,
  decl: Node,
  target: TargetModel
) -> Outcome<String> {
  bind_outcome(
    o: emit_produced_decl(decl: decl, target: target),
    f: fn(medium) {
      Accepted {
        value: concat(partial, medium.carried, emit_module_decl_separator),
        diagnostics: None
      }
    }
  )
}

fn emit_produced_module_step(
  acc: Outcome<String>,
  decl: Node,
  target: TargetModel
) -> Outcome<String> {
  bind_outcome(
    o: acc,
    f: fn(partial) {
      emit_produced_module_append(partial: partial, decl: decl, target: target)
    }
  )
}

// THE JOIN IS `concat` OVER A "" SEED, NOT `list_append` OVER `Empty`, and the difference is not
// cosmetic. Built by list_append from the FreeMonoid variant, the fold's result carries the
// CONS-LIST SPELLING of a string rather than the native one: `==` and `concat` still behave, which
// is why every golden over this fold stayed green for as long as goldens were all that read it --
// but a builtin that requires a native string REFUSES it. Measured 2026-09-10 as `split expects a
// string, got Variant` from v2.test.self_host.stage0_production_target's two contains-controls,
// the first consumers to read this fold's output through `split`. Nothing on the production door
// reached this fold until the door started routing every nonempty population through it, so the
// defect was latent rather than new, and the equality-only readers could never have found it.
// One representation for one concept (DESIGN section 3): a String is a String, not a FreeMonoid
// that happens to compare equal to one.
fn emit_produced_module(decls: List<Node>, target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: fold_list(
      xs: decls,
      empty: Accepted { value: "", diagnostics: None },
      cons: fn(acc, decl) { emit_produced_module_step(acc: acc, decl: decl, target: target) }
    ),
    f: fn(joined) { target_source_medium(text: joined, target: target) }
  )
}
