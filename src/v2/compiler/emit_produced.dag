module v2.compiler.emit_produced

import std.types { List }
import v2.compiler.target_serialize { target_serialize_bodied_arrow_from_model }
import v2.compiler.target_carriers { emit_module_decl_separator, target_source_medium }
import v2.std.compilers.target_model {
  ProducedDeclUnwired,
  ProducedDeclWired,
  TargetModel,
  produced_decl_render_from_rows,
  render_target_text,
  target_model_with_produced_scaffold
}
import extdeps.communication.medium { Medium }
import v2.std.collection { Absent, Present, list_at_optional }
import v2.std.algebra { fold_list, FreeMonoid }
import std.algebra { Cons, Empty, list_append, list_snoc_item }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  node_locus,
  outcome_rejected
}
import v2.std.node { Arrow, Conj, Disj, Edge, Named, Node, node_synthetic, Positional, Symbol, TypeNode }
import v2.std.type_binder { GenericTypeDecl, OpaqueTypeDecl, PlainTypeDecl, TypeAlias, type_decl_view }
import v2.compiler.emit_semantic_decl { emit_semantic_type_decl }
import v2.std.logic { Bool }
import v2.std.node_query { find_arrow_body_child }
import v2.extdeps.languages.dag { namespace_graft_node_is_module_body }
import v2.std.integer { Int }
import v2.std.text { String }

fn emit_produced_decl_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_produced_decl_inner_arrow(decl: Node) -> Outcome<Node> {
  match decl.kind {
    TypeNode { connective: Conj } =>
      match list_at_optional(xs: decl.children, index: 0) {
        Present { value: edge } =>
          match edge.label {
            Named { name: _ } => Accepted { value: edge.target, diagnostics: None }
            Positional =>
              Rejected {
                diagnostics: diagnostics_singleton(
                  d: emit_produced_decl_diagnostic(reason: ^emit_produced_decl_unnamed, node: decl)
                )
              }
          }
        Absent =>
          Rejected {
            diagnostics: diagnostics_singleton(
              d: emit_produced_decl_diagnostic(reason: ^emit_produced_decl_empty, node: decl)
            )
          }
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: emit_produced_decl_diagnostic(reason: ^emit_produced_decl_not_conj, node: decl)
        )
      }
  }
}

// WHERE PRODUCED DECLARATIONS COME FROM. A declaration in a resolved module is the NAMED EDGE
// INTO AN ARROW, never a node: the module shell is a Conj carrying one such edge per declaration,
// and no separate per-declaration node exists in the tree to collect. The previous walk looked for
// a decl-shaped NODE — a Conj whose FIRST child is a Named edge into an Arrow — and that predicate
// cannot tell an N-declaration shell from a 1-declaration one, because both have the same first
// child. So the shell itself matched, collection stopped there, and emission (which reads
// children[0]) published declaration 1 and SILENTLY DROPPED declarations 2..N. A one-declaration
// module was correct only by coincidence, shell and declaration being the same node at N=1.
// Measured on the production ingest path 2026-09-09: a two-declaration module emitted exactly its
// first declaration and reported Accepted.
// The walk is therefore edge-driven and total: descend an edge that is not a declaration, record
// one declaration per edge that is, and never descend INTO a declaration (an arrow body's inner
// named arrows are not module declarations). Order is source order. The single-edge Conj this
// projects per declaration is the declaration's canonical node form — the same shape
// v2.compiler.ingested_fixture_arrows ingested_add_decl_node builds — so emit_produced_decl and
// produced_decl_subject_from_decl keep consuming a Node.
// STANDING §3 FORK, NOT CLOSED HERE: v2.workflow.realization_attempt collect_arrows answers this
// same question for itself, and answered it CORRECTLY per-edge while this authority did not, which
// is why the census lane never saw the drop. Consolidating it onto this collector is a separate
// change against a separate consumer (it walks a RESOLVED tree and searches for the first arrow
// BELOW an edge rather than requiring the edge to target one), and merging the two without
// measuring that difference would trade a silent drop for a silent empty population.
// How many declarations a composition expects, and what an empty population means, is the
// caller's admission policy — never a silent filter here.
// The label/kind match lives behind a declared Edge parameter because the v1 seed stamps pattern
// variables from a declared parameter type, not from a field-access scrutinee.
fn produced_decl_edge_is_decl(edge: Edge) -> Bool {
  match edge.label {
    Named { name: _ } =>
      match edge.target.kind {
        TypeNode { connective: Arrow } => true
        _ => false
      }
    Positional => false
  }
}

fn produced_decl_node_for_edge(edge: Edge) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [edge]
  )
}

fn produced_decl_conjs_in_children(
  children: FreeMonoid<Edge>,
  acc: FreeMonoid<Node>
) -> FreeMonoid<Node> {
  match children {
    Empty => acc
    Cons { head: e, tail: rest } =>
      produced_decl_conjs_in_children(
        children: rest,
        acc: if produced_decl_edge_is_decl(edge: e) {
          list_snoc_item(xs: acc, item: produced_decl_node_for_edge(edge: e))
        } else {
          produced_decl_conjs_in_children(children: e.target.children, acc: acc)
        }
      )
  }
}

fn produced_decl_conjs_in_tree(root: Node) -> FreeMonoid<Node> {
  produced_decl_conjs_in_children(children: root.children, acc: Empty)
}



// EVERY DIRECT MEMBER OF A MODULE BODY HAS EXACTLY ONE TARGET REALIZATION OR ONE TYPED REFUSAL.
// The class is decided once, here, from the member's own declaration edge -- never from target
// syntax, and never by filtering: a member no class renders refuses the whole module, located at that
// member, so `fn add` beside an unrenderable declaration is never published alone. A bodied Arrow
// renders through the target's produced-declaration rows (emit_produced_decl); a coproduct -- a plain
// Disj, which only a coproduct lowers to -- renders through the existing semantic-declaration emitter
// (v2.compiler.emit_semantic_decl emit_semantic_type_decl). A plain Conj member is NOT classified: after
// lowering a record and a where-refinement share that shape (v2.compiler.body_lowering_fold
// body_lower_record_type_decl), and the record/refinement fact rides on NormalizedTree
// record_declarations, which does not reach this stage; reading it back from shape would be the
// heuristic that note forbids, so both refuse until that fact is carried here. An alias, a bodyless
// declaration and a generic declaration refuse under their own reasons: no target realization exists
// for them yet, and each refusal names that capability rather than a whole-module failure.
type ModuleMemberClass
  = ModuleMemberBodiedArrow
  | ModuleMemberBodylessArrow
  | ModuleMemberCoproduct { name: Symbol, coproduct: Node }
  | ModuleMemberRecordOrRefinement
  | ModuleMemberAlias
  | ModuleMemberOpaque
  | ModuleMemberGeneric
  | ModuleMemberUnsupported

fn module_member_class(edge: Edge) -> ModuleMemberClass {
  match edge.label {
    Positional => ModuleMemberUnsupported
    Named { name: n } =>
      match edge.target.kind {
        TypeNode { connective: Arrow } =>
          match find_arrow_body_child(root: edge.target) {
            Accepted { value: _, diagnostics: _ } => ModuleMemberBodiedArrow
            Rejected { diagnostics: _ } => ModuleMemberBodylessArrow
          }
        _ =>
          match type_decl_view(target: edge.target) {
            TypeAlias { binders: _, aliased: _ } => ModuleMemberAlias
            OpaqueTypeDecl { binders: _ } => ModuleMemberOpaque
            GenericTypeDecl { binders: _, member: _ } => ModuleMemberGeneric
            PlainTypeDecl { member: m } =>
              match m.kind {
                TypeNode { connective: Disj } => ModuleMemberCoproduct { name: n, coproduct: m }
                TypeNode { connective: Conj } => ModuleMemberRecordOrRefinement
                _ => ModuleMemberUnsupported
              }
          }
      }
  }
}

fn emit_module_member_refused(reason: Symbol, at: Node) -> Outcome<Medium<String>> {
  outcome_rejected(d: emit_produced_decl_diagnostic(reason: reason, node: at))
}

fn emit_module_member(edge: Edge, target: TargetModel) -> Outcome<Medium<String>> {
  match module_member_class(edge: edge) {
    ModuleMemberBodiedArrow => emit_produced_decl(decl: produced_decl_node_for_edge(edge: edge), target: target)
    ModuleMemberCoproduct { name: n, coproduct: c } => emit_semantic_type_decl(name: n, params: [], node: c, target: target)
    ModuleMemberBodylessArrow => emit_module_member_refused(reason: ^emit_module_member_arrow_has_no_body, at: edge.target)
    ModuleMemberRecordOrRefinement => emit_module_member_refused(reason: ^emit_module_member_record_or_refinement_undecided, at: edge.target)
    ModuleMemberAlias => emit_module_member_refused(reason: ^emit_module_member_alias_not_realized, at: edge.target)
    ModuleMemberOpaque => emit_module_member_refused(reason: ^emit_module_member_opaque_not_realized, at: edge.target)
    ModuleMemberGeneric => emit_module_member_refused(reason: ^emit_module_member_generic_not_realized, at: edge.target)
    ModuleMemberUnsupported => emit_module_member_refused(reason: ^emit_module_member_unsupported, at: edge.target)
  }
}

fn produced_module_edge_is_production_marker(edge: Edge) -> Bool {
  match edge.label {
    Named { name: n } => n == ^grammar_production_identity_node_projection
    Positional => false
  }
}

// A module body's members in source order: its direct children, less the production marker the graft
// stamps on every body. Never a recursive walk -- a record's fields, a coproduct's alternatives and an
// arrow body's inner arrows are not module members.
fn module_body_member_edges(body: Node) -> List<Edge> {
  fold(body.children, init: [], f: fn(acc, e) {
    if produced_module_edge_is_production_marker(edge: e) { acc } else { list_snoc_item(xs: acc, item: e) }
  })
}

fn module_bodies_in_tree(node: Node, acc: List<Node>) -> List<Node> {
  if namespace_graft_node_is_module_body(node: node) {
    list_snoc_item(xs: acc, item: node)
  } else {
    fold(node.children, init: acc, f: fn(a, e) { module_bodies_in_tree(node: e.target, acc: a) })
  }
}

// A TREE IS RENDERED AS A MODULE WHEN IT HOLDS AT LEAST ONE MODULE BODY AND EVERY BODY DECLARES AT
// LEAST ONE MEMBER. Whether each member RENDERS is not asked here: the member fold below is the one
// authority for that, and it refuses on the first member it cannot realize, so there is no preflight
// classifier beside the renderer to disagree with it. A module declaring nothing keeps the other
// route, where the type-expression translate refuses it typed and located
// (`translate_module_not_a_type_expression`) rather than publishing zero bytes as a program -- the
// absence v2.compiler.self_host.candidate_generation refuses as `rust_module_emission_decl_absent`.
fn produced_module_bodies_declare_members(root: Node) -> Bool {
  let bodies = module_bodies_in_tree(node: root, acc: [])
  (count(bodies) > 0)
    && fold(bodies, init: true, f: fn(acc, b) { acc && (count(module_body_member_edges(body: b)) > 0) })
}

// Every module body's members, in order, each through its one realization; the first refusal refuses
// the module with nothing partial published.
fn emit_module_body_members(root: Node, target: TargetModel) -> Outcome<Medium<String>> {
  let members = fold(module_bodies_in_tree(node: root, acc: []), init: [], f: fn(acc, b) {
    concat(acc, module_body_member_edges(body: b))
  })
  bind_outcome(
    o: fold_list(
      xs: members,
      empty: Accepted { value: "", diagnostics: None },
      cons: fn(acc, edge) {
        bind_outcome(
          o: acc,
          f: fn(partial) {
            bind_outcome(
              o: emit_module_member(edge: edge, target: target),
              f: fn(medium) {
                Accepted { value: concat(partial, medium.carried, emit_module_decl_separator), diagnostics: None }
              }
            )
          }
        )
      }
    ),
    f: fn(joined) { target_source_medium(text: joined, target: target) }
  )
}

fn emit_produced_decl_with_target(
  decl: Node,
  target: TargetModel
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: emit_produced_decl_inner_arrow(decl: decl),
    f: fn(arrow) {
      bind_outcome(
        o: target_serialize_bodied_arrow_from_model(target: target, emitted: arrow),
        f: fn(text) {
          target_source_medium(text: render_target_text(t: text), target: target)
        }
      )
    }
  )
}

// The compiler reads the TARGET's declared rendering rows and folds them into a
// bodied-arrow scaffold. It does not know whether the signature leads with a keyword or
// a return type, which side of a parameter the type sits on, whether a return arrow
// exists, or how the declaration closes -- every one of those is a row the target
// declares. A target that registered no rows refuses with a typed, located
// produced_decl_target_unwired:
// never a widen, never a fabricated default (DESIGN section 5).
fn emit_produced_decl(decl: Node, target: TargetModel) -> Outcome<Medium<String>> {
  match target.produced_decl_support {
    ProducedDeclUnwired =>
      outcome_rejected(
        d: emit_produced_decl_diagnostic(reason: ^produced_decl_target_unwired, node: decl)
      )
    ProducedDeclWired {
      render_rows: rows,
      scaffold_relation_rule_name: rule_name,
      scaffold_base_row: base_row
    } =>
      bind_outcome(
        o: produced_decl_render_from_rows(rows: rows, decl: decl),
        f: fn(scaffold) {
          emit_produced_decl_with_target(
            decl: decl,
            target: target_model_with_produced_scaffold(
              target: target,
              rule_name: rule_name,
              base_row: base_row,
              scaffold: scaffold
            )
          )
        }
      )
  }
}

fn emit_produced_module_append(
  partial: String,
  decl: Node,
  target: TargetModel
) -> Outcome<String> {
  bind_outcome(
    o: emit_produced_decl(decl: decl, target: target),
    f: fn(medium) {
      Accepted {
        value: concat(partial, medium.carried, emit_module_decl_separator),
        diagnostics: None
      }
    }
  )
}

fn emit_produced_module_step(
  acc: Outcome<String>,
  decl: Node,
  target: TargetModel
) -> Outcome<String> {
  bind_outcome(
    o: acc,
    f: fn(partial) {
      emit_produced_module_append(partial: partial, decl: decl, target: target)
    }
  )
}

// A SUPPLIED DECLARATION LIST, NOT A MODULE. This fold renders the arrow declarations its caller hands
// it (v2.workflow.realization_attempt and the emit-host fixtures build their own lists); what a MODULE
// emits to is emit_module_body_members, the one module authority both emission paths call.
// THE JOIN IS `concat` OVER A "" SEED, NOT `list_append` OVER `Empty`, and the difference is not
// cosmetic. Built by list_append from the FreeMonoid variant, the fold's result carries the
// CONS-LIST SPELLING of a string rather than the native one: `==` and `concat` still behave, which
// is why every golden over this fold stayed green for as long as goldens were all that read it --
// but a builtin that requires a native string REFUSES it. Measured 2026-09-10 as `split expects a
// string, got Variant` from v2.test.self_host.stage0_production_target's two contains-controls,
// the first consumers to read this fold's output through `split`. Nothing on the production door
// reached this fold until the door started routing every nonempty population through it, so the
// defect was latent rather than new, and the equality-only readers could never have found it.
// One representation for one concept (DESIGN section 3): a String is a String, not a FreeMonoid
// that happens to compare equal to one.
fn emit_produced_module(decls: List<Node>, target: TargetModel) -> Outcome<Medium<String>> {
  bind_outcome(
    o: fold_list(
      xs: decls,
      empty: Accepted { value: "", diagnostics: None },
      cons: fn(acc, decl) { emit_produced_module_step(acc: acc, decl: decl, target: target) }
    ),
    f: fn(joined) { target_source_medium(text: joined, target: target) }
  )
}
