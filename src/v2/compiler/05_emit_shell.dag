  bash_word_pass_target_model,
  bash_word_cmdsubst_emitted,
  bash_word_cmdsubst_target_model,
  bash_stmt_subshell_emitted,
  bash_stmt_subshell_target_model,
  bash_stmt_exit_emitted,
  bash_stmt_exit_target_model,
  bash_stmt_assign_emitted,
  bash_stmt_assign_target_model,
  bash_stmt_andor_emitted,
  bash_stmt_andor_target_model,
  bash_stmt_pipe_emitted,
  bash_stmt_pipe_target_model,
  bash_stmt_with_redir_emitted,
  bash_stmt_with_redir_target_model,
  bash_stmt_env_prefixed_emitted,
  bash_stmt_env_prefixed_target_model,
  bash_stmt_env_unset_emitted,
  bash_stmt_env_unset_target_model,
  bash_stmt_if_emitted,
  bash_stmt_if_target_model,
  bash_stmt_heredoc_emitted,
  bash_stmt_heredoc_target_model,
  bash_program_set_e_emitted,
  bash_program_set_e_target_model,
  bash_stmt_negation_emitted,
  bash_stmt_negation_target_model,
  bash_single_quote,
  bash_var_ref_spelling
}
import extdeps.languages.bash.program {
  ShellWord,
  Lit,
  VarRef,
  Concat,
  CmdSubst,
  Raw,
  ShellStmt,
  Command,
