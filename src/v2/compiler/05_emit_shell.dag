fn emit_and_or_op_spelling(op: AndOrOp) -> String {
  match op {
    AndThen => "&&"
    OrElse => "||"
  }
}

fn emit_redir(r: Redir) -> Outcome<Medium<String>> {
  match r {
    StderrToNull => outcome_accepted(lossless_source(text: "2>/dev/null"))
    StdoutAndStderrToNull => outcome_accepted(lossless_source(text: ">/dev/null 2>&1"))
    StdoutToStderr => outcome_accepted(lossless_source(text: ">&2"))
    RedirToFile { path: p } =>
      bind_outcome(o: emit_shell_word(w: p), f: fn(mp) {
        outcome_accepted(lossless_source(text: concat("> ", mp.carried)))
      })
  }
}

fn emit_join_step(acc: String, first: Bool, part: String) -> String {
  if first { part } else { concat(acc, concat(" ", part)) }
}

fn emit_join_words_from(acc: String, first: Bool, rest: List<ShellWord>) -> Outcome<Medium<String>> {
  match list_head(xs: rest) {
    HeadAbsent => outcome_accepted(lossless_source(text: acc))
    HeadFound { value: w } =>
      match emit_shell_word(w: w) {
        Accepted { value: m, diagnostics: _ } =>
          match list_tail(xs: rest) {
            TailFound { tail: t } =>
              emit_join_words_from(acc: emit_join_step(acc: acc, first: first, part: m.carried), first: false, rest: t)
            TailAbsent =>
              outcome_accepted(lossless_source(text: emit_join_step(acc: acc, first: first, part: m.carried)))
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}

fn emit_join_semi_step(acc: String, first: Bool, part: String) -> String {
  if first { part } else { concat(acc, concat("; ", part)) }
}

fn emit_join_stmts_semi_from(acc: String, first: Bool, rest: List<ShellStmt>) -> Outcome<Medium<String>> {
  match list_head(xs: rest) {
    HeadAbsent => outcome_accepted(lossless_source(text: acc))
    HeadFound { value: s } =>
      match emit_shell_stmt(s: s) {
        Accepted { value: m, diagnostics: _ } =>
          match list_tail(xs: rest) {
            TailFound { tail: t } =>
              emit_join_stmts_semi_from(acc: emit_join_semi_step(acc: acc, first: first, part: m.carried), first: false, rest: t)
            TailAbsent =>
              outcome_accepted(lossless_source(text: emit_join_semi_step(acc: acc, first: first, part: m.carried)))
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}

fn emit_program_set_e(body: String) -> Outcome<Medium<String>> {
  emit(
    tree: InferredTree {
      root: bash_program_set_e_emitted,
      facts: Map { lookup: shell_emit_facts_lookup }
    },
    target: bash_program_set_e_target_model(body: body)
  )
}

fn emit_program_body_from(acc: String, rest: List<ShellStmt>) -> Outcome<Medium<String>> {
  match list_head(xs: rest) {
    HeadAbsent => outcome_accepted(lossless_source(text: acc))
    HeadFound { value: s } =>
      match emit_shell_stmt(s: s) {
        Accepted { value: m, diagnostics: _ } =>
          match list_tail(xs: rest) {
            TailFound { tail: t } =>
              emit_program_body_from(acc: concat(acc, concat(m.carried, "\n")), rest: t)
            TailAbsent =>
              outcome_accepted(lossless_source(text: concat(acc, concat(m.carried, "\n"))))
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}

fn emit_shell_program(p: ShellProgram) -> Outcome<Medium<String>> {
  bind_outcome(o: emit_program_body_from(acc: "", rest: p.statements), f: fn(mb) {
    if p.set_e {
      emit_program_set_e(body: mb.carried)
    } else {
      outcome_accepted(lossless_source(text: mb.carried))
    }
  })
}

fn emit_shell_stmt(s: ShellStmt) -> Outcome<Medium<String>> {
  match s {
    Command { words: ws } =>
      bind_outcome(o: emit_join_words_from(acc: "", first: true, rest: ws), f: fn(m) {
        emit_word_pass(spelling: m.carried)
      })
    Subshell { body: b } =>
      bind_outcome(o: emit_join_stmts_semi_from(acc: "", first: true, rest: b), f: fn(m) {
        emit_stmt_subshell(body: m.carried)
      })
    Exit { code: c } => emit_stmt_exit(code: to_string(c))
    RawLine { text: t } => emit_word_pass(spelling: t)
    Assign { name: n, value: v } =>
      bind_outcome(o: emit_shell_word(w: v), f: fn(mv) {
        emit_stmt_assign(name: n, value: mv.carried)
      })
    If { cond: c, then: body } =>
      bind_outcome(o: emit_shell_stmt(s: c), f: fn(mc) {
        bind_outcome(o: emit_join_stmts_semi_from(acc: "", first: true, rest: body), f: fn(mb) {
          emit_stmt_if(cond: mc.carried, body: mb.carried)
        })
      })
    BraceGroup { body: _ } =>
      outcome_rejected(shell_emit_unsupported(reason: ^emit_shell_stmt_bracegroup_uninhabited))
    AndOr { left: l, op: o, right: r } =>
      bind_outcome(o: emit_shell_stmt(s: l), f: fn(ml) {
        bind_outcome(o: emit_shell_stmt(s: r), f: fn(mr) {
          emit_stmt_andor(left: ml.carried, op: emit_and_or_op_spelling(op: o), right: mr.carried)
        })
      })
    Pipe { left: l, right: r } =>
      bind_outcome(o: emit_shell_stmt(s: l), f: fn(ml) {
        bind_outcome(o: emit_shell_stmt(s: r), f: fn(mr) {
          emit_stmt_pipe(left: ml.carried, right: mr.carried)
        })
      })
    EnvPrefixed { name: n, value: v, command: c } =>
      bind_outcome(o: emit_shell_word(w: v), f: fn(mv) {
        bind_outcome(o: emit_shell_stmt(s: c), f: fn(mc) {
          emit_stmt_env_prefixed(name: n, value: mv.carried, command: mc.carried)
        })
      })
    EnvUnsetCmd { name: n, command: c } =>
      bind_outcome(o: emit_shell_stmt(s: c), f: fn(mc) {
        emit_stmt_env_unset(name: n, command: mc.carried)
      })
    WithRedir { stmt: st, redir: rd } =>
      bind_outcome(o: emit_shell_stmt(s: st), f: fn(mst) {
        bind_outcome(o: emit_redir(r: rd), f: fn(mr) {
          emit_stmt_with_redir(stmt: mst.carried, redir: mr.carried)
        })
      })
    Negation { stmt: inner } =>
      bind_outcome(o: emit_shell_stmt(s: inner), f: fn(mi) {
        emit_stmt_negation(inner: mi.carried)
      })
    Heredoc { path: p, delimiter: d, body: b } =>
      bind_outcome(o: emit_shell_word(w: p), f: fn(mp) {
        emit_stmt_heredoc(path: mp.carried, delimiter: d, body: b)
      })
  }
}
