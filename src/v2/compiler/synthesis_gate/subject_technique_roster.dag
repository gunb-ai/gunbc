// Scope: synthesis-gate S1 — the real compiler subjects the synthesis lens reads
//        compiler-wide, each paired with the lower-bound TECHNIQUE its declared relation
//        class is subject to. The lower bound itself is DERIVED inside synthesis_lens
//        (decision_tree_declared_bound / information_theoretic_declared_bound) — the row
//        carries only what the caller DECLARES (the technique), never a duplicate
//        DeclaredRelationBound (single authority).
//
// Layer: this is a v2.test.synthesis_gate.* module (the gate/corpus layer), so importing
//        the COMPREP wave-1 producers (v2.test.complexity_gate.*) is legal gate→gate reuse
//        of the single shared subject-supply authority — NOT a second producer pipeline.
//        The synthesis LENS (v2.lens.synthesis) never imports this; the edge runs gate→lens.
//
// Coverage: the COMPREP wave-1 corpus (add / bind / branch / loop), mirroring the
//        complexity-gate roster shape (subject_complexity_budget_roster.dag).

module v2.test.synthesis_gate.subject_technique_roster

import v2.lens.synthesis { DecisionTree, LowerBoundTechnique }
import v2.std.collection { List }
import v2.std.diagnostic { Outcome }
import v2.std.node { Node }
import v2.test.complexity_gate.comprep_wave1_add_subject_producer {
  comprep_source_bridged_add_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_bind_subject_producer {
  comprep_source_bridged_bind_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_branch_subject_producer {
  comprep_source_bridged_pick_if_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_loop_subject_producer {
  comprep_source_bridged_loop_arrow_with_body
}

type SynthesisSubjectRow {
  subject_producer: fn() -> Outcome<Node>
  declared_technique: LowerBoundTechnique
}

data synthesis_subject_row_add: SynthesisSubjectRow = SynthesisSubjectRow {
  subject_producer: comprep_source_bridged_add_arrow_with_body,
  declared_technique: DecisionTree
}

data synthesis_subject_row_bind: SynthesisSubjectRow = SynthesisSubjectRow {
  subject_producer: comprep_source_bridged_bind_arrow_with_body,
  declared_technique: DecisionTree
}

data synthesis_subject_row_branch: SynthesisSubjectRow = SynthesisSubjectRow {
  subject_producer: comprep_source_bridged_pick_if_arrow_with_body,
  declared_technique: DecisionTree
}

data synthesis_subject_row_loop: SynthesisSubjectRow = SynthesisSubjectRow {
  subject_producer: comprep_source_bridged_loop_arrow_with_body,
  declared_technique: DecisionTree
}

data synthesis_subject_rows: List<SynthesisSubjectRow> = [
  synthesis_subject_row_add,
  synthesis_subject_row_bind,
  synthesis_subject_row_branch,
  synthesis_subject_row_loop
]
