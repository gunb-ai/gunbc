// Scope: synthesis-gate S2 — roster-row subject acquisition + canonical body extraction.
//        The row already carries its producer, so acquisition is a direct invocation +
//        node_query body extraction — no producer discriminator (the row IS the dispatch;
//        a hand-rolled `==` chain over the same field would be redundant work, §2, and a
//        new row could only mis-route through a dead "unsupported" arm rather than failing
//        closed at typecheck). A producer that itself rejects threads its diagnostic.

module v2.test.synthesis_gate.synthesis_subject_body_supply

import v2.std.diagnostic { Outcome, bind_outcome }
import v2.std.node { Node }
import v2.std.node_query { find_arrow_body_child }
import v2.test.synthesis_gate.subject_technique_roster {
  SynthesisSubjectRow
}

fn synthesis_arrow_body_for_row(row: SynthesisSubjectRow) -> Outcome<Node> {
  bind_outcome(
    o: row.subject_producer(),
    f: fn(arrow) {
      find_arrow_body_child(root: arrow)
    }
  )
}
