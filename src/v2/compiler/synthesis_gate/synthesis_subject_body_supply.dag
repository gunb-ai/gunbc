// Scope: synthesis-gate S2 — roster-row subject acquisition + canonical body extraction,
//        mirroring complexity_gate/lens_subject_body_supply.dag. Dispatches a row to its
//        COMPREP wave-1 producer (the single shared subject-supply authority) and extracts
//        the arrow body via the node_query authority. An unsupported producer is a typed,
//        located rejection (fail-closed) — never a silent empty body.

module v2.test.synthesis_gate.synthesis_subject_body_supply

import v2.std.diagnostic {
  ExternalContractUnknown,
  Outcome,
  Textual,
  Unavailable,
  WholeFile,
  bind_outcome,
  diagnostics_singleton,
  outcome_rejected
}
import v2.std.node { Node, Symbol }
import v2.std.node_query { find_arrow_body_child }
import v2.test.complexity_gate.comprep_wave1_add_subject_producer {
  comprep_source_bridged_add_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_bind_subject_producer {
  comprep_source_bridged_bind_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_branch_subject_producer {
  comprep_source_bridged_pick_if_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_loop_subject_producer {
  comprep_source_bridged_loop_arrow_with_body
}
import v2.test.synthesis_gate.subject_technique_roster {
  SynthesisSubjectRow
}

fn synthesis_arrow_body_for_row(row: SynthesisSubjectRow) -> Outcome<Node> {
  if row.subject_producer == comprep_source_bridged_add_arrow_with_body {
    bind_outcome(
      o: comprep_source_bridged_add_arrow_with_body(),
      f: fn(arrow) {
        find_arrow_body_child(root: arrow)
      }
    )
  } else if row.subject_producer == comprep_source_bridged_bind_arrow_with_body {
    bind_outcome(
      o: comprep_source_bridged_bind_arrow_with_body(),
      f: fn(arrow) {
        find_arrow_body_child(root: arrow)
      }
    )
  } else if row.subject_producer == comprep_source_bridged_pick_if_arrow_with_body {
    bind_outcome(
      o: comprep_source_bridged_pick_if_arrow_with_body(),
      f: fn(arrow) {
        find_arrow_body_child(root: arrow)
      }
    )
  } else if row.subject_producer == comprep_source_bridged_loop_arrow_with_body {
    bind_outcome(
      o: comprep_source_bridged_loop_arrow_with_body(),
      f: fn(arrow) {
        find_arrow_body_child(root: arrow)
      }
    )
  } else {
    outcome_rejected(
      d: diagnostics_singleton(
        reason: ^synthesis_subject_producer_unsupported,
        at: Textual { file: ^synthesis_subject_body_supply_virtual_file, extent: WholeFile },
        correction: Unavailable { reason: ExternalContractUnknown }
      )
    )
  }
}
