// Scope: synthesis-gate S3 — ADVISORY family fold over the synthesis subject roster.
//        For each real COMPREP wave-1 subject: subject-supply → arrow body → synthesis_lens
//        under the row's declared technique → advisory List<Report>. The corpus advisory
//        artifact is synthesis_corpus_reports(); the gate is fail-closed (empty roster →
//        false, anti-vacuity; lens_parallelism_family_gate precedent) and carries a
//        semantic-red FIRING control so it is never vacuously green.
//
// Posture: ADVISORY only (List<Report>, AdvisoryLens carrier) — never a hard CompileLens
//        gate. feedback_no_engine (synthesis.dag) forbids constructing the faster program,
//        and an existence-style lower bound yields no constructive patch, so a diagnose-only
//        optimality hard gate would violate DESIGN §5 (correct ≠ optimal). LowerBoundTechnique
//        is a closed 5-set — STOP-and-escalate before a 6th.
//
// HONESTY CAVEAT (cost-authority limitation, NOT a lens defect — confirmed by jolly-bear-882
// 2026-06-17): "zero gaps over real code" was NEAR-VACUOUS while a loop over a zero-cost body
// projected CONSTANT — the loop fold scales the iteration count by the body via
// IterativeCost = symbolic_product, and symbolic_product's (correct) absorbing zero annihilated
// the linear factor. Fixed in cost.dag with an ADDITIVE per-iteration floor at the loop layer
// (compose_child_cost IterativeCost = symbolic_product(acc, symbolic_sequential(child, unit_cost())),
// so an empty body still costs O(n)); symbolic_product KEEPS absorbing zero. Real wave-1 bodies
// now project non-constant complexity where warranted. The synthetic control below still keeps
// the gate non-vacuous when the real corpus is optimal.

module v2.test.synthesis_gate.optimality_gap_completeness

import v2.lens.synthesis {
  DecisionTree,
  InformationTheoretic,
  synthesis_lens,
  synthesis_lens_diagnostics
}
import v2.std.algebra { Empty, fold_list, is_empty, list_append, non_empty }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.report { Report }
import v2.test.lens_synthesis.synthesis_gap_polynomial {
  synthesis_gap_poly_input
}
import v2.test.synthesis_gate.subject_technique_roster {
  SynthesisSubjectRow,
  synthesis_subject_row_add,
  synthesis_subject_rows
}
import v2.test.synthesis_gate.synthesis_subject_body_supply {
  synthesis_arrow_body_for_row
}

// True iff the row's body is acquirable (the real pipeline produced a subject). The gate
// requires this for every row — a broken pipeline is fail-closed RED, not a silent pass.
fn synthesis_row_acquired(row: SynthesisSubjectRow) -> Bool {
  match synthesis_arrow_body_for_row(row: row) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn synthesis_real_rows_all_acquired() -> Bool {
  fold_list(
    xs: synthesis_subject_rows,
    empty: true,
    cons: fn(acc, row) {
      acc && synthesis_row_acquired(row: row)
    }
  )
}

// Advisory Reports the synthesis lens surfaces for one real subject under its declared
// technique. An unacquirable body contributes no reports (acquisition is gated separately
// by synthesis_real_rows_all_acquired — fail-closed there, not here).
fn synthesis_row_reports(row: SynthesisSubjectRow) -> List<Report> {
  match synthesis_arrow_body_for_row(row: row) {
    Accepted { value: body, diagnostics: _ } =>
      synthesis_lens(n: body, declared_technique: row.declared_technique)
    Rejected { diagnostics: _ } => Empty
  }
}

// THE advisory artifact: every optimality-gap Report across the real wave-1 corpus.
fn synthesis_corpus_reports() -> List<Report> {
  fold_list(
    xs: synthesis_subject_rows,
    empty: Empty,
    cons: fn(acc, row) {
      list_append(left: acc, right: synthesis_row_reports(row: row))
    }
  )
}

// Real corpus is OPTIMAL: bodies acquire AND no gap fires (no false positives compiler-wide).
fn synthesis_real_corpus_optimal() -> Bool {
  synthesis_real_rows_all_acquired() && is_empty(xs: synthesis_corpus_reports())
}

// InformationTheoretic over a real (sub-linear) subject routes through the honest no-engine
// diagnostic channel — SynthesisNoTechnique, never a fabricated gap.
fn synthesis_real_information_theoretic_no_technique() -> Bool {
  match synthesis_arrow_body_for_row(row: synthesis_subject_row_add) {
    Accepted { value: body, diagnostics: _ } =>
      non_empty(synthesis_lens_diagnostics(n: body, declared_technique: InformationTheoretic))
    Rejected { diagnostics: _ } => false
  }
}

// Semantic-red FIRING control: a synthetic realization that EXCEEDS the DecisionTree lower
// bound → the gap FIRES (non-empty). Proves the lens is not vacuously green. A real relation
// with a provable gap would be fabrication (feedback_no_engine), so this control is synthetic.
fn synthesis_synthetic_gap_fires() -> Bool {
  non_empty(synthesis_lens(n: synthesis_gap_poly_input, declared_technique: DecisionTree))
}

// By-execution ADVISORY gate: fail-closed family fold (empty roster → false, never vacuous
// green); the real corpus surfaces no gap, the InformationTheoretic channel is honest, and
// the synthetic control fires.
fn synthesis_optimality_family_gate() -> Bool {
  if is_empty(xs: synthesis_subject_rows) {
    false
  } else {
    synthesis_real_corpus_optimal()
      && synthesis_real_information_theoretic_no_technique()
      && synthesis_synthetic_gap_fires()
  }
}
