  },
  SeamStanding {
    declaration: "export_signature_facts",
    seam_module: "v2.std.decl_index",
    projection: ProjectedPrimitive { primitive: primitive_identity_slug(name: "export_signature_facts") },
    emitted_rust_identity: "v2_std_decl_index.rs::export_signature_facts",
