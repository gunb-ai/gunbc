// THE CORPUS ENTRY FOR v2.compiler.reference_conservation: the host reads the file, the pure check
// does everything else. It is kept out of the check's own module so the check stays a pure
// function of its read witness, which is what lets the fixture controls exercise the exact code the
// census runs.
//
// ONE PATH LIST PER PROCESS, AND THE LINES ARE THE VALUE. The driver (`gunbc run --function
// reference_conservation_census_for_paths --arg <csv>`) prints the returned String; a batch is a
// comma-separated path list sized by the driver so no single process holds the whole corpus. The
// same shape as v2.lens.complexity_accumulator_copy.corpus_census census_tsv_line_for_path, and for
// the same recorded reason: a whole-corpus fold in one process is the load this route exists to
// avoid. An unreadable path is its own line, never an omission.

// WHAT ONE LISTED PATH YIELDED, TYPED. A path the list names but the tree no longer has is
// SamplePathMissing -- its own disposition, never an omission and never a zero report -- because a
// pinned sample whose members silently vanish reports on a smaller population than it claims.
type SamplePathObservation
  = SamplePathMeasured { report: ReferenceConservationReport }
  | SamplePathMissing { path: String }
  | SamplePathGrammarUnprepared { path: String }

fn reference_conservation_path_observation(path: String) -> SamplePathObservation {
  let read = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: _ } => SamplePathMissing { path: path }
    FilesystemReadSucceeded { content: text } =>
      match dag_prepared_grammar() {
        Rejected { diagnostics: _ } => SamplePathGrammarUnprepared { path: path }
        Accepted { value: prepared, diagnostics: residue } =>
          SamplePathMeasured {
            report: reference_conservation_of_read(
              read: conservation_read_of(path: path, text: text),
              lm: dag_language_model(),
              prepared: prepared,
              residue: residue
            )
          }
      }
  }
}

fn sample_path_observation_text(observation: SamplePathObservation) -> String {
  match observation {
    SamplePathMissing { path: p } => "missing " + p + "\n"
    SamplePathGrammarUnprepared { path: p } => "grammar-unprepared " + p + "\n"
    SamplePathMeasured { report: r } =>
      fold_list(xs: reference_conservation_report_lines(report: r), empty: "", cons: fn(acc, line) { acc + line + "\n" })
  }
}

fn reference_conservation_census_for_path(path: String) -> String {
  sample_path_observation_text(observation: reference_conservation_path_observation(path: path))
}

fn reference_conservation_census_for_paths(paths_csv: String) -> String {
  fold_list(
    xs: split(s: paths_csv, delimiter: ","),
    empty: "",
    cons: fn(acc, path) { acc + reference_conservation_census_for_path(path: path) }
  )
}

// THE CHANGED-SCOPE ENTRY (MQ-6). The host hands the change's path list (for a PR, the files
// `git diff --name-only <base>...<head>` names; a deleted path is its own unreadable line) and this
// reads each one, lets v2.compiler.reference_conservation_admission changed_scope_observation decide
// which are in the body-lowering scope from their own imports, and renders the typed observation. The
// first line is the verdict; one line per path follows, and a refused path carries one line per
// refusal, so the observation is reviewable without re-running it.
fn changed_scope_read_inputs(paths_csv: String) -> ChangedScopeReadInputs {
  fold_list(
    xs: split(s: paths_csv, delimiter: ","),
    empty: ChangedScopeReadInputs { inputs: Empty, unreadable: Empty },
    cons: fn(acc, path) {
      let read = Filesystem.Read(path: path)
      match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
        FilesystemReadRefused { error: _ } => ChangedScopeReadInputs { inputs: acc.inputs, unreadable: list_snoc_item(xs: acc.unreadable, item: path) }
        FilesystemReadSucceeded { content: text } =>
          ChangedScopeReadInputs { inputs: list_snoc_item(xs: acc.inputs, item: ChangedScopeReadInput { path: path, text: text }), unreadable: acc.unreadable }
      }
    }
  )
}

type ChangedScopeReadInputs {
  inputs: FreeMonoid<ChangedScopeReadInput>
  unreadable: FreeMonoid<String>
}

fn changed_scope_row_lines(rows: FreeMonoid<ChangedScopeRow>) -> String {
  fold_list(
    xs: rows,
    empty: "",
    cons: fn(acc, row) {
      match row {
        ScopeOutside { path: p } => acc + "outside " + p + "\n"
        ScopeMembershipUnreadable { path: p, diagnostics: d } => acc + "membership-unreadable " + p + " " + symbol_lexeme(sym: d.head.reason) + "\n"
        ScopeConserved { path: p, report: r } =>
          fold_list(xs: reference_conservation_report_lines(report: r), empty: acc + "conserved " + p + "\n", cons: fn(a, line) { a + "  " + line + "\n" })
        ScopeDropped { path: p, report: r, refusals: _ } =>
          fold_list(xs: reference_conservation_report_lines(report: r), empty: acc + "dropped " + p + "\n", cons: fn(a, line) { a + "  " + line + "\n" })
      }
    }
  )
}

fn changed_scope_verdict_line(observation: ChangedScopeConservationObservation) -> String {
  match observation {
    NoBodyLoweringChange { rows: _ } => "observation no-body-lowering-change"
    ChangedScopeObservedConserved { rows: _, in_scope: n } => "observation conserved in_scope=" + integer_int_to_decimal_string(value: n)
    ChangedScopeObservedDropped { rows: _, in_scope: n, refused: k } =>
      "observation dropped in_scope=" + integer_int_to_decimal_string(value: n) + " refused=" + integer_int_to_decimal_string(value: k)
  }
}

fn changed_scope_observation_rows(observation: ChangedScopeConservationObservation) -> FreeMonoid<ChangedScopeRow> {
  match observation {
    NoBodyLoweringChange { rows: r } => r
    ChangedScopeObservedConserved { rows: r, in_scope: _ } => r
    ChangedScopeObservedDropped { rows: r, in_scope: _, refused: _ } => r
  }
}

// An unreadable path refuses the observation outright: a change's scope that could not be read is not
// a change that reached no body-lowering module.
type ChangedScopeRun {
  conserved: Bool
  text: String
}

fn changed_scope_run(paths_csv: String) -> ChangedScopeRun {
  let read = changed_scope_read_inputs(paths_csv: paths_csv)
  let observation = changed_scope_observation(inputs: read.inputs)
  let rows = changed_scope_row_lines(rows: changed_scope_observation_rows(observation: observation))
  match read.unreadable {
    Empty => ChangedScopeRun { conserved: changed_scope_observation_conserves(observation: observation), text: changed_scope_verdict_line(observation: observation) + "\n" + rows }
    Cons { head: _, tail: _ } =>
      ChangedScopeRun {
        conserved: false,
        text: "observation refused-unreadable\n" + fold_list(xs: read.unreadable, empty: "", cons: fn(acc, p) { acc + "unreadable " + p + "\n" }) + rows
      }
  }
}

// The rendered observation, for a reader.
fn reference_conservation_changed_scope_observation(paths_csv: String) -> String {
  changed_scope_run(paths_csv: paths_csv).text
}

// The same observation as a process verdict (`gunbc run --function
// reference_conservation_changed_scope_observation_exit --arg <csv>`): a refused observation exits non-zero and
// carries the rendered observation as its reason, so a caller cannot read a refusal as success.
fn reference_conservation_changed_scope_observation_exit(paths_csv: String) -> ProcessExit {
  let run = changed_scope_run(paths_csv: paths_csv)
  if run.conserved { ExitSuccess } else { exit_failure(reason: run.text) }
}


// THE PINNED STRATIFIED SAMPLE (XL-2; first pinned at main fec339d561, REPINNED at main 8fcd8e77b8).
// The whole-corpus census is about 55 CPU-hours on the interpreter, so the drop shapes are first
// read off this sample. The selection is a rule, not a hand pick: every `.dag` file under dag/ and
// src/v2/ is put in a stratum (its first two path segments under dag/, its first three under
// src/v2/); each stratum takes k = max(6, round(300 * the stratum's share of ALL `.dag` files))
// files -- at most as many as it has -- from its files of at most 8,000 bytes sorted by path, at
// indices floor(i * n / k) for i in 0..k-1 over those n files. Applying this rule at fec339d561
// reproduces the original 315-path list exactly, which is what fixed the one ambiguity in the
// earlier wording (the share is over all files, not over the small ones). The 8,000-byte cap bounds
// the run and biases the sample toward small files; a shape that only appears in large files is
// not in it, and the full census is what closes that gap. The list is kept here so the sample
// re-runs byte-for-byte. A listed path the tree no longer holds is reported SamplePathMissing, so a
// stale pin is visible in the census rather than a smaller population; repinning re-applies the
// rule at a named revision.
data reference_conservation_stratified_sample_paths: List<String> = [
