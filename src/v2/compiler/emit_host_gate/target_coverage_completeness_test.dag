// src/v2/compiler/emit_host_gate/target_coverage_completeness_test.dag
//
// De-vacuum (DESIGN.md §5/§6) for EmitHostGate, which executes exactly 4 host smokes
// (rust/python/go/typescript) in `dsl/tools/emit_host_gate.dag`. Those 4 were a HAND-LIST;
// nothing made them complete against the emit-target authority, so a new host-executable target
// could ship with no smoke (the §6 "machinery exists but nothing gates on it" trap).
//
// The single authority for "is this target host-executable" is NOT a second target name list —
// it is the per-language `TargetModel.runtime_row` field (`TargetEmitHostRuntimeRow`,
// std/host_transport.dag): `HostRuntimeRowPresent` ⟺ the target has a configured host transport,
// projected by `runtime_row_from_target` to Accepted/Rejected. This witness folds that authority
// over the language TargetModels and asserts each target's host-smoke coverage AGREES with its
// declared host-executability — fail-closed (empty roster → RED), RED-on-revert:
//   - flip a smoked target's runtime_row to Absent  → Rejected but host_smoked=true  → RED;
//   - flip a bounded target's runtime_row to Present → Accepted but host_smoked=false → RED
//     (a target declared host-executable that EmitHostGate does not smoke — the "declared target
//     lacks a smoke row" fail-closed tooth).
// So a language cannot acquire a host transport without forcing a matching EmitHostGate smoke,
// and a smoke cannot be silently dropped while the target stays host-executable.
//
// LOGGED RESIDUAL CAP (no silent truncation, DESIGN.md §6): the roster below is a BOUNDED
// enumeration of TargetModels, not every emit target in the tree — there is no central
// `List<TargetModel>` registry, so a brand-new language file outside this roster escapes the
// fold. Closing that to the WHOLE emit corpus needs structural enumeration of the target set,
// the same .dag structural-reflection wall named in lens/coverage.dag and lens/testgen.dag (the
// documented dissolve trigger in lens_discrimination_family_eval_test.dag). The bounded set is
// the host-present targets (the only ones EmitHostGate can smoke) PLUS representative
// host-absent targets (cpp/java) so the Present⟺smoked equivalence is pinned on both poles.
//
// SECOND RESIDUAL (decouple, honesty note): `emit_host_gate.dag` exposes NO `List<TargetModel>` —
// its 4 smokes are hand-imported `run_*_smoke()` calls — so `host_smoked` here is a HAND-CLAIM
// coupled to the actual smoke set by DISCIPLINE, not construction (this witness checks the claim
// against `runtime_row`, but cannot observe whether the dsl gate truly runs a smoke for the row).
// The construction fix that eliminates `host_smoked` entirely — have `emit_host_gate` FOLD the
// runtime_row-Present targets directly so the smoke set IS the authority — is a larger gate
// refactor, deferred. Until then the discipline coupling is the residual.

module v2.test.emit_host_gate.target_coverage_completeness

import v2.std.algebra { fold_list, is_empty }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.compilers.target_model { TargetModel, runtime_row_from_target }
import v2.extdeps.languages.rust { rust_mvp1_target_model }
import v2.extdeps.languages.python { python_mvp1_target_model }
import v2.extdeps.languages.go { go_mvp1_target_model }
import v2.extdeps.languages.typescript { ts_mvp1_target_model }
import v2.extdeps.languages.cpp { cpp_mvp1_target_model }
import v2.extdeps.languages.java { java_mvp1_target_model }

// One row per checked target: the authority object (its TargetModel) paired with whether
// EmitHostGate (dsl/tools/emit_host_gate.dag) runs a host smoke for it. `host_smoked` is the
// gate-coverage fact under test; it is never trusted on its own — the fold checks it against the
// runtime_row authority.
type EmitHostTargetCoverageRow {
  target: TargetModel
  host_smoked: Bool
}

// The 4 EmitHostGate smokes — each MUST have runtime_row Present (host-executable).
data emit_host_coverage_row_rust: EmitHostTargetCoverageRow = EmitHostTargetCoverageRow {
  target: rust_mvp1_target_model(),
  host_smoked: true
}

data emit_host_coverage_row_python: EmitHostTargetCoverageRow = EmitHostTargetCoverageRow {
  target: python_mvp1_target_model(),
  host_smoked: true
}

data emit_host_coverage_row_go: EmitHostTargetCoverageRow = EmitHostTargetCoverageRow {
  target: go_mvp1_target_model(),
  host_smoked: true
}

data emit_host_coverage_row_typescript: EmitHostTargetCoverageRow = EmitHostTargetCoverageRow {
  target: ts_mvp1_target_model(),
  host_smoked: true
}

// Bounded-out representatives — no host transport (runtime_row Absent), so correctly NOT smoked.
// These pin the Present⟺smoked equivalence on its negative pole (a constant-true `host_smoked`
// would red here; a target silently flipping to host-executable would red here too).
data emit_host_coverage_row_cpp: EmitHostTargetCoverageRow = EmitHostTargetCoverageRow {
  target: cpp_mvp1_target_model(),
  host_smoked: false
}

data emit_host_coverage_row_java: EmitHostTargetCoverageRow = EmitHostTargetCoverageRow {
  target: java_mvp1_target_model(),
  host_smoked: false
}

data emit_host_target_coverage_rows: List<EmitHostTargetCoverageRow> = [
  emit_host_coverage_row_rust,
  emit_host_coverage_row_python,
  emit_host_coverage_row_go,
  emit_host_coverage_row_typescript,
  emit_host_coverage_row_cpp,
  emit_host_coverage_row_java
]

// host-executable (runtime_row Present) ⟺ EmitHostGate smokes it.
fn emit_host_target_coverage_consistent(row: EmitHostTargetCoverageRow) -> Bool {
  match runtime_row_from_target(target: row.target) {
    Accepted { value: _, diagnostics: _ } => row.host_smoked
    Rejected { diagnostics: _ } => !row.host_smoked
  }
}

fn emit_host_all_targets_consistent() -> Bool {
  fold_list(
    xs: emit_host_target_coverage_rows,
    empty: true,
    cons: fn(acc, row) {
      acc && emit_host_target_coverage_consistent(row: row)
    }
  )
}

// Cross-check the count of host-present rows against the dsl-gate smoke count (a single number
// authority — `tools.emit_host_gate.run_emit_host_gate_body` runs exactly these 4). A 5th
// host-present target in this roster without a matching smoke flag would break the equivalence
// above AND this count.
data emit_host_gate_declared_smoke_count: Int = 4

fn emit_host_row_is_present(row: EmitHostTargetCoverageRow) -> Bool {
  match runtime_row_from_target(target: row.target) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn emit_host_present_target_count() -> Int {
  fold_list(
    xs: emit_host_target_coverage_rows,
    empty: 0,
    cons: fn(acc, row) {
      if emit_host_row_is_present(row: row) { acc + 1 } else { acc }
    }
  )
}

// Fail-closed family witness: non-empty roster, every target's smoke coverage agrees with its
// declared host-executability, and the host-present count matches the gate's smoke count.
test fn emit_host_target_coverage_complete() -> Bool {
  if is_empty(xs: emit_host_target_coverage_rows) {
    false
  } else {
    emit_host_all_targets_consistent()
      && (emit_host_present_target_count() == emit_host_gate_declared_smoke_count)
  }
}
