fn emit_host_run_unsupported_target_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_run_unsupported_target,
    at: port_locus(port: ^emit_host_transport_port),
    correction: None
  }
}

fn emit_host_emit_vs_eval_deferred_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_emit_vs_eval_deferred,
    at: node_locus(node: at),
    correction: None
  }
}

fn emit_host_exit_not_ok_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_exit_not_ok,
    at: port_locus(port: ^emit_host_transport_port),
    correction: None
  }
}

fn emit_host_transport_outside_grant_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_transport_outside_grant,
    at: port_locus(port: ^emit_host_transport_port),
    correction: None
  }
}

fn emit_host_build_failed_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_build_failed,
    at: node_locus(node: at),
    correction: None
  }
}

fn emit_host_run_failed_diagnostic() -> Diagnostic {
  emit_host_exit_not_ok_diagnostic()
}

fn host_exit_failure_outcome(exit: HostExit) -> Outcome<RuntimeValue> {
  match exit.outcome {
    Accepted { value: Violates { diagnostic: d }, diagnostics: None } =>
      outcome_rejected(d: d)
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
    _ => outcome_rejected(d: emit_host_exit_not_ok_diagnostic())
  }
}

fn emit_host_receipt_from_source(
  target: TargetModel,
  source: Medium<String>,
  exit: HostExit,
  stdout_bytes: ByteString,
  stderr_bytes: ByteString,
  build_log: BuildLog,
  compile_skipped: Bool
) -> EmitHostRunReceipt {
  EmitHostRunReceipt {
    target: target,
    source_text: source.carried,
    exit: exit,
    logical_run: host_logical_run_from_exit(exit: exit, stdout_bytes: stdout_bytes),
    stderr_bytes: stderr_bytes,
    build_log: build_log,
    compile_skipped: compile_skipped
  }
}

fn runtime_value_parse(target: TargetModel, stdout: HostRunStdout) -> Outcome<RuntimeValue> {
  bind_outcome(
    o: runtime_row_from_target(target: target),
    f: fn(row) {
      runtime_value_parse_from_row(row: row, bytes: stdout.bytes)
    }
  )
}

fn runtime_value_signed_i32_le_as_int(value: RuntimeValue) -> Outcome<Int> {
  match value {
    RuntimePrimitive { value: p } =>
      integer_signed_i32_le_bytes_to_int(bytes: p.bytes)
    _ => outcome_rejected(d: emit_host_run_unsupported_target_diagnostic())
  }
}

fn emit_host_list_map<T, U>(xs: List<T>, f: fn(T) -> U) -> List<U> {
  match xs {
    Empty => []
    Cons { head: h, tail: t } => concat([f(h)], emit_host_list_map(xs: t, f: f))
  }
}

fn process_program_name(program: ProcessProgram) -> Outcome<String> {
  match program {
    HostToolProgram { executable: exe } =>
      Accepted { value: exe, diagnostics: None }
    ProducedProgram { path: p } =>
      Accepted { value: concat("./", p), diagnostics: None }
  }
}

fn emit_host_process_program_name(program: ProcessProgram) -> Outcome<String> {
  process_program_name(program: program)
}

fn invocation_arg_text(arg: InvocationArg) -> String {
  match arg {
    LiteralArg { text: t } => t
    WorkspacePath { path: p } => p
    ProducedArtifact { path: p } => p
  }
}

fn invocation_argv(inv: ProcessInvocation) -> Outcome<List<String>> {
  bind_outcome(
    o: process_program_name(program: inv.program),
    f: fn(program) {
      Accepted {
        value: concat(
          [program],
          emit_host_list_map(xs: inv.args, f: fn(a) { invocation_arg_text(arg: a) })
        ),
        diagnostics: None
      }
    }
  )
}

fn empty_argv_lists() -> List<List<String>> {
  []
}

fn build_invocation_argvs(builds: List<ProcessInvocation>) -> Outcome<List<List<String>>> {
  match builds {
    Empty => Accepted { value: empty_argv_lists(), diagnostics: None }
    Cons { head: inv, tail: rest } =>
      bind_outcome(
        o: invocation_argv(inv: inv),
        f: fn(argv) {
          bind_outcome(
            o: build_invocation_argvs(builds: rest),
            f: fn(acc) {
              Accepted { value: concat([argv], acc), diagnostics: None }
            }
          )
        }
      )
  }
}

fn workspace_content_text(content: WorkspaceContent, emitted: String) -> String {
  match content {
    EmittedSource => emitted
    FixedText { text: t } => t
    EmittedWithSuffix { suffix: s } => concat(emitted, s)
  }
}

fn emit_host_octet_bit(octet: Int, place: Int) -> Bool {
  ((octet / place) % 2) == 1
}

fn emit_host_byte_from_octet(octet: Int) -> Byte {
  Byte {
    bits: [
      emit_host_octet_bit(octet: octet, place: 1),
      emit_host_octet_bit(octet: octet, place: 2),
      emit_host_octet_bit(octet: octet, place: 4),
      emit_host_octet_bit(octet: octet, place: 8),
      emit_host_octet_bit(octet: octet, place: 16),
      emit_host_octet_bit(octet: octet, place: 32),
      emit_host_octet_bit(octet: octet, place: 64),
      emit_host_octet_bit(octet: octet, place: 128)
    ]
  }
}

fn emit_host_octets_byte_string(octets: List<Int>) -> ByteString {
  emit_host_list_map(xs: octets, f: fn(o) { emit_host_byte_from_octet(octet: o) })
}

data emit_host_run_args_note: String = "run_args is the family-member selector (std.emit_on_demand witness_family_build_grain_ruling): a family-grain crate carries one argv-dispatched main, and the member id is appended to the descriptor's run invocation at run time. The dispatcher is fail-closed — an unknown member exits nonzero, surfacing as a refused logical_run, never fabricated octets. Per-witness callers pass []."

fn run_host_process(
  row: EmitHostRuntimeRow,
  target: TargetModel,
  source: Medium<String>,
  fixture_inputs: Inputs
) -> Outcome<EmitHostRunReceipt> {
  run_host_process_with_cache(
    workspace_dir: "",
    row: row,
    target: target,
    source: source,
    fixture_inputs: fixture_inputs,
    use_cache: false,
    run_args: []
  )
}

fn run_host_process_cached(
  workspace_dir: String,
  row: EmitHostRuntimeRow,
  target: TargetModel,
  source: Medium<String>,
  fixture_inputs: Inputs
) -> Outcome<EmitHostRunReceipt> {
  run_host_process_with_cache(
    workspace_dir: workspace_dir,
    row: row,
    target: target,
    source: source,
    fixture_inputs: fixture_inputs,
    use_cache: true,
    run_args: []
  )
}

fn run_host_process_with_cache(
  workspace_dir: String,
  row: EmitHostRuntimeRow,
  target: TargetModel,
  source: Medium<String>,
  fixture_inputs: Inputs,
  use_cache: Bool,
  run_args: List<String>
) -> Outcome<EmitHostRunReceipt> {
  let _inputs = fixture_inputs
  let transport = row.transport
  match build_transport_admissible(transport: transport) {
    EffectOutsideGrant { verb: v, target: t, frame: f } =>
      outcome_rejected(d: emit_host_transport_outside_grant_diagnostic())
    Admitted { via_root: r } =>
      run_host_process_admitted(
        workspace_dir: workspace_dir,
        transport: transport,
        target: target,
        source: source,
        use_cache: use_cache,
        run_args: run_args
      )
  }
}

fn run_host_process_admitted(
  workspace_dir: String,
  transport: HostTransportDescriptor,
  target: TargetModel,
  source: Medium<String>,
  use_cache: Bool,
  run_args: List<String>
) -> Outcome<EmitHostRunReceipt> {
  bind_outcome(
    o: build_invocation_argvs(builds: transport.build),
    f: fn(builds) {
      bind_outcome(
        o: invocation_argv(inv: transport.run),
        f: fn(descriptor_run_argv) {
          let run_argv = concat(descriptor_run_argv, run_args)
          let files = emit_host_list_map(
            xs: transport.workspace,
            f: fn(w) {
              {
                path: w.path,
                text: workspace_content_text(content: w.content, emitted: source.carried)
              }
            }
          )
          let result = if use_cache {
            emit_host_run_transport_cached(
              workspace_dir: workspace_dir,
              files: files,
              build: builds,
              run: run_argv
            )
          } else {
            emit_host_run_transport(files: files, build: builds, run: run_argv)
          }
          let exit = HostExit {
            outcome: Accepted {
              value: if result.success {
                Holds { value: ExitOk { code: result.exit_code } }
              } else {
                Violates { diagnostic: emit_host_exit_not_ok_diagnostic() }
              },
              diagnostics: None
            }
          }
          Accepted {
            value: emit_host_receipt_from_source(
              target: target,
              source: source,
              exit: exit,
              stdout_bytes: emit_host_octets_byte_string(octets: result.stdout_octets),
              stderr_bytes: emit_host_octets_byte_string(octets: result.stderr_octets),
              build_log: BuildLog { lines: result.build_log },
              compile_skipped: result.compile_skipped
            ),
            diagnostics: None
          }
        }
      )
    }
  )
}

fn run_emit_host(
  target: TargetModel,
  source: Medium<String>,
  fixture_inputs: Inputs
) -> Outcome<EmitHostRunReceipt> {
  bind_outcome(
    o: runtime_row_from_target(target: target),
