          source_outcome: source_outcome,
          target: target,
          workspace_dir: workspace_dir,
          run_args: run_args,
          claim_input_root: lhs,
          expected_eval_root: rhs
        )
      )
    CompilesClaim { expected_value: expected_value, label: _, anchor: _, input: input, classification: _ } =>
      run_test_claim_emit_vs_eval_run(
        subject: subject,
        target: target,
        verdict: run_test_claim_from_source_emit_vs_eval_cached_for_claim(
          subject: subject,
          source_outcome: source_outcome,
          target: target,
          workspace_dir: workspace_dir,
          run_args: run_args,
          claim_input_root: input,
          expected_eval_root: expected_value
        )
      )
    _ => run_test_claim(subject: subject)
  }
}

fn run_test_claim_module_emit_vs_eval(
  subject: TestClaimEvalSubject<Node>,
  module_decls: List<InferredTree>,
  target: TargetModel
) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_from_source_emit_vs_eval(
    subject: subject,
    source_outcome: emit_module(decls: module_decls, target: target),
    target: target
  )
}
