fn run_test_claim_emit_vs_eval_verdict(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel,
  host_receipt: EmitHostRunReceipt,
  host_actual: RuntimeValue,
  expected: Outcome<RuntimeValue>
) -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  match expected {
    Accepted { value: exp_val, diagnostics: None } =>
      if accepted_runtime_value_outcome_eq(
        a: Accepted { value: host_actual, diagnostics: None },
        b: expected
      ) {
        Pass
      } else {
        verdict_semantic_mismatch(
          actual: Accepted { value: host_actual, diagnostics: None },
          falsification: optional_present(
            value: FalsificationReceipt {
              subject: subject,
              expected: exp_val,
              actual: host_actual,
              divergence: ValueDiff { expected: exp_val, actual: host_actual },
              evidence: Host { receipt: host_receipt }
            }
          )
        )
      }
    Rejected { diagnostics: ds } =>
      verdict_build_failed(
        actual: expected,
        diagnostic: ds.head
      )
    Accepted { value: _, diagnostics: Some { diagnostics: ds } } =>
      verdict_build_failed(
        actual: expected,
        diagnostic: ds.head
      )
  }
}

fn emit_host_no_run_args() -> List<String> {
  []
}

fn run_test_claim_emit_vs_eval_verdict_from_run(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel,
  run_outcome: Outcome<EmitHostRunReceipt>,
  expected: Outcome<RuntimeValue>,
  at: Node
) -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  match run_outcome {
    Accepted { value: host_receipt, diagnostics: _ } =>
      match host_receipt.logical_run {
        Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          match runtime_value_parse(target: target, stdout: stdout) {
            Accepted { value: host_actual, diagnostics: _ } =>
              run_test_claim_emit_vs_eval_verdict(
                subject: subject,
                target: target,
                host_receipt: host_receipt,
                host_actual: host_actual,
                expected: expected
              )
            Rejected { diagnostics: ds } =>
              verdict_run_failed(
                actual: Rejected { diagnostics: ds },
                diagnostic: ds.head
              )
          }
        _ =>
          verdict_run_failed(
            actual: host_exit_failure_outcome(exit: host_receipt.exit),
            diagnostic: emit_host_run_failed_diagnostic()
          )
      }
    Rejected { diagnostics: ds } =>
      Deferred {
        actual: Rejected { diagnostics: ds },
        diagnostic: emit_host_emit_vs_eval_deferred_diagnostic(at: at)
      }
  }
}

fn run_test_claim_emit_vs_eval_verdict_from_source(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel,
  source_outcome: Outcome<Medium<String>>,
  claim_input_root: Node,
  expected_eval_root: Node,
  expected: Outcome<RuntimeValue>,
  at: Node
) -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  match source_outcome {
    Accepted { value: source, diagnostics: _ } =>
      run_test_claim_emit_vs_eval_verdict_from_run(
        subject: subject,
        target: target,
        run_outcome: run_emit_host(
          target: target,
          source: source,
          fixture_inputs: inputs_for_emit_host(
            claim_input_root: claim_input_root,
            expected_eval_root: expected_eval_root,
            claim_pin: subject.input.evaluator_pin
          )
        ),
        expected: expected,
        at: at
      )
    Rejected { diagnostics: ds } =>
      verdict_build_failed(
        actual: Rejected { diagnostics: ds },
        diagnostic: emit_host_build_failed_diagnostic(at: at)
      )
  }
}

fn run_test_claim_emit_vs_eval_verdict_from_source_cached(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel,
  source_outcome: Outcome<Medium<String>>,
  workspace_dir: String,
  run_args: List<String>,
  claim_input_root: Node,
  expected_eval_root: Node,
  expected: Outcome<RuntimeValue>,
  at: Node
) -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  match source_outcome {
    Accepted { value: source, diagnostics: _ } =>
      run_test_claim_emit_vs_eval_verdict_from_run(
        subject: subject,
        target: target,
        run_outcome: run_emit_host_cached_with_run_args(
          workspace_dir: workspace_dir,
          target: target,
          source: source,
          fixture_inputs: inputs_for_emit_host(
            claim_input_root: claim_input_root,
            expected_eval_root: expected_eval_root,
            claim_pin: subject.input.evaluator_pin
          ),
          run_args: run_args
        ),
        expected: expected,
        at: at
      )
    Rejected { diagnostics: ds } =>
      verdict_build_failed(
        actual: Rejected { diagnostics: ds },
        diagnostic: emit_host_build_failed_diagnostic(at: at)
      )
  }
}

fn run_test_claim_emit_vs_eval_for_claim(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel,
  claim_input_root: Node,
  expected_eval_root: Node
) -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  let at = test_claim_input(c: subject.claim)
  let interpretation = eval_context_interpretation(context: subject.context)
  let expected = eval(
    tree: subject.tree,
    interpretation: interpretation,
    inputs: inputs_root_only(root: expected_eval_root)
  )
  run_test_claim_emit_vs_eval_verdict_from_source(
    subject: subject,
    target: target,
    source_outcome: emit(tree: subject.tree, target: target),
    claim_input_root: claim_input_root,
    expected_eval_root: expected_eval_root,
    expected: expected,
    at: at
  )
}

fn run_test_claim_from_source_emit_vs_eval_for_claim(
  subject: TestClaimEvalSubject<Node>,
  source_outcome: Outcome<Medium<String>>,
  target: TargetModel,
  claim_input_root: Node,
