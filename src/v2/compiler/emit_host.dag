data emit_host_transport_not_wired: Symbol = emit_host_transport_not_wired
data emit_host_transport_port: Symbol = emit_host_transport_port
data emit_host_parse_unsupported_target: Symbol = emit_host_parse_unsupported_target
data emit_host_run_unsupported_target: Symbol = emit_host_run_unsupported_target
data emit_host_emit_vs_eval_deferred: Symbol = emit_host_emit_vs_eval_deferred
data emit_host_exit_not_ok: Symbol = emit_host_exit_not_ok
data emit_host_rust_i64_symbol: Symbol = emit_host_rust_i64_symbol
data emit_host_ts_i32_symbol: Symbol = emit_host_ts_i32_symbol

fn emit_host_transport_not_wired_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: emit_host_transport_not_wired,
    at: port_locus(port: emit_host_transport_port),
    correction: None
  }
}

fn emit_host_parse_unsupported_target_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: emit_host_parse_unsupported_target,
    at: port_locus(port: emit_host_transport_port),
    correction: None
  }
}

fn emit_host_run_unsupported_target_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: emit_host_run_unsupported_target,
    at: port_locus(port: emit_host_transport_port),
    correction: None
  }
}

fn emit_host_emit_vs_eval_deferred_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: emit_host_emit_vs_eval_deferred,
    at: node_locus(node: at),
    correction: None
  }
}

fn emit_host_exit_not_ok_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: emit_host_exit_not_ok,
    at: port_locus(port: emit_host_transport_port),
    correction: None
  }
}

fn host_exit_failure_outcome(exit: HostExit) -> Outcome<RuntimeValue> {
  match exit.outcome {
    Accepted { value: Violates { diagnostic: d }, diagnostics: None } =>
      outcome_rejected(d: d)
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
    _ => outcome_rejected(d: emit_host_exit_not_ok_diagnostic())
  }
}

fn emit_host_rust_i64_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: emit_host_rust_i64_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn emit_host_ts_i32_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: emit_host_ts_i32_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn emit_host_receipt_from_source(
  target: TargetModel,
  source: TargetSource,
  exit: HostExit,
  stdout_bytes: ByteString,
  stderr_bytes: ByteString,
  build_log: BuildLog
) -> EmitHostRunReceipt {
  EmitHostRunReceipt {
    target: target,
    source_text: source,
    exit: exit,
    logical_run: host_logical_run_from_exit(exit: exit, stdout_bytes: stdout_bytes),
    stderr_bytes: stderr_bytes,
    build_log: build_log
  }
}

fn runtime_value_parse_rust(bytes: ByteString) -> Outcome<RuntimeValue> {
  if count(bytes) == 5 {
    Accepted {
      value: RuntimePrimitive {
        value: {
          primitive_type: emit_host_rust_i64_node(),
          bytes: bytes
        }
      },
      diagnostics: None
    }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(d: emit_host_parse_unsupported_target_diagnostic())
    }
  }
}

fn runtime_value_parse_python(bytes: ByteString) -> Outcome<RuntimeValue> {
  runtime_value_parse_rust(bytes: bytes)
}

fn runtime_value_parse_go(bytes: ByteString) -> Outcome<RuntimeValue> {
  runtime_value_parse_rust(bytes: bytes)
}

fn runtime_value_parse_signed_i32_le(bytes: ByteString) -> Outcome<RuntimeValue> {
  if count(bytes) == 4 {
    Accepted {
      value: RuntimePrimitive {
        value: {
          primitive_type: emit_host_ts_i32_node(),
          bytes: bytes
        }
      },
      diagnostics: None
    }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(d: emit_host_parse_unsupported_target_diagnostic())
    }
  }
}

fn runtime_value_parse(target: TargetModel, stdout: HostRunStdout) -> Outcome<RuntimeValue> {
  // 🟡 gated — per-target host-emission discriminator (P2 §314: target knowledge in compiler code; this if-chain branches on per-target authority source texts (now read from extdeps/languages/* authority, no local pin copies), cost-of-change=N) — feature: T-22 host-emission TargetModel dissolution — bind: gunbc#4750 (supersedes #4674; step 1 landed via #4718) — dissolve-on-arrival: promote a typed runtime_row onto TargetModel and replace this per-target if-chain (and its mirror in emit_host_gate.dag transport rows) with a generic row-lookup. forbidden: adding a 5th per-target arm without the dissolution.
  if target.authority_source_text == rust_mvp1_source_text_authority() {
    runtime_value_parse_rust(bytes: stdout.bytes)
  } else if target.authority_source_text == python_mvp1_source_text {
    runtime_value_parse_python(bytes: stdout.bytes)
  } else if target.authority_source_text == go_mvp1_source_text {
    runtime_value_parse_go(bytes: stdout.bytes)
  } else if target.authority_source_text == ts_mvp1_source_text_authority() {
    runtime_value_parse_signed_i32_le(bytes: stdout.bytes)
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(d: emit_host_parse_unsupported_target_diagnostic())
    }
  }
}

// Decode SignedI32Le stdout carrier — substrate stub; eval intercept reads primitive bytes.
fn runtime_value_signed_i32_le_as_int(value: RuntimeValue) -> Outcome<Int> {
  outcome_rejected(d: emit_host_parse_unsupported_target_diagnostic())
}

