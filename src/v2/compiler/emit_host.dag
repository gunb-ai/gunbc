}
import v2.std.witness { Holds, Violates }

fn emit_host_unknown_host_tool_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_unknown_host_tool,
    at: port_locus(port: ^emit_host_transport_port),
    correction: None
  }
}

fn emit_host_run_unsupported_target_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_run_unsupported_target,
    at: port_locus(port: ^emit_host_transport_port),
    correction: None
  }
}

fn emit_host_emit_vs_eval_deferred_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_emit_vs_eval_deferred,
    at: node_locus(node: at),
    correction: None
  }
}

fn emit_host_exit_not_ok_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^emit_host_exit_not_ok,
    at: port_locus(port: ^emit_host_transport_port),
    correction: None
  }
}

fn host_exit_failure_outcome(exit: HostExit) -> Outcome<RuntimeValue> {
  match exit.outcome {
    Accepted { value: Violates { diagnostic: d }, diagnostics: None } =>
      outcome_rejected(d: d)
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
    _ => outcome_rejected(d: emit_host_exit_not_ok_diagnostic())
  }
}

fn emit_host_receipt_from_source(
  target: TargetModel,
  source: Medium<String>,
  exit: HostExit,
  stdout_bytes: ByteString,
  stderr_bytes: ByteString,
  build_log: BuildLog
) -> EmitHostRunReceipt {
  EmitHostRunReceipt {
    target: target,
    source_text: source.carried,
    exit: exit,
    logical_run: host_logical_run_from_exit(exit: exit, stdout_bytes: stdout_bytes),
    stderr_bytes: stderr_bytes,
    build_log: build_log
  }
}

fn runtime_value_parse(target: TargetModel, stdout: HostRunStdout) -> Outcome<RuntimeValue> {
  bind_outcome(
    o: runtime_row_from_target(target: target),
    f: fn(row) {
      runtime_value_parse_from_row(row: row, bytes: stdout.bytes)
    }
  )
}

fn runtime_value_signed_i32_le_as_int(value: RuntimeValue) -> Outcome<Int> {
  outcome_rejected(d: emit_host_run_unsupported_target_diagnostic())
}

fn emit_host_list_map<T, U>(xs: List<T>, f: fn(T) -> U) -> List<U> {
  match xs {
    Empty => []
    Cons { head: h, tail: t } => concat([f(h)], emit_host_list_map(xs: t, f: f))
  }
}

fn host_tool_program_name(tool: Symbol) -> Outcome<String> {
  if tool == ^host_tool_cargo {
    Accepted { value: "cargo", diagnostics: None }
  } else {
    outcome_rejected(d: emit_host_unknown_host_tool_diagnostic())
  }
}

fn invocation_arg_text(arg: InvocationArg) -> String {
  match arg {
    LiteralArg { text: t } => t
    WorkspacePath { path: p } => p
    ProducedArtifact { path: p } => p
  }
}

fn invocation_argv(inv: ProcessInvocation) -> Outcome<List<String>> {
  bind_outcome(
    o: host_tool_program_name(tool: inv.tool),
    f: fn(program) {
      Accepted {
        value: concat(
          [program],
          emit_host_list_map(xs: inv.args, f: fn(a) { invocation_arg_text(arg: a) })
        ),
        diagnostics: None
      }
    }
  )
}

fn empty_argv_lists() -> List<List<String>> {
  []
}

fn build_invocation_argvs(builds: List<ProcessInvocation>) -> Outcome<List<List<String>>> {
  match builds {
    Empty => Accepted { value: empty_argv_lists(), diagnostics: None }
    Cons { head: inv, tail: rest } =>
      bind_outcome(
        o: invocation_argv(inv: inv),
        f: fn(argv) {
          bind_outcome(
            o: build_invocation_argvs(builds: rest),
            f: fn(acc) {
              Accepted { value: concat([argv], acc), diagnostics: None }
            }
          )
        }
      )
  }
}

fn workspace_content_text(content: WorkspaceContent, emitted: String) -> String {
  match content {
    EmittedSource => emitted
    FixedText { text: t } => t
    EmittedWithSuffix { suffix: s } => concat(emitted, s)
  }
}

fn emit_host_octet_bit(octet: Int, place: Int) -> Bool {
  ((octet / place) % 2) == 1
}

fn emit_host_byte_from_octet(octet: Int) -> Byte {
  Byte {
    bits: [
      emit_host_octet_bit(octet: octet, place: 1),
      emit_host_octet_bit(octet: octet, place: 2),
      emit_host_octet_bit(octet: octet, place: 4),
      emit_host_octet_bit(octet: octet, place: 8),
      emit_host_octet_bit(octet: octet, place: 16),
      emit_host_octet_bit(octet: octet, place: 32),
      emit_host_octet_bit(octet: octet, place: 64),
      emit_host_octet_bit(octet: octet, place: 128)
    ]
  }
}

fn emit_host_octets_byte_string(octets: List<Int>) -> ByteString {
  emit_host_list_map(xs: octets, f: fn(o) { emit_host_byte_from_octet(octet: o) })
}

fn run_host_process(
  row: EmitHostRuntimeRow,
  target: TargetModel,
  source: Medium<String>,
  fixture_inputs: Inputs
) -> Outcome<EmitHostRunReceipt> {
  let _inputs = fixture_inputs
  let transport = row.transport
  bind_outcome(
    o: build_invocation_argvs(builds: transport.build),
    f: fn(builds) {
      bind_outcome(
        o: invocation_argv(inv: transport.run),
        f: fn(run_argv) {
          let files = emit_host_list_map(
            xs: transport.workspace,
            f: fn(w) {
              {
                path: w.path,
                text: workspace_content_text(content: w.content, emitted: source.carried)
              }
            }
          )
          let result = emit_host_run_transport(files: files, build: builds, run: run_argv)
          let exit = HostExit {
            outcome: Accepted {
              value: if result.success {
                Holds { value: ExitOk { code: result.exit_code } }
              } else {
                Violates { diagnostic: emit_host_exit_not_ok_diagnostic() }
              },
              diagnostics: None
            }
          }
          Accepted {
            value: emit_host_receipt_from_source(
              target: target,
              source: source,
              exit: exit,
              stdout_bytes: emit_host_octets_byte_string(octets: result.stdout_octets),
              stderr_bytes: emit_host_octets_byte_string(octets: result.stderr_octets),
              build_log: BuildLog { lines: result.build_log }
            ),
            diagnostics: None
          }
        }
      )
    }
  )
}

fn run_emit_host(
  target: TargetModel,
  source: Medium<String>,
  fixture_inputs: Inputs
) -> Outcome<EmitHostRunReceipt> {
  bind_outcome(
    o: runtime_row_from_target(target: target),
    f: fn(row) {
      run_host_process(
        row: row,
        target: target,
        source: source,
        fixture_inputs: fixture_inputs
      )
    }
  )
}

fn run_test_claim_emit_vs_eval_verdict(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel,
  host_receipt: EmitHostRunReceipt,
  host_actual: RuntimeValue,
  expected: Outcome<RuntimeValue>
) -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  match expected {
    Accepted { value: exp_val, diagnostics: None } =>
      if accepted_runtime_value_outcome_eq(
        a: Accepted { value: host_actual, diagnostics: None },
        b: expected
      ) {
        Pass
      } else {
        Fail {
          actual: Accepted { value: host_actual, diagnostics: None },
          falsification: optional_present(
            value: FalsificationReceipt {
              subject: subject,
              expected: exp_val,
              actual: host_actual,
              divergence: ValueDiff { expected: exp_val, actual: host_actual },
              evidence: Host { receipt: host_receipt }
            }
          )
        }
      }
    _ =>
      verdict_fail(actual: expected)
  }
}

fn run_test_claim_emit_vs_eval_for_claim(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel,
  claim_input_root: Node,
  expected_eval_root: Node
) -> Verdict<TestClaimEvalSubject<Node>, RuntimeValue> {
  let at = test_claim_input(c: subject.claim)
  let interpretation = eval_context_interpretation(context: subject.context)
  let expected = eval(
    tree: subject.tree,
    interpretation: interpretation,
    inputs: inputs_root_only(root: expected_eval_root)
  )
  match emit(tree: subject.tree, target: target) {
    Accepted { value: source, diagnostics: _ } =>
      match run_emit_host(
        target: target,
        source: source,
        fixture_inputs: inputs_for_emit_host(
          claim_input_root: claim_input_root,
          expected_eval_root: expected_eval_root,
          claim_pin: subject.input.evaluator_pin
        )
      ) {
        Accepted { value: host_receipt, diagnostics: _ } =>
          match host_receipt.logical_run {
            Accepted {
              value: HostLogicalRun { stdout: stdout },
              diagnostics: None
            } =>
              match runtime_value_parse(target: target, stdout: stdout) {
                Accepted { value: host_actual, diagnostics: _ } =>
                  run_test_claim_emit_vs_eval_verdict(
                    subject: subject,
                    target: target,
                    host_receipt: host_receipt,
                    host_actual: host_actual,
                    expected: expected
                  )
                Rejected { diagnostics: ds } =>
                  verdict_fail(actual: Rejected { diagnostics: ds })
              }
            _ =>
              verdict_fail(actual: host_exit_failure_outcome(exit: host_receipt.exit))
          }
        Rejected { diagnostics: ds } =>
          Deferred {
            actual: Rejected { diagnostics: ds },
            diagnostic: emit_host_emit_vs_eval_deferred_diagnostic(at: at)
          }
      }
    Rejected { diagnostics: ds } =>
      verdict_fail(actual: Rejected { diagnostics: ds })
  }
}

fn run_test_claim_emit_vs_eval_run(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel,
  verdict: Verdict<TestClaimEvalSubject<Node>, RuntimeValue>
) -> TestClaimRun<Node, RuntimeValue> {
  TestClaimRun {
    cache: test_claim_cache_receipt_node(subject: subject),
    verdict: verdict
  }
}

fn run_test_claim_emit_vs_eval(
  subject: TestClaimEvalSubject<Node>,
  target: TargetModel
) -> TestClaimRun<Node, RuntimeValue> {
  match subject.claim {
    EqualsClaim { rhs: rhs, label: _, anchor: _, lhs: lhs, classification: _ } =>
      run_test_claim_emit_vs_eval_run(
        subject: subject,
        target: target,
        verdict: run_test_claim_emit_vs_eval_for_claim(
          subject: subject,
          target: target,
          claim_input_root: lhs,
          expected_eval_root: rhs
        )
      )
    CompilesClaim { expected_value: expected_value, label: _, anchor: _, input: input, classification: _ } =>
      run_test_claim_emit_vs_eval_run(
        subject: subject,
        target: target,
        verdict: run_test_claim_emit_vs_eval_for_claim(
          subject: subject,
          target: target,
          claim_input_root: input,
          expected_eval_root: expected_value
        )
      )
    _ => run_test_claim(subject: subject)
  }
}
