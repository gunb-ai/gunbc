module v2.compiler.emit_host



data emit_host_access_decision_seed_transport_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v1_compiler.v1_interpreter",
    decl_name: "require_permitted_transport",
    field: WholeDeclaration
  }
}

data emit_host_access_decision_seed_transport_receipt: String = "HAND-RUST receipt for v1_interpreter.rs require_permitted_transport and its emit_host_admission_flip_test RED control. The seed adds no authorization policy: v2.compiler.build_transport_admission build_transport_admissible constructs the AccessDecision, and the Rust transport only refuses anything other than that exact carrier's Permit arm before realizing the host effect. Checkable executing receipt: cargo test -p v1-compiler emit_host_admission_flip_test -- --nocapture; permit_arm_from_another_carrier_refuses goes red if a same-named arm from another carrier can authorize."

data emit_host_access_decision_seed_transport_dissolve_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "DISSOLVES WHEN the v1-exit lane's concrete ROADMAP row v1-zero-hand-maintained-rust is accepted (authority gunbc.roadmap_authority roadmap_nodes): emit_host transport is generated from this module or deleted, so require_permitted_transport and its hand-written Rust tests no longer exist.")

fn emit_host_run_unsupported_target_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^emit_host_run_unsupported_target,
    at: port_locus(port: ^emit_host_transport_port),
    correction: v2.std.diagnostic.None
  }
}

fn emit_host_emit_vs_eval_deferred_diagnostic(at: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^emit_host_emit_vs_eval_deferred,
    at: node_locus(node: at),
    correction: v2.std.diagnostic.None
  }
}

fn emit_host_exit_not_ok_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^emit_host_exit_not_ok,
    at: port_locus(port: ^emit_host_transport_port),
    correction: v2.std.diagnostic.None
  }
}

fn emit_host_transport_outside_grant_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^emit_host_transport_outside_grant,
    at: port_locus(port: ^emit_host_transport_port),
    correction: v2.std.diagnostic.None
  }
}

fn emit_host_build_failed_diagnostic(at: Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^emit_host_build_failed,
    at: node_locus(node: at),
    correction: v2.std.diagnostic.None
  }
}

fn emit_host_run_failed_diagnostic() -> v2.std.diagnostic.Diagnostic {
  emit_host_exit_not_ok_diagnostic()
}

fn host_exit_failure_outcome(exit: v2.std.host_run.HostExit) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match exit.outcome {
    v2.std.diagnostic.Accepted { value: Violates { diagnostic: d }, diagnostics: None } =>
      outcome_rejected(d: d)
    v2.std.diagnostic.Rejected { diagnostics: ds } => v2.std.diagnostic.Rejected { diagnostics: ds }
    _ => outcome_rejected(d: emit_host_exit_not_ok_diagnostic())
  }
}

fn emit_host_receipt_from_source(
  target: v2.std.compilers.target_model.TargetModel,
  source: extdeps.communication.medium.Medium<String>,
  exit: v2.std.host_run.HostExit,
  stdout_bytes: v2.std.host_transport.ByteString,
  stderr_bytes: v2.std.host_transport.ByteString,
  build_log: v2.std.host_run.BuildLog,
  compile_skipped: Bool
) -> v2.std.host_run.EmitHostRunReceipt {
  v2.std.host_run.EmitHostRunReceipt {
    target: target,
    source_text: source.carried,
    exit: exit,
    logical_run: host_logical_run_from_exit(exit: exit, stdout_bytes: stdout_bytes),
    stderr_bytes: stderr_bytes,
    build_log: build_log,
    compile_skipped: compile_skipped
  }
}

fn runtime_value_parse(target: v2.std.compilers.target_model.TargetModel, stdout: v2.std.host_run.HostRunStdout) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  bind_outcome(
    o: runtime_row_from_target(target: target),
    f: fn(row) {
      runtime_value_parse_from_row(row: row, bytes: stdout.bytes)
    }
  )
}

fn runtime_value_signed_i32_le_as_int(value: v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<Int> {
  match value {
    RuntimePrimitive { value: p } =>
      integer_signed_i32_le_bytes_to_int(bytes: p.bytes)
    _ => outcome_rejected(d: emit_host_run_unsupported_target_diagnostic())
  }
}

fn emit_host_list_map<T, U>(xs: List<T>, f: fn(T) -> U) -> List<U> {
  match xs {
    Empty => []
    Cons { head: h, tail: t } => concat([f(h)], emit_host_list_map(xs: t, f: f))
  }
}

fn process_program_name(program: v2.std.host_transport.ProcessProgram) -> v2.std.diagnostic.Outcome<String> {
  match program {
    HostToolProgram { executable: exe } =>
      v2.std.diagnostic.Accepted { value: exe, diagnostics: v2.std.diagnostic.None }
    ProducedProgram { path: p } =>
      v2.std.diagnostic.Accepted { value: concat("./", p), diagnostics: v2.std.diagnostic.None }
  }
}

fn emit_host_process_program_name(program: v2.std.host_transport.ProcessProgram) -> v2.std.diagnostic.Outcome<String> {
  process_program_name(program: program)
}

fn invocation_arg_text(arg: v2.std.host_transport.InvocationArg) -> String {
  match arg {
    LiteralArg { text: t } => t
    WorkspacePath { path: p } => p
    ProducedArtifact { path: p } => p
  }
}

fn invocation_argv(inv: v2.std.host_transport.ProcessInvocation) -> v2.std.diagnostic.Outcome<List<String>> {
  bind_outcome(
    o: process_program_name(program: inv.program),
    f: fn(program) {
      v2.std.diagnostic.Accepted {
        value: concat(
          [program],
          emit_host_list_map(xs: inv.args, f: fn(a) { invocation_arg_text(arg: a) })
        ),
        diagnostics: v2.std.diagnostic.None
      }
    }
  )
}

fn empty_argv_lists() -> List<List<String>> {
  []
}

fn build_invocation_argvs(builds: List<v2.std.host_transport.ProcessInvocation>) -> v2.std.diagnostic.Outcome<List<List<String>>> {
  match builds {
    Empty => v2.std.diagnostic.Accepted { value: empty_argv_lists(), diagnostics: v2.std.diagnostic.None }
    Cons { head: inv, tail: rest } =>
      bind_outcome(
        o: invocation_argv(inv: inv),
        f: fn(argv) {
          bind_outcome(
            o: build_invocation_argvs(builds: rest),
            f: fn(acc) {
              v2.std.diagnostic.Accepted { value: concat([argv], acc), diagnostics: v2.std.diagnostic.None }
            }
          )
        }
      )
  }
}

fn workspace_content_text(content: v2.std.host_transport.WorkspaceContent, emitted: String) -> String {
  match content {
    EmittedSource => emitted
    FixedText { text: t } => t
    EmittedWithSuffix { suffix: s } => concat(emitted, s)
  }
}

fn emit_host_string_list_digest(xs: List<String>, seed: String) -> std.content_hash.ContentHash {
  fold(
    xs,
    init: content_hash_atom(value: seed),
    f: (acc, value) => content_hash_combine_structural(
      left: acc,
      right: content_hash_atom(value: value)
    )
  )
}

fn emit_host_materialized_workspace_files(
  workspace: List<v2.std.host_transport.WorkspaceFile>,
  emitted: String
) -> List<v2.std.host_transport.MaterializedWorkspaceFile> {
  emit_host_list_map(
    xs: workspace,
    f: fn(w) {
      v2.std.host_transport.MaterializedWorkspaceFile {
        path: w.path,
        text: workspace_content_text(content: w.content, emitted: emitted)
      }
    }
  )
}

fn emit_host_workspace_realization_inputs(
  files: List<v2.std.host_transport.MaterializedWorkspaceFile>
) -> List<std.artifact_store.ArtifactRealizationInput> {
  emit_host_list_map(
    xs: files,
    f: fn(file) {
      std.artifact_store.ArtifactRealizationInput {
        identity: concat("workspace:", file.path),
        content_digest: content_hash_atom(value: file.text)
      }
    }
  )
}

fn emit_host_build_realization_inputs(
  builds: List<List<String>>
) -> List<std.artifact_store.ArtifactRealizationInput> {
  match builds {
    Empty => []
    Cons { head: argv, tail: rest } =>
      concat(
        [
          std.artifact_store.ArtifactRealizationInput {
            identity: "build-argv",
            content_digest: emit_host_string_list_digest(
              xs: argv,
              seed: "emit-host-build-argv"
            )
          }
        ],
        emit_host_build_realization_inputs(builds: rest)
      )
  }
}

fn emit_host_input_realization_digest(
  files: List<v2.std.host_transport.MaterializedWorkspaceFile>,
  builds: List<List<String>>
) -> std.content_hash.ContentHash {
  artifact_realization_digest(
    inputs: concat(
      emit_host_workspace_realization_inputs(files: files),
      emit_host_build_realization_inputs(builds: builds)
    )
  )
}

fn emit_host_octet_bit(octet: Int, place: Int) -> Bool {
  ((octet / place) % 2) == 1
}

fn emit_host_byte_from_octet(octet: Int) -> v2.std.machine.Byte {
  v2.std.machine.Byte {
    bits: [
      emit_host_octet_bit(octet: octet, place: 1),
      emit_host_octet_bit(octet: octet, place: 2),
      emit_host_octet_bit(octet: octet, place: 4),
      emit_host_octet_bit(octet: octet, place: 8),
      emit_host_octet_bit(octet: octet, place: 16),
      emit_host_octet_bit(octet: octet, place: 32),
      emit_host_octet_bit(octet: octet, place: 64),
      emit_host_octet_bit(octet: octet, place: 128)
    ]
  }
}

fn emit_host_octets_byte_string(octets: List<Int>) -> v2.std.host_transport.ByteString {
  emit_host_list_map(xs: octets, f: fn(o) { emit_host_byte_from_octet(octet: o) })
}

data emit_host_run_args_note: String = "run_args is the family-member selector (std.emit_on_demand witness_family_build_grain_ruling): a family-grain crate carries one argv-dispatched main, and the member id is appended to the descriptor's run invocation at run time. The dispatcher is fail-closed — an unknown member exits nonzero, surfacing as a refused logical_run, never fabricated octets. Per-witness callers pass []."

fn run_host_process(
  row: v2.std.host_transport.EmitHostRuntimeRow,
  target: v2.std.compilers.target_model.TargetModel,
  source: extdeps.communication.medium.Medium<String>,
  fixture_inputs: v2.compiler.eval.Inputs
) -> v2.std.diagnostic.Outcome<v2.std.host_run.EmitHostRunReceipt> {
  run_host_process_with_cache(
    workspace_dir: "",
    row: row,
    target: target,
    source: source,
    fixture_inputs: fixture_inputs,
    use_cache: false,
    run_args: []
  )
}

fn run_host_process_cached(
  workspace_dir: String,
  row: v2.std.host_transport.EmitHostRuntimeRow,
  target: v2.std.compilers.target_model.TargetModel,
  source: extdeps.communication.medium.Medium<String>,
  fixture_inputs: v2.compiler.eval.Inputs
) -> v2.std.diagnostic.Outcome<v2.std.host_run.EmitHostRunReceipt> {
  run_host_process_with_cache(
    workspace_dir: workspace_dir,
    row: row,
    target: target,
    source: source,
    fixture_inputs: fixture_inputs,
    use_cache: true,
    run_args: []
  )
}

fn run_host_process_with_cache(
  workspace_dir: String,
  row: v2.std.host_transport.EmitHostRuntimeRow,
  target: v2.std.compilers.target_model.TargetModel,
  source: extdeps.communication.medium.Medium<String>,
  fixture_inputs: v2.compiler.eval.Inputs,
  use_cache: Bool,
  run_args: List<String>
) -> v2.std.diagnostic.Outcome<v2.std.host_run.EmitHostRunReceipt> {
  let _inputs = fixture_inputs
  let transport = row.transport
  match build_transport_admissible(transport: transport) {
    Deny { refusal: refusal } =>
      outcome_rejected(d: emit_host_transport_outside_grant_diagnostic())
    Permit =>
      run_host_process_admitted(
        admission: Permit,
        workspace_dir: workspace_dir,
        transport: transport,
        target: target,
        source: source,
        use_cache: use_cache,
        run_args: run_args
      )
  }
}

fn run_host_process_admitted(
  admission: std.access.AccessDecision,
  workspace_dir: String,
  transport: v2.std.host_transport.HostTransportDescriptor,
  target: v2.std.compilers.target_model.TargetModel,
  source: extdeps.communication.medium.Medium<String>,
  use_cache: Bool,
  run_args: List<String>
) -> v2.std.diagnostic.Outcome<v2.std.host_run.EmitHostRunReceipt> {
  bind_outcome(
    o: build_invocation_argvs(builds: transport.build),
    f: fn(builds) {
      bind_outcome(
        o: invocation_argv(inv: transport.run),
        f: fn(descriptor_run_argv) {
          let run_argv = concat(descriptor_run_argv, run_args)
          let files = emit_host_materialized_workspace_files(
            workspace: transport.workspace,
            emitted: source.carried
          )
          let result = if use_cache {
            emit_host_run_transport_cached(
              admission: admission,
              workspace_dir: native_cache_realization_workspace_root(
                workspace_root: workspace_dir,
                realization_digest: emit_host_input_realization_digest(
                  files: files,
                  builds: builds
                )
              ),
              files: files,
              build: builds,
              run: run_argv
            )
          } else {
            emit_host_run_transport(admission: admission, files: files, build: builds, run: run_argv)
          }
          let exit = v2.std.host_run.HostExit {
            outcome: v2.std.diagnostic.Accepted {
              value: match result.termination {
                ProcessExited { code: code } =>
                  if code == 0 {
                    v2.std.witness.Holds { value: v2.std.host_run.ExitOk { code: code } }
                  } else {
                    v2.std.witness.Violates { diagnostic: emit_host_exit_not_ok_diagnostic() }
                  }
                ProcessSignaled { signal: _ } =>
                  v2.std.witness.Violates { diagnostic: emit_host_exit_not_ok_diagnostic() }
                ProcessTerminationUnobserved =>
                  v2.std.witness.Violates { diagnostic: emit_host_exit_not_ok_diagnostic() }
              },
              diagnostics: None
            }
          }
          v2.std.diagnostic.Accepted {
            value: emit_host_receipt_from_source(
              target: target,
              source: source,
              exit: exit,
              stdout_bytes: emit_host_octets_byte_string(octets: result.stdout_octets),
              stderr_bytes: emit_host_octets_byte_string(octets: result.stderr_octets),
              build_log: v2.std.host_run.BuildLog { lines: result.build_log },
              compile_skipped: result.compile_skipped
            ),
            diagnostics: v2.std.diagnostic.None
          }
        }
      )
    }
  )
}

fn run_emit_host(
  target: v2.std.compilers.target_model.TargetModel,
  source: extdeps.communication.medium.Medium<String>,
  fixture_inputs: v2.compiler.eval.Inputs
