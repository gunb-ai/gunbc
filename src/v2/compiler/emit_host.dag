}

fn run_test_claim_emit_vs_eval_for_claim(
  subject: v2.compiler.eval.TestClaimEvalSubject<Node>,
  target: v2.std.compilers.target_model.TargetModel,
  claim_input_root: Node,
  expected_eval_root: Node
) -> Verdict<v2.compiler.eval.TestClaimEvalSubject<Node>, RuntimeValue> {
  let at = test_claim_input(c: subject.claim)
  let interpretation = eval_context_interpretation(context: subject.context)
  let expected = eval(
    tree: subject.tree,
    interpretation: interpretation,
    inputs: inputs_root_only(root: expected_eval_root)
  )
  run_test_claim_emit_vs_eval_verdict_from_source(
    subject: subject,
    target: target,
    source_outcome: v2.compiler.emit.emit(tree: subject.tree, target: target),
    claim_input_root: claim_input_root,
    expected_eval_root: expected_eval_root,
    expected: expected,
    at: at
  )
}

