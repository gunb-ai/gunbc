fn run_test_claim_emit_vs_eval_verdict(
  subject: v2.compiler.eval.TestClaimEvalSubject<Node>,
  target: v2.std.compilers.target_model.TargetModel,
  host_receipt: v2.std.host_run.EmitHostRunReceipt,
  host_actual: v2.std.runtime.RuntimeValue,
  expected: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
) -> Verdict<v2.compiler.eval.TestClaimEvalSubject<Node>, RuntimeValue> {
  match expected {
    v2.std.diagnostic.Accepted { value: exp_val, diagnostics: None } =>
      if accepted_runtime_value_outcome_eq(
        a: v2.std.diagnostic.Accepted { value: host_actual, diagnostics: v2.std.diagnostic.None },
        b: expected
      ) {
        Pass
      } else {
        verdict_semantic_mismatch(
          actual: v2.std.diagnostic.Accepted { value: host_actual, diagnostics: v2.std.diagnostic.None },
          falsification: optional_present(
            value: v2.std.test_claim_falsification.FalsificationReceipt {
              subject: subject,
              expected: exp_val,
              actual: host_actual,
              divergence: v2.std.host_run.ValueDiff { expected: exp_val, actual: host_actual },
              evidence: Host { receipt: host_receipt }
            }
          )
        )
      }
    v2.std.diagnostic.Rejected { diagnostics: ds } =>
      verdict_build_failed(
        actual: expected,
        diagnostic: ds.head
      )
    v2.std.diagnostic.Accepted { value: _, diagnostics: Some { diagnostics: ds } } =>
      verdict_build_failed(
        actual: expected,
        diagnostic: ds.head
      )
  }
}

fn emit_host_no_run_args() -> List<String> {
  []
}

fn run_test_claim_emit_vs_eval_verdict_from_run(
  subject: v2.compiler.eval.TestClaimEvalSubject<Node>,
  target: v2.std.compilers.target_model.TargetModel,
  run_outcome: v2.std.diagnostic.Outcome<v2.std.host_run.EmitHostRunReceipt>,
  expected: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  at: Node
) -> Verdict<v2.compiler.eval.TestClaimEvalSubject<Node>, RuntimeValue> {
  match run_outcome {
    v2.std.diagnostic.Accepted { value: host_receipt, diagnostics: _ } =>
      match host_receipt.logical_run {
        v2.std.diagnostic.Accepted {
          value: HostLogicalRun { stdout: stdout },
          diagnostics: None
        } =>
          match runtime_value_parse(target: target, stdout: stdout) {
            v2.std.diagnostic.Accepted { value: host_actual, diagnostics: _ } =>
              run_test_claim_emit_vs_eval_verdict(
                subject: subject,
                target: target,
                host_receipt: host_receipt,
                host_actual: host_actual,
                expected: expected
              )
            v2.std.diagnostic.Rejected { diagnostics: ds } =>
              verdict_run_failed(
                actual: v2.std.diagnostic.Rejected { diagnostics: ds },
                diagnostic: ds.head
              )
          }
        _ =>
          verdict_run_failed(
            actual: host_exit_failure_outcome(exit: host_receipt.exit),
            diagnostic: emit_host_run_failed_diagnostic()
          )
      }
    v2.std.diagnostic.Rejected { diagnostics: ds } =>
      v2.std.verdict.Deferred {
        actual: v2.std.diagnostic.Rejected { diagnostics: ds },
        diagnostic: emit_host_emit_vs_eval_deferred_diagnostic(at: at)
      }
  }
}

fn run_test_claim_emit_vs_eval_verdict_from_source(
  subject: v2.compiler.eval.TestClaimEvalSubject<Node>,
  target: v2.std.compilers.target_model.TargetModel,
  source_outcome: v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>>,
  claim_input_root: Node,
  expected_eval_root: Node,
  expected: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>,
  at: Node
) -> Verdict<v2.compiler.eval.TestClaimEvalSubject<Node>, RuntimeValue> {
  match source_outcome {
    v2.std.diagnostic.Accepted { value: source, diagnostics: _ } =>
      run_test_claim_emit_vs_eval_verdict_from_run(
        subject: subject,
        target: target,
        run_outcome: run_emit_host(
          target: target,
          source: source,
          fixture_inputs: inputs_for_emit_host(
            claim_input_root: claim_input_root,
            expected_eval_root: expected_eval_root,
            claim_pin: subject.input.evaluator_pin
          )
        ),
        expected: expected,
        at: at
      )
    v2.std.diagnostic.Rejected { diagnostics: ds } =>
      verdict_build_failed(
        actual: v2.std.diagnostic.Rejected { diagnostics: ds },
        diagnostic: emit_host_build_failed_diagnostic(at: at)
      )
  }
}

