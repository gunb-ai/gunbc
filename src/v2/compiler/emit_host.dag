fn run_test_claim_emit_vs_eval(
  subject: v2.compiler.eval.TestClaimEvalSubject<Node>,
  target: v2.std.compilers.target_model.TargetModel
) -> TestClaimRun<Node, RuntimeValue> {
  match subject.claim {
    EqualsClaim { rhs: rhs, label: _, anchor: _, lhs: lhs, classification: _ } =>
      run_test_claim_emit_vs_eval_run(
        subject: subject,
        target: target,
        verdict: run_test_claim_emit_vs_eval_for_claim(
          subject: subject,
          target: target,
          claim_input_root: lhs,
          expected_eval_root: rhs
        )
      )
    CompilesClaim { expected_value: expected_value, label: _, anchor: _, input: input, classification: _ } =>
      run_test_claim_emit_vs_eval_run(
        subject: subject,
        target: target,
        verdict: run_test_claim_emit_vs_eval_for_claim(
          subject: subject,
          target: target,
          claim_input_root: input,
          expected_eval_root: expected_value
        )
      )
    _ => run_test_claim(subject: subject)
  }
}

