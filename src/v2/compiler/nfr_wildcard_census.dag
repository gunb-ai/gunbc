module v2.compiler.nfr_wildcard_census

import std.algebra { Cons, Empty, FreeMonoid, fold_list, list_at_optional, list_snoc_item }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import std.types { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Arrow, Atom, Authored, ComputationNode, Disj, Instantiation, Match, MatchArmPatternEdge, Node, Positional, StructuralLabel, TypeNode, node_subtree_nodes, positional_child_target_nodes, symbol_lexeme }
import v2.std.node_query { arrow_domain_named_param_bindings, find_arrow_body_child, find_binder_type, find_core_child, is_wildcard_pattern }
import v2.std.text { String }

// THE NON-FOLD-RESIDUE WILDCARD CENSUS (a pure reader; the verb is v2.compiler.source_root_eval
// `nfr-wildcard-census`). The population it reads is the set of SITES in a module's normalized tree:
// a fn whose body holds a Match with a wildcard arm, scrutinising a plain variable that names one of
// the fn's parameters. A site's parameter type head is the declaration whose closedness decides whether
// the wildcard stands where a variant arm was available (the closed-coproduct test lives in the verb,
// which owns the cross-module lookup). The join key of a site is its fn name; the module path
// prefix is the verb's.

type WildcardSite {
  fn_name: String
  type_head: String
}

// The head spelling of a parameter's declared type: an atom, or the head of an instantiation.
// Anything else (a qualified Conj spine, an arrow) has no bare head and is Absent, which the verb counts.
fn type_head_optional(t: Node) -> Optional<String> {
  match t.kind {
    TypeNode { connective: Atom { identity: id } } => optional_present(value: symbol_lexeme(sym: id))
    TypeNode { connective: Instantiation } =>
      match list_at_optional(xs: positional_child_target_nodes(node: t), index: 0) {
        Present { value: h } => type_head_optional(t: h)
        Absent => optional_absent()
      }
    _ => optional_absent()
  }
}

type ParamHead {
  name: String
  head: Optional<String>
}

fn param_heads(arrow: Node) -> List<ParamHead> {
  match arrow_domain_named_param_bindings(arrow: arrow) {
    Rejected { diagnostics: _ } => []
    Accepted { value: names, diagnostics: _ } =>
      match list_at_optional(xs: positional_child_target_nodes(node: arrow), index: 0) {
        Absent => []
        Present { value: domain } =>
          fold(names, init: [], f: fn(acc, nm) {
              list_snoc_item(xs: acc, item: ParamHead {
                name: symbol_lexeme(sym: nm),
                head: match find_binder_type(root: domain, name: nm) {
                  Accepted { value: t, diagnostics: _ } => type_head_optional(t: t)
                  Rejected { diagnostics: _ } => optional_absent()
                }
              })
            })
      }
  }
}

fn arm_is_wildcard(arm: Node) -> Bool {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Accepted { value: pat, diagnostics: _ } => is_wildcard_pattern(pattern: pat)
    Rejected { diagnostics: _ } => false
  }
}

fn match_has_wildcard_arm(m: Node) -> Bool {
  fold(positional_child_target_nodes(node: m), init: false, f: fn(acc, c) { acc || arm_is_wildcard(arm: c) })
}

fn scrutinee_name_optional(m: Node) -> Optional<String> {
  match list_at_optional(xs: positional_child_target_nodes(node: m), index: 0) {
    Absent => optional_absent()
    Present { value: s } =>
      match s.kind {
        TypeNode { connective: Atom { identity: id } } => optional_present(value: symbol_lexeme(sym: id))
        _ => optional_absent()
      }
  }
}

fn match_node_is(n: Node) -> Bool {
  match n.kind {
    ComputationNode { behavior: Match } => true
    _ => false
  }
}

// One site per (fn, wildcard Match scrutinising one of its parameters); a fn is listed once per
// distinct parameter type head, since the join key is the fn.
fn fn_sites(fn_name: String, arrow: Node) -> List<WildcardSite> {
  let params = param_heads(arrow: arrow)
  match find_arrow_body_child(root: arrow) {
    Rejected { diagnostics: _ } => []
    Accepted { value: body, diagnostics: _ } =>
      fold(node_subtree_nodes(root: body), init: [], f: fn(acc, n) {
          if match_node_is(n: n) && match_has_wildcard_arm(m: n) {
            match scrutinee_name_optional(m: n) {
              Absent => acc
              Present { value: s } =>
                fold_list(xs: params, empty: acc, cons: fn(inner, p) {
                  if p.name == s {
                    match p.head {
                      Present { value: h } => list_snoc_item(xs: inner, item: WildcardSite { fn_name: fn_name, type_head: h })
                      Absent => inner
                    }
                  } else {
                    inner
                  }
                })
            }
          } else {
            acc
          }
        })
  }
}

fn node_is_arrow(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Arrow } => true
    _ => false
  }
}

fn root_member_sites(root: Node) -> List<WildcardSite> {
  fold(root.children, init: [], f: fn(acc, e) {
      match e.label {
        Authored { name: sym } =>
          if node_is_arrow(n: e.target) {
            fold(fn_sites(fn_name: symbol_lexeme(sym: sym), arrow: e.target), init: acc, f: fn(a2, s) { list_snoc_item(xs: a2, item: s) })
          } else {
            acc
          }
        Positional => acc
        StructuralLabel { label: _ } => acc
      }
  })
}

// A type member is a closed coproduct when its declaration subtree holds a Disj.
fn member_is_coproduct(target: Node) -> Bool {
  fold(node_subtree_nodes(root: target), init: false, f: fn(acc, n) {
      acc || (match n.kind {
        TypeNode { connective: Disj } => true
        _ => false
      })
  })
}

fn declares_coproduct_named(root: Node, name: String) -> Bool {
  fold(root.children, init: false, f: fn(acc, e) {
      acc || (match e.label {
        Authored { name: sym } => symbol_lexeme(sym: sym) == name && (node_is_arrow(n: e.target) == false) && member_is_coproduct(target: e.target)
        Positional => false
        StructuralLabel { label: _ } => false
      })
  })
}
