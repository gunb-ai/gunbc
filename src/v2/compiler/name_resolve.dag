type ImportVisibility
  = ImportVisible
  | ImportHidden

type Import {
  target: QualifiedName
  visibility: ImportVisibility
}

type ResolutionSubject {
  name: QualifiedName
}

type Admission {
  subject: ResolutionSubject
  imports: FreeMonoid<Import>
}

// Shared by every subject admitted against the same language and root collection.
// The Outcome stays with the caller so validation diagnostics retain their original
// per-subject refusal boundary when the context is constructed before admission.
// `test_code` is every root's test-marker channel keyed by the paths resolution binds to, built in
// the same pass that names the roots, so no root can be resolvable while its markers are unread.
// `blocked_members` names the members this ingest READ AND THEN REFUSED before a root existed -- a
// member blocked at the front end -- carried once from acquisition into what admission reads (DESIGN 6b:
// the earliest boundary where the wrong thing is turned into a missing root). A blocked member is neither
// a root nor absent: it was read, its content was in hand, and something refused it. Without this field
// the ONLY fact admission can state about a requester's import of it is `resolve_module_not_found`, which
// is false about a module whose bytes were read; the requester is handed a module-IDENTITY refusal for a
// module-REFUSAL. `validated_module_root_for_name` reads this field at the arm that refuses an import
// target, and mints the typed dependency refusal naming the blocked member instead (its cause stays on
// the blocked member's OWN refusal row -- this is the join identity, not a copy of the refusal).
// Census acquisition is today the only producer of blocked members; the field is on the shared
// ValidatedModuleRoots, not on a census type, so a plain native route gets the same answer the day it
// blocks a member too. A caller that has no blocks passes Empty, which is the pre-existing behaviour.
type ValidatedModuleRoots {
  roots: FreeMonoid<NormalizedTree>
  by_name: Map<QualifiedName, NormalizedTree>
  test_code: TestCodeIndex
  blocked_members: FreeMonoid<QualifiedName>
}

// THE ONE ENRICHMENT OF VALIDATED ROOTS. Validation derives the root population and cannot know what
// acquisition blocked -- a blocked member never became a root to be validated -- so the block locality
// is attached here, by the caller that owns the acquisition, and read only at the import refusal.
fn validated_module_roots_with_blocked_members(
  roots: ValidatedModuleRoots,
  blocked_members: FreeMonoid<QualifiedName>
) -> ValidatedModuleRoots {
  ValidatedModuleRoots {
    roots: roots.roots,
    by_name: roots.by_name,
    test_code: roots.test_code,
    blocked_members: blocked_members
  }
}

// Is this name a member the ingest read and then blocked? The FIRST such row, in acquisition order.
fn validated_module_roots_blocked_member(
  roots: ValidatedModuleRoots,
  name: QualifiedName
) -> Optional<QualifiedName> {
  fold_list(
    xs: roots.blocked_members,
    empty: optional_absent(),
    cons: fn(acc, blocked) {
      match acc {
        Present { value: _ } => acc
        Absent => if blocked == name { optional_present(value: blocked) } else { optional_absent() }
      }
    }
  )
}

// ONE PER INGEST (gunbc#11401 R1), AND THE HOME OF WHAT THAT INGEST'S RESOLUTION PRODUCES ONCE.
// The fields above `namespaces` are fixed when the context is built: the language, the validated roots,
// the corpus index, and the three admission inputs every subject of this ingest is admitted under
// (the source-root index, the active roots, the name-resolution policy). Binding them here is what makes
// a module's QualifiedName a COMPLETE key for its namespace: nothing a namespace depends on varies per
// demand except the admission's imports, and those are stored beside the value and compared.
//
// `namespaces` IS THE MODULE NAMESPACE PROVIDER (docs/plans/declaration-body-resolution-provider.md,
// P1). A module's admitted namespace is produced AT MOST ONCE PER INGEST, on first demand, by
// resolution_context_namespace -- the only caller of the builder namespace_for_subject_root -- and
// every later demand reads the stored value. Until this cut every resolve rebuilt its subject's
// namespace from scratch and carried it nowhere, so no second consumer could read the one the first
// built. A pure substrate has no mutable cache, so the provider is THREADED: every resolve returns the
// context it ended with (ContextResolved, ContextWalk), and a caller holding one context across
// subjects binds the returned one. A caller that drops it does not get a stale answer -- it pays the
// build again -- and `namespaces_built` is what makes that countable: it increments on every miss, so
// a context that resolved N distinct subjects and reports more than N builds rebuilt one
// (v2.test.claim.name_resolve.admission_fail_closed
// namespace_provider_builds_each_module_at_most_once_per_context).
//
// SCOPE: the modules this ingest read. A demand for a module outside `roots` refuses at the provider
// (resolve_module_not_found, located at the requested name), is recorded like any other outcome, and
// is never rebuilt from anywhere else.
type ResolutionContext {
  lm: LanguageModel
  roots: ValidatedModuleRoots
  symbol_index: SymbolIndex
  index: SourceRootIndex
  active_roots: FreeMonoid<SourceRootRef>
  policy: NameResolutionPolicy
  namespaces: Map<QualifiedName, NamespaceProviderEntry>
  namespaces_built: Int
  closure_declarations: Optional<ClosureIndex>
  type_declaration_modifiers: TypeDeclarationModifierChannel
}

// THE CLOSURE'S RESOLVED DECLARATIONS AND THE MODULE-OUTCOME ROSTER. Both are the one demand's
// product (closure_declarations_demand) and are memoized together. module_outcomes is every
// observed module, including DeclarationAvailable rows; ClosureProviderRefusal is the derived
// lookup that reads unavailability from that roster.
type ClosureIndex {
  declarations: SymbolIndex
  module_outcomes: List<ModuleOutcome>
  // The roster grouped by module and declaration path, built once with the roster; each subject walk
  // reads it with its own module excluded (v2.compiler.resolve unavailable_provider_for_path).
  outcome_index: ModuleOutcomeIndex
}

// One stored production: the admission it was produced under, and its outcome -- a refusal is
// produced once too, so a subject whose admission refused is not re-admitted by a second demand.
type NamespaceProviderEntry {
  admission: Admission
  admitted: Outcome<AdmittedSubject>
}

fn resolution_context(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy
) -> Outcome<ResolutionContext> {
  resolution_context_with_blocked_members(
    lm: lm,
    roots: roots,
    index: index,
    active_roots: active_roots,
    policy: policy,
    blocked_members: Empty
  )
}

// The context over the same root population, PLUS the members this ingest read and then refused before a
// root existed. `validated_module_roots_for_name` reads that locality at the arm that refuses an import
// target, so a requester of a blocked member is told which member blocked it instead of being told the
// module does not exist. Empty is exactly the pre-existing behaviour, which is why every caller that owns
// no blocks keeps calling `resolution_context`.
fn resolution_context_with_blocked_members(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy,
  blocked_members: FreeMonoid<QualifiedName>
) -> Outcome<ResolutionContext> {
  match validate_module_roots(roots: roots) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: validated_roots, diagnostics: d } =>
      Accepted {
        value: resolution_context_of_validated(
          lm: lm,
          roots: validated_module_roots_with_blocked_members(roots: validated_roots, blocked_members: blocked_members),
          symbol_index: symbol_index_fill_module_roots(
            index: empty_symbol_index(),
            roots: normalized_tree_roots_to_binding_sources(roots: validated_roots.roots)
          ),
          index: index,
          active_roots: active_roots,
          policy: policy
        ),
        diagnostics: d
      }
  }
}

// The context over roots a caller has already validated and indexed, with an empty provider.
fn resolution_context_of_validated(
  lm: LanguageModel,
  roots: ValidatedModuleRoots,
  symbol_index: SymbolIndex,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy
) -> ResolutionContext {
  ResolutionContext {
    lm: lm,
    roots: roots,
    symbol_index: symbol_index,
    index: index,
    active_roots: active_roots,
    policy: policy,
    namespaces: empty_map(),
    namespaces_built: 0,
    closure_declarations: optional_absent(),
    type_declaration_modifiers: type_declaration_modifier_channel_of_trees(trees: roots.roots)
  }
}

type AdmittedSubject {
  namespace: Namespace
  subject_root: NormalizedTree
}

type AdmissionState
  = AdmissionAccepted {
      bindings: Map<Symbol, Symbol>,
      origins: Map<Symbol, QualifiedName>
    }
  | AdmissionRejected { diagnostics: NonEmptyDiagnostics }

type ModuleRootValidateState
  = ModuleRootsValid { seen: Map<QualifiedName, NormalizedTree>, test_code: TestCodeIndex, diagnostics: Diagnostics }
  | ModuleRootsDuplicate { diagnostics: Diagnostics }
  | ModuleRootsProjectionRejected { diagnostics: NonEmptyDiagnostics }

fn resolve_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: invariant_port_locus(port: ^resolve_diagnostic_port, invariant: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn resolve_diagnostics(reason: Symbol) -> NonEmptyDiagnostics {
  diagnostics_singleton(d: resolve_diagnostic(reason: reason))
}

// module_root_find refuses with the exact QualifiedName sought — rendered as a dotted string on the Textual diagnostic file locus (§3: structural QN is identity; dotted form is projection for display). ModuleRootLookup is the structural authority; diagnostics project from ModuleRootMissing rather than parsing display text back.
type ModuleRootLookup
  = ModuleRootFound { root: NormalizedTree }
  | ModuleRootMissing { requested: QualifiedName }
  | ModuleRootAmbiguous { requested: QualifiedName }
  | ModuleRootLookupRejected { diagnostics: NonEmptyDiagnostics }

// WHY DeclarationLocus AND NOT A FILE NAME. The lookup already knows exactly which name is missing, as a
// `ModuleRootLookup::ModuleRootMissing { requested: QualifiedName }`. This mint used to render that name
// with `qualified_name_to_dotted_string` and hand the text to `textual_whole_file_diagnostic`, whose `at`
// slot is a FILE -- so the refusal cited a module name where a file belongs, and any reader that wanted the
// name back had to parse display text (std.diagnostic's DeclarationLocus comment names this papering-over
// precisely, and `Locus::DeclarationLocus` is the sanctioned citation for a qualified name). The requested
// name now travels as the typed value the lookup carries, and no consumer re-folds roots or imports to
// recover it -- which is what let the self-host frontier probe's second derivation be deleted.
// `ModuleRootLookupRejected` mints its own diagnostics untouched: a rejected fold is a different fact from
// an absent name and the two are never collapsed here.
fn resolve_module_not_found_diagnostic_from_missing(
  requested: QualifiedName
) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: Diagnostic {
      reason: ^resolve_module_not_found,
      at: DeclarationLocus { declaration: requested },
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}

fn resolve_module_not_found_diagnostic(name: QualifiedName) -> NonEmptyDiagnostics {
  resolve_module_not_found_diagnostic_from_missing(requested: name)
}

fn admission_initial(base: Namespace) -> AdmissionState {
  AdmissionAccepted {
    bindings: base.bindings,
    origins: empty_map()
  }
}

fn admit_export_symbol(
  sym: Symbol,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: b, origins: os } =>

      match map_get_checked(os, sym) {
        Accepted { value: opt, diagnostics: _ } => match opt {
          Present { value: _ } =>
            AdmissionRejected {
              diagnostics: resolve_diagnostics(reason: ^resolve_ambiguous_export)
            }
          Absent =>
            AdmissionAccepted {
              bindings: map_insert(m: b, key: sym, value: sym),
              origins: map_insert(m: os, key: sym, value: origin)
            }
        }
        Rejected { diagnostics: d } => AdmissionRejected { diagnostics: d }
      }
  }
}

fn validate_module_roots(roots: FreeMonoid<NormalizedTree>) -> Outcome<ValidatedModuleRoots> {
  match fold_list(
    xs: roots,
    empty: ModuleRootsValid { seen: empty_map(), test_code: test_code_index_empty(), diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, root) {
      match acc {
        ModuleRootsDuplicate { diagnostics: d } =>
          ModuleRootsDuplicate { diagnostics: d }
        ModuleRootsProjectionRejected { diagnostics: d } =>
          ModuleRootsProjectionRejected { diagnostics: d }
        ModuleRootsValid { seen: prior, test_code: prior_test_code, diagnostics: acc_diag } =>
          if well_formed(n: root.root) {
            match qualified_name_from_module_node(root: root.root) {
              Rejected { diagnostics: d } =>
                ModuleRootsProjectionRejected {
                  diagnostics: rejected_with_pending(pending: acc_diag, rejected: d)
                }
              Accepted { value: name, diagnostics: proj_diag } =>
                let merged_diag = diagnostics_merge(outer: acc_diag, inner: proj_diag)
                match map_lookup(m: prior, key: name) {
                  Absent =>
                    ModuleRootsValid {
                      seen: map_insert(m: prior, key: name, value: root),
                      test_code: test_code_index_add_module(
                        index: prior_test_code,
                        module_qn: name,
                        channel: root.test_markers
                      ),
                      diagnostics: merged_diag
                    }
                  Present { value: _ } =>
                    ModuleRootsDuplicate { diagnostics: merged_diag }
                }
            }
          } else {
            ModuleRootsProjectionRejected {
              diagnostics: rejected_with_pending(
                pending: acc_diag,
                rejected: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
              )
            }
          }
      }
    }
  ) {
    ModuleRootsValid { seen: by_name, test_code: test_code, diagnostics: d } =>
      Accepted { value: ValidatedModuleRoots { roots: roots, by_name: by_name, test_code: test_code, blocked_members: Empty }, diagnostics: d }
    ModuleRootsDuplicate { diagnostics: d } =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: d,
          rejected: resolve_diagnostics(reason: ^resolve_duplicate_module_name)
        )
      }
    ModuleRootsProjectionRejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

// Typed lookup result beside module_root_find diagnostics. ModuleRootMissing and
// ModuleRootAmbiguous preserve the exact QualifiedName sought; diagnostics are projections of these
// results for consumers that still read the Outcome directly. FOR UNVALIDATED ROOTS ONLY: it derives
// every root's module name on every call, so a consumer that holds ValidatedModuleRoots reads
// validated_module_root_for_name instead (one map read).

fn module_root_lookup(
  roots: FreeMonoid<NormalizedTree>,
  name: QualifiedName
) -> ModuleRootLookup {
  match fold_list(
    xs: roots,
    empty: Accepted { value: NoPassingCandidate, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, root) {
      match acc {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: fold_state, diagnostics: _ } =>
          match fold_state {
            ManyPassingCandidates =>
              Accepted { value: ManyPassingCandidates, diagnostics: v2.std.diagnostic.None }
            _ =>
              match qualified_name_from_module_node(root: root.root) {
                Rejected { diagnostics: d } =>
                  Rejected { diagnostics: d }
                Accepted { value: candidate, diagnostics: _ } =>
                  Accepted {
                    value: match candidate == name {
                      true =>
                        match fold_state {
                          NoPassingCandidate => OnePassingCandidate { candidate: root }
                          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
                          ManyPassingCandidates => ManyPassingCandidates
                        }
                      false => fold_state
                    },
                    diagnostics: v2.std.diagnostic.None
                  }
              }
          }
      }
    }
  ) {
    Rejected { diagnostics: d } =>
      ModuleRootLookupRejected { diagnostics: d }
    Accepted { value: fold_state, diagnostics: _ } =>
      match fold_state {
        NoPassingCandidate =>
          ModuleRootMissing { requested: name }
        OnePassingCandidate { candidate: root } =>
          ModuleRootFound { root: root }
        ManyPassingCandidates =>
          ModuleRootAmbiguous { requested: name }
      }
  }
}

fn module_root_find(
  roots: FreeMonoid<NormalizedTree>,
  name: QualifiedName
) -> Outcome<NormalizedTree> {
  match module_root_lookup(roots: roots, name: name) {
    ModuleRootFound { root: root } =>
      Accepted { value: root, diagnostics: v2.std.diagnostic.None }
    ModuleRootMissing { requested: requested } =>
      Rejected {
        diagnostics: resolve_module_not_found_diagnostic_from_missing(
          requested: requested
        )
      }
    ModuleRootAmbiguous { requested: _ } =>
      Rejected { diagnostics: resolve_diagnostics(reason: ^resolve_duplicate_module_name) }
    ModuleRootLookupRejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

// Parse-projection edges (identity / captured projections, sequence spines) are
// machinery, not exports -- the same rule symbol_index_fill_containment_edge
// applies. The body's identity projection reaches this fold as a direct child.
fn try_admitted_export_binding(e: Edge) -> DeclaredBinding? {
  match try_edge_declared_binding(e: e) {
    Present { value: b } =>
      if parse_tree_projection_edge(name: b.name) {
        optional_absent()
      } else {
        optional_present(value: b)
      }
    Absent => optional_absent()
  }
}

type AdmitExportsFold {
  origin: QualifiedName
  state: AdmissionState
  at_conj: Bool
  scope: ExportAdmissionScope
}

// WHOSE NAMES AN ADMISSION READS. The subject's OWN body is the scope the operator's nesting ban governs:
// a service namespace it declares is a path segment, never a bare binding, so its members are reached
// qualified. An IMPORTED module's exports are the sanctioned route by which a service's name enters a
// module bare: `import t` admits t's service `s`, and `s.F.Run` then resolves in the importer (XL-2
// manager ruling, 2026-10-02).
type ExportAdmissionScope
  = OwnModuleBody
  | ImportedModuleExports

// A SERVICE NAMESPACE OF THE SUBJECT'S OWN BODY IS NOT ADMITTED AS A BARE NAME (v2.compiler.lexical_scope
// module_binding_edge_is_namespace_body). This is the multi-root route's counterpart of the single-tree
// module-root harvest, so both resolution entries agree on the subject's own names; an imported module's
// service namespaces are admitted as any export is.
fn admit_named_export_edge(
  edge: Edge,
  origin: QualifiedName,
  state: AdmissionState,
  scope: ExportAdmissionScope
) -> AdmissionState {
  if export_edge_is_withheld(edge: edge, scope: scope) {
    state
  } else {
    match try_admitted_export_binding(e: edge) {
      Present { value: b } =>
        admit_export_symbol(sym: b.name, origin: origin, state: state)
      Absent => state
    }
  }
}

fn export_edge_is_withheld(edge: Edge, scope: ExportAdmissionScope) -> Bool {
  match scope {
    OwnModuleBody => module_binding_edge_is_namespace_body(e: edge)
    ImportedModuleExports => false
  }
}

fn named_exports_topdown_algebra() -> NodeFoldTopDown<AdmitExportsFold, AdmitExportsFold> {
  NodeFoldTopDown {
    init: fn(n, fold) {
      AdmitExportsFold {
        origin: fold.origin,
        state: fold.state,
        at_conj: match n.kind {
          TypeNode { connective: Conj } => true
          TypeNode { connective: Atom { identity: _ } } => false
          TypeNode { connective: Disj } => false
          TypeNode { connective: Arrow } => false
          TypeNode { connective: Instantiation } => false
          ComputationNode { behavior: _ } => false
        },
        scope: fold.scope
      }
    },
    child_context: fn(n, fold, e) { fold },
    step: fn(acc, e, child_r) {
      if acc.at_conj {
        AdmitExportsFold {
          origin: acc.origin,
          state: admit_named_export_edge(
            edge: e,
            origin: acc.origin,
            state: acc.state,
            scope: acc.scope
          ),
          at_conj: true,
          scope: acc.scope
        }
      } else {
        child_r
      }
    }
  }
}

fn admit_named_exports(
  root: Node,
  origin: QualifiedName,
  state: AdmissionState,
  scope: ExportAdmissionScope
) -> AdmissionState {
  let working = namespace_graft_module_body_root(root: root)
  match working.kind {
    TypeNode { connective: Conj } =>
      match fold_node_topdown(
        n: working,
        ctx: AdmitExportsFold {
          origin: origin,
          state: state,
          at_conj: false,
          scope: scope
        },
        algebra: named_exports_topdown_algebra()
      ) {
        AdmitExportsFold { state: folded_state, origin: _, at_conj: _, scope: _ } =>
          folded_state
      }
    TypeNode { connective: Atom { identity: _ } } => state
    TypeNode { connective: Disj } => state
    TypeNode { connective: Arrow } => state
    TypeNode { connective: Instantiation } => state
    ComputationNode { behavior: _ } => state
  }
}

fn admit_import_root_find(
  found: Outcome<NormalizedTree>,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match found {
    Rejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    Accepted { value: imported_root, diagnostics: _ } =>
      if well_formed(n: imported_root.root) {
        admit_named_exports(
          root: imported_root.root,
          origin: origin,
          state: state,
          scope: ImportedModuleExports
        )
      } else {
        AdmissionRejected {
          diagnostics: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
        }
      }
  }
}

fn admit_import_visible_entry(
  roots: ValidatedModuleRoots,
  import_edge: Import,
  state: AdmissionState
) -> AdmissionState {
  admit_import_root_find(
    found: validated_module_root_for_name(
      roots: roots,
      name: import_edge.target
    ),
    origin: import_edge.target,
    state: state
  )
}

// AN IMPORT-ADMISSION REFUSAL IS LOCATED AT THE IMPORT THAT CAUSED IT, when the caller holds that
// import's authored locus: NamespaceOnlyY's captured module targets carry the import declaration's own
// span (v2.std.namespace_alias CapturedImportTarget), exactly the locus the module-not-found arm
// already reports (admit_imported_module_existence). A caller that carries no locus -- ImportScoped's
// caller-supplied Import, a captured alias row (v2.std.namespace_alias AliasBindingRow carries none) --
// passes Absent, and the refusal keeps the port's typed invariant locus: an absence the census
// reports as FileRefusalAtInvariant, never a position borrowed from another occurrence.
fn import_admission_diagnostics(reason: Symbol, at: Optional<Locus>) -> NonEmptyDiagnostics {
  match at {
    Present { value: locus } =>
      diagnostics_singleton(d: Diagnostic {
        reason: reason,
        at: locus,
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    Absent => resolve_diagnostics(reason: reason)
  }
}

// THE ONE CROSS-TREE GATE. ImportScoped then merges named exports (admit_import_entry);
// NamespaceOnlyY records listed-name origins from captured rows (admit_captured_import_rows)
// without a second cross_tree_edge_decision.
fn admit_import_cross_tree_gate(
  import_edge: Import,
  at: Optional<Locus>,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: _, origins: _ } =>
      match import_edge.visibility {
        ImportHidden =>
          AdmissionRejected {
            diagnostics: import_admission_diagnostics(reason: ^resolve_import_not_visible, at: at)
          }
        ImportVisible =>
          match v2.std.cross_tree.resolution.cross_tree_edge_decision(
            index: index,
            from_qn: subject_qn,
            to_qn: import_edge.target,
            active_roots: active_roots
          ) {
            EdgeNormalResolution => state
            EdgeCrossAdmitted => state
            EdgeCrossDenied =>
              AdmissionRejected {
                diagnostics: import_admission_diagnostics(reason: ^resolve_cross_tree_import_denied, at: at)
              }
            EdgeCrossAmbiguous =>
              AdmissionRejected {
                diagnostics: import_admission_diagnostics(reason: ^resolve_cross_tree_import_ambiguous, at: at)
              }
          }
      }
  }
}

fn admit_import_entry(
  roots: ValidatedModuleRoots,
  import_edge: Import,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  match admit_import_cross_tree_gate(
    import_edge: import_edge,
    at: optional_absent(),
    state: state,
    subject_qn: subject_qn,
    index: index,
    active_roots: active_roots
  ) {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: _, origins: _ } =>
      admit_import_visible_entry(roots: roots, import_edge: import_edge, state: state)
  }
}

fn admit_imports(
  roots: ValidatedModuleRoots,
  imports: FreeMonoid<Import>,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  fold_list(
    xs: imports,
    empty: state,
    cons: fn(acc, import_edge) {
      admit_import_entry(
        roots: roots,
        import_edge: import_edge,
        state: acc,
        subject_qn: subject_qn,
        index: index,
        active_roots: active_roots
      )
    }
  )
}

fn admission_namespace_base(canonical_symbols: PointwisePower<Symbol>) -> Namespace {
  Namespace {
    bindings: empty_map(),
    canonical_symbols: canonical_symbols,
    symbol_index: empty_symbol_index(),
    module_qn: Empty,
    test_code: test_code_index_empty(),
    declared_in: Empty,
    imported_origins: empty_map(),
    module_outcomes: empty_module_outcome_index()
  }
}

fn import_edge_from_binding_row(row: AliasBindingRow) -> Import {
  Import {
    target: qualified_name_init(qn: row.target),
    visibility: ImportVisible
  }
}

// AN IMPORT NAMES A DEPENDENCY WHETHER OR NOT ANY NAME FROM IT IS DEMANDED. NamespaceOnlyY
// previously admitted only captured alias rows, so a missing module whose listed names were unused
// (or whose block was empty) never reached module_root_find. Existence is judged here without
// merging the imported module's exports (that merge is ImportScoped / admit_import_visible_entry).
fn admit_imported_module_existence(
  roots: ValidatedModuleRoots,
  located: CapturedImportTarget,
  state: AdmissionState
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: _, origins: _ } =>
      match validated_module_root_for_name(roots: roots, name: located.target) {
        Rejected { diagnostics: d } =>
          AdmissionRejected {
            diagnostics: NonEmptyDiagnostics {
              head: Diagnostic {
                reason: d.head.reason,
                at: located.at,
                correction: d.head.correction
              },
              tail: d.tail
            }
          }
        Accepted { value: _, diagnostics: _ } => state
      }
  }
}

fn admit_imported_modules(
  roots: ValidatedModuleRoots,
  modules: FreeMonoid<CapturedImportTarget>,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  fold_list(
    xs: modules,
    empty: state,
    cons: fn(acc, located) {
      let edge = Import { target: located.target, visibility: ImportVisible }
      match admit_import_cross_tree_gate(
        import_edge: edge,
        at: optional_present(value: located.at),
        state: acc,
        subject_qn: subject_qn,
        index: index,
        active_roots: active_roots
      ) {
        AdmissionRejected { diagnostics: d } =>
          AdmissionRejected { diagnostics: d }
        AdmissionAccepted { bindings: _, origins: _ } =>
          admit_imported_module_existence(roots: roots, located: located, state: acc)
      }
    }
  )
}

fn admit_captured_import_rows(
  rows: FreeMonoid<AliasBindingRow>,
  state: AdmissionState,
  subject_qn: QualifiedName,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> AdmissionState {
  fold_list(
    xs: rows,
    empty: state,
    cons: fn(acc, row) {
      match admit_import_cross_tree_gate(
        import_edge: import_edge_from_binding_row(row: row),
        at: optional_absent(),
        state: acc,
        subject_qn: subject_qn,
        index: index,
        active_roots: active_roots
      ) {
        AdmissionRejected { diagnostics: d } =>
          AdmissionRejected { diagnostics: d }
        AdmissionAccepted { bindings: b, origins: o } =>
          AdmissionAccepted {
            bindings: b,
            origins: map_insert(m: o, key: row.binding, value: qualified_name_init(qn: row.target))
          }
      }
    }
  )
}

// THE ONE POST-VALIDATION READ OF A MODULE'S ROOT BY NAME. validate_module_roots derives every root's
// module name exactly once and keeps the result as ValidatedModuleRoots.by_name, refusing a duplicate
// name or a root whose name cannot be read for the whole context; so after validation a name names at
// most one root and the lookup is one map read. Every consumer holding validated roots -- the
// subject's own root and each import's target (admit_import_visible_entry,
// admit_imported_module_existence) -- reads here. module_root_lookup's scan, which re-derives every
// root's name per call, is only for roots nobody has validated.
// A blocked member is a name the ingest READ AND THEN REFUSED before a root existed, so it is exactly the
// name that is neither in `by_name` nor absent. Stating `resolve_module_not_found` for it is false (DESIGN
// 5), so this arm reads the acquisition's block locality and mints the typed dependency refusal naming the
// blocked member. The blocked member's OWN refusal row keeps its cause; `DeclarerRefused { declarer }` is
// the identity a census joins on (std.diagnostic), not a second copy of that cause. `at` cites the
// requested name as a declaration, exactly as the sibling `resolve_module_not_found_diagnostic_from_missing`
// arm does -- the two arms of ONE lookup differ only in which fact they state, so they must not differ in
// how they cite (DESIGN 6b: a fork between sibling leaves is the same defect as a fork between routes).
// This function knows only the names; the located caller, `admit_imported_module_existence`, re-stamps
// head.reason and head.correction onto the import's own authored locus, which is where the span comes from.
fn resolve_imported_module_refused_diagnostic(
  requested: QualifiedName,
  blocked: QualifiedName
) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: Diagnostic {
      reason: ^resolve_imported_module_refused,
      at: DeclarationLocus { declaration: requested },
      correction: Unavailable { reason: DeclarerRefused { declarer: blocked } }
    }
  )
}

fn validated_module_root_for_name(
  roots: ValidatedModuleRoots,
  name: QualifiedName
) -> Outcome<NormalizedTree> {
  match map_lookup(m: roots.by_name, key: name) {
    Present { value: root } => Accepted { value: root, diagnostics: v2.std.diagnostic.None }
    Absent => match validated_module_roots_blocked_member(roots: roots, name: name) {
      Present { value: blocked } =>
        Rejected { diagnostics: resolve_imported_module_refused_diagnostic(requested: name, blocked: blocked) }
      Absent => Rejected { diagnostics: resolve_module_not_found_diagnostic_from_missing(requested: name) }
    }
  }
}

// The subject root's member-kind channel, read from the validated roots by the subject's own name. A subject
// with no root there has no provenance to give, which is Unavailable and not a refusal here: the module-not-found
// refusal already belongs to admission.
fn subject_member_kind_channel(roots: ValidatedModuleRoots, name: QualifiedName) -> Outcome<MemberKindChannel> {
  match map_lookup(m: roots.by_name, key: name) {
    Present { value: root } => member_kind_channel_of_tree(tree: root)
    Absent => Accepted { value: no_member_declaration_kinds(), diagnostics: v2.std.diagnostic.None }
  }
}

fn namespace_admission_initial_state(
  policy: NameResolutionPolicy,
  canonical_symbols: PointwisePower<Symbol>,
  subject_module_root: NormalizedTree,
  subject_qn: QualifiedName
) -> AdmissionState {
  let base = admission_namespace_base(canonical_symbols: canonical_symbols)
  match policy {
    NamespaceOnlyY =>
      admission_initial(base: base)
    ImportScoped =>
      admit_named_exports(
        root: subject_module_root.root,
        origin: subject_qn,
        state: admission_initial(base: base),
        scope: OwnModuleBody
      )
  }
}

fn admitted_subject_from_bindings(
  bindings: Map<Symbol, Symbol>,
  base: Namespace,
  subject_module_root: NormalizedTree,
  symbol_index: SymbolIndex,
  module_qn: QualifiedName,
  origins: Map<Symbol, QualifiedName>,
  test_code: TestCodeIndex
) -> AdmittedSubject {
  AdmittedSubject {
    namespace: Namespace {
      bindings: namespace_bindings_augment_from_module_atoms(
        root: subject_module_root.root,
        bindings: bindings
      ),
      canonical_symbols: base.canonical_symbols,
      symbol_index: symbol_index,
      module_qn: module_qn,
      test_code: test_code,
      declared_in: module_qn,
      imported_origins: origins,
      module_outcomes: empty_module_outcome_index()
    },
    subject_root: subject_module_root
  }
}

// THE NAMESPACE PROVIDER'S ONE DOOR: the stored namespace of the admission's subject, or -- on the
// first demand in this ingest -- the one namespace_for_subject_root produces, stored before it is
// returned. A demand whose imports differ from the stored admission's REFUSES rather than being
// served a namespace produced from different inputs, and rather than overwriting the stored one
// (resolve_reason_namespace_provider_admission_conflict, located at the subject's name).
type NamespaceDemand {
  admitted: Outcome<AdmittedSubject>
  context: ResolutionContext
}

fn resolution_context_namespace(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  admission: Admission
) -> NamespaceDemand {
  match map_lookup(m: shared.namespaces, key: admission.subject.name) {
    Present { value: entry } =>
      if entry.admission == admission {
        NamespaceDemand { admitted: entry.admitted, context: shared }
      } else {
        NamespaceDemand {
          admitted: Rejected { diagnostics: namespace_provider_admission_conflict_diagnostic(name: admission.subject.name) },
          context: shared
        }
      }
    Absent =>
      let admitted = namespace_for_subject_produced(shared: shared, validate_diag: validate_diag, admission: admission)
      NamespaceDemand {
        admitted: admitted,
        context: ResolutionContext {
          lm: shared.lm,
          roots: shared.roots,
          symbol_index: shared.symbol_index,
          index: shared.index,
          active_roots: shared.active_roots,
          policy: shared.policy,
          namespaces: map_insert(
            m: shared.namespaces,
            key: admission.subject.name,
            value: NamespaceProviderEntry { admission: admission, admitted: admitted }
          ),
          namespaces_built: shared.namespaces_built + 1,
          closure_declarations: shared.closure_declarations,
          type_declaration_modifiers: shared.type_declaration_modifiers
        }
      }
  }
}

fn namespace_provider_admission_conflict_diagnostic(name: QualifiedName) -> NonEmptyDiagnostics {
  diagnostics_singleton(
    d: textual_whole_file_diagnostic(
      reason: ^resolve_reason_namespace_provider_admission_conflict,
      module_file: symbol_intern_lexeme(lexeme: qualified_name_to_dotted_string(qn: name)),
      correction: Unavailable { reason: ExternalContractUnknown }
    )
  )
}

// The provider's miss arm and nothing else: the subject's root, located, then its admission.
fn namespace_for_subject_produced(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  admission: Admission
) -> Outcome<AdmittedSubject> {
  match validated_module_root_for_name(roots: shared.roots, name: admission.subject.name) {
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: rejected_with_pending(pending: validate_diag, rejected: r) }
    Accepted { value: subject_module_root, diagnostics: _ } =>
      namespace_for_subject_root(
        shared: shared,
        validate_diag: validate_diag,
        subject_module_root: subject_module_root,
        admission: admission,
        index: shared.index,
        active_roots: shared.active_roots,
        policy: shared.policy
      )
  }
}

// Subject-local namespace work is observed separately from root lookup and traversal.
fn namespace_for_subject_root(
  shared: ResolutionContext,
  validate_diag: Diagnostics,
  subject_module_root: NormalizedTree,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy
) -> Outcome<AdmittedSubject> {
  let validated_roots = shared.roots
  if well_formed(n: subject_module_root.root) {
    let base = admission_namespace_base(canonical_symbols: shared.lm.canonical_symbols)
    let initial = namespace_admission_initial_state(
      policy: policy,
      canonical_symbols: shared.lm.canonical_symbols,
      subject_module_root: subject_module_root,
      subject_qn: admission.subject.name
    )
    match policy {
      NamespaceOnlyY =>
        match initial {
          AdmissionRejected { diagnostics: d } =>
            Rejected {
              diagnostics: rejected_with_pending(pending: validate_diag, rejected: d)
            }
          AdmissionAccepted { bindings: _, origins: _ } =>
            match admit_imported_modules(
              roots: validated_roots,
              modules: normalized_tree_imported_modules(tree: subject_module_root),
              state: initial,
              subject_qn: admission.subject.name,
              index: index,
              active_roots: active_roots
            ) {
              AdmissionRejected { diagnostics: missing } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: validate_diag, rejected: missing)
                }
              AdmissionAccepted { bindings: _, origins: _ } =>
            match admit_captured_import_rows(
              rows: normalized_tree_import_bindings(tree: subject_module_root),
              state: initial,
              subject_qn: admission.subject.name,
              index: index,
              active_roots: active_roots
            ) {
              AdmissionRejected { diagnostics: denied } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: validate_diag, rejected: denied)
                }
              AdmissionAccepted { bindings: b, origins: o } =>
                Accepted {
                  value: admitted_subject_from_bindings(
                    bindings: b,
                    base: base,
                    subject_module_root: subject_module_root,
                    symbol_index: shared.symbol_index,
                    module_qn: admission.subject.name,
                    origins: o,
                    test_code: shared.roots.test_code
                  ),
                  diagnostics: validate_diag
                }
            }
            }
        }
      ImportScoped =>
        match admit_imports(
          roots: validated_roots,
          imports: admission.imports,
          state: initial,
          subject_qn: admission.subject.name,
          index: index,
          active_roots: active_roots
        ) {
          AdmissionAccepted { bindings: b, origins: o } =>
            Accepted {
              value: admitted_subject_from_bindings(
                bindings: b,
                base: base,
                subject_module_root: subject_module_root,
                symbol_index: shared.symbol_index,
                module_qn: admission.subject.name,
                origins: o,
                test_code: shared.roots.test_code
              ),
              diagnostics: validate_diag
            }
          AdmissionRejected { diagnostics: d } =>
            Rejected {
              diagnostics: rejected_with_pending(pending: validate_diag, rejected: d)
            }
        }
    }
  } else {
    Rejected {
      diagnostics: rejected_with_pending(
        pending: validate_diag,
        rejected: resolve_diagnostics(reason: ^resolve_reason_malformed_imported_root)
      )
    }
  }
}

// ONE SUBJECT IN A FRESH CONTEXT: the context is built here and dropped here, so its provider serves
// exactly this resolution. A caller resolving more than one subject over one ingest holds a context
// and goes through resolve_in_context instead.
fn resolve_with_admission_policy(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>,
  policy: NameResolutionPolicy
) -> Outcome<ResolvedTree> {
  resolve_in_context(
    context: resolution_context(lm: lm, roots: roots, index: index, active_roots: active_roots, policy: policy),
    admission: admission
  ).resolved
}

// A resolution over a held context, and the context it ends with.
type ContextResolved {
  resolved: Outcome<ResolvedTree>
  context: Outcome<ResolutionContext>
}

type ContextWalk {
  walk: ResolveNodeWalk
  context: Outcome<ResolutionContext>
}

// The admitted namespace is built over the context's own index, so that index is the one this
// resolution consulted. A refused context resolved nothing.
// Member lookup during the walk is kind-aware: v2.compiler.resolve
// lookup_symbol_index_atom_identity filters the lexical population with
// std.occurrence_binding_resolve occurrence_category_binding_verdict before
// symbol_index_lexical_selection (none/one/many). This door only admits the
// subject; it does not pick among same-spelling kinds.
fn resolve_in_context(context: Outcome<ResolutionContext>, admission: Admission) -> ContextResolved {
  match context {
    Rejected { diagnostics: r } =>
      ContextResolved { resolved: Rejected { diagnostics: r }, context: context }
    Accepted { value: shared, diagnostics: d } =>
      let closure = closure_declarations_demand(shared: shared)
      // THE CLOSURE'S NAMESPACES ARE ITS OWN KEYSPACE. closure_phase1_walk_module admits every module under
      // imports: [], an admission that is no caller's; the provider keys a module by name alone, so
      // merging those entries would refuse each subject's own admission (namespace provider admission
      // conflict). The walk reads the caller's provider plus the closure index, and returns that context.
      let walk_context = ResolutionContext {
        lm: shared.lm,
        roots: shared.roots,
        symbol_index: shared.symbol_index,
        index: shared.index,
        active_roots: shared.active_roots,
        policy: shared.policy,
        namespaces: shared.namespaces,
        namespaces_built: shared.namespaces_built,
        closure_declarations: closure.context.closure_declarations,
        type_declaration_modifiers: closure.context.type_declaration_modifiers
      }
      let walked = resolve_walk_in_context(
        context: Accepted { value: walk_context, diagnostics: d },
        admission: admission
      )
      match walked.context {
        Rejected { diagnostics: r } => ContextResolved { resolved: Rejected { diagnostics: r }, context: walked.context }
        Accepted { value: after, diagnostics: d2 } =>
          ContextResolved {
            resolved: match subject_member_kind_channel(roots: after.roots, name: admission.subject.name) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: channel, diagnostics: _ } =>
                resolved_tree_outcome(
                  w: walked.walk,
                  symbol_index: after.symbol_index,
                  closure_declarations: closure.declarations,
                  module_outcomes: closure.module_outcomes,
                  outcome_index: closure.outcome_index,
                  member_kinds: channel,
                  type_declaration_modifiers: after.type_declaration_modifiers
                )
            },
            context: Accepted { value: after, diagnostics: d2 }
          }
      }
  }
}

// EVERY ROOT IN THE CLOSURE, RESOLVED ONCE PER CONTEXT, so inference can retrieve a declaration an imported
// provider owns. v2.compiler.resolve resolved_declarations_of walks ONE root, so the subject's index held only
// the subject's declarations and every cross-module field read refused -- measured as
// fps_a_cross_module_record_projection_infers against a passing same-module control.
//
// ONCE PER CONTEXT, NOT ONCE PER SUBJECT. Every subject a context resolves demands the same closure index,
// and the shared ResolutionContext is their least common ancestor (DESIGN section 2), so the index is
// produced on the first demand and carried on the context like the namespace provider beside it; a later
// subject reads it. Recomputing it per subject made a lane of N modules do N x (N + 1) resolves, and folding
// the roots per subject was a second quadratic term (review 74212). The per-root resolves thread the context
// they are given, so the namespaces they admit are kept as well.
//
// THE RECURSION IS CUT BY THE PER-ROOT RESOLVES NOT ASKING FOR A CLOSURE: each provider is walked by
// resolve_walk_in_context exactly as any subject is, and only resolved_tree_of reads the collected index. A
// provider does not need the closure index to produce the declarations this fold reads from it.
//
// A REFUSED ROOT CONTRIBUTES NO DECLARATIONS AND DOES NOT FAIL THE FOLD, AND ITS REFUSAL IS KEPT. It does not
// widen an answer or substitute a reading -- but contributing nothing SILENTLY was the absorbing fallback's
// other half: a consumer's miss could not say the provider never resolved, so the provider's defect never
// ranked. Its module and its first refusal chain are recorded (ClosureProviderRefusal) and reach every
// lookup miss through v2.compiler.resolve resolved_tree_unavailable_provider. A provider that cannot resolve has no
// resolved declarations to offer, and every declaration that mentions one of them -- through any declaration
// it sits in, a refused coproduct's variant included (closure_callee_blocking_refusal) -- is blocked too, so a
// subject naming any of them refuses at RESOLVE, resolve_reason_declarer_refused carrying the provider's chain
// (v2.compiler.resolve unavailable_provider_for_path), the located refusal that names the missing evidence.
//
// THIS IS THE ONE-SEAT FORM OF A DEPENDENCY THE DEMAND ENGINE OWNS. Infer(module) depends on
// Resolve(module) AND Resolve(each provider it consumes); here that is discharged by resolving the whole
// SELECTED closure, which is broader than the import closure. Narrowing it to the exact provider set changes
// WHICH roots are folded and not the inference rule.
type ClosureDeclarations {
  declarations: SymbolIndex
  module_outcomes: List<ModuleOutcome>
  outcome_index: ModuleOutcomeIndex
  context: ResolutionContext
}

type DeclLocalOutcome
  = LocallyResolved { node: Node }
  | LocallyRefused { refusal: NonEmptyDiagnostics }

type DeclPhase1Row {
  module: QualifiedName
  name: Symbol
  path: QualifiedName
  local: DeclLocalOutcome
  callees: List<QualifiedName>
}

type ClosurePhase1Acc {
  rows: List<DeclPhase1Row>
  unavailable: List<ModuleOutcome>
  trees: List<NormalizedTree>
  context: ResolutionContext
}

fn closure_collect_declaration_callees(n: Node, acc: List<QualifiedName>) -> List<QualifiedName> {
  let here = match declaration_reference_path_optional(node: n) {
    Present { value: qn } => list_snoc_item(xs: acc, item: qn)
    Absent => acc
  }
  fold(n.children, init: here, f: fn(a, e) { closure_collect_declaration_callees(n: e.target, acc: a) })
}

fn closure_unavailable_by_module(
  unavailable: List<ModuleOutcome>
) -> Map<QualifiedName, NonEmptyDiagnostics> {
  let empty: Map<QualifiedName, NonEmptyDiagnostics> = empty_map()
  fold_list(xs: unavailable, empty: empty, cons: fn(acc, o) {
    match o {
      ModuleUnavailable { module: m, refusal: r } => map_insert(m: acc, key: m, value: r)
      ModuleObserved { module: _, declarations: _ } => acc
    }
  })
}

// THE CALLEE'S OWNING MODULE IS THE FILL-TIME ONE (v2.std.symbol_index symbol_index_owning_module_of),
// never the path less its last segment: that is the module only for a module-root declaration, and for a
// variant (`v2.b.T.V`) it is the coproduct.
fn closure_unavailable_owner_refusal(
  index: SymbolIndex,
  unavailable: Map<QualifiedName, NonEmptyDiagnostics>,
  callee: QualifiedName
) -> Optional<NonEmptyDiagnostics> {
  match symbol_index_owning_module_of(index: index, path: callee) {
    Present { value: owner } => map_lookup(m: unavailable, key: owner)
    Absent => optional_absent()
  }
}

// A CALLEE IS BLOCKED WHEN THE ROW IT SITS IN IS: availability is recorded per module-root declaration,
// so a variant of a blocked coproduct is read through the coproduct's row
// (v2.std.symbol_index symbol_index_enclosing_declaration_paths, the reader resolve's provider lookup
// shares), never by its own exact path, which no row carries.
fn closure_callee_blocking_refusal(
  index: SymbolIndex,
  blocked: Map<QualifiedName, NonEmptyDiagnostics>,
  unavailable: Map<QualifiedName, NonEmptyDiagnostics>,
  callee: QualifiedName
) -> Optional<NonEmptyDiagnostics> {
  match fold_list(xs: symbol_index_enclosing_declaration_paths(index: index, path: callee), empty: optional_absent(), cons: fn(found, enclosing) {
    match found {
      Present { value: _ } => found
      Absent => map_lookup(m: blocked, key: enclosing)
    }
  }) {
    Present { value: r } => optional_present(value: r)
    Absent => closure_unavailable_owner_refusal(index: index, unavailable: unavailable, callee: callee)
  }
}

// THE PUBLISHED ROOT KEEPS ITS MODULE SHELL AND SPINE WHOLE. Only the marked module body's members are
// declarations: the shell's grammar_production_* edges and each spine segment are Authored edges too, but
// they name the module, not a declaration, and dropping them leaves a root whose name
// qualified_name_from_module_node cannot read -- the fill then indexes nothing for the module.
fn closure_filter_root_published(root: Node, published: Map<Symbol, Node>) -> Node {
  if namespace_graft_node_is_module_body(node: root) {
    Node {
      kind: root.kind,
      children: fold(root.children, init: [], f: fn(acc, e) {
        if module_binding_edge_is_namespace_body(e: e) {
          list_snoc_item(
            xs: acc,
            item: Edge { label: e.label, target: closure_filter_root_published(root: e.target, published: published), declaration: e.declaration }
          )
        } else {
          match try_edge_declared_binding(e: e) {
            Present { value: b } =>
              match map_lookup(m: published, key: b.name) {
                Present { value: resolved } =>
                  list_snoc_item(xs: acc, item: Edge { label: e.label, target: resolved, declaration: e.declaration })
                Absent => acc
              }
            Absent => list_snoc_item(xs: acc, item: e)
          }
        }
      }),
      occurrence_id: root.occurrence_id
    }
  } else {
    Node {
      kind: root.kind,
      children: fold(root.children, init: [], f: fn(acc, e) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: e.label, target: closure_filter_root_published(root: e.target, published: published), declaration: e.declaration }
        )
      }),
      occurrence_id: root.occurrence_id
    }
  }
}

fn closure_symbols_published(xs: FreeMonoid<Symbol>, published: Map<Symbol, Node>) -> FreeMonoid<Symbol> {
  fold_list(xs: xs, empty: Empty, cons: fn(acc, s) {
    match map_lookup(m: published, key: s) {
      Present { value: _ } => list_snoc_item(xs: acc, item: s)
      Absent => acc
    }
  })
}

fn closure_qn_vertex(qn: QualifiedName) -> String {
  symbol_lexeme(sym: symbol_intern_lexeme(lexeme: qualified_name_to_dotted_string(qn: qn)))
}

fn closure_decl_name_list(rows: List<DeclPhase1Row>) -> List<String> {
  fold_list(xs: rows, empty: [], cons: fn(acc, row) {
    list_snoc_item(xs: acc, item: closure_qn_vertex(qn: row.path))
  })
}

fn closure_decl_call_graph(rows: List<DeclPhase1Row>) -> CallGraph {
  CallGraph {
    edges: fold_list(xs: rows, empty: [], cons: fn(acc, row) {
      fold_list(xs: row.callees, empty: acc, cons: fn(eacc, callee) {
        if callee == row.path {
          eacc
        } else {
          list_snoc_item(
            xs: eacc,
            item: GraphEdge {
              caller: closure_qn_vertex(qn: row.path),
              callee: closure_qn_vertex(qn: callee)
            }
          )
        }
      })
    })
  }
}

fn closure_rows_by_path(rows: List<DeclPhase1Row>) -> Map<String, DeclPhase1Row> {
  let empty: Map<String, DeclPhase1Row> = empty_map()
  fold_list(xs: rows, empty: empty, cons: fn(acc, row) {
    map_insert(m: acc, key: closure_qn_vertex(qn: row.path), value: row)
  })
}

fn closure_row_at(rows: Map<String, DeclPhase1Row>, path: String) -> Optional<DeclPhase1Row> {
  map_lookup(m: rows, key: path)
}

fn closure_reverse_components(xs: List<List<String>>) -> List<List<String>> {
  fold_list(xs: xs, empty: [], cons: fn(acc, c) { Cons { head: c, tail: acc } })
}

fn closure_component_blocking_refusal(
  index: SymbolIndex,
  rows: Map<String, DeclPhase1Row>,
  blocked: Map<QualifiedName, NonEmptyDiagnostics>,
  unavailable: Map<QualifiedName, NonEmptyDiagnostics>,
  component: List<String>
) -> Optional<NonEmptyDiagnostics> {
  fold_list(xs: component, empty: optional_absent(), cons: fn(found, name) {
    match found {
      Present { value: _ } => found
      Absent =>
        match closure_row_at(rows: rows, path: name) {
          Absent => found
          Present { value: row } =>
            match row.local {
              LocallyRefused { refusal: r } => optional_present(value: r)
              LocallyResolved { node: _ } =>
                fold_list(xs: row.callees, empty: found, cons: fn(hit, callee) {
                  match hit {
                    Present { value: _ } => hit
                    Absent =>
                      if callee == row.path {
                        hit
                      } else {
                        closure_callee_blocking_refusal(
                          index: index,
                          blocked: blocked,
                          unavailable: unavailable,
                          callee: callee
                        )
                      }
                  }
                })
            }
        }
    }
  })
}

fn closure_phase2_blocked(
  index: SymbolIndex,
  rows: List<DeclPhase1Row>,
  unavailable: List<ModuleOutcome>
) -> Map<QualifiedName, NonEmptyDiagnostics> {
  let by_path = closure_rows_by_path(rows: rows)
  let unavailable_by_module = closure_unavailable_by_module(unavailable: unavailable)
  let seed_empty: Map<QualifiedName, NonEmptyDiagnostics> = empty_map()
  let seed = fold_list(xs: rows, empty: seed_empty, cons: fn(acc, row) {
    match row.local {
      LocallyResolved { node: _ } => acc
      LocallyRefused { refusal: r } => map_insert(m: acc, key: row.path, value: r)
    }
  })
  let components = closure_reverse_components(
    xs: graph_strongly_connected_components(
      names: closure_decl_name_list(rows: rows),
      graph: closure_decl_call_graph(rows: rows)
    )
  )
  fold_list(xs: components, empty: seed, cons: fn(blocked, component) {
    match closure_component_blocking_refusal(
      index: index,
      rows: by_path,
      blocked: blocked,
      unavailable: unavailable_by_module,
      component: component
    ) {
      Absent => blocked
      Present { value: r } =>
        fold_list(xs: component, empty: blocked, cons: fn(acc, name) {
          match closure_row_at(rows: by_path, path: name) {
            Absent => acc
            Present { value: row } => map_insert(m: acc, key: row.path, value: r)
          }
        })
    }
  })
}

fn closure_publish_module(
  nt: NormalizedTree,
  module_qn: QualifiedName,
  rows: List<DeclPhase1Row>,
  blocked: Map<QualifiedName, NonEmptyDiagnostics>,
  index: SymbolIndex
) -> SymbolIndex {
  let published = fold_list(xs: rows, empty: empty_map(), cons: fn(acc, row) {
    if row.module == module_qn {
      match map_lookup(m: blocked, key: row.path) {
        Present { value: _ } => acc
        Absent =>
          match row.local {
            LocallyRefused { refusal: _ } => acc
            LocallyResolved { node: n } => map_insert(m: acc, key: row.name, value: n)
          }
      }
    } else {
      acc
    }
  })
  symbol_index_fill_module_declarations(
    index: index,
    root: closure_filter_root_published(root: nt.root, published: published),
    record_declarations: closure_symbols_published(
      xs: normalized_tree_record_declarations(t: nt),
      published: published
    ),
    resource_declarations: closure_symbols_published(
      xs: normalized_tree_resource_declarations(t: nt),
      published: published
    )
  )
}

fn closure_observed_outcome(
  module_qn: QualifiedName,
  rows: List<DeclPhase1Row>,
  blocked: Map<QualifiedName, NonEmptyDiagnostics>
) -> ModuleOutcome {
  ModuleObserved {
    module: module_qn,
    declarations: fold_list(xs: rows, empty: [], cons: fn(acc, row) {
      if row.module == module_qn {
        list_snoc_item(
          xs: acc,
          item: match map_lookup(m: blocked, key: row.path) {
            Present { value: r } => DeclarationRefused { path: row.path, refusal: r }
            Absent =>
              match row.local {
                LocallyResolved { node: _ } => DeclarationAvailable { path: row.path }
                LocallyRefused { refusal: r } => DeclarationRefused { path: row.path, refusal: r }
              }
          }
        )
      } else {
        acc
      }
    })
  }
}

fn closure_phase1_walk_module(
  acc: ClosurePhase1Acc,
  nt: NormalizedTree,
  module_qn: QualifiedName
) -> ClosurePhase1Acc {
  let demand = resolution_context_namespace(
    shared: acc.context,
    validate_diag: None,
    admission: Admission { subject: ResolutionSubject { name: module_qn }, imports: [] }
  )
  match demand.admitted {
    Rejected { diagnostics: r } =>
      ClosurePhase1Acc {
        rows: acc.rows,
        unavailable: list_snoc_item(
          xs: acc.unavailable,
          item: ModuleUnavailable { module: module_qn, refusal: r }
        ),
        trees: acc.trees,
        context: demand.context
      }
    Accepted { value: admitted, diagnostics: _ } =>
      let ctx = resolve_ctx_init(namespace: admitted.namespace, lm: acc.context.lm, policy: acc.context.policy)
      let rows = fold_list(
        xs: module_root_bindings(root: admitted.subject_root.root),
        empty: acc.rows,
        cons: fn(racc, binding) {
          let path = qualified_name_snoc(qn: module_qn, segment: binding.name)
          let walk = resolve_labeled_child_edge(
            ctx: resolve_ctx_with_under_module_root(ctx: ctx, under_module_root: true),
            e: Edge { label: Authored { name: binding.name }, target: binding.declaration, declaration: NotADeclaration }
          )
          list_snoc_item(
            xs: racc,
            item: match walk {
              ResolveWalkAccepted { value: resolved, diagnostics: _, bindings: _ } =>
                DeclPhase1Row {
                  module: module_qn,
                  name: binding.name,
                  path: path,
                  local: LocallyResolved { node: resolved },
                  callees: closure_collect_declaration_callees(n: resolved, acc: [])
                }
              ResolveWalkRefused { first: first, rest: _, observation: _, partial: _ } =>
                DeclPhase1Row {
                  module: module_qn,
                  name: binding.name,
                  path: path,
                  local: LocallyRefused { refusal: first },
                  callees: closure_collect_declaration_callees(n: binding.declaration, acc: [])
                }
            }
          )
        }
      )
      ClosurePhase1Acc {
        rows: rows,
        unavailable: acc.unavailable,
        trees: list_snoc_item(xs: acc.trees, item: nt),
        context: demand.context
      }
  }
}

// THE DECLARED-PAYLOAD KIND RIDES THE CARRIER CAPTURED AT NORMALIZE (symbol_index_fill_module_declarations): a
// fill handed Empty marks no record, so symbol_index_declared_payload_at answered Absent for every
// record in resolved_declarations and v2.compiler.infer read each construct as not a record.
//
// TWO PHASES (N7). Phase 1 resolves each declaration against the published index plus this module's
// own declared names as provisional candidates (the ingest SymbolIndex already holds those names).
// ONE ResolutionContext / admitted namespace per module is reused across its declarations. Phase 2
// condenses those edges, decides availability, and publishes only then. Nothing provisional is
// published.
fn closure_declarations_demand(shared: ResolutionContext) -> ClosureDeclarations {
  match shared.closure_declarations {
    Present { value: closure } => ClosureDeclarations { declarations: closure.declarations, module_outcomes: closure.module_outcomes, outcome_index: closure.outcome_index, context: shared }
    Absent =>
      let phase1 = fold_list(
        xs: shared.roots.roots,
        empty: ClosurePhase1Acc { rows: [], unavailable: [], trees: [], context: shared },
        cons: fn(acc, nt) {
          match qualified_name_from_module_node(root: nt.root) {
            Rejected { diagnostics: _ } => acc
            Accepted { value: module_qn, diagnostics: _ } =>
              closure_phase1_walk_module(acc: acc, nt: nt, module_qn: module_qn)
          }
        }
      )
      let blocked = closure_phase2_blocked(index: phase1.context.symbol_index, rows: phase1.rows, unavailable: phase1.unavailable)
      let index = fold_list(xs: phase1.trees, empty: empty_symbol_index(), cons: fn(acc, nt) {
        match qualified_name_from_module_node(root: nt.root) {
          Rejected { diagnostics: _ } => acc
          Accepted { value: module_qn, diagnostics: _ } =>
            closure_publish_module(nt: nt, module_qn: module_qn, rows: phase1.rows, blocked: blocked, index: acc)
        }
      })
      let observed = fold_list(xs: phase1.trees, empty: phase1.unavailable, cons: fn(acc, nt) {
        match qualified_name_from_module_node(root: nt.root) {
          Rejected { diagnostics: _ } => acc
          Accepted { value: module_qn, diagnostics: _ } =>
            list_snoc_item(
              xs: acc,
              item: closure_observed_outcome(module_qn: module_qn, rows: phase1.rows, blocked: blocked)
            )
        }
      })
      let outcome_index = module_outcome_index(outcomes: observed)
      ClosureDeclarations {
        declarations: index,
        module_outcomes: observed,
        outcome_index: outcome_index,
        context: ResolutionContext {
          lm: phase1.context.lm,
          roots: phase1.context.roots,
          symbol_index: phase1.context.symbol_index,
          index: phase1.context.index,
          active_roots: phase1.context.active_roots,
          policy: phase1.context.policy,
          namespaces: phase1.context.namespaces,
          namespaces_built: phase1.context.namespaces_built,
          closure_declarations: optional_present(value: ClosureIndex { declarations: index, module_outcomes: observed, outcome_index: outcome_index }),
          type_declaration_modifiers: phase1.context.type_declaration_modifiers
        }
      }
  }
}

// THE SUBJECT'S WHOLE RESOLUTION OBSERVATION, every independent failure chain in walk order.
// resolve_in_context is its projection. A context or namespace refusal means the walk was never
// entered, so none of the subject's sites were observed: that is recorded as ObservationIncomplete,
// never as a complete observation holding one refusal.
fn resolve_walk_in_context(context: Outcome<ResolutionContext>, admission: Admission) -> ContextWalk {
  match context {
    Rejected { diagnostics: r } =>
      ContextWalk {
        walk: ResolveWalkRefused {
          first: r,
          rest: [],
          observation: ObservationIncomplete { reason: ^resolve_observation_context_refused },
          partial: []
        },
        context: context
      }
    Accepted { value: shared, diagnostics: validate_diag } =>
      let demand = resolution_context_namespace(shared: shared, validate_diag: validate_diag, admission: admission)
      let threaded = Accepted { value: demand.context, diagnostics: validate_diag }
      match demand.admitted {
        Accepted { value: admitted, diagnostics: namespace_diag } =>
          let outcomes = match demand.context.closure_declarations {
            Present { value: closure } => closure.outcome_index
            Absent => empty_module_outcome_index()
          }
          ContextWalk {
            walk: resolve_walk_prefix_pending(
              pending: namespace_diag,
              w: resolve_walk_with_namespace_policy(
                tree: admitted.subject_root,
                namespace: namespace_with_module_outcomes(namespace: admitted.namespace, providers: outcomes),
                lm: shared.lm,
                policy: shared.policy
              )
            ),
            context: threaded
          }
        Rejected { diagnostics: r } =>
          ContextWalk {
            walk: ResolveWalkRefused {
              first: r,
              rest: [],
              observation: ObservationIncomplete { reason: ^resolve_observation_namespace_refused },
              partial: []
            },
            context: threaded
          }
      }
  }
}

fn resolve_with_admission(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  admission: Admission
) -> Outcome<ResolvedTree> {
  resolve_with_admission_policy(
    lm: lm,
    roots: roots,
    admission: admission,
    index: v2.std.cross_tree.resolution.source_root_index_empty(),
    active_roots: Empty,
    policy: default_name_resolution_policy()
  )
}

fn resolve_with_admission_grounded(
  lm: LanguageModel,
  roots: FreeMonoid<NormalizedTree>,
  admission: Admission,
  index: SourceRootIndex,
  active_roots: FreeMonoid<SourceRootRef>
) -> Outcome<ResolvedTree> {
  resolve_with_admission_policy(
    lm: lm,
    roots: roots,
    admission: admission,
    index: index,
    active_roots: active_roots,
    policy: default_name_resolution_policy()
  )
}
