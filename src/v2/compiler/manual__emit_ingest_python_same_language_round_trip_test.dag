//     python source -> parse -> parse_tree_to_target_model_bridge -> emit -> python source
// Status: EXECUTED Bool witness (fast selector bijectivity) + heavy by-execution source round-trip.

module v2.test.manual.emit_ingest_python_same_language_round_trip

import v2.compiler.ingest {
  cross_language_compile,
  grammar_relation_row_forward_selection,
  parse_tree_to_emitted_node,
  parse_tree_to_target_model_bridge
}
import v2.compiler.translate { grammar_relation_row_for_emitted }
import v2.extdeps.languages.dag {
  dag_mvp1_fixture_emitted_add_fn,
  dag_mvp1_target_model
}
import v2.extdeps.languages.python {
  python_grammar_relation_row_node,
  python_mvp1_emitted_add_fn_node,
  python_mvp1_grammar_relation_row,
  python_mvp1_source_text,
  python_mvp1_target_model,
  python_mvp1_translation_rules_node
}
import v2.test.manual.python_mvp1_grammar_claim {
  python_mvp1_grammar_parse_fixture
}
import v2.std.algebra { Cons, Empty, list_append }
import v2.std.collection { List }
import v2.std.compilers.target_model {
  concrete_syntax_token_class,
  concrete_syntax_token_list_from_node,
  grammar_relation_field_tokens
}
import v2.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v2.std.grammar { ParseTree }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.node_query { find_named_child }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

// Project a grammar-relation row's token-spine to ordered token CLASSES (bindings dropped),
// mirroring v2.compiler.ingest row_token_spine_classes — the frontier forward selection keys on.
fn emit_ingest_python_row_token_spine_classes(row: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: Empty,
            f: fn(acc, t) {
              list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn emit_ingest_python_shared_rules() -> Node {
  python_mvp1_translation_rules_node()
}

fn emit_ingest_python_canonical_row() -> Node {
  python_grammar_relation_row_node(row: python_mvp1_grammar_relation_row())
}

fn emit_ingest_python_canonical_emitted() -> Node {
  python_mvp1_emitted_add_fn_node()
}

// Hermetic perturb token: not on the python_mvp1 add-fn production spine (bogus append target).
data emit_ingest_python_perturb_bogus_tok: Symbol = emit_ingest_python_perturb_bogus_tok

// Backward selector (emit/serialize): keys on grammar_relation_field_emitted.
fn emit_python_backward_selects_canonical_row_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_python_shared_rules(),
    emitted: emit_ingest_python_canonical_emitted()
  ) {
    Accepted { value: row, diagnostics: _ } =>
      row == emit_ingest_python_canonical_row()
    Rejected { diagnostics: _ } => false
  }
}

// Forward selector (ingest bridge): keys on token-spine frontier classes.
fn ingest_python_forward_selects_canonical_emitted_holds() -> Bool {
  match emit_ingest_python_row_token_spine_classes(row: emit_ingest_python_canonical_row()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_python_shared_rules()
      ) {
        Accepted { value: emitted, diagnostics: _ } =>
          emitted == emit_ingest_python_canonical_emitted()
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Bijectivity: backward(emitted) then forward(spine) = identity on emitted.
fn emit_then_ingest_python_selector_identity_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_python_shared_rules(),
    emitted: emit_ingest_python_canonical_emitted()
  ) {
    Accepted { value: row, diagnostics: _ } =>
      match emit_ingest_python_row_token_spine_classes(row: row) {
        Accepted { value: frontier, diagnostics: _ } =>
          match grammar_relation_row_forward_selection(
            frontier: frontier,
            rules: emit_ingest_python_shared_rules()
          ) {
            Accepted { value: recovered, diagnostics: _ } =>
              recovered == emit_ingest_python_canonical_emitted()
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Bijectivity: forward(spine) then backward(emitted) = identity on row.
fn ingest_then_emit_python_selector_identity_holds() -> Bool {
  match emit_ingest_python_row_token_spine_classes(row: emit_ingest_python_canonical_row()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: frontier,
        rules: emit_ingest_python_shared_rules()
      ) {
        Accepted { value: emitted, diagnostics: _ } =>
          match grammar_relation_row_for_emitted(
            rules: emit_ingest_python_shared_rules(),
            emitted: emitted
          ) {
            Accepted { value: row, diagnostics: _ } =>
              row == emit_ingest_python_canonical_row()
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Hermetic discriminator (per-merge vacuous-accept guard): canonical spine with a bogus extra token
fn emit_ingest_python_perturbed_frontier_fails_closed() -> Bool {
  match emit_ingest_python_row_token_spine_classes(row: emit_ingest_python_canonical_row()) {
    Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: list_append(left: frontier, right: [emit_ingest_python_perturb_bogus_tok]),
        rules: emit_ingest_python_shared_rules()
      ) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

// Positive control (perturb-RED other side): the UN-perturbed canonical frontier MUST select.
fn emit_ingest_python_unperturbed_frontier_accepts() -> Bool {
  ingest_python_forward_selects_canonical_emitted_holds()
}

// Hermetic perturb-RED: a single-token frontier off the python_mvp1 add spine -> fail closed.
fn ingest_python_forward_fails_closed_off_frontier_holds() -> Bool {
  match grammar_relation_row_forward_selection(
    frontier: Cons { head: emit_ingest_python_perturb_bogus_tok, tail: Empty },
    rules: emit_ingest_python_shared_rules()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

// Hermetic perturb-RED: backward selection on a foreign (dag) emitted against python rules -> fail closed.
fn emit_python_backward_fails_closed_on_foreign_emitted_holds() -> Bool {
  match grammar_relation_row_for_emitted(
    rules: emit_ingest_python_shared_rules(),
    emitted: dag_mvp1_fixture_emitted_add_fn
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

// Fast BoolWitness: python_mvp1 grammar-relation selector bijectivity (hermetic, sub-second).
test fn emit_ingest_python_selector_bijectivity_holds() -> Bool {
  emit_python_backward_selects_canonical_row_holds()
    && ingest_python_forward_selects_canonical_emitted_holds()
    && emit_then_ingest_python_selector_identity_holds()
    && ingest_then_emit_python_selector_identity_holds()
    && emit_ingest_python_perturbed_frontier_fails_closed()
    && ingest_python_forward_fails_closed_off_frontier_holds()
    && emit_python_backward_fails_closed_on_foreign_emitted_holds()
}

// ─────────────────────────────────────────────────────────────────────────────
// HEAVY (real python parse, ~627s) — same-language round-trip on REAL source.
// NOT BoolWitnessed: per-PR lens-gate time budget (see cross_language_add_python_to_typescript).
// ─────────────────────────────────────────────────────────────────────────────

// Real python source parses; forward bridge recovers the canonical add-fn core node.
fn python_same_language_parse_bridge_holds() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_target_model_bridge(
        parse_tree: tree,
        source_model: python_mvp1_target_model()
      ) {
        Accepted { value: recovered, diagnostics: _ } =>
          recovered == emit_ingest_python_canonical_emitted()
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Real python source -> parse -> bridge -> emit(py) recovers canonical python_mvp1_source_text.
fn python_same_language_source_emit_round_trip_holds() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: tree,
        source_model: python_mvp1_target_model(),
        target_model: python_mvp1_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } =>
          source == python_mvp1_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Discrimination on the REAL tree: the same parsed python tree against a foreign row table
// (dag_mvp1_target_model) matches no row -> fail closed. Proves recovery is frontier-driven.
fn python_same_language_discriminates_on_real_tree() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(
        parse_tree: tree,
        source_model: dag_mvp1_target_model()
      ) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

// Composed heavy receipt: REAL python same-language emit↔ingest round-trip end-to-end.
fn emit_ingest_python_same_language_round_trip_holds() -> Bool {
  emit_ingest_python_selector_bijectivity_holds()
    && python_same_language_parse_bridge_holds()
    && python_same_language_source_emit_round_trip_holds()
    && python_same_language_discriminates_on_real_tree()
}
