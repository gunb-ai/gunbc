module v2.compiler.symbol_index_fill

import v2.std.service_realization_labels { realization_root_label }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.algebra { Empty, FreeMonoid, list_append, list_snoc_item }
import v2.std.algebra { fold_list, is_empty, length }
import v2.std.collection {
  Map,
  empty_map,
  map_insert
}
import v2.std.node_query { binder_node_parts }
import v2.std.optional {
  Absent,
  Optional,
  Present,
  optional_absent,
  optional_present
}
import v2.std.diagnostic { Accepted, Outcome, Rejected }
