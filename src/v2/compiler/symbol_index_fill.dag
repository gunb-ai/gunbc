module v2.compiler.symbol_index_fill

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.algebra { Empty, FreeMonoid }
import v2.std.algebra { fold_list }
import v2.std.collection {
  Map,
  empty_map,
  list_at_optional,
  map_insert
}
import v2.std.optional {
  Absent,
  Optional,
  Present
}
import v2.std.diagnostic { Accepted, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node {
  Arrow,
  Conj,
  Disj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  node_subtree_nodes
}
import v2.std.qualified_name { QualifiedName, qualified_name_snoc }
import v2.std.symbol_index {
  SymbolIndex,
  symbol_index_insert,
  symbol_index_lookup
}
import v2.extdeps.languages.dag {
  alias_binding_row_from_decl_node,
  dag_surface_module_header_metadata_edge,
  namespace_graft_spine_segment_edge_optional,
  qualified_name_from_module_node
}
import v2.compiler.namespace_graft {
  namespace_graft_parse_projection_edge
}

data symbol_index_fill_extdeps_coupling_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.std.qualified_name",
    decl_name: "qualified_name_from_node",
    field: WholeDeclaration
  }
}

data symbol_index_containment_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.compiler.symbol_index_fill",
    decl_name: "symbol_index_fill_containment_node",
    field: WholeDeclaration
  }
}

fn symbol_index_fill_containment_edge(
  index: SymbolIndex,
  path: QualifiedName,
  edge: Edge
) -> SymbolIndex {
  match edge.label {
    Named { name: sym } =>
      if dag_surface_module_header_metadata_edge(name: sym) {
        symbol_index_fill_containment_node(
          index: index,
          path: path,
          node: edge.target
        )
      } else if namespace_graft_parse_projection_edge(name: sym) {
        symbol_index_fill_containment_node(
          index: index,
          path: path,
          node: edge.target
        )
      } else {
        let child_path = qualified_name_snoc(qn: path, segment: sym)
        let with_binding = symbol_index_insert(
          index: index,
          qualified_path: child_path,
          resolved: edge.target
        )
        symbol_index_fill_containment_node(
          index: with_binding,
          path: child_path,
          node: edge.target
        )
      }
    Positional =>
      symbol_index_fill_containment_node(
        index: index,
        path: path,
        node: edge.target
      )
  }
}

data symbol_index_fill_transparent_wrapper_note: String = "Default arm: transparent descent through parse/grammar wrapper nodes (production shells, sequence/repeat spines) at the current qualified path — edges are still filtered by symbol_index_fill_containment_edge (module-header metadata + _node_projection projections skip path extension; post-graft containment spine segments descend at the current path via namespace_graft_spine_segment_edge_optional). Conj/Disj/Arrow retain explicit semantics; this arm is intentionally NOT a typed refusal so lowered members nested under top_level_item shells remain reachable. New TypeNode connectives that carry real named bindings must get an explicit arm before relying on this fallback."

fn symbol_index_fill_containment_node(
  index: SymbolIndex,
  path: QualifiedName,
  node: Node
) -> SymbolIndex {
  match node.kind {
    TypeNode { connective: Conj } =>
      match namespace_graft_spine_segment_edge_optional(node: node) {
        Present { value: spine_edge } =>
          symbol_index_fill_containment_node(
            index: index,
            path: path,
            node: spine_edge.target
          )
        Absent =>
          fold(node.children, init: index, f: fn(acc, edge) {
            symbol_index_fill_containment_edge(index: acc, path: path, edge: edge)
          })
      }
    TypeNode { connective: Disj } =>
      fold(node.children, init: index, f: fn(acc, edge) {
        match edge.label {
          Named { name: sym } =>
            let variant_path = qualified_name_snoc(qn: path, segment: sym)
            let with_variant = symbol_index_insert(
              index: acc,
              qualified_path: variant_path,
              resolved: edge.target
            )
            symbol_index_fill_containment_node(
              index: with_variant,
              path: variant_path,
              node: edge.target
            )
          Positional => acc
        }
      })
    TypeNode { connective: Arrow } =>
      match list_at_optional(xs: node.children, index: 0) {
        Present { value: domain_edge } =>
          symbol_index_fill_containment_node(
            index: index,
            path: path,
            node: domain_edge.target
          )
        Absent => index
      }
    _ =>
      fold(node.children, init: index, f: fn(acc, edge) {
        symbol_index_fill_containment_edge(index: acc, path: path, edge: edge)
      })
  }
}

fn disj_variant_count_of(counts: Map<Symbol, Int>, sym: Symbol) -> Int {
  match v2.std.collection.map_get(counts, sym) {
    Accepted { value: opt, diagnostics: _ } => match opt {
      Present { value: n } => n
      Absent => 0
    }
    Rejected { diagnostics: _ } => 0
  }
}

fn disj_variant_counts_in_module(root: Node) -> Map<Symbol, Int> {
  fold(
    node_subtree_nodes(root: root),
    init: empty_map(),
    f: fn(counts, n) {
      match n.kind {
        TypeNode { connective: Disj } =>
          fold(n.children, init: counts, f: fn(c, e) {
            match e.label {
              Named { name: sym } =>
                map_insert(
                  m: c,
                  key: sym,
                  value: disj_variant_count_of(counts: c, sym: sym) + 1
                )
              Positional => c
            }
          })
        _ => counts
      }
    }
  )
}

fn symbol_index_fill_alias_binding(
  index: SymbolIndex,
  module_qn: QualifiedName,
  root: Node,
  decl: Node
) -> SymbolIndex {
  match alias_binding_row_from_decl_node(decl: decl, module_root: root) {
    Rejected { diagnostics: _ } => index
    Accepted { value: row, diagnostics: _ } =>
      match symbol_index_lookup(index: index, qualified_path: row.target) {
        Present { value: resolved } =>
          symbol_index_insert(
            index: index,
            qualified_path: qualified_name_snoc(qn: module_qn, segment: row.binding),
            resolved: resolved
          )
        Absent => index
      }
  }
}

fn symbol_index_fill_alias_bindings(
  index: SymbolIndex,
  module_qn: QualifiedName,
  root: Node
) -> SymbolIndex {
  fold(
    node_subtree_nodes(root: root),
    init: index,
    f: fn(acc, n) {
      symbol_index_fill_alias_binding(
        index: acc,
        module_qn: module_qn,
        root: root,
        decl: n
      )
    }
  )
}

fn symbol_index_fill_unique_variant_aliases(
  index: SymbolIndex,
  module_qn: QualifiedName,
  root: Node
) -> SymbolIndex {
  let counts = disj_variant_counts_in_module(root: root)
  fold(
    node_subtree_nodes(root: root),
    init: index,
    f: fn(acc, n) {
      match n.kind {
        TypeNode { connective: Disj } =>
          fold(n.children, init: acc, f: fn(a2, e) {
            match e.label {
              Named { name: sym } =>
                if disj_variant_count_of(counts: counts, sym: sym) == 1 {
                  symbol_index_insert(
                    index: a2,
                    qualified_path: qualified_name_snoc(qn: module_qn, segment: sym),
                    resolved: e.target
                  )
                } else {
                  a2
                }
              Positional => a2
            }
          })
        _ => acc
      }
    }
  )
}

fn symbol_index_fill_module_root(index: SymbolIndex, root: Node) -> SymbolIndex {
  match qualified_name_from_module_node(root: root) {
    Accepted { value: module_qn, diagnostics: _ } =>
      symbol_index_fill_alias_bindings(
        index: symbol_index_fill_unique_variant_aliases(
          index: symbol_index_fill_containment_node(
            index: index,
            path: module_qn,
            node: root
          ),
          module_qn: module_qn,
          root: root
        ),
        module_qn: module_qn,
        root: root
      )
    Rejected { diagnostics: _ } => index
  }
}

fn symbol_index_fill_module_roots(
  index: SymbolIndex,
  roots: FreeMonoid<Node>
) -> SymbolIndex {
  fold_list(
    xs: roots,
    empty: index,
    cons: fn(acc, root) {
      symbol_index_fill_module_root(index: acc, root: root)
    }
  )
}
