// Target-agnostic type-expression projection enrichment (C.i coproduct wire-contract).
// Reads enrichment DATA from target bundle edge; no target-name branches.

module v2.compiler.type_expression_projection_enrichment

import v2.compiler.infer { InferredTree }
import v2.extdeps.languages.dag {
  parse_production_captured_child_optional,
  parse_production_emitted_identity_optional
}
import v2.std.algebra { Cons, Empty, TailAbsent, TailFound, fold_list, is_empty, list_append, list_snoc_item, list_tail }
import v2.std.collection { Absent, List, Optional, Present, list_at_optional, optional_absent, optional_present }
import v2.std.compilers.target_model {
  TargetModel,
  TargetTypeExpressionProjection,
  TargetSumTypeShape,
  decode_sum_type_shape_bundle,
  symbol_interned_spelling,
  type_expression_projection_from_target
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node {
  Disj,
  Edge,
  Node,
  NodeFold,
  Symbol,
  TypeNode,
  content_hash,
  fold_node
}
import std.serialization { ScreamingSnakeCase, SnakeCase }
import v2.std.node_query { find_named_child }

fn tepe_coproduct_wire_contract_malformed_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^translate_coproduct_wire_contract_malformed,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

type CoproductWireContractIndexRow {
  coproduct_sym: Symbol
  naming_tag: Symbol
  decl: Node
}

fn tepe_node_has_surface(root: Node, surface: Symbol) -> Bool {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } => id == surface
    Absent =>
      match find_named_child(root: root, name: surface) {
        Accepted { value: child, diagnostics: _ } =>
          match child.kind {
            TypeNode { connective: Atom { identity: id } } => id == surface
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
  }
}

fn tepe_production_captured_optional(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: _ } => parse_production_captured_child_optional(node: node)
    Absent => optional_absent()
  }
}

fn tepe_sequence_left_optional(seq: Node) -> Optional<Node> {
  tepe_sequence_child_optional(seq: seq, side: ^grammar_sequence_left_node_projection)
}

fn tepe_sequence_right_optional(seq: Node) -> Optional<Node> {
  tepe_sequence_child_optional(seq: seq, side: ^grammar_sequence_right_node_projection)
}

fn tepe_atom_sym_optional(node: Node) -> Optional<Symbol> {
  match tepe_atom_identity_optional(node: node) {
    Present { value: sym } => optional_present(value: sym)
    Absent =>
      match parse_production_captured_child_optional(node: node) {
        Present { value: captured } => tepe_atom_sym_optional(node: captured)
        Absent =>
          match tepe_sequence_left_optional(seq: node) {
            Present { value: left } =>
              match tepe_atom_sym_optional(node: left) {
                Present { value: sym } => optional_present(value: sym)
                Absent =>
                  match tepe_sequence_right_optional(seq: node) {
                    Present { value: right } => tepe_atom_sym_optional(node: right)
                    Absent => optional_absent()
                  }
              }
            Absent => optional_absent()
          }
      }
  }
}

fn tepe_field_init_parts_match_name(parts: TepeFieldInitParts, field: Symbol) -> Bool {
  match tepe_atom_sym_optional(node: parts.name) {
    Present { value: sym } => sym == field
    Absent => false
  }
}

fn tepe_field_init_value_is_encoding_shape(value: Node) -> Bool {
  match tepe_field_init_value_structural_fallback(root: value, field: ^naming) {
    Present { value: _ } => true
    Absent => false
  }
}

fn tepe_coproduct_field_value_optional(root: Node) -> Optional<Node> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(node) {
        match tepe_field_init_parts_optional(node: node) {
          Present { value: parts } =>
            if tepe_field_init_value_is_encoding_shape(value: parts.value) {
              optional_absent()
            } else {
              match tepe_atom_sym_optional(node: parts.value) {
                Present { value: _ } => optional_present(value: parts.value)
                Absent => optional_absent()
              }
            }
          Absent => optional_absent()
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } => acc
          Absent => child_acc
        }
      }
    }
  )
}

fn tepe_encoding_field_value_optional(root: Node) -> Optional<Node> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(node) {
        match tepe_field_init_parts_optional(node: node) {
          Present { value: parts } =>
            if tepe_field_init_value_is_encoding_shape(value: parts.value) {
              optional_present(value: parts.value)
            } else {
              optional_absent()
            }
          Absent => optional_absent()
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } => acc
          Absent => child_acc
        }
      }
    }
  )
}

fn tepe_sole_field_init_value_optional(root: Node) -> Optional<Node> {
  match fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(node) {
        match tepe_field_init_parts_optional(node: node) {
          Present { value: parts } =>
            optional_present(value: parts.value)
          Absent => optional_absent()
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } =>
            match child_acc {
              Present { value: _ } => optional_absent()
              Absent => acc
            }
          Absent => child_acc
        }
      }
    }
  ) {
    Present { value: only } => optional_present(value: only)
    Absent => optional_absent()
  }
}

fn tepe_field_init_value_structural_fallback(
  root: Node,
  field: Symbol
) -> Optional<Node> {
  match symbol_interned_spelling(binding: field) {
    Accepted { value: spelling, diagnostics: _ } =>
      if spelling == "encoding" {
        tepe_encoding_field_value_optional(root: root)
      } else if spelling == "coproduct" {
        tepe_coproduct_field_value_optional(root: root)
      } else if spelling == "naming" {
        tepe_sole_field_init_value_optional(root: root)
      } else {
        optional_absent()
      }
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn tepe_find_field_init_value_by_name_only(root: Node, field: Symbol) -> Optional<Node> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(node) {
        match tepe_field_init_parts_optional(node: node) {
          Present { value: parts } =>
            if tepe_field_init_parts_match_name(parts: parts, field: field) {
              optional_present(value: parts.value)
            } else {
              optional_absent()
            }
          Absent => optional_absent()
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } => acc
          Absent => child_acc
        }
      }
    }
  )
}

fn tepe_field_init_value_from_colon_sequence_optional(seq: Node) -> Optional<Node> {
  match tepe_sequence_right_optional(seq: seq) {
    Present { value: expr_node } => optional_present(value: expr_node)
    Absent => optional_absent()
  }
}

fn tepe_data_decl_type_and_expr_optional(decl: Node) -> Optional<TepeDataDeclParts> {
  match find_named_child(root: decl, name: ^dag_surface_data_decl_type) {
    Accepted { value: type_expr, diagnostics: _ } =>
      match find_named_child(root: decl, name: ^dag_surface_data_decl_expr) {
        Accepted { value: expr, diagnostics: _ } =>
          optional_present(TepeDataDeclParts { type_expr: type_expr, expr: expr })
        Rejected { diagnostics: _ } => optional_absent()
      }
    Rejected { diagnostics: _ } =>
      match tepe_production_captured_optional(node: decl) {
        Present { value: s1 } =>
          match tepe_sequence_right_optional(seq: s1) {
            Present { value: s2 } =>
              match tepe_sequence_right_optional(seq: s2) {
                Present { value: s3 } =>
                  match tepe_sequence_right_optional(seq: s3) {
                    Present { value: s4 } =>
                      match tepe_sequence_left_optional(seq: s4) {
                        Present { value: type_expr } =>
                          match tepe_sequence_right_optional(seq: s4) {
                            Present { value: s5 } =>
                              match tepe_sequence_right_optional(seq: s5) {
                                Present { value: expr } =>
                                  optional_present(
                                    TepeDataDeclParts {
                                      type_expr: type_expr,
                                      expr: expr
                                    }
                                  )
                                Absent => optional_absent()
                              }
                            Absent => optional_absent()
                          }
                        Absent => optional_absent()
                      }
                    Absent => optional_absent()
                  }
                Absent => optional_absent()
              }
            Absent => optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

fn tepe_type_decl_name_optional(type_decl: Node) -> Optional<Symbol> {
  match fold(type_decl.children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match e.label {
          Named { name: sym } =>
            if sym == ^dag_surface_type_decl {
              acc
            } else {
              optional_present(value: sym)
            }
          Positional => acc
        }
    }
  }) {
    Present { value: sym } => optional_present(value: sym)
    Absent =>
      match tepe_production_captured_optional(node: type_decl) {
        Present { value: s1 } =>
          match tepe_sequence_right_optional(seq: s1) {
            Present { value: s2 } =>
              match tepe_sequence_left_optional(seq: s2) {
                Present { value: name_node } => tepe_atom_sym_optional(node: name_node)
                Absent => optional_absent()
              }
            Absent => optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

fn tepe_atom_identity_optional(node: Node) -> Optional<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } => optional_present(value: sym)
    _ => optional_absent()
  }
}

type TepeFieldInitParts {
  name: Node
  value: Node
}

type TepeDataDeclParts {
  type_expr: Node
  expr: Node
}

fn tepe_sequence_child_optional(seq: Node, side: Symbol) -> Optional<Node> {
  match find_named_child(root: seq, name: side) {
    Accepted { value: child, diagnostics: _ } => optional_present(value: child)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn tepe_field_init_parts_optional(node: Node) -> Optional<TepeFieldInitParts> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_field_init {
        match parse_production_captured_child_optional(node: node) {
          Present { value: seq } =>
            match tepe_sequence_child_optional(seq: seq, side: ^grammar_sequence_left_node_projection) {
              Present { value: name_node } =>
                match tepe_sequence_child_optional(
                  seq: seq,
                  side: ^grammar_sequence_right_node_projection
                ) {
                  Present { value: colon_seq } =>
                    match tepe_field_init_value_from_colon_sequence_optional(
                      seq: colon_seq
                    ) {
                      Present { value: value_node } =>
                        optional_present(
                          TepeFieldInitParts { name: name_node, value: value_node }
                        )
                      Absent => optional_absent()
                    }
                  Absent => optional_absent()
                }
              Absent => optional_absent()
            }
          Absent => optional_absent()
        }
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn tepe_find_field_init_value_optional(root: Node, field: Symbol) -> Optional<Node> {
  match tepe_find_field_init_value_by_name_only(root: root, field: field) {
    Present { value: child } => optional_present(value: child)
    Absent => tepe_field_init_value_structural_fallback(root: root, field: field)
  }
}

fn tepe_unwrap_to_conj_optional(node: Node) -> Optional<Node> {
  match node.kind {
    TypeNode { connective: Conj } => optional_present(value: node)
    _ =>
      match parse_production_captured_child_optional(node: node) {
        Present { value: captured } => tepe_unwrap_to_conj_optional(node: captured)
        Absent => optional_absent()
      }
  }
}

fn tepe_named_field_target(root: Node, field: Symbol) -> Optional<Node> {
  match tepe_find_field_init_value_optional(root: root, field: field) {
    Present { value: child } => optional_present(value: child)
    Absent =>
      match tepe_unwrap_to_conj_optional(node: root) {
        Present { value: conj } =>
          match find_named_child(root: conj, name: field) {
            Accepted { value: child, diagnostics: _ } => optional_present(value: child)
            Rejected { diagnostics: _ } => optional_absent()
          }
        Absent => optional_absent()
      }
  }
}

fn tepe_disj_in_subtree(node: Node) -> Optional<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) {
        match n0.kind {
          TypeNode { connective: Disj } => optional_present(value: n0)
          _ => optional_absent()
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } => acc
          Absent => child_acc
        }
      }
    }
  )
}

fn tepe_subtree_contains_disj_anchor(root: Node, disj_anchor: Node) -> Bool {
  let anchor_hash = content_hash(n: disj_anchor)
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(n0) { content_hash(n: n0) == anchor_hash },
      step: fn(acc, _edge, child_acc) {
        if acc {
          true
        } else {
          child_acc
        }
      }
    }
  )
}

fn tepe_enum_sym_for_disj(root: Node, disj_anchor: Node) -> Optional<Symbol> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(node) {
        if tepe_node_has_surface(root: node, surface: ^dag_surface_module) {
          optional_absent()
        } else {
          match tepe_type_decl_name_optional(type_decl: node) {
            Present { value: enum_sym } =>
              if tepe_subtree_contains_disj_anchor(root: node, disj_anchor: disj_anchor) {
                optional_present(value: enum_sym)
              } else {
                optional_absent()
              }
            Absent => optional_absent()
          }
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } => acc
          Absent => child_acc
        }
      }
    }
  )
}

fn tepe_singleton_contract_row_optional(
  rows: List<CoproductWireContractIndexRow>
) -> Optional<CoproductWireContractIndexRow> {
  match list_at_optional(xs: rows, index: 0) {
    Absent => optional_absent()
    Present { value: head } =>
      match list_tail(xs: rows) {
        TailAbsent => optional_present(value: head)
        TailFound { tail: tail } =>
          match list_at_optional(xs: tail, index: 0) {
            Absent => optional_present(value: head)
            Present { value: _ } => optional_absent()
          }
      }
  }
}

fn tepe_contract_row_for_disj_anchor(
  rows: List<CoproductWireContractIndexRow>,
  root: Node,
  disj_anchor: Node
) -> Optional<CoproductWireContractIndexRow> {
  match tepe_enum_sym_for_disj(root: root, disj_anchor: disj_anchor) {
    Present { value: enum_sym } =>
      tepe_lookup_contract_row(rows: rows, enum_sym: enum_sym)
    Absent => optional_absent()
  }
}

fn tepe_apply_enriched_disj_form(
  base: TargetTypeExpressionProjection,
  catalog: Node,
  naming_tag: Symbol
) -> Outcome<TargetTypeExpressionProjection> {
  bind_outcome(
    o: tepe_disj_form_from_catalog(catalog: catalog, naming_tag: naming_tag),
    f: fn(disj_form) {
      outcome_accepted(
        TargetTypeExpressionProjection {
          atom_form: base.atom_form,
          conj_form: base.conj_form,
          disj_form: disj_form,
          arrow_form: base.arrow_form,
          cardinality_form: base.cardinality_form,
          instantiation_form: base.instantiation_form
        }
      )
    }
  )
}

fn tepe_apply_contract_row_enrichment(
  base: TargetTypeExpressionProjection,
  catalog: Node,
  contract: CoproductWireContractIndexRow
) -> Outcome<TargetTypeExpressionProjection> {
  match contract {
    CoproductWireContractIndexRow { coproduct_sym: _, naming_tag: naming_tag, decl: _ } =>
      tepe_apply_enriched_disj_form(
        base: base,
        catalog: catalog,
        naming_tag: naming_tag
      )
  }
}

fn tepe_declaration_ref_value_atom_optional(node: Node) -> Optional<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) {
        match tepe_atom_identity_optional(node: n0) {
          Present { value: sym } =>
            if sym == ^dag_token_ident
              || sym == ^dag_token_string_literal
              || sym == ^dag_token_colon
              || sym == ^dag_token_eq
              || sym == ^dag_token_comma
              || sym == ^dag_token_lbrace
              || sym == ^dag_token_rbrace
            {
              optional_absent()
            } else {
              optional_present(value: n0)
            }
          Absent => optional_absent()
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } => acc
          Absent => child_acc
        }
      }
    }
  )
}

fn tepe_declaration_ref_sym_from_value(node: Node, decl: Node) -> Outcome<Symbol> {
  match tepe_declaration_ref_value_atom_optional(node: node) {
    Present { value: atom_node } =>
      match tepe_atom_identity_optional(node: atom_node) {
        Present { value: sym } =>
          if sym == ^dag_token_string_literal {
            outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
          } else {
            outcome_accepted(sym)
          }
        Absent =>
          outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
      }
    Absent =>
      outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
  }
}

fn tepe_declaration_ref_spelling_matches_enum(
  coproduct_sym: Symbol,
  enum_sym: Symbol
) -> Bool {
  if coproduct_sym == enum_sym {
    true
  } else {
    match symbol_interned_spelling(binding: coproduct_sym) {
      Accepted { value: coproduct_spelling, diagnostics: _ } =>
        match symbol_interned_spelling(binding: enum_sym) {
          Accepted { value: enum_spelling, diagnostics: _ } =>
            coproduct_spelling == concat("\"", concat(enum_spelling, "\""))
          Rejected { diagnostics: _ } => false
        }
      Rejected { diagnostics: _ } => false
    }
  }
}

fn tepe_variant_naming_tag_from_encoding(encoding: Node, decl: Node) -> Outcome<Symbol> {
  match tepe_named_field_target(root: encoding, field: ^naming) {
    Present { value: naming_node } =>
      bind_outcome(
        o: tepe_declaration_ref_sym_from_value(node: naming_node, decl: decl),
        f: fn(sym) {
          outcome_accepted(sym)
        }
      )
    Absent =>
      match tepe_disj_in_subtree(node: encoding) {
        Present { value: variant } =>
          match variant.kind {
            TypeNode { connective: Atom { identity: sym } } => outcome_accepted(sym)
            _ =>
              outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
          }
        Absent =>
          outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
      }
  }
}

fn tepe_normalize_naming_tag_for_catalog(sym: Symbol) -> Symbol {
  match symbol_interned_spelling(binding: sym) {
    Accepted { value: spelling, diagnostics: _ } =>
      match tepe_naming_spelling_basename(spelling: spelling) {
        "ScreamingSnakeCase" => ^ScreamingSnakeCase
        "SnakeCase" => ^SnakeCase
        _ => sym
      }
    Rejected { diagnostics: _ } => sym
  }
}

fn tepe_coproduct_sym_from_decl(
  decl: Node,
  field_coproduct: Symbol,
  field_encoding: Symbol,
  type_coproduct_wire_contract: Symbol
) -> Outcome<CoproductWireContractIndexRow> {
  if !tepe_node_has_surface(root: decl, surface: ^dag_surface_data_decl) {
    outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
  } else {
    match tepe_data_decl_type_and_expr_optional(decl: decl) {
      Present { value: parts } =>
        match tepe_atom_sym_optional(node: parts.type_expr) {
          Present { value: type_sym } =>
            if type_sym == type_coproduct_wire_contract {
              match tepe_named_field_target(root: parts.expr, field: field_coproduct) {
                Present { value: coproduct_node } =>
                  bind_outcome(
                    o: tepe_declaration_ref_sym_from_value(
                      node: coproduct_node,
                      decl: decl
                    ),
                    f: fn(coproduct_sym) {
                      match tepe_named_field_target(
                        root: parts.expr,
                        field: field_encoding
                      ) {
                        Present { value: encoding } =>
                          bind_outcome(
                            o: tepe_variant_naming_tag_from_encoding(
                              encoding: encoding,
                              decl: decl
                            ),
                            f: fn(naming_tag) {
                              outcome_accepted(
                                CoproductWireContractIndexRow {
                                  coproduct_sym: coproduct_sym,
                                  naming_tag: tepe_normalize_naming_tag_for_catalog(
                                    sym: naming_tag
                                  ),
                                  decl: decl
                                }
                              )
                            }
                          )
                        Absent =>
                          outcome_rejected(
                            tepe_coproduct_wire_contract_malformed_diagnostic(node: decl)
                          )
                      }
                    }
                  )
                Absent =>
                  outcome_rejected(
                    tepe_coproduct_wire_contract_malformed_diagnostic(node: decl)
                  )
              }
            } else {
              outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
            }
          Absent =>
            outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
        }
      Absent =>
        outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
    }
  }
}

fn tepe_rows_contain_coproduct(rows: List<CoproductWireContractIndexRow>, sym: Symbol) -> Bool {
  match list_at_optional(xs: rows, index: 0) {
    Absent => false
    Present { value: head } =>
      match head {
        CoproductWireContractIndexRow { coproduct_sym: csym, naming_tag: _, decl: _ } =>
          if tepe_declaration_ref_spelling_matches_enum(coproduct_sym: csym, enum_sym: sym) {
            true
          } else {
            match list_tail(xs: rows) {
              TailAbsent => false
              TailFound { tail: tail } => tepe_rows_contain_coproduct(rows: tail, sym: sym)
            }
          }
      }
  }
}

fn tepe_rows_contain_equivalent_contract(
  rows: List<CoproductWireContractIndexRow>,
  row: CoproductWireContractIndexRow
) -> Bool {
  match row {
    CoproductWireContractIndexRow { coproduct_sym: rsym, naming_tag: rtag, decl: _ } =>
      match list_at_optional(xs: rows, index: 0) {
        Absent => false
        Present { value: head } =>
          match head {
            CoproductWireContractIndexRow {
              coproduct_sym: csym,
              naming_tag: ctag,
              decl: _
            } =>
              if tepe_declaration_ref_spelling_matches_enum(coproduct_sym: csym, enum_sym: rsym)
                && ctag == rtag
              {
                true
              } else {
                match list_tail(xs: rows) {
                  TailAbsent => false
                  TailFound { tail: tail } =>
                    tepe_rows_contain_equivalent_contract(rows: tail, row: row)
                }
              }
          }
      }
  }
}

fn tepe_append_contract_row(
  rows: List<CoproductWireContractIndexRow>,
  row: CoproductWireContractIndexRow
) -> Outcome<List<CoproductWireContractIndexRow>> {
  match row {
    CoproductWireContractIndexRow { coproduct_sym: csym, naming_tag: _, decl: decl } =>
      if tepe_rows_contain_equivalent_contract(rows: rows, row: row) {
        outcome_accepted(rows)
      } else if tepe_rows_contain_coproduct(rows: rows, sym: csym) {
        outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: decl))
      } else {
        outcome_accepted(list_snoc_item(xs: rows, item: row))
      }
  }
}

type CoproductWireContractIndexAcc
  = CoproductWireContractIndexOk { rows: List<CoproductWireContractIndexRow> }
  | CoproductWireContractIndexErr { diagnostics: NonEmptyDiagnostics }

fn tepe_fold_decl_into_index(
  acc: CoproductWireContractIndexAcc,
  decl: Node,
  field_coproduct: Symbol,
  field_encoding: Symbol,
  type_coproduct_wire_contract: Symbol
) -> CoproductWireContractIndexAcc {
  match acc {
    CoproductWireContractIndexErr { diagnostics: d } =>
      CoproductWireContractIndexErr { diagnostics: d }
    CoproductWireContractIndexOk { rows: rows } =>
      if tepe_node_has_surface(root: decl, surface: ^dag_surface_data_decl) {
        match tepe_data_decl_type_and_expr_optional(decl: decl) {
          Present { value: parts } =>
            match tepe_atom_sym_optional(node: parts.type_expr) {
              Present { value: type_sym } =>
                if type_sym == type_coproduct_wire_contract {
                  match tepe_coproduct_sym_from_decl(
                    decl: decl,
                    field_coproduct: field_coproduct,
                    field_encoding: field_encoding,
                    type_coproduct_wire_contract: type_coproduct_wire_contract
                  ) {
                    Accepted { value: row, diagnostics: _ } =>
                      match tepe_append_contract_row(rows: rows, row: row) {
                        Accepted { value: next_rows, diagnostics: _ } =>
                          CoproductWireContractIndexOk { rows: next_rows }
                        Rejected { diagnostics: r } =>
                          CoproductWireContractIndexErr { diagnostics: r }
                      }
                    Rejected { diagnostics: r } =>
                      CoproductWireContractIndexErr { diagnostics: r }
                  }
                } else {
                  CoproductWireContractIndexOk { rows: rows }
                }
              Absent => CoproductWireContractIndexOk { rows: rows }
            }
          // Production shells can stamp dag_surface_data_decl without extractable
          // type/expr — skip; real CoproductWireContract rows still fail closed below.
          Absent => CoproductWireContractIndexOk { rows: rows }
        }
      } else {
        CoproductWireContractIndexOk { rows: rows }
      }
  }
}

fn tepe_merge_index_acc(
  left: CoproductWireContractIndexAcc,
  right: CoproductWireContractIndexAcc
) -> CoproductWireContractIndexAcc {
  match left {
    CoproductWireContractIndexErr { diagnostics: d } =>
      CoproductWireContractIndexErr { diagnostics: d }
    CoproductWireContractIndexOk { rows: left_rows } =>
      match right {
        CoproductWireContractIndexErr { diagnostics: d } =>
          CoproductWireContractIndexErr { diagnostics: d }
        CoproductWireContractIndexOk { rows: right_rows } =>
          CoproductWireContractIndexOk {
            rows: list_append(left: left_rows, right: right_rows)
          }
      }
  }
}

fn tepe_collect_data_decl_nodes(root: Node) -> List<Node> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(node) {
        if tepe_node_has_surface(root: node, surface: ^dag_surface_data_decl) {
          match tepe_data_decl_type_and_expr_optional(decl: node) {
            Present { value: _ } => [node]
            Absent => Empty
          }
        } else {
          Empty
        }
      },
      step: fn(acc, _edge, child_acc) {
        list_append(left: acc, right: child_acc)
      }
    }
  )
}

fn tepe_fold_index_over_decls(
  acc: CoproductWireContractIndexAcc,
  decls: List<Node>,
  field_coproduct: Symbol,
  field_encoding: Symbol,
  type_coproduct_wire_contract: Symbol
) -> CoproductWireContractIndexAcc {
  match list_at_optional(xs: decls, index: 0) {
    Absent => acc
    Present { value: decl } =>
      match acc {
        CoproductWireContractIndexErr { diagnostics: d } =>
          CoproductWireContractIndexErr { diagnostics: d }
        CoproductWireContractIndexOk { rows: rows } =>
          match list_tail(xs: decls) {
            TailAbsent =>
              tepe_fold_decl_into_index(
                acc: CoproductWireContractIndexOk { rows: rows },
                decl: decl,
                field_coproduct: field_coproduct,
                field_encoding: field_encoding,
                type_coproduct_wire_contract: type_coproduct_wire_contract
              )
            TailFound { tail: tail } =>
              tepe_fold_index_over_decls(
                acc: tepe_fold_decl_into_index(
                  acc: CoproductWireContractIndexOk { rows: rows },
                  decl: decl,
                  field_coproduct: field_coproduct,
                  field_encoding: field_encoding,
                  type_coproduct_wire_contract: type_coproduct_wire_contract
                ),
                decls: tail,
                field_coproduct: field_coproduct,
                field_encoding: field_encoding,
                type_coproduct_wire_contract: type_coproduct_wire_contract
              )
          }
      }
  }
}

fn tepe_build_coproduct_wire_contract_index(
  root: Node,
  field_coproduct: Symbol,
  field_encoding: Symbol,
  type_coproduct_wire_contract: Symbol
) -> Outcome<List<CoproductWireContractIndexRow>> {
  match tepe_fold_index_over_decls(
    acc: CoproductWireContractIndexOk { rows: Empty },
    decls: tepe_collect_data_decl_nodes(root: root),
    field_coproduct: field_coproduct,
    field_encoding: field_encoding,
    type_coproduct_wire_contract: type_coproduct_wire_contract
  ) {
    CoproductWireContractIndexOk { rows: rows } => outcome_accepted(rows)
    CoproductWireContractIndexErr { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn tepe_lookup_contract_row(
  rows: List<CoproductWireContractIndexRow>,
  enum_sym: Symbol
) -> Optional<CoproductWireContractIndexRow> {
  match list_at_optional(xs: rows, index: 0) {
    Absent => optional_absent()
    Present { value: head } =>
      match head {
        CoproductWireContractIndexRow { coproduct_sym: csym, naming_tag: _, decl: _ } =>
          if tepe_declaration_ref_spelling_matches_enum(coproduct_sym: csym, enum_sym: enum_sym) {
            optional_present(value: head)
          } else {
            match list_tail(xs: rows) {
              TailAbsent => optional_absent()
              TailFound { tail: tail } =>
                tepe_lookup_contract_row(rows: tail, enum_sym: enum_sym)
            }
          }
      }
  }
}

fn tepe_naming_spelling_basename(spelling: String) -> String {
  match spelling {
    "\"ScreamingSnakeCase\"" => "ScreamingSnakeCase"
    "VariantNaming.ScreamingSnakeCase" => "ScreamingSnakeCase"
    "\"VariantNaming.ScreamingSnakeCase\"" => "ScreamingSnakeCase"
    "\"SnakeCase\"" => "SnakeCase"
    "VariantNaming.SnakeCase" => "SnakeCase"
    "\"VariantNaming.SnakeCase\"" => "SnakeCase"
    _ => spelling
  }
}

fn tepe_quoted_spelling_matches(spelling: String, ident: String) -> Bool {
  spelling == concat("\"", concat(ident, "\""))
}

fn tepe_naming_spellings_equivalent(left_spelling: String, right_spelling: String) -> Bool {
  let left_base = tepe_naming_spelling_basename(spelling: left_spelling)
  let right_base = tepe_naming_spelling_basename(spelling: right_spelling)
  if left_base == right_base {
    true
  } else if left_spelling == right_spelling {
    true
  } else if tepe_quoted_spelling_matches(spelling: left_spelling, ident: right_spelling) {
    true
  } else {
    tepe_quoted_spelling_matches(spelling: right_spelling, ident: left_spelling)
  }
}

fn tepe_naming_tags_equivalent(left: Symbol, right: Symbol) -> Bool {
  if left == right {
    true
  } else {
    match symbol_interned_spelling(binding: left) {
      Accepted { value: left_spelling, diagnostics: _ } =>
        match symbol_interned_spelling(binding: right) {
          Accepted { value: right_spelling, diagnostics: _ } =>
            tepe_naming_spellings_equivalent(
              left_spelling: left_spelling,
              right_spelling: right_spelling
            )
          Rejected { diagnostics: _ } => false
        }
      Rejected { diagnostics: _ } => false
    }
  }
}

fn tepe_disj_form_from_catalog_row(
  row: Node,
  naming_tag: Symbol
) -> Outcome<TargetSumTypeShape> {
  bind_outcome(
    o: find_named_child(root: row, name: ^target_type_expr_projection_enrichment_catalog_naming_tag),
    f: fn(tag_child) {
      bind_outcome(
        o: find_named_child(root: row, name: ^target_type_expr_projection_enrichment_catalog_disj_form),
        f: fn(form_child) {
          match tag_child.kind {
            TypeNode { connective: Atom { identity: tag } } =>
              if tepe_naming_tags_equivalent(left: tag, right: naming_tag) {
                decode_sum_type_shape_bundle(bundle: form_child)
              } else {
                outcome_rejected(
                  tepe_coproduct_wire_contract_malformed_diagnostic(node: row)
                )
              }
            _ =>
              outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: row))
          }
        }
      )
    }
  )
}

fn tepe_disj_form_from_catalog_row_decode(row: Node) -> Outcome<TargetSumTypeShape> {
  bind_outcome(
    o: find_named_child(
      root: row,
      name: ^target_type_expr_projection_enrichment_catalog_disj_form
    ),
    f: fn(form_child) {
      decode_sum_type_shape_bundle(bundle: form_child)
    }
  )
}

fn tepe_disj_form_from_catalog(catalog: Node, naming_tag: Symbol) -> Outcome<TargetSumTypeShape> {
  match fold(
    catalog.children,
    init: outcome_rejected(
      tepe_coproduct_wire_contract_malformed_diagnostic(node: catalog)
    ),
    f: fn(acc, e) {
      match acc {
        Accepted { value: _, diagnostics: _ } => acc
        Rejected { diagnostics: _ } =>
          match e.label {
            Named { name: n } =>
              if n == ^target_type_expr_projection_enrichment_catalog_naming_tag
                || n == ^target_type_expr_projection_enrichment_catalog_disj_form
              {
                acc
              } else {
                tepe_disj_form_from_catalog_row(row: e.target, naming_tag: naming_tag)
              }
            Positional => tepe_disj_form_from_catalog_row(row: e.target, naming_tag: naming_tag)
          }
      }
    }
  ) {
    Accepted { value: form, diagnostics: d } => Accepted { value: form, diagnostics: d }
    Rejected { diagnostics: _ } =>
      match fold(
        catalog.children,
        init: outcome_rejected(
          tepe_coproduct_wire_contract_malformed_diagnostic(node: catalog)
        ),
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } => acc
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: n } =>
                  if n == ^target_type_expr_projection_enrichment_catalog_naming_tag
                    || n == ^target_type_expr_projection_enrichment_catalog_disj_form
                  {
                    acc
                  } else {
                    tepe_disj_form_from_catalog_row_decode(row: e.target)
                  }
                Positional => tepe_disj_form_from_catalog_row_decode(row: e.target)
              }
          }
        }
      ) {
        Accepted { value: form, diagnostics: d } => Accepted { value: form, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
  }
}

fn tepe_enrichment_protocol(enrichment: Node) -> Outcome<Symbol> {
  bind_outcome(
    o: find_named_child(root: enrichment, name: ^target_type_expr_projection_enrichment_protocol),
    f: fn(child) {
      match child.kind {
        TypeNode { connective: Atom { identity: sym } } => outcome_accepted(sym)
        _ =>
          outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: enrichment))
      }
    }
  )
}

fn tepe_apply_coproduct_wire_contract_enrichment(
  base: TargetTypeExpressionProjection,
  enrichment: Node,
  tree: InferredTree,
  node: Node
) -> Outcome<TargetTypeExpressionProjection> {
  match node.kind {
    TypeNode { connective: Disj } =>
      bind_outcome(
        o: tepe_enrichment_protocol(enrichment: enrichment),
        f: fn(protocol) {
          if protocol == ^target_type_expr_projection_enrichment_protocol_coproduct_wire_contract {
            bind_outcome(
              o: find_named_child(
                root: enrichment,
                name: ^target_type_expr_projection_enrichment_field_coproduct
              ),
              f: fn(field_coproduct_child) {
                bind_outcome(
                  o: find_named_child(
                    root: enrichment,
                    name: ^target_type_expr_projection_enrichment_field_encoding
                  ),
                  f: fn(field_encoding_child) {
                    bind_outcome(
                      o: find_named_child(
                        root: enrichment,
                        name: ^target_type_expr_projection_enrichment_type_coproduct_wire_contract
                      ),
                      f: fn(type_child) {
                        bind_outcome(
                          o: find_named_child(
                            root: enrichment,
                            name: ^target_type_expr_projection_enrichment_disj_form_catalog
                          ),
                          f: fn(catalog) {
                            match field_coproduct_child.kind {
                              TypeNode { connective: Atom { identity: field_coproduct } } =>
                                match field_encoding_child.kind {
                                  TypeNode { connective: Atom { identity: field_encoding } } =>
                                    match type_child.kind {
                                      TypeNode {
                                        connective: Atom { identity: type_coproduct_wire_contract }
                                      } =>
                                        bind_outcome(
                                          o: tepe_build_coproduct_wire_contract_index(
                                            root: tree.root,
                                            field_coproduct: field_coproduct,
                                            field_encoding: field_encoding,
                                            type_coproduct_wire_contract: type_coproduct_wire_contract
                                          ),
                                          f: fn(rows) {
                                            match tepe_contract_row_for_disj_anchor(
                                              rows: rows,
                                              root: tree.root,
                                              disj_anchor: node
                                            ) {
                                              Present { value: contract } =>
                                                tepe_apply_contract_row_enrichment(
                                                  base: base,
                                                  catalog: catalog,
                                                  contract: contract
                                                )
                                              Absent => outcome_accepted(base)
                                            }
                                          }
                                        )
                                      _ =>
                                        outcome_rejected(
                                          tepe_coproduct_wire_contract_malformed_diagnostic(
                                            node: enrichment
                                          )
                                        )
                                    }
                                  _ =>
                                    outcome_rejected(
                                      tepe_coproduct_wire_contract_malformed_diagnostic(
                                        node: enrichment
                                      )
                                    )
                                }
                              _ =>
                                outcome_rejected(
                                  tepe_coproduct_wire_contract_malformed_diagnostic(
                                    node: enrichment
                                  )
                                )
                            }
                          }
                        )
                      }
                    )
                  }
                )
              }
            )
          } else {
            outcome_accepted(base)
          }
        }
      )
    _ => outcome_accepted(base)
  }
}

fn tepe_apply_type_expression_projection_enrichment(
  base: TargetTypeExpressionProjection,
  enrichment: Node,
  tree: InferredTree,
  node: Node
) -> Outcome<TargetTypeExpressionProjection> {
  tepe_apply_coproduct_wire_contract_enrichment(
    base: base,
    enrichment: enrichment,
    tree: tree,
    node: node
  )
}

type TepeBundleChildLookup
  = TepeBundleChildMissing
  | TepeBundleChildFound { value: Node }
  | TepeBundleChildDuplicate
  | TepeBundleChildInvalidEdge

fn tepe_bundle_child_lookup_step(
  acc: TepeBundleChildLookup,
  e: Edge,
  edge_name: Symbol
) -> TepeBundleChildLookup {
  match acc {
    TepeBundleChildDuplicate => TepeBundleChildDuplicate
    TepeBundleChildInvalidEdge => TepeBundleChildInvalidEdge
    TepeBundleChildFound { value: _ } =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            TepeBundleChildDuplicate
          } else {
            acc
          }
        Positional => TepeBundleChildInvalidEdge
      }
    TepeBundleChildMissing =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            TepeBundleChildFound { value: e.target }
          } else {
            TepeBundleChildMissing
          }
        Positional => TepeBundleChildInvalidEdge
      }
  }
}

fn tepe_target_bundle_optional_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node?> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.bundle.children,
        init: TepeBundleChildMissing,
        f: fn(acc, e) {
          tepe_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        TepeBundleChildFound { value: child } =>
          Accepted { value: Present { value: child }, diagnostics: None }
        TepeBundleChildMissing => Accepted { value: Absent, diagnostics: None }
        TepeBundleChildDuplicate =>
          outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: target.bundle))
        TepeBundleChildInvalidEdge =>
          outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: target.bundle))
      }
    _ => outcome_rejected(tepe_coproduct_wire_contract_malformed_diagnostic(node: target.bundle))
  }
}

fn type_expression_projection_for_translate(
  tree: InferredTree,
  target: TargetModel,
  node: Node
) -> Outcome<TargetTypeExpressionProjection> {
  bind_outcome(
    o: type_expression_projection_from_target(target: target),
    f: fn(base) {
      match tepe_target_bundle_optional_child(
        target: target,
        edge_name: ^target_model_edge_type_expression_projection_enrichment
      ) {
        Accepted { value: optional_enrichment, diagnostics: d } =>
          match optional_enrichment {
            Present { value: enrichment } =>
              bind_outcome(
                o: tepe_apply_type_expression_projection_enrichment(
                  base: base,
                  enrichment: enrichment,
                  tree: tree,
                  node: node
                ),
                f: fn(projection) {
                  Accepted { value: projection, diagnostics: d }
                }
              )
            Absent => Accepted { value: base, diagnostics: d }
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    }
  )
}

fn tepe_first_data_decl_optional(root: Node) -> Optional<Node> {
  fold_node(
    n: root,
    algebra: NodeFold {
      init: fn(node) {
        if tepe_node_has_surface(root: node, surface: ^dag_surface_data_decl) {
          optional_present(value: node)
        } else {
          optional_absent()
        }
      },
      step: fn(acc, _edge, child_acc) {
        match acc {
          Present { value: _ } => acc
          Absent => child_acc
        }
      }
    }
  )
}

fn tepe_data_decl_parts_present(root: Node) -> Bool {
  match tepe_first_data_decl_optional(root: root) {
    Present { value: decl } =>
      match tepe_data_decl_type_and_expr_optional(decl: decl) {
        Present { value: _ } => true
        Absent => false
      }
    Absent => false
  }
}

fn tepe_data_decl_type_sym_optional(root: Node) -> Optional<Symbol> {
  match tepe_first_data_decl_optional(root: root) {
    Present { value: decl } =>
      match tepe_data_decl_type_and_expr_optional(decl: decl) {
        Present { value: parts } => tepe_atom_sym_optional(node: parts.type_expr)
        Absent => optional_absent()
      }
    Absent => optional_absent()
  }
}

fn tepe_data_decl_field_value_optional(root: Node, field: Symbol) -> Optional<Node> {
  match tepe_first_data_decl_optional(root: root) {
    Present { value: decl } =>
      match tepe_data_decl_type_and_expr_optional(decl: decl) {
        Present { value: parts } =>
          tepe_named_field_target(root: parts.expr, field: field)
        Absent => optional_absent()
      }
    Absent => optional_absent()
  }
}

fn tepe_data_decl_coproduct_ref_sym_accepts(root: Node) -> Bool {
  match tepe_first_data_decl_optional(root: root) {
    Present { value: decl } =>
      match tepe_data_decl_field_value_optional(root: root, field: ^coproduct) {
        Present { value: coproduct_node } =>
          match tepe_declaration_ref_sym_from_value(node: coproduct_node, decl: decl) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn tepe_data_decl_encoding_naming_tag_accepts(root: Node) -> Bool {
  match tepe_first_data_decl_optional(root: root) {
    Present { value: decl } =>
      match tepe_data_decl_field_value_optional(root: root, field: ^encoding) {
        Present { value: encoding } =>
          match tepe_variant_naming_tag_from_encoding(encoding: encoding, decl: decl) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn tepe_data_decl_coproduct_row_present(
  root: Node,
  field_coproduct: Symbol,
  field_encoding: Symbol,
  type_coproduct_wire_contract: Symbol
) -> Bool {
  match tepe_first_data_decl_optional(root: root) {
    Present { value: decl } =>
      match tepe_coproduct_sym_from_decl(
        decl: decl,
        field_coproduct: field_coproduct,
        field_encoding: field_encoding,
        type_coproduct_wire_contract: type_coproduct_wire_contract
      ) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Absent => false
  }
}

fn tepe_wire_contract_index_nonempty(tree: InferredTree, target: TargetModel) -> Bool {
  match tepe_target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_type_expression_projection_enrichment
  ) {
    Accepted { value: optional_enrichment, diagnostics: _ } =>
      match optional_enrichment {
        Present { value: enrichment } =>
          match bind_outcome(
            o: find_named_child(
              root: enrichment,
              name: ^target_type_expr_projection_enrichment_field_coproduct
            ),
            f: fn(field_coproduct_child) {
              bind_outcome(
                o: find_named_child(
                  root: enrichment,
                  name: ^target_type_expr_projection_enrichment_field_encoding
                ),
                f: fn(field_encoding_child) {
                  bind_outcome(
                    o: find_named_child(
                      root: enrichment,
                      name: ^target_type_expr_projection_enrichment_type_coproduct_wire_contract
                    ),
                    f: fn(type_child) {
                      match field_coproduct_child.kind {
                        TypeNode { connective: Atom { identity: field_coproduct } } =>
                          match field_encoding_child.kind {
                            TypeNode { connective: Atom { identity: field_encoding } } =>
                              match type_child.kind {
                                TypeNode {
                                  connective: Atom { identity: type_coproduct_wire_contract }
                                } =>
                                  match tepe_build_coproduct_wire_contract_index(
                                    root: tree.root,
                                    field_coproduct: field_coproduct,
                                    field_encoding: field_encoding,
                                    type_coproduct_wire_contract: type_coproduct_wire_contract
                                  ) {
                                    Accepted { value: rows, diagnostics: _ } =>
                                      outcome_accepted(!is_empty(xs: rows))
                                    Rejected { diagnostics: _ } => outcome_accepted(false)
                                  }
                                _ => outcome_accepted(false)
                              }
                            _ => outcome_accepted(false)
                          }
                        _ => outcome_accepted(false)
                      }
                    }
                  )
                }
              )
            }
          ) {
            Accepted { value: ok, diagnostics: _ } => ok
            Rejected { diagnostics: _ } => false
          }
        Absent => false
      }
    Rejected { diagnostics: _ } => false
  }
}
