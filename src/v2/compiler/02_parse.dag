  }
}

// FIND, DO NOT BUILD. This is called once per nonterminal reference at every parse step, and the
// previous form allocated a filtered copy of the whole production list to take its first element.
fn grammar_first_production_named(
  root: GrammarRoot,
  name: Symbol
) -> Optional<GrammarProduction> {
  fold_list(
    xs: root.productions,
    empty: Absent,
    cons: fn(acc, p) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match p.name == name {
            true => Present { value: p }
            false => Absent
          }
      }
    }
  )
}

fn grammar_lookup_production(root: GrammarRoot, name: Symbol) -> Witness<GrammarProduction> {
  match grammar_first_production_named(root: root, name: name) {
    Present { value: production } => Holds { value: production }
    Absent =>
      Violates {
        diagnostic: parse_grammar_undefined_nonterminal_diagnostic(
          at: port_locus(port: ^parse_stage_locus_port)
        )
      }
  }
}

data grammar_lookup_production_indexed_note: String = "grammar_lookup_production is an O(P) filter scan over the full production list; it is the well-formedness/analysis authority, run once per grammar at prepare_grammar time (§6 already-hoisted cost) and is correct to keep as the single-authority derivation of the index below. grammar_lookup_production_indexed is the per-dispatch consumer: every nonterminal reference during recursive-descent parsing calls it, memoized or not (parse_nonterminal_memoized_core looks the production up before consulting the memo table), so the P=204-production dag grammar turned this into the dominant cost of parsing even a trivial source under the tree-walking v1 interpreter (measured: ~12s to parse a 3-line source, PR #8478). productions_by_name is that lookup's index, built once by grammar_production_index and carried on ParseTable exactly like nullable_set/first_rows already are (parse_table_carry_analysis threads all three through every table mutation) — one Map<Symbol,GrammarProduction>, not a second production roster (§3). Every ParseTableRealization construction site (parse_table_for_production_analyzed, the real-parse path; parse_table_empty; parse_table_carry_analysis, the pass-through on every table mutation) populates this field, so the O(P)->O(1) change is not opt-in per call site. Measured effect (this host, dag/test/claim/long/dag_arrow_lambda_witness_test.dag witness_single_param_lambda_parses via `gunbc run --claim-run`, fix stashed vs applied around the identical whole-process invocation): 78.023s -> 74.006s wall. That delta undercounts the fix's effect on the specific fold it repairs, because the invocation's wall time is dominated by up-front module-load/typecheck of the full v2 closure — a cost this change does not touch — rather than by the repeated per-dispatch grammar lookup inside the parse itself; the O(204)->O(1) asymptotic claim is the primary evidence (grammar_lookup_production is an unmemoized linear filter reached before every memo-table check, so even a memo HIT paid the full scan), not the crude wall-clock ratio. This is the class docs/plans/measurements/floor-slow-rows-2026-08-18.md records dag_arrow_lambda_witness_test's rows landing 1-4ms over its 1552ms ceiling for."

fn grammar_production_index(productions: List<GrammarProduction>) -> Map<Symbol, GrammarProduction> {
  fold_list(
    xs: productions,
    empty: empty_map(),
    cons: fn(acc, p) { map_insert(m: acc, key: p.name, value: p) }
  )
}

fn grammar_lookup_production_indexed(table: ParseTable, name: Symbol) -> Witness<GrammarProduction> {
  witness_from_optional(
    opt: map_lookup(m: table.productions_by_name, key: name),
    absent: parse_grammar_undefined_nonterminal_diagnostic(
      at: port_locus(port: ^parse_stage_locus_port)
    )
  )
}

fn parse_table_memo_miss_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^parse_table_memo_miss,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn parse_table_entries_lookup(table: ParseTable, key: ParsePositionKey) -> Witness<ParseMemoEntry> {
  witness_from_optional(
    opt: table.entries.lookup(key),
    absent: parse_table_memo_miss_diagnostic(at: port_locus(port: ^parse_stage_locus_port))
  )
}

fn parse_table_lookup(table: ParseTable, key: ParsePositionKey) -> Witness<ParseMemoEntry> {
  match v2.compiler.materialization_carriers.materialization_allows_memo_store(m: table.materialization) {
    true => { parse_table_entries_lookup(table: table, key: key) }
    false => {
      Violates {
        diagnostic: parse_table_memo_store_refused_diagnostic(
          at: port_locus(port: ^parse_stage_locus_port)
        )
      }
    }
  }
}

fn parse_table_memo_store_refused_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^parse_table_memo_store_refused,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn parse_table_memo_store_refused_reason(d: Diagnostic) -> Bool {
  match d {
    Diagnostic { reason: r, at: _, correction: _ } =>
      r == ^parse_table_memo_store_refused
  }
}

fn parse_table_memo_lookup_refuses_store(table: ParseTable, key: ParsePositionKey) -> Bool {
  match parse_table_lookup(table: table, key: key) {
    Violates { diagnostic: d } => parse_table_memo_store_refused_reason(d: d)
    Holds { value: _ } => false
  }
}

fn parse_table_memo_insert_refused(
  table: ParseTable,
  key: ParsePositionKey,
  value: ParseMemoEntry
) -> Bool {
  let after = parse_table_insert(table: table, key: key, value: value)
  match v2.std.collection.map_get(m: after.entries, key: key) {
    Accepted { value: Absent } => true
    Accepted { value: Present { value: _ } } => false
    Rejected { diagnostics: _ } => false
  }
}

fn parse_memo_entry_from_expr(result: ParseExprResult) -> ParseMemoEntry {
  match result {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diagnostics, prov: prov, table: _ } =>
      ParseMemoAccepted {
        remaining: remaining,
        captured: captured,
        diagnostics: diagnostics,
        prov: prov
      }
    ParseExprRejected { diagnostics: diagnostics, table: _ } =>
      ParseMemoRejected { diagnostics: diagnostics }
  }
}

fn parse_expr_result_table(result: ParseExprResult) -> ParseTable {
  match result {
    ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: table } => table
    ParseExprRejected { diagnostics: _, table: table } => table
  }
}

fn parse_table_memo_stats(table: ParseTable) -> ParseMemoStats {
  ParseMemoStats {
    hits: table.memo_hits,
    misses: table.memo_misses,
    lookup_calls: table.memo_lookup_calls
  }
}

fn parse_table_carry_analysis(table: ParseTable, entries: Map<ParsePositionKey, ParseMemoEntry>, hits: Int, misses: Int, lookups: Int) -> ParseTable {
  ParseTableRealization {
    artifact_kind: table.artifact_kind,
    provider_id: table.provider_id,
    materialization: table.materialization,
    grammar_digest: table.grammar_digest,
    token_stream_digest: table.token_stream_digest,
    entries: entries,
    memo_hits: hits,
    memo_misses: misses,
    memo_lookup_calls: lookups,
    nullable_set: table.nullable_set,
    first_rows: table.first_rows,
    productions_by_name: table.productions_by_name
  }
}

fn parse_table_record_lookup_call(table: ParseTable) -> ParseTable {
  parse_table_carry_analysis(
    table: table,
    entries: table.entries,
    hits: table.memo_hits,
    misses: table.memo_misses,
    lookups: table.memo_lookup_calls + 1
  )
}

fn parse_table_record_hit(table: ParseTable) -> ParseTable {
  parse_table_carry_analysis(
    table: table,
    entries: table.entries,
    hits: table.memo_hits + 1,
    misses: table.memo_misses,
    lookups: table.memo_lookup_calls
  )
}

fn parse_table_record_miss(table: ParseTable) -> ParseTable {
  parse_table_carry_analysis(
    table: table,
    entries: table.entries,
    hits: table.memo_hits,
    misses: table.memo_misses + 1,
    lookups: table.memo_lookup_calls
  )
}

fn parse_table_insert(table: ParseTable, key: ParsePositionKey, value: ParseMemoEntry) -> ParseTable {
  match v2.compiler.materialization_carriers.materialization_allows_memo_store(m: table.materialization) {
    true =>
      parse_table_carry_analysis(
        table: table,
        entries: map_insert(m: table.entries, key: key, value: value),
        hits: table.memo_hits,
        misses: table.memo_misses,
        lookups: table.memo_lookup_calls
      )
    false => table
  }
}

fn parse_grammar_digest(validated: ValidatedGrammarRoot) -> Hash {
  content_hash(
    n: grammar_to_node(grammar: ModeledGrammar { root: validated.root })
  )
}

fn parse_lexeme_digest(lexeme: Lexeme) -> Hash {
  fold_list(
    xs: lexeme,
    empty: symbol_identity_digest(sym: ^parse_lexeme_digest_nil),
    cons: fn(acc, ch) {
      combine_hash(a: acc, b: byte_limb_hash_peano_digest(limb: ch))
    }
  )
}

fn parse_token_stream_digest(all_tokens: List<Token>) -> Hash {
  fold_list(
    xs: all_tokens,
    empty: symbol_identity_digest(sym: ^parse_token_stream_digest_nil),
    cons: fn(acc, tok) {
      combine_hash(
        a: acc,
        b: combine_hash(
          a: combine_hash(
            a: symbol_identity_digest(sym: tok.class),
            b: symbol_identity_digest(sym: tok.file)
          ),
          b: combine_hash(
            a: combine_hash(
              a: byte_limb_hash_peano_digest(limb: tok.start),
              b: byte_limb_hash_peano_digest(limb: tok.end)
            ),
            b: parse_lexeme_digest(lexeme: tok.lexeme)
          )
        )
      )
    }
  )
}

fn parse_table_for_production_analyzed(
  validated: ValidatedGrammarRoot,
  analysis: GrammarFirstAnalysis,
  all_tokens: List<Token>
) -> ParseTable {
  ParseTableRealization {
    artifact_kind: v2.compiler.materialization_carriers.parse_table_memo_artifact_kind(),
    provider_id: v2.compiler.materialization_carriers.parse_table_memo_provider_id(),
    materialization: v2.compiler.materialization_carriers.parse_table_memo_materialization(),
    grammar_digest: parse_grammar_digest(validated: validated),
    token_stream_digest: parse_token_stream_digest(all_tokens: all_tokens),
    entries: empty_map(),
    memo_hits: 0,
    memo_misses: 0,
    memo_lookup_calls: 0,
    nullable_set: analysis.nullable_set,
    first_rows: analysis.first_rows,
    productions_by_name: grammar_production_index(productions: validated.root.productions)
  }
}

fn parse_table_for_production(
  validated: ValidatedGrammarRoot,
  all_tokens: List<Token>
) -> ParseTable {
  parse_table_for_production_analyzed(
    validated: validated,
    analysis: compute_grammar_first_analysis(root: validated.root),
    all_tokens: all_tokens
  )
}

fn parse_table_empty() -> ParseTable {
  ParseTableRealization {
    artifact_kind: v2.compiler.materialization_carriers.parse_table_memo_artifact_kind(),
    provider_id: v2.compiler.materialization_carriers.parse_table_memo_provider_id(),
    materialization: v2.compiler.materialization_carriers.parse_table_memo_materialization(),
    grammar_digest: content_hash(n: grammar_empty_node()),
    token_stream_digest: symbol_identity_digest(sym: ^parse_table_empty_token_stream),
    entries: empty_map(),
    memo_hits: 0,
    memo_misses: 0,
    memo_lookup_calls: 0,
    nullable_set: Set { member: fn(_) { false } },
    first_rows: empty_map(),
    productions_by_name: empty_map()
  }
}

fn parse_table_subject(table: ParseTable, key: ParsePositionKey) -> Hash {
  combine_hash(
    a: combine_hash(a: table.grammar_digest, b: table.token_stream_digest),
    b: combine_hash(
      a: byte_limb_hash_peano_digest(limb: key.position),
      b: symbol_identity_digest(sym: key.production)
    )
  )
}

fn parse_current_position(tokens: List<Token>) -> Int {
  match list_head(xs: tokens) {
    HeadFound { value: t } => t.start + 1
    HeadAbsent => 0
  }
}

fn token_position_indices(tokens: List<Token>) -> List<Int> {
  match is_empty(xs: tokens) {
    true => Cons { head: 0, tail: std.algebra.Empty }
    false =>
      fold_list(
        xs: tokens,
        empty: Cons { head: 0, tail: std.algebra.Empty },
        cons: fn(acc, _) {
          list_snoc_item(xs: acc, item: length(xs: acc))
        }
      )
  }
}

fn parse_non_empty_diagnostics_to_list(ned: NonEmptyDiagnostics) -> List<Diagnostic> {
  list_append(left: [ned.head], right: ned.tail)
}

fn parse_prov_initial() -> ParseProvenanceState {
  ParseProvenanceState {
    alloc: occurrence_id_allocator_initial(),
    index: span_index_empty()
  }
}

fn parse_prov_merge(
  base: ParseProvenanceState,
  incoming: ParseProvenanceState
) -> ParseProvenanceState {
  ParseProvenanceState {
    alloc: occurrence_id_allocator_advance_to(
      alloc: base.alloc,
      min_next: authored_token_ordinal_space_from_allocator(
        alloc: incoming.alloc
      )
    ),
    index: span_index_merge(base: base.index, incoming: incoming.index)
  }
}

fn parse_mint_from_source(
  prov: ParseProvenanceState,
  file: Symbol,
  start: Int,
  end: Int
) -> ParseMintSourceResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let locus = Textual {
    file: file,
    extent: ByteRange { start: start, end: end }
  }
  let event = origin_event_from_source(locus: locus)
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseMintSourceResult {
    id: minted.id,
    prov: ParseProvenanceState { alloc: minted.alloc, index: index }
  }
}

fn parse_minted_id_from_node(n: Node) -> List<OccurrenceId> {
  match n.occurrence_id {
    MintedOccurrence { id: id } => Cons { head: id, tail: std.algebra.Empty }
    SyntheticOccurrence => std.algebra.Empty
  }
}

fn parse_minted_id_list(nodes: List<Node>) -> List<OccurrenceId> {
  fold_list(
    xs: nodes,
    empty: std.algebra.Empty,
    cons: fn(acc, n) {
      list_append(left: acc, right: parse_minted_id_from_node(n: n))
    }
  )
}

fn parse_stamp_terminal(
  tok: Token,
  stamp: TerminalStampMode,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = parse_mint_from_source(
    prov: prov,
    file: tok.file,
    start: tok.start,
    end: tok.end
  )
  let identity = match stamp {
    StampClass => tok.class
    StampBinding { binding: b } => b
    StampLexeme => symbol_intern_lexeme(lexeme: tok.lexeme)
  }
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Atom { identity: identity } },
      children: [],
      occurrence_id: node_occurrence_minted(id: minted.id)
    ),
    prov: minted.prov
  }
}

fn parse_repeat_captured_node(acc_nodes: List<Node>, occurrence_id: NodeOccurrenceId) -> Node {
  let spine = fold_list_right(
    xs: acc_nodes,
    empty: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    },
    snoc: fn(tail_node, item) {
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          grammar_named_edge(name: ^grammar_sequence_left_node_projection, target: item),
          grammar_named_edge(name: ^grammar_sequence_right_node_projection, target: tail_node)
        ],
        occurrence_id: SyntheticOccurrence
      }
    }
  )
  node_with_occurrence_id(
    kind: spine.kind,
    children: spine.children,
    occurrence_id: occurrence_id
  )
}

fn parse_stamp_derived_conj(
  cap1: Node,
  cap2: Node,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: [cap1, cap2])
  let event = DerivedBy { producer: ^parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Conj },
      children: [
        grammar_named_edge(name: ^grammar_sequence_left_node_projection, target: cap1),
        grammar_named_edge(name: ^grammar_sequence_right_node_projection, target: cap2)
      ],
      occurrence_id: node_occurrence_minted(id: minted.id)
    ),
    prov: ParseProvenanceState { alloc: minted.alloc, index: index }
  }
}

fn parse_stamp_derived_repeat(
  acc_nodes: List<Node>,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: acc_nodes)
  let event = DerivedBy { producer: ^parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: parse_repeat_captured_node(
      acc_nodes: acc_nodes,
      occurrence_id: node_occurrence_minted(id: minted.id)
    ),
    prov: ParseProvenanceState { alloc: minted.alloc, index: index }
  }
}

fn parse_wrap_production_captured(
  production: GrammarProduction,
  captured: Node,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: [captured])
  let event = DerivedBy { producer: ^parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Conj },
      children: [
        grammar_named_edge(name: ^grammar_production_identity_node_projection, target: production.emitted),
        grammar_named_edge(name: ^grammar_production_captured_node_projection, target: captured)
      ],
      occurrence_id: node_occurrence_minted(id: minted.id)
    ),
    prov: ParseProvenanceState { alloc: minted.alloc, index: index }
  }
}

fn parse_nonterminal_memoized(
  all_tokens: List<Token>,
  tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prod_name: Symbol,
  prov: ParseProvenanceState
) -> ParseExprResult {
  if prod_name == ^dag_production_match_arm_stmt_body {
    parse_match_arm_stmt_body(
      all_tokens: all_tokens,
      tokens: tokens,
      root: root,
      table: table,
      prov: prov
    )
  } else {
    parse_nonterminal_memoized_core(
      all_tokens: all_tokens,
      tokens: tokens,
      root: root,
      table: table,
      prod_name: prod_name,
      prov: prov
    )
  }
}

type ParseMatchArmStmtAcc {
  remaining: List<Token>
  acc_nodes: List<Node>
  acc_diags: List<List<Diagnostic>>
  done: Bool
  prov: ParseProvenanceState
  table: ParseTable
}

fn parse_flatten_diag_batches(batches: List<List<Diagnostic>>) -> List<Diagnostic> {
  fold_list(
    xs: batches,
    empty: std.algebra.Empty,
    cons: fn(acc, batch) {
      fold_list(
        xs: batch,
        empty: acc,
        cons: fn(inner_acc, d) { Cons { head: d, tail: inner_acc } }
      )
    }
  ).reverse()
}

fn parse_char_is_arm_pattern_lead(c: Char) -> Bool {
  (c == 95) || ((c >= 65) && (c <= 90))
}

fn parse_token_lexeme_is(tok: Token, lit: String) -> Bool {
  tok.lexeme == lit
}

fn parse_next_brace_depth(tok: Token, depth: Int) -> Int {
  if parse_token_lexeme_is(tok: tok, lit: "{") {
    depth + 1
  } else if parse_token_lexeme_is(tok: tok, lit: "}") {
    depth - 1
  } else {
    depth
  }
}

fn parse_scan_fat_arrow_after_lbrace(tokens: List<Token>, depth: Int) -> Bool {
  if depth <= 0 {
    match parse_token_first(tokens: tokens) {
      Absent => false
      Present { value: tok } => parse_token_lexeme_is(tok: tok, lit: "=>")
    }
  } else {
    match parse_token_first(tokens: tokens) {
      Absent => false
      Present { value: tok } =>
        match list_tail(xs: tokens) {
          TailAbsent => false
          TailFound { tail: rest } =>
            parse_scan_fat_arrow_after_lbrace(
              tokens: rest,
              depth: parse_next_brace_depth(tok: tok, depth: depth)
            )
        }
    }
  }
}

fn parse_tokens_drop_one(tokens: List<Token>) -> List<Token> {
  match list_tail(xs: tokens) {
    TailFound { tail: rest } => rest
    TailAbsent => []
  }
}

fn parse_tokens_drop(tokens: List<Token>, count: Int) -> List<Token> {
  if count <= 0 {
    tokens
  } else {
    parse_tokens_drop(tokens: parse_tokens_drop_one(tokens: tokens), count: count - 1)
  }
}

fn parse_looks_like_match_arm_start(tokens: List<Token>) -> Bool {
  match parse_token_first(tokens: tokens) {
    Absent => false
    Present { value: tok0 } =>
      match string_head(s: tok0.lexeme) {
        CharFound { value: c } =>
          if parse_char_is_arm_pattern_lead(c: c) {
            match parse_token_second(tokens: tokens) {
              Present { value: tok1 } =>
                if parse_token_lexeme_is(tok: tok1, lit: "=>") {
                  true
                } else if parse_token_lexeme_is(tok: tok1, lit: "{") {
                  parse_scan_fat_arrow_after_lbrace(
                    tokens: parse_tokens_drop(tokens: tokens, count: 2),
                    depth: 1
                  )
                } else {
                  false
                }
              Absent => false
            }
          } else {
            false
          }
        CharAbsent => false
      }
  }
}

fn parse_stamp_match_arm_stmt_nodes(
  acc_nodes: List<Node>,
  prov: ParseProvenanceState
) -> ParseStampResult {
  if length(xs: acc_nodes) == 1 {
    match list_at_optional(xs: acc_nodes, index: 0) {
      Present { value: only } => ParseStampResult { node: only, prov: prov }
      Absent => ParseStampResult { node: grammar_empty_node(), prov: prov }
    }
  } else {
    parse_stamp_derived_repeat(acc_nodes: acc_nodes, prov: prov)
  }
}

fn parse_match_arm_stmt_step(
  all_tokens: List<Token>,
  root: GrammarRoot,
  acc: ParseMatchArmStmtAcc
) -> ParseMatchArmStmtAcc {
  if acc.done {
    acc
  } else if parse_looks_like_match_arm_start(tokens: acc.remaining) {
    ParseMatchArmStmtAcc {
      remaining: acc.remaining,
      acc_nodes: acc.acc_nodes,
      acc_diags: acc.acc_diags,
      done: true,
      prov: acc.prov,
      table: acc.table
    }
  } else {
    match parse_nonterminal_memoized_core(
      all_tokens: all_tokens,
      tokens: acc.remaining,
      root: root,
      table: acc.table,
      prod_name: ^dag_production_stmt,
      prov: acc.prov
    ) {
      ParseExprRejected { diagnostics: _, table: table1 } =>
        ParseMatchArmStmtAcc {
          remaining: acc.remaining,
          acc_nodes: acc.acc_nodes,
          acc_diags: acc.acc_diags,
          done: true,
          prov: acc.prov,
          table: table1
        }
      ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 } =>
        if length(xs: rest) != length(xs: acc.remaining) {
          parse_match_arm_stmt_step(
            all_tokens: all_tokens,
            root: root,
            acc: ParseMatchArmStmtAcc {
              remaining: rest,
              acc_nodes: Cons { head: cap, tail: acc.acc_nodes },
              acc_diags: Cons { head: diags, tail: acc.acc_diags },
              done: false,
              prov: prov1,
              table: table1
            }
          )
        } else {
          ParseMatchArmStmtAcc {
            remaining: acc.remaining,
            acc_nodes: acc.acc_nodes,
            acc_diags: acc.acc_diags,
            done: true,
            prov: acc.prov,
            table: table1
          }
        }
    }
  }
}

fn parse_match_arm_stmt_body(
  all_tokens: List<Token>,
  tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  if parse_looks_like_match_arm_start(tokens: tokens) {
    ParseExprRejected { diagnostics: [], table: table }
  } else {
    let init = ParseMatchArmStmtAcc {
      remaining: tokens,
      acc_nodes: std.algebra.Empty,
      acc_diags: std.algebra.Empty,
      done: false,
      prov: prov,
      table: table
    }
    let result = parse_match_arm_stmt_step(all_tokens: all_tokens, root: root, acc: init)
    if is_empty(xs: result.acc_nodes) {
      ParseExprRejected { diagnostics: [], table: result.table }
    } else {
      let ordered_nodes = list_reverse(xs: result.acc_nodes)
      let stamped = parse_stamp_match_arm_stmt_nodes(acc_nodes: ordered_nodes, prov: result.prov)
      ParseExprAccepted {
        remaining: result.remaining,
        captured: stamped.node,
        diagnostics: parse_flatten_diag_batches(batches: result.acc_diags.reverse()),
        prov: stamped.prov,
        table: result.table
      }
    }
  }
}

fn parse_nonterminal_memoized_core(
  all_tokens: List<Token>,
  tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prod_name: Symbol,
  prov: ParseProvenanceState
) -> ParseExprResult {
  let key = ParsePositionKey {
    position: parse_current_position(tokens: tokens),
    production: prod_name
  }
  match grammar_lookup_production_indexed(table: table, name: prod_name) {
    Violates { diagnostic: d } =>
      ParseExprRejected { diagnostics: [d], table: table }
    Holds { value: production } =>
      let table_at_lookup = parse_table_record_lookup_call(table: table)
      match parse_table_lookup(table: table_at_lookup, key: key) {
        Holds { value: inner } =>
          let table_hit = parse_table_record_hit(table: table_at_lookup)
          match inner {
            ParseMemoRejected { diagnostics: diags } =>
              ParseExprRejected { diagnostics: diags, table: table_hit }
            ParseMemoAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov } =>
              let merged_prov = parse_prov_merge(base: prov, incoming: inner_prov)
              let stamped = parse_wrap_production_captured(
                production: production,
                captured: captured,
                prov: merged_prov
              )
              ParseExprAccepted {
                remaining: remaining,
                captured: stamped.node,
                diagnostics: diags,
                prov: stamped.prov,
                table: table_hit
              }
          }
        Violates { diagnostic: _ } =>
          let table_miss = parse_table_record_miss(table: table_at_lookup)
          let inner = parse_expr(
            expr: production.expression,
            tokens: tokens,
            all_tokens: all_tokens,
            root: root,
            table: table_miss,
            prov: prov
          )
          let table_after_memo = parse_table_insert(
            table: parse_expr_result_table(result: inner),
            key: key,
            value: parse_memo_entry_from_expr(result: inner)
          )
          match inner {
            ParseExprRejected { diagnostics: diags, table: _ } =>
              ParseExprRejected { diagnostics: diags, table: table_after_memo }
            ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov, table: _ } =>
              let stamped = parse_wrap_production_captured(
                production: production,
                captured: captured,
                prov: inner_prov
              )
              ParseExprAccepted {
                remaining: remaining,
                captured: stamped.node,
                diagnostics: diags,
                prov: stamped.prov,
                table: table_after_memo
              }
          }
      }
  }
}

fn set_symbol_insert(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {
  Set {
    member: fn(sym) { sym == item || s.member(sym) }
  }
}

fn expr_is_nullable_given_set(expr: GrammarExpr, nullable_set: Set<Symbol>) -> Bool {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_, _) { false },
      nonterminal: fn(name) { nullable_set.member(name) },
      sequence: fn(left_nullable, right_nullable) { left_nullable && right_nullable },
      choice: fn(left_nullable, right_nullable) { left_nullable || right_nullable },
      optional: fn(_) { true },
      repeat: fn(_) { true }
    }
  )
}

fn compute_nullable_step(ns: Set<Symbol>, p: GrammarProduction) -> Set<Symbol> {
  if expr_is_nullable_given_set(expr: p.expression, nullable_set: ns) {
    set_symbol_insert(s: ns, item: p.name)
  } else {
    ns
  }
}

// ONE ROUND of the nullable fixpoint: every production gets a chance to join the set given what
// the set already holds.
fn compute_nullable_round(root: GrammarRoot, ns: Set<Symbol>) -> Set<Symbol> {
  fold_list(
    xs: root.productions,
    empty: ns,
    cons: fn(acc, p) {
      compute_nullable_step(ns: acc, p: p)
    }
  )
}

// THE CONVERGENCE MEASURE. `Set` is a `PointwisePower` — a characteristic function — so two sets
// cannot be compared directly, and the fixpoint cannot stop by testing `next == previous`. It can
// stop on a MONOTONE MEASURE instead: `compute_nullable_step` only ever inserts, so the number of
// productions the set admits rises until the round adds nothing, and equal counts across a round
// mean equal sets. Counting over `root.productions` is exact here because that is the only
// population `compute_nullable_step` can insert from.
fn nullable_member_count(root: GrammarRoot, ns: Set<Symbol>) -> Int {
  fold_list(
    xs: root.productions,
    empty: 0,
    cons: fn(acc, p) {
      if ns.member(p.name) { acc + 1 } else { acc }
    }
  )
}

// ITERATE TO CONVERGENCE, BOUNDED BY THE SAME COUNT THE OLD SHAPE SPENT UNCONDITIONALLY.
//
// The previous form ran exactly `length(productions)` rounds every time — the outer fold ignored
// its element and existed only to repeat the inner one — because that many rounds is the standard
// worst-case bound for this fixpoint. It is a bound, not a cost: on the live `.dag` grammar the
// set stops growing at round 4 of 38, so 34 rounds recomputed an answer that could no longer
// change. `fuel` keeps that worst case exactly (never more), and the count check leaves as soon as
// a round adds nothing, so the RESULT is identical and only the redundant rounds are gone.
fn compute_nullable_fixpoint(
  root: GrammarRoot,
  ns: Set<Symbol>,
  seen_count: Int,
  fuel: Int
) -> Set<Symbol> {
  if fuel == 0 {
    ns
  } else {
    let next = compute_nullable_round(root: root, ns: ns)
    let next_count = nullable_member_count(root: root, ns: next)
    if next_count == seen_count {
      next
    } else {
      compute_nullable_fixpoint(root: root, ns: next, seen_count: next_count, fuel: fuel - 1)
    }
  }
}

fn compute_nullable_set(root: GrammarRoot) -> Set<Symbol> {
  compute_nullable_fixpoint(
    root: root,
    ns: Set { member: fn(_) { false } },
    seen_count: 0,
    fuel: length(xs: root.productions)
  )
}

type GrammarExprFirstFold {
  terminals: List<Symbol>
  nullable: Bool
}

type GrammarFirstAnalysis {
  nullable_set: Set<Symbol>
  first_rows: Map<Symbol, List<Symbol>>
}

fn grammar_empty_terminal_list() -> List<Symbol> {
  std.algebra.Empty
}

fn first_list_contains(xs: List<Symbol>, item: Symbol) -> Bool {
  contains(xs: xs, item: item, eq: fn(a, b) { a == b })
}

fn first_list_union(left: List<Symbol>, right: List<Symbol>) -> List<Symbol> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, sym) {
      if first_list_contains(xs: acc, item: sym) {
        acc
      } else {
        list_snoc_item(xs: acc, item: sym)
      }
    }
  )
}

fn first_list_intersect(left: List<Symbol>, right: List<Symbol>) -> List<Symbol> {
  filter(
    xs: left,
    predicate: fn(sym) { first_list_contains(xs: right, item: sym) }
  )
}

fn production_first_row_lookup(rows: Map<Symbol, List<Symbol>>, name: Symbol) -> List<Symbol> {
  match v2.std.collection.map_get(m: rows, key: name) {
    Accepted { value: Present { value: terminals }, diagnostics: _ } => terminals
    Accepted { value: Absent, diagnostics: _ } => grammar_empty_terminal_list()
    Rejected { diagnostics: _ } => grammar_empty_terminal_list()
  }
}

fn expr_first_fold_terminal(token_class: Symbol) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: Cons { head: token_class, tail: std.algebra.Empty },
    nullable: false
  }
}

fn expr_first_fold_nonterminal(
  name: Symbol,
  nullable_set: Set<Symbol>,
  first_rows: Map<Symbol, List<Symbol>>
) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: production_first_row_lookup(rows: first_rows, name: name),
    nullable: nullable_set.member(name)
  }
}

fn expr_first_fold_sequence(left: GrammarExprFirstFold, right: GrammarExprFirstFold) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: first_list_union(
      left: left.terminals,
      right: if left.nullable { right.terminals } else { grammar_empty_terminal_list() }
    ),
    nullable: left.nullable && right.nullable
  }
}

fn expr_first_fold_choice(left: GrammarExprFirstFold, right: GrammarExprFirstFold) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: first_list_union(left: left.terminals, right: right.terminals),
    nullable: left.nullable || right.nullable
  }
}

fn expr_first_fold_optional(element: GrammarExprFirstFold) -> GrammarExprFirstFold {
  GrammarExprFirstFold { terminals: element.terminals, nullable: true }
}

fn expr_first_fold_repeat(element: GrammarExprFirstFold) -> GrammarExprFirstFold {
  GrammarExprFirstFold { terminals: element.terminals, nullable: true }
}

fn expr_first_fold(
  expr: GrammarExpr,
  nullable_set: Set<Symbol>,
  first_rows: Map<Symbol, List<Symbol>>
) -> GrammarExprFirstFold {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, _) { expr_first_fold_terminal(token_class: token_class) },
      nonterminal: fn(name) {
        expr_first_fold_nonterminal(name: name, nullable_set: nullable_set, first_rows: first_rows)
      },
      sequence: expr_first_fold_sequence,
      choice: expr_first_fold_choice,
      optional: expr_first_fold_optional,
      repeat: expr_first_fold_repeat
    }
  )
}

fn compute_production_first_row_terminals(
  rows: Map<Symbol, List<Symbol>>,
  p: GrammarProduction,
  nullable_set: Set<Symbol>
) -> List<Symbol> {
  expr_first_fold(
    expr: p.expression,
    nullable_set: nullable_set,
    first_rows: rows
  ).terminals
}

fn compute_production_first_rows_round(
  root: GrammarRoot,
  nullable_set: Set<Symbol>,
  rows: Map<Symbol, List<Symbol>>
) -> Map<Symbol, List<Symbol>> {
  fold_list(
    xs: root.productions,
    empty: rows,
    cons: fn(acc, p) {
      map_insert(
        m: acc,
        key: p.name,
        value: compute_production_first_row_terminals(
          rows: acc,
          p: p,
          nullable_set: nullable_set
        )
      )
    }
  )
}

// The same monotone measure as the nullable fixpoint, one level down: a FIRST row only ever gains
// terminals (`first_list_union` inserts, never removes), so the total across all rows rises until
// a round adds nothing. Measured on the live `.dag` grammar this one needs MORE than four rounds —
// unlike nullable — which is why the stopping rule is a measured convergence rather than a
// constant anybody picked.
fn production_first_rows_total(root: GrammarRoot, rows: Map<Symbol, List<Symbol>>) -> Int {
  fold_list(
    xs: root.productions,
    empty: 0,
    cons: fn(acc, p) {
      acc + length(xs: production_first_row_lookup(rows: rows, name: p.name))
    }
  )
}

fn compute_production_first_rows_fixpoint(
  root: GrammarRoot,
  nullable_set: Set<Symbol>,
  rows: Map<Symbol, List<Symbol>>,
  seen_total: Int,
  fuel: Int
) -> Map<Symbol, List<Symbol>> {
  if fuel == 0 {
    rows
  } else {
    let next = compute_production_first_rows_round(root: root, nullable_set: nullable_set, rows: rows)
    let next_total = production_first_rows_total(root: root, rows: next)
    if next_total == seen_total {
      next
    } else {
      compute_production_first_rows_fixpoint(
        root: root,
        nullable_set: nullable_set,
        rows: next,
        seen_total: next_total,
        fuel: fuel - 1
      )
    }
  }
}

fn compute_production_first_rows(
  root: GrammarRoot,
  nullable_set: Set<Symbol>
) -> Map<Symbol, List<Symbol>> {
  compute_production_first_rows_fixpoint(
    root: root,
    nullable_set: nullable_set,
    rows: empty_map(),
    seen_total: 0,
    fuel: length(xs: root.productions)
  )
}

fn choice_branches_ambiguous(left: GrammarExprFirstFold, right: GrammarExprFirstFold) -> Bool {
  if left.nullable && right.nullable {
    true
  } else {
    !is_empty(xs: first_list_intersect(left: left.terminals, right: right.terminals))
  }
}

fn append_choice_ambiguity_row(
  acc: List<GrammarChoiceAmbiguityRow>,
  production: Symbol,
  left: GrammarExprFirstFold,
  right: GrammarExprFirstFold
) -> List<GrammarChoiceAmbiguityRow> {
  if choice_branches_ambiguous(left: left, right: right) {
    list_snoc_item(
      xs: acc,
      item: GrammarChoiceAmbiguityRow {
        production: production,
        left_first_terminals: left.terminals,
        right_first_terminals: right.terminals,
        overlap_terminals: first_list_intersect(left: left.terminals, right: right.terminals),
        both_nullable: left.nullable && right.nullable
      }
    )
  } else {
    acc
  }
}

fn collect_choice_ambiguities_in_expr(
  expr: GrammarExpr,
  production: Symbol,
  nullable_set: Set<Symbol>,
  first_rows: Map<Symbol, List<Symbol>>,
  acc: List<GrammarChoiceAmbiguityRow>
) -> List<GrammarChoiceAmbiguityRow> {
  match expr {
    Terminal { token_class: _, stamp: _ } => acc
    Nonterminal { production: _ } => acc
    Sequence { left: left, right: right } =>
      collect_choice_ambiguities_in_expr(
        expr: right,
        production: production,
        nullable_set: nullable_set,
        first_rows: first_rows,
        acc: collect_choice_ambiguities_in_expr(
          expr: left,
          production: production,
          nullable_set: nullable_set,
          first_rows: first_rows,
          acc: acc
        )
      )
    Choice { left: left, right: right } => {
      let left_first = expr_first_fold(expr: left, nullable_set: nullable_set, first_rows: first_rows)
      let right_first = expr_first_fold(expr: right, nullable_set: nullable_set, first_rows: first_rows)
      let acc1 = append_choice_ambiguity_row(
        acc: acc,
        production: production,
        left: left_first,
        right: right_first
      )
      collect_choice_ambiguities_in_expr(
        expr: right,
        production: production,
        nullable_set: nullable_set,
        first_rows: first_rows,
        acc: collect_choice_ambiguities_in_expr(
          expr: left,
          production: production,
          nullable_set: nullable_set,
          first_rows: first_rows,
          acc: acc1
        )
      )
    }
    Optional { element: element } =>
      collect_choice_ambiguities_in_expr(
        expr: element,
        production: production,
        nullable_set: nullable_set,
        first_rows: first_rows,
        acc: acc
      )
    Repeat { element: element } =>
      collect_choice_ambiguities_in_expr(
        expr: element,
        production: production,
        nullable_set: nullable_set,
        first_rows: first_rows,
        acc: acc
      )
  }
}

fn compute_grammar_first_analysis_given(
  root: GrammarRoot,
  nullable_set: Set<Symbol>
) -> GrammarFirstAnalysis {
  GrammarFirstAnalysis {
    nullable_set: nullable_set,
    first_rows: compute_production_first_rows(root: root, nullable_set: nullable_set)
  }
}

fn compute_grammar_first_analysis(root: GrammarRoot) -> GrammarFirstAnalysis {
  compute_grammar_first_analysis_given(root: root, nullable_set: compute_nullable_set(root: root))
}

fn grammar_choice_ambiguity_roster_from_analysis(
  root: GrammarRoot,
  analysis: GrammarFirstAnalysis
) -> List<GrammarChoiceAmbiguityRow> {
  fold_list(
    xs: root.productions,
    empty: std.algebra.Empty,
    cons: fn(acc, p) {
      collect_choice_ambiguities_in_expr(
        expr: p.expression,
        production: p.name,
        nullable_set: analysis.nullable_set,
        first_rows: analysis.first_rows,
        acc: acc
      )
    }
  )
}

fn grammar_choice_ambiguity_roster(root: GrammarRoot) -> List<GrammarChoiceAmbiguityRow> {
  grammar_choice_ambiguity_roster_from_analysis(
    root: root,
    analysis: compute_grammar_first_analysis(root: root)
  )
}

fn grammar_has_choice_ambiguity(root: GrammarRoot) -> Bool {
  !is_empty(xs: grammar_choice_ambiguity_roster(root: root))
}

fn grammar_choice_ambiguity_count(root: GrammarRoot) -> Int {
  length(xs: grammar_choice_ambiguity_roster(root: root))
}

fn parse_grammar_choice_ambiguity_diagnostic(at: Locus, count: Int) -> Diagnostic {
  Diagnostic {
    reason: ^parse_grammar_choice_ambiguity,
    at: at,
    correction: match count > 0 {
      true => Unavailable { reason: ExternalContractUnknown }
      false => Unavailable { reason: UserInputBoundary }
    }
  }
}

fn parse_grammar_choice_ambiguity_row_diagnostic(at: Locus, row: GrammarChoiceAmbiguityRow) -> Diagnostic {
  let overlap_count = length(xs: row.overlap_terminals)
  parse_grammar_choice_ambiguity_diagnostic(
    at: at,
    count: if row.both_nullable && overlap_count == 0 { 1 } else { overlap_count }
  )
}

fn grammar_choice_ambiguity_row_diagnostic_list(
  at: Locus,
  roster: List<GrammarChoiceAmbiguityRow>
) -> List<Diagnostic> {
  fold_list(
    xs: roster,
    empty: std.algebra.Empty,
    cons: fn(acc, row) {
      list_snoc_item(
        xs: acc,
        item: parse_grammar_choice_ambiguity_row_diagnostic(at: at, row: row)
      )
    }
  )
}

fn grammar_choice_ambiguity_rejection_diagnostics(
  at: Locus,
  roster: List<GrammarChoiceAmbiguityRow>
) -> NonEmptyDiagnostics {
  parse_diags_to_non_empty(
    diags: grammar_choice_ambiguity_row_diagnostic_list(at: at, roster: roster),
    default: parse_grammar_choice_ambiguity_diagnostic(
      at: at,
      count: length(xs: roster)
    )
  )
}

fn grammar_empty_corner_list() -> List<Symbol> {
  std.algebra.Empty
}

fn expr_corner_fold_terminal(_: Symbol) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: std.algebra.Empty, nullable: false }
}

fn expr_corner_fold_nonterminal(name: Symbol, nullable_set: Set<Symbol>) -> GrammarExprCornerFold {
  GrammarExprCornerFold {
    corners: Cons { head: name, tail: std.algebra.Empty },
    nullable: nullable_set.member(name)
  }
}

fn expr_corner_fold_sequence(
  left_fold: GrammarExprCornerFold,
  right_fold: GrammarExprCornerFold
) -> GrammarExprCornerFold {

  GrammarExprCornerFold {
    corners: list_append(
      left: left_fold.corners,
      right: if left_fold.nullable {
        right_fold.corners
      } else {
        grammar_empty_corner_list()
      }
    ),
    nullable: left_fold.nullable && right_fold.nullable
  }
}

fn expr_corner_fold_choice(
  left_fold: GrammarExprCornerFold,
  right_fold: GrammarExprCornerFold
) -> GrammarExprCornerFold {
  GrammarExprCornerFold {
    corners: list_append(left: left_fold.corners, right: right_fold.corners),
    nullable: left_fold.nullable || right_fold.nullable
  }
}

fn expr_corner_fold_optional(element_fold: GrammarExprCornerFold) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: element_fold.corners, nullable: true }
}

fn expr_corner_fold_repeat(element_fold: GrammarExprCornerFold) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: element_fold.corners, nullable: true }
}

fn expr_corner_nullable_fold(expr: GrammarExpr, nullable_set: Set<Symbol>) -> GrammarExprCornerFold {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, _) { expr_corner_fold_terminal(token_class) },
      nonterminal: fn(name) { expr_corner_fold_nonterminal(name: name, nullable_set: nullable_set) },
      sequence: expr_corner_fold_sequence,
      choice: expr_corner_fold_choice,
      optional: expr_corner_fold_optional,
      repeat: expr_corner_fold_repeat
    }
  )
}

fn expr_direct_left_corner_list(expr: GrammarExpr, nullable_set: Set<Symbol>) -> List<Symbol> {
  expr_corner_nullable_fold(expr: expr, nullable_set: nullable_set).corners
}

fn left_corner_list_union(left: List<Symbol>, right: List<Symbol>) -> List<Symbol> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, name) {
      if contains(xs: acc, item: name, eq: fn(a, b) { a == b }) {
        acc
      } else {
        list_snoc_item(xs: acc, item: name)
      }
    }
  )
}

// ONE RELATION, NOT ONE CLOSURE PER PRODUCTION.
//
// Left recursion asks, of every production, whether it is reachable from itself through left
// corners. That is ONE reachability relation over the grammar, and every production's answer is a
// lookup in it. The previous form asked the question 38 separate times on the live `.dag` grammar
// — a complete transitive closure rebuilt from scratch per production, each running a fixed number
// of rounds with no convergence check, and each step re-finding a production by filtering the whole
// list. Measured, that was 7272ms of an 11.7s grammar preparation, and the preparation runs on
// every parse.
//
// The rows below are seeded with each production's DIRECT left corners and then expanded to their
// fixpoint. The result per production is the same set the per-production closure produced — the
// transitive closure of the same edge relation — so this is the identical question asked once.
fn left_corner_direct_rows(root: GrammarRoot, nullable_set: Set<Symbol>) -> Map<Symbol, List<Symbol>> {
  fold_list(
    xs: root.productions,
    empty: empty_map(),
    cons: fn(acc, p) {
      map_insert(
        m: acc,
        key: p.name,
        value: expr_direct_left_corner_list(expr: p.expression, nullable_set: nullable_set)
      )
    }
  )
}

fn left_corner_row(rows: Map<Symbol, List<Symbol>>, name: Symbol) -> List<Symbol> {
  match v2.std.collection.map_get(m: rows, key: name) {
    Accepted { value: Present { value: reached }, diagnostics: _ } => reached
    Accepted { value: Absent, diagnostics: _ } => std.algebra.Empty
    Rejected { diagnostics: _ } => std.algebra.Empty
  }
}

fn left_corner_expand_row(
  rows: Map<Symbol, List<Symbol>>,
  reached: List<Symbol>
) -> List<Symbol> {
  fold_list(
    xs: reached,
    empty: reached,
    cons: fn(acc, sym) {
      left_corner_list_union(left: acc, right: left_corner_row(rows: rows, name: sym))
    }
  )
}

fn left_corner_round(
  root: GrammarRoot,
  rows: Map<Symbol, List<Symbol>>
) -> Map<Symbol, List<Symbol>> {
  fold_list(
    xs: root.productions,
    empty: rows,
    cons: fn(acc, p) {
      map_insert(
        m: acc,
        key: p.name,
        value: left_corner_expand_row(rows: acc, reached: left_corner_row(rows: acc, name: p.name))
      )
    }
  )
}

fn left_corner_total(root: GrammarRoot, rows: Map<Symbol, List<Symbol>>) -> Int {
  fold_list(
    xs: root.productions,
    empty: 0,
    cons: fn(acc, p) {
      acc + length(xs: left_corner_row(rows: rows, name: p.name))
    }
  )
}

fn left_corner_fixpoint(
  root: GrammarRoot,
  rows: Map<Symbol, List<Symbol>>,
  seen_total: Int,
  fuel: Int
) -> Map<Symbol, List<Symbol>> {
  if fuel == 0 {
    rows
  } else {
    let next = left_corner_round(root: root, rows: rows)
    let next_total = left_corner_total(root: root, rows: next)
    if next_total == seen_total {
      next
    } else {
      left_corner_fixpoint(root: root, rows: next, seen_total: next_total, fuel: fuel - 1)
    }
  }
}

fn left_corner_rows(root: GrammarRoot, nullable_set: Set<Symbol>) -> Map<Symbol, List<Symbol>> {
  let seeded = left_corner_direct_rows(root: root, nullable_set: nullable_set)
  left_corner_fixpoint(
    root: root,
    rows: seeded,
    seen_total: left_corner_total(root: root, rows: seeded),
    fuel: length(xs: root.productions)
  )
}

// The nullable set is a parameter here because `grammar_validate_and_analyze` already computes it
// for the FIRST analysis: the previous shape recomputed it inside this check, so one preparation
// paid for the same fixpoint three times over.
fn grammar_has_left_recursion_given(root: GrammarRoot, nullable_set: Set<Symbol>) -> Bool {
  let rows = left_corner_rows(root: root, nullable_set: nullable_set)
  any(
    xs: root.productions,
    predicate: fn(p) {
      contains(
        xs: left_corner_row(rows: rows, name: p.name),
        item: p.name,
        eq: fn(a, b) { a == b }
      )
    }
  )
}

fn grammar_has_left_recursion(root: GrammarRoot) -> Bool {
  grammar_has_left_recursion_given(root: root, nullable_set: compute_nullable_set(root: root))
}

fn expr_has_undefined_nonterminal(expr: GrammarExpr, root: GrammarRoot) -> Bool {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_, _) { false },
      nonterminal: fn(p) {
        match grammar_lookup_production(root: root, name: p) {
          Violates { diagnostic: _ } => true
          Holds { value: _ } => false
        }
      },
      sequence: fn(left_undef, right_undef) { left_undef || right_undef },
      choice: fn(left_undef, right_undef) { left_undef || right_undef },
      optional: fn(element_undef) { element_undef },
      repeat: fn(element_undef) { element_undef }
    }
  )
}

fn grammar_has_undefined_nonterminals(root: GrammarRoot) -> Bool {
  match grammar_lookup_production(root: root, name: root.start) {
    Violates { diagnostic: _ } => true
    Holds { value: _ } =>
      any(
        xs: root.productions,
        predicate: fn(p) { expr_has_undefined_nonterminal(expr: p.expression, root: root) }
      )
  }
}

fn grammar_has_duplicate_productions(root: GrammarRoot) -> Bool {
  match unique(xs: root.productions, eq: fn(a, b) { a.name == b.name }) {
    true => false
    false => true
  }
}

fn parse_diag_cons(d: Diagnostic, acc: Diagnostics) -> Diagnostics {
  match acc {
    None => Some { diagnostics: NonEmptyDiagnostics { head: d, tail: [] } }
    Some { diagnostics: ned } =>
      Some {
        diagnostics: NonEmptyDiagnostics {
          head: d,
          tail: list_append(left: [ned.head], right: ned.tail)
        }
      }
  }
}

fn parse_diags_to_diagnostics(diags: List<Diagnostic>) -> Diagnostics {
  fold_list_right(xs: diags, empty: v2.std.diagnostic.None, snoc: fn(acc, d) { parse_diag_cons(d: d, acc: acc) })
}

fn parse_diags_to_non_empty(diags: List<Diagnostic>, default: Diagnostic) -> NonEmptyDiagnostics {
  match parse_diags_to_diagnostics(diags: diags) {
    None => NonEmptyDiagnostics { head: default, tail: [] }
    Some { diagnostics: ned } => ned
  }
}

fn grammar_nullable_ambiguity_rows(roster: List<GrammarChoiceAmbiguityRow>) -> List<GrammarChoiceAmbiguityRow> {
  filter(xs: roster, predicate: fn(row) { row.both_nullable })
}

fn parse_grammar_choice_overlap_residue_diagnostic(at: Locus, row: GrammarChoiceAmbiguityRow) -> Diagnostic {
  parse_stage_diagnostic_core(
    d: parse_overlap_residue_stage_diagnostic_at(at: at, row: row)
  )
}

fn diagnostics_from_diagnostic_list(items: List<Diagnostic>) -> Diagnostics {
  match list_at_optional(xs: items, index: 0) {
    Absent => None
    Present { value: first } =>
      match list_tail(xs: items) {
        TailAbsent => Some { diagnostics: NonEmptyDiagnostics { head: first, tail: std.algebra.Empty } }
        TailFound { tail: rest } =>
          Some { diagnostics: NonEmptyDiagnostics { head: first, tail: rest } }
      }
  }
}

fn grammar_overlap_residue_diagnostics(at: Locus, roster: List<GrammarChoiceAmbiguityRow>) -> Diagnostics {
  diagnostics_from_diagnostic_list(
    items: fold_list(
      xs: roster,
      empty: std.algebra.Empty,
      cons: fn(acc, row) {
        list_snoc_item(xs: acc, item: parse_grammar_choice_overlap_residue_diagnostic(at: at, row: row))
      }
    )
  )
}

// ONE nullable fixpoint for the whole preparation. The left-recursion check and the FIRST analysis
// both need the nullable set, and computing it here rather than inside each of them is the
// difference between one fixpoint per preparation and three.
fn grammar_validate_and_analyze(root: GrammarRoot, at: Locus) -> Outcome<PreparedModeledGrammar> {
  if grammar_has_undefined_nonterminals(root: root) {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_undefined_nonterminal_diagnostic(at: at)) }
  } else {
    if grammar_has_duplicate_productions(root: root) {
      Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_duplicate_production_diagnostic(at: at)) }
    } else {
      let nullable_set = compute_nullable_set(root: root)
      if grammar_has_left_recursion_given(root: root, nullable_set: nullable_set) {
        Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_left_recursive_diagnostic(at: at)) }
      } else {
        let analysis = compute_grammar_first_analysis_given(root: root, nullable_set: nullable_set)
        let ambiguity_roster = grammar_choice_ambiguity_roster_from_analysis(root: root, analysis: analysis)
        let nullable_rows = grammar_nullable_ambiguity_rows(roster: ambiguity_roster)
        if !is_empty(xs: nullable_rows) {
          Rejected {
            diagnostics: grammar_choice_ambiguity_rejection_diagnostics(at: at, roster: nullable_rows)
          }
        } else {
          Accepted {
            value: PreparedModeledGrammar {
              validated: ValidatedGrammarRoot { root: root },
              analysis: analysis,
              overlap_residue_stage: non_empty_parse_stage_diagnostics_from_overlap_roster(
                at: at,
                roster: ambiguity_roster
              )
            },
            diagnostics: grammar_overlap_residue_diagnostics(at: at, roster: ambiguity_roster)
          }
        }
      }
    }
  }
}

fn grammar_validate_for_parse(root: GrammarRoot, at: Locus) -> Outcome<ValidatedGrammarRoot> {
  match grammar_validate_and_analyze(root: root, at: at) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: modeled, diagnostics: residue } =>
      Accepted { value: modeled.validated, diagnostics: residue }
  }
}

fn parse_sync_step(acc: ParseSyncState, tok: Token, sync_tokens: List<Symbol>) -> ParseSyncState {
  match acc.found_sync {
    true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: acc.result, item: tok) }
    false =>
      match contains(xs: sync_tokens, item: tok.class, eq: fn(a, b) { a == b }) {
        true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: std.algebra.Empty, item: tok) }
        false => ParseSyncState { found_sync: false, result: std.algebra.Empty }
      }
  }
}

fn parse_skip_to_sync(tokens: List<Token>, sync_tokens: List<Symbol>) -> ParseSyncState {
  fold_list(
    xs: tokens,
    empty: ParseSyncState { found_sync: false, result: std.algebra.Empty },
    cons: fn(acc, tok) { parse_sync_step(acc: acc, tok: tok, sync_tokens: sync_tokens) }
  )
}

fn parse_token_first(tokens: List<Token>) -> Optional<Token> {
  match list_head(xs: tokens) {
    HeadFound { value: v } => Present { value: v }
    HeadAbsent => Absent
  }
}

fn parse_token_second(tokens: List<Token>) -> Optional<Token> {
  match list_tail(xs: tokens) {
    TailFound { tail: rest } => parse_token_first(tokens: rest)
    TailAbsent => Absent
  }
}

fn parse_token_at_optional(tokens: List<Token>, index: Int) -> Optional<Token> {
  parse_token_first(tokens: parse_tokens_drop(tokens: tokens, count: index))
}


fn parse_expr_terminal(
  token_class: Symbol,
  stamp: TerminalStampMode,
  tokens: List<Token>,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_token_first(tokens: tokens) {
    Absent => ParseExprRejected { diagnostics: [], table: table }
    Present { value: tok } =>
      match tok.class == token_class {
        true =>
          match list_tail(xs: tokens) {
            TailFound { tail: remaining } =>
              if token_class == ^dag_token_int_literal {
                let minted = parse_mint_from_source(
                  prov: prov,
                  file: tok.file,
                  start: tok.start,
                  end: tok.end
                )
                // THE WRAP IS LOAD-BEARING. minted.id is a raw OccurrenceId; Node.occurrence_id
                // is the NodeOccurrenceId coproduct, so the mint has to be lifted into
                // MintedOccurrence before it can inhabit a Node. #8833 removed this call reading
                // it as a spurious wrap against a callee that declared the raw type -- but the
                // callee's declaration was the defect, and dropping the wrap put a value outside
                // the coproduct into every int-literal node the parser built.
                match dag_int_literal_node_from_lexeme(
                  lexeme: tok.lexeme,
                  occurrence_id: node_occurrence_minted(id: minted.id)
                ) {
                  Accepted { value: captured, diagnostics: _ } =>
                    ParseExprAccepted {
                      remaining: remaining,
                      captured: captured,
                      diagnostics: std.algebra.Empty,
                      prov: minted.prov,
                      table: table
                    }
                  Rejected { diagnostics: d } =>
                    ParseExprRejected {
                      diagnostics: parse_non_empty_diagnostics_to_list(ned: d),
                      table: table
                    }
                }
              } else {
                let stamped = parse_stamp_terminal(tok: tok, stamp: stamp, prov: prov)
                ParseExprAccepted {
                  remaining: remaining,
                  captured: stamped.node,
                  diagnostics: [],
                  prov: stamped.prov,
                  table: table
                }
              }
            TailAbsent => ParseExprRejected { diagnostics: [], table: table }
          }
        false => ParseExprRejected { diagnostics: [], table: table }
      }
  }
}

fn parse_expr_sequence(
  left: GrammarExpr,
  right: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(
    expr: left,
    tokens: tokens,
    all_tokens: all_tokens,
    root: root,
    table: table,
    prov: prov
  ) {
    ParseExprRejected { diagnostics: diags, table: table1 } =>
      ParseExprRejected { diagnostics: diags, table: table1 }
    ParseExprAccepted { remaining: rest1, captured: cap1, diagnostics: diags1, prov: prov1, table: table1 } =>
      match parse_expr_with_first(
        expr: right,
        tokens: rest1,
        all_tokens: all_tokens,
        root: root,
        table: table1,
        prov: prov1
      ) {
        ParseExprRejected { diagnostics: diags2, table: table2 } =>
          ParseExprRejected { diagnostics: list_append(left: diags1, right: diags2), table: table2 }
        ParseExprAccepted { remaining: rest2, captured: cap2, diagnostics: diags2, prov: prov2, table: table2 } =>
          let stamped = parse_stamp_derived_conj(cap1: cap1, cap2: cap2, prov: prov2)
          ParseExprAccepted {
            remaining: rest2,
            captured: stamped.node,
            diagnostics: list_append(left: diags1, right: diags2),
            prov: stamped.prov,
            table: table2
          }
      }
  }
}

fn parse_choice_residue_backtrack(
  left: GrammarExpr,
  right: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(
    expr: left,
    tokens: tokens,
    all_tokens: all_tokens,
    root: root,
    table: table,
    prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 } =>
      ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 }
    ParseExprRejected { diagnostics: _, table: table1 } =>
      parse_expr_with_first(
        expr: right,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table1,
        prov: prov
      )
  }
}

fn parse_choice_on_present_token(
  left: GrammarExpr,
  right: GrammarExpr,
  tok: Token,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState,
  left_first: GrammarExprFirstFold,
  right_first: GrammarExprFirstFold
) -> ParseExprResult {
  if first_list_contains(xs: left_first.terminals, item: tok.class) && !first_list_contains(xs: right_first.terminals, item: tok.class) {
    parse_expr_with_first(expr: left, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
  } else {
    if first_list_contains(xs: right_first.terminals, item: tok.class) && !first_list_contains(xs: left_first.terminals, item: tok.class) {
      parse_expr_with_first(expr: right, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
    } else {
      if left_first.nullable && first_list_contains(xs: right_first.terminals, item: tok.class) {
        parse_expr_with_first(expr: right, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
      } else {
        parse_choice_residue_backtrack(
          left: left,
          right: right,
          tokens: tokens,
          all_tokens: all_tokens,
          root: root,
          table: table,
          prov: prov
        )
      }
    }
  }
}

fn parse_choice_first_dispatch(
  left: GrammarExpr,
  right: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  let left_first = expr_first_fold(expr: left, nullable_set: table.nullable_set, first_rows: table.first_rows)
  let right_first = expr_first_fold(expr: right, nullable_set: table.nullable_set, first_rows: table.first_rows)
  if choice_branches_ambiguous(left: left_first, right: right_first) {
    parse_choice_residue_backtrack(
      left: left,
      right: right,
      tokens: tokens,
      all_tokens: all_tokens,
      root: root,
      table: table,
      prov: prov
    )
  } else {
    match parse_token_first(tokens: tokens) {
      Absent =>
        if left_first.nullable {
          parse_expr_with_first(expr: left, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
        } else if right_first.nullable {
          parse_expr_with_first(expr: right, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
        } else {
          ParseExprRejected { diagnostics: [], table: table }
        }
      Present { value: tok } =>
        parse_choice_on_present_token(
          left: left,
          right: right,
          tok: tok,
          tokens: tokens,
          all_tokens: all_tokens,
          root: root,
          table: table,
          prov: prov,
          left_first: left_first,
          right_first: right_first
        )
    }
  }
}

fn parse_expr_optional(
  element: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(
    expr: element,
    tokens: tokens,
    all_tokens: all_tokens,
    root: root,
    table: table,
    prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 } =>
      ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 }
    ParseExprRejected { diagnostics: _, table: table1 } =>
      ParseExprAccepted {
        remaining: tokens,
        captured: grammar_empty_node(),
        diagnostics: [],
        prov: prov,
        table: table1
      }
  }
}

fn parse_expr_repeat_step(
  element: GrammarExpr,
  all_tokens: List<Token>,
  root: GrammarRoot,
  acc: ParseRepeatAcc
) -> ParseRepeatAcc {
  if acc.done {
    acc
  } else {
    match parse_expr_with_first(
      expr: element,
      tokens: acc.remaining,
      all_tokens: all_tokens,
      root: root,
      table: acc.table,
      prov: acc.prov
    ) {
      ParseExprRejected { diagnostics: _, table: table1 } =>
        ParseRepeatAcc {
          remaining: acc.remaining,
          acc_nodes: acc.acc_nodes,
          acc_diags: acc.acc_diags,
          done: true,
          prov: acc.prov,
          table: table1
        }
      ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 } =>
        match length(xs: rest) != length(xs: acc.remaining) {
          true =>
            parse_expr_repeat_step(
              element: element,
              all_tokens: all_tokens,
              root: root,
              acc: ParseRepeatAcc {
                remaining: rest,
                acc_nodes: Cons { head: cap, tail: acc.acc_nodes },
                acc_diags: Cons { head: diags, tail: acc.acc_diags },
                done: false,
                prov: prov1,
                table: table1
              }
            )
          false =>
            ParseRepeatAcc {
              remaining: acc.remaining,
              acc_nodes: acc.acc_nodes,
              acc_diags: acc.acc_diags,
              done: true,
              prov: acc.prov,
              table: table1
            }
        }
    }
  }
}

fn parse_expr_repeat(
  element: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  let init = ParseRepeatAcc {
    remaining: tokens,
    acc_nodes: std.algebra.Empty,
    acc_diags: std.algebra.Empty,
    done: false,
    prov: prov,
    table: table
  }
  let result = parse_expr_repeat_step(element: element, all_tokens: all_tokens, root: root, acc: init)
  let stamped = parse_stamp_derived_repeat(acc_nodes: list_reverse(xs: result.acc_nodes), prov: result.prov)
  ParseExprAccepted {
    remaining: result.remaining,
    captured: stamped.node,
    diagnostics: parse_flatten_diag_batches(batches: result.acc_diags.reverse()),
    prov: stamped.prov,
    table: result.table
  }
}

fn parse_expr_with_first(
  expr: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match expr {
    Terminal { token_class: token_class, stamp: stamp } =>
      parse_expr_terminal(
        token_class: token_class,
        stamp: stamp,
        tokens: tokens,
        table: table,
        prov: prov
      )
    Nonterminal { production: prod_name } =>
      parse_nonterminal_memoized(
        all_tokens: all_tokens,
        tokens: tokens,
        root: root,
        table: table,
        prod_name: prod_name,
        prov: prov
      )
    Sequence { left: left, right: right } =>
      parse_expr_sequence(
        left: left,
        right: right,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    Choice { left: left, right: right } =>
      parse_choice_first_dispatch(
        left: left,
        right: right,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    Optional { element: element } =>
      parse_expr_optional(
        element: element,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    Repeat { element: element } =>
      parse_expr_repeat(
        element: element,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
  }
}

fn parse_expr(
  expr: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  parse_expr_with_first(
    expr: expr,
    tokens: tokens,
    all_tokens: all_tokens,
    root: root,
    table: table,
    prov: prov
  )
}

fn parse_production_memo_stats(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol
) -> ParseMemoStats {
  let root = validated.root
  match grammar_lookup_production(root: root, name: production_name) {
    Violates { diagnostic: _ } =>
      ParseMemoStats { hits: 0, misses: 0, lookup_calls: 0 }
    Holds { value: production } =>
      let prov = parse_prov_initial()
      let table = parse_table_for_production(validated: validated, all_tokens: tokens)
      match parse_expr(
        expr: production.expression,
        tokens: tokens,
        all_tokens: tokens,
        root: root,
        table: table,
        prov: prov
      ) {
        ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: final_table } =>
          parse_table_memo_stats(table: final_table)
        ParseExprRejected { diagnostics: _, table: final_table } =>
          parse_table_memo_stats(table: final_table)
      }
  }
}

fn parse_production_prepared(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  analysis: GrammarFirstAnalysis,
  production_name: Symbol
) -> Outcome<ParseArtifact> {
  let root = validated.root
  let at = port_locus(port: ^parse_stage_locus_port)
  match grammar_lookup_production(root: root, name: production_name) {
    Holds { value: production } =>
      let prov = parse_prov_initial()
      let table = parse_table_for_production_analyzed(validated: validated, analysis: analysis, all_tokens: tokens)
      match parse_expr(
        expr: production.expression,
        tokens: tokens,
        all_tokens: tokens,
        root: root,
        table: table,
        prov: prov
      ) {
        ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov, table: _ } =>
          if is_empty(xs: remaining) {
            let stamped = parse_wrap_production_captured(
              production: production,
              captured: captured,
              prov: inner_prov
            )
            Accepted {
              value: ParseArtifact { tree: stamped.node, span_index: stamped.prov.index },
              diagnostics: parse_diags_to_diagnostics(diags: diags)
            }
          } else {
            Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
          }
        ParseExprRejected { diagnostics: diags, table: _ } =>
          Rejected {
            diagnostics: parse_diags_to_non_empty(
              diags: diags,
              default: parse_e1_syntax_error_diagnostic(at: at)
            )
          }
      }
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn parse_production(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol
) -> Outcome<ParseArtifact> {
  parse_production_prepared(
    tokens: tokens,
    validated: validated,
    analysis: compute_grammar_first_analysis(root: validated.root),
    production_name: production_name
  )
}

fn parse_production_tree(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol
) -> Outcome<ParseTree> {
  match parse_production(
    tokens: tokens,
    validated: validated,
    production_name: production_name
  ) {
    Accepted { value: artifact, diagnostics: d } =>
      Accepted { value: artifact.tree, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
fn prepare_grammar(grammar: ParseGrammar) -> Outcome<PreparedGrammar> {
  let at = port_locus(port: ^parse_stage_locus_port)
  let grammar_node = grammar_to_node(grammar: grammar)
  if well_formed(n: grammar_node) {
    match grammar {
      VoidGrammar =>
        Accepted { value: PreparedVoidGrammar, diagnostics: None }
      ModeledGrammar { root: root } =>
        match grammar_validate_and_analyze(root: root, at: at) {
          Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
          Accepted { value: modeled, diagnostics: validation_residue } =>
            Accepted {
              value: PreparedModeled { modeled: modeled },
              diagnostics: validation_residue
            }
        }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_not_well_formed_diagnostic(at: at)) }
  }
}

fn overlap_residue_stage_from_prepared(prepared: PreparedGrammar) -> Optional<NonEmptyParseStageDiagnostics> {
  match prepared {
    PreparedVoidGrammar => optional_absent()
    PreparedModeled { modeled: modeled } => modeled.overlap_residue_stage
  }
}

fn overlap_residue_stage_from_parse_grammar(grammar: ParseGrammar) -> Optional<NonEmptyParseStageDiagnostics> {
  match prepare_grammar(grammar: grammar) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: prepared, diagnostics: _ } =>
      overlap_residue_stage_from_prepared(prepared: prepared)
  }
}

fn parse_module_prepared(
  tokens: TokenStream,
  prepared: PreparedGrammar,
  validation_residue: Diagnostics
) -> Outcome<ParseArtifact> {
  let at = port_locus(port: ^parse_stage_locus_port)
  let ntok = token_stream_remaining_count(stream: tokens)
  match prepared {
    PreparedVoidGrammar =>
      if ntok == 0 {
        Accepted {
          value: ParseArtifact { tree: grammar_to_node(grammar: VoidGrammar), span_index: span_index_empty() },
          diagnostics: validation_residue
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
      }
    PreparedModeled { modeled: modeled } =>
      match parse_production_prepared(
        tokens: token_stream_remaining(stream: tokens),
        validated: modeled.validated,
        analysis: modeled.analysis,
        production_name: modeled.validated.root.start
      ) {
        Accepted { value: artifact, diagnostics: parse_diags } =>
          Accepted {
            value: artifact,
            diagnostics: diagnostics_merge(outer: validation_residue, inner: parse_diags)
          }
        Rejected { diagnostics: parse_rejected } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: validation_residue, rejected: parse_rejected)
          }
      }
  }
}

fn parse_module(tokens: TokenStream, grammar: ParseGrammar) -> Outcome<ParseArtifact> {
  match prepare_grammar(grammar: grammar) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: prepared, diagnostics: validation_residue } =>
      parse_module_prepared(tokens: tokens, prepared: prepared, validation_residue: validation_residue)
  }
}

fn parse(tokens: TokenStream, grammar: ParseGrammar) -> Outcome<ParseTree> {
  match parse_module(tokens: tokens, grammar: grammar) {
    Accepted { value: artifact, diagnostics: d } =>
      Accepted { value: artifact.tree, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
