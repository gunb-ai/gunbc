// FIND, DO NOT BUILD. This is called once per nonterminal reference at every parse step, and the
// previous form allocated a filtered copy of the whole production list to take its first element.
fn grammar_first_production_named(
  root: GrammarRoot,
  name: Symbol
) -> Optional<GrammarProduction> {
  fold_list(
    xs: root.productions,
    empty: Absent,
    cons: fn(acc, p) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match p.name == name {
            true => Present { value: p }
            false => Absent
          }
      }
    }
  )
}

fn grammar_lookup_production(root: GrammarRoot, name: Symbol) -> Witness<GrammarProduction> {
  match grammar_first_production_named(root: root, name: name) {
    Present { value: production } => Holds { value: production }
    Absent =>
      Violates {
        diagnostic: parse_grammar_undefined_nonterminal_diagnostic(
          at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^parse_grammar_undefined_nonterminal)
        )
      }
  }
}

// grammar_lookup_production is an O(P) filter scan over the full production list; it is the
// well-formedness/analysis authority, run once per grammar at prepare_grammar time (§6
// already-hoisted cost) and is correct to keep as the single-authority derivation of the index
// below. grammar_lookup_production_indexed is the per-dispatch consumer: every nonterminal
// reference during recursive-descent parsing calls it, memoized or not
// (parse_nonterminal_memoized looks the production up before consulting the memo table), so
// the P=204-production dag grammar turned this into the dominant cost of parsing even a trivial
// source under the tree-walking v1 interpreter (measured: ~12s to parse a 3-line source, PR #8478).
// productions_by_name is that lookup's index, built once by grammar_production_index and carried on
// ParseTable exactly like nullable_set/first_rows already are (parse_table_carry_analysis threads
// all three through every table mutation) — one Map<Symbol,GrammarProduction>, not a second
// production roster (§3). Every ParseTableRealization construction site
// (parse_table_for_production_analyzed, the real-parse path; parse_table_empty;
// parse_table_carry_analysis, the pass-through on every table mutation) populates this field, so
// the O(P)->O(1) change is not opt-in per call site. Measured effect (this host,
// dag/test/claim/long/dag_arrow_lambda_witness_test.dag witness_single_param_lambda_parses via
// `gunbc run --claim-run`, fix stashed vs applied around the identical whole-process invocation):
// 78.023s -> 74.006s wall. That delta undercounts the fix's effect on the specific fold it repairs,
// because the invocation's wall time is dominated by up-front module-load/typecheck of the full v2
// closure — a cost this change does not touch — rather than by the repeated per-dispatch grammar
// lookup inside the parse itself; the O(204)->O(1) asymptotic claim is the primary evidence
// (grammar_lookup_production is an unmemoized linear filter reached before every memo-table check,
// so even a memo HIT paid the full scan), not the crude wall-clock ratio. This is the class
// docs/plans/measurements/floor-slow-rows-2026-08-18.md records dag_arrow_lambda_witness_test's
// rows landing 1-4ms over its 1552ms ceiling for.

fn grammar_production_index(productions: List<GrammarProduction>) -> Map<Symbol, GrammarProduction> {
  fold_list(
    xs: productions,
    empty: empty_map(),
    cons: fn(acc, p) { map_insert(m: acc, key: p.name, value: p) }
  )
}

fn grammar_lookup_production_indexed(table: ParseTable, name: Symbol) -> Witness<GrammarProduction> {
  witness_from_optional(
    opt: map_lookup(m: table.productions_by_name, key: name),
    absent: parse_grammar_undefined_nonterminal_diagnostic(
      at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^parse_grammar_undefined_nonterminal)
    )
  )
}

fn parse_table_memo_miss_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^parse_table_memo_miss,
    at: port_refusal_locus(at: at, port: ^parse_stage_locus_port, invariant: ^parse_table_memo_miss),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn parse_table_entries_lookup(table: ParseTable, key: ParsePositionKey) -> Witness<ParseMemoEntry> {
  witness_from_optional(
    opt: table.entries.lookup(key),
    absent: parse_table_memo_miss_diagnostic(at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^parse_table_memo_miss))
  )
}

fn parse_table_lookup(table: ParseTable, key: ParsePositionKey) -> Witness<ParseMemoEntry> {
  match v2.compiler.materialization_carriers.materialization_allows_memo_store(m: table.materialization) {
    true => { parse_table_entries_lookup(table: table, key: key) }
    false => {
      Violates {
        diagnostic: parse_table_memo_store_refused_diagnostic(
          at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^parse_table_memo_store_refused)
        )
      }
    }
  }
}

fn parse_table_memo_store_refused_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^parse_table_memo_store_refused,
    at: port_refusal_locus(at: at, port: ^parse_stage_locus_port, invariant: ^parse_table_memo_store_refused),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn parse_table_memo_store_refused_reason(d: Diagnostic) -> Bool {
  match d {
    Diagnostic { reason: r, at: _, correction: _ } =>
      r == ^parse_table_memo_store_refused
  }
}

fn parse_table_memo_lookup_refuses_store(table: ParseTable, key: ParsePositionKey) -> Bool {
  match parse_table_lookup(table: table, key: key) {
    Violates { diagnostic: d } => parse_table_memo_store_refused_reason(d: d)
    Holds { value: _ } => false
  }
}

fn parse_table_memo_insert_refused(
  table: ParseTable,
  key: ParsePositionKey,
  value: ParseMemoEntry
) -> Bool {
  let after = parse_table_insert(table: table, key: key, value: value)
  match v2.std.collection.map_get(m: after.entries, key: key) {
    Accepted { value: Absent } => true
    Accepted { value: Present { value: _ } } => false
    Rejected { diagnostics: _ } => false
  }
}

fn parse_memo_entry_from_expr(result: ParseExprResult) -> ParseMemoEntry {
  match result {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diagnostics, prov: prov, table: _ } =>
      ParseMemoAccepted {
        remaining: remaining,
        captured: captured,
        diagnostics: diagnostics,
        prov: prov,
        furthest: parse_expr_result_table(result: result).furthest,
        refusal: parse_expr_result_table(result: result).refusal
      }
    ParseExprRejected { diagnostics: diagnostics, table: table } =>
      ParseMemoRejected { diagnostics: diagnostics, furthest: table.furthest, refusal: table.refusal }
  }
}

fn parse_expr_result_table(result: ParseExprResult) -> ParseTable {
  match result {
    ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: table } => table
    ParseExprRejected { diagnostics: _, table: table } => table
  }
}

fn parse_table_memo_stats(table: ParseTable) -> ParseMemoStats {
  ParseMemoStats {
    hits: table.memo_hits,
    misses: table.memo_misses,
    lookup_calls: table.memo_lookup_calls
  }
}

fn parse_memo_stats_empty() -> ParseMemoStats {
  ParseMemoStats { hits: 0, misses: 0, lookup_calls: 0 }
}

// THE PARSE'S OWN MEMO ACCOUNTING, CARRIED BESIDE ITS RESULT AND NOT INSIDE IT.
//
// WHY NOT A FIELD ON ParseArtifact, which is the shorter change. ParseArtifact answers WHAT was
// parsed; the memo counters answer HOW the parse was executed, which is a realization fact about
// one run and not a property of the tree. DESIGN section 3 keeps interface and realization as two
// facts, so putting a counter on the semantic artifact would make every consumer of a parse result
// carry a measurement it has no use for, and would make the artifact's identity depend on how many
// times a memo happened to be consulted.
//
// AND THE COUNTERS MUST SURVIVE A REFUSAL, which a field on the accepted value cannot do. The
// expensive case this instrument exists to read is a file that spends seconds in parse and THEN
// rejects; an Outcome's Rejected arm carries no ParseArtifact, so the stats would be lost exactly
// where they are most wanted. This carrier holds the outcome and the accounting side by side, so
// both arms report.
//
// THE UNMEASURED ENTRY POINT IS A PROJECTION OF THIS ONE, never a second parse: parse_module_prepared
// is `.outcome` of the measured fold, so there is one implementation and no caller pays a second
// parse to be measured.
type ParseProductionMeasured {
  outcome: Outcome<ParseArtifact>
  memo: ParseMemoStats
}

fn parse_table_carry_analysis(table: ParseTable, entries: Map<ParsePositionKey, ParseMemoEntry>, hits: Int, misses: Int, lookups: Int) -> ParseTable {
  ParseTableRealization {
    artifact_kind: table.artifact_kind,
    provider_id: table.provider_id,
    materialization: table.materialization,
    grammar_digest: table.grammar_digest,
    token_stream_digest: table.token_stream_digest,
    entries: entries,
    memo_hits: hits,
    memo_misses: misses,
    memo_lookup_calls: lookups,
    furthest: table.furthest,
    nullable_set: table.nullable_set,
    first_rows: table.first_rows,
    productions_by_name: table.productions_by_name,
    prepared_exprs: table.prepared_exprs,
    layout: table.layout,
    refusal: table.refusal
  }
}

// A MEMO ENTRY CARRIES ITS OWN SUBPARSE'S FURTHEST FAILURE, and a hit joins it back in. The
// seed serves entries across parses of one token stream (v1_interpreter
// parse_table_memo_scope_and_key), so a table-only record would lose the deep rejection inside a
// served subparse and the refusal's locus would depend on cache warmth. The miss path runs the
// subparse from the unit, stores what that subparse alone reached, then joins it with the caller's.
fn parse_expectation_first(left: Optional<ParseRefusalReason>, right: Optional<ParseRefusalReason>) -> Optional<ParseRefusalReason> {
  match left {
    Present { value: _ } => left
    Absent => right
  }
}

fn parse_furthest_join(left: ParseFurthestFailure, right: ParseFurthestFailure) -> ParseFurthestFailure {
  match left {
    FurthestNone => right
    FurthestAtEnd { expectation: le } =>
      match right {
        FurthestNone => left
        FurthestAtToken { token: _, expectation: _ } => left
        FurthestAtEnd { expectation: re } => FurthestAtEnd { expectation: parse_expectation_first(left: le, right: re) }
      }
    FurthestAtToken { token: lt, expectation: le } =>
      match right {
        FurthestNone => left
        FurthestAtEnd { expectation: _ } => right
        FurthestAtToken { token: rt, expectation: re } =>
          if rt.start > lt.start {
            right
          } else {
            if rt.start == lt.start {
              FurthestAtToken { token: lt, expectation: parse_expectation_first(left: le, right: re) }
            } else {
              left
            }
          }
      }
  }
}

fn parse_furthest_at(tokens: List<Token>) -> ParseFurthestFailure {
  match parse_token_first(tokens: tokens) {
    Present { value: tok } => FurthestAtToken { token: tok, expectation: Absent }
    Absent => FurthestAtEnd { expectation: Absent }
  }
}

fn parse_furthest_expected_at(tokens: List<Token>, reason: ParseRefusalReason) -> ParseFurthestFailure {
  match parse_token_first(tokens: tokens) {
    Present { value: tok } => FurthestAtToken { token: tok, expectation: Present { value: reason } }
    Absent => FurthestAtEnd { expectation: Present { value: reason } }
  }
}

fn parse_table_with_furthest(table: ParseTable, furthest: ParseFurthestFailure) -> ParseTable {
  ParseTableRealization {
    artifact_kind: table.artifact_kind,
    provider_id: table.provider_id,
    materialization: table.materialization,
    grammar_digest: table.grammar_digest,
    token_stream_digest: table.token_stream_digest,
    entries: table.entries,
    memo_hits: table.memo_hits,
    memo_misses: table.memo_misses,
    memo_lookup_calls: table.memo_lookup_calls,
    furthest: furthest,
    nullable_set: table.nullable_set,
    first_rows: table.first_rows,
    productions_by_name: table.productions_by_name,
    prepared_exprs: table.prepared_exprs,
    layout: table.layout,
    refusal: table.refusal
  }
}

fn parse_table_join_furthest(table: ParseTable, furthest: ParseFurthestFailure) -> ParseTable {
  parse_table_with_furthest(table: table, furthest: parse_furthest_join(left: table.furthest, right: furthest))
}

// THE FIRST REFUSAL STANDS. A table that already refused keeps its refusal; one that has not takes
// the incoming one (a memo hit replaying the refusal its subparse recorded).
fn parse_table_join_refusal(table: ParseTable, refusal: Optional<Diagnostic>) -> ParseTable {
  match table.refusal {
    Present { value: _ } => table
    Absent =>
      match refusal {
        Absent => table
        Present { value: d } => parse_table_with_refusal(table: table, refusal: d)
      }
  }
}

fn parse_table_with_refusal(table: ParseTable, refusal: Diagnostic) -> ParseTable {
  ParseTableRealization {
    artifact_kind: table.artifact_kind,
    provider_id: table.provider_id,
    materialization: table.materialization,
    grammar_digest: table.grammar_digest,
    token_stream_digest: table.token_stream_digest,
    entries: table.entries,
    memo_hits: table.memo_hits,
    memo_misses: table.memo_misses,
    memo_lookup_calls: table.memo_lookup_calls,
    furthest: table.furthest,
    nullable_set: table.nullable_set,
    first_rows: table.first_rows,
    productions_by_name: table.productions_by_name,
    prepared_exprs: table.prepared_exprs,
    layout: table.layout,
    refusal: optional_present(value: refusal)
  }
}

fn parse_table_record_lookup_call(table: ParseTable) -> ParseTable {
  parse_table_carry_analysis(
    table: table,
    entries: table.entries,
    hits: table.memo_hits,
    misses: table.memo_misses,
    lookups: table.memo_lookup_calls + 1
  )
}

fn parse_table_record_hit(table: ParseTable) -> ParseTable {
  parse_table_carry_analysis(
    table: table,
    entries: table.entries,
    hits: table.memo_hits + 1,
    misses: table.memo_misses,
    lookups: table.memo_lookup_calls
  )
}

fn parse_table_record_miss(table: ParseTable) -> ParseTable {
  parse_table_carry_analysis(
    table: table,
    entries: table.entries,
    hits: table.memo_hits,
    misses: table.memo_misses + 1,
    lookups: table.memo_lookup_calls
  )
}

fn parse_table_insert(table: ParseTable, key: ParsePositionKey, value: ParseMemoEntry) -> ParseTable {
  match v2.compiler.materialization_carriers.materialization_allows_memo_store(m: table.materialization) {
    true =>
      parse_table_carry_analysis(
        table: table,
        entries: map_insert(m: table.entries, key: key, value: value),
        hits: table.memo_hits,
        misses: table.memo_misses,
        lookups: table.memo_lookup_calls
      )
    false => table
  }
}

fn parse_grammar_digest(validated: ValidatedGrammarRoot) -> Hash {
  content_hash(
    n: grammar_to_node(grammar: ModeledGrammar { root: validated.root })
  )
}

// ONE DIGEST PER TOKEN FIELD, NOT ONE HASH STEP PER UNIT OF MAGNITUDE. The stream digest used to
// send both offsets and every lexeme codepoint through the single-byte-limb digest: unary in the
// value (a codepoint near 100 cost ~100 combine_hash calls), and one shared tag for every value
// above 255. On the native route that made the eager fill in parse_table_for_production_analyzed
// 28% of the process (perf --children, bounded K=16 root, 2026-09-14), and it made offsets past
// byte 255 and every non-Latin-1 codepoint collide in the seed interpreter's cross-parse memo key
// (v1_interpreter parse_table_memo_scope_and_key reads this field). Offsets and positions now go
// through the Int content authority and the lexeme through its interned symbol.
// The token digest, combined with the stream layout's own digest (folded once, in the layout walk,
// over the line-break-preceded tokens' starts and lines). Only a sourceless stream keys by the token
// digest alone.
fn parse_token_stream_layout_digest(all_tokens: List<Token>, layout: Optional<StreamLayout>) -> Hash {
  match layout {
    Absent => parse_token_stream_digest(all_tokens: all_tokens)
    Present { value: l } => combine_hash(a: parse_token_stream_digest(all_tokens: all_tokens), b: l.digest)
  }
}

fn parse_token_stream_digest(all_tokens: List<Token>) -> Hash {
  fold_list(
    xs: all_tokens,
    empty: symbol_identity_digest(sym: ^parse_token_stream_digest_nil),
    cons: fn(acc, tok) {
      combine_hash(
        a: acc,
        b: combine_hash(
          a: combine_hash(
            a: symbol_identity_digest(sym: tok.class),
            b: symbol_identity_digest(sym: tok.file)
          ),
          b: combine_hash(
            a: combine_hash(
              a: integer_int_content_digest(value: tok.start),
              b: integer_int_content_digest(value: tok.end)
            ),
            b: symbol_identity_digest(sym: symbol_intern_lexeme(lexeme: tok.lexeme))
          )
        )
      )
    }
  )
}

// THE MATERIALIZATION ARRIVES ADMITTED, it is not read here. This constructor runs once per
// production parse; the admission is a function of the ladder verdicts alone, so reading the
// door here would ask one question per table and give every caller its own place to mishandle
// a refusal. prepare_grammar asks once per grammar and refuses there, and what reaches here is
// a value that has already been admitted -- so this signature cannot express an unadmitted one.
fn parse_table_for_production_analyzed(
  validated: ValidatedGrammarRoot,
  analysis: GrammarFirstAnalysis,
  all_tokens: List<Token>,
  materialization: Materialization
) -> ParseTable {
  parse_table_for_stream_analyzed(
    validated: validated,
    analysis: analysis,
    all_tokens: all_tokens,
    layout: optional_absent(),
    materialization: materialization
  )
}

// The stream's layout rides on the table so a layout-conditioned production can ask its question at
// the point of use (v2.std.compilers.lexing token_stream_line_break_before), and its layout (the starts of
// the line-break-preceded tokens) is part of the
// stream's digest: two sources can lex to byte-identical tokens and differ only in layout, and a memo
// entry must never serve one's answer to the other.
fn parse_table_for_stream_analyzed(
  validated: ValidatedGrammarRoot,
  analysis: GrammarFirstAnalysis,
  all_tokens: List<Token>,
  layout: Optional<StreamLayout>,
  materialization: Materialization
) -> ParseTable {
  ParseTableRealization {
    artifact_kind: v2.compiler.materialization_carriers.parse_table_memo_artifact_kind(),
    provider_id: v2.compiler.materialization_carriers.parse_table_memo_provider_id(),
    materialization: materialization,
    grammar_digest: analysis.grammar_digest,
    token_stream_digest: parse_token_stream_layout_digest(all_tokens: all_tokens, layout: layout),
    entries: empty_map(),
    memo_hits: 0,
    memo_misses: 0,
    memo_lookup_calls: 0,
    furthest: FurthestNone,
    nullable_set: analysis.nullable_set,
    first_rows: analysis.first_rows,
    productions_by_name: analysis.productions_by_name,
    prepared_exprs: analysis.prepared_exprs,
    layout: layout,
    refusal: optional_absent()
  }
}

fn parse_table_for_production(
  validated: ValidatedGrammarRoot,
  all_tokens: List<Token>,
  materialization: Materialization
) -> ParseTable {
  parse_table_for_production_analyzed(
    validated: validated,
    analysis: compute_grammar_first_analysis(root: validated.root),
    all_tokens: all_tokens,
    materialization: materialization
  )
}

// The empty grammar has no productions, so its recurrence census would be zero on both counts
// and its demand case the ladder's single-demand arm. It is a test-only constructor with no
// analysis to carry, so the materialization is SUPPLIED at the boundary rather than derived here
// (DESIGN section 3's witness rule); the derived route is parse_table_for_production_analyzed.
fn parse_table_empty(materialization: Materialization) -> ParseTable {
  ParseTableRealization {
    artifact_kind: v2.compiler.materialization_carriers.parse_table_memo_artifact_kind(),
    provider_id: v2.compiler.materialization_carriers.parse_table_memo_provider_id(),
    materialization: materialization,
    grammar_digest: content_hash(n: grammar_empty_node()),
    token_stream_digest: symbol_identity_digest(sym: ^parse_table_empty_token_stream),
    entries: empty_map(),
    memo_hits: 0,
    memo_misses: 0,
    memo_lookup_calls: 0,
    furthest: FurthestNone,
    nullable_set: std.algebra.Empty,
    first_rows: empty_map(),
    productions_by_name: empty_map(),
    prepared_exprs: empty_map(),
    layout: optional_absent(),
    refusal: optional_absent()
  }
}

fn parse_table_subject(table: ParseTable, key: ParsePositionKey) -> Hash {
  combine_hash(
    a: combine_hash(a: table.grammar_digest, b: table.token_stream_digest),
    b: combine_hash(
      a: integer_int_content_digest(value: key.position),
      b: symbol_identity_digest(sym: key.production)
    )
  )
}

fn parse_current_position(tokens: List<Token>) -> Int {
  match list_head(xs: tokens) {
    HeadFound { value: t } => t.start + 1
    HeadAbsent => 0
  }
}

fn token_position_indices(tokens: List<Token>) -> List<Int> {
  match is_empty(xs: tokens) {
    true => Cons { head: 0, tail: std.algebra.Empty }
    false =>
      fold_list(
        xs: tokens,
        empty: Cons { head: 0, tail: std.algebra.Empty },
        cons: fn(acc, _) {
          list_snoc_item(xs: acc, item: length(xs: acc))
        }
      )
  }
}

fn parse_non_empty_diagnostics_to_list(ned: NonEmptyDiagnostics) -> List<Diagnostic> {
  list_append(left: [ned.head], right: ned.tail)
}

fn parse_prov_seeded(seed: OccurrenceIdAllocator) -> ParseProvenanceState {
  ParseProvenanceState {
    alloc: seed,
    index: span_index_empty(),
    frame: Empty
  }
}

fn parse_prov_initial() -> ParseProvenanceState {
  parse_prov_seeded(seed: occurrence_id_allocator_initial())
}

fn parse_prov_replay_frame(
  base: v2.std.provenance.SpanIndex,
  incoming: v2.std.provenance.SpanIndex,
  frame: List<ParseProvFrameItem>
) -> v2.std.provenance.SpanIndex {
  fold_list(
    xs: frame,
    empty: base,
    cons: fn(acc, item) {
      match item {
        FrameMinted { id: id } => span_index_adopt(base: acc, incoming: incoming, id: id)
        FrameNested { frame: inner } => parse_prov_replay_frame(base: acc, incoming: incoming, frame: inner)
      }
    }
  )
}

// A memo hit: `incoming` is the stored result of the memoized frame, whose `frame` is that
// frame's own record (the miss started it empty).
fn parse_prov_merge(
  base: ParseProvenanceState,
  incoming: ParseProvenanceState
) -> ParseProvenanceState {
  ParseProvenanceState {
    alloc: occurrence_id_allocator_advance_to(
      alloc: base.alloc,
      min_next: authored_token_ordinal_space_from_allocator(
        alloc: incoming.alloc
      )
    ),
    index: parse_prov_replay_frame(base: base.index, incoming: incoming.index, frame: incoming.frame),
    frame: list_snoc_item(xs: base.frame, item: FrameNested { frame: incoming.frame })
  }
}

// A memo miss: the production parses in a fresh frame so its memo entry records only its own ids.
fn parse_prov_enter_frame(prov: ParseProvenanceState) -> ParseProvenanceState {
  ParseProvenanceState { alloc: prov.alloc, index: prov.index, frame: Empty }
}

// Returning from a miss: the caller's frame gains the inner frame as one nested item.
fn parse_prov_leave_frame(outer: ParseProvenanceState, inner: ParseProvenanceState) -> ParseProvenanceState {
  ParseProvenanceState {
    alloc: inner.alloc,
    index: inner.index,
    frame: list_snoc_item(xs: outer.frame, item: FrameNested { frame: inner.frame })
  }
}

fn parse_mint_from_source(
  prov: ParseProvenanceState,
  file: Symbol,
  start: Int,
  end: Int
) -> ParseMintSourceResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let locus = Textual {
    file: file,
    extent: ByteRange { start: start, end: end }
  }
  let event = origin_event_from_source(locus: locus)
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseMintSourceResult {
    id: minted.id,
    prov: ParseProvenanceState {
      alloc: minted.alloc,
      index: index,
      frame: list_snoc_item(xs: prov.frame, item: FrameMinted { id: minted.id })
    }
  }
}

// A PROJECTED OCCURRENCE IS NOT A PARSE MINT, and this function's denominator is parse's own
// mints -- the ids parse_mint_from_source allocated and recorded in this run's SpanIndex. A
// projector-created occurrence carries a real id, but it was allocated by a projector against a
// scoped reference and parse recorded no span for it; returning it here would put an id into a
// list whose consumers read as "parse stamped this", which is the fabricated answer. Empty is the
// answer to a different question than OccurrenceSynthetic's -- nothing was minted at all there --
// and both are correctly empty for this one.
// Snoc-built, never append-per-node: list_append(acc, [id]) re-folds the accumulator per
// element (O(n^2) per captured repeat), list_snoc_item is the primitive push (O(log n)).
fn parse_minted_id_snoc(acc: List<OccurrenceId>, n: Node) -> List<OccurrenceId> {
  match n.occurrence_id {
    OccurrenceMinted { id: id } => list_snoc_item(xs: acc, item: id)
    OccurrenceSynthetic => acc
    OccurrenceProjected { id: _, caused_by: _ } => acc
    OccurrencePending { caused_by: _ } => acc
  }
}

fn parse_minted_id_list(nodes: List<Node>) -> List<OccurrenceId> {
  fold_list(
    xs: nodes,
    empty: std.algebra.Empty,
    cons: fn(acc, n) { parse_minted_id_snoc(acc: acc, n: n) }
  )
}

fn parse_stamp_terminal(
  tok: Token,
  stamp: TerminalStampMode,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = parse_mint_from_source(
    prov: prov,
    file: tok.file,
    start: tok.start,
    end: tok.end
  )
  let identity = match stamp {
    StampClass => tok.class
    StampBinding { binding: b } => b
    StampLexeme => symbol_intern_lexeme(lexeme: tok.lexeme)
  }
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Atom { identity: identity } },
      children: [],
      occurrence_id: node_occurrence_identity_minted(id: minted.id)
    ),
    prov: minted.prov
  }
}

fn parse_repeat_captured_node(acc_nodes: List<Node>, occurrence_id: NodeOccurrenceIdentity) -> Node {
  let spine = fold_list_right(
    xs: acc_nodes,
    empty: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: OccurrenceSynthetic
    },
    snoc: fn(tail_node, item) {
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          grammar_named_edge(name: ^grammar_sequence_left_node_projection, target: item),
          grammar_named_edge(name: ^grammar_sequence_right_node_projection, target: tail_node)
        ],
        occurrence_id: OccurrenceSynthetic
      }
    }
  )
  node_with_occurrence_id(
    kind: spine.kind,
    children: spine.children,
    occurrence_id: occurrence_id
  )
}

fn parse_stamp_derived_conj(
  cap1: Node,
  cap2: Node,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: [cap1, cap2])
  let event = DerivedBy { producer: ^parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Conj },
      children: [
        grammar_named_edge(name: ^grammar_sequence_left_node_projection, target: cap1),
        grammar_named_edge(name: ^grammar_sequence_right_node_projection, target: cap2)
      ],
      occurrence_id: node_occurrence_identity_minted(id: minted.id)
    ),
    prov: ParseProvenanceState {
      alloc: minted.alloc,
      index: index,
      frame: list_snoc_item(xs: prov.frame, item: FrameMinted { id: minted.id })
    }
  }
}

fn parse_stamp_derived_repeat(
  acc_nodes: List<Node>,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: acc_nodes)
  let event = DerivedBy { producer: ^parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: parse_repeat_captured_node(
      acc_nodes: acc_nodes,
      occurrence_id: node_occurrence_identity_minted(id: minted.id)
    ),
    prov: ParseProvenanceState {
      alloc: minted.alloc,
      index: index,
      frame: list_snoc_item(xs: prov.frame, item: FrameMinted { id: minted.id })
    }
  }
}

// THE PARSE TREE'S PROJECTION EDGES, AS A CLOSED ROSTER OWNED BY THEIR PRODUCER. A parse tree
// carries exactly four Named edges that are parse-projection structure rather than authored
// program data: the production identity and captured pair stamped by parse_wrap_production_captured,
// and the sequence left/right pair stamped by the sequence and list spines. Every later stage that
// must see through projection structure (namespace_graft, name_resolve, symbol_index_fill) asks
// THIS predicate. It was a lexeme-suffix test on "_node_projection" before, and a suffix is a
// heuristic (DESIGN section 4): an authored fn or data declaration whose name ends in
// `_node_projection` (v2.std.runtime runtime_value_node_projection and its siblings) matched it and
// was dissolved at the module body -- one such declaration vanished SILENTLY, two collided into an
// ill-formed Conj. The roster is what the grammar_named_edge sites below actually mint; a projection
// edge added there is added here, and a name outside it is program data by construction.
fn parse_tree_projection_edge(name: Symbol) -> Bool {
  (name == ^grammar_production_identity_node_projection)
    || (name == ^grammar_production_captured_node_projection)
    || (name == ^grammar_sequence_left_node_projection)
    || (name == ^grammar_sequence_right_node_projection)
}

fn parse_wrap_production_captured(
  production: GrammarProduction,
  captured: Node,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: [captured])
  let event = DerivedBy { producer: ^parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Conj },
      children: [
        grammar_named_edge(name: ^grammar_production_identity_node_projection, target: production.emitted),
        grammar_named_edge(name: ^grammar_production_captured_node_projection, target: captured)
      ],
      occurrence_id: node_occurrence_identity_minted(id: minted.id)
    ),
    prov: ParseProvenanceState {
      alloc: minted.alloc,
      index: index,
      frame: list_snoc_item(xs: prov.frame, item: FrameMinted { id: minted.id })
    }
  }
}

fn parse_flatten_diag_batches(batches: List<List<Diagnostic>>) -> List<Diagnostic> {
  list_reverse(xs: fold_list(
    xs: batches,
    empty: std.algebra.Empty,
    cons: fn(acc, batch) {
      fold_list(
        xs: batch,
        empty: acc,
        cons: fn(inner_acc, d) { Cons { head: d, tail: inner_acc } }
      )
    }
  ))
}

fn parse_tokens_drop_one(tokens: List<Token>) -> List<Token> {
  match list_tail(xs: tokens) {
    TailFound { tail: rest } => rest
    TailAbsent => []
  }
}

fn parse_tokens_drop(tokens: List<Token>, count: Int) -> List<Token> {
  if count <= 0 {
    tokens
  } else {
    parse_tokens_drop(tokens: parse_tokens_drop_one(tokens: tokens), count: count - 1)
  }
}

// A MEMO MISS JOINS CALLER FIRST: the caller's furthest record was made before the subparse ran, so
// it is the left operand of parse_furthest_join -- the order an expectation tie is broken by.
fn parse_nonterminal_memoized(
  all_tokens: List<Token>,
  tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prod_name: Symbol,
  prov: ParseProvenanceState
) -> ParseExprResult {
  let key = ParsePositionKey {
    position: parse_current_position(tokens: tokens),
    production: prod_name
  }
  match grammar_lookup_production_indexed(table: table, name: prod_name) {
    Violates { diagnostic: d } =>
      ParseExprRejected { diagnostics: [d], table: table }
    Holds { value: production } =>
      let table_at_lookup = parse_table_record_lookup_call(table: table)
      match parse_table_lookup(table: table_at_lookup, key: key) {
        Holds { value: inner } =>
          let table_hit = parse_table_record_hit(table: table_at_lookup)
          match inner {
            ParseMemoRejected { diagnostics: diags, furthest: served, refusal: served_refusal } =>
              ParseExprRejected {
                diagnostics: diags,
                table: parse_table_join_refusal(table: parse_table_join_furthest(table: table_hit, furthest: served), refusal: served_refusal)
              }
            ParseMemoAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov, furthest: served, refusal: served_refusal } =>
              let merged_prov = parse_prov_merge(base: prov, incoming: inner_prov)
              let stamped = parse_wrap_production_captured(
                production: production,
                captured: captured,
                prov: merged_prov
              )
              ParseExprAccepted {
                remaining: remaining,
                captured: stamped.node,
                diagnostics: diags,
                prov: stamped.prov,
                table: parse_table_join_refusal(table: parse_table_join_furthest(table: table_hit, furthest: served), refusal: served_refusal)
              }
          }
        Violates { diagnostic: _ } =>
          let table_miss = parse_table_record_miss(table: table_at_lookup)
          let inner = parse_expr_with_first(
            expr: parse_table_prepared_expr(table: table_miss, production: production),
            tokens: tokens,
            all_tokens: all_tokens,
            root: root,
            table: parse_table_with_furthest(table: table_miss, furthest: FurthestNone),
            prov: parse_prov_enter_frame(prov: prov)
          )
          let table_inserted = parse_table_insert(
            table: parse_expr_result_table(result: inner),
            key: key,
            value: parse_memo_entry_from_expr(result: inner)
          )
          let table_after_memo = parse_table_with_furthest(
            table: table_inserted,
            furthest: parse_furthest_join(left: table_miss.furthest, right: table_inserted.furthest)
          )
          match inner {
            ParseExprRejected { diagnostics: diags, table: _ } =>
              ParseExprRejected { diagnostics: diags, table: table_after_memo }
            ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov, table: _ } =>
              let stamped = parse_wrap_production_captured(
                production: production,
                captured: captured,
                prov: parse_prov_leave_frame(outer: prov, inner: inner_prov)
              )
              ParseExprAccepted {
                remaining: remaining,
                captured: stamped.node,
                diagnostics: diags,
                prov: stamped.prov,
                table: table_after_memo
              }
          }
      }
  }
}

fn set_symbol_insert(s: List<Symbol>, item: Symbol) -> List<Symbol> {
  if symbol_list_contains(xs: s, item: item) {
    s
  } else {
    list_snoc_item(xs: s, item: item)
  }
}

fn expr_is_nullable_given_set(expr: GrammarExpr, nullable_set: List<Symbol>) -> Bool {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_, _) { false },
      literal_terminal: fn(_, _) { false },
      nonterminal: fn(name) { symbol_list_contains(xs: nullable_set, item: name) },
      sequence: fn(left_nullable, right_nullable) { left_nullable && right_nullable },
      choice: fn(left_nullable, right_nullable) { left_nullable || right_nullable },
      optional: fn(_) { true },
      repeat: fn(_) { true },
      expect: fn(element_nullable, _reason) { element_nullable },
      refuse_on_match: fn(element_nullable, _reason) { element_nullable },
      after_line_break: fn(element_nullable) { element_nullable },
      not_predicate: fn(_) { true }
    }
  )
}

fn compute_nullable_step(ns: List<Symbol>, p: GrammarProduction) -> List<Symbol> {
  if expr_is_nullable_given_set(expr: p.expression, nullable_set: ns) {
    set_symbol_insert(s: ns, item: p.name)
  } else {
    ns
  }
}

// ONE ROUND of the nullable fixpoint: every production gets a chance to join the set given what
// the set already holds.
fn compute_nullable_round(root: GrammarRoot, ns: List<Symbol>) -> List<Symbol> {
  fold_list(
    xs: root.productions,
    empty: ns,
    cons: fn(acc, p) {
      compute_nullable_step(ns: acc, p: p)
    }
  )
}

// THE CONVERGENCE MEASURE. The carrier is the enumeration itself — a `List<Symbol>` — so the
// monotone measure is its length directly: `compute_nullable_step` only ever inserts, so the
// number of names the set carries rises until a round adds nothing, and equal counts across a
// round mean equal sets (insertion is de-duplicated by `set_symbol_insert`, so growth is
// membership, never repetition).

// ITERATE TO CONVERGENCE, BOUNDED BY THE SAME COUNT THE OLD SHAPE SPENT UNCONDITIONALLY.
//
// The previous form ran exactly `length(productions)` rounds every time — the outer fold ignored
// its element and existed only to repeat the inner one — because that many rounds is the standard
// worst-case bound for this fixpoint. It is a bound, not a cost: on the live `.dag` grammar the
// set stops growing at round 4 of 38, so 34 rounds recomputed an answer that could no longer
// change. `fuel` keeps that worst case exactly (never more), and the count check leaves as soon as
// a round adds nothing, so the RESULT is identical and only the redundant rounds are gone.
fn compute_nullable_fixpoint(
  root: GrammarRoot,
  ns: List<Symbol>,
  seen_count: Int,
  fuel: Int
) -> List<Symbol> {
  if fuel == 0 {
    ns
  } else {
    let next = compute_nullable_round(root: root, ns: ns)
    let next_count = length(xs: next)
    if next_count == seen_count {
      next
    } else {
      compute_nullable_fixpoint(root: root, ns: next, seen_count: next_count, fuel: fuel - 1)
    }
  }
}

fn compute_nullable_set(root: GrammarRoot) -> List<Symbol> {
  compute_nullable_fixpoint(
    root: root,
    ns: std.algebra.Empty,
    seen_count: 0,
    fuel: length(xs: root.productions)
  )
}

// A FIRST ELEMENT IS A CLASS, OR ONE EXACT WORD OF A CLASS. The second arm exists for
// `v2.std.grammar` `LiteralTerminal`: marker words (`input`, `output`, `exit`, ...) are all idents,
// and alternatives led by different words share EVERY class prefix -- `input {` and `output {` are
// both [ident, lbrace, ident, colon, ...] -- so no lookahead depth over classes can tell them
// apart. The word has to be part of the key. Equality, overlap and token admission are each
// defined ONCE below; a second definition that ignored the word would dispatch to the wrong
// alternative with every claim still green.
type FirstKey
  = FirstAnyOfClass { token_class: Symbol }
  | FirstExactWord { token_class: Symbol, lexeme: Symbol }

fn first_key_class(key: FirstKey) -> Symbol {
  match key {
    FirstAnyOfClass { token_class: c } => c
    FirstExactWord { token_class: c, lexeme: _ } => c
  }
}

// Identity: the same key, word included.
fn first_key_eq(left: FirstKey, right: FirstKey) -> Bool {
  match left {
    FirstAnyOfClass { token_class: lc } =>
      match right {
        FirstAnyOfClass { token_class: rc } => lc == rc
        FirstExactWord { token_class: _, lexeme: _ } => false
      }
    FirstExactWord { token_class: lc, lexeme: lw } =>
      match right {
        FirstExactWord { token_class: rc, lexeme: rw } => lc == rc && lw == rw
        FirstAnyOfClass { token_class: _ } => false
      }
  }
}

// Overlap: some single token satisfies both keys. Any-of-class overlaps every word of its class;
// two exact words overlap only when they are the same word.
fn first_key_overlaps(left: FirstKey, right: FirstKey) -> Bool {
  if first_key_class(key: left) == first_key_class(key: right) {
    match left {
      FirstAnyOfClass { token_class: _ } => true
      FirstExactWord { token_class: _, lexeme: lw } =>
        match right {
          FirstAnyOfClass { token_class: _ } => true
          FirstExactWord { token_class: _, lexeme: rw } => lw == rw
        }
    }
  } else {
    false
  }
}

// Admission: this key can start on a token of this class carrying this word.
fn first_key_admits_word(key: FirstKey, token_class: Symbol, word: String) -> Bool {
  match key {
    FirstAnyOfClass { token_class: c } => c == token_class
    FirstExactWord { token_class: c, lexeme: w } => c == token_class && symbol_lexeme(sym: w) == word
  }
}

fn empty_symbol_list() -> List<Symbol> {
  std.algebra.Empty
}

fn first_keys_classes(keys: List<FirstKey>) -> List<Symbol> {
  fold_list(xs: keys, empty: empty_symbol_list(), cons: fn(acc, k) {
    set_symbol_insert(s: acc, item: first_key_class(key: k))
  })
}

fn first_keys_contains(xs: List<FirstKey>, item: FirstKey) -> Bool {
  contains(xs: xs, item: item, eq: fn(a, b) { first_key_eq(left: a, right: b) })
}

type GrammarExprFirstFold {
  terminals: List<FirstKey>
  nullable: Bool
}

// THE NULLABLE CARRIER IS AN ENUMERATION, NOT A PREDICATE — the same repair
// `GrammarRoot.sync_tokens` already took (v2.std.grammar). A grammar's nullable set is a finite
// subset of its production names, fully known at prepare time; carrying it as a
// `PointwisePower<Symbol>` characteristic function made every membership read walk a nested
// closure chain, and made the whole `PreparedGrammar` NON-PORTABLE: the cross-claim pure tier's
// publication walk refuses a closure at any depth (ServeCacheValueNotPortable), so the one fill
// every parse of `.dag` source demands could never store, and every demanding claim recomputed
// it until its own CPU budget stopped the fill mid-flight. The field is the enumeration it
// always was; `first_rows` beside it was already enumeration-shaped.
// THE GRAMMAR DIGEST AND THE PRODUCTION INDEX ARE ONCE-PER-GRAMMAR FACTS AND LIVE HERE, beside
// the FIRST analysis they were already computed next to. Until this carrier held them,
// parse_table_for_production_analyzed re-derived both on EVERY parse call -- a content hash of
// the whole grammar node tree (grammar_to_node over the 200-production dag grammar, then
// content_hash) plus an O(P) map build -- for a value that prepare_grammar had fixed before the
// first token was read. The required floor's own cross-claim demand census (main run
// 34556223550, required_floor_cross_claim_demand.tsv) named it: parse_grammar_digest at
// claims=19 evals=19, ~128ms per claim on the lane's runner, every one of them a claim that
// parses `.dag` text against the warm-shared dag_prepared_grammar -- so the preparation was
// shared and the invariant derived FROM it was not, which is the DESIGN §6 per-call rebuild
// #10992's write-up flagged. prepared_exprs is the precedent: a per-grammar derivation carried
// once and read per parse. Nothing about the digest's value changes; only where it is paid.
// The same per-parse rebuild had a second site: parse_production_prepared derived the grammar's
// own locus eagerly (node_locus over grammar_to_node of the whole grammar) although only the
// rejection arm that carried no diagnostic of its own ever read it; it is now derived on that
// arm alone.
type GrammarFirstAnalysis {
  nullable_set: List<Symbol>
  first_rows: Map<Symbol, List<FirstKey>>
  prepared_exprs: Map<Symbol, PreparedGrammarExpr>
  grammar_digest: Hash
  productions_by_name: Map<Symbol, GrammarProduction>
  choice_residue: List<GrammarChoiceAmbiguityRow>
  memo_recurrence: ParseMemoRecurrence
}

fn grammar_empty_terminal_list() -> List<FirstKey> {
  std.algebra.Empty
}

fn symbol_list_contains(xs: List<Symbol>, item: Symbol) -> Bool {
  contains(xs: xs, item: item, eq: fn(a, b) { a == b })
}

fn first_list_union(left: List<FirstKey>, right: List<FirstKey>) -> List<FirstKey> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, sym) {
      if first_keys_contains(xs: acc, item: sym) {
        acc
      } else {
        list_snoc_item(xs: acc, item: sym)
      }
    }
  )
}

// The keys of `left` that some key of `right` overlaps -- a token could start both.
fn first_list_intersect(left: List<FirstKey>, right: List<FirstKey>) -> List<FirstKey> {
  filter(
    xs: left,
    predicate: fn(k) { any(xs: right, predicate: fn(r) { first_key_overlaps(left: k, right: r) }) }
  )
}

fn production_first_row_lookup(rows: Map<Symbol, List<FirstKey>>, name: Symbol) -> List<FirstKey> {
  match v2.std.collection.map_get(m: rows, key: name) {
    Accepted { value: Present { value: terminals }, diagnostics: _ } => terminals
    Accepted { value: Absent, diagnostics: _ } => grammar_empty_terminal_list()
    Rejected { diagnostics: _ } => grammar_empty_terminal_list()
  }
}

fn expr_first_fold_terminal(token_class: Symbol) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: Cons { head: FirstAnyOfClass { token_class: token_class }, tail: std.algebra.Empty },
    nullable: false
  }
}

fn expr_first_fold_literal(token_class: Symbol, lexeme: Symbol) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: Cons { head: FirstExactWord { token_class: token_class, lexeme: lexeme }, tail: std.algebra.Empty },
    nullable: false
  }
}

fn expr_first_fold_nonterminal(
  name: Symbol,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>
) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: production_first_row_lookup(rows: first_rows, name: name),
    nullable: symbol_list_contains(xs: nullable_set, item: name)
  }
}

fn expr_first_fold_sequence(left: GrammarExprFirstFold, right: GrammarExprFirstFold) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: first_list_union(
      left: left.terminals,
      right: if left.nullable { right.terminals } else { grammar_empty_terminal_list() }
    ),
    nullable: left.nullable && right.nullable
  }
}

fn expr_first_fold_choice(left: GrammarExprFirstFold, right: GrammarExprFirstFold) -> GrammarExprFirstFold {
  GrammarExprFirstFold {
    terminals: first_list_union(left: left.terminals, right: right.terminals),
    nullable: left.nullable || right.nullable
  }
}

fn expr_first_fold_optional(element: GrammarExprFirstFold) -> GrammarExprFirstFold {
  GrammarExprFirstFold { terminals: element.terminals, nullable: true }
}

// A not-predicate consumes nothing, so it contributes no FIRST key and is nullable; the expression
// after it in a sequence supplies the sequence's FIRST.
fn expr_first_fold_predicate() -> GrammarExprFirstFold {
  GrammarExprFirstFold { terminals: grammar_empty_terminal_list(), nullable: true }
}

fn expr_first_fold_repeat(element: GrammarExprFirstFold) -> GrammarExprFirstFold {
  GrammarExprFirstFold { terminals: element.terminals, nullable: true }
}

fn expr_first_fold(
  expr: GrammarExpr,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>
) -> GrammarExprFirstFold {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, _) { expr_first_fold_terminal(token_class: token_class) },
      literal_terminal: fn(token_class, lexeme) { expr_first_fold_literal(token_class: token_class, lexeme: lexeme) },
      nonterminal: fn(name) {
        expr_first_fold_nonterminal(name: name, nullable_set: nullable_set, first_rows: first_rows)
      },
      sequence: expr_first_fold_sequence,
      choice: expr_first_fold_choice,
      optional: expr_first_fold_optional,
      repeat: expr_first_fold_repeat,
      expect: fn(element, _reason) { element },
      refuse_on_match: fn(element, _reason) { element },
      after_line_break: fn(element) { element },
      not_predicate: fn(_element) { expr_first_fold_predicate() }
    }
  )
}

fn compute_production_first_row_terminals(
  rows: Map<Symbol, List<FirstKey>>,
  p: GrammarProduction,
  nullable_set: List<Symbol>
) -> List<FirstKey> {
  expr_first_fold(
    expr: p.expression,
    nullable_set: nullable_set,
    first_rows: rows
  ).terminals
}

fn compute_production_first_rows_round(
  root: GrammarRoot,
  nullable_set: List<Symbol>,
  rows: Map<Symbol, List<FirstKey>>
) -> Map<Symbol, List<FirstKey>> {
  fold_list(
    xs: root.productions,
    empty: rows,
    cons: fn(acc, p) {
      map_insert(
        m: acc,
        key: p.name,
        value: compute_production_first_row_terminals(
          rows: acc,
          p: p,
          nullable_set: nullable_set
        )
      )
    }
  )
}

// The same monotone measure as the nullable fixpoint, one level down: a FIRST row only ever gains
// terminals (`first_list_union` inserts, never removes), so the total across all rows rises until
// a round adds nothing. Measured on the live `.dag` grammar this one needs MORE than four rounds —
// unlike nullable — which is why the stopping rule is a measured convergence rather than a
// constant anybody picked.
fn production_first_rows_total(root: GrammarRoot, rows: Map<Symbol, List<FirstKey>>) -> Int {
  fold_list(
    xs: root.productions,
    empty: 0,
    cons: fn(acc, p) {
      acc + length(xs: production_first_row_lookup(rows: rows, name: p.name))
    }
  )
}

fn compute_production_first_rows_fixpoint(
  root: GrammarRoot,
  nullable_set: List<Symbol>,
  rows: Map<Symbol, List<FirstKey>>,
  seen_total: Int,
  fuel: Int
) -> Map<Symbol, List<FirstKey>> {
  if fuel == 0 {
    rows
  } else {
    let next = compute_production_first_rows_round(root: root, nullable_set: nullable_set, rows: rows)
    let next_total = production_first_rows_total(root: root, rows: next)
    if next_total == seen_total {
      next
    } else {
      compute_production_first_rows_fixpoint(
        root: root,
        nullable_set: nullable_set,
        rows: next,
        seen_total: next_total,
        fuel: fuel - 1
      )
    }
  }
}

fn compute_production_first_rows(
  root: GrammarRoot,
  nullable_set: List<Symbol>
) -> Map<Symbol, List<FirstKey>> {
  compute_production_first_rows_fixpoint(
    root: root,
    nullable_set: nullable_set,
    rows: empty_map(),
    seen_total: 0,
    fuel: length(xs: root.productions)
  )
}

// A prepared grammar expression is the parse-time carrier for FIRST knowledge and for the
// execution plan of each ordered Choice. Nested binary Choice spines are flattened here into one
// ordered alternative list; runtime interprets that plan and does not scan FIRST, flatten, or
// inspect authored production names.
type TokenPrefixRow {
  prefix: List<Symbol>
  next: PreparedChoicePlan
}

// `ChoiceByWord` dispatches on the token's WORD inside one token-class bucket. `on_word` holds, per
// exact word some alternative starts with, every alternative that can start on that word (the exact
// ones and every any-of-class one, in authored order); `on_other` holds the any-of-class ones alone.
type PreparedChoicePlan
  = ChoiceByToken {
      on_token: Map<Symbol, PreparedChoicePlan>
      on_other: PreparedChoicePlan
      on_end: PreparedChoicePlan
    }
  | ChoiceSharedPrefix {
      prefix: PreparedGrammarExpr
      suffix: PreparedChoicePlan
    }
  | ChoiceTokenPrefix { rows: List<TokenPrefixRow> }
  | ChoiceByWord {
      on_word: Map<String, PreparedChoicePlan>
      on_other: PreparedChoicePlan
    }
  | ChoiceOrderedBacktrack {
      alternatives: List<PreparedGrammarExpr>
    }
  | ChoiceParseOne { expr: PreparedGrammarExpr }
  | ChoiceReject

type PreparedGrammarExpr
  = PreparedTerminal { token_class: Symbol, stamp: TerminalStampMode }
  | PreparedLiteralTerminal { token_class: Symbol, lexeme: Symbol }
  | PreparedNonterminal { production: Symbol }
  | PreparedSequence { left: PreparedGrammarExpr, right: PreparedGrammarExpr }
  | PreparedChoice { plan: PreparedChoicePlan, first: GrammarExprFirstFold }
  | PreparedOptional { element: PreparedGrammarExpr }
  | PreparedRepeat { element: PreparedGrammarExpr }
  | PreparedExpect { element: PreparedGrammarExpr, reason: ParseRefusalReason }
  | PreparedRefuseOnMatch { element: PreparedGrammarExpr, reason: ParseRefusalReason }
  | PreparedAfterLineBreak { element: PreparedGrammarExpr }
  | PreparedNotPredicate { element: PreparedGrammarExpr, first: GrammarExprFirstFold }

type PreparedExprFold {
  tree: PreparedGrammarExpr
  first: GrammarExprFirstFold
  residue: List<GrammarChoiceAmbiguityRow>
}

// list_head HeadFound { value: alt } on List<PreparedExprFold> / List<TokenPrefixRow> types alt as T,
// so a field read is unwritable. fold_list over GrammarProduction instantiates (p.name in
// compute_grammar_first_analysis_given). These projectors instantiate the record at a typed
// parameter; they are not a second meaning of the fields. Class:
// gunbc.recurring_failure_mode.list_head_bound_record_element_stays_t.
fn prepared_expr_fold_tree(alt: PreparedExprFold) -> PreparedGrammarExpr { alt.tree }
fn prepared_expr_fold_first(alt: PreparedExprFold) -> GrammarExprFirstFold { alt.first }
fn prepared_expr_fold_residue(alt: PreparedExprFold) -> List<GrammarChoiceAmbiguityRow> { alt.residue }
fn token_prefix_row_prefix(row: TokenPrefixRow) -> List<Symbol> { row.prefix }
fn token_prefix_row_next(row: TokenPrefixRow) -> PreparedChoicePlan { row.next }

fn concat_prepared_alt_residue(alts: List<PreparedExprFold>) -> List<GrammarChoiceAmbiguityRow> {
  match list_head(xs: alts) {
    HeadAbsent => std.algebra.Empty
    HeadFound { value: alt } =>
      match list_tail(xs: alts) {
        TailAbsent => prepared_expr_fold_residue(alt: alt)
        TailFound { tail: rest } =>
          list_append(left: prepared_expr_fold_residue(alt: alt), right: concat_prepared_alt_residue(alts: rest))
      }
  }
}

// An Expect around a Choice stays ONE alternative: the label belongs to the whole choice, so
// flattening through it would move its reason onto every branch.
fn flatten_choice_exprs(expr: GrammarExpr) -> List<GrammarExpr> {
  match expr {
    Choice { left: left, right: right } =>
      list_append(left: flatten_choice_exprs(expr: left), right: flatten_choice_exprs(expr: right))
    Terminal { token_class: _, stamp: _ } => Cons { head: expr, tail: std.algebra.Empty }
    LiteralTerminal { token_class: _, lexeme: _ } => Cons { head: expr, tail: std.algebra.Empty }
    Nonterminal { production: _ } => Cons { head: expr, tail: std.algebra.Empty }
    Sequence { left: _, right: _ } => Cons { head: expr, tail: std.algebra.Empty }
    Optional { element: _ } => Cons { head: expr, tail: std.algebra.Empty }
    Repeat { element: _ } => Cons { head: expr, tail: std.algebra.Empty }
    Expect { element: _, reason: _ } => Cons { head: expr, tail: std.algebra.Empty }
    RefuseOnMatch { element: _, reason: _ } => Cons { head: expr, tail: std.algebra.Empty }
    AfterLineBreak { element: _ } => Cons { head: expr, tail: std.algebra.Empty }
    NotPredicate { element: _ } => Cons { head: expr, tail: std.algebra.Empty }
  }
}

fn prepared_stamp_eq(left: TerminalStampMode, right: TerminalStampMode) -> Bool {
  match left {
    StampClass =>
      match right {
        StampClass => true
        StampLexeme => false
        StampBinding { binding: _ } => false
      }
    StampLexeme =>
      match right {
        StampLexeme => true
        StampClass => false
        StampBinding { binding: _ } => false
      }
    StampBinding { binding: lb } =>
      match right {
        StampBinding { binding: rb } => lb == rb
        StampClass => false
        StampLexeme => false
      }
  }
}

fn prepared_prefix_atom_eq(left: PreparedGrammarExpr, right: PreparedGrammarExpr) -> Bool {
  match left {
    PreparedTerminal { token_class: lc, stamp: ls } =>
      match right {
        PreparedTerminal { token_class: rc, stamp: rs } =>
          (lc == rc) && prepared_stamp_eq(left: ls, right: rs)
        PreparedLiteralTerminal { token_class: _, lexeme: _ } => false
        PreparedNonterminal { production: _ } => false
        PreparedSequence { left: _, right: _ } => false
        PreparedChoice { plan: _, first: _ } => false
        PreparedOptional { element: _ } => false
        PreparedRepeat { element: _ } => false
        PreparedExpect { element: _, reason: _ } => false
        PreparedRefuseOnMatch { element: _, reason: _ } => false
        PreparedAfterLineBreak { element: _ } => false
        PreparedNotPredicate { element: _, first: _ } => false
      }
    PreparedLiteralTerminal { token_class: lc, lexeme: lw } =>
      match right {
        PreparedLiteralTerminal { token_class: rc, lexeme: rw } => first_key_eq(
          left: FirstExactWord { token_class: lc, lexeme: lw },
          right: FirstExactWord { token_class: rc, lexeme: rw }
        )
        PreparedTerminal { token_class: _, stamp: _ } => false
        PreparedNonterminal { production: _ } => false
        PreparedSequence { left: _, right: _ } => false
        PreparedChoice { plan: _, first: _ } => false
        PreparedOptional { element: _ } => false
        PreparedRepeat { element: _ } => false
        PreparedExpect { element: _, reason: _ } => false
        PreparedRefuseOnMatch { element: _, reason: _ } => false
        PreparedAfterLineBreak { element: _ } => false
        PreparedNotPredicate { element: _, first: _ } => false
      }
    PreparedNonterminal { production: lp } =>
      match right {
        PreparedNonterminal { production: rp } => lp == rp
        PreparedTerminal { token_class: _, stamp: _ } => false
        PreparedLiteralTerminal { token_class: _, lexeme: _ } => false
        PreparedSequence { left: _, right: _ } => false
        PreparedChoice { plan: _, first: _ } => false
        PreparedOptional { element: _ } => false
        PreparedRepeat { element: _ } => false
        PreparedExpect { element: _, reason: _ } => false
        PreparedRefuseOnMatch { element: _, reason: _ } => false
        PreparedAfterLineBreak { element: _ } => false
        PreparedNotPredicate { element: _, first: _ } => false
      }
    PreparedSequence { left: _, right: _ } => false
    PreparedChoice { plan: _, first: _ } => false
    PreparedOptional { element: _ } => false
    PreparedRepeat { element: _ } => false
    PreparedExpect { element: _, reason: _ } => false
    PreparedRefuseOnMatch { element: _, reason: _ } => false
    PreparedAfterLineBreak { element: _ } => false
    PreparedNotPredicate { element: _, first: _ } => false
  }
}

fn prepared_sequence_left_atom(expr: PreparedGrammarExpr) -> Optional<PreparedGrammarExpr> {
  match expr {
    PreparedSequence { left: left, right: _ } =>
      match left {
        PreparedTerminal { token_class: _, stamp: _ } => optional_present(value: left)
        PreparedLiteralTerminal { token_class: _, lexeme: _ } => optional_present(value: left)
        PreparedNonterminal { production: _ } => optional_present(value: left)
        PreparedSequence { left: _, right: _ } => optional_absent()
        PreparedChoice { plan: _, first: _ } => optional_absent()
        PreparedOptional { element: _ } => optional_absent()
        PreparedRepeat { element: _ } => optional_absent()
        PreparedExpect { element: _, reason: _ } => optional_absent()
        PreparedRefuseOnMatch { element: _, reason: _ } => optional_absent()
        PreparedAfterLineBreak { element: _ } => optional_absent()
        PreparedNotPredicate { element: _, first: _ } => optional_absent()
      }
    PreparedTerminal { token_class: _, stamp: _ } => optional_absent()
    PreparedLiteralTerminal { token_class: _, lexeme: _ } => optional_absent()
    PreparedNonterminal { production: _ } => optional_absent()
    PreparedChoice { plan: _, first: _ } => optional_absent()
    PreparedOptional { element: _ } => optional_absent()
    PreparedRepeat { element: _ } => optional_absent()
    PreparedExpect { element: _, reason: _ } => optional_absent()
    PreparedRefuseOnMatch { element: _, reason: _ } => optional_absent()
    PreparedAfterLineBreak { element: _ } => optional_absent()
    PreparedNotPredicate { element: _, first: _ } => optional_absent()
  }
}

fn choice_alts_union_first(alts: List<PreparedExprFold>) -> GrammarExprFirstFold {
  choice_alts_union_first_from(
    alts: alts,
    acc: GrammarExprFirstFold { terminals: grammar_empty_terminal_list(), nullable: false }
  )
}

fn choice_alts_union_first_from(
  alts: List<PreparedExprFold>,
  acc: GrammarExprFirstFold
) -> GrammarExprFirstFold {
  match list_head(xs: alts) {
    HeadAbsent => acc
    HeadFound { value: alt } =>
      match list_tail(xs: alts) {
        TailAbsent => expr_first_fold_choice(left: acc, right: prepared_expr_fold_first(alt: alt))
        TailFound { tail: rest } =>
          choice_alts_union_first_from(
            alts: rest,
            acc: expr_first_fold_choice(left: acc, right: prepared_expr_fold_first(alt: alt))
          )
      }
  }
}

// The token CLASSES any alternative can start on; words are dispatched inside a class bucket.
fn choice_alts_terminal_universe(alts: List<PreparedExprFold>) -> List<Symbol> {
  first_keys_classes(keys: choice_alts_union_first(alts: alts).terminals)
}

// Flattened n-way: a token bucket is every alternative that can start on that token, in authored
// order, plus every nullable alternative (they match empty after a FIRST-alt rejects). Ordered
// Choice is try-left-then-right; a nullable sibling is not dropped because the nullable count is 1.
fn choice_alts_for_present_token(alts: List<PreparedExprFold>, token_class: Symbol) -> List<PreparedExprFold> {
  match list_head(xs: alts) {
    HeadAbsent => std.algebra.Empty
    HeadFound { value: alt } =>
      let first = prepared_expr_fold_first(alt: alt)
      let keep =
        if any(xs: first.terminals, predicate: fn(k) { first_key_class(key: k) == token_class }) {
          true
        } else {
          first.nullable
        }
      let more = match list_tail(xs: alts) {
        TailAbsent => std.algebra.Empty
        TailFound { tail: rest } => choice_alts_for_present_token(alts: rest, token_class: token_class)
      }
      list_append(
        left: if keep {
          Cons { head: alt, tail: std.algebra.Empty }
        } else {
          std.algebra.Empty
        },
        right: more
      )
  }
}

fn choice_alts_nullable(alts: List<PreparedExprFold>) -> List<PreparedExprFold> {
  match list_head(xs: alts) {
    HeadAbsent => std.algebra.Empty
    HeadFound { value: alt } =>
      let first = prepared_expr_fold_first(alt: alt)
      let more = match list_tail(xs: alts) {
        TailAbsent => std.algebra.Empty
        TailFound { tail: rest } => choice_alts_nullable(alts: rest)
      }
      list_append(
        left: if first.nullable {
          Cons { head: alt, tail: std.algebra.Empty }
        } else {
          std.algebra.Empty
        },
        right: more
      )
  }
}

fn choice_alt_trees(alts: List<PreparedExprFold>) -> List<PreparedGrammarExpr> {
  match list_head(xs: alts) {
    HeadAbsent => std.algebra.Empty
    HeadFound { value: alt } =>
      list_append(
        left: Cons { head: prepared_expr_fold_tree(alt: alt), tail: std.algebra.Empty },
        right: match list_tail(xs: alts) {
          TailAbsent => std.algebra.Empty
          TailFound { tail: rest } => choice_alt_trees(alts: rest)
        }
      )
  }
}

// A class-only prefix cannot represent an exact word, so a literal terminal refuses the token-prefix
// row form; its word was already dispatched by ChoiceByWord.
fn prepared_terminal_prefix(expr: PreparedGrammarExpr, need: Int) -> Optional<List<Symbol>> {
  if need == 0 {
    optional_present(value: std.algebra.Empty)
  } else {
    match expr {
      PreparedTerminal { token_class: token_class, stamp: _ } =>
        if need == 1 {
          optional_present(value: Cons { head: token_class, tail: std.algebra.Empty })
        } else {
          optional_absent()
        }
      PreparedLiteralTerminal { token_class: _, lexeme: _ } => optional_absent()
      PreparedSequence { left: left, right: right } =>
        match left {
          PreparedTerminal { token_class: token_class, stamp: _ } =>
            if need == 1 {
              optional_present(value: Cons { head: token_class, tail: std.algebra.Empty })
            } else {
              match prepared_terminal_prefix(expr: right, need: need - 1) {
                Present { value: rest } =>
                  optional_present(value: Cons { head: token_class, tail: rest })
                Absent => optional_absent()
              }
            }
          PreparedLiteralTerminal { token_class: _, lexeme: _ } => optional_absent()
          PreparedNonterminal { production: _ } => optional_absent()
          PreparedSequence { left: _, right: _ } => optional_absent()
          PreparedChoice { plan: _, first: _ } => optional_absent()
          PreparedOptional { element: _ } => optional_absent()
          PreparedRepeat { element: _ } => optional_absent()
          PreparedExpect { element: _, reason: _ } => optional_absent()
          PreparedRefuseOnMatch { element: _, reason: _ } => optional_absent()
          PreparedAfterLineBreak { element: _ } => optional_absent()
          PreparedNotPredicate { element: _, first: _ } => optional_absent()
        }
      PreparedNonterminal { production: _ } => optional_absent()
      PreparedChoice { plan: _, first: _ } => optional_absent()
      PreparedOptional { element: _ } => optional_absent()
      PreparedRepeat { element: _ } => optional_absent()
      PreparedExpect { element: _, reason: _ } => optional_absent()
      PreparedRefuseOnMatch { element: _, reason: _ } => optional_absent()
      PreparedAfterLineBreak { element: _ } => optional_absent()
      PreparedNotPredicate { element: _, first: _ } => optional_absent()
    }
  }
}

fn token_prefix_row_conflicts(rows: List<TokenPrefixRow>, prefix: List<Symbol>) -> Bool {
  match list_head(xs: rows) {
    HeadAbsent => false
    HeadFound { value: row } =>
      if zip_eq(a: token_prefix_row_prefix(row: row), b: prefix, eq: fn(x, y) { x == y }) {
        true
      } else {
        match list_tail(xs: rows) {
          TailAbsent => false
          TailFound { tail: rest } => token_prefix_row_conflicts(rows: rest, prefix: prefix)
        }
      }
  }
}

fn choice_token_prefix_rows(alts: List<PreparedExprFold>, need: Int) -> Optional<List<TokenPrefixRow>> {
  choice_token_prefix_rows_from(alts: alts, need: need, rows: std.algebra.Empty)
}

fn choice_token_prefix_rows_from(
  alts: List<PreparedExprFold>,
  need: Int,
  rows: List<TokenPrefixRow>
) -> Optional<List<TokenPrefixRow>> {
  match list_head(xs: alts) {
    HeadAbsent => optional_present(value: rows)
    HeadFound { value: alt } =>
      match prepared_terminal_prefix(expr: prepared_expr_fold_tree(alt: alt), need: need) {
        Absent => optional_absent()
        Present { value: prefix } =>
          if token_prefix_row_conflicts(rows: rows, prefix: prefix) {
            optional_absent()
          } else {
            match list_tail(xs: alts) {
              TailAbsent =>
                optional_present(value: list_snoc_item(
                  xs: rows,
                  item: TokenPrefixRow { prefix: prefix, next: ChoiceParseOne { expr: prepared_expr_fold_tree(alt: alt) } }
                ))
              TailFound { tail: rest } =>
                choice_token_prefix_rows_from(
                  alts: rest,
                  need: need,
                  rows: list_snoc_item(
                    xs: rows,
                    item: TokenPrefixRow { prefix: prefix, next: ChoiceParseOne { expr: prepared_expr_fold_tree(alt: alt) } }
                  )
                )
            }
          }
      }
  }
}

fn choice_shared_prefix_suffixes(
  alts: List<PreparedExprFold>,
  prefix: PreparedGrammarExpr,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>
) -> Optional<List<PreparedExprFold>> {
  choice_shared_prefix_suffixes_from(
    alts: alts,
    prefix: prefix,
    nullable_set: nullable_set,
    first_rows: first_rows,
    suffixes: std.algebra.Empty
  )
}

fn choice_shared_prefix_suffixes_from(
  alts: List<PreparedExprFold>,
  prefix: PreparedGrammarExpr,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>,
  suffixes: List<PreparedExprFold>
) -> Optional<List<PreparedExprFold>> {
  match list_head(xs: alts) {
    HeadAbsent => optional_present(value: suffixes)
    HeadFound { value: alt } =>
      match prepared_expr_fold_tree(alt: alt) {
        PreparedSequence { left: left, right: right } =>
          if prepared_prefix_atom_eq(left: left, right: prefix) {
            let next_suffixes = list_snoc_item(
              xs: suffixes,
              item: PreparedExprFold {
                tree: right,
                first: expr_first_fold_from_prepared(
                  expr: right,
                  nullable_set: nullable_set,
                  first_rows: first_rows
                ),
                residue: std.algebra.Empty
              }
            )
            match list_tail(xs: alts) {
              TailAbsent => optional_present(value: next_suffixes)
              TailFound { tail: rest } =>
                choice_shared_prefix_suffixes_from(
                  alts: rest,
                  prefix: prefix,
                  nullable_set: nullable_set,
                  first_rows: first_rows,
                  suffixes: next_suffixes
                )
            }
          } else {
            optional_absent()
          }
        PreparedTerminal { token_class: _, stamp: _ } => optional_absent()
        PreparedLiteralTerminal { token_class: _, lexeme: _ } => optional_absent()
        PreparedNonterminal { production: _ } => optional_absent()
        PreparedChoice { plan: _, first: _ } => optional_absent()
        PreparedOptional { element: _ } => optional_absent()
        PreparedRepeat { element: _ } => optional_absent()
        PreparedExpect { element: _, reason: _ } => optional_absent()
        PreparedRefuseOnMatch { element: _, reason: _ } => optional_absent()
        PreparedAfterLineBreak { element: _ } => optional_absent()
        PreparedNotPredicate { element: _, first: _ } => optional_absent()
      }
  }
}

fn expr_first_fold_from_prepared(
  expr: PreparedGrammarExpr,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>
) -> GrammarExprFirstFold {
  match expr {
    PreparedTerminal { token_class: token_class, stamp: _ } =>
      expr_first_fold_terminal(token_class: token_class)
    PreparedLiteralTerminal { token_class: token_class, lexeme: lexeme } =>
      expr_first_fold_literal(token_class: token_class, lexeme: lexeme)
    PreparedNonterminal { production: production } =>
      expr_first_fold_nonterminal(name: production, nullable_set: nullable_set, first_rows: first_rows)
    PreparedSequence { left: left, right: right } =>
      expr_first_fold_sequence(
        left: expr_first_fold_from_prepared(expr: left, nullable_set: nullable_set, first_rows: first_rows),
        right: expr_first_fold_from_prepared(expr: right, nullable_set: nullable_set, first_rows: first_rows)
      )
    PreparedChoice { plan: _, first: first } => first
    PreparedOptional { element: element } =>
      expr_first_fold_optional(
        element: expr_first_fold_from_prepared(expr: element, nullable_set: nullable_set, first_rows: first_rows)
      )
    PreparedRepeat { element: element } =>
      expr_first_fold_repeat(
        element: expr_first_fold_from_prepared(expr: element, nullable_set: nullable_set, first_rows: first_rows)
      )
    PreparedExpect { element: element, reason: _ } =>
      expr_first_fold_from_prepared(expr: element, nullable_set: nullable_set, first_rows: first_rows)
    PreparedRefuseOnMatch { element: element, reason: _ } =>
      expr_first_fold_from_prepared(expr: element, nullable_set: nullable_set, first_rows: first_rows)
    PreparedAfterLineBreak { element: element } =>
      expr_first_fold_from_prepared(expr: element, nullable_set: nullable_set, first_rows: first_rows)
    PreparedNotPredicate { element: _, first: _ } => expr_first_fold_predicate()
  }
}

// THE CHOICE-OVERLAP PROOF READS A DECLARED k TOKENS OF LOOKAHEAD, AND A GUARD COUNTS ONLY WHERE IT
// IS PROVED TO COVER. (operator zero_ambiguity_ruling 2026-10-02, stern-bear-500 ruling A.) A
// single-token FIRST overlap is the candidate row; the row is removed only when the k-prefix sets of
// the alternative and of every alternative after it are disjoint. A leading not-predicate `!G X`
// subtracts from X's prefixes exactly the prefixes every string of which begins with a string of G,
// and only when G is a PLAIN guard (lookahead_guard_strings): a finite set of token strings whose PEG
// success is membership. Where one position of a prefix is a whole token class and G names one word
// of it, the class is narrowed to the class less that word -- the k=1 shape
// `!('none' | 'opaque') type_list`. The guard is also carried on the prefixes it heads, and a pair of
// prefixes is disjoint when one alternative's prefix is covered by the other's guard: the guarded
// alternative then fails on every input that prefix denotes, however short its own prefix is (the
// `name: e | !(name :) e` shape, whose positional side can be one token). Every undecidable arm -- a cycle without consumption, a missing
// production, a guard that is not plain, a guard string longer than the prefix it would cover --
// answers by subtracting nothing or by LookaheadUnknown, and Unknown keeps the row. So the proof
// removes rows and never widens: a guard that misses one prefix is the near miss that keeps its row.
// THE DECLARED LOOKAHEAD: every candidate site is read at the base depth, and a site whose
// alternatives still share a prefix there is read again only as deep as its own longest proved-plain
// guard, never past the cap. Depth is therefore the guard's own claim, made where it is authored: an
// unguarded site pays two tokens, and a guard of three tokens (`{ name :` against a block, `( name ,`
// against a grouped expression) buys exactly the read that can prove it. Read at the cap everywhere,
// the walk tripled the grammar's preparation, paid at every unguarded site that could not use it.
fn grammar_choice_lookahead_depth() -> Int { 2 }

fn grammar_choice_lookahead_depth_cap() -> Int { 3 }

// `honour_guards`: a not-predicate narrows the prefixes it heads only where it heads one of the
// SITE'S OWN alternatives -- the only place a guard decides that site. Inside a production the walk
// expands, a guard is read as what it consumes (nothing) and narrows nothing: that keeps more
// prefixes, so it can only keep a row, never clear one wrongly. Honouring nested guards re-derived
// every guard of `expr` and `stmt` at each of their many expansions and dominated the analysis.
type LookaheadContext {
  productions: Map<Symbol, GrammarProduction>
  nullable_set: List<Symbol>
  first_rows: Map<Symbol, List<FirstKey>>
  honour_guards: Bool
  follow: Optional<List<FirstKey>>
}

fn lookahead_context_nested(ctx: LookaheadContext) -> LookaheadContext {
  LookaheadContext { productions: ctx.productions, nullable_set: ctx.nullable_set, first_rows: ctx.first_rows, honour_guards: false, follow: ctx.follow }
}

// `follow` restricts the token AFTER the site's first one, and only while the walk is still at the
// site's first position: consuming a token hands it over as the next head and clears it.
fn lookahead_context_with_follow(ctx: LookaheadContext, follow: Optional<List<FirstKey>>) -> LookaheadContext {
  LookaheadContext { productions: ctx.productions, nullable_set: ctx.nullable_set, first_rows: ctx.first_rows, honour_guards: ctx.honour_guards, follow: follow }
}

fn lookahead_context_consumed(ctx: LookaheadContext) -> LookaheadContext {
  lookahead_context_with_follow(ctx: ctx, follow: Absent)
}

fn lookahead_head_after(ctx: LookaheadContext, used: Int) -> Optional<List<FirstKey>> {
  if used == 1 { ctx.follow } else { lookahead_keys_unrestricted() }
}

fn lookahead_keys_unrestricted() -> Optional<List<FirstKey>> { Absent }

// One position of a prefix: the FirstKey it reads, less the exact words of its class a proved
// guard removed. `excluded` is empty unless `key` is FirstAnyOfClass.
type LookaheadKey {
  key: FirstKey
  excluded: List<Symbol>
}

// `complete`: the alternative can END after `keys`, so a following sequence element extends it.
// `guards`: the strings of the proved-plain not-predicates standing at the prefix's first token. An
// input that begins with one of them is refused by this alternative, whatever follows.
type LookaheadPrefix {
  keys: List<LookaheadKey>
  complete: Bool
  guards: List<List<FirstKey>>
}

type LookaheadPrefixes
  = LookaheadKnown { prefixes: List<LookaheadPrefix> }
  | LookaheadUnknown

type GuardCoverage
  = GuardCoversAll
  | GuardCoversButOneWord { keys: List<LookaheadKey> }
  | GuardMisses

fn lookahead_prefix_keys(p: LookaheadPrefix) -> List<LookaheadKey> { p.keys }
fn lookahead_prefix_complete(p: LookaheadPrefix) -> Bool { p.complete }
fn lookahead_prefix_guards(p: LookaheadPrefix) -> List<List<FirstKey>> { p.guards }
fn lookahead_production_expression(p: GrammarProduction) -> GrammarExpr { p.expression }

fn lookahead_none() -> LookaheadPrefixes { LookaheadKnown { prefixes: std.algebra.Empty } }

fn lookahead_empty_only() -> LookaheadPrefixes {
  LookaheadKnown {
    prefixes: Cons { head: LookaheadPrefix { keys: std.algebra.Empty, complete: true, guards: std.algebra.Empty }, tail: std.algebra.Empty }
  }
}

fn lookahead_union(left: LookaheadPrefixes, right: LookaheadPrefixes) -> LookaheadPrefixes {
  match left {
    LookaheadUnknown => LookaheadUnknown
    LookaheadKnown { prefixes: l } =>
      match right {
        LookaheadUnknown => LookaheadUnknown
        LookaheadKnown { prefixes: r } => LookaheadKnown { prefixes: list_append(left: l, right: r) }
      }
  }
}

fn lookahead_head_admits(head_keys: Optional<List<FirstKey>>, key: FirstKey) -> Bool {
  match head_keys {
    Absent => true
    Present { value: keys } => any(xs: keys, predicate: fn(k) { first_key_overlaps(left: k, right: key) })
  }
}

fn lookahead_token(key: FirstKey, head_keys: Optional<List<FirstKey>>) -> LookaheadPrefixes {
  if lookahead_head_admits(head_keys: head_keys, key: key) {
    LookaheadKnown {
      prefixes: Cons {
        head: LookaheadPrefix {
          keys: Cons { head: LookaheadKey { key: key, excluded: std.algebra.Empty }, tail: std.algebra.Empty },
          complete: true,
          guards: std.algebra.Empty
        },
        tail: std.algebra.Empty
      }
    }
  } else {
    lookahead_none()
  }
}

// One token left and no head restriction: the production's FIRST row already answers it.
fn lookahead_from_first(first: List<FirstKey>, nullable: Bool) -> LookaheadPrefixes {
  let singles = fold_list(
    xs: first,
    empty: std.algebra.Empty,
    cons: fn(acc, k) {
      list_snoc_item(
        xs: acc,
        item: LookaheadPrefix {
          keys: Cons { head: LookaheadKey { key: k, excluded: std.algebra.Empty }, tail: std.algebra.Empty },
          complete: false,
          guards: std.algebra.Empty
        }
      )
    }
  )
  let known = LookaheadKnown { prefixes: singles }
  if nullable { lookahead_union(left: known, right: lookahead_empty_only()) } else { known }
}

fn lookahead_prefixes(
  expr: GrammarExpr,
  depth: Int,
  head_keys: Optional<List<FirstKey>>,
  visiting: List<Symbol>,
  ctx: LookaheadContext
) -> LookaheadPrefixes {
  match expr {
    Terminal { token_class: c, stamp: _ } => lookahead_token(key: FirstAnyOfClass { token_class: c }, head_keys: head_keys)
    LiteralTerminal { token_class: c, lexeme: w } =>
      lookahead_token(key: FirstExactWord { token_class: c, lexeme: w }, head_keys: head_keys)
    Nonterminal { production: name } =>
      lookahead_nonterminal(name: name, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
    Sequence { left: left, right: right } =>
      lookahead_sequence(left: left, right: right, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
    Choice { left: left, right: right } =>
      lookahead_union(
        left: lookahead_prefixes(expr: left, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx),
        right: lookahead_prefixes(expr: right, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
      )
    Optional { element: element } =>
      lookahead_union(
        left: lookahead_prefixes(expr: element, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx),
        right: lookahead_empty_only()
      )
    Repeat { element: element } =>
      lookahead_repeat(element: element, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
    Expect { element: element, reason: _ } =>
      lookahead_prefixes(expr: element, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
    RefuseOnMatch { element: element, reason: _ } =>
      lookahead_prefixes(expr: element, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
    AfterLineBreak { element: element } =>
      lookahead_prefixes(expr: element, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
    NotPredicate { element: _ } => lookahead_empty_only()
  }
}

// A production re-entered before any token is consumed is a cycle the bounded walk cannot decide.
fn lookahead_nonterminal(
  name: Symbol,
  depth: Int,
  head_keys: Optional<List<FirstKey>>,
  visiting: List<Symbol>,
  ctx: LookaheadContext
) -> LookaheadPrefixes {
  let nullable = symbol_list_contains(xs: ctx.nullable_set, item: name)
  let first = production_first_row_lookup(rows: ctx.first_rows, name: name)
  match head_keys {
    Present { value: keys } =>
      if !nullable && is_empty(xs: first_list_intersect(left: first, right: keys)) {
        lookahead_none()
      } else {
        lookahead_nonterminal_expand(name: name, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
      }
    Absent =>
      if depth == 1 {
        lookahead_from_first(first: first, nullable: nullable)
      } else {
        lookahead_nonterminal_expand(name: name, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
      }
  }
}

fn lookahead_nonterminal_expand(
  name: Symbol,
  depth: Int,
  head_keys: Optional<List<FirstKey>>,
  visiting: List<Symbol>,
  ctx: LookaheadContext
) -> LookaheadPrefixes {
  if symbol_list_contains(xs: visiting, item: name) {
    LookaheadUnknown
  } else {
    match map_lookup(m: ctx.productions, key: name) {
      Present { value: p } =>
        lookahead_prefixes(
          expr: lookahead_production_expression(p: p),
          depth: depth,
          head_keys: head_keys,
          visiting: Cons { head: name, tail: visiting },
          ctx: lookahead_context_nested(ctx: ctx)
        )
      Absent => LookaheadUnknown
    }
  }
}

fn lookahead_leading_guard(expr: GrammarExpr) -> Optional<GrammarExpr> {
  match expr {
    NotPredicate { element: guard } => Present { value: guard }
    Terminal { token_class: _, stamp: _ } => Absent
    LiteralTerminal { token_class: _, lexeme: _ } => Absent
    Nonterminal { production: _ } => Absent
    Sequence { left: _, right: _ } => Absent
    Choice { left: _, right: _ } => Absent
    Optional { element: _ } => Absent
    Repeat { element: _ } => Absent
    Expect { element: _, reason: _ } => Absent
    RefuseOnMatch { element: _, reason: _ } => Absent
    AfterLineBreak { element: _ } => Absent
  }
}

fn lookahead_sequence(
  left: GrammarExpr,
  right: GrammarExpr,
  depth: Int,
  head_keys: Optional<List<FirstKey>>,
  visiting: List<Symbol>,
  ctx: LookaheadContext
) -> LookaheadPrefixes {
  match lookahead_leading_guard(expr: left) {
    Present { value: guard } =>
      if ctx.honour_guards {
        lookahead_subtract_guard(
          prefixes: lookahead_prefixes(expr: right, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx),
          guard: guard,
          ctx: ctx
        )
      } else {
        lookahead_prefixes(expr: right, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
      }
    Absent =>
      lookahead_extend(
        prefixes: lookahead_prefixes(expr: left, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx),
        right: right,
        depth: depth,
        head_keys: head_keys,
        visiting: visiting,
        ctx: ctx
      )
  }
}

fn lookahead_prepend(keys: List<LookaheadKey>, guards: List<List<FirstKey>>, prefixes: LookaheadPrefixes) -> LookaheadPrefixes {
  match prefixes {
    LookaheadUnknown => LookaheadUnknown
    LookaheadKnown { prefixes: ps } =>
      LookaheadKnown {
        prefixes: fold_list(
          xs: ps,
          empty: std.algebra.Empty,
          cons: fn(acc, q) {
            list_snoc_item(
              xs: acc,
              item: LookaheadPrefix {
                keys: list_append(left: keys, right: lookahead_prefix_keys(p: q)),
                complete: lookahead_prefix_complete(p: q),
                guards: guards
              }
            )
          }
        )
      }
  }
}

fn lookahead_truncated(prefix: LookaheadPrefix) -> LookaheadPrefixes {
  LookaheadKnown {
    prefixes: Cons { head: LookaheadPrefix { keys: prefix.keys, complete: false, guards: prefix.guards }, tail: std.algebra.Empty }
  }
}

// Extend each prefix that ended early by the prefixes of what follows. The head restriction and the
// cycle set hold only while nothing has been consumed.
fn lookahead_extend_one(
  prefix: LookaheadPrefix,
  right: GrammarExpr,
  depth: Int,
  head_keys: Optional<List<FirstKey>>,
  visiting: List<Symbol>,
  ctx: LookaheadContext
) -> LookaheadPrefixes {
  let used = length(xs: prefix.keys)
  if prefix.complete && used < depth {
    if used == 0 {
      lookahead_prefixes(expr: right, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
    } else {
      lookahead_prepend(
        keys: prefix.keys,
        guards: prefix.guards,
        prefixes: lookahead_prefixes(expr: right, depth: depth - used, head_keys: lookahead_head_after(ctx: ctx, used: used), visiting: std.algebra.Empty, ctx: lookahead_context_consumed(ctx: ctx))
      )
    }
  } else {
    lookahead_truncated(prefix: prefix)
  }
}

fn lookahead_extend(
  prefixes: LookaheadPrefixes,
  right: GrammarExpr,
  depth: Int,
  head_keys: Optional<List<FirstKey>>,
  visiting: List<Symbol>,
  ctx: LookaheadContext
) -> LookaheadPrefixes {
  match prefixes {
    LookaheadUnknown => LookaheadUnknown
    LookaheadKnown { prefixes: ps } =>
      fold_list(
        xs: ps,
        empty: lookahead_none(),
        cons: fn(acc, p) {
          lookahead_union(
            left: acc,
            right: lookahead_extend_one(prefix: p, right: right, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx)
          )
        }
      )
  }
}

// Zero or more: the empty prefix, and each consuming iteration extended by the repeat again. An
// iteration that consumed nothing adds nothing the empty prefix does not already say.
fn lookahead_repeat(
  element: GrammarExpr,
  depth: Int,
  head_keys: Optional<List<FirstKey>>,
  visiting: List<Symbol>,
  ctx: LookaheadContext
) -> LookaheadPrefixes {
  match lookahead_prefixes(expr: element, depth: depth, head_keys: head_keys, visiting: visiting, ctx: ctx) {
    LookaheadUnknown => LookaheadUnknown
    LookaheadKnown { prefixes: ps } =>
      fold_list(
        xs: ps,
        empty: lookahead_empty_only(),
        cons: fn(acc, p) {
          lookahead_union(left: acc, right: lookahead_repeat_one(prefix: p, element: element, depth: depth, ctx: ctx))
        }
      )
  }
}

fn lookahead_repeat_one(prefix: LookaheadPrefix, element: GrammarExpr, depth: Int, ctx: LookaheadContext) -> LookaheadPrefixes {
  let used = length(xs: prefix.keys)
  if used == 0 {
    lookahead_none()
  } else {
    if prefix.complete && used < depth {
      lookahead_prepend(
        keys: prefix.keys,
        guards: prefix.guards,
        prefixes: lookahead_repeat(element: element, depth: depth - used, head_keys: lookahead_head_after(ctx: ctx, used: used), visiting: std.algebra.Empty, ctx: lookahead_context_consumed(ctx: ctx))
      )
    } else {
      lookahead_truncated(prefix: prefix)
    }
  }
}

// A PLAIN GUARD'S STRINGS. A guard is plain when its PEG success is exactly "the input begins with one
// of these token strings": a token, a choice of plain guards, or a single-token set followed by a
// plain guard. A choice that is not last in a sequence is not plain -- `(x / x y) z` fails on
// `x y z` under ordered choice -- so it answers Absent and the guard subtracts nothing.
fn lookahead_guard_strings(expr: GrammarExpr, visiting: List<Symbol>, ctx: LookaheadContext) -> Optional<List<List<FirstKey>>> {
  match expr {
    Terminal { token_class: c, stamp: _ } =>
      Present { value: Cons { head: Cons { head: FirstAnyOfClass { token_class: c }, tail: std.algebra.Empty }, tail: std.algebra.Empty } }
    LiteralTerminal { token_class: c, lexeme: w } =>
      Present { value: Cons { head: Cons { head: FirstExactWord { token_class: c, lexeme: w }, tail: std.algebra.Empty }, tail: std.algebra.Empty } }
    Choice { left: left, right: right } =>
      match lookahead_guard_strings(expr: left, visiting: visiting, ctx: ctx) {
        Absent => Absent
        Present { value: l } =>
          match lookahead_guard_strings(expr: right, visiting: visiting, ctx: ctx) {
            Absent => Absent
            Present { value: r } => Present { value: list_append(left: l, right: r) }
          }
      }
    Sequence { left: left, right: right } =>
      match lookahead_guard_token_set(expr: left, visiting: visiting, ctx: ctx) {
        Absent => Absent
        Present { value: heads } =>
          match lookahead_guard_strings(expr: right, visiting: std.algebra.Empty, ctx: ctx) {
            Absent => Absent
            Present { value: tails } =>
              Present {
                value: fold_list(
                  xs: heads,
                  empty: std.algebra.Empty,
                  cons: fn(acc, h) {
                    list_append(
                      left: acc,
                      right: fold_list(
                        xs: tails,
                        empty: std.algebra.Empty,
                        cons: fn(inner, t) { list_snoc_item(xs: inner, item: Cons { head: h, tail: t }) }
                      )
                    )
                  }
                )
              }
          }
      }
    Nonterminal { production: name } =>
      if symbol_list_contains(xs: visiting, item: name) {
        Absent
      } else {
        match map_lookup(m: ctx.productions, key: name) {
          Present { value: p } =>
            lookahead_guard_strings(expr: lookahead_production_expression(p: p), visiting: Cons { head: name, tail: visiting }, ctx: ctx)
          Absent => Absent
        }
      }
    Optional { element: _ } => Absent
    Repeat { element: _ } => Absent
    Expect { element: _, reason: _ } => Absent
    RefuseOnMatch { element: _, reason: _ } => Absent
    AfterLineBreak { element: _ } => Absent
    NotPredicate { element: _ } => Absent
  }
}

// A set of single tokens, each alternative consuming exactly one token.
fn lookahead_guard_token_set(expr: GrammarExpr, visiting: List<Symbol>, ctx: LookaheadContext) -> Optional<List<FirstKey>> {
  match expr {
    Terminal { token_class: c, stamp: _ } => Present { value: Cons { head: FirstAnyOfClass { token_class: c }, tail: std.algebra.Empty } }
    LiteralTerminal { token_class: c, lexeme: w } =>
      Present { value: Cons { head: FirstExactWord { token_class: c, lexeme: w }, tail: std.algebra.Empty } }
    Choice { left: left, right: right } =>
      match lookahead_guard_token_set(expr: left, visiting: visiting, ctx: ctx) {
        Absent => Absent
        Present { value: l } =>
          match lookahead_guard_token_set(expr: right, visiting: visiting, ctx: ctx) {
            Absent => Absent
            Present { value: r } => Present { value: list_append(left: l, right: r) }
          }
      }
    Nonterminal { production: name } =>
      if symbol_list_contains(xs: visiting, item: name) {
        Absent
      } else {
        match map_lookup(m: ctx.productions, key: name) {
          Present { value: p } =>
            lookahead_guard_token_set(expr: lookahead_production_expression(p: p), visiting: Cons { head: name, tail: visiting }, ctx: ctx)
          Absent => Absent
        }
      }
    Sequence { left: _, right: _ } => Absent
    Optional { element: _ } => Absent
    Repeat { element: _ } => Absent
    Expect { element: _, reason: _ } => Absent
    RefuseOnMatch { element: _, reason: _ } => Absent
    AfterLineBreak { element: _ } => Absent
    NotPredicate { element: _ } => Absent
  }
}

fn lookahead_subtract_guard(prefixes: LookaheadPrefixes, guard: GrammarExpr, ctx: LookaheadContext) -> LookaheadPrefixes {
  match prefixes {
    LookaheadUnknown => LookaheadUnknown
    LookaheadKnown { prefixes: ps } =>
      match lookahead_guard_strings(expr: guard, visiting: std.algebra.Empty, ctx: ctx) {
        Absent => LookaheadKnown { prefixes: ps }
        Present { value: strings } =>
          lookahead_attach_guards(
            prefixes: fold_list(
              xs: strings,
              empty: ps,
              cons: fn(acc, g) { lookahead_subtract_string(prefixes: acc, guard: g) }
            ),
            strings: strings
          )
      }
  }
}

fn lookahead_attach_guards(prefixes: List<LookaheadPrefix>, strings: List<List<FirstKey>>) -> LookaheadPrefixes {
  LookaheadKnown {
    prefixes: fold_list(
      xs: prefixes,
      empty: std.algebra.Empty,
      cons: fn(acc, p) {
        list_snoc_item(
          xs: acc,
          item: LookaheadPrefix {
            keys: lookahead_prefix_keys(p: p),
            complete: lookahead_prefix_complete(p: p),
            guards: list_append(left: lookahead_prefix_guards(p: p), right: strings)
          }
        )
      }
    )
  }
}

fn lookahead_subtract_string(prefixes: List<LookaheadPrefix>, guard: List<FirstKey>) -> List<LookaheadPrefix> {
  fold_list(
    xs: prefixes,
    empty: std.algebra.Empty,
    cons: fn(acc, p) {
      match lookahead_guard_coverage(keys: lookahead_prefix_keys(p: p), guard: guard) {
        GuardCoversAll => acc
        GuardCoversButOneWord { keys: narrowed } =>
          list_snoc_item(
            xs: acc,
            item: LookaheadPrefix { keys: narrowed, complete: lookahead_prefix_complete(p: p), guards: lookahead_prefix_guards(p: p) }
          )
        GuardMisses => list_snoc_item(xs: acc, item: p)
      }
    }
  )
}

// Every string the prefix denotes begins with the guard string (GuardCoversAll), or does so exactly
// when one class position holds one named word (GuardCoversButOneWord, that word excluded). A guard
// string longer than the prefix covers nothing the bounded walk can see.
fn lookahead_guard_coverage(keys: List<LookaheadKey>, guard: List<FirstKey>) -> GuardCoverage {
  match list_head(xs: guard) {
    HeadAbsent => GuardCoversAll
    HeadFound { value: g } =>
      match list_head(xs: keys) {
        HeadAbsent => GuardMisses
        HeadFound { value: k } =>
          lookahead_guard_coverage_at(
            key: k,
            guard_key: g,
            rest: lookahead_guard_coverage(keys: lookahead_list_rest(xs: keys), guard: lookahead_list_rest(xs: guard)),
            keys_rest: lookahead_list_rest(xs: keys)
          )
      }
  }
}

fn lookahead_list_rest<T>(xs: List<T>) -> List<T> {
  match list_tail(xs: xs) {
    TailFound { tail: rest } => rest
    TailAbsent => std.algebra.Empty
  }
}

fn lookahead_guard_coverage_at(key: LookaheadKey, guard_key: FirstKey, rest: GuardCoverage, keys_rest: List<LookaheadKey>) -> GuardCoverage {
  if lookahead_guard_key_covers(guard_key: guard_key, key: key.key) {
    match rest {
      GuardCoversAll => GuardCoversAll
      GuardCoversButOneWord { keys: narrowed } => GuardCoversButOneWord { keys: Cons { head: key, tail: narrowed } }
      GuardMisses => GuardMisses
    }
  } else {
    match lookahead_guard_word_of_class(guard_key: guard_key, key: key.key) {
      Absent => GuardMisses
      Present { value: word } =>
        match rest {
          GuardCoversAll =>
            GuardCoversButOneWord {
              keys: Cons {
                head: LookaheadKey { key: key.key, excluded: set_symbol_insert(s: key.excluded, item: word) },
                tail: keys_rest
              }
            }
          GuardCoversButOneWord { keys: _ } => GuardMisses
          GuardMisses => GuardMisses
        }
    }
  }
}

// The guard key matches every token the prefix key admits.
fn lookahead_guard_key_covers(guard_key: FirstKey, key: FirstKey) -> Bool {
  match guard_key {
    FirstAnyOfClass { token_class: gc } => first_key_class(key: key) == gc
    FirstExactWord { token_class: _, lexeme: _ } => first_key_eq(left: guard_key, right: key)
  }
}

// The guard names one word of a class the prefix admits whole.
fn lookahead_guard_word_of_class(guard_key: FirstKey, key: FirstKey) -> Optional<Symbol> {
  match guard_key {
    FirstAnyOfClass { token_class: _ } => Absent
    FirstExactWord { token_class: gc, lexeme: w } =>
      match key {
        FirstAnyOfClass { token_class: kc } => lookahead_word_if_same_class(word: w, guard_class: gc, key_class: kc)
        FirstExactWord { token_class: _, lexeme: _ } => Absent
      }
  }
}

fn lookahead_word_if_same_class(word: Symbol, guard_class: Symbol, key_class: Symbol) -> Optional<Symbol> {
  if guard_class == key_class { lookahead_word_present(word: word) } else { lookahead_word_absent() }
}

fn lookahead_word_present(word: Symbol) -> Optional<Symbol> { Present { value: word } }
fn lookahead_word_absent() -> Optional<Symbol> { Absent }

fn lookahead_key_excludes(key: LookaheadKey, other: FirstKey) -> Bool {
  match other {
    FirstExactWord { token_class: _, lexeme: w } => symbol_list_contains(xs: key.excluded, item: w)
    FirstAnyOfClass { token_class: _ } => false
  }
}

fn lookahead_key_overlaps(left: LookaheadKey, right: LookaheadKey) -> Bool {
  first_key_overlaps(left: left.key, right: right.key)
    && !lookahead_key_excludes(key: left, other: right.key)
    && !lookahead_key_excludes(key: right, other: left.key)
}

// Two prefixes overlap when every position both read could be one token. A shorter prefix overlaps
// any longer one it agrees with, so a short alternative is never proved disjoint by its brevity.
fn lookahead_prefix_keys_overlap(left: List<LookaheadKey>, right: List<LookaheadKey>) -> Bool {
  match list_head(xs: left) {
    HeadAbsent => true
    HeadFound { value: l } =>
      match list_head(xs: right) {
        HeadAbsent => true
        HeadFound { value: r } =>
          lookahead_key_overlaps(left: l, right: r)
            && lookahead_prefix_keys_overlap(left: lookahead_list_rest(xs: left), right: lookahead_list_rest(xs: right))
      }
  }
}

// One alternative's prefix is refused by the other's guard when a guard string covers it: every
// input that begins with the prefix begins with that string. This is the ruling's direction -- the
// guarded alternative fails on every input the other alternative's prefix denotes -- and it holds
// whatever length the guarded alternative's own prefix has.
fn lookahead_prefix_refused_by(prefix: LookaheadPrefix, guards: List<List<FirstKey>>) -> Bool {
  any(
    xs: guards,
    predicate: fn(g) {
      match lookahead_guard_coverage(keys: lookahead_prefix_keys(p: prefix), guard: g) {
        GuardCoversAll => true
        GuardCoversButOneWord { keys: _ } => false
        GuardMisses => false
      }
    }
  )
}

// The empty prefix (a nullable alternative) is the both-nullable row's question, not this one's, so
// it is not compared here -- exactly as the single-token FIRST check never counted it.
fn lookahead_prefix_pair_overlaps(left: LookaheadPrefix, right: LookaheadPrefix) -> Bool {
  !is_empty(xs: lookahead_prefix_keys(p: left))
    && !is_empty(xs: lookahead_prefix_keys(p: right))
    && lookahead_prefix_keys_overlap(left: lookahead_prefix_keys(p: left), right: lookahead_prefix_keys(p: right))
    && !lookahead_prefix_refused_by(prefix: left, guards: lookahead_prefix_guards(p: right))
    && !lookahead_prefix_refused_by(prefix: right, guards: lookahead_prefix_guards(p: left))
}

fn lookahead_alternatives_overlap(
  left: GrammarExpr,
  rest: List<GrammarExpr>,
  head_keys: List<FirstKey>,
  ctx: LookaheadContext
) -> Bool {
  let base = grammar_choice_lookahead_depth()
  match lookahead_alternatives_overlap_at(left: left, rest: rest, head_keys: head_keys, depth: base, ctx: ctx) {
    SiteDisjoint => false
    SiteUnknown => true
    SiteOverlaps { heads: heads, follow: follow } =>
      let guarded = fold_list(
        xs: Cons { head: left, tail: rest },
        empty: base,
        cons: fn(acc, alt) { lookahead_max_int(a: acc, b: lookahead_leading_guard_length(expr: alt, ctx: ctx)) }
      )
      let depth = lookahead_min_int(a: guarded, b: grammar_choice_lookahead_depth_cap())
      if depth > base {
        match lookahead_alternatives_overlap_at(left: left, rest: rest, head_keys: heads, depth: depth, ctx: lookahead_context_with_follow(ctx: ctx, follow: follow)) {
          SiteDisjoint => false
          SiteUnknown => true
          SiteOverlaps { heads: _, follow: _ } => true
        }
      } else {
        true
      }
  }
}

// A SITE'S READ AT ONE DEPTH, and the first and second tokens of the prefix pairs that overlapped
// there. A deeper read is restricted to them: a prefix whose first two tokens begin no overlapping
// pair cannot overlap at any greater depth, so walking its continuations changes no answer. Measured on
// the dag grammar, restarting the deeper read from the site's whole head set cost most of the
// grammar's preparation (the `expr` site re-walked every identifier-led binary expression).
type LookaheadSiteRead
  = SiteDisjoint
  | SiteOverlaps { heads: List<FirstKey>, follow: Optional<List<FirstKey>> }
  | SiteUnknown

fn lookahead_max_int(a: Int, b: Int) -> Int { if a > b { a } else { b } }

fn lookahead_min_int(a: Int, b: Int) -> Int { if a < b { a } else { b } }

// The longest string of an alternative's leading proved-plain guard; 0 when it has none.
fn lookahead_leading_guard_length(expr: GrammarExpr, ctx: LookaheadContext) -> Int {
  match expr {
    Sequence { left: left, right: _ } =>
      match lookahead_leading_guard(expr: left) {
        Present { value: guard } =>
          match lookahead_guard_strings(expr: guard, visiting: std.algebra.Empty, ctx: ctx) {
            Present { value: strings } =>
              fold_list(xs: strings, empty: 0, cons: fn(acc, g) { lookahead_max_int(a: acc, b: length(xs: g)) })
            Absent => 0
          }
        Absent => 0
      }
    Terminal { token_class: _, stamp: _ } => 0
    LiteralTerminal { token_class: _, lexeme: _ } => 0
    Nonterminal { production: _ } => 0
    Choice { left: _, right: _ } => 0
    Optional { element: _ } => 0
    Repeat { element: _ } => 0
    Expect { element: _, reason: _ } => 0
    RefuseOnMatch { element: _, reason: _ } => 0
    AfterLineBreak { element: _ } => 0
    NotPredicate { element: _ } => 0
  }
}

fn lookahead_alternatives_overlap_at(
  left: GrammarExpr,
  rest: List<GrammarExpr>,
  head_keys: List<FirstKey>,
  depth: Int,
  ctx: LookaheadContext
) -> LookaheadSiteRead {
  let restrict = Present { value: head_keys }
  let left_prefixes = lookahead_prefixes(expr: left, depth: depth, head_keys: restrict, visiting: std.algebra.Empty, ctx: ctx)
  let right_prefixes = fold_list(
    xs: rest,
    empty: lookahead_none(),
    cons: fn(acc, alt) {
      lookahead_union(
        left: acc,
        right: lookahead_prefixes(expr: alt, depth: depth, head_keys: restrict, visiting: std.algebra.Empty, ctx: ctx)
      )
    }
  )
  match left_prefixes {
    LookaheadUnknown => SiteUnknown
    LookaheadKnown { prefixes: l } =>
      match right_prefixes {
        LookaheadUnknown => SiteUnknown
        LookaheadKnown { prefixes: r } => lookahead_site_read_of(left: l, right: r)
      }
  }
}

fn lookahead_site_read_of(left: List<LookaheadPrefix>, right: List<LookaheadPrefix>) -> LookaheadSiteRead {
  let acc = fold_list(
    xs: left,
    empty: LookaheadOverlapAcc { heads: grammar_empty_terminal_list(), follow: grammar_empty_terminal_list(), bounded: true },
    cons: fn(outer, l) {
      fold_list(
        xs: right,
        empty: outer,
        cons: fn(inner, r) {
          if lookahead_prefix_pair_overlaps(left: l, right: r) {
            lookahead_overlap_add(acc: lookahead_overlap_add(acc: inner, prefix: l), prefix: r)
          } else {
            inner
          }
        }
      )
    }
  )
  lookahead_site_read_of_acc(acc: acc)
}

// The first and second tokens of the overlapping prefixes. A prefix shorter than two leaves the
// second position unrestricted (`bounded` false): a deeper read may not narrow it.
type LookaheadOverlapAcc {
  heads: List<FirstKey>
  follow: List<FirstKey>
  bounded: Bool
}

fn lookahead_site_read_of_acc(acc: LookaheadOverlapAcc) -> LookaheadSiteRead {
  if is_empty(xs: acc.heads) {
    SiteDisjoint
  } else {
    SiteOverlaps { heads: acc.heads, follow: if acc.bounded { lookahead_keys_restricted(keys: acc.follow) } else { lookahead_keys_unrestricted() } }
  }
}

fn lookahead_keys_restricted(keys: List<FirstKey>) -> Optional<List<FirstKey>> { Present { value: keys } }

fn lookahead_overlap_add(acc: LookaheadOverlapAcc, prefix: LookaheadPrefix) -> LookaheadOverlapAcc {
  let keys = lookahead_prefix_keys(p: prefix)
  let heads = match list_head(xs: keys) {
    HeadFound { value: k } => first_list_union(left: acc.heads, right: Cons { head: lookahead_key_first(key: k), tail: std.algebra.Empty })
    HeadAbsent => acc.heads
  }
  match list_at_optional(xs: keys, index: 1) {
    Present { value: second } =>
      LookaheadOverlapAcc {
        heads: heads,
        follow: first_list_union(left: acc.follow, right: Cons { head: lookahead_key_first(key: second), tail: std.algebra.Empty }),
        bounded: acc.bounded
      }
    Absent => LookaheadOverlapAcc { heads: heads, follow: acc.follow, bounded: false }
  }
}

fn lookahead_key_first(key: LookaheadKey) -> FirstKey { key.key }

fn ordered_backtrack_row(
  production: Symbol,
  alts: List<PreparedExprFold>
) -> GrammarChoiceAmbiguityRow {
  let empty_first = GrammarExprFirstFold { terminals: grammar_empty_terminal_list(), nullable: false }
  let left = match list_head(xs: alts) {
    HeadFound { value: alt } => prepared_expr_fold_first(alt: alt)
    HeadAbsent => empty_first
  }
  let right = match list_tail(xs: alts) {
    TailFound { tail: rest } => choice_alts_union_first_from(alts: rest, acc: empty_first)
    TailAbsent => empty_first
  }
  GrammarChoiceAmbiguityRow {
    production: production,
    left_first_terminals: first_keys_classes(keys: left.terminals),
    right_first_terminals: first_keys_classes(keys: right.terminals),
    overlap_terminals: first_keys_classes(keys: first_list_intersect(left: left.terminals, right: right.terminals)),
    both_nullable: left.nullable && right.nullable
  }
}

fn ordered_backtrack_emit(alts: List<PreparedExprFold>) -> PreparedChoicePlan {
  ChoiceOrderedBacktrack { alternatives: choice_alt_trees(alts: alts) }
}

// A ROW STANDS UNLESS THE DECLARED LOOKAHEAD PROVES THE ALTERNATIVES DISJOINT. The single-token
// overlap is the candidate; a candidate is dropped only when the k-prefix sets of the alternative
// and of the alternatives after it share no prefix (lookahead_alternatives_overlap). Every arm of
// that proof that cannot decide answers "overlap", so the proof can remove a row and never adds
// a route: a guard that does not cover keeps its row, and an ordering never stands for a proof.
fn authored_choice_site_residue(
  alts: List<PreparedExprFold>,
  raw_alts: List<GrammarExpr>,
  production: Symbol,
  ctx: LookaheadContext
) -> List<GrammarChoiceAmbiguityRow> {
  match list_tail(xs: alts) {
    TailAbsent => std.algebra.Empty
    TailFound { tail: rest } =>
      if is_empty(xs: rest) {
        std.algebra.Empty
      } else {
        let row = ordered_backtrack_row(production: production, alts: alts)
        let raw_rest = match list_tail(xs: raw_alts) {
          TailFound { tail: r } => r
          TailAbsent => std.algebra.Empty
        }
        let stands = row.both_nullable || (
          !is_empty(xs: row.overlap_terminals)
            && lookahead_site_overlaps(alts: alts, raw_alts: raw_alts, raw_rest: raw_rest, ctx: ctx)
        )
        let here = if stands {
          Cons { head: row, tail: std.algebra.Empty }
        } else {
          std.algebra.Empty
        }
        list_append(
          left: here,
          right: authored_choice_site_residue(alts: rest, raw_alts: raw_rest, production: production, ctx: ctx)
        )
      }
  }
}

fn lookahead_site_overlaps(
  alts: List<PreparedExprFold>,
  raw_alts: List<GrammarExpr>,
  raw_rest: List<GrammarExpr>,
  ctx: LookaheadContext
) -> Bool {
  let empty_first = GrammarExprFirstFold { terminals: grammar_empty_terminal_list(), nullable: false }
  let left_first = match list_head(xs: alts) {
    HeadFound { value: alt } => prepared_expr_fold_first(alt: alt)
    HeadAbsent => empty_first
  }
  let right_first = match list_tail(xs: alts) {
    TailFound { tail: rest } => choice_alts_union_first_from(alts: rest, acc: empty_first)
    TailAbsent => empty_first
  }
  match list_head(xs: raw_alts) {
    HeadAbsent => true
    HeadFound { value: left } =>
      lookahead_alternatives_overlap(
        left: left,
        rest: raw_rest,
        head_keys: first_list_intersect(left: left_first.terminals, right: right_first.terminals),
        ctx: ctx
      )
  }
}

fn compile_choice_alts(
  alts: List<PreparedExprFold>,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>,
  token_dispatch: Bool
) -> PreparedChoicePlan {
  match length(xs: alts) {
    0 => ChoiceReject
    1 =>
      match list_head(xs: alts) {
        HeadFound { value: alt } =>
          ChoiceParseOne { expr: prepared_expr_fold_tree(alt: alt) }
        HeadAbsent => ChoiceReject
      }
    _ =>
      match list_head(xs: alts) {
        HeadAbsent => ChoiceReject
        HeadFound { value: first_alt } =>
          match prepared_sequence_left_atom(expr: prepared_expr_fold_tree(alt: first_alt)) {
            Present { value: prefix } =>
              match choice_shared_prefix_suffixes(
                alts: alts,
                prefix: prefix,
                nullable_set: nullable_set,
                first_rows: first_rows
              ) {
                Present { value: suffixes } =>
                  ChoiceSharedPrefix {
                    prefix: prefix,
                    suffix: compile_choice_plan(
                      alts: suffixes,
                      nullable_set: nullable_set,
                      first_rows: first_rows,
                      token_dispatch: token_dispatch
                    )
                  }
                Absent =>
                  match choice_token_prefix_rows(alts: alts, need: 2) {
                    Present { value: rows } => ChoiceTokenPrefix { rows: rows }
                    Absent => ordered_backtrack_emit(alts: alts)
                  }
              }
            Absent =>
              match choice_token_prefix_rows(alts: alts, need: 2) {
                Present { value: rows } => ChoiceTokenPrefix { rows: rows }
                Absent => ordered_backtrack_emit(alts: alts)
              }
          }
      }
  }
}

// The exact words of one class that some alternative starts with, in authored order, deduplicated.
fn class_bucket_words(alts: List<PreparedExprFold>, token_class: Symbol) -> List<Symbol> {
  fold_list(xs: alts, empty: empty_symbol_list(), cons: fn(acc, alt) {
    fold_list(xs: prepared_expr_fold_first(alt: alt).terminals, empty: acc, cons: fn(acc2, k) {
      match k {
        FirstExactWord { token_class: c, lexeme: w } =>
          if c == token_class { set_symbol_insert(s: acc2, item: w) } else { acc2 }
        FirstAnyOfClass { token_class: _ } => acc2
      }
    })
  })
}

// Alternatives in the bucket that can start on `word` of this class, or match empty.
fn class_bucket_alts_for_word(alts: List<PreparedExprFold>, token_class: Symbol, word: String) -> List<PreparedExprFold> {
  filter(xs: alts, predicate: fn(alt) {
    let first = prepared_expr_fold_first(alt: alt)
    first.nullable || any(xs: first.terminals, predicate: fn(k) {
      first_key_admits_word(key: k, token_class: token_class, word: word)
    })
  })
}

// Alternatives in the bucket that can start on ANY word of this class, or match empty.
fn class_bucket_alts_for_other(alts: List<PreparedExprFold>, token_class: Symbol) -> List<PreparedExprFold> {
  filter(xs: alts, predicate: fn(alt) {
    let first = prepared_expr_fold_first(alt: alt)
    first.nullable || any(xs: first.terminals, predicate: fn(k) {
      first_key_eq(left: k, right: FirstAnyOfClass { token_class: token_class })
    })
  })
}

// One token-class bucket. With no exact word in it, this is compile_choice_alts unchanged, so a
// grammar with no LiteralTerminal compiles exactly the plan it compiled before.
fn compile_class_bucket(
  alts: List<PreparedExprFold>,
  token_class: Symbol,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>,
  token_dispatch: Bool
) -> PreparedChoicePlan {
  let words = class_bucket_words(alts: alts, token_class: token_class)
  if is_empty(xs: words) {
    compile_choice_alts(alts: alts, nullable_set: nullable_set, first_rows: first_rows, token_dispatch: token_dispatch)
  } else {
    ChoiceByWord {
      on_word: fold_list(xs: words, empty: empty_map(), cons: fn(acc, w) {
        let word = symbol_lexeme(sym: w)
        map_insert(
          m: acc,
          key: word,
          value: compile_choice_alts(
            alts: class_bucket_alts_for_word(alts: alts, token_class: token_class, word: word),
            nullable_set: nullable_set,
            first_rows: first_rows,
            token_dispatch: token_dispatch
          )
        )
      }),
      on_other: compile_choice_alts(
        alts: class_bucket_alts_for_other(alts: alts, token_class: token_class),
        nullable_set: nullable_set,
        first_rows: first_rows,
        token_dispatch: token_dispatch
      )
    }
  }
}

fn compile_choice_plan(
  alts: List<PreparedExprFold>,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>,
  token_dispatch: Bool
) -> PreparedChoicePlan {
  if token_dispatch {
      let universe = choice_alts_terminal_universe(alts: alts)
      let on_token = fold_list(
        xs: universe,
        empty: empty_map(),
        cons: fn(acc, token_class) {
          map_insert(
            m: acc,
            key: token_class,
            value: compile_class_bucket(
              alts: choice_alts_for_present_token(alts: alts, token_class: token_class),
              token_class: token_class,
              nullable_set: nullable_set,
              first_rows: first_rows,
              token_dispatch: token_dispatch
            )
          )
        }
      )
      let on_nullable = compile_choice_alts(
        alts: choice_alts_nullable(alts: alts),
        nullable_set: nullable_set,
        first_rows: first_rows,
        token_dispatch: token_dispatch
      )
      ChoiceByToken {
        on_token: on_token,
        on_other: on_nullable,
        on_end: on_nullable
      }
  } else {
    ordered_backtrack_emit(alts: alts)
  }
}

fn prepare_grammar_expr(
  expr: GrammarExpr,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>,
  productions: Map<Symbol, GrammarProduction>,
  production: Symbol,
  token_dispatch: Bool
) -> PreparedExprFold {
  match expr {
    Terminal { token_class: token_class, stamp: stamp } =>
      PreparedExprFold {
        tree: PreparedTerminal { token_class: token_class, stamp: stamp },
        first: expr_first_fold_terminal(token_class: token_class),
        residue: std.algebra.Empty
      }
    LiteralTerminal { token_class: token_class, lexeme: lexeme } =>
      PreparedExprFold {
        tree: PreparedLiteralTerminal { token_class: token_class, lexeme: lexeme },
        first: expr_first_fold_literal(token_class: token_class, lexeme: lexeme),
        residue: std.algebra.Empty
      }
    Nonterminal { production: production_name } =>
      PreparedExprFold {
        tree: PreparedNonterminal { production: production_name },
        first: expr_first_fold_nonterminal(name: production_name, nullable_set: nullable_set, first_rows: first_rows),
        residue: std.algebra.Empty
      }
    Sequence { left: left, right: right } =>
      let left_prepared = prepare_grammar_expr(expr: left, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
      let right_prepared = prepare_grammar_expr(expr: right, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
      PreparedExprFold {
        tree: PreparedSequence { left: left_prepared.tree, right: right_prepared.tree },
        first: expr_first_fold_sequence(left: left_prepared.first, right: right_prepared.first),
        residue: list_append(left: left_prepared.residue, right: right_prepared.residue)
      }
    Choice { left: left, right: right } =>
      let alts = flatten_choice_exprs(expr: Choice { left: left, right: right })
      let prepared_alts = fold_list(
        xs: alts,
        empty: std.algebra.Empty,
        cons: fn(acc, alt) {
          list_snoc_item(
            xs: acc,
            item: prepare_grammar_expr(expr: alt, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
          )
        }
      )
      let compiled = compile_choice_plan(
        alts: prepared_alts,
        nullable_set: nullable_set,
        first_rows: first_rows,
        token_dispatch: token_dispatch
      )
      let union_first = choice_alts_union_first(alts: prepared_alts)
      PreparedExprFold {
        tree: PreparedChoice {
          plan: compiled,
          first: union_first
        },
        first: union_first,
        residue: list_append(
          left: concat_prepared_alt_residue(alts: prepared_alts),
          right: authored_choice_site_residue(
            alts: prepared_alts,
            raw_alts: alts,
            production: production,
            ctx: LookaheadContext { productions: productions, nullable_set: nullable_set, first_rows: first_rows, honour_guards: true, follow: Absent }
          )
        )
      }
    Optional { element: element } =>
      let element_prepared = prepare_grammar_expr(expr: element, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
      PreparedExprFold {
        tree: PreparedOptional { element: element_prepared.tree },
        first: expr_first_fold_optional(element: element_prepared.first),
        residue: element_prepared.residue
      }
    Repeat { element: element } =>
      let element_prepared = prepare_grammar_expr(expr: element, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
      PreparedExprFold {
        tree: PreparedRepeat { element: element_prepared.tree },
        first: expr_first_fold_repeat(element: element_prepared.first),
        residue: element_prepared.residue
      }
    Expect { element: element, reason: reason } =>
      let element_prepared = prepare_grammar_expr(expr: element, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
      PreparedExprFold {
        tree: PreparedExpect { element: element_prepared.tree, reason: reason },
        first: element_prepared.first,
        residue: element_prepared.residue
      }
    RefuseOnMatch { element: element, reason: reason } =>
      let element_prepared = prepare_grammar_expr(expr: element, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
      PreparedExprFold {
        tree: PreparedRefuseOnMatch { element: element_prepared.tree, reason: reason },
        first: element_prepared.first,
        residue: element_prepared.residue
      }
    AfterLineBreak { element: element } =>
      let element_prepared = prepare_grammar_expr(expr: element, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
      PreparedExprFold {
        tree: PreparedAfterLineBreak { element: element_prepared.tree },
        first: element_prepared.first,
        residue: element_prepared.residue
      }
    NotPredicate { element: element } =>
      let element_prepared = prepare_grammar_expr(expr: element, nullable_set: nullable_set, first_rows: first_rows, productions: productions, production: production, token_dispatch: token_dispatch)
      PreparedExprFold {
        tree: PreparedNotPredicate { element: element_prepared.tree, first: element_prepared.first },
        first: expr_first_fold_predicate(),
        residue: element_prepared.residue
      }
  }
}

fn parse_table_token_dispatch(table: ParseTable, production: Symbol) -> Bool {
  match map_lookup(m: table.first_rows, key: production) {
    Present { value: _ } => true
    Absent => false
  }
}

// The on-the-fly arm for tables whose analysis did not carry prepared trees
// (`parse_table_empty` and test-built tables). Token dispatch is compiled only when
// this production is a key in `first_rows`. An empty map is not "every nonterminal
// has empty FIRST / not nullable" — that would mint `ChoiceByToken { on_token: {},
// on_other: ChoiceReject }` and reject NT-headed Choice with empty diagnostics.
// When the key is absent the Choice plan is ordered backtrack, the pre-cutover
// interpreter. Analyzed tables always resolve Present here.
fn parse_table_prepared_expr(table: ParseTable, production: GrammarProduction) -> PreparedGrammarExpr {
  match v2.std.collection.map_get(m: table.prepared_exprs, key: production.name) {
    Accepted { value: Present { value: prepared }, diagnostics: _ } => prepared
    Accepted { value: Absent, diagnostics: _ } =>
      prepare_grammar_expr(
        expr: production.expression,
        nullable_set: table.nullable_set,
        first_rows: table.first_rows,
        productions: empty_map(),
        production: production.name,
        token_dispatch: parse_table_token_dispatch(table: table, production: production.name)
      ).tree
    Rejected { diagnostics: _ } =>
      prepare_grammar_expr(
        expr: production.expression,
        nullable_set: table.nullable_set,
        first_rows: table.first_rows,
        productions: empty_map(),
        production: production.name,
        token_dispatch: parse_table_token_dispatch(table: table, production: production.name)
      ).tree
  }
}

type AnalysisPrepAcc {
  prepared_exprs: Map<Symbol, PreparedGrammarExpr>
  residue: List<GrammarChoiceAmbiguityRow>
}

fn compute_grammar_first_analysis_given(
  root: GrammarRoot,
  nullable_set: List<Symbol>
) -> GrammarFirstAnalysis {
  let first_rows = compute_production_first_rows(root: root, nullable_set: nullable_set)
  let productions = grammar_production_index(productions: root.productions)
  let prep = fold_list(
    xs: root.productions,
    empty: AnalysisPrepAcc { prepared_exprs: empty_map(), residue: std.algebra.Empty },
    cons: fn(acc, p) {
      let folded = prepare_grammar_expr(
        expr: p.expression,
        nullable_set: nullable_set,
        first_rows: first_rows,
        productions: productions,
        production: p.name,
        token_dispatch: true
      )
      AnalysisPrepAcc {
        prepared_exprs: map_insert(m: acc.prepared_exprs, key: p.name, value: folded.tree),
        residue: list_append(left: acc.residue, right: folded.residue)
      }
    }
  )
  GrammarFirstAnalysis {
    nullable_set: nullable_set,
    first_rows: first_rows,
    prepared_exprs: prep.prepared_exprs,
    grammar_digest: parse_grammar_digest(validated: ValidatedGrammarRoot { root: root }),
    productions_by_name: productions,
    choice_residue: prep.residue,
    memo_recurrence: parse_memo_recurrence_census(root: root, nullable_set: nullable_set)
  }
}

// THE PARSE MEMO'S DEMAND CASE, READ OFF THE GRAMMAR ONCE PER PREPARATION. The meaning of both
// counts, and why they are the whole of within-parse recurrence, is stated on
// v2.compiler.materialization_carriers ParseMemoRecurrence. This fold only reads the structure:
// a site is DISCARDING when the branch it may abandon -- a Choice's left, an Optional's or a
// Repeat's element -- demands a nonterminal, since only an abandoned nonterminal demand can be
// asked again at the position the parse resumes from.
type ParseDemandFold {
  demands_nonterminal: Bool
  discarding_sites: Int
}

fn parse_demand_fold_site(attempted: ParseDemandFold) -> Int {
  if attempted.demands_nonterminal { 1 } else { 0 }
}

fn parse_demand_fold_leaf() -> ParseDemandFold {
  ParseDemandFold { demands_nonterminal: false, discarding_sites: 0 }
}

fn expr_parse_demand_fold(expr: GrammarExpr) -> ParseDemandFold {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_, _) { parse_demand_fold_leaf() },
      literal_terminal: fn(_, _) { parse_demand_fold_leaf() },
      nonterminal: fn(_) { ParseDemandFold { demands_nonterminal: true, discarding_sites: 0 } },
      sequence: fn(l, r) {
        ParseDemandFold {
          demands_nonterminal: l.demands_nonterminal || r.demands_nonterminal,
          discarding_sites: l.discarding_sites + r.discarding_sites
        }
      },
      choice: fn(l, r) {
        ParseDemandFold {
          demands_nonterminal: l.demands_nonterminal || r.demands_nonterminal,
          discarding_sites: l.discarding_sites + r.discarding_sites + parse_demand_fold_site(attempted: l)
        }
      },
      optional: fn(e) {
        ParseDemandFold {
          demands_nonterminal: e.demands_nonterminal,
          discarding_sites: e.discarding_sites + parse_demand_fold_site(attempted: e)
        }
      },
      repeat: fn(e) {
        ParseDemandFold {
          demands_nonterminal: e.demands_nonterminal,
          discarding_sites: e.discarding_sites + parse_demand_fold_site(attempted: e)
        }
      },
      expect: fn(e, _reason) { e },
      refuse_on_match: fn(e, _reason) { e },
      after_line_break: fn(e) { e },
      not_predicate: fn(e) {
        ParseDemandFold {
          demands_nonterminal: e.demands_nonterminal,
          discarding_sites: e.discarding_sites + parse_demand_fold_site(attempted: e)
        }
      }
    }
  )
}

fn parse_memo_recurrence_census(root: GrammarRoot, nullable_set: List<Symbol>) -> ParseMemoRecurrence {
  ParseMemoRecurrence {
    discarding_backtrack_sites: fold_list(
      xs: root.productions,
      empty: 0,
      cons: fn(acc, p) { acc + expr_parse_demand_fold(expr: p.expression).discarding_sites }
    ),
    nullable_nonterminals: length(xs: nullable_set)
  }
}

fn compute_grammar_first_analysis(root: GrammarRoot) -> GrammarFirstAnalysis {
  compute_grammar_first_analysis_given(root: root, nullable_set: compute_nullable_set(root: root))
}

fn grammar_choice_ambiguity_roster_from_analysis(
  root: GrammarRoot,
  analysis: GrammarFirstAnalysis
) -> List<GrammarChoiceAmbiguityRow> {
  analysis.choice_residue
}

fn grammar_choice_ambiguity_roster(root: GrammarRoot) -> List<GrammarChoiceAmbiguityRow> {
  grammar_choice_ambiguity_roster_from_analysis(
    root: root,
    analysis: compute_grammar_first_analysis(root: root)
  )
}

fn grammar_has_choice_ambiguity(root: GrammarRoot) -> Bool {
  !is_empty(xs: grammar_choice_ambiguity_roster(root: root))
}

fn grammar_choice_ambiguity_count(root: GrammarRoot) -> Int {
  length(xs: grammar_choice_ambiguity_roster(root: root))
}

fn parse_grammar_choice_ambiguity_diagnostic(at: Locus, count: Int) -> Diagnostic {
  Diagnostic {
    reason: ^parse_grammar_choice_ambiguity,
    at: port_refusal_locus(at: at, port: ^parse_stage_locus_port, invariant: ^parse_grammar_choice_ambiguity),
    correction: match count > 0 {
      true => Unavailable { reason: ExternalContractUnknown }
      false => Unavailable { reason: UserInputBoundary }
    }
  }
}

fn parse_grammar_choice_ambiguity_row_diagnostic(at: Locus, row: GrammarChoiceAmbiguityRow) -> Diagnostic {
  let overlap_count = length(xs: row.overlap_terminals)
  parse_grammar_choice_ambiguity_diagnostic(
    at: at,
    count: if row.both_nullable && overlap_count == 0 { 1 } else { overlap_count }
  )
}

fn grammar_choice_ambiguity_row_diagnostic_list(
  at: Locus,
  roster: List<GrammarChoiceAmbiguityRow>
) -> List<Diagnostic> {
  fold_list(
    xs: roster,
    empty: std.algebra.Empty,
    cons: fn(acc, row) {
      list_snoc_item(
        xs: acc,
        item: parse_grammar_choice_ambiguity_row_diagnostic(at: at, row: row)
      )
    }
  )
}

fn grammar_choice_ambiguity_rejection_diagnostics(
  at: Locus,
  roster: List<GrammarChoiceAmbiguityRow>
) -> NonEmptyDiagnostics {
  parse_diags_to_non_empty(
    diags: grammar_choice_ambiguity_row_diagnostic_list(at: at, roster: roster),
    default: parse_grammar_choice_ambiguity_diagnostic(
      at: at,
      count: length(xs: roster)
    )
  )
}

fn grammar_empty_corner_list() -> List<Symbol> {
  std.algebra.Empty
}

fn expr_corner_fold_terminal(_: Symbol) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: std.algebra.Empty, nullable: false }
}

fn expr_corner_fold_nonterminal(name: Symbol, nullable_set: List<Symbol>) -> GrammarExprCornerFold {
  GrammarExprCornerFold {
    corners: Cons { head: name, tail: std.algebra.Empty },
    nullable: symbol_list_contains(xs: nullable_set, item: name)
  }
}

fn expr_corner_fold_sequence(
  left_fold: GrammarExprCornerFold,
  right_fold: GrammarExprCornerFold
) -> GrammarExprCornerFold {

  GrammarExprCornerFold {
    corners: list_append(
      left: left_fold.corners,
      right: if left_fold.nullable {
        right_fold.corners
      } else {
        grammar_empty_corner_list()
      }
    ),
    nullable: left_fold.nullable && right_fold.nullable
  }
}

fn expr_corner_fold_choice(
  left_fold: GrammarExprCornerFold,
  right_fold: GrammarExprCornerFold
) -> GrammarExprCornerFold {
  GrammarExprCornerFold {
    corners: list_append(left: left_fold.corners, right: right_fold.corners),
    nullable: left_fold.nullable || right_fold.nullable
  }
}

fn expr_corner_fold_optional(element_fold: GrammarExprCornerFold) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: element_fold.corners, nullable: true }
}

fn expr_corner_fold_repeat(element_fold: GrammarExprCornerFold) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: element_fold.corners, nullable: true }
}

fn expr_corner_nullable_fold(expr: GrammarExpr, nullable_set: List<Symbol>) -> GrammarExprCornerFold {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, _) { expr_corner_fold_terminal(token_class) },
      literal_terminal: fn(token_class, _) { expr_corner_fold_terminal(token_class) },
      nonterminal: fn(name) { expr_corner_fold_nonterminal(name: name, nullable_set: nullable_set) },
      sequence: expr_corner_fold_sequence,
      choice: expr_corner_fold_choice,
      optional: expr_corner_fold_optional,
      repeat: expr_corner_fold_repeat,
      expect: fn(element, _reason) { element },
      refuse_on_match: fn(element, _reason) { element },
      after_line_break: fn(element) { element },
      not_predicate: expr_corner_fold_optional
    }
  )
}

fn expr_direct_left_corner_list(expr: GrammarExpr, nullable_set: List<Symbol>) -> List<Symbol> {
  expr_corner_nullable_fold(expr: expr, nullable_set: nullable_set).corners
}

fn left_corner_list_union(left: List<Symbol>, right: List<Symbol>) -> List<Symbol> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, name) {
      if contains(xs: acc, item: name, eq: fn(a, b) { a == b }) {
        acc
      } else {
        list_snoc_item(xs: acc, item: name)
      }
    }
  )
}

// ONE RELATION, NOT ONE CLOSURE PER PRODUCTION.
//
// Left recursion asks, of every production, whether it is reachable from itself through left
// corners. That is ONE reachability relation over the grammar, and every production's answer is a
// lookup in it. The previous form asked the question 38 separate times on the live `.dag` grammar
// — a complete transitive closure rebuilt from scratch per production, each running a fixed number
// of rounds with no convergence check, and each step re-finding a production by filtering the whole
// list. Measured, that was 7272ms of an 11.7s grammar preparation, and the preparation runs on
// every parse.
//
// The rows below are seeded with each production's DIRECT left corners and then expanded to their
// fixpoint. The result per production is the same set the per-production closure produced — the
// transitive closure of the same edge relation — so this is the identical question asked once.
fn left_corner_direct_rows(root: GrammarRoot, nullable_set: List<Symbol>) -> Map<Symbol, List<Symbol>> {
  fold_list(
    xs: root.productions,
    empty: empty_map(),
    cons: fn(acc, p) {
      map_insert(
        m: acc,
        key: p.name,
        value: expr_direct_left_corner_list(expr: p.expression, nullable_set: nullable_set)
      )
    }
  )
}

fn left_corner_row(rows: Map<Symbol, List<Symbol>>, name: Symbol) -> List<Symbol> {
  match v2.std.collection.map_get(m: rows, key: name) {
    Accepted { value: Present { value: reached }, diagnostics: _ } => reached
    Accepted { value: Absent, diagnostics: _ } => std.algebra.Empty
    Rejected { diagnostics: _ } => std.algebra.Empty
  }
}

fn left_corner_expand_row(
  rows: Map<Symbol, List<Symbol>>,
  reached: List<Symbol>
) -> List<Symbol> {
  fold_list(
    xs: reached,
    empty: reached,
    cons: fn(acc, sym) {
      left_corner_list_union(left: acc, right: left_corner_row(rows: rows, name: sym))
    }
  )
}

fn left_corner_round(
  root: GrammarRoot,
  rows: Map<Symbol, List<Symbol>>
) -> Map<Symbol, List<Symbol>> {
  fold_list(
    xs: root.productions,
    empty: rows,
    cons: fn(acc, p) {
      map_insert(
        m: acc,
        key: p.name,
        value: left_corner_expand_row(rows: acc, reached: left_corner_row(rows: acc, name: p.name))
      )
    }
  )
}

fn left_corner_total(root: GrammarRoot, rows: Map<Symbol, List<Symbol>>) -> Int {
  fold_list(
    xs: root.productions,
    empty: 0,
    cons: fn(acc, p) {
      acc + length(xs: left_corner_row(rows: rows, name: p.name))
    }
  )
}

fn left_corner_fixpoint(
  root: GrammarRoot,
  rows: Map<Symbol, List<Symbol>>,
  seen_total: Int,
  fuel: Int
) -> Map<Symbol, List<Symbol>> {
  if fuel == 0 {
    rows
  } else {
    let next = left_corner_round(root: root, rows: rows)
    let next_total = left_corner_total(root: root, rows: next)
    if next_total == seen_total {
      next
    } else {
      left_corner_fixpoint(root: root, rows: next, seen_total: next_total, fuel: fuel - 1)
    }
  }
}

fn left_corner_rows(root: GrammarRoot, nullable_set: List<Symbol>) -> Map<Symbol, List<Symbol>> {
  let seeded = left_corner_direct_rows(root: root, nullable_set: nullable_set)
  left_corner_fixpoint(
    root: root,
    rows: seeded,
    seen_total: left_corner_total(root: root, rows: seeded),
    fuel: length(xs: root.productions)
  )
}

// The nullable set is a parameter here because `grammar_validate_and_analyze` already computes it
// for the FIRST analysis: the previous shape recomputed it inside this check, so one preparation
// paid for the same fixpoint three times over.
fn grammar_has_left_recursion_given(root: GrammarRoot, nullable_set: List<Symbol>) -> Bool {
  let rows = left_corner_rows(root: root, nullable_set: nullable_set)
  any(
    xs: root.productions,
    predicate: fn(p) {
      contains(
        xs: left_corner_row(rows: rows, name: p.name),
        item: p.name,
        eq: fn(a, b) { a == b }
      )
    }
  )
}

fn grammar_has_left_recursion(root: GrammarRoot) -> Bool {
  grammar_has_left_recursion_given(root: root, nullable_set: compute_nullable_set(root: root))
}

fn expr_has_undefined_nonterminal(expr: GrammarExpr, root: GrammarRoot) -> Bool {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_, _) { false },
      literal_terminal: fn(_, _) { false },
      nonterminal: fn(p) {
        match grammar_lookup_production(root: root, name: p) {
          Violates { diagnostic: _ } => true
          Holds { value: _ } => false
        }
      },
      sequence: fn(left_undef, right_undef) { left_undef || right_undef },
      choice: fn(left_undef, right_undef) { left_undef || right_undef },
      optional: fn(element_undef) { element_undef },
      repeat: fn(element_undef) { element_undef },
      expect: fn(element_undef, _reason) { element_undef },
      refuse_on_match: fn(element_undef, _reason) { element_undef },
      after_line_break: fn(element_undef) { element_undef },
      not_predicate: fn(element_undef) { element_undef }
    }
  )
}

fn grammar_has_undefined_nonterminals(root: GrammarRoot) -> Bool {
  match grammar_lookup_production(root: root, name: root.start) {
    Violates { diagnostic: _ } => true
    Holds { value: _ } =>
      any(
        xs: root.productions,
        predicate: fn(p) { expr_has_undefined_nonterminal(expr: p.expression, root: root) }
      )
  }
}

fn grammar_has_duplicate_productions(root: GrammarRoot) -> Bool {
  match unique(xs: root.productions, eq: fn(a, b) { a.name == b.name }) {
    true => false
    false => true
  }
}

fn parse_diag_cons(d: Diagnostic, acc: Diagnostics) -> Diagnostics {
  match acc {
    None => Some { diagnostics: NonEmptyDiagnostics { head: d, tail: [] } }
    Some { diagnostics: ned } =>
      Some {
        diagnostics: NonEmptyDiagnostics {
          head: d,
          tail: list_append(left: [ned.head], right: ned.tail)
        }
      }
  }
}

fn parse_diags_to_diagnostics(diags: List<Diagnostic>) -> Diagnostics {
  fold_list_right(xs: diags, empty: v2.std.diagnostic.None, snoc: fn(acc, d) { parse_diag_cons(d: d, acc: acc) })
}

fn parse_diags_to_non_empty(diags: List<Diagnostic>, default: Diagnostic) -> NonEmptyDiagnostics {
  match parse_diags_to_diagnostics(diags: diags) {
    None => NonEmptyDiagnostics { head: default, tail: [] }
    Some { diagnostics: ned } => ned
  }
}

fn grammar_nullable_ambiguity_rows(roster: List<GrammarChoiceAmbiguityRow>) -> List<GrammarChoiceAmbiguityRow> {
  filter(xs: roster, predicate: fn(row) { row.both_nullable })
}

fn parse_grammar_choice_overlap_residue_diagnostic(at: Locus, row: GrammarChoiceAmbiguityRow) -> Diagnostic {
  parse_stage_diagnostic_core(
    d: parse_overlap_residue_stage_diagnostic_at(at: at, row: row)
  )
}

fn diagnostics_from_diagnostic_list(items: List<Diagnostic>) -> Diagnostics {
  match list_at_optional(xs: items, index: 0) {
    Absent => None
    Present { value: first } =>
      match list_tail(xs: items) {
        TailAbsent => Some { diagnostics: NonEmptyDiagnostics { head: first, tail: std.algebra.Empty } }
        TailFound { tail: rest } =>
          Some { diagnostics: NonEmptyDiagnostics { head: first, tail: rest } }
      }
  }
}

fn grammar_overlap_residue_diagnostics(at: Locus, roster: List<GrammarChoiceAmbiguityRow>) -> Diagnostics {
  diagnostics_from_diagnostic_list(
    items: fold_list(
      xs: roster,
      empty: std.algebra.Empty,
      cons: fn(acc, row) {
        list_snoc_item(xs: acc, item: parse_grammar_choice_overlap_residue_diagnostic(at: at, row: row))
      }
    )
  )
}

// ONE nullable fixpoint for the whole preparation. The left-recursion check and the FIRST analysis
// both need the nullable set, and computing it here rather than inside each of them is the
// difference between one fixpoint per preparation and three.
fn grammar_validate_and_analyze(root: GrammarRoot, at: Locus) -> Outcome<PreparedModeledGrammar> {
  if grammar_has_undefined_nonterminals(root: root) {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_undefined_nonterminal_diagnostic(at: at)) }
  } else {
    if grammar_has_duplicate_productions(root: root) {
      Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_duplicate_production_diagnostic(at: at)) }
    } else {
      let nullable_set = compute_nullable_set(root: root)
      if grammar_has_left_recursion_given(root: root, nullable_set: nullable_set) {
        Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_left_recursive_diagnostic(at: at)) }
      } else {
        let analysis = compute_grammar_first_analysis_given(root: root, nullable_set: nullable_set)
        let ambiguity_roster = grammar_choice_ambiguity_roster_from_analysis(root: root, analysis: analysis)
        let nullable_rows = grammar_nullable_ambiguity_rows(roster: ambiguity_roster)
        if !is_empty(xs: nullable_rows) {
          Rejected {
            diagnostics: grammar_choice_ambiguity_rejection_diagnostics(at: at, roster: nullable_rows)
          }
        } else {
          Accepted {
            value: PreparedModeledGrammar {
              validated: ValidatedGrammarRoot { root: root },
              analysis: analysis,
              overlap_residue_stage: non_empty_parse_stage_diagnostics_from_overlap_roster(
                at: at,
                roster: ambiguity_roster
              )
            },
            diagnostics: grammar_overlap_residue_diagnostics(at: at, roster: ambiguity_roster)
          }
        }
      }
    }
  }
}

fn grammar_validate_for_parse(root: GrammarRoot, at: Locus) -> Outcome<ValidatedGrammarRoot> {
  match grammar_validate_and_analyze(root: root, at: at) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: modeled, diagnostics: residue } =>
      Accepted { value: modeled.validated, diagnostics: residue }
  }
}

fn parse_sync_step(acc: ParseSyncState, tok: Token, sync_tokens: List<Symbol>) -> ParseSyncState {
  match acc.found_sync {
    true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: acc.result, item: tok) }
    false =>
      match contains(xs: sync_tokens, item: tok.class, eq: fn(a, b) { a == b }) {
        true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: std.algebra.Empty, item: tok) }
        false => ParseSyncState { found_sync: false, result: std.algebra.Empty }
      }
  }
}

fn parse_skip_to_sync(tokens: List<Token>, sync_tokens: List<Symbol>) -> ParseSyncState {
  fold_list(
    xs: tokens,
    empty: ParseSyncState { found_sync: false, result: std.algebra.Empty },
    cons: fn(acc, tok) { parse_sync_step(acc: acc, tok: tok, sync_tokens: sync_tokens) }
  )
}

fn parse_token_first(tokens: List<Token>) -> Optional<Token> {
  match list_head(xs: tokens) {
    HeadFound { value: v } => Present { value: v }
    HeadAbsent => Absent
  }
}

fn parse_token_second(tokens: List<Token>) -> Optional<Token> {
  match list_tail(xs: tokens) {
    TailFound { tail: rest } => parse_token_first(tokens: rest)
    TailAbsent => Absent
  }
}

fn parse_token_at_optional(tokens: List<Token>, index: Int) -> Optional<Token> {
  parse_token_first(tokens: parse_tokens_drop(tokens: tokens, count: index))
}

fn parse_expr_terminal_stamped(
  tok: Token,
  stamp: TerminalStampMode,
  remaining: List<Token>,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  let stamped = parse_stamp_terminal(tok: tok, stamp: stamp, prov: prov)
  ParseExprAccepted {
    remaining: remaining,
    captured: stamped.node,
    diagnostics: [],
    prov: stamped.prov,
    table: table
  }
}

// A STRING VALUE CARRIES ITS DECODED VALUE (v2.extdeps.languages.dag
// dag_string_literal_node_from_lexeme), refusing located on an unframed lexeme or a malformed
// escape, exactly as the int-literal arm of parse_expr_terminal decodes its magnitude. Every string
// terminal is decoded here, whatever its stamp: a quoted field-init key is the class-stamped terminal
// of its own production (v2.extdeps.languages.dag dag_grammar_field_init_string_key_expr), so there is
// no spelling-stamped string terminal left to keep apart.
fn parse_expr_string_literal_value(
  tok: Token,
  remaining: List<Token>,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  let minted = parse_mint_from_source(
    prov: prov,
    file: tok.file,
    start: tok.start,
    end: tok.end
  )
  match dag_string_literal_node_from_lexeme(
    lexeme: tok.lexeme,
    occurrence_id: node_occurrence_identity_minted(id: minted.id)
  ) {
    Accepted { value: captured, diagnostics: _ } =>
      ParseExprAccepted {
        remaining: remaining,
        captured: captured,
        diagnostics: std.algebra.Empty,
        prov: minted.prov,
        table: table
      }
    Rejected { diagnostics: d } =>
      ParseExprRejected {
        diagnostics: parse_non_empty_diagnostics_to_list(ned: d),
        table: table
      }
  }
}

// THE INT-LITERAL WRAP IN THIS FUNCTION IS LOAD-BEARING. minted.id is a raw OccurrenceId;
// Node.occurrence_id is the NodeOccurrenceIdentity coproduct, so the mint has to be lifted into
// OccurrenceMinted before it can inhabit a Node. #8833 removed that lift, reading it as a spurious
// wrap against a callee that declared the raw type -- but the callee's declaration was the defect,
// and dropping the lift put a value outside the coproduct into every int-literal node the parser
// built, which the required floor reported as a non-exhaustive match at run time.
//
// The declaration-bound direct-call judgment now runs in v2.* callers and mechanically refuses
// the unwrapped form. Keep the explanation because the lift remains semantic rather than cosmetic;
// the former module-wide exemption that made this site review-only has been deleted.
fn parse_expr_terminal(
  token_class: Symbol,
  stamp: TerminalStampMode,
  tokens: List<Token>,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_token_first(tokens: tokens) {
    Absent => ParseExprRejected { diagnostics: [], table: table }
    Present { value: tok } =>
      match tok.class == token_class {
        true =>
          match list_tail(xs: tokens) {
            TailFound { tail: remaining } =>
              if token_class == ^dag_token_int_literal {
                let minted = parse_mint_from_source(
                  prov: prov,
                  file: tok.file,
                  start: tok.start,
                  end: tok.end
                )
                match dag_int_literal_node_from_lexeme(
                  lexeme: tok.lexeme,
                  occurrence_id: node_occurrence_identity_minted(id: minted.id)
                ) {
                  Accepted { value: captured, diagnostics: _ } =>
                    ParseExprAccepted {
                      remaining: remaining,
                      captured: captured,
                      diagnostics: std.algebra.Empty,
                      prov: minted.prov,
                      table: table
                    }
                  Rejected { diagnostics: d } =>
                    ParseExprRejected {
                      diagnostics: parse_non_empty_diagnostics_to_list(ned: d),
                      table: table
                    }
                }
              } else if token_class == ^dag_token_string_literal {
                parse_expr_string_literal_value(tok: tok, remaining: remaining, table: table, prov: prov)
              } else if token_class == ^dag_token_float_literal {
                let minted = parse_mint_from_source(
                  prov: prov,
                  file: tok.file,
                  start: tok.start,
                  end: tok.end
                )
                ParseExprAccepted {
                  remaining: remaining,
                  captured: dag_float_literal_node_from_lexeme(
                    lexeme: tok.lexeme,
                    occurrence_id: node_occurrence_identity_minted(id: minted.id)
                  ),
                  diagnostics: std.algebra.Empty,
                  prov: minted.prov,
                  table: table
                }
              } else {
                parse_expr_terminal_stamped(tok: tok, stamp: stamp, remaining: remaining, table: table, prov: prov)
              }
            TailAbsent => ParseExprRejected { diagnostics: [], table: table }
          }
        false => ParseExprRejected { diagnostics: [], table: table }
      }
  }
}

fn parse_expr_sequence(
  left: PreparedGrammarExpr,
  right: PreparedGrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(
    expr: left,
    tokens: tokens,
    all_tokens: all_tokens,
    root: root,
    table: table,
    prov: prov
  ) {
    ParseExprRejected { diagnostics: diags, table: table1 } =>
      ParseExprRejected { diagnostics: diags, table: table1 }
    ParseExprAccepted { remaining: rest1, captured: cap1, diagnostics: diags1, prov: prov1, table: table1 } =>
      match parse_expr_with_first(
        expr: right,
        tokens: rest1,
        all_tokens: all_tokens,
        root: root,
        table: table1,
        prov: prov1
      ) {
        ParseExprRejected { diagnostics: diags2, table: table2 } =>
          ParseExprRejected { diagnostics: list_append(left: diags1, right: diags2), table: table2 }
        ParseExprAccepted { remaining: rest2, captured: cap2, diagnostics: diags2, prov: prov2, table: table2 } =>
          let stamped = parse_sequence_capture(left: left, right: right, cap1: cap1, cap2: cap2, prov: prov2)
          ParseExprAccepted {
            remaining: rest2,
            captured: stamped.node,
            diagnostics: list_append(left: diags1, right: diags2),
            prov: stamped.prov,
            table: table2
          }
      }
  }
}

// A predicate side captured nothing (v2.std.grammar grammar_expr_not_predicate), so the sequence
// captures its other side; v2.std.grammar grammar_emit_sequence reads the same rule backward.
fn parse_sequence_capture(
  left: PreparedGrammarExpr,
  right: PreparedGrammarExpr,
  cap1: Node,
  cap2: Node,
  prov: ParseProvenanceState
) -> ParseStampResult {
  match left {
    PreparedNotPredicate { element: _, first: _ } => ParseStampResult { node: cap2, prov: prov }
    _ =>
      match right {
        PreparedNotPredicate { element: _, first: _ } => ParseStampResult { node: cap1, prov: prov }
        _ => parse_stamp_derived_conj(cap1: cap1, cap2: cap2, prov: prov)
      }
  }
}

fn parse_choice_ordered_backtrack(
  alternatives: List<PreparedGrammarExpr>,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match list_head(xs: alternatives) {
    HeadAbsent => ParseExprRejected { diagnostics: [], table: table }
    HeadFound { value: alt } =>
      match parse_expr_with_first(
        expr: alt,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      ) {
        ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 } =>
          ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 }
        ParseExprRejected { diagnostics: diags, table: table1 } =>
          match list_tail(xs: alternatives) {
            TailAbsent => ParseExprRejected { diagnostics: diags, table: table1 }
            TailFound { tail: rest_alts } =>
              parse_choice_ordered_backtrack(
                alternatives: rest_alts,
                tokens: tokens,
                all_tokens: all_tokens,
                root: root,
                table: table1,
                prov: prov
              )
          }
      }
  }
}

fn token_classes_take(tokens: List<Token>, need: Int) -> Optional<List<Symbol>> {
  if need == 0 {
    optional_present(value: std.algebra.Empty)
  } else {
    match parse_token_first(tokens: tokens) {
      Absent => optional_absent()
      Present { value: tok } =>
        match list_tail(xs: tokens) {
          TailAbsent =>
            if need == 1 {
              optional_present(value: Cons { head: tok.class, tail: std.algebra.Empty })
            } else {
              optional_absent()
            }
          TailFound { tail: rest } =>
            match token_classes_take(tokens: rest, need: need - 1) {
              Absent => optional_absent()
              Present { value: more } =>
                optional_present(value: Cons { head: tok.class, tail: more })
            }
        }
    }
  }
}

fn choice_token_prefix_select(rows: List<TokenPrefixRow>, prefix: List<Symbol>) -> Optional<PreparedChoicePlan> {
  match list_head(xs: rows) {
    HeadAbsent => optional_absent()
    HeadFound { value: row } =>
      if zip_eq(a: token_prefix_row_prefix(row: row), b: prefix, eq: fn(x, y) { x == y }) {
        optional_present(value: token_prefix_row_next(row: row))
      } else {
        match list_tail(xs: rows) {
          TailAbsent => optional_absent()
          TailFound { tail: rest } => choice_token_prefix_select(rows: rest, prefix: prefix)
        }
      }
  }
}

fn parse_choice_plan(
  plan: PreparedChoicePlan,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match plan {
    ChoiceReject => ParseExprRejected { diagnostics: [], table: table }
    ChoiceByWord { on_word: on_word, on_other: on_other } =>
      match parse_token_first(tokens: tokens) {
        Absent =>
          parse_choice_plan(plan: on_other, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
        Present { value: tok } =>
          match map_lookup(m: on_word, key: tok.lexeme) {
            Present { value: next } =>
              parse_choice_plan(plan: next, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
            Absent =>
              parse_choice_plan(plan: on_other, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
          }
      }
    ChoiceParseOne { expr: expr } =>
      parse_expr_with_first(
        expr: expr,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    ChoiceOrderedBacktrack { alternatives: alternatives } =>
      parse_choice_ordered_backtrack(
        alternatives: alternatives,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    ChoiceSharedPrefix { prefix: prefix, suffix: suffix } =>
      match parse_expr_with_first(
        expr: prefix,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      ) {
        ParseExprRejected { diagnostics: diags, table: table1 } =>
          ParseExprRejected { diagnostics: diags, table: table1 }
        ParseExprAccepted { remaining: rest, captured: cap_prefix, diagnostics: diags1, prov: prov1, table: table1 } =>
          match parse_choice_plan(
            plan: suffix,
            tokens: rest,
            all_tokens: all_tokens,
            root: root,
            table: table1,
            prov: prov1
          ) {
            ParseExprRejected { diagnostics: diags2, table: table2 } =>
              ParseExprRejected { diagnostics: list_append(left: diags1, right: diags2), table: table2 }
            ParseExprAccepted { remaining: rest2, captured: cap_suffix, diagnostics: diags2, prov: prov2, table: table2 } =>
              let stamped = parse_stamp_derived_conj(cap1: cap_prefix, cap2: cap_suffix, prov: prov2)
              ParseExprAccepted {
                remaining: rest2,
                captured: stamped.node,
                diagnostics: list_append(left: diags1, right: diags2),
                prov: stamped.prov,
                table: table2
              }
          }
      }
    ChoiceTokenPrefix { rows: rows } =>
      match list_head(xs: rows) {
        HeadAbsent => ParseExprRejected { diagnostics: [], table: table }
        HeadFound { value: first_row } =>
          match token_classes_take(tokens: tokens, need: length(xs: token_prefix_row_prefix(row: first_row))) {
            Absent => ParseExprRejected { diagnostics: [], table: table }
            Present { value: prefix } =>
              match choice_token_prefix_select(rows: rows, prefix: prefix) {
                Absent => ParseExprRejected { diagnostics: [], table: table }
                Present { value: next_plan } =>
                  parse_choice_plan(
                    plan: next_plan,
                    tokens: tokens,
                    all_tokens: all_tokens,
                    root: root,
                    table: table,
                    prov: prov
                  )
              }
          }
      }
    ChoiceByToken { on_token: on_token, on_other: on_other, on_end: on_end } =>
      match parse_token_first(tokens: tokens) {
        Absent =>
          parse_choice_plan(
            plan: on_end,
            tokens: tokens,
            all_tokens: all_tokens,
            root: root,
            table: table,
            prov: prov
          )
        Present { value: tok } =>
          match map_lookup(m: on_token, key: tok.class) {
            Present { value: next } =>
              parse_choice_plan(
                plan: next,
                tokens: tokens,
                all_tokens: all_tokens,
                root: root,
                table: table,
                prov: prov
              )
            Absent =>
              parse_choice_plan(
                plan: on_other,
                tokens: tokens,
                all_tokens: all_tokens,
                root: root,
                table: table,
                prov: prov
              )
          }
      }
  }
}

fn parse_expr_optional(
  element: PreparedGrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(
    expr: element,
    tokens: tokens,
    all_tokens: all_tokens,
    root: root,
    table: table,
    prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 } =>
      ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 }
    ParseExprRejected { diagnostics: _, table: table1 } =>
      ParseExprAccepted {
        remaining: tokens,
        captured: grammar_empty_node(),
        diagnostics: [],
        prov: prov,
        table: table1
      }
  }
}

fn parse_expr_repeat_step(
  element: PreparedGrammarExpr,
  all_tokens: List<Token>,
  root: GrammarRoot,
  acc: ParseRepeatAcc
) -> ParseRepeatAcc {
  if acc.done {
    acc
  } else {
    match parse_expr_with_first(
      expr: element,
      tokens: acc.remaining,
      all_tokens: all_tokens,
      root: root,
      table: acc.table,
      prov: acc.prov
    ) {
      ParseExprRejected { diagnostics: _, table: table1 } =>
        ParseRepeatAcc {
          remaining: acc.remaining,
          acc_nodes: acc.acc_nodes,
          acc_diags: acc.acc_diags,
          done: true,
          prov: acc.prov,
          table: table1
        }
      ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1, table: table1 } =>
        match length(xs: rest) != length(xs: acc.remaining) {
          true =>
            parse_expr_repeat_step(
              element: element,
              all_tokens: all_tokens,
              root: root,
              acc: ParseRepeatAcc {
                remaining: rest,
                acc_nodes: Cons { head: cap, tail: acc.acc_nodes },
                acc_diags: Cons { head: diags, tail: acc.acc_diags },
                done: false,
                prov: prov1,
                table: table1
              }
            )
          false =>
            ParseRepeatAcc {
              remaining: acc.remaining,
              acc_nodes: acc.acc_nodes,
              acc_diags: acc.acc_diags,
              done: true,
              prov: acc.prov,
              table: table1
            }
        }
    }
  }
}

fn parse_expr_repeat(
  element: PreparedGrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  let init = ParseRepeatAcc {
    remaining: tokens,
    acc_nodes: std.algebra.Empty,
    acc_diags: std.algebra.Empty,
    done: false,
    prov: prov,
    table: table
  }
  let result = parse_expr_repeat_step(element: element, all_tokens: all_tokens, root: root, acc: init)
  let stamped = parse_stamp_derived_repeat(acc_nodes: list_reverse(xs: result.acc_nodes), prov: result.prov)
  ParseExprAccepted {
    remaining: result.remaining,
    captured: stamped.node,
    diagnostics: parse_flatten_diag_batches(batches: list_reverse(xs: result.acc_diags)),
    prov: stamped.prov,
    table: result.table
  }
}

// AN EXPECTATION CHANGES NO ACCEPTED TREE. The element is parsed exactly as it would be bare, and
// an acceptance is returned untouched. On rejection the element's own furthest record has already
// been joined in; the expectation is then joined AT THE ELEMENT'S START as the right operand, so
// it labels that position only if nothing earlier in parse order labelled it and nothing reached
// further (parse_furthest_join).
fn parse_expr_expect(
  element: PreparedGrammarExpr,
  reason: ParseRefusalReason,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(expr: element, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov) {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: prov1, table: table1 } =>
      ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: prov1, table: table1 }
    ParseExprRejected { diagnostics: diags, table: table1 } =>
      ParseExprRejected {
        diagnostics: diags,
        table: parse_table_join_furthest(table: table1, furthest: parse_furthest_expected_at(tokens: tokens, reason: reason))
      }
  }
}

// A MATCH THAT IS A REFUSAL. Where the element matches, the parse refuses with `reason` located at
// the first token of the match, and the table carries that refusal from here on: every later
// attempt rejects at once (parse_expr_with_first), so no alternative can succeed around it, and the
// production door reports it as the outcome. Where the element does not match, this is an ordinary
// failed alternative.
fn parse_expr_refuse_on_match(
  element: PreparedGrammarExpr,
  reason: ParseRefusalReason,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(expr: element, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov) {
    ParseExprRejected { diagnostics: diags, table: table1 } => ParseExprRejected { diagnostics: diags, table: table1 }
    ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: table1 } =>
      ParseExprRejected {
        diagnostics: [],
        table: parse_table_join_refusal(
          table: table1,
          refusal: optional_present(value: parse_refusal_at(reason: reason, tokens: tokens, all_tokens: all_tokens))
        )
      }
  }
}

// THE NOT-PREDICATE NEVER CONSUMES (v2.std.grammar grammar_expr_not_predicate). The element is
// attempted at this position; where it fails the predicate accepts with the input, provenance and
// capture it was given (the empty capture), and where it matches the predicate rejects. Either way
// the attempt was speculative, so the furthest-failure record is returned to what it was before the
// attempt: a probe reaching past this position is not the place the parse stopped. The memo the
// attempt filled is kept, and a refusal it raised is kept, since a refusal stops the parse.
fn parse_expr_not_predicate(
  element: PreparedGrammarExpr,
  first: GrammarExprFirstFold,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  if parse_first_admits_next(first: first, tokens: tokens) {
    parse_expr_not_predicate_attempt(element: element, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov)
  } else {
    ParseExprAccepted { remaining: tokens, captured: grammar_empty_node(), diagnostics: [], prov: prov, table: table }
  }
}

// AN ELEMENT THAT CANNOT START HERE CANNOT MATCH HERE. Where the next token is outside the element's
// FIRST set and the element is not nullable, the element fails without being attempted, so the
// predicate succeeds at once -- the same FIRST reading the prepared choice plans dispatch on.
fn parse_first_admits_next(first: GrammarExprFirstFold, tokens: List<Token>) -> Bool {
  first.nullable || match parse_token_first(tokens: tokens) {
    Absent => false
    Present { value: tok } =>
      any(xs: first.terminals, predicate: fn(k) { first_key_admits_word(key: k, token_class: tok.class, word: tok.lexeme) })
  }
}

fn parse_expr_not_predicate_attempt(
  element: PreparedGrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(expr: element, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov) {
    ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: table1 } =>
      ParseExprRejected { diagnostics: [], table: parse_table_with_furthest(table: table1, furthest: table.furthest) }
    ParseExprRejected { diagnostics: _, table: table1 } =>
      ParseExprAccepted {
        remaining: tokens,
        captured: grammar_empty_node(),
        diagnostics: [],
        prov: prov,
        table: parse_table_with_furthest(table: table1, furthest: table.furthest)
      }
  }
}

// A MATCH CONDITIONED ON LAYOUT. The element is parsed first, so a layout question is asked only of
// a match; then the stream's layout decides (v2.std.compilers.lexing token_stream_line_break_before) whether a
// line break separates the token before the match from its first token. No line break: an ordinary
// failed alternative. A stream that carries no source cannot answer, and the parse refuses with
// LayoutUnknownWithoutSource rather than assume one line.
fn parse_expr_after_line_break(
  element: PreparedGrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match parse_expr_with_first(expr: element, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov) {
    ParseExprRejected { diagnostics: diags, table: table1 } => ParseExprRejected { diagnostics: diags, table: table1 }
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: prov1, table: table1 } =>
      match parse_line_break_before_first(tokens: tokens, layout: table1.layout) {
        LineBreakInGap =>
          ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: prov1, table: table1 }
        NoLineBreakInGap => ParseExprRejected { diagnostics: [], table: table1 }
        LineBreakUnknownWithoutSource =>
          ParseExprRejected {
            diagnostics: [],
            table: parse_table_join_refusal(
              table: table1,
              refusal: optional_present(value: parse_refusal_at(reason: LayoutUnknownWithoutSource, tokens: tokens, all_tokens: all_tokens))
            )
          }
      }
  }
}

// The gap before the first token of `tokens`, answered by the stream's layout (a lookup by that
// token's start). An empty remainder has no first token and so no gap; it answers NoLineBreakInGap, a
// failed match rather than a layout question.
fn parse_line_break_before_first(tokens: List<Token>, layout: Optional<StreamLayout>) -> LineBreakAnswer {
  match parse_token_first(tokens: tokens) {
    Absent => NoLineBreakInGap
    Present { value: first } => token_stream_line_break_before(layout: layout, token_start: first.start)
  }
}

// A refusal is located at the first token of the match it refuses; with no token left it is located
// zero-width at the end of the last token.
fn parse_refusal_at(reason: ParseRefusalReason, tokens: List<Token>, all_tokens: List<Token>) -> Diagnostic {
  match parse_token_first(tokens: tokens) {
    Present { value: tok } => parse_refusal_reason_diagnostic(reason: reason, file: tok.file, start: tok.start, end: tok.end)
    Absent =>
      match list_at_optional(xs: all_tokens, index: length(xs: all_tokens) - 1) {
        Present { value: last } => parse_refusal_reason_diagnostic(reason: reason, file: last.file, start: last.end, end: last.end)
        Absent => Diagnostic {
          reason: parse_refusal_reason_symbol(reason: reason),
          at: invariant_port_locus(port: ^parse_stage_locus_port, invariant: ^parse_refusal_without_a_token),
          correction: Unavailable { reason: ExternalContractUnknown }
        }
      }
  }
}

fn parse_refusal_reason_diagnostic(reason: ParseRefusalReason, file: Symbol, start: Int, end: Int) -> Diagnostic {
  Diagnostic {
    reason: parse_refusal_reason_symbol(reason: reason),
    at: source_port_locus(port: ^parse_stage_locus_port, file: file, extent: ByteRange { start: start, end: end }),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// A PreparedLiteralTerminal is a MATCH constraint in front of an ordinary class terminal: it
// captures and publishes exactly what a StampClass terminal of that class does, never its own text.
fn parse_expr_with_first(
  expr: PreparedGrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match table.refusal {
    Present { value: _ } => ParseExprRejected { diagnostics: [], table: table }
    Absent =>
      match parse_expr_dispatch(expr: expr, tokens: tokens, all_tokens: all_tokens, root: root, table: table, prov: prov) {
        ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: prov1, table: table1 } =>
          ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: prov1, table: table1 }
        ParseExprRejected { diagnostics: diags, table: table1 } =>
          ParseExprRejected { diagnostics: diags, table: parse_table_join_furthest(table: table1, furthest: parse_furthest_at(tokens: tokens)) }
      }
  }
}

fn parse_expr_dispatch(
  expr: PreparedGrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match expr {
    PreparedTerminal { token_class: token_class, stamp: stamp } =>
      parse_expr_terminal(
        token_class: token_class,
        stamp: stamp,
        tokens: tokens,
        table: table,
        prov: prov
      )
    PreparedLiteralTerminal { token_class: token_class, lexeme: lexeme } =>
      match parse_token_first(tokens: tokens) {
        Absent => ParseExprRejected { diagnostics: [], table: table }
        Present { value: tok } =>
          if first_key_admits_word(
            key: FirstExactWord { token_class: token_class, lexeme: lexeme },
            token_class: tok.class,
            word: tok.lexeme
          ) {
            parse_expr_terminal(
              token_class: token_class,
              stamp: StampClass,
              tokens: tokens,
              table: table,
              prov: prov
            )
          } else {
            ParseExprRejected { diagnostics: [], table: table }
          }
      }
    PreparedNonterminal { production: prod_name } =>
      parse_nonterminal_memoized(
        all_tokens: all_tokens,
        tokens: tokens,
        root: root,
        table: table,
        prod_name: prod_name,
        prov: prov
      )
    PreparedSequence { left: left, right: right } =>
      parse_expr_sequence(
        left: left,
        right: right,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    PreparedChoice { plan: plan, first: _ } =>
      parse_choice_plan(
        plan: plan,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    PreparedOptional { element: element } =>
      parse_expr_optional(
        element: element,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    PreparedRepeat { element: element } =>
      parse_expr_repeat(
        element: element,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    PreparedExpect { element: element, reason: reason } =>
      parse_expr_expect(
        element: element,
        reason: reason,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    PreparedRefuseOnMatch { element: element, reason: reason } =>
      parse_expr_refuse_on_match(
        element: element,
        reason: reason,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    PreparedAfterLineBreak { element: element } =>
      parse_expr_after_line_break(
        element: element,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
    PreparedNotPredicate { element: element, first: first } =>
      parse_expr_not_predicate(
        element: element,
        first: first,
        tokens: tokens,
        all_tokens: all_tokens,
        root: root,
        table: table,
        prov: prov
      )
  }
}

// Compat entry for callers holding a raw GrammarExpr (grammar tests, stall probes): prepares
// the expression on the fly from the table's carried analysis — the same folds the production
// path reads from its prepared map — then dispatches on the prepared tree.
fn parse_expr(
  expr: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  parse_expr_with_first(
    expr: prepare_grammar_expr(
      expr: expr,
      nullable_set: table.nullable_set,
      first_rows: table.first_rows,
      productions: empty_map(),
      production: root.start,
      token_dispatch: parse_table_token_dispatch(table: table, production: root.start)
    ).tree,
    tokens: tokens,
    all_tokens: all_tokens,
    root: root,
    table: table,
    prov: prov
  )
}

fn parse_production_memo_stats(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol,
  materialization: Materialization
) -> ParseMemoStats {
  let root = validated.root
  match grammar_lookup_production(root: root, name: production_name) {
    Violates { diagnostic: _ } =>
      ParseMemoStats { hits: 0, misses: 0, lookup_calls: 0 }
    Holds { value: production } =>
      let prov = parse_prov_initial()
      let table = parse_table_for_production(
        validated: validated,
        all_tokens: tokens,
        materialization: materialization
      )
      match parse_expr(
        expr: production.expression,
        tokens: tokens,
        all_tokens: tokens,
        root: root,
        table: table,
        prov: prov
      ) {
        ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _, table: final_table } =>
          parse_table_memo_stats(table: final_table)
        ParseExprRejected { diagnostics: _, table: final_table } =>
          parse_table_memo_stats(table: final_table)
      }
  }
}

fn parse_production_prepared(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  analysis: GrammarFirstAnalysis,
  production_name: Symbol,
  materialization: Materialization
) -> Outcome<ParseArtifact> {
  parse_production_prepared_measured(
    tokens: tokens,
    validated: validated,
    analysis: analysis,
    production_name: production_name,
    materialization: materialization
  ).outcome
}

fn parse_production_prepared_measured(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  analysis: GrammarFirstAnalysis,
  production_name: Symbol,
  materialization: Materialization
) -> ParseProductionMeasured {
  parse_production_prepared_measured_seeded(
    tokens: tokens,
    validated: validated,
    analysis: analysis,
    production_name: production_name,
    seed: occurrence_id_allocator_initial(),
    layout: optional_absent(),
    materialization: materialization
  )
}

fn parse_production_prepared_measured_seeded(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  analysis: GrammarFirstAnalysis,
  production_name: Symbol,
  seed: OccurrenceIdAllocator,
  layout: Optional<StreamLayout>,
  materialization: Materialization
) -> ParseProductionMeasured {
  let root = validated.root
  match grammar_lookup_production(root: root, name: production_name) {
    Holds { value: production } =>
      let prov = parse_prov_seeded(seed: seed)
      let table = parse_table_for_stream_analyzed(
        validated: validated,
        analysis: analysis,
        layout: layout,
        all_tokens: tokens,
        materialization: materialization
      )
      let parsed = parse_expr(
        expr: production.expression,
        tokens: tokens,
        all_tokens: tokens,
        root: root,
        table: table,
        prov: prov
      )
      match parse_expr_result_table(result: parsed).refusal {
        Present { value: refusal } =>
          ParseProductionMeasured {
            outcome: Rejected { diagnostics: diagnostics_singleton(d: refusal) },
            memo: parse_table_memo_stats(table: parse_expr_result_table(result: parsed))
          }
        Absent => parse_production_measured_unrefused(parsed: parsed, production: production, root: root)
      }
    Violates { diagnostic: d } =>
      ParseProductionMeasured {
        outcome: Rejected { diagnostics: diagnostics_singleton(d: d) },
        memo: parse_memo_stats_empty()
      }
  }
}

// A REFUSAL RECORDED ANYWHERE IN THE PARSE IS THE OUTCOME, whether or not the rest of the input
// happened to parse around it: RefuseOnMatch names source the seed refuses although another reading
// succeeds, so an Accepted here would be exactly the success it exists to deny. Only an unrefused
// parse reaches the ordinary accept / leftover-token / no-match reading below.
fn parse_production_measured_unrefused(
  parsed: ParseExprResult,
  production: GrammarProduction,
  root: GrammarRoot
) -> ParseProductionMeasured {
  match parsed {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov, table: final_table } =>
      if is_empty(xs: remaining) {
        let stamped = parse_wrap_production_captured(
          production: production,
          captured: captured,
          prov: inner_prov
        )
        ParseProductionMeasured {
          outcome: Accepted {
            value: ParseArtifact { tree: stamped.node, span_index: stamped.prov.index, alloc: stamped.prov.alloc },
            diagnostics: parse_diags_to_diagnostics(diags: diags)
          },
          memo: parse_table_memo_stats(table: final_table)
        }
      } else {
        ParseProductionMeasured {
          outcome: Rejected {
            diagnostics: diagnostics_singleton(
              d: parse_g0_tokens_remain_diagnostic_at(tokens: remaining, furthest: final_table.furthest)
            )
          },
          memo: parse_table_memo_stats(table: final_table)
        }
      }
    ParseExprRejected { diagnostics: diags, table: final_table } =>
      ParseProductionMeasured {
        outcome: Rejected {
          diagnostics: parse_diags_to_non_empty(
            diags: diags,
            default: parse_e1_syntax_error_diagnostic(
              at: node_locus(node: grammar_to_node(grammar: ModeledGrammar { root: root }))
            )
          )
        },
        memo: parse_table_memo_stats(table: final_table)
      }
  }
}

fn parse_production(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol
) -> Outcome<ParseArtifact> {
  let analysis = compute_grammar_first_analysis(root: validated.root)
  match parse_table_memo_materialization_for(r: analysis.memo_recurrence) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: materialization, diagnostics: _ } =>
      parse_production_prepared(
        tokens: tokens,
        validated: validated,
        analysis: analysis,
        production_name: production_name,
        materialization: materialization
      )
  }
}

fn parse_production_tree(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol
) -> Outcome<ParseTree> {
  match parse_production(
    tokens: tokens,
    validated: validated,
    production_name: production_name
  ) {
    Accepted { value: artifact, diagnostics: d } =>
      Accepted { value: artifact.tree, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
// WHERE THE PARSE-TABLE MATERIALIZATION IS ADMITTED, and the only place it is. PreparedGrammar
// is already the once-per-grammar carrier and the admission is a once-per-grammar fact, so the
// join belongs here: a refused admission REFUSES THE PREPARE, which is how the unmet obligation
// reaches the caller as a located diagnostic instead of as a quiet recompute.
//
// THE PARAMETER IS THE DOOR, NOT ITS ANSWER, and that is forced by the derivation rather than
// chosen. The parse demand's site is read off the grammar's own recurrence census, so the
// admission is a FUNCTION of the analysis and cannot be evaluated before the analysis exists --
// an already-computed Outcome passed in here would have to come from some other grammar. Passing
// the door keeps the control's grip: a control supplies a door built on a refusing verdict list
// and drives THIS body, the one parse_module runs, rather than a copy of it.
fn prepare_grammar(grammar: ParseGrammar) -> Outcome<PreparedGrammar> {
  prepare_grammar_with_admission(
    admit: fn(r) { parse_table_memo_materialization_for(r: r) },
    grammar: grammar
  )
}

// A VOID GRAMMAR CONSULTS NO MEMO, so it does not consult the admission either. Refusing a void
// parse because the parse-table obligation is unmet would forbid more than the obligation covers
// (DESIGN section 4d): no table is built on that arm, so there is nothing for a provider to
// discharge. The admission is demanded exactly where the table is, on the modeled arm -- and
// there, only once the analysis has produced the census the door is asked about.
fn prepare_grammar_with_admission(
  admit: fn(ParseMemoRecurrence) -> Outcome<Materialization>,
  grammar: ParseGrammar
) -> Outcome<PreparedGrammar> {
  let grammar_node = grammar_to_node(grammar: grammar)
  let at = node_locus(node: grammar_node)
  if well_formed(n: grammar_node) {
    match grammar {
      VoidGrammar =>
        Accepted { value: PreparedVoidGrammar, diagnostics: None }
      ModeledGrammar { root: root } =>
        match grammar_validate_and_analyze(root: root, at: at) {
          Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
          Accepted { value: modeled, diagnostics: validation_residue } =>
            match admit(modeled.analysis.memo_recurrence) {
              Rejected { diagnostics: refusal } => Rejected { diagnostics: refusal }
              Accepted { value: materialization, diagnostics: _ } =>
                Accepted {
                  value: PreparedModeled { modeled: modeled, materialization: materialization },
                  diagnostics: validation_residue
                }
            }
        }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_not_well_formed_diagnostic(at: at)) }
  }
}

fn overlap_residue_stage_from_prepared(prepared: PreparedGrammar) -> Optional<NonEmptyParseStageDiagnostics> {
  match prepared {
    PreparedVoidGrammar => optional_absent()
    PreparedModeled { modeled: modeled, materialization: _ } => modeled.overlap_residue_stage
  }
}

fn overlap_residue_stage_from_parse_grammar(grammar: ParseGrammar) -> Optional<NonEmptyParseStageDiagnostics> {
  match prepare_grammar(grammar: grammar) {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: prepared, diagnostics: _ } =>
      overlap_residue_stage_from_prepared(prepared: prepared)
  }
}

// The unmeasured door, retained for every caller that does not own a clock or a relay, and defined
// as the projection of the measured fold rather than restated beside it.
fn parse_module_prepared(
  tokens: TokenStream,
  prepared: PreparedGrammar,
  validation_residue: Diagnostics
) -> Outcome<ParseArtifact> {
  parse_module_prepared_measured(
    tokens: tokens,
    prepared: prepared,
    validation_residue: validation_residue
  ).outcome
}

fn parse_module_prepared_seeded(
  tokens: TokenStream,
  prepared: PreparedGrammar,
  validation_residue: Diagnostics,
  seed: OccurrenceIdAllocator
) -> Outcome<ParseArtifact> {
  parse_module_prepared_measured_seeded(
    tokens: tokens,
    prepared: prepared,
    validation_residue: validation_residue,
    seed: seed
  ).outcome
}

// A VOID GRAMMAR CONSULTS NO MEMO, so its accounting is empty rather than absent: the counters are
// zero because nothing was looked up, which is an answer. Reporting no stats at all would make a
// void parse indistinguishable from a parse whose stats were dropped.
fn parse_module_prepared_measured(
  tokens: TokenStream,
  prepared: PreparedGrammar,
  validation_residue: Diagnostics
) -> ParseProductionMeasured {
  parse_module_prepared_measured_seeded(
    tokens: tokens,
    prepared: prepared,
    validation_residue: validation_residue,
    seed: occurrence_id_allocator_initial()
  )
}

// THE SEEDED DOOR, WHICH IS THE ONE AN INGEST USES. `seed` is the allocator the PREVIOUS file in
// the same source graph left behind, so this file's occurrence ids continue where that one stopped
// and no two files in one ingest mint the same id. The returned artifact carries the mark this
// parse reached, which is what lets the assembly fold thread it to the next read. The unseeded
// projection above is every other caller: one file, its own isolated scope, byte-identical to the
// fold it was before this parameter existed.
fn parse_module_prepared_measured_seeded(
  tokens: TokenStream,
  prepared: PreparedGrammar,
  validation_residue: Diagnostics,
  seed: OccurrenceIdAllocator
) -> ParseProductionMeasured {
  let ntok = token_stream_remaining_count(stream: tokens)
  match prepared {
    PreparedVoidGrammar =>
      if ntok == 0 {
        ParseProductionMeasured {
          outcome: Accepted {
            value: ParseArtifact { tree: grammar_to_node(grammar: VoidGrammar), span_index: span_index_empty(), alloc: seed },
            diagnostics: validation_residue
          },
          memo: parse_memo_stats_empty()
        }
      } else {
        ParseProductionMeasured {
          outcome: Rejected {
            diagnostics: diagnostics_singleton(
              d: parse_g0_tokens_remain_diagnostic(tokens: token_stream_remaining(stream: tokens))
            )
          },
          memo: parse_memo_stats_empty()
        }
      }
    PreparedModeled { modeled: modeled, materialization: materialization } =>
      let measured = parse_production_prepared_measured_seeded(
        tokens: token_stream_remaining(stream: tokens),
        validated: modeled.validated,
        analysis: modeled.analysis,
        production_name: modeled.validated.root.start,
        seed: seed,
        layout: token_stream_layout(stream: tokens),
        materialization: materialization
      )
      match measured.outcome {
        Accepted { value: artifact, diagnostics: parse_diags } =>
          ParseProductionMeasured {
            outcome: Accepted {
              value: artifact,
              diagnostics: diagnostics_merge(outer: validation_residue, inner: parse_diags)
            },
            memo: measured.memo
          }
        Rejected { diagnostics: parse_rejected } =>
          ParseProductionMeasured {
            outcome: Rejected {
              diagnostics: rejected_with_pending(pending: validation_residue, rejected: parse_rejected)
            },
            memo: measured.memo
          }
      }
  }
}

fn parse_module(tokens: TokenStream, grammar: ParseGrammar) -> Outcome<ParseArtifact> {
  match prepare_grammar(grammar: grammar) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: prepared, diagnostics: validation_residue } =>
      parse_module_prepared(tokens: tokens, prepared: prepared, validation_residue: validation_residue)
  }
}

fn parse(tokens: TokenStream, grammar: ParseGrammar) -> Outcome<ParseTree> {
  match parse_module(tokens: tokens, grammar: grammar) {
    Accepted { value: artifact, diagnostics: d } =>
      Accepted { value: artifact.tree, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
