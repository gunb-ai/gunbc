fn parse_e1_syntax_error_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_e1_syntax_error,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


// 🟢 substrate catamorphism consumer — feature: GrammarRoot production lookup — bind
// node://adhoc-a896516d-3f7 — name match expressed as v2.std.algebra.filter + the
// v2.std.collection.list_at_optional head projection; the hand-written first-match Witness
// fold (grammar_lookup_production_step) dissolved. First match == unique match because
// grammar_has_duplicate_productions rejects duplicate names before parse.
fn grammar_lookup_production(root: GrammarRoot, name: Symbol) -> Witness<GrammarProduction> {
  match list_at_optional(
    xs: filter(xs: root.productions, predicate: fn(p) { p.name == name }),
    index: 0
  ) {
    Present { value: production } => Holds { value: production }
    Absent =>
      Violates {
        diagnostic: parse_grammar_undefined_nonterminal_diagnostic(
          at: port_locus(port: parse_stage_locus_port)
        )
      }
  }
}


// --- Parse table (memoized position × production) ---

// Map<K,V> uses structural == on K; ParsePositionKey { position: Int, production: Symbol } is a valid composite key.
fn parse_table_lookup(table: ParseTable, key: ParsePositionKey) -> Witness<ParseExprResult> {
  table.lookup(key)
}

fn parse_table_insert(table: ParseTable, key: ParsePositionKey, value: ParseExprResult) -> ParseTable {
  map_insert(m: table, key: key, value: value)
}

fn parse_current_position(all_tokens: List<Token>, tokens: List<Token>) -> Int {
  length(xs: all_tokens) - length(xs: tokens)
}

fn tokens_at_position(all_tokens: List<Token>, position: Int) -> List<Token> {
  fold_list(
    xs: all_tokens,
    empty: TokensAtPositionAcc { skipped: 0, target: position, current: all_tokens },
    cons: fn(acc, _) {
      match acc.skipped < acc.target {
        true =>
          match list_tail(xs: acc.current) {
            TailFound { tail: t } => TokensAtPositionAcc {
              skipped: acc.skipped + 1,
              target: acc.target,
              current: t
            }
            TailAbsent => acc
          }
        false => acc
      }
    }
  ).current
}

// Positions 0..N inclusive for a token stream of length N (N+1 suffixes).
fn token_position_indices(tokens: List<Token>) -> List<Int> {
  match is_empty(xs: tokens) {
    true => Cons { head: 0, tail: Empty }
    false =>
      fold_list(
        xs: tokens,
        empty: Cons { head: 0, tail: Empty },
        cons: fn(acc, _) {
          list_snoc_item(xs: acc, item: length(xs: acc))
        }
      )
  }
}

fn parse_non_empty_diagnostics_to_list(ned: NonEmptyDiagnostics) -> List<Diagnostic> {
  list_append(left: [ned.head], right: ned.tail)
}

fn parse_prov_initial() -> ParseProvenanceState {
  ParseProvenanceState {
    alloc: occurrence_id_allocator_initial(),
    index: span_index_empty()
  }
}

fn parse_prov_merge(
  base: ParseProvenanceState,
  incoming: ParseProvenanceState
) -> ParseProvenanceState {
  ParseProvenanceState {
    alloc: occurrence_id_allocator_advance_to(
      alloc: base.alloc,
      min_next: incoming.alloc.next_id
    ),
    index: span_index_merge(base: base.index, incoming: incoming.index)
  }
}

fn parse_mint_from_source(
  prov: ParseProvenanceState,
  file: Symbol,
  start: Int,
  end: Int
) -> ParseMintSourceResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let locus = Textual {
    file: file,
    extent: ByteRange { start: start, end: end }
  }
  let event = origin_event_from_source(locus: locus)
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseMintSourceResult {
    id: minted.id,
    prov: ParseProvenanceState { alloc: minted.alloc, index: index }
  }
}

fn parse_minted_id_from_node(n: Node) -> List<OccurrenceId> {
  match n.occurrence_id {
    MintedOccurrence { id: id } => Cons { head: id, tail: Empty }
    SyntheticOccurrence => Empty
  }
}

fn parse_minted_id_list(nodes: List<Node>) -> List<OccurrenceId> {
  fold_list(
    xs: nodes,
    empty: Empty,
    cons: fn(acc, n) {
      list_append(left: acc, right: parse_minted_id_from_node(n: n))
    }
  )
}

fn parse_stamp_terminal(
  tok: Token,
  binding: Optional<Symbol>,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = parse_mint_from_source(
    prov: prov,
    file: tok.file,
    start: tok.start,
    end: tok.end
  )
  let identity = match binding {
    Present { value: b } => b
    Absent => tok.class
  }
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Atom { identity: identity } },
      children: [],
      occurrence_id: node_occurrence_minted(id: minted.id)
    ),
    prov: minted.prov
  }
}

fn parse_repeat_captured_node(acc_nodes: List<Node>, occurrence_id: NodeOccurrenceId) -> Node {
  node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: acc_nodes,
      empty: Empty,
      cons: fn(acc, n) {
        list_snoc_item(
          xs: acc,
          item: Edge {
            label: Named { name: ^grammar_repeat_element_node_projection },
            target: n
          }
        )
      }
    ),
    occurrence_id: occurrence_id
  )
}

fn parse_stamp_derived_conj(
  cap1: Node,
  cap2: Node,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: [cap1, cap2])
  let event = DerivedBy { producer: parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Conj },
      children: [
        grammar_named_edge(name: ^grammar_sequence_left_node_projection, target: cap1),
        grammar_named_edge(name: ^grammar_sequence_right_node_projection, target: cap2)
      ],
      occurrence_id: node_occurrence_minted(id: minted.id)
    ),
    prov: ParseProvenanceState { alloc: minted.alloc, index: index }
  }
}

fn parse_stamp_derived_repeat(
  acc_nodes: List<Node>,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: acc_nodes)
  let event = DerivedBy { producer: parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: parse_repeat_captured_node(
      acc_nodes: acc_nodes,
      occurrence_id: node_occurrence_minted(id: minted.id)
    ),
    prov: ParseProvenanceState { alloc: minted.alloc, index: index }
  }
}

fn parse_wrap_production_captured(
  production: GrammarProduction,
  captured: Node,
  prov: ParseProvenanceState
) -> ParseStampResult {
  let minted = alloc_occurrence_id(alloc: prov.alloc)
  let from = parse_minted_id_list(nodes: [captured])
  let event = DerivedBy { producer: parse_stage_producer, from: from }
  let index = span_index_record(index: prov.index, id: minted.id, event: event)
  ParseStampResult {
    node: node_with_occurrence_id(
      kind: TypeNode { connective: Conj },
      children: [
        grammar_named_edge(name: grammar_production_identity_node_projection, target: production.emitted),
        grammar_named_edge(name: grammar_production_captured_node_projection, target: captured)
      ],
      occurrence_id: node_occurrence_minted(id: minted.id)
    ),
    prov: ParseProvenanceState { alloc: minted.alloc, index: index }
  }
}

fn parse_nonterminal_from_table(
  table: ParseTable,
  all_tokens: List<Token>,
  tokens: List<Token>,
  root: GrammarRoot,
  prod_name: Symbol,
  prov: ParseProvenanceState
) -> ParseExprResult {
  match grammar_lookup_production(root: root, name: prod_name) {
    Violates { diagnostic: d } =>
      ParseExprRejected { diagnostics: [d] }
    Holds { value: production } =>
      let key = ParsePositionKey {
        position: parse_current_position(all_tokens: all_tokens, tokens: tokens),
        production: prod_name
      }
      match parse_table_lookup(table: table, key: key) {
        Holds { value: inner } =>
          match inner {
            ParseExprRejected { diagnostics: diags } =>
              ParseExprRejected { diagnostics: diags }
            ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov } =>
              let merged_prov = parse_prov_merge(base: prov, incoming: inner_prov)
              let stamped = parse_wrap_production_captured(
                production: production,
                captured: captured,
                prov: merged_prov
              )
              ParseExprAccepted {
                remaining: remaining,
                captured: stamped.node,
                diagnostics: diags,
                prov: stamped.prov
              }
          }
        Violates { diagnostic: d } =>
          ParseExprRejected { diagnostics: [d] }
      }
  }
}


// --- Left-recursion detection ---

// set_symbol_insert: functional set extension — new set tests item first, then delegates.
fn set_symbol_insert(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {
  Set {
    member: fn(sym) { sym == item || s.member(sym) }
  }
}


// 🟢 substrate catamorphism consumer — feature: GrammarExpr structural morphism substrate —
// bind node://adhoc-b696538c-710 — first consumer of v2.std.grammar.fold_grammar_expr: the
// nullable query is now expressed as a GrammarExprFold algebra over Bool rather than a hand-written
// per-variant recursion. The structural recursion lives once in fold_grammar_expr; this function
// supplies only the per-variant combine.
// expr_is_nullable_given_set: true iff expr can match empty input given a pre-computed nullable set.
// Nonterminal arms consult nullable_set rather than following production references.
fn expr_is_nullable_given_set(expr: GrammarExpr, nullable_set: Set<Symbol>) -> Bool {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_, _) { false },
      nonterminal: fn(name) { nullable_set.member(name) },
      sequence: fn(left_nullable, right_nullable) { left_nullable && right_nullable },
      choice: fn(left_nullable, right_nullable) { left_nullable || right_nullable },
      optional: fn(_) { true },
      repeat: fn(_) { true }
    }
  )
}


fn compute_nullable_step(ns: Set<Symbol>, p: GrammarProduction) -> Set<Symbol> {
  if expr_is_nullable_given_set(expr: p.expression, nullable_set: ns) {
    set_symbol_insert(s: ns, item: p.name)
  } else {
    ns
  }
}


// compute_nullable_set: fixpoint over productions.
// Outer fold iterates |productions| times (convergence bound); inner fold adds nullable productions.
fn compute_nullable_set(root: GrammarRoot) -> Set<Symbol> {
  fold_list(
    xs: root.productions,
    empty: Set { member: fn(_) { false } },
    cons: fn(acc, _) {
      fold_list(
        xs: root.productions,
        empty: acc,
        cons: fn(ns, p) {
          compute_nullable_step(ns: ns, p: p)
        }
      )
    }
  )
}


// v2 bootstrap compiler workaround: Empty literal has unknown element type in if/else context;
// a typed wrapper anchors the type to List<Symbol> so branch unification succeeds.
fn grammar_empty_corner_list() -> List<Symbol> {
  Empty
}


fn expr_corner_fold_terminal(_: Symbol) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: Empty, nullable: false }
}


fn expr_corner_fold_nonterminal(name: Symbol, nullable_set: Set<Symbol>) -> GrammarExprCornerFold {
  GrammarExprCornerFold {
    corners: Cons { head: name, tail: Empty },
    nullable: nullable_set.member(name)
  }
}


fn expr_corner_fold_sequence(
  left_fold: GrammarExprCornerFold,
  right_fold: GrammarExprCornerFold
) -> GrammarExprCornerFold {
  // left_fold.nullable is fold_grammar_expr applied with the Bool nullable algebra over the
  // left subtree — equivalent to expr_is_nullable_given_set(expr: left, nullable_set).
  GrammarExprCornerFold {
    corners: list_append(
      left: left_fold.corners,
      right: if left_fold.nullable {
        right_fold.corners
      } else {
        grammar_empty_corner_list()
      }
    ),
    nullable: left_fold.nullable && right_fold.nullable
  }
}


fn expr_corner_fold_choice(
  left_fold: GrammarExprCornerFold,
  right_fold: GrammarExprCornerFold
) -> GrammarExprCornerFold {
  GrammarExprCornerFold {
    corners: list_append(left: left_fold.corners, right: right_fold.corners),
    nullable: left_fold.nullable || right_fold.nullable
  }
}


fn expr_corner_fold_optional(element_fold: GrammarExprCornerFold) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: element_fold.corners, nullable: true }
}


fn expr_corner_fold_repeat(element_fold: GrammarExprCornerFold) -> GrammarExprCornerFold {
  GrammarExprCornerFold { corners: element_fold.corners, nullable: true }
}


fn expr_corner_nullable_fold(expr: GrammarExpr, nullable_set: Set<Symbol>) -> GrammarExprCornerFold {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, _) { expr_corner_fold_terminal(token_class) },
      nonterminal: fn(name) { expr_corner_fold_nonterminal(name: name, nullable_set: nullable_set) },
      sequence: expr_corner_fold_sequence,
      choice: expr_corner_fold_choice,
      optional: expr_corner_fold_optional,
      repeat: expr_corner_fold_repeat
    }
  )
}


// 🟢 substrate catamorphism consumer — feature: GrammarExpr left-corner query substrate —
// bind node://adhoc-2145db6b-69a — fold_grammar_expr consumer with GrammarExprCornerFold product
// threading nullable alongside corners so Sequence combine matches expr_is_nullable_given_set.
// expr_direct_left_corner_list: direct (non-transitive) left-corner nonterminals of expr.
fn expr_direct_left_corner_list(expr: GrammarExpr, nullable_set: Set<Symbol>) -> List<Symbol> {
  expr_corner_nullable_fold(expr: expr, nullable_set: nullable_set).corners
}


// compute_left_corner_closure: transitive closure of left-corner reachability from start symbols.
// Outer fold iterates |productions| times (convergence bound).
// Inner fold expands each reachable symbol by its production's direct left corners.
fn compute_left_corner_closure(
  start: List<Symbol>,
  nullable_set: Set<Symbol>,
  root: GrammarRoot
) -> List<Symbol> {
  fold_list(
    xs: root.productions,
    empty: start,
    cons: fn(reachable, _) {
      fold_list(
        xs: reachable,
        empty: reachable,
        cons: fn(acc, sym) {
          match grammar_lookup_production(root: root, name: sym) {
            Violates { diagnostic: _ } => acc
            Holds { value: prod } =>
              fold_list(
                xs: expr_direct_left_corner_list(expr: prod.expression, nullable_set: nullable_set),
                empty: acc,
                cons: fn(r, name) {
                  if contains(xs: r, item: name, eq: fn(a, b) { a == b }) {
                    r
                  } else {
                    list_snoc_item(xs: r, item: name)
                  }
                }
              )
          }
        }
      )
    }
  )
}


// 🟡 gated — predicate-dissolution interim — feature: GrammarRoot left-recursion validator substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived left-recursion reachability morphism over GrammarRoot productions; forbidden: duplicating left-recursion check logic outside this function.
// Per-production or-fold rides v2.std.algebra.any (hand step fold dissolved, Level-1d).
fn grammar_has_left_recursion(root: GrammarRoot) -> Bool {
  let nullable_set = compute_nullable_set(root: root)
  any(
    xs: root.productions,
    predicate: fn(p) {
      contains(
        xs: compute_left_corner_closure(
          start: expr_direct_left_corner_list(expr: p.expression, nullable_set: nullable_set),
          nullable_set: nullable_set,
          root: root
        ),
        item: p.name,
        eq: fn(a, b) { a == b }
      )
    }
  )
}


// 🟢 substrate catamorphism consumer — feature: GrammarExpr production-reference closure query substrate —
// bind node://adhoc-2145db6b-69a — fold_grammar_expr consumer over Bool; does NOT follow nonterminal
// references into their productions, so it always terminates without a visited set.
fn expr_has_undefined_nonterminal(expr: GrammarExpr, root: GrammarRoot) -> Bool {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_, _) { false },
      nonterminal: fn(p) {
        match grammar_lookup_production(root: root, name: p) {
          Violates { diagnostic: _ } => true
          Holds { value: _ } => false
        }
      },
      sequence: fn(left_undef, right_undef) { left_undef || right_undef },
      choice: fn(left_undef, right_undef) { left_undef || right_undef },
      optional: fn(element_undef) { element_undef },
      repeat: fn(element_undef) { element_undef }
    }
  )
}


// 🟡 gated — predicate-dissolution interim — feature: GrammarRoot structure validity query substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived undefined-reference scan morphism over GrammarRoot; forbidden: duplicating undefined-nonterminal check logic outside this function.
// Per-production or-fold rides v2.std.algebra.any (hand step fold dissolved, Level-1d).
fn grammar_has_undefined_nonterminals(root: GrammarRoot) -> Bool {
  match grammar_lookup_production(root: root, name: root.start) {
    Violates { diagnostic: _ } => true
    Holds { value: _ } =>
      any(
        xs: root.productions,
        predicate: fn(p) { expr_has_undefined_nonterminal(expr: p.expression, root: root) }
      )
  }
}


// 🟢 substrate catamorphism consumer — feature: GrammarRoot duplicate-name scan — bind
// node://adhoc-a896516d-3f7 — scan expressed as v2.std.algebra.unique over production names;
// the hand-written GrammarDupCheckResult accumulator coproduct dissolved (Level-1d).
fn grammar_has_duplicate_productions(root: GrammarRoot) -> Bool {
  match unique(xs: root.productions, eq: fn(a, b) { a.name == b.name }) {
    true => false
    false => true
  }
}


fn grammar_validate_for_parse(root: GrammarRoot, at: Locus) -> Outcome<ValidatedGrammarRoot> {
  if grammar_has_undefined_nonterminals(root: root) {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_undefined_nonterminal_diagnostic(at: at)) }
  } else {
    if grammar_has_duplicate_productions(root: root) {
      Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_duplicate_production_diagnostic(at: at)) }
    } else {
      if grammar_has_left_recursion(root: root) {
        Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_left_recursive_diagnostic(at: at)) }
      } else {
        Accepted { value: ValidatedGrammarRoot { root: root }, diagnostics: None }
      }
    }
  }
}


// --- Diagnostic list helpers ---

fn parse_diag_cons(d: Diagnostic, acc: Diagnostics) -> Diagnostics {
  match acc {
    None => Some { diagnostics: NonEmptyDiagnostics { head: d, tail: [] } }
    Some { diagnostics: ned } =>
      Some {
        diagnostics: NonEmptyDiagnostics {
          head: d,
          tail: list_append(left: [ned.head], right: ned.tail)
        }
      }
  }
}


fn parse_diags_to_diagnostics(diags: List<Diagnostic>) -> Diagnostics {
  fold_list_right(xs: diags, empty: None, snoc: fn(acc, d) { parse_diag_cons(d: d, acc: acc) })
}


fn parse_diags_to_non_empty(diags: List<Diagnostic>, default: Diagnostic) -> NonEmptyDiagnostics {
  match parse_diags_to_diagnostics(diags: diags) {
    None => NonEmptyDiagnostics { head: default, tail: [] }
    Some { diagnostics: ned } => ned
  }
}


// --- Parse walk helpers ---

// Skip tokens until a sync token is found (inclusive — returns stream starting at sync token).
fn parse_sync_step(acc: ParseSyncState, tok: Token, sync_tokens: Set<Symbol>) -> ParseSyncState {
  match acc.found_sync {
    true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: acc.result, item: tok) }
    false =>
      match sync_tokens.member(tok.class) {
        true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: Empty, item: tok) }
        false => ParseSyncState { found_sync: false, result: Empty }
      }
  }
}


fn parse_skip_to_sync(tokens: List<Token>, sync_tokens: Set<Symbol>) -> ParseSyncState {
  fold_list(
    xs: tokens,
    empty: ParseSyncState { found_sync: false, result: Empty },
    cons: fn(acc, tok) { parse_sync_step(acc: acc, tok: tok, sync_tokens: sync_tokens) }
  )
}


// 🟢 substrate head projection — the TokenPeek per-use carrier dissolved onto the
// v2.std.collection.list_at_optional Optional<T> head projection (Level-1d); this wrapper
// only pins T = Token for the bootstrap compiler's monomorphic field-access inference.
fn parse_token_first(tokens: List<Token>) -> Optional<Token> {
  list_at_optional(xs: tokens, index: 0)
}




// ParseThunk: single-field carrier for a deferred parse combinator. R in fold_grammar_expr<ParseThunk>.
// Field-dispatch (thunk.apply(...)) lets the v2 lens analysis track the callable through the typed
// 'apply' field rather than bare function-valued variable syntax (which the lens does not track).
// One field, not 6 variants — not a GrammarExpr mirror; Class-B preserved.
type ParseThunk {
  apply: fn(List<Token>, List<Token>, GrammarRoot, ParseTable, ParseProvenanceState) -> ParseExprResult
}


// 🟢 substrate catamorphism consumer — feature: GrammarExpr parse interpreter —
// bind node://adhoc-2145db6b-69a — full dissolution: one fold_grammar_expr<ParseThunk> call
// where ParseThunk = { apply: fn(tok_in,all_toks,root_in,table_in,prov_in)->ParseExprResult }.
// fold_grammar_expr reduces children to ParseThunk (deferred combinators) before passing them to
// each handler — no parsing runs during construction; only top thunk fires via .apply at the end.
// Nonterminal arm: O(1) ParseTable lookup via parse_nonterminal_from_table (table-boundary leaf).
// Repeat terminates via the no-progress guard length(rest) != length(acc.remaining).
fn parse_expr(
  expr: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable,
  prov: ParseProvenanceState
) -> ParseExprResult {
  let thunk = fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(token_class, binding) {
        ParseThunk { apply: fn(tok_in, _all_toks, _root_in, _table_in, prov_in) {
          match parse_token_first(tokens: tok_in) {
            Absent => ParseExprRejected { diagnostics: [] }
            Present { value: tok } =>
              match tok.class == token_class {
                true =>
                  match list_tail(xs: tok_in) {
                    TailFound { tail: remaining } =>
                      let stamped = parse_stamp_terminal(tok: tok, binding: binding, prov: prov_in)
                      ParseExprAccepted {
                        remaining: remaining,
                        captured: stamped.node,
                        diagnostics: [],
                        prov: stamped.prov
                      }
                    TailAbsent => ParseExprRejected { diagnostics: [] }
                  }
                false => ParseExprRejected { diagnostics: [] }
              }
          } } }
      },
      nonterminal: fn(prod_name) {
        ParseThunk { apply: fn(tok_in, all_toks, root_in, table_in, prov_in) {
          parse_nonterminal_from_table(
            table: table_in,
            all_tokens: all_toks,
            tokens: tok_in,
            root: root_in,
            prod_name: prod_name,
            prov: prov_in
          )
        } }
      },
      sequence: fn(left_thunk, right_thunk) {
        ParseThunk { apply: fn(tok_in, all_toks, root_in, table_in, prov_in) {
          match left_thunk.apply(tok_in, all_toks, root_in, table_in, prov_in) {
            ParseExprRejected { diagnostics: diags } =>
              ParseExprRejected { diagnostics: diags }
            ParseExprAccepted { remaining: rest1, captured: cap1, diagnostics: diags1, prov: prov1 } =>
              match right_thunk.apply(rest1, all_toks, root_in, table_in, prov1) {
                ParseExprRejected { diagnostics: diags2 } =>
                  ParseExprRejected { diagnostics: list_append(left: diags1, right: diags2) }
                ParseExprAccepted { remaining: rest2, captured: cap2, diagnostics: diags2, prov: prov2 } =>
                  let stamped = parse_stamp_derived_conj(cap1: cap1, cap2: cap2, prov: prov2)
                  ParseExprAccepted {
                    remaining: rest2,
                    captured: stamped.node,
                    diagnostics: list_append(left: diags1, right: diags2),
                    prov: stamped.prov
                  }
              }
          }
        } }
      },
      choice: fn(left_thunk, right_thunk) {
        ParseThunk { apply: fn(tok_in, all_toks, root_in, table_in, prov_in) {
          match left_thunk.apply(tok_in, all_toks, root_in, table_in, prov_in) {
            ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1 } =>
              ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1 }
            ParseExprRejected { diagnostics: _ } =>
              right_thunk.apply(tok_in, all_toks, root_in, table_in, prov_in)
          }
        } }
      },
      optional: fn(element_thunk) {
        ParseThunk { apply: fn(tok_in, all_toks, root_in, table_in, prov_in) {
          match element_thunk.apply(tok_in, all_toks, root_in, table_in, prov_in) {
            ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1 } =>
              ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1 }
            ParseExprRejected { diagnostics: _ } =>
              ParseExprAccepted {
                remaining: tok_in,
                captured: grammar_empty_node(),
                diagnostics: [],
                prov: prov_in
              }
          }
        } }
      },
      repeat: fn(element_thunk) {
        ParseThunk { apply: fn(tok_in, all_toks, root_in, table_in, prov_in) {
          let init = ParseRepeatAcc {
            remaining: tok_in,
            acc_nodes: [],
            acc_diags: [],
            done: false,
            prov: prov_in
          }
          let result = fold_list(
            xs: tok_in,
            empty: init,
            cons: fn(acc, _) {
              match acc.done {
                true => acc
                false =>
                  match element_thunk.apply(acc.remaining, all_toks, root_in, table_in, acc.prov) {
                    ParseExprRejected { diagnostics: _ } =>
                      ParseRepeatAcc {
                        remaining: acc.remaining,
                        acc_nodes: acc.acc_nodes,
                        acc_diags: acc.acc_diags,
                        done: true,
                        prov: acc.prov
                      }
                    ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags, prov: prov1 } =>
                      match length(xs: rest) != length(xs: acc.remaining) {
                        true =>
                          ParseRepeatAcc {
                            remaining: rest,
                            acc_nodes: list_snoc_item(xs: acc.acc_nodes, item: cap),
                            acc_diags: list_append(left: acc.acc_diags, right: diags),
                            done: false,
                            prov: prov1
                          }
                        false =>
                          ParseRepeatAcc {
                            remaining: acc.remaining,
                            acc_nodes: acc.acc_nodes,
                            acc_diags: acc.acc_diags,
                            done: true,
                            prov: acc.prov
                          }
                      }
                  }
              }
            }
          )
          let stamped = parse_stamp_derived_repeat(acc_nodes: result.acc_nodes, prov: result.prov)
          ParseExprAccepted {
            remaining: result.remaining,
            captured: stamped.node,
            diagnostics: result.acc_diags,
            prov: stamped.prov
          }
        } }
      }
    }
  )
  thunk.apply(tokens, all_tokens, root, table, prov)
}


type ParseTableBuildAcc {
  table: ParseTable
  prov: ParseProvenanceState
}

fn parse_table_fill_production_step(
  acc: ParseTableBuildAcc,
  production: GrammarProduction,
  position: Int,
  all_tokens: List<Token>,
  root: GrammarRoot
) -> ParseTableBuildAcc {
  let key = ParsePositionKey { position: position, production: production.name }
  let suffix = tokens_at_position(all_tokens: all_tokens, position: position)
  let result = parse_expr(
    expr: production.expression,
    tokens: suffix,
    all_tokens: all_tokens,
    root: root,
    table: acc.table,
    prov: acc.prov
  )
  let next_prov = match result {
    ParseExprAccepted { prov: p, diagnostics: _, remaining: _, captured: _ } => p
    ParseExprRejected { diagnostics: _ } => acc.prov
  }
  ParseTableBuildAcc {
    table: parse_table_insert(table: acc.table, key: key, value: result),
    prov: next_prov
  }
}


// One pass: update every production entry at a fixed position.
fn parse_table_fill_position_pass(
  acc: ParseTableBuildAcc,
  position: Int,
  all_tokens: List<Token>,
  root: GrammarRoot
) -> ParseTableBuildAcc {
  fold_list(
    xs: root.productions,
    empty: acc,
    cons: fn(acc2, prod) {
      parse_table_fill_production_step(
        acc: acc2,
        production: prod,
        position: position,
        all_tokens: all_tokens,
        root: root
      )
    }
  )
}


// |productions| passes at one position — converges same-position wrapper chains (A = B; B = "x").
fn parse_table_fill_position(
  acc: ParseTableBuildAcc,
  position: Int,
  all_tokens: List<Token>,
  root: GrammarRoot
) -> ParseTableBuildAcc {
  fold_list(
    xs: root.productions,
    empty: acc,
    cons: fn(acc2, _) {
      parse_table_fill_position_pass(
        acc: acc2,
        position: position,
        all_tokens: all_tokens,
        root: root
      )
    }
  )
}


fn parse_table_empty() -> ParseTable {
  empty_map()
}


// Outer fold over positions high→low; inner fold over productions × passes at each position.
// Termination: (N+1) positions × K productions × K passes — structurally bounded, no fuel.
fn build_parse_table(all_tokens: List<Token>, root: GrammarRoot) -> ParseTableBuildAcc {
  fold_list_right(
    xs: token_position_indices(tokens: all_tokens),
    empty: ParseTableBuildAcc {
      table: parse_table_empty(),
      prov: parse_prov_initial()
    },
    snoc: fn(acc, position) {
      parse_table_fill_position(
        acc: acc,
        position: position,
        all_tokens: all_tokens,
        root: root
      )
    }
  )
}


fn parse_production(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol
) -> Outcome<ParseArtifact> {
  let root = validated.root
  let at = port_locus(port: parse_stage_locus_port)
  match grammar_lookup_production(root: root, name: production_name) {
    Holds { value: production } =>
      let built = build_parse_table(all_tokens: tokens, root: root)
      let key = ParsePositionKey { position: 0, production: production_name }
      match parse_table_lookup(table: built.table, key: key) {
        Holds { value: inner } =>
          match inner {
            ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags, prov: inner_prov } =>
              if is_empty(xs: remaining) {
                let merged_prov = parse_prov_merge(base: built.prov, incoming: inner_prov)
                let stamped = parse_wrap_production_captured(
                  production: production,
                  captured: captured,
                  prov: merged_prov
                )
                Accepted {
                  value: ParseArtifact { tree: stamped.node, span_index: stamped.prov.index },
                  diagnostics: parse_diags_to_diagnostics(diags: diags)
                }
              } else {
                Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
              }
            ParseExprRejected { diagnostics: diags } =>
              Rejected {
                diagnostics: parse_diags_to_non_empty(
                  diags: diags,
                  default: parse_e1_syntax_error_diagnostic(at: at)
                )
              }
          }
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
      }
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


// Back-compat projection — tree-only callers keep Outcome<ParseTree>; span_index via parse_production.
fn parse_production_tree(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol
) -> Outcome<ParseTree> {
  match parse_production(
    tokens: tokens,
    validated: validated,
    production_name: production_name
  ) {
    Accepted { value: artifact, diagnostics: d } =>
      Accepted { value: artifact.tree, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}


fn parse_module(tokens: TokenStream, grammar: ParseGrammar) -> Outcome<ParseArtifact> {
  let at = port_locus(port: parse_stage_locus_port)
  let ntok = length(xs: tokens.tokens)
  let grammar_node = grammar_to_node(grammar: grammar)
  if well_formed(n: grammar_node) {
    match grammar {
      VoidGrammar =>
        if ntok == 0 {
          Accepted {
            value: ParseArtifact { tree: grammar_node, span_index: span_index_empty() },
            diagnostics: None
          }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
        }
      ModeledGrammar { root: root } =>
        match grammar_validate_for_parse(root: root, at: at) {
          Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
          Accepted { value: validated, diagnostics: _ } =>
            parse_production(tokens: tokens.tokens, validated: validated, production_name: root.start)
        }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_not_well_formed_diagnostic(at: at)) }
  }
}


// Back-compat projection — tree-only callers keep Outcome<ParseTree>; span_index via parse_module.
fn parse(tokens: TokenStream, grammar: ParseGrammar) -> Outcome<ParseTree> {
  match parse_module(tokens: tokens, grammar: grammar) {
    Accepted { value: artifact, diagnostics: d } =>
      Accepted { value: artifact.tree, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
