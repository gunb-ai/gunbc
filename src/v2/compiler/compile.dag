// THIS MODULE IS THE COMPILER PIPELINE ENTRY. It carries the fact rather than being recognised
// by name: the emitter selected its entry-point arm by matching "v1.compiler.compile", a
// literal this module could never satisfy, so a crate emitted from this corpus was rendered
// with the no-entry-point refusal main no matter what it contained.
//
// SourceRootEvalDriver, and the difference from both siblings is a fact about what the emitted
// binary is FOR. RetainedHostCliKernel is unrenderable here (a crate emitted from this corpus
// does not contain v1_compiler.cli_run). DirectIngestDriver renders a one-source translate
// probe -- a census instrument for the standalone front door, which cannot resolve a module
// against its real peers and so cannot execute a repository test. SourceRootEvalDriver renders
// the repository test-execution route: the host reads the declared source roots and a universe
// of qualified test identities, and the pipeline assembles the ingest once, prepares each
// module (resolve + infer), and Evals each named test body, one typed verdict row per member.
// The driver functions below are the contract the rendered main calls.

data compiler_pipeline_entry: CompilerEntryDriver = SourceRootEvalDriver

type CoreNode = Node

type RuntimeTarget = Node

type CompileMode
  = TranslateTo { target: TargetModel }
  | Eval { runtime: RuntimeTarget }

type CompileOutput
  = TranslateResult { source: Medium<String> }
  | EvalResult { value: Medium<Node> }

type CompileLensOutcome = Outcome<Witness<Node>>

type CompileLensGate = fn(InferredTree) -> CompileLensOutcome

// IDENTITY-BEARING REGISTRATION. A registration used to carry its gate function and nothing else,
// so a witness coming back out of the door named no producer: roster and observations could not be
// joined, and "the required lenses ran" was a claim about a list length. A registration now carries
// the DeclarationRef of the gate authority that decides it and the GRAIN that gate is legitimate
// at, and every witness is stamped with both -- so registration and observation form one closed,
// machine-checkable join (required_lens_coverage) rather than two lists of equal length.
//
// WHAT THAT JOIN DOES NOT ESTABLISH, AND ITS RUNG (review 64177, DESIGN section 4b(2)). The join
// closes over the identity FIELD. Nothing binds that field to the `gate` beside it: both are
// authored on the same row by hand, so swapping two rows' gates, or repointing a `gate` at a
// different wrapper while leaving `identity` alone, leaves the join closed and the roster digest
// unchanged. Coverage is therefore closed over a NAME, and the claim it supports is "a gate
// registered under this identity ran at this grain", not "the declaration this identity names ran".
// The residual sits at MITIGATION: a typed field, authored and unverified.
// The class is `gunbc.recurring_failure_mode comparison_whose_operands_share_a_producer`: the join's
// two sides here are the authored name and a witness stamped FROM that same authored name.
//
// NO DISCRIMINATING RED IS AUTHORABLE TODAY, which is why this is a stated ceiling rather than a
// missing test. A control would have to recover a declaration identity FROM a function value and
// compare it to the authored one; a `CompileLensGate` is an opaque function value in this
// substrate, and nothing about the declaration it came from survives into it. A control comparing
// the authored identity to itself would be the decoration DESIGN section 4b warns about at the top
// rung -- permanently green, and worse than absent because it would be cited as coverage of exactly
// the gap it does not close.
//
// NEXT-RUNG TRIGGER: a reified declaration identity for function values -- the substrate carrying,
// on a function value, the DeclarationRef of the declaration it was built from. With that, the
// identity field stops being authored at all: it is DERIVED from the gate, the two cannot disagree
// by construction, and this row's identity/gate pair collapses to one fact. That is the climb from
// mitigation to structural impossibility, and it is a language-layer capability rather than
// something this module can build.
// ONE ROSTER, PARTITIONED BY GRAIN. The two grains stay semantically load-bearing (see
// required_lens_grain_note) but they are no longer two registration surfaces: grain is a field and
// required_lenses_at_grain derives each execution's roster from the single roster. A second list
// would be the fork this registration exists to close (DESIGN section 3).
// DIVERGENCE, STATED (DESIGN section 3b): the brief named a new type RequiredCompileLens beside
// CompileLens. Requiredness is membership in required_compile_lens_roster, not a property of the
// carrier -- a caller-supplied lens has the same three facts and must stamp its witnesses the same
// way for the join to be closed at all -- so one carrier gains the two fields instead.
type CompileLensGrain
  = CompileLensRoot
  | CompileLensSubtree

type CompileLens {
  identity: DeclarationRef
  grain: CompileLensGrain
  gate: CompileLensGate
}

fn compile_lens_grain_name(grain: CompileLensGrain) -> String {
  match grain {
    CompileLensRoot => "root"
    CompileLensSubtree => "subtree"
  }
}

fn compile_lens_grain_eq(a: CompileLensGrain, b: CompileLensGrain) -> Bool {
  match a {
    CompileLensRoot =>
      match b {
        CompileLensRoot => true
        CompileLensSubtree => false
      }
    CompileLensSubtree =>
      match b {
        CompileLensRoot => false
        CompileLensSubtree => true
      }
  }
}

type CompileLensMode
  = CompileLensEnforce
  | CompileLensIntrospect

// A witness names the registration that produced it and the grain it was produced at. Both are
// required for the join to refuse rather than widen: identity answers "which lens", grain answers
// "was it run where it is legitimate", and neither is recoverable from Witness<Node>.
type LensGateWitness {
  lens: DeclarationRef
  grain: CompileLensGrain
  witness: Witness<Node>
}

// THE COVERAGE RECEIPT IS A DECLARED FRONTIER, AND THIS IS ITS TRIGGER (DESIGN section 3c).
// The JOIN is consumed by execution in this change -- validate_then_compile refuses a compile whose
// coverage is not closed, which is the gate. The receipt CARRIED here is a different declaration
// with a different consumer, and today nothing outside this module reads it. Naming the census as a
// consumer without a trigger would be the half-classification section 3c refuses, so the trigger is
// stated as the capability rather than as an artifact:
//
//   CONSUMER: self-host promotion admission -- the candidate and successor coverage fields on
//   SelfHostCandidate, where promotion refuses BY NAME on a lens that did not run.
//   ROUTE: the candidate compile path runs through validate_then_compile, so the receipt this field
//   carries is what admission reads rather than re-deriving; re-deriving it there would be a second
//   authority on which lenses ran (DESIGN section 3).
//   TRIGGER: the promotion path routing its candidate through this door and refusing on a named
//   uncovered lens -- sufficient that a candidate cannot be promoted without its coverage having
//   been observed on the same compile that produced it.
//
// If that capability does not land, this field is redundant work and the honest move is to DELETE
// it rather than to keep it: the refusal above is already the gate, and a receipt nobody reads is
// section 2's redundant work however well shaped it is.
type Validated<T> {
  value: T
  lens_witnesses: List<LensGateWitness>
  required_lens_coverage: RequiredLensCoverage
}

fn compile_pipeline_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^compile_pipeline_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_lens_gate_rejected_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^compile_lens_gate_rejected,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_eval_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^compile_eval_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

