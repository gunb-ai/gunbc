data undecidable_verdict_collapse_lens: CompileLens = CompileLens {
  identity: decl_ref(module_path: "v2.lens.undecidable_verdict_collapse", decl_name: "undecidable_verdict_collapse_compile_gate"),
  grain: CompileLensRoot,
  gate: undecidable_verdict_collapse_root_gate
}

data required_lens_grain_note: String = "Two registered grains, one roster, one door (validate_then_compile is the single gate authority; per sharp-bee-290 contract 2026-07-13 no second gate surface exists). A CompileLensSubtree registration runs PER SUBTREE NODE (node-local predicates: fact_density, unit_modeling, lifecycle_carrier -- each gate reads only the node's direct children; a nested subtree walk inside the gate would stack with run_required_lens_gates_on_subtree's fold_node and be O(n^2)). A CompileLensRoot registration runs ONCE at the tree root -- the grain for rooted whole-tree walks (accumulator-copy carrier threading), where per-node invocation would be O(n^2): the enforcement of the complexity lens must not itself violate the complexity lens (DESIGN 7 self-application). The grain is a FIELD on the registration and required_lenses_at_grain derives each execution's list from the one roster, so this cost argument is carried by the row rather than by which of two lists a lens was written into. Witness accumulation on the subtree fold CONCATENATES the child's accumulated list into the accumulator at every step and reverses once at the end, which copies one operand per step and is the accumulator-copy shape this very door's own lens exists to refuse (DESIGN 7 self-application, measured and named rather than asserted away). It is stated here because this string is a COMPARED VALUE and a false cost claim in it would be green by equality on both sides. The repair is not an argument order: list_append costs its LEFT operand and the carrier's rc_list_concat copies its RIGHT one, and neither the accumulator nor a child's subtree accumulation is reliably the shorter, so a fold over a tree stays superlinear whichever way it is written. The defect, its capability trigger and the experiment already falsified against it are carried by gunbc.recurring_failure_mode enforcement_exhibits_the_shape_it_refuses. Required registrations at both grains fire on every validate_then_compile call regardless of caller-supplied lenses, and a caller-supplied lens now runs at ITS OWN declared grain rather than at root whatever it declared."

// THE SINGLE REGISTRATION ROSTER. Every lens the compile door is obliged to run is a row here, at
// the grain it is legitimate at; the two execution sites derive their lists from this one roster
// through required_lenses_at_grain. Adding a lens is one row, and the row is what the coverage
// join, the roster digest and (downstream) the obligation census all key on.
//
// WHAT IS NOT ELIGIBLE FOR A ROW, carried forward verbatim in force from the two-list form this
// roster replaced, because the prohibition is about the DOOR and not about which list held it.
// lens_module_gate was DE-ENROLLED from the root grain (census follow-on to run 29892063728
// receipts): its compile_gate wrapper discarded the tree argument and ran the nullary corpus scan
// lens_module_gate_blocking_holds - a live walk of src/v2/lens on every compile, making every
// compile-importing entry reach a live-read carrier and putting 31 SubstrateInputsOnly witness
// stamps in the lying_substrate_inputs_only_stamp_census red class. Enforcement was NOT reduced: the
// invariant executes per-PR via its honestly-stamped consumer
// v2.test.claim.enforcement.lens_module_gate_witness (live_tree_disposition: ReadsLiveTree, never
// predict-skips), which reds the floor when registry completeness breaks.
// SO THE ELIGIBILITY RULE, stated because "adding a lens is one row" would otherwise read as an
// invitation to the exact regression: a row here must be a PURE FOLD OVER THE TREE BEING COMPILED
// at its declared grain. A nullary gate, a corpus scan, or any gate that reads the live tree rather
// than its InferredTree argument is not eligible at either grain - a corpus-grain invariant enrolls
// on the corpus cadence with a ReadsLiveTree stamp, never in the per-tree door, and re-registering
// one here re-opens the census class.
fn required_compile_lens_roster() -> List<CompileLens> {
  [
    fact_density_lens,
    unit_modeling_lens,
    lifecycle_carrier_lens,
    accumulator_copy_lens,
    determinism_lens,
    machine_shape_lens,
    mandatory_tag_lens,
    undecidable_verdict_collapse_lens
  ]
}

fn lenses_at_grain(lenses: List<CompileLens>, grain: CompileLensGrain) -> List<CompileLens> {
  list_reverse(xs: fold_list(
    xs: lenses,
    empty: Empty,
    cons: fn(acc, lens) {
      if compile_lens_grain_eq(a: lens.grain, b: grain) { Cons { head: lens, tail: acc } } else { acc }
    }
  ))
}

fn required_lenses_at_grain(grain: CompileLensGrain) -> List<CompileLens> {
  lenses_at_grain(lenses: required_compile_lens_roster(), grain: grain)
}

// THE ROSTER DIGEST IS OVER IDENTITY AND GRAIN, IN ROSTER ORDER, and the order is part of it: two
// consumers re-deriving from this one entry point see one order, so a receipt carrying a digest is
// a claim about WHICH IDENTITIES were obliged, not merely how many. It deliberately does not cover
// the gate function -- and the honest reading is narrower than "the gate is named by the identity
// it is registered under", which is what this sentence used to say: nothing verifies that pairing
// (see the registration annotation above), so a digest is a claim about the registered names and
// their grains, and is unchanged by a gate swap underneath them.
fn required_lens_roster_digest_text(lenses: List<CompileLens>) -> String {
  fold_list(
    xs: lenses,
    empty: "",
    cons: fn(acc, lens) {
      concat(
        concat(concat(acc, declaration_ref_display_key(ref: lens.identity)), "@"),
        concat(compile_lens_grain_name(grain: lens.grain), "\n")
      )
    }
  )
}

fn required_lens_roster_digest_of(lenses: List<CompileLens>) -> String {
  serialize_content_hash(
    hash: content_hash_of_value(value: required_lens_roster_digest_text(lenses: lenses) as NonEmptyStr)
  )
}

fn required_lens_roster_digest() -> String {
  required_lens_roster_digest_of(lenses: required_compile_lens_roster())
}

// THE BIDIRECTIONAL JOIN. Registration and observation are two sides of one fact, and every way
// they can disagree is an arm -- none of them a skip, none of them a widen (DESIGN section 5). A
// registration nobody observed is the silent hole this whole change exists to close; an observation
// naming no registration is a lens running through the door off the roster; a grain disagreement
// means the gate ran somewhere its own cost argument does not hold; a root lens observed twice means
// the root roster was run more than once per tree. Subtree-grain registrations are observed ONCE PER
// NODE by construction, so their obligation is at-least-one, and only the root grain can state
// exactly-one -- stating exactly-one for both would refuse every tree with more than one node.
type RequiredLensCoverageRow {
  lens: DeclarationRef
  grain: CompileLensGrain
  observations: Int
}

type RequiredLensJoinCause
  = RequiredLensRosterEmpty
  | RegistrationDuplicated { lens: DeclarationRef }
  | RegistrationUnobserved { lens: DeclarationRef }
  | ObservationUnregistered { lens: DeclarationRef }
  | ObservedAtWrongGrain { lens: DeclarationRef }
  | RootLensObservedMoreThanOnce { lens: DeclarationRef }

type RequiredLensCoverage
  = RequiredLensCoverageClosed {
      roster_digest: String
      rows: List<RequiredLensCoverageRow>
    }
  | RequiredLensCoverageRefused { cause: RequiredLensJoinCause }

fn required_lens_join_cause_reason(cause: RequiredLensJoinCause) -> Symbol {
  match cause {
    RequiredLensRosterEmpty => ^required_lens_roster_empty
    RegistrationDuplicated { lens: _ } => ^required_lens_registration_duplicated
    RegistrationUnobserved { lens: _ } => ^required_lens_registration_unobserved
    ObservationUnregistered { lens: _ } => ^required_lens_observation_unregistered
    ObservedAtWrongGrain { lens: _ } => ^required_lens_observed_at_wrong_grain
    RootLensObservedMoreThanOnce { lens: _ } => ^required_lens_root_observed_more_than_once
  }
}

type RequiredLensTally {
  grain: CompileLensGrain
  observations: Int
  mixed_grain: Bool
}

// Joins are keyed through map_lookup on the display key, never through map_keys: a key-order read
// is exactly what the determinism lens registered here refuses, and the join must be linear in the
// observation count rather than quadratic over the roster (DESIGN section 6, bare minimum cost).
fn required_lens_tally_observations(witnesses: List<LensGateWitness>) -> Map<String, RequiredLensTally> {
  fold_list(
    xs: witnesses,
    empty: empty_map(),
    cons: fn(acc, w) {
      match map_lookup(acc, declaration_ref_display_key(ref: w.lens)) {
        Absent =>
          map_insert(acc, declaration_ref_display_key(ref: w.lens),
            RequiredLensTally { grain: w.grain, observations: 1, mixed_grain: false })
        Present { value: t } =>
          map_insert(acc, declaration_ref_display_key(ref: w.lens),
            RequiredLensTally {
              grain: t.grain,
              observations: t.observations + 1,
              mixed_grain: t.mixed_grain || !compile_lens_grain_eq(a: t.grain, b: w.grain)
            })
      }
    }
  )
}

fn required_lens_registration_keys(lenses: List<CompileLens>) -> Map<String, CompileLensGrain> {
  fold_list(
    xs: lenses,
    empty: empty_map(),
    cons: fn(acc, lens) { map_insert(acc, declaration_ref_display_key(ref: lens.identity), lens.grain) }
  )
}

fn required_lens_first_duplicate(lenses: List<CompileLens>) -> Optional<DeclarationRef> {
  let scan = fold_list(
    xs: lenses,
    empty: RequiredLensDuplicateScan { seen: empty_map(), duplicate: Absent },
    cons: fn(acc, lens) {
      match map_lookup(acc.seen, declaration_ref_display_key(ref: lens.identity)) {
        Absent =>
          RequiredLensDuplicateScan {
            seen: map_insert(acc.seen, declaration_ref_display_key(ref: lens.identity), true),
            duplicate: acc.duplicate
          }
        Present { value: _ } =>
          RequiredLensDuplicateScan {
            seen: acc.seen,
            duplicate: match acc.duplicate {
              Absent => Present { value: lens.identity }
              Present { value: d } => Present { value: d }
            }
          }
      }
    }
  )
  scan.duplicate
}

type RequiredLensDuplicateScan {
  seen: Map<String, Bool>
  duplicate: Optional<DeclarationRef>
}

type RequiredLensRowScan {
  rows_reversed: List<RequiredLensCoverageRow>
  cause: Optional<RequiredLensJoinCause>
}

fn required_lens_row_scan_refuse(
  acc: RequiredLensRowScan,
  cause: RequiredLensJoinCause
) -> RequiredLensRowScan {
  match acc.cause {
    Absent => RequiredLensRowScan { rows_reversed: acc.rows_reversed, cause: Present { value: cause } }
    Present { value: _ } => acc
  }
}

fn required_lens_row_for_registration(
  acc: RequiredLensRowScan,
  lens: CompileLens,
  tallies: Map<String, RequiredLensTally>
) -> RequiredLensRowScan {
  match map_lookup(tallies, declaration_ref_display_key(ref: lens.identity)) {
    Absent => required_lens_row_scan_refuse(acc: acc, cause: RegistrationUnobserved { lens: lens.identity })
    Present { value: t } =>
      if t.mixed_grain || !compile_lens_grain_eq(a: t.grain, b: lens.grain) {
        required_lens_row_scan_refuse(acc: acc, cause: ObservedAtWrongGrain { lens: lens.identity })
      } else {
        match lens.grain {
          CompileLensRoot =>
            if t.observations == 1 {
              RequiredLensRowScan {
                rows_reversed: Cons {
                  head: RequiredLensCoverageRow { lens: lens.identity, grain: lens.grain, observations: t.observations },
                  tail: acc.rows_reversed
                },
                cause: acc.cause
              }
            } else {
              required_lens_row_scan_refuse(acc: acc, cause: RootLensObservedMoreThanOnce { lens: lens.identity })
            }
          CompileLensSubtree =>
            RequiredLensRowScan {
              rows_reversed: Cons {
                head: RequiredLensCoverageRow { lens: lens.identity, grain: lens.grain, observations: t.observations },
                tail: acc.rows_reversed
              },
              cause: acc.cause
            }
        }
      }
  }
}

fn required_lens_unregistered_observation(
  witnesses: List<LensGateWitness>,
  registrations: Map<String, CompileLensGrain>
) -> Optional<DeclarationRef> {
  fold_list(
    xs: witnesses,
    empty: optional_absent(),
    cons: fn(acc, w) {
      match acc {
        Present { value: d } => Present { value: d }
        Absent =>
          match map_lookup(registrations, declaration_ref_display_key(ref: w.lens)) {
            Present { value: _ } => optional_absent()
            Absent => Present { value: w.lens }
          }
      }
    }
  )
}

fn join_required_lens_coverage(
  lenses: List<CompileLens>,
  witnesses: List<LensGateWitness>
) -> RequiredLensCoverage {
  match lenses {
    Empty => RequiredLensCoverageRefused { cause: RequiredLensRosterEmpty }
    Cons { head: _, tail: _ } =>
      match required_lens_first_duplicate(lenses: lenses) {
        Present { value: d } => RequiredLensCoverageRefused { cause: RegistrationDuplicated { lens: d } }
        Absent =>
          match required_lens_unregistered_observation(
            witnesses: witnesses,
            registrations: required_lens_registration_keys(lenses: lenses)
          ) {
            Present { value: u } => RequiredLensCoverageRefused { cause: ObservationUnregistered { lens: u } }
            Absent =>
              let tallies = required_lens_tally_observations(witnesses: witnesses)
              let scan = fold_list(
                xs: lenses,
                empty: RequiredLensRowScan { rows_reversed: Empty, cause: optional_absent() },
                cons: fn(acc, lens) {
                  required_lens_row_for_registration(acc: acc, lens: lens, tallies: tallies)
                }
              )
              match scan.cause {
                Present { value: cause } => RequiredLensCoverageRefused { cause: cause }
                Absent =>
                  RequiredLensCoverageClosed {
                    roster_digest: required_lens_roster_digest_of(lenses: lenses),
                    rows: list_reverse(xs: scan.rows_reversed)
                  }
              }
          }
      }
  }
}

fn required_lens_coverage_not_closed_diagnostic(cause: RequiredLensJoinCause) -> Diagnostic {
  Diagnostic {
    reason: required_lens_join_cause_reason(cause: cause),
    at: invariant_port_locus(port: ^required_lens_coverage, invariant: ^required_lens_coverage_closed),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn accumulator_copy_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  accumulator_copy_compile_gate(node: tree.root)
}

fn determinism_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  determinism_compile_gate(node: tree.root)
}

fn machine_shape_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  machine_shape_compile_gate(node: tree.root)
}

// The compile door's binding of the mandatory_tag gate: the same gate, handed the member-kind provenance
// the resolved subject carries (ResolvedTree.member_kinds).
fn mandatory_tag_root_lens_with_provenance(lens: CompileLens, channel: MemberKindChannel) -> CompileLens {
  if lens.identity == mandatory_tag_lens.identity {
    CompileLens {
      identity: lens.identity,
      grain: lens.grain,
      gate: fn(tree) { mandatory_tag_compile_gate_with_provenance(node: tree.root, channel: channel) }
    }
  } else {
    lens
  }
}

fn mandatory_tag_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  mandatory_tag_compile_gate(node: tree.root)
}

fn undecidable_verdict_collapse_root_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  undecidable_verdict_collapse_compile_gate(node: tree.root)
}

fn fact_density_hollow_alias_compile_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  fact_density_hollow_alias_gate(node: tree.root)
}

fn unit_modeling_compile_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  unit_modeling_gate(node: tree.root)
}

fn lifecycle_carrier_compile_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  lifecycle_carrier_gate(node: tree.root)
}

fn run_compile_lens_gate(lens: CompileLens, inferred: InferredTree) -> Outcome<Witness<Node>> {
  lens.gate(inferred)
}

fn apply_compile_lens_introspect(
  lens: CompileLens,
  inferred: InferredTree
) -> Outcome<Witness<Node>> {
  match run_compile_lens_gate(lens: lens, inferred: inferred) {
    Accepted { value: w, diagnostics: od } =>
      outcome_with_diagnostics(value: w, diagnostics: od)
    Rejected { diagnostics: d } =>
      outcome_with_diagnostics(
        value: witness_violates(diagnostic: diagnostics_fatal(d: d)),
        diagnostics: Some { diagnostics: d }
      )
  }
}

fn apply_compile_lens(
  lens: CompileLens,
  inferred: InferredTree,
  mode: CompileLensMode
) -> Outcome<Witness<Node>> {
  match mode {
    CompileLensEnforce => run_compile_lens_gate(lens: lens, inferred: inferred)
    CompileLensIntrospect => apply_compile_lens_introspect(lens: lens, inferred: inferred)
  }
}

fn prepend_lens_gate_witness(
  witnesses: List<LensGateWitness>,
  lens: CompileLens,
  witness: Witness<Node>
) -> List<LensGateWitness> {
  Cons {
    head: LensGateWitness { lens: lens.identity, grain: lens.grain, witness: witness },
    tail: witnesses
  }
}

fn empty_lens_gate_witnesses() -> List<LensGateWitness> {
  []
}

fn run_required_lens_gates(
  inferred: InferredTree,
  lenses: List<CompileLens>
) -> Outcome<List<LensGateWitness>> {
  bind_outcome(
    o: fold(
      lenses,
      init: outcome_accepted(value: empty_lens_gate_witnesses()),
      f: fn(acc_outcome, lens) {
        match acc_outcome {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: witnesses, diagnostics: od } =>
            bind_outcome_accepted(
              od: od,
              inner: bind_outcome(
                o: apply_compile_lens(lens: lens, inferred: inferred, mode: CompileLensEnforce),
                f: fn(w) {
                  outcome_accepted(
                    value: prepend_lens_gate_witness(
                      witnesses: witnesses,
                      lens: lens,
                      witness: w
                    )
                  )
                }
              )
            )
        }
      }
    ),
    f: fn(collected) { outcome_accepted(value: list_reverse(xs: collected)) }
  )
}

fn run_required_lens_gates_on_subtree(
  inferred: InferredTree,
  lenses: List<CompileLens>
) -> Outcome<List<LensGateWitness>> {
  bind_outcome(
    o: fold_node(
      n: inferred.root,
      algebra: NodeFold {
        init: fn(n0) {
          run_required_lens_gates(
            inferred: InferredTree { root: n0, facts: inferred.facts },
            lenses: lenses
          )
        },
        step: fn(acc, _, child) {
          bind_outcome(o: acc, f: fn(ws) {
            bind_outcome(
              o: child,
              f: fn(child_ws) {
                outcome_accepted(value: list_append(left: child_ws, right: ws))
              }
            )
          })
        }
      }
    ),
    f: fn(collected) { outcome_accepted(value: list_reverse(xs: collected)) }
  )
}

fn compile_inferred_translate(
  inferred: InferredTree,
  target: TargetModel
) -> Outcome<Medium<String>> {
  emit(tree: inferred, target: target)
}

fn compile_inferred(
  inferred: InferredTree,
  mode: CompileMode
) -> Outcome<CompileOutput> {
  match mode {
    TranslateTo { target } =>
      bind_outcome(
        o: compile_inferred_translate(
          inferred: inferred,
          target: target
        ),
        f: fn(target_source) {
          outcome_accepted(TranslateResult { source: target_source })
        }
      )
    Eval { runtime: runtime } =>
      bind_outcome(
        o: eval_node(
          tree: inferred,
          inputs: inputs_root_only(root: runtime)
        ),
        f: fn(value) {
          outcome_accepted(
            EvalResult {
              value: Medium { carried: value, fidelity: Lossless }
            }
          )
        }
      )
  }
}

fn compile(
  source: ResolvedTree,
  mode: CompileMode
) -> Outcome<CompileOutput> {
  bind_outcome(
    o: infer_and_discharge(tree: source),
    f: fn(inferred) {
      compile_inferred(inferred: inferred, mode: mode)
    }
  )
}

fn validated_from_compile_output(
  output: CompileOutput,
  lens_witnesses: List<LensGateWitness>,
  coverage: RequiredLensCoverage
) -> Validated<CompileOutput> {
  Validated {
    value: output,
    lens_witnesses: lens_witnesses,
    required_lens_coverage: coverage
  }
}

// THE DOOR RUNS EACH LENS AT ITS REGISTERED GRAIN, INCLUDING CALLER-SUPPLIED ONES. Caller lenses
// used to be appended to the root roster whatever grain they belonged to, which made the grain a
// comment rather than a fact; they are partitioned by their own declared grain now, exactly like
// registrations. The required roster still fires on every call regardless of caller lenses.
// THE COVERAGE JOIN RUNS AT THIS DOOR, AND WHAT IT CATCHES HERE IS NARROWER THAN THE JOIN ITSELF.
// It is a gate rather than a report -- a refusal by name fails the compile -- but this annotation
// used to say that "an obligation that silently stopped executing stops the line", and that is
// FALSE at this door (review 64196). Both sides of the join are derived from
// `required_compile_lens_roster()` inside one call: `run_required_lens_gates` folds the roster and
// stamps each witness with the `identity` and `grain` of the very row it is folding, so the
// observation list is a structural image of the roster rather than an independent reading of it.
// `required_lens_observations` then drops any witness whose identity is not a registration before
// the join is even asked. So `RegistrationUnobserved`, `ObservedAtWrongGrain`,
// `RootLensObservedMoreThanOnce` and `ObservationUnregistered` have NO authorable RED on this path.
// What can fire here is `RegistrationDuplicated` -- two roster rows sharing an identity -- and
// `RequiredLensRosterEmpty`. An obligation that stops executing does so by LEAVING THE ROSTER, and
// a join whose both sides come from the roster cannot see that by construction.
//
// The arms are not decoration, because they are discriminated where their REDs are authorable: a
// fixture may hand the join an observation set this door cannot produce, and
// `v2.test.lens_application.required_lens_coverage_join` does exactly that for every arm. DESIGN
// section 4b is explicit that a state unrepresentable in the accepted corpus may still be
// representable as source handed to the compiler by a fixture, and that declining the evidence
// there would be specification-without-execution. The honest statement is therefore about grain:
// fixture-grain the join discriminates six ways; door-grain it catches a duplicated or empty roster.
//
// THE CLASS IS ROSTERED: `gunbc.recurring_failure_mode comparison_whose_operands_share_a_producer`,
// whose discriminator is the one sentence that finds this without reading any witness -- the
// comparison's two operands have a common producer. Both of this file's instances are its specimens.
//
// TRIGGER for the door-grain claim to become the one this annotation used to make: an INDEPENDENT
// observation channel -- a receipt carried out of the runner that executed the gates, rather than a
// list re-derived from the roster it is compared against. Until an observation can disagree with a
// registration at this door, no wording here may claim it would be caught (DESIGN sections 4b(1),
// 4b(2), 5).
fn validate_then_compile(
  source: ResolvedTree,
  lenses: List<CompileLens>,
  mode: CompileMode
) -> Outcome<Validated<CompileOutput>> {
  bind_outcome(
    o: infer_and_discharge(tree: source),
    f: fn(inferred) {
      bind_outcome(
        o: run_required_lens_gates_on_subtree(
          inferred: inferred,
          lenses: list_append(
            left: required_lenses_at_grain(grain: CompileLensSubtree),
            right: lenses_at_grain(lenses: lenses, grain: CompileLensSubtree)
          )
        ),
        f: fn(subtree_witnesses) {
          bind_outcome(
            o: run_required_lens_gates(
              inferred: inferred,
              lenses: fold(
                list_append(
                  left: required_lenses_at_grain(grain: CompileLensRoot),
                  right: lenses_at_grain(lenses: lenses, grain: CompileLensRoot)
                ),
                init: [],
                f: fn(acc, l) { list_snoc_item(xs: acc, item: mandatory_tag_root_lens_with_provenance(lens: l, channel: source.member_kinds)) }
              )
            ),
            f: fn(root_witnesses) {
              let all_witnesses = list_append(left: subtree_witnesses, right: root_witnesses)
              match join_required_lens_coverage(
                lenses: required_compile_lens_roster(),
                witnesses: required_lens_observations(
                  witnesses: all_witnesses,
                  lenses: required_compile_lens_roster()
                )
              ) {
                RequiredLensCoverageRefused { cause: cause } =>
                  outcome_rejected(d: required_lens_coverage_not_closed_diagnostic(cause: cause))
                RequiredLensCoverageClosed { roster_digest: digest, rows: rows } =>
                  bind_outcome(
                    o: compile_inferred(inferred: inferred, mode: mode),
                    f: fn(compile_out) {
                      outcome_accepted(
                        value: validated_from_compile_output(
                          output: compile_out,
                          lens_witnesses: all_witnesses,
                          coverage: RequiredLensCoverageClosed { roster_digest: digest, rows: rows }
                        )
                      )
                    }
                  )
              }
            }
          )
        }
      )
    }
  )
}

// The join is asked about the REQUIRED roster, so caller-supplied observations are selected out
// before it runs rather than being excused inside it: an unregistered observation must stay a
// refusal for the roster it is asked about.
fn required_lens_observations(
  witnesses: List<LensGateWitness>,
  lenses: List<CompileLens>
) -> List<LensGateWitness> {
  let registrations = required_lens_registration_keys(lenses: lenses)
  list_reverse(xs: fold_list(
    xs: witnesses,
    empty: Empty,
    cons: fn(acc, w) {
      match map_lookup(registrations, declaration_ref_display_key(ref: w.lens)) {
        Present { value: _ } => Cons { head: w, tail: acc }
        Absent => acc
      }
    }
  ))
}

fn compile_ingest_with_admission(
  source: Medium<String>,
  target: TargetModel,
  peer_roots: FreeMonoid<NormalizedTree>,
  admission: Admission
) -> Outcome<Medium<String>> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(
      text: source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          bind_outcome(
            o: normalize(parse_tree: parse_tree),
            f: fn(normalized) {
              let roots = Cons { head: normalized, tail: peer_roots }
              bind_outcome(
                o: resolve_with_admission(
                  lm: lm,
                  roots: roots,
                  admission: admission
                ),
                f: fn(resolved) {
                  bind_outcome(
                    o: validate_then_compile(
                      source: resolved,
                      lenses: [],
                      mode: TranslateTo { target: target }
                    ),
                    f: fn(validated) {
                      match validated.value {
                        TranslateResult { source: target_source } =>
                          outcome_accepted(target_source)
                        EvalResult { value: _ } =>
                          outcome_rejected(
                            compile_eval_not_realized_diagnostic(
                              at: invariant_port_locus(port: ^compile_stage_locus_port, invariant: ^compile_eval_not_realized)
                            )
                          )
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}


// THE ENTRY A COMMAND LINE CAN BE WIRED TO, MODELLED HERE RATHER THAN AUTHORED IN THE EMITTER.
//
// compile_ingest_with_admission is the transaction a compiler driver wants -- source text and a
// target in, emitted text out -- but it takes four arguments whose values are facts about HOW a
// driver is admitting a single standalone source, not facts a command line supplies. Modelling
// that binding here keeps the emitted `main` a thin argv shim: DESIGN section 6 lists a
// hand-authored projection the model should generate as a scaffold tell, and every line of driver
// logic authored as Rust string literals in the emitter is seed that has to shrink later.
//
// ONE SOURCE, NO PEERS, AND THE SUBJECT IS THIS DRIVER'S OWN. peer_roots is Empty because a
// standalone source has no sibling roots admitted alongside it; widening that later is a change to
// this function, not to the emitted main.

fn compile_dag_source_to_target_text(source_text: String) -> Outcome<Medium<String>> {
  compile_ingest_with_admission(
    source: Medium { carried: source_text, fidelity: Lossless },
    target: dag_target_model(),
    peer_roots: Empty,
    admission: Admission {
      subject: ResolutionSubject {
        name: Cons { head: ^compile_driver_subject, tail: Empty }
      },
      imports: Empty
    }
  )
}

fn compile_source_root_ingest_with_admission(
  ingest: SourceRootIngest,
  admission: Admission,
  target: TargetModel
) -> Outcome<Medium<String>> {
  let lm = dag_language_model()
  bind_outcome(
    o: assemble_program_from_ingest(ingest: ingest, admission: admission, lm: lm),
    f: fn(resolved) {
      bind_outcome(
        o: validate_then_compile(
          source: resolved,
          lenses: [],
          mode: TranslateTo { target: target }
        ),
        f: fn(validated) {
          match validated.value {
            TranslateResult { source: target_source } =>
              outcome_accepted(target_source)
            EvalResult { value: _ } =>
              outcome_rejected(
                compile_eval_not_realized_diagnostic(
                  at: invariant_port_locus(port: ^compile_stage_locus_port, invariant: ^compile_eval_not_realized)
                )
              )
          }
        }
      )
    }
  )
}

fn stage_tokenize(lm: LanguageModel) -> fn(Medium<String>) -> Outcome<TokenStream> {
  fn(source) {
    tokenize(
      text: source.carried,
      file: ^compile_ingest_staging_source_file,
      rules: lm.lex
    )
  }
}

fn stage_parse(lm: LanguageModel) -> fn(TokenStream) -> Outcome<ParseTree> {
  fn(token_stream) { parse(tokens: token_stream, grammar: lm.grammar) }
}

fn stage_normalize() -> fn(ParseTree) -> Outcome<NormalizedTree> {
  fn(parse_tree) { normalize(parse_tree: parse_tree) }
}

fn stage_resolve(lm: LanguageModel) -> fn(NormalizedTree) -> Outcome<ResolvedTree> {
  fn(normalized) { resolve(tree: normalized, lm: lm) }
}

fn stage_translate(target: TargetModel) -> fn(ResolvedTree) -> Outcome<Medium<String>> {
  fn(resolved) {
    bind_outcome(
      o: validate_then_compile(
        source: resolved,
        lenses: [],
        mode: TranslateTo { target: target }
      ),
      f: fn(validated) {
        match validated.value {
          TranslateResult { source: target_source } =>
            outcome_accepted(target_source)
          EvalResult { value: _ } =>
            outcome_rejected(
              compile_eval_not_realized_diagnostic(
                at: invariant_port_locus(port: ^compile_stage_locus_port, invariant: ^compile_eval_not_realized)
              )
            )
        }
      }
    )
  }
}

fn compile_ingest_staging(source: Medium<String>, target: TargetModel) -> Outcome<Medium<String>> {
  let lm = dag_language_model()
  let pipeline = then_outcome(
      f: stage_tokenize(lm: lm),
      g: then_outcome(
        f: stage_parse(lm: lm),
        g: then_outcome(
          f: stage_normalize(),
          g: then_outcome(
            f: stage_resolve(lm: lm),
            g: stage_translate(target: target)
          )
        )
      )
    )
  pipeline(source)
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE SOURCE-ROOT EVAL DRIVER — the terminal route `claim_executor --v2-native-route` executes.
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// THE TERMINAL SUBJECT IS A TEST VERDICT, NOT A TRANSLATION. DirectIngestDriver answers "the
// native compiler accepted this standalone source for translation"; this driver answers "this
// exact test identity, resolved against its real source roots, reached a native Eval verdict".
// The route mirrors the floor's execution mode — locate the named declaration, evaluate its
// body, require a Boolean — with the v2 pipeline's own evaluator standing in for the seed
// interpreter.
//
// THREE FUNCTIONS, ONE PER COST GRAIN. native_test_context_from_ingest pays the whole-ingest
// fold (tokenize/parse/normalize every source) ONCE per lane; it rejects only on a LANE-LEVEL
// defect (a grammar that fails to prepare), never on corpus data. native_test_prepare_module
// pays resolve + infer ONCE per module. native_test_eval_one pays entry resolution +
// evaluation per declaration and NEVER rejects: every failure it can reach is a typed
// NativeTestRefused verdict carrying the stage and the failing stage's own diagnostics -- the
// located chain, not one reason copied out of it -- so a census over observations has no
// silent remainder and a row that refused says where.
//
// THE PREPARE GRAIN IS TWO HALVES, AND THE SEAM IS THE PORTABILITY BOUNDARY. A seed-interpreted
// witness that drives this route evaluates in the required floor's per-claim frame, and the
// only value that crosses that frame is one the cross-claim pure tier can reify
// (v2.workflow.floor_pure_producer_share): the resolved tree is closure-free, the InferredTree
// one stage up carries the facts PartialFunction and is not — the same share point
// v2.compiler.self_host.direct_rust_door_fixture names for the same reason. So
// native_test_resolve_module and native_test_infer_resolved are the two halves, and
// native_test_prepare_module is their composition: the emitted lane harness keeps calling the
// composition, and a witness fixture shares at the resolved seam.
//
// THE PER-FILE FRONT-END REFUSAL IS CENSUS DATA, NOT A WHOLE-CONTEXT REFUSAL. The program
// assembly fold (v2.compiler.program_assembly) is wholesale fail-closed — one unparseable
// source fails the program — which is the right door for COMPILATION and the wrong shape for
// this census: the v2 front-end has a live corpus frontier (v2.workflow.compile_door_ledger),
// and a wholesale fold would let one frontier file deny verdict rows for every other member —
// the absorbing fallback in ingest form (DESIGN 5: the deficit's frequency reads zero because
// the whole lane is red). So the context fold below collects each source's tokenize/parse/
// normalize refusal as a NativeTestFileRefusal row and keeps folding. Nothing is thereby
// WIDENED: a refused file contributes no root, so its module is absent from the index, every
// test identity living in it surfaces as a Context-stage refusal row minted by the lane host
// from exactly these rows, and a module that PARSED but imports a refused file fails at
// Prepare with the resolver's own diagnostic. The lane's admission still refuses over any
// unattributed row — collection changes the grain of the refusal, never its force.
//
// NO LENS GATES ON THIS ROUTE, deliberately. validate_then_compile's required lenses are the
// COMPILE door's corpus invariants; the floor's seed-interpreter route does not run them per
// test either, and running them here would conflate the modeling door with the execution route
// and multiply their whole-tree cost by the test population.
// THIS IS NOT A MISSING PER-MODULE ROOT-LENS WIRING. A CompileLensRoot registration runs once
// at the compile subject's tree root, through that one door. native_test_infer_resolved is
// the prepare half of NativeTest evaluation; it is not a compile subject. That mandatory_tag
// therefore does not fire on every native-universe module is the layering, not a hole:
// corpus coverage of modules that never enter the door lives on v2.lens.mandatory_tag's
// parse-grain witness, and native compile-door coverage climbs when admitted subjects enter
// validate_then_compile (gunbc.v2_compile_obligation_census native_door_entry_trigger).

// The source-root index and the active roots live on `resolution` (ResolutionContext binds them once
// per ingest as admission inputs); a second copy here would be two authorities for one fact.
type NativeTestContext {
  resolution: Outcome<ResolutionContext>
  file_refusals: FreeMonoid<NativeTestFileRefusal>
  accepted_file_advisories: FreeMonoid<NativeTestFileAdvisories>
}

type NativeTestPreparedModule {
  module: QualifiedName
  inferred: InferredTree
}

// `alloc` IS THE OCCURRENCE-ID MARK THIS FOLD HAS REACHED, and it is here for the reason
// `std.occurrence_identity` `occurrence_identity_scope_law` gives: this fold walks a whole ingest,
// so it IS "a production source graph", and such a graph "threads one allocator across every parsed
// source" -- module-local allocator reset is a FORBIDDEN identity input. Before this field each
// read restarted at #0, so the roots this state accumulates carried ids that collided across files
// and the NativeTestContext could not tell two files' occurrence #3 apart.
//
// THAT IS NOT A LATENT PROBLEM HERE, IT IS A CONSUMED ONE: the SourceRootEval census
// (`gunbc.compiler_frontend_program_status`) joins this route's refusals "to occurrence identity
// where an id is minted", which is an occurrence-keyed join over a key that was not unique in the
// scope it was joined across -- a silent wrong answer rather than a missing one (DESIGN section 5).
type NativeTestContextFoldState {
  roots: FreeMonoid<NormalizedTree>
  index: SourceRootIndex
  file_refusals: FreeMonoid<NativeTestFileRefusal>
  accepted_file_advisories: FreeMonoid<NativeTestFileAdvisories>
  alloc: OccurrenceIdAllocator
}

// The LAST diagnostic is the cause that actually refused the file; the head is the advisory
// that rode along. Both are carried because ownership is keyed by grain.
// The module a refused file declares, as the typed name every other reader compares, parsed ONCE
// here from the header line the lane's own scan reads.
fn native_refused_file_module(content: String) -> Optional<QualifiedName> {
  match native_lane_declared_module_name(content: content) {
    Absent => optional_absent()
    Present { value: dotted } => optional_present(value: qualified_name_from_dotted_string(dotted: dotted))
  }
}

fn native_test_file_refusal(path: Symbol, module: Optional<QualifiedName>, d: NonEmptyDiagnostics, spans: SpanIndex, text: String) -> NativeTestFileRefusal {
  NativeTestFileRefusal {
    path: path,
    module: module,
    chain: FreeSemigroup {
      head: native_file_refusal_link(d: d.head, path: path, spans: spans, text: text),
      tail: fold_list(xs: d.tail, empty: Empty, cons: fn(acc, diag) {
        list_snoc_item(xs: acc, item: native_file_refusal_link(d: diag, path: path, spans: spans, text: text))
      })
    }
  }
}

// ONE LINK, RESOLVED HERE AND NOWHERE LATER. A node locus goes through THIS file's span index to
// its textual extent; a textual extent in THIS file becomes a line and byte column against THIS
// file's text (v2.std.source_position, which walks UTF-8 octets, never characters). Everything
// else keeps its own typed reason for having no line.
fn native_file_refusal_link(d: Diagnostic, path: Symbol, spans: SpanIndex, text: String) -> FileRefusalLink {
  FileRefusalLink { reason: d.reason, at: native_file_refusal_at(at: d.at, path: path, spans: spans, text: text) }
}

fn native_file_refusal_at(at: Locus, path: Symbol, spans: SpanIndex, text: String) -> FileRefusalAt {
  match at {
    Textual { file: f, extent: e } => native_file_refusal_textual(file: f, extent: e, path: path, text: text)
    SourcePortLocus { anchor: _, file: f, extent: e } => native_file_refusal_textual(file: f, extent: e, path: path, text: text)
    InvariantPortLocus { anchor: _, invariant: inv } => FileRefusalAtInvariant { invariant: inv }
    DeclarationLocus { declaration: q } => FileRefusalAtDeclaration { declaration: q }
    NodeLocus { anchor: a } =>
      match node_occurrence_id_optional(node: a.at) {
        Absent => FileRefusalAtUnresolvedNode
        Present { value: id } =>
          match span_index_textual_locus_optional(index: spans, id: id) {
            Absent => FileRefusalAtUnresolvedNode
            Present { value: resolved } =>
              match resolved {
                Textual { file: f, extent: e } => native_file_refusal_textual(file: f, extent: e, path: path, text: text)
                SourcePortLocus { anchor: _, file: f, extent: e } => native_file_refusal_textual(file: f, extent: e, path: path, text: text)
                NodeLocus { anchor: _ } => FileRefusalAtUnresolvedNode
                InvariantPortLocus { anchor: _, invariant: inv } => FileRefusalAtInvariant { invariant: inv }
                DeclarationLocus { declaration: q } => FileRefusalAtDeclaration { declaration: q }
              }
          }
      }
  }
}

fn native_file_refusal_textual(file: Symbol, extent: Extent, path: Symbol, text: String) -> FileRefusalAt {
  if file == path {
    match extent {
      WholeFile => FileRefusalAtWholeFile
      ByteRange { start: st, end: _ } => {
        let lc = source_line_col_at_byte(text: text, offset: st)
        FileRefusalAtLine { line: lc.line, byte_column: lc.byte_column }
      }
    }
  } else {
    FileRefusalAtOtherFile { file: file }
  }
}

// THE FILE'S ROOT, ABSORBED. This is the half of the per-file step that is NOT the front end:
// the qualified-name read off the module node and the source-root index insertion, plus the two
// refusal arms. It takes the root OUTCOME rather than the read, so the caller decides how the
// front end was entered -- as one composed call (native_test_context_from_ingest below) or phase
// by phase with a clock between them (std.compiler_entry.SourceRootEvalDriver). Neither caller
// changes what is absorbed.
// WHAT THIS ARM CARRIES, STATED AS THE CODE ACTUALLY BEHAVES (review 69819). Every arm stores the
// mark `program_assembly_read_to_normalized_root_seeded` returned, and that producer does NOT
// advance it uniformly: a read whose NORMALIZE or graft refused reports the mark its parse reached,
// while a read whose TOKENIZE or PARSE refused reports the mark it was HANDED. An earlier revision
// of this paragraph claimed the mark advances on every arm including the refusing ones. It does
// not, and that sentence was the same defect this package exists to correct -- prose asserting a
// behaviour the code does not have (DESIGN section 4c) -- written by the author who had just
// corrected it elsewhere.
//
// WHY THE PARSE-REFUSAL ARM DOES NOT ADVANCE, AND WHAT THAT COSTS. A refused parse has minted ids:
// `parse_prov_seeded` threads the allocator through the whole attempt. Those ids are reachable only
// from values the refusal discards -- `ParseExprRejected` carries no provenance state, by
// construction, because the parse core BACKTRACKS and a failed branch's mints are abandoned by
// design. So the mark the attempt reached is not recoverable here without threading provenance out
// of all 35 `ParseExprRejected` sites AND deciding what the allocator means across a backtrack,
// which is a change to the parse core and its own package, not a fold-threading detail.
//
// THE CONSTRAINT THAT MAKES THE CURRENT ARM SAFE, NAMED RATHER THAN ASSUMED. Reusing a refused
// parse's ids is sound exactly while nothing retains that parse's node loci. Today nothing does:
// `native_test_vocabulary` `NativeTestFileRefusal` keeps `path` and a chain of links whose positions
// are RESOLVED at the absorb (line and byte column, or a named port) -- no `Locus`, no occurrence id.
// Widening it to carry the front end's raw loci WITHOUT FIRST ADVANCING THIS MARK REOPENS THE
// COLLISION -- a refused file's retained `NodeLocus` would carry an
// id the next file re-mints and records a span for, and `span_index_merge` is base-wins, so the
// join would answer with a confident wrong file rather than refusing (DESIGN section 5). Whoever
// widens that record owns this precondition, and it is written here because that is where the reuse
// happens.
fn native_test_context_absorb(
  state: NativeTestContextFoldState,
  read: DagSourceReadWitness,
  root_outcome: Outcome<NormalizedTree>,
  alloc: OccurrenceIdAllocator,
  spans: SpanIndex
) -> NativeTestContextFoldState {
  match root_outcome {
    Rejected { diagnostics: d } =>
      NativeTestContextFoldState {
        roots: state.roots,
        index: state.index,
        file_refusals: list_snoc_item(
          xs: state.file_refusals,
          item: native_test_file_refusal(path: read.compilation_unit, module: native_refused_file_module(content: read.source.carried), d: d, spans: spans, text: read.source.carried)
        ),
        accepted_file_advisories: state.accepted_file_advisories,
        alloc: alloc
      }
    Accepted { value: root, diagnostics: advisories } =>
      match qualified_name_from_module_node(root: root.root) {
        Rejected { diagnostics: d } =>
          NativeTestContextFoldState {
            roots: state.roots,
            index: state.index,
            file_refusals: list_snoc_item(
              xs: state.file_refusals,
              item: native_test_file_refusal(path: read.compilation_unit, module: native_refused_file_module(content: read.source.carried), d: d, spans: spans, text: read.source.carried)
            ),
            accepted_file_advisories: state.accepted_file_advisories,
            alloc: alloc
          }
        Accepted { value: qn, diagnostics: _ } =>
          NativeTestContextFoldState {
            roots: list_snoc_item(xs: state.roots, item: root),
            index: source_root_index_insert(index: state.index, module: qn, root: read.source_root),
            file_refusals: state.file_refusals,
            accepted_file_advisories: native_test_accepted_advisories_absorb(
              rows: state.accepted_file_advisories,
              path: read.compilation_unit,
              advisories: advisories
            ),
            alloc: alloc
          }
      }
  }
}

// The module-name projection is a pure read of the accepted root and mints no advisory of its own;
// the file's advisories are the front end's, on `root_outcome`.
fn native_test_accepted_advisories_absorb(
  rows: FreeMonoid<NativeTestFileAdvisories>,
  path: Symbol,
  advisories: Diagnostics
) -> FreeMonoid<NativeTestFileAdvisories> {
  match advisories {
    None => rows
    Some { diagnostics: d } => list_snoc_item(xs: rows, item: native_test_file_advisories(path: path, d: d))
  }
}

fn native_test_context_fold_step(
  state: NativeTestContextFoldState,
  read: DagSourceReadWitness,
  lex: PreparedLexRules,
  prepared: PreparedGrammar,
  scope: Fnv1a64Structural
) -> NativeTestContextFoldState {
  let result = program_assembly_read_to_normalized_root_seeded(
    read: read,
    lex: lex,
    prepared: prepared,
    seed: state.alloc,
    scope: scope
  )
  native_test_context_absorb(
    state: state,
    read: read,
    root_outcome: result.produced,
    alloc: result.alloc,
    spans: result.spans
  )
}

// THE ONCE-PER-FOLD INVARIANT, NAMED. dag_language_model() rebuilds the grammar, lex rules and
// canonical-symbol set on every call and prepare_grammar runs the five validation checks and the
// FIRST/nullable analysis; both are pure functions of nothing, so both are paid once here and
// carried. Calling dag_language_model() inside the cons closure paid that once PER FILE --
// measured at ~0.3s/file of the context fold's wall time (2026-09-09, required-v2-native lane
// work), a pure recompute with no per-file dependency.
//
// IT IS A CARRIER BECAUSE THE PER-FILE SEAM NEEDS TO NAME IT. A driver that enters the front end
// phase by phase hands the same prepared front end to each file; a second dag_language_model()
// call on the driver side would be the same recompute re-introduced at the realization layer.
type NativeTestFrontEnd {
  lm: LanguageModel
  lex: PreparedLexRules
  prepared: PreparedGrammar
}

fn native_test_front_end_prepare() -> Outcome<NativeTestFrontEnd> {
  let lm = dag_language_model()
  match prepare_grammar(grammar: lm.grammar) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prepared, diagnostics: _ } =>
      outcome_accepted(value: NativeTestFrontEnd {
        lm: lm,
        lex: prepare_lex_rules(rules: lm.lex),
        prepared: prepared
      })
  }
}

fn native_test_context_state_empty() -> NativeTestContextFoldState {
  NativeTestContextFoldState {
    roots: Empty,
    index: source_root_index_empty(),
    file_refusals: Empty,
    accepted_file_advisories: Empty,
    alloc: occurrence_id_allocator_initial()
  }
}

fn native_test_context_finish(
  state: NativeTestContextFoldState,
  front: NativeTestFrontEnd,
  ingest: SourceRootIngest
) -> NativeTestContext {
  NativeTestContext {
    resolution: resolution_context(
      lm: front.lm,
      roots: state.roots,
      index: state.index,
      active_roots: source_root_set_from_ingest(ingest: ingest),
      policy: v2.std.resolution_policy.default_name_resolution_policy()
    ),
    file_refusals: state.file_refusals,
    accepted_file_advisories: state.accepted_file_advisories
  }
}

// The whole-ingest composition, retained as the single-call door: witnesses and any caller that
// does not own a clock keep calling this, and it is DEFINED BY the same parts the driver enters
// separately rather than restating the fold beside them.
fn native_test_context_from_ingest(ingest: SourceRootIngest) -> Outcome<NativeTestContext> {
  bind_outcome(
    o: native_test_front_end_prepare(),
    f: fn(front) {
      bind_outcome(o: program_assembly_ingest_scope_outcome(ingest: ingest), f: fn(scope) {
      outcome_accepted(value: native_test_context_finish(
        state: fold_list(
          xs: ingest,
          empty: native_test_context_state_empty(),
          cons: fn(state, read) {
            native_test_context_fold_step(
              state: state,
              read: read,
              lex: front.lex,
              prepared: front.prepared,
              scope: scope
            )
          }
        ),
        front: front,
        ingest: ingest
      ))
      })
    }
  )
}

// EVERY PER-MODULE STEP OVER A NativeTestContext RETURNS THE CONTEXT IT ENDED WITH. The context's
// resolution carries the module namespace provider (v2.compiler.name_resolve ResolutionContext
// `namespaces`), which produces a module's namespace at most once per ingest -- but only for a
// caller that binds the context it gets back. A loop over modules threads it; a caller that resolves
// once projects the value and drops it.
fn native_test_context_with_resolution(context: NativeTestContext, resolution: Outcome<ResolutionContext>) -> NativeTestContext {
  NativeTestContext {
    resolution: resolution,
    file_refusals: context.file_refusals,
    accepted_file_advisories: context.accepted_file_advisories
  }
}

fn native_test_module_admission(module: QualifiedName) -> Admission {
  Admission { subject: ResolutionSubject { name: module }, imports: Empty }
}

type NativeTestResolved {
  resolved: Outcome<ResolvedTree>
  context: NativeTestContext
}

fn native_test_resolve_module(
  context: NativeTestContext,
  module: QualifiedName
) -> NativeTestResolved {
  let step = resolve_in_context(context: context.resolution, admission: native_test_module_admission(module: module))
  NativeTestResolved {
    resolved: step.resolved,
    context: native_test_context_with_resolution(context: context, resolution: step.context)
  }
}

type NativeTestWalk {
  walk: ResolveNodeWalk
  context: NativeTestContext
}

// THE SAME RESOLUTION AS native_test_resolve_module, OBSERVED WHOLE: every independent failure
// chain, not only the first. native_test_resolve_module is its projection.
fn native_test_resolve_module_walk(
  context: NativeTestContext,
  module: QualifiedName
) -> NativeTestWalk {
  let step = resolve_walk_in_context(context: context.resolution, admission: native_test_module_admission(module: module))
  NativeTestWalk {
    walk: step.walk,
    context: native_test_context_with_resolution(context: context, resolution: step.context)
  }
}

fn native_test_infer_resolved(
  module: QualifiedName,
  resolved: ResolvedTree
) -> Outcome<NativeTestPreparedModule> {
  bind_outcome(
    o: infer_and_discharge(tree: resolved),
    f: fn(inferred) {
      outcome_accepted(value: NativeTestPreparedModule {
        module: module,
        inferred: inferred
      })
    }
  )
}

type NativeTestPrepared {
  prepared: Outcome<NativeTestPreparedModule>
  context: NativeTestContext
}

fn native_test_prepare_module(
  context: NativeTestContext,
  module: QualifiedName
) -> NativeTestPrepared {
  let step = native_test_resolve_module(context: context, module: module)
  NativeTestPrepared {
    prepared: bind_outcome(
      o: step.resolved,
      f: fn(resolved) { native_test_infer_resolved(module: module, resolved: resolved) }
    ),
    context: step.context
  }
}

// THE DECLARATION SEARCH IS EXACT: a test identity names a top-level declaration of one prepared
// module, so the search first resolves that module's scope node — unwrapping the module
// production wrapper through the namespace-graft authority, then walking one Named spine edge per
// qualified-name segment — and then matches DIRECT CHILDREN of the scope only. Descending into
// nested Named edges could select a same-named graft segment or an edge nested inside a
// declaration body and evaluate it under the requested identity. A scope walk that fails is a
// graft-shape surprise and surfaces as its own entry reason, deliberately absent from
// native_route_entry_limit_reasons so the surprise reds the lane instead of excluding tests.

fn native_test_module_scope_go(at: Node, segments: QualifiedName) -> Outcome<Node> {
  match segments {
    Empty => outcome_accepted(value: at)
    Cons { head: segment, tail: rest } =>
      bind_outcome(
        o: find_named_child(root: at, name: segment),
        f: fn(child) { native_test_module_scope_go(at: child, segments: rest) }
      )
  }
}

fn native_test_module_scope_node(root: Node, module: QualifiedName) -> Outcome<Node> {
  native_test_module_scope_go(
    at: namespace_graft_unwrap_module_working_root(root: root),
    segments: module
  )
}

fn native_test_decl_in_children(children: List<Edge>, name: Symbol) -> Optional<Node> {
  fold(children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: v } => optional_present(value: v)
      Absent =>
        match e.label {
          StructuralLabel { label: _ } => optional_absent()
          Authored { name: edge_name } =>
            if edge_name == name {
              optional_present(value: e.target)
            } else {
              optional_absent()
            }
          Positional => optional_absent()
        }
    }
  })
}

fn native_test_observation_refused(
  module: QualifiedName,
  declaration: Symbol,
  stage: NativeTestStage,
  diagnostics: NonEmptyDiagnostics
) -> NativeTestObservation {
  NativeTestObservation {
    module: module,
    declaration: declaration,
    verdict: NativeTestRefused { stage: stage, diagnostics: diagnostics }
  }
}

// THE ROUTE'S OWN ENTRY REFUSALS ARE LOCATED AT THE DECLARATION THEY ARE ABOUT. A declaration the
// scope does not hold, or holds as something other than an arrow, has no node the route can
// anchor (the first has no node at all; the second's node is its whole body), and it has exactly
// one identity: the qualified `<module>.<declaration>` the test identity already names.
fn native_test_entry_refused(
  module: QualifiedName,
  declaration: Symbol,
  reason: Symbol
) -> NativeTestObservation {
  NativeTestObservation {
    module: module,
    declaration: declaration,
    verdict: native_test_refused_located(
      stage: NativeTestStageEntry,
      reason: reason,
      at: declaration_locus(declaration: qualified_name_snoc(qn: module, segment: declaration))
    )
  }
}

fn native_test_eval_body(
  prepared: NativeTestPreparedModule,
  declaration: Symbol,
  body: Node
) -> NativeTestObservation {
  match eval(
    tree: prepared.inferred,
    interpretation: eval_default_interpretation(),
    inputs: inputs_root_only(root: body)
  ) {
    Rejected { diagnostics: d } =>
      native_test_observation_refused(
        module: prepared.module,
        declaration: declaration,
        stage: NativeTestStageEval,
        diagnostics: d
      )
    Accepted { value: rv, diagnostics: _ } =>
      if v2_eval_runtime_bool_is_true(value: rv) {
        NativeTestObservation {
          module: prepared.module,
          declaration: declaration,
          verdict: NativeTestPassed
        }
      } else if v2_eval_runtime_bool_is_false(value: rv) {
        NativeTestObservation {
          module: prepared.module,
          declaration: declaration,
          verdict: NativeTestReturnedFalse
        }
      } else {
        NativeTestObservation {
          module: prepared.module,
          declaration: declaration,
          verdict: NativeTestReturnedOther
        }
      }
  }
}

fn native_test_eval_one_not_arrow(
  prepared: NativeTestPreparedModule,
  declaration: Symbol
) -> NativeTestObservation {
  native_test_entry_refused(
    module: prepared.module,
    declaration: declaration,
    reason: ^native_test_entry_declaration_not_arrow
  )
}

fn native_test_eval_one(
  prepared: NativeTestPreparedModule,
  declaration: Symbol
) -> NativeTestObservation {
  match native_test_module_scope_node(root: prepared.inferred.root, module: prepared.module) {
    Rejected { diagnostics: d } =>
      NativeTestObservation {
        module: prepared.module,
        declaration: declaration,
        verdict: native_test_refused_after(
          stage: NativeTestStageEntry,
          reason: ^native_test_entry_module_scope_unresolved,
          d: d
        )
      }
    Accepted { value: scope, diagnostics: _ } =>
      match native_test_decl_in_children(children: scope.children, name: declaration) {
        Absent =>
          native_test_entry_refused(
            module: prepared.module,
            declaration: declaration,
            reason: ^native_test_entry_declaration_not_found
          )
        Present { value: target } =>
          match target.kind {
            TypeNode { connective: Arrow } =>
              match find_arrow_body_child(root: target) {
                Rejected { diagnostics: d } =>
                  native_test_observation_refused(
                    module: prepared.module,
                    declaration: declaration,
                    stage: NativeTestStageEntry,
                    diagnostics: d
                  )
                Accepted { value: body, diagnostics: _ } =>
                  native_test_eval_body(
                    prepared: prepared,
                    declaration: declaration,
                    body: body
                  )
              }
            TypeNode { connective: Atom { identity: _ } } => native_test_eval_one_not_arrow(prepared: prepared, declaration: declaration)
            TypeNode { connective: Conj } => native_test_eval_one_not_arrow(prepared: prepared, declaration: declaration)
            TypeNode { connective: Disj } => native_test_eval_one_not_arrow(prepared: prepared, declaration: declaration)
            TypeNode { connective: Cardinality } => native_test_eval_one_not_arrow(prepared: prepared, declaration: declaration)
            TypeNode { connective: Instantiation } => native_test_eval_one_not_arrow(prepared: prepared, declaration: declaration)
            ComputationNode { behavior: _ } => native_test_eval_one_not_arrow(prepared: prepared, declaration: declaration)
          }
      }
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE LANE'S OWN ADJUDICATION — DERIVED UNIVERSE, OBSERVED POPULATION, JUDGED RECEIPT.
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// WHAT MOVED HERE, AND WHAT THE ROUTE THEREFORE CLAIMS. The claim is NATIVE UNIVERSE DERIVATION,
// NATIVE EVALUATION, NATIVE RECEIPT CONSTRUCTION AND NATIVE ADMISSION over a SEED-PREPARED COMPILER
// ARTIFACT — not an interpreter-free process end to end, which would be false while the v1 process
// emits the compiler this fold runs inside (operator design review 2026-09-11). What moved is every
// SEMANTIC decision; what remains in v1 is the preparation of the artifact, named rather than
// counted as absent, and owned by the native ancestry acquisition lane. Until this section existed the lane was
// interpreter-bracketed on both ends: the seed folded the floor's discovery producer over every
// source through the v1 interpreter to derive the universe (~4 minutes interpreted), and then
// evaluated native_route_admission through the interpreter to judge the receipt — so the lane
// that exists to prove a pristine v2 process could not run without the v1 interpreter at all.
// Both brackets are folds this module can reach natively, so they are declared here and
// COMPILED; the seed's remaining job is emit + cargo, and every semantic decision the lane makes
// is executed by the binary the route is about (operator ruling 2026-09-10). The route is invoked
// by an operator rather than by a required job since #11003 deleted that job; what it proves about
// the route is unchanged by where it is invoked from.
//
// THE JOIN IS NOT MADE TAUTOLOGICAL BY THE MOVE. The driver's earlier contract note — a binary
// that discovered its own population would make the host-side join tautological — was about a
// join between two PROCESSES. The join admission actually performs is between the DISCOVERY
// authority's answer (what the corpus declares a test, read textually per source) and the
// EXECUTION route's answer (what reached a verdict through the whole front end): two independent
// folds over two different readings of the same bytes. A universe member with no observation row
// is still an omission and a row with no member is still foreign; what the move removes is the
// process boundary between them, which was never what made the join discriminating.

// The lane's own refusal carrier. A refusal reaching here is a LANE-level defect (the corpus
// refused discovery outright), so it stops the line rather than shrinking the universe; the
// producer's own reason text is interned as the second diagnostic so the refusal that the
// process prints names what discovery actually said, not merely that it said something.
fn native_lane_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: invariant_port_locus(port: ^compile_stage_locus_port, invariant: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn native_lane_refused<T>(reason: Symbol, detail: String) -> Outcome<T> {
  Rejected {
    diagnostics: NonEmptyDiagnostics {
      head: native_lane_diagnostic(reason: reason),
      tail: [native_lane_diagnostic(reason: symbol_intern_lexeme(lexeme: detail))]
    }
  }
}

// THE MODULE NAME OF A SOURCE THAT CARRIES NO ACQUIRED NAME, READ FROM ITS HEADER TEXT. The
// adjudicating lane no longer reads headers: it requests modules by name, and the acquirer
// (v2.compiler.module_acquisition) confirms each file's `module` line against the name it was
// requested by. Two consumers still hold sources without an acquired name, and both need the header
// rather than a parse-derived name, because a source whose front end refused carries no normalized
// root and no qualified name -- a parse-derived relation would silently drop exactly the files whose
// refusals a census exists to report: native_refused_file_module (the module a refused file
// declares) and native_census_modules (the roster a census reports on). The seed answered this same
// question at this same grain and is deleted with the interpreted derivation; this is that fact's
// `.dag` home.
fn native_lane_declared_module_name(content: String) -> Optional<String> {
  match list_find_first(
    xs: split(s: content, delimiter: "\n"),
    predicate: fn(line) { starts_with(s: trim(line), prefix: "module ") }
  ) {
    Absent => optional_absent()
    Present { value: line } =>
      optional_present(
        value: trim(substring(s: trim(line), start: 7, end: string_length(s: trim(line))))
      )
  }
}

// ONE UNIVERSE MEMBER, AS THE ACQUIRER HANDED IT OVER: the module it is, the path it was read from,
// and the rows discovery enrolled for it. The rows come from the declarations the front end captured
// as `test`-marked (AcquiredModule.test_markers) -- supplied values at the discovery boundary, so the
// producer runs no text scan of its own and the module's name is the name it was requested by, never
// a second reading of its header.
//
// THE FACTS COVER UNIVERSE MEMBERS ONLY. A module outside the universe has nothing to discover, and a
// walk over it would assert whole-repository sidecar and disposition hygiene from a consumer whose
// subject is the requested tests' completeness -- a different subject, answered by a fold over a
// population this lane did not ask for (DESIGN section 2, one fact one home).
type NativeLaneSourceFacts {
  module: String
  path: Symbol
  discovery: FloorDiscoveryWalkState
}

fn native_lane_member_facts(member: AcquiredModule) -> NativeLaneSourceFacts {
  NativeLaneSourceFacts {
    module: member.name,
    path: symbol_intern_lexeme(lexeme: acquisition_module_path(module: member)),
    discovery: discover_floor_rows_for_source(
      repo_path: acquisition_module_path(module: member),
      marked: member.test_markers,
      content: member.content
    )
  }
}

fn native_lane_source_facts(modules: List<AcquiredModule>) -> List<NativeLaneSourceFacts> {
  list_map(
    xs: filter(xs: modules, predicate: fn(member) { native_route_universe_member(module_qn: member.name) }),
    f: fn(member) { native_lane_member_facts(member: member) }
  )
}

// ONE UNIVERSE MEMBER'S MODULE: the identities discovery enrolled for it, and the path they were
// read from. Declarations stay grouped by module because prepare (resolve + infer) is paid once
// per module and every declaration of a module shares its outcome.
type NativeLaneUniverseModule {
  module: String
  path: Symbol
  declarations: List<String>
}

type NativeLaneUniverse {
  modules: List<NativeLaneUniverseModule>
  identities: List<NativeRouteTestIdentity>
  module_sources: List<NativeRouteModuleSource>
}

// THE DRIVER'S COMMAND LINE, AS A PLAN -- the same three-part shape v2.cli.compile_cli established,
// applied to the other rendered main.
//
// WHY A PLAN AND NOT A DISPATCH. The rendered main decided the verb itself: it read argv, compared
// the first word against three literals, and called one of three host functions, refusing inline at
// three points with its own message and its own status. Every one of those is a DECISION, and
// `gunbc.source_root_eval_driver_seed_growth` names the capability that retires its row -- the
// rendered main becomes one call into a fold. A decision taken in emitted Rust is a decision no
// `.dag` consumer can read, no witness can exercise, and no refusal vocabulary owns; moving it here
// is what makes the verb surface a modeled fact rather than a property of the emitter's string.
//
// THE SPLIT IS THE SAME ONE AND FOR THE SAME REASON. The host cannot know which roots to walk, or
// which facts file to read, until argv has been parsed; and this module cannot read a directory.
// So `native_driver_parse` answers with a plan, `native_driver_plan_source_roots` says which roots
// the host must walk, and the run folds receive what came back. A single call would force one of
// those two to be wrong. The facts path needs no accessor: only `NativeDriverAdjudicate` carries
// one, and the rendered main reads it from that verb in the arm that runs adjudication -- the same
// plan value, not argv (and it retires with `facts_path` itself, trigger stated on the type).
//
// THE RENDERED MAIN CALLS THIS AND NOTHING ELSE DECIDES THE VERB. v1.compiler.emit_rust
// `emit_source_root_eval_driver_main_rs` renders `main` as one `native_driver_parse` call, reads
// the roots and facts path from the plan, sets the status `native_driver_plan_exit` returns, and
// dispatches on the verb the plan carries -- the literal comparisons and inline refusals it used to
// render are deleted in the same change, so these strings are the program's, not a copy of them.
//
// BEHAVIOUR IS PRESERVED, including the parts that look like omissions. `census` with no roots is
// PLANNED here, not refused, because the rendered main collected an empty vector and let the run
// fold answer -- adding a parse-time refusal would be a new wall wearing a refactor's clothes. The
// one textual change is the usage line, which no longer names the binary: the emitted main
// interpolated its crate name there, and a fold that cannot know which crate it was emitted into
// must not spell one (an earlier draft of this row hardcoded `v1_compiled`, which is the name of
// the PIPELINE-FREE crate and so was wrong for every binary this plan runs in).
// `facts_path` IS EXISTING BEHAVIOUR OF A KNOWN-WRONG SHAPE (operator ruling 2026-09-21). The host
// facts it names -- seed, closure and executable identities, old-route and malformed-control
// verdicts -- are OBSERVED by the runner, and a user must never hand-author them as a file passed on
// argv. It is kept only because nothing else supplies them yet, so removing it would starve the
// lane. RETIREMENT TRIGGER, a capability rather than an artifact: the runner-side producer that
// observes host facts feeds this plan. At that point `NativeDriverAdjudicate` loses `facts_path`,
// and the public verb becomes `test` over a target pattern (v2 foundation package 9). No other
// change retires it.
type NativeDriverVerb
  = NativeDriverCensus { source_roots: FreeMonoid<String> }
  | NativeDriverCensusResolve { source_roots: FreeMonoid<String> }
  | NativeDriverCensusInfer { source_roots: FreeMonoid<String> }
  | NativeDriverDemandCensus { source_roots: FreeMonoid<String> }
  | NativeDriverAdjudicate { facts_path: String, pattern: TargetPattern, source_roots: FreeMonoid<String> }

type NativeDriverPlan
  = NativeDriverPlanned { verb: NativeDriverVerb }
  | NativeDriverPlanRefused { reason: Symbol, detail: String }

data native_driver_verb_census: String = "census"

data native_driver_verb_census_resolve: String = "census-resolve"

// THE FOURTH MODE, ITS OWN WORD: resolve AND infer every ingested module (native_census_module_inference),
// for the folds that read inferred trees. Not census-resolve widened -- that verb's cost and meaning
// stay part 1's (docs/plans/census-part-2-inference-design.md section 2a).
data native_driver_verb_census_infer: String = "census-infer"

data native_driver_verb_demand_census: String = "demand-census"

data native_driver_verb_adjudicate: String = "adjudicate"

data native_driver_usage: String = "REFUSED: no mode given -- usage: adjudicate <host-facts.tsv> <target-pattern> <source-root>... | census <source-root>... | census-resolve <source-root>... | census-infer <source-root>... | demand-census <source-root>..."

data native_driver_adjudicate_needs_facts: String = "REFUSED: adjudicate takes a host facts file before the source roots"

data native_driver_adjudicate_needs_pattern: String = "REFUSED: adjudicate takes a target pattern after the host facts file and before the source roots"

// THE PATTERN OPERAND IS PARSED BY ITS AUTHORITY, AND A BAD ONE IS A COMMAND-LINE REFUSAL. The text
// goes to `extdeps.bazel.target_pattern` `parse_target_pattern` unchanged; its typed cause is
// rendered by that module's own `target_pattern_refusal_text`, and the plan refuses with the misuse
// status like every other unusable argv -- no universe is derived for a pattern that does not parse.
fn native_driver_pattern_refused_detail(word: String, cause: TargetPatternRefusal) -> String {
  concat(
    concat(concat("REFUSED: adjudicate target pattern ", word), " -- "),
    target_pattern_refusal_text(r: cause)
  )
}

// THE STATE IS THE VERB ALREADY DECIDED, which is why there is no separate "mode" field. Once the
// first word is read the remaining words mean something different for each verb -- roots for two of
// them, a facts path then roots for the third -- so carrying the verb in the state is what lets one
// step function stay total without asking "which mode are we in" at every arm.
type NativeDriverParseState
  = DriverSeekVerb
  | DriverCensusRoots { roots: FreeMonoid<String> }
  | DriverCensusResolveRoots { roots: FreeMonoid<String> }
  | DriverCensusInferRoots { roots: FreeMonoid<String> }
  | DriverDemandCensusRoots { roots: FreeMonoid<String> }
  | DriverAdjudicateSeekFacts
  | DriverAdjudicateSeekPattern { facts_path: String }
  | DriverAdjudicateRoots { facts_path: String, pattern: TargetPattern, roots: FreeMonoid<String> }
  | DriverParseRefused { reason: Symbol, detail: String }

fn native_driver_unknown_verb_detail(word: String) -> String {
  concat(
    concat("REFUSED: unknown mode ", word),
    " -- expected adjudicate, census, census-resolve, census-infer or demand-census"
  )
}

// A REFUSED STATE ABSORBS THE REST OF ARGV rather than reconsidering it. The first bad word is the
// located cause; a later word cannot repair it, and letting one re-decide the verb would make the
// refusal depend on how many arguments followed it.
fn native_driver_parse_step(state: NativeDriverParseState, word: String) -> NativeDriverParseState {
  match state {
    DriverParseRefused { reason: reason, detail: detail } =>
      DriverParseRefused { reason: reason, detail: detail }
    DriverSeekVerb =>
      if word == native_driver_verb_census {
        DriverCensusRoots { roots: [] }
      } else if word == native_driver_verb_census_resolve {
        DriverCensusResolveRoots { roots: [] }
      } else if word == native_driver_verb_census_infer {
        DriverCensusInferRoots { roots: [] }
      } else if word == native_driver_verb_demand_census {
        DriverDemandCensusRoots { roots: [] }
      } else if word == native_driver_verb_adjudicate {
        DriverAdjudicateSeekFacts
      } else {
        DriverParseRefused {
          reason: ^native_driver_unknown_verb,
          detail: native_driver_unknown_verb_detail(word: word)
        }
      }
    DriverCensusRoots { roots: roots } =>
      DriverCensusRoots { roots: list_snoc_item(xs: roots, item: word) }
    DriverCensusResolveRoots { roots: roots } =>
      DriverCensusResolveRoots { roots: list_snoc_item(xs: roots, item: word) }
    DriverCensusInferRoots { roots: roots } =>
      DriverCensusInferRoots { roots: list_snoc_item(xs: roots, item: word) }
    DriverDemandCensusRoots { roots: roots } =>
      DriverDemandCensusRoots { roots: list_snoc_item(xs: roots, item: word) }
    DriverAdjudicateSeekFacts =>
      DriverAdjudicateSeekPattern { facts_path: word }
    DriverAdjudicateSeekPattern { facts_path: facts_path } =>
      match parse_target_pattern(text: word) {
        TargetPatternRefused { cause: cause } =>
          DriverParseRefused {
            reason: ^native_driver_adjudicate_pattern_refused,
            detail: native_driver_pattern_refused_detail(word: word, cause: cause)
          }
        TargetPatternParsed { pattern: pattern } =>
          DriverAdjudicateRoots { facts_path: facts_path, pattern: pattern, roots: [] }
      }
    DriverAdjudicateRoots { facts_path: facts_path, pattern: pattern, roots: roots } =>
      DriverAdjudicateRoots {
        facts_path: facts_path,
        pattern: pattern,
        roots: list_snoc_item(xs: roots, item: word)
      }
  }
}

// THE TWO STATES THAT ARE INCOMPLETE RATHER THAN EMPTY. Reaching the end still seeking a verb means
// argv was empty; still seeking a facts path means `adjudicate` was the last word. Both are
// refusals the rendered main raised inline, and both are raised here with its exact message.
fn native_driver_parse_finish(state: NativeDriverParseState) -> NativeDriverPlan {
  match state {
    DriverParseRefused { reason: reason, detail: detail } =>
      NativeDriverPlanRefused { reason: reason, detail: detail }
    DriverSeekVerb =>
      NativeDriverPlanRefused {
        reason: ^native_driver_no_verb_given,
        detail: native_driver_usage
      }
    DriverAdjudicateSeekFacts =>
      NativeDriverPlanRefused {
        reason: ^native_driver_adjudicate_without_facts_path,
        detail: native_driver_adjudicate_needs_facts
      }
    DriverCensusRoots { roots: roots } =>
      NativeDriverPlanned { verb: NativeDriverCensus { source_roots: roots } }
    DriverCensusResolveRoots { roots: roots } =>
      NativeDriverPlanned { verb: NativeDriverCensusResolve { source_roots: roots } }
    DriverCensusInferRoots { roots: roots } =>
      NativeDriverPlanned { verb: NativeDriverCensusInfer { source_roots: roots } }
    DriverDemandCensusRoots { roots: roots } =>
      NativeDriverPlanned { verb: NativeDriverDemandCensus { source_roots: roots } }
    DriverAdjudicateSeekPattern { facts_path: _ } =>
      NativeDriverPlanRefused {
        reason: ^native_driver_adjudicate_without_pattern,
        detail: native_driver_adjudicate_needs_pattern
      }
    DriverAdjudicateRoots { facts_path: facts_path, pattern: pattern, roots: roots } =>
      NativeDriverPlanned {
        verb: NativeDriverAdjudicate { facts_path: facts_path, pattern: pattern, source_roots: roots }
      }
  }
}

fn native_driver_parse(argv: FreeMonoid<String>) -> NativeDriverPlan {
  native_driver_parse_finish(
    state: fold_list(xs: argv, empty: DriverSeekVerb, cons: native_driver_parse_step)
  )
}

// A REFUSED PLAN NAMES NO ROOTS AND NO FACTS FILE, so the host walks nothing and reads nothing for
// one. That is the same rule v2.cli.compile_cli states for its own refused plan: the reads a run
// performs are derived from the plan, never from argv in parallel, or the roots walked and the
// roots reported could disagree.
fn native_driver_plan_source_roots(plan: NativeDriverPlan) -> FreeMonoid<String> {
  match plan {
    NativeDriverPlanRefused { reason: _, detail: _ } => []
    NativeDriverPlanned { verb: verb } =>
      match verb {
        NativeDriverCensus { source_roots: roots } => roots
        NativeDriverCensusResolve { source_roots: roots } => roots
        NativeDriverCensusInfer { source_roots: roots } => roots
        NativeDriverDemandCensus { source_roots: roots } => roots
        NativeDriverAdjudicate { facts_path: _, pattern: _, source_roots: roots } => roots
      }
  }
}

// THE STATUS IS DERIVED FROM THE PLAN AND DECIDES NOTHING. Exit 2 is the cited misuse code, which
// is what the rendered main used for all three of these refusals -- a command line that was not
// usable, as distinct from work that ran and failed. A shim choosing the status from whether the
// detail string was empty would be a second representation of the verdict, free to disagree with
// the plan it came from.
fn native_driver_plan_exit(plan: NativeDriverPlan) -> ProcessExit {
  match plan {
    NativeDriverPlanned { verb: _ } => ExitSuccess
    NativeDriverPlanRefused { reason: _, detail: detail } =>
      ExitFailure { code: exit_code_misuse, reason: detail }
  }
}

// THE POPULATION IS A SELECTION: EVERY UNIVERSE IDENTITY IS A LABEL, AND THE PATTERN DECIDES.
// `native_lane_label_universe` spells each identity of every universe member as a `Label` ONCE --
// the module's package text once per module, `parse_label` once per declaration -- and carries the
// parsed label forward; `native_lane_universe_module_for_source` then admits by
// `extdeps.bazel.target_pattern` `target_pattern_matches` over the CARRIED label, the one matcher,
// within the floor's universe. There is one decision site for a refused label and one parse per
// identity (review 69565: the earlier pre-pass and filter each re-derived every label).
// `the_default_pattern_admits_every_universe_member` pins that the default narrows nothing.
//
// THE UNIVERSE AND THE SELECTION ARE TWO AUTHORITIES. The universe is the floor's
// (`native_route_universe_member`, the required gate's own prefix): only its members are labeled at
// all, so a module outside it -- including a declaration no label can name, `test fn all` -- is
// neither the lane's population nor the lane's defect (review 69555). The pattern only narrows
// WITHIN the universe; a pattern reaching outside it selects nothing rather than widening the lane.
//
// PER IDENTITY IS THE GRAIN THE SINGLE-TARGET FORM NEEDS: `//pkg:name` names a declaration, not a
// module. A MODULE WITH NO ADMITTED DECLARATION IS NOT IN THE UNIVERSE, so the emptiness check
// sits below the filter.
type NativeLaneLabeledIdentity {
  declaration: String
  label: Label
}

type NativeLaneLabeledSource {
  module: String
  path: Symbol
  identities: List<NativeLaneLabeledIdentity>
}

type NativeLaneSourceLabels
  = NativeLaneSourceLabeled { identities: List<NativeLaneLabeledIdentity> }
  | NativeLaneSourceLabelRefused { identity: String }

type NativeLaneLabeling
  = NativeLaneLabeled { sources: List<NativeLaneLabeledSource> }
  | NativeLaneLabelRefused { identity: String }

// ONE PACKAGE TEXT PER MODULE, ONE PARSE PER DECLARATION. The first refused declaration absorbs:
// it is the located cause, and a later row cannot repair it.
fn native_lane_label_rows(declared: String, rows: List<FloorDiscoveryRow>) -> NativeLaneSourceLabels {
  let package_text = native_route_module_package_text(module_qn: declared)
  fold_list(
    xs: rows,
    empty: NativeLaneSourceLabeled { identities: [] },
    cons: fn(state, row) {
      match state {
        NativeLaneSourceLabelRefused { identity: _ } => state
        NativeLaneSourceLabeled { identities: identities } =>
          match native_route_label_in_package(package_text: package_text, declaration: row.function) {
            LabelRefused { cause: _ } =>
              NativeLaneSourceLabelRefused { identity: concat(concat(declared, "."), row.function) }
            LabelParsed { label: label } =>
              NativeLaneSourceLabeled {
                identities: list_snoc_item(
                  xs: identities,
                  item: NativeLaneLabeledIdentity { declaration: row.function, label: label }
                )
              }
          }
      }
    }
  )
}

// ONLY UNIVERSE MEMBERS ARE LABELED. The facts already hold nothing else; the guard keeps this fold
// total over any list a caller hands it.
fn native_lane_label_universe(facts: List<NativeLaneSourceFacts>) -> NativeLaneLabeling {
  fold_list(
    xs: facts,
    empty: NativeLaneLabeled { sources: [] },
    cons: fn(acc, f) {
      match acc {
        NativeLaneLabelRefused { identity: _ } => acc
        NativeLaneLabeled { sources: sources } =>
          if !native_route_universe_member(module_qn: f.module) {
            acc
          } else {
            match native_lane_label_rows(declared: f.module, rows: f.discovery.rows) {
              NativeLaneSourceLabelRefused { identity: identity } =>
                NativeLaneLabelRefused { identity: identity }
              NativeLaneSourceLabeled { identities: identities } =>
                NativeLaneLabeled {
                  sources: list_snoc_item(
                    xs: sources,
                    item: NativeLaneLabeledSource { module: f.module, path: f.path, identities: identities }
                  )
                }
            }
          }
      }
    }
  )
}

fn native_lane_universe_module_for_source(
  pattern: TargetPattern,
  source: NativeLaneLabeledSource
) -> List<NativeLaneUniverseModule> {
  let declarations = fold_list(
    xs: source.identities,
    empty: [],
    cons: fn(acc, identity) {
      if target_pattern_matches(pattern: pattern, target: identity.label) {
        list_snoc_item(xs: acc, item: identity.declaration)
      } else {
        acc
      }
    }
  )
  if length(xs: declarations) == 0 {
    []
  } else {
    [NativeLaneUniverseModule { module: source.module, path: source.path, declarations: declarations }]
  }
}

// THE SELECTED UNIVERSE: the identities `pattern` admits among the test modules the acquisition
// returned. `population` is the `v2.test` namespace's module NAMES, not its sources: the lane acquires
// only the modules the pattern could admit (native_lane_candidate_entries), so a module the pattern
// did not admit is a name here and nothing more. The names are what a single target that spells a
// module is recognised by (native_lane_pattern_named_module).
//
// A caller naming a narrower pattern gets a narrower population through the same producer, never a
// filter applied to the default universe after the fact. The facts are carried: the acquisition's
// modules are mapped to facts once, and nothing re-derives them.
fn native_lane_universe_selected(
  modules: List<AcquiredModule>,
  population: List<String>,
  pattern: TargetPattern
) -> Outcome<NativeLaneUniverse> {
  native_lane_universe_of_facts(facts: native_lane_source_facts(modules: modules), population: population, pattern: pattern)
}

fn native_lane_universe_of_facts(
  facts: List<NativeLaneSourceFacts>,
  population: List<String>,
  pattern: TargetPattern
) -> Outcome<NativeLaneUniverse> {
  match native_lane_label_universe(facts: facts) {
    NativeLaneLabelRefused { identity: identity } =>
      native_lane_refused(reason: ^native_lane_identity_label_refused, detail: identity)
    NativeLaneLabeled { sources: sources } =>
      native_lane_universe_after_labels(pattern: pattern, facts: facts, population: population, sources: sources)
  }
}

// A SINGLE TARGET THAT NAMES A MODULE IS A MISSPELLING, AND IT REFUSES WITH THE RIGHT ONE (manager
// ruling 2026-09-21). Under this lane's correspondence a module namespace is a PACKAGE and a
// declaration is a TARGET, so `//v2/test/claim/parse:expression_bodied_fn_decl_parse` asks for a
// declaration of that name in module `v2.test.claim.parse`. When no identity answers it AND a module
// of the `v2.test` population is named `<package>.<target>`, the author meant that module -- the
// file-as-target spelling -- and an empty universe would be a silent wrong answer. The population is
// the namespace's module NAMES (native_lane_acquire_bound lists them), so recognising the spelling
// reads no module the pattern did not otherwise admit. The refusal names the module
// spelling, `//<package>/<target>:all`. The comparison is made in PACKAGE-TEXT space with the one
// correspondence the selection already uses (gunbc.witness.v2_native_route
// `native_route_module_package_text`), never by an inverse fold back to namespaces. A single
// target that matches nothing and names no module is left to the caller's own emptiness contract.
fn native_lane_pattern_named_module(
  pattern: TargetPattern,
  modules: List<NativeLaneUniverseModule>,
  population: List<String>
) -> Optional<String> {
  match pattern {
    SubtreeTargets { package: _ } => optional_absent()
    PackageTargets { package: _ } => optional_absent()
    SingleTarget { label: label } =>
      if length(xs: modules) > 0 {
        optional_absent()
      } else {
        let package_text = render_package(p: label.package)
        let candidate_package_text = if package_text == "" {
          label.target.name as String
        } else {
          concat(concat(package_text, "/"), label.target.name as String)
        }
        list_find_first(
          xs: population,
          predicate: fn(name) { native_route_module_package_text(module_qn: name) == candidate_package_text }
        )
      }
  }
}

fn native_lane_pattern_names_a_module_detail(pattern: TargetPattern, module_qn: String) -> String {
  concat(
    concat(
      concat(concat("target pattern ", render_target_pattern(pattern: pattern)), " names MODULE "),
      module_qn
    ),
    concat(
      ", not a declaration in its package -- did you mean //",
      concat(native_route_module_package_text(module_qn: module_qn), ":all")
    )
  )
}

// THE FACTS' DISCOVERY STATES ARE FINALIZED BY THE FLOOR'S OWN PRODUCER, OVER THE MEMBERS THIS LANE
// ACQUIRED. Every state is handed to floor_discovery_finalize_source_outcomes unchanged, so a walk
// failure, a disposition refusal or a sidecar violation in an acquired universe member refuses the
// derivation exactly as it refuses any other discovery, and only then are the pattern's modules kept.
// The walked set is the requested closure's universe members, not the repository: a violation in a
// module this run did not request is not this lane's to raise (the read set is the requested closure,
// exactly).
//
// THE LABELED ARM IS ITS OWN DECLARATION RATHER THAN A NESTED BLOCK, because the refusal above it is
// an expression: `.dag` has no early `return` to fall through, so the accepted path has to be the other
// arm of the same match. Splitting it keeps that arm one call wide instead of indenting the entire
// derivation inside a match arm. Consumer: native_lane_universe_of_facts, the only caller.
fn native_lane_universe_after_labels(
  pattern: TargetPattern,
  facts: List<NativeLaneSourceFacts>,
  population: List<String>,
  sources: List<NativeLaneLabeledSource>
) -> Outcome<NativeLaneUniverse> {
  match floor_discovery_finalize_source_outcomes(
    outcomes: fold_list(xs: facts, empty: [], cons: fn(acc, f) { list_snoc_item(xs: acc, item: f.discovery) })
  ) {
    FloorDiscoveryRefused { reason: reason } =>
      native_lane_refused(reason: ^native_lane_universe_derivation_refused, detail: reason)
    FloorDiscoveryAccepted { rows: _ } => {
      let modules = fold_list(
        xs: sources,
        empty: [],
        cons: fn(acc, source) {
          fold_list(
            xs: native_lane_universe_module_for_source(pattern: pattern, source: source),
            empty: acc,
            cons: fn(inner, m) { list_snoc_item(xs: inner, item: m) }
          )
        }
      )
      match native_lane_pattern_named_module(pattern: pattern, modules: modules, population: population) {
        Present { value: module_qn } =>
          native_lane_refused(
            reason: ^native_lane_pattern_names_a_module,
            detail: native_lane_pattern_names_a_module_detail(pattern: pattern, module_qn: module_qn)
          )
        Absent =>
          outcome_accepted(value: NativeLaneUniverse {
            modules: modules,
            identities: fold_list(
              xs: modules,
              empty: [],
              cons: fn(acc, m) {
                fold_list(
                  xs: m.declarations,
                  empty: acc,
                  cons: fn(inner, d) {
                    list_snoc_item(xs: inner, item: NativeRouteTestIdentity { module: m.module, declaration: d })
                  }
                )
              }
            ),
            module_sources: fold_list(
              xs: modules,
              empty: [],
              cons: fn(acc, m) {
                list_snoc_item(xs: acc, item: NativeRouteModuleSource { module: m.module, path: m.path })
              }
            )
          })
      }
    }
  }
}

// ── the acquisition the route actually ingests ─────────────────────────────────────────────
//
// THE ROUTE ACQUIRES THE MODULES IT IS ASKED FOR AND NOTHING ELSE (operator ruling 2026-09-11, on a
// measurement: the emitted binary given a TWO-row universe ran 64 minutes single-threaded because it
// tokenized, parsed and normalized every corpus source before evaluating anything -- a fixed cost
// independent of the population it was asked about). DESIGN section 2: minimize the demand graph
// before materializing its answers. What is acquired is decided by NAMES: the entries are the live
// control module and the test modules the pattern could admit, and v2.compiler.module_acquisition
// reads each entry's file by the storage rule (gunbc.source_layout), reads the modules each member's
// own text requests, and checks the read set against that requested closure exactly. No directory is
// walked for a closure and no file is read that was not requested; the one listing is the `v2.test`
// namespace's, the population a pattern selects within.
//
// THE ADJUDICATION RECEIPT'S file_refusals THEREFORE MEAN "refusals among the sources the selected
// population needed", which is what the Context-stage classification joins against: a refusal outside
// the closure could never have explained a member's verdict. The corpus-wide front-end histogram is a
// different subject with a different consumer and its own producer, the census modes, whose input is
// an explicit population (native_lane_census_ingest).
//
// THE WALK'S BUDGET IS A REFUSAL, NEVER A TRUNCATION (DESIGN section 5). The reachable set decides
// what a census consumer is told, so a walk that stopped early and answered with what it had seen
// would hand it a narrowed set -- the absorbing arm in its narrowing form. Exhaustion therefore
// refuses, and the refusal carries what a reader needs to decide whether the budget or the graph is
// wrong: the budget, the frontier still unexpanded, and the first module on it. The budget is rounds
// of breadth-first expansion, so it bounds import DEPTH, not closure size; a walk finishing on
// exactly its last round is accepted, because the empty-frontier arm is asked before the budget arm.
// An acyclic import graph of N modules is at most N rounds deep, so a caller's budget of N + 1 can
// only be exhausted by a graph that is not acyclic.
fn native_lane_closure_exhausted_detail(budget: Int, frontier: List<String>) -> String {
  let first = match frontier {
    Empty => ""
    Cons { head: h, tail: _ } => h
  }
  concat(
    "import-closure walk exhausted its budget of ",
    int_to_decimal_string(value: budget),
    " rounds with ",
    int_to_decimal_string(value: length(xs: frontier)),
    " module(s) still unexpanded, first: ",
    first
  )
}

// ONE PASS PER ROUND, NOT ONE PER FRONTIER MEMBER: the walk carries `seen_set` as a Map and the next
// frontier is the imports of this frontier not yet seen, so a round costs one lookup per frontier
// member.
type NativeLaneClosureStep {
  unseen: List<String>
  seen_set: Map<String, Bool>
}

// THE KEYED REACHABILITY WALK over a module-name graph. The adjudicating lane no longer walks an
// import graph -- the acquirer does, from each member's parsed requests -- so this walk's consumers
// are the census's closure fan-out (native_census_closure_fan_out_of, native_census_subject_closure)
// over the import graph the census read: one walk, two directions, no second closure fold.
//
// `seen` IS CARRIED IN BOTH FORMS ON PURPOSE. The ordered list is the ANSWER -- callers receive the
// closure in discovery order -- and the map is the MEMBERSHIP TEST. v2.std.collection exposes insert
// and lookup and no key enumeration, so a map alone could not produce the returned list and a list
// alone is the scan this walk avoids.
//
// DISCOVERY ORDER IS FRONTIER ORDER, and every consumer reads the result as a set or by its length.
// IF A CONSUMER THAT READS THE SEQUENCE EVER APPEARS, the change that adds it owns this order fact and
// must carry it; it cannot be inherited silently from here.
fn native_lane_module_reachable(
  index: Map<String, List<String>>,
  frontier: List<String>,
  seen: List<String>,
  seen_set: Map<String, Bool>,
  fuel: Int,
  budget: Int
) -> Outcome<List<String>> {
  if is_empty(xs: frontier) {
    outcome_accepted(value: seen)
  } else if fuel <= 0 {
    native_lane_refused(
      reason: ^native_lane_closure_budget_exhausted,
      detail: native_lane_closure_exhausted_detail(budget: budget, frontier: frontier)
    )
  } else {
    let next = fold_list(
      xs: frontier,
      empty: [],
      cons: fn(acc, member) {
        match map_lookup(index, member) {
          Absent => acc
          Present { value: imports } =>
            fold_list(
              xs: imports,
              empty: acc,
              cons: fn(grown, imported) { list_snoc_item(xs: grown, item: imported) }
            )
        }
      }
    )
    let step = fold_list(
      xs: next,
      empty: NativeLaneClosureStep { unseen: [], seen_set: seen_set },
      cons: fn(acc, candidate) {
        match map_lookup(acc.seen_set, candidate) {
          Present { value: _ } => acc
          Absent =>
            NativeLaneClosureStep {
              unseen: list_snoc_item(xs: acc.unseen, item: candidate),
              seen_set: map_insert(acc.seen_set, candidate, true)
            }
        }
      }
    )
    native_lane_module_reachable(
      index: index,
      frontier: step.unseen,
      seen: fold_list(
        xs: step.unseen,
        empty: seen,
        cons: fn(acc, m) { list_snoc_item(xs: acc, item: m) }
      ),
      seen_set: step.seen_set,
      fuel: fuel - 1,
      budget: budget
    )
  }
}

// THE POPULATION A PATTERN SELECTS WITHIN is the `v2.test` namespace, named by the prefix the universe
// admits members by (gunbc.witness.v2_native_route native_route_universe_prefix, trailing dot
// dropped), so the namespace listed and the namespace admitted are one fact.
fn native_lane_universe_namespace() -> String {
  substring(
    s: native_route_universe_prefix,
    start: 0,
    end: string_length(s: native_route_universe_prefix) - 1
  )
}

// THE DECLARATION A MODULE IS PROBED WITH when the pattern is asked whether it could admit the module
// at all: a single target names the declaration it wants, a package or subtree pattern admits any.
fn native_lane_pattern_probe_declaration(pattern: TargetPattern) -> String {
  match pattern {
    SingleTarget { label: label } => label.target.name as String
    PackageTargets { package: _ } => "any_declaration"
    SubtreeTargets { package: _ } => "any_declaration"
  }
}

// WHETHER A MODULE COULD HAVE AN ADMITTED DECLARATION, decided by its NAME alone and so before any
// byte of it is read. It is a SUPERSET of the label-level selection (native_lane_universe_module_for_source,
// which stays the authority over which declarations are admitted): the probe is the same
// correspondence (native_route_label_in_package) and the same matcher (target_pattern_matches), applied
// to the module's package with the declaration the pattern itself names. A label that cannot be formed
// is ADMITTED, not dropped -- the module is then acquired and the label-level refusal names it, so a
// name this check cannot judge widens the acquisition by one module rather than narrowing the
// universe.
fn native_lane_pattern_admits_module(pattern: TargetPattern, module_qn: String) -> Bool {
  match native_route_label_in_package(
    package_text: native_route_module_package_text(module_qn: module_qn),
    declaration: native_lane_pattern_probe_declaration(pattern: pattern)
  ) {
    LabelRefused { cause: _ } => true
    LabelParsed { label: label } => target_pattern_matches(pattern: pattern, target: label)
  }
}

// THE ENTRIES OF THE ACQUISITION: the live-control module (its declarations are the controls the
// receipt runs) and every candidate test module. Everything else the run reads is a module one of these
// requests.
fn native_lane_candidate_entries(pattern: TargetPattern, population: List<String>) -> List<String> {
  Cons {
    head: native_route_live_control_module,
    tail: filter(xs: population, predicate: fn(name) { native_lane_pattern_admits_module(pattern: pattern, module_qn: name) })
  }
}

// WHAT THE ACQUIRER HANDS BACK: the modules of the requested closure, verified exact (R9), and the
// names of the population the pattern selected within. It is the whole output of the effectful part of
// the adjudicating run, so the driver can time reading and request detection (which are one
// dependency-driven walk and cannot be separated) apart from the universe derivation that follows.
type NativeLaneAcquisition {
  modules: List<AcquiredModule>
  population: List<String>
}

// WHAT THE ADJUDICATING RUN HOLDS AFTER DERIVING: the universe it adjudicates, the ingest the later
// stages read (exactly the acquired modules, carrying the bytes the acquirer read), and the size of
// the population the pattern selected within -- the one number a receipt can say about the namespace
// without having read it.
type NativeLaneAcquired {
  universe: NativeLaneUniverse
  ingest: SourceRootIngest
  population: Int
}

// A PURE FOLD over the acquisition: no byte is read here, so a witness supplies hand-built modules and
// a driver times this apart from the reads.
fn native_lane_acquired(acquisition: NativeLaneAcquisition, pattern: TargetPattern) -> Outcome<NativeLaneAcquired> {
  match native_lane_universe_selected(
    modules: acquisition.modules,
    population: acquisition.population,
    pattern: pattern
  ) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: universe, diagnostics: _ } =>
      outcome_accepted(value: NativeLaneAcquired {
        universe: universe,
        ingest: acquisition_ingest(modules: acquisition.modules),
        population: length(xs: acquisition.population)
      })
  }
}

// AN ACQUISITION THAT IS NOT THE REQUESTED CLOSURE, EXACTLY, IS A REFUSAL with the acquirer's own
// reason and located cause (R9): never a smaller set and never a wider one.
fn native_lane_acquire_verified(verified: VerifiedAcquisition, population: List<String>) -> Outcome<NativeLaneAcquisition> {
  match verified {
    AcquisitionNotVerified { reason: reason, cause: cause } => native_lane_refused(reason: reason, detail: cause)
    AcquisitionVerified { modules: modules, reads: _, absent_probes: _ } =>
      outcome_accepted(value: NativeLaneAcquisition { modules: modules, population: population })
  }
}

fn native_lane_acquire_listed(
  bindings: List<SourceRootBinding>,
  population: List<String>,
  pattern: TargetPattern
) -> Outcome<NativeLaneAcquisition> {
  native_lane_acquire_verified(
    verified: acquire_verified(
      layout: repository_storage_layout(),
      bindings: bindings,
      entries: native_lane_candidate_entries(pattern: pattern, population: population)
    ),
    population: population
  )
}

fn native_lane_acquire_bound(bindings: List<SourceRootBinding>, pattern: TargetPattern) -> Outcome<NativeLaneAcquisition> {
  match enumerate_namespace_modules(
    layout: repository_storage_layout(),
    bindings: bindings,
    namespace: native_lane_universe_namespace()
  ) {
    NamespaceModulesRefused { namespace: namespace, cause: cause } =>
      native_lane_refused(reason: ^native_lane_population_unlisted, detail: concat(namespace, ": ", cause))
    NamespaceModulesListed { namespace: _, modules: population } =>
      native_lane_acquire_listed(bindings: bindings, population: population, pattern: pattern)
  }
}

// A SOURCE ROOT THAT IS NO GOVERNED TREE, OR A SECOND DIRECTORY FOR A TREE ALREADY BOUND, REFUSES where
// it was typed (v2.cli.source_root_bindings), by the one fold the native CLI also binds its roots with.
fn native_lane_roots_refusal<T>(bindings: SourceRootBindings) -> Outcome<T> {
  native_lane_refused(
    reason: ^native_lane_source_roots_refused,
    detail: source_root_bindings_refusal_text(bindings: bindings)
  )
}

// THE ADJUDICATING RUN'S ONE DOOR TO ITS SOURCES: bind the roots, list the test namespace, acquire the
// closure of the candidate entries and verify it. The universe is derived from what was acquired by
// native_lane_acquired, a separate pure fold.
fn native_lane_acquire(source_roots: FreeMonoid<String>, pattern: TargetPattern) -> Outcome<NativeLaneAcquisition> {
  let resolved = source_root_bindings(roots: source_roots)
  match resolved {
    SourceRootsBound { bindings: bindings } => native_lane_acquire_bound(bindings: bindings, pattern: pattern)
    SourceRootsUnrecognized { argument: _ } => native_lane_roots_refusal(bindings: resolved)
    SourceRootsDuplicated { argument: _ } => native_lane_roots_refusal(bindings: resolved)
  }
}

// THE CENSUS READS A POPULATION, NOT A CLOSURE. A census exists to report what is wrong with each
// member of a population, so it cannot be driven by the acquirer, whose first unparseable member
// refuses the whole acquisition. Its input is the module names the bound trees hold under the storage
// rule (enumerate_bound_modules), read exactly (read_population): a module that cannot be listed or
// read refuses the census with its name, because a census over a population that silently lost a
// member would report a smaller repository.
fn native_lane_census_read(bindings: List<SourceRootBinding>, names: List<String>) -> Outcome<SourceRootIngest> {
  match read_population(layout: repository_storage_layout(), bindings: bindings, names: names) {
    PopulationReadRefused { name: name, cause: cause } =>
      native_lane_refused(reason: ^native_lane_population_unread, detail: concat(name, ": ", cause))
    PopulationReadComplete { modules: modules } => outcome_accepted(value: acquisition_ingest(modules: modules))
  }
}

fn native_lane_census_listed(bindings: List<SourceRootBinding>, listed: BoundModules) -> Outcome<SourceRootIngest> {
  match listed {
    BoundModulesRefused { subject: subject, cause: cause } =>
      native_lane_refused(reason: ^native_lane_population_unlisted, detail: concat(subject, ": ", cause))
    BoundModulesListed { modules: names } => native_lane_census_read(bindings: bindings, names: names)
  }
}

fn native_lane_census_ingest(source_roots: FreeMonoid<String>) -> Outcome<SourceRootIngest> {
  let resolved = source_root_bindings(roots: source_roots)
  match resolved {
    SourceRootsBound { bindings: bindings } =>
      native_lane_census_listed(
        bindings: bindings,
        listed: enumerate_bound_modules(layout: repository_storage_layout(), bindings: bindings, namespaces: layout_namespaces())
      )
    SourceRootsUnrecognized { argument: _ } => native_lane_roots_refusal(bindings: resolved)
    SourceRootsDuplicated { argument: _ } => native_lane_roots_refusal(bindings: resolved)
  }
}
// ── the observed population ────────────────────────────────────────────────────────────────
//
// THE PREPARE-REFUSAL FAN-OUT AND THE CONTEXT RECLASSIFICATION ARE ONE FOLD, HERE. Both used to
// live outside the route: the fan-out in the emitted main's rendered Rust, the reclassification
// in the seed's harness. They are the same per-module decision — what verdict every declaration
// of a module gets when the module never reached evaluation — and splitting them across two
// hosts is what let the seed's join query the relation off-key and silently never reclassify.
// A module whose own file the context fold refused gets Context-stage rows carrying THAT FILE'S
// fatal reason; a module whose file loaded but failed resolve/infer gets Prepare-stage rows
// carrying the resolver's own fatal reason. Every declaration gets exactly one row either way,
// so the population has no silent remainder to explain.

// THE REFUSALS ARE KEYED BY PATH, BUILT ONCE PER RUN (review 64753). The join was O(modules x
// refusals): a first-match scan per module over every file refusal the context carries. The index
// is built once by the caller that owns the loop -- the rendered driver, which is the only thing
// that knows a loop is about to happen -- and each module answers with one map_lookup.
//
// THE ABSENT ANSWER IS A REAL ANSWER. A path with no refusal row is a path this context did not
// refuse, which is exactly what the resolution arm below needs to know; there is no third state in
// which the index fails to say, so the total Optional is the whole result.
fn native_lane_file_refusal_index(
  refusals: FreeMonoid<NativeTestFileRefusal>
) -> Map<Symbol, NativeTestFileRefusal> {
  fold_list(
    xs: refusals,
    empty: empty_map(),
    cons: fn(acc, fr) { map_insert(acc, fr.path, fr) }
  )
}

fn native_lane_file_refusal_for_path(
  index: Map<Symbol, NativeTestFileRefusal>,
  path: Symbol
) -> Optional<NativeTestFileRefusal> {
  map_lookup(index, path)
}

fn native_lane_member_row(module: String, declaration: String, verdict: NativeTestVerdict) -> NativeRouteMemberRow {
  NativeRouteMemberRow {
    identity: NativeRouteTestIdentity { module: module, declaration: declaration },
    verdict: verdict
  }
}

// WHAT THE POPULATION↔UNIVERSE JOIN STILL DISCRIMINATES, STATED RATHER THAN ASSUMED. Every
// universe member gets exactly one row, so admission's omission and foreign-row clauses cannot fire
// from in-process drift the way they could when a second process echoed a universe file back. That
// is a rung statement, not a hole: the fact those clauses protected — a DISCOVERED identity the
// execution route cannot reach — is not lost, it MOVES, and it moves to a better-located carrier.
// The route refuses such an identity at the Entry stage
// (native_test_entry_declaration_not_found / native_test_entry_module_scope_unresolved), the
// exclusion taxonomy classifies that refusal, and an unclassified one still blocks admission by
// name. The clauses stay enrolled because the receipt is a data shape a future producer can still
// violate; the discriminating evidence for the class now lives on the exclusion clauses.

// THE PER-MODULE DECISION IS SPLIT AT ITS TWO COST GRAINS, and the split is load-bearing rather
// than cosmetic. Preparation (resolve + infer) is paid ONCE per module; evaluation is paid per
// declaration. A caller that must PRICE them separately — the rendered main, which owns the clock
// the substrate does not have — needs to enter each one itself, so the decision returns either the
// prepared module or the rows already decided without it, and evaluation is a second call per
// identity. Composing them here instead would hand the host one opaque call and force it to label
// the whole thing with one phase name, which is the measurement defect this shape exists to avoid.
type NativeLaneModulePreparation
  = NativeLaneModulePrepared { prepared: NativeTestPreparedModule }
  | NativeLaneModuleRowsDecided { rows: List<NativeRouteMemberRow> }

fn native_lane_module_refusal_rows(
  entry: NativeLaneUniverseModule,
  verdict: NativeTestVerdict
) -> List<NativeRouteMemberRow> {
  fold_list(
    xs: entry.declarations,
    empty: [],
    cons: fn(acc, d) {
      list_snoc_item(xs: acc, item: native_lane_member_row(
        module: entry.module,
        declaration: d,
        verdict: verdict
      ))
    }
  )
}

// THE TWO HALVES OF PREPARATION ARE ENTERED SEPARATELY, for the reason the type above already
// gives: the host owns the clock the substrate does not have, so a grain it must PRICE is a grain
// it must ENTER. Composing resolve and infer into one call handed the host one opaque span and
// forced it to label both halves with one phase name -- the measurement defect the prepare/eval
// split exists to avoid, committed one level down. std.compiler_entry's driver contract declares
// one [native-prepare-split] line per module carrying resolve_nanos and infer_nanos, and a single
// composed call cannot produce it. The rows are unchanged: the same fold over the same
// declarations, shaped by native_lane_module_refusal_rows, at the same two stages, in the same
// order -- Context for a file refusal, Prepare for either half's rejection.
// THE TWO REFUSAL CAUSES BEFORE INFER ARE SEPARATE VARIANTS, not one. A file this context refused
// and a module the resolver rejected produce rows at DIFFERENT stages (Context vs Prepare) and cost
// different work -- the first never enters the resolver at all -- so collapsing them would make the
// split line label a context refusal as a resolve refusal, which is a fabricated attribution of
// someone else's cost. The rows each arm produces are unchanged by the split.
type NativeLaneModuleResolution
  = NativeLaneModuleResolved { resolved: ResolvedTree }
  | NativeLaneModuleContextRowsDecided { rows: List<NativeRouteMemberRow> }
  | NativeLaneModuleResolveRowsDecided { rows: List<NativeRouteMemberRow> }

// THE DECISION "DID THIS MODULE RESOLVE IN THIS CONTEXT" HAS ONE AUTHORITY AND TWO CONSUMERS AT
// DIFFERENT GRAINS. The lane fans it out to one member row per declaration and keeps the resolved
// tree to infer from; the whole-tree census keeps the DIAGNOSTICS and drops the tree. Those are two
// readings of one decision, so the decision is taken once here rather than spelled twice -- a second
// function reaching native_test_resolve_module behind its own file-refusal precheck would be the
// fork DESIGN section 3 forbids, in the place it would matter most: the two spellings would then be
// free to disagree about whether a file the context refused is a module that resolved.
// THE VERDICT CARRIES THE DIAGNOSTICS UNFOLDED, and that is the whole reason this is a separate
// declaration rather than an inlined precheck. diagnostics_fatal_reason collapses NonEmptyDiagnostics
// to its LAST reason, which is the right summary for a member row whose grain is the declaration and
// the wrong one for a census whose grain is the occurrence: v2.compiler.03_resolve emits one
// diagnostic PER REFUSED NODE, each carrying its own locus, so a fold to one reason discards every
// site but one. Summarizing is the CONSUMER's move; this fold hands both consumers everything the
// resolver said.
type NativeModuleResolveVerdict
  = NativeModuleResolveFileRefused { refusal: NativeTestFileRefusal }
  | NativeModuleResolveImportTargetFileRefused {
      target: NativeTestFileRefusal
      first: NonEmptyDiagnostics
      rest: List<NonEmptyDiagnostics>
      observation: ObservationCompleteness
    }
  | NativeModuleResolveRefused {
      first: NonEmptyDiagnostics
      rest: List<NonEmptyDiagnostics>
      observation: ObservationCompleteness
    }
  | NativeModuleResolveAccepted { resolved: ResolvedTree }

// The walk ran under context.resolution's index, so that index is minted beside the root. An
// accepted walk implies an accepted context; the Rejected arm states the refusal it would be.
// `import_attribution` IS THE ANSWER THE VERDICT WAS DECIDED FROM, CARRIED rather than re-asked:
// the census needs the arm the verdict collapses -- an import graph it could not read is not the
// same fact as one it read and found clean (census C) -- and re-running the lookup to recover it
// would be the same demand paid twice (DESIGN section 2).
type NativeModuleResolveStep {
  verdict: NativeModuleResolveVerdict
  context: NativeTestContext
  import_attribution: NativeImportTargetAttribution
}

// WHETHER A REFUSED MODULE'S REFUSAL IS ATTRIBUTABLE TO AN IMPORT TARGET THE CONTEXT REFUSED. Three
// answers and a not-asked arm, because "no refused target" and "could not read the imports" are
// different facts: the second is a completeness gap, and reading it as the first would silently
// make a cascade member its own root (census C; the #13019 design rule).
// ATTRIBUTION IS INGEST-ONLY, SO A ROOT IS ONE HOP AWAY BY CONSTRUCTION. The target is looked up in
// context.file_refusals, and a file refusal's fatal reason is a front-end reason -- never an
// import-target refusal -- so the target this names is already the root of its cascade.
type NativeImportTargetAttribution
  = NativeImportTargetRefused { target: NativeTestFileRefusal }
  | NativeImportTargetsAdmitted
  | NativeImportTargetsUnreadable { reason: Symbol }
  | NativeImportTargetNotAsked

// A MODULE WHOSE IMPORT TARGET WAS REFUSED AT INGEST IS TOLD SO. When a file the context refused
// declares a module this one imports, none of that module's declarations entered the index, so the
// resolver finds each imported name unbound. That is true and located, but it names the SYMPTOM:
// measured on the native seven (quiet-hawk-702, 2026-09-29), every refusal pointed at `tokenize` while
// the cause was v2.compiler.tokenize's own file, refused by body lowering. The verdict keeps the
// resolver's diagnostics and names the refused target first. It is decided only when resolution
// already refused, so a module that resolved is never re-attributed.
// The import targets are read from the module's own captured import rows
// (v2.compiler.normalized_tree NormalizedTree import_bindings), and a row's target module is its path
// less the imported name. The refused module is the one the refused file's header declares.
fn native_import_target_attribution(context: NativeTestContext, module: QualifiedName) -> NativeImportTargetAttribution {
  match context.resolution {
    Rejected { diagnostics: _ } => NativeImportTargetsUnreadable { reason: ^native_import_target_context_refused }
    Accepted { value: shared, diagnostics: _ } =>
      match map_lookup(m: shared.roots.by_name, key: module) {
        Absent => NativeImportTargetsUnreadable { reason: ^native_import_target_module_not_indexed }
        Present { value: tree } =>
          fold_list(xs: context.file_refusals, empty: NativeImportTargetsAdmitted, cons: fn(found, refusal) {
            match found {
              NativeImportTargetRefused { target: _ } => found
              NativeImportTargetsUnreadable { reason: _ } => found
              NativeImportTargetNotAsked => found
              NativeImportTargetsAdmitted =>
                match refusal.module {
                  Absent => found
                  Present { value: refused_module } =>
                    if any(xs: normalized_tree_import_bindings(tree: tree), predicate: fn(row) {
                      qualified_name_init(qn: row.target) == refused_module
                    }) {
                      NativeImportTargetRefused { target: refusal }
                    } else {
                      found
                    }
                }
            }
          })
      }
  }
}

fn native_import_target_refusal_diagnostics(target: NativeTestFileRefusal, resolver: NonEmptyDiagnostics) -> NonEmptyDiagnostics {
  let at = Textual { file: target.path, extent: WholeFile }
  NonEmptyDiagnostics {
    head: Diagnostic { reason: ^native_prepare_reason_import_target_file_refused, at: at, correction: Unavailable { reason: UserInputBoundary } },
    tail: list_append(
      left: [Diagnostic { reason: native_test_file_refusal_fatal_reason(fr: target), at: at, correction: Unavailable { reason: UserInputBoundary } }, resolver.head],
      right: resolver.tail
    )
  }
}

// THE CLOSURE INDEX IS DEMANDED ON THE SHARED CONTEXT AND CARRIED FORWARD on the returned step, so the
// next module of the lane reads it instead of re-resolving the closure (review 74212).
fn native_module_resolve_verdict(
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  module: String,
  path: Symbol
) -> NativeModuleResolveStep {
  match native_lane_file_refusal_for_path(index: refusal_index, path: path) {
    Present { value: fr } =>
      NativeModuleResolveStep {
        verdict: NativeModuleResolveFileRefused { refusal: fr },
        context: context,
        import_attribution: NativeImportTargetNotAsked
      }
    Absent =>
      let step = native_test_resolve_module_walk(
        context: context,
        module: qualified_name_from_dotted_string(dotted: module)
      )
      match step.walk {
        ResolveWalkRefused { first: f, rest: r, observation: o } =>
          let attribution = native_import_target_attribution(
            context: step.context,
            module: qualified_name_from_dotted_string(dotted: module)
          )
          NativeModuleResolveStep {
            verdict: match attribution {
              NativeImportTargetRefused { target: target } =>
                NativeModuleResolveImportTargetFileRefused { target: target, first: f, rest: r, observation: o }
              NativeImportTargetsAdmitted => NativeModuleResolveRefused { first: f, rest: r, observation: o }
              NativeImportTargetsUnreadable { reason: _ } => NativeModuleResolveRefused { first: f, rest: r, observation: o }
              NativeImportTargetNotAsked => NativeModuleResolveRefused { first: f, rest: r, observation: o }
            },
            context: step.context,
            import_attribution: attribution
          }
        ResolveWalkAccepted { value: resolved, diagnostics: _, lexical: lexical } =>
          match step.context.resolution {
            Accepted { value: shared, diagnostics: d } =>
              let closure = closure_declarations_demand(shared: shared)
              NativeModuleResolveStep {
                verdict: NativeModuleResolveAccepted {
                  resolved: resolved_tree_of(
                    root: resolved,
                    symbol_index: shared.symbol_index,
                    closure_declarations: closure.declarations,
                    unavailable_providers: closure.refused,
                    member_kinds: no_member_declaration_kinds(),
                    lexical: lexical
                  )
                },
                context: native_test_context_with_resolution(
                  context: step.context,
                  resolution: Accepted { value: closure.context, diagnostics: d }
                ),
                import_attribution: NativeImportTargetNotAsked
              }
            Rejected { diagnostics: r } =>
              NativeModuleResolveStep {
                verdict: NativeModuleResolveRefused {
                  first: r,
                  rest: [],
                  observation: ObservationIncomplete { reason: ^resolve_observation_context_refused }
                },
                context: step.context,
                import_attribution: NativeImportTargetsUnreadable { reason: ^native_import_target_context_refused }
              }
          }
      }
  }
}

type NativeLaneModuleResolutionStep {
  resolution: NativeLaneModuleResolution
  context: NativeTestContext
}

fn native_lane_module_resolution(
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  entry: NativeLaneUniverseModule
) -> NativeLaneModuleResolutionStep {
  let step = native_module_resolve_verdict(
    context: context,
    refusal_index: refusal_index,
    module: entry.module,
    path: entry.path
  )
  NativeLaneModuleResolutionStep {
    resolution: match step.verdict {
      NativeModuleResolveFileRefused { refusal: fr } =>
        NativeLaneModuleContextRowsDecided {
          rows: native_lane_module_refusal_rows(
            entry: entry,
            verdict: native_test_refused_located(
              stage: NativeTestStageContext,
              reason: native_test_file_refusal_fatal_reason(fr: fr),
              at: Textual { file: fr.path, extent: WholeFile }
            )
          )
        }
      NativeModuleResolveImportTargetFileRefused { target: t, first: d, rest: _, observation: _ } =>
        NativeLaneModuleResolveRowsDecided {
          rows: native_lane_module_refusal_rows(
            entry: entry,
            verdict: NativeTestRefused { stage: NativeTestStagePrepare, diagnostics: native_import_target_refusal_diagnostics(target: t, resolver: d) }
          )
        }
      NativeModuleResolveRefused { first: d, rest: _, observation: _ } =>
        NativeLaneModuleResolveRowsDecided {
          rows: native_lane_module_refusal_rows(
            entry: entry,
            verdict: NativeTestRefused { stage: NativeTestStagePrepare, diagnostics: d }
          )
        }
      NativeModuleResolveAccepted { resolved: resolved } =>
        NativeLaneModuleResolved { resolved: resolved }
    },
    context: step.context
  }
}

fn native_lane_module_inference(
  entry: NativeLaneUniverseModule,
  resolved: ResolvedTree
) -> NativeLaneModulePreparation {
  match native_test_infer_resolved(
    module: qualified_name_from_dotted_string(dotted: entry.module),
    resolved: resolved
  ) {
    Rejected { diagnostics: d } =>
      NativeLaneModuleRowsDecided {
        rows: native_lane_module_refusal_rows(
          entry: entry,
          verdict: NativeTestRefused { stage: NativeTestStagePrepare, diagnostics: d }
        )
      }
    Accepted { value: prepared, diagnostics: _ } =>
      NativeLaneModulePrepared { prepared: prepared }
  }
}

// THE OCCURRENCE-KEY PREMISE, OBSERVED ON THE TREES INFER IS HANDED. Keying infer's facts on a node's
// authored occurrence is sound only if no resolved module holds two different nodes under one authored
// occurrence (v2.compiler.inferred_tree authored_occurrence_collisions). The native route resolves every
// admitted module, so the census rides that route: one row per RESOLVED module. Its reader is the
// lowering repair that must drive colliding_modules to zero before any occurrence key lands; the rule
// it measures against is v2.std.node's same-graph lowering keeping its source text's occurrence.
// OBSERVATION ONLY -- nothing here changes a module's standing, row or refusal. A module that did not
// resolve has no row, and the summary counts it as UNOBSERVED against the universe size, never as
// zero collisions.
type NativeLaneOccurrenceCollision {
  occurrence: Int
  first_kind: NodeKind
  second_kind: NodeKind
}

type NativeLaneOccurrenceCensusRow {
  module: String
  collisions: List<NativeLaneOccurrenceCollision>
}

type NativeLaneOccurrenceCensus {
  universe: Int
  observed: Int
  colliding: List<NativeLaneOccurrenceCensusRow>
}

fn native_lane_occurrence_collision(c: AuthoredOccurrenceCollision) -> NativeLaneOccurrenceCollision {
  NativeLaneOccurrenceCollision { occurrence: c.occurrence.value, first_kind: c.first.kind, second_kind: c.second.kind }
}

fn native_lane_occurrence_census_row(entry: NativeLaneUniverseModule, resolved: ResolvedTree) -> NativeLaneOccurrenceCensusRow {
  NativeLaneOccurrenceCensusRow {
    module: entry.module,
    collisions: fold_list(
      xs: authored_occurrence_collisions(root: resolved.root),
      empty: Empty,
      cons: fn(acc, c) { list_snoc_item(xs: acc, item: native_lane_occurrence_collision(c: c)) }
    )
  }
}

// THE READER. The host hands every row it minted and the universe size; the census keeps the
// colliding rows by identity and counts the rest, so observed + unobserved = universe by construction.
fn native_lane_occurrence_census(universe: Int, rows: List<NativeLaneOccurrenceCensusRow>) -> NativeLaneOccurrenceCensus {
  NativeLaneOccurrenceCensus {
    universe: universe,
    observed: length(xs: rows),
    colliding: fold_list(xs: rows, empty: Empty, cons: fn(acc, r) {
      if is_empty(xs: r.collisions) { acc } else { list_snoc_item(xs: acc, item: r) }
    })
  }
}

fn native_lane_occurrence_kind_text(k: NodeKind) -> String {
  match k {
    TypeNode { connective: Atom { identity: s } } => concat("atom:", symbol_lexeme(sym: s))
    TypeNode { connective: _ } => "type"
    ComputationNode { behavior: _ } => "computation"
  }
}

fn native_lane_occurrence_census_lines(c: NativeLaneOccurrenceCensus) -> List<String> {
  let head = concat("[native-occurrence-census] universe=", concat(to_string(c.universe),
    concat(" observed=", concat(to_string(c.observed),
    concat(" unobserved=", concat(to_string(c.universe - c.observed),
    concat(" colliding_modules=", to_string(length(xs: c.colliding)))))))))
  fold_list(xs: c.colliding, empty: Cons { head: head, tail: Empty }, cons: fn(acc, r) {
    fold_list(xs: r.collisions, empty: acc, cons: fn(acc2, x) {
      list_snoc_item(xs: acc2, item: concat("[native-occurrence-collision] module=", concat(r.module,
        concat(" occurrence=", concat(to_string(x.occurrence),
        concat(" first=", concat(native_lane_occurrence_kind_text(k: x.first_kind),
        concat(" second=", native_lane_occurrence_kind_text(k: x.second_kind)))))))))
    })
  })
}

// ONE IDENTITY, EVALUATED. The per-declaration grain the profile lane prices: this call and nothing
// else is what identity_evaluation measures.
fn native_lane_identity_row(
  prepared: NativeTestPreparedModule,
  module: String,
  declaration: String
) -> NativeRouteMemberRow {
  let observation = native_test_eval_one(
    prepared: prepared,
    declaration: symbol_intern_lexeme(lexeme: declaration)
  )
  native_lane_member_row(
    module: module,
    declaration: declaration,
    verdict: observation.verdict
  )
}

// THE WHOLE-TREE CENSUS ROSTER. The universe roster above answers "which modules carry test
// identities"; this one answers "which modules the ingest carries at all". They are separate folds
// rather than one fold with a flag because universe membership is a PREFIX test on the qualified
// name AND an enrolled discovery row, and a census that inherited either would report a residual
// over the test corpus while naming one over the tree.
// THE MODULE NAME IS READ FROM THE SOURCE, NOT FROM THE CONTEXT INDEX. A file the context refused
// never reached absorb, so it holds no index binding; a roster derived from the index would exclude
// exactly the files whose refusals a census exists to report, and it would do so silently.
// IT IS NOT native_lane_source_facts EITHER, and that is a cost decision rather than a taste one:
// those facts run the floor's discovery fold over a universe member, and a census asks for none of it
// but the module header. Over the whole tree that fold would be paid once per module to read one line
// each time. The header is read by native_lane_declared_module_name, the fact's one home.
// ═══════════════════════════════════════════════════════════════════════════════════════════
// D13 DEPENDENCY-DEMAND CENSUS: THE WHOLE-CLOSURE ROUTE (`demand-census`)
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// WHY A FRONT END OF ITS OWN, ENTERED PHASE BY PHASE. Production lowering refuses every fn with a
// `uses` clause, and native_test_context_absorb drops a refused file from the roots and the source
// root index -- so in the production context a uses fn's module is absent, and so are the
// operations and fns it declares. A census that stripped one module at a time would read every edge
// into such a module as outside the closure. So this route folds the whole ingest once with the
// clause elided (v2.compiler.dependency_demand_census demand_census_strip, between parse and
// normalize) and absorbs each root through the SAME native_test_context_absorb the production fold
// uses: the only difference from native_test_context_fold_step is the strip, which is why that step
// is entered phase by phase here rather than through program_assembly_read_to_normalized_root_seeded.
//
// THE CONTEXT NEVER LEAVES THIS ROUTE. native_demand_census_report returns a DemandCensusReport --
// rows of authored rows, derived demand and verdicts -- and no tree, context or prepared module, so
// nothing the elided front end produced can reach infer, eval or emission. Its one caller is the
// emitted driver's `demand-census` verb, run by `gunbc test //gunbc/instruments:dependency-demand-census`.

type NativeDemandCensusFoldState {
  context: NativeTestContextFoldState
  authored: List<AuthoredUsesFunction>
  file_refused: List<AuthoredUsesFunction>
  unreadable: Int
}

fn native_demand_census_snoc_all(xs: List<AuthoredUsesFunction>, ys: List<AuthoredUsesFunction>) -> List<AuthoredUsesFunction> {
  fold_list(xs: ys, empty: xs, cons: fn(acc, y) { list_snoc_item(xs: acc, item: y) })
}

fn native_demand_census_read(
  state: NativeDemandCensusFoldState,
  read: DagSourceReadWitness,
  front: NativeTestFrontEnd,
  scope: Fnv1a64Structural
) -> NativeDemandCensusFoldState {
  let module_qn = match native_refused_file_module(content: read.source.carried) {
    Present { value: qn } => qn
    Absent => Empty
  }
  match bind_outcome(
    o: program_assembly_phase_tokenize(read: read, lex: front.lex),
    f: fn(tokens) {
      parse_module_prepared_seeded(tokens: tokens, prepared: front.prepared, seed: state.context.alloc)
    }
  ) {
    Rejected { diagnostics: d } =>
      NativeDemandCensusFoldState {
        context: native_test_context_absorb(state: state.context, read: read, root_outcome: Rejected { diagnostics: d }, alloc: state.context.alloc, spans: span_index_empty()),
        authored: state.authored,
        file_refused: state.file_refused,
        unreadable: state.unreadable + 1
      }
    Accepted { value: artifact, diagnostics: _ } =>
      let stripped = demand_census_strip(tree: artifact.tree, owner: module_qn)
      match normalize_scoped(parse_tree: stripped.tree, allocator: scoped_occurrence_allocator(alloc: artifact.alloc, scope: scope)) {
        Rejected { diagnostics: d } =>
          NativeDemandCensusFoldState {
            context: native_test_context_absorb(state: state.context, read: read, root_outcome: Rejected { diagnostics: d }, alloc: artifact.alloc, spans: artifact.span_index),
            authored: state.authored,
            file_refused: native_demand_census_snoc_all(xs: state.file_refused, ys: stripped.authored),
            unreadable: state.unreadable
          }
        Accepted { value: scoped, diagnostics: _ } =>
          NativeDemandCensusFoldState {
            context: native_test_context_absorb(state: state.context, read: read, root_outcome: outcome_accepted(value: scoped.tree), alloc: scoped.allocator.alloc, spans: artifact.span_index),
            authored: native_demand_census_snoc_all(xs: state.authored, ys: stripped.authored),
            file_refused: state.file_refused,
            unreadable: state.unreadable
          }
      }
  }
}

type NativeDemandCensusWalk {
  context: NativeTestContext
  functions: List<FunctionFact>
  operations: List<OperationFact>
  audited: List<QualifiedName>
  standings: List<DemandCensusModuleStanding>
}

// The module's root scope, as resolution itself built it for the module just resolved: the namespace
// provider answers from its cache, so this produces no second namespace.
fn native_demand_census_module_ctx(context: NativeTestContext, module_qn: QualifiedName) -> Optional<ResolveContext> {
  match context.resolution {
    Rejected { diagnostics: _ } => optional_absent()
    Accepted { value: shared, diagnostics: validate_diag } =>
      match resolution_context_namespace(shared: shared, validate_diag: validate_diag, admission: native_test_module_admission(module: module_qn)).admitted {
        Rejected { diagnostics: _ } => optional_absent()
        Accepted { value: admitted, diagnostics: _ } =>
          optional_present(value: resolve_ctx_init(namespace: admitted.namespace, lm: shared.lm, policy: shared.policy))
      }
  }
}

fn native_demand_census_readings(context: NativeTestContext, module_qn: QualifiedName, authored: AuthoredUsesFunction) -> List<AuthoredRowReading> {
  match native_demand_census_module_ctx(context: context, module_qn: module_qn) {
    Present { value: ctx } => demand_census_authored_readings(ctx: ctx, authored: authored)
    Absent => fold_list(xs: authored.types, empty: Empty, cons: fn(acc, t) { list_snoc_item(xs: acc, item: AuthoredTypeUnresolved) })
  }
}

fn native_demand_census_module(w: NativeDemandCensusWalk, root: NormalizedTree, authored: List<AuthoredUsesFunction>) -> NativeDemandCensusWalk {
  match qualified_name_from_module_node(root: root.root) {
    Rejected { diagnostics: _ } => w
    Accepted { value: module_qn, diagnostics: _ } =>
      let mine = fold_list(xs: authored, empty: Empty, cons: fn(acc, a) { if a.owner == module_qn { list_snoc_item(xs: acc, item: a) } else { acc } })
      let step = native_test_resolve_module(context: w.context, module: module_qn)
      match step.resolved {
        Rejected { diagnostics: _ } =>
          NativeDemandCensusWalk {
            context: step.context,
            functions: w.functions,
            operations: w.operations,
            audited: w.audited,
            standings: list_snoc_item(xs: w.standings, item: DemandModuleResolveRefused { authored: mine })
          }
        Accepted { value: resolved, diagnostics: _ } =>
          let facts = demand_census_module_facts(resolved: resolved, module_qn: module_qn)
          NativeDemandCensusWalk {
            context: step.context,
            functions: fold_list(xs: facts.functions, empty: w.functions, cons: fn(acc, f) { list_snoc_item(xs: acc, item: f) }),
            operations: fold_list(xs: facts.operations, empty: w.operations, cons: fn(acc, o) { list_snoc_item(xs: acc, item: o) }),
            audited: fold_list(xs: facts.audited, empty: w.audited, cons: fn(acc, a) { list_snoc_item(xs: acc, item: a) }),
            standings: list_snoc_item(xs: w.standings, item: DemandModuleResolved {
              readings: fold_list(xs: mine, empty: Empty, cons: fn(acc, a) {
                list_snoc_item(xs: acc, item: DemandCensusAuthoredReading {
                  authored: a,
                  readings: native_demand_census_readings(context: step.context, module_qn: module_qn, authored: a)
                })
              })
            })
          }
      }
  }
}

fn native_demand_census_report(ingest: SourceRootIngest) -> Outcome<DemandCensusReport> {
  bind_outcome(o: native_test_front_end_prepare(), f: fn(front) {
    bind_outcome(o: program_assembly_ingest_scope_outcome(ingest: ingest), f: fn(scope) {
      let folded = fold_list(
        xs: ingest,
        empty: NativeDemandCensusFoldState { context: native_test_context_state_empty(), authored: Empty, file_refused: Empty, unreadable: 0 },
        cons: fn(state, read) { native_demand_census_read(state: state, read: read, front: front, scope: scope) }
      )
      let walked = fold_list(
        xs: folded.context.roots,
        empty: NativeDemandCensusWalk {
          context: native_test_context_finish(state: folded.context, front: front, ingest: ingest),
          functions: Empty,
          operations: Empty,
          audited: Empty,
          standings: Empty
        },
        cons: fn(w, root) { native_demand_census_module(w: w, root: root, authored: folded.authored) }
      )
      outcome_accepted(value: demand_census_report(
        uses_functions: length(xs: folded.authored) + length(xs: folded.file_refused),
        functions: walked.functions,
        operations: walked.operations,
        audited: walked.audited,
        standings: walked.standings,
        file_refused: folded.file_refused,
        file_refusals: length(xs: folded.context.file_refusals),
        unreadable_files: folded.unreadable
      ))
    })
  })
}

// THE VERB'S WHOLE ANSWER: the lines to print and the exit, decided by
// v2.compiler.dependency_demand_census demand_census_exit -- held (0), a census whose rows do not account
// for every uses fn read (1), or no observation (2): a read refused before authorship, or a context that
// would not build, whose diagnostics are the line.
type NativeDemandCensusOutput {
  lines: List<String>
  exit: Int
}

fn native_demand_census_output(ingest: SourceRootIngest) -> NativeDemandCensusOutput {
  match native_demand_census_report(ingest: ingest) {
    Rejected { diagnostics: d } =>
      NativeDemandCensusOutput { lines: [concat("[demand-census] no observation: ", symbol_lexeme(sym: d.head.reason))], exit: 2 }
    Accepted { value: report, diagnostics: _ } =>
      NativeDemandCensusOutput {
        lines: demand_census_lines(r: report),
        exit: demand_census_exit(r: report)
      }
  }
}

type NativeCensusModule {
  module: String
  path: Symbol
}

// IT PREPENDS AND REVERSES ONCE RATHER THAN APPENDING PER ITEM, and at this grain that is not a
// refinement. An append onto a cons list walks it, so a fold that appends is quadratic in the
// corpus -- about 6k walks of an average 3k cells for the tree this census is over, to build a list
// whose every element was already in hand. DESIGN section 6's bare-minimum-cost rule makes that
// unconditional, and the ordering the append was there to preserve is preserved by the reverse:
// read order, which is the path-sorted order the driver walked the roots in.
fn native_census_modules(ingest: SourceRootIngest) -> List<NativeCensusModule> {
  list_reverse(
    xs: fold_list(
      xs: ingest,
      empty: Empty,
      cons: fn(acc, read) {
        match native_lane_declared_module_name(content: read.source.carried) {
          Absent => acc
          Present { value: declared } =>
            Cons {
              head: NativeCensusModule {
                module: declared,
                path: read.compilation_unit
              },
              tail: acc
            }
        }
      }
    )
  )
}

// ONE CENSUS MODULE'S OUTCOME. The file-refused arm carries nothing because the census already
// reports the file refusals in full from the context, and a second rendering of the same refusal
// under a module heading would be two counts of one fact.
// THE RESOLVED ARM CARRIES NOTHING EITHER, AND THAT IS THE MEMORY PROPERTY THE WHOLE-TREE GRAIN
// NEEDS. The lane's resolution keeps the ResolvedTree because it goes on to infer from it; a census
// never infers, so the tree dies with the call that made it and the census holds one tree at a time
// rather than accumulating a tree per module across the corpus.
// THE REFUSED ARM CARRIES THE WHOLE POPULATION: every independent failure chain the walk observed,
// in walk order, plus whether the walk observed every site. A module is refused whenever any chain
// exists, so no partially accepted module can be reported beside its refusals.
type NativeCensusModuleOutcome
  = NativeCensusModuleFileRefused
  | NativeCensusModuleResolveRefused {
      first: NonEmptyDiagnostics
      rest: List<NonEmptyDiagnostics>
      observation: ObservationCompleteness
    }
  | NativeCensusModuleResolved

// `cascade` SAYS WHETHER THE OUTCOME IS A SYMPTOM OF ANOTHER FILE'S REFUSAL. It is read off the
// verdict's carried attribution, never re-asked; a refused module whose imports could not be read
// is Unattributed with the reason, NOT None -- None would make it a root of its own (census C).
type NativeCensusModuleStep {
  outcome: NativeCensusModuleOutcome
  context: NativeTestContext
  cascade: NativeCensusCascade
}

fn native_census_module_resolution(
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  entry: NativeCensusModule
) -> NativeCensusModuleStep {
  let step = native_module_resolve_verdict(
    context: context,
    refusal_index: refusal_index,
    module: entry.module,
    path: entry.path
  )
  NativeCensusModuleStep {
    outcome: match step.verdict {
      NativeModuleResolveFileRefused { refusal: _ } => NativeCensusModuleFileRefused
      NativeModuleResolveImportTargetFileRefused { target: _, first: f, rest: r, observation: o } =>
        NativeCensusModuleResolveRefused { first: f, rest: r, observation: o }
      NativeModuleResolveRefused { first: f, rest: r, observation: o } =>
        NativeCensusModuleResolveRefused { first: f, rest: r, observation: o }
      NativeModuleResolveAccepted { resolved: _ } => NativeCensusModuleResolved
    },
    context: step.context,
    cascade: native_census_import_cascade(attribution: step.import_attribution)
  }
}

fn native_census_import_cascade(attribution: NativeImportTargetAttribution) -> NativeCensusCascade {
  match attribution {
    NativeImportTargetRefused { target: t } => NativeCensusCascadeMemberOf { root: t.path, root_reason: native_test_file_refusal_fatal_reason(fr: t) }
    NativeImportTargetsUnreadable { reason: r } => NativeCensusCascadeUnattributed { reason: r }
    NativeImportTargetsAdmitted => NativeCensusCascadeNone
    NativeImportTargetNotAsked => NativeCensusCascadeNone
  }
}

// THE census-infer SUBJECT: ONE MODULE RESOLVED, THEN INFERRED. Shared by two folds, by agreement
// (docs/plans/census-part-2-inference-design.md section 2a; the nominal-type plan's M0,
// docs/plans/nominal-type-declaration-plan.md section 2): census part 2 reads the refused arm, one row
// per chain; gunbc.instruments.type_declaration_use_census reads the resolved tree on BOTH infer arms
// (declarations are resolve-level facts) and the inferred tree on the accepted one. It is the same
// per-module infer the adjudicating lane demands (native_test_infer_resolved), so there is one infer
// walk, not two. Unlike native_census_module_resolution it HOLDS the module's trees -- the folds need
// them -- for the duration of one call; the loop keeps none of them past it.
type NativeInferCensusOutcome
  = NativeInferCensusFileRefused
  | NativeInferCensusResolveRefused {
      first: NonEmptyDiagnostics
      rest: List<NonEmptyDiagnostics>
      observation: ObservationCompleteness
    }
  | NativeInferCensusInferred { resolved: ResolvedTree, inferred: InferredTree }
  | NativeInferCensusInferRefused { resolved: ResolvedTree, chain: NonEmptyDiagnostics }

// `cascade` IS THE RESOLVE VERDICT'S IMPORT ATTRIBUTION, carried exactly as
// native_census_module_resolution carries it, so a resolve refusal reached through this walk files
// the same cascade it files through census-resolve (one attribution authority, not two).
type NativeInferCensusStep {
  outcome: NativeInferCensusOutcome
  context: NativeTestContext
  cascade: NativeCensusCascade
}

fn native_census_module_inference(
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  entry: NativeCensusModule
) -> NativeInferCensusStep {
  let step = native_module_resolve_verdict(
    context: context,
    refusal_index: refusal_index,
    module: entry.module,
    path: entry.path
  )
  NativeInferCensusStep {
    outcome: match step.verdict {
      NativeModuleResolveFileRefused { refusal: _ } => NativeInferCensusFileRefused
      NativeModuleResolveImportTargetFileRefused { target: _, first: f, rest: r, observation: o } =>
        NativeInferCensusResolveRefused { first: f, rest: r, observation: o }
      NativeModuleResolveRefused { first: f, rest: r, observation: o } =>
        NativeInferCensusResolveRefused { first: f, rest: r, observation: o }
      NativeModuleResolveAccepted { resolved: resolved } =>
        match native_test_infer_resolved(module: qualified_name_from_dotted_string(dotted: entry.module), resolved: resolved) {
          Accepted { value: prepared, diagnostics: _ } =>
            NativeInferCensusInferred { resolved: resolved, inferred: prepared.inferred }
          Rejected { diagnostics: d } =>
            NativeInferCensusInferRefused { resolved: resolved, chain: d }
        }
    },
    context: step.context,
    cascade: native_census_import_cascade(attribution: step.import_attribution)
  }
}

// THE TYPE-DECLARATION CENSUS'S FOLD, DISPATCHED FROM THE census-infer WALK (the nominal-type plan's
// M0, gunbc.instruments.type_declaration_use_census). A module the context refused or that did not
// resolve has no reference index and is UNREACHED with its stage and fatal reason; one that resolved
// contributes its declarations, and its casts are typed by its inferred tree or, where infer refused,
// counted undecided under the infer cause.
fn native_census_infer_type_contribution(
  context: NativeTestContext,
  entry: NativeCensusModule,
  outcome: NativeInferCensusOutcome
) -> TypeCensusContribution {
  match outcome {
    NativeInferCensusFileRefused =>
      type_census_unreached(module: entry.module, stage: "front_end", cause: "file refused by the context")
    NativeInferCensusResolveRefused { first: f, rest: _, observation: _ } =>
      type_census_unreached(module: entry.module, stage: "resolve", cause: symbol_lexeme(sym: diagnostics_fatal_reason(d: f)))
    NativeInferCensusInferred { resolved: r, inferred: i } =>
      type_census_contribution(module: entry.module, resolved: r, normalized: native_census_normalized_tree(context: context, module: entry.module), typing: AsTypedBy { tree: i, resolved: r })
    NativeInferCensusInferRefused { resolved: r, chain: c } =>
      type_census_contribution(module: entry.module, resolved: r, normalized: native_census_normalized_tree(context: context, module: entry.module), typing: AsUntyped { cause: "module did not infer: " + symbol_lexeme(sym: diagnostics_fatal_reason(d: c)) })
  }
}

fn native_census_normalized_tree(context: NativeTestContext, module: String) -> Optional<NormalizedTree> {
  match context.resolution {
    Accepted { value: shared, diagnostics: _ } => map_get(shared.roots.by_name, qualified_name_from_dotted_string(dotted: module))
    Rejected { diagnostics: _ } => optional_absent()
  }
}

// WHETHER THE CENSUS OBSERVED EVERY OCCURRENCE OF A MODULE, AS A TYPED ANSWER. A file the context
// refused never reached resolve, so its occurrence completeness is UNAVAILABLE -- not complete with
// zero residual, which is what a missing row would otherwise read as. A resolved module was walked
// in full. A refused one answers what its walk recorded.
type NativeCensusOccurrenceCompleteness
  = NativeCensusCompletenessUnavailable { reason: Symbol }
  | NativeCensusCompletenessObserved { observation: ObservationCompleteness }

fn native_census_module_completeness(outcome: NativeCensusModuleOutcome) -> NativeCensusOccurrenceCompleteness {
  match outcome {
    NativeCensusModuleFileRefused =>
      NativeCensusCompletenessUnavailable { reason: ^native_census_file_never_reached_resolve }
    NativeCensusModuleResolved =>
      NativeCensusCompletenessObserved { observation: ObservationComplete }
    NativeCensusModuleResolveRefused { first: _, rest: _, observation: o } =>
      NativeCensusCompletenessObserved { observation: o }
  }
}

// ONE ROW PER FAILURE CHAIN, WHICH IS ONE ROW PER INDEPENDENTLY REFUSED OCCURRENCE. A chain is
// pending advisories followed by exactly one fatal, and the fatal's locus is the occurrence the row
// names -- v2.std.diagnostic diagnostics_fatal is the one authority for which element that is. The
// row carries the chain whole rather than a reason/locus pair copied out of it, so the advisories
// that preceded this fatal stay attached to it and to no other row.
// THE POPULATION IS NOT SUMMARIZED. A module that refuses at forty independent sites yields forty
// rows; folding them to a count, or to the first, is what makes a residual census an undercount.
// An advisory is not an occurrence refusal, so it is never a row of its own.
type NativeCensusResidualRow {
  module: String
  path: Symbol
  chain: NonEmptyDiagnostics
}

fn native_census_residual_rows(
  entry: NativeCensusModule,
  first: NonEmptyDiagnostics,
  rest: List<NonEmptyDiagnostics>
) -> List<NativeCensusResidualRow> {
  list_reverse(
    xs: fold_list(
      xs: rest,
      empty: Cons {
        head: NativeCensusResidualRow { module: entry.module, path: entry.path, chain: first },
        tail: Empty
      },
      cons: fn(acc, c) {
        Cons {
          head: NativeCensusResidualRow { module: entry.module, path: entry.path, chain: c },
          tail: acc
        }
      }
    )
  )
}

// THE CENSUS IS GROUPED BY THE CAUSE THAT FIRED, NEVER BY THE ONE THAT CAME FIRST. A refusal's
// diagnostic list PREPENDS the advisories that were pending when the refusal fired
// (rejected_with_pending), so its head is whatever advisory was queued first, and grouping by it
// files every refusal under an advisory that refused nothing. v2.std.diagnostic diagnostics_fatal is the one authority
// for which element fired: a file refusal already carries its answer as `fatal_reason`
// (native_test_file_refusal), and a resolve chain is asked the same question here. The head stays on
// the member as `head_reason` so the reader still sees what rode along; it is a field, not a key.
// BOTH POPULATIONS LAND IN ONE GROUPING because they are one question -- what refused, and where --
// asked at two stages, and the stage is a field on the member rather than a second roster.
// INFER IS THE THIRD STAGE OF THE SAME QUESTION (census part 2, docs/plans/census-part-2-inference-design.md
// section 5): one more arm, not a second carrier, so every exhaustive match over the stage enrols it.
type NativeCensusCauseStage
  = NativeCensusCauseFrontEnd
  | NativeCensusCauseResolve
  | NativeCensusCauseInfer

// CENSUS C: A CASCADE IS COLLAPSED TO ITS ROOT, ON THE SAME ROW. A module that refused because an
// import target's FILE was refused is a symptom: it is filed ONCE (one member per module, not one
// per failure chain -- its chains are all the same missing index) under the ROOT's fatal reason,
// naming the root. The root's own front-end member carries the cascade's size.
// ROOTS ARE ONE HOP AWAY BY CONSTRUCTION: attribution reads only ingest refusals
// (native_import_target_attribution), whose fatal reasons are never import-target refusals.
// `None` is a refusal that is its own root (or a front-end member before C's fields apply); a
// cascade member whose imports could not be read is `Unattributed`, a typed completeness gap,
// never silently a root.
type NativeCensusCascade
  = NativeCensusCascadeNone
  | NativeCensusCascadeMemberOf { root: Symbol, root_reason: Symbol }
  | NativeCensusCascadeUnattributed { reason: Symbol }
  | NativeCensusCascadeRoot {
      closure_fan_out: NativeCensusClosureFanOut
      resolve_refused_importers: Optional<Int>
    }

// TWO COUNTS, BECAUSE THEY ARE TWO FACTS (parent ruling on census C, option A).
// `closure_fan_out` is how many DISTINCT modules have the root in their import closure -- what fixing
// the root unblocks. Those modules are BLOCKED, not refused: in c -> b -> a with a refused, resolve
// refuses b (its imports are unbound) and ACCEPTS c, because b's declarations are indexed; c still
// cannot compile as a program while a is refused. Distinct modules, never paths: a diamond counts
// its apex once.
// `resolve_refused_importers` is the directly observed fact beside it: how many modules' resolve
// refusals this census attributed to the root. Absent means resolve was not run (the `census` verb),
// not zero.
// A REFUSED FILE'S OWN IMPORTS ARE UNREAD (it has no tree), so when any OTHER refused file declares
// a module it may import the root and hide that edge -- c -> b -> a with a AND b refused loses
// b -> a, and a would read an exact 0 (review 75118). The count over the edges that WERE read is
// then a LOWER BOUND, typed as one with the number of refused files whose imports went unread;
// it is Counted, an exact answer, only when no other refused file could be a hidden importer.
type NativeCensusClosureFanOut
  = NativeCensusClosureFanOutCounted { modules: Int }
  | NativeCensusClosureFanOutAtLeast { modules: Int, unread_refused_files: Int }
  | NativeCensusClosureFanOutUnavailable { reason: Symbol }

type NativeCensusCauseMember {
  stage: NativeCensusCauseStage
  path: Symbol
  module: Optional<QualifiedName>
  head_reason: Symbol
  cascade: NativeCensusCascade
}

type NativeCensusCauseGroup {
  fatal_reason: Symbol
  members: FreeMonoid<NativeCensusCauseMember>
}

// THE REVERSE IMPORT GRAPH, READ ONCE PER CENSUS: a module name to the modules that import it.
// Edges come from the ACCEPTED trees' captured import rows (a refused file has no tree, and needs
// none: it is a root, and a root's own imports cannot unblock anything). A roster module that is
// neither file-refused nor indexed has imports nobody can read, so the graph is INCOMPLETE and every
// fan-out over it is refused with that reason -- an undercount would be the silent arm.
// `imports_of` IS THE SAME EDGE SET READ FORWARD, collected in the same pass: the subject closure
// (native_census_subject_closure) walks it, so neither direction is a second read of the graph.
type NativeCensusClosureIndex
  = NativeCensusClosureIndexRead {
      importers_of: Map<String, List<String>>
      imports_of: Map<String, List<String>>
      modules: Int
      refused_modules: Int
    }
  | NativeCensusClosureIndexUnavailable { reason: Symbol }

type NativeCensusClosureIndexStep {
  importers_of: Map<String, List<String>>
  imports_of: Map<String, List<String>>
  unread: Int
}

fn native_census_closure_index(
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  modules: List<NativeCensusModule>
) -> NativeCensusClosureIndex {
  match context.resolution {
    Rejected { diagnostics: _ } =>
      NativeCensusClosureIndexUnavailable { reason: ^native_census_closure_context_refused }
    Accepted { value: shared, diagnostics: _ } =>
      let read = fold_list(
        xs: modules,
        empty: NativeCensusClosureIndexStep { importers_of: empty_map(), imports_of: empty_map(), unread: 0 },
        cons: fn(acc, entry) {
          match map_lookup(m: shared.roots.by_name, key: qualified_name_from_dotted_string(dotted: entry.module)) {
            Absent =>
              match native_lane_file_refusal_for_path(index: refusal_index, path: entry.path) {
                Present { value: _ } => acc
                Absent => NativeCensusClosureIndexStep { importers_of: acc.importers_of, imports_of: acc.imports_of, unread: acc.unread + 1 }
              }
            Present { value: tree } =>
              NativeCensusClosureIndexStep {
                importers_of: fold_list(
                  xs: normalized_tree_import_bindings(tree: tree),
                  empty: acc.importers_of,
                  cons: fn(index, row) {
                    let target = qualified_name_to_dotted_string(qn: qualified_name_init(qn: row.target))
                    match map_lookup(index, target) {
                      Absent => map_insert(index, target, [entry.module])
                      Present { value: importers } =>
                        map_insert(index, target, Cons { head: entry.module, tail: importers })
                    }
                  }
                ),
                imports_of: map_insert(acc.imports_of, entry.module, list_map(
                  xs: normalized_tree_import_bindings(tree: tree),
                  f: fn(row) { qualified_name_to_dotted_string(qn: qualified_name_init(qn: row.target)) }
                )),
                unread: acc.unread
              }
          }
        }
      )
      if read.unread > 0 {
        NativeCensusClosureIndexUnavailable { reason: ^native_census_closure_import_graph_unread }
      } else {
        NativeCensusClosureIndexRead {
          importers_of: read.importers_of,
          imports_of: read.imports_of,
          modules: length(xs: modules),
          refused_modules: fold_list(xs: context.file_refusals, empty: 0, cons: fn(n, r) {
            match r.module {
              Absent => n
              Present { value: _ } => n + 1
            }
          })
        }
      }
  }
}

// THE SAME REACHABILITY WALK THE LANE'S CLOSURE USES (native_lane_module_reachable), run over the
// reverse graph from the root: one walk, two directions, no second closure fold. Its budget is the
// roster size plus one, which bounds the rounds of any walk over that roster; exhaustion refuses.
fn native_census_closure_fan_out(index: NativeCensusClosureIndex, root: NativeTestFileRefusal) -> NativeCensusClosureFanOut {
  native_census_closure_fan_out_of(index: index, root: root.module)
}

// THE SAME COUNT FOR ANY ROOT MODULE, whatever stage refused it: a resolve or infer root blocks its
// importers exactly as a file root does, and the reverse walk does not care which stage it was.
fn native_census_closure_fan_out_of(index: NativeCensusClosureIndex, root: Optional<QualifiedName>) -> NativeCensusClosureFanOut {
  match index {
    NativeCensusClosureIndexUnavailable { reason: r } => NativeCensusClosureFanOutUnavailable { reason: r }
    NativeCensusClosureIndexRead { importers_of: importers_of, imports_of: _, modules: modules, refused_modules: refused_modules } =>
      match root {
        Absent => NativeCensusClosureFanOutUnavailable { reason: ^native_census_closure_root_declares_no_module }
        Present { value: qn } =>
          let seed = [qualified_name_to_dotted_string(qn: qn)]
          match native_lane_module_reachable(
            index: importers_of,
            frontier: seed,
            seen: seed,
            seen_set: map_insert(empty_map(), qualified_name_to_dotted_string(qn: qn), true),
            fuel: modules + 1,
            budget: modules + 1
          ) {
            Rejected { diagnostics: _ } =>
              NativeCensusClosureFanOutUnavailable { reason: ^native_census_closure_walk_exhausted }
            Accepted { value: reached, diagnostics: _ } =>
              if refused_modules > 1 {
                NativeCensusClosureFanOutAtLeast { modules: length(xs: reached) - 1, unread_refused_files: refused_modules - 1 }
              } else {
                NativeCensusClosureFanOutCounted { modules: length(xs: reached) - 1 }
              }
          }
      }
  }
}

// KEYED BY THE FATAL REASON, ORDERED BY FIRST APPEARANCE. Members are prepended per group and each
// group is reversed once when read, so adding a member costs one lookup and one cons rather than a
// walk of its group -- the quadratic append DESIGN section 6 fixes regardless of n.
// `importers` COUNTS THE RESOLVE REFUSALS ATTRIBUTED TO EACH ROOT, keyed by the root's path. It is
// Absent when the census does not resolve, so a root member reads "not observed", not zero.
type NativeCensusCauseGroups {
  order: FreeMonoid<Symbol>
  by_reason: Map<Symbol, FreeMonoid<NativeCensusCauseMember>>
  importers: Optional<Map<Symbol, Int>>
}

fn native_census_cause_groups_empty(resolves: Bool) -> NativeCensusCauseGroups {
  NativeCensusCauseGroups {
    order: Empty,
    by_reason: empty_map(),
    importers: if resolves { optional_present(value: empty_map()) } else { optional_absent() }
  }
}

fn native_census_cause_groups_add(
  groups: NativeCensusCauseGroups,
  fatal_reason: Symbol,
  member: NativeCensusCauseMember
) -> NativeCensusCauseGroups {
  match map_lookup(groups.by_reason, fatal_reason) {
    Absent =>
      NativeCensusCauseGroups {
        order: Cons { head: fatal_reason, tail: groups.order },
        by_reason: map_insert(groups.by_reason, fatal_reason, Cons { head: member, tail: Empty }),
        importers: groups.importers
      }
    Present { value: members } =>
      NativeCensusCauseGroups {
        order: groups.order,
        by_reason: map_insert(groups.by_reason, fatal_reason, Cons { head: member, tail: members }),
        importers: groups.importers
      }
  }
}

fn native_census_cause_groups_add_file_refusal(
  groups: NativeCensusCauseGroups,
  closure: NativeCensusClosureIndex,
  refusal: NativeTestFileRefusal
) -> NativeCensusCauseGroups {
  native_census_cause_groups_add(
    groups: groups,
    fatal_reason: native_test_file_refusal_fatal_reason(fr: refusal),
    member: NativeCensusCauseMember {
      stage: NativeCensusCauseFrontEnd,
      path: refusal.path,
      module: refusal.module,
      head_reason: native_test_file_refusal_head_reason(fr: refusal),
      cascade: NativeCensusCascadeRoot {
        closure_fan_out: native_census_closure_fan_out(index: closure, root: refusal),
        resolve_refused_importers: optional_absent()
      }
    }
  )
}

// A RESOLVE ROW THAT IS ITS OWN ROOT, OR WHOSE ATTRIBUTION COULD NOT BE READ. A cascade member is
// NOT added here: it goes through native_census_cause_groups_add_cascade_member, once per module.
fn native_census_cause_groups_add_residual(
  groups: NativeCensusCauseGroups,
  cascade: NativeCensusCascade,
  row: NativeCensusResidualRow
) -> NativeCensusCauseGroups {
  native_census_cause_groups_add(
    groups: groups,
    fatal_reason: diagnostics_fatal_reason(d: row.chain),
    member: NativeCensusCauseMember {
      stage: NativeCensusCauseResolve,
      path: row.path,
      module: optional_present(value: qualified_name_from_dotted_string(dotted: row.module)),
      head_reason: row.chain.head.reason,
      cascade: cascade
    }
  )
}

// ONE MEMBER PER CASCADED MODULE, FILED UNDER ITS ROOT'S FATAL REASON, and one count on the root.
fn native_census_cause_groups_add_cascade_member(
  groups: NativeCensusCauseGroups,
  entry: NativeCensusModule,
  root: Symbol,
  root_reason: Symbol
) -> NativeCensusCauseGroups {
  let added = native_census_cause_groups_add(
    groups: groups,
    fatal_reason: root_reason,
    member: NativeCensusCauseMember {
      stage: NativeCensusCauseResolve,
      path: entry.path,
      module: optional_present(value: qualified_name_from_dotted_string(dotted: entry.module)),
      head_reason: ^native_prepare_reason_import_target_file_refused,
      cascade: NativeCensusCascadeMemberOf { root: root, root_reason: root_reason }
    }
  )
  NativeCensusCauseGroups {
    order: added.order,
    by_reason: added.by_reason,
    importers: match added.importers {
      Absent => optional_absent()
      Present { value: counts } =>
        optional_present(value: map_insert(counts, root, match map_lookup(counts, root) {
          Absent => 1
          Present { value: n } => n + 1
        }))
    }
  }
}

// `first_cascade` IS FILED ON THE FIRST CHAIN AND `cascade` ON EVERY OTHER. A module that is its own
// root carries the Root arm (with its fan-out) on ONE row, so the ranking names it once however many
// chains it refused at; the rest of its chains are its own refusals and read None.
fn native_census_cause_groups_add_chains(
  groups: NativeCensusCauseGroups,
  entry: NativeCensusModule,
  first: NonEmptyDiagnostics,
  rest: List<NonEmptyDiagnostics>,
  first_cascade: NativeCensusCascade,
  cascade: NativeCensusCascade
) -> NativeCensusCauseGroups {
  fold_list(
    xs: rest,
    empty: native_census_cause_groups_add_residual(
      groups: groups,
      cascade: first_cascade,
      row: NativeCensusResidualRow { module: entry.module, path: entry.path, chain: first }
    ),
    cons: fn(acc, c) {
      native_census_cause_groups_add_residual(
        groups: acc,
        cascade: cascade,
        row: NativeCensusResidualRow { module: entry.module, path: entry.path, chain: c }
      )
    }
  )
}

// A MODULE THAT REFUSED ON ITS OWN ACCOUNT IS A ROOT, AND ITS ROW SAYS WHAT FIXING IT UNBLOCKS: the
// same closure fan-out a file root carries (census C), counted over the same reverse import graph.
fn native_census_own_root(closure: NativeCensusClosureIndex, entry: NativeCensusModule) -> NativeCensusCascade {
  NativeCensusCascadeRoot {
    closure_fan_out: native_census_closure_fan_out_of(
      index: closure,
      root: optional_present(value: qualified_name_from_dotted_string(dotted: entry.module))
    ),
    resolve_refused_importers: optional_absent()
  }
}

// ONE CENSUS MODULE'S CONTRIBUTION TO THE GROUPS, decided here rather than in the emitted main: a
// cascade member is filed once under its root; any other resolve refusal files every chain, the
// first as the module's root row.
fn native_census_cause_groups_add_module(
  groups: NativeCensusCauseGroups,
  closure: NativeCensusClosureIndex,
  entry: NativeCensusModule,
  step: NativeCensusModuleStep
) -> NativeCensusCauseGroups {
  match step.outcome {
    NativeCensusModuleResolveRefused { first: f, rest: r, observation: _ } =>
      native_census_cause_groups_add_resolve_refused(groups: groups, closure: closure, entry: entry, first: f, rest: r, cascade: step.cascade)
    NativeCensusModuleFileRefused => groups
    NativeCensusModuleResolved => groups
  }
}

fn native_census_cause_groups_add_resolve_refused(
  groups: NativeCensusCauseGroups,
  closure: NativeCensusClosureIndex,
  entry: NativeCensusModule,
  first: NonEmptyDiagnostics,
  rest: List<NonEmptyDiagnostics>,
  cascade: NativeCensusCascade
) -> NativeCensusCauseGroups {
  match cascade {
    NativeCensusCascadeMemberOf { root: root, root_reason: root_reason } =>
      native_census_cause_groups_add_cascade_member(groups: groups, entry: entry, root: root, root_reason: root_reason)
    NativeCensusCascadeNone =>
      native_census_cause_groups_add_chains(groups: groups, entry: entry, first: first, rest: rest, first_cascade: native_census_own_root(closure: closure, entry: entry), cascade: NativeCensusCascadeNone)
    NativeCensusCascadeRoot { closure_fan_out: _, resolve_refused_importers: _ } =>
      native_census_cause_groups_add_chains(groups: groups, entry: entry, first: first, rest: rest, first_cascade: native_census_own_root(closure: closure, entry: entry), cascade: NativeCensusCascadeNone)
    NativeCensusCascadeUnattributed { reason: _ } =>
      native_census_cause_groups_add_chains(groups: groups, entry: entry, first: first, rest: rest, first_cascade: cascade, cascade: cascade)
  }
}

// ── census part 2: the infer stage ─────────────────────────────────────────────────────────────
//
// THE INFER CASCADE IS THE ONE CROSS-MODULE CAUSATION v2 INFER ACTUALLY HAS, AND NOTHING ELSE.
// docs/plans/census-part-2-inference-design.md section 4 is SUPERSEDED on this point (sharp-raven-357
// ruling, 2026-10-04). That section assumed an infer->infer edge: M's infer refusing because an imported
// T's infer refused. No such edge exists. infer_and_discharge reads ONE module's ResolvedTree, and the
// declarations it reads from imports come from the closure index at RESOLVE grain
// (v2.compiler.name_resolve closure_declarations_demand). T's inferred tree is never an input, so T
// refusing infer cannot make M refuse, and a control expecting that cascade would have a red no
// program can author (DESIGN section 4b). Its proposed edge, a fatal located at T's declaration, is
// not readable either, because every infer diagnostic is located at a node of M's own tree.
// What does exist is the edge v2.compiler.infer infer_closure_miss_refusal builds: when a closure
// provider's own RESOLVE refused (ResolvedTree unavailable_providers), M's projection through one of
// its declarations refuses as a closure miss, with the provider's refusal chain carried immediately
// ahead of that miss in M's chain. M
// resolved, so it IS an infer subject. That is a cross-stage cascade the design said could not
// happen. Such a module is filed ONCE, as a member of the provider's root, in census C's shape.
// Every other infer refusal is a root of its own.
// TRIGGER for an infer->infer edge: v2 infer reading another module's INFERRED facts. Until then,
// none is attributed.
//
// THE MATCH IS BY REASON SUFFIX AND FATAL, NOT BY GUESS. The chain must end in the closure-miss reason,
// and the reasons immediately before it must be exactly the provider's chain. That is the shape
// infer_closure_miss_refusal builds. The binds enclosing it may prepend M's own pending advisories,
// so the provider chain sits at the end of M's chain, not at its head (measured on the cascade control
// in v2.test.claim.native_census.infer_cascade: a seven-element chain carrying a one-element provider
// chain). A chain that two providers would both match is Unattributed, never assigned to the first. The provider's own root is one hop
// further when the provider is itself a cascade member of a refused file: that is read through the
// same attribution authority census C uses (native_import_target_attribution), so the member names the
// earliest refused module, exactly as a resolve cascade does.
fn native_census_infer_cascade(
  context: NativeTestContext,
  module_paths: Map<String, Symbol>,
  resolved: ResolvedTree,
  chain: NonEmptyDiagnostics
) -> NativeCensusCascade {
  native_census_infer_cascade_of(
    module_paths: module_paths,
    providers: resolved.unavailable_providers,
    chain: chain,
    attribution: fn(provider) { native_import_target_attribution(context: context, module: provider) }
  )
}

// THE ATTRIBUTION DECISION ITSELF, over the values it reads: the census roster's paths, the tree's refused
// providers, the module's chain, and the import attribution of a provider. The wrapper above binds the
// last to the context's own authority; a claim supplies all four at this interface (DESIGN section 3).
fn native_census_infer_cascade_of(
  module_paths: Map<String, Symbol>,
  providers: List<ClosureProviderRefusal>,
  chain: NonEmptyDiagnostics,
  attribution: fn(QualifiedName) -> NativeImportTargetAttribution
) -> NativeCensusCascade {
  if diagnostics_fatal_reason(d: chain) == ^infer_reason_projection_receiver_declaration_unavailable {
    let reversed = list_reverse(xs: native_census_chain_reasons(chain: chain))
    let leading = filter(xs: providers, predicate: fn(p) {
      list_starts_with(
        xs: reversed,
        prefix: Cons { head: ^infer_reason_projection_receiver_declaration_unavailable, tail: list_reverse(xs: native_census_chain_reasons(chain: p.refusal)) },
        eq: fn(a, b) { a == b }
      )
    })
    match leading {
      Empty => NativeCensusCascadeNone
      Cons { head: provider, tail: others } =>
        if length(xs: others) > 0 {
          NativeCensusCascadeUnattributed { reason: ^native_census_infer_cascade_provider_ambiguous }
        } else {
          match map_lookup(module_paths, qualified_name_to_dotted_string(qn: provider.module)) {
            Absent => NativeCensusCascadeUnattributed { reason: ^native_census_infer_cascade_provider_not_censused }
            Present { value: provider_path } =>
              match attribution(provider.module) {
                NativeImportTargetRefused { target: t } => NativeCensusCascadeMemberOf { root: t.path, root_reason: native_test_file_refusal_fatal_reason(fr: t) }
                NativeImportTargetsUnreadable { reason: r } => NativeCensusCascadeUnattributed { reason: r }
                NativeImportTargetsAdmitted => NativeCensusCascadeMemberOf { root: provider_path, root_reason: diagnostics_fatal_reason(d: provider.refusal) }
                NativeImportTargetNotAsked => NativeCensusCascadeMemberOf { root: provider_path, root_reason: diagnostics_fatal_reason(d: provider.refusal) }
              }
          }
        }
    }
  } else {
    NativeCensusCascadeNone
  }
}

fn native_census_chain_reasons(chain: NonEmptyDiagnostics) -> List<Symbol> {
  Cons { head: chain.head.reason, tail: list_map(xs: chain.tail, f: fn(d) { d.reason }) }
}

// THE CENSUS ROSTER'S MODULE NAMES TO THEIR PATHS, read once per census, so an attributed root is named
// by the same path identity every other root carries.
fn native_census_module_paths(modules: List<NativeCensusModule>) -> Map<String, Symbol> {
  fold_list(xs: modules, empty: empty_map(), cons: fn(m, entry) { map_insert(m, entry.module, entry.path) })
}

// ONE census-infer MODULE'S CONTRIBUTION. A resolve refusal is filed exactly as census-resolve files it,
// because it is the same decision. An infer refusal is ONE row: infer stops at its first fatal, so
// native_census_infer_completeness reports that module's observation as a lower bound. The row is either
// a member of the closure provider's root that led its chain, or a root of its own carrying its fan-out.
fn native_census_cause_groups_add_infer_module(
  groups: NativeCensusCauseGroups,
  closure: NativeCensusClosureIndex,
  module_paths: Map<String, Symbol>,
  entry: NativeCensusModule,
  step: NativeInferCensusStep
) -> NativeCensusCauseGroups {
  match step.outcome {
    NativeInferCensusFileRefused => groups
    NativeInferCensusResolveRefused { first: f, rest: r, observation: _ } =>
      native_census_cause_groups_add_resolve_refused(groups: groups, closure: closure, entry: entry, first: f, rest: r, cascade: step.cascade)
    NativeInferCensusInferred { resolved: _, inferred: _ } => groups
    NativeInferCensusInferRefused { resolved: resolved, chain: chain } =>
      match native_census_infer_cascade(context: step.context, module_paths: module_paths, resolved: resolved, chain: chain) {
        NativeCensusCascadeMemberOf { root: root, root_reason: root_reason } =>
          native_census_infer_member(groups: groups, fatal_reason: root_reason, entry: entry, chain: chain, cascade: NativeCensusCascadeMemberOf { root: root, root_reason: root_reason })
        NativeCensusCascadeUnattributed { reason: r } =>
          native_census_infer_member(groups: groups, fatal_reason: diagnostics_fatal_reason(d: chain), entry: entry, chain: chain, cascade: NativeCensusCascadeUnattributed { reason: r })
        NativeCensusCascadeNone =>
          native_census_infer_member(groups: groups, fatal_reason: diagnostics_fatal_reason(d: chain), entry: entry, chain: chain, cascade: native_census_own_root(closure: closure, entry: entry))
        NativeCensusCascadeRoot { closure_fan_out: _, resolve_refused_importers: _ } =>
          native_census_infer_member(groups: groups, fatal_reason: diagnostics_fatal_reason(d: chain), entry: entry, chain: chain, cascade: native_census_own_root(closure: closure, entry: entry))
      }
  }
}

fn native_census_infer_member(
  groups: NativeCensusCauseGroups,
  fatal_reason: Symbol,
  entry: NativeCensusModule,
  chain: NonEmptyDiagnostics,
  cascade: NativeCensusCascade
) -> NativeCensusCauseGroups {
  native_census_cause_groups_add(
    groups: groups,
    fatal_reason: fatal_reason,
    member: NativeCensusCauseMember {
      stage: NativeCensusCauseInfer,
      path: entry.path,
      module: optional_present(value: qualified_name_from_dotted_string(dotted: entry.module)),
      head_reason: chain.head.reason,
      cascade: cascade
    }
  )
}

// WHETHER THE census-infer WALK OBSERVED EVERY REFUSAL OF A MODULE. infer_and_discharge returns at its
// first fatal, so an infer refusal is a LOWER BOUND and says so; the resolve arms answer as census-resolve
// answers them.
fn native_census_infer_completeness(outcome: NativeInferCensusOutcome) -> NativeCensusOccurrenceCompleteness {
  match outcome {
    NativeInferCensusFileRefused =>
      NativeCensusCompletenessUnavailable { reason: ^native_census_file_never_reached_resolve }
    NativeInferCensusResolveRefused { first: _, rest: _, observation: o } =>
      NativeCensusCompletenessObserved { observation: o }
    NativeInferCensusInferred { resolved: _, inferred: _ } =>
      NativeCensusCompletenessObserved { observation: ObservationComplete }
    NativeInferCensusInferRefused { resolved: _, chain: _ } =>
      NativeCensusCompletenessObserved { observation: ObservationIncomplete { reason: ^native_census_infer_stops_at_first_fatal } }
  }
}

// THE NATIVE TEST TARGET THE INFER CENSUS MARKS ITS ROOTS AGAINST: roadmap node `native-seven`
// (gunbc.roadmap.roadmap_authority), whose boundary names this label and rules that its population is
// DERIVED from the label, never kept as a list. So there is no roster of its tests here. The label is
// parsed by the one target-pattern authority, its package names the subject module by the same
// correspondence the native lane uses (gunbc.witness.v2_native_route native_route_module_package_text),
// and the subject's closure is walked over the census's own import graph. A root is "in the N7 closure"
// exactly when the subject module reaches it. The label is the instrument's own fact, never a CLI option.
data native_census_subject_label: String = "//v2/test/claim/parse/expression_bodied_fn_decl_parse:all"

type NativeCensusSubjectClosure
  = NativeCensusSubjectClosureRead { subject: String, members: Map<String, Bool> }
  | NativeCensusSubjectClosureUnavailable { reason: Symbol }

fn native_census_subject_closure(
  index: NativeCensusClosureIndex,
  modules: List<NativeCensusModule>,
  label: String
) -> NativeCensusSubjectClosure {
  match parse_target_pattern(text: label) {
    TargetPatternRefused { cause: _ } =>
      NativeCensusSubjectClosureUnavailable { reason: ^native_census_subject_label_refused }
    TargetPatternParsed { pattern: pattern } =>
      match pattern {
        SingleTarget { label: _ } => NativeCensusSubjectClosureUnavailable { reason: ^native_census_subject_label_names_no_module }
        SubtreeTargets { package: _ } => NativeCensusSubjectClosureUnavailable { reason: ^native_census_subject_label_names_no_module }
        PackageTargets { package: package } =>
          match list_find_first(xs: modules, predicate: fn(m) { native_route_module_package_text(module_qn: m.module) == render_package(p: package) }) {
            Absent => NativeCensusSubjectClosureUnavailable { reason: ^native_census_subject_module_not_censused }
            Present { value: subject } =>
              match index {
                NativeCensusClosureIndexUnavailable { reason: r } => NativeCensusSubjectClosureUnavailable { reason: r }
                NativeCensusClosureIndexRead { importers_of: _, imports_of: imports_of, modules: n, refused_modules: _ } =>
                  match native_lane_module_reachable(
                    index: imports_of,
                    frontier: [subject.module],
                    seen: [subject.module],
                    seen_set: map_insert(empty_map(), subject.module, true),
                    fuel: n + 1,
                    budget: n + 1
                  ) {
                    Rejected { diagnostics: _ } => NativeCensusSubjectClosureUnavailable { reason: ^native_census_closure_walk_exhausted }
                    Accepted { value: reached, diagnostics: _ } =>
                      NativeCensusSubjectClosureRead {
                        subject: subject.module,
                        members: fold_list(xs: reached, empty: empty_map(), cons: fn(m, r) { map_insert(m, r, true) })
                      }
                  }
              }
          }
      }
  }
}

// WHETHER ONE RANKED ROOT IS IN THE SUBJECT'S CLOSURE. Three answers: a root whose module is unknown, or a
// subject closure that could not be read, is Unavailable, never "outside".
type NativeCensusSubjectMembership
  = NativeCensusInSubjectClosure
  | NativeCensusOutsideSubjectClosure
  | NativeCensusSubjectMembershipUnavailable { reason: Symbol }

fn native_census_root_subject_membership(
  subject: NativeCensusSubjectClosure,
  root: NativeCensusCauseMember
) -> NativeCensusSubjectMembership {
  match subject {
    NativeCensusSubjectClosureUnavailable { reason: r } => NativeCensusSubjectMembershipUnavailable { reason: r }
    NativeCensusSubjectClosureRead { subject: _, members: members } =>
      match root.module {
        Absent => NativeCensusSubjectMembershipUnavailable { reason: ^native_census_closure_root_declares_no_module }
        Present { value: qn } =>
          match map_lookup(members, qualified_name_to_dotted_string(qn: qn)) {
            Present { value: _ } => NativeCensusInSubjectClosure
            Absent => NativeCensusOutsideSubjectClosure
          }
      }
  }
}

fn native_census_cause_groups_from_file_refusals(
  refusals: FreeMonoid<NativeTestFileRefusal>,
  closure: NativeCensusClosureIndex,
  resolves: Bool
) -> NativeCensusCauseGroups {
  fold_list(
    xs: refusals,
    empty: native_census_cause_groups_empty(resolves: resolves),
    cons: fn(acc, r) { native_census_cause_groups_add_file_refusal(groups: acc, closure: closure, refusal: r) }
  )
}

// A ROOT MEMBER IS READ WITH ITS OBSERVED IMPORTER COUNT; every other member is read as filed.
fn native_census_cause_member_read(groups: NativeCensusCauseGroups, member: NativeCensusCauseMember) -> NativeCensusCauseMember {
  match member.cascade {
    NativeCensusCascadeRoot { closure_fan_out: fan_out, resolve_refused_importers: _ } =>
      NativeCensusCauseMember {
        stage: member.stage,
        path: member.path,
        module: member.module,
        head_reason: member.head_reason,
        cascade: NativeCensusCascadeRoot {
          closure_fan_out: fan_out,
          resolve_refused_importers: match groups.importers {
            Absent => optional_absent()
            Present { value: counts } =>
              match map_lookup(counts, member.path) {
                Absent => optional_present(value: 0)
                Present { value: n } => optional_present(value: n)
              }
          }
        }
      }
    NativeCensusCascadeNone => member
    NativeCensusCascadeMemberOf { root: _, root_reason: _ } => member
    NativeCensusCascadeUnattributed { reason: _ } => member
  }
}

// `order` IS NEWEST-FIRST, so consing each group onto the accumulator while walking it yields
// first-appearance order in one pass: no snoc onto a cons list, and no reverse of the order
// (review 74382; DESIGN section 6 bare minimum cost). Each group's members are reversed and read
// in that same single pass.
fn native_census_cause_group_rows(groups: NativeCensusCauseGroups) -> List<NativeCensusCauseGroup> {
  fold_list(
    xs: groups.order,
    empty: Empty,
    cons: fn(acc, reason) {
      match map_lookup(groups.by_reason, reason) {
        Absent => acc
        Present { value: members } =>
          Cons {
            head: NativeCensusCauseGroup {
              fatal_reason: reason,
              members: fold_list(
                xs: members,
                empty: Empty,
                cons: fn(read, m) { Cons { head: native_census_cause_member_read(groups: groups, member: m), tail: read } }
              )
            },
            tail: acc
          }
      }
    }
  )
}

// THE ROOTS, RANKED BY CLOSURE FAN-OUT, highest first; a lower bound (AtLeast) ranks by its bound
// and keeps its arm on the row, and a root whose fan-out is Unavailable ranks after every counted
// one rather than reading as zero. Same member rows as the groups -- this is an
// ORDER over them, not a second format. Bucketed by count so ranking is linear in roots plus the
// largest count, never an insertion sort (DESIGN section 6).
type NativeCensusRootBuckets {
  by_count: Map<Int, FreeMonoid<NativeCensusCauseMember>>
  top: Int
  unavailable: FreeMonoid<NativeCensusCauseMember>
}

fn native_census_roots_ranked(rows: List<NativeCensusCauseGroup>) -> List<NativeCensusCauseMember> {
  let buckets = fold_list(
    xs: rows,
    empty: NativeCensusRootBuckets { by_count: empty_map(), top: 0, unavailable: Empty },
    cons: fn(acc, group) {
      fold_list(xs: group.members, empty: acc, cons: fn(b, m) {
        match m.cascade {
          NativeCensusCascadeRoot { closure_fan_out: fan_out, resolve_refused_importers: _ } =>
            match fan_out {
              NativeCensusClosureFanOutUnavailable { reason: _ } =>
                NativeCensusRootBuckets { by_count: b.by_count, top: b.top, unavailable: Cons { head: m, tail: b.unavailable } }
              NativeCensusClosureFanOutAtLeast { modules: n, unread_refused_files: _ } =>
                native_census_root_buckets_add(buckets: b, member: m, count: n)
              NativeCensusClosureFanOutCounted { modules: n } =>
                native_census_root_buckets_add(buckets: b, member: m, count: n)
            }
          NativeCensusCascadeNone => b
          NativeCensusCascadeMemberOf { root: _, root_reason: _ } => b
          NativeCensusCascadeUnattributed { reason: _ } => b
        }
      })
    }
  )
  native_census_roots_from_buckets(buckets: buckets, count: 0, ranked: list_reverse(xs: buckets.unavailable))
}

fn native_census_root_buckets_add(buckets: NativeCensusRootBuckets, member: NativeCensusCauseMember, count: Int) -> NativeCensusRootBuckets {
  NativeCensusRootBuckets {
    by_count: map_insert(buckets.by_count, count, match map_lookup(buckets.by_count, count) {
      Absent => Cons { head: member, tail: Empty }
      Present { value: ms } => Cons { head: member, tail: ms }
    }),
    top: if buckets.top < count { count } else { buckets.top },
    unavailable: buckets.unavailable
  }
}

// WALKS THE COUNTS UPWARD, consing each bucket in front, so the highest count ends first. Within a
// count the roots keep first-appearance order. Descent: top - count strictly decreases.
fn native_census_roots_from_buckets(
  buckets: NativeCensusRootBuckets,
  count: Int,
  ranked: List<NativeCensusCauseMember>
) -> List<NativeCensusCauseMember> {
  if count > buckets.top {
    ranked
  } else {
    native_census_roots_from_buckets(
      buckets: buckets,
      count: count + 1,
      ranked: match map_lookup(buckets.by_count, count) {
        Absent => ranked
        Present { value: ms } => fold_list(xs: ms, empty: ranked, cons: fn(acc, m) { Cons { head: m, tail: acc } })
      }
    )
  }
}

// THE LIVE-VERDICT CONTROLS, EXECUTED BY THE SAME ROUTE AS EVERY MEMBER. They sit outside the
// universe prefix, so discovery enrols nothing for them and the authority's own declaration is
// what names them; a verdict is Absent exactly when the route could not produce one, which is the
// state the false/true clauses refuse. BOTH are answered from ONE prepare: they share a module,
// and resolve + infer over the whole context is the per-module cost this fold exists to pay once.
type NativeLaneControls {
  false_control: Optional<NativeTestVerdict>
  true_control: Optional<NativeTestVerdict>
}

// THE CONTROL MODULE'S OWN FAILURE IS CARRIED, NOT COLLAPSED (review 64181). This discarded
// the resolver's diagnostics and answered Absent/Absent, which admission does refuse -- so it
// was never fail-open -- but it made a DEFECT IN THE CONTROL MODULE indistinguishable from any
// other missing verdict, which is the one distinction these two controls exist to draw. The
// refusal is carried as the verdict it is, at the stage it happened, with the reason every
// sibling arm preserves. Both clauses already map NativeTestRefused to false
// (gunbc.witness.v2_native_route native_route_false_control_holds / _true_control_holds), so
// this reports the same verdict with the cause attached rather than changing what is admitted.
fn native_lane_controls(context: NativeTestContext) -> NativeLaneControls {
  match native_test_prepare_module(
    context: context,
    module: qualified_name_from_dotted_string(dotted: native_route_live_control_module)
  ).prepared {
    Rejected { diagnostics: d } =>
      {
        let refused = NativeTestRefused { stage: NativeTestStagePrepare, diagnostics: d }
        NativeLaneControls {
          false_control: optional_present(value: refused),
          true_control: optional_present(value: refused)
        }
      }
    Accepted { value: prepared, diagnostics: _ } =>
      {
        let false_observation = native_test_eval_one(
          prepared: prepared,
          declaration: symbol_intern_lexeme(lexeme: native_route_live_control_false_declaration)
        )
        let true_observation = native_test_eval_one(
          prepared: prepared,
          declaration: symbol_intern_lexeme(lexeme: native_route_live_control_true_declaration)
        )
        NativeLaneControls {
          false_control: optional_present(value: false_observation.verdict),
          true_control: optional_present(value: true_observation.verdict)
        }
      }
  }
}

// ── the receipt, minted and judged inside the route ────────────────────────────────────────
//
// THE HOST FACTS ARE THE ONLY THING THE ROUTE CANNOT OBSERVE OF ITSELF: which seed PREPARED the
// compiler artifact, what the closure's and the executable's content identities are, HOW the old
// route's fallback was closed, what the malformed specimen's own run observed, and how the
// compiler artifact was BUILT (the spawn's argv, flags, bound compiler, rustc identity, status
// and warning count -- NativeRouteEmittedBuild, observed by the host at the cargo spawn this
// process is the product of, so by construction not observable from inside it). They are
// received as data and recorded verbatim; every other field of the receipt is this process's own
// observation, and the admission that judges it is the authority's, evaluated here.
//
// THE OLD-ROUTE CONTROL ARRIVES AS THE AUTHORITY'S OWN COPRODUCT rather than as a path plus an
// assumption about what the host did with it. The harness withdrew an executable, or found none at
// the path for the whole window; both are observations and the authority names both, so the host
// cannot report one while the other held (operator design review 2026-09-11, C5: the harness must
// not REQUIRE the old route to exist so that it can move it).
type NativeLaneHostFacts {
  tested_tree: String
  preparation_seed_identity: String
  emitted_closure_identity: String
  executable_path: String
  executable_identity: String
  old_route_control: NativeRouteOldRouteControl
  malformed_control: NativeRouteMalformedControl
  emitted_build: NativeRouteEmittedBuild
}

fn native_lane_receipt(
  context: NativeTestContext,
  universe: NativeLaneUniverse,
  population: List<NativeRouteMemberRow>,
  controls: NativeLaneControls,
  facts: NativeLaneHostFacts
) -> NativeRouteReceipt {
  NativeRouteReceipt {
    job: required_v2_native_job_name,
    tested_tree: facts.tested_tree,
    preparation_seed_identity: facts.preparation_seed_identity,
    emitted_closure_identity: facts.emitted_closure_identity,
    executable_path: facts.executable_path,
    executable_identity: facts.executable_identity,
    universe: universe.identities,
    module_source_index: universe.module_sources,
    population: population,
    file_refusals: context.file_refusals,
    false_control: controls.false_control,
    true_control: controls.true_control,
    malformed_control: facts.malformed_control,
    old_route_control: facts.old_route_control,
    emitted_build: facts.emitted_build
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE NATIVE EVAL LAYER AS A DERIVED DEMAND GRAPH
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// The emitted driver walks `for entry in universe.modules` and, inside it, `for declaration in
// entry.declarations`. Those two loops ARE a dependency structure written as control flow: an
// identity's evaluation consumes the prepared module that inference produced, and inference
// consumes the tree that resolution produced. Nothing about that ordering is a policy choice --
// it is what the values require -- so it is DERIVED here from the same three producers the loop
// calls, rather than authored as a second roster beside them.
//
// WHY THE VERDICT PRODUCERS ARE UNCHANGED. This cut moves SCHEDULING authority and nothing else.
// `native_lane_module_resolution`, `native_lane_module_inference` and `native_lane_identity_row`
// are called here exactly as the loop calls them, with the same arguments in the same order, so
// the verdicts are preserved BY CONSTRUCTION rather than by a comparison that could pass for the
// wrong reason. A cut that also re-derived the verdicts would make a row difference ambiguous
// between "the schedule changed" and "the judgment changed", which is the conflation that makes
// an A/B receipt worthless.
//
// THE THREE STAGES ARE THREE DEMANDS, NOT ONE. Fusing them would hide exactly the fact the engine
// exists to expose: a module whose resolution refuses must leave its identities BLOCKED on a named
// refused prerequisite, not silently unevaluated, and that distinction is only visible if the
// prerequisite is its own demand with its own settled state.

// THE SUBJECT IS DERIVED FROM WHAT THE DEMAND IS ABOUT, and for an identity that is the PAIR. A
// digest of the declaration alone would give `holds` in two modules one subject, and the engine
// would then attach one to the other as an equal share-admitted demand and evaluate it once --
// a wrong answer produced by a key that lost a field, which is why the pair is combined rather
// than concatenated into a string whose separator could appear in either half.
fn native_demand_module_subject(module: String) -> Fnv1a64Structural {
  content_hash_atom(value: module as NonEmptyStr)
}

fn native_demand_identity_subject(module: String, declaration: String) -> Fnv1a64Structural {
  content_hash_combine_structural(
    left: content_hash_atom(value: module as NonEmptyStr),
    right: content_hash_atom(value: declaration as NonEmptyStr)
  )
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE THREE JUDGMENTS OF THE NATIVE EVAL LAYER, DECLARED BESIDE THEIR PRODUCERS
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// These sat in std.materialization_provider beside the parse and typecheck contracts, which put a
// statement about what THIS module's resolve, infer and eval judgments ARE in a module that cannot
// call any of them. A contract belongs with the producer it constrains: when native_lane_module_
// inference gains a declared input, the contract that must gain it is in the same file, and a
// reviewer reading either sees both.
//
// THE NATIVE EVAL LAYER'S THREE JUDGMENTS. They are contracts rather than three inline identity
// constructions because JudgmentContract is the authority for what a demand IS -- its subject, its
// result contract and its demand nature -- and a scheduler that minted identities beside it would
// be a second answer to that question, differing first on the field nobody checks. The scheduler
// reads `demand_identity` and `demand_nature` off these and derives nothing itself.
//
// THE COMPILER IS A DECLARED INPUT OF ALL THREE, not an ambient fact. Two runs of one module under
// different compilers are different judgments with different results, so a key that omitted the
// compiler would let a later cross-run lookup serve the earlier compiler's answer -- which is the
// whole reason the existing contracts above carry it too.
//
// ALL THREE ARE PureComputation, AND THAT IS A READING RATHER THAN A DEFAULT. Resolution, inference
// and identity evaluation are functions of their inputs: they read no clock, mutate nothing, and
// two evaluations of one subject under one compiler are interchangeable. That is what admits
// in-flight sharing for them, and it is the property that would have to be withdrawn -- here, once
// -- if any of them ever reached an effect.
fn native_module_resolve_judgment_contract(
  module_digest: Fnv1a64Structural,
  compiler: DeclaredInput
) -> JudgmentContract {
  JudgmentContract {
    demand_identity: DemandIdentity {
      kind: native_module_resolve_artifact_kind,
      subject: module_digest,
      declared_inputs: [compiler]
    },
    result: ResultContract {
      carries_semantic_value: true,
      ordered_diagnostics: true,
      carries_effect_requests_receipts: false,
      carries_refusal_arm: true,
      required_persisted_outputs: [
        persisted_output(id: output_module_preparation_diagnostics, occurrence_contract: Scoped)
      ]
    },
    demand_nature: PureComputation
  }
}

fn native_module_infer_judgment_contract(
  module_digest: Fnv1a64Structural,
  compiler: DeclaredInput
) -> JudgmentContract {
  JudgmentContract {
    demand_identity: DemandIdentity {
      kind: native_module_infer_artifact_kind,
      subject: module_digest,
      declared_inputs: [compiler]
    },
    result: ResultContract {
      carries_semantic_value: true,
      ordered_diagnostics: true,
      carries_effect_requests_receipts: false,
      carries_refusal_arm: true,
      required_persisted_outputs: [
        persisted_output(id: output_module_preparation_diagnostics, occurrence_contract: Scoped)
      ]
    },
    demand_nature: PureComputation
  }
}

// THE SUBJECT IS THE MODULE AND DECLARATION COMBINED, not the declaration alone. `holds` names a
// different judgment in every module that declares it, and a subject that lost the module would
// give them one identity -- at which point the engine attaches one to the other as an equal
// share-admitted demand and evaluates ONE, reporting a verdict for a declaration it never ran.
fn native_test_identity_judgment_contract(
  identity_digest: Fnv1a64Structural,
  compiler: DeclaredInput
) -> JudgmentContract {
  JudgmentContract {
    demand_identity: DemandIdentity {
      kind: native_test_identity_artifact_kind,
      subject: identity_digest,
      declared_inputs: [compiler]
    },
    result: ResultContract {
      carries_semantic_value: true,
      ordered_diagnostics: true,
      carries_effect_requests_receipts: false,
      carries_refusal_arm: true,
      required_persisted_outputs: [
        persisted_output(id: output_module_test_verdicts, occurrence_contract: SemanticOnly)
      ]
    },
    demand_nature: PureComputation
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// IDENTITY AND NATURE ARE READ OFF THE JUDGMENT CONTRACT, NEVER BUILT HERE
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// std.judgment_contract JudgmentContract is the authority for what a demand IS: its subject,
// its result contract and its demand nature. A scheduler that constructed DemandIdentity values
// itself would be a second answer to that question -- and the two would agree right up until one
// of them gained a declared input, at which point the scheduler would key a demand the
// materialization layer would not recognise, silently, in the direction where a stale result gets
// served. So this module takes the contract and projects it; it derives nothing.
//
// THE SAME GOES FOR SHARING. `nature` decides whether two equal demands may attach in flight, and
// that is a property of the JUDGMENT, not a policy the scheduler is entitled to choose. Reading it
// here means a judgment that ever stops being pure withdraws its own share admission, once, at the
// contract -- rather than in however many schedulers had hardcoded PureComputation beside it.
fn native_demand_resolve_contract(module: String, compiler: DeclaredInput) -> JudgmentContract {
  native_module_resolve_judgment_contract(
    module_digest: native_demand_module_subject(module: module),
    compiler: compiler
  )
}

fn native_demand_infer_contract(module: String, compiler: DeclaredInput) -> JudgmentContract {
  native_module_infer_judgment_contract(
    module_digest: native_demand_module_subject(module: module),
    compiler: compiler
  )
}

fn native_demand_eval_contract(
  module: String,
  declaration: String,
  compiler: DeclaredInput
) -> JudgmentContract {
  native_test_identity_judgment_contract(
    identity_digest: native_demand_identity_subject(module: module, declaration: declaration),
    compiler: compiler
  )
}

// THE OCCURRENCE CENSUS IS ITS OWN JUDGMENT, a pure reading of a module's resolved tree, observation
// only: it decides no standing and refuses nothing, so its result carries no refusal arm. It is a
// separate demand rather than a step inside infer so that its cost is its own exclusive row
// (std.compiler_entry ExclusiveOccurrenceCensus) and never inflates prepare.
fn native_module_occurrence_census_judgment_contract(
  module_digest: Fnv1a64Structural,
  compiler: DeclaredInput
) -> JudgmentContract {
  JudgmentContract {
    demand_identity: DemandIdentity {
      kind: native_module_occurrence_census_artifact_kind,
      subject: module_digest,
      declared_inputs: [compiler]
    },
    result: ResultContract {
      carries_semantic_value: true,
      ordered_diagnostics: false,
      carries_effect_requests_receipts: false,
      carries_refusal_arm: false,
      required_persisted_outputs: []
    },
    demand_nature: PureComputation
  }
}

fn native_demand_occurrence_census_contract(module: String, compiler: DeclaredInput) -> JudgmentContract {
  native_module_occurrence_census_judgment_contract(
    module_digest: native_demand_module_subject(module: module),
    compiler: compiler
  )
}

fn native_demand_resolve_identity(module: String, compiler: DeclaredInput) -> DemandIdentity {
  native_demand_resolve_contract(module: module, compiler: compiler).demand_identity
}

fn native_demand_infer_identity(module: String, compiler: DeclaredInput) -> DemandIdentity {
  native_demand_infer_contract(module: module, compiler: compiler).demand_identity
}

fn native_demand_eval_identity(
  module: String,
  declaration: String,
  compiler: DeclaredInput
) -> DemandIdentity {
  native_demand_eval_contract(
    module: module,
    declaration: declaration,
    compiler: compiler
  ).demand_identity
}

// THE ENGINE IS GENERIC IN ITS RESULT VALUE, so the three stages' three result shapes ride in one
// coproduct. It is a coproduct rather than three engines because one ready queue over one identity
// space is the whole point: three engines would reintroduce the cross-stage ordering question the
// single queue answers, and would do it in a place with no typed blocked states.
type NativeDemandValue
  = NativeResolveValue { resolution: NativeLaneModuleResolution }
  | NativeInferValue { preparation: NativeLaneModulePreparation }
  | NativeOccurrenceCensusValue { row: NativeLaneOccurrenceCensusRow }
  | NativeEvalValue { row: NativeRouteMemberRow }

// The binding from a keyed demand back to what it denotes. The engine keys, orders and admits; it
// does not know what a key means, and it must not -- a scheduler that understood compiler stages
// would be a second authority on both. This table is that knowledge, held beside the engine rather
// than inside it.
type NativeDemandSubject
  = NativeResolveSubject { entry: NativeLaneUniverseModule }
  | NativeInferSubject { entry: NativeLaneUniverseModule }
  | NativeOccurrenceCensusSubject { entry: NativeLaneUniverseModule }
  | NativeEvalSubject { module: String, declaration: String }

type NativeDemandBinding {
  identity: DemandIdentity
  subject: NativeDemandSubject
}

type NativeDemandPlan {
  engine: DemandEngine<NativeDemandValue>
  bindings: List<NativeDemandBinding>
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// DERIVING THE GRAPH FROM THE UNIVERSE THE ROUTE ALREADY CARRIES
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// One resolve and one infer demand per module, one eval demand per declaration, and the edges the
// values require. The universe roster is the SAME one the loop iterates, so the demand population
// is exactly the population that would have been walked -- not a subset chosen here, and not a
// hand-written list that could drift from it.
fn native_demand_plan_module(
  plan: NativeDemandPlan,
  entry: NativeLaneUniverseModule,
  compiler: DeclaredInput
) -> NativeDemandPlan {
  let resolve_contract = native_demand_resolve_contract(module: entry.module, compiler: compiler)
  let infer_contract = native_demand_infer_contract(module: entry.module, compiler: compiler)
  let census_contract = native_demand_occurrence_census_contract(module: entry.module, compiler: compiler)
  let resolve_id = resolve_contract.demand_identity
  let infer_id = infer_contract.demand_identity
  let census_id = census_contract.demand_identity
  let with_resolve_infer = NativeDemandPlan {
    engine: demand_engine_relate(
      e: demand_engine_request(
        e: demand_engine_request(e: plan.engine, id: resolve_id, nature: resolve_contract.demand_nature),
        id: infer_id,
        nature: infer_contract.demand_nature
      ),
      relation: DependencyRelation {
        prerequisite: resolve_id,
        dependent: infer_id,
        kind: DataDependsOn
      }
    ),
    bindings: list_snoc_item(
      xs: list_snoc_item(
        xs: plan.bindings,
        item: NativeDemandBinding { identity: resolve_id, subject: NativeResolveSubject { entry: entry } }
      ),
      item: NativeDemandBinding { identity: infer_id, subject: NativeInferSubject { entry: entry } }
    )
  }
  let with_stages = NativeDemandPlan {
    engine: demand_engine_relate(
      e: demand_engine_request(e: with_resolve_infer.engine, id: census_id, nature: census_contract.demand_nature),
      relation: DependencyRelation {
        prerequisite: resolve_id,
        dependent: census_id,
        kind: DataDependsOn
      }
    ),
    bindings: list_snoc_item(
      xs: with_resolve_infer.bindings,
      item: NativeDemandBinding { identity: census_id, subject: NativeOccurrenceCensusSubject { entry: entry } }
    )
  }
  fold_list(
    xs: entry.declarations,
    empty: with_stages,
    cons: fn(acc, declaration) {
      let eval_contract = native_demand_eval_contract(
        module: entry.module,
        declaration: declaration,
        compiler: compiler
      )
      let eval_id = eval_contract.demand_identity
      NativeDemandPlan {
        engine: demand_engine_relate(
          e: demand_engine_request(e: acc.engine, id: eval_id, nature: eval_contract.demand_nature),
          relation: DependencyRelation {
            prerequisite: infer_id,
            dependent: eval_id,
            kind: DataDependsOn
          }
        ),
        bindings: list_snoc_item(
          xs: acc.bindings,
          item: NativeDemandBinding {
            identity: eval_id,
            subject: NativeEvalSubject { module: entry.module, declaration: declaration }
          }
        )
      }
    }
  )
}

fn native_demand_plan(
  modules: List<NativeLaneUniverseModule>,
  compiler: DeclaredInput
) -> NativeDemandPlan {
  let planned = fold_list(
    xs: modules,
    empty: NativeDemandPlan { engine: demand_engine_empty(), bindings: [] },
    cons: fn(acc, entry) { native_demand_plan_module(plan: acc, entry: entry, compiler: compiler) }
  )
  NativeDemandPlan {
    engine: demand_engine_seal(e: planned.engine),
    bindings: planned.bindings
  }
}

fn native_demand_binding(plan: NativeDemandPlan, id: DemandIdentity) -> Optional<NativeDemandSubject> {
  fold_list(
    xs: plan.bindings,
    empty: optional_absent(),
    cons: fn(acc, b) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if demand_identity_eq(a: b.identity, b: id) {
            optional_present(value: b.subject)
          } else {
            optional_absent()
          }
      }
    }
  )
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE STATE-TRANSITION RECEIPT
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// One row per admission, in the order the single seat admitted them, carrying the demand key and
// the state it settled into. It is RECORDED as it happens rather than reconstructed from final
// states, because the order is the fact under test: two runs of one closure must admit the same
// demands in the same order, and a final-state snapshot has already lost that.
//
// The key is the canonical demand encoding, so a receipt is comparable across runs without being
// comparable across MEANINGS: two different subjects cannot print one key.
// THE TRANSITION CARRIES THE TYPED IDENTITY AND A DURATION, AND NOTHING ELSE.
//
// It used to carry rendered strings -- a stage spelling and a settlement label -- which were then
// READ BACK to decide which exclusive cost row a span belonged to and whether a preparation had
// succeeded. That is an encoding standing between a modelled fact and its consumer: typed
// DemandIdentity and DemandState were rendered to text and the text was re-parsed to recover cost
// and outcome meaning. Strings are admissible AFTER meaning is decided, never as the authority that
// decides it.
//
// IT ALSO HAD A FAIL-OPEN ARM. The stage spelling was produced by a label function that answered
// "unbound" when the plan binding was absent, while the totals recognised only three spellings -- so
// an admitted transition could contribute to NEITHER exclusive total and NEITHER sample population,
// disappearing into the unattributed residual instead of making the observation incomplete. That is
// a degradation that widens rather than refusing (DESIGN section 5), and the classification below
// has no such arm: an unrecognised kind is COUNTED as unclassified and the rollup's own invariant
// then fails.
//
// THE IDENTITY IS THE JOIN KEY, not the subject. NativeDemandSubject's resolve and infer arms carry
// a NativeLaneUniverseModule, so retaining the subject per transition would pin that module payload
// through the whole observation list for the life of the run -- the settled-versus-resident
// distinction this lane has to establish, violated by the instrument meant to observe it.
type NativeDemandTransition {
  identity: DemandIdentity
  elapsed: ElapsedObservation
}

// THE COST CLASS IS DERIVED FROM THE CONTRACT-OWNED ARTIFACT KIND, never from a rendered stage word.
// The three judgment contracts already issue three distinct kinds; the observation fold projects
// those into the exclusive partition the driver reports, and a kind outside the three is typed
// rather than silently dropped.
type NativeDemandCostClass
  = NativeCostPrepare
  | NativeCostEval
  | NativeCostOccurrenceCensus
  | NativeCostUnclassified

fn native_demand_cost_class(identity: DemandIdentity) -> NativeDemandCostClass {
  if identity.kind == native_module_resolve_artifact_kind {
    NativeCostPrepare
  } else if identity.kind == native_module_infer_artifact_kind {
    NativeCostPrepare
  } else if identity.kind == native_test_identity_artifact_kind {
    NativeCostEval
  } else if identity.kind == native_module_occurrence_census_artifact_kind {
    NativeCostOccurrenceCensus
  } else {
    NativeCostUnclassified
  }
}

// THE ENGINE'S OWN BOOKKEEPING IS MEASURED WHERE IT HAPPENS, which is inside this module and not in
// the driver. `scheduling_nanos` accumulates the spans around the work the SCHEDULER does -- plan
// construction, ready selection, demand-binding lookup, settlement, dependent-readiness update and
// row collection -- and it is disjoint from the demand's own window by construction: that window is
// exactly `started..finished` around native_demand_execute, and nothing here spans across it.
//
// IT IS A SUM OF OBSERVED SPANS AND NEVER A SUBTRACTION. An earlier version of this row was computed
// in the driver as the whole scheduling call minus the engine's attributed prepare and eval -- which
// overlaps those spans and, worse, ABSORBS any other unattributed phase into "scheduling", so the
// partition's remainder could no longer discover a second missing row. A row defined as a residual
// cannot be the thing that proves the residual is small.
type NativeDemandRun {
  engine: DemandEngine<NativeDemandValue>
  transitions: List<NativeDemandTransition>
  rows: List<NativeRouteMemberRow>
  scheduling_nanos: Int
}

fn native_demand_settled_label(state: DemandState<NativeDemandValue>) -> String {
  match state {
    DemandAvailable { value: v } =>
      match v {
        NativeResolveValue { resolution: r } =>
          match r {
            NativeLaneModuleResolved { resolved: _ } => "resolve_available"
            NativeLaneModuleContextRowsDecided { rows: _ } => "resolve_context_refused"
            NativeLaneModuleResolveRowsDecided { rows: _ } => "resolve_refused"
          }
        NativeInferValue { preparation: p } =>
          match p {
            NativeLaneModulePrepared { prepared: _ } => "infer_available"
            NativeLaneModuleRowsDecided { rows: _ } => "infer_refused"
          }
        NativeEvalValue { row: _ } => "eval_available"
        NativeOccurrenceCensusValue { row: _ } => "occurrence_census_available"
      }
    DemandRefused => "refused"
    DemandWaiting => "unsettled"
    DemandReady => "unsettled"
    DemandLeasePending => "unsettled"
    DemandRunning => "unsettled"
    DemandSuspended => "unsettled"
    DemandCommitPending => "unsettled"
    DemandBlocked { cause: _ } => "unsettled"
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// RUNNING ONE DEMAND: THE ENGINE SAYS WHICH, THIS SAYS WHAT
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// A stage reads its prerequisite's value OUT OF THE ENGINE rather than from a local binding, which
// is what makes the dependency real rather than decorative. If infer read a prepared tree that the
// resolve demand had not published, the edge between them would be a comment.
//
// A REFUSED PREREQUISITE PRODUCES NO WORK HERE AND THAT IS THE POINT. The engine has already
// decided such a demand never becomes ready, so this function is never asked about it; the rows
// for those identities come from the refusing stage's own arms, which are the same arms the
// displaced loop pushed from.
fn native_demand_resolved_tree(
  engine: DemandEngine<NativeDemandValue>,
  module: String,
  compiler: DeclaredInput
) -> Optional<NativeLaneModuleResolution> {
  match demand_engine_entry(e: engine, id: native_demand_resolve_identity(module: module, compiler: compiler)) {
    Absent => optional_absent()
    Present { value: entry } =>
      match entry.state {
        DemandAvailable { value: v } =>
          match v {
            NativeResolveValue { resolution: r } => optional_present(value: r)
            _ => optional_absent()
          }
        _ => optional_absent()
      }
  }
}

fn native_demand_prepared(
  engine: DemandEngine<NativeDemandValue>,
  module: String,
  compiler: DeclaredInput
) -> Optional<NativeTestPreparedModule> {
  match demand_engine_entry(e: engine, id: native_demand_infer_identity(module: module, compiler: compiler)) {
    Absent => optional_absent()
    Present { value: entry } =>
      match entry.state {
        DemandAvailable { value: v } =>
          match v {
            NativeInferValue { preparation: p } =>
              match p {
                NativeLaneModulePrepared { prepared: prepared } => optional_present(value: prepared)
                NativeLaneModuleRowsDecided { rows: _ } => optional_absent()
              }
            _ => optional_absent()
          }
        _ => optional_absent()
      }
  }
}

// THE THREE PRODUCERS ARE CALLED HERE EXACTLY AS THE DISPLACED LOOP CALLED THEM. Same functions,
// same arguments, same order. That is what makes "verdicts preserved" a structural claim rather
// than an empirical hope.
// A RESOLVE STEP'S RETURNED CONTEXT IS NOT CARRIED INTO THE NEXT DEMAND: on this route each module is
// resolved exactly once, so its namespace (v2.compiler.name_resolve ResolutionContext namespaces) is
// demanded once and nothing is lost. The run carries it when PR2 of
// docs/plans/declaration-body-resolution-provider.md adds a module's cross-module declaration demands.
fn native_demand_execute(
  run: NativeDemandRun,
  subject: NativeDemandSubject,
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  compiler: DeclaredInput
) -> DemandState<NativeDemandValue> {
  match subject {
    NativeResolveSubject { entry: entry } =>
      DemandAvailable {
        value: NativeResolveValue {
          resolution: native_lane_module_resolution(
            context: context,
            refusal_index: refusal_index,
            entry: entry
          ).resolution
        }
      }
    NativeInferSubject { entry: entry } =>
      match native_demand_resolved_tree(engine: run.engine, module: entry.module, compiler: compiler) {
        Absent => DemandRefused
        Present { value: resolution } =>
          match resolution {
            NativeLaneModuleResolved { resolved: resolved } =>
              DemandAvailable {
                value: NativeInferValue {
                  preparation: native_lane_module_inference(entry: entry, resolved: resolved)
                }
              }
            NativeLaneModuleContextRowsDecided { rows: _ } => DemandRefused
            NativeLaneModuleResolveRowsDecided { rows: _ } => DemandRefused
          }
      }
    NativeOccurrenceCensusSubject { entry: entry } =>
      match native_demand_resolved_tree(engine: run.engine, module: entry.module, compiler: compiler) {
        Absent => DemandRefused
        Present { value: resolution } =>
          match resolution {
            NativeLaneModuleResolved { resolved: resolved } =>
              DemandAvailable {
                value: NativeOccurrenceCensusValue {
                  row: native_lane_occurrence_census_row(entry: entry, resolved: resolved)
                }
              }
            NativeLaneModuleContextRowsDecided { rows: _ } => DemandRefused
            NativeLaneModuleResolveRowsDecided { rows: _ } => DemandRefused
          }
      }
    NativeEvalSubject { module: module, declaration: declaration } =>
      match native_demand_prepared(engine: run.engine, module: module, compiler: compiler) {
        Absent => DemandRefused
        Present { value: prepared } =>
          DemandAvailable {
            value: NativeEvalValue {
              row: native_lane_identity_row(
                prepared: prepared,
                module: module,
                declaration: declaration
              )
            }
          }
      }
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE ONE-SEAT DRAIN
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// Ask the engine for the next admissible demand, run it, settle it, repeat. ONE seat, so this cut
// changes no timing and can change no interleaving -- it moves the authority for WHICH demand runs
// next out of a hand-written loop and into the engine, and nothing else. Multi-seat realization is
// a later cut against this same drain.
//
// THE FUEL IS THE POPULATION, NOT A GUESS. Every admission settles exactly one demand and a settled
// demand is never re-admitted, so the number of admissions is bounded by the number of entries;
// the bound is supplied rather than discovered because the substrate requires it (DESIGN section 4).
// ═══════════════════════════════════════════════════════════════════════════════════════════
// TWO GRAINS, ONE IMPLEMENTATION
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// `native_demand_step` runs exactly one admitted demand and returns the advanced run. The driver
// calls it in a loop so it can open a span around each step -- which is the whole reason the
// step-wise grain exists, since a `.dag` fold cannot read a clock and an opaque whole-population
// call would have dissolved the per-demand rows of the cost partition.
//
// `native_demand_drain` is the same thing without the clock, and it is written IN TERMS OF the
// step rather than beside it. Two spellings of one drain would be the fork DESIGN section 3
// forbids, and it would be the expensive kind: the measured route and the ordinary route could
// then disagree about what ran, which is precisely the question both exist to answer.
//
// NEITHER GRAIN DECIDES ORDER. Both ask the engine for the next admissible demand; the difference
// is only who holds the clock.
// AN ELAPSED READING IS TYPED, AND A BACKWARDS ONE IS NOT ZERO.
//
// An earlier revision clamped `finish < start` to 0. That turns a broken measurement into "this
// demand was free" -- the failure-as-value class the whole observation model exists to remove, and
// the same shape as the "unbound" stage that used to vanish into the residual. If finish precedes
// start then one of four things is false: the two readings share one process-local epoch, the
// runtime is monotone, the pair was correctly matched, or the representation preserved the values.
// None of those is a duration.
//
// So the reading carries its own standing, an invalid one is COUNTED, and the rollup's completeness
// predicate goes false -- which is the same discipline as the unclassified kind, applied to the
// other way an observation can fail. Conversion saturation inside the runtime body is a separate
// rule and stays there: v1.runtime_rust clamps u128 nanoseconds into the substrate Int, which is a
// representational ceiling rather than a reversed pair.
//
// THE READINGS ARE THREAD CPU, NOT WALL (std.realization_measurement ObserveThreadCpuAtSubject). These
// spans are members of the driver's exclusive partition (std.compiler_entry native_driver_cost_account),
// whose law is that the phases partition the driver's OWN work; a wall span also carries every
// interval the host descheduled the thread, which made the verdict a function of host load. The
// monotonicity argument above holds unchanged on the thread CPU clock -- it only advances.
type ElapsedObservation
  = ElapsedObserved { nanos: Int }
  | ElapsedObservationInvalid { start: Int, finish: Int }

fn elapsed_observation(start: Int, finish: Int) -> ElapsedObservation {
  if finish >= start {
    ElapsedObserved { nanos: finish - start }
  } else {
    ElapsedObservationInvalid { start: start, finish: finish }
  }
}

fn elapsed_observed_nanos(e: ElapsedObservation) -> Int {
  match e {
    ElapsedObserved { nanos: n } => n
    ElapsedObservationInvalid { start: _, finish: _ } => 0
  }
}

fn elapsed_is_valid(e: ElapsedObservation) -> Bool {
  match e {
    ElapsedObserved { nanos: _ } => true
    ElapsedObservationInvalid { start: _, finish: _ } => false
  }
}

fn native_demand_step(
  run: NativeDemandRun,
  plan: NativeDemandPlan,
  identity: DemandIdentity,
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  compiler: DeclaredInput
) -> NativeDemandRun {
  let lookup_started = observed_thread_cpu_nanos("native-demand-binding-lookup-start")
  match native_demand_binding(plan: plan, id: identity) {
    Absent => run
    Present { value: subject } =>
      let lookup_finished = observed_thread_cpu_nanos("native-demand-binding-lookup-finish")
      let started = observed_thread_cpu_nanos("native-demand-step-start")
      let settled = native_demand_execute(
        run: run,
        subject: subject,
        context: context,
        refusal_index: refusal_index,
        compiler: compiler
      )
      let finished = observed_thread_cpu_nanos("native-demand-step-finish")
      let elapsed = elapsed_observation(start: started, finish: finished)
      let settle_started = observed_thread_cpu_nanos("native-demand-settle-start")
      let settled_engine = demand_engine_settle(e: run.engine, id: identity, state: settled)
      let collected_rows = native_demand_collect_rows(rows: run.rows, settled: settled)
      let settle_finished = observed_thread_cpu_nanos("native-demand-settle-finish")
      NativeDemandRun {
        engine: settled_engine,
        transitions: list_snoc_item(
          xs: run.transitions,
          item: NativeDemandTransition {
            identity: identity,
            elapsed: elapsed
          }
        ),
        rows: collected_rows,
        scheduling_nanos: run.scheduling_nanos
          + native_demand_bookkeeping_nanos(start: lookup_started, finish: lookup_finished)
          + native_demand_bookkeeping_nanos(start: settle_started, finish: settle_finished)
      }
  }
}

// THE ADMISSION THE DRIVER ASKS FOR. One seat today; the seat count is the caller's, not the
// engine's and not this module's, because capacity is a realization fact and authoring a width
// here would be the control the demand-engine program deletes.
fn native_demand_next(run: NativeDemandRun, seats: Int) -> DemandAdmission {
  demand_engine_next(e: run.engine, offer: DemandLeaseOffer { seats: seats })
}

fn native_demand_drain(
  run: NativeDemandRun,
  plan: NativeDemandPlan,
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  compiler: DeclaredInput,
  fuel: Int
) -> NativeDemandRun {
  if fuel <= 0 {
    run
  } else {
    let select_started = observed_thread_cpu_nanos("native-demand-select-start")
    let admission = native_demand_next(run: run, seats: 1)
    let select_finished = observed_thread_cpu_nanos("native-demand-select-finish")
    let selected = native_demand_run_with_scheduling_nanos(
      run: run,
      nanos: native_demand_bookkeeping_nanos(start: select_started, finish: select_finished)
    )
    match admission {
      DemandNotAdmitted { cause: _ } => selected
      DemandAdmitted { identity: identity } =>
        native_demand_drain(
          run: native_demand_step(
            run: selected,
            plan: plan,
            identity: identity,
            context: context,
            refusal_index: refusal_index,
            compiler: compiler
          ),
          plan: plan,
          context: context,
          refusal_index: refusal_index,
          compiler: compiler,
          fuel: fuel - 1
        )
    }
  }
}

// THE DEMAND'S STAGE, FOR THE COST ROW IT IS CHARGED TO. The driver needs to know which exclusive
// row a step's span belongs to, and that is a property of the demand's subject rather than
// something the driver should re-derive from the key.
fn native_demand_stage_label(plan: NativeDemandPlan, identity: DemandIdentity) -> String {
  match native_demand_binding(plan: plan, id: identity) {
    Absent => "unbound"
    Present { value: subject } =>
      match subject {
        NativeResolveSubject { entry: _ } => "resolve"
        NativeInferSubject { entry: _ } => "infer"
        NativeOccurrenceCensusSubject { entry: _ } => "occurrence_census"
        NativeEvalSubject { module: _, declaration: _ } => "eval"
      }
  }
}

// THE POPULATION IS ASSEMBLED FROM THE SAME ARMS THE LOOP PUSHED FROM. A refusing resolve or infer
// contributes its decided rows -- one per declaration, produced by the refusing stage -- and an
// evaluated identity contributes its own row. Nothing here mints a verdict.
fn native_demand_collect_rows(
  rows: List<NativeRouteMemberRow>,
  settled: DemandState<NativeDemandValue>
) -> List<NativeRouteMemberRow> {
  match settled {
    DemandAvailable { value: v } =>
      match v {
        NativeResolveValue { resolution: r } =>
          match r {
            NativeLaneModuleResolved { resolved: _ } => rows
            NativeLaneModuleContextRowsDecided { rows: decided } => list_append_rows(left: rows, right: decided)
            NativeLaneModuleResolveRowsDecided { rows: decided } => list_append_rows(left: rows, right: decided)
          }
        NativeInferValue { preparation: p } =>
          match p {
            NativeLaneModulePrepared { prepared: _ } => rows
            NativeLaneModuleRowsDecided { rows: decided } => list_append_rows(left: rows, right: decided)
          }
        NativeEvalValue { row: row } => list_snoc_item(xs: rows, item: row)
        NativeOccurrenceCensusValue { row: _ } => rows
      }
    DemandWaiting => rows
    DemandReady => rows
    DemandLeasePending => rows
    DemandRunning => rows
    DemandSuspended => rows
    DemandCommitPending => rows
    DemandRefused => rows
    DemandBlocked { cause: _ } => rows
  }
}

fn list_append_rows(
  left: List<NativeRouteMemberRow>,
  right: List<NativeRouteMemberRow>
) -> List<NativeRouteMemberRow> {
  fold_list(xs: right, empty: left, cons: fn(acc, r) { list_snoc_item(xs: acc, item: r) })
}

// THE ENTRY POINT THE DRIVER CALLS IN PLACE OF ITS MODULE LOOP.
fn native_demand_schedule_universe(
  modules: List<NativeLaneUniverseModule>,
  context: NativeTestContext,
  refusal_index: Map<Symbol, NativeTestFileRefusal>,
  compiler: DeclaredInput
) -> NativeDemandRun {
  let plan_started = observed_thread_cpu_nanos("native-demand-plan-start")
  let plan = native_demand_plan(modules: modules, compiler: compiler)
  let plan_finished = observed_thread_cpu_nanos("native-demand-plan-finish")
  native_demand_drain(
    run: native_demand_run_with_scheduling_nanos(
      run: native_demand_run_empty(plan: plan),
      nanos: native_demand_bookkeeping_nanos(start: plan_started, finish: plan_finished)
    ),
    plan: plan,
    context: context,
    refusal_index: refusal_index,
    compiler: compiler,
    fuel: native_demand_plan_size(plan: plan) + 1
  )
}

// THE DECLARED INPUT THE DRIVER CAN TRUTHFULLY SUPPLY TODAY, AND ITS NAME SAYS WHICH FACT IT IS.
//
// The judgment contracts take a compiler input because two runs of one module under different
// compilers are different judgments -- that is what stops a later cross-run lookup serving the
// earlier compiler's answer. The driver does not hold the emitted compiler's digest: the host
// harness computes it and prints it, and nothing passes it in.
//
// SO IT IS NOT SUPPLIED. What the driver holds is the TESTED TREE (GITHUB_SHA), which is a real
// identity of what is being compiled and is not the same fact -- for a self-hosting compiler the
// two nearly coincide, and `nearly` is exactly the slippage DESIGN section 3 exists to refuse. The
// `ref` field names the fact, so the row says tested_tree and a reader is never told a tree digest
// is a compiler digest.
//
// WITHIN ONE RUN THIS COSTS NOTHING: the input is constant across every demand, so it separates no
// two demands here. It matters at the cross-run cut, and the compiler digest joins it as a SECOND
// declared input there -- a declared frontier (DESIGN section 3c) whose consumer is that cut, not
// a gap being papered over.
fn native_demand_tested_tree_input(tree: String) -> DeclaredInput {
  DeclaredInput {
    ref: "tested_tree" as NonEmptyStr,
    digest: content_hash_atom(value: tree as NonEmptyStr)
  }
}

// The two counts the cost partition reports beside its spans: how many module preparations reached
// a prepared module and how many decided rows instead. Derived from the settled engine rather than
// tallied by the driver, so the driver counts nothing it does not time.
// ═══════════════════════════════════════════════════════════════════════════════════════════
// ONE TYPED ROLLUP, FOLDED ONCE, WITH ITS OWN COMPLETENESS INVARIANT
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// Seven separate scans over the transition list -- resolve time, infer time, eval time, two sample
// populations, two preparation counts -- each re-deciding the same classification from a string.
// One fold decides it once, from the contract-owned artifact kind, and every transition inhabits
// exactly one recognised class.
//
// `classified` IS THE INVARIANT AND NOT A STATISTIC. If it does not equal the transition count then
// some admitted demand reached no cost class, and the honest report is that the OBSERVATION IS
// INCOMPLETE -- not two totals that are quietly smaller than the work performed. The previous shape
// had exactly that hole and nothing could have detected it from the totals alone, because a missing
// contribution and a cheap demand are indistinguishable once the span is gone.
//
// DISSOLUTION TRIGGER: demand-engine M4 provides the per-demand CostAccount projection and the
// native driver consumes that general receipt instead of this native-route rollup. This is a bounded
// bridge to the exclusive partition that exists today, not a second cost authority.
type NativeDemandObservationRollup {
  prepare_nanos: Int
  eval_nanos: Int
  occurrence_census_nanos: Int
  prepare_samples: List<Int>
  eval_samples: List<Int>
  prepare_ok: Int
  prepare_refused: Int
  classified: Int
  unclassified: Int
  invalid_elapsed: Int
}

fn native_demand_rollup_empty() -> NativeDemandObservationRollup {
  NativeDemandObservationRollup {
    prepare_nanos: 0,
    eval_nanos: 0,
    occurrence_census_nanos: 0,
    prepare_samples: [],
    eval_samples: [],
    prepare_ok: 0,
    prepare_refused: 0,
    classified: 0,
    unclassified: 0,
    invalid_elapsed: 0
  }
}

// PREPARATION STANDING IS READ FROM THE ENGINE'S TYPED STATE, not from a settlement word. The run
// already holds the settled DemandState and its NativeDemandValue, so the standing is matched where
// it lives rather than re-derived from a rendering of it.
// PREPARATION IS ONE OUTCOME PER MODULE, DECIDED AT THE INFER DEMAND. A module's preparation concludes
// when its infer demand settles, and there is exactly one infer demand per module (native_demand_plan
// binds one per entry), so counting there is independent of how many declarations the module has.
//
// WHAT THIS CORRECTS, AND IT WAS MINE TWICE OVER. The first version counted every transition whose
// standing read Refused, so a module failing at resolve was counted on the resolve transition AND again
// when its infer demand settled DemandRefused -- prepare_refused reported 2 where the module-level count
// before the engine was 1. My second version fixed the total by excluding the infer settlement instead,
// which is the WRONG HALF to drop: it left the count on a per-transition basis, so it was still not one
// outcome per module, and it reported a resolution failure as something other than a refused
// preparation. The boundary is the infer demand, and the resolve and eval transitions contribute
// nothing.
//
// A RESOLUTION FAILURE IS STILL A REFUSED PREPARATION. The infer demand settles DemandRefused because
// its prerequisite refused; the module's preparation did not succeed, and the old module-level meaning
// of prepare_refused was exactly that. Naming it anything else would have changed what the receipt's
// number means in order to make an arithmetic problem go away.
type NativePreparationStanding
  = PreparationSucceeded
  | PreparationRefused
  | PreparationNotApplicable

fn native_demand_infer_preparation_standing(
  value: NativeDemandValue
) -> NativePreparationStanding {
  match value {
    NativeInferValue { preparation: p } =>
      match p {
        NativeLaneModulePrepared { prepared: _ } => PreparationSucceeded
        NativeLaneModuleRowsDecided { rows: _ } => PreparationRefused
      }
    NativeResolveValue { resolution: _ } => PreparationNotApplicable
    NativeEvalValue { row: _ } => PreparationNotApplicable
    NativeOccurrenceCensusValue { row: _ } => PreparationNotApplicable
  }
}

fn native_demand_preparation_standing(
  run: NativeDemandRun,
  identity: DemandIdentity
) -> NativePreparationStanding {
  if identity.kind == native_module_infer_artifact_kind {
    match demand_engine_entry(e: run.engine, id: identity) {
      Absent => PreparationNotApplicable
      Present { value: entry } =>
        match entry.state {
          DemandRefused => PreparationRefused
          DemandAvailable { value: v } => native_demand_infer_preparation_standing(value: v)
          _ => PreparationNotApplicable
        }
    }
  } else {
    PreparationNotApplicable
  }
}

fn native_demand_rollup_step(
  acc: NativeDemandObservationRollup,
  run: NativeDemandRun,
  t: NativeDemandTransition
) -> NativeDemandObservationRollup {
  let standing = native_demand_preparation_standing(run: run, identity: t.identity)
  let nanos = elapsed_observed_nanos(e: t.elapsed)
  let invalid_delta = if elapsed_is_valid(e: t.elapsed) { 0 } else { 1 }
  let ok_delta = match standing { PreparationSucceeded => 1  _ => 0 }
  let refused_delta = match standing { PreparationRefused => 1  _ => 0 }
  match native_demand_cost_class(identity: t.identity) {
    NativeCostPrepare =>
      NativeDemandObservationRollup {
        prepare_nanos: acc.prepare_nanos + nanos,
        eval_nanos: acc.eval_nanos,
        occurrence_census_nanos: acc.occurrence_census_nanos,
        prepare_samples: list_snoc_item(xs: acc.prepare_samples, item: nanos),
        eval_samples: acc.eval_samples,
        prepare_ok: acc.prepare_ok + ok_delta,
        prepare_refused: acc.prepare_refused + refused_delta,
        classified: acc.classified + 1,
        unclassified: acc.unclassified,
        invalid_elapsed: acc.invalid_elapsed + invalid_delta
      }
    NativeCostEval =>
      NativeDemandObservationRollup {
        prepare_nanos: acc.prepare_nanos,
        eval_nanos: acc.eval_nanos + nanos,
        occurrence_census_nanos: acc.occurrence_census_nanos,
        prepare_samples: acc.prepare_samples,
        eval_samples: list_snoc_item(xs: acc.eval_samples, item: nanos),
        prepare_ok: acc.prepare_ok,
        prepare_refused: acc.prepare_refused,
        classified: acc.classified + 1,
        unclassified: acc.unclassified,
        invalid_elapsed: acc.invalid_elapsed + invalid_delta
      }
    NativeCostOccurrenceCensus =>
      NativeDemandObservationRollup {
        prepare_nanos: acc.prepare_nanos,
        eval_nanos: acc.eval_nanos,
        occurrence_census_nanos: acc.occurrence_census_nanos + nanos,
        prepare_samples: acc.prepare_samples,
        eval_samples: acc.eval_samples,
        prepare_ok: acc.prepare_ok,
        prepare_refused: acc.prepare_refused,
        classified: acc.classified + 1,
        unclassified: acc.unclassified,
        invalid_elapsed: acc.invalid_elapsed + invalid_delta
      }
    NativeCostUnclassified =>
      NativeDemandObservationRollup {
        prepare_nanos: acc.prepare_nanos,
        eval_nanos: acc.eval_nanos,
        occurrence_census_nanos: acc.occurrence_census_nanos,
        prepare_samples: acc.prepare_samples,
        eval_samples: acc.eval_samples,
        prepare_ok: acc.prepare_ok,
        prepare_refused: acc.prepare_refused,
        classified: acc.classified,
        unclassified: acc.unclassified + 1,
        invalid_elapsed: acc.invalid_elapsed + invalid_delta
      }
  }
}

fn native_demand_observation_rollup(run: NativeDemandRun) -> NativeDemandObservationRollup {
  fold_list(
    xs: run.transitions,
    empty: native_demand_rollup_empty(),
    cons: fn(acc, t) { native_demand_rollup_step(acc: acc, run: run, t: t) }
  )
}

// THE OBSERVATION IS COMPLETE WHEN EVERY ADMITTED TRANSITION REACHED A COST CLASS. A reader that
// took the totals without asking this could not tell a demand that cost little from one that was
// never attributed.
fn native_demand_observation_complete(run: NativeDemandRun) -> Bool {
  let r = native_demand_observation_rollup(run: run)
  (r.unclassified == 0)
    && (r.invalid_elapsed == 0)
    && (r.classified == length(xs: run.transitions))
}


// A CLOCK THAT NEVER ADVANCES PASSES EVERY CHECK ABOVE, WHICH IS WHY PROGRESS IS ITS OWN FACT.
// elapsed_observation admits finish == start as ElapsedObserved { nanos: 0 }, so a realization whose
// body returns a constant zero yields a run in which every transition is CLASSIFIED and VALIDLY
// OBSERVED: unclassified is 0, invalid_elapsed is 0, classified equals the transition count, and
// native_demand_observation_complete answers true over totals that are all zero. The emitted-body
// membership check has the same blind spot by construction -- it establishes that a bridge HAS a
// body, never that the body measures anything -- so neither predicate discriminates a dead clock.
//
// PROGRESS IS ASKED AT THE RUN AND NOT PER TRANSITION, deliberately. One fast transition may
// legitimately observe a zero span on a coarse clock, so a per-transition rule would refuse honest
// work; a whole run that executed transitions and accumulated no span at all is a clock that is not
// running. A run with no transitions has no span to observe and is vacuously progressed, which keeps
// the predicate from reporting a defect when there was simply nothing to do.
//
// THIS IS DELIBERATELY NOT FOLDED INTO native_demand_observation_complete. Completeness answers
// whether every admitted transition reached a cost class; progress answers whether the realization
// underneath produced a measurement. Fusing them would make one counter answer two questions, and
// would silently change what every existing consumer of `complete` is asserting.
fn native_demand_observation_progressed(run: NativeDemandRun) -> Bool {
  if length(xs: run.transitions) == 0 {
    true
  } else {
    let r = native_demand_observation_rollup(run: run)
    (r.prepare_nanos + r.eval_nanos) > 0
  }
}

fn native_demand_prepare_nanos(run: NativeDemandRun) -> Int {
  native_demand_observation_rollup(run: run).prepare_nanos
}

fn native_demand_occurrence_census_nanos(run: NativeDemandRun) -> Int {
  native_demand_observation_rollup(run: run).occurrence_census_nanos
}

// THE CENSUS ROWS ARE READ FROM THE RUN'S OWN SETTLED CENSUS DEMANDS, one per transition whose
// identity is a census judgment. A module whose resolve refused settles its census demand
// DemandRefused and contributes no row, so it is counted UNOBSERVED by native_lane_occurrence_census,
// never as zero collisions. Observation only: nothing here is read back by resolve, infer or admission.
fn native_demand_occurrence_census_rows(run: NativeDemandRun) -> List<NativeLaneOccurrenceCensusRow> {
  fold_list(xs: run.transitions, empty: [], cons: fn(acc, t) {
    if t.identity.kind == native_module_occurrence_census_artifact_kind {
      match demand_engine_entry(e: run.engine, id: t.identity) {
        Present { value: entry } =>
          match entry.state {
            DemandAvailable { value: v } =>
              match v {
                NativeOccurrenceCensusValue { row: row } => list_snoc_item(xs: acc, item: row)
                _ => acc
              }
            _ => acc
          }
        Absent => acc
      }
    } else {
      acc
    }
  })
}

fn native_demand_occurrence_census_lines(run: NativeDemandRun, universe: Int) -> List<String> {
  native_lane_occurrence_census_lines(
    c: native_lane_occurrence_census(universe: universe, rows: native_demand_occurrence_census_rows(run: run))
  )
}

fn native_demand_eval_nanos(run: NativeDemandRun) -> Int {
  native_demand_observation_rollup(run: run).eval_nanos
}

fn native_demand_prepare_samples(run: NativeDemandRun) -> List<Int> {
  native_demand_observation_rollup(run: run).prepare_samples
}

fn native_demand_eval_samples(run: NativeDemandRun) -> List<Int> {
  native_demand_observation_rollup(run: run).eval_samples
}

fn native_demand_prepare_ok(run: NativeDemandRun) -> Int {
  native_demand_observation_rollup(run: run).prepare_ok
}

fn native_demand_prepare_refused(run: NativeDemandRun) -> Int {
  native_demand_observation_rollup(run: run).prepare_refused
}

// THE SCHEDULER'S MEASURED COST, for the driver's exclusive row. It is the accumulated sum the engine
// took as it worked, so the driver reports a reading rather than deriving one.
fn native_demand_scheduling_nanos(run: NativeDemandRun) -> Int {
  run.scheduling_nanos
}

fn native_demand_unclassified_transitions(run: NativeDemandRun) -> Int {
  native_demand_observation_rollup(run: run).unclassified
}

fn native_demand_run_empty(plan: NativeDemandPlan) -> NativeDemandRun {
  NativeDemandRun { engine: plan.engine, transitions: [], rows: [], scheduling_nanos: 0 }
}

fn native_demand_run_with_scheduling_nanos(run: NativeDemandRun, nanos: Int) -> NativeDemandRun {
  NativeDemandRun {
    engine: run.engine,
    transitions: run.transitions,
    rows: run.rows,
    scheduling_nanos: run.scheduling_nanos + nanos
  }
}

// THE SPAN OF ONE BOOKKEEPING STRETCH, through the same seam the demand's own window uses. A negative
// or unreadable observation contributes nothing rather than a fabricated figure: elapsed_observed_nanos
// answers 0 for an invalid observation, and invalid_elapsed already counts those separately, so the
// scheduling total stays a sum of readings that were actually taken.
fn native_demand_bookkeeping_nanos(start: Int, finish: Int) -> Int {
  elapsed_observed_nanos(e: elapsed_observation(start: start, finish: finish))
}

fn native_demand_plan_size(plan: NativeDemandPlan) -> Int {
  length(xs: plan.bindings)
}

// THE DERIVATION COUNT, PROJECTED. The driver reports it beside the schedule line, and it reads
// it through here rather than reaching into the engine inside the run: a caller that walked two
// records deep would be coupled to the engine's shape, and the engine's shape is not the driver's
// business.
// The planned population, read from the run so the driver needs no second handle on the plan. It
// counts `entry_order` and not `entries`: the engine's store is keyed by identity now, and the ORDER
// is the population's enumeration. Counting the keyed store typechecked in .dag -- FreeMonoid is loose
// enough interpreted -- and emitted Rust that could not compile, which is the one route that catches
// it (v1.compiler.emit_rust; the rostered class is accepted_source_emits_uncompilable_target).
fn native_demand_run_demand_count(run: NativeDemandRun) -> Int {
  length(xs: run.engine.entry_order)
}

fn native_demand_run_readiness_derivations(run: NativeDemandRun) -> Int {
  run.engine.readiness_computations
}

fn native_demand_run_rows(run: NativeDemandRun) -> List<NativeRouteMemberRow> {
  run.rows
}

fn native_demand_run_transition_count(run: NativeDemandRun) -> Int {
  length(xs: run.transitions)
}

// RENDERING IS THE ONE DIRECTION A STRING IS ADMISSIBLE IN. Every word below is produced FROM typed
// state at the moment of presentation; nothing reads one back to decide a cost class, a preparation
// standing or a count. The settled label is derived here rather than stored on the transition, so a
// renaming of any label cannot move a total.
fn native_demand_cost_class_label(c: NativeDemandCostClass) -> String {
  match c {
    NativeCostPrepare => "prepare"
    NativeCostEval => "eval"
    NativeCostOccurrenceCensus => "occurrence_census"
    NativeCostUnclassified => "UNCLASSIFIED"
  }
}

// AN INVALID READING RENDERS AS INVALID, not as a number. Printing 0 for a reversed pair would put
// a plausible duration in the receipt for a measurement that did not happen -- the same
// failure-as-value the typed observation exists to prevent, reintroduced at the presentation layer
// where a reader would have no way to tell.
fn elapsed_label(e: ElapsedObservation) -> String {
  match e {
    ElapsedObserved { nanos: n } => to_string(n)
    ElapsedObservationInvalid { start: st, finish: fi } =>
      concat(concat("INVALID(start=", to_string(st)), concat(" finish=", concat(to_string(fi), ")")))
  }
}

fn native_demand_transition_line(run: NativeDemandRun, t: NativeDemandTransition) -> String {
  let settled = match demand_engine_entry(e: run.engine, id: t.identity) {
    Absent => "absent"
    Present { value: entry } => native_demand_settled_label(state: entry.state)
  }
  concat(
    concat(concat(demand_identity_key(id: t.identity), " "), settled),
    concat(
      concat(" ", native_demand_cost_class_label(c: native_demand_cost_class(identity: t.identity))),
      concat(" ", elapsed_label(e: t.elapsed))
    )
  )
}

fn native_demand_run_receipt_lines(run: NativeDemandRun) -> List<String> {
  list_map(xs: run.transitions, f: fn(t) { native_demand_transition_line(run: run, t: t) })
}
