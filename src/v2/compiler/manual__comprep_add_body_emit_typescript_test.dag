data comprep_ts_body_emit_pass: Symbol = comprep_ts_body_emit_pass
data comprep_ts_body_emit_fail: Symbol = comprep_ts_body_emit_fail
data comprep_ts_body_grounding_miss: Symbol = comprep_ts_body_grounding_miss

data comprep_ts_emit_operand_swap_source_text: String = "function add(x: number, y: number): number { return y + x; }"

data comprep_ts_emit_catalog_minus_source_text: String = "function add(x: number, y: number): number { return x - y; }"

// §4.5 discriminating-red perturb fixtures — local to comprep; extdeps carries only fidelity rows.
fn comprep_ts_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn comprep_ts_add_operator_row_minus() -> Node {
  target_operator_realization_node(
    operation: canonical_operation_op_add(),
    shape: InfixToken { token: ^ts_token_minus }
  )
}

fn comprep_ts_operator_catalog_minus() -> Node {
  target_operator_realizations_catalog_node(rows: [comprep_ts_add_operator_row_minus()])
}

fn comprep_ts_operator_catalog_empty() -> Node {
  target_operator_realizations_catalog_node(rows: [])
}

fn comprep_ts_target_model_bundle(operator_catalog: Node) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      comprep_ts_named_edge(
        name: target_model_edge_selection_policy,
        target: ts_mvp1_selection_policy_node()
      ),
      comprep_ts_named_edge(
        name: target_model_edge_declared_inhabitants,
        target: ts_mvp1_declared_inhabitants_root()
      ),
      comprep_ts_named_edge(
        name: target_model_edge_translation_rules,
        target: ts_mvp1_translation_rules_node()
      ),
      comprep_ts_named_edge(
        name: target_model_edge_serialize_source,
        target: ts_mvp1_serialize_source_node()
      ),
      comprep_ts_named_edge(
        name: target_model_edge_value_expression_projection,
        target: value_expr_projection_bundle_node(
          projection: ts_value_expression_projection()
        )
      ),
      comprep_ts_named_edge(
        name: target_model_edge_operator_realizations,
        target: operator_catalog
      )
    ]
  )
}

// §4.5 perturb fixture — wave1 lex plus minus rule only (extdeps wave1 omits `-` by design).
fn comprep_ts_mvp1_lex_with_minus() -> LexRules {
  let base = ts_wave1_lex_rules()
  ModeledLexRules {
    root: LexRuleSet {
      rules: list_append(
        left: base.rules,
        right: Cons {
          head: ts_lex_rule(token_class: ^ts_token_minus, text: " - "),
          tail: Empty
        }
      )
    }
  }
}

fn comprep_ts_target_model_minus_catalog() -> TargetModel {
  TargetModel {
    bundle: comprep_ts_target_model_bundle(operator_catalog: comprep_ts_operator_catalog_minus()),
    lex: comprep_ts_mvp1_lex_with_minus(),
    binding_spellings: ts_mvp1_binding_spellings(),
    authority_source_text: ts_mvp1_source_text_authority()
  }
}

fn comprep_ts_target_model_missing_operator_catalog() -> TargetModel {
  TargetModel {
    bundle: comprep_ts_target_model_bundle(operator_catalog: comprep_ts_operator_catalog_empty()),
    lex: ts_wave1_lex(),
    binding_spellings: ts_mvp1_binding_spellings(),
    authority_source_text: ts_mvp1_source_text_authority()
  }
}

fn comprep_ts_canonical_grounding(node: Node, algebra: Node) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

data comprep_ts_number_inhabitant: Node = ts_inhabitant_number_node()
data comprep_ts_number_facts_node: Node = ts_number_facts_node(facts: ts_facts_number)
data comprep_ts_arithmetic_semantics_node: Node = ts_number_arithmetic_semantics_node()
data comprep_ts_bitwise_semantics_node: Node = ts_number_bitwise_semantics_node()

fn comprep_ts_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == dag_mvp1_add_arrow_with_body_fixture {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_mvp1_add_arrow_signature_fixture {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_mvp1_add_binary_body_fixture {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_mvp1_add_arrow_with_body_swapped_operands_fixture {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == dag_mvp1_add_binary_body_swapped_operands_fixture {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == comprep_ts_number_inhabitant {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_inhabitant_number) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_inhabitant
      )
    }
  } else if node == comprep_ts_number_facts_node {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_surface_spelling_number) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == comprep_ts_arithmetic_semantics_node {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_number_ieee754_binary64) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_arithmetic_semantics_node
      )
    }
  } else if node == comprep_ts_bitwise_semantics_node {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_number_bitwise_int32_uint32) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_bitwise_semantics_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_bits64) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_ieee754_binary64) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: std_projection_additive_numeric) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^dag_token_plus) {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_param_x) {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_param_y) {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_type_int) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_inhabitant
      )
    }
  } else {
    match node.kind {
      TypeNode { connective: Atom { identity: id } } =>
        if id == ^dag_binding_type_int {
          Holds {
            value: comprep_ts_canonical_grounding(
              node: node,
              algebra: comprep_ts_number_inhabitant
            )
          }
        } else if id == ^dag_token_plus {
          Holds {
            value: comprep_ts_canonical_grounding(node: node, algebra: node)
          }
        } else if id == ^dag_binding_param_x {
          Holds {
            value: comprep_ts_canonical_grounding(node: node, algebra: node)
          }
        } else if id == ^dag_binding_param_y {
          Holds {
            value: comprep_ts_canonical_grounding(node: node, algebra: node)
          }
        } else {
          Violates {
            diagnostic: Diagnostic {
              reason: comprep_ts_body_grounding_miss,
              at: node_locus(node: node),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          }
        }
      _ =>
        Violates {
          diagnostic: Diagnostic {
            reason: comprep_ts_body_grounding_miss,
            at: node_locus(node: node),
            correction: Unavailable { reason: ExternalContractUnknown }
          }
        }
    }
  }
}

fn comprep_ts_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match comprep_ts_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn comprep_ts_facts_lookup(key: Node) -> Witness<InferredFacts> {
  comprep_ts_inferred_facts_for(node: key)
}

fn comprep_ts_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: comprep_ts_facts_lookup }
  }
}

fn comprep_ts_producer_inferred_tree() -> Outcome<InferredTree> {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: comprep_ts_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn comprep_ts_producer_swapped_inferred_tree() -> Outcome<InferredTree> {
  match produce_mvp1_add_arrow_with_body_swapped_operands() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: comprep_ts_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn comprep_ts_emit_from_producer_tree(target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: comprep_ts_producer_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn comprep_ts_emit_from_producer_swapped_tree(target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: comprep_ts_producer_swapped_inferred_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

// E-10 emit-only green: producer-rooted bodied arrow renders the fidelity TS source string.
// Not an execution consumer — no Node/tsc run; wrong emitted spelling fails this witness.
test fn comprep_ts_bodied_emit_add_fn_accepts_holds() -> Bool {
  match comprep_ts_emit_from_producer_tree(target: ts_mvp1_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source == ts_mvp1_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn comprep_ts_bodied_emit_operand_swap_discriminates() -> Bool {
  match comprep_ts_emit_from_producer_swapped_tree(target: ts_mvp1_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source == comprep_ts_emit_operand_swap_source_text) &&
      (source != ts_mvp1_source_text) &&
      (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn comprep_ts_bodied_emit_catalog_minus_discriminates() -> Bool {
  match comprep_ts_emit_from_producer_tree(target: comprep_ts_target_model_minus_catalog()) {
    Accepted { value: source, diagnostics: d } =>
      (source == comprep_ts_emit_catalog_minus_source_text) &&
      (source != ts_mvp1_source_text) &&
      (d == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn comprep_ts_bodied_emit_missing_catalog_rejects() -> Bool {
  match comprep_ts_emit_from_producer_tree(
    target: comprep_ts_target_model_missing_operator_catalog()
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
