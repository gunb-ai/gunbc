module v2.compiler.target_carriers


fn source_medium(text: String, fidelity: extdeps.communication.medium.DecodeFidelity) -> extdeps.communication.medium.Medium<String> {
  extdeps.communication.medium.Medium { carried: text, fidelity: fidelity }
}

fn lossless_source(text: String) -> extdeps.communication.medium.Medium<String> {
  source_medium(text: text, fidelity: extdeps.communication.medium.Lossless)
}

fn fidelity_disposition_node_has_named_kind(root: v2.std.node.Node, name: v2.std.node.Symbol) -> Bool {
  match v2.std.node_query.find_named_child(root: root, name: name) {
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

fn fidelity_disposition_node_decode_fidelity(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.DecodeFidelity> {
  match node.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      if id == ^dag_fidelity_disposition_kind_modeled {
        v2.std.diagnostic.outcome_accepted(extdeps.communication.medium.Lossless)
      } else {
        v2.std.diagnostic.outcome_rejected(
          v2.std.diagnostic.Diagnostic {
            reason: ^target_carriers_fidelity_disposition_malformed,
            at: v2.std.diagnostic.node_locus(node: node),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        )
      }
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      if fidelity_disposition_node_has_named_kind(
        root: node,
        name: ^dag_fidelity_disposition_kind_declared_normalized
      ) || fidelity_disposition_node_has_named_kind(
        root: node,
        name: ^dag_fidelity_disposition_kind_fail_closed
      ) {
        v2.std.diagnostic.outcome_accepted(extdeps.communication.medium.Lossy)
      } else {
        v2.std.diagnostic.outcome_rejected(
          v2.std.diagnostic.Diagnostic {
            reason: ^target_carriers_fidelity_disposition_malformed,
            at: v2.std.diagnostic.node_locus(node: node),
            correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
          }
        )
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^target_carriers_fidelity_disposition_malformed,
          at: v2.std.diagnostic.node_locus(node: node),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}

fn fidelity_quotient_decode_fidelity(quotient: v2.std.node.Node) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.DecodeFidelity> {
  match quotient.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
      fold(
        quotient.children,
        init: v2.std.diagnostic.Accepted { value: extdeps.communication.medium.Lossless, diagnostics: None },
        f: fn(acc, edge) {
          match acc {
            v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
            v2.std.diagnostic.Accepted { value: current_fidelity, diagnostics: ad } =>
              v2.std.diagnostic.bind_outcome(
                o: fidelity_disposition_node_decode_fidelity(node: edge.target),
                f: fn(next_fidelity) {
                  v2.std.diagnostic.Accepted {
                    value: extdeps.communication.fidelity_carriers.decode_fidelity_merge(
                      left: current_fidelity,
                      right: next_fidelity
                    ),
                    diagnostics: ad
                  }
                }
              )
          }
        }
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^target_carriers_fidelity_quotient_malformed,
          at: v2.std.diagnostic.node_locus(node: quotient),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}

fn target_fidelity_quotient_optional(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match v2.std.node_query.find_named_child(
    root: target.bundle,
    name: ^target_model_edge_fidelity_quotient
  ) {
    v2.std.diagnostic.Accepted { value: child, diagnostics: _ } =>
      v2.std.diagnostic.outcome_accepted(v2.std.optional.Present { value: child })
    v2.std.diagnostic.Rejected { diagnostics: _ } =>
      v2.std.diagnostic.outcome_accepted(v2.std.optional.Absent)
  }
}

fn decode_fidelity_from_target(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.DecodeFidelity> {
  v2.std.diagnostic.bind_outcome(
    o: target_fidelity_quotient_optional(target: target),
    f: fn(opt) {
      match opt {
        v2.std.optional.Absent => v2.std.diagnostic.outcome_accepted(extdeps.communication.medium.Lossless)
        v2.std.optional.Present { value: quotient } =>
          fidelity_quotient_decode_fidelity(quotient: quotient)
      }
    }
  )
}

fn target_source_medium(text: String, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: decode_fidelity_from_target(target: target),
    f: fn(fidelity) {
      v2.std.diagnostic.outcome_accepted(source_medium(text: text, fidelity: fidelity))
    }
  )
}
