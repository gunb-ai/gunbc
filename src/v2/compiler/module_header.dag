module v2.compiler.module_header

import std.types { List }
import v2.compiler.parse { PreparedGrammar, PreparedModeled, PreparedVoidGrammar, parse_production_prepared }
import v2.compiler.tokenize { PreparedLexRules, tokenize_prepared }
import v2.extdeps.languages.dag { qualified_name_from_parsed_module_root }
import v2.std.compilers.lexing { Token }
import v2.std.algebra { HeadAbsent, HeadFound, is_empty, list_head, skip }
import v2.std.diagnostic { Accepted, Rejected, diagnostics_fatal_reason }
import v2.std.node { symbol_intern_lexeme, symbol_lexeme }
import v2.std.qualified_name { qualified_name_to_dotted_string }
import v2.std.text { String }

// THE ONE READING OF A SOURCE FILE'S DECLARED MODULE: the real lexer and the grammar's module_header
// production over the file's first line that holds a token. A file's header is the first thing it
// says, so the lines are tokenized in order while the lexer yields no token (blank lines, `//`
// annotations) and the first line that yields one is what the production must consume whole.
// Nothing here recognises a keyword, a name or a delimiter: what is a header, what is trivia and
// what is a name are the lexer's and the grammar's, so a header spelled with tabs, CRLF or a
// trailing annotation reads as it parses, and a later string or comment that mentions `module` is
// never reached.
//
// Each line is tokenized alone, so the read is linear in the lines before the header. That is the
// same read as tokenizing the prefix of the file up to that line, because a line that yields no
// token is trivia and the dag lexer's trivia (whitespace and `//` annotations,
// v2.extdeps.languages.dag dag_lex_rules) opens no construct that outlives its line: the lexer
// stands where it began, so appending the line to what came before would only repeat its work.
//
// The unit is a line because the production refuses a trailing remainder
// (v2.compiler.parse parse_production_unrefused), so it cannot be handed a file's tokens and asked
// to stop after the header. A header that shares its line with another declaration, or is split
// across lines, therefore refuses with the parse's own cause rather than reading as a name.
//
// The reader holds the prepared lexer and grammar once per run, exactly as the acquisition and the
// population jobs hold them: preparing them per file would be the per-file cost the carriers exist
// to remove.
type ModuleHeaderReader {
  lex: PreparedLexRules
  grammar: PreparedGrammar
}

type ModuleHeaderRead
  = ModuleHeaderDeclared { module: String }
  | ModuleHeaderAbsent
  | ModuleHeaderRefused { cause: String }

fn module_header_tokens_read(reader: ModuleHeaderReader, tokens: List<Token>) -> ModuleHeaderRead {
  match reader.grammar {
    PreparedVoidGrammar => ModuleHeaderRefused { cause: "the prepared grammar is void, so no module header can be parsed" }
    PreparedModeled { modeled: modeled } =>
      match parse_production_prepared(
        tokens: tokens,
        validated: modeled.validated,
        analysis: modeled.analysis,
        production_name: ^dag_production_module_header
      ) {
        Rejected { diagnostics: d } => ModuleHeaderRefused { cause: symbol_lexeme(sym: diagnostics_fatal_reason(d: d)) }
        Accepted { value: artifact, diagnostics: _ } =>
          match qualified_name_from_parsed_module_root(root: artifact.tree) {
            Rejected { diagnostics: d } => ModuleHeaderRefused { cause: symbol_lexeme(sym: diagnostics_fatal_reason(d: d)) }
            Accepted { value: name, diagnostics: _ } => ModuleHeaderDeclared { module: qualified_name_to_dotted_string(qn: name) }
          }
      }
  }
}

fn module_header_read_from(reader: ModuleHeaderReader, file: String, remaining: List<String>) -> ModuleHeaderRead {
  match list_head(xs: remaining) {
    HeadAbsent => ModuleHeaderAbsent
    HeadFound { value: line } =>
      match tokenize_prepared(text: concat(line, "\n"), file: symbol_intern_lexeme(lexeme: file), prepared: reader.lex) {
        Rejected { diagnostics: d } => ModuleHeaderRefused { cause: symbol_lexeme(sym: diagnostics_fatal_reason(d: d)) }
        Accepted { value: stream, diagnostics: _ } =>
          if is_empty(xs: stream.all) {
            module_header_read_from(reader: reader, file: file, remaining: skip(xs: remaining, n: 1))
          } else {
            module_header_tokens_read(reader: reader, tokens: stream.all)
          }
      }
  }
}

// The module a source file declares. `file` names the file in the diagnostics a refusal carries.
fn module_header_read(reader: ModuleHeaderReader, file: String, content: String) -> ModuleHeaderRead {
  module_header_read_from(reader: reader, file: file, remaining: split(s: content, delimiter: "\n"))
}
