module v2.compiler.decl_ref_disposition_roster

// THE DISPOSITION ROSTER of the decl-ref census: every reference or backtick span the census cannot
// resolve and that is not a refusal this PR repaired. A row is an exact identity ("module decl" for a
// DeclarationRef, the span text for prose), never a pattern. The census refuses a row that no longer
// matches an unresolved citation, so the roster only shrinks (a monotone debt contract over the
// census's own independently discovered population, DESIGN section 5).
//   DeliberateAbsentFixture -- a RED fixture that cites a name that must not resolve.
//   UpstreamFieldUnmodeled  -- an external-spec field the local model does not carry yet (a scaffold bind).
//   StaleCitationDebt       -- a citation the census found unresolved and nobody has repaired; the
//                              repair is to point it at the real symbol or delete the claim.
import std.types { List }
import v2.std.text { String }

type DeclRefDispositionReason
  = DeliberateAbsentFixture
  | UpstreamFieldUnmodeled
  | StaleCitationDebt

type DeclRefDisposition {
  subject: String
  reason: DeclRefDispositionReason
}

data decl_ref_disposition_roster: List<DeclRefDisposition> = [
  DeclRefDisposition { subject: "extdeps.git.publication_transport PublicationTransport", reason: StaleCitationDebt },
