module v2.compiler.decl_ref_disposition_roster

// THE DISPOSITION ROSTER of the decl-ref census: every DeclarationRef or backtick span the census
// finds unresolved and that is not repaired. A row's subject is typed: a CitedDeclaration
// carries the DeclarationRef (module, declaration and field, so a NamedField is never widened to its
// whole declaration), a CitedSpan the span text; never a pattern. The row and carries the specific reason it is
// kept. The census refuses a row that no longer matches an unresolved citation, so the roster only
// shrinks (a monotone debt contract over the census's own independently discovered population,
// DESIGN section 5). There is no blanket stale-citation reason: a stale reference is repaired or
// deleted, and a row remains only where the repair needs a judgment the author of this roster cannot
// make, stated by its reason (the arm's meaning below; a reason is the same for every row of its arm, so a per-row note would repeat it).
//   DeliberateAbsentFixture      -- a RED/control fixture that cites a name that must not resolve.
//   UpstreamFieldUnmodeled       -- an external-spec field the local model does not carry yet.
//   DeliberatelyAbsentCapability -- a stamp bound to the name of a capability not yet authored.
//   BindTargetDeleted            -- a scaffold row whose bind target was deleted with no named successor; re-pointing or retiring it is an operator verdict on the debt (DESIGN 5).
//   HostBuiltinSeam              -- a bind into the v1 seed's builtin registry, outside the v2 index.
//   DataRowFieldNotResolvable    -- a NamedField citation into a `data` row's literal value; v2.std.decl_ref_resolution
//                                   decl_ref_named_field_present reads only the labelled children of a type declaration, so a
//                                   correct field of a data row reads as FieldAbsent. The citation stays NamedField (never widened
//                                   to WholeDeclaration). dissolve-on: the resolver reads the fields of a data row's literal.
//   ProductLabelTypedAsDeclarationRef -- a MEANING FORK (DESIGN 3): an ExternalSubjectRef carries the upstream product's own label
//                                   ("github.CodeSearch") in a DeclarationRef, whose meaning is a declaration of a module. The
//                                   retype is a follow-up; the row is held at identity grain until then. dissolve-on:
//                                   ExternalSubjectRef names its subject by a type that is not a DeclarationRef (model first).
//   IllustrativeName             -- a placeholder in explanatory prose (an example witness or module name), never declared.
//   NameUnrecoveredFromHistory   -- a witness-module name in a receipt that no path search of history recovers (renamed
//                                   or never a file of that name). dissolve-on: each owning receipt cites the successor symbol or a commit.
//   HistoricalReceipt { commit } -- prose in a receipt naming a symbol that existed at that commit and
//                                   has since been renamed or deleted; the receipt is a record, not a live citation.
//   DeclNameIsAParameter         -- a construction whose module_path is a literal and whose decl_name is a parameter: the
//                                   module is named, the declaration is chosen at run time. The subject is the site: the file holding the construction and the module its literal names.
//                                   dissolve-on: substrate construction refuses unresolvable DeclarationRef literals (computed names then
//                                   resolve at the call that supplies them).
import std.types { List, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField }
import v2.std.text { String }

type DeclRefDispositionReason
  = DeliberateAbsentFixture
  | UpstreamFieldUnmodeled
  | DeliberatelyAbsentCapability
  | BindTargetDeleted
  | HostBuiltinSeam
  | DataRowFieldNotResolvable
  | ProductLabelTypedAsDeclarationRef
  | IllustrativeName
  | NameUnrecoveredFromHistory
  | HistoricalReceipt { commit: String }
  | DeclNameIsAParameter

type DeclRefSubject
  = CitedDeclaration { reference: DeclarationRef }
  | CitedSpan { text: String }
  | ComputedDeclName { file: String, module_path: String }

type DeclRefDisposition {
  subject: DeclRefSubject
  reason: DeclRefDispositionReason
}

data decl_ref_disposition_roster: List<DeclRefDisposition> = [
