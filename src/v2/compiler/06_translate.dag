fn translate_serialize_recursion_limit_exhausted_diagnostic(emitted: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_serialize_recursion_limit_exhausted,
    at: v2.std.diagnostic.node_locus(node: emitted),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
