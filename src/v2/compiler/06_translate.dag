fn grammar_relation_row_emitted(row: Node) -> Outcome<Node> {
  conj_named_child(parent: row, edge_name: ^grammar_relation_field_emitted)
}
fn grammar_relation_row_tokens_root(row: Node) -> Outcome<Node> {
  conj_named_child(parent: row, edge_name: ^grammar_relation_field_tokens)
}
fn grammar_relation_row_for_emitted(rules: Node, emitted: Node) -> Outcome<Node> {
  match grammar_relation_row_reverse_parse_selection(rules: rules, emitted: emitted) {
    Accepted { value: row, diagnostics: d } =>
      Accepted { value: row, diagnostics: d }
    Rejected { diagnostics: r } =>
      if r.head.reason == ^grammar_relation_row_backward_selection_ambiguous {
        Rejected { diagnostics: r }
      } else {
        outcome_rejected(translate_grammar_relation_row_not_found_diagnostic(emitted: emitted))
      }
  }
}

fn grammar_relation_row_with_bodied_scaffold(rules: Node) -> Outcome<Node> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      match fold(
        rules.children,
        init: Rejected {
          diagnostics: diagnostics_singleton(
            d: translate_grammar_relation_row_not_found_diagnostic(
              emitted: rules
            )
          )
        },
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } =>
              match e.label {
                Named { name: _ } =>
                  match find_named_child(
                    root: e.target,
                    name: ^grammar_relation_field_bodied_scaffold
                  ) {
                    Accepted { value: _, diagnostics: _ } =>
                      outcome_rejected(
                        translate_grammar_inverse_not_realized_diagnostic(emitted: rules)
                      )
                    Rejected { diagnostics: _ } => acc
                  }
                Positional => acc
              }
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: _ } =>
                  match find_named_child(
                    root: e.target,
                    name: ^grammar_relation_field_bodied_scaffold
                  ) {
                    Accepted { value: _, diagnostics: d } =>
                      Accepted { value: e.target, diagnostics: d }
                    Rejected { diagnostics: _ } => acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        Accepted { value: row, diagnostics: d } =>
          Accepted { value: row, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: rules))
  }
}

fn grammar_relation_row_for_bodied_arrow_serialize(
  rules: Node,
  emitted: Node
) -> Outcome<TargetBodiedArrowStatementScaffold> {
  bind_outcome(
    o: grammar_relation_row_with_bodied_scaffold(rules: rules),
    f: fn(row) {
      bodied_arrow_scaffold_from_grammar_relation_row(row: row)
    }
  )
}

fn grammar_inverse_bodied_arrow_validated(
  target: TargetModel,
  emitted: Node
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: grammar_relation_row_for_bodied_arrow_serialize(rules: rules, emitted: emitted),
        f: fn(_) {
          outcome_accepted(emitted)
        }
      )
    }
  )
}

fn translate_bodied_arrow_preserve_producer_ir(arrow: Node) -> Outcome<Node> {
  outcome_accepted(arrow)
}
fn conj_positional_targets(parent: Node) -> Outcome<List<Node>> {
  match parent.kind {
    TypeNode { connective: Conj } =>
      Accepted {
        value: node_positional_child_targets(node: parent),
        diagnostics: None
      }
    _ =>
      outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: parent)
      )
  }
}
fn optional_named_child_ignoring_positional(parent: Node, edge_name: Symbol) -> Outcome<Node?> {

  match parent.kind {
    TypeNode { connective: Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          match acc {
            BundleChildInvalidEdge => acc
            BundleChildDuplicate => acc
            BundleChildMissing =>
              match e.label {
                Named { name: n } =>
                  if n == edge_name {
                    BundleChildFound { value: e.target }
                  } else {
                    acc
                  }
                Positional => acc
              }
            BundleChildFound { value: _ } =>
              match e.label {
                Named { name: n } =>
                  if n == edge_name {
                    BundleChildDuplicate
                  } else {
                    acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: Present { value: child }, diagnostics: None }
        BundleChildMissing =>
          Accepted { value: Absent, diagnostics: None }
        BundleChildDuplicate =>
          outcome_rejected(
            Diagnostic {
              reason: ^translate_target_bundle_duplicate_edge,
              at: node_locus(node: parent),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      Accepted { value: Absent, diagnostics: None }
  }
}
fn concrete_token_class_child(parent: Node) -> Outcome<Node?> {
  optional_named_child_ignoring_positional(
    parent: parent,
    edge_name: ^concrete_syntax_token_field_class
  )
}
fn concrete_token_kind_child(parent: Node) -> Outcome<Node?> {
  optional_named_child_ignoring_positional(
    parent: parent,
    edge_name: ^concrete_syntax_token_field_kind
  )
}
fn token_sequence_item_kind(item: Node) -> Outcome<TokenSequenceItemKind> {
  bind_outcome(
    o: concrete_token_class_child(parent: item),
    f: fn(class_node) {
      bind_outcome(
        o: concrete_token_kind_child(parent: item),
        f: fn(kind_node) {
          match class_node {
            Present { value: _ } =>
              match kind_node {
                Present { value: _ } =>

                  bind_outcome(
                    o: concrete_syntax_token_from_node(token: item),
                    f: fn(_) {
                      Accepted { value: TokenSequenceConcreteToken, diagnostics: None }
                    }
                  )
                Absent =>
                  outcome_rejected(
                    translate_concrete_token_kind_invalid_diagnostic(token: item)
                  )
              }
            Absent =>
              match kind_node {
                Present { value: _ } =>
                  outcome_rejected(
                    translate_concrete_token_class_missing_diagnostic(token: item)
                  )
                Absent =>
                  Accepted { value: TokenSequenceNonterminal, diagnostics: None }
              }
          }
        }
      )
    }
  )
}

fn serialize_source_tokens_fold_child(serialize_source: Node) -> Optional<Node> {
  fold(
    serialize_source.children,
    init: optional_absent(),
    f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match e.label {
            Named { name: n } =>
              if n == ^grammar_relation_field_tokens { optional_present(value: e.target) } else { acc }
            Positional => acc
          }
      }
    }
  )
}

fn serialize_source_fold_list_targets(remaining: Int, node: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
  } else {
    match node.kind {
      TypeNode { connective: Conj } =>
        if is_empty(xs: node.children) {
          Accepted { value: Empty, diagnostics: None }
        } else {
          bind_outcome(
            o: conj_named_child(parent: node, edge_name: ^fold_list_node_head),
            f: fn(head) {
              bind_outcome(
                o: conj_named_child(parent: node, edge_name: ^fold_list_node_tail),
                f: fn(tail) {
                  bind_outcome(
                    o: serialize_source_fold_list_targets(remaining: remaining - 1, node: tail),
                    f: fn(rest) {
                      Accepted { value: Cons { head: head, tail: rest }, diagnostics: None }
                    }
                  )
                }
              )
            }
          )
        }
      _ => outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
    }
  }
}

fn serialize_source_token_targets(serialize_source: Node) -> Outcome<List<Node>> {
  match serialize_source_tokens_fold_child(serialize_source: serialize_source) {
    Present { value: tokens_fold } =>
      serialize_source_fold_list_targets(
        remaining: node_subtree_count(n: tokens_fold),
        node: tokens_fold
      )
    Absent =>
      conj_positional_targets(parent: serialize_source)
  }
}

fn grammar_tokens_node_targets(tokens_node: Node) -> Outcome<List<Node>> {
  bind_outcome(
    o: optional_named_child_ignoring_positional(
      parent: tokens_node,
      edge_name: ^fold_list_node_head
    ),
    f: fn(maybe_head) {
      match maybe_head {
        Present { value: _ } =>
          serialize_source_fold_list_targets(
            remaining: node_subtree_count(n: tokens_node),
            node: tokens_node
          )
        Absent =>
          conj_positional_targets(parent: tokens_node)
      }
    }
  )
}
fn grammar_serialize_source_matches_row(
  serialize_source: Node,
  row: Node
) -> Outcome<Node> {
  if well_formed(n: serialize_source) {
    bind_outcome(
      o: grammar_relation_row_tokens_root(row: row),
      f: fn(tokens_root) {
        bind_outcome(
          o: serialize_source_token_targets(serialize_source: serialize_source),
          f: fn(source_targets) {
            bind_outcome(
              o: grammar_tokens_node_targets(tokens_node: tokens_root),
              f: fn(row_targets) {
                if zip_eq(a: source_targets, b: row_targets, eq: fn(x, y) { x == y }) {
                  Accepted { value: serialize_source, diagnostics: None }
                } else {
                  outcome_rejected(
                    translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
                  )
                }
              }
            )
          }
        )
      }
    )
  } else {
    outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
    )
  }
}
fn grammar_inverse_source_validated(
  target: TargetModel,
  emitted: Node
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
        f: fn(row) {
          bind_outcome(
            o: target_bundle_child(target: target, edge_name: ^target_model_edge_serialize_source),
            f: fn(serialize_source) {
              grammar_serialize_source_matches_row(
                serialize_source: serialize_source,
                row: row
              )
            }
          )
        }
      )
    }
  )
}
fn serialize_concrete_syntax_tokens_to_source(
  target: TargetModel,
  tokens: List<ConcreteSyntaxToken>
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: serialize_concrete_syntax_tokens_to_source_string(target: target, tokens: tokens),
    f: fn(text) {
      outcome_accepted(lossless_source(text: text))
    }
  )
}
fn serialize_concrete_syntax_tokens_to_source_string(
  target: TargetModel,
  tokens: List<ConcreteSyntaxToken>
) -> Outcome<String> {
  fold_list(
    xs: tokens,
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, token) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: partial, diagnostics: ad } =>
          match token {
            FixedToken { token_class: token_class } =>
              bind_outcome(
                o: lex_rules_literal_for_class(rules: target.lex, token_class: token_class),
                f: fn(spelling) {
                  Accepted {
                    value: list_append(left: partial, right: spelling),
                    diagnostics: ad
                  }
                }
              )
            BoundToken { token_class: _, binding: binding } =>
              bind_outcome(
                o: target_binding_spelling_lookup(target: target, binding: binding),
                f: fn(spelling) {
                  Accepted {
                    value: list_append(left: partial, right: spelling),
                    diagnostics: ad
                  }
                }
              )
          }
      }
    }
  )
}

fn translate_project_transform_in_arrow_scope(
  arrow: Node,
  body: Node,
  target: TargetModel
) -> Outcome<TargetValueExpression> {
  bind_outcome(
    o: target_transform_surface_op_atom(node: body),
    f: fn(op_sym) {
      match dag_surface_operator_canonicalization_member(surface_token: op_sym) {
        Accepted { value: canonical_op, diagnostics: _ } =>
          target_project_transform_primitive_apply_in_arrow_scope(
            arrow: arrow,
            body: body,
            canonical_op: canonical_op,
            target: target
          )

        Rejected { diagnostics: _ } =>
          target_project_transform_callable_apply_in_arrow_scope(
            arrow: arrow,
            body: body,
            target: target,
            handle_transform: fn(a, b, t) {
              translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t)
            }
          )
      }
    }
  )
}

fn target_serialize_bodied_arrow_from_model(
  target: TargetModel,
  emitted: Node
) -> Outcome<String> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: grammar_relation_row_for_bodied_arrow_serialize(rules: rules, emitted: emitted),
        f: fn(scaffold) {
          bind_outcome(
            o: target_value_expression_projection_from_target(target: target),
            f: fn(projection) {
              bind_outcome(
                o: target_project_arrow_body_to_value_expression(
                  arrow: emitted,
                  target: target,
                  handle_transform: fn(a, b, t) {
                    translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t)
                  }
                ),
                f: fn(expr) {
                  bind_outcome(
                    o: target_value_expression_tokens_from_target(
                      expr: expr,
                      target: target,
                      projection: projection
                    ),
                    f: fn(body_tokens) {
                      serialize_concrete_syntax_tokens_to_source_string(
                        target: target,
                        tokens: target_bodied_arrow_compose_statement_tokens(
                          scaffold: scaffold,
                          body: body_tokens
                        )
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_serialize_relation_row_from_model_bounded(
  remaining: Int,
  target: TargetModel,
  emitted: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else if target_value_expr_arrow_has_value_expression_body(arrow: emitted) {
    target_serialize_bodied_arrow_from_model(target: target, emitted: emitted)
  } else {
    bind_outcome(
      o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
      f: fn(rules) {
        bind_outcome(
          o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
          f: fn(row) {
            bind_outcome(
              o: grammar_relation_row_tokens_root(row: row),
              f: fn(tokens_root) {
                bind_outcome(
                  o: grammar_tokens_node_targets(tokens_node: tokens_root),
                  f: fn(tokens) {
                    fold_list(
                      xs: tokens,
                      empty: Accepted { value: Empty, diagnostics: None },
                      cons: fn(acc, token_node) {
                        match acc {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: partial, diagnostics: ad } =>
                            match token_sequence_item_kind(item: token_node) {
                              Accepted { value: TokenSequenceConcreteToken, diagnostics: kd } =>
                                match token_spelling_from_model(target: target, token: token_node) {
                                  Accepted { value: source, diagnostics: td } =>
                                    Accepted {
                                      value: list_append(left: partial, right: source),
                                      diagnostics: diagnostics_merge(
                                        outer: diagnostics_merge(outer: ad, inner: kd),
                                        inner: td
                                      )
                                    }
                                  Rejected { diagnostics: r } =>
                                    Rejected {
                                      diagnostics: rejected_with_pending(
                                        pending: diagnostics_merge(outer: ad, inner: kd),
                                        rejected: r
                                      )
                                    }
                                }
                              Accepted { value: TokenSequenceNonterminal, diagnostics: kd } =>
                                match target_serialize_relation_row_from_model_bounded(
                                  remaining - 1,
                                  target,
                                  token_node
                                ) {
                                  Accepted { value: source, diagnostics: td } =>
                                    Accepted {
                                      value: list_append(left: partial, right: source),
                                      diagnostics: diagnostics_merge(
                                        outer: diagnostics_merge(outer: ad, inner: kd),
                                        inner: td
                                      )
                                    }
                                  Rejected { diagnostics: r } =>
                                    Rejected {
                                      diagnostics: rejected_with_pending(
                                        pending: diagnostics_merge(outer: ad, inner: kd),
                                        rejected: r
                                      )
                                    }
                                }
                              Rejected { diagnostics: r } =>
                                Rejected {
                                  diagnostics: rejected_with_pending(pending: ad, rejected: r)
                                }
                            }
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}
fn translate_lex_rule_literal_not_found_diagnostic(token_class: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^translate_lex_rule_literal_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: token_class } },
      children: [],
      occurrence_id: SyntheticOccurrence
}),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_binding_spelling_not_found_diagnostic(binding: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^translate_binding_spelling_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: binding } },
      children: [],
      occurrence_id: SyntheticOccurrence
}),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn node_atom_identity(node: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      Accepted { value: id, diagnostics: None }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
  }
}
fn token_item_to_source_bounded(
  remaining: Int,
  item: Node,
  target: TargetModel
) -> Outcome<String> {
  bind_outcome(
    o: token_sequence_item_kind(item: item),
    f: fn(item_kind) {
      match item_kind {
        TokenSequenceConcreteToken =>
          token_spelling_from_model(target: target, token: item)
        TokenSequenceNonterminal =>
          target_serialize_relation_row_from_model_bounded(remaining - 1, target, item)
      }
    }
  )
}
fn token_item_to_source(item: Node, target: TargetModel) -> Outcome<String> {
  bind_outcome(
    o: token_item_serialize_measure(item: item, target: target),
    f: fn(measure) {
      token_item_to_source_bounded(measure, item, target)
    }
  )
}
fn token_sequence_to_source_bounded(
  remaining: Int,
  tokens: List<Node>,
  target: TargetModel
) -> Outcome<String> {
  fold_list(
    xs: tokens,
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, token_node) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: partial, diagnostics: ad } =>
          match token_item_to_source_bounded(remaining - 1, token_node, target) {
            Accepted { value: source, diagnostics: td } =>
              Accepted {
                value: list_append(left: partial, right: source),
                diagnostics: diagnostics_merge(outer: ad, inner: td)
              }
            Rejected { diagnostics: r } =>
              Rejected {
                diagnostics: rejected_with_pending(pending: ad, rejected: r)
              }
          }
      }
    }
  )
}
fn token_sequence_to_source(tokens: List<Node>, target: TargetModel) -> Outcome<String> {
  bind_outcome(
    o: token_sequence_serialize_measure(tokens: tokens, target: target),
    f: fn(measure) {
      token_sequence_to_source_bounded(measure, tokens, target)
    }
  )
}

fn target_serialize_source_from_model_bounded(
  remaining: Int,
  target: TargetModel,
  emitted: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else if target_value_expr_arrow_has_value_expression_body(arrow: emitted) {
    target_serialize_bodied_arrow_from_model(target: target, emitted: emitted)
  } else if is_dag_import_carrier(emitted: emitted) {
    bind_outcome(
      o: module_import_projection_from_target(target: target),
      f: fn(projection) {
        bind_outcome(
          o: import_value_from_carrier(carrier: emitted),
          f: fn(import_value) {
            bind_outcome(
              o: target_import_to_concrete_tokens(
                import_value: import_value,
                projection: projection
              ),
              f: fn(tokens) {
                serialize_concrete_syntax_tokens_to_source_string(
                  target: target,
                  tokens: tokens
                )
              }
            )
          }
        )
      }
    )
  } else {
    match target_type_expr_emitted_kind(node: emitted) {
      TypeExprKindAuthority { value: _ } =>
        bind_outcome(
          o: type_expression_projection_from_target(target: target),
          f: fn(projection) {
            serialize_type_expr_emitted_bounded(
              remaining: remaining - 1,
              target: target,
              projection: projection,
              emitted: emitted
            )
          }
        )
      TypeExprKindNotEmitted =>
        bind_outcome(
          o: grammar_inverse_source_validated(target: target, emitted: emitted),
          f: fn(_) {
            target_serialize_relation_row_from_model_bounded(remaining - 1, target, emitted)
          }
        )
      TypeExprKindAuthorityInvalid =>
        outcome_rejected(
          translate_type_expr_kind_authority_invalid_diagnostic(node: emitted)
        )
    }
  }
}
fn target_serialize_source_from_model(
  target: TargetModel,
  emitted: Node
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: translate_serialize_measure(target: target, emitted: emitted),
    f: fn(measure) {
      bind_outcome(
        o: target_serialize_source_from_model_bounded(measure, target, emitted),
        f: fn(text) {
          outcome_accepted(lossless_source(text: text))
        }
      )
    }
  )
}
fn target_bundle_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.bundle.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: child, diagnostics: None }
        BundleChildMissing =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
        BundleChildDuplicate =>
          outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
      }
    _ =>
      outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_bundle_optional_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node?> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.bundle.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: Present { value: child }, diagnostics: None }
        BundleChildMissing =>
          Accepted { value: Absent, diagnostics: None }
        BundleChildDuplicate =>
          outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
      }
    _ =>
      outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_selection_priority_from_model(target: TargetModel) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_selection_policy),
    f: fn(priority_node) {
      Accepted {
        value: priority_node,
        diagnostics: None
      }
    }
  )
}
fn coercion_candidates_from_target_model(
  target: TargetModel
) -> Outcome<CoercionCandidateSet> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_declared_inhabitants),
    f: fn(inhabitants_root) {
      coercion_candidate_set_from_declared_inhabitants(
        inhabitants_root: inhabitants_root,
        closedness_property: ^target_model_edge_declared_inhabitants
      )
    }
  )
}
fn coerce_grounded_node(
  source: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<CoercionResult> {
  bind_outcome(
    o: canonical_grounding_for_node(tree: tree, node: source),
    f: fn(grounding) {
      bind_outcome(
        o: target_selection_priority_from_model(target: target),
        f: fn(priority) {
          bind_outcome(
            o: coercion_candidates_from_target_model(
              target: target
            ),
            f: fn(candidates) {
              coercion_fold_with_declared_priority(
                source: grounding,
                candidates: candidates,
                priority: priority
              )
            }
          )
        }
      )
    }
  )
}
fn translate_type_expression_shape_missing_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^translate_type_expression_shape_missing,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_type_expr_kind_authority_invalid_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^translate_type_expr_kind_authority_invalid,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn target_collection_subtree_count(n: Node) -> Int {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(_) { 1 },
      step: fn(acc, _edge, child_count) { acc + child_count }
    }
  )
}

fn target_collection_fold_list_from_node<T>(
  remaining: Int,
  node: Node,
  decode_item: fn(Node) -> Outcome<T>
) -> Outcome<List<T>> {
  if remaining <= 0 {
    outcome_rejected(target_collection_shape_malformed_diagnostic(node: node))
  } else {
    match node.kind {
      TypeNode { connective: Conj } =>
        if is_empty(xs: node.children) {
          outcome_accepted(Empty)
        } else {
          bind_outcome(
            o: find_named_child(root: node, name: ^fold_list_node_head),
            f: fn(head_node) {
              bind_outcome(
                o: decode_item(node: head_node),
                f: fn(head_item) {
                  bind_outcome(
                    o: find_named_child(root: node, name: ^fold_list_node_tail),
                    f: fn(tail_node) {
                      bind_outcome(
                        o: target_collection_fold_list_from_node(
                          remaining: remaining - 1,
                          node: tail_node,
                          decode_item: decode_item
                        ),
                        f: fn(tail_items) {
                          outcome_accepted(
                            Cons { head: head_item, tail: tail_items }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      _ => outcome_rejected(target_collection_shape_malformed_diagnostic(node: node))
    }
  }
}

fn target_collection_choice_from_node(node: Node) -> Outcome<TargetRepresentationChoice> {
  bind_outcome(
    o: find_named_child(root: node, name: ^target_collection_choice_field_form),
    f: fn(form_node) {
      bind_outcome(
        o: target_collection_repr_from_node(node: form_node),
        f: fn(form) {
          bind_outcome(
            o: find_named_child(root: node, name: ^target_collection_choice_field_constraints),
            f: fn(constraints_node) {
              bind_outcome(
                o: target_collection_fold_list_from_node(
                  remaining: target_collection_subtree_count(n: constraints_node),
                  node: constraints_node,
                  decode_item: target_collection_witness_from_node
                ),
                f: fn(constraints) {
                  outcome_accepted(
                    TargetRepresentationChoice {
                      form: form,
                      constraints: constraints
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_collection_realization_from_bundle(
  bundle: Node
) -> Outcome<TargetCollectionRealization> {
  bind_outcome(
    o: conj_named_child(parent: bundle, edge_name: ^target_collection_row_field_source_carrier),
    f: fn(source_carrier) {
      bind_outcome(
        o: conj_named_child(parent: bundle, edge_name: ^target_collection_row_field_primary),
        f: fn(primary_node) {
          bind_outcome(
            o: target_collection_choice_from_node(node: primary_node),
            f: fn(primary) {
              bind_outcome(
                o: conj_named_child(parent: bundle, edge_name: ^target_collection_row_field_alternatives),
                f: fn(alternatives_node) {
                  bind_outcome(
                    o: target_collection_fold_list_from_node(
                      remaining: node_subtree_count(n: alternatives_node),
                      node: alternatives_node,
                      decode_item: target_collection_choice_from_node
                    ),
                    f: fn(alternatives) {
                      bind_outcome(
                        o: conj_named_child(parent: bundle, edge_name: ^target_collection_row_field_fallback),
                        f: fn(fallback_node) {
                          bind_outcome(
                            o: target_collection_fallback_from_node(node: fallback_node),
                            f: fn(fallback_diagnostic) {
                              Accepted {
                                value: TargetCollectionRealization {
                                  source_carrier: source_carrier,
                                  primary: primary,
                                  alternatives: alternatives,
                                  fallback_diagnostic: fallback_diagnostic
                                },
                                diagnostics: None
                              }
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn collection_realization_from_target(target: TargetModel) -> Outcome<TargetCollectionRealization> {
  collection_realization_from_target_carrier(
    target: target,
    expected_source_carrier: target_collection_set_carrier_node()
  )
}

fn free_monoid_collection_realization_from_target(
  target: TargetModel
) -> Outcome<TargetCollectionRealization> {
  collection_realization_from_target_carrier(
    target: target,
    expected_source_carrier: target_carrier_free_monoid_node()
  )
}

fn collection_realization_from_target_carrier(
  target: TargetModel,
  expected_source_carrier: Node
) -> Outcome<TargetCollectionRealization> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_collection_realization),
    f: fn(catalog_node) {
      bind_outcome(
        o: target_collection_fold_list_from_node(
          remaining: node_subtree_count(n: catalog_node),
          node: catalog_node,
          decode_item: fn(row_node) {
            target_collection_realization_from_bundle(bundle: row_node)
          }
        ),
        f: fn(rows) {
          target_collection_realization_lookup_in_catalog(
            catalog: rows,
            source_carrier: expected_source_carrier
          )
        }
      )
    }
  )
}

fn project_set_collection_type_node(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  match target_collection_set_element_type_node(set_node: node) {
    Present { value: elem } =>
      bind_outcome(
        o: collection_realization_from_target(target: target),
        f: fn(row) {
          match target_collection_select_choice(
            primary: row.primary,
            alternatives: row.alternatives,
            elem: elem
          ) {
            Present { value: choice } =>
              bind_outcome(
                o: translate_type_expression_project(node: elem, target: target, projection: projection),
                f: fn(elem_projected) {
                  Accepted {
                    value: target_type_expr_instantiation_emitted(
                      form: choice.form.apply,
                      head: target_type_expr_atom_emitted(
                        form: projection.atom_form,
                        identity: choice.form.apply.surface
                      ),
                      args: Cons { head: elem_projected, tail: Empty }
                    ),
                    diagnostics: None
                  }
                }
              )
            Absent => outcome_rejected(row.fallback_diagnostic)
          }
        }
      )
    Absent =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}

fn project_free_monoid_collection_type_node(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  match target_collection_free_monoid_element_type_node(free_monoid_node: node) {
    Present { value: elem } =>
      bind_outcome(
        o: free_monoid_collection_realization_from_target(target: target),
        f: fn(row) {
          match target_collection_select_choice(
            primary: row.primary,
            alternatives: row.alternatives,
            elem: elem
          ) {
            Present { value: choice } =>
              bind_outcome(
                o: translate_type_expression_project(node: elem, target: target, projection: projection),
                f: fn(elem_projected) {
                  bind_outcome(
                    o: translate_apply_use_site_ownership_to_projected_type(
                      projected: elem_projected,
                      source_carrier: elem,
                      target: target,
                      use_site: OwnershipAtBindingProjection
                    ),
                    f: fn(elem_storage) {
                      Accepted {
                        value: target_type_expr_instantiation_emitted(
                          form: choice.form.apply,
                          head: target_type_expr_atom_emitted(
                            form: projection.atom_form,
                            identity: choice.form.apply.surface
                          ),
                          args: Cons { head: elem_storage, tail: Empty }
                        ),
                        diagnostics: None
                      }
                    }
                  )
                }
              )
            Absent => outcome_rejected(row.fallback_diagnostic)
          }
        }
      )
    Absent =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}
type TypeExprHeadTail {
  head: Node
  tail: List<Node>
}
type TypeExprArrowSplit {
  inputs: List<Node>
  output: Node
}
fn type_expr_arrow_split_from_types(
  types: List<Node>,
  node: Node
) -> Outcome<TypeExprArrowSplit> {
  bind_outcome(
    o: list_head_and_tail(xs: types, node: node),
    f: fn(split) {
      if is_empty(xs: split.tail) {
        outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
      } else {
        outcome_accepted(
          fold_list(
            xs: split.tail,
            empty: TypeExprArrowSplit { inputs: Empty, output: split.head },
            cons: fn(acc, t) {
              TypeExprArrowSplit {
                inputs: list_snoc_item(xs: acc.inputs, item: acc.output),
                output: t
              }
            }
          )
        )
      }
    }
  )
}
fn list_head_and_tail(xs: List<Node>, node: Node) -> Outcome<TypeExprHeadTail> {
  match list_at_optional(xs: xs, index: 0) {
    Absent =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
    Present { value: head } =>
      match list_tail(xs: xs) {
        TailAbsent =>
          outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        TailFound { tail: t } =>
          Accepted { value: TypeExprHeadTail { head: head, tail: t }, diagnostics: None }
      }
  }
}

type TypeExprTranslateAcc
  = TypeExprTranslateSlots { slots: List<TargetTypeExprFieldSlot> }
  | TypeExprTranslateVariants { variants: List<TargetTypeExprVariantSlot> }
  | TypeExprTranslatePositional { items: List<Node> }
  | TypeExprTranslateDone { node: Node }

fn translate_algebra_finalize(
  acc: TypeExprTranslateAcc,
  anchor: Node,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  match anchor.kind {
    TypeNode { connective: connective } =>
      match connective {
        Atom { identity: _ } =>
          match acc {
            TypeExprTranslateDone { node: n } => outcome_accepted(n)
            _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Conj =>
          match acc {
            TypeExprTranslateDone { node: n } => outcome_accepted(n)
            TypeExprTranslateSlots { slots: fields } =>
              if is_empty(xs: fields) && !is_empty(xs: anchor.children) {
                outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
              } else {
                outcome_accepted(
                  target_type_expr_record_emitted(form: projection.conj_form, fields: fields)
                )
              }
            _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Disj =>
          match acc {
            TypeExprTranslateDone { node: n } => outcome_accepted(n)
            TypeExprTranslateVariants { variants: variants } =>
              outcome_accepted(
                target_type_expr_sum_emitted(form: projection.disj_form, variants: variants)
              )
            _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Instantiation =>
          match acc {
            TypeExprTranslateDone { node: n } => outcome_accepted(n)
            TypeExprTranslatePositional { items: projected } =>
              bind_outcome(
                o: list_head_and_tail(xs: projected, node: anchor),
                f: fn(split) {
                  outcome_accepted(
                    target_type_expr_instantiation_emitted(
                      form: projection.instantiation_form,
                      head: split.head,
                      args: split.tail
                    )
                  )
                }
              )
            _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Cardinality =>
          match acc {
            TypeExprTranslateDone { node: n } => outcome_accepted(n)
            TypeExprTranslatePositional { items: projected } =>
              bind_outcome(
                o: list_head_and_tail(xs: projected, node: anchor),
                f: fn(split) {
                  outcome_accepted(
                    target_type_expr_cardinality_emitted(
                      form: projection.cardinality_form,
                      head: split.head,
                      args: split.tail
                    )
                  )
                }
              )
            _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Arrow =>
          match acc {
            TypeExprTranslateDone { node: n } => outcome_accepted(n)
            _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
      }
    ComputationNode { behavior: _ } =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
  }
}

fn translate_type_expression_arrow_project(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  bind_outcome(
    o: type_expr_arrow_split_from_types(
      types: node_positional_child_targets(node: node),
      node: node
    ),
    f: fn(original_split) {
      bind_outcome(
        o: translate_project_arrow_split_types(
          original_split: original_split,
          target: target,
          projection: projection,
          anchor: node
        ),
        f: fn(split) {
          outcome_accepted(
            target_type_expr_arrow_emitted(
              form: projection.arrow_form,
              inputs: split.inputs,
              output: split.output
            )
          )
        }
      )
    }
  )
}

fn translate_algebra(
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> NodeFold<Outcome<TypeExprTranslateAcc>> {
  NodeFold {
    init: fn(n) {
      match n.kind {
        TypeNode { connective: connective } =>
          match connective {
            Atom { identity: id } =>
              Accepted {
                value: TypeExprTranslateDone {
                  node: target_type_expr_atom_emitted(
                    form: projection.atom_form,
                    identity: id
                  )
                },
                diagnostics: None
              }
            Conj =>
              Accepted { value: TypeExprTranslateSlots { slots: Empty }, diagnostics: None }
            Disj =>
              Accepted {
                value: TypeExprTranslateVariants { variants: Empty },
                diagnostics: None
              }
            Instantiation =>
              Accepted {
                value: TypeExprTranslatePositional { items: Empty },
                diagnostics: None
              }
            Cardinality =>
              Accepted {
                value: TypeExprTranslatePositional { items: Empty },
                diagnostics: None
              }
            Arrow =>
              bind_outcome(
                o: translate_type_expression_arrow_project(
                  node: n,
                  target: target,
                  projection: projection
                ),
                f: fn(emitted) {
                  Accepted {
                    value: TypeExprTranslateDone { node: emitted },
                    diagnostics: None
                  }
                }
              )
          }
        ComputationNode { behavior: _ } =>
          outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: n))
      }
    },
    step: fn(acc, e, child) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: done, diagnostics: d } =>
          match done {
            TypeExprTranslateDone { node: _ } => Accepted { value: done, diagnostics: d }
            TypeExprTranslateSlots { slots: slots } =>
              match e.label {
                Named { name: label } =>
                  match child {
                    Rejected { diagnostics: cr } =>
                      Rejected { diagnostics: rejected_with_pending(pending: d, rejected: cr) }
                    Accepted { value: child_acc, diagnostics: cd } =>
                      bind_outcome(
                        o: translate_algebra_finalize(
                          acc: child_acc,
                          anchor: e.target,
                          projection: projection
                        ),
                        f: fn(projected) {
                          bind_outcome(
                            o: translate_apply_use_site_ownership_to_projected_boundary(
                              projected: projected,
                              source_for_binding: e.target,
                              target: target,
                              projection: projection,
                              use_site: OwnershipAtStructField
                            ),
                            f: fn(wrapped) {
                              Accepted {
                                value: TypeExprTranslateSlots {
                                  slots: list_snoc_item(
                                    xs: slots,
                                    item: TargetTypeExprFieldSlot {
                                      label: label,
                                      type_expr: wrapped
                                    }
                                  )
                                },
                                diagnostics: diagnostics_merge(outer: d, inner: cd)
                              }
                            }
                          )
                        }
                      )
                  }
                Positional =>
                  outcome_rejected(
                    translate_type_expression_shape_missing_diagnostic(node: e.target)
                  )
              }
            TypeExprTranslateVariants { variants: variants } =>
              match e.label {
                Named { name: label } =>
                  match child {
                    Rejected { diagnostics: cr } =>
                      Rejected { diagnostics: rejected_with_pending(pending: d, rejected: cr) }
                    Accepted { value: child_acc, diagnostics: cd } =>
                      bind_outcome(
                        o: translate_algebra_finalize(
                          acc: child_acc,
                          anchor: e.target,
                          projection: projection
                        ),
                        f: fn(projected) {
                          Accepted {
                            value: TypeExprTranslateVariants {
                              variants: list_snoc_item(
                                xs: variants,
                                item: TargetTypeExprVariantSlot {
                                  label: label,
                                  type_expr: projected
                                }
                              )
                            },
                            diagnostics: diagnostics_merge(outer: d, inner: cd)
                          }
                        }
                      )
                  }
                Positional =>
                  outcome_rejected(
                    translate_type_expression_shape_missing_diagnostic(node: e.target)
                  )
              }
            TypeExprTranslatePositional { items: items } =>
              match child {
                Rejected { diagnostics: cr } =>
                  Rejected { diagnostics: rejected_with_pending(pending: d, rejected: cr) }
                Accepted { value: child_acc, diagnostics: cd } =>
                  bind_outcome(
                    o: translate_algebra_finalize(
                      acc: child_acc,
                      anchor: e.target,
                      projection: projection
                    ),
                    f: fn(projected) {
                      Accepted {
                        value: TypeExprTranslatePositional {
                          items: list_snoc_item(xs: items, item: projected)
                        },
                        diagnostics: diagnostics_merge(outer: d, inner: cd)
                      }
                    }
                  )
              }
          }
      }
    }
  }
}

fn translate_type_expression_project(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  match node.kind {
    ComputationNode { behavior: _ } =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
    TypeNode { connective: connective } =>
      bind_outcome(
        o: type_expr_projection_row_closedness_from_target(
          target: target,
          projection: projection,
          connective: connective
        ),
        f: fn(_) {
          match connective {
            Atom { identity: _ } =>
              bind_outcome(
                o: fold_node(
                  n: node,
                  algebra: translate_algebra(target: target, projection: projection)
                ),
                f: fn(acc) {
                  translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                }
              )
            Instantiation =>
              if target_collection_type_node_is_free_monoid_carrier(node: node) {
                project_free_monoid_collection_type_node(
                  node: node,
                  target: target,
                  projection: projection
                )
              } else {
                bind_outcome(
                  o: fold_node(
                    n: node,
                    algebra: translate_algebra(target: target, projection: projection)
                  ),
                  f: fn(acc) {
                    translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                  }
                )
              }
            Cardinality =>
              if target_collection_type_node_is_set_carrier(node: node) {
                project_set_collection_type_node(node: node, target: target, projection: projection)
              } else {
                bind_outcome(
                  o: fold_node(
                    n: node,
                    algebra: translate_algebra(target: target, projection: projection)
                  ),
                  f: fn(acc) {
                    translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                  }
                )
              }
            Conj =>
              bind_outcome(
                o: fold_node(
                  n: node,
                  algebra: translate_algebra(target: target, projection: projection)
                ),
                f: fn(acc) {
                  translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                }
              )
            Disj =>
              bind_outcome(
                o: fold_node(
                  n: node,
                  algebra: translate_algebra(target: target, projection: projection)
                ),
                f: fn(acc) {
                  translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                }
              )
            Arrow =>
              bind_outcome(
                o: fold_node(
                  n: node,
                  algebra: translate_algebra(target: target, projection: projection)
                ),
                f: fn(acc) {
                  translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                }
              )
          }
        }
      )
  }
}
fn type_expr_atom_binding_from_positional(
  targets: List<Node>,
  node: Node
) -> Outcome<Symbol> {
  bind_outcome(
    o: list_head_and_tail(xs: targets, node: node),
    f: fn(split) {
      if is_empty(xs: split.tail) {
        match split.head.kind {
          TypeNode { connective: Atom { identity: id } } =>
            Accepted { value: id, diagnostics: None }
          _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        }
      } else {
        outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
      }
    }
  )
}
fn type_expr_atom_binding(node: Node) -> Outcome<Symbol> {
  type_expr_atom_binding_from_positional(
    targets: node_positional_child_targets(node: node),
    node: node
  )
}

fn type_expr_spelling_for_atom(target: TargetModel, node: Node) -> Outcome<String> {
  bind_outcome(
    o: type_expr_atom_binding(node: node),
    f: fn(binding) {
      target_binding_spelling_lookup(target: target, binding: binding)
    }
  )
}

fn serialize_type_expr_record_field_label(target: TargetModel, edge: Edge) -> Outcome<String> {
  match edge.label {
    Named { name: label } => target_binding_spelling_lookup(target: target, binding: label)
    Positional =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: edge.target))
  }
}

fn type_expr_carrier_identity(node: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: _ } } => node_atom_identity(node: node)
    _ => type_expr_atom_binding(node: node)
  }
}
fn serialize_type_expr_emitted_positional_head_tail(node: Node) -> Outcome<TypeExprHeadTail> {
  list_head_and_tail(
    xs: node_positional_child_targets(node: node),
    node: node
  )
}
fn serialize_type_expr_generic_apply_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetGenericApply,
  node: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: node)
    )
  } else {
    bind_outcome(
      o: serialize_type_expr_emitted_positional_head_tail(node: node),
      f: fn(split) {
        bind_outcome(
          o: serialize_type_expr_emitted_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            emitted: split.head
          ),
          f: fn(head_source) {
            bind_outcome(
              o: lex_rules_literal(target: target, token_class: form.open),
              f: fn(open_source) {
                bind_outcome(
                  o: serialize_type_expr_args_bounded(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    form: form,
                    args: split.tail,
                    anchor: node
                  ),
                  f: fn(args_source) {
                    bind_outcome(
                      o: lex_rules_literal(target: target, token_class: form.close),
                      f: fn(close_source) {
                        Accepted {
                          value: list_append(
                            left: list_append(
                              left: list_append(left: head_source, right: open_source),
                              right: args_source
                            ),
                            right: close_source
                          ),
                          diagnostics: None
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}
fn serialize_type_expr_args_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetGenericApply,
  args: List<Node>,
  anchor: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    fold_list(
      xs: args,
      empty: Accepted { value: Empty, diagnostics: None },
      cons: fn(acc, arg) {
        bind_outcome(
          o: acc,
          f: fn(source) {
            bind_outcome(
              o: serialize_type_expr_emitted_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                emitted: arg
              ),
              f: fn(arg_source) {
                if is_empty(xs: source) {
                  outcome_accepted(arg_source)
                } else {
                  bind_outcome(
                    o: lex_rules_literal(target: target, token_class: form.separator),
                    f: fn(sep_source) {
                      outcome_accepted(
                        list_append(
                          left: list_append(left: source, right: sep_source),
                          right: arg_source
                        )
                      )
                    }
                  )
                }
              }
            )
          }
        )
      }
    )
  }
}
fn serialize_type_expr_separated_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  separator: Symbol,
  items: List<Node>,
  anchor: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    fold_list(
      xs: items,
      empty: Accepted { value: Empty, diagnostics: None },
      cons: fn(acc, item) {
        bind_outcome(
          o: acc,
          f: fn(source) {
            bind_outcome(
              o: serialize_type_expr_emitted_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                emitted: item
              ),
              f: fn(item_source) {
                if is_empty(xs: source) {
                  outcome_accepted(item_source)
                } else {
                  bind_outcome(
                    o: lex_rules_literal(target: target, token_class: separator),
                    f: fn(sep_source) {
                      outcome_accepted(
                        list_append(
                          left: list_append(left: source, right: sep_source),
                          right: item_source
                        )
                      )
                    }
                  )
                }
              }
            )
          }
        )
      }
    )
  }
}

fn serialize_type_expr_record_fields_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  separator: Symbol,
  field_label_separator: Symbol,
  fields: List<Edge>,
  anchor: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    fold(
      fields,
      init: Accepted { value: Empty, diagnostics: None },
      f: fn(acc, field) {
        bind_outcome(
          o: acc,
          f: fn(source) {
            bind_outcome(
              o: serialize_type_expr_record_field_label(target: target, edge: field),
              f: fn(label_source) {
                bind_outcome(
                  o: lex_rules_literal(target: target, token_class: field_label_separator),
                  f: fn(label_sep_source) {
                    bind_outcome(
                      o: serialize_type_expr_emitted_bounded(
                        remaining: remaining - 1,
                        target: target,
                        projection: projection,
                        emitted: field.target
                      ),
                      f: fn(field_type_source) {
                        let field_source = list_append(
                          left: list_append(left: label_source, right: label_sep_source),
                          right: field_type_source
                        )
                        if is_empty(xs: source) {
                          outcome_accepted(field_source)
                        } else {
                          bind_outcome(
                            o: lex_rules_literal(target: target, token_class: separator),
                            f: fn(sep_source) {
                              outcome_accepted(
                                list_append(
                                  left: list_append(left: source, right: sep_source),
                                  right: field_source
                                )
                              )
                            }
                          )
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}

fn serialize_type_expr_record_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetGenericApply,
  node: Node
) -> Outcome<String> {
  match form.field_label_separator {
    Present { value: field_label_separator } =>
      bind_outcome(
        o: target_type_expr_emitted_labeled_slot_edges(node: node),
        f: fn(fields) {
          bind_outcome(
            o: lex_rules_literal(target: target, token_class: form.open),
            f: fn(open_source) {
              bind_outcome(
                o: serialize_type_expr_record_fields_bounded(
                  remaining: remaining - 1,
                  target: target,
                  projection: projection,
                  separator: form.separator,
                  field_label_separator: field_label_separator,
                  fields: fields,
                  anchor: node
                ),
                f: fn(fields_source) {
                  bind_outcome(
                    o: lex_rules_literal(target: target, token_class: form.close),
                    f: fn(close_source) {
                      Accepted {
                        value: list_append(
                          left: list_append(left: open_source, right: fields_source),
                          right: close_source
                        ),
                        diagnostics: None
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    Absent => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}
fn serialize_type_expr_sum_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetSumTypeShape,
  node: Node
) -> Outcome<String> {
  bind_outcome(
    o: target_type_expr_emitted_labeled_slot_nodes(node: node),
    f: fn(variants) {
      serialize_type_expr_separated_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        separator: form.variant_separator,
        items: variants,
        anchor: node
      )
    }
  )
}
fn serialize_type_expr_arrow_param_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  slot: TargetTypeExprArrowParamSlot
) -> Outcome<String> {
  bind_outcome(
    o: serialize_type_expr_arrow_param_spelling(
      target: target,
      label: slot.label
    ),
    f: fn(name_source) {
      bind_outcome(
        o: serialize_type_expr_boundary_bounded(
          remaining: remaining - 1,
          target: target,
          projection: projection,
          boundary_site: FunctionBoundaryParam,
          emitted: slot.type_expr
        ),
        f: fn(type_source) {
          bind_outcome(
            o: lex_rules_literal(target: target, token_class: form.param_type_separator),
            f: fn(separator_source) {
              Accepted {
                value: list_append(
                  left: list_append(left: name_source, right: separator_source),
                  right: type_source
                ),
                diagnostics: None
              }
            }
          )
        }
      )
    }
  )
}

fn serialize_type_expr_arrow_params_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  params: List<TargetTypeExprArrowParamSlot>,
  anchor: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    fold_list(
      xs: params,
      empty: Accepted { value: Empty, diagnostics: None },
      cons: fn(acc, slot) {
        bind_outcome(
          o: acc,
          f: fn(source) {
            bind_outcome(
              o: serialize_type_expr_arrow_param_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                slot: slot
              ),
              f: fn(param_source) {
                if is_empty(xs: source) {
                  outcome_accepted(param_source)
                } else {
                  bind_outcome(
                    o: lex_rules_literal(target: target, token_class: form.param_list_separator),
                    f: fn(separator_source) {
                      outcome_accepted(
                        list_append(
                          left: list_append(left: source, right: separator_source),
                          right: param_source
                        )
                      )
                    }
                  )
                }
              }
            )
          }
        )
      }
    )
  }
}

fn serialize_type_expr_arrow_named_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  node: Node
) -> Outcome<String> {
  bind_outcome(
    o: target_type_expr_arrow_labeled_param_slots(node: node),
    f: fn(params) {
      bind_outcome(
        o: target_type_expr_arrow_labeled_codomain(node: node),
        f: fn(codomain) {
          bind_outcome(
            o: lex_rules_literal(target: target, token_class: form.open),
            f: fn(open_source) {
              bind_outcome(
                o: serialize_type_expr_arrow_params_bounded(
                  remaining: remaining - 1,
                  target: target,
                  projection: projection,
                  form: form,
                  params: params,
                  anchor: node
                ),
                f: fn(params_source) {
                  bind_outcome(
                    o: lex_rules_literal(target: target, token_class: form.close),
                    f: fn(close_source) {
                      bind_outcome(
                        o: lex_rules_literal(target: target, token_class: form.arrow),
                        f: fn(arrow_source) {
                          bind_outcome(
                            o: serialize_type_expr_boundary_bounded(
                              remaining: remaining - 1,
                              target: target,
                              projection: projection,
                              boundary_site: FunctionBoundaryReturn,
                              emitted: codomain
                            ),
                            f: fn(codomain_source) {
                              Accepted {
                                value: list_append(
                                  left: list_append(
                                    left: list_append(
                                      left: list_append(left: open_source, right: params_source),
                                      right: close_source
                                    ),
                                    right: arrow_source
                                  ),
                                  right: codomain_source
                                ),
                                diagnostics: None
                              }
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn serialize_type_expr_arrow_input_wrapped(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  input_node: Node
) -> Outcome<String> {
  bind_outcome(
    o: lex_rules_literal(target: target, token_class: form.open),
    f: fn(open_source) {
      bind_outcome(
        o: serialize_type_expr_boundary_bounded(
          remaining: remaining - 1,
          target: target,
          projection: projection,
          boundary_site: FunctionBoundaryParam,
          emitted: input_node
        ),
        f: fn(input_source) {
          bind_outcome(
            o: lex_rules_literal(target: target, token_class: form.close),
            f: fn(close_source) {
              Accepted {
                value: list_append(
                  left: list_append(left: open_source, right: input_source),
                  right: close_source
                ),
                diagnostics: None
              }
            }
          )
        }
      )
    }
  )
}
fn serialize_type_expr_arrow_inputs_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  inputs: List<Node>,
  anchor: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    fold_list(
      xs: inputs,
      empty: Accepted { value: Empty, diagnostics: None },
      cons: fn(acc, input_node) {
        bind_outcome(
          o: acc,
          f: fn(source) {
            bind_outcome(
              o: serialize_type_expr_arrow_input_wrapped(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                input_node: input_node
              ),
              f: fn(input_source) {
                if is_empty(xs: source) {
                  outcome_accepted(input_source)
                } else {
                  bind_outcome(
                    o: lex_rules_literal(target: target, token_class: form.arrow),
                    f: fn(arrow_source) {
                      outcome_accepted(
                        list_append(
                          left: list_append(left: source, right: arrow_source),
                          right: input_source
                        )
                      )
                    }
                  )
                }
              }
            )
          }
        )
      }
    )
  }
}
fn serialize_type_expr_arrow_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  node: Node
) -> Outcome<String> {
  match target_type_expr_arrow_wire_shape(node: node) {
    Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: d } =>
      bind_outcome_accepted(
        od: d,
        inner: serialize_type_expr_arrow_named_bounded(
          remaining: remaining,
          target: target,
          projection: projection,
          form: form,
          node: node
        )
      )
    Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: d } =>
      bind_outcome_accepted(
        od: d,
        inner: bind_outcome(
          o: type_expr_arrow_split_from_types(
            types: node_positional_child_targets(node: node),
            node: node
          ),
          f: fn(split) {
            bind_outcome(
              o: serialize_type_expr_arrow_inputs_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                inputs: split.inputs,
                anchor: node
              ),
              f: fn(inputs_source) {
                bind_outcome(
                  o: lex_rules_literal(target: target, token_class: form.arrow),
                  f: fn(arrow_source) {
                    bind_outcome(
                      o: serialize_type_expr_boundary_bounded(
                        remaining: remaining - 1,
                        target: target,
                        projection: projection,
                        boundary_site: FunctionBoundaryReturn,
                        emitted: split.output
                      ),
                      f: fn(output_source) {
                        Accepted {
                          value: list_append(
                            left: list_append(left: inputs_source, right: arrow_source),
                            right: output_source
                          ),
                          diagnostics: None
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
fn serialize_type_expr_emitted_wire_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  wire: TargetTypeExpression
) -> Outcome<String> {
  match wire.kind {
    TargetTypeExprAtom =>
      type_expr_spelling_for_atom(target: target, node: wire.node)
    TargetTypeExprInstantiation =>
      serialize_type_expr_generic_apply_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.instantiation_form,
        node: wire.node
      )
    TargetTypeExprCardinality =>
      serialize_type_expr_generic_apply_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.cardinality_form,
        node: wire.node
      )
    TargetTypeExprRecord =>
      serialize_type_expr_record_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.conj_form,
        node: wire.node
      )
    TargetTypeExprSum =>
      serialize_type_expr_sum_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.disj_form,
        node: wire.node
      )
    TargetTypeExprArrow =>
      serialize_type_expr_arrow_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.arrow_form,
        node: wire.node
      )
  }
}
fn serialize_type_expr_emitted_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  emitted: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else {
    bind_outcome(
      o: target_type_expr_emitted_wire_decode(node: emitted, projection: projection),
      f: fn(wire) {
        serialize_type_expr_emitted_wire_bounded(
          remaining: remaining,
          target: target,
          projection: projection,
          wire: wire
        )
      }
    )
  }
}
fn translate_outcome_is_catalog_lookup_miss(
  diagnostics: NonEmptyDiagnostics
) -> Bool {
  diagnostics.head.reason == ^target_atom_realization_lookup_miss
}

fn translate_sg_rc_bundle_edge_present(target: TargetModel, edge_name: Symbol) -> Outcome<Bool> {
  match target_bundle_optional_child(target: target, edge_name: edge_name) {
    Accepted { value: optional_child, diagnostics: d } =>
      match optional_child {
        Absent => outcome_accepted(false)
        Present { value: _ } => outcome_accepted(true)
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_sg_rc_bundle_apply_disposition(
  target: TargetModel,
  source_carrier: Node
) -> Outcome<Bool> {
  bind_outcome(
    o: translate_sg_rc_bundle_edge_present(
      target: target,
      edge_name: ^target_model_edge_use_site_ownership_realizations
    ),
    f: fn(has_catalog) {
      bind_outcome(
        o: translate_sg_rc_bundle_edge_present(
          target: target,
          edge_name: ^target_model_edge_reference_layer_tokens
        ),
        f: fn(has_tokens) {
          if has_catalog == false && has_tokens == false {
            outcome_accepted(false)
          } else {
            if has_catalog && has_tokens {
              outcome_accepted(true)
            } else {
              outcome_rejected(translate_sg_rc_bundle_partial_diagnostic(source_carrier: source_carrier))
            }
          }
        }
      )
    }
  )
}

fn translate_reference_layer_tokens_from_target(
  target: TargetModel
) -> Outcome<TargetReferenceLayerTokens> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_reference_layer_tokens),
    f: fn(bundle) { target_reference_layer_tokens_from_node(node: bundle) }
  )
}

fn translate_use_site_ownership_catalog_from_model(
  target: TargetModel,
  source_carrier: Node
) -> Outcome<Node> {
  match target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_use_site_ownership_realizations
  ) {
    Accepted { value: optional_catalog, diagnostics: d } =>
      match optional_catalog {
        Absent =>
          outcome_rejected(
            target_use_site_ownership_lookup_miss_diagnostic(source_carrier: source_carrier)
          )
        Present { value: catalog } => Accepted { value: catalog, diagnostics: d }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_value_semantics_carriers_from_model(target: TargetModel) -> Outcome<List<Symbol>> {
  match target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_value_semantics_carriers
  ) {
    Accepted { value: optional_node, diagnostics: d } =>
      match optional_node {
        Absent => Accepted { value: Empty, diagnostics: d }
        Present { value: node } =>
          Accepted { value: target_value_semantics_carriers_from_node(node: node), diagnostics: d }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_apply_use_site_ownership_to_projected_type(
  projected: Node,
  source_carrier: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  translate_apply_use_site_ownership_to_type_shell(
    shell: projected,
    source_carrier: source_carrier,
    target: target,
    use_site: use_site
  )
}

fn translate_apply_use_site_ownership_to_projected_boundary(
  projected: Node,
  source_for_binding: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  bind_outcome(
    o: target_type_expr_emitted_wire_decode(node: projected, projection: projection),
    f: fn(wire) {
      match wire.kind {
        TargetTypeExprAtom =>
          bind_outcome(
            o: type_expr_carrier_identity(node: source_for_binding),
            f: fn(binding) {
              translate_apply_use_site_ownership_to_projected_type(
                projected: projected,
                source_carrier: translate_boundary_source_carrier_node(binding: binding),
                target: target,
                use_site: use_site
              )
            }
          )
        _ => outcome_accepted(projected)
      }
    }
  )
}

fn translate_project_arrow_input_types(
  original_inputs: List<Node>,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<List<Node>> {
  fold_list(
    xs: original_inputs,
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, original_input) {
      bind_outcome(
        o: acc,
        f: fn(items) {
          bind_outcome(
            o: translate_type_expression_project(node: original_input, target: target, projection: projection),
            f: fn(projected) {
              bind_outcome(
                o: translate_apply_use_site_ownership_to_projected_boundary(
                  projected: projected,
                  source_for_binding: original_input,
                  target: target,
                  projection: projection,
                  use_site: OwnershipAtFunctionParameter
                ),
                f: fn(wrapped) {
                  outcome_accepted(list_snoc_item(xs: items, item: wrapped))
                }
              )
            }
          )
        }
      )
    }
  )
}

fn translate_project_arrow_split_types(
  original_split: TypeExprArrowSplit,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  anchor: Node
) -> Outcome<TypeExprArrowSplit> {
  bind_outcome(
    o: translate_project_arrow_input_types(
      original_inputs: original_split.inputs,
      target: target,
      projection: projection
    ),
    f: fn(wrapped_inputs) {
      bind_outcome(
        o: translate_type_expression_project(
          node: original_split.output,
          target: target,
          projection: projection
        ),
        f: fn(projected_output) {
          bind_outcome(
            o: translate_apply_use_site_ownership_to_projected_boundary(
              projected: projected_output,
              source_for_binding: original_split.output,
              target: target,
              projection: projection,
              use_site: OwnershipAtFunctionReturn
            ),
            f: fn(wrapped_output) {
              outcome_accepted(
                TypeExprArrowSplit {
                  inputs: wrapped_inputs,
                  output: wrapped_output
                }
              )
            }
          )
        }
      )
    }
  )
}

fn translate_apply_use_site_ownership_to_type_shell(
  shell: Node,
  source_carrier: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  match translate_sg_rc_bundle_apply_disposition(
    target: target,
    source_carrier: source_carrier
  ) {
    Accepted { value: false, diagnostics: _ } => outcome_accepted(shell)
    Accepted { value: true, diagnostics: _ } =>
  bind_outcome(
    o: type_expression_projection_from_target(target: target),
    f: fn(projection) {
      bind_outcome(
        o: translate_reference_layer_tokens_from_target(target: target),
        f: fn(tokens) {
          bind_outcome(
            o: translate_use_site_ownership_catalog_from_model(
              target: target,
              source_carrier: source_carrier
            ),
            f: fn(catalog) {
              bind_outcome(
                o: translate_value_semantics_carriers_from_model(target: target),
                f: fn(value_semantics_carriers) {
                  match target_use_site_ownership_lookup_in_catalog_node(
                    catalog: catalog,
                    value_semantics_carriers: value_semantics_carriers,
                    source_carrier: source_carrier,
                    use_site: use_site
                  ) {
                    Accepted { value: ownership, diagnostics: d } =>
                      match ownership {
                        CarrierOwnershipByValue => outcome_accepted(shell)
                        CarrierOwnershipByReference { realization: row } =>
                          outcome_accepted(
                            target_reference_layer_apply_type_emitted(
                              inner: shell,
                              layer: row.reference_layer,
                              projection: projection,
                              tokens: tokens
                            )
                          )
                      }
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  }
                }
              )
            }
          )
        }
      )
    }
  )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_outcome_is_signature_realization_miss(
  diagnostics: NonEmptyDiagnostics
) -> Bool {
  diagnostics.head.reason == ^target_function_signature_realization_lookup_miss
}

fn translate_boundary_source_carrier_node(binding: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: binding } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn function_boundary_site_to_ownership_use_site(
  boundary_site: FunctionBoundarySite
) -> TargetOwnershipUseSite {
  match boundary_site {
    FunctionBoundaryParam => OwnershipAtFunctionParameter
    FunctionBoundaryReturn => OwnershipAtFunctionReturn
  }
}

fn translate_target_function_signature_realization_for_boundary(
  target: TargetModel,
  emitted: Node,
  boundary_site: FunctionBoundarySite
) -> Outcome<Optional<TargetFunctionSignatureRealization>> {
  match target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_signature_realizations
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: optional_catalog, diagnostics: _ } =>
      match optional_catalog {
        Absent => outcome_accepted(optional_absent())
        Present { value: catalog } =>
          bind_outcome(
            o: type_expr_atom_binding(node: emitted),
            f: fn(binding) {
              match target_function_signature_realization_lookup_in_catalog_node(
                catalog: catalog,
                source_carrier: translate_boundary_source_carrier_node(binding: binding),
                boundary_site: boundary_site,
                host_target_model: target
              ) {
                Accepted { value: row, diagnostics: _ } =>
                  outcome_accepted(optional_present(row))
                Rejected { diagnostics: r } =>
                  if translate_outcome_is_signature_realization_miss(diagnostics: r) {
                    outcome_accepted(optional_absent())
                  } else {
                    Rejected { diagnostics: r }
                  }
              }
            }
          )
      }
  }
}

fn serialize_type_expr_boundary_atom_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  boundary_site: FunctionBoundarySite,
  emitted: Node
) -> Outcome<String> {
  match translate_target_function_signature_realization_for_boundary(
    target: target,
    emitted: emitted,
    boundary_site: boundary_site
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: optional_row, diagnostics: _ } =>
      match optional_row {
        Present { value: row } =>
          serialize_type_expr_emitted_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            emitted: row.signature_type_form.node
          )
        Absent =>
          bind_outcome(
            o: type_expr_atom_binding(node: emitted),
            f: fn(binding) {
              bind_outcome(
                o: translate_apply_use_site_ownership_to_projected_type(
                  projected: emitted,
                  source_carrier: translate_boundary_source_carrier_node(binding: binding),
                  target: target,
                  use_site: function_boundary_site_to_ownership_use_site(
                    boundary_site: boundary_site
                  )
                ),
                f: fn(wrapped) {
                  serialize_type_expr_emitted_bounded(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    emitted: wrapped
                  )
                }
              )
            }
          )
      }
  }
}

fn serialize_type_expr_boundary_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  boundary_site: FunctionBoundarySite,
  emitted: Node
) -> Outcome<String> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else {
    bind_outcome(
      o: target_type_expr_emitted_wire_decode(node: emitted, projection: projection),
      f: fn(wire) {
        match wire.kind {
          TargetTypeExprAtom =>
            serialize_type_expr_boundary_atom_bounded(
              remaining: remaining,
              target: target,
              projection: projection,
              boundary_site: boundary_site,
              emitted: emitted
            )
          _ =>
            serialize_type_expr_emitted_wire_bounded(
              remaining: remaining,
              target: target,
              projection: projection,
              wire: wire
            )
        }
      }
    )
  }
}

fn translate_coerced_shell_base(coerced: Node, target: TargetModel) -> Outcome<Node> {
  match translate_target_atom_realization_for_carrier(
    target: target,
    source_carrier: coerced
  ) {
    Accepted { value: row, diagnostics: d } =>
      Accepted {
        value: row.type_form.node,
        diagnostics: d
      }
    Rejected { diagnostics: r } =>
      if translate_outcome_is_catalog_lookup_miss(diagnostics: r) {
        outcome_accepted(node_rebuild(n: coerced, children: []))
      } else {
        Rejected { diagnostics: r }
      }
  }
}

fn translate_coerced_shell_at_use_site(
  coerced: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  translate_coerced_shell_at_use_site_from_source(
    coerced: coerced,
    ownership_source_carrier: coerced,
    target: target,
    use_site: use_site
  )
}

fn translate_coerced_shell_at_use_site_from_source(
  coerced: Node,
  ownership_source_carrier: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  match translate_coerced_type_shell_from_source(
    source_carrier: ownership_source_carrier,
    coerced: coerced,
    target: target
  ) {
    Accepted { value: shell, diagnostics: d } =>
      bind_outcome(
        o: translate_apply_use_site_ownership_to_type_shell(
          shell: shell,
          source_carrier: ownership_source_carrier,
          target: target,
          use_site: use_site
        ),
        f: fn(wrapped) { Accepted { value: wrapped, diagnostics: d } }
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_coerced_type_shell_from_source(
  source_carrier: Node,
  coerced: Node,
  target: TargetModel
) -> Outcome<Node> {
  match source_carrier.kind {
    TypeNode { connective: Instantiation } =>
      bind_outcome(
        o: type_expression_projection_from_target(target: target),
        f: fn(projection) {
          translate_type_expression_project(
            node: source_carrier,
            target: target,
            projection: projection
          )
        }
      )
    _ => translate_coerced_shell_base(coerced: coerced, target: target)
  }
}

fn translate_coerced_shell(coerced: Node, target: TargetModel) -> Outcome<Node> {
  translate_coerced_shell_at_use_site(
    coerced: coerced,
    target: target,
    use_site: OwnershipAtBindingProjection
  )
}

fn translate_use_site_ownership_source_carrier(source: Node, coerced: Node) -> Node {
  match source.kind {
    TypeNode { connective: _ } => source
    ComputationNode { behavior: _ } => coerced
  }
}
fn target_atom_realizations_catalog_from_model(
  target: TargetModel,
  source_carrier: Node
) -> Outcome<Node> {
  match target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_atom_realizations
  ) {
    Accepted { value: optional_catalog, diagnostics: d } =>
      match optional_catalog {
        Absent =>
          outcome_rejected(
            target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier)
          )
        Present { value: catalog } =>
          Accepted { value: catalog, diagnostics: d }
      }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
fn translate_target_atom_realization_for_carrier(
  target: TargetModel,
  source_carrier: Node
) -> Outcome<TargetAtomRealization> {
  bind_outcome(
    o: target_atom_realizations_catalog_from_model(
      target: target,
      source_carrier: source_carrier
    ),
    f: fn(catalog) {
      target_atom_realization_lookup_in_catalog_node(
        catalog: catalog,
        source_carrier: source_carrier,
        host_target_model: target
      )
    }
  )
}
fn translate_shell_attach_value_expression(shell: Node, value: Node) -> Node {
  match shell.kind {
    TypeNode { connective: Conj } =>
      node_rebuild(
        n: shell,
        children: list_snoc_item(
          xs: shell.children,
          item: target_model_named_edge(
            name: ^target_model_edge_value_expression,
            target: value
          )
        )
      )
    _ => shell
  }
}
fn translate_apply_use_site_ownership_to_value_expression(
  expr: TargetValueExpression,
  source_carrier: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<TargetValueExpression> {
  match translate_sg_rc_bundle_apply_disposition(
    target: target,
    source_carrier: source_carrier
  ) {
    Accepted { value: false, diagnostics: _ } => outcome_accepted(expr)
    Accepted { value: true, diagnostics: _ } =>
      bind_outcome(
        o: translate_reference_layer_tokens_from_target(target: target),
        f: fn(tokens) {
          bind_outcome(
            o: translate_use_site_ownership_catalog_from_model(
              target: target,
              source_carrier: source_carrier
            ),
            f: fn(catalog) {
              bind_outcome(
                o: translate_value_semantics_carriers_from_model(target: target),
                f: fn(value_semantics_carriers) {
                  match target_use_site_ownership_lookup_in_catalog_node(
                    catalog: catalog,
                    value_semantics_carriers: value_semantics_carriers,
                    source_carrier: source_carrier,
                    use_site: use_site
                  ) {
                    Accepted { value: ownership, diagnostics: d } =>
                      match ownership {
                        CarrierOwnershipByValue => outcome_accepted(expr)
                        CarrierOwnershipByReference { realization: row } =>
                          outcome_accepted(
                            target_reference_layer_apply_value_expression(
                              inner: expr,
                              layer: row.reference_layer,
                              tokens: tokens
                            )
                          )
                      }
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  }
                }
              )
            }
          )
        }
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_atom_realization_value_from_source_at_use_site(
  source: Node,
  coerced: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Optional<Node>> {
  match translate_target_atom_realization_for_carrier(
    target: target,
    source_carrier: coerced
  ) {
    Accepted { value: row, diagnostics: d } =>
      match source_atom_value_for_realization_row(source: source, row: row) {
        Absent =>
          Accepted {
            value: optional_absent(),
            diagnostics: d
          }
        Present { value: atom_value } =>
          bind_outcome(
            o: target_atom_value_expression(row: row, value: atom_value),
            f: fn(expr) {
              bind_outcome(
                o: translate_apply_use_site_ownership_to_value_expression(
                  expr: expr,
                  source_carrier: coerced,
                  target: target,
                  use_site: use_site
                ),
                f: fn(wrapped) {
                  outcome_accepted(
                    optional_present(target_value_expression_node(expr: wrapped))
                  )
                }
              )
            }
          )
      }
    Rejected { diagnostics: r } =>
      if translate_outcome_is_catalog_lookup_miss(diagnostics: r) {
        outcome_accepted(optional_absent())
      } else {
        Rejected { diagnostics: r }
      }
  }
}

fn translate_coerced_with_atom_realization_at_use_site(
  source: Node,
  coerced: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite,
  pending: Diagnostics
) -> Outcome<Node> {
  let ownership_source_carrier = translate_use_site_ownership_source_carrier(
    source: source,
    coerced: coerced
  )
  match translate_coerced_shell_at_use_site_from_source(
    coerced: coerced,
    ownership_source_carrier: ownership_source_carrier,
    target: target,
    use_site: use_site
  ) {
    Accepted { value: shell, diagnostics: sd } =>
      match translate_atom_realization_value_from_source_at_use_site(
        source: source,
        coerced: coerced,
        target: target,
        use_site: use_site
      ) {
        Accepted { value: value_projection, diagnostics: vd } =>
          Accepted {
            value: match value_projection {
              Absent => shell
              Present { value: value_node } =>
                translate_shell_attach_value_expression(
                  shell: shell,
                  value: value_node
                )
            },
            diagnostics: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: sd),
              inner: vd
            )
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(
              pending: diagnostics_merge(outer: pending, inner: sd),
              rejected: r
            )
          }
      }
    Rejected { diagnostics: r } =>
      Rejected {
        diagnostics: rejected_with_pending(pending: pending, rejected: r)
      }
  }
}

fn translate_coerced_with_atom_realization(
  source: Node,
  coerced: Node,
  target: TargetModel,
  pending: Diagnostics
) -> Outcome<Node> {
  translate_coerced_with_atom_realization_at_use_site(
    source: source,
    coerced: coerced,
    target: target,
    use_site: OwnershipAtBindingProjection,
    pending: pending
  )
}

fn translate_type_fold_init(node: Node) -> Outcome<Node> {
  Accepted {
    value: node_rebuild(n: node, children: []),
    diagnostics: None
  }
}
fn translate_computation_fold_init(node: Node) -> Outcome<Node> {

  translate_type_fold_init(node: node)
}
fn translate_fold_init(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match node.kind {
    TypeNode { connective: _ } => translate_type_fold_init(node: node)
    ComputationNode { behavior: _ } => translate_computation_fold_init(node: node)
  }
}
fn translate_mvp1_coerce_from_grounding_or_evidence(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match coerce_grounded_node(source: node, tree: tree, target: target) {
    Accepted { value: coerced, diagnostics: d } =>
      translate_coerced_with_atom_realization(
        source: node,
        coerced: coerced.target,
        target: target,
        pending: d
      )
    Rejected { diagnostics: r } =>
      match canonical_grounding_for_node(tree: tree, node: node) {
        Accepted { value: grounding } =>
          if algebra_ref_is_grounded(algebra: grounding.witness.structural.evidence) {
            translate_coerced_with_atom_realization(
              source: node,
              coerced: grounding.witness.structural.evidence,
              target: target,
              pending: None
            )
          } else {

            translate_type_fold_init(node: node)
          }
        Rejected { diagnostics: _ } =>

          translate_type_fold_init(node: node)
      }
  }
}
fn translate_mvp1_fold_init(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match node.kind {
    TypeNode { connective: Arrow } =>

      if target_value_expr_arrow_has_value_expression_body(arrow: node) {
        translate_type_fold_init(node: node)
      } else {
        match coerce_grounded_node(source: node, tree: tree, target: target) {
          Accepted { value: coerced, diagnostics: d } =>
            translate_coerced_with_atom_realization(
              source: node,
              coerced: coerced.target,
              target: target,
              pending: d
            )
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
        }
      }
    TypeNode { connective: Atom { identity: _ } } =>
      translate_mvp1_coerce_from_grounding_or_evidence(
        node: node,
        tree: tree,
        target: target
      )
    TypeNode { connective: _ } =>
      match coerce_grounded_node(source: node, tree: tree, target: target) {
        Accepted { value: coerced, diagnostics: d } =>
          translate_coerced_with_atom_realization(
            source: node,
            coerced: coerced.target,
            target: target,
            pending: d
          )
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    ComputationNode { behavior: _ } => translate_computation_fold_init(node: node)
  }
}

fn translate_grammar_relation_row_match(target: TargetModel, emitted: Node) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) { grammar_relation_row_for_emitted(rules: rules, emitted: emitted) }
  )
}
fn translate_type_expression_tree(
  node: Node,
  tree: InferredTree,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  if target_value_expr_arrow_has_value_expression_body(arrow: node) {
    translate_bodied_arrow_preserve_producer_ir(arrow: node)
  } else {
    bind_outcome(
      o: fold_node(
        n: node,
        algebra: NodeFold {
          init: fn(n0) { translate_type_fold_init(node: n0) },
          step: fn(acc, e, child) { translate_fold_step(acc: acc, edge: e, child: child) }
        }
      ),
      f: fn(n) {

        match translate_grammar_relation_row_match(target: target, emitted: n) {
          Accepted { value: _, diagnostics: _ } => outcome_accepted(n)
          Rejected { diagnostics: _ } =>
            translate_type_expression_project(node: n, target: target, projection: projection)
        }
      }
    )
  }
}
fn translate_node_with_projection(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  bind_outcome(
    o: type_expression_projection_from_target(target: target),
    f: fn(projection) {
      match node.kind {
        TypeNode { connective: _ } =>
          translate_type_expression_tree(
            node: node,
            tree: tree,
            target: target,
            projection: projection
          )
        ComputationNode { behavior: _ } =>
          bind_outcome(
            o: translate_node_computation(node: node, tree: tree, target: target),
            f: fn(translated) {
              bind_outcome(
                o: translate_type_expression_subtree(
                  node: translated,
                  target: target,
                  projection: projection
                ),
                f: fn(projected) { Accepted { value: projected, diagnostics: None } }
              )
            }
          )
      }
    }
  )
}
fn translate_type_expression_subtree(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  match node.kind {
    TypeNode { connective: _ } =>
      translate_type_expression_project(node: node, target: target, projection: projection)
    ComputationNode { behavior: b } =>
      bind_outcome(
        o: translate_type_expression_children_in_node(node: node, target: target, projection: projection),
        f: fn(children) {
          Accepted {
            value: node_rebuild(n: node, children: children),
            diagnostics: None
          }
        }
      )
  }
}
fn translate_type_expression_children_in_node(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<List<Edge>> {
  fold(
    node.children,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, e) {
      bind_outcome(
        o: acc,
        f: fn(edges) {
          bind_outcome(
            o: translate_type_expression_subtree(node: e.target, target: target, projection: projection),
            f: fn(projected) {
              outcome_accepted(
                list_snoc_item(xs: edges, item: Edge { label: e.label, target: projected })
              )
            }
          )
        }
      )
    }
  )
}
fn translate_node_computation(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) { translate_fold_init(node: n0, tree: tree, target: target) },
      step: fn(acc, e, child) { translate_fold_step(acc: acc, edge: e, child: child) }
    }
  )
}
fn translate_node_mvp1_fold(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) { translate_mvp1_fold_init(node: n0, tree: tree, target: target) },
      step: fn(acc, e, child) { translate_fold_step(acc: acc, edge: e, child: child) }
    }
  )
}
fn is_dag_import_production_node(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } => id == ^dag_surface_import_decl
    Absent => false
  }
}

fn translate_import_production_qn_node(import_node: Node) -> Outcome<Node> {
  match parse_subtree_find_production_captured(
    root: import_node,
    emitted: ^dag_surface_qualified_name
  ) {
    ParseSubtreeAbsent =>
      outcome_rejected(
        translate_grammar_relation_row_not_found_diagnostic(emitted: import_node)
      )
    ParseSubtreeFound { captured: qn_capture } =>
      bind_outcome(
        o: parse_qualified_name_segments_from_capture(qn_capture: qn_capture, root: import_node),
        f: fn(segments) {
          outcome_accepted(
            value: fold_list_node(
              xs: segments,
              item_node: fn(sym) {
                Node {
                  kind: TypeNode { connective: Atom { identity: sym } },
                  children: [],
                  occurrence_id: SyntheticOccurrence
                }
              }
            )
          )
        }
      )
  }
}

fn translate_import_production_block_node(import_node: Node) -> Outcome<Node> {
  bind_outcome(
    o: parse_import_block_idents(import_decl_node: import_node, root: import_node),
    f: fn(idents) {
      outcome_accepted(
        value: Node {
          kind: TypeNode { connective: Conj },
          children: fold_list(
            xs: idents,
            empty: Empty,
            cons: fn(acc, sym) {
              list_append(
                left: acc,
                right: [
                  Edge {
                    label: Positional,
                    target: Node {
                      kind: TypeNode { connective: Atom { identity: sym } },
                      children: [],
                      occurrence_id: SyntheticOccurrence
                    }
                  }
                ]
              )
            }
          ),
          occurrence_id: SyntheticOccurrence
        }
      )
    }
  )
}

fn translate_import_production_to_carrier(import_node: Node) -> Outcome<Node> {
  bind_outcome(
    o: translate_import_production_qn_node(import_node: import_node),
    f: fn(qn_node) {
      bind_outcome(
        o: translate_import_production_block_node(import_node: import_node),
        f: fn(block_node) {
          outcome_accepted(
            value: emit_import_decl_emitted_node(
              qualified_name: qn_node,
              import_block: Present { value: block_node }
            )
          )
        }
      )
    }
  )
}

fn is_dag_import_carrier(emitted: Node) -> Bool {
  match find_named_child(root: emitted, name: ^dag_surface_import_decl) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn translate_node_mvp1(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  if target_value_expr_arrow_has_value_expression_body(arrow: node) {
    translate_bodied_arrow_preserve_producer_ir(arrow: node)
  } else if is_dag_import_production_node(node: node) {
    translate_import_production_to_carrier(import_node: node)
  } else {
    bind_outcome(
      o: fold_node(
        n: node,
        algebra: NodeFold {
          init: fn(n0) { translate_type_fold_init(node: n0) },
          step: fn(acc, e, child) { translate_fold_step(acc: acc, edge: e, child: child) }
        }
      ),
      f: fn(raw) {

        match translate_grammar_relation_row_match(target: target, emitted: raw) {
          Accepted { value: _, diagnostics: _ } => outcome_accepted(raw)
          Rejected { diagnostics: _ } =>
            translate_node_mvp1_fold(node: node, tree: tree, target: target)
        }
      }
    )
  }
}
fn translate_node(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match target_bundle_child_optional_type_expr_projection(target: target) {
    Accepted { value: ProjectionPresent, diagnostics: _ } =>
      translate_node_with_projection(node: node, tree: tree, target: target)
    Accepted { value: ProjectionAbsent, diagnostics: _ } =>
      translate_node_mvp1(node: node, tree: tree, target: target)
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}

type TypeExprProjectionPresence
  = ProjectionPresent
  | ProjectionAbsent
fn target_bundle_child_optional_type_expr_projection(
  target: TargetModel
) -> Outcome<TypeExprProjectionPresence> {
  match target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_type_expression_projection
  ) {
    Accepted { value: Present { value: _ }, diagnostics: d } =>
      Accepted { value: ProjectionPresent, diagnostics: d }
    Accepted { value: Absent, diagnostics: d } =>
      Accepted { value: ProjectionAbsent, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
fn translate_fold_step(
  acc: Outcome<Node>,
  edge: Edge,
  child: Outcome<Node>
) -> Outcome<Node> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: parent, diagnostics: ad } =>
      match child {
        Accepted { value: translated_child, diagnostics: cd } =>
          Accepted {
            value: node_rebuild(
              n: parent,
              children: list_snoc_item(
                xs: parent.children,
                item: Edge { label: edge.label, target: translated_child }
              )
            ),
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: r)
          }
      }
  }
}
fn translate(
  tree: InferredTree,
  target: TargetModel
) -> Outcome<TargetNodeTree> {
  translate_node(node: tree.root, tree: tree, target: target)
}

fn translate_emitted_node(tree: InferredTree, target: TargetModel) -> Outcome<Node> {
  bind_outcome(
    o: translate(tree: tree, target: target),
    f: fn(emitted) {
      outcome_accepted(emitted)
    }
  )
}

type TranslateDiagnosticReason
  = TargetBundleMalformed
  | TargetBundleDuplicateEdge
  | SgRcBundlePartial
  | GrammarInverseNotRealized
  | GrammarRelationRowNotFound
  | ConjInvalidEdge
  | ConjNamedChildMissing
  | ConcreteTokenClassMissing
  | ConcreteTokenKindInvalid
  | SerializeRecursionLimitExhausted
  | LexRuleLiteralNotFound
  | BindingSpellingNotFound
  | TypeExpressionShapeMissing
  | TypeExprKindAuthorityInvalid
  | TargetAtomRealizationLookupMiss
  | TargetFunctionSignatureRealizationLookupMiss
  | TargetTypeExprEmittedShapeMalformed

fn translate_diagnostic_reason_variants() -> List<TranslateDiagnosticReason> {
  [
    TargetBundleMalformed,
    TargetBundleDuplicateEdge,
    SgRcBundlePartial,
    GrammarInverseNotRealized,
    GrammarRelationRowNotFound,
    ConjInvalidEdge,
    ConjNamedChildMissing,
    ConcreteTokenClassMissing,
    ConcreteTokenKindInvalid,
    SerializeRecursionLimitExhausted,
    LexRuleLiteralNotFound,
    BindingSpellingNotFound,
    TypeExpressionShapeMissing,
    TypeExprKindAuthorityInvalid,
    TargetAtomRealizationLookupMiss,
    TargetFunctionSignatureRealizationLookupMiss,
    TargetTypeExprEmittedShapeMalformed
  ]
}

fn translate_diagnostic_reason_symbol(reason: TranslateDiagnosticReason) -> Symbol {
  match reason {
    TargetBundleMalformed => ^translate_target_bundle_malformed
    TargetBundleDuplicateEdge => ^translate_target_bundle_duplicate_edge
    SgRcBundlePartial => ^translate_sg_rc_bundle_partial
    GrammarInverseNotRealized => ^translate_grammar_inverse_not_realized
    GrammarRelationRowNotFound => ^translate_grammar_relation_row_not_found
    ConjInvalidEdge => ^translate_conj_invalid_edge
    ConjNamedChildMissing => ^translate_conj_named_child_missing
    ConcreteTokenClassMissing => ^translate_concrete_token_class_missing
    ConcreteTokenKindInvalid => ^translate_concrete_token_kind_invalid
    SerializeRecursionLimitExhausted => ^translate_serialize_recursion_limit_exhausted
    LexRuleLiteralNotFound => ^translate_lex_rule_literal_not_found
    BindingSpellingNotFound => ^translate_binding_spelling_not_found
    TypeExpressionShapeMissing => ^translate_type_expression_shape_missing
    TypeExprKindAuthorityInvalid => ^translate_type_expr_kind_authority_invalid
    TargetAtomRealizationLookupMiss => ^target_atom_realization_lookup_miss
    TargetFunctionSignatureRealizationLookupMiss => ^target_function_signature_realization_lookup_miss
    TargetTypeExprEmittedShapeMalformed => ^target_type_expr_emitted_shape_malformed
  }
}

fn translate_diagnostic_reason_from_symbol_go(
  sym: Symbol,
  variants: List<TranslateDiagnosticReason>
) -> Optional<TranslateDiagnosticReason> {
  fold(variants, init: optional_absent(), f: fn(acc, variant) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if sym == translate_diagnostic_reason_symbol(reason: variant) {
          optional_present(value: variant)
        } else {
          acc
        }
    }
  })
}

fn translate_diagnostic_reason_from_symbol(sym: Symbol) -> Optional<TranslateDiagnosticReason> {
  translate_diagnostic_reason_from_symbol_go(
    sym: sym,
    variants: translate_diagnostic_reason_variants()
  )
}

fn translate_diagnostic_reason_roster() -> List<Symbol> {
  fold(translate_diagnostic_reason_variants(), init: Empty, f: fn(acc, variant) {
    list_snoc_item(
      xs: acc,
      item: translate_diagnostic_reason_symbol(reason: variant)
    )
  })
}

fn translate_diagnostic_reason_head(
  diagnostics: NonEmptyDiagnostics
) -> Optional<TranslateDiagnosticReason> {
  translate_diagnostic_reason_from_symbol(sym: diagnostics.head.reason)
}
