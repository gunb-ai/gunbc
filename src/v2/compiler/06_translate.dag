fn grammar_relation_row_emitted(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  conj_named_child(parent: row, edge_name: ^grammar_relation_field_emitted)
}
fn grammar_relation_row_tokens_root(row: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  conj_named_child(parent: row, edge_name: ^grammar_relation_field_tokens)
}
fn grammar_relation_row_for_emitted(rules: v2.std.node.Node, emitted: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.grammar.grammar_relation_row_reverse_parse_selection(rules: rules, emitted: emitted) {
    Accepted { value: row, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: row, diagnostics: d }
    Rejected { diagnostics: r } =>
      if r.head.reason == ^grammar_relation_row_backward_selection_ambiguous {
        v2.std.diagnostic.Rejected { diagnostics: r }
      } else {
        v2.std.diagnostic.outcome_rejected(translate_grammar_relation_row_not_found_diagnostic(emitted: emitted))
      }
  }
}

fn grammar_relation_row_with_bodied_scaffold(rules: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match rules.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      match fold(
        rules.children,
        init: v2.std.diagnostic.Rejected {
          diagnostics: v2.std.diagnostic.diagnostics_singleton(
            d: translate_grammar_relation_row_not_found_diagnostic(
              emitted: rules
            )
          )
        },
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } =>
              match e.label {
                Named { name: _ } =>
                  match v2.std.node_query.find_named_child(
                    root: e.target,
                    name: ^grammar_relation_field_bodied_scaffold
                  ) {
                    Accepted { value: _, diagnostics: _ } =>
                      v2.std.diagnostic.outcome_rejected(
                        translate_grammar_inverse_not_realized_diagnostic(emitted: rules)
                      )
                    Rejected { diagnostics: _ } => acc
                  }
                Positional => acc
              }
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: _ } =>
                  match v2.std.node_query.find_named_child(
                    root: e.target,
                    name: ^grammar_relation_field_bodied_scaffold
                  ) {
                    Accepted { value: _, diagnostics: d } =>
                      v2.std.diagnostic.Accepted { value: e.target, diagnostics: d }
                    Rejected { diagnostics: _ } => acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        Accepted { value: row, diagnostics: d } =>
          v2.std.diagnostic.Accepted { value: row, diagnostics: d }
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: rules))
  }
}

fn grammar_relation_row_for_bodied_arrow_serialize(
  rules: v2.std.node.Node,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold> {
  v2.std.diagnostic.bind_outcome(
    o: grammar_relation_row_with_bodied_scaffold(rules: rules),
    f: fn(row) {
      v2.std.compilers.target_model.bodied_arrow_scaffold_from_grammar_relation_row(row: row)
    }
  )
}

fn grammar_inverse_bodied_arrow_validated(
  target: v2.std.compilers.target_model.TargetModel,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      v2.std.diagnostic.bind_outcome(
        o: grammar_relation_row_for_bodied_arrow_serialize(rules: rules, emitted: emitted),
        f: fn(_) {
          v2.std.diagnostic.outcome_accepted(emitted)
        }
      )
    }
  )
}

fn translate_bodied_arrow_preserve_producer_ir(arrow: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.outcome_accepted(arrow)
}
fn conj_positional_targets(parent: v2.std.node.Node) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.node.Node>> {
  match parent.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      v2.std.diagnostic.Accepted {
        value: v2.std.node_query.node_positional_child_targets(node: parent),
        diagnostics: v2.std.diagnostic.None
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: parent)
      )
  }
}
fn optional_named_child_ignoring_positional(parent: v2.std.node.Node, edge_name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node?> {

  match parent.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          match acc {
            BundleChildInvalidEdge => acc
            BundleChildDuplicate => acc
            BundleChildMissing =>
              match e.label {
                Named { name: n } =>
                  if n == edge_name {
                    BundleChildFound { value: e.target }
                  } else {
                    acc
                  }
                Positional => acc
              }
            BundleChildFound { value: _ } =>
              match e.label {
                Named { name: n } =>
                  if n == edge_name {
                    BundleChildDuplicate
                  } else {
                    acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        BundleChildFound { value: child } =>
          v2.std.diagnostic.Accepted { value: v2.std.optional.Present { value: child }, diagnostics: v2.std.diagnostic.None }
        BundleChildMissing =>
          v2.std.diagnostic.Accepted { value: v2.std.optional.Absent, diagnostics: v2.std.diagnostic.None }
        BundleChildDuplicate =>
          v2.std.diagnostic.outcome_rejected(
            v2.std.diagnostic.Diagnostic {
              reason: ^translate_target_bundle_duplicate_edge,
              at: v2.std.diagnostic.node_locus(node: parent),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          v2.std.diagnostic.outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      v2.std.diagnostic.Accepted { value: v2.std.optional.Absent, diagnostics: v2.std.diagnostic.None }
  }
}
fn concrete_token_class_child(parent: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node?> {
  optional_named_child_ignoring_positional(
    parent: parent,
    edge_name: ^concrete_syntax_token_field_class
  )
}
fn concrete_token_kind_child(parent: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node?> {
  optional_named_child_ignoring_positional(
    parent: parent,
    edge_name: ^concrete_syntax_token_field_kind
  )
}
fn token_sequence_item_kind(item: v2.std.node.Node) -> v2.std.diagnostic.Outcome<TokenSequenceItemKind> {
  v2.std.diagnostic.bind_outcome(
    o: concrete_token_class_child(parent: item),
    f: fn(class_node) {
      v2.std.diagnostic.bind_outcome(
        o: concrete_token_kind_child(parent: item),
        f: fn(kind_node) {
          match class_node {
            Present { value: _ } =>
              match kind_node {
                Present { value: _ } =>

                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.concrete_syntax_token_from_node(token: item),
                    f: fn(_) {
                      v2.std.diagnostic.Accepted { value: TokenSequenceConcreteToken, diagnostics: v2.std.diagnostic.None }
                    }
                  )
                Absent =>
                  v2.std.diagnostic.outcome_rejected(
                    translate_concrete_token_kind_invalid_diagnostic(token: item)
                  )
              }
            Absent =>
              match kind_node {
                Present { value: _ } =>
                  v2.std.diagnostic.outcome_rejected(
                    translate_concrete_token_class_missing_diagnostic(token: item)
                  )
                Absent =>
                  v2.std.diagnostic.Accepted { value: TokenSequenceNonterminal, diagnostics: v2.std.diagnostic.None }
              }
          }
        }
      )
    }
  )
}

fn serialize_source_tokens_fold_child(serialize_source: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Node> {
  fold(
    serialize_source.children,
    init: v2.std.optional.optional_absent(),
    f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match e.label {
            Named { name: n } =>
              if n == ^grammar_relation_field_tokens { v2.std.optional.optional_present(value: e.target) } else { acc }
            Positional => acc
          }
      }
    }
  )
}

fn serialize_source_fold_list_targets(remaining: Int, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.node.Node>> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
  } else {
    match node.kind {
      TypeNode { connective: v2.std.node.Conj } =>
        if v2.std.algebra.is_empty(xs: node.children) {
          v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None }
        } else {
          v2.std.diagnostic.bind_outcome(
            o: conj_named_child(parent: node, edge_name: ^fold_list_node_head),
            f: fn(head) {
              v2.std.diagnostic.bind_outcome(
                o: conj_named_child(parent: node, edge_name: ^fold_list_node_tail),
                f: fn(tail) {
                  v2.std.diagnostic.bind_outcome(
                    o: serialize_source_fold_list_targets(remaining: remaining - 1, node: tail),
                    f: fn(rest) {
                      v2.std.diagnostic.Accepted { value: std.algebra.Cons { head: head, tail: rest }, diagnostics: v2.std.diagnostic.None }
                    }
                  )
                }
              )
            }
          )
        }
      _ => v2.std.diagnostic.outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
    }
  }
}

fn serialize_source_token_targets(serialize_source: v2.std.node.Node) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.node.Node>> {
  match serialize_source_tokens_fold_child(serialize_source: serialize_source) {
    Present { value: tokens_fold } =>
      serialize_source_fold_list_targets(
        remaining: v2.std.node.node_subtree_count(n: tokens_fold),
        node: tokens_fold
      )
    Absent =>
      conj_positional_targets(parent: serialize_source)
  }
}

fn grammar_tokens_node_targets(tokens_node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.node.Node>> {
  v2.std.diagnostic.bind_outcome(
    o: optional_named_child_ignoring_positional(
      parent: tokens_node,
      edge_name: ^fold_list_node_head
    ),
    f: fn(maybe_head) {
      match maybe_head {
        Present { value: _ } =>
          serialize_source_fold_list_targets(
            remaining: v2.std.node.node_subtree_count(n: tokens_node),
            node: tokens_node
          )
        Absent =>
          conj_positional_targets(parent: tokens_node)
      }
    }
  )
}
fn grammar_serialize_source_matches_row(
  serialize_source: v2.std.node.Node,
  row: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if v2.std.node.well_formed(n: serialize_source) {
    v2.std.diagnostic.bind_outcome(
      o: grammar_relation_row_tokens_root(row: row),
      f: fn(tokens_root) {
        v2.std.diagnostic.bind_outcome(
          o: serialize_source_token_targets(serialize_source: serialize_source),
          f: fn(source_targets) {
            v2.std.diagnostic.bind_outcome(
              o: grammar_tokens_node_targets(tokens_node: tokens_root),
              f: fn(row_targets) {
                if v2.std.algebra.zip_eq(a: source_targets, b: row_targets, eq: fn(x, y) { x == y }) {
                  v2.std.diagnostic.Accepted { value: serialize_source, diagnostics: v2.std.diagnostic.None }
                } else {
                  v2.std.diagnostic.outcome_rejected(
                    translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
                  )
                }
              }
            )
          }
        )
      }
    )
  } else {
    v2.std.diagnostic.outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
    )
  }
}
fn grammar_inverse_source_validated(
  target: v2.std.compilers.target_model.TargetModel,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      v2.std.diagnostic.bind_outcome(
        o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
        f: fn(row) {
          v2.std.diagnostic.bind_outcome(
            o: target_bundle_child(target: target, edge_name: ^target_model_edge_serialize_source),
            f: fn(serialize_source) {
              grammar_serialize_source_matches_row(
                serialize_source: serialize_source,
                row: row
              )
            }
          )
        }
      )
    }
  )
}
fn serialize_concrete_syntax_tokens_to_source(
  target: v2.std.compilers.target_model.TargetModel,
  tokens: std.types.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: serialize_concrete_syntax_tokens_to_source_string(target: target, tokens: tokens),
    f: fn(carrier) {
      v2.compiler.target_carriers.target_source_medium(text: v2.std.compilers.target_model.render_target_text(t: carrier), target: target)
    }
  )
}
fn serialize_concrete_syntax_tokens_to_source_string(
  target: v2.std.compilers.target_model.TargetModel,
  tokens: std.types.List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.compilers.target_model.bound_tokens_source_text(
    tokens: tokens,
    lex: target.lex,
    binding_spellings: target.binding_spellings
  )
}

fn translate_project_transform_in_arrow_scope(
  arrow: v2.std.node.Node,
  body: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.target_transform_surface_op_atom(node: body),
    f: fn(op_sym) {
      match v2.extdeps.languages.dag.dag_surface_operator_canonicalization_member(surface_token: op_sym) {
        Accepted { value: canonical_op, diagnostics: _ } =>
          v2.std.compilers.target_model.target_project_transform_primitive_apply_in_arrow_scope(
            arrow: arrow,
            body: body,
            canonical_op: canonical_op,
            target: target
          )

        Rejected { diagnostics: _ } =>
          v2.std.compilers.target_model.target_project_transform_callable_apply_in_arrow_scope(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: v2.extdeps.languages.dag.dag_value_expression_projection().bool_literal_form,
            handle_transform: fn(a, b, t) {
              translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t)
            }
          )
      }
    }
  )
}

fn target_serialize_bodied_arrow_from_model(
  target: v2.std.compilers.target_model.TargetModel,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      v2.std.diagnostic.bind_outcome(
        o: grammar_relation_row_for_bodied_arrow_serialize(rules: rules, emitted: emitted),
        f: fn(scaffold) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.target_value_expression_projection_from_target(target: target),
            f: fn(projection) {
              v2.std.diagnostic.bind_outcome(
                o: v2.std.compilers.target_model.target_project_arrow_body_to_value_expression(
                  arrow: emitted,
                  target: target,
                  source_bool_form: v2.extdeps.languages.dag.dag_value_expression_projection().bool_literal_form,
                  handle_transform: fn(a, b, t) {
                    translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t)
                  }
                ),
                f: fn(expr) {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.target_value_expression_tokens_from_target(
                      expr: expr,
                      target: target,
                      projection: projection
                    ),
                    f: fn(body_tokens) {
                      serialize_concrete_syntax_tokens_to_source_string(
                        target: target,
                        tokens: v2.std.compilers.target_model.target_bodied_arrow_compose_statement_tokens(
                          scaffold: scaffold,
                          body: body_tokens
                        )
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_serialize_relation_row_from_model_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else if v2.std.compilers.target_model.target_value_expr_arrow_has_value_expression_body(arrow: emitted) {
    target_serialize_bodied_arrow_from_model(target: target, emitted: emitted)
  } else {
    v2.std.diagnostic.bind_outcome(
      o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
      f: fn(rules) {
        v2.std.diagnostic.bind_outcome(
          o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
          f: fn(row) {
            v2.std.diagnostic.bind_outcome(
              o: grammar_relation_row_tokens_root(row: row),
              f: fn(tokens_root) {
                v2.std.diagnostic.bind_outcome(
                  o: grammar_tokens_node_targets(tokens_node: tokens_root),
                  f: fn(tokens) {
                    v2.std.algebra.fold_list(
                      xs: tokens,
                      empty: v2.std.diagnostic.Accepted { value: v2.std.compilers.target_model.target_text_empty, diagnostics: v2.std.diagnostic.None },
                      cons: fn(acc, token_node) {
                        match acc {
                          Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                          Accepted { value: partial, diagnostics: ad } =>
                            match token_sequence_item_kind(item: token_node) {
                              Accepted { value: TokenSequenceConcreteToken, diagnostics: kd } =>
                                match v2.std.compilers.target_model.token_spelling_from_model(target: target, token: token_node) {
                                  Accepted { value: source, diagnostics: td } =>
                                    v2.std.diagnostic.Accepted {
                                      value: v2.std.compilers.target_model.target_text_seq(acc: partial, next: v2.std.compilers.target_model.text_atom(lexeme: source)),
                                      diagnostics: v2.std.diagnostic.diagnostics_merge(
                                        outer: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: kd),
                                        inner: td
                                      )
                                    }
                                  Rejected { diagnostics: r } =>
                                    v2.std.diagnostic.Rejected {
                                      diagnostics: v2.std.diagnostic.rejected_with_pending(
                                        pending: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: kd),
                                        rejected: r
                                      )
                                    }
                                }
                              Accepted { value: TokenSequenceNonterminal, diagnostics: kd } =>
                                match target_serialize_relation_row_from_model_bounded(
                                  remaining - 1,
                                  target,
                                  token_node
                                ) {
                                  Accepted { value: source, diagnostics: td } =>
                                    v2.std.diagnostic.Accepted {
                                      value: v2.std.compilers.target_model.target_text_seq(acc: partial, next: source),
                                      diagnostics: v2.std.diagnostic.diagnostics_merge(
                                        outer: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: kd),
                                        inner: td
                                      )
                                    }
                                  Rejected { diagnostics: r } =>
                                    v2.std.diagnostic.Rejected {
                                      diagnostics: v2.std.diagnostic.rejected_with_pending(
                                        pending: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: kd),
                                        rejected: r
                                      )
                                    }
                                }
                              Rejected { diagnostics: r } =>
                                v2.std.diagnostic.Rejected {
                                  diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
                                }
                            }
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}
fn translate_lex_rule_literal_not_found_diagnostic(token_class: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_lex_rule_literal_not_found,
    at: v2.std.diagnostic.node_locus(node: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: token_class } },
      children: [],
      occurrence_id: v2.std.node.SyntheticOccurrence
}),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
fn translate_binding_spelling_not_found_diagnostic(binding: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_binding_spelling_not_found,
    at: v2.std.diagnostic.node_locus(node: v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: binding } },
      children: [],
      occurrence_id: v2.std.node.SyntheticOccurrence
}),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
fn node_atom_identity(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match node.kind {
    TypeNode { connective: v2.std.node.Atom { identity: id } } =>
      v2.std.diagnostic.Accepted { value: id, diagnostics: v2.std.diagnostic.None }
    _ =>
      v2.std.diagnostic.outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
  }
}
fn token_item_to_source_bounded(
  remaining: Int,
  item: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: token_sequence_item_kind(item: item),
    f: fn(item_kind) {
      match item_kind {
        TokenSequenceConcreteToken =>
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.token_spelling_from_model(target: target, token: item),
            f: fn(spelling) {
              v2.std.diagnostic.outcome_accepted(v2.std.compilers.target_model.text_atom(lexeme: spelling))
            }
          )
        TokenSequenceNonterminal =>
          target_serialize_relation_row_from_model_bounded(remaining - 1, target, item)
      }
    }
  )
}
fn token_item_to_source(item: v2.std.node.Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: token_item_serialize_measure(item: item, target: target),
    f: fn(measure) {
      token_item_to_source_bounded(measure, item, target)
    }
  )
}
fn token_sequence_to_source_bounded(
  remaining: Int,
  tokens: std.types.List<v2.std.node.Node>,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.algebra.fold_list(
    xs: tokens,
    empty: v2.std.diagnostic.Accepted { value: v2.std.compilers.target_model.target_text_empty, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, token_node) {
      match acc {
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        Accepted { value: partial, diagnostics: ad } =>
          match token_item_to_source_bounded(remaining - 1, token_node, target) {
            Accepted { value: source, diagnostics: td } =>
              v2.std.diagnostic.Accepted {
                value: v2.std.compilers.target_model.target_text_seq(acc: partial, next: source),
                diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: td)
              }
            Rejected { diagnostics: r } =>
              v2.std.diagnostic.Rejected {
                diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
              }
          }
      }
    }
  )
}
fn token_sequence_to_source(tokens: std.types.List<v2.std.node.Node>, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: token_sequence_serialize_measure(tokens: tokens, target: target),
    f: fn(measure) {
      token_sequence_to_source_bounded(measure, tokens, target)
    }
  )
}

fn target_serialize_source_from_model_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else if v2.std.compilers.target_model.target_value_expr_arrow_has_value_expression_body(arrow: emitted) {
    target_serialize_bodied_arrow_from_model(target: target, emitted: emitted)
  } else if is_dag_import_carrier(emitted: emitted) {
    v2.std.diagnostic.bind_outcome(
      o: v2.std.compilers.target_model.module_import_projection_from_target(target: target),
      f: fn(projection) {
        v2.std.diagnostic.bind_outcome(
          o: v2.std.compilers.target_model.import_value_from_carrier(carrier: emitted),
          f: fn(import_value) {
            v2.std.diagnostic.bind_outcome(
              o: v2.std.compilers.target_model.target_import_to_concrete_tokens(
                import_value: import_value,
                projection: projection
              ),
              f: fn(tokens) {
                serialize_concrete_syntax_tokens_to_source_string(
                  target: target,
                  tokens: tokens
                )
              }
            )
          }
        )
      }
    )
  } else {
    match v2.std.compilers.target_model.target_type_expr_emitted_kind(node: emitted) {
      TypeExprKindAuthority { value: _ } =>
        v2.std.diagnostic.bind_outcome(
          o: v2.std.compilers.target_model.type_expression_projection_from_target(target: target),
          f: fn(projection) {
            serialize_type_expr_emitted_bounded(
              remaining: remaining - 1,
              target: target,
              projection: projection,
              emitted: emitted
            )
          }
        )
      TypeExprKindNotEmitted =>
        v2.std.diagnostic.bind_outcome(
          o: grammar_inverse_source_validated(target: target, emitted: emitted),
          f: fn(_) {
            target_serialize_relation_row_from_model_bounded(remaining - 1, target, emitted)
          }
        )
      TypeExprKindAuthorityInvalid =>
        v2.std.diagnostic.outcome_rejected(
          translate_type_expr_kind_authority_invalid_diagnostic(node: emitted)
        )
    }
  }
}
fn target_serialize_source_from_model(
  target: v2.std.compilers.target_model.TargetModel,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: translate_serialize_measure(target: target, emitted: emitted),
    f: fn(measure) {
      v2.std.diagnostic.bind_outcome(
        o: target_serialize_source_from_model_bounded(measure, target, emitted),
        f: fn(text) {
          v2.compiler.target_carriers.target_source_medium(text: v2.std.compilers.target_model.render_target_text(t: text), target: target)
        }
      )
    }
  )
}
fn target_bundle_child(target: v2.std.compilers.target_model.TargetModel, edge_name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match target.bundle.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      match fold(
        target.bundle.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          v2.std.diagnostic.Accepted { value: child, diagnostics: v2.std.diagnostic.None }
        BundleChildMissing =>
          v2.std.diagnostic.outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
        BundleChildDuplicate =>
          v2.std.diagnostic.outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
        BundleChildInvalidEdge =>
          v2.std.diagnostic.outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_bundle_optional_child(target: v2.std.compilers.target_model.TargetModel, edge_name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node?> {
  match target.bundle.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      match fold(
        target.bundle.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          v2.std.diagnostic.Accepted { value: v2.std.optional.Present { value: child }, diagnostics: v2.std.diagnostic.None }
        BundleChildMissing =>
          v2.std.diagnostic.Accepted { value: v2.std.optional.Absent, diagnostics: v2.std.diagnostic.None }
        BundleChildDuplicate =>
          v2.std.diagnostic.outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
        BundleChildInvalidEdge =>
          v2.std.diagnostic.outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_selection_priority_from_model(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_selection_policy),
    f: fn(priority_node) {
      v2.std.diagnostic.Accepted {
        value: priority_node,
        diagnostics: v2.std.diagnostic.None
      }
    }
  )
}
fn coercion_candidates_from_target_model(
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.coercion.CoercionCandidateSet> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_declared_inhabitants),
    f: fn(inhabitants_root) {
      v2.std.coercion.coercion_candidate_set_from_declared_inhabitants(
        inhabitants_root: inhabitants_root,
        closedness_property: ^target_model_edge_declared_inhabitants
      )
    }
  )
}
fn coerce_grounded_node(
  source: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.coercion.CoercionResult> {
  match v2.std.coercion.coercion_identity_from_target_model(source: source, target: target) {
    Accepted { value: identity, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: identity, diagnostics: d }
    Rejected { diagnostics: _ } =>
      v2.std.diagnostic.bind_outcome(
        o: target_selection_priority_from_model(target: target),
        f: fn(priority) {
          v2.std.diagnostic.bind_outcome(
            o: coercion_candidates_from_target_model(target: target),
            f: fn(candidates) {
              v2.std.diagnostic.bind_outcome(
                o: v2.compiler.infer.canonical_grounding_for_node(tree: tree, node: source),
                f: fn(grounding) {
                  v2.std.coercion.coercion_fold_with_declared_priority(
                    source: grounding,
                    candidates: candidates,
                    priority: priority
                  )
                }
              )
            }
          )
        }
      )
  }
}
fn translate_type_expression_shape_missing_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_type_expression_shape_missing,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
fn translate_type_expr_kind_authority_invalid_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_type_expr_kind_authority_invalid,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
fn target_collection_choice_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetRepresentationChoice> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.node_query.find_named_child(root: node, name: ^target_collection_choice_field_form),
    f: fn(form_node) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.target_collection_repr_from_node(node: form_node),
        f: fn(form) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.node_query.find_named_child(
              root: node,
              name: ^target_collection_choice_field_representation_parameters
            ),
            f: fn(representation_parameters_node) {
              v2.std.diagnostic.bind_outcome(
                o: v2.std.compilers.target_model.target_representation_parameter_slots_from_node(
                  node: representation_parameters_node
                ),
                f: fn(representation_parameters) {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.node_query.find_named_child(root: node, name: ^target_collection_choice_field_constraints),
                    f: fn(constraints_node) {
                      v2.std.diagnostic.bind_outcome(
                        o: v2.std.fold_assembly.node_list_from_node(
                          node: constraints_node,
                          decode_item: target_capability_requirement_from_node
                        ),
                        f: fn(constraints) {
                          v2.std.diagnostic.bind_outcome(
                            o: v2.std.node_query.find_named_child(
                              root: node,
                              name: ^target_collection_choice_field_supplemental_generic_bound_contracts
                            ),
                            f: fn(contracts_node) {
                              v2.std.diagnostic.bind_outcome(
                                o: v2.std.compilers.target_model.target_derive_supplemental_generic_bound_contract_catalog_from_node(
                                  representation_parameters: representation_parameters,
                                  node: contracts_node,
                                  at: node
                                ),
                                f: fn(supplemental_catalog) {
                                  v2.std.diagnostic.outcome_accepted(
                                    v2.std.compilers.target_model.TargetRepresentationChoice {
                                      form: form,
                                      representation_parameters: supplemental_catalog.representation_parameters,
                                      constraints: constraints,
                                      supplemental_generic_bound_contracts: supplemental_catalog.contracts
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_text_carrier_from_node(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetTextCarrier> {
  v2.std.diagnostic.bind_outcome(
    o: conj_named_child(parent: node, edge_name: ^target_text_carrier_field_element),
    f: fn(element_carrier) {
      v2.std.diagnostic.bind_outcome(
        o: conj_named_child(parent: node, edge_name: ^target_text_carrier_field_emitted),
        f: fn(emitted) {
          v2.std.diagnostic.Accepted {
            value: v2.std.compilers.target_model.TargetTextCarrier { element_carrier: element_carrier, emitted_type_node: emitted },
            diagnostics: v2.std.diagnostic.None
          }
        }
      )
    }
  )
}

fn target_text_carrier_optional_from_bundle(bundle: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.compilers.target_model.TargetTextCarrier>> {
  v2.std.diagnostic.bind_outcome(
    o: conj_optional_named_child(parent: bundle, edge_name: ^target_collection_row_field_text_carrier),
    f: fn(opt) {
      match opt {
        Present { value: node } =>
          v2.std.diagnostic.bind_outcome(
            o: target_text_carrier_from_node(node: node),
            f: fn(tc) { v2.std.diagnostic.Accepted { value: v2.std.optional.optional_present(value: tc), diagnostics: v2.std.diagnostic.None } }
          )
        Absent => v2.std.diagnostic.Accepted { value: v2.std.optional.optional_absent(), diagnostics: v2.std.diagnostic.None }
      }
    }
  )
}

fn target_collection_realization_from_bundle(
  bundle: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetCollectionRealization> {
  v2.std.diagnostic.bind_outcome(
    o: conj_named_child(parent: bundle, edge_name: ^target_collection_row_field_source_carrier),
    f: fn(source_carrier) {
      v2.std.diagnostic.bind_outcome(
        o: conj_named_child(parent: bundle, edge_name: ^target_collection_row_field_primary),
        f: fn(primary_node) {
          v2.std.diagnostic.bind_outcome(
            o: target_collection_choice_from_node(node: primary_node),
            f: fn(primary) {
              v2.std.diagnostic.bind_outcome(
                o: conj_named_child(parent: bundle, edge_name: ^target_collection_row_field_alternatives),
                f: fn(alternatives_node) {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.fold_assembly.node_list_from_node(
                      node: alternatives_node,
                      decode_item: target_collection_choice_from_node
                    ),
                    f: fn(alternatives) {
                      v2.std.diagnostic.bind_outcome(
                        o: conj_named_child(parent: bundle, edge_name: ^target_collection_row_field_fallback),
                        f: fn(fallback_node) {
                          v2.std.diagnostic.bind_outcome(
                            o: v2.std.compilers.target_model.target_collection_fallback_from_node(node: fallback_node),
                            f: fn(fallback_diagnostic) {
                              v2.std.diagnostic.bind_outcome(
                                o: target_text_carrier_optional_from_bundle(bundle: bundle),
                                f: fn(text_carrier) {
                                  bind_outcome(
                                    o: conj_named_child(
                                      parent: bundle,
                                      edge_name: ^target_collection_row_field_capability_eligibility
                                    ),
                                    f: fn(eligibility_node) {
                                      bind_outcome(
                                        o: target_capability_eligibility_from_node(
                                          node: eligibility_node
                                        ),
                                        f: fn(capability_eligibility) {
                                          Accepted {
                                            value: v2.std.compilers.target_model.TargetCollectionRealization {
                                              source_carrier: source_carrier,
                                              primary: primary,
                                              alternatives: alternatives,
                                              fallback_diagnostic: fallback_diagnostic,
                                              text_carrier: text_carrier,
                                              capability_eligibility: capability_eligibility
                                            },
                                            diagnostics: v2.std.diagnostic.None
                                          }
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn collection_realization_from_target(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetCollectionRealization> {
  collection_realization_from_target_carrier(
    target: target,
    expected_source_carrier: target_collection_set_carrier_node()
  )
}

fn free_monoid_collection_realization_from_target(
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetCollectionRealization> {
  collection_realization_from_target_carrier(
    target: target,
    expected_source_carrier: v2.std.compilers.target_model.target_carrier_free_monoid_node()
  )
}

fn collection_realization_from_target_carrier(
  target: v2.std.compilers.target_model.TargetModel,
  expected_source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetCollectionRealization> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_collection_realization),
    f: fn(catalog_node) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.fold_assembly.node_list_from_node(
          node: catalog_node,
          decode_item: fn(row_node) {
            target_collection_realization_from_bundle(bundle: row_node)
          }
        ),
        f: fn(rows) {
          v2.std.compilers.target_model.target_collection_realization_lookup_in_catalog(
            catalog: rows,
            source_carrier: expected_source_carrier
          )
        }
      )
    }
  )
}

fn project_set_collection_type_node(
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.compilers.target_model.target_collection_set_element_type_node(set_node: node) {
    Present { value: elem } =>
      v2.std.diagnostic.bind_outcome(
        o: collection_realization_from_target(target: target),
        f: fn(row) {
          bind_outcome(
            o: target_collection_select_choice(
              eligibility_table: row.capability_eligibility,
              primary: row.primary,
              alternatives: row.alternatives,
              elem: elem
            ),
            f: fn(selected) {
          match selected {
            Present { value: choice } =>
              v2.std.diagnostic.bind_outcome(
                o: translate_type_expression_project(node: elem, target: target, projection: projection),
                f: fn(elem_projected) {
                  v2.std.diagnostic.Accepted {
                    value: v2.std.compilers.target_model.target_type_expr_instantiation_emitted(
                      form: projection.instantiation_form,
                      head: v2.std.compilers.target_model.target_type_expr_atom_emitted(
                        form: projection.atom_form,
                        identity: choice.form.apply.surface
                      ),
                      args: std.algebra.Cons { head: elem_projected, tail: std.algebra.Empty }
                    ),
                    diagnostics: v2.std.diagnostic.None
                  }
                }
              )
            Absent => v2.std.diagnostic.outcome_rejected(row.fallback_diagnostic)
          }
            }
          )
        }
      )
    Absent =>
      v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}

fn project_free_monoid_collection_type_node(
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.compilers.target_model.target_collection_free_monoid_element_type_node(free_monoid_node: node) {
    Present { value: elem } =>
      v2.std.diagnostic.bind_outcome(
        o: free_monoid_collection_realization_from_target(target: target),
        f: fn(row) {
          match row.text_carrier {
            Present { value: text_carrier } =>
              if v2.std.node.content_hash(n: elem) == v2.std.node.content_hash(n: text_carrier.element_carrier) {
                v2.std.diagnostic.Accepted { value: text_carrier.emitted_type_node, diagnostics: v2.std.diagnostic.None }
              } else {
                project_free_monoid_via_vec_choice(row: row, elem: elem, target: target, projection: projection)
              }
            Absent =>
              project_free_monoid_via_vec_choice(row: row, elem: elem, target: target, projection: projection)
          }
        }
      )
    Absent =>
      v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}

fn project_free_monoid_via_vec_choice(
  row: v2.std.compilers.target_model.TargetCollectionRealization,
  elem: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  bind_outcome(
    o: target_collection_select_choice(
      eligibility_table: row.capability_eligibility,
      primary: row.primary,
      alternatives: row.alternatives,
      elem: elem
    ),
    f: fn(selected) {
  match selected {
    Present { value: choice } =>
      v2.std.diagnostic.bind_outcome(
        o: translate_type_expression_project(node: elem, target: target, projection: projection),
        f: fn(elem_projected) {
          v2.std.diagnostic.bind_outcome(
            o: translate_apply_use_site_ownership_to_projected_type(
              projected: elem_projected,
              source_carrier: elem,
              target: target,
              use_site: v2.std.compilers.target_model.OwnershipAtBindingProjection
            ),
            f: fn(elem_storage) {
              v2.std.diagnostic.Accepted {
                value: v2.std.compilers.target_model.target_type_expr_instantiation_emitted(
                  form: projection.instantiation_form,
                  head: v2.std.compilers.target_model.target_type_expr_atom_emitted(
                    form: projection.atom_form,
                    identity: choice.form.apply.surface
                  ),
                  args: std.algebra.Cons { head: elem_storage, tail: std.algebra.Empty }
                ),
                diagnostics: v2.std.diagnostic.None
              }
            }
          )
        }
      )
    Absent => v2.std.diagnostic.outcome_rejected(row.fallback_diagnostic)
  }
    }
  )
}
type TypeExprHeadTail {
  head: v2.std.node.Node
  tail: std.types.List<v2.std.node.Node>
}
type TypeExprArrowSplit {
  inputs: std.types.List<v2.std.node.Node>
  output: v2.std.node.Node
}
fn type_expr_arrow_split_from_types(
  types: std.types.List<v2.std.node.Node>,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<TypeExprArrowSplit> {
  v2.std.diagnostic.bind_outcome(
    o: list_head_and_tail(xs: types, node: node),
    f: fn(split) {
      if v2.std.algebra.is_empty(xs: split.tail) {
        v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
      } else {
        v2.std.diagnostic.outcome_accepted(
          v2.std.algebra.fold_list(
            xs: split.tail,
            empty: TypeExprArrowSplit { inputs: std.algebra.Empty, output: split.head },
            cons: fn(acc, t) {
              TypeExprArrowSplit {
                inputs: v2.std.algebra.list_snoc_item(xs: acc.inputs, item: acc.output),
                output: t
              }
            }
          )
        )
      }
    }
  )
}
fn list_head_and_tail(xs: std.types.List<v2.std.node.Node>, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<TypeExprHeadTail> {
  match v2.std.collection.list_at_optional(xs: xs, index: 0) {
    Absent =>
      v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
    Present { value: head } =>
      match v2.std.algebra.list_tail(xs: xs) {
        TailAbsent =>
          v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        TailFound { tail: t } =>
          v2.std.diagnostic.Accepted { value: TypeExprHeadTail { head: head, tail: t }, diagnostics: v2.std.diagnostic.None }
      }
  }
}

type TypeExprTranslateAcc
  = TypeExprTranslateSlots { slots: std.types.List<v2.std.compilers.target_model.TargetTypeExprFieldSlot> }
  | TypeExprTranslateVariants { variants: std.types.List<v2.std.compilers.target_model.TargetTypeExprVariantSlot> }
  | TypeExprTranslatePositional { items: std.types.List<v2.std.node.Node> }
  | TypeExprTranslateDone { node: v2.std.node.Node }

fn translate_algebra_finalize(
  acc: TypeExprTranslateAcc,
  anchor: v2.std.node.Node,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match anchor.kind {
    TypeNode { connective: connective } =>
      match connective {
        Atom { identity: _ } =>
          match acc {
            TypeExprTranslateDone { node: n } => v2.std.diagnostic.outcome_accepted(n)
            _ => v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Conj =>
          match acc {
            TypeExprTranslateDone { node: n } => v2.std.diagnostic.outcome_accepted(n)
            TypeExprTranslateSlots { slots: fields } =>
              if v2.std.algebra.is_empty(xs: fields) && !v2.std.algebra.is_empty(xs: anchor.children) {
                v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
              } else {
                v2.std.diagnostic.outcome_accepted(
                  v2.std.compilers.target_model.target_type_expr_record_emitted(form: projection.conj_form, fields: fields)
                )
              }
            _ => v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Disj =>
          match acc {
            TypeExprTranslateDone { node: n } => v2.std.diagnostic.outcome_accepted(n)
            TypeExprTranslateVariants { variants: variants } =>
              v2.std.diagnostic.outcome_accepted(
                v2.std.compilers.target_model.target_type_expr_sum_emitted(form: projection.disj_form, variants: variants)
              )
            _ => v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Instantiation =>
          match acc {
            TypeExprTranslateDone { node: n } => v2.std.diagnostic.outcome_accepted(n)
            TypeExprTranslatePositional { items: projected } =>
              v2.std.diagnostic.bind_outcome(
                o: list_head_and_tail(xs: projected, node: anchor),
                f: fn(split) {
                  v2.std.diagnostic.outcome_accepted(
                    v2.std.compilers.target_model.target_type_expr_instantiation_emitted(
                      form: projection.instantiation_form,
                      head: split.head,
                      args: split.tail
                    )
                  )
                }
              )
            _ => v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Cardinality =>
          match acc {
            TypeExprTranslateDone { node: n } => v2.std.diagnostic.outcome_accepted(n)
            TypeExprTranslatePositional { items: projected } =>
              v2.std.diagnostic.bind_outcome(
                o: list_head_and_tail(xs: projected, node: anchor),
                f: fn(split) {
                  v2.std.diagnostic.outcome_accepted(
                    v2.std.compilers.target_model.target_type_expr_cardinality_emitted(
                      form: projection.cardinality_form,
                      head: split.head,
                      args: split.tail
                    )
                  )
                }
              )
            _ => v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
        Arrow =>
          match acc {
            TypeExprTranslateDone { node: n } => v2.std.diagnostic.outcome_accepted(n)
            _ => v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
          }
      }
    ComputationNode { behavior: _ } =>
      v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
  }
}

fn translate_type_expression_arrow_project(
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: type_expr_arrow_split_from_types(
      types: v2.std.node_query.node_positional_child_targets(node: node),
      node: node
    ),
    f: fn(original_split) {
      v2.std.diagnostic.bind_outcome(
        o: translate_project_arrow_split_types(
          original_split: original_split,
          target: target,
          projection: projection,
          anchor: node
        ),
        f: fn(split) {
          v2.std.diagnostic.outcome_accepted(
            v2.std.compilers.target_model.target_type_expr_arrow_emitted(
              form: projection.arrow_form,
              inputs: split.inputs,
              output: split.output
            )
          )
        }
      )
    }
  )
}

fn translate_algebra(
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.node.NodeFold<v2.std.diagnostic.Outcome<TypeExprTranslateAcc>> {
  v2.std.node.NodeFold {
    init: fn(n) {
      match n.kind {
        TypeNode { connective: connective } =>
          match connective {
            Atom { identity: id } =>
              v2.std.diagnostic.Accepted {
                value: TypeExprTranslateDone {
                  node: v2.std.compilers.target_model.target_type_expr_atom_emitted(
                    form: projection.atom_form,
                    identity: id
                  )
                },
                diagnostics: v2.std.diagnostic.None
              }
            Conj =>
              v2.std.diagnostic.Accepted { value: TypeExprTranslateSlots { slots: std.algebra.Empty }, diagnostics: v2.std.diagnostic.None }
            Disj =>
              v2.std.diagnostic.Accepted {
                value: TypeExprTranslateVariants { variants: std.algebra.Empty },
                diagnostics: v2.std.diagnostic.None
              }
            Instantiation =>
              v2.std.diagnostic.Accepted {
                value: TypeExprTranslatePositional { items: std.algebra.Empty },
                diagnostics: v2.std.diagnostic.None
              }
            Cardinality =>
              v2.std.diagnostic.Accepted {
                value: TypeExprTranslatePositional { items: std.algebra.Empty },
                diagnostics: v2.std.diagnostic.None
              }
            Arrow =>
              v2.std.diagnostic.bind_outcome(
                o: translate_type_expression_arrow_project(
                  node: n,
                  target: target,
                  projection: projection
                ),
                f: fn(emitted) {
                  v2.std.diagnostic.Accepted {
                    value: TypeExprTranslateDone { node: emitted },
                    diagnostics: v2.std.diagnostic.None
                  }
                }
              )
          }
        ComputationNode { behavior: _ } =>
          v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: n))
      }
    },
    step: fn(acc, e, child) {
      match acc {
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        Accepted { value: done, diagnostics: d } =>
          match done {
            TypeExprTranslateDone { node: _ } => v2.std.diagnostic.Accepted { value: done, diagnostics: d }
            TypeExprTranslateSlots { slots: slots } =>
              match e.label {
                Named { name: label } =>
                  match child {
                    Rejected { diagnostics: cr } =>
                      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.rejected_with_pending(pending: d, rejected: cr) }
                    Accepted { value: child_acc, diagnostics: cd } =>
                      v2.std.diagnostic.bind_outcome(
                        o: translate_algebra_finalize(
                          acc: child_acc,
                          anchor: e.target,
                          projection: projection
                        ),
                        f: fn(projected) {
                          v2.std.diagnostic.bind_outcome(
                            o: translate_apply_use_site_ownership_to_projected_boundary(
                              projected: projected,
                              source_for_binding: e.target,
                              target: target,
                              projection: projection,
                              use_site: v2.std.compilers.target_model.OwnershipAtStructField
                            ),
                            f: fn(wrapped) {
                              v2.std.diagnostic.Accepted {
                                value: TypeExprTranslateSlots {
                                  slots: v2.std.algebra.list_snoc_item(
                                    xs: slots,
                                    item: v2.std.compilers.target_model.TargetTypeExprFieldSlot {
                                      label: label,
                                      type_expr: wrapped
                                    }
                                  )
                                },
                                diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d, inner: cd)
                              }
                            }
                          )
                        }
                      )
                  }
                Positional =>
                  v2.std.diagnostic.outcome_rejected(
                    translate_type_expression_shape_missing_diagnostic(node: e.target)
                  )
              }
            TypeExprTranslateVariants { variants: variants } =>
              match e.label {
                Named { name: label } =>
                  match child {
                    Rejected { diagnostics: cr } =>
                      v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.rejected_with_pending(pending: d, rejected: cr) }
                    Accepted { value: child_acc, diagnostics: cd } =>
                      v2.std.diagnostic.bind_outcome(
                        o: translate_algebra_finalize(
                          acc: child_acc,
                          anchor: e.target,
                          projection: projection
                        ),
                        f: fn(projected) {
                          v2.std.diagnostic.Accepted {
                            value: TypeExprTranslateVariants {
                              variants: v2.std.algebra.list_snoc_item(
                                xs: variants,
                                item: v2.std.compilers.target_model.TargetTypeExprVariantSlot {
                                  label: label,
                                  type_expr: projected
                                }
                              )
                            },
                            diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d, inner: cd)
                          }
                        }
                      )
                  }
                Positional =>
                  v2.std.diagnostic.outcome_rejected(
                    translate_type_expression_shape_missing_diagnostic(node: e.target)
                  )
              }
            TypeExprTranslatePositional { items: items } =>
              match child {
                Rejected { diagnostics: cr } =>
                  v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.rejected_with_pending(pending: d, rejected: cr) }
                Accepted { value: child_acc, diagnostics: cd } =>
                  v2.std.diagnostic.bind_outcome(
                    o: translate_algebra_finalize(
                      acc: child_acc,
                      anchor: e.target,
                      projection: projection
                    ),
                    f: fn(projected) {
                      v2.std.diagnostic.Accepted {
                        value: TypeExprTranslatePositional {
                          items: v2.std.algebra.list_snoc_item(xs: items, item: projected)
                        },
                        diagnostics: v2.std.diagnostic.diagnostics_merge(outer: d, inner: cd)
                      }
                    }
                  )
              }
          }
      }
    }
  }
}

fn translate_type_expression_project(
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match node.kind {
    ComputationNode { behavior: _ } =>
      v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
    TypeNode { connective: connective } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.type_expr_projection_row_closedness_from_target(
          target: target,
          projection: projection,
          connective: connective
        ),
        f: fn(_) {
          match connective {
            Atom { identity: _ } =>
              v2.std.diagnostic.bind_outcome(
                o: v2.std.node.fold_node(
                  n: node,
                  algebra: translate_algebra(target: target, projection: projection)
                ),
                f: fn(acc) {
                  translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                }
              )
            Instantiation =>
              if v2.std.compilers.target_model.target_collection_type_node_is_free_monoid_carrier(node: node) {
                project_free_monoid_collection_type_node(
                  node: node,
                  target: target,
                  projection: projection
                )
              } else {
                v2.std.diagnostic.bind_outcome(
                  o: v2.std.node.fold_node(
                    n: node,
                    algebra: translate_algebra(target: target, projection: projection)
                  ),
                  f: fn(acc) {
                    translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                  }
                )
              }
            Cardinality =>
              if v2.std.compilers.target_model.target_collection_type_node_is_set_carrier(node: node) {
                project_set_collection_type_node(node: node, target: target, projection: projection)
              } else {
                v2.std.diagnostic.bind_outcome(
                  o: v2.std.node.fold_node(
                    n: node,
                    algebra: translate_algebra(target: target, projection: projection)
                  ),
                  f: fn(acc) {
                    translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                  }
                )
              }
            Conj =>
              v2.std.diagnostic.bind_outcome(
                o: v2.std.node.fold_node(
                  n: node,
                  algebra: translate_algebra(target: target, projection: projection)
                ),
                f: fn(acc) {
                  translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                }
              )
            Disj =>
              v2.std.diagnostic.bind_outcome(
                o: v2.std.node.fold_node(
                  n: node,
                  algebra: translate_algebra(target: target, projection: projection)
                ),
                f: fn(acc) {
                  translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                }
              )
            Arrow =>
              v2.std.diagnostic.bind_outcome(
                o: v2.std.node.fold_node(
                  n: node,
                  algebra: translate_algebra(target: target, projection: projection)
                ),
                f: fn(acc) {
                  translate_algebra_finalize(acc: acc, anchor: node, projection: projection)
                }
              )
          }
        }
      )
  }
}
fn type_expr_atom_binding_from_positional(
  targets: std.types.List<v2.std.node.Node>,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  v2.std.diagnostic.bind_outcome(
    o: list_head_and_tail(xs: targets, node: node),
    f: fn(split) {
      if v2.std.algebra.is_empty(xs: split.tail) {
        match split.head.kind {
          TypeNode { connective: v2.std.node.Atom { identity: id } } =>
            v2.std.diagnostic.Accepted { value: id, diagnostics: v2.std.diagnostic.None }
          _ => v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        }
      } else {
        v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
      }
    }
  )
}
fn type_expr_atom_binding(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  type_expr_atom_binding_from_positional(
    targets: v2.std.node_query.node_positional_child_targets(node: node),
    node: node
  )
}

fn type_expr_spelling_for_atom(target: v2.std.compilers.target_model.TargetModel, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: type_expr_atom_binding(node: node),
    f: fn(binding) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.target_binding_spelling_lookup(target: target, binding: binding),
        f: fn(spelling) {
          v2.std.diagnostic.outcome_accepted(v2.std.compilers.target_model.text_atom(lexeme: spelling))
        }
      )
    }
  )
}

fn serialize_type_expr_record_field_label(target: v2.std.compilers.target_model.TargetModel, edge: v2.std.node.Edge) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  match edge.label {
    Named { name: label } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.target_binding_spelling_lookup(target: target, binding: label),
        f: fn(spelling) {
          v2.std.diagnostic.outcome_accepted(v2.std.compilers.target_model.text_atom(lexeme: spelling))
        }
      )
    Positional =>
      v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: edge.target))
  }
}

fn type_expr_carrier_identity(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Symbol> {
  match node.kind {
    TypeNode { connective: v2.std.node.Atom { identity: _ } } => node_atom_identity(node: node)
    _ => type_expr_atom_binding(node: node)
  }
}
fn serialize_type_expr_emitted_positional_head_tail(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<TypeExprHeadTail> {
  list_head_and_tail(
    xs: v2.std.node_query.node_positional_child_targets(node: node),
    node: node
  )
}
fn serialize_type_expr_generic_apply_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetGenericApply,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: node)
    )
  } else {
    v2.std.diagnostic.bind_outcome(
      o: serialize_type_expr_emitted_positional_head_tail(node: node),
      f: fn(split) {
        v2.std.diagnostic.bind_outcome(
          o: serialize_type_expr_emitted_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            emitted: split.head
          ),
          f: fn(head_source) {
            v2.std.diagnostic.bind_outcome(
              o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.open),
              f: fn(open_source) {
                v2.std.diagnostic.bind_outcome(
                  o: serialize_type_expr_args_bounded(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    form: form,
                    args: split.tail,
                    anchor: node
                  ),
                  f: fn(args_source) {
                    v2.std.diagnostic.bind_outcome(
                      o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.close),
                      f: fn(close_source) {
                        v2.std.diagnostic.Accepted {
                          value: v2.std.compilers.target_model.target_text_seq(
                            acc: v2.std.compilers.target_model.target_text_seq(
                              acc: v2.std.compilers.target_model.target_text_seq(acc: head_source, next: v2.std.compilers.target_model.text_atom(lexeme: open_source)),
                              next: args_source
                            ),
                            next: v2.std.compilers.target_model.text_atom(lexeme: close_source)
                          ),
                          diagnostics: v2.std.diagnostic.None
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}
fn serialize_type_expr_args_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetGenericApply,
  args: std.types.List<v2.std.node.Node>,
  anchor: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    v2.std.algebra.fold_list(
      xs: args,
      empty: v2.std.diagnostic.Accepted { value: v2.std.compilers.target_model.target_text_empty, diagnostics: v2.std.diagnostic.None },
      cons: fn(acc, arg) {
        v2.std.diagnostic.bind_outcome(
          o: acc,
          f: fn(source) {
            v2.std.diagnostic.bind_outcome(
              o: serialize_type_expr_emitted_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                emitted: arg
              ),
              f: fn(arg_source) {
                if v2.std.compilers.target_model.target_text_is_empty(t: source) {
                  v2.std.diagnostic.outcome_accepted(arg_source)
                } else {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.separator),
                    f: fn(sep_source) {
                      v2.std.diagnostic.outcome_accepted(
                        v2.std.compilers.target_model.target_text_seq(
                          acc: v2.std.compilers.target_model.target_text_seq(acc: source, next: v2.std.compilers.target_model.text_atom(lexeme: sep_source)),
                          next: arg_source
                        )
                      )
                    }
                  )
                }
              }
            )
          }
        )
      }
    )
  }
}
fn serialize_type_expr_separated_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  separator: v2.std.node.Symbol,
  items: std.types.List<v2.std.node.Node>,
  anchor: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    v2.std.algebra.fold_list(
      xs: items,
      empty: v2.std.diagnostic.Accepted { value: v2.std.compilers.target_model.target_text_empty, diagnostics: v2.std.diagnostic.None },
      cons: fn(acc, item) {
        v2.std.diagnostic.bind_outcome(
          o: acc,
          f: fn(source) {
            v2.std.diagnostic.bind_outcome(
              o: serialize_type_expr_emitted_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                emitted: item
              ),
              f: fn(item_source) {
                if v2.std.compilers.target_model.target_text_is_empty(t: source) {
                  v2.std.diagnostic.outcome_accepted(item_source)
                } else {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: separator),
                    f: fn(sep_source) {
                      v2.std.diagnostic.outcome_accepted(
                        v2.std.compilers.target_model.target_text_seq(
                          acc: v2.std.compilers.target_model.target_text_seq(acc: source, next: v2.std.compilers.target_model.text_atom(lexeme: sep_source)),
                          next: item_source
                        )
                      )
                    }
                  )
                }
              }
            )
          }
        )
      }
    )
  }
}

fn serialize_type_expr_record_fields_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  separator: v2.std.node.Symbol,
  field_label_separator: v2.std.node.Symbol,
  fields: std.types.List<v2.std.node.Edge>,
  anchor: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    fold(
      fields,
      init: v2.std.diagnostic.Accepted { value: v2.std.compilers.target_model.target_text_empty, diagnostics: v2.std.diagnostic.None },
      f: fn(acc, field) {
        v2.std.diagnostic.bind_outcome(
          o: acc,
          f: fn(source) {
            v2.std.diagnostic.bind_outcome(
              o: serialize_type_expr_record_field_label(target: target, edge: field),
              f: fn(label_source) {
                v2.std.diagnostic.bind_outcome(
                  o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: field_label_separator),
                  f: fn(label_sep_source) {
                    v2.std.diagnostic.bind_outcome(
                      o: serialize_type_expr_emitted_bounded(
                        remaining: remaining - 1,
                        target: target,
                        projection: projection,
                        emitted: field.target
                      ),
                      f: fn(field_type_source) {
                        let field_source = v2.std.compilers.target_model.target_text_seq(
                          acc: v2.std.compilers.target_model.target_text_seq(acc: label_source, next: v2.std.compilers.target_model.text_atom(lexeme: label_sep_source)),
                          next: field_type_source
                        )
                        if v2.std.compilers.target_model.target_text_is_empty(t: source) {
                          v2.std.diagnostic.outcome_accepted(field_source)
                        } else {
                          v2.std.diagnostic.bind_outcome(
                            o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: separator),
                            f: fn(sep_source) {
                              v2.std.diagnostic.outcome_accepted(
                                v2.std.compilers.target_model.target_text_seq(
                                  acc: v2.std.compilers.target_model.target_text_seq(acc: source, next: v2.std.compilers.target_model.text_atom(lexeme: sep_source)),
                                  next: field_source
                                )
                              )
                            }
                          )
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}

fn serialize_type_expr_record_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetGenericApply,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  match form.field_label_separator {
    Present { value: field_label_separator } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.target_type_expr_emitted_labeled_slot_edges(node: node),
        f: fn(fields) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.open),
            f: fn(open_source) {
              v2.std.diagnostic.bind_outcome(
                o: serialize_type_expr_record_fields_bounded(
                  remaining: remaining - 1,
                  target: target,
                  projection: projection,
                  separator: form.separator,
                  field_label_separator: field_label_separator,
                  fields: fields,
                  anchor: node
                ),
                f: fn(fields_source) {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.close),
                    f: fn(close_source) {
                      v2.std.diagnostic.Accepted {
                        value: v2.std.compilers.target_model.target_text_seq(
                          acc: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.text_atom(lexeme: open_source), next: fields_source),
                          next: v2.std.compilers.target_model.text_atom(lexeme: close_source)
                        ),
                        diagnostics: v2.std.diagnostic.None
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    Absent => v2.std.diagnostic.outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}
fn serialize_type_expr_sum_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetSumTypeShape,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.target_type_expr_emitted_labeled_slot_nodes(node: node),
    f: fn(variants) {
      serialize_type_expr_separated_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        separator: form.variant_separator,
        items: variants,
        anchor: node
      )
    }
  )
}
fn serialize_type_expr_arrow_param_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetFunctionTypeShape,
  slot: v2.std.compilers.target_model.TargetTypeExprArrowParamSlot
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.serialize_type_expr_arrow_param_spelling(
      target: target,
      label: slot.label
    ),
    f: fn(name_source) {
      v2.std.diagnostic.bind_outcome(
        o: serialize_type_expr_boundary_bounded(
          remaining: remaining - 1,
          target: target,
          projection: projection,
          boundary_site: v2.std.compilers.target_model.FunctionBoundaryParam,
          emitted: slot.type_expr
        ),
        f: fn(type_source) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.param_type_separator),
            f: fn(separator_source) {
              v2.std.diagnostic.Accepted {
                value: v2.std.compilers.target_model.target_text_seq(
                  acc: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.text_atom(lexeme: name_source), next: v2.std.compilers.target_model.text_atom(lexeme: separator_source)),
                  next: type_source
                ),
                diagnostics: v2.std.diagnostic.None
              }
            }
          )
        }
      )
    }
  )
}

fn serialize_type_expr_arrow_params_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetFunctionTypeShape,
  params: std.types.List<v2.std.compilers.target_model.TargetTypeExprArrowParamSlot>,
  anchor: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    v2.std.algebra.fold_list(
      xs: params,
      empty: v2.std.diagnostic.Accepted { value: v2.std.compilers.target_model.target_text_empty, diagnostics: v2.std.diagnostic.None },
      cons: fn(acc, slot) {
        v2.std.diagnostic.bind_outcome(
          o: acc,
          f: fn(source) {
            v2.std.diagnostic.bind_outcome(
              o: serialize_type_expr_arrow_param_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                slot: slot
              ),
              f: fn(param_source) {
                if v2.std.compilers.target_model.target_text_is_empty(t: source) {
                  v2.std.diagnostic.outcome_accepted(param_source)
                } else {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.param_list_separator),
                    f: fn(separator_source) {
                      v2.std.diagnostic.outcome_accepted(
                        v2.std.compilers.target_model.target_text_seq(
                          acc: v2.std.compilers.target_model.target_text_seq(acc: source, next: v2.std.compilers.target_model.text_atom(lexeme: separator_source)),
                          next: param_source
                        )
                      )
                    }
                  )
                }
              }
            )
          }
        )
      }
    )
  }
}

fn serialize_type_expr_arrow_named_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetFunctionTypeShape,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.target_type_expr_arrow_labeled_param_slots(node: node),
    f: fn(params) {
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.target_type_expr_arrow_labeled_codomain(node: node),
        f: fn(codomain) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.open),
            f: fn(open_source) {
              v2.std.diagnostic.bind_outcome(
                o: serialize_type_expr_arrow_params_bounded(
                  remaining: remaining - 1,
                  target: target,
                  projection: projection,
                  form: form,
                  params: params,
                  anchor: node
                ),
                f: fn(params_source) {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.close),
                    f: fn(close_source) {
                      v2.std.diagnostic.bind_outcome(
                        o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.arrow),
                        f: fn(arrow_source) {
                          v2.std.diagnostic.bind_outcome(
                            o: serialize_type_expr_boundary_bounded(
                              remaining: remaining - 1,
                              target: target,
                              projection: projection,
                              boundary_site: v2.std.compilers.target_model.FunctionBoundaryReturn,
                              emitted: codomain
                            ),
                            f: fn(codomain_source) {
                              v2.std.diagnostic.Accepted {
                                value: v2.std.compilers.target_model.target_text_seq(
                                  acc: v2.std.compilers.target_model.target_text_seq(
                                    acc: v2.std.compilers.target_model.target_text_seq(
                                      acc: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.text_atom(lexeme: open_source), next: params_source),
                                      next: v2.std.compilers.target_model.text_atom(lexeme: close_source)
                                    ),
                                    next: v2.std.compilers.target_model.text_atom(lexeme: arrow_source)
                                  ),
                                  next: codomain_source
                                ),
                                diagnostics: v2.std.diagnostic.None
                              }
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn serialize_type_expr_arrow_input_wrapped(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetFunctionTypeShape,
  input_node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.open),
    f: fn(open_source) {
      v2.std.diagnostic.bind_outcome(
        o: serialize_type_expr_boundary_bounded(
          remaining: remaining - 1,
          target: target,
          projection: projection,
          boundary_site: v2.std.compilers.target_model.FunctionBoundaryParam,
          emitted: input_node
        ),
        f: fn(input_source) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.close),
            f: fn(close_source) {
              v2.std.diagnostic.Accepted {
                value: v2.std.compilers.target_model.target_text_seq(
                  acc: v2.std.compilers.target_model.target_text_seq(acc: v2.std.compilers.target_model.text_atom(lexeme: open_source), next: input_source),
                  next: v2.std.compilers.target_model.text_atom(lexeme: close_source)
                ),
                diagnostics: v2.std.diagnostic.None
              }
            }
          )
        }
      )
    }
  )
}
fn serialize_type_expr_arrow_inputs_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetFunctionTypeShape,
  inputs: std.types.List<v2.std.node.Node>,
  anchor: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else {
    v2.std.algebra.fold_list(
      xs: inputs,
      empty: v2.std.diagnostic.Accepted { value: v2.std.compilers.target_model.target_text_empty, diagnostics: v2.std.diagnostic.None },
      cons: fn(acc, input_node) {
        v2.std.diagnostic.bind_outcome(
          o: acc,
          f: fn(source) {
            v2.std.diagnostic.bind_outcome(
              o: serialize_type_expr_arrow_input_wrapped(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                input_node: input_node
              ),
              f: fn(input_source) {
                if v2.std.compilers.target_model.target_text_is_empty(t: source) {
                  v2.std.diagnostic.outcome_accepted(input_source)
                } else {
                  v2.std.diagnostic.bind_outcome(
                    o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.arrow),
                    f: fn(arrow_source) {
                      v2.std.diagnostic.outcome_accepted(
                        v2.std.compilers.target_model.target_text_seq(
                          acc: v2.std.compilers.target_model.target_text_seq(acc: source, next: v2.std.compilers.target_model.text_atom(lexeme: arrow_source)),
                          next: input_source
                        )
                      )
                    }
                  )
                }
              }
            )
          }
        )
      }
    )
  }
}
fn serialize_type_expr_arrow_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  form: v2.std.compilers.target_model.TargetFunctionTypeShape,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  match v2.std.compilers.target_model.target_type_expr_arrow_wire_shape(node: node) {
    Accepted { value: v2.std.compilers.target_model.TargetTypeExprArrowLabeledWire, diagnostics: d } =>
      v2.std.diagnostic.bind_outcome_accepted(
        od: d,
        inner: serialize_type_expr_arrow_named_bounded(
          remaining: remaining,
          target: target,
          projection: projection,
          form: form,
          node: node
        )
      )
    Accepted { value: v2.std.compilers.target_model.TargetTypeExprArrowPositionalWire, diagnostics: d } =>
      v2.std.diagnostic.bind_outcome_accepted(
        od: d,
        inner: v2.std.diagnostic.bind_outcome(
          o: type_expr_arrow_split_from_types(
            types: v2.std.node_query.node_positional_child_targets(node: node),
            node: node
          ),
          f: fn(split) {
            v2.std.diagnostic.bind_outcome(
              o: serialize_type_expr_arrow_inputs_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                inputs: split.inputs,
                anchor: node
              ),
              f: fn(inputs_source) {
                v2.std.diagnostic.bind_outcome(
                  o: v2.std.compilers.target_model.lex_rules_literal(target: target, token_class: form.arrow),
                  f: fn(arrow_source) {
                    v2.std.diagnostic.bind_outcome(
                      o: serialize_type_expr_boundary_bounded(
                        remaining: remaining - 1,
                        target: target,
                        projection: projection,
                        boundary_site: v2.std.compilers.target_model.FunctionBoundaryReturn,
                        emitted: split.output
                      ),
                      f: fn(output_source) {
                        v2.std.diagnostic.Accepted {
                          value: v2.std.compilers.target_model.target_text_seq(
                            acc: v2.std.compilers.target_model.target_text_seq(acc: inputs_source, next: v2.std.compilers.target_model.text_atom(lexeme: arrow_source)),
                            next: output_source
                          ),
                          diagnostics: v2.std.diagnostic.None
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      )
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}
fn serialize_type_expr_emitted_wire_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  wire: v2.std.compilers.target_model.TargetTypeExpression
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  match wire.kind {
    TargetTypeExprAtom =>
      type_expr_spelling_for_atom(target: target, node: wire.node)
    TargetTypeExprInstantiation =>
      serialize_type_expr_generic_apply_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.instantiation_form,
        node: wire.node
      )
    TargetTypeExprCardinality =>
      serialize_type_expr_generic_apply_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.cardinality_form,
        node: wire.node
      )
    TargetTypeExprRecord =>
      serialize_type_expr_record_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.conj_form,
        node: wire.node
      )
    TargetTypeExprSum =>
      serialize_type_expr_sum_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.disj_form,
        node: wire.node
      )
    TargetTypeExprArrow =>
      serialize_type_expr_arrow_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.arrow_form,
        node: wire.node
      )
  }
}
fn serialize_type_expr_emitted_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else {
    v2.std.diagnostic.bind_outcome(
      o: v2.std.compilers.target_model.target_type_expr_emitted_wire_decode(node: emitted, projection: projection),
      f: fn(wire) {
        serialize_type_expr_emitted_wire_bounded(
          remaining: remaining,
          target: target,
          projection: projection,
          wire: wire
        )
      }
    )
  }
}
fn translate_outcome_is_catalog_lookup_miss(
  diagnostics: v2.std.diagnostic.NonEmptyDiagnostics
) -> v2.std.logic.Bool {
  diagnostics.head.reason == ^target_atom_realization_lookup_miss
}

fn translate_reference_layer_tokens_from_target(
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetReferenceLayerTokens> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_reference_layer_tokens),
    f: fn(bundle) { v2.std.compilers.target_model.target_reference_layer_tokens_from_node(node: bundle) }
  )
}

fn translate_apply_wrap_gate_to_type_shell(
  shell: v2.std.node.Node,
  gate: v2.std.compilers.target_model.WrapDecisionGate,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match gate {
    WrapGateInapplicable => v2.std.diagnostic.outcome_accepted(shell)
    WrapGateDecided { decision } =>
      match decision {
        WrapByValue => v2.std.diagnostic.outcome_accepted(shell)
        WrapByReference { layer } =>
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.type_expression_projection_from_target(target: target),
            f: fn(projection) {
              v2.std.diagnostic.bind_outcome(
                o: translate_reference_layer_tokens_from_target(target: target),
                f: fn(tokens) {
                  v2.std.diagnostic.outcome_accepted(
                    v2.std.compilers.target_model.target_reference_layer_apply_type_emitted(
                      inner: shell,
                      layer: layer,
                      projection: projection,
                      tokens: tokens
                    )
                  )
                }
              )
            }
          )
      }
  }
}

fn translate_apply_wrap_gate_to_value_expression(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  gate: v2.std.compilers.target_model.WrapDecisionGate,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match gate {
    WrapGateInapplicable => v2.std.diagnostic.outcome_accepted(expr)
    WrapGateDecided { decision } =>
      match decision {
        WrapByValue => v2.std.diagnostic.outcome_accepted(expr)
        WrapByReference { layer } =>
          v2.std.diagnostic.bind_outcome(
            o: translate_reference_layer_tokens_from_target(target: target),
            f: fn(tokens) {
              v2.std.diagnostic.outcome_accepted(
                v2.std.compilers.target_model.target_reference_layer_apply_value_expression(
                  inner: expr,
                  layer: layer,
                  tokens: tokens
                )
              )
            }
          )
      }
  }
}

fn translate_apply_use_site_ownership_to_projected_type(
  projected: v2.std.node.Node,
  source_carrier: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  translate_apply_use_site_ownership_to_type_shell(
    shell: projected,
    source_carrier: source_carrier,
    target: target,
    use_site: use_site
  )
}

fn translate_apply_use_site_ownership_to_projected_boundary(
  projected: v2.std.node.Node,
  source_for_binding: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.target_type_expr_emitted_wire_decode(node: projected, projection: projection),
    f: fn(wire) {
      match wire.kind {
        TargetTypeExprAtom =>
          v2.std.diagnostic.bind_outcome(
            o: type_expr_carrier_identity(node: source_for_binding),
            f: fn(binding) {
              translate_apply_use_site_ownership_to_projected_type(
                projected: projected,
                source_carrier: translate_boundary_source_carrier_node(binding: binding),
                target: target,
                use_site: use_site
              )
            }
          )
        TargetTypeExprInstantiation =>
          translate_apply_use_site_ownership_to_instantiation_boundary(
            projected: projected,
            source_for_binding: source_for_binding,
            target: target,
            projection: projection,
            use_site: use_site
          )
        _ => v2.std.diagnostic.outcome_accepted(projected)
      }
    }
  )
}

data translate_ownership_instantiation_boundary_note: String = "Instantiation-kind wire (Option<T>, Rc<T>, Witness<T>, List<T>) recurses ownership-wrap per positional type argument, zipped against the same-shape source_for_binding argument list, rather than bypassing the gate — the fix for the wrap_decision_predicate caller-side bypass named in v1_deletion_plan.dag ^wrap_decision_predicate (RE-OPENED 2026-07-24)."

fn translate_apply_use_site_ownership_to_instantiation_boundary(
  projected: v2.std.node.Node,
  source_for_binding: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: serialize_type_expr_emitted_positional_head_tail(node: projected),
    f: fn(projected_split) {
      v2.std.diagnostic.bind_outcome(
        o: serialize_type_expr_emitted_positional_head_tail(node: source_for_binding),
        f: fn(source_split) {
          v2.std.diagnostic.bind_outcome(
            o: sequence_outcome(
              xs: zip_map(
                a: projected_split.tail,
                b: source_split.tail,
                f: fn(parg, sarg) {
                  translate_apply_use_site_ownership_to_projected_boundary(
                    projected: parg,
                    source_for_binding: sarg,
                    target: target,
                    projection: projection,
                    use_site: use_site
                  )
                }
              ),
              policy: v2.std.diagnostic.StageDiagnosticPolicy { accumulation: v2.std.diagnostic.ShortCircuit }
            ),
            f: fn(wrapped_args) {
              v2.std.diagnostic.outcome_accepted(
                v2.std.node.node_rebuild(
                  n: projected,
                  children: v2.std.algebra.list_append(
                    left: [v2.std.node.Edge { label: v2.std.node.Positional, target: projected_split.head }],
                    right: list_map(xs: wrapped_args, f: fn(a) { v2.std.node.Edge { label: v2.std.node.Positional, target: a } })
                  )
                )
              )
            }
          )
        }
      )
    }
  )
}

fn translate_project_arrow_input_types(
  original_inputs: std.types.List<v2.std.node.Node>,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.node.Node>> {
  v2.std.algebra.fold_list(
    xs: original_inputs,
    empty: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, original_input) {
      v2.std.diagnostic.bind_outcome(
        o: acc,
        f: fn(items) {
          v2.std.diagnostic.bind_outcome(
            o: translate_type_expression_project(node: original_input, target: target, projection: projection),
            f: fn(projected) {
              v2.std.diagnostic.bind_outcome(
                o: translate_apply_use_site_ownership_to_projected_boundary(
                  projected: projected,
                  source_for_binding: original_input,
                  target: target,
                  projection: projection,
                  use_site: v2.std.compilers.target_model.OwnershipAtFunctionParameter
                ),
                f: fn(wrapped) {
                  v2.std.diagnostic.outcome_accepted(v2.std.algebra.list_snoc_item(xs: items, item: wrapped))
                }
              )
            }
          )
        }
      )
    }
  )
}

fn translate_project_arrow_split_types(
  original_split: TypeExprArrowSplit,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  anchor: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<TypeExprArrowSplit> {
  v2.std.diagnostic.bind_outcome(
    o: translate_project_arrow_input_types(
      original_inputs: original_split.inputs,
      target: target,
      projection: projection
    ),
    f: fn(wrapped_inputs) {
      v2.std.diagnostic.bind_outcome(
        o: translate_type_expression_project(
          node: original_split.output,
          target: target,
          projection: projection
        ),
        f: fn(projected_output) {
          v2.std.diagnostic.bind_outcome(
            o: translate_apply_use_site_ownership_to_projected_boundary(
              projected: projected_output,
              source_for_binding: original_split.output,
              target: target,
              projection: projection,
              use_site: v2.std.compilers.target_model.OwnershipAtFunctionReturn
            ),
            f: fn(wrapped_output) {
              v2.std.diagnostic.outcome_accepted(
                TypeExprArrowSplit {
                  inputs: wrapped_inputs,
                  output: wrapped_output
                }
              )
            }
          )
        }
      )
    }
  )
}

fn translate_apply_use_site_ownership_to_type_shell(
  shell: v2.std.node.Node,
  source_carrier: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.compiler.wrap_decision.wrap_decision_gate(
    target: target,
    source_carrier: source_carrier,
    use_site: use_site
  ) {
    Accepted { value: gate, diagnostics: _ } =>
      translate_apply_wrap_gate_to_type_shell(
        shell: shell,
        gate: gate,
        target: target
      )
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn translate_outcome_is_signature_realization_miss(
  diagnostics: v2.std.diagnostic.NonEmptyDiagnostics
) -> v2.std.logic.Bool {
  diagnostics.head.reason == ^target_function_signature_realization_lookup_miss
}

fn translate_boundary_source_carrier_node(binding: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: binding } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn function_boundary_site_to_ownership_use_site(
  boundary_site: v2.std.compilers.target_model.FunctionBoundarySite
) -> v2.std.compilers.target_model.TargetOwnershipUseSite {
  match boundary_site {
    FunctionBoundaryParam => v2.std.compilers.target_model.OwnershipAtFunctionParameter
    FunctionBoundaryReturn => v2.std.compilers.target_model.OwnershipAtFunctionReturn
  }
}

fn translate_target_function_signature_realization_for_boundary(
  target: v2.std.compilers.target_model.TargetModel,
  emitted: v2.std.node.Node,
  boundary_site: v2.std.compilers.target_model.FunctionBoundarySite
) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.compilers.target_model.TargetFunctionSignatureRealization>> {
  match target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_signature_realizations
  ) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: optional_catalog, diagnostics: _ } =>
      match optional_catalog {
        Absent => v2.std.diagnostic.outcome_accepted(v2.std.optional.optional_absent())
        Present { value: catalog } =>
          v2.std.diagnostic.bind_outcome(
            o: type_expr_atom_binding(node: emitted),
            f: fn(binding) {
              match v2.std.compilers.target_model.target_function_signature_realization_lookup_in_catalog_node(
                catalog: catalog,
                source_carrier: translate_boundary_source_carrier_node(binding: binding),
                boundary_site: boundary_site,
                host_target_model: target
              ) {
                Accepted { value: row, diagnostics: _ } =>
                  v2.std.diagnostic.outcome_accepted(v2.std.optional.optional_present(row))
                Rejected { diagnostics: r } =>
                  if translate_outcome_is_signature_realization_miss(diagnostics: r) {
                    v2.std.diagnostic.outcome_accepted(v2.std.optional.optional_absent())
                  } else {
                    v2.std.diagnostic.Rejected { diagnostics: r }
                  }
              }
            }
          )
      }
  }
}

fn serialize_type_expr_boundary_atom_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  boundary_site: v2.std.compilers.target_model.FunctionBoundarySite,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  match translate_target_function_signature_realization_for_boundary(
    target: target,
    emitted: emitted,
    boundary_site: boundary_site
  ) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: optional_row, diagnostics: _ } =>
      match optional_row {
        Present { value: row } =>
          serialize_type_expr_emitted_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            emitted: row.signature_type_form.node
          )
        Absent =>
          v2.std.diagnostic.bind_outcome(
            o: type_expr_atom_binding(node: emitted),
            f: fn(binding) {
              v2.std.diagnostic.bind_outcome(
                o: translate_apply_use_site_ownership_to_projected_type(
                  projected: emitted,
                  source_carrier: translate_boundary_source_carrier_node(binding: binding),
                  target: target,
                  use_site: function_boundary_site_to_ownership_use_site(
                    boundary_site: boundary_site
                  )
                ),
                f: fn(wrapped) {
                  serialize_type_expr_emitted_bounded(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    emitted: wrapped
                  )
                }
              )
            }
          )
      }
  }
}

fn serialize_type_expr_boundary_bounded(
  remaining: Int,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection,
  boundary_site: v2.std.compilers.target_model.FunctionBoundarySite,
  emitted: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetText> {
  if remaining <= 0 {
    v2.std.diagnostic.outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else {
    v2.std.diagnostic.bind_outcome(
      o: v2.std.compilers.target_model.target_type_expr_emitted_wire_decode(node: emitted, projection: projection),
      f: fn(wire) {
        match wire.kind {
          TargetTypeExprAtom =>
            serialize_type_expr_boundary_atom_bounded(
              remaining: remaining,
              target: target,
              projection: projection,
              boundary_site: boundary_site,
              emitted: emitted
            )
          _ =>
            serialize_type_expr_emitted_wire_bounded(
              remaining: remaining,
              target: target,
              projection: projection,
              wire: wire
            )
        }
      }
    )
  }
}

fn translate_coerced_shell_base(coerced: v2.std.node.Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match translate_target_atom_realization_for_carrier(
    target: target,
    source_carrier: coerced
  ) {
    Accepted { value: row, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: row.type_form.node,
        diagnostics: d
      }
    Rejected { diagnostics: r } =>
      if translate_outcome_is_catalog_lookup_miss(diagnostics: r) {
        v2.std.diagnostic.outcome_accepted(v2.std.node.node_rebuild(n: coerced, children: []))
      } else {
        v2.std.diagnostic.Rejected { diagnostics: r }
      }
  }
}

fn translate_coerced_shell_at_use_site(
  coerced: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  translate_coerced_shell_at_use_site_from_source(
    coerced: coerced,
    ownership_source_carrier: coerced,
    target: target,
    use_site: use_site
  )
}

fn translate_coerced_shell_at_use_site_from_source(
  coerced: v2.std.node.Node,
  ownership_source_carrier: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match translate_coerced_type_shell_from_source(
    source_carrier: ownership_source_carrier,
    coerced: coerced,
    target: target
  ) {
    Accepted { value: shell, diagnostics: d } =>
      v2.std.diagnostic.bind_outcome(
        o: translate_apply_use_site_ownership_to_type_shell(
          shell: shell,
          source_carrier: ownership_source_carrier,
          target: target,
          use_site: use_site
        ),
        f: fn(wrapped) { v2.std.diagnostic.Accepted { value: wrapped, diagnostics: d } }
      )
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn translate_coerced_type_shell_from_source(
  source_carrier: v2.std.node.Node,
  coerced: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match source_carrier.kind {
    TypeNode { connective: v2.std.node.Instantiation } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.std.compilers.target_model.type_expression_projection_from_target(target: target),
        f: fn(projection) {
          translate_type_expression_project(
            node: source_carrier,
            target: target,
            projection: projection
          )
        }
      )
    _ => translate_coerced_shell_base(coerced: coerced, target: target)
  }
}

fn translate_coerced_shell(coerced: v2.std.node.Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  translate_coerced_shell_at_use_site(
    coerced: coerced,
    target: target,
    use_site: v2.std.compilers.target_model.OwnershipAtBindingProjection
  )
}

fn translate_use_site_ownership_source_carrier(source: v2.std.node.Node, coerced: v2.std.node.Node) -> v2.std.node.Node {
  match source.kind {
    TypeNode { connective: _ } => source
    ComputationNode { behavior: _ } => coerced
  }
}
fn target_atom_realizations_catalog_from_model(
  target: v2.std.compilers.target_model.TargetModel,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_atom_realizations
  ) {
    Accepted { value: optional_catalog, diagnostics: d } =>
      match optional_catalog {
        Absent =>
          v2.std.diagnostic.outcome_rejected(
            v2.std.compilers.target_model.target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier)
          )
        Present { value: catalog } =>
          v2.std.diagnostic.Accepted { value: catalog, diagnostics: d }
      }
    Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: r }
  }
}
fn translate_target_atom_realization_for_carrier(
  target: v2.std.compilers.target_model.TargetModel,
  source_carrier: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetAtomRealization> {
  v2.std.diagnostic.bind_outcome(
    o: target_atom_realizations_catalog_from_model(
      target: target,
      source_carrier: source_carrier
    ),
    f: fn(catalog) {
      v2.std.compilers.target_model.target_atom_realization_lookup_in_catalog_node(
        catalog: catalog,
        source_carrier: source_carrier,
        host_target_model: target
      )
    }
  )
}
fn translate_shell_attach_value_expression(shell: v2.std.node.Node, value: v2.std.node.Node) -> v2.std.node.Node {
  match shell.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      v2.std.node.node_rebuild(
        n: shell,
        children: v2.std.algebra.list_snoc_item(
          xs: shell.children,
          item: v2.std.compilers.target_model.target_model_named_edge(
            name: ^target_model_edge_value_expression,
            target: value
          )
        )
      )
    _ => shell
  }
}
fn translate_apply_use_site_ownership_to_value_expression(
  expr: v2.std.compilers.target_model.TargetValueExpression,
  source_carrier: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.compilers.target_model.TargetValueExpression> {
  match v2.compiler.wrap_decision.wrap_decision_gate(
    target: target,
    source_carrier: source_carrier,
    use_site: use_site
  ) {
    Accepted { value: gate, diagnostics: _ } =>
      translate_apply_wrap_gate_to_value_expression(
        expr: expr,
        gate: gate,
        target: target
      )
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn translate_atom_realization_value_from_source_at_use_site(
  source: v2.std.node.Node,
  coerced: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite
) -> v2.std.diagnostic.Outcome<v2.std.optional.Optional<v2.std.node.Node>> {
  match translate_target_atom_realization_for_carrier(
    target: target,
    source_carrier: coerced
  ) {
    Accepted { value: row, diagnostics: d } =>
      match v2.std.compilers.target_model.source_atom_value_for_realization_row(source: source, row: row) {
        Absent =>
          v2.std.diagnostic.Accepted {
            value: v2.std.optional.optional_absent(),
            diagnostics: d
          }
        Present { value: atom_value } =>
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.target_atom_value_expression(row: row, value: atom_value),
            f: fn(expr) {
              v2.std.diagnostic.bind_outcome(
                o: translate_apply_use_site_ownership_to_value_expression(
                  expr: expr,
                  source_carrier: coerced,
                  target: target,
                  use_site: use_site
                ),
                f: fn(wrapped) {
                  v2.std.diagnostic.outcome_accepted(
                    v2.std.optional.optional_present(v2.std.compilers.target_model.target_value_expression_node(expr: wrapped))
                  )
                }
              )
            }
          )
      }
    Rejected { diagnostics: r } =>
      if translate_outcome_is_catalog_lookup_miss(diagnostics: r) {
        v2.std.diagnostic.outcome_accepted(v2.std.optional.optional_absent())
      } else {
        v2.std.diagnostic.Rejected { diagnostics: r }
      }
  }
}

fn translate_coerced_with_atom_realization_at_use_site(
  source: v2.std.node.Node,
  coerced: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  use_site: v2.std.compilers.target_model.TargetOwnershipUseSite,
  pending: v2.std.diagnostic.Diagnostics
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let ownership_source_carrier = translate_use_site_ownership_source_carrier(
    source: source,
    coerced: coerced
  )
  match translate_coerced_shell_at_use_site_from_source(
    coerced: coerced,
    ownership_source_carrier: ownership_source_carrier,
    target: target,
    use_site: use_site
  ) {
    Accepted { value: shell, diagnostics: sd } =>
      match translate_atom_realization_value_from_source_at_use_site(
        source: source,
        coerced: coerced,
        target: target,
        use_site: use_site
      ) {
        Accepted { value: value_projection, diagnostics: vd } =>
          v2.std.diagnostic.Accepted {
            value: match value_projection {
              Absent => shell
              Present { value: value_node } =>
                translate_shell_attach_value_expression(
                  shell: shell,
                  value: value_node
                )
            },
            diagnostics: v2.std.diagnostic.diagnostics_merge(
              outer: v2.std.diagnostic.diagnostics_merge(outer: pending, inner: sd),
              inner: vd
            )
          }
        Rejected { diagnostics: r } =>
          v2.std.diagnostic.Rejected {
            diagnostics: v2.std.diagnostic.rejected_with_pending(
              pending: v2.std.diagnostic.diagnostics_merge(outer: pending, inner: sd),
              rejected: r
            )
          }
      }
    Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected {
        diagnostics: v2.std.diagnostic.rejected_with_pending(pending: pending, rejected: r)
      }
  }
}

fn translate_coerced_with_atom_realization(
  source: v2.std.node.Node,
  coerced: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  pending: v2.std.diagnostic.Diagnostics
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  translate_coerced_with_atom_realization_at_use_site(
    source: source,
    coerced: coerced,
    target: target,
    use_site: v2.std.compilers.target_model.OwnershipAtBindingProjection,
    pending: pending
  )
}

fn translate_type_fold_init(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Accepted {
    value: v2.std.node.node_rebuild(n: node, children: []),
    diagnostics: v2.std.diagnostic.None
  }
}

type TranslateFoldAcc = {
  source: v2.std.node.Node,
  rebuilt: v2.std.node.Node
}

fn translate_type_fold_init_acc(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<TranslateFoldAcc> {
  match translate_type_fold_init(node: node) {
    Accepted { value: rebuilt, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: TranslateFoldAcc { source: node, rebuilt: rebuilt },
        diagnostics: d
      }
    Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn translate_projection_absent_fold_init_acc(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<TranslateFoldAcc> {
  match translate_projection_absent_fold_init(node: node, tree: tree, target: target) {
    Accepted { value: rebuilt, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: TranslateFoldAcc { source: node, rebuilt: rebuilt },
        diagnostics: d
      }
    Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

fn translate_fold_acc_rebuilt(o: v2.std.diagnostic.Outcome<TranslateFoldAcc>) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match o {
    Accepted { value: acc, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: acc.rebuilt, diagnostics: d }
    Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: r }
  }
}
fn translate_computation_fold_init(node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {

  translate_type_fold_init(node: node)
}
fn translate_projection_absent_coerce_from_grounding_or_evidence(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match coerce_grounded_node(source: node, tree: tree, target: target) {
    Accepted { value: coerced, diagnostics: d } =>
      translate_coerced_with_atom_realization(
        source: node,
        coerced: coerced.target,
        target: target,
        pending: d
      )
    Rejected { diagnostics: r } =>
      match v2.compiler.infer.canonical_grounding_for_node(tree: tree, node: node) {
        Accepted { value: grounding } =>
          if v2.compiler.infer.algebra_ref_is_grounded(algebra: grounding.witness.structural.evidence) {
            translate_coerced_with_atom_realization(
              source: node,
              coerced: grounding.witness.structural.evidence,
              target: target,
              pending: v2.std.diagnostic.None
            )
          } else {

            translate_type_fold_init(node: node)
          }
        Rejected { diagnostics: r } =>
          v2.std.diagnostic.Rejected { diagnostics: r }
      }
  }
}
fn translate_projection_absent_fold_init(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match node.kind {
    TypeNode { connective: v2.std.node.Arrow } =>

      if v2.std.compilers.target_model.target_value_expr_arrow_has_value_expression_body(arrow: node) {
        translate_projection_absent_bodied_arrow_fold_init(tree: tree, node: node)
      } else {
        match coerce_grounded_node(source: node, tree: tree, target: target) {
          Accepted { value: coerced, diagnostics: d } =>
            translate_coerced_with_atom_realization(
              source: node,
              coerced: coerced.target,
              target: target,
              pending: d
            )
          Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        }
      }
    TypeNode { connective: v2.std.node.Atom { identity: _ } } =>
      translate_projection_absent_coerce_from_grounding_or_evidence(
        node: node,
        tree: tree,
        target: target
      )
    TypeNode { connective: _ } =>
      match coerce_grounded_node(source: node, tree: tree, target: target) {
        Accepted { value: coerced, diagnostics: d } =>
          translate_coerced_with_atom_realization(
            source: node,
            coerced: coerced.target,
            target: target,
            pending: d
          )
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      }
    ComputationNode { behavior: _ } => translate_computation_fold_init(node: node)
  }
}

fn translate_grammar_relation_row_match(target: v2.std.compilers.target_model.TargetModel, emitted: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) { grammar_relation_row_for_emitted(rules: rules, emitted: emitted) }
  )
}
fn translate_type_expression_tree(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: translate_grounding_derived_gate_at_producer(tree: tree, node: node),
    f: fn(_) {
      if v2.std.compilers.target_model.target_value_expr_arrow_has_value_expression_body(arrow: node) {
        translate_bodied_arrow_shortcut_after_subtree_gate(tree: tree, arrow: node)
      } else {
        v2.std.diagnostic.bind_outcome(
          o: translate_fold_acc_rebuilt(
            o: v2.std.node.fold_node(
              n: node,
              algebra: v2.std.node.NodeFold {
                init: fn(n0) { translate_type_fold_init_acc(node: n0) },
                step: fn(acc, e, child) {
                  translate_fold_step(acc: acc, edge: e, child: child, tree: tree)
                }
              }
            )
          ),
          f: fn(n) {

            match translate_grammar_relation_row_match(target: target, emitted: n) {
              Accepted { value: _, diagnostics: _ } => v2.std.diagnostic.outcome_accepted(n)
              Rejected { diagnostics: _ } =>
                translate_type_expression_project(node: n, target: target, projection: projection)
            }
          }
        )
      }
    }
  )
}
fn translate_node_with_projection(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.target_model.type_expression_projection_from_target(target: target),
    f: fn(projection) {
      match node.kind {
        TypeNode { connective: _ } =>
          translate_type_expression_tree(
            node: node,
            tree: tree,
            target: target,
            projection: projection
          )
        ComputationNode { behavior: _ } =>
          v2.std.diagnostic.bind_outcome(
            o: translate_node_computation(node: node, tree: tree, target: target),
            f: fn(translated) {
              v2.std.diagnostic.bind_outcome(
                o: translate_type_expression_subtree(
                  node: translated,
                  target: target,
                  projection: projection
                ),
                f: fn(projected) { v2.std.diagnostic.Accepted { value: projected, diagnostics: v2.std.diagnostic.None } }
              )
            }
          )
      }
    }
  )
}
fn translate_type_expression_subtree(
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match node.kind {
    TypeNode { connective: _ } =>
      translate_type_expression_project(node: node, target: target, projection: projection)
    ComputationNode { behavior: b } =>
      v2.std.diagnostic.bind_outcome(
        o: translate_type_expression_children_in_node(node: node, target: target, projection: projection),
        f: fn(children) {
          v2.std.diagnostic.Accepted {
            value: v2.std.node.node_rebuild(n: node, children: children),
            diagnostics: v2.std.diagnostic.None
          }
        }
      )
  }
}
fn translate_type_expression_children_in_node(
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel,
  projection: v2.std.compilers.target_model.TargetTypeExpressionProjection
) -> v2.std.diagnostic.Outcome<std.types.List<v2.std.node.Edge>> {
  fold(
    node.children,
    init: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    f: fn(acc, e) {
      v2.std.diagnostic.bind_outcome(
        o: acc,
        f: fn(edges) {
          v2.std.diagnostic.bind_outcome(
            o: translate_type_expression_subtree(node: e.target, target: target, projection: projection),
            f: fn(projected) {
              v2.std.diagnostic.outcome_accepted(
                v2.std.algebra.list_snoc_item(xs: edges, item: v2.std.node.Edge { label: e.label, target: projected })
              )
            }
          )
        }
      )
    }
  )
}
fn translate_node_computation(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: translate_grounding_derived_gate_at_producer(tree: tree, node: node),
    f: fn(_) {
      translate_fold_acc_rebuilt(
        o: v2.std.node.fold_node(
          n: node,
          algebra: v2.std.node.NodeFold {
            init: fn(n0) { translate_type_fold_init_acc(node: n0) },
            step: fn(acc, e, child) {
              translate_fold_step(acc: acc, edge: e, child: child, tree: tree)
            }
          }
        )
      )
    }
  )
}
fn translate_node_projection_absent_fold(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  translate_fold_acc_rebuilt(
    o: v2.std.node.fold_node(
      n: node,
      algebra: v2.std.node.NodeFold {
        init: fn(n0) {
          translate_projection_absent_fold_init_acc(
            node: n0,
            tree: tree,
            target: target
          )
        },
        step: fn(acc, e, child) {
          translate_fold_step(acc: acc, edge: e, child: child, tree: tree)
        }
      }
    )
  )
}
fn is_dag_import_production_node(node: v2.std.node.Node) -> v2.std.logic.Bool {
  match v2.extdeps.languages.dag.parse_production_emitted_identity_optional(node: node) {
    Present { value: id } => id == ^dag_surface_import_decl
    Absent => false
  }
}

fn translate_import_production_qn_node(import_node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.extdeps.languages.dag.parse_subtree_find_production_captured(
    root: import_node,
    emitted: ^dag_surface_qualified_name
  ) {
    ParseSubtreeAbsent =>
      v2.std.diagnostic.outcome_rejected(
        translate_grammar_relation_row_not_found_diagnostic(emitted: import_node)
      )
    ParseSubtreeFound { captured: qn_capture } =>
      v2.std.diagnostic.bind_outcome(
        o: v2.extdeps.languages.dag.parse_qualified_name_segments_from_capture(qn_capture: qn_capture, root: import_node),
        f: fn(segments) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.std.algebra.fold_list_node(
              xs: segments,
              item_node: fn(sym) {
                v2.std.node.Node {
                  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
                  children: [],
                  occurrence_id: v2.std.node.SyntheticOccurrence
                }
              }
            )
          )
        }
      )
  }
}

fn translate_import_production_block_node(import_node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: v2.extdeps.languages.dag.parse_import_block_idents(import_decl_node: import_node, root: import_node),
    f: fn(idents) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: v2.std.algebra.fold_list(
            xs: idents,
            empty: std.algebra.Empty,
            cons: fn(acc, sym) {
              v2.std.algebra.list_append(
                left: acc,
                right: [
                  v2.std.node.Edge {
                    label: v2.std.node.Positional,
                    target: v2.std.node.Node {
                      kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: sym } },
                      children: [],
                      occurrence_id: v2.std.node.SyntheticOccurrence
                    }
                  }
                ]
              )
            }
          ),
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      )
    }
  )
}

fn translate_import_production_to_carrier(import_node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: translate_import_production_qn_node(import_node: import_node),
    f: fn(qn_node) {
      v2.std.diagnostic.bind_outcome(
        o: translate_import_production_block_node(import_node: import_node),
        f: fn(block_node) {
          v2.std.diagnostic.outcome_accepted(
            value: v2.extdeps.languages.dag.emit_import_decl_emitted_node(
              qualified_name: qn_node,
              import_block: Present { value: block_node }
            )
          )
        }
      )
    }
  )
}

fn is_dag_import_carrier(emitted: v2.std.node.Node) -> v2.std.logic.Bool {
  match v2.std.node_query.find_named_child(root: emitted, name: ^dag_surface_import_decl) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn translate_node_projection_absent(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: translate_grounding_derived_gate_at_producer(tree: tree, node: node),
    f: fn(_) {
      if v2.std.compilers.target_model.target_value_expr_arrow_has_value_expression_body(arrow: node) {
        translate_bodied_arrow_shortcut_after_subtree_gate(tree: tree, arrow: node)
      } else if is_dag_import_production_node(node: node) {
        translate_import_shortcut_after_subtree_gate(tree: tree, import_node: node)
      } else {
        v2.std.diagnostic.bind_outcome(
          o: translate_fold_acc_rebuilt(
            o: v2.std.node.fold_node(
              n: node,
              algebra: v2.std.node.NodeFold {
                init: fn(n0) { translate_type_fold_init_acc(node: n0) },
                step: fn(acc, e, child) {
                  translate_fold_step(acc: acc, edge: e, child: child, tree: tree)
                }
              }
            )
          ),
          f: fn(raw) {

            match translate_grammar_relation_row_match(target: target, emitted: raw) {
              Accepted { value: _, diagnostics: _ } => v2.std.diagnostic.outcome_accepted(raw)
              Rejected { diagnostics: _ } =>
                translate_node_projection_absent_fold(node: node, tree: tree, target: target)
            }
          }
        )
      }
    }
  )
}
fn translate_node(
  node: v2.std.node.Node,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match target_bundle_child_optional_type_expr_projection(target: target) {
    Accepted { value: ProjectionPresent, diagnostics: _ } =>
      translate_node_with_projection(node: node, tree: tree, target: target)
    Accepted { value: ProjectionAbsent, diagnostics: _ } =>
      translate_node_projection_absent(node: node, tree: tree, target: target)
    Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: r }
  }
}

type TypeExprProjectionPresence
  = ProjectionPresent
  | ProjectionAbsent
fn target_bundle_child_optional_type_expr_projection(
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<TypeExprProjectionPresence> {
  match target_bundle_optional_child(
    target: target,
    edge_name: ^target_model_edge_type_expression_projection
  ) {
    Accepted { value: v2.std.optional.Present { value: _ }, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: ProjectionPresent, diagnostics: d }
    Accepted { value: v2.std.optional.Absent, diagnostics: d } =>
      v2.std.diagnostic.Accepted { value: ProjectionAbsent, diagnostics: d }
    Rejected { diagnostics: r } =>
      v2.std.diagnostic.Rejected { diagnostics: r }
  }
}
fn translate_fold_step(
  acc: v2.std.diagnostic.Outcome<TranslateFoldAcc>,
  edge: v2.std.node.Edge,
  child: v2.std.diagnostic.Outcome<TranslateFoldAcc>,
  tree: v2.compiler.inferred_tree.InferredTree
) -> v2.std.diagnostic.Outcome<TranslateFoldAcc> {
  match acc {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: parent_acc, diagnostics: ad } =>
      match child {
        Accepted { value: child_acc, diagnostics: cd } =>
          v2.std.diagnostic.bind_outcome(
            o: translate_derived_parent_underived_child_gate(
              tree: tree,
              parent: parent_acc.source,
              child: child_acc.source
            ),
            f: fn(_) {
              v2.std.diagnostic.Accepted {
                value: TranslateFoldAcc {
                  source: parent_acc.source,
                  rebuilt: v2.std.node.node_rebuild(
                    n: parent_acc.rebuilt,
                    children: v2.std.algebra.list_snoc_item(
                      xs: parent_acc.rebuilt.children,
                      item: v2.std.node.Edge { label: edge.label, target: child_acc.rebuilt }
                    )
                  )
                },
                diagnostics: v2.std.diagnostic.diagnostics_merge(outer: ad, inner: cd)
              }
            }
          )
        Rejected { diagnostics: r } =>
          v2.std.diagnostic.Rejected {
            diagnostics: v2.std.diagnostic.rejected_with_pending(pending: ad, rejected: r)
          }
      }
  }
}
fn translate(
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<TargetNodeTree> {
  v2.std.diagnostic.bind_outcome(
    o: translate_grounding_derived_gate_subtree(tree: tree, root: tree.root),
    f: fn(_) {
      translate_node(node: tree.root, tree: tree, target: target)
    }
  )
}

fn translate_emitted_node(tree: v2.compiler.inferred_tree.InferredTree, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: translate(tree: tree, target: target),
    f: fn(emitted) {
      v2.std.diagnostic.outcome_accepted(emitted)
    }
  )
}

type TranslateDiagnosticReason
  = TargetBundleMalformed
  | TargetBundleDuplicateEdge
  | SgRcBundlePartial
  | GrammarInverseNotRealized
  | GrammarRelationRowNotFound
  | ConjInvalidEdge
  | ConjNamedChildMissing
  | ConcreteTokenClassMissing
  | ConcreteTokenKindInvalid
  | SerializeRecursionLimitExhausted
  | LexRuleLiteralNotFound
  | BindingSpellingNotFound
  | TypeExpressionShapeMissing
  | TypeExprKindAuthorityInvalid
  | TargetAtomRealizationLookupMiss
  | TargetFunctionSignatureRealizationLookupMiss
  | TargetTypeExprEmittedShapeMalformed

fn translate_diagnostic_reason_variants() -> std.types.List<TranslateDiagnosticReason> {
  [
    TargetBundleMalformed,
    TargetBundleDuplicateEdge,
    SgRcBundlePartial,
    GrammarInverseNotRealized,
    GrammarRelationRowNotFound,
    ConjInvalidEdge,
    ConjNamedChildMissing,
    ConcreteTokenClassMissing,
    ConcreteTokenKindInvalid,
    SerializeRecursionLimitExhausted,
    LexRuleLiteralNotFound,
    BindingSpellingNotFound,
    TypeExpressionShapeMissing,
    TypeExprKindAuthorityInvalid,
    TargetAtomRealizationLookupMiss,
    TargetFunctionSignatureRealizationLookupMiss,
    TargetTypeExprEmittedShapeMalformed
  ]
}

fn translate_diagnostic_reason_symbol(reason: TranslateDiagnosticReason) -> v2.std.node.Symbol {
  match reason {
    TargetBundleMalformed => ^translate_target_bundle_malformed
    TargetBundleDuplicateEdge => ^translate_target_bundle_duplicate_edge
    SgRcBundlePartial => ^translate_sg_rc_bundle_partial
    GrammarInverseNotRealized => ^translate_grammar_inverse_not_realized
    GrammarRelationRowNotFound => ^translate_grammar_relation_row_not_found
    ConjInvalidEdge => ^translate_conj_invalid_edge
    ConjNamedChildMissing => ^translate_conj_named_child_missing
    ConcreteTokenClassMissing => ^translate_concrete_token_class_missing
    ConcreteTokenKindInvalid => ^translate_concrete_token_kind_invalid
    SerializeRecursionLimitExhausted => ^translate_serialize_recursion_limit_exhausted
    LexRuleLiteralNotFound => ^translate_lex_rule_literal_not_found
    BindingSpellingNotFound => ^translate_binding_spelling_not_found
    TypeExpressionShapeMissing => ^translate_type_expression_shape_missing
    TypeExprKindAuthorityInvalid => ^translate_type_expr_kind_authority_invalid
    TargetAtomRealizationLookupMiss => ^target_atom_realization_lookup_miss
    TargetFunctionSignatureRealizationLookupMiss => ^target_function_signature_realization_lookup_miss
    TargetTypeExprEmittedShapeMalformed => ^target_type_expr_emitted_shape_malformed
  }
}

fn translate_diagnostic_reason_find_by_symbol(
  sym: v2.std.node.Symbol,
  variants: std.types.List<TranslateDiagnosticReason>
) -> v2.std.optional.Optional<TranslateDiagnosticReason> {
  fold(variants, init: v2.std.optional.optional_absent(), f: fn(acc, variant) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if sym == translate_diagnostic_reason_symbol(reason: variant) {
          v2.std.optional.optional_present(value: variant)
        } else {
          acc
        }
    }
  })
}

fn translate_diagnostic_reason_from_symbol(sym: v2.std.node.Symbol) -> v2.std.optional.Optional<TranslateDiagnosticReason> {
  translate_diagnostic_reason_find_by_symbol(
    sym: sym,
    variants: translate_diagnostic_reason_variants()
  )
}

fn translate_diagnostic_reason_roster() -> std.types.List<v2.std.node.Symbol> {
  fold(translate_diagnostic_reason_variants(), init: std.algebra.Empty, f: fn(acc, variant) {
    v2.std.algebra.list_snoc_item(
      xs: acc,
      item: translate_diagnostic_reason_symbol(reason: variant)
    )
  })
}

fn translate_diagnostic_reason_head(
  diagnostics: v2.std.diagnostic.NonEmptyDiagnostics
) -> v2.std.optional.Optional<TranslateDiagnosticReason> {
  translate_diagnostic_reason_from_symbol(sym: diagnostics.head.reason)
}
