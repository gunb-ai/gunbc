module v2.compiler.translate

type TargetNodeTree = v2.std.node.Node

type TargetBundleChildLookup
  = BundleChildMissing
  | BundleChildFound { value: v2.std.node.Node }
  | BundleChildDuplicate
  | BundleChildInvalidEdge

fn target_translation_rules_budget(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Int> {
  v2.std.diagnostic.bind_outcome(
    o: target_bundle_child(target: target, edge_name: ^target_model_edge_translation_rules),
    f: fn(rules) {
      v2.std.diagnostic.Accepted {
        value: v2.std.node.node_subtree_count(n: rules),
        diagnostics: v2.std.diagnostic.None
      }
    }
  )
}

fn translate_serialize_measure(target: v2.std.compilers.target_model.TargetModel, emitted: v2.std.node.Node) -> v2.std.diagnostic.Outcome<Int> {
  v2.std.diagnostic.bind_outcome(
    o: target_translation_rules_budget(target: target),
    f: fn(rules_budget) {
      v2.std.diagnostic.Accepted {
        value: v2.std.node.node_subtree_count(n: emitted) + rules_budget + 1,
        diagnostics: v2.std.diagnostic.None
      }
    }
  )
}
fn token_item_serialize_measure(item: v2.std.node.Node, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Int> {
  v2.std.diagnostic.bind_outcome(
    o: target_translation_rules_budget(target: target),
    f: fn(rules_budget) {
      v2.std.diagnostic.Accepted {
        value: v2.std.node.node_subtree_count(n: item) + rules_budget + 1,
        diagnostics: v2.std.diagnostic.None
      }
    }
  )
}
fn token_list_node_budget(tokens: std.types.List<v2.std.node.Node>) -> Int {
  v2.std.algebra.fold_list(
    xs: tokens,
    empty: 0,
    cons: fn(acc, item) { acc + v2.std.node.node_subtree_count(n: item) }
  )
}
fn token_sequence_serialize_measure(tokens: std.types.List<v2.std.node.Node>, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<Int> {
  v2.std.diagnostic.bind_outcome(
    o: target_translation_rules_budget(target: target),
    f: fn(rules_budget) {
      v2.std.diagnostic.Accepted {
        value: v2.std.algebra.length(xs: tokens) + token_list_node_budget(tokens: tokens) + rules_budget + 1,
        diagnostics: v2.std.diagnostic.None
      }
    }
  )
}

type TokenSequenceItemKind
  = TokenSequenceConcreteToken
  | TokenSequenceNonterminal

type GroundingGatePassed {}

data translate_grounding_gate_absent_facts_note: String = "Refuse only recorded GroundingNotDerived on the Holds arm, routing that variant through canonical_grounding_from_inferred_facts so the typed ^infer_grounding_not_derived diagnostic propagates (review 46789). DerivedGrounding on Holds accepts without re-running canonical admission. infer_facts_lookup_miss (Violates) is the compatibility class for trees with no infer judgment at a node: emit_orchestration's synthetic InferredTree (`orch_emit_facts_lookup`) and test-only shape-frontier carriers carry an empty facts map by construction, so lookup miss means no infer judgment exists — not an underived one recorded and erased (review 47246). Production paths (`cross_language_compile`, canonical infer→emit) pass infer's facts map facts-flow-forward. Eval refuses lookup miss because eval never runs on synthetic trees; translate is also consumed by emit, so absence is a named compatibility frontier until v2-inferred-tree-completeness splits the carrier. translate() opens with translate_grounding_derived_gate_subtree so mixed derived-root/underived-child trees cannot bypass fold attach or bodied-arrow shortcuts. translate_grounding_derived_gate_at_producer is the producer-entry call site for that same gate. translate_derived_parent_underived_child_gate refuses a recorded underived child under a derived parent during fold; translate_grounding_derived_gate_subtree covers bodied-arrow and import-carrier shortcuts that preserve producer IR without fold_node (review 46681). TranslateFoldAcc retains the source parent/child nodes because fold init rebuilds with empty children and facts.lookup keys on structural node equality. The four translate_grounding_*_gate* fns return Outcome<GroundingGatePassed>: a zero-information accept carrier (same wire-schema gate pattern as target_model.dag CtorTemplateUnit), not Outcome<Bool> — Bool would admit a meaningful false the gate never produces. Empty is a FreeMonoid variant, not a unit type, so Outcome<Empty> is an unresolved compile error. Callers bind with bind_outcome(fn(_) => ...) and never read the payload; the signal is Accepted vs Rejected disposition only."

fn translate_grounding_derived_gate(tree: v2.compiler.inferred_tree.InferredTree, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<GroundingGatePassed> {
  match v2.compiler.infer.inferred_facts_witness_for_node(tree: tree, node: node) {
    Holds { value: facts } =>
      match facts.grounding {
        GroundingNotDerived { node: _ } =>
          match v2.compiler.infer.canonical_grounding_from_inferred_facts(node: node, facts: facts) {
            Accepted { value: _, diagnostics: _ } => v2.std.diagnostic.outcome_accepted(GroundingGatePassed {})
            Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          }
        DerivedGrounding { grounding: _ } =>
          v2.std.diagnostic.outcome_accepted(GroundingGatePassed {})
      }
    Violates { diagnostic: _ } =>
      v2.std.diagnostic.outcome_accepted(GroundingGatePassed {})
  }
}

fn translate_derived_parent_underived_child_gate(
  tree: v2.compiler.inferred_tree.InferredTree,
  parent: v2.std.node.Node,
  child: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<GroundingGatePassed> {
  match v2.compiler.infer.inferred_facts_witness_for_node(tree: tree, node: parent) {
    Holds { value: parent_facts } =>
      if v2.compiler.infer.inferred_facts_grounding_derived(facts: parent_facts) {
        translate_grounding_derived_gate(tree: tree, node: child)
      } else {
        v2.std.diagnostic.outcome_accepted(GroundingGatePassed {})
      }
    Violates { diagnostic: _ } =>
      translate_grounding_derived_gate(tree: tree, node: child)
  }
}

fn translate_grounding_derived_gate_subtree(
  tree: v2.compiler.inferred_tree.InferredTree,
  root: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<GroundingGatePassed> {
  v2.std.algebra.fold_list(
    xs: v2.std.node.node_subtree_nodes(root: root),
    empty: v2.std.diagnostic.outcome_accepted(GroundingGatePassed {}),
    cons: fn(acc, n) {
      v2.std.diagnostic.bind_outcome(
        o: acc,
        f: fn(_) {
          translate_grounding_derived_gate(tree: tree, node: n)
        }
      )
    }
  )
}

fn translate_bodied_arrow_shortcut_after_subtree_gate(
  tree: v2.compiler.inferred_tree.InferredTree,
  arrow: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: translate_grounding_derived_gate_subtree(tree: tree, root: arrow),
    f: fn(_) {
      translate_bodied_arrow_preserve_producer_ir(arrow: arrow)
    }
  )
}

fn translate_projection_absent_bodied_arrow_fold_init(
  tree: v2.compiler.inferred_tree.InferredTree,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: translate_grounding_derived_gate_subtree(tree: tree, root: node),
    f: fn(_) {
      translate_type_fold_init(node: node)
    }
  )
}

fn translate_import_shortcut_after_subtree_gate(
  tree: v2.compiler.inferred_tree.InferredTree,
  import_node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: translate_grounding_derived_gate_subtree(tree: tree, root: import_node),
    f: fn(_) {
      translate_import_production_to_carrier(import_node: import_node)
    }
  )
}

fn translate_grounding_derived_gate_at_producer(
  tree: v2.compiler.inferred_tree.InferredTree,
  node: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<GroundingGatePassed> {
  translate_grounding_derived_gate(tree: tree, node: node)
}

fn translate_target_bundle_malformed_diagnostic(target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_target_bundle_malformed,
    at: v2.std.diagnostic.node_locus(node: target.bundle),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
fn translate_target_bundle_duplicate_edge_diagnostic(
  target: v2.std.compilers.target_model.TargetModel,
  edge_name: v2.std.node.Symbol
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_target_bundle_duplicate_edge,
    at: v2.std.diagnostic.node_locus(node: target.bundle),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
fn translate_sg_rc_bundle_partial_diagnostic(source_carrier: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_sg_rc_bundle_partial,
    at: v2.std.diagnostic.node_locus(node: source_carrier),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
fn target_bundle_child_lookup_step(
  acc: TargetBundleChildLookup,
  e: v2.std.node.Edge,
  edge_name: v2.std.node.Symbol
) -> TargetBundleChildLookup {
  match acc {
    BundleChildInvalidEdge => acc
    BundleChildDuplicate => acc
    BundleChildMissing =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            BundleChildFound { value: e.target }
          } else {
            acc
          }
        Positional => BundleChildInvalidEdge
      }
    BundleChildFound { value: _ } =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            BundleChildDuplicate
          } else {
            acc
          }
        Positional => BundleChildInvalidEdge
      }
  }
}
fn conj_named_child(parent: v2.std.node.Node, edge_name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match parent.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          v2.std.diagnostic.Accepted { value: child, diagnostics: v2.std.diagnostic.None }
        BundleChildMissing =>
          v2.std.diagnostic.outcome_rejected(translate_conj_named_child_missing_diagnostic(parent: parent))
        BundleChildDuplicate =>
          v2.std.diagnostic.outcome_rejected(
            v2.std.diagnostic.Diagnostic {
              reason: ^translate_target_bundle_duplicate_edge,
              at: v2.std.diagnostic.node_locus(node: parent),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          v2.std.diagnostic.outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^translate_grammar_inverse_not_realized,
          at: v2.std.diagnostic.node_locus(node: parent),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}
fn conj_optional_named_child(parent: v2.std.node.Node, edge_name: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node?> {
  match parent.kind {
    TypeNode { connective: v2.std.node.Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          v2.std.diagnostic.Accepted { value: v2.std.optional.Present { value: child }, diagnostics: v2.std.diagnostic.None }
        BundleChildMissing =>
          v2.std.diagnostic.Accepted { value: v2.std.optional.Absent, diagnostics: v2.std.diagnostic.None }
        BundleChildDuplicate =>
          v2.std.diagnostic.outcome_rejected(
            v2.std.diagnostic.Diagnostic {
              reason: ^translate_target_bundle_duplicate_edge,
              at: v2.std.diagnostic.node_locus(node: parent),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          v2.std.diagnostic.outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      v2.std.diagnostic.outcome_rejected(
        v2.std.diagnostic.Diagnostic {
          reason: ^translate_grammar_inverse_not_realized,
          at: v2.std.diagnostic.node_locus(node: parent),
          correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
        }
      )
  }
}
fn translate_grammar_inverse_not_realized_diagnostic(emitted: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^translate_grammar_inverse_not_realized,
    at: v2.std.diagnostic.node_locus(node: emitted),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}
