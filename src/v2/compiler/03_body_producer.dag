}

fn produce_mvp1_loop_arrow_with_body_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: produce_mvp1_loop_arrow_signature_from_resolved(resolved_root: resolved_root),
    f: fn(signature) {
      bind_outcome(
        o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
        f: fn(atoms) {
          bind_outcome(
            o: body_producer_loop_body_from_atoms(atoms: atoms, witness: resolved_root),
            f: fn(body) {
              bind_outcome(
                o: attach_arrow_body(arrow: signature, body: body),
                f: fn(arrow_with_body) {
                  if well_formed(n: arrow_with_body) {
                    outcome_accepted(value: arrow_with_body)
                  } else {
                    outcome_rejected(
                      d: body_producer_diagnostic(
                        reason: ^body_producer_reason_post_produce_not_well_formed,
                        n: arrow_with_body
                      )
                    )
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_bind_arrow_with_body_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: produce_mvp1_bind_arrow_signature_from_resolved(resolved_root: resolved_root),
    f: fn(signature) {
      bind_outcome(
        o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
        f: fn(atoms) {
          bind_outcome(
            o: body_producer_bind_body_from_atoms(atoms: atoms, witness: resolved_root),
            f: fn(body) {
              bind_outcome(
                o: attach_arrow_body(arrow: signature, body: body),
                f: fn(arrow_with_body) {
                  if well_formed(n: arrow_with_body) {
                    outcome_accepted(value: arrow_with_body)
                  } else {
                    outcome_rejected(
                      d: body_producer_diagnostic(
                        reason: ^body_producer_reason_post_produce_not_well_formed,
                        n: arrow_with_body
                      )
                    )
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

