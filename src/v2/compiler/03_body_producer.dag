module v2.compiler.body_producer


fn body_producer_diagnostic(reason: v2.std.node.Symbol, n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn attach_arrow_body(arrow: v2.std.node.Node, body: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match arrow.kind {
    v2.std.node.TypeNode { connective: v2.std.node.Arrow } =>
      v2.std.diagnostic.outcome_accepted(
        value: v2.std.node.node_rebuild(
          n: arrow,
          children: v2.std.algebra.list_snoc_item(
            xs: arrow.children,
            item: v2.std.node.Edge {
              label: v2.std.node.Named { name: ^arrow_body_edge },
              target: body
            }
          )
        )
      )
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: body_producer_diagnostic(
          reason: ^body_producer_reason_malformed_attachment,
          n: arrow
        )
      )
  }
}

fn body_producer_validated_behavior(body: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if v2.std.node.well_formed(n: body) {
    v2.std.diagnostic.outcome_accepted(value: body)
  } else {
    v2.std.diagnostic.outcome_rejected(
      d: body_producer_diagnostic(
        reason: ^body_producer_reason_post_produce_not_well_formed,
        n: body
      )
    )
  }
}

fn body_producer_dispatch_structured_body(body: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match body.kind {
    v2.std.node.ComputationNode { behavior: _ } => body_producer_validated_behavior(body: body)
    _ =>
      v2.std.diagnostic.outcome_rejected(
        d: body_producer_diagnostic(
          reason: ^body_producer_reason_resolved_shape,
          n: body
        )
      )
  }
}

fn produce_arrow_with_structured_body(signature: v2.std.node.Node, structured_body: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.bind_outcome(
    o: body_producer_dispatch_structured_body(body: structured_body),
    f: fn(validated) {
      attach_arrow_body(arrow: signature, body: validated)
    }
  )
}
