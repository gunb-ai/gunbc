module v2.compiler.body_producer

import v2.std.algebra { list_append, list_snoc_item }
import v2.std.collection { Absent, List, Optional, Present, list_at_optional, optional_absent }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.node {
  Arrow,
  Atom,
  Bind,
  Branch,
  ComputationNode,
  Conj,
  Edge,
  Loop,
  Match,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  Value,
  node_rebuild,
  node_synthetic,
  well_formed
}
import v2.extdeps.languages.dag {
  dag_mvp1_add_arrow_signature_node,
  dag_mvp1_add_arrow_with_body_swapped_operands_fixture,
  dag_mvp1_add_operator_node,
  dag_mvp1_captured_flat_atom_binding_for_ident,
  dag_mvp1_int_type_binding,
  dag_mvp1_loop_arrow_with_body_fixture,
  dag_mvp1_loop_arrow_with_body_wrong_value_fixture,
  dag_mvp1_loop_captured_flat_atom_binding_for_ident,
  dag_mvp1_loop_measure_node,
  dag_mvp1_match_arrow_with_body_fixture,
  dag_mvp1_match_arrow_with_body_swapped_arms_fixture,
  dag_mvp1_node_is_int_literal_atom,
  dag_mvp1_node_is_kw_false_atom,
  dag_mvp1_node_is_kw_true_atom,
  dag_mvp1_pick_arrow_with_body_fixture,
  dag_mvp1_pick_arrow_with_body_swapped_arms_fixture,
  dag_mvp1_pick_captured_flat_atom_binding_for_ident,
  dag_mvp1_bind_arrow_with_body_fixture,
  dag_mvp1_bind_arrow_with_body_wrong_value_fixture,
  dag_mvp1_bind_captured_flat_atom_binding_for_ident
}
import v2.std.node_query {
  arrow_domain_named_param_bindings,
  find_arrow_body_child,
  find_named_child
}

data body_producer_pick_lit_one: Symbol = ^dag_mvp1_pick_lit_one
data body_producer_pick_lit_two: Symbol = ^dag_mvp1_pick_lit_two
data body_producer_pick_kw_true: Symbol = ^dag_token_kw_true
data body_producer_pick_kw_false: Symbol = ^dag_token_kw_false

fn body_producer_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn type_atom_node(identity: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: []
  )
}

fn computation_param_ref_node(identity: Symbol) -> Node {
  type_atom_node(identity: identity)
}

fn attach_arrow_body(arrow: Node, body: Node) -> Outcome<Node> {
  match arrow.kind {
    TypeNode { connective: Arrow } =>
      outcome_accepted(
        value: node_rebuild(
          n: arrow,
          children: list_snoc_item(
            xs: arrow.children,
            item: Edge {
              label: Named { name: ^arrow_body_edge },
              target: body
            }
          )
        )
      )
    _ =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: ^body_producer_reason_malformed_attachment,
          n: arrow
        )
      )
  }
}

fn body_producer_validated_behavior(body: Node) -> Outcome<Node> {
  if well_formed(n: body) {
    outcome_accepted(value: body)
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: ^body_producer_reason_post_produce_not_well_formed,
        n: body
      )
    )
  }
}

fn body_producer_dispatch_structured_body(body: Node) -> Outcome<Node> {
  match body.kind {
    ComputationNode { behavior: _ } => body_producer_validated_behavior(body: body)
    _ =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: ^body_producer_reason_mvp1_resolved_shape,
          n: body
        )
      )
  }
}

fn produce_arrow_with_structured_body(signature: Node, structured_body: Node) -> Outcome<Node> {
  bind_outcome(
    o: body_producer_dispatch_structured_body(body: structured_body),
    f: fn(validated) {
      attach_arrow_body(arrow: signature, body: validated)
    }
  )
}

fn body_producer_arrow_domain_conj_from_binding_ids(bindings: List<Symbol>) -> Outcome<Node> {
  match list_at_optional(xs: bindings, index: 0) {
    Absent =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: ^body_producer_reason_mvp1_resolved_shape,
          n: node_synthetic(kind: TypeNode { connective: Conj }, children: [])
        )
      )
    Present { value: left_binding } =>
      match list_at_optional(xs: bindings, index: 1) {
        Absent =>
          outcome_rejected(
            d: body_producer_diagnostic(
              reason: ^body_producer_reason_mvp1_resolved_shape,
              n: node_synthetic(kind: TypeNode { connective: Conj }, children: [])
            )
          )
        Present { value: right_binding } =>
          outcome_accepted(
            value: node_synthetic(
              kind: TypeNode { connective: Conj },
              children: [
                Edge {
                  label: Named { name: left_binding },
                  target: type_atom_node(identity: dag_mvp1_int_type_binding())
                },
                Edge {
                  label: Named { name: right_binding },
                  target: type_atom_node(identity: dag_mvp1_int_type_binding())
                }
              ]
            )
          )
      }
  }
}

fn body_producer_transform_body_from_bindings(
  operator: Node,
  param_bindings: List<Symbol>
) -> Outcome<Node> {
  match list_at_optional(xs: param_bindings, index: 0) {
    Absent =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: ^body_producer_reason_mvp1_resolved_shape,
          n: operator
        )
      )
    Present { value: left_binding } =>
      match list_at_optional(xs: param_bindings, index: 1) {
        Absent =>
          outcome_rejected(
            d: body_producer_diagnostic(
              reason: ^body_producer_reason_mvp1_resolved_shape,
              n: operator
            )
          )
        Present { value: right_binding } =>
          outcome_accepted(
            value: node_synthetic(
              kind: ComputationNode { behavior: Transform },
              children: [
                Edge { label: Positional, target: operator },
                Edge {
                  label: Positional,
                  target: computation_param_ref_node(identity: left_binding)
                },
                Edge {
                  label: Positional,
                  target: computation_param_ref_node(identity: right_binding)
                }
              ]
            )
          )
      }
  }
}

fn mvp1_flat_atom_at(
  atoms: List<Node>,
  wanted: Int,
  reason: Symbol,
  witness: Node
) -> Outcome<Node> {
  match list_at_optional(xs: atoms, index: wanted) {
    Present { value: child } => outcome_accepted(value: child)
    Absent =>
      outcome_rejected(
        d: body_producer_diagnostic(reason: reason, n: witness)
      )
  }
}

fn mvp1_atom_has_binding_identity(node: Node, wanted_binding: Symbol) -> Bool {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } => id == wanted_binding
    _ => false
  }
}

fn mvp1_resolved_first_atom_with_binding(
  atoms: List<Node>,
  wanted_binding: Symbol,
  reason: Symbol,
  witness: Node
) -> Outcome<Node> {
  match fold(atoms, init: optional_absent(), f: fn(found, atom) {
    match found {
      Present { value: _ } => found
      Absent =>
        match mvp1_atom_has_binding_identity(node: atom, wanted_binding: wanted_binding) {
          true => Present { value: atom }
          false => Absent
        }
    }
  }) {
    Present { value: node } => outcome_accepted(value: node)
    Absent =>
      outcome_rejected(
        d: body_producer_diagnostic(reason: reason, n: witness)
      )
  }
}

fn mvp1_sequence_flatten_atoms(root: Node) -> Outcome<List<Node>> {
  match root.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      outcome_accepted(value: [root])
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: find_named_child(root: root, name: ^grammar_sequence_left_node_projection),
        f: fn(left) {
          bind_outcome(
            o: find_named_child(root: root, name: ^grammar_sequence_right_node_projection),
            f: fn(right) {
              bind_outcome(
                o: mvp1_sequence_flatten_atoms(root: left),
                f: fn(left_atoms) {
                  bind_outcome(
                    o: mvp1_sequence_flatten_atoms(root: right),
                    f: fn(right_atoms) {
                      outcome_accepted(
                        value: list_append(left: left_atoms, right: right_atoms)
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: ^body_producer_reason_mvp1_resolved_shape,
          n: root
        )
      )
  }
}

fn mvp1_resolved_captured_atoms(resolved_root: Node) -> Outcome<List<Node>> {
  bind_outcome(
    o: find_named_child(
      root: resolved_root,
      name: ^grammar_production_captured_node_projection
    ),
    f: fn(captured) {
      mvp1_sequence_flatten_atoms(root: captured)
    }
  )
}

fn produce_mvp1_add_arrow_signature_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
    f: fn(atoms) {
      bind_outcome(
        o: mvp1_resolved_first_atom_with_binding(
          atoms: atoms,
          wanted_binding: ^dag_binding_param_x,
          reason: ^body_producer_reason_mvp1_resolved_shape,
          witness: resolved_root
        ),
        f: fn(domain_x) {
          bind_outcome(
            o: mvp1_resolved_first_atom_with_binding(
              atoms: atoms,
              wanted_binding: ^dag_binding_param_y,
              reason: ^body_producer_reason_mvp1_resolved_shape,
              witness: resolved_root
            ),
            f: fn(domain_y) {
              bind_outcome(
                o: mvp1_flat_atom_at(
                  atoms: atoms,
                  wanted: 12,
                  reason: ^body_producer_reason_mvp1_resolved_shape,
                  witness: resolved_root
                ),
                f: fn(codomain) {
                  bind_outcome(
                    o: dag_mvp1_captured_flat_atom_binding_for_ident(
                      flat_index: 5,
                      ident_atom: domain_x
                    ),
                    f: fn(left_binding) {
                      bind_outcome(
                        o: dag_mvp1_captured_flat_atom_binding_for_ident(
                          flat_index: 9,
                          ident_atom: domain_y
                        ),
                        f: fn(right_binding) {
                          bind_outcome(
                            o: dag_mvp1_captured_flat_atom_binding_for_ident(
                              flat_index: 12,
                              ident_atom: codomain
                            ),
                            f: fn(codomain_binding) {
                              bind_outcome(
                                o: body_producer_arrow_domain_conj_from_binding_ids(
                                  bindings: [left_binding, right_binding]
                                ),
                                f: fn(domain) {
                                  outcome_accepted(
                                    value: node_synthetic(
                                      kind: TypeNode { connective: Arrow },
                                      children: [
                                        Edge {
                                          label: Positional,
                                          target: domain
                                        },
                                        Edge {
                                          label: Positional,
                                          target: type_atom_node(identity: codomain_binding)
                                        },
                                        Edge {
                                          label: Positional,
                                          target: type_atom_node(identity: codomain_binding)
                                        }
                                      ]
                                    )
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_add_arrow_with_body_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: produce_mvp1_add_arrow_signature_from_resolved(resolved_root: resolved_root),
    f: fn(signature) {
      bind_outcome(
        o: arrow_domain_named_param_bindings(arrow: signature),
        f: fn(param_bindings) {
          bind_outcome(
            o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
            f: fn(atoms) {
              bind_outcome(
                o: mvp1_flat_atom_at(
                  atoms: atoms,
                  wanted: 15,
                  reason: ^body_producer_reason_mvp1_resolved_shape,
                  witness: resolved_root
                ),
                f: fn(operator) {
                  bind_outcome(
                    o: body_producer_transform_body_from_bindings(
                      operator: operator,
                      param_bindings: param_bindings
                    ),
                    f: fn(body) {
                      bind_outcome(
                        o: attach_arrow_body(arrow: signature, body: body),
                        f: fn(arrow_with_body) {
                          if well_formed(n: arrow_with_body) {
                            outcome_accepted(value: arrow_with_body)
                          } else {
                            outcome_rejected(
                              d: body_producer_diagnostic(
                                reason: ^body_producer_reason_post_produce_not_well_formed,
                                n: arrow_with_body
                              )
                            )
                          }
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_add_arrow_with_body() -> Outcome<Node> {
  let signature = dag_mvp1_add_arrow_signature_node()
  bind_outcome(
    o: arrow_domain_named_param_bindings(arrow: signature),
    f: fn(param_bindings) {
      bind_outcome(
        o: body_producer_transform_body_from_bindings(
          operator: dag_mvp1_add_operator_node(),
          param_bindings: param_bindings
        ),
        f: fn(body) {
          bind_outcome(
            o: attach_arrow_body(arrow: signature, body: body),
            f: fn(arrow_with_body) {
              if well_formed(n: arrow_with_body) {
                outcome_accepted(value: arrow_with_body)
              } else {
                outcome_rejected(
                  d: body_producer_diagnostic(
                    reason: ^body_producer_reason_post_produce_not_well_formed,
                    n: arrow_with_body
                  )
                )
              }
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_add_arrow_with_body_swapped_operands() -> Outcome<Node> {
  if well_formed(n: dag_mvp1_add_arrow_with_body_swapped_operands_fixture) {
    outcome_accepted(value: dag_mvp1_add_arrow_with_body_swapped_operands_fixture)
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: ^body_producer_reason_post_produce_not_well_formed,
        n: dag_mvp1_add_arrow_with_body_swapped_operands_fixture
      )
    )
  }
}

fn produce_mvp1_add_decl_node(fn_name: Symbol) -> Outcome<Node> {
  bind_outcome(
    o: produce_mvp1_add_arrow_with_body(),
    f: fn(arrow_with_body) {
      outcome_accepted(
        value: node_synthetic(
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Named { name: fn_name },
              target: arrow_with_body
            }
          ]
        )
      )
    }
  )
}

fn arrow_has_body_edge(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: _ } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn body_producer_branch_if_body(
  condition: Node,
  then_arm: Node,
  else_arm: Node
) -> Outcome<Node> {
  outcome_accepted(
    value: node_synthetic(
      kind: ComputationNode { behavior: Branch },
      children: [
        Edge { label: Positional, target: condition },
        Edge { label: Positional, target: then_arm },
        Edge { label: Positional, target: else_arm }
      ]
    )
  )
}

fn body_producer_pick_condition_from_atom(cond: Node) -> Outcome<Node> {
  if dag_mvp1_node_is_kw_true_atom(node: cond) {
    outcome_accepted(value: type_atom_node(identity: body_producer_pick_kw_true))
  } else if dag_mvp1_node_is_kw_false_atom(node: cond) {
    outcome_accepted(value: type_atom_node(identity: body_producer_pick_kw_false))
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: ^body_producer_reason_mvp1_resolved_shape,
        n: cond
      )
    )
  }
}

fn body_producer_pick_if_body_from_atoms(
  atoms: List<Node>,
  witness: Node
) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_flat_atom_at(
      atoms: atoms,
      wanted: 8,
      reason: ^body_producer_reason_mvp1_resolved_shape,
      witness: witness
    ),
    f: fn(cond) {
      bind_outcome(
        o: mvp1_flat_atom_at(
          atoms: atoms,
          wanted: 10,
          reason: ^body_producer_reason_mvp1_resolved_shape,
          witness: witness
        ),
        f: fn(then_arm) {
          bind_outcome(
            o: mvp1_flat_atom_at(
              atoms: atoms,
              wanted: 12,
              reason: ^body_producer_reason_mvp1_resolved_shape,
              witness: witness
            ),
            f: fn(else_arm) {
              if dag_mvp1_node_is_int_literal_atom(node: then_arm)
                && dag_mvp1_node_is_int_literal_atom(node: else_arm) {
                bind_outcome(
                  o: body_producer_pick_condition_from_atom(cond: cond),
                  f: fn(condition) {
                    body_producer_branch_if_body(
                      condition: condition,
                      then_arm: type_atom_node(identity: body_producer_pick_lit_one),
                      else_arm: type_atom_node(identity: body_producer_pick_lit_two)
                    )
                  }
                )
              } else {
                outcome_rejected(
                  d: body_producer_diagnostic(
                    reason: ^body_producer_reason_mvp1_resolved_shape,
                    n: witness
                  )
                )
              }
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_pick_if_arrow_signature_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
    f: fn(atoms) {
      bind_outcome(
        o: mvp1_flat_atom_at(
          atoms: atoms,
          wanted: 5,
          reason: ^body_producer_reason_mvp1_resolved_shape,
          witness: resolved_root
        ),
        f: fn(codomain) {
          bind_outcome(
            o: dag_mvp1_pick_captured_flat_atom_binding_for_ident(
              flat_index: 5,
              ident_atom: codomain
            ),
            f: fn(codomain_binding) {
              outcome_accepted(
                value: node_synthetic(
                  kind: TypeNode { connective: Arrow },
                  children: [
                    Edge {
                      label: Positional,
                      target: node_synthetic(
                        kind: TypeNode { connective: Conj },
                        children: []
                      )
                    },
                    Edge {
                      label: Positional,
                      target: type_atom_node(identity: codomain_binding)
                    },
                    Edge {
                      label: Positional,
                      target: type_atom_node(identity: codomain_binding)
                    }
                  ]
                )
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_pick_if_arrow_with_body_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: produce_mvp1_pick_if_arrow_signature_from_resolved(resolved_root: resolved_root),
    f: fn(signature) {
      bind_outcome(
        o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
        f: fn(atoms) {
          bind_outcome(
            o: body_producer_pick_if_body_from_atoms(atoms: atoms, witness: resolved_root),
            f: fn(body) {
              bind_outcome(
                o: attach_arrow_body(arrow: signature, body: body),
                f: fn(arrow_with_body) {
                  if well_formed(n: arrow_with_body) {
                    outcome_accepted(value: arrow_with_body)
                  } else {
                    outcome_rejected(
                      d: body_producer_diagnostic(
                        reason: ^body_producer_reason_post_produce_not_well_formed,
                        n: arrow_with_body
                      )
                    )
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_pick_if_arrow_with_body() -> Outcome<Node> {
  if well_formed(n: dag_mvp1_pick_arrow_with_body_fixture) {
    outcome_accepted(value: dag_mvp1_pick_arrow_with_body_fixture)
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: ^body_producer_reason_post_produce_not_well_formed,
        n: dag_mvp1_pick_arrow_with_body_fixture
      )
    )
  }
}

fn produce_mvp1_pick_if_arrow_with_body_swapped_arms() -> Outcome<Node> {
  if well_formed(n: dag_mvp1_pick_arrow_with_body_swapped_arms_fixture) {
    outcome_accepted(value: dag_mvp1_pick_arrow_with_body_swapped_arms_fixture)
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: ^body_producer_reason_post_produce_not_well_formed,
        n: dag_mvp1_pick_arrow_with_body_swapped_arms_fixture
      )
    )
  }
}

fn body_producer_match_if_body(
  scrutinee: Node,
  true_arm: Node,
  false_arm: Node
) -> Outcome<Node> {
  outcome_accepted(
    value: node_synthetic(
      kind: ComputationNode { behavior: Match },
      children: [
        Edge { label: Positional, target: scrutinee },
        Edge { label: Positional, target: true_arm },
        Edge { label: Positional, target: false_arm }
      ]
    )
  )
}

fn produce_mvp1_match_arrow_with_body() -> Outcome<Node> {
  outcome_accepted(value: dag_mvp1_match_arrow_with_body_fixture)
}

fn produce_mvp1_match_arrow_with_body_swapped_arms() -> Outcome<Node> {
  outcome_accepted(value: dag_mvp1_match_arrow_with_body_swapped_arms_fixture)
}

fn body_producer_bind_let_body(
  key_binding: Symbol,
  value: Node,
  body: Node
) -> Outcome<Node> {
  outcome_accepted(
    value: node_synthetic(
      kind: ComputationNode { behavior: Bind },
      children: [
        Edge { label: Positional, target: type_atom_node(identity: key_binding) },
        Edge { label: Positional, target: value },
        Edge { label: Positional, target: body }
      ]
    )
  )
}

fn body_producer_bind_value_lit_from_atom(val: Node, witness: Node) -> Outcome<Node> {
  if dag_mvp1_node_is_int_literal_atom(node: val) {
    outcome_accepted(value: type_atom_node(identity: body_producer_pick_lit_one))
  } else {
    match val.kind {
      TypeNode { connective: Atom { identity: id } } =>
        if (id == body_producer_pick_lit_one) || (id == ^dag_binding_mvp1_pick_lit_one) {
          outcome_accepted(value: type_atom_node(identity: body_producer_pick_lit_one))
        } else if (id == body_producer_pick_lit_two) || (id == ^dag_binding_mvp1_pick_lit_two) {
          outcome_accepted(value: type_atom_node(identity: body_producer_pick_lit_two))
        } else {
          outcome_rejected(
            d: body_producer_diagnostic(
              reason: ^body_producer_reason_mvp1_resolved_shape,
              n: witness
            )
          )
        }
      _ =>
        outcome_rejected(
          d: body_producer_diagnostic(
            reason: ^body_producer_reason_mvp1_resolved_shape,
            n: witness
          )
        )
    }
  }
}

fn body_producer_mvp1_value_lit_from_atom(val: Node, witness: Node) -> Outcome<Node> {
  if dag_mvp1_node_is_int_literal_atom(node: val) {
    outcome_accepted(value: type_atom_node(identity: body_producer_pick_lit_one))
  } else {
    match val.kind {
      TypeNode { connective: Atom { identity: id } } =>
        if (id == body_producer_pick_lit_one) || (id == ^dag_binding_mvp1_pick_lit_one) {
          outcome_accepted(value: type_atom_node(identity: body_producer_pick_lit_one))
        } else if (id == body_producer_pick_lit_two) || (id == ^dag_binding_mvp1_pick_lit_two) {
          outcome_accepted(value: type_atom_node(identity: body_producer_pick_lit_two))
        } else {
          outcome_rejected(
            d: body_producer_diagnostic(
              reason: ^body_producer_reason_mvp1_resolved_shape,
              n: witness
            )
          )
        }
      _ =>
        outcome_rejected(
          d: body_producer_diagnostic(
            reason: ^body_producer_reason_mvp1_resolved_shape,
            n: witness
          )
        )
    }
  }
}

fn body_producer_loop_body(body_lit: Node, measure: Node) -> Outcome<Node> {
  outcome_accepted(
    value: node_synthetic(
      kind: ComputationNode { behavior: Loop },
      children: [
        Edge { label: Positional, target: body_lit },
        Edge { label: Named { name: ^loop_bound_edge }, target: measure }
      ]
    )
  )
}

fn body_producer_loop_body_from_atoms(
  atoms: List<Node>,
  witness: Node
) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_flat_atom_at(
      atoms: atoms,
      wanted: 8,
      reason: ^body_producer_reason_mvp1_resolved_shape,
      witness: witness
    ),
    f: fn(body_atom) {
      bind_outcome(
        o: body_producer_mvp1_value_lit_from_atom(val: body_atom, witness: witness),
        f: fn(body_lit) {
          body_producer_loop_body(
            body_lit: body_lit,
            measure: dag_mvp1_loop_measure_node()
          )
        }
      )
    }
  )
}

fn body_producer_bind_body_from_atoms(
  atoms: List<Node>,
  witness: Node
) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_flat_atom_at(
      atoms: atoms,
      wanted: 8,
      reason: ^body_producer_reason_mvp1_resolved_shape,
      witness: witness
    ),
    f: fn(key_atom) {
      bind_outcome(
        o: mvp1_flat_atom_at(
          atoms: atoms,
          wanted: 10,
          reason: ^body_producer_reason_mvp1_resolved_shape,
          witness: witness
        ),
        f: fn(val_atom) {
          bind_outcome(
            o: mvp1_flat_atom_at(
              atoms: atoms,
              wanted: 12,
              reason: ^body_producer_reason_mvp1_resolved_shape,
              witness: witness
            ),
            f: fn(body_atom) {
              bind_outcome(
                o: dag_mvp1_bind_captured_flat_atom_binding_for_ident(
                  flat_index: 8,
                  ident_atom: key_atom
                ),
                f: fn(key_binding) {
                  bind_outcome(
                    o: body_producer_bind_value_lit_from_atom(val: val_atom, witness: witness),
                    f: fn(value) {
                      bind_outcome(
                        o: dag_mvp1_bind_captured_flat_atom_binding_for_ident(
                          flat_index: 12,
                          ident_atom: body_atom
                        ),
                        f: fn(body_binding) {
                          body_producer_bind_let_body(
                            key_binding: key_binding,
                            value: value,
                            body: type_atom_node(identity: body_binding)
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_loop_arrow_signature_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
    f: fn(atoms) {
      bind_outcome(
        o: mvp1_flat_atom_at(
          atoms: atoms,
          wanted: 5,
          reason: ^body_producer_reason_mvp1_resolved_shape,
          witness: resolved_root
        ),
        f: fn(codomain) {
          bind_outcome(
            o: dag_mvp1_loop_captured_flat_atom_binding_for_ident(
              flat_index: 5,
              ident_atom: codomain
            ),
            f: fn(codomain_binding) {
              outcome_accepted(
                value: node_synthetic(
                  kind: TypeNode { connective: Arrow },
                  children: [
                    Edge {
                      label: Positional,
                      target: node_synthetic(
                        kind: TypeNode { connective: Conj },
                        children: []
                      )
                    },
                    Edge {
                      label: Positional,
                      target: type_atom_node(identity: codomain_binding)
                    },
                    Edge {
                      label: Positional,
                      target: type_atom_node(identity: codomain_binding)
                    }
                  ]
                )
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_bind_arrow_signature_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
    f: fn(atoms) {
      bind_outcome(
        o: mvp1_flat_atom_at(
          atoms: atoms,
          wanted: 5,
          reason: ^body_producer_reason_mvp1_resolved_shape,
          witness: resolved_root
        ),
        f: fn(codomain) {
          bind_outcome(
            o: dag_mvp1_bind_captured_flat_atom_binding_for_ident(
              flat_index: 5,
              ident_atom: codomain
            ),
            f: fn(codomain_binding) {
              outcome_accepted(
                value: node_synthetic(
                  kind: TypeNode { connective: Arrow },
                  children: [
                    Edge {
                      label: Positional,
                      target: node_synthetic(
                        kind: TypeNode { connective: Conj },
                        children: []
                      )
                    },
                    Edge {
                      label: Positional,
                      target: type_atom_node(identity: codomain_binding)
                    },
