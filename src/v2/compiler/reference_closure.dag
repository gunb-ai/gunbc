module v2.compiler.reference_closure

import std.algebra { Cons, Empty, FreeMonoid }
import v2.std.algebra { contains, fold_list, list_snoc_item }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.symbol_index { SymbolIndex, symbol_index_lookup }
import v2.std.optional { Absent, Present }
import v2.std.qualified_name {
  QualifiedName,
  declaration_reference_path_optional,
  qualified_name_owning_module
}

// THE REFERENCE-DERIVED CLOSURE OF ONE ENTRY: every module the entry reaches through a resolved
// declaration reference or an import row, to a fixpoint. It is the set the seed computes as
// v1_compiler.cli_run.entry_resolve load_sources_for_entry_with_index (imports, dotted references
// and bare names, one joint fixpoint), derived here from the RESOLVER'S OWN ANSWER rather than from
// a second reading of the source: v2.compiler.resolve resolved_reference_node mints every corpus
// declaration reference as its declaring QualifiedName spine, and
// v2.std.qualified_name declaration_reference_path_optional reads it back. So a bare name reaches
// its module exactly when the resolver bound it there, which is the only authority for what a bare
// name denotes (DESIGN section 3). It does NOT consult v2.compiler.resolution_provenance, which is
// frozen as a second resolver (resolution_provenance_second_resolver_dissolve_on).
//
// IMPORT ROWS ARE READ BESIDE THE RESOLVED TREE because the graft dissolves import decls, so an
// import no body mentions leaves no reference in the resolved tree, and the seed's closure still
// follows it.
//
// HOW A MEMBER IS RESOLVED IS SUPPLIED, NOT DECIDED HERE. The fold owns the graph: which modules are
// reached, in what order, and which refusals stop it. The resolution of one member comes from the
// caller, so the same fold runs over members resolved against a whole-ingest context today and
// against a context whose non-members come from the census (v2.std.namespace_alias
// ModuleBindingSource rows) when that producer lands; the door change brings that supplier. That later route is the one this fold exists for; see
// the owed claim below.
//
// EVERY DEFICIT REFUSES; NONE WIDENS. A member that does not resolve, a reference whose declaring
// path no rostered module owns, and an entry that is not rostered each refuse with a located, typed
// cause. Substituting the whole roster for an unreadable member would be the absorbing arm DESIGN
// section 5 forbids.

// WHAT THE SUPPLIER HANDS BACK FOR ONE MEMBER, and what the fold hands back for every member it
// reached. `payload` is whatever the caller produced on the way to `resolved` (the door carries the
// member's normalized tree), returned beside the module identity so a consumer that needs it again
// reads it here instead of producing it a second time (DESIGN section 2).
type ReferenceClosureMember<P> {
  resolved: Node
  import_targets: FreeMonoid<QualifiedName>
  payload: P
}

type ReferenceClosureVisit<P> {
  module: QualifiedName
  member: ReferenceClosureMember<P>
}

type ReferenceClosureState<P> {
  reached: FreeMonoid<QualifiedName>
  visits: FreeMonoid<ReferenceClosureVisit<P>>
  queue: FreeMonoid<QualifiedName>
}

type ReferenceClosureNeighbours
  = ReferenceClosureNeighboursRead { modules: FreeMonoid<QualifiedName> }
  | ReferenceClosureTargetOwnerless { target: QualifiedName, at: Node }

// OWED INHABITANCE CLAIM, declared rather than implied. The witnesses over this fold supply the
// member resolution from a whole-ingest ResolutionContext over a fixture corpus: a supplied-input
// claim at this interface (DESIGN section 3), which does not establish that the self-host closure is
// derived correctly. Owed: the same fold, run by the door route with non-member declarations from
// the census producer, answering set-equal at module identity with the seed's reference-derived
// closure of v2.compiler.compile (producer v1_compiler.cli_run.entry_resolve
// load_sources_for_entry_with_index). TRIGGER: the door change that routes v2.cli.compile_cli
// through this fold carries that control.

fn reference_closure_qn_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  a == b
}

fn reference_closure_diagnostic(reason: Symbol, at: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// A SPINE IS READ WHOLE AND NOT DESCENDED INTO. v2.std.qualified_name qualified_name_spine_node
// builds a path as a cons list, so every TAIL of a spine is itself spine-shaped: descending would
// read `v2.std.node.Node` as `std.node.Node` too and attribute an edge to a module the reference
// never named.
//
// A SPINE IS A DECLARATION REFERENCE ONLY IF THE INDEX DECLARES ITS PATH. The shape reader cannot
// tell a resolver-minted path from another cons list of atoms: an integer literal lowers to one
// (`606060` reads as `integer_tag_digit_6.integer_tag_digit_0...`, measured on
// fixtures/native_cli_door at gunbc#12218). The resolver mints a spine only for a path the symbol
// index answers, so the index is the discriminator, and a spine it does not declare is not a
// reference. It is not descended into either: a spine's children are atoms, and reading a tail
// would attribute an edge to a shorter path the author never wrote.
fn reference_closure_declaring_paths(
  n: Node,
  index: SymbolIndex,
  acc: FreeMonoid<QualifiedName>
) -> FreeMonoid<QualifiedName> {
  match declaration_reference_path_optional(node: n) {
    Present { value: path } =>
      match symbol_index_lookup(index: index, qualified_path: path) {
        Present { value: _ } => list_snoc_item(xs: acc, item: path)
        Absent => acc
      }
    Absent =>
      fold(n.children, init: acc, f: fn(a, e) {
        reference_closure_declaring_paths(n: e.target, index: index, acc: a)
      })
  }
}

fn reference_closure_absorb_owner(
  acc: ReferenceClosureNeighbours,
  roster: FreeMonoid<QualifiedName>,
  target: QualifiedName,
  at: Node
) -> ReferenceClosureNeighbours {
  match acc {
    ReferenceClosureTargetOwnerless { target: _, at: _ } => acc
    ReferenceClosureNeighboursRead { modules: modules } =>
      match qualified_name_owning_module(roster: roster, target: target) {
        Absent => ReferenceClosureTargetOwnerless { target: target, at: at }
        Present { value: owner } =>
          if contains(xs: modules, item: owner, eq: reference_closure_qn_eq) {
            acc
          } else {
            ReferenceClosureNeighboursRead { modules: list_snoc_item(xs: modules, item: owner) }
          }
      }
  }
}

fn reference_closure_neighbours<P>(
  member: ReferenceClosureMember<P>,
  roster: FreeMonoid<QualifiedName>,
  index: SymbolIndex
) -> ReferenceClosureNeighbours {
  let referenced = fold_list(
    xs: reference_closure_declaring_paths(n: member.resolved, index: index, acc: Empty),
    empty: ReferenceClosureNeighboursRead { modules: Empty },
    cons: fn(acc, path) {
      reference_closure_absorb_owner(acc: acc, roster: roster, target: path, at: member.resolved)
    }
  )
  fold_list(
    xs: member.import_targets,
    empty: referenced,
    cons: fn(acc, target) {
      reference_closure_absorb_owner(acc: acc, roster: roster, target: target, at: member.resolved)
    }
  )
}

fn reference_closure_enqueue<P>(
  state: ReferenceClosureState<P>,
  modules: FreeMonoid<QualifiedName>
) -> ReferenceClosureState<P> {
  fold_list(
    xs: modules,
    empty: state,
    cons: fn(s, m) {
      if contains(xs: s.reached, item: m, eq: reference_closure_qn_eq) {
        s
      } else if contains(xs: s.queue, item: m, eq: reference_closure_qn_eq) {
        s
      } else {
        ReferenceClosureState {
          reached: s.reached,
          visits: s.visits,
          queue: list_snoc_item(xs: s.queue, item: m)
        }
      }
    }
  )
}

// Terminates because a module enters the queue only when it is neither reached nor queued, every
// step moves one module from the queue to `reached`, and every module that can be enqueued is an
// owner drawn from the finite roster.
fn reference_closure_walk<P>(
  state: ReferenceClosureState<P>,
  roster: FreeMonoid<QualifiedName>,
  index: SymbolIndex,
  resolve_member: fn(QualifiedName) -> Outcome<ReferenceClosureMember<P>>
) -> Outcome<FreeMonoid<ReferenceClosureVisit<P>>> {
  match state.queue {
    Empty => outcome_accepted(value: state.visits)
    Cons { head: member_module, tail: rest } =>
      bind_outcome(
        o: resolve_member(member_module),
        f: fn(member) {
          match reference_closure_neighbours(member: member, roster: roster, index: index) {
            ReferenceClosureTargetOwnerless { target: _, at: at } =>
              outcome_rejected(d: reference_closure_diagnostic(
                reason: ^reference_closure_target_ownerless,
                at: at
              ))
            ReferenceClosureNeighboursRead { modules: modules } =>
              reference_closure_walk(
                state: reference_closure_enqueue(
                  state: ReferenceClosureState {
                    reached: list_snoc_item(xs: state.reached, item: member_module),
                    visits: list_snoc_item(
                      xs: state.visits,
                      item: ReferenceClosureVisit { module: member_module, member: member }
                    ),
                    queue: rest
                  },
                  modules: modules
                ),
                roster: roster,
                index: index,
                resolve_member: resolve_member
              )
          }
        }
      )
  }
}

fn reference_derived_closure<P>(
  entry: QualifiedName,
  entry_locus: Node,
  roster: FreeMonoid<QualifiedName>,
  index: SymbolIndex,
  resolve_member: fn(QualifiedName) -> Outcome<ReferenceClosureMember<P>>
) -> Outcome<FreeMonoid<ReferenceClosureVisit<P>>> {
  if contains(xs: roster, item: entry, eq: reference_closure_qn_eq) {
    reference_closure_walk(
      state: ReferenceClosureState {
        reached: Empty,
        visits: Empty,
        queue: Cons { head: entry, tail: Empty }
      },
      roster: roster,
      index: index,
      resolve_member: resolve_member
    )
  } else {
    outcome_rejected(d: reference_closure_diagnostic(
      reason: ^reference_closure_entry_not_rostered,
      at: entry_locus
    ))
  }
}

// The reached modules alone, in visit order, for a consumer that asks only which modules.
fn reference_closure_modules<P>(visits: FreeMonoid<ReferenceClosureVisit<P>>) -> FreeMonoid<QualifiedName> {
  fold_list(xs: visits, empty: Empty, cons: fn(acc, v) { list_snoc_item(xs: acc, item: v.module) })
}
