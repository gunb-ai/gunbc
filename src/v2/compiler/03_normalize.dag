// src/v2/compiler/03_normalize.dag
//
// Scope: Stage 3a — ParseTree→NormalizedTree; C3 sugar to Node.
// Status: T-8 modeled — traversal on normalize_fold init/step; model in std/compilers/sugar.dag.
// Anchor: https://en.wikipedia.org/wiki/Abstract_syntax_tree

module v2.compiler.normalize

import v2.std.algebra { list_snoc_item }
import v2.std.collection { Absent, Present }
import v2.std.grammar { ParseTree }

import v2.std.diagnostic {
  Diagnostic,
  Diagnostics,
  node_locus,
  Outcome,
  UserInputBoundary,
  Accepted,
  None,
  diagnostics_merge,
  diagnostics_singleton,
  rejected_with_pending
}
import v2.std.node {
  Edge,
  Node,
  Symbol,
  node_rebuild,
  well_formed
}
import v2.std.compilers.sugar {
  apply_sugar,
  classify_sugar
}

type NormalizedTree = Node

data normalize_reason_post_normalize_not_well_formed: Symbol = normalize_reason_post_normalize_not_well_formed

fn post_normalize_not_well_formed_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: normalize_reason_post_normalize_not_well_formed,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn normalize_fold_init(n: Node) -> Outcome<Node> {
  Accepted { value: node_rebuild(n: n, children: []), diagnostics: None }
}

fn normalize_fold_step(acc: Outcome<Node>, edge: Edge, child: Outcome<Node>) -> Outcome<Node> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: shell, diagnostics: ad } =>
      match child {
        Rejected { diagnostics: cr } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: cr)
          }
        Accepted { value: child_node, diagnostics: cd } =>
          Accepted {
            value: node_rebuild(
              n: shell,
              children: list_snoc_item(
                xs: shell.children,
                item: Edge { label: edge.label, target: child_node }
              )
            ),
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
      }
  }
}

fn normalize_sugar_finish(n: Node, folded: Node, cd: Diagnostics) -> Outcome<Node> {
  match classify_sugar(n: n) {
    Present { value: rule } =>
      match apply_sugar(rule: rule, n: n, children: folded.children) {
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: cd, rejected: r)
          }
        Accepted { value: v, diagnostics: d } =>
          Accepted {
            value: v,
            diagnostics: diagnostics_merge(outer: cd, inner: d)
          }
      }
    Absent =>
      Accepted { value: folded, diagnostics: cd }
  }
}

// 🟡 traverse-dissolution interim (docs/modeling-discipline.md Practice 4/10) — feature:traverse-node-outcome-algebra — bind diagnostic.dag Ratified-Q4 — dissolve-on: Outcome-bearing fold_node algebra carries sugar-finish per node natively, replacing manual child-slot normalize_node re-entry; forbidden: bare fold_node(n, normalize_fold_algebra) here — fold_node's child slot only recurses fold_node (structural shells), so per-depth sugar finish requires normalize_node in the step child slot until Q4 lands.
fn normalize_node(n: Node) -> Outcome<Node> {
  match fold(n.children, init: normalize_fold_init(n: n), f: fn(acc, e) {
    normalize_fold_step(acc: acc, edge: e, child: normalize_node(n: e.target))
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: folded, diagnostics: cd } =>
      normalize_sugar_finish(n: n, folded: folded, cd: cd)
  }
}

fn normalize(parse_tree: ParseTree) -> Outcome<NormalizedTree> {
  match normalize_node(n: parse_tree) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: normalized, diagnostics: d } =>
      if well_formed(n: normalized) {
        Accepted { value: normalized, diagnostics: d }
      } else {
        Rejected {
          diagnostics: rejected_with_pending(
            pending: d,
            rejected: diagnostics_singleton(
              d: post_normalize_not_well_formed_diagnostic(n: normalized)
            )
          )
        }
      }
  }
}
