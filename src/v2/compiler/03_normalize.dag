module v2.compiler.normalize



fn post_normalize_not_well_formed_diagnostic(n: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^normalize_reason_post_normalize_not_well_formed,
    at: node_locus(node: n),
    correction: v2.std.diagnostic.Unavailable { reason: UserInputBoundary }
  }
}

fn normalize_fold_init(n: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  v2.std.diagnostic.Accepted { value: node_rebuild(n: n, children: []), diagnostics: v2.std.diagnostic.None }
}

fn normalize_fold_step(acc: v2.std.diagnostic.Outcome<v2.std.node.Node>, edge: v2.std.node.Edge, child: v2.std.diagnostic.Outcome<v2.std.node.Node>) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match acc {
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: shell, diagnostics: ad } =>
      match child {
        v2.std.diagnostic.Rejected { diagnostics: cr } =>
          v2.std.diagnostic.Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: cr)
          }
        v2.std.diagnostic.Accepted { value: child_node, diagnostics: cd } =>
          v2.std.diagnostic.Accepted {
            value: node_rebuild(
              n: shell,
              children: list_snoc_item(
                xs: shell.children,
                item: v2.std.node.Edge { label: edge.label, target: child_node }
              )
            ),
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
      }
  }
}

fn normalize_sugar_key_optional(folded: v2.std.node.Node) -> v2.std.compilers.sugar.SugarKey? {
  match folded.kind {
    TypeNode { connective: Atom { identity: id } } =>
      optional_present(value: v2.std.compilers.sugar.SurfaceAtomKey { atom: id })
    TypeNode { connective: _ } =>
      match parse_production_emitted_identity_optional(node: folded) {
        Present { value: id } =>
          optional_present(value: v2.std.compilers.sugar.ProductionIdentityKey { identity: id })
        Absent => optional_absent()
      }
    ComputationNode { behavior: _ } => optional_absent()
  }
}

fn normalize_sugar_finish(n: v2.std.node.Node, folded: v2.std.node.Node, cd: v2.std.diagnostic.Diagnostics) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match normalize_sugar_key_optional(folded: folded) {
    Present { value: key } =>
      match sugar_rule_for_key(key: key) {
        Present { value: rule } =>
          match apply_sugar(rule: rule, n: n, folded: folded) {
            v2.std.diagnostic.Rejected { diagnostics: r } =>
              v2.std.diagnostic.Rejected {
                diagnostics: rejected_with_pending(pending: cd, rejected: r)
              }
            v2.std.diagnostic.Accepted { value: v, diagnostics: d } =>
              v2.std.diagnostic.Accepted {
                value: v,
                diagnostics: diagnostics_merge(outer: cd, inner: d)
              }
          }
        Absent =>
          v2.std.diagnostic.Accepted { value: folded, diagnostics: cd }
      }
    Absent =>
      v2.std.diagnostic.Accepted { value: folded, diagnostics: cd }
  }
}

fn normalize_node(n: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  normalize_node_ctx(n: n, under_fn_decl: false)
}

fn normalize_scope_under_fn_decl(under_fn_decl: Bool, emitted: v2.std.node.Symbol) -> Bool {
  under_fn_decl || (emitted == ^dag_surface_fn_decl)
}

fn normalize_fn_body_pass_through_at_seam(emitted: v2.std.node.Symbol, under_fn_decl: Bool) -> Bool {
  (emitted == ^dag_surface_fn_body) && under_fn_decl
}

fn normalize_node_ctx(n: v2.std.node.Node, under_fn_decl: Bool) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: emitted } =>
      if body_lower_is_deferred_lower_at_normalize(
        emitted: emitted,
        under_fn_decl: normalize_scope_under_fn_decl(under_fn_decl: under_fn_decl, emitted: emitted)
      ) {
        match body_lower_finish_for_normalize(
          n: n,
          folded: n,
          cd: None,
          fn_body_pass_through: normalize_fn_body_pass_through_at_seam(
            emitted: emitted,
            under_fn_decl: normalize_scope_under_fn_decl(
              under_fn_decl: under_fn_decl,
              emitted: emitted
            )
          )
        ) {
          v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
          v2.std.diagnostic.Accepted { value: after_body, diagnostics: cd0 } =>
            normalize_sugar_finish(n: n, folded: after_body, cd: cd0)
        }
      } else {
        normalize_node_fold_children_ctx(
          n: n,
          under_fn_decl: normalize_scope_under_fn_decl(
            under_fn_decl: under_fn_decl,
            emitted: emitted
          )
        )
      }
    Absent => normalize_node_fold_children_ctx(n: n, under_fn_decl: under_fn_decl)
  }
}

fn normalize_module_graft_finish(folded: v2.std.node.Node, cd: v2.std.diagnostic.Diagnostics) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if namespace_graft_is_graft_candidate(root: folded) {
    match module_header_containment_graft(root: folded) {
      v2.std.diagnostic.Rejected { diagnostics: r } =>
        v2.std.diagnostic.Rejected {
          diagnostics: rejected_with_pending(pending: cd, rejected: r)
        }
      v2.std.diagnostic.Accepted { value: grafted, diagnostics: d } =>
        v2.std.diagnostic.Accepted {
          value: grafted,
          diagnostics: diagnostics_merge(outer: cd, inner: d)
        }
    }
  } else {
    v2.std.diagnostic.Accepted { value: folded, diagnostics: cd }
  }
}

fn normalize_node_fold_children_ctx(n: v2.std.node.Node, under_fn_decl: Bool) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match fold(n.children, init: normalize_fold_init(n: n), f: fn(acc, e) {
    normalize_fold_step(
      acc: acc,
      edge: e,
      child: normalize_node_ctx(n: e.target, under_fn_decl: under_fn_decl)
    )
  }) {
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: folded, diagnostics: cd } =>
      match body_lower_finish_for_normalize(
        n: n,
        folded: folded,
        cd: cd,
        fn_body_pass_through: false
      ) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: after_body, diagnostics: cd0 } =>
          normalize_sugar_finish(n: n, folded: after_body, cd: cd0)
      }
  }
}

fn normalize(parse_tree: v2.std.grammar.ParseTree) -> v2.std.diagnostic.Outcome<v2.compiler.normalized_tree.NormalizedTree> {
  match normalize_node(n: parse_tree) {
    v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    v2.std.diagnostic.Accepted { value: normalized, diagnostics: d } =>
      match normalize_module_graft_finish(folded: normalized, cd: d) {
        v2.std.diagnostic.Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        v2.std.diagnostic.Accepted { value: grafted, diagnostics: d1 } =>
          if well_formed(n: grafted) {
            admit_normalized_tree(root: grafted, diagnostics: d1)
          } else {
            v2.std.diagnostic.Rejected {
              diagnostics: rejected_with_pending(
                pending: d1,
                rejected: diagnostics_singleton(
                  d: post_normalize_not_well_formed_diagnostic(n: grafted)
                )
              )
            }
          }
      }
  }
}
