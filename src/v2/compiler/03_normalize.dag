module v2.compiler.normalize

import v2.std.algebra { fold_list, list_snoc_item }
import std.algebra { Empty, FreeMonoid }
import v2.std.namespace_alias { AliasBindingRow }
import v2.std.collection { Absent, Present, optional_absent, optional_present }
import v2.std.grammar { ParseTree }

import v2.std.diagnostic {
  Correction,
  Diagnostic,
  Diagnostics,
  node_locus,
  Outcome,
  UserInputBoundary,
  Accepted,
  None,
  diagnostics_merge,
  diagnostics_singleton,
  rejected_with_pending
}
import v2.std.node {
  Atom,
  Edge,
  Node,
  Symbol,
  TypeNode,
  node_rebuild,
  node_subtree_nodes,
  well_formed
}
import v2.std.compilers.sugar {
  ProductionIdentityKey,
  SugarKey,
  SurfaceAtomKey,
  apply_sugar,
  sugar_rule_for_key
}
import v2.compiler.body_lowering_fold {
  body_lower_finish_for_normalize,
  body_lower_fn_decl_to_census_arrow,
  body_lower_is_deferred_lower_at_normalize,
  body_lower_type_decl_record_name_optional
}
import v2.compiler.normalized_tree { CensusTree, NormalizedTree, admit_census_tree, admit_normalized_tree }
import v2.compiler.test_marker_capture { test_marker_capture }
import v2.compiler.namespace_graft {
  module_header_containment_graft,
  namespace_graft_is_graft_candidate
}
import v2.extdeps.languages.dag {
  import_binding_rows_from_decl_node,
  parse_production_emitted_identity_optional
}

fn post_normalize_not_well_formed_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^normalize_reason_post_normalize_not_well_formed,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// THE ENCLOSING NODE IS REBUILT ONCE, NOT ONCE PER CHILD.
//
// This fold used to carry a SHELL NODE as its accumulator: each step appended one edge to
// `shell.children` and called `node_rebuild` on the result, so a node with k children was
// reconstructed k times and k-1 of those reconstructions were built and immediately discarded --
// only the last one is ever read. DESIGN section 6 names that shape outright ("a copied
// accumulator, a quadratic fold") and rules that it is ALWAYS FIXED, regardless of the realized n,
// because "n is small here" is not a time-stable fact: this fold runs over every node of every
// file the front end sees, and the nodes where k is large are exactly the ones that dominate --
// module roots carrying long declaration lists.
//
// The accumulator is now the EDGE LIST, and `node_rebuild` is called once by the caller after the
// fold completes. What is deliberately unchanged: edge order (`list_snoc_item` still appends), the
// diagnostics merge order (`diagnostics_merge(outer: ad, inner: cd)` per child, in the same
// sequence), and the refusal behaviour -- the first Rejected absorbs and later children cannot
// repair it, which is why the Rejected arm still returns without inspecting `child`.
//
// THE EQUIVALENCE IS BY CONSTRUCTION, NOT BY HOPE, AND IT TURNS ON OCCURRENCE IDENTITY. The old
// shape computed `node_rebuild(node_rebuild(n, []), E)` -- the shell was itself a rebuild. That
// equals `node_rebuild(n, E)` because `node_rebuild` copies KIND and OCCURRENCE_ID from its
// argument and replaces only the children (v2.std.node node_rebuild -> node_with_occurrence_id),
// so the intermediate shell carries `n.kind` and `n.occurrence_id` unchanged and rebuilding from
// it is indistinguishable from rebuilding from `n`. Had `node_rebuild` minted a fresh occurrence
// id, collapsing the k rebuilds into one would have CHANGED occurrence identity -- a semantic
// change wearing a performance change's clothes -- so the property is stated here rather than
// assumed.
//
// NO CACHE IS INDICATED HERE AND ONE WOULD HAVE BEEN WRONG. The repeated work is recomputation
// INSIDE one fold, not a demand recurring across frames, so the repair is to carry the value
// (DESIGN section 2) -- a provider would have made the discarded reconstructions cheap instead of
// removing them, which is the signal-suppression that section names.
// The empty accumulator is its own declaration because `Accepted { value: [] }` gives the literal
// no type to take -- the constructor's payload is generic, so the annotation on this function is
// what pins it to edges.
fn normalize_no_edges() -> List<Edge> {
  []
}

fn normalize_children_init() -> Outcome<List<Edge>> {
  Accepted { value: normalize_no_edges(), diagnostics: None }
}

fn normalize_children_step(
  acc: Outcome<List<Edge>>,
  edge: Edge,
  child: Outcome<Node>
) -> Outcome<List<Edge>> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: edges, diagnostics: ad } =>
      match child {
        Rejected { diagnostics: cr } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: cr)
          }
        Accepted { value: child_node, diagnostics: cd } =>
          Accepted {
            value: list_snoc_item(
              xs: edges,
              item: Edge { label: edge.label, target: child_node }
            ),
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
      }
  }
}

fn normalize_sugar_key_optional(folded: Node) -> SugarKey? {
  match folded.kind {
    TypeNode { connective: Atom { identity: id } } =>
      optional_present(value: SurfaceAtomKey { atom: id })
    TypeNode { connective: _ } =>
      match parse_production_emitted_identity_optional(node: folded) {
        Present { value: id } =>
          optional_present(value: ProductionIdentityKey { identity: id })
        Absent => optional_absent()
      }
    ComputationNode { behavior: _ } => optional_absent()
  }
}

fn normalize_sugar_finish(n: Node, folded: Node, cd: Diagnostics) -> Outcome<Node> {
  match normalize_sugar_key_optional(folded: folded) {
    Present { value: key } =>
      match sugar_rule_for_key(key: key) {
        Present { value: rule } =>
          match apply_sugar(rule: rule, n: n, folded: folded) {
            Rejected { diagnostics: r } =>
              Rejected {
                diagnostics: rejected_with_pending(pending: cd, rejected: r)
              }
            Accepted { value: v, diagnostics: d } =>
              Accepted {
                value: v,
                diagnostics: diagnostics_merge(outer: cd, inner: d)
              }
          }
        Absent =>
          Accepted { value: folded, diagnostics: cd }
      }
    Absent =>
      Accepted { value: folded, diagnostics: cd }
  }
}

fn normalize_node(n: Node) -> Outcome<Node> {
  normalize_node_ctx(n: n, under_fn_decl: false)
}

// A `data` DECLARATION OPENS THE SAME BODY SCOPE A `fn` DECLARATION DOES. Both lower to a named
// Arrow whose body the declaration arm reads from the raw parse (v2.compiler.body_lowering_fold
// body_lower_fn_decl_to_arrow, body_lower_data_decl_to_member), so a fn_body nested in either, such
// as a fn literal in a record initializer, is deferred to that reader rather than folded here
// half-way. Before 2026-09-23 a data declaration was preserved unlowered and nothing read its
// initializer as a body, so the question did not arise.
fn normalize_scope_under_fn_decl(under_fn_decl: Bool, emitted: Symbol) -> Bool {
  under_fn_decl || (emitted == ^dag_surface_fn_decl) || (emitted == ^dag_surface_data_decl)
}

fn normalize_fn_body_pass_through_at_seam(emitted: Symbol, under_fn_decl: Bool) -> Bool {
  (emitted == ^dag_surface_fn_body) && under_fn_decl
}

fn normalize_node_ctx(n: Node, under_fn_decl: Bool) -> Outcome<Node> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: emitted } =>
      if body_lower_is_deferred_lower_at_normalize(
        emitted: emitted,
        under_fn_decl: normalize_scope_under_fn_decl(under_fn_decl: under_fn_decl, emitted: emitted)
      ) {
        match body_lower_finish_for_normalize(
          n: n,
          folded: n,
          cd: None,
          fn_body_pass_through: normalize_fn_body_pass_through_at_seam(
            emitted: emitted,
            under_fn_decl: normalize_scope_under_fn_decl(
              under_fn_decl: under_fn_decl,
              emitted: emitted
            )
          )
        ) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: after_body, diagnostics: cd0 } =>
            normalize_sugar_finish(n: n, folded: after_body, cd: cd0)
        }
      } else {
        normalize_node_fold_children_ctx(
          n: n,
          under_fn_decl: normalize_scope_under_fn_decl(
            under_fn_decl: under_fn_decl,
            emitted: emitted
          )
        )
      }
    Absent => normalize_node_fold_children_ctx(n: n, under_fn_decl: under_fn_decl)
  }
}

fn normalize_module_graft_finish(folded: Node, cd: Diagnostics) -> Outcome<Node> {
  if namespace_graft_is_graft_candidate(root: folded) {
    match module_header_containment_graft(root: folded) {
      Rejected { diagnostics: r } =>
        Rejected {
          diagnostics: rejected_with_pending(pending: cd, rejected: r)
        }
      Accepted { value: grafted, diagnostics: d } =>
        Accepted {
          value: grafted,
          diagnostics: diagnostics_merge(outer: cd, inner: d)
        }
    }
  } else {
    Accepted { value: folded, diagnostics: cd }
  }
}

fn normalize_node_fold_children_ctx(n: Node, under_fn_decl: Bool) -> Outcome<Node> {
  match fold(n.children, init: normalize_children_init(), f: fn(acc, e) {
    normalize_children_step(
      acc: acc,
      edge: e,
      child: normalize_node_ctx(n: e.target, under_fn_decl: under_fn_decl)
    )
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: edges, diagnostics: cd } =>
      match body_lower_finish_for_normalize(
        n: n,
        folded: node_rebuild(n: n, children: edges),
        cd: cd,
        fn_body_pass_through: false
      ) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: after_body, diagnostics: cd0 } =>
          normalize_sugar_finish(n: n, folded: after_body, cd: cd0)
      }
  }
}

// CAPTURED FROM THE PARSE TREE, FOR THE SAME REASON test_marker_capture IS. This runs BEFORE the
// graft has dissolved the import decls, which is the only moment the rows can be read at all, and it
// reads them from the authored source rather than reconstructing them from anything downstream.
// One import decl yields one row per name in its block; a decl this reader cannot understand
// REFUSES rather than contributing nothing, because a silently empty row set is indistinguishable
// from a module that imports nothing and would surface far away as unbound references.
// ONE WALK, TWO READERS (review 70175). Both captures ask the same question of the same tree --
// every node, filtered by its emitted production identity -- so the subtree list is bound ONCE by
// the caller and passed to each, rather than each folding node_subtree_nodes itself. DESIGN section
// 2: two demands whose least common ancestor holds the value share it rather than recomputing it,
// and this stage is one the floor already measures as over-budget.
fn import_binding_capture(tree: ParseTree, nodes: List<Node>) -> Outcome<FreeMonoid<AliasBindingRow>> {
  fold_list(
    xs: nodes,
    empty: Accepted { value: Empty, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, n) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: rows, diagnostics: _ } =>
          match parse_production_emitted_identity_optional(node: n) {
            Absent => acc
            Present { value: id } =>
              if id != ^dag_surface_import_decl {
                acc
              } else {
                match import_binding_rows_from_decl_node(decl: n, module_root: tree) {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: fresh, diagnostics: _ } =>
                    Accepted {
                      value: fold_list(
                        xs: fresh,
                        empty: rows,
                        cons: fn(a, row) { list_snoc_item(xs: a, item: row) }
                      ),
                      diagnostics: v2.std.diagnostic.None
                    }
                }
              }
          }
      }
    }
  )
}

// WHICH OF THIS MODULE'S TYPES ARE RECORDS, read from the parse tree for the reason
// import_binding_capture reads imports there: after lowering, a record is a bare
// `Conj { R: payload }` that no reader can tell from a where-alias or a module spine. The question is
// answered by the rehome's own predicate (v2.compiler.body_lowering_fold
// body_lower_type_decl_record_name_optional), so what is carried and what was rehomed are one
// decision, not two.
fn record_declaration_capture(nodes: List<Node>) -> FreeMonoid<Symbol> {
  fold_list(
    xs: nodes,
    empty: Empty,
    cons: fn(acc, n) {
      match parse_production_emitted_identity_optional(node: n) {
        Absent => acc
        Present { value: id } =>
          if id != ^dag_surface_type_decl {
            acc
          } else {
            match body_lower_type_decl_record_name_optional(shell: n) {
              Absent => acc
              Present { value: name } => list_snoc_item(xs: acc, item: name)
            }
          }
      }
    }
  )
}

fn normalize(parse_tree: ParseTree) -> Outcome<NormalizedTree> {
  match normalize_node(n: parse_tree) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: normalized, diagnostics: d } =>
      match normalize_module_graft_finish(folded: normalized, cd: d) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: grafted, diagnostics: d1 } =>
          if well_formed(n: grafted) {
            let parse_nodes = node_subtree_nodes(root: parse_tree)
            match test_marker_capture(tree: parse_tree) {
              Rejected { diagnostics: r } =>
                Rejected { diagnostics: rejected_with_pending(pending: d1, rejected: r) }
              Accepted { value: markers, diagnostics: _ } =>
                match import_binding_capture(tree: parse_tree, nodes: parse_nodes) {
                  Rejected { diagnostics: r } =>
                    Rejected { diagnostics: rejected_with_pending(pending: d1, rejected: r) }
                  Accepted { value: bindings, diagnostics: _ } =>
                    admit_normalized_tree(
                      root: grafted,
                      test_markers: markers,
                      import_bindings: bindings,
                      record_declarations: record_declaration_capture(nodes: parse_nodes),
                      diagnostics: d1
                    )
                }
            }
          } else {
            Rejected {
              diagnostics: rejected_with_pending(
                pending: d1,
                rejected: diagnostics_singleton(
                  d: post_normalize_not_well_formed_diagnostic(n: grafted)
                )
              )
            }
          }
      }
  }
}

// CENSUS MODE: A MODULE OUTSIDE THE COMPILED CLOSURE, NORMALIZED TO WHAT RESOLUTION READS OF IT.
// Every file is parsed -- a parse refusal stays fatal, because this entry takes a ParseTree and a
// file that did not parse has none -- but only closure members are lowered. A non-member is read by
// resolution for its declaration paths and payload kinds alone (v2.compiler.symbol_index_fill walks
// an Arrow's domain and never its body), so the census fold keeps every declaration and lowers no
// body:
//   - a fn declaration becomes its signature-only Arrow (body_lower_fn_decl_to_census_arrow); its
//     params and return type are folded exactly as the full fold folds them, so the domain a closure
//     member resolves against is the one whole-root ingest builds;
//   - a data declaration and a test fn declaration keep their parse shells unlowered: the graft keys
//     both by their keyword-then-ident edge, which the shell still carries, and their value and body
//     expressions -- the ones that refuse today (body_lowering_reason_call_argument_unread in
//     dag/examples/weather/weather.dag) -- are never entered. A non-member therefore contributes NO
//     TestCodeIndex rows; that is by design, since a module outside the closure has no tests run;
//   - every other node (module spine, type, variant, record, import and alias declarations) takes the
//     full fold unchanged, so the declaration-level Disjs the variant-alias and alias scans read are
//     the same Disjs whole-root ingest produces.
// The result is a CensusTree, not a NormalizedTree, so no emission or body-resolution consumer can be
// handed one: a census-grade module is never emitted BY TYPE rather than by a check at the emitter.
fn normalize_census_node(n: Node, under_fn_decl: Bool) -> Outcome<Node> {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: emitted } =>
      if (emitted == ^dag_surface_data_decl) || (emitted == ^dag_surface_test_fn_decl) {
        Accepted { value: n, diagnostics: None }
      } else if emitted == ^dag_surface_fn_decl {
        match normalize_census_fold_children(n: n, under_fn_decl: true) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: edges, diagnostics: cd } =>
            match body_lower_fn_decl_to_census_arrow(shell: node_rebuild(n: n, children: edges)) {
              Rejected { diagnostics: r } =>
                Rejected { diagnostics: rejected_with_pending(pending: cd, rejected: r) }
              Accepted { value: arrow, diagnostics: d } =>
                Accepted { value: arrow, diagnostics: diagnostics_merge(outer: cd, inner: d) }
            }
        }
      } else if body_lower_is_deferred_lower_at_normalize(
        emitted: emitted,
        under_fn_decl: normalize_scope_under_fn_decl(under_fn_decl: under_fn_decl, emitted: emitted)
      ) {
        normalize_node_ctx(n: n, under_fn_decl: under_fn_decl)
      } else {
        normalize_census_finish(n: n, under_fn_decl: under_fn_decl)
      }
    Absent => normalize_census_finish(n: n, under_fn_decl: under_fn_decl)
  }
}

fn normalize_census_fold_children(n: Node, under_fn_decl: Bool) -> Outcome<List<Edge>> {
  fold(n.children, init: normalize_children_init(), f: fn(acc, e) {
    normalize_children_step(
      acc: acc,
      edge: e,
      child: normalize_census_node(n: e.target, under_fn_decl: under_fn_decl)
    )
  })
}

fn normalize_census_finish(n: Node, under_fn_decl: Bool) -> Outcome<Node> {
  match normalize_census_fold_children(n: n, under_fn_decl: under_fn_decl) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: edges, diagnostics: cd } =>
      match body_lower_finish_for_normalize(
        n: n,
        folded: node_rebuild(n: n, children: edges),
        cd: cd,
        fn_body_pass_through: false
      ) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: after_body, diagnostics: cd0 } =>
          normalize_sugar_finish(n: n, folded: after_body, cd: cd0)
      }
  }
}

fn normalize_census(parse_tree: ParseTree) -> Outcome<CensusTree> {
  match normalize_census_node(n: parse_tree, under_fn_decl: false) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: normalized, diagnostics: d } =>
      match normalize_module_graft_finish(folded: normalized, cd: d) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: grafted, diagnostics: d1 } =>
          if well_formed(n: grafted) {
            let parse_nodes = node_subtree_nodes(root: parse_tree)
            match import_binding_capture(tree: parse_tree, nodes: parse_nodes) {
              Rejected { diagnostics: r } =>
                Rejected { diagnostics: rejected_with_pending(pending: d1, rejected: r) }
              Accepted { value: bindings, diagnostics: _ } =>
                admit_census_tree(
                  root: grafted,
                  import_bindings: bindings,
                  record_declarations: record_declaration_capture(nodes: parse_nodes),
                  diagnostics: d1
                )
            }
          } else {
            Rejected {
              diagnostics: rejected_with_pending(
                pending: d1,
                rejected: diagnostics_singleton(
                  d: post_normalize_not_well_formed_diagnostic(n: grafted)
                )
              )
            }
          }
      }
  }
}
