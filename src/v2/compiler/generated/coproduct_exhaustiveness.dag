
module v2.test.generated.coproduct_exhaustiveness


// STRUCTURAL coproduct-exhaustiveness conformance (docs/plans/testgen-oracle.md §4.2). The roster
// of missing-arm witnesses is DERIVED from every declared coproduct in the corpus
// (testgen_scheduled_coproduct_exhaustiveness_generators →
// v2.std.concept_index.enumerate_coproduct_decls) and each coproduct's own arm keys
// (v2.std.node_query.coproduct_arm_keys), NOT a hand-list of TestClaim variants. These witnesses
// run by EXECUTION in the floor (generated_conformance_floor_test): they fail-close (RED) if the
// enumeration goes empty (dormant host bridge) or loses an arm, and they independently recompute
// the expected arm coverage from the Node tree so accidental-pass is excluded.

import v2.lens.testgen {
  Generator,
  TestgenConcept,
  coproduct_exhaustiveness_anchor,
  testgen_emit_coproduct_exhaustiveness_claim,
  testgen_scheduled_coproduct_exhaustiveness_generators
}
import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.node_query { coproduct_arm_keys }
import v2.std.verification {
  ClaimAnchorKey,
  DiagnosticClaim,
  GeneratedAnchorKey,
  GeneratedClaimAnchor,
  GeneratedCoproductExhaustiveness,
  TestClaim,
  test_claim_anchor,
  test_claim_input
}


// A concrete reference anchor: TestClaim is a declared coproduct whose `DiagnosticClaim` arm is one
// of its keys; the structural enumeration must produce exactly this anchor among others.
fn reference_coproduct_exhaustiveness_anchor() -> GeneratedAnchorKey {
  coproduct_exhaustiveness_anchor(coproduct_type: ^TestClaim, omitted_variant: ^DiagnosticClaim)
}


fn generated_coproduct_exhaustiveness_claim() -> Outcome<TestClaim> {
  testgen_emit_coproduct_exhaustiveness_claim(anchor: reference_coproduct_exhaustiveness_anchor())
}


fn generated_coproduct_exhaustiveness_input() -> Outcome<Node> {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: claim, diagnostics: _ } =>
      Accepted { value: test_claim_input(c: claim), diagnostics: None }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}


fn witness_coproduct_exhaustiveness_claim_is_diagnostic() -> Bool {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: DiagnosticClaim { label: _, anchor: GeneratedClaimAnchor { generated_anchor: GeneratedCoproductExhaustiveness { coproduct_type: _, omitted_variant: _ } }, input: _, expected_rejection: _, classification: _ }, diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}


fn witness_coproduct_exhaustiveness_generated_anchor() -> Bool {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: claim, diagnostics: _ } =>
      match test_claim_anchor(c: claim) {
        GeneratedClaimAnchor { generated_anchor: GeneratedCoproductExhaustiveness { coproduct_type: _, omitted_variant: _ } } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}


// Does the structural roster contain a generator anchored at exactly (coproduct_type, omitted_variant)?
fn anchor_is(a: ClaimAnchorKey, coproduct_type: Symbol, omitted_variant: Symbol) -> Bool {
  match a {
    GeneratedClaimAnchor { generated_anchor: GeneratedCoproductExhaustiveness { coproduct_type: ct, omitted_variant: ov } } =>
      (ct == coproduct_type) && (ov == omitted_variant)
    _ => false
  }
}

fn roster_covers(coproduct_type: Symbol, omitted_variant: Symbol) -> Bool {
  fold(
    testgen_scheduled_coproduct_exhaustiveness_generators(),
    init: false,
    f: fn(acc, g) { acc || anchor_is(a: g.anchor, coproduct_type: coproduct_type, omitted_variant: omitted_variant) }
  )
}

// Every arm of `coproduct_type` (recomputed independently from the Node tree via coproduct_arm_keys)
// has a matching missing-arm generator in the structural roster, and the type is genuinely a
// coproduct (non-empty arm set — guards an accidental vacuous pass).
fn roster_covers_all_arms_of(coproduct_type: Symbol) -> Bool {
  let arms = coproduct_arm_keys(type_name: coproduct_type)
  (length(xs: arms) > 0)
    && fold(arms, init: true, f: fn(acc, arm) {
        acc && roster_covers(coproduct_type: coproduct_type, omitted_variant: arm)
      })
}


// The roster is non-empty (fail-closed: a dormant enumeration that returned the empty list would
// vacuously "pass" every per-arm check, so the floor needs this guard) and covers TestClaim's arms.
fn witness_coproduct_exhaustiveness_roster_covers_testclaim() -> Bool {
  (length(xs: testgen_scheduled_coproduct_exhaustiveness_generators()) > 0)
    && roster_covers_all_arms_of(coproduct_type: ^TestClaim)
}

// Coverage is over EVERY declared coproduct, not just TestClaim: a second, structurally unrelated
// coproduct (Connective, the substrate's own type constructor) is covered arm-for-arm too.
fn witness_coproduct_exhaustiveness_covers_second_coproduct() -> Bool {
  roster_covers_all_arms_of(coproduct_type: ^Connective)
}


data witness_coproduct_exhaustiveness_diagnostic_claim: Bool = witness_coproduct_exhaustiveness_claim_is_diagnostic()


data witness_coproduct_exhaustiveness_uses_generated_anchor: Bool = witness_coproduct_exhaustiveness_generated_anchor()


data witness_coproduct_exhaustiveness_all_variants_emit: Bool = witness_coproduct_exhaustiveness_roster_covers_testclaim()


data witness_coproduct_exhaustiveness_generator_count: Bool = witness_coproduct_exhaustiveness_covers_second_coproduct()
