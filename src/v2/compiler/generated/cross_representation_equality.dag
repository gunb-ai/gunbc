
module v2.test.generated.cross_representation_equality


// CROSS-REPRESENTATION-EQUALITY conformance (docs/plans/testgen-oracle.md §4.3). A modeled coproduct
// is *realized* as a native runtime Value; when the modeled constructor builds a `Variant` while the
// native form is a scalar `Value`, comparing them straddles the model↔realization boundary — the §5
// fail-open root the numeric tower already GROUNDED (#5428). This module is the floor entry point for
// the straddle witnesses the generator emits, SCOPE TIGHT to the straddles that remain UNSTRUCTURED:
// Bool over Value::Bool, and the Value::Null sentinel (Optional/Witness) fenced to its own runway.
//
// The witnesses run by EXECUTION in the floor (generated_conformance_floor_test): they check the
// generator emits an EqualsClaim under a generated cross-representation anchor, and that the curated
// straddle roster covers each subject — recomputing each modeled coproduct's arm keys independently
// (coproduct_arm_keys) so a vacuous symbol (not a real Disj) cannot pass. The EqualsClaim is emitted,
// NOT executed: grounding each straddle so the equality actually holds is its own runway.

import v2.lens.testgen {
  Generator,
  TestgenConcept,
  cross_representation_equality_anchor,
  cross_repr_native_value_bool,
  cross_repr_native_value_null,
  testgen_emit_cross_representation_equality_claim,
  testgen_scheduled_cross_representation_equality_generators
}
import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, None, Outcome, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.node_query { coproduct_arm_keys }
import v2.std.verification {
  ClaimAnchorKey,
  EqualsClaim,
  GeneratedAnchorKey,
  GeneratedClaimAnchor,
  GeneratedCrossRepresentationEquality,
  TestClaim,
  test_claim_anchor
}


// A concrete reference anchor: Bool is a declared coproduct (True | False) realized as the native
// Value::Bool — the canonical unstructured straddle, which the generator must produce among others.
fn reference_cross_representation_equality_anchor() -> GeneratedAnchorKey {
  cross_representation_equality_anchor(
    modeled_coproduct: ^Bool,
    native_realization: cross_repr_native_value_bool
  )
}


fn generated_cross_representation_equality_claim() -> Outcome<TestClaim> {
  testgen_emit_cross_representation_equality_claim(anchor: reference_cross_representation_equality_anchor())
}


// The straddle witness is an EqualsClaim (the modeled form reduces to its native realization) anchored
// at a generated cross-representation anchor. Discriminating: change the emit shape and this flips.
fn witness_cross_representation_claim_is_equals() -> Bool {
  match generated_cross_representation_equality_claim() {
    Accepted { value: EqualsClaim { label: _, anchor: GeneratedClaimAnchor { generated_anchor: GeneratedCrossRepresentationEquality { modeled_coproduct: _, native_realization: _ } }, lhs: _, rhs: _, classification: _ }, diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}


fn witness_cross_representation_uses_generated_anchor() -> Bool {
  match generated_cross_representation_equality_claim() {
    Accepted { value: claim, diagnostics: _ } =>
      match test_claim_anchor(c: claim) {
        GeneratedClaimAnchor { generated_anchor: GeneratedCrossRepresentationEquality { modeled_coproduct: _, native_realization: _ } } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}


// Does the curated straddle roster contain a generator anchored at exactly (modeled, native)?
fn anchor_is_straddle(a: ClaimAnchorKey, modeled: Symbol, native: Symbol) -> Bool {
  match a {
    GeneratedClaimAnchor { generated_anchor: GeneratedCrossRepresentationEquality { modeled_coproduct: mc, native_realization: nr } } =>
      (mc == modeled) && (nr == native)
    _ => false
  }
}

fn roster_covers_straddle(modeled: Symbol, native: Symbol) -> Bool {
  fold(
    testgen_scheduled_cross_representation_equality_generators(),
    init: false,
    f: fn(acc, g) { acc || anchor_is_straddle(a: g.anchor, modeled: modeled, native: native) }
  )
}

// The straddle subject is covered by the roster AND the modeled side is a GENUINE declared coproduct
// (its arm set, recomputed independently off the Node tree, is non-empty) — excluding a vacuous pass
// where `modeled` is just any symbol rather than a real Disj that straddles its native realization.
fn roster_covers_genuine_straddle(modeled: Symbol, native: Symbol) -> Bool {
  (length(xs: coproduct_arm_keys(type_name: modeled)) > 0)
    && roster_covers_straddle(modeled: modeled, native: native)
}


// The roster is non-empty (fail-closed: an empty roster would vacuously "pass" every per-subject
// check) and covers Bool over Value::Bool — the canonical unstructured straddle.
fn witness_cross_representation_roster_covers_bool() -> Bool {
  (length(xs: testgen_scheduled_cross_representation_equality_generators()) > 0)
    && roster_covers_genuine_straddle(modeled: ^Bool, native: cross_repr_native_value_bool)
}

// Coverage extends to the Value::Null sentinel runway: Optional (Absent | Present) over Value::Null.
// This is the fenced, deeper-root straddle — generated as a witness here, grounded separately.
fn witness_cross_representation_roster_covers_optional_null() -> Bool {
  roster_covers_genuine_straddle(modeled: ^Optional, native: cross_repr_native_value_null)
}


data witness_cross_representation_equality_is_equals: Bool = witness_cross_representation_claim_is_equals()


data witness_cross_representation_equality_uses_generated_anchor: Bool = witness_cross_representation_uses_generated_anchor()


data witness_cross_representation_equality_covers_bool: Bool = witness_cross_representation_roster_covers_bool()


data witness_cross_representation_equality_covers_optional_null: Bool = witness_cross_representation_roster_covers_optional_null()
