module v2.compiler.self_host


type CoreNode = v2.std.node.Node

type SourceModels {
  stage1_committed_seed_source: extdeps.communication.medium.Medium<String>
  stage2_regen_emitted_source: extdeps.communication.medium.Medium<String>
}

// WHAT THIS SYMBOL ACTUALLY GATES, renamed to say so.
//
// It read `self_host_equality_authority`, declaring byte identity to be the authority
// on self-host equality. DESIGN §7 says the opposite in as many words: a byte-identical
// fixed point is explicitly NOT the goal, because matching bytes forces the emitter to
// reproduce the seed's warts and thereby cements the seed's accidents. Under the old
// name the milestone meant the wrong thing in both directions — byte-identical but
// behaviorally wrong was the fixed point, and cleaner source that behaved identically
// was not.
//
// The machinery underneath was never the problem, and is NOT retired here. Its one
// production consumer is `v2.workflow.self_host_realized_comparison_claims`
// `self_host_realized_comparison_staleness_gate_holds`, which compares committed regen
// output against freshly emitted regen output — a staleness gate, the same shape as the
// ci.yml drift gate, and a fact worth gating on bytes because bytes are exactly what
// went stale. Two different facts were fused under one name: what regen drift means,
// and what self-hosting means. Only the second was wrong.
//
// Self-host equality now lives in `v2.compiler.self_host.promotion_admission`, which
// imports no filesystem surface and cannot read source bytes at all, so the two
// authorities cannot be confused again by reaching for whichever is nearer.
//
// Function and test identities under this module still read `self_host_*` while gating
// staleness. Renaming them is the remaining half and is blocked, not deferred by taste:
// `gunbc.witness_deferral_freeze` enumerates
// `self_host_fixed_point_validate_accepts_matching_regen_bytes` and
// `self_host_fixed_point_validate_rejects_perturbed_regen_bytes` at identity grain, and
// a frozen row the tree no longer carries refuses. A rename is a removal plus an
// addition outside the roster, so it reds the freeze gate. Dissolve-on: those two
// identities leave the frozen roster, at which point the `self_host_` prefix on the
// staleness machinery goes with them.
data regen_staleness_authority: v2.std.node.Symbol = ^canonical_emitted_bytes

type SelfHostStageEmission {
  node: CoreNode
  source: extdeps.communication.medium.Medium<String>
  digest: v2.std.node.Hash
}

type SelfHostFixpointEqual {
  over: v2.std.node.Symbol
  stage1: SelfHostStageEmission
  stage2: SelfHostStageEmission
}

type StructurallyEqual {
  left: CoreNode
  right: CoreNode
}

type BootstrapRoundtripEqual {
  produced_stage: CoreNode
  expected_stage: CoreNode
}

type StageEmissionEquality = v2.std.witness.Witness<StructurallyEqual>

type BootstrapRoundtripCheck = v2.std.witness.Witness<BootstrapRoundtripEqual>

type FixedPointCheck = v2.std.witness.Witness<SelfHostFixpointEqual>

type PromotionWitness {
  candidate_bootstrap_roundtrip_sub_check: BootstrapRoundtripCheck
  candidate_fixed_point_sub_check: FixedPointCheck
}

fn self_host_runner_not_realized_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^self_host_runner_not_realized,
    at: port_locus(port: ^self_host_runner_port),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn self_host_fixpoint_digest_mismatch_diagnostic(
  stage1: SelfHostStageEmission,
  stage2: SelfHostStageEmission
) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^self_host_fixpoint_digest_mismatch,
    at: node_locus(node: stage2.node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn source_text_code_unit_digest(text: String) -> v2.std.node.Hash {
  symbol_identity_digest(sym: text)
}

fn canonical_emitted_bytes_digest(source: extdeps.communication.medium.Medium<String>) -> v2.std.node.Hash {
  combine_hash(
    a: symbol_identity_digest(sym: ^canonical_emitted_bytes),
    b: source_text_code_unit_digest(text: source.carried)
  )
}

fn self_host_stage_emission(
  node: CoreNode,
  source: extdeps.communication.medium.Medium<String>
) -> SelfHostStageEmission {
  SelfHostStageEmission {
    node: node,
    source: source,
    digest: canonical_emitted_bytes_digest(source: source)
  }
}

fn self_host_fixpoint_equal(
  stage1: SelfHostStageEmission,
  stage2: SelfHostStageEmission
) -> SelfHostFixpointEqual {
  SelfHostFixpointEqual {
    over: regen_staleness_authority,
    stage1: stage1,
    stage2: stage2
  }
}

fn self_host_snake_closes(
  stage1: SelfHostStageEmission,
  stage2: SelfHostStageEmission
) -> v2.std.logic.Bool {
  stage1.digest == stage2.digest
}

fn self_host_fixpoint_witness(
  stage1: SelfHostStageEmission,
  stage2: SelfHostStageEmission
) -> FixedPointCheck {
  if self_host_snake_closes(stage1: stage1, stage2: stage2) {
    v2.std.witness.Holds {
      value: self_host_fixpoint_equal(stage1: stage1, stage2: stage2)
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: self_host_fixpoint_digest_mismatch_diagnostic(
        stage1: stage1,
        stage2: stage2
      )
    }
  }
}

fn source_models_regen_byte_pair_ready(models: SourceModels) -> v2.std.logic.Bool {
  !string_is_empty(s: models.stage1_committed_seed_source.carried)
    && !string_is_empty(s: models.stage2_regen_emitted_source.carried)
}

fn bootstrap_roundtrip_check(
  produced_stage: CoreNode,
  expected_stage: CoreNode
) -> BootstrapRoundtripCheck {
  match stage_emission_equality(
    emitted_candidate: produced_stage,
    reference_stage1: expected_stage
  ) {
    Holds { value: eq } =>
      v2.std.witness.Holds {
        value: BootstrapRoundtripEqual {
          produced_stage: eq.right,
          expected_stage: eq.left
        }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn fixed_point_scaffold(
  stage1_node: CoreNode,
  stage2_node: CoreNode,
  source_models: SourceModels
) -> FixedPointCheck {
  self_host_fixpoint_witness(
    stage1: self_host_stage_emission(
      node: stage1_node,
      source: source_models.stage1_committed_seed_source
    ),
    stage2: self_host_stage_emission(
      node: stage2_node,
      source: source_models.stage2_regen_emitted_source
    )
  )
}

fn candidate_promotion_witness(
  stage1_candidate: CoreNode,
  reference_stage1: CoreNode,
  source_models: SourceModels
) -> PromotionWitness {
  PromotionWitness {
    candidate_bootstrap_roundtrip_sub_check: bootstrap_roundtrip_check(
      produced_stage: stage1_candidate,
      expected_stage: reference_stage1
    ),
    candidate_fixed_point_sub_check: fixed_point_scaffold(
      stage1_node: reference_stage1,
      stage2_node: stage1_candidate,
      source_models: source_models
    )
  }
}

fn stage_emission_closedness(reference_stage1: CoreNode) -> v2.std.witness.StructuralPropertyWitness {
  v2.std.witness.StructuralPropertyWitness {
    property: ^stage_emission_equality_closed_candidates,
    evidence: reference_stage1
  }
}

fn self_host_fixed_point_digests_match(
  stage1_node: CoreNode,
  stage2_node: CoreNode,
  source_models: SourceModels
) -> v2.std.logic.Bool {
  self_host_snake_closes(
    stage1: self_host_stage_emission(
      node: stage1_node,
      source: source_models.stage1_committed_seed_source
    ),
    stage2: self_host_stage_emission(
      node: stage2_node,
      source: source_models.stage2_regen_emitted_source
    )
  )
}

fn stage_emission_equality(
  emitted_candidate: CoreNode,
  reference_stage1: CoreNode
) -> StageEmissionEquality {
  match find_witness(
    source_facts: reference_stage1,
    candidates: v2.std.find_witness.CandidateSet {
      candidates: [emitted_candidate],
      closedness: stage_emission_closedness(reference_stage1: reference_stage1)
    },
    predicate: v2.std.find_witness.PreservationPredicate {
      algebra: reference_stage1,
      preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
    },
    multiplicity_policy: UniqueOnly
  ) {
    Accepted { value: fw, diagnostics: _ } =>
      v2.std.witness.Holds {
        value: StructurallyEqual {
          left: reference_stage1,
          right: fw.candidate
        }
      }
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      v2.std.witness.Violates { diagnostic: d.head }
  }
}

fn boundary_tag_bytes(filename: String, content: String) -> String {
  concat(filename, concat("\n", content))
}

fn read_roster_manifest(manifest_path: String) -> List<String> {
  let raw = filesystem_read(path: manifest_path).content
  filter(xs: raw.split("\n"), predicate: fn(s) { !string_is_empty(s: s) })
}

fn fold_side_bytes(root: String, roster: List<String>) -> String {
  fold_list(
    xs: roster,
    empty: "",
    cons: fn(acc, filename) {
      let path = concat(root, concat("/", filename))
      let content = filesystem_read(path: path).content
      concat(acc, boundary_tag_bytes(filename: filename, content: content))
    }
  )
}

fn source_models_from_roster_and_roots(
  committed_root: String,
  emitted_root: String,
  roster: List<String>
) -> SourceModels {
  SourceModels {
    stage1_committed_seed_source: extdeps.communication.medium.Medium {
      carried: fold_side_bytes(root: committed_root, roster: roster),
      fidelity: extdeps.communication.medium.Lossless
    },
    stage2_regen_emitted_source: extdeps.communication.medium.Medium {
      carried: fold_side_bytes(root: emitted_root, roster: roster),
      fidelity: extdeps.communication.medium.Lossless
    }
  }
}

fn source_models_from_manifest_and_roots(
  committed_root: String,
  emitted_root: String,
  manifest_path: String
) -> SourceModels {
  source_models_from_roster_and_roots(
    committed_root: committed_root,
    emitted_root: emitted_root,
    roster: read_roster_manifest(manifest_path: manifest_path)
  )
}

fn self_host_fixed_point_validate(
  stage1_candidate: CoreNode,
  source_models: SourceModels,
  reference_stage1: CoreNode
) -> Outcome<PromotionWitness> {
  if !source_models_regen_byte_pair_ready(models: source_models) {
    v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(d: self_host_runner_not_realized_diagnostic())
    }
  } else {
    match fixed_point_scaffold(
      stage1_node: reference_stage1,
      stage2_node: stage1_candidate,
      source_models: source_models
    ) {
      Holds { value: _ } =>
        outcome_accepted(
          value: candidate_promotion_witness(
            stage1_candidate: stage1_candidate,
            reference_stage1: reference_stage1,
            source_models: source_models
          )
        )
      Violates { diagnostic: d } =>
        v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
    }
  }
}
