module v2.compiler.self_host

import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  node_locus,
  Outcome,
  port_locus,
  Rejected,
  Unavailable,
  diagnostics_singleton
}
import v2.std.find_witness {
  CandidateSet,
  PreservationPredicate,
  UniqueOnly,
  find_witness,
}
import v2.std.node { content_hash, Hash, Node, Symbol }
import v2.std.witness {
  Holds,
  StructuralPropertyWitness,
  Violates,
  Witness
}

type CoreNode = Node

type SourceModels {
  model_corpus: List<CoreNode>
}

data self_host_equality_authority: Symbol = ^canonical_node_emission

type SelfHostStageEmission {
  node: CoreNode
  digest: Hash
}

type SelfHostFixpointEqual {
  over: Symbol
  stage1: SelfHostStageEmission
  stage2: SelfHostStageEmission
}

type StructurallyEqual {
  left: CoreNode
  right: CoreNode
}

type BootstrapRoundtripEqual {
  produced_stage: CoreNode
  expected_stage: CoreNode
}

type StageEmissionEquality = Witness<StructurallyEqual>

type BootstrapRoundtripCheck = Witness<BootstrapRoundtripEqual>

type FixedPointCheck = Witness<SelfHostFixpointEqual>

type PromotionWitness {
  candidate_bootstrap_roundtrip_sub_check: BootstrapRoundtripCheck
  candidate_fixed_point_sub_check: FixedPointCheck
}

fn self_host_runner_not_realized_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^self_host_runner_not_realized,
    at: port_locus(port: ^self_host_runner_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn self_host_fixpoint_digest_mismatch_diagnostic(
  stage1: SelfHostStageEmission,
  stage2: SelfHostStageEmission
) -> Diagnostic {
  Diagnostic {
    reason: ^self_host_fixpoint_digest_mismatch,
    at: node_locus(node: stage2.node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn self_host_stage_emission(node: CoreNode) -> SelfHostStageEmission {
  SelfHostStageEmission {
    node: node,
    digest: content_hash(n: node)
  }
}

fn self_host_fixpoint_equal(
  stage1: SelfHostStageEmission,
  stage2: SelfHostStageEmission
) -> SelfHostFixpointEqual {
  SelfHostFixpointEqual {
    over: self_host_equality_authority,
    stage1: stage1,
    stage2: stage2
  }
}

fn self_host_snake_closes(
  stage1: SelfHostStageEmission,
  stage2: SelfHostStageEmission
) -> Bool {
  stage1.digest == stage2.digest
}

fn self_host_fixpoint_witness(
  stage1: SelfHostStageEmission,
  stage2: SelfHostStageEmission
) -> FixedPointCheck {
  if self_host_snake_closes(stage1: stage1, stage2: stage2) {
    Holds {
      value: self_host_fixpoint_equal(stage1: stage1, stage2: stage2)
    }
  } else {
    Violates {
      diagnostic: self_host_fixpoint_digest_mismatch_diagnostic(
        stage1: stage1,
        stage2: stage2
      )
    }
  }
}

fn candidate_promotion_witness(
  stage1_candidate: CoreNode,
  reference_stage1: CoreNode
) -> PromotionWitness {
  PromotionWitness {
    candidate_bootstrap_roundtrip_sub_check: bootstrap_roundtrip_scaffold(
      produced_stage: stage1_candidate,
      expected_stage: reference_stage1
    ),
    candidate_fixed_point_sub_check: fixed_point_scaffold(
      emitted_stage: stage1_candidate,
      reference_stage: reference_stage1
    )
  }
}

fn bootstrap_roundtrip_scaffold(
  produced_stage: CoreNode,
  expected_stage: CoreNode
) -> BootstrapRoundtripCheck {
  Violates {
    diagnostic: Diagnostic {
      reason: ^bootstrap_roundtrip_not_realized,
      at: node_locus(node: expected_stage),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

fn fixed_point_scaffold(
  emitted_stage: CoreNode,
  reference_stage: CoreNode
) -> FixedPointCheck {
  self_host_fixpoint_witness(
    stage1: self_host_stage_emission(node: reference_stage),
    stage2: self_host_stage_emission(node: emitted_stage)
  )
}

fn stage_emission_closedness(reference_stage1: CoreNode) -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: ^stage_emission_equality_closed_candidates,
    evidence: reference_stage1
  }
}

fn self_host_fixed_point_digests_match(
  emitted_stage1: CoreNode,
  emitted_stage2: CoreNode
) -> Bool {
  self_host_snake_closes(
    stage1: self_host_stage_emission(node: emitted_stage1),
    stage2: self_host_stage_emission(node: emitted_stage2)
  )
}

fn stage_emission_equality(
  emitted_candidate: CoreNode,
  reference_stage1: CoreNode
) -> StageEmissionEquality {
  match find_witness(
    source_facts: reference_stage1,
    candidates: CandidateSet {
      candidates: [emitted_candidate],
      closedness: stage_emission_closedness(reference_stage1: reference_stage1)
    },
    predicate: PreservationPredicate {
      algebra: reference_stage1,
      preservation_rule: ^preservation_rule_exact_structural_equality_zip_fold
    },
    multiplicity_policy: UniqueOnly
  ) {
    Accepted { value: fw, diagnostics: _ } =>
      Holds {
        value: StructurallyEqual {
          left: reference_stage1,
          right: fw.candidate
        }
      }
    Rejected { diagnostics: d } =>
      Violates { diagnostic: d.head }
  }
}

fn self_host_fixed_point_validate(
  stage1_candidate: CoreNode,
  source_models: SourceModels,
  reference_stage1: CoreNode
) -> Outcome<PromotionWitness> {
  Rejected {
    diagnostics: diagnostics_singleton(d: self_host_runner_not_realized_diagnostic())
  }
}
