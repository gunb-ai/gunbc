module v2.compiler.import_target_attribution

import std.algebra { Empty, FreeMonoid, fold_list, list_find_first, list_snoc_item, trim }
import std.types { Bool }
import v2.std.namespace_alias { AliasBindingRow }
import v2.std.node { Symbol }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string, qualified_name_init }
import v2.std.text { String }

// A FILE THE CLOSURE REFUSED AT INGEST, NAMED AS THE IMPORT TARGET IT WOULD HAVE BEEN. The census
// and the emit path both ask whether a consumer's import rows point at one of these; the answer is
// this lookup, not a second fold over the same rows (DESIGN section 3). `path` is the compilation
// unit, `cause` the fatal reason that refused the file.
type RefusedImportTarget {
  module: QualifiedName
  path: Symbol
  cause: Symbol
}

// THE MODULE A SOURCE DECLARES, READ FROM ITS HEADER LINE the same way the native lane reads a
// refused file (v2.compiler.compile native_lane_declared_module_name): the first `module ` line,
// because a parse refusal has no tree whose header can be folded.
fn declared_module_from_source(content: String) -> Optional<QualifiedName> {
  match list_find_first(
    xs: split(s: content, delimiter: "\n"),
    predicate: fn(line) { starts_with(s: trim(line), prefix: "module ") }
  ) {
    Absent => Absent
    Present { value: line } =>
      optional_present(
        value: qualified_name_from_dotted_string(
          dotted: trim(substring(s: trim(line), start: 7, end: string_length(s: trim(line))))
        )
      )
  }
}

fn import_binding_targets_module(row: AliasBindingRow, module: QualifiedName) -> Bool {
  qualified_name_init(qn: row.target) == module
}

// FIRST MATCHING REFUSED TARGET IN THE ORDER THE CLOSURE RECORDED THE REFUSALS, the same order
// v2.compiler.compile native_import_target_attribution walks file_refusals.
fn import_target_refused(
  import_bindings: FreeMonoid<AliasBindingRow>,
  refusals: FreeMonoid<RefusedImportTarget>
) -> Optional<RefusedImportTarget> {
  fold_list(xs: refusals, empty: optional_absent(), cons: fn(found, refusal) {
    match found {
      Present { value: _ } => found
      Absent =>
        if fold_list(xs: import_bindings, empty: false, cons: fn(hit, row) {
          hit || import_binding_targets_module(row: row, module: refusal.module)
        }) {
          optional_present(value: refusal)
        } else {
          optional_absent()
        }
    }
  })
}
