// Scope: §1.8 parity-by-execution witness for fold_lex_pattern<LexMatchThunk> algebra (C6).
// Exercises all 11 LexPattern variants via lex_try_rule; covers C1-C4 fail-safe arms directly.

module v2.test.tokenize.lex_match_thunk_claims


import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.algebra { Cons, Empty, is_empty }
import v2.std.compilers.lexing {
  BlockCommentTextChar,
  CharClassPattern,
  CharPattern,
  ChoicePattern,
  DelimitedPattern,
  DigitChar,
  EmptyPattern,
  KeywordPattern,
  LiteralPattern,
  OneOrMorePattern,
  OptionalPattern,
  RepeatPattern,
  SequencePattern,
  TriviaRule
}
import v2.compiler.tokenize {
  LexRuleNoMatch,
  LexRuleToken,
  LexRuleTrivia,
  lex_try_rule
}
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}


// Char codes: 'a'=97 'b'=98 'c'=99 '1'=49 '2'=50 '3'=51 'f'=102 'n'=110 ' '=32 '/'=47 '*'=42

data str_a: String = Cons { head: 97, tail: Empty }
data str_b: String = Cons { head: 98, tail: Empty }
data str_ab: String = Cons { head: 97, tail: Cons { head: 98, tail: Empty } }
data str_ac: String = Cons { head: 97, tail: Cons { head: 99, tail: Empty } }
data str_abc: String = Cons { head: 97, tail: Cons { head: 98, tail: Cons { head: 99, tail: Empty } } }
data str_bc: String = Cons { head: 98, tail: Cons { head: 99, tail: Empty } }
data str_aab: String = Cons { head: 97, tail: Cons { head: 97, tail: Cons { head: 98, tail: Empty } } }
data str_123: String = Cons { head: 49, tail: Cons { head: 50, tail: Cons { head: 51, tail: Empty } } }
data str_fn: String = Cons { head: 102, tail: Cons { head: 110, tail: Empty } }
data str_fn_space: String = Cons { head: 102, tail: Cons { head: 110, tail: Cons { head: 32, tail: Empty } } }
data str_fna: String = Cons { head: 102, tail: Cons { head: 110, tail: Cons { head: 97, tail: Empty } } }
data str_slash_star: String = Cons { head: 47, tail: Cons { head: 42, tail: Empty } }
data str_star_slash: String = Cons { head: 42, tail: Cons { head: 47, tail: Empty } }
// "/**/" — open "/*" immediately followed by close "*/"
data str_block_comment: String = Cons { head: 47, tail: Cons { head: 42, tail: Cons { head: 42, tail: Cons { head: 47, tail: Empty } } } }
// "/***/" — open "/*", then '*','*','/' where '*' is not BlockCommentTextChar and "**/" ≠ "*/"
data str_block_comment_extra_star: String = Cons { head: 47, tail: Cons { head: 42, tail: Cons { head: 42, tail: Cons { head: 42, tail: Cons { head: 47, tail: Empty } } } } }


test fn lex_match_thunk_claims_holds() -> Bool {
  // r1: EmptyPattern — always accepts; lexeme empty, remaining unchanged.
  let r1 = match lex_try_rule(
    rule: TriviaRule { pattern: EmptyPattern },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: lex, remaining: _ } => is_empty(xs: lex)
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }

  // r2: LiteralPattern — accept on prefix match; reject on mismatch.
  let r2_accept = match lex_try_rule(
    rule: TriviaRule { pattern: LiteralPattern { text: str_ab } },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: _, remaining: rem } => is_empty(xs: rem) == false
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r2_reject = match lex_try_rule(
    rule: TriviaRule { pattern: LiteralPattern { text: str_fn } },
    source: str_abc
  ) {
    LexRuleNoMatch => true
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r2 = r2_accept && r2_reject

  // r3: KeywordPattern C1 — boundary fail-safe: accept when boundary is non-ident-continue;
  // reject when IdentContinueChar follows ("fna" → reject because 'a'=97 is IdentContinueChar).
  let r3_accept = match lex_try_rule(
    rule: TriviaRule { pattern: KeywordPattern { text: str_fn } },
    source: str_fn_space
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r3_reject = match lex_try_rule(
    rule: TriviaRule { pattern: KeywordPattern { text: str_fn } },
    source: str_fna
  ) {
    LexRuleNoMatch => true
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r3 = r3_accept && r3_reject

  // r4: CharPattern — accept on matching char; reject on mismatch.
  let r4_accept = match lex_try_rule(
    rule: TriviaRule { pattern: CharPattern { char: 97 } },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r4_reject = match lex_try_rule(
    rule: TriviaRule { pattern: CharPattern { char: 97 } },
    source: str_bc
  ) {
    LexRuleNoMatch => true
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r4 = r4_accept && r4_reject

  // r5: CharClassPattern — accept on class member; reject on non-member.
  let r5_accept = match lex_try_rule(
    rule: TriviaRule { pattern: CharClassPattern { class: DigitChar } },
    source: str_123
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r5_reject = match lex_try_rule(
    rule: TriviaRule { pattern: CharClassPattern { class: DigitChar } },
    source: str_abc
  ) {
    LexRuleNoMatch => true
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r5 = r5_accept && r5_reject

  // r6: SequencePattern — C5 partial-fail: right rejects → whole sequence rejects.
  let r6_accept = match lex_try_rule(
    rule: TriviaRule { pattern: SequencePattern {
      left: CharPattern { char: 97 },
      right: CharPattern { char: 98 }
    } },
    source: str_ab
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r6_reject = match lex_try_rule(
    rule: TriviaRule { pattern: SequencePattern {
      left: CharPattern { char: 97 },
      right: CharPattern { char: 98 }
    } },
    source: str_ac
  ) {
    LexRuleNoMatch => true
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r6 = r6_accept && r6_reject

  // r7: ChoicePattern — C5 nested backtrack: left rejects → right accepted.
  let r7_left_wins = match lex_try_rule(
    rule: TriviaRule { pattern: ChoicePattern {
      left: CharPattern { char: 97 },
      right: CharPattern { char: 98 }
    } },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r7_right_wins = match lex_try_rule(
    rule: TriviaRule { pattern: ChoicePattern {
      left: CharPattern { char: 97 },
      right: CharPattern { char: 98 }
    } },
    source: str_bc
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r7_both_reject = match lex_try_rule(
    rule: TriviaRule { pattern: ChoicePattern {
      left: CharPattern { char: 97 },
      right: CharPattern { char: 98 }
    } },
    source: str_123
  ) {
    LexRuleNoMatch => true
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r7 = r7_left_wins && r7_right_wins && r7_both_reject

  // r8: OptionalPattern — zero match succeeds (empty lexeme, remaining unchanged).
  let r8_match = match lex_try_rule(
    rule: TriviaRule { pattern: OptionalPattern { element: CharPattern { char: 97 } } },
    source: str_abc
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r8_no_match = match lex_try_rule(
    rule: TriviaRule { pattern: OptionalPattern { element: CharPattern { char: 97 } } },
    source: str_bc
  ) {
    LexRuleTrivia { lexeme: lex, remaining: _ } => is_empty(xs: lex)
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r8 = r8_match && r8_no_match

  // r9: RepeatPattern — C3 zero-width guard: repeat(optional('a')) on "b" terminates without loop.
  // optional('a') returns empty lexeme on 'b'; guard detects is_empty(consumed) and sets done:true.
  let r9_multi = match lex_try_rule(
    rule: TriviaRule { pattern: RepeatPattern { element: CharPattern { char: 97 } } },
    source: str_aab
  ) {
    LexRuleTrivia { lexeme: _, remaining: rem } => is_empty(xs: rem) == false
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r9_zero_width_guard = match lex_try_rule(
    rule: TriviaRule { pattern: RepeatPattern { element: OptionalPattern { element: CharPattern { char: 97 } } } },
    source: str_b
  ) {
    LexRuleTrivia { lexeme: lex, remaining: _ } => is_empty(xs: lex)
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r9 = r9_multi && r9_zero_width_guard

  // r10: OneOrMorePattern C2 — ≥1 required; zero matches → reject.
  let r10_accept = match lex_try_rule(
    rule: TriviaRule { pattern: OneOrMorePattern { element: CharPattern { char: 97 } } },
    source: str_aab
  ) {
    LexRuleTrivia { lexeme: _, remaining: _ } => true
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r10_reject = match lex_try_rule(
    rule: TriviaRule { pattern: OneOrMorePattern { element: CharPattern { char: 97 } } },
    source: str_b
  ) {
    LexRuleNoMatch => true
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r10 = r10_accept && r10_reject

  // r11: DelimitedPattern C4 — try-close-FIRST shared-star proof.
  // "/**/" accepts: after open "/*", remaining="*/"; close "*/" tried FIRST → matches immediately.
  // "/***/": remaining="**/"; close "*/" on "**/" = '*'='*' then '*'≠'/' → reject;
  //   body BlockCommentTextChar on '*' = c==42 → c!=42 false → reject; done+failed → LexRuleNoMatch.
  let r11_accept = match lex_try_rule(
    rule: TriviaRule { pattern: DelimitedPattern {
      open: LiteralPattern { text: str_slash_star },
      body: CharClassPattern { class: BlockCommentTextChar },
      close: LiteralPattern { text: str_star_slash }
    } },
    source: str_block_comment
  ) {
    LexRuleTrivia { lexeme: _, remaining: rem } => is_empty(xs: rem)
    LexRuleNoMatch => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r11_reject = match lex_try_rule(
    rule: TriviaRule { pattern: DelimitedPattern {
      open: LiteralPattern { text: str_slash_star },
      body: CharClassPattern { class: BlockCommentTextChar },
      close: LiteralPattern { text: str_star_slash }
    } },
    source: str_block_comment_extra_star
  ) {
    LexRuleNoMatch => true
    LexRuleTrivia { lexeme: _, remaining: _ } => false
    LexRuleToken { class: _, lexeme: _, remaining: _ } => false
  }
  let r11 = r11_accept && r11_reject

  r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8 && r9 && r10 && r11
}

