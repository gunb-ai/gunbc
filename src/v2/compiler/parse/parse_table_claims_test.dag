// Scope: v2.compiler.parse `token_position_indices` as a discriminating
// claim-run witness, routed through v2 (`dag run --claim-run`).
// Carries the EXECUTABLE behavioral content of the `token_position_indices` no-extra-append
// receipt — the executable receipt is now the in-file claim witness below, run in-process by
// the claim_batch binary (formerly a host source-grep `!PARSE_DAG.contains("item: length(xs: tokens)")`) — as a
// `fn -> Bool` witness that EXECUTES token_position_indices over a fixed token list and
// DISCRIMINATES the produced 0..N index sequence: a duplicate final append (the regressed
// shape) yields an extra index, turning the witness red. Mutating the fold turns it red.
// NOTE: the parse_table grammar core (parse_production / grammar_has_* / parse_skip_to_sync)
// is NOT migrated here — it CRASHES through v2 with `contains expects a string argument, got
// Variant` (the 'contains-Variant-gap' v2-interpreter builtin gap). Those receipts stay

module v2.test.parse.parse_table_claims


import v2.std.logic { Bool }
import v2.std.collection { List, Set }
import v2.std.algebra { Cons, Empty, length }
import v2.std.compilers.lexing { Token }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node {
  Atom,
  Node,
  Symbol,
  TypeNode
}
import v2.std.grammar {
  Choice,
  GrammarExpr,
  GrammarProduction,
  GrammarRoot,
  ModeledGrammar,
  Nonterminal,
  Optional,
  ParseGrammar,
  Repeat,
  Sequence,
  Terminal,
  grammar_atom,
  grammar_carries_symbol,
  grammar_empty_sync_tokens
}
import v2.compiler.parse {
  expr_direct_left_corner_list,
  expr_has_undefined_nonterminal,
  expr_is_nullable_given_set,
  parse_expr,
  parse_prov_initial,
  parse_table_empty,
  ParseExprAccepted,
  ParseExprRejected,
  token_position_indices
}

import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
fn parse_table_token(class: Symbol) -> Token {
  Token { class: class, lexeme: Empty, file: class, start: 0, end: 0 }
}


// Two-token input. token_position_indices threads positions 0..N as a structurally bounded
// fold seeded with [0], snoc-ing length(acc) per token: [0] → [0,1] → [0,1,2]. The fix
// produces exactly N+1 = 3 entries with NO duplicate final append (which would give 4).
data parse_table_two_tokens: List<Token> = Cons {
  head: parse_table_token(class: ^parse_table_probe_class),
  tail: Cons { head: parse_table_token(class: ^parse_table_probe_class), tail: Empty }
}

data parse_table_empty_tokens: List<Token> = Empty


// Receipt A (token_position_indices is 0..N with no extra final append): a 2-token input
// yields exactly 3 indices, and the empty input yields exactly 1 ([0]). The negative arm
// (== 4 is false) pins the no-duplicate-append property; a regressed extra snoc → red.
test fn parse_table_token_position_indices_no_extra_append_holds() -> Bool {
  (length(xs: token_position_indices(tokens: parse_table_two_tokens)) == 3)
    && (length(xs: token_position_indices(tokens: parse_table_empty_tokens)) == 1)
    && ((length(xs: token_position_indices(tokens: parse_table_two_tokens)) == 4) == false)
}

// Singleton nullable set: only `name` is nullable.
fn nullable_set_singleton(name: Symbol) -> Set<Symbol> {
  Set { member: fn(sym) { sym == name } }
}


// Receipt B (expr_is_nullable_given_set is a correct GrammarExprFold catamorphism consumer):
// EXECUTES the rewritten nullable query over a fixed nullable set across every GrammarExpr
// variant and BOTH branch directions, discriminating each result:
//   - Terminal: never nullable (false)
//   - Nonterminal: nullable iff in the set (probe → true, other → false)
//   - Optional / Repeat: always nullable (true)
//   - Sequence: nullable iff BOTH sides nullable (Optional;probe → true; Terminal;Optional → false)
//   - Choice: nullable iff EITHER side nullable (Terminal|Optional → true; Terminal|other → false)
// Mutating any combine arm of expr_is_nullable_given_set (or fold_grammar_expr's recursion) flips
// at least one conjunct → red.
test fn parse_table_nullable_morphism_holds() -> Bool {
  let ns = nullable_set_singleton(name: ^parse_table_nullable_probe_nt)
  (expr_is_nullable_given_set(
    expr: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent },
    nullable_set: ns
  ) == false)
    && (expr_is_nullable_given_set(
      expr: Optional { element: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent } },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Repeat { element: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent } },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Nonterminal { production: ^parse_table_nullable_probe_nt },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Nonterminal { production: ^parse_table_nullable_other_nt },
      nullable_set: ns
    ) == false)
    && (expr_is_nullable_given_set(
      expr: Sequence {
        left: Optional { element: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent } },
        right: Nonterminal { production: ^parse_table_nullable_probe_nt }
      },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Sequence {
        left: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent },
        right: Optional { element: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent } }
      },
      nullable_set: ns
    ) == false)
    && (expr_is_nullable_given_set(
      expr: Choice {
        left: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent },
        right: Optional { element: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent } }
      },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Choice {
        left: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent },
        right: Nonterminal { production: ^parse_table_nullable_other_nt }
      },
      nullable_set: ns
    ) == false)
}


// ModeledGrammar whose single production expression nests every compound GrammarExpr variant
// (Sequence over Choice over Optional over Repeat) plus the leaf variants (Terminal, Nonterminal).
// grammar_carries_symbol projects the grammar to a Node via grammar_expr_to_node (now a
// fold_grammar_expr consumer) and folds it looking for an atom identity.
fn parse_table_projection_grammar() -> ParseGrammar {
  ModeledGrammar {
    root: GrammarRoot {
      start: ^pt_proj_start,
      productions: Cons {
        head: GrammarProduction {
          name: ^pt_proj_start,
          expression: Sequence {
            left: Terminal { token_class: ^pt_proj_tok_a, binding: Absent },
            right: Choice {
              left: Nonterminal { production: ^pt_proj_nt_b },
              right: Optional { element: Repeat { element: Terminal { token_class: ^pt_proj_tok_c, binding: Absent } } }
            }
          },
          emitted: grammar_atom(identity: ^pt_proj_start)
        },
        tail: Empty
      },
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}


// Receipt C (grammar_expr_to_node walker dissolution is behavior-preserving): the projection now
// routes through fold_grammar_expr. EXECUTES grammar_carries_symbol over a grammar nesting all six
// GrammarExpr variants and discriminates: each symbol that the projection must carry through a
// distinct variant's edge (Terminal token_class, Nonterminal production, Repeat-wrapped Terminal)
// is found; an absent symbol is not. Dropping any variant's child edge in the fold algebra makes
// the corresponding symbol unreachable → red.
test fn parse_table_grammar_expr_projection_holds() -> Bool {
  (grammar_carries_symbol(grammar: parse_table_projection_grammar(), sym: ^pt_proj_tok_a) == true)
    && (grammar_carries_symbol(grammar: parse_table_projection_grammar(), sym: ^pt_proj_nt_b) == true)
    && (grammar_carries_symbol(grammar: parse_table_projection_grammar(), sym: ^pt_proj_tok_c) == true)
    && (grammar_carries_symbol(grammar: parse_table_projection_grammar(), sym: ^pt_proj_absent) == false)
}


// GrammarRoot with a single defined production for undefined-nonterminal receipt fixtures.
data parse_table_defined_root: GrammarRoot = GrammarRoot {
  start: ^pt_undef_defined,
  productions: Cons {
    head: GrammarProduction {
      name: ^pt_undef_defined,
      expression: Terminal { token_class: ^pt_undef_tok, binding: Absent },
      emitted: grammar_atom(identity: ^pt_undef_defined)
    },
    tail: Empty
  },
  sync_tokens: grammar_empty_sync_tokens()
}


// Receipt D (expr_direct_left_corner_list is a correct GrammarExprFold catamorphism consumer):
// EXECUTES the fold-based left-corner query over a fixed nullable set across every GrammarExpr
// variant, discriminating corner-list cardinality:
//   - Terminal: empty (0)
//   - Nonterminal: singleton (1)
//   - Sequence: right corners included iff left is nullable (1 vs 0)
//   - Choice: append both sides (2)
//   - Optional / Repeat: element corners (1)
// Mutating any combine arm of expr_corner_nullable_fold flips at least one conjunct → red.
test fn parse_table_left_corner_morphism_holds() -> Bool {
  let ns = nullable_set_singleton(name: ^parse_table_nullable_probe_nt)
  (length(xs: expr_direct_left_corner_list(
    expr: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent },
    nullable_set: ns
  )) == 0)
    && (length(xs: expr_direct_left_corner_list(
      expr: Nonterminal { production: ^parse_table_nullable_probe_nt },
      nullable_set: ns
    )) == 1)
    && (length(xs: expr_direct_left_corner_list(
      expr: Sequence {
        left: Optional { element: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent } },
        right: Nonterminal { production: ^parse_table_nullable_probe_nt }
      },
      nullable_set: ns
    )) == 1)
    && (length(xs: expr_direct_left_corner_list(
      expr: Sequence {
        left: Terminal { token_class: ^parse_table_nullable_tok, binding: Absent },
        right: Nonterminal { production: ^parse_table_nullable_probe_nt }
      },
      nullable_set: ns
    )) == 0)
    && (length(xs: expr_direct_left_corner_list(
      expr: Choice {
        left: Nonterminal { production: ^parse_table_nullable_probe_nt },
        right: Nonterminal { production: ^parse_table_nullable_other_nt }
      },
      nullable_set: ns
    )) == 2)
    && (length(xs: expr_direct_left_corner_list(
      expr: Optional { element: Nonterminal { production: ^parse_table_nullable_probe_nt } },
      nullable_set: ns
    )) == 1)
    && (length(xs: expr_direct_left_corner_list(
      expr: Repeat { element: Nonterminal { production: ^parse_table_nullable_probe_nt } },
      nullable_set: ns
    )) == 1)
}


// Receipt E (expr_has_undefined_nonterminal is a correct GrammarExprFold catamorphism consumer):
// EXECUTES the fold-based undefined-reference scan over a fixed GrammarRoot across every
// GrammarExpr variant, discriminating each result:
//   - Terminal: never undefined (false)
//   - Nonterminal: undefined iff absent from root (missing → true, defined → false)
//   - Sequence / Choice / Optional / Repeat: propagate via OR through child scans
// Mutating any combine arm flips at least one conjunct → red.
test fn parse_table_undefined_nonterminal_morphism_holds() -> Bool {
  let root = parse_table_defined_root
  (expr_has_undefined_nonterminal(
    expr: Terminal { token_class: ^pt_undef_tok, binding: Absent },
    root: root
  ) == false)
    && (expr_has_undefined_nonterminal(
      expr: Nonterminal { production: ^pt_undef_defined },
      root: root
    ) == false)
    && (expr_has_undefined_nonterminal(
      expr: Nonterminal { production: ^pt_undef_missing },
      root: root
    ) == true)
    && (expr_has_undefined_nonterminal(
      expr: Sequence {
        left: Terminal { token_class: ^pt_undef_tok, binding: Absent },
        right: Nonterminal { production: ^pt_undef_missing }
      },
      root: root
    ) == true)
    && (expr_has_undefined_nonterminal(
      expr: Sequence {
        left: Terminal { token_class: ^pt_undef_tok, binding: Absent },
        right: Nonterminal { production: ^pt_undef_defined }
      },
      root: root
    ) == false)
    && (expr_has_undefined_nonterminal(
      expr: Choice {
        left: Terminal { token_class: ^pt_undef_tok, binding: Absent },
        right: Nonterminal { production: ^pt_undef_missing }
      },
      root: root
    ) == true)
    && (expr_has_undefined_nonterminal(
      expr: Optional { element: Nonterminal { production: ^pt_undef_missing } },
      root: root
    ) == true)
}







// Receipt F (parse_expr combinator dissolution behavior witness): EXECUTES the new
// fold_grammar_expr-based parse_expr — R = fn(tok_in,all_toks,root_in,table_in,prov_in)->ParseExprResult —
// over token fixtures covering all 6 GrammarExpr variants and both accept/reject branches.
// node://adhoc-b967ce68-4da proof §1.7; still-raven-546 load-bearing contract point 2.
// Covers: Terminal match, Terminal reject, Sequence A;B, Choice backtrack (A|B on [B]),
// Optional on reject (accept empty, remaining unchanged), Repeat with progress ([A,A,B] → 2 consumed),
// Repeat no-progress guard (Optional{A} on [B] → done guard fires → Accepted, 1 remaining),
// Nonterminal with undefined production → Rejected (grammar_lookup_production Violates path).
test fn parse_table_parse_expr_combinator_holds() -> Bool {
  let prov = parse_prov_initial()
  let table = parse_table_empty()
  let root = GrammarRoot {
    start: ^pt_parse_expr_start,
    productions: Empty,
    sync_tokens: grammar_empty_sync_tokens()
  }
  let tok_a = parse_table_token(class: ^pt_parse_expr_tok_a)
  let tok_b = parse_table_token(class: ^pt_parse_expr_tok_b)
  let toks_a = Cons { head: tok_a, tail: Empty }
  let toks_b = Cons { head: tok_b, tail: Empty }
  let toks_ab = Cons { head: tok_a, tail: Cons { head: tok_b, tail: Empty } }
  let toks_aab = Cons { head: tok_a, tail: Cons { head: tok_a, tail: Cons { head: tok_b, tail: Empty } } }
  let r1 = match parse_expr(
    expr: Terminal { token_class: ^pt_parse_expr_tok_a, binding: Absent },
    tokens: toks_a, all_tokens: toks_a, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _ } =>
      length(xs: rest) == 0
    ParseExprRejected { diagnostics: _ } => false
  }
  let r2 = match parse_expr(
    expr: Terminal { token_class: ^pt_parse_expr_tok_a, binding: Absent },
    tokens: toks_b, all_tokens: toks_b, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _ } => false
    ParseExprRejected { diagnostics: _ } => true
  }
  let r3 = match parse_expr(
    expr: Sequence {
      left: Terminal { token_class: ^pt_parse_expr_tok_a, binding: Absent },
      right: Terminal { token_class: ^pt_parse_expr_tok_b, binding: Absent }
    },
    tokens: toks_ab, all_tokens: toks_ab, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _ } =>
      length(xs: rest) == 0
    ParseExprRejected { diagnostics: _ } => false
  }
  let r4 = match parse_expr(
    expr: Choice {
      left: Terminal { token_class: ^pt_parse_expr_tok_a, binding: Absent },
      right: Terminal { token_class: ^pt_parse_expr_tok_b, binding: Absent }
    },
    tokens: toks_b, all_tokens: toks_b, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _ } =>
      length(xs: rest) == 0
    ParseExprRejected { diagnostics: _ } => false
  }
  let r5 = match parse_expr(
    expr: Optional { element: Terminal { token_class: ^pt_parse_expr_tok_a, binding: Absent } },
    tokens: toks_b, all_tokens: toks_b, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _ } =>
      length(xs: rest) == 1
    ParseExprRejected { diagnostics: _ } => false
  }
  let r6 = match parse_expr(
    expr: Repeat { element: Terminal { token_class: ^pt_parse_expr_tok_a, binding: Absent } },
    tokens: toks_aab, all_tokens: toks_aab, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _ } =>
      length(xs: rest) == 1
    ParseExprRejected { diagnostics: _ } => false
  }
  let r7 = match parse_expr(
    expr: Repeat { element: Optional { element: Terminal { token_class: ^pt_parse_expr_tok_a, binding: Absent } } },
    tokens: toks_b, all_tokens: toks_b, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: rest, captured: _, diagnostics: _, prov: _ } =>
      length(xs: rest) == 1
    ParseExprRejected { diagnostics: _ } => false
  }
  let r8 = match parse_expr(
    expr: Nonterminal { production: ^pt_parse_expr_undefined_prod },
    tokens: toks_a, all_tokens: toks_a, root: root, table: table, prov: prov
  ) {
    ParseExprAccepted { remaining: _, captured: _, diagnostics: _, prov: _ } => false
    ParseExprRejected { diagnostics: _ } => true
  }
  r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8
}

