// src/v2/compiler/parse/parse_table_content_key_test.dag
//
// DESIGN-FIRST §5 proof for the ParseTable content-key (realize SUBJECT) model
// (node adhoc-822f5c65-e9c, ROADMAP §2 P2). parse_table_subject folds the table scope
// (grammar_digest × token_stream_digest) with the cell coordinate (position × production) into
// ONE content hash. These witnesses prove the content-addressing property BY EXECUTION:
//
//  - DETERMINISTIC: two independently-constructed cells with identical (grammar, token-stream,
//    position, production) derive the SAME subject.
//  - DISCRIMINATING per component: perturbing ANY ONE of the four inputs moves the subject.
//    Each witness is the discriminating red for one component — if parse_table_subject dropped
//    that component from the fold, the corresponding witness collides and goes red. Together
//    they pin that all four are load-bearing (no under-keying = no cross-cell/cross-source
//    pollution, the §2 P2 "honest key" requirement).
//
// Run: gunbc run --source-root src/v2 \
//   --entry src/v2/compiler/parse/parse_table_content_key_test.dag \
//   --function parse_table_content_key_witnesses --claim-run

module v2.test.parse.parse_table_content_key

import v2.compiler.parse { ParseTable, ParseTableRealization, ParsePositionKey, parse_table_subject }
import v2.std.collection { empty_map }
import v2.std.node { Hash }
import v2.std.logic { Bool }

// Two table-scopes differing only in grammar_digest; a third differing only in token_stream_digest.
fn mk_table(grammar: Hash, tokens: Hash) -> ParseTable {
  ParseTableRealization {
    artifact_kind: ^parse_table,
    interface: ^parse_table_memo,
    grammar_digest: grammar,
    token_stream_digest: tokens,
    entries: empty_map()
  }
}

fn grammar_one() -> Hash { atom_identity_hash(s: ^ctk_grammar_one) }
fn grammar_two() -> Hash { atom_identity_hash(s: ^ctk_grammar_two) }
fn tokens_one() -> Hash { atom_identity_hash(s: ^ctk_tokens_one) }
fn tokens_two() -> Hash { atom_identity_hash(s: ^ctk_tokens_two) }

fn table_g1_t1() -> ParseTable { mk_table(grammar: grammar_one(), tokens: tokens_one()) }
fn table_g2_t1() -> ParseTable { mk_table(grammar: grammar_two(), tokens: tokens_one()) }
fn table_g1_t2() -> ParseTable { mk_table(grammar: grammar_one(), tokens: tokens_two()) }

fn key_p0_a() -> ParsePositionKey { ParsePositionKey { position: 0, production: ^ctk_prod_a } }
fn key_p1_a() -> ParsePositionKey { ParsePositionKey { position: 1, production: ^ctk_prod_a } }
fn key_p0_b() -> ParsePositionKey { ParsePositionKey { position: 0, production: ^ctk_prod_b } }

// DETERMINISTIC — identical inputs, independently constructed, derive the SAME subject. RED if
// the derivation were nondeterministic (e.g. keyed on table identity rather than content).
fn witness_subject_deterministic() -> Bool {
  parse_table_subject(table: table_g1_t1(), key: key_p0_a())
    == parse_table_subject(table: mk_table(grammar: grammar_one(), tokens: tokens_one()), key: key_p0_a())
}

// POSITION sensitive — same table+production, position 0 vs 1 -> distinct. RED if position dropped.
fn witness_subject_position_sensitive() -> Bool {
  parse_table_subject(table: table_g1_t1(), key: key_p0_a())
    != parse_table_subject(table: table_g1_t1(), key: key_p1_a())
}

// PRODUCTION sensitive — same table+position, production a vs b -> distinct. RED if production dropped.
fn witness_subject_production_sensitive() -> Bool {
  parse_table_subject(table: table_g1_t1(), key: key_p0_a())
    != parse_table_subject(table: table_g1_t1(), key: key_p0_b())
}

// GRAMMAR-SCOPE sensitive — same cell coordinate, different grammar_digest -> distinct. RED if the
// grammar scope dropped (would reuse a cell across grammars).
fn witness_subject_grammar_scope_sensitive() -> Bool {
  parse_table_subject(table: table_g1_t1(), key: key_p0_a())
    != parse_table_subject(table: table_g2_t1(), key: key_p0_a())
}

// TOKEN-STREAM-SCOPE sensitive — same cell coordinate, different token_stream_digest -> distinct.
// RED if the token-stream scope dropped (the cross-source pollution the digest exists to prevent).
fn witness_subject_token_stream_scope_sensitive() -> Bool {
  parse_table_subject(table: table_g1_t1(), key: key_p0_a())
    != parse_table_subject(table: table_g1_t2(), key: key_p0_a())
}

test fn parse_table_content_key_witnesses() -> Bool {
  witness_subject_deterministic()
    && witness_subject_position_sensitive()
    && witness_subject_production_sensitive()
    && witness_subject_grammar_scope_sensitive()
    && witness_subject_token_stream_scope_sensitive()
}
