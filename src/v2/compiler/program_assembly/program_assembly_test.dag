// Scope: Stage C Lane 3 — by-execution receipts for whole SourceRootIngest program assembly.
// Anchor: DESIGN.md §5 — multi-file ingest fold greens + discriminating duplicate-module RED.

module v2.test.compiler.program_assembly

import v2.compiler.compile {
  compile_source_root_ingest_with_admission
}
import v2.compiler.name_resolve {
  Admission,
  Import,
  ImportVisible,
  ResolutionSubject
}
import v2.compiler.program_assembly {
  assemble_program_from_ingest,
  module_roots_from_source_root_ingest
}
import v2.compiler.source_authority {
  DagSource,
  DagSourceReadWitness,
  SourceRootIngest
}
import v2.extdeps.languages.dag {
  dag_language_model_wave1,
  dag_mvp1_target_model
}
import v2.std.algebra { Cons, Empty, length }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.qualified_name { QnCons, QnEmpty }


data pa_alpha_file: Symbol = pa_alpha_file
data pa_beta_file: Symbol = pa_beta_file
data pa_alpha_compilation_unit: Symbol = pa_alpha_compilation_unit
data pa_beta_compilation_unit: Symbol = pa_beta_compilation_unit
data pa_alpha_seg: Symbol = pa_alpha_seg
data pa_beta_seg: Symbol = pa_beta_seg
data pa_peer_seg: Symbol = pa_peer_seg
data pa_subject_seg: Symbol = pa_subject_seg
data pa_export_sym: Symbol = pa_export_sym
data pa_import_use_sym: Symbol = pa_import_use_sym

data pa_alpha_source: DagSource = "module pa_alpha_seg\nfn fna(x:Int, y:Int) -> Int { x + y }"
data pa_beta_source: DagSource = "module pa_beta_seg\nfn fnb(x:Int, y:Int) -> Int { x + y }"
data pa_peer_source: DagSource = "module pa_peer_seg\ndata pa_export_sym: Symbol = pa_export_sym"
data pa_subject_import_source: DagSource = "module pa_subject_seg\nimport pa_peer_seg { pa_export_sym }\ndata pa_import_use_sym: Symbol = pa_export_sym"

data pa_alpha_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^pa_alpha_artifact,
  file_path: "src/v2/test/fixture/pa_alpha.dag"
}

data pa_beta_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^pa_beta_artifact,
  file_path: "src/v2/test/fixture/pa_beta.dag"
}

data pa_peer_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^pa_peer_artifact,
  file_path: "src/v2/test/fixture/pa_peer.dag"
}

data pa_subject_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^pa_subject_artifact,
  file_path: "src/v2/test/fixture/pa_subject.dag"
}

data pa_alpha_read: DagSourceReadWitness = DagSourceReadWitness {
  source: pa_alpha_source,
  artifact: pa_alpha_artifact,
  compilation_unit: pa_alpha_compilation_unit
}

data pa_beta_read: DagSourceReadWitness = DagSourceReadWitness {
  source: pa_beta_source,
  artifact: pa_beta_artifact,
  compilation_unit: pa_beta_compilation_unit
}

data pa_peer_read: DagSourceReadWitness = DagSourceReadWitness {
  source: pa_peer_source,
  artifact: pa_peer_artifact,
  compilation_unit: pa_peer_seg
}

data pa_subject_read: DagSourceReadWitness = DagSourceReadWitness {
  source: pa_subject_import_source,
  artifact: pa_subject_artifact,
  compilation_unit: pa_subject_seg
}

data pa_two_module_ingest: SourceRootIngest = [pa_alpha_read, pa_beta_read]

data pa_duplicate_module_ingest: SourceRootIngest = [pa_alpha_read, pa_alpha_read]

data pa_cross_file_ingest: SourceRootIngest = [pa_subject_read, pa_peer_read]

fn pa_alpha_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: QnCons { head: pa_alpha_seg, tail: QnEmpty }
    },
    imports: Empty
  }
}

fn pa_cross_file_admission() -> Admission {
  Admission {
    subject: ResolutionSubject {
      name: QnCons { head: pa_subject_seg, tail: QnEmpty }
    },
    imports: Cons {
      head: Import {
        target: QnCons { head: pa_peer_seg, tail: QnEmpty },
        visibility: ImportVisible
      },
      tail: Empty
    }
  }
}


test fn program_assembly_two_module_roots_fold_holds() -> Bool {
  match module_roots_from_source_root_ingest(
    ingest: pa_two_module_ingest,
    lm: dag_language_model_wave1()
  ) {
    Accepted { value: roots, diagnostics: _ } =>
      length(xs: roots) == 2
    Rejected { diagnostics: _ } => false
  }
}


test fn program_assembly_single_subject_assembles_holds() -> Bool {
  match assemble_program_from_ingest(
    ingest: Cons { head: pa_alpha_read, tail: Empty },
    admission: pa_alpha_admission(),
    lm: dag_language_model_wave1()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


test fn program_assembly_duplicate_module_roots_rejects() -> Bool {
  match assemble_program_from_ingest(
    ingest: pa_duplicate_module_ingest,
    admission: pa_alpha_admission(),
    lm: dag_language_model_wave1()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}


test fn program_assembly_cross_file_import_assembles_holds() -> Bool {
  match assemble_program_from_ingest(
    ingest: pa_cross_file_ingest,
    admission: pa_cross_file_admission(),
    lm: dag_language_model_wave1()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


test fn compile_source_root_ingest_with_admission_emits_holds() -> Bool {
  match compile_source_root_ingest_with_admission(
    ingest: Cons { head: pa_alpha_read, tail: Empty },
    admission: pa_alpha_admission(),
    target: dag_mvp1_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}
