module v2.compiler.emit_semantic_decl


fn emit_semantic_decl_unsupported_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^emit_semantic_decl_unsupported_shape,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn emit_decl_surface(
  surface: v2.std.node.Node,
  rules: v2.std.node.Node,
  profile: v2.std.compilers.semantic_decl_emission.TargetSemanticDeclSerializeProfile
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.translate.grammar_relation_row_for_emitted(rules: rules, emitted: surface),
    f: fn(row) {
      v2.std.diagnostic.bind_outcome(
        o: v2.compiler.translate.grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.target_model.concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              v2.std.diagnostic.bind_outcome(
                o: v2.std.compilers.semantic_decl_emission.semantic_decl_serialize_target(profile: profile, rules: rules),
                f: fn(serialize_target) {
                  v2.compiler.translate.serialize_concrete_syntax_tokens_to_source(
                    target: serialize_target,
                    tokens: tokens
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn emit_semantic_type_decl(
  name: v2.std.node.Symbol,
  params: List<v2.std.node.Symbol>,
  node: v2.std.node.Node,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: v2.std.compilers.semantic_decl_emission.semantic_decl_emission_from_target(target: target),
    f: fn(emission) {
      match node.kind {
        v2.std.node.TypeNode { connective: v2.std.node.Disj } =>
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.semantic_decl_emission.target_semantic_enum_surface_from_coproduct(
              projection: emission.surface,
              name: name,
              params: params,
              coproduct: node
            ),
            f: fn(surface) {
              emit_decl_surface(
                surface: surface,
                rules: emission.enum_translation_rules,
                profile: emission.enum_serialize_profile
              )
            }
          )
        v2.std.node.TypeNode { connective: v2.std.node.Conj } =>
          v2.std.diagnostic.bind_outcome(
            o: v2.std.compilers.semantic_decl_emission.target_semantic_struct_surface_from_record(
              projection: emission.surface,
              name: name,
              params: params,
              record: node
            ),
            f: fn(surface) {
              emit_decl_surface(
                surface: surface,
                rules: emission.struct_translation_rules,
                profile: emission.struct_serialize_profile
              )
            }
          )
        _ => v2.std.diagnostic.outcome_rejected(d: emit_semantic_decl_unsupported_diagnostic(node: node))
      }
    }
  )
}
