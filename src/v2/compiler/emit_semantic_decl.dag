module v2.compiler.emit_semantic_decl

import v2.compiler.translate { serialize_concrete_syntax_tokens_to_source }
import v2.compiler.target_serialize { grammar_relation_row_for_emitted, grammar_relation_row_tokens_root }
import v2.std.compilers.semantic_decl_emission {
  TargetSemanticDeclSerializeProfile,
  semantic_decl_emission_from_target,
  semantic_decl_serialize_target,
  target_semantic_enum_surface_from_coproduct,
  target_semantic_struct_surface_from_record
}
import v2.std.collection { List, Map, empty_map }
import v2.std.compilers.target_model { TargetModel, concrete_syntax_token_list_from_node }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_rejected
}
import v2.std.node { Atom, Disj, Conj, Node, Symbol, TypeNode }
import extdeps.communication.medium { Medium }
import v2.std.text { String }
import std.algebra { Empty }

fn emit_semantic_decl_unsupported_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^emit_semantic_decl_unsupported_shape,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_decl_surface(
  surface: Node,
  rules: Node,
  profile: TargetSemanticDeclSerializeProfile,
  host_binding_spellings: Map<Symbol, String>
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(rules: rules, emitted: surface),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              bind_outcome(
                o: semantic_decl_serialize_target(profile: profile, rules: rules, host_binding_spellings: host_binding_spellings),
                f: fn(serialize_target) {
                  serialize_concrete_syntax_tokens_to_source(
                    target: serialize_target,
                    tokens: tokens
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

// A TYPE DECLARATION THROUGH THE TARGET'S SEMANTIC ROWS, with its field types spelled by the caller's
// type_binding and serialized over the host target's binding_spellings. The module fold's caller
// (v2.compiler.emit_produced emit_module_member) passes the resolver every signature type goes through.
fn emit_semantic_type_decl_resolving(
  name: Symbol,
  params: List<Symbol>,
  node: Node,
  target: TargetModel,
  type_binding: fn(Node) -> Outcome<Symbol>,
  host_binding_spellings: Map<Symbol, String>
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: semantic_decl_emission_from_target(target: target),
    f: fn(emission) {
      match node.kind {
        TypeNode { connective: Disj } =>
          bind_outcome(
            o: target_semantic_enum_surface_from_coproduct(
              projection: emission.surface,
              name: name,
              params: params,
              coproduct: node,
              type_binding: type_binding
            ),
            f: fn(surface) {
              emit_decl_surface(
                surface: surface,
                rules: emission.enum_translation_rules,
                profile: emission.enum_serialize_profile,
                host_binding_spellings: host_binding_spellings
              )
            }
          )
        TypeNode { connective: Conj } =>
          bind_outcome(
            o: target_semantic_struct_surface_from_record(
              projection: emission.surface,
              name: name,
              params: params,
              record: node,
              type_binding: type_binding
            ),
            f: fn(surface) {
              emit_decl_surface(
                surface: surface,
                rules: emission.struct_translation_rules,
                profile: emission.struct_serialize_profile,
                host_binding_spellings: host_binding_spellings
              )
            }
          )
        _ => outcome_rejected(d: emit_semantic_decl_unsupported_diagnostic(node: node))
      }
    }
  )
}

// THE ROUTE WITHOUT A RESOLVER, kept for the routing and parity fixtures that exercise the semantic rows
// alone: a field's atom is bound as itself and serialized over the profile's own rows, so a type the
// profile does not spell prints its interned name. No production path calls it; a module member goes
// through emit_semantic_type_decl_resolving.
fn emit_semantic_type_decl(
  name: Symbol,
  params: List<Symbol>,
  node: Node,
  target: TargetModel
) -> Outcome<Medium<String>> {
  emit_semantic_type_decl_resolving(
    name: name,
    params: params,
    node: node,
    target: target,
    type_binding: fn(t) { semantic_decl_type_as_itself(type_node: t) },
    host_binding_spellings: empty_map()
  )
}

fn semantic_decl_type_as_itself(type_node: Node) -> Outcome<Symbol> {
  match type_node.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(value: id)
    _ => outcome_rejected(d: emit_semantic_decl_unsupported_diagnostic(node: type_node))
  }
}
