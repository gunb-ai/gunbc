module v2.compiler.emit_semantic_decl

import v2.compiler.translate {
  grammar_relation_row_for_emitted,
  grammar_relation_row_tokens_root,
  serialize_concrete_syntax_tokens_to_source
}
import v2.extdeps.languages.rust {
  rust_enum_decl_surface_from_coproduct,
  rust_enum_decl_surface_from_coproduct_generic,
  rust_enum_general_decl_productions_only_translation_rules,
  rust_enum_general_decl_structural_target_model,
  rust_struct_decl_surface_from_record,
  rust_struct_decl_surface_from_record_generic,
  rust_struct_general_decl_productions_only_translation_rules,
  rust_struct_general_decl_structural_target_model
}
import v2.std.collection { List }
import v2.std.compilers.target_model { TargetModel, concrete_syntax_token_list_from_node }
import v2.std.diagnostic { Diagnostic, ExternalContractUnknown, Outcome, Unavailable, bind_outcome, node_locus, outcome_rejected }
import std.algebra { Cons, Empty }
import v2.std.node { Conj, Disj, Node, Symbol, TypeNode }
import extdeps.communication.medium { Medium }
import v2.std.text { String }

fn emit_semantic_decl_unsupported_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^emit_semantic_decl_unsupported_shape,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn emit_decl_surface_rust(
  surface: Node,
  rules: Node,
  target: TargetModel
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: grammar_relation_row_for_emitted(rules: rules, emitted: surface),
    f: fn(row) {
      bind_outcome(
        o: grammar_relation_row_tokens_root(row: row),
        f: fn(tokens_root) {
          bind_outcome(
            o: concrete_syntax_token_list_from_node(list_node: tokens_root),
            f: fn(tokens) {
              serialize_concrete_syntax_tokens_to_source(target: target, tokens: tokens)
            }
          )
        }
      )
    }
  )
}

fn emit_semantic_enum_decl_rust(name: Symbol, coproduct: Node) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_enum_decl_surface_from_coproduct(name: name, coproduct: coproduct),
    f: fn(surface) {
      emit_decl_surface_rust(
        surface: surface,
        rules: rust_enum_general_decl_productions_only_translation_rules(),
        target: rust_enum_general_decl_structural_target_model()
      )
    }
  )
}

fn emit_semantic_struct_decl_rust(name: Symbol, record: Node) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_struct_decl_surface_from_record(name: name, record: record),
    f: fn(surface) {
      emit_decl_surface_rust(
        surface: surface,
        rules: rust_struct_general_decl_productions_only_translation_rules(),
        target: rust_struct_general_decl_structural_target_model()
      )
    }
  )
}

fn emit_semantic_type_decl_rust(name: Symbol, node: Node) -> Outcome<Medium<String>> {
  match node.kind {
    TypeNode { connective: Disj } => emit_semantic_enum_decl_rust(name: name, coproduct: node)
    TypeNode { connective: Conj } => emit_semantic_struct_decl_rust(name: name, record: node)
    _ => outcome_rejected(d: emit_semantic_decl_unsupported_diagnostic(node: node))
  }
}

fn emit_semantic_enum_decl_rust_generic(
  name: Symbol,
  params: List<Symbol>,
  coproduct: Node
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_enum_decl_surface_from_coproduct_generic(name: name, params: params, coproduct: coproduct),
    f: fn(surface) {
      emit_decl_surface_rust(
        surface: surface,
        rules: rust_enum_general_decl_productions_only_translation_rules(),
        target: rust_enum_general_decl_structural_target_model()
      )
    }
  )
}

fn emit_semantic_struct_decl_rust_generic(
  name: Symbol,
  params: List<Symbol>,
  record: Node
) -> Outcome<Medium<String>> {
  bind_outcome(
    o: rust_struct_decl_surface_from_record_generic(name: name, params: params, record: record),
    f: fn(surface) {
      emit_decl_surface_rust(
        surface: surface,
        rules: rust_struct_general_decl_productions_only_translation_rules(),
        target: rust_struct_general_decl_structural_target_model()
      )
    }
  )
}

fn emit_semantic_type_decl_rust_generic(
  name: Symbol,
  params: List<Symbol>,
  node: Node
) -> Outcome<Medium<String>> {
  match params {
    Empty => emit_semantic_type_decl_rust(name: name, node: node)
    Cons { head: _, tail: _ } =>
      match node.kind {
        TypeNode { connective: Disj } => emit_semantic_enum_decl_rust_generic(name: name, params: params, coproduct: node)
        TypeNode { connective: Conj } => emit_semantic_struct_decl_rust_generic(name: name, params: params, record: node)
        _ => outcome_rejected(d: emit_semantic_decl_unsupported_diagnostic(node: node))
      }
  }
}
