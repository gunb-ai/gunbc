fn infer_loop_iteration_type_mismatch_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_loop_iteration_type_mismatch,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
