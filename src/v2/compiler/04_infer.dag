module v2.compiler.infer



type AlgebraRef {
  algebra: v2.std.node.Node
  witness: v2.std.node.Node
}

data node_grounding_frontier_note: String = "GroundingNotDerived is v2's typed inference frontier, not a failure arm and not an escape hatch. v2 derives a node's type for exactly four of the closed vocabulary's twelve node kinds (Branch, Match, Loop, Transform add-shape only — 6 connectives + 6 behaviors = 12); the other eight kinds, and every other Transform shape, have no derivation rule yet. Before this carrier existed the nine were routed through solve_constraints with the singleton candidate set [root] under a predicate that reduces to root == root, and the resulting grounding carried the SOURCE NODE as its structural evidence — i.e. as the node's resolved type (inferred_facts_resolved_type reads that field), so every literal, binding and operation in v2 was typed as itself and every downstream consumer read that as an established judgment. Each frontier node now carries a typed, located, counted diagnostic (infer_grounding_not_derived) on the Accepted path, so the deficit's frequency is observable and prioritizable rather than zeroed by construction (DESIGN §5). dissolve-on: a behavior-specific derivation rule lands for a kind, at which point that kind moves to DerivedGrounding and its frontier count drops; the carrier deletes when all twelve kinds derive."

fn infer_grounding_not_derived_diagnostic(at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^infer_grounding_not_derived,
    at: at,
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn inferred_facts_subject_node(facts: v2.compiler.inferred_tree.InferredFacts) -> v2.std.node.Node {
  match facts.grounding {
    DerivedGrounding { grounding: g } => g.node
    GroundingNotDerived { node: n } => n
  }
}

fn inferred_facts_cover_node(facts: v2.compiler.inferred_tree.InferredFacts, node: v2.std.node.Node) -> v2.std.logic.Bool {
  inferred_facts_subject_node(facts: facts) == node
}

fn inferred_facts_grounding_derived(facts: v2.compiler.inferred_tree.InferredFacts) -> v2.std.logic.Bool {
  match facts.grounding {
    DerivedGrounding { grounding: _ } => true
    GroundingNotDerived { node: _ } => false
  }
}

fn inferred_facts_canonical_admitted(facts: v2.compiler.inferred_tree.InferredFacts) -> v2.std.logic.Bool {
  match facts.grounding {
    DerivedGrounding { grounding: g } => canonical_grounding_admits_infer_facts(grounding: g)
    GroundingNotDerived { node: _ } => false
  }
}

fn inferred_facts_grounding_witness(facts: v2.compiler.inferred_tree.InferredFacts) -> Witness<v2.std.constraints.CanonicalGrounding> {
  match facts.grounding {
    DerivedGrounding { grounding: g } => v2.std.witness.Holds { value: g }
    GroundingNotDerived { node: n } =>
      v2.std.witness.Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: n)) }
  }
}

fn inferred_facts_resolved_type(facts: v2.compiler.inferred_tree.InferredFacts) -> Witness<v2.std.node.Node> {
  match facts.grounding {
    DerivedGrounding { grounding: g } => v2.std.witness.Holds { value: g.witness.structural.evidence }
    GroundingNotDerived { node: n } =>
      v2.std.witness.Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: n)) }
  }
}

fn inferred_facts_algebra_ref(facts: v2.compiler.inferred_tree.InferredFacts) -> Witness<AlgebraRef> {
  match facts.grounding {
    DerivedGrounding { grounding: g } =>
      v2.std.witness.Holds { value: algebra_ref_from_grounding(grounding: g) }
    GroundingNotDerived { node: n } =>
      v2.std.witness.Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: n)) }
  }
}

fn inferred_facts_canonical_witness(facts: v2.compiler.inferred_tree.InferredFacts) -> Witness<v2.std.constraints.CanonicalGroundingWitness> {
  match facts.grounding {
    DerivedGrounding { grounding: g } => v2.std.witness.Holds { value: g.witness }
    GroundingNotDerived { node: n } =>
      v2.std.witness.Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: n)) }
  }
}

fn inferred_facts_descent(facts: v2.compiler.inferred_tree.InferredFacts) -> Witness<v2.std.cardinality.TerminationProof> {
  facts.descent
}

data infer_emit_shape_frontier_note: String = "Test-only emit-shape frontier (review 47246): empty facts map for orch-emit-compatible mock proofs (`orch_emit_facts_lookup`, `ingested_emit_shape_frontier_tree_from_source` in emit-host witnesses). Not a production carrier — production emit paths pass canonical infer output facts-flow-forward; erasing or relabeling infer judgments is forbidden (review 47234, review 47246). dissolve-on: v2-inferred-tree-completeness makes incomplete InferredTree unwritable on the production emit path."

fn infer_emit_shape_frontier_inferred_tree(root: v2.std.node.Node) -> v2.compiler.inferred_tree.InferredTree {
  v2.compiler.inferred_tree.InferredTree {
    root: root,
    facts: std.types.Map {
      lookup: fn(_key) {
        v2.std.optional.Absent
      }
    }
  }
}

type InferGatherFoldAcc {
  node: v2.std.node.Node
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>
  failed: v2.std.logic.Bool
  pending: v2.std.diagnostic.Diagnostics
  await_branch_row: v2.std.logic.Bool
  await_match_row: v2.std.logic.Bool
  await_loop_row: v2.std.logic.Bool
  await_transform_row: v2.std.logic.Bool
  children_remaining: Int
}

