type AlgebraRef {
  algebra: Node
  witness: Node
}

// TWO POSITION-SCOPED DERIVATIONS SIT BESIDE THE KIND RULES. An accepted int
// literal's magnitude payload derives against the integer authority's own types
// (infer_literal_payload_entries), and a childless Conj in an Arrow's domain position derives as
// the empty product (infer_arrow_empty_domain_edge). A node's KIND does not decide whether it
// grounds, so a count of kinds covered does not measure how much of a closure grounds: gen-one's
// door probe (fixture.native_cli_door.door_probe) met this frontier only through Atom and Conj
// nodes, because body lowering handed infer a data declaration's surface tokens (fixed at
// v2.compiler.body_lowering_fold body_lower_data_decl_to_member).

fn infer_grounding_not_derived_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^infer_grounding_not_derived,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn inferred_facts_subject_node(facts: InferredFacts) -> Node {
  match facts.grounding {
    DerivedGrounding { grounding: g } => g.node
    GroundingNotDerived { node: n } => n
  }
}

fn inferred_facts_cover_node(facts: InferredFacts, node: Node) -> Bool {
  inferred_facts_subject_node(facts: facts) == node
}

fn inferred_facts_grounding_derived(facts: InferredFacts) -> Bool {
  match facts.grounding {
    DerivedGrounding { grounding: _ } => true
    GroundingNotDerived { node: _ } => false
  }
}

fn inferred_facts_canonical_admitted(facts: InferredFacts) -> Bool {
  match facts.grounding {
    DerivedGrounding { grounding: g } => canonical_grounding_admits_infer_facts(grounding: g)
    GroundingNotDerived { node: _ } => false
  }
}

fn inferred_facts_grounding_witness(facts: InferredFacts) -> Witness<CanonicalGrounding> {
  match facts.grounding {
    DerivedGrounding { grounding: g } => Holds { value: g }
    GroundingNotDerived { node: n } =>
      Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: n)) }
  }
}

fn inferred_facts_resolved_type(facts: InferredFacts) -> Witness<Node> {
  match facts.grounding {
    DerivedGrounding { grounding: g } => Holds { value: g.witness.structural.evidence }
    GroundingNotDerived { node: n } =>
      Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: n)) }
  }
}

fn inferred_facts_algebra_ref(facts: InferredFacts) -> Witness<AlgebraRef> {
  match facts.grounding {
    DerivedGrounding { grounding: g } =>
      Holds { value: algebra_ref_from_grounding(grounding: g) }
    GroundingNotDerived { node: n } =>
      Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: n)) }
  }
}

fn inferred_facts_canonical_witness(facts: InferredFacts) -> Witness<CanonicalGroundingWitness> {
  match facts.grounding {
    DerivedGrounding { grounding: g } => Holds { value: g.witness }
    GroundingNotDerived { node: n } =>
      Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: n)) }
  }
}

fn inferred_facts_descent(facts: InferredFacts) -> Witness<v2.std.cardinality.TerminationProof> {
  facts.descent
}

// Test-only emit-shape frontier (review 47246): empty facts map for orch-emit-compatible mock
// proofs (`orch_emit_facts_lookup`, `ingested_emit_shape_frontier_tree_from_arrow` in emit-host
// witnesses). Not a production carrier — production emit paths pass canonical infer output
// facts-flow-forward; erasing or relabeling infer judgments is forbidden (review 47234, review
// 47246). dissolve-on: v2-inferred-tree-completeness makes incomplete InferredTree unwritable on
// the production emit path.

fn infer_emit_shape_frontier_inferred_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: PartialFunction {
      lookup: fn(_key) {
        Absent
      }
    }
  }
}

type InferGatherFoldAcc {
  node: Node
  entries: List<InferredFactsEntry>
  failed: Bool
  pending: Diagnostics
  await_branch_row: Bool
  await_match_row: Bool
  await_loop_row: Bool
  await_transform_row: Bool
  application_instances: List<TypeVariableInstance>
  children_remaining: Int
}

