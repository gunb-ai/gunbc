fn algebra_ref_is_grounded(algebra: v2.std.node.Node) -> v2.std.logic.Bool {
  match algebra.kind {
    TypeNode { connective: c } =>
      match c {
        Atom { identity: _ } => false
        _ => true
      }
    ComputationNode { behavior: _ } => false
  }
}

fn infer_descent_not_derived_diagnostic(at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^infer_descent_not_derived,
    at: at,
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_descent_witness_for_node(n: v2.std.node.Node) -> Witness<v2.std.cardinality.TerminationProof> {
  match termination_proof_witness_for_node(n: n) {
    Holds { value: proof } => v2.std.witness.Holds { value: proof }
    Violates { diagnostic: upstream } =>
      v2.std.witness.Violates {
        diagnostic: infer_descent_not_derived_diagnostic(at: upstream.at)
      }
  }
}

fn algebra_ref_from_grounding(grounding: v2.std.constraints.CanonicalGrounding) -> AlgebraRef {
  AlgebraRef {
    algebra: grounding.witness.structural.evidence,
    witness: grounding.node
  }
}

data canonical_grounding_admission_scope_note: String = "This predicate deliberately does NOT carry an 'evidence != node' conjunct, and the reason is worth recording because that conjunct was tried and withdrawn. As a read-path backstop against hand-built self-groundings it looked free, but it is a PROXY for the property actually at issue — 'was this grounding produced by a derivation?' — and the NodeGrounding carrier already answers that exactly. Proxies are what produced the defect in the first place: algebra_ref_is_grounded is a shape test on the connective, which is precisely why Conj/Disj type-node self-groundings walked through it. The proxy also has real false positives: v2_evaluator's bool fixture uses ONE atom as both the evaluand and the runtime value's primitive_type, so resolved == algebra there is the fixture's coherent encoding of 'this atom denotes Bool', not a fabrication. Refusing it would have meant rewriting a thesis-proof fixture to make a check go green — the inversion DESIGN §5 names explicitly. The wall therefore lives where it is exact: canonical_grounding_from_derived_type refuses self-evidence for every grounding the COMPILER mints, and GroundingNotDerived is what an underived node carries. A structurally hand-written CanonicalGrounding remains writable by any module; that residue is stated, not silently covered."

fn canonical_grounding_admits_infer_facts(grounding: v2.std.constraints.CanonicalGrounding) -> v2.std.logic.Bool {
  well_formed(n: grounding.node)
    && well_formed(n: grounding.witness.structural.evidence)
    && (grounding.witness.structural.property == ^constraint_property_being_canonical)
    && (grounding.witness.closedness.property == ^constraint_property_candidate_set_closedness)
    && (grounding.witness.closedness.evidence == grounding.node)
}

fn inferred_facts_construction(
  grounding: v2.std.constraints.CanonicalGrounding,
  descent: Witness<v2.std.cardinality.TerminationProof>,
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  if canonical_grounding_admits_infer_facts(grounding: grounding) {
    v2.std.diagnostic.Accepted {
      value: v2.compiler.inferred_tree.InferredFacts {
        grounding: v2.compiler.inferred_tree.DerivedGrounding { grounding: grounding },
        descent: descent
      },
      diagnostics: v2.std.diagnostic.None
    }
  } else {
    outcome_rejected(
      infer_canonical_grounding_incoherent_diagnostic(node: grounding.node)
    )
  }
}

fn inferred_facts_from_grounding(
  grounding: v2.std.constraints.CanonicalGrounding,
  descent: Witness<v2.std.cardinality.TerminationProof>,
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  inferred_facts_construction(grounding: grounding, descent: descent)
}

fn inferred_facts_not_derived(
  node: v2.std.node.Node,
  descent: Witness<v2.std.cardinality.TerminationProof>,
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  v2.std.diagnostic.Accepted {
    value: v2.compiler.inferred_tree.InferredFacts {
      grounding: v2.compiler.inferred_tree.GroundingNotDerived { node: node },
      descent: descent
    },
    diagnostics: v2.std.diagnostic.Some {
      diagnostics: diagnostics_singleton(
        d: infer_grounding_not_derived_diagnostic(at: node_locus(node: node))
      )
    }
  }
}

fn empty_inferred_facts_entry_list() -> List<v2.compiler.inferred_tree.InferredFactsEntry> {
  []
}

fn concat_inferred_facts_entries(
  a: List<v2.compiler.inferred_tree.InferredFactsEntry>,
  b: List<v2.compiler.inferred_tree.InferredFactsEntry>,
) -> List<v2.compiler.inferred_tree.InferredFactsEntry> {
  fold(b, init: a, f: fn(acc, entry) {
    list_snoc_item(xs: acc, item: entry)
  })
}

data infer_node_facts_no_derivation_note: String = "infer_node_facts used to reach solve_constraints with the singleton candidate set [root] and the constraint-satisfaction predicate, whose preservation rule is (algebra == source_facts && candidate == source_facts) with algebra bound to the root itself — so the witness search reduced to root == root and always succeeded. The grounding it minted carried the source node as its own structural evidence, which inferred_facts_resolved_type reads as the node's resolved type. That is source identity standing where a derivation belongs. The Bool and Int arms now consume the typed canonical-literal query and raise those derivations to leaf facts; every other node on this path carries the typed GroundingNotDerived frontier. solve_constraints itself is untouched — it remains the structural-solve authority named by dag/gunbc/plans/solve_higher_order_design.dag, to be EXTENDED with real candidate generation, never forked."

fn infer_node_facts(n: v2.std.node.Node, partials: List<v2.std.node.Node>) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  match v2.std.bounded_lattice_completeness.infer_bounded_lattice_consumer_gate(consumer: n, partials: partials) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: n) {
        Violates { diagnostic: d } =>
          v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          match dag_canonical_literal_from_node(node: n) {
            Accepted { value: DagCanonicalBoolLiteral { value: _ }, diagnostics: _ } =>
              inferred_facts_from_derived_type(
                node: n,
                derived_type: bool_node(),
                descent: v2.std.witness.Holds { value: descent_proof }
              )
            Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
              inferred_facts_from_derived_type(
                node: n,
                derived_type: infer_branch_int_binding_type_node(),
                descent: v2.std.witness.Holds { value: descent_proof }
              )
            Rejected { diagnostics: _ } =>
              inferred_facts_not_derived(
                node: n,
                descent: v2.std.witness.Holds { value: descent_proof }
              )
          }
      }
  }
}

fn lookup_inferred_facts_in_entries(
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
  key: v2.std.node.Node,
) -> v2.std.optional.Optional<v2.compiler.inferred_tree.InferredFacts> {
  fold(
    entries,
    init: optional_absent(),
    f: fn(acc, entry) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if entry.node == key {
            optional_present(value: entry.facts)
          } else {
            acc
          }
      }
    }
  )
}

fn facts_map_from_entries(entries: List<v2.compiler.inferred_tree.InferredFactsEntry>) -> v2.std.diagnostic.Outcome<Map<v2.std.node.Node, v2.compiler.inferred_tree.InferredFacts>> {
  match fold(entries, init: v2.std.diagnostic.Accepted { value: empty_inferred_facts_entry_list(), diagnostics: v2.std.diagnostic.None }, f: fn(acc, entry) {
    match acc {
      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
      Accepted { value: ok_entries, diagnostics: d } =>
        if inferred_facts_cover_node(facts: entry.facts, node: entry.node) {
          v2.std.diagnostic.Accepted { value: list_snoc_item(xs: ok_entries, item: entry), diagnostics: d }
        } else {
          v2.std.diagnostic.Rejected {
            diagnostics: diagnostics_singleton(
              d: infer_canonical_grounding_incoherent_diagnostic(node: entry.node)
            )
          }
        }
    }
  }) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: admitted, diagnostics: d } =>
      v2.std.diagnostic.Accepted {
        value: std.types.Map {
          lookup: fn(key) {
            lookup_inferred_facts_in_entries(entries: admitted, key: key)
          }
        },
        diagnostics: d
      }
  }
}

fn inferred_facts_witness_for_node(tree: v2.compiler.inferred_tree.InferredTree, node: v2.std.node.Node) -> Witness<v2.compiler.inferred_tree.InferredFacts> {
  witness_from_optional(opt: tree.facts.lookup(node), absent: infer_facts_lookup_miss_diagnostic(key: node))
}

fn canonical_grounding_from_inferred_facts(
  node: v2.std.node.Node,
  facts: v2.compiler.inferred_tree.InferredFacts,
) -> v2.std.diagnostic.Outcome<v2.std.constraints.CanonicalGrounding> {
  match facts.grounding {
    GroundingNotDerived { node: n } =>
      outcome_rejected(infer_grounding_not_derived_diagnostic(at: node_locus(node: n)))
    DerivedGrounding { grounding: g } =>
      if node != g.node {
        outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
      } else if !algebra_ref_is_grounded(algebra: algebra_ref_from_grounding(grounding: g).algebra) {
        outcome_rejected(infer_algebra_ref_ungrounded_diagnostic(node: node))
      } else if canonical_grounding_admits_infer_facts(grounding: g) {
        v2.std.diagnostic.Accepted {
          value: g,
          diagnostics: v2.std.diagnostic.None
        }
      } else {
        outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
      }
  }
}

fn canonical_grounding_for_node(tree: v2.compiler.inferred_tree.InferredTree, node: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.constraints.CanonicalGrounding> {
  match inferred_facts_witness_for_node(tree: tree, node: node) {
    Holds { value: facts } =>
      canonical_grounding_from_inferred_facts(node: node, facts: facts)
    Violates { diagnostic: d } =>
      outcome_rejected(d)
  }
}

fn admitted_inferred_facts_entry(node: v2.std.node.Node, facts: v2.compiler.inferred_tree.InferredFacts) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFactsEntry> {
  if inferred_facts_cover_node(facts: facts, node: node) {
    v2.std.diagnostic.Accepted {
      value: v2.compiler.inferred_tree.InferredFactsEntry { node: node, facts: facts },
      diagnostics: v2.std.diagnostic.None
    }
  } else {
    outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
  }
}

fn infer_branch_int_binding_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_binding_type_int } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn infer_atom_binding_sym(node: v2.std.node.Node) -> v2.std.optional.Optional<v2.std.node.Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } => v2.std.optional.Present { value: sym }
    _ => v2.std.optional.Absent
  }
}

fn infer_conj_edge_named_type_for_binding(edge: v2.std.node.Edge, binding: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  match edge.label {
    Named { name: sym } =>
      if sym == binding {
        optional_present(value: edge.target)
      } else {
        optional_absent()
      }
    Positional => optional_absent()
  }
}

fn infer_conj_named_type_for_binding(domain: v2.std.node.Node, binding: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  match domain.kind {
    TypeNode { connective: Conj } =>
      fold(domain.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => infer_conj_edge_named_type_for_binding(edge: e, binding: binding)
        }
      })
    _ => v2.std.optional.Absent
  }
}

fn infer_arrow_domain_type_for_binding(arrow: v2.std.node.Node, binding: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  match arrow.kind {
    TypeNode { connective: Arrow } =>
      match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
        Present { value: domain } =>
          infer_conj_named_type_for_binding(domain: domain, binding: binding)
        Absent => v2.std.optional.Absent
      }
    _ => v2.std.optional.Absent
  }
}

data infer_arrow_domain_binding_heuristic_note: String = "interim: infer_find_arrow_domain_type_in_tree DFS-walks the resolved tree for the first Arrow whose Conj domain names the atom-binding symbol — symbol-name collision across unrelated arrows picks first-visit order, not lexical scope. dissolve-on: namespace-only name resolution consumes containment-tree binding→domain (DESIGN open thread §namespace-only); delete this heuristic walker when SymbolIndex lookup lands."

fn infer_find_arrow_domain_type_in_tree(root: v2.std.node.Node, binding: v2.std.node.Symbol) -> v2.std.optional.Optional<v2.std.node.Node> {
  match infer_arrow_domain_type_for_binding(arrow: root, binding: binding) {
    Present { value: ty } => v2.std.optional.Present { value: ty }
    Absent =>
      fold(root.children, init: v2.std.optional.Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => infer_find_arrow_domain_type_in_tree(root: e.target, binding: binding)
        }
      })
  }
}

data infer_branch_operand_type_frontier_note: String = "The literal and arrow-domain arms below derive a real type for the operand; the remaining arm falls through to the operand's own inferred facts. When those facts are the GroundingNotDerived frontier there is no operand type, and this now refuses (Violates) instead of returning the operand NODE as its own type. That fallback was the path by which the self-grounding fabrication entered branch/match/loop unification: two arms whose 'types' were their own expression nodes compared unequal and were reported as an arm-type mismatch, while two structurally identical arms compared equal and were reported as unified — in both cases the verdict was about node identity, not about types."

fn infer_branch_operand_resolved_type_in_tree(
  node: v2.std.node.Node,
  facts: v2.compiler.inferred_tree.InferredFacts,
  tree: v2.std.node.Node,
) -> Witness<v2.std.node.Node> {
  match dag_canonical_literal_from_node(node: node) {
    Accepted { value: DagCanonicalBoolLiteral { value: _ }, diagnostics: _ } =>
      v2.std.witness.Holds { value: bool_node() }
    Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
      v2.std.witness.Holds { value: infer_branch_int_binding_type_node() }
    Rejected { diagnostics: _ } =>
      match infer_atom_binding_sym(node: node) {
        Present { value: binding } =>
          match infer_find_arrow_domain_type_in_tree(root: tree, binding: binding) {
            Present { value: domain_ty } => v2.std.witness.Holds { value: domain_ty }
            Absent => inferred_facts_resolved_type(facts: facts)
          }
        Absent => inferred_facts_resolved_type(facts: facts)
      }
  }
}

fn infer_branch_operand_resolved_type(node: v2.std.node.Node, facts: v2.compiler.inferred_tree.InferredFacts) -> Witness<v2.std.node.Node> {
  infer_branch_operand_resolved_type_in_tree(node: node, facts: facts, tree: node)
}

fn inferred_facts_from_derived_type(
  node: v2.std.node.Node,
  derived_type: v2.std.node.Node,
  descent: Witness<v2.std.cardinality.TerminationProof>,
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  bind_outcome(
    o: canonical_grounding_from_derived_type(node: node, derived_type: derived_type),
    f: fn(grounding) {
      inferred_facts_from_grounding(grounding: grounding, descent: descent)
    }
  )
}

fn infer_branch_type_atoms_equal(a: v2.std.node.Node, b: v2.std.node.Node) -> v2.std.logic.Bool {
  match a.kind {
    TypeNode { connective: Atom { identity: id_a } } =>
      match b.kind {
        TypeNode { connective: Atom { identity: id_b } } => id_a == id_b
        _ => false
      }
    _ => a == b
  }
}

fn infer_branch_type_is_bool(type_node: v2.std.node.Node) -> v2.std.logic.Bool {
  match type_node.kind {
    TypeNode { connective: Atom { identity: id } } => id == ^bool_node_symbol
    _ => false
  }
}

fn infer_branch_cond_type_is_bool(cond_target: v2.std.node.Node, cond_facts: v2.compiler.inferred_tree.InferredFacts) -> v2.std.logic.Bool {
  match infer_branch_operand_resolved_type(node: cond_target, facts: cond_facts) {
    Holds { value: cond_type } => infer_branch_type_is_bool(type_node: cond_type)
    Violates { diagnostic: _ } => false
  }
}

fn infer_branch_type_is_int(type_node: v2.std.node.Node) -> v2.std.logic.Bool {
  match type_node.kind {
    TypeNode { connective: Atom { identity: id } } => id == ^dag_binding_type_int
    _ => false
  }
}

data infer_match_int_scrutinee_bool_literal_body_note: String = "Int-scrutinee bool-literal match arms ground body type as Int at arm-row construction (same octet 0/1 authority as eval allocate_literal), not a post-unification rewrite. dissolve-on: bool keywords carry Int type in Int-valued match bodies at normalize/ingest. scaffold-widen: Int scrutinee on bool-literal match emits infer_match_int_scrutinee_bool_literal_scaffold diagnostic (countable on Accepted path). paired-scaffold: emit half = target_value_expr_int_bool_octet_channel_dissolution_note (target_model.dag) — dissolve both halves together on octet↔bool codec inhabitation."

fn infer_match_bool_consumer_diagnostics_with_int_scrutinee_scaffold(
  consumer: v2.std.node.Node,
  cd: v2.std.diagnostic.Diagnostics,
  scrutinee_type: v2.std.node.Node
) -> v2.std.diagnostic.Diagnostics {
  if infer_branch_type_is_int(type_node: scrutinee_type) {
    diagnostics_merge(
      outer: cd,
      inner: v2.std.diagnostic.Some {
        diagnostics: diagnostics_singleton(
          d: infer_match_int_scrutinee_bool_literal_scaffold_diagnostic(node: consumer)
        )
      }
    )
  } else {
    cd
  }
}

fn infer_match_bool_arm_body_type(
  body_target: v2.std.node.Node,
  body_facts: v2.compiler.inferred_tree.InferredFacts,
  scrutinee_type: v2.std.node.Node
) -> Witness<v2.std.node.Node> {
  match dag_canonical_literal_from_node(node: body_target) {
    Accepted { value: DagCanonicalBoolLiteral { value: _ }, diagnostics: _ } =>
      if infer_branch_type_is_int(type_node: scrutinee_type) {
        v2.std.witness.Holds { value: infer_branch_int_binding_type_node() }
      } else {
        infer_branch_operand_resolved_type(node: body_target, facts: body_facts)
      }
    Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
      infer_branch_operand_resolved_type(node: body_target, facts: body_facts)
    Rejected { diagnostics: _ } =>
      infer_branch_operand_resolved_type(node: body_target, facts: body_facts)
  }
}

fn infer_match_bool_arm_rows_accept(
  node: v2.std.node.Node,
  partials: List<v2.std.node.Node>,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
  first_arm_target: v2.std.node.Node,
  second_arm_target: v2.std.node.Node,
  cd: v2.std.diagnostic.Diagnostics,
  scrutinee_type: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  match infer_match_bool_arm_row(
    arm: first_arm_target,
    entries: entries,
    scrutinee_type: scrutinee_type
  ) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: first_row, diagnostics: fd } =>
      match infer_match_bool_arm_row(
        arm: second_arm_target,
        entries: entries,
        scrutinee_type: scrutinee_type
      ) {
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        Accepted { value: second_row, diagnostics: sd } =>
          let first_body = first_row.body_type
          let second_body = second_row.body_type
          match infer_bool_literal_exhaustiveness_merge(
            left: first_row.coverage,
            right: second_row.coverage
          ) {
            InferBoolLiteralExhaustive =>
              if !infer_branch_type_atoms_equal(a: first_body, b: second_body) {
                outcome_rejected(infer_match_arm_type_mismatch_diagnostic(node: node))
              } else {
                match infer_descent_witness_for_node(n: node) {
                  Violates { diagnostic: d } =>
                    v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
                  Holds { value: descent_proof } =>
                    bind_outcome(
                      o: inferred_facts_from_derived_type(
                        node: node,
                        derived_type: first_body,
                        descent: v2.std.witness.Holds { value: descent_proof }
                      ),
                      f: fn(facts) {
                        v2.std.diagnostic.Accepted {
                          value: facts,
                          diagnostics: diagnostics_merge(
                            outer: diagnostics_merge(outer: cd, inner: fd),
                            inner: sd
                          )
                        }
                      }
                    )
                }
              }
            InferBoolLiteralMissingTrue =>
              outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
            InferBoolLiteralMissingFalse =>
              outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
            InferBoolLiteralMissingBoth =>
              outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
          }
      }
  }
}

fn infer_unify_branch_arm_types(
  then_node: v2.std.node.Node,
  then_facts: v2.compiler.inferred_tree.InferredFacts,
  else_node: v2.std.node.Node,
  else_facts: v2.compiler.inferred_tree.InferredFacts,
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match infer_branch_operand_resolved_type(node: then_node, facts: then_facts) {
    Violates { diagnostic: d } => outcome_rejected(d)
    Holds { value: then_type } =>
      match infer_branch_operand_resolved_type(node: else_node, facts: else_facts) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: else_type } =>
          if infer_branch_type_atoms_equal(a: then_type, b: else_type) {
            v2.std.diagnostic.Accepted { value: then_type, diagnostics: v2.std.diagnostic.None }
          } else {
            outcome_rejected(infer_branch_arm_type_mismatch_diagnostic(node: then_node))
          }
      }
  }
}

fn infer_branch_bool_if_else(
  node: v2.std.node.Node,
  partials: List<v2.std.node.Node>,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
      Present { value: cond_target } =>
        match list_at_optional(xs: positional_targets, index: 1) {
          Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
          Present { value: then_target } =>
            match list_at_optional(xs: positional_targets, index: 2) {
              Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
              Present { value: else_target } =>
                match lookup_inferred_facts_in_entries(entries: entries, key: cond_target) {
                  Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: cond_target))
                  Present { value: cond_facts } =>
                    match lookup_inferred_facts_in_entries(entries: entries, key: then_target) {
                      Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: then_target))
                      Present { value: then_facts } =>
                        match lookup_inferred_facts_in_entries(entries: entries, key: else_target) {
                          Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: else_target))
                          Present { value: else_facts } =>
                            match v2.std.bounded_lattice_completeness.infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
                              Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                              Accepted { value: _, diagnostics: cd } =>
                                if !infer_branch_cond_type_is_bool(
                                  cond_target: cond_target,
                                  cond_facts: cond_facts
                                ) {
                                  outcome_rejected(infer_branch_cond_not_bool_diagnostic(node: node))
                                } else {
                                  match infer_unify_branch_arm_types(
                                    then_node: then_target,
                                    then_facts: then_facts,
                                    else_node: else_target,
                                    else_facts: else_facts
                                  ) {
                                    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                                    Accepted { value: unified_type, diagnostics: ud } =>
                                      match infer_descent_witness_for_node(n: node) {
                                        Violates { diagnostic: d } =>
                                          v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
                                        Holds { value: descent_proof } =>
                                          bind_outcome(
                                            o: inferred_facts_from_derived_type(
                                              node: node,
                                              derived_type: unified_type,
                                              descent: v2.std.witness.Holds { value: descent_proof }
                                            ),
                                            f: fn(facts) {
                                              v2.std.diagnostic.Accepted {
                                                value: facts,
                                                diagnostics: diagnostics_merge(outer: cd, inner: ud)
                                              }
                                            }
                                          )
                                      }
                                  }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
  }
}

type InferBoolLiteralPattern
  = InferBoolLiteralPatternTrue
  | InferBoolLiteralPatternFalse
  | InferBoolLiteralPatternOther

type InferBoolLiteralArmCoverage
  = InferBoolLiteralArmCoversTrue
  | InferBoolLiteralArmCoversFalse
  | InferBoolLiteralArmCoversNeither

type InferBoolLiteralExhaustiveness
  = InferBoolLiteralExhaustive
  | InferBoolLiteralMissingTrue
  | InferBoolLiteralMissingFalse
  | InferBoolLiteralMissingBoth

type InferMatchArmRow {
  coverage: InferBoolLiteralArmCoverage
  body_type: v2.std.node.Node
}

fn infer_bool_literal_pattern_classify(pattern: v2.std.node.Node) -> InferBoolLiteralPattern {
  match dag_canonical_literal_from_node(node: pattern) {
    Accepted { value: DagCanonicalBoolLiteral { value: true }, diagnostics: _ } =>
      InferBoolLiteralPatternTrue
    Accepted { value: DagCanonicalBoolLiteral { value: false }, diagnostics: _ } =>
      InferBoolLiteralPatternFalse
    Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
      InferBoolLiteralPatternOther
    Rejected { diagnostics: _ } => InferBoolLiteralPatternOther
  }
}

fn infer_bool_literal_arm_coverage_from_pattern(pattern: v2.std.node.Node) -> InferBoolLiteralArmCoverage {
  match infer_bool_literal_pattern_classify(pattern: pattern) {
    InferBoolLiteralPatternTrue => InferBoolLiteralArmCoversTrue
    InferBoolLiteralPatternFalse => InferBoolLiteralArmCoversFalse
    InferBoolLiteralPatternOther => InferBoolLiteralArmCoversNeither
  }
}

fn infer_bool_literal_exhaustiveness_merge(
  left: InferBoolLiteralArmCoverage,
  right: InferBoolLiteralArmCoverage
) -> InferBoolLiteralExhaustiveness {
  match left {
    InferBoolLiteralArmCoversTrue =>
      match right {
        InferBoolLiteralArmCoversTrue => InferBoolLiteralMissingFalse
        InferBoolLiteralArmCoversFalse => InferBoolLiteralExhaustive
        InferBoolLiteralArmCoversNeither => InferBoolLiteralMissingFalse
      }
    InferBoolLiteralArmCoversFalse =>
      match right {
        InferBoolLiteralArmCoversTrue => InferBoolLiteralExhaustive
        InferBoolLiteralArmCoversFalse => InferBoolLiteralMissingTrue
        InferBoolLiteralArmCoversNeither => InferBoolLiteralMissingTrue
      }
    InferBoolLiteralArmCoversNeither =>
      match right {
        InferBoolLiteralArmCoversTrue => InferBoolLiteralMissingFalse
        InferBoolLiteralArmCoversFalse => InferBoolLiteralMissingTrue
        InferBoolLiteralArmCoversNeither => InferBoolLiteralMissingBoth
      }
  }
}

fn infer_match_bool_arm_row(
  arm: v2.std.node.Node,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
  scrutinee_type: v2.std.node.Node
) -> v2.std.diagnostic.Outcome<InferMatchArmRow> {
  match arm.kind {
    TypeNode { connective: Conj } =>
      match find_named_child(root: arm, name: match_arm_pattern) {
        Rejected { diagnostics: _ } =>
          outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
        Accepted { value: pat, diagnostics: pd } =>
          match find_named_child(root: arm, name: match_arm_body) {
            Rejected { diagnostics: _ } =>
              outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
            Accepted { value: body_target, diagnostics: bd } =>
              match infer_bool_literal_pattern_classify(pattern: pat) {
                InferBoolLiteralPatternOther =>
                  outcome_rejected(infer_match_pattern_not_bool_literal_diagnostic(node: arm))
                _ =>
                  let coverage = infer_bool_literal_arm_coverage_from_pattern(pattern: pat)
                  match lookup_inferred_facts_in_entries(entries: entries, key: body_target) {
                    Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: body_target))
                    Present { value: body_facts } =>
                      match infer_match_bool_arm_body_type(
                        body_target: body_target,
                        body_facts: body_facts,
                        scrutinee_type: scrutinee_type
                      ) {
                        Violates { diagnostic: d } => outcome_rejected(d)
                        Holds { value: body_type } =>
                          v2.std.diagnostic.Accepted {
                            value: InferMatchArmRow {
                              coverage: coverage,
                              body_type: body_type
                            },
                            diagnostics: diagnostics_merge(outer: pd, inner: bd)
                          }
                      }
                  }
              }
          }
      }
    _ => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
  }
}

fn infer_match_bool(
  node: v2.std.node.Node,
  partials: List<v2.std.node.Node>,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
  tree: v2.std.node.Node,
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    outcome_rejected(infer_match_shape_invalid_diagnostic(node: node))
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => outcome_rejected(infer_match_shape_invalid_diagnostic(node: node))
      Present { value: scrutinee_target } =>
        match list_at_optional(xs: positional_targets, index: 1) {
          Absent => outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
          Present { value: first_arm_target } =>
            match list_at_optional(xs: positional_targets, index: 2) {
              Absent => outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
              Present { value: second_arm_target } =>
                match lookup_inferred_facts_in_entries(entries: entries, key: scrutinee_target) {
                  Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: scrutinee_target))
                  Present { value: scrutinee_facts } =>
                    match v2.std.bounded_lattice_completeness.infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
                      Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                      Accepted { value: _, diagnostics: cd } =>
                        match infer_branch_operand_resolved_type_in_tree(
                          node: scrutinee_target,
                          facts: scrutinee_facts,
                          tree: tree
                        ) {
                          Violates { diagnostic: d } => outcome_rejected(d)
                          Holds { value: scrutinee_type } =>
                            if infer_branch_type_is_bool(type_node: scrutinee_type)
                                || infer_branch_type_is_int(type_node: scrutinee_type) {
                              infer_match_bool_arm_rows_accept(
                                node: node,
                                partials: partials,
                                entries: entries,
                                first_arm_target: first_arm_target,
                                second_arm_target: second_arm_target,
                                cd: infer_match_bool_consumer_diagnostics_with_int_scrutinee_scaffold(
                                  consumer: node,
                                  cd: cd,
                                  scrutinee_type: scrutinee_type
                                ),
                                scrutinee_type: scrutinee_type
                              )
                            } else {
                              outcome_rejected(infer_match_scrutinee_not_bool_diagnostic(node: node))
                            }
                        }
                    }
                }
            }
        }
    }
  }
}

data infer_loop_iteration_flag_c_note: String = "FLAG C (body-lowering design, operator-signed): the first cut types carrier-invariant loops only — every iteration-fold child must resolve to ONE carrier type τ, so the inferred tree states 'body : τ → τ, repeated under the measure'. A refinement-shaped loop (carrier narrows across iterations, e.g. Refined<τ> vs τ) lands in the located infer_loop_iteration_type_mismatch refusal by construction — refused, never silently fabricated as τ → τ. Dissolution trigger: the refinement-typed follow-on (monotone-narrowing carrier) replaces that refusal with a real refinement judgment."

fn infer_loop_iteration_fold_child_targets(node: v2.std.node.Node) -> List<v2.std.node.Node> {
  fold(node.children, init: [], f: fn(acc, e) {
    if loop_edge_contributes_to_iteration_fold(parent: node, e: e) {
      list_snoc_item(xs: acc, item: e.target)
    } else {
      acc
    }
  })
}

fn infer_loop_body_type_at(target: v2.std.node.Node, entries: List<v2.compiler.inferred_tree.InferredFactsEntry>) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match lookup_inferred_facts_in_entries(entries: entries, key: target) {
    Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: target))
    Present { value: facts } =>
      match infer_branch_operand_resolved_type(node: target, facts: facts) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: body_type } =>
          v2.std.diagnostic.Accepted {
            value: body_type,
            diagnostics: v2.std.diagnostic.None
          }
      }
  }
}

fn infer_loop_fixpoint_carrier(
  node: v2.std.node.Node,
  body_targets: List<v2.std.node.Node>,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match list_at_optional(xs: body_targets, index: 0) {
    Absent => outcome_rejected(infer_loop_shape_invalid_diagnostic(node: node))
    Present { value: first_body } =>
      bind_outcome(
        o: infer_loop_body_type_at(target: first_body, entries: entries),
        f: fn(carrier) {
          fold(body_targets, init: v2.std.diagnostic.Accepted { value: carrier, diagnostics: v2.std.diagnostic.None }, f: fn(acc, target) {
            match acc {
              Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
              Accepted { value: c, diagnostics: _ } =>
                match infer_loop_body_type_at(target: target, entries: entries) {
                  Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                  Accepted { value: t, diagnostics: _ } =>
                    if infer_branch_type_atoms_equal(a: c, b: t) {
                      acc
                    } else {
                      outcome_rejected(infer_loop_iteration_type_mismatch_diagnostic(node: target))
                    }
                }
            }
          })
        }
      )
  }
}

fn infer_loop_iteration(
  node: v2.std.node.Node,
  partials: List<v2.std.node.Node>,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  match v2.std.bounded_lattice_completeness.infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_loop_fixpoint_carrier(
        node: node,
        body_targets: infer_loop_iteration_fold_child_targets(node: node),
        entries: entries
      ) {
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        Accepted { value: carrier, diagnostics: ud } =>
          match infer_descent_witness_for_node(n: node) {
            Violates { diagnostic: d } =>
              v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
            Holds { value: descent_proof } =>
              bind_outcome(
                o: inferred_facts_from_derived_type(
                  node: node,
                  derived_type: carrier,
                  descent: v2.std.witness.Holds { value: descent_proof }
                ),
                f: fn(facts) {
                  v2.std.diagnostic.Accepted {
                    value: facts,
                    diagnostics: diagnostics_merge(outer: cd, inner: ud)
                  }
                }
              )
          }
      }
  }
}

data infer_transform_binary_infix_note: String = "First behavior-specific Transform derivation (v2-inferred-tree-completeness): binary infix Int add derives the unified Int type as the expression result — the add_probe body vertical. Operator recognition accepts dag_token_plus pre-resolve and the canonical add operation wire post-resolve (03_resolve.resolve_transform_operator_child). infer_gather_fold_init gates await_transform_row on infer_transform_is_binary_infix_int_add_shape so every other Transform stays GroundingNotDerived — refusal is reserved for add-shaped input that is malformed. Discriminating add vertical witness enrolled on FalsifierSubstrateLongLane via gunbc.explicit_witness_admission (SubstrateLongLaneEvalBudget); fast per-PR subtract dispatch control in body_lowering/infer_transform_binary_infix_witness_test.dag. dissolve-on: general operator/operand typing table subsumes this rule."

fn infer_transform_operator_is_int_add(op_node: v2.std.node.Node) -> v2.std.logic.Bool {
  match op_node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      id == ^dag_token_plus
        || canonical_operation_wire_matches_operation(
          wire: op_node,
          operation: canonical_operation_op_add()
        )
    _ =>
      canonical_operation_wire_matches_operation(
        wire: op_node,
        operation: canonical_operation_op_add()
      )
  }
}

fn infer_transform_is_binary_infix_int_add_shape(node: v2.std.node.Node) -> v2.std.logic.Bool {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    false
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => false
      Present { value: op_target } => infer_transform_operator_is_int_add(op_node: op_target)
    }
  }
}

fn infer_unify_transform_operand_types(
  left_node: v2.std.node.Node,
  left_facts: v2.compiler.inferred_tree.InferredFacts,
  right_node: v2.std.node.Node,
  right_facts: v2.compiler.inferred_tree.InferredFacts,
  tree: v2.std.node.Node,
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match infer_branch_operand_resolved_type_in_tree(node: left_node, facts: left_facts, tree: tree) {
    Violates { diagnostic: d } => outcome_rejected(d)
    Holds { value: left_type } =>
      match infer_branch_operand_resolved_type_in_tree(
        node: right_node,
        facts: right_facts,
        tree: tree
      ) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: right_type } =>
          if infer_branch_type_atoms_equal(a: left_type, b: right_type) {
            v2.std.diagnostic.Accepted { value: left_type, diagnostics: v2.std.diagnostic.None }
          } else {
            outcome_rejected(infer_transform_operand_type_mismatch_diagnostic(node: left_node))
          }
      }
  }
}

fn infer_transform_binary_infix(
  node: v2.std.node.Node,
  partials: List<v2.std.node.Node>,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
  tree: v2.std.node.Node,
) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
      Present { value: op_target } =>
        match list_at_optional(xs: positional_targets, index: 1) {
          Absent => outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
          Present { value: left_target } =>
            match list_at_optional(xs: positional_targets, index: 2) {
              Absent => outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
              Present { value: right_target } =>
                if !infer_transform_operator_is_int_add(op_node: op_target) {
                  outcome_rejected(infer_transform_operator_unsupported_diagnostic(node: node))
                } else {
                  match lookup_inferred_facts_in_entries(entries: entries, key: left_target) {
                    Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: left_target))
                    Present { value: left_facts } =>
                      match lookup_inferred_facts_in_entries(entries: entries, key: right_target) {
                        Absent =>
                          outcome_rejected(infer_facts_lookup_miss_diagnostic(key: right_target))
                        Present { value: right_facts } =>
                          match v2.std.bounded_lattice_completeness.infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
                            Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                            Accepted { value: _, diagnostics: cd } =>
                              match infer_unify_transform_operand_types(
                                left_node: left_target,
                                left_facts: left_facts,
                                right_node: right_target,
                                right_facts: right_facts,
                                tree: tree
                              ) {
                                Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
                                Accepted { value: unified_type, diagnostics: ud } =>
                                  if !infer_branch_type_is_int(type_node: unified_type) {
                                    outcome_rejected(
                                      infer_transform_operand_type_mismatch_diagnostic(node: node)
                                    )
                                  } else {
                                    match infer_descent_witness_for_node(n: node) {
                                      Violates { diagnostic: d } =>
                                        v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
                                      Holds { value: descent_proof } =>
                                        bind_outcome(
                                          o: inferred_facts_from_derived_type(
                                            node: node,
                                            derived_type: unified_type,
                                            descent: v2.std.witness.Holds { value: descent_proof }
                                          ),
                                          f: fn(facts) {
                                            v2.std.diagnostic.Accepted {
                                              value: facts,
                                              diagnostics: diagnostics_merge(outer: cd, inner: ud)
                                            }
                                          }
                                        )
                                    }
                                  }
                              }
                          }
                      }
                  }
                }
            }
        }
    }
  }
}

fn infer_gather_fold_acc_failed(
  node: v2.std.node.Node,
  pending: v2.std.diagnostic.NonEmptyDiagnostics,
  await_branch_row: v2.std.logic.Bool,
  await_match_row: v2.std.logic.Bool,
  await_loop_row: v2.std.logic.Bool,
  await_transform_row: v2.std.logic.Bool,
  children_remaining: Int,
) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: node,
    entries: empty_inferred_facts_entry_list(),
    failed: true,
    pending: v2.std.diagnostic.Some { diagnostics: pending },
    await_branch_row: await_branch_row,
    await_match_row: await_match_row,
    await_loop_row: await_loop_row,
    await_transform_row: await_transform_row,
    children_remaining: children_remaining
  }
}

fn infer_gather_fold_acc_ok(
  node: v2.std.node.Node,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
  pending: v2.std.diagnostic.Diagnostics,
  await_branch_row: v2.std.logic.Bool,
  await_match_row: v2.std.logic.Bool,
  await_loop_row: v2.std.logic.Bool,
  await_transform_row: v2.std.logic.Bool,
  children_remaining: Int,
) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: node,
    entries: entries,
    failed: false,
    pending: pending,
    await_branch_row: await_branch_row,
    await_match_row: await_match_row,
    await_loop_row: await_loop_row,
    await_transform_row: await_transform_row,
    children_remaining: children_remaining
  }
}

fn infer_gather_acc_to_outcome(acc: InferGatherFoldAcc) -> v2.std.diagnostic.Outcome<List<v2.compiler.inferred_tree.InferredFactsEntry>> {
  if acc.failed {
    match acc.pending {
      None =>
        v2.std.diagnostic.Rejected {
          diagnostics: diagnostics_singleton(
            d: infer_canonical_grounding_incoherent_diagnostic(node: infer_gather_fold_failure_node())
          )
        }
      Some { diagnostics: nds } => v2.std.diagnostic.Rejected { diagnostics: nds }
    }
  } else {
    v2.std.diagnostic.Accepted {
      value: acc.entries,
      diagnostics: acc.pending
    }
  }
}

fn infer_gather_fold_failure_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^infer_gather_fold_failure } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn infer_gather_branch_row_on_entries(
  node: v2.std.node.Node,
  entries: List<v2.compiler.inferred_tree.InferredFactsEntry>,
  pending: v2.std.diagnostic.Diagnostics,
  partials: List<v2.std.node.Node>,
) -> InferGatherFoldAcc {
  match infer_branch_bool_if_else(node: node, partials: partials, entries: entries) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: node,
            entries: list_snoc_item(xs: entries, item: entry),
            pending: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: d),
              inner: ed
            ),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
      }
  }
}

