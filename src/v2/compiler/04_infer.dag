// A BARE ATOM IS UNGROUNDED UNLESS A DECLARED AUTHORITY MINTED IT. Since gunbc#12290 a declared-
// inhabitant roster member's derived type is its KIND (std.kind kind_node), an Atom whose authority is
// std.kind; refusing every Atom here refused every roster member's grounding before coercion (bisected:
// ingest_identity_coercion_accepts_source_present_in_authored_roster red from #12290). The atom is
// recognised through std.kind's own reader of its mint, not by matching its spelling, so a kind is the
// only atom this admits and any other bare atom still refuses.
fn algebra_ref_is_grounded(algebra: Node) -> Bool {
  match algebra.kind {
    TypeNode { connective: c } =>
      match c {
        Atom { identity: _ } =>
          match kind_denoted_by_node(n: algebra) {
            Present { value: _ } => true
            Absent => false
          }
        Conj => true
        Disj => true
        Arrow => true
        Cardinality => true
        Instantiation => true
      }
    ComputationNode { behavior: _ } => false
  }
}

fn infer_descent_not_derived_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^infer_descent_not_derived,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_descent_witness_for_node(n: Node) -> Witness<v2.std.cardinality.TerminationProof> {
  match termination_proof_witness_for_node(n: n) {
    Holds { value: proof } => Holds { value: proof }
    Violates { diagnostic: upstream } =>
      Violates {
        diagnostic: infer_descent_not_derived_diagnostic(at: upstream.at)
      }
  }
}

fn algebra_ref_from_grounding(grounding: CanonicalGrounding) -> AlgebraRef {
  AlgebraRef {
    algebra: grounding.witness.structural.evidence,
    witness: grounding.node
  }
}

// This predicate deliberately does NOT carry an 'evidence != node' conjunct; that conjunct was
// tried and withdrawn. As a read-path backstop against hand-built self-groundings it looked free,
// but it is a PROXY for the property at issue — 'was this grounding produced by a derivation?' —
// which the NodeGrounding carrier already answers exactly. Proxies produced the defect in the
// first place: algebra_ref_is_grounded is a shape test on the connective, which is why Conj/Disj
// type-node self-groundings walked through it. The proxy also has real false positives:
// v2_evaluator's bool fixture uses ONE atom as both the evaluand and the runtime value's
// primitive_type, so resolved == algebra there is the fixture's coherent encoding of 'this atom
// denotes Bool', not a fabrication. Refusing it would mean rewriting a thesis-proof fixture to
// make a check go green — the inversion DESIGN §5 names. The wall therefore lives where it is
// exact: canonical_grounding_from_derived_type refuses self-evidence for every grounding the
// COMPILER mints, and GroundingNotDerived is what an underived node carries. A structurally
// hand-written CanonicalGrounding remains writable by any module; that residue is stated, not
// silently covered.

fn canonical_grounding_admits_infer_facts(grounding: CanonicalGrounding) -> Bool {
  well_formed(n: grounding.node)
    && well_formed(n: grounding.witness.structural.evidence)
    && (grounding.witness.structural.property == ^constraint_property_being_canonical)
    && (grounding.witness.closedness.property == ^constraint_property_candidate_set_closedness)
    && (grounding.witness.closedness.evidence == grounding.node)
}

fn inferred_facts_construction(
  grounding: CanonicalGrounding,
  descent: Witness<v2.std.cardinality.TerminationProof>,
) -> Outcome<InferredFacts> {
  if canonical_grounding_admits_infer_facts(grounding: grounding) {
    Accepted {
      value: InferredFacts {
        grounding: DerivedGrounding { grounding: grounding },
        descent: descent,
        denotation: optional_absent()
      },
      diagnostics: None
    }
  } else {
    outcome_rejected(
      infer_canonical_grounding_incoherent_diagnostic(node: grounding.node)
    )
  }
}

fn inferred_facts_from_grounding(
  grounding: CanonicalGrounding,
  descent: Witness<v2.std.cardinality.TerminationProof>,
) -> Outcome<InferredFacts> {
  inferred_facts_construction(grounding: grounding, descent: descent)
}

fn inferred_facts_not_derived(
  node: Node,
  descent: Witness<v2.std.cardinality.TerminationProof>,
) -> Outcome<InferredFacts> {
  Accepted {
    value: InferredFacts {
      grounding: GroundingNotDerived { node: node },
      descent: descent,
      denotation: optional_absent()
    },
    diagnostics: Some {
      diagnostics: diagnostics_singleton(
        d: infer_grounding_not_derived_diagnostic(at: node_locus(node: node))
      )
    }
  }
}

fn empty_inferred_facts_entry_list() -> List<InferredFactsEntry> {
  []
}

fn concat_inferred_facts_entries(
  a: List<InferredFactsEntry>,
  b: List<InferredFactsEntry>,
) -> List<InferredFactsEntry> {
  fold(b, init: a, f: fn(acc, entry) {
    list_snoc_item(xs: acc, item: entry)
  })
}

// infer_node_facts used to reach solve_constraints with the singleton candidate set [root] and the
// constraint-satisfaction predicate, whose preservation rule is (algebra == source_facts &&
// candidate == source_facts) with algebra bound to the root itself — so the witness search reduced
// to root == root and always succeeded. The grounding it minted carried the source node as its own
// structural evidence, which inferred_facts_resolved_type reads as the node's resolved type:
// source identity standing where a derivation belongs. The Bool and Int arms now consume the
// typed canonical-literal query and raise those derivations to leaf facts; every other node on
// this path carries the typed GroundingNotDerived frontier. solve_constraints is untouched — it
// remains the structural-solve authority named by dag/gunbc/plans/solve_higher_order_design.dag,
// to be EXTENDED with real candidate generation, never forked.

// THE DECLARED-INHABITANT MEMBERSHIP DERIVATION, GENERAL OVER THE CLOSED INGEST SET. A language
// authority's declared-inhabitants roster (v2.extdeps.languages.dag dag_declared_inhabitants_root,
// and the python/typescript analogues) already fixes what its members denote — the add fn Arrow,
// the int/number inhabitant Conj, and the inhabitant, surface-spelling, representation and
// std-projection Atoms are all declared there — so a node that IS a roster member derives its
// grounding by LOOKUP, never by invention. Its derived type is its KIND (std.kind): the roster's
// structure says whether a member denotes a type or states a fact about one, and the kind node is
// the type; the roster root is where the member was found, not what it is, and never reaches
// derived_type (DESIGN section 3). This is the derivation the self-host candidate-generation add-slice
// stall's original trigger named, at specimen scope: the slice's Arrow, Conj and Atom nodes derive,
// while the KINDS stay frontier — a non-member Arrow, Conj or Atom carries GroundingNotDerived
// exactly as before, so the enrolled refusal witnesses pinning other shapes (the bodied arrow, the
// empty Conj, the rust grammar atom) are untouched. The membership check is DEEP
// (node_subtree_nodes): a language's inhabitant node embeds its facts subtree, so the leaf fact
// atoms of a declared inhabitant are roster members exactly as the inhabitant node itself is.
// Growth is execution-driven: the lookup widened from the dag roster to the closed ingest set
// (dag, python, typescript) when the python/typescript same-language round-trip witnesses named
// that moment — their frontier is the grammar parse-product population, whose leaves are the
// declared inhabitants' fact atoms. The set is the compiler's own closed ingest set, not a generic
// hub enumerating upstream products: infer already fixes which languages it ingests, and each
// roster stays in its own authority module (DESIGN section 3's external-upstream decomposition).
// The end-state is the resolver handing infer declaration-resolved identities directly — the
// namespace migration's completed state — at which point this lookup deletes in favor of consuming
// resolution output.

// THE CLOSED INGEST SET'S ROSTER-KIND INDEXES, DERIVED ONCE PER INFER RUN (infer_entries_for_tree)
// and threaded to every node query beside `partials`: a member's kind is a fact about the rosters,
// fixed before the run starts, so no node query re-walks a roster (DESIGN section 6, bare minimum
// cost). They are consulted in ingest order (dag, python, typescript): the first roster that
// declares a node gives its kind, as the per-roster chain this replaces did.
fn infer_language_inhabitants_kind_index() -> List<RosterKindIndex> {
  [
    roster_kind_index(
      roster: dag_declared_inhabitants_root(),
      subject_field: dag_declared_inhabitants_subject_field()
    ),
    roster_kind_index(
      roster: python_declared_inhabitants_root(),
      subject_field: python_declared_inhabitants_subject_field()
    ),
    roster_kind_index(
      roster: ts_declared_inhabitants_root(),
      subject_field: ts_declared_inhabitants_subject_field()
    )
  ]
}

fn infer_roster_kind_first_declared(acc: Optional<Kind>, index: RosterKindIndex, n: Node) -> Optional<Kind> {
  match acc {
    Present { value: _ } => acc
    Absent => roster_kind_index_lookup(index: index, n: n)
  }
}

// Returns the member's KIND (std.kind roster_kind_index_lookup): a type-denotation member derives
// TypeDenotationKind and a fact about a type derives TypeFactKind -- never the roster root, which
// is where the member was found, not what it is. Absent when no ingested language's roster
// declares the node.
fn infer_node_declared_in_language_inhabitants(kinds: List<RosterKindIndex>, n: Node) -> Optional<Kind> {
  fold(kinds, init: optional_absent(), f: fn(acc, index) {
    infer_roster_kind_first_declared(acc: acc, index: index, n: n)
  })
}

fn infer_node_declared_in_language_inhabitants_bool(kinds: List<RosterKindIndex>, n: Node) -> Bool {
  match infer_node_declared_in_language_inhabitants(kinds: kinds, n: n) {
    Present { value: _ } => true
    Absent => false
  }
}

// THE PRODUCT-INTRODUCTION DERIVATION (Conj and Arrow kinds). A Conj node denotes the product of
// its conjuncts' denotations and an Arrow node the function from its domain's denotation to its
// codomain's — the closed vocabulary's own composition semantics (v2.std.node), not an invented
// meaning. So when EVERY child of a non-roster Conj or Arrow carries DerivedGrounding, the node
// derives: its evidence is the same shape re-formed over each child's grounding evidence, a fresh
// OccurrenceSynthetic node whose evidential chain bottoms out in authority nodes at the leaves
// (never the source node — canonical_grounding_from_derived_type refuses self-evidence by
// construction). When ANY child is still on the frontier or absent from the entries, the node
// stays on the frontier with its typed diagnostic — the derivation discharges only when the whole
// child spine is evidenced, so a partially-derived product can never masquerade as grounded
// (DESIGN section 5). Roster members keep their declared kind (the authority's declaration
// outranks composition for what the language itself declares), and a childless Conj or Arrow has
// no evidence to compose and stays frontier. This discharges the frontier for these
// two kinds: the kind-level rule the specimen-scope roster lookups stood in for.

fn infer_type_node_awaits_product_row(kinds: List<RosterKindIndex>, n: Node) -> Bool {
  (length(xs: n.children) > 0) && !infer_node_declared_in_language_inhabitants_bool(kinds: kinds, n: n)
}

// THE CANONICAL-OPERATION AND GRAMMAR-PRODUCTION MEMBER DERIVATIONS. The resolver canonicalizes a
// dag surface operator to a target-model CanonicalOperation wire node, and the bridge projects a
// grammar production's identity atom (e.g. dag_surface_module) into the tree. Each such node is a
// member of its authority's roster, and derives with the type that authority DECLARES for the
// member (v2.std.compilers.target_model target_model_canonical_operation_member_declared_type,
// v2.extdeps.languages.dag dag_grammar_production_member_declared_type) -- never the roster root,
// which would make derived_type carry provenance where every reader expects a type (DESIGN §3).

fn infer_roster_member_declared_type(n: Node) -> Optional<Node> {
  match target_model_canonical_operation_member_declared_type(n: n) {
    Present { value: member_type } => optional_present(value: member_type)
    Absent => dag_grammar_production_member_declared_type(n: n)
  }
}

// AN ARROW'S DECLARED ORDER IS ITS OWN EVIDENCE: the ^arrow_signature_order_edge's atoms are labels,
// not values, so the derived type carries that edge unchanged (v2.std.node arrow_signature_order_edge).
fn infer_product_child_evidence_edges(
  node: Node,
  entries: List<InferredFactsEntry>,
) -> Optional<List<Edge>> {
  infer_formation_child_evidence_edges(
    children: node.children,
    entries: entries,
    is_metadata: fn(edge) { arrow_signature_order_edge(parent: node, edge: edge) || arrow_named_edge_is_contract(e: edge) }
  )
}

// A FORMED NODE'S EVIDENCE: each child's resolved type under the child's own label, except a
// METADATA edge -- one the parent's model says carries labels or binders, not a value -- which rides
// unchanged. Absent when any value child has no derived grounding, so a partially grounded child spine
// never forms.
fn infer_formation_child_evidence_edges(
  children: List<Edge>,
  entries: List<InferredFactsEntry>,
  is_metadata: fn(Edge) -> Bool,
) -> Optional<List<Edge>> {
  fold(
    children,
    init: optional_present(value: Empty),
    f: fn(acc, edge) {
      match acc {
        Absent => acc
        Present { value: evidence_edges } =>
          if is_metadata(edge) {
            optional_present(value: list_snoc_item(xs: evidence_edges, item: edge))
          } else {
          match lookup_inferred_facts_in_entries(entries: entries, key: edge.target) {
            Absent => optional_absent()
            Present { value: child_facts } =>
              match inferred_facts_resolved_type(facts: child_facts) {
                Violates { diagnostic: _ } => optional_absent()
                Holds { value: child_evidence } =>
                  optional_present(
                    value: list_snoc_item(
                      xs: evidence_edges,
                      item: Edge { label: edge.label, target: child_evidence }
                    )
                  )
              }
          }
          }
      }
    }
  )
}

// WHICH FORMATION A SETTLED TYPE NODE TAKES, decided once. A type-declaration wrapper is NOT a
// product even though its carrier is a Conj (v2.std.type_binder type_decl_view says which it is), so it
// never reaches product introduction: an alias or generic member forms its own evidence with the binder
// edge carried as metadata, and a bodyless declaration derives the type-denotation kind. Every other
// Conj or Arrow is product introduction, and a Disj of Named alternatives is SUM FORMATION -- the same
// kind-preserving construction over its alternatives' evidence. Forming a sum type grants no
// introduction or elimination: it says nothing about a value inhabiting one arm.
// THE DISPATCHER CARRIES THE RESOLVED CARRIER because its PlainTypeDecl arm reaches the product row,
// and that row answers a FIELD PROJECTION before it answers a product -- a projection needs the
// receiver's declaration, which only the index in ResolvedTree can supply. Main introduced this
// dispatcher while this lane threaded the carrier through the row beneath it; taking either side alone
// would have left the projection arm unreachable or the dispatcher unable to reach it.
fn infer_formation_facts_from_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  partials: List<Node>,
  resolved: ResolvedTree,
) -> Outcome<InferredFacts> {
  match binder_node_parts(n: node) {
    Present { value: parts } => infer_binder_node_facts_from_entries(node: node, parts: parts, entries: entries)
    Absent => infer_type_decl_formation_facts_from_entries(node: node, entries: entries, partials: partials, resolved: resolved)
  }
}

// THE CARRIER REACHES THE PRODUCT ROW THROUGH THIS DISPATCHER, which is a merge seam worth naming. main
// introduced this function while this lane widened infer_product_facts_from_entries to take the
// ResolvedTree its projection arm needs, so main's caller passed three arguments to a row that now requires
// four. Threading `resolved` here is the resolution: the dispatcher above already holds it, and every arm
// that does not need it ignores it, so no arm gains a dependency it does not use.
fn infer_type_decl_formation_facts_from_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  partials: List<Node>,
  resolved: ResolvedTree,
) -> Outcome<InferredFacts> {
  match type_decl_view(target: node) {
    TypeAlias { binders: _, aliased: _ } => infer_declaration_wrapper_facts_from_entries(node: node, entries: entries, partials: partials)
    GenericTypeDecl { binders: _, member: _ } => infer_declaration_wrapper_facts_from_entries(node: node, entries: entries, partials: partials)
    OpaqueTypeDecl { binders: _ } => infer_opaque_declaration_facts(node: node, partials: partials)
    PlainTypeDecl { member: _ } =>
      infer_product_facts_from_entries(
        node: node,
        entries: entries,
        partials: partials,
        resolved: resolved
      )
  }
}

// A BINDER NODE IS NOT A PRODUCT (XL-2 PR2b-3). It carries one declared type and, optionally, the
// default an omitted argument takes (v2.std.node_query binder_node_parts). Its derived type is a binder
// node over its type's derived type with NO default: the default is a value, not part of the type, so
// two binders differing only in their default have one type. The default itself is judged at the
// declared type by infer_binder_default_check before this row forms (XL-2 PR2c-ii).
fn infer_binder_node_facts_from_entries(
  node: Node,
  parts: BinderParts,
  entries: List<InferredFactsEntry>,
) -> Outcome<InferredFacts> {
  match infer_descent_witness_for_node(n: node) {
    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
    Holds { value: descent_proof } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: parts.type_node) {
        Absent => inferred_facts_not_derived(node: node, descent: Holds { value: descent_proof })
        Present { value: type_facts } =>
          match inferred_facts_resolved_type(facts: type_facts) {
            Violates { diagnostic: _ } => inferred_facts_not_derived(node: node, descent: Holds { value: descent_proof })
            Holds { value: type_evidence } =>
              inferred_facts_from_derived_type(
                node: node,
                derived_type: binder_node(type_node: type_evidence, default: Absent),
                descent: Holds { value: descent_proof }
              )
          }
      }
  }
}

// AN ALIAS DENOTES ITS RIGHT-HAND SIDE UNDER ITS BINDERS; A GENERIC MEMBER IS ITS MEMBER UNDER ITS
// BINDERS. The evidence is the wrapper re-formed with the binder edge carried unchanged
// (infer_declaration_binder_edge) and the aliased expression or member replaced by its derived type --
// so a generic alias keeps its abstraction rather than collapsing to a closed right-hand side. It forms
// only when that right-hand side or member derives: a generic alias whose right-hand side names its own
// binder (`type Id<T> = T`) has no symbolic grounding route for `T` yet and stays on the frontier,
// never substituted or instantiated here.
fn infer_declaration_wrapper_facts_from_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  partials: List<Node>,
) -> Outcome<InferredFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: node) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          match infer_formation_child_evidence_edges(
            children: node.children,
            entries: entries,
            is_metadata: fn(edge) { edge_is_type_params(e: edge) }
          ) {
            Absent =>
              bind_outcome_accepted(od: cd, inner: inferred_facts_not_derived(node: node, descent: Holds { value: descent_proof }))
            Present { value: evidence_edges } =>
              bind_outcome_accepted(
                od: cd,
                inner: inferred_facts_from_derived_type(
                  node: node,
                  derived_type: Node {
                    kind: node.kind,
                    children: evidence_edges,
                    occurrence_id: OccurrenceSynthetic
                  },
                  descent: Holds { value: descent_proof }
                )
              )
          }
      }
  }
}

// A BODYLESS DECLARATION DENOTES A TYPE, AND THAT IS ALL IT STATES. `type PointerWidth` asserts no
// representation, inhabitant, field, variant or alias target, so it derives exactly the fact infer
// already gives a type-denoting binding (the dag_binding_denotation arm of infer_node_facts):
// TypeDenotationKind. That grants no member, construction or representation-sensitive coercion, and
// for a generic declaration (`type MachineWidth<bits>`) it says only that the declaration names a type
// constructor -- a use's arity and kinds are checked at resolve by the binder authority
// (v2.std.type_binder type_application_conformance). It is not the empty product: an
// authored empty record is a member, and forms through product introduction.
fn infer_opaque_declaration_facts(node: Node, partials: List<Node>) -> Outcome<InferredFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: node) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          bind_outcome_accepted(
            od: cd,
            inner: inferred_facts_from_derived_type(
              node: node,
              derived_type: kind_node(kind: TypeDenotationKind),
              descent: Holds { value: descent_proof }
            )
          )
      }
  }
}

fn infer_product_facts_from_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  partials: List<Node>,
  resolved: ResolvedTree,
) -> Outcome<InferredFacts> {
  match field_projection_optional(n: node) {
    Present { value: projection } =>
      infer_field_projection_facts(
        node: node,
        projection: projection,
        entries: entries,
        partials: partials,
        resolved: resolved
      )
    Absent =>
  match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: node) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          match infer_product_child_evidence_edges(node: node, entries: entries) {
            Absent =>
              bind_outcome_accepted(
                od: cd,
                inner: inferred_facts_not_derived(
                  node: node,
                  descent: Holds { value: descent_proof }
                )
              )
            Present { value: evidence_edges } =>
              bind_outcome_accepted(
                od: cd,
                inner: inferred_facts_from_derived_type(
                  node: node,
                  derived_type: Node {
                    kind: node.kind,
                    children: evidence_edges,
                    occurrence_id: OccurrenceSynthetic
                  },
                  descent: Holds { value: descent_proof }
                )
              )
          }
      }
  }
  }
}

// A PARAMETER OF A NAMED FN IS GROUNDED THROUGH THE INDEX, LIKE ANY PATH-KEYED REFERENCE.
// v2.compiler.resolve mints it over <fn path>.<label> after confirming that path in the symbol index
// (resolve_frame_bound_reference), and the resolved declarations bind that path to the parameter's
// declared type -- so `x` in `fn f(x: Pos)` reads Pos from f's own domain entry, never from whichever
// Arrow a walk meets first. A path the index cannot answer here is the index disagreeing with the
// resolver that minted it: refused, located, never left underived.
type InferBinderType {
  site: NodeOccurrenceIdentity
  derived: Node
}

fn infer_no_binder_types() -> List<InferBinderType> {
  Empty
}

fn infer_node_facts(n: Node, partials: List<Node>, kinds: List<RosterKindIndex>, resolved: ResolvedTree, instances: List<TypeVariableInstance>, binder_types: List<InferBinderType>) -> Outcome<InferredFacts> {
  match parameter_reference_path_optional(node: n) {
    Present { value: path } => infer_parameter_reference_facts(n: n, path: path, index: resolved.resolved_declarations)
    Absent =>
      match lexical_reference_label_optional(node: n) {
        Present { value: _ } => infer_lexical_reference_facts(n: n, resolved: resolved, instances: instances, binder_types: binder_types)
        Absent => infer_term_node_facts(n: n, partials: partials, kinds: kinds, resolved: resolved)
      }
  }
}

// A LEXICAL BINDER'S REFERENCE IS GROUNDED BY THE BINDING RESOLVE RECORDED FOR IT. v2.compiler.resolve
// mints it from a Lexical frame and records which binder answered it in ResolvedTree.lexical_bindings,
// keyed by the reference's occurrence, so infer reads that binding and never searches scope. A binder
// that declares a type (a lambda parameter's domain edge) grounds to it. A MATCH-ARM PAYLOAD BINDER
// grounds from the scrutinee coproduct's instantiated field type, carried in InferFrame.binder_types
// when the gather enters that arm -- the match row itself runs after the arm body, so the construct
// that consumes the binder as a field value would otherwise judge an underived produced type
// (DESIGN §6b: the arm-entry frame is the earliest boundary that can establish the binder's fact).
// A `let` with no declared type stays underived here and reads its value through the let-typed
// operand walk. A reference resolve did not record is the tree disagreeing with the resolver that
// produced it: refused, located.
// A match-payload obligation (LexicalOwedFormal) is discharged from InferBinderType rows or refused
// located. A lambda declared type still uses infer_frame_instantiated: a function's own
// formal is that parameter's type, not a free atom to leave underived (review 78144).
fn infer_lexical_reference_facts(n: Node, resolved: ResolvedTree, instances: List<TypeVariableInstance>, binder_types: List<InferBinderType>) -> Outcome<InferredFacts> {
  match infer_descent_witness_for_node(n: n) {
    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
    Holds { value: descent_proof } =>
      match resolved_tree_lexical_binding(tree: resolved, reference: n) {
        Present { value: binding } =>
          match infer_payload_binder_derived_type(binder_types: binder_types, binding: binding) {
            Present { value: derived } =>
              inferred_facts_from_derived_type(node: n, derived_type: derived, descent: Holds { value: descent_proof })
            Absent =>
              match binding.standing {
                LexicalOwedFormal { field_type: _ } =>
                  Rejected {
                    diagnostics: diagnostics_singleton(d: Diagnostic {
                      reason: ^infer_reason_pattern_payload_formal_uninstantiated,
                      at: node_locus(node: n),
                      correction: Unavailable { reason: ExternalContractUnknown }
                    })
                  }
                LexicalDeclared { node: declared } =>
                  inferred_facts_from_derived_type(
                    node: n,
                    derived_type: infer_frame_instantiated(declared: declared, instances: instances),
                    descent: Holds { value: descent_proof }
                  )
                LexicalValued { node: _ } => inferred_facts_not_derived(node: n, descent: Holds { value: descent_proof })
                LexicalUntyped => inferred_facts_not_derived(node: n, descent: Holds { value: descent_proof })
              }
          }
        Absent =>
          Rejected {
            diagnostics: diagnostics_singleton(d: Diagnostic {
              reason: ^infer_reason_lexical_reference_unrecorded,
              at: node_locus(node: n),
              correction: Unavailable { reason: UserInputBoundary }
            })
          }
      }
  }
}

fn infer_payload_binder_derived_type(binder_types: List<InferBinderType>, binding: LexicalBinding) -> Optional<Node> {
  fold(binder_types, init: optional_absent(), f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if row.site == binding.binder_site {
          optional_present(value: row.derived)
        } else {
          acc
        }
    }
  })
}

fn infer_parameter_reference_facts(n: Node, path: QualifiedName, index: SymbolIndex) -> Outcome<InferredFacts> {
  match infer_descent_witness_for_node(n: n) {
    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
    Holds { value: descent_proof } =>
      match symbol_index_lookup(index: index, qualified_path: path) {
        Present { value: declared } =>
          inferred_facts_from_derived_type(node: n, derived_type: declared, descent: Holds { value: descent_proof })
        Absent =>
          Rejected {
            diagnostics: diagnostics_singleton(d: Diagnostic {
              reason: ^infer_reason_parameter_reference_not_indexed,
              at: node_locus(node: n),
              correction: Unavailable { reason: UserInputBoundary }
            })
          }
      }
  }
}

fn infer_term_node_facts(n: Node, partials: List<Node>, kinds: List<RosterKindIndex>, resolved: ResolvedTree) -> Outcome<InferredFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: n, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: n) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          match dag_canonical_literal_from_node(node: n) {
            Accepted { value: literal, diagnostics: _ } =>
              match infer_literal_value_type(literal: literal) {
                Present { value: literal_type } =>
                  inferred_facts_from_derived_type(
                    node: n,
                    derived_type: literal_type,
                    descent: Holds { value: descent_proof }
                  )
                Absent =>
                  inferred_facts_not_derived(node: n, descent: Holds { value: descent_proof })
              }
            Rejected { diagnostics: _ } =>
              match infer_node_declared_in_language_inhabitants(kinds: kinds, n: n) {
                Present { value: member_kind } =>
                  inferred_facts_from_derived_type(
                    node: n,
                    derived_type: kind_node(kind: member_kind),
                    descent: Holds { value: descent_proof }
                  )
                Absent =>
                match infer_atom_binding_sym(node: n) {
                  Present { value: binding } =>
                    match dag_binding_denotation(sym: binding) {
                      Present { value: _ } =>
                        inferred_facts_from_derived_type(
                          node: n,
                          derived_type: kind_node(kind: TypeDenotationKind),
                          descent: Holds { value: descent_proof }
                        )
                      Absent =>
                      match infer_established_value_type_optional(ret: n) {
                        Present { value: _ } =>
                          inferred_facts_from_derived_type(
                            node: n,
                            derived_type: kind_node(kind: TypeDenotationKind),
                            descent: Holds { value: descent_proof }
                          )
                        Absent =>
                        match infer_roster_member_declared_type(n: n) {
                          Present { value: member_type } =>
                            inferred_facts_from_derived_type(
                              node: n,
                              derived_type: member_type,
                              descent: Holds { value: descent_proof }
                            )
                          Absent =>
                            inferred_facts_not_derived(
                              node: n,
                              descent: Holds { value: descent_proof }
                            )
                        }
                      }
                    }
                  Absent =>
                    infer_declaration_reference_facts(
                      n: n,
                      resolved: resolved,
                      descent_proof: descent_proof
                    )
                }
              }
          }
      }
  }
}

// A FIELD PROJECTION IS TYPED BY THE FIELD THE RECEIVER'S TYPE DECLARES, AND A FIELD NO TYPE DECLARES
// REFUSES HERE. This is the check v2.std.node_query field_projection_node's own header assigned to this
// stage -- "it does not check that `f` IS a declared field of the receiver's type ... it is the
// typecheck stage's, over this node" -- and it is not optional, because v2.compiler.resolve now commits
// the SHAPE for a bound head (resolve_bound_head_projection) without being able to see a type.
// Admitting the shape is not admitting the access, so if this arm merely fell to the frontier every
// misspelled field would be ACCEPTED by inference. Measured: with resolve's arm landed and this one
// absent, `b.absent_field` inferred clean. That is exactly the fail-open the absent-field control in
// v2.test.claim.field_projection.field_projection_stages exists to catch, and it caught it.
//
// IT SITS AT THE HEAD OF THE PRODUCT ROW BECAUSE A PROJECTION IS AN ELIMINATION, NOT A RECORD. A
// projection is a Conj, so without this arm it reaches infer_product_facts_from_entries and is typed as
// the PRODUCT OF ITS OWN CHILDREN's evidence -- a type combining the receiver with the field-name atom,
// which is not the type of anything the program computes. Placing the check first is what keeps the
// product rule from answering for a shape that is not a product.
//
// THE RECEIVER'S TYPE COMES FROM ITS OWN INFERRED FACTS, through this row's `entries`, rather than from
// a second derivation over the tree: the base is an ordinary expression that this stage has already
// typed, and re-deriving its type here would be a second authority that could disagree with the one
// every other consumer of that node reads.
//
// AND THE TYPE'S FIELDS COME THROUGH THE INDEX: the receiver's type is a resolved reference to a corpus
// declaration, so its path goes to the same GUARDED reader the callee path uses (v2.std.symbol_index
// symbol_index_lookup), whose ambiguity refusal therefore also governs which type's fields a projection
// may read.
//
// EVERY UNAVAILABLE STEP STAYS AT THE FRONTIER; ONLY A FIELD THE PAYLOAD DOES NOT DECLARE REFUSES. The
// distinction is deliberate. A receiver whose type this stage cannot yet establish is missing EVIDENCE,
// and turning that into a hard refusal would convict correct programs whose receivers are typed by
// routes not yet reaching here. A payload that IS established and does not declare the field is a
// decided fact about the program, and that is the one this arm rules on.
fn infer_field_projection_facts(
  node: Node,
  projection: FieldProjection,
  entries: List<InferredFactsEntry>,
  partials: List<Node>,
  resolved: ResolvedTree
) -> Outcome<InferredFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: node) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          match infer_projection_receiver(
            base: projection.base,
            entries: entries,
            resolved: resolved
          ) {
            ReceiverTypeUnderived =>
              bind_outcome_accepted(
                od: cd,
                inner: inferred_facts_not_derived(
                  node: node,
                  descent: Holds { value: descent_proof }
                )
              )
            ReceiverTypeNotADeclaration =>
              outcome_rejected(infer_receiver_declares_no_fields_diagnostic(node: node))
            ReceiverDeclarationUnavailable { path: path } =>
              Rejected { diagnostics: infer_closure_miss_refusal(resolved: resolved, path: path, miss: infer_receiver_declaration_unavailable_diagnostic(node: node)) }
            ReceiverArityMismatch =>
              outcome_rejected(infer_receiver_arity_mismatch_diagnostic(node: node))
            ReceiverPayload { payload: payload, instances: instances } =>
              match declared_field_named(payload: payload, name: projection.field) {
                Present { value: declared } =>
                  bind_outcome_accepted(
                    od: cd,
                    inner: inferred_facts_from_derived_type(
                      node: node,
                      derived_type: infer_projected_field_type(field_type: declared.type_node, instances: instances),
                      descent: Holds { value: descent_proof }
                    )
                  )
                Absent =>
                  outcome_rejected(infer_field_not_declared_diagnostic(node: node))
              }
          }
      }
  }
}

// A FIELD OF AN INSTANTIATED GENERIC RECORD HAS ITS DECLARED TYPE AT THIS INSTANTIATION. A receiver
// typed Box<Int> reads Box's payload and binds Box's type parameters to the application's arguments in
// declared order, the same pairing infer_match_coproduct_of_type uses for a matched coproduct, so a field
// declared `item: T` projects as Int. A non-generic receiver binds nothing and keeps its field type
// exactly as declared.
fn infer_projected_field_type(field_type: Node, instances: List<TypeVariableInstance>) -> Node {
  if length(xs: instances) == 0 {
    field_type
  } else {
    infer_type_instantiated(t: field_type, instances: instances)
  }
}

// AN APPLICATION WHOSE ARGUMENT COUNT DIFFERS FROM ITS HEAD'S DECLARED PARAMETERS has no instantiation
// to read a field at; that is a decided defect of the receiver's type, refused at the projection, never
// read past or left at the frontier.
fn infer_receiver_arity_mismatch_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_projection_receiver_type_arity_mismatch,
    at: node_locus(node: node),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn infer_field_not_declared_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_field_not_declared_on_receiver,
    at: node_locus(node: node),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// TWO UNAVAILABILITIES THAT MUST NOT BE ONE ARM. "I could not establish the receiver's type" and "the
// receiver's type is established and declares no fields" are different facts with opposite dispositions,
// and collapsing them into a single Absent is the absorbing fallback DESIGN section 5 forbids: it
// converts a decided negative into "no evidence" and lets the projection pass at the frontier.
//
// MEASURED, NOT ARGUED. Collapsed, this broke the standing negative control
// v2.test.claim.namespace_xl0.cross_module_reference_resolution
// a_receiver_with_no_such_child_never_accepts: `Bool.v` has no child `v`, and because resolve now
// commits the projection shape for a bound head, `Bool`'s established type is not a record reference,
// the payload lookup answered Absent, and the projection was ACCEPTED at the frontier. A receiver with
// no such child accepting is exactly what that control exists to forbid.
//
// SO THE DECIDED CASES REFUSE AND ONLY MISSING EVIDENCE WAITS. A receiver whose type this stage has not
// derived is ReceiverTypeUnderived and stays at the frontier, because convicting a program whose
// receiver is typed by a route not yet reaching here would be a wrong answer in the other direction.
//
// TWO CASES WERE ONE ARM AND THEY ARE NOT ONE FACT. ReceiverNotARecord carried both "the type is
// established and is not a declaration reference" and "the type names a declaration this context cannot
// retrieve", and both emitted projection_receiver_declares_no_fields. The second is not a fact about the
// program at all: a lookup miss establishes that THIS index does not hold the declaration, which is a
// statement about the evidence available here. Asserting it as "declares no fields" convicts a correct
// program of a defect it does not have.
//
// MEASURED, with one variable moved and a green positive control beside the red:
// v2.test.claim.field_projection.field_projection_stages
// fps_a_same_module_record_projection_infers PASSES and
// fps_a_cross_module_record_projection_infers FAILS over byte-identical records projected off a plain
// parameter, differing only in whether the record is declared in the consuming module or an imported one.
// The cause is structural rather than incidental: v2.compiler.resolve resolved_declarations_of fills the
// index from ONE module root, so a declaration an imported provider owns is absent by construction and
// every cross-module field read was being reported as a program defect.
//
// WHY THE UNAVAILABLE ARM REFUSES RATHER THAN WAITING AT THE FRONTIER. Accepting it as not-derived is the
// shape that broke a_receiver_with_no_such_child_never_accepts, recorded above: a receiver with no such
// child reached the frontier and was ACCEPTED. A blocked dependency must therefore be a located refusal
// with its OWN reason -- fail-closed, and saying what is actually unknown -- and never an acceptance and
// never a claim about the receiver's fields. The arm carries the path so a reader can name the declaration
// that could not be retrieved.
type ProjectionReceiver
  = ReceiverPayload { payload: Node, instances: List<TypeVariableInstance> }
  | ReceiverTypeNotADeclaration
  | ReceiverArityMismatch
  | ReceiverDeclarationUnavailable { path: QualifiedName }
  | ReceiverTypeUnderived

fn infer_projection_receiver(
  base: Node,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree
) -> ProjectionReceiver {
  match lookup_inferred_facts_in_entries(entries: entries, key: base) {
    Absent => ReceiverTypeUnderived
    Present { value: base_facts } =>
      match inferred_facts_resolved_type(facts: base_facts) {
        Violates { diagnostic: _ } => ReceiverTypeUnderived
        Holds { value: receiver_type } =>
          infer_projection_receiver_of_type(receiver_type: receiver_type, declarations: resolved.resolved_declarations)
      }
  }
}

// THE RECEIVER'S DECLARATION AND INSTANTIATION, FROM ITS ESTABLISHED TYPE. A plain declaration
// reference binds nothing; an application binds the head's declared type parameters to its arguments
// in declared order. Separate from the facts lookup above so the type-to-payload step is judged on its
// own inputs.
fn infer_projection_receiver_of_type(receiver_type: Node, declarations: SymbolIndex) -> ProjectionReceiver {
  let head_args = infer_type_head_and_args(t: receiver_type)
  match declaration_reference_path_optional(node: head_args.head) {
    Absent => ReceiverTypeNotADeclaration
    Present { value: path } =>
      match symbol_index_lookup(index: declarations, qualified_path: path) {
        Absent => ReceiverDeclarationUnavailable { path: path }
        Present { value: payload } =>
          if length(xs: head_args.args) == 0 {
            ReceiverPayload { payload: payload, instances: infer_no_type_variable_instances() }
          } else {
            let params = symbol_index_declared_type_params_at(index: declarations, qualified_path: path)
            if length(xs: params) != length(xs: head_args.args) {
              ReceiverArityMismatch
            } else {
              ReceiverPayload {
                payload: payload,
                instances: zip_map(a: params, b: head_args.args, f: fn(p, arg) {
                  TypeVariableInstance { binder: p, instance: arg }
                })
              }
            }
          }
      }
  }
}

// THE REFUSAL THAT NAMES MISSING EVIDENCE RATHER THAN A PROGRAM DEFECT. Its correction is a boundary of
// this compiler's own carrier, not of the author's input: the program may be entirely correct and the
// declaration simply unreachable from the index this stage was handed. Keeping it distinct from
// declares_no_fields is what lets the capability repair be verified -- when inference consumes a
// closure-level resolved-declaration authority this reason stops firing, and a corpus that still emits it
// names exactly which declaration could not be retrieved.
// THE LOCUS IS THE PROJECTION SITE AND NOT THE MISSING DECLARATION, deliberately: the author's cursor
// belongs where the program reads the field, and the unretrievable path is carried on
// ReceiverDeclarationUnavailable for a reader that wants it. NoCorrectionReason is a closed set in a shared
// authority (v2.std.diagnostic) with no arm for a carrier gap, and widening it for this one reason would be
// a change to every consumer of that type for a fact already held on this stage's own carrier --
// CorrectionNotModeled is the honest existing arm, since no correction IS modeled for an index that does not
// reach the declaration.
fn infer_receiver_declaration_unavailable_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_projection_receiver_declaration_unavailable,
    at: node_locus(node: node),
    correction: Unavailable { reason: CorrectionNotModeled }
  }
}

// A CLOSURE-INDEX MISS CARRIES ITS PROVIDER'S REFUSAL. When the missed declaration's module is a closure root
// whose own resolve refused (v2.compiler.resolve resolved_tree_unavailable_provider), that refusal chain is
// the miss's cause and travels with it: ahead of the miss when the miss refuses, as advisories when it only
// leaves a fact on the counted frontier. Without a refused provider the miss is exactly what it was.
fn infer_closure_miss_cause(resolved: ResolvedTree, path: QualifiedName) -> Diagnostics {
  match resolved_tree_unavailable_provider(tree: resolved, path: path) {
    Present { value: provider } => Some { diagnostics: provider.refusal }
    Absent => None
  }
}

fn infer_closure_miss_refusal(resolved: ResolvedTree, path: QualifiedName, miss: Diagnostic) -> NonEmptyDiagnostics {
  rejected_with_pending(pending: infer_closure_miss_cause(resolved: resolved, path: path), rejected: diagnostics_singleton(d: miss))
}

fn infer_receiver_declares_no_fields_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_projection_receiver_declares_no_fields,
    at: node_locus(node: node),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// A REFERENCE TO A CORPUS DECLARATION IS TYPED BY THAT DECLARATION, THROUGH THE INDEX RESOLUTION
// ITSELF USED. Resolution answers WHICH declaration a reference denotes and carries it as a
// declaring path; this arm answers WHAT TYPE that declaration establishes for this use. Those are
// two questions and they stay in two stages: nothing here re-resolves a name, and resolution mints
// no types.
//
// THE PATH, NEVER THE LEAF. The deleted scope walk (infer_parameter_scope_search, superseded by
// resolve's recorded lexical bindings, ResolvedTree.lexical_bindings) recorded what a leaf-name answer
// costs: `fn positive(x: Int)` beside `fn f(x: Pos)` grounded every `x` in `f` as `Int`, a type
// fabricated from an unrelated declaration. symbol_index_lookup is asked for the whole declaring
// path, and it is the GUARDED read: a path with more than one bound declaring answers Absent, so a
// contested binding cannot silently yield a type.
//
// A LOOKUP HIT IS NOT TYPE EVIDENCE, AND READABLE PARAMETER NAMES ARE NOT EITHER. The index is built
// from validated normalized roots, which does not establish that an indexed declaration carries usable
// type evidence. An earlier draft of this arm guarded with arrow_domain_binder_labels and claimed that
// an unsupported signature stayed ungrounded; that claim was FALSE OF THE GUARD. That reader takes
// only `children`, so it never establishes the declaration IS an Arrow, and it inspects no parameter
// type, no return type, no scope and no body -- "I can read the parameter names" is a different
// property from "this declaration establishes this callable type", and the comment asserted the second
// while the code checked the first.
//
// THE GUARD IS NOW THE ONE AN APPLICATION WILL ASK. A reference is grounded only if the declaration
// satisfies what v2.compiler.infer's own application path requires of a callee: infer_operator_arrow
// (the node IS an Arrow), a domain whose formals are all named (infer_formals_from_domain), and a
// DECLARED parameter order (arrow_declared_parameter_order -- Absent or Malformed both refuse, because
// the domain is sorted by label for identity so its stored sequence is not the declared one). Grounding
// a reference whose declaration cannot satisfy those would mint evidence no consumer can use.
//
// WHAT THIS STILL DOES NOT ESTABLISH, stated rather than implied: the parameter and return TYPE
// references inside that signature are not resolved in the declaration's scope here, and no body or
// return obligation is discharged. Those remain the existing inference contract's, and a reference
// consuming a declared signature does not recheck a body at every use. This arm's claim is the
// structural callable contract, nothing wider.
// THE CALLABLE EVIDENCE OF A DECLARATION, or its absence. Reuses the application path's readers so a
// reference cannot ground to a callee shape that path would refuse.
fn infer_declaration_callable_evidence(declared: Node) -> Optional<Node> {
  match infer_operator_arrow(operator: declared) {
    Absent => Absent
    Present { value: arrow } =>
      match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
        Absent => Absent
        Present { value: domain } =>
          match infer_formals_from_domain(domain: domain) {
            Absent => Absent
            Present { value: _formals } =>
              match arrow_declared_parameter_order(arrow: arrow) {
                ArrowParameterOrderAbsent => Absent
                ArrowParameterOrderMalformed => Absent
                ArrowParameterOrderDeclared { labels: _ } => Present { value: arrow }
              }
          }
      }
  }
}

// A DECLARATION WHOSE CALLABLE EVIDENCE THIS STAGE CANNOT ADMIT IS THE FRONTIER, NOT A REFUSAL, and
// that is the SAME arm this function already takes when the declaration carries no callable evidence at
// all -- not a new leniency. canonical_grounding_from_derived_type holds every grounding the compiler
// mints to a self-consistency wall (canonical_grounding_admits_infer_facts: the node and its evidence
// well_formed, the two constraint properties, closedness evidence identical to the node). A declaration
// read from the RESOLVED root carries whatever resolve bound into its signature, and a return that is a
// generic instantiation -- `Outcome<ParseArtifact>` -- is not a shape that wall admits.
//
// WHY ROUTING IT TO THE FRONTIER IS THE CORRECT ARM AND NOT A WIDENING. The reference is a USE; the
// question this function answers is "what callable contract does this use denote". When the answer is
// unavailable the honest result is that the use is underived, which infer already carries as the counted
// advisory infer_grounding_not_derived and every DEMANDING consumer -- eval, translate, coercion -- still
// refuses at its own gate. Letting the construction's refusal escape instead made a single-module named
// call whose callee returns a generic instance REJECT the whole module, with the incoherence reported
// against the declaration rather than against anything the program did wrong: a stage refusing a program
// for a route it does not reach. That is the conviction DESIGN section 5 forbids in the other direction,
// and it is a regression from the accepted-at-frontier behaviour, not a wall.
//
// THE RESIDUE IS STATED RATHER THAN COVERED: a generic-returning callee's application stays on the
// frontier, so its result type is not derived and a match on it is not checked against the coproduct's
// variants. The trigger is a canonical grounding for an instantiated generic type, which is the typing
// model's fact and not this reader's.
fn infer_reference_facts_or_frontier(
  o: Outcome<InferredFacts>,
  n: Node,
  descent_proof: TerminationProof,
) -> Outcome<InferredFacts> {
  match o {
    Accepted { value: facts, diagnostics: d } => Accepted { value: facts, diagnostics: d }
    Rejected { diagnostics: _ } =>
      inferred_facts_not_derived(node: n, descent: Holds { value: descent_proof })
  }
}

fn infer_declaration_reference_facts(
  n: Node,
  resolved: ResolvedTree,
  descent_proof: TerminationProof
) -> Outcome<InferredFacts> {
  match declaration_reference_path_optional(node: n) {
    Absent =>
      inferred_facts_not_derived(node: n, descent: Holds { value: descent_proof })
    Present { value: path } =>
      match collection_roster_primitive_call_signature_at(path: qualified_name_to_dotted_string(qn: path)) {
        NotARosterPrimitiveCallRow => infer_declaration_reference_facts_indexed(n: n, resolved: resolved, path: path, descent_proof: descent_proof)
        RosterPrimitiveCallSignature { arrow: callable } => infer_roster_reference_facts(lookup: RosterPrimitiveCallSignature { arrow: callable }, n: n, descent_proof: descent_proof)
        RosterPrimitiveCallSignatureUnreadable => infer_roster_reference_facts(lookup: RosterPrimitiveCallSignatureUnreadable, n: n, descent_proof: descent_proof)
      }
  }
}

// THE FACTS OF A REFERENCE THE ROSTER ANSWERED FOR: typed by the row's signature, or -- when the row's template cannot
// be read -- REFUSED, located at the reference, with infer_reason_roster_row_signature_unreadable (review 76235; never
// a fall-through to the row's template value). Its own function so that refusal is authorable as a supplied-input RED.
fn infer_roster_reference_facts(lookup: RosterSignatureLookup, n: Node, descent_proof: TerminationProof) -> Outcome<InferredFacts> {
  match lookup {
    RosterPrimitiveCallSignature { arrow: callable } =>
      infer_reference_facts_or_frontier(
        o: inferred_facts_from_derived_type(node: n, derived_type: callable, descent: Holds { value: descent_proof }),
        n: n,
        descent_proof: descent_proof
      )
    RosterPrimitiveCallSignatureUnreadable =>
      outcome_rejected(Diagnostic { reason: ^infer_reason_roster_row_signature_unreadable, at: node_locus(node: n), correction: Unavailable { reason: CorrectionNotModeled } })
    NotARosterPrimitiveCallRow =>
      outcome_rejected(Diagnostic { reason: ^infer_reason_roster_reference_without_a_row, at: node_locus(node: n), correction: Unavailable { reason: CorrectionNotModeled } })
  }
}

// A REFERENCE TO A COLLECTION-ROSTER PRIMITIVE-CALL ROW IS TYPED BY THE ROW, never by the declaration the
// row's path names (std.algebra collection_concat_shape is the row's VALUE, a template, not the operation):
// v2.compiler.fold_lowering collection_roster_signature_arrow reads the row's param_types/return_type as the
// callable contract. It records no denotation (infer_facts_denoting): the operation has no .dag body for eval
// to reach, so a demanding consumer refuses at its own gate rather than executing the template.
fn infer_declaration_reference_facts_indexed(
  n: Node,
  resolved: ResolvedTree,
  path: QualifiedName,
  descent_proof: TerminationProof
) -> Outcome<InferredFacts> {
      match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: path) {
        Absent =>
          bind_outcome_accepted(
            od: infer_closure_miss_cause(resolved: resolved, path: path),
            inner: inferred_facts_not_derived(node: n, descent: Holds { value: descent_proof })
          )
        Present { value: declared } =>
          match infer_declaration_callable_evidence(declared: declared) {
            Absent =>
              inferred_facts_not_derived(node: n, descent: Holds { value: descent_proof })
            Present { value: callable } =>
              infer_reference_facts_or_frontier(
                o: infer_facts_denoting(
                  o: inferred_facts_from_derived_type(
                    node: n,
                    derived_type: callable,
                    descent: Holds { value: descent_proof }
                  ),
                  declaration: declared
                ),
                n: n,
                descent_proof: descent_proof
              )
          }
      }
}

// THE DENOTATION IS RECORDED HERE AND NOWHERE ELSE, because here is where the GUARDED reader answered.
// eval cannot ask symbol_index_lookup -- it holds no index -- so without this the only routes open to
// it are a weaker second resolution authority over the tree (which would accept references the guard
// refuses, DESIGN section 3) or reading the declaration's body out of the callable TYPE evidence
// (which conflates two facts). Recording the declaration the lookup returned keeps one authority for
// "which declaration does this reference name" and leaves eval a consumer of it.
//
// ONLY A GROUNDED REFERENCE CARRIES ONE. An underived arm keeps its Absent denotation, so a consumer
// cannot reach an executable body for a reference whose contract was refused.
fn infer_facts_denoting(o: Outcome<InferredFacts>, declaration: Node) -> Outcome<InferredFacts> {
  bind_outcome(
    o: o,
    f: fn(facts) {
      outcome_accepted(
        value: InferredFacts {
          grounding: facts.grounding,
          descent: facts.descent,
          denotation: optional_present(value: declaration)
        }
      )
    }
  )
}

fn lookup_inferred_facts_in_entries(
  entries: List<InferredFactsEntry>,
  key: Node,
) -> Optional<InferredFacts> {
  fold(
    entries,
    init: optional_absent(),
    f: fn(acc, entry) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if entry.node == key {
            optional_present(value: entry.facts)
          } else {
            acc
          }
      }
    }
  )
}

// THE FACTS MAP IS A NODE-KEYED MAP, BUILT ONCE PER RUN (DESIGN section 6, bare minimum cost): a
// lookup against the admitted entries list was a scan, so every lookup was linear in the tree and
// a consumer walking the tree paid quadratic. Entry order still decides a repeated node: the FIRST
// admitted entry answers, exactly as the scan it replaces did, so a later entry never displaces it.
fn inferred_facts_map_enter(facts: Map<Node, InferredFacts>, entry: InferredFactsEntry) -> Map<Node, InferredFacts> {
  match map_lookup(m: facts, key: entry.node) {
    Present { value: _ } => facts
    Absent => map_insert(m: facts, key: entry.node, value: entry.facts)
  }
}

fn facts_map_from_entries(entries: List<InferredFactsEntry>) -> Outcome<PartialFunction<Node, InferredFacts>> {
  match fold(entries, init: Accepted { value: empty_map(), diagnostics: None }, f: fn(acc, entry) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: admitted, diagnostics: d } =>
        if inferred_facts_cover_node(facts: entry.facts, node: entry.node) {
          Accepted { value: inferred_facts_map_enter(facts: admitted, entry: entry), diagnostics: d }
        } else {
          Rejected {
            diagnostics: diagnostics_singleton(
              d: infer_canonical_grounding_incoherent_diagnostic(node: entry.node)
            )
          }
        }
    }
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: admitted, diagnostics: d } =>
      Accepted {
        value: PartialFunction {
          lookup: fn(key) {
            map_lookup(m: admitted, key: key)
          }
        },
        diagnostics: d
      }
  }
}

fn inferred_facts_witness_for_node(tree: InferredTree, node: Node) -> Witness<InferredFacts> {
  witness_from_optional(opt: tree.facts.lookup(node), absent: infer_facts_lookup_miss_diagnostic(key: node))
}

// A DEMAND FOR A CANONICAL GROUNDING THE FRONTIER LEFT UNDERIVED IS A REFUSAL, AND IT HAS ITS OWN
// NAME. `infer_grounding_not_derived` is the frontier ADVISORY infer carries on its Accepted path
// (v2.compiler.inferred_tree NodeGrounding); until 2026-09-21 this arm REFUSED with that same symbol, so a
// consumer that demanded the grounding -- coercion, translate's fold, eval's constraints -- produced
// a rejection chain whose fatal was spelled exactly like the advisories riding in front of it, and no
// reader of the flat chain could tell which link refused (DESIGN section 3: one name, two contracts).
// eval and translate each name their own gate's refusal; this is the shared root every other demand
// reaches, so it names its own.
fn infer_grounding_demanded_not_derived_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^infer_grounding_demanded_not_derived,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn canonical_grounding_from_inferred_facts(
  node: Node,
  facts: InferredFacts,
) -> Outcome<CanonicalGrounding> {
  match facts.grounding {
    GroundingNotDerived { node: n } =>
      outcome_rejected(infer_grounding_demanded_not_derived_diagnostic(at: node_locus(node: n)))
    DerivedGrounding { grounding: g } =>
      if node != g.node {
        outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
      } else if !algebra_ref_is_grounded(algebra: algebra_ref_from_grounding(grounding: g).algebra) {
        outcome_rejected(infer_algebra_ref_ungrounded_diagnostic(node: node))
      } else if canonical_grounding_admits_infer_facts(grounding: g) {
        Accepted {
          value: g,
          diagnostics: None
        }
      } else {
        outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
      }
  }
}

fn canonical_grounding_for_node(tree: InferredTree, node: Node) -> Outcome<CanonicalGrounding> {
  match inferred_facts_witness_for_node(tree: tree, node: node) {
    Holds { value: facts } =>
      canonical_grounding_from_inferred_facts(node: node, facts: facts)
    Violates { diagnostic: d } =>
      outcome_rejected(d)
  }
}

fn admitted_inferred_facts_entry(node: Node, facts: InferredFacts) -> Outcome<InferredFactsEntry> {
  if inferred_facts_cover_node(facts: facts, node: node) {
    Accepted {
      value: InferredFactsEntry { node: node, facts: facts },
      diagnostics: None
    }
  } else {
    outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
  }
}

// A VALUE'S TYPE COMES FROM THE LANGUAGE'S ONE BINDING JOIN, NEVER A NODE THIS FOLD MINTS. A literal
// is typed by what its type binding denotes (v2.extdeps.languages.dag dag_binding_denotation, whose
// rows point at v2.std.integer and v2.std.logic), and so is an application's result (its callee's
// declared return). A type-expression atom that names such a binding derives its KIND, not the type
// it denotes: the type of the expression `Int` is a type, and taking the denotation would type the
// atom as a node structurally equal to itself (docs/plans/arrow-elimination-model.md).
fn infer_literal_type_binding(literal: DagCanonicalLiteral) -> Symbol {
  match literal {
    DagCanonicalBoolLiteral { value: _ } => ^bool_node_symbol
    DagCanonicalIntLiteral { magnitude: _ } => ^dag_binding_type_int
    DagCanonicalSymbolLiteral { symbol: _ } => ^symbol_node_symbol
    DagCanonicalStringLiteral { value: _ } => ^string_node_symbol
  }
}

fn infer_literal_value_type(literal: DagCanonicalLiteral) -> Optional<Node> {
  dag_binding_denotation(sym: infer_literal_type_binding(literal: literal))
}

fn infer_binding_value_type_witness(binding: Symbol, at: Node) -> Witness<Node> {
  match dag_binding_denotation(sym: binding) {
    Present { value: t } => Holds { value: t }
    Absent => Violates { diagnostic: infer_grounding_not_derived_diagnostic(at: node_locus(node: at)) }
  }
}

// The value type an Arrow DECLARES it returns: the denotation of its return atom as written
// (positional child 1). Read from the declaration, never from the Arrow's composed evidence, which
// also carries the body. Absent when the return is not a binding this language's join denotes, and
// then nothing is derived from it.
// A RETURN EXPRESSION THAT IS ALREADY AN ESTABLISHED TYPE IS CONSUMED, NOT DENOTED AGAIN. This reader
// sent every return Atom's identity to dag_binding_denotation, which is a BINDING-to-type operation.
// Int survived that because its canonical type constructor retains the historical spelling
// ^dag_binding_type_int, so its binding and type identities coincide and a second denotation is a
// no-op. Bool does not: it arrives as the DENOTED node (v2.std.logic bool_node, ^bool_node_symbol),
// the binding lookup answered Absent, and both consumers of this reader lost the return -- the
// application's result typing dropped to the frontier, and the body-versus-declared-return check
// skipped its comparison. So Int masked the reader's assumption and Bool exposed it.
//
// THE RECOGNITION IS BY AUTHORITY, NOT BY SPELLING. The established case is compared against
// v2.std.logic's own bool_node() through the existing structural equality, rather than teaching a
// second meaning for ^bool_node_symbol here or widening dag_binding_denotation to accept a denoted
// symbol -- that lookup stays strictly binding-to-type. An arbitrary Atom is not a resolved value type
// and still answers Absent.
//
// ORDERED DENOTATION-FIRST so the Int path is byte-identical: only a return the binding lookup cannot
// denote reaches the established-type question. ONE reader, so introduction and elimination cannot
// disagree about the same signature.
fn infer_established_value_type_optional(ret: Node) -> Optional<Node> {
  if infer_type_equal_ignoring_provenance(a: ret, b: bool_node()) {
    optional_present(value: bool_node())
  } else {
    optional_absent()
  }
}

fn infer_arrow_declared_return_type(arrow: Node) -> Optional<Node> {
  match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 1) {
    Absent => Absent
    Present { value: ret } =>
      match infer_atom_binding_sym(node: ret) {
        Absent => infer_established_value_type_optional(ret: ret)
        Present { value: binding } =>
          match dag_binding_denotation(sym: binding) {
            Present { value: denoted } => Present { value: denoted }
            Absent => infer_established_value_type_optional(ret: ret)
          }
      }
  }
}

// A CALL'S RESULT HAS THE TYPE ITS CALLEE DECLARES, KERNEL OR NOT. infer_arrow_declared_return_type
// knows only the kernel value types (and Bool by authority), so a callee declared to return a
// corpus type -- Nat, Outcome<ParseArtifact> -- answered Absent, the call stayed underived, and every
// declared position it reached accepted it as undecidable. Every other declared type in this
// stage is already used as written (a parameter's declared node, a lexical binding's instantiated
// declaration); this reader now does the same. The kernel answer is consulted FIRST, so the Int and
// Bool paths are byte-identical. Otherwise the declared return node, alias-normalized through the one
// normalization (#13187) and instantiated with the instances the argument walk bound at THIS site, is
// the result. A return that still mentions one of the callee's own type parameters after
// instantiation is not derived (the counted frontier) -- never a fabricated instance; nor is a return
// that is not a type node.
fn infer_application_result_type(
  arrow: Node,
  instances: List<TypeVariableInstance>,
  declarations: SymbolIndex
) -> Optional<Node> {
  match infer_arrow_declared_return_type(arrow: arrow) {
    Present { value: kernel } => Present { value: kernel }
    Absent =>
      match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 1) {
        Absent => Absent
        Present { value: ret } =>
          match ret.kind {
            TypeNode { connective: _ } =>
              let declared = infer_type_instantiated(
                t: infer_type_alias_normalized(t: ret, declarations: declarations),
                instances: instances
              )
              if inhabitance_node_mentions_type_variable(n: declared, type_variables: type_param_names(n: arrow)) {
                optional_absent()
              } else {
                optional_present(value: declared)
              }
            ComputationNode { behavior: _ } => optional_absent()
          }
      }
  }
}

fn infer_atom_binding_sym(node: Node) -> Optional<Symbol> {
  node_atom_identity_optional(node: node)
}

fn infer_conj_edge_named_type_for_binding(edge: Edge, binding: Symbol) -> Optional<Node> {
  match declared_field_from_edge(e: edge) {
    Present { value: binder } =>
      if binder.name == binding {
        optional_present(value: binder.type_node)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn infer_conj_named_type_for_binding(domain: Node, binding: Symbol) -> Optional<Node> {
  match domain.kind {
    TypeNode { connective: Conj } =>
      fold(domain.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => infer_conj_edge_named_type_for_binding(edge: e, binding: binding)
        }
      })
    TypeNode { connective: _ } => Absent
    ComputationNode { behavior: _ } => Absent
  }
}

// A REFINEMENT DECLARATION, READ FROM A TYPE REFERENCE THROUGH THE AUTHORITY RESOLUTION USED. A
// resolved reference carries its declaration's qualified path (v2.std.qualified_name
// declaration_reference_path_optional); the declaration is what v2.std.symbol_index
// symbol_index_lookup answers for that path in the DECLARATIONS WITH RESOLVED BODIES
// (v2.compiler.resolve ResolvedTree resolved_declarations, gunbc#12629) -- never symbol_index, which
// holds declarations as authored -- so the carrier is the identity resolve bound: `Int` is the kernel
// binding, `Pos` (as Pos2's carrier) is its declaration reference. No tree is walked and no second
// reference->declaration route exists. `type Pos = Int where positive` is stored as its member `Conj { <type-expr>: Int,
// <where-refinement-clause>: clause }` (v2.compiler.body_lowering_fold body_lower_type_variant, the
// head lowered as a type). A MISS IS ABSENT, and Absent never admits: the declared-carrier widening
// runs only after the exact crossing refused, so a lookup that finds nothing leaves that refusal
// standing (v2.test.claim.body_cast_node bcn_a_refinement_lookup_miss_refuses).
// CONSUMERS. .carrier is consumed: refinement_declared_carrier hands it to v2.std.coercion
// coercion_cast_crossing (an explicit cast's declared-carrier widening) and, through
// infer_judge_declared_position, to v2.std.inhabitance declared_type_inhabitance (the same one-step
// widening at every declared position: argument, return, field and let). .where_clause is a DECLARED
// FRONTIER, not yet consumed (and the predicate CALLS inside it are walked unjudged and counted under the
// same frontier: infer_where_predicate_set_edge): its consumer is the literal-into-refinement cast arm of work item
// adhoc-032c89dc-138 (deep-bee-18), which projects it into resolve's where-predicate bindings. That arm
// lands with the next-rung trigger of gunbc.recurring_failure_mode as_cast_has_no_lowered_form
// (v2.std.coercion deciding a refinement's predicate on the cast operand); it must refuse on Absent
// too, never read a miss as "not a refinement". Absent when the reference is not a declaration
// reference, the index holds no unambiguous declaration at its path, or the declaration carries no
// where clause (it is then not a refinement, and has no carrier to widen to).
type RefinementDeclaration {
  carrier: Node
  where_clause: Node
}

fn refinement_declaration(index: SymbolIndex, reference: Node) -> Optional<RefinementDeclaration> {
  match declaration_reference_path_optional(node: reference) {
    Absent => Absent
    Present { value: path } =>
      match symbol_index_lookup(index: index, qualified_path: path) {
        Absent => Absent
        Present { value: decl } => refinement_declaration_of_node(decl: decl)
      }
  }
}

// A REFINEMENT DECLARATION READ FROM ITS DECLARED NODE: the where-clause production edge and the
// carrier's type expression, or Absent when the node is not a refinement. The one reader of that
// shape -- refinement_declaration above reaches it through the symbol index, and
// gunbc.instruments.type_declaration_use_census reaches it from a module member it already holds.
fn refinement_declaration_of_node(decl: Node) -> Optional<RefinementDeclaration> {
  match find_labeled_child(root: decl, label: production_edge_label(language: ^dag_language_model_surface_id, edge: ^dag_surface_where_refinement_clause)) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: clause, diagnostics: _ } =>
      match find_named_child(root: decl, name: ^dag_surface_type_expr) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: head, diagnostics: _ } =>
          Present { value: RefinementDeclaration { carrier: head, where_clause: clause } }
      }
  }
}

fn refinement_declared_carrier(index: SymbolIndex, source_type: Node) -> Optional<Node> {
  match refinement_declaration(index: index, reference: source_type) {
    Present { value: d } => Present { value: d.carrier }
    Absent => Absent
  }
}

// The literal arm below derives a real type for the operand; every other operand -- a lexical reference
// included -- is read from its own inferred facts. A lexical reference's facts ARE its binder's declared
// type read through the inference frame (infer_lexical_reference_facts), so reading the binding's declared
// type here instead was a second authority for the same fact that bypassed the frame: a fold step's carrier
// formal stayed its bare fresh variable in `found + e.target` after the frame had instantiated it. When those facts are the GroundingNotDerived
// frontier there is no operand type, and this now refuses (Violates) instead of returning the
// operand NODE as its own type. That fallback was how the self-grounding fabrication entered
// branch/match/loop unification: two arms whose 'types' were their own expression nodes compared
// unequal and were reported as an arm-type mismatch, while two structurally identical arms
// compared equal and were reported as unified — both verdicts about node identity, not types.

// A LET BINDER CARRIES NO DECLARED TYPE; ITS TYPE IS ITS VALUE'S. The binding names the binder
// occurrence (binder_site), and the Bind node that owns it holds the value expression whose facts
// the fold already derived — so an operand that reads the binder derives the value's type instead
// of the GroundingNotDerived frontier (gunbc.recurring_failure_mode
// native_infer_accepts_only_bool_and_int_match_scrutinees: the enrolled variant claims' scrutinees
// are let-bound). A pattern binder or any other declared-less binding that is not a Bind still
// falls through to the facts.
// THE PUBLIC READ stays three-argument: an external caller holds the InferredTree only, whose
// facts are an opaque partial function, so the construct-facts entries thread is not recoverable
// there and the read falls back to the facts alone (the let-typed rule needs the entries). The
// four-argument read below is the inference-internal form, threaded through construct reads.
fn infer_branch_operand_resolved_type_in_tree(
  node: Node,
  facts: InferredFacts,
  resolved: ResolvedTree,
) -> Witness<Node> {
  infer_branch_operand_resolved_type_with_entries(
    node: node,
    facts: facts,
    entries: Empty,
    instances: infer_no_type_variable_instances(),
    resolved: resolved
  )
}

fn infer_branch_operand_resolved_type_with_entries(
  node: Node,
  facts: InferredFacts,
  entries: List<InferredFactsEntry>,
  instances: List<TypeVariableInstance>,
  resolved: ResolvedTree,
) -> Witness<Node> {
  match dag_canonical_literal_from_node(node: node) {
    Accepted { value: literal, diagnostics: _ } =>
      infer_binding_value_type_witness(binding: infer_literal_type_binding(literal: literal), at: node)
    Rejected { diagnostics: _ } =>
      match resolved_tree_lexical_binding(tree: resolved, reference: node) {
        Present { value: binding } =>
          match binding.standing {
            LexicalDeclared { node: declared } =>
              match infer_operand_declared_type_instantiated(declared: declared, instances: instances) {
                Present { value: instantiated } => Holds { value: instantiated }
                Absent =>
                  match infer_let_binder_value_type_optional(entries: entries, binding: binding) {
                    Present { value: value_type } => Holds { value: value_type }
                    Absent => inferred_facts_resolved_type(facts: facts)
                  }
              }
            LexicalValued { node: _ } =>
              match infer_let_binder_value_type_optional(entries: entries, binding: binding) {
                Present { value: value_type } => Holds { value: value_type }
                Absent => inferred_facts_resolved_type(facts: facts)
              }
            LexicalOwedFormal { field_type: _ } => inferred_facts_resolved_type(facts: facts)
            LexicalUntyped =>
              match infer_let_binder_value_type_optional(entries: entries, binding: binding) {
                Present { value: value_type } => Holds { value: value_type }
                Absent => inferred_facts_resolved_type(facts: facts)
              }
          }
        Absent => inferred_facts_resolved_type(facts: facts)
      }
  }
}

// THE DECLARED TYPE AN OPERAND READS IS THE INSTANTIATED ONE. The lexical facts instantiate a
// binding's declared type with infer_frame_instantiated before deriving from it; a read that
// preempts the facts with the raw declared node skips exactly that step, so a generic coproduct's
// field (`Some { value: T }`) would hand the arm body the formal `T` instead of the scrutinee's
// argument (DESIGN 5: no fabricated plausible output). The instantiation is the one the construct
// read holds -- at a match, the scrutinee coproduct's instances. An atom no instance binds is held
// only when it names a type-denoting binding (a concrete literal type, by the same
// dag_binding_denotation test the facts fold applies); a free formal is NOT held -- the read falls
// through to the facts, the answer the caller had before the read existed.
fn infer_operand_declared_type_instantiated(declared: Node, instances: List<TypeVariableInstance>) -> Optional<Node> {
  match declared.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match type_variable_instance_lookup(instances: instances, binder: id) {
        Present { value: instance } => optional_present(value: instance)
        Absent =>
          match dag_binding_denotation(sym: id) {
            Present { value: _ } =>
              match infer_declared_type_children_instantiated(children: declared.children, instances: instances) {
                Present { value: children } =>
                  if length(xs: children) == 0 {
                    optional_present(value: declared)
                  } else {
                    optional_present(
                      value: node_with_occurrence_id(
                        kind: TypeNode { connective: Atom { identity: id } },
                        children: children,
                        occurrence_id: declared.occurrence_id
                      )
                    )
                  }
                Absent => optional_absent()
              }
            Absent => optional_absent()
          }
      }
    TypeNode { connective: _ } =>
      if any(
        xs: node_positional_child_targets(node: declared),
        predicate: fn(c) { infer_declared_type_mentions_free_formal(declared: c, instances: instances) }
      ) {
        optional_absent()
      } else {
        optional_present(value: declared)
      }
    ComputationNode { behavior: _ } =>
      if any(
        xs: node_positional_child_targets(node: declared),
        predicate: fn(c) { infer_declared_type_mentions_free_formal(declared: c, instances: instances) }
      ) {
        optional_absent()
      } else {
        optional_present(value: declared)
      }
  }
}

// Whether a type node still names a formal no instance binds, anywhere in it. A concrete type
// (every atom either instantiated or type-denoting) is safe to hold as written; a node carrying a
// free formal is not, whatever connective wraps it.
fn infer_declared_type_mentions_free_formal(declared: Node, instances: List<TypeVariableInstance>) -> Bool {
  match declared.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match type_variable_instance_lookup(instances: instances, binder: id) {
        Present { value: _ } => false
        Absent =>
          match dag_binding_denotation(sym: id) {
            Present { value: _ } => false
            Absent => true
          }
      }
    TypeNode { connective: _ } =>
      any(
        xs: node_positional_child_targets(node: declared),
        predicate: fn(c) { infer_declared_type_mentions_free_formal(declared: c, instances: instances) }
      )
    ComputationNode { behavior: _ } =>
      any(
        xs: node_positional_child_targets(node: declared),
        predicate: fn(c) { infer_declared_type_mentions_free_formal(declared: c, instances: instances) }
      )
  }
}

// Substitution descends through the arguments: a compound declared type
// (`Box<T>`, `FreeMonoid<T>`) is not held with a formal riding inside it -- an argument no
// instance binds leaves the whole declared type unheld, and the read falls through to the facts
// rather than fabricate a partially formal type.
fn infer_declared_type_children_instantiated(
  children: FreeMonoid<Edge>,
  instances: List<TypeVariableInstance>
) -> Optional<FreeMonoid<Edge>> {
  match children {
    Empty => optional_present(value: Empty)
    Cons { head: c, tail: rest } =>
      match infer_operand_declared_type_instantiated(declared: c.target, instances: instances) {
        Present { value: c2 } =>
          match infer_declared_type_children_instantiated(children: rest, instances: instances) {
            Present { value: rest2 } =>
              optional_present(value: Cons { head: Edge { label: c.label, target: c2 }, tail: rest2 })
            Absent => Absent
          }
        Absent => Absent
      }
  }
}

// THE LET'S VALUE IS THE LET'S TYPE. The binding carries the value node beside the binder site --
// resolve's Bind frame mints it where the Bind node is in hand -- so the read is one map entry and
// one fold-entry lookup, never a tree walk. Absent -- the binding carries no value (a parameter or
// pattern binder), or the value's own facts are underived, as for a let over a still-frontier
// expression -- leaves the caller's answer exactly as it stood.
fn infer_let_binder_value_type_optional(
  entries: List<InferredFactsEntry>,
  binding: LexicalBinding,
) -> Optional<Node> {
  match binding.standing {
    LexicalValued { node: value_target } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: value_target) {
        Absent => optional_absent()
        Present { value: facts } => inferred_facts_resolved_type_optional(facts: facts)
      }
    LexicalDeclared { node: _ } => optional_absent()
    LexicalOwedFormal { field_type: _ } => optional_absent()
    LexicalUntyped => optional_absent()
  }
}

fn inferred_facts_resolved_type_optional(facts: InferredFacts) -> Optional<Node> {
  match facts.grounding {
    DerivedGrounding { grounding: g } => optional_present(value: g.witness.structural.evidence)
    GroundingNotDerived { node: _ } => optional_absent()
  }
}

// The operand's type with no enclosing tree: a literal's own type, else the operand's inferred facts.
// It has no parameter arm -- the previous spelling passed the operand as its own tree, where the
// scope search can never bind (the reference is the root), so this states that result directly
// rather than handing a node to a ResolvedTree position it never came from.
fn infer_branch_operand_resolved_type(node: Node, facts: InferredFacts) -> Witness<Node> {
  match dag_canonical_literal_from_node(node: node) {
    Accepted { value: literal, diagnostics: _ } =>
      infer_binding_value_type_witness(binding: infer_literal_type_binding(literal: literal), at: node)
    Rejected { diagnostics: _ } => inferred_facts_resolved_type(facts: facts)
  }
}

fn inferred_facts_from_derived_type(
  node: Node,
  derived_type: Node,
  descent: Witness<v2.std.cardinality.TerminationProof>,
) -> Outcome<InferredFacts> {
  bind_outcome(
    o: canonical_grounding_from_derived_type(node: node, derived_type: derived_type),
    f: fn(grounding) {
      inferred_facts_from_grounding(grounding: grounding, descent: descent)
    }
  )
}

fn infer_branch_type_atoms_equal(a: Node, b: Node) -> Bool {
  match node_atom_identity_optional(node: a) {
    Present { value: id_a } =>
      match node_atom_identity_optional(node: b) {
        Present { value: id_b } => id_a == id_b
        Absent => false
      }
    Absent => a == b
  }
}

fn infer_branch_type_is_bool(type_node: Node) -> Bool {
  match node_atom_identity_optional(node: type_node) {
    Present { value: id } => id == ^bool_node_symbol
    Absent => false
  }
}

fn infer_branch_cond_type_is_bool(cond_target: Node, cond_facts: InferredFacts) -> Bool {
  match infer_branch_operand_resolved_type(node: cond_target, facts: cond_facts) {
    Holds { value: cond_type } => infer_branch_type_is_bool(type_node: cond_type)
    Violates { diagnostic: _ } => false
  }
}

fn infer_branch_type_is_int(type_node: Node) -> Bool {
  match node_atom_identity_optional(node: type_node) {
    Present { value: id } => id == ^dag_binding_type_int
    Absent => false
  }
}

// Int-scrutinee bool-literal match arms ground body type as Int at arm-row construction (same octet
// 0/1 authority as eval allocate_literal), not a post-unification rewrite. dissolve-on: bool
// keywords carry Int type in Int-valued match bodies at normalize/ingest. scaffold-widen: Int
// scrutinee on bool-literal match emits infer_match_int_scrutinee_bool_literal_scaffold diagnostic
// (countable on Accepted path). paired-scaffold: emit half =
// target_value_expr_int_bool_octet_channel_dissolution_note (target_model.dag) — dissolve both
// halves together on octet↔bool codec inhabitation.

fn infer_match_bool_consumer_diagnostics_with_int_scrutinee_scaffold(
  consumer: Node,
  cd: Diagnostics,
  scrutinee_type: Node
) -> Diagnostics {
  if infer_branch_type_is_int(type_node: scrutinee_type) {
    diagnostics_merge(
      outer: cd,
      inner: Some {
        diagnostics: diagnostics_singleton(
          d: infer_match_int_scrutinee_bool_literal_scaffold_diagnostic(node: consumer)
        )
      }
    )
  } else {
    cd
  }
}

fn infer_match_bool_arm_body_type(
  body_target: Node,
  body_facts: InferredFacts,
  scrutinee_type: Node
) -> Witness<Node> {
  match dag_canonical_literal_from_node(node: body_target) {
    Accepted { value: DagCanonicalBoolLiteral { value: _ }, diagnostics: _ } =>
      if infer_branch_type_is_int(type_node: scrutinee_type) {
        infer_binding_value_type_witness(binding: ^dag_binding_type_int, at: body_target)
      } else {
        infer_branch_operand_resolved_type(node: body_target, facts: body_facts)
      }
    Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
      infer_branch_operand_resolved_type(node: body_target, facts: body_facts)
    Accepted { value: DagCanonicalSymbolLiteral { symbol: _ }, diagnostics: _ } =>
      infer_branch_operand_resolved_type(node: body_target, facts: body_facts)
    Accepted { value: DagCanonicalStringLiteral { value: _ }, diagnostics: _ } =>
      infer_branch_operand_resolved_type(node: body_target, facts: body_facts)
    Rejected { diagnostics: _ } =>
      infer_branch_operand_resolved_type(node: body_target, facts: body_facts)
  }
}

fn infer_match_bool_arm_rows_accept(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
  first_arm_target: Node,
  second_arm_target: Node,
  cd: Diagnostics,
  scrutinee_type: Node
) -> Outcome<InferredFacts> {
  match infer_match_bool_arm_row(
    arm: first_arm_target,
    entries: entries,
    scrutinee_type: scrutinee_type
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: first_row, diagnostics: fd } =>
      match infer_match_bool_arm_row(
        arm: second_arm_target,
        entries: entries,
        scrutinee_type: scrutinee_type
      ) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: second_row, diagnostics: sd } =>
          let first_body = first_row.body_type
          let second_body = second_row.body_type
          match infer_bool_literal_exhaustiveness_merge(
            left: first_row.coverage,
            right: second_row.coverage
          ) {
            InferBoolLiteralExhaustive =>
              if !infer_branch_type_atoms_equal(a: first_body, b: second_body) {
                outcome_rejected(infer_match_arm_type_mismatch_diagnostic(node: node))
              } else {
                match infer_descent_witness_for_node(n: node) {
                  Violates { diagnostic: d } =>
                    Rejected { diagnostics: diagnostics_singleton(d: d) }
                  Holds { value: descent_proof } =>
                    bind_outcome(
                      o: inferred_facts_from_derived_type(
                        node: node,
                        derived_type: first_body,
                        descent: Holds { value: descent_proof }
                      ),
                      f: fn(facts) {
                        Accepted {
                          value: facts,
                          diagnostics: diagnostics_merge(
                            outer: diagnostics_merge(outer: cd, inner: fd),
                            inner: sd
                          )
                        }
                      }
                    )
                }
              }
            InferBoolLiteralMissingTrue =>
              outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
            InferBoolLiteralMissingFalse =>
              outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
            InferBoolLiteralMissingBoth =>
              outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
          }
      }
  }
}

// THE ARMS' COVERED CARRIER, JUDGED BY THE ONE RELATION. The covered carrier is the scrutinee
// coproduct's own alternative edges, rebuilt with only the alternatives the arms name, in
// declaration order -- arm order and arm repetition cannot flatter the answer, and the relation
// (declared_type_inhabitance over PositionMatchCoverage) answers exhaustive exactly when the
// carrier structurally equals the whole coproduct. A wildcard arm covers every alternative, so it
// contributes the whole coproduct. This replaces the per-tag inline count
// (infer_coproduct_rows_cover) that stood in while the relation's carrier was missing:
// gunbc.recurring_failure_mode native_infer_accepts_only_bool_and_int_match_scrutinees.
//
// The obligation carries no type variables because neither carrier poses an instantiation
// question: both are projections of the same declaration (the declared Disj and a subset of its
// edges), so the exact-structural-equality fold compares atom-for-atom within one declaration and
// its verdict cannot depend on how the parameters are instantiated at the scrutinee.
fn infer_coproduct_coverage_obligation(
  node: Node,
  scrutinee_target: Node,
  coproduct: InferMatchCoproduct,
  rows: List<InferCoproductArmRow>,
) -> Outcome<Node> {
  let covered_children = fold(coproduct.variants.children, init: Empty, f: fn(acc, e) {
    match e.label {
      Authored { name: variant_tag } =>
        if any(xs: rows, predicate: fn(row) {
          match row.covers {
            CoversAll => true
            CoversVariant { tag: t } => t == variant_tag
          }
        }) {
          list_snoc_item(xs: acc, item: e)
        } else {
          acc
        }
      StructuralLabel { label: _ } => acc
      Positional => acc
    }
  })
  let covered_carrier = node_rebuild(n: coproduct.variants, children: covered_children)
  match declared_type_inhabitance(
    obligation: DeclaredTypeObligation {
      position: position_match_coverage(match_node: node, scrutinee: scrutinee_target),
      parameter_identity: infer_coproduct_coverage_parameter_identity(coproduct: coproduct),
      declared: coproduct.variants,
      produced: covered_carrier,
      produced_declared_carrier: Absent,
      application: node,
      type_variables: Empty
    }
  ) {
    Inhabits { homomorphism: _ } => outcome_accepted(value: covered_carrier)
    InhabitanceUndecidable { reason: _ } =>
      outcome_rejected(infer_match_coverage_undecidable_diagnostic(node: node))
    InhabitanceRefused { find_witness_reason: _ } =>
      outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
  }
}

// The obligation's parameter identity names the variant in a refusal: the declaration path the
// scrutinee's type resolved through, by its last segment.
fn infer_coproduct_coverage_parameter_identity(coproduct: InferMatchCoproduct) -> Symbol {
  match qualified_name_last_segment(qn: coproduct.path) {
    Present { value: s } => s
    Absent => symbol_intern_lexeme(lexeme: "coproduct_coverage")
  }
}

fn infer_unify_branch_arm_types(
  then_node: Node,
  then_facts: InferredFacts,
  else_node: Node,
  else_facts: InferredFacts,
) -> Outcome<Node> {
  match infer_branch_operand_resolved_type(node: then_node, facts: then_facts) {
    Violates { diagnostic: d } => outcome_rejected(d)
    Holds { value: then_type } =>
      match infer_branch_operand_resolved_type(node: else_node, facts: else_facts) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: else_type } =>
          if infer_branch_type_atoms_equal(a: then_type, b: else_type) {
            Accepted { value: then_type, diagnostics: None }
          } else {
            outcome_rejected(infer_branch_arm_type_mismatch_diagnostic(node: then_node))
          }
      }
  }
}

fn infer_branch_bool_if_else(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
) -> Outcome<InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
      Present { value: cond_target } =>
        match list_at_optional(xs: positional_targets, index: 1) {
          Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
          Present { value: then_target } =>
            match list_at_optional(xs: positional_targets, index: 2) {
              Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
              Present { value: else_target } =>
                match lookup_inferred_facts_in_entries(entries: entries, key: cond_target) {
                  Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: cond_target))
                  Present { value: cond_facts } =>
                    match lookup_inferred_facts_in_entries(entries: entries, key: then_target) {
                      Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: then_target))
                      Present { value: then_facts } =>
                        match lookup_inferred_facts_in_entries(entries: entries, key: else_target) {
                          Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: else_target))
                          Present { value: else_facts } =>
                            match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
                              Rejected { diagnostics: r } => Rejected { diagnostics: r }
                              Accepted { value: _, diagnostics: cd } =>
                                if !infer_branch_cond_type_is_bool(
                                  cond_target: cond_target,
                                  cond_facts: cond_facts
                                ) {
                                  outcome_rejected(infer_branch_cond_not_bool_diagnostic(node: node))
                                } else {
                                  match infer_unify_branch_arm_types(
                                    then_node: then_target,
                                    then_facts: then_facts,
                                    else_node: else_target,
                                    else_facts: else_facts
                                  ) {
                                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                    Accepted { value: unified_type, diagnostics: ud } =>
                                      match infer_descent_witness_for_node(n: node) {
                                        Violates { diagnostic: d } =>
                                          Rejected { diagnostics: diagnostics_singleton(d: d) }
                                        Holds { value: descent_proof } =>
                                          bind_outcome(
                                            o: inferred_facts_from_derived_type(
                                              node: node,
                                              derived_type: unified_type,
                                              descent: Holds { value: descent_proof }
                                            ),
                                            f: fn(facts) {
                                              Accepted {
                                                value: facts,
                                                diagnostics: diagnostics_merge(outer: cd, inner: ud)
                                              }
                                            }
                                          )
                                      }
                                  }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
  }
}

type InferBoolLiteralPattern
  = InferBoolLiteralPatternTrue
  | InferBoolLiteralPatternFalse
  | InferBoolLiteralPatternOther

type InferBoolLiteralArmCoverage
  = InferBoolLiteralArmCoversTrue
  | InferBoolLiteralArmCoversFalse
  | InferBoolLiteralArmCoversNeither

type InferBoolLiteralExhaustiveness
  = InferBoolLiteralExhaustive
  | InferBoolLiteralMissingTrue
  | InferBoolLiteralMissingFalse
  | InferBoolLiteralMissingBoth

type InferMatchArmRow {
  coverage: InferBoolLiteralArmCoverage
  body_type: Node
}

fn infer_bool_literal_pattern_classify(pattern: Node) -> InferBoolLiteralPattern {
  match dag_canonical_literal_from_node(node: pattern) {
    Accepted { value: DagCanonicalBoolLiteral { value: true }, diagnostics: _ } =>
      InferBoolLiteralPatternTrue
    Accepted { value: DagCanonicalBoolLiteral { value: false }, diagnostics: _ } =>
      InferBoolLiteralPatternFalse
    Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
      InferBoolLiteralPatternOther
    Accepted { value: DagCanonicalSymbolLiteral { symbol: _ }, diagnostics: _ } =>
      InferBoolLiteralPatternOther
    Accepted { value: DagCanonicalStringLiteral { value: _ }, diagnostics: _ } =>
      InferBoolLiteralPatternOther
    Rejected { diagnostics: _ } => InferBoolLiteralPatternOther
  }
}

fn infer_bool_literal_arm_coverage_from_pattern(pattern: Node) -> InferBoolLiteralArmCoverage {
  match infer_bool_literal_pattern_classify(pattern: pattern) {
    InferBoolLiteralPatternTrue => InferBoolLiteralArmCoversTrue
    InferBoolLiteralPatternFalse => InferBoolLiteralArmCoversFalse
    InferBoolLiteralPatternOther => InferBoolLiteralArmCoversNeither
  }
}

fn infer_bool_literal_exhaustiveness_merge(
  left: InferBoolLiteralArmCoverage,
  right: InferBoolLiteralArmCoverage
) -> InferBoolLiteralExhaustiveness {
  match left {
    InferBoolLiteralArmCoversTrue =>
      match right {
        InferBoolLiteralArmCoversTrue => InferBoolLiteralMissingFalse
        InferBoolLiteralArmCoversFalse => InferBoolLiteralExhaustive
        InferBoolLiteralArmCoversNeither => InferBoolLiteralMissingFalse
      }
    InferBoolLiteralArmCoversFalse =>
      match right {
        InferBoolLiteralArmCoversTrue => InferBoolLiteralExhaustive
        InferBoolLiteralArmCoversFalse => InferBoolLiteralMissingTrue
        InferBoolLiteralArmCoversNeither => InferBoolLiteralMissingTrue
      }
    InferBoolLiteralArmCoversNeither =>
      match right {
        InferBoolLiteralArmCoversTrue => InferBoolLiteralMissingFalse
        InferBoolLiteralArmCoversFalse => InferBoolLiteralMissingTrue
        InferBoolLiteralArmCoversNeither => InferBoolLiteralMissingBoth
      }
  }
}

fn infer_match_bool_literal_arm_row(
  pat: Node,
  pd: Diagnostics,
  body_target: Node,
  bd: Diagnostics,
  entries: List<InferredFactsEntry>,
  scrutinee_type: Node
) -> Outcome<InferMatchArmRow> {
  let coverage = infer_bool_literal_arm_coverage_from_pattern(pattern: pat)
  match lookup_inferred_facts_in_entries(entries: entries, key: body_target) {
    Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: body_target))
    Present { value: body_facts } =>
      match infer_match_bool_arm_body_type(
        body_target: body_target,
        body_facts: body_facts,
        scrutinee_type: scrutinee_type
      ) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: body_type } =>
          Accepted {
            value: InferMatchArmRow {
              coverage: coverage,
              body_type: body_type
            },
            diagnostics: diagnostics_merge(outer: pd, inner: bd)
          }
      }
  }
}

fn infer_match_bool_arm_row(
  arm: Node,
  entries: List<InferredFactsEntry>,
  scrutinee_type: Node
) -> Outcome<InferMatchArmRow> {
  match arm.kind {
    TypeNode { connective: Conj } =>
      match find_core_child(root: arm, marker: MatchArmPatternEdge) {
        Rejected { diagnostics: _ } =>
          outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
        Accepted { value: pat, diagnostics: pd } =>
          match find_core_child(root: arm, marker: MatchArmBodyEdge) {
            Rejected { diagnostics: _ } =>
              outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
            Accepted { value: body_target, diagnostics: bd } =>
              match infer_bool_literal_pattern_classify(pattern: pat) {
                InferBoolLiteralPatternOther =>
                  outcome_rejected(infer_match_pattern_not_bool_literal_diagnostic(node: arm))
                InferBoolLiteralPatternTrue =>
                  infer_match_bool_literal_arm_row(
                    pat: pat,
                    pd: pd,
                    body_target: body_target,
                    bd: bd,
                    entries: entries,
                    scrutinee_type: scrutinee_type
                  )
                InferBoolLiteralPatternFalse =>
                  infer_match_bool_literal_arm_row(
                    pat: pat,
                    pd: pd,
                    body_target: body_target,
                    bd: bd,
                    entries: entries,
                    scrutinee_type: scrutinee_type
                  )
              }
          }
      }
    TypeNode { connective: Atom { identity: _ } } => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
    TypeNode { connective: Disj } => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
    TypeNode { connective: Arrow } => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
    TypeNode { connective: Cardinality } => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
    TypeNode { connective: Instantiation } => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
    ComputationNode { behavior: _ } => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
  }
}

fn infer_match_bool(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree,
) -> Outcome<InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    outcome_rejected(infer_match_shape_invalid_diagnostic(node: node))
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => outcome_rejected(infer_match_shape_invalid_diagnostic(node: node))
      Present { value: scrutinee_target } =>
        match list_at_optional(xs: positional_targets, index: 1) {
          Absent => outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
          Present { value: first_arm_target } =>
            match list_at_optional(xs: positional_targets, index: 2) {
              Absent => outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
              Present { value: second_arm_target } =>
                match lookup_inferred_facts_in_entries(entries: entries, key: scrutinee_target) {
                  Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: scrutinee_target))
                  Present { value: scrutinee_facts } =>
                    match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
                      Rejected { diagnostics: r } => Rejected { diagnostics: r }
                      Accepted { value: _, diagnostics: cd } =>
                        match infer_branch_operand_resolved_type_with_entries(
                          node: scrutinee_target,
                          facts: scrutinee_facts,
                          entries: entries,
                          instances: infer_no_type_variable_instances(),
                          resolved: resolved
                        ) {
                          Violates { diagnostic: d } => outcome_rejected(d)
                          Holds { value: scrutinee_type } =>
                            if infer_branch_type_is_bool(type_node: scrutinee_type)
                                || infer_branch_type_is_int(type_node: scrutinee_type) {
                              infer_match_bool_arm_rows_accept(
                                node: node,
                                partials: partials,
                                entries: entries,
                                first_arm_target: first_arm_target,
                                second_arm_target: second_arm_target,
                                cd: infer_match_bool_consumer_diagnostics_with_int_scrutinee_scaffold(
                                  consumer: node,
                                  cd: cd,
                                  scrutinee_type: scrutinee_type
                                ),
                                scrutinee_type: scrutinee_type
                              )
                            } else {
                              outcome_rejected(infer_match_scrutinee_not_bool_diagnostic(node: node))
                            }
                        }
                    }
                }
            }
        }
    }
  }
}

// A MATCH OVER A DECLARED COPRODUCT. Which arm family a match takes is decided by its PATTERNS, not
// by whether its scrutinee's type happened to derive: an arm pattern that is a Bool or Int literal is
// the literal family (infer_match_bool, unchanged), and a match with a constructor pattern is
// eliminating a declared coproduct. Deciding by the scrutinee's type instead would route a coproduct match whose scrutinee
// is not yet typed into the literal family, which refuses it as infer_match_scrutinee_not_bool -- a
// verdict about the wrong question.
fn infer_match_arm_pattern_is_literal(arm: Node) -> Bool {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => false
    Accepted { value: pat, diagnostics: _ } =>
      match dag_canonical_literal_from_node(node: pat) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

// A match reaches the coproduct family only when some arm IS a constructor pattern. A match whose
// patterns are neither literals nor constructors -- bare atoms naming nothing, say -- keeps the literal
// family's refusal (infer_match_pattern_not_bool_literal): routing it here instead would meet an
// untyped scrutinee and accept it at the frontier, widening a refusal into an admission
// (v2.test.claim.manual.match_infer_fail_open_audit complement_body_real_infer_refuses_unsupported_pattern_holds).
fn infer_match_arm_pattern_is_constructor(arm: Node) -> Bool {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => false
    Accepted { value: pat, diagnostics: _ } =>
      match infer_coproduct_arm_pattern(pat: pat) {
        ArmPatternVariant { tag: _, fields: _ } => true
        ArmPatternWildcard => false
        ArmPatternUnread => false
      }
  }
}

fn infer_match(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree
) -> Outcome<InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  match list_tail(xs: positional_targets) {
    TailAbsent => outcome_rejected(infer_match_shape_invalid_diagnostic(node: node))
    TailFound { tail: arms } =>
      if any(xs: arms, predicate: fn(arm) { infer_match_arm_pattern_is_literal(arm: arm) }) {
        infer_match_bool(node: node, partials: partials, entries: entries, resolved: resolved)
      } else if any(xs: arms, predicate: fn(arm) { infer_match_arm_pattern_is_constructor(arm: arm) }) {
        infer_match_coproduct(node: node, partials: partials, entries: entries, resolved: resolved)
      } else {
        infer_match_bool(node: node, partials: partials, entries: entries, resolved: resolved)
      }
  }
}

// THE COPRODUCT THE SCRUTINEE'S TYPE DENOTES, INSTANTIATED. `Outcome<ParseArtifact>` is an
// Instantiation whose head is a declaration reference and whose remaining positional children are the
// type arguments; a bare reference is the same with no arguments. The head's declaring path is asked
// of the index through the guarded read (symbol_index_lookup), exactly as a field projection's
// receiver is (infer_projection_receiver), and the declaration's type parameters are the index's
// record of the binders the member cannot carry (symbol_index_declared_type_params_at). Each argument
// instantiates the parameter at its position, so a variant field declared `value: T` reads as the
// argument itself. A declared coproduct is a Disj; anything else -- a record, a kernel type, a path the
// index does not hold -- declares no variants to eliminate, and a count of arguments different from the
// count of parameters binds no instance at all.
type InferMatchCoproduct {
  path: QualifiedName
  variants: Node
  instances: List<TypeVariableInstance>
}

type InferMatchCoproductRead
  = CoproductRead { coproduct: InferMatchCoproduct }
  | CoproductNotDeclared
  | CoproductArityMismatch

type InferTypeHeadArgs {
  head: Node
  args: List<Node>
}

fn infer_type_head_and_args(t: Node) -> InferTypeHeadArgs {
  match t.kind {
    TypeNode { connective: Instantiation } =>
      let targets = node_positional_child_targets(node: t)
      match list_at_optional(xs: targets, index: 0) {
        Absent => InferTypeHeadArgs { head: t, args: Empty }
        Present { value: head } =>
          match list_tail(xs: targets) {
            TailFound { tail: args } => InferTypeHeadArgs { head: head, args: args }
            TailAbsent => InferTypeHeadArgs { head: head, args: Empty }
          }
      }
    TypeNode { connective: _ } => InferTypeHeadArgs { head: t, args: Empty }
    ComputationNode { behavior: _ } => InferTypeHeadArgs { head: t, args: Empty }
  }
}

fn infer_match_coproduct_of_type(scrutinee_type: Node, resolved: ResolvedTree) -> InferMatchCoproductRead {
  let head_args = infer_type_head_and_args(t: scrutinee_type)
  match declaration_reference_path_optional(node: head_args.head) {
    Absent => CoproductNotDeclared
    Present { value: path } =>
      match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: path) {
        Absent => CoproductNotDeclared
        Present { value: declared } =>
          match declared.kind {
            TypeNode { connective: Disj } =>
              let params = symbol_index_declared_type_params_at(index: resolved.resolved_declarations, qualified_path: path)
              if length(xs: params) != length(xs: head_args.args) {
                CoproductArityMismatch
              } else {
                CoproductRead {
                  coproduct: InferMatchCoproduct {
                    path: path,
                    variants: declared,
                    instances: zip_map(a: params, b: head_args.args, f: fn(p, arg) {
                      TypeVariableInstance { binder: p, instance: arg }
                    })
                  }
                }
              }
            TypeNode { connective: _ } => CoproductNotDeclared
            ComputationNode { behavior: _ } => CoproductNotDeclared
          }
      }
  }
}

// A VARIANT'S PAYLOAD IS THE TARGET OF ITS TAG EDGE, NOT A DECLARED FIELD. A coproduct is a Disj whose
// Authored edges are labelled by variant tag and target the payload Conj directly; declared_field_from_edge
// answers only for an edge whose target is a binder node (v2.std.node_query binder_node_parts), so reading a
// variant through it answered Absent for every tag once fields became binder nodes, and every match refused
// as infer_match_pattern_variant_not_declared. The payload's FIELDS are declared fields and keep that reader.
fn infer_match_variant_payload(variants: Node, tag: Symbol) -> Optional<Node> {
  fold(variants.children, init: Absent, f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match e.label {
          Authored { name: variant } => if variant == tag { optional_present(value: e.target) } else { Absent }
          StructuralLabel { label: _ } => Absent
          Positional => Absent
        }
    }
  })
}


// A VARIANT FIELD'S TYPE AT THIS INSTANTIATION, OR NOTHING. This is
// infer_operand_declared_type_instantiated: a parameter the frame instantiates IS its argument; a
// kernel atom is held; a connective with no free formal is held as written. A free formal stays
// Absent -- the binder stays on the counted frontier rather than minting the unresolved atom as a
// derived type (DESIGN §5: refuse, never widen).
fn infer_match_field_type_instantiated(field_type: Node, instances: List<TypeVariableInstance>) -> Optional<Node> {
  infer_operand_declared_type_instantiated(declared: field_type, instances: instances)
}

// AN ARM PATTERN, READ THROUGH THE CONSTRUCT ENCODING'S OWN AUTHORITY. A resolved constructor pattern is
// a Conj whose FIRST edge carries the fixed v2.std.node_query construct_tag_marker() and whose TARGET is
// the tag's declaration reference; the remaining edges are the fields it names. A nullary variant written
// bare is a declaration reference alone; `_` is the wildcard. Nested and literal field patterns are not
// read here: they narrow what an arm covers, and an arm this stage cannot account for refuses rather than
// being counted as covering its variant.
//
// THE TAG IS ASKED OF construct_tag_path_optional RATHER THAN READ OFF THE FIRST EDGE'S LABEL, and that
// is not a refactor -- it is the repair for reading the encoding through a second, positional scheme.
// This reader took the first edge's LABEL to BE the variant tag, which was true of the encoding before
// gunbc#12714 made a construct tag a declaration reference. After it, that label is always the marker, so
// every constructor arm looked up the MARKER as a variant name: the positives went red and
// mbt_a_variant_the_coproduct_does_not_declare_refuses kept passing FOR THE WRONG REASON -- it wants an
// undeclared variant to refuse, and every variant had become undeclared.
//
// That is the §3 lesson in miniature: the encoding has one reader, and a consumer that re-derives the tag
// from edge positions is a second authority that decays silently the moment the encoding moves.
type InferCoproductArmPattern
  = ArmPatternVariant { tag: Symbol, fields: List<Edge> }
  | ArmPatternWildcard
  | ArmPatternUnread

fn infer_coproduct_arm_pattern(pat: Node) -> InferCoproductArmPattern {
  match pat.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == pattern_wildcard_name() { ArmPatternWildcard } else { ArmPatternUnread }
    TypeNode { connective: _ } => infer_coproduct_arm_pattern_constructed(pat: pat)
    ComputationNode { behavior: _ } => infer_coproduct_arm_pattern_constructed(pat: pat)
  }
}

// A non-atom arm pattern: a bare variant reference or a constructed pattern with field binders.
fn infer_coproduct_arm_pattern_constructed(pat: Node) -> InferCoproductArmPattern {
  match declaration_reference_path_optional(node: pat) {
    Present { value: path } =>
      match qualified_name_last_segment(qn: path) {
        Present { value: tag } => ArmPatternVariant { tag: tag, fields: Empty }
        Absent => ArmPatternUnread
      }
    Absent =>
      match construct_tag_path_optional(n: pat) {
        Absent => ArmPatternUnread
        Present { value: path } =>
          match qualified_name_last_segment(qn: path) {
            Absent => ArmPatternUnread
            Present { value: tag } =>
              match list_tail(xs: pat.children) {
                TailFound { tail: fields } => ArmPatternVariant { tag: tag, fields: fields }
                TailAbsent => ArmPatternVariant { tag: tag, fields: Empty }
              }
          }
      }
  }
}

// A FIELD BINDER ARRIVES AS RESOLVE LEAVES IT: v2.compiler.resolve resolve_pattern_node_walk walks a
// non-construct field target as an ordinary node, and the arm's Lexical frame answers the binder's own
// name, so the binder is a lexical reference node (v2.std.qualified_name lexical_reference_node) keyed by
// its own occurrence, not a bare atom. A bare atom is still read, for a pattern built without resolve.
fn infer_field_pattern_binds(target: Node) -> Optional<Symbol> {
  match lexical_reference_label_optional(node: target) {
    Present { value: label } => optional_present(value: label)
    Absent =>
      match target.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if (count(target.children) == 0) && (id != pattern_wildcard_name()) { optional_present(value: id) } else { optional_absent() }
        TypeNode { connective: _ } => Absent
        ComputationNode { behavior: _ } => Absent
      }
  }
}

fn infer_field_pattern_is_wildcard(target: Node) -> Bool {
  match target.kind {
    TypeNode { connective: Atom { identity: id } } => id == pattern_wildcard_name()
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}

fn infer_match_pattern_variant_not_declared_diagnostic(pattern: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_match_pattern_variant_not_declared,
    at: node_locus(node: pattern),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn infer_match_pattern_field_not_declared_diagnostic(pattern: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_match_pattern_field_not_declared,
    at: node_locus(node: pattern),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn infer_match_pattern_unread_diagnostic(pattern: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_match_pattern_unread,
    at: node_locus(node: pattern),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_match_scrutinee_not_coproduct_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_match_scrutinee_not_coproduct,
    at: node_locus(node: node),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn infer_match_type_argument_arity_mismatch_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_match_type_argument_arity_mismatch,
    at: node_locus(node: node),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// THE TWO FRONTIER ADVISORIES. Each rides the Accepted path as a located diagnostic, one per site, so
// a match left untyped is counted where it stands and never reads as a typed result: the facts it
// carries are GroundingNotDerived, which every consumer that demands a type refuses
// (infer_grounding_demanded_not_derived).
fn infer_match_scrutinee_type_underived_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_match_scrutinee_type_underived,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_match_arm_body_type_underived_diagnostic(body: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_match_arm_body_type_underived,
    at: node_locus(node: body),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// ONE ARM, CHECKED AGAINST THE DECLARATION. The variant must be one the coproduct declares and every
// field the pattern names must be one that variant declares; each is a fact about the program, so each
// refuses. The arm's coverage is its variant's tag, or every variant for a wildcard.
type InferCoproductArmRow {
  covers: InferCoproductArmCoverage
  body: Node
}

type InferCoproductArmCoverage
  = CoversVariant { tag: Symbol }
  | CoversAll

fn infer_coproduct_arm_fields_check(pat: Node, payload: Node, fields: List<Edge>) -> Outcome<Bool> {
  fold(fields, init: Accepted { value: true, diagnostics: None }, f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: _, diagnostics: _ } =>
        match e.label {
          Positional => outcome_rejected(infer_match_pattern_unread_diagnostic(pattern: pat))
          StructuralLabel { label: _ } => outcome_rejected(infer_match_pattern_unread_diagnostic(pattern: pat))
          Authored { name: field } =>
            match infer_conj_named_type_for_binding(domain: payload, binding: field) {
              Absent => outcome_rejected(infer_match_pattern_field_not_declared_diagnostic(pattern: pat))
              Present { value: _ } =>
                match infer_field_pattern_binds(target: e.target) {
                  Present { value: _ } => acc
                  Absent =>
                    if infer_field_pattern_is_wildcard(target: e.target) {
                      acc
                    } else {
                      outcome_rejected(infer_match_pattern_unread_diagnostic(pattern: e.target))
                    }
                }
            }
        }
    }
  })
}

fn infer_coproduct_arm_row(arm: Node, coproduct: InferMatchCoproduct) -> Outcome<InferCoproductArmRow> {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
    Accepted { value: pat, diagnostics: _ } =>
      match find_core_child(root: arm, marker: MatchArmBodyEdge) {
        Rejected { diagnostics: _ } => outcome_rejected(infer_match_shape_invalid_diagnostic(node: arm))
        Accepted { value: body, diagnostics: _ } =>
          match infer_coproduct_arm_pattern(pat: pat) {
            ArmPatternUnread => outcome_rejected(infer_match_pattern_unread_diagnostic(pattern: pat))
            ArmPatternWildcard =>
              outcome_accepted(value: InferCoproductArmRow { covers: CoversAll, body: body })
            ArmPatternVariant { tag: tag, fields: fields } =>
              match infer_match_variant_payload(variants: coproduct.variants, tag: tag) {
                Absent => outcome_rejected(infer_match_pattern_variant_not_declared_diagnostic(pattern: pat))
                Present { value: payload } =>
                  bind_outcome(
                    o: infer_coproduct_arm_fields_check(pat: pat, payload: payload, fields: fields),
                    f: fn(_checked) {
                      outcome_accepted(value: InferCoproductArmRow { covers: CoversVariant { tag: tag }, body: body })
                    }
                  )
              }
          }
      }
  }
}


// THE ARM BODIES' ONE TYPE. Two DERIVED body types that differ are a mismatch and refuse; a body whose
// type is not derived leaves the match at the frontier with one located advisory per such body, and
// the match's own facts are GroundingNotDerived rather than the type of the arms that did derive -- a
// match typed from a subset of its arms would be a claim about the arms nobody checked.
type InferArmBodyTypes {
  derived: Optional<Node>
  mismatch: Bool
  underived: Diagnostics
}

fn infer_coproduct_arm_body_types(
  rows: List<InferCoproductArmRow>,
  entries: List<InferredFactsEntry>,
  instances: List<TypeVariableInstance>,
  resolved: ResolvedTree
) -> InferArmBodyTypes {
  fold(rows, init: InferArmBodyTypes { derived: Absent, mismatch: false, underived: None }, f: fn(acc, row) {
    let body_type = match lookup_inferred_facts_in_entries(entries: entries, key: row.body) {
      Absent => Absent
      Present { value: facts } =>
        match infer_branch_operand_resolved_type_with_entries(node: row.body, facts: facts, entries: entries, instances: instances, resolved: resolved) {
          Holds { value: t } => Present { value: t }
          Violates { diagnostic: _ } => Absent
        }
    }
    match body_type {
      Absent =>
        InferArmBodyTypes {
          derived: acc.derived,
          mismatch: acc.mismatch,
          underived: diagnostics_merge(
            outer: acc.underived,
            inner: Some { diagnostics: diagnostics_singleton(d: infer_match_arm_body_type_underived_diagnostic(body: row.body)) }
          )
        }
      Present { value: t } =>
        match acc.derived {
          Absent => InferArmBodyTypes { derived: Present { value: t }, mismatch: acc.mismatch, underived: acc.underived }
          Present { value: held } =>
            InferArmBodyTypes {
              derived: acc.derived,
              mismatch: acc.mismatch || !infer_type_equal_ignoring_provenance(a: held, b: t),
              underived: acc.underived
            }
        }
    }
  })
}

fn infer_match_frontier(node: Node, cd: Diagnostics, advisories: Diagnostics) -> Outcome<InferredFacts> {
  match infer_descent_witness_for_node(n: node) {
    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
    Holds { value: descent_proof } =>
      bind_outcome(
        o: inferred_facts_not_derived(node: node, descent: Holds { value: descent_proof }),
        f: fn(facts) {
          Accepted { value: facts, diagnostics: diagnostics_merge(outer: cd, inner: advisories) }
        }
      )
  }
}

fn infer_match_coproduct_rows(
  node: Node,
  arms: List<Node>,
  coproduct: InferMatchCoproduct,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree,
  scrutinee_target: Node,
  cd: Diagnostics
) -> Outcome<InferredFacts> {
  match fold(arms, init: Accepted { value: Empty, diagnostics: None }, f: fn(acc, arm) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: rows, diagnostics: d } =>
        match infer_coproduct_arm_row(arm: arm, coproduct: coproduct) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: row, diagnostics: _ } => Accepted { value: list_snoc_item(xs: rows, item: row), diagnostics: d }
        }
    }
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: rows, diagnostics: _ } =>
      match infer_coproduct_coverage_obligation(node: node, scrutinee_target: scrutinee_target, coproduct: coproduct, rows: rows) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: _, diagnostics: _ } =>
          {
            let bodies = infer_coproduct_arm_body_types(rows: rows, entries: entries, instances: coproduct.instances, resolved: resolved)
            if bodies.mismatch {
              outcome_rejected(infer_match_arm_type_mismatch_diagnostic(node: node))
            } else {
              match bodies.underived {
                Some { diagnostics: _ } => infer_match_frontier(node: node, cd: cd, advisories: bodies.underived)
                None =>
                  match bodies.derived {
                    Absent => infer_match_frontier(node: node, cd: cd, advisories: None)
                    Present { value: t } =>
                      match infer_descent_witness_for_node(n: node) {
                        Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
                        Holds { value: descent_proof } =>
                          bind_outcome(
                            o: inferred_facts_from_derived_type(node: node, derived_type: t, descent: Holds { value: descent_proof }),
                            f: fn(facts) { Accepted { value: facts, diagnostics: cd } }
                          )
                      }
                  }
              }
            }
          }
      }
  }
}

fn infer_match_coproduct(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree
) -> Outcome<InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) {
    outcome_rejected(infer_match_shape_invalid_diagnostic(node: node))
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => outcome_rejected(infer_match_shape_invalid_diagnostic(node: node))
      Present { value: scrutinee_target } =>
        match list_tail(xs: positional_targets) {
          TailAbsent => outcome_rejected(infer_match_non_exhaustive_diagnostic(node: node))
          TailFound { tail: arms } =>
            match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: _, diagnostics: cd } =>
                match lookup_inferred_facts_in_entries(entries: entries, key: scrutinee_target) {
                  Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: scrutinee_target))
                  Present { value: scrutinee_facts } =>
                    match infer_branch_operand_resolved_type_with_entries(node: scrutinee_target, facts: scrutinee_facts, entries: entries, instances: infer_no_type_variable_instances(), resolved: resolved) {
                      Violates { diagnostic: _ } =>
                        infer_match_frontier(
                          node: node,
                          cd: cd,
                          advisories: Some { diagnostics: diagnostics_singleton(d: infer_match_scrutinee_type_underived_diagnostic(node: scrutinee_target)) }
                        )
                      Holds { value: scrutinee_type } =>
                        match infer_match_coproduct_of_type(scrutinee_type: scrutinee_type, resolved: resolved) {
                          CoproductNotDeclared => outcome_rejected(infer_match_scrutinee_not_coproduct_diagnostic(node: scrutinee_target))
                          CoproductArityMismatch => outcome_rejected(infer_match_type_argument_arity_mismatch_diagnostic(node: scrutinee_target))
                          CoproductRead { coproduct: coproduct } =>
                            infer_match_coproduct_rows(
                              node: node,
                              arms: arms,
                              coproduct: coproduct,
                              scrutinee_target: scrutinee_target,
                              entries: entries,
                              resolved: resolved,
                              cd: cd
                            )
                        }
                    }
                }
            }
        }
    }
  }
}

// FLAG C (body-lowering design, operator-signed): the first cut types carrier-invariant loops only
// — every iteration-fold child must resolve to ONE carrier type τ, so the inferred tree states
// 'body : τ → τ, repeated under the measure'. A refinement-shaped loop (carrier narrows across
// iterations, e.g. Refined<τ> vs τ) lands in the located infer_loop_iteration_type_mismatch refusal
// by construction — refused, never silently fabricated as τ → τ. Dissolution trigger: the
// refinement-typed follow-on (monotone-narrowing carrier) replaces that refusal with a real
// refinement judgment.

// A COLLECTION FOLD ITERATES ITS STEP'S BODY, NOT ITS STEP. The fold encoding's positional child is the step
// CALLABLE (v2.compiler.fold_lowering fold_recurrence_encoding), whose own type is an Arrow over its fresh
// variables and is never the carrier, so reading it refused every fold at the step Arrow. Selected by the
// realization role, never by the Loop's shape; a step with no single body keeps the callable, and the row
// refuses on it as before.
fn infer_loop_iteration_fold_child_targets(node: Node) -> List<Node> {
  let collection_fold = infer_loop_takes_collection_member(loop_node: node)
  fold(node.children, init: [], f: fn(acc, e) {
    if loop_edge_contributes_to_iteration_fold(parent: node, e: e) {
      if collection_fold {
        match fold_step_body_node(step: e.target) {
          Present { value: body } => list_snoc_item(xs: acc, item: body)
          Absent => list_snoc_item(xs: acc, item: e.target)
        }
      } else {
        list_snoc_item(xs: acc, item: e.target)
      }
    } else {
      acc
    }
  })
}

fn infer_loop_body_type_at(target: Node, entries: List<InferredFactsEntry>) -> Outcome<Node> {
  match lookup_inferred_facts_in_entries(entries: entries, key: target) {
    Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: target))
    Present { value: facts } =>
      match infer_branch_operand_resolved_type(node: target, facts: facts) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: body_type } =>
          Accepted {
            value: body_type,
            diagnostics: None
          }
      }
  }
}

fn infer_loop_fixpoint_carrier(
  node: Node,
  body_targets: List<Node>,
  entries: List<InferredFactsEntry>,
) -> Outcome<Node> {
  match list_at_optional(xs: body_targets, index: 0) {
    Absent => outcome_rejected(infer_loop_shape_invalid_diagnostic(node: node))
    Present { value: first_body } =>
      bind_outcome(
        o: infer_loop_body_type_at(target: first_body, entries: entries),
        f: fn(carrier) {
          fold(body_targets, init: Accepted { value: carrier, diagnostics: None }, f: fn(acc, target) {
            match acc {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: c, diagnostics: _ } =>
                match infer_loop_body_type_at(target: target, entries: entries) {
                  Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  Accepted { value: t, diagnostics: _ } =>
                    if infer_branch_type_atoms_equal(a: c, b: t) {
                      acc
                    } else {
                      outcome_rejected(infer_loop_iteration_type_mismatch_diagnostic(node: target))
                    }
                }
            }
          })
        }
      )
  }
}

fn infer_loop_iteration(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
) -> Outcome<InferredFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_loop_fixpoint_carrier(
        node: node,
        body_targets: infer_loop_iteration_fold_child_targets(node: node),
        entries: entries
      ) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: carrier, diagnostics: ud } =>
          match infer_descent_witness_for_node(n: node) {
            Violates { diagnostic: d } =>
              Rejected { diagnostics: diagnostics_singleton(d: d) }
            Holds { value: descent_proof } =>
              bind_outcome(
                o: inferred_facts_from_derived_type(
                  node: node,
                  derived_type: carrier,
                  descent: Holds { value: descent_proof }
                ),
                f: fn(facts) {
                  Accepted {
                    value: facts,
                    diagnostics: diagnostics_merge(outer: cd, inner: ud)
                  }
                }
              )
          }
      }
  }
}

// Binary algebra-operator derivation (v2-inferred-tree-completeness): a binary infix Transform whose
// operator is an algebra primitive derives its result through the operand type's structure, by the one
// route below (infer_binary_algebra_field, infer_algebra_field_result_type) -- `+` and `||` alike, with no
// per-operator or per-type arm. Operator recognition accepts dag_token_plus pre-resolve and the canonical
// operation wire post-resolve (03_resolve.resolve_transform_operator_child). Every reached Transform awaits
// the transform row so application-argument inhabitance runs; this derivation is selected inside
// infer_gather_transform_row_on_entries, and a Transform that is not a binary algebra primitive stays
// GroundingNotDerived as the application's result type after the inhabitance judgment.

// A BINARY ALGEBRA OPERATOR NAMES ONE FIELD OF A STRUCTURE, and the field is the whole of what it says: the
// lowered operator is a canonical-operation wire (v2.std.compilers.target_model canonical_operation_from_wire_node)
// whose AlgebraPrimitive carries the signature field -- ^ring_field_add for `+`, ^lattice_field_join for `||`,
// ^lattice_field_meet for `&&`. The bare `+` token is the add field's surface spelling
// (canonical_operation_op_add). Anything else is not an algebra primitive and stays out of this arm.
fn infer_binary_algebra_field(op_node: Node) -> Optional<Symbol> {
  if infer_operator_is_plus_token(op_node: op_node) {
    infer_canonical_operation_field(operation: canonical_operation_op_add())
  } else {
    infer_wire_algebra_field(wire: op_node)
  }
}

fn infer_operator_is_plus_token(op_node: Node) -> Bool {
  match node_atom_identity_optional(node: op_node) {
    Present { value: id } => id == ^dag_token_plus
    Absent => false
  }
}

fn infer_wire_algebra_field(wire: Node) -> Optional<Symbol> {
  match canonical_operation_from_wire_node(wire: wire) {
    Accepted { value: decoded, diagnostics: _ } => infer_canonical_operation_field(operation: decoded)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn infer_canonical_operation_field(operation: CanonicalOperation) -> Optional<Symbol> {
  match operation {
    AlgebraPrimitive { algebra_field: field } => optional_present(value: field)
    AlgebraInverseCompose { binary_field: _, inverse_field: _ } => optional_absent()
    OrderingComparison { compare_field: _, predicate: _ } => optional_absent()
    EqualityComparison { eq_field: _, predicate: _ } => optional_absent()
    CoercionCrossing { homomorphism_rule: _ } => optional_absent()
  }
}

// THE OPERAND TYPE CARRIES THE FIELD WHEN ITS LANGUAGE MODEL SAYS SO: a row in
// v2.extdeps.languages.dag dag_algebra_inhabitance_decls inhabits a structure that DECLARES the field, read
// through v2.std.algebra_structure_signature algebra_inhabitance_field_reading (the structure's binders and
// the sub-structures it composes -- never a name found inside an operation's signature). The row is SELECTED by
// the carrier its own inhabitance node is over (the ^inhabitant_edge target, read in the same call), never by the
// row's outer `inhabitant` field: that field is a second copy of the carrier, and selecting by it let a row whose
// copy disagreed with its structure lend the structure's fields to a type the structure is not over. The result is the
// operand type because every binary algebra primitive these structures carry is closed on the carrier: a
// lattice join is algebra_binary_fn_node(domain: T, T, codomain: T), and ring add is the operation of the
// abelian group the ring composes. This replaces the Int-only arm that hard-coded `+` over
// ^dag_binding_type_int: Int add derives through Int's ordered-ring row and Bool join through Bool's
// boolean-algebra row, by one route; a type with no row declaring the field (Bool `+`, Int `||`) is refused as
// an operand mismatch exactly as a non-Int `+` was.
// What the operand type's row answers for the field: the result type, no row carrying it, or a row whose
// inhabitance node is malformed -- the last refused with ITS cause, never as an operand mismatch.
type InferAlgebraFieldResult
  = AlgebraFieldResultType { result: Node }
  | AlgebraFieldNotCarried
  | AlgebraFieldRowMalformed { cause: Symbol }

fn infer_algebra_field_result_type(rows: List<AlgebraInhabitanceDecl>, operand_type: Node, field: Symbol) -> InferAlgebraFieldResult {
  fold(rows, init: AlgebraFieldNotCarried, f: fn(acc, decl) {
    match acc {
      AlgebraFieldResultType { result: _ } => acc
      AlgebraFieldRowMalformed { cause: _ } => acc
      AlgebraFieldNotCarried =>
        match algebra_inhabitance_field_reading(inhabitance: decl.algebra, field: field) {
          InhabitanceFieldReadMalformed { cause: c } => AlgebraFieldRowMalformed { cause: c }
          InhabitanceFieldRead { carrier: carrier, declaration: declaration } =>
            if infer_branch_type_atoms_equal(a: carrier, b: operand_type) {
              match declaration {
                FieldDeclared => AlgebraFieldResultType { result: operand_type }
                FieldNotDeclared => AlgebraFieldNotCarried
                InhabitanceMalformed { cause: c } => AlgebraFieldRowMalformed { cause: c }
              }
            } else {
              AlgebraFieldNotCarried
            }
        }
    }
  })
}


fn infer_transform_is_binary_infix_algebra_shape(node: Node) -> Bool {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    false
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => false
      Present { value: op_target } =>
        match infer_binary_algebra_field(op_node: op_target) {
          Present { value: _ } => true
          Absent => false
        }
    }
  }
}

fn infer_unify_transform_operand_types(
  left_node: Node,
  left_facts: InferredFacts,
  right_node: Node,
  right_facts: InferredFacts,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree,
) -> Outcome<Node> {
  match infer_branch_operand_resolved_type_with_entries(node: left_node, facts: left_facts, entries: entries, instances: infer_no_type_variable_instances(), resolved: resolved) {
    Violates { diagnostic: d } => outcome_rejected(d)
    Holds { value: left_type } =>
      match infer_branch_operand_resolved_type_with_entries(
        node: right_node,
        facts: right_facts,
        entries: entries,
        instances: infer_no_type_variable_instances(),
        resolved: resolved
      ) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: right_type } =>
          if infer_branch_type_atoms_equal(a: left_type, b: right_type) {
            Accepted { value: left_type, diagnostics: None }
          } else {
            outcome_rejected(infer_transform_operand_type_mismatch_diagnostic(node: left_node))
          }
      }
  }
}

fn infer_transform_argument_targets(node: Node) -> List<Node> {
  match list_tail(xs: node_positional_child_targets(node: node)) {
    TailAbsent => Empty
    TailFound { tail: t } => t
  }
}

fn infer_operator_arrow(operator: Node) -> Optional<Node> {
  match operator.kind {
    TypeNode { connective: Arrow } => Present { value: operator }
    TypeNode { connective: Atom { identity: _ } } => Absent
    TypeNode { connective: Conj } => Absent
    TypeNode { connective: Disj } => Absent
    TypeNode { connective: Cardinality } => Absent
    TypeNode { connective: Instantiation } => Absent
    ComputationNode { behavior: _ } => Absent
  }
}

fn infer_formals_from_domain(domain: Node) -> Optional<List<InhabitanceFormal>> {
  match domain.kind {
    TypeNode { connective: Conj } =>
      fold(domain.children, init: Present { value: Empty }, f: fn(acc, e) {
        match acc {
          Absent => Absent
          Present { value: formals } =>
            match declared_field_from_edge(e: e) {
              Present { value: binder } =>
                Present {
                  value: list_snoc_item(
                    xs: formals,
                    item: InhabitanceFormal {
                      parameter_identity: binder.name,
                      declared: binder.type_node
                    }
                  )
                }
              Absent => Absent
            }
        }
      })
    TypeNode { connective: Atom { identity: _ } } => Absent
    TypeNode { connective: Disj } => Absent
    TypeNode { connective: Arrow } => Absent
    TypeNode { connective: Cardinality } => Absent
    TypeNode { connective: Instantiation } => Absent
    ComputationNode { behavior: _ } => Absent
  }
}

// THE CALLEE'S ARROW, FROM THE CALLEE'S OWN EVIDENCE WHEN THE NODE IS NOT ONE ITSELF. A resolved
// declaration reference stays a Conj however well typed it is, so infer_operator_arrow answers Absent
// for it and every consumer of this helper -- formals, type parameters, argument inhabitance, result
// typing -- fell through to the undecidable-accepted arm. Giving the reference callable facts does not
// make this path read them; this is where it reads them. The use keeps its own node and occurrence:
// only the TYPE is taken from its facts entry, never the declaration's body or identity.
fn infer_application_callee_use(node: Node) -> Optional<Node> {
  list_at_optional(xs: node_positional_child_targets(node: node), index: 0)
}

fn infer_application_callee_arrow_with_facts(
  node: Node,
  entries: List<InferredFactsEntry>
) -> Optional<Node> {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
    Absent => Absent
    Present { value: operator } =>
      match infer_operator_arrow(operator: operator) {
        Present { value: arrow } => Present { value: arrow }
        Absent =>
          match lookup_inferred_facts_in_entries(entries: entries, key: operator) {
            Absent => Absent
            Present { value: facts } =>
              match facts.grounding {
                GroundingNotDerived { node: _ } => Absent
                DerivedGrounding { grounding: g } =>
                  infer_operator_arrow(operator: g.witness.structural.evidence)
              }
          }
      }
  }
}

// THE FORMALS IN DECLARED ORDER, OR A REFUSAL. The domain's formals are keyed by name; their
// positions come only from the Arrow's declared order (arrow_declared_parameter_order), never from
// the domain's stored sequence, which is sorted by label for identity (gunbc#12054). An operator
// that is not an Arrow, or a domain whose formals are not all named, stays FormalsUnresolved -- the
// undecidable-accepted arm it always took. An Arrow with named formals and no readable order refuses.
type InferApplicationFormals
  = FormalsInDeclaredOrder { formals: List<InhabitanceFormal> }
  | FormalsUnresolved
  | FormalsOrderRefused { reason: Symbol }

fn infer_application_formals(node: Node, entries: List<InferredFactsEntry>) -> InferApplicationFormals {
  match infer_application_callee_arrow_with_facts(node: node, entries: entries) {
    Absent => FormalsUnresolved
    Present { value: arrow } =>
      match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
        Absent => FormalsUnresolved
        Present { value: domain } =>
          match infer_formals_from_domain(domain: domain) {
            Absent => FormalsUnresolved
            Present { value: formals } =>
              match arrow_declared_parameter_order(arrow: arrow) {
                ArrowParameterOrderAbsent =>
                  FormalsOrderRefused { reason: application_parameter_order_absent_reason() }
                ArrowParameterOrderMalformed =>
                  FormalsOrderRefused { reason: application_parameter_order_malformed_reason() }
                ArrowParameterOrderDeclared { labels: labels } =>
                  infer_formals_in_declared_order(formals: formals, labels: labels)
              }
          }
      }
  }
}

// Each declared label selects its one formal by identity, in declared order. Both sides are sorted by
// label once and matched in one walk, then put back in declared order by position -- O(n log n), not
// a scan of the formals per label. The order edge is a permutation of the domain's binders
// (v2.std.node arrow_signature_order_conforms), so a mismatch here is malformed and refuses rather
// than shortening the list.
type InferIndexedLabel {
  label: Symbol
  position: Int
}

type InferIndexWalk {
  index: Int
  labels: List<InferIndexedLabel>
}

type InferFormalPairing {
  indexed: InferIndexedLabel
  formal: InhabitanceFormal
}

fn infer_formals_in_declared_order(formals: List<InhabitanceFormal>, labels: List<Symbol>) -> InferApplicationFormals {
  if length(xs: formals) != length(xs: labels) {
    FormalsOrderRefused { reason: application_parameter_order_malformed_reason() }
  } else {
    let indexed = fold(labels, init: InferIndexWalk { index: 0, labels: Empty }, f: fn(acc, l) {
      InferIndexWalk { index: acc.index + 1, labels: Cons { head: InferIndexedLabel { label: l, position: acc.index }, tail: acc.labels } }
    }).labels
    let pairs = infer_pair_by_label(
      labels: sort_by(indexed, infer_indexed_label_key),
      formals: sort_by(formals, infer_formal_identity_key)
    )
    if infer_pairings_match(pairs: pairs) {
      FormalsInDeclaredOrder { formals: infer_pairings_in_declared_order(pairs: pairs) }
    } else {
      FormalsOrderRefused { reason: application_parameter_order_malformed_reason() }
    }
  }
}

// Sort keys are named top-level functions: an inline lambda's parameter type is not inferred from a
// generic instantiation (the v2.std.node edge_label_of precedent).
fn infer_indexed_label_key(x: InferIndexedLabel) -> Symbol {
  x.label
}

fn infer_formal_identity_key(f: InhabitanceFormal) -> Symbol {
  f.parameter_identity
}

fn infer_pairing_position_key(p: InferFormalPairing) -> Int {
  p.indexed.position
}

// Folds over the pairings take them as a TYPED parameter: the emitter types a fold's element from
// the list's declared type, and a zip_map result reached inline carries none (it emitted an error
// type and refused the emitted crate).
fn infer_pair_by_label(labels: List<InferIndexedLabel>, formals: List<InhabitanceFormal>) -> List<InferFormalPairing> {
  zip_map(a: labels, b: formals, f: fn(il, f) { InferFormalPairing { indexed: il, formal: f } })
}

fn infer_pairings_match(pairs: List<InferFormalPairing>) -> Bool {
  fold(pairs, init: true, f: fn(acc, p) { acc && (p.indexed.label == p.formal.parameter_identity) })
}

fn infer_pairings_in_declared_order(pairs: List<InferFormalPairing>) -> List<InhabitanceFormal> {
  list_map(xs: sort_by(pairs, infer_pairing_position_key), f: infer_pairing_formal)
}

fn infer_pairing_formal(p: InferFormalPairing) -> InhabitanceFormal {
  p.formal
}

// The callee's declared type parameters; empty when the operator is not an Arrow or declares none.
// `entries` REACHES infer_application_type_params AND MAIN'S CALL SITE HAD DROPPED IT. That reader asks
// infer_application_callee_arrow_with_facts, which finds a callee arrow reached THROUGH the use's facts
// and not only one that IS an Arrow node, so without the argument a declaration's arrow is invisible to
// it. Both spellings typecheck, which is why the argument is restored deliberately here: dropping it is
// the same silent deletion that cost this lane five claims once already.
fn infer_application_type_params(node: Node, entries: List<InferredFactsEntry>) -> List<Symbol> {
  match infer_application_callee_arrow_with_facts(node: node, entries: entries) {
    Absent => []
    Present { value: arrow } => type_param_names(n: arrow)
  }
}

type InhabitanceFormalArg {
  formal: InhabitanceFormal
  arg: Node
}

fn infer_inhabitance_undecidable_accepted(
  application: Node,
  reason: InhabitanceUndecidableReason
) -> Outcome<Bool> {
  Accepted {
    value: true,
    diagnostics: Some {
      diagnostics: diagnostics_singleton(
        d: inhabitance_undecidable_diagnostic(application: application, reason: reason)
      )
    }
  }
}

// ONE JUDGE FOR EVERY DECLARED POSITION. An argument at its formal and an Arrow body at its declared
// return ask the same question -- does the type derived at `produced_at` inhabit `formal.declared`? --
// so both build a DeclaredTypeObligation here and hand it to the one relation,
// v2.std.inhabitance declared_type_inhabitance. Only the position differs, and it rides on the
// obligation into the refusal. A position whose produced type is not derived stays the counted
// frontier (UndecidableArgumentTypeNotDerived), never an admission.
//
// The declared side is compared at its DENOTATION, the value type the produced side is derived in:
// a type-name atom as written (`Bool`) is not the value type a `true` derives (v2.std.logic
// bool_node), so each atom goes through the one binding->value-type join,
// v2.extdeps.languages.dag dag_binding_denotation, before the relation reads it. A declared type
// that is a bare atom the join does not denote, and not one of the type variables, is not a type
// this relation can compare: it is counted UndecidableFormalUnresolved, never refused for the
// spelling and never admitted silently.
//
// A DECLARED POSITION THAT ALREADY CARRIES ITS VALUE TYPE IS DECIDABLE, AND THE JOIN CANNOT SAY SO.
// dag_binding_denotation is strictly BINDING->value-type, and `Bool` does not reach this reader as a
// binding: it arrives as the DENOTED node already (v2.std.logic bool_node), so the join answers Absent
// and the position was counted rather than compared. `Int` masked it, because its canonical type
// constructor retains the historical spelling ^dag_binding_type_int and its binding and type identities
// coincide -- so a declared-Int mismatch refused while the identical declared-Bool mismatch was
// accepted at the frontier. MEASURED, not inferred: for `fn wrong(only_arg: Int) -> Bool { only_arg }`
// the Arrow's declared return is structurally bool_node(), and for the converse fixture it is
// ^dag_binding_type_int.
//
// SO THE RECOGNITION IS ASKED BY AUTHORITY, NOT BY SPELLING: infer_established_value_type_optional
// compares against v2.std.logic's own bool_node() through the existing structural equality. That is one
// authority consumed by both this gate and infer_declared_type_denotation, rather than a second
// recognition here or a widening of dag_binding_denotation to accept a denoted symbol -- the join stays
// strictly binding-to-type. An arbitrary atom is still not a resolved value type and is still counted.
fn infer_declared_position_undecidable_reason(
  declared: Node,
  type_params: List<Symbol>
) -> Optional<InhabitanceUndecidableReason> {
  match inhabitance_node_undecidable_reason(n: declared, type_variables: type_params) {
    Present { value: reason } => optional_present(value: reason)
    Absent =>
      match declared.kind {
        TypeNode { connective: Atom { identity: id } } =>
          match dag_binding_denotation(sym: id) {
            Present { value: _ } => Absent
            Absent =>
              match infer_established_value_type_optional(ret: declared) {
                Present { value: _ } => Absent
                Absent => optional_present(value: undecidable_formal_unresolved())
              }
          }
        _ => Absent
      }
  }
}

fn infer_declared_type_denotation(declared: Node) -> Node {
  fold_node(
    n: declared,
    algebra: NodeFold {
      init: fn(self) {
        match self.kind {
          TypeNode { connective: Atom { identity: id } } =>
            match dag_binding_denotation(sym: id) {
              Present { value: denoted } => denoted
              Absent =>
                match infer_established_value_type_optional(ret: self) {
                  Present { value: established } => established
                  Absent => Node { kind: self.kind, children: [], occurrence_id: self.occurrence_id }
                }
            }
          _ => Node { kind: self.kind, children: [], occurrence_id: self.occurrence_id }
        }
      },
      step: fn(acc, edge, sub) {
        Node {
          kind: acc.kind,
          children: list_snoc_item(xs: acc.children, item: Edge { label: edge.label, target: sub }),
          occurrence_id: acc.occurrence_id
        }
      }
    }
  )
}

fn infer_judge_declared_position(
  position: DeclaredTypePosition,
  application: Node,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  formal: InhabitanceFormal,
  produced_at: Node,
  type_params: List<Symbol>
) -> Outcome<Bool> {
  match infer_declared_position_undecidable_reason(declared: formal.declared, type_params: type_params) {
    Present { value: reason } =>
      infer_inhabitance_undecidable_accepted(
        application: application,
        reason: reason
      )
    Absent =>
  match lookup_inferred_facts_in_entries(entries: entries, key: produced_at) {
    Absent =>
      infer_inhabitance_undecidable_accepted(
        application: application,
        reason: undecidable_argument_type_not_derived()
      )
    Present { value: facts } =>
      match inferred_facts_resolved_type(facts: facts) {
        Violates { diagnostic: _ } =>
          infer_inhabitance_undecidable_accepted(
            application: application,
            reason: undecidable_argument_type_not_derived()
          )
        Holds { value: produced } =>
          let obligation = infer_declared_type_obligation(position: position, parameter_identity: formal.parameter_identity, declared: infer_declared_type_denotation(declared: formal.declared), produced: produced, application: application, type_variables: type_params, declarations: declarations)
          match declared_type_inhabitance(obligation: obligation) {
            Inhabits { homomorphism: _ } => Accepted { value: true, diagnostics: None }
            InhabitanceUndecidable { reason: reason } =>
              infer_inhabitance_undecidable_accepted(
                application: obligation.application,
                reason: reason
              )
            InhabitanceRefused { find_witness_reason: fw_reason } =>
              outcome_rejected(
                application_argument_does_not_inhabit_diagnostic(
                  obligation: obligation,
                  find_witness_reason: fw_reason
                )
              )
          }
      }
  }
  }
}

fn infer_no_type_variable_instances() -> List<TypeVariableInstance> {
  Empty
}

// A FORMAL THAT CONTAINS A TYPE PARAMETER INSIDE A CONSTRUCTOR (`xs: List<T>`) IS MATCHED, THEN JUDGED.
// Handed to the declared-position judge as written it mentions a type variable, so the judge answered
// UndecidableGenericFormal and the application was ACCEPTED whatever the argument was: `g<T>(a: List<T>)`
// called with an Int, or with `List<Int>` and `List<Pair>` at two `List<T>` formals, passed silently --
// below the floor (values inhabit declared types, DESIGN section 4b; gunbc.recurring_failure_mode
// generic_formal_containing_a_type_variable_unjudged). The match is first-order over the argument's derived
// type: an Instantiation formal needs an Instantiation argument with the same constructor and arity and
// recurses pairwise; a bare type variable binds its first instance (a later occurrence is judged against
// it, so two different instances refuse); a formal leaf that mentions no variable is left to the judge.
// After matching, the formal is instantiated and handed to the SAME judge every formal uses -- one judge,
// no second inhabitance relation. A constructor or arity mismatch refuses there, typed and located, with
// the judge's own application_argument_does_not_inhabit. An argument whose type is not derived stays the
// counted frontier and binds nothing; a variable inside a shape this match does not open (an Arrow, an
// optional) stays the judge's UndecidableGenericFormal, as before.
type InferFormalMatch
  = InferFormalMatched { instances: List<TypeVariableInstance> }
  | InferFormalShapeMismatch

fn infer_type_variable_binder(t: Node, type_params: List<Symbol>) -> Optional<Symbol> {
  match t.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if count(t.children) == 0 && fold(type_params, init: false, f: fn(acc, p) { acc || (p == id) }) {
        optional_present(value: id)
      } else {
        optional_absent()
      }
    TypeNode { connective: _ } => optional_absent()
    ComputationNode { behavior: _ } => optional_absent()
  }
}

fn infer_match_generic_formal(formal: Node, produced: Node, type_params: List<Symbol>, instances: List<TypeVariableInstance>, declarations: SymbolIndex) -> InferFormalMatch {
  match infer_type_variable_binder(t: formal, type_params: type_params) {
    Present { value: binder } =>
      match type_variable_instance_lookup(instances: instances, binder: binder) {
        Present { value: _ } => InferFormalMatched { instances: instances }
        Absent => InferFormalMatched { instances: list_snoc_item(xs: instances, item: TypeVariableInstance { binder: binder, instance: produced }) }
      }
    Absent =>
      match formal.kind {
        TypeNode { connective: Instantiation } =>
          match produced.kind {
            TypeNode { connective: Instantiation } =>
              let f = infer_type_head_and_args(t: formal)
              let p = infer_type_head_and_args(t: produced)
              if length(xs: f.args) != length(xs: p.args) {
                InferFormalShapeMismatch
              } else if inhabitance_node_mentions_type_variable(n: f.head, type_variables: type_params) {
                InferFormalMatched { instances: instances }
              } else if !infer_type_equal_ignoring_provenance(a: f.head, b: p.head) {
                InferFormalShapeMismatch
              } else {
                fold(zip_map(a: f.args, b: p.args, f: fn(fa, pa) { InferTypePair { formal: fa, produced: pa } }), init: InferFormalMatched { instances: instances }, f: fn(acc, pair) {
                  match acc {
                    InferFormalShapeMismatch => acc
                    InferFormalMatched { instances: so_far } => infer_match_generic_formal(formal: pair.formal, produced: pair.produced, type_params: type_params, instances: so_far, declarations: declarations)
                  }
                })
              }
            TypeNode { connective: _ } => InferFormalShapeMismatch
            ComputationNode { behavior: _ } => InferFormalShapeMismatch
          }
        TypeNode { connective: _ } => InferFormalMatched { instances: instances }
        ComputationNode { behavior: _ } => InferFormalMatched { instances: instances }
      }
  }
}

// A TRANSPARENT ALIAS IS ITS RIGHT-HAND SIDE. `type List<T> = std.algebra.FreeMonoid<T>` is one type under two
// spellings. The head that names a transparent alias unfolds one step -- its declaration read from the index the
// obligation's producer holds (a TypeAlias wrapper, v2.std.type_binder type_decl_view), its binders
// instantiated at the use's arguments. A refinement or brand does not unfold (infer_alias_is_refined); a
// generic, opaque or plain declaration is not an alias. Resolution refuses an alias cycle (ExpectedHead), so
// the unfolding terminates.
fn infer_type_alias_unfolded(t: Node, declarations: SymbolIndex) -> Optional<Node> {
  let ha = infer_type_head_and_args(t: t)
  match declaration_reference_path_optional(node: ha.head) {
    Absent => optional_absent()
    Present { value: path } =>
      match symbol_index_lookup(index: declarations, qualified_path: path) {
        Absent => optional_absent()
        Present { value: declared } =>
          match type_decl_view(target: declared) {
            TypeAlias { binders: _, aliased: aliased } =>
              if infer_alias_is_refined(declared: declared, aliased: aliased) {
                optional_absent()
              } else {
              let params = type_param_names(n: declared)
              if length(xs: params) != length(xs: ha.args) {
                optional_absent()
              } else {
                optional_present(value: infer_type_instantiated(t: aliased, instances: zip_map(a: params, b: ha.args, f: fn(p, a) { TypeVariableInstance { binder: p, instance: a } })))
              }
              }
            GenericTypeDecl { binders: _, member: _ } => optional_absent()
            OpaqueTypeDecl { binders: _ } => optional_absent()
            PlainTypeDecl { member: _ } => optional_absent()
          }
      }
  }
}

// A TYPE WITH EVERY TRANSPARENT ALIAS UNFOLDED, at its head and inside every Instantiation argument: the ONE
// alias rule, applied by the producer of every DeclaredTypeObligation (infer_judge_declared_position) to both the
// declared and the produced type, so every declared position -- argument, return, record field, let annotation,
// binder default -- and both the plain and the generic routes see one type per alias family (review 75435;
// calm-boar-904, option 1). v2.std.inhabitance holds no index, so the reading is supplied by the producer,
// exactly as produced_declared_carrier is.
fn infer_type_alias_normalized(t: Node, declarations: SymbolIndex) -> Node {
  match infer_type_alias_unfolded(t: t, declarations: declarations) {
    Present { value: unfolded } => infer_type_alias_normalized(t: unfolded, declarations: declarations)
    Absent =>
      match t.kind {
        TypeNode { connective: Instantiation } =>
          Node {
            kind: t.kind,
            children: fold(t.children, init: Empty, f: fn(acc, e) {
              list_snoc_item(xs: acc, item: Edge { label: e.label, target: infer_type_alias_normalized(t: e.target, declarations: declarations) })
            }),
            occurrence_id: t.occurrence_id
          }
        TypeNode { connective: _ } => t
        ComputationNode { behavior: _ } => t
      }
  }
}

// A REFINED ARGUMENT MATCHES THROUGH ITS DECLARED CARRIER, by the judge's own subsumption fact. The judge
// widens a produced refinement to the carrier its declaration states (refinement_declared_carrier, one
// step, never walked) after an exact comparison refuses; the generic match asks the SAME fact on a shape
// mismatch, so `type Ns = List<Int> where nonempty` at `xs: List<T>` binds T to Int exactly as it would
// inhabit a declared `List<Int>`. A mismatch is refused only when neither the argument nor its declared
// carrier matches. Routing a mismatch to the judge with T still unbound would not decide it: a formal that
// mentions a type variable is UndecidableGenericFormal there, which re-admits `g(1)` at `List<T>`.
fn infer_match_generic_formal_or_carrier(formal: Node, produced: Node, type_params: List<Symbol>, instances: List<TypeVariableInstance>, declarations: SymbolIndex) -> InferFormalMatch {
  match infer_match_generic_formal(formal: formal, produced: produced, type_params: type_params, instances: instances, declarations: declarations) {
    InferFormalMatched { instances: matched } => InferFormalMatched { instances: matched }
    InferFormalShapeMismatch =>
      match refinement_declared_carrier(index: declarations, source_type: produced) {
        Present { value: carrier } => infer_match_generic_formal(formal: formal, produced: infer_type_alias_normalized(t: carrier, declarations: declarations), type_params: type_params, instances: instances, declarations: declarations)
        Absent => InferFormalShapeMismatch
      }
  }
}

// THE ONE PRODUCER OF A DeclaredTypeObligation in infer: every obligation -- a call argument, a declared return, a
// fold member or carrier, a generic formal -- is built here, so the ONE alias rule (infer_type_alias_normalized)
// reaches every judgment: the declared type, the produced type and the produced type's refinement carrier are
// all presented with transparent aliases unfolded. The carrier is READ from the produced type as written (a
// refinement is never unfolded, so its declaration is still the one found), then normalized like the rest.
fn infer_declared_type_obligation(
  position: DeclaredTypePosition,
  parameter_identity: Symbol,
  declared: Node,
  produced: Node,
  application: Node,
  type_variables: List<Symbol>,
  declarations: SymbolIndex
) -> DeclaredTypeObligation {
  DeclaredTypeObligation {
    position: position,
    parameter_identity: parameter_identity,
    declared: infer_type_alias_normalized(t: declared, declarations: declarations),
    produced: infer_type_alias_normalized(t: produced, declarations: declarations),
    produced_declared_carrier: match refinement_declared_carrier(index: declarations, source_type: produced) {
      Present { value: c } => Present { value: infer_type_alias_normalized(t: c, declarations: declarations) }
      Absent => Absent
    },
    application: application,
    type_variables: type_variables
  }
}

// A REFINEMENT IS NOT A TRANSPARENT ALIAS. `type Pos = Int where positive` -- and a nominal brand, which is
// spelled the same way (`where brand(..)`, std.types WherePredicateMarker) -- denotes a type distinct from its
// carrier, so it never unfolds: normalizing it would admit a raw carrier where the refined or branded type is
// declared (silent widening). Its carrier is reached only by the judge's one-step subsumption
// (refinement_declared_carrier), in the widening direction alone.
fn infer_alias_is_refined(declared: Node, aliased: Node) -> Bool {
  match refinement_declaration_of_node(decl: declared) {
    Present { value: _ } => true
    Absent =>
      match refinement_declaration_of_node(decl: aliased) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

type InferTypePair {
  formal: Node
  produced: Node
}

// A formal with each bound type variable replaced by its instance; an unbound one stays as written.
fn infer_type_instantiated(t: Node, instances: List<TypeVariableInstance>) -> Node {
  fold_node(
    n: t,
    algebra: NodeFold {
      init: fn(self) {
        match self.kind {
          TypeNode { connective: Atom { identity: id } } =>
            if count(self.children) == 0 {
              match type_variable_instance_lookup(instances: instances, binder: id) {
                Present { value: instance } => instance
                Absent => Node { kind: self.kind, children: [], occurrence_id: self.occurrence_id }
              }
            } else {
              Node { kind: self.kind, children: [], occurrence_id: self.occurrence_id }
            }
          TypeNode { connective: _ } => Node { kind: self.kind, children: [], occurrence_id: self.occurrence_id }
          ComputationNode { behavior: _ } => Node { kind: self.kind, children: [], occurrence_id: self.occurrence_id }
        }
      },
      step: fn(acc, edge, sub) {
        Node {
          kind: acc.kind,
          children: list_snoc_item(xs: acc.children, item: Edge { label: edge.label, target: sub }),
          occurrence_id: acc.occurrence_id
        }
      }
    }
  )
}

fn infer_judge_generic_formal(
  position: DeclaredTypePosition,
  application: Node,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  formal: InhabitanceFormal,
  arg: Node,
  type_params: List<Symbol>,
  instances: List<TypeVariableInstance>
) -> Outcome<List<TypeVariableInstance>> {
  let produced_optional = match lookup_inferred_facts_in_entries(entries: entries, key: arg) {
    Absent => optional_absent()
    Present { value: facts } =>
      match inferred_facts_resolved_type(facts: facts) {
        Violates { diagnostic: _ } => optional_absent()
        Holds { value: produced } => optional_present(value: produced)
      }
  }
  match produced_optional {
    Absent =>
      match infer_inhabitance_undecidable_accepted(application: application, reason: undecidable_argument_type_not_derived()) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: _, diagnostics: d } => Accepted { value: instances, diagnostics: d }
      }
    Present { value: produced } =>
      match infer_match_generic_formal_or_carrier(formal: infer_type_alias_normalized(t: formal.declared, declarations: declarations), produced: infer_type_alias_normalized(t: produced, declarations: declarations), type_params: type_params, instances: instances, declarations: declarations) {
        InferFormalShapeMismatch =>
          outcome_rejected(
            application_argument_does_not_inhabit_diagnostic(
              obligation: infer_declared_type_obligation(position: position, parameter_identity: formal.parameter_identity, declared: infer_declared_type_denotation(declared: infer_type_instantiated(t: formal.declared, instances: instances)), produced: produced, application: application, type_variables: type_params, declarations: declarations),
              find_witness_reason: ^find_witness_reason_no_candidate
            )
          )
        InferFormalMatched { instances: matched } =>
          match infer_judge_declared_position(
            position: position,
            application: application,
            entries: entries,
            declarations: declarations,
            formal: InhabitanceFormal { parameter_identity: formal.parameter_identity, declared: infer_type_instantiated(t: formal.declared, instances: matched) },
            produced_at: arg,
            type_params: type_params
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: _, diagnostics: d } => Accepted { value: matched, diagnostics: d }
          }
      }
  }
}

// A FORMAL DECLARED AS ONE OF THE CALLEE'S TYPE PARAMETERS IS INSTANTIATED, NOT COMPARED. Judged as
// an ordinary declared type, `x: T` would demand the argument's type be structurally the Atom `T`
// and refuse every real argument application_argument_does_not_inhabit -- a loud refusal for the
// wrong reason. Instead the first derived argument at a type variable instantiates it for THIS
// application, and every later occurrence must inhabit that instance through the same
// declared_type_inhabitance fold an ordinary formal uses. An argument whose type is not derived
// stays the counted frontier it is for any formal, and instantiates nothing.
fn infer_judge_application_argument_instantiating(
  position: DeclaredTypePosition,
  application: Node,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  formal: InhabitanceFormal,
  arg: Node,
  type_params: List<Symbol>,
  instances: List<TypeVariableInstance>
) -> Outcome<List<TypeVariableInstance>> {
  match inhabitance_formal_declaration(declared: formal.declared, type_params: type_params) {
    DeclaredType { declared: declared } =>
      if inhabitance_node_mentions_type_variable(n: declared, type_variables: type_params) {
        infer_judge_generic_formal(position: position, application: application, entries: entries, declarations: declarations, formal: formal, arg: arg, type_params: type_params, instances: instances)
      } else {
        match infer_judge_declared_position(position: position, application: application, entries: entries, declarations: declarations, formal: formal, produced_at: arg, type_params: type_params) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: _, diagnostics: d } => Accepted { value: instances, diagnostics: d }
        }
      }
    DeclaredTypeVariable { binder: binder } =>
      match type_variable_instance_lookup(instances: instances, binder: binder) {
        Present { value: instance } =>
          match infer_judge_declared_position(
            position: position,
            application: application,
            entries: entries,
            declarations: declarations,
            formal: InhabitanceFormal { parameter_identity: formal.parameter_identity, declared: instance },
            produced_at: arg,
            type_params: type_params
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: _, diagnostics: d } => Accepted { value: instances, diagnostics: d }
          }
        Absent =>
          match lookup_inferred_facts_in_entries(entries: entries, key: arg) {
            Absent =>
              match infer_inhabitance_undecidable_accepted(application: application, reason: undecidable_argument_type_not_derived()) {
                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                Accepted { value: _, diagnostics: d } => Accepted { value: instances, diagnostics: d }
              }
            Present { value: facts } =>
              match inferred_facts_resolved_type(facts: facts) {
                Violates { diagnostic: _ } =>
                  match infer_inhabitance_undecidable_accepted(application: application, reason: undecidable_argument_type_not_derived()) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: _, diagnostics: d } => Accepted { value: instances, diagnostics: d }
                  }
                Holds { value: produced } =>
                  Accepted {
                    value: list_snoc_item(xs: instances, item: TypeVariableInstance { binder: binder, instance: produced }),
                    diagnostics: None
                  }
              }
          }
      }
  }
}

// THE SITE'S INSTANTIATION IS KEPT, NOT DISCARDED. Each Transform actual extends
// InferGatherFoldAcc.application_instances once (infer_gather_extend_application_instances);
// this row seeds infer_judge_formal_args with that list rather than recomputing the prefix.
// The result step reads the same instantiation (infer_application_result_type). An unresolved
// formal set judges nothing and binds no instance.
fn infer_application_argument_inhabitance(
  node: Node,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  instances: List<TypeVariableInstance>
) -> Outcome<List<TypeVariableInstance>> {
  match infer_application_formals(node: node, entries: entries) {
    FormalsUnresolved =>
      match infer_inhabitance_undecidable_accepted(
        application: node,
        reason: undecidable_formal_unresolved()
      ) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: _, diagnostics: d } =>
          Accepted { value: infer_no_type_variable_instances(), diagnostics: d }
      }
    FormalsOrderRefused { reason: reason } =>
      outcome_rejected(application_parameter_order_diagnostic(application: node, reason: reason))
    FormalsInDeclaredOrder { formals: formals } =>
      match infer_application_formal_args(node: node, formals: formals, entries: entries) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: _, diagnostics: _ } =>
          match infer_judge_formal_args(
            position: position_direct_call_argument(),
            site: JudgedAtApplication { application: node },
            entries: entries,
            declarations: declarations,
            pairs: [],
            type_params: infer_application_type_params(node: node, entries: entries),
            instances: instances
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: judged, diagnostics: d } => Accepted { value: judged, diagnostics: d }
          }
      }
  }
}

// EVERY FORMAL-ACTUAL PAIR OF ONE SITE, JUDGED IN ORDER UNDER ONE INSTANTIATION. An application's
// arguments at its callee's formals and a record construct's field values at the record's declared
// fields are the same walk: each pair goes to infer_judge_application_argument_instantiating, the
// first derived actual at a declared type variable instantiates it for this site, and the instances
// the walk ends with are the site's instantiation. The site says where a pair's verdict is located:
// an application's obligations are located at the application, a construct's at the field value
// they judge.
type InferJudgedSite
  = JudgedAtApplication { application: Node }
  | JudgedAtEachActual

fn infer_judged_site_node(site: InferJudgedSite, actual: Node) -> Node {
  match site {
    JudgedAtApplication { application: application } => application
    JudgedAtEachActual => actual
  }
}

fn infer_judge_formal_args(
  position: DeclaredTypePosition,
  site: InferJudgedSite,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  pairs: List<InhabitanceFormalArg>,
  type_params: List<Symbol>,
  instances: List<TypeVariableInstance>
) -> Outcome<List<TypeVariableInstance>> {
  fold(
    pairs,
    init: Accepted { value: instances, diagnostics: None },
    f: fn(acc, pair) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: instances, diagnostics: pd } =>
          match infer_judge_application_argument_instantiating(
            position: position,
            application: infer_judged_site_node(site: site, actual: pair.arg),
            entries: entries,
            declarations: declarations,
            formal: pair.formal,
            arg: pair.arg,
            type_params: type_params,
            instances: instances
          ) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: next, diagnostics: jd } =>
              Accepted {
                value: next,
                diagnostics: diagnostics_merge(outer: pd, inner: jd)
              }
          }
      }
    }
  )
}

// EACH FORMAL WITH THE ACTUAL THAT FILLS IT, from the one binding plan
// (v2.std.arrow_signature application_binding_plan): positional actuals fill declared slots
// in declared order, named actuals fill the slot of their name. Formals and plan slots are both in
// declared order, so they pair one to one. A plan refusal -- surplus, deficit, unknown label, a slot
// bound twice -- refuses here, located at the actual it names (the application itself when the plan
// names no actual). This replaces a zip of stored formals with positional children by index, which
// ignored every name (gunbc#12054).
// THE ARROW IS READ THROUGH THE CALLEE'S FACTS, THE SAME WAY ITS FORMALS WERE. This read used the
// facts-blind reader while its caller's formals came from infer_application_callee_arrow_with_facts,
// so a NAMED call -- whose callee is a resolved declaration reference, a Conj and never an Arrow --
// answered Absent here and returned NO formal/actual pairs. The inhabitance fold over an empty list
// accepts unconditionally, so every argument of every named call went unjudged: a Bool actual filled
// an Int formal and the application typed past it. Nothing reported it, because the two readers
// disagreed about the same question. ONE reader now answers it for both, so the formals a caller
// admitted and the plan that binds them come from the same arrow or from neither.
//
// WHY THE FAIL-OPEN WAS INVISIBLE: the application's RESULT typing read the same arrow through
// infer_arrow_declared_return_type, which was itself failing on a declaration whose return atom was
// the authored spelling rather than a resolved binding -- so the call never grounded, and the negative
// control asserting that an invalid-argument call does not ground passed for the wrong reason. Fixing
// the declaration lookup to read resolved bodies removed the mask and the control went red, which is
// how the fail-open surfaced at all.
fn infer_application_formal_args(
  node: Node,
  formals: List<InhabitanceFormal>,
  entries: List<InferredFactsEntry>,
) -> Outcome<List<InhabitanceFormalArg>> {
  let actuals = application_actual_edges(site: node)
  match infer_application_callee_arrow_with_facts(node: node, entries: entries) {
    Absent => outcome_accepted(value: Empty)
    Present { value: arrow } =>
      match application_binding_plan(arrow: arrow, actuals: actuals) {
        ApplicationBindingRefused { reason: reason, at: at } =>
          outcome_rejected(
            application_parameter_order_diagnostic(
              application: match list_at_optional(xs: actuals, index: at) {
                Present { value: e } => e.target
                Absent => node
              },
              reason: reason
            )
          )
        ApplicationBound { slots: slots } =>
          if (length(xs: slots) == length(xs: formals)) && (length(xs: slots) == length(xs: actuals)) {
            outcome_accepted(value: infer_formal_args_by_plan(formals: formals, slots: slots, actuals: actuals))
          } else {
            outcome_rejected(
              application_parameter_order_diagnostic(application: node, reason: application_parameter_order_malformed_reason())
            )
          }
      }
  }
}

// THE PLAN IS A BIJECTION, SO PAIRING IS TWO ZIPS AND A SORT. Formals and plan slots are both in
// declared order, so they pair one to one; sorting those pairs by the authored index of the actual
// each slot names puts them in authored order, which pairs one to one with the actuals (surplus and
// deficit already refused in the plan). O(n log n), with no lookup per slot. Every fold and zip takes
// a typed parameter, so the emitter types its elements.
type InferSlotFormal {
  formal: InhabitanceFormal
  actual_index: Int
}

fn infer_slot_formal_index_key(p: InferSlotFormal) -> Int {
  p.actual_index
}

fn infer_slot_formal_of(formal: InhabitanceFormal, slot: ApplicationSlot) -> InferSlotFormal {
  InferSlotFormal { formal: formal, actual_index: slot.actual_index }
}

fn infer_formal_arg_of(p: InferSlotFormal, e: Edge) -> InhabitanceFormalArg {
  InhabitanceFormalArg { formal: p.formal, arg: e.target }
}

fn infer_slot_formals(formals: List<InhabitanceFormal>, slots: List<ApplicationSlot>) -> List<InferSlotFormal> {
  zip_map(a: formals, b: slots, f: infer_slot_formal_of)
}

fn infer_formal_args_by_authored_actuals(pairs: List<InferSlotFormal>, actuals: List<Edge>) -> List<InhabitanceFormalArg> {
  zip_map(a: pairs, b: actuals, f: infer_formal_arg_of)
}

fn infer_formal_args_by_plan(formals: List<InhabitanceFormal>, slots: List<ApplicationSlot>, actuals: List<Edge>) -> List<InhabitanceFormalArg> {
  infer_formal_args_by_authored_actuals(
    pairs: sort_by(infer_slot_formals(formals: formals, slots: slots), infer_slot_formal_index_key),
    actuals: actuals
  )
}

fn infer_transform_binary_infix(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree,
) -> Outcome<InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
      Present { value: op_target } =>
        match list_at_optional(xs: positional_targets, index: 1) {
          Absent => outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
          Present { value: left_target } =>
            match list_at_optional(xs: positional_targets, index: 2) {
              Absent => outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
              Present { value: right_target } =>
                match infer_binary_algebra_field(op_node: op_target) {
                  Absent => outcome_rejected(infer_transform_operator_unsupported_diagnostic(node: node))
                  Present { value: field } =>
                  match lookup_inferred_facts_in_entries(entries: entries, key: left_target) {
                    Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: left_target))
                    Present { value: left_facts } =>
                      match lookup_inferred_facts_in_entries(entries: entries, key: right_target) {
                        Absent =>
                          outcome_rejected(infer_facts_lookup_miss_diagnostic(key: right_target))
                        Present { value: right_facts } =>
                          match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
                            Rejected { diagnostics: r } => Rejected { diagnostics: r }
                            Accepted { value: _, diagnostics: cd } =>
                              match infer_unify_transform_operand_types(
                                left_node: left_target,
                                left_facts: left_facts,
                                right_node: right_target,
                                right_facts: right_facts,
                                entries: entries,
                                resolved: resolved
                              ) {
                                Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                Accepted { value: unified_type, diagnostics: ud } =>
                                  match infer_algebra_field_result_type(rows: dag_algebra_inhabitance_decls(), operand_type: unified_type, field: field) {
                                    AlgebraFieldNotCarried =>
                                      outcome_rejected(
                                        infer_transform_operand_type_mismatch_diagnostic(node: node)
                                      )
                                    AlgebraFieldRowMalformed { cause: cause } =>
                                      outcome_rejected(Diagnostic {
                                        reason: cause,
                                        at: node_locus(node: node),
                                        correction: Unavailable { reason: CorrectionNotModeled }
                                      })
                                    AlgebraFieldResultType { result: result_type } =>
                                    match infer_descent_witness_for_node(n: node) {
                                      Violates { diagnostic: d } =>
                                        Rejected { diagnostics: diagnostics_singleton(d: d) }
                                      Holds { value: descent_proof } =>
                                        bind_outcome(
                                          o: inferred_facts_from_derived_type(
                                            node: node,
                                            derived_type: result_type,
                                            descent: Holds { value: descent_proof }
                                          ),
                                          f: fn(facts) {
                                            Accepted {
                                              value: facts,
                                              diagnostics: diagnostics_merge(outer: cd, inner: ud)
                                            }
                                          }
                                        )
                                    }
                                  }
                              }
                          }
                      }
                  }
                }
            }
        }
    }
  }
}

fn infer_gather_fold_acc_failed(
  node: Node,
  pending: NonEmptyDiagnostics,
  await_branch_row: Bool,
  await_match_row: Bool,
  await_loop_row: Bool,
  await_transform_row: Bool,
  application_instances: List<TypeVariableInstance>,
  children_remaining: Int,
) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: node,
    entries: empty_inferred_facts_entry_list(),
    failed: true,
    pending: Some { diagnostics: pending },
    await_branch_row: await_branch_row,
    await_match_row: await_match_row,
    await_loop_row: await_loop_row,
    await_transform_row: await_transform_row,
    application_instances: application_instances,
    children_remaining: children_remaining
  }
}

fn infer_gather_fold_acc_ok(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  await_branch_row: Bool,
  await_match_row: Bool,
  await_loop_row: Bool,
  await_transform_row: Bool,
  application_instances: List<TypeVariableInstance>,
  children_remaining: Int,
) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: node,
    entries: entries,
    failed: false,
    pending: pending,
    await_branch_row: await_branch_row,
    await_match_row: await_match_row,
    await_loop_row: await_loop_row,
    await_transform_row: await_transform_row,
    application_instances: application_instances,
    children_remaining: children_remaining
  }
}

fn infer_gather_acc_to_outcome(acc: InferGatherFoldAcc) -> Outcome<List<InferredFactsEntry>> {
  if acc.failed {
    match acc.pending {
      None =>
        Rejected {
          diagnostics: diagnostics_singleton(
            d: infer_canonical_grounding_incoherent_diagnostic(node: infer_gather_fold_failure_node())
          )
        }
      Some { diagnostics: nds } => Rejected { diagnostics: nds }
    }
  } else {
    Accepted {
      value: acc.entries,
      diagnostics: acc.pending
    }
  }
}

fn infer_gather_fold_failure_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^infer_gather_fold_failure } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn infer_gather_branch_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
) -> InferGatherFoldAcc {
  match infer_branch_bool_if_else(node: node, partials: partials, entries: entries) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: node,
            entries: list_snoc_item(xs: entries, item: entry),
            pending: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: d),
              inner: ed
            ),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
      }
  }
}

fn infer_gather_match_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  match infer_match(node: node, partials: partials, entries: entries, resolved: resolved) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: node,
            entries: list_snoc_item(xs: entries, item: entry),
            pending: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: d),
              inner: ed
            ),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
      }
  }
}

fn infer_gather_loop_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
) -> InferGatherFoldAcc {
  match infer_loop_iteration(node: node, partials: partials, entries: entries) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: node,
            entries: list_snoc_item(xs: entries, item: entry),
            pending: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: d),
              inner: ed
            ),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
      }
  }
}

fn infer_gather_transform_frontier_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  instances: List<TypeVariableInstance>,
  binder_types: List<InferBinderType>,
) -> InferGatherFoldAcc {
  match infer_node_facts(n: node, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: node,
            entries: list_snoc_item(xs: entries, item: entry),
            pending: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: d),
              inner: ed
            ),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
      }
  }
}

// THE FREE-MONOID INTRODUCTION: A LIST LITERAL'S ONE INFER CASE. v2 body lowering writes
// `[e1, .., en]` as ONE flat Transform whose head is the reference to std.algebra FreeMonoid's
// declaration and whose remaining positional children are the elements in order
// (v2.std.list_introduction lower_list_introduction, read back by
// list_introduction_elements_optional) -- the flat canonical introduction
// std.literal_elaboration UnicodeScalarSequenceUnfold names, never a cons^n nesting. It is not an
// application: the head is a type, so application-argument inhabitance is not asked of it. Every
// element's type must be one T, compared STRUCTURALLY with provenance stripped (two equal types minted
// at two occurrences are one type, and a list of lists compares its element types whole); the first element that differs refuses located AT that element. The
// literal's type is then FreeMonoid<T>: the Instantiation of the FreeMonoid reference at T. `[]`
// carries no element to derive T from; its type is its boundary's, so it joins the counted
// GroundingNotDerived frontier like every Transform this fold does not derive -- never a guessed T.
// Two element types are one type when they are STRUCTURALLY equal with provenance removed at every
// level -- the same authority the inhabitance judgment decides declared-versus-produced types with
// (v2.std.exact_structural_equality_zip_fold_predicate exact_structural_equality_zip_fold), so a
// list of lists compares its FreeMonoid<T> element types whole rather than as atoms.
fn infer_type_equal_ignoring_provenance(a: Node, b: Node) -> Bool {
  exact_structural_equality_zip_fold(source_facts: a, candidate: b)
}

fn infer_list_element_type(element: Node, entries: List<InferredFactsEntry>, resolved: ResolvedTree) -> Outcome<Node> {
  match lookup_inferred_facts_in_entries(entries: entries, key: element) {
    Absent => outcome_rejected(infer_facts_lookup_miss_diagnostic(key: element))
    Present { value: facts } =>
      match infer_branch_operand_resolved_type_with_entries(node: element, facts: facts, entries: entries, instances: infer_no_type_variable_instances(), resolved: resolved) {
        Violates { diagnostic: d } => outcome_rejected(d)
        Holds { value: t } => outcome_accepted(value: t)
      }
  }
}

// Absent: `[]`, whose T is not derivable here. Present: the elements' one type, or the located
// refusal of the first element that differs.
fn infer_list_elements_unified_type(
  elements: List<Node>,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree
) -> Optional<Outcome<Node>> {
  match elements {
    Empty => Absent
    Cons { head: first, tail: rest } =>
      Present {
        value: bind_outcome(o: infer_list_element_type(element: first, entries: entries, resolved: resolved), f: fn(t) {
          fold(rest, init: outcome_accepted(value: t), f: fn(acc, element) {
            bind_outcome(o: acc, f: fn(unified) {
              bind_outcome(o: infer_list_element_type(element: element, entries: entries, resolved: resolved), f: fn(et) {
                if infer_type_equal_ignoring_provenance(a: unified, b: et) {
                  outcome_accepted(value: unified)
                } else {
                  outcome_rejected(infer_list_element_type_mismatch_diagnostic(element: element))
                }
              })
            })
          })
        })
      }
  }
}

fn infer_freemonoid_type_of(element_type: Node) -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: declaration_reference_node(qn: list_introduction_head_path(), occurrence_id: OccurrenceSynthetic) },
      Edge { label: Positional, target: canonicalize_node_strip_provenance(n: element_type) }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

// Absent: `[]` (frontier). Present: the literal's facts, or a located refusal.
fn infer_transform_freemonoid_introduction(
  node: Node,
  elements: List<Node>,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree
) -> Optional<Outcome<InferredFacts>> {
  match infer_list_elements_unified_type(elements: elements, entries: entries, resolved: resolved) {
    Absent => Absent
    Present { value: unified } =>
      Present {
        value: bind_outcome(o: unified, f: fn(element_type) {
          match infer_descent_witness_for_node(n: node) {
            Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
            Holds { value: descent_proof } =>
              inferred_facts_from_derived_type(
                node: node,
                derived_type: infer_freemonoid_type_of(element_type: element_type),
                descent: Holds { value: descent_proof }
              )
          }
        })
      }
  }
}

fn infer_gather_transform_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  instances: List<TypeVariableInstance>,
) -> InferGatherFoldAcc {
  match list_introduction_elements_optional(node: node) {
    Absent =>
      infer_gather_application_row_on_entries(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, instances: instances)
    Present { value: elements } =>
    match infer_transform_freemonoid_introduction(node: node, elements: elements, entries: entries, resolved: resolved) {
      Absent =>
        infer_gather_transform_frontier_on_entries(node: node, entries: entries, pending: pending, partials: partials, kinds: kinds, resolved: resolved, instances: infer_no_type_variable_instances(), binder_types: infer_no_binder_types())
      Present { value: introduced } =>
        match introduced {
          Rejected { diagnostics: r } =>
            infer_gather_fold_acc_failed(
              node: node,
              pending: rejected_with_pending(pending: pending, rejected: r),
              await_branch_row: false,
              await_match_row: false,
              await_loop_row: false,
              await_transform_row: false,

              application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
            )
          Accepted { value: facts, diagnostics: d } =>
            match admitted_inferred_facts_entry(node: node, facts: facts) {
              Rejected { diagnostics: r } =>
                infer_gather_fold_acc_failed(
                  node: node,
                  pending: rejected_with_pending(pending: pending, rejected: r),
                  await_branch_row: false,
                  await_match_row: false,
                  await_loop_row: false,
                  await_transform_row: false,

                  application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
                )
              Accepted { value: entry, diagnostics: ed } =>
                infer_gather_fold_acc_ok(
                  node: node,
                  entries: list_snoc_item(xs: entries, item: entry),
                  pending: diagnostics_merge(outer: diagnostics_merge(outer: pending, inner: d), inner: ed),
                  await_branch_row: false,
                  await_match_row: false,
                  await_loop_row: false,
                  await_transform_row: false,

                  application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
                )
            }
        }
    }
  }
}

fn infer_gather_application_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
  instances: List<TypeVariableInstance>,
) -> InferGatherFoldAcc {
  match infer_application_argument_inhabitance(node: node, entries: entries, declarations: resolved.resolved_declarations, instances: instances) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
      )
    Accepted { value: instances, diagnostics: id } =>
      let merged_pending = diagnostics_merge(outer: pending, inner: id)
      match infer_transform_derived_optional(
        node: node,
        partials: partials,
        entries: entries,
        resolved: resolved,
        arguments_decided: infer_diagnostics_none(d: id),
        instances: instances
      ) {
        Present { value: derived } =>
        match derived {
          Rejected { diagnostics: r } =>
            infer_gather_fold_acc_failed(
              node: node,
              pending: rejected_with_pending(pending: merged_pending, rejected: r),
              await_branch_row: false,
              await_match_row: false,
              await_loop_row: false,
              await_transform_row: false,

              application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
            )
          Accepted { value: facts, diagnostics: d } =>
            match admitted_inferred_facts_entry(node: node, facts: facts) {
              Rejected { diagnostics: r } =>
                infer_gather_fold_acc_failed(
                  node: node,
                  pending: rejected_with_pending(pending: merged_pending, rejected: r),
                  await_branch_row: false,
                  await_match_row: false,
                  await_loop_row: false,
                  await_transform_row: false,

                  application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
                )
              Accepted { value: entry, diagnostics: ed } =>
                infer_gather_fold_acc_ok(
                  node: node,
                  entries: list_snoc_item(xs: entries, item: entry),
                  pending: diagnostics_merge(
                    outer: diagnostics_merge(outer: merged_pending, inner: d),
                    inner: ed
                  ),
                  await_branch_row: false,
                  await_match_row: false,
                  await_loop_row: false,
                  await_transform_row: false,

                  application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
                )
            }
        }
        Absent =>
        infer_gather_transform_frontier_on_entries(
          node: node,
          entries: entries,
          pending: merged_pending,
          partials: partials,
          kinds: kinds,
          resolved: resolved,
          instances: infer_no_type_variable_instances(),
          binder_types: infer_no_binder_types()
        )
      }
  }
}

// AN ANNOTATED LET IS A DECLARED-TYPE POSITION. `let x: T = e` is Bind[x, e, body] +
// <type-annotation> T (v2.std.type_binder); it awaits its children, then e is judged at T through
// infer_judge_declared_position -- the one relation (v2.std.inhabitance declared_type_inhabitance)
// an argument meets at its formal, a body at its declared return and a field value at its field.
// An ascription converts nothing, so it is not a cast: v2.std.coercion coercion_cast_crossing is the
// relation for the explicit `e as T` form only. The refusal is located at the authored annotation
// and names the bound value (PositionLetAnnotation). A value whose type is not derived stays the counted
// UndecidableArgumentTypeNotDerived frontier, as at every other position. The enclosing fn's type
// parameters are not in scope here, so the obligation carries none: a let annotated with one is
// judged against the type variable's atom as it is spelled.
fn infer_bind_annotation_check(node: Node, entries: List<InferredFactsEntry>, resolved: ResolvedTree) -> Outcome<Bool> {
  match type_annotation_optional(n: node) {
    Absent => outcome_accepted(true)
    Present { value: annotation } =>
      match list_at_optional(xs: node_positional_child_targets(node: node), index: 1) {
        Absent => outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node))
        Present { value: bound } =>
          infer_judge_declared_position(
            position: position_let_annotation(bound: bound),
            application: annotation,
            entries: entries,
            declarations: resolved.resolved_declarations,
            formal: InhabitanceFormal { parameter_identity: ^let_annotation, declared: annotation },
            produced_at: bound,
            type_params: []
          )
      }
  }
}

fn infer_gather_bind_annotation_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  match infer_bind_annotation_check(node: node, entries: entries, resolved: resolved) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
      )
    Accepted { value: _, diagnostics: d } =>
      infer_gather_transform_frontier_on_entries(
        node: node,
        entries: entries,
        pending: diagnostics_merge(outer: pending, inner: d),
        partials: partials,
        kinds: kinds,
        resolved: resolved,
        instances: infer_no_type_variable_instances(),
        binder_types: infer_no_binder_types()
      )
  }
}

// THE TRANSFORMS WHOSE TYPE IS DERIVED, by shape: the binary Int add, and a cast whose operand's
// grounding is derived. Absent is the counted frontier (GroundingNotDerived), never an admission.
fn infer_diagnostics_none(d: Diagnostics) -> Bool {
  match d {
    None => true
    Some { diagnostics: _ } => false
  }
}

// arguments_decided: argument inhabitance returned no counted-undecidable obligation. Arrow
// elimination derives only then -- an application whose argument obligation is still undecided
// stays on the frontier rather than typing past it.
fn infer_transform_derived_optional(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree,
  arguments_decided: Bool,
  instances: List<TypeVariableInstance>,
) -> Optional<Outcome<InferredFacts>> {
  if infer_transform_is_binary_infix_algebra_shape(node: node) {
    optional_present(value: infer_transform_binary_infix(node: node, partials: partials, entries: entries, resolved: resolved))
  } else if infer_transform_is_cast(node: node) {
    infer_transform_cast_optional(node: node, entries: entries, resolved: resolved)
  } else if arguments_decided {
    infer_transform_application_optional(node: node, entries: entries, instances: instances, declarations: resolved.resolved_declarations)
  } else {
    optional_absent()
  }
}

// ARROW ELIMINATION. `f(a)`, where the callee is an Arrow, has the type the Arrow DECLARES it
// returns (infer_arrow_declared_return_type: the return atom as written, never the composed
// evidence). The caller has already admitted argument inhabitance, and the callee must itself be
// derived -- so arrow introduction has checked its body against that return. An underived callee,
// a non-Arrow operator, or a return the language join does not denote stays on the counted
// frontier: Absent here, never an admission.
fn infer_transform_application_optional(
  node: Node,
  entries: List<InferredFactsEntry>,
  instances: List<TypeVariableInstance>,
  declarations: SymbolIndex,
) -> Optional<Outcome<InferredFacts>> {
  match infer_application_callee_arrow_with_facts(node: node, entries: entries) {
    Absent => optional_absent()
    Present { value: arrow } =>
      match infer_application_callee_use(node: node) {
        Absent => optional_absent()
        Present { value: callee_use } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: callee_use) {
        Absent => optional_absent()
        Present { value: arrow_facts } =>
          if !inferred_facts_grounding_derived(facts: arrow_facts) {
            optional_absent()
          } else {
            match infer_application_result_type(arrow: arrow, instances: instances, declarations: declarations) {
              Absent => optional_absent()
              Present { value: return_type } =>
                optional_present(
                  value: match infer_descent_witness_for_node(n: node) {
                    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
                    Holds { value: descent_proof } =>
                      inferred_facts_from_derived_type(
                        node: node,
                        derived_type: return_type,
                        descent: Holds { value: descent_proof }
                      )
                  }
                )
            }
          }
      }
      }
  }
}

// A CAST `e as T` is Transform[coerce, e] + <cast-target> T (v2.std.type_binder). Its type is T, and
// it is admitted only when v2.std.coercion coercion_cast_crossing finds e's derived grounding
// crosses to T; otherwise it refuses with coercion's typed mismatch. An operand whose grounding is
// not derived leaves the cast on the counted frontier -- the crossing is not judged, and it is not
// admitted either.
fn infer_transform_is_cast(node: Node) -> Bool {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
    Present { value: op } =>
      canonical_operation_wire_matches_operation(wire: op, operation: canonical_operation_op_coerce())
    Absent => false
  }
}

fn infer_transform_cast_optional(node: Node, entries: List<InferredFactsEntry>, resolved: ResolvedTree) -> Optional<Outcome<InferredFacts>> {
  if !infer_transform_is_cast(node: node) {
    optional_absent()
  } else {
    match cast_target_optional(n: node) {
      Absent => optional_present(value: outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node)))
      Present { value: target } =>
        match list_at_optional(xs: node_positional_child_targets(node: node), index: 1) {
          Absent => optional_present(value: outcome_rejected(infer_transform_shape_invalid_diagnostic(node: node)))
          Present { value: operand } =>
            match lookup_inferred_facts_in_entries(entries: entries, key: operand) {
              Absent => optional_present(value: outcome_rejected(infer_facts_lookup_miss_diagnostic(key: operand)))
              Present { value: operand_facts } =>
                match operand_facts.grounding {
                  GroundingNotDerived { node: _ } => optional_absent()
                  DerivedGrounding { grounding: g } =>
                    optional_present(value: bind_outcome(
                      o: coercion_cast_crossing(
                        source: g,
                        source_type: g.witness.structural.evidence,
                        source_declared_carrier: refinement_declared_carrier(index: resolved.resolved_declarations, source_type: g.witness.structural.evidence),
                        target: target
                      ),
                      f: fn(crossed) {
                        match infer_descent_witness_for_node(n: node) {
                          Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
                          Holds { value: descent_proof } =>
                            inferred_facts_from_derived_type(
                              node: node,
                              derived_type: crossed.target,
                              descent: Holds { value: descent_proof }
                            )
                        }
                      }
                    ))
                }
            }
        }
    }
  }
}

// This dispatch is TOTAL over the closed node vocabulary (6 connectives + 6 behaviors) with no
// wildcard arm -- the construction half of the wall. The wildcard it replaces let eight kinds fall
// silently into the self-grounding fabrication; enumerating them means a thirteenth kind cannot be
// added without deciding, at this site, whether it derives its type or joins the counted frontier
// -- never defaulted into by omission (DESIGN §4 closed vocabulary, §5 unwritable-by-construction).

fn infer_gather_fold_not_derived(n: Node, partials: List<Node>, kinds: List<RosterKindIndex>, resolved: ResolvedTree, instances: List<TypeVariableInstance>, binder_types: List<InferBinderType>) -> InferGatherFoldAcc {
  infer_gather_transform_frontier_on_entries(
    node: n,
    entries: empty_inferred_facts_entry_list(),
    pending: None,
    partials: partials,
    kinds: kinds,
    resolved: resolved,
    instances: instances,
    binder_types: binder_types
  )
}

// THE CONJ ARM READS A RESOLVED CORPUS-DECLARATION REFERENCE FIRST, BECAUSE IT IS CONJ-SHAPED AND
// NOT A RECORD. Resolution carries a reference to a declaration as its declaring path
// (v2.compiler.resolve resolved_reference_node), a qualified-name spine that shares the Conj
// connective with a product; read as a product it would be typed as a two-field record of its own
// segments, silently. It is exactly what a bare Atom reference was to this fold before the carrier
// -- a grounding this fold does not derive -- and it takes that arm. Deriving the reference's type
// FROM its declaration by path is the end-state the roster lookups above already name as their
// dissolution, not this arm.
fn infer_gather_fold_init(n: Node, partials: List<Node>, kinds: List<RosterKindIndex>, resolved: ResolvedTree, instances: List<TypeVariableInstance>, binder_types: List<InferBinderType>) -> InferGatherFoldAcc {
  match n.kind {
    ComputationNode { behavior: Branch } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_inferred_facts_entry_list(),
        pending: None,
        await_branch_row: true,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Match } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_inferred_facts_entry_list(),
        pending: None,
        await_branch_row: false,
        await_match_row: true,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Loop } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_inferred_facts_entry_list(),
        pending: None,
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: true,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Value } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
    ComputationNode { behavior: Transform } =>
      if length(xs: n.children) == 0 {
        infer_gather_transform_row_on_entries(
          node: n,
          entries: empty_inferred_facts_entry_list(),
          pending: None,
          partials: partials,
          kinds: kinds,
          resolved: resolved,
          instances: infer_no_type_variable_instances()
        )
      } else {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_inferred_facts_entry_list(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: true,

          application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
        )
      }
    ComputationNode { behavior: Bind } =>
      if infer_bind_encodes_collection_fold(bind: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_inferred_facts_entry_list(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,

          application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
        )
      } else {
      match type_annotation_optional(n: n) {
        Present { value: _ } =>
          infer_gather_fold_acc_ok(
            node: n,
            entries: empty_inferred_facts_entry_list(),
            pending: None,
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
          )
        Absent => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
      }
      }
    TypeNode { connective: Atom { identity: _ } } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
    TypeNode { connective: Conj } =>
      match declaration_reference_path_optional(node: n) {
        Present { value: _ } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
        Absent =>
      match parameter_reference_path_optional(node: n) {
        Present { value: _ } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
        Absent =>
      match lexical_reference_label_optional(node: n) {
        Present { value: _ } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
        Absent =>
      if infer_type_node_awaits_product_row(kinds: kinds, n: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_inferred_facts_entry_list(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,

          application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
        )
      } else {
        infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
      }
      }
      }
      }
    TypeNode { connective: Disj } =>
      if infer_disj_is_named_sum(n: n) && !infer_node_declared_in_language_inhabitants_bool(kinds: kinds, n: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_inferred_facts_entry_list(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,

          application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
        )
      } else {
        infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
      }
    TypeNode { connective: Arrow } =>
      if infer_type_node_awaits_product_row(kinds: kinds, n: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_inferred_facts_entry_list(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: false,

          application_instances: infer_no_type_variable_instances(),
        children_remaining: length(xs: n.children)
        )
      } else {
        infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
      }
    TypeNode { connective: Cardinality } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
    TypeNode { connective: Instantiation } => infer_gather_fold_not_derived(n: n, partials: partials, kinds: kinds, resolved: resolved, instances: instances, binder_types: binder_types)
  }
}

fn infer_gather_failed_non_empty(acc: InferGatherFoldAcc) -> NonEmptyDiagnostics {
  match acc.pending {
    Some { diagnostics: nds } => nds
    None =>
      diagnostics_singleton(
        d: infer_canonical_grounding_incoherent_diagnostic(node: infer_gather_fold_failure_node())
      )
  }
}

// WHICH LITERAL FAMILY OWNS A PAYLOAD EDGE. An integer literal's type derives from its canonical
// representation, including its sole named magnitude subtree; a symbol literal's sole named name
// payload is its value, not a reference. Each derivation discharges only that edge's local type
// frontier (propagating it past the literal would report GroundingNotDerived after the literal was
// derived), and the payload's FACTS follow the same family: the decision is typed, so the payload
// fold below is told whose payload it is rather than assuming the integer shape (review 5348050288
// on #12549, where a Symbol name atom was typed DecimalDigit). Boolean literals are canonical only
// with no children, so no boolean payload can be discharged. Malformed literals remain
// GroundingNotDerived and retain every child diagnostic.
type InferLiteralPayload
  = InferIntMagnitudePayload
  | InferSymbolNamePayload
  | InferStringValuePayload
  | InferNotALiteralPayload

fn infer_literal_edge_payload(parent: Node, edge: Edge) -> InferLiteralPayload {
  match dag_canonical_literal_from_node(node: parent) {
    Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
      match edge.label {
        StructuralLabel { label: _ } => InferNotALiteralPayload
        Authored { name: field } =>
          if field == ^integer_literal_magnitude_field { InferIntMagnitudePayload } else { InferNotALiteralPayload }
        Positional => InferNotALiteralPayload
      }
    Accepted { value: DagCanonicalSymbolLiteral { symbol: _ }, diagnostics: _ } =>
      match edge.label {
        Authored { name: field } =>
          if field == ^symbol_literal_name_field { InferSymbolNamePayload } else { InferNotALiteralPayload }
        StructuralLabel { label: _ } => InferNotALiteralPayload
        Positional => InferNotALiteralPayload
      }
    Accepted { value: DagCanonicalBoolLiteral { value: _ }, diagnostics: _ } => InferNotALiteralPayload
    Accepted { value: DagCanonicalStringLiteral { value: _ }, diagnostics: _ } =>
      match edge.label {
        Authored { name: field } =>
          if field == ^string_literal_value_field { InferStringValuePayload } else { InferNotALiteralPayload }
        StructuralLabel { label: _ } => InferNotALiteralPayload
        Positional => InferNotALiteralPayload
      }
    Rejected { diagnostics: _ } => InferNotALiteralPayload
  }
}

// THE EMPTY DOMAIN OF A NULLARY ARROW IS THE EMPTY PRODUCT, AND IT IS GROUNDED BY THE ARROW'S
// POSITION, NOT BY ITS OWN SHAPE. body_lower_domain_from_param_list lowers `fn f()` to an Arrow
// whose domain is a childless Conj: the product of zero parameters. Its resolved type is what
// product introduction yields over zero children, the empty product: a fresh synthetic childless
// Conj. The domain lowering produces carries its parameter list's occurrence, so it is never the
// same node as that evidence. A domain that IS structurally the empty product (a synthetic
// childless Conj) meets the self-evidence wall in canonical_grounding_from_derived_type, and infer
// refuses it rather than typing a node as itself. The standalone childless-Conj rule deliberately
// still refuses (v2.test.execution.infer_product_introduction
// product_introduction_leaves_childless_conj_on_the_frontier_holds): a childless Conj elsewhere
// is not known to be a product of anything, and parse residue has that shape too. What this adds
// is the one position whose meaning the Arrow fixes: its first child, the domain. Before
// 2026-09-23 every nullary fn stayed on the frontier through its domain, so the Arrow and every
// enclosing member did too, and gen-one's translate gate refused it.
fn infer_arrow_empty_domain_edge(parent: Node, edge: Edge, children_remaining: Int) -> Bool {
  match parent.kind {
    TypeNode { connective: Arrow } =>
      (children_remaining == length(xs: parent.children))
        && (edge.label == Positional)
        && (length(xs: edge.target.children) == 0)
        && (match edge.target.kind {
          TypeNode { connective: Conj } => true
          TypeNode { connective: Atom { identity: _ } } => false
          TypeNode { connective: Disj } => false
          TypeNode { connective: Arrow } => false
          TypeNode { connective: Cardinality } => false
          TypeNode { connective: Instantiation } => false
          ComputationNode { behavior: _ } => false
        })
    TypeNode { connective: Atom { identity: _ } } => false
    TypeNode { connective: Conj } => false
    TypeNode { connective: Disj } => false
    TypeNode { connective: Cardinality } => false
    TypeNode { connective: Instantiation } => false
    ComputationNode { behavior: _ } => false
  }
}

fn infer_empty_product_entry(domain: Node) -> Outcome<InferredFactsEntry> {
  bind_outcome(
    o: inferred_facts_from_derived_type(
      node: domain,
      derived_type: Node {
        kind: TypeNode { connective: Conj },
        children: [],
        occurrence_id: OccurrenceSynthetic
      },
      descent: infer_descent_witness_for_node(n: domain)
    ),
    f: fn(facts) { admitted_inferred_facts_entry(node: domain, facts: facts) }
  )
}

// THE PAYLOAD'S FACTS FOLLOW THE DISCHARGE ABOVE, OR THE TWO DISAGREE. The literal's derivation
// already drops its magnitude subtree's frontier DIAGNOSTICS, and until 2026-09-23 it left that
// subtree's FACTS at GroundingNotDerived. Translate reads facts, not diagnostics, so the payload of
// every accepted int literal (its digit atoms and cons cells) refused emission at
// translate_rejected_grounding_not_derived: gen-one could not emit `data x: Int = 606060`, nor
// `fn f() -> Int { 606060 }`. The payload is the integer authority's canonical decimal
// representation (v2.std.integer integer_decimal_magnitude_node): a fold_list_node of digit atoms.
// So each payload node derives with ITS OWN TYPE in that authority as the resolved type: a digit
// atom is a DecimalDigit (integer_decimal_digit_type_node), and a cons cell or the empty tail is a
// FreeMonoid<DecimalDigit> (integer_decimal_digits_type_node). A symbol literal's payload is its
// name terminal, one childless atom whose identity IS the symbol, so it derives as v2.std.node
// Symbol (symbol_type_node) and never as a digit. The family is the typed InferLiteralPayload the
// edge decision returns, never inferred from the member's shape. The resolved-type field
// is never given the enclosing literal as a record of where the node came from (a meaning fork the
// first cut of this rule had). A payload node of any other shape stays on the frontier. Only the
// edge infer_literal_edge_payload assigns a family reaches here, so a malformed literal keeps
// every child on the frontier.
fn infer_literal_payload_member_type(family: InferLiteralPayload, member: Node) -> Optional<Node> {
  match family {
    InferIntMagnitudePayload =>
      match member.kind {
        TypeNode { connective: Atom { identity: _ } } =>
          optional_present(value: integer_decimal_digit_type_node())
        TypeNode { connective: Conj } =>
          optional_present(value: integer_decimal_digits_type_node())
        TypeNode { connective: Disj } => optional_absent()
        TypeNode { connective: Arrow } => optional_absent()
        TypeNode { connective: Cardinality } => optional_absent()
        TypeNode { connective: Instantiation } => optional_absent()
        ComputationNode { behavior: _ } => optional_absent()
      }
    InferSymbolNamePayload =>
      match member.kind {
        TypeNode { connective: Atom { identity: _ } } =>
          if length(xs: member.children) == 0 { optional_present(value: symbol_type_node()) } else { optional_absent() }
        TypeNode { connective: Conj } => optional_absent()
        TypeNode { connective: Disj } => optional_absent()
        TypeNode { connective: Arrow } => optional_absent()
        TypeNode { connective: Cardinality } => optional_absent()
        TypeNode { connective: Instantiation } => optional_absent()
        ComputationNode { behavior: _ } => optional_absent()
      }
    InferStringValuePayload =>
      match member.kind {
        TypeNode { connective: Atom { identity: _ } } =>
          if length(xs: member.children) == 0 { optional_present(value: host_text_type_node()) } else { optional_absent() }
        _ => optional_absent()
      }
    InferNotALiteralPayload => optional_absent()
  }
}

fn infer_literal_payload_member_facts(family: InferLiteralPayload, member: Node) -> Outcome<InferredFacts> {
  match infer_literal_payload_member_type(family: family, member: member) {
    Present { value: member_type } =>
      inferred_facts_from_derived_type(
        node: member,
        derived_type: member_type,
        descent: infer_descent_witness_for_node(n: member)
      )
    Absent =>
      inferred_facts_not_derived(node: member, descent: infer_descent_witness_for_node(n: member))
  }
}

fn infer_literal_payload_entries(family: InferLiteralPayload, payload: Node) -> Outcome<List<InferredFactsEntry>> {
  fold(
    node_subtree_nodes(root: payload),
    init: Accepted { value: empty_inferred_facts_entry_list(), diagnostics: None },
    f: fn(acc, member) {
      bind_outcome(
        o: acc,
        f: fn(entries) {
          bind_outcome(
            o: infer_literal_payload_member_facts(family: family, member: member),
            f: fn(facts) {
              bind_outcome(
                o: admitted_inferred_facts_entry(node: member, facts: facts),
                f: fn(entry) {
                  outcome_accepted(value: list_snoc_item(xs: entries, item: entry))
                }
              )
            }
          )
        }
      )
    }
  )
}

fn infer_gather_acc_awaits_product_row(node: Node, entries: List<InferredFactsEntry>) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: node) {
        Absent => true
        Present { value: _ } => false
      }
    TypeNode { connective: Arrow } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: node) {
        Absent => true
        Present { value: _ } => false
      }
    TypeNode { connective: Disj } =>
      match lookup_inferred_facts_in_entries(entries: entries, key: node) {
        Absent => true
        Present { value: _ } => false
      }
    TypeNode { connective: Atom { identity: _ } } => false
    TypeNode { connective: Cardinality } => false
    TypeNode { connective: Instantiation } => false
    ComputationNode { behavior: _ } => false
  }
}

fn infer_gather_product_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  infer_gather_formed_facts_row(
    node: node,
    formed: infer_formation_facts_from_entries(
      node: node,
      entries: entries,
      partials: partials,
      resolved: resolved
    ),
    entries: entries,
    pending: pending
  )
}

// THE ROW A FORMED NODE ENTERS BY: its facts are admitted and appended, or the node fails with the
// refusal. Product introduction and record introduction form their facts differently and enter the
// same way.
fn infer_gather_formed_facts_row(
  node: Node,
  formed: Outcome<InferredFacts>,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
) -> InferGatherFoldAcc {
  match formed {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: node,
            entries: list_snoc_item(xs: entries, item: entry),
            pending: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: d),
              inner: ed
            ),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
      }
  }
}

// A PAYLOADLESS ALTERNATIVE IS THE EMPTY PRODUCT, AND IT IS GROUNDED BY ITS SUM, NOT BY ITS OWN
// SHAPE. A coproduct lowers to a Disj whose Named arms carry each alternative's payload, and a
// nullary alternative (`Allowed`) carries a childless Conj: the product of zero fields. The Disj fixes
// that meaning for its Named children the way an Arrow fixes its domain's
// (infer_arrow_empty_domain_edge), and the evidence is the same fresh synthetic empty product
// (infer_empty_product_entry). A childless Conj anywhere else still refuses: parse residue has that
// shape too, and a positional child of a Disj is not an alternative.
fn infer_sum_nullary_payload_edge(parent: Node, edge: Edge) -> Bool {
  match parent.kind {
    TypeNode { connective: Disj } =>
      (match edge.label {
        StructuralLabel { label: _ } => false
        Authored { name: _ } => true
        Positional => false
      })
        && (length(xs: edge.target.children) == 0)
        && (match edge.target.kind {
          TypeNode { connective: Conj } => true
          _ => false
        })
    _ => false
  }
}

// A DECLARATION'S BINDERS ARE NOT INFERRED. The <type-parameters> edge of a type-declaration wrapper
// (v2.std.type_binder type_decl_view: a generic member, an alias or an opaque declaration) carries the
// declaration's binder Conj -- names the binder authority checks and resolve scopes, not values -- so
// there is no type for its subtree to derive, and an EMPTY binder list is never a unit value. The
// wrapper carries the edge unchanged as its own evidence, the same shape as the Arrow's declared order
// (v2.std.node arrow_signature_order_edge). Asked through the view, never by the label alone, so the marker
// on an Arrow (a fn's type parameters) is not swept in.
fn infer_declaration_binder_edge(parent: Node, edge: Edge) -> Bool {
  declaration_binder_edge(parent: parent, edge: edge)
}

// A SUM IS FORMED ONLY OVER NAMED ALTERNATIVES: a Disj with no children, or with a positional child,
// is not a coproduct this rule knows how to read, and stays on the frontier.
fn infer_disj_is_named_sum(n: Node) -> Bool {
  (length(xs: n.children) > 0)
    && fold(n.children, init: true, f: fn(acc, e) {
      acc && match e.label {
        StructuralLabel { label: _ } => false
        Authored { name: _ } => true
        Positional => false
      }
    })
}

// AN ARROW'S DECLARED ORDER, AND ITS CONTRACT EDGES, ARE NOT INFERRED (contract edges:
// v2.std.node arrow_named_edge_is_contract -- effect claims, execution mode, resource requirements --
// state what the Arrow promises in labels or declaration references, never values). The ^arrow_signature_order_edge's subtree is a list of
// the domain's binder LABELS (v2.std.arrow_signature signature_order_edge), not values: there
// is no type for a label atom to derive, so walking it left every declared Arrow's order atoms on the
// frontier (infer_grounding_not_derived) and the Arrow itself NotDerived. The Arrow carries the edge
// as its own evidence (infer_product_child_evidence_edges), and the gather step below takes nothing
// from its subtree -- the same shape as infer_arrow_empty_domain_edge and the literal payload arm, where
// the parent's model, not the child's walk, says what the child is. The edge is classified by
// v2.std.node arrow_signature_order_edge, the one predicate std.kind's roster index also asks.

// A MATCH ARM'S PATTERN IS A BINDING FORM, NOT A VALUE, so this step carries its edge the way it
// carries a declaration's binders (v2.std.node match_arm_pattern_edge). A fielded pattern is the
// construct shape with binders where a construction has values, and may name any subset of its
// constructor's fields; the match row reads it from the arm, and it is never judged as the
// construction it is shaped like. The same edge is outside v2.std.type_binder
// node_inferred_subtree_nodes.
// A WHERE-REFINEMENT'S PREDICATE CALLS ARE NOT JUDGED AS APPLICATIONS, AND EACH ONE SAYS SO. A predicate
// call (v2.compiler.body_lowering_fold body_lower_kept_where_clause) applies its declaration to the REFINED
// VALUE, which the clause never writes: `type Pos = Int where positive` lowers to a zero-argument call of
// `positive(x: Int)`. Judged as an ordinary named call through application_binding_plan it refuses
// application_positional_deficit on every refinement, and judged with the subject supplied it needs a slot no
// carrier has: which formal is the subject is stated only as an annotation in std.types, and `brand` takes no
// subject at all. So this is the SAME declared frontier RefinementDeclaration.where_clause carries -- the
// where clause is not yet consumed by infer -- extended to the calls inside it, not a second one.
//
// IT IS NOT A RUNG DROP. Before named calls were judged at all, a predicate call was accepted unjudged along
// with every other named call; what this arm keeps is that single shape at that rung, while every other named
// call stays judged (a positional deficit still refuses: v2.test.claim.parameter_reference_test
// pr_ordinary_named_call_deficit_still_refuses). IT IS LOUD, NOT SILENT: each predicate call emits
// inhabitance_undecidable_where_predicate_subject_unmodelled at its own locus, so the population is counted by
// execution over any compiled corpus rather than transcribed here. PARKED; NO INFER JUDGMENT IS COMING
// (operator ruling, 2026-10-02): refinements are being deleted, replaced by checked constructors returning
// Optional. NEXT TRIGGER, NAMING THE CAPABILITY: where-refinement clauses are removed from the language in
// favour of checked constructors returning Optional, SUFFICIENT FOR no where-predicate call to reach infer --
// then this arm and its reason are deleted with the clause.
fn infer_where_predicate_set_edge(parent: Node, edge: Edge) -> Bool {
  match edge.label {
    Positional => false
    StructuralLabel { label: _ } => false
    Authored { name: label } =>
      if label == ^grammar_production_captured_node_projection {
        match find_named_child(root: parent, name: ^grammar_production_identity_node_projection) {
          Accepted { value: identity, diagnostics: _ } =>
            match identity.kind {
              TypeNode { connective: Atom { identity: emitted } } => emitted == ^dag_surface_where_refinement_clause
              TypeNode { connective: _ } => false
              ComputationNode { behavior: _ } => false
            }
          Rejected { diagnostics: _ } => false
        }
      } else {
        false
      }
  }
}

fn infer_where_predicate_calls_unjudged(set: Node) -> Diagnostics {
  fold(set.children, init: None, f: fn(acc, e) {
    diagnostics_merge(
      outer: acc,
      inner: Some {
        diagnostics: diagnostics_singleton(
          d: inhabitance_undecidable_diagnostic(application: e.target, reason: undecidable_where_predicate_subject_unmodelled())
        )
      }
    )
  })
}

fn infer_gather_acc_with_application_instances(acc: InferGatherFoldAcc, instances: List<TypeVariableInstance>) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: acc.node,
    entries: acc.entries,
    failed: acc.failed,
    pending: acc.pending,
    await_branch_row: acc.await_branch_row,
    await_match_row: acc.await_match_row,
    await_loop_row: acc.await_loop_row,
    await_transform_row: acc.await_transform_row,
    application_instances: instances,
    children_remaining: acc.children_remaining
  }
}

fn infer_inhabitance_pair_for_actual(pairs: List<InhabitanceFormalArg>, actual: Node) -> Optional<InhabitanceFormalArg> {
  fold(pairs, init: optional_absent(), f: fn(acc, pair) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if pair.arg == actual {
          optional_present(value: pair)
        } else {
          acc
        }
    }
  })
}

// ONE JUDGMENT PER ACTUAL, CARRIED ON THE GATHER ACC. After each Transform actual child folds,
// infer_judge_formal_args extends acc.application_instances by that one pair. The next actual's
// child frame reads the prefix; the transform row seeds infer_judge_formal_args with the same list
// (empty remaining pairs) instead of recomputing the prefix.
fn infer_gather_extend_application_instances(
  acc: InferGatherFoldAcc,
  edge: Edge,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree
) -> Outcome<List<TypeVariableInstance>> {
  if !acc.await_transform_row {
    Accepted { value: acc.application_instances, diagnostics: None }
  } else {
    match acc.node.children {
      Empty => Accepted { value: acc.application_instances, diagnostics: None }
      Cons { head: callee, tail: _ } =>
        if callee.target == edge.target {
          Accepted { value: acc.application_instances, diagnostics: None }
        } else {
          match infer_application_formals(node: acc.node, entries: entries) {
            FormalsUnresolved => Accepted { value: acc.application_instances, diagnostics: None }
            FormalsOrderRefused { reason: _ } => Accepted { value: acc.application_instances, diagnostics: None }
            FormalsInDeclaredOrder { formals: formals } =>
              match infer_application_formal_args(node: acc.node, formals: formals, entries: entries) {
                Rejected { diagnostics: _ } => Accepted { value: acc.application_instances, diagnostics: None }
                Accepted { value: pairs, diagnostics: _ } =>
                  match infer_inhabitance_pair_for_actual(pairs: pairs, actual: edge.target) {
                    Absent => Accepted { value: acc.application_instances, diagnostics: None }
                    Present { value: pair } =>
                      infer_judge_formal_args(
                        position: position_direct_call_argument(),
                        site: JudgedAtApplication { application: acc.node },
                        entries: entries,
                        declarations: resolved.resolved_declarations,
                        pairs: [pair],
                        type_params: infer_application_type_params(node: acc.node, entries: entries),
                        instances: acc.application_instances
                      )
                  }
              }
          }
        }
    }
  }
}

fn infer_gather_fold_step(
  acc: InferGatherFoldAcc,
  edge: Edge,
  child: InferGatherFoldAcc,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  if acc.failed {
    acc
  } else if match_arm_pattern_edge(parent: acc.node, edge: edge) {
    if child.failed {
      infer_gather_fold_acc_failed(
        node: acc.node,
        pending: rejected_with_pending(
          pending: acc.pending,
          rejected: infer_gather_failed_non_empty(acc: child)
        ),
        await_branch_row: acc.await_branch_row,
        await_match_row: acc.await_match_row,
        await_loop_row: acc.await_loop_row,
        await_transform_row: acc.await_transform_row,

        application_instances: acc.application_instances,
        children_remaining: acc.children_remaining
      )
    } else {
      infer_gather_fold_step_merged(
        acc: acc,
        merged_entries: acc.entries,
        merged_pending: acc.pending,
        partials: partials,
        kinds: kinds,
        resolved: resolved
      )
    }
  } else if arrow_signature_order_edge(parent: acc.node, edge: edge)
    || arrow_named_edge_is_contract(e: edge)
    || infer_declaration_binder_edge(parent: acc.node, edge: edge)
    || (resolved_reference_body_kind(target: acc.node) != NotMarkedReference) {
    infer_gather_fold_step_merged(
      acc: acc,
      merged_entries: acc.entries,
      merged_pending: acc.pending,
      partials: partials,
      kinds: kinds,
      resolved: resolved
    )
  } else if infer_where_predicate_set_edge(parent: acc.node, edge: edge) {
    infer_gather_fold_step_merged(
      acc: acc,
      merged_entries: acc.entries,
      merged_pending: diagnostics_merge(outer: acc.pending, inner: infer_where_predicate_calls_unjudged(set: edge.target)),
      partials: partials,
      kinds: kinds,
      resolved: resolved
    )
  } else if child.failed {
    infer_gather_fold_acc_failed(
      node: acc.node,
      pending: rejected_with_pending(
        pending: acc.pending,
        rejected: infer_gather_failed_non_empty(acc: child)
      ),
      await_branch_row: acc.await_branch_row,
      await_match_row: acc.await_match_row,
      await_loop_row: acc.await_loop_row,
      await_transform_row: acc.await_transform_row,

      application_instances: acc.application_instances,
        children_remaining: acc.children_remaining
    )
  } else if infer_arrow_empty_domain_edge(parent: acc.node, edge: edge, children_remaining: acc.children_remaining)
    || infer_sum_nullary_payload_edge(parent: acc.node, edge: edge) {
    match infer_empty_product_entry(domain: edge.target) {
      Rejected { diagnostics: r } =>
        infer_gather_fold_acc_failed(
          node: acc.node,
          pending: rejected_with_pending(pending: acc.pending, rejected: r),
          await_branch_row: acc.await_branch_row,
          await_match_row: acc.await_match_row,
          await_loop_row: acc.await_loop_row,
          await_transform_row: acc.await_transform_row,

          application_instances: acc.application_instances,
        children_remaining: acc.children_remaining
        )
      Accepted { value: domain_entry, diagnostics: _ } =>
        infer_gather_fold_step_merged(
          acc: acc,
          merged_entries: list_snoc_item(xs: acc.entries, item: domain_entry),
          merged_pending: acc.pending,
          partials: partials,
          kinds: kinds,
          resolved: resolved
        )
    }
  } else {
    let family = infer_literal_edge_payload(parent: acc.node, edge: edge)
    match family {
      InferNotALiteralPayload =>
        match infer_gather_extend_application_instances(
          acc: acc,
          edge: edge,
          entries: concat_inferred_facts_entries(a: acc.entries, b: child.entries),
          resolved: resolved
        ) {
          Rejected { diagnostics: r } =>
            infer_gather_fold_acc_failed(
              node: acc.node,
              pending: rejected_with_pending(pending: acc.pending, rejected: r),
              await_branch_row: acc.await_branch_row,
              await_match_row: acc.await_match_row,
              await_loop_row: acc.await_loop_row,
              await_transform_row: acc.await_transform_row,
              application_instances: acc.application_instances,
              children_remaining: acc.children_remaining
            )
          Accepted { value: instances, diagnostics: d } =>
            infer_gather_fold_step_merged(
              acc: infer_gather_acc_with_application_instances(acc: acc, instances: instances),
              merged_entries: concat_inferred_facts_entries(a: acc.entries, b: child.entries),
              merged_pending: diagnostics_merge(outer: diagnostics_merge(outer: acc.pending, inner: child.pending), inner: d),
              partials: partials,
              kinds: kinds,
              resolved: resolved
            )
        }
      _ =>
        infer_gather_literal_payload_step(acc: acc, edge: edge, family: family, partials: partials, kinds: kinds, resolved: resolved)
    }
  }
}

// One literal payload edge folded into the gather: its members' facts derive for THIS family.
fn infer_gather_literal_payload_step(
  acc: InferGatherFoldAcc,
  edge: Edge,
  family: InferLiteralPayload,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  match infer_literal_payload_entries(family: family, payload: edge.target) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: acc.node,
        pending: rejected_with_pending(pending: acc.pending, rejected: r),
        await_branch_row: acc.await_branch_row,
        await_match_row: acc.await_match_row,
        await_loop_row: acc.await_loop_row,
        await_transform_row: acc.await_transform_row,

        application_instances: acc.application_instances,
        children_remaining: acc.children_remaining
      )
    Accepted { value: payload_entries, diagnostics: _ } =>
      infer_gather_fold_step_merged(
        acc: acc,
        merged_entries: concat_inferred_facts_entries(a: acc.entries, b: payload_entries),
        merged_pending: acc.pending,
        partials: partials,
        kinds: kinds,
        resolved: resolved
      )
  }
}

fn infer_gather_fold_step_merged(
  acc: InferGatherFoldAcc,
  merged_entries: List<InferredFactsEntry>,
  merged_pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  let children_remaining = acc.children_remaining - 1
  if acc.await_branch_row && children_remaining == 0 {
    infer_gather_branch_row_on_entries(
      node: acc.node,
      entries: merged_entries,
      pending: merged_pending,
      partials: partials
    )
  } else if acc.await_match_row && children_remaining == 0 {
    infer_gather_match_row_on_entries(
      node: acc.node,
      entries: merged_entries,
      pending: merged_pending,
      partials: partials,
      resolved: resolved
    )
  } else if acc.await_loop_row && children_remaining == 0 {
    infer_gather_loop_row_on_entries(
      node: acc.node,
      entries: merged_entries,
      pending: merged_pending,
      partials: partials
    )
  } else if acc.await_transform_row && children_remaining == 0 {
    infer_gather_transform_row_on_entries(
      node: acc.node,
      entries: merged_entries,
      pending: merged_pending,
      partials: partials,
      kinds: kinds,
      resolved: resolved,
      instances: acc.application_instances
    )
  } else if children_remaining == 0 {
    infer_gather_settled_row(acc: acc, merged_entries: merged_entries, merged_pending: merged_pending, partials: partials, kinds: kinds, resolved: resolved)
  } else {
    infer_gather_fold_acc_ok(
      node: acc.node,
      entries: merged_entries,
      pending: merged_pending,
      await_branch_row: acc.await_branch_row,
      await_match_row: acc.await_match_row,
      await_loop_row: acc.await_loop_row,
      await_transform_row: acc.await_transform_row,

      application_instances: acc.application_instances,
        children_remaining: children_remaining
    )
  }
}

// A RECORD CONSTRUCT IS ITS CONSTRUCTOR APPLIED BY NAME. `R { f: v }` is a Conj whose marked first
// edge targets the constructor's resolved reference (v2.std.node_query construct_tag_optional) and
// whose other edges are the field values. The formals it applies are the fields the record
// DECLARES and the type variables are the record's declared binders. From there it is the
// application's own route: the one binding plan pairs each declared field with the actual that
// fills it (v2.std.arrow_signature application_binding_plan_over), and the one judge decides each
// pair under one instantiation (infer_judge_formal_args). Nothing here compares a type.
//
// TWO READINGS OF ONE DECLARATION, EACH FROM THE INDEX THAT OWNS IT (v2.compiler.resolve
// ResolvedTree). symbol_index, the index resolution consulted, holds a declaration AS AUTHORED: it
// says which paths are records, which fields each declares and which binders it has -- facts about
// NAMES, so the field set is checked for every record a tag can resolve to. resolved_declarations
// holds the subject module's declarations WITH RESOLVED BODIES, and the judge compares resolved
// types, so a record found there is judged field by field. A record declared in another module has
// no resolved body this stage can read: each of its field values is a counted
// UndecidableFormalUnresolved obligation and the construct stays on the frontier -- never compared
// against the authored spelling, which would refuse for the wrong reason. That population and its
// trigger are rostered in gunbc.recurring_failure_mode
// construct_field_value_not_typed_against_the_record_declaration.
//
// ONLY A DECLARED RECORD OR VARIANT ARM IS READ HERE. The index says which kind of payload a path
// denotes (symbol_index_declared_payload_at); a tag the guarded reader does not answer for and a
// Conj with no tag at all are ConstructNotARecord and keep product introduction, where an underived
// tag leaves them on the counted frontier as before. A VARIANT ARM's construct is read at its own
// path (the arm declares the fields) and derives the VARIANT's type: the declaration reference of
// the arm path's parent (v2.compiler.body_lowering_fold variant_fields_unlowered_on_the_native_route
// is retired by this read plus the variant match row beside it).
type InferRecordFormals
  = RecordFormalsResolved { payload: Node }
  | RecordFormalsAuthored { payload: Node }

type InferRecordConstruct {
  record: Node
  path: QualifiedName
  formals: InferRecordFormals
  type_params: List<Symbol>
}

// A variant arm's construct carries the arm path it was read at and the variant path whose
// declaration reference names the construction's type. The arm's fields are the formals; the
// variant's declared type params are the ones its fields may cite.
type InferVariantArmConstruct {
  record: Node
  arm_path: QualifiedName
  variant_path: QualifiedName
  formals: InferRecordFormals
  type_params: List<Symbol>
}

type InferConstructRead
  = ConstructIsRecord { construct: InferRecordConstruct }
  | ConstructIsVariantArm { construct: InferVariantArmConstruct }
  | ConstructNotARecord

fn infer_record_formals(resolved: ResolvedTree, path: QualifiedName, authored: Node) -> InferRecordFormals {
  match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: path) {
    Present { value: resolved } => RecordFormalsResolved { payload: resolved }
    Absent => RecordFormalsAuthored { payload: authored }
  }
}

fn infer_record_formals_payload(formals: InferRecordFormals) -> Node {
  match formals {
    RecordFormalsResolved { payload: payload } => payload
    RecordFormalsAuthored { payload: payload } => payload
  }
}

// ONE MINT FOR BOTH PATH FORMS. The tag's path is either the variant's declared path (the
// containment form: `p.Seal.Boxed`) or the module-level unique-variant alias (`p.Boxed`), whose
// carrier the index carries beside it; by here the path IS the declared path either way, so the
// construction types by the declaring coproduct, its params, and the variant's own payload.
fn infer_variant_arm_construct(
  reference: Node,
  resolved: ResolvedTree,
  declared_path: QualifiedName
) -> InferConstructRead {
  match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: declared_path) {
    Absent => ConstructNotARecord
    Present { value: resolved_decl } =>
      match qualified_name_init(qn: declared_path) {
        Empty => ConstructNotARecord
        Cons { head: _, tail: _ } =>
          ConstructIsVariantArm {
            construct: InferVariantArmConstruct {
              record: reference,
              arm_path: declared_path,
              variant_path: qualified_name_init(qn: declared_path),
              formals: infer_record_formals(resolved: resolved, path: declared_path, authored: resolved_decl),
              type_params: symbol_index_declared_type_params_at(
                index: resolved.resolved_declarations,
                qualified_path: qualified_name_init(qn: declared_path)
              )
            }
          }
      }
  }
}

// A CONSTRUCTION'S TAG IS A RESOLVED REFERENCE, BARE OR QUALIFIED ALIKE: resolve rewrites the tag
// to the declaration it binds (the qualified door and the atom walk meet in resolve_atom_bound, the
// same producer the bare door uses), so the variant's declaring path is the reference's own path --
// no second lookup beside it. Reads go through resolved_declarations: declarations with resolved
// bodies (gunbc#12629). The global bare index is dead as a mechanism (03_resolve at the global_bare
// comment) and names no read here. THE DECLARING PATH OF A VARIANT-ARM PAYLOAD PATH: for the
// variant's own row this is the row itself (no claimants); for its module-level alias the binding
// filed by symbol_index_fill_containment_node answers the variant's declaring path. One authority,
// no parallel carrier map.
fn infer_record_construct_read(node: Node, resolved: ResolvedTree) -> InferConstructRead {
  match construct_tag_optional(n: node) {
    Absent => ConstructNotARecord
    Present { value: reference } =>
      match declaration_reference_path_optional(node: reference) {
        Absent => ConstructNotARecord
        Present { value: path } =>
          match symbol_index_declared_payload_at(index: resolved.resolved_declarations, qualified_path: path) {
            Absent => ConstructNotARecord
            Present { value: kind } =>
              match kind {
                VariantArmPayload =>
                  infer_variant_arm_construct(
                    reference: reference,
                    resolved: resolved,
                    declared_path: symbol_index_declaring_path_of(
                      index: resolved.resolved_declarations,
                      target: path
                    )
                  )
                RecordTypePayload =>
                  match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: path) {
                    Absent => ConstructNotARecord
                    Present { value: resolved_decl } =>
                      ConstructIsRecord {
                        construct: InferRecordConstruct {
                          record: reference,
                          path: path,
                          formals: infer_record_formals(resolved: resolved, path: path, authored: resolved_decl),
                          type_params: symbol_index_declared_type_params_at(
                            index: resolved.resolved_declarations,
                            qualified_path: path
                          )
                        }
                      }
                  }
              }
          }
      }
  }
}

// EVERY FIELD-SET REFUSAL NAMES THE RECORD AND THE FIELD. Located at the value for a field the
// record does not declare, names twice, or does not name at all; located at the construct for a
// declared field it leaves out, whose declared type rides beside its name.
fn infer_record_construct_refusal(reason: Symbol, at: Node, record: Node, field: Edge) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: at),
    correction: Suggested {
      node: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge { label: Authored { name: ^inhabitance_record }, target: record },
          field
        ],
        occurrence_id: at.occurrence_id
      }
    }
  }
}

// The binding plan's reasons, said of a record: an unknown label is a field the record does not
// declare, an unfilled slot a declared field left out, a slot filled twice a field named twice. Any
// other plan reason is passed through as it is, never renamed into one of these.
fn infer_record_construct_field_not_declared_reason() -> Symbol {
  ^record_construct_field_not_declared
}

fn infer_record_construct_field_missing_reason() -> Symbol {
  ^record_construct_field_missing
}

fn infer_record_construct_field_bound_twice_reason() -> Symbol {
  ^record_construct_field_bound_twice
}

fn infer_record_construct_binding_reason(plan_reason: Symbol) -> Symbol {
  if plan_reason == ^application_argument_label_unknown {
    infer_record_construct_field_not_declared_reason()
  } else if plan_reason == ^application_positional_deficit {
    infer_record_construct_field_missing_reason()
  } else if plan_reason == ^application_argument_slot_bound_twice {
    infer_record_construct_field_bound_twice_reason()
  } else {
    plan_reason
  }
}

fn infer_record_actual_label_set(actuals: List<Edge>) -> Map<Symbol, Bool> {
  fold(actuals, init: empty_map(), f: fn(m, e) {
    match e.label {
      Authored { name: label } => map_insert(m: m, key: label, value: true)
      StructuralLabel { label: _ } => m
      Positional => m
    }
  })
}

fn infer_record_first_missing_formal(formals: List<InhabitanceFormal>, actuals: List<Edge>) -> Optional<InhabitanceFormal> {
  let named = infer_record_actual_label_set(actuals: actuals)
  fold(formals, init: optional_absent(), f: fn(acc, formal) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match map_lookup(m: named, key: formal.parameter_identity) {
          Present { value: _ } => acc
          Absent => optional_present(value: formal)
        }
    }
  })
}

fn infer_record_first_positional_actual(actuals: List<Edge>) -> Optional<Edge> {
  fold(actuals, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match e.label {
          StructuralLabel { label: _ } => acc
          Positional => optional_present(value: e)
          Authored { name: _ } => acc
        }
    }
  })
}

fn infer_record_construct_binding_refusal(
  node: Node,
  record: Node,
  formals: List<InhabitanceFormal>,
  actuals: List<Edge>,
  plan_reason: Symbol,
  at: Int
) -> Diagnostic {
  let reason = infer_record_construct_binding_reason(plan_reason: plan_reason)
  if plan_reason == ^application_positional_deficit {
    match infer_record_first_missing_formal(formals: formals, actuals: actuals) {
      Present { value: missing } =>
        infer_record_construct_refusal(
          reason: reason,
          at: node,
          record: record,
          field: Edge { label: Authored { name: missing.parameter_identity }, target: missing.declared }
        )
      Absent => application_parameter_order_diagnostic(application: node, reason: application_parameter_order_malformed_reason())
    }
  } else {
    match list_at_optional(xs: actuals, index: at) {
      Present { value: actual } =>
        infer_record_construct_refusal(reason: reason, at: actual.target, record: record, field: actual)
      Absent => application_parameter_order_diagnostic(application: node, reason: application_parameter_order_malformed_reason())
    }
  }
}

// EACH DECLARED FIELD WITH THE VALUE THAT FILLS IT, OR THE REFUSAL. A construct's fields are named,
// so a field edge with no name is refused before the plan could bind it by position. A payload whose
// fields are not all named is not a field set this reads: RecordPayloadUnread, the counted frontier.
type InferRecordFieldBinding
  = RecordFieldsBound { pairs: List<InhabitanceFormalArg> }
  | RecordFieldsRefused { diagnostic: Diagnostic }
  | RecordPayloadUnread

fn infer_record_field_binding(node: Node, record: Node, formals: InferRecordFormals) -> InferRecordFieldBinding {
  match infer_formals_from_domain(domain: infer_record_formals_payload(formals: formals)) {
    Absent => RecordPayloadUnread
    Present { value: formals } =>
      let actuals = construct_field_edges(n: node)
      match infer_record_first_positional_actual(actuals: actuals) {
        Present { value: unnamed } =>
          RecordFieldsRefused {
            diagnostic: infer_record_construct_refusal(
              reason: ^record_construct_field_not_named,
              at: unnamed.target,
              record: record,
              field: unnamed
            )
          }
        Absent =>
          match application_binding_plan_over(labels: list_map(xs: formals, f: infer_formal_identity_key), actuals: actuals) {
            ApplicationBindingRefused { reason: reason, at: at } =>
              RecordFieldsRefused {
                diagnostic: infer_record_construct_binding_refusal(
                  node: node,
                  record: record,
                  formals: formals,
                  actuals: actuals,
                  plan_reason: reason,
                  at: at
                )
              }
            ApplicationBound { slots: slots } =>
              RecordFieldsBound { pairs: infer_formal_args_by_plan(formals: formals, slots: slots, actuals: actuals) }
          }
      }
  }
}

// RECORD INTRODUCTION IS NOMINAL. A construct whose every field value inhabits its declared field is
// a value of the DECLARED record, so its type is the record's declaration reference -- instantiated
// at the type each declared binder took from the field values, in binder order, when the record is
// generic (the carrier infer_freemonoid_type_of builds for a list) -- and never the product of its
// field types, which would make two records with the same fields one type. It derives only when
// every field obligation was decided and every binder was instantiated: a construct with a counted
// field obligation, or a binder no field value fixed, stays on the frontier, exactly as an
// application does (infer_transform_derived_optional arguments_decided).
fn infer_record_construct_type(
  type_path: QualifiedName,
  type_params: List<Symbol>,
  instances: List<TypeVariableInstance>,
  decided: Bool
) -> Optional<Node> {
  if !decided {
    optional_absent()
  } else {
    let reference = declaration_reference_node(qn: type_path, occurrence_id: OccurrenceSynthetic)
    if length(xs: type_params) == 0 {
      optional_present(value: reference)
    } else {
      match fold(
        type_params,
        init: optional_present(value: [Edge { label: Positional, target: reference }]),
        f: fn(acc, binder) {
          match acc {
            Absent => acc
            Present { value: edges } =>
              match type_variable_instance_lookup(instances: instances, binder: binder) {
                Absent => optional_absent()
                Present { value: instance } =>
                  optional_present(
                    value: list_snoc_item(
                      xs: edges,
                      item: Edge { label: Positional, target: canonicalize_node_strip_provenance(n: instance) }
                    )
                  )
              }
          }
        }
      ) {
        Absent => optional_absent()
        Present { value: edges } =>
          optional_present(
            value: Node {
              kind: TypeNode { connective: Instantiation },
              children: edges,
              occurrence_id: OccurrenceSynthetic
            }
          )
      }
    }
  }
}

fn infer_record_construct_facts(
  node: Node,
  construct: InferRecordConstruct,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  partials: List<Node>,
) -> Outcome<InferredFacts> {
  infer_construct_facts_on_entries(
    node: node,
    record: construct.record,
    formals: construct.formals,
    type_path: construct.path,
    type_params: construct.type_params,
    entries: entries,
    declarations: declarations,
    partials: partials
  )
}

// A VARIANT ARM's construction derives the VARIANT's type (the arm path's parent declaration
// reference), with the arm's fields as the formals: `Boxed(41)` is a value of `Seal`, judged at the
// arm the construction names (v2.compiler.infer infer_record_construct_read reads the arm's path).
fn infer_variant_construct_facts(
  node: Node,
  construct: InferVariantArmConstruct,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  partials: List<Node>,
) -> Outcome<InferredFacts> {
  infer_construct_facts_on_entries(
    node: node,
    record: construct.record,
    formals: construct.formals,
    type_path: construct.variant_path,
    type_params: construct.type_params,
    entries: entries,
    declarations: declarations,
    partials: partials
  )
}

fn infer_construct_facts_on_entries(
  node: Node,
  record: Node,
  formals: InferRecordFormals,
  type_path: QualifiedName,
  type_params: List<Symbol>,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  partials: List<Node>,
) -> Outcome<InferredFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: node) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          match infer_record_field_binding(node: node, record: record, formals: formals) {
            RecordFieldsRefused { diagnostic: d } => outcome_rejected(d)
            RecordPayloadUnread =>
              bind_outcome_accepted(od: cd, inner: inferred_facts_not_derived(node: node, descent: Holds { value: descent_proof }))
            RecordFieldsBound { pairs: pairs } =>
              match formals {
                RecordFormalsAuthored { payload: _ } =>
                  bind_outcome_accepted(
                    od: diagnostics_merge(outer: cd, inner: infer_record_fields_unresolved_diagnostics(pairs: pairs)),
                    inner: inferred_facts_not_derived(node: node, descent: Holds { value: descent_proof })
                  )
                RecordFormalsResolved { payload: _ } =>
                  match infer_judge_formal_args(
                    position: position_record_field(record: record),
                    site: JudgedAtEachActual,
                    entries: entries,
                    declarations: declarations,
                    pairs: pairs,
                    type_params: type_params,
                    instances: infer_no_type_variable_instances()
                  ) {
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                    Accepted { value: instances, diagnostics: jd } =>
                      bind_outcome_accepted(
                        od: diagnostics_merge(outer: cd, inner: jd),
                        inner: match infer_record_construct_type(
                          type_path: type_path,
                          type_params: type_params,
                          instances: instances,
                          decided: infer_diagnostics_none(d: jd)
                        ) {
                          Present { value: record_type } =>
                            inferred_facts_from_derived_type(
                              node: node,
                              derived_type: record_type,
                              descent: Holds { value: descent_proof }
                            )
                          Absent =>
                            inferred_facts_not_derived(node: node, descent: Holds { value: descent_proof })
                        }
                      )
                  }
              }
          }
      }
  }
}

// One counted obligation per field value of a record whose declaration this stage holds only as
// authored, located at the value it would have judged.
fn infer_record_fields_unresolved_diagnostics(pairs: List<InhabitanceFormalArg>) -> Diagnostics {
  fold(pairs, init: None, f: fn(acc, pair) {
    diagnostics_merge(
      outer: acc,
      inner: Some {
        diagnostics: diagnostics_singleton(
          d: inhabitance_undecidable_diagnostic(application: pair.arg, reason: undecidable_formal_unresolved())
        )
      }
    )
  })
}

fn infer_gather_record_construct_row_on_entries(
  node: Node,
  construct: InferRecordConstruct,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  pending: Diagnostics,
  partials: List<Node>,
) -> InferGatherFoldAcc {
  infer_gather_formed_facts_row(
    node: node,
    formed: infer_record_construct_facts(node: node, construct: construct, entries: entries, declarations: declarations, partials: partials),
    entries: entries,
    pending: pending
  )
}

fn infer_gather_variant_construct_row_on_entries(
  node: Node,
  construct: InferVariantArmConstruct,
  entries: List<InferredFactsEntry>,
  declarations: SymbolIndex,
  pending: Diagnostics,
  partials: List<Node>,
) -> InferGatherFoldAcc {
  infer_gather_formed_facts_row(
    node: node,
    formed: infer_variant_construct_facts(node: node, construct: construct, entries: entries, declarations: declarations, partials: partials),
    entries: entries,
    pending: pending
  )
}

// THE LAST CHILD OF A NODE NO BEHAVIOR ROW AWAITED. An annotated Bind (v2.std.type_binder
// type_annotation_optional) checks its bound value against the annotation; a product or Arrow still
// missing its own entry takes the product row; anything else stays as folded.
fn infer_gather_settled_row(
  acc: InferGatherFoldAcc,
  merged_entries: List<InferredFactsEntry>,
  merged_pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  if infer_bind_encodes_collection_fold(bind: acc.node) {
    infer_gather_fold_bind_row_on_entries(node: acc.node, entries: merged_entries, pending: merged_pending, partials: partials, kinds: kinds, resolved: resolved)
  } else {
  match type_annotation_optional(n: acc.node) {
    Present { value: _ } =>
      infer_gather_bind_annotation_row_on_entries(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        partials: partials,
        kinds: kinds,
        resolved: resolved
      )
    Absent =>
      match infer_declared_position_check(node: acc.node, entries: merged_entries, declarations: resolved.resolved_declarations) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: acc.node,
            pending: rejected_with_pending(pending: merged_pending, rejected: r),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,

            application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
          )
        Accepted { value: _, diagnostics: rd } =>
          infer_gather_settled_unannotated_row(
            acc: acc,
            merged_entries: merged_entries,
            merged_pending: diagnostics_merge(outer: merged_pending, inner: rd),
            partials: partials,
            resolved: resolved
          )
      }
  }
  }
}

// THE DECLARED POSITIONS A SETTLED NODE OWES: a binder node's default is judged at the binder's declared
// type (infer_binder_default_check), and an Arrow's body at its declared return
// (infer_arrow_declared_return_check). Any other node owes nothing here.
fn infer_declared_position_check(node: Node, entries: List<InferredFactsEntry>, declarations: SymbolIndex) -> Outcome<Bool> {
  match binder_node_parts(n: node) {
    Present { value: parts } => infer_binder_default_check(parts: parts, entries: entries, declarations: declarations)
    Absent =>
      bind_outcome(o: infer_generic_default_refusal(node: node), f: fn(_) {
        infer_arrow_declared_return_check(node: node, entries: entries, declarations: declarations)
      })
  }
}

// A DEFAULT UNDER A GENERIC DECLARATION REFUSES, LOCATED AT THE DEFAULT, until it is modeled
// (^infer_binder_default_generic_unmodeled; side-chat review on #12948). A default's binder node does not
// see its declaration's type parameters, and judged without them a default typed by one lands in
// InhabitanceUndecidable, which is an advisory acceptance -- fail-open. So the declaration that owns the
// type parameters -- a generic Arrow over its domain, a generic type declaration over its member --
// refuses each defaulted binder it carries. A non-generic declaration owes nothing here, and its
// defaults are judged at their binder (infer_binder_default_check).
fn infer_generic_default_refusal(node: Node) -> Outcome<Bool> {
  match type_param_names(n: node) {
    Empty => outcome_accepted(true)
    Cons { head: _, tail: _ } =>
      match infer_first_default_beneath(nodes: infer_declared_binder_scope(node: node)) {
        Absent => outcome_accepted(true)
        Present { value: default } => outcome_rejected(infer_binder_default_generic_unmodeled_diagnostic(default: default))
      }
  }
}

// THE SUBTREE A GENERIC DECLARATION'S TYPE PARAMETERS GOVERN: an Arrow's domain, or a generic type
// declaration's member. A default anywhere beneath it -- an immediate binder, or one nested in a record
// type, a coproduct arm's payload or an inline record -- is under those type parameters (side-chat review
// on #12948: `type Box<T> = Full { value: T = 1 } | Empty` nests its default in the Full payload).
fn infer_declared_binder_scope(node: Node) -> List<Node> {
  match node.kind {
    TypeNode { connective: Arrow } =>
      match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
        Present { value: domain } => [domain]
        Absent => []
      }
    _ =>
      match type_decl_view(target: node) {
        GenericTypeDecl { binders: _, member: m } => [m]
        _ => []
      }
  }
}

// The first binder default beneath the given nodes, in one depth-first traversal bounded to them.
fn infer_first_default_beneath(nodes: List<Node>) -> Optional<Node> {
  fold(nodes, init: optional_absent(), f: fn(acc, n) {
    match acc {
      Present { value: _ } => acc
      Absent => infer_first_default_in(node: n)
    }
  })
}

fn infer_first_default_in(node: Node) -> Optional<Node> {
  match binder_node_parts(n: node) {
    Present { value: parts } =>
      match parts.default {
        Present { value: d } => optional_present(value: d)
        Absent => infer_first_default_under(node: node)
      }
    Absent => infer_first_default_under(node: node)
  }
}

fn infer_first_default_under(node: Node) -> Optional<Node> {
  fold(node.children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => infer_first_default_in(node: e.target)
    }
  })
}

fn infer_binder_default_generic_unmodeled_diagnostic(default: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_binder_default_generic_unmodeled,
    at: node_locus(node: default),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// A BINDER'S DEFAULT IS JUDGED AT THE BINDER'S DECLARED TYPE (XL-2 PR2c-ii), through the same judge --
// and so the same relation -- an argument meets at its formal and a body at its declared return: the
// default must inhabit the type an omitted argument or field is declared to have. A binder with no
// default owes nothing. The default is judged with no type variables in scope, so a default whose
// type mentions the declaring Arrow's own type parameter does not inhabit an unrelated type by
// accident: it is refused, located at the default, not assumed.
fn infer_binder_default_check(parts: BinderParts, entries: List<InferredFactsEntry>, declarations: SymbolIndex) -> Outcome<Bool> {
  match parts.default {
    Absent => outcome_accepted(true)
    Present { value: default } =>
      infer_judge_declared_position(
        position: position_binder_default(default: default),
        application: default,
        entries: entries,
        declarations: declarations,
        formal: InhabitanceFormal { parameter_identity: ^binder_default, declared: parts.type_node },
        produced_at: default,
        type_params: []
      )
  }
}

// AN ARROW'S BODY IS JUDGED AT ITS DECLARED RETURN. A fn lowers to an Arrow whose second positional
// child is the declared return and whose ^arrow_body_edge is the body
// (v2.compiler.body_lowering_fold body_lower_fn_decl_arrow). By the Arrow's settled row every child
// has folded, so the body's derived type is in `entries`, and the body is judged at the declared
// return through the same judge -- and so the same relation -- an argument meets at its formal. The
// Arrow's own type parameters are the obligation's type variables: a return that mentions one stays
// UndecidableGenericFormal, counted. An Arrow with no body is a signature (a fn type, a census-grade
// declaration) and owes nothing here; one with two bodies, or a body but no declared return, is a
// malformed Arrow and refuses.
fn infer_arrow_declared_return_check(node: Node, entries: List<InferredFactsEntry>, declarations: SymbolIndex) -> Outcome<Bool> {
  match node.kind {
    TypeNode { connective: Arrow } =>
      match arrow_body_target_lookup(children: node.children) {
        Ambiguous => outcome_rejected(infer_arrow_declared_return_shape_diagnostic(node: node))
        Found { target: body } =>
          match list_at_optional(xs: node_positional_child_targets(node: node), index: 1) {
            Absent => outcome_rejected(infer_arrow_declared_return_shape_diagnostic(node: node))
            Present { value: declared } =>
              infer_judge_declared_position(
                position: position_declared_return(),
                application: body,
                entries: entries,
                declarations: declarations,
                formal: InhabitanceFormal { parameter_identity: ^declared_return, declared: declared },
                produced_at: body,
                type_params: type_param_names(n: node)
              )
          }
        _ => outcome_accepted(true)
      }
    _ => outcome_accepted(true)
  }
}

fn infer_arrow_declared_return_shape_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_arrow_declared_return_shape_invalid,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// THE RESOLVED CARRIER REACHES THIS ROW BECAUSE THE PRODUCT ROW BENEATH IT ANSWERS A FIELD
// PROJECTION FIRST, and a projection needs the receiver's DECLARATION, which only the index in
// ResolvedTree supplies (infer_formation_facts_from_entries). Main introduced this row when it split
// the declared-return check out of infer_gather_settled_row; this lane had widened the product row it
// delegates to. The two are compatible -- the enclosing row already holds `resolved` -- and the
// parameter is threaded rather than reconstructed, so there is one carrier for the whole fold.
fn infer_gather_settled_unannotated_row(
  acc: InferGatherFoldAcc,
  merged_entries: List<InferredFactsEntry>,
  merged_pending: Diagnostics,
  partials: List<Node>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
      if infer_gather_acc_awaits_product_row(node: acc.node, entries: merged_entries) {
        match infer_record_construct_read(node: acc.node, resolved: resolved) {
          ConstructIsRecord { construct: construct } =>
            infer_gather_record_construct_row_on_entries(
              node: acc.node,
              construct: construct,
              entries: merged_entries,
              declarations: resolved.resolved_declarations,
              pending: merged_pending,
              partials: partials
            )
          ConstructIsVariantArm { construct: construct } =>
            infer_gather_variant_construct_row_on_entries(
              node: acc.node,
              construct: construct,
              entries: merged_entries,
              declarations: resolved.resolved_declarations,
              pending: merged_pending,
              partials: partials
            )
          ConstructNotARecord =>
            infer_gather_product_row_on_entries(
              node: acc.node,
              entries: merged_entries,
              pending: merged_pending,
              partials: partials,
              resolved: resolved
            )
        }
      } else {
        infer_gather_fold_acc_ok(
          node: acc.node,
          entries: merged_entries,
          pending: merged_pending,
          await_branch_row: acc.await_branch_row,
          await_match_row: acc.await_match_row,
          await_loop_row: acc.await_loop_row,
          await_transform_row: acc.await_transform_row,

          application_instances: acc.application_instances,
        children_remaining: 0
        )
      }
}

// THE STAGE'S ONE WALK IS A DEPENDENT-CHILD FOLD (v2.std.node fold_node_dependent), because one behavior
// row needs a sibling's settled result before its other child can be judged: a collection fold's step
// member formal is the fresh type variable function-value lowering minted, and only the Loop DOMAIN's
// synthesized type says what it stands for (gunbc.recurring_failure_mode
// infer_child_context_cannot_depend_on_a_sibling_result). So a fold-realized Loop folds its domain FIRST and
// its step under a frame that instantiates that variable; every other node keeps its authored order and
// hands its children the frame it was given, unchanged, which is fold_node's walk exactly.
// THE FRAME IS LEXICAL AND SCOPED TO THE STEP SUBTREE. Type-variable instances are the same
// List<TypeVariableInstance> an application instantiates its callee's parameters with
// (v2.std.inhabitance). Match-arm payload binders add InferBinderType rows keyed by binder site:
// the gather enters the arm after the scrutinee has settled, so those rows are the instantiated
// payload-field types the body's references consume. infer_lexical_reference_facts reads both.
type InferFrame {
  instances: List<TypeVariableInstance>
  binder_types: List<InferBinderType>
  entering: InferFrameEntry
}

// What the frame brings INTO the subtree it opens, charged once at that subtree's root: nothing; a
// counted advisory that the member could not be instantiated (the variable stays uninstantiated, and the
// census sees why); or a located refusal (an authored member formal the member does not inhabit).
type InferFrameEntry
  = InferFrameEnteredPlain
  | InferFrameEnteredWith { advisory: NonEmptyDiagnostics }
  | InferFrameEnteredRefused { refused: NonEmptyDiagnostics }

fn infer_root_frame() -> InferFrame {
  InferFrame { instances: infer_no_type_variable_instances(), binder_types: infer_no_binder_types(), entering: InferFrameEnteredPlain }
}

fn infer_frame_inherited(frame: InferFrame) -> InferFrame {
  InferFrame { instances: frame.instances, binder_types: frame.binder_types, entering: InferFrameEnteredPlain }
}

// A binder's declared type, read through the frame: a type variable the frame instantiates IS its instance.
fn infer_frame_instantiated(declared: Node, instances: List<TypeVariableInstance>) -> Node {
  match node_atom_identity_optional(node: declared) {
    Present { value: id } =>
      match type_variable_instance_lookup(instances: instances, binder: id) {
        Present { value: instance } => instance
        Absent => declared
      }
    Absent => declared
  }
}

fn infer_loop_member_role(loop_node: Node) -> Optional<FoldMemberRole> {
  match loop_realized_declaration_target(children: loop_node.children) {
    Found { target: realized } => fold_realized_member_role(realized: realized)
    Ambiguous => Absent
    Absent => Absent
  }
}

fn infer_loop_takes_collection_member(loop_node: Node) -> Bool {
  match infer_loop_member_role(loop_node: loop_node) {
    Present { value: FoldStepTakesCollectionMember } => true
    Present { value: FoldStepTakesNoMember } => false
    Absent => false
  }
}

fn infer_fold_member_advisory(reason: Symbol, at: Node) -> NonEmptyDiagnostics {
  diagnostics_singleton(d: Diagnostic {
    reason: reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: CorrectionNotModeled }
  })
}

fn infer_frame_with_advisory(frame: InferFrame, reason: Symbol, at: Node) -> InferFrame {
  InferFrame { instances: frame.instances, binder_types: frame.binder_types, entering: InferFrameEnteredWith { advisory: infer_fold_member_advisory(reason: reason, at: at) } }
}

// THE DEPENDENT CHILD'S FRAME: the domain's settled type (already folded into `acc`, because the domain is
// scheduled first), its member by the fold realization's relation, and the step's member formal by ROLE.
// Every arm that cannot instantiate says so, typed and located, rather than leaving the variable to fall
// silently into the non-refusing ReceiverTypeUnderived arm.
fn infer_fold_member_frame(loop_node: Node, frame: InferFrame, acc: InferGatherFoldAcc, step: Node, resolved: ResolvedTree) -> InferFrame {
  match loop_domain_value_target(children: loop_node.children) {
    Found { target: domain } =>
      match lookup_inferred_facts_in_entries(entries: acc.entries, key: domain) {
        Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_type_not_derived, at: domain)
        Present { value: facts } =>
          match inferred_facts_resolved_type(facts: facts) {
            Violates { diagnostic: _ } => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_type_not_derived, at: domain)
            Holds { value: domain_type } =>
              match fold_collection_member_type(domain_type: domain_type) {
                Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_not_a_collection, at: domain)
                Present { value: member } =>
                  match fold_step_member_formal(step: step) {
                    Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_formal_unread, at: step)
                    Present { value: formal } => infer_fold_member_formal_frame(frame: frame, formal: formal, member: member, step: step, resolved: resolved)
                  }
              }
          }
      }
    Ambiguous => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_type_not_derived, at: loop_node)
    Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_domain_type_not_derived, at: loop_node)
  }
}

// A FRESH FORMAL IS INSTANTIATED; AN AUTHORED ONE IS JUDGED -- for the member formal against the domain's
// element, and for the carrier formal against init's type (infer_fold_carrier_frame), by one route. The member must inhabit an authored
// formal through the same declared_type_inhabitance fold an application argument meets at its formal, so
// `fn(acc, e: Int)` over a List<Edge> refuses at that formal rather than typing `e` as either.
fn infer_fold_member_formal_frame(frame: InferFrame, formal: FoldMemberFormal, member: Node, step: Node, resolved: ResolvedTree) -> InferFrame {
  match node_atom_identity_optional(node: formal.formal.type_node) {
    Present { value: variable } =>
      if formal.fresh {
        InferFrame {
          instances: list_snoc_item(xs: frame.instances, item: TypeVariableInstance { binder: variable, instance: member }),
          binder_types: frame.binder_types,
          entering: InferFrameEnteredPlain
        }
      } else {
        infer_fold_member_judged_frame(frame: frame, formal: formal, member: member, step: step, resolved: resolved)
      }
    Absent => infer_fold_member_judged_frame(frame: frame, formal: formal, member: member, step: step, resolved: resolved)
  }
}

fn infer_fold_member_judged_frame(frame: InferFrame, formal: FoldMemberFormal, member: Node, step: Node, resolved: ResolvedTree) -> InferFrame {
  let obligation = infer_declared_type_obligation(position: PositionDirectCallArgument, parameter_identity: formal.formal.name, declared: infer_declared_type_denotation(declared: formal.formal.type_node), produced: member, application: formal.formal.type_node, type_variables: type_param_names(n: step), declarations: resolved.resolved_declarations)
  match declared_type_inhabitance(obligation: obligation) {
    Inhabits { homomorphism: _ } => InferFrame { instances: frame.instances, binder_types: frame.binder_types, entering: InferFrameEnteredPlain }
    InhabitanceUndecidable { reason: _ } =>
      infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_formal_undecided, at: formal.formal.type_node)
    InhabitanceRefused { find_witness_reason: fw_reason } =>
      InferFrame {
        instances: frame.instances,
        binder_types: frame.binder_types,
        entering: InferFrameEnteredRefused {
          refused: diagnostics_singleton(d: application_argument_does_not_inhabit_diagnostic(obligation: obligation, find_witness_reason: fw_reason))
        }
      }
  }
}

fn infer_gather_child_context(parent: Node, frame: InferFrame, acc: InferGatherFoldAcc, edge: Edge, resolved: ResolvedTree) -> InferFrame {
  match edge.label {
    Positional =>
      if infer_bind_encodes_collection_fold(bind: parent) && infer_loop_takes_collection_member(loop_node: edge.target) {
        infer_fold_carrier_frame(bind: parent, frame: infer_frame_inherited(frame: frame), acc: acc, loop_node: edge.target, resolved: resolved)
      } else if infer_loop_takes_collection_member(loop_node: parent) {
        infer_fold_member_frame(loop_node: parent, frame: infer_frame_inherited(frame: frame), acc: acc, step: edge.target, resolved: resolved)
      } else {
        match parent.kind {
          ComputationNode { behavior: Match } =>
            infer_match_arm_child_frame(parent: parent, frame: frame, acc: acc, edge: edge, resolved: resolved)
          ComputationNode { behavior: Transform } =>
            infer_application_actual_child_frame(parent: parent, frame: frame, acc: acc, edge: edge, resolved: resolved)
          ComputationNode { behavior: _ } => infer_frame_inherited(frame: frame)
          TypeNode { connective: _ } => infer_frame_inherited(frame: frame)
        }
      }
    Authored { name: _ } =>
      match parent.kind {
        ComputationNode { behavior: Transform } =>
          infer_application_actual_child_frame(parent: parent, frame: frame, acc: acc, edge: edge, resolved: resolved)
        ComputationNode { behavior: _ } => infer_frame_inherited(frame: frame)
        TypeNode { connective: _ } => infer_frame_inherited(frame: frame)
      }
    StructuralLabel { label: _ } => infer_frame_inherited(frame: frame)
  }
}

// AN UNDECLARED LAMBDA ACTUAL IS TYPED FROM THE FORMAL OF THIS APPLICATION, after the actuals
// that precede it in authored order have been judged. The prefix is acc.application_instances,
// carried by infer_gather_extend_application_instances; it is not recomputed. A lambda before
// the actual that instantiates T (f-before-o) sees no instance; T stays underived and is never
// minted (infer_operand_declared_type_instantiated). Binder types share InferFrame.binder_types.
fn infer_application_actual_child_frame(parent: Node, frame: InferFrame, acc: InferGatherFoldAcc, edge: Edge, resolved: ResolvedTree) -> InferFrame {
  match parent.children {
    Empty => infer_frame_inherited(frame: frame)
    Cons { head: callee, tail: _ } =>
      if callee.target == edge.target {
        infer_frame_inherited(frame: frame)
      } else {
        match infer_application_lambda_expected_binder_types(
          application: parent,
          actual: edge.target,
          entries: acc.entries,
          resolved: resolved,
          instances: acc.application_instances
        ) {
          Absent => infer_frame_inherited(frame: frame)
          Present { value: rows } =>
            InferFrame {
              instances: frame.instances,
              binder_types: infer_append_binder_types(xs: frame.binder_types, ys: rows),
              entering: InferFrameEnteredPlain
            }
        }
      }
  }
}

type InferActualIndexWalk {
  idx: Int
  found: Optional<Int>
}

fn infer_actual_authored_index(actuals: List<Edge>, actual: Node) -> Optional<Int> {
  fold(actuals, init: InferActualIndexWalk { idx: 0, found: optional_absent() }, f: fn(acc, e) {
    match acc.found {
      Present { value: _ } => acc
      Absent =>
        if e.target == actual {
          InferActualIndexWalk { idx: acc.idx, found: optional_present(value: acc.idx) }
        } else {
          InferActualIndexWalk { idx: acc.idx + 1, found: acc.found }
        }
    }
  }).found
}

fn infer_application_lambda_expected_binder_types(
  application: Node,
  actual: Node,
  entries: List<InferredFactsEntry>,
  resolved: ResolvedTree,
  instances: List<TypeVariableInstance>
) -> Optional<List<InferBinderType>> {
  match infer_operator_arrow(operator: actual) {
    Absent => optional_absent()
    Present { value: lambda } =>
      match infer_actual_authored_index(actuals: application_actual_edges(site: application), actual: actual) {
        Absent => optional_absent()
        Present { value: idx } =>
          match infer_application_formal_at(application: application, entries: entries, idx: idx) {
            Absent => optional_absent()
            Present { value: formal } =>
              match infer_operand_declared_type_instantiated(
                declared: infer_type_instantiated(t: formal.declared, instances: instances),
                instances: instances
              ) {
                Absent => optional_absent()
                Present { value: expected } =>
                  if infer_declared_type_mentions_free_formal(declared: expected, instances: instances) {
                    optional_absent()
                  } else {
                    infer_lambda_domain_binder_types(lambda: lambda, expected: expected)
                  }
              }
          }
      }
  }
}

fn infer_application_formal_at(application: Node, entries: List<InferredFactsEntry>, idx: Int) -> Optional<InhabitanceFormal> {
  match infer_application_formals(node: application, entries: entries) {
    FormalsUnresolved => optional_absent()
    FormalsOrderRefused { reason: _ } => optional_absent()
    FormalsInDeclaredOrder { formals: formals } =>
      match infer_application_formal_args(node: application, formals: formals, entries: entries) {
        Rejected { diagnostics: _ } => optional_absent()
        Accepted { value: pairs, diagnostics: _ } =>
          match list_at_optional(xs: pairs, index: idx) {
            Absent => optional_absent()
            Present { value: pair } => optional_present(value: pair.formal)
          }
      }
  }
}

fn infer_lambda_domain_binder_types(lambda: Node, expected: Node) -> Optional<List<InferBinderType>> {
  match list_at_optional(xs: node_positional_child_targets(node: lambda), index: 0) {
    Absent => optional_absent()
    Present { value: domain } =>
      match infer_lambda_domain_binder_count(domain: domain) {
        Absent => optional_absent()
        Present { value: n } =>
          if n == 0 {
            optional_absent()
          } else {
            match infer_expected_domain_types(expected: expected) {
              Absent => optional_absent()
              Present { value: types } =>
                if length(xs: types) == n {
                  optional_present(
                    value: list_map(xs: types, f: fn(t) {
                      InferBinderType { site: lambda.occurrence_id, derived: t }
                    })
                  )
                } else {
                  optional_absent()
                }
            }
          }
      }
  }
}

fn infer_lambda_domain_binder_count(domain: Node) -> Optional<Int> {
  match domain.kind {
    TypeNode { connective: Conj } =>
      optional_present(
        value: fold(domain.children, init: 0, f: fn(n, e) {
          match e.label {
            Authored { name: _ } => n + 1
            Positional => n
            StructuralLabel { label: _ } => n
          }
        })
      )
    TypeNode { connective: _ } => optional_absent()
    ComputationNode { behavior: _ } => optional_absent()
  }
}

fn infer_expected_domain_types(expected: Node) -> Optional<List<Node>> {
  match infer_operator_arrow(operator: expected) {
    Present { value: arrow } =>
      match list_at_optional(xs: node_positional_child_targets(node: arrow), index: 0) {
        Absent => optional_absent()
        Present { value: domain } => infer_expected_domain_types(expected: domain)
      }
    Absent =>
      match expected.kind {
        TypeNode { connective: Conj } =>
          fold(expected.children, init: Present { value: Empty }, f: fn(acc, e) {
            match acc {
              Absent => Absent
              Present { value: ts } =>
                match member_edge_type_node(e: e) {
                  Absent => Absent
                  Present { value: t } => Present { value: list_snoc_item(xs: ts, item: t) }
                }
            }
          })
        TypeNode { connective: _ } => optional_present(value: [expected])
        ComputationNode { behavior: _ } => optional_present(value: [expected])
      }
  }
}

fn infer_append_binder_types(xs: List<InferBinderType>, ys: List<InferBinderType>) -> List<InferBinderType> {
  fold(ys, init: xs, f: fn(acc, y) { list_snoc_item(xs: acc, item: y) })
}

// THE MATCH ARM IS ENTERED AFTER THE SCRUTINEE HAS SETTLED. The arm body -- including a construct
// that consumes a payload binder as a field value -- is gathered before the match row, so the
// binder's derived type must be on the frame at this boundary or the inhabitance judgment sees
// GroundingNotDerived / a spelling that does not inhabit the resolved field.
fn infer_match_arm_child_frame(parent: Node, frame: InferFrame, acc: InferGatherFoldAcc, edge: Edge, resolved: ResolvedTree) -> InferFrame {
  match list_at_optional(xs: node_positional_child_targets(node: parent), index: 0) {
    Absent => infer_frame_inherited(frame: frame)
    Present { value: scrutinee } =>
      if scrutinee == edge.target {
        infer_frame_inherited(frame: frame)
      } else {
        match lookup_inferred_facts_in_entries(entries: acc.entries, key: scrutinee) {
          Absent => infer_match_arm_refuse_unpaid_or_inherit(frame: frame, arm: edge.target, resolved: resolved)
          Present { value: facts } =>
            match inferred_facts_resolved_type(facts: facts) {
              Violates { diagnostic: _ } => infer_match_arm_refuse_unpaid_or_inherit(frame: frame, arm: edge.target, resolved: resolved)
              Holds { value: scrutinee_type } =>
                match infer_match_coproduct_of_type(scrutinee_type: scrutinee_type, resolved: resolved) {
                  CoproductNotDeclared => infer_match_arm_refuse_unpaid_or_inherit(frame: frame, arm: edge.target, resolved: resolved)
                  CoproductArityMismatch => infer_match_arm_refuse_unpaid_or_inherit(frame: frame, arm: edge.target, resolved: resolved)
                  CoproductRead { coproduct: coproduct } =>
                    match infer_match_arm_binder_types(arm: edge.target, coproduct: coproduct) {
                      MatchArmFormalUndischarged { at: at } => infer_match_arm_formal_refused(frame: frame, at: at)
                      MatchArmBinders { rows: rows } =>
                        InferFrame {
                          instances: frame.instances,
                          binder_types: infer_append_binder_types(xs: frame.binder_types, ys: rows),
                          entering: InferFrameEnteredPlain
                        }
                    }
                }
            }
        }
      }
  }
}

// Cannot CoproductRead: instantiate from no scrutinee arguments (empty instances). An unpaid
// formal-payload binder refuses at this grain; inherit only when the arm owes none.
fn infer_match_arm_formal_refused(frame: InferFrame, at: Node) -> InferFrame {
  InferFrame {
    instances: frame.instances,
    binder_types: frame.binder_types,
    entering: InferFrameEnteredRefused {
      refused: diagnostics_singleton(d: Diagnostic {
        reason: ^infer_reason_pattern_payload_formal_uninstantiated,
        at: node_locus(node: at),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    }
  }
}

fn infer_match_arm_refuse_unpaid_or_inherit(frame: InferFrame, arm: Node, resolved: ResolvedTree) -> InferFrame {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => infer_frame_inherited(frame: frame)
    Accepted { value: pat, diagnostics: _ } =>
      match construct_tag_path_optional(n: pat) {
        Absent => infer_frame_inherited(frame: frame)
        Present { value: arm_path } =>
          match qualified_name_init(qn: arm_path) {
            Empty => infer_frame_inherited(frame: frame)
            Cons { head: _, tail: _ } =>
              match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: qualified_name_init(qn: arm_path)) {
                Absent => infer_frame_inherited(frame: frame)
                Present { value: declared } =>
                  match declared.kind {
                    TypeNode { connective: Disj } =>
                      match infer_match_arm_binder_types(
                        arm: arm,
                        coproduct: InferMatchCoproduct {
                          path: qualified_name_init(qn: arm_path),
                          variants: declared,
                          instances: infer_no_type_variable_instances()
                        }
                      ) {
                        MatchArmFormalUndischarged { at: at } => infer_match_arm_formal_refused(frame: frame, at: at)
                        MatchArmBinders { rows: _ } => infer_frame_inherited(frame: frame)
                      }
                    TypeNode { connective: _ } => infer_frame_inherited(frame: frame)
                    ComputationNode { behavior: _ } => infer_frame_inherited(frame: frame)
                  }
              }
          }
      }
  }
}

type InferMatchArmBinders
  = MatchArmBinders { rows: List<InferBinderType> }
  | MatchArmFormalUndischarged { at: Node }

fn infer_match_arm_binders_empty() -> InferMatchArmBinders {
  MatchArmBinders { rows: infer_no_binder_types() }
}

fn infer_derived_field_still_mentions_a_free_formal(derived: Node) -> Bool {
  infer_declared_type_mentions_free_formal(declared: derived, instances: infer_no_type_variable_instances())
}

fn infer_match_arm_binder_types(arm: Node, coproduct: InferMatchCoproduct) -> InferMatchArmBinders {
  match find_core_child(root: arm, marker: MatchArmPatternEdge) {
    Rejected { diagnostics: _ } => infer_match_arm_binders_empty()
    Accepted { value: pat, diagnostics: _ } =>
      match infer_coproduct_arm_pattern(pat: pat) {
        ArmPatternUnread => infer_match_arm_binders_empty()
        ArmPatternWildcard => infer_match_arm_binders_empty()
        ArmPatternVariant { tag: tag, fields: fields } =>
          match infer_match_variant_payload(variants: coproduct.variants, tag: tag) {
            Absent => infer_match_arm_binders_empty()
            Present { value: payload } =>
              fold(fields, init: infer_match_arm_binders_empty(), f: fn(acc, e) {
                match acc {
                  MatchArmFormalUndischarged { at: _ } => acc
                  MatchArmBinders { rows: rows } =>
                    match e.label {
                      Positional => acc
                      StructuralLabel { label: _ } => acc
                      Authored { name: field } =>
                        if is_wildcard_pattern(pattern: e.target) {
                          acc
                        } else {
                        match infer_conj_named_type_for_binding(domain: payload, binding: field) {
                          Absent => acc
                          Present { value: field_type } =>
                            match infer_match_field_type_instantiated(field_type: field_type, instances: coproduct.instances) {
                              Absent =>
                                if infer_declared_type_mentions_free_formal(declared: field_type, instances: coproduct.instances) {
                                  MatchArmFormalUndischarged { at: e.target }
                                } else {
                                  acc
                                }
                              Present { value: derived } =>
                                if infer_derived_field_still_mentions_a_free_formal(derived: derived) {
                                  MatchArmFormalUndischarged { at: e.target }
                                } else {
                                  MatchArmBinders {
                                    rows: list_snoc_item(
                                      xs: rows,
                                      item: InferBinderType { site: e.target.occurrence_id, derived: derived }
                                    )
                                  }
                                }
                            }
                        }
                        }
                    }
                }
              })
          }
      }
  }
}

// THE FOLD ENCODING'S BIND: `Bind { slot := init, Loop { step, domain, .. } }` (v2.compiler.fold_lowering
// fold_recurrence_encoding), recognised by its body's realization role and never by shape alone.
fn infer_bind_encodes_collection_fold(bind: Node) -> Bool {
  match bind.kind {
    ComputationNode { behavior: Bind } =>
      match list_at_optional(xs: node_positional_child_targets(node: bind), index: 2) {
        Present { value: body } => infer_loop_takes_collection_member(loop_node: body)
        Absent => false
      }
    ComputationNode { behavior: Value } => false
    ComputationNode { behavior: Transform } => false
    ComputationNode { behavior: Branch } => false
    ComputationNode { behavior: Loop } => false
    ComputationNode { behavior: Match } => false
    TypeNode { connective: _ } => false
  }
}

fn infer_bind_value(bind: Node) -> Optional<Node> {
  list_at_optional(xs: node_positional_child_targets(node: bind), index: 1)
}

// THE CARRIER FORMAL IS INSTANTIATED FROM INIT, as the member formal is from the domain: the Bind's value
// (init) is folded before its body in authored order, so its settled type is in `acc` when the Loop is
// entered, and the step's actual-0 formal -- read by ROLE -- stands for it throughout the Loop subtree.
fn infer_fold_carrier_frame(bind: Node, frame: InferFrame, acc: InferGatherFoldAcc, loop_node: Node, resolved: ResolvedTree) -> InferFrame {
  match infer_bind_value(bind: bind) {
    Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_carrier_type_not_derived, at: bind)
    Present { value: init } =>
      match infer_settled_type_at(target: init, entries: acc.entries) {
        Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_carrier_type_not_derived, at: init)
        Present { value: carrier } =>
          match fold_loop_step(loop_node: loop_node) {
            Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_formal_unread, at: loop_node)
            Present { value: step } =>
              match fold_step_carrier_formal(step: step) {
                Absent => infer_frame_with_advisory(frame: frame, reason: ^infer_reason_fold_member_formal_unread, at: step)
                Present { value: formal } => infer_fold_member_formal_frame(frame: frame, formal: formal, member: carrier, step: step, resolved: resolved)
              }
          }
      }
  }
}

fn infer_settled_type_at(target: Node, entries: List<InferredFactsEntry>) -> Optional<Node> {
  match lookup_inferred_facts_in_entries(entries: entries, key: target) {
    Absent => Absent
    Present { value: facts } =>
      match infer_branch_operand_resolved_type(node: target, facts: facts) {
        Holds { value: t } => Present { value: t }
        Violates { diagnostic: _ } => Absent
      }
  }
}

// THE FOLD BIND'S ROW: what one step produces must inhabit the carrier. With a declared step return both
// judgements are made -- the body inhabits the declared return, and the declared return inhabits the carrier
// -- so a declared return can neither hide a body mismatch nor widen past the carrier. A side whose type is
// not derived is a counted advisory, never a pass.
fn infer_fold_bind_check(node: Node, entries: List<InferredFactsEntry>, resolved: ResolvedTree) -> Outcome<Bool> {
  match infer_bind_value(bind: node) {
    Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_carrier_type_not_derived, at: node) } }
    Present { value: init } =>
      match infer_settled_type_at(target: init, entries: entries) {
        Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_carrier_type_not_derived, at: init) } }
        Present { value: carrier } =>
          match list_at_optional(xs: node_positional_child_targets(node: node), index: 2) {
            Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_member_formal_unread, at: node) } }
            Present { value: loop_node } =>
              match fold_loop_step(loop_node: loop_node) {
                Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_member_formal_unread, at: loop_node) } }
                Present { value: step } =>
                  match fold_step_body_node(step: step) {
                    Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_member_formal_unread, at: step) } }
                    Present { value: body } =>
                      match infer_settled_type_at(target: body, entries: entries) {
                        Absent => Accepted { value: true, diagnostics: Some { diagnostics: infer_fold_member_advisory(reason: ^infer_reason_fold_step_body_type_not_derived, at: body) } }
                        Present { value: produced } =>
                          match fold_step_declared_return(step: step) {
                            Absent => infer_fold_judge(declared: carrier, produced: produced, at: body, step: step, resolved: resolved)
                            Present { value: declared_return } =>
                              bind_outcome(
                                o: infer_fold_judge(declared: declared_return, produced: produced, at: body, step: step, resolved: resolved),
                                f: fn(_) { infer_fold_judge(declared: carrier, produced: infer_declared_type_denotation(declared: declared_return), at: declared_return, step: step, resolved: resolved) }
                              )
                          }
                      }
                  }
              }
          }
      }
  }
}

fn infer_fold_judge(declared: Node, produced: Node, at: Node, step: Node, resolved: ResolvedTree) -> Outcome<Bool> {
  let obligation = infer_declared_type_obligation(position: position_declared_return(), parameter_identity: ^fold_carrier, declared: infer_declared_type_denotation(declared: declared), produced: produced, application: at, type_variables: type_param_names(n: step), declarations: resolved.resolved_declarations)
  match declared_type_inhabitance(obligation: obligation) {
    Inhabits { homomorphism: _ } => Accepted { value: true, diagnostics: None }
    InhabitanceUndecidable { reason: reason } => infer_inhabitance_undecidable_accepted(application: at, reason: reason)
    InhabitanceRefused { find_witness_reason: fw_reason } =>
      outcome_rejected(application_argument_does_not_inhabit_diagnostic(obligation: obligation, find_witness_reason: fw_reason))
  }
}

fn infer_gather_fold_bind_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
  kinds: List<RosterKindIndex>,
  resolved: ResolvedTree,
) -> InferGatherFoldAcc {
  match infer_fold_bind_check(node: node, entries: entries, resolved: resolved) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,

        application_instances: infer_no_type_variable_instances(),
        children_remaining: 0
      )
    Accepted { value: _, diagnostics: d } =>
      infer_gather_transform_frontier_on_entries(
        node: node,
        entries: entries,
        pending: diagnostics_merge(outer: pending, inner: d),
        partials: partials,
        kinds: kinds,
        resolved: resolved,
        instances: infer_no_type_variable_instances(),
        binder_types: infer_no_binder_types()
      )
  }
}

fn infer_gather_schedules_first(parent: Node, edge: Edge) -> Bool {
  match loop_edge_role(e: edge) {
    LoopDomainValue => infer_loop_takes_collection_member(loop_node: parent)
    LoopIteratedBody => false
    LoopBoundMeasure => false
    LoopCarrierBinder => false
    LoopRealizedDeclaration => false
    LoopEdgeUnrecognized => false
  }
}

// The frame's entry is charged at the subtree root it opens, after that root's own init.
fn infer_gather_framed_init(acc: InferGatherFoldAcc, frame: InferFrame) -> InferGatherFoldAcc {
  match frame.entering {
    InferFrameEnteredPlain => acc
    InferFrameEnteredWith { advisory: a } =>
      InferGatherFoldAcc {
        node: acc.node,
        entries: acc.entries,
        failed: acc.failed,
        pending: diagnostics_merge(outer: Some { diagnostics: a }, inner: acc.pending),
        await_branch_row: acc.await_branch_row,
        await_match_row: acc.await_match_row,
        await_loop_row: acc.await_loop_row,
        await_transform_row: acc.await_transform_row,

        application_instances: acc.application_instances,
        children_remaining: acc.children_remaining
      }
    InferFrameEnteredRefused { refused: r } =>
      infer_gather_fold_acc_failed(
        node: acc.node,
        pending: rejected_with_pending(pending: acc.pending, rejected: r),
        await_branch_row: acc.await_branch_row,
        await_match_row: acc.await_match_row,
        await_loop_row: acc.await_loop_row,
        await_transform_row: acc.await_transform_row,

        application_instances: acc.application_instances,
        children_remaining: acc.children_remaining
      )
  }
}

fn infer_gather_fold_algebra(partials: List<Node>, kinds: List<RosterKindIndex>, resolved: ResolvedTree) -> NodeFoldDependent<InferFrame, InferGatherFoldAcc> {
  NodeFoldDependent {
    init: fn(n0, frame) {
      infer_gather_framed_init(
        acc: infer_gather_fold_init(n: n0, partials: partials, kinds: kinds, resolved: resolved, instances: frame.instances, binder_types: frame.binder_types),
        frame: frame
      )
    },
    first: fn(parent, e) { infer_gather_schedules_first(parent: parent, edge: e) },
    child_context: fn(parent, frame, acc, e) {
      infer_gather_child_context(parent: parent, frame: frame, acc: acc, edge: e, resolved: resolved)
    },
    step: fn(acc, e, child) {
      infer_gather_fold_step(acc: acc, edge: e, child: child, partials: partials, kinds: kinds, resolved: resolved)
    }
  }
}

fn infer_grounding_admits_infer_facts(grounding: CanonicalGrounding) -> Bool {
  canonical_grounding_admits_infer_facts(grounding: grounding)
}

fn infer_entries_for_tree(tree: ResolvedTree) -> Outcome<List<InferredFactsEntry>> {
  let partials = partial_bounded_lattice_instances_in_tree(tree: tree.root)
  let kinds = infer_language_inhabitants_kind_index()
  infer_gather_acc_to_outcome(
    acc: fold_node_dependent(n: tree.root, ctx: infer_root_frame(), algebra: infer_gather_fold_algebra(partials: partials, kinds: kinds, resolved: tree))
  )
}
// INFER'S OUTPUT IS THE OBLIGATED FORM, never an InferredTree: v2.compiler.refinement_discharge
// discharge_refinement_obligations is the one route onward. No obligation is recorded yet -- the
// producer is the literal-into-refinement cast arm, which lands once where-predicates bind to their
// declarations (node adhoc-46630399-82b); until then every tree discharges with nothing to evaluate.
// INFER ADMITS ONLY A WELL-FORMED TREE. Resolve refuses an ill-formed root, but infer is also entered
// directly with a ResolvedTree, so the Node-admission wall (v2.std.node well_formed -- including A4's
// Named-binder domain without an order edge) is held here too, and the rung is the same on every path.
fn infer(tree: ResolvedTree) -> Outcome<ObligatedInferredTree> {
  if !well_formed(n: tree.root) {
    outcome_rejected(infer_malformed_tree_diagnostic(n: tree.root))
  } else {
    infer_well_formed(tree: tree)
  }
}

fn infer_malformed_tree_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^infer_reason_malformed_tree,
    at: node_locus(node: n),
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn infer_well_formed(tree: ResolvedTree) -> Outcome<ObligatedInferredTree> {
  match infer_entries_for_tree(tree: tree) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: entries, diagnostics: d } =>
      match facts_map_from_entries(entries: entries) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: facts_map, diagnostics: md } =>
          Accepted {
            value: ObligatedInferredTree {
              root: tree.root,
              facts: facts_map,
              obligations: Empty
            },
            diagnostics: diagnostics_merge(outer: d, inner: md)
          }
      }
  }
}
