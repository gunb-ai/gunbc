// src/v2/compiler/04_infer.dag
// Scope: Stage 4 — ResolvedTree -> InferredTree; bounded Find phase (DECISIONS C1 / IR-1).
// Status: T-9 modeled — coercion substrate in std/coercion.dag. Option B: canonical_grounding_from_inferred_facts fails-closed on bare-Atom algebra references (bridge-symbol guard).
// Anchor: https://en.wikipedia.org/wiki/Type_inference

module v2.compiler.infer

import v2.std.algebra { length, list_snoc_item }
// kernel-mark: SG-6 gate imports — `_bounded` substring is BoundedLattice domain naming, not fuel.
import v2.std.bounded_lattice_completeness {
  infer_bounded_lattice_consumer_gate,
  partial_bounded_lattice_instances_in_tree
}
import v2.compiler.resolve { ResolvedTree }
import v2.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v2.std.collection {
  Absent,
  List,
  Map,
  Present,
  list_at_optional
}
import v2.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness,
  ConstraintGraph,
  ConstraintSolvePolicy,
  solve_constraints
}
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  node_locus,
  Outcome,
  Unavailable,
  Accepted,
  None,
  Rejected,
  bind_outcome,
  diagnostics_merge,
  diagnostics_singleton,
  outcome_rejected,
  rejected_with_pending
}
import v2.std.logic { Bool, bool_node }
import v2.std.node {
  Atom,
  Branch,
  ComputationNode,
  Edge,
  Node,
  NodeFold,
  Symbol,
  SyntheticOccurrence,
  TypeNode,
  all_edges_positional,
  fold_node,
  well_formed
}
import v2.std.node_query { node_positional_child_targets }
import v2.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }

// AlgebraRef is the typed IR-1 bridge for algebra inhabitance coordinates.
type AlgebraRef {
  algebra: Node
  witness: Node
}

// InferredFacts bundles CanonicalGrounding + descent. std/constraints.dag
// CanonicalGrounding is not yet proof-by-construction (scaffold:T-9-ground) — infer
// enforces admission at construction and re-export via canonical_grounding_admits_infer_facts
// until std/constraints lands a structural carrier for node/witness/closedness alignment.
type InferredFacts {
  grounding: CanonicalGrounding
  descent: Witness<TerminationProof>
}

// Subject node (map key / grounding.node) vs resolved value type (structural algebra witness).
fn inferred_facts_resolved_type(facts: InferredFacts) -> Node {
  facts.grounding.witness.structural.evidence
}

fn inferred_facts_algebra_ref(facts: InferredFacts) -> AlgebraRef {
  algebra_ref_from_grounding(grounding: facts.grounding)
}

fn inferred_facts_canonical_witness(facts: InferredFacts) -> CanonicalGroundingWitness {
  facts.grounding.witness
}

fn inferred_facts_descent(facts: InferredFacts) -> Witness<TerminationProof> {
  facts.descent
}

type InferredTree {
  root: Node
  facts: Map<Node, InferredFacts>
}

type InferredFactsEntry {
  node: Node
  facts: InferredFacts
}

// Named fold carrier — avoids nested Outcome<List<InferredFactsEntry>> in gather init (parser).
type InferGatherFoldAcc {
  node: Node
  entries: List<InferredFactsEntry>
  failed: Bool
  pending: Diagnostics
  await_branch_row: Bool
  children_remaining: Int
}

data infer_descent_not_derived: Symbol = infer_descent_not_derived
data infer_facts_lookup_miss: Symbol = infer_facts_lookup_miss
data infer_canonical_grounding_incoherent: Symbol = infer_canonical_grounding_incoherent
// 🟢 SM5-satisfied: v2 bootstrap on src/v2 emits 0 infer_algebra_ref_ungrounded diagnostics (2026-05-26); guard dissolves when T-4 Wave 2b/T-2 populate AlgebraRef from grounded algebra Node constructors.
data infer_algebra_ref_ungrounded: Symbol = infer_algebra_ref_ungrounded
data infer_branch_shape_invalid: Symbol = infer_branch_shape_invalid
data infer_branch_cond_not_bool: Symbol = infer_branch_cond_not_bool
data infer_branch_arm_type_mismatch: Symbol = infer_branch_arm_type_mismatch
data infer_gather_fold_failure: Symbol = infer_gather_fold_failure

// §1-tail A4 disposition (post-#4692): `_bounded` fuel residue = 0 in this stage.
// SG-6 BoundedLattice gather/gate → fuel-delete: rows in v2.std.bounded_lattice_completeness
// (fold_node owns traversal; fold_init/fold_step are algebra rows, not fuel).
// Constraint solve → kernel-mark: solve_constraints in v2.std.constraints (fixpoint; call-graph ≠ data-graph).

fn infer_facts_lookup_miss_diagnostic(key: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_facts_lookup_miss,
    at: node_locus(node: key),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn infer_canonical_grounding_incoherent_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_canonical_grounding_incoherent,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_algebra_ref_ungrounded_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_algebra_ref_ungrounded,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_branch_shape_invalid_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_branch_shape_invalid,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_branch_cond_not_bool_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_branch_cond_not_bool,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_branch_arm_type_mismatch_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_branch_arm_type_mismatch,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟡 gated — feature:infer-algebra-ref-grounding-fold — bind v2.compiler.infer://algebra-ref-grounded — dissolve-on-arrival: std/node.dag or std/model_core.dag exports the canonical grounded-algebra query.
fn algebra_ref_is_grounded(algebra: Node) -> Bool {
  match algebra.kind {
    TypeNode { connective: c } =>
      match c {
        Atom { identity: _ } => false
        _ => true
      }
    ComputationNode { behavior: _ } => false
  }
}

fn infer_descent_not_derived_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: infer_descent_not_derived,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// SPI-3: infer owns the reason symbol; substrate/cardinality owns the failing locus (fold preserves child Violates).
fn infer_descent_witness_for_node(n: Node) -> Witness<TerminationProof> {
  match termination_proof_witness_for_node(n: n) {
    Holds { value: proof } => Holds { value: proof }
    Violates { diagnostic: upstream } =>
      Violates {
        diagnostic: infer_descent_not_derived_diagnostic(at: upstream.at)
      }
  }
}

fn algebra_ref_from_grounding(grounding: CanonicalGrounding) -> AlgebraRef {
  AlgebraRef {
    algebra: grounding.witness.structural.evidence,
    witness: grounding.node
  }
}

// Infer admission gate — not a post-hoc InferredFacts field patch. Validates the
// algebra_ref_from_grounding / closedness alignment CanonicalGrounding must satisfy
// before infer accepts or re-exports grounding as authoritative.
fn canonical_grounding_admits_infer_facts(grounding: CanonicalGrounding) -> Bool {
  well_formed(n: grounding.node)
    && well_formed(n: grounding.witness.structural.evidence)
    && (grounding.witness.structural.property == ^constraint_property_being_canonical)
    && (grounding.witness.closedness.property == ^constraint_property_candidate_set_closedness)
    && (grounding.witness.closedness.evidence == grounding.node)
}

fn inferred_facts_construction(
  grounding: CanonicalGrounding,
  descent: Witness<TerminationProof>,
) -> Outcome<InferredFacts> {
  if canonical_grounding_admits_infer_facts(grounding: grounding) {
    Accepted {
      value: InferredFacts {
        grounding: grounding,
        descent: descent
      },
      diagnostics: None
    }
  } else {
    outcome_rejected(
      infer_canonical_grounding_incoherent_diagnostic(node: grounding.node)
    )
  }
}

fn inferred_facts_from_grounding(
  grounding: CanonicalGrounding,
  descent: Witness<TerminationProof>,
) -> Outcome<InferredFacts> {
  inferred_facts_construction(grounding: grounding, descent: descent)
}

fn empty_inferred_facts_entry_list() -> List<InferredFactsEntry> {
  []
}

fn concat_inferred_facts_entries(
  a: List<InferredFactsEntry>,
  b: List<InferredFactsEntry>,
) -> List<InferredFactsEntry> {
  fold(b, init: a, f: fn(acc, entry) {
    list_snoc_item(xs: acc, item: entry)
  })
}

fn infer_constraint_graph(n: Node) -> ConstraintGraph {
  ConstraintGraph { root: n }
}

// 🟡 gated — feature:branch-infer-constraint-solve-bridge —
// bind:github.com/gunb-ai/gunbc#4772 —
// dissolve-on: solve_constraints emits being_canonical at source; delete infer_grounding_from_constraint_solve.
fn infer_grounding_from_constraint_solve(grounding: CanonicalGrounding) -> CanonicalGrounding {
  CanonicalGrounding {
    node: grounding.node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: grounding.witness.structural.evidence
      },
      closedness: grounding.witness.closedness
    }
  }
}

// Route-scoped bridge: only infer_node_facts → solve_constraints calls this remapper.
fn infer_node_facts(n: Node, partials: List<Node>) -> Outcome<InferredFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: n, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: n) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          bind_outcome(
            o: solve_constraints(
              policy: ConstraintSolvePolicy {
                graph: infer_constraint_graph(n: n)
              }
            ),
            f: fn(grounding) {
              inferred_facts_from_grounding(
                grounding: infer_grounding_from_constraint_solve(grounding: grounding),
                descent: Holds { value: descent_proof }
              )
            }
          )
      }
  }
}

fn lookup_inferred_facts_in_entries(
  entries: List<InferredFactsEntry>,
  key: Node,
) -> Witness<InferredFacts> {
  fold(
    entries,
    init: Violates {
      diagnostic: infer_facts_lookup_miss_diagnostic(key: key)
    },
    f: fn(acc, entry) {
      match acc {
        Holds { value: _ } => acc
        Violates { diagnostic: _ } =>
          if entry.node == key {
            Holds { value: entry.facts }
          } else {
            acc
          }
      }
    }
  )
}

// Fail-closed map construction: rejects (with diagnostic) any entry where node != facts.grounding.node.
// admitted_inferred_facts_entry is the primary enforcement point; this function is the secondary
// fail-closed gate — it makes invariant violations visible as Rejected rather than silently dropping them.
fn facts_map_from_entries(entries: List<InferredFactsEntry>) -> Outcome<Map<Node, InferredFacts>> {
  match fold(entries, init: Accepted { value: empty_inferred_facts_entry_list(), diagnostics: None }, f: fn(acc, entry) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: ok_entries, diagnostics: d } =>
        if entry.node == entry.facts.grounding.node {
          Accepted { value: list_snoc_item(xs: ok_entries, item: entry), diagnostics: d }
        } else {
          Rejected {
            diagnostics: diagnostics_singleton(
              d: infer_canonical_grounding_incoherent_diagnostic(node: entry.node)
            )
          }
        }
    }
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: admitted, diagnostics: d } =>
      Accepted {
        value: Map {
          lookup: fn(key) {
            lookup_inferred_facts_in_entries(entries: admitted, key: key)
          }
        },
        diagnostics: d
      }
  }
}

fn inferred_facts_witness_for_node(tree: InferredTree, node: Node) -> Witness<InferredFacts> {
  tree.facts.lookup(node)
}

fn canonical_grounding_from_inferred_facts(
  node: Node,
  facts: InferredFacts,
) -> Outcome<CanonicalGrounding> {
  if node != facts.grounding.node {
    outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
  } else if !algebra_ref_is_grounded(algebra: inferred_facts_algebra_ref(facts: facts).algebra) {
    outcome_rejected(infer_algebra_ref_ungrounded_diagnostic(node: node))
  } else if canonical_grounding_admits_infer_facts(grounding: facts.grounding) {
    Accepted {
      value: facts.grounding,
      diagnostics: None
    }
  } else {
    outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
  }
}

// RULING-1: infer-authored canonical witness only — no compiler-side fabrication.
fn canonical_grounding_for_node(tree: InferredTree, node: Node) -> Outcome<CanonicalGrounding> {
  match inferred_facts_witness_for_node(tree: tree, node: node) {
    Holds { value: facts } =>
      canonical_grounding_from_inferred_facts(node: node, facts: facts)
    Violates { diagnostic: d } =>
      outcome_rejected(d)
  }
}

// Construction guard: enforces node == facts.grounding.node before admitting an entry.
// Prevents an InferredFactsEntry where the map key diverges from the grounding subject.
fn admitted_inferred_facts_entry(node: Node, facts: InferredFacts) -> Outcome<InferredFactsEntry> {
  if node == facts.grounding.node {
    Accepted {
      value: InferredFactsEntry { node: node, facts: facts },
      diagnostics: None
    }
  } else {
    outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
  }
}

fn infer_branch_int_binding_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn infer_branch_is_bool_literal_atom(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      (id == ^dag_token_kw_true) || (id == ^dag_token_kw_false)
    _ => false
  }
}

fn infer_branch_is_int_literal_atom(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      (id == ^dag_mvp1_pick_lit_one) || (id == ^dag_mvp1_pick_lit_two)
    _ => false
  }
}

// 🟡 gated — branch infer M0 literal operand typing — feature:branch-infer-literal-types —
// dissolve-on: github.com/gunb-ai/gunbc#4772 constraint carriers at infer_node_facts
// assign literal operand types during infer_node_facts instead of Branch-row semantic projection.
fn infer_branch_operand_resolved_type(node: Node, facts: InferredFacts) -> Node {
  if infer_branch_is_bool_literal_atom(node: node) {
    bool_node()
  } else if infer_branch_is_int_literal_atom(node: node) {
    infer_branch_int_binding_type_node()
  } else {
    inferred_facts_resolved_type(facts: facts)
  }
}

fn infer_branch_canonical_grounding(node: Node, unified_type: Node) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: unified_type
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

fn infer_branch_type_atoms_equal(a: Node, b: Node) -> Bool {
  match a.kind {
    TypeNode { connective: Atom { identity: id_a } } =>
      match b.kind {
        TypeNode { connective: Atom { identity: id_b } } => id_a == id_b
        _ => false
      }
    _ => a == b
  }
}

fn infer_branch_type_is_bool(type_node: Node) -> Bool {
  match type_node.kind {
    TypeNode { connective: Atom { identity: id } } => id == ^bool_node_symbol
    _ => false
  }
}

fn infer_unify_branch_arm_types(
  then_node: Node,
  then_facts: InferredFacts,
  else_node: Node,
  else_facts: InferredFacts,
) -> Outcome<Node> {
  let then_type = infer_branch_operand_resolved_type(node: then_node, facts: then_facts)
  let else_type = infer_branch_operand_resolved_type(node: else_node, facts: else_facts)
  if infer_branch_type_atoms_equal(a: then_type, b: else_type) {
    Accepted { value: then_type, diagnostics: None }
  } else {
    outcome_rejected(infer_branch_arm_type_mismatch_diagnostic(node: then_node))
  }
}

// Q-B2 gather-algebra row: Bool-if-else Branch — cond child typed Bool; arms unify to Branch result type.
fn infer_branch_bool_if_else(
  node: Node,
  partials: List<Node>,
  entries: List<InferredFactsEntry>,
) -> Outcome<InferredFacts> {
  let positional_targets = node_positional_child_targets(node: node)
  if !all_edges_positional(children: node.children) || length(xs: positional_targets) != 3 {
    outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
  } else {
    match list_at_optional(xs: positional_targets, index: 0) {
      Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
      Present { value: cond_target } =>
        match list_at_optional(xs: positional_targets, index: 1) {
          Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
          Present { value: then_target } =>
            match list_at_optional(xs: positional_targets, index: 2) {
              Absent => outcome_rejected(infer_branch_shape_invalid_diagnostic(node: node))
              Present { value: else_target } =>
                match lookup_inferred_facts_in_entries(entries: entries, key: cond_target) {
                  Violates { diagnostic: d } => outcome_rejected(d)
                  Holds { value: cond_facts } =>
                    match lookup_inferred_facts_in_entries(entries: entries, key: then_target) {
                      Violates { diagnostic: d } => outcome_rejected(d)
                      Holds { value: then_facts } =>
                        match lookup_inferred_facts_in_entries(entries: entries, key: else_target) {
                          Violates { diagnostic: d } => outcome_rejected(d)
                          Holds { value: else_facts } =>
                            match infer_bounded_lattice_consumer_gate(consumer: node, partials: partials) {
                              Rejected { diagnostics: r } => Rejected { diagnostics: r }
                              Accepted { value: _, diagnostics: cd } =>
                                if !infer_branch_type_is_bool(
                                  type_node: infer_branch_operand_resolved_type(
                                    node: cond_target,
                                    facts: cond_facts
                                  )
                                ) {
                                  outcome_rejected(infer_branch_cond_not_bool_diagnostic(node: node))
                                } else {
                                  match infer_unify_branch_arm_types(
                                    then_node: then_target,
                                    then_facts: then_facts,
                                    else_node: else_target,
                                    else_facts: else_facts
                                  ) {
                                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                                    Accepted { value: unified_type, diagnostics: ud } =>
                                      match infer_descent_witness_for_node(n: node) {
                                        Violates { diagnostic: d } =>
                                          Rejected { diagnostics: diagnostics_singleton(d: d) }
                                        Holds { value: descent_proof } =>
                                          bind_outcome(
                                            o: inferred_facts_from_grounding(
                                              grounding: infer_branch_canonical_grounding(
                                                node: node,
                                                unified_type: unified_type
                                              ),
                                              descent: Holds { value: descent_proof }
                                            ),
                                            f: fn(facts) {
                                              Accepted {
                                                value: facts,
                                                diagnostics: diagnostics_merge(outer: cd, inner: ud)
                                              }
                                            }
                                          )
                                      }
                                  }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
  }
}

fn infer_gather_fold_acc_failed(
  node: Node,
  pending: NonEmptyDiagnostics,
  await_branch_row: Bool,
  children_remaining: Int,
) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: node,
    entries: empty_inferred_facts_entry_list(),
    failed: true,
    pending: Some { diagnostics: pending },
    await_branch_row: await_branch_row,
    children_remaining: children_remaining
  }
}

fn infer_gather_fold_acc_ok(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  await_branch_row: Bool,
  children_remaining: Int,
) -> InferGatherFoldAcc {
  InferGatherFoldAcc {
    node: node,
    entries: entries,
    failed: false,
    pending: pending,
    await_branch_row: await_branch_row,
    children_remaining: children_remaining
  }
}

fn infer_gather_acc_to_outcome(acc: InferGatherFoldAcc) -> Outcome<List<InferredFactsEntry>> {
  if acc.failed {
    match acc.pending {
      None =>
        Rejected {
          diagnostics: diagnostics_singleton(
            d: infer_canonical_grounding_incoherent_diagnostic(node: infer_gather_fold_failure_node())
          )
        }
      Some { diagnostics: nds } => Rejected { diagnostics: nds }
    }
  } else {
    Accepted {
      value: acc.entries,
      diagnostics: acc.pending
    }
  }
}

fn infer_gather_fold_failure_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^infer_gather_fold_failure } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn infer_gather_branch_row_on_entries(
  node: Node,
  entries: List<InferredFactsEntry>,
  pending: Diagnostics,
  partials: List<Node>,
) -> InferGatherFoldAcc {
  match infer_branch_bool_if_else(node: node, partials: partials, entries: entries) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: node,
        pending: rejected_with_pending(pending: pending, rejected: r),
        await_branch_row: false,
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: node, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: node,
            pending: rejected_with_pending(pending: pending, rejected: r),
            await_branch_row: false,
            children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: node,
            entries: list_snoc_item(xs: entries, item: entry),
            pending: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: d),
              inner: ed
            ),
            await_branch_row: false,
            children_remaining: 0
          )
      }
  }
}

fn infer_gather_fold_init(n: Node, partials: List<Node>) -> InferGatherFoldAcc {
  match n.kind {
    ComputationNode { behavior: Branch } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_inferred_facts_entry_list(),
        pending: None,
        await_branch_row: true,
        children_remaining: length(xs: n.children)
      )
    _ =>
      match infer_node_facts(n: n, partials: partials) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: n,
            pending: r,
            await_branch_row: false,
            children_remaining: 0
          )
        Accepted { value: facts, diagnostics: d } =>
          match admitted_inferred_facts_entry(node: n, facts: facts) {
            Rejected { diagnostics: r } =>
              infer_gather_fold_acc_failed(
                node: n,
                pending: r,
                await_branch_row: false,
                children_remaining: 0
              )
            Accepted { value: entry, diagnostics: ed } =>
              infer_gather_fold_acc_ok(
                node: n,
                entries: [entry],
                pending: diagnostics_merge(outer: d, inner: ed),
                await_branch_row: false,
                children_remaining: 0
              )
          }
      }
  }
}

fn infer_gather_failed_non_empty(acc: InferGatherFoldAcc) -> NonEmptyDiagnostics {
  match acc.pending {
    Some { diagnostics: nds } => nds
    None =>
      diagnostics_singleton(
        d: infer_canonical_grounding_incoherent_diagnostic(node: infer_gather_fold_failure_node())
      )
  }
}

fn infer_gather_fold_step(
  acc: InferGatherFoldAcc,
  edge: Edge,
  child: InferGatherFoldAcc,
  partials: List<Node>,
) -> InferGatherFoldAcc {
  if acc.failed {
    acc
  } else if child.failed {
    infer_gather_fold_acc_failed(
      node: acc.node,
      pending: rejected_with_pending(
        pending: acc.pending,
        rejected: infer_gather_failed_non_empty(acc: child)
      ),
      await_branch_row: acc.await_branch_row,
      children_remaining: acc.children_remaining
    )
  } else {
    let merged_entries = concat_inferred_facts_entries(a: acc.entries, b: child.entries)
    let merged_pending = diagnostics_merge(outer: acc.pending, inner: child.pending)
    let children_remaining = acc.children_remaining - 1
    if acc.await_branch_row && children_remaining == 0 {
      infer_gather_branch_row_on_entries(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        partials: partials
      )
    } else {
      infer_gather_fold_acc_ok(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        await_branch_row: acc.await_branch_row,
        children_remaining: children_remaining
      )
    }
  }
}

fn infer_gather_fold_algebra(partials: List<Node>) -> NodeFold<InferGatherFoldAcc> {
  NodeFold {
    init: fn(n0) {
      infer_gather_fold_init(n: n0, partials: partials)
    },
    step: fn(acc, e, child) {
      infer_gather_fold_step(acc: acc, edge: e, child: child, partials: partials)
    }
  }
}

fn infer_grounding_admits_infer_facts(grounding: CanonicalGrounding) -> Bool {
  canonical_grounding_admits_infer_facts(grounding: grounding)
}

fn infer_entries_for_tree(tree: ResolvedTree) -> Outcome<List<InferredFactsEntry>> {
  let partials = partial_bounded_lattice_instances_in_tree(tree: tree)
  infer_gather_acc_to_outcome(
    acc: fold_node(n: tree, algebra: infer_gather_fold_algebra(partials: partials))
  )
}
fn infer(tree: ResolvedTree) -> Outcome<InferredTree> {
  match infer_entries_for_tree(tree: tree) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: entries, diagnostics: d } =>
      match facts_map_from_entries(entries: entries) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: facts_map, diagnostics: md } =>
          Accepted {
            value: InferredTree {
              root: tree,
              facts: facts_map
            },
            diagnostics: diagnostics_merge(outer: d, inner: md)
          }
      }
  }
}
