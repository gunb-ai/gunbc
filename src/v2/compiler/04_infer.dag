data infer_gather_dispatch_totality_note: String = "This dispatch is TOTAL over the closed node vocabulary (6 connectives + 6 behaviors) with no wildcard arm, and that is the construction half of the wall. The wildcard it replaces is what let eight kinds fall silently into the self-grounding fabrication; enumerating them means a thirteenth kind cannot be added without deciding, at this site, whether it derives its type or joins the counted frontier — the decision cannot be defaulted into by omission (DESIGN §4 closed vocabulary, §5 unwritable-by-construction)."

fn infer_gather_fold_not_derived(n: v2.std.node.Node, partials: List<v2.std.node.Node>) -> InferGatherFoldAcc {
  match infer_node_facts(n: n, partials: partials) {
    Rejected { diagnostics: r } =>
      infer_gather_fold_acc_failed(
        node: n,
        pending: r,
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: 0
      )
    Accepted { value: facts, diagnostics: d } =>
      match admitted_inferred_facts_entry(node: n, facts: facts) {
        Rejected { diagnostics: r } =>
          infer_gather_fold_acc_failed(
            node: n,
            pending: r,
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
        Accepted { value: entry, diagnostics: ed } =>
          infer_gather_fold_acc_ok(
            node: n,
            entries: [entry],
            pending: diagnostics_merge(outer: d, inner: ed),
            await_branch_row: false,
            await_match_row: false,
            await_loop_row: false,
            await_transform_row: false,
            children_remaining: 0
          )
      }
  }
}

fn infer_gather_fold_init(n: v2.std.node.Node, partials: List<v2.std.node.Node>) -> InferGatherFoldAcc {
  match n.kind {
    ComputationNode { behavior: Branch } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_inferred_facts_entry_list(),
        pending: None,
        await_branch_row: true,
        await_match_row: false,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Match } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_inferred_facts_entry_list(),
        pending: None,
        await_branch_row: false,
        await_match_row: true,
        await_loop_row: false,
        await_transform_row: false,
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Loop } =>
      infer_gather_fold_acc_ok(
        node: n,
        entries: empty_inferred_facts_entry_list(),
        pending: None,
        await_branch_row: false,
        await_match_row: false,
        await_loop_row: true,
        await_transform_row: false,
        children_remaining: length(xs: n.children)
      )
    ComputationNode { behavior: Value } => infer_gather_fold_not_derived(n: n, partials: partials)
    ComputationNode { behavior: v2.std.node.Transform } =>
      if infer_transform_is_binary_infix_int_add_shape(node: n) {
        infer_gather_fold_acc_ok(
          node: n,
          entries: empty_inferred_facts_entry_list(),
          pending: None,
          await_branch_row: false,
          await_match_row: false,
          await_loop_row: false,
          await_transform_row: true,
          children_remaining: length(xs: n.children)
        )
      } else {
        infer_gather_fold_not_derived(n: n, partials: partials)
      }
    ComputationNode { behavior: v2.std.node.Bind } => infer_gather_fold_not_derived(n: n, partials: partials)
    TypeNode { connective: Atom { identity: _ } } => infer_gather_fold_not_derived(n: n, partials: partials)
    TypeNode { connective: Conj } => infer_gather_fold_not_derived(n: n, partials: partials)
    TypeNode { connective: Disj } => infer_gather_fold_not_derived(n: n, partials: partials)
    TypeNode { connective: Arrow } => infer_gather_fold_not_derived(n: n, partials: partials)
    TypeNode { connective: v2.std.node.Cardinality } => infer_gather_fold_not_derived(n: n, partials: partials)
    TypeNode { connective: Instantiation } => infer_gather_fold_not_derived(n: n, partials: partials)
  }
}

fn infer_gather_failed_non_empty(acc: InferGatherFoldAcc) -> v2.std.diagnostic.NonEmptyDiagnostics {
  match acc.pending {
    Some { diagnostics: nds } => nds
    None =>
      diagnostics_singleton(
        d: infer_canonical_grounding_incoherent_diagnostic(node: infer_gather_fold_failure_node())
      )
  }
}

data infer_literal_subtree_diagnostic_discharge_note: String = "An integer literal's modeled type derives from its canonical representation, including its sole named magnitude subtree. Its derivation discharges only that edge's local type frontier; propagating it past the literal would report GroundingNotDerived after Int was derived. Boolean literals are canonical only with no children, so no boolean payload can be discharged. Malformed literals remain GroundingNotDerived and retain every child diagnostic."

fn infer_literal_edge_diagnostics_derived(parent: v2.std.node.Node, edge: v2.std.node.Edge) -> v2.std.logic.Bool {
  match dag_canonical_literal_from_node(node: parent) {
    Accepted { value: DagCanonicalIntLiteral { magnitude: _ }, diagnostics: _ } =>
      match edge.label {
        Named { name: field } => field == ^integer_literal_magnitude_field
        Positional => false
      }
    Accepted { value: DagCanonicalBoolLiteral { value: _ }, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}

fn infer_gather_fold_step(
  acc: InferGatherFoldAcc,
  edge: v2.std.node.Edge,
  child: InferGatherFoldAcc,
  partials: List<v2.std.node.Node>,
  tree: v2.std.node.Node,
) -> InferGatherFoldAcc {
  if acc.failed {
    acc
  } else if child.failed {
    infer_gather_fold_acc_failed(
      node: acc.node,
      pending: rejected_with_pending(
        pending: acc.pending,
        rejected: infer_gather_failed_non_empty(acc: child)
      ),
      await_branch_row: acc.await_branch_row,
      await_match_row: acc.await_match_row,
      await_loop_row: acc.await_loop_row,
      await_transform_row: acc.await_transform_row,
      children_remaining: acc.children_remaining
    )
  } else {
    let merged_entries = concat_inferred_facts_entries(a: acc.entries, b: child.entries)
    let merged_pending = if infer_literal_edge_diagnostics_derived(parent: acc.node, edge: edge) {
      acc.pending
    } else {
      diagnostics_merge(outer: acc.pending, inner: child.pending)
    }
    let children_remaining = acc.children_remaining - 1
    if acc.await_branch_row && children_remaining == 0 {
      infer_gather_branch_row_on_entries(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        partials: partials
      )
    } else if acc.await_match_row && children_remaining == 0 {
      infer_gather_match_row_on_entries(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        partials: partials,
        tree: tree
      )
    } else if acc.await_loop_row && children_remaining == 0 {
      infer_gather_loop_row_on_entries(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        partials: partials
      )
    } else if acc.await_transform_row && children_remaining == 0 {
      infer_gather_transform_row_on_entries(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        partials: partials,
        tree: tree
      )
    } else {
      infer_gather_fold_acc_ok(
        node: acc.node,
        entries: merged_entries,
        pending: merged_pending,
        await_branch_row: acc.await_branch_row,
        await_match_row: acc.await_match_row,
        await_loop_row: acc.await_loop_row,
        await_transform_row: acc.await_transform_row,
        children_remaining: children_remaining
      )
    }
  }
}

fn infer_gather_fold_algebra(partials: List<v2.std.node.Node>, tree: v2.std.node.Node) -> NodeFold<InferGatherFoldAcc> {
  v2.std.node.NodeFold {
    init: fn(n0) {
      infer_gather_fold_init(n: n0, partials: partials)
    },
    step: fn(acc, e, child) {
      infer_gather_fold_step(acc: acc, edge: e, child: child, partials: partials, tree: tree)
    }
  }
}

fn infer_grounding_admits_infer_facts(grounding: v2.std.constraints.CanonicalGrounding) -> v2.std.logic.Bool {
  canonical_grounding_admits_infer_facts(grounding: grounding)
}

fn infer_entries_for_tree(tree: v2.compiler.resolve.ResolvedTree) -> v2.std.diagnostic.Outcome<List<v2.compiler.inferred_tree.InferredFactsEntry>> {
  let partials = v2.std.bounded_lattice_completeness.partial_bounded_lattice_instances_in_tree(tree: tree)
  infer_gather_acc_to_outcome(
    acc: fold_node(n: tree, algebra: infer_gather_fold_algebra(partials: partials, tree: tree))
  )
}
fn infer(tree: v2.compiler.resolve.ResolvedTree) -> v2.std.diagnostic.Outcome<v2.compiler.inferred_tree.InferredTree> {
  match infer_entries_for_tree(tree: tree) {
    Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
    Accepted { value: entries, diagnostics: d } =>
      match facts_map_from_entries(entries: entries) {
        Rejected { diagnostics: r } => v2.std.diagnostic.Rejected { diagnostics: r }
        Accepted { value: facts_map, diagnostics: md } =>
          v2.std.diagnostic.Accepted {
            value: v2.compiler.inferred_tree.InferredTree {
              root: tree,
              facts: facts_map
            },
            diagnostics: diagnostics_merge(outer: d, inner: md)
          }
      }
  }
}
