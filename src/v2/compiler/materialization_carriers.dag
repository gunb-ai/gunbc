data v2_compiler_materialization_memo_gate_predicate_contract: Disposition = Terminal {
  reason: "Structural coproduct reader over std.realization.Materialization (materialization_allows_memo_store — Memoize => store permitted, Recompute/Share => refused) — closed by the three declared Materialization variants; .dag authority for cached_stage_governed; discriminating corpus: compiler_materialization_witness_test.dag."
}

data v2_compiler_materialization_note: String = "The .dag-substrate demonstration lane (duplicate-work-graph-lens-design.md section 10b): cached_stage memoization flows through the governed carrier door — Memoize verdict consumed (non-Memoize refuses store). std.realization.reconcile-as-lookup-path is the following increment (no v2 runtime dispatch yet). In-process memo cannot span runs: RefusedScopeTooNarrow at IsolatedChildren LCA; persistent-tier discharge belongs to a store-tier provider row (materialization_store_local class). Collapsing plural sites into one process frame → AuthoredDuplication (rule 1). The parse-table memo demand and its carrier were deleted (operator ruling R2, 2026-10-08: the memo served captures minted on abandoned backtrack paths, gunbc.recurring_failure_mode parse_memo_hit_serves_occurrences_minted_on_an_abandoned_path); the compile-stage demand is still authored. Dissolve-on: the remaining demand derives from demand-engine carriers (docs/plans/demand-engine-program.md M1) and the transport folds into materialize (Half A)."

// TAIL probe 2026-07-17 (cssl_assemble, smart-newt-39): execution-measured Gate-A-shaped rustc
// refusal (UNRESOLVED_CompilerError on emitter Rc/Optional surface) — NOT materialize-spine.
// Frontier migration_trigger reclassified to ^migrate_when_closure_self_emits_cargo_green (#6775
// lane). Receipt: TSV deleted 2026-08-16 (operator ruling: delete anything not actively derived).

fn materialization_allows_memo_store(m: Materialization) -> Bool {
  match m {
    Memoize => true
    Recompute => false
    Share => false
  }
}

fn v2_compile_process_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "v2-compile-ingest", kind: SharedStateFrame }
}

fn v2_compile_process_site() -> List<std.materialization_ladder.Frame> {
  [v2_compile_process_frame()]
}

data compile_stage_memo_demand_identity: String = "compile-pipeline-stage"

fn compile_stage_memo_demand() -> FrameDemand {
  FrameDemand {
    identity: compile_stage_memo_demand_identity,
    site: v2_compile_process_site(),
    nature: PureComputation
  }
}

fn v2_compiler_materialization_demands() -> List<FrameDemand> {
  [compile_stage_memo_demand()]
}

fn compile_stage_memo_provider() -> CacheProvider {
  provider_from_catalog(
    facts: compile_stage_memo_facts,
    scope: v2_compile_process_site(),
    coverage: CoversAllComputations
  )
}

fn v2_compiler_cache_providers() -> List<CacheProvider> {
  [compile_stage_memo_provider()]
}

fn compile_stage_memo_provider_id() -> CacheInterfaceId {
  extdeps.realization.compile_stage_memo.compile_stage_memo_id
}

fn v2_compiler_materialization_verdicts() -> List<LadderVerdict> {
  materialization_ladder(
    demands: v2_compiler_materialization_demands(),
    providers: v2_compiler_cache_providers(),
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn v2_compiler_materialization_ladder_holds() -> Bool {
  materialization_ladder_holds(
    demands: v2_compiler_materialization_demands(),
    providers: v2_compiler_cache_providers(),
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

// DERIVED, NOT DECLARED. These two returned the literal Memoize while the ladder standing
// beside them in this same module ruled on the same two identities, and nothing compared the
// two answers -- one witness pinned the literal, another pinned the verdict, and both were
// green while they disagreed. That is the fork this module exists to prevent (DESIGN section
// 3), so the prescription is now read from the verdict for this demand's own identity.
//
// Absent -- no verdict for this identity -- is the fail-closed arm: a demand the ladder never
// ruled on has no admission to consume, so the store is not permitted. It is deliberately NOT
// the same answer as a ruled Recompute, which is why ladder_verdict_for hands back the VERDICT
// and leaves the reading to this door instead of flattening it into a prescription.
// A REFUSED VERDICT IS NOT AN ADMISSION, and this is the correction review 69770 asked for.
// std.materialization_ladder.ladder_verdict_prescribes answers what materialization each verdict
// IMPLIES, and for five of the six Refused arms it answers Memoize -- deliberately, because a
// refusal is an UNMET OBLIGATION and the standing ruling is that it is not a licence to delete
// the store. That table is right for what it is. What it is NOT is a door's admission, and this
// module is what turned it into one: read as permission, "the obligation is unmet" became
// "permission granted", which is DESIGN section 5's widen -- a failure arm must refuse.
//
// So admission is green-or-nothing. The obligation, the provider and the store all remain --
// nothing here deletes them, and the refusal verdict stays enrolled and readable -- but an
// unmet obligation does not open the door: a demand is admitted BECAUSE it is green rather than
// because every Refused arm happened to answer Memoize too.
// A REFUSAL IS PRESERVED, NOT RE-ENCODED AS Recompute, and this is the correction the delta
// review asked for. Green-or-nothing was first written as "green or Recompute", which prevented
// a refused verdict from opening the store and then handed back a perfectly valid operational
// materialization -- so the caller continued, unmemoized, with the obligation still unmet and
// nothing anywhere saying so. DESIGN section 2 is explicit that a demand whose identity finds no
// provider of sufficient scope, coverage, key and retention is refused WITH A TYPED CAUSE, and
// section 5 is explicit that a failure arm refuses rather than widening. Recompute-as-fallback
// widened: the answer was operationally fine and the deficit it stood on became unobservable,
// which is exactly the absorbing fallback -- the signal that would have made the missing provider
// rank for fixing is destroyed by the arm that papers over it. It was also inconsistent with this
// package's own Share frontier, which rules that silently treating Share as recomputation is
// wrong and that the door must refuse with a typed diagnostic; RefusedNoProvider is the stronger
// case, since the ladder has already said the required realization is unavailable.
// So the door answers Outcome<Materialization>: green admits its prescription, and every other
// result -- refused, non-green, or an identity the ladder never ruled on -- is Rejected with a
// located diagnostic. Absent is refused for the same reason and not a weaker one: a demand with
// no ruling has no admission to consume, and the port symbol each named demand passes is what
// keeps the two refusals distinguishable at their own sites.
// ONE BODY, and the verdict list is a parameter so that a control can exercise THE DOOR rather
// than a copy of it. Review 69791 caught the previous shape: refused_scope_prescription had this
// body inlined with only the verdict source swapped, so deleting the green test HERE -- the
// production door, which compile_stage_memo_materialization consumes -- left the control that exists to catch that deletion green. A control evaluating its
// own copy of the property it guards cannot fail, which is the forged control DESIGN section
// 4b(1) refuses: the discriminating RED has to run on the real acceptance path.
// That parameter is also what makes this ONE ADMISSION RULE over whichever verdict list ruled the
// identity: the production demand is ruled in v2_compiler_materialization_verdicts and the
// controls below rule their own lists, and every one of them is this body.
fn materialization_obligation_unmet_diagnostic(port: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^materialization_obligation_unmet,
    at: invariant_port_locus(port: port, invariant: ^materialization_obligation_unmet),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn admitted_prescription_in(
  verdicts: List<LadderVerdict>,
  identity: String,
  port: Symbol
) -> Outcome<Materialization> {
  match ladder_verdict_for(verdicts: verdicts, identity: identity) {
    Absent =>
      Rejected {
        diagnostics: diagnostics_singleton(d: materialization_obligation_unmet_diagnostic(port: port))
      }
    Present { value: chosen } =>
      if ladder_verdict_is_green(v: chosen) {
        Accepted { value: ladder_verdict_prescribes(v: chosen), diagnostics: None }
      } else {
        Rejected {
          diagnostics: diagnostics_singleton(d: materialization_obligation_unmet_diagnostic(port: port))
        }
      }
  }
}

fn admitted_prescription(identity: String, port: Symbol) -> Outcome<Materialization> {
  admitted_prescription_in(
    verdicts: v2_compiler_materialization_verdicts(),
    identity: identity,
    port: port
  )
}

fn compile_stage_memo_materialization() -> Outcome<Materialization> {
  admitted_prescription(
    identity: compile_stage_memo_demand_identity,
    port: ^compile_stage_memo_demand_port
  )
}

type CachedStageRealization {
  provider_id: CacheInterfaceId
  materialization: Materialization
}

// THE REALIZATION CARRIES AN ADMITTED MATERIALIZATION OR IT DOES NOT EXIST. Constructing a
// CachedStageRealization out of a refused admission would put the refusal back inside a value
// the stage spine consumes as though it had been admitted, so the refusal is answered here,
// at the constructor, and compile_ingest_staging returns it as the stage outcome it already is.
fn cached_stage_realization() -> Outcome<CachedStageRealization> {
  match compile_stage_memo_materialization() {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: m, diagnostics: residue } =>
      Accepted {
        value: CachedStageRealization {
          provider_id: compile_stage_memo_provider_id(),
          materialization: m,
        },
        diagnostics: residue
      }
  }
}

fn cached_stage_governed<A, B>(
  realization: CachedStageRealization,
  lookup: fn(A) -> CacheProbe<B>,
  stage: fn(A) -> Outcome<B>
) -> fn(A) -> Outcome<B> {
  fn(x) {
    match materialization_allows_memo_store(m: realization.materialization) {
      true => v2.std.staging.resolve_probe(probe: lookup(x), stage: stage, x: x)
      false => stage(x)
    }
  }
}

fn realized_step_for(m: Materialization) -> RealizedStep<Nano> {
  RealizedStep {
    shape: ReadEffect,
    placement: LocalInProcess,
    materialization: m,
    cost: cost_account_predicted_zero()
  }
}

fn compile_stage_realized_step() -> Outcome<RealizedStep<Nano>> {
  match compile_stage_memo_materialization() {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: m, diagnostics: residue } =>
      Accepted { value: realized_step_for(m: m), diagnostics: residue }
  }
}

// ACCOUNTING CANNOT REFUSE, so the old projection_ok pair is gone rather than
// rewritten: it asked whether classifying a cited row had failed, which is now
// unaskable by type. What is still worth asserting is that the provider carries
// the catalog's retention UNCHANGED — the property the pre-verdicting mapping
// actually broke when it discarded placement retention and minted SpacePacked.
fn compile_stage_memo_retention_preserved() -> Bool {
  compile_stage_memo_provider().retention == compile_stage_memo_facts.placement.retention
}

// A REFUSED ADMISSION IS A Rejected OUTCOME, and these controls now discriminate that rather
// than the weaker property they used to. Asking only whether the store was permitted could not
// tell a refusal apart from an admitted Recompute -- both answer false -- which is precisely how
// the collapsed arm survived: the control that existed to catch it agreed with it.
fn materialization_admission_is_refused(a: Outcome<Materialization>) -> Bool {
  match a {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn materialization_admission_admits_store(a: Outcome<Materialization>) -> Bool {
  match a {
    Rejected { diagnostics: _ } => false
    Accepted { value: m, diagnostics: _ } => materialization_allows_memo_store(m: m)
  }
}

// The discriminating RED for the fail-closed arm: an identity the ladder never ruled on has no
// admitted decision, so the door must refuse rather than inherit the permissive answer.
// Deleting the Absent arm of admitted_prescription_in makes this admit.
data unruled_demand_identity: String = "identity-the-ladder-never-ruled-on"

fn unruled_identity_prescription() -> Outcome<Materialization> {
  admitted_prescription(
    identity: unruled_demand_identity,
    port: ^compile_stage_memo_demand_port
  )
}

// THE RED REVIEW 69770 ASKED FOR, now at the strength the delta review asked for: a REFUSED
// identity must not be ADMITTED AT ALL. The plural compile-stage demands -- one per compile run
// under an isolated workflow frame -- refuse with RefusedScopeTooNarrow against the very in-process
// provider that admits the single-process demand: same identity, same provider, refused on scope
// rather than absence, which is exactly an arm ladder_verdict_prescribes answers Memoize for. It
// runs through admitted_prescription_in, THE DOOR'S OWN BODY, so dropping the green test there
// makes this admit and the control dies with it; re-encoding the refusal as Recompute makes it
// admit too, which a store-only form could not see. (These controls were carried by the
// parse-table demand until that demand and its carrier were deleted, operator ruling R2,
// 2026-10-08; the door body is shared, so they move to the surviving demand unchanged.)
fn refused_scope_prescription() -> Outcome<Materialization> {
  admitted_prescription_in(
    verdicts: compile_stage_memo_plural_verdicts(providers: v2_compiler_cache_providers()),
    identity: compile_stage_memo_demand_identity,
    port: ^compile_stage_memo_demand_port
  )
}

fn refused_scope_is_not_admitted() -> Bool {
  materialization_admission_is_refused(a: refused_scope_prescription())
}

// The positive control that keeps the pair honest: the SAME fold over the SAME provider admits a
// store for the same identity when its demand recurs inside the provider's scope -- an
// input-driven replay frame below the process frame, discharged by the in-process provider.
// Without this, refused_scope_is_not_admitted would also pass if admitted_prescription_in simply
// never admitted anything.
fn compile_stage_replay_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "compile-stage-replay", kind: UnboundedSiblingsFrame }
}

fn compile_stage_memo_recurrent_demand() -> FrameDemand {
  FrameDemand {
    identity: compile_stage_memo_demand_identity,
    site: [v2_compile_process_frame(), compile_stage_replay_frame()],
    nature: PureComputation
  }
}

fn discharged_scope_admits_store() -> Bool {
  materialization_admission_admits_store(
    a: admitted_prescription_in(
      verdicts: materialization_ladder(
        demands: [compile_stage_memo_recurrent_demand()],
        providers: v2_compiler_cache_providers(),
        cost_floor_exempt: no_cost_floor_exemptions
      ),
      identity: compile_stage_memo_demand_identity,
      port: ^compile_stage_memo_demand_port
    )
  )
}

fn unruled_identity_is_not_admitted() -> Bool {
  materialization_admission_is_refused(a: unruled_identity_prescription())
}

fn compile_stage_memo_verdict_is_single_recompute() -> Bool {
  v2_compiler_materialization_verdicts()
    |> fold(init: false, f: (acc, v) =>
      acc || verdict_is_accepted_single_recompute(v: v, identity: compile_stage_memo_demand_identity)
    )
}

fn v2_compile_workflow_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "v2-compile-workflow", kind: IsolatedChildrenFrame }
}

fn v2_compile_run_frame(name: String) -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: name, kind: SharedStateFrame }
}

fn compile_stage_memo_plural_demands() -> List<FrameDemand> {
  [
    FrameDemand {
      identity: compile_stage_memo_demand_identity,
      site: [
        v2_compile_workflow_frame(),
        v2_compile_run_frame(name: "compile-run-a"),
        v2_compile_process_frame()
      ],
      nature: PureComputation
    },
    FrameDemand {
      identity: compile_stage_memo_demand_identity,
      site: [
        v2_compile_workflow_frame(),
        v2_compile_run_frame(name: "compile-run-b"),
        v2_compile_process_frame()
      ],
      nature: PureComputation
    }
  ]
}

fn compile_stage_memo_plural_verdicts(providers: List<CacheProvider>) -> List<LadderVerdict> {
  materialization_ladder(
    demands: compile_stage_memo_plural_demands(),
    providers: providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn compile_stage_memo_plural_holds_with_provider() -> Bool {
  materialization_ladder_holds(
    demands: compile_stage_memo_plural_demands(),
    providers: v2_compiler_cache_providers(),
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn compile_stage_memo_plural_holds_without_provider() -> Bool {
  materialization_ladder_holds(
    demands: compile_stage_memo_plural_demands(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn compile_stage_memo_plural_refused_without_provider_count() -> Int {
  compile_stage_memo_plural_verdicts(providers: no_cache_providers)
    |> fold(init: 0, f: (acc, v) =>
      if verdict_is_refused_no_provider(v: v, identity: compile_stage_memo_demand_identity) {
        acc + 1
      } else {
        acc
      }
    )
}

fn compile_stage_memo_plural_scope_too_narrow_count() -> Int {
  compile_stage_memo_plural_verdicts(providers: v2_compiler_cache_providers())
    |> fold(init: 0, f: (acc, v) =>
      if verdict_is_refused_scope_too_narrow(v: v, provider_id: extdeps.realization.compile_stage_memo.compile_stage_memo_id) {
        acc + 1
      } else {
        acc
      }
    )
}
