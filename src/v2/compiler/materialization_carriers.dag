data v2_compiler_materialization_memo_gate_predicate_contract: Disposition = Terminal {
  reason: "Structural coproduct reader over std.realization.Materialization (materialization_allows_memo_store — Memoize => store permitted, Recompute/Share => refused) — closed by the three declared Materialization variants; .dag authority for parse_table_lookup/insert and cached_stage_governed; discriminating corpus: parse_table_memo_governed_witness_test.dag + compiler_materialization_witness_test.dag."
}

data v2_compiler_materialization_note: String = "The .dag-substrate demonstration lane (duplicate-work-graph-lens-design.md section 10b): ParseTable and cached_stage memoization flows through the governed carrier door — Memoize verdict consumed (non-Memoize refuses store), ContentKeyed law at parse_table_subject (grammar_digest × token_stream_digest × position × production). std.realization.reconcile-as-lookup-path is the following increment (no v2 runtime dispatch yet). Seed-side memo interceptor: extdeps/realization/parse_table_memo.dag parse_table_memo_seed_handler_dissolution_trigger (Scaffold dissolves_to RealizationDispatch on materialization_allows_memo_store; v1_interpreter.rs try_parse_table_memo_dispatch is the seed handler). In-process memo cannot span runs: RefusedScopeTooNarrow at IsolatedChildren LCA; persistent-tier discharge belongs to resolved_graph_cache-class rows. Collapsing plural sites into one process frame → AuthoredDuplication (rule 1). The parse demand's site is derived per grammar (ParseMemoRecurrence, computed in v2.compiler.parse compute_grammar_first_analysis_given) and carried on the table; the compile-stage demand is still authored. Dissolve-on: the remaining demands derive from demand-engine carriers (docs/plans/demand-engine-program.md M1) and the transport folds into materialize (Half A)."

// TAIL probe 2026-07-17 (cssl_assemble, smart-newt-39): execution-measured Gate-A-shaped rustc
// refusal (UNRESOLVED_CompilerError on emitter Rc/Optional surface) — NOT materialize-spine.
// Frontier migration_trigger reclassified to ^migrate_when_closure_self_emits_cargo_green (#6775
// lane). Receipt: TSV deleted 2026-08-16 (operator ruling: delete anything not actively derived).

fn materialization_allows_memo_store(m: Materialization) -> Bool {
  match m {
    Memoize => true
    Recompute => false
    Share => false
  }
}

fn v2_compile_process_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "v2-compile-ingest", kind: SharedStateFrame }
}

fn v2_compile_process_site() -> List<std.materialization_ladder.Frame> {
  [v2_compile_process_frame()]
}

data parse_table_memo_demand_identity: String = "parse-nonterminal-memo"
data compile_stage_memo_demand_identity: String = "compile-pipeline-stage"

// THE PARSE DEMAND CASE IS DERIVED FROM THE GRAMMAR, NOT AUTHORED. The identity is one
// (nonterminal, position) parse under one grammar and one token stream -- the ContentKeyed
// preimage parse_table_subject already names. Whether that identity is demanded MORE THAN ONCE
// within one parse is a structural fact of the grammar, and ParseMemoRecurrence is its census,
// computed once per grammar by v2.compiler.parse compute_grammar_first_analysis_given.
//
// Why the census and not dependency_lens: a DependencyView is a (source, dependent, kind,
// usage_site) edge over a Node. It records THAT a production references a nonterminal; it
// carries no position, no ordered-choice retry and no nullability, and those three are exactly
// what decide whether one (nonterminal, position) is asked twice. A reference-edge count is the
// "import edge / lookup count" the demand case must not be equated with -- a grammar with a
// nonterminal referenced from forty sites can still ask each (nonterminal, position) once.
//
// The two sources of within-parse recurrence, and why there is no third:
//  - a DISCARDING backtrack site: an ordered Choice's left branch, or an Optional / Repeat
//    element, whose attempt can fail after demanding a nonterminal. The failed attempt's
//    result is thrown away and the continuation resumes at the SAME position, so any
//    nonterminal it demanded can be demanded again there.
//  - a NULLABLE nonterminal: it can succeed consuming nothing, so the next demand on the same
//    successful path starts at the same position and may be the same nonterminal.
// WHY THESE TWO ARE EXHAUSTIVE -- an argument over the constructors, so a new construct is
// checked against it rather than against a list. A second demand of one (N, p) needs two demand
// events for N at the same position p. Take any two such events in one parse's execution and
// ask how the parse got from the first to the second. Either
//  (a) the first event's subtree was ABANDONED and execution resumed at a position <= p: that
//      needs a construct that attempts a branch and continues after its failure. In GrammarExpr
//      only three do -- Choice (tries left, then right from the same position), Optional and
//      Repeat (try the element, then continue from the same position). Terminal, LiteralTerminal
//      and Nonterminal never resume after failure (they propagate it), and Sequence fails as a
//      whole when either side fails, so the resuming point is always an enclosing
//      Choice/Optional/Repeat. The abandoned subtree must contain the N demand, hence the
//      "attempted branch demands a nonterminal" condition. Or
//  (b) both events are on the SURVIVING path: then either one is an ancestor of the other at the
//      same position, which is left recursion (refused by grammar_has_left_recursion_given), or
//      they are ordered in the token stream and everything demanded between the first N's start
//      and the second consumed zero tokens -- which requires the first N itself to consume
//      nothing, i.e. N is nullable.
// So (a) is a discarding backtrack site and (b) a nullable nonterminal; there is no third route.
// THE OBLIGATION ON A NEW CONSTRUCT: if it can resume after a failed attempt, it is a discarding
// site and expr_parse_demand_fold in v2.compiler.parse must count it; if it can succeed consuming
// nothing, the nullable fixpoint must include it. Parser error recovery (sync tokens) is outside
// this argument: it is assumed to resume strictly later, and a recovery mode that re-enters at
// the failed position is a third route that must be counted before it lands.
//
// Counting a Choice whose left branch token dispatch would never enter is a structural
// over-approximation computed AS the answer (DESIGN section 5's admitted neighbour of the
// absorbing fallback): it can only claim recurrence where none occurs, which costs a store and
// never a wrong tree.
type ParseMemoRecurrence {
  discarding_backtrack_sites: Int
  nullable_nonterminals: Int
}

fn parse_memo_recurrence_is_possible(r: ParseMemoRecurrence) -> Bool {
  (r.discarding_backtrack_sites > 0) || (r.nullable_nonterminals > 0)
}

// Within-parse recurrence is a replay whose count the INPUT decides, so the emergent frame is
// UnboundedSiblingsFrame -- it names the input-driven retry at one position, and it sits BELOW the
// process frame: within-parse sharing is not cross-run reuse, and a run-spanning demand is a
// different site (parse_table_memo_plural_demands below), refused, not discharged, by the
// in-process provider.
fn parse_backtrack_replay_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame {
    name: "parse-backtrack-replay",
    kind: UnboundedSiblingsFrame
  }
}

fn parse_table_memo_site_for(r: ParseMemoRecurrence) -> List<std.materialization_ladder.Frame> {
  if parse_memo_recurrence_is_possible(r: r) {
    [v2_compile_process_frame(), parse_backtrack_replay_frame()]
  } else {
    v2_compile_process_site()
  }
}

fn parse_table_memo_demand_for(r: ParseMemoRecurrence) -> FrameDemand {
  FrameDemand {
    identity: parse_table_memo_demand_identity,
    site: parse_table_memo_site_for(r: r),
    nature: PureComputation
  }
}

fn parse_table_memo_verdicts_for(r: ParseMemoRecurrence) -> List<LadderVerdict> {
  materialization_ladder(
    demands: [parse_table_memo_demand_for(r: r)],
    providers: v2_compiler_cache_providers(),
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

// ONCE PER GRAMMAR, CARRIED. The caller stores this on GrammarFirstAnalysis and every ParseTable
// built from that analysis carries it; parse_table_lookup and parse_table_insert read the carried
// value and never re-run the ladder. Admission is GREEN-ONLY (admitted_from): a refused verdict
// is an unmet obligation that stays enrolled and readable, and it neither opens the door nor
// deletes the provider or the store.
fn parse_table_memo_materialization_for(r: ParseMemoRecurrence) -> Materialization {
  admitted_from(verdicts: parse_table_memo_verdicts_for(r: r), identity: parse_table_memo_demand_identity)
}

data parse_memo_no_recurrence: ParseMemoRecurrence = ParseMemoRecurrence {
  discarding_backtrack_sites: 0,
  nullable_nonterminals: 0
}

fn compile_stage_memo_demand() -> FrameDemand {
  FrameDemand {
    identity: compile_stage_memo_demand_identity,
    site: v2_compile_process_site(),
    nature: PureComputation
  }
}

// The parse demand is not in this list: its site depends on the grammar, so it is ruled per
// grammar by parse_table_memo_verdicts_for rather than once here for a grammar nobody named.
fn v2_compiler_materialization_demands() -> List<FrameDemand> {
  [compile_stage_memo_demand()]
}

fn parse_table_memo_provider() -> CacheProvider {
  provider_from_catalog(
    facts: parse_table_memo_facts,
    scope: v2_compile_process_site(),
    coverage: CoversAllComputations
  )
}

fn compile_stage_memo_provider() -> CacheProvider {
  provider_from_catalog(
    facts: compile_stage_memo_facts,
    scope: v2_compile_process_site(),
    coverage: CoversAllComputations
  )
}

fn v2_compiler_cache_providers() -> List<CacheProvider> {
  [parse_table_memo_provider(), compile_stage_memo_provider()]
}

fn parse_table_memo_provider_id() -> CacheInterfaceId {
  extdeps.realization.parse_table_memo.parse_table_memo_id
}

fn compile_stage_memo_provider_id() -> CacheInterfaceId {
  extdeps.realization.compile_stage_memo.compile_stage_memo_id
}

fn parse_table_memo_artifact_kind() -> ArtifactKindId {
  parse_table_artifact_kind
}

fn v2_compiler_materialization_verdicts() -> List<LadderVerdict> {
  materialization_ladder(
    demands: v2_compiler_materialization_demands(),
    providers: v2_compiler_cache_providers(),
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn v2_compiler_materialization_ladder_holds() -> Bool {
  materialization_ladder_holds(
    demands: v2_compiler_materialization_demands(),
    providers: v2_compiler_cache_providers(),
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

// DERIVED, NOT DECLARED. These two returned the literal Memoize while the ladder standing
// beside them in this same module ruled on the same two identities, and nothing compared the
// two answers -- one witness pinned the literal, another pinned the verdict, and both were
// green while they disagreed. That is the fork this module exists to prevent (DESIGN section
// 3), so the prescription is now read from the verdict for this demand's own identity.
//
// Absent -- no verdict for this identity -- is the fail-closed arm: a demand the ladder never
// ruled on has no admission to consume, so the store is not permitted. It is deliberately NOT
// the same answer as a ruled Recompute, which is why ladder_verdict_for reports the gap and
// admitted_from's own Absent arm refuses it rather than flattening it.
// A REFUSED VERDICT IS NOT AN ADMISSION, and this is the correction review 69770 asked for.
// std.materialization_ladder.ladder_verdict_prescribes answers what materialization each verdict
// IMPLIES, and for five of the six Refused arms it answers Memoize -- deliberately, because a
// refusal is an UNMET OBLIGATION and the standing ruling is that it is not a licence to delete
// the store. That table is right for what it is. What it is NOT is a door's admission, and this
// module is what turned it into one: read as permission, "the obligation is unmet" became
// "permission granted", which is DESIGN section 5's widen -- a failure arm must refuse.
//
// So admission is green-or-nothing. The obligation, the provider and the store all remain --
// nothing here deletes them, and the refusal verdict stays enrolled and readable -- but an
// unmet obligation does not open the door. Today the parse-table demand is Discharged, so no
// live behaviour changes; what changes is that it is admitted BECAUSE it is green rather than
// because every Refused arm happened to answer Memoize too.
//
// ONE admission rule, over whichever verdict list ruled the identity: the compile-stage demand is
// ruled once in v2_compiler_materialization_verdicts, the parse demand per grammar in
// parse_table_memo_verdicts_for, and both doors pass through this same green test.
fn admitted_from(verdicts: List<LadderVerdict>, identity: String) -> Materialization {
  match ladder_verdict_for(verdicts: verdicts, identity: identity) {
    Absent => Recompute
    Present { value: chosen } =>
      if ladder_verdict_is_green(v: chosen) {
        ladder_verdict_prescribes(v: chosen)
      } else {
        Recompute
      }
  }
}

fn admitted_prescription(identity: String) -> Materialization {
  admitted_from(verdicts: v2_compiler_materialization_verdicts(), identity: identity)
}

fn compile_stage_memo_materialization() -> Materialization {
  admitted_prescription(identity: compile_stage_memo_demand_identity)
}

type CachedStageRealization {
  provider_id: CacheInterfaceId
  materialization: Materialization
}

fn cached_stage_realization() -> CachedStageRealization {
  CachedStageRealization {
    provider_id: compile_stage_memo_provider_id(),
    materialization: compile_stage_memo_materialization(),
  }
}

fn cached_stage_governed<A, B>(
  realization: CachedStageRealization,
  lookup: fn(A) -> CacheProbe<B>,
  stage: fn(A) -> Outcome<B>
) -> fn(A) -> Outcome<B> {
  fn(x) {
    match materialization_allows_memo_store(m: realization.materialization) {
      true => v2.std.staging.resolve_probe(probe: lookup(x), stage: stage, x: x)
      false => stage(x)
    }
  }
}

fn parse_table_realized_step(r: ParseMemoRecurrence) -> RealizedStep<Nano> {
  RealizedStep {
    shape: ReadEffect,
    placement: LocalInProcess,
    materialization: parse_table_memo_materialization_for(r: r),
    cost: cost_account_predicted_zero()
  }
}

fn compile_stage_realized_step() -> RealizedStep<Nano> {
  RealizedStep {
    shape: ReadEffect,
    placement: LocalInProcess,
    materialization: compile_stage_memo_materialization(),
    cost: cost_account_predicted_zero()
  }
}

// ACCOUNTING CANNOT REFUSE, so the old projection_ok pair is gone rather than
// rewritten: it asked whether classifying a cited row had failed, which is now
// unaskable by type. What is still worth asserting is that the provider carries
// the catalog's retention UNCHANGED — the property the pre-verdicting mapping
// actually broke when it discarded placement retention and minted SpacePacked.
fn parse_table_memo_retention_preserved() -> Bool {
  parse_table_memo_provider().retention == parse_table_memo_facts.placement.retention
}

fn compile_stage_memo_retention_preserved() -> Bool {
  compile_stage_memo_provider().retention == compile_stage_memo_facts.placement.retention
}

// The two arms the parse demand can reach from the grammar, each read off the verdict rather
// than off the prescription, so a verdict that changed arm while keeping the same Materialization
// (a refusal also prescribes Memoize) cannot pass for a discharge.
fn parse_table_memo_verdict_is_discharged_for(r: ParseMemoRecurrence) -> Bool {
  parse_table_memo_verdicts_for(r: r)
    |> fold(init: false, f: (acc, v) =>
      acc || verdict_is_discharged_by(
        v: v,
        identity: parse_table_memo_demand_identity,
        provider_id: extdeps.realization.parse_table_memo.parse_table_memo_id
      )
    )
}

fn parse_table_memo_verdict_is_single_recompute_for(r: ParseMemoRecurrence) -> Bool {
  parse_table_memo_verdicts_for(r: r)
    |> fold(init: false, f: (acc, v) =>
      acc || verdict_is_accepted_single_recompute(v: v, identity: parse_table_memo_demand_identity)
    )
}

// The discriminating RED for the fail-closed arm: an identity the ladder never ruled on has no
// admitted decision, so the door must refuse the store rather than inherit the permissive
// answer. Deleting the Absent arm of admitted_from makes this return Memoize.
data unruled_demand_identity: String = "identity-the-ladder-never-ruled-on"

fn unruled_identity_prescription() -> Materialization {
  admitted_prescription(identity: unruled_demand_identity)
}

// THE RED REVIEW 69770 ASKED FOR: a REFUSED identity must not permit the store. The plural
// parse-table demands refuse with RefusedScopeTooNarrow against the very provider that
// discharges the single-site demand, so this is the same identity and the same provider,
// refused for a reason that is about scope rather than absence -- exactly the arm that
// ladder_verdict_prescribes answers Memoize for. Restoring the bare prescription (dropping the
// green test in admitted_from) makes this return Memoize and the control fails.
fn refused_scope_prescription() -> Materialization {
  admitted_from(
    verdicts: parse_table_memo_plural_verdicts(providers: v2_compiler_cache_providers()),
    identity: parse_table_memo_demand_identity
  )
}

fn refused_scope_refuses_store() -> Bool {
  !materialization_allows_memo_store(m: refused_scope_prescription())
}

// The positive control that keeps the pair honest: the SAME fold over the SAME provider admits
// the recurrent-grammar demand. Without this, refused_scope_refuses_store would also pass if
// admitted_from simply never admitted anything.
data parse_memo_one_discarding_site: ParseMemoRecurrence = ParseMemoRecurrence {
  discarding_backtrack_sites: 1,
  nullable_nonterminals: 0
}

fn discharged_scope_admits_store() -> Bool {
  materialization_allows_memo_store(m: parse_table_memo_materialization_for(r: parse_memo_one_discarding_site))
}

fn unruled_identity_refuses_store() -> Bool {
  !materialization_allows_memo_store(m: unruled_identity_prescription())
}

fn compile_stage_memo_verdict_is_single_recompute() -> Bool {
  v2_compiler_materialization_verdicts()
    |> fold(init: false, f: (acc, v) =>
      acc || verdict_is_accepted_single_recompute(v: v, identity: compile_stage_memo_demand_identity)
    )
}

fn parse_table_carrier_grounded_on_catalog() -> Bool {
  (parse_table_memo_artifact_kind() == parse_table_artifact_kind)
    && (parse_table_memo_provider_id() == extdeps.realization.parse_table_memo.parse_table_memo_id)
}

fn v2_compile_workflow_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "v2-compile-workflow", kind: IsolatedChildrenFrame }
}

fn v2_compile_run_frame(name: String) -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: name, kind: SharedStateFrame }
}

fn parse_table_memo_plural_demands() -> List<FrameDemand> {
  [
    FrameDemand {
      identity: parse_table_memo_demand_identity,
      site: [
        v2_compile_workflow_frame(),
        v2_compile_run_frame(name: "compile-run-a"),
        v2_compile_process_frame()
      ],
      nature: PureComputation
    },
    FrameDemand {
      identity: parse_table_memo_demand_identity,
      site: [
        v2_compile_workflow_frame(),
        v2_compile_run_frame(name: "compile-run-b"),
        v2_compile_process_frame()
      ],
      nature: PureComputation
    }
  ]
}

fn parse_table_memo_plural_verdicts(providers: List<CacheProvider>) -> List<LadderVerdict> {
  materialization_ladder(
    demands: parse_table_memo_plural_demands(),
    providers: providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn parse_table_memo_plural_holds_with_provider() -> Bool {
  materialization_ladder_holds(
    demands: parse_table_memo_plural_demands(),
    providers: v2_compiler_cache_providers(),
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn parse_table_memo_plural_holds_without_provider() -> Bool {
  materialization_ladder_holds(
    demands: parse_table_memo_plural_demands(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn parse_table_memo_plural_refused_without_provider_count() -> Int {
  parse_table_memo_plural_verdicts(providers: no_cache_providers)
    |> fold(init: 0, f: (acc, v) =>
      if verdict_is_refused_no_provider(v: v, identity: parse_table_memo_demand_identity) {
        acc + 1
      } else {
        acc
      }
    )
}

fn parse_table_memo_plural_scope_too_narrow_count() -> Int {
  parse_table_memo_plural_verdicts(providers: v2_compiler_cache_providers())
    |> fold(init: 0, f: (acc, v) =>
      if verdict_is_refused_scope_too_narrow(v: v, provider_id: extdeps.realization.parse_table_memo.parse_table_memo_id) {
        acc + 1
      } else {
        acc
      }
    )
}
