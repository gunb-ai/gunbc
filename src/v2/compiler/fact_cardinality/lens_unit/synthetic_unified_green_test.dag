// Scope: lens-unit GREEN witness — identical cross-tree bodies are not forks.
// Status: 🟡 DRAFT-until-signed — load-bearing witness receipts.

module v2.test.fact_cardinality.lens_unit.synthetic_unified_green

import v2.lens.fact_cardinality {
  FactCardinalityDeclFact,
  fact_cardinality_cross_tree_variant_mismatch
}
import v2.std.logic { Bool }

data synthetic_unified_dsl: FactCardinalityDeclFact = FactCardinalityDeclFact {
  rel_path_decl_key: "algebra.dag:Lattice",
  tree: "dsl",
  content_hash: "7e31b580ce38306e"
}

data synthetic_unified_v2: FactCardinalityDeclFact = FactCardinalityDeclFact {
  rel_path_decl_key: "algebra.dag:Lattice",
  tree: "v2",
  content_hash: "7e31b580ce38306e"
}

test fn synthetic_unified_green_holds() -> Bool {
  !fact_cardinality_cross_tree_variant_mismatch(
    left: synthetic_unified_dsl,
    right: synthetic_unified_v2
  )
}
