module v2.compiler.tokenize

import v2.std.collection { List }
import v2.std.diagnostic { Accepted, ByteRange, Diagnostic, ExternalContractUnknown, Locus, None, Outcome, Textual, Unavailable, UserInputBoundary, WholeFile, diagnostics_singleton }
import v2.std.node { Symbol }
import v2.std.algebra { Cons, Empty, ListTailResult, TailAbsent, TailFound, fold_list, is_empty, is_prefix_of, length, list_append, list_snoc_item, list_tail }
import v2.std.text { Char, CharAbsent, CharFound, SourceFold, String, fold_source, string_head, string_is_empty, string_tail }
import v2.std.nat { Nat, nat_lte, nat_gte }
import v2.std.logic { Bool }
import v2.std.compilers.lexing {
  BlockCommentTextChar,
  DigitChar,
  HexDigitChar,
  IdentContinueChar,
  IdentStartChar,
  LexCharClass,
  LexPattern,
  LexPatternFold,
  LexRule,
  LexRuleSet,
  LexRules,
  LineCommentTextChar,
  ModeledLexRules,
  StringTextChar,
  Token,
  TokenRule,
  TokenStream,
  token_stream_empty,
  token_stream_new,
  TriviaRule,
  VoidLexRules,
  WhitespaceChar,
  fold_lex_pattern
}

type LexMatchResult
  = LexMatchAccepted { remaining: String, lexeme: String }
  | LexMatchRejected

type LexRuleApply
  = LexRuleNoMatch
  | LexRuleToken { class: Symbol, lexeme: String, remaining: String }
  | LexRuleTrivia { lexeme: String, remaining: String }

type LexMatchThunk {
  apply: fn(String) -> LexMatchResult
}

fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn tokenize_lex_e1_unrecognized_char_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^tokenize_lex_e1_unrecognized_char,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn char_in_class(c: Char, class: LexCharClass) -> Bool {
  match class {
    WhitespaceChar =>
      c == 32 || c == 9 || c == 10 || c == 13
    DigitChar =>
      nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57)
    HexDigitChar =>
      (nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57)) ||
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 70)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 102))
    IdentStartChar =>
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 90)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 122)) ||
      c == 95
    IdentContinueChar =>
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 90)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 122)) ||
      c == 95 ||
      (nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57))
    StringTextChar =>
      c != 34 && c != 10
    LineCommentTextChar =>
      c != 10
    BlockCommentTextChar =>
      c != 42
  }
}

fn lex_strip_prefix(prefix: String, source: String) -> ListTailResult<Char> {
  fold_list(
    xs: prefix,
    empty: TailFound { tail: source },
    cons: fn(acc, _) {
      match acc {
        TailAbsent => TailAbsent
        TailFound { tail: r } => list_tail(xs: r)
      }
    }
  )
}

fn lex_match_prefix(prefix: String, source: String) -> LexMatchResult {
  if is_prefix_of(prefix: prefix, xs: source, eq: fn(a, b) { a == b }) {
    match lex_strip_prefix(prefix: prefix, source: source) {
      TailFound { tail: rem } => LexMatchAccepted { remaining: rem, lexeme: prefix }
      TailAbsent => LexMatchRejected
    }
  } else {
    LexMatchRejected
  }
}

type RepeatState {
  remaining: String
  lexeme: String
  done: Bool
}

type DelimitedState {
  remaining: String
  lexeme: String
  done: Bool
  failed: Bool
}

fn lex_rule_pattern(rule: LexRule) -> LexPattern {
  match rule {
    TokenRule { token_class: _, pattern: p } => p
    TriviaRule { pattern: p } => p
  }
}

fn lex_match_char_pred(pred: fn(Char) -> Bool, source: String) -> LexMatchResult {
  match string_is_empty(s: source) {
    true => LexMatchRejected
    false =>
      match string_head(s: source) {
        CharAbsent => LexMatchRejected
        CharFound { value: c } =>
          match pred(c) {
            true =>
              match string_tail(s: source) {
                TailFound { tail: rest } =>
                  LexMatchAccepted { remaining: rest, lexeme: Cons { head: c, tail: Empty } }
                TailAbsent => LexMatchRejected
              }
            false => LexMatchRejected
          }
      }
  }
}

fn lex_repeat_loop(elem_r: LexMatchThunk, init: RepeatState) -> RepeatState {
  fold_list(
    xs: init.remaining,
    empty: init,
    cons: fn(state, _) {
      match state.done {
        true => state
        false =>
          match elem_r.apply(state.remaining) {
            LexMatchRejected =>
              RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
            LexMatchAccepted { remaining: rest, lexeme: consumed } =>
              match string_is_empty(s: consumed) {
                true =>
                  RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
                false =>
                  RepeatState {
                    remaining: rest,
                    lexeme: list_append(left: state.lexeme, right: consumed),
                    done: false
                  }
              }
          }
      }
    }
  )
}

fn lex_try_rule(rule: LexRule, source: String) -> LexRuleApply {
  let thunk = fold_lex_pattern(
    pattern: lex_rule_pattern(rule: rule),
    algebra: LexPatternFold {
      empty: LexMatchThunk { apply: fn(s) {
        LexMatchAccepted { remaining: s, lexeme: Empty }
      } },
      literal: fn(text) {
        LexMatchThunk { apply: fn(s) {
          lex_match_prefix(prefix: text, source: s)
        } }
      },
      keyword: fn(text) {

        LexMatchThunk { apply: fn(s) {
          match lex_match_prefix(prefix: text, source: s) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              match string_is_empty(s: rest) {
                true => LexMatchAccepted { remaining: rest, lexeme: lex }
                false =>
                  match string_head(s: rest) {
                    CharAbsent => LexMatchAccepted { remaining: rest, lexeme: lex }
                    CharFound { value: c } =>
                      match char_in_class(c: c, class: IdentContinueChar) {
                        true => LexMatchRejected
                        false => LexMatchAccepted { remaining: rest, lexeme: lex }
                      }
                  }
              }
          }
        } }
      },
      char: fn(expected) {
        LexMatchThunk { apply: fn(s) { lex_match_char_pred(pred: fn(c) { c == expected }, source: s) } }
      },
      char_class: fn(class) {
        LexMatchThunk { apply: fn(s) { lex_match_char_pred(pred: fn(c) { char_in_class(c: c, class: class) }, source: s) } }
      },
      sequence: fn(left_r, right_r) {
        LexMatchThunk { apply: fn(s) {
          match left_r.apply(s) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest1, lexeme: lex1 } =>
              match right_r.apply(rest1) {
                LexMatchRejected => LexMatchRejected
                LexMatchAccepted { remaining: rest2, lexeme: lex2 } =>
                  LexMatchAccepted { remaining: rest2, lexeme: list_append(left: lex1, right: lex2) }
              }
          }
        } }
      },
      choice: fn(left_r, right_r) {
        LexMatchThunk { apply: fn(s) {
          match left_r.apply(s) {
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              LexMatchAccepted { remaining: rest, lexeme: lex }
            LexMatchRejected => right_r.apply(s)
          }
        } }
      },
      optional: fn(elem_r) {
        LexMatchThunk { apply: fn(s) {
          match elem_r.apply(s) {
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              LexMatchAccepted { remaining: rest, lexeme: lex }
            LexMatchRejected =>
              LexMatchAccepted { remaining: s, lexeme: Empty }
          }
        } }
      },
      repeat: fn(elem_r) {

        LexMatchThunk { apply: fn(s) {
          let result = lex_repeat_loop(elem_r: elem_r, init: RepeatState { remaining: s, lexeme: Empty, done: false })
          LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
        } }
      },
      one_or_more: fn(elem_r) {

        LexMatchThunk { apply: fn(s) {
          match elem_r.apply(s) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              let result = lex_repeat_loop(elem_r: elem_r, init: RepeatState { remaining: rest, lexeme: lex, done: false })
              LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
          }
        } }
      },
      delimited: fn(open_r, body_r, close_r) {

        LexMatchThunk { apply: fn(s) {
          match open_r.apply(s) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: after_open, lexeme: open_lex } =>
              let init = DelimitedState { remaining: after_open, lexeme: open_lex, done: false, failed: false }
              let result = fold_list(
                xs: after_open,
                empty: init,
                cons: fn(state, _) {
                  match state.done {
                    true => state
                    false =>
                      match close_r.apply(state.remaining) {
                        LexMatchAccepted { remaining: after_close, lexeme: close_lex } =>
                          DelimitedState {
                            remaining: after_close,
                            lexeme: list_append(left: state.lexeme, right: close_lex),
                            done: true,
                            failed: false
                          }
                        LexMatchRejected =>
                          match body_r.apply(state.remaining) {
                            LexMatchRejected =>
                              DelimitedState { remaining: state.remaining, lexeme: state.lexeme, done: true, failed: true }
                            LexMatchAccepted { remaining: after_body, lexeme: body_lex } =>
                              match string_is_empty(s: body_lex) {
                                true =>
                                  DelimitedState { remaining: state.remaining, lexeme: state.lexeme, done: true, failed: true }
                                false =>
                                  DelimitedState {
                                    remaining: after_body,
                                    lexeme: list_append(left: state.lexeme, right: body_lex),
                                    done: false,
                                    failed: false
                                  }
                              }
                          }
                      }
                  }
                }
              )
              match result.done {
                false => LexMatchRejected
                true =>
                  match result.failed {
                    true => LexMatchRejected
                    false => LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
                  }
              }
          }
        } }
      }
    }
  )
  match thunk.apply(source) {
    LexMatchRejected => LexRuleNoMatch
    LexMatchAccepted { remaining: remaining, lexeme: lexeme } =>
      match rule {
        TokenRule { token_class: class, pattern: _ } =>
          LexRuleToken { class: class, lexeme: lexeme, remaining: remaining }
        TriviaRule { pattern: _ } =>
          LexRuleTrivia { lexeme: lexeme, remaining: remaining }
      }
  }
}

fn lex_rule_apply_lexeme_length(apply: LexRuleApply) -> Int {
  match apply {
    LexRuleNoMatch => 0
    LexRuleToken { lexeme: lexeme, remaining: _, class: _ } => length(xs: lexeme)
    LexRuleTrivia { lexeme: lexeme, remaining: _ } => length(xs: lexeme)
  }
}

fn lex_try_rules_prefer_longer(acc: LexRuleApply, candidate: LexRuleApply) -> LexRuleApply {
  match acc {
    LexRuleNoMatch => candidate
    _ =>
      match candidate {
        LexRuleNoMatch => acc
        _ =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
      }
  }
}

fn lex_try_rules(rules: List<LexRule>, source: String) -> LexRuleApply {
  fold_list(
    xs: rules,
    empty: LexRuleNoMatch,
    cons: fn(acc, rule) {
      lex_try_rules_prefer_longer(
        acc: acc,
        candidate: lex_try_rule(rule: rule, source: source)
      )
    }
  )
}

type LexWalkAcc {
  remaining: String
  tokens: List<Token>
  pos: Int
  done: Bool
  error: Bool
  file: Symbol
  rules: LexRuleSet
}

fn lex_walk_init(src: String, file: Symbol, rules: LexRuleSet) -> LexWalkAcc {
  LexWalkAcc {
    remaining: src,
    tokens: Empty,
    pos: 0,
    done: false,
    error: false,
    file: file,
    rules: rules
  }
}

fn lex_walk_is_done(acc: LexWalkAcc) -> Bool {
  acc.done
}

fn lex_walk_step(acc: LexWalkAcc) -> LexWalkAcc {
  match string_is_empty(s: acc.remaining) {
    true =>
      LexWalkAcc {
        remaining: acc.remaining,
        tokens: acc.tokens,
        pos: acc.pos,
        done: true,
        error: false,
        file: acc.file,
        rules: acc.rules
      }
    false =>
      match lex_try_rules(rules: acc.rules.rules, source: acc.remaining) {
        LexRuleNoMatch =>
          LexWalkAcc {
            remaining: acc.remaining,
            tokens: acc.tokens,
            pos: acc.pos,
            done: true,
            error: true,
            file: acc.file,
            rules: acc.rules
          }
        LexRuleTrivia { lexeme: lexeme, remaining: remaining } =>
          match string_is_empty(s: lexeme) {
            true =>
              LexWalkAcc {
                remaining: acc.remaining,
                tokens: acc.tokens,
                pos: acc.pos,
                done: true,
                error: true,
                file: acc.file,
                rules: acc.rules
              }
            false =>
              LexWalkAcc {
                remaining: remaining,
                tokens: acc.tokens,
                pos: acc.pos + length(xs: lexeme),
                done: false,
                error: false,
                file: acc.file,
                rules: acc.rules
              }
          }
        LexRuleToken { class: class, lexeme: lexeme, remaining: remaining } =>
          match string_is_empty(s: lexeme) {
            true =>
              LexWalkAcc {
                remaining: acc.remaining,
                tokens: acc.tokens,
                pos: acc.pos,
                done: true,
                error: true,
                file: acc.file,
                rules: acc.rules
              }
            false =>
              LexWalkAcc {
                remaining: remaining,
                tokens: list_snoc_item(
                  xs: acc.tokens,
                  item: Token {
                    class: class,
                    lexeme: lexeme,
                    file: acc.file,
                    start: acc.pos,
                    end: acc.pos + length(xs: lexeme)
                  }
                ),
                pos: acc.pos + length(xs: lexeme),
                done: false,
                error: false,
                file: acc.file,
                rules: acc.rules
              }
          }
      }
  }
}

fn lex_walk_source_algebra(file: Symbol, rules: LexRuleSet) -> SourceFold<LexWalkAcc> {
  SourceFold {
    init: fn(src) { lex_walk_init(src: src, file: file, rules: rules) },
    is_done: lex_walk_is_done,
    step: lex_walk_step
  }
}

fn lex_walk(source: String, file: Symbol, rules: LexRuleSet) -> Outcome<TokenStream> {
  let result = fold_source(
    src: source,
    algebra: lex_walk_source_algebra(file: file, rules: rules)
  )
  let at = Textual { file: file, extent: ByteRange { start: result.pos, end: result.pos } }
  if result.error {
    Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e1_unrecognized_char_diagnostic(at: at)) }
  } else {
    Accepted { value: token_stream_new(all: result.tokens), diagnostics: None }
  }
}

fn tokenize(text: String, file: Symbol, rules: LexRules) -> Outcome<TokenStream> {
  let at = Textual {
    file: file,
    extent: WholeFile
  }
  match rules {
    VoidLexRules =>
      if is_empty(xs: text) {
        Accepted { value: token_stream_empty(), diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)) }
      }
    ModeledLexRules { root: rule_set } =>
      lex_walk(source: text, file: file, rules: rule_set)
  }
}
