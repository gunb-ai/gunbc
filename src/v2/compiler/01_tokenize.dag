// One source carrier is retained throughout the walk; progress is a scalar index.
// Byte extents remain independently derived from consumed Unicode scalars.
type LexCursor {
  source: v2.std.text.String
  index: Int
}

fn lex_cursor_head(cursor: LexCursor) -> v2.std.text.CharResult {
  match list_at_optional(xs: cursor.source, index: cursor.index) {
    Absent => CharAbsent
    Present { value: c } => CharFound { value: c }
  }
}

fn lex_cursor_empty(cursor: LexCursor) -> Bool {
  match lex_cursor_head(cursor: cursor) {
    CharAbsent => true
    CharFound { value: _ } => false
  }
}

fn lex_cursor_advance(cursor: LexCursor) -> LexCursor {
  LexCursor { source: cursor.source, index: cursor.index + 1 }
}

type LexMatchResult
  = LexMatchAccepted { remaining: LexCursor, lexeme: v2.std.text.String }
  | LexMatchRejected

type LexRuleApply
  = LexRuleNoMatch
  | LexRuleToken { class: Symbol, lexeme: v2.std.text.String, remaining: LexCursor }
  | LexRuleTrivia { lexeme: v2.std.text.String, remaining: LexCursor }
  | LexRuleAnnotation { class: Symbol, lexeme: v2.std.text.String, remaining: LexCursor }
  | LexRuleModalToken { class: Symbol, lexeme: v2.std.text.String, remaining: LexCursor, transition: LexModeTransition }

fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn tokenize_lex_e1_unrecognized_char_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^tokenize_lex_e1_unrecognized_char,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}

// THE MODE STACK'S THREE MEANINGLESS STATES, each its own refusal (v2.std.compilers.lexing LexRule
// lexical modes). A push names a mode the rule set never declared; a pop is attempted in the default
// mode, which has nothing beneath it; or the source ends with a mode still pushed, located at the
// token that pushed it, since that is where the unclosed context began.
fn tokenize_lex_e2_mode_undeclared_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^tokenize_lex_e2_mode_undeclared,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn tokenize_lex_e3_mode_pop_at_default_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^tokenize_lex_e3_mode_pop_at_default,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn tokenize_lex_e4_mode_unterminated_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^tokenize_lex_e4_mode_unterminated,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn lex_mode_declaration_refusal_reason(refusal: LexModeDeclarationRefusal) -> Symbol {
  match refusal {
    LexModeDeclaredTwice { mode: _ } => ^tokenize_lex_e5_mode_declared_twice
  }
}

// A rule set whose mode declarations are malformed is refused before any text is walked.
fn tokenize_lex_e5_mode_declaration_diagnostic(file: Symbol, refusal: LexModeDeclarationRefusal) -> Diagnostic {
  Diagnostic {
    reason: lex_mode_declaration_refusal_reason(refusal: refusal),
    at: Textual { file: file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn char_in_class(c: Char, class: LexCharClass) -> Bool {
  match class {
    WhitespaceChar =>
      c == 32 || c == 9 || c == 10 || c == 13
    DigitChar =>
      (c >= 48) && (c <= 57)
    HexDigitChar =>
      ((c >= 48) && (c <= 57)) ||
      ((c >= 65) && (c <= 70)) ||
      ((c >= 97) && (c <= 102))
    IdentStartChar =>
      ((c >= 65) && (c <= 90)) ||
      ((c >= 97) && (c <= 122)) ||
      c == 95
    IdentContinueChar =>
      ((c >= 65) && (c <= 90)) ||
      ((c >= 97) && (c <= 122)) ||
      c == 95 ||
      ((c >= 48) && (c <= 57))
    StringTextChar =>
      c != 34 && c != 10
    LineCommentTextChar =>
      c != 10
    BlockCommentTextChar =>
      c != 42
  }
}

// THE LEXEME IS THE SOURCE'S OWN TEXT, NOT THE PATTERN'S. Every other matcher answers the codepoints
// it consumed from `source`; this one answered the pattern literal `prefix`. The two agree as
// values, but on the seed they are different carriers -- a pattern literal is a native String, the
// source is a codepoint list -- and the sequence arm of lex_match_pattern joins its two lexemes with
// list_append. The line-comment rule is Sequence(Literal "//", Repeat(..)), so that join met a native
// String and a codepoint list, and the seed's concat rendered the list: `// ab` became the text
// `//[32, 97, 98]` and a bare `//` became `//Empty`. lex_walk_step advances every extent by the
// lexeme's length, so every token after any line comment was mislocated (gunbc.recurring_failure_mode
// lexer_literal_lexeme_straddles_its_sequence_partner). Consuming the prefix from the source makes
// every lexeme one carrier; the value is unchanged.
fn lex_consume_prefix(prefix: v2.std.text.String, source: LexCursor) -> LexMatchResult {
  fold_list(
    xs: prefix,
    empty: LexMatchAccepted { remaining: source, lexeme: std.algebra.Empty },
    cons: fn(acc, expected) {
      match acc {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: cursor, lexeme: consumed } =>
          match lex_cursor_head(cursor: cursor) {
            CharAbsent => LexMatchRejected
            CharFound { value: c } =>
              if c == expected {
                LexMatchAccepted { remaining: lex_cursor_advance(cursor: cursor), lexeme: list_snoc_item(xs: consumed, item: c) }
              } else { LexMatchRejected }
          }
      }
    }
  )
}

fn lex_match_prefix(prefix: v2.std.text.String, source: LexCursor) -> LexMatchResult {
  lex_consume_prefix(prefix: prefix, source: source)
}

// Lexeme growth must push items (amortized O(log n) on the persistent carrier, per
// list_snoc_item): list_append right-folds over its LEFT side, which is the accumulator
// at these call sites, so per-character accumulation paid O(n) a character - quadratic
// in literal length, measured at 18+ minutes on the 132KB string literal in
// gunbc.live_deploy.srv1_residue_rehearsal (2026-09-09, required-v2-native lane).
fn lexeme_grow(acc: v2.std.text.String, chunk: v2.std.text.String) -> v2.std.text.String {
  fold_list(xs: chunk, empty: acc, cons: fn(grown, c) { list_snoc_item(xs: grown, item: c) })
}

type RepeatState {
  remaining: LexCursor
  lexeme: v2.std.text.String
  done: Bool
}

type DelimitedState {
  remaining: LexCursor
  lexeme: v2.std.text.String
  done: Bool
  failed: Bool
}

fn lex_rule_pattern(rule: LexRule) -> LexPattern {
  match rule {
    TokenRule { token_class: _, pattern: p } => p
    TriviaRule { pattern: p } => p
    AnnotationRule { annotation_class: _, pattern: p } => p
    ModeTransitionTokenRule { token_class: _, pattern: p, transition: _ } => p
  }
}

fn lex_match_char_pred(pred: fn(Char) -> Bool, source: LexCursor) -> LexMatchResult {
  match lex_cursor_head(cursor: source) {
    CharAbsent => LexMatchRejected
    CharFound { value: c } =>
      if pred(c) {
        LexMatchAccepted { remaining: lex_cursor_advance(cursor: source), lexeme: Cons { head: c, tail: std.algebra.Empty } }
      } else { LexMatchRejected }
  }
}

fn lex_repeat_step(element: LexPattern, state: RepeatState) -> RepeatState {
  match state.done {
    true => state
    false =>
      match lex_match_pattern(pattern: element, source: state.remaining) {
        LexMatchRejected =>
          RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
        LexMatchAccepted { remaining: rest, lexeme: consumed } =>
          match string_is_empty(s: consumed) {
            true =>
              RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
            false =>
              lex_repeat_step(
                element: element,
                state: RepeatState {
                  remaining: rest,
                  lexeme: lexeme_grow(acc: state.lexeme, chunk: consumed),
                  done: false
                }
              )
          }
      }
  }
}

fn lex_repeat_loop(element: LexPattern, init: RepeatState) -> RepeatState {
  lex_repeat_step(element: element, state: init)
}

fn lex_delimited_step(close: LexPattern, body: LexPattern, state: DelimitedState) -> DelimitedState {
  match state.done {
    true => state
    false =>
      match lex_match_pattern(pattern: close, source: state.remaining) {
        LexMatchAccepted { remaining: after_close, lexeme: close_lex } =>
          DelimitedState {
            remaining: after_close,
            lexeme: lexeme_grow(acc: state.lexeme, chunk: close_lex),
            done: true,
            failed: false
          }
        LexMatchRejected =>
          match lex_match_pattern(pattern: body, source: state.remaining) {
            LexMatchRejected =>
              DelimitedState { remaining: state.remaining, lexeme: state.lexeme, done: true, failed: true }
            LexMatchAccepted { remaining: after_body, lexeme: body_lex } =>
              match string_is_empty(s: body_lex) {
                true =>
                  DelimitedState { remaining: state.remaining, lexeme: state.lexeme, done: true, failed: true }
                false =>
                  lex_delimited_step(
                    close: close,
                    body: body,
                    state: DelimitedState {
                      remaining: after_body,
                      lexeme: lexeme_grow(acc: state.lexeme, chunk: body_lex),
                      done: false,
                      failed: false
                    }
                  )
              }
          }
      }
  }
}

type CompiledLexRule {
  rule: LexRule
  index: Int
  first: LexFirst
}

// WHICH CHARACTERS A RULE CAN START ON, decided once per rule set. lex_try_rules used to run every
// rule's matcher at every position -- ~56 rules for .dag -- and each matcher's first step splits
// the persistent source vector; perf --children on the bounded K=16 native-route root put the
// tokenizer at 20.6% of the process after C2, most of it in im::Vector skip/split_off under
// is_prefix_of. A rule whose FIRST set excludes the head character and that cannot match the empty
// string returns LexRuleNoMatch there, and lex_try_rules_prefer_longer keeps its accumulator
// unchanged on NoMatch -- so skipping that rule changes no answer. The set only has to
// OVER-approximate: an extra candidate costs a matcher call, a missing one would drop a match.
type LexFirst {
  chars: List<Char>
  classes: List<LexCharClass>
  nullable: Bool
}

fn lex_first_union(left: LexFirst, right: LexFirst, nullable: Bool) -> LexFirst {
  LexFirst {
    chars: list_append(left: left.chars, right: right.chars),
    classes: list_append(left: left.classes, right: right.classes),
    nullable: nullable
  }
}

fn lex_first_of_text(text: v2.std.text.String) -> LexFirst {
  match string_head(s: text) {
    CharFound { value: c } => LexFirst { chars: Cons { head: c, tail: std.algebra.Empty }, classes: std.algebra.Empty, nullable: false }
    CharAbsent => LexFirst { chars: std.algebra.Empty, classes: std.algebra.Empty, nullable: true }
  }
}

fn lex_first_then(left: LexFirst, right: LexFirst) -> LexFirst {
  if left.nullable {
    lex_first_union(left: left, right: right, nullable: right.nullable)
  } else {
    left
  }
}

fn lex_first_with_nullable(first: LexFirst, nullable: Bool) -> LexFirst {
  LexFirst { chars: first.chars, classes: first.classes, nullable: nullable }
}

fn lex_pattern_first(pattern: LexPattern) -> LexFirst {
  fold_lex_pattern(
    pattern: pattern,
    algebra: LexPatternFold {
      empty: LexFirst { chars: std.algebra.Empty, classes: std.algebra.Empty, nullable: true },
      literal: fn(text) { lex_first_of_text(text: text) },
      keyword: fn(text) { lex_first_of_text(text: text) },
      char: fn(c) { LexFirst { chars: Cons { head: c, tail: std.algebra.Empty }, classes: std.algebra.Empty, nullable: false } },
      char_class: fn(k) { LexFirst { chars: std.algebra.Empty, classes: Cons { head: k, tail: std.algebra.Empty }, nullable: false } },
      sequence: fn(left, right) { lex_first_then(left: left, right: right) },
      choice: fn(left, right) { lex_first_union(left: left, right: right, nullable: left.nullable || right.nullable) },
      optional: fn(element) { lex_first_with_nullable(first: element, nullable: true) },
      repeat: fn(element) { lex_first_with_nullable(first: element, nullable: true) },
      one_or_more: fn(element) { element },
      delimited: fn(open, body, close) {
        if open.nullable {
          lex_first_union(
            left: open,
            right: lex_first_union(left: body, right: close, nullable: close.nullable),
            nullable: close.nullable
          )
        } else {
          open
        }
      },
      not_followed_by: fn(element) { LexFirst { chars: std.algebra.Empty, classes: std.algebra.Empty, nullable: true } }
    }
  )
}

fn lex_first_admits(first: LexFirst, c: Char) -> Bool {
  first.nullable
    || v2.std.algebra.contains(xs: first.chars, item: c, eq: fn(a, b) { a == b })
    || v2.std.algebra.any(xs: first.classes, predicate: fn(k) { char_in_class(c: c, class: k) })
}

// Rules whose FIRST is only literal characters are reached through by_char; every other rule --
// a character class, or a rule that can match the empty string -- is in residual and tested per
// position with lex_first_admits. Both lists keep declared rule order, and lex_dispatch_candidates
// merges them by index, because the longest-match fold breaks ties toward the LATER rule.
type LexRuleDispatch {
  all: List<CompiledLexRule>
  by_char: Map<Char, List<CompiledLexRule>>
  residual: List<CompiledLexRule>
}

fn lex_dispatch_by_char_add(by_char: Map<Char, List<CompiledLexRule>>, compiled: CompiledLexRule) -> Map<Char, List<CompiledLexRule>> {
  fold_list(
    xs: compiled.first.chars,
    empty: by_char,
    cons: fn(acc, c) {
      match map_lookup(m: acc, key: c) {
        Present { value: rules } =>
          if lex_rules_contain_index(rules: rules, index: compiled.index) {
            acc
          } else {
            map_insert(m: acc, key: c, value: list_snoc_item(xs: rules, item: compiled))
          }
        Absent => map_insert(m: acc, key: c, value: Cons { head: compiled, tail: std.algebra.Empty })
      }
    }
  )
}

fn lex_rule_dispatch(compiled_rules: List<CompiledLexRule>) -> LexRuleDispatch {
  fold_list(
    xs: compiled_rules,
    empty: LexRuleDispatch { all: compiled_rules, by_char: empty_map(), residual: std.algebra.Empty },
    cons: fn(acc, compiled) {
      if compiled.first.nullable || !is_empty(xs: compiled.first.classes) {
        LexRuleDispatch { all: acc.all, by_char: acc.by_char, residual: list_snoc_item(xs: acc.residual, item: compiled) }
      } else {
        LexRuleDispatch { all: acc.all, by_char: lex_dispatch_by_char_add(by_char: acc.by_char, compiled: compiled), residual: acc.residual }
      }
    }
  )
}

// Recursion on the typed list rather than a predicate lambda: a lambda over a List<CompiledLexRule>
// reads its parameter as an unbound T at the field access here (the lambda-argument typing class
// gunbc.lambda_argument_typing_gate records).
fn lex_rules_contain_index(rules: List<CompiledLexRule>, index: Int) -> Bool {
  match rules {
    Empty => false
    Cons { head: r, tail: rest } =>
      if r.index == index { true } else { lex_rules_contain_index(rules: rest, index: index) }
  }
}

fn lex_rules_admitting(rules: List<CompiledLexRule>, c: Char) -> List<CompiledLexRule> {
  match rules {
    Empty => Empty
    Cons { head: r, tail: rest } =>
      match lex_first_admits(first: r.first, c: c) {
        true => Cons { head: r, tail: lex_rules_admitting(rules: rest, c: c) }
        false => lex_rules_admitting(rules: rest, c: c)
      }
  }
}

// Merge two index-ascending lists into one index-ascending list.
fn lex_merge_by_index(left: List<CompiledLexRule>, right: List<CompiledLexRule>) -> List<CompiledLexRule> {
  match left {
    Empty => right
    Cons { head: l, tail: lt } =>
      match right {
        Empty => left
        Cons { head: r, tail: rt } =>
          match l.index < r.index {
            true => Cons { head: l, tail: lex_merge_by_index(left: lt, right: right) }
            false => Cons { head: r, tail: lex_merge_by_index(left: left, right: rt) }
          }
      }
  }
}

fn lex_dispatch_candidates(dispatch: LexRuleDispatch, source: LexCursor) -> List<CompiledLexRule> {
  match lex_cursor_head(cursor: source) {
    CharAbsent => dispatch.all
    CharFound { value: c } =>
      lex_merge_by_index(
        left: match map_lookup(m: dispatch.by_char, key: c) {
          Present { value: rules } => rules
          Absent => std.algebra.Empty
        },
        right: lex_rules_admitting(rules: dispatch.residual, c: c)
      )
  }
}

// A RULE'S MATCHER IS ITS PATTERN, READ. The pattern is data and the match is one structural walk
// over it, so a compiled rule set holds no closures: it is portable, and a prepared rule set can be
// served across evaluations like PreparedGrammar (v2.compiler.program_assembly dag_prepared_lex).
// Each arm answers exactly what the closure built per arm used to: the consumed source as the
// lexeme, a keyword refused when an identifier character follows, a choice taking its left
// alternative first, a repeat stopping at a rejection or an empty match, and a delimited body
// running until its close matches.
fn lex_match_pattern(pattern: LexPattern, source: LexCursor) -> LexMatchResult {
  match pattern {
    EmptyPattern => LexMatchAccepted { remaining: source, lexeme: std.algebra.Empty }
    LiteralPattern { text: text } => lex_match_prefix(prefix: text, source: source)
    KeywordPattern { text: text } =>
      match lex_match_prefix(prefix: text, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          match lex_cursor_head(cursor: rest) {
            CharAbsent => LexMatchAccepted { remaining: rest, lexeme: lex }
            CharFound { value: c } =>
              if char_in_class(c: c, class: IdentContinueChar) { LexMatchRejected } else { LexMatchAccepted { remaining: rest, lexeme: lex } }
          }
      }
    CharPattern { char: expected } => lex_match_char_pred(pred: fn(c) { c == expected }, source: source)
    CharClassPattern { class: class } => lex_match_char_pred(pred: fn(c) { char_in_class(c: c, class: class) }, source: source)
    SequencePattern { left: left, right: right } =>
      match lex_match_pattern(pattern: left, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: rest1, lexeme: lex1 } =>
          match lex_match_pattern(pattern: right, source: rest1) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest2, lexeme: lex2 } =>
              LexMatchAccepted { remaining: rest2, lexeme: list_append(left: lex1, right: lex2) }
          }
      }
    ChoicePattern { left: left, right: right } =>
      match lex_match_pattern(pattern: left, source: source) {
        LexMatchAccepted { remaining: rest, lexeme: lex } => LexMatchAccepted { remaining: rest, lexeme: lex }
        LexMatchRejected => lex_match_pattern(pattern: right, source: source)
      }
    OptionalPattern { element: element } =>
      match lex_match_pattern(pattern: element, source: source) {
        LexMatchAccepted { remaining: rest, lexeme: lex } => LexMatchAccepted { remaining: rest, lexeme: lex }
        LexMatchRejected => LexMatchAccepted { remaining: source, lexeme: std.algebra.Empty }
      }
    RepeatPattern { element: element } =>
      let result = lex_repeat_loop(element: element, init: RepeatState { remaining: source, lexeme: std.algebra.Empty, done: false })
      LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
    OneOrMorePattern { element: element } =>
      match lex_match_pattern(pattern: element, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          let result = lex_repeat_loop(element: element, init: RepeatState { remaining: rest, lexeme: lex, done: false })
          LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
      }
    DelimitedPattern { open: open, body: body, close: close } =>
      match lex_match_pattern(pattern: open, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: after_open, lexeme: open_lex } =>
          let result = lex_delimited_step(close: close, body: body, state: DelimitedState { remaining: after_open, lexeme: open_lex, done: false, failed: false })
          if result.done && !result.failed { LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme } } else { LexMatchRejected }
      }
    NotFollowedByPattern { element: element } =>
      match lex_match_pattern(pattern: element, source: source) {
        LexMatchAccepted { remaining: _, lexeme: _ } => LexMatchRejected
        LexMatchRejected => LexMatchAccepted { remaining: source, lexeme: std.algebra.Empty }
      }
  }
}

fn lex_try_compiled(compiled: CompiledLexRule, source: LexCursor) -> LexRuleApply {
  match lex_match_pattern(pattern: lex_rule_pattern(rule: compiled.rule), source: source) {
    LexMatchRejected => LexRuleNoMatch
    LexMatchAccepted { remaining: remaining, lexeme: lexeme } =>
      match compiled.rule {
        TokenRule { token_class: class, pattern: _ } =>
          LexRuleToken { class: class, lexeme: lexeme, remaining: remaining }
        TriviaRule { pattern: _ } =>
          LexRuleTrivia { lexeme: lexeme, remaining: remaining }
        AnnotationRule { annotation_class: class, pattern: _ } =>
          LexRuleAnnotation { class: class, lexeme: lexeme, remaining: remaining }
        ModeTransitionTokenRule { token_class: class, pattern: _, transition: t } =>
          LexRuleModalToken { class: class, lexeme: lexeme, remaining: remaining, transition: t }
      }
  }
}

type LexCompileAcc {
  reversed: List<CompiledLexRule>
  next_index: Int
}

fn lex_compile_rules(rules: List<LexRule>) -> List<CompiledLexRule> {
  let compiled = fold_list(
    xs: rules,
    empty: LexCompileAcc { reversed: Empty, next_index: 0 },
    cons: fn(acc, rule) {
      LexCompileAcc {
        reversed: Cons {
          head: CompiledLexRule {
            rule: rule,
            index: acc.next_index,
            first: lex_pattern_first(pattern: lex_rule_pattern(rule: rule))
          },
          tail: acc.reversed
        },
        next_index: acc.next_index + 1
      }
    }
  )
  list_reverse(xs: compiled.reversed)
}

fn lex_try_rule(rule: LexRule, source: v2.std.text.String) -> LexRuleApply {
  lex_try_compiled(
    compiled: CompiledLexRule {
      rule: rule,
      index: 0,
      first: lex_pattern_first(pattern: lex_rule_pattern(rule: rule))
    },
    source: LexCursor { source: source, index: 0 }
  )
}

fn lex_rule_apply_lexeme_length(apply: LexRuleApply) -> Int {
  match apply {
    LexRuleNoMatch => 0
    LexRuleToken { lexeme: lexeme, remaining: _, class: _ } => length(xs: lexeme)
    LexRuleTrivia { lexeme: lexeme, remaining: _ } => length(xs: lexeme)
    LexRuleAnnotation { lexeme: lexeme, remaining: _, class: _ } => length(xs: lexeme)
    LexRuleModalToken { lexeme: lexeme, remaining: _, class: _, transition: _ } => length(xs: lexeme)
  }
}

fn lex_try_rules_prefer_longer(acc: LexRuleApply, candidate: LexRuleApply) -> LexRuleApply {
  match acc {
    LexRuleNoMatch => candidate
    LexRuleToken { class: _, lexeme: _, remaining: _ } =>
      match candidate {
        LexRuleNoMatch => acc
        LexRuleToken { class: _, lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleTrivia { lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleAnnotation { class: _, lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleModalToken { class: _, lexeme: _, remaining: _, transition: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
      }
    LexRuleTrivia { lexeme: _, remaining: _ } =>
      match candidate {
        LexRuleNoMatch => acc
        LexRuleToken { class: _, lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleTrivia { lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleAnnotation { class: _, lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleModalToken { class: _, lexeme: _, remaining: _, transition: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
      }
    LexRuleAnnotation { class: _, lexeme: _, remaining: _ } =>
      match candidate {
        LexRuleNoMatch => acc
        LexRuleToken { class: _, lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleTrivia { lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleAnnotation { class: _, lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleModalToken { class: _, lexeme: _, remaining: _, transition: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
      }
    LexRuleModalToken { class: _, lexeme: _, remaining: _, transition: _ } =>
      match candidate {
        LexRuleNoMatch => acc
        LexRuleToken { class: _, lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleTrivia { lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleAnnotation { class: _, lexeme: _, remaining: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
        LexRuleModalToken { class: _, lexeme: _, remaining: _, transition: _ } =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
      }
  }
}

fn lex_try_rules(rules: List<CompiledLexRule>, source: LexCursor) -> LexRuleApply {
  fold_list(
    xs: rules,
    empty: LexRuleNoMatch,
    cons: fn(acc, compiled) {
      lex_try_rules_prefer_longer(
        acc: acc,
        candidate: lex_try_compiled(compiled: compiled, source: source)
      )
    }
  )
}

// The walk carries `line_prefix_indent_only` and advances it with the raw text of EVERY consumed lexeme — token, trivia, and annotation alike — through the shared std.source_annotation authority. It is not a `has a semantic token appeared on this line` flag, and the difference is not cosmetic: a token lexeme may itself contain line feeds, so a grammar whose tokens span lines has line boundaries INSIDE tokens rather than only in trivia. Resetting on trivia alone misclassifies every annotation following such a token.
// A lexeme's extent in UTF-8 OCTETS. Every walk offset (`pos`, Token and annotation start/end) is
// carried as v2.std.diagnostic ByteRange, so it advances by the encoding form's octet count per
// scalar, never by the scalar count: counting scalars made ByteRange hold character offsets on any
// non-ASCII source, a name carrying two meanings. The per-scalar count is the one UTF-8 table,
// std.unicode.types unicode_scalar_utf8_octet_count.
fn lexeme_utf8_octet_count(lexeme: v2.std.text.String) -> Int {
  fold_list(
    xs: lexeme,
    empty: 0,
    cons: fn(total, c) { total + unicode_scalar_utf8_octet_count(code_point: unicode_char_code_point(c: c)) }
  )
}

type LexWalkAcc {
  remaining: LexCursor
  tokens: List<Token>
  annotations: List<UnboundSourceAnnotation>
  line_prefix_indent_only: Bool
  pos: Int
  done: Bool
  error: Bool
  file: Symbol
  dispatch: LexRuleDispatch
  modes: Map<Symbol, LexRuleDispatch>
  mode_stack: List<LexModeFrame>
  mode_fault: Optional<LexWalkModeFault>
  gap_start: Int
  gap_has_break: Bool
  layout: StreamLayout
}

// One pushed mode: the dispatch to resume when it pops, and the extent of the token that pushed it,
// which is where an unterminated mode is reported.
type LexModeFrame {
  resume: LexRuleDispatch
  opened_start: Int
  opened_end: Int
}

type LexWalkModeFault
  = ModeUndeclaredAt { start: Int, end: Int }
  | ModePopAtDefaultAt { start: Int, end: Int }
  | ModeUnterminatedAt { start: Int, end: Int }

fn lex_mode_dispatches(rules: LexRuleSet) -> Map<Symbol, LexRuleDispatch> {
  fold_list(
    xs: rules.modes,
    empty: empty_map(),
    cons: fn(acc, mode) { map_insert(m: acc, key: mode.mode, value: lex_rule_dispatch(compiled_rules: lex_compile_rules(rules: mode.rules))) }
  )
}

// The walk state with its mode fields replaced; every other field carried. The one place a mode
// change is written, so the push, the pop and each refusal cannot drift apart.
fn lex_walk_with_mode(
  acc: LexWalkAcc,
  dispatch: LexRuleDispatch,
  mode_stack: List<LexModeFrame>,
  mode_fault: Optional<LexWalkModeFault>
) -> LexWalkAcc {
  let faulted = match mode_fault {
    Present { value: _ } => true
    Absent => false
  }
  LexWalkAcc {
    remaining: acc.remaining,
    tokens: acc.tokens,
    annotations: acc.annotations,
    line_prefix_indent_only: acc.line_prefix_indent_only,
    pos: acc.pos,
    done: acc.done || faulted,
    error: acc.error || faulted,
    file: acc.file,
    dispatch: dispatch,
    modes: acc.modes,
    mode_stack: mode_stack,
    mode_fault: mode_fault,
    gap_start: acc.gap_start,
    gap_has_break: acc.gap_has_break,
    layout: acc.layout
  }
}

// Applied after a mode-transition token is emitted; `start`..`end` is that token's extent. A walk
// already stopped is left as it is.
fn lex_walk_transition(acc: LexWalkAcc, transition: LexModeTransition, start: Int, end: Int) -> LexWalkAcc {
  if acc.done {
    acc
  } else {
    match transition {
      PushLexMode { mode: m } =>
        match map_lookup(m: acc.modes, key: m) {
          Present { value: d } =>
            lex_walk_with_mode(
              acc: acc,
              dispatch: d,
              mode_stack: Cons { head: LexModeFrame { resume: acc.dispatch, opened_start: start, opened_end: end }, tail: acc.mode_stack },
              mode_fault: optional_absent()
            )
          Absent =>
            lex_walk_with_mode(acc: acc, dispatch: acc.dispatch, mode_stack: acc.mode_stack, mode_fault: optional_present(value: ModeUndeclaredAt { start: start, end: end }))
        }
      PopLexMode =>
        match acc.mode_stack {
          Empty =>
            lex_walk_with_mode(acc: acc, dispatch: acc.dispatch, mode_stack: acc.mode_stack, mode_fault: optional_present(value: ModePopAtDefaultAt { start: start, end: end }))
          Cons { head: frame, tail: rest } =>
            lex_walk_with_mode(acc: acc, dispatch: frame.resume, mode_stack: rest, mode_fault: optional_absent())
        }
    }
  }
}

// End of input: a mode still pushed is an unterminated context, refused at the token that opened it.
fn lex_walk_finish(acc: LexWalkAcc) -> LexWalkAcc {
  match acc.mode_stack {
    Empty => acc
    Cons { head: frame, tail: _ } =>
      lex_walk_with_mode(acc: acc, dispatch: acc.dispatch, mode_stack: acc.mode_stack, mode_fault: optional_present(value: ModeUnterminatedAt { start: frame.opened_start, end: frame.opened_end }))
  }
}

fn lex_walk_init(src: v2.std.text.String, file: Symbol, prepared: PreparedLexRuleSet) -> LexWalkAcc {
  LexWalkAcc {
    remaining: LexCursor { source: src, index: 0 },
    tokens: std.algebra.Empty,
    annotations: std.algebra.Empty,
    line_prefix_indent_only: true,
    pos: 0,
    done: false,
    error: false,
    file: file,
    dispatch: prepared.dispatch,
    modes: prepared.modes,
    mode_stack: Empty,
    mode_fault: optional_absent(),
    gap_start: 0,
    gap_has_break: false,
    layout: stream_layout_empty()
  }
}

fn lex_walk_is_done(acc: LexWalkAcc) -> Bool {
  acc.done
}

fn lex_walk_step(acc: LexWalkAcc) -> LexWalkAcc {
  match lex_cursor_empty(cursor: acc.remaining) {
    true =>
      lex_walk_finish(
        acc: LexWalkAcc {
            remaining: acc.remaining,
            tokens: acc.tokens,
            annotations: acc.annotations,
            line_prefix_indent_only: acc.line_prefix_indent_only,
            pos: acc.pos,
            done: true,
            error: false,
            file: acc.file,
            dispatch: acc.dispatch,
            modes: acc.modes,
            mode_stack: acc.mode_stack,
            mode_fault: acc.mode_fault,
            gap_start: acc.gap_start,
            gap_has_break: acc.gap_has_break,
            layout: acc.layout
          }
      )
    false =>
      match lex_try_rules(rules: lex_dispatch_candidates(dispatch: acc.dispatch, source: acc.remaining), source: acc.remaining) {
        LexRuleNoMatch =>
          LexWalkAcc {
            remaining: acc.remaining,
            tokens: acc.tokens,
            annotations: acc.annotations,
            line_prefix_indent_only: acc.line_prefix_indent_only,
            pos: acc.pos,
            done: true,
            error: true,
            file: acc.file,
            dispatch: acc.dispatch,
            modes: acc.modes,
            mode_stack: acc.mode_stack,
            mode_fault: acc.mode_fault,
            gap_start: acc.gap_start,
            gap_has_break: acc.gap_has_break,
            layout: acc.layout
          }
        LexRuleTrivia { lexeme: lexeme, remaining: remaining } =>
          match string_is_empty(s: lexeme) {
            true =>
              LexWalkAcc {
                remaining: acc.remaining,
                tokens: acc.tokens,
                annotations: acc.annotations,
                line_prefix_indent_only: acc.line_prefix_indent_only,
                pos: acc.pos,
                done: true,
                error: true,
                file: acc.file,
                dispatch: acc.dispatch,
                modes: acc.modes,
                mode_stack: acc.mode_stack,
                mode_fault: acc.mode_fault,
                gap_start: acc.gap_start,
                gap_has_break: acc.gap_has_break,
                layout: acc.layout
              }
            false =>
              LexWalkAcc {
                remaining: remaining,
                tokens: acc.tokens,
                annotations: acc.annotations,
                line_prefix_indent_only: advance_line_prefix_indent_only(previous: acc.line_prefix_indent_only, code_points: lexeme),
                pos: acc.pos + lexeme_utf8_octet_count(lexeme: lexeme),
                done: false,
                error: false,
                file: acc.file,
                dispatch: acc.dispatch,
                modes: acc.modes,
                mode_stack: acc.mode_stack,
                mode_fault: acc.mode_fault,
                gap_start: acc.gap_start,
                gap_has_break: acc.gap_has_break || lexeme_has_line_feed(lexeme: lexeme),
                layout: acc.layout
              }
          }
        LexRuleToken { class: class, lexeme: lexeme, remaining: remaining } =>
          lex_walk_emit_token(acc: acc, class: class, lexeme: lexeme, remaining: remaining)
        LexRuleAnnotation { class: class, lexeme: lexeme, remaining: remaining } =>
          match string_is_empty(s: lexeme) {
            true =>
              LexWalkAcc {
                remaining: acc.remaining,
                tokens: acc.tokens,
                annotations: acc.annotations,
                line_prefix_indent_only: acc.line_prefix_indent_only,
                pos: acc.pos,
                done: true,
                error: true,
                file: acc.file,
                dispatch: acc.dispatch,
                modes: acc.modes,
                mode_stack: acc.mode_stack,
                mode_fault: acc.mode_fault,
                gap_start: acc.gap_start,
                gap_has_break: acc.gap_has_break,
                layout: acc.layout
              }
            false =>
              LexWalkAcc {
                remaining: remaining,
                tokens: acc.tokens,
                annotations: Cons {
                  head: UnboundSourceAnnotation {
                    annotation_class: class,
                    lexeme: chars_to_string(chars: lexeme, start: 0, end: length(xs: lexeme)),
                    placement: placement_from_line_prefix(indent_only: acc.line_prefix_indent_only),
                    file: acc.file,
                    start: acc.pos,
                    end: acc.pos + lexeme_utf8_octet_count(lexeme: lexeme)
                  },
                  tail: acc.annotations
                },
                line_prefix_indent_only: advance_line_prefix_indent_only(previous: acc.line_prefix_indent_only, code_points: lexeme),
                pos: acc.pos + lexeme_utf8_octet_count(lexeme: lexeme),
                done: false,
                error: false,
                file: acc.file,
                dispatch: acc.dispatch,
                modes: acc.modes,
                mode_stack: acc.mode_stack,
                mode_fault: acc.mode_fault,
                gap_start: acc.gap_start,
                gap_has_break: acc.gap_has_break || lexeme_has_line_feed(lexeme: lexeme),
                layout: acc.layout
              }
          }
        LexRuleModalToken { class: class, lexeme: lexeme, remaining: remaining, transition: t } =>
          lex_walk_transition(
            acc: lex_walk_emit_token(acc: acc, class: class, lexeme: lexeme, remaining: remaining),
            transition: t,
            start: acc.pos,
            end: acc.pos + lexeme_utf8_octet_count(lexeme: lexeme)
          )
      }
  }
}

// A token rule's match, emitted onto the walk: shared by the plain and the mode-transition token arms.
fn lex_walk_emit_token(acc: LexWalkAcc, class: Symbol, lexeme: v2.std.text.String, remaining: LexCursor) -> LexWalkAcc {
  match string_is_empty(s: lexeme) {
    true =>
      LexWalkAcc {
        remaining: acc.remaining,
        tokens: acc.tokens,
        annotations: acc.annotations,
        line_prefix_indent_only: acc.line_prefix_indent_only,
        pos: acc.pos,
        done: true,
        error: true,
        file: acc.file,
        dispatch: acc.dispatch,
        modes: acc.modes,
        mode_stack: acc.mode_stack,
        mode_fault: acc.mode_fault,
        gap_start: acc.gap_start,
        gap_has_break: acc.gap_has_break,
        layout: acc.layout
      }
    false =>
      LexWalkAcc {
        remaining: remaining,
        tokens: Cons {
          head: Token {
            class: class,
            lexeme: chars_to_string(chars: lexeme, start: 0, end: length(xs: lexeme)),
            file: acc.file,
            start: acc.pos,
            end: acc.pos + lexeme_utf8_octet_count(lexeme: lexeme)
          },
          tail: acc.tokens
        },
        annotations: acc.annotations,
        line_prefix_indent_only: advance_line_prefix_indent_only(previous: acc.line_prefix_indent_only, code_points: lexeme),
        pos: acc.pos + lexeme_utf8_octet_count(lexeme: lexeme),
        done: false,
        error: false,
        file: acc.file,
        dispatch: acc.dispatch,
        modes: acc.modes,
        mode_stack: acc.mode_stack,
        mode_fault: acc.mode_fault,
        gap_start: acc.pos + lexeme_utf8_octet_count(lexeme: lexeme),
        gap_has_break: false,
        layout: if acc.gap_has_break { stream_layout_with_break(layout: acc.layout, token_start: acc.pos, gap_start: acc.gap_start) } else { acc.layout }
      }
  }
}

fn lex_walk_source_algebra(file: Symbol, prepared: PreparedLexRuleSet) -> SourceFold<LexWalkAcc> {
  SourceFold {
    init: fn(src) { lex_walk_init(src: src, file: file, prepared: prepared) },
    is_done: lex_walk_is_done,
    step: lex_walk_step
  }
}

// The unmatched scalar's width in octets, so the refusal extent covers exactly that one scalar.
fn lex_unmatched_scalar_octets(remaining: LexCursor) -> Int {
  match lex_cursor_head(cursor: remaining) {
    CharFound { value: c } => unicode_scalar_utf8_octet_count(code_point: unicode_char_code_point(c: c))
    CharAbsent => 0
  }
}

// lex_walk_artifact is the authored result; lex_walk is its SEMANTIC PROJECTION and is what every existing caller keeps using. The direction matters: the projection is derived from the artifact by dropping the annotation channel, never the reverse, so a semantic consumer cannot reach annotation text and an annotation-aware consumer does not have to re-lex. Both fold the same walk exactly once — this is one traversal read two ways, not two traversals (DESIGN 4c erasure boundary at the lexical layer, mirroring AuthoredParseArtifact at the parse layer).
// Zero-width [pos, pos] is the caret BEFORE the unmatched character, so a refusal on an offending literal landed on the insertion point rather than covering the character. Cover one scalar, in octets, when remaining is nonempty.
fn lex_walk_artifact(source: v2.std.text.String, file: Symbol, rules: LexRuleSet) -> Outcome<LexArtifact> {
  lex_walk_artifact_prepared(source: source, file: file, prepared: prepare_lex_rule_set(rules: rules))
}

fn lex_walk_artifact_prepared(source: v2.std.text.String, file: Symbol, prepared: PreparedLexRuleSet) -> Outcome<LexArtifact> {
  match prepared.mode_refusal {
    Present { value: refusal } =>
      v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e5_mode_declaration_diagnostic(file: file, refusal: refusal)) }
    Absent => lex_walk_artifact_walked(source: source, file: file, prepared: prepared)
  }
}

fn lex_walk_mode_fault_diagnostic(file: Symbol, fault: LexWalkModeFault) -> Diagnostic {
  match fault {
    ModeUndeclaredAt { start: a, end: b } => tokenize_lex_e2_mode_undeclared_diagnostic(at: Textual { file: file, extent: ByteRange { start: a, end: b } })
    ModePopAtDefaultAt { start: a, end: b } => tokenize_lex_e3_mode_pop_at_default_diagnostic(at: Textual { file: file, extent: ByteRange { start: a, end: b } })
    ModeUnterminatedAt { start: a, end: b } => tokenize_lex_e4_mode_unterminated_diagnostic(at: Textual { file: file, extent: ByteRange { start: a, end: b } })
  }
}

fn lex_walk_artifact_walked(source: v2.std.text.String, file: Symbol, prepared: PreparedLexRuleSet) -> Outcome<LexArtifact> {
  let result = fold_source(
    src: source,
    algebra: lex_walk_source_algebra(file: file, prepared: prepared)
  )
  let at = match lex_cursor_empty(cursor: result.remaining) {
    true => Textual { file: file, extent: ByteRange { start: result.pos, end: result.pos } }
    false => Textual { file: file, extent: ByteRange { start: result.pos, end: result.pos + lex_unmatched_scalar_octets(remaining: result.remaining) } }
  }
  if result.error {
    match result.mode_fault {
      Present { value: fault } =>
        v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: lex_walk_mode_fault_diagnostic(file: file, fault: fault)) }
      Absent =>
        v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e1_unrecognized_char_diagnostic(at: at)) }
    }
  } else {
    v2.std.diagnostic.Accepted {
      value: lex_artifact_new(
        tokens: token_stream_lexed(all: list_reverse(xs: result.tokens), layout: result.layout),
        annotations: list_reverse(xs: result.annotations)
      ),
      diagnostics: v2.std.diagnostic.None
    }
  }
}

fn lex_walk(source: v2.std.text.String, file: Symbol, rules: LexRuleSet) -> Outcome<TokenStream> {
  lex_walk_prepared(source: source, file: file, prepared: prepare_lex_rule_set(rules: rules))
}

fn lex_walk_prepared(source: v2.std.text.String, file: Symbol, prepared: PreparedLexRuleSet) -> Outcome<TokenStream> {
  match lex_walk_artifact_prepared(source: source, file: file, prepared: prepared) {
    v2.std.diagnostic.Rejected { diagnostics: ds } =>
      v2.std.diagnostic.Rejected { diagnostics: ds }
    v2.std.diagnostic.Accepted { value: artifact, diagnostics: ds } =>
      v2.std.diagnostic.Accepted { value: lex_artifact_semantic_tokens(artifact: artifact), diagnostics: ds }
  }
}

// THE ONE SOURCE-TEXT INGRESS, AND THE ONLY PLACE HOST TEXT BECOMES STRUCTURAL TEXT IN THIS MODULE.
//
// `text` is host-valued ON PURPOSE and its spelling is not an oversight: the filesystem REPORTS
// source text, so what reaches this parameter is what a read returned. v2.compiler.source_authority
// hands over exactly the value it hashed, and the read boundary performs no lexical interpretation
// — deciding what a character IS belongs to the lexer, which is here.
//
// `chars` is the SAME scalar decomposition the literal elaborator uses. v1.compiler.infer
// unfold_scalar_sequence_image builds the UnicodeScalarSequenceUnfold image by calling it, so the
// runtime converter and the literal elaborator are two producers deriving one meaning from one
// authority rather than two loops that agree by coincidence. Scalar values, never UTF-8 bytes and
// never UTF-16 code units — an ad hoc byte loop would agree with this on ASCII and diverge on the
// first non-ASCII source file, which is precisely the divergence a shared authority forecloses.
//
// EXACTLY ONCE, ABOVE EVERYTHING. Both arms below read the converted value, so no lexical callback,
// prefix operation, walk state or fold ever receives the host form. A second conversion further in
// would be a second answer to a question already answered.
//
// THIS AUTHORIZES ONE CONVERSION AT ONE INGRESS AND NOTHING WIDER. It is not permission for
// arbitrary host Strings to inhabit structural text: gunbc.rung_drop's
// text_boundary_identity_wall stands, its subject is the non-literal host value crossing an exact
// structural-text boundary through permissive compatibility, and this named morphism does not
// retire it. A green ingress here is not that wall coming down.
fn tokenize(text: String, file: Symbol, rules: LexRules) -> Outcome<TokenStream> {
  tokenize_prepared(text: text, file: file, prepared: prepare_lex_rules(rules: rules))
}

// THE COMPILED RULES ARE A PROPERTY OF THE LANGUAGE, NOT OF THE TEXT. Compiling a rule set (each
// rule's matcher, the first-character dispatch over them, one dispatch per declared mode) and
// checking its mode declarations depend on the rules alone, so prepare_lex_rules does that once and
// every tokenize of every text under the same rules reads the result. tokenize above is the
// one-text door and prepares for that one call; a caller that tokenizes many texts under one
// language (the per-file assembly fold, the front ends) prepares once beside prepare_grammar and
// calls tokenize_prepared, exactly as the parse reads PreparedGrammar.
type PreparedLexRuleSet {
  dispatch: LexRuleDispatch
  modes: Map<Symbol, LexRuleDispatch>
  mode_refusal: Optional<LexModeDeclarationRefusal>
}

type PreparedLexRules
  = PreparedVoidLexRules
  | PreparedModeledLexRules { root: PreparedLexRuleSet }

fn prepare_lex_rule_set(rules: LexRuleSet) -> PreparedLexRuleSet {
  PreparedLexRuleSet {
    dispatch: lex_rule_dispatch(compiled_rules: lex_compile_rules(rules: rules.rules)),
    modes: lex_mode_dispatches(rules: rules),
    mode_refusal: lex_rule_set_mode_refusal(rules: rules)
  }
}

fn prepare_lex_rules(rules: LexRules) -> PreparedLexRules {
  match rules {
    VoidLexRules => PreparedVoidLexRules
    ModeledLexRules { root: rule_set } => PreparedModeledLexRules { root: prepare_lex_rule_set(rules: rule_set) }
  }
}

fn tokenize_prepared(text: String, file: Symbol, prepared: PreparedLexRules) -> Outcome<TokenStream> {
  let source = chars(s: text)
  let at = Textual {
    file: file,
    extent: WholeFile
  }
  match prepared {
    PreparedVoidLexRules =>
      if is_empty(xs: source) {
        v2.std.diagnostic.Accepted { value: token_stream_empty(), diagnostics: v2.std.diagnostic.None }
      } else {
        v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)) }
      }
    PreparedModeledLexRules { root: prepared_set } =>
      lex_walk_prepared(source: source, file: file, prepared: prepared_set)
  }
}

data tokenize_module_authority_note: String = "Wave 2 Gate-A flip lane (01_tokenize self-emit): data-driven lexing via ModeledLexRules/LexRuleSet fold — no hand-rolled tokenizer. Curated seed-linked behavioral receipt compares emitted vs seed oracle constant; full token-stream equivalence oracle deferred until emit Rc/Optional surface greens (#6775)."
