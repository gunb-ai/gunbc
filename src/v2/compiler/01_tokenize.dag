module v2.compiler.tokenize


type LexMatchResult
  = LexMatchAccepted { remaining: String, lexeme: String }
  | LexMatchRejected

type LexRuleApply
  = LexRuleNoMatch
  | LexRuleToken { class: v2.std.node.Symbol, lexeme: String, remaining: String }
  | LexRuleTrivia { lexeme: String, remaining: String }
  | LexRuleAnnotation { class: v2.std.node.Symbol, lexeme: String, remaining: String }

type LexMatchThunk {
  apply: fn(String) -> v2.compiler.tokenize.LexMatchResult
}

fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn tokenize_lex_e1_unrecognized_char_diagnostic(at: v2.std.diagnostic.Locus) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^tokenize_lex_e1_unrecognized_char,
    at: at,
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.UserInputBoundary }
  }
}

fn char_in_class(c: std.types.Char, class: v2.std.compilers.lexing.LexCharClass) -> Bool {
  match class {
    WhitespaceChar =>
      c == 32 || c == 9 || c == 10 || c == 13
    DigitChar =>
      (c >= 48) && (c <= 57)
    HexDigitChar =>
      ((c >= 48) && (c <= 57)) ||
      ((c >= 65) && (c <= 70)) ||
      ((c >= 97) && (c <= 102))
    IdentStartChar =>
      ((c >= 65) && (c <= 90)) ||
      ((c >= 97) && (c <= 122)) ||
      c == 95
    IdentContinueChar =>
      ((c >= 65) && (c <= 90)) ||
      ((c >= 97) && (c <= 122)) ||
      c == 95 ||
      ((c >= 48) && (c <= 57))
    StringTextChar =>
      c != 34 && c != 10
    LineCommentTextChar =>
      c != 10
    BlockCommentTextChar =>
      c != 42
  }
}

fn lex_strip_prefix(prefix: String, source: String) -> v2.std.algebra.ListTailResult<std.types.Char> {
  v2.std.algebra.fold_list(
    xs: prefix,
    empty: v2.std.algebra.TailFound { tail: source },
    cons: fn(acc, _) {
      match acc {
        TailAbsent => v2.std.algebra.TailAbsent
        TailFound { tail: r } => v2.std.algebra.list_tail(xs: r)
      }
    }
  )
}

fn lex_match_prefix(prefix: String, source: String) -> v2.compiler.tokenize.LexMatchResult {
  if v2.std.algebra.is_prefix_of(prefix: prefix, xs: source, eq: fn(a, b) { a == b }) {
    match lex_strip_prefix(prefix: prefix, source: source) {
      TailFound { tail: rem } => LexMatchAccepted { remaining: rem, lexeme: prefix }
      TailAbsent => LexMatchRejected
    }
  } else {
    LexMatchRejected
  }
}

type RepeatState {
  remaining: String
  lexeme: String
  done: Bool
}

type DelimitedState {
  remaining: String
  lexeme: String
  done: Bool
  failed: Bool
}

fn lex_rule_pattern(rule: v2.std.compilers.lexing.LexRule) -> v2.std.compilers.lexing.LexPattern {
  match rule {
    TokenRule { token_class: _, pattern: p } => p
    TriviaRule { pattern: p } => p
    AnnotationRule { annotation_class: _, pattern: p } => p
  }
}

fn lex_match_char_pred(pred: fn(Char) -> Bool, source: String) -> v2.compiler.tokenize.LexMatchResult {
  match v2.std.text.string_is_empty(s: source) {
    true => LexMatchRejected
    false =>
      match v2.std.text.string_head(s: source) {
        CharAbsent => LexMatchRejected
        CharFound { value: c } =>
          match pred(c) {
            true =>
              match v2.std.text.string_tail(s: source) {
                TailFound { tail: rest } =>
                  LexMatchAccepted { remaining: rest, lexeme: std.algebra.Cons { head: c, tail: std.algebra.Empty } }
                TailAbsent => LexMatchRejected
              }
            false => LexMatchRejected
          }
      }
  }
}

fn lex_repeat_step(elem_r: v2.compiler.tokenize.LexMatchThunk, state: v2.compiler.tokenize.RepeatState) -> v2.compiler.tokenize.RepeatState {
  match state.done {
    true => state
    false =>
      match elem_r.apply(state.remaining) {
        LexMatchRejected =>
          RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
        LexMatchAccepted { remaining: rest, lexeme: consumed } =>
          match v2.std.text.string_is_empty(s: consumed) {
            true =>
              RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
            false =>
              lex_repeat_step(
                elem_r: elem_r,
                state: v2.compiler.tokenize.RepeatState {
                  remaining: rest,
                  lexeme: v2.std.algebra.list_append(left: state.lexeme, right: consumed),
                  done: false
                }
              )
          }
      }
  }
}

fn lex_repeat_loop(elem_r: v2.compiler.tokenize.LexMatchThunk, init: v2.compiler.tokenize.RepeatState) -> v2.compiler.tokenize.RepeatState {
  lex_repeat_step(elem_r: elem_r, state: init)
}

fn lex_delimited_step(close_r: v2.compiler.tokenize.LexMatchThunk, body_r: v2.compiler.tokenize.LexMatchThunk, state: v2.compiler.tokenize.DelimitedState) -> v2.compiler.tokenize.DelimitedState {
  match state.done {
    true => state
    false =>
      match close_r.apply(state.remaining) {
        LexMatchAccepted { remaining: after_close, lexeme: close_lex } =>
          DelimitedState {
            remaining: after_close,
            lexeme: v2.std.algebra.list_append(left: state.lexeme, right: close_lex),
            done: true,
            failed: false
          }
        LexMatchRejected =>
          match body_r.apply(state.remaining) {
            LexMatchRejected =>
              DelimitedState { remaining: state.remaining, lexeme: state.lexeme, done: true, failed: true }
            LexMatchAccepted { remaining: after_body, lexeme: body_lex } =>
              match v2.std.text.string_is_empty(s: body_lex) {
                true =>
                  DelimitedState { remaining: state.remaining, lexeme: state.lexeme, done: true, failed: true }
                false =>
                  lex_delimited_step(
                    close_r: close_r,
                    body_r: body_r,
                    state: v2.compiler.tokenize.DelimitedState {
                      remaining: after_body,
                      lexeme: v2.std.algebra.list_append(left: state.lexeme, right: body_lex),
                      done: false,
                      failed: false
                    }
                  )
              }
          }
      }
  }
}

type CompiledLexRule {
  rule: v2.std.compilers.lexing.LexRule
  thunk: v2.compiler.tokenize.LexMatchThunk
}

fn lex_rule_thunk(rule: v2.std.compilers.lexing.LexRule) -> v2.compiler.tokenize.LexMatchThunk {
  v2.std.compilers.lexing.fold_lex_pattern(
    pattern: lex_rule_pattern(rule: rule),
    algebra: v2.std.compilers.lexing.LexPatternFold {
      empty: v2.compiler.tokenize.LexMatchThunk { apply: fn(s) {
        LexMatchAccepted { remaining: s, lexeme: std.algebra.Empty }
      } },
      literal: fn(text) {
        LexMatchThunk { apply: fn(s) {
          lex_match_prefix(prefix: text, source: s)
        } }
      },
      keyword: fn(text) {

        LexMatchThunk { apply: fn(s) {
          match lex_match_prefix(prefix: text, source: s) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              match v2.std.text.string_is_empty(s: rest) {
                true => LexMatchAccepted { remaining: rest, lexeme: lex }
                false =>
                  match v2.std.text.string_head(s: rest) {
                    CharAbsent => LexMatchAccepted { remaining: rest, lexeme: lex }
                    CharFound { value: c } =>
                      match v2.compiler.tokenize.char_in_class(c: c, class: v2.std.compilers.lexing.IdentContinueChar) {
                        true => LexMatchRejected
                        false => LexMatchAccepted { remaining: rest, lexeme: lex }
                      }
                  }
              }
          }
        } }
      },
      char: fn(expected) {
        LexMatchThunk { apply: fn(s) { lex_match_char_pred(pred: fn(c) { c == expected }, source: s) } }
      },
      char_class: fn(class) {
        LexMatchThunk { apply: fn(s) { lex_match_char_pred(pred: fn(c) { v2.compiler.tokenize.char_in_class(c: c, class: class) }, source: s) } }
      },
      sequence: fn(left_r, right_r) {
        LexMatchThunk { apply: fn(s) {
          match left_r.apply(s) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest1, lexeme: lex1 } =>
              match right_r.apply(rest1) {
                LexMatchRejected => LexMatchRejected
                LexMatchAccepted { remaining: rest2, lexeme: lex2 } =>
                  LexMatchAccepted { remaining: rest2, lexeme: v2.std.algebra.list_append(left: lex1, right: lex2) }
              }
          }
        } }
      },
      choice: fn(left_r, right_r) {
        LexMatchThunk { apply: fn(s) {
          match left_r.apply(s) {
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              LexMatchAccepted { remaining: rest, lexeme: lex }
            LexMatchRejected => right_r.apply(s)
          }
        } }
      },
      optional: fn(elem_r) {
        LexMatchThunk { apply: fn(s) {
          match elem_r.apply(s) {
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              LexMatchAccepted { remaining: rest, lexeme: lex }
            LexMatchRejected =>
              LexMatchAccepted { remaining: s, lexeme: std.algebra.Empty }
          }
        } }
      },
      repeat: fn(elem_r) {

        LexMatchThunk { apply: fn(s) {
          let result = lex_repeat_loop(elem_r: elem_r, init: v2.compiler.tokenize.RepeatState { remaining: s, lexeme: std.algebra.Empty, done: false })
          LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
        } }
      },
      one_or_more: fn(elem_r) {

        LexMatchThunk { apply: fn(s) {
          match elem_r.apply(s) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              let result = lex_repeat_loop(elem_r: elem_r, init: v2.compiler.tokenize.RepeatState { remaining: rest, lexeme: lex, done: false })
              LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
          }
        } }
      },
      delimited: fn(open_r, body_r, close_r) {

        LexMatchThunk { apply: fn(s) {
          match open_r.apply(s) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: after_open, lexeme: open_lex } =>
              let init = DelimitedState { remaining: after_open, lexeme: open_lex, done: false, failed: false }
              let result = lex_delimited_step(close_r: close_r, body_r: body_r, state: init)
              match result.done {
                false => LexMatchRejected
                true =>
                  match result.failed {
                    true => LexMatchRejected
                    false => LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
                  }
              }
          }
        } }
      }
    }
  )
}

fn lex_try_compiled(compiled: v2.compiler.tokenize.CompiledLexRule, source: String) -> v2.compiler.tokenize.LexRuleApply {
  match compiled.thunk.apply(source) {
    LexMatchRejected => LexRuleNoMatch
    LexMatchAccepted { remaining: remaining, lexeme: lexeme } =>
      match compiled.rule {
        TokenRule { token_class: class, pattern: _ } =>
          LexRuleToken { class: class, lexeme: lexeme, remaining: remaining }
        TriviaRule { pattern: _ } =>
          LexRuleTrivia { lexeme: lexeme, remaining: remaining }
        AnnotationRule { annotation_class: class, pattern: _ } =>
          LexRuleAnnotation { class: class, lexeme: lexeme, remaining: remaining }
      }
  }
}

fn lex_compile_rules(rules: List<v2.std.compilers.lexing.LexRule>) -> List<v2.compiler.tokenize.CompiledLexRule> {
  let reversed = v2.std.algebra.fold_list(
    xs: rules,
    empty: std.algebra.Empty,
    cons: fn(acc, rule) {
      std.algebra.Cons { head: v2.compiler.tokenize.CompiledLexRule { rule: rule, thunk: lex_rule_thunk(rule: rule) }, tail: acc }
    }
  )
  reversed.reverse()
}

fn lex_try_rule(rule: v2.std.compilers.lexing.LexRule, source: String) -> v2.compiler.tokenize.LexRuleApply {
  lex_try_compiled(
    compiled: v2.compiler.tokenize.CompiledLexRule { rule: rule, thunk: lex_rule_thunk(rule: rule) },
    source: source
  )
}

fn lex_rule_apply_lexeme_length(apply: v2.compiler.tokenize.LexRuleApply) -> Int {
  match apply {
    LexRuleNoMatch => 0
    LexRuleToken { lexeme: lexeme, remaining: _, class: _ } => v2.std.algebra.length(xs: lexeme)
    LexRuleTrivia { lexeme: lexeme, remaining: _ } => v2.std.algebra.length(xs: lexeme)
    LexRuleAnnotation { lexeme: lexeme, remaining: _, class: _ } => v2.std.algebra.length(xs: lexeme)
  }
}

fn lex_try_rules_prefer_longer(acc: v2.compiler.tokenize.LexRuleApply, candidate: v2.compiler.tokenize.LexRuleApply) -> v2.compiler.tokenize.LexRuleApply {
  match acc {
    LexRuleNoMatch => candidate
    _ =>
      match candidate {
        LexRuleNoMatch => acc
        _ =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
      }
  }
}

fn lex_try_rules(rules: List<v2.compiler.tokenize.CompiledLexRule>, source: String) -> v2.compiler.tokenize.LexRuleApply {
  v2.std.algebra.fold_list(
    xs: rules,
    empty: LexRuleNoMatch,
    cons: fn(acc, compiled) {
      lex_try_rules_prefer_longer(
        acc: acc,
        candidate: lex_try_compiled(compiled: compiled, source: source)
      )
    }
  )
}

// The walk carries `line_prefix_indent_only` and advances it with the raw text of EVERY consumed lexeme — token, trivia, and annotation alike — through the shared std.source_annotation authority. It is not a `has a semantic token appeared on this line` flag, and the difference is not cosmetic: a token lexeme may itself contain line feeds, so a grammar whose tokens span lines has line boundaries INSIDE tokens rather than only in trivia. Resetting on trivia alone misclassifies every annotation following such a token.
type LexWalkAcc {
  remaining: String
  tokens: List<v2.std.compilers.lexing.Token>
  annotations: List<v2.std.compilers.lexing.UnboundSourceAnnotation>
  line_prefix_indent_only: Bool
  pos: Int
  done: Bool
  error: Bool
  file: v2.std.node.Symbol
  rules: List<v2.compiler.tokenize.CompiledLexRule>
}

fn lex_walk_init(src: String, file: v2.std.node.Symbol, rules: v2.std.compilers.lexing.LexRuleSet) -> v2.compiler.tokenize.LexWalkAcc {
  LexWalkAcc {
    remaining: src,
    tokens: std.algebra.Empty,
    annotations: std.algebra.Empty,
    line_prefix_indent_only: true,
    pos: 0,
    done: false,
    error: false,
    file: file,
    rules: lex_compile_rules(rules: rules.rules)
  }
}

fn lex_walk_is_done(acc: v2.compiler.tokenize.LexWalkAcc) -> Bool {
  acc.done
}

fn lex_walk_step(acc: v2.compiler.tokenize.LexWalkAcc) -> v2.compiler.tokenize.LexWalkAcc {
  match v2.std.text.string_is_empty(s: acc.remaining) {
    true =>
      LexWalkAcc {
        remaining: acc.remaining,
        tokens: acc.tokens,
        annotations: acc.annotations,
        line_prefix_indent_only: acc.line_prefix_indent_only,
        pos: acc.pos,
        done: true,
        error: false,
        file: acc.file,
        rules: acc.rules
      }
    false =>
      match lex_try_rules(rules: acc.rules, source: acc.remaining) {
        LexRuleNoMatch =>
          LexWalkAcc {
            remaining: acc.remaining,
            tokens: acc.tokens,
            annotations: acc.annotations,
            line_prefix_indent_only: acc.line_prefix_indent_only,
            pos: acc.pos,
            done: true,
            error: true,
            file: acc.file,
            rules: acc.rules
          }
        LexRuleTrivia { lexeme: lexeme, remaining: remaining } =>
          match v2.std.text.string_is_empty(s: lexeme) {
            true =>
              LexWalkAcc {
                remaining: acc.remaining,
                tokens: acc.tokens,
                annotations: acc.annotations,
                line_prefix_indent_only: acc.line_prefix_indent_only,
                pos: acc.pos,
                done: true,
                error: true,
                file: acc.file,
                rules: acc.rules
              }
            false =>
              LexWalkAcc {
                remaining: remaining,
                tokens: acc.tokens,
                annotations: acc.annotations,
                line_prefix_indent_only: std.source_annotation.advance_line_prefix_indent_only(previous: acc.line_prefix_indent_only, code_points: lexeme),
                pos: acc.pos + v2.std.algebra.length(xs: lexeme),
                done: false,
                error: false,
                file: acc.file,
                rules: acc.rules
              }
          }
        LexRuleToken { class: class, lexeme: lexeme, remaining: remaining } =>
          match v2.std.text.string_is_empty(s: lexeme) {
            true =>
              LexWalkAcc {
                remaining: acc.remaining,
                tokens: acc.tokens,
                annotations: acc.annotations,
                line_prefix_indent_only: acc.line_prefix_indent_only,
                pos: acc.pos,
                done: true,
                error: true,
                file: acc.file,
                rules: acc.rules
              }
            false =>
              LexWalkAcc {
                remaining: remaining,
                tokens: std.algebra.Cons {
                  head: v2.std.compilers.lexing.Token {
                    class: class,
                    lexeme: lexeme,
                    file: acc.file,
                    start: acc.pos,
                    end: acc.pos + v2.std.algebra.length(xs: lexeme)
                  },
                  tail: acc.tokens
                },
                annotations: acc.annotations,
                line_prefix_indent_only: std.source_annotation.advance_line_prefix_indent_only(previous: acc.line_prefix_indent_only, code_points: lexeme),
                pos: acc.pos + v2.std.algebra.length(xs: lexeme),
                done: false,
                error: false,
                file: acc.file,
                rules: acc.rules
              }
          }
        LexRuleAnnotation { class: class, lexeme: lexeme, remaining: remaining } =>
          match v2.std.text.string_is_empty(s: lexeme) {
            true =>
              LexWalkAcc {
                remaining: acc.remaining,
                tokens: acc.tokens,
                annotations: acc.annotations,
                line_prefix_indent_only: acc.line_prefix_indent_only,
                pos: acc.pos,
                done: true,
                error: true,
                file: acc.file,
                rules: acc.rules
              }
            false =>
              LexWalkAcc {
                remaining: remaining,
                tokens: acc.tokens,
                annotations: std.algebra.Cons {
                  head: v2.std.compilers.lexing.UnboundSourceAnnotation {
                    annotation_class: class,
                    lexeme: lexeme,
                    placement: std.source_annotation.placement_from_line_prefix(indent_only: acc.line_prefix_indent_only),
                    file: acc.file,
                    start: acc.pos,
                    end: acc.pos + v2.std.algebra.length(xs: lexeme)
                  },
                  tail: acc.annotations
                },
                line_prefix_indent_only: std.source_annotation.advance_line_prefix_indent_only(previous: acc.line_prefix_indent_only, code_points: lexeme),
                pos: acc.pos + v2.std.algebra.length(xs: lexeme),
                done: false,
                error: false,
                file: acc.file,
                rules: acc.rules
              }
          }
      }
  }
}

fn lex_walk_source_algebra(file: v2.std.node.Symbol, rules: v2.std.compilers.lexing.LexRuleSet) -> v2.std.text.SourceFold<v2.compiler.tokenize.LexWalkAcc> {
  v2.std.text.SourceFold {
    init: fn(src) { lex_walk_init(src: src, file: file, rules: rules) },
    is_done: lex_walk_is_done,
    step: lex_walk_step
  }
}

// lex_walk_artifact is the authored result; lex_walk is its SEMANTIC PROJECTION and is what every existing caller keeps using. The direction matters: the projection is derived from the artifact by dropping the annotation channel, never the reverse, so a semantic consumer cannot reach annotation text and an annotation-aware consumer does not have to re-lex. Both fold the same walk exactly once — this is one traversal read two ways, not two traversals (DESIGN 4c erasure boundary at the lexical layer, mirroring AuthoredParseArtifact at the parse layer).
fn lex_walk_artifact(source: String, file: v2.std.node.Symbol, rules: v2.std.compilers.lexing.LexRuleSet) -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.LexArtifact> {
  let result = v2.std.text.fold_source(
    src: source,
    algebra: lex_walk_source_algebra(file: file, rules: rules)
  )
  let at = v2.std.diagnostic.Textual { file: file, extent: v2.std.diagnostic.ByteRange { start: result.pos, end: result.pos } }
  if result.error {
    v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: tokenize_lex_e1_unrecognized_char_diagnostic(at: at)) }
  } else {
    v2.std.diagnostic.Accepted {
      value: v2.std.compilers.lexing.lex_artifact_new(
        tokens: v2.std.compilers.lexing.token_stream_new(all: result.tokens.reverse()),
        annotations: result.annotations.reverse()
      ),
      diagnostics: v2.std.diagnostic.None
    }
  }
}

fn lex_walk(source: String, file: v2.std.node.Symbol, rules: v2.std.compilers.lexing.LexRuleSet) -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.TokenStream> {
  match lex_walk_artifact(source: source, file: file, rules: rules) {
    Rejected { diagnostics: ds } =>
      v2.std.diagnostic.Rejected { diagnostics: ds }
    Accepted { value: artifact, diagnostics: ds } =>
      v2.std.diagnostic.Accepted { value: v2.std.compilers.lexing.lex_artifact_semantic_tokens(artifact: artifact), diagnostics: ds }
  }
}

fn tokenize(text: String, file: v2.std.node.Symbol, rules: v2.std.compilers.lexing.LexRules) -> v2.std.diagnostic.Outcome<v2.std.compilers.lexing.TokenStream> {
  let at = v2.std.diagnostic.Textual {
    file: file,
    extent: v2.std.diagnostic.WholeFile
  }
  match rules {
    VoidLexRules =>
      if v2.std.algebra.is_empty(xs: text) {
        v2.std.diagnostic.Accepted { value: v2.std.compilers.lexing.token_stream_empty(), diagnostics: v2.std.diagnostic.None }
      } else {
        v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)) }
      }
    ModeledLexRules { root: rule_set } =>
      lex_walk(source: text, file: file, rules: rule_set)
  }
}

data tokenize_module_authority_note: String = "Wave 2 Gate-A flip lane (01_tokenize self-emit): data-driven lexing via v2.std.compilers.lexing.ModeledLexRules/v2.std.compilers.lexing.LexRuleSet fold — no hand-rolled tokenizer. Curated seed-linked behavioral receipt compares emitted vs seed oracle constant; full token-stream equivalence oracle deferred until emit Rc/Optional surface greens (#6775)."
