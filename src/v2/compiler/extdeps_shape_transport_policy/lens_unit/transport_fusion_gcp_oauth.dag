// Scope: lens-unit RED witness — GCP OAuth2 refresh forked across REST + shell.
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v2.test.extdeps_shape_transport_policy.lens_unit.transport_fusion_gcp_oauth

import v2.lens.extdeps_shape_transport_policy {
  ExtdepsTransportArgvFact,
  ExtdepsTransportFusionFact,
  extdeps_shape_transport_policy_violation_count
}
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

data transport_fusion_gcp_oauth_argv_facts: List<ExtdepsTransportArgvFact> = []

data transport_fusion_gcp_oauth_fusion_facts: List<ExtdepsTransportFusionFact> = [
  ExtdepsTransportFusionFact {
    path: "dsl/extdeps/cloud/gcp/gcp.dag",
    endpoint_key: "oauth2:refresh",
    service_a: "oauth2.Google",
    service_b: "shell.OAuth2"
  }
]

fn transport_fusion_gcp_oauth_is_red_holds() -> Bool {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: transport_fusion_gcp_oauth_argv_facts,
    fusion_facts: transport_fusion_gcp_oauth_fusion_facts
  ) == 1
}

data unified_claim_transport_fusion_gcp_oauth: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v2/compiler/extdeps_shape_transport_policy/lens_unit/transport_fusion_gcp_oauth.dag",
    function: transport_fusion_gcp_oauth_is_red_holds
  }
}
