module v2.test.extdeps_shape_transport_policy.lens_unit.transport_fusion_gcp_oauth

import v2.lens.extdeps_shape_transport_policy {
  ExtdepsTransportArgvFact,
  ExtdepsTransportFusionFact,
  extdeps_shape_transport_policy_violation_count
}
import v2.lens.extdeps_shape_transport_policy.module_refs { extdeps_gcp_module }
import v2.std.collection { List }
import v2.std.logic { Bool }

data transport_fusion_gcp_oauth_argv_facts: List<ExtdepsTransportArgvFact> = []

data transport_fusion_gcp_oauth_fusion_facts: List<ExtdepsTransportFusionFact> = [
  ExtdepsTransportFusionFact {
    module: extdeps_gcp_module,
    endpoint_key: "oauth2:refresh",
    service_a: "oauth2.Google",
    service_b: "shell.OAuth2"
  }
]

test fn transport_fusion_gcp_oauth_is_red_holds() -> Bool {
  extdeps_shape_transport_policy_violation_count(
    argv_facts: transport_fusion_gcp_oauth_argv_facts,
    fusion_facts: transport_fusion_gcp_oauth_fusion_facts
  ) == 1
}
