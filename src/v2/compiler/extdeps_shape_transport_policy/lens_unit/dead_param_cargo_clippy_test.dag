// Scope: lens-unit RED witness — cargo Clippy declares deny_args/all_targets but argv hardcodes.
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v2.test.extdeps_shape_transport_policy.lens_unit.dead_param_cargo_clippy

import v2.lens.extdeps_shape_transport_policy {
  ExtdepsOperationInputFact,
  ExtdepsTransportArgvFact,
  extdeps_shape_transport_policy_dead_param_count_for_operation
}
import v2.std.collection { List }
import v2.std.logic { Bool }

data dead_param_cargo_clippy_path: String = "dsl/extdeps/rust/cargo_build.dag"
data dead_param_cargo_clippy_service: String = "cargo.Build"
data dead_param_cargo_clippy_operation: String = "Clippy"

data dead_param_cargo_clippy_input_facts: List<ExtdepsOperationInputFact> = [
  ExtdepsOperationInputFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    param_name: "all_targets"
  },
  ExtdepsOperationInputFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    param_name: "deny_args"
  },
  ExtdepsOperationInputFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    param_name: "env"
  }
]

data dead_param_cargo_clippy_argv_facts: List<ExtdepsTransportArgvFact> = [
  ExtdepsTransportArgvFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    transport_kind: Shell,
    argv_index: 0,
    argv_token: "cargo"
  },
  ExtdepsTransportArgvFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    transport_kind: Shell,
    argv_index: 1,
    argv_token: "clippy"
  },
  ExtdepsTransportArgvFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    transport_kind: Shell,
    argv_index: 2,
    argv_token: "--all-targets"
  },
  ExtdepsTransportArgvFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    transport_kind: Shell,
    argv_index: 3,
    argv_token: "--"
  },
  ExtdepsTransportArgvFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    transport_kind: Shell,
    argv_index: 4,
    argv_token: "-D"
  },
  ExtdepsTransportArgvFact {
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation,
    transport_kind: Shell,
    argv_index: 5,
    argv_token: "warnings"
  }
]

test fn dead_param_cargo_clippy_is_red_holds() -> Bool {
  extdeps_shape_transport_policy_dead_param_count_for_operation(
    argv_facts: dead_param_cargo_clippy_argv_facts,
    input_facts: dead_param_cargo_clippy_input_facts,
    path: dead_param_cargo_clippy_path,
    service: dead_param_cargo_clippy_service,
    operation: dead_param_cargo_clippy_operation
  ) == 2
}
