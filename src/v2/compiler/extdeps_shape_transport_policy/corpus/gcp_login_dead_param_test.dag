// Scope: corpus RED witness — Node-tree projection over live gcp.dag Login op.
// Asserts gcloud.Auth.Login has dead param update_adc on main.
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v2.test.extdeps_shape_transport_policy.corpus.gcp_login_dead_param

import v2.lens.extdeps_shape_transport_policy {
  extdeps_live_file_dead_param_count_for_operation
}
import v2.std.logic { Bool }

data gcp_login_path: String = "dsl/extdeps/cloud/gcp/gcp.dag"
data gcp_login_service: String = "gcloud.Auth"
data gcp_login_operation: String = "Login"

test fn corpus_gcp_login_dead_param_is_red_holds() -> Bool {
  extdeps_live_file_dead_param_count_for_operation(
    path: gcp_login_path,
    service: gcp_login_service,
    operation: gcp_login_operation
  ) == 1
}
