data gcp_login_path: String = "dsl/extdeps/cloud/gcp/gcp.dag"
data gcp_login_service: String = "gcloud.Auth"
data gcp_login_operation: String = "Login"

test fn corpus_gcp_login_dead_param_defused_holds() -> Bool {
  extdeps_live_file_dead_param_count_for_operation(
    path: gcp_login_path,
    service: gcp_login_service,
    operation: gcp_login_operation
