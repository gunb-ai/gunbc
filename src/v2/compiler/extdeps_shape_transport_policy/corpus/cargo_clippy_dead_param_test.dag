// Scope: corpus RED witness — Node-tree projection over live cargo_build.dag.
// Asserts cargo.Build.Clippy has dead params (deny_args, all_targets) on main.
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v2.test.extdeps_shape_transport_policy.corpus.cargo_clippy_dead_param

import v2.lens.extdeps_shape_transport_policy {
  extdeps_live_file_dead_param_count_for_operation
}
import v2.std.logic { Bool }

data cargo_clippy_path: String = "dsl/extdeps/rust/cargo_build.dag"
data cargo_clippy_service: String = "cargo.Build"
data cargo_clippy_operation: String = "Clippy"

test fn corpus_cargo_clippy_dead_param_is_red_holds() -> Bool {
  extdeps_live_file_dead_param_count_for_operation(
    path: cargo_clippy_path,
    service: cargo_clippy_service,
    operation: cargo_clippy_operation
  ) >= 2
}
