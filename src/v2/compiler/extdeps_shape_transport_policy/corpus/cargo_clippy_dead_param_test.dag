data cargo_clippy_path: String = "dsl/extdeps/rust/cargo_build.dag"
data cargo_clippy_service: String = "cargo.Build"
data cargo_clippy_operation: String = "Clippy"

test fn corpus_cargo_clippy_dead_param_defused_holds() -> Bool {
  extdeps_live_file_dead_param_count_for_operation(
    path: cargo_clippy_path,
    service: cargo_clippy_service,
    operation: cargo_clippy_operation
