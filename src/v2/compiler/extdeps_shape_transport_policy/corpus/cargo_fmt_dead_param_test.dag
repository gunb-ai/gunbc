// Scope: corpus regression GUARD — Node-tree projection over live cargo_build.dag Fmt op.
// Asserts no dead params remain after extra_args de-fusion.
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v2.test.extdeps_shape_transport_policy.corpus.cargo_fmt_dead_param

import v2.lens.extdeps_shape_transport_policy {
  extdeps_live_file_dead_param_count_for_operation
}
import v2.std.logic { Bool }

data cargo_fmt_path: String = "dsl/extdeps/rust/cargo_build.dag"
data cargo_fmt_service: String = "cargo.Build"
data cargo_fmt_operation: String = "Fmt"

test fn corpus_cargo_fmt_dead_param_defused_holds() -> Bool {
  extdeps_live_file_dead_param_count_for_operation(
    path: cargo_fmt_path,
    service: cargo_fmt_service,
    operation: cargo_fmt_operation
  ) == 0
}
