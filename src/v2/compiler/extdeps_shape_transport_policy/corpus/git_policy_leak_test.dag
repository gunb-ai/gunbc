module v2.test.extdeps_shape_transport_policy.corpus.git_policy_leak

import v2.lens.extdeps_shape_transport_policy {
  extdeps_live_file_contains_consumer_policy_literal
}
import v2.std.logic { Bool }

data git_core_path: String = "dsl/extdeps/git/git.dag"
data git_policy_leak_token: String = "origin/main...HEAD"

test fn corpus_git_policy_leak_defused_holds() -> Bool {
  !extdeps_live_file_contains_consumer_policy_literal(
    path: git_core_path,
    token: git_policy_leak_token
  )
}
