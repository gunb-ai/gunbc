// Scope: coverage-domain-equivalence witness — perturb roster spans each violation kind.
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v2.test.extdeps_shape_transport_policy.coverage_domain_equivalence

import v2.std.algebra { any, length }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.text { String }

data violation_kind_policy_leak: String = "policy leak in argv"
data violation_kind_transport_fusion: String = "transport fusion fork"
data violation_kind_dead_param: String = "dead param in argv"
data violation_kind_embedded_policy: String = "embedded policy literal in data"

data violation_kinds: List<String> = [
  violation_kind_policy_leak,
  violation_kind_transport_fusion,
  violation_kind_dead_param,
  violation_kind_embedded_policy
]

type ExtdepsShapeTransportPolicyReceiptRow {
  label: String
  violation_kind: String
  entry: String
  function: String
}

data receipt_policy_leak_lens_unit: ExtdepsShapeTransportPolicyReceiptRow = ExtdepsShapeTransportPolicyReceiptRow {
  label: "lens-unit cargo_build policy leak",
  violation_kind: violation_kind_policy_leak,
  entry: "src/v2/compiler/extdeps_shape_transport_policy/lens_unit/policy_leak_cargo_build_test.dag",
  function: "policy_leak_cargo_build_is_red_holds"
}

data receipt_policy_leak_corpus: ExtdepsShapeTransportPolicyReceiptRow = ExtdepsShapeTransportPolicyReceiptRow {
  label: "corpus cargo_build de-fused (regression guard)",
  violation_kind: violation_kind_policy_leak,
  entry: "src/v2/compiler/extdeps_shape_transport_policy/corpus/cargo_build_policy_leak_test.dag",
  function: "corpus_cargo_build_defused_holds"
}

