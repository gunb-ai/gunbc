data extdeps_shape_transport_policy_receipt_rows: List<ExtdepsShapeTransportPolicyReceiptRow> = [
  receipt_policy_leak_lens_unit,
  receipt_policy_leak_corpus,
  receipt_policy_leak_cargo_fmt_lens_unit,
  receipt_policy_leak_cargo_doc_lens_unit,
  receipt_policy_leak_cargo_fmt_corpus,
  receipt_policy_leak_cargo_doc_corpus,
  receipt_git_policy_leak_corpus,
  receipt_clean_git_diff,
  receipt_clean_gist_create,
  receipt_gist_create_corpus,
  receipt_transport_fusion_lens_unit,
  receipt_transport_fusion_corpus,
  receipt_dead_param_cargo_build_lens_unit,
  receipt_dead_param_gcp_login_lens_unit,
  receipt_dead_param_cargo_clippy_lens_unit,
  receipt_dead_param_cargo_clippy_corpus,
  receipt_dead_param_cargo_fmt_corpus,
  receipt_dead_param_cargo_doc_corpus,
  receipt_dead_param_gcp_login_corpus,
  receipt_embedded_policy_lens_unit,
  receipt_embedded_policy_corpus
]

fn rows_cover_kind(kind: String) -> Bool {
  any(
    xs: extdeps_shape_transport_policy_receipt_rows,
    predicate: fn(row) { row.violation_kind == kind }
  )
}

fn coverage_domain_equivalence_argument_holds() -> Bool {
  rows_cover_kind(kind: violation_kind_policy_leak)
    && rows_cover_kind(kind: violation_kind_transport_fusion)
    && rows_cover_kind(kind: violation_kind_dead_param)
    && rows_cover_kind(kind: violation_kind_embedded_policy)
    && length(xs: violation_kinds) == 4
    && length(xs: extdeps_shape_transport_policy_receipt_rows) == 21
}
