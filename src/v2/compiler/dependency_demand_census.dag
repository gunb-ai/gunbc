// THE DEPENDENCY-DEMAND CENSUS (D13 step b2): for every fn that authors a `uses` clause, the
// authored rows read from THAT fn's parse, paired with the demand v2.compiler.dependency_demand
// derives for the same fn over the whole closure, and one verdict. Its consumer is the D13
// row-deletion change, which deletes a row only where this census, executed at that change's own
// head, reads Equal (lane ruling: an earlier run's receipt is not evidence for a later tree).
//
// THE STRIP IS CENSUS-ONLY AND IT IS NOT A CARRIER. Production lowering refuses every fn with a
// `uses` clause (v2.compiler.body_lowering_fold body_lower_fn_uses_refusal_optional). The census
// route elides the clause shell with grammar_empty_node so normalize does not refuse at the
// unmodeled clause. It does not rewrite uses aliases onto the resource declaration: that would be
// a second binder beside resolve, and it is not admitted (DESIGN section 5). Duplicate aliases, or
// an alias that cannot be read, leave the fn unobserved. A body that names an elided alias is
// unobserved until resolve models the clause. The stripped tree is consumed inside the census route
// only (v2.compiler.source_root_eval native_demand_census_report). The authored rows are never lowered onto
// the fn: they are read, judged and reported (operator D13: no carrier for the authored row).
//
// THE VERDICT IS SCOPED TO THE AUDITED VOCABULARY (lane ruling). Derived demand is grounded only
// for resources some operation was audited to declare, which today is Network. A row naming any
// other resource is OutOfVocabulary, never a Mismatch, and its future owner is the per-resource
// operation audit for that resource (Filesystem next).
//
// THE FACT READ IS A DECLARED OVER-APPROXIMATION, computed as the answer (DESIGN section 5, not an
// absorbing fallback). A declaration's callees are EVERY declaration reference in its resolved
// subtree, not only call heads: a fn passed as a value is counted where it is mentioned. So the
// derived demand covers every callee a function value can reach when that value originates inside
// the closure, and derived may exceed actual; it is never below it. A row is deleted only where the
// derived demand covers it, so the over-approximation can turn a deletable row into a Mismatch, and
// cannot turn a needed row into a deletion.

// THE AUDITED VOCABULARY IS DERIVED, NOT SPELLED (review 74228 of gunbc#12992): it is the set of resources
// that some operation of the closure DECLARES in its `requires` edge, read off the resolved tree by the
// fact walk (DemandFactWalk audited). A resource no operation was audited to require -- Filesystem and
// Clock today -- is out of vocabulary because no derivation of it is grounded, never because a string
// here omitted it, and a renamed resource moves with its declaration.
// ═══ THE STRIP ═══════════════════════════════════════════════════════════════════════════════════
type DemandCensusUnobserved
  = UnobservedFileRefused
  | UnobservedModuleResolveRefused { first_reason: Symbol, first_unbound: Optional<DemandFactsUnboundLocus> }
  | UnobservedImporteeRefused { importee_file: Symbol, importee_cause: Symbol }
  | UnobservedFunctionUnnamed
  | UnobservedFunctionNotDeclared
  | UnobservedAuthoredTypeUnresolved
  | UnobservedAliasConflict
  | UnobservedAliasUnestablished

type DemandCensusVerdict
  = CensusEqual
  | CensusMismatch { authored: List<QualifiedName>, derived: List<QualifiedName> }
  | CensusUndecided { cause: UndecidedCause }
  | CensusUnobserved { reason: DemandCensusUnobserved }

// THE STANDING IS PER AUTHORED ROW, and it is the only thing that licenses a deletion (review of
// gunbc#12992). A function's verdict is decided over the audited vocabulary only, so a function whose
// Network row restates its demand reads Equal even when it also authors Filesystem; a function-level
// Equal must never license deleting that Filesystem row. Each authored row therefore carries its own
// standing: RowDeletable only for an in-vocabulary resource of an Equal function, RowOutOfVocabulary for
// any resource no operation was audited to require -- whatever the function's verdict -- and the
// remaining arms name why an in-vocabulary row is not deletable.
type AuthoredRowStanding
  = RowDeletable { resource: QualifiedName }
  | RowMismatch { resource: QualifiedName }
  | RowOutOfVocabulary { resource: QualifiedName }
  | RowUndecided { resource: QualifiedName, cause: UndecidedCause }
  | RowUnobserved { resource: QualifiedName }
  | RowTypeUnresolved

type DemandCensusRow {
  function: QualifiedName
  authored: List<AuthoredRowReading>
  standings: List<AuthoredRowStanding>
  verdict: DemandCensusVerdict
  demand: Optional<DependencyDemand>
}

fn demand_census_row_standing(vocabulary: ResourceSet, verdict: DemandCensusVerdict, reading: AuthoredRowReading) -> AuthoredRowStanding {
  match reading {
    AuthoredTypeUnresolved => RowTypeUnresolved
    AuthoredResolved { declared: p } =>
      if resource_set_has(set: vocabulary, path: p) {
        match verdict {
          CensusEqual => RowDeletable { resource: p }
          CensusMismatch { authored: _, derived: _ } => RowMismatch { resource: p }
          CensusUndecided { cause: c } => RowUndecided { resource: p, cause: c }
          CensusUnobserved { reason: _ } => RowUnobserved { resource: p }
        }
      } else {
        RowOutOfVocabulary { resource: p }
      }
  }
}

fn demand_census_row_standings(vocabulary: ResourceSet, verdict: DemandCensusVerdict, readings: List<AuthoredRowReading>) -> List<AuthoredRowStanding> {
  fold_list(xs: readings, empty: Empty, cons: fn(acc, r) { list_snoc_item(xs: acc, item: demand_census_row_standing(vocabulary: vocabulary, verdict: verdict, reading: r)) })
}

// THE EXACT ROWS (b3) MAY DELETE, by identity: the function and the resource of every RowDeletable.
type DeletableUsesRow {
  function: QualifiedName
  resource: QualifiedName
}

fn demand_census_deletable(r: DemandCensusReport) -> List<DeletableUsesRow> {
  fold_list(xs: r.rows, empty: Empty, cons: fn(acc, row) {
    fold_list(xs: row.standings, empty: acc, cons: fn(a, st) {
      match st {
        RowDeletable { resource: p } => list_snoc_item(xs: a, item: DeletableUsesRow { function: row.function, resource: p })
        RowMismatch { resource: _ } => a
        RowOutOfVocabulary { resource: _ } => a
        RowUndecided { resource: _, cause: _ } => a
        RowUnobserved { resource: _ } => a
        RowTypeUnresolved => a
      }
    })
  })
}

fn demand_census_standing_text(st: AuthoredRowStanding) -> String {
  match st {
    RowDeletable { resource: p } => concat("deletable:", qualified_name_to_dotted_string(qn: p))
    RowMismatch { resource: p } => concat("mismatch:", qualified_name_to_dotted_string(qn: p))
    RowOutOfVocabulary { resource: p } => concat("out_of_vocabulary:", qualified_name_to_dotted_string(qn: p))
    RowUndecided { resource: p, cause: _ } => concat("undecided:", qualified_name_to_dotted_string(qn: p))
    RowUnobserved { resource: p } => concat("unobserved:", qualified_name_to_dotted_string(qn: p))
    RowTypeUnresolved => "type_unresolved"
  }
}

fn demand_census_in_vocabulary(vocabulary: ResourceSet, paths: List<QualifiedName>) -> List<QualifiedName> {
  fold_list(xs: paths, empty: Empty, cons: fn(acc, p) {
    if resource_set_has(set: vocabulary, path: p) { list_snoc_item(xs: acc, item: p) } else { acc }
  })
}

// Set equality through the keyed sets of v2.compiler.dependency_demand, never a member-by-member scan.
fn demand_census_same_set(left: List<QualifiedName>, right: List<QualifiedName>) -> Bool {
  let l = resource_set_of(paths: left)
  let r = resource_set_of(paths: right)
  (l.size == r.size) && fold_list(xs: l.members, empty: true, cons: fn(all, p) { all && resource_set_has(set: r, path: p) })
}

fn demand_census_authored_paths(readings: List<AuthoredRowReading>) -> List<QualifiedName> {
  fold_list(xs: readings, empty: Empty, cons: fn(acc, r) {
    match r {
      AuthoredResolved { declared: p } => list_snoc_item(xs: acc, item: p)
      AuthoredTypeUnresolved => acc
    }
  })
}

fn demand_census_has_unresolved(readings: List<AuthoredRowReading>) -> Bool {
  fold_list(xs: readings, empty: false, cons: fn(any, r) {
    match r {
      AuthoredResolved { declared: _ } => any
      AuthoredTypeUnresolved => true
    }
  })
}

fn demand_census_verdict(vocabulary: ResourceSet, readings: List<AuthoredRowReading>, demand: DependencyDemand) -> DemandCensusVerdict {
  let has_unresolved = demand_census_has_unresolved(readings: readings)
  if has_unresolved {
    CensusUnobserved { reason: UnobservedAuthoredTypeUnresolved }
  } else {
    match demand {
      DemandUndecided { cause: c } => CensusUndecided { cause: c }
      DemandDerived { resources: derived } =>
        let a = demand_census_in_vocabulary(vocabulary: vocabulary, paths: demand_census_authored_paths(readings: readings))
        let d = demand_census_in_vocabulary(vocabulary: vocabulary, paths: derived.members)
        if demand_census_same_set(left: a, right: d) {
          CensusEqual
        } else {
          CensusMismatch { authored: a, derived: d }
        }
    }
  }
}

fn demand_census_row_unobserved(function: QualifiedName, reason: DemandCensusUnobserved) -> DemandCensusRow {
  DemandCensusRow { function: function, authored: Empty, standings: Empty, verdict: CensusUnobserved { reason: reason }, demand: optional_absent() }
}

fn demand_census_function_path(authored: AuthoredUsesFunction) -> QualifiedName {
  match authored.name {
    Present { value: n } => qualified_name_snoc(qn: authored.owner, segment: n)
    Absent => authored.owner
  }
}

// ═══ THE REPORT ═══════════════════════════════════════════════════════════════════════════════

// `uses_functions` is counted from the strip; `rows` is what the route emitted. They are produced by
// different folds -- the strip over parse trees, the rows over the module roster -- so their equality
// is the count-conservation check rather than a restatement of one count.
// `unreadable` is the reads the front end refused BEFORE the strip ran (tokenize or parse): their
// `uses` rows were never read, so they are missing from BOTH sides of the conservation check, and a
// census with any of them is an INCOMPLETE POPULATION -- no observation, never a holding census
// (review of gunbc#12992).
type DemandCensusReport {
  vocabulary: ResourceSet
  unreadable: List<DemandFactsUnreadable>
  uses_functions: Int
  rows: List<DemandCensusRow>
  file_refusals: Int
  resolve_refused_modules: Int
}

fn demand_census_conserved(r: DemandCensusReport) -> Bool {
  r.uses_functions == length(xs: r.rows)
}

// THE CENSUS'S OWN EXIT: 2 when the population is incomplete (a read refused before authorship), 1 when
// the rows do not account for every uses fn read, 0 when it holds. The incomplete arm is first, so a
// census missing a file can never report held.
fn demand_census_exit(r: DemandCensusReport) -> Int {
  if !is_empty(xs: r.unreadable) {
    2
  } else if demand_census_conserved(r: r) {
    0
  } else {
    1
  }
}

fn demand_census_verdict_word(v: DemandCensusVerdict) -> String {
  match v {
    CensusEqual => "equal"
    CensusMismatch { authored: _, derived: _ } => "mismatch"
    CensusUndecided { cause: _ } => "undecided"
    CensusUnobserved { reason: _ } => "unobserved"
  }
}

fn demand_census_cause_word(c: UndecidedCause) -> String {
  match c {
    OpaqueOperationCalled { operation: _ } => "opaque_operation"
    UndeclaredOperationCalled { operation: _ } => "undeclared_operation"
    FunctionValueCalled { function: _ } => "function_value"
    CalleeOutsideClosure { callee: _ } => "callee_outside_closure"
    DemandDidNotSettle { function: _ } => "did_not_settle"
  }
}

fn demand_census_cause_subject(c: UndecidedCause) -> QualifiedName {
  match c {
    OpaqueOperationCalled { operation: p } => p
    UndeclaredOperationCalled { operation: p } => p
    FunctionValueCalled { function: p } => p
    CalleeOutsideClosure { callee: p } => p
    DemandDidNotSettle { function: p } => p
  }
}

fn demand_census_unobserved_word(u: DemandCensusUnobserved) -> String {
  match u {
    UnobservedFileRefused => "file_refused"
    UnobservedModuleResolveRefused { first_reason: _, first_unbound: _ } => "module_resolve_refused"
    UnobservedImporteeRefused { importee_file: _, importee_cause: _ } => "importee_refused"
    UnobservedFunctionUnnamed => "function_unnamed"
    UnobservedFunctionNotDeclared => "function_not_declared"
    UnobservedAuthoredTypeUnresolved => "authored_type_unresolved"
    UnobservedAliasConflict => "alias_conflict"
    UnobservedAliasUnestablished => "alias_unestablished"
  }
}

// THE COUNTS ARE A TALLY OVER THE VARIANTS, decided by matching each row's verdict and cause, never by
// comparing a printed word (review 74228 of gunbc#12992): a word is for printing only, and a count keyed
// on one would read 0, not refuse, after a typo or a rename.
type DemandCensusTally {
  equal: Int
  mismatch: Int
  undecided: Int
  unobserved: Int
  opaque_operation: Int
  undeclared_operation: Int
  function_value: Int
  callee_outside_closure: Int
  did_not_settle: Int
}

fn demand_census_tally_empty() -> DemandCensusTally {
  DemandCensusTally { equal: 0, mismatch: 0, undecided: 0, unobserved: 0, opaque_operation: 0, undeclared_operation: 0, function_value: 0, callee_outside_closure: 0, did_not_settle: 0 }
}

fn demand_census_tally_cause(t: DemandCensusTally, c: UndecidedCause) -> DemandCensusTally {
  match c {
    OpaqueOperationCalled { operation: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation + 1, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
    UndeclaredOperationCalled { operation: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation + 1, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
    FunctionValueCalled { function: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value + 1, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
    CalleeOutsideClosure { callee: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure + 1, did_not_settle: t.did_not_settle }
    DemandDidNotSettle { function: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle + 1 }
  }
}

fn demand_census_tally(rows: List<DemandCensusRow>) -> DemandCensusTally {
  fold_list(xs: rows, empty: demand_census_tally_empty(), cons: fn(t, r) {
    match r.verdict {
      CensusEqual =>
        DemandCensusTally { equal: t.equal + 1, mismatch: t.mismatch, undecided: t.undecided, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
      CensusMismatch { authored: _, derived: _ } =>
        DemandCensusTally { equal: t.equal, mismatch: t.mismatch + 1, undecided: t.undecided, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
      CensusUndecided { cause: c } => demand_census_tally_cause(t: t, c: c)
      CensusUnobserved { reason: _ } =>
        DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided, unobserved: t.unobserved + 1, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
    }
  })
}

fn demand_census_cause_line(word: String, n: Int) -> String {
  demand_facts_text(parts: ["[demand-census-undecided] cause=", word, " functions=", to_string(n)])
}

fn demand_census_deletable_rows(r: DemandCensusReport) -> Int {
  length(xs: demand_census_deletable(r: r))
}

// OUT OF VOCABULARY, COUNTED PER RESOURCE: for each resource some row authors that no operation was
// audited to require, how many rows author it and how many of those fns' decided derived demand agrees.
// None of these rows is deletable by this census; the agreeing count sizes that resource's audit.
fn demand_census_out_of_vocabulary_resources(r: DemandCensusReport) -> ResourceSet {
  fold_list(xs: r.rows, empty: resource_set_empty(), cons: fn(acc, row) {
    fold_list(xs: demand_census_authored_paths(readings: row.authored), empty: acc, cons: fn(a, p) {
      if resource_set_has(set: r.vocabulary, path: p) { a } else { resource_set_add(set: a, path: p) }
    })
  })
}

fn demand_census_authoring(r: DemandCensusReport, resource: QualifiedName) -> Int {
  fold_list(xs: r.rows, empty: 0, cons: fn(n, row) {
    if resource_set_has(set: resource_set_of(paths: demand_census_authored_paths(readings: row.authored)), path: resource) { n + 1 } else { n }
  })
}

fn demand_census_derives(demand: Optional<DependencyDemand>, resource: QualifiedName) -> Bool {
  match demand {
    Absent => false
    Present { value: d } =>
      match d {
        DemandDerived { resources: rs } => resource_set_has(set: rs, path: resource)
        DemandUndecided { cause: _ } => false
      }
  }
}

fn demand_census_out_of_vocabulary_agreeing(r: DemandCensusReport, resource: QualifiedName) -> Int {
  fold_list(xs: r.rows, empty: 0, cons: fn(n, row) {
    if resource_set_has(set: resource_set_of(paths: demand_census_authored_paths(readings: row.authored)), path: resource) && demand_census_derives(demand: row.demand, resource: resource) { n + 1 } else { n }
  })
}

fn demand_census_out_of_vocabulary_line(r: DemandCensusReport, resource: QualifiedName) -> String {
  demand_facts_text(parts: [
    "[demand-census-out-of-vocabulary] resource=", qualified_name_to_dotted_string(qn: resource),
    " rows=", to_string(demand_census_authoring(r: r, resource: resource)),
    " agreeing_functions=", to_string(demand_census_out_of_vocabulary_agreeing(r: r, resource: resource))
  ])
}

fn demand_census_paths_text(paths: List<QualifiedName>) -> String {
  fold_list(xs: paths, empty: "", cons: fn(acc, p) {
    if acc == "" { qualified_name_to_dotted_string(qn: p) } else { concat(acc, concat(",", qualified_name_to_dotted_string(qn: p))) }
  })
}

fn demand_census_row_line(r: DemandCensusRow) -> String {
  let head = demand_facts_text(parts: [
    "[demand-census-row] function=", qualified_name_to_dotted_string(qn: r.function),
    " verdict=", demand_census_verdict_word(v: r.verdict),
    " authored=", demand_census_paths_text(paths: demand_census_authored_paths(readings: r.authored)),
    " rows=", fold_list(xs: r.standings, empty: "", cons: fn(acc, st) { if acc == "" { demand_census_standing_text(st: st) } else { concat(acc, concat(",", demand_census_standing_text(st: st))) } })
  ])
  match r.verdict {
    CensusEqual => head
    CensusMismatch { authored: _, derived: d } => demand_facts_text(parts: [head, " derived_in_vocabulary=", demand_census_paths_text(paths: d)])
    CensusUndecided { cause: c } =>
      demand_facts_text(parts: [head, " cause=", demand_census_cause_word(c: c), " at=", qualified_name_to_dotted_string(qn: demand_census_cause_subject(c: c))])
    CensusUnobserved { reason: u } =>
      let reason_part = demand_facts_text(parts: [head, " reason=", demand_census_unobserved_word(u: u)])
      match u {
        UnobservedModuleResolveRefused { first_reason: resolve_reason_sym, first_unbound: unbound_site } =>
          demand_facts_text(parts: [
            reason_part,
            " resolve_reason=", symbol_lexeme(sym: resolve_reason_sym),
            " ", demand_facts_unbound_site_text(u: unbound_site)
          ])
        UnobservedImporteeRefused { importee_file: file, importee_cause: cause } =>
          demand_facts_text(parts: [reason_part, " importee=", symbol_lexeme(sym: file), " importee_cause=", symbol_lexeme(sym: cause)])
        UnobservedFileRefused => reason_part
        UnobservedFunctionUnnamed => reason_part
        UnobservedFunctionNotDeclared => reason_part
        UnobservedAuthoredTypeUnresolved => reason_part
        UnobservedAliasConflict => reason_part
        UnobservedAliasUnestablished => reason_part
      }
  }
}

fn demand_census_conserved_word(r: DemandCensusReport) -> String {
  if demand_census_conserved(r: r) { "true" } else { "false" }
}

fn demand_census_stage_word(s: DemandFactsUnreadableStage) -> String {
  match s {
    UnreadableAtTokenize => "tokenize"
    UnreadableAtParse => "parse"
  }
}

fn demand_census_unreadable_line(u: DemandFactsUnreadable) -> String {
  demand_facts_text(parts: [
    "[demand-census-unreadable] file=", u.file_path,
    " stage=", demand_census_stage_word(s: u.stage),
    " reason=", symbol_lexeme(sym: u.reason)
  ])
}

type DemandCensusResolveRefusedBucket {
  reason: Symbol
  functions: Int
  examples: List<QualifiedName>
}

fn demand_census_bucket_has_example(examples: List<QualifiedName>, module: QualifiedName) -> Bool {
  fold_list(xs: examples, empty: false, cons: fn(any, e) { any || (e == module) })
}

fn demand_census_add_example(examples: List<QualifiedName>, module: QualifiedName) -> List<QualifiedName> {
  if length(xs: examples) >= 2 {
    examples
  } else if demand_census_bucket_has_example(examples: examples, module: module) {
    examples
  } else {
    list_snoc_item(xs: examples, item: module)
  }
}

fn demand_census_add_to_buckets(buckets: List<DemandCensusResolveRefusedBucket>, reason: Symbol, module: QualifiedName) -> List<DemandCensusResolveRefusedBucket> {
  let found = fold_list(xs: buckets, empty: false, cons: fn(any, b) { any || (b.reason == reason) })
  if found {
    fold_list(xs: buckets, empty: Empty, cons: fn(acc, b) {
      if b.reason == reason {
        list_snoc_item(xs: acc, item: DemandCensusResolveRefusedBucket {
          reason: b.reason,
          functions: b.functions + 1,
          examples: demand_census_add_example(examples: b.examples, module: module)
        })
      } else {
        list_snoc_item(xs: acc, item: b)
      }
    })
  } else {
    list_snoc_item(xs: buckets, item: DemandCensusResolveRefusedBucket { reason: reason, functions: 1, examples: [module] })
  }
}

fn demand_census_resolve_refused_buckets(rows: List<DemandCensusRow>) -> List<DemandCensusResolveRefusedBucket> {
  fold_list(xs: rows, empty: Empty, cons: fn(acc, row) {
    match row.verdict {
      CensusUnobserved { reason: UnobservedModuleResolveRefused { first_reason: r, first_unbound: _ } } =>
        demand_census_add_to_buckets(buckets: acc, reason: r, module: qualified_name_init(qn: row.function))
      CensusUnobserved { reason: _ } => acc
      CensusEqual => acc
      CensusMismatch { authored: _, derived: _ } => acc
      CensusUndecided { cause: _ } => acc
    }
  })
}

fn demand_census_resolve_refused_bucket_line(b: DemandCensusResolveRefusedBucket) -> String {
  demand_facts_text(parts: [
    "[demand-census-resolve-refused] reason=", symbol_lexeme(sym: b.reason),
    " functions=", to_string(b.functions),
    " examples=", demand_census_paths_text(paths: b.examples)
  ])
}

type DemandCensusUnboundBucket {
  site: DemandFactsUnboundLocus
  functions: Int
  examples: List<QualifiedName>
}

fn demand_census_unbound_locus_eq(a: DemandFactsUnboundLocus, b: DemandFactsUnboundLocus) -> Bool {
  match a {
    UnboundNamed { name: na } =>
      match b {
        UnboundNamed { name: nb } => na == nb
        UnboundShaped { kind: _, reference: _ } => false
      }
    UnboundShaped { kind: ka, reference: pa } =>
      match b {
        UnboundNamed { name: _ } => false
        UnboundShaped { kind: kb, reference: pb } =>
          (ka == kb)
            && match pa {
              Absent => match pb { Absent => true Present { value: _ } => false }
              Present { value: pa_value } =>
                match pb {
                  Absent => false
                  Present { value: pb_value } => pa_value == pb_value
                }
            }
      }
  }
}

fn demand_census_add_to_unbound_buckets(buckets: List<DemandCensusUnboundBucket>, site: DemandFactsUnboundLocus, module: QualifiedName) -> List<DemandCensusUnboundBucket> {
  let found = fold_list(xs: buckets, empty: false, cons: fn(any, b) { any || demand_census_unbound_locus_eq(a: b.site, b: site) })
  if found {
    fold_list(xs: buckets, empty: Empty, cons: fn(acc, b) {
      if demand_census_unbound_locus_eq(a: b.site, b: site) {
        list_snoc_item(xs: acc, item: DemandCensusUnboundBucket {
          site: b.site,
          functions: b.functions + 1,
          examples: demand_census_add_example(examples: b.examples, module: module)
        })
      } else {
        list_snoc_item(xs: acc, item: b)
      }
    })
  } else {
    list_snoc_item(xs: buckets, item: DemandCensusUnboundBucket { site: site, functions: 1, examples: [module] })
  }
}

fn demand_census_unbound_buckets(rows: List<DemandCensusRow>) -> List<DemandCensusUnboundBucket> {
  fold_list(xs: rows, empty: Empty, cons: fn(acc, row) {
    match row.verdict {
      CensusUnobserved { reason: UnobservedModuleResolveRefused { first_reason: _, first_unbound: Present { value: loc } } } =>
        demand_census_add_to_unbound_buckets(buckets: acc, site: loc, module: qualified_name_init(qn: row.function))
      CensusUnobserved { reason: _ } => acc
      CensusEqual => acc
      CensusMismatch { authored: _, derived: _ } => acc
      CensusUndecided { cause: _ } => acc
    }
  })
}

fn demand_census_unbound_bucket_line(b: DemandCensusUnboundBucket) -> String {
  demand_facts_text(parts: [
    "[demand-census-unbound] site=", demand_facts_unbound_site_word(loc: b.site),
    " functions=", to_string(b.functions),
    " examples=", demand_census_paths_text(paths: b.examples)
  ])
}

fn demand_census_lines(r: DemandCensusReport) -> List<String> {
  let tally = demand_census_tally(rows: r.rows)
  let head = demand_facts_text(parts: [
    "[demand-census] vocabulary=", demand_census_paths_text(paths: r.vocabulary.members),
    " uses_functions=", to_string(r.uses_functions),
    " rows=", to_string(length(xs: r.rows)),
    " conserved=", demand_census_conserved_word(r: r),
    " equal=", to_string(tally.equal),
    " mismatch=", to_string(tally.mismatch),
    " undecided=", to_string(tally.undecided),
    " unobserved=", to_string(tally.unobserved),
    " deletable_rows=", to_string(demand_census_deletable_rows(r: r)),
    " file_refusals=", to_string(r.file_refusals),
    " unreadable_files=", to_string(length(xs: r.unreadable)),
    " resolve_refused_modules=", to_string(r.resolve_refused_modules)
  ])
  let causes = [
    head,
    demand_census_cause_line(word: "opaque_operation", n: tally.opaque_operation),
    demand_census_cause_line(word: "undeclared_operation", n: tally.undeclared_operation),
    demand_census_cause_line(word: "function_value", n: tally.function_value),
    demand_census_cause_line(word: "callee_outside_closure", n: tally.callee_outside_closure),
    demand_census_cause_line(word: "did_not_settle", n: tally.did_not_settle)
  ]
  let with_unreadable = fold_list(xs: r.unreadable, empty: causes, cons: fn(acc, u) { list_snoc_item(xs: acc, item: demand_census_unreadable_line(u: u)) })
  let with_reasons = fold_list(xs: demand_census_resolve_refused_buckets(rows: r.rows), empty: with_unreadable, cons: fn(acc, b) { list_snoc_item(xs: acc, item: demand_census_resolve_refused_bucket_line(b: b)) })
  let with_unbound = fold_list(xs: demand_census_unbound_buckets(rows: r.rows), empty: with_reasons, cons: fn(acc, b) { list_snoc_item(xs: acc, item: demand_census_unbound_bucket_line(b: b)) })
  let with_vocabulary = fold_list(xs: demand_census_out_of_vocabulary_resources(r: r).members, empty: with_unbound, cons: fn(acc, p) { list_snoc_item(xs: acc, item: demand_census_out_of_vocabulary_line(r: r, resource: p)) })
  fold_list(xs: r.rows, empty: with_vocabulary, cons: fn(acc, row) { list_snoc_item(xs: acc, item: demand_census_row_line(r: row)) })
}

// ═══ JOINING THE CLOSURE ════════════════════════════════════════════════════════════════════════

// The whole-closure reduction. `functions`/`operations` are every resolved module's facts; each
// standing yields its authored functions' rows; `file_refused` are the authored functions of files the
// front end refused with the clause elided.
fn demand_census_report(
  uses_functions: Int,
  functions: List<FunctionFact>,
  operations: List<OperationFact>,
  audited: List<QualifiedName>,
  standings: List<DemandFactsModuleStanding>,
  file_refused: List<AuthoredUsesFunction>,
  file_refusals: Int,
  unreadable: List<DemandFactsUnreadable>
) -> DemandCensusReport {
  let demand_rows = dependency_demand_of(functions: demand_facts_normalize_callees(functions: functions, operations: operations), operations: operations)
  let demand = fold_list(xs: demand_rows, empty: empty_map(), cons: fn(m, r) { map_insert(m: m, key: r.function, value: r.demand) })
  let vocabulary = resource_set_of(paths: audited)
  let resolved_rows = fold_list(xs: standings, empty: Empty, cons: fn(acc, s) {
    match s {
      DemandModuleResolveRefused { authored: fs, first_reason: reason, first_unbound: unbound } =>
        fold_list(xs: fs, empty: acc, cons: fn(a, f) {
          list_snoc_item(xs: a, item: demand_census_row_unobserved(function: demand_census_function_path(authored: f), reason: demand_census_alias_or_module_unobserved(authored: f, first_reason: reason, first_unbound: unbound)))
        })
      DemandModuleImporteeRefused { authored: fs, importee_file: file, importee_cause: cause } =>
        fold_list(xs: fs, empty: acc, cons: fn(a, f) {
          list_snoc_item(xs: a, item: demand_census_row_unobserved(function: demand_census_function_path(authored: f), reason: demand_census_alias_or_importee_unobserved(authored: f, importee_file: file, importee_cause: cause)))
        })
      DemandModuleResolved { readings: rs } =>
        fold_list(xs: rs, empty: acc, cons: fn(a, r) { list_snoc_item(xs: a, item: demand_census_resolved_row(vocabulary: vocabulary, reading: r, demand: demand)) })
    }
  })
  DemandCensusReport {
    vocabulary: vocabulary,
    unreadable: unreadable,
    uses_functions: uses_functions,
    rows: fold_list(xs: file_refused, empty: resolved_rows, cons: fn(a, f) {
      list_snoc_item(xs: a, item: demand_census_row_unobserved(function: demand_census_function_path(authored: f), reason: UnobservedFileRefused))
    }),
    file_refusals: file_refusals,
    resolve_refused_modules: fold_list(xs: standings, empty: 0, cons: fn(n, s) {
      match s {
        DemandModuleResolveRefused { authored: _, first_reason: _, first_unbound: _ } => n + 1
        DemandModuleImporteeRefused { authored: _, importee_file: _, importee_cause: _ } => n + 1
        DemandModuleResolved { readings: _ } => n
      }
    })
  }
}

fn demand_census_alias_or_module_unobserved(authored: AuthoredUsesFunction, first_reason: Symbol, first_unbound: Optional<DemandFactsUnboundLocus>) -> DemandCensusUnobserved {
  match authored.alias_bind {
    UsesAliasBindConflict => UnobservedAliasConflict
    UsesAliasBindUnestablished => UnobservedAliasUnestablished
    UsesAliasBindUnique => UnobservedModuleResolveRefused { first_reason: first_reason, first_unbound: first_unbound }
  }
}

// THE ROOT, NOT THE SYMPTOM: a module whose import target the context refused at ingest finds every
// imported name unbound only because the target's declarations never entered the index, so its rows file
// the refused importee (v2.compiler.compile native_import_target_attribution decides it), not an unbound.
fn demand_census_alias_or_importee_unobserved(authored: AuthoredUsesFunction, importee_file: Symbol, importee_cause: Symbol) -> DemandCensusUnobserved {
  match authored.alias_bind {
    UsesAliasBindConflict => UnobservedAliasConflict
    UsesAliasBindUnestablished => UnobservedAliasUnestablished
    UsesAliasBindUnique => UnobservedImporteeRefused { importee_file: importee_file, importee_cause: importee_cause }
  }
}

fn demand_census_resolved_row(vocabulary: ResourceSet, reading: DemandFactsAuthoredReading, demand: Map<QualifiedName, DependencyDemand>) -> DemandCensusRow {
  let path = demand_census_function_path(authored: reading.authored)
  match reading.authored.alias_bind {
    UsesAliasBindConflict => demand_census_row_unobserved(function: path, reason: UnobservedAliasConflict)
    UsesAliasBindUnestablished => demand_census_row_unobserved(function: path, reason: UnobservedAliasUnestablished)
    UsesAliasBindUnique =>
      match reading.authored.name {
        Absent => demand_census_row_unobserved(function: path, reason: UnobservedFunctionUnnamed)
        Present { value: _ } =>
          match map_lookup(m: demand, key: path) {
            Absent => demand_census_row_unobserved(function: path, reason: UnobservedFunctionNotDeclared)
            Present { value: d } =>
              let verdict = demand_census_verdict(vocabulary: vocabulary, readings: reading.readings, demand: d)
              DemandCensusRow {
                function: path,
                authored: reading.readings,
                standings: demand_census_row_standings(vocabulary: vocabulary, verdict: verdict, readings: reading.readings),
                verdict: verdict,
                demand: optional_present(value: d)
              }
          }
      }
  }
}
