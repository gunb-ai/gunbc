// THE FACT READ FOR D13: the FunctionFact / OperationFact rows v2.compiler.dependency_demand derives demand
// from, read off one resolved module, plus the located reading of an unbound-name diagnostic that
// v2.cli.compile_cli renders. The census that paired authored `uses` rows with the derived demand (verdicts,
// rows, tallies, the strip of the authored clause) is retired (ruling bad_process_is_worse_than_no_process).
//
// THE FACT READ IS A DECLARED OVER-APPROXIMATION, computed as the answer (DESIGN section 5, not an
// absorbing fallback). A declaration's callees are EVERY declaration reference in its resolved
// subtree, not only call heads: a fn passed as a value is counted where it is mentioned. So the
// derived demand covers every callee a function value can reach when that value originates inside
// the closure, and derived may exceed actual; it is never below it.
//
// THE AUDITED VOCABULARY IS DERIVED, NOT SPELLED (review 74228 of gunbc#12992): it is the set of resources
// that some operation of the closure DECLARES in its `requires` edge, read off the resolved tree by the
// fact walk (DemandFactWalk audited). A resource no operation was audited to require is out of vocabulary
// because no derivation of it is grounded, never because a string here omitted it.

// ═══ THE FACT READ OVER ONE RESOLVED MODULE ═══════════════════════════════════════════════════════

type DemandCensusModuleFacts {
  functions: List<FunctionFact>
  operations: List<OperationFact>
  audited: List<QualifiedName>
  bodies: List<FactBodySites>
}

type DemandFactWalk {
  functions: List<FunctionFact>
  operations: List<OperationFact>
  audited: List<QualifiedName>
  current: List<QualifiedName>
  value_call: Bool
  sites: List<FactCallSite>
  bodies: List<FactBodySites>
  tick: Int
  groups: List<FactGroup>
}

// ADDITIVE; THIS CENSUS IGNORES BOTH FIELDS. A call-site is the
// callee reference occurrence (the key value_use_dependency uses) and the path it names; a body is
// one declaration's sites in walk order.
type FactCallSite {
  occurrence: Optional<OccurrenceId>
  callee: FactCallee
  enter: Int
  exit: Int
  operands: List<Optional<OccurrenceId>>
}

// WHAT A CALL SITE CALLS, decided by demand_fact_call_callee over the evaluator's own Transform/call-head
// authority (eval_transform_has_callee_reference plus the parameter head resolve mints). A static
// declaration call names its path, which may be outside the closure (unresolved is the consumer's reading of
// that path); a function-value call names no declaration, only which kind of head it has.
type FactCallee
  = FactStaticCall { callee: QualifiedName }
  | FactFunctionValueCall { head: FactValueHead }

type FactValueHead
  = FactLexicalHead
  | FactParameterHead

// A Branch or Match node: the preorder span of each child, selector first. Sites in different non-selector
// children are alternatives; a selector's sites order before every arm's.
type FactSpan {
  enter: Int
  exit: Int
  role: FactSpanRole
}

// WHAT A CHILD OF A Branch/Match IS, read through v2.std.node's slot tables (branch_positional_slot,
// match_positional_slot) and only for a site v2.compiler.activation_dependency derived; a labeled child is
// neither, and every child of a group A2 did not derive is FactUnroled. Never "the first positional".
type FactSpanRole
  = FactSelector
  | FactAlternative
  | FactUnroled

// WHY A REPEATED EXTENT RUNS MORE THAN ONCE, or that it is not known. A Loop repeats only its iterated BODY
// (v2.std.node loop_edge_contributes_to_iteration_fold; its domain, bound, carrier and metadata do not). An inline
// lambda is repeated only where its consumer instantiates it repeatedly, which this census does not read, so
// it is a typed unknown, never counted as repeated.
type FactRepetition
  = LoopIteratedBody
  | LambdaInstantiationUnknown

// A Branch/Match extent with each child's role, or the typed reason A2 did not derive the site (no role then);
// or a repeated extent. One group per such node.
type FactGroup
  = FactActivationGroup { children: List<FactSpan>, not_derived: Optional<ActivationNotDerivedReason> }
  | FactRepeatedGroup { children: List<FactSpan>, repetition: FactRepetition }

type FactBodySites {
  function: QualifiedName
  sites: List<FactCallSite>
  groups: List<FactGroup>
}

// A declaration is a named edge whose path the resolved tree's own declaration index carries
// (ResolvedTree resolved_declarations); every other named edge -- a record field, a body edge -- is
// containment inside the declaration that holds it.
fn demand_census_module_facts(resolved: ResolvedTree, module_qn: QualifiedName) -> DemandCensusModuleFacts {
  let w = demand_fact_node(
    w: DemandFactWalk { functions: Empty, operations: Empty, audited: Empty, current: Empty, value_call: false, sites: Empty, bodies: Empty, tick: 0, groups: Empty },
    position: module_qn,
    node: resolved.root,
    resolved: resolved
  )
  DemandCensusModuleFacts { functions: w.functions, operations: w.operations, audited: w.audited, bodies: w.bodies }
}

// THE CONTAINMENT RULE IS THE INDEX'S OWN (v2.compiler.symbol_index_fill symbol_index_fill_containment_node
// and _edge), so a path this walk forms is the path resolved_declarations was keyed at: a module-spine
// body is unwrapped wherever it stands, and a parse-projection or header-metadata edge is descended
// without extending the position. Extending the position by those labels formed paths no declaration
// has, and every fn read as undeclared.
fn demand_fact_children(node: Node) -> List<Edge> {
  match namespace_graft_spine_body_optional(node: node) {
    Present { value: body } => body.children
    Absent => node.children
  }
}

// A LIST INTRODUCTION IS NOT A CALL: its head is the compiler-generated reference to the free monoid's
// declaration (v2.std.list_introduction), a type, so only its elements are mentioned. The reader is
// the one eval uses, so every list introduction is excluded, not only a fn's parameter-order list.
fn demand_fact_node(w: DemandFactWalk, position: QualifiedName, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  match list_introduction_elements_optional(node: node) {
    Present { value: elements } =>
      fold(elements, init: w, f: fn(acc, e) { demand_fact_node(w: acc, position: position, node: e, resolved: resolved) })
    Absent => demand_fact_reference_or_children(w: w, position: position, node: node, resolved: resolved)
  }
}

fn demand_fact_reference_or_children(w: DemandFactWalk, position: QualifiedName, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  match declaration_reference_path_optional(node: node) {
    Present { value: target } =>
      DemandFactWalk { functions: w.functions, operations: w.operations, audited: w.audited, current: list_snoc_item(xs: w.current, item: target), value_call: w.value_call, sites: w.sites, bodies: w.bodies, tick: w.tick + 1, groups: w.groups }
    Absent =>
      demand_fact_note_site(
        before: w,
        node: node,
        after: demand_fact_walk_children(w: demand_fact_reserve_site_tick(w: demand_fact_note_call(w: w, node: node, resolved: resolved), node: node), position: position, node: node, resolved: resolved)
      )
  }
}

// One tick at a call site's entry, so its `enter` is unique among the sites of a body.
fn demand_fact_reserve_site_tick(w: DemandFactWalk, node: Node) -> DemandFactWalk {
  match demand_fact_call_callee(node: node) {
    Present { value: _ } =>
      DemandFactWalk { functions: w.functions, operations: w.operations, audited: w.audited, current: w.current, value_call: w.value_call, sites: w.sites, bodies: w.bodies, tick: w.tick + 1, groups: w.groups }
    Absent => w
  }
}

// THE CHILDREN WALK. A Branch or Match also records each child's preorder span as one group, so a consumer
// can tell alternatives from selector; every other node is walked exactly as before. Additive.
type FactSpanScan {
  walk: DemandFactWalk
  spans: List<FactSpan>
}

fn demand_fact_walk_children(w: DemandFactWalk, position: QualifiedName, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  if demand_fact_is_branching(node: node) {
    let refusal = demand_fact_activation_refusal(node: node)
    let scan = fold(node_child_slots(n: node), init: FactSpanScan { walk: w, spans: Empty }, f: fn(acc, s) {
      let next = demand_fact_edge(w: acc.walk, position: position, edge: s.edge, resolved: resolved)
      let role = match refusal {
        Present { value: _ } => FactUnroled
        Absent => demand_fact_span_role(node: node, s: s)
      }
      FactSpanScan { walk: next, spans: list_snoc_item(xs: acc.spans, item: FactSpan { enter: acc.walk.tick, exit: next.tick, role: role }) }
    })
    DemandFactWalk {
      functions: scan.walk.functions, operations: scan.walk.operations, audited: scan.walk.audited, current: scan.walk.current, value_call: scan.walk.value_call,
      sites: scan.walk.sites, bodies: scan.walk.bodies, tick: scan.walk.tick,
      groups: list_snoc_item(xs: scan.walk.groups, item: FactActivationGroup { children: scan.spans, not_derived: refusal })
    }
  } else {
    match demand_fact_repetition(node: node) {
      Absent => fold(demand_fact_children(node: node), init: w, f: fn(acc, e) { demand_fact_edge(w: acc, position: position, edge: e, resolved: resolved) })
      Present { value: repetition } => {
        let scan = fold(demand_fact_children(node: node), init: FactSpanScan { walk: w, spans: Empty }, f: fn(acc, e) {
          let next = demand_fact_edge(w: acc.walk, position: position, edge: e, resolved: resolved)
          let repeated = match repetition {
            LoopIteratedBody => loop_edge_contributes_to_iteration_fold(parent: node, e: e)
            LambdaInstantiationUnknown => true
          }
          if repeated {
            FactSpanScan { walk: next, spans: list_snoc_item(xs: acc.spans, item: FactSpan { enter: acc.walk.tick, exit: next.tick, role: FactUnroled }) }
          } else {
            FactSpanScan { walk: next, spans: acc.spans }
          }
        })
        DemandFactWalk {
          functions: scan.walk.functions, operations: scan.walk.operations, audited: scan.walk.audited, current: scan.walk.current, value_call: scan.walk.value_call,
          sites: scan.walk.sites, bodies: scan.walk.bodies, tick: scan.walk.tick,
          groups: list_snoc_item(xs: scan.walk.groups, item: FactRepeatedGroup { children: scan.spans, repetition: repetition })
        }
      }
    }
  }
}

// A node whose extent runs its sites more than once: a Loop, or an inline lambda (Arrow), whose
// template is executed once per element the callee feeds it. ADDITIVE; D13 ignores it.
fn demand_fact_repetition(node: Node) -> Optional<FactRepetition> {
  match node.kind {
    TypeNode { connective: c } =>
      match c {
        Arrow => Present { value: LambdaInstantiationUnknown }
        _ => Absent
      }
    ComputationNode { behavior: b } =>
      match b {
        Loop => Present { value: LoopIteratedBody }
        _ => Absent
      }
  }
}

fn demand_fact_span_role(node: Node, s: ChildSlot) -> FactSpanRole {
  match s.ordinal {
    LabeledChild => FactUnroled
    PositionalOrdinal { index: i } =>
      match node.kind {
        ComputationNode { behavior: b } =>
          match b {
            Branch =>
              match branch_positional_slot(ordinal: i) {
                Present { value: slot } =>
                  match slot {
                    BranchConditionSlot => FactSelector
                    _ => FactAlternative
                  }
                Absent => FactUnroled
              }
            Match =>
              match match_positional_slot(ordinal: i) {
                MatchScrutineeSlot => FactSelector
                _ => FactAlternative
              }
            _ => FactUnroled
          }
        TypeNode { connective: _ } => FactUnroled
      }
  }
}

// A2's disposition of THIS site (identity join at the point of use, never a parallel walk): the typed reason
// when v2.compiler.activation_dependency did not derive the site, else Absent and the roles stand.
fn demand_fact_activation_refusal(node: Node) -> Optional<ActivationNotDerivedReason> {
  let act = activation_dispose(acc: ActivationDependencies { demands: [], not_derived: [], zero_alternatives: [] }, n: node)
  match act.not_derived {
    Cons { head: row, tail: _ } => Present { value: row.reason }
    Empty => Absent
  }
}

fn demand_fact_is_branching(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: _ } => false
    ComputationNode { behavior: b } =>
      match b {
        Branch => true
        Match => true
        Value => false
        Transform => false
        Loop => false
        Bind => false
      }
  }
}

// A CALL SITE is a Transform the evaluator reads as a call (demand_fact_call_callee); its extent is the
// preorder interval the walk spent on it. The walk reserves one tick at the site's entry, so a nested site
// never shares its parent's `enter` even when no declaration reference ticks between them. Additive:
// nothing in this census reads it.
fn demand_fact_note_site(before: DemandFactWalk, node: Node, after: DemandFactWalk) -> DemandFactWalk {
  match demand_fact_call_callee(node: node) {
    Present { value: callee } =>
      DemandFactWalk {
        functions: after.functions, operations: after.operations, audited: after.audited, current: after.current, value_call: after.value_call,
        sites: list_snoc_item(xs: after.sites, item: FactCallSite { occurrence: node_occurrence_id_optional(node: node), callee: callee, enter: before.tick, exit: after.tick, operands: fold(node.children, init: Empty, f: fn(acc, c) { list_snoc_item(xs: acc, item: node_occurrence_id_optional(node: c.target)) }) }),
        bodies: after.bodies, tick: after.tick, groups: after.groups
      }
    Absent => after
  }
}

// The one call-head decision both the site and the value_call flag read. A Transform is a call only where
// eval_transform_has_callee_reference says so (a declaration reference, a lexical reference, or an Atom /
// Arrow head, which is a kernel operator or an inline lambda and is no site: the lambda's body is read as
// its own extent, an operator reaches no effect); a Transform headed by a resolve-minted parameter
// reference is a function-value call that predicate does not see. A Branch/Match/Value whose first child is
// a declaration reference is not a call.
fn demand_fact_call_callee(node: Node) -> Optional<FactCallee> {
  if demand_fact_is_transform(node: node) {
    if eval_transform_has_callee_reference(node: node) {
      match first(node.children) {
        Present { value: e } =>
          match declaration_reference_path_optional(node: e.target) {
            Present { value: callee } => Present { value: FactStaticCall { callee: callee } }
            Absent =>
              if demand_fact_head_is_lexical(node: node) {
                Present { value: FactFunctionValueCall { head: FactLexicalHead } }
              } else {
                Absent
              }
          }
        Absent => Absent
      }
    } else {
      if demand_fact_head_is_parameter(node: node) {
        Present { value: FactFunctionValueCall { head: FactParameterHead } }
      } else {
        Absent
      }
    }
  } else {
    Absent
  }
}

// A CALL THROUGH A FUNCTION VALUE HAS NO STATIC CALLEE, so its demand is undecided (review of
// gunbc#12992: hard-coding `false` made FunctionValueCalled unreachable on the real route). WHICH
// TRANSFORM IS A CALL is the evaluator's own decision, v2.compiler.eval eval_transform_has_callee_reference
// -- a Transform also carries blocks, casts and lowered operators, so reading every Transform's first
// child as a callee flagged a block ending in a parameter as a call. Of the callees eval admits, an
// Atom is a kernel operator and an Arrow an inline lambda whose body this walk reads anyway; a lexical
// reference (v2.std.qualified_name lexical_reference_label_optional) names a LOCAL binding whose value
// is only known at run time, and that is a function-value call.
//
// A NAMED FUNCTION PARAMETER IS THE OTHER ONE, AND EVAL'S PREDICATE DOES NOT SEE IT. Resolve mints a
// parameter as parameter_reference_node (<fn path>.<label>), not as a lexical reference, so
// eval_transform_has_callee_reference answers false for a Transform headed by one. Its value is the
// caller's argument, never a static declaration, so at this census boundary a Transform whose first
// positional child is a parameter reference is a function-value call too (review of gunbc#12992).
fn demand_fact_note_call(w: DemandFactWalk, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  if demand_fact_is_value_call(node: node) {
    DemandFactWalk { functions: w.functions, operations: w.operations, audited: w.audited, current: w.current, value_call: true, sites: w.sites, bodies: w.bodies, tick: w.tick, groups: w.groups }
  } else {
    w
  }
}

fn demand_fact_is_value_call(node: Node) -> Bool {
  match demand_fact_call_callee(node: node) {
    Present { value: FactFunctionValueCall { head: _ } } => true
    _ => false
  }
}

fn demand_fact_is_transform(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: _ } => false
    ComputationNode { behavior: b } =>
      match b {
        Transform => true
        Value => false
        Branch => false
        Loop => false
        Bind => false
        Match => false
      }
  }
}

fn demand_fact_head_is_lexical(node: Node) -> Bool {
  match first(node.children) {
    Present { value: e } =>
      match lexical_reference_label_optional(node: e.target) {
        Present { value: _ } => true
        Absent => false
      }
    Absent => false
  }
}

fn demand_fact_head_is_parameter(node: Node) -> Bool {
  match first(node.children) {
    Present { value: e } =>
      match e.label {
        Positional =>
          match parameter_reference_path_optional(node: e.target) {
            Present { value: _ } => true
            Absent => false
          }
        Authored { name: _ } => false
        StructuralLabel { label: _ } => false
      }
    Absent => false
  }
}

// Each arm is symbol_index_fill_containment_edge's own: a header-metadata structural edge is not
// walked (it names the module, not a mention), a parse-projection authored edge is descended without
// extending the position, and every other labelled edge extends it by the segment the index keys on
// (label_sort_key for a structural label, the authored name otherwise).
fn demand_fact_edge(w: DemandFactWalk, position: QualifiedName, edge: Edge, resolved: ResolvedTree) -> DemandFactWalk {
  match edge.label {
    Positional => demand_fact_node(w: w, position: position, node: edge.target, resolved: resolved)
    StructuralLabel { label: _ } =>
      if dag_surface_module_header_metadata_edge(e: edge) {
        w
      } else {
        demand_fact_labelled_child(w: w, child: qualified_name_snoc(qn: position, segment: label_sort_key(label: edge.label)), edge: edge, resolved: resolved)
      }
    Authored { name: sym } =>
      if parse_tree_projection_edge(name: sym) {
        demand_fact_node(w: w, position: position, node: edge.target, resolved: resolved)
      } else {
        demand_fact_labelled_child(w: w, child: qualified_name_snoc(qn: position, segment: sym), edge: edge, resolved: resolved)
      }
  }
}

fn demand_fact_labelled_child(w: DemandFactWalk, child: QualifiedName, edge: Edge, resolved: ResolvedTree) -> DemandFactWalk {
  match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: child) {
    Absent => demand_fact_node(w: w, position: child, node: edge.target, resolved: resolved)
    Present { value: _ } => demand_fact_declaration(w: w, path: child, node: edge.target, resolved: resolved)
  }
}

// THREE KINDS OF DECLARATION, decided in this order. (1) A declaration at or under a declared
// resource -- the resource itself or one of its capabilities -- demands that resource: a direct
// capability call is a reference to it. (2) An Arrow with no body edge is an operation, and its
// requirement is read from its ArrowResourceRequirementsEdge core edge; an absent edge is undeclared
// (D13 ruling B). (3) Anything else -- a fn, a data row, a type -- demands what its subtree refers to.
fn demand_fact_declaration(w: DemandFactWalk, path: QualifiedName, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  match demand_census_resource_prefix(index: resolved.symbol_index, path: path) {
    Present { value: declared } =>
      demand_fact_with_operation(w: w, op: OperationFact { path: path, requirement: RequiresResources { resources: [declared] } })
    Absent =>
      if demand_census_is_operation_arrow(node: node) {
        demand_fact_with_declared_operation(w: w, op: OperationFact { path: path, requirement: demand_census_requirement(arrow: node) })
      } else {
        let start = DemandFactWalk { functions: w.functions, operations: w.operations, audited: w.audited, current: Empty, value_call: false, sites: Empty, bodies: w.bodies, tick: w.tick, groups: Empty }
        let inner = match demand_fact_repetition(node: node) {
          Present { value: LambdaInstantiationUnknown } =>
            fold(demand_fact_children(node: node), init: start, f: fn(acc, e) { demand_fact_edge(w: acc, position: path, edge: e, resolved: resolved) })
          _ => demand_fact_node(w: start, position: path, node: node, resolved: resolved)
        }
        DemandFactWalk {
          functions: list_snoc_item(xs: inner.functions, item: FunctionFact { path: path, callees: inner.current, calls_function_value: inner.value_call }),
          operations: inner.operations,
          audited: inner.audited,
          current: w.current,
          value_call: w.value_call,
          sites: w.sites,
          bodies: list_snoc_item(xs: inner.bodies, item: FactBodySites { function: path, sites: inner.sites, groups: inner.groups }),
          tick: inner.tick,
          groups: w.groups
        }
      }
  }
}

fn demand_fact_with_operation(w: DemandFactWalk, op: OperationFact) -> DemandFactWalk {
  DemandFactWalk { functions: w.functions, operations: list_snoc_item(xs: w.operations, item: op), audited: w.audited, current: w.current, value_call: w.value_call, sites: w.sites, bodies: w.bodies, tick: w.tick, groups: w.groups }
}

// A DECLARED operation: its requirement is the authority the audited vocabulary is read from.
fn demand_fact_with_declared_operation(w: DemandFactWalk, op: OperationFact) -> DemandFactWalk {
  let with_op = demand_fact_with_operation(w: w, op: op)
  match op.requirement {
    RequiresResources { resources: rs } =>
      DemandFactWalk { functions: with_op.functions, operations: with_op.operations, audited: fold_list(xs: rs, empty: with_op.audited, cons: fn(a, r) { list_snoc_item(xs: a, item: r) }), current: with_op.current, value_call: with_op.value_call, sites: with_op.sites, bodies: with_op.bodies, tick: with_op.tick, groups: with_op.groups }
    RequiresNone => with_op
    RequiresOpaque => with_op
    RequiresUndeclared => with_op
  }
}

type DemandPrefixScan {
  prefix: QualifiedName
  declared: Optional<QualifiedName>
}

// The SHORTEST prefix that is a declared resource: a capability's path is under its resource.
fn demand_census_resource_prefix(index: SymbolIndex, path: QualifiedName) -> Optional<QualifiedName> {
  let scanned = fold_list(xs: path, empty: DemandPrefixScan { prefix: Empty, declared: optional_absent() }, cons: fn(scan, seg) {
    let prefix = qualified_name_snoc(qn: scan.prefix, segment: seg)
    match scan.declared {
      Present { value: r } => DemandPrefixScan { prefix: prefix, declared: optional_present(value: r) }
      Absent =>
        if symbol_index_declares_resource_at(index: index, qualified_path: prefix) {
          DemandPrefixScan { prefix: prefix, declared: optional_present(value: prefix) }
        } else {
          DemandPrefixScan { prefix: prefix, declared: optional_absent() }
        }
    }
  })
  scanned.declared
}

// The edge a core contract marker names, through v2.std.node edge_is_core. v2.std.node
// arrow_signature_edges_conform admits at most one of each on an Arrow, so the first is the only one.
// (v2.std.node core_edge_target_lookup answers the same question; its miss arm is NotFound,
// which this module's Optional matches already bind.)
fn demand_census_edge_target(children: List<Edge>, marker: CoreEdgeLabel) -> Optional<Node> {
  fold(children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => if edge_is_core(e: e, marker: marker) { optional_present(value: e.target) } else { acc }
    }
  })
}

// An operation is an Arrow with no body: the arrow test is the evaluator's (v2.compiler.eval
// eval_node_is_arrow) and the body read is v2.std.node_query find_arrow_body_child, never a local copy.
fn demand_census_is_operation_arrow(node: Node) -> Bool {
  if eval_node_is_arrow(node: node) {
    match find_arrow_body_child(root: node) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
  } else {
    false
  }
}

fn demand_census_requirement_atom(id: Symbol) -> RequirementClass {
  if id == ^requirements_declared_none {
    RequiresNone
  } else if id == ^requirements_opaque {
    RequiresOpaque
  } else {
    RequiresUndeclared
  }
}

fn demand_census_requirement_members(t: Node) -> RequirementClass {
  RequiresResources {
    resources: fold(t.children, init: Empty, f: fn(acc, e) {
      match declaration_reference_path_optional(node: e.target) {
        Present { value: p } => list_snoc_item(xs: acc, item: p)
        Absent => acc
      }
    })
  }
}

// The requirements target after resolution: an Atom for `none` / `opaque`, a Conj of resolved resource
// references, or no edge at all (undeclared). Any other shape is refused by the pre-resolve wall
// (v2.std.arrow_contract arrow_resource_requirements_edge_target_reads), so it reads as undeclared.
fn demand_census_requirement(arrow: Node) -> RequirementClass {
  match demand_census_edge_target(children: arrow.children, marker: ArrowResourceRequirementsEdge) {
    Absent => RequiresUndeclared
    Present { value: t } =>
      match t.kind {
        TypeNode { connective: c } =>
          match c {
            Atom { identity: id } => demand_census_requirement_atom(id: id)
            Conj => demand_census_requirement_members(t: t)
            Disj => RequiresUndeclared
            Arrow => RequiresUndeclared
            Instantiation => RequiresUndeclared
          }
        ComputationNode { behavior: _ } => RequiresUndeclared
      }
  }
}

// ═══ THE AUTHORED SIDE, RESOLVED BY THE MODULE'S OWN SCOPE ═══════════════════════════════════════

// ═══ THE ROW AND ITS VERDICT ═══════════════════════════════════════════════════════════════════

// Why a uses fn's demand was not observed: the fn's file refused in the front end even with the clause
// elided, the module refused at resolution (including a body that still names an elided uses alias),
// the fn's own name could not be read, an authored type did not resolve, or the uses aliases were
// duplicate or unreadable.
type DemandCensusUnboundLocus
  = UnboundNamed { name: Symbol }
  | UnboundShaped { kind: NodeKind, reference: Optional<QualifiedName> }

// THE CANONICAL SHAPED REFERENCE OF A COMPOSITE MENTION, derived once: the mention's own reference
// path, else its first positional child's (an instantiation's head, a list introduction's head).
// Census and CLI both render this; a second walk of the node would be a second authority.
fn demand_census_shaped_reference_optional(node: Node) -> Optional<QualifiedName> {
  match demand_census_reference_path_optional(node: node) {
    Present { value: p } => optional_present(value: p)
    Absent =>
      match list_at_optional(xs: positional_child_target_nodes(node: node), index: 0) {
        Absent => optional_absent()
        Present { value: head } => demand_census_reference_path_optional(node: head)
      }
  }
}

// A REFERENCE IN EITHER FORM A REFUSED MENTION CAN CARRY: the marked declaration reference (a
// compiler-generated head, or one resolve minted), or the qualified-name spine an AUTHORED qualified
// name is before resolve binds it (`std.algebra.FreeMonoid<T>` written in a type ascription). The
// census renders what the resolver refused, so it reads the pre-resolve spine as the path it spells;
// this reads a name, it binds nothing.
fn demand_census_reference_path_optional(node: Node) -> Optional<QualifiedName> {
  match declaration_reference_path_optional(node: node) {
    Present { value: p } => optional_present(value: p)
    Absent =>
      if qualified_name_spine_shape_present(root: node) {
        match qualified_name_from_node(root: node) {
          Accepted { value: qn, diagnostics: _ } => optional_present(value: qn)
          Rejected { diagnostics: _ } => optional_absent()
        }
      } else {
        optional_absent()
      }
  }
}

// WHAT IS UNBOUND, READ FROM THE FATAL THE RESOLVER ALREADY LOCATED. The diagnostic's NodeLocus
// carries the mention; this projects it onto the census carrier (atom identity, or the node's kind
// plus shaped reference when the mention is a composite). A second consumer that re-walked the
// node would be a second authority for the same fact (DESIGN section 3).
fn demand_census_unbound_locus_from_diagnostics(d: NonEmptyDiagnostics) -> Optional<DemandCensusUnboundLocus> {
  let fatal = diagnostics_fatal(d: d)
  if fatal.reason == ^resolve_reason_unbound_symbol {
    match fatal.at {
      NodeLocus { anchor: a } =>
        match node_atom_identity_optional(node: a.at) {
          Present { value: n } => optional_present(value: UnboundNamed { name: n })
          Absent =>
            optional_present(value: UnboundShaped {
              kind: a.at.kind,
              reference: demand_census_shaped_reference_optional(node: a.at)
            })
        }
      Textual { file: _, extent: _ } => optional_absent()
      SourcePortLocus { anchor: _, file: _, extent: _ } => optional_absent()
      InvariantPortLocus { anchor: _, invariant: _ } => optional_absent()
      DeclarationLocus { declaration: _ } => optional_absent()
    }
  } else {
    optional_absent()
  }
}

// ═══ THE REPORT ═══════════════════════════════════════════════════════════════════════════════

fn demand_census_text(parts: List<String>) -> String {
  fold_list(xs: parts, empty: "", cons: fn(acc, p) { concat(acc, p) })
}

fn demand_census_node_kind_word(k: NodeKind) -> String {
  match k {
    TypeNode { connective: Atom { identity: _ } } => "atom"
    TypeNode { connective: Conj } => "conj"
    TypeNode { connective: Disj } => "disj"
    TypeNode { connective: Arrow } => "arrow"
    TypeNode { connective: Instantiation } => "instantiation"
    ComputationNode { behavior: Value } => "value"
    ComputationNode { behavior: Transform } => "transform"
    ComputationNode { behavior: Branch } => "branch"
    ComputationNode { behavior: Loop } => "loop"
    ComputationNode { behavior: Bind } => "bind"
    ComputationNode { behavior: Match } => "match"
  }
}

fn demand_census_unbound_site_text(u: Optional<DemandCensusUnboundLocus>) -> String {
  match u {
    Absent => "unbound_locus="
    Present { value: loc } =>
      match loc {
        UnboundNamed { name: n } => demand_census_text(parts: ["unbound_name=", symbol_lexeme(sym: n)])
        UnboundShaped { kind: k, reference: p } =>
          match p {
            Absent => demand_census_text(parts: ["unbound_kind=", demand_census_node_kind_word(k: k)])
            Present { value: qn } => demand_census_text(parts: ["unbound_ref=", qualified_name_to_dotted_string(qn: qn)])
          }
      }
  }
}

// ═══ JOINING THE CLOSURE ════════════════════════════════════════════════════════════════════════

