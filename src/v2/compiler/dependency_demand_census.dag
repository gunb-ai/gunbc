// THE DEPENDENCY-DEMAND CENSUS (D13 step b2): for every fn that authors a `uses` clause, the
// authored rows read from THAT fn's parse, paired with the demand v2.compiler.dependency_demand
// derives for the same fn over the whole closure, and one verdict. Its consumer is the D13
// row-deletion change, which deletes a row only where this census, executed at that change's own
// head, reads Equal (lane ruling: an earlier run's receipt is not evidence for a later tree).
//
// THE STRIP IS CENSUS-ONLY AND IT IS NOT A CARRIER. Production lowering refuses every fn with a
// `uses` clause (v2.compiler.body_lowering_fold body_lower_fn_uses_refusal_optional). The census
// route elides the clause shell with grammar_empty_node so normalize does not refuse at the
// unmodeled clause. It does not rewrite uses aliases onto the resource declaration: that would be
// a second binder beside resolve, and it is not admitted (DESIGN section 5). Duplicate aliases, or
// an alias that cannot be read, leave the fn unobserved. A body that names an elided alias is
// unobserved until resolve models the clause. The stripped tree is consumed inside the census route
// only (v2.compiler.source_root_eval native_demand_census_report). The authored rows are never lowered onto
// the fn: they are read, judged and reported (operator D13: no carrier for the authored row).
//
// THE VERDICT IS SCOPED TO THE AUDITED VOCABULARY (lane ruling). Derived demand is grounded only
// for resources some operation was audited to declare, which today is Network. A row naming any
// other resource is OutOfVocabulary, never a Mismatch, and its future owner is the per-resource
// operation audit for that resource (Filesystem next).
//
// THE FACT READ IS A DECLARED OVER-APPROXIMATION, computed as the answer (DESIGN section 5, not an
// absorbing fallback). A declaration's callees are EVERY declaration reference in its resolved
// subtree, not only call heads: a fn passed as a value is counted where it is mentioned. So the
// derived demand covers every callee a function value can reach when that value originates inside
// the closure, and derived may exceed actual; it is never below it. A row is deleted only where the
// derived demand covers it, so the over-approximation can turn a deletable row into a Mismatch, and
// cannot turn a needed row into a deletion.

// THE AUDITED VOCABULARY IS DERIVED, NOT SPELLED (review 74228 of gunbc#12992): it is the set of resources
// that some operation of the closure DECLARES in its `requires` edge, read off the resolved tree by the
// fact walk (DemandFactWalk audited). A resource no operation was audited to require -- Filesystem and
// Clock today -- is out of vocabulary because no derivation of it is grounded, never because a string
// here omitted it, and a renamed resource moves with its declaration.
// ═══ THE STRIP ═══════════════════════════════════════════════════════════════════════════════════

// One authored `uses` clause, read from the parse of the fn that carries it. `name` is Absent only
// when the fn's own name could not be read off the same parse; that fn still gets a census row.
type UsesAliasBind
  = UsesAliasBindUnique
  | UsesAliasBindConflict
  | UsesAliasBindUnestablished

type AuthoredUsesFunction {
  owner: QualifiedName
  name: Optional<Symbol>
  types: List<Optional<Node>>
  alias_bind: UsesAliasBind
}

type DemandCensusStripped {
  tree: Node
  authored: List<AuthoredUsesFunction>
}

fn demand_census_strip(tree: Node, owner: QualifiedName) -> DemandCensusStripped {
  let authored = demand_census_authored_in(acc: Empty, node: tree, owner: owner)
  if is_empty(xs: authored) {
    DemandCensusStripped { tree: tree, authored: authored }
  } else {
    DemandCensusStripped { tree: demand_census_elide_uses(node: tree), authored: authored }
  }
}

// A fn declaration is not descended into: the clause belongs to the declaration's own signature,
// and a fn body holds no fn declaration.
fn demand_census_authored_in(acc: List<AuthoredUsesFunction>, node: Node, owner: QualifiedName) -> List<AuthoredUsesFunction> {
  if dag_node_is_fn_decl(node: node) {
    match parse_production_captured_child_optional(node: node) {
      Absent => acc
      Present { value: captured } =>
        match body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_uses_clause) {
          Absent => acc
          Present { value: clause } =>
            list_snoc_item(xs: acc, item: AuthoredUsesFunction {
              owner: owner,
              name: dag_surface_kw_then_ident_from_captured(captured: captured),
              types: demand_census_entry_types(clause: clause),
              alias_bind: demand_census_alias_uniqueness(aliases: demand_census_entry_aliases(clause: clause))
            })
        }
    }
  } else {
    fold(node.children, init: acc, f: fn(a, e) { demand_census_authored_in(acc: a, node: e.target, owner: owner) })
  }
}

fn demand_census_entry_aliases(clause: Node) -> List<Optional<Symbol>> {
  fold_list(xs: demand_census_entry_shells(acc: Empty, node: clause), empty: Empty, cons: fn(acc, entry) {
    list_snoc_item(xs: acc, item: demand_census_entry_alias(entry: entry))
  })
}

fn demand_census_entry_alias(entry: Node) -> Optional<Symbol> {
  match parse_production_captured_child_optional(node: entry) {
    Absent => optional_absent()
    Present { value: captured } =>
      match sugar_sequence_pair_optional(node: captured) {
        Present { value: pair } => body_lower_param_binding_optional(node: pair.left)
        Absent => body_lower_param_binding_optional(node: captured)
      }
  }
}

type AliasUniqScan
  = AliasScanUnique { seen: Map<Symbol, Bool> }
  | AliasScanConflict
  | AliasScanUnestablished

fn demand_census_alias_uniqueness(aliases: List<Optional<Symbol>>) -> UsesAliasBind {
  match fold_list(xs: aliases, empty: AliasScanUnique { seen: empty_map() }, cons: fn(acc, a) {
    match acc {
      AliasScanConflict => acc
      AliasScanUnestablished => acc
      AliasScanUnique { seen: seen } =>
        match a {
          Absent => AliasScanUnestablished
          Present { value: n } =>
            match map_lookup(m: seen, key: n) {
              Present { value: _ } => AliasScanConflict
              Absent => AliasScanUnique { seen: map_insert(m: seen, key: n, value: true) }
            }
        }
    }
  }) {
    AliasScanUnique { seen: _ } => UsesAliasBindUnique
    AliasScanConflict => UsesAliasBindConflict
    AliasScanUnestablished => UsesAliasBindUnestablished
  }
}

// One element per authored entry, in authored order: the entry's type_expr shell, or Absent when the
// entry carries none the reader can find (that row then reads AuthoredTypeUnresolved).
fn demand_census_entry_types(clause: Node) -> List<Optional<Node>> {
  fold_list(xs: demand_census_entry_shells(acc: Empty, node: clause), empty: Empty, cons: fn(acc, entry) {
    list_snoc_item(xs: acc, item: demand_census_entry_type(entry: entry))
  })
}

fn demand_census_entry_type(entry: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: entry) {
    Absent => optional_absent()
    Present { value: captured } => body_lower_find_production_shell_optional(root: captured, emitted: ^dag_surface_type_expr)
  }
}

fn demand_census_entry_shells(acc: List<Node>, node: Node) -> List<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_uses_entry {
        list_snoc_item(xs: acc, item: node)
      } else {
        fold(node.children, init: acc, f: fn(a, e) { demand_census_entry_shells(acc: a, node: e.target) })
      }
    Absent => fold(node.children, init: acc, f: fn(a, e) { demand_census_entry_shells(acc: a, node: e.target) })
  }
}

fn demand_census_elide_uses(node: Node) -> Node {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_uses_clause { grammar_empty_node() } else { demand_census_elide_children(node: node) }
    Absent => demand_census_elide_children(node: node)
  }
}

fn demand_census_elide_children(node: Node) -> Node {
  node_rebuild(n: node, children: fold(node.children, init: Empty, f: fn(acc, e) {
    list_snoc_item(xs: acc, item: Edge { label: e.label, target: demand_census_elide_uses(node: e.target), declaration: e.declaration })
  }))
}

// ═══ THE FACT READ OVER ONE RESOLVED MODULE ═══════════════════════════════════════════════════════

type DemandCensusModuleFacts {
  functions: List<FunctionFact>
  operations: List<OperationFact>
  audited: List<QualifiedName>
  bodies: List<FactBodySites>
}

type DemandFactWalk {
  functions: List<FunctionFact>
  operations: List<OperationFact>
  audited: List<QualifiedName>
  current: List<QualifiedName>
  value_call: Bool
  sites: List<FactCallSite>
  bodies: List<FactBodySites>
  tick: Int
  groups: List<FactGroup>
}

// ADDITIVE, FOR v2.compiler.effect_pair_census; THIS CENSUS IGNORES BOTH FIELDS. A call-site is the
// callee reference occurrence (the key value_use_dependency uses) and the path it names; a body is
// one declaration's sites in walk order.
type FactCallSite {
  occurrence: Optional<OccurrenceId>
  callee: FactCallee
  enter: Int
  exit: Int
  operands: List<Optional<OccurrenceId>>
}

// WHAT A CALL SITE CALLS, decided by demand_fact_call_callee over the evaluator's own Transform/call-head
// authority (eval_transform_has_callee_reference plus the parameter head resolve mints). A static
// declaration call names its path, which may be outside the closure (unresolved is the consumer's reading of
// that path); a function-value call names no declaration, only which kind of head it has.
type FactCallee
  = FactStaticCall { callee: QualifiedName }
  | FactFunctionValueCall { head: FactValueHead }

type FactValueHead
  = FactLexicalHead
  | FactParameterHead

// A Branch or Match node: the preorder span of each child, selector first. Sites in different non-selector
// children are alternatives; a selector's sites order before every arm's.
type FactSpan {
  enter: Int
  exit: Int
  role: FactSpanRole
}

// WHAT A CHILD OF A Branch/Match IS, read through v2.std.node's slot tables (branch_positional_slot,
// match_positional_slot) and only for a site v2.compiler.activation_dependency derived; a labeled child is
// neither, and every child of a group A2 did not derive is FactUnroled. Never "the first positional".
type FactSpanRole
  = FactSelector
  | FactAlternative
  | FactUnroled

// WHY A REPEATED EXTENT RUNS MORE THAN ONCE, or that it is not known. A Loop repeats only its iterated BODY
// (v2.std.node loop_edge_contributes_to_iteration_fold; its domain, bound, carrier and metadata do not). An inline
// lambda is repeated only where its consumer instantiates it repeatedly, which this census does not read, so
// it is a typed unknown, never counted as repeated.
type FactRepetition
  = LoopIteratedBody
  | LambdaInstantiationUnknown

// A Branch/Match extent with each child's role, or the typed reason A2 did not derive the site (no role then);
// or a repeated extent. One group per such node.
type FactGroup
  = FactActivationGroup { children: List<FactSpan>, not_derived: Optional<ActivationNotDerivedReason> }
  | FactRepeatedGroup { children: List<FactSpan>, repetition: FactRepetition }

type FactBodySites {
  function: QualifiedName
  sites: List<FactCallSite>
  groups: List<FactGroup>
}

// A declaration is a named edge whose path the resolved tree's own declaration index carries
// (ResolvedTree resolved_declarations); every other named edge -- a record field, a body edge -- is
// containment inside the declaration that holds it.
fn demand_census_module_facts(resolved: ResolvedTree, module_qn: QualifiedName) -> DemandCensusModuleFacts {
  let w = demand_fact_node(
    w: DemandFactWalk { functions: Empty, operations: Empty, audited: Empty, current: Empty, value_call: false, sites: Empty, bodies: Empty, tick: 0, groups: Empty },
    position: module_qn,
    node: resolved.root,
    resolved: resolved
  )
  DemandCensusModuleFacts { functions: w.functions, operations: w.operations, audited: w.audited, bodies: w.bodies }
}

// THE CONTAINMENT RULE IS THE INDEX'S OWN (v2.compiler.symbol_index_fill symbol_index_fill_containment_node
// and _edge), so a path this walk forms is the path resolved_declarations was keyed at: a module-spine
// body is unwrapped wherever it stands, and a parse-projection or header-metadata edge is descended
// without extending the position. Extending the position by those labels formed paths no declaration
// has, and every fn read as undeclared.
fn demand_fact_children(node: Node) -> List<Edge> {
  match namespace_graft_spine_body_optional(node: node) {
    Present { value: body } => body.children
    Absent => node.children
  }
}

// A LIST INTRODUCTION IS NOT A CALL: its head is the compiler-generated reference to the free monoid's
// declaration (v2.std.list_introduction), a type, so only its elements are mentioned. The reader is
// the one eval uses, so every list introduction is excluded, not only a fn's parameter-order list.
fn demand_fact_node(w: DemandFactWalk, position: QualifiedName, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  match list_introduction_elements_optional(node: node) {
    Present { value: elements } =>
      fold(elements, init: w, f: fn(acc, e) { demand_fact_node(w: acc, position: position, node: e, resolved: resolved) })
    Absent => demand_fact_reference_or_children(w: w, position: position, node: node, resolved: resolved)
  }
}

fn demand_fact_reference_or_children(w: DemandFactWalk, position: QualifiedName, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  match declaration_reference_path_optional(node: node) {
    Present { value: target } =>
      DemandFactWalk { functions: w.functions, operations: w.operations, audited: w.audited, current: list_snoc_item(xs: w.current, item: target), value_call: w.value_call, sites: w.sites, bodies: w.bodies, tick: w.tick + 1, groups: w.groups }
    Absent =>
      demand_fact_note_site(
        before: w,
        node: node,
        after: demand_fact_walk_children(w: demand_fact_reserve_site_tick(w: demand_fact_note_call(w: w, node: node, resolved: resolved), node: node), position: position, node: node, resolved: resolved)
      )
  }
}

// One tick at a call site's entry, so its `enter` is unique among the sites of a body.
fn demand_fact_reserve_site_tick(w: DemandFactWalk, node: Node) -> DemandFactWalk {
  match demand_fact_call_callee(node: node) {
    Present { value: _ } =>
      DemandFactWalk { functions: w.functions, operations: w.operations, audited: w.audited, current: w.current, value_call: w.value_call, sites: w.sites, bodies: w.bodies, tick: w.tick + 1, groups: w.groups }
    Absent => w
  }
}

// THE CHILDREN WALK. A Branch or Match also records each child's preorder span as one group, so a consumer
// can tell alternatives from selector; every other node is walked exactly as before. Additive.
type FactSpanScan {
  walk: DemandFactWalk
  spans: List<FactSpan>
}

fn demand_fact_walk_children(w: DemandFactWalk, position: QualifiedName, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  if demand_fact_is_branching(node: node) {
    let refusal = demand_fact_activation_refusal(node: node)
    let scan = fold(node_child_slots(n: node), init: FactSpanScan { walk: w, spans: Empty }, f: fn(acc, s) {
      let next = demand_fact_edge(w: acc.walk, position: position, edge: s.edge, resolved: resolved)
      let role = match refusal {
        Present { value: _ } => FactUnroled
        Absent => demand_fact_span_role(node: node, s: s)
      }
      FactSpanScan { walk: next, spans: list_snoc_item(xs: acc.spans, item: FactSpan { enter: acc.walk.tick, exit: next.tick, role: role }) }
    })
    DemandFactWalk {
      functions: scan.walk.functions, operations: scan.walk.operations, audited: scan.walk.audited, current: scan.walk.current, value_call: scan.walk.value_call,
      sites: scan.walk.sites, bodies: scan.walk.bodies, tick: scan.walk.tick,
      groups: list_snoc_item(xs: scan.walk.groups, item: FactActivationGroup { children: scan.spans, not_derived: refusal })
    }
  } else {
    match demand_fact_repetition(node: node) {
      Absent => fold(demand_fact_children(node: node), init: w, f: fn(acc, e) { demand_fact_edge(w: acc, position: position, edge: e, resolved: resolved) })
      Present { value: repetition } => {
        let scan = fold(demand_fact_children(node: node), init: FactSpanScan { walk: w, spans: Empty }, f: fn(acc, e) {
          let next = demand_fact_edge(w: acc.walk, position: position, edge: e, resolved: resolved)
          let repeated = match repetition {
            LoopIteratedBody => loop_edge_contributes_to_iteration_fold(parent: node, e: e)
            LambdaInstantiationUnknown => true
          }
          if repeated {
            FactSpanScan { walk: next, spans: list_snoc_item(xs: acc.spans, item: FactSpan { enter: acc.walk.tick, exit: next.tick, role: FactUnroled }) }
          } else {
            FactSpanScan { walk: next, spans: acc.spans }
          }
        })
        DemandFactWalk {
          functions: scan.walk.functions, operations: scan.walk.operations, audited: scan.walk.audited, current: scan.walk.current, value_call: scan.walk.value_call,
          sites: scan.walk.sites, bodies: scan.walk.bodies, tick: scan.walk.tick,
          groups: list_snoc_item(xs: scan.walk.groups, item: FactRepeatedGroup { children: scan.spans, repetition: repetition })
        }
      }
    }
  }
}

// A node whose extent runs its sites more than once: a Loop, or an inline lambda (Arrow), whose
// template is executed once per element the callee feeds it. ADDITIVE; D13 ignores it.
fn demand_fact_repetition(node: Node) -> Optional<FactRepetition> {
  match node.kind {
    TypeNode { connective: c } =>
      match c {
        Arrow => Present { value: LambdaInstantiationUnknown }
        _ => Absent
      }
    ComputationNode { behavior: b } =>
      match b {
        Loop => Present { value: LoopIteratedBody }
        _ => Absent
      }
  }
}

fn demand_fact_span_role(node: Node, s: ChildSlot) -> FactSpanRole {
  match s.ordinal {
    LabeledChild => FactUnroled
    PositionalOrdinal { index: i } =>
      match node.kind {
        ComputationNode { behavior: b } =>
          match b {
            Branch =>
              match branch_positional_slot(ordinal: i) {
                Present { value: slot } =>
                  match slot {
                    BranchConditionSlot => FactSelector
                    _ => FactAlternative
                  }
                Absent => FactUnroled
              }
            Match =>
              match match_positional_slot(ordinal: i) {
                MatchScrutineeSlot => FactSelector
                _ => FactAlternative
              }
            _ => FactUnroled
          }
        TypeNode { connective: _ } => FactUnroled
      }
  }
}

// A2's disposition of THIS site (identity join at the point of use, never a parallel walk): the typed reason
// when v2.compiler.activation_dependency did not derive the site, else Absent and the roles stand.
fn demand_fact_activation_refusal(node: Node) -> Optional<ActivationNotDerivedReason> {
  let act = activation_dispose(acc: ActivationDependencies { demands: [], not_derived: [], zero_alternatives: [] }, n: node)
  match act.not_derived {
    Cons { head: row, tail: _ } => Present { value: row.reason }
    Empty => Absent
  }
}

fn demand_fact_is_branching(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: _ } => false
    ComputationNode { behavior: b } =>
      match b {
        Branch => true
        Match => true
        Value => false
        Transform => false
        Loop => false
        Bind => false
      }
  }
}

// A CALL SITE is a Transform the evaluator reads as a call (demand_fact_call_callee); its extent is the
// preorder interval the walk spent on it. The walk reserves one tick at the site's entry, so a nested site
// never shares its parent's `enter` even when no declaration reference ticks between them. Additive:
// nothing in this census reads it.
fn demand_fact_note_site(before: DemandFactWalk, node: Node, after: DemandFactWalk) -> DemandFactWalk {
  match demand_fact_call_callee(node: node) {
    Present { value: callee } =>
      DemandFactWalk {
        functions: after.functions, operations: after.operations, audited: after.audited, current: after.current, value_call: after.value_call,
        sites: list_snoc_item(xs: after.sites, item: FactCallSite { occurrence: node_occurrence_id_optional(node: node), callee: callee, enter: before.tick, exit: after.tick, operands: fold(node.children, init: Empty, f: fn(acc, c) { list_snoc_item(xs: acc, item: node_occurrence_id_optional(node: c.target)) }) }),
        bodies: after.bodies, tick: after.tick, groups: after.groups
      }
    Absent => after
  }
}

// The one call-head decision both the site and the value_call flag read. A Transform is a call only where
// eval_transform_has_callee_reference says so (a declaration reference, a lexical reference, or an Atom /
// Arrow head, which is a kernel operator or an inline lambda and is no site: the lambda's body is read as
// its own extent, an operator reaches no effect); a Transform headed by a resolve-minted parameter
// reference is a function-value call that predicate does not see. A Branch/Match/Value whose first child is
// a declaration reference is not a call.
fn demand_fact_call_callee(node: Node) -> Optional<FactCallee> {
  if demand_fact_is_transform(node: node) {
    if eval_transform_has_callee_reference(node: node) {
      match first(node.children) {
        Present { value: e } =>
          match declaration_reference_path_optional(node: e.target) {
            Present { value: callee } => Present { value: FactStaticCall { callee: callee } }
            Absent =>
              if demand_fact_head_is_lexical(node: node) {
                Present { value: FactFunctionValueCall { head: FactLexicalHead } }
              } else {
                Absent
              }
          }
        Absent => Absent
      }
    } else {
      if demand_fact_head_is_parameter(node: node) {
        Present { value: FactFunctionValueCall { head: FactParameterHead } }
      } else {
        Absent
      }
    }
  } else {
    Absent
  }
}

// A CALL THROUGH A FUNCTION VALUE HAS NO STATIC CALLEE, so its demand is undecided (review of
// gunbc#12992: hard-coding `false` made FunctionValueCalled unreachable on the real route). WHICH
// TRANSFORM IS A CALL is the evaluator's own decision, v2.compiler.eval eval_transform_has_callee_reference
// -- a Transform also carries blocks, casts and lowered operators, so reading every Transform's first
// child as a callee flagged a block ending in a parameter as a call. Of the callees eval admits, an
// Atom is a kernel operator and an Arrow an inline lambda whose body this walk reads anyway; a lexical
// reference (v2.std.qualified_name lexical_reference_label_optional) names a LOCAL binding whose value
// is only known at run time, and that is a function-value call.
//
// A NAMED FUNCTION PARAMETER IS THE OTHER ONE, AND EVAL'S PREDICATE DOES NOT SEE IT. Resolve mints a
// parameter as parameter_reference_node (<fn path>.<label>), not as a lexical reference, so
// eval_transform_has_callee_reference answers false for a Transform headed by one. Its value is the
// caller's argument, never a static declaration, so at this census boundary a Transform whose first
// positional child is a parameter reference is a function-value call too (review of gunbc#12992).
fn demand_fact_note_call(w: DemandFactWalk, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  if demand_fact_is_value_call(node: node) {
    DemandFactWalk { functions: w.functions, operations: w.operations, audited: w.audited, current: w.current, value_call: true, sites: w.sites, bodies: w.bodies, tick: w.tick, groups: w.groups }
  } else {
    w
  }
}

fn demand_fact_is_value_call(node: Node) -> Bool {
  match demand_fact_call_callee(node: node) {
    Present { value: FactFunctionValueCall { head: _ } } => true
    _ => false
  }
}

fn demand_fact_is_transform(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: _ } => false
    ComputationNode { behavior: b } =>
      match b {
        Transform => true
        Value => false
        Branch => false
        Loop => false
        Bind => false
        Match => false
      }
  }
}

fn demand_fact_head_is_lexical(node: Node) -> Bool {
  match first(node.children) {
    Present { value: e } =>
      match lexical_reference_label_optional(node: e.target) {
        Present { value: _ } => true
        Absent => false
      }
    Absent => false
  }
}

fn demand_fact_head_is_parameter(node: Node) -> Bool {
  match first(node.children) {
    Present { value: e } =>
      match e.label {
        Positional =>
          match parameter_reference_path_optional(node: e.target) {
            Present { value: _ } => true
            Absent => false
          }
        Authored { name: _ } => false
        StructuralLabel { label: _ } => false
      }
    Absent => false
  }
}

// Each arm is symbol_index_fill_containment_edge's own: a header-metadata structural edge is not
// walked (it names the module, not a mention), a parse-projection authored edge is descended without
// extending the position, and every other labelled edge extends it by the segment the index keys on
// (label_sort_key for a structural label, the authored name otherwise).
fn demand_fact_edge(w: DemandFactWalk, position: QualifiedName, edge: Edge, resolved: ResolvedTree) -> DemandFactWalk {
  match edge.label {
    Positional => demand_fact_node(w: w, position: position, node: edge.target, resolved: resolved)
    StructuralLabel { label: _ } =>
      if dag_surface_module_header_metadata_edge(e: edge) {
        w
      } else {
        demand_fact_labelled_child(w: w, child: qualified_name_snoc(qn: position, segment: label_sort_key(label: edge.label)), edge: edge, resolved: resolved)
      }
    Authored { name: sym } =>
      if parse_tree_projection_edge(name: sym) {
        demand_fact_node(w: w, position: position, node: edge.target, resolved: resolved)
      } else {
        demand_fact_labelled_child(w: w, child: qualified_name_snoc(qn: position, segment: sym), edge: edge, resolved: resolved)
      }
  }
}

fn demand_fact_labelled_child(w: DemandFactWalk, child: QualifiedName, edge: Edge, resolved: ResolvedTree) -> DemandFactWalk {
  match symbol_index_lookup(index: resolved.resolved_declarations, qualified_path: child) {
    Absent => demand_fact_node(w: w, position: child, node: edge.target, resolved: resolved)
    Present { value: _ } => demand_fact_declaration(w: w, path: child, node: edge.target, resolved: resolved)
  }
}

// THREE KINDS OF DECLARATION, decided in this order. (0) A declaration std.primitive_projection
// projects as HostRealizedSeam is an OPAQUE OPERATION: its facts come from its
// v2.std.operation_declaration row and its BODY IS NEVER WALKED. A seam body is a self-call by the
// projection's own contract, so walking it makes the operation its own callee, D13 joins the entry to
// itself, and the operation settles DemandDerived with an EMPTY resource set -- a host observation
// read as requiring nothing. That is a live fail-open, not a hypothetical: decl_facts settled exactly
// that way before this arm existed. A projected seam with no declaration row is RequiresUndeclared --
// the typed undeclared arm, which blocks; absence never defaults. (1) A declaration at or under a
// declared resource -- the resource itself or one of its capabilities -- demands that resource: a
// direct capability call is a reference to it. (2) An Arrow with no body edge is an operation, and
// its requirement is read from its ArrowResourceRequirementsEdge core edge; an absent edge is
// undeclared (D13 ruling B). (3) Anything else -- a fn, a data row, a type -- demands what its
// subtree refers to.
fn demand_fact_declaration(w: DemandFactWalk, path: QualifiedName, node: Node, resolved: ResolvedTree) -> DemandFactWalk {
  match demand_census_resource_prefix(index: resolved.symbol_index, path: path) {
    Present { value: declared } =>
      demand_fact_with_operation(w: w, op: OperationFact { path: path, requirement: RequiresResources { resources: [declared] } })
    Absent =>
      if demand_census_declaration_is_host_seam(path: path) {
        match operation_declaration_for(declaration: declaration_ref_of_qualified_name(path: path)) {
          Present { value: row } => demand_fact_with_declared_operation(w: w, op: OperationFact { path: path, requirement: row.requirement })
          Absent => demand_fact_with_operation(w: w, op: OperationFact { path: path, requirement: RequiresUndeclared })
        }
      } else if demand_census_is_operation_arrow(node: node) {
        demand_fact_with_declared_operation(w: w, op: OperationFact { path: path, requirement: demand_census_requirement(arrow: node) })
      } else {
        let start = DemandFactWalk { functions: w.functions, operations: w.operations, audited: w.audited, current: Empty, value_call: false, sites: Empty, bodies: w.bodies, tick: w.tick, groups: Empty }
        let inner = match demand_fact_repetition(node: node) {
          Present { value: LambdaInstantiationUnknown } =>
            fold(demand_fact_children(node: node), init: start, f: fn(acc, e) { demand_fact_edge(w: acc, position: path, edge: e, resolved: resolved) })
          _ => demand_fact_node(w: start, position: path, node: node, resolved: resolved)
        }
        DemandFactWalk {
          functions: list_snoc_item(xs: inner.functions, item: FunctionFact { path: path, callees: inner.current, calls_function_value: inner.value_call }),
          operations: inner.operations,
          audited: inner.audited,
          current: w.current,
          value_call: w.value_call,
          sites: w.sites,
          bodies: list_snoc_item(xs: inner.bodies, item: FactBodySites { function: path, sites: inner.sites, groups: inner.groups }),
          tick: inner.tick,
          groups: w.groups
        }
      }
  }
}

fn demand_fact_with_operation(w: DemandFactWalk, op: OperationFact) -> DemandFactWalk {
  DemandFactWalk { functions: w.functions, operations: list_snoc_item(xs: w.operations, item: op), audited: w.audited, current: w.current, value_call: w.value_call, sites: w.sites, bodies: w.bodies, tick: w.tick, groups: w.groups }
}

// THE SEAM TEST AND ITS KEY (D13 seam opacity, Condition A). The declaration is host-seamed when
// std.primitive_projection -- the one authority for "this declaration is host-realized" -- carries a
// row for it at HostRealizedSeam. The join is DECLARATION-IDENTICAL: the walked path's owning module
// segments become the DeclarationRef's module_path and its last segment the decl_name, so a seam
// resolves at its real module-qualified path (v2.std.decl_index.decl_facts) rather than by the bare
// slug string that never matched a walked operation. Both halves are the SAME std.decl_ref key the
// projection roster and v2.std.operation_declaration are keyed by.
fn demand_census_declaration_is_host_seam(path: QualifiedName) -> Bool {
  match primitive_projection_row_for_declaration(declaration: declaration_ref_of_qualified_name(path: path)) {
    Present { value: row } =>
      match row.fidelity {
        HostRealizedSeam => true
        ModeledProjection => false
        DivergentProjection { divergence: _ } => false
      }
    Absent => false
  }
}

// A DECLARED operation: its requirement is the authority the audited vocabulary is read from.
fn demand_fact_with_declared_operation(w: DemandFactWalk, op: OperationFact) -> DemandFactWalk {
  let with_op = demand_fact_with_operation(w: w, op: op)
  match op.requirement {
    RequiresResources { resources: rs } =>
      DemandFactWalk { functions: with_op.functions, operations: with_op.operations, audited: fold_list(xs: rs, empty: with_op.audited, cons: fn(a, r) { list_snoc_item(xs: a, item: r) }), current: with_op.current, value_call: with_op.value_call, sites: with_op.sites, bodies: with_op.bodies, tick: with_op.tick, groups: with_op.groups }
    RequiresNone => with_op
    RequiresOpaque => with_op
    RequiresUndeclared => with_op
  }
}

type DemandPrefixScan {
  prefix: QualifiedName
  declared: Optional<QualifiedName>
}

// The SHORTEST prefix that is a declared resource: a capability's path is under its resource.
fn demand_census_resource_prefix(index: SymbolIndex, path: QualifiedName) -> Optional<QualifiedName> {
  let scanned = fold_list(xs: path, empty: DemandPrefixScan { prefix: Empty, declared: optional_absent() }, cons: fn(scan, seg) {
    let prefix = qualified_name_snoc(qn: scan.prefix, segment: seg)
    match scan.declared {
      Present { value: r } => DemandPrefixScan { prefix: prefix, declared: optional_present(value: r) }
      Absent =>
        if symbol_index_declares_resource_at(index: index, qualified_path: prefix) {
          DemandPrefixScan { prefix: prefix, declared: optional_present(value: prefix) }
        } else {
          DemandPrefixScan { prefix: prefix, declared: optional_absent() }
        }
    }
  })
  scanned.declared
}

// The edge a core contract marker names, through v2.std.node edge_is_core. v2.std.node
// arrow_signature_edges_conform admits at most one of each on an Arrow, so the first is the only one.
// (v2.std.node core_edge_target_lookup answers the same question; its miss arm is NotFound,
// which this module's Optional matches already bind.)
fn demand_census_edge_target(children: List<Edge>, marker: CoreEdgeLabel) -> Optional<Node> {
  fold(children, init: optional_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => if edge_is_core(e: e, marker: marker) { optional_present(value: e.target) } else { acc }
    }
  })
}

// An operation is an Arrow with no body: the arrow test is the evaluator's (v2.compiler.eval
// eval_node_is_arrow) and the body read is v2.std.node_query find_arrow_body_child, never a local copy.
fn demand_census_is_operation_arrow(node: Node) -> Bool {
  if eval_node_is_arrow(node: node) {
    match find_arrow_body_child(root: node) {
      Accepted { value: _, diagnostics: _ } => false
      Rejected { diagnostics: _ } => true
    }
  } else {
    false
  }
}

fn demand_census_requirement_atom(id: Symbol) -> RequirementClass {
  if id == ^requirements_declared_none {
    RequiresNone
  } else if id == ^requirements_opaque {
    RequiresOpaque
  } else {
    RequiresUndeclared
  }
}

fn demand_census_requirement_members(t: Node) -> RequirementClass {
  RequiresResources {
    resources: fold(t.children, init: Empty, f: fn(acc, e) {
      match declaration_reference_path_optional(node: e.target) {
        Present { value: p } => list_snoc_item(xs: acc, item: p)
        Absent => acc
      }
    })
  }
}

// The requirements target after resolution: an Atom for `none` / `opaque`, a Conj of resolved resource
// references, or no edge at all (undeclared). Any other shape is refused by the pre-resolve wall
// (v2.std.arrow_contract arrow_resource_requirements_edge_target_reads), so it reads as undeclared.
fn demand_census_requirement(arrow: Node) -> RequirementClass {
  match demand_census_edge_target(children: arrow.children, marker: ArrowResourceRequirementsEdge) {
    Absent => RequiresUndeclared
    Present { value: t } =>
      match t.kind {
        TypeNode { connective: c } =>
          match c {
            Atom { identity: id } => demand_census_requirement_atom(id: id)
            Conj => demand_census_requirement_members(t: t)
            Disj => RequiresUndeclared
            Arrow => RequiresUndeclared
            Instantiation => RequiresUndeclared
          }
        ComputationNode { behavior: _ } => RequiresUndeclared
      }
  }
}

// A reference to a MEMBER of a declaration (a variant, a field path) depends on that declaration, so
// a callee the closure does not carry as its own fact is mapped to its LONGEST prefix that it does
// carry. A callee with no carried prefix stays as written and the reducer reads it as outside the
// closure.
fn demand_census_normalize_callees(functions: List<FunctionFact>, operations: List<OperationFact>) -> List<FunctionFact> {
  let known = fold_list(
    xs: operations,
    empty: fold_list(xs: functions, empty: empty_map(), cons: fn(m, f) { map_insert(m: m, key: f.path, value: true) }),
    cons: fn(m, o) { map_insert(m: m, key: o.path, value: true) }
  )
  fold_list(xs: functions, empty: Empty, cons: fn(acc, f) {
    list_snoc_item(xs: acc, item: FunctionFact {
      path: f.path,
      callees: fold_list(xs: f.callees, empty: Empty, cons: fn(cs, c) {
        list_snoc_item(xs: cs, item: demand_census_known_prefix(known: known, path: c))
      }),
      calls_function_value: f.calls_function_value
    })
  })
}

type DemandKnownScan {
  prefix: QualifiedName
  longest: Optional<QualifiedName>
}

fn demand_census_known_prefix(known: Map<QualifiedName, Bool>, path: QualifiedName) -> QualifiedName {
  let scanned = fold_list(xs: path, empty: DemandKnownScan { prefix: Empty, longest: optional_absent() }, cons: fn(scan, seg) {
    let prefix = qualified_name_snoc(qn: scan.prefix, segment: seg)
    match map_lookup(m: known, key: prefix) {
      Present { value: _ } => DemandKnownScan { prefix: prefix, longest: optional_present(value: prefix) }
      Absent => DemandKnownScan { prefix: prefix, longest: scan.longest }
    }
  })
  match scanned.longest {
    Present { value: p } => p
    Absent => path
  }
}

// ═══ THE AUTHORED SIDE, RESOLVED BY THE MODULE'S OWN SCOPE ═══════════════════════════════════════

type AuthoredRowReading
  = AuthoredResolved { declared: QualifiedName }
  | AuthoredTypeUnresolved

// The authored type is lowered by the same type lowering a parameter's type takes and resolved by the
// real resolver in the module's root scope, so `Network` under `import std.resources { Network }` and
// `std.resources.Network` both read as the declaration they name.
fn demand_census_authored_readings(ctx: ResolveContext, authored: AuthoredUsesFunction) -> List<AuthoredRowReading> {
  fold_list(xs: authored.types, empty: Empty, cons: fn(acc, shell) {
    list_snoc_item(xs: acc, item: demand_census_authored_reading(ctx: ctx, shell: shell))
  })
}

fn demand_census_authored_reading(ctx: ResolveContext, shell: Optional<Node>) -> AuthoredRowReading {
  match shell {
    Absent => AuthoredTypeUnresolved
    Present { value: s } =>
      match body_lower_type_expr_lowered_optional(node: s) {
        Absent => AuthoredTypeUnresolved
        Present { value: lowered } =>
          match resolve_node(ctx: resolve_ctx_with_reference_category(ctx: ctx, category: TypeOccurrence), n: lowered) {
            Rejected { diagnostics: _ } => AuthoredTypeUnresolved
            Accepted { value: r, diagnostics: _ } =>
              match declaration_reference_path_optional(node: r) {
                Present { value: p } => AuthoredResolved { declared: p }
                Absent => AuthoredTypeUnresolved
              }
          }
      }
  }
}

// ═══ THE ROW AND ITS VERDICT ═══════════════════════════════════════════════════════════════════

// Why a uses fn's demand was not observed: the fn's file refused in the front end even with the clause
// elided, the module refused at resolution (including a body that still names an elided uses alias),
// the fn's own name could not be read, an authored type did not resolve, or the uses aliases were
// duplicate or unreadable.
type DemandCensusUnboundLocus
  = UnboundNamed { name: Symbol }
  | UnboundShaped { kind: NodeKind, reference: Optional<QualifiedName> }

// THE CANONICAL SHAPED REFERENCE OF A COMPOSITE MENTION, derived once: the mention's own reference
// path, else its first positional child's (an instantiation's head, a list introduction's head).
// Census and CLI both render this; a second walk of the node would be a second authority.
fn demand_census_shaped_reference_optional(node: Node) -> Optional<QualifiedName> {
  match demand_census_reference_path_optional(node: node) {
    Present { value: p } => optional_present(value: p)
    Absent =>
      match list_at_optional(xs: positional_child_target_nodes(node: node), index: 0) {
        Absent => optional_absent()
        Present { value: head } => demand_census_reference_path_optional(node: head)
      }
  }
}

// A REFERENCE IN EITHER FORM A REFUSED MENTION CAN CARRY: the marked declaration reference (a
// compiler-generated head, or one resolve minted), or the qualified-name spine an AUTHORED qualified
// name is before resolve binds it (`std.algebra.FreeMonoid<T>` written in a type ascription). The
// census renders what the resolver refused, so it reads the pre-resolve spine as the path it spells;
// this reads a name, it binds nothing.
fn demand_census_reference_path_optional(node: Node) -> Optional<QualifiedName> {
  match declaration_reference_path_optional(node: node) {
    Present { value: p } => optional_present(value: p)
    Absent =>
      if qualified_name_spine_shape_present(root: node) {
        match qualified_name_from_node(root: node) {
          Accepted { value: qn, diagnostics: _ } => optional_present(value: qn)
          Rejected { diagnostics: _ } => optional_absent()
        }
      } else {
        optional_absent()
      }
  }
}

// WHAT IS UNBOUND, READ FROM THE FATAL THE RESOLVER ALREADY LOCATED. The diagnostic's NodeLocus
// carries the mention; this projects it onto the census carrier (atom identity, or the node's kind
// plus shaped reference when the mention is a composite). A second consumer that re-walked the
// node would be a second authority for the same fact (DESIGN section 3).
fn demand_census_unbound_locus_from_diagnostics(d: NonEmptyDiagnostics) -> Optional<DemandCensusUnboundLocus> {
  let fatal = diagnostics_fatal(d: d)
  if fatal.reason == ^resolve_reason_unbound_symbol {
    match fatal.at {
      NodeLocus { anchor: a } =>
        match node_atom_identity_optional(node: a.at) {
          Present { value: n } => optional_present(value: UnboundNamed { name: n })
          Absent =>
            optional_present(value: UnboundShaped {
              kind: a.at.kind,
              reference: demand_census_shaped_reference_optional(node: a.at)
            })
        }
      Textual { file: _, extent: _ } => optional_absent()
      SourcePortLocus { anchor: _, file: _, extent: _ } => optional_absent()
      InvariantPortLocus { anchor: _, invariant: _ } => optional_absent()
      DeclarationLocus { declaration: _ } => optional_absent()
    }
  } else {
    optional_absent()
  }
}

type DemandCensusUnobserved
  = UnobservedFileRefused
  | UnobservedModuleResolveRefused { first_reason: Symbol, first_unbound: Optional<DemandCensusUnboundLocus> }
  | UnobservedImporteeRefused { importee_file: Symbol, importee_cause: Symbol }
  | UnobservedFunctionUnnamed
  | UnobservedFunctionNotDeclared
  | UnobservedAuthoredTypeUnresolved
  | UnobservedAliasConflict
  | UnobservedAliasUnestablished

// A READ REFUSED BEFORE THE STRIP. Exit 2 names the file and the stage (tokenize vs parse) so an
// incomplete population is a located refusal, not an unlocated count (DESIGN section 5).
type DemandCensusUnreadableStage
  = UnreadableAtTokenize
  | UnreadableAtParse

type DemandCensusUnreadable {
  file_path: String
  stage: DemandCensusUnreadableStage
  reason: Symbol
}

type DemandCensusVerdict
  = CensusEqual
  | CensusMismatch { authored: List<QualifiedName>, derived: List<QualifiedName> }
  | CensusUndecided { cause: UndecidedCause }
  | CensusUnobserved { reason: DemandCensusUnobserved }

// THE STANDING IS PER AUTHORED ROW, and it is the only thing that licenses a deletion (review of
// gunbc#12992). A function's verdict is decided over the audited vocabulary only, so a function whose
// Network row restates its demand reads Equal even when it also authors Filesystem; a function-level
// Equal must never license deleting that Filesystem row. Each authored row therefore carries its own
// standing: RowDeletable only for an in-vocabulary resource of an Equal function, RowOutOfVocabulary for
// any resource no operation was audited to require -- whatever the function's verdict -- and the
// remaining arms name why an in-vocabulary row is not deletable.
type AuthoredRowStanding
  = RowDeletable { resource: QualifiedName }
  | RowMismatch { resource: QualifiedName }
  | RowOutOfVocabulary { resource: QualifiedName }
  | RowUndecided { resource: QualifiedName, cause: UndecidedCause }
  | RowUnobserved { resource: QualifiedName }
  | RowTypeUnresolved

type DemandCensusRow {
  function: QualifiedName
  authored: List<AuthoredRowReading>
  standings: List<AuthoredRowStanding>
  verdict: DemandCensusVerdict
  demand: Optional<DependencyDemand>
}

fn demand_census_row_standing(vocabulary: ResourceSet, verdict: DemandCensusVerdict, reading: AuthoredRowReading) -> AuthoredRowStanding {
  match reading {
    AuthoredTypeUnresolved => RowTypeUnresolved
    AuthoredResolved { declared: p } =>
      if resource_set_has(set: vocabulary, path: p) {
        match verdict {
          CensusEqual => RowDeletable { resource: p }
          CensusMismatch { authored: _, derived: _ } => RowMismatch { resource: p }
          CensusUndecided { cause: c } => RowUndecided { resource: p, cause: c }
          CensusUnobserved { reason: _ } => RowUnobserved { resource: p }
        }
      } else {
        RowOutOfVocabulary { resource: p }
      }
  }
}

fn demand_census_row_standings(vocabulary: ResourceSet, verdict: DemandCensusVerdict, readings: List<AuthoredRowReading>) -> List<AuthoredRowStanding> {
  fold_list(xs: readings, empty: Empty, cons: fn(acc, r) { list_snoc_item(xs: acc, item: demand_census_row_standing(vocabulary: vocabulary, verdict: verdict, reading: r)) })
}

// THE EXACT ROWS (b3) MAY DELETE, by identity: the function and the resource of every RowDeletable.
type DeletableUsesRow {
  function: QualifiedName
  resource: QualifiedName
}

fn demand_census_deletable(r: DemandCensusReport) -> List<DeletableUsesRow> {
  fold_list(xs: r.rows, empty: Empty, cons: fn(acc, row) {
    fold_list(xs: row.standings, empty: acc, cons: fn(a, st) {
      match st {
        RowDeletable { resource: p } => list_snoc_item(xs: a, item: DeletableUsesRow { function: row.function, resource: p })
        RowMismatch { resource: _ } => a
        RowOutOfVocabulary { resource: _ } => a
        RowUndecided { resource: _, cause: _ } => a
        RowUnobserved { resource: _ } => a
        RowTypeUnresolved => a
      }
    })
  })
}

fn demand_census_standing_text(st: AuthoredRowStanding) -> String {
  match st {
    RowDeletable { resource: p } => concat("deletable:", qualified_name_to_dotted_string(qn: p))
    RowMismatch { resource: p } => concat("mismatch:", qualified_name_to_dotted_string(qn: p))
    RowOutOfVocabulary { resource: p } => concat("out_of_vocabulary:", qualified_name_to_dotted_string(qn: p))
    RowUndecided { resource: p, cause: _ } => concat("undecided:", qualified_name_to_dotted_string(qn: p))
    RowUnobserved { resource: p } => concat("unobserved:", qualified_name_to_dotted_string(qn: p))
    RowTypeUnresolved => "type_unresolved"
  }
}

fn demand_census_in_vocabulary(vocabulary: ResourceSet, paths: List<QualifiedName>) -> List<QualifiedName> {
  fold_list(xs: paths, empty: Empty, cons: fn(acc, p) {
    if resource_set_has(set: vocabulary, path: p) { list_snoc_item(xs: acc, item: p) } else { acc }
  })
}

// Set equality through the keyed sets of v2.compiler.dependency_demand, never a member-by-member scan.
fn demand_census_same_set(left: List<QualifiedName>, right: List<QualifiedName>) -> Bool {
  let l = resource_set_of(paths: left)
  let r = resource_set_of(paths: right)
  (l.size == r.size) && fold_list(xs: l.members, empty: true, cons: fn(all, p) { all && resource_set_has(set: r, path: p) })
}

fn demand_census_authored_paths(readings: List<AuthoredRowReading>) -> List<QualifiedName> {
  fold_list(xs: readings, empty: Empty, cons: fn(acc, r) {
    match r {
      AuthoredResolved { declared: p } => list_snoc_item(xs: acc, item: p)
      AuthoredTypeUnresolved => acc
    }
  })
}

fn demand_census_has_unresolved(readings: List<AuthoredRowReading>) -> Bool {
  fold_list(xs: readings, empty: false, cons: fn(any, r) {
    match r {
      AuthoredResolved { declared: _ } => any
      AuthoredTypeUnresolved => true
    }
  })
}

fn demand_census_verdict(vocabulary: ResourceSet, readings: List<AuthoredRowReading>, demand: DependencyDemand) -> DemandCensusVerdict {
  let has_unresolved = demand_census_has_unresolved(readings: readings)
  if has_unresolved {
    CensusUnobserved { reason: UnobservedAuthoredTypeUnresolved }
  } else {
    match demand {
      DemandUndecided { cause: c } => CensusUndecided { cause: c }
      DemandDerived { resources: derived } =>
        let a = demand_census_in_vocabulary(vocabulary: vocabulary, paths: demand_census_authored_paths(readings: readings))
        let d = demand_census_in_vocabulary(vocabulary: vocabulary, paths: derived.members)
        if demand_census_same_set(left: a, right: d) {
          CensusEqual
        } else {
          CensusMismatch { authored: a, derived: d }
        }
    }
  }
}

fn demand_census_row_unobserved(function: QualifiedName, reason: DemandCensusUnobserved) -> DemandCensusRow {
  DemandCensusRow { function: function, authored: Empty, standings: Empty, verdict: CensusUnobserved { reason: reason }, demand: optional_absent() }
}

fn demand_census_function_path(authored: AuthoredUsesFunction) -> QualifiedName {
  match authored.name {
    Present { value: n } => qualified_name_snoc(qn: authored.owner, segment: n)
    Absent => authored.owner
  }
}

// ═══ THE REPORT ═══════════════════════════════════════════════════════════════════════════════

// `uses_functions` is counted from the strip; `rows` is what the route emitted. They are produced by
// different folds -- the strip over parse trees, the rows over the module roster -- so their equality
// is the count-conservation check rather than a restatement of one count.
// `unreadable` is the reads the front end refused BEFORE the strip ran (tokenize or parse): their
// `uses` rows were never read, so they are missing from BOTH sides of the conservation check, and a
// census with any of them is an INCOMPLETE POPULATION -- no observation, never a holding census
// (review of gunbc#12992).
type DemandCensusReport {
  vocabulary: ResourceSet
  unreadable: List<DemandCensusUnreadable>
  uses_functions: Int
  rows: List<DemandCensusRow>
  file_refusals: Int
  resolve_refused_modules: Int
}

fn demand_census_conserved(r: DemandCensusReport) -> Bool {
  r.uses_functions == length(xs: r.rows)
}

// THE CENSUS'S OWN EXIT: 2 when the population is incomplete (a read refused before authorship), 1 when
// the rows do not account for every uses fn read, 0 when it holds. The incomplete arm is first, so a
// census missing a file can never report held.
fn demand_census_exit(r: DemandCensusReport) -> Int {
  if !is_empty(xs: r.unreadable) {
    2
  } else if demand_census_conserved(r: r) {
    0
  } else {
    1
  }
}

fn demand_census_verdict_word(v: DemandCensusVerdict) -> String {
  match v {
    CensusEqual => "equal"
    CensusMismatch { authored: _, derived: _ } => "mismatch"
    CensusUndecided { cause: _ } => "undecided"
    CensusUnobserved { reason: _ } => "unobserved"
  }
}

fn demand_census_cause_word(c: UndecidedCause) -> String {
  match c {
    OpaqueOperationCalled { operation: _ } => "opaque_operation"
    UndeclaredOperationCalled { operation: _ } => "undeclared_operation"
    FunctionValueCalled { function: _ } => "function_value"
    CalleeOutsideClosure { callee: _ } => "callee_outside_closure"
    DemandDidNotSettle { function: _ } => "did_not_settle"
  }
}

fn demand_census_cause_subject(c: UndecidedCause) -> QualifiedName {
  match c {
    OpaqueOperationCalled { operation: p } => p
    UndeclaredOperationCalled { operation: p } => p
    FunctionValueCalled { function: p } => p
    CalleeOutsideClosure { callee: p } => p
    DemandDidNotSettle { function: p } => p
  }
}

fn demand_census_unobserved_word(u: DemandCensusUnobserved) -> String {
  match u {
    UnobservedFileRefused => "file_refused"
    UnobservedModuleResolveRefused { first_reason: _, first_unbound: _ } => "module_resolve_refused"
    UnobservedImporteeRefused { importee_file: _, importee_cause: _ } => "importee_refused"
    UnobservedFunctionUnnamed => "function_unnamed"
    UnobservedFunctionNotDeclared => "function_not_declared"
    UnobservedAuthoredTypeUnresolved => "authored_type_unresolved"
    UnobservedAliasConflict => "alias_conflict"
    UnobservedAliasUnestablished => "alias_unestablished"
  }
}

// THE COUNTS ARE A TALLY OVER THE VARIANTS, decided by matching each row's verdict and cause, never by
// comparing a printed word (review 74228 of gunbc#12992): a word is for printing only, and a count keyed
// on one would read 0, not refuse, after a typo or a rename.
type DemandCensusTally {
  equal: Int
  mismatch: Int
  undecided: Int
  unobserved: Int
  opaque_operation: Int
  undeclared_operation: Int
  function_value: Int
  callee_outside_closure: Int
  did_not_settle: Int
}

fn demand_census_tally_empty() -> DemandCensusTally {
  DemandCensusTally { equal: 0, mismatch: 0, undecided: 0, unobserved: 0, opaque_operation: 0, undeclared_operation: 0, function_value: 0, callee_outside_closure: 0, did_not_settle: 0 }
}

fn demand_census_tally_cause(t: DemandCensusTally, c: UndecidedCause) -> DemandCensusTally {
  match c {
    OpaqueOperationCalled { operation: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation + 1, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
    UndeclaredOperationCalled { operation: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation + 1, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
    FunctionValueCalled { function: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value + 1, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
    CalleeOutsideClosure { callee: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure + 1, did_not_settle: t.did_not_settle }
    DemandDidNotSettle { function: _ } =>
      DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided + 1, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle + 1 }
  }
}

fn demand_census_tally(rows: List<DemandCensusRow>) -> DemandCensusTally {
  fold_list(xs: rows, empty: demand_census_tally_empty(), cons: fn(t, r) {
    match r.verdict {
      CensusEqual =>
        DemandCensusTally { equal: t.equal + 1, mismatch: t.mismatch, undecided: t.undecided, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
      CensusMismatch { authored: _, derived: _ } =>
        DemandCensusTally { equal: t.equal, mismatch: t.mismatch + 1, undecided: t.undecided, unobserved: t.unobserved, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
      CensusUndecided { cause: c } => demand_census_tally_cause(t: t, c: c)
      CensusUnobserved { reason: _ } =>
        DemandCensusTally { equal: t.equal, mismatch: t.mismatch, undecided: t.undecided, unobserved: t.unobserved + 1, opaque_operation: t.opaque_operation, undeclared_operation: t.undeclared_operation, function_value: t.function_value, callee_outside_closure: t.callee_outside_closure, did_not_settle: t.did_not_settle }
    }
  })
}

fn demand_census_cause_line(word: String, n: Int) -> String {
  demand_census_text(parts: ["[demand-census-undecided] cause=", word, " functions=", to_string(n)])
}

fn demand_census_deletable_rows(r: DemandCensusReport) -> Int {
  length(xs: demand_census_deletable(r: r))
}

// OUT OF VOCABULARY, COUNTED PER RESOURCE: for each resource some row authors that no operation was
// audited to require, how many rows author it and how many of those fns' decided derived demand agrees.
// None of these rows is deletable by this census; the agreeing count sizes that resource's audit.
fn demand_census_out_of_vocabulary_resources(r: DemandCensusReport) -> ResourceSet {
  fold_list(xs: r.rows, empty: resource_set_empty(), cons: fn(acc, row) {
    fold_list(xs: demand_census_authored_paths(readings: row.authored), empty: acc, cons: fn(a, p) {
      if resource_set_has(set: r.vocabulary, path: p) { a } else { resource_set_add(set: a, path: p) }
    })
  })
}

fn demand_census_authoring(r: DemandCensusReport, resource: QualifiedName) -> Int {
  fold_list(xs: r.rows, empty: 0, cons: fn(n, row) {
    if resource_set_has(set: resource_set_of(paths: demand_census_authored_paths(readings: row.authored)), path: resource) { n + 1 } else { n }
  })
}

fn demand_census_derives(demand: Optional<DependencyDemand>, resource: QualifiedName) -> Bool {
  match demand {
    Absent => false
    Present { value: d } =>
      match d {
        DemandDerived { resources: rs } => resource_set_has(set: rs, path: resource)
        DemandUndecided { cause: _ } => false
      }
  }
}

fn demand_census_out_of_vocabulary_agreeing(r: DemandCensusReport, resource: QualifiedName) -> Int {
  fold_list(xs: r.rows, empty: 0, cons: fn(n, row) {
    if resource_set_has(set: resource_set_of(paths: demand_census_authored_paths(readings: row.authored)), path: resource) && demand_census_derives(demand: row.demand, resource: resource) { n + 1 } else { n }
  })
}

fn demand_census_out_of_vocabulary_line(r: DemandCensusReport, resource: QualifiedName) -> String {
  demand_census_text(parts: [
    "[demand-census-out-of-vocabulary] resource=", qualified_name_to_dotted_string(qn: resource),
    " rows=", to_string(demand_census_authoring(r: r, resource: resource)),
    " agreeing_functions=", to_string(demand_census_out_of_vocabulary_agreeing(r: r, resource: resource))
  ])
}

fn demand_census_paths_text(paths: List<QualifiedName>) -> String {
  fold_list(xs: paths, empty: "", cons: fn(acc, p) {
    if acc == "" { qualified_name_to_dotted_string(qn: p) } else { concat(acc, concat(",", qualified_name_to_dotted_string(qn: p))) }
  })
}

fn demand_census_row_line(r: DemandCensusRow) -> String {
  let head = demand_census_text(parts: [
    "[demand-census-row] function=", qualified_name_to_dotted_string(qn: r.function),
    " verdict=", demand_census_verdict_word(v: r.verdict),
    " authored=", demand_census_paths_text(paths: demand_census_authored_paths(readings: r.authored)),
    " rows=", fold_list(xs: r.standings, empty: "", cons: fn(acc, st) { if acc == "" { demand_census_standing_text(st: st) } else { concat(acc, concat(",", demand_census_standing_text(st: st))) } })
  ])
  match r.verdict {
    CensusEqual => head
    CensusMismatch { authored: _, derived: d } => demand_census_text(parts: [head, " derived_in_vocabulary=", demand_census_paths_text(paths: d)])
    CensusUndecided { cause: c } =>
      demand_census_text(parts: [head, " cause=", demand_census_cause_word(c: c), " at=", qualified_name_to_dotted_string(qn: demand_census_cause_subject(c: c))])
    CensusUnobserved { reason: u } =>
      let reason_part = demand_census_text(parts: [head, " reason=", demand_census_unobserved_word(u: u)])
      match u {
        UnobservedModuleResolveRefused { first_reason: r, first_unbound: u } =>
          demand_census_text(parts: [
            reason_part,
            " resolve_reason=", symbol_lexeme(sym: r),
            " ", demand_census_unbound_site_text(u: u)
          ])
        UnobservedImporteeRefused { importee_file: file, importee_cause: cause } =>
          demand_census_text(parts: [reason_part, " importee=", symbol_lexeme(sym: file), " importee_cause=", symbol_lexeme(sym: cause)])
        UnobservedFileRefused => reason_part
        UnobservedFunctionUnnamed => reason_part
        UnobservedFunctionNotDeclared => reason_part
        UnobservedAuthoredTypeUnresolved => reason_part
        UnobservedAliasConflict => reason_part
        UnobservedAliasUnestablished => reason_part
      }
  }
}

fn demand_census_conserved_word(r: DemandCensusReport) -> String {
  if demand_census_conserved(r: r) { "true" } else { "false" }
}

fn demand_census_text(parts: List<String>) -> String {
  fold_list(xs: parts, empty: "", cons: fn(acc, p) { concat(acc, p) })
}

fn demand_census_stage_word(s: DemandCensusUnreadableStage) -> String {
  match s {
    UnreadableAtTokenize => "tokenize"
    UnreadableAtParse => "parse"
  }
}

fn demand_census_unreadable_line(u: DemandCensusUnreadable) -> String {
  demand_census_text(parts: [
    "[demand-census-unreadable] file=", u.file_path,
    " stage=", demand_census_stage_word(s: u.stage),
    " reason=", symbol_lexeme(sym: u.reason)
  ])
}

type DemandCensusResolveRefusedBucket {
  reason: Symbol
  functions: Int
  examples: List<QualifiedName>
}

fn demand_census_bucket_has_example(examples: List<QualifiedName>, module: QualifiedName) -> Bool {
  fold_list(xs: examples, empty: false, cons: fn(any, e) { any || (e == module) })
}

fn demand_census_add_example(examples: List<QualifiedName>, module: QualifiedName) -> List<QualifiedName> {
  if length(xs: examples) >= 2 {
    examples
  } else if demand_census_bucket_has_example(examples: examples, module: module) {
    examples
  } else {
    list_snoc_item(xs: examples, item: module)
  }
}

fn demand_census_add_to_buckets(buckets: List<DemandCensusResolveRefusedBucket>, reason: Symbol, module: QualifiedName) -> List<DemandCensusResolveRefusedBucket> {
  let found = fold_list(xs: buckets, empty: false, cons: fn(any, b) { any || (b.reason == reason) })
  if found {
    fold_list(xs: buckets, empty: Empty, cons: fn(acc, b) {
      if b.reason == reason {
        list_snoc_item(xs: acc, item: DemandCensusResolveRefusedBucket {
          reason: b.reason,
          functions: b.functions + 1,
          examples: demand_census_add_example(examples: b.examples, module: module)
        })
      } else {
        list_snoc_item(xs: acc, item: b)
      }
    })
  } else {
    list_snoc_item(xs: buckets, item: DemandCensusResolveRefusedBucket { reason: reason, functions: 1, examples: [module] })
  }
}

fn demand_census_resolve_refused_buckets(rows: List<DemandCensusRow>) -> List<DemandCensusResolveRefusedBucket> {
  fold_list(xs: rows, empty: Empty, cons: fn(acc, row) {
    match row.verdict {
      CensusUnobserved { reason: UnobservedModuleResolveRefused { first_reason: r, first_unbound: _ } } =>
        demand_census_add_to_buckets(buckets: acc, reason: r, module: qualified_name_init(qn: row.function))
      CensusUnobserved { reason: _ } => acc
      CensusEqual => acc
      CensusMismatch { authored: _, derived: _ } => acc
      CensusUndecided { cause: _ } => acc
    }
  })
}

fn demand_census_resolve_refused_bucket_line(b: DemandCensusResolveRefusedBucket) -> String {
  demand_census_text(parts: [
    "[demand-census-resolve-refused] reason=", symbol_lexeme(sym: b.reason),
    " functions=", to_string(b.functions),
    " examples=", demand_census_paths_text(paths: b.examples)
  ])
}

fn demand_census_node_kind_word(k: NodeKind) -> String {
  match k {
    TypeNode { connective: Atom { identity: _ } } => "atom"
    TypeNode { connective: Conj } => "conj"
    TypeNode { connective: Disj } => "disj"
    TypeNode { connective: Arrow } => "arrow"
    TypeNode { connective: Instantiation } => "instantiation"
    ComputationNode { behavior: Value } => "value"
    ComputationNode { behavior: Transform } => "transform"
    ComputationNode { behavior: Branch } => "branch"
    ComputationNode { behavior: Loop } => "loop"
    ComputationNode { behavior: Bind } => "bind"
    ComputationNode { behavior: Match } => "match"
  }
}

fn demand_census_unbound_site_word(loc: DemandCensusUnboundLocus) -> String {
  match loc {
    UnboundNamed { name: n } => symbol_lexeme(sym: n)
    UnboundShaped { kind: k, reference: p } =>
      match p {
        Absent => demand_census_node_kind_word(k: k)
        Present { value: qn } => qualified_name_to_dotted_string(qn: qn)
      }
  }
}

fn demand_census_unbound_site_text(u: Optional<DemandCensusUnboundLocus>) -> String {
  match u {
    Absent => "unbound_locus="
    Present { value: loc } =>
      match loc {
        UnboundNamed { name: n } => demand_census_text(parts: ["unbound_name=", symbol_lexeme(sym: n)])
        UnboundShaped { kind: k, reference: p } =>
          match p {
            Absent => demand_census_text(parts: ["unbound_kind=", demand_census_node_kind_word(k: k)])
            Present { value: qn } => demand_census_text(parts: ["unbound_ref=", qualified_name_to_dotted_string(qn: qn)])
          }
      }
  }
}

type DemandCensusUnboundBucket {
  site: DemandCensusUnboundLocus
  functions: Int
  examples: List<QualifiedName>
}

fn demand_census_unbound_locus_eq(a: DemandCensusUnboundLocus, b: DemandCensusUnboundLocus) -> Bool {
  match a {
    UnboundNamed { name: na } =>
      match b {
        UnboundNamed { name: nb } => na == nb
        UnboundShaped { kind: _, reference: _ } => false
      }
    UnboundShaped { kind: ka, reference: pa } =>
      match b {
        UnboundNamed { name: _ } => false
        UnboundShaped { kind: kb, reference: pb } =>
          (ka == kb)
            && match pa {
              Absent => match pb { Absent => true Present { value: _ } => false }
              Present { value: a } =>
                match pb {
                  Absent => false
                  Present { value: b } => a == b
                }
            }
      }
  }
}

fn demand_census_add_to_unbound_buckets(buckets: List<DemandCensusUnboundBucket>, site: DemandCensusUnboundLocus, module: QualifiedName) -> List<DemandCensusUnboundBucket> {
  let found = fold_list(xs: buckets, empty: false, cons: fn(any, b) { any || demand_census_unbound_locus_eq(a: b.site, b: site) })
  if found {
    fold_list(xs: buckets, empty: Empty, cons: fn(acc, b) {
      if demand_census_unbound_locus_eq(a: b.site, b: site) {
        list_snoc_item(xs: acc, item: DemandCensusUnboundBucket {
          site: b.site,
          functions: b.functions + 1,
          examples: demand_census_add_example(examples: b.examples, module: module)
        })
      } else {
        list_snoc_item(xs: acc, item: b)
      }
    })
  } else {
    list_snoc_item(xs: buckets, item: DemandCensusUnboundBucket { site: site, functions: 1, examples: [module] })
  }
}

fn demand_census_unbound_buckets(rows: List<DemandCensusRow>) -> List<DemandCensusUnboundBucket> {
  fold_list(xs: rows, empty: Empty, cons: fn(acc, row) {
    match row.verdict {
      CensusUnobserved { reason: UnobservedModuleResolveRefused { first_reason: _, first_unbound: Present { value: loc } } } =>
        demand_census_add_to_unbound_buckets(buckets: acc, site: loc, module: qualified_name_init(qn: row.function))
      CensusUnobserved { reason: _ } => acc
      CensusEqual => acc
      CensusMismatch { authored: _, derived: _ } => acc
      CensusUndecided { cause: _ } => acc
    }
  })
}

fn demand_census_unbound_bucket_line(b: DemandCensusUnboundBucket) -> String {
  demand_census_text(parts: [
    "[demand-census-unbound] site=", demand_census_unbound_site_word(loc: b.site),
    " functions=", to_string(b.functions),
    " examples=", demand_census_paths_text(paths: b.examples)
  ])
}

fn demand_census_lines(r: DemandCensusReport) -> List<String> {
  let tally = demand_census_tally(rows: r.rows)
  let head = demand_census_text(parts: [
    "[demand-census] vocabulary=", demand_census_paths_text(paths: r.vocabulary.members),
    " uses_functions=", to_string(r.uses_functions),
    " rows=", to_string(length(xs: r.rows)),
    " conserved=", demand_census_conserved_word(r: r),
    " equal=", to_string(tally.equal),
    " mismatch=", to_string(tally.mismatch),
    " undecided=", to_string(tally.undecided),
    " unobserved=", to_string(tally.unobserved),
    " deletable_rows=", to_string(demand_census_deletable_rows(r: r)),
    " file_refusals=", to_string(r.file_refusals),
    " unreadable_files=", to_string(length(xs: r.unreadable)),
    " resolve_refused_modules=", to_string(r.resolve_refused_modules)
  ])
  let causes = [
    head,
    demand_census_cause_line(word: "opaque_operation", n: tally.opaque_operation),
    demand_census_cause_line(word: "undeclared_operation", n: tally.undeclared_operation),
    demand_census_cause_line(word: "function_value", n: tally.function_value),
    demand_census_cause_line(word: "callee_outside_closure", n: tally.callee_outside_closure),
    demand_census_cause_line(word: "did_not_settle", n: tally.did_not_settle)
  ]
  let with_unreadable = fold_list(xs: r.unreadable, empty: causes, cons: fn(acc, u) { list_snoc_item(xs: acc, item: demand_census_unreadable_line(u: u)) })
  let with_reasons = fold_list(xs: demand_census_resolve_refused_buckets(rows: r.rows), empty: with_unreadable, cons: fn(acc, b) { list_snoc_item(xs: acc, item: demand_census_resolve_refused_bucket_line(b: b)) })
  let with_unbound = fold_list(xs: demand_census_unbound_buckets(rows: r.rows), empty: with_reasons, cons: fn(acc, b) { list_snoc_item(xs: acc, item: demand_census_unbound_bucket_line(b: b)) })
  let with_vocabulary = fold_list(xs: demand_census_out_of_vocabulary_resources(r: r).members, empty: with_unbound, cons: fn(acc, p) { list_snoc_item(xs: acc, item: demand_census_out_of_vocabulary_line(r: r, resource: p)) })
  fold_list(xs: r.rows, empty: with_vocabulary, cons: fn(acc, row) { list_snoc_item(xs: acc, item: demand_census_row_line(r: row)) })
}

// ═══ JOINING THE CLOSURE ════════════════════════════════════════════════════════════════════════

// Per module, what the route observed. The authored functions of a module ride with its standing,
// so every one of them becomes exactly one row whatever the standing is.
type DemandCensusModuleStanding
  = DemandModuleResolved { readings: List<DemandCensusAuthoredReading> }
  | DemandModuleResolveRefused { authored: List<AuthoredUsesFunction>, first_reason: Symbol, first_unbound: Optional<DemandCensusUnboundLocus> }
  | DemandModuleImporteeRefused { authored: List<AuthoredUsesFunction>, importee_file: Symbol, importee_cause: Symbol }

type DemandCensusAuthoredReading {
  authored: AuthoredUsesFunction
  readings: List<AuthoredRowReading>
}

// The whole-closure reduction. `functions`/`operations` are every resolved module's facts; each
// standing yields its authored functions' rows; `file_refused` are the authored functions of files the
// front end refused with the clause elided.
fn demand_census_report(
  uses_functions: Int,
  functions: List<FunctionFact>,
  operations: List<OperationFact>,
  audited: List<QualifiedName>,
  standings: List<DemandCensusModuleStanding>,
  file_refused: List<AuthoredUsesFunction>,
  file_refusals: Int,
  unreadable: List<DemandCensusUnreadable>
) -> DemandCensusReport {
  let demand_rows = dependency_demand_of(functions: demand_census_normalize_callees(functions: functions, operations: operations), operations: operations)
  let demand = fold_list(xs: demand_rows, empty: empty_map(), cons: fn(m, r) { map_insert(m: m, key: r.function, value: r.demand) })
  let vocabulary = resource_set_of(paths: audited)
  let resolved_rows = fold_list(xs: standings, empty: Empty, cons: fn(acc, s) {
    match s {
      DemandModuleResolveRefused { authored: fs, first_reason: reason, first_unbound: unbound } =>
        fold_list(xs: fs, empty: acc, cons: fn(a, f) {
          list_snoc_item(xs: a, item: demand_census_row_unobserved(function: demand_census_function_path(authored: f), reason: demand_census_alias_or_module_unobserved(authored: f, first_reason: reason, first_unbound: unbound)))
        })
      DemandModuleImporteeRefused { authored: fs, importee_file: file, importee_cause: cause } =>
        fold_list(xs: fs, empty: acc, cons: fn(a, f) {
          list_snoc_item(xs: a, item: demand_census_row_unobserved(function: demand_census_function_path(authored: f), reason: demand_census_alias_or_importee_unobserved(authored: f, importee_file: file, importee_cause: cause)))
        })
      DemandModuleResolved { readings: rs } =>
        fold_list(xs: rs, empty: acc, cons: fn(a, r) { list_snoc_item(xs: a, item: demand_census_resolved_row(vocabulary: vocabulary, reading: r, demand: demand)) })
    }
  })
  DemandCensusReport {
    vocabulary: vocabulary,
    unreadable: unreadable,
    uses_functions: uses_functions,
    rows: fold_list(xs: file_refused, empty: resolved_rows, cons: fn(a, f) {
      list_snoc_item(xs: a, item: demand_census_row_unobserved(function: demand_census_function_path(authored: f), reason: UnobservedFileRefused))
    }),
    file_refusals: file_refusals,
    resolve_refused_modules: fold_list(xs: standings, empty: 0, cons: fn(n, s) {
      match s {
        DemandModuleResolveRefused { authored: _, first_reason: _, first_unbound: _ } => n + 1
        DemandModuleImporteeRefused { authored: _, importee_file: _, importee_cause: _ } => n + 1
        DemandModuleResolved { readings: _ } => n
      }
    })
  }
}

fn demand_census_alias_or_module_unobserved(authored: AuthoredUsesFunction, first_reason: Symbol, first_unbound: Optional<DemandCensusUnboundLocus>) -> DemandCensusUnobserved {
  match authored.alias_bind {
    UsesAliasBindConflict => UnobservedAliasConflict
    UsesAliasBindUnestablished => UnobservedAliasUnestablished
    UsesAliasBindUnique => UnobservedModuleResolveRefused { first_reason: first_reason, first_unbound: first_unbound }
  }
}

// THE ROOT, NOT THE SYMPTOM: a module whose import target the context refused at ingest finds every
// imported name unbound only because the target's declarations never entered the index, so its rows file
// the refused importee (v2.compiler.compile native_import_target_attribution decides it), not an unbound.
fn demand_census_alias_or_importee_unobserved(authored: AuthoredUsesFunction, importee_file: Symbol, importee_cause: Symbol) -> DemandCensusUnobserved {
  match authored.alias_bind {
    UsesAliasBindConflict => UnobservedAliasConflict
    UsesAliasBindUnestablished => UnobservedAliasUnestablished
    UsesAliasBindUnique => UnobservedImporteeRefused { importee_file: importee_file, importee_cause: importee_cause }
  }
}

fn demand_census_resolved_row(vocabulary: ResourceSet, reading: DemandCensusAuthoredReading, demand: Map<QualifiedName, DependencyDemand>) -> DemandCensusRow {
  let path = demand_census_function_path(authored: reading.authored)
  match reading.authored.alias_bind {
    UsesAliasBindConflict => demand_census_row_unobserved(function: path, reason: UnobservedAliasConflict)
    UsesAliasBindUnestablished => demand_census_row_unobserved(function: path, reason: UnobservedAliasUnestablished)
    UsesAliasBindUnique =>
      match reading.authored.name {
        Absent => demand_census_row_unobserved(function: path, reason: UnobservedFunctionUnnamed)
        Present { value: _ } =>
          match map_lookup(m: demand, key: path) {
            Absent => demand_census_row_unobserved(function: path, reason: UnobservedFunctionNotDeclared)
            Present { value: d } =>
              let verdict = demand_census_verdict(vocabulary: vocabulary, readings: reading.readings, demand: d)
              DemandCensusRow {
                function: path,
                authored: reading.readings,
                standings: demand_census_row_standings(vocabulary: vocabulary, verdict: verdict, readings: reading.readings),
                verdict: verdict,
                demand: optional_present(value: d)
              }
          }
      }
  }
}
