// Scope: REVERSE backfill-roster soundness — every entry in the frozen
//   external_authority_backfill_pending.txt roster must correspond to a LIVE extdeps module.
//   The forward live witness (live_anchored_modules_clean) proves every live module is anchored
//   OR backfill-pending; THIS proves the converse — every backfill ENTRY still names a live
//   module. A STALE entry (a module deleted/renamed while its "pending" line lingers) keeps a
//   DEAD excuse: it lies about the shrinking backfill AND silently re-excuses a future
//   re-added-unanchored module at that path (the forward gate would see it backfill-pending and
//   pass it → §5 fail-open). The forward gate cannot catch this: it iterates LIVE modules, so a
//   .txt entry with no live module is never visited.
//
//   Frozen roster = extdeps_external_authority_backfill_entries (the .txt, host-read). Independent
//   live enumeration = extdeps_derived_extdeps_modules (the module-path index). Discriminating by
//   EXECUTION: a planted bogus entry (a QN with no live module) appended to the REAL roster reds
//   against the real live set — NOT a string-vs-its-own-substring tautology. (The QN is checked
//   for live membership against the independent host enumeration.)

module v2.test.extdeps_external_authority.corpus.backfill_roster_soundness

import v2.std.algebra { any, for_all, list_append }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.qualified_name { QnCons, QnEmpty, QualifiedName }

// A QN for a module that does not exist in the live extdeps tree — the planted-stale entry.
data planted_stale_backfill_entry: QualifiedName = QnCons {
  head: ^extdeps,
  tail: QnCons { head: ^nonexistent_planted_backfill_module, tail: QnEmpty }
}

fn qn_list_contains(xs: List<QualifiedName>, target: QualifiedName) -> Bool {
  any(xs: xs, predicate: fn(m) { m == target })
}

// Every entry in `roster` must be a live extdeps module (membership in the independent scan).
fn backfill_roster_sound(roster: List<QualifiedName>, live: List<QualifiedName>) -> Bool {
  for_all(xs: roster, predicate: fn(entry) { qn_list_contains(xs: live, target: entry) })
}

// Discriminating control (planted-stale → RED, asserted true-when-correct so discovery-safe):
// appending a bogus QN (no live module) to the REAL roster makes soundness reject. This is the
// non-vacuity tooth — a live set that "contained everything", or a membership that always held,
// would let the planted entry pass and flip this RED.
test fn extdeps_external_authority_backfill_roster_planted_stale_red_holds() -> Bool {
  backfill_roster_sound(
    roster: list_append(
      left: extdeps_external_authority_backfill_entries(),
      right: [planted_stale_backfill_entry]
    ),
    live: extdeps_derived_extdeps_modules()
  ) == false
}

// By-execution gate: the REAL frozen .txt roster must be SOUND against the independent live
// module enumeration — every backfill entry still names a live extdeps module — AND the
// planted-stale control must be detected (non-vacuity bundled in, true-when-correct).
test fn extdeps_external_authority_backfill_roster_soundness_holds() -> Bool {
  backfill_roster_sound(
    roster: extdeps_external_authority_backfill_entries(),
    live: extdeps_derived_extdeps_modules()
  )
    && extdeps_external_authority_backfill_roster_planted_stale_red_holds()
}
