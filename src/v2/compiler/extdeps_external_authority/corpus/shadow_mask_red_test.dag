module v2.test.extdeps_external_authority.corpus.shadow_mask_red

import v2.lens.extdeps_external_authority { extdeps_external_authority_anchor_shadow_masked }
import v2.lens.extdeps_external_authority.module_refs { extdeps_fixture_shadow_masked_module }
import v2.std.logic { Bool }

test fn extdeps_external_authority_shadow_mask_fixture_red_holds() -> Bool {
  extdeps_external_authority_anchor_shadow_masked(
    module: extdeps_fixture_shadow_masked_module
  )
}

test fn extdeps_external_authority_live_shadow_mask_clean_holds() -> Bool {
  extdeps_external_authority_live_shadow_mask_holds()
    && extdeps_external_authority_shadow_mask_fixture_red_holds()
}
