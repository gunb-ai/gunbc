module v2.compiler.emit_module


data emit_module_decl_separator: String = "\n\n"

fn emit_module_append_decl(
  partial: String,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.emit.emit(tree: tree, target: target),
    f: fn(medium) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.std.algebra.list_append(
          left: v2.std.algebra.list_append(left: partial, right: medium.carried),
          right: emit_module_decl_separator
        )
      )
    }
  )
}

fn emit_module_step(
  acc: v2.std.diagnostic.Outcome<String>,
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: acc,
    f: fn(partial) {
      emit_module_append_decl(partial: partial, tree: tree, target: target)
    }
  )
}

fn emit_module_text(decls: List<v2.compiler.inferred_tree.InferredTree>, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<String> {
  v2.std.algebra.fold_list(
    xs: decls,
    empty: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, tree) {
      emit_module_step(acc: acc, tree: tree, target: target)
    }
  )
}

fn emit_module(decls: List<v2.compiler.inferred_tree.InferredTree>, target: v2.std.compilers.target_model.TargetModel) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: emit_module_text(decls: decls, target: target),
    f: fn(joined) {
      v2.compiler.target_carriers.target_source_medium(text: joined, target: target)
    }
  )
}

data emit_family_note: String = "Family-grain source producer (std.emit_on_demand witness_family_build_grain_ruling): one crate per witness FAMILY, not per witness. emit_module emits N decls under ONE target model; a witness family's members each carry their OWN target model (per-member translation rows), so emit_family folds emit(member.tree, member.target) into one concatenated source. The transport target (the family dispatcher descriptor) owns the resulting medium — it is a parameter, not a member fact."

type EmitFamilyMember {
  tree: v2.compiler.inferred_tree.InferredTree,
  target: v2.std.compilers.target_model.TargetModel
}

fn emit_family_append_member(
  partial: String,
  member: EmitFamilyMember
) -> v2.std.diagnostic.Outcome<String> {
  v2.std.diagnostic.bind_outcome(
    o: v2.compiler.emit.emit(tree: member.tree, target: member.target),
    f: fn(medium) {
      v2.std.diagnostic.outcome_accepted(
        value: v2.std.algebra.list_append(
          left: v2.std.algebra.list_append(left: partial, right: medium.carried),
          right: emit_module_decl_separator
        )
      )
    }
  )
}

fn emit_family_text(members: List<EmitFamilyMember>) -> v2.std.diagnostic.Outcome<String> {
  v2.std.algebra.fold_list(
    xs: members,
    empty: v2.std.diagnostic.Accepted { value: std.algebra.Empty, diagnostics: v2.std.diagnostic.None },
    cons: fn(acc, member) {
      v2.std.diagnostic.bind_outcome(
        o: acc,
        f: fn(partial) {
          emit_family_append_member(partial: partial, member: member)
        }
      )
    }
  )
}

fn emit_family(
  members: List<EmitFamilyMember>,
  transport_target: v2.std.compilers.target_model.TargetModel
) -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  v2.std.diagnostic.bind_outcome(
    o: emit_family_text(members: members),
    f: fn(joined) {
      v2.compiler.target_carriers.target_source_medium(text: joined, target: transport_target)
    }
  )
}
