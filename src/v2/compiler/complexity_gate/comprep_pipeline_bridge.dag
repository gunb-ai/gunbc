// Scope: shared tokenize→parse→normalize→resolve bridge for COMPREP test-subject producers.
//        Single authority for the pipeline chain; per-fn producers pass their GrammarRoot +
//        production_name and call comprep_source_resolved_root to obtain the resolved Arrow Node.
// Consumers: wave-1 subject producers (can migrate), D2 rewrite-rule test-subject producers.
// Design: DESIGN.md §2 horizontal — one pipeline path, derived per subject (not forked per fn).
// Hardwired: dag_language_model_wave1 (MVP1 .dag surface). New media → new bridge or param.

module v2.test.complexity_gate.comprep_pipeline_bridge

import v2.compiler.normalize { normalize }
import v2.compiler.parse { ValidatedGrammarRoot, grammar_validate_for_parse, parse_production_tree }
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_language_model_wave1 }
import v2.std.collection { List }
import v2.std.compilers.lexing { Token }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, port_locus }
import v2.std.grammar { GrammarRoot, ParseTree }
import v2.std.node { Node, Symbol }
import v2.std.text { String }


// Run the four-stage comprep pipeline on a source snippet:
//   tokenize → validate+parse (parse_root, production_name) → normalize → resolve
// Returns the resolved Arrow Node, ready for body extraction by the caller.
//
// file: diagnostic locus symbol — callers pass their own (e.g. ^d2_nested_slow_form_file).
// parse_root / production_name: the grammar this snippet is parsed under — callers construct.
// Grammar validation is fail-closed before any tokenize work.
fn comprep_source_resolved_root(
  source_text: String,
  parse_root: GrammarRoot,
  production_name: Symbol,
  file: Symbol
) -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  match grammar_validate_for_parse(
    root: parse_root,
    at: port_locus(port: ^comprep_pipeline_bridge_grammar_locus)
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: validated, diagnostics: _ } =>
      bind_outcome(
        o: tokenize(text: source_text, file: file, rules: lm.lex),
        f: fn(token_stream) {
          bind_outcome(
            o: parse_production_tree(
              tokens: token_stream.tokens,
              validated: validated,
              production_name: production_name
            ),
            f: fn(parsed) {
              bind_outcome(
                o: normalize(parse_tree: parsed),
                f: fn(normalized) {
                  resolve(tree: normalized, lm: lm)
                }
              )
            }
          )
        }
      )
  }
}
