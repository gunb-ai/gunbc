// Scope: complexity-gate S1b — declared ComplexityBound budget rows (should-be side).
//        Each row pairs a static subject-producer fn (-> Outcome<Node>) with its declared
//        ComplexityBound. No function-name strings (runtime name-keyed lookup banned).
// Budget semantics: when subject_producer yields an Arrow-with-body, the declared budget
//        bounds the complexity of the arrow's BODY (gate rows extract via the canonical
//        arrow_body_target_lookup accessor — std/node.dag — before cost_lens / complexity_lens).
//        Do not declare a bound thinking it covers a whole-arrow fold.
// Coverage: subject reach = COMPREP grammar coverage (design-lens-subject-supply.md §3).
//        Wave-1 today: source-bridged add / bind / branch / loop (COMPREP wave-1 producers).
//        02_parse compiler-stage bodies arrive with COMPREP waves 2+ / self-host breadth;
//        until a producer lands, do not add name-keyed placeholder rows — new rows attach
//        when the §2 subject-producer composition exists. Rate every producer before the
// Consumer: gate rows import named rows from this roster (not inline budgets).
// Status: roster authority; S2 family gate folds complexity_subject_budget_rows.
// Anchor: docs/design-lens-subject-supply.md §5 + v2.lens.complexity ComplexityBound.

module v2.test.complexity_gate.subject_complexity_budget_roster

import v2.lens.complexity {
  ComplexityBound,
  ConstantComplexity,
  linear_complexity,
  unknown_complexity
}
import v2.lens.cost { SizeVariable }
import v2.std.cardinality { loop_bound_measure, loop_bound_witness_for_node }
import v2.std.collection { List }
import v2.std.diagnostic { Outcome }
import v2.std.node { Node }
import v2.std.witness { Holds, Violates }
import v2.test.complexity_gate.comprep_wave1_add_subject_producer {
  comprep_source_bridged_add_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_bind_subject_producer {
  comprep_source_bridged_bind_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_branch_subject_producer {
  comprep_source_bridged_pick_if_arrow_with_body
}
import v2.test.complexity_gate.comprep_wave1_loop_subject_producer {
  comprep_source_bridged_loop_arrow_with_body
}

type LensSubjectComplexityBudgetRow {
  subject_producer: fn() -> Outcome<Node>
  declared_budget: fn(Node) -> ComplexityBound
}

fn complexity_declared_budget_for_row(
  row: LensSubjectComplexityBudgetRow,
  body: Node
) -> ComplexityBound {
  row.declared_budget(body: body)
}

fn complexity_declared_budget_constant(_body: Node) -> ComplexityBound {
  ConstantComplexity
}

fn complexity_declared_budget_loop_linear(body: Node) -> ComplexityBound {
  match loop_bound_witness_for_node(n: body) {
    Holds { value: bound } =>
      linear_complexity(
        size_var: SizeVariable { source: loop_bound_measure(bound: bound) }
      )
    Violates { diagnostic: _ } => unknown_complexity()
  }
}

// Wave-1 COMPREP keystone: tokenize→parse→normalize→resolve→body_producer over dag_mvp1_source_text.
data complexity_budget_row_comprep_source_bridged_add: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: comprep_source_bridged_add_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_comprep_source_bridged_bind: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: comprep_source_bridged_bind_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_comprep_source_bridged_branch: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: comprep_source_bridged_pick_if_arrow_with_body,
  declared_budget: complexity_declared_budget_constant
}

data complexity_budget_row_comprep_source_bridged_loop: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: comprep_source_bridged_loop_arrow_with_body,
  declared_budget: complexity_declared_budget_loop_linear
}

data complexity_subject_budget_rows: List<LensSubjectComplexityBudgetRow> = [
  complexity_budget_row_comprep_source_bridged_add,
  complexity_budget_row_comprep_source_bridged_bind,
  complexity_budget_row_comprep_source_bridged_branch,
  complexity_budget_row_comprep_source_bridged_loop
]
