// Scope: complexity-gate S1a exemplar — source-bridged COMPREP wave-1 `add` body as lens subject.
// Status: discoverable `test fn` witness — CI floor gates it via claim_batch
//         --roster-from-discovery (`test fn` in `*_test.dag` scanned across src/v2).
//         (Was a `fn` that the dead lens_ci_gate.dag roster named but never ran.)
// S2: roster row + shared lens_subject_body_supply hoist; §6 semantic red kept here (family gate subsumes dominance only).

module v2.test.complexity_gate.source_bridged_add_budget

import v2.lens.complexity {
  ConstantComplexity,
  complexity_bound_dominates,
  complexity_lens,
  linear_complexity
}
import v2.lens.cost { SizeVariable, cost_lens }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.witness { Holds }
import v2.test.complexity_gate.lens_subject_body_supply {
  lens_subject_arrow_body_for_budget_row
}
import v2.test.complexity_gate.subject_complexity_budget_roster {
  LensSubjectComplexityBudgetRow,
  complexity_budget_row_comprep_source_bridged_add,
  complexity_declared_budget_for_row
}

fn source_bridged_add_cost_lens_holds(body: Node) -> Bool {
  match cost_lens(n: body) {
    Holds { value: _ } => true
    _ => false
  }
}

// Design §6: a deliberately too-tight declared class must fail dominance (lattice red).
fn source_bridged_add_tightened_budget_fails_dominance(
  body: Node,
  row: LensSubjectComplexityBudgetRow
) -> Bool {
  match complexity_lens(n: body) {
    Holds { value: computed } =>
      !complexity_bound_dominates(
        a: ConstantComplexity,
        b: linear_complexity(size_var: SizeVariable { source: body })
      )
      && complexity_bound_dominates(
        a: complexity_declared_budget_for_row(row: row),
        b: computed
      )
    _ => false
  }
}

// By-execution gate: the real source-bridged `add` body costs (cost_lens Holds),
// its declared ConstantComplexity budget dominates the computed class, AND a
// too-tight constant budget does NOT dominate a linear class (over-budget → RED,
// the §6 lattice control). Discoverable, so this actually fires in CI.
test fn source_bridged_add_budget_claim_holds() -> Bool {
  let row = complexity_budget_row_comprep_source_bridged_add
  match lens_subject_arrow_body_for_budget_row(row: row) {
    Accepted { value: body, diagnostics: _ } =>
      source_bridged_add_cost_lens_holds(body: body)
        && source_bridged_add_tightened_budget_fails_dominance(body: body, row: row)
    Rejected { diagnostics: _ } => false
  }
}
