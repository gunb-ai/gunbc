module v2.test.complexity_gate.lens_subject_body_supply

import v2.std.diagnostic { Outcome, bind_outcome }
import v2.std.node { Node }
import v2.std.node_query { find_arrow_body_child }
import v2.test.complexity_gate.subject_complexity_budget_roster {
  LensSubjectComplexityBudgetRow
}

fn lens_subject_arrow_body_for_budget_row(
  row: LensSubjectComplexityBudgetRow
) -> Outcome<Node> {
  bind_outcome(
    o: row.subject_producer(),
    f: fn(arrow) {
      find_arrow_body_child(root: arrow)
    }
  )
}
