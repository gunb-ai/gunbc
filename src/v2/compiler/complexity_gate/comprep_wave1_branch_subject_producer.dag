module v2.test.complexity_gate.comprep_wave1_branch_subject_producer

import v2.compiler.body_producer { produce_mvp1_pick_if_arrow_with_body_from_resolved }
import v2.compiler.normalize { normalize }
import v2.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
}
import v2.compiler.resolve { resolve }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_formal_production_mvp1_fn_pick,
  dag_grammar_production_mvp1_fn_pick,
  dag_language_model_wave1,
  dag_mvp1_pick_false_source_text,
  dag_mvp1_pick_source_text
}
import v2.std.collection { List, Set }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, port_locus }
import v2.std.grammar { GrammarRoot, ParseTree }
import v2.std.compilers.lexing { Token }
import v2.std.node { Node, Symbol }

fn comprep_wave1_branch_parse_root() -> GrammarRoot {
  GrammarRoot {
    start: ^dag_production_mvp1_fn_pick,
    productions: [dag_grammar_production_mvp1_fn_pick()],
    sync_tokens: Set {
      member: fn(_) {
        false
      }
    }
  }
}

fn comprep_wave1_branch_parse_tokens(tokens: List<Token>) -> Outcome<ParseTree> {
  let root = comprep_wave1_branch_parse_root()
  match grammar_validate_for_parse(root: root, at: port_locus(port: ^parse_stage_locus_port)) {
    Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: tokens,
        validated: validated,
        production_name: ^dag_production_mvp1_fn_pick
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn comprep_source_resolved_pick_arrow_from_text(source_text: String) -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(
      text: source_text,
      file: ^comprep_wave1_branch_subject_source_file,
      rules: lm.lex
    ),
    f: fn(tokens) {
      bind_outcome(
        o: comprep_wave1_branch_parse_tokens(tokens: tokens.tokens),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn comprep_source_resolved_pick_arrow() -> Outcome<Node> {
  comprep_source_resolved_pick_arrow_from_text(source_text: dag_mvp1_pick_source_text)
}

fn comprep_source_resolved_pick_false_arrow() -> Outcome<Node> {
  comprep_source_resolved_pick_arrow_from_text(source_text: dag_mvp1_pick_false_source_text)
}

fn comprep_source_bridged_pick_if_arrow_with_body_from_resolved(
  resolved: Node
) -> Outcome<Node> {
  produce_mvp1_pick_if_arrow_with_body_from_resolved(resolved_root: resolved)
}

fn comprep_source_bridged_pick_if_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: comprep_source_resolved_pick_arrow(),
    f: fn(resolved) {
      comprep_source_bridged_pick_if_arrow_with_body_from_resolved(resolved: resolved)
    }
  )
}

fn comprep_source_bridged_pick_false_if_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: comprep_source_resolved_pick_false_arrow(),
    f: fn(resolved) {
      comprep_source_bridged_pick_if_arrow_with_body_from_resolved(resolved: resolved)
    }
  )
}
