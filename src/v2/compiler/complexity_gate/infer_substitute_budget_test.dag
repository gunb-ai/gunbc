// Scope: complexity-gate tier-1 — substitute_generics path budget witness (#5135).
//        Enrolled in complexity_subject_budget_rows; semantic RED = pre-fix tree×subst product.
// Status: discoverable `test fn` — CI floor via claim_batch --roster-from-discovery.

module v2.test.complexity_gate.infer_substitute_budget

import v2.lens.complexity {
  ConstantComplexity,
  ComplexityBound,
  complexity_bound_dominates,
  complexity_lens,
  linear_complexity
}
import v2.lens.cost { SizeVariable, cost_lens }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node }
import v2.std.witness { Holds }
import v2.test.complexity_gate.infer_substitute_subject_producer {
  infer_substitute_tree_x_subst_arrow_with_body
}
import v2.test.complexity_gate.lens_subject_body_supply {
  lens_subject_arrow_body_for_budget_row
}
import v2.test.complexity_gate.subject_complexity_budget_roster {
  LensSubjectComplexityBudgetRow,
  complexity_budget_row_infer_substitute_generics,
  complexity_declared_budget_for_row,
  complexity_declared_budget_infer_substitute_linear
}

fn infer_substitute_cost_lens_holds(body: Node) -> Bool {
  match cost_lens(n: body) {
    Holds { value: _ } => true
    _ => false
  }
}

fn infer_substitute_tightened_budget_fails_dominance(
  body: Node,
  row: LensSubjectComplexityBudgetRow
) -> Bool {
  match complexity_lens(n: body) {
    Holds { value: computed } =>
      !complexity_bound_dominates(
        a: ConstantComplexity,
        b: linear_complexity(size_var: SizeVariable { source: body })
      )
      && complexity_bound_dominates(
        a: complexity_declared_budget_for_row(row: row, body: body),
        b: computed
      )
    _ => false
  }
}

fn infer_substitute_budget_row_dominates(row: LensSubjectComplexityBudgetRow) -> Bool {
  match lens_subject_arrow_body_for_budget_row(row: row) {
    Accepted { value: body, diagnostics: _ } =>
      match complexity_lens(n: body) {
        Holds { value: computed } =>
          complexity_bound_dominates(
            a: complexity_declared_budget_for_row(row: row, body: body),
            b: computed
          )
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Pre-fix pathology: per-node map_keys ⇒ tree×subst product exceeds O(tree) budget.
data complexity_budget_row_infer_substitute_tree_x_subst_semantic_red: LensSubjectComplexityBudgetRow = LensSubjectComplexityBudgetRow {
  subject_producer: infer_substitute_tree_x_subst_arrow_with_body,
  declared_budget: complexity_declared_budget_infer_substitute_linear
}

test fn infer_substitute_tree_x_subst_semantic_red_holds() -> Bool {
  !infer_substitute_budget_row_dominates(
    row: complexity_budget_row_infer_substitute_tree_x_subst_semantic_red
  )
}

test fn infer_substitute_budget_claim_holds() -> Bool {
  let row = complexity_budget_row_infer_substitute_generics
  match lens_subject_arrow_body_for_budget_row(row: row) {
    Accepted { value: body, diagnostics: _ } =>
      infer_substitute_cost_lens_holds(body: body)
        && infer_substitute_tightened_budget_fails_dominance(body: body, row: row)
        && infer_substitute_tree_x_subst_semantic_red_holds()
    Rejected { diagnostics: _ } => false
  }
}
