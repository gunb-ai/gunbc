// Scope: §5/§6 structural guard — body_producer infer perf pathology cannot silently recur.
// Status: discoverable `test fn` witness — CI floor gates via claim_batch --roster-from-discovery.
// NOT wall-clock (flakes under contention); asserts source shape + planted RED controls.
//
// Pathology A: substitute_generics must use O(1) map_is_empty at entry, not per-node map_keys.
// Pathology B: decode_value_expression_projection_bundle must shard (no mega bind_outcome tower).

module v2.test.complexity_gate.infer_perf_structural_guard

import v2.std.logic { Bool }

fn infer_source_04_infer() -> String {
  filesystem_read(path: "src/v1/04_infer.dag").content
}

fn infer_source_target_model() -> String {
  filesystem_read(path: "src/v2/std/compilers/target_model.dag").content
}

// --- Pathology A: substitute_generics entry shape ---

fn substitute_generics_uses_map_is_empty_at_entry() -> Bool {
  string_contains(
    s: infer_source_04_infer(),
    pattern: "if map_is_empty(subst)"
  )
}

fn substitute_generics_splits_apply_recursion() -> Bool {
  string_contains(
    s: infer_source_04_infer(),
    pattern: "fn substitute_generics_apply"
  )
}

// RED: per-node map_keys(subst) emptiness check was the super-linear bug.
fn substitute_generics_map_keys_subst_semantic_red_holds() -> Bool {
  !string_contains(s: infer_source_04_infer(), pattern: "map_keys(subst)")
}

// Discriminating control: detector fires on the known-bad pattern.
fn substitute_generics_bad_pattern_detector_holds() -> Bool {
  string_contains(
    s: "if map_keys(subst) |> count == 0",
    pattern: "map_keys(subst)"
  )
}

// --- Pathology B: target_model VEP decode shard ---

fn target_model_vep_decode_sharded_helpers_present() -> Bool {
  let src = infer_source_target_model()
  string_contains(s: src, pattern: "fn decode_vep_parent_binding_ref") &&
    string_contains(s: src, pattern: "fn decode_vep_chain_binding_ref")
}

fn target_model_vep_bundle_delegates_to_chain() -> Bool {
  string_contains(
    s: infer_source_target_model(),
    pattern: "=> decode_vep_chain_binding_ref(bundle: bundle)"
  )
}

// RED: mega-closure regression re-inlines bind_outcome in the bundle entry.
fn target_model_vep_bundle_no_inline_bind_outcome_red_holds() -> Bool {
  !string_contains(
    s: infer_source_target_model(),
    pattern: "fn decode_value_expression_projection_bundle(\n  bundle: Node\n) -> Outcome<TargetValueExpressionProjection> {\n  bind_outcome("
  )
}

// Discriminating control: planted mega-closure opener is detectable.
fn target_model_vep_mega_closure_detector_holds() -> Bool {
  string_contains(
    s: "fn decode_value_expression_projection_bundle(\n  bundle: Node\n) -> Outcome<TargetValueExpressionProjection> {\n  bind_outcome(",
    pattern: "bind_outcome("
  )
}

// Conjunction keystone — claim_batch --roster-from-discovery runs this in CI.
test fn infer_perf_structural_guard_holds() -> Bool {
  substitute_generics_uses_map_is_empty_at_entry() &&
    substitute_generics_splits_apply_recursion() &&
    substitute_generics_map_keys_subst_semantic_red_holds() &&
    substitute_generics_bad_pattern_detector_holds() &&
    target_model_vep_decode_sharded_helpers_present() &&
    target_model_vep_bundle_delegates_to_chain() &&
    target_model_vep_bundle_no_inline_bind_outcome_red_holds() &&
    target_model_vep_mega_closure_detector_holds()
}
