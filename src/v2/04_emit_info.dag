// Emit graph info: type summaries, variant-to-enum maps, and field metadata
// used by the emission phase. These are pure functions over Node trees —
// no dependency on TypedModule or InferScope.
//
// Dependency chain:
//   v2.compiler.infer_types (type predicates, normalization)
//     -> v2.compiler.infer_emit_info (type summaries, field summaries)
//       -> v2.compiler.infer (build_emit_graph_info, typecheck pipeline)
//         -> v2.compiler.emit (consume EmitGraphInfo)

module v2.compiler.infer_emit_info

import v2.std.core {
  Node,
  InferredNode, Resolved, TypeVariable,
  FieldAccessStyle, StoredField, EnumAccessor, TupleFirst, TupleSecond,
  FieldValueShape, PlainValue, OptionalValue,
  FieldSummary,
  with_required_cardinality,
  Connective, Conj, Disj, NoConnective,
  CardOptional,
  param_node_name
}
import v2.compiler.infer_types {
  normalize_access_type_node,
  rt_type, emit_map_has, child_inferred_or_name, node_type_equals
}

fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

// =========================================================================
// Types
// =========================================================================

type TypeRepr = StructRepr | EnumRepr { unit_only: Bool }

// =========================================================================
// TypedItemKind — enriched item classification precomputed during reconcile.
//
// Eliminates post-classification re-interrogation of connective and uses:
//   TypeDef → split into Struct / Enum (no connective re-check)
//   Function → split into Function / TransportFunction (no uses re-check)
// =========================================================================

type TypedItemKind
  = TypedItemStruct
  | TypedItemEnum
  | TypedItemTypeAlias
  | TypedItemTypeDecl
  | TypedItemFunction
  | TypedItemTransportFunction
  | TypedItemDataDef
  | TypedItemServiceDef
  | TypedItemResourceDef
  | TypedItemUnhandled

// Check if a return type indicates a type alias (not Unit).
// Unit is the only return type that signals "this is not an alias" —
// bare items like `type Unit` have rt_type name "Unit".
fn is_type_alias_return_node(n: Node) -> Bool {
  n.name != "Unit"
}

// Classify a typed item into one of the enriched structural categories.
// Splits TypeDef by connective (Struct vs Enum) and Function by uses
// (Function vs TransportFunction) so emit never re-interrogates these.
fn classify_typed_item(item: Node) -> TypedItemKind {
  let item_has_structure = item.connective != NoConnective
  let is_bare_leaf = item_has_structure == false && item.body == none && item.params |> count == 0 && item.transport == none && item.children |> count == 0
  if is_bare_leaf && is_type_alias_return_node(n: rt_type(n: item)) {
    TypedItemTypeAlias
  } else if is_bare_leaf && !is_type_alias_return_node(n: rt_type(n: item)) {
    TypedItemTypeDecl
  } else if item_has_structure && item.transport == none {
    match item.connective {
      Conj => TypedItemStruct
      Disj => TypedItemEnum
      NoConnective => TypedItemEnum
    }
  } else if item.body != none && item.type_annotation == none {
    match item.uses |> count > 0 {
      true => TypedItemTransportFunction
      false => TypedItemFunction
    }
  } else if item.body != none && item.type_annotation != none {
    TypedItemDataDef
  } else if item.transport != none && item.children |> count > 0 {
    TypedItemServiceDef
  } else if (item.transport == none && item.children |> count > 0) || (item.transport == none && item.children |> count == 0 && item.properties |> count > 0 && item.body == none) {
    TypedItemResourceDef
  } else if item.params |> count > 0 && item.body == none && item.transport == none && item.children |> count == 0 {
    TypedItemTypeDecl
  } else {
    TypedItemUnhandled
  }
}

// Lookup an item's precomputed kind from EmitGraphInfo.
fn lookup_item_kind(emit_info: EmitGraphInfo, name: String) -> TypedItemKind {
  match map_get(emit_info.item_kinds, name) {
    Some { value: k } => k
    None => TypedItemUnhandled
  }
}

fn is_type_item_kind(emit_info: EmitGraphInfo, name: String) -> Bool {
  let k = lookup_item_kind(emit_info: emit_info, name: name)
  k == TypedItemStruct || k == TypedItemEnum
}

fn is_function_item_kind(emit_info: EmitGraphInfo, name: String) -> Bool {
  let k = lookup_item_kind(emit_info: emit_info, name: name)
  k == TypedItemFunction || k == TypedItemTransportFunction
}

// ValueContext: orthogonal facts about how a named value is used,
// determining its target-language representation. Precomputed in
// EmitGraphInfo so the emitter reads facts instead of heuristics.
//
// The emitter reads ValueContext × LanguageSpec to choose representation:
//   has_fn_fields × Rust → skip PartialEq/Debug derives
//
type ValueContext {
  has_fn_fields: Bool
  // True when the type is a fixed-width carrier: not recursive, no fn-typed
  // fields, and all fields are value types (Int, Bool, Float) or it's a
  // unit-only enum. The emitter uses this to skip Rc wrapping in Rust.
  is_constant: Bool
}

type TypeSummary {
  name: String
  repr: TypeRepr
  field_summaries: Map<String, FieldSummary>
  field_type_map: Map<String, String>
  variant_name_set: Map<String, Bool>
  generic_param_names: List<String>
}

// EmitGraphInfo: the reconcile→emit boundary contract.
//
// Invariant: emit never calls back into infer. All data the emitter needs
// about graph-level type structure is precomputed here during reconcile
// (build_emit_graph_info in 04_infer.dag).
//
// Fields and guarantees:
//   type_summaries    — one entry per named type definition (Conj or Disj)
//                       in the typed module graph. Keyed by type name.
//                       Guaranteed non-empty for modules with type definitions.
//                       For enums, variant_name_set provides O(1) membership.
//                       variant_to_enum and enum_variant_membership are derived
//                       from type_summaries at the point of use (not stored).
//   recursive_type_set — maps type names that participate in recursive cycles
//                       (detected by 04_cycle.dag) to true. Used by emit to decide
//                       Rc wrapping (Rust) or pointer indirection (Go/C).
type EmitGraphInfo {
  type_summaries: Map<String, TypeSummary>
  recursive_type_set: Map<String, Bool>
  // Per-variant structural fact: does this variant have fields?
  // Used by pattern emission to decide Variant vs Variant { .. }.
  // Keyed by variant name → true if variant has children.
  fielded_variants: Map<String, Bool>
  // Per-type value context: orthogonal facts about how each named type
  // is used, keyed by type name. Emitter reads these instead of locally
  // inspecting resolved children.
  value_contexts: Map<String, ValueContext>
  // Per-function ownership index: func_name → movable bindings set.
  // Built from ownership analysis. The emitter looks up the current
  // function's movable set and stores it in `movable` during item dispatch.
  ownership_index: Map<String, Map<String, Bool>>
  // Current function's movable bindings. Set by emit_typed_item before
  // dispatching to emit_fn_def/emit_func_def. Bindings in this set have
  // fan-out=1 and can be moved instead of cloned.
  movable: Map<String, Bool>
  // Bindings known to be owned (not behind Rc). Field accesses on these
  // bindings use move semantics instead of .clone(). Set for fold
  // accumulators after Rc::try_unwrap.
  owned_bindings: Map<String, Bool>
  // Per-item structural classification: item.name → TypedItemKind.
  // Precomputed during reconcile so emit reads enriched kinds (Struct/Enum,
  // Function/TransportFunction) without re-interrogating Node fields.
  item_kinds: Map<String, TypedItemKind>
}

// TypeRendering: structural descriptor for type rendering.
// Named edges encode the type's composition; shape is emergent from which
// edges are populated (no tag enum). The emitter matches on edges ×
// LanguageSpec — no Node inspection, no name-based dispatch.
//
// Stepping stone for coercion-based emission (M5): named edges map directly
// to algebraic relationships that the coercion engine will formalize.
type TypeRendering {
  type_name: String                   // identity: "Int", "list", "Token", "map"
  element: TypeRendering?             // List<THIS>, Set<THIS>
  key: TypeRendering?                 // Map<THIS, V>
  value: TypeRendering?               // Map<K, THIS>
  params: List<TypeRendering>         // fn(THESE, ...) -> ...
  return_type: TypeRendering?         // fn(...) -> THIS
  inner: TypeRendering?               // Optional<THIS>, Refined<THIS>
  generic_args: List<TypeRendering>   // FreeMonoid<THIS>, PartialFunction<THIS, THIS>
  shared: Bool                        // needs Rc/pointer/GC wrapper
  boxed: Bool                         // recursive indirection (Box in Rust)
  is_tuple: Bool                      // structural tuple (not name-derived)
  is_error: Bool                      // inference failure — emit must fail-closed
  error_label: String                 // diagnostic context for the error
}

type EmitInfoBuildState {
  type_summaries: Map<String, TypeSummary>
}

// =========================================================================
// Constructors and lookups
// =========================================================================

fn empty_emit_graph_info() -> EmitGraphInfo {
  EmitGraphInfo {
    type_summaries: empty_map(),
    recursive_type_set: empty_map(),
    fielded_variants: empty_map(),
    value_contexts: empty_map(),
    ownership_index: empty_map(),
    movable: empty_map(),
    owned_bindings: empty_map(),
    item_kinds: empty_map()
  }
}

fn leaf_type_rendering(name: String) -> TypeRendering {
  TypeRendering {
    type_name: name,
    element: none,
    key: none,
    value: none,
    params: [],
    return_type: none,
    inner: none,
    generic_args: [],
    shared: false,
    boxed: false,
    is_tuple: false,
    is_error: false,
    error_label: ""
  }
}

fn leaf_type_rendering_shared(name: String) -> TypeRendering {
  TypeRendering {
    type_name: name,
    element: none,
    key: none,
    value: none,
    params: [],
    return_type: none,
    inner: none,
    generic_args: [],
    shared: true,
    boxed: false,
    is_tuple: false,
    is_error: false,
    error_label: ""
  }
}

// build_type_rendering and helpers are implemented in stage0 Rust
// (v2_compiler_emit.rs). The .dag source will use these once the
// stage0 bootstrap reaches fixed point and regeneration can produce
// this code. Until then, stage0 Rust is the authority.

// =========================================================================
// Variant and lookup helpers
// =========================================================================

fn variant_has_fields(emit_info: EmitGraphInfo, enum_name: String, variant_name: String) -> Bool {
  let key = concat(enum_name, "::", variant_name)
  match map_get(emit_info.fielded_variants, key) {
    Some { value: v } => v
    None => false
  }
}

fn lookup_emit_type_summary(emit_info: EmitGraphInfo, type_name: String) -> TypeSummary? {
  map_get(emit_info.type_summaries, type_name)
}

// Derive variant_to_enum: a module-local CACHE, not the authority.
// Authority is type_summaries.variant_name_set (O(1) structural check).
// This cache is first-write-wins: ambiguous variants get an arbitrary
// parent that the module-level vtoe correction fixes via structural
// lookup through variant_belongs_to_enum. The cache is lossy by design —
// it accelerates the common case (unique variants); the correction pass
// handles the rest.
fn derive_variant_to_enum(type_summaries: Map<String, TypeSummary>) -> Map<String, String> {
  map_values(type_summaries) |> fold(init: empty_map(), f: (acc, summary) =>
    match summary.repr {
      EnumRepr { unit_only: _ } =>
        fold(map_keys(summary.variant_name_set), init: acc, f: (inner, vn) =>
          match map_get(inner, vn) {
            Some { value: _ } => inner
            None => map_insert(inner, vn, summary.name)
          }
        )
      _ => acc
    }
  )
}

// Structural check: is this name a variant of any enum in type_summaries?
fn is_known_variant(type_summaries: Map<String, TypeSummary>, name: String) -> Bool {
  map_values(type_summaries) |> any(summary =>
    match summary.repr {
      EnumRepr { unit_only: _ } => emit_map_has(m: summary.variant_name_set, key: name)
      _ => false
    }
  )
}

// Structural check: is variant_name a member of enum_name? O(1) via map lookup.
fn variant_belongs_to_enum(type_summaries: Map<String, TypeSummary>, variant_name: String, enum_name: String) -> Bool {
  match map_get(type_summaries, enum_name) {
    Some { value: summary } =>
      match summary.repr {
        EnumRepr { unit_only: _ } =>
          emit_map_has(m: summary.variant_name_set, key: variant_name)
        _ => false
      }
    None => false
  }
}

fn is_enum_in_summaries(type_summaries: Map<String, TypeSummary>, type_name: String) -> Bool {
  match map_get(type_summaries, type_name) {
    Some { value: summary } => match summary.repr {
      EnumRepr { unit_only: _ } => true
      _ => false
    }
    None => false
  }
}

fn find_variant_parent(type_summaries: Map<String, TypeSummary>, variant_name: String, scope_enums: List<String>) -> String? {
  scope_enums |> filter(en =>
    variant_belongs_to_enum(type_summaries: type_summaries, variant_name: variant_name, enum_name: en)
  ) |> first
}

// =========================================================================
// Field summary helpers
// =========================================================================

fn field_value_shape_from_type_node(type_node: Node) -> FieldValueShape {
  let normed = normalize_access_type_node(n: type_node)
  let is_optional = normed.return_cardinality == CardOptional
  if is_optional { OptionalValue }
  else { PlainValue }
}

fn is_pair_children(children: List<Node>) -> Bool {
  if children |> count != 2 { false }
  else {
    match children |> first {
      Some { value: c0 } =>
        match children |> skip(1) |> first {
          Some { value: c1 } => c0.name == "first" && c1.name == "second"
          None => false
        }
      None => false
    }
  }
}

fn pair_access_style(field_name: String) -> FieldAccessStyle {
  if field_name == "first" { TupleFirst }
  else { TupleSecond }
}

// =========================================================================
// Struct and enum field summary builders
// =========================================================================

fn build_struct_field_summaries(children: List<Node>) -> Map<String, FieldSummary> {
  let is_pair = is_pair_children(children: children)
  fold(children, init: empty_map(), f: (acc, child) =>
    if child.inferred == none {
      acc
    } else {
      let style = if is_pair { pair_access_style(field_name: child.name) } else { StoredField }
      map_insert(acc, child.name, FieldSummary {
        access_style: style,
        value_shape: field_value_shape_from_type_node(type_node: rt_type(n: child))
      })
    }
  )
}

fn find_first_enum_field_node(variants: List<Node>, field_name: String) -> Node? {
  match variants |> first {
    Some { value: variant } =>
      match variant.children |> filter(f => f.name == field_name) |> first {
        Some { value: field_child } => Some { value: field_child }
        None => none
      }
    None => none
  }
}

fn enum_field_present_in_all_variants(variants: List<Node>, field_name: String) -> Bool {
  variants |> all(variant =>
    variant.children |> any(field_child => field_child.name == field_name)
  )
}

fn enum_field_type_consistent(variants: List<Node>, field_name: String, expected: Node) -> Bool {
  variants |> all(variant =>
    match variant.children |> filter(f => f.name == field_name) |> first {
      Some { value: field_child } => node_type_equals(left: child_inferred_or_name(ch: field_child), right: expected)
      None => false
    }
  )
}

fn build_enum_field_summaries(variants: List<Node>) -> Map<String, FieldSummary> {
  let first_field_names = match variants |> first {
    Some { value: first_variant } => first_variant.children |> map(f => f.name)
    None => []
  }
  let shared = first_field_names |> filter(field_name =>
    enum_field_present_in_all_variants(variants: variants, field_name: field_name)
  )
  let consistent = shared |> filter(field_name =>
    match find_first_enum_field_node(variants: variants, field_name: field_name) {
      Some { value: first_field } =>
        enum_field_type_consistent(variants: variants, field_name: field_name, expected: child_inferred_or_name(ch: first_field))
      None => false
    }
  )
  fold(consistent, init: empty_map(), f: (acc, field_name) =>
    match find_first_enum_field_node(variants: variants, field_name: field_name) {
      Some { value: first_field } =>
        map_insert(acc, field_name, FieldSummary {
          access_style: EnumAccessor,
          value_shape: field_value_shape_from_type_node(type_node: child_inferred_or_name(ch: first_field))
        })
      None => acc
    }
  )
}

// =========================================================================
// Type summary builders
// =========================================================================

fn build_field_type_map(children: List<Node>) -> Map<String, String> {
  fold(children, init: empty_map(), f: (acc, child) =>
    match child.inferred {
      Some { value: Resolved { node: ft } } =>
        let resolved_name = normalize_access_type_node(n: ft).name
        let ft_is_type_var = if ft.inferred != none { is_type_variable(inferred: ft.inferred.value) } else { false }
        // Fail-closed: exclude empty names, type variables, and placeholder types.
        // Dynamic is a compatibility placeholder that must not enter the authority surface.
        if resolved_name != "" && !ft_is_type_var && resolved_name != "Dynamic" {
          map_insert(acc, child.name, resolved_name)
        } else { acc }
      _ => acc
    }
  )
}

fn build_type_summary(item: Node) -> TypeSummary? {
  if item.connective == NoConnective || item.transport != none {
    return none
  }
  let gpn = item.params |> map(p => param_node_name(n: p))
  let is_product = item.connective == Conj
  if is_product {
    Some { value: TypeSummary {
      name: item.name,
      repr: StructRepr,
      field_summaries: build_struct_field_summaries(children: item.children),
      field_type_map: build_field_type_map(children: item.children),
      variant_name_set: empty_map(),
      generic_param_names: gpn
    } }
  } else {
    let unit_only = item.children |> all(child => child.children |> count == 0)
    Some { value: TypeSummary {
      name: item.name,
      repr: EnumRepr { unit_only: unit_only },
      field_summaries: build_enum_field_summaries(variants: item.children),
      field_type_map: empty_map(),
      variant_name_set: fold(item.children, init: empty_map(), f: (acc, child) => map_insert(acc, child.name, true)),
      generic_param_names: gpn
    } }
  }
}

fn add_emit_item_summary(state: EmitInfoBuildState, item: Node) -> EmitInfoBuildState {
  match build_type_summary(item: item) {
    Some { value: summary } =>
      // Add per-variant summaries for enums so is_optional_struct_field can look up
      // individual variant field types (e.g. VariantPattern.parent_enum).
      let with_variants = match summary.repr {
        EnumRepr { unit_only: _ } =>
          fold(item.children, init: state.type_summaries, f: (acc, variant) =>
            if variant.children |> count > 0 {
              map_insert(acc, variant.name, TypeSummary {
                name: variant.name,
                repr: StructRepr,
                field_summaries: build_struct_field_summaries(children: variant.children),
                field_type_map: build_field_type_map(children: variant.children),
                variant_name_set: empty_map(),
                generic_param_names: []
              })
            } else { acc }
          )
        _ => state.type_summaries
      }
      let next_summaries = map_insert(with_variants, summary.name, summary)
      EmitInfoBuildState {
        type_summaries: next_summaries
      }
    None => state
  }
}
