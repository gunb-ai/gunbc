// Lookup and resolution helpers -- pure type lookups and scrutinee
// resolution for the namespace reconciler.
//
// Dependency chain:
//   v2.std.core, v2.compiler.infer_types, v2.compiler.infer_env,
//   v2.compiler.infer_method, v2.compiler.infer_service
//     -> v2.compiler.infer_lookup (this file)
//       -> v2.compiler.infer (expression inference)

module v2.compiler.infer_lookup

import v2.std.core {
  Node, make_param_node, param_node_type_expr, param_node_default_value,
  InferredNode, Resolved, TypeVariable,
  NodeType, Typed, InferError, InferVariable, Untyped, CompilerError,
  Cardinality, Required,
  MethodSemantics, PlainMethodSemantics, AlgebraMethodSemantics, ServiceMethodSemantics,
  FieldAccessStyle, OptionalUnwrap,
  FieldValueShape, PlainValue, OptionalValue,
  FieldSummary,
  with_optional_cardinality, with_required_cardinality,
  Connective, Conj, Disj, NoConnective,
  is_container_type,
  CardOptional
}
import v2.compiler.infer_types {
  child_inferred_or_name,
  nominal_type_ref,
  normalize_access_type_node, node_is_keyed_collection,
  method_receiver_element_node,
  rt_type, rt_node,
  emit_map_has
}
import v2.compiler.infer_env {
  TypeEnv, TypeBinding,
  is_recursive_type, lookup_type
}
import v2.compiler.infer_emit_info {
  build_struct_field_summaries, build_enum_field_summaries
}
import v2.compiler.infer_sigs {
  ResolvedFuncSig, ResolvedFuncEnv
}
import v2.compiler.infer_service {
  OpEntry, ServiceMethodResult,
  check_service_method_call_node
}

fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

// =========================================================================
// Types
// =========================================================================

type KnownMethodResolution {
  semantics: MethodSemantics?
  result_type: Node?
}

// =========================================================================
// Scope lookups
// =========================================================================

fn lookup_in_scope(locals: Map<String, TypeBinding>, name: String) -> Node? {
  match map_get(locals, name) {
    Some { value: binding } => Some { value: binding.resolved }
    None => None
  }
}

fn lookup_func_sig(func_env: ResolvedFuncEnv, name: String) -> ResolvedFuncSig? {
  map_get(func_env.signatures, name)
}

// =========================================================================
// Field lookup
// =========================================================================

fn lookup_field_type_node(env: TypeEnv, n: Node, field_name: String) -> Node? {
  let is_optional = n.return_cardinality == CardOptional
  if is_optional {
    let inner = with_required_cardinality(n: n)
    if field_name == "value" {
      Some { value: inner }
    } else {
      match lookup_field_type_node(env: env, n: inner, field_name: field_name) {
        Some { value: inner_result } => Some { value: with_optional_cardinality(n: inner_result) }
        None => none
      }
    }
  } else {
    let surface = resolve_type_surface_node(env: env, n: n, expand_containers: false)
    let has_structure = surface.connective != NoConnective
    if has_structure {
      let is_product = surface.connective == Conj
      if is_product {
        match surface.children |> filter(c => c.name == field_name) |> first {
          Some { value: field_child } =>
            Some { value: child_inferred_or_name(ch: field_child) }
          None => none
        }
      } else {
        lookup_coproduct_common_field_node(variants: surface.children, field_name: field_name)
      }
    } else { none }
  }
}

fn lookup_coproduct_common_field_node(variants: List<Node>, field_name: String) -> Node? {
  let found_in_all = variants |> all(v =>
    v.children |> any(c => c.name == field_name)
  )
  let first_field = if found_in_all {
    match variants |> first {
      Some { value: first_variant } =>
        first_variant.children |> filter(c => c.name == field_name) |> first
      None => none
    }
  } else { none }
  match first_field {
    Some { value: field_child } =>
      Some { value: child_inferred_or_name(ch: field_child) }
    None => none
  }
}

// =========================================================================
// Scrutinee type resolution
// =========================================================================

fn resolve_scrutinee_type_node(env: TypeEnv, n: Node) -> Node {
  resolve_scrutinee_type_node_seen(env: env, n: n, seen: empty_map())
}

fn preserve_optional_cardinality(reference: Node, target: Node) -> Node {
  let is_optional = reference.return_cardinality == CardOptional
  let wrapped = with_optional_cardinality(target)
  if is_optional { wrapped } else { target }
}

fn resolve_scrutinee_type_node_seen(env: TypeEnv, n: Node, seen: Map<String, Bool>) -> Node {
  // TypeVariable nodes are unresolved placeholders -- return as-is.
  let n_is_type_var = if n.inferred != none { is_type_variable(inferred: n.inferred.value) } else { false }
  if n_is_type_var { return n }
  let normed = normalize_access_type_node(n: n)
  if normed.connective == NoConnective && normed.children |> count == 0 {
    let canonical = normed.name
    if normed.inferred != none {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      match rt_node(n: normed) {
        Typed { node: target } =>
          if target.name == normed.name && target.inferred == none && target.connective == NoConnective && target.children |> count == 0 {
            normed
          } else {
            let result = resolve_scrutinee_type_node_seen(env: env, n: target, seen: next_seen)
            let preserved_result = preserve_optional_cardinality(reference: normed, target: result)
            preserved_result
          }
        InferError { message: _, span: _ } => normed
        InferVariable { id: _ } => normed
        Untyped => normed
      }
    } else if canonical != "" && emit_map_has(m: seen, key: canonical) {
      nominal_type_ref(name: normed.name)
    } else {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      match lookup_type(env: env, name: normed.name) {
        Some { value: resolved } =>
          if resolved.name == normed.name && resolved.inferred == none && resolved.connective == NoConnective && resolved.children |> count == 0 {
            normed
          } else {
            let result = resolve_scrutinee_type_node_seen(env: env, n: resolved, seen: next_seen)
            // Preserve Optional scrutinee shape during alias/type-env lookup
            // until Optional itself becomes fully structural in the lookup path.
            let preserved_result = preserve_optional_cardinality(reference: normed, target: result)
            preserved_result
          }
        None => normed
      }
    }
  } else { normed }
}

fn lookup_surface_slot(slot_names: List<String>, actuals: List<Node>, slot_name: String) -> Node? {
  match slot_names |> enumerate |> filter(pair => pair.second == slot_name) |> first {
    Some { value: pair } =>
      actuals |> skip(pair.first) |> first
    None => none
  }
}

fn substitute_surface_slot_value(n: Node, slot_names: List<String>, actuals: List<Node>) -> Node {
  let slot_value = match lookup_surface_slot(slot_names: slot_names, actuals: actuals, slot_name: n.name) {
    Some { value: concrete } => concrete
    None => n
  }
  let preserved_slot = preserve_optional_cardinality(reference: n, target: slot_value)
  preserved_slot
}

fn substitute_surface_child(child: Node, slot_names: List<String>, actuals: List<Node>, decl_name: String) -> Node {
  let is_self_child = child.name == decl_name && child.connective == NoConnective
  match is_self_child {
    true =>
      Node {
        name: child.name, span: child.span, ident_span: child.ident_span,
        children: child.children |> map(arg => substitute_surface_slots(n: arg, slot_names: slot_names, actuals: actuals, decl_name: decl_name)),
        connective: child.connective, params: child.params, inferred: child.inferred,
        return_cardinality: child.return_cardinality, uses: child.uses, body: child.body,
        transport: child.transport, properties: child.properties, type_annotation: child.type_annotation,
        is_self_recursive: child.is_self_recursive, has_non_tail_self_call: child.has_non_tail_self_call,
        match_pattern: child.match_pattern, expr_data: child.expr_data
      }
    false =>
      substitute_surface_slots(n: child, slot_names: slot_names, actuals: actuals, decl_name: decl_name)
  }
}

fn substitute_surface_slots(n: Node, slot_names: List<String>, actuals: List<Node>, decl_name: String) -> Node {
  let is_slot = n.children |> count == 0 && n.connective == NoConnective && n.body == none && n.inferred == none
  if is_slot {
    let substituted_slot = substitute_surface_slot_value(n: n, slot_names: slot_names, actuals: actuals)
    substituted_slot
  } else {
    let substituted_children = n.children |> map(child =>
      substitute_surface_child(child: child, slot_names: slot_names, actuals: actuals, decl_name: decl_name)
    )
    let substituted_params = n.params |> map(p =>
      make_param_node(
        name: p.name,
        type_expr: substitute_surface_slots(n: param_node_type_expr(n: p), slot_names: slot_names, actuals: actuals, decl_name: decl_name),
        default_value: match param_node_default_value(n: p) {
          Some { value: dv } => Some { value: substitute_surface_slots(n: dv, slot_names: slot_names, actuals: actuals, decl_name: decl_name) }
          None => none
        },
        span: p.span
      )
    )
    let substituted_inferred = match n.inferred {
      Some { value: Resolved { node: rt } } =>
        Some { value: Resolved { node: substitute_surface_slots(n: rt, slot_names: slot_names, actuals: actuals, decl_name: decl_name) } }
      Some { value: CompilerError { message: m, span: s } } =>
        Some { value: CompilerError { message: m, span: s } }
      Some { value: TypeVariable { id: id } } =>
        Some { value: TypeVariable { id: id } }
      None => none
    }
    Node {
      name: n.name, span: n.span, ident_span: n.ident_span, children: substituted_children,
      connective: n.connective, params: substituted_params, inferred: substituted_inferred,
      return_cardinality: n.return_cardinality, uses: n.uses, body: n.body,
      transport: n.transport, properties: n.properties, type_annotation: n.type_annotation,
      is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call,
      match_pattern: n.match_pattern, expr_data: n.expr_data
    }
  }
}

fn should_expand_surface_type(n: Node, expand_containers: Bool) -> Bool {
  let nominal = n.connective == NoConnective && n.name != ""
  if nominal == false { false }
  else if expand_containers { true }
  else { is_container_type(name: n.name) == false }
}

fn resolve_alias_surface(declaration: Node, resolved: Node, slot_names: List<String>, actuals: List<Node>, next_seen: Map<String, Bool>, env: TypeEnv, expand_containers: Bool) -> Node {
  let alias_target = match rt_node(n: declaration) {
    Typed { node: target } => substitute_surface_slots(n: target, slot_names: slot_names, actuals: actuals, decl_name: declaration.name)
    InferError { message: _, span: _ } => resolved
    InferVariable { id: _ } => resolved
    Untyped => resolved
  }
  let surface = resolve_type_surface_node_seen(env: env, n: alias_target, seen: next_seen, expand_containers: expand_containers)
  let preserved_surface = preserve_optional_cardinality(reference: resolved, target: surface)
  preserved_surface
}

fn materialize_decl_surface(declaration: Node, resolved: Node, slot_names: List<String>, actuals: List<Node>) -> Node {
  let surface = Node {
    name: resolved.name, span: resolved.span, ident_span: resolved.ident_span,
    children: declaration.children |> map(child => substitute_surface_slots(n: child, slot_names: slot_names, actuals: actuals, decl_name: declaration.name)),
    connective: declaration.connective, params: [], inferred: declaration.inferred,
    return_cardinality: declaration.return_cardinality, uses: declaration.uses, body: declaration.body,
    transport: declaration.transport, properties: declaration.properties, type_annotation: declaration.type_annotation,
    is_self_recursive: declaration.is_self_recursive, has_non_tail_self_call: declaration.has_non_tail_self_call,
    match_pattern: declaration.match_pattern, expr_data: declaration.expr_data
  }
  let preserved_surface = preserve_optional_cardinality(reference: resolved, target: surface)
  preserved_surface
}

fn resolve_type_surface_node(env: TypeEnv, n: Node, expand_containers: Bool) -> Node {
  resolve_type_surface_node_seen(env: env, n: n, seen: empty_map(), expand_containers: expand_containers)
}

fn resolve_type_surface_node_seen(env: TypeEnv, n: Node, seen: Map<String, Bool>, expand_containers: Bool) -> Node {
  let resolved = resolve_scrutinee_type_node_seen(env: env, n: n, seen: seen)
  let canonical = resolved.name
  let already_seen = canonical != "" && emit_map_has(m: seen, key: canonical)
  let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      if should_expand_surface_type(n: resolved, expand_containers: expand_containers) == false || already_seen {
    resolved
  } else {
    match lookup_type(env: env, name: canonical) {
      Some { value: declaration } =>
        let expected_arity = declaration.params |> count
        let actual_arity = resolved.children |> count
        if expected_arity > 0 && expected_arity != actual_arity {
          resolved
        } else {
          let slot_names = declaration.params |> map(p => p.name)
          let actuals = resolved.children |> map(arg =>
            resolve_scrutinee_type_node_seen(env: env, n: arg, seen: next_seen)
          )
          let is_alias_decl = declaration.inferred != none && declaration.children |> count == 0 && declaration.connective == NoConnective
          if is_alias_decl {
            let alias_target = match rt_node(n: declaration) {
              Typed { node: target } => substitute_surface_slots(n: target, slot_names: slot_names, actuals: actuals, decl_name: declaration.name)
              InferError { message: _, span: _ } => resolved
              InferVariable { id: _ } => resolved
              Untyped => resolved
            }
            let surface = resolve_type_surface_node_seen(env: env, n: alias_target, seen: next_seen, expand_containers: expand_containers)
            let preserved_surface = preserve_optional_cardinality(reference: resolved, target: surface)
            preserved_surface
          } else {
            let decl_has_structure = declaration.connective != NoConnective
            if decl_has_structure {
              let surface = Node {
                name: resolved.name, span: resolved.span, ident_span: resolved.ident_span,
                children: declaration.children |> map(child => substitute_surface_slots(n: child, slot_names: slot_names, actuals: actuals, decl_name: declaration.name)),
                connective: declaration.connective, params: [], inferred: declaration.inferred,
                return_cardinality: declaration.return_cardinality, uses: declaration.uses, body: declaration.body,
                transport: declaration.transport, properties: declaration.properties, type_annotation: declaration.type_annotation,
                is_self_recursive: declaration.is_self_recursive, has_non_tail_self_call: declaration.has_non_tail_self_call,
                match_pattern: declaration.match_pattern, expr_data: declaration.expr_data
              }
              let preserved_surface = preserve_optional_cardinality(reference: resolved, target: surface)
              preserved_surface
            } else {
              resolved
            }
          }
        }
      None => resolved
    }
  }
}

fn map_value_type_in_env(type_node: Node, env: TypeEnv) -> Node? {
  let normed = normalize_access_type_node(n: type_node)
  let resolved = resolve_scrutinee_type_node(env: env, n: normed)
  let map_type = normalize_access_type_node(n: resolved)
  if node_is_keyed_collection(n: map_type) && map_type.children |> count >= 2 {
    match map_type.children |> skip(1) |> first {
      Some { value: value_type } => Some { value: value_type }
      None => none
    }
  } else {
    none
  }
}

fn field_summary_for_type(base_type: Node, env: TypeEnv, field: String) -> FieldSummary? {
  let resolved = resolve_type_surface_node(env: env, n: base_type, expand_containers: false)
  let normed = normalize_access_type_node(n: resolved)
  let normed_opt = normed.return_cardinality == CardOptional
  if field == "value" && normed_opt {
    Some { value: FieldSummary { access_style: OptionalUnwrap, value_shape: PlainValue } }
  } else if normed_opt {
    let inner = with_required_cardinality(n: normed)
    match field_summary_for_type(base_type: inner, env: env, field: field) {
      Some { value: inner_summary } =>
        Some { value: FieldSummary {
          access_style: inner_summary.access_style,
          value_shape: OptionalValue
        } }
      None => none
    }
  } else {
    let no_structure = resolved.connective == NoConnective
    if no_structure {
      none
    } else {
      let is_product = resolved.connective == Conj
      if is_product {
        map_get(build_struct_field_summaries(children: resolved.children), field)
      } else {
        map_get(build_enum_field_summaries(variants: resolved.children), field)
      }
    }
  }
}

// =========================================================================
// Known method resolution
// =========================================================================

// Structural field lookup: check if the receiver type's declaration has
// Look up a method field in a product type and return both the field
// node (definition) and its return type. Single lookup, no duplication.
type MethodFieldResult {
  field_node: Node
  result_type: Node
}

fn lookup_field_in_product(product: Node, method_name: String) -> MethodFieldResult? {
  let matching = product.children |> filter(c => c.name == method_name)
  match matching |> first {
    Some { value: field } =>
      match field.inferred {
        Some { value: Resolved { node: rt } } =>
          if rt.params |> count > 0 {
            match rt.inferred {
              Some { value: Resolved { node: return_type } } => Some { value: MethodFieldResult { field_node: field, result_type: return_type } }
              _ => Some { value: MethodFieldResult { field_node: field, result_type: rt } }
            }
          } else {
            Some { value: MethodFieldResult { field_node: field, result_type: rt } }
          }
        _ => none
      }
    None => none
  }
}

fn lookup_structural_method(type_env: TypeEnv, receiver_type: Node, method_name: String) -> MethodFieldResult? {
  let surface = resolve_type_surface_node(env: type_env, n: receiver_type, expand_containers: true)
  // First: check the receiver's own structural fields (Conj product).
  let is_product = surface.connective == Conj
  if is_product {
    let direct = lookup_field_in_product(product: surface, method_name: method_name)
    match direct {
      Some { value: _ } => direct
      None => none
    }
  } else {
    none
  }
}

// Algebra field templates are instantiated against the concrete receiver
// before lookup, so most result types are already final at this point.
// fold remains special because its output type is driven by the accumulator,
// not the receiver's algebra witness.
fn substitute_algebra_result(result_type: Node, receiver_type: Node, fold_accumulator_type: Node?) -> Node {
  if method_name_is_fold(result_type: result_type, fold_accumulator_type: fold_accumulator_type) {
    match fold_accumulator_type {
      Some { value: fat } => fat
      None => result_type
    }
  } else {
    result_type
  }
}

// Detect fold by checking if fold_accumulator_type is provided and the
// algebra field return type is generic (matches self_type pattern).
fn method_name_is_fold(result_type: Node, fold_accumulator_type: Node?) -> Bool {
  fold_accumulator_type != none
}

fn resolve_known_method_node(receiver: Node, receiver_type: Node, method_name: String, fold_accumulator_type: Node?, type_env: TypeEnv, service_registry: Map<String, List<OpEntry>>) -> KnownMethodResolution {
  // Tier 0: Structural field lookup for ALL types (including collections).
  // The algebra registry (enrich_kernel_type) provides fields for kernel
  // types; user-defined types have their own structural children.
  //
  // Emit-prep reclassification: when Tier 0 finds a method, check the
  // intrinsic/bridge indexes to tag with the correct MethodSemantics
  // for emit. Return types from the algebra field are substituted with
  // concrete types from the receiver (e.g., bare "List" → List<Int>).
  let tier0_result = lookup_structural_method(type_env: type_env, receiver_type: receiver_type, method_name: method_name)
  match tier0_result {
    Some { value: mfr } =>
      // Method found structurally — carry the method definition node.
      // mfr.field_node is the algebra field node (from the enriched type).
      // It carries the method's name, type signature, and structural properties.
      let semantics = AlgebraMethodSemantics { method_def: mfr.field_node, fold_accumulator_type: fold_accumulator_type }
      let resolved_type = substitute_algebra_result(
        result_type: mfr.result_type,
        receiver_type: receiver_type,
        fold_accumulator_type: fold_accumulator_type
      )
      KnownMethodResolution {
        semantics: Some { value: semantics },
        result_type: Some { value: resolved_type }
      }
    None =>
  // Tier 1: Service method lookup
  match check_service_method_call_node(receiver_type: receiver_type, method: method_name, service_registry: service_registry) {
    Some { value: svc_result } =>
      KnownMethodResolution {
        semantics: Some { value: ServiceMethodSemantics { service_name: receiver_type.name, op_params: svc_result.op_params } },
        result_type: Some { value: svc_result.result_type }
      }
    None =>
      // No structural field found, not a service method — method not found.
      KnownMethodResolution { semantics: none, result_type: none }
  }
  }
}
