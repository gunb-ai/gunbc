// Lookup and resolution helpers -- pure type lookups and scrutinee

module v2.compiler.infer_lookup

import v2.std.core {
  Node, param_node_type_expr,
  authored_name_at, NewlineIndex, find_child_named, has_child_named,
  InferredNode, Resolved, TypeVariable,
  Cardinality, Required,
  MethodSemantics, PlainMethodSemantics, AlgebraMethodSemantics, ServiceMethodSemantics,
  FieldAccessStyle, OptionalUnwrap,
  FieldValueShape, PlainValue, OptionalValue,
  FieldSummary,
  with_optional_cardinality, with_required_cardinality,
  Connective, Conj, Disj, NoConnective,
  ErrorNode,

  CardOptional
}
import std.algebra {
  CollectionSizeEffect, CostShape, AlgebraFieldTemplate,
  AlgebraTypeTemplate, ReceiverSelf, ContainerOf, ContainerSource, SameAsReceiver, Named,
  kernel_algebra_profile, algebra_templates_for_profile
}
import v2.compiler.infer_types {
  child_type_node,
  nominal_type_ref,
  normalize_access_type_node, node_is_keyed_collection, node_is_set_collection,
  method_receiver_element_node,
  emit_map_has,
  enrich_kernel_type
}
import v2.compiler.infer_env {
  TypeEnv, TypeBinding, authored_name,
  is_recursive_type, lookup_type, lookup_type_for,
  find_child_in_env, has_child_in_env,
  lookup_cache_get_scrutinee, lookup_cache_put_scrutinee,
  lookup_cache_get_enriched_kernel,
  lookup_cache_put_enriched_kernel, enriched_kernel_cache_key
}
import v2.compiler.infer_emit_info {
  build_struct_field_summaries, build_enum_field_summaries
}
import v2.compiler.infer_sigs {
  ResolvedFuncSig, ResolvedFuncEnv
}
import v2.compiler.infer_service {
  OpEntry, ServiceMethodResult,
  check_service_method_call_node
}

fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

// =========================================================================
// Types
// =========================================================================

type KnownMethodResolution {
  semantics: MethodSemantics?
  result_type: Node?
  diagnostics: List<ErrorNode>
}

// =========================================================================
// Scope lookups
// =========================================================================

fn lookup_in_scope(locals: Map<String, TypeBinding>, name: String) -> Node? {
  match map_get(locals, name) {
    Some { value: binding } => Some { value: binding.resolved }
    None => None
  }
}

fn lookup_func_sig(func_env: ResolvedFuncEnv, name: String) -> ResolvedFuncSig? {
  map_get(func_env.signatures, name)
}

// =========================================================================
// Field lookup
// =========================================================================

fn lookup_field_type_node(n: Node, field_name: String, env: TypeEnv) -> Node? {
  let source_indices = env.source_indices
  let is_optional = n.return_cardinality == CardOptional
  if is_optional {
    let inner = with_required_cardinality(n: n)
    if field_name == "value" {
      Some { value: inner }
    } else {
      match lookup_field_type_node(n: inner, field_name: field_name, env: env) {
        Some { value: inner_result } => Some { value: with_optional_cardinality(n: inner_result) }
        None => none
      }
    }
  } else {
    let has_structure = n.connective != NoConnective
    if has_structure {
      let is_product = n.connective == Conj
      if is_product {
        match find_child_in_env(env: env, parent: n, name: field_name) {
          Some { value: field_child } =>
            Some { value: child_type_node(ch: field_child) }
          None => none
        }
      } else {
        lookup_coproduct_common_field_node(variants: n.children, field_name: field_name, env: env)
      }
    } else { none }
  }
}

fn lookup_coproduct_common_field_node(variants: List<Node>, field_name: String, env: TypeEnv) -> Node? {
  let found_in_all = variants |> all(v =>
    has_child_in_env(env: env, parent: v, name: field_name)
  )
  let first_field = if found_in_all {
    match variants |> first {
      Some { value: first_variant } =>
        find_child_in_env(env: env, parent: first_variant, name: field_name)
      None => none
    }
  } else { none }
  match first_field {
    Some { value: field_child } =>
      Some { value: child_type_node(ch: field_child) }
    None => none
  }
}

// =========================================================================
// Scrutinee type resolution
// =========================================================================

type ScrutineeResolveResult {
  node: Node
  env: TypeEnv
}

fn resolve_scrutinee_type_node(env: TypeEnv, n: Node) -> ScrutineeResolveResult {
  let normed = normalize_access_type_node(n: n)
  if normed.connective == NoConnective && normed.children |> count == 0 {
    let canonical = authored_name(env: env, node: normed)
    if canonical != "" {
      match lookup_cache_get_scrutinee(env: env, canonical: canonical) {
        Some { value: cached } =>
          let node = if normed.return_cardinality == CardOptional {
            with_optional_cardinality(n: cached)
          } else { cached }
          ScrutineeResolveResult { node: node, env: env }
        None =>
          let resolved = resolve_scrutinee_type_node_seen(env: env, n: n, seen: empty_map())
          let env = lookup_cache_put_scrutinee(env: env, canonical: canonical, resolved: resolved)
          ScrutineeResolveResult { node: resolved, env: env }
      }
    } else {
      ScrutineeResolveResult {
        node: resolve_scrutinee_type_node_seen(env: env, n: n, seen: empty_map()),
        env: env
      }
    }
  } else {
    ScrutineeResolveResult {
      node: resolve_scrutinee_type_node_seen(env: env, n: n, seen: empty_map()),
      env: env
    }
  }
}

fn warm_scrutinee_cache_for_bindings(env: TypeEnv) -> TypeEnv {
  fold(env.bindings |> map_values, init: env, f: (acc, binding) =>
    let resolved = resolve_scrutinee_type_node_seen(env: acc, n: binding.resolved, seen: empty_map())
    lookup_cache_put_scrutinee(env: acc, canonical: binding.name, resolved: resolved)
  )
}

fn resolve_scrutinee_type_node_seen(env: TypeEnv, n: Node, seen: Map<String, Bool>) -> Node {
  let n_is_type_var = if n.inferred != none { is_type_variable(inferred: n.inferred.value) } else { false }
  if n_is_type_var { return n }
  let normed = normalize_access_type_node(n: n)
  if normed.connective == NoConnective && normed.children |> count > 0 && normed.inferred != none {
    match normed.inferred {
      Some { value: Resolved { node: target } } => resolve_scrutinee_type_node_seen(env: env, n: target, seen: seen)
      _ => normed
    }
  } else if normed.connective == NoConnective && normed.children |> count == 0 {
    let canonical = authored_name(env: env, node: normed)
    if normed.inferred != none {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      match normed.inferred {
        Some { value: Resolved { node: target } } =>
          if authored_name(env: env, node: target) == canonical && target.inferred == none && target.connective == NoConnective && target.children |> count == 0 {
            normed
          } else {
            resolve_scrutinee_type_node_seen(env: env, n: target, seen: next_seen)
          }
        _ => normed
      }
    } else if canonical != "" && emit_map_has(m: seen, key: canonical) {
      nominal_type_ref(name: canonical)
    } else {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      match lookup_type_for(env: env, node: normed) {
        Some { value: resolved } =>
          if authored_name(env: env, node: resolved) == canonical && resolved.inferred == none && resolved.connective == NoConnective && resolved.children |> count == 0 {
            normed
          } else {
            let result = resolve_scrutinee_type_node_seen(env: env, n: resolved, seen: next_seen)
            let is_optional = normed.return_cardinality == CardOptional
            if is_optional { with_optional_cardinality(n: result) } else { result }
          }
        None => normed
      }
    }
  } else { normed }
}

fn map_value_type_in_env(type_node: Node, env: TypeEnv) -> Node? {
  let normed = normalize_access_type_node(n: type_node)
  let scrut_result = resolve_scrutinee_type_node(env: env, n: normed)
  let resolved = scrut_result.node
  let map_type = normalize_access_type_node(n: resolved)
  if node_is_keyed_collection(n: map_type, source_indices: env.source_indices) && map_type.children |> count >= 2 {
    match map_type.children |> skip(1) |> first {
      Some { value: value_type } => Some { value: value_type }
      None => none
    }
  } else {
    none
  }
}

fn map_key_type_in_env(type_node: Node, env: TypeEnv) -> Node? {
  let normed = normalize_access_type_node(n: type_node)
  let scrut_result = resolve_scrutinee_type_node(env: env, n: normed)
  let resolved = scrut_result.node
  let map_type = normalize_access_type_node(n: resolved)
  if node_is_keyed_collection(n: map_type, source_indices: env.source_indices) && map_type.children |> count >= 1 {
    match map_type.children |> first {
      Some { value: key_type } => Some { value: key_type }
      None => none
    }
  } else {
    none
  }
}

fn set_element_type_in_env(type_node: Node, env: TypeEnv) -> Node? {
  let normed = normalize_access_type_node(n: type_node)
  let scrut_result = resolve_scrutinee_type_node(env: env, n: normed)
  let resolved = scrut_result.node
  let set_type = normalize_access_type_node(n: resolved)
  if node_is_set_collection(n: set_type, source_indices: env.source_indices) && set_type.children |> count >= 1 {
    match set_type.children |> first {
      Some { value: elem_type } => Some { value: elem_type }
      None => none
    }
  } else {
    none
  }
}

fn field_summary_for_type(base_type: Node, env: TypeEnv, field: String) -> FieldSummary? {
  let scrut_result = resolve_scrutinee_type_node(env: env, n: base_type)
  let resolved = scrut_result.node
  let normed = normalize_access_type_node(n: resolved)
  let normed_opt = normed.return_cardinality == CardOptional
  if field == "value" && normed_opt {
    Some { value: FieldSummary { access_style: OptionalUnwrap, value_shape: PlainValue } }
  } else if normed_opt {
    let inner = with_required_cardinality(n: normed)
    match field_summary_for_type(base_type: inner, env: env, field: field) {
      Some { value: inner_summary } =>
        Some { value: FieldSummary {
          access_style: inner_summary.access_style,
          value_shape: OptionalValue
        } }
      None => none
    }
  } else {
    let no_structure = resolved.connective == NoConnective
    if no_structure {
      none
    } else {
      let is_product = resolved.connective == Conj
      if is_product {
        map_get(build_struct_field_summaries(parent: resolved, source_indices: env.source_indices), field)
      } else {
        map_get(build_enum_field_summaries(variants: resolved.children, source_indices: env.source_indices), field)
      }
    }
  }
}

// =========================================================================
// Known method resolution
// =========================================================================

type MethodFieldResult {
  field_node: Node
  result_type: Node
  size_effect: CollectionSizeEffect?
  cost_shape: CostShape?
  algebra_template: AlgebraFieldTemplate?
}

type StructuralMethodLookup {
  resolution: MethodFieldResult?
  kernel_diagnostics: List<ErrorNode>
}

type EnrichedKernelResult {
  ty: Node
  env: TypeEnv
}

type StructuralMethodLookupResult {
  lookup: StructuralMethodLookup
  env: TypeEnv
}

type KnownMethodResolutionResult {
  resolution: KnownMethodResolution
  env: TypeEnv
}

fn lookup_field_in_product(env: TypeEnv, product: Node, method_name: String) -> MethodFieldResult? {
  match find_child_in_env(env: env, parent: product, name: method_name) {
    Some { value: field } =>
      match field.inferred {
        Some { value: Resolved { node: rt } } =>
          if rt.params |> count > 0 {
            match rt.inferred {
              Some { value: Resolved { node: return_type } } => Some { value: MethodFieldResult { field_node: field, result_type: return_type, size_effect: none, cost_shape: none, algebra_template: none } }
              _ => Some { value: MethodFieldResult { field_node: field, result_type: rt, size_effect: none, cost_shape: none, algebra_template: none } }
            }
          } else {
            Some { value: MethodFieldResult { field_node: field, result_type: rt, size_effect: none, cost_shape: none, algebra_template: none } }
          }
        _ => none
      }
    None => none
  }
}

fn enrich_kernel_type_cached(env: TypeEnv, name: String, base: Node) -> EnrichedKernelResult {
  let key = enriched_kernel_cache_key(name: name, base: base)
  match lookup_cache_get_enriched_kernel(env: env, key: key) {
    Some { value: cached } => EnrichedKernelResult { ty: cached, env: env }
    None =>
      let built = enrich_kernel_type(name: name, base: base, source_indices: env.source_indices)
      let updated = lookup_cache_put_enriched_kernel(env: env, key: key, enriched: built.ty)
      EnrichedKernelResult { ty: built.ty, env: updated }
  }
}

fn lookup_structural_method(env: TypeEnv, receiver_type: Node, method_name: String) -> StructuralMethodLookupResult {
  let is_product = receiver_type.connective == Conj
  if is_product {
    let direct = lookup_field_in_product(env: env, product: receiver_type, method_name: method_name)
    StructuralMethodLookupResult { lookup: StructuralMethodLookup { resolution: direct, kernel_diagnostics: [] }, env: env }
  } else {
    let receiver_name = authored_name(env: env, node: receiver_type)
    let enriched = enrich_kernel_type_cached(env: env, name: receiver_name, base: receiver_type)
    let env = enriched.env
    if enriched.ty.connective == Conj && enriched.ty.children |> count > 0 {
      let base_result = lookup_field_in_product(env: env, product: enriched.ty, method_name: method_name)
      match base_result {
        Some { value: mfr } =>
          let profile = kernel_algebra_profile |> get(receiver_name)
          let template_match = match profile {
            Some { value: p } =>
              let templates = algebra_templates_for_profile(profile: p)
              templates |> filter(t => t.name == method_name) |> first
            None => none
          }
          let resolution = match template_match {
            Some { value: t } =>
              Some { value: MethodFieldResult { field_node: mfr.field_node, result_type: mfr.result_type, size_effect: t.size_effect, cost_shape: t.cost_shape, algebra_template: Some { value: t } } }
            None => base_result
          }
          StructuralMethodLookupResult { lookup: StructuralMethodLookup { resolution: resolution, kernel_diagnostics: [] }, env: env }
        None => StructuralMethodLookupResult { lookup: StructuralMethodLookup { resolution: none, kernel_diagnostics: [] }, env: env }
      }
    } else {
      StructuralMethodLookupResult { lookup: StructuralMethodLookup { resolution: none, kernel_diagnostics: [] }, env: env }
    }
  }
}

fn resolve_known_method_node(receiver: Node, env: TypeEnv, receiver_type: Node, method_name: String, fold_accumulator_type: Node?, service_registry: Map<String, List<OpEntry>>) -> KnownMethodResolutionResult {
  let tier0 = lookup_structural_method(env: env, receiver_type: receiver_type, method_name: method_name)
  let env = tier0.env
  match tier0.lookup.resolution {
    Some { value: mfr } =>
      let semantics = AlgebraMethodSemantics { method_def: mfr.field_node, fold_accumulator_type: fold_accumulator_type, size_effect: mfr.size_effect, cost_shape: mfr.cost_shape, algebra_template: mfr.algebra_template }
      KnownMethodResolutionResult {
        resolution: KnownMethodResolution {
          semantics: Some { value: semantics },
          result_type: Some { value: mfr.result_type },
          diagnostics: tier0.lookup.kernel_diagnostics
        },
        env: env
      }
    None =>
  match check_service_method_call_node(receiver_type: receiver_type, method: method_name, service_registry: service_registry, source_indices: env.source_indices) {
    Some { value: svc_result } =>
      KnownMethodResolutionResult {
        resolution: KnownMethodResolution {
          semantics: Some { value: ServiceMethodSemantics { service_name: authored_name(env: env, node: receiver_type), op_params: svc_result.op_params } },
          result_type: Some { value: svc_result.result_type },
          diagnostics: tier0.lookup.kernel_diagnostics
        },
        env: env
      }
    None =>
      KnownMethodResolutionResult {
        resolution: KnownMethodResolution { semantics: none, result_type: none, diagnostics: tier0.lookup.kernel_diagnostics },
        env: env
      }
  }
  }
}
