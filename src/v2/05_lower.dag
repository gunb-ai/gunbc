// v2 lowering stage -- Expr trees to target-agnostic dataflow graphs.
//
// This module establishes the lowered boundary without switching the
// pipeline yet. The first implementation focuses on mechanical lowering
// for the straightforward expression shapes and preserves totality with
// a placeholder fallback for the remaining variants.

module v2.compiler.lower

import v2.std.core {
  Node, Param, Expr, NamedArg, MatchArm, MatchPattern, FieldBinding,
  FieldInit, StringPart,
  LiteralValue, LitStr, LitInt, LitFloat, LitBool, LitNull,
  BinOpKind, Add, Sub, Mul, Div, Mod,
  BinEq, BinNe, BinLt, BinGt, BinLe, BinGe, BinAnd, BinOr, NullCoalesce,
  UnaryOpKind, Not, Neg,
  Text, Interpolation,
  Literal, Var, FieldAccess, Call, MethodCall, Match, If, Let,
  RecordLit, ListLit, BinOp, UnaryOp, Lambda, StringInterp,
  Block, Cast, ForEach, Index, Slice, Return,
  ItemInfo, OtherItem,
  DfNode, DfProduce, DfRefer, DfBind, DfCompose, DfSelect, DfApply,
  DfCombine, DfSwitch, DfReplicate, DfGate, DfSequence, DfFormat,
  DfGraph, DfSubGraph, DfParam, DfField, DfInput, DfArm,
  DfFormatPart, DfTextPart, DfExprPart,
  DfPattern, DfWildcard, DfLiteralPat, DfVariantPat, DfBindPat,
  DfPatBinding,
  DfValue, DfInt, DfFloat, DfBool, DfString, DfNull, DfList, DfRecord,
  DfFieldValue,
  DfOp, DfAdd, DfSub, DfMul, DfDiv, DfMod,
  DfEq, DfNe, DfLt, DfGt, DfLe, DfGe, DfAnd, DfOr, DfNullCoalesce, DfNot,
  DfModule, DfItem, DfFuncDef, DfTypeDef, DfServiceDef, DfDataDef,
  LoweredGraph
}

import v2.compiler.reconcile {
  TypedGraph, TypedModule, InferScope
}

type LowerExprResult {
  graph: DfGraph
  next_id: Int
}

type LowerInputsState {
  inputs: List<DfInput>
  nodes: List<DfNode>
  subgraphs: Map<String, DfSubGraph>
  next_id: Int
}

type LowerFieldsState {
  fields: List<DfField>
  nodes: List<DfNode>
  subgraphs: Map<String, DfSubGraph>
  next_id: Int
}

type LowerFormatState {
  parts: List<DfFormatPart>
  nodes: List<DfNode>
  subgraphs: Map<String, DfSubGraph>
  next_id: Int
}

type LowerArmsState {
  arms: List<DfArm>
  next_id: Int
}

type LowerStepsState {
  steps: List<DfGraph>
  next_id: Int
}

fn empty_graph() -> DfGraph {
  DfGraph { nodes: [], output: "", subgraphs: empty_map() }
}

fn graph_with(node: DfNode, output: String) -> DfGraph {
  DfGraph { nodes: [node], output: output, subgraphs: empty_map() }
}

fn merge_subgraphs(left: Map<String, DfSubGraph>, right: Map<String, DfSubGraph>) -> Map<String, DfSubGraph> {
  fold(map_keys(right), init: left, f: (acc, key) =>
    match map_get(right, key) {
      Some { value: subgraph } => map_insert(acc, key, subgraph)
      None => acc
    }
  )
}

fn merge_graphs(left: DfGraph, right: DfGraph) -> DfGraph {
  DfGraph {
    nodes: concat(left.nodes, right.nodes),
    output: right.output,
    subgraphs: merge_subgraphs(left: left.subgraphs, right: right.subgraphs)
  }
}

fn fresh_name(prefix: String, counter: Int) -> String {
  concat(prefix, to_string(value: counter))
}

fn expr_type(expr: Expr) -> Node? {
  match expr {
    Literal { value: _, resolved_type: rt, span: _ } => rt
    Var { name: _, resolved_type: rt, span: _ } => rt
    FieldAccess { base: _, field: _, resolved_type: rt, span: _ } => rt
    Call { func: _, args: _, resolved_type: rt, span: _ } => rt
    MethodCall { receiver: _, method: _, args: _, resolved_type: rt, span: _ } => rt
    Match { scrutinee: _, arms: _, resolved_type: rt, span: _ } => rt
    If { condition: _, then_branch: _, else_branch: _, resolved_type: rt, span: _ } => rt
    Let { name: _, value: _, body: _, resolved_type: rt, span: _ } => rt
    RecordLit { type_name: _, fields: _, resolved_type: rt, span: _ } => rt
    ListLit { elements: _, resolved_type: rt, span: _ } => rt
    BinOp { op: _, left: _, right: _, resolved_type: rt, span: _ } => rt
    UnaryOp { op: _, operand: _, resolved_type: rt, span: _ } => rt
    Lambda { params: _, body: _, resolved_type: rt, span: _ } => rt
    StringInterp { parts: _, resolved_type: rt, span: _ } => rt
    Block { stmts: _, resolved_type: rt, span: _ } => rt
    Cast { expr: _, target: _, resolved_type: rt, span: _ } => rt
    ForEach { variable: _, collection: _, body: _, resolved_type: rt, span: _ } => rt
    Index { base: _, index: _, resolved_type: rt, span: _ } => rt
    Slice { base: _, start: _, end: _, resolved_type: rt, span: _ } => rt
    Return { value: _, resolved_type: rt, span: _ } => rt
  }
}

fn literal_to_df_value(value: LiteralValue) -> DfValue {
  match value {
    LitInt { value: i } => DfInt { value: i }
    LitFloat { value: f } => DfFloat { value: f }
    LitBool { value: b } => DfBool { value: b }
    LitStr { value: s } => DfString { value: s }
    LitNull => DfNull
  }
}

fn bin_op_to_df_op(op: BinOpKind) -> DfOp {
  match op {
    Add => DfAdd
    Sub => DfSub
    Mul => DfMul
    Div => DfDiv
    Mod => DfMod
    BinEq => DfEq
    BinNe => DfNe
    BinLt => DfLt
    BinGt => DfGt
    BinLe => DfLe
    BinGe => DfGe
    BinAnd => DfAnd
    BinOr => DfOr
    NullCoalesce => DfNullCoalesce
  }
}

fn pattern_binding_name(pattern: MatchPattern) -> String {
  match pattern {
    Bind { name: n } => n
    Wildcard => "_"
    LitPattern { value: _ } => "_"
    VariantPattern { name: n, field_bindings: _ } => n
  }
}

fn lower_pattern(pattern: MatchPattern) -> DfPattern {
  match pattern {
    Wildcard => DfWildcard
    Bind { name: n } => DfBindPat { name: n }
    LitPattern { value: v } => DfLiteralPat { value: literal_to_df_value(value: v) }
    VariantPattern { name: n, field_bindings: bindings } =>
      DfVariantPat {
        variant: n,
        bindings: bindings |> map(binding =>
          DfPatBinding {
            field: binding.field_name,
            binding: pattern_binding_name(pattern: binding.binding)
          }
        )
      }
  }
}

fn lower_named_args(args: List<NamedArg>, next_id: Int, scope: InferScope) -> LowerInputsState {
  let indexed = args |> enumerate
  indexed |> fold(init: LowerInputsState {
    inputs: [],
    nodes: [],
    subgraphs: empty_map(),
    next_id: next_id
  }, f: (acc, pair) =>
    let lowered = lower_expr_from(expr: pair.second.value, scope: scope, next_id: acc.next_id)
    let param_name = if pair.second.name == none {
      concat("arg", to_string(value: pair.first))
    } else {
      pair.second.name.value
    }
    LowerInputsState {
      inputs: list_push(acc.inputs, DfInput { param: param_name, source: lowered.graph.output }),
      nodes: concat(acc.nodes, lowered.graph.nodes),
      subgraphs: merge_subgraphs(left: acc.subgraphs, right: lowered.graph.subgraphs),
      next_id: lowered.next_id
    }
  )
}

fn lower_field_inits(fields: List<FieldInit>, next_id: Int, scope: InferScope) -> LowerFieldsState {
  fields |> fold(init: LowerFieldsState {
    fields: [],
    nodes: [],
    subgraphs: empty_map(),
    next_id: next_id
  }, f: (acc, field_init) =>
    let lowered = lower_expr_from(expr: field_init.value, scope: scope, next_id: acc.next_id)
    LowerFieldsState {
      fields: list_push(acc.fields, DfField { name: field_init.name, source: lowered.graph.output }),
      nodes: concat(acc.nodes, lowered.graph.nodes),
      subgraphs: merge_subgraphs(left: acc.subgraphs, right: lowered.graph.subgraphs),
      next_id: lowered.next_id
    }
  )
}

fn lower_format_parts(parts: List<StringPart>, next_id: Int, scope: InferScope) -> LowerFormatState {
  parts |> fold(init: LowerFormatState {
    parts: [],
    nodes: [],
    subgraphs: empty_map(),
    next_id: next_id
  }, f: (acc, part) =>
    match part {
      Text { value: value } =>
        LowerFormatState {
          parts: list_push(acc.parts, DfTextPart { value: value }),
          nodes: acc.nodes,
          subgraphs: acc.subgraphs,
          next_id: acc.next_id
        }
      Interpolation { expr: expr } =>
        let lowered = lower_expr_from(expr: expr, scope: scope, next_id: acc.next_id)
        LowerFormatState {
          parts: list_push(acc.parts, DfExprPart { source: lowered.graph.output }),
          nodes: concat(acc.nodes, lowered.graph.nodes),
          subgraphs: merge_subgraphs(left: acc.subgraphs, right: lowered.graph.subgraphs),
          next_id: lowered.next_id
        }
    }
  )
}

fn lower_match_arms(arms: List<MatchArm>, next_id: Int, scope: InferScope) -> LowerArmsState {
  arms |> fold(init: LowerArmsState { arms: [], next_id: next_id }, f: (acc, arm) =>
    let body_result = lower_expr_from(expr: arm.body, scope: scope, next_id: acc.next_id)
    let guard_result = match arm.guard {
      Some { value: guard_expr } => Some { value: lower_expr_from(expr: guard_expr, scope: scope, next_id: body_result.next_id) }
      None => none
    }
    let guarded_body = if guard_result == none {
      body_result.graph
    } else {
      let seq_name = fresh_name(prefix: "_v", counter: guard_result.value.next_id)
      graph_with(
        node: DfSequence {
          name: seq_name,
          steps: [guard_result.value.graph, body_result.graph],
          resolved_type: expr_type(expr: arm.body)
        },
        output: seq_name
      )
    }
    LowerArmsState {
      arms: list_push(acc.arms, DfArm {
        pattern: lower_pattern(pattern: arm.pattern),
        guard: if guard_result == none { none } else { Some { value: guard_result.value.graph.output } },
        body: guarded_body
      }),
      next_id: if guard_result == none { body_result.next_id } else { guard_result.value.next_id + 1 }
    }
  )
}

fn lower_steps(stmts: List<Expr>, next_id: Int, scope: InferScope) -> LowerStepsState {
  stmts |> fold(init: LowerStepsState { steps: [], next_id: next_id }, f: (acc, stmt) =>
    let lowered = lower_expr_from(expr: stmt, scope: scope, next_id: acc.next_id)
    LowerStepsState {
      steps: list_push(acc.steps, lowered.graph),
      next_id: lowered.next_id
    }
  )
}

fn lower_expr(expr: Expr, scope: InferScope) -> DfGraph {
  let result = lower_expr_from(expr: expr, scope: scope, next_id: 0)
  result.graph
}

fn lower_expr_from(expr: Expr, scope: InferScope, next_id: Int) -> LowerExprResult {
  match expr {
    Literal { value: value, resolved_type: resolved_type, span: _ } =>
      let name = fresh_name(prefix: "_v", counter: next_id)
      LowerExprResult {
        graph: graph_with(
          node: DfProduce { name: name, value: literal_to_df_value(value: value), resolved_type: resolved_type },
          output: name
        ),
        next_id: next_id + 1
      }

    Var { name: source, resolved_type: resolved_type, span: _ } =>
      let name = fresh_name(prefix: "_v", counter: next_id)
      LowerExprResult {
        graph: graph_with(
          node: DfRefer { name: name, source: source, resolved_type: resolved_type },
          output: name
        ),
        next_id: next_id + 1
      }

    FieldAccess { base: base, field: field, resolved_type: resolved_type, span: _ } =>
      let base_result = lower_expr_from(expr: base, scope: scope, next_id: next_id)
      let name = fresh_name(prefix: "_v", counter: base_result.next_id)
      LowerExprResult {
        graph: merge_graphs(
          left: base_result.graph,
          right: graph_with(
            node: DfSelect { name: name, source: base_result.graph.output, field: field, resolved_type: resolved_type },
            output: name
          )
        ),
        next_id: base_result.next_id + 1
      }

    Call { func: func, args: args, resolved_type: resolved_type, span: _ } =>
      let arg_state = lower_named_args(args: args, next_id: next_id, scope: scope)
      let name = fresh_name(prefix: "_v", counter: arg_state.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(arg_state.nodes, DfApply {
            name: name,
            transform: func,
            inputs: arg_state.inputs,
            resolved_type: resolved_type
          }),
          output: name,
          subgraphs: arg_state.subgraphs
        },
        next_id: arg_state.next_id + 1
      }

    MethodCall { receiver: receiver, method: method, args: args, resolved_type: resolved_type, span: _ } =>
      let receiver_result = lower_expr_from(expr: receiver, scope: scope, next_id: next_id)
      let arg_state = lower_named_args(args: args, next_id: receiver_result.next_id, scope: scope)
      let name = fresh_name(prefix: "_v", counter: arg_state.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(
            concat(receiver_result.graph.nodes, arg_state.nodes),
            DfApply {
              name: name,
              transform: method,
              inputs: list_push(arg_state.inputs, DfInput { param: "self", source: receiver_result.graph.output }),
              resolved_type: resolved_type
            }
          ),
          output: name,
          subgraphs: merge_subgraphs(left: receiver_result.graph.subgraphs, right: arg_state.subgraphs)
        },
        next_id: arg_state.next_id + 1
      }

    Match { scrutinee: scrutinee, arms: arms, resolved_type: resolved_type, span: _ } =>
      let scrutinee_result = lower_expr_from(expr: scrutinee, scope: scope, next_id: next_id)
      let arm_state = lower_match_arms(arms: arms, next_id: scrutinee_result.next_id, scope: scope)
      let name = fresh_name(prefix: "_v", counter: arm_state.next_id)
      LowerExprResult {
        graph: merge_graphs(
          left: scrutinee_result.graph,
          right: graph_with(
            node: DfSwitch {
              name: name,
              scrutinee: scrutinee_result.graph.output,
              arms: arm_state.arms,
              resolved_type: resolved_type
            },
            output: name
          )
        ),
        next_id: arm_state.next_id + 1
      }

    If { condition: condition, then_branch: then_branch, else_branch: else_branch, resolved_type: resolved_type, span: _ } =>
      let cond_result = lower_expr_from(expr: condition, scope: scope, next_id: next_id)
      let then_result = lower_expr_from(expr: then_branch, scope: scope, next_id: cond_result.next_id)
      let else_result = match else_branch {
        Some { value: else_expr } => Some { value: lower_expr_from(expr: else_expr, scope: scope, next_id: then_result.next_id) }
        None => none
      }
      let name = fresh_name(prefix: "_v", counter: if else_result == none { then_result.next_id } else { else_result.value.next_id })
      LowerExprResult {
        graph: merge_graphs(
          left: cond_result.graph,
          right: graph_with(
            node: DfGate {
              name: name,
              condition: cond_result.graph.output,
              then_graph: then_result.graph,
              else_graph: if else_result == none { none } else { Some { value: else_result.value.graph } },
              resolved_type: resolved_type
            },
            output: name
          )
        ),
        next_id: if else_result == none { then_result.next_id + 1 } else { else_result.value.next_id + 1 }
      }

    Let { name: bind_name, value: value, body: body, resolved_type: resolved_type, span: _ } =>
      let value_result = lower_expr_from(expr: value, scope: scope, next_id: next_id)
      let bind_graph = graph_with(
        node: DfBind { name: bind_name, source: value_result.graph.output, resolved_type: expr_type(expr: value) },
        output: bind_name
      )
      match body {
        Some { value: body_expr } =>
          let body_result = lower_expr_from(expr: body_expr, scope: scope, next_id: value_result.next_id)
          LowerExprResult {
            graph: DfGraph {
              nodes: concat(concat(value_result.graph.nodes, bind_graph.nodes), body_result.graph.nodes),
              output: body_result.graph.output,
              subgraphs: merge_subgraphs(
                left: merge_subgraphs(left: value_result.graph.subgraphs, right: bind_graph.subgraphs),
                right: body_result.graph.subgraphs
              )
            },
            next_id: body_result.next_id
          }
        None =>
          LowerExprResult {
            graph: DfGraph {
              nodes: concat(value_result.graph.nodes, bind_graph.nodes),
              output: bind_name,
              subgraphs: merge_subgraphs(left: value_result.graph.subgraphs, right: bind_graph.subgraphs)
            },
            next_id: value_result.next_id
          }
      }

    RecordLit { type_name: type_name, fields: fields, resolved_type: resolved_type, span: _ } =>
      let field_state = lower_field_inits(fields: fields, next_id: next_id, scope: scope)
      let name = fresh_name(prefix: "_v", counter: field_state.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(field_state.nodes, DfCompose {
            name: name,
            type_name: type_name,
            fields: field_state.fields,
            resolved_type: resolved_type
          }),
          output: name,
          subgraphs: field_state.subgraphs
        },
        next_id: field_state.next_id + 1
      }

    ListLit { elements: elements, resolved_type: resolved_type, span: _ } =>
      let args = elements |> enumerate |> map(pair => NamedArg { name: Some { value: concat("arg", to_string(value: pair.first)) }, value: pair.second })
      let arg_state = lower_named_args(args: args, next_id: next_id, scope: scope)
      let name = fresh_name(prefix: "_v", counter: arg_state.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(arg_state.nodes, DfApply {
            name: name,
            transform: "list",
            inputs: arg_state.inputs,
            resolved_type: resolved_type
          }),
          output: name,
          subgraphs: arg_state.subgraphs
        },
        next_id: arg_state.next_id + 1
      }

    BinOp { op: op, left: left, right: right, resolved_type: resolved_type, span: _ } =>
      let left_result = lower_expr_from(expr: left, scope: scope, next_id: next_id)
      let right_result = lower_expr_from(expr: right, scope: scope, next_id: left_result.next_id)
      let name = fresh_name(prefix: "_v", counter: right_result.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(
            concat(left_result.graph.nodes, right_result.graph.nodes),
            DfCombine {
              name: name,
              op: bin_op_to_df_op(op: op),
              left: left_result.graph.output,
              right: right_result.graph.output,
              resolved_type: resolved_type
            }
          ),
          output: name,
          subgraphs: merge_subgraphs(left: left_result.graph.subgraphs, right: right_result.graph.subgraphs)
        },
        next_id: right_result.next_id + 1
      }

    UnaryOp { op: op, operand: operand, resolved_type: resolved_type, span: _ } =>
      let operand_result = lower_expr_from(expr: operand, scope: scope, next_id: next_id)
      let name = fresh_name(prefix: "_v", counter: operand_result.next_id)
      match op {
        Not =>
          LowerExprResult {
            graph: DfGraph {
              nodes: list_push(operand_result.graph.nodes, DfCombine {
                name: name,
                op: DfNot,
                left: operand_result.graph.output,
                right: operand_result.graph.output,
                resolved_type: resolved_type
              }),
              output: name,
              subgraphs: operand_result.graph.subgraphs
            },
            next_id: operand_result.next_id + 1
          }
        Neg =>
          LowerExprResult {
            graph: DfGraph {
              nodes: list_push(operand_result.graph.nodes, DfApply {
                name: name,
                transform: "neg",
                inputs: [DfInput { param: "value", source: operand_result.graph.output }],
                resolved_type: resolved_type
              }),
              output: name,
              subgraphs: operand_result.graph.subgraphs
            },
            next_id: operand_result.next_id + 1
          }
      }

    Lambda { params: params, body: body, resolved_type: resolved_type, span: _ } =>
      let subgraph_name = fresh_name(prefix: "_sub", counter: next_id)
      let body_result = lower_expr_from(expr: body, scope: scope, next_id: next_id + 1)
      let ref_name = fresh_name(prefix: "_v", counter: body_result.next_id)
      let lambda_subgraph = DfSubGraph {
        name: subgraph_name,
        params: params |> map(p => DfParam { name: p, resolved_type: none }),
        body: body_result.graph,
        is_tco_eligible: false,
        captured: []
      }
      LowerExprResult {
        graph: DfGraph {
          nodes: [DfRefer { name: ref_name, source: subgraph_name, resolved_type: resolved_type }],
          output: ref_name,
          subgraphs: map_insert(body_result.graph.subgraphs, subgraph_name, lambda_subgraph)
        },
        next_id: body_result.next_id + 1
      }

    StringInterp { parts: parts, resolved_type: resolved_type, span: _ } =>
      let part_state = lower_format_parts(parts: parts, next_id: next_id, scope: scope)
      let name = fresh_name(prefix: "_v", counter: part_state.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(part_state.nodes, DfFormat {
            name: name,
            parts: part_state.parts,
            resolved_type: resolved_type
          }),
          output: name,
          subgraphs: part_state.subgraphs
        },
        next_id: part_state.next_id + 1
      }

    Block { stmts: stmts, resolved_type: resolved_type, span: _ } =>
      let step_state = lower_steps(stmts: stmts, next_id: next_id, scope: scope)
      let name = fresh_name(prefix: "_v", counter: step_state.next_id)
      LowerExprResult {
        graph: graph_with(
          node: DfSequence { name: name, steps: step_state.steps, resolved_type: resolved_type },
          output: name
        ),
        next_id: step_state.next_id + 1
      }

    Cast { expr: inner, target: target, resolved_type: resolved_type, span: _ } =>
      let inner_result = lower_expr_from(expr: inner, scope: scope, next_id: next_id)
      let name = fresh_name(prefix: "_v", counter: inner_result.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(inner_result.graph.nodes, DfApply {
            name: name,
            transform: concat("cast:", target.name),
            inputs: [DfInput { param: "value", source: inner_result.graph.output }],
            resolved_type: resolved_type
          }),
          output: name,
          subgraphs: inner_result.graph.subgraphs
        },
        next_id: inner_result.next_id + 1
      }

    ForEach { variable: variable, collection: collection, body: body, resolved_type: resolved_type, span: _ } =>
      let collection_result = lower_expr_from(expr: collection, scope: scope, next_id: next_id)
      let body_result = lower_expr_from(expr: body, scope: scope, next_id: collection_result.next_id)
      let name = fresh_name(prefix: "_v", counter: body_result.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(collection_result.graph.nodes, DfReplicate {
            name: name,
            source: collection_result.graph.output,
            element_var: variable,
            transform_graph: body_result.graph,
            resolved_type: resolved_type
          }),
          output: name,
          subgraphs: merge_subgraphs(left: collection_result.graph.subgraphs, right: body_result.graph.subgraphs)
        },
        next_id: body_result.next_id + 1
      }

    Index { base: base, index: index, resolved_type: resolved_type, span: _ } =>
      let base_result = lower_expr_from(expr: base, scope: scope, next_id: next_id)
      let index_result = lower_expr_from(expr: index, scope: scope, next_id: base_result.next_id)
      let name = fresh_name(prefix: "_v", counter: index_result.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(
            concat(base_result.graph.nodes, index_result.graph.nodes),
            DfApply {
              name: name,
              transform: "index",
              inputs: [
                DfInput { param: "base", source: base_result.graph.output },
                DfInput { param: "index", source: index_result.graph.output }
              ],
              resolved_type: resolved_type
            }
          ),
          output: name,
          subgraphs: merge_subgraphs(left: base_result.graph.subgraphs, right: index_result.graph.subgraphs)
        },
        next_id: index_result.next_id + 1
      }

    Slice { base: base, start: start, end: end, resolved_type: resolved_type, span: _ } =>
      let base_result = lower_expr_from(expr: base, scope: scope, next_id: next_id)
      let start_result = lower_expr_from(expr: start, scope: scope, next_id: base_result.next_id)
      let end_result = lower_expr_from(expr: end, scope: scope, next_id: start_result.next_id)
      let name = fresh_name(prefix: "_v", counter: end_result.next_id)
      LowerExprResult {
        graph: DfGraph {
          nodes: list_push(
            concat(concat(base_result.graph.nodes, start_result.graph.nodes), end_result.graph.nodes),
            DfApply {
              name: name,
              transform: "slice",
              inputs: [
                DfInput { param: "base", source: base_result.graph.output },
                DfInput { param: "start", source: start_result.graph.output },
                DfInput { param: "end", source: end_result.graph.output }
              ],
              resolved_type: resolved_type
            }
          ),
          output: name,
          subgraphs: merge_subgraphs(
            left: merge_subgraphs(left: base_result.graph.subgraphs, right: start_result.graph.subgraphs),
            right: end_result.graph.subgraphs
          )
        },
        next_id: end_result.next_id + 1
      }

    Return { value: value, resolved_type: _, span: _ } =>
      lower_expr_from(expr: value, scope: scope, next_id: next_id)

    _ =>
      let name = fresh_name(prefix: "_v", counter: next_id)
      LowerExprResult {
        graph: graph_with(
          node: DfProduce { name: name, value: DfNull, resolved_type: expr_type(expr: expr) },
          output: name
        ),
        next_id: next_id + 1
      }
  }
}

fn default_item_info(item: Node) -> ItemInfo {
  ItemInfo {
    name: item.name,
    kind: OtherItem,
    service_names: [],
    is_self_recursive: false,
    has_non_tail_self_call: false
  }
}

fn item_info_for(item: Node, registry: Map<String, ItemInfo>) -> ItemInfo {
  match map_get(registry, item.name) {
    Some { value: info } => info
    None => default_item_info(item: item)
  }
}

fn detect_tco(item: Node) -> Bool {
  item.is_self_recursive && item.has_non_tail_self_call == false
}

fn lower_item(item: Node, scope: InferScope, registry: Map<String, ItemInfo>) -> DfItem {
  let info = item_info_for(item: item, registry: registry)
  if item.connective != none && item.transport == none {
    DfTypeDef { item: item }
  } else if item.transport != none && item.children |> count > 0 {
    DfServiceDef { item: item }
  } else if item.body != none && item.type_annotation != none {
    DfDataDef {
      name: item.name,
      type_node: item.type_annotation.value,
      value: lower_expr(expr: item.body.value, scope: scope),
      item_info: info
    }
  } else if item.body != none && item.return_type != none {
    DfFuncDef {
      name: item.name,
      params: item.params,
      return_type: item.return_type.value,
      body: lower_expr(expr: item.body.value, scope: scope),
      is_async: item.uses |> count > 0,
      is_tco: detect_tco(item: item),
      item_info: info
    }
  } else {
    DfTypeDef { item: item }
  }
}

fn lower_module(typed_module: TypedModule, registry: Map<String, ItemInfo>) -> DfModule {
  let scope = InferScope {
    type_env: typed_module.type_env,
    func_env: typed_module.func_env,
    locals: empty_map(),
    module_name: typed_module.module.name,
    service_registry: empty_map()
  }
  DfModule {
    name: typed_module.module.name,
    items: typed_module.items |> map(item => lower_item(item: item, scope: scope, registry: registry))
  }
}

fn lower_graph(typed: TypedGraph) -> LoweredGraph {
  LoweredGraph {
    modules: typed.modules |> map(tm => lower_module(typed_module: tm, registry: typed.item_registry)),
    item_registry: typed.item_registry,
    diagnostics: []
  }
}
