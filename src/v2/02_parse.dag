// v2 parser — recursive descent, first-error-halt.
//
// Consumes a flat List<Token> (from the tokenizer) and produces a
// Module AST. Every production function takes a ParserState and
// returns a record with the result and the advanced state. On error,
// functions return a ParseError record that halts parsing.
//
// Operator precedence (Pratt binding powers):
//   ||          bp 2  (left)
//   &&          bp 4  (left)
//   == != < > <= >=  bp 6  (left)
//   + - +     bp 8  (left, +is list/string concat)
//   * / %       bp 10 (left)
//   ! - (unary) bp 12 (prefix)
//   . () []     bp 14 (postfix, handled separately)

module v2.compiler.parse

import v2.std.core {
  Module, Import, Item, TypeDef, FuncDef, FnDef, ServiceDef,
  ResourceDef, DataDef, ExternFuncDecl,
  TypeExpr, Named, Product, Coproduct, Container, Refined, Optional,
  MapType, Primitive,
  ContainerKind, List, Set, NonEmptyList, NonEmptySet,
  TypeBody, Record, Sum, Alias,
  Field, Variant, Param, ResourceUse,
  Predicate, NonEmpty, Pattern, Range, Brand, ContentEncoding, Format,
  Expr, Literal, Var, FieldAccess, Call, MethodCall, Match, If, Let,
  RecordLit, ListLit, BinOp, UnaryOp, Lambda, StringInterp, Block, Cast,
  NamedArg, MatchArm, FieldInit, MatchPattern, FieldBinding,
  Bind, LitPattern, VariantPattern, Wildcard,
  LiteralValue, LitStr, LitInt, LitFloat, LitBool, LitNull,
  BinOpKind, Add, Sub, Mul, Div, Mod,
  BinEq, BinNe, BinLt, BinGt, BinLe, BinGe, BinAnd, BinOr, Concat, NullCoalesce,
  UnaryOpKind, Not, Neg,
  StringPart, Text, Interpolation,
  TransportBinding, RestBinding, ShellBinding, FileBinding, LocalBinding,
  ServiceConfig, OperationDef, ResponseMapping, MockResponseDef, ExitMapping,
  AuthConfig, HeaderDef, EnvDef, OperationModifier, Idempotent, Readonly, Hermetic,
  CapabilityDef,
  Token, TokenKind,
  KwModule, KwImport, KwType, KwFn, KwFunc, KwService, KwResource,
  KwData, KwExtern, KwInterface, KwPipeline, KwProfile, KwPattern,
  KwLet, KwReturn, KwMatch, KwIf, KwElse, KwFor, KwIn, KwWhere, KwWith,
  KwTrue, KwFalse, KwNone,
  KwAcquire, KwRelease, KwCapability, KwOperation, KwInput, KwOutput,
  KwIdempotent, KwReadonly, KwHermetic,
  LBrace, RBrace, LParen, RParen, LBracket, RBracket,
  Lt, Gt, Le, Ge, FatArrow, Arrow,
  Colon, Comma, Dot, Eq, EqEq, Ne,
  Plus, Minus, Star, Slash, Percent, Bang, And, Or,
  Question, NullCoalesce, Pipe, PipeArrow,
  Ident, StrBegin, StrMid, StrEnd,
  Newline, Eof, Unknown,
  Diagnostic, Severity, Error, Warning, Info,
  SourceSpan
}

// =========================================================================
// Parser state types
// =========================================================================

type ParserState {
  tokens: List<Token>
  pos: Int
}

type ParseResult {
  module: Module?
  error: Diagnostic?
}

// Generic result used by all productions. The `err` field is None
// on success and Some(Diagnostic) on failure. Callers check `err`
// before using `val`.
type PR {
  val: Map
  state: ParserState
  err: Diagnostic?
}

// =========================================================================
// Helpers
// =========================================================================

fn peek(state: ParserState) -> Token? {
  if state.pos >= count(state.tokens) {
    none
  } else {
    first(skip(state.tokens, n: state.pos))
  }
}

fn peek_kind(state: ParserState) -> TokenKind? {
  let tok = peek(state: state)
  match tok {
    Some { value: t } => Some { value: t.kind }
    None => none
  }
}

fn at_end(state: ParserState) -> Bool {
  state.pos >= count(state.tokens)
}

fn current_span(state: ParserState) -> SourceSpan {
  let tok = peek(state: state)
  match tok {
    Some { value: t } => t.span
    None => SourceSpan { start: 0, end: 0 }
  }
}

fn advance(state: ParserState) -> Map {
  let tok = peek(state: state)
  match tok {
    Some { value: t } => {
      let next = with(state, { pos: state.pos + 1 })
      { token: t, state: next }
    }
    None => {
      let eof_tok = Token { kind: Eof, span: SourceSpan { start: 0, end: 0 } }
      { token: eof_tok, state: state }
    }
  }
}

fn parse_error(msg: String, span: SourceSpan) -> Diagnostic {
  Diagnostic {
    severity: Error,
    message: msg,
    span: Some { value: span },
    module_name: none
  }
}

fn ok(val: Map, state: ParserState) -> PR {
  PR { val: val, state: state, err: none }
}

fn fail(msg: String, state: ParserState) -> PR {
  let span = current_span(state: state)
  PR { val: {}, state: state, err: Some { value: parse_error(msg: msg, span: span) } }
}

fn is_err(pr: PR) -> Bool {
  match pr.err {
    Some { value: _ } => true
    None => false
  }
}

// Token kind comparison helpers. Since TokenKind is a sum type with
// payload variants, we compare by extracting a tag string.
fn kind_tag(kind: TokenKind) -> String {
  match kind {
    KwModule => "KwModule"
    KwImport => "KwImport"
    KwType => "KwType"
    KwFn => "KwFn"
    KwFunc => "KwFunc"
    KwService => "KwService"
    KwResource => "KwResource"
    KwData => "KwData"
    KwExtern => "KwExtern"
    KwInterface => "KwInterface"
    KwPipeline => "KwPipeline"
    KwProfile => "KwProfile"
    KwPattern => "KwPattern"
    KwLet => "KwLet"
    KwReturn => "KwReturn"
    KwMatch => "KwMatch"
    KwIf => "KwIf"
    KwElse => "KwElse"
    KwFor => "KwFor"
    KwIn => "KwIn"
    KwWhere => "KwWhere"
    KwWith => "KwWith"
    KwTrue => "KwTrue"
    KwFalse => "KwFalse"
    KwNone => "KwNone"
    KwAcquire => "KwAcquire"
    KwRelease => "KwRelease"
    KwCapability => "KwCapability"
    KwOperation => "KwOperation"
    KwInput => "KwInput"
    KwOutput => "KwOutput"
    KwIdempotent => "KwIdempotent"
    KwReadonly => "KwReadonly"
    KwHermetic => "KwHermetic"
    LBrace => "LBrace"
    RBrace => "RBrace"
    LParen => "LParen"
    RParen => "RParen"
    LBracket => "LBracket"
    RBracket => "RBracket"
    Lt => "Lt"
    Gt => "Gt"
    Le => "Le"
    Ge => "Ge"
    FatArrow => "FatArrow"
    Arrow => "Arrow"
    Colon => "Colon"
    Comma => "Comma"
    Dot => "Dot"
    Eq => "Eq"
    EqEq => "EqEq"
    Ne => "Ne"
    Plus => "Plus"
    Minus => "Minus"
    Star => "Star"
    Slash => "Slash"
    Percent => "Percent"
    Bang => "Bang"
    And => "And"
    Or => "Or"
    Question => "Question"
    NullCoalesce => "NullCoalesce"
    Pipe => "Pipe"
    PipeArrow => "PipeArrow"
    LitStr { value: _ } => "LitStr"
    LitInt { value: _ } => "LitInt"
    LitFloat { value: _ } => "LitFloat"
    Ident { name: _ } => "Ident"
    StrBegin { value: _ } => "StrBegin"
    StrMid { value: _ } => "StrMid"
    StrEnd { value: _ } => "StrEnd"
    Newline => "Newline"
    Eof => "Eof"
    Unknown { char: _ } => "Unknown"
  }
}

fn check(state: ParserState, tag: String) -> Bool {
  let k = peek_kind(state: state)
  match k {
    Some { value: kind } => kind_tag(kind: kind) == tag
    None => false
  }
}

fn expect(state: ParserState, tag: String) -> PR {
  if check(state: state, tag: tag) {
    let adv = advance(state: state)
    ok(val: { token: adv.token }, state: adv.state)
  } else {
    let k = peek_kind(state: state)
    let found = match k {
      Some { value: kind } => kind_tag(kind: kind)
      None => "EOF"
    }
    fail(msg: "expected {tag}, found {found}", state: state)
  }
}

fn expect_ident(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: Ident { name: n } } => {
      let adv = advance(state: state)
      ok(val: { name: n }, state: adv.state)
    }
    _ => {
      let found = match k {
        Some { value: kind } => kind_tag(kind: kind)
        None => "EOF"
      }
      fail(msg: "expected identifier, found {found}", state: state)
    }
  }
}

fn skip_newlines(state: ParserState) -> ParserState {
  if check(state: state, tag: "Newline") {
    let adv = advance(state: state)
    skip_newlines(state: adv.state)
  } else {
    state
  }
}

// Eat: consume the token if it matches, otherwise leave state unchanged.
fn eat(state: ParserState, tag: String) -> Map {
  if check(state: state, tag: tag) {
    let adv = advance(state: state)
    { consumed: true, state: adv.state, token: adv.token }
  } else {
    { consumed: false, state: state, token: none }
  }
}

// Check if current token is an identifier (has Ident tag)
fn is_ident(state: ParserState) -> Bool {
  check(state: state, tag: "Ident")
}

// =========================================================================
// Helper: parse a dotted identifier path (e.g., "v2.std.core")
// =========================================================================

fn parse_dotted_ident(state: ParserState) -> PR {
  let r = expect_ident(state: state)
  if is_err(pr: r) { return r }
  parse_dotted_ident_rest(state: r.state, acc: r.val.name)
}

fn parse_dotted_ident_rest(state: ParserState, acc: String) -> PR {
  let e = eat(state: state, tag: "Dot")
  if e.consumed {
    let r = expect_ident(state: e.state)
    if is_err(pr: r) { return r }
    parse_dotted_ident_rest(state: r.state, acc: "{acc}.{r.val.name}")
  } else {
    ok(val: { name: acc }, state: state)
  }
}

// =========================================================================
// 1. Entry point
// =========================================================================

fn parse(tokens: List<Token>) -> ParseResult {
  let state = ParserState { tokens: tokens, pos: 0 }
  let r = parse_module(state: state)
  if is_err(pr: r) {
    ParseResult { module: none, error: r.err }
  } else {
    ParseResult { module: Some { value: r.val.module }, error: none }
  }
}

// =========================================================================
// 2. parse_module
// =========================================================================

fn parse_module(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  let start_span = current_span(state: s)

  // module path.name
  let r = expect(state: s, tag: "KwModule")
  if is_err(pr: r) { return r }
  let s = r.state

  let r = parse_dotted_ident(state: s)
  if is_err(pr: r) { return r }
  let mod_name = r.val.name
  let s = skip_newlines(state: r.state)

  // imports
  let r = parse_imports(state: s)
  if is_err(pr: r) { return r }
  let imports = r.val.imports
  let s = r.state

  // items
  let r = parse_items(state: s)
  if is_err(pr: r) { return r }
  let items = r.val.items
  let s = r.state

  let mod = Module {
    name: mod_name,
    imports: imports,
    items: items,
    span: start_span
  }
  ok(val: { module: mod }, state: s)
}

fn parse_imports(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "KwImport") {
    let r = parse_import(state: s)
    if is_err(pr: r) { return r }
    let rest = parse_imports(state: r.state)
    if is_err(pr: rest) { return rest }
    ok(val: { imports: [r.val.import] +rest.val.imports }, state: rest.state)
  } else {
    ok(val: { imports: [] }, state: s)
  }
}

fn parse_items(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if at_end(state: s) || check(state: s, tag: "Eof") {
    ok(val: { items: [] }, state: s)
  } else {
    let r = parse_item(state: s)
    if is_err(pr: r) { return r }
    let rest = parse_items(state: r.state)
    if is_err(pr: rest) { return rest }
    ok(val: { items: [r.val.item] +rest.val.items }, state: rest.state)
  }
}

// =========================================================================
// 3. parse_import
// =========================================================================

fn parse_import(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwImport")
  if is_err(pr: r) { return r }
  let s = r.state

  let r = parse_dotted_ident(state: s)
  if is_err(pr: r) { return r }
  let mod_path = r.val.name
  let s = r.state

  // Optional binding list: { Name1, Name2 }
  let e = eat(state: s, tag: "LBrace")
  if e.consumed {
    let r = parse_import_names(state: e.state)
    if is_err(pr: r) { return r }
    let names = r.val.names
    let s = r.state
    let r = expect(state: s, tag: "RBrace")
    if is_err(pr: r) { return r }
    let s = skip_newlines(state: r.state)
    let imp = Import { module_path: mod_path, names: names, span: start_span }
    ok(val: { import: imp }, state: s)
  } else {
    let s = skip_newlines(state: s)
    let imp = Import { module_path: mod_path, names: [], span: start_span }
    ok(val: { import: imp }, state: s)
  }
}

fn parse_import_names(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") {
    ok(val: { names: [] }, state: s)
  } else {
    let r = parse_dotted_ident(state: s)
    if is_err(pr: r) { return r }
    let name = r.val.name
    let s = skip_newlines(state: r.state)
    let e = eat(state: s, tag: "Comma")
    let s = skip_newlines(state: if e.consumed { e.state } else { s })
    let rest = parse_import_names(state: s)
    if is_err(pr: rest) { return rest }
    ok(val: { names: [name] +rest.val.names }, state: rest.state)
  }
}

// =========================================================================
// 4. parse_item — dispatch on keyword
// =========================================================================

fn parse_item(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  let k = peek_kind(state: s)
  match k {
    Some { value: KwType }     => parse_type_def(state: s)
    Some { value: KwFn }       => parse_fn_def(state: s)
    Some { value: KwFunc }     => parse_func_def(state: s)
    Some { value: KwService }  => parse_service_def(state: s)
    Some { value: KwResource } => parse_resource_def(state: s)
    Some { value: KwData }     => parse_data_def(state: s)
    Some { value: KwExtern }   => parse_extern_decl(state: s)
    Some { value: KwPattern }  => parse_func_def(state: s)
    Some { value: KwInterface } => parse_func_def(state: s)
    _ => fail(msg: "expected item declaration (type, fn, func, service, resource, data, extern, pattern, interface)", state: s)
  }
}

// =========================================================================
// 5. parse_type_def
// =========================================================================

fn parse_type_def(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwType")
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name
  let s = skip_newlines(state: r.state)

  // Record type: type Name { fields }
  let e = eat(state: s, tag: "LBrace")
  if e.consumed {
    let r = parse_field_list(state: skip_newlines(state: e.state))
    if is_err(pr: r) { return r }
    let s = skip_newlines(state: r.state)
    let r2 = expect(state: s, tag: "RBrace")
    if is_err(pr: r2) { return r2 }
    let body = Record { fields: r.val.fields }
    let item = TypeDef { name: name, body: body, span: start_span }
    ok(val: { item: item }, state: skip_newlines(state: r2.state))
  } else {
    // Sum type or alias: type Name = ...
    let r = expect(state: s, tag: "Eq")
    if is_err(pr: r) { return r }
    let s = skip_newlines(state: r.state)
    parse_type_body_after_eq(state: s, name: name, start_span: start_span)
  }
}

// After `type Name =`, determine if this is a sum type or alias.
fn parse_type_body_after_eq(state: ParserState, name: String, start_span: SourceSpan) -> PR {
  // Check if the first token is an identifier (potential variant name)
  // followed by LBrace or Pipe (sum type indicators).
  // If it's an identifier, try to parse as a sum type.
  if is_ident(state: state) {
    let r = expect_ident(state: state)
    if is_err(pr: r) { return r }
    let first_name = r.val.name
    let s = r.state

    // If followed by { or |, it's a sum type
    if check(state: s, tag: "LBrace") || check(state: s, tag: "Pipe") {
      let r = parse_variant_fields(state: s, vname: first_name)
      if is_err(pr: r) { return r }
      let first_variant = r.val.variant
      let rest = parse_more_variants(state: r.state)
      if is_err(pr: rest) { return rest }
      let variants = [first_variant] +rest.val.variants
      let body = Sum { variants: variants }
      let item = TypeDef { name: name, body: body, span: start_span }
      ok(val: { item: item }, state: skip_newlines(state: rest.state))
    } else {
      // It's an alias: type Name = SomeType
      let r = finish_type_expr_from_name(state: s, type_name: first_name, start_span: start_span)
      if is_err(pr: r) { return r }
      // Check for where clause: type Name = BaseType where predicate(...)
      let wr = try_where_clause(state: r.state, base_te: r.val.type_expr, start_span: start_span)
      if is_err(pr: wr) { return wr }
      let body = Alias { base: wr.val.type_expr }
      let item = TypeDef { name: name, body: body, span: start_span }
      ok(val: { item: item }, state: skip_newlines(state: wr.state))
    }
  } else {
    // Not an identifier — parse as type expression (e.g., { fields })
    let r = parse_type_expr(state: state)
    if is_err(pr: r) { return r }
    // Check for where clause
    let wr = try_where_clause(state: r.state, base_te: r.val.type_expr, start_span: start_span)
    if is_err(pr: wr) { return wr }
    let body = Alias { base: wr.val.type_expr }
    let item = TypeDef { name: name, body: body, span: start_span }
    ok(val: { item: item }, state: skip_newlines(state: wr.state))
  }
}

// try_where_clause: if the next token is KwWhere, parse predicates and
// wrap the base type in Refined. Otherwise, return the base type unchanged.
fn try_where_clause(state: ParserState, base_te: TypeExpr, start_span: SourceSpan) -> PR {
  if check(state: state, tag: "KwWhere") {
    let adv = advance(state: state)
    let r = parse_predicates(state: adv.state)
    if is_err(pr: r) { return r }
    let refined = Refined { base: base_te, predicates: r.val.predicates, span: start_span }
    ok(val: { type_expr: refined }, state: r.state)
  } else {
    ok(val: { type_expr: base_te }, state: state)
  }
}

// parse_predicates: comma-separated list of predicate(args).
fn parse_predicates(state: ParserState) -> PR {
  let r = parse_single_predicate(state: state)
  if is_err(pr: r) { return r }
  let e = eat(state: r.state, tag: "Comma")
  if e.consumed {
    let rest = parse_predicates(state: skip_newlines(state: e.state))
    if is_err(pr: rest) { return rest }
    ok(val: { predicates: [r.val.predicate] + rest.val.predicates }, state: rest.state)
  } else {
    ok(val: { predicates: [r.val.predicate] }, state: r.state)
  }
}

// parse_single_predicate: pattern("...") | range(min: N, max: N) | non_empty | format(name) | brand("...") | content(name)
// Note: "pattern" is both a keyword (KwPattern for `pattern` items) and a
// predicate name in `where pattern(...)`. We accept it as either.
fn parse_single_predicate(state: ParserState) -> PR {
  // Try identifier first; fall back to KwPattern which doubles as predicate name.
  let r = expect_ident(state: state)
  let pred_name = if is_err(pr: r) {
    if check(state: state, tag: "KwPattern") {
      "pattern"
    } else {
      return r
    }
  } else {
    r.val.name
  }
  let s = if is_err(pr: r) { advance(state: state).state } else { r.state }

  // Check for (args)
  let e = eat(state: s, tag: "LParen")
  if e.consumed {
    match pred_name {
      "pattern" => {
        let r2 = parse_expr(state: e.state)
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: r2.state, tag: "RParen")
        if is_err(pr: r3) { return r3 }
        match r2.val.expr {
          Literal { value: LitStr { value: s } } =>
            ok(val: { predicate: Pattern { regex: s } }, state: r3.state)
          _ => fail(msg: "pattern() requires a string literal argument", state: r3.state)
        }
      }
      "format" => {
        let r2 = expect_ident(state: e.state)
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: r2.state, tag: "RParen")
        if is_err(pr: r3) { return r3 }
        ok(val: { predicate: Format { name: r2.val.name } }, state: r3.state)
      }
      "brand" => {
        let r2 = parse_expr(state: e.state)
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: r2.state, tag: "RParen")
        if is_err(pr: r3) { return r3 }
        match r2.val.expr {
          Literal { value: LitStr { value: s } } =>
            ok(val: { predicate: Brand { name: s } }, state: r3.state)
          _ => fail(msg: "brand() requires a string literal argument", state: r3.state)
        }
      }
      "content" => {
        let r2 = expect_ident(state: e.state)
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: r2.state, tag: "RParen")
        if is_err(pr: r3) { return r3 }
        ok(val: { predicate: ContentEncoding { encoding: r2.val.name } }, state: r3.state)
      }
      "domain" => {
        let r2 = expect_ident(state: e.state)
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: r2.state, tag: "RParen")
        if is_err(pr: r3) { return r3 }
        ok(val: { predicate: Domain { name: r2.val.name } }, state: r3.state)
      }
      "range" => {
        // range(min: N) | range(max: N) | range(min: N, max: N)
        let r2 = parse_named_int_args(state: e.state)
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: r2.state, tag: "RParen")
        if is_err(pr: r3) { return r3 }
        ok(val: { predicate: Range { min: r2.val.min_val, max: r2.val.max_val } }, state: r3.state)
      }
      _ => {
        fail(msg: "unknown where predicate `" + pred_name + "`", state: e.state)
      }
    }
  } else {
    // No args — handle bare predicate names
    match pred_name {
      "non_empty" => ok(val: { predicate: NonEmpty }, state: s)
      _ => fail(msg: "unknown where predicate `" + pred_name + "`", state: s)
    }
  }
}

// parse_named_int_args: parse `min: N, max: N` style named integer arguments.
// Returns { min_val: Int?, max_val: Int? }. Both are optional.
fn parse_named_int_args(state: ParserState) -> PR {
  let r = parse_single_named_int(state: state)
  if is_err(pr: r) { return r }
  let e = eat(state: r.state, tag: "Comma")
  if e.consumed {
    let r2 = parse_single_named_int(state: skip_newlines(state: e.state))
    if is_err(pr: r2) { return r2 }
    let min_val = if r.val.arg_name == "min" { Some { value: r.val.arg_value } }
                  else if r2.val.arg_name == "min" { Some { value: r2.val.arg_value } }
                  else { None }
    let max_val = if r.val.arg_name == "max" { Some { value: r.val.arg_value } }
                  else if r2.val.arg_name == "max" { Some { value: r2.val.arg_value } }
                  else { None }
    ok(val: { min_val: min_val, max_val: max_val }, state: r2.state)
  } else {
    let min_val = if r.val.arg_name == "min" { Some { value: r.val.arg_value } } else { None }
    let max_val = if r.val.arg_name == "max" { Some { value: r.val.arg_value } } else { None }
    ok(val: { min_val: min_val, max_val: max_val }, state: r.state)
  }
}

// parse_single_named_int: parse `name: integer_literal`.
fn parse_single_named_int(state: ParserState) -> PR {
  let r = expect_ident(state: state)
  if is_err(pr: r) { return r }
  let name = r.val.name
  let r2 = expect(state: r.state, tag: "Colon")
  if is_err(pr: r2) { return r2 }
  let r3 = parse_expr(state: r2.state)
  if is_err(pr: r3) { return r3 }
  match r3.val.expr {
    Literal { value: LitInt { value: n } } =>
      ok(val: { arg_name: name, arg_value: n }, state: r3.state)
    _ => fail(msg: "range() argument `" + name + "` requires an integer literal", state: r3.state)
  }
}

fn parse_variant_fields(state: ParserState, vname: String) -> PR {
  let start_span = current_span(state: state)
  let e = eat(state: state, tag: "LBrace")
  if e.consumed {
    let r = parse_field_list(state: skip_newlines(state: e.state))
    if is_err(pr: r) { return r }
    let s = skip_newlines(state: r.state)
    let r2 = expect(state: s, tag: "RBrace")
    if is_err(pr: r2) { return r2 }
    let v = Variant { name: vname, fields: r.val.fields, span: start_span }
    ok(val: { variant: v }, state: r2.state)
  } else {
    // Unit variant (no fields)
    let v = Variant { name: vname, fields: [], span: start_span }
    ok(val: { variant: v }, state: state)
  }
}

fn parse_more_variants(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  let e = eat(state: s, tag: "Pipe")
  if e.consumed {
    let s = skip_newlines(state: e.state)
    let r = expect_ident(state: s)
    if is_err(pr: r) { return r }
    let r2 = parse_variant_fields(state: r.state, vname: r.val.name)
    if is_err(pr: r2) { return r2 }
    let rest = parse_more_variants(state: r2.state)
    if is_err(pr: rest) { return rest }
    ok(val: { variants: [r2.val.variant] +rest.val.variants }, state: rest.state)
  } else {
    ok(val: { variants: [] }, state: s)
  }
}

// =========================================================================
// 6. parse_type_body — Record { fields } vs Sum variants
//    (Used internally; top-level dispatches via parse_type_def)
// =========================================================================

// =========================================================================
// 7. parse_type_expr
// =========================================================================

fn parse_type_expr(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  let k = peek_kind(state: s)
  match k {
    // Inline record type: { fields }
    Some { value: LBrace } => {
      let adv = advance(state: s)
      let r = parse_field_list(state: skip_newlines(state: adv.state))
      if is_err(pr: r) { return r }
      let s2 = skip_newlines(state: r.state)
      let r2 = expect(state: s2, tag: "RBrace")
      if is_err(pr: r2) { return r2 }
      let span = current_span(state: s)
      let te = Product { name: none, fields: r.val.fields, span: span }
      ok(val: { type_expr: te }, state: r2.state)
    }
    // Named type
    Some { value: Ident { name: n } } => {
      let adv = advance(state: s)
      let span = current_span(state: s)
      finish_type_expr_from_name(state: adv.state, type_name: n, start_span: span)
    }
    _ => fail(msg: "expected type expression", state: s)
  }
}

fn finish_type_expr_from_name(state: ParserState, type_name: String, start_span: SourceSpan) -> PR {
  // Check for generic: Name<T> or Map<K,V>
  let e = eat(state: state, tag: "Lt")
  if e.consumed {
    let r = parse_type_expr(state: e.state)
    if is_err(pr: r) { return r }
    let first_arg = r.val.type_expr
    let s = r.state

    // Check for comma (second type arg, e.g., Map<K, V>)
    let e2 = eat(state: s, tag: "Comma")
    if e2.consumed {
      let r2 = parse_type_expr(state: e2.state)
      if is_err(pr: r2) { return r2 }
      let second_arg = r2.val.type_expr
      let r3 = expect(state: r2.state, tag: "Gt")
      if is_err(pr: r3) { return r3 }
      let te = MapType { key: first_arg, value: second_arg, span: start_span }
      maybe_optional(state: r3.state, te: te, start_span: start_span)
    } else {
      let r3 = expect(state: s, tag: "Gt")
      if is_err(pr: r3) { return r3 }
      let ck = match type_name {
        "List" => Some { value: List }
        "Set" => Some { value: Set }
        "NonEmptyList" => Some { value: NonEmptyList }
        "NonEmptySet" => Some { value: NonEmptySet }
        _ => none
      }
      match ck {
        Some { value: container_kind } => {
          let te = Container { kind: container_kind, element: first_arg, span: start_span }
          maybe_optional(state: r3.state, te: te, start_span: start_span)
        }
        None => {
          // Map with single arg? Treat as named generic.
          // For bootstrap we assume Map<K,V> is the two-arg form.
          let te = Named { name: type_name, span: start_span }
          maybe_optional(state: r3.state, te: te, start_span: start_span)
        }
      }
    }
  } else {
    // Plain named type
    let te = Named { name: type_name, span: start_span }
    maybe_optional(state: state, te: te, start_span: start_span)
  }
}

fn maybe_optional(state: ParserState, te: TypeExpr, start_span: SourceSpan) -> PR {
  let e = eat(state: state, tag: "Question")
  if e.consumed {
    let ote = Optional { inner: te, span: start_span }
    ok(val: { type_expr: ote }, state: e.state)
  } else {
    ok(val: { type_expr: te }, state: state)
  }
}

// =========================================================================
// Field list: name: Type, name2: Type?
// =========================================================================

fn parse_field_list(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || check(state: s, tag: "RParen") || at_end(state: s) {
    ok(val: { fields: [] }, state: s)
  } else {
    if is_ident(state: s) {
      let r = parse_field(state: s)
      if is_err(pr: r) { return r }
      let s2 = r.state
      let e = eat(state: s2, tag: "Comma")
      let s3 = skip_newlines(state: if e.consumed { e.state } else { s2 })
      let rest = parse_field_list(state: s3)
      if is_err(pr: rest) { return rest }
      ok(val: { fields: [r.val.field] +rest.val.fields }, state: rest.state)
    } else {
      ok(val: { fields: [] }, state: s)
    }
  }
}

fn parse_field(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect_ident(state: state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r2 = expect(state: r.state, tag: "Colon")
  if is_err(pr: r2) { return r2 }

  let r3 = parse_type_expr(state: r2.state)
  if is_err(pr: r3) { return r3 }
  let te = r3.val.type_expr
  let s = r3.state

  // Check for from "key" binding: name: Type from "json_key"
  let from_r = parse_optional_from_key(state: s)
  let from_key = from_r.val.from_key
  let s = from_r.state

  // Check for default value: = expr
  let e = eat(state: s, tag: "Eq")
  if e.consumed {
    let r4 = parse_expr(state: e.state)
    if is_err(pr: r4) { return r4 }
    let f = Field {
      name: name, type_expr: te, optional: false,
      default_value: Some { value: r4.val.expr }, from_key: from_key, span: start_span
    }
    ok(val: { field: f }, state: r4.state)
  } else {
    let f = Field {
      name: name, type_expr: te, optional: false,
      default_value: none, from_key: from_key, span: start_span
    }
    ok(val: { field: f }, state: s)
  }
}

// Parse optional from "json_key" after a field type expression.
fn parse_optional_from_key(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: Ident { name: "from" } } => {
      let adv = advance(state: state)
      let k2 = peek_kind(state: adv.state)
      match k2 {
        Some { value: LitStr { value: key } } => {
          let adv2 = advance(state: adv.state)
          ok(val: { from_key: Some { value: key } }, state: adv2.state)
        }
        _ => {
          // "from" without string literal — not a from clause, backtrack
          ok(val: { from_key: none }, state: state)
        }
      }
    }
    _ => ok(val: { from_key: none }, state: state)
  }
}

// =========================================================================
// 8. parse_fn_def: fn name(params) -> ReturnType { body }
// =========================================================================

fn parse_fn_def(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwFn")
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r = parse_params(state: r.state)
  if is_err(pr: r) { return r }
  let params = r.val.params
  let s = r.state

  // Optional return type: -> Type
  let ret = parse_optional_return_type(state: s)
  if is_err(pr: ret) { return ret }
  let return_type = ret.val.return_type
  let s = ret.state

  // Body: { exprs }
  let r = parse_block(state: skip_newlines(state: s))
  if is_err(pr: r) { return r }
  let body = r.val.expr

  let item = FnDef {
    name: name, params: params,
    return_type: return_type, body: body, span: start_span
  }
  ok(val: { item: item }, state: skip_newlines(state: r.state))
}

// =========================================================================
// 9. parse_func_def: func name(params) -> RetType uses res: Type { body }
// =========================================================================

fn parse_func_def(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  // Accept func, pattern, or interface as the leading keyword
  let k = peek_kind(state: state)
  let r = match k {
    Some { value: KwFunc } => expect(state: state, tag: "KwFunc")
    Some { value: KwPattern } => expect(state: state, tag: "KwPattern")
    Some { value: KwInterface } => expect(state: state, tag: "KwInterface")
    _ => expect(state: state, tag: "KwFunc")
  }
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r = parse_params(state: r.state)
  if is_err(pr: r) { return r }
  let params = r.val.params
  let s = r.state

  let ret = parse_optional_return_type(state: s)
  if is_err(pr: ret) { return ret }
  let return_type = ret.val.return_type
  let s = ret.state

  // Optional uses clause
  let uses_r = parse_uses_clause(state: skip_newlines(state: s))
  if is_err(pr: uses_r) { return uses_r }
  let uses = uses_r.val.uses
  let s = uses_r.state

  let r = parse_block(state: skip_newlines(state: s))
  if is_err(pr: r) { return r }
  let body = r.val.expr

  let item = FuncDef {
    name: name, params: params,
    return_type: return_type, uses: uses,
    body: body, span: start_span
  }
  ok(val: { item: item }, state: skip_newlines(state: r.state))
}

fn parse_uses_clause(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  // "uses" is not a keyword — it's an identifier in v2
  let k = peek_kind(state: s)
  match k {
    Some { value: Ident { name: "uses" } } => {
      let adv = advance(state: s)
      let r = parse_uses_list(state: adv.state)
      if is_err(pr: r) { return r }
      ok(val: { uses: r.val.uses }, state: r.state)
    }
    _ => ok(val: { uses: [] }, state: s)
  }
}

fn parse_uses_list(state: ParserState) -> PR {
  let r = parse_uses_entry(state: state)
  if is_err(pr: r) { return r }
  let first = r.val.resource_use
  let s = r.state

  let e = eat(state: s, tag: "Comma")
  if e.consumed {
    let rest = parse_uses_list(state: e.state)
    if is_err(pr: rest) { return rest }
    ok(val: { uses: [first] +rest.val.uses }, state: rest.state)
  } else {
    ok(val: { uses: [first] }, state: s)
  }
}

fn parse_uses_entry(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect_ident(state: state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r2 = expect(state: r.state, tag: "Colon")
  if is_err(pr: r2) { return r2 }

  let r3 = parse_type_expr(state: r2.state)
  if is_err(pr: r3) { return r3 }
  let ru = ResourceUse { name: name, resource: r3.val.type_expr, span: start_span }
  ok(val: { resource_use: ru }, state: r3.state)
}

fn parse_optional_return_type(state: ParserState) -> PR {
  let e = eat(state: state, tag: "Arrow")
  if e.consumed {
    let r = parse_type_expr(state: e.state)
    if is_err(pr: r) { return r }
    ok(val: { return_type: Some { value: r.val.type_expr } }, state: r.state)
  } else {
    ok(val: { return_type: none }, state: state)
  }
}

// =========================================================================
// 10. parse_service_def
// =========================================================================

fn parse_service_def(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwService")
  if is_err(pr: r) { return r }

  let r = parse_dotted_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r = expect(state: r.state, tag: "LBrace")
  if is_err(pr: r) { return r }
  let s = skip_newlines(state: r.state)

  // Parse service body: config, transport, operations
  let r = parse_service_body(state: s)
  if is_err(pr: r) { return r }

  let s = skip_newlines(state: r.state)
  let r2 = expect(state: s, tag: "RBrace")
  if is_err(pr: r2) { return r2 }

  let item = ServiceDef {
    name: name,
    transport: r.val.transport,
    config: r.val.config,
    operations: r.val.operations,
    span: start_span
  }
  ok(val: { item: item }, state: skip_newlines(state: r2.state))
}

fn parse_service_body(state: ParserState) -> PR {
  // Parse all entries in the service block
  parse_service_entries(
    state: state,
    config: none,
    transport: LocalBinding,
    operations: []
  )
}

fn parse_service_entries(state: ParserState, config: ServiceConfig?, transport: TransportBinding, operations: List<OperationDef>) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { config: config, transport: transport, operations: operations }, state: s)
  } else {
    let k = peek_kind(state: s)
    match k {
      Some { value: Ident { name: "config" } } => {
        let adv = advance(state: s)
        let r = expect(state: adv.state, tag: "LBrace")
        if is_err(pr: r) { return r }
        let r2 = parse_service_config_block(state: skip_newlines(state: r.state))
        if is_err(pr: r2) { return r2 }
        let s2 = skip_newlines(state: r2.state)
        let r3 = expect(state: s2, tag: "RBrace")
        if is_err(pr: r3) { return r3 }
        parse_service_entries(state: r3.state, config: Some { value: r2.val.config }, transport: transport, operations: operations)
      }
      Some { value: Ident { name: "transport" } } => {
        let adv = advance(state: s)
        let r = parse_transport_binding(state: adv.state)
        if is_err(pr: r) { return r }
        parse_service_entries(state: r.state, config: config, transport: r.val.transport, operations: operations)
      }
      Some { value: KwOperation } => {
        let r = parse_operation_def(state: s)
        if is_err(pr: r) { return r }
        parse_service_entries(state: r.state, config: config, transport: transport, operations: operations +[r.val.operation])
      }
      _ => fail(msg: "expected config, transport, or operation in service block", state: s)
    }
  }
}

fn parse_service_config_block(state: ParserState) -> PR {
  // Parse key: value pairs for config
  parse_config_fields(state: state, endpoint: none, auth: none, rate_limit: none, retry: none)
}

fn parse_config_fields(state: ParserState, endpoint: Expr?, auth: Expr?, rate_limit: Expr?, retry: Expr?) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    let cfg = ServiceConfig {
      endpoint: match endpoint {
        Some { value: e } => e
        None => Literal { value: LitStr { value: "" }, span: SourceSpan { start: 0, end: 0 } }
      },
      auth: auth,
      rate_limit: rate_limit,
      retry: retry
    }
    ok(val: { config: cfg }, state: s)
  } else {
    let r = expect_ident(state: s)
    if is_err(pr: r) { return r }
    let fname = r.val.name
    let r2 = expect(state: r.state, tag: "Colon")
    if is_err(pr: r2) { return r2 }
    let r3 = parse_expr(state: r2.state)
    if is_err(pr: r3) { return r3 }
    let s2 = r3.state
    let e = eat(state: s2, tag: "Comma")
    let s3 = if e.consumed { e.state } else { s2 }

    match fname {
      "endpoint" => parse_config_fields(state: s3, endpoint: Some { value: r3.val.expr }, auth: auth, rate_limit: rate_limit, retry: retry)
      "auth" => parse_config_fields(state: s3, endpoint: endpoint, auth: Some { value: r3.val.expr }, rate_limit: rate_limit, retry: retry)
      "rate_limit" => parse_config_fields(state: s3, endpoint: endpoint, auth: auth, rate_limit: Some { value: r3.val.expr }, retry: retry)
      "retry" => parse_config_fields(state: s3, endpoint: endpoint, auth: auth, rate_limit: rate_limit, retry: Some { value: r3.val.expr })
      _ => parse_config_fields(state: s3, endpoint: endpoint, auth: auth, rate_limit: rate_limit, retry: retry)
    }
  }
}

fn parse_transport_binding(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: Ident { name: "rest" } } => {
      let adv = advance(state: state)
      let r = expect(state: adv.state, tag: "LBrace")
      if is_err(pr: r) { return r }
      let r2 = parse_rest_binding_body(state: skip_newlines(state: r.state))
      if is_err(pr: r2) { return r2 }
      let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
      if is_err(pr: r3) { return r3 }
      ok(val: { transport: r2.val.transport }, state: r3.state)
    }
    Some { value: Ident { name: "shell" } } => {
      let adv = advance(state: state)
      let r = expect(state: adv.state, tag: "LBrace")
      if is_err(pr: r) { return r }
      let r2 = parse_shell_binding_body(state: skip_newlines(state: r.state))
      if is_err(pr: r2) { return r2 }
      let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
      if is_err(pr: r3) { return r3 }
      ok(val: { transport: r2.val.transport }, state: r3.state)
    }
    Some { value: Ident { name: "file" } } => {
      let adv = advance(state: state)
      let r = expect(state: adv.state, tag: "LBrace")
      if is_err(pr: r) { return r }
      // Parse base_path
      let s = skip_newlines(state: r.state)
      let r2 = expect_ident(state: s)
      if is_err(pr: r2) { return r2 }
      let r3 = expect(state: r2.state, tag: "Colon")
      if is_err(pr: r3) { return r3 }
      let r4 = parse_expr(state: r3.state)
      if is_err(pr: r4) { return r4 }
      let r5 = expect(state: skip_newlines(state: r4.state), tag: "RBrace")
      if is_err(pr: r5) { return r5 }
      ok(val: { transport: FileBinding { base_path: r4.val.expr } }, state: r5.state)
    }
    _ => {
      // Default: local binding
      ok(val: { transport: LocalBinding }, state: state)
    }
  }
}

fn parse_rest_binding_body(state: ParserState) -> PR {
  // Parse base_url and optional auth/headers
  parse_rest_fields(state: state, base_url: none, auth: none, headers: [])
}

fn parse_rest_fields(state: ParserState, base_url: Expr?, auth: AuthConfig?, headers: List<HeaderDef>) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    let bu = match base_url {
      Some { value: e } => e
      None => Literal { value: LitStr { value: "" }, span: SourceSpan { start: 0, end: 0 } }
    }
    ok(val: { transport: RestBinding { base_url: bu, auth: auth, headers: headers } }, state: s)
  } else {
    let r = expect_ident(state: s)
    if is_err(pr: r) { return r }
    let fname = r.val.name
    let r2 = expect(state: r.state, tag: "Colon")
    if is_err(pr: r2) { return r2 }
    let r3 = parse_expr(state: r2.state)
    if is_err(pr: r3) { return r3 }
    let e = eat(state: r3.state, tag: "Comma")
    let s2 = if e.consumed { e.state } else { r3.state }
    match fname {
      "base_url" => parse_rest_fields(state: s2, base_url: Some { value: r3.val.expr }, auth: auth, headers: headers)
      _ => parse_rest_fields(state: s2, base_url: base_url, auth: auth, headers: headers)
    }
  }
}

fn parse_shell_binding_body(state: ParserState) -> PR {
  // Parse argv and optional env
  parse_shell_fields(state: state, argv: [], env: [])
}

fn parse_shell_fields(state: ParserState, argv: List<Expr>, env: List<EnvDef>) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { transport: ShellBinding { argv: argv, env: env } }, state: s)
  } else {
    let r = expect_ident(state: s)
    if is_err(pr: r) { return r }
    let fname = r.val.name
    let r2 = expect(state: r.state, tag: "Colon")
    if is_err(pr: r2) { return r2 }
    match fname {
      "argv" => {
        let r3 = expect(state: r2.state, tag: "LBracket")
        if is_err(pr: r3) { return r3 }
        let r4 = parse_expr_list_until(state: r3.state, end_tag: "RBracket")
        if is_err(pr: r4) { return r4 }
        let r5 = expect(state: r4.state, tag: "RBracket")
        if is_err(pr: r5) { return r5 }
        let e = eat(state: r5.state, tag: "Comma")
        let s2 = if e.consumed { e.state } else { r5.state }
        parse_shell_fields(state: s2, argv: r4.val.exprs, env: env)
      }
      _ => {
        let r3 = parse_expr(state: r2.state)
        if is_err(pr: r3) { return r3 }
        let e = eat(state: r3.state, tag: "Comma")
        let s2 = if e.consumed { e.state } else { r3.state }
        parse_shell_fields(state: s2, argv: argv, env: env)
      }
    }
  }
}

fn parse_operation_def(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwOperation")
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name
  let s = skip_newlines(state: r.state)

  // Dispatch: LBrace = v1 block style, otherwise = v2 inline style
  if check(state: s, tag: "LBrace") {
    parse_operation_v1_body(state: s, name: name, start_span: start_span)
  } else {
    parse_operation_v2_inline(state: s, name: name, start_span: start_span)
  }
}

// v2 inline: operation Name modifiers? (params) -> RetType response? mock_response?
fn parse_operation_v2_inline(state: ParserState, name: String, start_span: SourceSpan) -> PR {
  let mods_r = parse_operation_modifiers(state: state)
  let modifiers = mods_r.val.modifiers
  let s = mods_r.state

  let r = expect(state: s, tag: "LParen")
  if is_err(pr: r) { return r }
  let r = parse_field_list(state: skip_newlines(state: r.state))
  if is_err(pr: r) { return r }
  let inputs = r.val.fields
  let r = expect(state: skip_newlines(state: r.state), tag: "RParen")
  if is_err(pr: r) { return r }
  let s = r.state

  let ret = parse_optional_return_type(state: s)
  if is_err(pr: ret) { return ret }
  let s = ret.state
  let outputs = match ret.val.return_type {
    Some { value: Product { name: _, fields: fs, span: _ } } => fs
    Some { value: Named { name: n, span: sp } } => [Field { name: "value", type_expr: Named { name: n, span: sp }, optional: false, default_value: none, from_key: none, span: sp }]
    _ => []
  }
  let s = skip_newlines(state: s)

  let resp_r = parse_optional_response_block(state: s)
  if is_err(pr: resp_r) { return resp_r }
  let s = skip_newlines(state: resp_r.state)
  let mock_r = parse_optional_mock_response_block(state: s)
  if is_err(pr: mock_r) { return mock_r }
  let s = skip_newlines(state: mock_r.state)

  let op = OperationDef {
    name: name, inputs: inputs, outputs: outputs,
    response: resp_r.val.responses, mock_response: mock_r.val.mocks,
    exit_mappings: [], modifiers: modifiers, transport: none, span: start_span
  }
  ok(val: { operation: op }, state: s)
}

// v1 block: operation Name { input {} output {} modifiers transport exit response mock_response }
fn parse_operation_v1_body(state: ParserState, name: String, start_span: SourceSpan) -> PR {
  let r = expect(state: state, tag: "LBrace")
  if is_err(pr: r) { return r }
  let s = skip_newlines(state: r.state)

  let r2 = parse_op_body_entries(
    state: s, inputs: [], outputs: [], modifiers: [],
    transport: none, exits: [], response: [], mock_response: []
  )
  if is_err(pr: r2) { return r2 }

  let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
  if is_err(pr: r3) { return r3 }

  let op = OperationDef {
    name: name, inputs: r2.val.inputs, outputs: r2.val.outputs,
    response: r2.val.response, mock_response: r2.val.mock_response,
    exit_mappings: r2.val.exits, modifiers: r2.val.modifiers,
    transport: r2.val.transport, span: start_span
  }
  ok(val: { operation: op }, state: skip_newlines(state: r3.state))
}

// Parse entries inside a v1 operation body block.
fn parse_op_body_entries(
  state: ParserState,
  inputs: List<Field>, outputs: List<Field>,
  modifiers: List<OperationModifier>, transport: TransportBinding?,
  exits: List<ExitMapping>, response: List<ResponseMapping>, mock_response: List<MockResponseDef>
) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { inputs: inputs, outputs: outputs, modifiers: modifiers, transport: transport, exits: exits, response: response, mock_response: mock_response }, state: s)
  } else {
    let k = peek_kind(state: s)
    match k {
      Some { value: KwInput } => {
        let adv = advance(state: s)
        let r = expect(state: adv.state, tag: "LBrace")
        if is_err(pr: r) { return r }
        let r2 = parse_field_list(state: skip_newlines(state: r.state))
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
        if is_err(pr: r3) { return r3 }
        parse_op_body_entries(state: r3.state, inputs: r2.val.fields, outputs: outputs, modifiers: modifiers, transport: transport, exits: exits, response: response, mock_response: mock_response)
      }
      Some { value: KwOutput } => {
        let adv = advance(state: s)
        let r = expect(state: adv.state, tag: "LBrace")
        if is_err(pr: r) { return r }
        let r2 = parse_field_list(state: skip_newlines(state: r.state))
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
        if is_err(pr: r3) { return r3 }
        parse_op_body_entries(state: r3.state, inputs: inputs, outputs: r2.val.fields, modifiers: modifiers, transport: transport, exits: exits, response: response, mock_response: mock_response)
      }
      Some { value: KwIdempotent } => {
        let adv = advance(state: s)
        parse_op_body_entries(state: adv.state, inputs: inputs, outputs: outputs, modifiers: modifiers + [Idempotent], transport: transport, exits: exits, response: response, mock_response: mock_response)
      }
      Some { value: KwReadonly } => {
        let adv = advance(state: s)
        parse_op_body_entries(state: adv.state, inputs: inputs, outputs: outputs, modifiers: modifiers + [Readonly], transport: transport, exits: exits, response: response, mock_response: mock_response)
      }
      Some { value: KwHermetic } => {
        let adv = advance(state: s)
        parse_op_body_entries(state: adv.state, inputs: inputs, outputs: outputs, modifiers: modifiers + [Hermetic], transport: transport, exits: exits, response: response, mock_response: mock_response)
      }
      Some { value: Ident { name: id } } => {
        if id == "transport" {
          let adv = advance(state: s)
          let r = parse_transport_binding(state: adv.state)
          if is_err(pr: r) { return r }
          parse_op_body_entries(state: r.state, inputs: inputs, outputs: outputs, modifiers: modifiers, transport: Some { value: r.val.transport }, exits: exits, response: response, mock_response: mock_response)
        } else if id == "exit" {
          let adv = advance(state: s)
          let r = expect(state: adv.state, tag: "LBrace")
          if is_err(pr: r) { return r }
          let r2 = parse_exit_entries(state: skip_newlines(state: r.state))
          if is_err(pr: r2) { return r2 }
          let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
          if is_err(pr: r3) { return r3 }
          parse_op_body_entries(state: r3.state, inputs: inputs, outputs: outputs, modifiers: modifiers, transport: transport, exits: r2.val.entries, response: response, mock_response: mock_response)
        } else if id == "response" {
          let r = parse_optional_response_block(state: s)
          if is_err(pr: r) { return r }
          parse_op_body_entries(state: r.state, inputs: inputs, outputs: outputs, modifiers: modifiers, transport: transport, exits: exits, response: r.val.responses, mock_response: mock_response)
        } else if id == "mock_response" {
          let r = parse_optional_mock_response_block(state: s)
          if is_err(pr: r) { return r }
          parse_op_body_entries(state: r.state, inputs: inputs, outputs: outputs, modifiers: modifiers, transport: transport, exits: exits, response: response, mock_response: r.val.mocks)
        } else {
          // Unknown identifier entry — skip it (name: value)
          if peek_is_colon_after_ident(state: s) {
            let r = expect_ident(state: s)
            if is_err(pr: r) { return r }
            let r2 = expect(state: r.state, tag: "Colon")
            if is_err(pr: r2) { return r2 }
            let r3 = parse_expr(state: r2.state)
            if is_err(pr: r3) { return r3 }
            parse_op_body_entries(state: skip_newlines(state: r3.state), inputs: inputs, outputs: outputs, modifiers: modifiers, transport: transport, exits: exits, response: response, mock_response: mock_response)
          } else {
            fail(msg: "unexpected '{id}' in operation body", state: s)
          }
        }
      }
      _ => fail(msg: "unexpected token in operation body", state: s)
    }
  }
}

// Parse exit block entries: code => Type optional_description
fn parse_exit_entries(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { entries: [] }, state: s)
  } else {
    let r = parse_status_pattern(state: s)
    if is_err(pr: r) { return r }
    let code = r.val.expr
    let r2 = expect(state: r.state, tag: "FatArrow")
    if is_err(pr: r2) { return r2 }
    let r3 = parse_type_expr(state: r2.state)
    if is_err(pr: r3) { return r3 }
    // Optional description string after type
    let desc_k = peek_kind(state: r3.state)
    let desc_r = match desc_k {
      Some { value: LitStr { value: d } } => {
        let adv = advance(state: r3.state)
        { desc: Some { value: d }, state: adv.state }
      }
      _ => { desc: none, state: r3.state }
    }
    let entry = ExitMapping { code: code, type_expr: r3.val.type_expr, description: desc_r.desc }
    let e = eat(state: desc_r.state, tag: "Comma")
    let s2 = skip_newlines(state: if e.consumed { e.state } else { desc_r.state })
    let rest = parse_exit_entries(state: s2)
    if is_err(pr: rest) { return rest }
    ok(val: { entries: [entry] + rest.val.entries }, state: rest.state)
  }
}

fn parse_operation_modifiers(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: KwIdempotent } => {
      let adv = advance(state: state)
      let rest = parse_operation_modifiers(state: adv.state)
      ok(val: { modifiers: [Idempotent] +rest.val.modifiers }, state: rest.state)
    }
    Some { value: KwReadonly } => {
      let adv = advance(state: state)
      let rest = parse_operation_modifiers(state: adv.state)
      ok(val: { modifiers: [Readonly] +rest.val.modifiers }, state: rest.state)
    }
    Some { value: KwHermetic } => {
      let adv = advance(state: state)
      let rest = parse_operation_modifiers(state: adv.state)
      ok(val: { modifiers: [Hermetic] +rest.val.modifiers }, state: rest.state)
    }
    _ => ok(val: { modifiers: [] }, state: state)
  }
}

// =========================================================================
// response/mock_response block helpers
// =========================================================================

// Parse a status/exit code pattern: integer, Nxx wildcard (5xx), or identifier (nonzero).
// Nxx: tokenizer produces LitInt(N) + Ident("xx") — combine into LitStr("Nxx").
fn parse_status_pattern(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: LitInt { value: n } } => {
      // Check if next token is Ident("xx") → wildcard like 5xx
      if state.pos + 1 < count(state.tokens) {
        let next_tok = first(skip(state.tokens, n: state.pos + 1))
        match next_tok {
          Some { value: t } => {
            match t.kind {
              Ident { name: "xx" } => {
                let span = current_span(state: state)
                let adv = advance(state: state)
                let adv2 = advance(state: adv.state)
                ok(val: { expr: Literal { value: LitStr { value: "{n}xx" }, span: span } }, state: adv2.state)
              }
              _ => parse_expr(state: state)
            }
          }
          None => parse_expr(state: state)
        }
      } else {
        parse_expr(state: state)
      }
    }
    _ => parse_expr(state: state)
  }
}

// Parse optional response { 200 => Type, ... } block.
fn parse_optional_response_block(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: Ident { name: "response" } } => {
      let adv = advance(state: state)
      let r = expect(state: adv.state, tag: "LBrace")
      if is_err(pr: r) { return r }
      let r2 = parse_response_entries(state: skip_newlines(state: r.state))
      if is_err(pr: r2) { return r2 }
      let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
      if is_err(pr: r3) { return r3 }
      ok(val: { responses: r2.val.entries }, state: r3.state)
    }
    _ => ok(val: { responses: [] }, state: state)
  }
}

fn parse_response_entries(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { entries: [] }, state: s)
  } else {
    // status_code => Type (supports Nxx wildcards like 5xx, 4xx)
    let r = parse_status_pattern(state: s)
    if is_err(pr: r) { return r }
    let status = r.val.expr
    let r2 = expect(state: r.state, tag: "FatArrow")
    if is_err(pr: r2) { return r2 }
    let r3 = parse_type_expr(state: r2.state)
    if is_err(pr: r3) { return r3 }
    let entry = ResponseMapping { status: status, type_expr: r3.val.type_expr }
    let e = eat(state: r3.state, tag: "Comma")
    let s2 = skip_newlines(state: if e.consumed { e.state } else { r3.state })
    let rest = parse_response_entries(state: s2)
    if is_err(pr: rest) { return rest }
    ok(val: { entries: [entry] + rest.val.entries }, state: rest.state)
  }
}

// Parse optional mock_response { 200 => expr "description", ... } block.
fn parse_optional_mock_response_block(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: Ident { name: "mock_response" } } => {
      let adv = advance(state: state)
      let r = expect(state: adv.state, tag: "LBrace")
      if is_err(pr: r) { return r }
      let r2 = parse_mock_response_entries(state: skip_newlines(state: r.state))
      if is_err(pr: r2) { return r2 }
      let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
      if is_err(pr: r3) { return r3 }
      ok(val: { mocks: r2.val.entries }, state: r3.state)
    }
    _ => ok(val: { mocks: [] }, state: state)
  }
}

fn parse_mock_response_entries(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { entries: [] }, state: s)
  } else {
    // status_code => body_expr optional_description_string (supports Nxx wildcards)
    let r = parse_status_pattern(state: s)
    if is_err(pr: r) { return r }
    let status = r.val.expr
    let r2 = expect(state: r.state, tag: "FatArrow")
    if is_err(pr: r2) { return r2 }
    let r3 = parse_expr(state: r2.state)
    if is_err(pr: r3) { return r3 }
    let body = r3.val.expr
    // Optional description string
    let desc_k = peek_kind(state: r3.state)
    let desc_r = match desc_k {
      Some { value: LitStr { value: d } } => {
        let adv = advance(state: r3.state)
        { desc: Some { value: d }, state: adv.state }
      }
      _ => { desc: none, state: r3.state }
    }
    let entry = MockResponseDef { status: status, body: body, description: desc_r.desc }
    let e = eat(state: desc_r.state, tag: "Comma")
    let s2 = skip_newlines(state: if e.consumed { e.state } else { desc_r.state })
    let rest = parse_mock_response_entries(state: s2)
    if is_err(pr: rest) { return rest }
    ok(val: { entries: [entry] + rest.val.entries }, state: rest.state)
  }
}

// =========================================================================
// 11. parse_resource_def
// =========================================================================

fn parse_resource_def(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwResource")
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r = expect(state: r.state, tag: "LBrace")
  if is_err(pr: r) { return r }

  let r = parse_resource_entries(state: skip_newlines(state: r.state), properties: [], capabilities: [])
  if is_err(pr: r) { return r }

  let r2 = expect(state: skip_newlines(state: r.state), tag: "RBrace")
  if is_err(pr: r2) { return r2 }

  let item = ResourceDef {
    name: name,
    properties: r.val.properties,
    capabilities: r.val.capabilities,
    span: start_span
  }
  ok(val: { item: item }, state: skip_newlines(state: r2.state))
}

// Parse resource block entries: properties, acquire/release, capabilities.
fn parse_resource_entries(state: ParserState, properties: List<FieldInit>, capabilities: List<CapabilityDef>) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { properties: properties, capabilities: capabilities }, state: s)
  } else {
    let k = peek_kind(state: s)
    match k {
      Some { value: KwCapability } => {
        let r = parse_capability(state: s)
        if is_err(pr: r) { return r }
        parse_resource_entries(state: r.state, properties: properties, capabilities: capabilities + [r.val.capability])
      }
      Some { value: KwAcquire } => {
        let adv = advance(state: s)
        let r = expect(state: adv.state, tag: "LBrace")
        if is_err(pr: r) { return r }
        let r2 = skip_until_rbrace(state: skip_newlines(state: r.state))
        let r3 = expect(state: r2.state, tag: "RBrace")
        if is_err(pr: r3) { return r3 }
        parse_resource_entries(state: skip_newlines(state: r3.state), properties: properties, capabilities: capabilities)
      }
      Some { value: KwRelease } => {
        let adv = advance(state: s)
        let r = expect(state: adv.state, tag: "LBrace")
        if is_err(pr: r) { return r }
        let r2 = skip_until_rbrace(state: skip_newlines(state: r.state))
        let r3 = expect(state: r2.state, tag: "RBrace")
        if is_err(pr: r3) { return r3 }
        parse_resource_entries(state: skip_newlines(state: r3.state), properties: properties, capabilities: capabilities)
      }
      Some { value: Ident { name: _ } } => {
        // Property field: name: value (e.g., kind: Capability, mode: ReadWrite)
        if peek_is_colon_after_ident(state: s) {
          let r = expect_ident(state: s)
          if is_err(pr: r) { return r }
          let fname = r.val.name
          let r2 = expect(state: r.state, tag: "Colon")
          if is_err(pr: r2) { return r2 }
          let r3 = parse_expr(state: r2.state)
          if is_err(pr: r3) { return r3 }
          let fi = FieldInit { name: fname, value: r3.val.expr }
          parse_resource_entries(state: skip_newlines(state: r3.state), properties: properties + [fi], capabilities: capabilities)
        } else {
          fail(msg: "unexpected token in resource block", state: s)
        }
      }
      _ => fail(msg: "expected capability, acquire, release, or property in resource block", state: s)
    }
  }
}

// Skip tokens until matching RBrace (handles nested brace blocks).
fn skip_until_rbrace(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: {}, state: s)
  } else {
    let k = peek_kind(state: s)
    match k {
      Some { value: LBrace } => {
        let adv = advance(state: s)
        let inner = skip_until_rbrace(state: adv.state)
        let r = expect(state: inner.state, tag: "RBrace")
        if is_err(pr: r) { return r }
        skip_until_rbrace(state: r.state)
      }
      _ => {
        let adv = advance(state: s)
        skip_until_rbrace(state: adv.state)
      }
    }
  }
}

// Parse capability in v1 block or v2 inline form.
fn parse_capability(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwCapability")
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name
  let s = r.state

  // Dispatch: LBrace = v1 block, LParen = v2 inline
  if check(state: s, tag: "LBrace") {
    // v1: capability name { input { fields } output { fields } }
    let r2 = expect(state: s, tag: "LBrace")
    if is_err(pr: r2) { return r2 }
    let io = parse_input_output_blocks(state: skip_newlines(state: r2.state))
    if is_err(pr: io) { return io }
    let r3 = expect(state: skip_newlines(state: io.state), tag: "RBrace")
    if is_err(pr: r3) { return r3 }
    let cap = CapabilityDef { name: name, inputs: io.val.inputs, outputs: io.val.outputs, span: start_span }
    ok(val: { capability: cap }, state: skip_newlines(state: r3.state))
  } else if check(state: s, tag: "LParen") {
    // v2: capability name(fields) -> RetType
    let r2 = expect(state: s, tag: "LParen")
    if is_err(pr: r2) { return r2 }
    let r3 = parse_field_list(state: skip_newlines(state: r2.state))
    if is_err(pr: r3) { return r3 }
    let inputs = r3.val.fields
    let r4 = expect(state: skip_newlines(state: r3.state), tag: "RParen")
    if is_err(pr: r4) { return r4 }
    let ret = parse_optional_return_type(state: r4.state)
    if is_err(pr: ret) { return ret }
    let outputs = match ret.val.return_type {
      Some { value: Product { name: _, fields: fs, span: _ } } => fs
      Some { value: Named { name: n, span: sp } } => [Field { name: "value", type_expr: Named { name: n, span: sp }, optional: false, default_value: none, from_key: none, span: sp }]
      _ => []
    }
    let cap = CapabilityDef { name: name, inputs: inputs, outputs: outputs, span: start_span }
    ok(val: { capability: cap }, state: skip_newlines(state: ret.state))
  } else {
    // Unit capability (no inputs/outputs)
    let cap = CapabilityDef { name: name, inputs: [], outputs: [], span: start_span }
    ok(val: { capability: cap }, state: skip_newlines(state: s))
  }
}

// Parse v1 input { fields } output { fields } blocks (used in capabilities and operations).
fn parse_input_output_blocks(state: ParserState) -> PR {
  parse_io_blocks_acc(state: state, inputs: [], outputs: [])
}

fn parse_io_blocks_acc(state: ParserState, inputs: List<Field>, outputs: List<Field>) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { inputs: inputs, outputs: outputs }, state: s)
  } else {
    let k = peek_kind(state: s)
    match k {
      Some { value: KwInput } => {
        let adv = advance(state: s)
        let r = expect(state: adv.state, tag: "LBrace")
        if is_err(pr: r) { return r }
        let r2 = parse_field_list(state: skip_newlines(state: r.state))
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
        if is_err(pr: r3) { return r3 }
        parse_io_blocks_acc(state: r3.state, inputs: r2.val.fields, outputs: outputs)
      }
      Some { value: KwOutput } => {
        let adv = advance(state: s)
        let r = expect(state: adv.state, tag: "LBrace")
        if is_err(pr: r) { return r }
        let r2 = parse_field_list(state: skip_newlines(state: r.state))
        if is_err(pr: r2) { return r2 }
        let r3 = expect(state: skip_newlines(state: r2.state), tag: "RBrace")
        if is_err(pr: r3) { return r3 }
        parse_io_blocks_acc(state: r3.state, inputs: inputs, outputs: r2.val.fields)
      }
      _ => {
        // Not input/output — stop and let caller handle remaining entries
        ok(val: { inputs: inputs, outputs: outputs }, state: s)
      }
    }
  }
}

// =========================================================================
// 12. parse_data_def: data name: Type = value
// =========================================================================

fn parse_data_def(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwData")
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r = expect(state: r.state, tag: "Colon")
  if is_err(pr: r) { return r }

  let r = parse_type_expr(state: r.state)
  if is_err(pr: r) { return r }
  let te = r.val.type_expr

  let r = expect(state: r.state, tag: "Eq")
  if is_err(pr: r) { return r }

  let r = parse_expr(state: r.state)
  if is_err(pr: r) { return r }

  let item = DataDef {
    name: name, type_expr: te, value: r.val.expr, span: start_span
  }
  ok(val: { item: item }, state: skip_newlines(state: r.state))
}

// =========================================================================
// Extern declaration: extern fn name(params) -> Type
// =========================================================================

fn parse_extern_decl(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect(state: state, tag: "KwExtern")
  if is_err(pr: r) { return r }

  // Expect "fn" or "func" after extern
  let k = peek_kind(state: r.state)
  match k {
    Some { value: KwFn } => {
      let adv = advance(state: r.state)
      let r2 = expect_ident(state: adv.state)
      if is_err(pr: r2) { return r2 }
      let name = r2.val.name
      let r3 = parse_params(state: r2.state)
      if is_err(pr: r3) { return r3 }
      let ret = parse_optional_return_type(state: r3.state)
      if is_err(pr: ret) { return ret }
      let return_type = match ret.val.return_type {
        Some { value: t } => t
        None => Named { name: "Unit", span: start_span }
      }
      let item = ExternFuncDecl {
        name: name, params: r3.val.params,
        return_type: return_type, span: start_span
      }
      ok(val: { item: item }, state: skip_newlines(state: ret.state))
    }
    Some { value: KwFunc } => {
      let adv = advance(state: r.state)
      let r2 = expect_ident(state: adv.state)
      if is_err(pr: r2) { return r2 }
      let name = r2.val.name
      let r3 = parse_params(state: r2.state)
      if is_err(pr: r3) { return r3 }
      let ret = parse_optional_return_type(state: r3.state)
      if is_err(pr: ret) { return ret }
      let return_type = match ret.val.return_type {
        Some { value: t } => t
        None => Named { name: "Unit", span: start_span }
      }
      let item = ExternFuncDecl {
        name: name, params: r3.val.params,
        return_type: return_type, span: start_span
      }
      ok(val: { item: item }, state: skip_newlines(state: ret.state))
    }
    _ => fail(msg: "expected fn or func after extern", state: r.state)
  }
}

// =========================================================================
// 13. parse_params: (name: Type, name2: Type)
// =========================================================================

fn parse_params(state: ParserState) -> PR {
  let r = expect(state: state, tag: "LParen")
  if is_err(pr: r) { return r }
  let s = skip_newlines(state: r.state)

  if check(state: s, tag: "RParen") {
    let adv = advance(state: s)
    ok(val: { params: [] }, state: adv.state)
  } else {
    let r = parse_param_list(state: s)
    if is_err(pr: r) { return r }
    let s = skip_newlines(state: r.state)
    let r2 = expect(state: s, tag: "RParen")
    if is_err(pr: r2) { return r2 }
    ok(val: { params: r.val.params }, state: r2.state)
  }
}

fn parse_param_list(state: ParserState) -> PR {
  let r = parse_param(state: state)
  if is_err(pr: r) { return r }
  let s = r.state

  let e = eat(state: s, tag: "Comma")
  if e.consumed {
    let s2 = skip_newlines(state: e.state)
    if check(state: s2, tag: "RParen") {
      // Trailing comma
      ok(val: { params: [r.val.param] }, state: s2)
    } else {
      let rest = parse_param_list(state: s2)
      if is_err(pr: rest) { return rest }
      ok(val: { params: [r.val.param] +rest.val.params }, state: rest.state)
    }
  } else {
    ok(val: { params: [r.val.param] }, state: s)
  }
}

fn parse_param(state: ParserState) -> PR {
  let start_span = current_span(state: state)
  let r = expect_ident(state: state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r2 = expect(state: r.state, tag: "Colon")
  if is_err(pr: r2) { return r2 }

  let r3 = parse_type_expr(state: r2.state)
  if is_err(pr: r3) { return r3 }
  let s = r3.state

  // Optional default value
  let e = eat(state: s, tag: "Eq")
  if e.consumed {
    let r4 = parse_expr(state: e.state)
    if is_err(pr: r4) { return r4 }
    let p = Param {
      name: name, type_expr: r3.val.type_expr,
      default_value: Some { value: r4.val.expr }, span: start_span
    }
    ok(val: { param: p }, state: r4.state)
  } else {
    let p = Param {
      name: name, type_expr: r3.val.type_expr,
      default_value: none, span: start_span
    }
    ok(val: { param: p }, state: s)
  }
}

// =========================================================================
// 14. parse_block: { stmt1 \n stmt2 \n result_expr }
// =========================================================================

fn parse_block(state: ParserState) -> PR {
  let r = expect(state: state, tag: "LBrace")
  if is_err(pr: r) { return r }
  let s = skip_newlines(state: r.state)

  let r = parse_stmts(state: s)
  if is_err(pr: r) { return r }
  let stmts = r.val.stmts
  let s = skip_newlines(state: r.state)

  let r = expect(state: s, tag: "RBrace")
  if is_err(pr: r) { return r }

  // If only one statement, unwrap from Block
  if count(stmts) == 1 {
    ok(val: { expr: first(stmts).value }, state: r.state)
  } else {
    let span = current_span(state: state)
    ok(val: { expr: Block { stmts: stmts, span: span } }, state: r.state)
  }
}

fn parse_stmts(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) || check(state: s, tag: "Eof") {
    ok(val: { stmts: [] }, state: s)
  } else {
    let r = parse_stmt(state: s)
    if is_err(pr: r) { return r }
    let s2 = skip_newlines(state: r.state)
    let rest = parse_stmts(state: s2)
    if is_err(pr: rest) { return rest }
    ok(val: { stmts: [r.val.expr] +rest.val.stmts }, state: rest.state)
  }
}

fn parse_stmt(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: KwLet } => parse_let(state: state)
    Some { value: KwReturn } => parse_return(state: state)
    Some { value: Ident { name: _ } } => {
      // Check for bare assignment: ident = expr (without let keyword)
      if peek_is_eq_after_ident(state: state) {
        parse_bare_assignment(state: state)
      } else {
        parse_expr(state: state)
      }
    }
    _ => parse_expr(state: state)
  }
}

// Peek two tokens: is pos+1 an Eq (=) token? Used for bare assignment detection.
fn peek_is_eq_after_ident(state: ParserState) -> Bool {
  if state.pos + 1 < count(state.tokens) {
    let next_tok = first(skip(state.tokens, n: state.pos + 1))
    match next_tok {
      Some { value: t } => kind_tag(kind: t.kind) == "Eq"
      None => false
    }
  } else {
    false
  }
}

// Parse bare assignment: name = expr → desugar to Let { name, value, body: none }
fn parse_bare_assignment(state: ParserState) -> PR {
  let span = current_span(state: state)
  let r = expect_ident(state: state)
  if is_err(pr: r) { return r }
  let name = r.val.name
  let r2 = expect(state: r.state, tag: "Eq")
  if is_err(pr: r2) { return r2 }
  let r3 = parse_expr(state: r2.state)
  if is_err(pr: r3) { return r3 }
  ok(val: { expr: Let { name: name, value: r3.val.expr, body: none, span: span } }, state: r3.state)
}

// =========================================================================
// 15. parse_expr — Pratt precedence climbing entry
// =========================================================================

fn parse_expr(state: ParserState) -> PR {
  parse_expr_bp(state: state, min_bp: 0)
}

// =========================================================================
// 16. parse_expr_bp — precedence climbing core
// =========================================================================

fn parse_expr_bp(state: ParserState, min_bp: Int) -> PR {
  // Parse prefix (unary ops or primary)
  let r = parse_prefix(state: state)
  if is_err(pr: r) { return r }
  let lhs = r.val.expr
  let s = r.state
  parse_expr_loop(state: s, lhs: lhs, min_bp: min_bp)
}

fn parse_expr_loop(state: ParserState, lhs: Expr, min_bp: Int) -> PR {
  if at_end(state: state) || check(state: state, tag: "Eof") {
    ok(val: { expr: lhs }, state: state)
  } else {
    // Try postfix: .field, (args), as Type
    let post = try_postfix(state: state, lhs: lhs, min_bp: min_bp)
    if post.val.changed {
      parse_expr_loop(state: post.state, lhs: post.val.expr, min_bp: min_bp)
    } else {
      // Try infix: binary operators
      let bp = infix_bp(state: state)
      match bp {
        Some { value: bps } => {
          if bps.left < min_bp {
            ok(val: { expr: lhs }, state: state)
          } else {
            let adv = advance(state: state)
            let op_kind = adv.token.kind
            // Special case: dot is field access
            if kind_tag(kind: op_kind) == "Dot" {
              let r = expect_ident(state: adv.state)
              if is_err(pr: r) { return r }
              let span = current_span(state: state)
              let new_lhs = FieldAccess { base: lhs, field: r.val.name, span: span }
              parse_expr_loop(state: r.state, lhs: new_lhs, min_bp: min_bp)
            } else if kind_tag(kind: op_kind) == "PipeArrow" {
              // Pipe arrow: lhs |> method(args) or lhs |> method
              // Desugar to MethodCall { receiver: lhs, method, args }
              let span = current_span(state: state)
              let r = parse_pipe_rhs(state: adv.state, receiver: lhs, span: span)
              if is_err(pr: r) { return r }
              parse_expr_loop(state: r.state, lhs: r.val.expr, min_bp: min_bp)
            } else {
              let r = parse_expr_bp(state: adv.state, min_bp: bps.right)
              if is_err(pr: r) { return r }
              let span = current_span(state: state)
              let binop = token_to_binop(kind: op_kind)
              let new_lhs = BinOp { op: binop, left: lhs, right: r.val.expr, span: span }
              parse_expr_loop(state: r.state, lhs: new_lhs, min_bp: min_bp)
            }
          }
        }
        None => ok(val: { expr: lhs }, state: state)
      }
    }
  }
}

fn infix_bp(state: ParserState) -> Map? {
  let k = peek_kind(state: state)
  match k {
    Some { value: PipeArrow }    => Some { value: { left: 0, right: 1 } }
    Some { value: NullCoalesce } => Some { value: { left: 1, right: 0 } }
    Some { value: Or }       => Some { value: { left: 2, right: 3 } }
    Some { value: And }      => Some { value: { left: 4, right: 5 } }
    Some { value: EqEq }     => Some { value: { left: 6, right: 7 } }
    Some { value: Ne }       => Some { value: { left: 6, right: 7 } }
    Some { value: Lt }       => Some { value: { left: 6, right: 7 } }
    Some { value: Gt }       => Some { value: { left: 6, right: 7 } }
    Some { value: Le }       => Some { value: { left: 6, right: 7 } }
    Some { value: Ge }       => Some { value: { left: 6, right: 7 } }
    Some { value: Plus }     => Some { value: { left: 8, right: 9 } }
    Some { value: Minus }    => Some { value: { left: 8, right: 9 } }
    Some { value: Star }     => Some { value: { left: 10, right: 11 } }
    Some { value: Slash }    => Some { value: { left: 10, right: 11 } }
    Some { value: Percent }  => Some { value: { left: 10, right: 11 } }
    Some { value: Dot }      => Some { value: { left: 14, right: 15 } }
    _ => none
  }
}

fn token_to_binop(kind: TokenKind) -> BinOpKind {
  match kind {
    Plus => Add
    Minus => Sub
    Star => Mul
    Slash => Div
    Percent => Mod
    EqEq => BinEq
    Ne => BinNe
    Lt => BinLt
    Gt => BinGt
    Le => BinLe
    Ge => BinGe
    And => BinAnd
    Or => BinOr
    NullCoalesce => NullCoalesce
    _ => Add
  }
}

// parse_pipe_rhs: after |>, parse the method name and optional (args).
// Produces MethodCall { receiver, method, args }.
// Supports: lhs |> method, lhs |> method(args), lhs |> method(name: arg)
fn parse_pipe_rhs(state: ParserState, receiver: Expr, span: SourceSpan) -> PR {
  let r = expect_ident(state: state)
  if is_err(pr: r) { return r }
  let method = r.val.name
  let s = r.state

  // Check for (args) after method name
  if check(state: s, tag: "LParen") {
    let r2 = parse_call_args(state: s)
    if is_err(pr: r2) { return r2 }
    ok(val: { expr: MethodCall { receiver: receiver, method: method, args: r2.val.args, span: span } }, state: r2.state)
  } else {
    // No args — bare method call: lhs |> method
    ok(val: { expr: MethodCall { receiver: receiver, method: method, args: [], span: span } }, state: s)
  }
}

fn parse_prefix(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    Some { value: Bang } => {
      let adv = advance(state: state)
      let span = current_span(state: state)
      let r = parse_expr_bp(state: adv.state, min_bp: 12)
      if is_err(pr: r) { return r }
      ok(val: { expr: UnaryOp { op: Not, operand: r.val.expr, span: span } }, state: r.state)
    }
    Some { value: Minus } => {
      let adv = advance(state: state)
      let span = current_span(state: state)
      let r = parse_expr_bp(state: adv.state, min_bp: 12)
      if is_err(pr: r) { return r }
      ok(val: { expr: UnaryOp { op: Neg, operand: r.val.expr, span: span } }, state: r.state)
    }
    _ => parse_primary(state: state)
  }
}

// =========================================================================
// 17. parse_primary
// =========================================================================

fn parse_primary(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  let span = current_span(state: state)
  match k {
    // Boolean literals
    Some { value: KwTrue } => {
      let adv = advance(state: state)
      ok(val: { expr: Literal { value: LitBool { value: true }, span: span } }, state: adv.state)
    }
    Some { value: KwFalse } => {
      let adv = advance(state: state)
      ok(val: { expr: Literal { value: LitBool { value: false }, span: span } }, state: adv.state)
    }
    Some { value: KwNone } => {
      let adv = advance(state: state)
      ok(val: { expr: Literal { value: LitNull, span: span } }, state: adv.state)
    }

    // Numeric literals
    Some { value: LitInt { value: n } } => {
      let adv = advance(state: state)
      ok(val: { expr: Literal { value: LitInt { value: n }, span: span } }, state: adv.state)
    }
    Some { value: LitFloat { value: f } } => {
      let adv = advance(state: state)
      ok(val: { expr: Literal { value: LitFloat { value: f }, span: span } }, state: adv.state)
    }

    // String literal
    Some { value: LitStr { value: s } } => {
      let adv = advance(state: state)
      ok(val: { expr: Literal { value: LitStr { value: s }, span: span } }, state: adv.state)
    }

    // String interpolation
    Some { value: StrBegin { value: s } } => parse_string_interp(state: state)

    // Identifier — could be variable, function call, record literal, or lambda
    Some { value: Ident { name: n } } => parse_ident_expr(state: state, name: n)

    // Parenthesized expr or multi-param lambda
    Some { value: LParen } => parse_paren_expr(state: state)

    // List literal
    Some { value: LBracket } => parse_list_literal(state: state)

    // Block or record literal
    Some { value: LBrace } => parse_brace_expr(state: state)

    // Match expression
    Some { value: KwMatch } => parse_match(state: state)

    // If expression
    Some { value: KwIf } => parse_if(state: state)

    // For expression
    Some { value: KwFor } => parse_for(state: state)

    // Let binding (when used as expression in block)
    Some { value: KwLet } => parse_let(state: state)

    // Return
    Some { value: KwReturn } => parse_return(state: state)

    _ => {
      let tag = match k {
        Some { value: kind } => kind_tag(kind: kind)
        None => "EOF"
      }
      fail(msg: "expected expression, found {tag}", state: state)
    }
  }
}

// =========================================================================
// Identifier-initiated expressions
// =========================================================================

fn parse_ident_expr(state: ParserState, name: String) -> PR {
  let span = current_span(state: state)
  let adv = advance(state: state)
  let s = adv.state

  // Check for lambda: name => body
  if check(state: s, tag: "FatArrow") {
    let adv2 = advance(state: s)
    let r = parse_expr(state: adv2.state)
    if is_err(pr: r) { return r }
    ok(val: { expr: Lambda { params: [name], body: r.val.expr, span: span } }, state: r.state)
  } else {
    // Check for record literal: Name { field: val }
    // Only if name starts with uppercase (variant/record constructor)
    if is_uppercase_start(name: name) && check(state: s, tag: "LBrace") {
      parse_record_literal(state: s, name: name, span: span)
    } else {
      ok(val: { expr: Var { name: name, span: span } }, state: s)
    }
  }
}

fn is_uppercase_start(name: String) -> Bool {
  let ch = char_at(s: name, pos: 0)
  ch >= "A" && ch <= "Z"
}

// =========================================================================
// 18. try_postfix — .field, (args), as Type, ?
// =========================================================================

fn try_postfix(state: ParserState, lhs: Expr, min_bp: Int) -> PR {
  let k = peek_kind(state: state)
  let span = current_span(state: state)
  match k {
    // Function call: expr(args)
    Some { value: LParen } => {
      if 14 < min_bp {
        ok(val: { expr: lhs, changed: false }, state: state)
      } else {
        let r = parse_call_args(state: state)
        if is_err(pr: r) { return r }
        // Determine if this is Call or MethodCall based on lhs
        let call_expr = make_call_expr(lhs: lhs, args: r.val.args, span: span)
        ok(val: { expr: call_expr, changed: true }, state: r.state)
      }
    }
    // `as` cast: expr as Type (bp 13, tighter than comparisons, looser than .)
    Some { value: Ident { name: "as" } } => {
      if 13 < min_bp {
        ok(val: { expr: lhs, changed: false }, state: state)
      } else {
        let adv = advance(state: state)
        let r = parse_type_expr(state: adv.state)
        if is_err(pr: r) { return r }
        ok(val: { expr: Cast { expr: lhs, target: r.val.type_expr, span: span }, changed: true }, state: r.state)
      }
    }
    // Record suffix: Name { field: val } already handled in parse_ident_expr
    Some { value: LBrace } => {
      // Only for uppercase identifiers (constructors)
      match lhs {
        Var { name: n, span: sp } => {
          if is_uppercase_start(name: n) && 14 <= min_bp {
            ok(val: { expr: lhs, changed: false }, state: state)
          } else {
            if is_uppercase_start(name: n) {
              let r = parse_record_literal(state: state, name: n, span: sp)
              if is_err(pr: r) { return r }
              ok(val: { expr: r.val.expr, changed: true }, state: r.state)
            } else {
              ok(val: { expr: lhs, changed: false }, state: state)
            }
          }
        }
        _ => ok(val: { expr: lhs, changed: false }, state: state)
      }
    }
    _ => ok(val: { expr: lhs, changed: false }, state: state)
  }
}

fn make_call_expr(lhs: Expr, args: List<NamedArg>, span: SourceSpan) -> Expr {
  match lhs {
    Var { name: n, span: _ } => Call { func: n, args: args, span: span }
    FieldAccess { base: b, field: f, span: _ } => MethodCall { receiver: b, method: f, args: args, span: span }
    _ => Call { func: "<expr>", args: args, span: span }
  }
}

// =========================================================================
// 25. parse_call_args: (arg: val, arg2: val2)
// =========================================================================

fn parse_call_args(state: ParserState) -> PR {
  let r = expect(state: state, tag: "LParen")
  if is_err(pr: r) { return r }
  let s = skip_newlines(state: r.state)

  if check(state: s, tag: "RParen") {
    let adv = advance(state: s)
    ok(val: { args: [] }, state: adv.state)
  } else {
    let r = parse_arg_list(state: s)
    if is_err(pr: r) { return r }
    let s = skip_newlines(state: r.state)
    let r2 = expect(state: s, tag: "RParen")
    if is_err(pr: r2) { return r2 }
    ok(val: { args: r.val.args }, state: r2.state)
  }
}

fn parse_arg_list(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  let r = parse_single_arg(state: s)
  if is_err(pr: r) { return r }
  let s = r.state

  let e = eat(state: s, tag: "Comma")
  if e.consumed {
    let s2 = skip_newlines(state: e.state)
    if check(state: s2, tag: "RParen") {
      ok(val: { args: [r.val.arg] }, state: s2)
    } else {
      let rest = parse_arg_list(state: s2)
      if is_err(pr: rest) { return rest }
      ok(val: { args: [r.val.arg] +rest.val.args }, state: rest.state)
    }
  } else {
    ok(val: { args: [r.val.arg] }, state: s)
  }
}

fn parse_single_arg(state: ParserState) -> PR {
  // Check for named argument: ident: expr
  // We need lookahead: if ident followed by colon, it's named
  if is_ident(state: state) {
    let k = peek_kind(state: state)
    match k {
      Some { value: Ident { name: n } } => {
        // Check token after ident for colon
        let save_pos = state.pos
        let adv = advance(state: state)
        if check(state: adv.state, tag: "Colon") {
          let adv2 = advance(state: adv.state)
          let r = parse_expr(state: adv2.state)
          if is_err(pr: r) { return r }
          let arg = NamedArg { name: Some { value: n }, value: r.val.expr }
          ok(val: { arg: arg }, state: r.state)
        } else {
          // Not named — restore and parse as positional
          let restored = with(state, { pos: save_pos })
          let r = parse_expr(state: restored)
          if is_err(pr: r) { return r }
          let arg = NamedArg { name: none, value: r.val.expr }
          ok(val: { arg: arg }, state: r.state)
        }
      }
      _ => {
        let r = parse_expr(state: state)
        if is_err(pr: r) { return r }
        let arg = NamedArg { name: none, value: r.val.expr }
        ok(val: { arg: arg }, state: r.state)
      }
    }
  } else {
    let r = parse_expr(state: state)
    if is_err(pr: r) { return r }
    let arg = NamedArg { name: none, value: r.val.expr }
    ok(val: { arg: arg }, state: r.state)
  }
}

// =========================================================================
// 19. parse_match
// =========================================================================

fn parse_match(state: ParserState) -> PR {
  let span = current_span(state: state)
  let r = expect(state: state, tag: "KwMatch")
  if is_err(pr: r) { return r }

  // Parse scrutinee (stop before LBrace)
  let r = parse_expr_no_brace(state: r.state)
  if is_err(pr: r) { return r }
  let scrutinee = r.val.expr

  let r = expect(state: skip_newlines(state: r.state), tag: "LBrace")
  if is_err(pr: r) { return r }

  let r = parse_match_arms(state: skip_newlines(state: r.state))
  if is_err(pr: r) { return r }
  let arms = r.val.arms

  let r = expect(state: skip_newlines(state: r.state), tag: "RBrace")
  if is_err(pr: r) { return r }

  ok(val: { expr: Match { scrutinee: scrutinee, arms: arms, span: span } }, state: r.state)
}

// Parse expression but stop before LBrace (for match/if/for scrutinees)
fn parse_expr_no_brace(state: ParserState) -> PR {
  // Use a restricted precedence climbing that stops at LBrace
  parse_expr_bp_no_brace(state: state, min_bp: 0)
}

fn parse_expr_bp_no_brace(state: ParserState, min_bp: Int) -> PR {
  let r = parse_prefix(state: state)
  if is_err(pr: r) { return r }
  let lhs = r.val.expr
  parse_expr_loop_no_brace(state: r.state, lhs: lhs, min_bp: min_bp)
}

fn parse_expr_loop_no_brace(state: ParserState, lhs: Expr, min_bp: Int) -> PR {
  if at_end(state: state) || check(state: state, tag: "Eof") || check(state: state, tag: "LBrace") {
    ok(val: { expr: lhs }, state: state)
  } else {
    // Try postfix call
    if check(state: state, tag: "LParen") && 14 >= min_bp {
      let r = parse_call_args(state: state)
      if is_err(pr: r) { return r }
      let span = current_span(state: state)
      let new_lhs = make_call_expr(lhs: lhs, args: r.val.args, span: span)
      parse_expr_loop_no_brace(state: r.state, lhs: new_lhs, min_bp: min_bp)
    } else {
      let bp = infix_bp(state: state)
      match bp {
        Some { value: bps } => {
          if bps.left < min_bp {
            ok(val: { expr: lhs }, state: state)
          } else {
            let adv = advance(state: state)
            let op_kind = adv.token.kind
            if kind_tag(kind: op_kind) == "Dot" {
              let r = expect_ident(state: adv.state)
              if is_err(pr: r) { return r }
              let span = current_span(state: state)
              let new_lhs = FieldAccess { base: lhs, field: r.val.name, span: span }
              parse_expr_loop_no_brace(state: r.state, lhs: new_lhs, min_bp: min_bp)
            } else if kind_tag(kind: op_kind) == "PipeArrow" {
              let span = current_span(state: state)
              let r = parse_pipe_rhs(state: adv.state, receiver: lhs, span: span)
              if is_err(pr: r) { return r }
              parse_expr_loop_no_brace(state: r.state, lhs: r.val.expr, min_bp: min_bp)
            } else {
              let r = parse_expr_bp_no_brace(state: adv.state, min_bp: bps.right)
              if is_err(pr: r) { return r }
              let span = current_span(state: state)
              let binop = token_to_binop(kind: op_kind)
              let new_lhs = BinOp { op: binop, left: lhs, right: r.val.expr, span: span }
              parse_expr_loop_no_brace(state: r.state, lhs: new_lhs, min_bp: min_bp)
            }
          }
        }
        None => ok(val: { expr: lhs }, state: state)
      }
    }
  }
}

fn parse_match_arms(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { arms: [] }, state: s)
  } else {
    let r = parse_match_arm(state: s)
    if is_err(pr: r) { return r }
    let e = eat(state: r.state, tag: "Comma")
    let s2 = skip_newlines(state: if e.consumed { e.state } else { r.state })
    let rest = parse_match_arms(state: s2)
    if is_err(pr: rest) { return rest }
    ok(val: { arms: [r.val.arm] +rest.val.arms }, state: rest.state)
  }
}

// =========================================================================
// 20. parse_match_arm: Pattern => expr
// =========================================================================

fn parse_match_arm(state: ParserState) -> PR {
  let r = parse_pattern(state: state)
  if is_err(pr: r) { return r }
  let pat = r.val.pattern
  let s = r.state

  // Optional guard: if cond
  let guard_r = parse_optional_guard(state: s)
  if is_err(pr: guard_r) { return guard_r }
  let guard = guard_r.val.guard
  let s = guard_r.state

  let r = expect(state: s, tag: "FatArrow")
  if is_err(pr: r) { return r }

  // Arm body — could be block or expression
  let s = skip_newlines(state: r.state)
  let r = if check(state: s, tag: "LBrace") {
    parse_block(state: s)
  } else {
    parse_expr(state: s)
  }
  if is_err(pr: r) { return r }

  let arm = MatchArm { pattern: pat, guard: guard, body: r.val.expr }
  ok(val: { arm: arm }, state: r.state)
}

fn parse_optional_guard(state: ParserState) -> PR {
  if check(state: state, tag: "KwIf") {
    let adv = advance(state: state)
    let r = parse_expr(state: adv.state)
    if is_err(pr: r) { return r }
    ok(val: { guard: Some { value: r.val.expr } }, state: r.state)
  } else {
    ok(val: { guard: none }, state: state)
  }
}

// =========================================================================
// 21. parse_pattern
// =========================================================================

fn parse_pattern(state: ParserState) -> PR {
  let k = peek_kind(state: state)
  match k {
    // Identifier: could be variant, binding, or wildcard
    Some { value: Ident { name: n } } => {
      let adv = advance(state: state)
      if n == "_" {
        ok(val: { pattern: Wildcard }, state: adv.state)
      } else {
        if is_uppercase_start(name: n) {
          // Variant pattern: Name { bindings } or Name(bindings) or unit variant
          parse_variant_pattern(state: adv.state, name: n)
        } else {
          // Lowercase: binding
          ok(val: { pattern: Bind { name: n } }, state: adv.state)
        }
      }
    }
    // Literal patterns
    Some { value: KwTrue } => {
      let adv = advance(state: state)
      ok(val: { pattern: LitPattern { value: LitBool { value: true } } }, state: adv.state)
    }
    Some { value: KwFalse } => {
      let adv = advance(state: state)
      ok(val: { pattern: LitPattern { value: LitBool { value: false } } }, state: adv.state)
    }
    Some { value: KwNone } => {
      let adv = advance(state: state)
      ok(val: { pattern: LitPattern { value: LitNull } }, state: adv.state)
    }
    Some { value: LitInt { value: n } } => {
      let adv = advance(state: state)
      ok(val: { pattern: LitPattern { value: LitInt { value: n } } }, state: adv.state)
    }
    Some { value: LitStr { value: s } } => {
      let adv = advance(state: state)
      ok(val: { pattern: LitPattern { value: LitStr { value: s } } }, state: adv.state)
    }
    _ => ok(val: { pattern: Wildcard }, state: state)
  }
}

fn parse_variant_pattern(state: ParserState, name: String) -> PR {
  // Check for { field: binding, ... } or ( binding, ... )
  if check(state: state, tag: "LBrace") {
    let adv = advance(state: state)
    let r = parse_variant_bindings_brace(state: skip_newlines(state: adv.state))
    if is_err(pr: r) { return r }
    let r2 = expect(state: skip_newlines(state: r.state), tag: "RBrace")
    if is_err(pr: r2) { return r2 }
    ok(val: { pattern: VariantPattern { name: name, field_bindings: r.val.field_bindings } }, state: r2.state)
  } else {
    // Unit variant
    ok(val: { pattern: VariantPattern { name: name, field_bindings: [] } }, state: state)
  }
}

fn parse_variant_bindings_brace(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { field_bindings: [] }, state: s)
  } else {
    let r = expect_ident(state: s)
    if is_err(pr: r) { return r }
    let field_name = r.val.name
    let s = r.state

    // Check for : binding
    let e = eat(state: s, tag: "Colon")
    if e.consumed {
      let r2 = expect_ident(state: e.state)
      if is_err(pr: r2) { return r2 }
      let binding_name = r2.val.name
      let s2 = r2.state
      let e2 = eat(state: s2, tag: "Comma")
      let s3 = skip_newlines(state: if e2.consumed { e2.state } else { s2 })
      let rest = parse_variant_bindings_brace(state: s3)
      if is_err(pr: rest) { return rest }
      let fb = FieldBinding { field_name: field_name, binding: Bind { name: binding_name } }
      ok(val: { field_bindings: [fb] + rest.val.field_bindings }, state: rest.state)
    } else {
      // Shorthand: field_name binds to itself
      let e2 = eat(state: s, tag: "Comma")
      let s2 = skip_newlines(state: if e2.consumed { e2.state } else { s })
      let rest = parse_variant_bindings_brace(state: s2)
      if is_err(pr: rest) { return rest }
      let fb = FieldBinding { field_name: field_name, binding: Bind { name: field_name } }
      ok(val: { field_bindings: [fb] + rest.val.field_bindings }, state: rest.state)
    }
  }
}

// =========================================================================
// 22. parse_if
// =========================================================================

fn parse_if(state: ParserState) -> PR {
  let span = current_span(state: state)
  let r = expect(state: state, tag: "KwIf")
  if is_err(pr: r) { return r }

  let r = parse_expr_no_brace(state: r.state)
  if is_err(pr: r) { return r }
  let condition = r.val.expr

  let r = parse_block(state: skip_newlines(state: r.state))
  if is_err(pr: r) { return r }
  let then_branch = r.val.expr
  let s = skip_newlines(state: r.state)

  // Optional else
  let e = eat(state: s, tag: "KwElse")
  if e.consumed {
    let s = skip_newlines(state: e.state)
    // else if
    if check(state: s, tag: "KwIf") {
      let r2 = parse_if(state: s)
      if is_err(pr: r2) { return r2 }
      ok(val: { expr: If { condition: condition, then_branch: then_branch, else_branch: Some { value: r2.val.expr }, span: span } }, state: r2.state)
    } else {
      let r2 = parse_block(state: s)
      if is_err(pr: r2) { return r2 }
      ok(val: { expr: If { condition: condition, then_branch: then_branch, else_branch: Some { value: r2.val.expr }, span: span } }, state: r2.state)
    }
  } else {
    ok(val: { expr: If { condition: condition, then_branch: then_branch, else_branch: none, span: span } }, state: s)
  }
}

// =========================================================================
// 23. parse_let: let name = value
// =========================================================================

fn parse_let(state: ParserState) -> PR {
  let span = current_span(state: state)
  let r = expect(state: state, tag: "KwLet")
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let name = r.val.name

  let r = expect(state: r.state, tag: "Eq")
  if is_err(pr: r) { return r }

  let r = parse_expr(state: r.state)
  if is_err(pr: r) { return r }

  ok(val: { expr: Let { name: name, value: r.val.expr, body: none, span: span } }, state: r.state)
}

// =========================================================================
// Return: return expr or return { field: val }
// =========================================================================

fn parse_return(state: ParserState) -> PR {
  let span = current_span(state: state)
  let r = expect(state: state, tag: "KwReturn")
  if is_err(pr: r) { return r }

  let r = parse_expr(state: r.state)
  if is_err(pr: r) { return r }
  // Return is just the expression — in DSL semantics the last expression
  // is the return value. We wrap it as-is.
  ok(val: { expr: r.val.expr }, state: r.state)
}

// =========================================================================
// 24. parse_for: for x in collection { body }
// =========================================================================

fn parse_for(state: ParserState) -> PR {
  let span = current_span(state: state)
  let r = expect(state: state, tag: "KwFor")
  if is_err(pr: r) { return r }

  let r = expect_ident(state: r.state)
  if is_err(pr: r) { return r }
  let var_name = r.val.name

  let r = expect(state: r.state, tag: "KwIn")
  if is_err(pr: r) { return r }

  let r = parse_expr_no_brace(state: r.state)
  if is_err(pr: r) { return r }
  let collection = r.val.expr

  let r = parse_block(state: skip_newlines(state: r.state))
  if is_err(pr: r) { return r }
  let body = r.val.expr

  // Model for-loop as a method call: collection.map(var_name => body)
  // This produces a Call to a synthetic "for" expression
  let for_expr = Call {
    func: "for",
    args: [
      NamedArg { name: Some { value: "var" }, value: Literal { value: LitStr { value: var_name }, span: span } },
      NamedArg { name: Some { value: "collection" }, value: collection },
      NamedArg { name: Some { value: "body" }, value: Lambda { params: [var_name], body: body, span: span } }
    ],
    span: span
  }
  ok(val: { expr: for_expr }, state: r.state)
}

// =========================================================================
// 26. parse_record_literal: Name { field: val, field2: val2 }
// =========================================================================

fn parse_record_literal(state: ParserState, name: String, span: SourceSpan) -> PR {
  let r = expect(state: state, tag: "LBrace")
  if is_err(pr: r) { return r }
  let s = skip_newlines(state: r.state)

  let r = parse_field_init_list(state: s)
  if is_err(pr: r) { return r }

  let s = skip_newlines(state: r.state)
  let r2 = expect(state: s, tag: "RBrace")
  if is_err(pr: r2) { return r2 }

  ok(val: { expr: RecordLit { type_name: Some { value: name }, fields: r.val.fields, span: span } }, state: r2.state)
}

fn parse_field_init_list(state: ParserState) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: "RBrace") || at_end(state: s) {
    ok(val: { fields: [] }, state: s)
  } else {
    let r = parse_field_init(state: s)
    if is_err(pr: r) { return r }
    let e = eat(state: r.state, tag: "Comma")
    let s2 = skip_newlines(state: if e.consumed { e.state } else { r.state })
    let rest = parse_field_init_list(state: s2)
    if is_err(pr: rest) { return rest }
    ok(val: { fields: [r.val.field] +rest.val.fields }, state: rest.state)
  }
}

fn parse_field_init(state: ParserState) -> PR {
  // Named field: name: expr
  if is_ident(state: state) {
    let k = peek_kind(state: state)
    match k {
      Some { value: Ident { name: n } } => {
        let save = state.pos
        let adv = advance(state: state)
        if check(state: adv.state, tag: "Colon") {
          let adv2 = advance(state: adv.state)
          let r = parse_expr(state: adv2.state)
          if is_err(pr: r) { return r }
          let fi = FieldInit { name: n, value: r.val.expr }
          ok(val: { field: fi }, state: r.state)
        } else {
          // Shorthand: { name } => { name: name }
          let fi = FieldInit { name: n, value: Var { name: n, span: current_span(state: state) } }
          ok(val: { field: fi }, state: adv.state)
        }
      }
      _ => {
        let r = parse_expr(state: state)
        if is_err(pr: r) { return r }
        let fi = FieldInit { name: "_", value: r.val.expr }
        ok(val: { field: fi }, state: r.state)
      }
    }
  } else {
    let r = parse_expr(state: state)
    if is_err(pr: r) { return r }
    let fi = FieldInit { name: "_", value: r.val.expr }
    ok(val: { field: fi }, state: r.state)
  }
}

// =========================================================================
// 27. parse_list_literal: [expr1, expr2]
// =========================================================================

fn parse_list_literal(state: ParserState) -> PR {
  let span = current_span(state: state)
  let r = expect(state: state, tag: "LBracket")
  if is_err(pr: r) { return r }

  let r = parse_expr_list_until(state: skip_newlines(state: r.state), end_tag: "RBracket")
  if is_err(pr: r) { return r }

  let r2 = expect(state: skip_newlines(state: r.state), tag: "RBracket")
  if is_err(pr: r2) { return r2 }

  ok(val: { expr: ListLit { elements: r.val.exprs, span: span } }, state: r2.state)
}

fn parse_expr_list_until(state: ParserState, end_tag: String) -> PR {
  let s = skip_newlines(state: state)
  if check(state: s, tag: end_tag) || at_end(state: s) {
    ok(val: { exprs: [] }, state: s)
  } else {
    let r = parse_expr(state: s)
    if is_err(pr: r) { return r }
    let e = eat(state: r.state, tag: "Comma")
    let s2 = skip_newlines(state: if e.consumed { e.state } else { r.state })
    let rest = parse_expr_list_until(state: s2, end_tag: end_tag)
    if is_err(pr: rest) { return rest }
    ok(val: { exprs: [r.val.expr] +rest.val.exprs }, state: rest.state)
  }
}

// =========================================================================
// 28. parse_lambda: x => expr or (x, y) => expr
//     Single-param lambda handled in parse_ident_expr
//     Multi-param lambda handled in parse_paren_expr
// =========================================================================

// =========================================================================
// Parenthesized expression or multi-param lambda
// =========================================================================

fn parse_paren_expr(state: ParserState) -> PR {
  let span = current_span(state: state)
  let r = expect(state: state, tag: "LParen")
  if is_err(pr: r) { return r }
  let s = skip_newlines(state: r.state)

  // Empty parens
  if check(state: s, tag: "RParen") {
    let adv = advance(state: s)
    ok(val: { expr: RecordLit { type_name: none, fields: [], span: span } }, state: adv.state)
  } else {
    // Try multi-param lambda: (a, b) => body
    let lambda_r = try_lambda_params(state: s)
    if lambda_r.val.is_lambda {
      let r = parse_expr(state: lambda_r.state)
      if is_err(pr: r) { return r }
      ok(val: { expr: Lambda { params: lambda_r.val.params, body: r.val.expr, span: span } }, state: r.state)
    } else {
      // Parenthesized expression
      let r = parse_expr(state: s)
      if is_err(pr: r) { return r }
      let s = skip_newlines(state: r.state)
      let r2 = expect(state: s, tag: "RParen")
      if is_err(pr: r2) { return r2 }
      ok(val: { expr: r.val.expr }, state: r2.state)
    }
  }
}

fn try_lambda_params(state: ParserState) -> PR {
  // Save position for backtracking
  let save_pos = state.pos

  // Collect identifiers separated by commas until )
  let r = collect_lambda_idents(state: state, acc: [])
  if r.val.success && count(r.val.params) >= 2 {
    // Check for ) =>
    if check(state: r.state, tag: "RParen") {
      let adv = advance(state: r.state)
      if check(state: adv.state, tag: "FatArrow") {
        let adv2 = advance(state: adv.state)
        ok(val: { is_lambda: true, params: r.val.params }, state: adv2.state)
      } else {
        // Not a lambda, restore
        let restored = with(state, { pos: save_pos })
        ok(val: { is_lambda: false, params: [] }, state: restored)
      }
    } else {
      let restored = with(state, { pos: save_pos })
      ok(val: { is_lambda: false, params: [] }, state: restored)
    }
  } else {
    let restored = with(state, { pos: save_pos })
    ok(val: { is_lambda: false, params: [] }, state: restored)
  }
}

fn collect_lambda_idents(state: ParserState, acc: List<String>) -> PR {
  if is_ident(state: state) {
    let k = peek_kind(state: state)
    match k {
      Some { value: Ident { name: n } } => {
        let adv = advance(state: state)
        let new_acc = acc +[n]
        let e = eat(state: adv.state, tag: "Comma")
        if e.consumed {
          collect_lambda_idents(state: e.state, acc: new_acc)
        } else {
          ok(val: { success: true, params: new_acc }, state: adv.state)
        }
      }
      _ => ok(val: { success: false, params: acc }, state: state)
    }
  } else {
    ok(val: { success: false, params: acc }, state: state)
  }
}

// =========================================================================
// 29. parse_string_interp: StrBegin + exprs + StrMid/StrEnd
// =========================================================================

fn parse_string_interp(state: ParserState) -> PR {
  let span = current_span(state: state)
  let k = peek_kind(state: state)
  match k {
    Some { value: StrBegin { value: prefix } } => {
      let adv = advance(state: state)
      let parts_init = if string_length(s: prefix) > 0 {
        [Text { value: prefix }]
      } else {
        []
      }
      parse_interp_parts(state: adv.state, parts: parts_init, span: span)
    }
    _ => fail(msg: "expected string interpolation", state: state)
  }
}

fn parse_interp_parts(state: ParserState, parts: List<StringPart>, span: SourceSpan) -> PR {
  // Parse the interpolated expression
  let r = parse_expr(state: state)
  if is_err(pr: r) { return r }
  let new_parts = parts +[Interpolation { expr: r.val.expr }]
  let s = r.state

  // Next should be StrMid or StrEnd
  let k = peek_kind(state: s)
  match k {
    Some { value: StrMid { value: mid } } => {
      let adv = advance(state: s)
      let mid_parts = if string_length(s: mid) > 0 {
        new_parts +[Text { value: mid }]
      } else {
        new_parts
      }
      parse_interp_parts(state: adv.state, parts: mid_parts, span: span)
    }
    Some { value: StrEnd { value: suffix } } => {
      let adv = advance(state: s)
      let final_parts = if string_length(s: suffix) > 0 {
        new_parts +[Text { value: suffix }]
      } else {
        new_parts
      }
      ok(val: { expr: StringInterp { parts: final_parts, span: span } }, state: adv.state)
    }
    _ => {
      // Unterminated interpolation — treat as done
      ok(val: { expr: StringInterp { parts: new_parts, span: span } }, state: s)
    }
  }
}

// =========================================================================
// Brace expression: could be block or record literal or map literal
// =========================================================================

fn parse_brace_expr(state: ParserState) -> PR {
  let span = current_span(state: state)
  let adv = advance(state: state)
  let s = skip_newlines(state: adv.state)

  // Empty braces
  if check(state: s, tag: "RBrace") {
    let adv2 = advance(state: s)
    ok(val: { expr: RecordLit { type_name: none, fields: [], span: span } }, state: adv2.state)
  } else {
    // Check if this looks like a block (starts with let, return)
    // or a record literal (ident: expr)
    let k = peek_kind(state: s)
    match k {
      Some { value: KwLet } => {
        // Block expression
        let r = parse_stmts(state: s)
        if is_err(pr: r) { return r }
        let s2 = skip_newlines(state: r.state)
        let r2 = expect(state: s2, tag: "RBrace")
        if is_err(pr: r2) { return r2 }
        if count(r.val.stmts) == 1 {
          ok(val: { expr: first(r.val.stmts).value }, state: r2.state)
        } else {
          ok(val: { expr: Block { stmts: r.val.stmts, span: span } }, state: r2.state)
        }
      }
      Some { value: KwReturn } => {
        let r = parse_stmts(state: s)
        if is_err(pr: r) { return r }
        let s2 = skip_newlines(state: r.state)
        let r2 = expect(state: s2, tag: "RBrace")
        if is_err(pr: r2) { return r2 }
        if count(r.val.stmts) == 1 {
          ok(val: { expr: first(r.val.stmts).value }, state: r2.state)
        } else {
          ok(val: { expr: Block { stmts: r.val.stmts, span: span } }, state: r2.state)
        }
      }
      _ => {
        // Try record literal: { name: expr, ... }
        // If ident followed by colon, it's a record
        if is_ident(state: s) && peek_is_colon_after_ident(state: s) {
          let r = parse_field_init_list(state: s)
          if is_err(pr: r) { return r }
          let s2 = skip_newlines(state: r.state)
          let r2 = expect(state: s2, tag: "RBrace")
          if is_err(pr: r2) { return r2 }
          ok(val: { expr: RecordLit { type_name: none, fields: r.val.fields, span: span } }, state: r2.state)
        } else {
          // General block or map literal
          let r = parse_stmts(state: s)
          if is_err(pr: r) { return r }
          let s2 = skip_newlines(state: r.state)
          let r2 = expect(state: s2, tag: "RBrace")
          if is_err(pr: r2) { return r2 }
          if count(r.val.stmts) == 1 {
            ok(val: { expr: first(r.val.stmts).value }, state: r2.state)
          } else {
            ok(val: { expr: Block { stmts: r.val.stmts, span: span } }, state: r2.state)
          }
        }
      }
    }
  }
}

fn peek_is_colon_after_ident(state: ParserState) -> Bool {
  // Peek two tokens ahead: ident then colon
  if state.pos + 1 < count(state.tokens) {
    let next_tok = first(skip(state.tokens, n: state.pos + 1))
    match next_tok {
      Some { value: t } => kind_tag(kind: t.kind) == "Colon"
      None => false
    }
  } else {
    false
  }
}
