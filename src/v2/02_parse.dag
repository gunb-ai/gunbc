// v2 parser -- recursive descent, first-error-halt.
//
// Consumes a flat List<Token> (from the tokenizer) and produces a
// Module AST. Every production function takes a ParserState and
// returns a record with the result and the advanced state. On error,
// functions return a ParseError record that halts parsing.
//
// Operator precedence (Pratt binding powers):
//   ||          bp 2  (left)
//   &&          bp 4  (left)
//   == != < > <= >=  bp 6  (left)
//   + - +     bp 8  (left, +is list/string concat)
//   * / %       bp 10 (left)
//   ! - (unary) bp 12 (prefix)
//   . () []     bp 14 (postfix, handled separately)

module v2.compiler.parse

import v2.std.core {
  Module, Import, ImportNames, ImportAll, ImportSpecific,
  Node, InferredNode, Resolved, CompilerError,
  NodeType, Typed, InferError, Untyped, rt_node,
  Connective, Conj, Disj,
  Field, Variant, Param, ResourceUse, Cardinality, Required, CardOptional,
  ExprData, NoExprData,
  ExprLiteral, ExprVar, ExprFieldAccess, ExprCall, ExprMethodCall,
  ExprMatch, ExprIf, ExprLet, ExprRecordLit, ExprListLit,
  ExprBinOp, ExprUnaryOp, ExprLambda, ExprStringInterp, ExprBlock,
  ExprCast, ExprForEach, ExprIndex, ExprSlice, ExprReturn,
  make_expr_node, make_expr_error_node,
  NamedArg, MatchArm, FieldInit, MatchPattern, FieldBinding,
  Bind, LitPattern, VariantPattern, Wildcard,
  LiteralValue, LitStr, LitInt, LitFloat, LitBool, LitNull,
  ExprErrorKind, ParseRecoveryError,
  BinOpKind, Add, Sub, Mul, Div, Mod,
  BinEq, BinNe, BinLt, BinGt, BinLe, BinGe, BinAnd, BinOr, NullCoalesce,
  UnaryOpKind, Not, Neg,
  StringPart, Text, Interpolation,
  local_transport_node, rest_transport_node, shell_transport_node, file_transport_node,
  ServiceConfig, OperationDef,
  OperationModifier, Idempotent, Readonly, Hermetic,
  CapabilityDef,
  Token, TokenKind,
  KwModule, KwImport, KwType, KwFn, KwFunc, KwService, KwResource,
  KwData, KwExtern, KwInterface, KwPipeline, KwProfile, KwPattern,
  KwLet, KwReturn, KwMatch, KwIf, KwElse, KwFor, KwIn, KwWhere, KwWith,
  KwTrue, KwFalse, KwNone,
  KwAcquire, KwRelease, KwCapability, KwOperation, KwInput, KwOutput,
  KwIdempotent, KwReadonly, KwHermetic,
  LBrace, RBrace, LParen, RParen, LBracket, RBracket,
  Lt, Gt, Le, Ge, FatArrow, Arrow,
  Colon, Comma, Dot, DotDot, Eq, EqEq, Ne,
  Plus, Minus, Star, Slash, Percent, Bang, And, Or,
  Question, NullCoalesce, Pipe, PipeArrow,
  Ident, StrBegin, StrMid, StrEnd,
