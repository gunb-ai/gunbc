  | ExpectKwLet
  | ExpectKwReturn
  | ExpectKwMatch
  | ExpectKwIf
  | ExpectKwElse
  | ExpectKwFor
  | ExpectKwIn
  | ExpectKwCapability
  | ExpectKwOperation
  | ExpectLBrace
  | ExpectRBrace
