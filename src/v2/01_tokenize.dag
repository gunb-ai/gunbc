// v2 tokenizer — pure function from source string to token list.
//
// No I/O — file reading is handled by the pipeline.
// Emits all token kinds declared in core.dag, including Newline tokens
// (significant for the parser's statement separation).
//
// String interpolation: "hello {name}" emits StrBegin("hello "), then
// expression tokens for `name`, then StrEnd(""). Nested braces inside
// interpolation expressions are tracked via interp_depth stack.
//
// Escape sequences: \" \\ \n \t are processed in string literals.

module v2.compiler.tokenize

import std.types { SourceSpan }
import v2.std.core {
  Token, TokenKind,
  KwModule, KwImport, KwType, KwFn, KwFunc, KwService, KwResource,
  KwData, KwExtern, KwInterface, KwPipeline, KwProfile, KwPattern,
  KwLet, KwReturn, KwMatch, KwIf, KwElse, KwFor, KwIn, KwWhere, KwWith,
  KwTrue, KwFalse, KwNone,
  KwAcquire, KwRelease, KwCapability, KwOperation, KwInput, KwOutput,
  KwIdempotent, KwReadonly, KwHermetic,
  LBrace, RBrace, LParen, RParen, LBracket, RBracket,
  Lt, Gt, Le, Ge, FatArrow, Arrow,
  Colon, Comma, Dot, DotDot, Eq, EqEq, Ne,
  Plus, Minus, Star, Slash, Percent, Bang, And, Or,
  Question, NullCoalesce, Pipe, PipeArrow,
  LitStr, LitInt, LitFloat, Ident,
  StrBegin, StrMid, StrEnd,
  Newline, Eof, Unknown
}

// === Keyword table ===
//
// Data declaration, not match arms. Adding a keyword = one entry here.

data keywords: Map<String, TokenKind> = {
  "module": KwModule, "import": KwImport, "type": KwType,
  "fn": KwFn, "func": KwFunc, "service": KwService,
  "resource": KwResource, "data": KwData, "extern": KwExtern,
  "interface": KwInterface, "pipeline": KwPipeline,
  "profile": KwProfile, "pattern": KwPattern,
  "let": KwLet, "return": KwReturn, "match": KwMatch,
  "if": KwIf, "else": KwElse, "for": KwFor, "in": KwIn,
  "where": KwWhere, "with": KwWith,
  "true": KwTrue, "false": KwFalse, "none": KwNone, "null": KwNone,
  "acquire": KwAcquire, "release": KwRelease,
  "capability": KwCapability, "operation": KwOperation,
  "input": KwInput, "output": KwOutput,
  "idempotent": KwIdempotent, "readonly": KwReadonly,
  "hermetic": KwHermetic
}

// === Single-char punctuation table ===
//
// Note: { and } are NOT in this table — they require special handling
// for string interpolation brace depth tracking.

data single_punct: Map<String, TokenKind> = {
  "(": LParen, ")": RParen,
  "[": LBracket, "]": RBracket,
  ":": Colon, ",": Comma, ".": Dot,
  "+": Plus, "*": Star, "%": Percent, "/": Slash
}

// === Tokenizer state ===
//
// interp_depth is a stack of brace-nesting counters. Each entry
// corresponds to one level of string interpolation. When we enter
// "hello {..." the stack gets a 0 pushed. Nested { increments the
// top, } decrements. When top reaches 0 and we see }, the
// interpolation expression ends and we resume string scanning.

type TokenizerState {
  pos: Int
  tokens: List<Token>
  interp_depth: List<Int>
}

// === Entry point ===

fn tokenize(source: String) -> List<Token> {
  let initial = TokenizerState { pos: 0, tokens: [], interp_depth: [] }
  let final_state = tokenize_loop(source: source, state: initial)
  let eof_span = SourceSpan { start: final_state.pos, end: final_state.pos }
  list_push(final_state.tokens, Token { kind: Eof, span: eof_span })
}

// === Main loop ===

fn tokenize_loop(source: String, state: TokenizerState) -> TokenizerState {
  let s = skip_spaces_and_comments(source: source, state: state)
  if s.pos >= string_length(s: source) {
    return s
  }
  let ch = char_at(s: source, pos: s.pos)

  // Newlines are significant (statement separation)
  if ch == "\n" {
    let tok = Token { kind: Newline, span: SourceSpan { start: s.pos, end: s.pos + 1 } }
    return tokenize_loop(source: source, state: TokenizerState {
      pos: s.pos + 1, tokens: list_push(s.tokens, tok), interp_depth: s.interp_depth
    })
  }

  // When inside string interpolation and we hit }, check if this
  // closes the interpolation expression (top of depth stack == 0).
  if ch == "}" && count(s.interp_depth) > 0 {
    let top = last(s.interp_depth).value
    if top == 0 {
      // Pop the interpolation depth entry, advance past }, resume string scanning
      let popped = drop_last(stack: s.interp_depth)
      let cont_state = TokenizerState {
        pos: s.pos + 1, tokens: s.tokens, interp_depth: popped
      }
      let next = scan_str_cont(source: source, state: cont_state, span_start: s.pos)
      return tokenize_loop(source: source, state: next)
    } else {
      // Nested brace inside interpolation expression — decrement depth
      let new_depth = replace_last(stack: s.interp_depth, value: top - 1)
      let tok = Token { kind: RBrace, span: SourceSpan { start: s.pos, end: s.pos + 1 } }
      return tokenize_loop(source: source, state: TokenizerState {
        pos: s.pos + 1, tokens: list_push(s.tokens, tok), interp_depth: new_depth
      })
    }
  }

  let next = scan_token(source: source, state: s, ch: ch)
  tokenize_loop(source: source, state: next)
}

// === Token scanning ===

fn scan_token(source: String, state: TokenizerState, ch: String) -> TokenizerState {
  if ch == "\"" { return scan_string(source: source, state: state) }
  if is_digit(ch: ch) { return scan_number(source: source, state: state) }
  if is_ident_start(ch: ch) { return scan_ident(source: source, state: state) }

  // Two-character operators (guard against EOF lookahead)
  let next_ch = if state.pos + 1 < string_length(s: source) {
    char_at(s: source, pos: state.pos + 1)
  } else { "" }

  if ch == "=" && next_ch == ">" { return emit(state: state, kind: FatArrow, len: 2) }
  if ch == "-" && next_ch == ">" { return emit(state: state, kind: Arrow, len: 2) }
  if ch == "=" && next_ch == "=" { return emit(state: state, kind: EqEq, len: 2) }
  if ch == "!" && next_ch == "=" { return emit(state: state, kind: Ne, len: 2) }
  if ch == "<" && next_ch == "=" { return emit(state: state, kind: Le, len: 2) }
  if ch == ">" && next_ch == "=" { return emit(state: state, kind: Ge, len: 2) }
  if ch == "&" && next_ch == "&" { return emit(state: state, kind: And, len: 2) }
  if ch == "|" && next_ch == "|" { return emit(state: state, kind: Or, len: 2) }
  if ch == "|" && next_ch == ">" { return emit(state: state, kind: PipeArrow, len: 2) }
  if ch == "|" { return emit(state: state, kind: Pipe, len: 1) }
  if ch == "?" && next_ch == "?" { return emit(state: state, kind: NullCoalesce, len: 2) }
  if ch == "." && next_ch == "." { return emit(state: state, kind: DotDot, len: 2) }

  // Single-character operators not in the table
  if ch == "=" { return emit(state: state, kind: Eq, len: 1) }
  if ch == "<" { return emit(state: state, kind: Lt, len: 1) }
  if ch == ">" { return emit(state: state, kind: Gt, len: 1) }
  if ch == "-" { return emit(state: state, kind: Minus, len: 1) }
  if ch == "!" { return emit(state: state, kind: Bang, len: 1) }
  if ch == "?" { return emit(state: state, kind: Question, len: 1) }

  // Braces — need special handling for interpolation depth tracking
  if ch == "{" {
    let new_depth = if count(state.interp_depth) > 0 {
      replace_last(stack: state.interp_depth, value: last(state.interp_depth).value + 1)
    } else {
      state.interp_depth
    }
    let tok = Token { kind: LBrace, span: SourceSpan { start: state.pos, end: state.pos + 1 } }
    return TokenizerState {
      pos: state.pos + 1, tokens: list_push(state.tokens, tok), interp_depth: new_depth
    }
  }

  if ch == "}" {
    // Not inside interpolation (that case handled in tokenize_loop).
    // This is a normal RBrace.
    let tok = Token { kind: RBrace, span: SourceSpan { start: state.pos, end: state.pos + 1 } }
    return TokenizerState {
      pos: state.pos + 1, tokens: list_push(state.tokens, tok), interp_depth: state.interp_depth
    }
  }

  // Single-char punctuation from table
  match lookup(single_punct, key: ch) {
    Some { value: kind } => emit(state: state, kind: kind, len: 1)
    None => emit(state: state, kind: Unknown { char: ch }, len: 1)
  }
}

// === Helpers ===

fn emit(state: TokenizerState, kind: TokenKind, len: Int) -> TokenizerState {
  let token = Token {
    kind: kind,
    span: SourceSpan { start: state.pos, end: state.pos + len }
  }
  TokenizerState {
    pos: state.pos + len,
    tokens: list_push(state.tokens, token),
    interp_depth: state.interp_depth
  }
}

fn scan_ident(source: String, state: TokenizerState) -> TokenizerState {
  let end = scan_while(s: source, start: state.pos, pred: is_ident_char)
  let text = substring(s: source, start: state.pos, end: end)
  let kind = match lookup(keywords, key: text) {
    Some { value: kw } => kw
    None => Ident { name: text }
  }
  let token = Token { kind: kind, span: SourceSpan { start: state.pos, end: end } }
  TokenizerState { pos: end, tokens: list_push(state.tokens, token), interp_depth: state.interp_depth }
}

fn scan_number(source: String, state: TokenizerState) -> TokenizerState {
  let int_end = scan_while(s: source, start: state.pos, pred: is_digit)
  // Check for decimal point → float (guard against EOF)
  if int_end + 1 < string_length(s: source) && char_at(s: source, pos: int_end) == "." && is_digit(ch: char_at(s: source, pos: int_end + 1)) {
    let frac_end = scan_while(s: source, start: int_end + 1, pred: is_digit)
    let text = substring(s: source, start: state.pos, end: frac_end)
    let token = Token {
      kind: LitFloat { value: text },
      span: SourceSpan { start: state.pos, end: frac_end }
    }
    return TokenizerState { pos: frac_end, tokens: list_push(state.tokens, token), interp_depth: state.interp_depth }
  }
  let text = substring(s: source, start: state.pos, end: int_end)
  let parsed = parse_int(s: text)
  let kind = match parsed {
    Some { value: v } => LitInt { value: v }
    None => Unknown { char: text }
  }
  let token = Token {
    kind: kind,
    span: SourceSpan { start: state.pos, end: int_end }
  }
  TokenizerState { pos: int_end, tokens: list_push(state.tokens, token), interp_depth: state.interp_depth }
}

// === String scanning ===
//
// Strings are scanned character-by-character to handle:
// - Escape sequences: \" \\ \n \t
// - Interpolation: "hello {name}" splits into StrBegin/StrEnd tokens
//
// The result type captures what terminated the scan: a closing quote,
// an interpolation opening brace, or end of input.

type StringScanResult
  = ClosedString { content: String, end_pos: Int }
  | InterpolationStart { content: String, end_pos: Int }
  | UnterminatedString { content: String, end_pos: Int }

// scan_string: called when we see opening " in the source.
// Scans the string body looking for closing ", interpolation {, or escapes.
fn scan_string(source: String, state: TokenizerState) -> TokenizerState {
  let span_start = state.pos
  let body_start = state.pos + 1
  let result = scan_string_body(source: source, pos: body_start, acc: [])
  match result {
    ClosedString { content, end_pos } => {
      let processed = process_escapes(raw: content)
      let token = Token {
        kind: LitStr { value: processed },
        span: SourceSpan { start: span_start, end: end_pos + 1 }
      }
      TokenizerState {
        pos: end_pos + 1, tokens: list_push(state.tokens, token),
        interp_depth: state.interp_depth
      }
    }
    InterpolationStart { content, end_pos } => {
      let processed = process_escapes(raw: content)
      let token = Token {
        kind: StrBegin { value: processed },
        span: SourceSpan { start: span_start, end: end_pos + 1 }
      }
      TokenizerState {
        pos: end_pos + 1,
        tokens: list_push(state.tokens, token),
        interp_depth: state.interp_depth |> append(items: 0)
      }
    }
    UnterminatedString { content, end_pos } => {
      let processed = process_escapes(raw: content)
      let token = Token {
        kind: Unknown { char: processed },
        span: SourceSpan { start: span_start, end: end_pos }
      }
      TokenizerState {
        pos: end_pos, tokens: list_push(state.tokens, token),
        interp_depth: state.interp_depth
      }
    }
  }
}

// scan_str_cont: called after } closes an interpolation expression.
// Resumes scanning the string body for more content, interpolation, or
// the closing quote. Emits StrMid (if another { found) or StrEnd (if " found).
fn scan_str_cont(source: String, state: TokenizerState, span_start: Int) -> TokenizerState {
  let result = scan_string_body(source: source, pos: state.pos, acc: [])
  match result {
    ClosedString { content, end_pos } => {
      let processed = process_escapes(raw: content)
      let token = Token {
        kind: StrEnd { value: processed },
        span: SourceSpan { start: span_start, end: end_pos + 1 }
      }
      TokenizerState {
        pos: end_pos + 1, tokens: list_push(state.tokens, token),
        interp_depth: state.interp_depth
      }
    }
    InterpolationStart { content, end_pos } => {
      let processed = process_escapes(raw: content)
      let token = Token {
        kind: StrMid { value: processed },
        span: SourceSpan { start: span_start, end: end_pos + 1 }
      }
      TokenizerState {
        pos: end_pos + 1,
        tokens: list_push(state.tokens, token),
        interp_depth: state.interp_depth |> append(items: 0)
      }
    }
    UnterminatedString { content, end_pos } => {
      let processed = process_escapes(raw: content)
      let token = Token {
        kind: Unknown { char: processed },
        span: SourceSpan { start: span_start, end: end_pos }
      }
      TokenizerState {
        pos: end_pos, tokens: list_push(state.tokens, token),
        interp_depth: state.interp_depth
      }
    }
  }
}

// scan_string_body: character-by-character scan of string content.
// Stops at closing " (ClosedString), interpolation { (InterpolationStart),
// or end of input (UnterminatedString).
// Escape sequences are preserved in the raw content and processed later.
// Uses full if/else chains — return inside if-without-else does not
// early-return in the DSL evaluator.
fn scan_string_body(source: String, pos: Int, acc: List<String>) -> StringScanResult {
  if pos >= string_length(s: source) {
    UnterminatedString { content: join(acc, separator: ""), end_pos: pos }
  } else {
    let ch = char_at(s: source, pos: pos)
    if ch == "\"" {
      // Closing quote — end of string
      ClosedString { content: join(acc, separator: ""), end_pos: pos }
    } else if ch == "\\" {
      // Backslash — escape sequence, consume two characters raw
      if pos + 1 < string_length(s: source) {
        let escaped = char_at(s: source, pos: pos + 1)
        scan_string_body(source: source, pos: pos + 2, acc: concat(acc, ["\\", escaped]))
      } else {
        // Trailing backslash at EOF
        UnterminatedString { content: join(concat(acc, ["\\"]), separator: ""), end_pos: pos + 1 }
      }
    } else if ch == "{" {
      // Opening brace — potential interpolation start
      if should_start_interpolation(source: source, pos: pos) {
        InterpolationStart { content: join(acc, separator: ""), end_pos: pos }
      } else {
        // Literal brace, not interpolation
        scan_string_body(source: source, pos: pos + 1, acc: concat(acc, ["{"]))
      }
    } else {
      // Ordinary character
      scan_string_body(source: source, pos: pos + 1, acc: concat(acc, [ch]))
    }
  }
}

// should_start_interpolation: check if { at pos starts an interpolation.
// Interpolation starts when the character after { is an identifier start
// character (a-z, A-Z, _) or one of (, !, -.
fn should_start_interpolation(source: String, pos: Int) -> Bool {
  if pos + 1 >= string_length(s: source) {
    false
  } else {
    let next = char_at(s: source, pos: pos + 1)
    is_ident_start(ch: next) || next == "(" || next == "!" || next == "-"
  }
}

// === Escape sequence processing ===
//
// process_escapes: takes a raw string containing escape sequences like
// \", \\, \n, \t and returns the string with escapes resolved.
// Uses a recursive character-by-character scan.

fn process_escapes(raw: String) -> String {
  process_escapes_loop(source: raw, pos: 0, acc: [])
}

fn process_escapes_loop(source: String, pos: Int, acc: List<String>) -> String {
  if pos >= string_length(s: source) {
    join(acc, separator: "")
  } else {
    let ch = char_at(s: source, pos: pos)
    if ch == "\\" && pos + 1 < string_length(s: source) {
      let next = char_at(s: source, pos: pos + 1)
      let resolved = if next == "\"" { "\"" }
        else if next == "\\" { "\\" }
        else if next == "n" { "\n" }
        else if next == "t" { "\t" }
        else { concat("\\", next) }
      process_escapes_loop(source: source, pos: pos + 2, acc: concat(acc, [resolved]))
    } else {
      process_escapes_loop(source: source, pos: pos + 1, acc: concat(acc, [ch]))
    }
  }
}

// === Stack helpers ===
//
// Immutable stack operations on List<Int>. Used for the interp_depth
// brace-nesting counter stack.

// drop_last: returns a new list with the last element removed (pop).
fn drop_last(stack: List<Int>) -> List<Int> {
  let len = count(stack)
  fold(enumerate(stack), init: [], f: fn(result, pair) {
    if pair.first < len - 1 {
      result |> append(items: pair.second)
    } else {
      result
    }
  })
}

// replace_last: returns a new list with the last element replaced.
// Used for incrementing/decrementing the top of the interp_depth stack.
fn replace_last(stack: List<Int>, value: Int) -> List<Int> {
  let prefix = drop_last(stack: stack)
  prefix |> append(items: value)
}

// Skip spaces and tabs (NOT newlines — those are tokens).
// Also skip line comments (// to end of line).
fn skip_spaces_and_comments(source: String, state: TokenizerState) -> TokenizerState {
  let pos = skip_horizontal_ws(s: source, start: state.pos)
  if pos + 1 < string_length(s: source) && char_at(s: source, pos: pos) == "/" && char_at(s: source, pos: pos + 1) == "/" {
    let eol = scan_to_eol(s: source, start: pos)
    return skip_spaces_and_comments(source: source, state: TokenizerState {
      pos: eol, tokens: state.tokens, interp_depth: state.interp_depth
    })
  }
  TokenizerState { pos: pos, tokens: state.tokens, interp_depth: state.interp_depth }
}

// === Character predicates ===

fn is_digit(ch: String) -> Bool {
  ch >= "0" && ch <= "9"
}

fn is_ident_start(ch: String) -> Bool {
  (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}

fn is_ident_char(ch: String) -> Bool {
  is_ident_start(ch: ch) || is_digit(ch: ch)
}
