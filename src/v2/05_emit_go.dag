// v2 Go renderer -- emits Go source files from a typed module graph.
//
// This module contains all Go-specific rendering logic: struct types,
// interface satisfaction (structural typing), multi-return error handling,
// package-level organization, fmt.Errorf wrapping, goroutine-based
// concurrency, Go-idiomatic naming (PascalCase exports, camelCase locals).
//
// Target-agnostic helpers (scope management, item registry, name
// conversion, indent, service call collection) live in 05_emit.dag.
//
// Invariant 6: "DAG nodes are facts, rendering is separate."
// This file IS the Go rendering. No IR changes needed.
//
// Go-specific semantics modeled here:
//   - No Result type: errors are second return values
//   - Structural typing: interfaces are satisfied implicitly
//   - Package-level organization: one package per module
//   - No exceptions: multi-return (value, error) pattern
//   - Pointer receivers for mutating methods
//   - No sum types: tagged unions use interface + type switch

module v2.compiler.emit_go

import v2.std.core {
  Import, ImportAll, ImportSpecific,
  Node,
  Connective, Conj, Disj,
  Field, Variant, Param, Expr, MatchArm,
  MatchPattern, FieldBinding, LiteralValue, TransportBinding,
  TextFile, Diagnostic, SourceSpan,
  ResourceUse,
  BinOpKind, NullCoalesce,
  UnaryOpKind, StringPart, NamedArg, FieldInit,
  ServiceConfig, AuthConfig, HeaderDef, EnvDef,
  ForEach, Index, Slice,
  FuncSig,
  Literal, Var, FieldAccess, Call,
  MethodCall, Match, If, Let, RecordLit,
  ListLit, BinOp, UnaryOp, Lambda,
  StringInterp, Block, Cast,
  Text, Interpolation,
  expr_has_self_call, expr_has_non_tail_self_call
}

import v2.compiler.reconcile {
  TypedGraph, TypedModule,
  TypeEnv, FuncEnv, TypeBinding, InferScope,
  build_params_scope, extend_scope,
  for_each_element_type_node,
  expr_span,
  ItemInfo,
  is_typed_service_call_receiver, extract_typed_service_name
}

import v2.compiler.emit {
  EmitResult, BlockEmitState, InterpPart,
  go_keyword, go_container, go_primitive_type,
  go_literal, go_bin_op_symbol, go_map_template,
  empty_emit_scope, module_emit_scope,
  scope_after_expr,
  lookup_item,
  unique_strings,
  escape_json_string,
  module_to_filename,
  make_indent, to_string, to_string_helper,
  to_snake, to_screaming_snake, is_upper, to_lower_char, to_upper_char,
  capitalize_first, sanitize_service_name, service_var_name,
  apply_type_template1, apply_type_template2,
  is_null_coalesce, is_type_alias_return_node,
  has_nested_records_node,
  is_service_item,
  typed_named_arg_matches, order_typed_call_args,
  classify_typed_item, classify_type_structure, classify_transport_kind
}
// =========================================================================
// Go language facts -- from std.languages spec (go_language, go_literals)
//
// These data declarations mirror dsl/std/languages.dag exactly.
// =========================================================================

// Go reserved words -- Ref: Go Spec "Keywords"
// Source of truth: std.languages.go_language.reserved_words
data go_reserved: List<String> = [
  "break", "case", "chan", "const", "continue",
  "default", "defer", "else", "fallthrough", "for",
  "func", "go", "goto", "if", "import",
  "interface", "map", "package", "range", "return",
  "select", "struct", "switch", "type", "var",
  // Predeclared identifiers that should not be shadowed
  "bool", "byte", "complex64", "complex128", "error",
  "float32", "float64", "int", "int8", "int16", "int32", "int64",
  "rune", "string", "uint", "uint8", "uint16", "uint32", "uint64",
  "uintptr", "true", "false", "iota", "nil",
  "append", "cap", "close", "complex", "copy", "delete",
  "imag", "len", "make", "new", "panic", "print", "println",
  "real", "recover"
]

// Go type_map, keywords, container_templates, go_keyword, and
// go_container now live in go_lang_facts() and shared functions
// in v2.compiler.emit

// =========================================================================
// SG-9: Tail-recursive block statement emitters for Go.
// =========================================================================

fn emit_go_block_stmts(remaining: List<Expr>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int) -> BlockEmitState {
  match remaining |> first {
    None => BlockEmitState { text: text, scope: scope }
    Some { value: stmt } =>
      let line = emit_go_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth)
      let next_scope = scope_after_expr(texpr: stmt, scope: scope)
      emit_go_block_stmts(remaining: remaining |> skip(1),
        text: list_push(text, line), scope: next_scope,
        registry: registry, depth: depth)
  }
}

fn emit_go_init_block_stmts(remaining: List<Expr>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int) -> BlockEmitState {
  match remaining |> first {
    None => BlockEmitState { text: text, scope: scope }
    Some { value: stmt } =>
      let rest = remaining |> skip(1)
      match rest |> first {
        None => BlockEmitState { text: text, scope: scope }
        Some { value: _ } =>
          let line = emit_go_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth)
          let next_scope = scope_after_expr(texpr: stmt, scope: scope)
          emit_go_init_block_stmts(remaining: rest,
            text: list_push(text, line), scope: next_scope,
            registry: registry, depth: depth)
      }
  }
}

// =========================================================================
// Entry point -- Go target
// =========================================================================

fn emit_go(typed: TypedGraph) -> EmitResult {
  let registry = typed.modules |> fold(init: empty_map(), f: (acc, tm) =>
    map_merge(acc, tm.item_registry)
  )
  let module_files = typed.modules |> map(tm => emit_go_module(typed_module: tm, registry: registry))
  let go_mod = emit_go_mod(module_name: "generated")
  let files = concat([go_mod], module_files)
  EmitResult { files: files, diagnostics: [] }
}

// =========================================================================
// go.mod generation
// =========================================================================

fn emit_go_mod(module_name: String) -> TextFile {
  let content = concat("module ", module_name, "\n\ngo 1.21\n")
  TextFile { path: "go.mod", content: content }
}

// =========================================================================
// Module emission
// =========================================================================

fn emit_go_module(typed_module: TypedModule, registry: Map<String, ItemInfo>) -> TextFile {
  let m = typed_module.module
  let scope = module_emit_scope(typed_module: typed_module)
  let pkg_name = go_package_name(module_name: m.name)
  let pkg_decl = concat("package ", pkg_name)
  let imports_str = emit_go_imports(items: typed_module.items, imports: m.imports)
  let imports_section = if imports_str == "" { "" } else { concat("\n\n", imports_str) }
  let items_str = typed_module.items
    |> map(item => emit_go_typed_item(item: item, registry: registry, scope: scope))
    |> join(separator: "\n\n")
  let filename = module_to_filename(name: m.name)
  let content = concat("// Generated by v2 compiler -- do not edit.\n",
    "// Source module: ", m.name, "\n\n",
    pkg_decl, imports_section, "\n\n",
    items_str, "\n")
  TextFile { path: concat(filename, ".go"), content: content }
}

// Derive the Go package name from a module path.
// "v2.std.core" -> last segment "core" lowercased.
fn go_package_name(module_name: String) -> String {
  let parts = module_name |> split(delimiter: ".")
  match parts |> last {
    Some { value: last_part } => last_part |> chars |> map(c => to_lower_char(ch: c)) |> join(separator: "")
    None => "main"
  }
}

// =========================================================================
// Import emission
//
// Go imports are grouped in a single import block.
// Standard library imports and generated module imports.
// =========================================================================

fn emit_go_imports(items: List<Node>, imports: List<Import>) -> String {
  let has_services = items |> any(item => is_service_item(item: item))
  let has_errors = items |> any(item => item.body != none && item.uses |> count > 0)
  let std_imports = collect_go_std_imports(has_services: has_services, has_errors: has_errors)
  let module_imports = imports |> map(imp =>
    let mod_name = module_to_filename(name: imp.module_path)
    concat("\t\"generated/", mod_name, "\"")
  )
  let all_imports = concat(std_imports, module_imports)
  if all_imports |> count == 0 {
    ""
  } else {
    let imports_str = all_imports |> join(separator: "\n")
    concat("import (\n", imports_str, "\n)")
  }
}

fn collect_go_std_imports(has_services: Bool, has_errors: Bool) -> List<String> {
  let base = ["\t\"fmt\""]
  let net_imports = if has_services {
    ["\t\"net/http\"", "\t\"encoding/json\"", "\t\"bytes\"", "\t\"io\""]
  } else {
    []
  }
  concat(base, net_imports)
}

// =========================================================================
// Item dispatch
// =========================================================================

fn emit_go_typed_item(item: Node, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let kind = classify_typed_item(item: item)
  if kind == "type_def" {
    emit_go_type_def_from_connective(item: item)
  } else if kind == "type_alias" {
    emit_go_type_alias(name: item.name, base: item.return_type.value)
  } else if kind == "function" {
    if item.uses |> count > 0 {
      emit_go_func_def(name: item.name, params: item.params, return_type: item.return_type.value, uses: item.uses, body: item.body.value, registry: registry, scope: scope)
    } else {
      emit_go_fn_def(name: item.name, params: item.params, return_type: item.return_type.value, body: item.body.value, registry: registry, scope: scope)
    }
  } else if kind == "data_def" {
    emit_go_data_def(name: item.name, type_node: item.type_annotation.value, value: item.body.value, registry: registry, scope: scope)
  } else if kind == "service_def" {
    emit_go_service_def(item: item, registry: registry)
  } else if kind == "resource_def" {
    emit_go_resource_def(item: item)
  } else if kind == "extern_func" {
    let params_str = emit_go_params(params: item.params)
    let ret_str = emit_go_return_type(return_type: item.return_type.value)
    concat("func ", go_export_ident(name: item.name), "(", params_str, ")", ret_str, " {\n",
      "\tpanic(\"extern func not implemented\")\n}")
  } else {
    concat("// unhandled node: ", item.name)
  }
}

// =========================================================================
// Type definitions
// =========================================================================

fn emit_go_type_def_from_connective(item: Node) -> String {
  match item.connective.value {
    Conj => emit_go_struct_from_children(name: item.name, children: item.children)
    Disj => emit_go_sum_from_children(name: item.name, children: item.children)
  }
}

// is_type_alias_return_node is shared -- imported from v2.compiler.emit

// Go struct from Conj children
fn emit_go_struct_from_children(name: String, children: List<Node>) -> String {
  if children |> count == 0 {
    concat("type ", name, " struct{}")
  } else {
    let field_lines = children |> map(child => emit_go_struct_field_from_child(child: child))
    let fields_str = field_lines |> join(separator: "\n")
    concat("type ", name, " struct {\n", fields_str, "\n}")
  }
}

fn emit_go_struct_field_from_child(child: Node) -> String {
  let ty = emit_go_node_type(n: child.return_type.value)
  let json_tag = concat(" `json:\"", to_snake(name: child.name), "\"`")
  concat("\t", go_export_ident(name: child.name), " ", ty, json_tag)
}

// Go sum types -- interface + concrete types + type switch
// Go has no native sum types. We model them as:
//   - An interface with a marker method
//   - One struct per variant
//   - Type switch for pattern matching
fn emit_go_sum_from_children(name: String, children: List<Node>) -> String {
  let has_data = children |> any(child => child.children |> count > 0)
  if has_data {
    // Tagged union: interface + struct per variant
    let iface = concat("type ", name, " interface {\n\tis", name, "()\n}")
    let variant_structs = children |> map(child => emit_go_variant_struct(parent_name: name, child: child))
    let structs_str = variant_structs |> join(separator: "\n\n")
    concat(iface, "\n\n", structs_str)
  } else {
    // Simple enum: iota constants
    let type_decl = concat("type ", name, " int")
    let variant_consts = children |> enumerate |> map(pair =>
      let child = pair.second
      if pair.first == 0 {
        concat("\t", name, child.name, " ", name, " = iota")
      } else {
        concat("\t", name, child.name)
      }
    )
    let consts_str = variant_consts |> join(separator: "\n")
    concat(type_decl, "\n\nconst (\n", consts_str, "\n)")
  }
}

fn emit_go_variant_struct(parent_name: String, child: Node) -> String {
  let struct_name = concat(parent_name, child.name)
  let marker_method = concat("func (", struct_name, ") is", parent_name, "() {}")
  if child.children |> count == 0 {
    concat("type ", struct_name, " struct{}\n\n", marker_method)
  } else {
    let field_lines = child.children |> map(f => emit_go_struct_field_from_child(child: f))
    let fields_str = field_lines |> join(separator: "\n")
    concat("type ", struct_name, " struct {\n", fields_str, "\n}\n\n", marker_method)
  }
}

fn emit_go_type_alias(name: String, base: Node) -> String {
  concat("type ", name, " = ", emit_go_node_type(n: base))
}

// =========================================================================
// Node-based type emission
//
// These functions dispatch on Node structure (connective + name + children)
// to render Go type syntax.
// =========================================================================

fn emit_go_node_type(n: Node) -> String {
  let kind = classify_type_structure(n: n)
  if kind == "leaf" {
    emit_go_node_type_leaf(n: n)
  } else if kind == "conj" {
    emit_go_node_type_conj(n: n)
  } else {
    emit_go_node_type_disj(n: n)
  }
}

fn emit_go_node_type_leaf(n: Node) -> String {
  if n.children |> count == 0 {
    go_primitive_type(name: n.name)
  } else if n.name == "Map" && n.children |> count == 2 {
    let k = match n.children |> first {
      Some { value: kn } => emit_go_node_type(n: kn)
      None => "string"
    }
    let v = match skip(n.children, 1) |> first {
      Some { value: vn } => emit_go_node_type(n: vn)
      None => "string"
    }
    apply_type_template2(template: go_map_template(), arg0: k, arg1: v)
  } else if n.children |> count == 1 {
    let inner = match n.children |> first {
      Some { value: child } => emit_go_node_type(n: child)
      None => "struct{}"
    }
    // Go has no NonEmpty distinction -- use same container
    if n.name == "NonEmptyList" {
      go_container(kind: "list", inner: inner)
    } else if n.name == "NonEmptySet" {
      go_container(kind: "set", inner: inner)
    } else {
      go_container(kind: to_snake(name: n.name), inner: inner)
    }
  } else {
    n.name
  }
}

fn emit_go_node_type_conj(n: Node) -> String {
  if n.name == "Refined" {
    match n.children |> first {
      Some { value: base } => emit_go_node_type(n: base)
      None => n.name
    }
  } else if n.name != "" {
    n.name
  } else {
    "interface{}"
  }
}

fn emit_go_node_type_disj(n: Node) -> String {
  if n.name == "Optional" {
    match n.children |> first {
      Some { value: inner } =>
        go_container(kind: "optional", inner: emit_go_node_type(n: inner))
      None => "*struct{}"
    }
  } else if n.name != "" {
    n.name
  } else {
    "interface{}"
  }
}

// =========================================================================
// Pure function (fn) emission
//
// Go functions: func Name(params) returnType { body }
// Go naming: exported functions are PascalCase.
// =========================================================================

fn emit_go_fn_def(name: String, params: List<Param>, return_type: Node, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let params_str = emit_go_params(params: params)
  let ret_str = emit_go_return_type(return_type: return_type)
  let body_scope = build_params_scope(scope: scope, params: params)
  // Tail-call optimization: use cached analysis from item registry.
  let use_tco = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.is_self_recursive && info.has_non_tail_self_call == false
    None => {
      expr_has_self_call(expr: body, fn_name: name)
        && expr_has_non_tail_self_call(expr: body, fn_name: name, in_tail: true) == false
    }
  }
  if use_tco {
    let body_str = emit_go_typed_tco_body(texpr: body, fn_name: name, params: params, registry: registry, scope: body_scope, depth: 1)
    concat("func ", go_export_ident(name: name), "(", params_str, ")", ret_str, " {\n",
      body_str, "\n}")
  } else {
    let body_str = emit_go_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: 0)
    concat("func ", go_export_ident(name: name), "(", params_str, ")", ret_str, " {\n",
      make_indent(level: 1), "return ", body_str, "\n}")
  }
}

// =========================================================================
// Workflow function (func) emission
//
// Go has no async/await. Func bodies that do I/O return (value, error).
// Multi-return: func Name(params) (ReturnType, error) { ... }
// =========================================================================

fn emit_go_func_def(
  name: String,
  params: List<Param>,
  return_type: Node,
  uses: List<ResourceUse>,
  body: Expr,
  registry: Map<String, ItemInfo>,
  scope: InferScope
) -> String {
  let service_names = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.service_names
    None => []
  }
  let params_str = emit_go_func_params(params: params, uses: uses, service_names: service_names)
  let ret_type = emit_go_node_type(n: return_type)
  let body_scope = build_params_scope(scope: scope, params: params)
  let body_str = emit_go_typed_func_body(body: body, registry: registry, scope: body_scope, depth: 1)
  concat("func ", go_export_ident(name: name), "(", params_str, ") (", ret_type, ", error) {\n",
    body_str, "\n}")
}

fn emit_go_func_params(params: List<Param>, uses: List<ResourceUse>, service_names: List<String>) -> String {
  let param_strs = params |> map(p => emit_go_param(param: p))
  let resource_strs = uses |> map(u =>
    concat(go_local_ident(name: u.name), " ", emit_go_node_type(n: u.resource))
  )
  let service_strs = service_names |> map(sn =>
    concat(service_var_name(service_name: sn), " *", sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

// =========================================================================
// Parameter emission
// Go: name type (not name: type)
// =========================================================================

fn emit_go_params(params: List<Param>) -> String {
  let strs = params |> map(p => emit_go_param(param: p))
  strs |> join(separator: ", ")
}

fn emit_go_param(param: Param) -> String {
  let ty = emit_go_node_type(n: param.type_expr)
  concat(go_local_ident(name: param.name), " ", ty)
}

fn emit_go_return_type(return_type: Node) -> String {
  let ty = emit_go_node_type(n: return_type)
  if ty == "struct{}" {
    ""
  } else {
    concat(" ", ty)
  }
}
fn emit_go_pattern(pattern: MatchPattern) -> String {
  match pattern {
    Bind { name: n } => go_local_ident(name: n)
    LitPattern { value: v } => go_literal(value: v)
    VariantPattern { name: n, field_bindings: fbs } =>
      emit_go_variant_pattern(name: n, field_bindings: fbs)
    Wildcard => "_"
  }
}

fn emit_go_variant_pattern(name: String, field_bindings: List<FieldBinding>) -> String {
  // Go type switch: case TypeName:
  name
}
fn emit_go_typed_expr(texpr: Expr, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  match texpr {
    Literal { value: v, resolved_type: _, span: _ } => concat(prefix, go_literal(value: v))
    Var { name: n, resolved_type: _, span: _ } => concat(prefix, go_local_ident(name: n))
    FieldAccess { base: b, field: f, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_expr(texpr: b, registry: registry, scope: scope, depth: 0), ".", go_export_ident(name: f))
    Call { func: f, args: a, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_call(func: f, args: a, registry: registry, scope: scope))
    MethodCall { receiver: r, method: m, args: a, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_method_call(receiver: r, method: m, args: a, registry: registry, scope: scope))
    Match { scrutinee: s, arms: arm_list, resolved_type: _, span: _ } =>
      emit_go_typed_match(scrutinee: s, arms: arm_list, registry: registry, scope: scope, depth: depth)
    If { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: _ } =>
      emit_go_typed_if(condition: c, then_branch: t, else_branch: e, registry: registry, scope: scope, depth: depth)
    Let { name: n, value: v, body: bd, resolved_type: _, span: _ } =>
      emit_go_typed_let(name: n, value: v, body: bd, registry: registry, scope: scope, depth: depth)
    RecordLit { type_name: tn, fields: fs, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_record_lit(type_name: tn, fields: fs, registry: registry, scope: scope))
    ListLit { elements: els, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_list_lit(elements: els, registry: registry, scope: scope))
    BinOp { op: o, left: l, right: r, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_bin_op(op: o, left: l, right: r, registry: registry, scope: scope))
    UnaryOp { op: o, operand: e, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_unary_op(op: o, operand: e, registry: registry, scope: scope))
    Lambda { params: ps, body: bd, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_lambda(params: ps, body: bd, registry: registry, scope: scope))
    StringInterp { parts: ps, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_string_interp(parts: ps, registry: registry, scope: scope))
    Block { stmts: ss, resolved_type: _, span: _ } =>
      emit_go_typed_block(stmts: ss, registry: registry, scope: scope, depth: depth)
    Cast { expr: e, target: t, resolved_type: _, span: _ } =>
      emit_go_typed_cast(expr: e, target: t, registry: registry, scope: scope)
    ForEach { variable: v, collection: c, body: bd, resolved_type: _, span: _ } =>
      emit_go_typed_for_each(variable: v, collection: c, body: bd, registry: registry, scope: scope, depth: depth)
    Index { base: b, index: i, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_index(base: b, index: i, registry: registry, scope: scope))
    Slice { base: b, start: s, end: e, resolved_type: _, span: _ } =>
      concat(prefix, emit_go_typed_slice(base: b, start: s, end: e, registry: registry, scope: scope))
  }
}

fn emit_go_typed_call(func: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ordered_args = order_typed_call_args(args: args, func: func, scope: scope)
  let arg_strs = ordered_args |> map(a => emit_go_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: 0))
  let callee = lookup_item(registry: registry, name: func)
  let extra_args = match callee {
    Some { value: info } =>
      if info.kind == "func" {
        info.service_names |> map(sn => service_var_name(service_name: sn))
      } else { [] }
    None => []
  }
  let all_args = concat(arg_strs, extra_args)
  let args_str = all_args |> join(separator: ", ")
  concat(go_export_ident(name: func), "(", args_str, ")")
}

fn emit_go_typed_for_each(variable: String, collection: Expr, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let coll_str = emit_go_typed_expr(texpr: collection, registry: registry, scope: scope, depth: 0)
  let elem_type = for_each_element_type_node(n: collection.resolved_type.value)
  let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type)
  let body_str = emit_go_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: depth + 1)
  concat(make_indent(level: depth), "for _, ", go_local_ident(name: variable), " := range ", coll_str, " {\n",
    body_str, "\n", make_indent(level: depth), "}")
}

fn emit_go_typed_index(base: Expr, index: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let base_str = emit_go_typed_expr(texpr: base, registry: registry, scope: scope, depth: 0)
  let index_str = emit_go_typed_expr(texpr: index, registry: registry, scope: scope, depth: 0)
  concat(base_str, "[", index_str, "]")
}

fn emit_go_typed_slice(base: Expr, start: Expr, end: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let base_str = emit_go_typed_expr(texpr: base, registry: registry, scope: scope, depth: 0)
  let start_str = emit_go_typed_expr(texpr: start, registry: registry, scope: scope, depth: 0)
  let end_str = emit_go_typed_expr(texpr: end, registry: registry, scope: scope, depth: 0)
  concat(base_str, "[", start_str, ":", end_str, "]")
}

fn emit_go_typed_method_call(receiver: Expr, method: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  // Service call: git.Core.CurrentBranch() -> gitCore.CurrentBranch()
  if is_typed_service_call_receiver(receiver: receiver) {
    match extract_typed_service_name(receiver: receiver) {
      Some { value: svc_name } => {
        let var_name = service_var_name(service_name: svc_name)
        let arg_strs = args |> map(a => emit_go_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: 0))
        let args_str = arg_strs |> join(separator: ", ")
        concat(var_name, ".", go_export_ident(name: method), "(", args_str, ")")
      }
      None =>
        "panic(\"unsupported service receiver\")"
    }
  } else {
    let recv_str = emit_go_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: 0)
    let first_arg_str = emit_go_typed_first_arg(args: args, registry: registry, scope: scope)
    // Map known DSL pipe methods to Go equivalents
    if method == "count" {
      concat("len(", recv_str, ")")
    } else if method == "join" {
      concat("strings.Join(", recv_str, ", ", first_arg_str, ")")
    } else if method == "split" {
      concat("strings.Split(", recv_str, ", ", first_arg_str, ")")
    } else if method == "last" {
      concat(recv_str, "[len(", recv_str, ")-1]")
    } else if method == "first" {
      concat(recv_str, "[0]")
    } else if method == "enumerate" {
      // Go range already gives index; emit as-is
      recv_str
    } else if method == "chars" {
      concat("strings.Split(", recv_str, ", \"\")")
    } else {
      // Generic method call
      let arg_strs = args |> map(a => emit_go_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: 0))
      let args_str = arg_strs |> join(separator: ", ")
      concat(recv_str, ".", go_export_ident(name: method), "(", args_str, ")")
    }
  }
}

fn emit_go_typed_first_arg(args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match args |> first {
    Some { value: a } => emit_go_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: 0)
    None => "panic(\"missing method argument\")"
  }
}

fn emit_go_typed_match(scrutinee: Expr, arms: List<MatchArm>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let scrut_str = emit_go_typed_expr(texpr: scrutinee, registry: registry, scope: scope, depth: 0)
  let arm_strs = arms |> map(arm => emit_go_typed_switch_case(arm: arm, registry: registry, scope: scope, depth: depth))
  let arms_str = arm_strs |> join(separator: "\n")
  concat(make_indent(level: depth), "switch ", scrut_str, " {\n", arms_str, "\n", make_indent(level: depth), "}")
}

fn emit_go_typed_switch_case(arm: MatchArm, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let pat_str = emit_go_pattern(pattern: arm.pattern)
  let body_str = emit_go_typed_expr(texpr: arm.body, registry: registry, scope: scope, depth: depth + 1)
  let case_keyword = if pat_str == "_" { "default" } else { concat("case ", pat_str) }
  concat(make_indent(level: depth), case_keyword, ":\n",
    body_str)
}

fn emit_go_typed_if(condition: Expr, then_branch: Expr, else_branch: Expr?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  let cond_str = emit_go_typed_expr(texpr: condition, registry: registry, scope: scope, depth: 0)
  match else_branch {
    Some { value: eb } => {
      let then_str = emit_go_typed_expr(texpr: then_branch, registry: registry, scope: scope, depth: 0)
      let else_str = emit_go_typed_expr(texpr: eb, registry: registry, scope: scope, depth: 0)
      concat(prefix, "func() interface{} { if ", cond_str, " {\n",
        make_indent(level: depth + 1), "return ", then_str, "\n", prefix, "} else {\n",
        make_indent(level: depth + 1), "return ", else_str, "\n", prefix, "} }()")
    }
    None => {
      let then_str = emit_go_typed_expr(texpr: then_branch, registry: registry, scope: scope, depth: depth + 1)
      concat(prefix, "if ", cond_str, " {\n",
        then_str, "\n", prefix, "}")
    }
  }
}

fn emit_go_typed_let(name: String, value: Expr, body: Expr?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let val_str = emit_go_typed_expr(texpr: value, registry: registry, scope: scope, depth: 0)
  let let_line = concat(make_indent(level: depth), go_local_ident(name: name), " := ", val_str)
  match body {
    Some { value: bd } =>
      let next_scope = extend_scope(scope: scope, name: name, resolved: value.resolved_type.value)
      concat(let_line, "\n", emit_go_typed_expr(texpr: bd, registry: registry, scope: next_scope, depth: depth))
    None => let_line
  }
}

fn emit_go_typed_record_lit(type_name: String?, fields: List<FieldInit>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match type_name {
    None => {
      // Anonymous record -> map literal
      if fields |> count == 0 {
        "map[string]interface{}{}"
      } else {
        let field_strs = fields |> map(f =>
          concat("\t\"", f.name, "\": ", emit_go_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: 0), ",")
        )
        let fields_str = field_strs |> join(separator: "\n")
        concat("map[string]interface{}{\n", fields_str, "\n}")
      }
    }
    Some { value: tn } =>
      if fields |> count == 0 {
        concat(tn, "{}")
      } else {
        let field_strs = fields |> map(f =>
          concat(go_export_ident(name: f.name), ": ", emit_go_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: 0))
        )
        let fields_str = field_strs |> join(separator: ", ")
        concat(tn, "{", fields_str, "}")
      }
  }
}

fn emit_go_typed_list_lit(elements: List<Expr>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  if elements |> count == 0 {
    "[]interface{}{}"
  } else {
    let el_strs = elements |> map(e => emit_go_typed_expr(texpr: e, registry: registry, scope: scope, depth: 0))
    let els_str = el_strs |> join(separator: ", ")
    concat("[]interface{}{", els_str, "}")
  }
}

fn emit_go_typed_bin_op(op: BinOpKind, left: Expr, right: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let l_str = emit_go_typed_expr(texpr: left, registry: registry, scope: scope, depth: 0)
  let r_str = emit_go_typed_expr(texpr: right, registry: registry, scope: scope, depth: 0)
  if is_null_coalesce(op: op) {
    // x ?? y -> Go has no null-coalesce; use a helper func pattern
    concat("func() interface{} { if ", l_str, " != nil { return ", l_str, " }; return ", r_str, " }()")
  } else {
    let op_str = go_bin_op_symbol(op: op)
    concat("(", l_str, " ", op_str, " ", r_str, ")")
  }
}

fn emit_go_typed_unary_op(op: UnaryOpKind, operand: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let expr_str = emit_go_typed_expr(texpr: operand, registry: registry, scope: scope, depth: 0)
  match op {
    Not => concat(go_keyword(key: "not"), expr_str)
    Neg => concat("-", expr_str)
  }
}

fn emit_go_typed_lambda(params: List<String>, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let param_strs = params |> map(p => concat(go_local_ident(name: p), " interface{}"))
  let params_str = param_strs |> join(separator: ", ")
  let body_str = emit_go_typed_expr(texpr: body, registry: registry, scope: scope, depth: 0)
  concat("func(", params_str, ") interface{} { return ", body_str, " }")
}

fn emit_go_typed_string_interp(parts: List<StringPart>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let fmt_parts = parts |> map(p => go_typed_interp_segment(part: p, registry: registry, scope: scope))
  let fmt_str = fmt_parts |> map(p => p.format_segment) |> join(separator: "")
  let args = fmt_parts
    |> map(p => p.arg_expr)
    |> filter(a => a != "")
  if args |> count == 0 {
    concat("\"", fmt_str, "\"")
  } else {
    let args_str = args |> join(separator: ", ")
    concat("fmt.Sprintf(\"", fmt_str, "\", ", args_str, ")")
  }
}

fn go_typed_interp_segment(part: StringPart, registry: Map<String, ItemInfo>, scope: InferScope) -> InterpPart {
  match part {
    Text { value: v } => InterpPart { format_segment: v, arg_expr: "" }
    Interpolation { expr: e } =>
      InterpPart { format_segment: "%v", arg_expr: emit_go_typed_expr(texpr: e, registry: registry, scope: scope, depth: 0) }
  }
}

fn emit_go_typed_block(stmts: List<Expr>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let state = emit_go_block_stmts(
    remaining: stmts, text: [], scope: scope, registry: registry, depth: depth)
  state.text |> join(separator: "\n")
}

fn emit_go_typed_cast(expr: Expr, target: Node, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let expr_str = emit_go_typed_expr(texpr: expr, registry: registry, scope: scope, depth: 0)
  let ty_str = emit_go_node_type(n: target)
  concat(ty_str, "(", expr_str, ")")
}

// =========================================================================
// Expr func body -- for func (workflow) emission
// =========================================================================

fn emit_go_typed_func_body(body: Expr, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  match body {
    Let { name: n, value: v, body: inner, resolved_type: _, span: _ } => {
      let val_str = emit_go_typed_expr(texpr: v, registry: registry, scope: scope, depth: 0)
      let let_line = concat(prefix, go_local_ident(name: n), " := ", val_str)
      let next_scope = extend_scope(scope: scope, name: n, resolved: v.resolved_type.value)
      match inner {
        Some { value: bd } =>
          concat(let_line, "\n", emit_go_typed_func_body(body: bd, registry: registry, scope: next_scope, depth: depth))
        None => let_line
      }
    }
    Block { stmts: ss, resolved_type: _, span: _ } => {
      if ss |> count == 0 {
        concat(prefix, "return struct{}{}, nil")
      } else {
        let init_state = emit_go_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth)
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Some { value: s } => concat(prefix, "return ", emit_go_typed_expr(texpr: s, registry: registry, scope: init_state.scope, depth: 0), ", nil")
          None => concat(prefix, "return struct{}{}, nil")
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    }
    _ => concat(prefix, "return ", emit_go_typed_expr(texpr: body, registry: registry, scope: scope, depth: 0), ", nil")
  }
}

// =========================================================================
// Expr TCO -- Go rendering
//
// Typed versions of the TCO functions that work directly on Expr,
// reading resolved_type from sub-expressions instead of cache lookups.
// =========================================================================

fn emit_go_typed_tco_body(texpr: Expr, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let inner = emit_go_typed_tco_expr(texpr: texpr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
  concat(make_indent(level: depth), "for {\n", inner, "\n", make_indent(level: depth), "}")
}

fn emit_go_typed_tco_expr(texpr: Expr, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  match texpr {
    Call { func: f, args: a, resolved_type: _, span: _ } =>
      if f == fn_name {
        emit_go_typed_tco_reassign(args: a, params: params, registry: registry, scope: scope, depth: depth)
      } else {
        let call_str = emit_go_typed_call(func: f, args: a, registry: registry, scope: scope)
        concat(prefix, "return ", call_str)
      }
    If { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: _ } =>
      let cond_str = emit_go_typed_expr(texpr: c, registry: registry, scope: scope, depth: 0)
      let then_str = emit_go_typed_tco_expr(texpr: t, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
      match e {
        Some { value: eb } =>
          let else_str = emit_go_typed_tco_expr(texpr: eb, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
          concat(prefix, "if ", cond_str, " {\n",
            then_str, "\n", prefix, "} else {\n",
            else_str, "\n", prefix, "}")
        None =>
          concat(prefix, "if ", cond_str, " {\n",
            then_str, "\n", prefix, "}")
      }
    Match { scrutinee: s, arms: arm_list, resolved_type: _, span: _ } =>
      let scrut_str = emit_go_typed_expr(texpr: s, registry: registry, scope: scope, depth: 0)
      let arm_strs = arm_list |> map(arm =>
        emit_go_typed_tco_switch_case(arm: arm, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth))
      let arms_str = arm_strs |> join(separator: "\n")
      concat(prefix, "switch ", scrut_str, " {\n", arms_str, "\n", prefix, "}")
    Let { name: n, value: v, body: bd, resolved_type: _, span: _ } =>
      let val_str = emit_go_typed_expr(texpr: v, registry: registry, scope: scope, depth: 0)
      let let_line = concat(prefix, go_local_ident(name: n), " := ", val_str)
      let next_scope = extend_scope(scope: scope, name: n, resolved: v.resolved_type.value)
      match bd {
        Some { value: b } =>
          concat(let_line, "\n", emit_go_typed_tco_expr(texpr: b, fn_name: fn_name, params: params, registry: registry, scope: next_scope, depth: depth))
        None => let_line
      }
    Block { stmts: ss, resolved_type: _, span: _ } =>
      if ss |> count == 0 {
        concat(prefix, "return")
      } else {
        let init_state = emit_go_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth)
        let last_str = match ss |> last {
          Some { value: last_expr } =>
            emit_go_typed_tco_expr(texpr: last_expr, fn_name: fn_name, params: params, registry: registry, scope: init_state.scope, depth: depth)
          None => concat(prefix, "return")
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    _ =>
      let val_str = emit_go_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: 0)
      concat(prefix, "return ", val_str)
  }
}

fn emit_go_typed_tco_switch_case(arm: MatchArm, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let pat_str = emit_go_pattern(pattern: arm.pattern)
  let body_str = emit_go_typed_tco_expr(texpr: arm.body, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
  concat(make_indent(level: depth), "case ", pat_str, ":\n",
    body_str)
}

fn emit_go_typed_tco_reassign(args: List<NamedArg>, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  let ordered_args = args |> map(a => emit_go_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: 0))
  let param_names = params |> map(p => go_local_ident(name: p.name))
  let temp_lets = ordered_args |> enumerate |> map(pair =>
    concat(prefix, "tco", to_string(value: pair.first), " := ", pair.second))
  let assigns = param_names |> enumerate |> map(pair =>
    concat(prefix, pair.second, " = tco", to_string(value: pair.first)))
  let all_lines = concat(temp_lets, assigns, [concat(prefix, "continue")])
  all_lines |> join(separator: "\n")
}

// =========================================================================
// Service definition emission
//
// Each service becomes:
//   - A client struct with config fields
//   - Methods on the struct for each operation
//   - net/http for REST transport
//   - Multi-return (result, error) for all operations
// =========================================================================

fn emit_go_service_def(
  item: Node,
  registry: Map<String, ItemInfo>
) -> String {
  let safe_name = sanitize_service_name(name: item.name)
  let transport = if item.transport == none { LocalBinding } else { item.transport.value }
  let struct_def = emit_go_service_struct(name: safe_name, transport: transport)
  // After dissolution, operation children are identified by having params
  let op_children = item.children |> filter(c => c.params |> count > 0)
  let methods = op_children |> map(op_node =>
    emit_go_operation_method(service_name: safe_name, transport: transport, op_node: op_node, registry: registry)
  )
  let methods_str = methods |> join(separator: "\n\n")
  concat(struct_def, "\n\n", methods_str)
}

fn emit_go_service_struct(name: String, transport: TransportBinding) -> String {
  let fields = match transport {
    RestBinding { base_url: _, auth: a, headers: _ } => {
      let base = "\tBaseURL string"
      let auth_field = match a {
        Some { value: _ } => "\n\tAuthToken string"
        None => ""
      }
      concat(base, auth_field)
    }
    ShellBinding { argv: _, env: _ } =>
      "\tWorkingDir string"
    FileBinding { base_path: _ } =>
      "\tBasePath string"
    LocalBinding =>
      ""
  }
  if fields == "" {
    concat("type ", name, " struct{}")
  } else {
    concat("type ", name, " struct {\n", fields, "\n}")
  }
}

fn emit_go_operation_method(service_name: String, transport: TransportBinding, op_node: Node, registry: Map<String, ItemInfo>) -> String {
  let input_params = op_node.params |> map(p =>
    concat(go_local_ident(name: p.name), " ", emit_go_node_type(n: p.type_expr))
  )
  let params_str = input_params |> join(separator: ", ")
  let receiver = concat("(c *", service_name, ")")
  // After dissolution, return_type on the child node IS the output type
  let ret_type = emit_go_node_type(n: op_node.return_type.value)
  let effective_transport = match op_node.transport {
    Some { value: op_transport } => op_transport
    None => transport
  }
  let body = emit_go_transport_call(transport: effective_transport, op_name: op_node.name, registry: registry, depth: 1)
  concat("func ", receiver, " ", go_export_ident(name: op_node.name),
    "(", params_str, ") (", ret_type, ", error) {\n",
    body, "\n}")
}

fn emit_go_transport_call(transport: TransportBinding, op_name: String, registry: Map<String, ItemInfo>, depth: Int) -> String {
  match transport {
    RestBinding { base_url: _, auth: a, headers: hs } =>
      emit_go_rest_call(op_name: op_name, auth: a, headers: hs, depth: depth)
    ShellBinding { argv: _, env: envs } =>
      emit_go_shell_call(op_name: op_name, env: envs, depth: depth)
    FileBinding { base_path: _ } =>
      emit_go_file_call(op_name: op_name, depth: depth)
    LocalBinding =>
      emit_go_local_call(op_name: op_name, depth: depth)
  }
}

fn emit_go_rest_call(op_name: String, auth: AuthConfig?, headers: List<HeaderDef>, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  let url_line = concat(prefix, "url := fmt.Sprintf(\"%s/", to_snake(name: op_name), "\", c.BaseURL)")
  let body_line = concat(prefix, "reqBody := bytes.NewBuffer(nil)")
  let req_line = concat(prefix, "req, err := http.NewRequest(\"POST\", url, reqBody)\n",
    "if err != nil {\n\treturn nil, fmt.Errorf(\"creating request: %w\", err)\n}")
  let auth_line = match auth {
    Some { value: ac } =>
      concat(prefix, "req.Header.Set(\"", ac.header, "\", c.AuthToken)")
    None => ""
  }
  let header_lines = headers |> map(h =>
    concat(prefix, "panic(\"header value emission not implemented for '", h.name, "'\")")
  )
  let send_lines = concat(
    prefix, "resp, err := http.DefaultClient.Do(req)\n",
    "if err != nil {\n\treturn nil, fmt.Errorf(\"sending request: %w\", err)\n}\n",
    "defer resp.Body.Close()\n",
    "body, err := io.ReadAll(resp.Body)\n",
    "if err != nil {\n\treturn nil, fmt.Errorf(\"reading response: %w\", err)\n}\n",
    "var result interface{}\n",
    "if err := json.Unmarshal(body, &result); err != nil {\n",
    "\treturn nil, fmt.Errorf(\"decoding response: %w\", err)\n}\n",
    "return result, nil"
  )
  let all_lines = concat([url_line, body_line, req_line],
    if auth_line == "" { [] } else { [auth_line] },
    header_lines, [send_lines])
  all_lines |> join(separator: "\n")
}

fn emit_go_shell_call(op_name: String, env: List<EnvDef>, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  let cmd_line = concat(prefix, "cmd := exec.Command(\"", to_snake(name: op_name), "\")")
  let dir_line = concat(prefix, "cmd.Dir = c.WorkingDir")
  let env_lines = env |> map(e =>
    concat(prefix, "panic(\"env value emission not implemented for '", e.name, "'\")")
  )
  let run_lines = concat(
    prefix, "output, err := cmd.Output()\n",
    "if err != nil {\n\treturn \"\", fmt.Errorf(\"running command: %w\", err)\n}\n",
    "return string(output), nil"
  )
  let all_lines = concat([cmd_line, dir_line], env_lines, [run_lines])
  all_lines |> join(separator: "\n")
}

fn emit_go_file_call(op_name: String, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  concat(
    prefix, "path := fmt.Sprintf(\"%s/", to_snake(name: op_name), "\", c.BasePath)\n",
    "data, err := os.ReadFile(path)\n",
    "if err != nil {\n\treturn \"\", fmt.Errorf(\"reading file: %w\", err)\n}\n",
    "return string(data), nil"
  )
}

fn emit_go_local_call(op_name: String, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  concat(prefix, "// Local binding -- direct function call\n",
    "return ", go_export_ident(name: op_name), "(), nil")
}

// =========================================================================
// Resource definition emission
//
// Resources become Go interfaces (structural typing -- no explicit
// "implements" needed).
// =========================================================================

fn emit_go_resource_def(item: Node) -> String {
  // After dissolution, capability children are identified by having params
  let cap_children = item.children |> filter(c => c.params |> count > 0)
  let methods = cap_children |> map(c => emit_go_capability_method(cap_node: c, depth: 1))
  let methods_str = methods |> join(separator: "\n")
  concat("type ", item.name, " interface {\n",
    methods_str, "\n}")
}

fn emit_go_capability_method(cap_node: Node, depth: Int) -> String {
  let input_params = cap_node.params |> map(p =>
    concat(go_local_ident(name: p.name), " ", emit_go_node_type(n: p.type_expr))
  )
  let params_str = input_params |> join(separator: ", ")
  // After dissolution, return_type on the child node IS the output type
  let ret = emit_go_node_type(n: cap_node.return_type.value)
  concat(make_indent(level: depth), go_export_ident(name: cap_node.name), "(", params_str, ") (", ret, ", error)")
}

// =========================================================================
// Data definition emission
//
// data name: Type = value  ->  Go package-level var
// =========================================================================

fn emit_go_data_def(name: String, type_node: Node, value: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ty_str = emit_go_node_type(n: type_node)
  let val_str = emit_go_typed_expr(texpr: value, registry: registry, scope: scope, depth: 0)
  concat("var ", go_export_ident(name: name), " ", ty_str, " = ", val_str)
}

// =========================================================================
// Identifier conversion -- Go target
//
// Go visibility is controlled by case: uppercase = exported, lowercase = unexported.
// Ref: Go Spec "Exported identifiers"
//
// go_export_ident: for types, exported functions, struct fields -> PascalCase
// go_local_ident: for local variables, params -> camelCase
// =========================================================================

fn go_export_ident(name: String) -> String {
  // PascalCase: capitalize first letter of each word segment.
  // The input might already be PascalCase (from DSL type names) or
  // snake_case (from DSL field names). Handle both.
  let parts = name |> split(delimiter: "_")
  let pascal_parts = parts |> map(p => capitalize_first(s: p))
  let result = pascal_parts |> join(separator: "")
  if go_reserved |> any(r => r == result) {
    concat(result, "_")
  } else {
    result
  }
}

fn go_local_ident(name: String) -> String {
  // camelCase: first word lowercase, rest capitalized.
  let parts = name |> split(delimiter: "_")
  if parts |> count == 0 {
    name
  } else {
    let first_part = match parts |> first {
      Some { value: p } => p |> chars |> map(c => to_lower_char(ch: c)) |> join(separator: "")
      None => ""
    }
    let rest_parts = parts |> enumerate
      |> filter(pair => pair.first > 0)
      |> map(pair => capitalize_first(s: pair.second))
    let result = concat(first_part, rest_parts |> join(separator: ""))
    if go_reserved |> any(r => r == result) {
      concat(result, "_")
    } else {
      result
    }
  }
}

