// =========================================================================
// Go language facts -- from std.languages spec (go_language, go_literals)
//
// These data declarations mirror dsl/std/languages.dag exactly.
// =========================================================================

// Go reserved words imported from extdeps.languages.go.emit

// Go type_map, keywords, container_templates, go_keyword, and
// go_container now live in go_lang_facts() and shared functions
// in v2.compiler.emit

// =========================================================================
// SG-9: Tail-recursive block statement emitters for Go.
// =========================================================================

fn emit_go_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int) -> BlockEmitState {
  emit_block_stmts_shared(remaining: remaining, text: text, scope: scope, depth: depth,
    prepend_indent: true,
    emit_expr: (stmt, sc, d) => emit_go_typed_expr(texpr: stmt, registry: registry, scope: sc, depth: d, fuel: 1024))
}

fn emit_go_init_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int) -> BlockEmitState {
  emit_init_block_stmts_shared(remaining: remaining, text: text, scope: scope, depth: depth,
    prepend_indent: true,
    emit_expr: (stmt, sc, d) => emit_go_typed_expr(texpr: stmt, registry: registry, scope: sc, depth: d, fuel: 1024))
}

// =========================================================================
// Entry point -- Go target
// =========================================================================

fn emit_go(typed: ResolvedGraph) -> EmitResult {
  let registry = typed.item_registry
  let test_projections = extract_test_projections(typed: typed)
  let module_files = typed.modules |> map(tm => emit_go_module(typed_module: tm, registry: registry))
  let test_files = typed.modules
    |> map(tm => emit_go_test_file(
      module_name: tm.module.name,
      projections: test_projections |> filter(p => p.module_name == tm.module.name)))
    |> filter(f => f.path != "")
  let go_mod = emit_go_mod(module_name: "generated")
  let files = concat([go_mod], module_files, test_files)
  EmitResult { files: files, diagnostics: [] }
}

// =========================================================================
// go.mod generation
// =========================================================================

fn emit_go_mod(module_name: String) -> TextFile {
  let manifest_path = match scaffold_for_target(target: Go).manifest_file {
    Some { value: path } => path
    None => "go.mod"
  }
  let content = concat("module ", module_name, "\n\ngo 1.21\n")
  TextFile { path: manifest_path, content: content }
}

fn go_source_extension() -> String {
  scaffold_for_target(target: Go).source_file_extension
}

fn go_test_file_path(module_name: String) -> String {
  let conventions = test_conventions_for_target(target: Go)
  let file_dir = match conventions.file_dir {
    Some { value: dir } => dir
    None => ""
  }
  let filename = module_to_filename(name: module_name)
  concat(file_dir, conventions.file_prefix, filename, conventions.file_suffix, go_source_extension())
}

fn go_test_name(projection: TestProjection) -> String {
  test_function_name(projection: projection, target: Go)
}

fn go_mock_expr_uses_fmt(expr: Node) -> Bool {
  let rendered = emit_simple_expr(expr: expr, target: Go, source_index: none)
  rendered |> split(delimiter: "fmt.Sprintf(") |> count > 1
}

fn go_test_import_block(projections: List<TestProjection>) -> String {
  let needs_fmt = projections |> any(p =>
    p.mock_field_inits |> any(mp => go_mock_expr_uses_fmt(expr: field_init_node_value(n: mp)))
  )
  if needs_fmt {
    "import (\n\t\"fmt\"\n\t\"testing\"\n)\n\n"
  } else {
    "import \"testing\"\n\n"
  }
}

fn go_test_signature_comment(projection: TestProjection) -> String {
  let params_str = projection.params
    |> map(p => concat(param_node_name_at(n: p, source_index: projection.source_index), " ", emit_node_type(n: param_node_type_expr(n: p), target: Go, source_index: projection.source_index)))
    |> join(separator: ", ")
  concat(
    "// Signature: ",
    sanitize_service_name(name: projection.service_name), ".",
    projection.operation_name,
    "(",
    params_str,
    ") ",
    emit_node_type(n: projection.inferred, target: Go, source_index: projection.source_index))
}

fn emit_go_test_file(module_name: String, projections: List<TestProjection>) -> TextFile {
  if projections |> count == 0 {
    TextFile { path: "", content: "" }
  } else {
    let package_name = go_package_name(module_name: module_name)
    let tests_str = projections
      |> map(p => emit_go_operation_test(projection: p, depth: 0))
      |> join(separator: "\n\n")
    let content = concat(
      "// Generated tests -- do not edit.\n",
      "// Source module: ", module_name, "\n\n",
      language_spec(target: Go).items.module_keyword, " ", package_name, "\n\n",
      go_test_import_block(projections: projections),
      tests_str, "\n")
    TextFile { path: go_test_file_path(module_name: module_name), content: content }
  }
}

fn emit_go_operation_test(projection: TestProjection, depth: Int) -> String {
  let test_name = go_test_name(projection: projection)
  let struct_name = sanitize_service_name(name: projection.service_name)
  let indent = make_indent(level: depth + 1)
  let mock_setup = projection.mock_field_inits
    |> map(mp => emit_go_mock_prop_setup(mock_prop: mp, depth: depth + 1))
    |> join(separator: "\n")
  concat(
    language_spec(target: Go).items.func_keyword, " ", test_name, "(t *testing.T) {\n",
    indent, go_test_signature_comment(projection: projection), "\n",
    indent, "_ = ", struct_name, "{}\n",
    indent, mock_setup, "\n",
    indent, "// TODO: add dry-run support to Go service emission for full invocation tests\n",
    "}")
}

fn emit_go_mock_prop_setup(mock_prop: Node, depth: Int) -> String {
  concat(
    emit_ident(name: field_init_node_name_at(n: mock_prop, source_index: none), target: Go),
    " := ",
    emit_simple_expr(expr: field_init_node_value(n: mock_prop), target: Go, source_index: none))
}

// =========================================================================
// Module emission
// =========================================================================

fn emit_go_module(typed_module: TypedModule, registry: Map<String, ItemInfo>) -> TextFile {
  let m = typed_module.module
  let scope = module_emit_scope(typed_module: typed_module)
  let pkg_name = go_package_name(module_name: m.name)
  let pkg_decl = concat(language_spec(target: Go).items.module_keyword, " ", pkg_name)
  let imports_str = emit_go_imports(items: typed_module.items, imports: module_imports(n: m))
  let imports_section = if imports_str == "" { "" } else { concat("\n\n", imports_str) }
  let items_str = typed_module.items
    |> map(item => emit_go_typed_item(item: item, registry: registry, scope: scope))
    |> join(separator: "\n\n")
  let filename = module_to_filename(name: m.name)
  let content = concat("// Generated by v2 compiler -- do not edit.\n",
    "// Source module: ", m.name, "\n\n",
    pkg_decl, imports_section, "\n\n",
    items_str, "\n")
  TextFile { path: concat(filename, go_source_extension()), content: content }
}

// Derive the Go package name from a module path.
// "v2.std.core" -> last segment "core" lowercased.
fn go_package_name(module_name: String) -> String {
  let parts = module_name |> split(delimiter: ".")
  match parts |> last {
    Some { value: last_part } => last_part |> chars |> map(c => to_lower_char(ch: c)) |> join(separator: "")
    None => "main"
  }
}

// =========================================================================
// Import emission
//
// Go imports are grouped in a single import block.
// Standard library imports and generated module imports.
// =========================================================================

fn emit_go_imports(items: List<Node>, imports: List<Node>) -> String {
  let has_services = items |> any(item => is_service_item(item: item))
  let has_types = items |> any(item => is_type_def_item(item: item))
  let has_functions = items |> any(item => is_function_item(item: item))
  let std_imports = collect_go_std_imports(has_services: has_services, has_types: has_types, has_functions: has_functions)
  let pkg_imports = imports |> map(imp =>
    let mod_name = module_to_filename(name: imp.name)
    concat("\t\"generated/", mod_name, "\"")
  )
  let all_imports = concat(std_imports, pkg_imports)
  if all_imports |> count == 0 {
    ""
  } else {
    let imports_str = all_imports |> join(separator: "\n")
    concat("import (\n", imports_str, "\n)")
  }
}

fn collect_go_std_imports(has_services: Bool, has_types: Bool, has_functions: Bool) -> List<String> {
  let fmt_import = if has_types || has_functions || has_services { ["\t\"fmt\""] } else { [] }
  let net_imports = if has_services {
    ["\t\"net/http\"", "\t\"encoding/json\"", "\t\"bytes\"", "\t\"io\""]
  } else {
    []
  }
  concat(fmt_import, net_imports)
}

// =========================================================================
// Item dispatch
// =========================================================================

fn emit_go_typed_item(item: Node, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let env = scope.type_env
  let item_text = authored_name(env: env, node: item)
  // Structural dispatch via shared predicates (CM: no taxonomy enum).
  if is_type_def_item(item: item) {
    emit_go_type_def_from_connective(item: item, env: env)
  } else if is_type_alias_item(item: item, source_index: env.source_index) {
    emit_go_type_alias(name: item_text, base: resolved_type(n: item), source_index: env.source_index)
  } else if is_type_decl_item(item: item, source_index: env.source_index) {
    ""
  } else if is_function_item(item: item) {
    if item.uses |> count > 0 {
      emit_go_func_def(name: item_text, params: item.params, inferred: resolved_type(n: item), uses: item.uses, body: item.body.value, registry: registry, scope: scope)
    } else {
      emit_go_fn_def(name: item_text, params: item.params, inferred: resolved_type(n: item), body: item.body.value, registry: registry, scope: scope)
    }
  } else if is_data_def_item(item: item) {
    emit_go_data_def(name: item_text, type_node: item.type_annotation.value, value: item.body.value, registry: registry, scope: scope, depth: 0)
  } else if is_service_def_item(item: item) {
    emit_go_service_def(item: item, registry: registry, env: env)
  } else if is_resource_def_item(item: item) {
    emit_go_resource_def(item: item, env: env)
  } else {
    concat(language_spec(target: Go).items.func_keyword, " init() { panic(\"EMIT BUG: unhandled item: ", item_text, "\") }")
  }
}

// =========================================================================
// Type definitions
// =========================================================================

fn emit_go_type_def_from_connective(item: Node, env: TypeEnv) -> String {
  let item_text = authored_name(env: env, node: item)
  let is_product = item.connective == Conj
  if is_product {
    emit_go_struct_from_children(name: item_text, children: item.children, env: env)
  } else {
    emit_go_sum_from_children(name: item_text, children: item.children, env: env)
  }
}

// is_type_alias_return_node is shared -- imported from v2.compiler.emit

// Go struct from Conj children
fn emit_go_struct_from_children(name: String, children: List<Node>, env: TypeEnv) -> String {
  if children |> count == 0 {
    concat(language_spec(target: Go).items.type_alias_keyword, " ", name, " ", language_spec(target: Go).items.struct_keyword, "{}")
  } else {
    let field_lines = children |> map(child => emit_go_struct_field_from_child(child: child, env: env))
    let fields_str = field_lines |> join(separator: "\n")
    concat(language_spec(target: Go).items.type_alias_keyword, " ", name, " ", language_spec(target: Go).items.struct_keyword, " {\n", fields_str, "\n}")
  }
}

fn emit_go_struct_field_from_child(child: Node, env: TypeEnv) -> String {
  let child_text = authored_name(env: env, node: child)
  let ty = emit_node_type(n: resolved_type(n: child), target: Go, source_index: env.source_index)
  let json_tag = concat(" `json:\"", to_snake(name: child_text), "\"`")
  concat("\t", go_export_ident(name: child_text), " ", ty, json_tag)
}

// Go sum types -- interface + concrete types + type switch
// Go has no native sum types. We model them as:
//   - An interface with a marker method
//   - One struct per variant
//   - Type switch for pattern matching
fn emit_go_sum_from_children(name: String, children: List<Node>, env: TypeEnv) -> String {
  let has_data = children |> any(child => child.children |> count > 0)
  if has_data {
    // Tagged union: interface + struct per variant
    let iface = concat(language_spec(target: Go).items.type_alias_keyword, " ", name, " interface {\n\tis", name, "()\n}")
    let variant_structs = children |> map(child => emit_go_variant_struct(parent_name: name, child: child, env: env))
    let structs_str = variant_structs |> join(separator: "\n\n")
    concat(iface, "\n\n", structs_str)
  } else {
    // Simple enum: iota constants
    let type_decl = concat(language_spec(target: Go).items.enum_keyword, " ", name, " int")
    let variant_consts = children |> enumerate |> map(pair =>
      let child = pair.second
      let child_text = authored_name(env: env, node: child)
      if pair.first == 0 {
        concat("\t", name, child_text, " ", name, " = iota")
      } else {
        concat("\t", name, child_text)
      }
    )
    let consts_str = variant_consts |> join(separator: "\n")
    concat(type_decl, "\n\nconst (\n", consts_str, "\n)")
  }
}

fn emit_go_variant_struct(parent_name: String, child: Node, env: TypeEnv) -> String {
  let struct_name = concat(parent_name, authored_name(env: env, node: child))
  let marker_method = concat(language_spec(target: Go).items.func_keyword, " (", struct_name, ") is", parent_name, "() {}")
  if child.children |> count == 0 {
    concat(language_spec(target: Go).items.type_alias_keyword, " ", struct_name, " ", language_spec(target: Go).items.struct_keyword, "{}\n\n", marker_method)
  } else {
    let field_lines = child.children |> map(f => emit_go_struct_field_from_child(child: f, env: env))
    let fields_str = field_lines |> join(separator: "\n")
    concat(language_spec(target: Go).items.type_alias_keyword, " ", struct_name, " ", language_spec(target: Go).items.struct_keyword, " {\n", fields_str, "\n}\n\n", marker_method)
  }
}

fn emit_go_type_alias(name: String, base: Node, source_index: NewlineIndex?) -> String {
  concat(language_spec(target: Go).items.type_alias_keyword, " ", name, " = ", emit_node_type(n: base, target: Go, source_index: source_index))
}

// =========================================================================
// Node-based type emission
//
// These functions dispatch on Node structure (connective + name + children)
// to render Go type syntax.
// =========================================================================

// Type rendering now uses shared emit_node_type (05_emit.dag).

// =========================================================================
// Pure function (fn) emission
//
// Go functions: func Name(params) returnType { body }
// Go naming: exported functions are PascalCase.
// =========================================================================

fn emit_go_fn_def(name: String, params: List<Node>, inferred: Node, body: Node, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let si = scope.type_env.source_index
  let params_str = emit_go_params(params: params, source_index: si)
  let ret_str = emit_go_inferred(inferred: inferred, source_index: si)
  let body_scope = build_params_scope(scope: scope, params: params)
  let use_tco = is_tco_eligible(name: name, body: body, registry: registry)
  if use_tco {
    let body_str = emit_go_typed_tco_body(texpr: body, fn_name: name, params: params, registry: registry, scope: body_scope, depth: 1)
    concat(language_spec(target: Go).items.func_keyword, " ", go_export_ident(name: name), "(", params_str, ")", ret_str, " {\n",
      body_str, "\n}")
  } else {
    let body_str = emit_go_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: 1, fuel: 1024)
    concat(language_spec(target: Go).items.func_keyword, " ", go_export_ident(name: name), "(", params_str, ")", ret_str, " {\n",
      make_indent(level: 1), "return ", body_str, "\n}")
  }
}

// =========================================================================
// Workflow function (func) emission
//
// Go has no async/await. Func bodies that do I/O return (value, error).
// Multi-return: func Name(params) (ReturnType, error) { ... }
// =========================================================================

fn emit_go_func_def(
  name: String,
  params: List<Node>,
  inferred: Node,
  uses: List<Node>,
  body: Node,
  registry: Map<String, ItemInfo>,
  scope: InferScope
) -> String {
  let service_names = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.service_names
    None => []
  }
  let params_str = emit_go_func_params(params: params, uses: uses, service_names: service_names, source_index: scope.type_env.source_index)
  let ret_type = emit_node_type(n: inferred, target: Go, source_index: scope.type_env.source_index)
  let body_scope = build_params_scope(scope: scope, params: params)
  let si = scope.type_env.source_index
  let body_scope = fold(uses, init: body_scope, f: (s, u) =>
    extend_scope(scope: s, name: resource_use_name_at(n: u, source_index: si), resolved: resource_use_resource(n: u))
  )
  let body_str = emit_go_typed_func_body(body: body, registry: registry, scope: body_scope, depth: 1)
  concat(language_spec(target: Go).items.func_keyword, " ", go_export_ident(name: name), "(", params_str, ") (", ret_type, ", error) {\n",
    body_str, "\n}")
}

fn emit_go_func_params(params: List<Node>, uses: List<Node>, service_names: List<String>, source_index: NewlineIndex?) -> String {
  let param_strs = params |> map(p => emit_go_param(param: p, source_index: source_index))
  let resource_strs = uses |> map(u =>
    concat(emit_ident(name: resource_use_name_at(n: u, source_index: source_index), target: Go), " ", emit_node_type(n: resource_use_resource(n: u), target: Go, source_index: source_index))
  )
  let service_strs = service_names |> map(sn =>
    concat(service_var_name(service_name: sn), " *", sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

// =========================================================================
// Parameter emission
// Go: name type (not name: type)
// =========================================================================

fn emit_go_params(params: List<Node>, source_index: NewlineIndex?) -> String {
  emit_params_shared(params: params, target: Go, source_index: source_index)
}

fn emit_go_param(param: Node, source_index: NewlineIndex?) -> String {
  emit_param_shared(param: param, target: Go, source_index: source_index)
}

fn emit_go_inferred(inferred: Node, source_index: NewlineIndex?) -> String {
  // Go suppresses void return type annotations (Unit → "struct{}").
  if is_unit_like(n: inferred) { "" }
  else { emit_inferred_shared(inferred: inferred, target: Go, source_index: source_index) }
}
fn emit_go_pattern(pattern: MatchPattern) -> String {
  match pattern {
    Bind { name: n } => emit_ident(name: n, target: Go)
    LitPattern { value: v } => emit_literal(value: v, target: Go)
    VariantPattern { name: n, parent_enum: _, field_bindings: fbs } =>
      emit_go_variant_pattern(name: n, field_bindings: fbs)
    Wildcard => "_"
  }
}

fn emit_go_variant_pattern(name: String, field_bindings: List<Node>) -> String {
  // Go type switch: case TypeName:
  name
}
fn emit_go_field_access(base: Node, field: String, summary: FieldSummary?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let base_str = emit_go_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth, fuel: 1024)
  match summary {
    Some { value: fs } =>
      match fs.access_style {
        TupleFirst => concat(base_str, ".First")
        TupleSecond => concat(base_str, ".Second")
        _ => concat(base_str, ".", go_export_ident(name: field))
      }
    None => concat(base_str, ".", go_export_ident(name: field))
  }
}

fn emit_go_expr_var(expr: Node, source_index: NewlineIndex?) -> String {
  emit_expr_var_shared(expr: expr, target: Go, source_index: source_index)
}

fn emit_go_expr_field_access(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_expr_field_access_shared(expr: expr, target: Go, emit_field: e => emit_go_field_access(base: field_access_base(texpr: e), field: e.name, summary: expr_field_access_summary(texpr: e), registry: registry, scope: scope, depth: depth))
}

fn emit_go_expr_call(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_call(func: expr_call_func_at(texpr: expr, source_index: scope.type_env.source_index), args: expr.children, registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_method_call(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_method_call(receiver: method_receiver(texpr: expr), method: expr_method_name_at(texpr: expr, source_index: scope.type_env.source_index), args: method_arg_nodes(texpr: expr), method_semantics: expr_method_call_semantics(texpr: expr), registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_match(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_match(scrutinee: match_scrutinee(texpr: expr), arms: match_arm_nodes(texpr: expr), registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_if(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_if(condition: if_condition(texpr: expr), then_branch: if_then_branch(texpr: expr), else_branch: if_else_branch(texpr: expr), registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_let(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_let(name: let_binding_name_at(texpr: expr, source_index: scope.type_env.source_index), value: let_value(texpr: expr), body: let_body(texpr: expr), registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_record_lit(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_record_lit(type_name: record_lit_type_name(texpr: expr), fields: expr.children, registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_string_interp(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_string_interp(parts: extract_string_interp_parts(expr: expr), registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_block(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_block(stmts: expr.children, registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_cast(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_cast_shared(expr: cast_expr(texpr: expr), cast_target_node: cast_target(texpr: expr), target: Go, recurse: child => emit_go_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024), source_index: scope.type_env.source_index)
}

fn emit_go_expr_for_each(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_go_typed_for_each(variable: foreach_variable_at(texpr: expr, source_index: scope.type_env.source_index), collection: foreach_collection(texpr: expr), body: foreach_body(texpr: expr), registry: registry, scope: scope, depth: depth)
}

fn emit_go_expr_index(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_index_shared(base: index_base(texpr: expr), index: index_expr(texpr: expr), target: Go, recurse: child => emit_go_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024), source_index: scope.type_env.source_index)
}

fn emit_go_expr_slice(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_slice_shared(base: slice_base(texpr: expr), start: slice_start(texpr: expr), end: slice_end(texpr: expr), target: Go, recurse: child => emit_go_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024), source_index: scope.type_env.source_index)
}

fn emit_go_typed_expr(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, fuel: Int) -> String {
  emit_shared_expr(
    texpr: texpr,
    target: Go,
    source_index: scope.type_env.source_index,
    wrap_result: result => result,
    recurse: child => emit_go_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: fuel - 1),
    emit_var: expr => emit_go_expr_var(expr: expr, source_index: scope.type_env.source_index),
    emit_field_access: expr => emit_go_expr_field_access(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_call: expr => emit_go_expr_call(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_method_call: expr => emit_go_expr_method_call(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_match: expr => emit_go_expr_match(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_if: expr => emit_go_expr_if(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_let: expr => emit_go_expr_let(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_record_lit: expr => emit_go_expr_record_lit(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_string_interp: expr => emit_go_expr_string_interp(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_block: expr => emit_go_expr_block(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_cast: expr => emit_go_expr_cast(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_for_each: expr => emit_go_expr_for_each(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_index: expr => emit_go_expr_index(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_slice: expr => emit_go_expr_slice(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_bin_op: expr => emit_default_bin_op(texpr: expr, target: Go, source_index: scope.type_env.source_index, recurse: child => emit_go_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: fuel - 1), wrap_result: result => result))
}

fn emit_go_typed_call(func: String, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let ordered_args = order_typed_call_args(args: args, func: func, scope: scope)
  let arg_strs = ordered_args |> map(a => emit_go_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, fuel: 1024))
  let callee = lookup_item(registry: registry, name: func)
  let extra_args = match callee {
    Some { value: info } =>
      let is_func = info.kind == FuncItem
      if is_func {
        info.service_names |> map(sn => service_var_name(service_name: sn))
      } else { [] }
    None => []
  }
  let all_args = concat(arg_strs, extra_args)
  let args_str = all_args |> join(separator: ", ")
  concat(go_export_ident(name: func), "(", args_str, ")")
}

fn emit_go_typed_for_each(variable: String, collection: Node, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let coll_str = emit_go_typed_expr(texpr: collection, registry: registry, scope: scope, depth: depth, fuel: 1024)
  let elem_type = for_each_element_type_node(n: resolved_type(n: collection))
  let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type)
  let body_str = emit_go_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: depth + 1, fuel: 1024)
  concat("for _, ", emit_ident(name: variable, target: Go), " := range ", coll_str, " {\n",
    make_indent(level: depth + 1), body_str, "\n", make_indent(level: depth), "}")
}

fn go_bridge_method_name(method_name: String) -> String {
  // Derive PascalCase from the canonical snake_case method name.
  let parts = method_name |> split(delimiter: "_")
  let pascal_parts = parts |> map(p => capitalize_first(s: p))
  pascal_parts |> join(separator: "")
}

fn emit_go_algebra_method_call(method_name: String, receiver: Node, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let recv_str = emit_go_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, fuel: 1024)
  let first_arg_str = emit_go_typed_first_arg(args: args, registry: registry, scope: scope, depth: depth)
  match emit_algebra_method_template(method_name: method_name, recv_str: recv_str, first_arg_str: first_arg_str, target: Go) {
    Some { value: result } => result
    None =>
      let go_name = go_bridge_method_name(method_name: method_name)
      let arg_strs = args |> map(a => emit_go_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, fuel: 1024))
      let all_args = concat([recv_str], arg_strs)
      let args_str = all_args |> join(separator: ", ")
      concat("v2rt.", go_name, "(", args_str, ")")
  }
}

fn emit_go_plain_method_call(receiver: Node, method: String, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let recv_str = emit_go_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, fuel: 1024)
  let arg_strs = args |> map(a => emit_go_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, fuel: 1024))
  let args_str = arg_strs |> join(separator: ", ")
  concat(recv_str, ".", go_export_ident(name: method), "(", args_str, ")")
}

fn emit_go_typed_method_call(receiver: Node, method: String, args: List<Node>, method_semantics: MethodSemantics?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  if method_semantics != none { match method_semantics.value {
    ServiceMethodSemantics { service_name: svc_name } => {
      let var_name = service_var_name(service_name: svc_name)
      let arg_strs = args |> map(a => emit_go_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, fuel: 1024))
      let args_str = arg_strs |> join(separator: ", ")
      concat(var_name, ".", go_export_ident(name: method), "(", args_str, ")")
    }
    AlgebraMethodSemantics { method_def: method_def, fold_accumulator_type: _, size_effect: _, cost_shape: _, algebra_template: _ } =>
      let mn = method_def.name
      emit_go_algebra_method_call(method_name: mn, receiver: receiver, args: args, registry: registry, scope: scope, depth: depth)
    PlainMethodSemantics =>
      emit_go_plain_method_call(receiver: receiver, method: method, args: args, registry: registry, scope: scope, depth: depth)
  } }
  else {
      if is_typed_service_call_receiver(receiver: receiver) {
        match extract_typed_service_name(receiver: receiver) {
          Some { value: svc_name } =>
            let var_name = service_var_name(service_name: svc_name)
            let arg_strs = args |> map(a => emit_go_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, fuel: 1024))
            let args_str = arg_strs |> join(separator: ", ")
            concat(var_name, ".", go_export_ident(name: method), "(", args_str, ")")
          None => emit_error_expr(message: "unsupported service receiver", target: Go)
        }
      } else {
        emit_go_plain_method_call(receiver: receiver, method: method, args: args, registry: registry, scope: scope, depth: depth)
      }
  }
}

fn emit_go_typed_first_arg(args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_first_arg_shared(args: args, target: Go,
    recurse: child => emit_go_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024))
}

fn emit_go_typed_match(scrutinee: Node, arms: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let bs = language_spec(target: Go).block_syntax
  let scrut_str = emit_go_typed_expr(texpr: scrutinee, registry: registry, scope: scope, depth: depth, fuel: 1024)
  let arm_strs = arms |> map(arm => emit_go_typed_switch_case(arm: arm, registry: registry, scope: scope, depth: depth))
  let arms_str = arm_strs |> join(separator: "\n")
  concat(bs.match_keyword, scrut_str, bs.block_open, arms_str, "\n", make_indent(level: depth), bs.block_close)
}

fn emit_go_typed_switch_case(arm: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let spec = language_spec(target: Go)
  let bs = spec.block_syntax
  let es = spec.expression_semantics
  let pat_str = emit_go_pattern(pattern: arm_pattern(n: arm))
  let body_str = emit_go_typed_expr(texpr: arm_body(n: arm), registry: registry, scope: scope, depth: depth + 1, fuel: 1024)
  let case_kw = match es.wildcard_case {
    Some { value: wc } => if pat_str == "_" { wc } else { concat(bs.case_keyword, pat_str) }
    None => concat(bs.case_keyword, pat_str)
  }
  concat(make_indent(level: depth), case_kw, ":\n",
    make_indent(level: depth + 1), body_str)
}

fn emit_go_typed_if(condition: Node, then_branch: Node, else_branch: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let cond_str = emit_go_typed_expr(texpr: condition, registry: registry, scope: scope, depth: depth, fuel: 1024)
  emit_typed_if_shared(cond_str: cond_str, then_branch: then_branch, else_branch: else_branch,
    depth: depth, target: Go,
    recurse: (node, d) => emit_go_typed_expr(texpr: node, registry: registry, scope: scope, depth: d, fuel: 1024))
}

fn emit_go_typed_let(name: String, value: Node, body: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let val_str = emit_go_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, fuel: 1024)
  emit_typed_let_shared(name: name, value_str: val_str, body: body, target: Go,
    recurse: (bd, sc) => emit_go_typed_expr(texpr: bd, registry: registry, scope: sc, depth: depth, fuel: 1024),
    scope: scope, value_node: value)
}

fn emit_go_typed_record_lit(type_name: String?, fields: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  match type_name {
    None => {
      // Anonymous record -> map literal
      if fields |> count == 0 {
        "map[string]interface{}{}"
      } else {
        let field_strs = fields |> map(f =>
          concat("\t\"", field_init_node_name_at(n: f, source_index: scope.type_env.source_index), "\": ", emit_go_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, fuel: 1024), ",")
        )
        let fields_str = field_strs |> join(separator: "\n")
        concat("map[string]interface{}{\n", fields_str, "\n}")
      }
    }
    Some { value: tn } =>
      if fields |> count == 0 {
        concat(tn, "{}")
      } else {
        let field_strs = fields |> map(f =>
          concat(go_export_ident(name: field_init_node_name_at(n: f, source_index: scope.type_env.source_index)), ": ", emit_go_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, fuel: 1024))
        )
        let fields_str = field_strs |> join(separator: ", ")
        concat(tn, "{", fields_str, "}")
      }
  }
}


fn emit_go_typed_string_interp(parts: List<StringPart>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let has_interpolations = parts |> any(p => match p { Interpolation { expr: _ } => true  _ => false })
  let fmt_parts = parts |> map(p => go_typed_interp_segment(part: p, registry: registry, scope: scope, depth: depth, has_interpolations: has_interpolations))
  let fmt_str = fmt_parts |> map(p => p.format_segment) |> join(separator: "")
  let args = fmt_parts
    |> map(p => p.arg_expr)
    |> filter(a => a != "")
  if args |> count == 0 {
    concat("\"", fmt_str, "\"")
  } else {
    let args_str = args |> join(separator: ", ")
    concat("fmt.Sprintf(\"", fmt_str, "\", ", args_str, ")")
  }
}

fn go_typed_interp_segment(part: StringPart, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, has_interpolations: Bool) -> InterpPart {
  match part {
    Text { value: v } =>
      let escaped = if has_interpolations { escape_go_interp_text(s: v) } else { escape_string_literal_body(s: v) }
      InterpPart { format_segment: escaped, arg_expr: "" }
    Interpolation { expr: e } =>
      InterpPart { format_segment: "%v", arg_expr: emit_go_typed_expr(texpr: e, registry: registry, scope: scope, depth: depth, fuel: 1024) }
  }
}

fn emit_go_typed_block(stmts: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_block_join(stmts: stmts, scope: scope, depth: depth,
    emit_block_stmts: (s, sc, d) => emit_go_block_stmts(remaining: s, text: [], scope: sc, registry: registry, depth: d))
}

// =========================================================================
// Func body -- for func (workflow) emission
// =========================================================================

fn emit_go_typed_func_body(body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  let si = scope.type_env.source_index
  match body.expr_data {
    ExprLet => {
      let n = let_binding_name_at(texpr: body, source_index: si)
      let ch = body.children
      let v = let_value(texpr: body)
      let inner = let_body(texpr: body)
      let val_str = emit_go_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, fuel: 1024)
      let let_line = concat(prefix, emit_let_binding(name: n, value: val_str, target: Go))
      let next_scope = extend_scope(scope: scope, name: n, resolved: resolved_type(n: v))
      match inner {
        Some { value: bd } =>
          concat(let_line, "\n", emit_go_typed_func_body(body: bd, registry: registry, scope: next_scope, depth: depth))
        None => let_line
      }
    }
    ExprBlock => {
      let ss = body.children
      if ss |> count == 0 {
        concat(prefix, "return struct{}{}, nil")
      } else {
        let init_state = emit_go_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth)
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Some { value: s } => concat(prefix, "return ", emit_go_typed_expr(texpr: s, registry: registry, scope: init_state.scope, depth: depth, fuel: 1024), ", nil")
          None => concat(prefix, "return struct{}{}, nil")
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    }
    _ => concat(prefix, "return ", emit_go_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth, fuel: 1024), ", nil")
  }
}

// =========================================================================
// TCO -- Go rendering
//
// Typed versions of the TCO functions that work directly on Node,
// reading inferred from sub-expressions instead of cache lookups.
// =========================================================================

fn emit_go_typed_tco_body(texpr: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let inner = emit_go_typed_tco_expr(texpr: texpr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
  shared_tco_body(inner: inner, depth: depth, spec: language_spec(target: Go))
}

fn emit_go_tco_non_self_call(frame: TcoFrame, registry: Map<String, ItemInfo>) -> String {
  shared_tco_non_self_call(
    frame: frame,
    target: Go,
    spec: language_spec(target: Go),
    recurse_call: (f, args, scope, depth) => emit_go_typed_call(func: f, args: args, registry: registry, scope: scope, depth: depth))
}

fn emit_go_tco_if(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>) -> String {
  shared_tco_if(
    frame: frame,
    fn_name: fn_name,
    params: params,
    target: Go,
    spec: language_spec(target: Go),
    recurse_expr: (expr, scope, depth) => emit_go_typed_expr(texpr: expr, registry: registry, scope: scope, depth: depth, fuel: 1024),
    recurse_tco: (expr, scope, depth) => emit_go_typed_tco_expr(texpr: expr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth))
}

fn emit_go_tco_match(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>) -> String {
  match frame.expr.expr_data {
    ExprMatch =>
      let s = match_scrutinee(texpr: frame.expr)
      let arm_list = match_arm_nodes(texpr: frame.expr)
      let scrut_str = emit_go_typed_expr(texpr: s, registry: registry, scope: frame.scope, depth: frame.depth, fuel: 1024)
      let arm_strs = arm_list |> map(arm =>
        emit_go_typed_tco_switch_case(arm: arm, fn_name: fn_name, params: params, registry: registry, scope: frame.scope, depth: frame.depth))
      let arms_str = arm_strs |> join(separator: "\n")
      let bs = language_spec(target: Go).block_syntax
      concat(bs.match_keyword, scrut_str, bs.block_open, arms_str, "\n", bs.block_close)
    _ => emit_error_expr(message: "emit_go_tco_match expected ExprMatch", target: Go)
  }
}

fn emit_go_tco_let(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>) -> String {
  shared_tco_let(
    frame: frame,
    fn_name: fn_name,
    params: params,
    target: Go,
    recurse_expr: (expr, scope, depth) => emit_go_typed_expr(texpr: expr, registry: registry, scope: scope, depth: depth, fuel: 1024),
    recurse_tco: (expr, scope, depth) => emit_go_typed_tco_expr(texpr: expr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth))
}

fn emit_go_tco_block(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>) -> String {
  shared_tco_block(
    frame: frame,
    fn_name: fn_name,
    params: params,
    target: Go,
    spec: language_spec(target: Go),
    emit_init_stmts: (stmts, scope, depth) => emit_go_init_block_stmts(remaining: stmts, text: [], scope: scope, registry: registry, depth: depth),
    recurse_tco: (expr, scope, depth) => emit_go_typed_tco_expr(texpr: expr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth))
}

fn emit_go_tco_default_return(frame: TcoFrame, registry: Map<String, ItemInfo>) -> String {
  shared_tco_default_return(
    frame: frame,
    spec: language_spec(target: Go),
    recurse_expr: (expr, scope, depth) => emit_go_typed_expr(texpr: expr, registry: registry, scope: scope, depth: depth, fuel: 1024))
}

fn emit_go_typed_tco_expr(texpr: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_shared_tco_expr(
    frame: TcoFrame { expr: texpr, scope: scope, depth: depth },
    fn_name: fn_name,
    emit_self_call_reassign: input => emit_go_typed_tco_reassign(args: input.args, params: params, registry: registry, scope: input.scope, depth: input.depth),
    emit_non_self_call: frame => emit_go_tco_non_self_call(frame: frame, registry: registry),
    emit_if: frame => emit_go_tco_if(frame: frame, fn_name: fn_name, params: params, registry: registry),
    emit_match: frame => emit_go_tco_match(frame: frame, fn_name: fn_name, params: params, registry: registry),
    emit_let: frame => emit_go_tco_let(frame: frame, fn_name: fn_name, params: params, registry: registry),
    emit_block: frame => emit_go_tco_block(frame: frame, fn_name: fn_name, params: params, registry: registry),
    emit_default_return: frame => emit_go_tco_default_return(frame: frame, registry: registry))
}

fn emit_go_typed_tco_switch_case(arm: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let spec = language_spec(target: Go)
  let bs = spec.block_syntax
  let es = spec.expression_semantics
  let pat_str = emit_go_pattern(pattern: arm_pattern(n: arm))
  let body_str = emit_go_typed_tco_expr(texpr: arm_body(n: arm), fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
  let case_kw = match es.wildcard_case {
    Some { value: wc } => if pat_str == "_" { wc } else { concat(bs.case_keyword, pat_str) }
    None => concat(bs.case_keyword, pat_str)
  }
  concat(make_indent(level: depth), case_kw, ":\n",
    make_indent(level: depth + 1), body_str)
}

fn emit_go_typed_tco_reassign(args: List<Node>, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_tco_reassign_shared(args: args, params: params, target: Go,
    recurse: child => emit_go_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024),
    source_index: scope.type_env.source_index)
}

// =========================================================================
// Service definition emission
//
// Each service becomes:
//   - A client struct with config fields
//   - Methods on the struct for each operation
//   - net/http for REST transport
//   - Multi-return (result, error) for all operations
// =========================================================================

fn emit_go_service_def(
  item: Node,
  registry: Map<String, ItemInfo>,
  env: TypeEnv
) -> String {
  let safe_name = sanitize_service_name(name: authored_name(env: env, node: item))
  let transport = service_fallback_transport(item: item)
  let op_children = item.children
  let struct_def = emit_go_service_struct(name: safe_name, fallback_transport: transport, op_children: op_children)
  let methods = op_children |> map(op_node =>
    emit_go_operation_method(service_name: safe_name, transport: transport, op_node: op_node, registry: registry, env: env)
  )
  let methods_str = methods |> join(separator: "\n\n")
  concat(struct_def, "\n\n", methods_str)
}

fn emit_go_service_struct(name: String, fallback_transport: Node, op_children: List<Node>) -> String {
  let fs = compute_service_fields(fallback_transport: fallback_transport, op_children: op_children)
  let decls = service_field_decls(fs: fs, t: language_spec(target: Go).service_fields)
  if decls |> count == 0 {
    concat(language_spec(target: Go).items.type_alias_keyword, " ", name, " ", language_spec(target: Go).items.struct_keyword, "{}")
  } else {
    concat(language_spec(target: Go).items.type_alias_keyword, " ", name, " ", language_spec(target: Go).items.struct_keyword, " {\n", decls |> join(separator: "\n"), "\n}")
  }
}

fn emit_go_operation_method(service_name: String, transport: Node, op_node: Node, registry: Map<String, ItemInfo>, env: TypeEnv) -> String {
  let op_text = authored_name(env: env, node: op_node)
  let input_params = op_node.params |> map(p =>
    concat(emit_ident(name: param_node_name_at(n: p, source_index: env.source_index), target: Go), " ", emit_node_type(n: param_node_type_expr(n: p), target: Go, source_index: env.source_index))
  )
  let params_str = input_params |> join(separator: ", ")
  let receiver = concat("(c *", service_name, ")")
  // After dissolution, inferred on the child node IS the output type
  let ret_type = emit_node_type(n: resolved_type(n: op_node), target: Go, source_index: env.source_index)
  let eff_transport = effective_operation_transport(op_node: op_node, fallback: transport)
  let body = emit_go_transport_call(transport: eff_transport, op_name: op_text, registry: registry, depth: 1)
  concat(language_spec(target: Go).items.func_keyword, " ", receiver, " ", go_export_ident(name: op_text),
    "(", params_str, ") (", ret_type, ", error) {\n",
    body, "\n}")
}

fn emit_go_transport_call(transport: Node, op_name: String, registry: Map<String, ItemInfo>, depth: Int) -> String {
  if is_rest_transport(t: transport) { emit_go_rest_call(op_name: op_name, transport: transport, depth: depth) }
  else if is_shell_transport(t: transport) { emit_go_shell_call(op_name: op_name, transport: transport, depth: depth) }
  else if is_file_transport(t: transport) { emit_go_file_call(op_name: op_name, depth: depth) }
  else { emit_go_local_call(op_name: op_name, depth: depth) }
}

fn emit_go_rest_call(op_name: String, transport: Node, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  let url_line = concat(prefix, "url := fmt.Sprintf(\"%s/", to_snake(name: op_name), "\", c.BaseURL)")
  let body_line = concat(prefix, "reqBody := bytes.NewBuffer(nil)")
  let req_line = concat(prefix, "req, err := http.NewRequest(\"POST\", url, reqBody)\n",
    "if err != nil {\n\treturn nil, fmt.Errorf(\"creating request: %w\", err)\n}")
  let auth_line = if transport_has_auth(t: transport) {
    let header_name = match transport_auth_header_name(t: transport) {
      Some { value: h } => h
      None => "Authorization"
    }
    concat(prefix, "req.Header.Set(\"", header_name, "\", c.AuthToken)")
  } else { "" }
  let hdrs = transport_headers(t: transport)
  let header_lines = hdrs |> map(h =>
    concat(prefix, "req.Header.Set(\"", h.name, "\", ", emit_simple_expr(expr: field_init_node_value(n: h), target: Go, source_index: none), ")")
  )
  let send_lines = concat(
    prefix, "resp, err := http.DefaultClient.Do(req)\n",
    "if err != nil {\n\treturn nil, fmt.Errorf(\"sending request: %w\", err)\n}\n",
    "defer resp.Body.Close()\n",
    "body, err := io.ReadAll(resp.Body)\n",
    "if err != nil {\n\treturn nil, fmt.Errorf(\"reading response: %w\", err)\n}\n",
    "var result interface{}\n",
    "if err := json.Unmarshal(body, &result); err != nil {\n",
    "\treturn nil, fmt.Errorf(\"decoding response: %w\", err)\n}\n",
    "return result, nil"
  )
  let all_lines = concat([url_line, body_line, req_line],
    if auth_line == "" { [] } else { [auth_line] },
    header_lines, [send_lines])
  all_lines |> join(separator: "\n")
}

fn emit_go_shell_call(op_name: String, transport: Node, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  let cmd_line = concat(prefix, "cmd := exec.Command(\"", to_snake(name: op_name), "\")")
  let dir_line = concat(prefix, "cmd.Dir = c.WorkingDir")
  let envs = transport_env(t: transport)
  let env_lines = envs |> map(e =>
    concat(prefix, "cmd.Env = append(cmd.Env, \"", e.name, "=\" + ", emit_simple_expr(expr: field_init_node_value(n: e), target: Go, source_index: none), ")")
  )
  let run_lines = concat(
    prefix, "output, err := cmd.Output()\n",
    "if err != nil {\n\treturn \"\", fmt.Errorf(\"running command: %w\", err)\n}\n",
    "return string(output), nil"
  )
  let all_lines = concat([cmd_line, dir_line], env_lines, [run_lines])
  all_lines |> join(separator: "\n")
}

fn emit_go_file_call(op_name: String, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  concat(
    prefix, "path := fmt.Sprintf(\"%s/", to_snake(name: op_name), "\", c.BasePath)\n",
    "data, err := os.ReadFile(path)\n",
    "if err != nil {\n\treturn \"\", fmt.Errorf(\"reading file: %w\", err)\n}\n",
    "return string(data), nil"
  )
}

fn emit_go_local_call(op_name: String, depth: Int) -> String {
  let prefix = make_indent(level: depth)
  concat(prefix, "// Local binding -- direct function call\n",
    "return ", go_export_ident(name: op_name), "(), nil")
}

// =========================================================================
// Resource definition emission
//
// Resources become Go interfaces (structural typing -- no explicit
// "implements" needed).
// =========================================================================

fn emit_go_resource_def(item: Node, env: TypeEnv) -> String {
  let item_text = authored_name(env: env, node: item)
  // After dissolution, capability children are identified by having params
  let cap_children = item.children |> filter(c => c.params |> count > 0)
  let methods = cap_children |> map(c => emit_go_capability_method(cap_node: c, depth: 1, env: env))
  let methods_str = methods |> join(separator: "\n")
  concat(language_spec(target: Go).items.type_alias_keyword, " ", item_text, " interface {\n",
    methods_str, "\n}")
}

fn emit_go_capability_method(cap_node: Node, depth: Int, env: TypeEnv) -> String {
  let input_params = cap_node.params |> map(p =>
    concat(emit_ident(name: param_node_name_at(n: p, source_index: env.source_index), target: Go), " ", emit_node_type(n: param_node_type_expr(n: p), target: Go, source_index: env.source_index))
  )
  let params_str = input_params |> join(separator: ", ")
  // After dissolution, inferred on the child node IS the output type
  let ret = emit_node_type(n: resolved_type(n: cap_node), target: Go, source_index: env.source_index)
  concat(make_indent(level: depth), go_export_ident(name: authored_name(env: env, node: cap_node)), "(", params_str, ") (", ret, ", error)")
}

// =========================================================================
// Data definition emission
//
// data name: Type = value  ->  Go package-level var
// =========================================================================

fn emit_go_data_def(name: String, type_node: Node, value: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let ty_str = emit_node_type(n: type_node, target: Go, source_index: scope.type_env.source_index)
  let val_str = emit_go_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, fuel: 1024)
  concat("var ", go_export_ident(name: name), " ", ty_str, " = ", val_str)
}

// =========================================================================
// Identifier conversion -- Go target
//
// Go visibility is controlled by case: uppercase = exported, lowercase = unexported.
// Ref: Go Spec "Exported identifiers"
//
// go_export_ident: for types, exported functions, struct fields -> PascalCase
// go_local_ident: for local variables, params -> camelCase
// =========================================================================

fn go_export_ident(name: String) -> String {
  // PascalCase: capitalize first letter of each word segment.
  // The input might already be PascalCase (from DSL type names) or
  // snake_case (from DSL field names). Handle both.
  let parts = name |> split(delimiter: "_")
  let pascal_parts = parts |> map(p => capitalize_first(s: p))
  let result = pascal_parts |> join(separator: "")
  if go_reserved |> any(r => r == result) {
    concat(result, go_reserved_escape_suffix)
  } else {
    result
  }
}

// Identifier rendering now uses shared emit_ident (05_emit.dag).

// =========================================================================
// Utility: check if a TypedGraph has service items
// =========================================================================

// is_service_item is now shared -- imported from v2.compiler.emit
