// v2 normalization pass -- structural graph rewrite between resolve and infer.
//
// P3.7: arity bridge deleted. Arity enforcement via hardcoded
// parameterized_type_arity is removed. Arity is now structural:
// type declarations carry params, and generic substitution in
// resolve_node_bounded checks declaration params at resolution time.
//
// The normalizer currently passes the graph through unchanged.
// Future: Call→MethodCall unification (currently in infer).

module v2.compiler.normalize

import v2.std.core {
  Node, ErrorNode,
  InferredNode, Resolved, CompilerError
}
import v2.compiler.resolve { ModuleGraph, ResolvedModule }

// =========================================================================
// Output types
// =========================================================================

type NormalizeResult {
  graph: ModuleGraph
  diagnostics: List<ErrorNode>
}

// =========================================================================
// Normalization entry point
// =========================================================================

fn normalize_graph(graph: ModuleGraph) -> NormalizeResult {
  NormalizeResult {
    graph: graph,
    diagnostics: []
  }
}
