fn emit_single_field_product_py_type(field_node: Node) -> String {
  if field_node.return_type == none {
    "dict"
  } else {
    emit_py_node_type(n: match rt_node(n: field_node) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  }
}

// =========================================================================
// Python language facts -- from std.languages spec (python_language, python_literals)
//
// These data declarations mirror dsl/std/languages.dag exactly.
// =========================================================================

// Python reserved words imported from extdeps.languages.python.emit

// Python type_map, keywords, container_templates, python_keyword, and
// python_container now live in python_lang_facts() and shared functions
// in v2.compiler.emit

// =========================================================================
// SG-9: Tail-recursive block statement emitters for Python.
// =========================================================================

fn emit_py_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int) -> BlockEmitState {
  match remaining |> first {
    None => BlockEmitState { text: text, scope: scope }
    Some { value: stmt } =>
      let line = emit_py_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth)
      let next_scope = scope_after_expr(texpr: stmt, scope: scope)
      emit_py_block_stmts(remaining: remaining |> skip(1),
        text: list_push(text, line), scope: next_scope,
        registry: registry, depth: depth)
  }
}

fn emit_py_init_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int) -> BlockEmitState {
  match remaining |> first {
    None => BlockEmitState { text: text, scope: scope }
    Some { value: stmt } =>
      let rest = remaining |> skip(1)
      match rest |> first {
        None => BlockEmitState { text: text, scope: scope }
        Some { value: _ } =>
          let line = emit_py_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth)
          let next_scope = scope_after_expr(texpr: stmt, scope: scope)
          emit_py_init_block_stmts(remaining: rest,
            text: list_push(text, line), scope: next_scope,
            registry: registry, depth: depth)
      }
  }
}

// =========================================================================
// Entry point -- Python target
// =========================================================================

fn emit_python(typed: ResolvedGraph) -> EmitResult {
  let registry = typed.item_registry
  let module_files = typed.modules |> map(tm => emit_py_module(typed_module: tm, registry: registry))
  let init_file = emit_init_py(modules: typed.modules)
  let requirements = emit_requirements_txt(has_services: has_service_items(typed: typed))
  let files = concat([requirements, init_file], module_files)
  EmitResult { files: files, diagnostics: [] }
}

// =========================================================================
// __init__.py generation
// =========================================================================

fn emit_init_py(modules: List<TypedModule>) -> TextFile {
  let import_lines = modules |> map(tm =>
    let mod_name = module_to_filename(name: tm.module.name)
    concat("from . import ", mod_name)
  )
  let content = concat("# Generated by v2 compiler -- do not edit.\n\n",
    import_lines |> join(separator: "\n"), "\n")
  TextFile { path: "__init__.py", content: content }
}

// =========================================================================
// Module emission
// =========================================================================

fn emit_py_module(typed_module: TypedModule, registry: Map<String, ItemInfo>) -> TextFile {
  let m = typed_module.module
  let scope = module_emit_scope(typed_module: typed_module)
  let prelude = emit_py_prelude(typed_module: typed_module)
  let imports_str = emit_py_imports(imports: m.imports)
  let imports_section = if imports_str == "" { "" } else { concat("\n", imports_str) }
  let items_str = typed_module.items
    |> map(item => emit_py_typed_item(item: item, registry: registry, scope: scope))
    |> join(separator: "\n\n\n")
  let filename = module_to_filename(name: m.name)
  let content = concat("# Generated by v2 compiler -- do not edit.\n",
    "# Source module: ", m.name, "\n\n",
    prelude, imports_section, "\n\n\n",
    items_str, "\n")
  TextFile { path: concat(filename, ".py"), content: content }
}

// =========================================================================
// Import emission
// =========================================================================

fn emit_py_imports(imports: List<Import>) -> String {
  if imports |> count == 0 {
    ""
  } else {
    let import_lines = imports |> map(imp =>
      let mod_name = module_to_filename(name: imp.module_path)
      match imp.names {
        ImportAll => concat("from ", mod_name, " import *")
        ImportSpecific { names: specific_names } =>
          if specific_names |> count == 0 {
            ""
          } else {
            let names_str = specific_names |> join(separator: ", ")
            concat("from ", mod_name, " import ", names_str)
          }
      }
    )
    import_lines |> filter(line => line != "") |> join(separator: "\n")
  }
}

// =========================================================================
// Prelude -- standard imports for Python modules
// =========================================================================

fn emit_py_prelude(typed_module: TypedModule) -> String {
  let base_imports = concat(
    "from __future__ import annotations\n",
    "from dataclasses import dataclass, field\n",
    "from enum import Enum, auto\n",
    "from typing import Optional, Union\n"
  )
  let has_services = typed_module.items |> any(item => is_service_item(item: item))
  let async_imports = if has_services {
    "import aiohttp\n"
  } else {
    ""
  }
  concat(base_imports, async_imports)
}

// =========================================================================
// Item dispatch
// =========================================================================

fn emit_py_typed_item(item: Node, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let kind = classify_typed_item(item: item)
  if (kind == TypedItemTypeDef) {
    emit_py_type_def_from_connective(item: item)
  } else if (kind == TypedItemTypeAlias) {
    concat(item.name, " = ", emit_py_node_type(n: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }))
  } else if (kind == TypedItemFunction) {
    if item.uses |> count > 0 {
      emit_py_func_def(name: item.name, params: item.params, return_type: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, uses: item.uses, body: item.body.value, registry: registry, scope: scope)
    } else {
      emit_py_fn_def(name: item.name, params: item.params, return_type: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") }, body: item.body.value, registry: registry, scope: scope)
    }
  } else if (kind == TypedItemDataDef) {
    emit_py_data_def(name: item.name, type_node: item.type_annotation.value, value: item.body.value, registry: registry, scope: scope)
  } else if (kind == TypedItemServiceDef) {
    emit_py_service_def(item: item, registry: registry)
  } else if (kind == TypedItemResourceDef) {
    emit_py_resource_def(item: item)
  } else if (kind == TypedItemExternFunc) {
    let params_str = emit_py_params(params: item.params)
    let ret_str = emit_py_return_type(return_type: match rt_node(n: item) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
    concat("def ", py_ident(name: item.name), "(", params_str, ")", ret_str, ":\n",
      "    raise NotImplementedError(\"extern func\")")
  } else {
    concat("# unhandled node: ", item.name)
  }
}

// =========================================================================
// Connective-based type emission -- dispatches on Node children
//
// Type structure is encoded as:
//   Records: connective=Conj, children = one Node per field
//   Sums:    connective=Disj, children = one Node per variant
//   Aliases: connective=none, return_type carries the aliased type
// =========================================================================

fn emit_py_type_def_from_connective(item: Node) -> String {
  let kind = classify_type_structure(n: item)
  if (kind == TypeConj) {
    emit_py_dataclass_from_children(name: item.name, children: item.children)
  } else {
    emit_py_enum_from_children(name: item.name, children: item.children)
  }
}

// is_type_alias_return_node is shared -- imported from v2.compiler.emit

fn emit_py_dataclass_from_children(name: String, children: List<Node>) -> String {
  if children |> count == 0 {
    concat("@dataclass\nclass ", name, ":\n    pass")
  } else {
    let field_lines = children |> map(child => emit_py_dataclass_field_from_child(child: child))
    let fields_str = field_lines |> join(separator: "\n")
    concat("@dataclass\nclass ", name, ":\n", fields_str)
  }
}

fn emit_py_dataclass_field_from_child(child: Node) -> String {
  let ty = emit_py_node_type(n: match rt_node(n: child) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  let is_optional = node_is_optional(n: match rt_node(n: child) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  let default_str = if is_optional {
    " = None"
  } else {
    ""
  }
  concat("    ", py_ident(name: child.name), ": ", ty, default_str)
}

fn emit_py_enum_from_children(name: String, children: List<Node>) -> String {
  let has_data = children |> any(child => child.children |> count > 0)
  if has_data {
    // Tagged union: emit as a set of dataclasses + a Union type alias
    let variant_classes = children |> map(child => emit_py_variant_class_from_child(parent_name: name, child: child))
    let variant_names = children |> map(child => concat(name, child.name))
    let union_str = variant_names |> join(separator: ", ")
    let classes_str = variant_classes |> join(separator: "\n\n\n")
    concat(classes_str, "\n\n\n", name, " = Union[", union_str, "]")
  } else {
    // Simple enum: all unit variants
    let variant_lines = children |> map(child =>
      concat("    ", child.name, " = auto()")
    )
    let variants_str = variant_lines |> join(separator: "\n")
    concat("class ", name, "(Enum):\n", variants_str)
  }
}

fn emit_py_variant_class_from_child(parent_name: String, child: Node) -> String {
  let class_name = concat(parent_name, child.name)
  if child.children |> count == 0 {
    concat("@dataclass\nclass ", class_name, ":\n    pass")
  } else {
    let field_lines = child.children |> map(f => emit_py_dataclass_field_from_child(child: f))
    let fields_str = field_lines |> join(separator: "\n")
    concat("@dataclass\nclass ", class_name, ":\n", fields_str)
  }
}

// =========================================================================
// Node-based type emission
//
// These functions dispatch on Node structure (connective + name + children)
// to render Python type syntax.
// =========================================================================

fn emit_py_node_type(n: Node) -> String {
  // Callable type: function used as a value -- emit Callable[[ParamTypes], RetType].
  if n.name == "Callable" && n.params |> count > 0 {
    let param_types = n.params |> map(p => emit_py_node_type(n: p.type_expr))
    let param_str = param_types |> join(separator: ", ")
    let ret_str = match n.return_type {
      Some { value: Resolved { node: rt } } => emit_py_node_type(n: rt)
      _ => "None"
    }
    return concat("Callable[[", param_str, "], ", ret_str, "]")
  }
  if node_is_optional(n: n) {
    return python_container(kind: "optional", inner: emit_py_node_type(n: with_required_cardinality(n: n)))
  }
  let kind = classify_type_structure(n: n)
  if (kind == TypeLeaf) {
    emit_py_node_type_leaf(n: n)
  } else if (kind == TypeConj) {
    emit_py_node_type_conj(n: n)
  } else {
    emit_py_node_type_disj(n: n)
  }
}

fn emit_py_node_type_leaf(n: Node) -> String {
  if n.children |> count == 0 {
    python_primitive_type(name: n.name)
  } else if node_is_map(n: n) {
    let k = match n.children |> first {
      Some { value: kn } => emit_py_node_type(n: kn)
      None => "str"
    }
    let v = match skip(n.children, 1) |> first {
      Some { value: vn } => emit_py_node_type(n: vn)
      None => "str"
    }
    apply_type_template2(template: python_map_template(), arg0: k, arg1: v)
  } else if n.children |> count == 1 {
    let inner = match n.children |> first {
      Some { value: child } => emit_py_node_type(n: child)
      None => "None"
    }
    // Python has no NonEmpty distinction -- use same container
    if n.name == "NonEmptyList" {
      python_container(kind: "list", inner: inner)
    } else if n.name == "NonEmptySet" {
      python_container(kind: "set", inner: inner)
    } else {
      python_container(kind: to_snake(name: n.name), inner: inner)
    }
  } else {
    n.name
  }
}

fn emit_py_node_type_conj(n: Node) -> String {
  if n.name == "Refined" {
    match n.children |> first {
      Some { value: base } => emit_py_node_type(n: base)
      None => n.name
    }
  } else if n.name == "Tuple" {
    let first_str = match n.children |> first {
      Some { value: c } => emit_py_node_type(n: c)
      None => "Any"
    }
    let second_str = match skip(n.children, 1) |> first {
      Some { value: c } => emit_py_node_type(n: c)
      None => "Any"
    }
    concat("Tuple[", first_str, ", ", second_str, "]")
  } else if n.name != "" {
    n.name
  } else {
    if n.children |> count == 1 {
      match n.children |> first {
        Some { value: field_node } => emit_single_field_product_py_type(field_node: field_node)
        None => "dict"
      }
    } else {
      "dict"
    }
  }
}

fn emit_py_node_type_disj(n: Node) -> String {
  if n.name != "" {
    n.name
  } else {
    "dict"
  }
}

// =========================================================================
// Pure function (fn) emission
// =========================================================================

fn emit_py_fn_def(name: String, params: List<Param>, return_type: Node, body: Node, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let depth = 0
  let params_str = emit_py_params(params: params)
  let ret_str = emit_py_return_type(return_type: return_type)
  let body_scope = build_params_scope(scope: scope, params: params)
  // Tail-call optimization: use cached analysis from item registry.
  let use_tco = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.is_self_recursive && info.has_non_tail_self_call == false
    None => {
      expr_has_self_call(texpr: body, fn_name: name)
        && expr_has_non_tail_self_call(texpr: body, fn_name: name, in_tail: true) == false
    }
  }
  if use_tco {
    let body_str = emit_py_typed_tco_body(texpr: body, fn_name: name, params: params, registry: registry, scope: body_scope, depth: depth + 1)
    concat("def ", py_ident(name: name), "(", params_str, ")", ret_str, ":\n",
      make_indent(level: depth + 1), body_str)
  } else {
    let body_str = emit_py_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: depth + 1)
    concat("def ", py_ident(name: name), "(", params_str, ")", ret_str, ":\n",
      make_indent(level: depth + 1), "return ", body_str)
  }
}

// =========================================================================
// Workflow function (func) emission -- async def
// =========================================================================

fn emit_py_func_def(
  name: String,
  params: List<Param>,
  return_type: Node,
  uses: List<ResourceUse>,
  body: Node,
  registry: Map<String, ItemInfo>,
  scope: InferScope
) -> String {
  let depth = 0
  let service_names = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.service_names
    None => []
  }
  let params_str = emit_py_func_params(params: params, uses: uses, service_names: service_names)
  let ret_str = emit_py_return_type(return_type: return_type)
  let body_scope = build_params_scope(scope: scope, params: params)
  let body_str = emit_py_typed_func_body(body: body, registry: registry, scope: body_scope, depth: depth + 1)
  concat("async def ", py_ident(name: name), "(", params_str, ")", ret_str, ":\n",
    make_indent(level: depth + 1), body_str)
}

fn emit_py_func_params(params: List<Param>, uses: List<ResourceUse>, service_names: List<String>) -> String {
  let param_strs = params |> map(p => emit_py_param(param: p))
  let resource_strs = uses |> map(u =>
    concat(py_ident(name: u.name), ": ", emit_py_node_type(n: u.resource))
  )
  let service_strs = service_names |> map(sn =>
    concat(service_var_name(service_name: sn), ": ", sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

// =========================================================================
// Parameter emission
// =========================================================================

fn emit_py_params(params: List<Param>) -> String {
  let strs = params |> map(p => emit_py_param(param: p))
  strs |> join(separator: ", ")
}

fn emit_py_param(param: Param) -> String {
  let ty = emit_py_node_type(n: param.type_expr)
  concat(py_ident(name: param.name), ": ", ty)
}

fn emit_py_return_type(return_type: Node) -> String {
  concat(" -> ", emit_py_node_type(n: return_type))
}
fn emit_py_pattern(pattern: MatchPattern) -> String {
  match pattern {
    Bind { name: n } => py_ident(name: n)
    LitPattern { value: v } => python_literal(value: v)
    VariantPattern { name: n, parent_enum: _, field_bindings: fbs } =>
      emit_py_variant_pattern(name: n, field_bindings: fbs)
    Wildcard => "_"
  }
}

fn emit_py_variant_pattern(name: String, field_bindings: List<FieldBinding>) -> String {
  if field_bindings |> count == 0 {
    concat(name, "()")
  } else {
    let binding_strs = field_bindings |> map(fb =>
      let pat_str = emit_py_pattern(pattern: fb.binding)
      concat(py_ident(name: fb.field_name), "=", pat_str)
    )
    let bindings_str = binding_strs |> join(separator: ", ")
    concat(name, "(", bindings_str, ")")
  }
}
fn emit_py_field_access(base: Node, field: String, summary: FieldSummary?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let base_str = emit_py_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth)
  match summary {
    Some { value: fs } =>
      match fs.access_style {
        TupleFirst => concat(base_str, "[0]")
        TupleSecond => concat(base_str, "[1]")
        _ => concat(base_str, ".", py_ident(name: field))
      }
    None => concat(base_str, ".", py_ident(name: field))
  }
}

fn emit_py_typed_expr(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  match texpr.expr_data {
    ExprLiteral { value: v } => python_literal(value: v)
    ExprError { kind: _, message: message } => concat("raise RuntimeError(", emit_string_literal(s: message, suffix: ""), ")")
    ExprVar { name: n, binding_kind: _ } => py_ident(name: n)
    ExprFieldAccess { base: b, field: f, summary: summary } =>
      if is_typed_service_call_receiver(receiver: texpr) {
        match extract_typed_service_name(receiver: texpr) {
          Some { value: svc_name } => service_var_name(service_name: svc_name)
          None => emit_py_field_access(base: b, field: f, summary: summary, registry: registry, scope: scope, depth: depth)
        }
      } else {
        emit_py_field_access(base: b, field: f, summary: summary, registry: registry, scope: scope, depth: depth)
      }
    ExprCall { func: f, args: a, call_semantics: _ } =>
      emit_py_typed_call(func: f, args: a, registry: registry, scope: scope, depth: depth)
    ExprMethodCall { receiver: r, method: m, args: a, method_semantics: method_semantics } =>
      emit_py_typed_method_call(receiver: r, method: m, args: a, method_semantics: method_semantics, registry: registry, scope: scope, depth: depth)
    ExprMatch { scrutinee: s, arms: arm_list } =>
      emit_py_typed_match(scrutinee: s, arms: arm_list, registry: registry, scope: scope, depth: depth)
    ExprIf { condition: c, then_branch: t, else_branch: e } =>
      emit_py_typed_if(condition: c, then_branch: t, else_branch: e, registry: registry, scope: scope, depth: depth)
    ExprLet { name: n, value: v, body: bd } =>
      emit_py_typed_let(name: n, value: v, body: bd, registry: registry, scope: scope, depth: depth)
    ExprRecordLit { type_name: tn, fields: fs, parent_enum: _ } =>
      emit_py_typed_record_lit(type_name: tn, fields: fs, registry: registry, scope: scope, depth: depth)
    ExprListLit { elements: els } =>
      emit_py_typed_list_lit(elements: els, registry: registry, scope: scope, depth: depth)
    ExprBinOp { op: o, left: l, right: r } =>
      emit_py_typed_bin_op(op: o, left: l, right: r, registry: registry, scope: scope, depth: depth)
    ExprUnaryOp { op: o, operand: e } =>
      emit_py_typed_unary_op(op: o, operand: e, registry: registry, scope: scope, depth: depth)
    ExprLambda { params: ps, body: bd, semantics: _ } =>
      emit_py_typed_lambda(params: ps, body: bd, registry: registry, scope: scope, depth: depth)
    ExprStringInterp { parts: ps } =>
      emit_py_typed_string_interp(parts: ps, registry: registry, scope: scope, depth: depth)
    ExprBlock { stmts: ss } =>
      emit_py_typed_block(stmts: ss, registry: registry, scope: scope, depth: depth)
    ExprCast { expr: e, target: t } =>
      emit_py_typed_cast(expr: e, target: t, registry: registry, scope: scope, depth: depth)
    ExprForEach { variable: v, collection: c, body: bd } =>
      emit_py_typed_for_each(variable: v, collection: c, body: bd, registry: registry, scope: scope, depth: depth)
    ExprIndex { base: b, index: i } =>
      emit_py_typed_index(base: b, index: i, registry: registry, scope: scope, depth: depth)
    ExprSlice { base: b, start: s, end: e } =>
      emit_py_typed_slice(base: b, start: s, end: e, registry: registry, scope: scope, depth: depth)
    ExprReturn { value: v } =>
      concat("return ", emit_py_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth))
    NoExprData => ""
  }
}

fn emit_py_typed_call(func: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let ordered_args = order_typed_call_args(args: args, func: func, scope: scope)
  let arg_strs = ordered_args |> map(a => emit_py_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth))
  let callee = lookup_item(registry: registry, name: func)
  let extra_args = match callee {
    Some { value: info } =>
      let is_func = info.kind == FuncItem
      if is_func {
        info.service_names |> map(sn => service_var_name(service_name: sn))
      } else { [] }
    None => []
  }
  let all_args = concat(arg_strs, extra_args)
  let args_str = all_args |> join(separator: ", ")
  let call_str = concat(py_ident(name: func), "(", args_str, ")")
  match callee {
    Some { value: info } =>
      let is_func = info.kind == FuncItem
      if is_func { concat("await ", call_str) } else { call_str }
    None => call_str
  }
}

fn emit_py_typed_for_each(variable: String, collection: Node, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let coll_str = emit_py_typed_expr(texpr: collection, registry: registry, scope: scope, depth: depth)
  let elem_type = for_each_element_type_node(n: match rt_node(n: collection) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type)
  let body_str = emit_py_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: depth + 1)
  concat("for ", py_ident(name: variable), " in ", coll_str, ":\n",
    make_indent(level: depth + 1), body_str)
}

fn emit_py_typed_index(base: Node, index: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let base_str = emit_py_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth)
  let index_str = emit_py_typed_expr(texpr: index, registry: registry, scope: scope, depth: depth)
  concat(base_str, "[", index_str, "]")
}

fn emit_py_typed_slice(base: Node, start: Node, end: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let base_str = emit_py_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth)
  let start_str = emit_py_typed_expr(texpr: start, registry: registry, scope: scope, depth: depth)
  let end_str = emit_py_typed_expr(texpr: end, registry: registry, scope: scope, depth: depth)
  concat(base_str, "[", start_str, ":", end_str, "]")
}

fn emit_py_intrinsic_method_call(intrinsic: IntrinsicMethod, receiver: Node, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let recv_str = emit_py_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth)
  let first_arg_str = emit_py_typed_first_arg(args: args, registry: registry, scope: scope, depth: depth)
  match intrinsic {
    MethodCount => concat("len(", recv_str, ")")
    MethodJoin => concat(first_arg_str, ".join(", recv_str, ")")
    MethodSplit => concat(recv_str, ".split(", first_arg_str, ")")
    MethodLast => concat(recv_str, "[-1] if ", recv_str, " else None")
    MethodFirst => concat(recv_str, "[0] if ", recv_str, " else None")
    MethodEnumerate => concat("list(enumerate(", recv_str, "))")
    MethodChars => concat("list(", recv_str, ")")
    MethodStringContains => concat(first_arg_str, " in ", recv_str)
    MethodConcat => concat(recv_str, " + ", first_arg_str)
    MethodMap => concat("[", first_arg_str, "(x) for x in ", recv_str, "]")
    MethodFilter => concat("[x for x in ", recv_str, " if ", first_arg_str, "(x)]")
    MethodAny => concat("any(", first_arg_str, "(x) for x in ", recv_str, ")")
    MethodAll => concat("all(", first_arg_str, "(x) for x in ", recv_str, ")")
    MethodFlatMap => concat("[y for x in ", recv_str, " for y in ", first_arg_str, "(x)]")
    MethodSkip => concat(recv_str, "[", first_arg_str, ":]")
    MethodTake => concat(recv_str, "[:", first_arg_str, "]")
    MethodFold => concat("functools.reduce(", first_arg_str, ", ", recv_str, ")")
    MethodSortBy => concat("sorted(", recv_str, ", key=", first_arg_str, ")")
    MethodAppend => concat(recv_str, " + [", first_arg_str, "]")
  }
}

fn py_bridge_method_name(method: RuntimeBridgeMethod) -> String {
  match method {
    BridgeGet => "get"
    BridgeWith => "with_update"
    BridgeListPush => "list_push"
    BridgeMapInsert => "map_insert"
    BridgeMapMerge => "map_merge"
    BridgeMapGet => "map_get"
    BridgeMapHas => "map_has"
    BridgeEmitMapHas => "emit_map_has"
    BridgeMapValues => "map_values"
    BridgeMapKeys => "map_keys"
    BridgeMapContainsKey => "map_contains_key"
    BridgeCharAt => "char_at"
    BridgeStringAt => "string_at"
    BridgeStringLength => "string_length"
    BridgeLength => "length"
    BridgeStartsWith => "starts_with"
    BridgeEndsWith => "ends_with"
    BridgeToString => "to_string"
    BridgeTrim => "trim"
    BridgeToLower => "to_lower"
    BridgeToUpper => "to_upper"
    BridgeReplace => "replace"
    BridgeSubstring => "substring"
    BridgeToInt => "to_int"
    BridgeEmptyMap => "empty_map"
    BridgeContains => "contains"
    BridgeReverse => "reverse"
    BridgeLookup => "lookup"
  }
}

fn emit_py_runtime_bridge_method_call(method: RuntimeBridgeMethod, receiver: Node, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let function_name = py_bridge_method_name(method: method)
  let recv_str = emit_py_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth)
  let arg_strs = args |> map(a => emit_py_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth))
  let all_args = concat([recv_str], arg_strs)
  concat(py_ident(name: function_name), "(", all_args |> join(separator: ", "), ")")
}

fn emit_py_plain_method_call(receiver: Node, method: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let recv_str = emit_py_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth)
  let arg_strs = args |> map(a => emit_py_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth))
  let args_str = arg_strs |> join(separator: ", ")
  concat(recv_str, ".", py_ident(name: method), "(", args_str, ")")
}

fn emit_py_typed_method_call(receiver: Node, method: String, args: List<NamedArg>, method_semantics: MethodSemantics?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  match method_semantics {
    Some { value: ServiceMethodSemantics { service_name: svc_name } } => {
      let var_name = service_var_name(service_name: svc_name)
      let arg_strs = args |> map(a => emit_py_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth))
      let args_str = arg_strs |> join(separator: ", ")
      concat("await ", var_name, ".", py_ident(name: method), "(", args_str, ")")
    }
    Some { value: IntrinsicMethodSemantics { intrinsic: intrinsic, fold_accumulator_type: _ } } =>
      emit_py_intrinsic_method_call(intrinsic: intrinsic, receiver: receiver, args: args, registry: registry, scope: scope, depth: depth)
    Some { value: RuntimeBridgeSemantics { method: bridge_method } } =>
      emit_py_runtime_bridge_method_call(method: bridge_method, receiver: receiver, args: args, registry: registry, scope: scope, depth: depth)
    Some { value: PlainMethodSemantics } =>
      emit_py_plain_method_call(receiver: receiver, method: method, args: args, registry: registry, scope: scope, depth: depth)
    None =>
      if is_typed_service_call_receiver(receiver: receiver) {
        match extract_typed_service_name(receiver: receiver) {
          Some { value: svc_name } =>
            let var_name = service_var_name(service_name: svc_name)
            let arg_strs = args |> map(a => emit_py_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth))
            let args_str = arg_strs |> join(separator: ", ")
            concat("await ", var_name, ".", py_ident(name: method), "(", args_str, ")")
          None => "raise NotImplementedError(\"unsupported service receiver\")"
        }
      } else {
        emit_py_plain_method_call(receiver: receiver, method: method, args: args, registry: registry, scope: scope, depth: depth)
      }
  }
}

fn emit_py_typed_first_arg(args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  match args |> first {
    Some { value: a } => emit_py_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth)
    None => "raise NotImplementedError(\"missing method argument\")"
  }
}

fn emit_py_typed_match(scrutinee: Node, arms: List<MatchArm>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let scrut_str = emit_py_typed_expr(texpr: scrutinee, registry: registry, scope: scope, depth: depth)
  let arm_strs = arms |> map(arm => emit_py_typed_match_arm(arm: arm, registry: registry, scope: scope, depth: depth))
  let arms_str = arm_strs |> join(separator: "\n")
  concat("match ", scrut_str, ":\n", arms_str)
}

fn emit_py_typed_match_arm(arm: MatchArm, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let pat_str = emit_py_pattern(pattern: arm.pattern)
  let guard_str = match arm.guard {
    Some { value: g } => concat(" if ", emit_py_typed_expr(texpr: g, registry: registry, scope: scope, depth: depth))
    None => ""
  }
  let body_str = emit_py_typed_expr(texpr: arm.body, registry: registry, scope: scope, depth: depth + 2)
  concat(make_indent(level: depth + 1), "case ", pat_str, guard_str, ":\n",
    make_indent(level: depth + 2), body_str)
}

fn emit_py_typed_if(condition: Node, then_branch: Node, else_branch: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let cond_str = emit_py_typed_expr(texpr: condition, registry: registry, scope: scope, depth: depth)
  let then_str = emit_py_typed_expr(texpr: then_branch, registry: registry, scope: scope, depth: depth)
  match else_branch {
    Some { value: eb } => {
      let else_str = emit_py_typed_expr(texpr: eb, registry: registry, scope: scope, depth: depth)
      concat("(", then_str, ") if (", cond_str, ") else (", else_str, ")")
    }
    None =>
      concat("if ", cond_str, ":\n",
        make_indent(level: depth + 1), then_str)
  }
}

fn emit_py_typed_let(name: String, value: Node, body: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let val_str = emit_py_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth)
  let let_line = concat(py_ident(name: name), " = ", val_str)
  match body {
    Some { value: bd } =>
      let next_scope = extend_scope(scope: scope, name: name, resolved: match rt_node(n: value) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
      concat(let_line, "\n", emit_py_typed_expr(texpr: bd, registry: registry, scope: next_scope, depth: depth))
    None => let_line
  }
}

fn emit_py_typed_record_lit(type_name: String?, fields: List<FieldInit>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  match type_name {
    None => {
      if fields |> count == 0 {
        "{}"
      } else {
        let field_strs = fields |> map(f =>
          concat("    \"", f.name, "\": ", emit_py_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: depth), ",")
        )
        let fields_str = field_strs |> join(separator: "\n")
        concat("{\n", fields_str, "\n}")
      }
    }
    Some { value: tn } =>
      if fields |> count == 0 {
        concat(tn, "()")
      } else {
        let field_strs = fields |> map(f =>
          concat(py_ident(name: f.name), "=", emit_py_typed_expr(texpr: f.value, registry: registry, scope: scope, depth: depth))
        )
        let fields_str = field_strs |> join(separator: ", ")
        concat(tn, "(", fields_str, ")")
      }
  }
}

fn emit_py_typed_list_lit(elements: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  if elements |> count == 0 {
    "[]"
  } else {
    let el_strs = elements |> map(e => emit_py_typed_expr(texpr: e, registry: registry, scope: scope, depth: depth))
    let els_str = el_strs |> join(separator: ", ")
    concat("[", els_str, "]")
  }
}

fn emit_py_typed_bin_op(op: BinOpKind, left: Node, right: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let l_str = emit_py_typed_expr(texpr: left, registry: registry, scope: scope, depth: depth)
  let r_str = emit_py_typed_expr(texpr: right, registry: registry, scope: scope, depth: depth)
  if is_null_coalesce(op: op) {
    concat("(", l_str, " if ", l_str, " is not None else ", r_str, ")")
  } else {
    let op_str = python_bin_op_symbol(op: op)
    concat("(", l_str, " ", op_str, " ", r_str, ")")
  }
}

fn emit_py_typed_unary_op(op: UnaryOpKind, operand: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let expr_str = emit_py_typed_expr(texpr: operand, registry: registry, scope: scope, depth: depth)
  match op {
    Not => concat(python_keyword(key: "not"), expr_str)
    Neg => concat("-", expr_str)
  }
}

fn emit_py_typed_lambda(params: List<String>, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let param_strs = params |> map(p => py_ident(name: p))
  let params_str = param_strs |> join(separator: ", ")
  let body_str = emit_py_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth)
  concat("lambda ", params_str, ": ", body_str)
}

fn emit_py_typed_string_interp(parts: List<StringPart>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let segments = parts |> map(p => py_typed_interp_segment(part: p, registry: registry, scope: scope, depth: depth))
  let fstr = segments |> join(separator: "")
  concat("f\"", fstr, "\"")
}

fn py_typed_interp_segment(part: StringPart, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  match part {
    Text { value: v } =>
      v |> split(delimiter: "{") |> join(separator: "{{")
        |> split(delimiter: "}") |> join(separator: "}}")
    Interpolation { expr: e } =>
      concat("{", emit_py_typed_expr(texpr: e, registry: registry, scope: scope, depth: depth), "}")
  }
}

fn emit_py_typed_block(stmts: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let state = emit_py_block_stmts(
    remaining: stmts, text: [], scope: scope, registry: registry, depth: depth)
  state.text |> join(separator: "\n")
}

fn emit_py_typed_cast(expr: Node, target: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let expr_str = emit_py_typed_expr(texpr: expr, registry: registry, scope: scope, depth: depth)
  let ty_str = emit_py_node_type(n: target)
  concat(ty_str, "(", expr_str, ")")
}

// =========================================================================
// Node func body -- async def body emission using Node.expr_data.
// =========================================================================

fn emit_py_typed_func_body(body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  match body.expr_data {
    ExprLet { name: n, value: v, body: inner } => {
      let val_str = emit_py_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth)
      let let_line = concat(py_ident(name: n), " = ", val_str)
      let next_scope = extend_scope(scope: scope, name: n, resolved: match rt_node(n: v) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
      match inner {
        Some { value: bd } =>
          concat(let_line, "\n", emit_py_typed_func_body(body: bd, registry: registry, scope: next_scope, depth: depth))
        None => let_line
      }
    }
    ExprBlock { stmts: ss } => {
      if ss |> count == 0 {
        "return None"
      } else {
        let init_state = emit_py_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth)
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Some { value: s } => concat("return ", emit_py_typed_expr(texpr: s, registry: registry, scope: init_state.scope, depth: depth))
          None => "return None"
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    }
    _ => concat("return ", emit_py_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth))
  }
}

// =========================================================================
// Node TCO -- Python rendering
//
// TCO functions that work on Node.expr_data,
// reading return_type from sub-expressions instead of cache lookups.
// =========================================================================

fn emit_py_typed_tco_body(texpr: Node, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let inner = emit_py_typed_tco_expr(texpr: texpr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
  concat("while True:\n", make_indent(level: depth + 1), inner)
}

fn emit_py_typed_tco_expr(texpr: Node, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  match texpr.expr_data {
    ExprCall { func: f, args: a, call_semantics: _ } =>
      if f == fn_name {
        emit_py_typed_tco_reassign(args: a, params: params, registry: registry, scope: scope, depth: depth)
      } else {
        let call_str = emit_py_typed_call(func: f, args: a, registry: registry, scope: scope, depth: depth)
        concat("return ", call_str)
      }
    ExprIf { condition: c, then_branch: t, else_branch: e } =>
      let cond_str = emit_py_typed_expr(texpr: c, registry: registry, scope: scope, depth: depth)
      let then_str = emit_py_typed_tco_expr(texpr: t, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
      match e {
        Some { value: eb } =>
          let else_str = emit_py_typed_tco_expr(texpr: eb, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
          concat("if ", cond_str, ":\n",
            make_indent(level: depth + 1), then_str, "\nelse:\n",
            make_indent(level: depth + 1), else_str)
        None =>
          concat("if ", cond_str, ":\n",
            make_indent(level: depth + 1), then_str)
      }
    ExprMatch { scrutinee: s, arms: arm_list } =>
      let scrut_str = emit_py_typed_expr(texpr: s, registry: registry, scope: scope, depth: depth)
      let arm_strs = arm_list |> map(arm =>
        emit_py_typed_tco_match_arm(arm: arm, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth))
      let arms_str = arm_strs |> join(separator: "\n")
      concat("match ", scrut_str, ":\n", arms_str)
    ExprLet { name: n, value: v, body: bd } =>
      let val_str = emit_py_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth)
      let let_line = concat(py_ident(name: n), " = ", val_str)
      let next_scope = extend_scope(scope: scope, name: n, resolved: match rt_node(n: v) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
      match bd {
        Some { value: b } =>
          concat(let_line, "\n", emit_py_typed_tco_expr(texpr: b, fn_name: fn_name, params: params, registry: registry, scope: next_scope, depth: depth))
        None => let_line
      }
    ExprBlock { stmts: ss } =>
      if ss |> count == 0 {
        "return None"
      } else {
        let init_state = emit_py_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth)
        let last_str = match ss |> last {
          Some { value: last_expr } =>
            emit_py_typed_tco_expr(texpr: last_expr, fn_name: fn_name, params: params, registry: registry, scope: init_state.scope, depth: depth)
          None => "return None"
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    _ =>
      let val_str = emit_py_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth)
      concat("return ", val_str)
  }
}

fn emit_py_typed_tco_match_arm(arm: MatchArm, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let pat_str = emit_py_pattern(pattern: arm.pattern)
  let guard_str = match arm.guard {
    Some { value: g } => concat(" if ", emit_py_typed_expr(texpr: g, registry: registry, scope: scope, depth: depth))
    None => ""
  }
  let body_str = emit_py_typed_tco_expr(texpr: arm.body, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 2)
  concat(make_indent(level: depth + 1), "case ", pat_str, guard_str, ":\n",
    make_indent(level: depth + 2), body_str)
}

fn emit_py_typed_tco_reassign(args: List<NamedArg>, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let ordered_args = args |> map(a => emit_py_typed_expr(texpr: a.value, registry: registry, scope: scope, depth: depth))
  let param_names = params |> map(p => py_ident(name: p.name))
  let temp_lets = ordered_args |> enumerate |> map(pair =>
    concat("__tco_", to_string(value: pair.first), " = ", pair.second))
  let assigns = param_names |> enumerate |> map(pair =>
    concat(pair.second, " = __tco_", to_string(value: pair.first)))
  let all_lines = concat(temp_lets, assigns, ["continue"])
  all_lines |> join(separator: "\n")
}

// =========================================================================
// Service definition emission
//
// Each service becomes a class with:
//   - __init__ with config
//   - One async method per operation
//   - aiohttp for REST transport
// =========================================================================

fn emit_py_service_def(
  item: Node,
  registry: Map<String, ItemInfo>
) -> String {
  let depth = 0
  let safe_name = sanitize_service_name(name: item.name)
  let transport = if item.transport == none { local_transport_node(span: item.span) } else { item.transport.value }
  let init_method = emit_py_service_init(transport: transport, config: item.config)
  let op_children = item.children
  let methods = op_children |> map(op_node =>
    emit_py_operation_method(service_name: safe_name, transport: transport, op_node: op_node, registry: registry, depth: depth + 1)
  )
  let methods_str = methods |> join(separator: "\n\n")
  concat("class ", safe_name, ":\n",
    make_indent(level: depth + 1), init_method, "\n\n",
    make_indent(level: depth + 1), methods_str)
}

fn emit_py_service_init(transport: Node, config: ServiceConfig?) -> String {
  if is_transport_kind(t: transport, kind: RestTransport) {
    let auth_param = if transport_has_auth(t: transport) { ", auth_token: str" } else { "" }
    let auth_assign = if transport_has_auth(t: transport) { "\n    self.auth_token = auth_token" } else { "" }
    concat("def __init__(self, base_url: str", auth_param, "):\n",
      "    self.base_url = base_url", auth_assign)
  } else if is_transport_kind(t: transport, kind: ShellTransport) {
    concat("def __init__(self, working_dir: str | None = None):\n",
      "    self.working_dir = working_dir")
  } else if is_transport_kind(t: transport, kind: FileTransport) {
    concat("def __init__(self, base_path: str):\n",
      "    self.base_path = base_path")
  } else {
    "def __init__(self):\n    pass"
  }
}

fn emit_py_operation_method(service_name: String, transport: Node, op_node: Node, registry: Map<String, ItemInfo>, depth: Int) -> String {
  let input_params = op_node.params |> map(p =>
    concat(py_ident(name: p.name), ": ", emit_py_node_type(n: p.type_expr))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "self"
  } else {
    concat("self, ", params_str)
  }
  let ret_type = emit_py_node_type(n: match rt_node(n: op_node) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  let effective_transport = match op_node.transport {
    Some { value: op_transport } => op_transport
    None => transport
  }
  let body = emit_py_transport_call(transport: effective_transport, op_name: op_node.name, registry: registry)
  concat("async def ", py_ident(name: op_node.name),
    "(", all_params, ") -> ", ret_type, ":\n",
    make_indent(level: depth + 1), body)
}

fn emit_py_transport_call(transport: Node, op_name: String, registry: Map<String, ItemInfo>) -> String {
  if is_transport_kind(t: transport, kind: RestTransport) {
    emit_py_rest_call(op_name: op_name, transport: transport)
  } else if is_transport_kind(t: transport, kind: ShellTransport) {
    emit_py_shell_call(op_name: op_name, transport: transport)
  } else if is_transport_kind(t: transport, kind: FileTransport) {
    emit_py_file_call(op_name: op_name)
  } else {
    emit_py_local_call(op_name: op_name)
  }
}

fn emit_py_rest_call(op_name: String, transport: Node) -> String {
  let self_base_url = concat("{", "self.base_url", "}")
  let url_line = concat("url = f\"", self_base_url, "/", py_ident(name: op_name), "\"")
  let headers_dict = emit_py_headers_dict(transport: transport)
  let session_lines = concat(
    "async with aiohttp.ClientSession() as session:\n",
    "    async with session.post(url, headers=headers) as response:\n",
    "        return await response.json()"
  )
  concat(url_line, "\n", headers_dict, "\n", session_lines)
}

fn emit_py_headers_dict(transport: Node) -> String {
  let auth_entry = if transport_has_auth(t: transport) {
    let header_name = match transport_auth_header_name(t: transport) {
      Some { value: h } => h
      None => "Authorization"
    }
    concat("\"", header_name, "\": self.auth_token, ")
  } else { "" }
  let hdrs = transport_headers(t: transport)
  let header_entries = hdrs |> map(h =>
    concat("\"", h.name, "\": _unimplemented(\"header value emission for '", h.name, "'\")")
  )
  let all_entries = if auth_entry == "" {
    header_entries |> join(separator: ", ")
  } else {
    concat(auth_entry, header_entries |> join(separator: ", "))
  }
  concat("headers = {", all_entries, "}")
}

fn emit_py_shell_call(op_name: String, transport: Node) -> String {
  let envs = transport_env(t: transport)
  let env_dict_entries = envs |> map(e =>
    concat("\"", e.name, "\": _unimplemented(\"env value emission for '", e.name, "'\")")
  )
  let env_str = concat("{", env_dict_entries |> join(separator: ", "), "}")
  concat(
    "import subprocess\n",
    "result = subprocess.run(\n",
    "    [\"", py_ident(name: op_name), "\"],\n",
    "    cwd=self.working_dir or \".\",\n",
    "    env=", env_str, ",\n",
    "    capture_output=True, text=True,\n",
    ")\n",
    "return result.stdout"
  )
}

fn emit_py_file_call(op_name: String) -> String {
  let self_base_path = concat("{", "self.base_path", "}")
  concat(
    "path = f\"", self_base_path, "/", py_ident(name: op_name), "\"\n",
    "with open(path) as f:\n",
    "    return f.read()"
  )
}

fn emit_py_local_call(op_name: String) -> String {
  concat("# Local binding -- direct function call\n",
    "return ", py_ident(name: op_name), "()")
}

// =========================================================================
// Resource definition emission
//
// Resources become abstract base classes with abstract methods.
// =========================================================================

fn emit_py_resource_def(item: Node) -> String {
  let depth = 0
  let cap_children = item.children
  let methods = cap_children |> map(c => emit_py_capability_method(cap_node: c))
  let methods_str = methods |> join(separator: "\n\n")
  concat("from abc import ABC, abstractmethod\n\n",
    "class ", item.name, "(ABC):\n",
    make_indent(level: depth + 1), methods_str)
}

fn emit_py_capability_method(cap_node: Node) -> String {
  let input_params = cap_node.params |> map(p =>
    concat(py_ident(name: p.name), ": ", emit_py_node_type(n: p.type_expr))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "self"
  } else {
    concat("self, ", params_str)
  }
  let ret = emit_py_node_type(n: match rt_node(n: cap_node) { Some { value: rt } => rt  None => leaf_node(name: "Unit") })
  concat("@abstractmethod\n",
    "async def ", py_ident(name: cap_node.name), "(", all_params, ") -> ", ret, ":\n",
    "    ...")
}

// =========================================================================
// Data definition emission
//
// data name: Type = value  ->  module-level constant
// =========================================================================

fn emit_py_data_def(name: String, type_node: Node, value: Node, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ty_str = emit_py_node_type(n: type_node)
  let upper_name = to_screaming_snake(name: name)
  let val_str = emit_py_typed_expr(texpr: value, registry: registry, scope: scope, depth: 0)
  concat(upper_name, ": ", ty_str, " = ", val_str)
}

// =========================================================================
// Identifier conversion -- Python target
// =========================================================================

// Convert a DSL identifier to a valid Python identifier.
// Handles reserved word collision by appending underscore suffix.
fn py_ident(name: String) -> String {
  let snake = to_snake(name: name)
  if python_reserved |> any(r => r == snake) {
    concat(snake, "_")
  } else {
    snake
  }
}

// =========================================================================
// requirements.txt emission
// =========================================================================

fn emit_requirements_txt(has_services: Bool) -> TextFile {
  let base_deps = ""
  let async_deps = if has_services {
    "aiohttp>=3.9\n"
  } else {
    ""
  }
  TextFile { path: "requirements.txt", content: concat(base_deps, async_deps) }
}

// has_service_items and is_service_item are now shared -- imported from v2.compiler.emit
