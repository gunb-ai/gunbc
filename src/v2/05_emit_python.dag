}

fn emit_py_expr_block(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_py_typed_block(stmts: expr.children, registry: registry, scope: scope, depth: depth)
}

fn emit_py_expr_cast(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_cast_shared(expr: cast_expr(texpr: expr), cast_target_node: cast_target(texpr: expr), target: Python, recurse: child => emit_py_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024), source_index: scope.type_env.source_index)
}

fn emit_py_expr_for_each(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_for_each_shared(
    variable: foreach_variable_at(texpr: expr, source_index: scope.type_env.source_index),
    collection: foreach_collection(texpr: expr),
    body: foreach_body(texpr: expr),
    target: Python, depth: depth, source_index: scope.type_env.source_index,
    recurse: (child, s, d) => emit_py_typed_expr(texpr: child, registry: registry, scope: s, depth: d, fuel: 1024),
    scope: scope)
}

fn emit_py_expr_index(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_index_shared(base: index_base(texpr: expr), index: index_expr(texpr: expr), target: Python, recurse: child => emit_py_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024), source_index: scope.type_env.source_index)
}

fn emit_py_expr_slice(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_slice_shared(base: slice_base(texpr: expr), start: slice_start(texpr: expr), end: slice_end(texpr: expr), target: Python, recurse: child => emit_py_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024), source_index: scope.type_env.source_index)
}

fn emit_py_typed_expr(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, fuel: Int) -> String {
  emit_shared_expr(
    texpr: texpr,
    target: Python,
    source_index: scope.type_env.source_index,
    wrap_result: result => result,
    recurse: child => emit_py_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: fuel - 1),
    emit_var: expr => emit_py_expr_var(expr: expr, source_index: scope.type_env.source_index),
    emit_field_access: expr => emit_py_expr_field_access(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_call: expr => emit_py_expr_call(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_method_call: expr => emit_py_expr_method_call(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_match: expr => emit_py_expr_match(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_if: expr => emit_py_expr_if(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_let: expr => emit_py_expr_let(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_record_lit: expr => emit_py_expr_record_lit(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_string_interp: expr => emit_py_expr_string_interp(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_block: expr => emit_py_expr_block(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_cast: expr => emit_py_expr_cast(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_for_each: expr => emit_py_expr_for_each(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_index: expr => emit_py_expr_index(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_slice: expr => emit_py_expr_slice(expr: expr, registry: registry, scope: scope, depth: depth),
    emit_bin_op: expr => emit_default_bin_op(texpr: expr, target: Python, source_index: scope.type_env.source_index, recurse: child => emit_py_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: fuel - 1), wrap_result: result => result))
}

fn emit_py_typed_call(func: String, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_call_unified(func: func, args: args, target: Python, registry: registry, scope: scope,
    recurse: n => emit_py_typed_expr(texpr: n, registry: registry, scope: scope, depth: depth, fuel: 1024))
}

fn emit_py_typed_method_call(receiver: Node, method: String, args: List<Node>, method_semantics: MethodSemantics?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_method_call_unified(receiver: receiver, method: method, args: args, method_semantics: method_semantics, target: Python, registry: registry, scope: scope, depth: depth,
    recurse: n => emit_py_typed_expr(texpr: n, registry: registry, scope: scope, depth: depth, fuel: 1024))
}


fn emit_py_typed_match(scrutinee: Node, arms: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let scrut_str = emit_py_typed_expr(texpr: scrutinee, registry: registry, scope: scope, depth: depth, fuel: 1024)
  emit_typed_match_unified(scrutinee_str: scrut_str, arms: arms, target: Python, depth: depth, source_index: scope.type_env.source_index,
    recurse: (node, d) => emit_py_typed_expr(texpr: node, registry: registry, scope: scope, depth: d, fuel: 1024),
    render_pattern: pat => emit_py_pattern(pattern: pat, source_index: scope.type_env.source_index))
}

fn emit_py_typed_if(condition: Node, then_branch: Node, else_branch: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let cond_str = emit_py_typed_expr(texpr: condition, registry: registry, scope: scope, depth: depth, fuel: 1024)
  emit_typed_if_shared(cond_str: cond_str, then_branch: then_branch, else_branch: else_branch,
    if_result_type: none, depth: depth, target: Python, source_index: scope.type_env.source_index,
    recurse: (node, d) => emit_py_typed_expr(texpr: node, registry: registry, scope: scope, depth: d, fuel: 1024))
}

fn emit_py_typed_let(name: String, value: Node, body: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let val_str = emit_py_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, fuel: 1024)
  emit_typed_let_shared(name: name, value_str: val_str, body: body, target: Python,
    recurse: (bd, sc) => emit_py_typed_expr(texpr: bd, registry: registry, scope: sc, depth: depth, fuel: 1024),
    scope: scope, value_node: value)
}

fn emit_py_typed_record_lit(type_name: String?, fields: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_record_lit_unified(type_name: type_name, fields: fields, target: Python, source_index: scope.type_env.source_index,
    recurse: n => emit_py_typed_expr(texpr: n, registry: registry, scope: scope, depth: depth, fuel: 1024))
}



fn emit_py_typed_string_interp(parts: List<StringPart>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_string_interp_unified(parts: parts, target: Python,
    recurse: e => emit_py_typed_expr(texpr: e, registry: registry, scope: scope, depth: depth, fuel: 1024))
}

fn emit_py_typed_block(stmts: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_block_join(stmts: stmts, scope: scope, depth: depth,
    emit_block_stmts: (s, sc, d) => emit_py_block_stmts(remaining: s, text: [], scope: sc, registry: registry, depth: d))
}

// =========================================================================
// Node func body -- async def body emission using Node.expr_data.
// =========================================================================

fn emit_py_typed_func_body(body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let si = scope.type_env.source_index
  match body.expr_data {
    ExprLet => {
      let n = let_binding_name_at(texpr: body, source_index: si)
      let ch = body.children
      let v = let_value(texpr: body)
      let inner = let_body(texpr: body)
      let val_str = emit_py_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, fuel: 1024)
      let let_line = emit_let_binding(name: n, value: val_str, target: Python)
      let next_scope = extend_scope(scope: scope, name: n, resolved: resolved_type(n: v), provenance: SubValueUnknown)
      match inner {
        Some { value: bd } =>
          concat(let_line, "\n", emit_py_typed_func_body(body: bd, registry: registry, scope: next_scope, depth: depth))
        None => let_line
      }
    }
    ExprBlock => {
      let ss = body.children
      if ss |> count == 0 {
        "return None"
      } else {
        let init_state = emit_py_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth)
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Some { value: s } => concat("return ", emit_py_typed_expr(texpr: s, registry: registry, scope: init_state.scope, depth: depth, fuel: 1024))
          None => "return None"
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    }
    _ => concat("return ", emit_py_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth, fuel: 1024))
  }
}

// =========================================================================
// Node TCO -- Python rendering
//
// TCO functions that work on Node.expr_data,
// reading inferred from sub-expressions instead of cache lookups.
// =========================================================================

fn emit_py_typed_tco_body(texpr: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let inner = emit_py_typed_tco_expr(texpr: texpr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1)
  shared_tco_body(inner: inner, depth: depth, spec: language_spec(target: Python))
}

fn emit_py_tco_non_self_call(frame: TcoFrame, registry: Map<String, ItemInfo>) -> String {
  shared_tco_non_self_call(
    frame: frame,
    target: Python,
    spec: language_spec(target: Python),
    recurse_call: (f, args, scope, depth) => emit_py_typed_call(func: f, args: args, registry: registry, scope: scope, depth: depth))
}

fn emit_py_tco_if(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>) -> String {
  shared_tco_if(
    frame: frame,
    fn_name: fn_name,
    params: params,
    target: Python,
    spec: language_spec(target: Python),
    recurse_expr: (expr, scope, depth) => emit_py_typed_expr(texpr: expr, registry: registry, scope: scope, depth: depth, fuel: 1024),
    recurse_tco: (expr, scope, depth) => emit_py_typed_tco_expr(texpr: expr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth))
}

fn emit_py_tco_match(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>) -> String {
  match frame.expr.expr_data {
    ExprMatch =>
      let s = match_scrutinee(texpr: frame.expr)
      let arm_list = match_arm_nodes(texpr: frame.expr)
      let scrut_str = emit_py_typed_expr(texpr: s, registry: registry, scope: frame.scope, depth: frame.depth, fuel: 1024)
      let arm_strs = arm_list |> map(arm =>
        emit_py_typed_tco_match_arm(arm: arm, fn_name: fn_name, params: params, registry: registry, scope: frame.scope, depth: frame.depth))
      let arms_str = arm_strs |> join(separator: "\n")
      let bs = language_spec(target: Python).block_syntax
      concat(bs.match_keyword, scrut_str, bs.block_open, arms_str)
    _ => emit_error_expr(message: "emit_py_tco_match expected ExprMatch", target: Python)
  }
}

fn emit_py_tco_let(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>) -> String {
  shared_tco_let(
    frame: frame,
    fn_name: fn_name,
    params: params,
    target: Python,
    recurse_expr: (expr, scope, depth) => emit_py_typed_expr(texpr: expr, registry: registry, scope: scope, depth: depth, fuel: 1024),
    recurse_tco: (expr, scope, depth) => emit_py_typed_tco_expr(texpr: expr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth))
}

fn emit_py_tco_block(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>) -> String {
  shared_tco_block(
    frame: frame,
    fn_name: fn_name,
    params: params,
    target: Python,
    spec: language_spec(target: Python),
    emit_init_stmts: (stmts, scope, depth) => emit_py_init_block_stmts(remaining: stmts, text: [], scope: scope, registry: registry, depth: depth),
    recurse_tco: (expr, scope, depth) => emit_py_typed_tco_expr(texpr: expr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth))
}

fn emit_py_tco_default_return(frame: TcoFrame, registry: Map<String, ItemInfo>) -> String {
  shared_tco_default_return(
    frame: frame,
    spec: language_spec(target: Python),
    recurse_expr: (expr, scope, depth) => emit_py_typed_expr(texpr: expr, registry: registry, scope: scope, depth: depth, fuel: 1024))
}

fn emit_py_typed_tco_expr(texpr: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_shared_tco_expr(
    frame: TcoFrame { expr: texpr, scope: scope, depth: depth },
    fn_name: fn_name,
    emit_self_call_reassign: input => emit_py_typed_tco_reassign(args: input.args, params: params, registry: registry, scope: input.scope, depth: input.depth),
    emit_non_self_call: frame => emit_py_tco_non_self_call(frame: frame, registry: registry),
    emit_if: frame => emit_py_tco_if(frame: frame, fn_name: fn_name, params: params, registry: registry),
    emit_match: frame => emit_py_tco_match(frame: frame, fn_name: fn_name, params: params, registry: registry),
    emit_let: frame => emit_py_tco_let(frame: frame, fn_name: fn_name, params: params, registry: registry),
    emit_block: frame => emit_py_tco_block(frame: frame, fn_name: fn_name, params: params, registry: registry),
    emit_default_return: frame => emit_py_tco_default_return(frame: frame, registry: registry))
}

fn emit_py_typed_tco_match_arm(arm: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  let bs = language_spec(target: Python).block_syntax
  let pat_str = emit_py_pattern(pattern: arm_pattern(n: arm), source_index: scope.type_env.source_index)
  let guard_str = match arm_guard(n: arm) {
    Some { value: g } => concat(" if ", emit_py_typed_expr(texpr: g, registry: registry, scope: scope, depth: depth, fuel: 1024))
    None => ""
  }
  let body_str = emit_py_typed_tco_expr(texpr: arm_body(n: arm), fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 2)
  concat(make_indent(level: depth + 1), bs.case_keyword, pat_str, guard_str, bs.block_open,
    make_indent(level: depth + 2), body_str)
}

fn emit_py_typed_tco_reassign(args: List<Node>, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int) -> String {
  emit_typed_tco_reassign_shared(args: args, params: params, target: Python,
    recurse: child => emit_py_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, fuel: 1024),
    source_index: scope.type_env.source_index)
}

// =========================================================================
// Service definition emission
//
// Each service becomes a class with:
//   - __init__ with config
//   - One async method per operation
//   - aiohttp for REST transport
// =========================================================================

fn emit_py_service_def(
  item: Node,
  registry: Map<String, ItemInfo>,
  env: TypeEnv
) -> String {
  let depth = 0
  let safe_name = sanitize_service_name(name: authored_name(env: env, node: item))
  let transport = service_fallback_transport(item: item)
  let op_children = item.children
  let init_method = emit_py_service_init(fallback_transport: transport, op_children: op_children, source_index: env.source_index)
  let methods = op_children |> map(op_node =>
    emit_py_operation_method(service_name: safe_name, transport: transport, op_node: op_node, registry: registry, depth: depth + 1, env: env)
  )
  let methods_str = methods |> join(separator: "\n\n")
  concat(language_spec(target: Python).items.struct_keyword, " ", safe_name, ":\n",
    make_indent(level: depth + 1), init_method, "\n\n",
    make_indent(level: depth + 1), methods_str)
}

fn emit_py_service_init(fallback_transport: Node, op_children: List<Node>, source_index: NewlineIndex?) -> String {
  let fs = compute_service_fields(fallback_transport: fallback_transport, op_children: op_children, source_index: source_index)
  let params = service_field_decls(fs: fs, t: language_spec(target: Python).service_fields)
  let assigns = service_field_ctors(fs: fs, t: language_spec(target: Python).service_fields)
  if params |> count == 0 {
    "def __init__(self):\n    pass"
  } else {
    let params_str = concat("self, ", params |> join(separator: ", "))
    let assigns_str = assigns |> map(a => concat("    ", a)) |> join(separator: "\n")
    concat("def __init__(", params_str, "):\n", assigns_str)
  }
}

fn emit_py_operation_method(service_name: String, transport: Node, op_node: Node, registry: Map<String, ItemInfo>, depth: Int, env: TypeEnv) -> String {
  let op_text = authored_name(env: env, node: op_node)
  let input_params = op_node.params |> map(p =>
    concat(emit_ident(name: param_node_name_at(n: p, source_index: env.source_index), target: Python), ": ", emit_node_type(n: param_node_type_expr(n: p), target: Python, source_index: env.source_index))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "self"
  } else {
    concat("self, ", params_str)
  }
  let ret_type = emit_node_type(n: resolved_type(n: op_node), target: Python, source_index: env.source_index)
  let eff_transport = effective_operation_transport(op_node: op_node, fallback: transport)
  let body = emit_py_transport_call(transport: eff_transport, op_name: op_text, registry: registry, source_index: env.source_index)
  let items = language_spec(target: Python).items
  concat(items.async_prefix, items.func_keyword, " ", emit_ident(name: op_text, target: Python),
    "(", all_params, ") -> ", ret_type, ":\n",
    make_indent(level: depth + 1), body)
}

fn emit_py_transport_call(transport: Node, op_name: String, registry: Map<String, ItemInfo>, source_index: NewlineIndex?) -> String {
  if is_rest_transport(t: transport, source_index: source_index) { emit_py_rest_call(op_name: op_name, transport: transport, source_index: source_index) }
  else if is_shell_transport(t: transport) { emit_py_shell_call(op_name: op_name, transport: transport, source_index: source_index) }
  else if is_file_transport(t: transport, source_index: source_index) { emit_py_file_call(op_name: op_name) }
  else { emit_py_local_call(op_name: op_name) }
}

fn emit_py_rest_call(op_name: String, transport: Node, source_index: NewlineIndex?) -> String {
  let self_base_url = concat("{", "self.base_url", "}")
  let url_line = concat("url = f\"", self_base_url, "/", emit_ident(name: op_name, target: Python), "\"")
  let headers_dict = emit_py_headers_dict(transport: transport, source_index: source_index)
  let session_lines = concat(
    "async with aiohttp.ClientSession() as session:\n",
    "    async with session.post(url, headers=headers) as response:\n",
    "        return await response.json()"
  )
  concat(url_line, "\n", headers_dict, "\n", session_lines)
}

fn emit_py_headers_dict(transport: Node, source_index: NewlineIndex?) -> String {
  let auth_entry = if transport_has_auth(t: transport, source_index: source_index) {
    let header_name = match transport_auth_header_name(t: transport, source_index: source_index) {
      Some { value: h } => h
      None => "Authorization"
    }
    concat("\"", header_name, "\": self.auth_token, ")
  } else { "" }
  let hdrs = transport_headers(t: transport, source_index: source_index)
  let header_entries = hdrs |> map(h =>
    concat("\"", h.name, "\": ", emit_simple_expr(expr: field_init_node_value(n: h), target: Python, source_index: source_index))
  )
  let all_entries = if auth_entry == "" {
    header_entries |> join(separator: ", ")
  } else {
    concat(auth_entry, header_entries |> join(separator: ", "))
  }
  concat("headers = {", all_entries, "}")
}

fn emit_py_shell_call(op_name: String, transport: Node, source_index: NewlineIndex?) -> String {
  let envs = transport_env(t: transport, source_index: source_index)
  let env_dict_entries = envs |> map(e =>
    concat("\"", e.name, "\": ", emit_simple_expr(expr: field_init_node_value(n: e), target: Python, source_index: source_index))
  )
  let env_str = concat("{", env_dict_entries |> join(separator: ", "), "}")
  concat(
    "import subprocess\n",
    "result = subprocess.run(\n",
    "    [\"", emit_ident(name: op_name, target: Python), "\"],\n",
    "    cwd=self.working_dir or \".\",\n",
    "    env=", env_str, ",\n",
    "    capture_output=True, text=True,\n",
    ")\n",
    "return result.stdout"
  )
}

fn emit_py_file_call(op_name: String) -> String {
  let self_base_path = concat("{", "self.base_path", "}")
  concat(
    "path = f\"", self_base_path, "/", emit_ident(name: op_name, target: Python), "\"\n",
    "with open(path) as f:\n",
    "    return f.read()"
  )
}

fn emit_py_local_call(op_name: String) -> String {
  concat("# Local binding -- direct function call\n",
    "return ", emit_ident(name: op_name, target: Python), "()")
}

// =========================================================================
// Resource definition emission
//
// Resources become abstract base classes with abstract methods.
// =========================================================================

fn emit_py_resource_def(item: Node, env: TypeEnv) -> String {
  let item_text = authored_name(env: env, node: item)
  let depth = 0
  let cap_children = item.children
  let methods = cap_children |> map(c => emit_py_capability_method(cap_node: c, env: env))
  let methods_str = methods |> join(separator: "\n\n")
  concat("from abc import ABC, abstractmethod\n\n",
    language_spec(target: Python).items.struct_keyword, " ", item_text, "(ABC):\n",
    make_indent(level: depth + 1), methods_str)
}

fn emit_py_capability_method(cap_node: Node, env: TypeEnv) -> String {
  let input_params = cap_node.params |> map(p =>
    concat(emit_ident(name: param_node_name_at(n: p, source_index: env.source_index), target: Python), ": ", emit_node_type(n: param_node_type_expr(n: p), target: Python, source_index: env.source_index))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "self"
  } else {
    concat("self, ", params_str)
  }
  let ret = emit_node_type(n: resolved_type(n: cap_node), target: Python, source_index: env.source_index)
  concat("@abstractmethod\n",
    language_spec(target: Python).items.async_prefix, language_spec(target: Python).items.func_keyword, " ", emit_ident(name: authored_name(env: env, node: cap_node), target: Python), "(", all_params, ") -> ", ret, ":\n",
    "    ...")
}

// =========================================================================
// Data definition emission
//
// data name: Type = value  ->  module-level constant
// =========================================================================

fn emit_py_data_def(name: String, type_node: Node, value: Node, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ty_str = emit_node_type(n: type_node, target: Python, source_index: scope.type_env.source_index)
  let upper_name = to_screaming_snake(name: name)
  let val_str = emit_py_typed_expr(texpr: value, registry: registry, scope: scope, depth: 0, fuel: 1024)
  concat(upper_name, ": ", ty_str, " = ", val_str)
}

// =========================================================================
// Identifier conversion -- Python target
// =========================================================================

// Convert a DSL identifier to a valid Python identifier.
// Handles reserved word collision by appending underscore suffix.
// Identifier rendering now uses shared emit_ident (05_emit.dag).

// =========================================================================
// requirements.txt emission
// =========================================================================

fn emit_requirements_txt(has_services: Bool) -> TextFile {
  let base_deps = ""
  let async_deps = if has_services {
    "aiohttp>=3.9\n"
  } else {
    ""
  }
  TextFile { path: "requirements.txt", content: concat(base_deps, async_deps) }
}

// has_service_items and is_service_item are now shared -- imported from v2.compiler.emit
