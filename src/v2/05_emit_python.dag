// v2 Python renderer — emits Python source files from a typed module graph.
//
// This module contains all Python-specific rendering logic: dataclasses,
// type hints, match/case (PEP 634), f-strings, aiohttp for services,
// Python-idiomatic naming (snake_case functions, PascalCase classes).
//
// Target-agnostic helpers (scope management, item registry, name
// conversion, indent, service call collection) live in 05_emit.dag.
//
// Invariant 6: "DAG nodes are facts, rendering is separate."
// This file IS the Python rendering. No IR changes needed.

module v2.compiler.emit_python

import v2.std.core {
  Import, ImportAll, ImportSpecific,
  Node, TypedNode,
  Connective, Conj, Disj,
  TypeExpr, Field, Variant, Param, Expr, MatchArm,
  MatchPattern, FieldBinding, LiteralValue, TransportBinding,
  TextFile, Diagnostic, SourceSpan,
  ContainerKind, ResourceUse,
  BinOpKind, NullCoalesce,
  UnaryOpKind, StringPart, NamedArg, FieldInit,
  ServiceConfig, AuthConfig, HeaderDef, EnvDef,
  ForEach, Index, Slice,
  FuncSig,
  TypedExpr, TypedLet, typed_expr_to_expr
}

import v2.compiler.typecheck {
  TypedGraph, TypedModule,
  TypeEnv, FuncEnv, TypeBinding, InferScope,
  build_params_scope, extend_scope,
  for_each_element_type,
  expr_span
}

import v2.compiler.emit {
  EmitResult, BlockEmitState, ItemInfo, InterpPart,
  empty_emit_scope, module_emit_scope,
  build_item_registry, lookup_item, named_arg_matches, order_call_args,
  is_service_call_receiver, extract_service_name,
  collect_service_calls, collect_service_calls_from_args, unique_strings,
  has_nested_records, emit_data_value_json, escape_json_string,
  module_to_filename,
  indent, make_indent, to_string, to_string_helper,
  to_snake, to_screaming_snake, is_upper, to_lower_char, to_upper_char,
  capitalize_first, sanitize_service_name, service_var_name,
  expr_has_self_call, has_non_tail_self_call
}

// =========================================================================
// Local scope helpers — span-based cache lookup for Expr-level code paths.
// These replicate the old shared helpers (removed from 05_emit.dag when
// scope_after_expr migrated to TypedExpr). They will be removed once the
// Python emitter's internal functions accept TypedExpr directly.
// =========================================================================

fn py_span_key(start: Int, end: Int) -> String {
  concat(to_string(value: start), ":", to_string(value: end))
}

fn py_infer_expr_type(expr: Expr, scope: InferScope) -> TypeExpr {
  let s = expr_span(expr: expr)
  let key = py_span_key(start: s.start, end: s.end)
  match map_get(scope.type_cache, key) {
    Some { value: t } => t
    None => Named { name: "__EmitTypeCacheMiss", span: s }
  }
}

fn py_scope_after_expr(expr: Expr, scope: InferScope) -> InferScope {
  match expr {
    Let { name: name, value: value, body: body, span: _ } =>
      if body == none {
        extend_scope(scope: scope, name: name, resolved: py_infer_expr_type(expr: value, scope: scope))
      } else {
        scope
      }
    _ => scope
  }
}

// =========================================================================
// Python reserved words — identifiers that need underscore suffix
// =========================================================================

data python_reserved: List<String> = [
  "False", "None", "True", "and", "as", "assert", "async", "await",
  "break", "class", "continue", "def", "del", "elif", "else",
  "except", "finally", "for", "from", "global", "if", "import",
  "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise",
  "return", "try", "while", "with", "yield",
  "type", "match", "case"
]

// =========================================================================
// Entry point — Python target
// =========================================================================

fn emit_python(typed: TypedGraph) -> EmitResult {
  let all_items = typed.modules |> flat_map(tm => tm.items)
  let registry = build_item_registry(items: all_items)
  let module_files = typed.modules |> map(tm => emit_py_module(typed_module: tm, registry: registry))
  let init_file = emit_init_py(modules: typed.modules)
  let requirements = emit_requirements_txt(has_services: has_py_service_items(typed: typed))
  let files = concat([requirements, init_file], module_files)
  EmitResult { files: files, diagnostics: [] }
}

// =========================================================================
// __init__.py generation
// =========================================================================

fn emit_init_py(modules: List<TypedModule>) -> TextFile {
  let import_lines = modules |> map(tm =>
    let mod_name = module_to_filename(name: tm.module.name)
    concat("from . import ", mod_name)
  )
  let content = concat("# Generated by v2 compiler — do not edit.\n\n",
    import_lines |> join(separator: "\n"), "\n")
  TextFile { path: "__init__.py", content: content }
}

// =========================================================================
// Module emission
// =========================================================================

fn emit_py_module(typed_module: TypedModule, registry: Map<String, ItemInfo>) -> TextFile {
  let m = typed_module.module
  let scope = module_emit_scope(typed_module: typed_module)
  let prelude = emit_py_prelude(typed_module: typed_module)
  let imports_str = emit_py_imports(imports: m.imports)
  let imports_section = if imports_str == "" { "" } else { concat("\n", imports_str) }
  let items_str = typed_module.items
    |> map(item => emit_py_typed_item(item: item, registry: registry, scope: scope))
    |> join(separator: "\n\n\n")
  let filename = module_to_filename(name: m.name)
  let content = concat("# Generated by v2 compiler — do not edit.\n",
    "# Source module: ", m.name, "\n\n",
    prelude, imports_section, "\n\n\n",
    items_str, "\n")
  TextFile { path: concat(filename, ".py"), content: content }
}

// =========================================================================
// Import emission
// =========================================================================

fn emit_py_imports(imports: List<Import>) -> String {
  if imports |> count == 0 {
    ""
  } else {
    let import_lines = imports |> map(imp =>
      let mod_name = module_to_filename(name: imp.module_path)
      match imp.names {
        ImportAll => concat("from ", mod_name, " import *")
        ImportSpecific { names: specific_names } =>
          if specific_names |> count == 0 {
            ""
          } else {
            let names_str = specific_names |> join(separator: ", ")
            concat("from ", mod_name, " import ", names_str)
          }
      }
    )
    import_lines |> filter(line => line != "") |> join(separator: "\n")
  }
}

// =========================================================================
// Prelude — standard imports for Python modules
// =========================================================================

fn emit_py_prelude(typed_module: TypedModule) -> String {
  let base_imports = concat(
    "from __future__ import annotations\n",
    "from dataclasses import dataclass, field\n",
    "from enum import Enum, auto\n",
    "from typing import Optional, Union\n"
  )
  let has_services = typed_module.items |> any(item => is_py_typed_service_item(item: item))
  let async_imports = if has_services {
    "import aiohttp\n"
  } else {
    ""
  }
  concat(base_imports, async_imports)
}

// =========================================================================
// Item dispatch
// =========================================================================

fn emit_py_typed_item(item: TypedNode, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  // Type definition: has connective (record=Conj, sum=Disj)
  if item.connective != none && item.transport == none {
    emit_py_type_def_from_connective(item: item)
  }
  // Type alias: no connective, no body, no params, no transport, no children, but has return_type
  else if item.connective == none && item.body == none && item.params |> count == 0 && item.transport == none && item.children |> count == 0 && is_py_type_alias_return(return_type: item.return_type) {
    concat(item.name, " = ", emit_py_type_expr(type_expr: item.return_type))
  }
  else if item.body != none && item.type_annotation == none {
    if item.uses |> count > 0 {
      emit_py_func_def(name: item.name, params: item.params, return_type: item.return_type, uses: item.uses, body: typed_expr_to_expr(texpr: item.body.value), registry: registry, scope: scope)
    } else {
      emit_py_fn_def(name: item.name, params: item.params, return_type: item.return_type, body: typed_expr_to_expr(texpr: item.body.value), registry: registry, scope: scope)
    }
  }
  else if item.body != none && item.type_annotation != none {
    emit_py_data_def(name: item.name, type_expr: item.type_annotation.value, value: typed_expr_to_expr(texpr: item.body.value), registry: registry, scope: scope)
  }
  else if item.transport != none && item.children |> count > 0 {
    emit_py_service_def(item: item, registry: registry)
  }
  else if item.transport == none && item.children |> count > 0 {
    emit_py_resource_def(item: item)
  }
  else if item.params |> count > 0 {
    let params_str = emit_py_params(params: item.params)
    let ret_str = emit_py_return_type(return_type: item.return_type)
    concat("def ", py_ident(name: item.name), "(", params_str, ")", ret_str, ":\n",
      "    raise NotImplementedError(\"extern func\")")
  }
  else {
    concat("# unhandled node: ", item.name)
  }
}

// =========================================================================
// Connective-based type emission — dispatches on TypedNode children
//
// Type structure is encoded as:
//   Records: connective=Conj, children = one TypedNode per field
//   Sums:    connective=Disj, children = one TypedNode per variant
//   Aliases: connective=none, return_type carries the aliased type
// =========================================================================

fn emit_py_type_def_from_connective(item: TypedNode) -> String {
  match item.connective.value {
    Conj => emit_py_dataclass_from_children(name: item.name, children: item.children)
    Disj => emit_py_enum_from_children(name: item.name, children: item.children)
  }
}

fn is_py_type_alias_return(return_type: TypeExpr) -> Bool {
  match return_type {
    Primitive { name: n, span: _ } => n != "Unit"
    Named { name: _, span: _ } => true
    Container { kind: _, element: _, span: _ } => true
    Optional { inner: _, span: _ } => true
    MapType { key: _, value: _, span: _ } => true
    Product { name: _, fields: _, span: _ } => true
    Coproduct { name: _, variants: _, span: _ } => true
    Refined { base: _, predicates: _, span: _ } => true
  }
}

fn emit_py_dataclass_from_children(name: String, children: List<TypedNode>) -> String {
  if children |> count == 0 {
    concat("@dataclass\nclass ", name, ":\n    pass")
  } else {
    let field_lines = children |> map(child => emit_py_dataclass_field_from_child(child: child))
    let fields_str = field_lines |> join(separator: "\n")
    concat("@dataclass\nclass ", name, ":\n", fields_str)
  }
}

fn emit_py_dataclass_field_from_child(child: TypedNode) -> String {
  let ty = emit_py_type_expr(type_expr: child.return_type)
  let is_optional = is_py_optional_type(type_expr: child.return_type)
  let default_str = if is_optional {
    " = None"
  } else {
    ""
  }
  concat("    ", py_ident(name: child.name), ": ", ty, default_str)
}

fn is_py_optional_type(type_expr: TypeExpr) -> Bool {
  match type_expr {
    Optional { inner: _, span: _ } => true
    _ => false
  }
}

fn emit_py_enum_from_children(name: String, children: List<TypedNode>) -> String {
  let has_data = children |> any(child => child.children |> count > 0)
  if has_data {
    // Tagged union: emit as a set of dataclasses + a Union type alias
    let variant_classes = children |> map(child => emit_py_variant_class_from_child(parent_name: name, child: child))
    let variant_names = children |> map(child => concat(name, child.name))
    let union_str = variant_names |> join(separator: ", ")
    let classes_str = variant_classes |> join(separator: "\n\n\n")
    concat(classes_str, "\n\n\n", name, " = Union[", union_str, "]")
  } else {
    // Simple enum: all unit variants
    let variant_lines = children |> map(child =>
      concat("    ", child.name, " = auto()")
    )
    let variants_str = variant_lines |> join(separator: "\n")
    concat("class ", name, "(Enum):\n", variants_str)
  }
}

fn emit_py_variant_class_from_child(parent_name: String, child: TypedNode) -> String {
  let class_name = concat(parent_name, child.name)
  if child.children |> count == 0 {
    concat("@dataclass\nclass ", class_name, ":\n    pass")
  } else {
    let field_lines = child.children |> map(f => emit_py_dataclass_field_from_child(child: f))
    let fields_str = field_lines |> join(separator: "\n")
    concat("@dataclass\nclass ", class_name, ":\n", fields_str)
  }
}

// =========================================================================
// Type expression emission
// =========================================================================

fn emit_py_type_expr(type_expr: TypeExpr) -> String {
  match type_expr {
    Primitive { name: n, span: _ } => emit_py_primitive_type(name: n)
    Named { name: n, span: _ } => n
    Container { kind: k, element: el, span: _ } =>
      emit_py_container_type(kind: k, element: el)
    Optional { inner: inn, span: _ } =>
      concat("Optional[", emit_py_type_expr(type_expr: inn), "]")
    MapType { key: k, value: v, span: _ } =>
      concat("dict[", emit_py_type_expr(type_expr: k), ", ", emit_py_type_expr(type_expr: v), "]")
    Product { name: pn, fields: fs, span: _ } =>
      emit_py_product_type_expr(name: pn, fields: fs)
    Coproduct { name: cn, variants: vs, span: _ } =>
      emit_py_coproduct_type_expr(name: cn, variants: vs)
    Refined { base: b, predicates: _, span: _ } =>
      // Refinements are erased at the Python level — just emit the base type
      emit_py_type_expr(type_expr: b)
  }
}

fn emit_py_primitive_type(name: String) -> String {
  if name == "String" { "str" }
  else if name == "Int" { "int" }
  else if name == "Bool" { "bool" }
  else if name == "Float" { "float" }
  else if name == "Secret" { "str" }
  else if name == "Json" { "dict" }
  else if name == "Unit" { "None" }
  else if name == "Bytes" { "bytes" }
  else { name }
}

fn emit_py_container_type(kind: ContainerKind, element: TypeExpr) -> String {
  let inner = emit_py_type_expr(type_expr: element)
  match kind {
    List => concat("list[", inner, "]")
    Set => concat("set[", inner, "]")
    NonEmptyList => concat("list[", inner, "]")
    NonEmptySet => concat("set[", inner, "]")
  }
}

fn emit_py_product_type_expr(name: String?, fields: List<Field>) -> String {
  match name {
    Some { value: n } => n
    None => {
      if fields |> count == 1 {
        match fields |> first {
          Some { value: f } => emit_py_type_expr(type_expr: f.type_expr)
          None => "dict"
        }
      } else {
        "dict"
      }
    }
  }
}

fn emit_py_coproduct_type_expr(name: String?, variants: List<Variant>) -> String {
  match name {
    Some { value: n } => n
    None => "dict"
  }
}

// =========================================================================
// Pure function (fn) emission
// =========================================================================

fn emit_py_fn_def(name: String, params: List<Param>, return_type: TypeExpr, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let params_str = emit_py_params(params: params)
  let ret_str = emit_py_return_type(return_type: return_type)
  let body_scope = build_params_scope(scope: scope, params: params)
  // Tail-call optimization: use cached analysis from item registry.
  let use_tco = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.is_self_recursive && info.has_non_tail_self_call == false
    None => expr_has_self_call(expr: body, fn_name: name)
      && has_non_tail_self_call(expr: body, fn_name: name, in_tail: true) == false
  }
  if use_tco {
    let body_str = emit_py_tco_body(expr: body, fn_name: name, params: params, registry: registry, scope: body_scope)
    concat("def ", py_ident(name: name), "(", params_str, ")", ret_str, ":\n",
      indent(text: body_str, level: 1))
  } else {
    let body_str = emit_py_expr_in_scope(expr: body, registry: registry, scope: body_scope)
    concat("def ", py_ident(name: name), "(", params_str, ")", ret_str, ":\n",
      indent(text: concat("return ", body_str), level: 1))
  }
}

// =========================================================================
// Workflow function (func) emission — async def
// =========================================================================

fn emit_py_func_def(
  name: String,
  params: List<Param>,
  return_type: TypeExpr,
  uses: List<ResourceUse>,
  body: Expr,
  registry: Map<String, ItemInfo>,
  scope: InferScope
) -> String {
  let service_names = match lookup_item(registry: registry, name: name) {
    Some { value: info } => info.service_names
    None => unique_strings(items: collect_service_calls(expr: body))
  }
  let params_str = emit_py_func_params(params: params, uses: uses, service_names: service_names)
  let ret_str = emit_py_return_type(return_type: return_type)
  let body_scope = build_params_scope(scope: scope, params: params)
  let body_str = emit_py_func_body(body: body, registry: registry, scope: body_scope)
  concat("async def ", py_ident(name: name), "(", params_str, ")", ret_str, ":\n",
    indent(text: body_str, level: 1))
}

fn emit_py_func_body(body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match body {
    Let { name: n, value: v, body: inner, span: _ } => {
      let val_str = emit_py_expr_in_scope(expr: v, registry: registry, scope: scope)
      let let_line = concat(py_ident(name: n), " = ", val_str)
      let next_scope = extend_scope(scope: scope, name: n, resolved: py_infer_expr_type(expr: v, scope: scope))
      match inner {
        Some { value: bd } =>
          concat(let_line, "\n", emit_py_func_body(body: bd, registry: registry, scope: next_scope))
        None => let_line
      }
    }
    Block { stmts: ss, span: _ } => {
      if ss |> count == 0 {
        "return None"
      } else {
        let init_state = ss |> enumerate
          |> filter(p => p.first < (ss |> count) - 1)
          |> fold(init: BlockEmitState { text: "", scope: scope }, f: fn(acc, pair) {
            let line = emit_py_expr_in_scope(expr: pair.second, registry: registry, scope: acc.scope)
            let next_scope = py_scope_after_expr(expr: pair.second, scope: acc.scope)
            let new_text = if acc.text == "" { line } else { concat(acc.text, "\n", line) }
            BlockEmitState { text: new_text, scope: next_scope }
          })
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Some { value: s } => concat("return ", emit_py_expr_in_scope(expr: s, registry: registry, scope: init_state.scope))
          None => "return None"
        }
        if init_state.text == "" { last_str } else { concat(init_state.text, "\n", last_str) }
      }
    }
    _ => concat("return ", emit_py_expr_in_scope(expr: body, registry: registry, scope: scope))
  }
}

fn emit_py_func_params(params: List<Param>, uses: List<ResourceUse>, service_names: List<String>) -> String {
  let param_strs = params |> map(p => emit_py_param(param: p))
  let resource_strs = uses |> map(u =>
    concat(py_ident(name: u.name), ": ", emit_py_type_expr(type_expr: u.resource))
  )
  let service_strs = service_names |> map(sn =>
    concat(service_var_name(service_name: sn), ": ", sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

// =========================================================================
// Parameter emission
// =========================================================================

fn emit_py_params(params: List<Param>) -> String {
  let strs = params |> map(p => emit_py_param(param: p))
  strs |> join(separator: ", ")
}

fn emit_py_param(param: Param) -> String {
  let ty = emit_py_type_expr(type_expr: param.type_expr)
  concat(py_ident(name: param.name), ": ", ty)
}

fn emit_py_return_type(return_type: TypeExpr) -> String {
  concat(" -> ", emit_py_type_expr(type_expr: return_type))
}

// =========================================================================
// Tail-Call Optimization (TCO) — Python rendering
//
// When a pure fn body contains self-recursive calls and every self-call
// is in tail position, we emit a while True loop:
//
//   def f(x, y):
//       while True:
//           # ... original body ...
//           # tail call f(a, b) becomes:
//           #   __tco_0 = a; __tco_1 = b; x = __tco_0; y = __tco_1; continue
//           # non-recursive return becomes: return result
//
// Classification (expr_has_self_call, all_self_calls_are_tail) is shared
// and lives in 05_emit.dag. Only the Python-specific rendering is here.
// =========================================================================

// Emit the TCO-transformed body: wrap in while True loop.
fn emit_py_tco_body(expr: Expr, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let inner = emit_py_tco_expr(expr: expr, fn_name: fn_name, params: params, registry: registry, scope: scope)
  concat("while True:\n", indent(text: inner, level: 1))
}

// Emit an expression in Python TCO context: tail calls become reassignment+continue,
// non-recursive results become return.
fn emit_py_tco_expr(expr: Expr, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match expr {
    Call { func: f, args: a, span: _ } =>
      if f == fn_name {
        // Tail self-call: emit temporaries, reassign params, continue.
        emit_py_tco_reassign(args: a, params: params, registry: registry, scope: scope)
      } else {
        // Non-self call in tail position: return result.
        let call_str = emit_py_call(func: f, args: a, registry: registry, scope: scope)
        concat("return ", call_str)
      }
    If { condition: c, then_branch: t, else_branch: e, span: _ } =>
      let cond_str = emit_py_expr_in_scope(expr: c, registry: registry, scope: scope)
      let then_str = emit_py_tco_expr(expr: t, fn_name: fn_name, params: params, registry: registry, scope: scope)
      match e {
        Some { value: eb } =>
          let else_str = emit_py_tco_expr(expr: eb, fn_name: fn_name, params: params, registry: registry, scope: scope)
          concat("if ", cond_str, ":\n",
            indent(text: then_str, level: 1), "\nelse:\n",
            indent(text: else_str, level: 1))
        None =>
          concat("if ", cond_str, ":\n",
            indent(text: then_str, level: 1))
      }
    Match { scrutinee: s, arms: arm_list, span: _ } =>
      let scrut_str = emit_py_expr_in_scope(expr: s, registry: registry, scope: scope)
      let arm_strs = arm_list |> map(arm =>
        emit_py_tco_match_arm(arm: arm, fn_name: fn_name, params: params, registry: registry, scope: scope))
      let arms_str = arm_strs |> join(separator: "\n")
      concat("match ", scrut_str, ":\n", arms_str)
    Let { name: n, value: v, body: bd, span: _ } =>
      let val_str = emit_py_expr_in_scope(expr: v, registry: registry, scope: scope)
      let let_line = concat(py_ident(name: n), " = ", val_str)
      let next_scope = extend_scope(scope: scope, name: n, resolved: py_infer_expr_type(expr: v, scope: scope))
      match bd {
        Some { value: b } =>
          concat(let_line, "\n", emit_py_tco_expr(expr: b, fn_name: fn_name, params: params, registry: registry, scope: next_scope))
        None => let_line
      }
    Block { stmts: ss, span: _ } =>
      if ss |> count == 0 {
        "return None"
      } else {
        let init_state = ss |> enumerate
          |> filter(p => p.first < (ss |> count) - 1)
          |> fold(init: BlockEmitState { text: "", scope: scope }, f: fn(acc, pair) {
            let line = emit_py_expr_in_scope(expr: pair.second, registry: registry, scope: acc.scope)
            let next_scope = py_scope_after_expr(expr: pair.second, scope: acc.scope)
            let new_text = if acc.text == "" { line } else { concat(acc.text, "\n", line) }
            BlockEmitState { text: new_text, scope: next_scope }
          })
        let last_str = match ss |> last {
          Some { value: last_expr } =>
            emit_py_tco_expr(expr: last_expr, fn_name: fn_name, params: params, registry: registry, scope: init_state.scope)
          None => "return None"
        }
        if init_state.text == "" { last_str } else { concat(init_state.text, "\n", last_str) }
      }
    // Any other expression in tail position: not a self-call, so return.
    _ =>
      let val_str = emit_py_expr_in_scope(expr: expr, registry: registry, scope: scope)
      concat("return ", val_str)
  }
}

fn emit_py_tco_match_arm(arm: MatchArm, fn_name: String, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let pat_str = emit_py_pattern(pattern: arm.pattern)
  let guard_str = match arm.guard {
    Some { value: g } => concat(" if ", emit_py_expr_in_scope(expr: g, registry: registry, scope: scope))
    None => ""
  }
  let body_str = emit_py_tco_expr(expr: arm.body, fn_name: fn_name, params: params, registry: registry, scope: scope)
  concat("    case ", pat_str, guard_str, ":\n",
    indent(text: body_str, level: 2))
}

// Emit the reassignment block for a tail self-call in Python:
//   __tco_0 = arg0; __tco_1 = arg1; param0 = __tco_0; param1 = __tco_1; continue
// Temporaries prevent order-dependent assignment issues (e.g., f(b, a)).
fn emit_py_tco_reassign(args: List<NamedArg>, params: List<Param>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ordered_args = args |> map(a => emit_py_expr_in_scope(expr: a.value, registry: registry, scope: scope))
  let param_names = params |> map(p => py_ident(name: p.name))
  let temp_lets = ordered_args |> enumerate |> map(pair =>
    concat("__tco_", to_string(value: pair.first), " = ", pair.second))
  let assigns = param_names |> enumerate |> map(pair =>
    concat(pair.second, " = __tco_", to_string(value: pair.first)))
  let all_lines = concat(temp_lets, assigns, ["continue"])
  all_lines |> join(separator: "\n")
}

// =========================================================================
// Expression emission
// =========================================================================

fn emit_py_expr(expr: Expr, registry: Map<String, ItemInfo>) -> String {
  emit_py_expr_in_scope(expr: expr, registry: registry, scope: empty_emit_scope())
}

fn emit_py_expr_in_scope(expr: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match expr {
    Literal { value: v, span: _ } => emit_py_literal(value: v)
    Var { name: n, span: _ } => py_ident(name: n)
    FieldAccess { base: b, field: f, span: _ } =>
      concat(emit_py_expr_in_scope(expr: b, registry: registry, scope: scope), ".", py_ident(name: f))
    Call { func: f, args: a, span: _ } =>
      emit_py_call(func: f, args: a, registry: registry, scope: scope)
    MethodCall { receiver: r, method: m, args: a, span: _ } =>
      emit_py_method_call(receiver: r, method: m, args: a, registry: registry, scope: scope)
    Match { scrutinee: s, arms: arm_list, span: _ } =>
      emit_py_match(scrutinee: s, arms: arm_list, registry: registry, scope: scope)
    If { condition: c, then_branch: t, else_branch: e, span: _ } =>
      emit_py_if(condition: c, then_branch: t, else_branch: e, registry: registry, scope: scope)
    Let { name: n, value: v, body: bd, span: _ } =>
      emit_py_let(name: n, value: v, body: bd, registry: registry, scope: scope)
    RecordLit { type_name: tn, fields: fs, span: _ } =>
      emit_py_record_lit(type_name: tn, fields: fs, registry: registry, scope: scope)
    ListLit { elements: els, span: _ } =>
      emit_py_list_lit(elements: els, registry: registry, scope: scope)
    BinOp { op: o, left: l, right: r, span: _ } =>
      emit_py_bin_op(op: o, left: l, right: r, registry: registry, scope: scope)
    UnaryOp { op: o, operand: e, span: _ } =>
      emit_py_unary_op(op: o, operand: e, registry: registry, scope: scope)
    Lambda { params: ps, body: bd, span: _ } =>
      emit_py_lambda(params: ps, body: bd, registry: registry, scope: scope)
    StringInterp { parts: ps, span: _ } =>
      emit_py_string_interp(parts: ps, registry: registry, scope: scope)
    Block { stmts: ss, span: _ } =>
      emit_py_block(stmts: ss, registry: registry, scope: scope)
    Cast { expr: e, target: t, span: _ } =>
      emit_py_cast(expr: e, target: t, registry: registry, scope: scope)
    ForEach { variable: v, collection: c, body: bd, span: _ } =>
      emit_py_for_each(variable: v, collection: c, body: bd, registry: registry, scope: scope)
    Index { base: b, index: i, span: _ } =>
      emit_py_index(base: b, index: i, registry: registry, scope: scope)
    Slice { base: b, start: s, end: e, span: _ } =>
      emit_py_slice(base: b, start: s, end: e, registry: registry, scope: scope)
  }
}

// =========================================================================
// Literal emission
// =========================================================================

fn emit_py_literal(value: LiteralValue) -> String {
  match value {
    LitStr { value: s } => emit_py_string_literal(s: s)
    LitInt { value: i } => to_string(value: i)
    LitFloat { value: f } => f
    LitBool { value: b } =>
      if b { "True" } else { "False" }
    LitNull => "None"
  }
}

fn emit_py_string_literal(s: String) -> String {
  let escaped = s
    |> split(delimiter: "\\") |> join(separator: "\\\\")
  let escaped2 = escaped
    |> split(delimiter: "\"") |> join(separator: "\\\"")
  concat("\"", escaped2, "\"")
}

// =========================================================================
// Call emission
// =========================================================================

fn emit_py_call(func: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ordered_args = order_call_args(args: args, func: func, scope: scope)
  let arg_strs = ordered_args |> map(a => emit_py_call_arg(arg: a, registry: registry, scope: scope))
  let callee = lookup_item(registry: registry, name: func)
  let extra_args = match callee {
    Some { value: info } =>
      if info.kind == "func" {
        info.service_names |> map(sn => service_var_name(service_name: sn))
      } else { [] }
    None => []
  }
  let all_args = concat(arg_strs, extra_args)
  let args_str = all_args |> join(separator: ", ")
  let call_str = concat(py_ident(name: func), "(", args_str, ")")
  match callee {
    Some { value: info } =>
      if info.kind == "func" { concat("await ", call_str) } else { call_str }
    None => call_str
  }
}

fn emit_py_call_arg(arg: NamedArg, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  emit_py_expr_in_scope(expr: arg.value, registry: registry, scope: scope)
}

fn emit_py_for_each(variable: String, collection: Expr, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let coll_str = emit_py_expr_in_scope(expr: collection, registry: registry, scope: scope)
  let elem_type = for_each_element_type(type_expr: py_infer_expr_type(expr: collection, scope: scope))
  let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type)
  let body_str = emit_py_expr_in_scope(expr: body, registry: registry, scope: body_scope)
  concat("for ", py_ident(name: variable), " in ", coll_str, ":\n",
    indent(text: body_str, level: 1))
}

fn emit_py_index(base: Expr, index: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let base_str = emit_py_expr_in_scope(expr: base, registry: registry, scope: scope)
  let index_str = emit_py_expr_in_scope(expr: index, registry: registry, scope: scope)
  concat(base_str, "[", index_str, "]")
}

fn emit_py_slice(base: Expr, start: Expr, end: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let base_str = emit_py_expr_in_scope(expr: base, registry: registry, scope: scope)
  let start_str = emit_py_expr_in_scope(expr: start, registry: registry, scope: scope)
  let end_str = emit_py_expr_in_scope(expr: end, registry: registry, scope: scope)
  concat(base_str, "[", start_str, ":", end_str, "]")
}

fn emit_py_method_call(receiver: Expr, method: String, args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  // Service call: git.Core.CurrentBranch() -> await git_core.current_branch()
  if is_service_call_receiver(receiver: receiver) {
    match extract_service_name(receiver: receiver) {
      Some { value: svc_name } => {
        let var_name = service_var_name(service_name: svc_name)
        let arg_strs = args |> map(a => emit_py_call_arg(arg: a, registry: registry, scope: scope))
        let args_str = arg_strs |> join(separator: ", ")
        concat("await ", var_name, ".", py_ident(name: method), "(", args_str, ")")
      }
      None =>
        "raise NotImplementedError(\"unsupported service receiver\")"
    }
  } else {
    let recv_str = emit_py_expr_in_scope(expr: receiver, registry: registry, scope: scope)
    let first_arg_str = emit_py_first_arg(args: args, registry: registry, scope: scope)
    // Map known DSL pipe methods to Python equivalents
    if method == "count" {
      concat("len(", recv_str, ")")
    } else if method == "join" {
      concat(first_arg_str, ".join(", recv_str, ")")
    } else if method == "split" {
      concat(recv_str, ".split(", first_arg_str, ")")
    } else if method == "last" {
      concat(recv_str, "[-1] if ", recv_str, " else None")
    } else if method == "first" {
      concat(recv_str, "[0] if ", recv_str, " else None")
    } else if method == "enumerate" {
      concat("list(enumerate(", recv_str, "))")
    } else if method == "chars" {
      concat("list(", recv_str, ")")
    } else {
      // Generic method call
      let arg_strs = args |> map(a => emit_py_call_arg(arg: a, registry: registry, scope: scope))
      let args_str = arg_strs |> join(separator: ", ")
      concat(recv_str, ".", py_ident(name: method), "(", args_str, ")")
    }
  }
}

fn emit_py_first_arg(args: List<NamedArg>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match args |> first {
    Some { value: a } => emit_py_call_arg(arg: a, registry: registry, scope: scope)
    None => "raise NotImplementedError(\"missing method argument\")"
  }
}

// =========================================================================
// Match emission — Python match/case (PEP 634)
// =========================================================================

fn emit_py_match(scrutinee: Expr, arms: List<MatchArm>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let scrut_str = emit_py_expr_in_scope(expr: scrutinee, registry: registry, scope: scope)
  let arm_strs = arms |> map(arm => emit_py_match_arm(arm: arm, registry: registry, scope: scope))
  let arms_str = arm_strs |> join(separator: "\n")
  concat("match ", scrut_str, ":\n", arms_str)
}

fn emit_py_match_arm(arm: MatchArm, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let pat_str = emit_py_pattern(pattern: arm.pattern)
  let guard_str = match arm.guard {
    Some { value: g } => concat(" if ", emit_py_expr_in_scope(expr: g, registry: registry, scope: scope))
    None => ""
  }
  let body_str = emit_py_expr_in_scope(expr: arm.body, registry: registry, scope: scope)
  concat("    case ", pat_str, guard_str, ":\n",
    indent(text: body_str, level: 2))
}

fn emit_py_pattern(pattern: MatchPattern) -> String {
  match pattern {
    Bind { name: n } => py_ident(name: n)
    LitPattern { value: v } => emit_py_literal(value: v)
    VariantPattern { name: n, field_bindings: fbs } =>
      emit_py_variant_pattern(name: n, field_bindings: fbs)
    Wildcard => "_"
  }
}

fn emit_py_variant_pattern(name: String, field_bindings: List<FieldBinding>) -> String {
  if field_bindings |> count == 0 {
    concat(name, "()")
  } else {
    let binding_strs = field_bindings |> map(fb =>
      let pat_str = emit_py_pattern(pattern: fb.binding)
      concat(py_ident(name: fb.field_name), "=", pat_str)
    )
    let bindings_str = binding_strs |> join(separator: ", ")
    concat(name, "(", bindings_str, ")")
  }
}

// =========================================================================
// If/else emission — Python ternary for expressions
// =========================================================================

fn emit_py_if(condition: Expr, then_branch: Expr, else_branch: Expr?, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let cond_str = emit_py_expr_in_scope(expr: condition, registry: registry, scope: scope)
  let then_str = emit_py_expr_in_scope(expr: then_branch, registry: registry, scope: scope)
  match else_branch {
    Some { value: eb } => {
      let else_str = emit_py_expr_in_scope(expr: eb, registry: registry, scope: scope)
      concat("(", then_str, ") if (", cond_str, ") else (", else_str, ")")
    }
    None =>
      concat("if ", cond_str, ":\n",
        indent(text: then_str, level: 1))
  }
}

// =========================================================================
// Let binding emission
// =========================================================================

fn emit_py_let(name: String, value: Expr, body: Expr?, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let val_str = emit_py_expr_in_scope(expr: value, registry: registry, scope: scope)
  let let_line = concat(py_ident(name: name), " = ", val_str)
  match body {
    Some { value: bd } =>
      let next_scope = extend_scope(scope: scope, name: name, resolved: py_infer_expr_type(expr: value, scope: scope))
      concat(let_line, "\n", emit_py_expr_in_scope(expr: bd, registry: registry, scope: next_scope))
    None => let_line
  }
}

// =========================================================================
// Record literal emission
// =========================================================================

fn emit_py_record_lit(type_name: String?, fields: List<FieldInit>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match type_name {
    None => {
      // Anonymous record -> dict literal
      if fields |> count == 0 {
        "{}"
      } else {
        let field_strs = fields |> map(f =>
          concat("    \"", f.name, "\": ", emit_py_expr_in_scope(expr: f.value, registry: registry, scope: scope), ",")
        )
        let fields_str = field_strs |> join(separator: "\n")
        concat("{\n", fields_str, "\n}")
      }
    }
    Some { value: tn } =>
      if fields |> count == 0 {
        concat(tn, "()")
      } else {
        let field_strs = fields |> map(f =>
          concat(py_ident(name: f.name), "=", emit_py_expr_in_scope(expr: f.value, registry: registry, scope: scope))
        )
        let fields_str = field_strs |> join(separator: ", ")
        concat(tn, "(", fields_str, ")")
      }
  }
}

// =========================================================================
// List literal emission
// =========================================================================

fn emit_py_list_lit(elements: List<Expr>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  if elements |> count == 0 {
    "[]"
  } else {
    let el_strs = elements |> map(e => emit_py_expr_in_scope(expr: e, registry: registry, scope: scope))
    let els_str = el_strs |> join(separator: ", ")
    concat("[", els_str, "]")
  }
}

// =========================================================================
// Binary operator emission
// =========================================================================

fn emit_py_bin_op(op: BinOpKind, left: Expr, right: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let l_str = emit_py_expr_in_scope(expr: left, registry: registry, scope: scope)
  let r_str = emit_py_expr_in_scope(expr: right, registry: registry, scope: scope)
  if is_py_null_coalesce_op(op: op) {
    // x ?? y  ->  x if x is not None else y
    concat("(", l_str, " if ", l_str, " is not None else ", r_str, ")")
  } else {
    let op_str = emit_py_bin_op_symbol(op: op)
    concat("(", l_str, " ", op_str, " ", r_str, ")")
  }
}

fn emit_py_bin_op_symbol(op: BinOpKind) -> String {
  match op {
    Add => "+"
    Sub => "-"
    Mul => "*"
    Div => "//"
    Mod => "%"
    BinEq => "=="
    BinNe => "!="
    BinLt => "<"
    BinGt => ">"
    BinLe => "<="
    BinGe => ">="
    BinAnd => "and"
    BinOr => "or"
    NullCoalesce => "??"
  }
}

fn is_py_null_coalesce_op(op: BinOpKind) -> Bool {
  match op {
    NullCoalesce => true
    _ => false
  }
}

// =========================================================================
// Unary operator emission
// =========================================================================

fn emit_py_unary_op(op: UnaryOpKind, operand: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let expr_str = emit_py_expr_in_scope(expr: operand, registry: registry, scope: scope)
  match op {
    Not => concat("not ", expr_str)
    Neg => concat("-", expr_str)
  }
}

// =========================================================================
// Lambda emission
// =========================================================================

fn emit_py_lambda(params: List<String>, body: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let param_strs = params |> map(p => py_ident(name: p))
  let params_str = param_strs |> join(separator: ", ")
  let body_str = emit_py_expr_in_scope(expr: body, registry: registry, scope: scope)
  concat("lambda ", params_str, ": ", body_str)
}

// =========================================================================
// String interpolation emission — f-strings
// =========================================================================

fn emit_py_string_interp(parts: List<StringPart>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let segments = parts |> map(p => py_interp_segment(part: p, registry: registry, scope: scope))
  let fstr = segments |> join(separator: "")
  concat("f\"", fstr, "\"")
}

fn py_interp_segment(part: StringPart, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  match part {
    Text { value: v } =>
      // Escape braces in f-strings
      v |> split(delimiter: "{") |> join(separator: "{{")
        |> split(delimiter: "}") |> join(separator: "}}")
    Interpolation { expr: e } =>
      concat("{", emit_py_expr_in_scope(expr: e, registry: registry, scope: scope), "}")
  }
}

// =========================================================================
// Block emission
// =========================================================================

fn emit_py_block(stmts: List<Expr>, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let state = stmts |> fold(init: BlockEmitState { text: "", scope: scope }, f: fn(acc, stmt) {
    let line = emit_py_expr_in_scope(expr: stmt, registry: registry, scope: acc.scope)
    let next_scope = py_scope_after_expr(expr: stmt, scope: acc.scope)
    let new_text = if acc.text == "" { line } else { concat(acc.text, "\n", line) }
    BlockEmitState { text: new_text, scope: next_scope }
  })
  state.text
}

// =========================================================================
// Cast emission
// =========================================================================

fn emit_py_cast(expr: Expr, target: TypeExpr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let expr_str = emit_py_expr_in_scope(expr: expr, registry: registry, scope: scope)
  let ty_str = emit_py_type_expr(type_expr: target)
  concat(ty_str, "(", expr_str, ")")
}

// =========================================================================
// Service definition emission
//
// Each service becomes a class with:
//   - __init__ with config
//   - One async method per operation
//   - aiohttp for REST transport
// =========================================================================

fn emit_py_service_def(
  item: TypedNode,
  registry: Map<String, ItemInfo>
) -> String {
  let safe_name = sanitize_service_name(name: item.name)
  let transport = if item.transport == none { LocalBinding } else { item.transport.value }
  let init_method = emit_py_service_init(transport: transport, config: item.config)
  let op_children = item.children
  let methods = op_children |> map(op_node =>
    emit_py_operation_method(service_name: safe_name, transport: transport, op_node: op_node, registry: registry)
  )
  let methods_str = methods |> join(separator: "\n\n")
  concat("class ", safe_name, ":\n",
    indent(text: init_method, level: 1), "\n\n",
    indent(text: methods_str, level: 1))
}

fn emit_py_service_init(transport: TransportBinding, config: ServiceConfig?) -> String {
  match transport {
    RestBinding { base_url: _, auth: a, headers: _ } => {
      let auth_param = match a {
        Some { value: _ } => ", auth_token: str"
        None => ""
      }
      let auth_assign = match a {
        Some { value: _ } => "\n    self.auth_token = auth_token"
        None => ""
      }
      concat("def __init__(self, base_url: str", auth_param, "):\n",
        "    self.base_url = base_url", auth_assign)
    }
    ShellBinding { argv: _, env: _ } =>
      concat("def __init__(self, working_dir: str | None = None):\n",
        "    self.working_dir = working_dir")
    FileBinding { base_path: _ } =>
      concat("def __init__(self, base_path: str):\n",
        "    self.base_path = base_path")
    LocalBinding =>
      "def __init__(self):\n    pass"
  }
}

fn emit_py_operation_method(service_name: String, transport: TransportBinding, op_node: TypedNode, registry: Map<String, ItemInfo>) -> String {
  let input_params = op_node.params |> map(p =>
    concat(py_ident(name: p.name), ": ", emit_py_type_expr(type_expr: p.type_expr))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "self"
  } else {
    concat("self, ", params_str)
  }
  let ret_type = emit_py_type_expr(type_expr: op_node.return_type)
  let effective_transport = match op_node.transport {
    Some { value: op_transport } => op_transport
    None => transport
  }
  let body = emit_py_transport_call(transport: effective_transport, op_name: op_node.name, registry: registry)
  concat("async def ", py_ident(name: op_node.name),
    "(", all_params, ") -> ", ret_type, ":\n",
    indent(text: body, level: 1))
}

fn emit_py_transport_call(transport: TransportBinding, op_name: String, registry: Map<String, ItemInfo>) -> String {
  match transport {
    RestBinding { base_url: _, auth: a, headers: hs } =>
      emit_py_rest_call(op_name: op_name, auth: a, headers: hs)
    ShellBinding { argv: _, env: envs } =>
      emit_py_shell_call(op_name: op_name, env: envs)
    FileBinding { base_path: _ } =>
      emit_py_file_call(op_name: op_name)
    LocalBinding =>
      emit_py_local_call(op_name: op_name)
  }
}

fn emit_py_rest_call(op_name: String, auth: AuthConfig?, headers: List<HeaderDef>) -> String {
  let self_base_url = concat("{", "self.base_url", "}")
  let url_line = concat("url = f\"", self_base_url, "/", py_ident(name: op_name), "\"")
  let headers_dict = emit_py_headers_dict(auth: auth, headers: headers)
  let session_lines = concat(
    "async with aiohttp.ClientSession() as session:\n",
    "    async with session.post(url, headers=headers) as response:\n",
    "        return await response.json()"
  )
  concat(url_line, "\n", headers_dict, "\n", session_lines)
}

fn emit_py_headers_dict(auth: AuthConfig?, headers: List<HeaderDef>) -> String {
  let auth_entry = match auth {
    Some { value: ac } =>
      concat("\"", ac.header, "\": self.auth_token, ")
    None => ""
  }
  let header_entries = headers |> map(h =>
    concat("\"", h.name, "\": \"TODO\"")
  )
  let all_entries = if auth_entry == "" {
    header_entries |> join(separator: ", ")
  } else {
    concat(auth_entry, header_entries |> join(separator: ", "))
  }
  concat("headers = {", all_entries, "}")
}

fn emit_py_shell_call(op_name: String, env: List<EnvDef>) -> String {
  let env_dict_entries = env |> map(e =>
    concat("\"", e.name, "\": \"TODO\"")
  )
  let env_str = concat("{", env_dict_entries |> join(separator: ", "), "}")
  concat(
    "import subprocess\n",
    "result = subprocess.run(\n",
    "    [\"", py_ident(name: op_name), "\"],\n",
    "    cwd=self.working_dir or \".\",\n",
    "    env=", env_str, ",\n",
    "    capture_output=True, text=True,\n",
    ")\n",
    "return result.stdout"
  )
}

fn emit_py_file_call(op_name: String) -> String {
  let self_base_path = concat("{", "self.base_path", "}")
  concat(
    "path = f\"", self_base_path, "/", py_ident(name: op_name), "\"\n",
    "with open(path) as f:\n",
    "    return f.read()"
  )
}

fn emit_py_local_call(op_name: String) -> String {
  concat("# Local binding — direct function call\n",
    "return ", py_ident(name: op_name), "()")
}

// =========================================================================
// Resource definition emission
//
// Resources become abstract base classes with abstract methods.
// =========================================================================

fn emit_py_resource_def(item: TypedNode) -> String {
  let cap_children = item.children
  let methods = cap_children |> map(c => emit_py_capability_method(cap_node: c))
  let methods_str = methods |> join(separator: "\n\n")
  concat("from abc import ABC, abstractmethod\n\n",
    "class ", item.name, "(ABC):\n",
    indent(text: methods_str, level: 1))
}

fn emit_py_capability_method(cap_node: TypedNode) -> String {
  let input_params = cap_node.params |> map(p =>
    concat(py_ident(name: p.name), ": ", emit_py_type_expr(type_expr: p.type_expr))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "self"
  } else {
    concat("self, ", params_str)
  }
  let ret = emit_py_type_expr(type_expr: cap_node.return_type)
  concat("@abstractmethod\n",
    "async def ", py_ident(name: cap_node.name), "(", all_params, ") -> ", ret, ":\n",
    "    ...")
}

// =========================================================================
// Data definition emission
//
// data name: Type = value  ->  module-level constant
// =========================================================================

fn emit_py_data_def(name: String, type_expr: TypeExpr, value: Expr, registry: Map<String, ItemInfo>, scope: InferScope) -> String {
  let ty_str = emit_py_type_expr(type_expr: type_expr)
  let upper_name = to_screaming_snake(name: name)
  let val_str = emit_py_expr_in_scope(expr: value, registry: registry, scope: scope)
  concat(upper_name, ": ", ty_str, " = ", val_str)
}

// =========================================================================
// Identifier conversion — Python target
// =========================================================================

// Convert a DSL identifier to a valid Python identifier.
// Handles reserved word collision by appending underscore suffix.
fn py_ident(name: String) -> String {
  let snake = to_snake(name: name)
  if python_reserved |> any(r => r == snake) {
    concat(snake, "_")
  } else {
    snake
  }
}

// =========================================================================
// requirements.txt emission
// =========================================================================

fn emit_requirements_txt(has_services: Bool) -> TextFile {
  let base_deps = ""
  let async_deps = if has_services {
    "aiohttp>=3.9\n"
  } else {
    ""
  }
  TextFile { path: "requirements.txt", content: concat(base_deps, async_deps) }
}

// Check if a typed graph has any service definitions.
fn has_py_service_items(typed: TypedGraph) -> Bool {
  typed.modules |> any(tm =>
    tm.items |> any(item => is_py_typed_service_item(item: item))
  )
}

fn is_py_typed_service_item(item: TypedNode) -> Bool {
  item.transport != none && item.children |> count > 0
}
