// v2 method classification -- maps method names to typed method semantics.
//
// String-to-enum classification for intrinsic methods, runtime bridge
// methods, and builtin function calls. Each classifier returns a typed
// enum variant so downstream code (inference, emit) can match structurally
// instead of comparing strings.
//
// Dependency: v2.compiler.infer_types (Node constructors)

module v2.compiler.infer_method

import std.types { SourceSpan }
import v2.std.core {
  Node, InferredNode, TypeVariable,
  Connective, NoConnective,
  Cardinality, Required,
  ExprData, NoExprData,
  leaf_node, make_span, with_optional_cardinality,
  unit_type, bool_type, string_type, int_type, float_type, none_type
}
import v2.compiler.infer_types {
  container_node, tuple_node,
  bare_map_node,
  method_receiver_element_node
}

// =========================================================================
// Intrinsic method classification
// =========================================================================

// classify_reconciled_intrinsic_method and classify_runtime_bridge_method
// DELETED (2026-03-28). 48 string branches replaced by algebra registry
// (enrich_kernel_type) + emit-prep reclassification via index maps.
// Methods now resolve structurally through Tier 0 lookup_structural_method.

// =========================================================================
// Method return type inference
// =========================================================================

// infer_intrinsic_method_type_node DELETED (2026-03-28).
// Return types now come from algebra field + substitute_algebra_result
// in resolve_known_method_node. The algebra registry provides base types;
// substitute_algebra_result maps self_type→receiver_type and handles
// Optional wrapping. refine_collection_result_type specializes polymorphic
// cases (map, flat_map, fold) using typed callback args.

// infer_runtime_bridge_method_type_node DELETED (2026-03-28).
// Same as infer_intrinsic_method_type_node — replaced by algebra field
// return types + substitute_algebra_result.

// =========================================================================
// Builtin call type inference
// =========================================================================

fn type_variable_node(id: String) -> Node {
  Node { name: "", span: make_span(start: 0, end: 0), children: [], connective: NoConnective, params: [], inferred: Some { value: TypeVariable { id: id } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
}

// Builtin function return type registry — data table.
// Each entry maps a function name to a return type descriptor.
// Adding a builtin function = one line in this table.
//
// Uses BuiltinReturnKind to describe return type shapes compositionally.
// Node construction is deferred to builtin_return_node().
type BuiltinReturnKind
  = RetKernel { type_name: String }
  | RetOptKernel { type_name: String }
  | RetOptTypeVar { var_id: String }
  | RetListTypeVar { var_id: String }
  | RetMap

data builtin_function_returns: Map<String, BuiltinReturnKind> = {
  // Int-returning functions
  "string_length": RetKernel { type_name: "Int" },
  "code_point": RetKernel { type_name: "Int" },
  "to_int": RetKernel { type_name: "Int" },
  "scan_while": RetKernel { type_name: "Int" },
  "scan_string_end": RetKernel { type_name: "Int" },
  "scan_to_eol": RetKernel { type_name: "Int" },
  "skip_horizontal_ws": RetKernel { type_name: "Int" },
  // Int?-returning functions
  "parse_int": RetOptKernel { type_name: "Int" },
  // String-returning functions
  "char_at": RetKernel { type_name: "String" },
  "substring": RetKernel { type_name: "String" },
  "from_code_point": RetKernel { type_name: "String" },
  "to_string": RetKernel { type_name: "String" },
  "concat": RetKernel { type_name: "String" },
  // Map-returning functions
  "map_insert": RetMap,
  "map_merge": RetMap,
  "with": RetMap,
  // Bool-returning functions
  "map_contains_key": RetKernel { type_name: "Bool" },
  "map_has": RetKernel { type_name: "Bool" },
  "emit_map_has": RetKernel { type_name: "Bool" },
  // Optional-returning functions (polymorphic)
  "lookup": RetOptTypeVar { var_id: "map_value" },
  "map_get": RetOptTypeVar { var_id: "map_value" },
  "Some": RetOptTypeVar { var_id: "some_inner" },
  // List-returning functions (polymorphic)
  "map_keys": RetListTypeVar { var_id: "collection_element" },
  "map_values": RetListTypeVar { var_id: "collection_element" },
  "reverse": RetListTypeVar { var_id: "collection_element" },
  "list_push": RetListTypeVar { var_id: "collection_element" }
}

fn builtin_return_node(kind: BuiltinReturnKind) -> Node {
  match kind {
    RetKernel { type_name: n } => leaf_node(name: n)
    RetOptKernel { type_name: n } => with_optional_cardinality(n: leaf_node(name: n))
    RetOptTypeVar { var_id: id } => with_optional_cardinality(n: type_variable_node(id: id))
    RetListTypeVar { var_id: id } => container_node(kind_name: "List", element: type_variable_node(id: id))
    RetMap => bare_map_node()
  }
}

fn infer_builtin_call_type(name: String) -> Node? {
  match lookup(builtin_function_returns, key: name) {
    Some { value: kind } => Some { value: builtin_return_node(kind: kind) }
    None => none
  }
}

fn resolve_builtin_call_type(name: String) -> Node {
  match infer_builtin_call_type(name: name) {
    Some { value: v } => v
    None => unit_type
  }
}
