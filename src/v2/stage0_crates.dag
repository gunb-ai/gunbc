// v2 stage0 crate-boundary authority -- .dag model of the split crates.
//
// This module is the .dag-authored successor to the hand-written
// `render_stage0_*` constants and renderers in
// `src/v2/stage0/src/bin/regen_stage0.rs`. It declares, as data, which
// generated stage0 modules form each split support crate, that crate's
// Cargo dependencies, and the root shims it carries -- then emits the exact
// `Cargo.toml` and `lib.rs` wrapper files `regen_stage0` writes and verifies.
//
// Authority migration only: the emitted bytes are byte-for-byte identical to
// the files PR #4429 rendered from Rust. `regen_stage0` keeps its
// writer/verifier role but sources the wrapper contents from here.
//
// The semantic module bodies still live in the generated stage0 seed; this
// module never copies them -- it only references them by `#[path]` include or
// `pub use` re-export.

module v2.compiler.stage0_crates

import v2.std.core { TextFile }

// =========================================================================
// Crate-boundary model
// =========================================================================

// Which split crate, and therefore which lib.rs shape, a spec describes.
type Stage0CrateKind
  = CoreCrate
  | EmitCoreCrate

// Root-level newtype shims a crate carries directly in its lib root because
// generated modules address them as `crate::NonEmptyVec` / `crate::NonEmptyBTreeSet`.
// These are generated-crate support, not semantic compiler logic.
type Stage0RootShim
  = NonEmptyVecShim
  | NonEmptyBTreeSetShim

// A single `[dependencies]` entry, faithful to the three forms #4429 uses.
type Stage0CrateDep
  = VersionDep { name: String, version: String, features: List<String> }
  | PathDep    { name: String, path: String }

// One split support crate.
//
// `modules` are generated stage0 module stems (file name without `.rs`).
// For a CoreCrate they become `#[path]` includes; for an EmitCoreCrate they
// become re-export wrapper modules sourced from `v2-stage0-core`.
type Stage0CrateSpec {
  package_name: String
  crate_dir: String
  kind: Stage0CrateKind
  header_doc: String
  modules: List<String>
  dependencies: List<Stage0CrateDep>
  root_shims: List<Stage0RootShim>
}

type Stage0CratePlan {
  crates: List<Stage0CrateSpec>
}

// =========================================================================
// Shared literal fragments
// =========================================================================

// The crate-level `#![allow(...)]` block both wrapper libs open with.
fn stage0_crate_allow_block() -> String {
  [
    "#![allow(",
    "    unused_imports,",
    "    unused_variables,",
    "    unused_mut,",
    "    unused_parens,",
    "    dead_code,",
    "    unreachable_patterns,",
    "    non_shorthand_field_patterns,",
    "    suspicious_double_ref_op,",
    "    clippy::all",
    ")]"
  ] |> join(separator: "\n")
}

fn stage0_core_header_doc() -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Crate boundary for generated v2 stage0 core authorities.",
    "//!",
    "//! The module bodies remain generated into `src/v2/stage0/src`. This crate",
    "//! exposes the lower std/runtime/artifact/language/infer support surface",
    "//! without copying generated module bodies. The root `NonEmpty*` wrappers are",
    "//! mirrored from the stage0 lib root because generated modules address them as",
    "//! `crate::NonEmptyVec` and `crate::NonEmptyBTreeSet`."
  ] |> join(separator: "\n")
}

fn stage0_emit_core_header_doc() -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Crate boundary proof for generated v2 emit core support.",
    "//!",
    "//! The semantic bodies remain generated from `src/v2/05_emit_core_support.dag`",
    "//! into the stage0 seed. This crate exposes that generated support surface",
    "//! through `v2-stage0-core`, avoiding copied Rust semantics."
  ] |> join(separator: "\n")
}

// Root shim impl block, ending at the closing brace (no trailing newline).
fn render_stage0_root_shim(shim: Stage0RootShim) -> String {
  match shim {
    NonEmptyVecShim =>
      [
        "#[derive(Debug, Clone, PartialEq)]",
        "pub struct NonEmptyVec<T>(Vec<T>);",
        "",
        "impl<T> NonEmptyVec<T> {",
        "    pub fn new(items: Vec<T>) -> Result<Self, &'static str> {",
        "        if items.is_empty() {",
        "            Err(\"NonEmptyVec requires at least one element\")",
        "        } else {",
        "            Ok(Self(items))",
        "        }",
        "    }",
        "",
        "    pub fn as_slice(&self) -> &[T] {",
        "        &self.0",
        "    }",
        "",
        "    pub fn into_vec(self) -> Vec<T> {",
        "        self.0",
        "    }",
        "}"
      ] |> join(separator: "\n")
    NonEmptyBTreeSetShim =>
      [
        "#[derive(Debug, Clone, PartialEq)]",
        "pub struct NonEmptyBTreeSet<T: Ord>(std::collections::BTreeSet<T>);",
        "",
        "impl<T: Ord> NonEmptyBTreeSet<T> {",
        "    pub fn new(items: std::collections::BTreeSet<T>) -> Result<Self, &'static str> {",
        "        if items.is_empty() {",
        "            Err(\"NonEmptyBTreeSet requires at least one element\")",
        "        } else {",
        "            Ok(Self(items))",
        "        }",
        "    }",
        "",
        "    pub fn as_set(&self) -> &std::collections::BTreeSet<T> {",
        "        &self.0",
        "    }",
        "",
        "    pub fn into_set(self) -> std::collections::BTreeSet<T> {",
        "        self.0",
        "    }",
        "}"
      ] |> join(separator: "\n")
  }
}

// =========================================================================
// Manifest emission
// =========================================================================

fn render_stage0_crate_dep(dep: Stage0CrateDep) -> String {
  match dep {
    VersionDep { name: name, version: version, features: features } =>
      if features |> count > 0 {
        let feat_strs = features |> map(f => concat("\"", f, "\""))
        concat(name, " = { version = \"", version, "\", features = [", feat_strs |> join(separator: ", "), "] }\n")
      } else {
        concat(name, " = \"", version, "\"\n")
      }
    PathDep { name: name, path: path } =>
      concat(name, " = { path = \"", path, "\" }\n")
  }
}

fn emit_stage0_crate_manifest(spec: Stage0CrateSpec) -> TextFile {
  let deps = spec.dependencies |> map(render_stage0_crate_dep) |> join(separator: "")
  let content = concat(
    "[package]\nname = \"", spec.package_name, "\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n",
    deps
  )
  TextFile { path: concat(spec.crate_dir, "/Cargo.toml"), content: content }
}

// =========================================================================
// lib.rs emission
// =========================================================================

// CoreCrate: `#[path]`-include each module, then carry the root shims inline.
fn render_stage0_core_lib(spec: Stage0CrateSpec) -> String {
  let includes = spec.modules
    |> map(m => concat("#[path = \"../../stage0/src/", m, ".rs\"]\npub mod ", m, ";"))
    |> join(separator: "\n")
  let shims = spec.root_shims |> map(render_stage0_root_shim) |> join(separator: "\n\n")
  concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    includes, "\n\n",
    shims, "\n"
  )
}

// EmitCoreCrate: re-export each module from v2-stage0-core, import the root
// shims, then include and glob-re-export the generated emit-core support.
fn render_stage0_emit_core_lib(spec: Stage0CrateSpec) -> String {
  let reexports = spec.modules
    |> map(m => concat("pub mod ", m, " {\n    pub use v2_stage0_core::", m, "::*;\n}"))
    |> join(separator: "\n\n")
  concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    "pub use v2_stage0_core::\{NonEmptyBTreeSet, NonEmptyVec};", "\n\n",
    reexports, "\n\n",
    "#[path = \"../../stage0/src/v2_compiler_emit_core_support.rs\"]\npub mod v2_compiler_emit_core_support;", "\n\n",
    "pub use v2_compiler_emit_core_support::*;", "\n"
  )
}

fn emit_stage0_crate_lib(spec: Stage0CrateSpec) -> TextFile {
  let content = match spec.kind {
    CoreCrate => render_stage0_core_lib(spec)
    EmitCoreCrate => render_stage0_emit_core_lib(spec)
  }
  TextFile { path: concat(spec.crate_dir, "/src/lib.rs"), content: content }
}

// =========================================================================
// Plan -- the existing #4429 crates, modeled as data
// =========================================================================

fn stage0_crate_plan() -> Stage0CratePlan {
  Stage0CratePlan {
    crates: [
      Stage0CrateSpec {
        package_name: "v2-stage0-core",
        crate_dir: "src/v2/stage0_core",
        kind: CoreCrate,
        header_doc: stage0_core_header_doc(),
        modules: [
          "extdeps_languages_dag_emit",
          "extdeps_languages_dag_syntax",
          "extdeps_languages_dag_types",
          "extdeps_languages_go_emit",
          "extdeps_languages_go_syntax",
          "extdeps_languages_go_types",
          "extdeps_languages_python_emit",
          "extdeps_languages_python_syntax",
          "extdeps_languages_python_types",
          "extdeps_languages_rust_emit",
          "extdeps_languages_rust_syntax",
          "extdeps_languages_rust_types",
          "std_algebra",
          "std_coercion",
          "std_computation",
          "std_effects",
          "std_error_primitives",
          "std_graph",
          "std_http_path",
          "std_induction",
          "std_iteration",
          "std_node",
          "std_syntax",
          "std_termination",
          "std_types",
          "v2_compiler_artifact",
          "v2_compiler_infer_emit_info",
          "v2_compiler_infer_env",
          "v2_compiler_infer_items",
          "v2_compiler_infer_service",
          "v2_compiler_infer_sigs",
          "v2_compiler_infer_types",
          "v2_compiler_languages",
          "v2_rt",
          "v2_std_core"
        ],
        dependencies: [
          VersionDep { name: "stacker", version: "0.1", features: [] },
          VersionDep { name: "serde", version: "1", features: ["derive", "rc"] },
          VersionDep { name: "serde_json", version: "1", features: [] }
        ],
        root_shims: [NonEmptyVecShim, NonEmptyBTreeSetShim]
      },
      Stage0CrateSpec {
        package_name: "v2-stage0-emit-core",
        crate_dir: "src/v2/stage0_emit_core",
        kind: EmitCoreCrate,
        header_doc: stage0_emit_core_header_doc(),
        modules: [
          "v2_compiler_artifact",
          "v2_compiler_infer_items",
          "v2_compiler_infer_service",
          "v2_compiler_infer_types",
          "v2_compiler_languages",
          "v2_rt",
          "v2_std_core"
        ],
        dependencies: [
          VersionDep { name: "stacker", version: "0.1", features: [] },
          VersionDep { name: "serde", version: "1", features: ["derive", "rc"] },
          PathDep { name: "v2-stage0-core", path: "../stage0_core" }
        ],
        root_shims: []
      }
    ]
  }
}

// =========================================================================
// Boundary file set -- what regen_stage0 writes and verifies
// =========================================================================

fn emit_stage0_crate_boundary_files(plan: Stage0CratePlan) -> List<TextFile> {
  plan.crates |> flat_map(spec => [
    emit_stage0_crate_manifest(spec),
    emit_stage0_crate_lib(spec)
  ])
}

// Nullary entry point regen_stage0 calls.
fn stage0_crate_boundary_files() -> List<TextFile> {
  emit_stage0_crate_boundary_files(stage0_crate_plan())
}
